<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2KI" style="id">- Mbembe Adun [mfn]</book>
  <para style="h">2 Avaarnọng</para>
  <para style="toc2">2 Avaarnọng</para>
  <para style="toc1">Nnwẹr kw'ottong afa kw'avaarnọng</para>
  <para style="mt1">Nnwẹr kw'ottong afa kw'Avaarnọng</para>
  <para style="imt" />
  <para style="im" />
  <para style="ie" />
  <chapter number="1" style="c" sid="2KI 1" />
  <para style="s1">Ọvaar Ibinọkpaabyi ọkpaar aponga p'Ahaziya</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 1:1" />K'ogbe kw'ọvaar Ahab ikk'ọpa, anọng p'Moab ake anọng p'Israẹl ẹkọhr.<verse eid="2KI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 1:2" />Wa ọvaar Ahaziya kw'Israẹl ọphaar z'ọbaaka kw'ẹsọhmma ch'ẹnyọhng chẹ z'Samariya otto, omuma ekpo. Minna kw'ọtọhmọ azeng-eden pẹ bẹ́, “Màd-ibọbh Bal-Zebub kw'ode ọka f'Ẹkrọn, óde im'mbina m'ekpo mbya py'mmum ma.”<verse eid="2KI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 1:3" />Okenaka, ozeng-eden kw'Ọvaar Ibinọkpaabyi oben Ẹlaija kw'ofon Tishbe bẹ́, “Zọhng kebha azeng-eden p'Ahaziya kw'ode ọvaarnọng kw'Samariya, abọbh bẹ bẹ́, ‘Ma, machibhẹ bẹ́, Ibinọkpaabyi m'Israẹl kode o, kw'mafon mad-abọbh Baal-Zebub kw'ode ọka f'Ẹkrọn odik o?’ <verse eid="2KI 1:3" /><verse number="4" style="v" sid="2KI 1:4" />Ofona nya, Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Ko Ahaziya ny'ọkọhmaana mvo, màbina. M'apope!’ ” Minna kw'Ẹlaija obin ofona, od-osi minna.<verse eid="2KI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 1:5" />K'ogbe kw'azeng-eden mbo makpa nnam, ọvaarnọng ọbọbh bẹ bẹ́, “Osempira makpa nnam o?”<verse eid="2KI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 1:6" />Mapọhna bẹ́, “Ojinọng wanẹ okwu okebha mina z'eden. Oben mina bẹ́, ‘Màkpa nnam z'ọvaarnọng kw'ọtọhmọ bọnga. Màtek-ẹ bẹ́, “Ọvaar Ibinọkpaabyi obenẹ bẹ́, Ma, machibhẹ bẹ́, Ibinọkpaabyi m'Israẹl kode o, kw'atọhmọ azeng-eden pọ bẹ́, mad-abọbh Baal-Zebub kw'ode ọka f'Ẹkrọn odik o? Ofona nya, Ọvaar Ibinọkpaabyi obenẹ bẹ́, Ny'ọkọhmaana mvo màbina; m'apope!” ’ ”<verse eid="2KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 1:7" />Ọvaar Ahaziya ọbọbh bẹ bẹ́, “Bọng-ọnọng kira wọ okebh bọnga z'eden kw'ọgbaak bọnga odik nwa?”<verse eid="2KI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 1:8" />Mapọhna bẹ́, “Ọnọng nwo ọfọr owurọ-baba kw'ode iphyabh-iphyabha, obir ọkpaama odikpa kw'etenkpa z'erin.”</para>
  <para style="p" vid="2KI 1:8">Ọvaarnọng oben bẹ́, “Ẹlaija kw'ofon Tishbe wọ e!”<verse eid="2KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 1:9" />Minna kw'ọvaarnọng ọtọhmọ oso kw'asoja ọmaana esojakaan chẹ ch'ede anọng arọbh afa okwuma ijobh z'Ẹlaija. Osonọng nwo od-okebha Ẹlaija ch'oning ẹwọr z'ogbeso. Oben-ẹ bẹ́, “Ọgbaak-ettem ch'Ibinọkpaabyi, ọvaarnọng obenẹ bẹ́, ‘Saka m'izek!’ ”<verse eid="2KI 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 1:10" />Ẹlaija ọpọhna osonọng nwo bẹ́, “Ó̱de nde ọgbaak-ettem ch'Ibinọkpaabyi majijik, tte ekpon efona z'ẹrọng, ẹkwọmọ kọ ọmaana ajinọng pọ anọng arọbh afa okwuma ijobh!” Minna kw'ekpon efon z'ẹrọng, ẹkwọmọ osonọng nwo, ọttara ajinọng pẹ anọng arọbh afa okwuma ijobh.<verse eid="2KI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 1:11" />Ọvaarnọng obir ọtọhm oso kw'asoja, ọmaana esojakaan chẹ ch'ede anọng arọbh afa okwuma ijobh z'Ẹlaija. Osonọng nwo oben Ẹlaija bẹ́, “Ọgbaak-ettem ch'Ibinọkpaabyi, ọvaarnọng obenẹ bẹ́, ‘Saka m'izek ẹbhar-ẹbhar!’ ”<verse eid="2KI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 1:12" />Ẹlaija ọpọhna osonọng nwo bẹ́, “Ó̱de nde ọgbaak-ettem ch'Ibinọkpaabyi, tte ekpon efona z'ẹrọng, ẹkwọmọ kọ ọmaana ajinọng pọ anọng arọbh afa okwuma ijobh!” Minna kw'ekpon efon z'ẹrọng, ẹkwọmọ osonọng nwo, ọttara ajinọng pẹ anọng arọbh afa okwuma ijobh.<verse eid="2KI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 1:13" />Ọvaarnọng obira ọtọhm oso kw'asoja kw'ottong attaan ọmaana esojakaan chẹ ch'ede anọng arọbh afa okwuma ijobh z'Ẹlaija. Opyirẹ za, ottima ndudungọ ny'Ẹlaija k'ititika, okwuk-ẹ bẹ́, “O ọgbaak-ettem ch'Ibinọkpaabyi, ototo, tte akpen paam, ọmaana akpen p'ajinọng mba anọng arọbh afa okwuma ijobh, p'ade atọhmnọng pọ, mabar-ọ odik! <verse eid="2KI 1:13" /><verse number="14" style="v" sid="2KI 1:14" />Kk'aza ose kw'ekpon kk'efona z'ẹrọng ẹkwọmọ osonọng kw'echeden ọmaana kw'ottong afa, ọttara nsoja-kaan sabẹ maphyir. Ototo, tte akpen paam abar-ọ odik!”<verse eid="2KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 1:15" />Ozeng-eden kw'Ọvaar Ibinọkpaabyi oben Ẹlaija bẹ́, “Tor-ẹ mafona; oning-ọ ojor.” Minna kw'Ẹlaija obin otor bẹ machina z'ọvaarnọng.<verse eid="2KI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 1:16" />Ẹlaija oben ọvaarnọng bẹ́, “Ọvaar Ibinọkpaabyi obenẹ bẹ́, Ma, achibhẹ bẹ́, Ibinọkpaabyi m'Israẹl kode o, kw'atọhmọ azeng-eden pọ bẹ́, mad-abọbh Baal-Zebub kw'ode ọka f'Ẹkrọn odik o? Ofona nya, Ọvaar Ibinọkpaabyi obenẹ bẹ́, ny'ọkọhmaana mvo màbina, m'apope.”<verse eid="2KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 1:17" />Minna kw'Ahaziya ope, otor k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi ikk'Ẹlaija kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, otima ọgbaak.</para>
  <para style="p" vid="2KI 1:17">Ch'iwa Ahaziya ina ojinọngnwa obhonọ, Joram ọtọka ẹvaar chẹ. Wa ọtọk ẹvaar ndo ny'icho ttong ifa s'Jehoram kw'ode nnwa kw'Jehoshaphat ọbaabh Juda.<verse eid="2KI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 1:18" />Idik njoza maphyir s'iwa iyinẹ k'ogbe kw'Ahaziya ọbaabh, ọmaana idik s'osi, makkẹrẹ z'anwẹr p'avaar p'Israẹl.<verse eid="2KI 1:18" /></para>
  <chapter eid="2KI 1" />
  <chapter number="2" style="c" sid="2KI 2" />
  <para style="s1">Ọvaar Ibinọkpaabyi otim Ẹlaija ovura z'obhon kwẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 2:1" />K'ogbe kw'uwa Ọvaar Ibinọkpaabyi min'otima bhaka-bhaka otima Ẹlaija ochina z'Ọvaarbhon kwẹ, ny'ogbe nwo, Ẹlaija ọmaana Elisha mad-abina z'Gilgal afon-ofona. <verse eid="2KI 2:1" /><verse number="2" style="v" sid="2KI 2:2" />Ch'nd-azenga ny'eden o, Ẹlaija oben Elisha bẹ́, “Kọ ninga ma, kirẹ Ọvaar Ibinọkpaabyi kk'aam obena bẹ́, nchina z'Bẹtẹl.”</para>
  <para style="p" vid="2KI 2:2">Okenaka, Elisha oben bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi oruk akpen, kọ Ẹlaija abir aruk ọdọk, kaam kọ ọbọhk mìntte.” Minna kw'matọnọ achina z'Bẹtẹl.<verse eid="2KI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 2:3" />Mapyirẹ za o, ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi ch'ening ny'Bẹtẹl ekwu ẹbọbh Elisha bẹ́, “Ma, azong ma bẹ́, menda Ọvaar Ibinọkpaabyi m'otima atte ofon-ofona o?”</para>
  <para style="p" vid="2KI 2:3">Elisha ọpọhna bẹ́, “Iye. Okenaka, màmyi nya.”<verse eid="2KI 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 2:4" />Nya o, Ẹlaija oben Elisha bẹ́, “Ninga ma. Ọvaar Ibinọkpaabyi kk'aam obena bẹ́, nchina z'Jeriko.”</para>
  <para style="p" vid="2KI 2:4">Elisha ọpọhna bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi oruk akpen, kọ Ẹlaija abir aruk akpen, kaam kọ ọbọhk mìntte.” Minna kw'matọnọ ẹkaan achina z'Jeriko.<verse eid="2KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 2:5" />Mapyirẹ za o, ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi ch'ening ny'Jeriko makwu abọbh Elisha bẹ́, “Ma, azong ma bẹ́, menda Ọvaar Ibinọkpaabyi m'otima atte ofon-ofona o?”</para>
  <para style="p" vid="2KI 2:5">Elisha ọpọhna bẹ́, “Iye. Okenaka, màmyi nya.”<verse eid="2KI 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 2:6" />Ẹlaija obira oben Elisha bẹ́, “Ninga ma, kirẹ Ọvaar Ibinọkpaabyi kk'aam obena bẹ́, nchina z'ọraanga kw'Jọrdan.”</para>
  <para style="p" vid="2KI 2:6">Elisha ọpọhna bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi oruk akpen, kọ abira aruk akpen, kaam kọ ọbọhk mìntte.” Minna kw'matọnọ ẹkaan afona.<verse eid="2KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 2:7" />Ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi anọng arọbh afa okwuma ijobh, efona ed-ebe z'ororo, eze ibyi s'Ẹlaija ọmaana Elisha mabe ny'ọraanga kw'Jọrdan. <verse eid="2KI 2:7" /><verse number="8" style="v" sid="2KI 2:8" />Ẹlaija ọwọra owurọ-baba kwẹ, ọkwọn-ọkwọnọ, obin ny'ọraanga. Ọraanga ọbhaangẹ agboka afa. Bẹ anọng afa, mazenga ny'ọgbaarẹ kw'ọraanga nwo, majeka.<verse eid="2KI 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 2:9" />Majek nya o, Ẹlaija ọbọbh Elisha bẹ́, “Tek-m ọttọhk f'm'nsi nnang-ọ pira matim-m afona arik-ọ ma.”</para>
  <para style="p" vid="2KI 2:9">Elisha ọpọhna bẹ́, “Tte nyena okebh f'egwugwuma chọ igbedim ifa.”<verse eid="2KI 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 2:10" />Ẹlaija oben-ẹ bẹ́, “Ọttọhk f'aphyem-m ma, ọgaang-ọgaangẹ. Zaa ode ch'ode, óde aze-m ch'mm'atim-m afona, m'ode fọ ode. Okenaka, ína aze ch'matim-m afona, ọttọhk f'aphyemẹ, màyena.”<verse eid="2KI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 2:11" />K'ose kw'mad-azenga ny'eden agbaak idik, minna kw'ijaar s'nnyanya id-itọr s'itim ekpon, ọmaana nnyanya s'itim ekpon, iyinẹ, ibhaangẹ bẹ anọng afa. Bhaka-bhaka otinẹ Ẹlaija, otim-ẹ ochina z'obhon kw'Ibinọkpaabyi. <verse eid="2KI 2:11" /><verse number="12" style="v" sid="2KI 2:12" />Elisha oze odik nwa nya o, obhom, oben bẹ́, “Atte kwaam! Atte kwaam! Ijaar s'nnyanya id-itọr, ọmaana ayaar-nnyanya p'Israẹl!” Elisha ọdọk kẹ koze. Ọtọka ẹfọrakpo py'Ẹlaija, ọyaakẹ pyẹ k'ibyi ifa.<verse eid="2KI 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 2:13" />Elisha odunga owurọ-baba kw'ofon z'Ẹlaija k'ifor otto ny'izek, otima od-obe ny'akonga p'ọraanga kw'Jọrdan. <verse eid="2KI 2:13" /><verse number="14" style="v" sid="2KI 2:14" />Otima owurọ-baba nwo kw'Ẹlaija kw'ikk'ọtta, obin ny'ọraanga, oben bẹ́, “Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Ẹlaija kẹ?” K'ose kw'obinẹ owurọ-baba nwo ny'asi, ọraanga nwo ọbhaangẹ agboka afa. Ozenga nya, ojeka.<verse eid="2KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 2:15" />Ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi ch'ebin z'Jeriko ch'ening nya eze odik nwo, eben bẹ́, “Egwugwuma ch'Ẹlaija n'ening ọmaana Elisha.” Minna kw'mabin akebha Elisha za, maraka nso k'ekpukpobha-maana, manang-ẹ. <verse eid="2KI 2:15" /><verse number="16" style="v" sid="2KI 2:16" />Maben-ẹ bẹ́, “Kirẹ e, moyen atọhmnọng arọbh afa okwuma ijobh ma p'ayen ẹfa. Tte mafona mad-aror atte kwọ. Okpokpo ode bẹ́, Ọvaar Ibinọkpaabyi kk'ẹ ọtọka ọnana z'agbeso banẹ, wanẹma, kẹ osoka k'ilokodo janẹ.”</para>
  <para style="p" vid="2KI 2:16">Elisha ọpọhna bẹ́, “Mma e, m'bẹ katọhm e.”<verse eid="2KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 2:17" />Agbaak-ettem ch'Ibinọkpaabyi mbo magbana odik nwo maa, mgbar isi Elisha. Minna kw'nobenẹ bẹ́, “Màtọhm bẹ.” Matọhm agbaak-ettem ch'Ibinọkpaabyi anọng arọbh afa okwuma ijobh bẹ́, maror Ẹlaija. Maror-ẹ k'iwu ittaan, m'kẹ kaze. <verse eid="2KI 2:17" /><verse number="18" style="v" sid="2KI 2:18" />K'ogbe kw'nna akpa nnam akebha Elisha z'Jeriko, oben bẹ bẹ́, “Wura bọnga kintekẹ bẹ́, maning ata?”<verse eid="2KI 2:18" /></para>
  <para style="s1">Elisha osi asi majibh</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 2:19" />Anọng p'ebhondim ndo maben Elisha bẹ́, “Ttatta kwamina, kọ oyenẹ kk'azonga bẹ́, obhon nwoma oning k'ibyi ọkkọkka. Okenaka, asi pẹ kajibhẹ, izek sẹ kibir ijibh.”<verse eid="2KI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 2:20" />Elisha oben bẹ́, “Màtọka onung ke k'ogbobh-mbọhk ọbhakwẹ, nang-m.” Minna kw'matọk anang-ẹ.<verse eid="2KI 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 2:21" />Nya o, Elisha ochina z'ekeka ndo, ọnyaanẹ onung mvo nya. Oben bẹ́, “Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi obenẹ: ‘Kaam kk'asi mba nda. Ogbe kode kw'mm'abir atima obo akwu m'izek nja, wanẹma, masi ekpo ening ejibhẹ.’ ” <verse eid="2KI 2:21" /><verse number="22" style="v" sid="2KI 2:22" />Tọma za maa, pyirẹ menda, asi mbo atim ajibh-ojibh za k'ose kw'Elisha ikk'ọgbaaka.<verse eid="2KI 2:22" /></para>
  <para style="s1">Matim Elisha asi ekirẹ</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 2:23" />Elisha obina ny'Jeriko bẹ́, ochina z'Bẹtẹl. Ch'od-ozenga ny'eden o, adikkobhva banẹ p'afon ny'obhon nwo, matima Elisha asi ekirẹ. Maben-ẹ bẹ́, “Ọwọbh-osokpa, bina ma! Ọwọbh-osokpa, bina ma!” <verse eid="2KI 2:23" /><verse number="24" style="v" sid="2KI 2:24" />Elisha ọbhakẹ okkerẹ bẹ, ọnang bẹ ẹmma k'eche ch'Ọvaar Ibinọkpaabyi. Minna kw'nten mfa s'ikerẹ eche<note caller="+" style="f"><char style="fr" closed="false">2.24 </char><char style="fq" closed="false">kw'nche </char><char style="ft" closed="false">k'ẹkkaara, mayerẹ eten nda bẹ́, bear </char></note>, iyinẹ ny'ẹtam, iyaakẹ adikkobhva mbo p'ade anọng arọbh afa okwuma afa, k'akpa-k'akpa. <verse eid="2KI 2:24" /><verse number="25" style="v" sid="2KI 2:25" />Elisha ozenga ochina z'egbe ch'Karmẹl. Obin nya, ọkpa nnam z'Samariya.<verse eid="2KI 2:25" /></para>
  <chapter eid="2KI 2" />
  <chapter number="3" style="c" sid="2KI 3" />
  <para style="s1">Israẹl ọmaana Moab marim egbong</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 3:1" />Wa Joram kw'ode nnwa kw'Ahab okwu otima ẹvaar ch'Israẹl z'Samariya, ny'icho kw'ottong ichi kkanttaan s'Jehoshaphat ọbaabh Juda. Joram oninga z'Samariya ọbaabha k'icho ijobh kkamfa. <verse eid="2KI 3:1" /><verse number="2" style="v" sid="2KI 3:2" />Wa osi itama z'Ọvaar Ibinọkpaabyi k'ititika. Okenaka, itama sẹ mach'njo s'otte ọmaana ọkka kide. Wa ọrọhbh ọta kw'Baal kw'otte ikk'ommina, ọbharẹ. <verse eid="2KI 3:2" /><verse number="3" style="v" sid="2KI 3:3" />Okenaka, Joram ovura ọnana ny'mpyibha njo s'iwa Jẹroboam kw'ode nnwa kw'Nẹbat ikk'anọng p'Israẹl otima osi.<verse eid="2KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 3:4" />Wa Mesha kw'ode ọvaarnọng kw'Moab ode otir-arọkimaan. Wa kẹ ọd-ọnang ọvaarnọng kw'Israẹl ntuma s'arọkimaanva p'ade nnọhna arọbh ijobh kkamfa okwuma ijobh, ọmaana iphyabha s'arọkimaanva nnọhna arọbh ijobh kkamfa okwuma ijobh. <verse eid="2KI 3:4" /><verse number="5" style="v" sid="2KI 3:5" />Okenaka, k'ogbe kw'Ahab ikk'ọpa, ọvaarnọng kw'Moab otima ẹkọhr otor ọvaarnọng kw'Israẹl. <verse eid="2KI 3:5" /><verse number="6" style="v" sid="2KI 3:6" />Ny'ogbe nwo o, ọvaar Joram obina ny'Samariya, od-otobha agbongnọng p'Israẹl maphyir. <verse eid="2KI 3:6" /><verse number="7" style="v" sid="2KI 3:7" />Obira ọtọhm ẹkkaabha ọnang Jehoshaphat kw'ode ọvaarnọng kw'Juda bẹ́: “Ọvaarnọng kw'Moab kk'ẹkọhr otima otor-m e. Ma, ina ator-m morim-ẹ ábẹ̀ o?”</para>
  <para style="p" vid="2KI 3:7">Jehoshaphat ọpọhna bẹ́, “Iye, m'ntor-ọ otor. Kaam ọttara kọ, mode ọttọhk mavanẹ. Anọng pọ ọmaana paam, made ọttọhk mavanẹ. Nnyanya sọ ọmaana saam, ibir ide ọttọhk mavanẹ.”<verse eid="2KI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 3:8" />Jehoshaphat ọbọbh-ẹ bẹ́, “Bọng-eden ch'mm'ozenga orima bẹ ábẹ̀?”</para>
  <para style="p" vid="2KI 3:8">Joram ọpọhna bẹ́, “Mm'ozenga ny'eden ch'Edom ny'ibyi s'anọng nna arukọ.”<verse eid="2KI 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 3:9" />Nya o, ọvaarnọng kw'Israẹl ọmaana ọvaarnọng kw'Juda, ọttara ọvaarnọng kw'Edom, mabina ozenga. K'ogbe kw'nkk'kpangkpangtete asa k'iwu ichenọmfa, asi p'asoja pabẹ ọmaana p'nnyanya sabẹ, makwu asa.<verse eid="2KI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 3:10" />Ọvaarnọng kw'Israẹl oben bẹ́, “Bọng-odik wọ ma o! Oyinẹ bẹ́, Ọvaar Ibinọkpaabyi otim mina avaar attaan okwu ma bẹ́, ọtọka mina oke anọng p'Moab k'mbọhk o?”<verse eid="2KI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 3:11" />Jehoshaphat ọbọbh bẹ́, “Ọgbaak-ettem ch'Ibinọkpaabyi ma kode o, kw'mm'ọbọbh Ọvaar Ibinọkpaabyi odik o?”</para>
  <para style="p" vid="2KI 3:11">Odukwa wanẹ kw'ọvaarnọng kw'Israẹl ọpọhna bẹ́, “Elisha kw'ode nnwa kw'Shaphat, oning ma e. Kẹ wọ kw'uwa Ẹlaija od-otima osi ọtọhm e.”<verse eid="2KI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 3:12" />Jehoshaphat oben bẹ́, “Iyaa! Kẹ ọd-ọgbaak ettem ch'Ọvaar Ibinọkpaabyi k'odik ọkkọkka.” Minna kw'Ọvaarnọng kw'Israẹl, ọmaana Jehoshaphat, ọttara ọvaarnọng kw'Edom mabin akebha Elisha.<verse eid="2KI 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 3:13" />Elisha ọbọbh ọvaarnọng kw'Israẹl bẹ́, “Odik nwa ọmyẹ kaam yen o? Màzọhng kebha agbaak-ettem ch'Ibinọkpaabyi p'atte, ọmaana p'akka.”</para>
  <para style="p" vid="2KI 3:13">Ọvaarnọng kw'Israẹl ọpọhna bẹ́, “Mma e, mokwu ma, okurọ bẹ́, Ọvaar Ibinọkpaabyi ikk'mina avaar attaan otima okwu ma, ọfha ọtọka mina oke anọng p'Moab k'mbọhk e.”<verse eid="2KI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 3:14" />Elisha oben bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir kw'mkpobh orukọ akpen, m'nzenga ikpukpobha s'nyen k'ọvaar Jehoshaphat kw'Juda ábubẹ̀, nyonga bọnga itọhng. <verse eid="2KI 3:14" /><verse number="15" style="v" sid="2KI 3:15" />Mànang-m ọnọng kw'od-okir ogim-ogim.”</para>
  <para style="p" vid="2KI 3:15">K'ose kw'ọnọng nwo od-okir ogim-ogim nwo, ẹfa ch'Ọvaar Ibinọkpaabyi ẹsaka, ẹnwa Elisha k'ifor, <verse eid="2KI 3:15" /><verse number="16" style="v" sid="2KI 3:16" />Elisha oben bẹ́, “Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi obenẹ: Kaam m'nke asi maa, mafu m'nsipe s'igwu-ogwu, m'ilokodo nja. <verse eid="2KI 3:16" /><verse number="17" style="v" sid="2KI 3:17" />Ọvaar Ibinọkpaabyi obenẹ bẹ́: Bọnga mm'ofum màze, m'ẹrọng màbir aze. Chibhẹ nya, asi m'afu nsipe njo. Nya kw'bọnga ọmaana abhaam pabọnga, ọmaana etirakpo mbyoza, mm'agwo asi. <verse eid="2KI 3:17" /><verse number="18" style="v" sid="2KI 3:18" />Odik nwoma ọmọm-ọmọm z'mbọhk s'Ọvaar Ibinọkpaabyi. Kẹ m'obir ọtọka Moab, oke bọnga k'mbọhk. <verse eid="2KI 3:18" /><verse number="19" style="v" sid="2KI 3:19" />Bọnga mm'ana bẹ ebhondim, ọmaana obhon ọkkọkka okpenamkpen kwabẹ. Mm'akkọhbh echi kpenamkpen ch'ejibh-ojibh abharẹ k'izek, makibhẹ nkeka sabẹ maphyir, mabir atima ata akibhẹ ozek ọkkọkka fabẹ.”<verse eid="2KI 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 3:20" />Ewu esobh nya, ny'ogbe kw'mad-afọhnọ ẹja ch'ekpebha, minna kw'asi atọm z'ẹbhaakẹ ch'Edom abhobh. Asi mbo, mafu ny'ibyi njo maphyir.<verse eid="2KI 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 3:21" />K'ogbe kw'anọng p'Moab mabhaang bẹ́, avaar mbo attaan kk'akwa bẹ́, marima bẹ ábẹ̀, mayerẹ ojinọng kpenamkpen kw'ikk'obenga k'egbong oririma: ode nnwa-nnwa o, ode ọtaminọng o, mad-atonga z'enem chabẹ. <verse eid="2KI 3:21" /><verse number="22" style="v" sid="2KI 3:22" />Ch'maphyabh ny'ekpikpebha, echekira ẹmaanẹ ny'asi mbo. Asi mbo akorọ mach'izẹ z'achen p'anọng p'Moab. <verse eid="2KI 3:22" /><verse number="23" style="v" sid="2KI 3:23" />Anọng p'Moab maben ayok bẹ́, “Makirẹ azẹ e! Ṉ́nòsi avaar mbo attaan kk'ayok ábẹ̀ arima, mafhọ ayok e. Ajinọng p'Moab, màbina, mọd-ọcha oyena kwabẹ!”<verse eid="2KI 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 3:24" />Okenaka, k'ogbe kw'agbongnọng p'Moab mapyirẹ z'ibhinga-byi s'Israẹl, agbongnọng p'Israẹl mabina, marima bẹ ábẹ̀ maa, marọbh. Agbongnọng p'Israẹl madim ny'ẹkọma ndo, mafhọ anọng p'Moab. <verse eid="2KI 3:24" /><verse number="25" style="v" sid="2KI 3:25" />Minna kw'mavọhkọ ibhondim sabẹ. Ojinọng kpenamkpen ọbharẹ ẹta ny'iwonọ sabẹ maa, ata abubha iwonọ sabẹ maphyir. Makpa nkeka sabẹ maphyir, mabir akkọhbh echi kpenamkpen ch'ejibh-ojibh, abharẹ. Ebhondim ch'Kir-Hareset dẹ-dẹ dọ iwa neyen ata p'attong-ottonga. Okenaka, agbongnọng p'atim abanttẹttẹ, makọbha ebhondim ndo ake k'ettem, marima dẹ ábẹ̀.<verse eid="2KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 3:26" />K'ogbe kw'ọvaarnọng kw'Moab oze bẹ́, egbong ndo kk'epyibha ẹnang-ẹ, ọtọka agbongnọng anọng ẹnọhna okwuma arọbh ichi p'atim akkangkkang bẹ́, otima odim z'obhon kw'ọvaarnọng kw'Edom. Okenaka, kokpo. <verse eid="2KI 3:26" /><verse number="27" style="v" sid="2KI 3:27" />Nya o, ọvaarnọng kw'Moab, otima ochedennwa kw'ọbaan bẹ́, ọtọka ẹvaarninga chẹ, otim-ẹ ọfọhnọ ẹja ny'etumọ ch'ebhondim. Anọng p'Moab o, matima ottempyibha kwiden arima anọng p'Israẹl maa, agbongnọng p'Israẹl atọr nnam, mabhana zabẹ k'ẹkọma.<verse eid="2KI 3:27" /></para>
  <chapter eid="2KI 3" />
  <chapter number="4" style="c" sid="2KI 4" />
  <para style="s1">Elisha ọkkaan opokwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 4:1" />Wa kwanọng kw'ojinọng wanẹ kw'ọttar k'ekaan ch'agbaak-ettem ch'Ibinọkpaabyi, obhomọ ẹmọng ọkpẹkẹ Elisha bẹ́, “Odim kwaam kw'ode ọtọhmnọng kwọ kk'ọpa. Kọ azong ma bẹ́, wa kẹ okpobh Ọvaar Ibinọkpaabyi mawuriji. Madidanma, ọnọng kw'uwa otim obhorọ okwuma bẹ́, okwu ọtọka ajinọngva paam mach'abira pẹ.”<verse eid="2KI 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 4:2" />Elisha ọpọhn-ẹ bẹ́, “Bọng-eden ch'arorọ bẹ́, nkkaan-o? Tek-m, ayen mbọng z'ọsọhm kwọ?”</para>
  <para style="p" vid="2KI 4:2">Kwanọng nwo ọpọhna bẹ́, “Ọtọhmnọng kwọ ọttọhk z'ọsọhm koyen, kw'ọkpanẹ ana p'oliv p'aning k'ẹsẹbin ch'ikarẹ.”<verse eid="2KI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 4:3" />Elisha oben-ẹ bẹ́, “Zọhng z'ayok-oter pọ maphyir mayaam-ọ nsẹbin s'nna ọttọhk ake. Ben bẹ manang-ọ k'ọsaabh. <verse eid="2KI 4:3" /><verse number="4" style="v" sid="2KI 4:4" />Ó̱de ikk'atọka, dim z'ọsọhm ẹtaanga ọmaana iva pọ, mabhen ọmma. Tọka ana ke ny'nsẹbin njo maphyir. K'ose kw'ekpenamkpen efu, tọka sok ẹbhaakẹ danẹ.”<verse eid="2KI 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 4:5" />Kwanọng nwo ofona, od-obhen ọmma, kẹ ọmaana iva pẹ maninga z'ọsọhm nwo ẹtaanga. Matọka nsẹbin njo achen-ẹ. Ochina ororo oke ana mach'oke nya. <verse eid="2KI 4:5" /><verse number="6" style="v" sid="2KI 4:6" />K'ogbe kw'kwanọng nwo ikk'ana ọka ny'nsẹbin njo maphyir maa, ifu, oben nnwa kwẹ bẹ́, “Chen-m ẹsẹbin ọdọk-ọdọk.”</para>
  <para style="p" vid="2KI 4:6">Okenaka, nnwa nwo ọpọhn-ẹ bẹ́, “Ẹsẹbin ọdọk kerikẹ.” Nya o, ana akpọka oyiyin.<verse eid="2KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 4:7" />Kwanọng nwo ofona od-otek ọgbaak-ettem ch'Ibinọkpaabyi. Ọgbaak-ettem ch'Ibinọkpaabyi oben-ẹ bẹ́, “Zọhng kpe ana mbo tima tuk ibhorọ sọ. Kọ ọmaana iva pọ màtima mboza p'arikẹ, kkaana ifor.”<verse eid="2KI 4:7" /></para>
  <para style="s1">Elisha ọmaana kwanọng kw'ofon Shunem</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 4:8" />Ewu danẹ, Elisha obina ochina z'Shunem. Wa kwanọng wanẹ kw'ojibh-ẹ ojibh orukọ nya. Kwanọng nwo okwukọ Elisha bẹ́, ọyaaka ochi ọttọhk. Tọma nya, ogbe kpenamkpen kw'Elisha okwu ny'obhon nwo, ọyaaka nya, ochi ọttọhk. <verse eid="2KI 4:8" /><verse number="9" style="v" sid="2KI 4:9" />Kwanọng nwo oben odim kwẹ bẹ́, “Kaam nzong bẹ́, ojinọng nwa kw'od-okwu ma k'ogbe kpenamkpen, ode ọnọng kw'owur-owur kw'Ibinọkpaabyi. <verse eid="2KI 4:9" /><verse number="10" style="v" sid="2KI 4:10" />Tte mosi odongọ-nwa z'ẹrọng ch'ọsọhm nwa, mọnang-ẹ, mosok-ẹ ebin nya, ọmaana okpokkoro, ọmaana ogbera, ọttara ottoringkkang, ọfha ogbe kpenamkpen kw'odibhẹ mina, od-oninga nya.”<verse eid="2KI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 4:11" />Ewu danẹ ch'Elisha okwu o, ovura z'idongọ njo, oyima. <verse eid="2KI 4:11" /><verse number="12" style="v" sid="2KI 4:12" />Oben Gehazi kw'ode ọtọhmnọng kwẹ bẹ́, “Yerẹ oShunem-kwanọng nwo nang-m.” Minna kw'oyer-ẹ, okwu obe Gehazi ny'ititika. <verse eid="2KI 4:12" /><verse number="13" style="v" sid="2KI 4:13" />Elisha oben Gehazi bẹ́, “Tek-ẹ bẹ́, ‘Kọ kk'kpọmkpọm nwa maphyir asa anang mina. Bọng-ọttọhk f'mm'osi ọnang-ọ yirẹ? Ma, arorọ bẹ́, mọgbaak odik ọnang ọvaarnọng k'ikọ k'eso, wanẹma, mọgbaak ọnang oso kw'asoja yirẹ?’ ”</para>
  <para style="p" vid="2KI 4:13">Kwanọng nwo ọpọhna bẹ́, “Kaam nrukọ mmaana anọng paam e. Ọttọhk kaam koworọ.”<verse eid="2KI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 4:14" />Elisha ọbọbh Gehazi bẹ́, “Mm'osi mbọng ọnang-ẹ?”</para>
  <para style="p" vid="2KI 4:14">Gehazi ọpọhna bẹ́, “Kwanọng nwa ojinọngnwa koyen, ọttara bẹ́, odim kwẹ kk'ọtama.”<verse eid="2KI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 4:15" />Nya o, Elisha oben bẹ́, “Yer-ẹ bẹ́, okwu.” Minna kw'Gehazi oyer-ẹ, okwu obe ny'ẹsọhmma. <verse eid="2KI 4:15" /><verse number="16" style="v" sid="2KI 4:16" />Elisha oben bẹ́, “Icho ogbese nwa, m'atima ojinọngnwa k'mbọhk sọ.”</para>
  <para style="p" vid="2KI 4:16">Kwanọng nwo ọkaanga odik nwo, oben bẹ́, “Ototo, ọgbaak-ettem ch'Ibinọkpaabyi, kaam ọtọhmnọng kwọ kàbọhra!”<verse eid="2KI 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 4:17" />Minna kw'kwanọng nwo okwu otima ibhọr. Icho ọbhakẹ nya o, okwu otima ojinọngnwa k'ọbọhk ny'ogbese nwo, otor k'ose kw'Elisha ikk'ẹ ọgbaaka.<verse eid="2KI 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 4:18" />Nnwa nwo okwu okwurọ. Ewu danẹ obina od-okebha otte za ch'oning ọmaana anọng p'ad-asi ipha. <verse eid="2KI 4:18" /><verse number="19" style="v" sid="2KI 4:19" />Oben otte bẹ́, “Eso chaam e! Eso chaam e!”</para>
  <para style="p" vid="2KI 4:19">Otte oben ọtọhmnọng wanẹ bẹ́, “Tin-ẹ chena ọkka.” <verse eid="2KI 4:19" /><verse number="20" style="v" sid="2KI 4:20" />K'ogbe kw'ọtọhmnọng nwo ikk'nnwa nwo ọtọka ochena ọkka, ọkka ọdọhk-ẹ ny'ntaak maa, okwu opyirẹ ny'ẹya, nnwa nwo ope. <verse eid="2KI 4:20" /><verse number="21" style="v" sid="2KI 4:21" />Kwanọng nwo ọtọka nnwa nwo od-orurọ z'ebin ch'ọgbaak-ettem ch'Ibinọkpaabyi, ọgbak ọmma, ofona.<verse eid="2KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 4:22" />Oyerẹ odim, oben bẹ́, “Ototo, tọhm ọtọhmnọng wanẹ, ọmaana ẹnyanya chen-m, ọfha nsẹr-ọsẹr nd-nze ọgbaak-ettem ch'Ibinọkpaabyi nwo, pira mkpa nnam.”<verse eid="2KI 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 4:23" />Odim ọbọbh-ẹ bẹ́, “Osempira aben bẹ́, ad-azẹ-ẹ menda o? Ka, odidaama kw'ophe ọbhakwẹ azang, odidaama kw'Ẹwọhngkwokawu kobir ode.”</para>
  <para style="p" vid="2KI 4:23">Kwanọng nwo ọpọhn-ẹ bẹ́, “Odik azang.”<verse eid="2KI 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 4:24" />Kwanọng nwo odo iwọrningabyi z'ẹnyanya, oben ọtọhmnọng kwẹ bẹ́, “Yaar-m tima zọhng, kattẹrẹ o, oye bẹ́, mben-ọ bẹ́, attẹrẹ.” <verse eid="2KI 4:24" /><verse number="25" style="v" sid="2KI 4:25" />Minna kw'kwanọng nwo obin ozenga bẹ́, od-okebha ọgbaak-ettem ch'Ibinọkpaabyi nwo z'Ogbeso kw'Karmẹl.</para>
  <para style="p" vid="2KI 4:25">Ch'ọgbaak-ettem ch'Ibinọkpaabyi nwo oze kwanọng nwo z'ororo ch'od-okwu-okwu, oben Gehazi kw'ode ọtọhmnọng kwẹ bẹ́, “Kirẹ oShunem-kwanọng nwo wọ od-okwu kina e! <verse eid="2KI 4:25" /><verse number="26" style="v" sid="2KI 4:26" />Tima ẹbhar zọhng kebh-ẹ z'eden, abọbh-ẹ bẹ́, ‘Ode yen? Odim ọsẹ-ẹ yen? Nnwa kwọ ọsẹ-ẹ yen?’ ”</para>
  <para style="p" vid="2KI 4:26">Kwanọng nwo ọpọhn-ẹ bẹ́, “Odik kode e.”<verse eid="2KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 4:27" />K'ogbe kw'okebh ọgbaak-ettem ch'Ibinọkpaabyi z'ogbeso, ọbọk-ẹ ny'mmokpatọkọ. Gehazi okwu onyun-ẹ ọbharẹ za. Okenaka, ọgbaak-ettem ch'Ibinọkpaabyi nwo oben Gehazi bẹ́, “Ttẹ-ẹ ọbọhk za! Kirẹ ettem epyibh-ẹ mawuriji. Okenaka, Ọvaar Ibinọkpaabyi kk'aam odik kwẹ odubha, kaam odik kwẹ kobir ọgbaak.”<verse eid="2KI 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 4:28" />Kwanọng nwo oben bẹ́, “Ttatta kwaam, kaam mphyem-ọ nnwa o? Wa kọ kimbenẹ bẹ́, ‘Kaam kasi nsok ichen’?”<verse eid="2KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 4:29" />Elisha oben Gehazi bẹ́, “Kpaama odikpa atima abọka owurọ-baba kwọ z'erin. Tọka ochikwura kwaam tima z'ọbọhk, atima ẹbhar azọhng. Ọnọng kpenamkpen kw'akebh ny'eden kazima. Ó̱nọng óbir ozim-ọ, ẹmọng kasi. Ó̱de apyirẹ za, nana ochikwura kwaam ny'nnwa nwo k'ititika.”<verse eid="2KI 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 4:30" />Okenaka, ọkka kw'nnwa nwo oben bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi oruk akpen, kọ abir aruk akpen, kaam kọ ọbọhk mìntte.” Minna kw'Elisha obin, otor-ẹ mafona.<verse eid="2KI 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 4:31" />Gehazi ochi bẹ eden, ọd-ọnana ochikwura nwo ny'nnwa nwo k'ititika. Okenaka, nnwa nwo ẹmọng kosi, gbar-gbarẹ, kobir osi. Minna kw'Gehazi ọkpa nnam od-otek Elisha bẹ́, “Nnwa nwo kọphyabh e.”<verse eid="2KI 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 4:32" />Elisha opyirẹ ny'ọsọhm nwo o, oze oforbukọ kw'nnwa nwo ch'orurọ ny'ebin. <verse eid="2KI 4:32" /><verse number="33" style="v" sid="2KI 4:33" />Odim z'ẹtaanga, ọgbak ọmma okporọ ifor sẹ ọmaana oforbukọ nwo. Oze njọm ọnang Ọvaar Ibinọkpaabyi. <verse eid="2KI 4:33" /><verse number="34" style="v" sid="2KI 4:34" />Minna kw'ovur z'ebin, oyima ọkpẹ nnwa nwo ny'ifor. Ọnana ẹmma chẹ ny'nnwa nwo k'ẹmma, achen pẹ anana ny'nnwa nwo k'achen, obir ọnana mbọhk sẹ ny'nnwa nwo k'mbọhk. Minna kw'onemẹ ifor sẹ ny'nnwa nwo k'ifor maa, nnwa nwo ọtọma odidaana. <verse eid="2KI 4:34" /><verse number="35" style="v" sid="2KI 4:35" />Elisha obina, ozenga ochina nnam-nnam, obir ozenga ochina ititika-ititika ny'idongọ njo. Pira nọkpa nnam obir onemẹ ifor sẹ ny'nnwa nwo k'ifor. Nnwa nwo osi ikpenẹ igbedim ichenọmfa, owonga achen.<verse eid="2KI 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 4:36" />Elisha oyerẹ Gehazi, oben-ẹ bẹ́, “Yerẹ oShunem-kwanọng nwo nang-m.” Gehazi oyer-ẹ. Okwu nya o, Elisha oben-ẹ bẹ́, “Tọka nnwa kwọ.” <verse eid="2KI 4:36" /><verse number="37" style="v" sid="2KI 4:37" />Kwanọng nwo okwu otto okwubha Elisha ny'ntọkọ k'ekpukpobha-maana. Pira ọtọka nnwa kwẹ otima ọbhana.<verse eid="2KI 4:37" /></para>
  <para style="s1">Elisha ọbhakẹ ọchattọhk-tama okwu ode ọkkọkka</para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 4:38" />Wa Elisha okwu ọkpa nnam z'Gilgal, k'ogbe kw'okwo fiden oning ny'ẹkọma ndo. Agbaak-ettem ch'Ibinọkpaabyi makwu aninga amaan-ẹ. Oben ọtọhmnọng kwẹ bẹ́, “Tọka izọhka siden nọhna z'ekpon, asi ọchattọhk anang agbaak-ettem ch'Ibinọkpaabyi mba.”<verse eid="2KI 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2KI 4:39" />Minna kw'oyok wanẹ obin ochina z'owonọ bẹ́, ọd-ọpha akwongitọhng k'eke. Opyirẹ za o, oze adimava, ọpha k'obenga k'ose kw'm'okpo otima ny'ọttọhk f'ọfọr. Okwun nya o, ọjọhkọ ekpo mbyo oke ny'iwazọhka. Ọnọng kw'ozong ekpo py'oke z'izọhka kode. <verse eid="2KI 4:39" /><verse number="40" style="v" sid="2KI 4:40" />Make awa mbo anang agbaak-ettem ch'Ibinọkpaabyi mbo. K'ose kw'matọm ochichi, mabok k'ẹrọng bẹ́, “Ọgbaak-ettem ch'Ibinọkpaabyi o, ọchattọhk mva otim eyoro o!” Ofona nya, m'ọdọk kakpo achi.<verse eid="2KI 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 4:41" />Elisha oben bẹ́, “Mànang-m agwubuma.” Ọtọka owona ny'iwazọhka njo, oben bẹ́, “Tọka, ke nang anọng machi.” Ọttọhk f'od-obuma ọnọng, ọrọhbha ny'izọhka njo.<verse eid="2KI 4:41" /></para>
  <para style="s1">Elisha ọnang anọng arọbh achen ọchattọhk</para>
  <para style="p">
    <verse number="42" style="v" sid="2KI 4:42" />Wa ojinọng wanẹ kw'ofon z'Baal-Shalisha, otima abrẹd-duk ẹrọbh, ochena ọgbaak-ettem ch'Ibinọkpaabyi. Wa matim icheden-pha s'barli asi abrẹd mbo, ọmaana agwu abhapẹ p'nkk'attama. Elisha oben-ẹ bẹ́, “Tọka, nang anọng machi.”<verse eid="2KI 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2KI 4:43" />Ọtọhmnọng kwẹ ọpọhna bẹ́, “M'nkebh yen pira ottonga anọng arọbh achen mba o?”</para>
  <para style="p" vid="2KI 4:43">Okenaka, Elisha ọpọhn-ẹ bẹ́, “Tọka nang bẹ machi. Kirẹ Ọvaar Ibinọkpaabyi obenẹ bẹ́: ‘Mm'achi maa, obek.’ ” <verse eid="2KI 4:43" /><verse number="44" style="v" sid="2KI 4:44" />Nya o, ọtọka obera bẹ, machi maa, obek, k'ose kw'Ọvaar Ibinọkpaabyi ikk'obena.<verse eid="2KI 4:44" /></para>
  <chapter eid="2KI 4" />
  <chapter number="5" style="c" sid="2KI 5" />
  <para style="s1">Elisha osi Naaman obina k'okpokora</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 5:1" />Wa Naaman ode oso kw'asoja p'ọvaarnọng kw'Aram, obir ọbar otte kw'osi ọtọhm ọmaana odik. Wa oyen ikpukpobha mawuriji okurọ bẹ́, kẹ kw'uwa Ọvaar Ibinọkpaabyi otim okema egbong ọnang anọng p'Aram. Wa ode osojanọng kw'ọbar ettem. Okenaka, wa ode okpokoranọng.<verse eid="2KI 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 5:2" />K'ogbe wanẹ, nkaan s'agbongnọng p'Aram, iyin egbong. Mabọka ominanwa wanẹ kw'ofon Israẹl k'ẹmmọri. Ominanwa nwo okwu oruk kwanọng kw'Naaman ábẹ̀. <verse eid="2KI 5:2" /><verse number="3" style="v" sid="2KI 5:3" />Ewu danẹ, ominanwa nwo oben ọkka kw'orukọ ábẹ̀ bẹ́, “Wúra átte kw'nrukọ ábẹ̀ im'ochera bẹ́, od-oze ọgbaak-ettem ch'Ibinọkpaabyi z'Samariya, wúra ọ́sẹ-ẹ obina ny'okpokora nwo.”<verse eid="2KI 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 5:4" />Minna kw'Naaman obin od-otek otte kw'oruk ábẹ̀ odik kw'ominanwa nwo kw'ofon Israẹl, obenẹ. <verse eid="2KI 5:4" /><verse number="5" style="v" sid="2KI 5:5" />Ọvaarnọng kw'Aram oben-ẹ bẹ́, “K'eden kpenamkpen, zọhng kebha ọvaarnọng kw'Israẹl. Kaam m'ntọhm ẹkkaabha nnang-ẹ.” Naaman ọtọka atalẹn ijobh p'silva, ọmaana ashẹkẹl nnọhna ichi p'gol, ọttara mbara-rin ijobh, otima obina ozenga. <verse eid="2KI 5:5" /><verse number="6" style="v" sid="2KI 5:6" />Ẹkkaabha ndo ch'ọtọk ochena ọvaarnọng kw'Israẹl ede bẹ́: “M'ẹkkaabha nda, kaam ntọhmọ Naaman kw'ode ọtọhmnọng kwaam nnang-ọ bẹ́, abin-ẹ k'okpokora.”<verse eid="2KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 5:7" />Ọvaarnọng kw'Israẹl oyerẹ ẹkkaabha ndo nya o, ọyaakẹ ekpo py'ọfọr z'ifor, oben bẹ́, “Kaam wọ nde Ibinọkpaabyi o? Kọ atọk bẹ́, kaam wọ nd-mfhọ ọnọng, mbir mphyabha ọnọng k'obo o? Osempira atte nwa ọtọhm ọnọng ọnang-m bẹ́, mbin-ẹ k'okpokora? Kk'nza bẹ́, ẹkọhr dọ ch'od-oror-m nya!”<verse eid="2KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 5:8" />K'ogbe kw'Elisha kw'ode ọgbaak-ettem ch'Ibinọkpaabyi ọbhaang bẹ́, ọvaarnọng kw'Israẹl kk'ekpo py'ọfọr ọyaaka, ọtọhm ẹkkaabha nda ochen-ẹ, oben bẹ́: “Bọng ọttọhk f'azeng ábẹ̀ ayaakẹ ekpo py'afọr o? Tọhm ọnọng nwo nang-m, ọfha ozonga bẹ́, ọgbaak-ettem ch'Ibinọkpaabyi oning m'Israẹl.” <verse eid="2KI 5:8" /><verse number="9" style="v" sid="2KI 5:9" />Minna kw'Naaman obin ọttara nnyanya sẹ, ọmaana ijaar s'nnyanya id-itọr, ofona od-obe z'ẹsọhmma ch'Elisha. <verse eid="2KI 5:9" /><verse number="10" style="v" sid="2KI 5:10" />Elisha ọtọhm ozeng-eden, od-oben-ẹ bẹ́, “Zọhng rana ifor sọ z'Ọraanga kw'Jọrdan igbedim ichenọmfa, ọfha abir atọka ifor sọ, okpokora nwo, obir ọttọ-ọ ọbọhk.”<verse eid="2KI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 5:11" />Okenaka, Naaman ọdọk-ẹ, ofona. Oben bẹ́, “Kaam osi-m bẹ́, m'oyin m'iyaan, obe ma oyerẹ eche ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwẹ. Obira owora ọbọhk nya ch'okpokora oning, osi-m mbina. <verse eid="2KI 5:11" /><verse number="12" style="v" sid="2KI 5:12" />Ọraanga kw'Abana, ọmaana ọraanga kw'Pharpar, ọttara araanga p'Damaskọs, majibhẹ ayọhnga araanga p'Israẹl maphyir. Osempira pira z'araanga mbo k'nter nd-nrana, ọfha okpokora ọsa?” Minna kw'ọdọk-ẹ, ọbhakẹ nnam, otima ididọkọ ofona.<verse eid="2KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 5:13" />Atọhmnọng p'Naaman abina akebh-ẹ, maben-ẹ bẹ́, “O ttatta, wúra ọgbaak-ettem ch'Ibinọkpaabyi oben-ọ bẹ́, asi ọttọhk f'ọgaangẹ ọyọhnga mva, wura kasi o? Osempira odik kwẹ machera, k'ogbe kw'oben-ọ bẹ́, ‘Rana ifor sọ k'asi, ọfha abina’?” <verse eid="2KI 5:13" /><verse number="14" style="v" sid="2KI 5:14" />Minna kw'Naaman ofon, od-osi k'ose kw'ọgbaak-ettem ch'Ibinọkpaabyi oben-ẹ, ọrana ifor sẹ ny'Ọraanga kw'Jọrdan igbedim ichenọmfa. Ẹkpakpa chẹ, ebir ekwu ebhona, ẹsọhmọ mach'ẹkpakpa ch'ọbhannwa.<verse eid="2KI 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 5:15" />Nya o, Naaman ọmaana anọng p'ator-ẹ maphyir, makpa nnam z'ọgbaak-ettem nwo kw'Ibinọkpaabyi. Naaman obe ny'ititika s'ọgbaak-ettem ch'Ibinọkpaabyi nwo, oben bẹ́, “K'odik ọkkọkka, kaam menda kk'nzonga bẹ́, Ibinọkpaabyi za kode m'iyagbin kibungọ, kw'ọkpanẹ Ibinọkpaabyi kw'Israẹl. Ototo, tọka ẹnanga ch'kaam ọtọhmnọng kwọ, nnang-ọ.”<verse eid="2KI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 5:16" />Ọgbaak-ettem nwo ọpọhna bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi kw'mkpobh orukọ akpen, ọttọhk kpenamkpen mìntọka.” Chibhẹ ch'Naaman okwuk-ẹ, kocher ọtọka.<verse eid="2KI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 5:17" />Naaman oben bẹ́, “Ó̱de ína ẹnanga chaam màtọka, ototo, kenaka, tte kaam ọtọhmnọng kwọ ọbọhk, mgberẹ izek ma, k'ose kw'anyanyava afa, mm'akpo atọhka, ntima mbhana. Tọma ma, china ororo, kaam ọtọhmnọng kwọ ọdọk nnanga s'ẹkwọmọ, ọmaana ẹja mìmfọhnọ nnang ọka kpenamkpen, kw'ọkpanẹ Ọvaar Ibinọkpaabyi. <verse eid="2KI 5:17" /><verse number="18" style="v" sid="2KI 5:18" />Okenaka, tte Ọvaar Ibinọkpaabyi obina ọnang kaam ọtọhmnọng kwọ k'ọttọhk mavanẹ, f'ode bẹ́: K'ogbe kw'atte kw'nsi ọtọhm mmaana odimẹ z'ọka-pa f'Rimmon bẹ́, ọraka eso ọnang Rimmon, kaam m'ntor-ẹ mọraka eso. K'ogbe kw'nrak eso ny'eden ndo, tte Ọvaar Ibinọkpaabyi obina ọnang kaam ọtọhmnọng kwọ.”<verse eid="2KI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 5:19" />Elisha oben-ẹ bẹ́, “Zọhng k'ọdaam.”</para>
  <para style="p" vid="2KI 5:19">Ch'Naaman ikk'ozenga maa, otuma za, <verse eid="2KI 5:19" /><verse number="20" style="v" sid="2KI 5:20" />Gehazi kw'ode ọtọhmnọng kw'Elisha kw'ode ọgbaak-ettem ch'Ibinọkpaabyi oben z'ettem bẹ́, “Atte kwaam kw'nsi ọtọhm mmaana, ọjọhkọ Naaman nwa kw'ofon Aram maa, obhum ẹnanga ch'otim okwu. K'ose kw'Ọvaar Ibinọkpaabyi oruk akpen, kaam m'nkwubh-ẹ k'eden, ntọka ọttọhk vanẹ ny'ikẹ k'ọbọhk.”<verse eid="2KI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 5:21" />Minna kw'Gehazi oduk-oduka okwubh Naaman k'eden. Ch'Naaman ọzẹ-ẹ za ch'od-otima ẹbhar okwu, obina z'ọkpaar kw'nnyanya id-itọr, ọsaka bẹ́, od-okebh-ẹ. Okebh-ẹ nya o, ọbọbh Gehazi bẹ́, “Ode yen?”<verse eid="2KI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 5:22" />Gehazi ọpọhna bẹ́, “Odik kpenamkpen kode. Atte kwaam kw'nsi ọtọhm mmaana wọ ọtọhm-m bẹ́, mben-ọ bẹ́, ‘Adikkobh afa p'attar k'ẹkaan ch'agbaak-ettem kk'abina z'ẹkọma ch'Ephraim ch'ening k'egbe, makwu. Ọbẹ anang bẹ talẹn kw'silva, ọttara mbara-rin mfa.’ ”<verse eid="2KI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 5:23" />Naaman oben Gehazi bẹ́, “Ototo, tọka atalẹn p'silva afa.” Naaman ọgban-ẹ bẹ́, ọtọka ẹnanga ndo. Gehazi ọtọka atalẹn mbo afa p'silva, ọttara mbara-rin mfa, oyika k'mkpa mfa, ọnang atọhmnọng pẹ afa. Matọhka atima achi Gehazi eden. <verse eid="2KI 5:23" /><verse number="24" style="v" sid="2KI 5:24" />K'ogbe kw'Gehazi opyirẹ z'ogbeso o, ọtọka ekpo mbyo z'atọhmnọng mbo k'mbọhk, osok z'ọsọhm. Oben bẹ bẹ́, màzọhng. Ajinọng mbo mafona.<verse eid="2KI 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 5:25" />K'ogbe kw'odimẹ z'ọsọhm, od-obe otte kw'osi ọtọhm ọmaana k'ititika, Elisha ọbọbh-ẹ bẹ́, “Gehazi, akwun men?”</para>
  <para style="p" vid="2KI 5:25">Gehazi ọpọhn-ẹ bẹ́, “Ttatta, ọtọhmnọng kwọ ibyi kọta.”<verse eid="2KI 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 5:26" />Okenaka, Elisha oben-ẹ bẹ́, “Azong ma bẹ́, wura egwugwuma chaam ening nya ẹmaan-ọ ny'ogbe kw'atte nwo ọsak z'ikẹ k'ọkpaar kw'ẹnyanya ẹd-ẹtọr bẹ́, okebh-ọ? Ma, ogbe kk'opyira kw'm'atọka akpuka, wanẹma, ọbara, wanẹma, owonọ kw'oliv, wanẹma, owonọ kw'grep, wanẹma, arọkimaan, wanẹma, abhaam, wanẹma, abira k'ejinọng ọttara k'ẹpanọng o? <verse eid="2KI 5:26" /><verse number="27" style="v" sid="2KI 5:27" />Okpokora kw'Naaman m'ojeka kọ ọmaana iva pọ, ọttara iva p'iva pọ ma ttattampe.” Minna kw'Gehazi otim okpokora obina ny'Elisha k'ititika, ifor sẹ niwur <char style="it">bẹ́ gwang</char>.<verse eid="2KI 5:27" /></para>
  <chapter eid="2KI 5" />
  <chapter number="6" style="c" sid="2KI 6" />
  <para style="s1">Elisha osi ẹbar-so ewobh k'asi</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 6:1" />Wa ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi ebenẹ Elisha bẹ́, “Kirẹ e, ibyi s'mod-okwu ottonga ọmaan-ọ, kiwenẹ. <verse eid="2KI 6:1" /><verse number="2" style="v" sid="2KI 6:2" />Tte mochina z'ọraanga kw'Jọrdan, mfha ọnọng-ọnọng ọkpaara ẹfa-fa-chi ch'mm'otima osi ibyi s'mmin'ottonga.”</para>
  <para style="p" vid="2KI 6:2">Elisha oben bẹ́, “Màzọhng.”<verse eid="2KI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 6:3" />Oyok wanẹ oben-ẹ bẹ́, “Ma, kọ mina atọhmnọng pọ mator mofona o?”</para>
  <para style="p" vid="2KI 6:3">Elisha ọpọhna bẹ́, “M'ntor bọnga otor.” <verse eid="2KI 6:3" /><verse number="4" style="v" sid="2KI 6:4" />Minna kw'otorọ bẹ mafona.</para>
  <para style="p" vid="2KI 6:4">Mapyirẹ z'ọraanga kw'Jọrdan o, matọma nchi okpukpaara. <verse eid="2KI 6:4" /><verse number="5" style="v" sid="2KI 6:5" />K'ose kw'oyok wanẹ oning nya ọkpaar echi, ẹbar-so chẹ ẹrọhbha etto z'asi. Obok bẹ́, “Mma o, ttatta kwaam! Nnyaam ẹbar ndo ọyaam e!”<verse eid="2KI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 6:6" />Ọgbaak-ettem ch'Ibinọkpaabyi nwo ọbọbh-ẹ bẹ́, “Memma wọ kw'etto?” Otibh-ẹ ibyi s'etto. Elisha ọkpaara echi ọbharẹ ny'ibyi njo, osi ẹbar-so ndo ewobh ny'asi. <verse eid="2KI 6:6" /><verse number="7" style="v" sid="2KI 6:7" />Elisha oben-ẹ bẹ́, “Tinẹ dẹ.” Minna kw'ojinọng nwo onemẹ ọbọhk, otinẹ ẹbar-so ndo.<verse eid="2KI 6:7" /></para>
  <para style="s1">Elisha okem anọng p'Aram</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 6:8" />K'ogbe wanẹ, ọvaarnọng kw'Aram orim egbong ọmaana anọng p'Israẹl. Ọttọhna ọmaana aso p'asoja pẹ bẹ́, “M'nsi ibhinga-byi saam k'ibyi minna-minna.”<verse eid="2KI 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 6:9" />Ọgbaak-ettem ch'Ibinọkpaabyi ọtọhm ẹkkaabha ọnang ọvaarnọng kw'Israẹl bẹ́, “Zong-ọ ifor, ch'im'azenga k'ibyi minna-minna, kirẹ anọng p'Aram machin ny'ẹbhaakẹ ndo.” <verse eid="2KI 6:9" /><verse number="10" style="v" sid="2KI 6:10" />Ofona nya, ọvaarnọng kw'Israẹl ọtọhm ẹkkaabha ọnang anọng p'arukọ ny'ibyi njo s'Elisha ọgbaak odik ọmaana. K'igbe-k'igbe, Elisha ọd-ọtọr ọvaarnọng itọhng, ọfha oning-ẹ ifor ọzaam k'obyise mvo.<verse eid="2KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 6:11" />Odik nwo opyibh ọvaarnọng kw'Aram ettem mawuriji. Oyerẹ aso p'asoja pẹ mattonga. Ọbọbh bẹ bẹ́, “Màtek-m, bọng-ọnọng m'amina k'ẹkaan wọ ọd-ọgbaak ọvaarnọng kw'Israẹl idik saam o?”<verse eid="2KI 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 6:12" />Osonọng wanẹ kw'asoja pẹ oben-ẹ bẹ́, “Ttatta ọvaarnọng kwaam, ọnọng ma kode kw'otek-e. Elisha kw'ode ọgbaak-ettem ch'Ibinọkpaabyi kw'oning z'Israẹl, kẹ wọ od-otek ọvaarnọng odik kpenamkpen kw'agbaakẹ e, zaabẹ́ aning z'idongọ agbaak.”<verse eid="2KI 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 6:13" />Ọvaarnọng kw'Aram oke ẹfa bẹ́, “Màzọhng ror ibyi s'Elisha nwo oning, ọfha ntọhm anọng mabọk-ẹ.” Ẹkkaabha ekwu epyirẹ ọvaarnọng bẹ́, “Elisha oning z'Dọtan.” <verse eid="2KI 6:13" /><verse number="14" style="v" sid="2KI 6:14" />Minna kw'ọvaarnọng kw'Aram ọtọhmọ agbongnọng p'agaang-ọgaangẹ za, ọmaana nnyanya, ọttara ijaar s'nnyanya id-itọr. Matima erungọ, mad-akọbha ebhondim ndo maphyir make k'ettem.<verse eid="2KI 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 6:15" />K'ogbe kw'ọtọhmnọng kw'ọgbaak-ettem ch'Ibinọkpaabyi ọphyabh ny'ekpikpebha oyin k'iyaan, oze bẹ́, asoja, ọmaana nnyanya, ọttara ijaar s'nnyanya id-itọr, nkk'ebhondim ndo akọbha ake k'ettem. Ọkpa nnam od-otek Elisha bẹ́, “O ttatta kwaam! Mm'osi yen o?”<verse eid="2KI 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 6:16" />Ọgbaak-ettem ch'Ibinọkpaabyi nwo oben-ẹ bẹ́, “Oning-ọ ojor, kirẹ anọng p'aning amaana mina, masaabhẹ ayọhnga anọng p'aning amaana bẹ.”<verse eid="2KI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 6:17" />Minna kw'Elisha oze njọm bẹ́, “O Ọvaar Ibinọkpaabyi! Wong-ẹ achen, ọfha oze iyaan.” Minna kw'Ọvaar Ibinọkpaabyi owong achen p'ọtọhmnọng nwo kw'Elisha. M'otinẹ ichen okkerẹ z'agbeso, oze nnyanya ọmaana ijaar s'nnyanya id-itọr s'itim akpondaak s'ikk'ibaana ikọbha Elisha ọkọbha <char style="it">bẹ́ byim</char>.<verse eid="2KI 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 6:18" />K'ose kw'asoja mbo mazeng anyọma Elisha bẹ́, marim-ẹ ábẹ̀, oze njọm bẹ́, “O Ọvaar Ibinọkpaabyi, ototo, kpa asoja mba ichen.” Minna kw'Ọvaar Ibinọkpaabyi ọbhaang njọm s'Elisha, osi anọng mbo makpa achen, mbengana k'ose kw'Elisha oze njọm.<verse eid="2KI 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 6:19" />Elisha oben bẹ bẹ́, “Eden ch'makamẹ azang ma, obhon kw'mabir akam azang ma. Màyak-m nnam, nd-ntibh bọnga ọnọng kw'marorọ.” Minna kw'otim bẹ ochina z'Samariya.<verse eid="2KI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 6:20" />K'ose kw'madimẹ ny'Samariya, Elisha oben bẹ́, “O Ọvaar Ibinọkpaabyi, wonga achen p'anọng mba, mfha maze iyaan.” Minna kw'Ọvaar Ibinọkpaabyi owong achen pabẹ, makwu aze bẹ́, nnaning z'ebhon-ttem ch'Samariya.<verse eid="2KI 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 6:21" />K'ogbe kw'ọvaarnọng kw'Israẹl oze bẹ nya, ọbọbh Elisha bẹ́, “Ttatta kwaam, ma, mfhọ bẹ o? Ma, mfhọ bẹ o?”<verse eid="2KI 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 6:22" />Elisha ọpọhna bẹ́, “Mma e, bẹ kafhọ. Kọbaan bẹ́, afhọ anọng p'abọk k'egbong e. Tọka ọchattọhk nang bẹ machi, anang bẹ asi magwo, mfha makpa nnam makebha otte kwabẹ za.” <verse eid="2KI 6:22" /><verse number="23" style="v" sid="2KI 6:23" />Minna kw'ọvaarnọng kw'Israẹl osok bẹ eninga chiden. Ch'agbongnọng mbo nkk'ọttọhk acha, mabir agwo, ọvaarnọng kw'Israẹl oben bẹ mabhana z'otte kwabẹ. Minna kw'anọng p'Aram, makpọk ẹkọma ch'Israẹl ábẹ̀ oririma.<verse eid="2KI 6:23" /></para>
  <para style="s1">Bẹn-Hadad oyim egbong z'Samariya</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 6:24" />Otum k'ogbe wanẹ, Bẹn-Hadad kw'ode ọvaarnọng kw'Aram, otobha asoja pẹ maphyir, otima bẹ oyin egbong. Makọbha Samariya ake k'ettem. <verse eid="2KI 6:24" /><verse number="25" style="v" sid="2KI 6:25" />Wa egbong ndo ekpenẹ maa, okwo fiden okwu ny'ebhondim ndo. Ofona nya, makpe ẹnyanya-so k'ashẹkẹl p'silva arọbh anna, mabir akpe ọkkọbh kw'affu p'ikpommuka, k'ashẹkẹl achen.<verse eid="2KI 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 6:26" />K'ewu danẹ ch'ọvaarnọng kw'Israẹl od-ozenga ny'okikan kw'etumọ ch'ebhondim, kwanọng wanẹ obhom oyer-ẹ bẹ́, “Ttatta ọvaarnọng kwaam, ototo, kkaan-m!”<verse eid="2KI 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 6:27" />Ọvaarnọng ọpọhna bẹ́, “Ó̱de Ọvaar Ibinọkpaabyi ina kọ ọkkaan, memma kw'm'ntọka ẹkkaana nnang-ọ? Ma, m'ntọka z'ọgbaarẹ kw'nd-aduk barli o, wanẹma, za ch'nd-amyana atuk o?” <verse eid="2KI 6:27" /><verse number="28" style="v" sid="2KI 6:28" />Nya o, ọbọbh kwanọng nwo bẹ́, “Bọng-ọttọhk vọ ọyak-ọ odik o?”</para>
  <para style="p" vid="2KI 6:28">Kwanọng nwo ọpọhna bẹ́, “Kwanọng nwa oben-m bẹ́, ‘Tima ojinọngnwa kwọ kwu mọchẹ-ẹ menda, ophyinẹ mochi kwaam.’ <verse eid="2KI 6:28" /><verse number="29" style="v" sid="2KI 6:29" />Minna kw'mọwọhnọ nnwa kwaam mochi. Ewu esobh nya, mben-ẹ bẹ́, ‘Tima nnwa kwọ kwu, mọchẹ-ẹ.’ okenaka, kẹ ọtọka nnwa kwẹ odubh.”<verse eid="2KI 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 6:30" />Ọvaar Bẹn-Hadad ọbhaang odik kw'kwanọng nwo nya o, ọyaakẹ ekpo py'ọfọr z'ifor. Ch'od-ozenga ny'okikan kw'etumọ, anọng akker-ẹ, maze bẹ́, ekpo py'ọfọr z'ifor ẹtaanga, kk'ẹyaaka. <verse eid="2KI 6:30" /><verse number="31" style="v" sid="2KI 6:31" />Ọvaarnọng oben bẹ́, “Tte Ibinọkpaabyi ọnang-m irem, k'ose kpenamkpen kw'ọdaak-ẹ, óde ina Elisha kw'ode nnwa kw'Shaphat eso mpe!”<verse eid="2KI 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 6:32" />Ny'ogbe nwo, wa Elisha oning ọmaana asogbọhkọnọng z'ikẹ k'ọsọhm. Ọvaarnọng ọtọhm ozeng-eden kwẹ z'Elisha. Okenaka, pira ozeng-eden nwo opyirẹ, Elisha oben asogbọhkọnọng mbo bẹ́, “Màkirẹ, ọfhọ-anọng nwa kk'ọnọng ọtọhma bẹ́, okwu ope-m eso e. Ó̱de ozeng-eden nwo opyirẹ, màgbak ọmma kpor-ẹ z'iyaan. Mọbhaang ntọkọ s'otte ch'id-iyak-ẹ nnam.” <verse eid="2KI 6:32" /><verse number="33" style="v" sid="2KI 6:33" />Nya ch'Elisha oning nya ọgbaak odik ọnang bẹ, ozeng-eden nwo okwu okebh-ẹ nya.</para>
  <para style="p" vid="2KI 6:33">Ọvaar Bẹn-Hadad oben bẹ́, “Itama nja ifon z'Ọvaar Ibinọkpaabyi. Kayen kw'm'nchina ororo, ntik Ọvaar Ibinọkpaabyi?”<verse eid="2KI 6:33" /></para>
  <chapter eid="2KI 6" />
  <chapter number="7" style="c" sid="2KI 7" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 7:1" />Elisha ọpọhna ọvaar Bẹn-Hadad bẹ́, “Bhaanga odik kw'Ọvaar Ibinọkpaabyi ọgbaakẹ. Ọvaar Ibinọkpaabyi obenẹ bẹ́: Ophyinẹ ogbese nwa, mm'akpe ogbobh-mbọhk kw'agwubuma ọkkọkka k'shẹkẹl mawanẹ z'ebhumma ch'Samariya. Mm'abir akpe agbobh-mbọhk afa p'barli k'shẹkẹl mawanẹ, ny'ebhumma ch'Samariya.”<verse eid="2KI 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 7:2" />Osojanọng nwo kw'od-okkerẹ ọvaarnọng oben bẹ́, “Zaabẹ́ Ọvaar Ibinọkpaabyi ogwung amma p'ọrọngkpakpa, minna mòde?”</para>
  <para style="p" vid="2KI 7:2">Elisha ọpọhna bẹ́, “Kọ m'atima achen pọ aze ch'odik nwo im'oyin minna. Okenaka, kọ ọttọhk kpenamkpen nya, màchi!”<verse eid="2KI 7:2" /></para>
  <para style="s1">Anọng p'Siriya marọbhọ arik obhon</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 7:3" />Wa oyen ajinọng anna p'okpokora ọmma p'aning ny'ebhumma ch'ebhondim ch'Samariya. Maben ayok bẹ́, “Kayen kw'mm'oning ma, mope o? <verse eid="2KI 7:3" /><verse number="4" style="v" sid="2KI 7:4" />Ó̱de mobenẹ bẹ́, ‘Modim z'ebhondim’, okwo fiden f'oning za, m'ọfhọ mina ọfhọ. Ó̱de mobir oben bẹ́, moninga ma, mm'opope. Ofona nya, tte mojeka ochina z'ibhinga-byi s'anọng p'Aram, mfha motte ifor samina ọbọhk, ọnang bẹ. Ó̱de nna mina afhọ, mm'oruk-oruk, óde mabir afhọ mina, mope.”<verse eid="2KI 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 7:5" />Otum k'ẹsọhka, mabina achina z'ibhinga-byi s'anọng p'Aram. K'ogbe kw'mapyirẹ ny'ẹtọma ch'ibhinga-byi s'anọng p'Aram, m'ọnọng kaze. <verse eid="2KI 7:5" /><verse number="6" style="v" sid="2KI 7:6" />Ode ch'Ọvaar Ibinọkpaabyi ikk'anọng p'Aram ọsa, mabhaanga izozo s'ijaar s'nnyanya id-itọr, ọmaana s'nnyanya, ọttara s'asoja k'ọsaabh. Ọwọhkọ maben ayok bẹ́, “Màkirẹ, ọvaarnọng kw'Israẹl kk'anọng p'Hẹt, ọmaana avaar p'Ijip ọyaama bẹ́, makwu arima mina ábẹ̀!” <verse eid="2KI 7:6" /><verse number="7" style="v" sid="2KI 7:7" />Ofona nya, mabina ny'ẹsọhka, marọbh arik okkira fabẹ, ọmaana nnyanya, ọttara nnyanya s'id-itọhka ekpo. Marọbh arik ọttọhk kpenamkpen f'oning ny'ibhinga-byi njo, makaam akpen pabẹ.<verse eid="2KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 7:8" />Ajinọng mbo p'okpokora ọmma, mapyirẹ ny'ẹtọma ch'ibhinga-byi njo, madim k'ikkira janẹ, machi, mabir agwo. Matọka silva, ọmaana gol, ọttara ọbara, mad-adubh. Makpa nnam, madim k'ikkira ọdọk-ọdọk, macha ekpo byanẹ nya, mad-adubh.<verse eid="2KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 7:9" />Nya o, maben ayok bẹ́, “Ọttọhk f'nd-osi ma, kọbaan. Ewu nda ede ewu ch'etim ẹkkaabha ọkkọkka ekwu. Kojibhẹ bẹ́, mosok ẹkkaabha ndo m'amina k'ifor kẹ-kẹ. Ó̱de mótikẹ bẹ́, ewu esobha, pira mosi ẹkkaabha nda ẹnyaamẹ, mm'ọtọka irem. Tte moter ofona <char style="it">bẹ́ kpaar</char>, mod-otek anọng odik nwa z'ọvaarsọhm.”<verse eid="2KI 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 7:10" />Minna kw'mafon, mad-ayerẹ akker-ebhumma p'ebhondim, matek bẹ bẹ́, “Mochin z'ibhinga-byi s'anọng p'Aram, m'ọnọng za kokebh, m'ọnọng mawanẹ ẹmọng kobir ọbhaanga. Mokenka okebha nnyanya sabẹ, ọmaana nnyanya s'itim ọgbọk k'nnam, ọttara okkira f'nkk'arọbha arik.” <verse eid="2KI 7:10" /><verse number="11" style="v" sid="2KI 7:11" />Nya o, akker-ebhumma mbo, masi ẹkkaabha ndo ẹnyaamẹ, mabir atima ẹkkaabha ndo achina z'ọvaarsọhm.<verse eid="2KI 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 7:12" />Minna kw'ọvaarnọng obin ny'orungittem, oben adukwa pẹ bẹ́, “Kaam m'ntek bọnga ọttọhk f'anọng p'Aram asi ma. Mazong bẹ́, m'ọttọhk f'ẹcha koyen; kẹ wọ osi mabina arik ibhinga-byi sabẹ, matubha z'ẹgba atik mina, mfha ch'mm'okwu oror ọchattọhk, mabọka mina k'mbọhk, matọka ebhondim chamina.”<verse eid="2KI 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 7:13" />Odukwa wanẹ kwẹ oben bẹ́, “Tte anọng banẹ atọka nnyanya nchen ny'nnyanya njo s'irikẹ ny'ebhondim, matima ad-abaana ibhinga-byi s'anọng p'Aram. Ó̱de mafhọ bẹ za, m'ode mbenga mach'anọng p'Israẹl maphyir p'nkk'opupa, apa. Tte mọtọhm bẹ mad-abaana, mfha moze odik kw'im'oyin.”<verse eid="2KI 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 7:14" />Ofona nya, ọvaarnọng ọrọhbha ajinọng afa, ọtọhm bẹ bẹ́, matima ijaar ifa s'nnyanya id-itọr, mad-abaana asoja p'Aram. Oben bẹ bẹ́, “Màzọhng baana, maze odik kw'oyinẹ.” <verse eid="2KI 7:14" /><verse number="15" style="v" sid="2KI 7:15" />Ajinọng mbo mayaar ator bẹ maa, mapyirẹ z'ọraanga kw'Jọrdan. K'ose kw'mayaarẹ ny'eden, maze ọbara, ọmaana ekpo py'anọng p'Aram ch'ẹraamẹ ny'eden k'ose kw'nd-arọbh. Ajinọng mbo makwuna, makwu atek ọvaarnọng. <verse eid="2KI 7:15" /><verse number="16" style="v" sid="2KI 7:16" />Nya o, anọng p'Samariya mafona, mazeng z'ibhinga-byi s'anọng p'Aram, macha oyena kwabẹ atima afona. Pira nnad-akpe ogbobh-mbọhk kw'agwubuma ọkkọkka k'shẹkẹl mawanẹ. Makpe agbobh-mbọhk afa p'barli-buma k'shẹkẹl mawanẹ, k'ose kw'Ọvaar Ibinọkpaabyi ikk'ọgbaaka.<verse eid="2KI 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 7:17" />Ode ch'ọvaarnọng ikk'ọnọng kw'od-okker-ẹ obena bẹ́, okkerẹ ebhumma. Anọng abarẹ ọnọng nwo mmo ny'ebhumma maa, ope. Odik nwo oyin otor k'ose kw'Elisha kw'ode ọgbaak-ettem ch'Ibinọkpaabyi ikk'ọgbaaka k'ogbe kw'ọvaarnọng okebh-ẹ z'ọsọhm. <verse eid="2KI 7:17" /><verse number="18" style="v" sid="2KI 7:18" />Wa ode k'ose kw'ọgbaak-ettem ch'Ibinọkpaabyi ikk'ọvaarnọng obena bẹ́, “Ophyinẹ ogbese nwa, mm'akpe ogbobh-mbọhk kw'agwubuma ọkkọkka k'shẹkẹl mawanẹ, mabir akpe agbobh-mbọhk afa p'barli k'shẹkẹl mawanẹ, ny'ebhumma ch'Samariya.”<verse eid="2KI 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 7:19" />Wa ọnọng nwo kw'od-okkerẹ ọvaarnọng kk'ọgbaak-ettem ch'Ibinọkpaabyi okkikken obena bẹ́, “Zaa wura Ọvaar Ibinọkpaabyi ogwung amma p'ọrọngkpakpa otte eje, minna mòde.” Wa Elisha kk'ẹ ọpọhna bẹ́, “Kọ m'atima achen pọ aze odik nwo ch'im'oyin. Okenaka, kọ ọttọhk kpenamkpen nya, màchi!” <verse eid="2KI 7:19" /><verse number="20" style="v" sid="2KI 7:20" />Wa odik nwo oyin mbengana mach'Elisha ikk'ọgbaaka. Anọng abarẹ ọnọng nwo mmo ny'ebhumma maa, ope.<verse eid="2KI 7:20" /></para>
  <chapter eid="2KI 7" />
  <chapter number="8" style="c" sid="2KI 8" />
  <para style="s1">Ekwuna ch'oShunẹm-kwanọng</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 8:1" />Wa Elisha kk'kwanọng nwo kw'osi nnwa kwẹ ọphyabha k'obo obena bẹ́, “Tima ẹsọhmmọr chọ bina, mad-aninga k'ibyi kpenamkpen s'idaak-ọ k'ogbe makarẹ. Kirẹ, Ọvaar Ibinọkpaabyi kk'obena bẹ́, ekimẹkimẹ chiden m'eninga ma, k'icho ichenọmfa.” <verse eid="2KI 8:1" /><verse number="2" style="v" sid="2KI 8:2" />Minna kw'kwanọng nwo obin osi k'ose kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo obenẹ. Otima ẹsọhmmọr chẹ obina ozeng z'ẹkọma ch'Philistiya, od-oninga za k'icho ichenọmfa.<verse eid="2KI 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 8:3" />Icho nwo kw'ottong ichenọmfa ọsa nya o, kwanọng nwo obina z'ẹkọma ch'Philistiya okwuna. Ozeng z'ọvaarnọng, od-ophyem-ẹ bẹ́, ọnang-ẹ ọsọhm, ọttara izek sẹ. <verse eid="2KI 8:3" /><verse number="4" style="v" sid="2KI 8:4" />Wa ọvaarnọng ọd-ọgbaak odik ọnang Gehazi kw'ode ọtọhmnọng kw'ọgbaak-ettem ch'Ibinọkpaabyi, oben bẹ́, “Tek-m idik s'ibar odik maphyir s'Elisha ikk'ọsa.” <verse eid="2KI 8:4" /><verse number="5" style="v" sid="2KI 8:5" />K'ose kw'Gehazi od-otek ọvaarnọng ose kw'Elisha kk'ọnọng ọphyabha k'obo, kwanọng nwo kw'Elisha ọphyabh nnwa kwẹ k'obo oyin nya bẹ́, ophyem ọvaarnọng, ọnang-ẹ ọsọhm, ọttara izek sẹ. Gehazi oben bẹ́, “Ttatta ọvaarnọng kwaam, kwanọng nwo wọ ma e, ojinọngnwa kwẹ kw'Elisha ọphyabh k'obo e.” <verse eid="2KI 8:5" /><verse number="6" style="v" sid="2KI 8:6" />Ọvaarnọng ọbọbh kwanọng oyenẹ odik nwo. Kwanọng nwo otek-ẹ.</para>
  <para style="p" vid="2KI 8:6">Ọvaarnọng ọtọka odik kw'kwanọng nwo ọgbaara ọtọhmnọng wanẹ kwẹ, oben-ẹ bẹ́, “Tọka ọttọhk kpenamkpen f'ode f'kwanọng nwo, nang-ẹ, ozeng k'ikpuka maphyir s'ifon z'izek sẹ, tọma ny'ewu ch'iwa obin orik obhon maa, pyirẹ menda.”<verse eid="2KI 8:6" /></para>
  <para style="s1">Hazayẹl ọfhọ Bẹn-Hadad</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 8:7" />Wa Ẹlisha obina ochina z'Damaskus k'ogbe kw'ọvaar Bẹn-Hadad kw'Aram ọmmẹ-ẹ ọmma. Matek ọvaarnọng bẹ́, “Ọgbaak-ettem ch'Ibinọkpaabyi kk'ozenga k'odenbhir okwu ma e.” <verse eid="2KI 8:7" /><verse number="8" style="v" sid="2KI 8:8" />Ọvaar Bẹn-Hadad oben Hazayẹl kw'ode odukwa kwẹ bẹ́, “Tọka ẹnanga tima kebha ọgbaak-ettem ch'Ibinọkpaabyi, aben-ẹ ọbọbh Ọvaar Ibinọkpaabyi bẹ́, ‘Ma, ina mbina m'ọkọhmaana mva o?’ ” <verse eid="2KI 8:8" /><verse number="9" style="v" sid="2KI 8:9" />Minna kw'Hazayẹl ofon od-okebha Elisha. Otima ẹnanga ch'ekpo py'ejibhẹ ọtam ny'Damaskọs, ọnana k'akamẹl arọbh afa, otima od-obe Elisha ny'ititika, oben-ẹ bẹ́, “Nnwa kwọ Bẹn-Hadad kw'ode ọvaarnọng kw'Aram wọ ọtọhm-m bẹ́, nkwu mbọbh-ọ bẹ́, ‘Ma, ina mbina m'ọkọhmana mva o?’ ” <verse eid="2KI 8:9" /><verse number="10" style="v" sid="2KI 8:10" />Ẹlisha ọpọhna bẹ́, “Zọhng ben-ẹ bẹ́, ‘Etuna kede bẹ́, m'abin-obina ny'ọkọhmaana mvo.’ Okenaka, Ọvaar Ibinọkpaabyi kk'ẹyaakẹ ọsa ọnang-m bẹ́, kẹ m'opope k'odik ọkkọkka.” <verse eid="2KI 8:10" /><verse number="11" style="v" sid="2KI 8:11" />Elisha ottima Hazayẹl ichen maa, mgbar isẹ-ẹ. Minna kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo ọtọma ẹmọng obhubhom.<verse eid="2KI 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 8:12" />Hazayẹl ọbọbh-ẹ bẹ́, “Ode yen kw'ttatta kwaam od-obhom ẹmọng o?”</para>
  <para style="p" vid="2KI 8:12">Elisha ọpọhna bẹ́, “Nd-mbhom okurọ itama s'nzong bẹ́, m'asi anọng p'Israẹl. Kọ m'ake ekpon k'ọfa-byi fabẹ, atima ọkkangkkang afhọ ajinọngva pabẹ, amaam ivava biribirẹ pabẹ ny'izek, abir ataarẹ panọng pabẹ p'atim ibhọr.”<verse eid="2KI 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 8:13" />Hazayẹl oben bẹ́, “Kaam ọtọhmnọng kwọ kw'nde mach'ọfa-nnwa kw'ina ọttọhk áfẹ̀ ọbang, m'ntọma yen pira nsi odik katamse nwo o?”</para>
  <para style="p" vid="2KI 8:13">Ẹlisha ọpọhna bẹ́, “Ọvaar Ibinọkpaabyi kk'aam ọkọhka bẹ́, kọ m'ade ọvaarnọng kw'Aram.”<verse eid="2KI 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 8:14" />Minna kw'Hazayẹl obin orik Elisha nya, ọkpa nnam z'otte kw'orukọ abẹ. K'ogbe kw'Bẹn-Hadad ọbọbhọ Hazayẹl bẹ́, “Elisha oben-ọ yen?” Hazayẹl ọpọhn-ẹ bẹ́, “Otek-m bẹ́, kọ m'abin-obina k'ọkọhmaana k'odik ọkkọkka.” <verse eid="2KI 8:14" /><verse number="15" style="v" sid="2KI 8:15" />Okenaka, ewu esobh nya, Hazayẹl ọtọka ọbangmgbodo, kw'ikk'ọrana k'asi, obubha ọvaarnọng k'ititika. Ofona nya, ọvaarnọng ope. Hazayẹl o, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 8:15" /></para>
  <para style="s1">Jehoram otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 8:16" />Ny'icho ttong ichen s'Joram kw'ode nnwa kw'ọvaar Ahab kw'Israẹl ọbaabh, ny'ogbe kw'Jehoshaphat ode ọvaarnọng kw'Juda, nya kw'Jehoram kw'ode nnwa kw'Jehoshaphat, ọtọm Juda obubaabha. <verse eid="2KI 8:16" /><verse number="17" style="v" sid="2KI 8:17" />Wa Jehoram ode icho ẹrọbh okwuma ijobh kkamfa, k'ogbe kw'ọtọm ẹvaar otitima. Oninga z'Jẹrusalẹm ọbaabha k'icho ochenọnttaan. <verse eid="2KI 8:17" /><verse number="18" style="v" sid="2KI 8:18" />Wa kẹ otorọ ntọkọ s'avaarnọng p'Israẹl, k'ose kw'ẹsọhmmọr ch'Ahab ikk'ẹsa, okurọ ch'ọtọk ominanwa wanẹ kw'Ahab k'ọbada. Wa osi itama k'ititika s'Ọvaar Ibinọkpaabyi. <verse eid="2KI 8:18" /><verse number="19" style="v" sid="2KI 8:19" />Chibhẹ ch'ode minna, Ọvaar Ibinọkpaabyi ozenga Devid kw'ode ọtọhmnọng kwẹ ábubẹ̀, ọtọr ifor k'edimẹ ch'ọkamẹ bẹ́, m'odimẹ Juda. Wa kẹ kk'ocheka bẹ́, ọnọng mòwor ny'ọsọhm kw'Devid, kw'im'otima ẹvaar ch'Devid, ttattampe.<verse eid="2KI 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 8:20" />K'ogbe kw'Jehoram ọbaabh, nya kw'anọng p'Edom make anọng p'Juda ẹkọhr. Ny'ogbe nwo wọ kw'mabir abhaaka ẹvaar chabẹ oyenẹ. <verse eid="2KI 8:20" /><verse number="21" style="v" sid="2KI 8:21" />Ofona nya, Jehoram otima ijaar sẹ maphyir s'nnyanya id-itọr, ochina z'Zair. Wa anọng p'Edom akọbha kẹ, ọttara aso p'ayaar ijaar sẹ s'nnyanya id-itọr ake k'ettem. Otum ny'erungọ, obina ọmaana aso p'ayaar ijaar s'nnyanya id-itọr, ọphaakẹ ny'ottem kw'ikpakaana njo, odwu z'okwubha. Okenaka, asoja pẹ, marọbh akpa nnam zabẹ k'isọhm. <verse eid="2KI 8:21" /><verse number="22" style="v" sid="2KI 8:22" />Tọma za maa, pyirẹ ma, anọng p'Edom aning k'ẹkọhr amaana anọng p'Juda. Ny'ogbe nwo mawan-wanẹ, wa ẹkọma ch'Libna, ebir ẹjẹ ẹkọhr.<verse eid="2KI 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 8:23" />Idik njoza s'iyinẹ k'ogbe kw'Jehoram ọbaabh, ọmaana idik s'osi maphyir, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 8:23" /><verse number="24" style="v" sid="2KI 8:24" />Wa Jehoram okwu ope, manọhng-ẹ za ch'manọhng ab'otte, z'ebhondim ch'Devid. Ojinọngnwa kwẹ kw'okpen Ahaziya, okwu ọtọka ẹvaarninga ch'otte.<verse eid="2KI 8:24" /></para>
  <para style="s1">Ahaziya otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 8:25" />Ny'icho ttong ijobh kkamfa s'Joram kw'ode nnwa kw'Ahab ọbaabh Israẹl, nya kw'Ahaziya kw'ode nnwa kw'ọvaar Jehoram kw'Juda, ọtọm ẹbaabha. <verse eid="2KI 8:25" /><verse number="26" style="v" sid="2KI 8:26" />Wa Ahaziya ode icho ẹrọbh okwuma ifa k'atam, k'ogbe kw'masẹ-ẹ ẹvaar. Oninga z'Jẹrusalẹm ọbaabha k'icho mawanẹ. Wa ọkka kwẹ okpen Ataliya, kw'ode nnwa kw'nnwa kw'ọvaar Omri kw'Israẹl. <verse eid="2KI 8:26" /><verse number="27" style="v" sid="2KI 8:27" />Wa otorọ ntọkọ s'ẹsọhmmọr ch'Ahab. Osi itama z'ititika s'Ọvaar Ibinọkpaabyi, k'ose kw'ẹsọhmmọr ch'Ahab ikk'ẹsa, okurọ ch'iwa ọtọk kwanọng ny'echimma ndo.<verse eid="2KI 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 8:28" />Ahaziya otima Joram kw'ode nnwa kw'Ahab, od-orima ọvaar Hazayẹl kw'Aram ábẹ̀, z'Ramọt-Gilead. Anọng p'Aram mamuma Joram ekpo. <verse eid="2KI 8:28" /><verse number="29" style="v" sid="2KI 8:29" />Minna kw'ọvaar Joram ọkpa nnam z'Jẹzrẹl. Oninga za bẹ́, abhaak p'ekpo py'anọng p'Aram nkk'ẹ amuma z'egbong ch'orim ọmaana ọvaar Hazayẹl z'Ramọt-Gilead, mape. Nya o, Ahaziya kw'ode nnwa kw'ọvaar Jehoram kw'Juda, obina ozeng z'Jẹzrẹl, od-oze Joram kw'Ahab obhonọ, okurọ ekpo py'nkk'ẹ amuma.<verse eid="2KI 8:29" /></para>
  <chapter eid="2KI 8" />
  <chapter number="9" style="c" sid="2KI 9" />
  <para style="s1">Madibhẹ Jehu ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 9:1" />Wa Elisha kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, oyerẹ ojinọng wanẹ kw'ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi, oben-ẹ bẹ́, “Tima odikpa kwọ bọka ọnọhma-baba kwọ. Tọka ogberenwa nwoma kw'ana p'oliv, tima china z'Ramọt-Gilead. <verse eid="2KI 9:1" /><verse number="2" style="v" sid="2KI 9:2" />Ápyirẹ za, ror Jehu kw'ode nnwa kw'Jehoshaphat kw'ode nnwa kw'Nimshi. Akebh-ẹ za, tim-ẹ bina nya ch'ayok aning, atim-ẹ adim z'idongọ s'ẹtaanga. <verse eid="2KI 9:2" /><verse number="3" style="v" sid="2KI 9:3" />Bir tọka ana p'ogberenwa nwo abyeng-ẹ ny'eso, aben bẹ́, ‘Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi obenẹ bẹ́: Kaam nsọ-ọ ẹvaar ch'Israẹl.’ Íkk'asa minna, gwunga ọmma, arọbh; ogbe kakibhẹ!”<verse eid="2KI 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 9:4" />Minna kw'odikkobhnwa nwo kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, obin ozeng z'Ramọt-Gilead. <verse eid="2KI 9:4" /><verse number="5" style="v" sid="2KI 9:5" />Opyirẹ za o, oze adidennọng mbo p'agbongnọng ch'maning ẹwọr k'ibyi majanẹ. Oben oso kwabẹ bẹ bẹ́, “Nyen ẹkkaabha ch'm'nnang-ọ.”</para>
  <para style="p" vid="2KI 9:5">Jehu ọbọbh bẹ́, “Anyi wọ oyen ẹkkaabha oyenẹ ndo ma?”</para>
  <para style="p" vid="2KI 9:5">Kẹ ọpọhna bẹ́, “Kọ oso kw'agbongnọng e.”<verse eid="2KI 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 9:6" />Jehu obina odim z'ọsọhm. Minna kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo obyeng Jehu ana mbo ny'eso, oben bẹ́, “Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl obenẹ bẹ́, ‘Kaam nnyaan-ọ bẹ́, ade ọvaarnọng kw'Israẹl, p'ade anọng p'Ọvaar Ibinọkpaabyi. <verse eid="2KI 9:6" /><verse number="7" style="v" sid="2KI 9:7" />Kọ m'adimẹ ẹsọhmmọr ch'Ahab kw'ode atte kw'otim-ọ otima. Kaam m'ntuka obo kw'atọhmnọng paam, p'ade agbaak-ettem ch'Ibinọkpaabyi. M'mbir ntuka obo kw'atọhmnọng maphyir p'Ọvaar Ibinọkpaabyi p'Jẹzẹbẹl, ọfhọ. <verse eid="2KI 9:7" /><verse number="8" style="v" sid="2KI 9:8" />Ẹsọhmmọr ch'Ahab kibungọ, m'edimẹ. Kaam m'mfhọ maa, mpyirẹ k'okpongannam kw'ẹsọhmmọr ch'Ahab ny'Israẹl, zaa ode obira, wanẹma, ọmmaana. <verse eid="2KI 9:8" /><verse number="9" style="v" sid="2KI 9:9" />Kaam m'nsi ẹsọhmmọr ch'Ahab ede mach'ẹsọhmmọr ch'Jeroboam kw'ode nnwa kw'Nẹbat, mbir nsi chẹ ede mach'ẹsọhmmọr ch'Baasha kw'ode nnwa kw'Ahija. <verse eid="2KI 9:9" /><verse number="10" style="v" sid="2KI 9:10" />Ṉ́nòde Jẹzẹbẹl, mffa jọ m'ichẹ-ẹ k'agboka z'izek s'Jẹzrẹl. Ọnọng- gbọm mòninga kw'im'ọnọhng-ẹ.’ ” Nya o, ọgbaak-ettem ch'Ibinọkpaabyi nwo, ogwung ọmma, ọrọbh ofona.<verse eid="2KI 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 9:11" />K'ogbe kw'Jehu obin okebha ayok agbongnọng za, oyok wanẹ ọbọbh-ẹ bẹ́, “Mba idik maphyir ide mbengana ma o? Odingidingẹ nwa okwu oror-ọ k'ambọng-o?”</para>
  <para style="p" vid="2KI 9:11">Jehu ọpọhna bẹ́, “Kọ azong ojinọng oyenẹ ma, ọmaana abena pẹ.”<verse eid="2KI 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 9:12" />Bẹ maben bẹ́, “Minna kode! Gbaak mina.”</para>
  <para style="p" vid="2KI 9:12">Nya o, Jehu oben bẹ́, “Odik kw'otek-m ode bẹ́, ‘Ọvaar Ibinọkpaabyi obenẹ bẹ́, kaam nsọ-ọ ọvaarnọng kw'Israẹl.’ ”<verse eid="2KI 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 9:13" />Minna kw'masẹr-ọsẹr atọka anọhma-baba pabẹ, majẹ ny'abhukakpa bẹ́, ọbarẹ. Pira maje enyisa, mabir akwọhrọ k'ẹrọng bẹ́, “Jehu ode ọvaarnọng!”<verse eid="2KI 9:13" /></para>
  <para style="s1">Jehu ọfhọ Joram ọmaana Ahaziya</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 9:14" />Wa Jehu kw'ode nnwa kw'Jehoshaphat kw'ode nnwa kw'Nimshi, ochi Joram ikwu. (M'ogbe nwa, wa Joram kk'anọng p'Israẹl maphyir otima ọd-ọkaam Ramọt-Gilead k'mbọhk s'ọvaar Hazayẹl kw'Aram. <verse eid="2KI 9:14" /><verse number="15" style="v" sid="2KI 9:15" />Okenaka, wa ọvaar Joram kk'nnam ọkpa z'Jẹzrẹl bẹ́, oninga nya, ogbobhọ abhaak p'ekpo py'anọng p'Aram nkk'ẹ amuma z'egbong ch'orim ọmaana ọvaar Hazayẹl kw'Aram.) Jehu oben bẹ́, “Ó̱de ọ́daak bọnga bẹ́, masi-m ọvaarnọng, tte ọnọng mawan-wanẹ oning osi <char style="it">bẹ́ myiọr</char>, obina m'ebhondim, ọd-ọgbaak odik nwa z'Jẹzrẹl.” <verse eid="2KI 9:15" /><verse number="16" style="v" sid="2KI 9:16" />Minna kw'obin oyika k'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr, ọyaar ozeng z'ẹkọma ch'Jẹzrẹl, okurọ bẹ́, wa Joram oning za okwoka ọwọhng, ọmaana bẹ́, ọvaar Ahaziya kw'Juda, kk'ochina za bẹ́, ọd-ọzẹ-ẹ.<verse eid="2KI 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 9:17" />K'ogbe kw'okker-obhon obe z'ẹrọng kw'ọttangara kw'Jẹzrẹl, oze ẹkaan ch'agbongnọng p'Jehu ch'ed-ekwu z'eden, obok ẹmọng oben bẹ́, “Nze ẹkaan ch'agbongnọng banẹ ch'ekwuma z'eden.”</para>
  <para style="p" vid="2KI 9:17">Joram o, oke ẹfa bẹ́, “Màyerẹ ọyaar-ẹnyanya, màtọhm-ẹ bẹ́, okebha bẹ za, ọbọbh bẹ bẹ́, ‘Ma, makwu k'ọdaam o?’ ”<verse eid="2KI 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 9:18" />Ọyaar-ẹnyanya nwo ọyaar okebha Jehu, oben-ẹ bẹ́, “Ọvaarnọng obenẹ bẹ́, nkwu mbọbh-ọ bẹ́, ‘Ma, makwu k'ọdaam o?’ ” Jehu ọpọhn-ẹ bẹ́, “Kọ matima ọdaam asi mbọng o?” “Tera yak-m nnam ma e.”</para>
  <para style="p" vid="2KI 9:18">Okker-obhon otek ọvaarnọng bẹ́, “Ozeng-eden kk'opyira za ch'maning e, okenaka, ọdọk nnam mọkpa e.”<verse eid="2KI 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 9:19" />Ofona nya o, ọvaarnọng ọtọhm ọyaar-ẹnyanya ttonga afa. Opyirẹ za, ọbọbh bẹ bẹ́, “Ọvaarnọng obenẹ bẹ́, nkwu mbọbh-ọ bẹ́, ‘Ma, makwu k'ọdaam o?’ ” Jehu ọpọhn-ẹ bẹ́, “Kọ matima ọdaam asi mbọng o? Tera yak-m nnam e.”<verse eid="2KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 9:20" />Okker-obhon nwo otek ọvaarnọng bẹ́, “Ozeng-eden kk'opyira za ch'maning e. Okenaka, kẹ ọdọk nnam mobir ọkpa e. Ọyaara nwo okkerẹ kw'Jehu, kw'ode nnwa kw'Nimshi. Kẹ ọd-ọyaar mach'odingidingẹ e.”<verse eid="2KI 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 9:21" />Minna kw'Joram oke ẹfa, oben bẹ́, “Màdo ọkpaar nwo kwaam kw'ẹnyanya ẹd-ẹtọr k'ose kw'm'ntima.” Macher nya o, ọvaar Joram kw'Israẹl, ọmaana ọvaar Ahaziya kw'Juda mabina, ọnọng-ọnọng ọyaar k'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr bẹ́, makebha Jehu za. Mad-akebh-ẹ z'izek s'iwa ide s'Nabọt kw'ofon Jẹzrẹl. <verse eid="2KI 9:21" /><verse number="22" style="v" sid="2KI 9:22" />Joram oze Jehu nya o, ọbọbh bẹ́, “Jehu, ma akwu k'ọdaam o?”</para>
  <para style="p" vid="2KI 9:22">Jehu ọpọhn-ẹ bẹ́, “Ọdaam m'osi yen oninga, ch'aka maphyir okpukpobha, ọmaana ọtaan f'Jẹzẹbẹl kw'ode akka vọ obirẹ?”<verse eid="2KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 9:23" />Minna kw'Joram ọbhakẹ nnam ọrọbh, od-owon Ahaziya bẹ́, “Ahaziya, rọbh o! Ẹbọhra dọ e!”<verse eid="2KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 9:24" />Nya o, Jehu ọtọr oyuk kwẹ, ọtta Joram ny'ottem kw'amaangọ. Oyuk nwo ọnwẹ-ẹ maa, opyir-ẹ z'ettem. Minna kw'ọrẹr-ẹ, otto ny'ẹtaanga kw'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr. <verse eid="2KI 9:24" /><verse number="25" style="v" sid="2KI 9:25" />Jehu oben Bidka kw'od-okkerẹ ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr bẹ́, “Tin-ẹ bharẹ z'owonọ nwo kw'uwa Nabọt kw'ofon Jẹzrẹl oyen. Jima ose kw'uwa kọ ọttara kaam mọd-ọtọn ọyaar k'ijaar s'nnyanya id-itọr, mọyakẹ Ahab kw'ode otte, nnam. Nya kw'Ọvaar Ibinọkpaabyi ọgbaakẹ itama nja ọmaan-ẹ bẹ́, <verse eid="2KI 9:25" /><verse number="26" style="v" sid="2KI 9:26" />‘Chena, kaam Ọvaar Ibinọkpaabyi nze izẹ s'Nabọt ọmaana izẹ s'ajinọngva pẹ. K'odik ọkkọkka, etuna kede bẹ́, kaam m'nsọ-ọ atuk ọzẹ mvo m'izek njoma. Kaam Ọvaar Ibinọkpaabyi wọ mgbaakẹ.’ Ofona nya, tin-ẹ bharẹ z'izek njo, k'ose kw'ọgbaakadik kw'Ọvaar Ibinọkpaabyi obenẹ.”<verse eid="2KI 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 9:27" />K'ogbe kw'Ọvaar Ahaziya kw'Juda oze odik kw'ikk'oyina, ọrọbh ochorọ eden ch'ezengẹ z'Bẹt-Haggan. Jehu okwubh-ẹ, od-obok z'ẹmma bẹ́, “Màbir fhọ kẹ!” Minna kw'mamum-ẹ ekpo ny'ẹtaanga kw'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr, nya ch'ọd-ọrọbh ny'eden bẹ́, ochina z'Gur kw'ọnyọm Ibleam. Okenaka, ọrọbh ọnaanga, ozeng z'Megiddo, oninga za ope. <verse eid="2KI 9:27" /><verse number="28" style="v" sid="2KI 9:28" />Atọhmnọng pẹ, matọka affura pẹ k'ọkpaar kw'ẹnyanya ẹd-ẹtọr, matim-ẹ akwuna z'Jẹrusalẹm. Wa manọhng-ẹ z'epekwuk chẹ, z'ebhondim ch'Devid, otor ab'ttatta pẹ za. <verse eid="2KI 9:28" /><verse number="29" style="v" sid="2KI 9:29" />(K'icho ttong ijobh kawanẹ s'Joram kw'ode nnwa kw'Ahab ọbaabh, nya kw'Ahaziya okwu otima ẹvaar ch'Juda.)<verse eid="2KI 9:29" /></para>
  <para style="s1">Mafhọ Jẹzẹbẹl</para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 9:30" />Nya o, Jehu ochina z'Jẹzrẹl. K'ogbe kw'Jẹzẹbẹl ọbhaang odik nwo, obina od-osi abakpachen, obir otobha isisa sẹ. Obina, od-obe z'ọmma kw'ofum, okkerẹ z'iyaan. <verse eid="2KI 9:30" /><verse number="31" style="v" sid="2KI 9:31" />K'ose kw'Jehu odimẹ ny'ebhumma, Jẹzẹbẹl ọbọbh bẹ́, “Ma, akwu k'ọdaam o, kọ kw'akerẹ Zimri,<note caller="+" style="f"><char style="fr" closed="false">9.31 </char><char style="fq" closed="false">Zimri </char><char style="ft" closed="false">wa ode ogbongsonọng kw'ozeng ẹvaar abẹ, ọfhọ Elah. Yerẹ Ochedennwẹr kw'Avaarnọng 16:8-20</char></note> kw'azeng mmo afhọ atte kw'arukọ ábẹ̀?”<verse eid="2KI 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 9:32" />Jehu otinẹ ichen, okkerẹ z'ọmma nwo kw'ofum. Obok ẹmọng bẹ́, “Anyi wọ obe k'ikaam o? Anyi wọ?” Ajinọng afa, nnosi, ajinọng attaan p'mabhaar-ọbhaar, maninga z'ọmma nwo kw'ofum, marọn-ẹ z'izek. <verse eid="2KI 9:32" /><verse number="33" style="v" sid="2KI 9:33" />Jehu oben bẹ́, “Manyun-ẹ bharẹ z'izek” Minna kw'manyunọ Jẹzẹbẹl abharẹ z'izek. Izẹ janẹ sẹ, ipyakẹ z'etumọ, ọttara z'nnyanya sẹ. Nnyanya njo, ikebh-ẹ ny'izek, ibar-ẹ ntọkọ.<verse eid="2KI 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 9:34" />Minna kw'Jehu odimẹ z'ẹtaanga, oninga za ochi, obir ogwo, oben bẹ́, “Màtinẹ kwanọng nwo kw'nkk'ẹ ẹmma ananga, zọhng nọhnga, kirẹ wa kẹ ode ominanwa kw'ọvaarnọng.” <verse eid="2KI 9:34" /><verse number="35" style="v" sid="2KI 9:35" />Okenaka, k'ogbe kw'nnabenẹ bẹ́, mad-anọhng-ẹ, m'ọdọk ọttọhk kpenamkpen kaze, kw'ọkpanẹ osokpakpa kwẹ, ọmaana mmokpattọkọ, ọttara mbọhk jẹ-jẹ. <verse eid="2KI 9:35" /><verse number="36" style="v" sid="2KI 9:36" />Nya o, makpa nnam, mad-atek Jehu kw'obenẹ bẹ bẹ́, “Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi otim ọtọhmnọng kwẹ kw'ode Elijah kw'ofon Tishbẹ ọgbaak bẹ́: Ny'izek njo s'ining z'Jẹzrẹl, nya wọ kw'mffa m'ininga, ichi aten-yaara p'Jẹzẹbẹl. <verse eid="2KI 9:36" /><verse number="37" style="v" sid="2KI 9:37" />Oforbukọ kw'Jẹzẹbẹl m'ode mach'ẹbọr ny'izek njo s'ining z'Jẹzrẹl, mfha kwuna ọnọng oning-oning kw'im'oben bẹ́, ‘Jẹzẹbẹl wọ ma.’ ”<verse eid="2KI 9:37" /></para>
  <chapter eid="2KI 9" />
  <chapter number="10" style="c" sid="2KI 10" />
  <para style="s1">Jehu ọfhọ ẹsọhmmọr ch'Ahab</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 10:1" />Wa Ahab oyen ajinọngva arọbh attaan okwuma ijobh p'aning z'Samariya. Jehu ọkkẹr nkkaabha ọtọhm ọnang z'Samariya bẹ́, manang asonọng p'Jẹzrẹl, ọmaana asogbọhkọnọng, ọttara anọng p'akkerẹ iva p'Ahab. Oben bẹ́, <verse eid="2KI 10:1" /><verse number="2" style="v" sid="2KI 10:2" />“Ajinọngva p'atte kw'marukọ ábẹ̀, maning ma amaana bọnga. Ijaar s'nnyanya id-itọr, ọmaana nnyanya ibir ininga imaana bọnga. Mabir aninga k'ebhondim ch'ede ifa-byi, ebir eyena egbongkpo. K'ose kw'ẹkkaabha nda epyipyirẹ bọnga nya, <verse eid="2KI 10:2" /><verse number="3" style="v" sid="2KI 10:3" />màchina ny'ajinọngva p'atte kw'marukọ ábẹ̀, màteka ọnọng kw'ojibhẹ ọyọhnga ayok, ọmaana oyok kw'ọbaan-ọbaana, kw'im'ọnana k'ẹvaarkkọhbhọ ch'otte kw'orukọ ábẹ̀. Ṉ́kk'asa minna, màsi erima ch'atte kw'abọnga k'ọsọhm.”<verse eid="2KI 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 10:4" />Okenaka, wa ojora okwu odim bẹ, maben bẹ́, “Ó̱de avaarnọng afa nna kẹ ábẹ̀ akpo, mina bọ mm'okpo o?”<verse eid="2KI 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 10:5" />Ofona nya o, okker-idik-s'odimpa, ọmaana ọbaabh-ebhondim, ọmaana asogbọhkọnọng, ọttara abaabh-isọhmmọr, matọhm ẹkkaabha nda anang Jehu bẹ́, “Mina mode atọhmnọng pọ e. Mm'osi ọttọhk kpenamkpen f'abenẹ. Mina m'ọnọng kpenamkpen ẹvaar mosi. Kọ zeng mmo si ọttọhk kpenamkpen f'achibhẹ bẹ́, ode ọkkọkka.”<verse eid="2KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 10:6" />Minna kw'Jehu ọkkẹrẹ ẹkkaabha ttonga mfa, ọnang bẹ, oben bẹ́, “Ó̱de bọnga mabe k'kaam, mabira achera bẹ́, mm'akpobha-m, màpe ajinọngva p'arukọ atte kwabọnga ábẹ̀, nso, màtọka jẹ, achen-m ophyinẹ ogbese nwa, z'Jẹzrẹl.”</para>
  <para style="p" vid="2KI 10:6">M'ogbe nwa, wa ajinọngva p'ọvaarnọng obhonọ anọng nso arọbh attaan okwuma ijobh, maning amaana ajinọng p'abarẹ odik ny'ebhondim ndo, p'uwa ad-akkerẹ bẹ. <verse eid="2KI 10:6" /><verse number="7" style="v" sid="2KI 10:7" />K'ogbe kw'ẹkkaabha ndo epyirẹ bẹ, ajinọng mbo p'abarẹ odik, matọka iva mbo anọng arọbh attaan okwuma ijobh p'ọvaarnọng obhonọ, mape bẹ nso maphyir. Matọka nso njo ake k'ọkariba, matọhm anang Jehu z'Jẹzrẹl. <verse eid="2KI 10:7" /><verse number="8" style="v" sid="2KI 10:8" />K'ogbe kw'ozeng-eden nwo opyirẹ nya, otek Jehu bẹ́, “Nkk'nso s'ajinọngva mbo p'ọvaarnọng obhonọ atima akwa e.”</para>
  <para style="p" vid="2KI 10:8">Jehu oke ẹfa bẹ́, “Màsok jẹ k'akkin afa z'eden ch'mad-azenga adim z'ebhumma ch'ebhondim maa, opyirẹ ophyinẹ k'ekpebha.”<verse eid="2KI 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 10:9" />Ewu esobh nya o, Jehu oyin k'iyaan. Okwu obe anọng mbo maphyir ny'ititika, oben bẹ bẹ́, “Mbọhk sabọnga m'odik nwa kide. Kaam oyenẹ wọ nchi atte kwaam kw'nrukọ ábẹ̀, ikwu, mfhẹ-ẹ. Okenaka, anyi wọ nnọfhọ anọng mba maphyir? <verse eid="2KI 10:9" /><verse number="10" style="v" sid="2KI 10:10" />Màzonga nya bẹ́, odik kode kw'Ọvaar Ibinọkpaabyi ikk'ọgbaaka ọmaana ọsọhm kw'Ahab kw'im'otun-otuna. Ọvaar Ibinọkpaabyi kk'ọttọhk ọsa f'uwa otim Elijah kw'ode ọtọhmnọng kwẹ, ọgbaak.” <verse eid="2KI 10:10" /><verse number="11" style="v" sid="2KI 10:11" />Minna kw'Jehu ozeng ọfhọ ọnọng kpenamkpen kw'orikẹ ny'ọsọhm kw'Ahab ny'Jẹzrẹl. Obir ọfhọ ajinọng p'Ahab p'abarẹ odik, ọmaana ayok-echekẹ pẹ, ọmaana afọhn-nja pẹ. Ọnọng mawanẹ kode kw'uwa otte ọbọhk bẹ́, oninga akpen ny'ọsọhm kw'Ahab.<verse eid="2KI 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 10:12" />Minna kw'Jehu obin ochina z'ẹkọma ch'Samariya, z'ẹbhaakẹ ch'Bẹt-Eked, kw'ode ibyi s'akker-arọkimaan. <verse eid="2KI 10:12" /><verse number="13" style="v" sid="2KI 10:13" />Okebha ivọkka banẹ p'ọvaar Ahaziya kw'Juda nya. Ọbọbh bẹ bẹ́, “Bọnga made bọnga anọng o?”</para>
  <para style="p" vid="2KI 10:13">Mapọhn-ẹ bẹ́, “Mina mode anọng p'Ahaziya, p'makwu azima isọhmmọr s'ọvaarnọng, ọttara s'ọvaarkwanọng.”<verse eid="2KI 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 10:14" />Jehu oke ẹfa bẹ́, “Màbọka bẹ k'mbọhk!” Minna kw'mabọk bẹ anọng nso arọbh afa okwuma afa k'mbọhk, mad-abhirẹ bẹ ndọngọ z'esipe ch'Bẹt-Eked. Ọnọng mawanẹ kw'osokọ akpen, kode.<verse eid="2KI 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 10:15" />Obin nya, okebha Jehonadab kw'ode nnwa kw'Rekab z'eden ch'oben bẹ́, okwu ọzẹ-ẹ. Jehu ozim-ẹ, oben bẹ́, “Ma, kọ abe k'kaam o, k'ose kw'kaam mbe k'kọ o?”</para>
  <para style="p" vid="2KI 10:15">Jehonadab ọpọhna bẹ́, “Iye.”</para>
  <para style="p" vid="2KI 10:15">Jehu oben bẹ́, “Ó̱de ode minna, nang-m ọbọhk kwọ.” Jehonadab osi minna. Jehu ọkkaan-ẹ, oyik-ẹ z'ọkpaar kw'ẹnyanya ẹd-ẹtọr. <verse eid="2KI 10:15" /><verse number="16" style="v" sid="2KI 10:16" />Jehu oben-ẹ bẹ́, “Yak-m nnam, akwu aze ose kw'ncher obo k'Ọvaar Ibinọkpaabyi.” Minna kw'matọnọ, mayika ny'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr.<verse eid="2KI 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 10:17" />Jehu opyirẹ z'Samariya o, ochera anọng maphyir p'arikẹ z'ẹsọhmmọr ch'Ahab, ọfhọ. Odimẹ bẹ eche, otor k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi otim Elijah, ọgbaak.<verse eid="2KI 10:17" /></para>
  <para style="s1">Mafhọ atọhmnọng p'Baal</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 10:18" />Minna kw'Jehu oyerẹ anọng mbo maphyir k'ibyi majanẹ, oben bẹ bẹ́, “Wa Ahab okpobh Baal <char style="it">bẹ́ kẹrẹm</char>, kaam Jehu m'mkpobh-ẹ mawuriji. <verse eid="2KI 10:18" /><verse number="19" style="v" sid="2KI 10:19" />Màyerẹ agbaak-ettem ch'Baal maphyir, mattonga, ọmaana atọhmnọng pẹ maphyir, ọttara afọhn-ẹja pẹ maphyir. Tte ọnọng mawan-wanẹ oning oworọ ny'ikpakaana njo o, okurọ bẹ́, kaam m'nkwu mfọhnọ ẹja chiden nnang Baal. Ọnọng kpenamkpen kw'obhumọ eyerẹ ndo, ọdọk akpen mòruk.” Okenaka, wa Jehu ọd-ọbọhra bẹ ọbọhra, ọfha otima eden ndo, ọfhọ atọhmnọng p'Baal.<verse eid="2KI 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 10:20" />Jehu oben bẹ́, “Màyerẹ ikpakaana ittonga okurọ Baal.” Minna kw'mayerẹ ikpakaana njo. <verse eid="2KI 10:20" /><verse number="21" style="v" sid="2KI 10:21" />Jehu ọtọhm ẹkkaabha ọkọma Israẹl. Atọhmnọng p'Baal maphyir, makwu. Ọtọhmnọng mawanẹ kode kw'ina nya, okwu. Masaabh maa, ọsọhm kw'Baal ofu, tọma k'eso danẹ, pyirẹ z'eso ndoza. <verse eid="2KI 10:21" /><verse number="22" style="v" sid="2KI 10:22" />Nya o, Jehu oben ọnọng kw'od-oye nnya bẹ́, “Tọka anọhma-baba chena atọhmnọng maphyir p'Baal.” Minna kw'ọtọk anọhma-baba mbo ochena bẹ.<verse eid="2KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 10:23" />Minna kw'Jehu ọttara Jehonadab kw'ode nnwa kw'Rekab mabin adim ny'ọsọhm nwo kw'Baal. Jehu oben atọhmnọng p'Baal bẹ́, “Bọnga maphyir màkkerẹ mawuriji, màze bẹ́, ọtọhmnọng mawanẹ kw'Ọvaar Ibinọkpaabyi, ma kode, kirẹ etobha nda ede ch'atọhmnọng p'Baal dẹ-dẹ.” <verse eid="2KI 10:23" /><verse number="24" style="v" sid="2KI 10:24" />Minna kw'madimẹ z'ẹtaanga, bẹ́, mad-afọhnọ nja, mabir anang nnanga s'ẹkwọmọ. Ode ch'Jehu kk'anọng arọbh anna osoka z'iyaan. Ọtọr anọng mbo itọhng bẹ́, “Ó̱de ọ́nọng wanẹ m'abọnga k'ẹkaan, okenka otte ọnọng mawanẹ m'anọng mba p'nke bọnga k'mbọhk, ọnaang-ẹ ọrọbh, kẹ m'otima akpen pẹ, otera eso ch'ọnọng kw'ọnaang-ẹ, ọrọbh.”<verse eid="2KI 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 10:25" />Jehu ochichera ẹja ch'nnanga s'ẹkwọmọ nya, oben anọng mbo p'akkerẹ ibyi, ọmaana asonọng pẹ bẹ́, “Màdim z'ẹtaanga, màfhọ bẹ za. Tte ọnọng mawan-wanẹ, oning bọnga ọnang o.” Minna kw'matim akkangkkang afhọ bẹ. Akker-byi mbo, ọttara asonọng p'Jehu, matọr aforbukọ mbo abharẹ k'iyaan, pira nnadimẹ z'ọsọhm kw'Baal ẹtaanga. <verse eid="2KI 10:25" /><verse number="26" style="v" sid="2KI 10:26" />Matinẹ ọta nwo kw'ọbar-odik ny'ọsọhm ẹtaanga kw'Baal, matima ayin k'iyaan, makwọmọ wẹ. <verse eid="2KI 10:26" /><verse number="27" style="v" sid="2KI 10:27" />Mavọhkọ ẹta ndo ch'Baal ch'ẹbar-odik, mabira achikẹ ọsọhm kwẹ. Anọng natim ibyi njo asi ọgbana maa, pyirẹ menda.<verse eid="2KI 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 10:28" />Minna kw'uwa Jehu ọkpọk ekpobha ch'Baal ny'Israẹl. <verse eid="2KI 10:28" /><verse number="29" style="v" sid="2KI 10:29" />Okenaka, wa kẹ ochin ororo k'mpyibha njo s'Jẹroboam kw'ode nnwa kw'Nẹbat ikk'ọwọhka anọng p'Israẹl asi. Wa mpyibha njo ide ekpobha ch'mad-akpobha akpata p'abhaamva p'matim gol asi, masok z'Bẹtẹl, ọmaana z'Dan.<verse eid="2KI 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 10:30" />Ọvaar Ibinọkpaabyi oben Jehu bẹ́, “Ch'ikk'ọttọhk f'otor-otor asa mawuriji k'kaam k'ititika, abir asi okpenamkpen f'ntọhm-ọ ny'ẹsọhmmọr ch'Ahab k'ose kw'nchibhẹ k'ettem chaam, iva p'iva pọ, m'atima ẹvaar ch'Israẹl maa, opyirẹ ipemaanitor nna.” <verse eid="2KI 10:30" /><verse number="31" style="v" sid="2KI 10:31" />Chibhẹ nya, wa Jehu ifor kodo bẹ́, okpobha apaanga p'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl. Wa kẹ ochin ororo k'mpyibha s'Jẹroboam, s'iwa ikk'ọwọhka anọng p'Israẹl, asi.<verse eid="2KI 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 10:32" />Ny'ogbe nwo, Ọvaar Ibinọkpaabyi ọtọma ọsaabh f'Israẹl oyiyekẹ. Hazayẹl okema nkọma s'anọng p'Israẹl maphyir s'ining <verse eid="2KI 10:32" /><verse number="33" style="v" sid="2KI 10:33" />z'okwubha kw'ewuchen ed-eyin, z'ẹbhaakẹ ch'Jọrdan maphyir, ọmaana z'ẹkọma ch'Gilead (kw'ode ẹkọma ch'Gad, ọmaana ch'Reubẹn, ọttara ch'Manasẹ). Bir tọma z'Aroer kw'ọnyọm iwọn-isaka s'Amọn maa, pyirẹ z'Gilead, ọttara z'Bashan.<verse eid="2KI 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 10:34" />Ṉ́nòde idik njoza s'iyinẹ k'ogbe kw'Jehu ọbaabh, ọmaana idik s'osi maphyir, ọttara ekpo py'oyen maphyir, makkẹrẹ z'anwẹr p'avaar p'Israẹl.<verse eid="2KI 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 10:35" />Wa Jehu o, okwu ope, otor ab'ttatta pẹ. Manọhng-ẹ z'Samariya. Jehoahaz kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ. <verse eid="2KI 10:35" /><verse number="36" style="v" sid="2KI 10:36" />Wa Jehu oning z'Samariya ọbaabha Israẹl k'icho ẹrọbh okwuma ochenọnttaan.<verse eid="2KI 10:36" /></para>
  <chapter eid="2KI 10" />
  <chapter number="11" style="c" sid="2KI 11" />
  <para style="s1">Ataliya ọmaana Joash</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 11:1" />K'ogbe kw'Ataliya kw'ode ọkka kw'Ahaziya oze bẹ́, nnwa kwẹ kk'ọpa, ọtọma anọng p'ivaartaak njo kibungọ, ofhufhọ. <verse eid="2KI 11:1" /><verse number="2" style="v" sid="2KI 11:2" />Okenaka, Jehosheba kw'ode ominanwa kw'ọvaar Jehoram, obir ode ọgbaanọkka kw'Ahaziya, ọtọka Joash kw'ode ojinọngnwa kw'Ahaziya m'orubh-orubh ny'ẹkaan ch'ajinọngva p'ọvaarnọng p'makamẹ bẹ́, mafhọ, otima ọrọbh. Ọtọka kẹ ọmaana orirọka kwẹ od-odubh k'idongọ janẹ, ọfha Ataliya oning-ẹ oze. Minna kw'uwa Joash ozeng ọnaanga obo nwo. <verse eid="2KI 11:2" /><verse number="3" style="v" sid="2KI 11:3" />Kẹ ọmaana orirọka kwẹ, matubha ny'ọsọhm kw'Ọvaar Ibinọkpaabyi k'icho ichadanẹ s'Ataliya ọbaabh ẹkọma ndo.<verse eid="2KI 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 11:4" />Ttong icho ichenọmfa, Jehoyada ọtọhm ẹkkaabha bẹ́, mayerẹ aso p'agbongnọng p'nkwurọ s'anọng arọbh achen p'mafon Karit, ọttara ayok pad-akkerẹ ibyi. Bẹ mbo p'oyerẹ, makwu akebh-ẹ z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. Kẹ ọmaana bẹ manwọhngọ anang ayok, obir osi bẹ machekẹ ny'Ọsọhm kw'Ọvaar Ibinọkpaabyi. Pira nọkọhk bẹ nnwa kw'ọvaarnọng. <verse eid="2KI 11:4" /><verse number="5" style="v" sid="2KI 11:5" />Oben bẹ bẹ́, “Ọttọhk f'mm'asi ode bẹ́, bọnga mbo p'maning k'nkwurọ nttaan s'id-isi ọtọhm k'Ẹwọhngkwokawu, ekwurọ danẹ ekkerẹ ọvaardimpa, <verse eid="2KI 11:5" /><verse number="6" style="v" sid="2KI 11:6" />danẹ ekkerẹ ebhumma ch'Sur, danẹ ekkerẹ ebhumma ch'ening z'nnam-nnam kw'akker-ibyi mbo p'mad-akkerẹ ibyi arik ayok ny'ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 11:6" /><verse number="7" style="v" sid="2KI 11:7" />Bọnga mbo maphyir p'nkwurọ njoza mfa s'id-ikwoka ọwọhng k'Ẹwọhngkwokawu, bọnga bọ mm'ad-akkerẹ Ọsọhm kw'Ọvaar Ibinọkpaabyi anang ọvaarnọng. <verse eid="2KI 11:7" /><verse number="8" style="v" sid="2KI 11:8" />Màbe kọbha ọvaarnọng ọkọbha. Ọnọng-ọnọng ọkwọrọ ogbongttọhk k'ọbọhk. Ọnọng kpenamkpen kw'ọnyọm bọnga, màfhẹ-ẹ. Màninga tuma ọvaarnọng k'ibyi kpenamkpen s'ọta.”<verse eid="2KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 11:9" />Minna kw'aso p'agbongnọng nkwurọ s'anọng arọbh achen, masi mbengana k'ose kw'Jehoyada kw'ode ọfọhn-ẹja obenẹ. Ọnọng-ọnọng otima agbongnọng pẹ p'mad-asi ọtọhm k'Ẹwọhngkwokawu, ọttara ayok p'mad-akwoka ọwọhng k'Ẹwọhngkwokawu, makwu akebha Jehoyada kw'ode ọfọhn-ẹja. <verse eid="2KI 11:9" /><verse number="10" style="v" sid="2KI 11:10" />Jehoyada ọnang aso p'agbongnọng mbo akọhn, ọttara agbongtergba mbo p'uwa made p'ọvaar Devid, p'uwa masokọ z'ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 11:10" /><verse number="11" style="v" sid="2KI 11:11" />Akker-ibyi mbo mabe akọbha ọvaarnọng. Ọnọng-ọnọng otima ogbongttọhk fẹ k'ọbọhk, obe ọnyọma ija-byi ọmaana Ọsọhm kw'Ọvaar Ibinọkpaabyi, tọma z'ẹwọn-ẹwọna maa, pyirẹ z'ebir-ebir kw'Ọsọhm nwo kw'Ọvaar Ibinọkpaabyi.<verse eid="2KI 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 11:12" />Jehoyada otima ojinọngnwa kw'ọvaarnọng oyin ka ọyaankpa, ọfọr-ẹ ivaarkpo. Ọnang-ẹ nnwẹr kw'asana p'ẹvaar, obir ọsẹ-ẹ ẹvaar. Minna kw'mayaan-ẹ, anọng abir akpan mbọhk, mawurọ amọng, maben bẹ́, “Tte ọvaarnọng oruk akpen p'adum-odum!”<verse eid="2KI 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 11:13" />K'ogbe kw'Ataliya ọbhaang ẹlọ ch'akker-ibyi, ọmaana ch'anọng mbo, obina ọta z'ọsọhm kw'Ọvaar Ibinọkpaabyi bẹ́, od-oze anọng p'ad-alọ ẹkọhr ndo. <verse eid="2KI 11:13" /><verse number="14" style="v" sid="2KI 11:14" />Opyirẹ za, oze ọvaarnọng ch'obe otuma ẹkpọmmachi, k'ose kw'ẹmmaana chabẹ ede. Asonọng, ọmaana anọng p'mad-aje nnyisa maninga ny'ẹbhaakẹ danẹ ch'ọvaarnọng. Wa anọng maphyir p'ẹkọma ndo mad-asi odidaama, mabir aje nnyisa. Minna kw'Ataliya ọyaakẹ ekpo py'ọfọr, obok bẹ́, “Okwurọdik e! Okwurọdik e!”<verse eid="2KI 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 11:15" />Jehoyada kw'ode ọfọhnọ-ẹja oben aso p'agbongnọng p'uwa akkerẹ esojakaan bẹ́, “Màtima kwanọng nwo yin k'iyaan m'ottem kw'akker-ibyi, matima ọkkangkkang afhọ ọnọng kpenamkpen kw'otor-ẹ k'odik.” Kirẹ ọfọhn-ẹja kk'obena bẹ́, “Kẹ kọbaan bẹ́, mafhẹ-ẹ k'Ọsọhm kw'Ọvaar Ibinọkpaabyi.” <verse eid="2KI 11:15" /><verse number="16" style="v" sid="2KI 11:16" />Minna kw'mabọk-ẹ, matim-ẹ apyirẹ z'ibyi s'nnyanya id-izenga idim z'ọvaarter. Nya kw'maning afhẹ-ẹ.<verse eid="2KI 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 11:17" />Nya o, Jehoyada kw'ode ọfọhn-ẹja, osi ọvaar Joash ọmaana anọng machekẹ ọmaana Ọvaar Ibinọkpaabyi bẹ́, bẹ mm'ade anọng p'Ọvaar Ibinọkpaabyi. Minna kw'obir osi ọvaarnọng ochekẹ ọmaana anọng mbo. <verse eid="2KI 11:17" /><verse number="18" style="v" sid="2KI 11:18" />Anọng p'izek njo maphyir mabina, mad-achikẹ ọsọhm kw'Baal abharẹ. Mavọhkọ ọja-byi, ọmaana akpata mbo <char style="it">ma matuku-tuku</char>. Mabir afhọ Mattan kw'ode ọfọhn-ẹja kw'Baal, ny'ititika s'ọja-byi mvo.</para>
  <para style="p" vid="2KI 11:18">Jehoyada kw'ode ọfọhn-ẹja, nọtọhm akker-byi bẹ́, mad-akkerẹ Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 11:18" /><verse number="19" style="v" sid="2KI 11:19" />Minna kw'aso p'agbongnọng p'abaabh nkwurọ s'anọng arọbh achen, ọmaana anọng p'afon Karit, ọmaana akker-ibyi, ọmaana anọng p'izek njo maphyir, mad-atọka ọvaarnọng z'ọsọhm kw'Ọvaar Ibinọkpaabyi, matim-ẹ azenga z'ebhumma ch'akker-ibyi madim z'odimpa. Ofona od-oninga z'ẹvaarkkọhbhọ chẹ. <verse eid="2KI 11:19" /><verse number="20" style="v" sid="2KI 11:20" />Wa anọng p'izek njo maphyir mayena ottemlebh. Ebhondim ndo maphyir ebir eyena ẹmẹm okurọ ch'nkk'ọkkangkkang atima afhọ Ataliya z'odimpa.<verse eid="2KI 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 11:21" />Wa Joash ode icho ichenọmfa k'atam, k'ogbe kw'masẹ-ẹ ẹvaar.<verse eid="2KI 11:21" /></para>
  <chapter eid="2KI 11" />
  <chapter number="12" style="c" sid="2KI 12" />
  <para style="s1">Joash odo Ọsọhm kw'Ọvaar Ibinọkpaabyi</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 12:1" />Ny'icho ttong ichenọmfa s'Jehu ọbaabh Israẹl, nya kw'masi Joash ẹvaar, oninga z'Jẹrusalẹm ọbaabha k'icho arọbh afa. Wa ọkka kwẹ okpen Zibiya, kw'ofon Beershẹba. <verse eid="2KI 12:1" /><verse number="2" style="v" sid="2KI 12:2" />Joash osi idik ọkkọkka z'Ọvaar Ibinọkpaabyi k'ititika ny'icho njo maphyir s'Jehoyada kw'ode ọfọhn-ẹja ọnang-ẹ ntọhna. <verse eid="2KI 12:2" /><verse number="3" style="v" sid="2KI 12:3" />Okenaka, wa aka p'ọyaankpa kọrọhbh. Anọng achina ororo mad-afọhnọ nja, mabira akwọmọ insẹns nya.<verse eid="2KI 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 12:4" />Joash oben afọhn-ẹja bẹ́, “Màtọka ikpuka njo s'nnanga s'iwur-owur maphyir s'anọng atim akwu z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana s'matọk k'ẹnọngbhika, ọmaana ikpuka s'anọng achekẹ bẹ́, mm'anang, ọttara njo s'ibin anọng z'ettem bẹ́, matima akwu z'Ọsọhm kw'Ibinọkpaabyi. <verse eid="2KI 12:4" /><verse number="5" style="v" sid="2KI 12:5" />Tte ọfọhn-ẹja kpenamkpen, ọtọka akpuka k'ọye-kpa wanẹ, p'mm'atima ado ọttọhk kpenamkpen f'maze bẹ́, okibh-okibhẹ ny'Ọsọhm kw'Ọvaar Ibinọkpaabyi.”<verse eid="2KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 12:6" />Okenaka, k'icho ẹrọbh okwuma ittaan s'ọvaar Joash ọbaabh, afọhnọ-ẹja mbo, m'Ọsọhm nwo kw'Ọvaar Ibinọkpaabyi kado. <verse eid="2KI 12:6" /><verse number="7" style="v" sid="2KI 12:7" />Ofona nya, ọvaar Joash oyerẹ Jehoyada kw'ode ọfọhn-ẹja, ọttara afọhn-ẹja mboza. Ọbọbh bẹ bẹ́, “Osempira m'ekpo mbyo py'ekibhẹ z'Ọsọhm kw'Ọvaar Ibinọkpaabyi kad-ado? M'ọdọk akpuka z'aye-kpa pabọnga, katọka. Nn'tte ọbọhk, matima ado Ọsọhm kw'Ọvaar Ibinọkpaabyi.” <verse eid="2KI 12:7" /><verse number="8" style="v" sid="2KI 12:8" />Nya o, afọhn-ẹja mbo achera bẹ́, bẹ m'ọdọk akpuka z'anọng mbo k'mbọhk matọka. Mabir aben bẹ́, bẹ azang mm'azeng mmo mado Ọsọhm kw'Ibinọkpaabyi.<verse eid="2KI 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 12:9" />Jehoyada kw'ode ọfọhnọ-ẹja, ọtọka ikwukwu janẹ odwu ọmma ny'ọkpa kwẹ. Ọtọka jẹ osok ẹbhaakẹ danẹ ch'odimbọhk kw'ija-byi, k'ose kw'im'adim z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. Afọhn-ẹja mbo p'akkerẹ ẹsọhmma ndo, make ikpuka njo maphyir s'anọng atim akwu, ny'ikwukwu njo, ny'Ọsọhm kw'Ọvaar Ibinọkpaabyi . <verse eid="2KI 12:9" /><verse number="10" style="v" sid="2KI 12:10" />Ogbe kpenamkpen kw'maze bẹ́, akpuka p'ayik ny'ikwukwu njo kk'asaabha, ọkkẹrẹ kw'avaar ọttara ọfọhn-ẹja kwiden, mm'akwu abhik akpuka mbo p'anọng nkk'atima akwa ny'Ọsọhm kw'Ọvaar Ibinọkpaabyi, pira nn'acha ake k'mkpa. <verse eid="2KI 12:10" /><verse number="11" style="v" sid="2KI 12:11" />K'ogbe kw'nkk'okpukabhik azonga, matọka anang anọng p'marọhbh bẹ́, makkerẹ ọtọhm f'Ọsọhm kw'Ibinọkpaabyi. Ikpuka njo jọ s'iwa mad-atima akpe anọng p'asi ọtọhm ny'Ọsọhm kw'Ibinọkpaabyi kw'ode agwọhr-agbaaka, ọmaana attim-isọhm, <verse eid="2KI 12:11" /><verse number="12" style="v" sid="2KI 12:12" />ọmaana ayik-isọhm, ọttara aphaak-ata. Madebh agbaaka, ọttara ata p'nkk'adoka, p'mm'atima ado Ọsọhm kw'Ọvaar Ibinọkpaabyi. Ikpuka njo jọ s'iwa mabir ad-atima asi idik zẹkẹ-zẹkẹ njoza maphyir s'imaan ẹda ch'Ọsọhm kw'Ọvaar Ibinọkpaabyi.<verse eid="2KI 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 12:13" />Wa m'akpuka p'matim akwu z'Ọsọhm kw'Ọvaar Ibinọkpaabyi katim asi agbobh-mbọhk p'silva, ọmaana ẹfangba, ọmaana agbobh-mbọhk p'asi ochichakẹ, ttara nnyisa, wanẹma, ekpo ọdọk-ọdọk py'Ọsọhm kw'Ọvaar Ibinọkpaabyi, py'matim gol, wanẹma, silva, asi. <verse eid="2KI 12:13" /><verse number="14" style="v" sid="2KI 12:14" />Wa mad-atọka akpuka mbo anang atọhmnọng. Bẹ mabir atima akpuka mbo mado Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 12:14" /><verse number="15" style="v" sid="2KI 12:15" />Wa m'anọng mbo p'manang akpuka kayerẹ bẹ́, matek bẹ ose kw'malukọ akpuka mbo k'atọhmnọng, okurọ bẹ́, wa ẹmmaana chabẹ etor-otor. <verse eid="2KI 12:15" /><verse number="16" style="v" sid="2KI 12:16" />Wa m'akpuka p'afon k'nnanga s'edik-tuka, ọmaana s'nnanga s'epyibha, kad-atima adim z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. Wa akpuka mbo made p'afọhn-ẹja.<verse eid="2KI 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 12:17" />M'ogbe nwa, ọvaar Hazayẹl kw'Aram obin od-orima obhon kw'Gat ábẹ̀, okema. Minna kw'ọbhakẹ nya, obir orima Jẹrusalẹm ábẹ̀. <verse eid="2KI 12:17" /><verse number="18" style="v" sid="2KI 12:18" />Okenaka, ọvaar Joash kw'Juda ọtọka ekpo py'ewur-owur maphyir, py'Jehoshaphat, ọmaana Jehoram, ọttara Ahaziya p'acheden abaabha Juda, matte ọbọhk anang Ibinọkpaabyi, ọmaana nnanga s'ikẹ oyenẹ ikk'ọbọhk ọtta, ọnang Ọvaar Ibinọkpaabyi, ọttara gol kw'oze z'nkwurukpa s'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana z'ọvaar-odimpa. Ọtọhm ekpo mbyo maphyir ọnang ọvaar Hazayẹl kw'Aram. Pira wa n'ọtọrọ nnam z'Jẹrusalẹm.<verse eid="2KI 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 12:19" />Idik njoza s'iyinẹ k'ogbe kw'Joash ọbaabh, ọttara idik s'osi maphyir, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 12:19" /><verse number="20" style="v" sid="2KI 12:20" />Wa atọhmnọng pẹ machẹ-ẹ ikwu, mafhẹ-ẹ z'Bẹt-Millo, z'eden ch'echin z'Silla. <verse eid="2KI 12:20" /><verse number="21" style="v" sid="2KI 12:21" />Atọhmnọng mbo p'uwa mafhẹ-ẹ made, Jozabad kw'ode nnwa kw'Shimẹyat, ọmaana Jehozabad kw'ode nnwa kw'Shomẹr. Wa Joash ope, manọhng-ẹ za ch'manọhng ab'ttatta pẹ, z'ebhondim ch'Devid. Amaziya kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 12:21" /></para>
  <chapter eid="2KI 12" />
  <chapter number="13" style="c" sid="2KI 13" />
  <para style="s1">Jehoahaz otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 13:1" />Ny'icho ttong ẹrọbh okwuma ittaan s'Joash kw'ode nnwa kw'Ahaziya otim ẹvaar ch'Juda, nya wọ kw'Jehoahaz kw'ode nnwa kw'Jehu oning z'Samariya ọbaabha Israẹl k'icho ichi kkamfa. <verse eid="2KI 13:1" /><verse number="2" style="v" sid="2KI 13:2" />Wa osi itama z'ititika s'Ọvaar Ibinọkpaabyi okurọ ch'osi mpyibhase njo s'Jẹroboam kw'ode nnwa kw'Nẹbat, osi, s'iwọhkọ anọng p'Israẹl mabir asi epyibha. Wa Jehoahaz nnam kobir ọtọr k'itama osisi. <verse eid="2KI 13:2" /><verse number="3" style="v" sid="2KI 13:3" />Minna kw'ettem epyibh Ọvaar Ibinọkpaabyi ẹmaana anọng p'Israẹl. Ofona nya, otte bẹ ọbọhk ọnang ọvaar Hazayẹl kw'Aram, ọmaana Bẹn-Hadad kw'ode nnwa kwẹ bẹ́, mabaabha bẹ.<verse eid="2KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 13:4" />Nya o, Jẹhoaz obhomọ ọkpẹkẹ Ọvaar Ibinọkpaabyi. Ọvaar Ibinọkpaabyi ọbhaang-ẹ, okurọ ch'oze irem s'ọvaarnọng kw'Aram ọyak ọbọhk ọnang anọng p'Israẹl. <verse eid="2KI 13:4" /><verse number="5" style="v" sid="2KI 13:5" />Nya o, Ọvaar Ibinọkpaabyi ọtọhm ọkkaan ọnang anọng p'Israẹl, osi bẹ manaanga k'mbọhk s'anọng p'Aram. Minna kw'anọng p'Israẹl mabir akwu aruk k'ibhon sabẹ, k'ose kw'uwa makkikken aruk. <verse eid="2KI 13:5" /><verse number="6" style="v" sid="2KI 13:6" />Okenaka, m'nnam katọrọ k'mpyibha s'ọsọhm kw'Jẹroboam osi, s'iwọhkọ anọng p'Israẹl asi epyibha. Machina ororo asi mpyibha njo. Wa mabir atte ẹka-chi ch'Ashera ọbọhk, ebe ny'Samariya.<verse eid="2KI 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 13:7" />Wa ogbongnọng mawan-wanẹ kw'Jẹhoaz korikẹ, kw'ọkpanẹ anọng arọbh afa okwuma ijobh p'ad-ayaar nnyanya, ọmaana ijaar ijobh s'nnyanya id-itọr, ọttara asoja nnọhna ẹrọbh okwuma nnọhna nchen p'izek. Ode ch'iwa ọvaarnọng kw'Aram ikk'ayok mboza ọfhakpo, osi bẹ maker ebonọ ch'ogbe kw'nd-agwuma abarli.<verse eid="2KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 13:8" />Idik njoza s'uwa iyinẹ k'ogbe kw'Jẹhoahaz ọbaabh, ọmaana idik mapyhir s'osi, ọttara mgbong s'okem, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="2KI 13:8" /><verse number="9" style="v" sid="2KI 13:9" />Wa Jehoahaz ope otor ab'otte, manọhng-ẹ z'Samariya. Jehoash kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ<verse eid="2KI 13:9" /></para>
  <para style="s1">Jehoash otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 13:10" />Ny'icho ttong ẹrọbh okwuma ichi kkamfa s'ọvaar Joash ọbaabh Juda, nya wọ kw'Jehoash kw'ode nnwa kw'Jehoahaz oning z'Samariya ọbaabha Israẹl k'icho ichi kawanẹ. <verse eid="2KI 13:10" /><verse number="11" style="v" sid="2KI 13:11" />Osi itama z'ititika s'Ọvaar Ibinọkpaabyi. Nnam katorọ k'mpyibha s'Jẹroboam kw'ode nnwa kw'Nẹbat osi, s'iwa ọwọhkọ anọng p'Israẹl abir asi. Ochina ororo osi mpyibha njo.<verse eid="2KI 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 13:12" />Idik njoza s'iwa iyinẹ k'ogbe kw'Jẹhoahaz ọbaabh, ọmaana idik mapyhir s'osi, ọmaana ẹfa ch'otim orima ọvaar Amaziya kw'Juda ábẹ̀, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="2KI 13:12" /><verse number="13" style="v" sid="2KI 13:13" />Wa Jehoash ope otor ab'otte za. Manọhng-ẹ z'Samariya, za ch'mad-anọhnga avaarnọng p'Israẹl. Jẹroboam okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 13:14" />Wa oyen ọkọhmaana f'ọd-ọmma Elisha. Elisha o, okwu ope ny'ọkọhmaana mvo. Jehoash kw'ode ọvaarnọng kw'Israẹl ọta ọd-ọzẹ-ẹ. Obhom-ẹ, oben bẹ́, “Ttatta kwaam e! Atte kwaam e! Ijaar s'nnyanya id-itọr e, ọmaana ayaar-nnyanya p'Israẹl e!”<verse eid="2KI 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 13:15" />Elisha oben-ẹ bẹ́, “Tọka oyuk ọmaana akọhn pẹ.” Ọvaarnọng osi minna. <verse eid="2KI 13:15" /><verse number="16" style="v" sid="2KI 13:16" />Pira oben ọvaarnọng kw'Israẹl bẹ́, “Tọka oyuk nwo tima ny'mbọhk.” Ọtọk nya o, Ẹlisha ọnana mbọhk sẹ ny'ọvaarnọng k'mbọhk.<verse eid="2KI 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 13:17" />Oben-ẹ bẹ́, “Gwunga ọmma nwo kw'ofum kw'okkerẹ za ch'ewuchen ed-eyin.” Ọvaarnọng ogwunga wẹ. Ẹlisha oben-ẹ bẹ́, “Tta!” Ọvaarnọng ọtta. Ẹlisha obir oben-ẹ bẹ́, “Oyuk kw'Ọvaar Ibinọkpaabyi kw'ekema, oyuk nwo kw'okem anọng p'Aram! Kọ m'afhọ anọng p'Aram kibung-kibungọ z'Aphẹk.”<verse eid="2KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 13:18" />Nya o, oben ọvaarnọng bẹ́, “Tọka akọhn mbo.” Minna kw'ọvaarnọng ọtọk akọhn mbo. Elisha oben-ẹ bẹ́, “Bin akọhn ny'izek.” Obin pẹ ny'izek igbedim ittaan, pira ọkpọka. <verse eid="2KI 13:18" /><verse number="19" style="v" sid="2KI 13:19" />Ettem ekwu epyibh ọgbaak-ettem ch'Ibinọkpaabyi ẹmaana ọvaarnọng. Oben-ẹ bẹ́, “Wúra ábinẹ ayuk mbo igbedim ichen ny'izek, wanẹma, igbedim ichadanẹ, nya wọ kw'uwura ikk'anọng p'Aram akema kibung-kibungọ. Okenaka, min'akema bẹ igbedim ittaan jẹ-jẹ.”<verse eid="2KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 13:20" />Elisha okwu ope, manọhng-ẹ.</para>
  <para style="p" vid="2KI 13:20">Ẹkaan ch'akikọhra ch'efon Moab ed-edim ny'ẹkọma ndo k'etitebhẹ kpenamkpen ẹyak bẹ edik. <verse eid="2KI 13:20" /><verse number="21" style="v" sid="2KI 13:21" />K'ogbe wanẹ, ch'anọng p'Israẹl ad-anọhnga ojinọng wanẹ, maze ẹkkaan ndo ch'akikọhra ch'ed-ekwu okwu. Minna kw'masẹr-ọsẹr atọka offuranọng nwo abharẹ z'epekwuk ch'Elisha. K'ose kw'offuranọng nwo otwu akọbhọ p'Ẹlisha z'epekwuk, minna kw'ọphyabh, obina obobe.<verse eid="2KI 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 13:22" />Ny'ogbe nwo maphyir kw'Jehoahaz ọbaabh Israẹl, wa ẹkọma ch'Israẹl ening k'irem s'ọvaar Hazayẹl kw'Aram. <verse eid="2KI 13:22" /><verse number="23" style="v" sid="2KI 13:23" />Okenaka, wa Ọvaar Ibinọkpaabyi osi ọphyaam ọnang bẹ, obir oze bẹ okwo, obir ọkọhka bẹ bẹ́, mayik-ẹ k'ettem, okurọ echekẹ ch'ochekẹ ọnang Abraham, ọmaana Isaak, ọttara Jekọb. Maa, pyirẹ menda, kẹ kọkamẹ bẹ́, m'ọfhọ bẹ, wanẹma, okwubh bẹ k'ikẹ k'ititika.<verse eid="2KI 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 13:24" />Ọvaar Hazayẹl kw'Aram okwu ope. Bẹn-Hadad kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ. <verse eid="2KI 13:24" /><verse number="25" style="v" sid="2KI 13:25" />Nya o, Jehoash kw'ode nnwa kw'Jehoahaz ọkpa nnam ọna Bẹn-Hadad kw'ode nnwa kw'Hazayẹl ibhon njo s'uwa ikk'ọtọka k'egbong z'Jehoahaz kw'ode otte kwẹ. Jehoash okema Bẹn-Hadad igbedim ittaan. Minna wọ kw'obir ọkpa nnam ọtọka ibhon njo s'anọng p'Israẹl.<verse eid="2KI 13:25" /></para>
  <chapter eid="2KI 13" />
  <chapter number="14" style="c" sid="2KI 14" />
  <para style="s1">Amaziya otim ẹvaar ch'Juda</para>
  <para style="b" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 14:1" />Ny'icho ttong ifa s'Jehoash kw'ode nnwa kw'Jehoahaz ọbaabh Israẹl, nya kw'Amaziya kw'ode nnwa kw'Joash ọtọm ẹvaar ch'Juda otitima. <verse eid="2KI 14:1" /><verse number="2" style="v" sid="2KI 14:2" />Wa Amaziya ode icho ẹrọbh okwuma ichen k'ogbe kw'otim ẹvaar. Oninga z'Jẹrusalẹm, ọbaabha k'icho ẹrọbh okwuma osowanẹ. Jehoaddan kw'ofon Jẹrusalẹm wọ uwa ode ọkka kwẹ. <verse eid="2KI 14:2" /><verse number="3" style="v" sid="2KI 14:3" />Wa Amaziya osi idik s'itor-otor k'ititika s'Ọvaar Ibinọkpaabyi, okenaka kẹ kosi opyirẹ mach'uwa Devid kw'ode otte, osi. Otor ntọkọ s'Joash kw'ode otte k'ọttọhk kpenamkpen f'osi. <verse eid="2KI 14:3" /><verse number="4" style="v" sid="2KI 14:4" />Kẹ wa ọja-byi f'ọyaankpa kọvọhkọ, ọwọhkọ anọng achina ororo afọhnọ nja, mabir akwọmọ insẹns nya.<verse eid="2KI 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 14:5" />K'ogbe kw'ẹvaar ch'Amaziya ikk'ettim mawuriji, ọfhọ adukwa mbo p'uwa mafhọ otte kw'ode ọvaarnọng. <verse eid="2KI 14:5" /><verse number="6" style="v" sid="2KI 14:6" />Okenaka, iva p'adukwa mbo p'uwa mafhọ otte, kọfhọ. Wa osi minna otor k'ose kw'Ọvaar Ibinọkpaabyi obenẹ Mosẹs z'nnwẹr kw'asana bẹ́, “M'otte ọttara ọkka kafhọ k'eso ch'iva. M'iva kabir afhọ k'eso ch'otte ọttara ọkka. Ọnọng-ọnọng m'ope k'epyibha chẹ.”<verse eid="2KI 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 14:7" />Amaziya nwa wọ uwa okem anọng p'Edom p'ade anọng nnọhna ẹrọbh okwuma nchen k'egbong, z'ilokodo s'onung. Obir ọbọka obhon kw'Sẹla, okpe wẹ bẹ́, Jọktẹl. Obhon nwo otim okpen minna maa, pyirẹ menda.<verse eid="2KI 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 14:8" />Nya o, Amaziya ọtọhm azeng-eden pẹ ẹkkaabha ch'ọmmakarẹ ọnang ọvaar Jehoash kw'Israẹl, kw'ode nnwa kw'Jẹhoahaz kw'Jehu obhonọ. Oben-ẹ bẹ́, “Kwu mokkerẹ ayok ititika, morima egbong.”<verse eid="2KI 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 14:9" />Okenaka, Jehoash kw'ode ọvaarnọng kw'Israẹl, ọpọhna Amaziya kw'ode ọvaarnọng kw'Juda bẹ́, “Okwumọkwumọ wanẹ ny'Lẹbanọn ọtọhm ẹkkaabha ọnang ochi kw'sida ny'Lẹbanọn bẹ́ ‘Tọka ominanwa kwọ nang nnwa kwaam k'ọbada.’ Minna kw'eten ch'ẹkkaam-ọkkaam ny'Lebanọn ekwu ẹbarẹ okwumọkwumọ nwo ẹtọkọ. <verse eid="2KI 14:9" /><verse number="10" style="v" sid="2KI 14:10" />K'odik ọkkọkka, kọ kk'anọng p'Edom akema, nya wọ asi ad-age ifor. Tte ettem elebh-ọ ch'ikk'akema. Okenaka, ninga z'ọsọhm kwọ o! Osempira aror ẹkọhr ch'im'ẹwọhkọ, kọ ọmaana Juda matto akwubha ẹmma o?”<verse eid="2KI 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 14:11" />Okenaka, Amaziya itọhng koyong. Minna kw'Jehoash kw'ode ọvaarnọng kw'Israẹl orim-ẹ ábẹ̀. Kẹ ọmaana Amaziya kw'ode ọvaarnọng kw'Juda marima ayok abẹ z'Bẹt-Shẹmẹsh, ny'ẹkọma ch'Juda. <verse eid="2KI 14:11" /><verse number="12" style="v" sid="2KI 14:12" />Wa anọng p'Israẹl makema anọng p'Juda, ojinọng kpenamkpen ọrọbh ọkpa nnam z'ọsọhm kwẹ. <verse eid="2KI 14:12" /><verse number="13" style="v" sid="2KI 14:13" />Jehoash kw'ode ọvaarnọng kw'Israẹl ọbọka ọvaar Amaziya kw'Juda kw'ode nnwa kw'Joash kw'Ahaziya obhonọ k'ẹmmọri, z'Bẹt-Shẹmẹsh. Minna kw'Jehoash ofon ọd-ọvọhkọ etumọ ch'Jẹrusalẹm ch'ede ntọkọ ẹnọhna k'adum, tọma ny'ebhumma ch'Ephraim maa, pyirẹ z'ebhumma ch'ibongọ s'etumọ ndo. <verse eid="2KI 14:13" /><verse number="14" style="v" sid="2KI 14:14" />Jehoash ọtọka gol, ọmaana silva, ọttara ekpo py'oze ny'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọttara z'nkwurukpa s'ọvaar-dimpa. Obir ọbọka anọng k'ẹmmọri otima okwuna z'Samariya.<verse eid="2KI 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 14:15" />Idik njoza s'iyinẹ k'ogbe kw'Jehoash ọbaabh, ọmaana idik s'osi, ọmaana ẹfa chẹ, ọttara egbong ch'ikẹ ọmaana ọvaar Amaziya kw'Juda marim, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="2KI 14:15" /><verse number="16" style="v" sid="2KI 14:16" />Jehoash okwu ope otor ab'otte za. Manọhng-ẹ z'Samariya, za ch'mad-anọhng avaar p'Israẹl. Jeroboam kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 14:17" />Wa Amaziya kw'ode nnwa kw'ọvaar Joash kw'Juda, orukọ akpen k'icho ichi, k'ogbe kw'Jehoash kw'ode nnwa kw'ọvaar Jehoahaz kw'Israẹl, ikk'ọpa. <verse eid="2KI 14:17" /><verse number="18" style="v" sid="2KI 14:18" />Idik njoza s'iyinẹ k'ogbe kw'Amaziya ọbaabh, makkẹrẹ z'anwẹr p'avaar p'Juda.<verse eid="2KI 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 14:19" />Wa machi Amaziya ikwu z'Jẹrusalẹm. Minna kw'ọrọbhọ ochina z'Lakish. Okenaka, awawunanọng pẹ matọhm anọng p'ad-afhọ anọng bẹ́, mad-afhẹ-ẹ. Anọng mbo akebh-ẹ z'Lakish, mafhẹ-ẹ za. <verse eid="2KI 14:19" /><verse number="20" style="v" sid="2KI 14:20" />Matọhk-ẹ k'ẹnyanya makwu anọhnga z'Jẹrusalẹm, za ch'manọhng ab'otte, z'ebhondim ch'Devid.<verse eid="2KI 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 14:21" />Anọng p'Juda maphyir, matọka Azariya kw'ode icho ichi kawanẹ k'atam, masẹ-ẹ ẹvaar, matim-ẹ atera eso ch'Amaziya kw'ode otte. <verse eid="2KI 14:21" /><verse number="22" style="v" sid="2KI 14:22" />Kẹ wọ uwa obir okwu osi obhon kw'Elat ọnang anọng p'Juda k'ogbe kw'Amaziya kw'ode otte, ikk'ọpa otor ab'otte.<verse eid="2KI 14:22" /></para>
  <para style="s1">Jẹroboam kw'ottong afa otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 14:23" />Ny'icho ttong ichi s'Amaziya kw'ode nnwa kw'Joash ọbaabh Juda, nya kw'Jẹroboam kw'ode nnwa Jehoash otim ẹvaar ch'Israẹl. Oninga ny'Samariya ọbaabha k'icho arọbh afa okwuma icho mawanẹ. <verse eid="2KI 14:23" /><verse number="24" style="v" sid="2KI 14:24" />Wa Osi itama z'Ọvaar Ibinọkpaabyi k'ititika. Nnam kọtọrọ k'mpyibha s'Jẹroboam kw'ode nnwa kw'Nẹbat s'ọwọhkọ anọng p'Israẹl asi. <verse eid="2KI 14:24" /><verse number="25" style="v" sid="2KI 14:25" />Jẹroboam nwa wọ uwa obir otor nnem s'Israẹl, tọma z'Lebo-Hamat maa, pyirẹ z'ọraanga kwiden kw'Araba, otor k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl ikk'Jona kw'ode ọtọhmnọng kwẹ otima ọgbaak. Wa Jona ode nnwa kw'Amitayi, kw'ofon Gat-Hẹpha, obir ode ọgbaak-ettem ch'Ibinọkpaabyi.<verse eid="2KI 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 14:26" />Wa Ọvaar Ibinọkpaabyi kk'ọza ose kw'ọnọng kpenamkpen ny'Israẹl, ọyak ọbọhk ọtọka irem, tọma k'obira, pyirẹ k'ọmmaana. Ọnọng kw'ọkkaan bẹ kode. <verse eid="2KI 14:26" /><verse number="27" style="v" sid="2KI 14:27" />Ch'iwa Ọvaar Ibinọkpaabyi ina obenẹ bẹ́, m'odimẹ Israẹl eche m'iyagbin, wa nozeng z'Jeroboam kw'ode nnwa Jehoash, ọkkaana bẹ.<verse eid="2KI 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 14:28" />Idik njoza s'iyinẹ k'ogbe kw'Jeroboam ọbaabh, idik maphyir s'osi, ọmaana mgbong s'okem, ọmaana ose kw'uwa obir ọtọka obhon kw'Damaskọs, ọmaana kw'Hamat s'iwa ikkikken ide ibhon s'Juda otima ọkpa nnam z'Israẹl, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="2KI 14:28" /><verse number="29" style="v" sid="2KI 14:29" />Jeroboam okwu ope otor ab'otte p'uwa ade avaar p'Israẹl. Zakariya kw'ode nnwa kwẹ okwu ọtọka ẹvaarninga ch'otte.<verse eid="2KI 14:29" /></para>
  <chapter eid="2KI 14" />
  <chapter number="15" style="c" sid="2KI 15" />
  <para style="s1">Azariya otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 15:1" />Ny'icho ttong ẹrọbh okwuma ichenọmfa s'ọvaar Jeroboam ọbaabh Israẹl, nya kw'Azariya kw'ode nnwa kw'Amaziya ọtọm Juda obubaabha. <verse eid="2KI 15:1" /><verse number="2" style="v" sid="2KI 15:2" />Wa ode icho ichi kawanẹ k'atam, k'ogbe kw'masẹ-ẹ ẹvaar. Oninga z'Jẹrusalẹm ọbaabha k'icho arọbh afa okwuma ijobh kkamfa. Ọkka kwẹ okpen Jekoliya, kw'ofon Jẹrusalẹm. <verse eid="2KI 15:2" /><verse number="3" style="v" sid="2KI 15:3" />Wa Azariya osi idik s'itor-otor z'ititika s'Ọvaar Ibinọkpaabyi k'ose kw'uwa Amaziya kw'ode otte, ikk'ọsa. <verse eid="2KI 15:3" /><verse number="4" style="v" sid="2KI 15:4" />Okenaka, wa ọja-byi f'ọyaankpa kọvọhkọ. Ayokinọng achina ororo afọhnọ nja, mabir akwọmọ insẹns nya.<verse eid="2KI 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 15:5" />Ọvaar Ibinọkpaabyi ọtọhbh ọvaar Azariya okpokora kw'oning ọmaan-ẹ, maa, ope. Wa osi oruk kwẹ nkọmẹ. Jotam kw'ode nnwa kw'ọvaarnọng, okwu ọtọka ẹvaarninga ch'otte, obir ọbaabha anọng p'ẹkọma ndo.<verse eid="2KI 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 15:6" />Idik njoza s'iyinẹ k'ogbe kw'Azariya ọbaabh, ọmaana idik maphyir s'osi, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 15:6" /><verse number="7" style="v" sid="2KI 15:7" />Azariya ope otor ab'otte za. Manọhng-ẹ atuma ab'otte z'ebhondim ch'Devid. Jotam kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 15:7" /></para>
  <para style="s1">Zekariya otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 15:8" />Ny'icho ttong ẹrọbh okwuma ichi kkanttaan s'Azariya ọbaabh Juda, nya kw'Zekariya kw'ode nnwa kw'Jẹroboam oning z'Samariya ọbaabha Israẹl k'aphe achadanẹ. <verse eid="2KI 15:8" /><verse number="9" style="v" sid="2KI 15:9" />Wa Zekariya osi itama z'ititika s'Ọvaar Ibinọkpaabyi mach'ab'otte nkk'asa. Nnam kọtọrọ k'mpyibha s'Jẹroboam kw'ode nnwa kw'Nẹbat s'ọwọhkọ anọng p'Israẹl asi.<verse eid="2KI 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 15:10" />Shalum kw'ode nnwa kw'Jabesh ochi Zekariya ikwu. Orima Zekariya ábẹ̀ ny'ikpakaana s'anọng, ọfhẹ-ẹ. Ọfhẹ-ẹ nya o, ọtọka ẹvaar chẹ. <verse eid="2KI 15:10" /><verse number="11" style="v" sid="2KI 15:11" />Idik njoza s'iyinẹ k'ogbe kw'Zekariya ọbaabh, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="2KI 15:11" /><verse number="12" style="v" sid="2KI 15:12" />Minna kw'ọgbaakadik kw'Ọvaar Ibinọkpaabyi otim Jehu ọgbaak, okwu ode minna bẹ́, “Iva pọ bọ mm'adaabh ẹvaar ch'Israẹl k'ipemaanitor nna.”<verse eid="2KI 15:12" /></para>
  <para style="s1">Shalum otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 15:13" />Ny'icho ttong ẹrọbh okwuma osowanẹ kw'ẹrọbh s'Uziya ọbaabh Juda, nya kw'Shalum kw'ode nnwa kw'Jabẹsh oning z'Samariya ọbaabha k'ophe mawanẹ. <verse eid="2KI 15:13" /><verse number="14" style="v" sid="2KI 15:14" />Nya o, Mẹnahẹm kw'ode nnwa kw'Gadi, obina z'Tirza, ochina z'Samariya, od-orima Shalum kw'ode nnwa kw'Jabẹsh ábẹ̀, z'Samariya. Mẹnahẹm ọfhọ Shalum, ọtọka ẹvaar chẹ otima.<verse eid="2KI 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 15:15" />Idik njoza s'iyinẹ k'ogbe kw'Shalum ọbaabh, ọmaana ikwu s'otim anọng ochi, makkẹrẹ z'anwẹr p'avaar p'Israẹl.<verse eid="2KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 15:16" />Ny'ogbe nwo, Mẹnahẹm ọtọma z'Tirza orima anọng p'Tiphsa, ọmaana ọnọng kpenamkpen kw'oning ny'ebhondim ndo, ọttara ibhon s'ining inyọma nya, okurọ ch'ibhon njo ibhumọ bẹ́, igwunga mbhumma sabẹ inang-ẹ. Wa kẹ obikẹ obhon kw'Tiphsa, obir ọbhaaka mmọr s'panọng p'atim ibhọr.<verse eid="2KI 15:16" /></para>
  <para style="s1">Mẹnahẹm otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 15:17" />Ny'icho ttong ẹrọbh okwuma osowanẹ kw'ẹrọbh s'Azariya ọbaabh Juda, nya kw'Mẹnahẹm kw'ode nnwa kw'Gadi, ọbaabh Israẹl. Wa oning z'Samariya ọbaabha k'icho ijobh. <verse eid="2KI 15:17" /><verse number="18" style="v" sid="2KI 15:18" />Wa osi itama z'ititika s'Ọvaar Ibinọkpaabyi. K'ẹbaabha chẹ maphyir, wa nnam kọtọrọ k'mpyibha s'Jẹroboam kw'ode nnwa kw'Nẹbat s'ọwọhkọ anọng p'Israẹl asi.<verse eid="2KI 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 15:19" />Nya o, Pul kw'ode ọvaarnọng kw'Asiriya, od-orima anọng p'ẹkọma ndo. Mẹnahẹm ọnang Pul atalẹn nnọhna mfa okwuma arọbh ijobh p'silva, ọfha ọbẹ-ẹ k'nnam, osi ẹvaar chẹ ebe. <verse eid="2KI 15:19" /><verse number="20" style="v" sid="2KI 15:20" />Wa Mẹnahẹm ọkpaar ọtabha kw'akpuka mbo ọnang anọng p'Israẹl. Ojibhadanọng kpenamkpen osi ọtabha kw'ashẹkẹl arọbh afa okwuma ijobh p'silva bẹ́, manang ọvaarnọng kw'Asiriya. Minna kw'ọvaarnọng kw'Asiriya ọtọrọ nnam, otte ẹkọma ndo ọbọhk.<verse eid="2KI 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 15:21" />Idik njoza s'iyinẹ k'ogbe kw'Mẹnahẹm ọbaabh, ọmaana idik maphyir s'osi, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="2KI 15:21" /><verse number="22" style="v" sid="2KI 15:22" />Wa Mẹnahẹm okwu ope otor ab'otte. Pẹkahiya kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 15:22" /></para>
  <para style="s1">Pẹkahiya otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 15:23" />Ny'icho ttong arọbh afa okwuma ijobh s'Azariya ọbaabh Juda, nya kw'Pẹkahiya kw'ode nnwa kw'Mẹnahẹm okwu otima ẹvaar ch'Israẹl. Oninga z'Samariya ọbaabha k'icho ifa. <verse eid="2KI 15:23" /><verse number="24" style="v" sid="2KI 15:24" />Wa Pẹkahiya osi itama z'ititika s'Ọvaar Ibinọkpaabyi. Nnam kọtọrọ k'mpyibha s'Jẹroboam kw'ode nnwa kw'Nẹbat s'ọwọhkọ anọng p'Israẹl asi. <verse eid="2KI 15:24" /><verse number="25" style="v" sid="2KI 15:25" />Osonọng wanẹ kw'arim-mgbong pẹ, kw'ode Pẹka kw'ode nnwa kw'Remaliya, ọchẹ-ẹ ikwu. Ọtọka ajinọng arọbh afa okwuma ijobh p'Gilead, otima ọd-ọfhọ Pẹkahiya, ọmaana Argọb, ọttara Ariyẹ z'ifa-byi s'ọvaar-dimpa, z'Samariya. Minna kw'Pẹka ọfhọ Pẹkahiya, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 15:26" />Idik njoza s'iyinẹ k'ogbe kw'Pẹkahiya ọbaabh, ọmaana idik maphyir s'osi, makkẹrẹ z'anwẹr p'avaar p'Israẹl.<verse eid="2KI 15:26" /></para>
  <para style="s1">Pẹka otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 15:27" />Ny'icho ttong arọbh afa okwuma ijobh kkamfa s'Azariya ọbaabh Juda, nya kw'Pẹka kw'ode nnwa kw'Remaliya otim ẹvaar ch'Israẹl. Oninga z'Samariya ọbaabha k'icho ẹrọbh. <verse eid="2KI 15:27" /><verse number="28" style="v" sid="2KI 15:28" />Wa osi itama z'ititika s'Ọvaar Ibinọkpaabyi. Wa nnam kọtọrọ k'mpyibha s'Jẹroboam kw'ode nnwa kw'Nẹbat s'ọwọhkọ anọng p'Israẹl, asi.<verse eid="2KI 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 15:29" />K'ogbe kw'Pẹka ọbaabh Israẹl, nya kw'Tiglat-Pilẹsa kw'ode ọvaarnọng kw'Asiriya, okwu ọtọka Ijọn, ọmaana Abẹl-Bẹt-Maaka, ọmaana Janoa, ọmaana Kẹdẹsh ọttara Hazọr. Obir ọtọka Gilead, ọmaana Galili, ọttara izek s'Naphtali, ọbọka anọng p'ẹkọma ndo maphyir k'ẹmmọri, otima bẹ ochina z'Asiriya. <verse eid="2KI 15:29" /><verse number="30" style="v" sid="2KI 15:30" />Ny'icho ttong ẹrọbh s'Jotam kw'ode nnwa kw'Uziya ọbaabh Juda, nya kw'Hosea kw'ode nnwa kw'Ẹla, ochi Pẹka kw'ode nnwa kw'Remaliya ikwu, orim-ẹ ábẹ̀, ọfhẹ-ẹ, ọtọka ẹvaar chẹ.<verse eid="2KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 15:31" />Idik njoza s'iyinẹ k'ogbe kw'Pẹka ọbaabh, ọmaana idik s'osi, makkẹrẹ z'anwẹr p'avaar p'Israẹl.<verse eid="2KI 15:31" /></para>
  <para style="s1">Jotam otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 15:32" />Ny'icho ttong ifa s'Pẹka kw'ode nnwa kw'Remaliya ọbaabh Israẹl, nya kw'Jotam kw'ode nnwa kw'Uziya ọtọm Juda obubaabha. <verse eid="2KI 15:32" /><verse number="33" style="v" sid="2KI 15:33" />Wa ode icho ẹrọbh okwuma ichen k'atam, k'ogbe kw'masẹ-ẹ ẹvaar. Oninga z'Jẹrusalẹm ọbaabha k'icho ichi kawanẹ. Wa ọkka kwẹ okpen Jerusha, kw'ode ominanwa kw'Zadọk. <verse eid="2KI 15:33" /><verse number="34" style="v" sid="2KI 15:34" />Wa Jotam osi idik s'itor-otor z'ititika s'Ọvaar Ibinọkpaabyi, mach'iwa Uziya kw'ode otte, ikk'ọsa. <verse eid="2KI 15:34" /><verse number="35" style="v" sid="2KI 15:35" />Okenaka, wa kẹ ọja-byi f'ọyaankpa kọvọhkọ. Minna kw'anọng achina ororo afọhnọ nja, mabir akwọmọ insẹns nya. Wa Jotam obir ottima ebhumma ch'ebir-ebir kw'Ọsọhm kw'Ọvaar Ibinọkpaabyi.<verse eid="2KI 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 15:36" />Idik njoza s'iyinẹ k'ogbe kw'Jotam ọbaabh, ọmaana idik s'osi, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 15:36" /><verse number="37" style="v" sid="2KI 15:37" />(Ny'ogbe nwo, Ọvaar Ibinọkpaabyi ọtọhm Rezin kw'ode ọvaarnọng kw'Aram, ọmaana Pẹka kw'ode nnwa kw'Remaliya bẹ́, mad-arima Juda ábẹ̀.) <verse eid="2KI 15:37" /><verse number="38" style="v" sid="2KI 15:38" />Wa Jotam ope otor ab'otte za. Manọhng-ẹ z'ebhondim ch'Devid kw'ode otte. Wa Ahaz kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 15:38" /></para>
  <chapter eid="2KI 15" />
  <chapter number="16" style="c" sid="2KI 16" />
  <para style="s1">Ahaz otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 16:1" />Ny'icho ttong ichi kkamfa s'Pẹka kw'ode nnwa kw'Remaliya ọbaabh Israẹl, nya wọ kw'Ahaz kw'ode nnwa kw'Jotam ọtọm Juda obubaabha. <verse eid="2KI 16:1" /><verse number="2" style="v" sid="2KI 16:2" />Wa Ahaz ode icho ẹrọbh k'atam, k'ogbe kw'otim ẹvaar. Oninga z'Jẹrusalẹm ọbaabha k'icho ichi kawanẹ. Wa idik s'itor-otor kosi k'ititika s'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwẹ, mach'uwa Devid kw'ode otte, osi. <verse eid="2KI 16:2" /><verse number="3" style="v" sid="2KI 16:3" />Wa otorọ ntọkọ s'avaar p'Israẹl maa, ọkwọmọ nnwa kwẹ k'ekpon otima ọfọhnọ ẹja, obir osi ibọkiji-dikse s'iwa Ọvaar Ibinọkpaabyi ozeng ábẹ̀, okwubh nkọma saabhada, pira anọng p'Israẹl napyirẹ. <verse eid="2KI 16:3" /><verse number="4" style="v" sid="2KI 16:4" />Ọfọhnọ nja, obir ọkwọmọ insẹns k'ọja-byi f'ọyaankpa, ọmaana k'agbeso, ọttara k'ofokodo kw'echi kpenamkpen.<verse eid="2KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 16:5" />Nya o, Rezin kw'ode ọvaarnọng kw'Aram, ọmaana ọvaar Pẹka kw'Israẹl kw'ode nnwa kw'Remaliya, mabina, mad-arima anọng p'Jẹrusalẹm ábẹ̀. Makọbha Ahaz ake k'ettem. Okenaka, m'kẹ kakpo akema. <verse eid="2KI 16:5" /><verse number="6" style="v" sid="2KI 16:6" />Ny'ogbe nwo, Rezin kw'ode ọvaarnọng kw'Aram, okwubh anọng p'Juda. Anọng p'Edom atọka obhon kw'Ẹlat aruk maa, pyirẹ menda nwa.<verse eid="2KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 16:7" />Ahaz okwu ọtọhm azeng-eden pẹ z'Tiglat-Pilẹsa kw'ode ọvaarnọng kw'Asiriya bẹ́, matek-ẹ bẹ́, “Kaam nde ọtọhmnọng kwọ, mbir nninga k'ẹfa chọ. Kwu, ọfha akkaana, arọbh-m k'mbọhk s'ọvaarnọng kw'Aram, ọmaana ọvaarnọng kw'Israẹl p'ad-arim-m ábẹ̀.” <verse eid="2KI 16:7" /><verse number="8" style="v" sid="2KI 16:8" />Nya o, Ahaz ọtọka silva, ọmaana gol p'oze z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana mbo p'aning z'ekwurukpa ch'ọvaardimpa, ọtọhm mach'ẹnanga, ochena ọvaarnọng kw'Asiriya. <verse eid="2KI 16:8" /><verse number="9" style="v" sid="2KI 16:9" />Ọvaarnọng kw'Asiriya ochera ọmaana nttọhna njo s'Ahaz, od-orima anọng p'Damaskọs ábẹ̀. Ọbọka anọng p'obhon nwo otima ochina z'Kir, obir ọfhọ Rezin.<verse eid="2KI 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 16:10" />Ọvaar Ahaz obina ozeng z'Damaskus, od-okebha Tiglat-Pilẹsa kw'ode ọvaarnọng kw'Asiriya. Oze ija-byi z'Damaskus, ọkkẹr sẹ, ọtọhm ọnang Uriya kw'ode ọfọhn-ẹja bẹ́, osi ise njo. <verse eid="2KI 16:10" /><verse number="11" style="v" sid="2KI 16:11" />Minna kw'Uriya kw'ode ọfọhn-ẹja, ottim ija-byi otor k'ose kw'Ahaz ikk'oninga z'Damaskus, ọtọhm ọnang-ẹ. Wa ottim ija-byi njo maphyir pira Ahaz nokwun. <verse eid="2KI 16:11" /><verse number="12" style="v" sid="2KI 16:12" />K'ogbe kw'ọvaar Ahaz obin z'Damaskus okwuna, okwu oze ija-byi njo, ozenga ọnyọma jẹ, ọd-ọnang nnanga za. <verse eid="2KI 16:12" /><verse number="13" style="v" sid="2KI 16:13" />Ọnang nnanga s'ẹkwọmọ, ọmaana s'achimọma. Obir obyenga atuk, ọmaana izẹ s'eforgbaka ny'ija-byi njo. <verse eid="2KI 16:13" /><verse number="14" style="v" sid="2KI 16:14" />Otinẹ ija-byi s'matim brons asi s'ining ny'ititika s'Ọvaar Ibinọkpaabyi, otima obina ny'ititika s'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ny'njeka kw'ija-byi ibhasẹ ọmaana Ọsọhm kw'Ọvaar Ibinọkpaabyi. Ọtọka jẹ osok z'ebir-ebir kw'ija-byi ibhasẹ.<verse eid="2KI 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 16:15" />Wa ọvaar Ahaz okwu ọnang Uriya kw'ode ọfọhn-ẹja ẹfa bẹ́, “Ny'ija-byi ibhasẹ siden, fọhnọ ẹja ch'nnanga s'ẹkwọmọ k'ekpebha. K'ẹsọhka, afọhnọ ẹja ch'ẹnanga ch'akpomọma, ẹnanga ch'ọvaarnọng ch'ẹkwọmọ, ọmaana akpomọma pẹ, ọmaana nnanga maphyir s'ẹkwọmọ s'anọng p'ẹkọma ndo, ọmaana ẹnanga ch'akpomọma pabẹ ọttara ẹnanga ch'atuk. Tọka izẹ s'nnanga s'ẹkwọmọ maphyir, pyaakẹ ny'ija-byi nja, abir afọhnọ nja, abharẹ nya. Okenaka, kaam m'ntima ija-byi s'matim bronz asi, mbọbh Ibinọkpaabyi ose kw'm'nsi.” <verse eid="2KI 16:15" /><verse number="16" style="v" sid="2KI 16:16" />Wa Uriya kw'ode ọfọhn-ẹja, osi mbengana k'ose kw'ọvaar Ahaz ikk'ẹ obena.<verse eid="2KI 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 16:17" />Ọvaar Ahaz ọkpaara mmakwubhchi s'nnana njo, pira ọrọhbha agbangbang nya. Ọsaka ẹgbangbangjọ z'abhaamdim p'matim bronz asi, py'ening izek-izek kw'nnana njo, pira nọtọk ọnana k'ẹta. <verse eid="2KI 16:17" /><verse number="18" style="v" sid="2KI 16:18" />Wa otinẹ ikkira s'ẹwọhngkwoka s'iwa nkk'attima ny'Ọsọhm kw'Ọvaar Ibinọkpaabyi, obir ọrọhbha ebhumma ch'avaar ad-azenga adim z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ch'ede nkọmẹ za ndo ch'ọvaarnọng kw'Asiriya.<verse eid="2KI 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 16:19" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Ahaz ọbaabh, ọmaana idik maphyir s'osi, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 16:19" /><verse number="20" style="v" sid="2KI 16:20" />Wa Ahaz ope otor ab'otte za, manọhng-ẹ z'ebhondim ch'Devid. Hezekiya kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 16:20" /></para>
  <chapter eid="2KI 16" />
  <chapter number="17" style="c" sid="2KI 17" />
  <para style="s1">Hoshiya otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 17:1" />Ny'icho ttong ijobh kkamfa s'Ahaz ọbaabh Juda, nya kw'Hosiya kw'ode nnwa kw'Ẹla ọbaabh Israẹl z'Samariya k'icho osowanẹ. <verse eid="2KI 17:1" /><verse number="2" style="v" sid="2KI 17:2" />Wa osi itama z'ititika s'Ọvaar Ibinọkpaabyi. Okenaka, itama sẹ mach'itama s'avaar p'achi eden abaabha Israẹl, kipyirẹ.<verse eid="2KI 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 17:3" />Wa ọvaar Shalmanẹsẹr kw'Asiriya, okwu orima Hoshiya ábẹ̀. Hoshiya okwu ode ọtọhmnọng kw'Shalmanẹsẹr, obir ọd-ọnang-ẹ ntuma. <verse eid="2KI 17:3" /><verse number="4" style="v" sid="2KI 17:4" />Okenaka, ọvaarnọng kw'Asiriya okwu otin bẹ́, Hoshiya ode ọfaranọng, okurọ ch'ikk'azeng-eden ọtọhma z'So kw'ode ovaarnọng kw'Ijip, ọmaana ch'ina ọdọk ọvaarnọng kw'Asiriya ntuma ọd-ọnang mach'iwa od-osi k'icho k'icho. Ofona nya, Shalmanẹsẹr ọbọk-ẹ oke mgbakkọhbhọ. <verse eid="2KI 17:4" /><verse number="5" style="v" sid="2KI 17:5" />Minna kw'ọvaarnọng kw'Asiriya odimẹ ny'ẹkọma ndo maphyir orima bẹ ábẹ̀, obir oyima egbong ny'Samariya k'icho ittaan. <verse eid="2KI 17:5" /><verse number="6" style="v" sid="2KI 17:6" />Ny'icho ttong osowanẹ kw'Hoshiya ikk'ẹvaar otima, nya kw'ọvaarnọng kw'Asiriya okem Samariya k'egbong. Ọbọka anọng p'Israẹl k'ẹmmọri otima ozeng z'Asiriya. Ọtọka bẹ od-osok z'Hala z'ẹkọma ch'Gozan, z'ẹbhaakẹ ch'ọraanga kw'Habọ, ọmaana z'ibhon s'anọng Mede.<verse eid="2KI 17:6" /></para>
  <para style="s1">Israẹl ọrọbhọ ebira okurọ epyibha</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 17:7" />Wa idik nja maphyir iyinẹ okurọ mpyibha s'anọng p'Israẹl asi z'ititika s'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabẹ. Wa bẹ nnakpobh aka ayọhnga Ibinọkpaabyi nwo kw'uwa otim bẹ obina z'Ijip, obir ọrọhbha bẹ k'mbọhk s'Phero kw'ode ọvaarnọng kw'Ijip. <verse eid="2KI 17:7" /><verse number="8" style="v" sid="2KI 17:8" />Wa anọng p'Israẹl natorọ mmaana s'nkọma s'Ọvaar Ibinọkpaabyi ikk'okwubha pira bẹ nnapyirẹ ny'izek njo, mabir asi mmaana s'avaar p'Israẹl nkk'abhaaka. <verse eid="2KI 17:8" /><verse number="9" style="v" sid="2KI 17:9" />Wa anọng p'Israẹl nad-asi idik s'ina itorọ z'nnam-nnam kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabẹ. Tọma z'ọttangara maa, pyirẹ z'ọfa-byi f'ebhondim, masi ọja-byi f'ọyaankpa ny'ibhon sabẹ maphyir. <verse eid="2KI 17:9" /><verse number="10" style="v" sid="2KI 17:10" />Wa mamin ata p'abarẹ odik, ọmaana ẹka-chi ch'Ashẹra k'ogbeso kpenamkpen, ọmaana k'ofokodo kpenamkpen. <verse eid="2KI 17:10" /><verse number="11" style="v" sid="2KI 17:11" />Makwọmọ insẹns k'ọja-byi f'ọyaankpa mach'nkọma s'iwa Ọvaar Ibinọkpaabyi ikk'okwubha id-isi, pira bẹ mapyirẹ ny'izek njo. Minna kw'masi adiktama p'awọhkọ Ọvaar Ibinọkpaabyi obhem ettem. <verse eid="2KI 17:11" /><verse number="12" style="v" sid="2KI 17:12" />Mabir akpobha aka, chibhẹ ch'Ọvaar Ibinọkpaabyi ikk'bẹ obena bẹ́, “M'idikse nja, kasi.” <verse eid="2KI 17:12" /><verse number="13" style="v" sid="2KI 17:13" />Wa Ọvaar Ibinọkpaabyi otim agbaak-ettem ch'Ibinọkpaabyi pẹ maphyir, ọmaana ayok p'aze iyaan, ọtọr anọng p'Israẹl, ọmaana anọng p'Juda itọhng. Oben bẹ bẹ́, “Màkpa nnam bọra adiktama pabọnga. Màkpobha apaanga paam, ọmaana akpebhẹ paam, mator k'asana maphyir p'nnang ab'atte bẹ́, makpobha, ọmaana p'ntte ọbọhk nnang agbaak-ettem ch'Ibinọkpaabyi p'ade atọhmnọng paam.”<verse eid="2KI 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 17:14" />Okenaka, wa bẹ m'itọhng kayong. Machina ororo agaangẹ nso, mach'ab'otte p'uwa nna nnam k'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabẹ, aphe. <verse eid="2KI 17:14" /><verse number="15" style="v" sid="2KI 17:15" />Wa mabhum asana pẹ, ọmaana echekẹ ch'iwa ikk'ọsa ọmaana ab'otte, ọmaana apaanga p'uwa ikk'bẹ itọhng ọtọra bẹ́, masok. Makpobha aka p'nna k'eden ayinẹ. Bẹ oyenẹ, m'ọttọhk áfẹ̀, kabir abanga. Chibhẹ ch'Ọvaar Ibinọkpaabyi ikk'bẹ itọhng ọtọra, bẹ́, “Bọnga nkkàsi mach'bẹ masi.” Wa bẹ machina ororo asaana osisi kw'nkọma s'ining ikọbha bẹ.<verse eid="2KI 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 17:16" />Wa mabhum apaanga p'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabẹ. Masi akpata afa, p'akerẹ abhaamva, ọmaana ọkpata kw'Ashẹra. Maraka nso, makpobha ekpo maphyir py'ọrọngkpakpa, ọmaana ọka f'Baal. <verse eid="2KI 17:16" /><verse number="17" style="v" sid="2KI 17:17" />Mafọhnọ nja s'makwọmọ ajinọngva, ọmaana aminava pabẹ k'ekpon. Masi mbọhk ọmaana ọkkẹwọrọ. Mabir atte ifor sabẹ ọbọhk anang k'itama osisi k'ititika s'Ọvaar Ibinọkpaabyi, s'isẹ-ẹ obhem ettem.<verse eid="2KI 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 17:18" />Nya o, wa ettem epyibhẹ Ọvaar Ibinọkpaabyi mawuriji otima otor anọng p'Israẹl, obir ọkpa nnam ọbọra bẹ. Wa ẹkọma ch'Juda dẹ-dẹ ina erikẹ. <verse eid="2KI 17:18" /><verse number="19" style="v" sid="2KI 17:19" />Ozeng k'ẹkọma ch'Juda, wa m'asana p'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabẹ, kakpobh. Wa matorọ mmaana s'anọng p'Israẹl nkk'abhaaka. <verse eid="2KI 17:19" /><verse number="20" style="v" sid="2KI 17:20" />Ofona nya, Ọvaar Ibinọkpaabyi obhum anọng p'Israẹl maphyir, osi bẹ itama, obir otte bẹ ọbọhk ọnang anọng p'anang bẹ irem maa, okwubh bẹ maphyir ny'ikẹ k'ititika.<verse eid="2KI 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 17:21" />K'ogbe kw'Ibinọkpaabyi ọbhaangẹ anọng p'Israẹl z'ẹnọmma ch'Devid, wa anọng p'Israẹl asi Jeroboam kw'ode nnwa kw'Nẹbat ovaarnọng kwabẹ. Jeroboam ọbọhra anọng p'Israẹl, ọwọhkọ bẹ masi epyibha chiden. <verse eid="2KI 17:21" /><verse number="22" style="v" sid="2KI 17:22" />Anọng p'Israẹl achina ororo k'mpyibha s'Jeroboam maphyir. M'nnam kakpa abọrạ jẹ <verse eid="2KI 17:22" /><verse number="23" style="v" sid="2KI 17:23" />maa, kwu pyirẹ k'ogbe kw'Ọvaar Ibinọkpaabyi okwubh bẹ z'ititika sẹ, otor mach'iwa ikk'agbaak-ettem ch'Ibinọkpaabyi p'ade atọhmnọng pẹ, otima ọtọr bẹ itọhng. Minna kw'uwa anọng p'Asiriya mabọk anọng p'Israẹl z'abẹ k'izek, mad-ayima ebira z'Asiriya. Maa, pyirẹ menda, anọng p'Israẹl aning z'Asiriya.<verse eid="2KI 17:23" /></para>
  <para style="s1">Anọng p'Asiriya akwu aruk z'Israẹl</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 17:24" />Wa ọvaarnọng kw'Asiriya otima anọng obina z'Babilọn, ọmaana Kuta, ọmaana Avva, ọmaana Hamat, ọttara Sẹpharvayim, okwu osok bẹ ny'Samariya otima otera anọng p'Israẹl. Matọka Samariya maphyir, maruk ny'ibhondim sẹ. <verse eid="2KI 17:24" /><verse number="25" style="v" sid="2KI 17:25" />K'ogbe kw'matọm eruka nya, wa m'Ọvaar Ibinọkpaabyi kakpobh. Ofona nya, Ọvaar Ibinọkpaabyi ọtọhm nche ọnang bẹ. Nche njo ifhọ anọng banẹ. <verse eid="2KI 17:25" /><verse number="26" style="v" sid="2KI 17:26" />Wa itekẹ kk'ọvaarnọng kw'Asiriya ipyira bẹ́, “Anọng p'atọk akwu asok z'ibhon s'Samariya, m'ọttọhk kazong f'ọka f'ẹkọma ndo ororọ. Ọka mvo k'nche ọtọhma ọnang bẹ. Nche njo ining za ifhọ bẹ, okurọ ch'nna ọttọhk azong f'ọka mvo ororọ.”<verse eid="2KI 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 17:27" />Nya o, ọvaarnọng kw'Asiriya oke ẹfa bẹ́, “M'atima ọfọhn-ẹja wanẹ kw'mabọk k'ẹmmọri z'Samariya, akpa nnam, od-oruk ọmaana anọng mbo, obir okpebhẹ bẹ idik s'ọka f'ẹkọma ndo ororọ.” <verse eid="2KI 17:27" /><verse number="28" style="v" sid="2KI 17:28" />Minna kw'ọfọhn-ẹja wanẹ kw'nkk'akwubha z'Samariya ọkpa nnam, okwu oruk ny'Bẹtẹl, okpebhẹ bẹ ose kw'mm'akpobha Ọvaar Ibinọkpaabyi.<verse eid="2KI 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 17:29" />Okenaka, ẹkọma kpenamkpen ch'ening nya, esi ọka fabẹ ny'ibhon s'marukọ, mabir attima aka-pa ny'ọja-byi f'ọyaankpa f'anọng p'Samariya nkk'asa. <verse eid="2KI 17:29" /><verse number="30" style="v" sid="2KI 17:30" />Anọng p'Babilọn asi Sukọt-Bẹnọt, anọng p'Kuta asi Nẹgal, anọng p'Hamat asi Ashima, <verse eid="2KI 17:30" /><verse number="31" style="v" sid="2KI 17:31" />anọng p'Ava asi Nibhaz ọmaana Tartak. Anọng p'Sẹpharvayim akwọmọ iva pabẹ k'ekpon, matima afọhnọ nja anang Adramẹlẹk, ọmaana Anamẹlẹk, p'ade aka p'Sẹpharvayim. <verse eid="2KI 17:31" /><verse number="32" style="v" sid="2KI 17:32" />Wa bẹ makpobh Ọvaar Ibinọkpaabyi, okenaka, wa mabir arọbha anọng pabẹ k'akira k'akira bẹ́, made afọhn-ẹja pabẹ z'ọja-byi f'ọyaankpa. <verse eid="2KI 17:32" /><verse number="33" style="v" sid="2KI 17:33" />Wa bẹ makpobh Ọvaar Ibinọkpaabyi, okenaka, wa mabir akpobha aka pabẹ oyenẹ, k'ose kw'ẹmmaana ch'nkọma s'mabin akwu, ede.<verse eid="2KI 17:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 17:34" />Maa, pyirẹ menda, anọng mba atima asi itamadik sabẹ. Bẹ m'Ọvaar Ibinọkpaabyi kakpobh. M'akpebhẹ, ọmaana apaanga, ọmaana ntọhna, ọttara asana p'Ọvaar Ibinọkpaabyi ọnang iva p'iva p'Jekọb kw'obir okpena Israẹl, kabir akpobha. <verse eid="2KI 17:34" /><verse number="35" style="v" sid="2KI 17:35" />Wa Ọvaar Ibinọkpaabyi osi echekẹ ọmaana anọng p'Israẹl, oben bẹ bẹ́, “M'aka ọdọk-ọdọk kakpobha, m'eso kabir araka anang bẹ, m'nja kabir afọhnọ anang bẹ. <verse eid="2KI 17:35" /><verse number="36" style="v" sid="2KI 17:36" />Ọvaar Ibinọkpaabyi kw'otim ẹfa chiden, otima bọnga obina z'Ijip, ọmaana abarada pẹ, kẹ wọ kw'mm'akpobha. Kẹ wọ kw'mm'araka eso anang, mabir afọhnọ nja anang. <verse eid="2KI 17:36" /><verse number="37" style="v" sid="2KI 17:37" />Bọnga mm'akonga asok apaanga, ọmaana ntọhna, ọttara asana p'ọkkẹrẹ ọnang bọnga. M'aka ọdọk-ọdọk, kàkpobha. <verse eid="2KI 17:37" /><verse number="38" style="v" sid="2KI 17:38" />M'echekẹ ch'nsi mmaana bọnga kàzaama. M'aka ọdọk-ọdọk, kàkpobha. <verse eid="2KI 17:38" /><verse number="39" style="v" sid="2KI 17:39" />Màtera kpobha Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga. Kẹ-kẹ wọ im'okpo bọnga ọrọhbha k'mbọhk s'awawunanọng pabọnga maphyir.”<verse eid="2KI 17:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2KI 17:40" />Okenaka, wa m'itọhng kayong. Machina ororo k'mmaanadik sabẹ. <verse eid="2KI 17:40" /><verse number="41" style="v" sid="2KI 17:41" />Chibhẹ ch'iwa anọng mba mad-akpobha Ovaar Ibinọkpaabyi, wa mabir ad-akpobha akpata pabẹ. Maa, pyirẹ menda, iva pabẹ, ọmaana iva p'iva pabẹ, matim asi idik s'iwa ab'otte asi.<verse eid="2KI 17:41" /></para>
  <chapter eid="2KI 17" />
  <chapter number="18" style="c" sid="2KI 18" />
  <para style="s1">Hezekiya otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 18:1" />Ny'icho ttong ittaan s'Hoshiya kw'ode nnwa kw'Ẹlah ọbaabh Israẹl, nya kw'Hezekiya kw'ode nnwa kw'Ahaz ọtọm ẹbaabha z'Juda. <verse eid="2KI 18:1" /><verse number="2" style="v" sid="2KI 18:2" />Wa ode icho ẹrọbh okwuma ichen k'atam k'ogbe kw'masẹ-ẹ ẹvaar. Oninga z'Jẹrusalẹm ọbaabha k'icho ẹrọbh okwuma osowanẹ. Wa ọkka kwẹ okpen Abija, kw'ode ominanwa kw'Zekariya. <verse eid="2KI 18:2" /><verse number="3" style="v" sid="2KI 18:3" />Wa Hezekiya osi idik s'itor-otor z'ititika s'Ọvaar Ibinọkpaabyi, k'ose kw'uwa Devid kw'ode otte, ikk'ọsa. <verse eid="2KI 18:3" /><verse number="4" style="v" sid="2KI 18:4" />Wa ọvọhkọ ọja-byi f'ọyaankpa, obir ọvọhkọ ata p'aka, obir ọkpaara nka-chi s'Ashẹra ọbharẹ. Ọvọhkọ ijọhk njo maphyir s'Mosẹs ikk'bronz otima osi, okurọ bẹ́, maa, pyirẹ ny'ogbe nwo, wa anọng p'Israẹl atim ad-akwọmọ insẹns anang ijọhk njo. (Wa makpe ijọhk njo bẹ́, Nehushtan.)<verse eid="2KI 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 18:5" />Wa Hezekiya ophe nnam k'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl. Ny'avaar p'Juda mapyhir, ọnọng kode kw'uwa ode mach'kẹ, tọma z'avaar p'achi eden abaabha maa, pyirẹ z'ayok p'ator-ẹ nnam k'ẹbaabha. <verse eid="2KI 18:5" /><verse number="6" style="v" sid="2KI 18:6" />Wa obe ọmaana Ọvaar Ibinọkpaabyi mawuriji, nnam kọkpa ọbọr-ẹ. Osok asana p'uwa Ọvaar Ibinọkpaabyi ikk'Mosẹs ọnanga. <verse eid="2KI 18:6" /><verse number="7" style="v" sid="2KI 18:7" />Wa Ọvaar Ibinọkpaabyi oning ọmaan-ẹ. Ọttọhk kpenamkpen f'osi obir ojibh ọnang-ẹ. Wa od-oke ọvaarnọng kw'Asiriya ẹkọhr; eso kobir ọraka ọnang-ẹ. <verse eid="2KI 18:7" /><verse number="8" style="v" sid="2KI 18:8" />Tọma z'ọttangara kw'asoja ad-aninga akkerẹ obhon, ọmaana z'odidenbhon kw'mabaak-ọbaak, wa Hezekiya okem anọng p'Philistiya maa, pyirẹ z'Gaza, ọmaana ibhon s'makọm-ọkọma.<verse eid="2KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 18:9" />Ny'icho ttong nna s'Hezekiya ọbaabh, kw'ode icho ttong ichenọmfa s'Hoshiya kw'ode nnwa kw'Ẹla ọbaabh Israẹl, nya kw'ọvaar Shalmanesẹr kw'Asiriya ofon od-oyima egbong z'Samariya, orima bẹ ábẹ̀. <verse eid="2KI 18:9" /><verse number="10" style="v" sid="2KI 18:10" />Ny'ẹkpọka ch'icho ttong ittaan s'egbong ndo, Asiriya ọtọka obhon nwo. Wa mana Samariya mkpang k'ogbe kw'Hezekiya ode icho ichadanẹ k'ẹbaabha chẹ. Icho nwo wọ uwa ottong icho osowanẹ kw'Hoshiya ọbaabh Israẹl. <verse eid="2KI 18:10" /><verse number="11" style="v" sid="2KI 18:11" />Ọvaarnọng kw'Asiriya ọtọhm anọng p'Israẹl ebira z'ẹkọma ch'Asiriya, osok bẹ ny'ẹkọma ch'Hala, z'Gọzan ny'ẹbhaakẹ ch'ọraanga kw'Habọr ọmaana z'ibhon s'anọng p'Mede. <verse eid="2KI 18:11" /><verse number="12" style="v" sid="2KI 18:12" />Wa idik nja iyinẹ okurọ ch'malukọ Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabẹ, mavọhkọ echekẹ ch'osi ọmaana bẹ. Ozeng k'asana maphyir p'uwa Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ọnang bẹ, nkakpobh. K'ose kw'nna ọdọk asana mbo akpobh, minna kw'nna idik s'asana mbo abir asi.<verse eid="2KI 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 18:13" />Ny'icho ttong osowanẹ kw'ichi kw'ẹbaabha ch'Hezekiya, nya kw'Senakerib kw'ode ọvaarnọng kw'Asiriya, orim egbong ọmaana anọng p'Juda. Orima bẹ ábẹ̀ z'ibhondim maphyir s'ide ifa-byi sabẹ, okema bẹ. <verse eid="2KI 18:13" /><verse number="14" style="v" sid="2KI 18:14" />Minna kw'Hezekiya kw'ode ọvaarnọng kw'Juda ọtọhm ẹkkaabha nda, ọnang ọvaarnọng kw'Asiriya z'Lakish, oben-ẹ bẹ́, “Kaam kk'epinẹ nsa. Tọr ifor m'erima nda. Kaam m'nnang-ọ ọttọhk kpenamkpen f'arorọ.” Ọvaarnọng kw'Asiriya oben Hezekiya kw'ode ọvaarnọng kw'Juda bẹ́, ọnang-ẹ atalẹn p'silva arọbh ichi, ọmaana atalẹn p'gol ẹrọbh okwuma ijobh. <verse eid="2KI 18:14" /><verse number="15" style="v" sid="2KI 18:15" />Minna kw'Hezekiya ọnang-ẹ silva mbo mapyhir p'aning z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana mbo p'aning z'nkwurukpa s'ọvaardimpa.<verse eid="2KI 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 18:16" />M'ogbe nwa, wa ọvaar Hezekiya kw'Juda óborọ gol kw'ikk'otima ọbhọrọ amma ọmaana mmakwukchi s'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọtọka ọnang ọvaarnọng kw'Asiriya.<verse eid="2KI 18:16" /></para>
  <para style="s1">Senakerib oke anọng p'Jẹrusalẹm ojora</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 18:17" />Ọvaarnọng kw'Asiriya ọtọhm odidennọng-kw'agbongso-nọng pẹ, ọmaana osonọng kwẹ, ọmaana ogbongso-nọng kwẹ, ọttara asoja k'ọsaabh, mabina z'Lakish bẹ́, makebha ọvaar Hezekiya z'Jẹrusalẹm. Makwu apyirẹ z'Jẹrusalẹm, mabe ny'oteng, z'ẹrọng-ẹrọng kw'esipe ch'echin z'eden ch'owonọ kw'ọnọng kw'od-ogbobhọ ekpo. <verse eid="2KI 18:17" /><verse number="18" style="v" sid="2KI 18:18" />Mayerẹ ọvaarnọng, ọmaana Eliyakim kw'ode nnwa kw'Hilkiya kw'ode okker-idik s'odimpa kw'ọvaarnọng, ọmaana Shẹbna kw'ode ọkkẹrẹ kw'odimpa kw'ọvaarnọng, ọttara Joab kw'ode nnwa kw'Asaph kw'ode oye-idik, mad-akebh bẹ z'iyaan.<verse eid="2KI 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 18:19" />Ogbongso-nọng nwo oben bẹ bẹ́, “Màtek Hezekiya bẹ́:</para>
  <para style="pm" vid="2KI 18:19">“ ‘Odik kw'ọvaarnọng kwiden, kw'ode ọvaarnọng kw'Asiriya ọgbaakẹ ode bẹ́, Memma kw'ottembara nwa kwọ ofon o? <verse eid="2KI 18:19" /><verse number="20" style="v" sid="2KI 18:20" />Kọ ọsọ-ọ bẹ́, ọgbaakadik kw'ẹmma wọ ode akkona, ọmaana ẹfa ch'egbong o? K'anyi kw'aphe nnam o, kw'ad-ake-m ẹkọhr o? <verse eid="2KI 18:20" /><verse number="21" style="v" sid="2KI 18:21" />Kirẹ e, kaam nzong bẹ́, kọ aphe nnam k'Ijip nwo kw'ode ochikwura kw'ikk'ọphyaka, kw'im'okwum ọnọng kpenamkpen kw'ophe nnam nya. Phero kw'ode ọvaarnọng kw'Ijip, ode minna ọnang anọng maphyir p'aphe nnam k'ikẹ. <verse eid="2KI 18:21" /><verse number="22" style="v" sid="2KI 18:22" />Ṉ́nòsi bọnga mm'aben-m bẹ́, “Mina mophe nnam k'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwamina”, okenaka, Hezekiya nwo wọ uwa ọvọhkọ ọja-byi f'Ibinọkpaabyi f'ọyaankpa, ọmaana ọja-byi mvoza, okwu oben anọng p'Juda ọmaana p'Jẹrusalẹm bẹ́, “Ọbaan bẹ́, màninga m'ija-byi nja s'Jẹrusalẹm akpobha Ibinọkpaabyi.”<verse eid="2KI 18:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="2KI 18:23" />“ ‘Màkwu ttọhna maana ttatta kwaam kw'ode ọvaarnọng kw'Asiriya. Kaam m'nnang bọnga nnyanya nnọhna nchen, ọfha nze, óde mm'akpo ayena anọng p'mm'ayaar jẹ! <verse eid="2KI 18:23" /><verse number="24" style="v" sid="2KI 18:24" />Zaa wura ode bẹ́, bọnga maphe nnam k'Ijip, ọmaana k'ijaar sabẹ s'nnyanya id-itọr, ọmaana ayaar-ọyaar, kayen kw'wura mattaangẹ ọtọhmnọng mawanẹ kw'atte kwaam, ozeng k'oyok kw'ọchamẹ ọtam? <verse eid="2KI 18:24" /><verse number="25" style="v" sid="2KI 18:25" />Kọ ọsọ-ọ bẹ́, ẹfa chaam ch'ntim nkwu bẹ, nkwu nrima ẹkọma nda ábẹ̀? Ẹfa ndo efon k'Ọvaar Ibinọkpaabyi. Ọvaar Ibinọkpaabyi oyenẹ wọ oben-m bẹ́, nkwu nrima ẹkọma nda ábẹ̀, mbir ndimẹ chẹ.’ ”<verse eid="2KI 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 18:26" />Nya o, Ẹliyakim kw'ode nnwa kw'Hilkiya, ọmaana Shẹbna, ọttara Joab mabenẹ odidennọng kw'agbongso-nọng bẹ́, “Ototo, tima ebhon ch'Aram gbaak mina odik, ch'ode dẹ ch'mọbhaang; eHiburu katima, ọfha anọng p'aning ny'etumọ ndo, maning abhaang.”<verse eid="2KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 18:27" />Okenaka, ogbongso-nọng nwo ọpọhna bẹ́, “Ma, osi bọnga bẹ́, ẹkkaabha ch'atte kwaam ọtọhm-m ma, ede ch'atte kwabọnga, ọmaana chabọnga dẹ-dẹ o? Ọtọhm-m k'anọng p'aning ny'etumọ ọttara e. K'ose kw'ode ọmaana bọnga, minna kw'bẹ mm'abir achi affu, mabir agwo asaangẹ pabẹ oyenẹ.”<verse eid="2KI 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 18:28" />Nya o, ogbongso-nọng nwo obina, ọgbaak k'eHiburu bẹ́, “Màbhaanga odik kw'ọvaarnọng kwiden, kw'ode ọvaarnọng kw'Asiriya ọgbaakẹ! <verse eid="2KI 18:28" /><verse number="29" style="v" sid="2KI 18:29" />Ọvaarnọng obenẹ bẹ́, Nkàchera bẹ́, Hezekiya ọbọhra bọnga. Kẹ bọnga mòkpo ọrọbha k'mbọhk saam. <verse eid="2KI 18:29" /><verse number="30" style="v" sid="2KI 18:30" />Nkàchera Hezekiya ọdaabha bọnga maphe nnam k'Ọvaar Ibinọkpaabyi ch'od-oben bẹ́, ‘K'odik ọkkọkka, Ọvaar Ibinọkpaabyi m'ọkkaana mina. Ebhondim nda ọbọhk mòtte bẹ́, ọvaarnọng kw'Asiriya ọtọka.’<verse eid="2KI 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 18:31" />“M'Hezekiya itọhng kàyonga o. Ọvaarnọng kw'Asiriya obenẹ bẹ́: Màsi ẹmẹm maan-m. Nya wọ kw'ọnọng-ọnọng m'ochi achiduk p'kẹ k'owonọ, ọmaana p'fig, obir ogwo asi p'afon z'ikẹ k'esipe, <verse eid="2KI 18:31" /><verse number="32" style="v" sid="2KI 18:32" />maa, nkwu ntọka bọnga ntima nchina z'izek s'ide mach'izek sabọnga, s'ide izek s'ọchattọhk, ọttara s'abhatuk asaabh-ọsaabh, ọmaana izek s'brẹd, ọttara iwonọ s'grep, ọmaana izek s'nchi s'oliv, ọttara s'akọhnsi. Màchema akpen e, m'obo kachema e. “M'Hezekiya itọhng kàyonga o, kirẹ kẹ od-otima bọnga otten-ottena nya e, ch'od-oben bẹ́, ‘Ọvaar Ibinọkpaabyi m'ọkkaana mina.’ <verse eid="2KI 18:32" /><verse number="33" style="v" sid="2KI 18:33" />Ch'iwa obobe ode, k'ọka f'ẹkọma danẹ oyena f'ọkkaan ẹkọma chẹ k'mbọhk s'ọvaarnọng kw'Asiriya o? <verse eid="2KI 18:33" /><verse number="34" style="v" sid="2KI 18:34" />Aka p'Hamat, ọmaana p'Arpad kẹ? Aka p'Sẹphavayim, ọmaana p'Hẹna, ọttara p'Ivva kẹ? Wa ika njo kk'Samariya ikpo ikkaana m'kaam k'mbọhk o? <verse eid="2KI 18:34" /><verse number="35" style="v" sid="2KI 18:35" />Ny'ika s'nkọma njo maphyir, bọng-ọka vọ ikk'anọng pẹ ọkaana m'kaam k'mbọhk o?”<verse eid="2KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 18:36" />Minna kw'anọng mbo maphyir, mamyi <char style="it">bẹ sẹẹbh</char>, m'kẹ ẹmọng kasi, okurọ ch'iwa ọvaarnọng kk'obena bẹ́, “M'kẹ ẹmọng kasi o.”<verse eid="2KI 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 18:37" />Ofona nya, Ẹliyakim kw'ode nnwa kw'Hilkiya kw'ode okker-idik-s'odimpa, ọmaana Shẹbna kw'ode ọkkẹrẹ, ọttara Joab kw'ode nnwa kw'Asaph kw'ode oye-idik, mafọra ekpo py'ikk'ẹyaaka, matima ad-akebha Hezekiya, matek-ẹ idik s'ogbongso-nọng nwo, ikk'ọgbaaka.<verse eid="2KI 18:37" /></para>
  <chapter eid="2KI 18" />
  <chapter number="19" style="c" sid="2KI 19" />
  <para style="s1">Jẹrusalẹm m'oyena ẹnaanga</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 19:1" />K'ogbe kw'Ọvaar Hezekiya ọbhaang odik nwo nya o, minna kw'ọyaakẹ ọbara f'ọfọr, nọfọra abara-tama, otima ochina z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 19:1" /><verse number="2" style="v" sid="2KI 19:2" />Hezekiya ọtọhm Ẹliyakim kw'ode okker-idik s'odimpa, ọmaana Shẹbna kw'ode ọkkẹrẹ, ọttara aso p'afọhn-ẹja z'Izaya kw'ode nnwa kw'Amọs, obir ode ọgbaak-ettem ch'Ibinọkpaabyi. Bẹ maphyir mafọra abara-tama atima achina za. <verse eid="2KI 19:2" /><verse number="3" style="v" sid="2KI 19:3" />Matek-ẹ bẹ́, “Ọvaar Hezekiya obenẹ bẹ́, Menda wọ ode ewu ch'ottemgbaaka, ọmaana ch'ẹgbọbhọ, ọttara ch'igbardik. Ewu nda ebir ede mach'kwanọng kw'ọmaan ọbọk-ẹ, pira ẹfa koyen ch'otim ọmaan. <verse eid="2KI 19:3" /><verse number="4" style="v" sid="2KI 19:4" />Ṉ́nòsi, Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ, m'ọbhaanga idik njo maphyir s'ọvaarnọng kw'Asiriya ikk'ogbongso-nọng kwẹ ọtọhma bẹ́, otima okwu ọlọhkọ Ibinọkpaabyi kw'orukọ akpen, obir otima idik njo ọgbọbhọ ogbongso-nọng nwo k'idik s'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ, ikk'ọbhaanga. Ofona nya, ze njọm bẹ́, anọng p'arik-orik, manaanga.”<verse eid="2KI 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 19:5" />K'ogbe kw'osonọng kw'ọvaar Hezekiya makwu akebha Izaya, <verse eid="2KI 19:5" /><verse number="6" style="v" sid="2KI 19:6" />Izaya oben bẹ bẹ́, “Màtek ttatta kwabọnga bẹ́, ‘Ọvaar Ibinọkpaabyi obenẹ bẹ́: Tte oning bọnga ojor ny'idik s'nkk'abhaanga s'ọvaarnọng kw'Asiriya ọgbaakẹ bẹ́, otima opyina eche chaam. <verse eid="2KI 19:6" /><verse number="7" style="v" sid="2KI 19:7" />Màyonga itọhng! Ogbe kw'kẹ im'ọbhaanga ẹkkaabha danẹ, kaam m'nsẹ-ẹ oyena ochibhẹ bẹ́, ọkpa nnam z'ẹkọma chẹ oyenẹ. Nya wọ kw'mm'atima ọkkangkkang afhẹ-ẹ.’ ”<verse eid="2KI 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 19:8" />K'ogbe kw'ogbongso-nọng nwo ọbhaang bẹ́, ọvaarnọng kk'obina z'Lakish, minna kw'ogbongso-nọng nwo ọtọr ifor, od-okebha ọvaarnọng za ch'od-orima Libna ábẹ̀.<verse eid="2KI 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 19:9" />Senakerib okwu ọbhaanga ẹkkaabha bẹ́, Tirhaka, kw'ode ọvaarnọng kw'Kush, okwuma z'eden bẹ́, orim-ẹ ábẹ̀. Minna kw'kẹ Senakerib obir ọtọhm azeng-eden pẹ ẹkkaabha z'Hezekiya bẹ́, <verse eid="2KI 19:9" /><verse number="10" style="v" sid="2KI 19:10" />“Màtek Hezekiya kw'ode ọvaarnọng kw'Juda bẹ́, oning ọka f'ophe nnam ọbọhk otte ọbọhr-ẹ, ch'od-oben bẹ́, ‘Jẹrusalẹm k'mbọhk s'ọvaarnọng kw'Asiriya mòtto.’ <verse eid="2KI 19:10" /><verse number="11" style="v" sid="2KI 19:11" />K'odik ọkkọkka, kọ kk'abhaanga k'ose kw'ọvaarnọng kw'Asiriya ikk'nkọma njoza maphyir, odima. Ma, achibhẹ bẹ́, kọ wọ im'anaanga yirẹ? <verse eid="2KI 19:11" /><verse number="12" style="v" sid="2KI 19:12" />Ma, wa aka p'nkọma njo s'iwa ab'ttatta p'achi-m eden abaabha mavọhkọ, nkk'nkọma njo akkaana o, mbenẹ aka p'Gozan, ọmaana p'Haran, ọmaana p'Rẹzẹph, ọttara p'anọng p'Eden p'aning z'Tẹl-Assar? <verse eid="2KI 19:12" /><verse number="13" style="v" sid="2KI 19:13" />Ọvaarnọng kw'Hamat ọmaana kw'Arpad kẹ o? Avaar p'Lair, ọmaana p'Sẹphavayim, ọmaana p'Hẹna, ọttara p'Ivva kẹ?”<verse eid="2KI 19:13" /></para>
  <para style="s1">Njọm s'Hezekiya</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 19:14" />Hezekiya ọtọka ẹkkaabha ndo ny'azeng-eden mbo k'mbọhk oyerẹ. Nya kw'obin ofona z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọtọka ẹkkaabha ndo ọjẹ ny'ititika s'Ọvaar Ibinọkpaabyi. <verse eid="2KI 19:14" /><verse number="15" style="v" sid="2KI 19:15" />Oze njọm ọnang Ọvaar Ibinọkpaabyi bẹ́, “O Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl, kw'ọnan ẹvaar-ẹvaar ny'ottem kw'achẹrubim. Kọ-kọ wọ ade Ibinọkpaabyi kw'ọbaabh nkọma s'iyagbin maphyir. Kọ wọ asi ẹrọng ọmaana izek. <verse eid="2KI 19:15" /><verse number="16" style="v" sid="2KI 19:16" />O Ọvaar Ibinọkpaabyi, yonga itọhng abhaanga mawuriji, abir awonga achen pọ aze ẹkkaabha ch'Senakerib ọtọhmọ bẹ́, otima olukọ kọ Ibinọkpaabyi kw'oruk akpen.<verse eid="2KI 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 19:17" />“O Ọvaar Ibinọkpaabyi, ode majijik bẹ́, ọvaarnọng kw'Asiriya kk'nkọma njoza ọmaana izek sabẹ itama ọsa. <verse eid="2KI 19:17" /><verse number="18" style="v" sid="2KI 19:18" />Bẹ nkk'aka pabẹ akwọma k'ekpon, mabir avọhkọ bẹ, okurọ bẹ́, wa bẹ m'Ibinọkpaabyi kade. Makenka ade nchi, ọmaana ata p'oyokinọng otim mbọhk, osi. <verse eid="2KI 19:18" /><verse number="19" style="v" sid="2KI 19:19" />Ofona nya, o Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwamina, kkaana, arọhbha mina k'mbọhk sẹ, ọfha nkọma s'iyagbin maphyir izonga bẹ́, kọ Ọvaar Ibinọkpaabyi, kọ-kọ wọ ade Ibinọkpaabyi.”<verse eid="2KI 19:19" /></para>
  <para style="s1">Izaya oze ose kw'Senakerib m'otto</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 19:20" />Nya o, Izaya kw'ode nnwa kw'Amos, ọtọhm ẹkkaabha ọnang Hezekiya bẹ: “Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl ọgbaakẹ: Kaam k'njọm sọ s'imaan Senakerib kw'ode ọvaarnọng kw'Asiriya, mmaanga. <verse eid="2KI 19:20" /><verse number="21" style="v" sid="2KI 19:21" />Ọgbaakadik kw'Ọvaar Ibinọkpaabyi ikk'ọgbaaka kw'ọmaan Senakerib ode bẹ́:</para>
  <para style="q1" vid="2KI 19:21">“ ‘Zayọn kw'ode okwura-kwura</para>
  <para style="q2" vid="2KI 19:21">oluk-ọ olukọ, obir ọmmọ-ọ asa.</para>
  <para style="q1" vid="2KI 19:21">Ominanwa kw'ode Jẹrusalẹm</para>
  <para style="q2" vid="2KI 19:21">owokọ eso chẹ k'ose kw'ikọ arọbhọ.<verse eid="2KI 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2KI 19:22" />Bọng-ọnọng wọ kw'kọ ad-alọhkọ,</para>
  <para style="q2" vid="2KI 19:22">abir apyina eche?</para>
  <para style="q1" vid="2KI 19:22">Anyi wọ kw'ikọ ad-atima k'ẹmma, abir annenẹ?</para>
  <para style="q2" vid="2KI 19:22">Ibinọkpaabyi kw'Awuriji kw'Israẹl wọ yirẹ?<verse eid="2KI 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2KI 19:23" />Kk'azeng-eden pọ atima alọhkọ Ọvaar Ibinọkpaabyi.</para>
  <para style="q2" vid="2KI 19:23">Kk'abir abena bẹ́,</para>
  <para style="q1" vid="2KI 19:23">“Kk'ijaar saam s'nnyanya id-itọr k'ọsaabh,</para>
  <para style="q2" vid="2KI 19:23">ntima mvura agbeso p'agor-ogorọ,</para>
  <para style="q1" vid="2KI 19:23">p'ade agbeso p'agorọ ọtam ny'Lẹbanọn.</para>
  <para style="q2" vid="2KI 19:23">Kaam kk'sida-chi s'igorọ ọtam nkkọhbha mmarẹ k'izek,</para>
  <para style="q1" vid="2KI 19:23">ọttara nchi s'junipa s'ijibhẹ ọtam.</para>
  <para style="q2" vid="2KI 19:23">Kaam kk'mbir mpyira z'ẹtaang-ẹtaanga kw'ẹtam ch'Lẹbanọn,</para>
  <para style="q2" vid="2KI 19:23">ch'ede ẹtam ch'ejibhẹ ẹyọhnga ayok.<verse eid="2KI 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2KI 19:24" />Kaam kk'nsipe ntuma z'nkọma ọdọk-ọdọk,</para>
  <para style="q2" vid="2KI 19:24">mbir ngwo asi nya.</para>
  <para style="q1" vid="2KI 19:24">Kk'mmokpatọkọ saam</para>
  <para style="q2" vid="2KI 19:24">ntima nsi nkeka s'Ijip, igwu maphyir.”<verse eid="2KI 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2KI 19:25" />“ ‘Kọ odik nwo atim abhaanga o?</para>
  <para style="q2" vid="2KI 19:25">Ogbe kk'obhira kw'nsi wẹ nsok minna;</para>
  <para style="q1" vid="2KI 19:25">Wa k'ẹtama kw'mphyikẹ nsok minna;</para>
  <para style="q2" vid="2KI 19:25">ma, n'nsi wẹ ode minna</para>
  <para style="q1" vid="2KI 19:25">bẹ́, kọ k'ibhondim s'ide ọfa-byi abhaka,</para>
  <para style="q2" vid="2KI 19:25">nide ata-kkin.<verse eid="2KI 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2KI 19:26" />Anọng pabẹ p'ẹfa ikk'bẹ ẹsa,</para>
  <para style="q2" vid="2KI 19:26">maninga kk'oforpyibha, ọttara k'mgbar.</para>
  <para style="q1" vid="2KI 19:26">Bẹ made mach'ekpo py'owonọ,</para>
  <para style="q2" vid="2KI 19:26">py'ẹram omimen,</para>
  <para style="q1" vid="2KI 19:26">ọmaana mach'azizaarẹ p'amenẹ z'ipubhaang</para>
  <para style="q2" vid="2KI 19:26">p'echekira esi bẹ, mayọhna.<verse eid="2KI 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2KI 19:27" />“ ‘Okenaka, kaam nzong ibyi s'aning ma,</para>
  <para style="q2" vid="2KI 19:27">mbir nzonga ogbe kw'akwu, ọmaana ogbe kw'afon,</para>
  <para style="q2" vid="2KI 19:27">ọttara ose kw'ettem epyibh-ọ ẹmaan-m.<verse eid="2KI 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2KI 19:28" />Ch'ettem ikk'ọ epyibha ẹmaan-m minna,</para>
  <para style="q2" vid="2KI 19:28">ọmaan ch'ẹnọng-myaana chọ ikk'aam ẹtta k'itọhng,</para>
  <para style="q1" vid="2KI 19:28">kaam m'mgban-ọ aga kwaam ny'ikọ k'isung,</para>
  <para style="q2" vid="2KI 19:28">mbir nke odik-pe kwaam ny'ẹmma chọ,</para>
  <para style="q1" vid="2KI 19:28">Kaam m'nsọ-ọ, akpa nnam</para>
  <para style="q2" vid="2KI 19:28">z'eden ch'azeng akwu.’<verse eid="2KI 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 19:29" />“Kọ Hezekiya, ẹkọhka ch'im'nsi nnang-ọ ede bẹ́:</para>
  <para style="q1" vid="2KI 19:29">“M'icho nwa, kọ m'achi ekpo py'ẹbhọk-ọbhọk,</para>
  <para style="q2" vid="2KI 19:29">ottong icho ifa, kọ m'abir achi ekpo py'ekwurọ nya.</para>
  <para style="q1" vid="2KI 19:29">“Ṉ́nòde icho kw'ottong ittaan, kọ zeng mmo gbon ekpo, abir apha,</para>
  <para style="q2" vid="2KI 19:29">Tubh iwonọ s'agrep, abir achi achiduk p'afon nya.<verse eid="2KI 19:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2KI 19:30" />Bọnga mbo p'marik-orik, p'manaang ny'ọsọhm kw'Juda,</para>
  <para style="q2" vid="2KI 19:30">mm'attima ẹranga z'izek, obir ojibh ọnang bọnga.<verse eid="2KI 19:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="2KI 19:31" />Anọng p'arik-orik m'abina z'Jẹrusalẹm,</para>
  <para style="q2" vid="2KI 19:31">ọmaana z'egbe ch'Zayọn k'ọsaabh.</para>
  <para style="m" vid="2KI 19:31">“Ọvaar Ibinọkpaabyi kw'ẹfa mapyhir, kw'od-ochera obo k'idik, kk'obena bẹ́, m'osi minna.<verse eid="2KI 19:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="2KI 19:32" />“Ofona nya, odik kw'Ọvaar Ibinọkpaabyi ọgbaakẹ kw'ọmaan ọvaarnọng kw'Asiriya ode bẹ́:</para>
  <para style="q1" vid="2KI 19:32">“ ‘Kẹ m'ebhondim nda, mòdim,</para>
  <para style="q2" vid="2KI 19:32">oyuk kwẹ, nya mọtta.</para>
  <para style="q1" vid="2KI 19:32">Ogbongtergba mòtima odim nya,</para>
  <para style="q2" vid="2KI 19:32">egbong nya mobir oyima.<verse eid="2KI 19:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2KI 19:33" />Ọvaar Ibinọkpaabyi kk'obena bẹ́, ny'eden ndo ch'ozeng okwu, nya kw'im'obir ozenga, ọkpa nnam;</para>
  <para style="q2" vid="2KI 19:33">kẹ m'ebhondim ndoma, mòdim.<verse eid="2KI 19:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2KI 19:34" />Kaam m'nzenga Eche chaam ábubẹ̀, ọmaana ch'Devid kw'ode ọtọhmnọng kwaam,</para>
  <para style="q2" vid="2KI 19:34">nkaam ebhondim nda, mbir nkkaana dẹ.’ ”<verse eid="2KI 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 19:35" />Ny'orungiwu nwo, ozeng-eden kw'Ọvaar Ibinọkpaabyi ochina z'ibhinga-byi s'anọng p'Asiriya, ọfhọ anọng nnọhna arọbh afa okwuma nchadanẹ okwuma arọbh ijobh okwuma ijobh. Ch'anọng p'Asiriya aphyabh ny'ekpebha o, nnaze affuranọng bẹ-bẹ k'ibyi kpenamkpen. <verse eid="2KI 19:35" /><verse number="36" style="v" sid="2KI 19:36" />Minna kw'ọvaar Senakerib kw'Asiriya obikẹ ny'ibhinga-byi njo. Ọkpa nnam, od-oruk z'Ninẹvẹ.<verse eid="2KI 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 19:37" />K'ewu danẹ, ch'Senakerib oning nya okpobh Nisrok kw'ode ọka fẹ ny'ọkasọhm, Adramẹlẹk, ọmaana Sharẹzẹ p'ade ajinọngva pẹ, matima ọkkangkkang akebh-ẹ nya, mafhẹ-ẹ. Marọbh achina z'ẹkọma ch'Ararat. Esarhadọn kw'ode ojinọngnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 19:37" /></para>
  <chapter eid="2KI 19" />
  <chapter number="20" style="c" sid="2KI 20" />
  <para style="s1">Hezekiya otto ọkọhmaana</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 20:1" />Wa ny'ogbe nwo, Hezekiya okwu otto obo-kọhmaana. Izaya kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, kw'ode nnwa kw'Amos, ofona od-oben-ẹ bẹ́, “Ọvaar Ibinọkpaabyi obenẹ bẹ́: M'atobha ọsọhm kwọ oninga k'ọkkọkka, okurọ bẹ́, m'apope e; ọkọhmaana mva, manaanga.”<verse eid="2KI 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 20:2" />Minna kw'Hezekiya ọbhakẹ okkerẹ etumọ, oze njọm ọnang Ọvaar Ibinọkpaabyi, oben bẹ́, <verse eid="2KI 20:2" /><verse number="3" style="v" sid="2KI 20:3" />“O Ọvaar Ibinọkpaabyi, jima ose kw'kaam ikk'ọ mkpobha k'ọkkọkka, ọttara ose kw'ntim ettem chaam nsi ejibha ch'atim achen pọ aze.” Hezekiya obhom ẹmọng mawuriji.<verse eid="2KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 20:4" />Pira Izaya obina ny'ottem kw'eterttem ndo, Ọvaar Ibinọkpaabyi oben-ẹ bẹ́: <verse eid="2KI 20:4" /><verse number="5" style="v" sid="2KI 20:5" />“Kpa nnam, ad-atek Hezekiya kw'ọbaabh anọng paam bẹ́, ‘Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Devid kw'ode atte kwọ, obenẹ bẹ́, kaam kk'njọm sọ mmaanga, mbir nze asen pọ; kaam m'nsọ-ọ abina ny'ọkọhmaana mvo. K'ewu ch'ettong ittaan tọma menda, kọ m'ata z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 20:5" /><verse number="6" style="v" sid="2KI 20:6" />Kaam m'nttar-ọ icho minna ichi k'akpen pọ. Kaam m'nkkaana kọ ọmaana ebhondim nda k'mbọhk s'ọvaarnọng kw'Asiriya. M'mbir nkaam ebhondim ndoma k'eche chaam, ọmaana k'eche ch'Devid kw'ode ọtọhmnọng kwaam.’ ”<verse eid="2KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 20:7" />Nya o, Izaya oben atọhmnọng p'ọvaarnọng bẹ́, “Màtima achiduk p'fig, màsi echiranga.” Wa bẹ masi minna. Matọka afok-ẹ nya aphyi mbo. Minna kw'obin ny'ọkọhmaana mvo.<verse eid="2KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 20:8" />Wa Hezekiya kk'Izaya ọbọbha bẹ́, “Bọng-ọttọhk vọ im'ode ẹkọhka bẹ́, Ọvaar Ibinọkpaabyi m'obin-m m'ọkọhmaana mva, ọmaana ch'obenẹ bẹ́, kaam m'nta z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, k'ewu ch'ettong ittaan, tọma menda o?”<verse eid="2KI 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 20:9" />Ofona nya, Izaya ọpọhn-ẹ bẹ́, “Ma wọ ode ẹkọhka ch'Ọvaar Ibinọkpaabyi ikk'ocheka ọmaan-ọ bẹ́, Ọvaar Ibinọkpaabyi m'osi ọttọhk f'ikk'ọnwọhnga: Ma, ọgbagba m'otima ntọkọ ijobh ochina ititika, wanẹma, m'otima ntọkọ ijobh ochina nnam-nnam yirẹ?”<verse eid="2KI 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 20:10" />Hezekiya oben bẹ́, “Ode ọttọhk f'ọmọm-ọmọm bẹ́, ọgbagba otima ntọkọ ijobh, ochina ititika. Kọmọmọ bẹ́, obir otima ntọkọ ijobh ochina nnam-nnam.”<verse eid="2KI 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 20:11" />Nya o, Izaya kw'ode ọgbaak-ettem ch'Ọvaar Ibinọkpaabyi oze njọm oyerẹ Ọvaar Ibinọkpaabyi. Minna kw'Ọvaar Ibinọkpaabyi osi ọgbagba nwo ochina nnam-nnam ntọkọ ijobh otima ọsaka abhukakpa p'ọsọhm kw'Ahaz.<verse eid="2KI 20:11" /></para>
  <para style="s1">Azeng-eden p'afon z'Babilọn</para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 20:12" />Ny'ogbe nwo, Marduk-Baladan kw'ode nnwa kw'ọvaar Baladan kw'Babilọn, ọtọhm ẹkkaabha ọmaana ẹnaanga ochena Hezekiya, okurọ ch'ọbhaang ọkọhmaana f'Hezekiya. <verse eid="2KI 20:12" /><verse number="13" style="v" sid="2KI 20:13" />Hezekiya olobh azeng-eden mbo, ọd-ọkọhka bẹ ekpo mapyhir py'ening ny'ọsọhm kw'nd-aye ekpo py'ejibh-ojibh mach'silva, ọmaana gol, ọmaana ekpo py'elebh eruk, ọttara ana p'oliv. Obir otima bẹ ọd-ọkọhka egbongkpo, ọmaana ọttọhk kpenamkpen f'ọbarẹ odik. Ọttọhk kode f'oning ny'ọvaarsọhm kw'Hezekiya, ọmaana ny'ebhondim chẹ, f'uwa ina anọng mbo, ọkọhk.<verse eid="2KI 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 20:14" />Ofona nya, Izaya kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, obina od-okebha Hezekiya kw'ode ọvaarnọng, ọbọbh-ẹ bẹ́, “Bọng-odik kw'ajinọng mbo, abenẹ? Bọng-ẹbhaakẹ ch'mabin akwu?</para>
  <para style="p" vid="2KI 20:14">Hezekiya ọpọhn-ẹ bẹ́, “Mafon z'ẹkọma ch'ebhir-obhir.”<verse eid="2KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 20:15" />Izaya ọbọbh-ẹ bẹ́, “Bọng-ọttọhk f'anọng mbo aze ny'ọvaarsọhm kwọ o?”</para>
  <para style="p" vid="2KI 20:15">Hezekiya oben bẹ́, “Maze ọttọhk kpenamkpen f'oning ny'ọvaarsọhm kwaam. Ọttọhk kode f'ọbar-m odik, f'ina bẹ nkọhk.”<verse eid="2KI 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 20:16" />Nya o, Izaya oben Hezekiya bẹ́, “Bhaanga ọgbaakadik kw'Ọvaar Ibinọkpaabyi: <verse eid="2KI 20:16" /><verse number="17" style="v" sid="2KI 20:17" />K'odik ọkkọkka, ogbe okwuma kw'mm'atọka ọttọhk kpenamkpen f'oning ny'ọvaardimpa kwọ, ọmaana ekpo py'ab'atte p'achi eden abaabha nkk'aya maa, pyirẹ menda, matima afona z'Babilọn. Ọvaar Ibinọkpaabyi ọgbaakẹ bẹ́, ọttọhk f'im'orik-orik nya, kode. <verse eid="2KI 20:17" /><verse number="18" style="v" sid="2KI 20:18" />Iva banẹ p'iva pọ, p'ade izẹ sọ oyenẹ, p'mm'amaan anang-ọ, mm'atọka bẹ, atima afona, mad-ade anọng p'mabhaar-ọbhaar z'ọvaardimpa kw'ọvaarnọng kw'Babilọn.”<verse eid="2KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 20:19" />Hezekiya oben bẹ́, “Ẹkkaabha nda ch'Ọvaar Ibinọkpaabyi ch'agbaak ma, ejibh-ojibh.” Wa ofon ch'Hezekiya ochibhẹ bẹ́, “Kaam m'nyena ẹmẹm ọmaana odiriji m'akpen paam.”<verse eid="2KI 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 20:20" />Idik njoza s'iyinẹ k'ogbe kw'Hezekiya ọbaabh, ọmaana idik s'osi maphyir, ọmaana oyena kwẹ, ozeng k'ose kw'otumọ esipe, ọmaana ebhobh ch'etim asi edim z'ebhondim, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 20:20" /><verse number="21" style="v" sid="2KI 20:21" />Wa Hezekiya okwu ope otor ab'otte za. Manasẹ kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 20:21" /></para>
  <chapter eid="2KI 20" />
  <chapter number="21" style="c" sid="2KI 21" />
  <para style="s1">Manasẹ otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 21:1" />Wa Manasẹ ode icho ijobh kkamfa ch'ọtọm ẹbaabha. Oninga z'Jẹrusalẹm ọbaabha k'icho arọbh afa okwuma ichi. Wa ọkka kwẹ okpen Hephziba. <verse eid="2KI 21:1" /><verse number="2" style="v" sid="2KI 21:2" />Wa osi itama z'Ọvaar Ibinọkpaabyi k'ititika. Adiktama p'uwa nkọma s'Ọvaar Ibinọkpaabyi okwubhọ pira anọng p'Israẹl apyirẹ, bẹ bọ p'uwa od-osi. <verse eid="2KI 21:2" /><verse number="3" style="v" sid="2KI 21:3" />Wa obir ọtọm-ọtọma osi ọja-byi mvo f'ọyaankpa f'uwa Hezekiya kw'ode otte, ikk'ọvọhka maphyir. Obir osi ọja-byi f'Baal, ọmaana ẹka-chi ch'Ashẹra, k'ose kw'Ahab kw'uwa ọbaabh Israẹl, osi. Obir ọd-ọraka eso ọnang ekpo maphyir py'ọrọngkpakpa, obir okpobha byẹ. <verse eid="2KI 21:3" /><verse number="4" style="v" sid="2KI 21:4" />Ochina z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, osi ọja-byi za ch'Ọvaar Ibinọkpaabyi kk'obena bẹ́, ‘M'Jẹrusalẹm kw'mmin'aninga akpobha Eche chaam.’ <verse eid="2KI 21:4" /><verse number="5" style="v" sid="2KI 21:5" />Ny'iterttem njo ifa s'osi ny'Ọsọhm kw'Ibinọkpaabyi, wa obir osi ọja-byi f'ekpo py'ọrọngkpakpa maphyir. <verse eid="2KI 21:5" /><verse number="6" style="v" sid="2KI 21:6" />Ọkwọmọ nnwa kwẹ oyenẹ k'ekpon, otim-ẹ ọfọhnọ ẹja. Osi ẹbọhk, ọmaana nchibhẹ, od-okebha abọhnganọng ọmaana anọng p'aze iyaan, ọd-ọbọbh bẹ idik. Osi itama s'ikem ẹsaabha z'Ọvaar Ibinọkpaabyi k'ititika, s'id-iwọhkọ ettem epyibh Ibinọkpaabyi.<verse eid="2KI 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 21:7" />Ẹka-chi ndo ch'Ashẹra ch'ikk'ọsa, ọtọka osok z'Ọsọhm kw'Ibinọkpaabyi, chibhẹ ch'iwa Ọvaar Ibinọkpaabyi obenẹ Devid ọmaana nnwa kwẹ Sọlọmọn bẹ́, “Ma mfona s'Israẹl maphyir, kaam kk'Ọsọhm nwa kw'Ibinọkpaabyi, ọmaana Jẹrusalẹm nteka bẹ́, nya kw'mm'aninga akpobha Eche chaam ttattampe. <verse eid="2KI 21:7" /><verse number="8" style="v" sid="2KI 21:8" />Kaam ọdọk anọng p'Israẹl ọbọhk mìntte mabina arik izek nja, machina ororo attena m'izek s'iwa nnang ab'ttatta pabẹ, óde bẹ mm'azonga ifor sabẹ, masi ọttọhk kpenamkpen f'mbenẹ bẹ bẹ́, masi, mabir akpobha asana p'Moses kw'ode ọtọhmnọng kwaam ọnang bẹ.” <verse eid="2KI 21:8" /><verse number="9" style="v" sid="2KI 21:9" />Okenaka, wa anọng mbo m'itọhng kayong. Manasẹ otima bẹ ottena eden, ọwọhkọ bẹ masi itama s'iyọhng njo s'iwa nkọma njo s'Ọvaar Ibinọkpaabyi okwubhọ ny'Israẹl, isi.<verse eid="2KI 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 21:10" />Ọvaar Ibinọkpaabyi otima atọhmnọng p'ad-agbaak ettem chẹ oben bẹ́, <verse eid="2KI 21:10" /><verse number="11" style="v" sid="2KI 21:11" />“Ọvaar Manasẹ kw'Juda kk'itama siden ọsa. Kk'itama s'iyọhng njo s'anọng p'Amọr p'acheden aninga m'ibyi nja, ọsa, ọwọhkọ Juda otor-ẹ ny'itama s'aka pẹ okpukpobha. <verse eid="2KI 21:11" /><verse number="12" style="v" sid="2KI 21:12" />Ofona nya, Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl obenẹ bẹ́, kaam m'ntima itama s'ina ebena ide, ndim ny'Jẹrusalẹm ọmaana Juda. Ọnọng kpenamkpen kw'ọbhaang itama kirase njo, m'okkon-ẹ. <verse eid="2KI 21:12" /><verse number="13" style="v" sid="2KI 21:13" />Eden ndo ch'nzeng mkpaara aponga p'Samariya, ọmaana p'echimma ch'Ahab, dẹ dọ ch'm'mbir ntima ntor Jẹrusalẹm. K'ose kw'ọnọng ọd-ọfọhnọ ọgbangbang maa, ọttọhk morik, minna kw'kaam m'ndimẹ Jẹrusalẹm kibung-kibungọ. M'ndimẹ wẹ maa, mbhak-ẹ abherekpa afa. <verse eid="2KI 21:13" /><verse number="14" style="v" sid="2KI 21:14" />Kaam m'mbhum ayok mbo p'ade oyena kwaam p'arik-orik. M'ntte bẹ ọbọhk nnang awawunanọng pabẹ. Awawunanọng mbo maphyir m'ana bẹ ọttọhk kpenamkpen f'mayen maa, marik bẹ abọhk-kpakpa. <verse eid="2KI 21:14" /><verse number="15" style="v" sid="2KI 21:15" />Tọma z'ewu ch'ab'ttata pabẹ abin arik Ijip, maa pyirẹ m'ewu ch'menda, bẹ nkk'itama asa m'kaam k'ititika maa, nkk'ottempyibha kwaam ayema.<verse eid="2KI 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 21:16" />Manasẹ ọdọk, kk'anọng saabhada obir ọfha maa, Jẹrusalẹm node izizẹ tọma k'eso danẹ, pyirẹ z'eso ndoza, gbaarẹ epyibha ndoza ch'ọwọhkọ anọng p'Juda masi, obir ọwọhkọ bẹ, masi itama z'Ọvaar Ibinọkpaabyi k'ititika.<verse eid="2KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 21:17" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Manasẹ ọbaabh, ọmaana idik s'osi, ọttara epyibha ch'osi, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 21:17" /><verse number="18" style="v" sid="2KI 21:18" />Minna kw'uwa Manasẹ ope otor ab'otte za. Manọhng-ẹ z'ewoniva ch'odimpa kwẹ, ch'ening z'Uza. Amọn kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 21:18" /></para>
  <para style="s1">Amọn otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 21:19" />Wa Amọn ode icho ẹrọbh okwuma ifa ch'masẹ-ẹ ẹvaar. Oninga z'Jẹrusalẹm ọbaabha k'icho ifa. Wa ọkka kwẹ okpen Meshulemet kw'ode kwanọngnwa kw'Haruz kw'ofon Jotba. <verse eid="2KI 21:19" /><verse number="20" style="v" sid="2KI 21:20" />Wa Amọn osi itama k'ititika s'Ọvaar Ibinọkpaabyi mach'iwa Manasẹ kw'ode otte, osi. <verse eid="2KI 21:20" /><verse number="21" style="v" sid="2KI 21:21" />Wa otorọ ntọkọ s'otte kibung-kibungọ, od-okpobha aka mbo p'uwa otte okpobh, obir ọraka eso ọnang bẹ. <verse eid="2KI 21:21" /><verse number="22" style="v" sid="2KI 21:22" />Minna kw'uwa obhumọ Ọvaar Ibinọkpaabyi kw'ab'ttatta pẹ. Ibinọkpaabyi nwo, kọbir okpobha.<verse eid="2KI 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 21:23" />Adukwa p'Amọn, makwu achẹ-ẹ ikwu, mafhẹ-ẹ ny'odimpa kwẹ. <verse eid="2KI 21:23" /><verse number="24" style="v" sid="2KI 21:24" />Anọng p'Juda abina k'ẹrọng, mafhọ anọng mbo maphyir p'machi ọvaar Amọn ikwu, pira mafhẹ-ẹ. Makwu atọka ẹvaar anang Josaya kw'ode nnwa kw'Amọn.<verse eid="2KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 21:25" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Amọn ọbaabh, ọmaana idik s'osi, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 21:25" /><verse number="26" style="v" sid="2KI 21:26" />Wa manọhng-ẹ z'epekwubh ch'ewoniva ch'Uza. Josaya kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 21:26" /></para>
  <chapter eid="2KI 21" />
  <chapter number="22" style="c" sid="2KI 22" />
  <para style="s1">Josaya ọbaabh Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 22:1" />Wa Josaya ode icho ochenọnttaan k'ogbe kw'masẹ-ẹ ẹvaar. Oninga z'Jẹrusalẹm ọbaabha k'icho ẹrọbh okwuma ijobh kawanẹ. Ọkka kwẹ okpen Jedida, kw'ode kwanọngnwa kw'Adaya kw'ofon Boska. <verse eid="2KI 22:1" /><verse number="2" style="v" sid="2KI 22:2" />Wa osi idik s'idaakẹ Ọvaar Ibinọkpaabyi, obir otor ntọkọ s'Devid kw'ode otte kwẹ k'eden kpenamkpen. Wa nnam kọkpa ọbọra idik ọkkọkka osisi.<verse eid="2KI 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 22:3" />Ny'icho ttong ichi kkanttaan s'ọbaabh, ọvaar Josaya ọtọhm Shafan kw'ode ọkkẹrẹ z'Ọsọhm kw'Ibinọkpaabyi. Azaliya kw'ode nnwa kw'Meshulam wọ obhonọ Shafan. Josaya oben-ẹ bẹ́, <verse eid="2KI 22:3" /><verse number="4" style="v" sid="2KI 22:4" />“Zọhng kebha Hilkiya kw'ode ọfọhn-ẹja kwiden, aben-ẹ bẹ́, obhik akpuka mbo p'matim akwu z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, kw'ode akpuka p'akker-ẹsọhmma nkk'atọka z'anọng k'mbọhk. <verse eid="2KI 22:4" /><verse number="5" style="v" sid="2KI 22:5" />Tte matọka akpuka mbo anang anọng p'marọhbh bẹ́, makkerẹ ọtọhm f'Ọsọhm kw'Ibinọkpaabyi. Tte akker-ọtọhm mbo anang anọng p'ad-ado Ọsọhm nwo kw'Ibinọkpaabyi akpuka. <verse eid="2KI 22:5" /><verse number="6" style="v" sid="2KI 22:6" />Atọhmnọng mbo ade amin-agbaaka, ayik-isọhm ọmaana abẹ-isọhm. Tte mabir adebh nchi s'agbaaka, ọmaana ata p'madok-odoka p'mm'atima ado Ọsọhm kw'Ibinọkpaabyi. <verse eid="2KI 22:6" /><verse number="7" style="v" sid="2KI 22:7" />Okenaka, tte ọnọng oning bẹ oyerẹ bẹ́, makwu anang obhik f'akpuka mbo p'manang bẹ, okurọ bẹ́, bẹ mator-otor k'osisi kwabẹ.”<verse eid="2KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 22:8" />Hilkiya kw'ode ọfọhn-ẹja oben Shafan kw'ode ọkkẹrẹ bẹ́, “Kk'Nnwẹr kw'Apaanga nza z'Ọsọhm kw'Ibinọkpaabyi.” Hilkiya ọtọka wẹ ọnang Shafan, oyerẹ. <verse eid="2KI 22:8" /><verse number="9" style="v" sid="2KI 22:9" />Shafan kw'ode ọkkẹrẹ obina ozeng z'ọvaarnọng, od-otek-ẹ bẹ́, “Adukwa pọ kk'akpuka p'aning z'Ọsọhm kw'Ibinọkpaabyi atọka anang anọng p'asi ọtọhm, ọmaana ayok p'akkerẹ ọtọhm ny'Ọsọhm kw'Ibinọkpaabyi.” <verse eid="2KI 22:9" /><verse number="10" style="v" sid="2KI 22:10" />Nya o, Shafan kw'ode ọkkẹrẹ otek ọvaar Josaya bẹ́, “Hilkiya kw'ode ọfọhn-ẹja kk'aam nnwẹr ọnanga e.” Shafan oyerẹ nnwẹr nwo ny'ọvaarnọng k'ititika.<verse eid="2KI 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 22:11" />K'ogbe kw'ọvaarnọng ọbhaang idik s'Nnwẹr nwo kw'Apaanga, ọyaakẹ ekpo py'ọfọr ny'ifor. <verse eid="2KI 22:11" /><verse number="12" style="v" sid="2KI 22:12" />Ọvaarnọng oben Hilkiya kw'ode ọfọhn-ẹja, ọmaana Ahikam kw'ode nnwa kw'Shafan, ọmaana Akọr kw'ode nnwa kw'Mikaya, ọmaana Shafan kw'ode ọkkẹrẹ, ọttara Asaya kw'ode ọtọhmnọng kw'ọvaarnọng bẹ́, <verse eid="2KI 22:12" /><verse number="13" style="v" sid="2KI 22:13" />“Màzọhng bọbh Ọvaar Ibinọkpaabyi odik kw'ọmaan idik s'nnwẹr nwa kw'nkk'ọza. Màbọbh-ẹ k'eso chaam, ọmaana k'eso ch'anọng mba, ọttara k'eso ch'Juda maphyir. Kirẹ, ottempyibha kw'Ọvaar Ibinọkpaabyi kw'mayemẹ, kẹ kw'im'otima otor mina, okurọ ch'ab'ttatta p'achi mina eden, nna idik s'makkẹrẹ m'nnwẹr nwa s'maan mina, akpobh.”<verse eid="2KI 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 22:14" />Hilkiya kw'ode ọfọhn-ẹja, ọmaana Ahikam, ọmaana Akbọr, ọmaana Shafan, ọttara Asaiya, mafona, mad-akebha Hulda kw'ode ọgbaak-ettem ch'Ibinọkpaabyi k'ẹpanọng, magbaak odik amaan-ẹ. Hulda wọ uwa ode kwanọng kw'Shalum, kw'Tikva obhonọ kw'ode nnwa kw'Harhas kw'od-okkerẹ ibyi s'ẹfọrakpo py'Ọsọhm kw'Ibinọkpaabyi. Wa kẹ orukọ z'Ẹkọma Ẹbhachẹ ch'Jẹrusalẹm.<verse eid="2KI 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 22:15" />Kwanọng nwo oben bẹ bẹ́, “Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl obenẹ bẹ́, ‘Tek ojinọng kw'ọtọhm-ọ bẹ́, <verse eid="2KI 22:15" /><verse number="16" style="v" sid="2KI 22:16" />Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, Kaam m'ntọhm itama nnang m'obhon nwa ọmaana anọng p'arukọ ma, k'ose kw'ọvaarnọng kw'Juda kk'ọttọhk kpenamkpen f'makkẹrẹ m'nnwẹr nwoma, oyera. <verse eid="2KI 22:16" /><verse number="17" style="v" sid="2KI 22:17" />Ch'anọng mba nkk'aam abhuma, mabir akwọmọ insẹns anang aka, bẹ nkk'ottempyibh kwaam ayema okurọ aka pabẹ maphyir p'matim mbọhk, asi. Ottempyibha kwaam ọmaana anọng mba, ẹkpọka moyena.’ <verse eid="2KI 22:17" /><verse number="18" style="v" sid="2KI 22:18" />Ṉ́nòde ọvaarnọng kw'Juda kw'ọtọhm-ọ bẹ́, akwu abọbh Ọvaar Ibinọkpaabyi odik, tek-ẹ bẹ́, ‘Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl ọgbaakẹ ọmaana idik s'nkk'abhaanga: <verse eid="2KI 22:18" /><verse number="19" style="v" sid="2KI 22:19" />ch'bọnga masẹr-ọsẹr atin mpyibha sabọnga, mabir asaka ifor sabọnga z'Ibinọkpaabyi k'ititika ch'mabhaang itama s'mgbaakẹ mmaana ibyi nja, ọmaana anọng p'aning ma, ch'nnang bẹ ẹmma, mbir mben bẹ́, nk'eden mayin, ch'mpyibha sabọnga ibir isi bọnga okwo maa, mabhom amọng m'kaam k'ititika, kaam Ọvaar Ibinọkpaabyi kk'ẹmọng chabọnga mbir mmaanga. <verse eid="2KI 22:19" /><verse number="20" style="v" sid="2KI 22:20" />Ofona nya, kaam m'ntobha bọnga k'ose kw'mm'ator ab'ttatta pabọnga, manọhnga bọnga k'ẹmẹm. Achen pabọnga itama maphyir s'm'ntima ndim m'ibyi nja, maze.’ ” Minna kw'matọk ẹkkaabha ndo achena ọvaar Josaya.<verse eid="2KI 22:20" /></para>
  <chapter eid="2KI 22" />
  <chapter number="23" style="c" sid="2KI 23" />
  <para style="s1">Josaya obhon idik</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 23:1" />Nya o, ọvaarnọng oyerẹ ọkwa kw'asogbọhkọnọng maphyir p'Juda ọmaana p'Jẹrusalẹm. <verse eid="2KI 23:1" /><verse number="2" style="v" sid="2KI 23:2" />Otima anọng p'Juda, ọmaana anọng p'Jẹrusalẹm, ọmaana afọhn-ẹja, ọmaana agbaak-ettem ch'Ibinọkpaabyi, ọttara anọng mboza maphyir, tọma z'ayok p'kperede, pyirẹ z'ayok piden, ochina z'Ọsọhm kw'Ibinọkpaabyi. Oyerẹ idik maphyir s'makkẹrẹ z'nnwẹr kw'echekẹ kw'maze z'Ọsọhm kw'Ọvaar Ibinọkpaabyi ọnang bẹ, mabhaanga. <verse eid="2KI 23:2" /><verse number="3" style="v" sid="2KI 23:3" />Ọvaarnọng obe otuma ẹkpọmmachi, osi echekẹ ẹbhachẹ ny'Ọvaar Ibinọkpaabyi k'ititika bẹ́, kẹ m'otima ettem chẹ maphyir, ọmaana ọgbagba kwẹ maphyir otor Ọvaar Ibinọkpaabyi, obir okpobha asana pẹ, ọmaana okpebhẹ kwẹ, ọttara apaanga pẹ. M'ofona nya, idik s'echekẹ s'makkẹrẹ m'nnwẹr nwa, m'iyin minna k'odik ọkkọkka. Nya o, anọng mbo maphyir make ọbọhk ny'echekẹ ndo.<verse eid="2KI 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 23:4" />Ọvaarnọng oben Hilkiya kw'ode ọfọhn-ẹja kwiden, ọmaana afọhn-ẹja mboza p'ator-ẹ k'nnam, ọmaana ayok p'akkerẹ ẹsọhmma bẹ́, machina z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, mad-arọhbha ekpo maphyir py'mad-atima akpobha Baal, ọmaana Ashẹra, ọttara ekpo py'ọrọngkpakpa. Ọkwọmọ pyẹ z'mbọr-mbọr s'Jẹrusalẹm, z'ẹgba, z'ilokodo s'Kidrọn. Otima ititọhng njo, ochina z'Bẹtẹl. <verse eid="2KI 23:4" /><verse number="5" style="v" sid="2KI 23:5" />Okwubh afọhn-ẹja mbo p'aka maphyir p'ọvaarnọng kw'Juda ọrọhbh bẹ́, makwọmọ insẹns z'ọja-byi f'ọyaankpa z'ibhondim s'Juda, ọmaana njo s'nyọm Jẹrusalẹm. Wa afọhn-ẹja mbo ad-afọhnọ nja z'ogbe nwo anang Baal, ọmaana echekira, ọmaana ophe, ọttara ekpo py'ening z'ọrọngkpakpa. <verse eid="2KI 23:5" /><verse number="6" style="v" sid="2KI 23:6" />Ọvaarnọng ọrọhbha ẹka-chi ch'Ashẹra z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, otima oyin z'iyaan kw'Jẹrusalẹm, z'ilokodo s'Kidrọn, ọkwọmọ chẹ za. Okok akpongkkang p'ẹka-chi ndo, ọnyaanẹ z'apekwuk p'afutẹtẹ-nọng. <verse eid="2KI 23:6" /><verse number="7" style="v" sid="2KI 23:7" />Obir ọvọhkọ isọhm s'azaza p'ejinọng s'ining z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, za ch'panọng ad-aninga ayok ekpo py'Ashera.<verse eid="2KI 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 23:8" />Josaya otima afọhn-ẹja maphyir p'aning z'ibhon s'Juda oyin ka, pira nolukọ ọja-byi f'ọyaankpa f'ọtọm z'Geba maa opyirẹ z'Beershẹba, za ch'iwa afọhn-ẹja ad-aninga akwọmọ insẹns. Ọvọhkọ ebhumma-den ch'echin z'ebhumma ch'ebhondim ch'Joshua ọbaabh ch'ening z'obhurubọhk kw'ebhumma ch'ebhondim. <verse eid="2KI 23:8" /><verse number="9" style="v" sid="2KI 23:9" />Chibhẹ ch'iwa afọhn-ẹja p'ọja-byi f'ọyaankpa nna ọtọhm asi z'ija-byi s'Ọvaar Ibinọkpaabyi z'Jẹrusalẹm, wa mad-ator ayok afọhn-ẹja machi brẹd kw'nna yist ake.<verse eid="2KI 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 23:10" />Wa obir osi ẹka-kwuna ch'Tophet ch'ening z'ilokodo s'Bẹn-Hinnọm, etto asi, ọfha ọnọng oning ojinọngnwa kwẹ, wanẹma, ominanwa kwẹ, otim ọfọhnọ ẹja ch'ẹkwọmọ ọnang ọka f'Molẹk. <verse eid="2KI 23:10" /><verse number="11" style="v" sid="2KI 23:11" />Ny'ọmma kw'ochin z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọrọhbha nnyanya s'iwa avaar p'Juda ad-atima akpobha echekira. Wa jẹ ining k'ibyi s'inyọm idongọ s'odidennọng wanẹ kw'okpen Natan-Mẹlẹk. Josaya ọkwọmọ ijaar njo s'nnyanya id-itọr, s'mad-atima akpobha echekira.<verse eid="2KI 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 23:12" />Onyunọ ọja-byi f'uwa avaar p'Juda attim z'ipubhaang, za ch'ọnyọm idongọ s'Ahaz s'ining z'ẹrọng. Obir ozeng z'ọja-byi f'Manasẹ ikk'ọsa z'iter ifa s'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọrọhbha vẹ nya, ọvọhkọ <char style="it">matuku-tuku</char>. Pira ọtọka adidọhbh-gbuku-gbuku mbo, ọbharẹ z'ilokodo s'Kidrọn. <verse eid="2KI 23:12" /><verse number="13" style="v" sid="2KI 23:13" />Ọttọhk f'uwa ọvaarnọng obir osi otto asi ode ọja-byi f'ọyaankpa, f'oning z'ẹbhaakẹ ch'ewuchen ed-eyin z'Jẹrusalẹm, z'ẹwọn-ẹwọna kw'Egbe ch'adiktama. Ọja-byi mvo f'uwa ọvaar Sọlọmọn kw'Israẹl ikk'ottima ọnang Ashtorẹt kw'ode ọka f'ọbọk-ọbọkọ f'anọng p'Sidon, ọmaana Kẹmọsh kw'ode ọka f'ọbọk-ọbọkọ f'anọng p'Amọr, ọttara Molek kw'ode ọka f'ọbọk-ọbọkọ f'anọng p'Ammọn. <verse eid="2KI 23:13" /><verse number="14" style="v" sid="2KI 23:14" />Josaya ọvọhkọ ata p'abarẹ odik, obir ọkpaara ika-chi s'Ashera, otima ayokinọng-kọbhọ, obubha obyi mvo maphyir.<verse eid="2KI 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 23:15" />Ozeng k'ija-byi s'ining z'Bẹtẹl, ọmaana ọja-byi f'ọyaankpa f'uwa Jeroboam kw'ode nnwa kw'Nẹbat osi, f'ọwọhkọ anọng p'Israẹl asi epyibha, wa obir ọvọhkọ vẹ maphyir, ọbharẹ. Ọkwọmọ ija-byi njo s'ọyaankpa maa, izeng ititọhng, obir ọkwọmọ ẹka-chi ch'Ashẹra. <verse eid="2KI 23:15" /><verse number="16" style="v" sid="2KI 23:16" />Nya o, Josaya okkerẹ ọkọbha, oze apekwuk mbo p'aning z'egbe, ọrọhbha akọbhọ p'aning za, ọkwọmọ pẹ ny'ija-byi njo, ọfha ọka mvo otto asi, otor k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi okkikken otima ọgbaak-ettem ch'Ibinọkpaabyi ọgbaak idik nja.<verse eid="2KI 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 23:17" />Ọvaarnọng ọbọbh bẹ́, “Bọng-ẹta ch'marabh amaana epekwuk ch'id-nze kina?”</para>
  <para style="p" vid="2KI 23:17">Anọng p'ebhondim ndo apọhna bẹ́, “Ẹkọhk epekwuk ch'ọgbaak-ettem ch'Ibinọkpaabyi kw'ofon Juda, kw'uwa ọgbaak odik kw'ọmaan ija-byi s'Bẹtẹl, kw'ode idik oyenẹ s'ikk'asa nya.”<verse eid="2KI 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 23:18" />Josaya oben bẹ́, “Ttẹ-ẹ ọbọhk za. Tte ọnọng oning akọbhọ pẹ, ogbokọ.” Minna kw'mayobhọ akọbhọ pẹ, ọmaana mbo p'ọgbaak-ettem ch'Ibinọkpaabyi kw'ofon Samariya.<verse eid="2KI 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 23:19" />K'ose kw'uwa ikk'ọsa z'Bẹtẹl, minna kw'Josaya obir ọrọhbha aka-pa p'ọja-byi f'ọyaankpa maphyir p'uwa avaarnọng p'Israẹl nkk'asa z'ibhon s'Samariya, s'iwa iyemẹ ottempyibha kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 23:19" /><verse number="20" style="v" sid="2KI 23:20" />Josaya ọfhọ afọhn-ẹja mbo p'ọja-byi f'ọyaankpa maphyir ny'ọja-byi mvo, obir ọkwọmọ ayokinọng-kọbhọ ny'ọja-byi mvo. Pira nọkpa nnam z'Jẹrusalẹm.<verse eid="2KI 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 23:21" />Ọvaarnọng okwu ọnang anọng maphyir ẹfa bẹ́, “Màsi odidaama kw'Pasova kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabọnga, k'ose kw'makkẹrẹ m'Nnwẹr nwa kw'Echekẹ.” <verse eid="2KI 23:21" /><verse number="22" style="v" sid="2KI 23:22" />Pasova nwa m'ode ocheden kw'im'ode nkọmẹ, tọma z'ogbe kw'akpaar-aponga abaabh Israẹl, ọmaana z'ogbe kw'avaarnọng abaabh Juda. <verse eid="2KI 23:22" /><verse number="23" style="v" sid="2KI 23:23" />Okenaka, ny'icho ttong ichi kkanttaan kw'ẹbaabha ch'ọvaar Josaya, wa masi odidaama kw'Pasova anang Ọvaar Ibinọkpaabyi z'Jẹrusalẹm.<verse eid="2KI 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 23:24" />Odik kw'ọttar nya obir ode ẹrọhbha ch'iwa Josaya ọrọhbh abọhnganọng, ọmaana anọng p'aze iyaan, ọmaana aka p'isọhmmọr, ọmaana akpata, ọmaana ibyibyadik njoza s'iwa ining z'Juda, ọmaana z'Jẹrusalẹm. Wa osi idik nja mbengana, k'ose kw'ining z'nnwẹr kw'asana, kw'uwa Hilkiya kw'ode ọfọhn-ẹja, oze z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 23:24" /><verse number="25" style="v" sid="2KI 23:25" />Tọma z'avaar p'achi eden abaabha maa, pyirẹ z'avaar p'akpongnnam, wa ọvaarnọng za kode mach'Josaya, kw'otte ifor sẹ ọbọhk ọnang Ọvaar Ibinọkpaabyi, ọmaana ettem chẹ maphyir, ọmaana ọgbagba kwẹ maphyir, ọttara ẹfa chẹ maphyir, k'ose kw'ode z'asana p'Mosẹs maphyir.<verse eid="2KI 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 23:26" />Chibhẹ nya, wa Ọvaar Ibinọkpaabyi nnam kọkpa ọbọra ottempyibha kwẹ kwiden kw'oyen k'Juda, kw'ofon k'ittem-bhemadik s'Manasẹ osi otima otor-ẹ. <verse eid="2KI 23:26" /><verse number="27" style="v" sid="2KI 23:27" />Nya o, Ọvaar Ibinọkpaabyi oben bẹ́, “Kaam m'mbir nkwubh Juda m'kaam k'ititika k'ose kw'nkwubhọ Israẹl, mbir mbhum Jẹrusalẹm kw'ode ebhondim ch'ntek, ọmaana Ọsọhm nwa kw'Ibinọkpaabyi kw'mbenẹ bẹ́, “Nya kw'mm'aninga akpobha Eche chaam<note caller="+" style="f"><char style="fr" closed="false">23.27 </char><char style="fq" closed="false">nya </char><char style="ft" closed="false">1king 8:20</char></note>.”<verse eid="2KI 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 23:28" />Idik njoza s'iyinẹ k'ogbe kw'Josaya ọbaabh, ọmaana idik s'osi, makkẹrẹ z'anwẹr p'avaar p'Juda.<verse eid="2KI 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 23:29" />K'ogbe kw'uwa Josaya otim ẹvaar, Phero Neko kw'ode ọvaarnọng kw'Ijip, obina ochina z'ọraanga kw'Eupharetes bẹ́, ọd-ọkkaana ọvaarnọng kw'Asiriya. Ọvaar Josaya obina oyin egbong ọmaan-ẹ. Minna kw'Neko orim-ẹ ábẹ̀, ọfhẹ-ẹ z'Megido. <verse eid="2KI 23:29" /><verse number="30" style="v" sid="2KI 23:30" />Atọhmnọng p'Josaya, matọhka oforbukọ kwẹ k'ijaar s'ẹnyanya ẹd-ẹtọr, tọma z'Megido maa, pyirẹ z'Jẹrusalẹm. Manọhng-ẹ z'epekwuk chẹ oyenẹ. Anọng p'ẹkọma ndo makwu ayaana Jehoahaz kw'ode nnwa kw'Josaya, manang-ẹ ẹvaar ch'otte.<verse eid="2KI 23:30" /></para>
  <para style="s1">Jehoahaz otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 23:31" />Wa Jehoahaz ode icho ẹrọbh okwuma ittaan k'ogbe kw'otim ẹvaar ch'Israẹl. Oninga z'Jẹrusalẹm ọbaabha k'aphe attaan. Wa ọkka kwẹ okpen Hamutal, kwanọngnwa kw'Jẹrimaya kw'ofon Libna. <verse eid="2KI 23:31" /><verse number="32" style="v" sid="2KI 23:32" />Wa Jehoahaz osi itama z'ititika s'Ọvaar Ibinọkpaabyi, k'ose kw'anọng p'achẹ-ẹ eden k'ẹbaabha, nkk'asa. <verse eid="2KI 23:32" /><verse number="33" style="v" sid="2KI 23:33" />Wa Phero Neko ọkẹ-ẹ mgbakkọhbhọ z'Ribla, z'ẹkọma ch'Hamat, ọfha oning Jẹrusalẹm ọbaabh. Ọnang anọng p'Juda ọkpaara kw'ode atalẹn p'silva arọbh achen, ọmaana talẹn mawanẹ kw'gol. <verse eid="2KI 23:33" /><verse number="34" style="v" sid="2KI 23:34" />Phero Neko ọtọka Ẹliyakim, kw'ode nnwa kw'Josaya, ọnang-ẹ ẹvaar ch'otte. Obhona eche ch'Ẹliyakim, nọkpẹ-ẹ Jehoakim. Okwu ọtọka Jehoahaz otima ozeng z'Ijip. Oninga za maa, ope. <verse eid="2KI 23:34" /><verse number="35" style="v" sid="2KI 23:35" />Jehoyakim okwu ọnang Phero Neko silva, ọmaana gol mbo p'ọbọbh-ẹ. Pira wa oyena silva, ọmaana gol mbo, wa ọkpaar ọtabha ọnang anọng p'izek njo, otor k'ose kw'ẹfa ch'ọnọng-ọnọng ebeng.<verse eid="2KI 23:35" /></para>
  <para style="s1">Jehoyakim otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 23:36" />Wa Jehoyakim ode icho ẹrọbh okwuma ichen k'ogbe kw'otim ẹvaar ch'Juda. Oninga z'Jẹrusalẹm ọbaabha k'icho ijobh kkamfa. Wa ọkka kwẹ okpen Zebida kw'ode kwanọngnwa kw'Pedaya kw'ofon Ruma. <verse eid="2KI 23:36" /><verse number="37" style="v" sid="2KI 23:37" />Wa Jehoyakim osi itama z'ititika s'Ọvaar Ibinọkpaabyi, k'ose kw'anọng p'achẹ-ẹ eden abaabha, nkk'asa.<verse eid="2KI 23:37" /></para>
  <chapter eid="2KI 23" />
  <chapter number="24" style="c" sid="2KI 24" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 24:1" />Ny'ogbe kw'Jehoyakim ọbaabh, ọvaar Nebukadnẹza kw'Babilọn, otima ẹkọhr odim z'Juda. Jehoyakim okwu oninga k'ẹbaabha ch'Nebukadnẹza k'icho ittaan. Okenaka, ọkpa nnam ọbọra Nebukadneza, obe idungsẹ ọmaan-ẹ. <verse eid="2KI 24:1" /><verse number="2" style="v" sid="2KI 24:2" />Ọvaar Ibinọkpaabyi ọtọhm agbongnọng p'Babilọn, ọmaana p'Aram, ọmaana p'Moab, ọttara p'Ammọn bẹ́, mad-adimẹ Juda, ator k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi otim atọhmnọng pẹ, p'ade agbaak-ettem ch'Ibinọkpaabyi, ọgbaak. <verse eid="2KI 24:2" /><verse number="3" style="v" sid="2KI 24:3" />K'odik ọkkọkka, wa idik nja iyinẹ ikebha Juda itor k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi ikk'ọgbaaka, ọfha otima okwubh anọng p'Israẹl ny'ikẹ k'ititika, okurọ mpyibha s'Manasẹ, ọmaana idik maphyir s'ikk'ọsa, <verse eid="2KI 24:3" /><verse number="4" style="v" sid="2KI 24:4" />ọttara ọzẹ f'anọng p'mbọhk sabẹ iwur-owur f'okibhẹ. Wa kẹ kk'ọzẹ f'anọng p'mbọhk sabẹ iwur-owur, okibha maphyir ọkọbha Jẹrusalẹm. Wa Ọvaar Ibinọkpaabyi ifor kodo bẹ́, m'obina ọnang-ẹ.<verse eid="2KI 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 24:5" />Idik njoza s'iyinẹ k'ogbe kw'Jehoyakim ọbaabh, ọmaana idik s'osi, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="2KI 24:5" /><verse number="6" style="v" sid="2KI 24:6" />Jehoyada ope otor ab'otte za. Jehoyakim kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga chẹ.<verse eid="2KI 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 24:7" />Wa ọvaarnọng kw'Ijip ọdọk z'ikẹ k'ẹkọma kobin oyin k'iyaan, okurọ bẹ́, ọvaarnọng kw'Babilọn kk'ẹkọma chẹ ọtọka maphyir, tọma z'Ekeka ch'Ijip maa, pyirẹ z'ọraanga kw'Eupharetes.<verse eid="2KI 24:7" /></para>
  <para style="s1">Jehoyakin otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 24:8" />Wa Jehoyakin ode icho ichi kkanttaan k'ogbe kw'otim ẹvaar. Oninga z'Jẹrusalẹm ọbaabha k'aphe attaan. Wa ọkka kwẹ okpen Nebushta kw'ode kwanọngnwa kw'Elnathan kw'ofon Jẹrusalẹm. <verse eid="2KI 24:8" /><verse number="9" style="v" sid="2KI 24:9" />Wa osi itama z'ititika s'Ọvaar Ibinọkpaabyi mach'otte kwẹ, ikk'ọsa.<verse eid="2KI 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 24:10" />Ny'ogbe nwo, agbongnọng p'Nebukadneza, abina azeng z'Jẹrusalẹm, mad-ayima egbong za. <verse eid="2KI 24:10" /><verse number="11" style="v" sid="2KI 24:11" />Nebukadneza oyenẹ, okwu ny'ebhondim ndo, nya ch'agbongnọng pẹ mad-ayima egbong. <verse eid="2KI 24:11" /><verse number="12" style="v" sid="2KI 24:12" />Ọvaar Jehoyakin kw'Juda, ọmaana ọkka kwẹ, ọmaana anọng p'ad-akker-ẹ, ọmaana aganọng, ọmaana adukwa pẹ maphyir, machera ekema ch'Nebukadnez.</para>
  <para style="p" vid="2KI 24:12">Ny'icho ttong ochenọnttaan kw'ọvaarnọng kw'Babilọn ọbaabh, ọbọka Jehoyakin mach'ọgbakkọhbhọnọng, otima ofona.<verse eid="2KI 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 24:13" />K'ose kw'Ọvaar Ibinọkpaabyi ikk'ọgbaaka, Nebukadneza ọrọhbha ekpo ọkkọkka py'Ọsọhm kw'Ibinọkpaabyi, ọmaana mbyoza py'ening z'ọvaardimpa, obir ọkpaara ekpo mbyoza py'matim gol asi, py'iwa ọvaar Sọlọmọn ikk'ọsa osok z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 24:13" /><verse number="14" style="v" sid="2KI 24:14" />Ọtọka anọng p'Jẹrusalẹm maphyir, ọtọhm ebira, tọma z'adukwa, tto z'agbongnọng, pyirẹ z'ayok p'ayen itọhmbọhk, ọttara azeng-mphya. Wa bẹ maphyir made anọng nnọhna ẹrọbh okwuma ichen. Anọng p'ogbor bẹ ọtam ny'izek njo, bẹ-bẹ bọ p'uwa orikẹ.<verse eid="2KI 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 24:15" />Nebukadneza ọbọka Jehoyakin, ọtọhm-ẹ ebira z'Babilọn. Obir ọbọka ọkka kw'ọvarnọng, ọmaana panọng pẹ, ọmaana atọhmnọng pẹ, ọttara aganọng p'izek njo ny'Jẹrusalẹm, otima bẹ ozeng z'Babilọn. <verse eid="2KI 24:15" /><verse number="16" style="v" sid="2KI 24:16" />Wa ọvaarnọng kw'Babilọn obir ọtọhm agbongnọng kibung-kibungọ p'ade anọng nnọhna ichi kkamfa okwuma arọbh ijobh p'ayen ẹfa mawuriji, mabir abaana k'egbong oririma, ọmaana anọng nnọhna mfa okwuma arọbh ijobh p'ayen itọhmbọhk, ọmaana azeng-mphya, z'Babilọn. <verse eid="2KI 24:16" /><verse number="17" style="v" sid="2KI 24:17" />Okwu ọtọka Mattaniya kw'ode ọgbaanotte kw'otte kw'Jehoyakin, ọnang ẹvaar chẹ. Obhon-ẹ eche, ọkpẹ-ẹ Zedekiya.<verse eid="2KI 24:17" /></para>
  <para style="s1">Zedekiya otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 24:18" />Wa Zedekiya ode icho ẹrọbh okwuma icho mawanẹ, k'ogbe kw'otim ẹvaar ch'Juda. Oninga ny'Jẹrusalẹm ọbaabha k'icho ijobh kawanẹ. Wa ọkka kwẹ okpen Hamutal, kw'ode kwanọngnwa kw'Jẹrimaya kw'ofon Libna. <verse eid="2KI 24:18" /><verse number="19" style="v" sid="2KI 24:19" />Wa osi itama z'ititika s'Ọvaar Ibinọkpaabyi, k'ose kw'Jehoyakin, ikk'ọsa. <verse eid="2KI 24:19" /><verse number="20" style="v" sid="2KI 24:20" />Wa ofon k'ottempyibha kw'Ọvaar Ibinọkpaabyi, pira idik nja maphyir, iyin ikebha Jẹrusalẹm ọmaana Juda. K'okponganamgbe, okwubh bẹ maphyir ny'ikẹ k'ititika, ọbharẹ.</para>
  <para style="s1" vid="2KI 24:20">Ose kw'Jẹrusalẹm otto</para>
  <para style="p" vid="2KI 24:20">Ny'ogbe nwo, Zedekiya obe idungsẹ ọmaana ọvaarnọng kw'Babilọn.<verse eid="2KI 24:20" /></para>
  <chapter eid="2KI 24" />
  <chapter number="25" style="c" sid="2KI 25" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 25:1" />Ny'icho kw'ottong osowanẹ kw'Zedekiya ọbaabh, k'iwu ijobh s'ophe kw'ottong ijobh, Nebukadneza otima asoja pẹ maphyir ozeng z'Jẹrusalẹm, od-obhing z'mbọr-mbọr kw'ebhondim ndo, oyima egbong ọkọbha ebhondim ndo maphyir. <verse eid="2KI 25:1" /><verse number="2" style="v" sid="2KI 25:2" />Wa mayim egbong ny'ebhondim ndo maa, opyirẹ icho ijobh kawanẹ s'ọvaar Zedekiya, ọbaabh.<verse eid="2KI 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 25:3" />Ny'iwu ttong osowanẹ kw'ophe ttong anna, okwo f'oning ny'ebhondim ndo ọgaangẹ maa, owor ọchattọhk f'anọng mm'achi. <verse eid="2KI 25:3" /><verse number="4" style="v" sid="2KI 25:4" />Nya o, mavọhkọ ntumọ s'ebhondim ndo, asoja maphyir matima erungọ azenga ny'ebhumma ch'ening ny'njeka kw'ntumọ mfa s'nyọm ewoniva ch'ọvaarnọng, marọbh, chibhẹ ch'iwa anọng p'Babilọn atim akọbh ebhondim ndo ake k'ettem. Marọbh achina z'ẹbhaakẹ ch'Araba. <verse eid="2KI 25:4" /><verse number="5" style="v" sid="2KI 25:5" />Okenaka, asoja p'Babilọn makwubh ọvaarnọng maa, mabọk-ẹ z'mkpẹmẹ s'Jeriko. Asoja pẹ maphyir, maraamẹ arik-ẹ nya. <verse eid="2KI 25:5" /><verse number="6" style="v" sid="2KI 25:6" />Minna kw'mabọk-ẹ. Matim-ẹ akebha ọvaarnọng kw'Babilọn z'Ribla, maninga nya apyibh-ẹ aponga.<verse eid="2KI 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 25:7" />Mafhọ iva p'Zedekiya ny'ikẹ k'ititika. Madọng-ẹ achen, pira nnatim mgbakkọhbhọ s'bronz adabh-ẹ, matim-ẹ azeng z'Babilọn.<verse eid="2KI 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 25:8" />Ny'ewu ttong ichenọmfa s'ophe ttong achen, ny'icho ttong osowanẹ kw'ẹrọbh, ọvaar Nebukadneza kw'Babilọn, ọmaana Nebuzaradan kw'ode oso kw'anọng p'ad-akkerẹ ọvaarnọng, obir ode ọtọhmnọng kw'ọvaarnọng kw'Babilọn, makwu z'Jẹrusalẹm. <verse eid="2KI 25:8" /><verse number="9" style="v" sid="2KI 25:9" />Oke ekpon z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana z'ọvaardimpa, ọttara isọhm maphyir s'Jẹrusalẹm. Ọkwọmọ ọsọhm kpenamkpen kw'ọbarẹ odik nya. <verse eid="2KI 25:9" /><verse number="10" style="v" sid="2KI 25:10" />Asoja p'Babilọn maphyir p'aning k'ẹfa ch'oso kwanọng p'ad-akkerẹ ọvaarnọng, mavọhkọ ntumọ s'ikọbh Jẹrusalẹm. <verse eid="2KI 25:10" /><verse number="11" style="v" sid="2KI 25:11" />Nebuzaradan kw'ode oso kw'anọng p'ad-akkerẹ ọvaarnọng, ọtọka anọng p'nnarikẹ ny'ebhondim ọtọhm ebira, ọmaana anọng mboza, ọttara ayok mbo p'nkk'arọbha ator ọvaarnọng kw'Babilọn. <verse eid="2KI 25:11" /><verse number="12" style="v" sid="2KI 25:12" />Okenaka, wa osonọng nwo otte ayok mbo p'ogbor ọtam ọbọhk bẹ́, maninga nya asi itọhm ny'iwonọ sabẹ s'grep, ọmaana iwonọ njoza.<verse eid="2KI 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 25:13" />Anọng p'Babilọn avọhkọ mkpọmmachi s'matim bronz asi, ọmaana ọkpaar kw'ogbin, ọmaana ẹgbangbanjọ ch'matim bronz asi asok ny'Ọsọhm kw'Ọvaar Ibinọkpaabyi. Matinẹ bronz mbo atima azeng z'Babilọn. <verse eid="2KI 25:13" /><verse number="14" style="v" sid="2KI 25:14" />Wa mabir atọka ọzọhka, ọmaana asovẹl, ọmaana ẹfangba ch'etorongkkangdik, ọmaana agbobh-mbọhk, ọmaana ekpo mbyoza py'bronz py'mad-atima asi itọhm z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="2KI 25:14" /><verse number="15" style="v" sid="2KI 25:15" />Oso nwo kw'anọng p'ad-akkerẹ ọvaarnọng ọtọka ekpo py'mad-atima akwọmọ insẹns, ọmaana agbangbang p'esi-chakẹ. Ekpo mbyo maphyir, wa matim gol ọkkọkka, wanẹma, silva, asi.<verse eid="2KI 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 25:16" />Bronz kw'ofon ny'mkpọmmachi njo mfa, ọmaana ẹgbangbangjọ ndo, ọmaana ọkpaar kw'ogbin nwo, wa ede ekpo py'Sọlọmọn ikk'ọsa osok z'Ọsọhm kw'Ọvaar Ibinọkpaabyi. Wa ekpo mbyo etinẹ kede. <verse eid="2KI 25:16" /><verse number="17" style="v" sid="2KI 25:17" />Wa agoriji p'ẹkpọmmachi kpenamkpen made ntọkọ ẹrọbh okwuma ichenọmfa, oso kw'ẹkpọmmachi ch'matim bronz asi, ode ntọkọ ichenọmfa ọmaana ibhaaka k'agoriji. Matima bronz abir arabha pomegrenet akọbha maphyir. Ẹkpọmmachi ndoza, ebir ede ose nwo mawanẹ ọmaana ekpo py'madok nya.<verse eid="2KI 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 25:18" />Oso kw'anọng p'nd-akkerẹ ibyi, ọbọka Seraya kw'ode ọvaar kw'afọhn-ẹja mach'ọgbakkọhbhinọng, ọmaana Zẹphaniya kw'ode ọfọhn-ẹja kw'ọyak-ẹ nnam k'ediden, ọmaana akker-ẹsọhmma mbo attaan. <verse eid="2KI 25:18" /><verse number="19" style="v" sid="2KI 25:19" />Ny'anọng mbo p'arikẹ ny'ebhondim, ọbọka ọnọng kw'ọbaabh ayok p'ad-arima egbong, ọmaana anọng p'ad-anang ọvaarnọng ntọhna. Obir ọbọka ọkkẹrẹ kw'uwa ọd-ọbọka anọng p'obhon nwo k'ẹfa bẹ́, mayin egbong, ọmaana anọng arọbh attaan p'aning ny'ebhondim ndo p'uwa nkk'abọka k'ẹfa bẹ́, mayin egbong. <verse eid="2KI 25:19" /><verse number="20" style="v" sid="2KI 25:20" />Nebuzaradan kw'ode oso kw'anọng p'ad-akkerẹ ọvaarnọng, ọtọka bẹ maphyir otima od-okebha ọvaarnọng kw'Babilọn z'Ribla. <verse eid="2KI 25:20" /><verse number="21" style="v" sid="2KI 25:21" />Ny'Ribla, kw'ode izek s'Hamat, nya kw'ọvaarnọng ọfhọ bẹ maphyir.</para>
  <para style="p" vid="2KI 25:21">Minna kw'Juda obin orik ẹkọma chẹ, od-oninga ebira k'obhon ọdọk-ọdọk.<verse eid="2KI 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 25:22" />Nebukadneza kw'ode ọvaarnọng kw'Babilọn ọrọhbha Gedaliya kw'ode nnwa kw'Ahikam, kw'Shaphan obhonọ bẹ́, ọbaabha anọng p'obin orik z'Juda. <verse eid="2KI 25:22" /><verse number="23" style="v" sid="2KI 25:23" />K'ogbe kw'aso p'asoja maphyir, ọmaana asoja p'ikarẹ, mabhaang bẹ́, ọvaarnọng kw'Babilọn kk'Gedaliya oteka bẹ́, ọbaabha, minna kw'Ishmayẹl kw'ode nnwa kw'Netaniya, ọmaana Johanan kw'ode nnwa kw'Karea, ọmaana Seraya kw'ode nnwa kw'Tanhumet kw'ofon Netophat, ọmaana Jazaniya kw'ode nnwa kw'Makaat, ọmaana ajinọng pabẹ, makwu akebha Gedaliya z'Mizpa. <verse eid="2KI 25:23" /><verse number="24" style="v" sid="2KI 25:24" />Gedaliya ochekẹ, otima oke bẹ ettem. Oben bẹ bẹ́, “Tte adukwa p'Babilọn aning bọnga ajor. Màsi oruk kwabọnga ny'izek njo, makpobha ọvaarnọng kw'Babilọn. Idik m'ijibh-ojibh inang bọnga.”<verse eid="2KI 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 25:25" />Okenaka, ny'ophe kw'ottong achenọmfa, Ishmayẹl kw'ode nnwa kw'Netaniyẹl kw'ode nnwa kw'Elishama kw'ofon k'ivaartaak, otima ajinọng ijobh, okwu ọfhọ Gedaliya ọmaana anọng p'Juda ọttara anọng p'Babilọn p'aning amaan-ẹ z'Mizpa. <verse eid="2KI 25:25" /><verse number="26" style="v" sid="2KI 25:26" />Ofona nya, anọng maphyir p'aning nya, tọma z'ọnọng kw'ọchamẹ ọtam, pyirẹ z'oyok kw'ọbarẹ ọtam, ọmaana adidennọng p'asoja, marọbh achina z'Ijip, okurọ ch'anọng p'Babilọn ajor bẹ.<verse eid="2KI 25:26" /></para>
  <para style="s">Matte Jehoyakin ọbọhk</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 25:27" />Ny'icho ttong ẹrọbh okwuma ichi kkamfa s'ọvaar Jehoyakin kw'Juda oyim ebira, ny'icho kw'Awel-Marduk okwu otima ẹvaar ch'Babilọn, nya kw'otte ọvaar Jehoyakin kw'Juda ọbọhk, ọnaanga mgbakkọhbhọ. Wa ọrọhbh-ẹ k'mgbakkọhbhọ njo k'iwu ẹrọbh okwuma ichenọmfa s'ophe ttong ijobh kkamfa. <verse eid="2KI 25:27" /><verse number="28" style="v" sid="2KI 25:28" />Ọgbaak odik k'ọmọm-ọtọhnga, ọnang-ẹ, okwu ọnang-ẹ eninga ch'ikpukpobha ch'ẹyọhng ch'avaar mboza p'aning amaan-ẹ ny'Babilọn. <verse eid="2KI 25:28" /><verse number="29" style="v" sid="2KI 25:29" />Nya o, Jehoyakin ọwọra ẹgbakkọhbhọkpo py'ọfọr, ọbharẹ za. Ọtọma nya, nod-ochi ọttọhk ọmaana ọvaarnọng k'ogbe kpenamkpen k'akpen pẹ maphyir. <verse eid="2KI 25:29" /><verse number="30" style="v" sid="2KI 25:30" />K'ewu k'ewu, ọvaarnọng ọd-ọnang Jehoyakin akpuka mach'ọnangẹ nya, k'akpen pẹ maphyir.<verse eid="2KI 25:30" /></para>
  <chapter eid="2KI 25" />
</usx>