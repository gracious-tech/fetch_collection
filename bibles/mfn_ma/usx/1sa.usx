<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1SA" style="id">- Mbembe Adun [MFNAdun]</book>
  <para style="h">1 Samwẹl</para>
  <para style="toc1">Ocheden-nwẹr kw'Samwẹl</para>
  <para style="toc2">1 Samwẹl</para>
  <para style="mt1">Ocheden-nwẹr kw'Samwẹl</para>
  <chapter number="1" style="c" sid="1SA 1" />
  <para style="s1">Ose kw'Samwẹl ozeng ọmmaana</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 1:1" />Wa oyen ojinọng wanẹ kw'okpen Ẹlkana, kw'ofon z'Rama, z'ẹbhaakẹ ch'Zuph, z'ẹkọma ch'Ephraim ch'eyen agbe. Ẹlkana nwo wa ode nnwa kw'Jeroham, kw'ode nnwa kw'Elihu, kw'ode nnwa kw'Tohu, kw'ode nnwa kw'Zuph, kw'ofon Ephraim. <verse eid="1SA 1:1" /><verse number="2" style="v" sid="1SA 1:2" />Ẹlkana ọtọk panọng afa p'akpen Hana ọmaana Pẹnina. Pẹnina ọmaan-ẹ iva, Hana nnwa kọmaanẹ.<verse eid="1SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 1:3" />K'icho k'icho, Ẹlkana od-obina ny'ikẹ k'obhon ochina z'Shilo bẹ́, od-okpobha Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir, obir ọfọhnọ ẹja ọnang-ẹ. Wa ny'ogbe nwo, iva afa p'Ẹli p'ade Hophni ọmaana Phinẹhas made afọhn-nja p'Ibinọkpaabyi z'Shilo.<verse eid="1SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 1:4" />Ó̱pyirẹ k'ogbe kw'Ẹlkana ọd-ọfọhnọ ẹja, ọd-ọtọka okebh f'eten ọnang kwanọng kwẹ Pẹnina, ọmaana iva pẹ k'ejinọng ọttara k'ẹpanọng. <verse eid="1SA 1:4" /><verse number="5" style="v" sid="1SA 1:5" />Okenaka, ọd-ọnang Hana okebh f'ode igbedim ifa okurọ ch'Hana ọdaak-ẹ ọdaak, ọttara bẹ́, Ọvaar Ibinọkpaabyi kk'ẹ ọsa ọkpaana. <verse eid="1SA 1:5" /><verse number="6" style="v" sid="1SA 1:6" />Ch'Ọvaar Ibinọkpaabyi ikk'ẹ ọsa ọkpaana, oyok-bhọbha kwẹ od-olok-ẹ, ọfha osi ettem epyibh-ẹ. <verse eid="1SA 1:6" /><verse number="7" style="v" sid="1SA 1:7" />Odik nwo ochina ororo k'icho k'icho. Ogbe kpenamkpen kw'Hana ochin z'ọsọhm kw'Ọvaar Ibinọkpaabyi, oyok-bhọbha kwẹ m'olok-ẹ maa, osi ettem epyibh-ẹ, ọsọrọ asen, ọttọhk mòbira ochi. <verse eid="1SA 1:7" /><verse number="8" style="v" sid="1SA 1:8" />Ẹlkana kw'ode odim kwẹ, ọd-ọbọbh-ẹ bẹ́, “Hana, ad-abhom mbọng? Osempira ọttọhk kacher achi? Osempira aninga k'oforpyibha minna? Ma, kaam kọ odik kimbarẹ nyọhnga ajinọngva ijobh yirẹ?”<verse eid="1SA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 1:9" />K'ogbe wanẹ ch'maning z'Shilo, ch'nkk'ọchattọhk ọmaana igwagwa achera, Hana obina obobe. Ny'ogbese nwo, Ẹli kw'ode ọfọhn-nja oning ẹwọr k'ogbera ny'ọsọhm kw'Ọvaar Ibinọkpaabyi ọnyọma ẹmmakwukden. <verse eid="1SA 1:9" /><verse number="10" style="v" sid="1SA 1:10" />Ettem ẹyakẹ Hana odik matẹtẹmaa, obhom ẹmọng, obir oze njọm ọnang Ọvaar Ibinọkpaabyi. <verse eid="1SA 1:10" /><verse number="11" style="v" sid="1SA 1:11" />Ọtọka nwọhngọ, oben bẹ́, “O Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir, wura m'akenaka aze irem s'kaam ọtọhmnọng kwọ, ajim-m, aning-m abir azaama, akenaka anang-m ojinọngnwa, kaam m'nttẹ-ẹ ọbọhk nnang Ọvaar Ibinọkpaabyi k'akpen pẹ maphyir, kwuna ẹgọhbha ny'ikẹ k'eso mẹ̀twu<note caller="+" style="f"><char style="fr" closed="false">1.11 </char><char style="fq" closed="false">Ẹgọhbha ny'ikẹ k'eso mẹ̀twu </char><char style="ft" closed="false">oyinẹ bẹ́, eso mògwo. K'ẹmmaana ch'aHiburu, isisa otitir jọ iwa ide ẹkọhka bẹ́, nkk'ọnọng ọbọhk atta anang Ibinọkpaabyi k'akpen pẹ maphyir bẹ́, osi ọtọhm f'Ibinọkpaabyi. Yerẹ Nnwẹr kw'Obhik 6:1-21. </char></note>.”<verse eid="1SA 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 1:12" />K'ose kw'Hana ochin ororo oze njọm ọnang Ọvaar Ibinọkpaabyi, Ẹli ọkẹ-ẹ otum ny'ẹmma. <verse eid="1SA 1:12" /><verse number="13" style="v" sid="1SA 1:13" />Wa Hana od-oze njọm z'ettem, ẹmmakpa chẹ ed-ewonga ebubha, okenaka, ẹmọng chẹ k'iyaan keyinẹ. Ẹli ọsẹ-ẹ bẹ́, kk'atuk obuma. <verse eid="1SA 1:13" /><verse number="14" style="v" sid="1SA 1:14" />Ofona nya o, okwu oben-ẹ bẹ́, “Kọ m'abuma atuk atuma yen? Kpọ̀ka atuk ogwugwo.”<verse eid="1SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 1:15" />Hana ọpọhn-ẹ bẹ́, “Atte kwaam, minna kode, kaam nde kwanọng kw'ettem ẹyakẹ odik mawuriji. Kaam atuk kid-ngwo; kaam nd-mmom ẹmọng z'ettem chaam nnang Ọvaar Ibinọkpaabyi. <verse eid="1SA 1:15" /><verse number="16" style="v" sid="1SA 1:16" />Ototo, kaam ọtọhmnọng kwọ mach'kwanọngtama kàtọka. Nd-nze njọm minna okurọ isen ọmaana ikwosisi saam.”<verse eid="1SA 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 1:17" />Ẹli ọpọhn-ẹ bẹ́, “Zọ̀hng k'ẹmẹm, tte Ibinọkpaabyi kw'Israẹl ọnang-ọ ọttọhk f'aphyem-ẹ.”<verse eid="1SA 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 1:18" />Hana ọpọhn-ẹ bẹ́, “Tte kaam ọtọhmnọng kwọ, nze ọphyaam k'ititika sọ.” Nya o, ofona od-ochi ọttọhk, ititika sẹ ibir ipyira.<verse eid="1SA 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 1:19" />Ewu esobh nya, k'ekpikpebha, mabina makpobha Ọvaar Ibinọkpaabyi, pira nnakpa nnam z'abẹ k'obhon z'Rama. Ẹlkana okwu oyima ọmaana Hana, Ọvaar Ibinọkpaabyi ọbhaanga njọm sẹ. <verse eid="1SA 1:19" /><verse number="20" style="v" sid="1SA 1:20" />Nya o, otum k'ogbe, Hana otima ibhọr, ọmaan ojinọngnwa, ọkpẹ-ẹ Samwẹl<note caller="+" style="f"><char style="fr" closed="false">1.20 </char><char style="ft" closed="false">Samwẹl: </char><char style="ft" closed="false">k'ebhon ch'aHiburu, eche ndo eyinẹ ọttọhk mach'iwura ọnọng obenẹ bẹ́, “Eche chẹ ede Ibinọkpaabyi.” Hana ọnang nnwa kwẹ eche nda ọfha otima ọnang Ọvaar Ibinọkpaabyi ikpukpobha okurọ bẹ́, Ọvaar Ibinọkpaabyi kk'njọm sẹ ọbhaanga ọnang-ẹ ọttọhk f'ororọ ọbọbh Ibinọkpaabyi.</char></note>, oben bẹ́, “Mphyem-ẹ z'Ọvaar Ibinọkpaabyi.”<verse eid="1SA 1:20" /></para>
  <para style="s">Hana otte Samwẹl ọbọhk ọnang Ibinọkpaabyi</para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 1:21" />Ch'ogbe obir obenga kw'Ẹlkana m'otima ẹsọhmmọr chẹ maphyir ọd-ọfọhnọ ẹja ch'mad-afọhnọ z'Shilọ k'icho k'icho, obir osok nwọhngọ sẹ, <verse eid="1SA 1:21" /><verse number="22" style="v" sid="1SA 1:22" />Hana kọta. Oben odim bẹ́, “K'ogbe kw'nnwa nwoma ikk'okwura, kaam m'ntọk-ẹ nnang Ọvaar Ibinọkpaabyi, oruk ọmaan-ẹ k'akpen pẹ maphyir.”<verse eid="1SA 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 1:23" />Ẹlkana ọpọhn-ẹ, bẹ́, “Si k'ose kw'abenẹ. Ninga ma maa, akwur-ẹ; tte Ọvaar Ibinọkpaabyi ọkkaan-ọ asi k'ose kw'ikk'anwọhnga.”</para>
  <para style="p" vid="1SA 1:23">Ofona nya, Hana oninga ny'ọsọhm ọgwọkọ ojinọngnwa kwẹ maa, okwurọ.<verse eid="1SA 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 1:24" />Ch'ikk'nnwa nwo okwura, ọtọk-ẹ ny'ẹvava ndo, obir ọtọka ọbhaamnwa kw'icho ittaan, ọttara ọgbangbang kwiden kw'agwubuma, ọmaana atuk k'ogberenwa, otim-ẹ ochina z'ọsọhm kw'Ọvaar Ibinọkpaabyi z'Shilo. <verse eid="1SA 1:24" /><verse number="25" style="v" sid="1SA 1:25" />K'ogbe kw'nkk'ẹbhaam ndo atima afọhnọ ẹja, matọka nnwa nwo achena Ẹli. <verse eid="1SA 1:25" /><verse number="26" style="v" sid="1SA 1:26" />Hana oben-ẹ bẹ́, “Ttatta kwaam, k'odik ọkkọkka, kaam wọ nde kwanọng nwo kw'uwa obe ma ọmaan-ọ, oze njọm ọnang Ọvaar Ibinọkpaabyi. <verse eid="1SA 1:26" /><verse number="27" style="v" sid="1SA 1:27" />Kaam nze njọm s'nnwa nwoma, Ọvaar Ibinọkpaabyi ọnang-m f'mphyem-ẹ. <verse eid="1SA 1:27" /><verse number="28" style="v" sid="1SA 1:28" />Ma, n'nttẹ-ẹ ọbọhk nnang Ọvaar Ibinọkpaabyi k'akpen pẹ maphyir.” Nya o, maraka nso, makpobha Ọvaar Ibinọkpaabyi nya.<verse eid="1SA 1:28" /></para>
  <chapter eid="1SA 1" />
  <chapter number="2" style="c" sid="1SA 2" />
  <para style="s">Hana ọtọhng Ibinọkpaabyi</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 2:1" />Minna kw'Hana oze njọm, oben bẹ́,</para>
  <para style="q1" vid="1SA 2:1">“Kaam nyen ottemlebh kwiden k'Ọvaar Ibinọkpaabyi;</para>
  <para style="q2" vid="1SA 2:1">Ọvaar Ibinọkpaabyi kk'ẹfa chaam ọsa etinẹ<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="ft" closed="false">K'anwẹr p'ẹtama, makkẹrẹ bẹ́, “Obhik kwaam kk'otina k'ẹrọng k'Ọvaar Ibinọkpaabyi”, kw'oyinẹ bẹ́, Ọvaar Ibinọkpaabyi kk'aam ẹfa ọnanga.</char></note> k'ẹrọng.</para>
  <para style="q1" vid="1SA 2:1">Kaam, nsi ẹmma nnang awawunanọng paam,</para>
  <para style="q2" vid="1SA 2:1">ettem elebh-m ch'asi-m nnaanga.<verse eid="1SA 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="1SA 2:2" />“Ọnọng za kode kw'owurọ mach'Ọvaar Ibinọkpaabyi;</para>
  <para style="q2" vid="1SA 2:2">Ọnọng za kode kw'ọkpanẹ kọ Ibinọkpaabyi,</para>
  <para style="q2" vid="1SA 2:2">Ẹtakpa kede ch'ẹgaangẹ mach'Ibinọkpaabyi kwamina.<verse eid="1SA 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="1SA 2:3" />“M'ẹgaga kàgbaak achina ororo,</para>
  <para style="q2" vid="1SA 2:3">tte ẹmma chabọnga ening ẹgaga ẹgbaakẹ.</para>
  <para style="q1" vid="1SA 2:3">Kirẹ, Ọvaar Ibinọkpaabyi ode Ibinọkpaabyi kw'ozong idik maphyir,</para>
  <para style="q2" vid="1SA 2:3">kẹ wọ ọd-ọkpaara aponga p'anọng.<verse eid="1SA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="1SA 2:4" />“Nkk'ayuk p'akkikkaama aphyaka,</para>
  <para style="q2" vid="1SA 2:4">okenaka, ayok p'asir atto nkk'ẹfa ayena.<verse eid="1SA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1SA 2:5" />Ayok p'uwa mad-achi maa, madọhbh, maamba, nnad-asi itọhm s'anọng pira m'ayena ọchattọhk,</para>
  <para style="q2" vid="1SA 2:5">ayok p'uwa okwo ọkaam-ọkaama, m'ọdọk okwo kayim.</para>
  <para style="q1" vid="1SA 2:5">Kwanọng kw'uwa ọkpaan-ọkpaana, kk'iva achenọmfa ọmaana,</para>
  <para style="q2" vid="1SA 2:5">okenaka, oyok kw'uwa ikk'ajinọng k'ẹkaan ọmaana, ọdọk nnwa koyen.<verse eid="1SA 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="1SA 2:6" />“Ọvaar Ibinọkpaabyi wọ od-otima obo okwu, obir ọnang ọnọng akpen;</para>
  <para style="q2" vid="1SA 2:6">kẹ wọ od-otima anọng banẹ ochina z'offurabhon, obir ọphyabha anọng banẹ k'obo.<verse eid="1SA 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1SA 2:7" />Ọvaar Ibinọkpaabyi ọd-ọtọhm opyibhada ọmaana ojibhada;</para>
  <para style="q2" vid="1SA 2:7">kẹ ọd-ọsaka anọng banẹ eninga, obir otinẹ anọng banẹ k'ẹrọng.<verse eid="1SA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1SA 2:8" />Kẹ od-otinẹ agbugbora z'ebonọ, obir otinẹ ayok p'aning k'owóra z'ititọhng;</para>
  <para style="q2" vid="1SA 2:8">osok bẹ k'ibyi majanẹ ọmaana avaar-va, obir osi bẹ maninga k'ẹvaarkkọhbhọ ch'ikpukpobha.</para>
  <para style="b" vid="1SA 2:8" />
  <para style="q1" vid="1SA 2:8">“Ọvaar Ibinọkpaabyi wọ oyen ẹtọma ch'iyagbin nja;</para>
  <para style="q2" vid="1SA 2:8">ny'ẹtọma ndo dọ ch'ottim iyagbin.<verse eid="1SA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1SA 2:9" />Kẹ m'ọkpẹmẹ ntọkọ s'anọng p'acher k'ikẹ,</para>
  <para style="q2" vid="1SA 2:9">okenaka, abyibyanọng mm'ape akponga k'orungibanga.</para>
  <para style="b" vid="1SA 2:9" />
  <para style="q1" vid="1SA 2:9">“Ẹfa azang ch'ọnọng od-otima okema;<verse eid="1SA 2:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="1SA 2:10" />mm'ajọhkọ anọng p'akaang Ọvaar Ibinọkpaabyi odik <char style="it">ma tukutuku</char>.</para>
  <para style="q1" vid="1SA 2:10">Kẹ m'obik etum ọmaana ottempyibha z'ẹrọng otima otor bẹ;</para>
  <para style="q2" vid="1SA 2:10">Ọvaar Ibinọkpaabyi m'ọkpaara aponga p'iyagbin maphyir.</para>
  <para style="b" vid="1SA 2:10" />
  <para style="q1" vid="1SA 2:10">“Kẹ m'ọnang ọvaarnọng kwẹ ẹfa,</para>
  <para style="q2" vid="1SA 2:10">obir osi ẹfa ch'ọnọng kw'ikk'ana obyenga k'eso egorọ.”<verse eid="1SA 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 2:11" />Nya o, Ẹlkana obina ọbhana z'Rama. Nnwa nwo oninga nya osi ọtọhm ny'Ọvaar Ibinọkpaabyi k'ititika, oninga k'okpebhẹ kw'Ẹli, kw'ode ọfọhn-nja kw'Ibinọkpaabyi.<verse eid="1SA 2:11" /></para>
  <para style="s">Ajinọngvatama p'Ẹli</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 2:12" />Ajinọngva p'uwa Ẹli obhonọ made ivatama. Wa m'Ọvaar Ibinọkpaabyi mach'ọttọhk, katọk. <verse eid="1SA 2:12" /><verse number="13" style="v" sid="1SA 2:13" />Wa ẹmmaana ch'afọhn-nja mad-asi ọmaana anọng p'Israẹl ede bẹ́, k'ogbe kw'ọnọng okwu ọfọhnọ ẹja, itọhmọ s'ọfọhn-nja m'itima ogbindara kw'oyen asa attaan ny'ọbọhk, okwu nya ch'eten etim ẹnọhn ny'ekpon. <verse eid="1SA 2:13" /><verse number="14" style="v" sid="1SA 2:14" />Itọhmọ njo m'inọhma ogbindara nwo ny'izọhka njo siden. Okpenamkpen f'owong, vẹ f'ọfọhn-nja m'ọtọka ọnang ifor sẹ. Minna wọ kw'uwa mad-asi anọng p'Israẹl maphyir p'mad-akwu z'Shilo. <verse eid="1SA 2:14" /><verse number="15" style="v" sid="1SA 2:15" />Okenaka, pira makwọmọ iyaak s'eten, itọhmọ s'ọfọhn-nja m'ikwu iben ọnọng kw'ọd-ọfọhnọ nja bẹ́, “Nang ọfọhn-nja eten ch'im'ọbhaabh, ndo ch'nkk'awọhna mọ̀tọka, kw'ọkpanẹ ekikebhẹ.”<verse eid="1SA 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 2:16" />Ó̱de ọnọng nwo oben-ẹ bẹ́, “Tte nchi eden nkwọmọ iyaak s'eten nda maphyir nnang Ibinọkpaabyi pira atọka okpenamkpen f'im'atọka,” itọhmọ njo m'ipọhn-ẹ bẹ́, “Mma, nang-m madidanma, ini minna ode, m'ntọka dẹ k'ẹfa.”<verse eid="1SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 2:17" />Epyibha ch'iwa adikkobhva mba asi ẹbarẹ mawuriji z'Ọvaar Ibinọkpaabyi k'ititika, ch'iwa mad-atima nnanga s'anọng anang Ọvaar Ibinọkpaabyi k'ilulukọden.<verse eid="1SA 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 2:18" />Wa Samwẹl ode ojinọngnwa kw'ọd-ọfọra ẹphọd otima osi ọtọhm z'Ọvaar Ibinọkpaabyi k'ọsọhm. <verse eid="1SA 2:18" /><verse number="19" style="v" sid="1SA 2:19" />K'icho k'icho, ọkka kwẹ, Hana od-okwum ọnọhma-baba kw'ikarẹ ochen-ẹ k'ogbe kw'ikẹ ttara odim mad-ayin ẹja ofufọhnọ. <verse eid="1SA 2:19" /><verse number="20" style="v" sid="1SA 2:20" />Ó̱gbe opyirẹ, Ẹli m'osi Ẹlkana ọttara kwanọng kwẹ ittabọhng, obenẹ bẹ bẹ́, “Tte Ọvaar Ibinọkpaabyi ọnang-ọ iva p'afon m'kwanọng nwa, atima atera eso ch'oyok kw'oze njọm pira oyen-ẹ, ọkpa nnam ọttẹ-ẹ ọbọhk ọnang Ọvaar Ibinọkpaabyi.” Macher nya, mabhana. <verse eid="1SA 2:20" /><verse number="21" style="v" sid="1SA 2:21" />Minna kw'uwa Ọvaar Ibinọkpaabyi osi ejibha ọnang Hana; otima ibhọr ọmaan ajinọngva attaan, ọmaana panọngva afa. Minna kw'uwa Samwẹl obeng k'icho ny'ititika s'Ọvaar Ibinọkpaabyi.<verse eid="1SA 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 2:22" />M'ogbese nwa, wa Ẹli kk'ọtama mawuriji. Okwu ọbhaanga idik maphyir s'iva pẹ ad-asi anang anọng p'Israẹl maphyir, ọttara k'ose kw'mad-ayima amaana panọng p'ad-asi ọtọhm ny'ebhumma ch'ikkira s'etobha. <verse eid="1SA 2:22" /><verse number="23" style="v" sid="1SA 2:23" />Nya o, oben iva pẹ bẹ́, “Osempira mad-asi idikse njo? Nd-mmaanga adiktama mba p'mad-asi z'anọng maphyir k'ẹmma. <verse eid="1SA 2:23" /><verse number="24" style="v" sid="1SA 2:24" />Mma o, iva paam, idik s'mmaang anọng p'Ọvaar Ibinọkpaabyi ad-agbaak amaana bọnga ma, kijibhẹ o. <verse eid="1SA 2:24" /><verse number="25" style="v" sid="1SA 2:25" />Ó̱de ọnọng opinẹ oyok, Ibinọkpaabyi oning ch'okwukọ k'ikẹ k'eso; okenaka, óde ọnọng opinẹ Ọvaar Ibinọkpaabyi, anyi wọ im'okwukọ k'ikẹ k'eso?” Chibhẹ nya, wa iva pẹ m'ẹmọng ch'otte ọd-ọkwọhrọ bẹ, kabhaang, okurọ bẹ́, wa ode ochibhẹ kw'Ọvaar Ibinọkpaabyi bẹ́, ọtọka akpen pabẹ.<verse eid="1SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 2:26" />Minna kw'Samwẹl ochin ororo obenga k'ifor, ọdaak Ọvaar Ibinọkpaabyi ọttara ayokinọng idik.<verse eid="1SA 2:26" /></para>
  <para style="s">Ẹkkaabhatama ch'ẹmaan ẹsọhmmọr ch'Ẹli</para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 2:27" />K'ewu danẹ, ọgbaak-ettem wanẹ kw'Ibinọkpaabyi okwu okebha Ẹli, oben-ẹ bẹ́, “Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi ọgbaakẹ: ‘K'ogbe kw'uwa maning k'mbọhk s'Phero z'Ijip, wa nyaakẹ ifor saam <char style="it">bẹ́ ttaan</char> nnang ẹsọhmmọr ch'ab'ttatta pabọnga. <verse eid="1SA 2:27" /><verse number="28" style="v" sid="1SA 2:28" />Ny'mfonamma s'Israẹl maphyir, kaam nrọbh atte kwọ bẹ́, ode ọfọhn-nja kwaam, od-ovura ija-byi saam, ọkwọmọ insẹns, obir ọfọra <char style="w">ẹphọd</char> k'kaam k'ititika. Nnanga s'anọng p'Israẹl mad-akwọmọ anang-m maphyir, mbir ntte ọbọhk nnang ẹsọhmmọr ch'atte kwọ. <verse eid="1SA 2:28" /><verse number="29" style="v" sid="1SA 2:29" />Osempira malukọ ẹja chaam, ọttara nnanga s'mphyikẹ nsok ọsọhm kwaam o? Osempira akpobha iva pọ ayọhnga kaam, ad-ateka nten ọkkọkka s'ẹja kpenamkpen ch'anọng paam Israẹl anang-m, machi, mabar?’<verse eid="1SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 2:30" />“Ofona nya, Ọvaar Ibinọkpaabyi kw'Israẹl, obira oben bẹ́, ‘Wa nnwọhngọ bẹ́, ẹsọhmmọr chọ ọttara ch'atte dọ im'esi ọtọhm m'ikaam k'ititika ttattampe.’ Okenaka, Ọvaar Ibinọkpaabyi nobenẹ ma bẹ́, ‘Ọdọk minna mòde maphyir-phyir. Ayok p'akpobh-m, kaam m'mkpobha bẹ, ayok p'agbaar-m ajẹ, kaam m'nsaka bẹ eninga. <verse eid="1SA 2:30" /><verse number="31" style="v" sid="1SA 2:31" />Ogbe okwuma kw'm'nsaka ẹfa chọ, ọmaana ch'ẹsọhmmọr ch'atte, ọfha ọtaminọng oning ọdọk k'echimma chọ oning. <verse eid="1SA 2:31" /><verse number="32" style="v" sid="1SA 2:32" />Kọ m'aze itama ny'ọsọhm kwaam. Zaabẹ́ m'nsi ejibha nnang Israẹl, ńnòde ny'ẹsọhmmọr chọ, ọtaminọng ọdọk moninga. <verse eid="1SA 2:32" /><verse number="33" style="v" sid="1SA 2:33" />Ọnọng kpenamkpen ny'abọnga k'ẹsọhmmọr kw'ina kẹ mmumọ k'ọtọhm f'ija-byi saam, m'nttẹ-ẹ ọbọhk oruk akpen p'isen osisọhrọ, mbira nkẹ-ẹ ẹbhaak k'ettem. Minna kw'iva p'iva pọ mmin'ad-ape ch'nkk'ajinọng asa.<verse eid="1SA 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 2:34" />“ ‘K'iva pọ afa, kw'ode Hophni ọmaana Phinẹhas, bẹ mm'ade ẹkọhka anang-ọ. Bẹ anọng afa mm'ape k'ewu madanẹ. <verse eid="1SA 2:34" /><verse number="35" style="v" sid="1SA 2:35" />Kaam m'nteka ọfọhn-nja ọkkọkka kwaam oyenẹ, kw'im'osi idik otor k'ettem chaam ọttara ochibhẹ kwaam. Kaam m'nsi ẹsọhmmọr chẹ ettima mawuriji, kẹ min'od-osi ọtọhm k'ogbe kpenamkpen ny'ititika s'ọnọng kwaam kw'ikk'ana mbyenga k'eso. <verse eid="1SA 2:35" /><verse number="36" style="v" sid="1SA 2:36" />Ofona nya o, ọnọng kpenamkpen kw'orikẹ ny'ẹsọhmmọr chọ m'okwu ọraka eso ọnang-ẹ, ophyem-ẹ akpuka biribirẹ ọttara brẹd biribirẹ, obir okwuk-ẹ bẹ́, “Ototo, kkaan-m atin-m asok k'eninga danẹ ch'ọfọhn-nja, ọfha nd-nyena ọchattọhk e.” ’ ”<verse eid="1SA 2:36" /></para>
  <chapter eid="1SA 2" />
  <chapter number="3" style="c" sid="1SA 3" />
  <para style="s1">Ọvaar Ibinọkpaabyi oyerẹ Samwẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 3:1" />Ny'ogbe nwo, k'edikkobh chẹ, wa Samwẹl od-osi ọtọhm k'mbọhk s'Ẹli, z'ititika s'Ọvaar Ibinọkpaabyi. Ny'ogbe nwo ọdọk, wa ọgbaakadik kw'Ọvaar Ibinọkpaabyi okem ewora, obir ọgaang-ọgaangẹ bẹ́, anọng ayena ẹyaakẹ ch'idik s'Ibinọkpaabyi.<verse eid="1SA 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 3:2" />K'orungiwu wanẹ, Ẹli kw'ina ọdọk iyaan mawuriji od-oze, oyim z'ibyi s'od-okkikken oyima. <verse eid="1SA 3:2" /><verse number="3" style="v" sid="1SA 3:3" />Ny'ogbese nwo ọdọk, ottoringkkang kw'Ibinọkpaabyi otim odima. Samwẹl oyima ny'ibyi s'awuriji s'Ọvaar Ibinọkpaabyi s'masokọ Ẹkkọhbhọ ch'Echekẹ. <verse eid="1SA 3:3" /><verse number="4" style="v" sid="1SA 3:4" />Nya o, Ọvaar Ibinọkpaabyi oyerẹ Samwẹl, Samwẹl ọpọhn-ẹ bẹ́, “Kirẹ kaam ma!”<verse eid="1SA 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 3:5" />Minna kw'otim ẹbhar od-okebha Ẹli, oben-ẹ bẹ́, “Kirẹ kaam ma; mmaang ch'ayer-m.” Okenaka, Ẹli oben-ẹ bẹ́, “Zọhng yim-oyima, kọ kinyerẹ.” Samwẹl ofona od-oyim-oyima.<verse eid="1SA 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 3:6" />Ọpọhn za, Ọvaar Ibinọkpaabyi obir oyerẹ, “Samwẹl!” Samwẹl obina od-okebha Ẹli, oben-ẹ bẹ́, “Ayer-m oyerẹ, kirẹ kaam ma.”</para>
  <para style="p" vid="1SA 3:6">Ẹli oben-ẹ bẹ́, “Nnwa kwaam, kpa nnam zọhng yim-oyima, kaam kọ kinyerẹ.”<verse eid="1SA 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 3:7" />Wa ny'ogbe nwo, Samwẹl Ọvaar Ibinọkpaabyi otim ozonga; ẹyaakẹ ch'ọgbaakadik kw'Ọvaar Ibinọkpaabyi kobir oyena.<verse eid="1SA 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 3:8" />Ọvaar Ibinọkpaabyi oyerẹ Samwẹl ttong igbedim ittaan. Samwẹl obina od-okebha Ẹli oben-ẹ bẹ́, “Mmaang ch'ayer-m, kirẹ kaam ma.” Nya kw'Ẹli notinẹ bẹ́, Ọvaar Ibinọkpaabyi wọ od-oyerẹ nnwa nwo. <verse eid="1SA 3:8" /><verse number="9" style="v" sid="1SA 3:9" />Minna kw'Ẹli obenẹ Samwẹl bẹ́, “Zọhng yim-oyima, óde oyer-ọ, ben bẹ́, ‘Ọvaar Ibinọkpaabyi gbaak, ọtọhmnọng kwọ ọbhaang-ọ ka e.’ ” Minna kw'Samwẹl ọkpa nnam od-oyima z'ikẹ k'ibyi.<verse eid="1SA 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 3:10" />Ọvaar Ibinọkpaabyi okwu obe nya oyer-ẹ mach'od-oyer-ẹ k'igbe njoza bẹ́, “Samwẹl, Samwẹl!”</para>
  <para style="p" vid="1SA 3:10">Samwẹl ọpọhna bẹ́, “Gbaak e, ọtọhmnọng kwọ oyong-ọ itọhng ka e.”<verse eid="1SA 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 3:11" />Minna kw'Ọvaar Ibinọkpaabyi obenẹ Samwẹl bẹ́, “Kirẹ e, kaam m'nsi ọttọhk m'Israẹl f'im'osi ọnọng kpenamkpen kw'ọbhaang, ojor-ẹ. <verse eid="1SA 3:11" /><verse number="12" style="v" sid="1SA 3:12" />Ó̱de ógbe nwo opyirẹ, kaam m'nsi itama kpenamkpen s'mgbaakẹ mmaana echimma ch'Ẹli, tọma k'ẹtọma maa pyirẹ k'ẹkpọka. <verse eid="1SA 3:12" /><verse number="13" style="v" sid="1SA 3:13" />Kaam kk'ẹ mgbaaka bẹ́, m'mpyibh echimma chẹ aponga ttattampe okurọ mpyibha s'ikẹ ozong mawuriji. Iva pẹ alukọ kaam Ibinọkpaabyi, bẹ kocher ọchọna. <verse eid="1SA 3:13" /><verse number="14" style="v" sid="1SA 3:14" />Ofona nya, nchekẹ nnang ẹsọhmmọr ch'Ẹli bẹ́, ‘Zaabẹ́ mafọhnọ nja yen, mabir anang nnanga yen, ekpo mbyo epyibha ch'ẹsọhmmọr ch'Ẹli mèkpo ẹrọbha.’ ”<verse eid="1SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 3:15" />Samwẹl oyima maa, opyirẹ k'ekpebha, pira nogwung amma p'ọsọhm kw'Ibinọkpaabyi. Wa ojor-ẹ ojora bẹ́, otek Ẹli idik s'Ibinọkpaabyi ọyaakẹ ọnang kẹ Samwẹl. <verse eid="1SA 3:15" /><verse number="16" style="v" sid="1SA 3:16" />Okenaka, Ẹli oyer-ẹ, oben-ẹ bẹ́, “Samwẹl, nnwa kwaam.”</para>
  <para style="p" vid="1SA 3:16">Samwẹl ọpọhn-ẹ bẹ́, “Kirẹ kaam ma.”<verse eid="1SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 3:17" />Ẹli ọbọbh-ẹ bẹ́, “Bọng-odik wọ kw'ọgbaak-ọ? Kaam odik kpenamkpen kàdubh. Tte Ibinọkpaabyi ọnang-ọ irem k'eden kpenamkpen ch'ọdaak-ẹ, óde adubh-m odik kpenamkpen kw'ọgbaak-ọ.” <verse eid="1SA 3:17" /><verse number="18" style="v" sid="1SA 3:18" />Minna kw'Samwẹl ozeng otek-ẹ odik kpenamkpen. Kẹ odik kodubhọ. Ẹli ọpọhn-ẹ bẹ́, “Kẹ wọ ode Ọvaar Ibinọkpaabyi; tte osi k'ose kw'ọdaak-ẹ.”<verse eid="1SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 3:19" />Wa Ọvaar Ibinọkpaabyi oning ọmaana Samwẹl k'ose kw'obeng ochina ororo. Ẹkkaabha chẹ kede ch'Samwẹl ọgbaakẹ ch'ina eyinẹ k'ose kw'ọgbaakẹ. <verse eid="1SA 3:19" /><verse number="20" style="v" sid="1SA 3:20" />Minna kw'anọng p'Israẹl maphyir p'atọm z'Dan maa pyirẹ z'Beershẹba mabir atin bẹ́, Samwẹl ode ọgbaak-ettem ch'Ọvaar Ibinọkpaabyi k'odik ọkkọkka. <verse eid="1SA 3:20" /><verse number="21" style="v" sid="1SA 3:21" />Ọvaar Ibinọkpaabyi ochina ororo ọkọhka ifor sẹ z'Shilo, obir ozenga ny'ọgbaakadik kwẹ ọyaakẹ ifor sẹ ọnang Samwẹl.<verse eid="1SA 3:21" /></para>
  <chapter eid="1SA 3" />
  <chapter number="4" style="c" sid="1SA 4" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 4:1" />Minna kw'ọgbaakadik kw'Samwẹl ọnyaamẹ opyirẹ anọng p'Israẹl maphyir.</para>
  <para style="s1" vid="1SA 4:1">APhilistiya abọk Ẹkkọhbhọ ch'Echekẹ</para>
  <para style="p" vid="1SA 4:1">M'ogbe nwa, anọng p'Israẹl mabina ayin egbong amaana anọng p'Philistiya. Anọng p'Israẹl mayima egbong z'Ẹbẹneza, aPhilistiya ayima z'Aphẹk.<verse eid="1SA 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 4:2" />APhilistiya matọhm agbongnọng pabẹ k'ọsaabh bẹ́, makebha Israẹl. K'ose kw'egbong ndo ẹnyaamẹ, aPhilistiya makema anọng p'Israẹl, mafhọ anọng p'mm'apyirẹ nnọhna ijobh z'igbongtitika.<verse eid="1SA 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 4:3" />K'ogbe kw'agbongnọng p'arọbhọ anaanga makpa nnam z'ibhinga-byi sabẹ, asogbọhkọnọng p'Israẹl abọbh ayok bẹ́, “Osempira Ọvaar Ibinọkpaabyi otte aPhilistiya ọbọhk makema mina minna menda? Matte mọd-ọtọka Ẹkkọhbhọ ch'Echekẹ z'Shilo ọfha etor mina mofona, ebira ẹkkaana mina k'mbọhk s'awawunanọng pamina.”<verse eid="1SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 4:4" />Minna kw'anọng mbo matọhm ajinọng z'Shilo, matima Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir akwuna, ọnana ẹvaar-ẹvaar ny'njeka kw'acherubim. Iva afa p'Ẹli p'ade Hophni ọmaana Phinẹhas maninga nya amaana Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi.<verse eid="1SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 4:5" />K'ogbe kw'Ẹkkọhbhọ ndo ch'Echekẹ epyirẹ z'ibhinga-byi s'Israẹl, makwọhrọ amọng maa, izek inyengẹ. <verse eid="1SA 4:5" /><verse number="6" style="v" sid="1SA 4:6" />K'ose kw'anọng p'Philistiya mabhaang izozo njo, mabọbh bẹ́, “Bọng-izozo s'nd-mbhaanga kina ekwurọ ch'aHiburu?”</para>
  <para style="p" vid="1SA 4:6">Ch'makwu azonga bẹ́, Ẹkkọhbhọ ch'Echekẹ kk'ekwuna z'ibhinga-byi s'anọng p'Israẹl, <verse eid="1SA 4:6" /><verse number="7" style="v" sid="1SA 4:7" />aPhilistiya mbo ojor bẹ. Maben bẹ́, “Ọka vanẹ kk'ọkwa ny'abẹ k'ekwurọ. Nn'oning k'odik ma e! M'odikse nwoma otim ọd-ọza o! <verse eid="1SA 4:7" /><verse number="8" style="v" sid="1SA 4:8" />Kk'opyibha ọnang mina! Anyi wọ im'ọrọhbha mina k'mbọhk s'ọka f'oyen ẹfa minna? Aka mbo bọ asi anọng p'Ijip itama k'akira k'akira k'ogbe kw'maning z'ibyi s'anọng nna arukọ e. <verse eid="1SA 4:8" /><verse number="9" style="v" sid="1SA 4:9" />Bọnga anọng p'Philistiya, màgaangẹ ifor o. Màdo ifor mach'ajinọng, ini minna ode, mm'akwu ade abira anang aHiburu, k'ose kw'bẹ nkk'abira ada anang bọnga. Màgaangẹ ifor mach'ajinọng, màsi erima!”<verse eid="1SA 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 4:10" />Minna kw'aPhilistiya mbo marim egbong amaana anọng p'Israẹl, makema anọng p'Israẹl. Ọnọng-ọnọng ọrọbh od-odim z'ikẹ k'ikkira. Anọng p'uwa mafhọ nya makem ẹsaabha. Agbongnọng p'izek p'Israẹl p'uwa mape nya, made nnọhna arọbh attaan okwuma ichi. <verse eid="1SA 4:10" /><verse number="11" style="v" sid="1SA 4:11" />Wa aPhilistiya mabọka Ẹkkọhbhọ ch'Echekẹ; iva afa p'Ẹli, p'ade Hophni ọmaana Phinẹhas, mape nya.<verse eid="1SA 4:11" /></para>
  <para style="s1">Obo kw'Ẹli</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 4:12" />Ny'ewu ndo, ọnọng wanẹ kw'ofon k'efona ch'Bẹnjamin, otima ẹbhar obina z'igbongtitika, ochina z'Shilo, ekpo py'ifor kk'ẹyaakẹ maphyir, eso ebir ede ebon-ebonọ. <verse eid="1SA 4:12" /><verse number="13" style="v" sid="1SA 4:13" />Ch'opyirẹ nya, oze Ẹli ch'oning ẹwọr k'ogbera ny'adenkonga d'okkerẹ, okurọ ojora f'ọmaan Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi. Ch'ojinọng nwo odimẹ ny'obhon ọgbaak okpenamkpen f'oyinẹ, obhon kibungọ otto za, matọma amọng obhubhom.<verse eid="1SA 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 4:14" />Ẹli ọbhaang obhoma nwo nya, ọbọbh bẹ́, “Ẹlọ ndoma eyinẹ yen o?”</para>
  <para style="p" vid="1SA 4:14">Minna kw'ọnọng nwo oduk-oduka od-okebha Ẹli. <verse eid="1SA 4:14" /><verse number="15" style="v" sid="1SA 4:15" />Wa Ẹli node icho arọbh anna okwuma ichi k'atam, ọdọk iyaan kod-oze. <verse eid="1SA 4:15" /><verse number="16" style="v" sid="1SA 4:16" />Ọnọng nwo oben Ẹli bẹ́, “Z'igbongtitika jọ s'mfon ma e; nnọbhọ za nkwuna menda e.”</para>
  <para style="p" vid="1SA 4:16">Ẹli ọbọbh-ẹ bẹ́, “Nnwa kwaam, bọng-odik wọ oyinẹ?”<verse eid="1SA 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 4:17" />Ọnọng nwo kw'otim itekẹ njo ọpọhna bẹ́, “Anọng p'Israẹl arọbhọ z'ititika s'aPhilistiya, agbongnọng pamina kk'abira apa mawuriji. Iva pọ afa, p'ade Hophni ọmaana Phinẹhas, nkk'apa. APhilistiya kk'Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi abir abọka e.”<verse eid="1SA 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 4:18" />K'ose kw'ojinọng nwo opyi ẹmma z'Ẹkkọhbhọ ch'Echekẹ, Ẹli otto nnam-nnam ny'ogbera kw'oning, nya ch'ọnyọm ebhumma. Ọphyakẹ ẹdọngọ, ope, okurọ ch'iwa kk'ọtama, obir ọdọhbh-ọdọhbh mawuriji. Wa kẹ kk'anọng p'Israẹl eden otima k'icho arọbh afa.<verse eid="1SA 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 4:19" />Wa ọnyẹ kwẹ, kw'ode kwanọng kw'Phinẹhas otim ibhọr s'ikk'inyọma k'ọmaan. Ch'ọbhaang nya bẹ́, nkk'Ẹkkọhbhọ ch'Echekẹ abọka, ọmaana bẹ́, otte kw'odim, ọttara odim kwẹ nkk'apa, minna kw'ọmaan ọbọk-ẹ, ọmaan ny'eninga ndo. Okenaka, irem s'ọmaan mvo, inẹ-ẹ ẹfa. <verse eid="1SA 4:19" /><verse number="20" style="v" sid="1SA 4:20" />Nya ch'ina od-opope, panọng mbo p'akker-ẹ ọmaan maben-ẹ bẹ́, “Gaangẹ ettem, kk'ojinọngnwa amaana.” Okenaka, odik kọpọhn, itọhng kobir oyonga.<verse eid="1SA 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 4:21" />Kwanọng nwo okpe nnwa nwo bẹ́, Ikabọd<note caller="+" style="f"><char style="fr" closed="false">4.21 </char><char style="fq" closed="false">Ikabọd </char><char style="ft" closed="false">oyinẹ bẹ́, Abarada ọdọk kade; abarada kk'adima.</char></note>, oben bẹ́, “Abarada p'Israẹl kk'afona”. Obenẹ minna okurọ ch'mabọk Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi, ọmaana obo kw'otte kw'odim, ọttara kw'odim kwẹ. <verse eid="1SA 4:21" /><verse number="22" style="v" sid="1SA 4:22" />Oben bẹ́, “Abarada p'Israẹl kk'afona, okurọ bẹ́, nkk'Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi abọka.”<verse eid="1SA 4:22" /></para>
  <chapter eid="1SA 4" />
  <chapter number="5" style="c" sid="1SA 5" />
  <para style="s1">Masokọ Ẹkkọhbhọ ch'Echekẹ z'ibhon s'Philistiya</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 5:1" />K'ogbese kw'anọng p'Philistiya nkk'Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi abọka, matinẹ ny'Ẹbẹneza atima achina z'Ashdọd. <verse eid="1SA 5:1" /><verse number="2" style="v" sid="1SA 5:2" />Minna kw'matinẹ Ẹkkọhbhọ ndo z'ọkapa kw'masokọ ọka f'okpen Dagọn. <verse eid="1SA 5:2" /><verse number="3" style="v" sid="1SA 5:3" />K'owusobha ch'anọng p'Ashdọd naphyabh ny'ekpebha, maze bẹ́, Dagọn kk'ọtta okwubha ititika ny'izek, ny'ititika s'Ẹkkọhbhọ ch'Echekẹ! Matinẹ Dagọn abir asok z'ibyi sẹ. <verse eid="1SA 5:3" /><verse number="4" style="v" sid="1SA 5:4" />Okenaka, k'ose kw'ewu esobh nya, Dagọn kk'ọtta okwubha ititika ny'izek ny'ititika s'Ẹkkọhbhọ ch'Echekẹ! Eso chẹ ttara mbọhk kk'ekpira eyima ny'ẹsọhmma; ifor sẹ jẹ-jẹ jọ nirikẹ. <verse eid="1SA 5:4" /><verse number="5" style="v" sid="1SA 5:5" />Nya wọ osi, tọma za maa, pyirẹ ma, afọhn-nja p'Dagọn, ọttara anọng p'mad-adim z'ọkapa kw'Dagọn z'Ashdọd, nny'ẹsọhmma kad-abarẹ.<verse eid="1SA 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 5:6" />Wa Ọvaar Ibinọkpaabyi ọnang anọng p'Ashdọd ọttara ayok-nkọma irem s'ibar-ọbar mawuriji; osi bẹ itama siden, obir ọtọhbh bẹ ebirakpo. <verse eid="1SA 5:6" /><verse number="7" style="v" sid="1SA 5:7" />K'ogbe kw'anọng p'Ashdọd maze idik s'id-iyin nya, maben bẹ́, “Ẹkkọhbhọ ch'ọka f'anọng p'Israẹl kẹbaan bẹ́, eninga ma ẹmaana mina, okurọ bẹ́, kk'mina ọttara Dagọn kw'ode ọka famina irem siden ẹnanga.” <verse eid="1SA 5:7" /><verse number="8" style="v" sid="1SA 5:8" />Minna kw'mayerẹ asogbọhkọnọng p'Philistiya mabọbh bẹ bẹ́, “Mm'osi yen ọmaana Ẹkkọhbhọ ch'Echekẹ ch'ọka f'Israẹl?”</para>
  <para style="p" vid="1SA 5:8">Mapọhna bẹ́, “Màtinẹ Ẹkkọhbhọ ch'Echekẹ ch'ọka f'Israẹl tima zeng z'obhon kw'Gat.” Minna kw'matinẹ Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi kw'Israẹl atima achina z'Gat.<verse eid="1SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 5:9" />Okenaka, ch'nkk'Ẹkkọhbhọ ndo atina, wa Ọvaar Ibinọkpaabyi ọtọhmọ itama ọnang anọng p'obhon nwo, oke bẹ k'ojora fiden. Osi anọng p'ebhondim ndo itama mawuriji, tọma ny'ivava pyirẹ z'ataminọng, ọjẹ bẹ ebubuka ch'ebirakpo. <verse eid="1SA 5:9" /><verse number="10" style="v" sid="1SA 5:10" />Minna kw'matọk Ẹkkọhbhọ ndo ch'Ibinọkpaabyi mad-arik z'Ẹkrọn.</para>
  <para style="p" vid="1SA 5:10">K'ose kw'mad-atima Ẹkkọhbhọ ndo adim ny'Ẹkrọn, anọng p'Ẹkrọn abina amọng k'ẹrọng, mabhom bẹ́, “Nkk'Ẹkkọhbhọ ch'ọka f'Israẹl atọka achena mina bẹ́, ọfhọ mina ọttara anọng pamina.”<verse eid="1SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 5:11" />Minna kw'mayerẹ asonọng p'Philistiya maphyir mattonga, maben bẹ́, “Màtima Ẹkkọhbhọ ch'ọka f'Israẹl bina ma, tte ẹkpa nnam z'ibyi sẹ; ini minna ode, m'ẹfhọ mina ọttara anọng pamina.” Ny'ogbe nwo, wa ojora f'obo kk'ebhondim ndo ọbọka mawuriji, Ibinọkpaabyi obir ọnang bẹ irem siden. <verse eid="1SA 5:11" /><verse number="12" style="v" sid="1SA 5:12" />Ayok mbo p'nna ape, wa matọk irem s'ebirakpo. Ẹmọng-bhoma ch'ebhondim ndo, epyirẹ z'ẹrọng.<verse eid="1SA 5:12" /></para>
  <chapter eid="1SA 5" />
  <chapter number="6" style="c" sid="1SA 6" />
  <para style="s">Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi ekwun z'Israẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 6:1" />K'ogbe kw'Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi ikk'eninga z'ẹbhaakẹ ch'Philistiya k'aphe achenọmfa, <verse eid="1SA 6:1" /><verse number="2" style="v" sid="1SA 6:2" />anọng p'Philistiya mayerẹ afọhn-nja pabẹ ọttara abọhnganọng, maben bẹ bẹ́, “Bọng-ọttọhk f'mm'osi ọmaana Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi? Màtek mina ose kw'mm'ozenga od-orik Ẹkkọhbhọ ndo z'ibyi sẹ.”<verse eid="1SA 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 6:3" />Mapọhna bẹ́, “Ó̱de mad-arik Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi kw'Israẹl, m'mbọhk-mbọhk kàrik o. K'eden kpenamkpen, màrik chẹ ttara ẹnanga ch'matim atuk epyibha ch'masi. Nya wọ kw'mm'abina k'ikọhmaana sabọnga, mabir azonga ọttọhk f'Ibinọkpaabyi ozeng ábẹ̀ ọd-ọnang bọnga irem.”<verse eid="1SA 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 6:4" />Anọng p'Philistiya abọbh bẹ́, “Bọng-ẹnanga ch'epinẹ ch'mm'ọtọhm ochin-ẹ yirẹ?”</para>
  <para style="p" vid="1SA 6:4">Mapọhna bẹ́, “Akerim p'ebirakpo achen p'matim gol asi, ọmaana akerim p'agbomma achen p'matim gol asi, etor k'obhik f'asonọng p'Philistiya, okurọ bẹ́, itama njo iyinẹ bọnga ọmaana asonọng pabọnga. <verse eid="1SA 6:4" /><verse number="5" style="v" sid="1SA 6:5" />Màsi akerim p'ebirakpo ọmaana p'agbomma mbo p'mad-asi itama ny'ebhondim, màbira anang Ibinọkpaabyi kw'Israẹl ikpukpobha. Ṉ́nòsi, m'ọkpọka itama njo ny'abọnga k'ifor, ny'aka pabọnga, ọttara ny'izek sabọnga. <verse eid="1SA 6:5" /><verse number="6" style="v" sid="1SA 6:6" />Osempira magaangẹ nttem sabọnga mach'Phero ọmaana anọng pẹ p'Ijip masi? K'ogbe kw'uwa Ibinọkpaabyi ọnang bẹ irem, wa matte anọng p'Israẹl ọbọhk mafona.<verse eid="1SA 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 6:7" />“Madidanma, mm'asi ọkpaar kw'ogbin ọbhakwẹ, m'abira atima abhaam afa p'nkk'amaana, p'nna bẹ atima agbana. Màgbana abhaam mbo ny'ọkpaar nwo, màtọka iva pabẹ ayika z'ọsọhm kwabẹ. <verse eid="1SA 6:7" /><verse number="8" style="v" sid="1SA 6:8" />Màtọka Ẹkkọhbhọ ndo ch'Echekẹ nana ny'ọkpaar nwo kw'ogbin, pira nnatọk ekpo mbyo py'matim gol asi, py'mm'achen-ẹ mach'ẹnanga ch'epinẹ, mayika k'ikwukwu k'ẹbhaakẹ danẹ ch'ọkpaar nwo. Màtọhm ẹkkọhbhọ ndo efona, <verse eid="1SA 6:8" /><verse number="9" style="v" sid="1SA 6:9" />màninga nya kkerẹ. Ó̱de echin ẹrọng-ẹrọng z'izek sẹ, z'ẹbhaakẹ ch'Bẹt-Shẹmẹsh, oyinẹ bẹ́, Ọvaar Ibinọkpaabyi wọ ọtọhmọ itama nja ochena mina. Okenaka, óde ini nya echin, mm'ozonga bẹ́, kẹ azang ọtọhmọ itama nja ochena mina, iyinẹ k'ikẹ k'ifor.”<verse eid="1SA 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 6:10" />Nya o, masi k'ose kw'matọhnọ bẹ. Matọka abhaam mbo afa p'atim anang iva ẹba, agbana ny'ọkpaar nwo, matọka abhaamva mbo mad-ayika z'ọpa kwabẹ. <verse eid="1SA 6:10" /><verse number="11" style="v" sid="1SA 6:11" />Manana Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi ny'ọkpaar nwo, ọttara ikwukwu s'itọhk agbomma ọmaana ebirakpo py'matim gol asi. <verse eid="1SA 6:11" /><verse number="12" style="v" sid="1SA 6:12" />Nya o, abhaam mbo atta <char style="it">bẹ́ gbẹẹng</char> machina z'ẹbhaakẹ ch'Bẹt-Shẹmẹsh, mad-abok amọng k'ose kw'mazeng ny'eden. M'odimbọhk ọttara obhurubọhk kabhakẹ. Wa abaabh p'Philistiya ator bẹ maa, mapyirẹ z'enem ch'Bẹt-Shẹmẹsh.<verse eid="1SA 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 6:13" />M'ogbe nwa, wa anọng p'Bẹt-Shẹmẹsh maning z'ilokodo mad-asi ipha s'wit. K'ose kw'matinẹ achen aze Ẹkkọhbhọ ndo za, nttem idaam bẹ. <verse eid="1SA 6:13" /><verse number="14" style="v" sid="1SA 6:14" />Ọkpaar nwo okwu opyirẹ z'owonọ kw'Joshua kw'ofon Bẹt-Shẹmẹsh, ọkpọka nya ch'ọnyọm ẹtakpa chiden. Minna kw'anọng mbo atim agbaaka p'ọkpaar nwo akọma ekpon, matima abhaam mbo afọhnọ ẹja ch'ẹkwọmọ anang Ọvaar Ibinọkpaabyi. <verse eid="1SA 6:14" /><verse number="15" style="v" sid="1SA 6:15" />Anọng p'efona ch'Lẹvi asaka Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, matọka chẹ ọmaana ikwukwu s'ekpo mbyo py'gol eyik, mabera ny'ẹtakpa ndo. Ny'ewu ndo, anọng p'Bẹt-Shẹmẹsh manang nnanga s'ẹkwọmọ, mabir afọhnọ nja anang Ọvaar Ibinọkpaabyi. <verse eid="1SA 6:15" /><verse number="16" style="v" sid="1SA 6:16" />Avaarnọng mbo achen p'abaabh Philistiya aze idik nja maphyir nya o, makpa nnam z'Ẹkrọn ny'ewu ndo.<verse eid="1SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 6:17" />Ma wọ ode ebirakpo py'gol py'aPhilistiya atọhmọ anang Ọvaar Ibinọkpaabyi mach'ẹnanga ch'epinẹ: Ashdọd ọnangẹ madanẹ, Gaza ọnang madanẹ, Ashkẹlọn ọnang madanẹ, Gat ọnang madanẹ, Ẹkrọn ọnang madanẹ. <verse eid="1SA 6:17" /><verse number="18" style="v" sid="1SA 6:18" />Obhik f'agbomma p'matim gol asi wa ode k'ose kw'ibhon ichen s'avaar p'Philistiya ide, ọmaana ibhon s'igaang-ọgaangẹ, ọttara s'ikarẹ. Ẹtakpadim ndo ch'manan Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, etim ening z'owonọ kw'Joshua kw'ofon Bẹt-Shẹmẹsh mach'nttẹsẹ maa, pyirẹ m'ewu ch'menda.<verse eid="1SA 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 6:19" />Okenaka, wa Ibinọkpaabyi ọfhọ anọng banẹ p'afon Bẹt-Shẹmẹsh. Wa ọfhọ anọng arọbh attaan okwuma ijobh, okurọ ch'makkerẹ ny'ẹtaanga kw'Ẹkkọhbhọ ch'Echekẹ. Anọng mbo maninga k'isen, okurọ ch'Ọvaar Ibinọkpaabyi ọfhọ bẹ k'ọsaabh. <verse eid="1SA 6:19" /><verse number="20" style="v" sid="1SA 6:20" />Anọng p'Bẹt-Shẹmẹsh mabọbh bẹ́, “Anyi wọ im'okpo obe k'ititika s'Ọvaar Ibinọkpaabyi, Ibinọkpaabyi nwa kw'owur-owur o? Ó̱de Ẹkkọhbhọ nda ebin ma, m'etor anyi?”<verse eid="1SA 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 6:21" />Nya o, matọhm ẹkkaabha anang anọng p'Kiriyat-Jẹrim, maben bẹ bẹ́, “Anọng p'Philistiya kk'Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi arika e. Màsaka kwu tọka tima china z'abọnga k'obhon e.”<verse eid="1SA 6:21" /></para>
  <chapter eid="1SA 6" />
  <chapter number="7" style="c" sid="1SA 7" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 7:1" />Minna kw'anọng p'Kiriyat-Jẹrim azeng akwu atọka Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi. Matọka atima achina z'Abinadab k'ọsọhm kw'oning k'egbe, marọbha Eleaza kw'ode nnwa kwẹ, masok-ẹ k'ọtọhm f'm'okkerẹ Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi.<verse eid="1SA 7:1" /></para>
  <para style="s1">Samwẹl otim anọng p'Israẹl eden</para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 7:2" />Wa ogbe kk'obhira mawuriji kw'Ẹkkọhbhọ ch'Echekẹ ening z'Kiriyat-Jẹrim. Kibung-kibungọ, wa ode icho ẹrọbh. Anọng p'Israẹl maninga k'ikwosisi, mabira aror eden ch'mm'anyọma Ọvaar Ibinọkpaabyi k'ifor. <verse eid="1SA 7:2" /><verse number="3" style="v" sid="1SA 7:3" />Nya kw'Samwẹl nobenẹ anọng p'Israẹl maphyir bẹ́, “Ó̱de mm'atima nttem sabọnga maphyir akpa nnam ator Ọvaar Ibinọkpaabyi, màrọbha aka p'ibhon idọk-ọdọk ny'abọnga k'ifor, màbira arọbha aka p'Ashtọrẹt maphyir màbharẹ. Màtte ifor sabọnga ọbọhk nang Ọvaar Ibinọkpaabyi, màbira kpobha kẹ-kẹ. Minna kw'ikẹ m'ọrọbha bọnga k'mbọhk s'aPhilistiya.” <verse eid="1SA 7:3" /><verse number="4" style="v" sid="1SA 7:4" />Minna kw'anọng p'Israẹl asokọ aka p'Baal ọttara p'Ashtọrẹt okikan, makpobha Ọvaar Ibinọkpaabyi kẹ-kẹ.<verse eid="1SA 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 7:5" />Nya o, Samwẹl oben bẹ́, “Màtobha anọng p'Israẹl maphyir z'Mizpa, kaam m'nkwukọ Ọvaar Ibinọkpaabyi k'abọnga k'nso.” <verse eid="1SA 7:5" /><verse number="6" style="v" sid="1SA 7:6" />K'ogbe kw'bẹ maphyir nkk'attonga z'Mizpa, makaabha asi abyenga nya ch'Ọvaar Ibinọkpaabyi oning. Ny'ewu ndo, mayima okwo, mabira ayaakẹ mpyibha sabẹ, maben bẹ́, “Mina nkk'itama ọsa z'Ọvaar Ibinọkpaabyi k'ititika.” Wa Samwẹl wọ otim anọng p'Israẹl eden z'Mizpa.<verse eid="1SA 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 7:7" />K'ogbe kw'aPhilistiya abhaang bẹ́, anọng p'Israẹl kk'attonga z'Mizpa, asonọng p'Philistiya makwu bẹ́, marima bẹ ábẹ̀. Anọng p'Israẹl abhaanga nya o, ojora ọbọka bẹ okurọ aPhilistiya. <verse eid="1SA 7:7" /><verse number="8" style="v" sid="1SA 7:8" />Maben Samwẹl bẹ́, “Njọm kàkpọka ozize k'amina k'nso anang Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwamina, ọfha ọkkaana mina, ọrọbha mina k'mbọhk s'aPhilistiya.” <verse eid="1SA 7:8" /><verse number="9" style="v" sid="1SA 7:9" />Nya o, Samwẹl ọtọka ọrọkimaannwa kw'otim ọjaabh ẹba, ọnang Ọvaar Ibinọkpaabyi mach'ẹja ch'ẹkwọmọ. Obhom ọkpẹkẹ Ọvaar Ibinọkpaabyi k'eso ch'anọng p'Israẹl. Ọvaar Ibinọkpaabyi ọbhaang-ẹ.<verse eid="1SA 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 7:10" />Nya ch'Samwẹl ọd-ọfọhnọ ẹja ndo ch'ẹkwọmọ, aPhilistiya mbo mazenga anyọma bẹ́, makwu arima anọng p'Israẹl ábẹ̀. Minna kw'Ọvaar Ibinọkpaabyi otim ẹbhaangkpon obik etum ny'ewu ndo, ẹtta aPhilistiya mbo, eke bẹ k'damadama, ebir eke bẹ opoma, ọwọhkọ anọng p'Israẹl makwubh bẹ mawuriji. <verse eid="1SA 7:10" /><verse number="11" style="v" sid="1SA 7:11" />Anọng p'Israẹl asẹr-ọsẹr ayin z'Mizpa, makwubh aPhilistiya mbo, mapekẹ ayok banẹ ny'eden ch'echin z'izek-izek kw'Bẹt-Kar.<verse eid="1SA 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 7:12" />Ofona nya, Samwẹl ọtọka ọta ommin ny'njeka kw'Mizpa ọmaana Shen. Okpe ọta nwo Ẹbẹneza, oben bẹ́, “Minna kw'Ọvaar Ibinọkpaabyi ikk'mina ọkkaana opyirẹ.” <verse eid="1SA 7:12" /><verse number="13" style="v" sid="1SA 7:13" />Nya o, wa makema aPhilistiya, m'ọdọk ẹbhaakẹ ch'Israẹl kadimẹ.</para>
  <para style="p" vid="1SA 7:13">K'akpen p'Samwẹl maphyir, wa ọbọhk kw'Ọvaar Ibinọkpaabyi oten aPhilistiya k'itama. <verse eid="1SA 7:13" /><verse number="14" style="v" sid="1SA 7:14" />Ibhon s'Israẹl s'itọm ny'Ẹkrọn maa pyirẹ z'Gat s'iwa aPhilistiya mabọk, wa anọng p'Israẹl kk'nnam abir akpa ayena sẹ maphyir. Israẹl ọkkaana ayok-nkọma s'iwa ining k'ẹfa ch'aPhilistiya. Wa ẹmẹm ebir ekwu eninga ẹmaana Israẹl ọttara anọng p'Amọr.<verse eid="1SA 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 7:15" />Samwẹl ochina ororo otima Israẹl eden k'akpen pẹ maphyir. <verse eid="1SA 7:15" /><verse number="16" style="v" sid="1SA 7:16" />K'icho k'icho, od-ozenga ọkọbha Bẹtẹl maa opyirẹ z'Gilgal ọttara z'Mizpa, ọd-ọttọhna aponga p'Israẹl ny'obyi mvo maphyir. <verse eid="1SA 7:16" /><verse number="17" style="v" sid="1SA 7:17" />Ócher nya, wa ọd-ọkpa nnam z'Rama, za ch'obhon kwẹ oning, obir ọttọhna aponga p'Israẹl. Wa osi ija-byi nya ọnang Ọvaar Ibinọkpaabyi.<verse eid="1SA 7:17" /></para>
  <chapter eid="1SA 7" />
  <chapter number="8" style="c" sid="1SA 8" />
  <para style="s1">Anọng p'Israẹl arorọ ọvaarnọng</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 8:1" />K'ogbe kw'Samwẹl kk'ọbara k'atam, ọrọbha iva pẹ mach'akpaar-aponga p'Israẹl. <verse eid="1SA 8:1" /><verse number="2" style="v" sid="1SA 8:2" />Ochedennwa kwẹ wa okpen Joẹl, oyok kw'ottong afa okpena Abija. Wa mad-asi ọtọhm f'eponga-kpaara z'Beershẹba. <verse eid="1SA 8:2" /><verse number="3" style="v" sid="1SA 8:3" />Okenaka, iva pẹ m'ẹtọkọ chẹ katorọ. Bẹ mater ad-aror akpuka k'ẹfọraden, matọka ngwu, mabira akpa eden ch'eponga-kpaara ọkkọkka.<verse eid="1SA 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 8:4" />Minna kw'asogbọhkọnọng p'Israẹl maphyir matobh ayok makwu akebha Samwẹl z'Rama. <verse eid="1SA 8:4" /><verse number="5" style="v" sid="1SA 8:5" />Maben-ẹ bẹ́, “Kọ kk'atama; iva pọ nden sọ katorọ. Rọbha ọvaarnọng nang mina, k'ose kw'nkọma njoza iyen avaarnọng.”<verse eid="1SA 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 8:6" />Odik nwo obhem Samwẹl ettem, ch'mabenẹ bẹ́, “Nang mina ọvaarnọng kw'im'ọttọhna aponga pamina.” Ofona nya, oze njọm ọnang Ọvaar Ibinọkpaabyi. <verse eid="1SA 8:6" /><verse number="7" style="v" sid="1SA 8:7" />Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, “Yonga itọhng ny'idik njo maphyir s'anọng mbo mad-aben-ọ bẹ́, asi; kọ azang kw'anọng mbo abhumọ, kaam kw'mabhumọ nya mach'Ọvaarnọng kwabẹ. <verse eid="1SA 8:7" /><verse number="8" style="v" sid="1SA 8:8" />K'ose kw'mad-asi, tọma ny'ewu ch'nnọbh bẹ z'Ijip maa pyirẹ menda, minna kw'mad-asi anang-ọ ma. Bẹ mad-abhum-m, makpobha aka. <verse eid="1SA 8:8" /><verse number="9" style="v" sid="1SA 8:9" />Nya o, m'ayonga bẹ itọhng. Okenaka, tọr bẹ itọhng mawuriji, si bẹ mazonga ọttọhk f'ọvaarnọng nwo im'osi bẹ.”<verse eid="1SA 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 8:10" />Samwẹl ọgbaak anọng mbo p'arorọ ọvaarnọng idik njo maphyir s'Ọvaar Ibinọkpaabyi ọgbaakẹ. <verse eid="1SA 8:10" /><verse number="11" style="v" sid="1SA 8:11" />Oben bẹ bẹ́, “Idik s'ọvaarnọng kw'im'ọbaabha bọnga im'osi ide bẹ́: m'ọtọka ajinọngva pabọnga osok k'ọtọhmse mavanẹ ọmaana ijaar s'ogbin, ọttara nnyanya, f'ode bẹ́, mmin'ad-achi ijaar sẹ s'ogbin eden. <verse eid="1SA 8:11" /><verse number="12" style="v" sid="1SA 8:12" />M'osi ayok banẹ ade asonọng p'agbongnọng p'ade nnọhna k'ẹkaan, banẹ ade p'nnọhna arọbh afa okwuma ijobh k'ẹkaan, ayok banẹ m'atubh owonọ kwẹ, mabira asi ipha sẹ, mboza m'asi egbongkpo ọttara ẹtọhmkpo py'ijaar sẹ s'ogbin. <verse eid="1SA 8:12" /><verse number="13" style="v" sid="1SA 8:13" />M'ọnang panọngva pabọnga ọtọhm f'ana p'alebh eruk osisi, mabira ad-awọhn-ẹ ọchattọhk, mabira asi brẹd anang-ẹ. <verse eid="1SA 8:13" /><verse number="14" style="v" sid="1SA 8:14" />M'ọtọka iwonọ ọkkọkka sabọnga, ọmaana iwonọ s'grep sabọnga ọttara s'oliv, ọnang atọhmnọng pẹ. <verse eid="1SA 8:14" /><verse number="15" style="v" sid="1SA 8:15" />M'ọtọka ekpo py'mapha z'iwonọ sabọnga s'achimọma, ọmaana py'grep, okebh k'ibyi ijobh, ọtọka igboka janẹ ọnang adidennọng ọttara atọhmọ pẹ. <verse eid="1SA 8:15" /><verse number="16" style="v" sid="1SA 8:16" />M'ọtọka atọhmnọng pabọnga k'ejinọng ọttara k'ẹpanọng, ọmaana adikkobh akkọkka pabọnga, ọttara nnyanya sabọnga osok k'ọtọhm fẹ. <verse eid="1SA 8:16" /><verse number="17" style="v" sid="1SA 8:17" />M'okebh etirakpo pyabọnga k'ibyi ijobh, ọtọka igboka janẹ oyena. Bọnga makpa nnam ade abira pẹ. <verse eid="1SA 8:17" /><verse number="18" style="v" sid="1SA 8:18" />Éwu ndo epyirẹ, bọnga mm'abhom ẹkkaana akpẹkẹ ọvaarnọng nwo kw'nkk'ateka, Ọvaar Ibinọkpaabyi bọnga ọgba mọ̀kkọra.”<verse eid="1SA 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 8:19" />Okenaka, anọng mbo mabhum odik kw'Samwẹl, m'ikẹ itọhng kayong, maben bẹ́, “Mma e! Mororọ ọvaarnọng kw'm'ọbaabha mina, <verse eid="1SA 8:19" /><verse number="20" style="v" sid="1SA 8:20" />mfha mode mach'nkọma njoza maphyir. Ọvaarnọng nwo wọ m'ọbaabha mina, obir ochi mina eden k'mgbong samina.”<verse eid="1SA 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 8:21" />K'ogbe kw'Samwẹl ọbhaang idik njo maphyir s'anọng mbo agbaakẹ, kẹ obir ọgbaak Ọvaar Ibinọkpaabyi k'ose kw'anọng mbo magbaakẹ. <verse eid="1SA 8:21" /><verse number="22" style="v" sid="1SA 8:22" />Ọvaar Ibinọkpaabyi ọpọhna bẹ́, “Yonga bẹ itọhng, nang bẹ ọvaarnọng.”</para>
  <para style="p" vid="1SA 8:22">Nya o, Samwẹl oben ajinọng p'Israẹl bẹ́, “Ọnọng kpenamkpen ọkpa nnam z'ikẹ k'obhon.”<verse eid="1SA 8:22" /></para>
  <chapter eid="1SA 8" />
  <chapter number="9" style="c" sid="1SA 9" />
  <para style="s1">Samwẹl obyeng Saul ana k'eso</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 9:1" />Wa oyen ojinọng wanẹ kw'ofon k'efona ch'Bẹnjamin kw'oyinẹ eche mawuriji. Ojinọng nwo okpen Kish, kw'ode nnwa kw'Abiyẹl, kw'ode nnwa kw'Zẹrọ, kw'ode nnwa kw'Bekorat, kw'ode nnwa kw'Aphiya kw'ofon Bẹnjamin. <verse eid="1SA 9:1" /><verse number="2" style="v" sid="1SA 9:2" />Wa oyen ojinọngnwa ọkkọkka kw'okpen Saul kw'ina okerim oyen ny'Israẹl. Kẹ oyen ebe ọyọhnga anọng maphyir p'abe nya, tọma ny'mbubaang.<verse eid="1SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 9:3" />Nnyanya s'Kish kw'ode otte kw'Saul ikwu idimẹ, oben nnwa kwẹ Saul bẹ́, “Tima ọtọhmnọng wanẹ màzọhng ror nnyanya njo.” <verse eid="1SA 9:3" /><verse number="4" style="v" sid="1SA 9:4" />Minna kw'ozeng ny'ogbe-bhon kw'Ephraim ọmaana ny'ẹbhaakẹ ch'Shalisha, m'bẹ kaze. Machina z'ẹbhaakẹ ch'Shaalim, okenaka, nnyanya njo nya kide. Nya o, ozenga z'ẹbhaakẹ ch'Bẹnjamin, okenaka, m'jẹ kaze.<verse eid="1SA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 9:5" />K'ogbe kw'mapyirẹ z'ẹbhaakẹ ch'Zuph, Saul oben ọtọhmnọng kw'oning ọmaana bẹ́, “Tte mọkpa nnam z'oter; ini minna ode, atte kwaam m'ọzaama odik kw'nnyanya njo, otera ọyọhn ettem k'amina e.”<verse eid="1SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 9:6" />Ọtọhmnọng nwo ọpọhn-ẹ bẹ́, “Kirẹ e, oyen ọnọng wanẹ kw'Ibinọkpaabyi kw'orukọ m'obhon nwoma, makpobh-ẹ mawuriji. Odik kpenamkpen kw'ọgbaakẹ od-oyin mach'obenẹ. Tte mọd-ọzẹ-ẹ. Ṉ́nòsi, m'otek minna ose kw'mm'otima ochina.”<verse eid="1SA 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 9:7" />Saul ọbọbh-ẹ bẹ́, “Ó̱de m'ọd-ọzẹ-ẹ, mm'ọnang-ẹ mbọng? Ọchattọhk ọdọk k'amina k'ẹkpa korikẹ, m'ọttọhk kobir oyena f'mm'ọnang-ẹ. Ma, m'oyen za yirẹ?”<verse eid="1SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 9:8" />Ọtọhmnọng nwo ọpọhna bẹ́, “Kaam nyen ibhaaka s'shẹkẹl ma e. M'nnang ọnọng nwo kw'Ibinọkpaabyi, ọfha otek mina eden ch'mm'ochina.” <verse eid="1SA 9:8" /><verse number="9" style="v" sid="1SA 9:9" />(Wa z'Israẹl, óde ọnọng ọkamẹ bẹ́, oror odik ọbọbh Ibinọkpaabyi, kẹ m'oben bẹ́, “Màkwu mod-oze ọnọng kw'oze iyaan,” okurọ bẹ́, agbaak-ettem ch'Ibinọkpaabyi p'maamba wa mad-ayerẹ bẹ bẹ́, aze-iyaan.)<verse eid="1SA 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 9:10" />Saul oben ọtọhmnọng kwẹ bẹ́, “Ojibh-ojibh, kwu mofona.” Minna kw'mabin ozenga machina z'obhon kw'ọnọng nwo kw'Ibinọkpaabyi oning.<verse eid="1SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 9:11" />K'ose kw'mad-avura egbe bẹ́, madim z'obhon, mattema ọmaana aminava p'akwu bẹ́, makaabha asi, mabọbh bẹ bẹ́, “Ma, oze-iyaan oning ma o?”<verse eid="1SA 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 9:12" />Mapọhn-ẹ bẹ́, “Iye e, oning ma e. Kk'ọ eden ọcha. Sẹr-ọsẹr, kirẹ kẹ kk'ọkwa m'amina k'obhon menda okurọ bẹ́, anọng p'obhon nwa mm'afọhnọ ẹja z'ija-byi. <verse eid="1SA 9:12" /><verse number="13" style="v" sid="1SA 9:13" />K'ose kw'adimẹ ny'obhon, m'azẹ-ẹ pira od-ochi ọttọhk z'ija-byi. Anọng m'ọttọhk màtọma ochichi, oyebẹ kk'ọkwa, okurọ bẹ́, m'okwu odo ẹja ndo. Ó̱de ikk'ọda maphyir pira anọng p'nkk'aphya, machi. Zọhng madidaanma, m'azẹ-ẹ yina-yina ma.”<verse eid="1SA 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 9:14" />Minna kw'machin z'obhon. K'ose kw'mad-adim odim z'obhon, nya kw'maze Samwẹl ch'od-ozenga ọnyọma bẹ, od-ochina z'ija-byi.<verse eid="1SA 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 9:15" />Nya ch'ewu esobh, pira Saul okwu, Ọvaar Ibinọkpaabyi kk'ọyaaka ọnang Samwẹl bẹ́, <verse eid="1SA 9:15" /><verse number="16" style="v" sid="1SA 9:16" />“Ophyinẹ ogbese nwa, m'ntọhm ojinọng wanẹ kw'ofon obhon kw'Bẹnjamin nchen-ọ. M'abyeng-ẹ ana k'eso mach'ọnọng kw'im'ọbaabha anọng paam, Israẹl. Kẹ wọ im'ọrọbha anọng paam z'mbọhk s'aPhilistiya. Kaam kk'anọng paam otum nka, okurọ bẹ́, ẹmọng chabẹ kk'aam epyira.”<verse eid="1SA 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 9:17" />K'ogbe kw'Samwẹl oze Saul, Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, “Ọnọng kw'ntek-ọ wọ ma e. Kẹ wọ im'ọbaabha anọng paam e.”<verse eid="1SA 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 9:18" />Minna kw'Saul ozeng okebha Samwẹl ny'ebhumma, ọbọbh-ẹ bẹ́, “Ototo, tibh-m ọsọhm kw'oze-iyaan.”<verse eid="1SA 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 9:19" />Samwẹl ọpọhn-ẹ bẹ́, “Kaam wọ nde oze-iyaan nwo. Kọ chi-m eden china z'ibyi s'ẹja, okurọ bẹ́, bọnga mm'achi ọttọhk amaan-m menda. Ophyinẹ k'ekpebha kw'im'ntek-ọ okpenamkpen f'oning-ọ ny'ettem. <verse eid="1SA 9:19" /><verse number="20" style="v" sid="1SA 9:20" />Ṉ́nòde nnyanya njo s'ikk'idima k'iwu ittaan ma, ọdọk ettem nya kàyọhn, nkk'jẹ aza. Ettem ch'Israẹl maphyir neyik k'ikọ ọttara efona ch'atte maphyir.”<verse eid="1SA 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 9:21" />Saul ọpọhna bẹ́, “Kaam mfon k'efona ch'Bẹnjamin ch'ẹchamẹ ọtam ny'Israẹl, ẹnọmma chaam ebir ẹchamẹ ẹyọhnga ayok maphyir. Osempira agbaak odikse nwo anang-m?”<verse eid="1SA 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 9:22" />Nya o, Samwẹl otima Saul ọttara ọtọhmnọng kwẹ odim ny'ọsọhm nwo, okebha anọng mboza ẹrọbh okwuma ijobh p'nkk'aphya, osok bẹ ny'ititika sabẹ. <verse eid="1SA 9:22" /><verse number="23" style="v" sid="1SA 9:23" />Samwẹl oben oyok kw'ọwọhnọ ọttọhk bẹ, “Chen-m eten ndo ch'iwura nnang-ọ bẹ́, akọm asok.”<verse eid="1SA 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 9:24" />Minna kw'oyok kw'ọwọhnọ ọttọhk ọtọk otentaak nwo kibungọ ọjẹ Saul ny'ititika. Samwẹl oben-ẹ bẹ́, “Ma wọ ode ọttọhk f'masok-ọ. Chi, okurọ bẹ́, wura makọm asok kọ okurọ eninga nda, tọma z'ogbe kw'mbenẹ bẹ́, kk'anọng eninga mphya.” Minna kw'Saul ochi ọttọhk ọmaana Samwẹl ny'ewu ndo.<verse eid="1SA 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 9:25" />K'ogbe kw'nkk'abina z'ija-byi njo makwuna k'obhon, Samwẹl oninga z'ọsọhm ẹrọng, ọgbaak odik ọmaana Saul. <verse eid="1SA 9:25" /><verse number="26" style="v" sid="1SA 9:26" />Ch'maphyabh ny'ekpebha, Samwẹl oyerẹ Saul kw'oning z'ọsọhm ẹrọng, oben-ẹ bẹ́, “Do ifor, nd-nrik-ọ z'eden, abhana.” K'ogbe kw'Saul kk'ifor ọda, kẹ ọmaana Samwẹl matọn ayin k'iyaan. <verse eid="1SA 9:26" /><verse number="27" style="v" sid="1SA 9:27" />K'ose kw'nkk'azenga anyọma z'ẹkpọka ch'obhon nwo, Samwẹl oben Saul bẹ́, “Ben ọtọhmnọng nwo ochi mina eden ofona.” Ọtọhmnọng nwo osi k'ose kw'oben-ẹ. Pira Samwẹl obenẹ Saul bẹ́, “Kọ ninga ma maan-m, ọfha nnang-ọ ẹkkaabha ch'efon z'Ibinọkpaabyi.”<verse eid="1SA 9:27" /></para>
  <chapter eid="1SA 9" />
  <chapter number="10" style="c" sid="1SA 10" />
  <para style="s">Samwẹl obyeng Saul ana k'eso</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 10:1" />Nya o, Samwẹl ọtọka idima s'ana, obyenga Saul ana ny'eso, pira ọbaak-ẹ, oben bẹ́, “Ọvaar Ibinọkpaabyi kk'ọ ana obyenga k'eso bẹ́, abaabha anọng p'Israẹl, p'ade anọng pẹ oyenẹ. <verse eid="1SA 10:1" /><verse number="2" style="v" sid="1SA 10:2" />Ó̱de abin arik-m menda, m'attema ọmaana anọng afa za ch'ọnyọm epekwuk ch'Rachẹl z'Zẹlza ny'enem ch'Bẹnjamin. Mm'aben-ọ bẹ́, nkk'nnyanya njo s'afon ad-aror aza. Atte ọdọk odik kwabẹ kobenẹ. Noter ọyọhn ettem k'ikọ e. Ọbọbhọ ka bẹ́, ‘M'nsi yen k'nnwa kwaam o?’ ”<verse eid="1SA 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 10:3" />“Nya o, m'abina nya, afona maa, apyirẹ z'echi chiden ch'Tabọr. Anọng attaan p'ad-achina z'Bẹtẹl bẹ́, mad-akpobha Ibinọkpaabyi mm'akebh-ọ nya. Ọnọng wanẹ m'ọtọhka avuva attaan, wanẹ m'ọtọhka abrẹd-duk attaan, nwoza ọtọhka ituk-zọhka. <verse eid="1SA 10:3" /><verse number="4" style="v" sid="1SA 10:4" />Mm'azim-ọ, mm'anang-ọ abrẹd-duk afa, p'm'atọka z'abẹ k'mbọhk.<verse eid="1SA 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 10:5" />“Ó̱de nwo nya ọsa nya, kọ m'achina z'Gibea kw'Ibinọkpaabyi, za ch'aPhilistiya mad-aninga. K'ose kw'adimẹ ny'obhon, m'attema ọmaana ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi ch'mad-akwuna z'ija-byi ọmaana anọng p'atim okira kw'agim-ogim, ọmaana mbin, ọmaana nsa s'mad-aje, ọmaana agaang p'mad-akir matima achi bẹ eden, ch'nd-agbaak nkkaabha. <verse eid="1SA 10:5" /><verse number="6" style="v" sid="1SA 10:6" />Egwugwuma ch'Ibinọkpaabyi m'ẹsaka k'ẹfa ẹnwọ-ọ z'ifor, kọ abir ator bẹ magbaak ettem ch'Ibinọkpaabyi. Minna kw'im'abhakẹ azeng ọnọngkira ọdọk-ọdọk. <verse eid="1SA 10:6" /><verse number="7" style="v" sid="1SA 10:7" />K'ogbe kw'nkọhka nja iyinẹ mbengana, si ọttọhk kpenamkpen f'atim k'ọbọhk ny'ogbe nwo, kirẹ Ibinọkpaabyi noning ọmaan-ọ.<verse eid="1SA 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 10:8" />“Kọ m'achi-m eden achina z'Gilgal. Kaam m'nkwu nkebh-ọ nya, mfọhnọ nja s'ẹkwọmọ ọttara s'eforgbaka. Kọ m'aninga atik-m k'iwu ichenọmfa pira nkwu ntibh-ọ ọttọhk f'im'asi.”<verse eid="1SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 10:9" />Nya ch'Saul obin bẹ́, ofona orik Samwẹl, Ibinọkpaabyi obhona ettem ch'Saul. Nkọhka njo maphyir iyin mbengana ny'ewu ndo. <verse eid="1SA 10:9" /><verse number="10" style="v" sid="1SA 10:10" />Ch'makwu apyirẹ ny'Gibea, ẹkaan ndo ch'agbaak-ettem ch'Ibinọkpaabyi ettema ẹmaan-ẹ, egwugwuma ch'Ibinọkpaabyi ẹsaka k'ẹfa ẹnwa Saul k'ifor, otor bẹ magbaak ettem ch'Ibinọkpaabyi. <verse eid="1SA 10:10" /><verse number="11" style="v" sid="1SA 10:11" />K'ogbe kw'anọng mbo maphyir p'uwa nkk'ẹ azonga maze ch'ọd-ọgbaak ettem ch'Ibinọkpaabyi ọmaana ayok, mabọbh ayok bẹ́, “Bọng-odik wọ oyinẹ ọmaana nnwa kw'Kish o? Saul kẹ obir ọttara k'ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi o?”<verse eid="1SA 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 10:12" />Ojinọng wanẹ kw'orukọ nya ọpọhna bẹ́, “Anyi wọ obir ode otte kwabẹ?” Tọma nya, nokwu ode ẹzẹmẹ ch'anọng ad-agbaak bẹ́, “Saul kẹ obira ọttara k'ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi o?” <verse eid="1SA 10:12" /><verse number="13" style="v" sid="1SA 10:13" />Ch'Saul kk'ettem ch'Ibinọkpaabyi ọgbaaka maphyir, obina ochina z'ija-byi.<verse eid="1SA 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 10:14" />Ny'ogbe nwo, ọgbaanotte kw'otte kw'Saul ọbọbh Saul ọmaana ọtọhmnọng kwẹ bẹ́, “Tọma k'ogbe, maning men o?”</para>
  <para style="p" vid="1SA 10:14">Saul ọpọhna bẹ́, “Mod-oror nnyanya njo e. Ch'nna bẹ oze, mochina z'Samwẹl.”<verse eid="1SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 10:15" />Ọgbaanotte kw'otte kw'Saul oben-ẹ bẹ́, “Tek-m odik kw'Samwẹl otek-ọ.”<verse eid="1SA 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 10:16" />Saul ọpọhn-ẹ bẹ́, “Ọgbaakẹ mina bẹ́, nkk'nnyanya njo aza k'odik ọkkọkka.” Saul ọgbaanotte kw'otte odik kw'Samwẹl ọgbaak-ẹ kw'ọmaan ẹvaar, kotekẹ.<verse eid="1SA 10:16" /></para>
  <para style="s">Masi Saul ẹvaar</para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 10:17" />Samwẹl owon anọng p'Israẹl kibungọ bẹ́, makwu attonga z'Ọvaar Ibinọkpaabyi k'ititika z'Mizpa. <verse eid="1SA 10:17" /><verse number="18" style="v" sid="1SA 10:18" />Oben bẹ bẹ́, “Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi kw'Israẹl ọgbaakẹ: ‘Wa kaam nnọbh anọng p'Israẹl z'mbọhk s'anọng p'Ijip ntima nyin k'iyaan, nsi bọnga manaanga k'mbọhk s'anọng p'Ijip ọmaana s'ibhon njoza maphyir s'inang bọnga irem.’ <verse eid="1SA 10:18" /><verse number="19" style="v" sid="1SA 10:19" />Madidanma, bọnga nkk'Ibinọkpaabyi abhuma, kẹ kw'ọkkaan bọnga, obir ọrọbha bọnga k'itama kpenamkpen ọttara irem. Bọnga nnabenẹ bẹ́, ‘Nang mina ọvaarnọng kw'm'ọbaabha mina.’ Ofona nya, màyin kwu be Ọvaar Ibinọkpaabyi m'ititika k'ose kw'inọmma ọttara mfona sabọnga ide.”<verse eid="1SA 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 10:20" />K'ogbe kw'Samwẹl otim mfonamma s'Israẹl maphyir oyin ka, wa mabharẹ ọsẹ, otto k'ẹnọmma ch'Bẹnjamin. <verse eid="1SA 10:20" /><verse number="21" style="v" sid="1SA 10:21" />Okwu oyerẹ ẹnọmma ch'Bẹnjamin k'ẹsọhmmọr k'ẹsọhmmọr. Ọsẹ otto k'ẹsọhmmọr ch'Matri. K'okpongannamgbe, ọsẹ otto k'Saul kw'ode nnwa kw'Kish. Okenaka, maror-ẹ, m'ikẹ kaze. <verse eid="1SA 10:21" /><verse number="22" style="v" sid="1SA 10:22" />Minna kw'machin ororo abọbh Ọvaar Ibinọkpaabyi bẹ́, “Ma, ojinọng nwa kk'opyira ma yirẹ?”</para>
  <para style="p" vid="1SA 10:22">Ọvaar Ibinọkpaabyi ọpọhna bẹ́, “Iye, kẹ kk'otubha ny'ibyi s'masokọ ekpo pyabọnga e.”<verse eid="1SA 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 10:23" />Matima ẹbhar mad-atọk-ẹ atima ayin ka. K'ose kw'obe nya ọmaana ayok, wa ọtọm ny'mbubaang ọyọhnga anọng maphyir ebe. <verse eid="1SA 10:23" /><verse number="24" style="v" sid="1SA 10:24" />Samwẹl oben anọng mbo maphyir bẹ́, “Nkk'ọnọng kw'Ọvaar Ibinọkpaabyi ikk'otéka aza? Ma anọng mba maphyir, ọnọng kw'ode mach'ikẹ kode.”</para>
  <para style="p" vid="1SA 10:24">Minna kw'anọng mbo akwọhrọ k'ẹrọng bẹ́, “Tte ọvaarnọng oruk akpen p'adum-odum.”<verse eid="1SA 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 10:25" />Samwẹl osi ẹyaakẹ ch'ẹmaan asana p'abaabh ẹvaar ndo ọnang bẹ. Ọkkẹr k'nnwẹr ọtọka osok nya ch'Ibinọkpaabyi oning. Pira noffurọ anọng mbo, ọnọng-ọnọng ọbhana z'ikẹ k'ọsọhm.<verse eid="1SA 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 10:26" />Saul obir ọbhana z'ikẹ k'ọsọhm z'Gibea. Áfànọng mbo p'Ibinọkpaabyi ikk'nttem sabẹ ọtwa, mator-ẹ mafona. <verse eid="1SA 10:26" /><verse number="27" style="v" sid="1SA 10:27" />Okenaka, akọhrnọng banẹ mad-aben bẹ́, “Yen kw'ọnọng nwoma m'ozenga ọkkaana mina?” M'ikẹ mach'ọttọhk katọk, m'ikẹ nnanga kàbira anang. Okenaka, Saul omyi nya <char style="it">bẹ́ takam</char>.<verse eid="1SA 10:27" /></para>
  <chapter eid="1SA 10" />
  <chapter number="11" style="c" sid="1SA 11" />
  <para style="s">Saul ọkkaan anọng p'Jabesh</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 11:1" />Wa ọvaar Nahash kw'ọbaabh ẹkọma ch'Amọn otim agbongnọng pẹ ọd-ọkọbha obhon kw'Jabẹsh-Gilead oke k'ettem. Anọng p'Jabẹsh maben Nahash bẹ́, “Si echekẹ ọmaana mina, mfha mina mm'oninga izek-izek kwọ.”<verse eid="1SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 11:2" />Okenaka, Nahash ọpọhna bẹ́, “Kaam m'nsi echekẹ mmaana bọnga óde nkk'achera bẹ́, nnọbha idimbọhk-chen s'ọnọng-ọnọng, ọfha ntima nlẹkẹ Israẹl kibungọ.”<verse eid="1SA 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 11:3" />Asonọng p'Jabesh maben-ẹ bẹ́, “Tte mina ọbọhk k'iwu ichenọmfa, ọfha m'ọtọhm azeng-eden pamina z'Israẹl maphyir. Ó̱de nna ọnọng oze kw'ọkkaan mina, mm'otte ifor samina ọbọhk ọnang-ọ.”<verse eid="1SA 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 11:4" />K'ose kw'azeng-eden mbo makwu atek anọng ẹkkaabha ndo z'Gibea, kw'ode obhon kw'Saul, bẹ maphyir mabhom ẹmọng ẹkpa-ẹkpa. <verse eid="1SA 11:4" /><verse number="5" style="v" sid="1SA 11:5" />Ny'ogbese nwo, Saul ọyakẹ abhaam pẹ nnam, od-okwun-okwuna z'owonọ kwẹ, ọbọbh bẹ bẹ́, “Bọng-odik wọ oyinẹ ọmaana anọng o? Bọng-ọttọhk vọ f'anọng mad-abhom?” Minna kw'mabira agbaak-ẹ odik kw'anọng p'Jabesh nkk'agbaaka.<verse eid="1SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 11:6" />Saul ọbhaang idik sabẹ nya o, Egwugwuma ch'Ibinọkpaabyi ẹsaka k'ẹfa, ẹnwẹ-ẹ k'ifor, ẹsẹ-ẹ ettem epyibh-ẹ mawuriji. <verse eid="1SA 11:6" /><verse number="7" style="v" sid="1SA 11:7" />Minna kw'ọtọk abhaam afa ọjọhkọ <char style="it">ma zẹkẹzẹkẹ</char>, ọnang azeng-eden matima awon ẹmọng akọbha Israẹl maphyir, mad-aben bẹ́, “Minna kw'im'ode ọmaana abhaam p'ọnọng kpenamkpen kw'obhumọ Saul ọmaana Samwẹl otitor.” Ofona nya o, ojora f'Ibinọkpaabyi odim anọng mbo, bẹ maphyir makwu azenga ẹkaan madanẹ. <verse eid="1SA 11:7" /><verse number="8" style="v" sid="1SA 11:8" />Ch'Saul otobh bẹ k'ibyi majanẹ z'Bẹzẹk, agbongnọng p'Israẹl ade nnọhna ẹnọhna okwuma nnọhna arọbh ichi kkamfa okwuma ijobh, ayok p'Juda made nnọhna arọbh attaan okwuma ichi.<verse eid="1SA 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 11:9" />Maben azeng-eden mbo p'abin z'Jabẹsh-Gilead bẹ́, “Màtek ajinọng p'Jabẹsh-Gilead bẹ́, ‘Ophyinẹ k'ogbe kw'echekira kk'ẹgaanga, bọnga mm'ayena ẹnaanga.’ ” Ch'azeng-eden mbo mad-agbaak ajinọng p'Jabẹsh ẹkkaabha ndo, nttem ilebh bẹ mawuriji. <verse eid="1SA 11:9" /><verse number="10" style="v" sid="1SA 11:10" />Maben anọng p'Ammọn bẹ́, “Ophyinẹ mm'otte ifor samina ọbọhk ọnang bọnga, masi mina k'ose kw'ọdaakẹ bọnga.”<verse eid="1SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 11:11" />Ewu esobh nya, Saul okebh agbongnọng pẹ k'nkwurọ ittaan. K'ekpikpebha erungọ, madim z'ibhinga-byi s'anọng p'Ammọn, mafhọ bẹ maa, ewu ẹgaangẹ. Ayok p'arọbhọ anaanga, maraamẹ k'ibyi k'ibyi. Anọng afa kade p'abir aninga k'ibyi majanẹ.<verse eid="1SA 11:11" /></para>
  <para style="s1">Ẹvaar-dibha ch'Saul</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 11:12" />Ny'ogbe nwo, anọng banẹ nabenẹ Samwẹl bẹ́, “Bọng-anọng bọ wendo mad-abọbh bẹ́, ‘Saul ọdọk mobir ọbaabh mina o?’ Màtima ajinọng mbo yin ka, mọfhọ bẹ.”<verse eid="1SA 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 11:13" />Okenaka, Saul oben bẹ́, “Menda m'ọnọng mafhọ, okurọ bẹ́, ewu nda dọ ch'Ọvaar Ibinọkpaabyi ọkkaan Israẹl.”<verse eid="1SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 11:14" />Nya o, Samwẹl oben anọng mbo bẹ́, “Màkwu mochina z'Gilgal, mọd-ọtaam ẹvaar ndo.” <verse eid="1SA 11:14" /><verse number="15" style="v" sid="1SA 11:15" />Minna kw'anọng mbo maphyir mabin, mad-asi Saul ẹvaar z'Gilgal, ny'ititika s'Ọvaar Ibinọkpaabyi. Mafọhnọ ẹja ch'nnanga s'eforgbaka nya, manang Ọvaar Ibinọkpaabyi. Saul ọmaana anọng p'Israẹl maphyir masi odidaama kwiden.<verse eid="1SA 11:15" /></para>
  <chapter eid="1SA 11" />
  <chapter number="12" style="c" sid="1SA 12" />
  <para style="s">Okpongannamdik kw'Samwẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 12:1" />Samwẹl oben anọng p'Israẹl maphyir bẹ́, “Kaam kk'itọhng nyonga k'idik maphyir s'magbaak-m, kk'bọnga ọvaarnọng nnanga kw'm'ọbaabha bọnga. <verse eid="1SA 12:1" /><verse number="2" style="v" sid="1SA 12:2" />M'ogbe nwa, nkk'ọvaarnọng ayena kw'im'otima bọnga eden. Ṉ́nòde kaam, kk'ntama, mbir mmen asokora. Ajinọngva paam mabira aning ma amaana bọnga. Kaam kk'bọnga mbaabha, tọma z'edikkobh chaam maa, pyirẹ m'ewu ch'menda. <verse eid="1SA 12:2" /><verse number="3" style="v" sid="1SA 12:3" />Kirẹ kaam wọ mbe ma. Màtek-m mpinẹ saam m'ititika s'Ọvaar Ibinọkpaabyi, ọttara s'ọnọng kw'ikk'ana obyenga k'eso. Ẹbhaam ch'anyi ch'ikk'ntọka? Ẹnyanya ch'anyi ch'ikk'ntọka? Anyi kw'ikk'ntuka? Anyi kw'ikk'nsa akpen akọhn-ẹ? Anyi wọ kw'ikk'ngwu kwẹ ncha pira mpyibh ọnọng aponga? Ó̱de ikk'ọttọhk mavanẹ ny'idik njo s'ntta nya nsa, màtek-m, kaam m'ndo sẹ.”<verse eid="1SA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 12:4" />Mapọhna bẹ́, “Mina kàtwukọ, akpen kabir asi makọhn ọnọng, ọttọhk f'ọnọng kabir atọka.”<verse eid="1SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 12:5" />Samwẹl oben bẹ bẹ́, “Ọvaar Ibinọkpaabyi ọmaana ọnọng kw'ikk'ana obyenga k'eso bọ ade nttẹsẹ kwaam m'ewu nda bẹ́, bọnga m'epinẹ kpenamkpen m'kaam k'ifor kaze.”</para>
  <para style="p" vid="1SA 12:5">Bẹ mapọhn-ẹ bẹ́, “Kẹ Ibinọkpaabyi wọ ode nttẹsẹ majijik.”<verse eid="1SA 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 12:6" />Nya o, Samwẹl oben anọng mbo bẹ́, “Ọvaar Ibinọkpaabyi wọ uwa otek Mosẹs ọttara Aarọn, matima ab'ttatta pabọnga abina z'Ijip. <verse eid="1SA 12:6" /><verse number="7" style="v" sid="1SA 12:7" />Ofona nya, màkwu be ma, okurọ bẹ́, m'mgbaak bọnga m'ititika s'Ọvaar Ibinọkpaabyi, idik s'itor-otor maphyir s'Ọvaar Ibinọkpaabyi ikk'ọsa ọnang bọnga ọttara ab'ttatta pabọnga.<verse eid="1SA 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 12:8" />“K'ogbe kw'uwa Jekọb kk'ochina z'Ijip, mabhom ẹmọng akpẹkẹ Ọvaar Ibinọkpaabyi. Ofona nya, Ọvaar Ibinọkpaabyi ọtọhm Mosẹs ọmaana Aarọn, p'matim ab'ttatta pabọnga abina z'Ijip, masi oruk kwabẹ m'izek nja.<verse eid="1SA 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 12:9" />“Okenaka, mazaama Ọvaar Ibinọkpaabyi kwabẹ. Ofona nya o, ọtọka bẹ oke k'mbọhk s'Sisẹra kw'ode oso kw'asoja p'Hazọ, ọmaana k'mbọhk s'aPhilistiya, ọttara k'mbọhk s'ọvaarnọng kw'ọbaabh Moab, marima bẹ ábẹ̀. <verse eid="1SA 12:9" /><verse number="10" style="v" sid="1SA 12:10" />Minna kw'mabhomọ ẹmọng akpẹkẹ Ọvaar Ibinọkpaabyi bẹ́, ‘O Ọvaar Ibinọkpaabyi, nkk'epyibha ọsa, mobir ọzaam-ọ, motera okpobha aka p'Baal ọmaana p'Ashtọrẹt. Okenaka, rọbha mina z'mbọhk s'awawunanọng pamina, mina mm'okpobh-ọ.’ <verse eid="1SA 12:10" /><verse number="11" style="v" sid="1SA 12:11" />Nya o, Ọvaar Ibinọkpaabyi ọtọhm Jerubaal, ọmaana Barak, ọmaana Jẹphta, ọttara Samwẹl, mọrọbha bọnga z'mbọhk s'awawunanọng pabọnga, mfha maruk k'ọdaam.<verse eid="1SA 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 12:12" />“Okenaka, ch'nnaze bẹ́, ọvaar Nahash kw'Ammọn min'orima egbong ọmaana bọnga, maben-m bẹ́, ‘Mma e, mororọ ọvaarnọng kw'm'ọbaabha mina,’ chibhẹ ch'ode bẹ́, Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabọnga wọ uwa ode bọnga Ọvaarnọng. <verse eid="1SA 12:12" /><verse number="13" style="v" sid="1SA 12:13" />Nya o, ma wọ ode ọvaarnọng kw'nkk'atéka, kw'ode nwo kw'marorọ. Màze e, Ọvaar Ibinọkpaabyi kk'bọnga ọvaarnọng ọnanga. <verse eid="1SA 12:13" /><verse number="14" style="v" sid="1SA 12:14" />Ó̱de bọnga mayen ojora f'Ibinọkpaabyi, makpobh-ẹ, m'eso kagaangẹ ọmaana asana pẹ, óde bọnga ọttara ọvaarnọng kw'ọbaabh bọnga matorọ eden ch'Ọvaar Ibinọkpaabyi, m'ojibh ọnang bọnga. <verse eid="1SA 12:14" /><verse number="15" style="v" sid="1SA 12:15" />Okenaka, óde bọnga nna Ọvaar Ibinọkpaabyi akpobh, óde magaangẹ eso amaana asana pẹ, kẹ m'osi bọnga itama mach'iwa osi ab'ttatta pabọnga.<verse eid="1SA 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 12:16" />“Ofona nya, màbe <char style="it">ma sẹẹbh</char>, màze ọttọhk mva fiden f'Ọvaar Ibinọkpaabyi ọd-ọkam bẹ́, osi m'abọnga k'ititika! <verse eid="1SA 12:16" /><verse number="17" style="v" sid="1SA 12:17" />Mba ọphagbe kw'wit kw'moning ma? Kaam m'nyerẹ Ọvaar Ibinọkpaabyi, ọtọhm ẹbhaangkpon, obir osi ẹrọng etebh, mfha mazonga epyibha kira ch'masi z'Ọvaar Ibinọkpaabyi k'ititika, ch'marọrọ ọvaarnọng.”<verse eid="1SA 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 12:18" />Nya o, Samwẹl oyerẹ Ọvaar Ibinọkpaabyi ẹmọng. Ny'ewu ndo madan-danẹ, Ọvaar Ibinọkpaabyi ọtọhm ẹbhaangkpon, obir otebh ẹrọng. Minna kw'anọng mbo maphyir maning k'opoma f'Ọvaar Ibinọkpaabyi, ọttara f'Samwẹl.<verse eid="1SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 12:19" />Anọng mbo maphyir maben Samwẹl bẹ́, “Ze njọm nang Ọvaar Ibinọkpaabyi kwọ k'amina k'nso, mfha moning ope, kirẹ mina nkk'epyibha ch'mororọ ọvaarnọng ọsa ọttara z'mpyibha njoza maphyir.”<verse eid="1SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 12:20" />Samwẹl ọpọhna bẹ bẹ́, “Oning bọnga ojor. Zabẹ, nkk'mpyibha nja asa, m'nnam kàkpa abọra Ọvaar Ibinọkpaabyi, màtera kpobh-ẹ maana ettem madanẹ. <verse eid="1SA 12:20" /><verse number="21" style="v" sid="1SA 12:21" />M'nnam kàkpa z'aka p'nna k'eden ayinẹ. Aka bọnga ejibha masi, m'bọnga mabir akkaana, okurọ bẹ́, k'eden keyinẹ. <verse eid="1SA 12:21" /><verse number="22" style="v" sid="1SA 12:22" />Ọvaar Ibinọkpaabyi anọng pẹ mòbhum okurọ eche chẹ ch'ẹbar odik, kirẹ wa ọdaam-ẹ z'ettem bẹ́, ọtọka bọnga mach'anọng pẹ. <verse eid="1SA 12:22" /><verse number="23" style="v" sid="1SA 12:23" />Ṉ́nòde kaam, epyibhase ndo mìnsi s'Ọvaar Ibinọkpaabyi k'ititika bẹ́, ntwuna njọm ozize nnang bọnga. Kaam m'mbira mkpebhẹ bọnga eden ọkkọkka. <verse eid="1SA 12:23" /><verse number="24" style="v" sid="1SA 12:24" />Okenaka, màzonga bẹ́, mm'ayena ojora f'Ọvaar Ibinọkpaabyi, màbira atima nttem sabọnga maphyir makpobh-ẹ mawuriji, mabir achibhẹ idik siden s'ikk'ọsa ọnang bọnga. <verse eid="1SA 12:24" /><verse number="25" style="v" sid="1SA 12:25" />Okenaka, óde machin ororo asi itama, bọnga ọmaana ọvaarnọng kwabọnga, mm'adimẹ kibung-kibungọ.”<verse eid="1SA 12:25" /></para>
  <chapter eid="1SA 12" />
  <chapter number="13" style="c" sid="1SA 13" />
  <para style="s">Saul orim egbong ọmaana aPhilistiya</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 13:1" />Wa Saul ode icho ẹrọbh okwuma ijobh k'atam k'ogbe kw'masẹ-ẹ ẹvaar, obir ọbaabha Israẹl k'icho arọbh<note caller="+" style="f"><char style="fr" closed="false">13.1 </char><char style="ft" closed="false">Acheden-nwẹr p'matim eHiburu akkẹr ayen nkọmẹ k'obhik f'matim m'ọkaana kw'nnwẹr nwa.</char></note> afa okwuma icho ifa.<verse eid="1SA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 13:2" />Saul otéka ajinọng p'Israẹl nnọhna nchenọmfa okwuma arọbh ijobh; nnọhna nchen ininga imaan-ẹ z'Mikmash, ọttara z'ẹkọma ch'Bẹtẹl ch'eyen agbe, nnọhna mfa okwuma arọbh ijobh ininga imaana Jonatan z'Gibea z'ẹkọma ch'Bẹnjamin. Oben ajinọng mboza p'arikẹ bẹ́, makpa nnam z'abẹ k'isọhm.<verse eid="1SA 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 13:3" />Jonatan okema aPhilistiya z'egbongkwurọ chabẹ z'Geba. APhilistiya mabhaanga odik nwo. Minna kw'Saul oje enyisa ọkọbha obhon maphyir, oben bẹ́, “AHiburu, màbhaanga o!” <verse eid="1SA 13:3" /><verse number="4" style="v" sid="1SA 13:4" />Ofona nya, anọng p'Israẹl maphyir mabhaanga ẹgọhma ndo bẹ́, “Saul kk'egbong orima ọmaana aPhilistiya za ch'maning. Ofona nya, anọng p'Israẹl nabọkọ aPhilistiya idik ọbọkọ.” Mawon ẹmọng bẹ́, anọng akebha Saul z'Gilgal.<verse eid="1SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 13:5" />Anọng p'Philistiya matobha ayok bẹ́, mad-arima anọng p'Israẹl ábẹ̀. Matima ijaar nnọhna nchenọmfa okwuma arọbh ijobh s'nnyanya id-itọr, ọmaana ayaar-ọyaar nnọhna ichi, ọmaana agbongnọng p'asaabhẹ mach'ofong kw'ẹraangaka. Mabina ad-abhing z'Mikmash, z'Bẹt-Avẹn, za ch'ewuchen ed-eyin. <verse eid="1SA 13:5" /><verse number="6" style="v" sid="1SA 13:6" />K'ogbe kw'anọng p'Israẹl aze bẹ́, odik kk'opyibha, ọmaana bẹ́, nkk'agbongnọng pabẹ mkpaang abir ana, marọbh atubha k'atakpamma, ọmaana k'ndabhẹ, ọmaana k'ntakpa, ọmaana k'amma, ọttara k'ape. <verse eid="1SA 13:6" /><verse number="7" style="v" sid="1SA 13:7" />AHiburu banẹ majeka ọraanga kw'Jọrdan, machina z'nkọma s'Gad ọmaana s'Gilead.</para>
  <para style="p" vid="1SA 13:7">Saul oninga z'Gilgal, ojora osi agbongnọng maphyir p'aning amaan-ẹ maa, mafọn-ọfọnọ. <verse eid="1SA 13:7" /><verse number="8" style="v" sid="1SA 13:8" />Saul oninga k'iwu ichenọmfa otik ogbe kw'Samwẹl ọkẹ-ẹ; okenaka, Samwẹl ny'Gilgal kokwu ny'ogbe nwo, ofona nya, anọng p'Saul atọma oriraamẹ. <verse eid="1SA 13:8" /><verse number="9" style="v" sid="1SA 13:9" />Saul oben bẹ́, “Màchen-m ẹnanga ch'ẹkwọmọ, ọttara nnanga s'ẹforgbaka, ọfha ntima mfọhnọ ẹja.” Minna kw'Saul ọfọhnọ ẹja ndo ch'ẹkwọmọ. <verse eid="1SA 13:9" /><verse number="10" style="v" sid="1SA 13:10" />K'ose kw'ocher ẹja ndo ofufọhnọ nya, Samwẹl opyirẹ, Saul obina okebh-ẹ z'iyaan ozim-ẹ.<verse eid="1SA 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 13:11" />Samwẹl ọbọbh-ẹ bẹ́, “Bọng-ọttọhk f'asi ma?”</para>
  <para style="p" vid="1SA 13:11">Saul ọpọhn-ẹ bẹ́, “Ch'nze bẹ́, ajinọng paam aning ka araamẹ, ọmaana bẹ́, aPhilistiya kk'atobha z'Mikmash, ọttara bẹ́, ny'ogbe kw'ake kabir akwu, <verse eid="1SA 13:11" /><verse number="12" style="v" sid="1SA 13:12" />kẹ wọ osi nchibhẹ bẹ́, ‘APhilistiya m'akwu arim-m ábẹ̀ m'Gilgal, ọttara bẹ́, ẹkkaana ch'Ọvaar Ibinọkpaabyi ntima mphyema.’ Nya o, osi-m bẹ́, ọbaan bẹ́, mfọhnọ ẹja ch'ẹkwọmọ nnang Ọvaar Ibinọkpaabyi.”<verse eid="1SA 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 13:13" />Samwẹl oben-ẹ bẹ́, “Etwurọ dọ ch'asi ma e. Ọsana kw'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ ọnang-ọ, katorọ; wúra átorọ, wura kk'ẹvaar chọ ọsa ettima ny'Israẹl k'igbe maphyir. <verse eid="1SA 13:13" /><verse number="14" style="v" sid="1SA 13:14" />Okenaka, madidanma, ẹvaar chọ ọdọk ororo mèchina; Ọvaar Ibinọkpaabyi kk'ojinọng ọza kw'ọkpẹ-ẹ k'ettem, obir oték-ẹ bẹ́, ọbaabha anọng pẹ, okurọ bẹ́, kọ asana p'Ọvaar Ibinọkpaabyi kakpobh.”<verse eid="1SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 13:15" />Nya o, Samwẹl obina ny'Gilgal, ochina z'Gibea, z'ẹkọma ch'Bẹnjamin. Saul obhik anọng p'aning nya amaan-ẹ, p'mm'apyirẹ ẹnọhna okwuma arọbh ijobh.<verse eid="1SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 13:16" />Saul ọmaana Jonatan kw'ode nnwa kwẹ, ọttara ajinọng p'matọnọ, wa maning z'Gibea, z'ẹkọma ch'Bẹnjamin, aPhilistiya mabhing z'Mikmash. <verse eid="1SA 13:16" /><verse number="17" style="v" sid="1SA 13:17" />Agbongnọng p'ade nkaana nttaan mabina z'ibhinga-byi s'aPhilistiya. Ẹkaana danẹ echina z'Ọphra, z'ẹbhaakẹ ch'Shual, <verse eid="1SA 13:17" /><verse number="18" style="v" sid="1SA 13:18" />danẹ echina z'Bẹt-Họrọn. Ch'ettong nttaan echina z'enem ch'ẹrọnọ ilokodo s'Zeboyim, s'ikkerẹ ibyi s'owora.<verse eid="1SA 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 13:19" />Ny'izek s'Israẹl maphyir, wa otiteka mawan-wanẹ kode, okurọ ch'aPhilistiya kk'abena bẹ́, “Ini minna ode, aHiburu m'asi akkangkkang wanẹma akọhn!” <verse eid="1SA 13:19" /><verse number="20" style="v" sid="1SA 13:20" />Ofona nya o, anọng p'Israẹl maphyir mabina azeng z'Philistiya bẹ́, mad-abọhnga nkwubh, ọmaana mbar, ọmaana nkkaarabar, ọttara ọmmaana f'ọkwọrọ eso. <verse eid="1SA 13:20" /><verse number="21" style="v" sid="1SA 13:21" />Ẹphya ch'nkwubh ọmaana mbar obubọhnga ede agboka afa p'shẹkẹl. Ẹbọhnga ch'sọvẹl kw'oyen asa, ọmaana mbar, ọttara ọbaangachi ebir ede igboka majanẹ s'shẹkẹl. <verse eid="1SA 13:21" /><verse number="22" style="v" sid="1SA 13:22" />Ofona nya o, ny'ewu ch'egbong, ogbongnọng mawanẹ kw'Saul ọmaana Jonatan kode kw'otim ọkkangkkang, wanẹma ọkọhn k'ọbọhk kwẹ, kw'ọkpanẹ Saul ọmaana nnwa kwẹ Jonatan.<verse eid="1SA 13:22" /></para>
  <para style="s">Jonatan orim aPhilistiya ábẹ̀</para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 13:23" />M'ogbe nwa, egbong-kaana danẹ kk'ebina z'ekwurọ ch'aPhilistiya bẹ́, ẹd-ẹkpa eden ch'Mikmash.<verse eid="1SA 13:23" /></para>
  <chapter eid="1SA 13" />
  <chapter number="14" style="c" sid="1SA 14" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 14:1" />Ewu danẹ, Jonatan kw'ode ojinọngnwa kw'Saul, oben odikkobh kw'ode otim-egbongkpo kwẹ bẹ́, “Kwu mojeka z'okwubha kw'egbongkwurọ ch'aPhilistiya.” Okenaka, Jonatan otte odik nwo kọgbaakẹ.<verse eid="1SA 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 14:2" />Wa Saul oning k'echirin ch'pomegrenet, z'Migrọn, z'mbọr-mbọr kw'Gibea. Agbongnọng p'uwa aning amaan-ẹ nya marik-orik apyirẹ ẹnọhna okwuma arọbh ijobh. <verse eid="1SA 14:2" /><verse number="3" style="v" sid="1SA 14:3" />Ọnọng wanẹ nya, ode Ahija kw'uwa ọd-ọfọra <char style="w">ẹphọd</char>. Wa kẹ ode ojinọngnwa kw'Ahitub, kw'ode ọgbaanotte kw'Ikabọd. Ikabọd nwa wọ iwa ode ojinọngnwa kw'Phinẹhas, kw'ode ojinọngnwa kw'Ẹli, kw'ode ọfọhn-nja kw'Ọvaar Ibinọkpaabyi z'Shilo. Ọnọng kode kw'ozong bẹ́, Jonatan kk'ofona.<verse eid="1SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 14:4" />Wa ẹtakpa ch'egor-ogorọ ed-eninga k'ẹbhaakẹ kpenamkpen ch'Jonatan ọkamẹ bẹ́, ozenga ojeka za ch'aPhilistiya maning. Ẹtakpa danẹ mayerẹ Bozẹz, ndoza mayerẹ Sẹnẹ. <verse eid="1SA 14:4" /><verse number="5" style="v" sid="1SA 14:5" />Ẹtakpa danẹ ebe ekkerẹ ebir-ebir kw'Mikmash, ndoza ekkerẹ ẹwọn-ẹwọna kw'Geba.<verse eid="1SA 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 14:6" />Jonatan oben otim-egbongkpo kwẹ bẹ́, “Kwu mojeka z'okwubha kw'anọng p'nna inọm abhirẹ maning. Ṉ́nòsi Ọvaar Ibinọkpaabyi m'orima ọnang mina. Zaabẹ mọsaabh-ọsaabh o, nkọsaabhẹ o, ọttọhk kode f'im'ọchọna Ọvaar Ibinọkpaabyi bẹ́, oning mina ọkkaan.”<verse eid="1SA 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 14:7" />Otim-egbongkpo kwẹ oben bẹ́, “China ororo, si okpenamkpen f'oning-ọ z'ettem. Ettem chaam, ọmaana ọgbagba kwaam ening ma ẹmaan-ọ.”<verse eid="1SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 14:8" />Jonatan oben-ẹ bẹ́, “Ó̱de ode minna, mm'ojeka z'okwubha, mfha aPhilistiya mbo aze mina. <verse eid="1SA 14:8" /><verse number="9" style="v" sid="1SA 14:9" />Ó̱de mabenẹ mina bẹ́, ‘Màbe nya maa, mokebha bọnga nya,’ mm'obe nya ch'mobe, m'bẹ za mòkebha. <verse eid="1SA 14:9" /><verse number="10" style="v" sid="1SA 14:10" />Okenaka, óde mabenẹ mina bẹ́, ‘Màvura kebha mina ka,’ mm'ovura okebha bẹ za, okurọ bẹ́, nya wọ im'ọkọhka mina bẹ́, Ọvaar Ibinọkpaabyi kk'bẹ ọtọka oke mina k'mbọhk.”<verse eid="1SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 14:11" />Minna kw'bẹ anọng afa mayinẹ makọhk ifor sabẹ z'ibyi s'aPhilistiya maning. APhilistiya aben bẹ́, “Màze e, aHiburu aning za ayinẹ z'amma p'matubh e.” <verse eid="1SA 14:11" /><verse number="12" style="v" sid="1SA 14:12" />Ajinọng p'aning ny'ibyi njo makwọhrọ ẹmọng abenẹ Jonatan ọmaana otim-egbongkpo kwẹ bẹ́, “Màvura kebha mina ka, mm'ọkọhka bọnga.” Ofona nya o, Jonatan oben otim-egbongkpo kwẹ bẹ́, “Vura yak-m nnam; Ọvaar Ibinọkpaabyi kk'bẹ ọtọka oke Israẹl k'mbọhk.”<verse eid="1SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 14:13" />Jonatan otima mbọhk ọmaana mmo ovura, otim-egbongkpo kwẹ, ọyak-ẹ nnam. Jonatan ọfhọ aPhilistiya banẹ, otim-egbongkpo kwẹ obir ọfhọ ọyak-ẹ nnam. <verse eid="1SA 14:13" /><verse number="14" style="v" sid="1SA 14:14" />Ny'echeden-rima ndo, wa Jonatan ọttara otim-egbongkpo kwẹ mafhọ ajinọng p'apyirẹ ẹrọbh ny'ibyi s'im'ipyirẹ ntọkọ arọbh achenọmfa okwuma ijobh k'ẹkpa.<verse eid="1SA 14:14" /></para>
  <para style="s">Anọng p'Israẹl akem anọng p'Philistiya</para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 14:15" />Nya o, opoma ọbọka agbongnọng p'Philistiya p'aning z'ibhinga-byi, ọmaana p'aning z'igbongtitika, ọmaana ayok p'aning z'egbongkwurọ, ọttara akkikkaama. Wa izek ibir inyengẹ. Ibinọkpaabyi wọ iwa ọtọhmọ opoma mvo.<verse eid="1SA 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 14:16" />Akker-ibyi p'aning amaana Saul z'Gibea, z'ẹkọma ch'Bẹnjamin, maze agbongnọng p'Philistiya ch'mad-attena ẹkpa-ẹkpa. <verse eid="1SA 14:16" /><verse number="17" style="v" sid="1SA 14:17" />Ofona nya o, Saul oben anọng p'aning nya amaan-ẹ bẹ́, “Màbhik agbongnọng, mfha mozonga ọnọng kw'ikk'ofona orik mina.” Ch'nkk'asa minna o, maze bẹ́, Jonatan ọmaana otim-egbongkpo kwẹ wọ iwa nnade.<verse eid="1SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 14:18" />Saul oben Ahija bẹ́, “Tima Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi kwu.” Ny'ogbe nwo, wa Ẹkkọhbhọ ndo ening ẹmaana anọng p'Israẹl. <verse eid="1SA 14:18" /><verse number="19" style="v" sid="1SA 14:19" />Nya ch'Saul otim ọgbaak odik ọmaana ọfọhn-nja kw'Ibinọkpaabyi, minna kw'damadama kw'otto z'ibhinga-byi s'aPhilistiya ọsaabhẹ ọttara-ọttara. Ofona nya o, Saul oben ọfọhn-nja kw'Ibinọkpaabyi bẹ́, “Rọbha ọbọhk kwọ nya.”<verse eid="1SA 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 14:20" />Nya o, Saul ọmaana agbongnọng pẹ matobha ayok, mabina ayin egbong. Mad-akebha aPhilistiya k'damadama kwiden, ch'mad-atima akkangkkang afhọ ayok-ayok. <verse eid="1SA 14:20" /><verse number="21" style="v" sid="1SA 14:21" />AHiburu mbo p'akkikken aninga ọmaana aPhilistiya, p'abir ator bẹ achina z'ibhinga-byi, majeka akebha anọng p'Israẹl p'aning ọmaana Saul ọttara Jonatan. <verse eid="1SA 14:21" /><verse number="22" style="v" sid="1SA 14:22" />K'ogbe kw'uwa anọng p'Israẹl maphyir p'nkk'atubha z'ẹkọma ch'Ephraim ch'eyen agbe mabhaang bẹ́, aPhilistiya aning za arọbhọ, bẹ makwu ator ayok egbong, makwubh aPhilistiya k'ẹfa k'ẹfa. <verse eid="1SA 14:22" /><verse number="23" style="v" sid="1SA 14:23" />Minna kw'Ọvaar Ibinọkpaabyi ọkkaan Israẹl ny'ewu ndo. Egbong ndo etima maa ẹkpan Bẹt-Avẹn.<verse eid="1SA 14:23" /></para>
  <para style="s">Jonatan ọttaakẹ akọhnsi</para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 14:24" />Ny'ewu ndo, wa ajinọng p'Israẹl aning k'adama okurọ ch'Saul ikk'ọnwọhnga bẹ́, “M'opyibh ọnang ọnọng kpenamkpen kw'ochi ọttọhk pira ẹsọhka etto, ch'ina ọttọhk f'awawunanọng paam asi-m ntìma ntuka.” Ofona nya o, ogbongnọng kw'ọbhaang ọchattọhk ny'ẹmma kode.<verse eid="1SA 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 14:25" />Agbongnọng mbo maphyir madim z'ẹtam, maze ọkọhn ny'izek. <verse eid="1SA 14:25" /><verse number="26" style="v" sid="1SA 14:26" />Ch'madimẹ ny'ẹtam o, maze akọhnsi ch'nd-ayin nya. Okenaka, ọnọng kw'otwu ọbọhk nya ọttaakẹ kode, okurọ ojora f'nwọhngọ njo. <verse eid="1SA 14:26" /><verse number="27" style="v" sid="1SA 14:27" />Jonatan otìma ọbhaanga bẹ́, otte kk'ọnwọhnga ọnang anọng mbo. Ofona nya o, onemẹ ochikwura kw'otim ny'ọbọhk, ọnọhma eso chẹ ny'ọkọhn mvo, otinẹ ọbọhk oke z'ẹmma, ọttaakẹ, ẹfa chẹ ẹnwọnga. <verse eid="1SA 14:27" /><verse number="28" style="v" sid="1SA 14:28" />Nya o, ogbongnọng wanẹ oben-ẹ bẹ́, “Atte kwọ ọyak ọbọhk ọnwọhngọ bẹ́, ‘M'opyibh ọnang ọnọng kpenamkpen kw'ochi ọttọhk menda!’ Kẹ wọ osi ifor imọm ajinọng mba.”<verse eid="1SA 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1SA 14:29" />Jonatan oben bẹ́, “Atte kwaam kk'odik ọja m'izek nja. Kirẹ ose kw'ẹfa chaam ẹnwọhng ch'mmaang akọhnsiva mba. <verse eid="1SA 14:29" /><verse number="30" style="v" sid="1SA 14:30" />Wura ojibhẹ ọtam óde ajinọng mbo machi ekpo byanẹ py'nkk'awawunanọng pabẹ ana menda. Nya wọ kw'uwura mọfhọ aPhilistiya mbo ọtam.”<verse eid="1SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 14:31" />Ny'ewu ndo, ch'anọng p'Israẹl kk'atọma ny'Mikmash mafhọ aPhilistiya maa mapyirẹ z'Aijalọn, okwu ọkọhn bẹ mawuriji. <verse eid="1SA 14:31" /><verse number="32" style="v" sid="1SA 14:32" />Matto z'ekpo py'matọk z'egbong, matọka arọkimaan, ọmaana adamogbodo, ọttara abhaamva, mapekẹ jẹ ny'izek, machi ttara izẹ. <verse eid="1SA 14:32" /><verse number="33" style="v" sid="1SA 14:33" />Nya o, ọnọng wanẹ oben Saul bẹ́, “Kirẹ e, ajinọng mbo aning za asi epyibha z'Ibinọkpaabyi k'ititika, ch'mad-achi eten ch'etim izẹ.”</para>
  <para style="p" vid="1SA 14:33">Saul oben bẹ́, “Nkk'atta k'epinẹ ch'Ibinọkpaabyi. Màbungẹ ẹta chiden ẹbhar-ẹbhar tima kwu ma.” <verse eid="1SA 14:33" /><verse number="34" style="v" sid="1SA 14:34" />Nya o, oben bẹ́, “Màchina z'ikpakaana s'ajinọng mbo, magbaak bẹ bẹ́, ‘Ọnọng-ọnọng otima adamogbodo, wanẹma ọrọkimaan kwẹ okwu, obir oninga ma ọfhọ wẹ, ochi. Tte ọnọng oning Ọvaar Ibinọkpaabyi opinẹ bẹ́, ochi eten ch'etim izẹ.’ ”</para>
  <para style="p" vid="1SA 14:34">Minna kw'ọnọng kpenamkpen otim ọbhaamdim kwẹ okwu ny'erungọ ndo, mafhọ wẹ nya. <verse eid="1SA 14:34" /><verse number="35" style="v" sid="1SA 14:35" />Nya o, Saul osi ija-byi ọnang Ọvaar Ibinọkpaabyi. Nya wọ ode ochedengbe kw'uwa osi ọttọhkse mva.<verse eid="1SA 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1SA 14:36" />Saul oben bẹ́, “Tte mochina z'aPhilistiya m'erungọ, mod-orima bẹ ábẹ̀ maa, ewu esobha, mọna bẹ ekpo pyabẹ. Tte moning ọnọng mawanẹ-wanẹ ọbọhk otte oruk akpen.”</para>
  <para style="p" vid="1SA 14:36">Mapọhn-ẹ bẹ́, “Si k'ose kw'ojibh-ọ.”</para>
  <para style="p" vid="1SA 14:36">Okenaka, ọfọhn-nja kw'Ibinọkpaabyi oben bẹ́, “Tte mọbọbh Ibinọkpaabyi ma pira.”<verse eid="1SA 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1SA 14:37" />Nya o, Saul ọbọbh Ibinọkpaabyi bẹ́, “Ma, nyin erima mmaana aPhilistiya o? Ma, nna Israẹl akema bẹ o?” Okenaka, Ibinọkpaabyi kẹ ẹpọhna ny'ewu ndo kọnangẹ.<verse eid="1SA 14:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1SA 14:38" />Ofona nya o, Saul oben bẹ́, “Bọnga aso p'agbongnọng maphyir màkwu ma, moror epyibha ch'nkk'ọsa menda. <verse eid="1SA 14:38" /><verse number="39" style="v" sid="1SA 14:39" />K'ose kw'Ọvaar Ibinọkpaabyi kw'ọd-ọkkaana Israẹl orukọ akpen, zaabẹ́ epyibha ndo efon k'Jonatan kw'ode nnwa kwaam, kẹ m'opope.” Okenaka, ọnọng mawanẹ kw'ọpọhn odik kode.<verse eid="1SA 14:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1SA 14:40" />Saul oben anọng p'Israẹl maphyir bẹ́, “Bọnga màbe kina, kaam ọmaana nnwa kwaam Jonatan, mm'obe k'okwubha.”</para>
  <para style="p" vid="1SA 14:40">Anọng mbo mapọhn-ẹ bẹ́, “Si k'ose kw'ojibh-ọ.”<verse eid="1SA 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 14:41" />Nya o, Saul oben bẹ́, “O Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl, osempira kaam ọtọhmnọng kwọ ẹpọhna kanangẹ menda? Ó̱de epinẹ ndoma efon k'kaam, obir ode bẹ́, efon k'Jonatan kw'ode nnwa kwaam, o Ibinọkpaabyi kw'Israẹl, tima Urim nang-m ẹpọhna. Ó̱de efon k'anọng pọ Israẹl, tima Tumim nang-m ẹpọhna.” Ọsẹ otto k'Jonatan ọmaana Saul. Odik nwo ọraar anọng mboza. <verse eid="1SA 14:41" /><verse number="42" style="v" sid="1SA 14:42" />Nya o, Saul oben bẹ́, “Bharẹ ọsẹ kw'kaam ọmaana nnwa kwaam Jonatan.” Ọsẹ otto k'Jonatan.<verse eid="1SA 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1SA 14:43" />Ofona nya o, Saul oben Jonatan bẹ́, “Tek-m ọttọhk f'ikk'asa.”</para>
  <para style="p" vid="1SA 14:43">Jonatan otek-ẹ bẹ́, “Nkenka ntima eso ch'ochikwura kwaam mmaanga ọkọhn biribirẹ. Kirẹ kaam ma, tte mpe kẹ.”<verse eid="1SA 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1SA 14:44" />Saul oben bẹ́, “Tte Ibinọkpaabyi osi-m k'ose kpenamkpen kw'ọdaak-ẹ, obir ọttara-ọttara, óde kọ Jonatan ina ape!”<verse eid="1SA 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1SA 14:45" />Okenaka, ajinọng mbo maben Saul bẹ́, “Nya kw'Jonatan min'ope o, kẹ kw'ikk'ẹkkaana nda chiden ọsa ọnang Israẹl o? Minna mòde! K'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, osisanaanga kw'eso chẹ k'izek mòtto, okurọ bẹ́, osi ọttọhk mva menda ọmaana ẹkkaana ch'Ibinọkpaabyi.” Minna kw'ajinọng mbo makaamẹ Jonatan, m'ọdọk kẹ kafhọ.<verse eid="1SA 14:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1SA 14:46" />Nya o, Saul ottika aPhilistiya okwukwubh, aPhilistiya makpa nnam z'abẹ k'obhon.<verse eid="1SA 14:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1SA 14:47" />Ch'Saul kk'ẹvaar ch'Israẹl otima, orima egbong ọmaana awawunanọng pabẹ p'ade Moab, ọmaana Ammọn, ọmaana Edom, ọmaana avaar p'Zoba, ọttara aPhilistiya. Ẹbhaakẹ kpenamkpen ch'okkerẹ ichen, osi bẹ itama mawuriji. <verse eid="1SA 14:47" /><verse number="48" style="v" sid="1SA 14:48" />Wa Saul od-orima egbong mach'ojinọng, okema anọng p'Amalẹk, obir ọrọbha Israẹl z'mbọhk s'anọng p'uwa nkk'bẹ akema, mana bẹ ekpo.<verse eid="1SA 14:48" /></para>
  <para style="s">Ẹsọhmmọr ch'Saul</para>
  <para style="p">
    <verse number="49" style="v" sid="1SA 14:49" />Wa ajinọngva p'Saul ade Jonatan, ọmaana Ishvi, ọttara Malki-Shua. Obir oyena aminava afa. Ocheden okpen Mẹrab, oyok kw'ikarẹ okpena Mikal. <verse eid="1SA 14:49" /><verse number="50" style="v" sid="1SA 14:50" />Kwanọng kw'Saul okpen Ahinoam, kw'ode nnwa kw'Ahimaz. Osonọng kw'agbongnọng p'Saul wa okpen Abnẹr, kw'ode nnwa kw'Nẹr. Wa Nẹr ode ọgbaanotte kw'otte kw'Saul. <verse eid="1SA 14:50" /><verse number="51" style="v" sid="1SA 14:51" />Abiyẹl wọ iwa obhonọ Kish, kw'ode otte kw'Saul, obir obhon Nẹr, kw'ode otte kw'Abnẹr.<verse eid="1SA 14:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1SA 14:52" />K'akpen p'Saul maphyir, wa od-orima mgbong s'igaang-ọgaangẹ ọmaana aPhilistiya. K'ogbe kpenamkpen kw'oze ọfanọng, wanẹma, ọnọng kw'ọbarẹ ettem, ọd-ọtọk-ẹ ọttara z'agbongnọng pẹ.<verse eid="1SA 14:52" /></para>
  <chapter eid="1SA 14" />
  <chapter number="15" style="c" sid="1SA 15" />
  <para style="s">Ọvaar Ibinọkpaabyi obhumọ Saul mach'ọvaarnọng</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 15:1" />Samwẹl oben Saul bẹ́, “Kaam kw'Ọvaar Ibinọkpaabyi ọtọhmọ bẹ́, mbyeng-ọ ana k'eso mach'ọvaarnọng kw'ọbaabh anọng pẹ, Israẹl. Ofona nya, yonga itọhng madidanma, k'ẹkkaabha ch'efon z'Ọvaar Ibinọkpaabyi. <verse eid="1SA 15:1" /><verse number="2" style="v" sid="1SA 15:2" />Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir ọgbaakẹ: ‘Kaam m'nnang anọng p'Amalẹk<note caller="-" style="x"><char style="xo" closed="false">15.2 </char><char style="xt" closed="false"><ref loc="EXO 17:8-16">Nnwẹr kw'Ozenga 17.8-16</ref>; <ref loc="DEU 25:17-18">Deutẹrọnọmi 25.17-18</ref></char></note> irem k'ọttọhk f'uwa masi, ch'mabe k'eden atik anọng p'Israẹl, make bẹ ẹkọhr k'ogbe kw'mabin z'Ijip. <verse eid="1SA 15:2" /><verse number="3" style="v" sid="1SA 15:3" />Nya o, zọhng, rima anọng p'Amalẹk ábẹ̀, kibhẹ ọttọhk kpenamkpen f'mayen. Bẹ kàjọhkọ o, fhọ bẹ maphyir k'ejinọng, ọttara k'ẹpanọng, ozeng k'ivava, ọmaana iva p'matim k'mbọhk, ọmaana adamogbodo, ọmaana arọkimaan, ọmaana akamẹl, ọttara nnyanya.’ ”<verse eid="1SA 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 15:4" />Minna kw'Saul oyerẹ agbongnọng pẹ k'ibyi majanẹ, obhik bẹ z'Telaim. Obhik f'agbongnọng p'izek ode nnọhna ẹnọhna okwuma nnọhna arọbh achen; f'ayok p'abin Juda ode nnọhna ẹrọbh okwuma nchen. <verse eid="1SA 15:4" /><verse number="5" style="v" sid="1SA 15:5" />Saul obina ochina z'ebhondim ch'Amalẹk, mayima egbong z'ilokodo. <verse eid="1SA 15:5" /><verse number="6" style="v" sid="1SA 15:6" />Nya o, oben anọng p'Ken bẹ́, “Màbina rik anọng p'Amalẹk, ọfha nning bọnga mfhọ nttara; kirẹ wa bọnga masi ejibha anang anọng p'Israẹl maphyir, k'ogbe kw'mad-abina z'Ijip.” Ofona nya o, anọng p'Ken mabina arik anọng p'Amalẹk.<verse eid="1SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 15:7" />Nya o, Saul orima anọng p'Amalẹk ábẹ̀, tọma z'Havila maa, pyirẹ z'Shur kw'ọnyọm Ijip, za ch'ewuchen ed-eyin. <verse eid="1SA 15:7" /><verse number="8" style="v" sid="1SA 15:8" />Ọbọka Agag, kw'ode ọvaarnọng kw'Amalẹk k'ẹmmọri, otima ọkkangkkang ọfhọ anọng pẹ maphyir. <verse eid="1SA 15:8" /><verse number="9" style="v" sid="1SA 15:9" />Okenaka, Saul ọmaana agbongnọng pẹ, m'Agag kafhọ. Wa m'ekpo byanẹ mach'arọkimaan p'ajibhẹ ọtam, ọmaana adamogbodo, ọmaana abhaamva, ọmaana arọkimaanva p'ajibh ifor, ọttara ọttọhk kpenamkpen f'iwa ojibh-ojibh kabir afhọ. Ekpo mbyoma, wa nkakamẹ bẹ́, makibhẹ kibungọ-kibungọ. Okenaka, ọttọhk kpenamkpen f'mabhum-obhum, obir opyibh-opyibh, makibhẹ kibungọ-kibungọ.<verse eid="1SA 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 15:10" />Nya o, Ọvaar Ibinọkpaabyi oben Samwẹl bẹ́, <verse eid="1SA 15:10" /><verse number="11" style="v" sid="1SA 15:11" />“Ettem kk'aam ẹmma ch'nsi Saul ọvaarnọng, okurọ bẹ́, kk'nnam ọkpa ọbọr-m, ọsana kwaam kobir okpobha.” Ettem ẹyak Samwẹl odik, obhom ọkpẹkẹ Ọvaar Ibinọkpaabyi ny'orungiwu nwo maphyir.<verse eid="1SA 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 15:12" />K'ekpikpebha, Samwẹl obina ofona bẹ́, od-oze Saul. Matek-ẹ bẹ́, “Saul kk'ochina z'Kaamẹl bẹ́, od-ottima ọttọhk f'ejima f'im'ọnang-ẹ ikpukpobha. Ocher nya o, ọbhakẹ ọkpa nnam z'Gilgal.”<verse eid="1SA 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 15:13" />K'ogbe kw'Samwẹl okebh-ẹ, Saul oben bẹ́, “Tte Ọvaar Ibinọkpaabyi ọdọ-ọ! Kaam kk'ọsana kw'Ọvaar Ibinọkpaabyi mkpobha.”<verse eid="1SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 15:14" />Okenaka, Samwẹl ọbọbh-ẹ bẹ́, “Bọng-avu bọ ad-amẹmẹ ma? Amọng p'adamogbodo p'nd-mmaanga ma, mafon men?”<verse eid="1SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 15:15" />Saul ọpọhna bẹ́, “Agbongnọng atim jẹ z'Amalẹk akwu e. M'arọkimaan ọmaana adamogbodo p'ajibh ọtam kafhọ. Masokọ bẹ́, matima afọhnọ ẹja anang Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwọ. Okenaka, mokibhẹ mbyoza maphyir.”<verse eid="1SA 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 15:16" />Samwẹl obenẹ Saul bẹ́, “Kpọ̀ka odik nwo! Tte ntek-ọ odik kw'Ọvaar Ibinọkpaabyi ọgbaak-m chena k'erungọ.”</para>
  <para style="p" vid="1SA 15:16">Saul ọpọhna bẹ́, “Tek-m.”<verse eid="1SA 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 15:17" />Samwẹl oben bẹ́, “Chibhẹ ch'iwa ade nnwa-nnwa z'ikọ k'achen, wa akwu ade oso kw'mfona s'Israẹl. Ọvaar Ibinọkpaabyi obyeng-ọ ana k'eso mach'ọvaarnọng kw'Israẹl, <verse eid="1SA 15:17" /><verse number="18" style="v" sid="1SA 15:18" />ọtọhm-ọ ọtọhm, oben-ọ bẹ́, ‘Zọhng fhọ abyibyanọng p'Amalẹk maphyir; rima egbong maana bẹ maa, madimẹ eche.’ <verse eid="1SA 15:18" /><verse number="19" style="v" sid="1SA 15:19" />Osi yen kw'ina Ọvaar Ibinọkpaabyi akpobh? Osempira att-otto z'oyena kw'Amalẹk, ọwọhkọ asi itama z'ititika s'Ọvaar Ibinọkpaabyi?”<verse eid="1SA 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 15:20" />Saul ọpọhna bẹ́, “Kaam kk'Ọvaar Ibinọkpaabyi mkpobha, nsi k'ose kw'ọtọhm-m, mfhọ anọng p'Amalẹk maphyir, ntima Agag kw'ode ọvaarnọng kwabẹ, nkwuna. <verse eid="1SA 15:20" /><verse number="21" style="v" sid="1SA 15:21" />Agbongnọng atọk arọkimaan ọmaana adamogbodo p'ajibhẹ ọtam z'egbong mfha matima afọhnọ ẹja z'Gilgal, anang Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwọ.”<verse eid="1SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 15:22" />Samwẹl ọpọhn-ẹ bẹ́,</para>
  <para style="q1" vid="1SA 15:22">“Ma, Ọvaar Ibinọkpaabyi ọd-ọdaam ettem k'nnanga s'ẹkwọmọ, ọmaana nja ofufọhnọ,</para>
  <para style="q2" vid="1SA 15:22">ọyọhnga ọgbaakadik kwẹ okpukpobha o?</para>
  <para style="q1" vid="1SA 15:22">Odik okpukpobha ojibhẹ ọtam ọyọhnga ẹja ofufọhnọ.</para>
  <para style="q2" vid="1SA 15:22">Odik obhubhaanga ojibh ọyọhnga iyaak s'arọkimaandim.<verse eid="1SA 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1SA 15:23" />Osogaangẹ opyibhẹ mach'ọtaan,</para>
  <para style="q2" vid="1SA 15:23">eforga epyibh mach'itama s'aka okpukpobha.</para>
  <para style="q1" vid="1SA 15:23">Ch'ikọ ikk'ọgbaakadik kw'Ọvaar Ibinọkpaabyi abhuma,</para>
  <para style="q2" vid="1SA 15:23">kẹ kk'ikọ obir obhuma mach'ọvaarnọng.”<verse eid="1SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 15:24" />Nya o, Saul oben Samwẹl bẹ́, “Kaam kk'epyibha nsa. Kk'ọsana kw'Ọvaar Ibinọkpaabyi, ọttara ntọhna sọ mbhuma. Wa agbongnọng paam bọ ajor-m, ofona nya, nchera mmaana bẹ. <verse eid="1SA 15:24" /><verse number="25" style="v" sid="1SA 15:25" />Ototo, bina nang-m k'epyibha chaam, tor-m mọkpa nnam, ọfha mkpobha Ọvaar Ibinọkpaabyi.”<verse eid="1SA 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 15:26" />Samwẹl oben-ẹ bẹ́, “Kaam kọ mìntor mọkpa nnam. Kk'ọgbaakadik kw'Ọvaar Ibinọkpaabyi abhuma, Ọvaar Ibinọkpaabyi obir obhum-ọ mach'ọvaarnọng kw'ọbaabh Israẹl.”<verse eid="1SA 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 15:27" />K'ose Samwẹl ọbhakẹ bẹ́, ofona, Saul ọbọk-ẹ ny'ammabọhra p'owurọ-baba. Owurọ-baba nwo, ọyaakẹ. <verse eid="1SA 15:27" /><verse number="28" style="v" sid="1SA 15:28" />Samwẹl oben-ẹ bẹ́, “Menda Ọvaar Ibinọkpaabyi kk'ẹvaar ch'Israẹl ọtọka z'ikọ k'mbọhk, ọnang oyok-obhon kw'ojibh ọyọhng-ọ. <verse eid="1SA 15:28" /><verse number="29" style="v" sid="1SA 15:29" />Kẹ kw'ode Abarada p'Israẹl, afọra kod-osi, ochibhẹ kod-obir obhona. Kẹ oyokinọng kode, kw'od-obhona ochibhẹ kwẹ.”<verse eid="1SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 15:30" />Saul ọpọhna bẹ́, “Kaam kk'epyibha nsa. Ototo, kenaka kpobh-m, m'ititika s'asogbọhkọnọng p'abaabh anọng paam, ọttara s'anọng p'Israẹl, ator-m mọkpa nnam, ọfha mkpobha Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwọ.” <verse eid="1SA 15:30" /><verse number="31" style="v" sid="1SA 15:31" />Ofona nya o, Samwẹl otor Saul makpa nnam, Saul okpobha Ọvaar Ibinọkpaabyi.<verse eid="1SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 15:32" />Nya o, Samwẹl oben bẹ́, “Màchen-m Agag, kw'ode ọvaarnọng kw'Amalẹk.”</para>
  <para style="p" vid="1SA 15:32">Agag oyin k'iyaan ẹnyaan-ẹnyaana okebh-ẹ, ochibhẹ bẹ́, “K'odik ọkkọkka, ajobhiji p'obo kk'akpana.”<verse eid="1SA 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 15:33" />Okenaka, Samwẹl oben bẹ́,</para>
  <para style="q1" vid="1SA 15:33">“K'ose kw'ọkkangkkang kwọ ikk'panọng ọsa m'iva kayen,</para>
  <para style="q2" vid="1SA 15:33">minna kw'akka kwọ ina nnwa moyena k'ikpakaana s'panọng.”</para>
  <para style="m" vid="1SA 15:33">Nya o, Samwẹl ọjọhkọ Agag <char style="it">ma tukutuku </char> ny'ititika s'Ọvaar Ibinọkpaabyi, z'Gilgal.<verse eid="1SA 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 15:34" />Samwẹl obina ochina z'Rama, Saul ọbhana z'obhon kwẹ, z'Gibea. <verse eid="1SA 15:34" /><verse number="35" style="v" sid="1SA 15:35" />Maa, pyirẹ k'ewu ch'Samwẹl ope, kẹ ọmaana Saul mayok ọdọk kaze. Samwẹl oninga k'oforpyibha okurọ Saul. Wa ettem ẹmma Ọvaar Ibinọkpaabyi ch'osi Saul ọvaarnọng kw'Israẹl.<verse eid="1SA 15:35" /></para>
  <chapter eid="1SA 15" />
  <chapter number="16" style="c" sid="1SA 16" />
  <para style="s">Samwẹl obyeng Devid ana k'eso</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 16:1" />Ọvaar Ibinọkpaabyi oben Samwẹl bẹ́, “M'abhom Saul atuma yen ch'ikk'ẹ mbhuma mach'ọvaarnọng kw'Israẹl? Tọka ana ke ny'ikọ k'mpyi, atima abina ozenga; m'ntọhm-ọ z'Jẹsẹ kw'ofon Bẹtẹlẹhẹm. Kaam kk'ojinọngnwa wanẹ kwẹ ntéka bẹ́, ode ọvaarnọng.”<verse eid="1SA 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 16:2" />Samwẹl ọbọbh bẹ́, “M'nsi yen nta o? Ó̱de Saul ọbhaang odik nwa, m'ọfhọ-m ọfhọ.”</para>
  <para style="p" vid="1SA 16:2">Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, “Tìma ọbhaamnwa ikwakwẹ zọhng, aben bẹ́, ‘Kk'nkwa bẹ́, mfọhnọ ẹja nnang Ọvaar Ibinọkpaabyi.’ <verse eid="1SA 16:2" /><verse number="3" style="v" sid="1SA 16:3" />Yerẹ Jẹsẹ okwu ny'ẹjafọhnọ ndo, kaam m'nkọhk-ọ ọttọhk f'im'asi. Ọnọng nwo kw'im'nkọhk-ọ, kẹ kw'im'abyenga ana k'eso.”<verse eid="1SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 16:4" />Samwẹl osi k'ose kw'Ọvaar Ibinọkpaabyi obenẹ. Ch'opyirẹ z'Bẹtẹlẹhẹm, asogbọhkọnọng p'obhon nwo mazẹ-ẹ nya o, matọma ofufọhnọ ch'makebh-ẹ. Mabọbh-ẹ bẹ́, “Ma, akwu k'ọdaam o?”<verse eid="1SA 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 16:5" />Samwẹl ọpọhna bẹ bẹ́, “Iye e, nkwu k'ọdaam e! Nkwu bẹ́, mfọhnọ ẹja nnang Ọvaar Ibinọkpaabyi. Mm'ado ifor sabọnga iwur, mọtọn ọd-ọfọhnọ ẹja.” Nya o, odo Jẹsẹ ọmaana ajinọngva pẹ mawur, obir oyerẹ bẹ bẹ́, mator-ẹ ny'ẹja ndo.<verse eid="1SA 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 16:6" />K'ogbe kw'nkk'apyira, Samwẹl oze Eliyab, ochibhẹ bẹ́, “K'odik ọkkọkka, ọnọng kw'Ọvaar Ibinọkpaabyi ikk'otéka bẹ́, mabyeng-ẹ ana k'eso w'obe m'ititika s'Ọvaar Ibinọkpaabyi.”<verse eid="1SA 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 16:7" />Okenaka, Ọvaar Ibinọkpaabyi oben Samwẹl bẹ́, “Ikkikkerẹ sẹ, wanẹma ebe chẹ kàsaana, kirẹ kaam kk'ẹ mbhuma. Ose kw'Ọvaar Ibinọkpaabyi od-oze idik, minna azang kw'oyokinọng od-oze. Oyokinọng od-okkerẹ m'mkpa s'ebir. Ṉ́nòde Ọvaar Ibinọkpaabyi, kẹ od-okkerẹ z'ettem.”<verse eid="1SA 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 16:8" />Nya o, Jẹsẹ oyerẹ Abinadab, okwu ọkpan ny'ititika s'Samwẹl. Samwẹl oben bẹ́, “Ọvaar Ibinọkpaabyi nwoma kobir otéka.” <verse eid="1SA 16:8" /><verse number="9" style="v" sid="1SA 16:9" />Jẹsẹ obir osi Shama okwu ọkpan ny'ititika s'Samwẹl. Samwẹl oben bẹ́, “Ọvaar Ibinọkpaabyi nwoma kobir otéka.” <verse eid="1SA 16:9" /><verse number="10" style="v" sid="1SA 16:10" />Jẹsẹ osi ajinọngva pẹ achenọmfa, makpan ny'ititika s'Samwẹl. Samwẹl oben bẹ́, “Ọnọng kw'Ọvaar Ibinọkpaabyi oték ma kode.” <verse eid="1SA 16:10" /><verse number="11" style="v" sid="1SA 16:11" />Nya o, Samwẹl ọbọbh Jẹsẹ bẹ́, “Ajinọngva p'ayen maphyir bọ ma o?”</para>
  <para style="p" vid="1SA 16:11">Jẹsẹ ọpọhna bẹ́, “Oyok kw'ikarẹ oning za e. Kẹ od-okkerẹ arọkimaan.”</para>
  <para style="p" vid="1SA 16:11">Samwẹl oben bẹ́, “Tọhm ọnọng oyer-ẹ, okwu. M'ẹwọr moninga maa okwu okebha mina ma.”<verse eid="1SA 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 16:12" />Minna kw'Jẹsẹ ọtọhmọ, matima Devid akwu. Wa ojibhẹ k'ifor, oyen ikkikkerẹ ọkkọkka, obir ojibh ojinọng.</para>
  <para style="p" vid="1SA 16:12">Nya o, Ọvaar Ibinọkpaabyi oben Samwẹl bẹ́, “Bina byeng-ẹ ana k'eso, kẹ wọ kw'ikk'nteka.”<verse eid="1SA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 16:13" />Minna kw'Samwẹl ọtọk mpyi nwo kw'ana, obyeng-ẹ ana ny'ivotte k'ititika. Tọma ny'ewu ndo, Egwugwuma ch'Ọvaar Ibinọkpaabyi ẹsaka ttara ẹfa, ẹnwa Devid k'ifor. Samwẹl o, obina ochina z'Rama.<verse eid="1SA 16:13" /></para>
  <para style="s">Devid orukọ ọmaana Saul</para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 16:14" />M'ogbe nwa, Egwugwuma ch'Ọvaar Ibinọkpaabyi kk'Saul ọbọhk ẹtta, egwugwumatama ch'efon z'Ọvaar Ibinọkpaabyi ẹyak-ẹ odik.<verse eid="1SA 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 16:15" />Atọhmnọng p'Saul maben-ẹ bẹ́, “Kirẹ e, Ọvaar Ibinọkpaabyi wọ ọtọhmọ egwugwumatama nda bẹ́, ẹnang-ọ irem nja e. <verse eid="1SA 16:15" /><verse number="16" style="v" sid="1SA 16:16" />Tte atte kwamina oben mina atọhmnọng pẹ p'aning ma bẹ́, mad-aror ọnọng kw'okpo ogim-ogim okikir. K'ogbe kw'egwugwumatama ch'efon z'Ibinọkpaabyi ẹnwọ-ọ k'ifor, kẹ min'od-okir ogim-ogim nwo, ọfha ọsọ-ọ aninga mawuriji.”<verse eid="1SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 16:17" />Ofona nya o, Saul oben atọhmnọng pẹ bẹ́, “Màror ọnọng kw'okpo okira mawuriji, chen-m.”<verse eid="1SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 16:18" />Ọtọhmnọng wanẹ ọpọhna bẹ́, “Kk'ojinọngnwa wanẹ kw'Jẹsẹ kw'ofon Bẹtẹlẹhẹm nza, kw'okpo ogim-ogim okikir. Kẹ ọbar ettem, obir ode okkikkaama. Okpo ọgbaakadik mawuriji, obir ojibh ojinọng. Ọvaar Ibinọkpaabyi obir oninga ọmaan-ẹ.”<verse eid="1SA 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 16:19" />Ofona nya, Saul ọtọhm azeng-eden pẹ z'Jẹsẹ, oben-ẹ bẹ́, “Tọhm nnwa kwọ Devid, kw'od-okkerẹ arọkimaan chen-m.” <verse eid="1SA 16:19" /><verse number="20" style="v" sid="1SA 16:20" />Minna kw'Jẹsẹ ọtọk brẹd, obir ọtọka atuk k'ogberenwa, ọttara ovunwa, ọdabh k'ẹnyanya, ọtọhm pyẹ, ttara nnwa kwẹ Devid, ochena Saul.<verse eid="1SA 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 16:21" />Devid okwu oruk ọmaana Saul, ọtọma ọtọhm osisi ọmaan-ẹ. Kẹ Devid ọdaak Saul idik maa, okwu ode otim-egbongkpo kwẹ. <verse eid="1SA 16:21" /><verse number="22" style="v" sid="1SA 16:22" />Nya o, Saul ọtọhm ẹkkaabha ọnang Jẹsẹ, oben-ẹ bẹ́, “Tte Devid ochina ororo k'ọtọhm faam, okurọ bẹ́, kaam kk'ettem ndaama mmaan-ẹ.”<verse eid="1SA 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 16:23" />K'ogbe kpenamkpen kw'egwugwumatama ch'efon z'Ibinọkpaabyi ẹnwa Saul, Devid ọd-ọtọka ogim-ogim kwẹ okir. Minna kw'ifor id-ibhekẹ Saul, ibir igbọhk-ẹ. Egwugwumatama ndo ebir ẹttẹ-ẹ ọbọhk.<verse eid="1SA 16:23" /></para>
  <chapter eid="1SA 16" />
  <chapter number="17" style="c" sid="1SA 17" />
  <para style="s">Devid ọmaana Golayat</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 17:1" />Wa m'ogbe nwa, aPhilistiya matobha agbongnọng pabẹ bẹ́, marima egbong. Mattonga z'Soko, z'ẹkọma ch'Juda. Mabhing z'Ẹphẹs-Damim kw'oning k'njeka kw'Soko ọmaana Azeka. <verse eid="1SA 17:1" /><verse number="2" style="v" sid="1SA 17:2" />Saul ọmaana anọng p'Israẹl matobha ayok, mad-abhing z'ilokodo s'Ẹla. Mado ifor k'ose kw'mm'arima aPhilistiya ábẹ̀. <verse eid="1SA 17:2" /><verse number="3" style="v" sid="1SA 17:3" />Wa aPhilistiya aning k'egbe danẹ, anọng p'Israẹl maninga k'egbe ndoza, ilokodo ininga bẹ ny'njeka.<verse eid="1SA 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 17:4" />Okem wanẹ kw'okpen Golayat, kw'ofon Gat, obina z'ibhinga-byi s'aPhilistiya, oyin k'iyaan. Wa ebe chẹ ẹyọhng ntọkọ osowanẹ. <verse eid="1SA 17:4" /><verse number="5" style="v" sid="1SA 17:5" />Z'eso ọfọr igbangbangkpo, z'ifor ọfọra ogbong-nọhma kw'ode bronz, kw'adọhbhiji pẹ made nnọhna ijobh kkamfa okwuma arọbh ijobh p'shẹkẹl. <verse eid="1SA 17:5" /><verse number="6" style="v" sid="1SA 17:6" />Z'mmo, oke ogbongttọhk f'ode bronz, z'nnam ọbhaaka ọkọhn f'ode bronz. <verse eid="1SA 17:6" /><verse number="7" style="v" sid="1SA 17:7" />Wa ọkọhn fẹ odinẹ mach'ẹgbaka ch'anọng pad-ayok ọbara mad-atima. Adọhbhiji p'ẹkọhnma ndo, made ẹnọhna okwuma arọbh ijobh p'shẹkẹl. Otim-ogbongtegba kwẹ ọchẹ-ẹ eden.<verse eid="1SA 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 17:8" />Golayat okwu obe ọkwọhrọ agbongnọng p'Israẹl bẹ́, “Osempira mayin k'iyaan bẹ́, marima egbong? Kaam nde oPhilistiyanọng, bọnga made atọhmnọng p'Saul. Màrọbha ọnọng okebh-m ma. <verse eid="1SA 17:8" /><verse number="9" style="v" sid="1SA 17:9" />Ó̱de okpo orim-m ábẹ̀, ọfhọ-m, mina mm'ode abira pabọnga; okenaka, óde kaam mfhẹ-ẹ, bọnga mm'ade abira pamina, mabira aninga izek-izek kwamina.” <verse eid="1SA 17:9" /><verse number="10" style="v" sid="1SA 17:10" />Nya o, oPhilistiyanọng nwo oben bẹ́, “Menda, nsi ọmmakkaarẹ nnanag agbongnọng p'Israẹl! Mànang-m ọnọng kw'mm'orima ayok ábẹ̀!” <verse eid="1SA 17:10" /><verse number="11" style="v" sid="1SA 17:11" />K'ose kw'Saul ọmaana anọng p'Israẹl maphyir mabhaang idik s'oPhilistiyanọng nwo ọgbaakẹ, ojora fiden ọbọka bẹ ẹkpa-ẹkpa.<verse eid="1SA 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 17:12" />Wa Devid ode nnwa kw'Jẹsẹ kw'ofon Ẹphrat, z'Bẹtẹlẹhẹm, z'ẹkọma ch'Juda. Jẹsẹ oyen ajinọngva ochenọnttaan. Ny'ogbe kw'Saul ọbaabh, wa Jẹsẹ kk'ọtama mawuriji. <verse eid="1SA 17:12" /><verse number="13" style="v" sid="1SA 17:13" />Wa ajinọngva attaan p'Jẹsẹ p'nkk'akkọhra ayọhnga ayok, kk'Saul atora mayin egbong. Wa ocheden ode Eliyab, ttong afa ode Abinadab, ttong attaan ode Shama. <verse eid="1SA 17:13" /><verse number="14" style="v" sid="1SA 17:14" />Devid wọ uwa ode okpongannam. Ayok mbo attaan p'abarẹ ọtam, mator Saul. <verse eid="1SA 17:14" /><verse number="15" style="v" sid="1SA 17:15" />Okenaka, wa Devid od-ochina za ch'Saul oning, obir ọkpa nnam za ch'okkerẹ arọkimaan p'otte z'Bẹtẹlẹhẹm.<verse eid="1SA 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 17:16" />K'iwu arọbh afa, oPhilistiyanọng nwo od-okwu obe k'ekpebha ọmaana k'ẹsọhka, osi ẹmma.<verse eid="1SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 17:17" />Nya o, Jẹsẹ oben nnwa kwẹ Devid bẹ́, “Tọka ọzangnwa nwa kw'agwu p'nkk'abhaabha, ọttara abrẹd-duk ijobh, asẹr-ọsẹr achena ivotte pọ za ch'mabhingẹ. <verse eid="1SA 17:17" /><verse number="18" style="v" sid="1SA 17:18" />Bir tọka ayokpa mba ijobh chena oso kw'egbongkaan chabẹ. Baana ose kw'ivotte maning za, achen-m ẹkkaabha ch'im'efok-m nttem. <verse eid="1SA 17:18" /><verse number="19" style="v" sid="1SA 17:19" />Maning za arim aPhilistiya ábẹ̀ z'ilokodo s'Ẹla, za ch'Saul ọttara agbongnọng p'Israẹl maphyir maning.”<verse eid="1SA 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 17:20" />K'ekpikpebha, Devid obina, otte arọkimaan ọbọhk ọnang okkerẹ-arọkimaan, ọtọka ẹchakpo mbyo otima ofona k'ose kw'Jẹsẹ obenẹ. Okwu opyirẹ ny'ibhinga-byi k'ogbe kw'agbongnọng ad-akwọhrọ agbong-mọng ch'mmin'ayin egbong. <verse eid="1SA 17:20" /><verse number="21" style="v" sid="1SA 17:21" />Wa anọng p'Israẹl ọmaana p'Philistiya mado igbongfor, mabe makkerẹ ayok ititika. <verse eid="1SA 17:21" /><verse number="22" style="v" sid="1SA 17:22" />Devid otte ẹchakpo mbyo ọbọhk ọnang okker-egbongkpo bẹ́, okkerẹ, kẹ Devid otima ẹbhar ochina z'igbongtitika, od-ozima ivotte. <verse eid="1SA 17:22" /><verse number="23" style="v" sid="1SA 17:23" />K'ose kw'ọd-ọgbaak odik ọmaana bẹ, Golayat kw'ode okem kw'aPhilistiya kw'ofon Gat, ọsọbhọ ẹtọkọ ochina ititika, obir ọtọma ọmmakkaarẹ osisi. Devid o, ọbhaanga. <verse eid="1SA 17:23" /><verse number="24" style="v" sid="1SA 17:24" />K'ogbe kw'anọng p'Israẹl aze ojinọng nwo, ojora fiden osi bẹ maphyir, matọr nnam-nnam.<verse eid="1SA 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 17:25" />Wa m'ogbe nwa, anọng p'Israẹl mad-aben bẹ́, “Nkk'aza ose kw'ojinọng nwa od-oyin <char style="it">ma gong-gong</char> ka? Od-oyin okwu osi ọmmakkaarẹ ọnang anọng p'Israẹl. Ọvaarnọng m'ọnang ọnọng kw'ọfhẹ-ẹ oyena kwiden, m'obir ọnang-ẹ ominanwa kwẹ k'ọbada. Obir ọrọbha ẹsọhmmọr ch'otte kwẹ k'ttaazi otitọka m'Israẹl.”<verse eid="1SA 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 17:26" />Devid ọbọbh ajinọng p'abe atum-ẹ nya bẹ́, “Mbọng f'mm'asi anang ọnọng kw'im'ọfhọ oPhilistiyanọng nwa, obir ọrọbha anọng p'Israẹl m'mgbar nja? Anyi wọ ode oPhilistiyanọng nwa kw'ina ọnọm obhirẹ, kw'im'okwu osi ọmmakkaarẹ ọnang agbongnọng p'Ibinọkpaabyi kw'orukọ akpen?”<verse eid="1SA 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 17:27" />Bẹ mabir agbaak-ẹ k'ose kw'mad-aben, matek-ẹ bẹ́, “Ọttọhk f'mm'asi anang ọnọng kw'im'ọfhọ ojinọng nwo vọ ma.”<verse eid="1SA 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 17:28" />K'ogbe kw'Eliyab kw'ode ọgbaanotte kwiden kw'Devid, ọbhaang-ẹ ch'ọd-ọgbaak odik ọmaana ajinọng mbo, obhem ettem ọmaan-ẹ, ọbọbh-ẹ bẹ́, “Akwu mbọng ma o? Anyi wọ kw'agbaar arọkimaan mbo p'nna osisaabh-asaabhẹ z'ẹgba o? Nzong eforga chọ, ttara ebyibyattem ch'ayen ma, akwu bẹ́, akwu aze egbong.”<verse eid="1SA 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1SA 17:29" />Devid oben bẹ́, “Ma, nsi mbọng o? Nning ọdọk odik mgbaakẹ o?” <verse eid="1SA 17:29" /><verse number="30" style="v" sid="1SA 17:30" />Kẹ Devid ọbhakẹ ọd-ọbọbh ọnọng ọdọk-ọdọk odik nwo. Anọng mbo apọhn-ẹ mach'iwura makkikken atek-ẹ. <verse eid="1SA 17:30" /><verse number="31" style="v" sid="1SA 17:31" />Odik kw'Devid ọgbaakẹ, otto anọng k'itọhng, itekẹ ibir ipyirẹ Saul. Saul ọtọhm bẹ́, mayerẹ Devid okwu.<verse eid="1SA 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 17:32" />Devid obenẹ Saul bẹ́, “Tte ettem ening ọnọng ẹyọhnọ okurọ oPhilistiyanọng nwa. Kaam ọtọhmnọng kwọ, m'nd-nrim-ẹ ábẹ̀.”<verse eid="1SA 17:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 17:33" />Saul ọpọhn-ẹ bẹ́, “Kọ oPhilistiyanọng nwa ábẹ̀ màkpo arima e, okurọ bẹ́, kọ atim ade odikkobh. Kẹ ọtọm z'edikkobh chẹ od-orima egbong.”<verse eid="1SA 17:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 17:34" />Devid obenẹ Saul bẹ́, “Kaam ọtọhmnọng kwọ nd-nkkerẹ arọkimaan p'atte kwaam. Ogbe kw'eche, obir ode ochenyang, ekwu etinẹ ọrọkimaan wanẹ ny'otu kwabẹ, <verse eid="1SA 17:34" /><verse number="35" style="v" sid="1SA 17:35" />nd-nkwubh-ẹ, nttem-ẹ maa nnọbh-ẹ ọrọkimaan nwo z'ẹmma. Ó̱de ebe erima ẹmaan-m, mbọk-ẹ ny'iphyabha, nttem-ẹ mfhọ. <verse eid="1SA 17:35" /><verse number="36" style="v" sid="1SA 17:36" />Ọtọhmnọng kwọ kk'eche ọttara ochenyang ọfha. OPhilistiyanọng nwa kw'ina ọnọm obhirẹ m'ode mach'eten danẹ nya, okurọ ch'ikk'agbongnọng p'Ibinọkpaabyi kw'orukọ akpen oluka. <verse eid="1SA 17:36" /><verse number="37" style="v" sid="1SA 17:37" />Ọvaar Ibinọkpaabyi kw'ọrọbh-m k'mbọhk s'eche, ọttara s'ochenyang, m'ọrọbh-m k'mbọhk s'oPhilistiyanọng nwa.”</para>
  <para style="p" vid="1SA 17:37">Saul oben Devid bẹ́, “Zọhng, tte Ọvaar Ibinọkpaabyi oninga ọmaan-ọ.”<verse eid="1SA 17:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1SA 17:38" />Nya o, Saul ọtọka ọnọhma-baba kwẹ ọfọra Devid. Obir ọtọka ogbong-nọhma kwẹ, ọttara igbangbangkpo s'bronz ọfọr-ẹ. <verse eid="1SA 17:38" /><verse number="39" style="v" sid="1SA 17:39" />Devid ọdabh ọkkangkkang ny'ọnọhma-baba nwo, okonga ozenga ọkọbha, okurọ bẹ́, kẹ ekpose mbyo otim ọd-ọfọra. Oben Saul bẹ́, “Kaam ekpo mbya mìmkpo ntima nzenga, okurọ bẹ́, ntima nd-mfọra.” Ofona nya o, ọwọra pyẹ.<verse eid="1SA 17:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1SA 17:40" />Nya o, ọtọka ochikwura kwẹ otima z'ọbọhk, odunga ata achen p'asọhmọ ifor z'ekeka, oyika z'ẹkpa chẹ, obir otima ọbanttẹttẹ kwẹ ozenga ọnyọma oPhilistiyanọng nwo.<verse eid="1SA 17:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 17:41" />OPhilistiyanọng nwo ozenga ọnyọma Devid, otim-ogbongtegba kwẹ ọchẹ-ẹ eden. <verse eid="1SA 17:41" /><verse number="42" style="v" sid="1SA 17:42" />Okkerẹ Devid, oze bẹ́, otim ode odikkobh kw'ojibh ifor, obir ojibh ojinọng. OPhilistiyanọng nwo o, otera osung-ẹ osungọ. <verse eid="1SA 17:42" /><verse number="43" style="v" sid="1SA 17:43" />Oben Devid bẹ́, “Ma, nde ẹffa o, kw'atim nchi akwu bẹ́, arim-m ábẹ̀?” Minna kw'otim eche ch'aka pẹ osi Devid ẹmma. <verse eid="1SA 17:43" /><verse number="44" style="v" sid="1SA 17:44" />Oben bẹ́, “Kwu ma, ntọka oforbukọ kwọ nnang ọnọhn f'iwokọ, ọttara nten s'ẹgba!”<verse eid="1SA 17:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1SA 17:45" />Devid oben oPhilistiyanọng nwo bẹ́, “Kọ atim ọkkangkkang ọmaana ọkọhn akwu bẹ́, arim-m ábẹ̀, okenaka, kaam nkwu bẹ́, nrim-ọ ábẹ̀ k'eche ch'Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir, kw'ode Ibinọkpaabyi kw'agbongnọng p'Israẹl, kw'alukọ. <verse eid="1SA 17:45" /><verse number="46" style="v" sid="1SA 17:46" />Menda nwa, Ọvaar Ibinọkpaabyi m'ọtọk-ọ oke-m k'mbọhk. Kaam m'mfhọ-ọ, mpọ-ọ eso, ntọka aforbukọ p'agbongnọng p'Philistiya nnang ọnọhn f'iwokọ, ọttara nten s'ẹgba. Ayagbin maphyir mazonga bẹ́, Ibinọkpaabyi oning z'Israẹl. <verse eid="1SA 17:46" /><verse number="47" style="v" sid="1SA 17:47" />Anọng maphyir p'attong ma m'azonga bẹ́, ọkkangkkang ọmaana ọkọhn azang f'Ọvaar Ibinọkpaabyi od-otima ọkkaana anọng. Ọvaar Ibinọkpaabyi wọ oyen egbong. M'ọtọka bọnga maphyir, oke mina k'mbọhk.”<verse eid="1SA 17:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1SA 17:48" />K'ose kw'oPhilistiyanọng nwo ozeng ọnyọma bẹ́, orim-ẹ ábẹ̀, Devid otima ẹbhar ochina z'igbongtitika bẹ́, okebh-ẹ za. <verse eid="1SA 17:48" /><verse number="49" style="v" sid="1SA 17:49" />Ọnọhma ọbọhk ny'ikẹ k'ẹkpa, ọrọbha ẹta, oke z'ọbaanttẹttẹ kwẹ, ọtta oPhilistiyanọng nwo ny'ititikattem. Ẹta ndo ẹnwẹ-ẹ ny'ititikattem, otto okwubha ititika ny'izek.<verse eid="1SA 17:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1SA 17:50" />Minna kw'Devid otim ọbaanttẹttẹ ọmaana ẹta dẹ-dẹ okema oPhilistiyanọng nwo, ọfhẹ-ẹ, chibhẹ ch'ina ọkkangkkang otim.<verse eid="1SA 17:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1SA 17:51" />Devid otima ẹbhar od-obe ọnyọm-ẹ ny'ifor. Ọrọbha ọkkangkkang kw'oPhilistiyanọng nwo z'ọpa, otima ọfhẹ-ẹ, ọpẹ-ẹ eso.</para>
  <para style="p" vid="1SA 17:51">Ch'aPhilistiya maze bẹ́, okkikkaama kwabẹ kk'ọpa, mabhakẹ nnam, marọbh.<verse eid="1SA 17:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1SA 17:52" />Nya o, agbongnọng p'Israẹl ọmaana p'Juda matima ọmọngkwọhrọ akwubh anọng p'Philistiya maa, mapyirẹ z'Gat ọmaana z'mmumma s'Ẹkrọn. Aforbukọ p'anọng p'Philistiya, ọmaana ayok p'mamum ekpo, mayima <char style="it">bẹ́ bangẹ-bangẹ</char>, z'eden ch'Sharayim ch'echin z'Gat ọmaana Ẹkrọn. <verse eid="1SA 17:52" /><verse number="53" style="v" sid="1SA 17:53" />K'ogbe kw'anọng p'Israẹl makpa nnam za ch'makwubhọ aPhilistiya, madim z'ibhinga-byi s'aPhilistiya, macha ekpo pyabẹ.<verse eid="1SA 17:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1SA 17:54" />Devid otima eso ch'oPhilistiyanọng nwo ozeng z'Jẹrusalẹm, obir ọtọka egbongkpo py'oPhilistiyanọng nwo osok z'ikẹ oyenẹ k'ikkira.<verse eid="1SA 17:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="1SA 17:55" />K'ose kw'Saul oze Devid ch'od-ofona bẹ́, okebha oPhilistiyanọng nwo, ọbọbh Abnẹr kw'ode oso kw'agbongnọng bẹ́, “Abnẹr, anyi wọ obhonọ odikkobh nwo?”</para>
  <para style="p" vid="1SA 17:55">Abnẹr ọpọhna bẹ́, “O ọvaarnọng, k'ose kw'arukọ akpen achina ororo, kaam otte kinzong.”<verse eid="1SA 17:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1SA 17:56" />Ọvaarnọng oben bẹ́, “Zọhng ror ọnọng kw'obhonọ odikkobh nwa.”<verse eid="1SA 17:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="1SA 17:57" />K'ose kw'Devid ofon za ch'ọfhọ oPhilistiyanọng nwo, Abnẹr otim-ẹ okebha Saul ny'ogbe kw'Devid otim-otim eso ch'oPhilistiyanọng nwo ny'ọbọhk.<verse eid="1SA 17:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1SA 17:58" />Saul ọbọbh-ẹ bẹ́, “Odikkobh, anyi wọ ode atte kwọ?”</para>
  <para style="p" vid="1SA 17:58">Devid ọpọhn-ẹ bẹ́, “Kaam nde nnwa kw'ọtọhmnọng kwọ Jẹsẹ, kw'ofon Bẹtẹlẹhẹm.”<verse eid="1SA 17:58" /></para>
  <chapter eid="1SA 17" />
  <chapter number="18" style="c" sid="1SA 18" />
  <para style="s">Saul oyen ottemma k'Devid k'ifor</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 18:1" />Ch'Devid kk'odik ọgbaaka ọmaana Saul maphyir, Jonatan okwu ode eyokdikkobh-ttem ch'Devid, Devid obir ọdaak-ẹ mach'ifor sẹ. <verse eid="1SA 18:1" /><verse number="2" style="v" sid="1SA 18:2" />Tọma ny'ewu ndo, Devid oninga ọmaana Saul, ọdọk kocher bẹ́, Devid ọbhana z'otte k'ọsọhm. <verse eid="1SA 18:2" /><verse number="3" style="v" sid="1SA 18:3" />Jonatan osi echekẹ ọmaana Devid okurọ ch'Devid ọdaak-ẹ mach'ifor sẹ. <verse eid="1SA 18:3" /><verse number="4" style="v" sid="1SA 18:4" />Jonatan ọwọra ọnọhma-baba kw'ọfọr ny'ifor, ọnang Devid, ọmaana ọnọhma kw'ọkpaar mbọhk opyirẹ ny'ndudungọ, ọmaana ọkkangkkang, ọmaana oyuk, ọttara odikpa kwẹ.<verse eid="1SA 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 18:5" />Ọtọhm kpenamkpen f'Saul ọtọhm-ẹ, Devid od-osi mawuriji. Ofona nya o, Saul ọnang-ẹ ediden ch'agbongnọng. Odik nwa ọdaam anọng maphyir, ọttara atọhmnọng p'Saul ettem.<verse eid="1SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 18:6" />K'ogbe kw'agbongnọng mbo mad-akwuna-okwuna, ch'Devid ikk'oPhilistiyanọng nwo ọfha, panọng mabina ny'ibhon s'Israẹl maphyir, matima ọkkọhna, ọmaana otubha, ọmaana amọng p'odidaama, ọmaana mbin, ọttara agim-ogim, matima akebha ọvaar Saul. <verse eid="1SA 18:6" /><verse number="7" style="v" sid="1SA 18:7" />K'ose kw'matubhọ, makkọhn bẹ́,</para>
  <para style="q1" vid="1SA 18:7">“Saul kk'anọng ọfha k'nnọhna k'nnọhna,</para>
  <para style="q2" vid="1SA 18:7">Devid ọfhọ anọng k'nnọhna s'ina obhika ide.”<verse eid="1SA 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 18:8" />Wa Saul ọdọk-ẹ mawuriji, okurọ ẹmọng nda. Ochibhẹ bẹ́, “Nkk'Devid atọhnga ọmaana nnọhna s'ina obhika ide, okenaka, matọhnga kaam bẹ́, mfhọ k'nnọhna jẹ-jẹ. Mbọng vọ ina orik-ẹ bẹ́, ọtọka, ina ẹvaar ode?” <verse eid="1SA 18:8" /><verse number="9" style="v" sid="1SA 18:9" />Tọma ny'ogbe nwo china ororo, Saul noyena ottemma ọmaana Devid.<verse eid="1SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 18:10" />Ewu esobh nya, egwugwumatama ch'efon z'Ibinọkpaabyi, ẹnwa Saul ẹfa-ẹfa, ẹyẹ-ẹ, ọtọma idik oyiyaakẹ ny'ọsọhm kwẹ. Ch'Devid od-okir ogim-ogim mach'od-okkikken osi, Saul otima ọkọhn ny'ọbọhk ọbharẹ, <verse eid="1SA 18:10" /><verse number="11" style="v" sid="1SA 18:11" />oben z'ettem bẹ́, “M'nkwum Devid mmaana ny'etumọ.” Okenaka, Devid ọnaang-ẹ k'igbedim minna, ifa.<verse eid="1SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 18:12" />Wa Saul oning k'ojora f'Devid okurọ bẹ́, wa Ọvaar Ibinọkpaabyi kk'Saul ọbọhk ọtta, noninga ọmaana Devid. <verse eid="1SA 18:12" /><verse number="13" style="v" sid="1SA 18:13" />Ofona nya o, Saul okwubh Devid z'ikẹ k'ọsọhm, ọsẹ-ẹ oso kw'agbongnọng nnọhna mfa okwuma arọbh ijobh. Devid od-ochi agbongnọng eden, otima bẹ oyin egbong, obir otima bẹ okwuna. <verse eid="1SA 18:13" /><verse number="14" style="v" sid="1SA 18:14" />Ọttọhk kpenamkpen f'uwa Devid osi, od-ojibh ọnang-ẹ, okurọ ch'iwa Ọvaar Ibinọkpaabyi oning ọmaan-ẹ. <verse eid="1SA 18:14" /><verse number="15" style="v" sid="1SA 18:15" />Ch'Saul oze ose kw'idik id-ijibh inang-ẹ, okwu oyena ojora f'Devid. <verse eid="1SA 18:15" /><verse number="16" style="v" sid="1SA 18:16" />Okenaka, wa anọng p'Israẹl ọmaana anọng p'Juda maphyir mayen ọdaakẹ amaana Devid, okurọ ch'iwa od-ochi bẹ eden k'mgbong sabẹ.<verse eid="1SA 18:16" /></para>
  <para style="s">Devid ọtọk ominanwa kw'Saul k'ọbada</para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 18:17" />Saul obenẹ Devid bẹ́, “Kirẹ Mẹrab kw'ode ominanwa kwaam kwiden ma. Kaam m'nttẹ-ẹ ọbọhk nnang-ọ k'ọbada. Kọ m'akenaka ade orim-egbong kwaam kw'ọbar ettem, arima mgbong s'Ọvaar Ibinọkpaabyi.” Ode ch'Saul kk'ochibha bẹ́, “Kaam kẹ ọbọhk mìntwu. Tte aPhilistiya azeng mmo asẹ-ẹ itama!”<verse eid="1SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 18:18" />Minna kw'Devid oben Saul bẹ́, “Kaam nde anyi? Ẹsọhmmọr chaam ọmaana efona ch'atte kwaam ẹbang k'ambọng m'ẹkọma ch'Israẹl, kw'kaam m'nkwu nde ọnyẹ kw'ọvaarnọng o?” <verse eid="1SA 18:18" /><verse number="19" style="v" sid="1SA 18:19" />Okenaka, nokwu opyirẹ k'ogbe kw'uwura Saul nọtọk ominanwa kwẹ Mẹrab ọnang Devid, nọtọk-ẹ ọnang Adriyẹl kw'ofon Mẹhola k'ọbada.<verse eid="1SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 18:20" />M'ogbe nwa, wa Mikal kw'obir ode ominanwa kw'Saul oyen ọdaakẹ ọmaana Devid. Matek Saul odik nwo nya o, ettem elebh-ẹ. <verse eid="1SA 18:20" /><verse number="21" style="v" sid="1SA 18:21" />Oben z'ettem bẹ́, “Kaam m'nttẹ-ẹ ọbọhk nnang-ẹ k'ọbada, ọfha ntim-ẹ nwọna Devid ọmma k'ose kw'im'otto aPhilistiya k'mbọhk.” Ofona nya, Saul oben Devid bẹ́, “Menda kk'obhokọ ttong afa ayena bẹ́, ade ọnyẹ kwaam.”<verse eid="1SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 18:22" />Nya o, Saul oben atọhmnọng pẹ bẹ́, “Màzenga nnam-nnam zọhng gbaak Devid bẹ́, ‘Kirẹ e, ettem ẹdaam ọvaar Saul ẹmaan-ọ, abir adaak atọhmnọng pẹ maphyir idik; chera bẹ́, m'ade ọnyẹ kwẹ.’ ”<verse eid="1SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 18:23" />Minna kw'atọhmnọng p'Saul magbaak Devid idik njo. Okenaka, Devid ọpọhna bẹ bẹ́, “Ọmọm-ọmọm bẹ́, ọnọng ode ọnyẹ kw'ọvaarnọng o? Kaam nde ogbugbora, kw'ina ọttọhk áfẹ̀ mbang.”<verse eid="1SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 18:24" />Ch'atọhmnọng p'Saul matek-ẹ ose kw'Devid ọgbaakẹ bẹ, <verse eid="1SA 18:24" /><verse number="25" style="v" sid="1SA 18:25" />Saul ọpọhna bẹ́, “Màben Devid bẹ́, ‘Ọvaarnọng ẹba-phya ọdọk-ọdọk kororọ ch'ẹkpanẹ mkpatọr arọbh achen s'aPhilistiya, ọfha otima otuka idik s'awawunanọng pẹ.’ ” Wa achibhẹ p'Saul ade bẹ́, osi Devid otto k'mbọhk s'aPhilistiya.<verse eid="1SA 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 18:26" />K'ogbe kw'atọhmnọng mbo matek Devid idik nja, ettem ẹdaam-ẹ bẹ́, m'ode ọnyẹ kw'ọvaarnọng. Pira ogbe kw'make okwu ọkpan, <verse eid="1SA 18:26" /><verse number="27" style="v" sid="1SA 18:27" />Devid ọmaana ajinọng pẹ mafona mad-afhọ aPhilistiya arọbh ijobh. Ọtọka mkpatọr sabẹ s'ittong obhik, ochena ọvaarnọng, ọfha ode ọnyẹ kw'ọvaarnọng. Nya o, Saul ọtọka ominanwa kwẹ Mikal, ọnang Devid k'ọbada.<verse eid="1SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 18:28" />Okwu ọttaanẹ Saul bẹ́, Ọvaar Ibinọkpaabyi oning ọmaana Devid, ọttara bẹ́, Mikal kw'ode ominanwa kwẹ, obir oyena ọdaakẹ ọmaana Devid. <verse eid="1SA 18:28" /><verse number="29" style="v" sid="1SA 18:29" />Devid odo Saul ojor-ojora. Saul ochina ororo osok Devid iwawuna k'akpen pẹ maphyir.<verse eid="1SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 18:30" />Nya o, aso p'agbongnọng p'Philistiya machina ororo arima mgbong. Okenaka, k'ose kw'marim achina ororo, minna kw'idik ijibhẹ ọtam inang Devid iyọhnga atọhmnọng mboza p'Saul, eche chẹ ebir ekpobha mawuriji.<verse eid="1SA 18:30" /></para>
  <chapter eid="1SA 18" />
  <chapter number="19" style="c" sid="1SA 19" />
  <para style="s">Saul okong bẹ́, ọfhọ Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 19:1" />Saul oben nnwa kwẹ Jonatan, ọmaana atọhmnọng pẹ maphyir bẹ́, mafhọ Devid. Okenaka, ch'iwa Devid ọdaak Jonatan idik, <verse eid="1SA 19:1" /><verse number="2" style="v" sid="1SA 19:2" />ọtọr-ẹ itọhng bẹ́, “Atte kwaam Saul oning za ororọ eden bẹ́, ọfhọ-ọ. Ophyinẹ k'ekpebha m'azong-ọ ifor. Ror ibyi tubha, aninga nya. <verse eid="1SA 19:2" /><verse number="3" style="v" sid="1SA 19:3" />Kaam m'nyin k'iyaan, nd-mbe mmaana atte kwaam ny'owonọ nwo kw'im'atubha. M'mgbaak odik kwọ nnang-ẹ, ọfha ntek-ọ ose kw'mmaang.”<verse eid="1SA 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 19:4" />Nya o, Jonatan ọgbaak ejibha ch'Devid ọnang otte kwẹ Saul, oben-ẹ bẹ́, “Tte ọvaarnọng oning ọtọhmnọng kwẹ Devid itama osi; kẹ kọ kopinẹ, osisi kwẹ otera ode ejibha ọnang-ọ. <verse eid="1SA 19:4" /><verse number="5" style="v" sid="1SA 19:5" />Devid ochera obo k'ogbe kw'ọfhọ oPhilistiyanọng. Ọvaar Ibinọkpaabyi osi anọng p'Israẹl maphyir mayena ekema chiden, kọ abir aze, ettem ẹdaam-ọ. Kayen kw'im'apinẹ Devid kw'mbọhk sẹ iwur-owur, afhẹ-ẹ k'ọjaakadik?”<verse eid="1SA 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 19:6" />Saul ọbhaanga odik kw'Jonatan. Ọnwọhnga bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, ọdọk Devid mìmfhọ.”<verse eid="1SA 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 19:7" />Minna kw'Jonatan oyerẹ Devid otek-ẹ idik s'ikẹ ọmaana otte magbaakẹ maphyir. Ọtọk-ẹ ochena Saul, Devid obir oninga ọmaana Saul k'ose kw'uwa okkikken oninga.<verse eid="1SA 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 19:8" />Wa egbong ebir etto, Devid obina od-orima aPhilistiya ábẹ̀, ọfhọ bẹ m'ẹfa-ẹfa maa, marọbh arik egbong.<verse eid="1SA 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 19:9" />Otum k'ewu danẹ, ch'Saul oning ẹwọr ny'ikẹ k'ọsọhm ọttara ọkọhn fẹ ny'ọbọhk, egwugwumatama ch'efon z'Ọvaar Ibinọkpaabyi ẹnwa Saul. Ny'ogbe nwo, Devid od-okir ogim-ogim. <verse eid="1SA 19:9" /><verse number="10" style="v" sid="1SA 19:10" />Saul oror eden ch'im'otima ọkọhn okwum Devid ọbaanga z'etumọ. Okenaka, Devid ọraka, ọkọhn mvo okwum z'etumọ. Devid ọrọbh ọnaanga ny'erungọ ndo.<verse eid="1SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 19:11" />Saul ọtọhm ajinọng pẹ bẹ́, mad-abaana Devid z'ikẹ k'ọsọhm mfha mafhẹ-ẹ k'ekpebha. Okenaka, Mikal kw'ode kwanọng kw'Devid, oben-ẹ bẹ́, “Ó̱de ina arọbhọ, akaam akpen pọ m'erungọ nda, ophyinẹ mm'afhọ-ọ ọfhọ o!” <verse eid="1SA 19:11" /><verse number="12" style="v" sid="1SA 19:12" />Nya o, Mikal ọkkaana Devid ozenga k'ọmma kw'ofum ọsaka, ọrọbh ọnaanga. <verse eid="1SA 19:12" /><verse number="13" style="v" sid="1SA 19:13" />Minna kw'Mikal ọtọk ọkpata, orurọ ny'ebin, obubh-ẹ ibara, obir ọnan-ẹ eso k'avu-phyabha.<verse eid="1SA 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 19:14" />K'ogbe kw'Saul ọtọhm ajinọng pẹ bẹ́, mabọk Devid, Mikal obenẹ bẹ bẹ́, “Ọmmẹ-ẹ ọmma.”<verse eid="1SA 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 19:15" />Nya o, Saul obir ọtọhm ajinọng mbo, oben bẹ bẹ́, “Màtin-ẹ ny'ebin chẹ chen-m, mfhẹ-ẹ.” <verse eid="1SA 19:15" /><verse number="16" style="v" sid="1SA 19:16" />K'ose kw'ajinọng mbo madimẹ z'ẹtaanga, maze ọkpata nwo ny'ebin ch'ọnan eso ny'avu-phyabha.<verse eid="1SA 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 19:17" />Saul oben Mikal bẹ́, “Osempira abọhr-m, awọhkọ ọwawunanọng kwaam ọrọbh?”</para>
  <para style="p" vid="1SA 19:17">Mikal ọpọhn-ẹ bẹ́, “Kẹ oben-m bẹ́, ‘Ini kaam ọbọhk atte nnọbh, m'mfhọ-ọ.’ ”<verse eid="1SA 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 19:18" />Minna kw'Devid ọrọbhọ ọnaanga, od-okebha Samwẹl z'Rama, otek-ẹ okpenamkpen f'Saul ikk'ẹ ọsa. Kẹ ọttara Samwẹl machina z'Naiyọt, mad-aruk za. <verse eid="1SA 19:18" /><verse number="19" style="v" sid="1SA 19:19" />Minna kw'matekẹ Saul bẹ́, “Devid oning z'Naiyọt z'ẹbhaakẹ ch'Rama.” <verse eid="1SA 19:19" /><verse number="20" style="v" sid="1SA 19:20" />Ofona nya o, Saul ọtọhm ajinọng pẹ bẹ́, mad-abọka Devid. K'ogbe kw'maze ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi ch'nd-ayaakẹ idik, Samwẹl obir obe nya ọmaana bẹ mach'oso kwabẹ. Egwugwuma ch'Ibinọkpaabyi ẹnwa ajinọng p'Saul, bẹ mabir ayaakẹ idik ọdọk. <verse eid="1SA 19:20" /><verse number="21" style="v" sid="1SA 19:21" />K'ose kw'matekẹ Saul odik nwo, ọtọhm ajinọng ọdọk-ọdọk, mabir ayaakẹ idik ọdọk. Saul obir ọtọhm ajinọng ttong igbedim ittaan, bẹ mabir ator bẹ mayaakẹ idik. <verse eid="1SA 19:21" /><verse number="22" style="v" sid="1SA 19:22" />K'okpongannamgbe, Saul oyenẹ ozeng mmo ọta z'Rama, ochina z'esipe chiden ch'ening z'Seku. Ọbọbh bẹ́, “Samwẹl ọmaana Devid kẹ o?”</para>
  <para style="p" vid="1SA 19:22">Mapọhn-ẹ bẹ́, “Maning z'Naiyọt, z'ẹbhaakẹ ch'Rama.”<verse eid="1SA 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 19:23" />Minna kw'Saul ochin z'Naiyọt, z'ẹbhaakẹ ch'Rama. Opyirẹ za o, Egwugwuma ch'Ibinọkpaabyi ebir ẹnwẹ-ẹ, kẹ ozenga, obira ọd-ọyaakẹ idik maa, opyirẹ z'Naiyọt, z'ẹbhaakẹ ch'Rama. <verse eid="1SA 19:23" /><verse number="24" style="v" sid="1SA 19:24" />Ọwọra ẹfọrakpo pyẹ, obir ọyaakẹ idik ny'Samwẹl k'ititika. Oyima erinikwum ny'ewu ndo ọttara ny'orungiwu nwo maphyir. Nya wọ osi anọng ad-aben bẹ́, “Ma, Saul kẹ obir ọttara k'ẹkaan ch'agbaak-ettem ch'Ibinọkpaabyi o?”<verse eid="1SA 19:24" /></para>
  <chapter eid="1SA 19" />
  <chapter number="20" style="c" sid="1SA 20" />
  <para style="s">Devid ọmaana Jonatan</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 20:1" />Nya o, Devid ọrọbh z'Naiyọt kw'oning z'ẹkọma ch'Rama, ochina za ch'Jonatan oning, ọd-ọbọbh-ẹ bẹ́, “Kaam oyenẹ nsi mbọng o? Bọng-odik kw'njẹ o? Mpinẹ atte kwọ yen o, kw'od-oror-m bẹ́, ọfhọ-m o?”<verse eid="1SA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 20:2" />Jonatan ọpọhn-ẹ bẹ́, “Minna mòde! Kọ màpe! Tte ntek-ọ e, ọttọhk mavanẹ kode f'atte kwaam osi, zaabẹ́ ọchamẹ yen, obir ọbar yen, f'ina eden od-ochi otek-m. Kayen kw'ikẹ im'odubh-m odik nwoma? Odik nwo minna kode!”<verse eid="1SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 20:3" />Okenaka, Devid ọnwọhngọ, oben-ẹ bẹ́, “Atte kwọ ozong mawuriji bẹ́, kaam ndaak-ọ idik, obir oben z'ettem bẹ́, tte Jonatan oning odik nwoma ozong o, ọfha oning k'oforpyibha oning. Okenaka, k'odik ọkkọkka, k'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, kọ abir aruk akpen, obo kw'nd-ntima nzenga ma.”<verse eid="1SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 20:4" />Jonatan oben Devid bẹ́, “Okpenamkpen f'arorọ bẹ́, nsi nnang-ọ, kaam m'nsosi.”<verse eid="1SA 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 20:5" />Ofona nya, Devid oben bẹ́, “Jima bẹ́, ophyinẹ wọ ode edidaamawu ch'ophe ọbhakwẹ, kw'ọbaan bẹ́, nchi ọttọhk mmaana ọvaarnọng. Okenaka, tte mfona nd-ntubha z'owonọ maa opyirẹ ophyinẹ-ojek k'ẹsọhka. <verse eid="1SA 20:5" /><verse number="6" style="v" sid="1SA 20:6" />Ó̱de atte kwọ ọbọbh-ọ bẹ́, kaam kẹ? Tek-ẹ bẹ́, ‘Devid kk'ẹfa ọtọka k'kaam bẹ́, m'ọsẹr-ọsẹr ọta k'abẹ, z'Bẹtẹlẹhẹm, okurọ ẹja chabẹ ch'mad-afọhnọ k'obhon maphyir k'icho k'icho.’ <verse eid="1SA 20:6" /><verse number="7" style="v" sid="1SA 20:7" />Ó̱de obenẹ bẹ́, ‘Ọbaan-ọbaana,’ oyinẹ bẹ́, kaam ọtọhmnọng kwọ kk'nnaanga. Okenaka, óde odik nwo opyibh-ẹ ettem, nya kw'im'azonga k'odik ọkkọkka bẹ́, ọkamẹ itama ọmaan-m. <verse eid="1SA 20:7" /><verse number="8" style="v" sid="1SA 20:8" />Kọ si ejibha nang kaam ọtọhmnọng kwọ, mach'ikk'acheka anang-m k'Ọvaar Ibinọkpaabyi k'ititika. Ó̱de kaam mpinẹ, kọ oyenẹ zenga mmo fhọ-m! Kayen kw'm'atọk-m ake atte k'mbọhk o?”<verse eid="1SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 20:9" />Jonatan oben bẹ́, “Minna mòde! Ó̱de kaam ikk'ayaabhẹ biribirẹ mmaanga bẹ́, atte kwaam ọkam-ọ itama, wura kọ kìntekẹ o?”<verse eid="1SA 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 20:10" />Devid ọbọbh-ẹ bẹ́, “Anyi wọ im'otek-m, óde atte kwọ ọpọhn-ọ k'eden-tama?”<verse eid="1SA 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 20:11" />Jonatan oben bẹ́, “Kwu, tte mochina z'owonọ.” Minna kw'matọnọ ẹkaan achina z'owonọ.<verse eid="1SA 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 20:12" />Nya o, Jonatan oben Devid bẹ́, “Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl wọ im'ode nttẹsẹ kwamina. Ophyinẹ ogbese nwa, wanẹma ophyinẹ-ojek, k'ogbe kw'ikk'atte kwaam ndọna nzonga óde otim-ọ k'ettem ọkkọkka, m'nsọ-ọ azonga. <verse eid="1SA 20:12" /><verse number="13" style="v" sid="1SA 20:13" />Okenaka, óde atte kwaam ọkamẹ bẹ́, ọsọ-ọ ọttọhk, m'nsọ-ọ azonga k'odik okkọkka, ọfha afona k'odiriji. Ó̱de ina minna nsi, tte Ọvaar Ibinọkpaabyi osi-m itama, zaa wura m'ibar yen. Tte Ọvaar Ibinọkpaabyi oninga ọmaan-ọ k'ose kw'ikk'oninga ọmaana atte kwaam. <verse eid="1SA 20:13" /><verse number="14" style="v" sid="1SA 20:14" />Ma ch'ntim nruk akpen, kọhk-m ọdaakẹ kira nwo kw'Ọvaar Ibinọkpaabyi, ọfha anọng aning-m afhọ. <verse eid="1SA 20:14" /><verse number="15" style="v" sid="1SA 20:15" />Kwuna ejibha kàkpọka osisi anang ẹsọhmmọr chaam o, obir ode k'ogbe kw'Ọvaar Ibinọkpaabyi kk'ọwawunanọng kpenamkpen kw'Devid eche odima m'iyagbin.”<verse eid="1SA 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 20:16" />Minna kw'Jonatan osi echekẹ ọnang ẹsọhmmọr ch'Devid, oben bẹ́, “Tte Ọvaar Ibinọkpaabyi otuka itama s'awawunanọng p'Devid asẹ-ẹ.” <verse eid="1SA 20:16" /><verse number="17" style="v" sid="1SA 20:17" />Jonatan osi Devid obir ochekẹ k'ọdaakẹ kw'oyen ọmaan-ẹ, okurọ ch'Devid ọdaak-ẹ mach'ifor sẹ oyenẹ.<verse eid="1SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 20:18" />Nya o, Jonatan oben Devid bẹ́, “Ophyinẹ wọ ode edidaamawu ch'ophe ọbhakwẹ. M'ikọ mòze, okurọ bẹ́, ogbera kwọ m'otte eje. <verse eid="1SA 20:18" /><verse number="19" style="v" sid="1SA 20:19" />Ophyinẹ-ojek k'ẹsọhka, china z'ibyi njo s'iwendo atubh k'ogbe kw'ẹkọhr ndoma ẹtọm, aninga anyọma ny'ẹta ch'Ẹzẹl atik-m. <verse eid="1SA 20:19" /><verse number="20" style="v" sid="1SA 20:20" />Kaam m'ntta ayuk attaan k'ẹbhaakẹ danẹ ch'ẹta ndo mach'nkamẹ ọttọhk. <verse eid="1SA 20:20" /><verse number="21" style="v" sid="1SA 20:21" />M'ntọhm odikkobhnwa, mben-ẹ bẹ́, ‘Zọhng ror ayuk mbo.’ Ó̱de mben-ẹ bẹ́, ‘Kirẹ ka, ayuk mbo aning m'ẹbhaakẹ nda chọ; tọka tima kwu ma,’ nya wọ oyinẹ bẹ́, akwu, okurọ bẹ́, k'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, kọ kk'anaanga, itama kide. <verse eid="1SA 20:21" /><verse number="22" style="v" sid="1SA 20:22" />Okenaka, óde mbenẹ odikkobhnwa nwo bẹ́, ‘Kirẹ ka, ayuk mbo aning-ọ z'ororo,’ nya wọ oyinẹ bẹ́, m'abina nya, okurọ bẹ́, Ọvaar Ibinọkpaabyi kk'ọ obena bẹ́, azọhng afona. <verse eid="1SA 20:22" /><verse number="23" style="v" sid="1SA 20:23" />Z'echekẹ ch'ikọ ọttara kaam nkk'ocheka, jima bẹ́, Ọvaar Ibinọkpaabyi wọ ode nttẹsẹ kwamina kw'ttattampe.”<verse eid="1SA 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 20:24" />Minna kw'Devid otubh z'owonọ nwo. Ch'ogbe kw'odidaama kw'ophe ọbhakwẹ nokwu o, ọvaar Saul oninga ẹwor bẹ́, ochi ọttọhk. <verse eid="1SA 20:24" /><verse number="25" style="v" sid="1SA 20:25" />Ọvaarnọng oninga z'ogbera kwẹ ọnyọma etumọ mach'od-okkikken oninga, okkerẹ Jonatan ititika. Abnẹr oninga otuma Saul, eninga ch'Devid ette eje. <verse eid="1SA 20:25" /><verse number="26" style="v" sid="1SA 20:26" />Ny'ewu ndo, Saul odik kpenamkpen kọgbaakẹ okurọ ch'ochibhẹ bẹ́, “Ọttọhk kk'Devid ọsa, ozong-ẹ ifor bẹ́, k'odik ọkkọkka, kẹ Devid kowurọ k'ose kw'im'osi odidaama nwo.” <verse eid="1SA 20:26" /><verse number="27" style="v" sid="1SA 20:27" />Okenaka, k'ewu ndoka ch'ettong ifa s'ophe nwo, eninga ch'Devid ebira ette eje. Nya kw'Saul nọbọbhọ nnwa kwẹ Jonatan bẹ́, “Ode yen kw'chena ọttara menda ojinọngnwa kw'Jẹsẹ ina mina otorọ m'ọchattọhk mva?”<verse eid="1SA 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 20:28" />Jonatan ọpọhn-ẹ bẹ́, “Devid ọsak ifor ophyem-m bẹ́, nttẹ-ẹ ọbọhk ọta z'Bẹtẹlẹhẹm. <verse eid="1SA 20:28" /><verse number="29" style="v" sid="1SA 20:29" />Oben-m bẹ́, ‘Ototo, tte-m ọbọhk mfona okurọ bẹ́, ẹsọhmmọr chamina eyen ẹja ch'im'ẹfọhnọ z'obhon e. Agbaanatte kwaam kw'ejinọng kk'ẹkkaabha ọtọhma bẹ́, nta za. Ó̱de ndaak-ọ idik, tte-m ọbọhk mfona nd-nze ivotte paam.’ Kẹ wọ osi pira m'okpokkoro kw'ọvaarnọng kokwu e.”<verse eid="1SA 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 20:30" />Saul ọdọk-ẹ ọmaana Jonatan, oben-ẹ bẹ́, “Kọ nnwa kw'kwanọng-tama! Ọsọ-ọ bẹ́, kinzong bẹ́, atorọ ojinọngnwa kw'Jẹsẹ mad-asi igbardik nja anang ifor sọ, ọttara akka kw'ọmaan-ọ? <verse eid="1SA 20:30" /><verse number="31" style="v" sid="1SA 20:31" />K'ose kw'ojinọngnwa kw'Jẹsẹ orukọ akpen m'izek nja: ode kọ o, obir ode ẹvaar chọ o, kwuna mèttima. Tọhm anọng yina-yina ma, matim-ẹ akwu, okurọ bẹ́, ọbaan bẹ́, ope!”<verse eid="1SA 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 20:32" />Jonatan ọbọbh otte bẹ́, “Okurọ yen kw'im'ope o? Ọjẹ mbọng o?” <verse eid="1SA 20:32" /><verse number="33" style="v" sid="1SA 20:33" />Minna kw'Saul ọbharẹ ọkọhn fẹ bẹ́, ọfhọ Jonatan. Ofona nya, Jonatan ozonga bẹ́, otte ọkamẹ bẹ́, ọfhọ Devid.<verse eid="1SA 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 20:34" />Ọdọkọ Jonatan maa, obina ny'okpokkoro nwo <char style="it">bẹ́ bik</char> ofona. Ny'ewu ch'ettong ifa s'ophe nwo, ọttọhk kochi okurọ k'oforpyibha kw'igbardik s'otte od-otima otor Devid.<verse eid="1SA 20:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1SA 20:35" />Ny'ekpebha, Jonatan otima odikkobhnwa wanẹ ochina z'owonọ bẹ́, od-oyena nttọhna ọmaana Devid. <verse eid="1SA 20:35" /><verse number="36" style="v" sid="1SA 20:36" />Oben odikkobhnwa nwo bẹ́, “Tima ẹbhar, zọhng ror ayuk mbo p'ntta.” K'ose kw'odikkobhnwa nwo ofum ẹbhar, kẹ ọtta oyuk nwo ọkpan-ẹ. <verse eid="1SA 20:36" /><verse number="37" style="v" sid="1SA 20:37" />Ch'odikkobhnwa nwo opyirẹ z'ibyi s'oyuk kw'Jonatan otto, Jonatan oyer-ẹ, ọbọbh-ẹ bẹ́, “Ma, oyuk nwo kọ kọkpanẹ o?” <verse eid="1SA 20:37" /><verse number="38" style="v" sid="1SA 20:38" />Obir oben-ẹ bẹ́, “Sẹr-ọsẹr, k'eden kàkpọka o!” Minna kw'odikkobhnwa nwo odung ayuk mbo otima ọkpa nnam ochena otte. <verse eid="1SA 20:38" /><verse number="39" style="v" sid="1SA 20:39" />(Odikkobhnwa nwo odik kw'od-oyin nya maphyir-phyir kozong. Jonatan ọttara Devid bẹ-bẹ bọ azong.) <verse eid="1SA 20:39" /><verse number="40" style="v" sid="1SA 20:40" />Nya o, Jonatan ọtọka egbongkpo pyẹ ọnang odikkobhnwa nwo, obir oben-ẹ bẹ́, “Tima ekpo mbyoma kpa nnam z'obhon.”<verse eid="1SA 20:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 20:41" />Ch'odikkobhnwa nwo ikk'ofona, Devid obina z'ẹbhaakẹ ch'ẹwọn-ẹwọna kw'ọta nwo, okwu ottima ndudungọ, otwu ititika ny'izek, ọraka eso igbedim ittaan ọnang Jonatan. Minna kw'bẹ anọng afa mabaaka ayok, matọn-ọtọn asọhrọ asen. Devid wọ iwa ọsọhrọ asen ọtam.<verse eid="1SA 20:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1SA 20:42" />Nya o, Jonatan oben Devid bẹ́, “Zọhng k'ọdaam, okurọ bẹ́, nkk'ocheka k'eche ch'Ọvaar Ibinọkpaabyi bẹ́, ‘Ọvaar Ibinọkpaabyi m'oninga k'njeka kw'ikọ ọttara kaam, ọmaana k'njeka kw'iva p'iva pọ ọttara kw'iva p'iva paam, ttattampe.’ ” Nya o, Devid ofona, Jonatan ọkpa nnam z'obhon.<verse eid="1SA 20:42" /></para>
  <chapter eid="1SA 20" />
  <chapter number="21" style="c" sid="1SA 21" />
  <para style="s">Devid ọrọbhọ okebha Ahimẹlẹk z'Nọb</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 21:1" />Wa Devid ọta z'Nọb od-okebha Ahimẹlẹk kw'ode ọfọhn-nja. Ojora osi Ahimẹlẹk, ọfọn-ọfọnọ od-okebha Devid, ọbọbh-ẹ bẹ́, “Ode yen kw'azeng manchenẹ? Kayen kw'ọnọng nna atọnọ?”<verse eid="1SA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 21:2" />Devid ọpọhn-ẹ bẹ́, “Ọvaarnọng ọtọr-m itọhng, oben-m bẹ́, ‘Tte ọnọng oning odik kpenamkpen ozong ọmaana ọtọhm fọ ọttara ntọhna sọ o.’ Ṉ́nòde ajinọng paam, kaam kk'bẹ mbena bẹ́, makebh-m k'ibyi janẹ. <verse eid="1SA 21:2" /><verse number="3" style="v" sid="1SA 21:3" />Bọng-ọttọhk f'ayen madidanma? Nang-m abrẹd-duk achen, wanẹma, ọttọhk kpenamkpen f'akpo ayena.”<verse eid="1SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 21:4" />Ọfọhn-nja nwo ọpọhna Devid bẹ́, “Brẹd kw'awuriji wọ oning ma, kw'uwura nnang-ọ, óde ajinọng pọ nna panọng ayim amaana. Kaam brẹd nwoka ma kintim.”<verse eid="1SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 21:5" />Devid ọpọhna bẹ́, “K'odik ọkkọkka, ode minna bẹ́, k'ogbe kw'ntim bẹ nyin k'iyaan, panọng mina k'ifor kad-anyọma. Ifor s'ajinọng mba iwur-owur, zaa wura itọhm s'mad-asi kizeng imaana awuriji. Menda iter iwur iyọhng-ọyọhnga!” <verse eid="1SA 21:5" /><verse number="6" style="v" sid="1SA 21:6" />Minna kw'ọfọhn-nja ọnang-ẹ brẹd nwo kw'awuriji, ch'brẹd ọdọk-ọdọk ina ode kw'ọkpanẹ nwo kw'marọbh ny'Ọvaar Ibinọkpaabyi k'ititika, mabir atera ọmaana brẹd kw'ọkọm-ọkọm ny'ewu ndo ch'marọbh nwoza.<verse eid="1SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 21:7" />Ny'ewu ndo, ọtọhmnọng wanẹ kw'Saul oning nya kw'mabọk asok okurọ ọtọhm f'Ọvaar Ibinọkpaabyi f'im'osi. Wa kẹ okpen Doẹg, kw'ofon ẹkọma ch'Edom, ode oso kw'akker-arọkimaan p'Saul.<verse eid="1SA 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 21:8" />Devid ọbọbh Ahimẹlẹk bẹ́, “Ma, kọ ayen ọkọhn, wanẹma ọkkangkkang kw'uwura anang-m yirẹ? Kaam ọkkangkkang kintim, ogbongttọhk kpenamkpen kimbir ntima, okurọ eduka ch'nduk k'ọtọhm f'ọvaarnọng ọtọhm-m.”<verse eid="1SA 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 21:9" />Ọfọhn-nja ọpọhna bẹ́, “Ọkkangkkang kw'oning ma, ode nwo kw'Golayat kw'ofon Philistiya, kw'uwa afhọ z'ilokodo s'Ẹla. Mabhọrọ k'ibara masok ny'nnam nnam <char style="w" lemma="ẹphọd">kw'ẹphọd</char>. Ó̱de im'atọka, atọka, okurọ bẹ́, ọkkangkkang ọdọk-ọdọk ma kode kw'ọkpanẹ nwoma.” Devid oben bẹ́, “Nwoma okerim koyen, tọka nang-m ka.”<verse eid="1SA 21:9" /></para>
  <para style="s">Devid ọrọbhọ ochina z'Gat.</para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 21:10" />Ny'ewu ndo, Devid ọrọbh z'Saul, od-okebha Akish kw'ode ọvaarnọng kw'Gat. <verse eid="1SA 21:10" /><verse number="11" style="v" sid="1SA 21:11" />Okenaka, atọhmnọng p'Akish mabọbh bẹ́, “Devid nwo kw'ode ọvaarnọng kw'izek njo azang ma? Kẹ azang kw'mad-akkọhn k'amọng ọmaana k'otubha kwabẹ bẹ bẹ́,</para>
  <para style="q1" vid="1SA 21:11">‘Saul kk'anọng ọfha k'nnọhna k'nnọhna,</para>
  <para style="q2" vid="1SA 21:11">Devid ọfhọ anọng k'nnọhna s'ina obhika ide’?”<verse eid="1SA 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 21:12" />Wa Devid ọtọka idik nja oke k'ettem, obir oyena ojora mawuriji k'Akish kw'ode ọvaarnọng kw'Gat. <verse eid="1SA 21:12" /><verse number="13" style="v" sid="1SA 21:13" />Ofona nya o, Devid ọtọma osisi mach'ettem ina etorọ ny'abẹ k'ititika. Ny'abẹ k'mbọhk ọdọk o, osi mach'ikk'odinga, ọkkẹr ekpo ny'amma p'ebhumma, otte attabọhng pẹ ọbọhk mabhobh-ẹ z'ẹmma, masaka z'ammaphyabha.<verse eid="1SA 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 21:14" />Akish oben atọhmnọng pẹ bẹ́, “Màkkerẹ, ojinọng nwa kk'eding-edingẹ ọsa e. Osempira matọk-ẹ achen-m o? <verse eid="1SA 21:14" /><verse number="15" style="v" sid="1SA 21:15" />Adingidingẹ bọ awor-m o, kw'matim ojinọng nwa akwu bẹ́, okwu osi dingẹ-dingẹ m'kaam k'ititika? Ọbaan za bẹ́, ojinọng nwa okwu m'kaam k'ọsọhm o?”<verse eid="1SA 21:15" /></para>
  <chapter eid="1SA 21" />
  <chapter number="22" style="c" sid="1SA 22" />
  <para style="s1">Devid ochin z'Adulam ọmaana z'Mizpa</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 22:1" />Devid obina z'Gat ọrọbh ozeng z'ọtakpamma kw'Adulam. K'ogbe kw'ivotte p'ejinọng ọttara ẹsọhmmọr ch'otte kwẹ mabhaang odik nwo, mabina akebh-ẹ za. <verse eid="1SA 22:1" /><verse number="2" style="v" sid="1SA 22:2" />Anọng mbo maphyir p'uwa maning k'adama, ọmaana ayok p'atim ibhorọ, ọmaana ayok p'nttem nna ilebhẹ, makọbh-ẹ abaabha. Kẹ okwu ode oso kwabẹ. Anọng p'uwa aning nya amaan-ẹ mm'apyirẹ ẹnọhna.<verse eid="1SA 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 22:3" />Devid obina nya ozeng z'Mizpa, z'ẹkọma ch'Moab, od-oben ọvaarnọng kw'Moab bẹ́, “Ma, ina achera bẹ́, atte kwaam ọttara akka kwaam maninga ma amaan-ọ maa nzonga ọttọhk f'Ibinọkpaabyi m'osi ọnang-m o?” <verse eid="1SA 22:3" /><verse number="4" style="v" sid="1SA 22:4" />Minna kw'ọtọk otte ọttara ọkka ọgbaara ọvaarnọng kw'Moab, maninga nya amaan-ẹ k'ogbe nwo maphyir kw'Devid oning z'ọtakpamma.<verse eid="1SA 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 22:5" />Nya o, Gad kw'ode ọgbaak-ettem ch'Ibinọkpaabyi oben Devid bẹ́, “M'ọtakpamma kàninga. Zọhng z'izek s'Juda.” Ofona nya o, Devid obina ochina z'ẹtam ch'Hẹrẹt.<verse eid="1SA 22:5" /></para>
  <para style="s">Saul ọfhọ afọhn-nja p'Ibinọkpaabyi z'Nọb</para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 22:6" />Nya o, Saul okwu ọbhaanga bẹ́, nkk'Devid ọttara ajinọng pẹ aza. Ny'ogbe nwo, Saul oning k'echirin ch'tamarisk, z'egbe ch'Gibea, otima ọkọhn k'ọbọhk. Atọhmnọng pẹ maphyir mabe akọbh-ẹ ake k'ettem.<verse eid="1SA 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 22:7" />Saul oben atọhmnọng pẹ bẹ́, “Bọnga ajinọng p'Bẹnjamin, màyonga itọhng! Ma, ojinọngnwa kw'Jẹsẹ ina ọbhaaka bọnga maphyir mgba s'mm'atubh iwonọ, ọmaana s'mm'atubh grep o? Ma, ina osi bọnga maphyir made aso p'agbongnọng nnọhna k'nnọhna? Wanẹma, aso p'agbongnọng arọbh achen obhir-obhirẹ yirẹ? <verse eid="1SA 22:7" /><verse number="8" style="v" sid="1SA 22:8" />Ma, kẹ wọ osi bọnga maphyir machi-m ikwu, ọnọng kaam kotekẹ bẹ́, nnwa kwaam, ọmaana nnwa kw'Jẹsẹ nkk'acheka anang ayok? Ọnọng mawanẹ kw'mbar-ẹ odik kode, ọnọng kode kw'obir otek-m bẹ́, nnwa kwaam kk'ọtọhmnọng kwaam Devid ọchọhma bẹ́, obe k'eden osi-m itama k'ose kw'osi ma menda.”<verse eid="1SA 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 22:9" />Nya o, Doẹg kw'ofon Edom, kw'uwa obir obe nya ọmaana atọhmnọng p'Saul, oben bẹ́, “Nze ojinọngnwa kw'Jẹsẹ ch'okwu z'Nọb, okwu okebha Ahimẹlẹk kw'ode nnwa kw'Ahitub. <verse eid="1SA 22:9" /><verse number="10" style="v" sid="1SA 22:10" />Ahimẹlẹk ọbọbh Ọvaar Ibinọkpaabyi odik k'eso ch'Devid, obir ọnang-ẹ ẹchakpo ọttara ọkkangkkang kw'Golayat kw'ofon Philistiya.”<verse eid="1SA 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 22:11" />Nya o, ọvaarnọng ọtọhm bẹ́, mayerẹ Ahimẹlẹk kw'ode ọfọhn-nja, kw'obir ode nnwa kw'Ahitub, ttara ajinọngva p'ẹsọhmmọr ch'otte maphyir, p'ade afọhn-nja p'afon ẹkọma ch'Nọb. Bẹ maphyir machera eyerẹ ch'ọvaarnọng. <verse eid="1SA 22:11" /><verse number="12" style="v" sid="1SA 22:12" />Saul oben Ahimẹlẹk bẹ́, “Yonga itọhng, nnwa kw'Ahitub.”</para>
  <para style="p" vid="1SA 22:12">Ahimẹlẹk ọpọhn-ẹ bẹ́, “Iya, ttatta kwaam.”<verse eid="1SA 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 22:13" />Saul oben-ẹ bẹ́, “Kayen kw'ikọ ọttara nnwa kw'Jẹsẹ machi-m ikwu, maa anang-ẹ ọchattọhk ọttara ọkkangkkang? Kayen kw'abir abọbh Ibinọkpaabyi odik k'ikẹ k'eso, awọhkọ ọyaang-m k'ichen, obir otubha k'eden otik-m bẹ́, osi-m itama k'ose kw'ikk'ọsa ma menda?”<verse eid="1SA 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 22:14" />Ahimẹlẹk ọpọhna ọvaarnọng bẹ́, “Ma atọhmnọng pọ maphyir, anyi wọ ọsak eso mach'Devid kw'ode ọnyẹ kw'ọvaarnọng, kw'ọbaabh ẹkaan ch'ekker-ọ? Anyi wọ obir oyena ikpukpobha mawuriji m'ẹsọhmmọr chọ o? <verse eid="1SA 22:14" /><verse number="15" style="v" sid="1SA 22:15" />Ma, ochedengbe kw'mbọbhọ Ibinọkpaabyi odik k'ikẹ k'eso wọ ma o? Minna kode! Tte ọvaarnọng oning kaam ọtọhmnọng kwẹ odik ọnan, oning echimma ch'atte kwaam odik obir ọnana. Kirẹ, kaam ọtọhmnọng kwọ odik maphyir-phyir kinzong kw'ọmaan idik nja s'id-iyin ma.”<verse eid="1SA 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 22:16" />Ọvaar Saul oben bẹ́, “Kọ Ahimẹlẹk ọttara echimma ch'atte kibungọ, mm'ap'pe.”<verse eid="1SA 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 22:17" />Nya o, ọvaarnọng oke agbongnọng p'akker-ẹ ẹfa, oben bẹ bẹ́, “Màfhọ afọhn-nja mba p'Ọvaar Ibinọkpaabyi, okurọ bẹ́, bẹ mabira ator Devid k'odik. Bẹ nkk'azonga bẹ́, Devid ọd-ọrọbh-ọrọbh nya, m'kaam katekẹ.”</para>
  <para style="p" vid="1SA 22:17">Okenaka, ny'akaannọng mbo p'ọvaarnọng maphyir, ọnọng kode kw'uwa odo ifor bẹ́, otwu ọfọhn-nja kpenamkpen kw'Ọvaar Ibinọkpaabyi ọbọhk.<verse eid="1SA 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 22:18" />Nya o, ọvaarnọng, oke Doẹg ẹfa, oben-ẹ bẹ́, “Kọ bhakẹ nnam afhọ afọhn-nja mba.” Minna kw'Doẹg kw'ofon ẹkọma ch'Edom ọbhakẹ nnam ọfhọ bẹ. Ny'ewu ndo, ọfhọ anọng nso arọbh ana okwuma achen p'afọr ẹphọd kw'matim ọbara-wurọ asi. <verse eid="1SA 22:18" /><verse number="19" style="v" sid="1SA 22:19" />Obir ọfhọ anọng maphyir p'abin ẹkọma ch'Nọb, kw'ode obhon kw'afọhn-nja: ajinọng ọmaana panọng, ọmaana ivava, ọmaana abhava, ọmaana abhaam, ọmaana nnyanya, ọttara arọkimaan pabẹ.<verse eid="1SA 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 22:20" />Okenaka, Abiyata kw'ode ojinọngnwa kw'Ahimẹlẹk, kw'Ahitub obhonọ, ọrọbh otor Devid. <verse eid="1SA 22:20" /><verse number="21" style="v" sid="1SA 22:21" />Otek Devid bẹ́, Saul kk'afọhn-nja p'Ọvaar Ibinọkpaabyi ọfha. <verse eid="1SA 22:21" /><verse number="22" style="v" sid="1SA 22:22" />Devid oben Abiyata bẹ́, “Ny'ewu ndo ch'nze bẹ́, Doẹg kw'ofon Edom oning nya, nya kw'nzong bẹ́, m'otek Saul otek. K'odik ọkkọkka, kaam wọ nwọhkọ obo kw'echimma ch'atte k'ibungọ. <verse eid="1SA 22:22" /><verse number="23" style="v" sid="1SA 22:23" />Ninga maan-m; oning-ọ ojor. Ọnọng nwo kw'od-oror bẹ́, ọfhọ-ọ, obir ororọ za bẹ́, ọfhọ kaam ọttara. Áning amaan-m, ọttọhk kọ mòsi.”<verse eid="1SA 22:23" /></para>
  <chapter eid="1SA 22" />
  <chapter number="23" style="c" sid="1SA 23" />
  <para style="s">Devid ọkaamẹ obhon kw'Keyila</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 23:1" />Ewu danẹ, matek Devid bẹ́, “Kirẹ e, aPhilistiya aning za arim obhon kw'Keyila ábẹ̀, mabir afu achimọma p'mad-apha.”<verse eid="1SA 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 23:2" />Ofona nya o, Devid ọbọbh Ọvaar Ibinọkpaabyi bẹ́, “Ma, nd-nrima aPhilistiya mba ábẹ̀ yirẹ?” Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Zọhng rima bẹ ábẹ̀, akaam obhon kw'Keyila.”<verse eid="1SA 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 23:3" />Okenaka, ajinọng p'Devid aben-ẹ bẹ́, “M'Juda ojor mina ojora, z'Keyila azang kw'mm'okpo od-orima agbongnọng p'Philistiya ábẹ̀!”<verse eid="1SA 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 23:4" />Devid obir ọbọbh Ọvaar Ibinọkpaabyi. Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Bina, zọhng z'Keyila. Kaam m'ntọka aPhilistiya mbo nkọ-ọ k'mbọhk.”<verse eid="1SA 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 23:5" />Minna kw'Devid ọmaana ajinọng pẹ mazengẹ z'Keyila, mad-arima aPhilistiya ábẹ̀, mabira ana bẹ etirakpo pyabẹ atima akwuna. Mamuma aPhilistiya mbo ekpo mawuriji, mabira afhọ bẹ k'ọsaabh. Minna kw'Devid ọkkaan obhon kw'Keyila.<verse eid="1SA 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 23:6" />M'ogbe nwa, wa Abiyata kw'ode ojinọngnwa kw'Ahimẹlẹk <char style="w" lemma="ẹphọd">kk'ẹphọd</char> otima ny'ọbọhk ọrọbh okebha Devid z'Keyila.<verse eid="1SA 23:6" /></para>
  <para style="s1">Saul ororọ Devid bẹ́, ọfhẹ-ẹ</para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 23:7" />Wa matek Saul bẹ́, Devid kk'ochina z'Keyila. Saul oben bẹ́, “Ibinọkpaabyi kk'ẹ ọtọka oke-m k'mbọhk okurọ bẹ́, Devid kk'ifor sẹ ozeng mmo oke mgbakkọhbhọ, okurọ ch'odimẹ k'obhon kw'oyen mmumma ọmaana abaaka.”<verse eid="1SA 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 23:8" />Nya o, Saul oyerẹ agbongnọng pẹ maphyir bẹ́, mayin egbong z'Keyila, makọbha Devid ọttara ajinọng pẹ ake k'ettem.<verse eid="1SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 23:9" />Ch'Devid ozong bẹ́, Saul ọkam-ẹ ọkam, oben Abiyata kw'ode ọfọhn-nja bẹ́, “Tima ẹphọd kwu.”<verse eid="1SA 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 23:10" />Devid obir oze njọm oben bẹ́, “O Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl, kaam ọtọhmnọng kwọ kk'mmaanga majijik bẹ́, Saul ọkamẹ bẹ́, okwu k'Keyila okwu okibhẹ obhon kibung-kibungọ okurọ kaam. <verse eid="1SA 23:10" /><verse number="11" style="v" sid="1SA 23:11" />Ma, anọng p'Keyila m'atte-m ọbọhk anang-ẹ o? Ma, Saul m'okwu k'ose kw'mmaang o? O Ọvaar Ibinọkpaabyi, Ibinọkpaabyi kw'Israẹl, ototo, tek kaam kw'nde ọtọhmnọng kwọ.”</para>
  <para style="p" vid="1SA 23:11">Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Kẹ m'okw-okwu e.”<verse eid="1SA 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 23:12" />Devid obir ọbọbh bẹ́, “Ma, anọng p'Keyila mm'atte kaam ọttara ajinọng paam ọbọhk anang Saul o?”</para>
  <para style="p" vid="1SA 23:12">Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Mm'atte bọnga ọbọhk otte e.”<verse eid="1SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 23:13" />Nya o, Devid otima ajinọng pẹ p'mm'apyirẹ ẹnọhna okwuma arọbh ijobh, obina ny'Keyila, mazenga achina k'ibyi k'ibyi. K'ogbe kw'matek Saul bẹ́, Devid kk'ọrọbha z'Keyila, Saul ọkpọka za otita.<verse eid="1SA 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 23:14" />Minna kw'Devid oning ny'atakpamma mbo p'ibyi s'anọng nna arukọ, z'ẹkọma ch'Ziph ch'eyen agbe. K'ewu k'ewu, Saul oror-ẹ, okenaka, Ibinọkpaabyi Devid ọbọhk kotte ọnang-ẹ.<verse eid="1SA 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 23:15" />Ch'iwa Devid otim oning z'Horẹsh z'ibyi s'anọng nna arukọ z'Ziph, oze bẹ́, Saul kk'ọkwa bẹ́, ọfhẹ-ẹ. <verse eid="1SA 23:15" /><verse number="16" style="v" sid="1SA 23:16" />Jonatan kw'ode ojinọngnwa kw'Saul, ofona okebha Devid z'Horẹsh, ọd-ọkẹ-ẹ ettem bẹ́, ophe nnam k'Ibinọkpaabyi. <verse eid="1SA 23:16" /><verse number="17" style="v" sid="1SA 23:17" />Oben-ẹ bẹ́, “Oning-ọ ojor. Saul kw'ode atte kwaam kọ ọbọhk mòtwu. Kwuna kọ m'ade ọvaarnọng kw'Israẹl, kaam nde odukwa kwọ. Ozeng k'atte kwaam Saul, ozong odik nwa ma.” <verse eid="1SA 23:17" /><verse number="18" style="v" sid="1SA 23:18" />Bẹ anọng afa machekẹ anang ayok ny'ititika s'Ọvaar Ibinọkpaabyi. Jonatan ọbhana, Devid oninga ny'Horẹsh.<verse eid="1SA 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 23:19" />Wa anọng p'Ziph mabina akebha Saul z'Gibea, maben-ẹ bẹ́, “Devid otubh m'atakpamma pamina m'Horẹsh, m'agbe p'Hakila kw'ode ẹwọn-ẹwọna kw'Jeshimon. <verse eid="1SA 23:19" /><verse number="20" style="v" sid="1SA 23:20" />Ọvaarnọng, kwu k'ogbe kpenamkpen kw'ọdaak-ọ. Mina mm'ozeng mmo ọbọk-ẹ ọnang-ọ.”<verse eid="1SA 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 23:21" />Saul ọpọhna bẹ bẹ́, “Tte Ọvaar Ibinọkpaabyi odo bọnga ch'machibhẹ ejibha amaan-m. <verse eid="1SA 23:21" /><verse number="22" style="v" sid="1SA 23:22" />Màzọhng baana mawuriji, mabira aror k'ose kw'mm'azonga ibyi s'ọd-ọkọhng otita, ọmaana ọnọng kw'ọd-ọzẹ-ẹ nya. Matek-m bẹ́, kẹ odongọ mawuriji. <verse eid="1SA 23:22" /><verse number="23" style="v" sid="1SA 23:23" />Màror k'ose kw'mm'azonga obyi mvo f'od-otubha, pira makpa nnam akwu atek-m ẹkkaabha <char style="it">bẹ́ gbẹẹng</char>. Nya wọ kw'kaam mm'ọtọn. Ó̱de oning ny'ẹbhaakẹ ndo, kaam m'nnor-ẹ m'nkọma s'Juda maphyir, mbọk-ẹ.”<verse eid="1SA 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 23:24" />Minna kw'machi Saul eden machina z'Ziph. Ny'ogbe nwo, wa Devid ọmaana ajinọng pẹ maning z'ibyi s'anọng nna arukọ, z'Maọn, z'ẹbhaakẹ ch'Araba, z'ẹwọn-ẹwọna kw'Jeshimon. <verse eid="1SA 23:24" /><verse number="25" style="v" sid="1SA 23:25" />Saul ọmaana ajinọng pẹ mabina mad-aror-ẹ. K'ose kw'matek Devid odik nwo nya, obina od-oninga k'ẹtakpa z'Maọn. Saul ọbhaang nya o, od-oror-ẹ z'Maọn.<verse eid="1SA 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 23:26" />Wa Saul od-ozenga k'ẹbhaakẹ danẹ ch'egbe ndo, Devid ọttara ajinọng pẹ mazenga z'ẹbhaakẹ ndoza. Devid ọmaana ajinọng pẹ maduka k'ose kw'Saul ina bẹ mọ̀bọka. K'ose kw'Saul ọttara agbongnọng pẹ manyọm Devid ọmaana ajinọng pẹ bẹ́, mabọka bẹ, <verse eid="1SA 23:26" /><verse number="27" style="v" sid="1SA 23:27" />itọhmọ janẹ ikwu tek Saul bẹ́, “Sẹr-ọsẹr kwu, kirẹ aPhilistiya aning ka arim Israẹl ábẹ̀ e.”<verse eid="1SA 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 23:28" />Minna kw'Saul ottik Devid okwu-kwubh, ofona od-orima aPhilistiya ábẹ̀. Nya wọ osi mayerẹ ibyi nja bẹ́, Ẹtakpa ch'Ẹrọbh-anaanga. <verse eid="1SA 23:28" /><verse number="29" style="v" sid="1SA 23:29" />Devid o, obina nya od-otubha z'atakpamma p'Ẹn-Gẹdi.<verse eid="1SA 23:29" /></para>
  <chapter eid="1SA 23" />
  <chapter number="24" style="c" sid="1SA 24" />
  <para style="s1">Devid obhumọ Saul ofhufhọ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 24:1" />K'ogbe kw'Saul okwun za ch'okwubhọ aPhilistiya, matek-ẹ bẹ́, “Devid oning z'ibyi s'anọng nna arukọ, z'Ẹn-Gẹdi.” <verse eid="1SA 24:1" /><verse number="2" style="v" sid="1SA 24:2" />Ofona nya, Saul oteka ajinọng ny'Israẹl maphyir p'ade anọng nnọhna nchenọmfa okwuma arọbh ijobh, otima bẹ od-oror Devid ttara ajinọng pẹ za ch'ọnyọm Ntakpa s'Avu p'Ẹgba. <verse eid="1SA 24:2" /><verse number="3" style="v" sid="1SA 24:3" />Okwu opyirẹ k'ivu-ninga s'inyọm eden, nya ch'ọtakpamma wanẹ oning, Saul odim nya bẹ́, okwoka ọwọhng. Ny'ogbe nwo, Devid ọttara ajinọng pẹ maning z'ẹtaanga, z'nnam-nnam kw'ọtakpamma nwo.<verse eid="1SA 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 24:4" />Ajinọng p'Devid aben bẹ́, “Ma wọ ode ewu ndo ch'iwa Ọvaar Ibinọkpaabyi ọgbaak odik ọmaana, ch'oben-ọ bẹ́, ‘Kaam m'ntọka ọwawunanọng kwọ nkọ-ọ ny'mbọhk bẹ́, asẹ-ẹ k'ose kw'ọdaak-ọ.’ ” Nya o, Devid obina ozenga <char style="it">bẹ́ mekem-mekem</char> od-omekẹ ẹmma ch'owurọ-baba kw'Saul.<verse eid="1SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 24:5" />Ettem ekwu ẹyaak Devid odik okurọ ch'omekẹ ẹmma ch'ọnọhma-baba kw'Saul. <verse eid="1SA 24:5" /><verse number="6" style="v" sid="1SA 24:6" />Oben ajinọng pẹ bẹ́, “Ọvaar Ibinọkpaabyi mòchera bẹ́, nsi ọttọhkse mva nnang atte kwaam kw'Ọvaar Ibinọkpaabyi ikk'ana obyenga k'eso. Mòbira ochera bẹ́, nyaangẹ ọbọhk kwaam ntwẹ-ẹ k'itama, okurọ bẹ́, Ọvaar Ibinọkpaabyi kk'ẹ ana obyenga k'eso.”<verse eid="1SA 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 24:7" />Devid ọgbọ ajinọng pẹ ẹmọng okurọ idik nja, obir ọkpa bẹ eden bẹ́, maning Saul ọttọhk asi. Minna kw'Saul obin ny'ọtakpamma nwo ofona.<verse eid="1SA 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 24:8" />Nya o, Devid obina oyin ny'ọtakpamma nwo, oyerẹ Saul bẹ́, “Ttatta ọvaarnọng kwaam!” Saul ọbhakẹ nnam nya o, Devid ọraka eso otwu izek.<verse eid="1SA 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 24:9" />Oben Saul bẹ́, “Kayen kw'ad-ayonga itọhng k'anọng p'ad-aben bẹ́, ‘Devid ọkam-ọ itama o?’ <verse eid="1SA 24:9" /><verse number="10" style="v" sid="1SA 24:10" />Menda, k'achen pọ atima aze ose kw'Ọvaar Ibinọkpaabyi ọtọk-ọ oke-m k'mbọhk z'ọtakpamma. Anọng banẹ machọhm-m bẹ́, mfhọ-ọ, kaam mmum bẹ́, mfhọ-ọ. Mben bẹ́, ‘Kaam ọbọhk mìnyaangẹ k'itama ntwu atte kwaam, okurọ bẹ́, Ọvaar Ibinọkpaabyi kk'ẹ ana obyenga k'eso.’ <verse eid="1SA 24:10" /><verse number="11" style="v" sid="1SA 24:11" />Atte kwaam, ze ka e. Ẹkpa ch'owurọ-baba kwọ dọ ch'ntim m'ọbọhk! Kaam mmekẹ chẹ ny'ẹmma ch'owurọ-baba kwọ, mbira mmum bẹ́, mfhọ-ọ, ọfha azonga, abir aze bẹ́, kaam epinẹ kinsi, eso kimbir ngaangẹ. Kaam kọ kimpinẹ. Okenaka, ad-aror-m bẹ́, afhọ-m. <verse eid="1SA 24:11" /><verse number="12" style="v" sid="1SA 24:12" />Tte Ọvaar Ibinọkpaabyi osi aponga p'ikọ ọttara kaam, obir otuka mpinẹ s'ikk'aam asa. Ṉ́nòde kaam, ọbọhk kwaam kọ mòtwu. <verse eid="1SA 24:12" /><verse number="13" style="v" sid="1SA 24:13" />Ode k'ose kw'magbaakẹ ẹzẹmẹ bẹ́, ‘nkwurọ imaanẹ itama.’ Ṉ́nòde kaam, ọbọhk kwaam kọ mòtwu.<verse eid="1SA 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 24:14" />“Ọvaarnọng kw'Israẹl oyinẹ k'iyaan bẹ́, orima anyi ábẹ̀ o? Anyi wọ kw'ad-akwubh o? Kọ ad-akwubh ọffa-bukọ o? Etitaana nda ch'ad-akwubh o? <verse eid="1SA 24:14" /><verse number="15" style="v" sid="1SA 24:15" />Tte Ọvaar Ibinọkpaabyi osi aponga pamina, obir ọkpaara ọnang mina. Tte kẹ oze idik saam, obir ọkkaan-m ọrọbh-m z'ikọ k'mbọhk.”<verse eid="1SA 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 24:16" />K'ose kw'Devid ocher odik kwẹ nya, Saul oben bẹ́, “Nnwa kwaam Devid, ẹmọng chọ dọ nya o?” Minna kw'Saul ọsọbhọ ẹmọng nya, obhom. <verse eid="1SA 24:16" /><verse number="17" style="v" sid="1SA 24:17" />Oben Devid bẹ́, “Kọ wọ atorọ ọtam ayọhng-m; kọ asi ejibha anang-m, okenaka, kaam nsi kọ itama. <verse eid="1SA 24:17" /><verse number="18" style="v" sid="1SA 24:18" />Menda kk'ejibha ch'ikk'asa anang-m ayaaka. Kaam kafhọ k'ogbe kw'Ọvaar Ibinọkpaabyi ọtọk-m ọkọ-ọ k'mbọhk, okenaka, abhum bẹ́, afhọ-m. <verse eid="1SA 24:18" /><verse number="19" style="v" sid="1SA 24:19" />K'ogbe kw'ọnọng ọbọk ọwawunanọng kwẹ, ma, ọd-ọttẹ-ẹ ọbọhk ofona, ọkpakpa ogwum-ẹ o? Tte Ọvaar Ibinọkpaabyi ọtaam-ọ mawuriji k'ejibha ch'asi anang-m menda. <verse eid="1SA 24:19" /><verse number="20" style="v" sid="1SA 24:20" />K'odik ọkkọkka, kaam nzong bẹ́, kọ m'ade ọvaarnọng ode, mbira nzonga bẹ́, ẹvaar ch'ẹkọma ch'Israẹl m'ettima k'ikọ k'ogbe. <verse eid="1SA 24:20" /><verse number="21" style="v" sid="1SA 24:21" />Chekẹ k'eche ch'Ọvaar Ibinọkpaabyi nang-m bẹ́, kwuna ẹnọmma chaam màdimẹ, eche chaam z'efona ch'atte kwaam màbira affurọ.”<verse eid="1SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 24:22" />Minna kw'Devid ochekẹ ọnang Saul. Saul o, ọbhana. Okenaka, Devid ọttara ajinọng pẹ, makpa nnam z'abẹ k'itubhabyi.<verse eid="1SA 24:22" /></para>
  <chapter eid="1SA 24" />
  <chapter number="25" style="c" sid="1SA 25" />
  <para style="s1">Obo kw'Samwẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 25:1" />Wa Samwẹl okwu ope. Anọng p'Israẹl maphyir matobha ayok, mabhom-ẹ. Mad-anọhng-ẹ z'ikẹ k'obhon z'Rama.</para>
  <para style="s" vid="1SA 25:1">Devid ọmaana Abigẹl</para>
  <para style="p" vid="1SA 25:1">Nya o, Devid obina ozeng z'ibyi s'anọng nna arukọ z'Paran. <verse eid="1SA 25:1" /><verse number="2" style="v" sid="1SA 25:2" />Wa ojinọng wanẹ oning z'Maọn kw'oyen oyena ny'Kaamẹl. Wa ojibh-ẹ mawuriji, oyena arọkimaan nnọhna nchenọmfa okwuma arọbh ijobh, ọttara avu nnọhna mfa okwuma arọbh ijobh p'od-ogwu iphyabha z'Kaamẹl. <verse eid="1SA 25:2" /><verse number="3" style="v" sid="1SA 25:3" />Wa ojinọng nwa okpen Nabal, kwanọng kwẹ okpena Abigẹl. Abigẹl oyen ezonga, obir ojibh kwanọng. Okenaka, odim kwẹ ode ọkkamgbaranọng, obir oyena ẹmmaanatama; ofona k'efona ch'Kẹlẹb.<verse eid="1SA 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 25:4" />Ch'Devid otim oning z'ibyi s'anọng nna arukọ, ọbhaanga bẹ́, Nabal oning z'ogwo arọkimaan pẹ iphyabha.<verse eid="1SA 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 25:5" />Ofona nya, Devid ọtọhm ajinọngva ijobh, oben bẹ bẹ́, “Màkebha Nabal z'Kaamẹl, mazim-ẹ k'eche chaam. <verse eid="1SA 25:5" /><verse number="6" style="v" sid="1SA 25:6" />Màben-ẹ bẹ́, ‘Tte odiriji oninga ọmaan-ọ, ọmaana ẹsọhmmọr chọ, ọttara ọttọhk kpenamkpen fọ maphyir! <verse eid="1SA 25:6" /><verse number="7" style="v" sid="1SA 25:7" />Mmaang bẹ́, ogbe kw'mad-agwo arọkimaan iphyabha kk'obenga. Ch'iwa akker-arọkimaan pọ aning amaana mina, wa m'bẹ itama kotim. Ny'ogbe nwo maphyir kw'uwa maning z'Kaamẹl, ọttọhk mavanẹ fabẹ kobir odimẹ. <verse eid="1SA 25:7" /><verse number="8" style="v" sid="1SA 25:8" />Bọbh atọhmnọng pọ, mm'atek-ọ bẹ́, ode odik ọkkọkka. Ofona nya, si ọphyaam nang ajinọngva paam, ch'ode bẹ́, mokwu k'odidaamagbe. Ototokinẹ, nang atọhmnọng pọ ọttara kaam nnwa kwọ Devid, okpenamkpen f'akpo ayena.’ ”<verse eid="1SA 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 25:9" />Ch'ajinọngva p'Devid mapyirẹ za o, matek Nabal ẹkkaabha nda k'eche ch'Devid. Maninga nya atik.<verse eid="1SA 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 25:10" />Nabal ọpọhna ajinọngva p'Devid bẹ́, “Anyi wọ ode Devid nwa? Anyi wọ ode nnwa nwa kw'Jẹsẹ? Maamba atọhmnọng saabhada aning za abhaangẹ z'abotte k'mbọhk. <verse eid="1SA 25:10" /><verse number="11" style="v" sid="1SA 25:11" />Kayen kw'im'ntọka ọchattọhk ọmaana asi paam ttara eten ch'ikk'mfha bẹ́, nnang anọng p'ad-agwu avu paam iphyabha, nnang ajinọng p'nna ibyi nzong s'mafon?”<verse eid="1SA 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 25:12" />Ajinọngva p'Devid makpa nnam abhana. Mapyirẹ za o, matek Devid odik kpenamkpen. <verse eid="1SA 25:12" /><verse number="13" style="v" sid="1SA 25:13" />Devid oben ajinọngva pẹ bẹ́, “Màdabh akkangkkang pabọnga!” Minna kw'madabhẹ akkangkkang pabẹ, Devid obir ọdabh kwẹ. Ajinọng p'mm'apyirẹ ẹnọhna mayakẹ Devid nnam, ajinọng p'ade arọbh ijobh, maninga nya akkerẹ ekpo.<verse eid="1SA 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 25:14" />Ny'ogbe nwo, ọtọhmnọng wanẹ otek Abigẹl kw'ode kwanọng kw'Nabal bẹ́, “Devid ọtọhmọ azeng-eden p'abin z'ibyi s'anọng nna arukọ bẹ́, makwu azima atte kwamina. Ch'mapyirẹ ka, atte kwamina ọlẹkẹ bẹ. <verse eid="1SA 25:14" /><verse number="15" style="v" sid="1SA 25:15" />K'odik ọkkọkka, wa ajinọng mba asi mina ejibha mawuriji, m'irem kpenamkpen k'abẹ k'mbọhk koze. Ny'ogbe nwo maphyir kw'mobir oninga ọmaana bẹ z'iwonọ, ọttọhk mavanẹ famina kodimẹ. <verse eid="1SA 25:15" /><verse number="16" style="v" sid="1SA 25:16" />Ny'ogbe nwo maphyir kw'uwa mod-okkerẹ arọkimaan pamina ọnyọma bẹ, wa bẹ makkerẹ mina k'erungọ ọmaana k'ẹya. <verse eid="1SA 25:16" /><verse number="17" style="v" sid="1SA 25:17" />Ofona nya, chibhẹ ọttọhk f'im'asi, okurọ bẹ́, itama nitik atte kwamina otik, ọttara ẹsọhmmọr chẹ maphyir. Ka, kẹ ode ọnọng kw'opyibhẹ ẹmmaana kw'ọnọng ina kẹ odik od-okpo ọgbaak ọnang.”<verse eid="1SA 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 25:18" />Nya o, Abigẹl ogbe kokibhẹ, ọtọka abrẹd-duk arọbh ijobh, ọmaana otuk-zọhka ọfa, ọmaana arọkimaan achen p'nkk'abhaabha, ọmaana agwu-gbangbang achen p'nkk'akkanga, ọmaana aduk arọbh achen p'grep, ọmaana ogbogbokwa arọbh ijobh p'matim fig asi. Otinẹ byẹ maphyir ọnana k'nnyanya. <verse eid="1SA 25:18" /><verse number="19" style="v" sid="1SA 25:19" />Pira nobenẹ atọhmnọng pẹ bẹ́, “Màchi-m eden, kaam m'nyakẹ bọnga nnam.” Okenaka, odim kwẹ Nabal kotekẹ.<verse eid="1SA 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 25:20" />K'ose kw'Abigẹl ọyaarẹ ẹnyanya chẹ ọwọna egbe, oze Devid ttara ajinọng pẹ ch'mad-asaka akwu z'ikẹ k'ifor, kẹ od-okebha bẹ. <verse eid="1SA 25:20" /><verse number="21" style="v" sid="1SA 25:21" />Ny'ogbe nwo, Devid kk'obena z'ettem bẹ́, “Ekkerẹ ch'nkkerẹ ekpo py'ojinọng nwa z'ẹgba maphyir ọfha ọttọhk fẹ oning odimẹ, ede k'ajaaka. Kẹ otera otima epyibha otuk-m! <verse eid="1SA 25:21" /><verse number="22" style="v" sid="1SA 25:22" />Tte Ibinọkpaabyi ọnang awawunanọng p'Devid irem ọttar-ọttara, óde ophyinẹ k'ekpebha ntte ojinọngnwa kwẹ kpenamkpen oruk akpen.”<verse eid="1SA 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 25:23" />K'ogbe kw'Abigẹl oze Devid, ọsẹr-ọsẹr ọsaka z'ẹnyanya chẹ, ọraka eso otwu ititika ny'izek ny'Devid k'ititika. <verse eid="1SA 25:23" /><verse number="24" style="v" sid="1SA 25:24" />Ọttẹ-ẹ ny'ntọkọ, oben bẹ́, “Ttatta kwaam, tte epyima ede chaam manchenẹ. Ototokinẹ, tte kaam ọtọhmnọng kwọ mgbaak-ọ odik. Bhaanga idik s'ọtọhmnọng kwọ m'ọgbaak-ọ. <verse eid="1SA 25:24" /><verse number="25" style="v" sid="1SA 25:25" />Tte ttatta kwaam oning ọnọngtama nwo kw'mayerẹ Nabal ọsaan. Kẹ ode k'ose kw'eche chẹ ede. Eche chẹ eyinẹ bẹ́, etwurọ. Etwurọ ndo ening ẹmaan-ẹ. Ṉ́nòde kaam ọtọhmnọng kwọ, ajinọngva p'ttatta kwaam ọtọhmọ kìnze. <verse eid="1SA 25:25" /><verse number="26" style="v" sid="1SA 25:26" />Ofona nya, k'ose kw'Ọvaar Ibinọkpaabyi oruk akpen, kọ abir aruk, ch'Ọvaar Ibinọkpaabyi kk'ọsa bẹ́, ttatta kwaam oning izẹ okibhẹ, obir osi bẹ́, aning azeng mmo atuka. Tte awawunanọng pọ, ọmaana anọng p'makamẹ atte kwaam itama, maze irem mach'Nabal im'oze. <verse eid="1SA 25:26" /><verse number="27" style="v" sid="1SA 25:27" />Nya o, tte ttatta kwaam ọtọka ẹnanga nda ch'kaam ọtọhmnọng kwẹ nchen-ẹ, ọnang ajinọng mbo p'ator-ẹ.<verse eid="1SA 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 25:28" />“Ototo, bina nang epinẹ ch'kaam ọtọhmnọng kwọ, kirẹ Ọvaar Ibinọkpaabyi m'osi avaarnọng afona ny'ntaak s'ikọ atte kwaam, okurọ bẹ́, kọ ad-asi erima ch'Ọvaar Ibinọkpaabyi. K'ose kw'arukọ akpen, tte ọnọng oning itama ọbhaang ọmaan-ọ. <verse eid="1SA 25:28" /><verse number="29" style="v" sid="1SA 25:29" />Ó̱de ọnọng kpenamkpen od-okwubh-ọ bẹ́, ọfhọ-ọ, Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ, m'obubh-ọ ọgbagba, osok-ọ akpen. Ṉ́nòde akpen p'awawunanọng pọ, kẹ mọbharẹ bẹ mach'ẹta ch'ọbanttẹttẹ. <verse eid="1SA 25:29" /><verse number="30" style="v" sid="1SA 25:30" />K'ogbe kw'Ọvaar Ibinọkpaabyi kk'ejibha kpenamkpen ch'ochekẹ ọnang atte kwaam ọsa, obir ọsẹ-ẹ oso kw'Israẹl, <verse eid="1SA 25:30" /><verse number="31" style="v" sid="1SA 25:31" />ettem ọdọk atte kwaam odik mẹ̀yak bẹ́, okibhẹ izẹ, ọmaana bẹ́, ozeng mmo otuka odik. K'ogbe kw'Ọvaar Ibinọkpaabyi kk'atte kwaam ọda mawuriji, jima kaam ọtọhmnọng kwọ.”<verse eid="1SA 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 25:32" />Devid ọpọhna Abigẹl bẹ́, “Ẹtọhnga ede ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl, kw'ọtọhm-ọ bẹ́, akebh-m menda. <verse eid="1SA 25:32" /><verse number="33" style="v" sid="1SA 25:33" />Tte Ọvaar Ibinọkpaabyi ọdọ-ọ k'ezonga chọ, ch'akpa-m eden bẹ́, nning izẹ nkibhẹ menda, nning mbọhk saam oyenẹ mbira ntima ntuka odik. <verse eid="1SA 25:33" /><verse number="34" style="v" sid="1SA 25:34" />K'odik ọkkọkka, k'ose kw'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl orukọ akpen, kw'ọkpa-m eden bẹ́, nning-ọ itama nsi, wura ina asẹrẹ akwu akebh-m, ophyinẹ k'ekpebha, ojinọng kw'Nabal mawanẹ kw'uwura obir orukọ akpen kode.”<verse eid="1SA 25:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1SA 25:35" />Nya o, Devid ọtọka ekpo mbyo z'mbọhk s'Abigẹl, oben-ẹ bẹ́, “Zọhng bhana k'ọdaam. Kaam kk'ọ mmaanga. Kk'mbira nchera mmaan-ọ.”<verse eid="1SA 25:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1SA 25:36" />Abigẹl obina ọbhana, od-okebha Nabal z'ọsọhm ch'osok eninga mach'ọvaarnọng. Okebh-ẹ ch'ikk'atuk ọgwa maa obuma, iyagbin nining-ẹ k'mbọhk. Minna kw'Abigẹl omyi maa ewu esobha, kẹ odik kọgbaakẹ.<verse eid="1SA 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1SA 25:37" />Ny'ekpebha, ch'atuk kk'Nabal attaana, kwanọng kwẹ otek-ẹ idik nja maphyir. Nabal ọphyakẹ maphyir k'ifor, oninga nya mach'ẹta. <verse eid="1SA 25:37" /><verse number="38" style="v" sid="1SA 25:38" />Ọttọhk mach'iwu ijobh, ikwu ikpan, Ọvaar Ibinọkpaabyi obin Nabal, ope.<verse eid="1SA 25:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1SA 25:39" />Ch'Devid ọbhaang bẹ́, Nabal kk'ọpa, oben bẹ́, “Ẹtọhnga ede ch'Ọvaar Ibinọkpaabyi kw'otuk ililẹkẹ s'Nabal ọnang-m. Kẹ kk'kaam ọtọhmnọng kwẹ eden ọkpa bẹ́, nning itama nsi. Obir otte Nabal ọbọhk ozeng mmo ọtọhka mpinẹ sẹ.”</para>
  <para style="p" vid="1SA 25:39">Nya o, Devid ọtọhm ẹkkaabha ọnang Abigẹl bẹ́, okwu ode kwanọng kwẹ. <verse eid="1SA 25:39" /><verse number="40" style="v" sid="1SA 25:40" />Atọhmọ p'Devid mazeng z'Kaamẹl, mad-aben Abigẹl bẹ́, “Devid wọ ọtọhmọ mina bẹ́, mokwu ọtọk-ọ ad-ade kwanọng kwẹ.”<verse eid="1SA 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 25:41" />Abigẹl ọraka eso otwu ititika z'izek, oben bẹ́, “Kirẹ e, kaam ọtọhmnọng kwọ kk'ifor nda bẹ́, mgbobhọ mmokpatọkọ s'atọhmnọng p'ttatta kwaam e.” <verse eid="1SA 25:41" /><verse number="42" style="v" sid="1SA 25:42" />Abigẹl obina, oduk-oduka ovura k'ẹnyanya. Atọhmnọng pẹ achen k'ẹpanọng mator-ẹ nya. Mator atọhmọ p'Devid mafona, ọd-ọba Devid.<verse eid="1SA 25:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1SA 25:43" />Wa Devid kk'Ahinoam kw'ofon Jẹzrẹl okkikken ọtọka k'ọbada. Bẹ anọng afa makwu ade panọng pẹ. <verse eid="1SA 25:43" /><verse number="44" style="v" sid="1SA 25:44" />Ṉ́nòde, Mikal, ominanwa kw'Saul, kw'uwa ode kwanọng kw'Devid, Saul kk'ẹ ọtọka ọnang Palti k'ọbada. Palti kẹ wa ode nnwa kw'Laish kw'ofon Galim.<verse eid="1SA 25:44" /></para>
  <chapter eid="1SA 25" />
  <chapter number="26" style="c" sid="1SA 26" />
  <para style="s1">Devid obir obhum Saul ofhufhọ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 26:1" />Anọng p'Ziph makebha Saul z'Gibea, maben-ẹ bẹ́, “Devid otubh kina egbe ch'Hakila ch'ekkerẹ Jeshimon.”<verse eid="1SA 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 26:2" />Ofona nya o, Saul otima ajinọng pẹ nnọhna nchenọmfa okwuma arọbh ijobh p'otek ny'Israẹl, machina z'ibyi s'anọng nna arukọ s'Ziph bẹ́, mad-aror Devid za. <verse eid="1SA 26:2" /><verse number="3" style="v" sid="1SA 26:3" />Saul osi ibhinga-byi sẹ z'egbe ch'Hakila ch'ening okikaan kw'eden ch'echin z'Jeshimon. Okenaka, wa Devid oninga ny'ibyi s'anọng nna arukọ. Ch'okwu oze bẹ́, Saul kk'ẹ orora opyirẹ nya, <verse eid="1SA 26:3" /><verse number="4" style="v" sid="1SA 26:4" />ọtọhm anọng bẹ́, mad-ado abaana. Nya kw'makwu azonga bẹ́, Saul kk'opyira nya majijik.<verse eid="1SA 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 26:5" />Minna kw'Devid obin ozeng z'ibyi njo s'Saul obhingẹ. Oze ibyi s'Saul oyim ọmaana Abnẹr kw'ode ojinọngnwa kw'Nẹr, obir ode oso kw'agbongnọng p'Saul. Wa Saul oyim z'ẹtaanga kw'ibhinga-byi njo, agbongnọng pẹ mayima akọbh-ẹ ọkọbha.<verse eid="1SA 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 26:6" />Devid ọbọbh Ahimẹlẹk kw'ofon Het, ọmaana Abishayi kw'ode nnwa kw'Zeruya, kw'ode ọgbaanọkka kw'Joab bẹ́, “Anyi wọ mm'ọtọn ọta z'ibhinga-byi s'Saul?”</para>
  <para style="p" vid="1SA 26:6">Abishayi oben bẹ́, “Kaam wọ mm'ọtọn ọta.”<verse eid="1SA 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 26:7" />Ofona nya o, Devid ọmaana Abishayi mabina k'erungọ mazeng za ch'agbongnọng p'Saul mabhingẹ, maze Saul ch'oyim z'ẹtaanga ọttaabha ọda, ofu ọkọhn fẹ ny'izek ọnyọma eso chẹ. Abnẹr ọmaana agbongnọng mbo mayima akọbh-ẹ ọkọbha.<verse eid="1SA 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 26:8" />Abishayi oben Devid bẹ́, “Menda Ibinọkpaabyi kk'ọwawunanọng kwọ ọtọka ọkọ-ọ k'mbọhk. Tte ntima ọkọhn faam nkwum-ẹ ogbe mawanẹ mmaana z'izek. Kẹ igbedim ifa mìnkwum.”<verse eid="1SA 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 26:9" />Okenaka, Devid oben Abishayi bẹ́, “Kẹ kàfhọ! Anyi wọ im'osi itama ọnang ọnọng kw'Ọvaar Ibinọkpaabyi ikk'ana obyenga k'eso pira oning k'epinẹ otto?” <verse eid="1SA 26:9" /><verse number="10" style="v" sid="1SA 26:10" />Devid obira oben bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, Ọvaar Ibinọkpaabyi m'ozeng mmo ọfhẹ-ẹ, ńnòsi m'ope obo kw'ikẹ k'ifor, wanẹma m'oyin egbong ope za. <verse eid="1SA 26:10" /><verse number="11" style="v" sid="1SA 26:11" />Tte Ọvaar Ibinọkpaabyi oning ocher bẹ́, ọbọhk kwaam otwu ọnọng kw'ikk'ẹ ana obyenga k'eso. Tọka ọkọhn ọttara esigbomma ch'ening etum-ẹ ny'eso, atima akwu mofona.”<verse eid="1SA 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 26:12" />Minna kw'Devid ọtọk ọkọhn mvo ọttara esigbomma ch'ening ẹnyọma Saul ny'eso, matima afona. Ọnọng kw'oze bẹ kode, onọng kw'obira ozonga odik kw'od-oyin nya kode. Ọnọng kode kw'obir ọphyabha ọda. Bẹ maphyir machina ororo attaabha ọda, okurọ ch'Ọvaar Ibinọkpaabyi ikk'bẹ ọsa mattaabha amọm.<verse eid="1SA 26:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 26:13" />Nya o, Devid ojeka z'okwubha nwoza, od-obe z'ororo, k'ogbeso. Wa obhokọ kwiden oning bẹ ny'njeka. <verse eid="1SA 26:13" /><verse number="14" style="v" sid="1SA 26:14" />Devid o, owon agbongnọng p'Saul ọmaana Abnẹr, kw'ode nnwa kw'Nẹr, oben bẹ́, “Abnẹr, kaam ẹmọng màsi o?” Abnẹr ọpọhn-ẹ bẹ́, “Kọ anyi wọ ad-awon ọvaarnọng o?”<verse eid="1SA 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 26:15" />Devid oben bẹ́, “Mba ade ojinọng o? Anyi wọ ode mach'ikọ m'Israẹl? Kayen kw'ina ttatta ọvaarnọng kwọ akkerẹ? Ọnọng wanẹ kk'ọkwa nya bẹ́, ọfhọ ttatta ọvaarnọng kwọ e. <verse eid="1SA 26:15" /><verse number="16" style="v" sid="1SA 26:16" />Ọttọhk f'asi kojibhẹ. K'odik ọkkọkka, k'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, kọ ọttara ajinọng pọ mabaan k'obo, okurọ bẹ́, m'ttatta kwabọnga kw'Ọvaar Ibinọkpaabyi ikk'ana obyenga k'eso kakkerẹ. Màkkerẹ kọbha. Ọkọhn ọttara esigbomma ch'ọvaarnọng osokọ ọnyọma eso chẹ kẹ?”<verse eid="1SA 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 26:17" />Saul otin ẹmọng ch'Devid, oben bẹ́, “Nnwa kwaam Devid, ẹmọng chọ dọ o?” Devid ọpọhn-ẹ bẹ́, “Iye e, ọvaarnọng kwaam. Ẹmọng chaam dọ e.” <verse eid="1SA 26:17" /><verse number="18" style="v" sid="1SA 26:18" />Obir ọbọbh Saul bẹ́, “Ode yen kw'ikọ atte kwaam ad-akwubh kaam ọtọhmnọng kwọ o? Kaam nsi mbọng o? Mbira mpinẹ k'ambọng o? <verse eid="1SA 26:18" /><verse number="19" style="v" sid="1SA 26:19" />Tte ttatta kwaam oyonga ọtọhmnọng kwẹ itọhng. Ó̱de Ọvaar Ibinọkpaabyi wọ ọsọ-ọ bẹ́, awun-m, tte ochera ọtọka ẹnanga. Okenaka, óde ofon k'ayokinọng, tte opyibh ọnang bẹ k'ititika s'Ọvaar Ibinọkpaabyi! Bẹ nkk'aam akwubha, maram-m okebh f'nyen k'Ọvaar Ibinọkpaabyi, mabira aben-m bẹ́, ‘Zọhng, ad-akpobha aka.’ <verse eid="1SA 26:19" /><verse number="20" style="v" sid="1SA 26:20" />Kàchera bẹ́, izẹ saam ichebhẹ k'obhon kw'anọng p'nna Ọvaar Ibinọkpaabyi azong. Kọ ọvaarnọng kw'Israẹl ad-akwu aror kaam etitaana, mach'ọnọng oyinẹ ẹgbaaji ch'inọhn z'agbeso.”<verse eid="1SA 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 26:21" />Nya o, Saul oben bẹ́, “Kaam kk'epyibha nsa. Nnwa kwaam Devid, kpa nnam. Menda kk'nza bẹ́, akpen paam abar-ọ odik. Kaam ọdọk kọ itama kpenamkpen mìnsi. K'odik ọkkọkka, kaam kk'etwurọ nsa, mbir mpinẹ <char style="it">ma tamatama</char>.”<verse eid="1SA 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 26:22" />Devid ọpọhn-ẹ bẹ́, “Kirẹ ọkọhn f'ọvaarnọng ma. Tte ogbongnọng wanẹ kwọ okwu ọtọka. <verse eid="1SA 26:22" /><verse number="23" style="v" sid="1SA 26:23" />Ọvaar Ibinọkpaabyi ọd-ọtaam ọnọng kpenamkpen k'ose kw'ọnọng otorọ, obir ọsaka eso otuma. Menda Ọvaar Ibinọkpaabyi kk'ọ ọtọka oke-m k'mbọhk. Okenaka, kaam ọnọng kw'Ọvaar Ibinọkpaabyi ikk'ana obyenga k'eso ọbọhk mìntwu k'itama. <verse eid="1SA 26:23" /><verse number="24" style="v" sid="1SA 26:24" />K'ose kw'akpen pọ mabar-m odik menda, tte akpen paam mabar Ọvaar Ibinọkpaabyi odik, obira ọrọbh-m k'damadama kpenamkpen.”<verse eid="1SA 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 26:25" />Nya o, Saul oben Devid bẹ́, “Nnwa kwaam Devid, tte ojibh ọnang-ọ. Kọ m'asi iga-idik. K'odik ọkkọkka, okpenamkpen f'atwu ọbọhk m'ojibh ọnang-ọ.”</para>
  <para style="p" vid="1SA 26:25">Minna kw'Devid obin ofona, Saul ọkpa nnam ọbhana.<verse eid="1SA 26:25" /></para>
  <chapter eid="1SA 26" />
  <chapter number="27" style="c" sid="1SA 27" />
  <para style="s1">Devid orukọ ọmaana aPhilistiya</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 27:1" />Wa Devid ochibhẹ bẹ́, “Ewu danẹ Saul m'ọfhọ-m ọfhọ. Ọbaan bẹ́, nnọbh nchina z'ẹkọma ch'aPhilistiya. Nya kw'Saul m'ottik-m oriror k'ibyi kpenamkpen m'Israẹl, mbir nnaanga k'mbọhk sẹ.”<verse eid="1SA 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 27:2" />Nya o, Devid otima agbongnọng pẹ ẹnọhna okwuma arọbh ijobh, mabina mad-akebha Akish, nnwa kw'Maok, kw'ode ọvaarnọng kw'Gat. <verse eid="1SA 27:2" /><verse number="3" style="v" sid="1SA 27:3" />Devid ọmaana agbongnọng pẹ mator Akish maruk z'Gat. Ojinọng kpenamkpen kwẹ oruk nya ọmaana ẹsọhmmọr chẹ. Wa kẹ Devid orukọ nya ttara panọng pẹ afa, p'ade Ahinoam kw'ofon Jẹzrẹl, ọmaana Abigẹl kw'ode opokwa kw'Nabal, kw'ofon Kaamẹl. <verse eid="1SA 27:3" /><verse number="4" style="v" sid="1SA 27:4" />K'ogbe kw'matek Saul bẹ́, Devid kk'ọrọbha ochina z'Gat, ottik-ẹ oriror.<verse eid="1SA 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 27:5" />Nya o, Devid oben Akish bẹ́, “Ó̱de ikk'ọphyaam nza k'ititika sọ, nang-m ibyi k'obhon wanẹ m'ẹkọma chọ nruk. Kayen kw'ọtọhmnọng kwọ im'oruk k'ọvaarbhon ọmaan-ọ?”<verse eid="1SA 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 27:6" />Ofona nya o, ny'ewu ndo Akish ọtọka obhon kw'Ziklag ọnang Devid. Tọma ny'ewu ndo, Ziklag nokwu ode obhon kw'avaar p'Juda maa, pyirẹ menda.<verse eid="1SA 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 27:7" />Wa Devid orukọ ny'ẹkọma ch'Philistiya k'icho mawanẹ ọmaana aphe anna.<verse eid="1SA 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 27:8" />Wa ny'ogbe nwo, Devid ọmaana agbongnọng pẹ mad-arima anọng p'Geshur ábẹ̀, ọmaana p'Girz, ọttara p'Amalẹk. (Anọng mba kk'atọma k'ẹtama maruk m'izek nja s'itọm m'Shur maa pyirẹ z'Ijip.)<verse eid="1SA 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 27:9" />Ogbe kpenamkpen kw'Devid orim ẹkọma ábẹ̀, ọnọng mawanẹ-wanẹ kod-otte oruk akpen, ode ojinọng, wanẹma kwanọng. Okenaka, ọd-ọtọka arọkimaan, ọmaana adamogbodo, ọmaana nnyanya, ọmaana akamẹl, ọttara ọbara, pira ọkpa nnam z'Akish.<verse eid="1SA 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 27:10" />Ogbe kw'Akish ọbọbh-ẹ bẹ́, “Bọng-anọng p'arim ábẹ̀ menda?” Devid ọd-ọpọhn-ẹ bẹ́, “Nnim mmaana anọng p'Nẹgẹv p'ẹkọma ch'Juda,” wanẹma “Nnim mmaana anọng p'Nẹgẹv p'ẹkọma ch'Jẹramẹl,” wanẹma “Anọng p'Nẹgẹv p'ẹkọma ch'Ken.” <verse eid="1SA 27:10" /><verse number="11" style="v" sid="1SA 27:11" />Minna kw'Devid ọd-ọfhọ ọnọng kpenamkpen k'ejinọng ọttara k'ẹpanọng, ọfha ọnọng oning orikẹ kw'im'ọta z'Gat ọd-ọyaakẹ osisi kw'ikẹ ọmaana agbongnọng pẹ bẹ́, “Ọttọhk f'iwa Devid osi vọ ma.” Tọma za ch'orukọ ny'ẹkọma ch'aPhilistiya, minna kw'ẹmmaana ch'Devid ede.<verse eid="1SA 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 27:12" />Akish okwu oyena ichichera k'Devid, ochibhẹ bẹ́, “Devid kk'anọng pẹ p'Israẹl idik ọgbẹra. Kẹ min'ode ọtọhmnọng kwaam ttattampe.”<verse eid="1SA 27:12" /></para>
  <chapter eid="1SA 27" />
  <chapter number="28" style="c" sid="1SA 28" />
  <para style="s1">Saul oyin ẹbọhk z'Ẹndọr</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 28:1" />Wa ny'ogbe nwo, anọng p'Philistiya matobh agbongnọng pabẹ, mfha matima arima anọng p'Israẹl ábẹ̀. Akish obenẹ Devid bẹ́, “Zonga bẹ́, kọ ọmaana anọng pọ mm'ator-m egbong.”<verse eid="1SA 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 28:2" />Devid oben-ẹ bẹ́, “Kọ m'aze ọttọhk f'ọtọhmnọng kwọ im'okpo osi.” Akish ọpọhn-ẹ bẹ́, “Ojibh-ojibh, kaam m'nsọ-ọ ade ọnọng kw'im'od-okker-m, ttattampe.”<verse eid="1SA 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 28:3" />Ny'ogbe nwa, wa Samwẹl kk'ọpa, anọng p'Israẹl maphyir mabhom-ẹ, mabir anọhng-ẹ z'Rama, kw'ode obhon kwẹ. Saul obir okwubh achiranganọng ọmaana abọhnganọng ny'izek s'Israẹl.<verse eid="1SA 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 28:4" />Anọng p'Philistiya mattonga, mabir asi ibhinga-byi z'Shunẹm. Saul otobha agbongnọng p'Israẹl maphyir, obir osi ibhinga-byi z'Gilboa. <verse eid="1SA 28:4" /><verse number="5" style="v" sid="1SA 28:5" />K'ogbe kw'Saul oze agbongnọng p'Philistiya, opoma ọbọk-ẹ z'ettem, ojor-ẹ mawuriji. <verse eid="1SA 28:5" /><verse number="6" style="v" sid="1SA 28:6" />Ofona nya o, ọbọbh Ọvaar Ibinọkpaabyi ọttọhk f'im'osi. Okenaka, Ọvaar Ibinọkpaabyi idachen, wanẹma Urim, wanẹma agbaak-ettem ch'Ibinọkpaabyi, kotim ọnang-ẹ ẹpọhna. <verse eid="1SA 28:6" /><verse number="7" style="v" sid="1SA 28:7" />Nya o, Saul oben atọhmọ pẹ bẹ́, “Màror kwanọng kw'ode ọbọhnganọng nang-m, ọfha nd-mbọbh-ẹ.”</para>
  <para style="p" vid="1SA 28:7">Mapọhn-ẹ bẹ́, “Kwanọng wanẹ kw'ode ọbọhnganọng oning z'Ẹndọr.”<verse eid="1SA 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 28:8" />Minna kw'Saul obhon ẹnya chẹ, ọfha maning-ẹ atin-ẹ. Otum ny'erungọ, kẹ ọmaana ajinọng pẹ afa mad-akebha kwanọng nwo. Oben-ẹ bẹ́, “Si ẹbọhk atek-m odik kw'ọnọng kw'im'nyerẹ eche ma.” <verse eid="1SA 28:8" /><verse number="9" style="v" sid="1SA 28:9" />Kwanọng nwo ọpọhn-ẹ bẹ́, “K'odik ọkkọkka, kọ azong ọttọhk f'Saul osi ma. Kẹ kk'achiranganọng, ọmaana abọhnganọng okwubha m'izek nja. Osempira anwọn-m ọmma bẹ́, mpe o?”<verse eid="1SA 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 28:10" />Saul ochekẹ ọnang-ẹ k'eche ch'Ibinọkpaabyi bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi oruk akpen, ọnọng kw'im'ọnang-ọ irem m'ọttọhk mva, kode.”<verse eid="1SA 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 28:11" />Nya o, kwanọng nwo ọbọbh-ẹ bẹ́, “Anyi wọ kw'im'nyerẹ nnang-ọ?” Ọpọhn-ẹ bẹ́, “Yerẹ Samwẹl.”<verse eid="1SA 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 28:12" />Ch'kwanọng nwo oze Samwẹl, ọkwọhrọ ẹmọng k'ẹrọng, oben Saul bẹ́, “Osempira abọhr-m o? Kọ ade Saul!”<verse eid="1SA 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 28:13" />Ọvaarnọng oben-ẹ bẹ́, “Oning-ọ ojor. Bọng-ọttọhk f'aze?” Kwanọng nwo ọpọhn-ẹ bẹ́, “Nze ọttọhk mach'ọgbagba ch'od-oyin z'izek.”<verse eid="1SA 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 28:14" />Ọbọbh-ẹ bẹ́, “Okerẹ mbọng o?”</para>
  <para style="p" vid="1SA 28:14">Kwanọng nwo ọpọhn-ẹ bẹ́, “Ojinọng wanẹ kw'ikk'ọtama wọ oyinẹ nya, ọfọra owurọ-baba.” Ofona nya, Saul ozonga bẹ́, Samwẹl wọ. Ọraka eso otwu izek k'ikpukpobha.<verse eid="1SA 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 28:15" />Samwẹl obenẹ Saul bẹ́, “Osi yen kw'ayer-m za ch'nning, ayak-m odik?” Saul ọpọhn-ẹ bẹ́, “Ettem ẹyak-m odik ọkpan. APhilistiya arim-m ábẹ̀ ka, Ibinọkpaabyi obir ọkpa nnam ọbọr-m. Ozeng k'idachen, obir ode k'agbaak-ettem chẹ, ọdọk kaam ẹmọng kod-osi. Nya wọ osi nyer-ọ bẹ́, atek-m ọttọhk f'im'nsi.”<verse eid="1SA 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 28:16" />Samwẹl oben bẹ́, “Osempira akwu abọbh-m odik, ch'Ọvaar Ibinọkpaabyi ikk'nnam ọkpa ọbọr-ọ, obir ode ọwawunanọng kwọ? <verse eid="1SA 28:16" /><verse number="17" style="v" sid="1SA 28:17" />Ọvaar Ibinọkpaabyi kk'ọsa k'ose kw'uwa ọkamẹ, otor k'ọgbaakadik kwẹ kw'oyin-m m'ẹmma. Ọvaar Ibinọkpaabyi kk'ẹfa ọtọka z'ikọ k'ọbọhk, ọnang ọnọng kw'ọnyọm-ọ, kw'ode Devid. <verse eid="1SA 28:17" /><verse number="18" style="v" sid="1SA 28:18" />Wa kọ Ọvaar Ibinọkpaabyi kakpobh, anọng p'Amalẹk ottempyibha kwẹ kakọhk mach'obenẹ. Nya wọ osi ọsọ-ọ odik nwa menda. <verse eid="1SA 28:18" /><verse number="19" style="v" sid="1SA 28:19" />Ọvaar Ibinọkpaabyi m'ọtọka kọ ọmaana anọng p'Israẹl oke k'mbọhk s'aPhilistiya. Ophyinẹ, kọ ọmaana iva pọ mm'aninga amaan-m m'offurabhon. Ọvaar Ibinọkpaabyi m'obira ọtọka agbongnọng p'Israẹl oke aPhilistiya k'mbọhk.”<verse eid="1SA 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 28:20" />Ny'eninga ndo, Saul otto idumsẹ ny'izek, ojora ọsẹ-ẹ okurọ ọgbaakadik kw'Samwẹl. Ẹfa ẹsẹ-ẹ okurọ ch'ina ọttọhk ochi k'ewu kibungọ.<verse eid="1SA 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 28:21" />K'ogbe kw'kwanọng nwo oze bẹ́, Saul kẹ ojora maa nọd-ọfọn-ọfọnọ, oben-ẹ bẹ́, “Ttatta, kaam ọtọhmnọng kwọ kk'odik kwọ mkpobha, ncher obo nsi ọttọhk f'aben-m bẹ́, nsi. <verse eid="1SA 28:21" /><verse number="22" style="v" sid="1SA 28:22" />Madidaanma, yonga ọtọhmnọng kwọ itọhng. Tte nnang-ọ ọchattọhk achi ọfha ayena ẹfa azọhng abhana.”<verse eid="1SA 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 28:23" />Saul obhum, oben bẹ́, “Ọttọhk mìnchi.” Okenaka, ayok-ẹkaan pẹ ọmaana kwanọng nwo magwẹ-ẹ, ochera ọmaana bẹ. Obina z'izek oninga ẹwọr k'ebin.<verse eid="1SA 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 28:24" />Kwanọng nwo ọtọka ọbhaamnwa kw'ode ifor <char style="it">ma dọrọdọrọ</char> kw'ọgban nya, ọfhọ. Ọtọka abuma p'mad-atima asi brẹd ọlọhbh, otima osi brẹd kw'nna yist ake. <verse eid="1SA 28:24" /><verse number="25" style="v" sid="1SA 28:25" />Otinẹ ọchattọhk mvo obera Saul ọmaana ayok-ẹkaan pẹ, machi. Ny'erungọ ndo, mabina afona.<verse eid="1SA 28:25" /></para>
  <chapter eid="1SA 28" />
  <chapter number="29" style="c" sid="1SA 29" />
  <para style="s1">Anọng p'Philistiya abhumọ Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 29:1" />Wa aPhilistiya atobh agbongnọng pabẹ maphyir z'Aphẹk, anọng p'Israẹl mabir abhing anyọma ekeka ch'ening z'Jẹzrẹl.<verse eid="1SA 29:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 29:2" />Ch'iwa avaar p'Philistiya mabin ozenga ọmaana agbongnọng pabẹ k'nkwurọ s'anọng arọbh achen, ọmaana k'nkwurọ s'anọng nnọhna k'nnọhna, wa Devid ọmaana agbongnọng pẹ mabir azenga ọmaana Akish z'nnam-nnam. <verse eid="1SA 29:2" /><verse number="3" style="v" sid="1SA 29:3" />Avaar p'Philistiya aze bẹ nya o, mabọbh bẹ́, “AHiburu mba ad-asi mbọng ma?”</para>
  <para style="p" vid="1SA 29:3">Akish ọpọhna bẹ́, “Devid kw'uwa ode ọtọhmnọng kw'Saul kw'ọbaabh Israẹl azang ma o? Kẹ kk'oninga ọmaan-m k'icho kibungọ ọmaan-ọmaana. Tọma za ch'otte Saul ọbọhk oninga ọmaan-m, kẹ epinẹ ntim nza.”<verse eid="1SA 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 29:4" />Okenaka, avaar p'agbongnọng p'Philistiya mabhem ettem amaana Akish, maben-ẹ bẹ́, “Ben ojinọng nwa ọkpa nnam z'obhon kw'aben-ẹ bẹ́, oninga. Tte oning mina otorọ moyin egbong, ọfha oning achibhẹ obhon orima mina ábẹ̀. Ó̱de ororọ bẹ́, ojibh s'otte k'ititika, m'otima nso s'agbongnọng pamina ọgba ọmaana otte. <verse eid="1SA 29:4" /><verse number="5" style="v" sid="1SA 29:5" />Devid nwa azang kw'uwa mad-akkọhn, mabir atubh k'mbin sabẹ bẹ́,</para>
  <para style="q1" vid="1SA 29:5">‘Saul kk'anọng ọfha k'nnọhna k'nnọhna,</para>
  <para style="q2" vid="1SA 29:5">Devid ọfhọ anọng k'nnọhna s'ina obhika ide o’?”<verse eid="1SA 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 29:6" />Nya o, Akish oyerẹ Devid oben-ẹ bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, kk'nza bẹ́, osisi kwọ ode mawuriji. M'ọdaak-m bẹ́, aninga amaan-m mach'ogbongnọng kwaam. Tọma ny'ewu ch'akwu akebh-m, maa pyirẹ ma, kọ epinẹ kpenamkpen kinze. Okenaka, avaar p'agbongnọng kacher bẹ́, ator mina. <verse eid="1SA 29:6" /><verse number="7" style="v" sid="1SA 29:7" />Kpa nnam k'ọdaam. Ọttọhk kàsi f'im'ọdọkọ avaarnọng p'Philistiya.”<verse eid="1SA 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 29:8" />Devid ọbọbh Akish bẹ́, “Tọma ny'ewu ch'nde ọtọhmnọng kwọ maa pyirẹ menda, bọng-epinẹ dọ ch'nsi? Kayen kw'ina egbong mìnrima mmaana awawunanọng p'ikọ ttatta kw'ade ọvaarnọng kwaam o?”<verse eid="1SA 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 29:9" />Akish ọpọhn-ẹ bẹ́, “Kaam nzong mawuriji bẹ́, kọ ade mach'ozeng-eden kw'Ibinọkpaabyi kw'ina epinẹ oyen. Okenaka, avaar p'agbongnọng p'Philistiya kk'abena bẹ́, ‘Kẹ kọbaan bẹ́, otor mina moyin egbong.’ <verse eid="1SA 29:9" /><verse number="10" style="v" sid="1SA 29:10" />Ofona nya, ophyinẹ k'ekpikpebha, tima atọhmọ p'atte kwọ p'atim akwu ma, bhana k'owusobha.”<verse eid="1SA 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 29:11" />Nya o, Devid ọmaana ajinọng pẹ mabina k'ekpikpebha, makpa nnam z'Philistiya. Anọng p'Philistiya mabir achina z'Jẹzrẹl.<verse eid="1SA 29:11" /></para>
  <chapter eid="1SA 29" />
  <chapter number="30" style="c" sid="1SA 30" />
  <para style="s1">Devid ọfhọ anọng p'Amalẹk</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 30:1" />Ny'ewu ch'ettong ittaan, Devid ọmaana ajinọng pẹ mapyirẹ z'Ziklag. Maze bẹ́, anọng p'Amalẹk kk'egbong arima amaana anọng p'Nẹgẹv, ọmaana p'Ziklag maa, makwọmọ obhon kw'Ziklag, <verse eid="1SA 30:1" /><verse number="2" style="v" sid="1SA 30:2" />mabir abọka panọng p'aning nya k'ẹmmọri, ọmaana anọng mboza maphyir, ivava, ọttara ataminọng. Matima bẹ afona. Ọnọng kw'mafhọ-ọfhọ kode.<verse eid="1SA 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 30:3" />Ch'Devid ọmaana ajinọng pẹ mapyirẹ z'Ziklag o, maze bẹ́, nkk'obhon kw'Ziklag akwọma maphyir, mabir abọka panọng pabẹ ọmaana iva maphyir k'ẹmmọri. <verse eid="1SA 30:3" /><verse number="4" style="v" sid="1SA 30:4" />Nya o, Devid ọmaana ajinọng pẹ mabhom amọng maa ẹfa ẹsa bẹ. <verse eid="1SA 30:4" /><verse number="5" style="v" sid="1SA 30:5" />Ny'ogbe nwo, nkk'panọng mbo afa p'Devid abọka k'ẹmmọri, p'ade Ahinoam kw'ofon Jẹzrẹl, ọmaana Abigẹl kw'ode opokwa kw'Nabal kw'ofon Kaamẹl. <verse eid="1SA 30:5" /><verse number="6" style="v" sid="1SA 30:6" />Wa odik nwo ọyak Devid odik z'ettem mawuriji, ettem ebir epyibh ọnọng kpenamkpen okurọ iva pabẹ. Ofona nya, maben bẹ́, mm'atọhbh-ẹ ata. Okenaka, Ọvaar Ibinọkpaabyi oke Devid ettem.<verse eid="1SA 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 30:7" />Nya kw'Devid nobenẹ Abiyata kw'ode ọfọhn-nja, obir ode nnwa kw'Ahimẹlẹk bẹ́, “Chen-m <char style="w">ẹphọd</char>.” Abiyata o, ọtọka ọnang-ẹ. <verse eid="1SA 30:7" /><verse number="8" style="v" sid="1SA 30:8" />Devid ọbọbh Ọvaar Ibinọkpaabyi bẹ́, “Ma, nkwubh anọng mbo p'akwọmọ Ziklag k'eden o? Ina nna bẹ mkpaang yirẹ?” Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Kwubh bẹ, m'ana bẹ mkpaang ọna, abir atọka okpenamkpen f'ode fọ.”<verse eid="1SA 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 30:9" />Nya o, Devid ọmaana ajinọng pẹ p'ade ẹnọhna okwuma arọbh ijobh mabina, mapyirẹ z'ilokodo s'Bẹsọr. Ayok banẹ o, maninga nya, <verse eid="1SA 30:9" /><verse number="10" style="v" sid="1SA 30:10" />anọng arọbh ijobh m'ọdọk ẹfa kayen ch'mm'atima ajeka ilokodo njo. Okenaka, Devid ọmaana ajinọng pẹ p'ade ẹnọhna, machina ororo akwubh awawunanọng pabẹ.<verse eid="1SA 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 30:11" />Wa makwu aze oJipnọng wanẹ z'ẹgba, mabọk-ẹ achena Devid. Manang-ẹ asi ogwo, mabira anang-ẹ ọchattọhk ochi, <verse eid="1SA 30:11" /><verse number="12" style="v" sid="1SA 30:12" />f'ode igbogbo s'matim fig asi, ọmaana ogbogbokwa ọfa f'matim grep kw'ikk'ọgwa asi. Ochi nya o, ifor ibira iphyabh-ẹ. Ode ch'ikk'oninga k'iyawu ittaan, ọmaana irungiwu ittaan, ọttọhk kochi, asi kobir ogwo.<verse eid="1SA 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 30:13" />Devid ọbọbh-ẹ bẹ́, “Anyi wọ ode atte kwọ? Afon memma?” Ọpọhn-ẹ bẹ́, “Kaam mfon Ijip, nde obira kw'ọnọng kw'ofon Amalẹk. Atte kwaam obhum-m ọbharẹ ma, ch'ikk'aam ọmma k'iwu ittaan s'ikk'ikpana. <verse eid="1SA 30:13" /><verse number="14" style="v" sid="1SA 30:14" />Mina bọ mọrim egbong ọmaana anọng p'Kẹrẹt z'ẹbhaakẹ ch'Nẹgẹv, ọmaana ẹkọma ch'Juda, ọttara Nẹgẹv kw'Kalẹb. Mobir ọkwọmọ obhon kw'Ziklag.”<verse eid="1SA 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 30:15" />Devid ọbọbh-ẹ bẹ́, “Ma, ina akpo atim-m eden mokebha egbongkaan ndo ch'ẹkwọmọ ibhon njo?” Ọpọhn-ẹ bẹ́, “Chekẹ nang-m k'ititika s'Ibinọkpaabyi bẹ́, kaam màfhọ, wanẹma kaam màtọka anang atte kwaam. Íkk'asa minna, kaam m'ntim-ọ nd-nkọhk-ọ ibyi s'maning.”<verse eid="1SA 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 30:16" />Ojipnọng nwo otima Devid eden, mad-akebha anọng mbo za ch'nkk'araama, maninga k'ochichi, ọmaana k'igwagwa, ọttara k'izozo, okurọ ekpo saabhada py'nkk'atọka z'obhon kw'Philistiya ọttara kw'Juda. <verse eid="1SA 30:16" /><verse number="17" style="v" sid="1SA 30:17" />Devid obina erima ọmaana bẹ, tọma ny'ẹsọhka ndo maa, pyirẹ k'ẹsọhka ch'ewu ndoza. Ọfhọ bẹ maa, ọnọng kw'ọnaang-ọnaanga kode, kw'ọkpanẹ ajinọng ẹnọhna p'manan k'akamẹl marọbh. <verse eid="1SA 30:17" /><verse number="18" style="v" sid="1SA 30:18" />Wa Devid ọkpa nnam ọtọka ọttọhk kpenamkpen f'anọng p'Amalẹk nkk'atọka, ọttara panọng pẹ afa. <verse eid="1SA 30:18" /><verse number="19" style="v" sid="1SA 30:19" />Ọttọhk f'odim-odimẹ kode; nnwanwa, wanẹma, odidennọng, odikkobh wanẹma ominanwa, wanẹma ọttọhk kpenamkpen f'iwa bẹ nkk'atọka. Wa Devid ọkpa nnam ọtọka byẹ maphyir. <verse eid="1SA 30:19" /><verse number="20" style="v" sid="1SA 30:20" />Minna kw'Devid ọtọk etirakpo mbyo maphyir, ajinọng pẹ ayaar atima achẹ-ẹ eden, maben bẹ́, “Ma wọ ode ekpo py'Devid ọtọk z'egbong.”<verse eid="1SA 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 30:21" />Nya o, Devid ọkpa nnam okebha ajinọng mboza arọbh ijobh p'maning z'ilokodo s'Bẹsọr p'uwa ẹfa ikk'bẹ ẹsa. Mayin k'iyaan akwu akebha Devid ọmaana anọng p'aning amaan-ẹ. Devid ọmaana ajinọng pẹ anyọm bẹ nya o, Devid ozima bẹ. <verse eid="1SA 30:21" /><verse number="22" style="v" sid="1SA 30:22" />Okenaka, apyibhanọng banẹ, ọmaana akikọhra maphyir ny'ẹkaan ch'Devid maben bẹ́, “Ch'anọng mba nna mina atorọ moyin egbong, bẹ m'okebh f'ekpo py'motim okwuna egbong màyena. Tte ojinọng kpenamkpen okenaka ọtọka kwanọng kwẹ ọmaana iva pẹ otima ofona.”<verse eid="1SA 30:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 30:23" />Devid oben bẹ bẹ́, “Mma e, ivotte paam. Tte moning minna osi ọmaana ekpo py'Ọvaar Ibinọkpaabyi ikk'mina ọnanga. Ọvaar Ibinọkpaabyi kk'mina okkera, obir ọtọka mgbong-kaan njo s'irim mina ábẹ̀ oke mina k'mbọhk. <verse eid="1SA 30:23" /><verse number="24" style="v" sid="1SA 30:24" />Anyi wọ im'oyonga itọhng k'odik kwabọnga? Okebh f'ọnọng kw'oning ma okkerẹ ekpo, m'ode mbengana mach'okebh f'ọnọng kw'oyin egbong.” <verse eid="1SA 30:24" /><verse number="25" style="v" sid="1SA 30:25" />Nya o, Devid otima odik nwo osok ọsana ny'Israẹl, tọma za maa pyirẹ menda.<verse eid="1SA 30:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 30:26" />Ch'Devid opyirẹ z'Ziklag, ọtọka ekpo byanẹ py'matọk z'egbong, ọtọhm ọnang asogbọhkọnọng banẹ p'Juda p'ade ayokdikkobh pẹ, oben bẹ bẹ́, “Ma wọ ode ẹnanga chabọnga, ch'efon z'ekpo py'mọna awawunanọng p'Ọvaar Ibinọkpaabyi.”<verse eid="1SA 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 30:27" />Wa ọtọhm nnanga njo ọnang anọng p'Bẹtẹl, ọmaana Ramọt kw'oning z'ẹbhaakẹ ch'Nẹgẹv, ọttara Jatir. <verse eid="1SA 30:27" /><verse number="28" style="v" sid="1SA 30:28" />Obir ọnang anọng p'Aroer, ọmaana p'Siphmọt, ọmaana p'Ẹstẹmoa, <verse eid="1SA 30:28" /><verse number="29" style="v" sid="1SA 30:29" />ọmaana p'Rakal, ọmaana anọng p'Jẹramẹl, ọttara anọng p'Ken. <verse eid="1SA 30:29" /><verse number="30" style="v" sid="1SA 30:30" />Obir ọtọhm ọnang anọng p'Họma, ọmaana p'Bor-Ashan, ọttara p'Atak, <verse eid="1SA 30:30" /><verse number="31" style="v" sid="1SA 30:31" />ọmaana p'Hẹbrọn, ọttara p'nkọma njoza maphyir s'iwa kẹ Devid ọmaana ajinọng pẹ nkk'akpaanga apyirẹ.<verse eid="1SA 30:31" /></para>
  <chapter eid="1SA 30" />
  <chapter number="31" style="c" sid="1SA 31" />
  <para style="s1">Obo kw'Saul ọmaana iva pẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 31:1" />M'ogbe nwa, aPhilistiya arima egbong amaana anọng p'Israẹl. Anọng p'Israẹl marọbh, asaabhada mape ny'egbe ch'Gilboa. <verse eid="1SA 31:1" /><verse number="2" style="v" sid="1SA 31:2" />Wa aPhilistiya ayak ọbọhk akwubh Saul ọmaana iva pẹ, mafhọ iva mbo p'Saul p'ade Jonatan, ọmaana Abinadab, ọttara Malki-Shua. <verse eid="1SA 31:2" /><verse number="3" style="v" sid="1SA 31:3" />Wa erima ndo ekwu ẹgaangẹ ẹmaana Saul. Agbongnọng mbo makọbh-ẹ, matima ayuk attẹ-ẹ, mamum-ẹ ekpo mawuriji.<verse eid="1SA 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 31:4" />Nya o, Saul oben otim-egbongkpo kwẹ bẹ́, “Rọbha ọkkangkkang kwọ z'ọpa atima kwum-m. Ina minna asi, anọng mba p'nna inọm abhirẹ m'akebh-m ma akwum-m, m'abira asi-m idingidingidik.”</para>
  <para style="p" vid="1SA 31:4">Okenaka, ojora fiden osi otim-egbongkpo kwẹ, kocher bẹ́, ọfhẹ-ẹ. Ofona nya o, Saul ọtọka ọkkangkkang kwẹ, ozeng mmo ọfhẹ-ẹ ifor. <verse eid="1SA 31:4" /><verse number="5" style="v" sid="1SA 31:5" />Ch'otim-egbongkpo nwo oze bẹ́, Saul kk'ọpa, kẹ ọdọk, obir ọtọka ọkkangkkang kwẹ ọfhọ ifor sẹ. <verse eid="1SA 31:5" /><verse number="6" style="v" sid="1SA 31:6" />Nya o, Saul ọmaana ajinọngva pẹ attaan, ọmaana otim-egbongkpo kwẹ, ọttara agbongnọng pẹ maphyir, mape ewu ndo madanẹ.<verse eid="1SA 31:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 31:7" />Ch'anọng p'Israẹl p'arukọ z'ilokodo, ọmaana ayok p'arukọ z'okwubha kw'Jọrdan maze bẹ́, agbongnọng p'Israẹl kk'arọbha, ọmaana bẹ́, Saul ọttara ajinọngva pẹ kk'apa, bẹ ọdọk mabira arọbh arik ibhon sabẹ. Anọng p'Philistiya makwu aruk ny'ibhon njo.<verse eid="1SA 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 31:8" />Ewu esobh nya, ch'aPhilistiya makwu afọhngọ affuranọng mbo, maze Saul ọmaana ajinọngva pẹ attaan ch'mayim ny'egbe ch'Gilboa. <verse eid="1SA 31:8" /><verse number="9" style="v" sid="1SA 31:9" />Makpaar-ẹ eso, mabira awọr-ẹ egbongkpo pyẹ. Matọhm azeng-eden akọma nkọma s'aPhilistiya maphyir bẹ́, matek ẹkkaabha ndo z'aka-pa pabẹ, ọttara z'anọng pabẹ. <verse eid="1SA 31:9" /><verse number="10" style="v" sid="1SA 31:10" />Masok egbongkpo pyẹ k'ọka-pa kw'Ashtọrẹt, mabir atọka oforbukọ kwẹ adabh k'etumọ ch'Bẹt-Shan.<verse eid="1SA 31:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 31:11" />Ch'anọng p'Jabẹsh-Gilead mabhaang ọttọhk f'aPhilistiya asi Saul, <verse eid="1SA 31:11" /><verse number="12" style="v" sid="1SA 31:12" />akkikkaama pabẹ maphyir, matima erungọ achina z'Bẹt-Shan. Mapyirẹ za o, machaarẹ oforbukọ kw'Saul ọmaana aforbukọ p'iva pẹ z'etumọ ch'Bẹt-Shan. Matọka bẹ ad-akwọmọ z'Jabẹsh. <verse eid="1SA 31:12" /><verse number="13" style="v" sid="1SA 31:13" />Pira nnatọk akọbhọ pabẹ ad-anọhnga z'echirin ch'tamarisk z'Jabẹsh. Mabir atim ọchattọhk k'iwu ichenọmfa.<verse eid="1SA 31:13" /></para>
  <chapter eid="1SA 31" />
</usx>