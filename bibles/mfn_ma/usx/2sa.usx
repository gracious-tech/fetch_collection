<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Mbembe Adun [MFNAdun]</book>
  <para style="h">2 Samwẹl</para>
  <para style="toc1">Nnwẹr kw'ottong afa kw'Samwẹl</para>
  <para style="toc2">2 Samwẹl</para>
  <para style="mt1">Nnwẹr kw'ottong afa kw'Samwẹl</para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s1">Devid ọbhaang obo kw'Saul</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />K'ogbe kw'Saul ikk'ọpa, Devid okwuna za ch'ikk'egbong orima okema anọng p'Amalẹk. Oninga ny'Ziklag k'iwu ifa. <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />Ny'ewu ch'ettong ittaan, ojinọng wanẹ z'ẹkpa ch'Saul okwu nya ttara ekpo py'ikk'ẹyaaka z'ifor maphyir, ọmaana ebunọ z'eso. K'ose kw'opyirẹ nya ch'Devid oning, otto ny'ititika s'Devid k'ekpikpobha-maana.<verse eid="2SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 1:3" />Devid ọbọbh-ẹ bẹ́, “Men kw'afon akwu ma?” Ọpọhn-ẹ bẹ́, “Kaam nrọbh-ọrọbh nnaanga z'ibhinga-byi s'Israẹl e.”<verse eid="2SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4" />Devid ọbọbh bẹ́, “Tek-m, bọng-odik wọ oyinẹ?”</para>
  <para style="p" vid="2SA 1:4">Ojinọng nwo ọpọhn-ẹ bẹ́, “Asoja pamina kk'arọbha z'egbong e, asaabhada nkk'apa. Saul ọmaana nnwa kwẹ Jonatan nkk'abira apa e.”<verse eid="2SA 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5" />Devid ọbọbh ojinọngnwa nwo bẹ́, “Asi yen azonga bẹ́, Saul ọmaana nnwa kwẹ Jonatan nkk'apa?”<verse eid="2SA 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6" />Ojinọngnwa nwo ọpọhna bẹ́, “Odik nwo oyinẹ ọvẹma k'ogbe kw'nning z'egbe ch'Gilboa, nze Saul ch'ophe ny'ọkkangkkang kwẹ; ijaar s'nnyanya id-itọr, ayaar-nnyanya s'aPhilistiya nkk'ẹ abira anyọma. <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />Nọbhakẹ nnam oze-m, oyer-m. Mpọhn-ẹ bẹ́, ‘Kirẹ kaam ma.’<verse eid="2SA 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8" />“Ọbọbh-m bẹ́, ‘Kọ anyi wọ?’</para>
  <para style="p" vid="2SA 1:8">“Kaam mpọhn-ẹ bẹ́, ‘Kaam mfon Amalẹk.’<verse eid="2SA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9" />“Obir oben-m bẹ́, ‘Be nyọm-m ma, afhọ-m, kirẹ kaam n'nning k'obo k'mbọhk ma, okenaka, ntim nning akpen ka.’<verse eid="2SA 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 1:10" />“Kaam o, mbe nnyọm-ẹ, mfhẹ-ẹ, okurọ bẹ́, nze k'odik ọkkọkka bẹ́, ch'ikk'ọtta nya, ọdọk mọ̀naanga. Minna kw'ntọk ivaarkpo s'ọfọr ny'eso, ọmaana ọbaangachigimẹ kw'oke z'ẹbọhkdọngọ, nchena kọ ọvaarnọng kwaam ma e.”<verse eid="2SA 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11" />Nya o, Devid ọmaana ajinọng maphyir p'aning nya amaan-ẹ, mabọka ekpo py'mafọr ny'ifor, mayaakẹ. <verse eid="2SA 1:11" /><verse number="12" style="v" sid="2SA 1:12" />Minna kw'maning k'oforpyibha, mabira abhom amọng, mayima okwo maa, opyirẹ k'ẹsọhka, mabhom obo kw'Saul omaana nnwa kwẹ Jonatan, ọttara kw'anọng p'Ọvaar Ibinọkpaabyi, ọttara anọng p'Israẹl, okurọ ch'anọng atim ọkkangkkang afhọ bẹ.<verse eid="2SA 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13" />Devid okwu ọbọbh ojinọngnwa nwo kw'ochen-ẹ ẹkkaabha ndo bẹ́, “Kọ afon memma?”</para>
  <para style="p" vid="2SA 1:13">Ọpọhn-ẹ bẹ́, “Kaam nde nnwa kw'okikennọng; mfon Amalẹk.”<verse eid="2SA 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14" />Devid ọbọbh-ẹ bẹ́, “Osi yen kw'ina kọ ojor bẹ́, atinẹ ọbọhk kwọ afhọ ọnọng kw'Ọvaar Ibinọkpaabyi ikk'ana obyenga k'eso?”<verse eid="2SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15" />Nya o, Devid oyerẹ ojinọng wanẹ kwẹ, oben-ẹ bẹ́, “Zọhng fhọ ọnọng nwo!” Minna kw'obin, obin-ẹ ọttọhk, ọfhẹ-ẹ. <verse eid="2SA 1:15" /><verse number="16" style="v" sid="2SA 1:16" />Devid oben-ẹ bẹ́, “Izẹ sọ m'ibhakẹ ikpẹk-ọ! Kọ kk'ẹmma chọ atima apyibh ifor sọ aponga, ch'abenẹ bẹ́, ‘Kaam kk'ọnọng kw'Ọvaar Ibinọkpaabyi ikk'ana obyenga k'eso mfha.’ ”<verse eid="2SA 1:16" /></para>
  <para style="s1">Devid obhom eforo ch'Saul ọmaana Jonatan</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />Minna kw'Devid otim eforo nda obhom Saul, ọmaana Jonatan. <verse eid="2SA 1:17" /><verse number="18" style="v" sid="2SA 1:18" />Ọnang ẹfa bẹ́, màkpebhẹ anọng p'Juda eforo nda ch'oyuk ch'makkẹrẹ z'nnwẹr kw'Jasha bẹ́:<verse eid="2SA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19" />“O Israẹl, abarada pọ ape ayima z'agbeso.</para>
  <para style="q2" vid="2SA 1:19">Kirẹ ose kw'afa-nọng atto e!<verse eid="2SA 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20" />“M'odik nwa z'Gat kàgbaak o,</para>
  <para style="q2" vid="2SA 1:20">nz'adenkpaarẹ p'Ashkẹlọn kàbira agbaak o.</para>
  <para style="q1" vid="2SA 1:20">Ina minna ode, aminava p'aPhilistiya m'adaam nttem,</para>
  <para style="q2" vid="2SA 1:20">aminava p'anọng p'atim-mkpatọr mm'abir alobh-olobh e.<verse eid="2SA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21" />“Bọnga agbe p'Gilboa,</para>
  <para style="q2" vid="2SA 1:21">tte abibira, wanẹma ẹrọng, ening bọnga epyirẹ,</para>
  <para style="q2" vid="2SA 1:21">tte iwonọ sabọnga ining ọdọk achimọma p'nnanga iwọmọ.</para>
  <para style="q1" vid="2SA 1:21">Kirẹ nya wọ kw'malukọ agbongtekgba p'afa-nọng,</para>
  <para style="q2" vid="2SA 1:21">ogbongtegba kw'Saul oworọ ana p'ofok.<verse eid="2SA 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22" />“Oyuk kw'Jonatan kk'ọzẹ f'anọng okibha,</para>
  <para style="q2" vid="2SA 1:22">ọkkangkkang kw'Saul kk'afa-nọng ọfha maa, obeng-ẹ.<verse eid="2SA 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23" />K'ogbe kw'uwa Saul ọmaana Jonatan marukọ akpen,</para>
  <para style="q2" vid="2SA 1:23">madaakẹ anọng idik, mabir ade affura p'ayok.</para>
  <para style="q1" vid="2SA 1:23">Maa pyirẹ k'obo, m'ayok kabhaangẹ.</para>
  <para style="q1" vid="2SA 1:23">Wa magwengẹ ayọhnga etingẹ,</para>
  <para style="q2" vid="2SA 1:23">mayena ẹfa ayọhnga nche.<verse eid="2SA 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24" />“O bọnga aminava p'Israẹl, màbhom Saul</para>
  <para style="q2" vid="2SA 1:24">kw'ọd-ọfọra bọnga ọbara f'okorọ izizẹ,</para>
  <para style="q2" vid="2SA 1:24">kw'otim gol odoka ẹnya chabọnga.<verse eid="2SA 1:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25" />“Kirẹ ose kw'afa-nọng atto k'egbong e!</para>
  <para style="q2" vid="2SA 1:25">Jonatan ope oyima k'agbe pọ.<verse eid="2SA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26" />Agbaanakka kwaam Jonatan, kaam mbhom-ọ k'amọng.</para>
  <para style="q2" vid="2SA 1:26">Wa kọ akpẹ-m k'ettem.</para>
  <para style="q1" vid="2SA 1:26">Ọdaakẹ kw'uwa ayen amaan-m ọbarẹ mawuriji,</para>
  <para style="q2" vid="2SA 1:26">ọdaakẹ nwo ọyọhng kw'panọng.<verse eid="2SA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27" />“Kirẹ ose kw'afa-nọng atto e!</para>
  <para style="q2" vid="2SA 1:27">Egbongkpo ekibhẹ kibung-kibungọ!”<verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s1">Masi Devid ọvaarnọng kw'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />Okwu opyirẹ k'ogbe wanẹ, Devid ọbọbh Ọvaar Ibinọkpaabyi bẹ́, “Ma, mbina nchina k'obhon wanẹ m'Juda o?”</para>
  <para style="p" vid="2SA 2:1">Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Zọhng e!”</para>
  <para style="p" vid="2SA 2:1">Devid ọbọbh-ẹ bẹ́, “M'nchina men?”</para>
  <para style="p" vid="2SA 2:1">Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “China z'Hẹbrọn.”<verse eid="2SA 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2" />Minna kw'Devid obin ozeng za, otima panọng pẹ afa kw'ode Ahinoam kw'ofon Jẹzrẹl, ọmaana Abigẹl kw'ode opokwa kw'Nabal kw'ofon Kaamẹl. <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />Devid obir otima ajinọng p'uwa aning amaan-ẹ maphyir ttara isọhmmọr sabẹ, mad-asi oruk kwabẹ z'ibhon s'ining z'Hẹbrọn. <verse eid="2SA 2:3" /><verse number="4" style="v" sid="2SA 2:4" />Nya kw'uwa anọng p'Juda makebh Devid, mabyeng-ẹ ana k'eso, masẹ-ẹ ọvaarnọng kw'ẹkọma ch'Juda.</para>
  <para style="p" vid="2SA 2:4">Matek Devid bẹ́, “Anọng p'Jabẹsh-Gilead bọ anọhng Saul e.” <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />Devid ọtọhm ẹkkaabha ọnang bẹ bẹ́, “Tte Ọvaar Ibinọkpaabyi odo bọnga k'ikpukpobha s'manang Saul, ch'manọhng-ẹ mach'ttatta kwabọnga. <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />Tte Ọvaar Ibinọkpaabyi osi ọphyaam ọnang bọnga, obir ọkọhka bọnga ọdaakẹ kwẹ. Kaam m'mbir nsi ọkkọkka nnang bọnga k'ọttọhk f'masi ma. <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />Màgaangẹ ifor, mabir abar nttem! Saul kw'ode ttatta kwabọnga, kk'ọpa. Anọng p'Juda kk'aam ana abyenga k'eso bẹ́, nde ọvaarnọng kwabẹ.”<verse eid="2SA 2:7" /></para>
  <para style="s1">Ọsọhm kw'Devid ọmaana kw'Saul maning k'egbong</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />M'ogbe nwa, wa Abnẹr kw'ode nnwa kw'Nẹr wọ ode oso kw'agbongnọng p'Saul. Kẹ wọ uwa ọtọk Ish-Boshẹt kw'ode nnwa kw'Saul, otima ochina z'Mahanayim, <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />ọsẹ-ẹ ọvaarnọng kw'ọbaabh Gilead, ọmaana Ashur, ọmaana Jẹzrẹl, ọmaana Ephraim, ọmaana Bẹnjamin, ọttara ẹkọma ch'Israẹl maphyir.<verse eid="2SA 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10" />Wa Ish-Boshẹt kw'ode nnwa kw'Saul ode icho arọbh afa ch'ọtọm ẹbaabha ch'Israẹl. Wa ọbaabh bẹ k'icho ifa. Okenaka, wa efona ch'Juda etor ẹkaan ch'Devid. <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />Wa Devid orukọ ny'Hẹbrọn ọbaabha efona ch'Juda k'icho ichenọmfa ọmaana aphe achadanẹ.<verse eid="2SA 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />Abnẹr nnwa kw'Nẹr, ọmaana ajinọng p'Ish-Boshẹt nnwa kw'Saul, mabina ny'Mahanayim machina z'Gibeọn. <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />Joab kw'ode nnwa kw'Zeruya ọmaana ajinọng p'Devid, mabina ad-akebha bẹ z'esipe ch'Gibeọn. Ẹkaan danẹ eninga ẹwọr k'ẹbhaakẹ danẹ ch'esipe ndo, ẹkaan ndoza eninga z'ẹbhaakẹ ndoza ch'esipe ndo.<verse eid="2SA 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 2:14" />Abnẹr oben Joab bẹ́, “Tte ajinọngva banẹ pamina abina ayoma ayok mbọhk m'amina k'ititika.” Joab ọpọhna bẹ́, “Ojibh-ojibh! Tte mabina asi minna.”<verse eid="2SA 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15" />Minna kw'mabin, mabhik anọng ijobh kkamfa p'Bẹnjamin, ọmaana p'Ish-Boshẹt, nnwa kw'Saul. Mabir abhik anọng ijobh kkamfa p'Devid. <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />Nya o, ọnọng-ọnọng obina, ọbọka orima-nọng kwẹ ny'eso, okwum-ẹ ọmaananwa ny'ọbhọribom, matọn atto nya, mape. Ofona nya, mayerẹ ibyi njo s'ining ny'Gibeọn bẹ́, Helkat Hazurim<note caller="+" style="f"><char style="fr" closed="false">2.16 </char><char style="fq" closed="false">Helkat Hazurim: </char><char style="ft" closed="false">Ose kw'Helkat Hazurim oyinẹ k'eHiburu, ọnọng makpaar kọttaanẹ. Okenaka, anwẹr banẹ mabenẹ bẹ́, oyinẹ bẹ́, Izek s'akkangkkang, wanẹma, Izek s'ẹkọhr. </char></note>.<verse eid="2SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />Ny'ewu ndo, egbong ẹkọmọ mawuriji maa, Devid okema Abnẹr ọmaana anọng p'Israẹl.<verse eid="2SA 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 2:18" />Wa iva attaan p'Zeruya p'ade Joab, ọmaana Abishayi ọmaana Asahẹl maning nya. Asahẹl wa ogwengẹ mach'otenwurọ. <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />Asahẹl okwubh Abnẹr itọhngayong. <verse eid="2SA 2:19" /><verse number="20" style="v" sid="2SA 2:20" />Abnẹr ọbhakẹ nnam ọbọbh Asahẹl bẹ́, “Asahẹl kọ wọ o?”</para>
  <para style="p" vid="2SA 2:20">Asahẹl ọpọhn-ẹ bẹ́, “Iye, kaam wọ e.”<verse eid="2SA 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21" />Minna kw'Abnẹr oben-ẹ bẹ́, “Bhakẹ kkerẹ odimbọhk, wanẹma, obhurubọhk, abọka ojinọngnwa wanẹ anẹ-ẹ egbongkpo pyẹ.” Asahẹl ochina ororo okwubh-ẹ mach'okwubhọ nya.<verse eid="2SA 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22" />Abnẹr obir oben Asahẹl bẹ́, “Ọdọk kaam kakwubh. Kaam kìnnorọ bẹ́, mfhọ-ọ. Ḿfhọ-ọ nya, yen kw'im'nzenga nkkerẹ agbaanatte Joab k'ititika?”<verse eid="2SA 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 2:23" />Asahẹl kocher bẹ́, ọkpọka Abnẹr okwukwubh. Minna kw'Abnẹr okwum-ẹ ọkọhn ny'ẹbhọr oyin z'nnam. Asahẹl otto, ope ny'eninga ndo. Ọnọng kpenamkpen kw'opyirẹ nya ch'Asahẹl ope oyima, obe nya oze.<verse eid="2SA 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />Joab ọmaana Abishayi makwubh Abnẹr. K'ogbe kw'ewu min'ẹsa, mapyirẹ z'egbe ch'Amma ch'ẹnyọm Giya ny'eden ch'ibyi s'anọng nna arukọ z'Gibeọn. <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />Minna kw'ajinọng p'Bẹnjamin magbak amaana Abnẹr, mabina k'ẹrọng mach'ẹkaan madanẹ, mabe k'ogbeso wanẹ.<verse eid="2SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26" />Abnẹr okwu oyerẹ Joab oben-ẹ bẹ́, “Ma, kwuna egbong nda m'erima ttattampe o? Ma, kọ kazong bẹ́, ẹkpọka ch'egbong nda m'ekem epyibha o? Ogbe m'obhir otuma yen pira aben anọng pọ bẹ́, makpọka ivotte okwukwubh?”<verse eid="2SA 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27" />Joab ọpọhna bẹ́, “K'ose kw'Ibinọkpaabyi orukọ akpen, wura ina ẹmọng asi, wura ajinọng mbo achin ororo akwubh ivotte maa, opyirẹ ophyinẹ k'ekpebha.”<verse eid="2SA 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 2:28" />Ofona nya, Joab oje enyisa, ajinọng mbo maphyir makpọka anọng p'Israẹl okwukwubh, mabir akpọka egbong oririma.<verse eid="2SA 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29" />Ny'orungiwu nwo maphyir, Abnẹr ọmaana anọng pẹ mazenga ny'Araba, majeka ọraanga kw'Jọrdan, mazenga achina ororo ny'ekpebha maa, mapyirẹ Mahanayim.<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />Minna kw'Joab nọkpọk Abnẹr okwukwubh, otobha agbongnọng maphyir. Wa agbongnọng p'Devid anọng osowanẹ kw'ẹrọbh adim-odimẹ, agbaarẹ Asahẹl abharẹ. <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />Okenaka, wa agbongnọng p'Devid kk'anọng p'Bẹnjamin arọbh ichi kkanttaan okwuma ichi p'aning amaana Abnẹr, afha. <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />Matọka Asahẹl anọhnga z'epekwuk ch'otte, z'Bẹtẹlẹhẹm. Minna kw'Joab ọmaana anọng pẹ mazeng ny'orungiwu nwo kibungọ maa, mapyirẹ Hẹbrọn k'owusobha.<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1" />Wa egbong ch'ọsọhm kw'Saul ọmaana ch'ọsọhm kw'Devid ening k'ogbe kw'okem ebhira. Ọsọhm kw'Devid ọgaangẹ ochina ororo, ọsọhm kw'Saul z'okwubha ọmọm ochina ororo.<verse eid="2SA 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2" />Wa panọng p'Devid mamaanẹ Devid ajinọngva z'Hẹbrọn.</para>
  <para style="li1" vid="2SA 3:2">Ochedennwa kwẹ wa okpen Amnọn, kw'ode nnwa kw'Ahinoam kw'ofon Jẹzrẹl ọmaan-ẹ.<verse eid="2SA 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="2SA 3:3" />Kw'ottong afa okpena Kilẹab. Abigẹl kw'ode opokwa kw'Nabal kw'ofon ẹkọma ch'Kaamẹl wọ ọmaan-ẹ.</para>
  <para style="li1" vid="2SA 3:3">Kw'ottong attaan okpen Absalọm kw'ode nnwa kw'Maaka, kw'ode ominanwa kw'Talmayi, ọvaarnọng kw'Geshur.<verse eid="2SA 3:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="2SA 3:4" />Ojinọngnwa kw'ottong ana ode Adonija kw'ode nnwa kw'Hagit.</para>
  <para style="li1" vid="2SA 3:4">Kw'ottong achen ode Shẹphatiya kw'ode ojinọngnwa kw'Abital.<verse eid="2SA 3:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="2SA 3:5" />Kw'ottong achadanẹ okpen Itreyam, kw'Ẹgla kw'ode kwanọng kw'Devid ọmaanẹ.</para>
  <para style="p" vid="2SA 3:5">Wa mamaanẹ Devid iva mba z'Hẹbrọn.<verse eid="2SA 3:5" /></para>
  <para style="s1">Abnẹr ojek otor Devid</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />Ny'ogbe kw'ẹkọhr ndo etto ny'ọsọhm kw'Saul ọmaana ọsọhm kw'Devid, Abnẹr otima obhokọ nwo odo ẹfa oyena z'ọsọhm kw'Saul. <verse eid="2SA 3:6" /><verse number="7" style="v" sid="2SA 3:7" />Wa Saul oyen oyoknọng kw'okpen Rizpa kw'ode nnwa kw'Aiya. Ish-Boshẹt ọbọbh Abnẹr bẹ́, “Osempira ayima amaana oyoknọng kw'atte kwaam o?”<verse eid="2SA 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8" />Wa Abnẹr ọdọk-ẹ mawuriji okurọ odik kw'Ish-Boshẹt ọgbaakẹ. Ofona nya, ọpọhn-ẹ bẹ́, “Ma, ọsọ-ọ bẹ́, kaam nde ẹffa ch'ening k'ọtọhm f'anọng p'Juda yirẹ? Tọma za maa, pyirẹ m'ewu ch'menda, kaam nd-ntor atte kwọ Saul, mbir ntor ivotte pẹ ọmaana ayok-odikkobh pẹ maphyir. Kọ ọbọhk kintte bẹ́, atto k'mbọhk s'Devid. Chibhẹ nya, abọhm-m odik kw'ọmaan kwanọng nwa. <verse eid="2SA 3:8" /><verse number="9" style="v" sid="2SA 3:9" />Tte Ọvaar Ibinọkpaabyi ọnang kaam Abnẹr irem siden obir ọttar-ọttara, óde kaam ina ọttọhk f'Ibinọkpaabyi ọnwọhngọ ọnang Devid nsi, <verse eid="2SA 3:9" /><verse number="10" style="v" sid="2SA 3:10" />ch'obenẹ bẹ́, kẹ m'otinẹ ẹvaar z'ọsọhm kw'Saul okwu ottima dẹ k'ọsọhm kw'Devid, ọfha ọbaabha Israẹl ọmaana Juda tọma z'Dan maa, pyirẹ z'Beershẹba.” <verse eid="2SA 3:10" /><verse number="11" style="v" sid="2SA 3:11" />Ish-Boshẹt ọdọk Abnẹr odik kpenamkpen kokpo ọpọhna okurọ ch'Abnẹr ojor-ẹ.<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />Minna kw'Abnẹr ọtọhm azeng-eden z'Devid, mabọbh-ẹ bẹ́, “Anyi wọ oyen izek njo o? Chekẹ maan-m, ọfha nkkaan-ọ ntima anọng p'Israẹl maphyir njeka nkebh-ọ.”<verse eid="2SA 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13" />Devid ọpọhn-ẹ bẹ́, “Ojibh-ojibh. Kaam m'nchekẹ mmaan-ọ. Okenaka, tte mphyem-ọ ọttọhk mavanẹ: kọ k'ititika saam kàkwu, oye bẹ́, atim Mikal kw'ode ominanwa kw'Saul akwu aze-m.” <verse eid="2SA 3:13" /><verse number="14" style="v" sid="2SA 3:14" />Nya o, Devid ọtọhm azeng-eden bẹ́, mata z'Ish-Boshẹt kw'ode nnwa kw'Saul maben-ẹ bẹ́, “Nang-m kwanọng kwaam Mikal kw'ikk'mkpatọr arọbh achen s'aPhilistiya ntima nnang ẹba-phya chẹ.”<verse eid="2SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15" />Minna kw'Ish-Boshẹt ọtọhm anọng mad-atọka Mikal z'odim Paltiyẹl kw'ode nnwa kw'Laish. <verse eid="2SA 3:15" /><verse number="16" style="v" sid="2SA 3:16" />Okenaka, odim otor-ẹ mafona, od-obhom ẹmọng otima otor-ẹ nnam ny'odenbhir nwo maa, pyirẹ z'Bahurim. Abnẹr oben-ẹ bẹ́, “Kpa nnam z'ikọ k'obhon.” Minna kw'ọkpa nnam ọbhana.<verse eid="2SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17" />Abnẹr ottema ọmaana asogbọhkọnọng p'Israẹl, oben bẹ bẹ́, “Ogbe kk'obhira kw'makamẹ bẹ́, masi Devid ọvaarnọng kwabọnga. <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />Ogbe nwo wọ ma e! Màsi minna, kirẹ Ọvaar Ibinọkpaabyi kk'ọnwọhnga ọnang Devid bẹ́, ‘Kaam m'nzenga k'Devid kw'ode ọtọhmnọng kwaam, nkkaana Israẹl k'mbọhk s'aPhilistiya, ọttara awawunanọng pẹ maphyir.’ ”<verse eid="2SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 3:19" />Abnẹr obir ozeng mmo ogbaak odik ọnang anọng p'Bẹnjamin. Ochina z'Hẹbrọn ọd-ọgbaak Devid ọttọhk kpenamkpen f'anọng p'Israẹl ọttara anọng p'Bẹnjamin makamẹ bẹ́, mm'asi. <verse eid="2SA 3:19" /><verse number="20" style="v" sid="2SA 3:20" />K'ogbe kw'Abnẹr otim anọng ẹrọbh pẹ okwu okebha Devid z'Hẹbrọn, Devid osok eninga chiden ọnang Abnẹr ọttara ajinọng pẹ. <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />Nya o, Abnẹr oben Devid bẹ́, “Tte ntta makpaar nd-ntobha anọng p'Israẹl maphyir nsok ttatta ọvaarnọng kwaam, mfha masi nwọhngọ amaan-ọ, ọfha abaabha ọttọhk kpenamkpen f'ọdaak-ọ.” Minna kw'Devid otte Abnẹr ọbọhk, ọbhana k'ọdaam.<verse eid="2SA 3:21" /></para>
  <para style="s1">Joab ọfhọ Abnẹr</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />Ny'eninga ndo, anọng p'Devid ọmaana Joab makwuna za ch'mayinẹ egbong. Matima ekpo py'matọk z'egbong k'ọsaabh matima akwuna. Okenaka, wa Abnẹr ọdọk Devid koning ọmaana z'Hẹbrọn okurọ bẹ́, wa Devid kk'ẹ ọbọhk ọtta bẹ́, ọbhana. Ofona k'ọdaam. <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />K'ogbe kw'Joab ọttara agbongnọng p'aning amaan-ẹ mapyirẹ, matek-ẹ bẹ́, Abnẹr kw'ode nnwa kw'Nẹr kk'ọvaarnọng okwu ọza, ọvaarnọng ọttẹ-ẹ ọbọhk ọbhana. Abnẹr ofona k'ọdaam.<verse eid="2SA 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24" />Minna kw'Joab ochin z'ọvaarnọng oben-ẹ bẹ́, “Bọng-ọttọhk f'asi ma? Abnẹr okwu okebh-ọ ma. Osempira attẹ-ẹ ọbọhk? Ma, kẹ kk'ofona! <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />Kọ azong ọnọng-kira kw'Abnẹr kw'ode nnwa kw'Nẹr ode ma. Okwu bẹ́, ọbọhr-ọ, obir ọbaana ozenga-bho kwọ, obir ozonga idik maphyir s'id-asi.”<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />Joab obina orik Devid, ọtọhm azeng-eden pẹ bẹ́, mayerẹ Abnẹr atima akwu. Matim-ẹ akpa nnam z'esi-pe ch'ening z'Sira. Wa Devid odik nwo kozong. <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />Ny'ogbe kw'Abnẹr ikk'okwuna z'Hẹbrọn, Joab otim-ẹ odim k'odonginwa wanẹ kw'ebhumma ch'ẹyaakẹ z'obhon, mach'im'ọkkabh-ẹ ayaabhẹ. Pira okwum-ẹ imaana ny'ẹbhọr, ope. Minna kw'Joab otuk obo kw'Asahẹl kw'ode ọgbaanọkka.<verse eid="2SA 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28" />K'ogbe kw'Devid nọbhaang odik nwa, oben bẹ́, “Ódik okwur izẹ s'Abnẹr kw'ode nnwa kw'Nẹr, mbọhk saam ọttara s'anọng p'ọvaarbhon kwaam, iwur-owur z'Ọvaar Ibinọkpaabyi k'ititika ttattampe. <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />Tte izẹ s'Abnẹr ikpẹkẹ Joab ọmaana ẹsọhmmọr chẹ maphyir. Tte ẹsọhmmọr ch'Joab ening ọnọng eworọ kw'im'oyena ẹbhaak, wanẹma okpokora, wanẹma ọnọng kw'otim echi ozenga, wanẹma kw'ope k'ọkkangkkang, wanẹma kw'oworọ ọchattọhk.”<verse eid="2SA 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30" />(Joab ọmaana ọgbaanotte Abishayi, mafhọ Abnẹr okurọ ch'ọfhọ Asahẹl kw'ode ọgbaanotte kwabẹ z'egbong ch'marim z'Gibeọn.)<verse eid="2SA 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />Nya o, Devid oben Joab ọmaana anọng maphyir p'aning nya amaan-ẹ bẹ́, “Màyaakẹ ekpo py'mafọr ny'ifor, mafọra abara-bina, matima isen k'ichen azenga ny'Abnẹr k'ititika.” Ọvaar Devid oyenẹ ọyakẹ mffurachi njo nnam. <verse eid="2SA 3:31" /><verse number="32" style="v" sid="2SA 3:32" />Manọhnga Abnẹr z'Hẹbrọn. Ọvaar Devid obhom Abnẹr k'ẹrọng ny'epekwuk chẹ. Anọng maphyir mabir abhom.<verse eid="2SA 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33" />Ọvaar Devid obhom eforo nda ọnang Abnẹr bẹ́:</para>
  <para style="q1" vid="2SA 3:33">“Ma, ọbaan za bẹ́, Abnẹr ope mach'oturọnọng o?<verse eid="2SA 3:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 3:34" />Ọnọng mbọhk sọ kọdabhẹ,</para>
  <para style="q2" vid="2SA 3:34">m'ikọ mgbakkọhbhọ k'mmo kake,</para>
  <para style="q1" vid="2SA 3:34">atto ape mach'ọnọng otto k'mbọhk s'abyibyanọng.”</para>
  <para style="p" vid="2SA 3:34">Anọng mbo maphyir mabir abhom-ẹ ọdọk.<verse eid="2SA 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35" />Nya o, anọng mbo maphyir makwu akwukọ Devid bẹ́, ochi ọttọhk ch'ewu etim ening. Devid ochekẹ, oben bẹ́, “Tte Ọvaar Ibinọkpaabyi ọnang-m irem siden obir ọttar-ọttara, óde nchi brẹd, obir ode ọttọhk kpenamkpen, pira ẹsọhka etto!”<verse eid="2SA 3:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 3:36" />Anọng mbo maphyir p'aning nya ake odik nwo otum, nttem ibir idaam bẹ. Ọttọhk kpenamkpen f'ọvaarnọng osi, ọdaam bẹ ettem. <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />Ofona nya, anọng mbo maphyir, ttara anọng p'Israẹl, makwu azonga ny'ewu ndo bẹ́, ọbọhk kw'ọvaar Devid ny'obo kw'Abnẹr kw'ode nnwa kw'Nẹr, koyik.<verse eid="2SA 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38" />Nya o, ọvaarnọng oben anọng pẹ bẹ́, “Bọnga nkazong bẹ́, osonọng kwiden, ọmaana ọfa-nọng kw'ọyọhng, kk'ọtta m'Israẹl menda o? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />Menda nwa, chibhẹ ch'ode kaam wọ nde ọvaarnọng kw'nkk'ana abyenga k'eso, ifor imọm-m ọmọm. Ajinọng mba p'ade iva p'Zeruya magaangẹ ayọhng-m. Tte ọvaar Ibinọkpaabyi otuka epyibha ch'opyibhanọng otor k'osisi kwẹ!”<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s1">Mafhọ Ish-Boshẹt</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />K'ogbe kw'Ish-Boshẹt kw'ode nnwa kw'Saul ọbhaang bẹ́, Abnẹr kk'ọpa z'Hẹbrọn, ẹfa ẹsẹ-ẹ, nttem ibir iyak anọng p'Israẹl maphyir odik. <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />M'ogbe nwa, wa nnwa kw'Saul oyen ajinọng afa p'uwa mad-achi egbong-kaan ch'ẹkkaam-ọkkaam eden. Oyok wanẹ okpen Baana, nwoza okpena Rekab. Wa bẹ made iva p'Rimmọn kw'ofon Berot z'ẹkọma ch'Bẹnjamin. Wa matọka Berot mach'ẹbhaakẹ danẹ ch'Bẹnjamin, <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />okurọ bẹ́, wa anọng p'Berot arọbhọ achina z'Gittaim, mad-aruk za mach'akikennọng pyirẹ menda.<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />(Wa Jonatan kw'ode nnwa kw'Saul oyen ojinọngnwa kw'ọphyakẹ mkpẹtẹ. Kẹ wa ode icho ichen k'ogbe kw'itekẹ s'Saul ọmaana Jonatan ibin z'Jẹzrẹl ikwu. Wa ọrirọka kwẹ otin-ẹ bẹ́, otim-ẹ ọrọbh. Ch'od-oduk-oduka bẹ́, ofona, ọnaang-ẹ otto, ọphyakẹ mkpẹtẹ. Wa okpen Mẹphiboshẹt.)<verse eid="2SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5" />Nya o, Rekab ọmaana Baana p'ade iva p'Rimmọn p'afon Berot mabina azeng z'ọsọhm kw'Ish-Boshẹt, makebh-ẹ ny'ọyakpattem ch'od-okwoka ọwọhng ny'ẹya ndo. <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />Madim z'idongọ ẹtaanga mach'mm'ad-atọka wit, makwum-ẹ ny'ẹbhọr. Pira Rekab ọmaana ọgbaanotte Baana, marọbh afona.<verse eid="2SA 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7" />Wa madimẹ ny'ọsọhm nwo k'ogbe kw'otim oyim ny'ebin z'ikẹ k'idongọ. Ch'nkk'ẹ akwuma mafhẹ-ẹ, makpaar-ẹ eso, matima azenga ny'eden ch'Araba ny'orungiwu maphyir. <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />Matọka eso ch'Ish-Boshẹt achena ọvaar Devid z'Hẹbrọn, maben-ẹ bẹ́, “Kirẹ eso ch'Ish-Boshẹt kw'ode nnwa kw'Saul ma, kw'ode ọwawunanọng kwọ kw'ọkamẹ bẹ́, ọfhọ-ọ. Menda nwa, Ọvaar Ibinọkpaabyi kk'odik nwo otuka ny'Saul ọmaana iva pẹ, k'eso ch'atte kwaam kw'ode ọvaarnọng.”<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />Devid ọpọhna Rekab, ọttara ọgbaanotte Baana, p'ade iva p'Rimmọn kw'ofon Berot bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi kw'ọrọhbh-m k'adikgbe kpenamkpen orukọ akpen, <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />k'ogbe kw'ọnọng okwu otek-m bẹ́, ‘Saul kk'ọpa,’ ọsẹ-ẹ bẹ́, ochen-m ẹkkaabha ọkkọkka, kaam mbọk-ẹ, mfhẹ-ẹ z'Ziklag. Ẹtaam ch'iwa nsẹ-ẹ k'ẹkkaabha chẹ dọ nya. <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />M'ntera nsi nyọhng-ọyọhnga, k'ogbe kw'abyibyanọng akebh ọnọng kw'otor-otor z'ebin, z'ikẹ k'ọsọhm afhọ. Ọbaan bẹ́, nnor izẹ sabẹ mbọbh bọnga, mbir ndimẹ bọnga eche m'iyagbin!”<verse eid="2SA 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12" />Nya o, Devid oke ajinọng pẹ ẹfa, mafhọ Rekab, ọmaana Baana. Makpaara bẹ mbọhk ọmaana mmokpatọkọ. Matọka aforbukọ pabẹ arena atuma esipe z'Hẹbrọn. Okenaka, matọka eso ch'Ish-Boshẹt anọhnga z'epekwuk ch'Abnẹr z'Hẹbrọn.<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s1">Masi Devid ọvaarnọng kw'Israẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />Nya o, mfonamma s'Israẹl maphyir ikwu ikebha Devid z'Hẹbrọn, maben-ẹ bẹ́, “Mina mode anọng pọ oyenẹ. <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />Z'ogbe kw'ikk'ọkpana, ch'iwa Saul ọbaabh mina, kọ wọ uwa ad-atima anọng p'Israẹl eden k'mgbong sabẹ. Ọvaar Ibinọkpaabyi okwu oben-ọ bẹ́, ‘Kọ wọ im'akkerẹ anọng paam Israẹl, abir ade ọvaarnọng kwabẹ.’ ”<verse eid="2SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3" />K'ogbe kw'asogbọhkọnọng p'Israẹl maphyir nkk'ọvaar Devid akebha z'Hẹbrọn, Devid ochekẹ ọmaana bẹ z'Hẹbrọn ny'Ọvaar Ibinọkpaabyi k'ititika. Mabyeng-ẹ ana k'eso, masẹ-ẹ ọvaarnọng kw'Israẹl.<verse eid="2SA 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4" />Wa Devid ode icho ẹrọbh okwuma ijobh k'ogbe kw'masẹ-ẹ ẹvaar, ọbaabha k'icho arọbh afa. <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />Z'Hẹbrọn, wa Devid ọbaabh Juda k'icho ichenọmfa, ọmaana aphe achadanẹ. Z'Jẹrusalẹm, ọbaabha Israẹl kibungọ, ọmaana Juda k'icho ẹrọbh okwuma ijobh kkanttaan.<verse eid="2SA 5:5" /></para>
  <para style="s1">Devid orim egbong okema Jẹrusalẹm</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />Ọvaar Devid ọmaana anọng pẹ machin z'Jẹrusalẹm bẹ́, mad-arima egbong amaana anọng p'ẹkọma ch'Jebus p'arukọ ny'izek njo. Anọng p'Jebus mabenẹ Devid bẹ́, “M'obhon nwa makpo adim. Akpichennọng ọmaana aphyaak-mkpẹtẹ bẹ-bẹ bọ mm'akwubh-ọ.” Wa mad-achibhẹ bẹ́, “Devid ma mokpo odim.” <verse eid="2SA 5:6" /><verse number="7" style="v" sid="2SA 5:7" />Okenaka, Devid ọbọka ifabyi s'Zayọn, kw'ode ebhondim ch'Devid.<verse eid="2SA 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8" />Ny'ewu ndo, Devid oben bẹ́, “Ọnọng kpenamkpen kw'im'okema anọng p'Jebus, m'ozenga k'okekamma orima aphyaak-mkpẹtẹ mbo, ọmaana akpichennọng p'ade awawunanọng p'Devid. Kẹ wọ osi mad-agbaak ẹzẹmẹ bẹ́, ‘Aphyaak-mkpẹtẹ, ọmaana akpichennọng z'odimpa madim.’ ”<verse eid="2SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9" />Minna kw'Devid orukọ ny'ifabyi njo, oyerẹ sẹ bẹ́, Ebhondim ch'Devid. Osi ebhondim ndo ọkọbh-ọkọbha, tọma z'etumọ tima dim ẹtaang-ẹtaanga. <verse eid="2SA 5:9" /><verse number="10" style="v" sid="2SA 5:10" />Oyena ẹfa ochina ororo okurọ bẹ́, wa Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir, oning ọmaan-ẹ.<verse eid="2SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11" />Hiram kw'ode ọvaarnọng kw'Taya ọtọhm atọhmnọng pẹ z'Devid, matima achikwuma p'echi ch'sida, obir ọtọhm agwọhr-agbaaka, mad-asi odimpa kw'Devid. <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />Nya o, Devid okwu ozonga bẹ́, Ọvaar Ibinọkpaabyi kk'ẹ ọvaarnọng kw'Israẹl ọsa, obir osi ẹkọma chẹ ch'ọbaabh ekpobha, okurọ anọng p'Israẹl.<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />K'ogbe kw'Devid ikk'obina z'Hẹbrọn, ochina ororo oyena ayok-nọng, obir ọtọka panọng k'ọsaabh ny'Jẹrusalẹm, p'mamaan-ẹ ajinọngva, ọttara panọngva. <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />Iva p'uwa obhonọ z'Jẹrusalẹm made Shamua, ọmaana Shobab, ọmaana Natan, ọmaana Sọlọmọn, <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />ọmaana Ibhar, ọmaana Ẹlishua, ọmaana Nẹphẹg, ọmaana Japhia, ọmaana <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />Ẹlishama, ọmaana Ẹliada, ọttara Ẹliphẹlẹt.<verse eid="2SA 5:16" /></para>
  <para style="s1">Devid okem aPhilistiya</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />K'ogbe kw'aPhilistiya mabhaang bẹ́, nkk'Devid ẹvaar ch'Israẹl adibha, bẹ maphyir matima ẹfa abina, mad-aror-ẹ bẹ́, mabọk-ẹ. Devid ọbhaang nya o, obina ochina z'ifabyi. <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />Ny'ogbe nwo, aPhilistiya nkk'akwa anyaama ny'ilokodo s'Rẹphayim maphyir. <verse eid="2SA 5:18" /><verse number="19" style="v" sid="2SA 5:19" />Minna kw'Devid ọbọbh Ọvaar Ibinọkpaabyi bẹ́, “Ma, nzọhng nd-nrima aPhilistiya ábẹ̀ o? Ma, ina nkema bẹ yirẹ?”</para>
  <para style="p" vid="2SA 5:19">Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Zọhng! K'odik ọkkọkka, kaam m'ntọka aPhilistiya nkọ-ọ k'mbọhk.”<verse eid="2SA 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20" />Minna kw'Devid ochin z'Baal-Pẹrazim, od-okema bẹ za. Oben bẹ́, “K'ose kw'ẹnwanwa ẹd-ẹphaakẹ k'ibyi, minna kw'Ọvaar Ibinọkpaabyi kk'awawunanọng paam ọkpa m'ititika saam.” Ofona nya, mayerẹ ibyi njo bẹ́, Baal-Pẹrazim<note caller="+" style="f"><char style="fr" closed="false">5.20 </char><char style="fq" closed="false">Baal-Pẹrazim </char><char style="ft" closed="false">oyinẹ bẹ́, Ọvaar kw'od-odwu-odwu.</char></note>. <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />Minna kw'aPhilistiya mbo mabin arik akpata pabẹ nya. Devid ọmaana anọng pẹ, matinẹ akpata mbo atima afona.<verse eid="2SA 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22" />APhilistiya mbo mabir akwu, manyaamẹ ny'ilokodo s'Rẹphayim. <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />K'ogbe kw'Devid ọd-ọbọbh Ọvaar Ibinọkpaabyi, ọpọhn-ẹ bẹ́, “Ọdọk bẹ ititika-ititika kàkwubh. Zenga nnam-nnam, akọbh bẹ ake k'ettem, pira narim bẹ ábẹ̀ ny'ititika kw'nchi s'balsam. <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />K'ose kw'abhubhaanga ntọkọ ch'izeng ny'achiso p'balsam, sẹr-ọsẹr, okurọ bẹ́, noyinẹ bẹ́, Ọvaar Ibinọkpaabyi kk'ọ eden ọcha bẹ́, ọd-ọfhọ agbongnọng p'Philistiya.” <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />Minna kw'Devid osi k'ose kw'Ọvaar Ibinọkpaabyi oben-ẹ, ọfhọ aPhilistiya mbo maphyir, tọma z'Geba maa, pyirẹ z'Gẹzẹr.<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s1">Matim Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi adim z'Jẹrusalẹm</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />Devid obir otobha ajinọng p'Israẹl maphyir p'agbọhk-ọgbọhkọ, anọng nnọhna arọbh attaan okwuma ichi. <verse eid="2SA 6:1" /><verse number="2" style="v" sid="2SA 6:2" />Kẹ ọttara ajinọng pẹ maphyir mazeng z'Baala-Juda bẹ́, mad-atọka Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi za. Mad-ayerẹ ẹkkọhbhọ ndo k'eche ch'Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir kw'ọnan ẹvaar-ẹvaar ny'njeka kw'acherubim. <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />Matọka Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi manana k'ọkpaar ọbhakwẹ kw'nnyanya id-itọr, matima abina z'Abinadab k'ọsọhm kw'uwa oning k'egbe. Iva p'Abinadab, p'ade Uza ọmaana Ahio bọ uwa nd-akkerẹ ọkpaar ọbhakwẹ nwo, <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi ẹnana nya. Ahio od-ozenga ochi Ẹkkọhbhọ ndo eden.<verse eid="2SA 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 6:5" />Wa Devid, ọmaana anọng p'Israẹl mad-atima ẹfa chabẹ maphyir masi odidaama ny'Ọvaar Ibinọkpaabyi k'ititika, ttara ọkkọhna kw'agim-ogim, ọmaana agaang, ọmaana mgbangbangkpa, ọmaana ndimẹ ọttara achichaak.<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />K'ogbe kw'mapyirẹ z'ọgbaarẹ kw'Nakọn, kw'mad-aninga aduk barli, Uza onemẹ ọbọhk ọbọka Ẹkkọhbhọ ndo ch'Ibinọkpaabyi, okurọ ch'abhaam p'ayaarẹ Ẹkkọhbhọ ndo masir bẹ́, matto. <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" />Minna kw'ettem epyibhẹ Ọvaar Ibinọkpaabyi ẹmaana Uza okurọ ch'osi ọttọhk f'ọlẹk-ẹ. Ibinọkpaabyi obin-ẹ ọfhọ, ope ny'okikaan kw'Ẹkkọhbhọ ndo ch'Ibinọkpaabyi.<verse eid="2SA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 6:8" />Ofona nya, Devid ọdọk-ẹ mawuriji okurọ ch'Ọvaar Ibinọkpaabyi otim ottempyibha otor Uza. Mayerẹ ibyi njo bẹ́, Pẹrẹz-Uza<note caller="+" style="f"><char style="fr" closed="false">6.8 </char><char style="fq" closed="false">Pẹrẹz-Uza </char><char style="ft" closed="false">oyinẹ bẹ́, ottempyibha kw'Ibinọkpaabyi ọmaana Uza.</char></note>, tọma za maa, pyirẹ m'ewu ch'menda.<verse eid="2SA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9" />Ny'ewu ndo, Devid oning k'ojora f'Ọvaar Ibinọkpaabyi, oben bẹ́, “Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi m'ezenga yen eninga ẹmaana kaam o?” <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />Wa Devid ifor kodo bẹ́, otima Ẹkkọhbhọ ndo okwuna z'ebhondim ch'Devid. Wa noter ọtọka Ẹkkọhbhọ ndo osok z'ọsọhm kw'Ọbẹd-Edom kw'ofon Git. <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi eyima z'ọsọhm kw'Ọbẹd-Edom kw'ofon Git k'aphe attaan. Ọvaar Ibinọkpaabyi odo Ọbẹd-Edom, ọmaana ẹsọhmmọr chẹ kibungọ.<verse eid="2SA 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12" />Nya o, matek ọvaar Devid bẹ́, “Ọvaar Ibinọkpaabyi kk'ẹsọhmmọr ch'Ọbẹd-Edom ọda, ttara ọttọhk kpenamkpen f'oyen okurọ Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi.” Ofona nya, Devid otima odidaama obina bẹ́, od-otinẹ Ẹkkọhbhọ ndo z'ọsọhm kw'Ọbẹd-Edom otima ochina z'ebhondim ch'Devid. <verse eid="2SA 6:12" /><verse number="13" style="v" sid="2SA 6:13" />K'ogbe kw'ayok p'atọhk Ẹkkọhbhọ ndo ch'Ọvaar Ibinọkpaabyi nkk'ntọkọ ichadanẹ asọbha, otima ọbhaamdim, ọmaana ọbhaamnwa kw'ode ifor <char style="it">ma dọrọdọrọ, </char> ọfọhnọ ẹja. <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />Devid ọfọra ẹphọd, pira notim ẹfa chẹ maphyir otubh ebin ny'ititika s'Ọvaar Ibinọkpaabyi. <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />Kẹ, ọmaana anọng p'Israẹl maphyir mad-akwọhrọ amọng, mabir aje nnyisa, matima Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi akwuna.<verse eid="2SA 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16" />K'ose kw'mad-atima Ẹkkọhbhọ ndo adim-odim ny'ebhondim ch'Devid, Mikal kw'ode ominanwa kw'Saul ozenga ny'ọmma kw'ofum, oze bẹ. Ch'oze ọvaar Devid ch'od-ogbe, obir otubh ebin ny'Ọvaar Ibinọkpaabyi k'ititika, ọgbẹr-ẹ idik.<verse eid="2SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17" />Matima Ẹkkọhbhọ ch'Ọvaar Ibinọkpaabyi akwuna. Masok dẹ z'ibyi sẹ z'ẹtaanga kw'ikkira s'Devid ikk'ottima osok dẹ. Devid ọfọhnọ nja s'ẹkwọmọ, ọmaana s'etobha ny'Ọvaar Ibinọkpaabyi k'ititika. <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />K'ogbe kw'kk'nja s'ẹkwọmọ, ọmaana s'eforgbaka ọfọhna maphyir, osi anọng mbo ittabọhng k'eche ch'Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir. <verse eid="2SA 6:18" /><verse number="19" style="v" sid="2SA 6:19" />Nya o, ọtọka ebrẹd-duk, ọmaana okebh f'eten, ọttara igbogbo s'matim aduk p'fig asi, ọnang anọng p'Israẹl maphyir p'aning nya, ajinọng ọmaana panọng. Minna kw'ọnọng-ọnọng ọbhan z'ikẹ k'ọsọhm.<verse eid="2SA 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20" />K'ogbe kw'Devid nokwun bẹ́, osi ẹsọhmmọr chẹ ittabọhng, Mikal kw'ode nnwa kw'Saul okwu okebh-ẹ nya, oben-ẹ bẹ́, “Menda ọvaarnọng kw'Israẹl okpobh ifor sẹ mawuriji, ch'otim erinikwum od-otubh ebin ny'ititika s'abira-minava p'atọhmnọng pẹ mach'odingidingẹ!”<verse eid="2SA 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21" />Devid ọpọhn-ẹ bẹ́, “Kaam ntubhọ ebin ndo k'ititika s'Ọvaar Ibinọkpaabyi kw'ina atte kwọ otek, ọnọng kpenamkpen ny'ọsọhm kwẹ kobir oteka, oter oteka kaam, osi-m ọvaarnọng kw'anọng p'Ọvaar Ibinọkpaabyi. Kaam m'nsi odidaama ny'Ọvaar Ibinọkpaabyi k'ititika. <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />Kaam m'ntera nlẹkẹ ifor saam nyọhnga ma, mbir nsak-m ifor eninga. Okenaka, z'ititika s'abira-minava pad-aben ma, mm'anang-m ikpukpobha ọnang e.”<verse eid="2SA 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23" />Wa Mikal kw'ode nnwa kw'Saul nnwa kọmaanẹ maa, ope.<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s1">Ibinọkpaabyi ochekẹ ọnang Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />K'ogbe kw'uwa ọvaar Devid ikk'oruka z'ikẹ k'ọvaarter, Ọvaar Ibinọkpaabyi obir ọsẹ-ẹ oruk k'ẹmẹm ọmaana awawunanọng pẹ maphyir p'abaabh-ẹ ọbaabha, <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />Devid oben Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi bẹ́, “Kaam nrukọ k'ọsọhm kw'matim agbaaka p'sida asi, Ẹkkọhbhọ ch'Ibinọkpaabyi etera eninga z'ikkira.”<verse eid="2SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3" />Natan ọpọhna ọvaar Devid bẹ́, “Zọhng, ad-asi ọttọhk kpenamkpen f'oning-ọ z'ettem; kirẹ Ọvaar Ibinọkpaabyi oning nya ọmaan-ọ.”<verse eid="2SA 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4" />Ny'orungiwu nwo, Ọvaar Ibinọkpaabyi ọtọhm ẹkkaabha ọnang Natan bẹ́,<verse eid="2SA 7:4" /></para>
  <para style="pm">
    <verse number="5" style="v" sid="2SA 7:5" />“Zọhng ben Devid kw'ode ọtọhmnọng kwaam bẹ́, ‘Kaam Ọvaar Ibinọkpaabyi mbenẹ bẹ́, kọ azang m'asi ọsọhm kw'im'nruk. <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />Tọma za ch'nrọhbh anọng p'Israẹl z'Ijip maa, pyirẹ menda, kaam k'ọsọhm kinrukọ. Kaam nd-ntima ikkira nzenga mach'nzeng nya mach'iruk-byi saam. <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />K'ibyi kpenamkpen s'ikk'mkpaanga mmaana anọng p'Israẹl, ọbaabh kw'nke ẹfa bẹ́, ọbaabha anọng paam p'Israẹl kode kw'ikk'mbena bẹ́, Osempira ọsọhm kw'matim nchi s'sida kasi anang-m?’<verse eid="2SA 7:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="2SA 7:8" />“Ofona nya, tek Devid kw'ode ọtọhmnọng kwaam bẹ́, ‘Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir obenẹ bẹ́, kaam ntọk-ọ z'ẹgba, za ch'ad-akkerẹ arọkimaan, nsọ-ọ ọbaabh kw'anọng paam, Israẹl. <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />Kaam kk'nninga mmaan-ọ k'ibyi kpenamkpen s'ata, mfhọ awawunanọng pọ maphyir p'ad-ayak-ọ odik. Nya o, kaam m'nsọ-ọ ayin eche mach'anọng p'ayinẹ eche ọtam m'iyagbin. <verse eid="2SA 7:9" /><verse number="10" style="v" sid="2SA 7:10" />Kaam m'nnang anọng paam Israẹl ibyi s'mm'asi obhon kwabẹ, mfha mayena iruk-byi sabẹ, ọnọng oning ọdọk bẹ odik ọyakẹ. Abyibyanọng ọdọk bẹ irem mànang k'ose kw'uwa mad-asi bẹ z'ẹtọma, <verse eid="2SA 7:10" /><verse number="11" style="v" sid="2SA 7:11" />mabir ad-asi tọma z'ogbe kw'ntek anọng bẹ́, mabaabha anọng paam Israẹl. Kaam m'mbir nsi awawunanọng pọ marọhbh-ọ ichen, ọfha aruk k'ẹmẹm.</para>
  <para style="pm" vid="2SA 7:11">“ ‘Ọvaar Ibinọkpaabyi wọ od-ozeng mmo otek-ọ ma bẹ́, m'ottima ọsọhm ọnang-ọ. <verse eid="2SA 7:11" /><verse number="12" style="v" sid="2SA 7:12" />K'ogbe kw'akpen pọ nkk'apyira k'ẹkpọka, ad-akebha ab'ttatta pọ z'offurabhon, nya kw'kaam m'nrọhbha nnwa wanẹ kw'obin ny'ntaak sọ, okwu ọtọka eninga chọ. Kaam m'nsi ẹvaar chẹ ettima. <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />Kẹ wọ im'osi ọsọhm ọnang-m. Kaam m'mbir nsi ẹvaar chẹ ettima ttattampe. <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />Kaam m'nde otte kwẹ, kẹ m'ode nnwa kwaam. K'ogbe kw'osi epinẹ, kaam m'mgbọbh-ẹ mach'otte ọd-ọgbọbhọ nnwa, ntima ayokinọng mgbọbh-ẹ. <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />Ṉ́nòde ọdaakẹ kwaam, kwuna ny'ikẹ k'ifor mọ̀sa, k'ose kw'uwa ọdaakẹ kw'nyen mmaana Saul ọsa, nnẹ-ẹ ẹvaar ny'ikọ k'ititika. <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />Echimma chọ, ọmaana ọvaarbhon kwọ m'obe ttattampe. Ẹvaar chọ m'ebir ettima ttattampe.’ ”<verse eid="2SA 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17" />Natan otek Devid idik maphyir s'imaan ẹyaakẹ nda.<verse eid="2SA 7:17" /></para>
  <para style="s1">Njọm s'Devid</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />Nya o, ọvaar Devid odim z'ẹtaanga kw'ikkira s'Ọvaar Ibinọkpaabyi, od-oninga ẹwọr ny'Ibinọkpaabyi k'ititika, oben bẹ́,</para>
  <para style="pm" vid="2SA 7:18">“O Ọvaar Ibinọkpaabyi kw'Ọyọhng. Kaam nde anyi, echimma chaam ebir ẹbanga k'ambọng, kw'achibhẹ ejibhase nda amaan-m o? <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />Kọ Ọvaar Ibinọkpaabyi kw'Ọyọhng, kk'asa minna maphyir, abir akpa nnam agbaak odik kw'im'oyin ọmaana echimma ch'kaam ọtọhmnọng kwọ z'ogbe ororo. O Ọvaar Ibinọkpaabyi kw'Ọyọhng, oyokinọng kw'ina ọttọhk áfẹ̀ ọbang, kẹ kw'agbaakẹ idik nja amaana!<verse eid="2SA 7:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="2SA 7:20" />“O Ọvaar Ibinọkpaabyi kw'Ọyọhng, bọng-odik kw'Devid m'obir ọgbaak-ọ, ch'ikọ atọm k'ẹtọma azonga ọtọhmnọng kwọ o? <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />Ọgbaakadik kwọ ọmaana ochibhẹ ọkkọkka kwọ kw'azeng ábẹ̀, asi ẹyaakẹ ch'odik katam nwa, anang kaam ọtọhmnọng kwọ.<verse eid="2SA 7:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="2SA 7:22" />“O Ọvaar Ibinọkpaabyi kw'Ọyọhng! Kọ abarẹ ẹfa mawuriji! Ọnọng za kode kw'ode mach'ikọ. Ibinọkpaabyi ọdọk-ọdọk kode kw'ọkpanẹ kọ, k'ose kw'nkk'ọtọhng famina otima ọbhaanga tọma z'ẹtọma. <verse eid="2SA 7:22" /><verse number="23" style="v" sid="2SA 7:23" />Bọng-anọng bọ abir ade mach'anọng pọ p'ade, p'Israẹl o? Dẹ dọ ede ẹkọma manchenẹ m'iyagbin kibungọ ch'Ibinọkpaabyi ozeng mmo obhek ọnang ifor sẹ, ozenga nya osi eche, obir osi ikkikkonọdik ọmaana ijoradik siden ọnang bẹ, k'ogbe kw'okwubhọ nkọma njoza ọttara aka pabẹ ny'ititika s'anọng pẹ p'ọkkaan z'Ijip. <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />Kọ kk'anọng p'Israẹl asa mattima mach'anọng pọ oyenẹ, ttattampe. Kọ Ọvaar Ibinọkpaabyi akwu ade Ibinọkpaabyi kwabẹ.<verse eid="2SA 7:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="2SA 7:25" />“O Ọvaar Ibinọkpaabyi, m'ogbe nwa, nkwuk-ọ bẹ́, echekẹ ndo ch'asi anang kaam ọtọhmnọng kwọ, ọttara echimma chaam, ebe ttattampe. Ototo, si k'ose kw'achekẹ, <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />ọfha eche chọ ekpobha ttattampe. Nya kw'anọng min'ad-aben bẹ́, Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir wọ ọbaabh Israẹl! Minna kw'ẹsọhmmọr ch'kaam Devid kw'nde ọtọhmnọng kwọ im'echina ororo ettima k'ititika sọ.<verse eid="2SA 7:26" /></para>
  <para style="pm">
    <verse number="27" style="v" sid="2SA 7:27" />“O Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir, Ibinọkpaabyi kw'Israẹl, kk'ẹyaakẹ ch'odik nwoma asa anang ọtọhmnọng kwọ, ch'aben-ẹ bẹ́, ‘Kaam m'nsi ọsọhm nnang-ọ.’ Nya wọ osi, ọtọhmnọng kwọ oyena ottemgaangẹ bẹ́, oze njọm njoma ọnang-ọ. <verse eid="2SA 7:27" /><verse number="28" style="v" sid="2SA 7:28" />O Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir, kọ wọ ade Ibinọkpaabyi. Obir ọbaan-ọbaana bẹ́, ọnọng okpobha ọgbaakadik kwọ. Kọ kk'idik nja acheka anang kaam ọtọhmnọng kwọ. <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />Ofona nya, nkwuk-ọ bẹ́, asi echimma ch'kaam ọtọhmnọng kwọ ittabọhng, mfha echina ororo eninga k'ititika sọ ttattampe. K'ose kw'ikọ Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir ikk'agbaaka, ittabọhng sọ m'isi ẹsọhmmọr ch'kaam ọtọhmnọng kwọ, eyena ẹda ttattampe.”<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s1">Nkema s'Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />Otum k'ogbe o, Devid okema aPhilistiya maa, m'ọdọk eso kakpo age. Ọrọhbha obhon kw'Mẹtẹg-Amma z'mbọhk s'aPhilistiya.<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />Devid obir okema anọng p'Moab. Osi bẹ mayima z'izek, pira notim edik oyoma bẹ. K'anọng attaan kpenamkpen p'oyom, ọfhọ anọng afa, orik ọnọng mawanẹ. Minna kw'uwa anọng p'Moab p'arikẹ makwu ade abira p'Devid, mabir ad-anang-ẹ ntuma.<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />Ọnọng kw'uwa Devid obir okema ode Hadadẹzẹr kw'ode ojinọngnwa kw'Rehob, ọvaarnọng kw'Zoba. Wa okem-ẹ k'ogbe kw'ofon bẹ́, obir od-osi ẹfa chẹ ẹnwọhnga z'ọraanga kw'Yupharetes. <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />Devid ọnẹ-ẹ ijaar s'nnyanya id-itọr nnọhna nna okwuma arọbh achen, obir ọnẹ-ẹ anọng p'ad-ayaar ijaar njo nnọhna arọbh afa okwuma ijobh, ọmaana agbongnọng p'izek. Ọphyakẹ mmo s'nnyanya njo maphyir s'id-iyaar ijaar njo, orik nnyanya arọbh achen.<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />K'ogbe kw'anọng p'Aram p'afon Damaskọs akwu akkaana ọvaar Hadadẹzẹr kw'Zoba, Devid ọfhọ anọng nnọhna arọbh afa okwuma ichi. <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />Wa Devid obir osok ekwurọ danẹ ch'asoja z'Aram kw'oning z'ẹkọma ch'Damaskọs. Anọng p'Aram nnakwu ade atọhmnọng pẹ, mad-anang-ẹ ntuma. Wa Ọvaar Ibinọkpaabyi ọnang Devid ekema k'ibyi kpenamkpen s'ochin.<verse eid="2SA 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7" />Devid ọtọka agbongtekgba p'gol p'asonọng p'Hadadẹzẹr, otima okwuna z'Jẹrusalẹm. <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />Obir ọtọka bronz k'ọsaabh z'Teba ọmaana Bẹrotai kw'ode ibhon s'Hadadẹzẹr ọbaabh.<verse eid="2SA 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9" />K'ogbe kw'Toi kw'ode ọvaarnọng kw'Hamat ọbhaang bẹ́, Devid kk'asoja p'Hadadẹzẹr okema maphyir, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />Toi ọtọhm Joram kw'ode ojinọngnwa kwẹ bẹ́, od-ozima ọvaar Devid, okurọ ch'okem Hadadẹzẹr k'egbong. Wa Hadadẹzẹr kk'egbong obir od-orima ọmaana Toi. Joram otima ekpo py'matim silva, ọmaana gol, ọttara brons asi, ochena Devid.<verse eid="2SA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 8:11" />Wa ọvaar Devid otte nnanga nja ọbọhk ọnang Ọvaar Ibinọkpaabyi, k'ose kw'ikk'ọsa ọmaana silva ọmaana gol p'uwa ọtọk z'nkọma maphyir s'ikk'okema, <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />s'ide ẹkọma ch'Edom, ọmaana ch'Moab, ọmaana ch'Ammọn, ọmaana ch'Philistiya, ọttara ch'Amalẹk. Wa obir ọnang Ọvaar Ibinọkpaabyi ekpo py'ọna Hadadẹzẹr kw'ode nnwa kw'Rehob, ọvaarnọng kw'Zoba.<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />Wa Devid oyinẹ eche ch'okwun egbong ch'ọfhọ anọng p'Edom nnọhna arọbh afa okwuma achen z'ilokodo s'Onung.<verse eid="2SA 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14" />Wa obir osok ekwurọ ch'asoja ch'ekkerẹ ẹkọma ch'Edom; anọng p'Edom maphyir nnakwu aninga k'ẹbaabha ch'Devid. Ọvaar Ibinọkpaabyi ọnang-ẹ ekema k'ibyi kpenamkpen s'ochin.<verse eid="2SA 8:14" /></para>
  <para style="s1">Asonọng p'Devid</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />Wa Devid ọbaabh Israẹl maphyir, ọttọhna aponga p'ator-otor, osi ejibha ọnang anọng pẹ maphyir. <verse eid="2SA 8:15" /><verse number="16" style="v" sid="2SA 8:16" />Joab kw'ode nnwa kw'Zẹruya wọ uwa ode oso kw'asoja, Jẹhosaphat kw'ode nnwa kw'Ahilud ode ọkkẹrẹ kw'idik s'ikk'iyina, <verse eid="2SA 8:16" /><verse number="17" style="v" sid="2SA 8:17" />Zadọk kw'ode nnwa kw'Ahitub, ọmaana Ahimẹlẹk kw'ode nnwa kw'Abiyata bọ uwa ade afọhn-nja; Sẹraya ode ọkkẹrẹ. <verse eid="2SA 8:17" /><verse number="18" style="v" sid="2SA 8:18" />Wa Bẹnaya kw'ode nnwa kw'Jehoyada ọbaabh anọng p'Kẹrẹt ọttara p'Pẹlẹt. Ajinọngva p'Devid made afọhn-nja.<verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s1">Devid ọmaana Mẹphiboshẹt</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />Ny'ogbe nwo, Devid ọbọbh bẹ́, “Ma, ọnọng otim orikẹ ny'ọsọhm kw'Saul, kw'im'mkpo ejibha nsi nnang k'eso ch'Jonatan yirẹ?”<verse eid="2SA 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2" />Ny'ọsọhm kw'Devid, wa oyen ọtọhmnọng wanẹ kw'Saul kw'okpen Ziba. Kẹ kw'uwa mayerẹ anang Devid. Ọvaar Devid ọbọbh-ẹ bẹ́, “Kọ wọ akpen Ziba?” Ọpọhn-ẹ bẹ́, “Iye, kaam ọtọhmnọng kwọ wọ e.”<verse eid="2SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3" />Ọvaarnọng ọbọbh-ẹ bẹ́, “Ma, ọnọng ọdọk ny'ọsọhm kw'Saul korikẹ kw'im'mkpo ejibha ch'Ibinọkpaabyi nkọhka o?” Ziba ọpọhna ọvaarnọng bẹ́, “Ojinọngnwa mawanẹ kw'Jonatan orikẹ nya kw'ọphyakẹ mkpẹtẹ.”<verse eid="2SA 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4" />Ọvaarnọng ọbọbh bẹ́, “Kẹ oyenẹ kẹ?” Ziba ọpọhn-ẹ bẹ́, “Oning z'ọsọhm kw'Makir, kw'ode nnwa kw'Amiyẹl kw'ofon Lo-Deba.”<verse eid="2SA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5" />Nya o, ọvaar Devid ọtọhm anọng z'Lo-Deba, mad-atọka Mẹphiboshẹt z'ọsọhm kw'Makir, kw'ode nnwa kw'Amiyẹl, achen-ẹ.<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />K'ogbe kw'Mẹphiboshẹt, kw'ode nnwa kw'Jonatan kw'Saul obhonọ, okwu okebh Devid, ọraka eso ọnang-ẹ k'ekpukpobha-maana. Devid oyer-ẹ bẹ́, “Mẹphiboshẹt!” Kẹ ọpọhn-ẹ bẹ́, “Ttatta, kirẹ kaam ọtọhmnọng kwọ ma e.”<verse eid="2SA 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 9:7" />Devid oben-ẹ bẹ́, “Oning-ọ ojor. K'ọkkọkka, kaam m'nsi ejibha nnang-ọ k'eso ch'atte kwọ Jonatan. Kaam m'mbir ntọka izek maphyir s'atte kwọ kwiden kw'ode Saul, nnang-ọ. Kọ min'ad-achi ọttọhk amaan-m k'okpokkoro mawanẹ k'igbe maphyir.”<verse eid="2SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8" />Mẹphiboshẹt ọraka eso oben bẹ́, “Kaam ọtọhmnọng kwọ nde anyi, kw'uwura ake ọffabukọ mach'kaam otum o?”<verse eid="2SA 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9" />Nya o, ọvaarnọng oyerẹ Ziba kw'ode ọtọhmnọng kw'Saul, oben-ẹ bẹ́, “Kaam kk'ọttọhk kpenamkpen f'ode f'Saul kw'ode atte kw'aruk ábẹ̀, ọttara ẹsọhmmọr chẹ, ntọka nnang nnwa kw'nnwa kwẹ. <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />Kọ ọmaana ajinọngva pọ, ọttara atọhmnọng pọ bọ mm'atubh owonọ anang-ẹ, mabir apha ekpo py'owonọ nwo achen-ẹ, ọfha matima akkerẹ nnwa kw'nnwa kw'atte kw'aruk ábẹ̀. Mẹphiboshẹt, kw'ode nnwa kw'nnwa kw'atte kw'aruk ábẹ̀, m'od-ochi ọttọhk ọmaan-m k'igbe maphyir.” (Wa Ziba obhonọ ajinọngva ichi, obir oyena atọhmnọng ẹrọbh.)<verse eid="2SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11" />Nya o, Ziba oben ọvaarnọng bẹ́, “Kaam ọtọhmnọng kwọ m'nsi ọttọhk kpenamkpen f'ọvaarnọng kwaam oben-m bẹ́, nsi.” Minna kw'Mẹphiboshẹt ochi ọttọhk ọmaana Devid mach'nnwa wanẹ kw'ọvaarnọng.<verse eid="2SA 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12" />Wa Mẹphiboshẹt obhonọ odikkobhnwa mawanẹ kw'okpen Mika. Anọng p'ẹsọhmmọr ch'Ziba maphyir, mabir ade atọhmnọng p'Mẹphiboshẹt. <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />Minna kw'Mẹphiboshẹt orukọ ny'Jẹrusalẹm, okurọ ch'iwa od-ochi ọttọhk ọmaana ọvaarnọng k'igbe maphyir. Kẹ wa ọpyakẹ mkpẹtẹ.<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s1">Devid okem anọng p'Ammọn</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />Otum k'ogbe o, ọvaarnọng kw'Ammọn ope. Ojinọngnwa kwẹ kw'okpen Hanun okwu ode ọvaarnọng. <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />Devid oben bẹ́, “Kaam m'nsi ejibha nnang Hanun kw'ode nnwa kw'Nahash, k'ose kw'uwa otte kwẹ osi ejibha ọnang-m.” Nya o, ọtọhm anọng bẹ́, mad-afokọ Hanun nttem k'obo kw'otte. K'ogbe kw'anọng p'Devid mapyirẹ z'obhon kw'Ammọn, <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />asonọng p'Ammọn maben ttatta kwabẹ Hanun bẹ́, “Kọ achibhẹ bẹ́, Devid ọnang atte ikpukpobha ch'ọtọhmọ anọng bẹ́, makwu afok-ọ nttem o? Kọ kaze bẹ́, ọtọhm bẹ bẹ́, makwu abaana ebhondim nda, mabir aror nden s'mm'atima akema dẹ yirẹ?” <verse eid="2SA 10:3" /><verse number="4" style="v" sid="2SA 10:4" />Ofona nya o, Hanun ọbọka anọng mbo p'Devid ọtọhmọ, ogwo bẹ ammaphyabha ẹbhaakẹ danẹ, ọkpaara anọhma pabẹ ny'ottem kw'awọriba, pira nokwubhọ bẹ mafona.<verse eid="2SA 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5" />K'ogbe kw'uwa matek Devid odik nwa, ọtọhm azeng-eden pẹ bẹ́, makwubh ajinọng mbo k'eden, okurọ ililẹkẹ katam s'manang anọng pẹ. Ọvaarnọng oben bẹ bẹ́, “Màninga z'Jẹriko maa, ammaphyabha pabọnga amen, pira makpa nnam.”<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />Ch'anọng p'Ammọn makwu azonga bẹ́, nkk'Devid asa ettem epyibh-ẹ <char style="it">matama-tama</char>, mad-ayaam agbongnọng p'izek nnọhna arọbh afa okwuma ijobh p'afon Aram, z'nkọma s'Bẹt-Rẹhob, ọmaana Zoba, ọttara ọvaarnọng kw'Maaka ọmaana agbongnọng pẹ nnọhna mfa okwuma arọbh ijobh. Mabir ayaam agbongnọng nnọhna ẹrọbh okwuma ijobh p'afon z'ẹkọma ch'Tob.<verse eid="2SA 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7" />Devid ọbhaang odik nwa nya o, ọtọhm Joab, ọmaana agbongnọng pẹ maphyir. <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />Anọng mbo p'Ammọn mado igbongfor, makwu abe k'ebhumma ch'ebhondim chabẹ. Agbongnọng p'Aram, p'nkọma s'Zoba, ọmaana s'Bẹt-Rẹhob, ọmaana s'Tob, ọttara s'Maaka, maninga kwabẹ z'ẹgba ch'ẹnyọm nya.<verse eid="2SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9" />Joab okwu oze bẹ́, agbongnọng aning-ẹ z'ititika, ọmaana z'nnam-nnam. Ofona nya o, oteka agbongnọng akkọkka banẹ ny'Israẹl bẹ́, makkerẹ ayok mbo p'Aram ichen. <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />Pira nọtọk ayok p'arikẹ ọnang Abishayi kw'ode ọgbaanotte bẹ́, otima orima anọng p'Ammọn. <verse eid="2SA 10:10" /><verse number="11" style="v" sid="2SA 10:11" />Joab oben Abishayi bẹ́, “Ó̱de anọng p'Aram agaangẹ ayọhng-m, kọ makwu akkaan-m. Okenaka, óde anọng p'Ammọn magaangẹ ayọhng-ọ, kaam m'nkwu nkkaan-ọ. <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />Gaangẹ ifor! Tte mosi erima mach'ajinọng ọnang anọng pamina, ọmaana ibhondim s'Ibinọkpaabyi kwamina. Ọvaar Ibinọkpaabyi m'osi ọttọhk f'ọdaak-ẹ.”<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />Minna kw'Joab otim agbongnọng pẹ mad-arima anọng p'Aram ábẹ̀. Anọng p'Aram arọbh arik bẹ nya. <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />K'ogbe kw'anọng p'Ammọn aze bẹ́, anọng p'Aram aning za arọbhọ, bẹ ọdọk, mabir arọbh arik Abishayi nya, machina z'ẹtaanga kw'ebhondim ndo. Nya o, Joab obina za ch'orim anọng p'Ammọn ábẹ̀, okwuna z'Jẹrusalẹm.<verse eid="2SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15" />Ch'anọng p'Aram aze bẹ́, anọng p'Israẹl kk'bẹ akema, mafona mabir ad-atobha ifor sabẹ. <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />Hadadẹzẹr ọd-ọtọka agbongnọng p'Aram, p'aning z'ọraanga okwubha kw'Yupharetes, machina z'Hẹlam. Shobak kw'ode oso kw'agbongnọng p'Hadadẹzẹr, ochi bẹ eden.<verse eid="2SA 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17" />K'ogbe kw'matek Devid odik nwa, otobha anọng p'Israẹl maphyir otima ojeka ọraanga kw'Jọrdan, ozeng z'Hẹlam. Anọng p'Aram mado igbongfor, mad-arima Devid ábẹ̀. <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />Okenaka, bẹ marọbh arik anọng p'Israẹl nya. Devid ọfhọ bẹ anọng ẹnọhna kwuma arọbh ichi p'ad-ayaar ijaar s'nnyanya id-itor, ọmaana agbongnọng p'izek nnọhna arọbh achen. Obir omuma Shobak kw'ode oso kw'agbongnọng kwabẹ ekpo maa, ope nya. <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />K'ogbe kw'avaar p'aning izek-izek kw'Hadadẹzẹr maze bẹ́, anọng p'Israẹl kk'bẹ akema, makwu asi ẹmẹm amaana anọng p'Israẹl, mabir aninga k'ẹbaabha chabẹ.</para>
  <para style="p" vid="2SA 10:19">Ofona nya o, ojora osi anọng p'Aram bẹ́, mabir ator anọng p'Ammọn egbong.<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s">Devid ọmaana Batshẹba</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />Otum ny'ọyaabhagbe, ch'avaar ad-ayin mgbong, Devid ọtọhm Joab, ọmaana atọhmnọng p'ọvaarnọng, ọttara agbongnọng p'Israẹl maphyir egbong. Mad-akema anọng p'Ammọn maphyir, mabir akọbha obhon kw'Raba ake k'ettem. Okenaka, Devid oninga ny'Jẹrusalẹm.<verse eid="2SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2" />K'ọsọhkawu wanẹ, Devid obina z'ebin, ozenga z'ipubhaang s'odimpa kwẹ, ọkọbha. Minna kw'oning ny'ipubhaang njo oze kwanọng wanẹ ch'od-ogbobha asi. Wa kwanọng nwo ojibhẹ mawuriji. <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />Devid ọtọhm ọnọng bẹ́, od-oror, ozonga ọnọng kw'kwanọng nwo ode. Ọnọng nwo oben-ẹ bẹ́, “Batshẹba azang nya, kw'ode nnwa kw'Eliyam, kwanọng kw'Uriya kw'ofon Hit o?” <verse eid="2SA 11:3" /><verse number="4" style="v" sid="2SA 11:4" />Minna kw'Devid ọtọhm azeng-eden pẹ bẹ́, mad-atọk-ẹ achen-ẹ. Okwu nya o, Devid oyim-ẹ ábẹ̀. Pira kwanọng nwo nọkpa nnam z'ikẹ k'ọsọhm. (Wa ogbe otima obhira kw'kwanọng nwo ọwọr ofor.) <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />Ophe okponga kwanọng nwo, ọtọhm ẹkkaabha otek Devid bẹ́, “Kaam kk'ibhọr ntima e.”<verse eid="2SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6" />Ofona nya o, Devid ọtọhm ẹkkaabha ọnang Joab bẹ́, “Yerẹ Uriya kw'ofon Hit nang-m.” Joab oyer-ẹ ochena Devid. <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />Ch'Uriya okwu okebh-ẹ, Devid ọbọbh-ẹ ose kw'Joab ọmaana agbongnọng maning, ọmaana ose kw'egbong ede. <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />Pira Devid noben Uriya bẹ́, “Zọhng gbobhọ mmo z'ikọ k'ọsọhm.” Minna kw'Uriya obin ny'odimpa, matima ẹtaam ch'ọvaarnọng ọnang-ẹ, ayak-ẹ nnam. <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />Okenaka, Uriya oyima ny'ebhumma ch'odimpa ttara atọhmnọng p'otte kwẹ. Z'ọsọhm kwẹ kochin.<verse eid="2SA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 11:10" />Matek Devid bẹ́, “Uriya z'ikẹ k'ọsọhm kọta e.” Ofona nya, Devid ọbọbh Uriya bẹ́, “Yina azang kw'afon z'oden-bhir akwuna ma? Yen kw'ina z'ikọ k'ọsọhm abhan o?”<verse eid="2SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11" />Uriya oben Devid bẹ́, “Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi, ọmaana anọng p'Israẹl, ọttara anọng p'Juda maning k'okkira. Atte kwaam Joab kw'ode oso kw'agbongnọng, ọmaana anọng p'ọvaarnọng kwaam mabhing k'ọyaankpa kw'mkpẹmẹ. Yen kw'kaam m'nchina z'ọsọhm nd-nchi ọttọhk, mgwo, mbir nyima kwanọng kwaam ábẹ̀ o? K'ose kw'arukọ akpen, kaam ọttọhkse mvo mìnsi!”<verse eid="2SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12" />Nya o, Devid oben-ẹ bẹ́, “Bir ninga ma k'ewu madanẹ. Ophyinẹ kaam m'nttọ-ọ ọbọhk akpa nnam.” Ofona nya, Uriya oninga ny'Jẹrusalẹm ny'ewu ndo ọttara ewu ndoza. <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />Devid oyer-ẹ, matọn achi ọttọhk, mabir agwo atuk. Devid ọnang-ẹ atuk maa, obuma. Okenaka, ny'ẹsọhka, Uriya otima obhurukpa kwẹ od-otor atọhmnọng p'otte mayima. Z'ikẹ k'ọsọhm kọbhan.<verse eid="2SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />Ny'ekpebha, Devid ọkkẹr nnwẹr ọnang Uriya bẹ́, ochena Joab. <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />Ny'nnwẹr nwo ẹtaanga, ọkkẹr bẹ́, “Sok Uriya z'igbong-titika, za ch'egbong ẹgaangẹ mawuriji. Pira nnanyaangẹ arik-ẹ, ọfha mattẹ-ẹ, ope.”<verse eid="2SA 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16" />Nya o, ch'Joab kk'ebhondim ndo ọkọbha oke k'ettem, ọtọka Uriya osok z'ẹbhaakẹ ch'ozong bẹ́, akkikkaama p'awawunanọng pẹ p'agaang-ọgaangẹ, aning. <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />K'ogbe kw'ajinọng p'ebhondim ndo mayinẹ k'iyaan, marima Joab ábẹ̀, mafhọ Uriya kw'ofon Hit, ọttara agbongnọng banẹ p'Devid.<verse eid="2SA 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18" />Joab ọtọhm ẹkkaabha, otek Devid odik kpenamkpen kw'oyinẹ z'egbong ndo. <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />Ọtọhn ozeng-eden nwo bẹ́, “Ó̱de íkk'ọvaarnọng ose kw'egbong nda ede agbaaka maphyir, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />óde ettem epyibh-ẹ, ọbọbh-ọ bẹ́, ‘Osempira matima erima anyọma ebhondim ndo minna o? Oye bọnga nkazong bẹ́, bẹ mm'aninga ny'abaaka atta ayuk o? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />Anyi wọ iwa ọfhọ Abimẹlẹk kw'Jerub-Bẹshẹt obhonọ o? Kwanọng azang oning z'ọbaaka ọbharẹ ẹtakpa ch'ẹfhẹ-ẹ z'Tẹbẹz o? Osempira manyọma etumọ minna o?’ Tek-ẹ bẹ́, ‘Nkk'Uriya kw'ode ọtọhmnọng kwọ kw'ofon Hit abir afha e.’ ”<verse eid="2SA 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22" />Minna kw'ozeng-eden nwo obin ozenga. Opyirẹ za o, otek Devid odik kpenamkpen kw'Joab ikk'ẹ ọtọhma bẹ́, ọgbaak-ẹ. <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />Ozeng-eden nwo oben Devid bẹ́, “Ajinọng mbo mana mina mkpaang. Mayinẹ akebh mina k'iyaan marima mina ábẹ̀. Okenaka, mokwubh bẹ maa, makpa nnam z'ebhumma ch'ebhondim. <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />Nya o, akkikkaama mbo matima ayuk aninga ny'abaaka, matta atọhmnọng pọ, mafhọ ajinọng banẹ p'ikọ ọvaarnọng. Odik kw'ọttar nya ode bẹ́, Uriya kw'ode ọtọhmnọng kwọ kw'ofon Hit kk'ọpa.”<verse eid="2SA 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25" />Devid oben ozeng-eden nwo bẹ́, “Ben Joab bẹ́, ‘Tte odik nwa oning-ọ odik ọyakẹ; ọnọng kw'egbong m'ẹfhọ, makpo azonga. Gaangẹ ifor rima ebhondim ndo maa, akema dẹ.’ Gbaak minna, atima ake Joab ettem.”<verse eid="2SA 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26" />K'ogbe kw'kwanọng kw'Uriya ọbhaang bẹ́, odim kwẹ kk'ọpa, obhom-ẹ, obir otima epokwa ch'odim. <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />Ọ́wọr epokwa ndo nya o, Devid otim-ẹ okwuna z'ikẹ k'ọsọhm, okwu ode kwanọng kwẹ, obir ọmaan-ẹ ojinọngnwa. Okenaka, wa osisi kw'Devid Ọvaar Ibinọkpaabyi ettem kolebhẹ.<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s1">Natan opyimẹ Devid k'itama s'osi</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />Ọvaar Ibinọkpaabyi ọtọhm Natan z'Devid. Okebh-ẹ nya o, oben-ẹ bẹ́, “Wa oyen ajinọng banẹ afa p'arukọ k'obhon wanẹ: oyok wanẹ ojibh-ẹ ojibh, oyok nwoza ode ogbugbora. <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />Oyok kw'ojibh-ẹ ojibh oyen arọkimaan ọttara abhaam k'ọsaabh. <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />Oyok kw'ode ogbugbora ọttọhk koyen kw'ọkpanẹ ọrọkimaankwa kw'ikarẹ kw'odebh-odebh. Ọgwọk-ẹ maa, okwurọ. Ọrọkimaan nwo oruk ọmaan-ẹ, ttara iva pẹ ny'ọsọhm. Mad-atọn achi ọttọhk, mabir agwo asi k'ọkkọbh mawanẹ. Obira ọd-ọttaabha ọda ny'mbọhk. Ọrọkimaankwa nwo node mach'ominanwa kw'obhon-obhon.<verse eid="2SA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4" />“Nya o, ozenga-zenga wanẹ okwu ọsaka ojibhadanọng nwo. Ojibhadanọng nwo otik arọkimaan ọttara abhaam saabhada pẹ ọjẹ. Otera ọd-ọtọka ọrọkimaankwa kw'ikarẹ kw'ogbugbora nwo, otima osi ọchattọhk ọnang ọnọng kw'ọsak-ẹ.”<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />Ettem epyibh Devid ẹmaana ọnọng nwo, oben Natan bẹ́, “K'odik ọkkọkka, k'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, ọnọng kw'osi ọttọhkse mva, ọbaan bẹ́, ope! <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />Kẹ m'otuk ọrọkimaannwa nwo igbedim nna, okurọ bẹ́, inọngkwo kozong ch'osi odik nwo.”<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />Nya o, Natan oben Devid bẹ́, “Kọ wọ ade ọnọng nwo e! Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl ọgbaakẹ: ‘Kaam mbyeng-ọ ana k'eso, akwu ade ọvaarnọng kw'Israẹl. Mbir nkkaan-ọ, nrọhbh-ọ z'mbọhk s'Saul. <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />Ntọka ẹsọhmmọr ch'atte Saul nkọ-ọ k'mbọhk, mbir ntọka panọng pẹ nnang-ọ. Nnang-ọ ẹkọma ch'Israẹl, ọttara ch'Juda bẹ́, abaabha. Ó̱de ekpo mbya maphyir ẹcham-ọchamẹ, wura nnang-ọ py'ẹyọhng nya. <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />Osempira alukọ ọgbaakadik kw'Ọvaar Ibinọkpaabyi, asi itamase nja z'ikẹ k'ititika o? Kọ wọ atim ọkkangkkang, afhọ Uriya kw'ofon Hit, atọka kwanọng kwẹ aba. <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />Ofona nya, ọkkangkkang ọdọk m'ikọ k'ọsọhm mòbina, okurọ ch'alukọ ọgbaakadik kwaam, atọka kwanọng kw'Uriya kw'ofon Hit, aba.’<verse eid="2SA 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11" />“Ma wọ ode odik kw'Ọvaar Ibinọkpaabyi ọgbaakẹ: ‘Kaam m'nzenga ny'ẹsọhmmọr chọ nsi itama ikpẹk-ọ. Kaam m'ntọka panọng pọ nnang ọnọng kw'ọnyọm-ọ, oyima bẹ ábẹ̀ ny'ọyaankpa, ny'ikọ k'ititika. <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />Kọ atubh-otubha asi odik nwo, okenaka, kaam m'nsi odik nwa k'ọyaankpa k'ititika s'Israẹl maphyir.’ ”<verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />Nya o, Devid oben Natan bẹ́, “Kaam kk'epyibha nsa z'Ọvaar Ibinọkpaabyi k'ititika.”</para>
  <para style="p" vid="2SA 12:13">Natan ọpọhn-ẹ bẹ́, “Ọvaar Ibinọkpaabyi kk'obina ọnang-ọ k'epyibha chọ. Kọ ọdọk màpe. <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />Okenaka, m'ililukọ nja s'atim ator Ọvaar Ibinọkpaabyi, ojinọngnwa nwo kw'mamaanẹ anang-ọ, m'ope.”<verse eid="2SA 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15" />Ch'Natan kk'ọbhana z'ikẹ k'ọsọhm, Ọvaar Ibinọkpaabyi ọtọhbh nnwa kw'kwanọng kw'Uriya ọmaanẹ ọnang Devid ọkọhmaana. Nnwa nwo okwu ọmmẹ-ẹ. <verse eid="2SA 12:15" /><verse number="16" style="v" sid="2SA 12:16" />Devid obhom ọkpẹkẹ Ibinọkpaabyi k'eso ch'nnwa nwo. Otim ọchattọhk, obir od-oyima ny'izek k'oforpyibha k'arungiwu k'ẹkaan. <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />Asogbọhkọnọng p'ẹsọhmmọr chẹ akonga k'ose kw'mm'abọk-ẹ obina z'izek, kocher. Ọttọhk kobir ochera ochi ọmaana bẹ.<verse eid="2SA 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 12:18" />Otum ny'ewu ch'ettong ichenọmfa, nnwa nwo ope. Ojora atọhmnọng p'Devid bẹ́, matek-ẹ bẹ́, nnwa nwo kk'ọpa. Maben bẹ́, “K'ogbe kw'nnwa nwo oning akpen, Devid ọnọng itọhng koyong, óde mọgbaak odik ọnang-ẹ. Yen kw'mm'ozenga otek-ẹ bẹ́, nnwa nwo kk'ọpa o? Okpo-okpo osi ọttọhk f'ọnọng ina ichen osokọ.”<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />Devid okwu oze bẹ́, atọhmnọng pẹ aning nya akkabhẹ ayok ayaabhẹ, otin bẹ́, nnwa nwo kk'ọpa. Ọbọbh bẹ bẹ́, “Nnwa nwo kk'ọpa o?”</para>
  <para style="p" vid="2SA 12:19">Mapọhn-ẹ bẹ́, “Iye e, kk'ọpa e.”<verse eid="2SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20" />Nya o, Devid obina z'izek, od-ogbobha asi, ọchọkọ ana, obir obhona ekpo py'ọfọr. Ochina z'ọsọhm kw'Ọvaar Ibinọkpaabyi, od-okpobh-ẹ. Ocher nya, ochina z'ikẹ k'ọsọhm, ozeng mmo oben bẹ bẹ́, manang-ẹ ọchattọhk ochi.<verse eid="2SA 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21" />Atọhmnọng pẹ mabọbh-ẹ bẹ́, “Osempira ad-asi minna? K'ogbe kw'nnwa nwo otim oning akpen, kọ atimẹ ọchattọhk, abir asọhrọ asen. Ma ch'nnwa nwo kk'ọpa, nya kw'ikọ nater abina achi ọttọhk!”<verse eid="2SA 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22" />Kẹ ọpọhna bẹ́, “K'ogbe kw'nnwa nwo oning akpen, ntimẹ ọchattọhk, mbir nsọhrọ asen, okurọ ch'nchibhẹ bẹ́, Nning ch'nsi Ọvaar Ibinọkpaabyi okwo, osok nnwa nwo akpen. <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />Okenaka, ma ch'ikk'ọpa, kayen kw'm'nchina ororo ntim ọchattọhk o? Ina mbir mkpo ntim-ẹ mkpa nnam k'akpen o? Kaam m'nkebh-ẹ za, kẹ kaam mokebha ka.”<verse eid="2SA 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />Nya o, Devid ofokọ kwanọng kwẹ Batshẹba nttem, obir oyim-ẹ ábẹ̀, ọmaan-ẹ ojinọngnwa, makpẹ-ẹ Sọlọmọn. Nnwa nwo ọdaak Ọvaar Ibinọkpaabyi. <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />Ọvaar Ibinọkpaabyi ozenga ọdaakẹ nwo ábẹ̀, ọtọhm Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi bẹ́, ọd-ọkpẹ-ẹ bẹ́, Jẹdidiya<note caller="+" style="f"><char style="fr" closed="false">12.25 </char><char style="fq" closed="false">Jẹdidiya </char><char style="ft" closed="false">k'eHiburu oyinẹ bẹ́, “Ọnọng kw'ọdaakẹ Ọvaar Ibinọkpaabyi”.</char></note>.<verse eid="2SA 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />Ny'ogbe nwo, Joab orima Raba kw'ẹkọma ch'Ammọn ábẹ̀. Ọna bẹ ọvaarbhon kwabẹ. <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />Joab ọtọhm azeng-eden z'Devid bẹ́, matek-ẹ bẹ́, “Kaam kk'Raba ábẹ̀ nrima, mbir ntọka esipe chẹ. <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />Madidanma, tobha agbongnọng mboza p'arikẹ, makọbha ebhondim ndo ake k'ettem, mabir atọka dẹ k'ẹfa. Ini minna ode, kaam m'ntọka ebhondim ndo, mbir mkpẹ-ẹ mbhuna kaam.”<verse eid="2SA 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29" />Minna kw'Devid otobh agbongnọng mbo maphyir, otima od-orima obhon kw'Raba ábẹ̀, okema wẹ. <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />Ọwọra ọvaarnọng kwabẹ ivaarkpo z'eso, mafọra kẹ Devid. Wa adọhbhiji p'ikpo njo made talẹnt mawanẹ kw'gol, ibir itima ata p'ajibh-ojibh. Wa ọtọk ekpo k'ọsaabh py'ochi k'egbong ny'ebhondim ndo. <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />Obir otima anọng p'aning nya oyin ka, ọnang bẹ itọhm s'matim akkoro p'areng asa asi, ọmaana mbaangatọhkọ, ọttara mbar. Obir osi bẹ mad-alọhkọ ididọhbh atima arọhbha ata p'isọhm osisi. Wa Devid osi minna ny'ibhon s'anọng p'Ammọn maphyir. Ocher nya, kẹ ọmaana agbongnọng pẹ maphyir makpa nnam z'Jẹrusalẹm.<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s">Amnọn ọmaana Tamar</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />Wa Absalọm kw'ode ojinọngnwa kw'Devid, oyen ọgbaanọkka kw'okpen Tamar, ojibh kwanọng. K'ogbe wanẹ, Amnọn kw'ode ojinọngnwa kw'Devid, oyena ọdaakẹ ọmaana Tamar.<verse eid="2SA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 13:2" />Amnọn kw'ode ọgbaanotte kw'Tamar oyika Tamar k'ettem maa, otto ọkọhmaana, okurọ bẹ́, wa Tamar ojinọng otim ozonga, obir ọgaang-ọgaangẹ bẹ́, oyim-ẹ ábẹ̀. <verse eid="2SA 13:2" /><verse number="3" style="v" sid="2SA 13:3" />Wa Amnọn oyen oyok-odikkobh kw'okpen Jonadab, kw'ode nnwa kw'Shimea, kw'ode ọgbaanotte kw'Devid. Jonadab ode ọnọng kw'osi nkkar mawuriji. <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />Ọbọbh Amnọn bẹ́, “Kayen kw'ikọ nnwa kw'ọvaarnọng ad-apọhka k'ifor minna k'ekpebha kpenamkpen? Tek-m kẹ.”</para>
  <para style="p" vid="2SA 13:4">Amnọn oben-ẹ bẹ́, “Tamar kw'ode ọgbaanọkka kw'Absalọm kw'mode ivotte kk'aam ọdaaka e.”<verse eid="2SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5" />Jonadab oben-ẹ bẹ́, “Zọhng yim-oyima z'ebin, asi mach'ọmmọ-ọ ọmma. Ch'iza atte m'okwu ọzọ-ọ, ben-ẹ bẹ́, ‘M'ọdaak-m bẹ́, Tamar kw'ode agbaanatte kwaam, ozeng mmo okwu osi ọchattọhk ọnang-m nchi. Tte okwu osi ọchattọhk mvo m'kaam k'ititika.’ ”<verse eid="2SA 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6" />Minna kw'Amnọn od-oyima mach'ikk'ẹ ọmma. K'ogbe kw'Ọvaarnọng okwu bẹ́, omying-ẹ, Amnọn oben-ẹ bẹ́, “M'ọdaak-m bẹ́, Tamar kw'ode agbaanatte kwaam, ozeng mmo okwu osi ọchattọhk ọnang-m nchi. Tte okwu osi ọchattọhk mvo m'kaam k'ititika.”<verse eid="2SA 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7" />Devid ọtọhm ẹkkaabha ọnang Tamar z'odimpa bẹ́, “Zọhng z'agbaanatte Amnọn k'ọsọhm, ad-asi ọchattọhk anang-ẹ.” <verse eid="2SA 13:7" /><verse number="8" style="v" sid="2SA 13:8" />Minna kw'Tamar ochin z'ọsọhm kw'Amnọn, okebh-ẹ ch'oyim-oyima. Ọtọka agwubuma ọlọhbh otima osi brẹd ny'ikẹ k'ititika. <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />Pira nọtọk oke k'ọgbangbang, ober-ẹ. Amnọn obhum ochi-chi. Oben Tamar bẹ́, “Kwubh ọnọng kpenamkpen kw'oning ma, ofona.” Minna kw'ọnọng kpenamkpen obin orik-ẹ. <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />Amnọn o, oben Tamar bẹ́, “Chen-m ọchattọhk mvo k'idongọ saam, ọfha ayọk-m-ọyọka.” Tamar ọtọka ọchattọhk mvo f'ikk'ọsa, ochena ọgbaanotte Amnọn z'ikẹ k'idongọ. <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />K'ogbe kw'ọtọk ọchattọhk mvo ochen-ẹ, Amnọn ọbọk-ẹ, oben-ẹ bẹ́, “Agbaanatte kwaam, vura kwu yima k'ebin maan-m.” <verse eid="2SA 13:11" /><verse number="12" style="v" sid="2SA 13:12" />Tamar oben-ẹ bẹ́, “Mma e, agbaanatte kwaam! Kaam k'ẹfa kàbọka. Tte ọnọng oning odikse nwa ọbhaang m'Israẹl! Obyibyattọhk mva kàsi. <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />Kaam ọmaana kọ mm'oruk yen ọmaana mgbardikse nja? Kọ m'ade mach'obyibyanọng wanẹ kw'otur-oturọ m'Israẹl. Ototo o, gbaak odik nang ọvaarnọng. Kẹ kaam eden mọkpa bẹ́, mbọ-ọ.” <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />Amnọn kẹ itọhng koyong. Oyim-ẹ ábẹ̀ k'ẹfa, okurọ ch'ọyọhng-ẹ ẹfa.<verse eid="2SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15" />Pira Amnọn nọyak ọbọhk, owuna Tamar ọyọhnga k'ose kw'okkikken ọdaak-ẹ. Amnọn oben-ẹ bẹ́, “Bina, yin k'iyaan!”<verse eid="2SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16" />Tamar oben-ẹ bẹ́, “Mma e! Ó̱de akwubh-m abharẹ z'iyaan, m'oter ode epinẹ ch'ẹbarẹ ẹyọhnga ọttọhk f'kk'aam asa ma.”</para>
  <para style="p" vid="2SA 13:16">Okenaka, kẹ itọhng koyong. <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />Minna kw'oyerẹ ọtọhmnọng kwẹ, oben-ẹ bẹ́, “Kwubh kwanọng nwa m'kaam k'ititika, agbak ọmma akpor-ẹ z'iyaan.” <verse eid="2SA 13:17" /><verse number="18" style="v" sid="2SA 13:18" />Minna kw'ọtọhmnọng kwẹ okwubh-ẹ ọbharẹ z'iyaan, ọgbak ọmma okpor-ẹ za. Wa Tamar ọfọr ewurọ ch'edum-odum, kw'ode nwurọkira s'panọngva p'ọvaarnọng p'ade akwurọ-akwurọ mad-afọra. <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />Tamar okpokọ ititọhng owona z'eso, obir ọyaakẹ owurọ-dudum kw'ọfọr z'ifor, ọtọhka mbọhk k'eso. K'ose kw'od-ozenga ofona, minna kw'obhomọ ẹmọng k'ẹrọng.<verse eid="2SA 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20" />Ọgbaanọkka Absalọm oben-ẹ bẹ́, “Ma, agbaanatte Amnọn, oyim-ọ ábẹ̀ o? Bhirẹ ẹmọng, agbaanakka kwaam. Kẹ ode agbaanatte kwọ. Odik nwa k'ettem kake.” Tamar otima oforpyibha oruk ny'ọsọhm kw'Absalọm kw'ode ọgbaanọkka kwẹ.<verse eid="2SA 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21" />K'ogbe kw'ọvaar Devid ọbhaang odik nwa maphyir, ettem epyibh-ẹ mawuriji. <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />Wa Absalọm omyi odik nwo nya <char style="it">bẹ́ sẹẹbh </char>odiktama kọgbaakẹ ọnang Amnọn, odik ọkkọkka kobir ọgbaak ọnang-ẹ. Okenaka, owuna Amnọn, okurọ ch'ọlẹkẹ Tamar, kw'ode ọgbaanọkka kwẹ.<verse eid="2SA 13:22" /></para>
  <para style="s">Absalọm ọfhọ Amnọn</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />K'ogbe kw'ikk'icho ifa ọkpana, anọng p'ad-aphyirẹ arọkimaan p'Absalọm ipyabha maning z'Baal-Hazor, za ch'ọnyọm enem ch'Ephraim. Absalọm oyerẹ ajinọngva p'ọvaarnọng maphyir bẹ́, makebh-ẹ za. <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />Ọta z'ọvaarnọng, od-oben-ẹ bẹ́, “Anọng p'ad-aphyirẹ iphyabha s'arọkimaan p'kaam ọtọhmnọng kwọ kk'awa e. Ototo, tte ọvaarnọng ọmaana adukwa pẹ makwu aninga amaan-m e.”<verse eid="2SA 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25" />Ọvaarnọng ọpọhn-ẹ bẹ́, “Mma e, nnwa kwaam. Tte mina maphyir moning ọta e. Ó̱de mina maphyir m'ọta, mm'ọnang-ọ ẹtọhka e.” Chibhẹ ch'Absalọm ọyak-ẹ odik, obe ny'odik kwẹ bẹ́, ibyi mọta. Devid okenaka ọsẹ-ẹ ittabọhng.<verse eid="2SA 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26" />Nya o, Absalọm oben bẹ́, “Zaabẹ́ kọ màta, ototo, tte Amnọn kw'ode agbaanatte kwaam ọbọhk, otor mina e.”</para>
  <para style="p" vid="2SA 13:26">Ọvaarnọng ọbọbh-ẹ bẹ́, “Kayen kw'ikẹ mm'atọn ata o?”<verse eid="2SA 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 13:27" />Minna kw'Absalọm ọgban k'odik kwẹ maa, ọvaarnọng ọtọhm Amnọn ọttara ajinọngva mboza pẹ bẹ́, mator-ẹ mata za.<verse eid="2SA 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28" />Mapyirẹ za o, Absalọm oben ajinọng pẹ bẹ́, “Màyonga itọhng! K'ogbe kw'atuk kk'Amnọn asa, óde mbenẹ bọnga bẹ́, ‘Màbin-ẹ!’ Tte oning bọnga ojor: màfhẹ makpaar. Kaam kk'bọnga ẹfa nnanga. Màgaangẹ ifor, màbir akọhka ejinọng.” <verse eid="2SA 13:28" /><verse number="29" style="v" sid="2SA 13:29" />Minna kw'ajinọng p'Absalọm masi Amnọn k'ose kw'Absalọm ikk'bẹ obena. Nya o, ajinọngva p'ọvaarnọng maphyir mavura k'nnyanya sabẹ, marọbh.<verse eid="2SA 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30" />Nya ch'matim azeng ny'eden, ẹkkaabha epyirẹ Devid bẹ́, “Absalọm kk'ajinọngva p'ọvaarnọng ọfha maphyir, ọnọng mawan-wanẹ korikẹ.” <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />Ọvaarnọng obina, ọyaakẹ ekpo py'ifor, oyima z'izek. Atọhmnọng pẹ maphyir mabir ayaakẹ ekpo pyabẹ z'ifor, maninga nya amaan-ẹ.<verse eid="2SA 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32" />Okenaka, Jonadab kw'ode nnwa kw'Shimea, kw'ode ọgbaanotte kw'Devid, oben bẹ́, “Ttatta kwaam, kàtọka bẹ́, nkk'iva p'ọvaarnọng maphyir afha. Amnọn kẹ-kẹ wọ ope e. Odik nwoma ode odik kw'Absalọm ọkam-ọkam tọma ny'ewu ch'Amnọn oyim Tamar kw'ode ọgbaanọkka kwẹ ábẹ̀ k'ẹfa. <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />Ttatta kwaam, ettem ny'ẹkkaabha ndo kayika bẹ́, iva p'ọvaarnọng maphyir kk'apa. Amnọn kẹ-kẹ wọ ope e.”<verse eid="2SA 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />Ny'ogbe nwo, wa Absalọm kk'ọrọbha.</para>
  <para style="p" vid="2SA 13:34">Ojinọng kw'od-okkerẹ oter otinẹ ichen, oze ajinọng k'ẹkaan ch'mad-abina z'obhurubọhk kw'eden, mad-asaka egbe ẹbhakẹ danẹ akwu-okwu. Okker-oter nwo ofona od-otek ọvaarnọng bẹ́, “Ttatta, nze ajinọng k'ẹkaan ch'mad-abina z'Horonem, z'ẹbhaakẹ ch'egbe mad-akwu-okwu e.”<verse eid="2SA 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 13:35" />Jonadab oben ọvaarnọng bẹ́, “Kirẹ, ajinọngva p'ọvaarnọng kk'apyira ma. Kk'oyina k'ose kw'ọtọhmnọng kwọ obenẹ.”<verse eid="2SA 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 13:36" />K'ose kw'ocher odik nwo nya, ajinọngva p'ọvaarnọng matwunga adim-odim nya, ttara amọng p'mad-abhom k'ẹrọng. Ọvaarnọng ọmaana atọhmnọng pẹ maphyir mabir abhom mawuriji.<verse eid="2SA 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37" />Absalọm ọrọbh okebha Talmayi, kw'ode ojinọngnwa kw'Amihud, kw'ode ọvaarnọng kw'Geshur. Okenaka, ọvaar Devid obhom ojinọngnwa kwẹ k'iwu k'ẹkaan.<verse eid="2SA 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 13:38" />K'ogbe kw'Absalọm kk'ọrọbha ozeng z'Geshur, oninga za k'icho ittaan. <verse eid="2SA 13:38" /><verse number="39" style="v" sid="2SA 13:39" />Wa okwu ọdaak ọvaar Devid bẹ́, wura oze Absalọm k'ichen, okurọ ch'iwa ikk'ottem-fokọ oyena k'obo kw'Amnọn.<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s1">Absalọm ọkpa nnam z'Jẹrusalẹm</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />Wa Joab kw'ode ojinọngnwa kw'Zeruya ozong-ozonga bẹ́, ọvaarnọng ọdaak-ẹ bẹ́, oze Absalọm. <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />Ofona nya, Joab ọtọhm ọnọng wanẹ z'obhon kw'mayerẹ Tẹkoa bẹ́, ọd-ọtọka kwanọng wanẹ kw'ozong odik otima okwu. Oben kwanọng nwo bẹ́, “Si ifakikona, aninga k'oforpyibha mach'ọnọng ọpọ-ọ. Fọra abarabina. Ana kpenamkpen kàchọkọ. Si mach'kwanọng kw'ifor ipyibh-ẹ opyibh, otima iwu k'ẹkaan obhom ọnọng kw'ọpẹ-ẹ. <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />Ikk'asa minna, china z'ọvaarnọng ad-agbaak-ẹ idik nja s'im'mgbaak-ọ ma.” Joab ọtọhn-ẹ ose kw'im'ọgbaak maphyir.<verse eid="2SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4" />K'ogbe kw'kwanọng nwo kw'ofon Tẹkoa opyirẹ za ch'ọvaarnọng oning, otto okwubha ititika ny'izek k'ekpukpobha-maana. Oben bẹ́, “O ọvaarnọng, kkaan-m!”<verse eid="2SA 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5" />Ọvaarnọng ọbọbh-ẹ bẹ́, “Bọng-ọttọhk vọ ọyak-ọ odik?”</para>
  <para style="p" vid="2SA 14:5">Kwanọng nwo ọpọhn-ẹ bẹ́, “Kaam nde opokwa; odim kwaam kk'ọpa. <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />Kaam ọtọhmnọng kwọ, nyen ajinọngva afa. Wa otto bẹ z'ẹgba, marima ayok ábẹ̀ k'ogbe kw'ọnọng ina ode kw'ọkaang bẹ. Oyok wanẹ obin oyok ọttọhk, ọfhẹ-ẹ. <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />Madidanma, efona chaam kibungọ nẹttaangẹ kaam ọtọhmnọng kwọ. Mad-aben-m bẹ́, ‘Tọka oyok nwo kw'ọfhọ ọgbaanọkka nang mina, mfha mọfhẹ-ẹ, k'eso ch'ọgbaanọkka kwẹ kw'ọfhọ, mfha m'ọchọn-ẹ ebocha.’ Bẹ mmin'adimẹ akpen p'nnwa nwo mawanẹ kw'orikẹ, mfha eche ch'odim kwaam, wanẹma, ẹnọmma chẹ, edimẹ m'iyagbin.”<verse eid="2SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8" />Ọvaarnọng oben kwanọng nwo bẹ́, “Zọhng bhana. Kaam m'ntima ẹfa chaam nttọhna odik nwo ojibh ọnang-ọ.”<verse eid="2SA 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9" />Kwanọng nwo kw'ofon Tẹkoa oben ọvaarnọng bẹ́, “Ttatta kwaam, tte epyima ede ch'kaam ọmaana echimma ch'atte kwaam. Tte ọvaarnọng ọmaana ẹvaarkkọhbhọ chẹ, maning epinẹ ayen.”<verse eid="2SA 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10" />Ọvaarnọng oben-ẹ bẹ́, “Ó̱de ọnọng kpenamkpen ọgbaak odiktama ọnang-ọ, kwu tek-m, kwuna m'ọdọk kọ odik mayak.”<verse eid="2SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11" />Kwanọng nwo oben bẹ́, “Ó̱de ode minna, tte ọvaarnọng ochekẹ k'eche ch'Ọvaar Ibinọkpaabyi kwẹ bẹ́, m'ọkpa anọng p'ad-akam bẹ́, matuka odik nwo eden, mfha maning izẹ akibhẹ ayọhnga nya, maning ojinọngnwa kwaam afhọ.”</para>
  <para style="p" vid="2SA 14:11">Ọvaarnọng oben bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, osisanaanga kw'nnwa kwọ k'izek motto.”<verse eid="2SA 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12" />Nya o, kwanọng nwo oben bẹ́, “Ototo, tte kaam ọtọhmnọng kwọ mgbaak odik mawanẹ nnang ttatta kw'ode ọvaarnọng kwaam.”</para>
  <para style="p" vid="2SA 14:12">Ọvaarnọng ọpọhna bẹ́, “Gbaak odik!”<verse eid="2SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13" />Kwanọng nwo oben bẹ́, “Asi yen achibhẹ itamase nja amaana anọng p'Ibinọkpaabyi? Ó̱de ọvaarnọng ọgbaak odikse nwa, ifor sẹ azang s'opyibhẹ aponga nya o? Maa pyirẹ ma, ọvaarnọng nnwa kwẹ kw'obhon okwubhọ otim otima ọkpa nnam. <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />Kwuna mina maphyir mm'ope-ope mach'asi ad-abyenga k'izek, ọnọng ọdọk mòkpo ọkaabha. Okenaka, ọttọhk f'ọdaakẹ Ibinọkpaabyi azang nya; kẹ oter oror eden ch'ọnọng kw'ọrọbh ebira im'ọkpa nnam.<verse eid="2SA 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15" />“Nya o, nkwu ma bẹ́, ntek ttatta kw'ode ọvaarnọng kwaam idik nja, okurọ bẹ́, anọng mbo kk'aam ojora aka k'ettem. Kaam ọtọhmnọng kwọ nchibhẹ bẹ́, ‘Ó̱de mgbaak ọvaarnọng odik nwa, ńnòsi, ọvaarnọng m'osi ọttọhk f'mphyem-ẹ ọnang-m. <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />Ṉ́nòsi, ọvaarnọng m'ocher-ochera bẹ́, ọrọhbha kaam ọtọhmnọng kwẹ z'mbọhk s'ọnọng kw'ọd-ọkam bẹ́, ọfhọ kaam ọttara nnwa kwaam, ọfha mọgwaana ebocha ch'Ibinọkpaabyi osokọ mina.’<verse eid="2SA 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 14:17" />“Nya wọ osi, kaam ọtọhmnọng kwọ nchibhẹ bẹ́, ‘Tte ọgbaakadik kw'ttatta kw'ode ọvaarnọng kwaam, ọnang-m ottemdirẹ, okurọ bẹ́, ttatta kw'ode ọvaarnọng kwaam ode mach'ozeng-eden kw'Ibinọkpaabyi kw'od-otin itama, ọmaana ejibha. Tte Ọvaar Ibinọkpaabyi kwọ oninga ọmaan-ọ.’ ”<verse eid="2SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18" />Nya o, ọvaarnọng oben kwanọng nwo bẹ́, “Kaam odik kw'nd-nkam bẹ́, mbọbh-ọ ma kadubh o.”</para>
  <para style="p" vid="2SA 14:18">Kwanọng nwo ọpọhn-ẹ bẹ́, “Tte ttatta kw'ode ọvaarnọng kwaam ọgbaak odik.”<verse eid="2SA 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19" />Ọvaarnọng ọbọbh-ẹ bẹ́, “Kọ kachibhẹ bẹ́, Joab wọ od-otim-ọ osi idik nja maphyir?”</para>
  <para style="p" vid="2SA 14:19">Kwanọng nwo ọpọhna bẹ́, “K'ose kw'ikọ ttatta kw'ade ọvaarnọng kwaam arukọ akpen, ọnọng za kode kw'mokpo ọrọbh orik odik kw'agbaakẹ. K'odik ọkkọkka, ọtọhmnọng kwọ kw'ode Joab wọ ọtọhn-m bẹ́, nsi minna. Kẹ wọ obir ọtọhn ọtọhmnọng kwọ bẹ́, ọgbaak idik nja maphyir. <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />Joab kw'ode ọtọhmnọng kwọ, osi minna, ọfha abhakẹ ose kw'idik ide madidanma. Ttatta kwaam oyen ezonga mach'ozeng-eden kw'Ibinọkpaabyi. Kẹ ozong ọttọhk kpenamkpen f'od-oyin m'izek.”<verse eid="2SA 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21" />Ọvaarnọng oben Joab bẹ́, “Ojibh-ojibh. Kaam m'nsi-osi minna. Zọhng tọka odikkobh nwo kw'ode Absalọm, tima kpa nnam.”<verse eid="2SA 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22" />Joab otto okwubha ititika ny'izek k'ekpukpobha-maana, ozim-ẹ k'eche ch'Ibinọkpaabyi. Oben bẹ́, “Menda, kaam ọtọhmnọng kwọ kk'nzonga bẹ́, kk'ọphyaam f'ttatta kw'ode ọvaarnọng kwaam nyena, okurọ bẹ́, ọvaarnọng kk'ọttọhk f'kaam ọtọhmnọng kwẹ mphyem-ẹ, ọsa.”<verse eid="2SA 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 14:23" />Nya o, Joab ochina z'Geshur, ọd-ọtọka Absalọm otima ọkpa nnam z'Jẹrusalẹm. <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />Okenaka, ọvaarnọng oben bẹ́, “Absalọm m'ochina z'ikẹ k'ọsọhm. Kinnorọ bẹ́, oze ititika saam.” Minna kw'Absalọm ochin z'ikẹ k'ọsọhm, ọdọk ititika s'ọvaarnọng koze.<verse eid="2SA 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />Wa ny'Israẹl kibungọ, ọnọng kode kw'matọhng ajibhada pẹ mach'mbo p'Absalọm. Tọma z'eso maa, pyirẹ z'mmokpatọkọ, ọraak koyen. <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />Wa od-ophyirẹ isisa sẹ ogbe mawanẹ k'icho. Ó̱de ophyirẹ isisa sẹ, adọhbhiji p'isisa njo mad-ade ashẹkẹl arọbh ijobh, atorọ k'ose kw'nd-ayoma ekpo z'ọvaarsọhm.<verse eid="2SA 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 14:27" />Wa Absalọm obhonọ ajinọngva attaan, ọmaana kwanọngnwa mawanẹ kw'okpen Tamar, kw'ojibh kwanọng mawuriji.<verse eid="2SA 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28" />Wa Absalọm orukọ ny'Jẹrusalẹm k'icho ifa, ititika s'ọvaarnọng koze. <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />Nya o, Absalọm ọtọhm bẹ́, mayerẹ Joab anang-ẹ ọfha ọtọhm-ẹ z'ọvaarnọng. Joab obhum eyerẹ ndo. Absalọm ọtọhm ẹkkaabha ttong ifa. Joab obir obhum eyerẹ ndo. <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />Minna kw'obenẹ atọhmnọng pẹ bẹ́, “Owonọ kw'Joab ogbonọ abarli oning ọnyọma owonọ kwaam. Màzọhng ke ekpon ny'owonọ nwo.” Minna kw'atọhmnọng p'Absalọm ake owonọ nwo ekpon.<verse eid="2SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31" />Joab obina ozeng z'Absalọm k'ọsọhm, ọd-ọbọbh-ẹ bẹ́, “Osi yen kw'atọhmnọng pọ make owonọ kwaam ekpon o?”<verse eid="2SA 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32" />Absalọm oben Joab bẹ́, “Nyer-ọ bẹ́, akwu ọfha ntọhm-ọ ad-abọbh ọvaarnọng bẹ́, ‘Mbọng f'nzeng ábẹ̀ mbina z'Geshur nkwuna o? Wura ojibhẹ ọtam, óde nninga za!’ Madidanma, nnorọ bẹ́, nze ọvaarnọng. Ó̱de ikk'mpina k'eden kpenamkpen, tte ọfhọ-m.”<verse eid="2SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33" />Minna kw'Joab ochin z'ọvaarnọng, od-otek-ẹ odik nwo. Ọvaarnọng oyerẹ Absalọm. Absalọm opyirẹ za o, ọraka otwu ititika z'izek ọnang ọvaarnọng. Ọvaarnọng ọbaak-ẹ.<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s1">Absalọm ochi Devid ikwu</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />Okwu opyirẹ k'ogbe wanẹ, Absalọm okwu oyena ọkpaar kw'nnyanya id-itọr ọmaana nnyanya. Ajinọng arọbh afa okwuma ijobh machẹ-ẹ eden. <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />Wa ọd-ọpọm-ọpọm od-obe ny'akonga p'eden ch'echin z'ebhumma ch'obhon. Ó̱de ọnọng otim odik okwu bẹ́, ọvaarnọng ọttọhna, Absalọm m'oyer-ẹ, ọbọbh-ẹ bẹ́, “Bọng-obhon kw'ikọ afon o?” Ọnọng nwo m'ọpọhn-ẹ bẹ́, “Kaam ọtọhmnọng kwọ mfon m'ẹkọma danẹ ch'Israẹl e.” <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />Absalọm m'oben-ẹ bẹ́, “Kirẹ ẹ, aponga mba adaamẹ kọ e. Okenaka, ọnọng kode kw'im'ọbhaanga aponga pọ k'eso ch'ọvaarnọng e.” <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />Absalọm m'obir oben-ẹ bẹ́, “Wúra ode bẹ́, masi-m ọkpaar-aponga m'izek nja, wura nd-mkpaara aponga p'mm'adaam ọnọng kpenamkpen ettem.”<verse eid="2SA 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 15:5" />Obir ode bẹ́, ogbe kpenamkpen kw'ọnọng ọnyọm Absalọm z'ifor bẹ́, ọraka eso ọnang-ẹ, kẹ m'otera onemẹ ọbọhk, ọbọka ọnọng nwo, ọbaak-ẹ. <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />Minna kw'uwa Absalọm od-osi otima otor anọng p'Israẹl maphyir p'atim idik akwu bẹ́, ọvaarnọng ọttọhna. Ozenga nya, odebh nttem s'anọng p'Israẹl.<verse eid="2SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7" />Ch'icho nna kk'ikpana, Absalọm oben ọvaar Devid bẹ́, “Ototo, tte-m ọbọhk nchina z'Hẹbrọn, nd-nsi nnang Ọvaar Ibinọkpaabyi k'ose kw'uwa nchekẹ. <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />K'ogbe kw'uwa nning z'Geshur, z'ẹbhaakẹ ch'Aram, nchekẹ bẹ́, ‘Ó̱de Ọvaar Ibinọkpaabyi otim-m ọkpa nnam z'Jẹrusalẹm, m'mkpobh-ẹ z'Hẹbrọn.’ ”<verse eid="2SA 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9" />Ọvaar Devid oben-ẹ bẹ́, “Zọhng k'ọdaam.” Minna kw'Absalọm obin ozeng z'Hẹbrọn.<verse eid="2SA 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10" />Okenaka, Absalọm ozenga nnam-nnam ọtọhm atọhmọ pẹ ny'nkọma s'Israẹl maphyir, oben bẹ bẹ́, “Izaa mabhaang ẹmọng ch'enyisa, makwọhrọ k'ẹrọng bẹ́, ‘Absalọm wọ ode ọvaarnọng z'Hẹbrọn.’ ” <verse eid="2SA 15:10" /><verse number="11" style="v" sid="2SA 15:11" />Ny'ogbe nwo, anọng arọbh ijobh p'abin ny'Jẹrusalẹm kk'atọna amaana Absalọm. M'odik kw'od-oyin-oyin nya, kazong. <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />Nya ch'Absalọm ọd-ọfọhnọ nja, ọtọhm bẹ́, mayerẹ Ahitophẹl kw'ofon Gilo, kw'ọd-ọtọhn Devid idik bẹ́, obina z'Gilo kw'ode obhon kwẹ, okwu. Minna kw'ikwu s'Absalọm ochi Devid ido igaang-ọgaangẹ maa, akaannọng pẹ machina ororo asaabh.<verse eid="2SA 15:12" /></para>
  <para style="s1">Devid ọrọbhọ orik Jẹrusalẹm</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />Itọhmọ janẹ ikwu itek Devid bẹ́, “Absalọm kk'nttem s'anọng p'Israẹl maphyir odebha e.”<verse eid="2SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14" />Nya o, Devid oben atọhmnọng pẹ p'aning amaan-ẹ ny'Jẹrusalẹm bẹ́, “Màbina ẹbhar-ẹbhar mọrọbh e, kirẹ óde Absalọm ọsẹr-ọsẹr okebha mina ma, ọnọng kw'im'ọnaanga k'mbọhk sẹ kode e. Kẹ m'ọna mina mkpaang, otima ọkkangkkang ọfhọ ọnọng kpenamkpen m'ebhondim ndoma e.”<verse eid="2SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15" />Atọhmnọng p'ọvaarnọng apọhn-ẹ bẹ́, “Ttatta, mina mm'osi ọttọhk kpenamkpen f'ikọ ọvaarnọng kwamina abenẹ.”<verse eid="2SA 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16" />Minna kw'ọvaarnọng obin ozenga ọmaana ẹsọhmmọr chẹ kibungọ. Osok ayok-nọng pẹ ijobh nya bẹ́, makkerẹ odimpa. <verse eid="2SA 15:16" /><verse number="17" style="v" sid="2SA 15:17" />Ọvaarnọng obina ozenga, anọng maphyir mator-ẹ, mazenga maa, mad-abe z'okpongannam-sọhm kw'ebhondim ndo. <verse eid="2SA 15:17" /><verse number="18" style="v" sid="2SA 15:18" />Atọhmnọng pẹ maphyir mazenga achẹ-ẹ eden. Ajinọng p'Kẹrẹt, ọmaana p'Pẹlẹt, ọttara ajinọng p'Git p'ade anọng ẹnọhna okwuma arọbh ijobh p'abin z'Gat amaan-ẹ, mabir achẹ-ẹ eden.<verse eid="2SA 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 15:19" />Ọvaarnọng oben Ittayi kw'ofon Gat bẹ́, “Kayen kw'ikọ m'ator mina o? Kọ ade okikennọng kw'obhon kwọ ọtọhmọ ebira. Kpa nnam ad-aninga amaana ọvaar Absalọm. <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />Chena-chena kw'ad-akwu ma. Yen kw'mator-m m'osi kpaanga-kpaanga nwa kw'ina ibyi nzong s'nchin-ochina o? Kpa nnam, atima anọng pọ afona. Tte Ọvaar Ibinọkpaabyi ọkọhk-ọ ọdaakẹ kwiden, obir obe ọmaan-ọ k'ogbe kpenamkpen.”<verse eid="2SA 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21" />Okenaka, Ittayi ọpọhna ọvaarnọng bẹ́, “Ttatta, k'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, kọ ọvaarnọng kwaam abir aruk, ibyi kpenamkpen s'achin, ode obo o, ode akpen o, kaam ọtọhmnọng kwọ, mbe mmaan-ọ.”<verse eid="2SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22" />Devid oben Ittayi bẹ́, “Tte ode minna kẹ. China ororo k'ozenga.” Minna kw'Ittayi nwo kw'ofon Gat obin ozenga ọmaana ajinọng pẹ maphyir, ọttara isọhmmọr s'iwa ining imaan-ẹ.<verse eid="2SA 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23" />Wa anọng maphyir abhomọ amọng k'ẹrọng k'ose kw'maze anọng mbo maphyir ch'mad-azenga akpan nya. Ọvaarnọng ozenga ojeka Ilokodo s'Kidrọn, anọng mbo maphyir mabir mazenga achina z'ẹbhaakẹ ch'anọng nna arukọ.<verse eid="2SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24" />Wa Zadọk ọttar ny'ozenga nwo. Anọng p'Lẹvi maphyir p'ad-atinẹ Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi mabir aninga nya amaan-ẹ. Masaka Ẹkkọhbhọ ndo ch'Echekẹ k'izek. Abiyata ọfọhnọ nja maa, anọng mbo maphyir makpan obhon nwo, mafona.<verse eid="2SA 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25" />Nya o, ọvaarnọng oben Zadọk bẹ́, “Tima Ẹkkọhbhọ ndo ch'Echekẹ ch'Ibinọkpaabyi kpa nnam z'ebhondim. Ó̱de ọdaakẹ Ibinọkpaabyi, m'otim-m ọkpa nnam ma, nze Ẹkkọhbhọ nda, ọmaana iruk-byi sẹ. <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />Okenaka, óde obenẹ bẹ́, ‘Ettem kaam kẹdaamẹ ẹmaan-ọ,’ kaam kk'ifor nda. Tte osi-m k'ose kpenamkpen kw'ojibh-ẹ.”<verse eid="2SA 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27" />Ọvaarnọng obir oben Zadọk kw'ode ọfọhn-nja bẹ́, “Odik nwa kọ kọttaan-ẹ o? Tima Ahimaz kw'ode ojinọngnwa kwọ, ọmaana Jonatan kw'ode ojinọngnwa kw'Abiyata, kpa nnam z'obhon. Kọ Zadọk ọmaana Abiyata, màtima ajinọngva afa pabọnga, kpa nnam. <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />Kaam m'nninga z'ibyi s'anọng nna arukọ, za ch'ọraanga ọgbẹr-ọgbẹrẹ maa, ẹkkaabha chọ epyir-m.” <verse eid="2SA 15:28" /><verse number="29" style="v" sid="2SA 15:29" />Minna kw'Zadọk ọmaana Abiyata matim Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi akpa nnam z'Jẹrusalẹm, maninga za.<verse eid="2SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />Devid ochina ororo k'ozenga kwẹ, ovura egbe ch'Oliv, obubha ọttọhk k'eso, otima abhogbenga, obhom ẹmọng k'ose kw'ọzọhngọ. Anọng maphyir p'ator-ẹ, mabubha ekpo k'eso, mabir abhom amọng atima ayak-ẹ nnam. <verse eid="2SA 15:30" /><verse number="31" style="v" sid="2SA 15:31" />Itekẹ ipyirẹ Devid bẹ́, “Ahitophẹl ọttar k'anọng p'Absalọm otim ọchọ-ọ ikwu e.” Ofona nya, Devid oze njọm bẹ́, “O Ọvaar Ibinọkpaabyi, si ntọhna s'Ahitophẹl ibhakẹ izeng edingẹ-dingẹ.”<verse eid="2SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32" />Devid okwu opyirẹ z'ogbeso kw'mad-aninga akpobha Ibinọkpaabyi, Hushai kw'ofon Ark, otima ọnọhma kw'ikk'ọyaaka z'ifọr, ọttara ebonọ z'eso, okebh-ẹ nya. <verse eid="2SA 15:32" /><verse number="33" style="v" sid="2SA 15:33" />Devid oben-ẹ bẹ́, “Ó̱de ator-m m'ofona, m'ade ẹtọhka anang-m e. <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />Okenaka, óde akpa nnam z'obhon, ad-aben Absalọm bẹ́, ‘O ọvaarnọng, kaam m'nde ọtọhmnọng kwọ. Wa kaam nde ọtọhmnọng kw'atte kwọ. M'ogbe nwa, tte nde ọtọhmnọng kwọ.’ Ó̱de asi minna, kọ m'akkaan-m, afurọ ntọhna s'Ahitophẹl. <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />Zadọk ọmaana Abiyata p'ade afọhn-nja p'Ibinọkpaabyi m'aninga nya amaan-ọ. Gbaak bẹ odik kpenamkpen kw'abhaang z'odimpa. <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />Ahimaz kw'ode ojinọngnwa kw'Zadọk, ọmaana Jonatan kw'ode ojinọngnwa kw'Abiyata maning nya amaana bẹ. Ó̱de abhaang odik kpenamkpen, tọhm bẹ makwu atek-m.”<verse eid="2SA 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37" />Nya o, Hushayi kw'ode oyok-echekẹ kw'Devid, opyirẹ z'Jẹrusalẹm k'ogbe kw'Absalọm od-odim-odim z'obhon.<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s1">Devid ọmaana Ziba</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />K'ogbe kw'Devid ikk'ogbeso nwo ọkpana makarẹ, okebha Ziba kw'ode ọtọhmnọng kw'Mẹlphiboshẹt ch'obe nya otik-ẹ. Wa kẹ kk'abrẹd-duk arọbh ijobh, ọmaana ogbogbokwa arọbh achen f'matim grep p'agwu-ogwu asi, ọmaana ogbogbokwa arọbh achen f'matim fig asi, ọttara etuk-kpa ch'matim etenkpa asi, ọtọka ọdabh z'nnyanya bẹ́, itọhka.<verse eid="2SA 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 16:2" />Ọvaarnọng ọbọbh Ziba bẹ́, “Atim ekpo mbyoma akwu mbọng o?”</para>
  <para style="p" vid="2SA 16:2">Ziba ọpọhn-ẹ bẹ́, “Nnyanya ide s'ẹsọhmmọr ch'ọvaarnọng min'ẹyaar, abrẹd ọmaana achiduk ade p'anọng m'achi, atuk ade p'mm'asi ifor iphyabha ọnọng kpenamkpen kw'ikk'ẹ ọkọhna z'ibyi s'anọng nna arukọ.”<verse eid="2SA 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3" />Ọvaarnọng ọbọbh-ẹ bẹ́, “Nnwa kw'nnwa kw'atte kẹ o?”</para>
  <para style="p" vid="2SA 16:3">Ziba ọpọhn-ẹ bẹ́, “Oning z'Jẹrusalẹm e, okurọ ch'ochibhẹ bẹ́, menda anọng p'Israẹl m'atte ẹvaar ch'atte kwaam kwiden ọbọhk, anang-m.”<verse eid="2SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4" />Ọvaarnọng oben Ziba bẹ́, “Ọttọhk kpenamkpen f'Mẹphiboshẹt oyen, node fọ.”</para>
  <para style="p" vid="2SA 16:4">Ziba oben bẹ́, “Ttatta kwaam, nrak eso k'ikpukpobha nnang-ọ. Tte ttatta kwaam, kw'obir ode ọvaarnọng kwaam, osi ọphyaam ọnang-m.”<verse eid="2SA 16:4" /></para>
  <para style="s1">Shimeyi ọlọhkọ Devid</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />K'ogbe kw'ọvaar Devid kk'ozenga ọnyọma Bahurim, ojinọng wanẹ kw'obir ode efona ch'Saul, oyin nya. Wa ojinọng nwo okpen Shimeyi, kw'ode nnwa kw'Gera. Minna kw'ọlọhk-ẹ mach'ọlọhk-ẹ nya. <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />Shimeyi ọd-ọtọhbh Devid ọmaana atọhmnọng pẹ ata. Ode ch'agbongnọng p'Devid ọttara anọng p'nd-akker-ẹ nkk'Devid aba z'odimbọhk ọmaana z'obhurubọhk. <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />K'ose kw'ọd-ọlọhk-ẹ, od-oben-ẹ bẹ́, “Bina m'ibyi nja! Yin z'iyaan! Kọ ọfhọ-anọng nwa. Obyibyanọng mach'ikọ! <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" />Irem s'Ọvaar Ibinọkpaabyi ọnang-ọ, kk'anọng maphyir p'afhọ ny'ẹsọhmmọr ch'Saul jọ nya. Ọvaar Ibinọkpaabyi kk'ẹvaar ndo ch'atọk z'Saul k'mbọhk, ọtọka ọnang nnwa kwọ Absalọm. M'aze irem okurọ anọng mbo p'afhọ!”<verse eid="2SA 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9" />Nya o, Abishayi kw'ode nnwa kw'Zeruya oben ọvaarnọng bẹ́, “Kayen kw'ọffabukọ nwa im'ọlọhkọ ọvaarnọng kwaam o? Tte nzọhng nd-mpẹ-ẹ eso.”<verse eid="2SA 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10" />Okenaka, ọvaarnọng oben bẹ́, “Bọng-ọttọhk vọ ọmyẹ bọnga iva p'Zeruya o? Ó̱de ọlọhk-m okurọ ch'Ọvaar Ibinọkpaabyi ikk'ẹ obena bẹ́, ‘Lọhkọ Devid,’ anyi wọ oyen ẹfa ch'im'otima ọbọbh-ẹ bẹ́, ‘Osempira asi minna?’ ”<verse eid="2SA 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11" />Devid oben Abishayi ọmaana atọhmnọng pẹ maphyir bẹ́, “Nnwa kwaam oyenẹ kw'mbhonọ, obir ode izẹ saam, ọkamẹ za bẹ́, ọfhọ-m. Ọnọng nwa kw'oter ofona ẹkọma ch'Bẹnjamin, kẹ wọ im'oyobh-m o? Màttẹ-ẹ ọbọhk ọlọhk-m e, okurọ bẹ́, Ọvaar Ibinọkpaabyi kk'ẹ obena bẹ́, osi minna. <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />Ṉ́nòsi Ọvaar Ibinọkpaabyi m'oze irem saam, otima ejibha otuk-m, obir ọnang-m ẹda ch'ochekẹ k'ẹlọhkọ nda ch'menda.”<verse eid="2SA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13" />Minna kw'Devid ọmaana anọng pẹ machin ororo k'ozenga kwabẹ. Shimeyi ozenga z'ẹbhaakẹ ndoza ch'egbe, ọlọhkọ Devid k'ose kw'od-ozenga nya, ọbhar-ẹ ata, ọttara ẹbanga. <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />Ọvaarnọng ọmaana anọng p'ator-ẹ maphyir, mapyirẹ k'ibyi s'makamẹ ch'ikk'bẹ ọkọhna. Ọvaarnọng okwoka ọwọhng ny'ibyi njo.<verse eid="2SA 16:14" /></para>
  <para style="s1">Ntọhna s'Hushayi ọmaana Ahitophẹl</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />M'ogbe nwa, Absalọm ọmaana anọng p'Israẹl maphyir makwu z'Jẹrusalẹm. Ahitophẹl obir oninga nya ọmaan-ẹ. <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />Nya o, oyok-echekẹ kw'Devid kw'okpen Hushayi kw'ofon Ark, od-okebha Absalọm, oben-ẹ bẹ́, “Tte ọvaarnọng oruk akpen p'adum-odum! Tte ọvaarnọng oruk akpen p'adum-odum!”<verse eid="2SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17" />Absalọm ọbọbh Hushayi bẹ́, “Oyinẹ bẹ́, ọdaakẹ kw'akọhk oyok-odikkobh wọ ma o? Ó̱de ode oyok-odikkobh kwọ, osempira kẹ katorọ m'afona?”<verse eid="2SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18" />Hushayi ọpọhna Absalọm bẹ́, “Mma e, kaam m'nninga mmaana ọnọng nwo kw'Ọvaar Ibinọkpaabyi ikk'oteka, kw'ode nwo kw'anọng mba, ọttara anọng p'Israẹl maphyir matek e. <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />Ágbaarẹ nwonya ajẹ, anyi wọ kw'im'nsi ọtọhm mmaana? Ma, kọbaan bẹ́, nsi ọtọhm nnang nnwa, k'ose kw'uwa nsi nnang otte o? Kọ wọ kw'm'nsi ọtọhm nnang e.”<verse eid="2SA 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20" />Absalọm oben Ahitophẹl bẹ́, “Nang mina ntọhna sọ. Mmin'osi yen?”<verse eid="2SA 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21" />Ahitophẹl ọpọhn-ẹ bẹ́, “Yima maana ayok-nọng p'atte ofon orik bẹ́, makkerẹ odimpa. Ási minna, ọnọng kpenamkpen kw'ọbhaang odik nwo, m'ọtọka bẹ́, nabọkọ atte idik matamatama. M'ofona nya, anọng p'ator-ọ mado abe mawuriji.” <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />Minna kw'mattim ikkira z'ipubhaang anang Absalọm. Oninga nya oyima ayok-nọng p'otte ábẹ̀, ny'ititika s'anọng p'Israẹl maphyir.<verse eid="2SA 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23" />Wa ny'ogbe nwo, ntọhna s'Ahitophẹl ide mach'ntọhna s'ọnọng kw'ọd-ọbhaanga odik z'Ibinọkpaabyi k'ẹmma. Minna kw'uwa Devid ọmaana Absalọm nd-atọka ntọhna s'Ahitophẹl.<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />Ahitophẹl oben Absalọm bẹ́, “Tte nteka ajinọng nnọhna ẹrọbh okwuma ijobh, ntima nd-nkwubh Devid m'erungọ nda. <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />Kaam m'nd-nrim-ẹ ábẹ̀ ma ch'ikk'ẹ ọkọhna, ẹfa ebir ẹsẹ-ẹ. M'nrim-ẹ ábẹ̀, nkk'ẹ ojora fiden, mfha anọng p'mator-ẹ maphyir marọbh arik-ẹ. Pira mfhọ ọvaarnọng kẹ-kẹ, <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />ntima anọng mboza maphyir nchen-ọ. Ó̱de ọnọng nwo kw'akamẹ ope, anọng mboza maphyir, ọttọhk bẹ mòsi.” <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />Wa ntọhna nja, ikwu vẹma Absalọm ọmaana asogbọhkọnọng p'Israẹl maphyir.<verse eid="2SA 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />Absalọm oben bẹ́, “Màyerẹ Hushayi kw'ofon Ark nang-m, mfha mobir ọbhaanga odik kw'ikẹ m'ọgbaak.” <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />Hushayi opyirẹ nya o, Absalọm oben-ẹ bẹ́, “Kirẹ ntọhna s'Ahitophẹl ọnang mina e. Ma, mosi k'ose kw'obenẹ o? Ini minna ode, gbaak mina ochibhẹ kwọ.”<verse eid="2SA 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7" />Hushayi ọpọhna Absalọm bẹ́, “Ntọhna s'Ahitophẹl ọnang-ọ mẹkpanda, kijibhẹ. <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />Kọ azong ma bẹ́, atte ọmaana anọng pẹ, made arimanọng, mabir akkaam mach'eche ch'ọnọng ọnẹ-ẹ iva pẹ. Atte kwọ ọdọk, obira ode ọnọng kw'ozong akkona p'egbong. Mòchera bẹ́, oyima ọmaana agbongnọng pẹ m'erungọ nda. <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />Ch'nd-ọgbaak ma, ńnòsi otubh z'ọtakpamma wanẹ, wanẹma, oning k'ibyi janẹ za. Ó̱de ocheden orima agbongnọng pọ ábẹ̀, ọnọng kpenamkpen kw'ọbhaang odik nwo, m'oben bẹ́, ‘Maning za apekẹ agbongnọng p'atorọ Absalọm e.’ <verse eid="2SA 17:9" /><verse number="10" style="v" sid="2SA 17:10" />M'ọwọhkọ zaabẹ́, okkikkaama oke ettemkira ch'eche, ojora m'ọbọk-ẹ, okurọ bẹ́, anọng p'Israẹl maphyir azong atte kwọ mach'orimanọng kwiden, mabir azonga anọng p'ator-ẹ mach'akkikkaama.<verse eid="2SA 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11" />“Nya o, ntọhna saam ide bẹ́, tobha anọng p'Israẹl maphyir, tọma z'ẹkọma ch'Dan maa, pyirẹ z'ẹkọma ch'Beershẹba. Tte masaabh mach'ofong kw'ẹraangaka. Íkk'asa minna, kọ oyenẹ chi bẹ eden k'egbong. <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />Ibyi kpenamkpen s'mokebh-ẹ, mm'obubh-ẹ ny'ifor mach'ifọhng ibubh izek, morim-ẹ ábẹ̀. Kẹ ọttara ojinọng kwẹ mawanẹ kw'm'oruk akpen kode. <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />Ó̱de ọrọbhọ odim k'obhon, anọng p'Israẹl matima ndik adim ny'obhon nwo, matọr ntumọ s'ọbaaka kw'obhon nwo ajẹ z'ilokodo, ẹta madanẹ-danẹ mèrik.”<verse eid="2SA 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14" />Nya o, Absalọm ọmaana anọng p'Israẹl maphyir maben bẹ́, “Ntọhna s'Hushayi kw'ofon Ark, ijibhẹ iyọhnga s'Ahitophẹl.” Wa Ọvaar Ibinọkpaabyi osi bẹ́, ntọhna ọkkọkka s'Ahitophẹl ọnangẹ, inìng k'eden iyinẹ ọfha otima osi Absalọm itama.<verse eid="2SA 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />Hushayi otek Zadọk ọmaana Abiyata p'ade afọhn-nja p'Ibinọkpaabyi bẹ́, “Ahitophẹl kk'Absalọm, ọmaana asogbọhkọnọng p'Israẹl ntọhna ọnanga k'ose kw'mm'asi. Okenaka, kaam kk'bẹ ntọhna ọdọk-ọdọk nnanga. <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />Màtọhm ẹkkaabha ẹbhar-ẹbhar chena Devid bẹ́, ‘Ewu enìng-ọ esobh nya ch'asi agbẹr-ọgbẹrẹ ny'ibyi s'anọng nna arukọ. Jeka z'okwubha, ini minna ode, ọvaarnọng ọmaana anọng p'aning amaan-ẹ maphyir, mm'ape.’ ”<verse eid="2SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17" />Wa Jonatan ọmaana Ahimaz, mad-aninga z'ekeka ch'Ẹn-Rogẹl. Ominanwa wanẹ od-okwu otek bẹ idik, mfha bẹ mabira atek ọvaar Devid, okurọ ch'ojor bẹ bẹ́, óde mádimẹ z'obhon, anọng m'aze bẹ. <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />Okenaka, ewu danẹ, odikkobhnwa wanẹ oze bẹ, od-otek Absalọm. Minna kw'Jonatan ọmaana Ahimaz masẹr-ọsẹr machina k'ọsọhm kw'atte wanẹ z'Bahurim. Mad-atubha z'esipe ẹtaanga ch'atte nwo otumọ ny'ikẹ k'oter. <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />Kwanọng kw'atte nwo otima obhurukpa obubha ẹmma ch'esipe ndo maphyir, ọyaan agwu nya. Ọnọng kw'ozong bẹ́, anọng atubh nya kode.<verse eid="2SA 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 17:20" />K'ogbe kw'ajinọng p'Absalọm makwu akebha kwanọng nwo ny'ọsọhm nwo, mabọbh-ẹ bẹ́, “Jonatan ọmaana Ahimaz kẹ?”</para>
  <para style="p" vid="2SA 17:20">Kwanọng nwo ọpọhna bẹ bẹ́, “Nkk'ekeka ajeka e.” Ajinọng mbo magbọngọ ọsọhm maphyir, m'bẹ kaze. Ofona nya, makpa nnam z'Jẹrusalẹm.<verse eid="2SA 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21" />Ajinọng mbo afon nya o, Jonatan ọmaana Ahimaz, mabina z'esipe ndo, mayin k'iyaan. Mafona mad-aben ọvaar Devid bẹ́, “Bina ẹbhar-ẹbhar mad-ajeka ọraanga makpaar! Kirẹ Ahitophẹl kk'ntọhna ọnanga k'ose kw'mm'abọk-ọ.” <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />Ewu esobh nya, Devid ọmaana anọng p'ator-ẹ maphyir mabina, majeka ọraanga kw'Jọrdan, ọnọng mawanẹ-wanẹ korikẹ.<verse eid="2SA 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23" />K'ogbe kw'Ahitophẹl oze bẹ́, m'ntọhna sẹ katọk, ovura k'ẹnyanya chẹ, ọbhana z'obhon kwẹ. Opyirẹ za o, otobha ọsọhm kwẹ maphyir, od-orena edik, ope. Manọhng-ẹ z'epekwuk ch'otte.<verse eid="2SA 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24" />Devid ozenga ochina z'obhon kw'okpen Mahanayim. Absalọm ọmaana ajinọng p'Israẹl maphyir majeka ọraanga kw'Jọrdan. <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />Wa Absalọm, kk'eninga ch'Joab kw'ode oso kw'agbongnọng ọtọka ọnang Amasa. Amasa ode nnwa kw'Jeter<note caller="+" style="f"><char style="fr" closed="false">17.25 </char><char style="ft" closed="false">Jeter obira okpena Ithra.</char></note>, kw'ofon k'ẹsọhmmọr ch'Ishmayẹl. Ọkka kwẹ ode Abigẹl, kw'ode nnwa kw'Nahash, ọgbaanọkka kw'Zeruya kw'ọmaanẹ Joab. <verse eid="2SA 17:25" /><verse number="26" style="v" sid="2SA 17:26" />Wa Absalọm ọmaana agbongnọng p'Israẹl mabhingẹ z'obhon kw'Gilead.<verse eid="2SA 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27" />K'ogbe kw'Devid opyirẹ z'Mahanayim, Shobi kw'ode nnwa kw'Nahash kw'ofon z'Raba, z'ẹkọma ch'Ammọn, ọmaana Makir kw'ode nnwa kw'Amiyẹl kw'ofon z'Lo-Deba, ọttara Bazilayi kw'ofon Gilead, z'ẹkọma ch'Rogẹlim, makkaan-ẹ. <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />Matima eyimakpo, ọmaana agbobhmbọhk, ọmaana ọzọhka, ọmaana wit, ọmaana barli, ọmaana agwubuma, ọmaana agwu p'nkk'abhaabha, ọmaana ngigirẹ k'akira k'akira, <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />ọmaana akọhnsi, ọmaana arọkimaan, ọttara ẹchakpo py'matim abasi p'ẹbhaam asi, matọka anang Devid ọmaana anọng p'ator-ẹ. Maben bẹ́, “Anọng mba kk'amọma z'ifor mawuriji, okwo ọkaama bẹ, asi abira adaak bẹ m'ibyi s'anọng nna arukọ.”<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="s">Obo kw'Absalọm</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />Wa Devid otobha agbongnọng p'aning amaan-ẹ k'nkwurọ k'nkwurọ. Ọrọhbha agbong-sonọng p'akkerẹ nkwurọ s'anọng nnọhna, ọmaana agbong-sonọng p'akkerẹ nkwurọ s'anọng arọbh achen. <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />Otọhm bẹ k'nkwurọ nttaan. Osi Joab oso kw'ekwurọ danẹ, osi Abishayi nnwa kw'Zeruya, kw'ode ọgbaanọkka kw'Joab obhonọ, oso kw'ekwurọ danẹ, obira osi Ittayi kw'ofon Gat oso kw'ekwurọ danẹ. Ọvaarnọng oben bẹ bẹ́, “K'odik ọkkọkka, kaam oyenẹ mm'ọtọn ofona.”<verse eid="2SA 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3" />Agbongnọng mbo maben-ẹ bẹ́, “Mma e, mina kàtor e. Ó̱de awawunanọng pamina akwubhọ mina mọrọbh, ọttọhk f'm'ọyak bẹ odik kode. Zaabẹ́ mina anọng igboka mobir ope, bẹ odik-odik mòsi. Okenaka, kọ abarẹ odik ayọhnga mina igbedim nnọhna ẹrọbh okwuma ichen. M'ojibh ọtam bẹ́, kọ atera aninga m'obhon ake mina ọbọhk.”<verse eid="2SA 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4" />Ọvaarnọng ọpọhna bẹ bẹ́, “Kaam m'nsi okpenamkpen f'ojibhẹ bọnga.”</para>
  <para style="p" vid="2SA 18:4">Ofona nya o, ọvaarnọng obe ny'okikaan kw'ebhumma, agbongnọng mbo maphyir mabina ozenga k'nkwurọ s'anọng arọbh achen, ọttara k'nkwurọ s'anọng nnọhna mfa okwuma arọbh ijobh.<verse eid="2SA 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 18:5" />Ọvaarnọng oben Joab, ọmaana Abishayi, ọttara Ittayi bẹ́, “Màzenga kaam ábẹ̀, mayobh Absalọm nwo kw'ode ojinọngnwa kwaam o.” Wa agbongnọng mbo maphyir, mabhaanga ntọhna s'ọvaarnọng ọd-ọnang aso p'mgbongkwurọ njo okurọ Absalọm.<verse eid="2SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6" />Nya o, agbongnọng mbo mayin egbong oririma amaana anọng p'Israẹl. Wa egbong ndo etto z'ẹtam ch'Ephraim. <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />Agbongnọng p'Devid makema anọng p'Israẹl, mafhọ bẹ k'ọsaabh. Anọng p'uwa mape ny'ewu ndo, made nnọhna arọbh afa okwuma ijobh. <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />Erima ndo ẹnyaamẹ ny'ẹkọma ndo maphyir. Anọng p'akpong ny'ẹtam ny'ewu ndo masaabhẹ ayọhnga ayok p'ape k'ọkkangkkang.<verse eid="2SA 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9" />Minna kw'Absalọm okwu ottema ọmaana agbongnọng p'Devid. Wa ọd-ọyaar ẹnyanya chẹ. Ẹnyanya ndo etim-ẹ edim k'ẹdabhẹ ch'abọhnga p'echi ch'oak, isisa sẹ idan k'echi. Absalọm ọyọhn ny'iwokọ, ẹnyanya chẹ ẹzọhng mach'ẹzọhngọ nya.<verse eid="2SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 18:10" />Ogbongnọng wanẹ kw'Devid ọzẹ-ẹ nya o, od-otek Joab bẹ́, “Nze Absalọm ch'ọyọhnọ z'echi ch'oak e.”<verse eid="2SA 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11" />Joab ọpọhna bẹ́, “Abẹ? Azẹ-ẹ majijik? Osempira kẹ kafhọ ny'eninga ndo? Wúra áfhẹ-ẹ, wura nnang-ọ asilva ijobh, ọmaana odikpa kw'okkikkaama.”<verse eid="2SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12" />Ojinọng nwo ọpọhn-ẹ bẹ́, “Zaa wura manang-m nnọhna mfa okwuma arọbh s'silva m'ọbọhk, kaam nnwa kw'ọvaarnọng ọbọhk mintwu. Nkk'ọbhaanga ch'ọvaarnọng obenẹ kọ ọmaana Abishayi, ọttara Ittayi bẹ́, ‘Màzenga kaam ábẹ̀, mayobh ojinọngnwa nwo kw'ode Absalọm.’ <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />Wúra ikk'ifor saam nka k'odik mfhẹ-ẹ, pira ọvaarnọng okwu ozonga, wura akaan-m abharẹ.”<verse eid="2SA 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14" />Joab oben bẹ́, “Kaam ọdọk minna mìnninga ntik-ọ.” Minna kw'ọtọk akọhn attaan, okwum Absalọm ny'ittemmọma ch'otim okkirẹ ettem, ọyọhn ny'echi ch'oak. <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />Atim-egbongkpo p'Joab anọng ijobh, makọbha Absalọm ake k'ettem, macher-ẹ afhọ.<verse eid="2SA 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16" />Nya o, Joab oje enyisa, oben agbongnọng p'Devid bẹ́, makpọka agbongnọng p'Israẹl okwukwubh. <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />Matọka oforbukọ kw'Absalọm, mabharẹ z'epe danẹ ch'ekem edonga ny'ẹtam ndo. Mayak-ẹ ata maa, mater k'okkin kwiden. Ny'ogbe nwo, wa anọng p'Israẹl maphyir kk'arọbha abhana z'abẹ k'isọhm.<verse eid="2SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18" />Wa ch'Absalọm otim orukọ akpen, ottim ọta ny'Ilokodo s'Ọvaarnọng okurọ ch'ochibhẹ bẹ́, “Kaam ojinọngnwa kinyen kw'im'osi eche chaam eninga echina ororo.” Wa okpe ọgbagba nwo obhuna ifor sẹ. Kẹ wọ osi, matim ayerẹ ọta nwo Ejima ch'Absalọm, pyirẹ menda.<verse eid="2SA 18:18" /></para>
  <para style="s1">Devid obhomọ Absalọm</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />Nya o, Ahimaz kw'ode nnwa kw'Zadọk oben bẹ́, “Tte nd-ntek ọvaarnọng ẹkkaabha nda bẹ́, Ọvaar Ibinọkpaabyi kk'ẹ ọrọhbha k'mbọhk s'awawunanọng pẹ.”<verse eid="2SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20" />Joab oben-ẹ bẹ́, “Kọ azang im'atek-ẹ ẹkkaabha ndo menda. Tek-ẹ ewu ọdọk-ọdọk. Kọ ọbọhk mìntte atek ẹkkaabha ndo menda, okurọ bẹ́, nnwa kw'ọvaarnọng kk'ọpa.”<verse eid="2SA 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21" />Nya o, Joab oben ọnọng nwo kw'ofon Kush bẹ́, “Zọhng tek ọvaarnọng k'ose kw'ikk'aza.” Ọnọng nwo ọraka eso ọnang Joab, ọfona.<verse eid="2SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22" />Ahimaz kw'ode nnwa kw'Zadọk obira oben Joab bẹ́, “Ototo, zaabẹ́ ode yen, tte ntor ọnọng nwo.”</para>
  <para style="p" vid="2SA 18:22">Joab ọpọhn-ẹ bẹ́, “Nnwa kwaam, osempira aben bẹ́, min'afona, ch'ina ẹkkaabha ayen ch'im'ẹnang-ọ ẹtaam o?”<verse eid="2SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23" />Ahimaz oben bẹ́, “Zaabẹ́ ode yen, kaam m'ntima ẹbhar nzọhng.”</para>
  <para style="p" vid="2SA 18:23">Nya o, Joab oben-ẹ bẹ́, “Zọhng kẹ!”</para>
  <para style="p" vid="2SA 18:23">Minna kw'Ahimaz otim ẹbhar ny'ẹkpẹmẹ maa, ọkpan ọnọng nwo kw'ofon Kush ny'eden.<verse eid="2SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24" />Ny'ogbe nwo, Devid oning ẹwọr ny'njeka kw'ebhumma ch'ẹtaanga, ọmaana ch'iyaan. Okker-oter ozenga ny'etumọ ch'ebhumma ndo ovura z'ipubhaang. Mod-otinẹ ichen, oze ọnọng ch'od-otima ẹbhar manchenẹ okwu-okwu. <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />Okker-oter nwo owon ọvaarnọng, otek-ẹ.</para>
  <para style="p" vid="2SA 18:25">Ọvaarnọng oben bẹ́, “Ó̱de ozeng manchenẹ, zonga bẹ́, otim ẹkkaabha ọkkọkka okwu.” Ojinọng nwo otima maa, ọnyọma.<verse eid="2SA 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26" />Okker-oter nwo obira otinẹ ichen oze ojinọng ọdọk-ọdọk ch'od-otima ẹbhar za manchenẹ. Owon okker-oter, oben-ẹ bẹ́, “Kirẹ ojinọng ọdọk-ọdọk wọ od-otima ẹbhar kina e!”</para>
  <para style="p" vid="2SA 18:26">Ọvaarnọng oben bẹ́, “Oyok nwo obir otima ẹkkaabha ọkkọkka okwu.”<verse eid="2SA 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27" />Okker-oter nwo oben bẹ́, “Oker-m mach'ochedennọng nwo od-otima ẹbhar mach'Ahimaz kw'ode nnwa kw'Zadọk.”</para>
  <para style="p" vid="2SA 18:27">Ọvaarnọng oben bẹ́, “Kẹ ode ọnọng ọkkọkka. Ẹkkaabha ọkkọkka ch'od-otima okwu nya.”<verse eid="2SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28" />Ahimaz opyirẹ nya o, oyerẹ ọvaarnọng, oben bẹ́, “Ttatta, idik maphyir ide mawuriji!” Ọraka eso maa, otwu izek, ny'ọvaarnọng k'ititika. Oben bẹ́, “Mọ̀tọhnga Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ! Kẹ kk'anọng p'arim ọvaarnọng kwaam ábẹ̀, okema.”<verse eid="2SA 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29" />Ọvaarnọng ọbọbh-ẹ bẹ́, “Odikkobhnwa nwo kw'ode Absalọm oning za k'ọkkọkka yirẹ?”</para>
  <para style="p" vid="2SA 18:29">Ahimaz ọpọhn-ẹ bẹ́, “Nze damadama kwiden, ch'Joab ọd-ọkam bẹ́, ọtọhm kaam ọtọhmnọng kw'ọvaarnọng, kw'mbir nde ọtọhmnọng kwọ, ẹkkaabha. Okenaka, damadama nwo kaam kọttaanẹ.”<verse eid="2SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30" />Ọvaarnọng oben-ẹ bẹ́, “Bina be m'okikan.” Minna kw'obin obe ẹbhaakẹ danẹ.<verse eid="2SA 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31" />Ny'eninga ndo, ọnọng nwo kw'ofon Kush opyirẹ. Oben bẹ́, “Ttatta, kw'ode ọvaarnọng kwaam bhaanga ẹkkaabha ọkkọkka! Menda Ọvaar Ibinọkpaabyi kk'ọ ọrọhbha k'mbọhk s'awawunanọng pọ maphyir.”<verse eid="2SA 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32" />Ọvaarnọng ọbọbh ọnọng nwo bẹ́, “Odikkobhnwa nwo Absalọm oning za k'ọkkọkka o?”</para>
  <para style="p" vid="2SA 18:32">Ọnọng nwo kw'ofon Kush ọpọhn-ẹ bẹ́, “Tte awawunanọng p'ọvaarnọng kwaam, ọmaana anọng maphyir p'marim-ọ ábẹ̀, made mach'odikkobhnwa nwo.”<verse eid="2SA 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33" />Minna kw'ifor ibhakẹ ọvaarnọng. Ozeng z'idongọ s'ebhumma-okwubha, oninga za ọsọhrọ asen. Ch'iwa od-ofon-ofona, od-oben bẹ́, “O nnwa kwaam Absalọm! Absalọm kwaam! Nnwa kwaam! Wura kaam wọ ntera mpe obo nwa e. O Absalọm, nnwa kwaam, nnwa kwaam!”<verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1" />Wa matekẹ Joab bẹ́, “Ọvaarnọng oning za obhomọ ẹmọng e, obira oninga k'oforpyibha okurọ obo kw'Absalọm.” <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />Ofona nya o, odidaama kw'agbongnọng ayen ch'makem egbong ny'ewu ndo, nokwu ode oforpyibha ọnang bẹ, okurọ ch'mabhaang ny'ewu ndo bẹ́, “Ọvaarnọng oning k'oforpyibha k'obo kw'nnwa kwẹ Absalọm.” <verse eid="2SA 19:2" /><verse number="3" style="v" sid="2SA 19:3" />Agbongnọng mbo mammin akwuna z'obhon ny'ewu ndo, mach'anọng p'egbong epyibh-ewu, pira marọbh akwuna ttara mgbar. <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />Ọvaarnọng obubha mbọhk ny'ititika, obhom k'ẹrọng bẹ́, “O nnwa kwaam Absalọm! Absalọm kwaam, nnwa kwaam e, nnwa kwaam e!”<verse eid="2SA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5" />Nya o, Joab odim okebha ọvaarnọng z'ọsọhm kwẹ, oben-ẹ bẹ́, “Menda kk'agbongnọng pọ maphyir alẹka, p'ade anọng p'makkaan akpen pọ, ọmaana p'iva pọ k'ejinọng ọttara k'ẹpanọng, ọmaana akpen p'panọng pọ, ọttara p'ayok-nọng pọ. <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />Nze bẹ́, awawunanọng pọ adaak-ọ idik ọtam ayọhnga anọng p'achibhẹ ọkkọkka amaan-ọ. Menda kk'mina akọhka bẹ́, akpen p'agbongsonọng, ọttara p'agbongnọng oyenẹ, m'kọ odik kabarẹ. Kk'nza bẹ́, wura ettem elebh-ọ olebh, óde Absalọm oning akpen menda, mina maphyir mope. <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />Bina madidaanma, kebha agbongnọng pọ z'iyaan, ake bẹ ettem. Nchekẹ k'eche ch'Ọvaar Ibinọkpaabyi bẹ́, óde ina z'iyaan ayinẹ, pira ewu epyi, ọnọng kw'im'obira oninga ọmaan-ọ kode. Odik nwa m'opyibh ọyọhnga idik s'ikk'ọ ikpẹka k'akpen, tọma z'edikkobh chọ maa, pyirẹ menda.”<verse eid="2SA 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 19:8" />Nya o, ọvaarnọng obina od-oninga ẹwọr z'ẹvaarkkọhbhọ chẹ, z'ebhumma ch'obhon.</para>
  <para style="p" vid="2SA 19:8">Itekẹ ipyirẹ agbongnọng mbo bẹ́, “Ọvaarnọng kk'ẹwọr oninga z'ebhumma ch'obhon e.” Ofona nya, bẹ maphyir makpa nnam attonga za.</para>
  <para style="s1" vid="2SA 19:8">Devid ọkpa nnam z'Jẹrusalẹm</para>
  <para style="p" vid="2SA 19:8">Ny'ogbe nwo, anọng p'Israẹl kk'arọbha achina z'abẹ k'isọhm.<verse eid="2SA 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 19:9" />Wa ny'nkọma s'Israẹl maphyir, anọng mad-akaanga ayok idik, maben bẹ́, “Ọvaarnọng wọ ọrọhbh mina k'mbọhk s'awawunanọng pamina, ọmaana k'mbọhk s'aPhilistiya. Menda, kk'Absalọm ozeng ábẹ̀ ọrọbh m'ẹkọma nda. <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />Absalọm oyenẹ kw'mobyeng ana k'eso mach'ọvaarnọng kwamina, kk'ọpa z'egbong. Osempira m'odik otima ọgbaaka k'ose kw'ọvaar Devid m'ọkpa nnam?”<verse eid="2SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11" />Ọvaar Devid, ọtọhm ẹkkaabha ọnang Zadọk ọmaana Abiyata p'ade afọhn-nja p'Ibinọkpaabyi, oben bẹ́, “Màbọbh asogbọhkọnọng p'ẹkọma ch'Juda bẹ́, ‘Mad-akibhẹ ogbe asi mbọng, kw'nna ọvaarnọng akwu atọka ọkpa nnam z'ikẹ k'odimpa? Ka, itekẹ kk'ọvaarnọng ipyira k'idik s'anọng p'Israẹl mad-agbaak. <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />Bọnga made ivotte paam, p'izẹ majanẹ isi. Mad-atik mbọng kw'nna ọvaarnọng atima atọka atima akpa nnam?’ <verse eid="2SA 19:12" /><verse number="13" style="v" sid="2SA 19:13" />Obira oben Amasa bẹ́, ‘Kaam ọmaana kọ mode izẹ majanẹ. Tte Ibinọkpaabyi ọyak ọbọhk ọnang-m irem, tọma menda china ororo, óde ina ediden ch'Joab atọk mach'oso kw'agbongnọng paam.’ ”<verse eid="2SA 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14" />Nya o, Devid odebh nttem s'anọng p'Juda, bẹ maphyir nnagbaak odik mawanẹ. Bẹ anọng p'Juda matọhm ẹkkaabha anang Devid bẹ́, “Kọ ọttara atọhmnọng pọ maphyir màkwuna e.” <verse eid="2SA 19:14" /><verse number="15" style="v" sid="2SA 19:15" />Minna kw'Devid ọbhan, ozenga maa, opyirẹ z'ọraanga kw'Jọrdan.</para>
  <para style="p" vid="2SA 19:15">Wa ny'ogbe nwo, agbongnọng p'Juda kk'opyipyirẹ apyira z'Gilgal bẹ́, mad-attema amaana ọvaarnọng, mfha matim-ẹ ajeka ọraanga kw'Jọrdan. <verse eid="2SA 19:15" /><verse number="16" style="v" sid="2SA 19:16" />Shimeyi kw'ode nnwa kw'Gera kw'ofon Bahurim, z'ẹkọma ch'Bẹnjamin, ọsẹr-ọsẹr otor agbongnọng p'Juda bẹ́, mad-attema amaana ọvaar Devid. <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />Anọng p'uwa matọnọ p'mafon Bẹnjamin made anọng nnọhna mfa okwuma arọbh ijobh, ọmaana Ziba kw'ode ọtọhmnọng kw'ẹsọhmmọr ch'Saul, ọmaana ajinọngva ichi p'kẹ Shimeyi, ọttara atọhmnọng pẹ ẹrọbh. Masẹr-ọsẹr achina z'ọraanga kw'Jọrdan, makebha ọvaarnọng za. <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />Minna kw'malọhkọ ajeka ọraanga nwo z'ibyi s'igbẹr-ọgbẹrẹ bẹ́, mad-atọka ẹsọhmmọr ch'ọvaarnọng atima ajeka k'okwubha, mabir asi ọttọhk kpenamkpen f'ọvaarnọng ororọ.</para>
  <para style="p" vid="2SA 19:18">K'ogbe kw'Shimeyi kw'ode nnwa kw'Gera kk'ọraanga kw'Jọrdan ojeka, od-otto okwubha k'ekpikpobha-maana ny'ititika s'ọvaarnọng. <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />Oben-ẹ bẹ́, “Ọvaarnọng kwaam, ototokinẹ, mpinẹ saam kasaana o. Nkwuk-ọ okwukọ, mpinẹ s'ọtọhmnọng kwọ osi k'ogbe kw'abin arik Jẹrusalẹm kàjima. Tte odik nwo ọsa ọvaarnọng z'ettem. <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />Kirẹ kaam ọtọhmnọng kwọ nzong bẹ́, kk'epyibha nsa. Nya wọ osi nde ocheden kw'obin z'efona ch'Josẹph nkwu nkebha kọ ttatta kwaam.”<verse eid="2SA 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21" />Nya o, Abishayi kw'ode nnwa kw'Zeruya oben bẹ́, “Ma, Shimeyi k'obo kọbaan m'ọttọhk f'osi ma yirẹ? Kẹ ọlọhkọ ọnọng kw'Ọvaar Ibinọkpaabyi ikk'ana obyenga k'eso.”<verse eid="2SA 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22" />Devid ọpọhna bẹ́, “Bọnga iva p'Zeruya, bọng-ọttọhk vọ ọmyẹ bọnga ọttara kaam o? Menda bọnga nkk'awawunanọng paam abhaka. Ọbaan za bẹ́, mabira afhọ ọnọng m'Israẹl menda? Bọng nkazong bẹ́, kaam wọ mbaabha Israẹl menda?” <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />Ofona nya o, ọvaarnọng ochekẹ ọnang Shimeyi bẹ́, “Kọ màpe.”<verse eid="2SA 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />Wa Mẹphiboshẹt kw'ode nnwa kw'nnwa kw'Saul obir okwu nya bẹ́, oze ọvaarnọng. Tọma ny'ewu ndo ch'ọvaarnọng obin z'Jẹrusalẹm maa, pyirẹ ny'ewu ch'okwun k'ọdaam, Mẹphiboshẹt mmo kogbobhọ, ammaphyabha kodo, ẹfọrakpo pyẹ kobir ogbobhọ. <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />K'ogbe kw'Mẹphiboshẹt obin z'Jẹrusalẹm okebha ọvaarnọng, ọvaarnọng ọbọbh-ẹ bẹ́, “Mẹphiboshẹt, osempira kaam katorọ mofona?”<verse eid="2SA 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26" />Ọpọhn-ẹ bẹ́, “Ọvaarnọng kwaam, mbenẹ ọtọhmnọng kwaam bẹ́, ‘Chen-m ẹnyanya chaam, ọfha mvura nyaar ntor ọvaarnọng’, ch'kaam mphyakẹ mkpẹtẹ. Okenaka, Ziba kw'ode ọtọhmnọng kwaam ọbọhr-m, kaam kochen. <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />Kk'ọtọhmnọng kwọ oluka ọnang kọ ttatta kwaam. Ttatta kwaam ode mach'ozeng-eden kw'Ibinọkpaabyi. Ofona nya, si k'ose kpenamkpen kw'ọdaak-ọ. <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />Átor-otor, ọnọng kode kw'obin k'ẹnọhmma ch'atte kwaam kwiden, kw'ina k'obo ọbaan k'mbọhk s'ọvaarnọng kwaam. Okenaka, kọ atte kaam ọtọhmnọng kwọ ọbọhk, nchi ọttọhk k'okpokkoro kwọ. Bọng-ẹfa ch'mbira nyena bẹ́, mbọbh ọvaarnọng ọttọhk?”<verse eid="2SA 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29" />Ọvaarnọng oben-ẹ bẹ́, “Abir ad-agbaak mbọng o? Kk'kọ ọmaana Ziba ẹfa nnanga bẹ́, makebh owonọ nwo.”<verse eid="2SA 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30" />Mẹphiboshẹt ọpọhn-ẹ bẹ́, “Ch'ọvaarnọng kwaam ikk'otera okwuna k'ọdaam, tte kẹ ọtọka ọttọhk kpenamkpen.”<verse eid="2SA 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />Wa Bazilayi kw'ofon Gilead obir obina z'Rogẹlim okwu nya bẹ́, otor ọvaarnọng majeka ọraanga kw'Jọrdan, ọfha orik-ẹ k'eden. <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />Ny'ogbe nwo, Bazilayi kk'ọtama mawuriji. Wa node icho arọbh anna, obir ojibh-ẹ ojibh mawuriji. Wa od-oke ọvaarnọng ọbọhk k'ogbe kw'ọvaarnọng oning z'Mahanayim. <verse eid="2SA 19:32" /><verse number="33" style="v" sid="2SA 19:33" />Ọvaarnọng oben Bazilayi bẹ́, “Tor-m mojeka z'okwubha, ad-aruk amaan-m z'Jẹrusalẹm. Kaam m'nkker-ọ.”<verse eid="2SA 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34" />Okenaka, Bazilayi ọpọhna ọvaarnọng bẹ́, “Kaam m'mbira nruk mpyirẹ yen, kw'kaam m'ntor ọvaarnọng mochina z'Jẹrusalẹm? <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />Kaam ninde icho arọbh anna k'atam. Ma, nna mbira mkpo nzonga ọttọhk f'ojibh-ojibh ọmaana f'opyibh-opyibh o? Ma, nna ọtọhmnọng kwọ obir okpo olebh f'ọchattọhk, ọmaana f'atuk ọbhaanga o? Ma, ina mbira mkpo mmaanga ọkọhna kw'ajinọng, ọmaana panọng o? Kayen kw'ọtọhmnọng kwọ m'ode ẹtọhka ọnang kọ ọvaarnọng kwaam? <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />Ọtọhmnọng kwọ m'otor ọvaarnọng mojeka z'okwubha kw'ọraanga kw'Jọrdan, mobira ọtọn ozenga <char style="it">bẹ́ kẹrẹm</char>. Kayen kw'ọvaarnọng m'osi-m ẹtaamse nda? <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />Tte ọtọhmnọng kwọ ọkpa nnam z'ikẹ k'obhon, ọfha ḿpe ńnọhnga nyọma epekwuk ch'atte kwaam, ọmaana ch'akka kwaam. Okenaka, kirẹ Kimham kw'ode ọtọhmnọng kwọ ma. Tte kẹ otor ttatta kwaam majeka z'okwubha. Si ọttọhk kpenamkpen f'ọdaak-ọ, nang-ẹ.”<verse eid="2SA 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38" />Ọvaarnọng oben bẹ́, “Kimham m'ojek-ojeka ọmaan-m. Kaam m'mbira nsi ọttọhk kpenamkpen f'ọdaak-ọ, nnang-ẹ. Ọttọhk kpenamkpen f'arorọ abọbh-m, kaam m'nsi nnang-ọ.”<verse eid="2SA 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 19:39" />Nya o, anọng mbo maphyir p'ọvaarnọng matọnọ, majeka ọraanga kw'Jọrdan, pira ọvaarnọng nojek. Ọvaarnọng ojek nya o, ọbaaka Bazilayi, obir ọsẹ-ẹ ittabọhng. Bazilayi ọbhana z'obhon kwẹ.<verse eid="2SA 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40" />Ch'ọvaarnọng kk'ojeka z'okwubh kw'Gilgal, Kimham ojeka otor-ẹ. Agbongnọng p'Juda maphyir, ọmaana igboka s'agbongnọng p'Israẹl mabira ajeka akebha ọvaarnọng za.<verse eid="2SA 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41" />Ogbe kobhirẹ, anọng p'Israẹl maphyir makwu akebha ọvaar Devid, maben-ẹ bẹ́, “Ttatta, osempira ivotte pamina p'ade agbongnọng p'Juda mafu kọ ọmaana ẹsọhmmọr chọ, ọttara agbongnọng pọ maphyir matima ajeka ọraanga kw'Jọrdan?”<verse eid="2SA 19:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42" />Anọng p'Juda maphyir mapọhna anọng p'Israẹl bẹ́, “Mosi minna okurọ bẹ́, ọvaarnọng ọmaana mina mofon k'ẹbhọr danẹ. Osempira opyibh bọnga ettem o? Mba ọttọhk kpenamkpen f'mochi k'ọvaarnọng kofon. Mina m'ọttọhk kpenamkpen fẹ kobir ọtọka.”<verse eid="2SA 19:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43" />Anọng p'Israẹl apọhna anọng p'Juda bẹ́, “Mina moyen mgbega minna ijobh m'ẹvaar, mobir oyena Devid ọtam ọyọhnga bọnga. Osempira masaka mina eninga? Mina azang bọ wendo m'ochi eden oben bẹ́, motima ọvaarnọng kwamina ọkpa nnam?”</para>
  <para style="p" vid="2SA 19:43">Minna kw'anọng p'Juda mayak ọbọhk apọhna ẹkọhr-ẹkọhr ayọhnga anọng p'Israẹl.<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s1">Shẹba oke Devid ẹkọhr</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />Wa okikọhra wanẹ oning nya kw'okpen Shẹba, nnwa kw'Bikiri kw'ofon ẹkọma ch'Bẹnjamin. Ọtọk enyisa oje, ọkwọhrọ k'ẹrọng bẹ́,</para>
  <para style="q1" vid="2SA 20:1">“M'okebh ny'oyena kw'Devid koyen,</para>
  <para style="q2" vid="2SA 20:1">ọttọhk f'obira omyẹ mina ny'nnwa kw'Jẹsẹ kode!</para>
  <para style="q1" vid="2SA 20:1">Israẹl o, ọnọng-ọnọng ochina z'ọsọhm kwẹ e!”<verse eid="2SA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 20:2" />Minna kw'anọng p'Israẹl maphyir mabhumọ Devid, mator Shẹba kw'ode nnwa kw'Bikiri. Anọng p'Juda mator ọvaarnọng kwabẹ tọma z'ọraanga kw'Jọrdan maa, pyirẹ z'Jẹrusalẹm.<verse eid="2SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3" />Devid opyirẹ ny'odimpa kwẹ ny'Jẹrusalẹm, ọtọka ayok-nọng mbo pẹ ijobh p'uwa ọgbaar odimkpa, otima bẹ ochina z'ọsọhm kw'mad-akker-okkerẹ. Ọnang bẹ ọttọhk kpenamkpen f'marorọ. Okenaka, bẹ koyim ọmaana. Wa masokọ bẹ k'ọsọhm kw'nna k'iyaan makpo ayin, maruk mach'apokwa maa, opyirẹ k'ebo-wu chabẹ.<verse eid="2SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4" />Nya o, ọvaarnọng oyerẹ Amasa oben-ẹ bẹ́, “Tima iwu ittaan, yerẹ ajinọng p'Juda, ọttara kọ oyenẹ makwu aze-m.” <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />K'ogbe kw'Amasa ofon bẹ́, od-oyerẹ anọng p'Juda, okponga za maa, ọkpan ogbe kw'ọvaarnọng ọkẹ-ẹ bẹ́, ọkpa nnam.<verse eid="2SA 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6" />Nya o, Devid oben Abishayi bẹ́, “Ó̱de nna ifor samina okkerẹ, Shẹba kw'ode nnwa kw'Bikiri m'osi mina itama s'iyọhng s'Absalọm osi mina e. Tọka akkikkaama p'atte kwọ atima kwubh-ẹ. Ini minna ode, m'odim k'ibhondim s'ide ifabyi, ọnaanga mina.” <verse eid="2SA 20:6" /><verse number="7" style="v" sid="2SA 20:7" />Minna kw'ajinọng p'Joab, ọmaana anọng p'ẹkọma ch'Kẹrẹt, ọmaana ch'Pẹlẹt, ọttara akkikkaama maphyir mabin, Abishayi ochi bẹ eden, matọma ny'Jẹrusalẹm akwubh Shẹba, nnwa kw'Bikiri.<verse eid="2SA 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 20:8" />K'ogbe kw'nkk'apyira ny'ẹtakpa chiden ch'ening ny'Gibeọn o, Amasa okwu okebha bẹ nya. Ny'ogbe nwo, wa Joab ọfọr egbongkpo, ọkpa ọmaananwa kw'oyik k'ọpa ny'ikẹ k'erin. K'ose kw'ozeng ọnyọma Amasa z'ifor, ọmaananwa kwẹ ọrọhbha ny'ọpa, otto.<verse eid="2SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9" />Joab oben Amasa bẹ́, “Agbaanatte kwaam, ọsọ-ọ yen?” Pira Joab otima odimbọhk ọbọka Amasa ny'ammaphyabha bẹ́, ọbaak-ẹ. <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />Ny'ogbe nwo, Amasa otum koke bẹ́, Joab otim ọmaananwa ny'ọbọhk. Minna kw'Joab okwum-ẹ ogbe mawanẹ ny'ẹbhọr, abhọrọ ayin atto ny'izek, Amasa ope, chibhẹ ch'ina kẹ igbedim ifa akwumọ. Joab ọmaana ọgbaanotte Abishayi, machina ororo akwubh Shẹba kw'ode nnwa kw'Bikiri.<verse eid="2SA 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 20:11" />Ogbongnọng wanẹ kw'Joab obe otuma oforbukọ kw'Amasa, oben bẹ́, “Ọnọng kpenamkpen kw'obe k'Joab, ọmaana k'Devid, tte otor Joab!” <verse eid="2SA 20:11" /><verse number="12" style="v" sid="2SA 20:12" />Amasa oyima ny'azẹ pẹ ny'edenttem. Ọnọng kpenamkpen kw'opyirẹ nya, obe nya. K'ogbe kw'oze bẹ́, ọnọng kpenamkpen kw'opyirẹ nya od-obe, minna kw'ọtọrọ Amasa otima odim ny'owonọ wanẹ, obubh-ẹ ibara. <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />Ch'nkk'Amasa atina ny'eden o, ogbongnọng kpenamkpen otor Joab makwubh Shẹba, nnwa kw'Bikiri.<verse eid="2SA 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />Shẹba ozenga ny'nkọma s'Israẹl maphyir ochina z'Abẹl-Bẹt-Maka. Obira ozenga ọkọbha ẹbhaakẹ ch'anọng p'Bikiri maphyir. Anọng p'obhon nwo, madanga ator-ẹ. <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />Minna kw'agbongnọng p'Joab maphyir makwu akọbha Shẹba ake k'ettem z'Abẹl-Bẹt-Maka. Masi abhukakpa ny'nnam-nnam kw'ntumọ s'ọbaaka kw'obhon nwo. Ch'mad-akonga bẹ́, mavọhkọ ntumọ njo, itto k'izek, <verse eid="2SA 20:15" /><verse number="16" style="v" sid="2SA 20:16" />odikzonga-kwanọng wanẹ oyin ny'obhon, ọkwọhrọ k'ẹrọng bẹ́, “Màyonga itọhng e! Màben Joab okwu ma, ọfha mgbaak-ẹ odik.” <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />Joab ozenga okebh-ẹ za. Kwanọng nwo ọbọbh-ẹ bẹ́, “Kọ wọ akpen Joab o?”</para>
  <para style="p" vid="2SA 20:17">Ọpọhna bẹ́, “Iye, kaam wọ.”</para>
  <para style="p" vid="2SA 20:17">Kwanọng nwo oben-ẹ bẹ́, “Yong itọhng k'odik kw'ọtọhmnọng kwọ m'ọgbaak.”</para>
  <para style="p" vid="2SA 20:17">Joab oben-ẹ bẹ́, “Nyong-ọ itọhng ka.”<verse eid="2SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18" />Kwanọng nwo oben-ẹ bẹ́, “Wa mad-aben ẹtama bẹ́, ‘Zọhng tọka ntọhna z'Abẹl’, minna kw'odik nwo m'oyena eso. <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />Mina mode anọng p'ayen ẹmem, mobir okpobha ẹvaar ch'Israẹl. Bọnga mad-akam bẹ́, makibhẹ ọmmaanabhon kw'Israẹl. Kayen kw'nd-aben bẹ́, madimẹ obhon kw'Ọvaar Ibinọkpaabyi o?”<verse eid="2SA 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20" />Joab ọpọhn-ẹ bẹ́, “Tcha! Minna mode. Kaam azang m'nkibhẹ, kaam azang m'ndimẹ! <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />Odik oyenẹ azang nya e. Ojinọng wanẹ oning m'obhon nwa kw'okpen Shẹba, nnwa kw'Bikiri kw'ofon ẹkọma ch'agbe, z'Ephraim. Kẹ wọ ọmyan ẹvaar ch'Devid. Tọka ọnọng nwo kẹ-kẹ nang-m, kaam m'ntte ebhondim nda ọbọhk.”</para>
  <para style="p" vid="2SA 20:21">Kwanọng nwo oben Joab bẹ́, “Mm'azenga ny'etumọ abharẹ eso chẹ anang-ọ.”<verse eid="2SA 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22" />Kwanọng nwo o, otima ntọhna njo sẹ ọkkọkka okebha anọng maphyir za. Mabọka Shẹba kw'ode nnwa kw'Bikiri, mape eso, mabharẹ chẹ anang Joab. Minna kw'Joab oje enyisa, agbongnọng pẹ maphyir mabina arik ebhondim ndo, ọnọng-ọnọng ọbhana z'obhon kwẹ. Joab ọkpa nnam okebha ọvaarnọng z'Jẹrusalẹm.<verse eid="2SA 20:22" /></para>
  <para style="s1">Asonọng p'Devid</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23" />Joab wọ uwa ode oso kw'agbongnọng p'Israẹl maphyir. Bẹnaya kw'ode nnwa kw'Jehoyada, ode oso kw'anọng p'ẹkọma ch'Kẹrẹt ọmaana ch'Pẹlẹt. <verse eid="2SA 20:23" /><verse number="24" style="v" sid="2SA 20:24" />Adoniram wọ uwa od-okkerẹ anọng p'ad-asi atọhm-gbọhka. Jẹhosaphat kw'ode nnwa kw'Ahilud, ode ọkkẹrẹ kw'idik s'ikk'iyina, <verse eid="2SA 20:24" /><verse number="25" style="v" sid="2SA 20:25" />Sheva ode ọkkẹrẹ. Zadọk ọmaana Abiyata, made afọhn-nja p'Ibinọkpaabyi. <verse eid="2SA 20:25" /><verse number="26" style="v" sid="2SA 20:26" />Ira kw'ofon Jair ode ọfọhn-nja kw'Devid.<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s1">Devid otuk ọttọhk f'Saul osi anọng p'Gibeọn</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />K'ogbe kw'Devid ọbaabh, wa okwo fiden oning <char style="it">bẹ́ yẹrr</char> k'icho minna ọttaan. Ofona nya, Devid ọd-ọbọbh Ọvaar Ibinọkpaabyi odik nwo. Ọvaar Ibinọkpaabyi ọpọhna bẹ́, “Odik nwo ofon k'epinẹ ch'Saul, ọmaana ẹsọhmmọr chẹ masi ch'mafhọ anọng p'Gibeọn.”<verse eid="2SA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 21:2" />Ọvaar Devid oyerẹ anọng p'Gibeọn, ọgbaak odik ọnang bẹ. Wa anọng p'Gibeọn m'Israẹl kafon. Bẹ made anọng p'Amọr p'egbong echi erik. Wa anọng p'Israẹl kk'acheka bẹ́, mm'atte bẹ ọbọhk maruk. Okenaka, Saul ọkam bẹ́, ọfhọ bẹ okurọ ettem ch'oyik k'Israẹl ọmaana Juda. <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />Devid ọbọbh anọng p'Gibeọn bẹ́, “Bọng-ọttọhk f'im'nsi nnang bọnga o? Yen kw'im'nsi efokọ, mfha bọnga masi anọng p'Ọvaar Ibinọkpaabyi ittabọhng o?”<verse eid="2SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4" />Anọng p'Gibeọn apọhn-ẹ bẹ́, “Mina m'ẹfa koyen ch'mm'oben Saul ọmaana ẹsọhmmọr chẹ bẹ́, manang mina gol ọmaana silva. M'ẹfa kobir oyena bẹ́, mọfhọ ọnọng kpenamkpen kw'Israẹl.”</para>
  <para style="p" vid="2SA 21:4">Devid ọbọbh bẹ bẹ́, “Bọng-ọttọhk f'marorọ bẹ́, nsi nnang bọnga o?”<verse eid="2SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5" />Mapọhna ọvaarnọng bẹ́, “Ṉ́nòde ọnọng nwo kw'ọfhọ mina, ochi mina ikwu bẹ́, odimẹ mina eche, mfha moning ibyi kpenamkpen m'Israẹl oyen, <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />tọka ajinọng achenọmfa p'afon ny'ikẹ k'ntaak nang mina m'ọfhọ, mọjaan aforbukọ pabẹ ny'ititika s'Ọvaar Ibinọkpaabyi, z'Gibea kw'ode obhon kw'Saul kw'Ọvaar Ibinọkpaabyi ikk'oteka.”</para>
  <para style="p" vid="2SA 21:6">Nya o, ọvaar Devid oben bẹ́, “Kaam m'ntte bẹ ọbọhk otte nnang bọnga.”<verse eid="2SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7" />Ọvaarnọng otte Mẹphiboshẹt kw'ode nnwa kw'Jonatan kw'Saul obhonọ ọbọhk bẹ́, oruk akpen, okurọ nwọhngọ s'iwa Devid ọmaana Jonatan matọk k'ititika s'Ọvaar Ibinọkpaabyi. <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" />Okenaka, ọvaarnọng ọtọka Armọni, ọmaana Mẹphiboshẹt, p'ade iva afa p'Rizpa kw'ode ominanwa kw'Aiya ọmaanẹ ọnang Saul, ọttara ajinọngva achen p'Mẹrab kw'ode ominanwa kw'Saul ọmaanẹ ọnang Adriyẹl kw'Barzilayi kw'ofon Mẹhola, obhonọ. <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />Otte bẹ ọbọhk ọnang anọng p'Gibeọn. Mafhọ bẹ anọng nso njo ichenọmfa, matọka aforbukọ pabẹ arena k'egbe, majan ny'ititika s'Ọvaar Ibinọkpaabyi. Wa mafhọ bẹ ny'echedenwu ch'ipha osisi, nya ch'ipha s'barli id-itọm-ọtọma.<verse eid="2SA 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10" />Rizpa kw'ode ominanwa kw'Aiya ọtọka ọbarabina ọjẹ k'ẹtakpa. Oninga nya ch'ipha njo itọm maa, ẹrọng etebh aforbukọ mbo, od-okwubh ọnọhn k'ẹya, k'erungọ okwubh mgbaten. <verse eid="2SA 21:10" /><verse number="11" style="v" sid="2SA 21:11" />K'ogbe kw'matekẹ Devid ọttọhk f'oyok-nọng kw'Saul kw'ode Rizpa kw'Aiya ọmaanẹ ikk'ọsa, <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />obina od-okpokọ akọbhọ p'Saul ọmaana p'nnwa kwẹ Jonatan z'anọng p'Jabẹsh-Gilead. Wa anọng p'Jabẹsh-Gilead mafu aforbukọ mbo z'ẹbhaama ch'Bẹt-Shan, za ch'iwa aPhilistiya aren bẹ ch'nkk'bẹ afha z'Gilboa. <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />Devid okpokọ akọbhọ p'Saul ọmaana p'nnwa kwẹ Jonatan, ọttara p'ayok mboza p'uwa mafhọ arena nya, otima okwuna.<verse eid="2SA 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 21:14" />Manọhnga akọbhọ mbo p'Saul ọmaana p'nnwa kwẹ Jonatan z'epekwuk ch'Kish kw'obhonọ Saul, z'Zẹla kw'oning z'ẹkọma ch'Bẹnjamin, mabir asi ọttọhk kpenamkpen f'ọvaarnọng obenẹ. Macher nya o, Ibinọkpaabyi ọbhaanga njọm s'izek njo.<verse eid="2SA 21:14" /></para>
  <para style="s1">Mgbong s'marim ọmaana aPhilistiya</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />Wa egbong ch'aPhilistiya ọmaana anọng p'Israẹl ebir etto. Devid otima ajinọng pẹ od-orima aPhilistiya ábẹ̀ maa, ọkọhn-ẹ. <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />Wa ọnọng wanẹ kw'okpen Ishbi-Bẹnọb kw'ofon k'ntaak s'Rapha kw'ẹkọhnso chẹ ede bronz kw'adọhbhiji pẹ made ashẹkẹl arọbh ichi, obir ọdaabh ọkkangkkang ọbhakwẹ, oben bẹ́, m'ọfhọ Devid. <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />Okenaka, Abishayi nnwa kw'Zeruya ọkkaana Devid, ọfhọ oPhilistiyanọng nwo. Minna kw'ajinọng p'Devid machekẹ anang Devid bẹ́, “Ọdọk mina màtor moyin egbong, ọfha ottoringkkang kw'Israẹl oning odimẹ.”<verse eid="2SA 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18" />Otum k'ogbe, egbong ebir etto ẹmaana aPhilistiya z'Gọb. M'ogbe nwa, Sibẹkayi kw'ofon Hushat ọfhọ Saph kw'ofon k'ntaak s'Rapha.<verse eid="2SA 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19" />Egbong ọdọk-ọdọk ebir etto ẹmaana aPhilistiya z'Gọb, Ẹlhanan kw'ode nnwa kw'Jair kw'ofon Bẹtẹlẹhẹm, ọfhọ ọgbaanọkka kw'Golayat kw'ofon Git, kw'ẹbọhk-bọka ch'ọkọhn fẹ ede mach'ẹbaanga ch'mad-atima ayok ekpo.<verse eid="2SA 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20" />K'egbong danẹ ch'ebir etto z'Gat, oyen ojinọng wanẹ kw'ọbarẹ-iduka, omen nnọhna ichadanẹ z'mbọhk, ichadanẹ z'mmo. Kibung-kibungọ, omenẹ nnọhna ẹrọbh okwuma nna. Wa ojinọng nwo obir ofona k'ntaak s'Rapha. <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />Ojinọng nwo ọlọhkọ Israẹl. Jonatan nnwa kw'Shimeyi kw'ode ọgbaanọkka kw'Devid, ọfhẹ-ẹ.<verse eid="2SA 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22" />Anọng mboma anna p'Devid ọmaana ajinọng pẹ mafhọ, wa mafon k'ntaak s'Rapha, z'Gat.<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s1">Ẹmọng ch'Devid ch'ẹtọhnga</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />Ch'iwa Ọvaar Ibinọkpaabyi ọrọhbh Devid z'mbọhk s'Saul ọmaana awawunanọng pẹ, wa ọkkọhnọ ẹmọng nda ọnang Ọvaar Ibinọkpaabyi. <verse eid="2SA 22:1" /><verse number="2" style="v" sid="2SA 22:2" />Oben bẹ́,</para>
  <para style="q1" vid="2SA 22:2">“Ọvaar Ibinọkpaabyi wọ ode Ẹtakpa chaam,</para>
  <para style="q2" vid="2SA 22:2">ọmaana ifabyi saam, ọttara Ọkkaan kwaam.<verse eid="2SA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 22:3" />Ibinọkpaabyi kwaam wọ ode Ẹtakpa chaam, kẹ wọ kw'njen.</para>
  <para style="q2" vid="2SA 22:3">Kẹ wọ ode ogbongtegba kwaam, ọmaana ẹfa ch'esi-m nnaanga.</para>
  <para style="q1" vid="2SA 22:3">Kẹ wọ ode itubhabyi saam, ọmaana ifabyi saam, ọttara Ọkkaan kwaam.</para>
  <para style="q2" vid="2SA 22:3">Kọ wọ asi-m nnaanga z'mbọhk s'akikọhra.<verse eid="2SA 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4" />“Kaam nyerẹ Ọvaar Ibinọkpaabyi kw'ọbaan ẹtọhnga,</para>
  <para style="q2" vid="2SA 22:4">ọkkaan-m nnaanga k'mbọhk s'awawunanọng paam.<verse eid="2SA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5" />Obo kk'aam amma ọnwọna ọkọbha,</para>
  <para style="q2" vid="2SA 22:5">ebhobh ch'obo ẹna-m ẹfa.<verse eid="2SA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6" />Ndik s'epekwuk iyok ikọbh-m,</para>
  <para style="q2" vid="2SA 22:6">obo ọnwọn-m amma.<verse eid="2SA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7" />Nning ny'damadama kwaam nyerẹ Ọvaar Ibinọkpaabyi;</para>
  <para style="q2" vid="2SA 22:7">nyerẹ Ibinọkpaabyi kwaam.</para>
  <para style="q1" vid="2SA 22:7">Oninga z'ikẹ k'ọsọhm, ọbhaanga ẹmọng chaam.</para>
  <para style="q2" vid="2SA 22:7">Ẹmọng ch'mmomọ, ẹttẹ-ẹ k'itọhng.<verse eid="2SA 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8" />“Iyagbin ifọnọ ibira inyengẹ.</para>
  <para style="q2" vid="2SA 22:8">Ibyi s'ọrọngkpakpa ottim inyengẹ</para>
  <para style="q2" vid="2SA 22:8">okurọ ch'Ibinọkpaabyi ọdọk-ẹ.<verse eid="2SA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9" />Isisong iyin-ẹ k'asungma,</para>
  <para style="q2" vid="2SA 22:9">akpondaak p'akọm-ọkọm ayin-ẹ z'ẹmma,</para>
  <para style="q2" vid="2SA 22:9">akpongkkang p'ayaak-ọyaak ajerẹ k'ẹrọng.<verse eid="2SA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10" />Odwu ọrọngkpakpa, ọsaka.</para>
  <para style="q2" vid="2SA 22:10">Ọbarẹ mmo k'ebonọ ch'ọrọngkpakpa ch'epyi <char style="it">bẹ́ kkang</char>.<verse eid="2SA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11" />Ọnana k'cherubim okwur.</para>
  <para style="q2" vid="2SA 22:11">Mbubaang s'ofum itim-ẹ ichọhnga.<verse eid="2SA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12" />Otima orungibanga obubha ifor sẹ,</para>
  <para style="q2" vid="2SA 22:12">kw'ode ẹrọng ch'epyi-opyi z'ọrọngkpakpa.<verse eid="2SA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13" />Ọyaanttaana kw'ititika sẹ,</para>
  <para style="q2" vid="2SA 22:13">osi akponkkang awọma.<verse eid="2SA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14" />Ọvaar Ibinọkpaabyi oninga z'ẹrọng ọtta ẹbhaangkpon.</para>
  <para style="q2" vid="2SA 22:14">Ọgbaakadik kw'Ọvaar Ibinọkpaabyi kw'Ọyọhng ọchọhnga k'ẹrọng.<verse eid="2SA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15" />Kẹ ọtta ayuk pẹ otima ọraamẹ awawunanọng,</para>
  <para style="q2" vid="2SA 22:15">otima akpongkkang p'ayak-ọyak, orima bẹ ábẹ̀.<verse eid="2SA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16" />Ẹmọng ch'Ọvaar Ibinọkpaabyi ọkwọhrọ,</para>
  <para style="q2" vid="2SA 22:16">ọmaana iwọhng s'iyin-ẹ ny'asungma,</para>
  <para style="q1" vid="2SA 22:16">isi adongiji p'ọraanga kwiden ayaakẹ k'ọyaankpa,</para>
  <para style="q2" vid="2SA 22:16">ibira isi agbaarẹ p'ọraanga kwiden ajan k'iyaan.<verse eid="2SA 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17" />“Oninga z'ẹrọng onemẹ ọbọhk ọbọk-m,</para>
  <para style="q2" vid="2SA 22:17">ọrọhbh-m z'asi p'adong-odong.<verse eid="2SA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18" />Obir ọrọhbh-m z'mbọhk s'awawunanọng paam p'ayen ẹfa,</para>
  <para style="q2" vid="2SA 22:18">ọmaana z'mbọhk s'attangẹ-ttangẹ-nọng p'ayọhng-m ẹfa.<verse eid="2SA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19" />Bẹ marim-m ábẹ̀ k'ogbe kw'idik ikebh-m,</para>
  <para style="q2" vid="2SA 22:19">okenaka, Ọvaar Ibinọkpaabyi oke-m ẹfa.<verse eid="2SA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20" />Kẹ kk'aam otima ochina k'ibyi s'iwen ẹkpa,</para>
  <para style="q2" vid="2SA 22:20">okurọ k'ottemdaam kw'oyen ọmaan-m.<verse eid="2SA 22:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21" />“Ọvaar Ibinọkpaabyi kk'ọsa ọnang-m otor k'atoriji paam.</para>
  <para style="q2" vid="2SA 22:21">Kk'aam ọtaama otor k'awuriji p'mbọhk saam.<verse eid="2SA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22" />Kaam kk'nden s'Ọvaar Ibinọkpaabyi ntora.</para>
  <para style="q2" vid="2SA 22:22">Kaam Ọvaar Ibinọkpaabyi kimpinẹ, okurọ bẹ́, nnam kimkpa mbọr-ẹ.<verse eid="2SA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23" />Apaanga pẹ maphyir aning-m k'ettem,</para>
  <para style="q2" vid="2SA 22:23">asana pẹ kimbhumọ.<verse eid="2SA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24" />Kaam epyima z'ikẹ k'ititika kinyen,</para>
  <para style="q2" vid="2SA 22:24">kaam epyibha kinsi.<verse eid="2SA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25" />Ọvaar Ibinọkpaabyi kk'aam ọtaama otor k'atoriji paam,</para>
  <para style="q2" vid="2SA 22:25">obir otor k'ose kw'nwurọ s'ikẹ k'ititika.<verse eid="2SA 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26" />“Ayok p'ayen ichichera k'ikọ bọ p'ad-akọhka ichichera,</para>
  <para style="q2" vid="2SA 22:26">akọhka anọng p'nna epyima ayen bẹ́, kọ epyima kayen.<verse eid="2SA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27" />Ayok p'awurọ ettem bọ p'ad-akọhka bẹ́, kọ awurọ ettem,</para>
  <para style="q2" vid="2SA 22:27">okenaka, anọng p'atukọ anọng bọ p'ad-akọhka bẹ́, kọ adong-odongọ.<verse eid="2SA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28" />Kọ ad-akkaana anọng p'asak ifor.</para>
  <para style="q2" vid="2SA 22:28">Ṉ́nòdè anọng p'age ifor, akkerẹ bẹ ichen, ọfha asak bẹ eninga.<verse eid="2SA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29" />O Ọvaar Ibinọkpaabyi, kọ wọ ade ottoringkkang kwaam.</para>
  <para style="q2" vid="2SA 22:29">Ọvaar Ibinọkpaabyi ọbhakẹ orungibanga kwaam ozeng ọyaanttaana.<verse eid="2SA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30" />Ẹkkaana chọ ch'im'ntima mkpo nrima agbongnọng ábẹ̀,</para>
  <para style="q2" vid="2SA 22:30">mbira nna bẹ mkpang, okurọ bẹ́, Ibinọkpaabyi kwaam obe ọmaan-m.<verse eid="2SA 22:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31" />“Osisi kw'Ibinọkpaabyi otor-otor,</para>
  <para style="q2" vid="2SA 22:31">ọgbaakadik kw'Ọvaar Ibinọkpaabyi ode <char style="it">bẹ́ gbẹẹng</char>.</para>
  <para style="q2" vid="2SA 22:31">Kẹ ọd-ọkaam anọng maphyir p'arọbhọ ajen-ẹ.<verse eid="2SA 22:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32" />Anyi wọ ode Ibinọkpaabyi, kw'ọkpanẹ Ọvaar Ibinọkpaabyi?</para>
  <para style="q2" vid="2SA 22:32">Anyi wọ obira ode Ẹtakpa, kw'ọkpanẹ Ibinọkpaabyi?<verse eid="2SA 22:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33" />Kẹ Ibinọkpaabyi wọ ọnang-m ẹfa,</para>
  <para style="q2" vid="2SA 22:33">obira okkerẹ ozengabho kwaam.<verse eid="2SA 22:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34" />Kẹ osi mmokpatọkọ saam ide mach'mmokpatọkọ s'ochimẹ,</para>
  <para style="q2" vid="2SA 22:34">osi-m mbe k'obyi f'ogor-ogorọ.<verse eid="2SA 22:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35" />Kẹ ọchọhm-m mbọhk s'egbong oririma,</para>
  <para style="q2" vid="2SA 22:35">ọfha mkpo oyuk kw'ode opo nnyọhngọ.<verse eid="2SA 22:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36" />Kọ anang-m ogbongtegba kwọ kw'ẹnaanga.</para>
  <para style="q2" vid="2SA 22:36">Ẹkkaana chọ kk'aam ẹsa nyena eche.<verse eid="2SA 22:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37" />Kọ asi eden ch'nzeng ewen ẹkpa,</para>
  <para style="q2" vid="2SA 22:37">ọfha mmodọngọ ining-m ikwok.<verse eid="2SA 22:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38" />“Kaam nkwubhọ awawunanọng paam maa, mfhọ bẹ.</para>
  <para style="q2" vid="2SA 22:38">Nnam kimbhakẹ maa, mfhọ bẹ.<verse eid="2SA 22:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39" />Mfhọ bẹ, mbarẹ bẹ ntọkọ,</para>
  <para style="q2" vid="2SA 22:39">ọnọng kw'oge eso kode.<verse eid="2SA 22:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40" />Kọ anang-m ẹfa ch'egbong oririma,</para>
  <para style="q2" vid="2SA 22:40">abir asi anọng p'arim-m ábẹ̀, maraka nso anang-m.<verse eid="2SA 22:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41" />Kọ asi awawunanọng paam marọbh-m,</para>
  <para style="q2" vid="2SA 22:41">mbir mfhọ ayok p'attaang-m ọttaangẹ.<verse eid="2SA 22:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42" />Mabhom ẹkkaana, okenaka, ọnọng kw'ọkkaan bẹ kode.</para>
  <para style="q2" vid="2SA 22:42">Mabhom ayerẹ Ọvaar Ibinọkpaabyi, okenaka, bẹ ẹmọng kosi.<verse eid="2SA 22:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43" />Nkok bẹ maa, mazeng oyiyeng,</para>
  <para style="q2" vid="2SA 22:43">mbir mbarẹ bẹ ntọkọ mach'alilọhbhọ p'adenkpaarẹ.<verse eid="2SA 22:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44" />“Kk'aam arọhbha k'mbọhk s'anọng p'arim-m ábẹ̀,</para>
  <para style="q2" vid="2SA 22:44">abir asok-m mach'oso kw'nkọma.</para>
  <para style="q1" vid="2SA 22:44">Anọng p'uwa kaam ina nzong, bẹ bọ nnade atọhmnọng paam menda.<verse eid="2SA 22:44" /></para>
  <para style="q2">
    <verse number="45" style="v" sid="2SA 22:45" />Akkikkennọng nnarak eso anang-m.</para>
  <para style="q2" vid="2SA 22:45">Mabhubhaanga ọgbaakadik kwaam, manang-m ikpukpobha.<verse eid="2SA 22:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46" />Nttem ibhaaka bẹ maphyir, <char style="it">bẹ́ waaa</char></para>
  <para style="q2" vid="2SA 22:46">mafọnọ-ọfọnọ z'ọfabyi fabẹ.<verse eid="2SA 22:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47" />“Ọvaar Ibinọkpaabyi orukọ akpen! Ẹtọhnga ede ch'Ẹtakpa chaam!</para>
  <para style="q2" vid="2SA 22:47">Etina k'ẹrọng ede ch'Ibinọkpaabyi, kw'ode Ẹtakpa ọmaana Ọkkaan kwaam!<verse eid="2SA 22:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48" />Kẹ wọ ode Ibinọkpaabyi kw'od-otuka idik saam.</para>
  <para style="q2" vid="2SA 22:48">Ke wọ obir ọtọka nkọma osok izek-izek kwaam.<verse eid="2SA 22:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="2SA 22:49" />Kẹ wọ osi-m nnaanga z'mbọhk s'awawunanọng paam.</para>
  <para style="q1" vid="2SA 22:49">Atọka anọng p'attaang-m, asok izek-izek kwaam,</para>
  <para style="q2" vid="2SA 22:49">abir arọbh-m z'mbọhk s'okikọhra.<verse eid="2SA 22:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50" />Ofona nya, O Ọvaar Ibinọkpaabyi, kaam m'ntọhng-ọ k'ikpakaana s'nkọma.</para>
  <para style="q2" vid="2SA 22:50">M'mbira nkkọhn amọng ntima ntọhnga eche chọ.<verse eid="2SA 22:50" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51" />“Kẹ ọnang ọvaarnọng kwẹ nkema siden,</para>
  <para style="q2" vid="2SA 22:51">ọkọhka ọnọng kw'ikk'ana obyenga k'eso ọdaakẹ kwẹ kw'ina etuna oyen,</para>
  <para style="q2" vid="2SA 22:51">kw'ode Devid ọttara iva p'iva pẹ, ttattampe.”<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s1">Ikpongannamdik s'Devid ọgbaakẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />Ma wọ ode ikpongannamdik s'Devid ọgbaakẹ:</para>
  <para style="q1" vid="2SA 23:1">Ọgbaakadik kw'obin ọnọng ifor kw'Devid kw'ode nnwa kw'Jẹsẹ,</para>
  <para style="q2" vid="2SA 23:1">ọgbaakadik kw'ojinọng kw'Ibinọkpaabyi kw'Ọyọhng ikk'otina k'ẹrọng,</para>
  <para style="q1" vid="2SA 23:1">ojinọng kw'Ibinọkpaabyi kw'Jekọb ikk'ana obyenga k'eso,</para>
  <para style="q2" vid="2SA 23:1">okem-akpa k'ọkkọhna kw'amọng p'Israẹl:<verse eid="2SA 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 23:2" />“Egwugwuma ch'Ọvaar Ibinọkpaabyi etim-m ẹgbaak odik,</para>
  <para style="q2" vid="2SA 23:2">ọgbaakadik kwẹ oning-m m'ẹdaak.<verse eid="2SA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3" />Ibinọkpaabyi kw'Israẹl ọgbaak odik,</para>
  <para style="q2" vid="2SA 23:3">Ẹtakpa ch'Israẹl eben-m bẹ́,</para>
  <para style="q1" vid="2SA 23:3">‘K'ogbe kw'ẹbaabha ch'ọnọng etor-otor,</para>
  <para style="q2" vid="2SA 23:3">k'ogbe kw'ikẹ ọbaabh ọmaana opoma f'Ibinọkpaabyi,<verse eid="2SA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 23:4" />kẹ ode mach'ọyaanttaana kw'echekira ch'ekpebha,</para>
  <para style="q2" vid="2SA 23:4">k'okpebhawu kw'ebonọ nede,</para>
  <para style="q1" vid="2SA 23:4">ẹmaanẹ mach'ogbe kw'ẹrọng ikk'ebhira,</para>
  <para style="q2" vid="2SA 23:4">ch'esi azizaarẹ amen k'izek.’<verse eid="2SA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5" />“Wura ẹsọhmmọr chaam ina etorọ z'Ibinọkpaabyi k'ititika,</para>
  <para style="q2" vid="2SA 23:5">k'odik ọkkọkka, wura kẹ kaam echekẹ ch'ttattampe kosi ọmaana,</para>
  <para style="q2" vid="2SA 23:5">otobha dẹ od-osok k'ẹbhaakẹ kpenamkpen.</para>
  <para style="q1" vid="2SA 23:5">K'odik ọkkọkka, wura kẹ ẹnaanga chaam kosi eyin k'eden,</para>
  <para style="q2" vid="2SA 23:5">obira ọnang-m okpenamkpen f'nnorọ.<verse eid="2SA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6" />Okenaka, abyibyanọng maphyir bọ p'mabharẹ okikaan mach'akkaangẹ</para>
  <para style="q2" vid="2SA 23:6">p'nna ọbọhk ad-atima atobha.<verse eid="2SA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7" />Ọnọng kpenamkpen kw'otwu akkaangẹ,</para>
  <para style="q2" vid="2SA 23:7">od-otima ẹbaanga, wanẹma ẹbọhk-bọka ch'ọkọhn;</para>
  <para style="q2" vid="2SA 23:7">mad-akwọmọ akkaangẹ ny'ibyi s'maning.”<verse eid="2SA 23:7" /></para>
  <para style="s1">Akkikkaama p'Devid</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8" />Ma wọ ode ache p'akkikkaama p'Devid:</para>
  <para style="p" vid="2SA 23:8">Joshẹb-Bashẹbẹt kw'ofon Takemọn, wọ uwa ode oso kw'anọng mbo attaan. Kẹ wọ uwa otim ọkọhn ọfhọ anọng nnọhna mfa k'ẹrima madanẹ.<verse eid="2SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9" />Ọnọng kw'uwa otor-ẹ okpen Ẹleaza kw'ode nnwa kw'Dodo kw'ofon Aho. Kẹ mach'ọnọng wanẹ kw'ọttar ny'akkikkaama mbo attaan, wa od-oninga ọmaana Devid k'ogbe kw'mad-agbokọ aPhilistiya p'nkk'attonga z'Pas Damin bẹ́, marima egbong. Nya o, anọng p'Israẹl atọr ifor, <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />Ẹleaza ọgaangẹ ettem, odo obe, ọfhọ aPhilistiya maa, ọbọhk okwok-ẹ, obir ọraakẹ z'ọkkangkkang. Ny'ewu ndo, Ọvaar Ibinọkpaabyi ọnang bẹ ekema chiden. Agbongnọng mbo makpa nnam akebha Ẹleaza bẹ́, mad-awọra affuranọng mbo ekpo byẹ-byẹ.<verse eid="2SA 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11" />Ọnọng kw'uwa obira otor-ẹ okpen Shama kw'ode nnwa kw'Agi kw'ofon Hara. K'ogbe kw'aPhilistiya akwu attonga k'ibyi janẹ s'iwa ide ẹkpẹmẹ ch'eyen akpomọmakira banẹ, agbongnọng p'Israẹl marọbh. <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />Okenaka, Shama odo obe ny'ottem kw'owonọ nwo, ọkpa aPhilistiya eden, obira ọfhọ bẹ. Wa Ọvaar Ibinọkpaabyi ọnang-ẹ ekema chiden.<verse eid="2SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13" />Ny'ọphagbe, ajinọng attaan ny'ẹkaan ch'akkikkaama mbo ẹrọbh okwuma ijobh p'ade aso, mabina ad-akebha Devid z'ọtakpamma kw'Adulam, k'ogbe kw'ẹkaana danẹ ch'aPhilistiya etim ebhingẹ z'ilokodo s'Rephayim. <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />Ny'ogbe nwo, Devid oning z'ifabyi, anọng p'Philistiya abira aninga z'ibyi s'agbongnọng ad-aruk, z'Bẹtẹlẹhẹm. <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />Asi akwu adaak Devid, oben bẹ́, “O, wúra ọ́nọng m'okpo ọkaabha asi z'esipe ch'ẹnyọm ebhumma ch'Bẹtẹlẹhẹm ọnang-m ngwo o!” <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />Minna kw'akkikkaama mbo attaan mabin ajeka ny'igbong-titika s'aPhilistiya, mad-akaabha asi z'esipe ndo ch'ẹnyọm ebhumma ch'Bẹtẹlẹhẹm, machena Devid. Devid obhum asi mbo ogwugwo, otera obyenga pẹ ọnang Ọvaar Ibinọkpaabyi. <verse eid="2SA 23:16" /><verse number="17" style="v" sid="2SA 23:17" />Oben bẹ́, “O Ọvaar Ibinọkpaabyi, okwurọ-dik wọ bẹ́, nsi ọttọhkse mva e! Ọzẹ f'anọng p'atim obo ayenẹ ikebh azang ma o?” Devid obhum asi mbo ogwugwo.</para>
  <para style="p" vid="2SA 23:17">Idik s'iwa akkikkaama mbo attaan asi jọ ma.<verse eid="2SA 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18" />Abishayi kw'ode ọgbaanotte kw'Joab kw'Zeruya obhonọ wọ uwa ode oso kw'anọng mbo attaan. Kẹ wọ iwa otim ọkọhn ọfhọ anọng arọbh ichi. Ofona nya o, oyin eche mach'anọng mbo attaan. <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />Kẹ wọ uwa nokpobh ọtam ọyọhnga anọng mbo attaan. Okwu ode otim-eden kwabẹ, chibhẹ ch'iwa ina k'ẹkaan chabẹ, ọttar.<verse eid="2SA 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20" />Bẹnaya kw'ode ojinọngnwa kw'Jẹhoyada, okkikkaama kw'ofon ẹkọma ch'Kabzil, obira osi mawuriji. Wa ọfhọ akkikkaama p'Moab afa p'akkaamẹ ọtam ayọhnga ayok. Kẹ wa obira ọsaka ọd-ọfhọ eche z'epe ẹtaanga k'ewu danẹ ch'ifọhng itebhẹ. <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />Kẹ wa obira ọfhọ oJipnọng wanẹ kw'ọbarẹ ẹffa mawuriji. Chibhẹ ch'iwa oJipnọng nwo otim ọkọhn, Bẹnaya otima ichikwuma orim-ẹ ábè maa, ọna oJipnọng nwo ọkọhn mvo, otima ọbhakẹ ọfhẹ-ẹ. <verse eid="2SA 23:21" /><verse number="22" style="v" sid="2SA 23:22" />Minna wọ kw'uwa adongiji p'Bẹnaya kw'Jẹhoyada obhonọ made. Kẹ wa obira oyinẹ eche mach'akkikkaama mbo attaan. <verse eid="2SA 23:22" /><verse number="23" style="v" sid="2SA 23:23" />Wa makpobh-ẹ ọtam ayọhnga ayok ny'ẹkaan ndo ch'anọng ẹrọbh okwuma ijobh. Okenaka, wa kẹ nya akkikkaama mbo attaan kọttar. Devid ọsẹ-ẹ oso kw'anọng p'ad-akker-ẹ.<verse eid="2SA 23:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="2SA 23:24" />Anọng p'uwa attar ny'ẹkaan ndo ch'anọng ẹrọbh okwuma ijobh made:</para>
  <para style="li2" vid="2SA 23:24">Asahẹl kw'ode ọgbaanotte kw'Joab,</para>
  <para style="li2" vid="2SA 23:24">ọmaana Ẹlhanan kw'ode nnwa kw'Dodo kw'ofon Bẹtẹlẹhẹm,<verse eid="2SA 23:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="2SA 23:25" />ọmaana Shama kw'ofon Harọd,</para>
  <para style="li2" vid="2SA 23:25">ọmaana Ẹlika kw'obira ofona Harọd,<verse eid="2SA 23:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="2SA 23:26" />ọmaana Hẹlẹz kw'ofon Palti,</para>
  <para style="li2" vid="2SA 23:26">ọmaana Ira kw'ode nnwa kw'Ikẹsh kw'ofon Tẹkoa,<verse eid="2SA 23:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="2SA 23:27" />ọmaana Abiyẹza kw'ofon Anatọt,</para>
  <para style="li2" vid="2SA 23:27">ọmaana Sibẹkayi kw'ofon Hushat,<verse eid="2SA 23:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="2SA 23:28" />ọmaana Zalmọn kw'ofon Aho,</para>
  <para style="li2" vid="2SA 23:28">ọmaana Maharayi kw'ofon Nẹtophat,<verse eid="2SA 23:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="2SA 23:29" />ọmaana Hẹlẹd kw'ode nnwa kw'Baana kw'obira ofona Nẹtophat,</para>
  <para style="li2" vid="2SA 23:29">ọmaana Itayi kw'ode nnwa kw'Ribayi kw'ofon Gibea z'Bẹnjamin,<verse eid="2SA 23:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="2SA 23:30" />ọmaana Bẹnaya kw'ofon Piratọn,</para>
  <para style="li2" vid="2SA 23:30">ọmaana Hidayi kw'ofon ravins z'Gaash,<verse eid="2SA 23:30" /></para>
  <para style="li2">
    <verse number="31" style="v" sid="2SA 23:31" />ọmaana Abi-Albọn kw'ofon Arbat,</para>
  <para style="li2" vid="2SA 23:31">ọmaana Azmavẹt kw'ofon Barhum,<verse eid="2SA 23:31" /></para>
  <para style="li2">
    <verse number="32" style="v" sid="2SA 23:32" />ọmaana Eliyaba kw'ofon Shaalbọn,</para>
  <para style="li2" vid="2SA 23:32">ọmaana ajinọngva p'Jashẹn,<verse eid="2SA 23:32" /></para>
  <para style="li2">
    <verse number="33" style="v" sid="2SA 23:33" />ọmaana Jonatan kw'ode nnwa kw'Shama kw'ofon Hara,</para>
  <para style="li2" vid="2SA 23:33">ọmaana Ahiyam kw'ode nnwa kw'Shara kw'obira ofona Hara,<verse eid="2SA 23:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="2SA 23:34" />ọmaana Ẹliphẹlẹt kw'ode nnwa kw'Ahasbayi kw'ofon Maakat,</para>
  <para style="li2" vid="2SA 23:34">ọmaana Ẹliyam kw'ode nnwa kw'Ahitophẹl kw'ofon Gilọn,<verse eid="2SA 23:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="2SA 23:35" />ọmaana Hẹzrọ kw'ofon Karmẹl,</para>
  <para style="li2" vid="2SA 23:35">ọmaana Paarayi kw'ofon Arbit,<verse eid="2SA 23:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="2SA 23:36" />ọmaana Igal kw'ode nnwa kw'Natan kw'ofon Zoba,</para>
  <para style="li2" vid="2SA 23:36">ọmaana ojinọngnwa kw'Hagri,<verse eid="2SA 23:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="2SA 23:37" />ọmaana Zẹlẹk kw'ofon Amọn,</para>
  <para style="li2" vid="2SA 23:37">ọmaana Naharayi kw'ofon Bẹrọt, kw'ode ọtọhk-egbongkpo py'Joab kw'Zeruya obhonọ,<verse eid="2SA 23:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="2SA 23:38" />ọmaana Ira kw'ofon Itri,</para>
  <para style="li2" vid="2SA 23:38">ọmaana Garẹb kw'obira ofona Itri,<verse eid="2SA 23:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="2SA 23:39" />ọttara Uriya kw'ofon Hit.</para>
  <para style="li1" vid="2SA 23:39">Kibung-kibungọ, wa obhik fabẹ ode ẹrọbh okwuma ichi kkamfa.<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s1">Devid obhikẹ agbongnọng</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />K'ogbe wanẹ, ettem ebir epyibh Ọvaar Ibinọkpaabyi ẹmaana anọng p'Israẹl. Otima Devid oke bẹ ẹkọhr, oben bẹ bẹ́, “Màzọhng bhik anọng p'Israẹl ọmaana p'Juda.”<verse eid="2SA 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 24:2" />Nya o, ọvaarnọng oben Joab ọmaana agbongsonọng p'aning amaan-ẹ bẹ́, “Màzenga kọbha ẹkọma ch'Israẹl, tọma z'Dan maa, pyirẹ z'Beershẹba, matọka ọnọngbhik kw'agbongnọng, ọfha nzonga ọsaabh fabẹ.”<verse eid="2SA 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3" />Joab ọpọhna ọvaarnọng bẹ́, “Tte Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ, osi agbongnọng asaabh apyirẹ anọng arọbh achen ọmaan-ọmaana. Tte ttatta kwaam otima achen pẹ oze. Okenaka, bọng-ọttọhk f'ttatta kwaam m'ozenga ábẹ̀, osi ọttọhkse mvo?”<verse eid="2SA 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 24:4" />Ọvaarnọng obhum ọgbaakadik kw'Joab ọmaana kw'agbongsonọng. Nya o, mabina ny'ọvaarnọng k'ititika bẹ́, mad-abhik agbongnọng p'Israẹl.<verse eid="2SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5" />Ch'nkk'Jọrdan ajeka, mabhing anyọma Aroẹ, kw'oning ẹwọn-ẹwọna kw'obhon kw'ilokodo, pira nnazeng akpan Gad, mapyirẹ z'Jaza. <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />Machina z'Gilead, ọmaana z'ẹbhaakẹ ch'Tatim Hodshi, ọmaana z'Dan Jaan, ọttara za ch'ọnyọm Sidon. <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />Nya o, machina z'itubha s'obhon kw'Taya, ọmaana z'ibhon maphyir s'Hiv, ọttara s'Kenaan. K'okpongannamgbe machina z'Beershẹba, z'Nẹgẹv kw'oning z'Juda.<verse eid="2SA 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8" />Ch'nkk'azenga akọbha izek njo maphyir k'aphe osowanẹ ọmaana iwu ẹrọbh, makpa nnam z'Jẹrusalẹm.<verse eid="2SA 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 24:9" />Joab otek ọvaarnọng obhik f'agbongnọng. Ny'Israẹl, wa agbongnọng made nnọhna ẹnọhna okwuma arọbh ijobh p'makpo ọkkangkkang abọka, z'Juda made nnọhna ijobh kkamfa okwuma arọbh ijobh.<verse eid="2SA 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10" />Wa ettem ekwu ẹyakẹ Devid odik ch'ikk'agbongnọng obhika, oben Ọvaar Ibinọkpaabyi bẹ́, “Kaam kk'epyibha chiden nsa m'ọttọhk f'nsi ma. O Ọvaar Ibinọkpaabyi, ototo, bina nang epinẹ ch'ọtọhmnọng kwọ. Kaam nturọ-oturọ m'ọttọhk f'nsi ma.”<verse eid="2SA 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11" />Ọvaar Ibinọkpaabyi oben Gad kw'ode ọgbaak-ettem ch'Devid bẹ́, <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />“Zọhng tek Devid bẹ́, kaam nnang-ẹ abhokọ attaan. Kaam m'nsi okpenamkpen f'otek.”<verse eid="2SA 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 24:13" />Ch'Devid nọphyaabh ny'ekpebha, Gad od-okebh-ẹ, oben-ẹ bẹ́, “Ma, ina ọdaak-ọ bẹ́, okwo fiden oninga m'izek nja sọ k'aphe attaan yirẹ? Ina ọdaak-ọ bẹ́, arọbh ebira ch'awawunanọng pọ k'aphe attaan yirẹ? Ina obir ọdaak-ọ bẹ́, itama ikpẹkẹ izek sọ k'iwu ittaan yirẹ? Si ochibhẹ madidanma, ọfha atek-m ose kw'm'nd-mgbaak kẹ nwo kw'ọtọhm-m.”<verse eid="2SA 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14" />Devid oben Gad bẹ́, “Ettem ẹyak-m odik o. Tte motera otto k'mbọhk s'Ọvaar Ibinọkpaabyi okurọ bẹ́, kẹ oyen ikwosisi siden. Okenaka, kaam kasi ntto k'mbọhk s'ayokinọng.”<verse eid="2SA 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 24:15" />Nya o, Ọvaar Ibinọkpaabyi ọtọhm itama ny'Israẹl, tọma k'ekpebha maa, pyirẹ k'ogbe kw'oke. Anọng nnọhna arọbh ochenọnttaan okwuma ichi, mape, tọma z'Dan maa, pyirẹ z'Beershẹba. <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />Ch'iwa ozeng-eden kw'Ibinọkpaabyi onemẹ ọbọhk bẹ́, odimẹ Jẹrusalẹm, Ọvaar Ibinọkpaabyi ọtọr nnam ny'itama njo s'ọkamẹ, oben ozeng-eden nwo kw'ọkamẹ bẹ́, otima odimẹ anọng mbo bẹ́, “Ọdọk kasi! Tọr ifor.” Ozeng-eden nwo kw'Ọvaar Ibinọkpaabyi nokwu oninga z'ọgbaarẹ kw'Arawuna kw'ofon Jebus, nya ch'mad-aninga agwuma abarli. <verse eid="2SA 24:16" /><verse number="17" style="v" sid="2SA 24:17" />K'ogbe kw'Devid oze ozeng-eden kw'Ọvaar Ibinọkpaabyi ch'ọd-ọfhọ anọng mbo, oben Ọvaar Ibinọkpaabyi bẹ́, “Kaam kk'epyibha nsa e. Kaam okkerẹ-arọkimaan kk'mpina e. Anọng mboma akenka ade mach'arọkimaan e. Bẹ majẹ mbọng-ọ? Tte itama sọ ikpẹkẹ kaam ọmaana ẹsọhmbhọr chaam dẹ-dẹ.”<verse eid="2SA 24:17" /></para>
  <para style="s1">Devid ottim ijabyi</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />Ny'ewu ndo Gad obina od-okebha Devid, oben-ẹ bẹ́, “Zọhng ttima ijabyi s'Ọvaar Ibinọkpaabyi z'ọgbaarẹ kw'Arawuna kw'ofon Jebus, za ch'mad-aninga agwuma abarli.” <verse eid="2SA 24:18" /><verse number="19" style="v" sid="2SA 24:19" />Nya o, Devid obina od-osi k'ose kw'Ọvaar Ibinọkpaabyi ikk'Gad otima oben-ẹ bẹ́, osi. <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />K'ogbe kw'Arawuna oze ọvaarnọng, ọmaana anọng pẹ ch'mad-azenga akwu-okwu z'ikẹ k'ifor, kẹ obina oyin z'iyaan, ọraka eso otwu ititika ny'izek k'ikpukpobha ọnang ọvaarnọng.<verse eid="2SA 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21" />Arawuna oben bẹ́, “Ode yen kw'ttatta ọvaarnọng kwaam okwu k'ọtọhmnọng kwẹ o?” Devid ọpọhn-ẹ bẹ́, “Nkwu bẹ́, ndebh ọgbaarẹ kw'ad-aninga agwuma abarli, ọfha nttima ijabyi nya nnang Ọvaar Ibinọkpaabyi, ọfha itama s'ikpẹkẹ anọng paam ikpọka.”<verse eid="2SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22" />Arawuna oben Devid bẹ́, “Tte ttatta ọvaarnọng kwaam ọtọka ọttọhk kpenamkpen f'ọdaak-ẹ otima ọfọhnọ ẹja. Kirẹ abhaam p'ẹnanga ch'ekwọmọ ma. Akora p'nd-atima agwuma abarli. Nchi s'abhaam ad-atima ayaar akora ebir ening ma mach'omenẹ.” <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />Arawuna obir oben bẹ́, “K'ediden chọ, kaam nnang-ọ ekpo mbya maphyir. Tte Ọvaar Ibinọkpaabyi kwọ ochera ọtọka ẹnanga chọ.”<verse eid="2SA 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24" />Okenaka, ọvaarnọng ọpọhna Arawuna bẹ́, “Mma e, kaam m'ndebh ekpo mbyo odebh e. Kaam ekpo py'ajaaka mintima mfọhnọ ẹja nnang Ọvaar Ibinọkpaabyi.” Nya o, Devid odebh ọgbaarẹ nwo kw'nd-aninga agwuma abarli, ọttara abhaam k'ashẹkẹl p'silva arọbh afa okwuma ijobh.<verse eid="2SA 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 24:25" />Devid ottima ija-byi nya ọnang Ọvaar Ibinọkpaabyi, obir ọfọhnọ ẹja ch'ẹkwọmọ, ọmaana ẹja ch'ẹgbaka. Nya o, Ọvaar Ibinọkpaabyi ọbhaanga njọm sẹ k'eso ch'izek njo. Obir ọkpọka itama s'ikpẹkẹ Israẹl.<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>