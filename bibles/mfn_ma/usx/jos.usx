<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOS" style="id">- Mbẹmbẹ Adun [mfn]</book>
  <para style="h">Joshua</para>
  <para style="toc1">Nnwẹr kw'Joshua</para>
  <para style="toc2">Joshua</para>
  <para style="mt1">Nnwẹr kw'Joshua</para>
  <para style="ip">Nnwẹr kw'Joshua ọmaana kw'Akpaar-aponga ọtta ose kw'ẹkọma ch'Israẹl</para>
  <chapter number="1" style="c" sid="JOS 1" />
  <para style="s1">Ibinọkpaabyi ọnangẹ Joshua ẹfa bẹ́, otima ayok eden</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1" />K'ogbe kw'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ikk'ọpa, Ọvaar Ibinọkpaabyi ọgbaak odik ọnang Joshua kw'Nun obhonọ, obira ode ọnọng kw'ode-oke Mosẹs ọbọhk k'ọtọhm. Oben-ẹ bẹ́, <verse eid="JOS 1:1" /><verse number="2" style="v" sid="JOS 1:2" />“Mosẹs kw'ode ọtọhmnọng kwaam kk'ọpa. Kọ ọttara anọng pọ maphyir, màdo ifor s'mm'ajeka ọraanga kw'Jọrdan, machina z'izek s'mbenẹ bẹ́, m'nnang bẹ mbo p'ade anọng p'Israẹl. <verse eid="JOS 1:2" /><verse number="3" style="v" sid="JOS 1:3" />Kaam m'nnang bọnga ibyi kpenamkpen s'ẹtọkọ chabọnga ẹbarẹ, k'ose kw'uwa nchekẹ nnang Mosẹs. <verse eid="JOS 1:3" /><verse number="4" style="v" sid="JOS 1:4" />Izek sabọnga m'itọma z'ibyi s'owora, ipyirẹ z'Lẹbanọn. Ibir itima maa ipyirẹ z'ọraanga kwiden kw'Eupharetes, ọmaana z'nkọma s'Het maphyir maa pyirẹ z'ẹbhaakẹ ch'ewuchen ed-edimẹ z'ọraanga kwiden kw'Meditereniya. <verse eid="JOS 1:4" /><verse number="5" style="v" sid="JOS 1:5" />K'akpen pọ maphyir, ọnọng kode kw'im'okem-ọ k'erima. K'ose kw'uwa nning mmaana Mosẹs, minna kw'm'ninga mmaan-ọ. Kwuna kaam kọ ọbọhk mìntte. Kaam nnam mìmbir mkpa mbọr-ọ. <verse eid="JOS 1:5" /><verse number="6" style="v" sid="JOS 1:6" />Kọ m'agaangẹ ifor, abira abar ettem, okurọ bẹ́, kọ wọ im'atima anọng mboma eden, mad-atọka izek njo s'iwa nchekẹ nnang ab'ttatta pabẹ bẹ́, m'nnang bẹ. <verse eid="JOS 1:6" /><verse number="7" style="v" sid="JOS 1:7" />Kọ m'agaangẹ ifor, abira abar ettem mawuriji. M'atọka ogbe, akpobha asana mbo maphyir p'uwa Mosẹs kw'ode ọtọhmnọng kwaam ọnang-ọ. Tor asana mbo bẹ́, gbẹẹng k'ose kw'made, ọfha ojibh ọnang-ọ k'ibyi kpenamkpen s'ata. <verse eid="JOS 1:7" /><verse number="8" style="v" sid="JOS 1:8" />Tte nnwẹr nwa kw'asana oninga ny'ẹmma chọ k'ogbe kpenamkpen, asi ochibhẹ kw'ọmaan asana mbo k'ẹya ọttara k'erungọ, ọfha akpo asi okpenamkpen k'ose kw'makkẹrẹ nya. Minna kw'idik m'izenga mbengana inang-ọ, obira ojibh ọnang-ọ. <verse eid="JOS 1:8" /><verse number="9" style="v" sid="JOS 1:9" />Mba kk'ọ mbena bẹ́, agaangẹ ifor, abira abar ettem? Tte oning-ọ ojor, ẹfa ening-ọ ebira ẹsa! Kirẹ Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwọ m'oninga ọmaan-ọ k'ibyi kpenamkpen s'ata.”<verse eid="JOS 1:9" /></para>
  <para style="s1">Joshua ọtọm ọtọhm fẹ osisi</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10" />Nya o, Joshua oben aso p'Israẹl mbo bẹ́, <verse eid="JOS 1:10" /><verse number="11" style="v" sid="JOS 1:11" />“Màzọhng z'ibhinga-byi, màtek anọng bẹ́, ‘Màtobha ekpo pyabọnga sok. Tọma menda maa od-opyirẹ iwu ittaan, bọnga mm'ajeka ọraanga kw'Jọrdan, mad-atọka izek njo s'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga ọd-ọnang bọnga bẹ́, mayena.’ ”<verse eid="JOS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 1:12" />Okenaka, Joshua oben efona ch'Reuben, ọmaana ch'Gad, ọttara igboka janẹ s'efona ch'Manasẹ bẹ́, <verse eid="JOS 1:12" /><verse number="13" style="v" sid="JOS 1:13" />“Màjima odik kw'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ọgbaakẹ bọnga, ch'obenẹ bẹ́, ‘Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabọnga, m'ọnang bọnga odiriji m'izek nja s'ọd-ọnang bọnga ma.’ <verse eid="JOS 1:13" /><verse number="14" style="v" sid="JOS 1:14" />Panọng pabọnga, ọmaana iva pabọnga, ọttara etirakpo pyabọnga m'eninga ny'izek njo s'iwa Mosẹs ọnangẹ bọnga, z'ẹbhaakẹ ch'ewuchen ed-eyin z'Jọrdan. Okenaka, agbongnọng pabọnga maphyir p'ado ifor s'egbong bọ mm'achi anọng p'Israẹl eden ajeka z'okwubha. Bọnga mm'ake bẹ ọbọhk <verse eid="JOS 1:14" /><verse number="15" style="v" sid="JOS 1:15" />maa, Ọvaar Ibinọkpaabyi ọnang bẹ ẹwọhngkwoka, k'ose kw'osi ọnang bọnga. Màke bẹ ọbọhk maa, matọka izek njo s'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabọnga ọd-ọnang bẹ bẹ́, mayena. K'ogbe kw'nkk'achera, makpa nnam ad-aninga z'izek sabọnga oyenẹ, s'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ọnangẹ bọnga z'ẹbhaakẹ ch'ewuchen ed-eyin z'Jọrdan.”<verse eid="JOS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 1:16" />Bẹ mapọhna Joshua bẹ́, “Mm'osi ọttọhk kpenamkpen f'abenẹ mina bẹ́, mosi, mobira ọta ibyi kpenamkpen s'atọhmọ mina. <verse eid="JOS 1:16" /><verse number="17" style="v" sid="JOS 1:17" />K'ose kw'uwa motim ettem madanẹ okpobha Mosẹs, minna wọ kw'mm'okpobh-ọ. Njọm samina ikenka ide bẹ́, tte Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ, oninga ọmaan-ọ k'ose kw'uwa oning ọmaana Mosẹs. <verse eid="JOS 1:17" /><verse number="18" style="v" sid="JOS 1:18" />Ọnọng kpenamkpen kw'ọtwọ odik kwọ, odik kwọ kobir okpobha, ọmaana ọpaanga kpenamkpen kwọ, mm'ọfhẹ-ẹ. Kọ kenaka gaangẹ ifor, abira abar ettem!”<verse eid="JOS 1:18" /></para>
  <chapter eid="JOS 1" />
  <chapter number="2" style="c" sid="JOS 2" />
  <para style="s1">Rahab ọkkaan anọng p'ad-abaana ibyi</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1" />Wa Joshua kw'ode nnwa kw'Nun otubh-otubha, ọtọhm anọng afa p'afon Shittim bẹ́, “Màzọhng baana izek njo, kidaam-kidaam, Jẹriko.” Minna kw'anọng mbo mafon, mad-ayaaka k'ọsọhm kw'ọzaza wanẹ kw'okpen Rahab, maninga nya.<verse eid="JOS 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 2:2" />Anọng atek ọvaarnọng kw'Jẹriko bẹ́, “Kirẹ e, anọng banẹ p'afon Israẹl kk'erungọ atima akwu ma bẹ́, makwu abaana izek nja e.” <verse eid="JOS 2:2" /><verse number="3" style="v" sid="JOS 2:3" />Nya o, ọvaarnọng kw'Jẹriko ọtọhm ẹkkaabha ọnang Rahab, oben-ẹ bẹ́, “Tima anọng mbo p'asak-ọ, yin ka, kirẹ bẹ makwu bẹ́, makwu abaana izek nja kibung-kibungọ.”<verse eid="JOS 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 2:4" />Ode ch'kwanọng nwo ikk'ajinọng mbo afa ọtọka odubh, pira oben bẹ́, “Iye e, ajinọng mbo kk'akwa m'kaam k'ọsọhm e, okenaka, ibyi s'mafon akwu, kinzong e. <verse eid="JOS 2:4" /><verse number="5" style="v" sid="JOS 2:5" />Ny'ẹsọhka, k'ogbe kw'nd-abhen ebhumma ch'ebhondim, nya kw'mafon e. Ibyi s'machin kinzong e. Màzọhng, màkwubh bẹ z'eden ẹbhar-ẹbhar. Mm'akpokpo abọka bẹ.” <verse eid="JOS 2:5" /><verse number="6" style="v" sid="JOS 2:6" />Ode ch'ikẹ ikk'ajinọng mbo ọtọka odubh z'agwuchi-bukọ p'otim osi mgbodo, ọjẹ z'ipubhaang. <verse eid="JOS 2:6" /><verse number="7" style="v" sid="JOS 2:7" />Minna kw'anọng mbo p'Jẹriko matọm ajinọng mbo p'akwu ibyi obubaana okwukwubh. Makwubh bẹ achina z'eden ch'ọraanga kw'Jọrdan, za ch'ọgbẹr-ọgbẹrẹ. K'ose kw'anọng p'akwubhọ bẹ matto obho ny'eden, mabhen ebhumma ndo.<verse eid="JOS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 2:8" />Pira anọng mbo p'akwu abaana ibyi mayima ny'erungọ, Rahab ovura okebh bẹ z'ipubhaang, <verse eid="JOS 2:8" /><verse number="9" style="v" sid="JOS 2:9" />od-oben bẹ bẹ́, “Kaam nzong bẹ́, Ọvaar Ibinọkpaabyi kk'bọnga izek njoma ọnanga, mina mobira oninga k'ojora fiden fabọnga. Ofona nya, nttem s'anọng p'ẹkọma ndo maphyir, irọbh irik bẹ. <verse eid="JOS 2:9" /><verse number="10" style="v" sid="JOS 2:10" />Nkk'ọbhaanga ose kw'Ọvaar Ibinọkpaabyi osi ẹraanga-kora egwu <char style="it">bẹ́ kẹkẹdẹ</char> ọnang bọnga ch'mabin z'Ijip. Mobira ọbhaanga ọttọhk f'bọnga masi Sihọn ọttara Og, p'ade avaar afa p'Amọr, z'ẹbhaakẹ ch'ewuchen ed-eyin z'Jọrdan, k'ose kw'madimẹ bẹ eche kibungọ. <verse eid="JOS 2:10" /><verse number="11" style="v" sid="JOS 2:11" />Ch'mọbhaang odik nwo, nttem samina irọbh-ọrọbh, irik mina okurọ ojora f'ọbọk mina, ottembara kw'ọnọng kpenamkpen ọsa maphyir okurọ ch'bọnga major mina. Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga, wọ ode Ibinọkpaabyi kw'oning z'ẹrọng ọmaana m'izek.<verse eid="JOS 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 2:12" />Ototo o, màchekẹ nang-m k'eche ch'Ọvaar Ibinọkpaabyi bẹ́, bọnga mm'akkaana kaam ọttara ẹsọhmmọr chaam, okurọ bẹ́, kaam kk'ẹkkaana nsa nnang bọnga. Mànang-m ẹkọhka ch'm'mphe nnam <verse eid="JOS 2:12" /><verse number="13" style="v" sid="JOS 2:13" />bẹ́, bọnga m'atte ọmaana akka kwaam ọttọhk masi, ọmaana ivotte, ọttara ivọkka paam, ọmaaana anọng maphyir p'ade pabẹ. Màbir chekẹ bẹ́, bọnga mm'asi mina mọnaanga obo.”<verse eid="JOS 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 2:14" />Ajinọng mbo apọhn-ẹ bẹ́, “Mina mm'oter ope obo kwabọnga, óde bọ́nga nna mina ayaakẹ k'ọttọhk f'mokwu osisi ma. Mina mm'otima ettem madanẹ osi ọphyaam ọnang bọnga, k'ogbe kw'Ọvaar Ibinọkpaabyi ọnangẹ mina izek nja.”<verse eid="JOS 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 2:15" />Nya o, Rahab ọnang bẹ edik ch'matim azenga k'ọmma kw'ofum asaka z'izek. Wa Rahab orukọ k'ọsọhm kw'etumọ danẹ ede ndo ch'ebhondim. <verse eid="JOS 2:15" /><verse number="16" style="v" sid="JOS 2:16" />Oben bẹ bẹ́, “Màchina z'agbe, ọfha anọng p'akwubhọ bọnga z'eden, màning bọnga aze. Màtubha k'iwu ittaan maa, anọng p'akwubh bọnga makpa nnam, pira nnachin ororo k'ozenga kwabọnga.”<verse eid="JOS 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 2:17" />Anọn<note caller="+" style="fe"><char style="fr" closed="false">2.17 </char><char style="ft" closed="false" /></note>g mbo aben-ẹ bẹ́, “Echekẹ nda ch'asi mina mochekẹ ma, mina mẹ̀bọka, <verse eid="JOS 2:17" /><verse number="18" style="v" sid="JOS 2:18" />oyebẹ́, k'ogbe kw'mm'odim m'izek nja, kọ kk'edik-kora atọka agbana ny'ọmma nwo kw'ofum kw'azeng asaka mina k'izek, ọmaana bẹ́, kọ kk'atte ọmaana akka, ọmaana ivotte, ọttara echimma chọ maphyir, atima akwu m'ọsọhm kwọ ẹtaanga. <verse eid="JOS 2:18" /><verse number="19" style="v" sid="JOS 2:19" />Ó̱de óchimmanọng kwọ ina ny'ikọ k'ọsọhm ẹtaanga oning, óde oyinẹ ezenga-kpaanga, izẹ sabẹ m'ibhakẹ ikpẹkẹ bẹ oyenẹ, k'ọttọhk kpenamkpen f'oyinẹ ọmaana bẹ z'odenkpaarẹ. Ọbọhk kwamina nya, moninga. K'ayok p'aning amaan-ọ ny'ọsọhm, izẹ sabẹ m'ikpẹkẹ mina, óde ọttọhk ọchẹrẹ bẹ. <verse eid="JOS 2:19" /><verse number="20" style="v" sid="JOS 2:20" />Okenaka, óde áyaakẹ mina k'ọttọhk f'nd-osi ma, echekẹ ch'mochekẹ ma, mina mẹbọka.”<verse eid="JOS 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 2:21" />Kẹ ọpọhna bẹ́, “Kaam ncher minna. Tte ode k'ose kw'mabenẹ.” Minna kw'otte bẹ ọbọhk, bẹ mafona. Ọtọka edik-kora ọgbana ny'ọmma nwo kw'ofum.<verse eid="JOS 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 2:22" />Anọng mbo afa mafona achina z'agbe, maninga za k'iwu ittaan. Anọng p'akwubhọ bẹ maror bẹ z'eden maphyir, m'bẹ kaze. Nya o, makpa nnam z'abẹ k'obhon. <verse eid="JOS 2:22" /><verse number="23" style="v" sid="JOS 2:23" />Nya o, anọng mbo afa mabina z'agbe masaka, makwu alọhkọ ọraanga ajeka, makebha Joshua kw'ode nnwa kw'Nun za. Matek-ẹ odik kpenamkpen kw'oyinẹ ọmaana bẹ. <verse eid="JOS 2:23" /><verse number="24" style="v" sid="JOS 2:24" />Maben Joshua bẹ́, “K'odik ọkkọkka, Ọvaar Ibinọkpaabyi kk'izek oyenẹ k'ibungọ ọtọka oke mina k'mbọhk. Nttem s'anọng mbo kk'irọbha maphyir okurọ ch'mojor bẹ e.”<verse eid="JOS 2:24" /></para>
  <chapter eid="JOS 2" />
  <chapter number="3" style="c" sid="JOS 3" />
  <para style="s1">Ejeka ch'ọraanga kw'Jọrdan</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1" />K'ekpebha erungọ-erungọ, Joshua ọmaana anọng p'Israẹl maphyir, mabina z'Shittim machina z'Jọrdan, mabhing za, pira nnajek z'ọraanga okwubha. <verse eid="JOS 3:1" /><verse number="2" style="v" sid="JOS 3:2" />Iwu ittaan ikpanẹ nya o, asonọng abina azenga akọbha ibhinga-byi njo, <verse eid="JOS 3:2" /><verse number="3" style="v" sid="JOS 3:3" />mad-aben anọng mbo bẹ́, “Ogbe kw'maze ch'afọhn-ẹja p'Lẹvi matọhk Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga, bọnga mm'abina k'obyi f'maning, mayakẹ Ẹkkọhbhọ ndo nnam. <verse eid="JOS 3:3" /><verse number="4" style="v" sid="JOS 3:4" />Nya kw'bọnga mm'azonga eden ch'mazenga, okurọ ch'bọnga nna m'eden nda atim ad-azenga. Okenaka, m'Ẹkkọhbhọ ndo ch'Echekẹ kanyọma k'ifor. Tte obhokọ kw'im'opyirẹ ntọkọ nnọhna ichen oninga bọnga ny'ettem.”<verse eid="JOS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 3:5" />Joshua otek anọng mbo bẹ́, “Màsok ifor sabọnga iwur-owur z'Ibinọkpaabyi k'ititika. Kirẹ ophyinẹ, Ọvaar Ibinọkpaabyi m'osi ikkonọ-kkonọdik m'abọnga k'ikpakaana.”<verse eid="JOS 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 3:6" />Joshua oben afọhn-ẹja mbo bẹ́, “Màtinẹ Ẹkkọhbhọ ndo ch'echekẹ, matima achi anọng mbo eden.” Minna kw'uwa matinẹ dẹ, matima achi bẹ eden.<verse eid="JOS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 3:7" />Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Menda, kaam m'ntọm-ọ otitinẹ k'ẹrọng k'ititika s'anọng p'Israẹl, mfha bẹ mazonga bẹ́, kaam nning mmaan-ọ, k'ose kw'uwa nninga mmaana Mosẹs. <verse eid="JOS 3:7" /><verse number="8" style="v" sid="JOS 3:8" />Tek afọhn-ẹja mbo p'atọhk Ẹkkọhbhọ ch'Echekẹ bẹ́, ‘K'ogbe kw'mapyirẹ ny'ẹpa ch'asi p'Jọrdan, màsaka, mabe z'ọraanga.’ ”<verse eid="JOS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 3:9" />Joshua oben anọng p'Israẹl bẹ́, “Màkwu bhaanga ọgbaakadik kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabọnga e. <verse eid="JOS 3:9" /><verse number="10" style="v" sid="JOS 3:10" />Minna wọ kw'mm'atima azonga bẹ́, Ibinọkpaabyi nwo kw'orukọ akpen, oning ma ọmaana bọnga. Etwuna kede bẹ́, kẹ mokwubh anọng p'Kenaan, ọmaana p'Het, ọmaana p'Hiv, ọmaana p'Pẹriz, ọmaana p'Girgash, ọmaana p'Amọr, ọttara p'Jebu k'abọnga k'ititika. <verse eid="JOS 3:10" /><verse number="11" style="v" sid="JOS 3:11" />Màze e, Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi kw'iyagbin maphyir, m'echi bọnga eden epyirẹ z'Jọrdan. <verse eid="JOS 3:11" /><verse number="12" style="v" sid="JOS 3:12" />Ofona nya, ny'ofonamma kpenamkpen kw'Israẹl, màrọhbha ajinọng ijobh kkamfa nya. <verse eid="JOS 3:12" /><verse number="13" style="v" sid="JOS 3:13" />K'ose kw'afọhn-ẹja mbo p'atọhk Ẹkkọhbhọ ndo ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, kw'ode Ọvaar Ibinọkpaabyi kw'iyagbin maphyir mabarẹ ẹtọkọ ny'asi p'Jọrdan, ebhobh ch'ẹwọn-ẹwọna m'ẹkpaara, asi p'afon z'ebir-ebir mm'abira abe k'ibyi majanẹ.”<verse eid="JOS 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 3:14" />K'ogbe kw'anọng mbo nabin z'ibhinga-byi bẹ́, mad-ajeka Jọrdan, afọhn-ẹja mbo p'atọhk Ẹkkọhbhọ ch'Echekẹ makwu achi bẹ eden. <verse eid="JOS 3:14" /><verse number="15" style="v" sid="JOS 3:15" />Wa ọraanga kw'Jọrdan ọnwa-ọnwa ny'ọpha-gbe maphyir. Okenaka, k'ose kw'afọhn-ẹja mbo p'atọhk Ẹkkọhbhọ ch'Echekẹ mapyirẹ ny'Jọrdan, mmokpatọkọ sabẹ ibira itwu esimma, <verse eid="JOS 3:15" /><verse number="16" style="v" sid="JOS 3:16" />minna kw'ebhobh ch'efon z'ebir-ebir ẹkpọk. Asi mbo makwu atobha k'ibyi majanẹ, mabe k'ibyi s'ibhirẹ eden mawuriji, z'obhon kw'mayerẹ Adam, kw'oning z'mbọr-mbọr s'Zaretan. Ebhobh ch'ẹwọn-ẹwọna ẹkpaara kibungọ, ed-etto z'ọraanga kwiden kw'Araba, (kw'ode Ọraanga kw'Obo). Minna kw'anọng mbo majek z'okwubha, za ch'okkerẹ Jẹriko. <verse eid="JOS 3:16" /><verse number="17" style="v" sid="JOS 3:17" />Afọhn-ẹja mbo p'atọhk Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, mad-abe ny'ottem kw'Jọrdan k'izek s'igwo-ogwu. Anọng p'Israẹl maphyir makwu akpan maa, ẹkọma ndo kibungọ, ezenga ny'izek s'igwo-ogwu, ejeka maa, machera.<verse eid="JOS 3:17" /></para>
  <chapter eid="JOS 3" />
  <chapter number="4" style="c" sid="JOS 4" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1" />K'ogbe kw'ẹkọma ndo ch'Israẹl kibungọ ikk'ọraanga kw'Jọrdan ejeka maphyir, Ọvaar Ibinọkpaabyi oben Joshua bẹ́, <verse eid="JOS 4:1" /><verse number="2" style="v" sid="JOS 4:2" />“Ny'anọng mbo p'aning nya, rọhbha ọnọng mawanẹ-wanẹ ny'mfonamma njo ijobh kkamfa, <verse eid="JOS 4:2" /><verse number="3" style="v" sid="JOS 4:3" />abira aben bẹ bẹ́, madunga ata ijobh kkamfa ny'ẹraangattem ch'Jọrdan. Tte madunga ata mbo nya ch'afọhn-ẹja mbo mabe, matima ator-ọ, mad-asok z'ibyi s'bọnga mm'abhing m'erungọ.”<verse eid="JOS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 4:4" />Minna kw'Joshua oyerẹ anọng mbo ijobh kkamfa p'ikk'oteka ny'anọng p'Israẹl k'ibyi majanẹ, ọd-ọrọhbha ọnọng mawanẹ-wanẹ k'ofonamma kpenamkpen. <verse eid="JOS 4:4" /><verse number="5" style="v" sid="JOS 4:5" />Obira oben bẹ bẹ́, “Màzọhng z'ẹraangattem ch'Jọrdan, ny'ititika s'Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabọnga. Tte ọnọng-ọnọng otinẹ ẹta ọnana ny'ebubaang chẹ, otor k'ose kw'afonamma p'Israẹl made, <verse eid="JOS 4:5" /><verse number="6" style="v" sid="JOS 4:6" />ọfha ode mach'ẹkọhka ọnang bọnga. Z'ogbe ororo, óde iva pabọnga m'abọbh bọnga bẹ́, ‘Ata mba ayinẹ yen o?’ <verse eid="JOS 4:6" /><verse number="7" style="v" sid="JOS 4:7" />mm'atek bẹ bẹ́, wa ebhobh ch'ọraanga kw'Jọrdan ẹkpaar k'ititika s'Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi. Ogbe kw'uwa Ẹkkọhbhọ ndo ejek ọraanga kw'Jọrdan, ebhobh ch'ọraanga nwo ẹkpaara. Ata mboma bọ made ejima anang anọng p'Israẹl ttattampe.”<verse eid="JOS 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 4:8" />Minna kw'anọng p'Israẹl asi k'ose kw'Joshua obenẹ bẹ. Matọka ata ijobh kkamfa ny'ẹraangattem ch'Jọrdan k'ose kw'Ọvaar Ibinọkpaabyi kk'Joshua obena, otor k'mfonamma s'Israẹl. Matima ata mbo ajeka, mad-asok z'ibhinga-byi sabẹ. <verse eid="JOS 4:8" /><verse number="9" style="v" sid="JOS 4:9" />Joshua ottima ata mbo ijobh kkamfa p'uwa aning ny'ẹraangattem ch'Jọrdan, ny'ibyi s'iwa afọhn-ẹja p'atọhk Ẹkkọhbhọ ch'Echekẹ mabẹ. Ata mbo atim abe za maa, pyirẹ menda.<verse eid="JOS 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 4:10" />Wa afọhn-ẹja mbo p'atọhk Ẹkkọhbhọ ch'Echekẹ mabe ny'ẹraangattem ch'Jọrdan maa, anọng p'Israẹl asi ọttọhk kpenamkpen f'uwa Ọvaar Ibinọkpaabyi ikk'Joshua obena, mbengana k'ose kw'uwa Mosẹs kk'Joshua ọtọhna. Anọng p'Israẹl maduk-oduka ajeka. <verse eid="JOS 4:10" /><verse number="11" style="v" sid="JOS 4:11" />Bẹ maphyir majek nya o, Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, ọmaana afọhn-ẹja mbo matima dẹ achina z'ẹbhaakẹ ndoza. Anọng mbo abe nya akkerẹ bẹ. <verse eid="JOS 4:11" /><verse number="12" style="v" sid="JOS 4:12" />Ajinọng p'Reubẹn, ọmaana p'Gad ọttara igboka janẹ s'efona ch'Manasẹ mado igbong-for, majeka z'okwubha ny'ititika s'anọng p'Israẹl, k'ose kw'uwa Mosẹs kk'bẹ ọtọhna. <verse eid="JOS 4:12" /><verse number="13" style="v" sid="JOS 4:13" />Wa agbongnọng p'mm'apyirẹ anọng nnọhna arọbh achen, majeka z'okwubha, ny'ititika s'Ọvaar Ibinọkpaabyi bẹ́, mad-arima egbong z'mkpẹmẹ s'Jẹriko.<verse eid="JOS 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 4:14" />Ny'ewu ndo, Ọvaar Ibinọkpaabyi ọnang Joshua abarada k'ititika s'anọng p'Israẹl maphyir. Tọma ny'ewu ndo, matima opoma atọma Joshua okpukpobha k'akpen pẹ maphyir, mbengana k'ose kw'uwa matim opoma akpobha Mosẹs.<verse eid="JOS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 4:15" />Nya o, Ọvaar Ibinọkpaabyi oben Joshua bẹ́, <verse eid="JOS 4:15" /><verse number="16" style="v" sid="JOS 4:16" />“Ben afọhn-ẹja p'ad-atọhka Ẹkkọhbhọ ch'Echekẹ ch'apaanga bẹ́, màbina ny'ọraanga kw'Jọrdan, mavura k'ogbin.”<verse eid="JOS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 4:17" />Minna kw'Joshua oben afọhn-ẹja mbo bẹ́, “Màbina ny'ọraanga kw'Jọrdan, màvura ka ogbin.”<verse eid="JOS 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 4:18" />Minna kw'afọhn-ẹja mbo matim Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi mabina ny'ọraanga kw'Jọrdan, mavura z'ogbin. Mabubarẹ mmokpatọkọ sabẹ nya ch'ogwo-ogwu z'ogbin, minna kw'asi p'ọraanga kw'Jọrdan makpa nnam. Mabhobh ọttara ẹnwanwa k'ose kw'mad-akkikken abhobh.<verse eid="JOS 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 4:19" />Ny'ewu ndo ch'ettong ijobh ch'ocheden-phe, anọng mbo mabina z'Jọrdan, mad-abhing z'Gilgal, za ch'ewuchen ed-eyin z'enem ch'Jẹriko. <verse eid="JOS 4:19" /><verse number="20" style="v" sid="JOS 4:20" />Joshua ottima ata mbo ijobh kkamfa p'matọk z'Jọrdan ny'Gilgal. <verse eid="JOS 4:20" /><verse number="21" style="v" sid="JOS 4:21" />Oben anọng p'Israẹl bẹ́, “Z'ogbe ororo, óde iva p'iva pabọnga mabọbh ab'otte bẹ́, ‘Ata mboma ayinẹ yen o?’ <verse eid="JOS 4:21" /><verse number="22" style="v" sid="JOS 4:22" />màtek bẹ bẹ́, ‘Wa anọng p'Israẹl azeng k'izek s'igwo-ogwu majeka ọraanga kw'Jọrdan.’ <verse eid="JOS 4:22" /><verse number="23" style="v" sid="JOS 4:23" />Wa Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga osi ọraanga kw'Jọrdan ogwu <char style="it">bẹ́ kẹkẹdẹ</char> k'abọnga k'ititika maa, bọnga majeka z'okwubha. Wa Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga osi ọraanga kw'Jọrdan ogwu <char style="it">bẹ́ kẹkẹdẹ</char> k'ose kw'uwa osi Ẹraangakora egwu ny'amina k'ititika maa, mọjeka z'okwubha. <verse eid="JOS 4:23" /><verse number="24" style="v" sid="JOS 4:24" />Wa osi minna, mfha anọng p'iyagbin maphyir mazonga bẹ́, Ọvaar Ibinọkpaabyi oyen ẹfa, mfha mabir ayena ojora k'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'abọnga k'ogbe kpenamkpen.”<verse eid="JOS 4:24" /></para>
  <chapter eid="JOS 4" />
  <chapter number="5" style="c" sid="JOS 5" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1" />K'ogbe kw'avaar maphyir p'Amọr, p'aning z'ẹbhaakẹ ch'ewuchen ed-edimẹ z'Jọrdan, ọmaana avaar maphyir p'Kenaan p'arukọ z'akonga p'Jọrdan, mabhaang ose kw'Ọvaar Ibinọkpaabyi kk'ọraanga kw'Jọrdan ọsa ọkka maphyir maa, anọng p'Israẹl azenga nya majeka z'okwubha, ojora ọbọka bẹ maa, m'ọdọk ettem kayen arima anọng p'Israẹl abẹ.<verse eid="JOS 5:1" /></para>
  <para style="s">Ẹnọmbhirẹ ọmaana odidaama kw'Pasova z'Gilgal</para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 5:2" />Ny'ogbe nwo, Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Si ngọhbha, atima abhirẹ anọng p'Israẹl inọm ọdọk.” <verse eid="JOS 5:2" /><verse number="3" style="v" sid="JOS 5:3" />Minna kw'Joshua osi ngọhbha njo obira otima obhir anọng p'Israẹl inọm z'Gibeat-Haaralot. <verse eid="JOS 5:3" /><verse number="4" style="v" sid="JOS 5:4" />Ọttọhk f'uwa ozeng abẹ osi minna ode bẹ́, anọng mbo maphyir p'uwa mabin z'Ijip, p'ade ajinọng maphyir p'ọgbọ kw'egbong oririma, wa mape k'eden z'ibyi s'anọng nna arukọ, ch'nkk'abina z'Ijip. <verse eid="JOS 5:4" /><verse number="5" style="v" sid="JOS 5:5" />Wa nkk'anọng maphyir p'abin z'Ijip inọm abhira. Okenaka, ayok mbo maphyir p'mamaanẹ bẹ k'eden z'ibyi s'anọng nna arukọ ch'nkk'abina z'Ijip, wa m'bẹ inọm kabhirẹ. <verse eid="JOS 5:5" /><verse number="6" style="v" sid="JOS 5:6" />Wa anọng p'Israẹl kk'kpangkpangtete asa k'icho arọbh afa z'ibyi s'anọng nna arukọ maa, ajinọng p'igbọ s'egbong oririma p'nkk'abina z'Ijip, mape maphyir, okurọ ch'iwa bẹ nna Ọvaar Ibinọkpaabyi akpobh. Ọvaar Ibinọkpaabyi ochekẹ ọnang bẹ bẹ́, m'izek njo k'ichen maze, s'iwa ikk'ettem madanẹ otima ochekẹ bẹ́, m'ọnang ab'atte pamina, kw'ode izek ọkkọkka s'ijibhẹ ekpo. <verse eid="JOS 5:6" /><verse number="7" style="v" sid="JOS 5:7" />Wa Ọvaar Ibinọkpaabyi notim ajinọngva pabẹ otera nso sabẹ. Ajinọngva mba bọ p'uwa Joshua nobhirẹ inọm. Wa m'inọm atim abhira okurọ bẹ́, ch'iwa mazeng z'eden, m'bẹ inọm kabhirẹ. <verse eid="JOS 5:7" /><verse number="8" style="v" sid="JOS 5:8" />Mabhirẹ ẹkọma ndo kibungọ inọm nya o, maninga ny'ibhinga-byi maa, ifor igaangẹ bẹ.<verse eid="JOS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 5:9" />Nya o, Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Kaam kk'ọ nrọhbha k'igbardik s'Ijip menda.” Ofona nya o, mayerẹ ibyi njo bẹ́, Gilgal<note caller="+" style="f"><char style="fr" closed="false">5.9 </char><char style="fq" closed="false">Gilgal </char><char style="ft" closed="false">k'eHiburu ode z'itọhng mach'ebingẹ, wanẹma, ẹrọhbh, mach'ọnọng obing ọttọhk obingẹ.</char></note> maa, pyirẹ menda.<verse eid="JOS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 5:10" />Ny'ẹsọhka ch'ewu ttong osowanẹ kw'ichi ch'ophe nwo, anọng p'Israẹl atim aning k'odidaama kw'Pasova za ch'mabhingẹ z'Gilgal, z'mkpẹmẹ s'Jẹriko. <verse eid="JOS 5:10" /><verse number="11" style="v" sid="JOS 5:11" />Ch'ewu ch'Pasova ikk'ẹkpana, ny'ewu ndo madanẹ-danẹ, machi ekpo byanẹ py'efon ny'izek njo, py'ede brẹd kw'nna yist ake, ọttara akpomọma p'mabhaabh-ọbhaabh. <verse eid="JOS 5:11" /><verse number="12" style="v" sid="JOS 5:12" />Manna nwo ọkpọka, tọma ny'owusobha nwo kw'machi ekpo py'efon ny'izek njo. Wa anọng p'Israẹl m'ọdọk manna kayen, kw'ọkpanẹ nwo kw'machi ny'ewu ch'machi ọchattọhk f'ofon ny'izek njo.<verse eid="JOS 5:12" /></para>
  <para style="s1">Ose kw'Jẹriko otto</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13" />K'ogbe kw'Joshua kk'Jẹriko ọnyọma, otinẹ ichen oze ojinọng wanẹ kw'ọbẹ-ẹ ny'ititika ttara ọkkangkkang kw'ikk'ọrọhbha z'ọpa otima z'ọbọhk. Joshua ozenga otum-ẹ, ọbọbh-ẹ bẹ́, “Ma, kọ abe k'amina, wanẹma, k'awawunanọng pamina o?”<verse eid="JOS 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 5:14" />Ojinọng nwo ọpọhn-ẹ bẹ́, “Ọnọng kw'mbe k'nnam kode, okenaka, kaam kk'nkwa mach'odidennọng kw'agbongsonọng kw'asoja p'Ọvaar Ibinọkpaabyi.” Minna kw'Joshua otto okwubha ititika ny'izek k'ikpukpobha, ọbọbh-ẹ bẹ́, “Bọng-ẹkkaabha dọ ch'ttatta kwaam oyen ch'im'ọnang ọtọhmnọng kwẹ o?”<verse eid="JOS 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 5:15" />Odidennọng nwo kw'agbongsonọng kw'asoja p'Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Wọra idikpatọkọ sọ z'mmo, kirẹ ibyi njo s'abe nya, ide ibyi s'awuriji.” Joshua o, osi minna.<verse eid="JOS 5:15" /></para>
  <chapter eid="JOS 5" />
  <chapter number="6" style="c" sid="JOS 6" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1" />Wa mazeng anọng p'Israẹl abẹ, magbak mbhumma s'Jẹriko maa, igaangẹ. Ọnọng k'iyaan koyinẹ, ọnọng z'ẹtaanga kobir odim.<verse eid="JOS 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 6:2" />Nya o, Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Kirẹ e, kaam kk'Jẹriko, ọmaana ọvaarnọng kwẹ, ọttara arimanọng pẹ, ntọka nkk'ọ ny'mbọhk. <verse eid="JOS 6:2" /><verse number="3" style="v" sid="JOS 6:3" />Tima agbongnọng pọ maphyir zenga kọbha ebhondim ndo ogbe mawanẹ. Si minna k'iwu ichadanẹ. <verse eid="JOS 6:3" /><verse number="4" style="v" sid="JOS 6:4" />Tte afọhn-ẹja achenọmfa màtima nsa s'abhik p'attongoro màchi ẹkkọhbhọ ch'echekẹ eden. Ny'ewu ttong ichenọmfa, màzenga kọbha ebhondim ndo igbedim ichenọmfa, ọmaana nsa s'afọhn-ẹja mm'aje. <verse eid="JOS 6:4" /><verse number="5" style="v" sid="JOS 6:5" />K'ogbe kw'mabhaang nsa njo s'maje atọr-ọtọr, tte agbongnọng kibungọ makwọhrọ ẹmọng k'ẹrọng. Minna kw'etumọ ch'ebhondim ndo im'etto, ogbongnọng kpenamkpen ọzọhng odim z'ẹtaanga.”<verse eid="JOS 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 6:6" />Minna kw'Joshua kw'Nun obhonọ, oyerẹ afọhn-ẹja mbo, oben bẹ bẹ́, “Màtinẹ Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi. Tte afọhn-ẹja achenọmfa m'atima nsa machi chẹ eden.” <verse eid="JOS 6:6" /><verse number="7" style="v" sid="JOS 6:7" />Joshua oke agbongnọng mbo ẹfa bẹ́, “Màchina ititika-ititika! Màzenga kọbha ebhondim ndo. Tte akker-ibyi p'atim mkpon màchi Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi eden.”<verse eid="JOS 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 6:8" />K'ogbe kw'Joshua kk'odik ọgbaaka ọnang anọng mbo o, afọhn-ẹja mbo achenọmfa p'atim nsa njo ichenọmfa ny'Ọvaar Ibinọkpaabyi k'ititika, maje sẹ atima achi eden. Ẹkkọhbhọ ch'echekẹ ch'Ọvaar Ibinọkpaabyi ẹyakẹ bẹ nnam. <verse eid="JOS 6:8" /><verse number="9" style="v" sid="JOS 6:9" />Akker-ibyi mbo p'atim mkpon, mazenga achi afọhn-ẹja mbo p'aje nsa eden. Akker-ibyi p'maning z'nnam, mazenga ator Ẹkkọhbhọ ch'Echekẹ ndo. M'ogbe nwa maphyir, nsa ije mach'ije nya. <verse eid="JOS 6:9" /><verse number="10" style="v" sid="JOS 6:10" />Okenaka, Joshua kk'agbongnọng obena bẹ́, “M'agbong-mọng kabok, m'ẹmọng kakwọhrọ, m'odik maphyir-phyir kagbaak maa, opyirẹ ewu ndo ch'm'mben bọnga bẹ́, makwọhrọ ẹmọng. Nya kw'mm'akwọhrọ!” <verse eid="JOS 6:10" /><verse number="11" style="v" sid="JOS 6:11" />Minna kw'obenẹ bẹ matinẹ Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, matima dẹ akọhbha ebhondim ndo ogbedim mawanẹ. Pira agbongnọng mbo nnakpa nnam z'ibhinga-byi, mad-abhing za.<verse eid="JOS 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 6:12" />Joshua ọphyabha k'ekpikpebha, afọhn-ẹja atinẹ Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi. <verse eid="JOS 6:12" /><verse number="13" style="v" sid="JOS 6:13" />Afọhn-ẹja mbo achenọmfa p'atim nsa njo nchenọmfa, maje sẹ, matima azenga achi Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi eden. Agbongnọng p'atim mkpon m'achi bẹ eden. Akker-ibyi p'aning z'nnam-nnam, mazenga ayakẹ Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi nnam. Nsa ije ichina ororo. <verse eid="JOS 6:13" /><verse number="14" style="v" sid="JOS 6:14" />Ttong iwu ifa, mabir azenga akọbha ebhondim ndo ogbedim mawanẹ, makpa nnam z'ibhinga-byi. Mabir asi minna-minna, k'iwu ichadanẹ.<verse eid="JOS 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 6:15" />Ttong iwu ichenọmfa, maphyabha ny'owusobha. Mazenga akọbha ebhondim ndo igbedim ichenọmfa k'ose kw'mad-asi. Okenaka, ny'ewu ndo, makọbh ebhondim ndo igbedim ichenọmfa. <verse eid="JOS 6:15" /><verse number="16" style="v" sid="JOS 6:16" />Ttong igbedim ichenọmfa s'makọbh ebhondim ndo, afọhn-ẹja maje ẹsa k'ẹrọng. Minna kw'Joshua obenẹ agbongnọng bẹ́, “Màkwọhrọ! Kirẹ Ọvaar Ibinọkpaabyi kk'bọnga ebhondim ndo ọnanga! <verse eid="JOS 6:16" /><verse number="17" style="v" sid="JOS 6:17" />Ebhondim ndo, ọmaana ekpo maphyir py'ening nya, ede py'Ọvaar Ibinọkpaabyi. Rahab kw'ode ọzaza, ọmaana anọng maphyir p'aning amaan-ẹ ny'ọsọhm kwẹ, bẹ-bẹ bọ p'mm'ayobh, okurọ ch'iwa odubhọ anọng p'mọtọhmọ bẹ́, makwu abaana ibyi. <verse eid="JOS 6:17" /><verse number="18" style="v" sid="JOS 6:18" />Okenaka, màrọhbha ichen z'ekpo py'obhon nwo, mfha maning mmo azeng aror obo kwabọnga ch'mm'atọka ọttọhk kpenamkpen nya. Ó̱de máyom, obo ọttara ẹkọhr dọ ch'mm'atima akwu z'ibhinga-byi s'Israẹl. <verse eid="JOS 6:18" /><verse number="19" style="v" sid="JOS 6:19" />Silva ọmaana gol, ọmaana ekpo py'matim bronz asi, ọttara py'ede mbaanga maphyir, m'ede py'Ọvaar Ibinọkpaabyi, ebira ẹbaana bẹ́, echina z'ekwurukpa chẹ.”<verse eid="JOS 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 6:20" />K'ogbe kw'nsa njo ije, agbongnọng akwọhrọ ẹmọng, nsa ibir ije, agbongnọng ado akwọhrọ k'ẹrọng, etumọ ndo etto. Minna kw'ọnọng kpenamkpen odimẹ z'ebhondim ndo ẹtaanga. Ọnọng-ọnọng oje etum, odim z'ẹtaanga, matọka ebhondim ndo kibungọ. <verse eid="JOS 6:20" /><verse number="21" style="v" sid="JOS 6:21" />Matte ebhondim ndo ọbọhk, anang Ọvaar Ibinọkpaabyi. Matima akkangkkang afhọ ọttọhk kpenamkpen f'oning akpen nya, ode ajinọng o, panọng o, igbọgbọ o, ataminọng o, adamogbodo o, arọkimaan ọ, ozeng k'nnyanya s'id-itọhka ekpo o, mafhọ-ọfhọ maphyir.<verse eid="JOS 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 6:22" />Nya o, Joshua oben anọng mbo afa p'uwa makwu abaana izek njo bẹ́, “Màzọhng z'ọsọhm kw'ọzaza nwo. Màtima kẹ ọttara anọng mbo p'ade pẹ maphyir, yin k'iyaan, tọr k'ose kw'machekẹ anang-ẹ.” <verse eid="JOS 6:22" /><verse number="23" style="v" sid="JOS 6:23" />Minna kw'ajinọng mbo p'uwa makwu abaana obhon nwo, madimẹ z'obhon ẹtaanga, mad-atọka Rahab, ọmaana otte, ttara ọkka, ọmaana ivọkka p'ejinọng ọttara p'panọng, ọttara anọng pẹ maphyir. Matima echimma chẹ kibungọ, mayin k'iyaan, mad-asok bẹ k'ibyi janẹ z'iyaan-iyaan kw'ibhinga-byi s'Israẹl.<verse eid="JOS 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 6:24" />Pira nnakwọmọ ebhondim ndo kibungọ, ttara ọttọhk kpenamkpen f'oning ny'ẹtaanga. Okenaka, matọka silva, ọmaana gol, ọmaana ekpo py'matim bronz asi, ọttara py'ede mbaanga-mbaanga, mayika z'ekwurukpa ch'Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="JOS 6:24" /><verse number="25" style="v" sid="JOS 6:25" />Wa Joshua oyobh Rahab kw'ode ọzaza, ọmaana echimma chẹ. Obira oyobh ọnọng kpenamkpen kw'ode kw'Rahab, okurọ ch'iwa odubhọ ajinọng p'Joshua ọtọhmọ bẹ́, mabaana obhon kw'Jẹriko. Rahab oruk ọmaana anọng p'Israẹl maa, pyirẹ menda.<verse eid="JOS 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 6:26" />Ny'ogbe nwo, Joshua ọtọr anọng p'Israẹl itọhng bẹ́, “M'opyibh ọnang ọnọng nwo k'ititika s'Ọvaar Ibinọkpaabyi, kw'ikwuna im'oyoma bẹ́, m'ottima ebhondim nda ch'Jẹriko,</para>
  <para style="q1" vid="JOS 6:26">“Eso ch'ocheden-jinọngnwa kwẹ,</para>
  <para style="q2" vid="JOS 6:26">dọ ch'im'otima ọphaakẹ izek s'ọtọhm mvo,</para>
  <para style="q1" vid="JOS 6:26">eso ch'okpongannam-jinọngnwa kwẹ,</para>
  <para style="q2" vid="JOS 6:26">dọ ch'im'otima ottima mbhumma sẹ.”<verse eid="JOS 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 6:27" />Nya o, wa Ọvaar Ibinọkpaabyi oning ọmaan Joshua. Minna kw'eche ch'Joshua ẹnyaamẹ ny'ẹkọma ndo maphyir.<verse eid="JOS 6:27" /></para>
  <chapter eid="JOS 6" />
  <chapter number="7" style="c" sid="JOS 7" />
  <para style="s1">Epyibha ch'Akan</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1" />Wa anọng p'Israẹl m'ntọhna s'manangẹ bẹ bẹ́, makibhẹ ọttọhk kpenamkpen z'Jẹriko, kakpobh. Ojinọng wanẹ kw'okpen Akan, ọtọka ekpo byanẹ py'ẹbar-odik, odubh. Wa Akan ofon k'efona ch'Juda, ode nnwa kw'Karmi, kw'ode nnwa kw'Zimri, kw'Zẹra obhonọ. Ofona nya, wa ettem epyibh Ọvaar Ibinọkpaabyi ọmaana anọng p'Israẹl.<verse eid="JOS 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 7:2" />Joshua ọtọhm ajinọng banẹ, mabina ny'Jẹriko, machina z'Ai, kw'oning ọnyọma Bẹt-Aven, z'ẹbhaakẹ ch'ewuchen ed-eyin, z'Bẹtẹl. Oben bẹ bẹ́, “Màzọhng baana ẹkọma ndo.” Minna kw'ajinọng mbo mafon, mad-abaana Ai.<verse eid="JOS 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 7:3" />K'ogbe kw'nkk'akwuna akebha Joshua, maben-ẹ bẹ́, “Kọbaan bẹ́, asoja maphyir mad-arima Ai ábẹ̀. Kenaka tọhm asoja nnọhna nchen, wanẹma, asoja nnọhna nchenọmfa okwuma arọbh ijobh za. Kirẹ anọng p'arukọ nya kasaabhẹ. Katte asoja maphyir ad-akibhẹ ogbe nya.” <verse eid="JOS 7:3" /><verse number="4" style="v" sid="JOS 7:4" />Minna kw'asoja p'mm'apyirẹ anọng nnọhna nchenọmfa okwuma arọbh ijobh, mabin ayin erima. Okenaka, anọng p'Ai makema bẹ, <verse eid="JOS 7:4" /><verse number="5" style="v" sid="JOS 7:5" />mafhọ anọng p'Israẹl p'mm'apyirẹ ẹrọbh okwuma ichi kawanẹ. Anọng p'Ai atọma ny'ebhumma ch'ebhondim, makwubh anọng p'Israẹl maa, mapyirẹ z'ibyi s'nd-avọhkọ ata. Mafhọ bẹ z'iwọna-saka. K'ogbe kw'anọng p'Israẹl mabhaang odik nwa, ojora ọbọka bẹ maa, ẹfa ẹsa bẹ kibung-kibungọ.<verse eid="JOS 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 7:6" />Minna kw'Joshua ọyaakẹ ekpo py'ọfọr, otto okwubha ititika ny'izek, ny'ititika s'Ẹkkọhbhọ ch'echekẹ ch'Ọvaar Ibinọkpaabyi. Oninga nya maa, opyirẹ k'ẹsọhka. Asogbọhkọnọng p'Israẹl mabir asi mach'Joshua osi, matukọ ititọhng zabẹ k'nso. <verse eid="JOS 7:6" /><verse number="7" style="v" sid="JOS 7:7" />Joshua oben bẹ́, “O Ọvaar Ibinọkpaabyi kw'Ọyọhng, osempira atima mina ajeka ọraanga kw'Jọrdan bẹ́, achena anọng p'Amọr, mafhọ o? Wura ojibhẹ ọtam bẹ́, motera oninga z'okwubha nwoza kw'Jọrdan! <verse eid="JOS 7:7" /><verse number="8" style="v" sid="JOS 7:8" />O Ọvaar Ibinọkpaabyi, m'mgbaak yen, ch'awawunanọng kk'Israẹl akema? <verse eid="JOS 7:8" /><verse number="9" style="v" sid="JOS 7:9" />Anọng p'Kenaan ọmaana ọnọng kpenamkpen kw'orukọ ny'ẹkọma ndo, mm'abhaanga odik nwa. M'ofona nya, bẹ mm'akọbha mina ake k'ettem, madimẹ mina eche m'iyagbin. Ó̱de óde minna, abarada p'eche chọ, nade yen?”<verse eid="JOS 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 7:10" />Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Bin-obina! Ad-akwubha ititika ny'izek asi mbọng? <verse eid="JOS 7:10" /><verse number="11" style="v" sid="JOS 7:11" />Anọng p'Israẹl kk'epyibha asa. Bẹ nkk'echekẹ chaam ch'mbenẹ bẹ bẹ́, masok, avọhka. Bẹ nkk'afọra asa, mafu ekpo byanẹ py'ẹbar-odik, mattara z'oyena kwabẹ. <verse eid="JOS 7:11" /><verse number="12" style="v" sid="JOS 7:12" />Nya wọ osi, anọng p'Israẹl m'awawunanọng pabẹ ábẹ̀ kakpo arima. Marọbh-ọrọbh z'awawunanọng pabẹ okurọ bẹ́, bẹ bọ mazeng mmo awọhkọ bẹ́, ayok afhọ bẹ. Kaam ọdọk bọnga mìninga mmaana, oyebẹ́, nkk'ọttọhk kpenamkpen f'ọbaan ekibhẹ, f'oning ọmaana bọnga, akibha.<verse eid="JOS 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 7:13" />“Zọhng si anọng p'Israẹl mawur-owur. Ben bẹ bẹ́, ‘Màsok ifor sabọnga iwur-owur k'ewu ch'ophyinẹ, kirẹ Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl obenẹ bẹ́: Bọnga nkk'ekpo byanẹ py'ẹbar-odik, py'mbenẹ bọnga bẹ́, makibhẹ atọka ayena. Bọnga m'ọdọk awawunanọng pabọnga ábẹ̀ makpo, oyebẹ́, nkk'ekpo mbyo py'ẹbar-odik arọhbha ny'ikpakaana sabọnga, abharẹ.<verse eid="JOS 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 7:14" />“ ‘Ophyinẹ k'ekpebha, mm'akwu attonga k'mfonamma k'mfonamma. Ofonamma kw'Ọvaar Ibinọkpaabyi otek, m'oyin k'iyaan k'ẹnọmma k'ẹnọmma. Ẹnọmma ch'Ọvaar Ibinọkpaabyi otek, m'eyin k'iyaan k'ẹsọhmmọr k'ẹsọhmmọr. Ojinọng kw'Ọvaar Ibinọkpaabyi otek k'ẹsọhmmọr kpenamkpen, m'oyin k'iyaan. <verse eid="JOS 7:14" /><verse number="15" style="v" sid="JOS 7:15" />Ọnọng kpenamkpen kw'mabọk amaana ekpo mbyo py'ẹbar-odik, mm'akwọm-ẹ k'ekpon ọmaana ekpo py'oyen maphyir, okurọ bẹ́, ọsana kw'Ọvaar Ibinọkpaabyi kosokọ, obir ọjẹ odik kwiden ny'Israẹl!’ ”<verse eid="JOS 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 7:16" />K'ekpikpebha, Joshua otima anọng p'Israẹl okwu k'mfona-k'mfona. Ọvaar Ibinọkpaabyi oteka efona ch'Juda. <verse eid="JOS 7:16" /><verse number="17" style="v" sid="JOS 7:17" />Nnọmma s'Juda ikwu iyin k'iyaan, Ọvaar Ibinọkpaabyi oteka ẹnọmma ch'Zera. Oben nnọmma s'Zera bẹ́, iyin k'ẹsọhmmọr k'ẹsọhmmọr. Minna kw'Ọvaar Ibinọkpaabyi otek ẹsọhmmọr ch'Zimri. <verse eid="JOS 7:17" /><verse number="18" style="v" sid="JOS 7:18" />Joshua osi ojinọng kpenamkpen kw'ẹsọhmmọr ch'Zimri oyin obe. Ọvaar Ibinọkpaabyi oteka Akan kw'ode nnwa kw'Karmi, kw'ode nnwa kw'Zimri, kw'Zera kw'ofon k'efona ch'Juda obhonọ.<verse eid="JOS 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 7:19" />Nya o, Joshua oben Akan bẹ́, “Nnwa kwaam, nang Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl abarada, abir anang-ẹ ikpukpobha. Yaakẹ ọttọhk f'asi, nang-m; kaam odik kadubh.”<verse eid="JOS 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 7:20" />Akan ọpọhna bẹ́, “Ode odik ọkkọkka bẹ́, kaam kk'epyibha nsa k'ititika s'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl. Odik nwo kw'nsi ode bẹ́: <verse eid="JOS 7:20" /><verse number="21" style="v" sid="JOS 7:21" />K'ogbe kw'morim Jẹriko ábẹ̀, ntọk ọnọhma-baba kw'ojibh-ojibh kw'ọnọng kw'ofon Babilọn nyena, ọmaana ashẹkẹl p'silva arọbh ijobh, ọttara ọbaanga-chigimẹ kw'matim gol asi, kw'adọhbhiji pẹ made ashẹkẹl arọbh afa okwuma ijobh. Ntum epe z'kaam k'ikkira, ndubh silva z'ẹtaanga, mbira nyika ekpo mbyoza nttara nya.”<verse eid="JOS 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 7:22" />Minna kw'Joshua ọtọhmọ azeng-eden, matima ẹbhar achina z'ikkira njo. Mad-aze ekpo mbyo ny'epe, ọttara silva z'epewọr. <verse eid="JOS 7:22" /><verse number="23" style="v" sid="JOS 7:23" />Matọka ekpo mbyo ny'ikkira njo, machena Joshua ọmaana anọng p'Israẹl maphyir, majẹ pyẹ ny'ititika s'Ọvaar Ibinọkpaabyi.<verse eid="JOS 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 7:24" />Nya o, Joshua ọmaana anọng p'Israẹl matọka Akan kw'Zẹra obhonọ, ọmaana silva mbo, ọmaana ọnọhma-baba nwo kw'ojibh-ojibh, ọmaana ọbaangachi-gimẹ nwo kw'matim gol asi, ọmaana iva pẹ k'ejinọng ọttara k'ẹpanọng, ọmaana adamogbodo pẹ, ọmaana nnyanya s'id-itọhka ekpo, ọmaana arọkimaan, ọmaana ikkira sẹ, ọttara ọttọhk kpenamkpen f'ode fẹ, matima achina z'ilokodo s'Akọr. <verse eid="JOS 7:24" /><verse number="25" style="v" sid="JOS 7:25" />Joshua oben bẹ́, “Osempira ajẹ odikse nwa anang mina o? Ọvaar Ibinọkpaabyi m'ọkọ-ọ ẹkọhr menda.” Minna kw'anọng p'Israẹl maphyir matobhọ Akan ọmaana ẹsọhmmọr chẹ ata maa, mape. Matọka bẹ ọmaana oyena kwẹ, makwọmọ. <verse eid="JOS 7:25" /><verse number="26" style="v" sid="JOS 7:26" />Ofona nya o, ettem etika Ọvaar Ibinọkpaabyi opyipyibh. Nya ch'uwa mafhọ Akan, ọtakkin oterẹ za maa, pyirẹ menda. Nya wọ osi tọma za, makpe ibyi njo bẹ́, Ilokodo s'Akọr.<verse eid="JOS 7:26" /></para>
  <chapter eid="JOS 7" />
  <chapter number="8" style="c" sid="JOS 8" />
  <para style="s1">Anọng p'Israẹl akem obhon kw'Ai</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1" />Nya o, Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Oning-ọ ojor; ifor ining-ọ imọmọ. Tima asoja maphyir, ad-arima obhon kw'Ai ábẹ̀. Kirẹ, kaam kk'ọvaarnọng kw'Ai, ọmaana anọng pẹ, ọmaana ebhondim chẹ, ọttara ẹkọma chẹ, ntọka nkọ-ọ k'mbọhk. <verse eid="JOS 8:1" /><verse number="2" style="v" sid="JOS 8:2" />Si obhon kw'Ai ọttara ọvaarnọng kwẹ, mach'asi obhon kw'Jẹrikọ ọttara ọvaarnọng kwẹ. Okenaka, mọkpanda, m'atọka ekpo, ọttara etirakpo pyabẹ. Yima egbong kọbha ebhondim ndo ke k'ettem.”<verse eid="JOS 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 8:3" />Minna kw'Joshua ọmaana asoja maphyir mafon bẹ́, mad-arima obhon kw'Ai ábẹ̀. Joshua ọrọhbha arimanọng pẹ p'agaang-ọgaangẹ anọng nnọhna arọbh attaan okwuma ichi. Ọtọhm bẹ k'erungọ, <verse eid="JOS 8:3" /><verse number="4" style="v" sid="JOS 8:4" />oben bẹ bẹ́, “Màyonga itọhng mawuriji. Mm'ayima egbong z'nnam-nnam kw'ebhondim ndo. M'ebhondim ndo obhokọ kidaam kànang. Bọnga maphyir m'ifor kàzaama o. <verse eid="JOS 8:4" /><verse number="5" style="v" sid="JOS 8:5" />Kaam ọmaana anọng maphyir p'm'ntima, mm'odim ny'ebhondim ndo. K'ogbe kw'makwu arima mina ábẹ̀, mach'nd-akkikken asi, mm'ọrọbh. <verse eid="JOS 8:5" /><verse number="6" style="v" sid="JOS 8:6" />Mm'ọdaabha bẹ mabina arik ebhondim chabẹ, makwubh mina maa, maben bẹ́, ‘Mina bọ p'nd-arọbh nya mach'nd-akkikken arọbh.’ Ó̱de nkk'mina akwubha minna o, <verse eid="JOS 8:6" /><verse number="7" style="v" sid="JOS 8:7" />nya kw'bọnga mm'abina za ch'mayim egbong, mad-abọka ebhondim ndo. Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga m'ọtọka ebhondim ndo oke bọnga k'mbọhk. <verse eid="JOS 8:7" /><verse number="8" style="v" sid="JOS 8:8" />K'ogbe kw'nkk'ebhondim ndo abọka, màke dẹ ekpon. Màsi k'ose kw'Ọvaar Ibinọkpaabyi ikk'obena. Màzonga bẹ́, kk'bọnga ẹfa nnanga.”<verse eid="JOS 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 8:9" />Minna kw'Joshua ọtọhm bẹ, mad-ayima egbong z'njeka kw'Bẹtẹl ọmaana Ai, z'ẹbhaakẹ ch'ewuchen ed-edimẹ z'Ai. Okenaka, Joshua obhing ọmaana asoja ny'orungiwu nwo.<verse eid="JOS 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 8:10" />Joshua obina ny'ekpikpebha, otobha asoja pẹ. Kẹ ọttara adidennọng p'Israẹl matim bẹ azeng z'Ai. <verse eid="JOS 8:10" /><verse number="11" style="v" sid="JOS 8:11" />Esojakaan ndo maphyir ch'uwa ening ẹmaan-ẹ, mazenga manyọma ebhondim ndo. Mattima ibhingabyi z'ebir-ebir kw'Ai, ilokodo ininga ny'njeka kw'bẹ ọttara Ai. <verse eid="JOS 8:11" /><verse number="12" style="v" sid="JOS 8:12" />Ode ch'Joshua ikk'agbongnọng p'mm'apyirẹ nnọhna ijobh kkamfa okwuma arọbh ijobh ọtọhma bẹ́, mad-ayima egbong z'njeka kw'Ai ọmaana Bẹtẹl, z'ẹbhaakẹ ch'ewuchen ed-edimẹ ny'ebhondim ndo. <verse eid="JOS 8:12" /><verse number="13" style="v" sid="JOS 8:13" />Minna kw'makebhẹ asoja mbo masok k'ibyi-k'ibyi. Masok ibhingabyi sabẹ z'ebir-ebir kw'ebhondim ndo. Mayim egbong z'ẹbhaakẹ ch'ewuchen ed-edimẹ ny'ebhondim ndo. Ny'orungiwu nwo, Joshua ochina z'ilokodo.<verse eid="JOS 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 8:14" />K'ogbe kw'ọvaarnọng kw'Ai oze odik nwa, minna kw'kẹ ọmaana ajinọng p'ebhondim ndo maphyir masẹr-ọsẹr abina k'ekpebha erungọ-rungọ bẹ́, mad-arima anọng p'Israẹl ábẹ̀ z'ibyi janẹ s'ikkerẹ Araba ititika. Okenaka, kẹ kozong bẹ́, nkk'egbong ayima atik bẹ z'nnam-nnam kw'ebhondim ndo. <verse eid="JOS 8:14" /><verse number="15" style="v" sid="JOS 8:15" />Joshua ọmaana anọng p'Israẹl maphyir matte anọng p'Ai ọbọhk makwubh bẹ achina z'ibyi ch'anọng nna arukọ. <verse eid="JOS 8:15" /><verse number="16" style="v" sid="JOS 8:16" />Wa mawon ẹmọng bẹ́, ojinọng kpenamkpen kw'Ai oyin ka makwubh Joshua. Minna kw'makwubhọ Joshua maa, ọdaabh bẹ otima obina orik ebhondim. <verse eid="JOS 8:16" /><verse number="17" style="v" sid="JOS 8:17" />Wa ojinọng korikẹ ny'Ai wanẹma ny'Bẹtẹl kw'ina anọng p'Israẹl okwubhọ. Minna kw'matte obhon ọbọhk otte eje, makwubh anọng Israẹl.<verse eid="JOS 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 8:18" />Nya o, Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Tena ọkọhn f'atim ny'ọbọhk kwọ z'Ai, kirẹ, kk'ebhondim ndo ntọka nkọ-ọ ny'ọbọhk.” Minna kw'Joshua oten ọkọhn mvo f'otim ny'ọbọhk, z'ẹbhaakẹ ch'Ai. <verse eid="JOS 8:18" /><verse number="19" style="v" sid="JOS 8:19" />K'ose otitena ọkọhn mvo za, ajinọng mbo p'mayim egbong, matima ẹbhar abina za ch'matubh, mayin k'iyaan. Minna kw'madimẹ z'ebhondim ndo, mabọka dẹ, mabir asẹr-ọsẹr ake dẹ ekpon.<verse eid="JOS 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 8:20" />Anọng p'Ai abhakẹ nnam, maze izizong s'id-iyin z'ebhondim ichina z'ọrọngkpakpa. Okenaka, bẹ m'ọdọk obhokọ kayen kw'mm'azenga arọbh achina ibyi kpenamkpen, okurọ bẹ́, anọng p'Israẹl p'uwa nd-arọbh-ọrọbh achina z'ibyi s'anọng nna arukọ, bẹ nnatera abhakẹ nnam arima bẹ ábẹ̀. <verse eid="JOS 8:20" /><verse number="21" style="v" sid="JOS 8:21" />Ch'Joshua ọmaana anọng p'Israẹl maphyir maze bẹ́, anọng mbo p'mayim egbong kk'ebhondim ndo abọka, ọmaana bẹ́, nkk'izizong aza s'id-iyin za, minna kw'mabhakẹ, marima ajinọng p'Ai ábẹ̀. <verse eid="JOS 8:21" /><verse number="22" style="v" sid="JOS 8:22" />Anọng mbo p'mayim egbong mabir abina z'ebhondim, makọbh bẹ ake k'ettem. Anọng p'Israẹl mafhọ bẹ maphyir, ọnọng mawan-wanẹ, kọnaang. <verse eid="JOS 8:22" /><verse number="23" style="v" sid="JOS 8:23" />Okenaka, mabọka ọvaarnọng kw'Ai k'ẹmmọri, matọk-ẹ achena Joshua.<verse eid="JOS 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 8:24" />K'ogbe kw'anọng p'Israẹl nkk'ajinọng p'Ai afha maphyir z'mgba sabẹ, ọmaana z'ibyi s'anọng nna arukọ ch'makwubh bẹ abharẹ, ọttara bẹ́, nkk'ọnọng kpenamkpen afha, minna kw'anọng p'Israẹl makpa nnam z'Ai, mad-afhọ anọng p'aning nya. <verse eid="JOS 8:24" /><verse number="25" style="v" sid="JOS 8:25" />Anọng p'Ai maphyir k'ejinọng ọmaana k'ẹpanọng p'uwa mafhọ ny'ewu ndo, made anọng nnọhna ẹrọbh okwuma ijobh. <verse eid="JOS 8:25" /><verse number="26" style="v" sid="JOS 8:26" />Wa Joshua ochina ororo otima ọkọhn mvo ny'ọbọhk mach'otim nya maa, ọfhọ anọng p'arukọ ny'Ai maphyir. <verse eid="JOS 8:26" /><verse number="27" style="v" sid="JOS 8:27" />Anọng p'Israẹl atọka etirakpo, ọttara oyena kw'ebhondim ndo, matima afona, tor k'ose kw'Ọvaar Ibinọkpaabyi ikk'Joshua obena.<verse eid="JOS 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 8:28" />Minna kw'Joshua ọkwọmọ obhon kw'Ai maa, ọdọk eruka kode, pyirẹ menda. <verse eid="JOS 8:28" /><verse number="29" style="v" sid="JOS 8:29" />Joshua orena ọvaarnọng kw'Ai edik k'echi, otte oforbukọ kwẹ ọbọhk orena nya maa, opyirẹ k'ẹsọhka. Otum ny'ẹsọhka, Joshua oke ẹfa bẹ́, màsanga oforbukọ nwo ny'echi, mad-abharẹ z'ebhumma ch'ebhondim ndo. Mayak-ẹ ata maa, ozeng ọtakkin. Ọtakkin nwo, otim oning za maa, pyirẹ menda.<verse eid="JOS 8:29" /></para>
  <para style="s1">Joshua oyerẹ apaanga p'Mosẹs ọnang anọng p'Israẹl</para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 8:30" />Nya o, Joshua osi ija-byi s'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl z'egbe ch'Ebal, <verse eid="JOS 8:30" /><verse number="31" style="v" sid="JOS 8:31" />tor k'ose kw'uwa Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ikk'anọng p'Israẹl obena. Wa osi ija-byi njo otor k'ose kw'nkk'akkẹra z'Nnwẹr kw'apaanga p'Mosẹs. Ata p'uwa nna ọtọhmttọhk mach'ẹbaanga atim akpaara bọ p'uwa matim asi ija-byi njo. Ny'ija-byi njo jọ s'iwa makwọmọ nnanga, mabir afọhnọ nja s'eforgbaka anang Ọvaar Ibinọkpaabyi. <verse eid="JOS 8:31" /><verse number="32" style="v" sid="JOS 8:32" />Joshua oninga ny'ititika s'anọng p'Israẹl, ọkkẹr apaanga p'Mosẹs ny'ata mbo. <verse eid="JOS 8:32" /><verse number="33" style="v" sid="JOS 8:33" />Anọng p'Israẹl maphyir, ọmaana asogbọhkonọng pabẹ, ọmaana asonọng pabẹ, ọttara akpaar-aponga, wa mabe k'okwubha-k'okwubha kw'Ẹkkọhbhọ ch'Ẹchekẹ ch'Ọvaar Ibinọkpaabyi, makkerẹ afọhn-ẹja p'ẹnọmma ch'Lẹvi, p'atọhk Ẹkkọhbhọ ndo. Akikennọng p'arukọ amaana bẹ ọttara ammaana maninga nya ọttara. Igboka janẹ s'anọng mbo ibe z'ititika-ititika kw'Egbe ch'Gerizim, igboka janẹ ibe z'ititika-ititika kw'Egbe ch'Ebal, tor k'ose kw'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ikk'okkikken oben k'ogbe kw'ọnang ntọhna s'otim odo anọng p'Israẹl.<verse eid="JOS 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 8:34" />Nya o, Joshua oyerẹ idik s'apaanga mbo maphyir k'ose kw'nkk'akkẹra z'Nnwẹr kw'apaanga, kw'ode ejibha ọmaana itama. <verse eid="JOS 8:34" /><verse number="35" style="v" sid="JOS 8:35" />Wa odik ny'apaanga p'Mosẹs ọkkẹrẹ kode, kw'Joshua ina oyerẹ ọnang ikpakaana njo s'Israẹl, s'ittar ivava, ọmaana panọng, ọttara akikennọng p'arukọ amaana bẹ.<verse eid="JOS 8:35" /></para>
  <chapter eid="JOS 8" />
  <chapter number="9" style="c" sid="JOS 9" />
  <para style="s1">Anọng p'Gibeọn abọhr Joshua</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1" />K'ogbe kw'avaar maphyir p'aning z'ẹbhaakẹ ch'ewuchen ed-edimẹ z'okwubha kw'Jọrdan mabhaang idik nja, ọmaana avaar p'ẹkọma ch'agbe, ọmaana avaar p'agbemmo p'aning z'ẹbhaakẹ ch'ewuchen ed-edimẹ, ọttara avaar p'arukọ ny'akonga maphyir p'Ọraanga Kwiden kw'Meditereniya maa, pyirẹ z'Lebanọn, (p'ade avaar p'ibhon s'Hẹt, ọmaana p'Amọr, ọmaana p'Kenaan, ọmaana p'Periz, ọmaana p'Hiv, ọttara p'Jebu), <verse eid="JOS 9:1" /><verse number="2" style="v" sid="JOS 9:2" />bẹ maphyir makwu agbaka mbọhk bẹ́, marima egbong amaana Joshua ọmaana Israẹl.<verse eid="JOS 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 9:3" />Okenaka, k'ogbe kw'anọng p'Gibeọn mabhaang ọttọhk f'Joshua ikk'anọng p'Jẹriko ọmaana p'Ai ọsa, <verse eid="JOS 9:3" /><verse number="4" style="v" sid="JOS 9:4" />minna kw'matim nkkar afona mach'anọng p'matọhm bẹ ọtọhm. Matọka mkpa, ọmaana nkpa s'atuk s'matim ntenkpa asi s'ikk'itama, ibira ike abhaak p'mabọhr-ọbọhra, manana k'nnyanya s'id-itọhka ekpo. <verse eid="JOS 9:4" /><verse number="5" style="v" sid="JOS 9:5" />Matọka idikpa-tọkọ s'ikk'itama s'nkk'abọhra make z'mmo, mafọra ekpo py'ikk'ẹtama z'ifor. Brẹd maphyir kw'uwa matim, ogwu <char style="it">bẹ́ kẹkẹdẹ</char>, obira otto mbonaana. <verse eid="JOS 9:5" /><verse number="6" style="v" sid="JOS 9:6" />Nya o, mafona mad-akebha Joshua za ch'obhingẹ z'Gilgal. Maben kẹ ọmaana anọng p'Israẹl bẹ́, “Mofon k'ẹkọma ch'ebhir-obhir okwu ma e. Tte mochekẹ ọnang ayok.”<verse eid="JOS 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 9:7" />Okenaka, anọng p'Israẹl aben anọng p'Hiv bẹ́, “Okerẹ mina bẹ́, bọnga marukọ anyọma mina ma. Kayen kw'mm'ochekẹ ọnang ayok?”<verse eid="JOS 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 9:8" />Bẹ maben Joshua bẹ́, “Mina mode atọhmnọng pọ.</para>
  <para style="p" vid="JOS 9:8">Okenaka, Joshua ọbọbh bẹ bẹ́, “Bọnga made bọng-anọng? Mafon memma?”<verse eid="JOS 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 9:9" />Mapọhna Joshua bẹ́, “Atọhmnọng pọ afon k'ẹkọma ch'ebhirẹ eden mawuriji akwu, okurọ ose kw'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga, oyinẹ eche. Mina nkk'idik sẹ ọbhaanga, kw'ode idik maphyir s'osi z'Ijip, <verse eid="JOS 9:9" /><verse number="10" style="v" sid="JOS 9:10" />ọmaana s'osi avaar afa p'Amọr p'aning z'ẹbhaakẹ ch'ewuchen ed-eyin, z'ọraanga kw'Jọrdan, p'ade ọvaar Sihọn kw'Hẹshbọn, ọmaana ọvaar Ọg kw'Bashan kw'ọbaabh ẹkọma ch'Ashtarọt. <verse eid="JOS 9:10" /><verse number="11" style="v" sid="JOS 9:11" />Nya o, asogbọhkọnọng ọmaana anọng maphyir p'marukọ ny'ẹkọma chamina maben mina bẹ́, ‘Màtima ẹchakpo bina ozenga; màzọhng kebha bẹ, maben bẹ bẹ́, “Mina mode atọhmnọng pabọnga. Tte mochekẹ ọnang ayok.” ’ <verse eid="JOS 9:11" /><verse number="12" style="v" sid="JOS 9:12" />Wa brẹd nwa kwamina ọdaan-ọdaana k'ogbe kw'mobin ozenga bẹ́, mokwu ma. Kirẹ ose kw'ikk'ọgwa <char style="it">bẹ́ kẹkẹdẹ</char> obira otto mbonana m'eninga nda. <verse eid="JOS 9:12" /><verse number="13" style="v" sid="JOS 9:13" />Wa mkpa nja s'atuk ide ibhasẹ k'ogbe kw'moke atuk. Okenaka, kirẹ ose kw'ikk'abhaak ika. Ẹfọrakpo pyamina ọmaana ndikpatọkọ famina kk'ọtama kpo okurọ odenbhir nwo.”<verse eid="JOS 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 9:14" />Anọng p'Israẹl o, matọka ekpo py'anọng mbo matim akwu, m'Ọvaar Ibinọkpaabyi odik kabọbhọ. <verse eid="JOS 9:14" /><verse number="15" style="v" sid="JOS 9:15" />Joshua ochekẹ ọmaana bẹ bẹ́, m'otte bẹ ọbọhk maruk k'ẹmẹm ny'ẹkọma chẹ. Adidennọng p'Israẹl machera k'echekẹ ndo.<verse eid="JOS 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 9:16" />Ch'iwu ittaan ikk'ikpana s'echekẹ chabẹ ọmaana anọng p'Gibeọn, anọng Israẹl akwu abhaanga bẹ́, anọng mbo matera afona ny'ẹkọma ch'ẹnyọm bẹ nya. <verse eid="JOS 9:16" /><verse number="17" style="v" sid="JOS 9:17" />Minna kw'anọng p'Israẹl mabin ozenga ny'iwu ttong ittaan, machina z'ebhondim ch'Gibeọn, ọmaana ch'Kephira, ọmaana ch'Beerọt, ọttara ch'Kiriat-Jearim. <verse eid="JOS 9:17" /><verse number="18" style="v" sid="JOS 9:18" />Okenaka, anọng p'Israẹl m'erima kasi amaana bẹ, okurọ echekẹ ch'mayen amaana ayok k'eche ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi Israẹl.</para>
  <para style="p" vid="JOS 9:18">Ọttọhk f'adidennọng p'Israẹl asi, ọwọhkọ ikpakaana s'Israẹl inwọhnọ. <verse eid="JOS 9:18" /><verse number="19" style="v" sid="JOS 9:19" />Okenaka, adidennọng mbo maphyir mapọhna bẹ́, “M'bẹ ọttọhk mòsi okurọ bẹ́, nkk'ocheka k'eche ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl. <verse eid="JOS 9:19" /><verse number="20" style="v" sid="JOS 9:20" />Ọttọhk f'mm'osi bẹ ode bẹ́, mm'otte bẹ ọbọhk maruk akpen, mfha Ibinọkpaabyi oning ottempyibha kwẹ otim otor mina ch'mọvọhkọ echekẹ ch'moyen ọmaana bẹ.” <verse eid="JOS 9:20" /><verse number="21" style="v" sid="JOS 9:21" />Adidennọng mbo machina ororo aben bẹ́, “Mm'otte bẹ ọbọhk maruk akpen. Okenaka, ọtọhm f'bẹ mm'asi anang iyokinọng-kpakaana nja s'Israẹl, ode nchi okkikkọhbh ọmaana asi okikaabha.” Minna kw'adidennọng mbo, makpobh echekẹ ch'mayen amaana ayok.<verse eid="JOS 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 9:22" />Joshua oyerẹ anọng p'Gibeọn mattonga, ọbọbh bẹ bẹ́, osempira mabọhra mina bẹ́, “Mofon k'ẹkọma ch'ebhirẹ eden okwu, ch'bọnga marukọ anyọma mina ma? <verse eid="JOS 9:22" /><verse number="23" style="v" sid="JOS 9:23" />Ofona nya, nkk'bọnga ẹmma ọnanga. Ọtọhm f'bọnga mm'asi k'akpen pabọnga maphyir ode nchi okkikkọhbh ọmaana asi okikaabha k'ọtọhm f'ọsọhm kw'Ibinọkpaabyi kwaam.”<verse eid="JOS 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 9:24" />Mapọhna Joshua bẹ́, “Mina mosi minna okurọ ch'nkk'ozonga bẹ́, wa Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ kk'Mosẹs kw'ode ọtọhmnọng kwẹ obena bẹ́, ọtọka izek nja maphyir ọnang bọnga, obira ọfhọ anọng p'arukọ nya maphyir. Nya wọ osi, mosi odik nwa okurọ akpen pamina ọmaana ojora kw'moyen k'ikọ. <verse eid="JOS 9:24" /><verse number="25" style="v" sid="JOS 9:25" />Mina nnoning k'mbọhk sọ. Si mina ọttọhk okpenamkpen f'ọdaak-ọ, ọmaana f'obira ojibh-ọ.”<verse eid="JOS 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 9:26" />Minna kw'Joshua ozeng ọkkaana bẹ k'mbọhk s'anọng p'Israẹl. M'ọdọk bẹ kafhọ. <verse eid="JOS 9:26" /><verse number="27" style="v" sid="JOS 9:27" />Ny'ewu ndo, Joshua osi anọng p'Gibeọn atọhmnọng p'mmin'akkọhbh nchi, mabira akaabha asi anang anọng p'Israẹl, mfha matima asi ọtọhm f'ija-byi s'Ọvaar Ibinọkpaabyi, k'ibyi s'ikẹ Ọvaar Ibinọkpaabyi im'oteka bẹ́, mad-aninga akpobh-ẹ. Maa, pyirẹ menda, anọng mbo atim osi ọtọhm mvo osi za.<verse eid="JOS 9:27" /></para>
  <chapter eid="JOS 9" />
  <chapter number="10" style="c" sid="JOS 10" />
  <para style="s1">Ewuchen ebe k'ibyi majanẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1" />Nya o, ọvaar Adoni-Zedek kw'Jẹrusalẹm okwu ọbhaanga bẹ́, Joshua kk'egbong orima ọmaana ẹkọma ch'Ayi maa, odimẹ dẹ eche, orima ẹkọma ch'Ayi ọmaana avaarnọng pẹ mach'iwa osi ẹkọma ch'Jẹriko ọttara avaarnọng pẹ. Obira ọbhaanga bẹ́, anọng p'ẹkọma ch'Gibeọn nkk'ẹmẹm asa amaana anọng p'Israẹl, ofona nya, nnazeng ẹkaan madanẹ. <verse eid="JOS 10:1" /><verse number="2" style="v" sid="JOS 10:2" />Wa odik nwoma, ọwọhkọ opoma ọbọka ọvaar Adoni-Zedek ọmaana anọng pẹ, okurọ ch'Gibeọn ode ebhondim ch'ẹbarẹ odik, ọmaana ch'ede mach'ivaarbhon. Wa Gibeọn ọbarẹ ẹkpa ọyọhnga Ai, ajinọng p'obhon nwo maphyir, made arimanọng ọkkọkka. <verse eid="JOS 10:2" /><verse number="3" style="v" sid="JOS 10:3" />Ofona nya o, ọvaar Adoni-Zedek kw'Jẹrusalẹm, od-okwukọ ọvaar Hoham kw'Hẹbrọn, ọmaana ọvaar Piram kw'Jarmut, ọmaana ọvaar Japhia kw'Lakish, ọttara ọvaar Debir kw'Eglọn bẹ́, <verse eid="JOS 10:3" /><verse number="4" style="v" sid="JOS 10:4" />“Màkwu tor-m morima Gibeọn ábẹ̀, okurọ bẹ́, nkk'agba amaana anọng p'Israẹl.”<verse eid="JOS 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 10:5" />Minna kw'avaar mbo achen p'ẹkọma ch'Amọr, p'ade avaar p'Jẹrusalẹm, ọmaana p'Hẹbrọn, ọmaana p'Jarmut, ọmaana p'Lakish, ọttara p'Eglọn makwu agbaka. Matima agbongnọng pabẹ maphyir, mad-ayima egbong z'Gibeọn, marim-ẹ ábẹ̀.<verse eid="JOS 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 10:6" />Ofona nya, anọng p'Gibeọn, matọhm ẹkkaabha anang Joshua za ch'obhingẹ z'Gilgal bẹ́, “Mina ọbọhk katte o! Kwu kkaana mina ẹbhar-ẹbhar o! Kwu kkaana mina, kirẹ avaar p'Amọr maphyir p'aning z'ẹkọma ch'egbe kk'agbaka bẹ́, marima mina ábẹ̀.”<verse eid="JOS 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 10:7" />Minna kw'Joshua otim asoja pẹ maphyir, ọttara arimanọng pẹ ọkkọkka, obina ozeng z'Gilgal. <verse eid="JOS 10:7" /><verse number="8" style="v" sid="JOS 10:8" />Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Oning-ọ ojor, okurọ bẹ́, kaam kk'bẹ ntọka nkọ-ọ ny'mbọhk. Ọnọng nya kode kw'im'okpo orimọ-ọ ábẹ̀.”<verse eid="JOS 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 10:9" />K'ogbe kw'Joshua kk'orungọwu kibungọ otima obina z'Gilgal, okwu oyin anọng p'ẹkọma ch'Amọr <char style="it">bẹ́ fẹrẹm</char>, orima bẹ́, ábẹ̀. <verse eid="JOS 10:9" /><verse number="10" style="v" sid="JOS 10:10" />Ọvaar Ibinọkpaabyi oke bẹ k'damadama ny'Israẹl k'ititika. Joshua ọmaana anọng p'Israẹl makema anọng p'Gibeọn kibung-kibungọ. Makwubh bẹ k'odum kw'eden ch'echin Bẹt-Horon, mafhọ bẹ maa, mapyirẹ z'eden ch'Azeka ọmaana Makkeda. <verse eid="JOS 10:10" /><verse number="11" style="v" sid="JOS 10:11" />K'ose kw'nd-arọbh, nya ch'anọng p'Israẹl ad-akwubh bẹ ny'eden, tọma z'Bẹt-Horon maa, pyirẹ z'Azeka, Ọvaar Ibinọkpaabyi otebh bẹ ata ny'ifor maa, mape k'ọsaabh. Anọng p'uwa ata mbo mafhọ, masaabhẹ ayọhnga anọng p'Israẹl atim ọkkangkkang afhọ.<verse eid="JOS 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 10:12" />Ny'ewu ch'Ọvaar Ibinọkpaabyi ọtọk anọng p'Amọr oke anọng p'Israẹl k'mbọhk bẹ́, makema bẹ, Joshua oning ny'ititika s'anọng p'Israẹl oben Ọvaar Ibinọkpaabyi bẹ́,</para>
  <para style="q1" vid="JOS 10:12">“Ewuchen be <char style="it">bẹ́ tting</char> ny'Gibeọn.</para>
  <para style="q2" vid="JOS 10:12">Kọ ophe, bira be <char style="it">bẹ́ tting</char> z'ilokodo s'Aijalọn.”<verse eid="JOS 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOS 10:13" />Minna kw'ewuchen ebe <char style="it">bẹ́, tting</char>,</para>
  <para style="q2" vid="JOS 10:13">ophe obira obe <char style="it">bẹ́ tting</char></para>
  <para style="q2" vid="JOS 10:13">maa, anọng p'Israẹl akema awawunanọng pabẹ, otor k'ose kw'uwa nkk'akkẹra k'Nnwẹr kw'Jashar.</para>
  <para style="p" vid="JOS 10:13">Ewuchen ebe <char style="it">bẹ́ tting</char>, ny'ottem kw'ọrọngkpakpa, ọdọk kezeng k'ọttọhk k'ewu kibungọ. <verse eid="JOS 10:13" /><verse number="14" style="v" sid="JOS 10:14" />Ch'obobe ode, ewu se nda, etim eninga ch'Ọvaar Ibinọkpaabyi oyong oyokinọng itọhng. K'odik ọkkọkka, Ọvaar Ibinọkpaabyi wọ uwa od-osi erima ndo ọnang anọng p'Israẹl!<verse eid="JOS 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 10:15" />Nya o, Joshua otima anọng p'Israẹl maphyir ọkpa nnam z'ibhinga-byi, z'Gilgal.<verse eid="JOS 10:15" /></para>
  <para style="s1">Joshua ọfhọ avaar achen p'Amọr</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16" />M'ogbe nwa, wa avaar mbo achen kk'arọbha atubha k'atakpamma p'aning z'Makkeda. <verse eid="JOS 10:16" /><verse number="17" style="v" sid="JOS 10:17" />Ch'matekẹ Joshua bẹ́, nkk'avaar mbo achen aza ch'matubh k'atakpamma z'Makkeda, <verse eid="JOS 10:17" /><verse number="18" style="v" sid="JOS 10:18" />oben bẹ́, “Màbingẹ ntakpa, matima ad-akpa atakpamma mbo. Màbir sok ajinọng banẹ nya bẹ́, makkerẹ ibyi njo. <verse eid="JOS 10:18" /><verse number="19" style="v" sid="JOS 10:19" />Okenaka, bọnga m'nnam kàtọr k'awawunanọng pabọnga okwukwubh! Màkpaama bẹ z'nnam-nnam, marima bẹ ábẹ̀. M'bẹ ọbọhk katte manaanga bọnga achina z'ibhondim sabẹ. Kirẹ Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga kk'bẹ ọtọka oke bọnga k'mbọhk bẹ́, makema bẹ.”<verse eid="JOS 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 10:20" />Minna kw'Joshua ọmaana anọng p'Israẹl mazeng akema bẹ. Okenaka, wa m'bẹ maphyir kafhọ. Anọngva p'manaang, makonga arọbh apyirẹ z'ibhondim s'ide ifa-byi sabẹ. <verse eid="JOS 10:20" /><verse number="21" style="v" sid="JOS 10:21" />Asoja p'Israẹl maphyir makwuna k'oforgbọhkọ, makebha Joshua za ch'obhingẹ z'Makkeda. Wa otebh ọnọng mawanẹ kw'ọgbaakẹ itama ọnang anọng p'Israẹl.<verse eid="JOS 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 10:22" />Joshua oben asoja mbo bẹ́, “Màgwunga ọtakpamma nwo, marọhbha avaar mbo achen machen-m m'iyaan.” <verse eid="JOS 10:22" /><verse number="23" style="v" sid="JOS 10:23" />Minna kw'marọhbh avaar mbo achen p'ẹkọma ch'Amọr, kw'ode ọvaarnọng kw'Jẹrusalẹm, ọmaana kw'Hẹbrọn, ọmaana kw'Jarmut, ọmaana kw'Lakish, ọttara kw'Eglọn z'ọtakpamma, mabharẹ k'iyaan. <verse eid="JOS 10:23" /><verse number="24" style="v" sid="JOS 10:24" />K'ogbe kw'matim bẹ akebh Joshua nya, oyerẹ ajinọng p'Israẹl maphyir, mattonga. Oben aso p'nsoja-kaan s'matọnọ bẹ́, “Màkwu barẹ avaar mba ntọkọ k'ndọngọ.” Minna kw'makwu abarẹ avaar mbo ntọkọ k'ndọngọ.<verse eid="JOS 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 10:25" />Joshua oben bẹ bẹ́, “Oning bọnga ojor; ettem ening bọnga ẹyọhnọ. Màbe z'izek mawuriji, mabir agaangẹ nttem. Minna wọ kw'Ọvaar Ibinọkpaabyi m'osi awawunanọng maphyir p'bọnga mm'arima ábẹ̀.” <verse eid="JOS 10:25" /><verse number="26" style="v" sid="JOS 10:26" />Minna kw'Joshua ọfhọ avaar mbo achen, ọtọka aforbukọ pabẹ orena k'mfafa-chi. Marena nya maa, opyirẹ k'ẹsọhka.<verse eid="JOS 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 10:27" />Opyirẹ ny'ẹsọhka, Joshua oke ẹfa bẹ́, masanga bẹ z'mfa-fachi njo. Minna kw'masang bẹ, mabharẹ bẹ z'atakpamma mbo p'makkikken atubha. Mabubha ata piden ny'atakpamma mbo, p'atim aning za minna maa, pyirẹ menda.<verse eid="JOS 10:27" /></para>
  <para style="s1">Joshua okem ibhondim s'ẹkọma ch'Amọr</para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 10:28" />Ny'ewu ndo, Joshua orima maa, ọbọka obhon kw'Makkeda. Ọfhọ ọvaarnọng kw'ebhondim ndo, ọttara ọnọng kpenamkpen kw'orukọ nya. Ọnọng mawanẹ kw'otte ọbọhk oruk akpen, kode. Wa osi ọvaarnọng kw'Makkeda mach'osi ọvaarnọng kw'Jẹriko.<verse eid="JOS 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 10:29" />Nya o, Joshua ọmaana asoja p'otim maphyir, mabina ny'Makkeda, mad-arima ebhondim ch'Libna ábẹ̀. <verse eid="JOS 10:29" /><verse number="30" style="v" sid="JOS 10:30" />Ọvaar Ibinọkpaabyi obira ọtọka ebhondim ch'Libna ọmaana ọvaarnọng kw'ọbaabh dẹ, oke anọng p'Israẹl k'mbọhk bẹ́, makema bẹ. Joshua ọfhọ ọnọng kpenamkpen kw'orukọ ny'ebhondim ndo. Ọnọng mawanẹ kw'otte ọbọhk oruk akpen, kode. Joshua osi ọvaarnọng kw'ebhondim ndo, mach'osi ọvaarnọng kw'Jẹriko.<verse eid="JOS 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 10:31" />Nya o, Joshua ọmaana asoja pẹ maphyir, mabina ny'Libna, mad-ayima egbong z'ebhondim ch'Lakish, marima dẹ ábẹ̀. <verse eid="JOS 10:31" /><verse number="32" style="v" sid="JOS 10:32" />Ọvaar Ibinọkpaabyi ọtọka ebhondim ch'Lakish oke anọng p'Israẹl k'mbọhk, Joshua ọbọka ebhondim ndo k'ose kw'ewu esobh. Minna kw'ọfhọ ọnọng kpenamkpen kw'orukọ ny'ebhondim ndo. Ọnọng mawanẹ kw'otte ọbọhk oruk akpen, kode. Joshua osi ọvaarnọng kw'ebhondim ndo mach'osi ọvaarnọng kw'Libna. <verse eid="JOS 10:32" /><verse number="33" style="v" sid="JOS 10:33" />Ode ch'ọvaar Horam kw'Gezer ikk'ọkwa bẹ́, otor ọvaarnọng kw'Libna egbong. Okenaka, Joshua ọfhọ kẹ ọmaana asoja pẹ. Ọnọng mawanẹ kw'otte ọbọhk oruk akpen, kode.<verse eid="JOS 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 10:34" />Nya o, Joshua ọmaana asoja pẹ maphyir, mabina ny'Lakish, mad-ayima egbong z'obhon kw'Eglọn, marima wẹ ábẹ̀. <verse eid="JOS 10:34" /><verse number="35" style="v" sid="JOS 10:35" />Mabọka obhon nwo ny'ewu ndo madanẹ-danẹ. Mafhọ ọnọng kpenamkpen kw'orukọ nya. Ọnọng mawanẹ-wanẹ kw'matte ọbọhk oruk akpen, kode. Masi obhon nwo mach'masi obhon kw'Lakish.<verse eid="JOS 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 10:36" />Nya o, Joshua ọmaana asoja pẹ maphyir, mabina ny'Eglọn, mad-arima obhon kw'Hẹbrọn, ábẹ̀. <verse eid="JOS 10:36" /><verse number="37" style="v" sid="JOS 10:37" />Minna kw'mabọk ebhondim ndo, mafhọ ọvaarnọng kw'ọbaabh dẹ, mabir adimẹ ibhonva sẹ attara. Mafhọ ọnọng kpenamkpen kw'orukọ nya. Ọnọng mawanẹ kw'matte ọbọhk oruk akpen, kode. K'ose kw'masi z'Eglọn, minna kw'makibhẹ ọttọhk kpenamkpen, ọmaana ọnọng kpenamkpen kw'orukọ nya.<verse eid="JOS 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 10:38" />Nya o, Joshua ọmaana asoja pẹ maphyir, madanga, mad-arima obhon kw'Debir ábẹ̀. <verse eid="JOS 10:38" /><verse number="39" style="v" sid="JOS 10:39" />Mabọka ebhondim ndo, ọmaana ọvaarnọng kw'ọbaabh nya, ọttara ibhonva sẹ, pira mafhọ ọvaarnọng nwo. Mafhọ ọnọng kpenamkpen kw'orukọ ny'Debir. Ọnọng mawanẹ kw'matte ọbọhk oruk akpen, kode. K'ose kw'masi z'Libna, ọmaana z'Hẹbrọn, minna kw'masi obhon kw'Debir ọmaana ọvaarnọng kw'ọbaabh nya.<verse eid="JOS 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 10:40" />Minna kw'Joshua ozeng okema nkọma njo maphyir, ọttara ẹkọma ch'agbe, ọmaana ch'Nẹgẹv, ọmaana ẹkọma ch'igbemmo ch'ening z'ẹbhaakẹ ch'ewuchen ed-edimẹ, ọmaana ch'ẹkọma ch'ening z'iwọn-isaka, ọttara avaar p'nkọma nja maphyir. Ọnọng mawanẹ kw'otte ọbọhk oruk akpen, kode. Ọfhọ ọnọng kpenamkpen kw'orukọ akpen. Wa Joshua osi mach'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl ikk'ẹ obena. <verse eid="JOS 10:40" /><verse number="41" style="v" sid="JOS 10:41" />Joshua okema nkọma njo, tọma z'Kadẹsh-Barnea, pyirẹ z'Gaza. Bir tọma ny'ẹbhaakẹ ch'Goshẹn kibungọ maa, pyirẹ z'Gibeọn. <verse eid="JOS 10:41" /><verse number="42" style="v" sid="JOS 10:42" />Wa Joshua okem avaar mba maphyir, ọttara nkọma sabẹ k'egbong madanẹ, okurọ bẹ́, wa Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl wọ osi erima ch'Israẹl.<verse eid="JOS 10:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 10:43" />Nya o, Joshua otima asoja pẹ maphyir, ọkpa nnam z'ibhinga-byi, z'Gilgal.<verse eid="JOS 10:43" /></para>
  <chapter eid="JOS 10" />
  <chapter number="11" style="c" sid="JOS 11" />
  <para style="s1">Joshua okem avaar p'ẹkọma ch'ebir-ebir</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1" />K'ogbe kw'ọvaar Jabin kw'Hazọr ọbhaang odik nwa, minna kw'ọtọhm ẹkkaabha ochena ọvaar Jobab kw'Madon, ọmaana avaar p'ẹkọma ch'Shimrọn, ọttara ch'Akshaph. <verse eid="JOS 11:1" /><verse number="2" style="v" sid="JOS 11:2" />Obira ọtọhm ẹkkaabha ochena avaar p'ẹkọma ch'ebir-ebir ch'ening k'agbe, ọmaana ẹkọma ch'Araba ch'ening izek-izek kw'Kinẹrẹt, ọmaana ch'ẹkọma ch'igbemmo ch'ening k'ẹbhaakẹ ch'ewuchen ed-edimẹ, ọttara ch'ẹkọma ch'Naphot-Dọr ch'ening k'ẹbhaakẹ ch'ewuchen ed-eyin. <verse eid="JOS 11:2" /><verse number="3" style="v" sid="JOS 11:3" />Ọtọhm ẹkkaabha ndo ọnang ẹkọma ch'Kenaan ch'ening k'ẹbhaakẹ ch'ewuchen ed-eyin, ọmaana ch'ẹbhaakẹ ch'ewuchen ed-edimẹ. Ọtọhm ọnang ẹkọma ch'Amọr, ọmaana ch'Hẹt, ọmaana ch'anọng p'Pẹriz, ọmaana ch'Jebus ch'ening z'ẹbhaakẹ ch'agbe, ọttara ch'anọng p'Hiv ch'ening ẹwọn-ẹwọna kw'Hermọn, z'ẹbhaakẹ ch'Mizpa. <verse eid="JOS 11:3" /><verse number="4" style="v" sid="JOS 11:4" />Minna kw'nkọma njo itim asoja pabẹ maphyir, ikwu. Ibira itima nnyanya ọmaana ijaar s'nnyanya id-itọr k'ọsaabh, ikwu. Wa asoja p'matim akwu, masaabhẹ mach'ofong kw'ẹraangaka. <verse eid="JOS 11:4" /><verse number="5" style="v" sid="JOS 11:5" />Avaar p'nkọma nja maphyir, magbara mbọhk, masi ibhinga-byi z'Nkeka s'ining z'Mẹrọm, k'ose kw'mm'arima Israẹl ábẹ̀.<verse eid="JOS 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 11:6" />Ọvaar Ibinọkpaabyi oben Joshua bẹ́, “Tte bẹ maning-ọ ajor, kirẹ ophyinẹ ogbese nwa, kaam m'mfhọ bẹ maphyir, ntọka bẹ nke anọng p'Israẹl k'mbọhk makema bẹ. Bọnga mm'aphyakẹ nnyanya sabẹ ntọhnga, mabira akwọmọ ijaar sabẹ s'nnyanya id-itọr.”<verse eid="JOS 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 11:7" />Minna kw'Joshua ọmaana asoja pẹ maphyir mabin, mad-ayin bẹ <char style="it">bẹ́ fẹrẹm</char>, marima bẹ ábẹ̀, ny'nkeka njo s'Mẹrọm. <verse eid="JOS 11:7" /><verse number="8" style="v" sid="JOS 11:8" />Ọvaar Ibinọkpaabyi ọtọka bẹ oke anọng p'Israẹl k'mbọhk, makema bẹ. Anọng p'Israẹl akwubh bẹ maa, pyirẹ z'Sidọn kwiden. Machina ororo akwubh bẹ maa, mapyirẹ z'Misrephot-Maim, minna maa, pyirẹ z'ilokodo s'Mizpa z'ẹbhaakẹ ch'ewuchen ed-eyin. Wa ọnọng mawanẹ-wanẹ kw'matte ọbọhk oruk akpen, kode. <verse eid="JOS 11:8" /><verse number="9" style="v" sid="JOS 11:9" />Wa Joshua osi bẹ mach'Ọvaar Ibinọkpaabyi ikk'ẹ obena, ọphyakẹ nnyanya s'anọng mbo ntọhnga, obira ọkwọmọ ijaar sabẹ s'nnyanya id-itọr.<verse eid="JOS 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 11:10" />Ny'ogbe nwo, Joshua ọbọka ebhondim ch'Hazọr, obira otima ọkkangkkang ọfhọ ọvaarnọng kw'ọbaabh nya. (Wa Hazọr kk'oso kw'nkọma nja maphyir ọda pira.) <verse eid="JOS 11:10" /><verse number="11" style="v" sid="JOS 11:11" />Wa matima ọkkangkkang afhọ ọnọng kpenamkpen kw'orukọ ny'ebhondim ndo. M'ọnọng mawanẹ-wanẹ ọbọhk katte bẹ́, oruk akpen. Joshua ọkwọmọ ebhondim ch'Hazọr maphyir.<verse eid="JOS 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 11:12" />Joshua obira ọtọka ivaarbhon s'nkọma nja maphyir, ọmaana avaar pabẹ maphyir, otima ọkkangkkang ọfhọ bẹ. Ọfhọ bẹ maphyir k'ose kw'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ikk'ẹ obena. <verse eid="JOS 11:12" /><verse number="13" style="v" sid="JOS 11:13" />Okenaka, wa anọng p'Israẹl m'ebhondim kpenamkpen ch'anọng mbo masi k'isọhm-gbinigbinẹ, kakwọmọ, kw'ọkpanẹ obhon kw'Hazọr kw'uwa Joshua ọkwọmọ. <verse eid="JOS 11:13" /><verse number="14" style="v" sid="JOS 11:14" />Anọng p'Israẹl macha oyena kw'ivaarbhon nja maphyir, mabir atọka etirakpo pyabẹ atima afona. Mafhọ anọng maphyir p'arukọ nya maa, madimẹ bẹ eche. Ọnọng mawanẹ-wanẹ kw'matte ọbọhk oruk akpen, kode. <verse eid="JOS 11:14" /><verse number="15" style="v" sid="JOS 11:15" />K'ose kw'uwa Ọvaar Ibinọkpaabyi obenẹ Mosẹs kw'ode ọtọhmnọng kwẹ, minna kw'uwa Mosẹs obenẹ Joshua, Joshua osi minna. Ny'idik s'iwa Ọvaar Ibinọkpaabyi obenẹ Mosẹs maphyir, ọttọhk kode f'uwa ina osi.<verse eid="JOS 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 11:16" />Minna kw'Joshua ọtọk nkọma nja kibungọ, kw'ode ẹkọma ch'agbe, ọmaana ch'Nẹgẹv maphyir, ọmaana ẹbhaakẹ ch'Goshẹn kibungọ, ọmaana ẹkọma ch'agbemmo ch'ening k'ẹbhaakẹ ch'ewuchen ed-edimẹ, ọmaana ch'Araba, ọmaana agbe p'Israẹl ọmaana agbemmo pabẹ. <verse eid="JOS 11:16" /><verse number="17" style="v" sid="JOS 11:17" />Tọma z'egbe ch'Halak ch'etim maa, echina z'Seir, maa, pyirẹ z'ẹkọma ch'Baal-Gad ch'ening k'ilokodo s'Lẹbanọn, z'ẹwọn-ẹwọna kw'Egbe ch'Hermọn, Joshua ọtọk-ọtọka maphyir. Wa ọbọka avaar pabẹ maphyir, ọfhọ. <verse eid="JOS 11:17" /><verse number="18" style="v" sid="JOS 11:18" />Joshua orima egbong ọmaana avaar p'ẹkọma nda maphyir k'ogbe kw'okem ebhira. <verse eid="JOS 11:18" /><verse number="19" style="v" sid="JOS 11:19" />M'nkọma nja maphyir s'iwa Israẹl okem k'egbong, ẹkọma ch'esi ẹmẹm ẹmaana anọng p'Israẹl kede, kw'ọkpanẹ anọng p'Hiv p'arukọ z'ẹkọma ch'Gibeọn. <verse eid="JOS 11:19" /><verse number="20" style="v" sid="JOS 11:20" />Wa Ọvaar Ibinọkpaabyi wọ osi bẹ magaangẹ nttem bẹ́, marima anọng p'Israẹl ábẹ̀, ọfha ofona nya, oning bẹ ọjọhkọ, ọfhọ bẹ kibung-kibungọ, obira odimẹ bẹ eche m'iyagbin, k'ose kw'Ọvaar Ibinọkpaabyi ikk'Mosẹs obena.<verse eid="JOS 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 11:21" />Ny'ogbe nwo, Joshua ofona od-orima egbong ọmaana anọng p'Anak p'arukọ z'ẹkọma ch'egbe. Ọtọma ny'obhon kw'Hẹbrọn orima bẹ ábẹ̀ maa, opyirẹ obhon kw'Debir, ọmaana obhon kw'Anab, ọmaana nkọma s'Juda maphyir s'ining k'agbe, maa pyirẹ z'nkọma s'Israẹl maphyir s'ining k'agbe. Wa Joshua ọfhọ anọng mba maphyir, obira odimẹ ibhon sabẹ kibung-kibungọ. <verse eid="JOS 11:21" /><verse number="22" style="v" sid="JOS 11:22" />Wa ọ́mmáana kw'Anak mawanẹ-wanẹ kw'ọnaang ny'izek s'Israẹl, kode, kw'ọkpanẹ ayok p'Gaza, ọmaana p'Gat, ọttara p'Ashdọd.<verse eid="JOS 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 11:23" />Minna kw'Joshua osi k'ose kw'Ọvaar Ibinọkpaabyi obenẹ Mosẹs. Ọtọka ozek mvo maphyir okebh ọnang Israẹl mach'oyena kwabẹ, otor k'mfona sabẹ. Nya o, anọng p'ẹkọma ch'Israẹl akwoka ọwọhng k'egbong oririma.<verse eid="JOS 11:23" /></para>
  <chapter eid="JOS 11" />
  <chapter number="12" style="c" sid="JOS 12" />
  <para style="s1">Avaar p'uwa Mosẹs okem k'egbong</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1" />Ma wọ ode avaar p'nkọma s'iwa anọng p'Israẹl makem, pira matọka ozek fabẹ f'oning z'Jọrdan, z'ẹbhaakẹ ch'ewuchen ed-eyin, tọma z'ilokodo s'Arnọn, pyirẹ z'egbe ch'Hẹrmọn, ọttara ẹbhaakẹ ch'Araba maphyir ch'ening z'ẹbhaakẹ ch'ewuchen ed-eyin. Avaar mbo ade:<verse eid="JOS 12:1" /></para>
  <para style="b" />
  <para style="m">
    <verse number="2" style="v" sid="JOS 12:2" />ọvaar Sihọn kw'anọng p'Amọr, kw'oning z'Hẹshbọn ọbaabha. Wa ọbaabh tọma z'Aroer kw'oning k'akonga p'ilokodo s'Arnọn maa, pyirẹ ny'njeka kw'ilokodo njo, tima maa, pyirẹ z'Ọraanga kw'Jabọk kw'ode enem ch'anọng p'Amọn, obira ode igboka janẹ s'ẹkọma ch'Gilead. <verse eid="JOS 12:2" /><verse number="3" style="v" sid="JOS 12:3" />Wa Sihọn obira ọbaabha Arabah kw'oning z'ẹbhaakẹ ch'ewuchen ed-eyin, tọma z'Ọraanga kwiden kw'Galili maa, pyirẹ z'Ọraanga kw'Araba (kw'ode Ọraanga kw'Obo), tima maa, pyirẹ z'Bẹt-Jeshimọt maa, pyirẹ z'ẹwọn-ẹwọna kw'isakada s'Pisga.<verse eid="JOS 12:3" /></para>
  <para style="b" />
  <para style="m">
    <verse number="4" style="v" sid="JOS 12:4" />Ọvaar Sihọn obira ọbaabha ẹkọma ch'ọvaar Ọg kw'Bashan kw'ode ọvaarnọng wanẹ ny'avaar p'Rephayi p'uwa makpongnnam abaabha z'Ashtarọt ọmaana z'Edrei.<verse eid="JOS 12:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="JOS 12:5" />Ọbaabha ẹkọma ch'Egbe ch'Hẹrmọn, ọmaana ch'Salẹka, ọmaana ẹbhaakẹ ch'Bashan maphyir maa, pyirẹ z'enem ch'anọng p'Geshur ọmaana ch'Maaka, ọttara igboka janẹ s'Gilead maa, pyirẹ z'enem ch'ọvaar Sihọn kw'Hẹshbọn.<verse eid="JOS 12:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="JOS 12:6" />Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi, ọmaana anọng p'Israẹl, makema avaar mba afa k'egbong. Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ọtọka izek sabẹ ọnang anọng p'ẹkọma ch'Reubẹn, ọmaana p'Gad, ọttara igboka janẹ s'efona ch'Manasẹ bẹ́, mayena.<verse eid="JOS 12:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="JOS 12:7" />Ma wọ ode avaar p'nkọma s'Joshua ọmaana anọng p'Israẹl makem z'ẹbhaakẹ ch'ewuchen ed-edimẹ z'Jọrdan, tọma z'Baal-Gad kw'oning k'ilokodo s'Lẹbanọn maa, pyirẹ z'Egbe ch'Halak ch'ekkerẹ z'Seir. Wa Joshua ọtọka ozek f'nkọma sabẹ okebh ọnang anọng p'Israẹl k'ose kw'mfona s'Israẹl ide. <verse eid="JOS 12:7" /><verse number="8" style="v" sid="JOS 12:8" />Nkọma njo ide ẹkọma ch'egbe, ọmaana ẹkọma ch'igbemmo ch'ening z'ẹbhaakẹ ch'ewuchen ed-edimẹ, ọmaana ẹkọma ch'Araba, ọmaana ẹkọma ch'isakada, ọmaana ch'ibyi s'anọng nna arukọ, ọttara ch'Nẹgẹv. Wa nkọma nja ide nkọma s'anọng p'Hit, ọmaana p'Amọr, ọmaana p'Kenaan, ọmaana p'Periz, ọmaana p'Hiv, ọttara p'Jebus. Avaar mbo p'uwa anọng p'Israẹl makem made: <verse eid="JOS 12:8" /><verse number="9" style="v" sid="JOS 12:9" />ọvaarnọng kw'Jẹriko, ọmaana kw'Ai, p'marukọ anyọma Bẹtẹl; <verse eid="JOS 12:9" /><verse number="10" style="v" sid="JOS 12:10" />ọmaana ọvaarnọng kw'Jẹrusalẹm, ọmaana kw'Hẹbrọn, <verse eid="JOS 12:10" /><verse number="11" style="v" sid="JOS 12:11" />ọmaana ọvaarnọng kw'Jarmut, ọmaana kw'Lakish, <verse eid="JOS 12:11" /><verse number="12" style="v" sid="JOS 12:12" />ọmaana ọvaarnọng kw'Eglọn, ọmaana kw'Gezer, <verse eid="JOS 12:12" /><verse number="13" style="v" sid="JOS 12:13" />ọmaana ọvaarnọng kw'Debir, ọmaana kw'Gedẹr, <verse eid="JOS 12:13" /><verse number="14" style="v" sid="JOS 12:14" />ọmaana ọvaarnọng kw'Họrma, ọmaana kw'Arad, <verse eid="JOS 12:14" /><verse number="15" style="v" sid="JOS 12:15" />ọmaana ọvaarnọng kw'Libna, ọmaana kw'Adulam, <verse eid="JOS 12:15" /><verse number="16" style="v" sid="JOS 12:16" />ọmaana ọvaarnọng kw'Makkeda, ọmaana kw'Bẹtẹl, <verse eid="JOS 12:16" /><verse number="17" style="v" sid="JOS 12:17" />ọmaana ọvaarnọng kw'Tapua, ọmaana kw'Hephẹr, <verse eid="JOS 12:17" /><verse number="18" style="v" sid="JOS 12:18" />ọmaana ọvaarnọng kw'Aphek, ọmaana kw'Lasharọn, <verse eid="JOS 12:18" /><verse number="19" style="v" sid="JOS 12:19" />ọmaana ọvaarnọng kw'Madọn, ọmaana kw'Hazọr, <verse eid="JOS 12:19" /><verse number="20" style="v" sid="JOS 12:20" />ọmaana ọvaarnọng kw'Shimrọn-Mẹrọn, ọmaana kw'Akshaph, <verse eid="JOS 12:20" /><verse number="21" style="v" sid="JOS 12:21" />ọmaana ọvaarnọng kw'Taanak, ọmaana kw'Megido, <verse eid="JOS 12:21" /><verse number="22" style="v" sid="JOS 12:22" />ọmaana ọvaarnọng kw'Kẹdẹsh, ọmaana kw'Jokneam kw'oning z'Karmẹl, <verse eid="JOS 12:22" /><verse number="23" style="v" sid="JOS 12:23" />ọmaana ọvaarnọng kw'Dor, kw'oning z'Naphot-Dor, ọmaana kw'Goyim, kw'oning z'Gilgal, <verse eid="JOS 12:23" /><verse number="24" style="v" sid="JOS 12:24" />ọttara ọvaarnọng kw'Tirza. Kibungọ-kibungọ, wa avaar mbo ade anọng ẹrọbh okwuma ijobh kawanẹ.<verse eid="JOS 12:24" /></para>
  <chapter eid="JOS 12" />
  <chapter number="13" style="c" sid="JOS 13" />
  <para style="s1">Izek s'irikẹ bẹ́, matọka</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1" />K'ogbe kw'uwa Joshua kk'ọtama mawuriji, Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, “Kọ kk'atama mawuriji, okenaka, izek s'isaabh-ọsaabh itim irikẹ za s'mm'atọka ayena.<verse eid="JOS 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 13:2" />“Izek njo s'irikẹ ide ẹbhaakẹ ch'Philistiya maphyir, ọmaana ch'Geshur, <verse eid="JOS 13:2" /><verse number="3" style="v" sid="JOS 13:3" />tọma z'Ọraanga kw'Shihọr kw'oning z'ẹbhaakẹ ch'ewuchen ed-eyin z'Ijip maa, pyirẹ z'ebir-ebir kw'enem ch'Ekrọn. Ibyi njo maphyir ide s'anọng p'Kenaan, chibhẹ ch'ode bẹ́, avaar mbo achen afon Philistiya p'abaabh Gaza, ọmaana Ashdọd, ọmaana Ashkẹlọn, ọmaana Gat, ọttara Ekrọn. Wa ẹkọma ndo ede ch'anọng p'Avit <verse eid="JOS 13:3" /><verse number="4" style="v" sid="JOS 13:4" />p'aning z'ẹwọn-ẹwọna. Izek njo maphyir ide s'anọng p'Kenaan, tọma z'obhon kw'Arab kw'anọng p'Sidọn maa, pyirẹ z'Aphek kw'ode enem ch'Amọr; <verse eid="JOS 13:4" /><verse number="5" style="v" sid="JOS 13:5" />ọmaana izek s'anọng p'Gebal, ọttara izek s'Lebanọn s'ichin z'ẹbhaakẹ ch'ewuchen ed-eyin. Bir tọma z'Baal-Gad kw'oning izek-izek kw'Egbe ch'Hẹrmọn maa, pyirẹ z'Lebo-Hamat.<verse eid="JOS 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 13:6" />“Anọng maphyir p'marukọ z'nkọma s'egbe, tọma z'Lebanọn maa, pyirẹ z'Misrẹphọd-maim, kw'ode anọng p'Sidọn maphyir, kaam Ọvaar Ibinọkpaabyi oyenẹ, m'nkwubh bẹ k'ititika s'Israẹl. Nkàzaama bẹ́, mm'akebh izek nja manang anọng p'Israẹl mayena, k'ose kw'kaam ikk'bọnga ntọhna. <verse eid="JOS 13:6" /><verse number="7" style="v" sid="JOS 13:7" />Ofona nya, kebh izek nja nang mfonamma osowanẹ s'Israẹl, ọmaana igboka janẹ s'efona ch'Manasẹ.”<verse eid="JOS 13:7" /></para>
  <para style="s1">Ekebha ch'izek s'ẹbhaakẹ ch'ewuchen ed-eyin z'Jọrdan</para>
  <para style="m">
    <verse number="8" style="v" sid="JOS 13:8" />Wa igboka njoza s'efona ch'Manasẹ, ọmaana efona ch'Reuben, ọttara ch'Gad, nkk'okebh f'izek sabẹ atọka z'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi. Izek njo ining z'okwubha kw'Jọrdan, za ch'ewuchen ed-eyin, mbengana k'ose kw'Moses kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi, okebhẹ ọnang bẹ.<verse eid="JOS 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 13:9" />Izek sabẹ itọhm z'Aroer kw'oning k'enem ch'Ilokodo s'Arnọn, ọmaana ebhondim ch'ening k'njeka kw'ilokodo njo, ọttara izek maphyir s'Medeba, s'ide ẹkpẹmẹ maa, pyirẹ z'Dibọn, <verse eid="JOS 13:9" /><verse number="10" style="v" sid="JOS 13:10" />ọmaana ibhondim maphyir s'ọvaar Sihọn kw'Amọr kw'ọbaabh z'Hẹshbọn maa, pyirẹ z'enem ch'anọng p'Amọr. <verse eid="JOS 13:10" /><verse number="11" style="v" sid="JOS 13:11" />Izek s'iwa ittar nya ide Gilead, ọmaana ẹbhaakẹ ch'Gẹshur, ọmaana ch'Maaka, ọmaana ch'Egbe ch'Hẹrmọn maphyir, ọttara ẹbhaakẹ ch'Bashan maphyir maa, pyirẹ z'Salẹka, <verse eid="JOS 13:11" /><verse number="12" style="v" sid="JOS 13:12" />kw'ode ọvaarbhon kw'Ọg kibungọ kw'oning z'Basha. Kẹ wọ uwa ọbaabh Ashtarọt ọmaana Edrẹi. (Kẹ wọ uwa orikẹ k'anọng p'Rephaim.) Wa Mosẹs kk'anọng mba okema, okwubh bẹ ny'izek njo. <verse eid="JOS 13:12" /><verse number="13" style="v" sid="JOS 13:13" />Wa anọng p'Israẹl m'anọng p'Gẹshur, ọmaana p'Maaka kakwubhọ ny'abẹ k'njeka. Anọng mbo atim arukọ amaana Israẹl za maa, pyirẹ menda.<verse eid="JOS 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 13:14" />Ṉ́nòde efona ch'Lẹvi, wa Mosẹs bẹ izek s'mm'ayena kọnangẹ, ch'ode bẹ́, nnanga s'ẹja ofufọhnọ s'mad-anang z'ọsọhm kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl, jẹ jọ ide okebh fabẹ.<verse eid="JOS 13:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="JOS 13:15" />Ma wọ ode izek s'iwa Mosẹs ọnangẹ efona ch'Reubẹn otor k'nnọmma sabẹ:<verse eid="JOS 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 13:16" />Wa izek s'ofonamma kw'Reubẹn itọm z'Aroer kw'oning z'akonga p'Ilokodo s'Arnọn, ọmaana z'ebhondim ch'ening k'njeka kw'ilokodo njo, ọmaana z'ẹkpẹmẹ kibungọ ch'Medeba. <verse eid="JOS 13:16" /><verse number="17" style="v" sid="JOS 13:17" />Obir ọttara izek s'Hẹshbọn, ọmaana s'ibhondim s'ining ny'ẹkpẹmẹ ndo; ọmaana s'Dibọn, ọmaana s'Bamot-baal, ọmaana s'Bẹt-baal-meọn, <verse eid="JOS 13:17" /><verse number="18" style="v" sid="JOS 13:18" />ọmaana s'Jahaz, ọmaana s'Kẹdẹmọt, ọmaana s'Mephaat, <verse eid="JOS 13:18" /><verse number="19" style="v" sid="JOS 13:19" />ọmaana s'Kiriataim, ọmaana s'Sibma, ọmaana s'Zẹrẹt-shahar kw'oning k'egbe ch'ilokodo, <verse eid="JOS 13:19" /><verse number="20" style="v" sid="JOS 13:20" />ọmaana s'Bẹt-peor, ọmaana ọsakada f'Pisga, ọmaana s'Bẹt-Jẹshimọt, <verse eid="JOS 13:20" /><verse number="21" style="v" sid="JOS 13:21" />kw'ode ibhondim maphyir s'ining k'ẹkpẹmẹ, ọmaana ọvaarbhon kw'Sihọn kw'ode ọvaarnọng kw'anọng p'Amọr. Kẹ wọ uwa oning z'Hẹshbọn ọbaabha. Wa Mosẹs okem kẹ ọmaana avaar p'Midiyan, ọmaana p'Evi, ọmaana p'Rẹkẹm, ọmaana p'Zur, ọmaana p'Hur, ọmaana p'Reba, ọttara ajinọngva p'avaar mboza p'abe k'Sihọn, p'abir aruk ny'ẹkọma ndo. <verse eid="JOS 13:21" /><verse number="22" style="v" sid="JOS 13:22" />Balaam kw'ode nnwa kw'Boer, ọttar ny'anọng mbo p'uwa anọng p'Israẹl mafhọ k'egbong. Wa kẹ od-osi ẹbọhk. <verse eid="JOS 13:22" /><verse number="23" style="v" sid="JOS 13:23" />Wa ọraanga kw'Jọrdan wọ ode enem ch'anọng p'Reubẹn. Ibhon ọmaana ibhondim nja jọ uwa ide izek s'anọng p'Reubẹn otor k'nnọmma sabẹ.<verse eid="JOS 13:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="JOS 13:24" />Ma wọ ode izek s'iwa Mosẹs obira ọnang ofonamma kw'Gad bẹ́, mayena, otor k'nnọmma sabẹ.<verse eid="JOS 13:24" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="25" style="v" sid="JOS 13:25" />Wa ode ẹkọma ch'Jazẹr, ọmaana ibhondim s'Gilead maphyir, ọmaana ẹbhaakẹ danẹ ch'anọng p'Amọn, maa, pyirẹ z'Aroer kw'oning ọnyọma Raba. <verse eid="JOS 13:25" /><verse number="26" style="v" sid="JOS 13:26" />Bir tọma z'Hẹshbọn maa, pyirẹ z'Rama-Mizpa, ọttara Bẹtonim, abira atọma z'Mahanaim maa, pyirẹ z'ẹkọma ch'Debir, <verse eid="JOS 13:26" /><verse number="27" style="v" sid="JOS 13:27" />ọmaana z'ilokodo, ọmaana z'Bẹt-Haram, ọmaana z'Bẹt-Nimra, ọmaana z'Sukọt, ọmaana z'Zaphon, ọttara ẹbhaakẹ maphyir ch'iwa ọvaar Sihọn kw'Hẹshbọn ọbaabh, (s'itọm z'ẹbhaakẹ ch'ewuchen ed-eyin z'Ọraanga kw'Jọrdan maa, zọhng tto z'Ọraanga kwiden kw'Galili). <verse eid="JOS 13:27" /><verse number="28" style="v" sid="JOS 13:28" />Ibhon njoma ọmaana ibhondim sabẹ jọ s'iwa Mosẹs ọnangẹ anọng p'Gad bẹ́, mayena, tor k'nnọmma sabẹ.<verse eid="JOS 13:28" /></para>
  <para style="b" />
  <para style="m">
    <verse number="29" style="v" sid="JOS 13:29" />Ma wọ ode okebh f'Mosẹs ọnangẹ igboka janẹ s'efona ch'Manasẹ, kw'ode igboka janẹ s'anọng p'Manasẹ, tor kw'nnọmma sabẹ.<verse eid="JOS 13:29" /></para>
  <para style="b" />
  <para style="m">
    <verse number="30" style="v" sid="JOS 13:30" />Wa ẹkọma ch'ọnangẹ bẹ ẹtọm z'Mahanaim epyirẹ z'Bashan maphyir, ebir epyirẹ z'nkọma s'ọvaar Ọg kw'Bashan ọbaabh, ọmaana ibhon s'Jair kw'oning z'Bashan, ọttara ibhondim arọbh attaan, <verse eid="JOS 13:30" /><verse number="31" style="v" sid="JOS 13:31" />ọmaana igboka janẹ s'Gilead, ọmaana Ashtarọt, ọmaana Edrei (kw'ode ivaarbhon s'Ọg z'Bashan). Ibhon s'ẹkọma nda jọ s'iwa Mosẹs okebhẹ ọnang igboka kpenamkpen s'ẹnọmma ch'Makir kw'Manasẹ obhonọ, tor k'nnọmma sabẹ.<verse eid="JOS 13:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="JOS 13:32" />Ozek mva vọ f'uwa Mosẹs ọnangẹ bẹ k'ogbe kw'uwa oning z'ẹkpẹmẹ ch'Moab, z'okwubha kw'Ọraanga kw'Jọrdan, z'ẹbhaakẹ ch'ewuchen ed-eyin z'Jẹriko. <verse eid="JOS 13:32" /><verse number="33" style="v" sid="JOS 13:33" />Wa Mosẹs efona ch'Lẹvi okebh kpenamkpen f'izek kọnangẹ. Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl wọ ode okebh f'bẹ mayen, otor k'ose kw'uwa ochekẹ ọnang bẹ.<verse eid="JOS 13:33" /></para>
  <chapter eid="JOS 13" />
  <chapter number="14" style="c" sid="JOS 14" />
  <para style="s1">Ekebha ch'izek s'ining z'Jọrdan za ch'ewuchen ed-edimẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1" />Ma wọ ode nkọma s'anọng p'Israẹl atọk mach'okebh fabẹ z'izek s'Kenaan s'iwa Eleaza kw'ode ọfọhn-ẹja, ọmaana Joshua kw'ode nnwa kw'Nun ọttara aso p'mfonamma s'Israẹl, makebhẹ anang bẹ. <verse eid="JOS 14:1" /><verse number="2" style="v" sid="JOS 14:2" />Wa mabharẹ ọsẹ atima akebh nkọma njo osowanẹ ọmaana ibhaaka, otor k'ose kw'Ọvaar Ibinọkpaabyi ikk'Mosẹs ọtọhna. <verse eid="JOS 14:2" /><verse number="3" style="v" sid="JOS 14:3" />Wa Mosẹs kk'nkọma mfa ọmaana ibhaaka okebh fabẹ ọnanga z'ẹbhaakẹ ch'ewuchen ed-eyin z'Jọrdan. Okenaka, ny'anọng p'Israẹl maphyir, anọng p'Lẹvi bẹ-bẹ p'uwa Mosẹs ina okebh ọnangẹ. <verse eid="JOS 14:3" /><verse number="4" style="v" sid="JOS 14:4" />Wa iva p'iva p'Josẹph nnakwu ade mfona mfa, kw'ode Manasẹ ọmaana Ephraim. Wa anọng p'Lẹvi m'okebh f'izek njo kayen, kw'ọkpanẹ ibhon s'mm'aruk, ọttara ozek f'arọkimaan, ọmaana abhaam pabẹ m'ayena ọchattọhk. <verse eid="JOS 14:4" /><verse number="5" style="v" sid="JOS 14:5" />Minna kw'anọng p'Israẹl akebhẹ izek njo k'ose kw'Ọvaar Ibinọkpaabyi ikk'Mosẹs ọtọhna.<verse eid="JOS 14:5" /></para>
  <para style="s1">Okebh f'Kalẹb</para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 14:6" />Wa anọng p'Juda akebha Joshua z'Gilgal. Kalẹb kw'ode nnwa kw'Jẹphunẹ, kw'ofon Kẹniz, obenẹ bẹ́, “Z'Kadẹsh-Barnea, Ọvaar Ibinọkpaabyi ogbaak Mosẹs kw'ode ọgbaak-ettem ch'Ibinọkpaabyi odik kw'ọmaan kọ ọttara kaam. Kọ azong odik nwo ma. <verse eid="JOS 14:6" /><verse number="7" style="v" sid="JOS 14:7" />Wa nde icho arọbh afa, k'ogbe kw'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ọtọhm-m z'Kadẹsh-Barnẹa bẹ́, nd-mbaana izek njo. Wa kk'Mosẹs odik kw'ọmaan izek njo nteka k'ose kw'nze. <verse eid="JOS 14:7" /><verse number="8" style="v" sid="JOS 14:8" />Okenaka, ivotte paam p'mọtọnọ ọd-ọbaana izek njo, machena anọng ẹkkaabha ch'esi nttem sabẹ irọbh. Chibhẹ ch'ode minna, ntima ettem chaam maphyir, ntor Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwaam. <verse eid="JOS 14:8" /><verse number="9" style="v" sid="JOS 14:9" />Minna kw'Mosẹs ochekẹ ny'ewu ndo bẹ́, “Izek njo s'ẹtọkọ chọ ikk'ẹbara nya, m'ide okebh fọ, ọmaana f'iva pọ ttattampe, okurọ ch'ikk'ettem chọ maphyir atima ator Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwaam.”<verse eid="JOS 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 14:10" />“Ofona nya, k'ose kw'Ọvaar Ibinọkpaabyi ochekẹ, kẹ kk'aam akpen osoka maa, n'nde icho arọbh afa okwuma ichen, tọma z'ogbe kw'uwa ọgbaak odik nwa ọnang Mosẹs, k'ogbe kw'uwa anọng p'Israẹl mad-akpaanga z'ibyi s'anọng nna arukọ. Menda nwa, kaam n'nde icho arọbh anna okwuma ichen k'atam. <verse eid="JOS 14:10" /><verse number="11" style="v" sid="JOS 14:11" />Kaam ntim nyen ẹfa ka menda, mach'iwa nyen ny'ewu ndo ch'Mosẹs ọtọhm-m ozenga nwo. Kaam ntim mgbir-ogbirẹ bẹ́, nyin egbong mach'iwa nde z'ogbe nwo. <verse eid="JOS 14:11" /><verse number="12" style="v" sid="JOS 14:12" />Ofona nya, nang-m ẹkọma nda ch'agbe ch'iwa Ọvaar Ibinọkpaabyi ochekẹ ny'ewu ndo bẹ́, m'ọnang-m. Wa kọ oyenẹ kk'abhaanga bẹ́, anọng p'Anak p'ibhondim sabẹ ibar-ọbar, ibir iyena abaaka piden, bẹ bọ uwa arukọ ny'izek njo. Okenaka, k'ẹfa ch'Ọvaar Ibinọkpaabyi, kaam m'nkwubh bẹ ny'izek njo k'ose kw'Ọvaar Ibinọkpaabyi obenẹ.”<verse eid="JOS 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 14:13" />Minna kw'uwa Joshua osi Kalẹb kw'ode nnwa kw'Jẹphunẹ ittabọhng, obira ọnang-ẹ ẹkọma ch'Hẹbrọn mach'okebh fẹ. <verse eid="JOS 14:13" /><verse number="14" style="v" sid="JOS 14:14" />Tọma k'ogbe kw'okem ebhira, Hẹbrọn node ẹkọma ch'Kalẹb kw'ode nnwa kw'Jẹphunẹ, kw'ofon Kẹniz, okurọ ch'kẹ otim ettem chẹ maphyir, otor Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl. <verse eid="JOS 14:14" /><verse number="15" style="v" sid="JOS 14:15" />(Wa mad-abira ayera Hẹbrọn bẹ́, Kiriyat-Arba, kw'ode eche ch'ọnọng kw'uwa ọbarẹ ọtam z'ikpakaana s'anọng p'Anak.)</para>
  <para style="p" vid="JOS 14:15">Minna kw'ẹkọma ndo ezeng ekwoka ọwọhng k'egbong oririma.<verse eid="JOS 14:15" /></para>
  <chapter eid="JOS 14" />
  <chapter number="15" style="c" sid="JOS 15" />
  <para style="s1">Okebh f'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1" />Wa okebh f'efona ch'Juda, atorọ k'nnọmma sabẹ, otim maa, opyire z'ẹkọma ch'Edom, z'ibyi s'anọng nna arukọ, z'ẹwọn-ẹwọna kw'Zin.<verse eid="JOS 15:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="JOS 15:2" />Enem chabẹ ẹtọm z'ẹwọn-ẹwọna kw'ẹkpọka ch'Ọraanga kwiden kw'Onung,<note caller="+" style="f"><char style="fr" closed="false">15.2 </char><char style="fq" closed="false">Ọraanga kwiden kw'Onung </char><char style="ft" closed="false">Obir okpena Ọraanga kw'obo.</char></note> <verse eid="JOS 15:2" /><verse number="3" style="v" sid="JOS 15:3" />ekwu ejeka z'ẹwọn-ẹwọna kw'Akrabim, ẹkpan nya, epyirẹ z'Zin. Ebir ẹkpan echina ẹwọn-ẹwọna kw'Kadẹsh-Barnea. Minna kw'ebir ezenga ẹkpan Hẹzrọn z'ẹrọng-ẹrọng kw'Adar, pira nẹnyọhngọ, echina z'Karka. <verse eid="JOS 15:3" /><verse number="4" style="v" sid="JOS 15:4" />Ekwu ezenga echina Azmọn, etor ekeka ch'enem ch'Ijip, ẹd-ẹkpọka z'Ọraanga kwiden kw'Meditereniya. Ma wọ ode enem chabẹ ch'ẹwọn-ẹwọna.<verse eid="JOS 15:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="JOS 15:5" />Enem ch'ẹbhaakẹ ch'ewuchen ed-eyin ede Ọraanga kwiden kw'Onung, ch'etim maa, epyirẹ z'ẹraangamma ch'Jọrdan. Enem ch'ebir-ebir ẹtọma z'ẹraangama ch'Jọrdan, epyirẹ z'ẹkpọka ch'ọraanga kwiden.<verse eid="JOS 15:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="JOS 15:6" />Etima maa, epyirẹ z'Bẹt-Họgla, echina ebir-ebir kw'Bẹt-Araba maa, etto z'Ọta kw'Bohan, kw'ode nnwa kw'Reubẹn. <verse eid="JOS 15:6" /><verse number="7" style="v" sid="JOS 15:7" />Enem ndo etima maa, epyirẹ Debir, z'ilokodo s'Achọr, ẹbhakẹ echina ebir-ebir kw'Gilgal, kw'okkerẹ ititika z'Eden ch'Adumim, z'ẹwọn-ẹwọna kw'ilokodo. Etima maa, epyirẹ z'nkeka s'Ẹn Shẹmẹsh, ekwu eyin z'Ẹn Rogẹl. <verse eid="JOS 15:7" /><verse number="8" style="v" sid="JOS 15:8" />Enem ndo echina ebir-ebir z'ilokodo s'Bẹn-Hinọm, z'ẹwọn-ẹwọna kw'isakada s'ebhondim ch'Jebus (kw'ode Jẹrusalẹm). Tọma ny'enem ndo, evura z'ogbeso kw'ẹbhaakẹ ch'ewuchen ed-edimẹ, z'Ilokodo s'Hinọm, z'ẹkpọka ch'ebir-ebir kw'Ilokodo s'Rephayim. <verse eid="JOS 15:8" /><verse number="9" style="v" sid="JOS 15:9" />Enem ndo ẹtọma ny'ogbeso, ekkerẹ ititika z'nkeka s'Nẹphtoa, eyin k'ibhon s'Egbe ch'Ẹphrọn, ebir echina izek-izek kw'Bala (kw'ode Kiriyat-Jearim). <verse eid="JOS 15:9" /><verse number="10" style="v" sid="JOS 15:10" />Nya kw'enem ndo ẹnyọhngọ, echina za ch'ewuchen ed-edimẹ, ezeng z'Bala, maa pyirẹ z'Egbe ch'Seir. Etima minna maa, epyirẹ ebir-ebir kw'isakada s'Egbe ch'Jearim (kw'ode Kẹsalọn), etima minna maa, ẹwọna z'Bẹt-Shẹmẹsh, ejeka z'Timna. <verse eid="JOS 15:10" /><verse number="11" style="v" sid="JOS 15:11" />Enem ndo echina ebir-ebir kw'isakada s'Ekrọn, ẹbhakẹ ekkerẹ ititika z'Shikẹrọn, ẹkpan echina z'Egbe ch'Bala, ed-epyirẹ z'Jabnẹl, ekwu ẹkpọka z'ọraanga kwiden.<verse eid="JOS 15:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="JOS 15:12" />Enem ch'ẹbhaakẹ ch'ewuchen ed-eyin, ede araangakonga p'Ọraanga kw'Mẹditereniya.</para>
  <para style="b" vid="JOS 15:12" />
  <para style="p" vid="JOS 15:12">Ma wọ ode nnem s'ikọbh efona ch'Juda, atorọ k'nnọmma sabẹ.<verse eid="JOS 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 15:13" />Wa Joshua ọnangẹ Kalẹb, kw'ode nnwa kw'Jẹphunẹ, ẹkọma ch'Kirayat-Arba, kw'ode Hẹbrọn, mach'okebh fẹ z'Juda, k'ose kw'Ọvaar Ibinọkpaabyi ikk'ẹ ọtọhna. (Arba wọ iwa ode otte kwiden kw'anọng p'Anak.) <verse eid="JOS 15:13" /><verse number="14" style="v" sid="JOS 15:14" />Tọma ny'Hẹbrọn, Kalẹb okwubh nnọmma nttaan s'anọng p'Anak, s'ide Shẹshayi, ọmaana Ahiman, ọttara Talmayi. <verse eid="JOS 15:14" /><verse number="15" style="v" sid="JOS 15:15" />Obina nya od-orima anọng p'Debir ábẹ̀ (Debir kw'uwa mayerẹ Kiriyat Sẹphẹr). <verse eid="JOS 15:15" /><verse number="16" style="v" sid="JOS 15:16" />Minna kw'Kalẹb obenẹ bẹ́, “Ojinọng kw'm'orima, obira okema Kiriyat-Sẹphẹr k'egbong, kaam m'ntọka Aksa, kw'ode ominanwa kwaam, nnang-ẹ k'ọbada.” <verse eid="JOS 15:16" /><verse number="17" style="v" sid="JOS 15:17" />Wa Otniyẹl kw'ode nnwa kw'Kenaz, kw'ode ọgbaanotte kw'Kalẹb, okema obhon nwo k'egbong. Minna kw'Kalẹb ọtọk Aksa, kw'ode ominanwa kwẹ, ọnang Otniyẹl k'ọbada.<verse eid="JOS 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 15:18" />K'ewu danẹ, ch'Aksa od-okebha Otniyẹl, ọchọhm-ẹ bẹ́, ophyem otte izek. K'ogbe kw'Aksa ọsak z'ẹnyanya chẹ, Kalẹb ọbọbh-ẹ bẹ́, “Bọng-ọttọhk f'arorọ bẹ́, nsi nnangọ o?”<verse eid="JOS 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 15:19" />Aksa ọpọhn-ẹ bẹ́, “Si ọphyaam nang-m. Ch'kk'aam izek ananga z'Nẹgẹv, bir nang-m nkeka ọdọk.” Nya o, Kalẹb ọnang-ẹ nkeka s'ebir-ebir, ọmaana s'ẹwọn-ẹwọna.<verse eid="JOS 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 15:20" />Ma wọ ode okebh f'ẹkọma ch'Juda, atorọ k'nnọmma sẹ.<verse eid="JOS 15:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="JOS 15:21" />Wa ibhon s'ikpa-nso z'ẹwọn-ẹwọna kw'Juda z'Nẹgẹv kw'ọnyọm enem ch'Edom ide: Kabzẹl, ọmaana Ẹdẹr, ọmaana Jagur,<verse eid="JOS 15:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="JOS 15:22" />ọmaana Kina, ọmaana Dimona, ọmaana Adada, <verse eid="JOS 15:22" /><verse number="23" style="v" sid="JOS 15:23" />ọmaana Kẹdẹsh, ọmaana Hazọr, ọmaana Itnan, <verse eid="JOS 15:23" /><verse number="24" style="v" sid="JOS 15:24" />ọmaana Ziph, ọmaana Tẹlẹm, ọmaana Bealọt, <verse eid="JOS 15:24" /><verse number="25" style="v" sid="JOS 15:25" />ọmaana Hazọr-Hadata, ọmaana Kẹriot-Hẹzrọn (kw'ode Hazọr), <verse eid="JOS 15:25" /><verse number="26" style="v" sid="JOS 15:26" />ọmaana Amam, ọmaana Shẹma, ọmaana Molada, <verse eid="JOS 15:26" /><verse number="27" style="v" sid="JOS 15:27" />ọmaana Hazar-Gada, ọmaana Heshmọn, ọmaana Bẹt-Pẹlẹt, <verse eid="JOS 15:27" /><verse number="28" style="v" sid="JOS 15:28" />ọmaana Hazar Shual, ọmaana Beershẹba, ọmaana Biziotiya, <verse eid="JOS 15:28" /><verse number="29" style="v" sid="JOS 15:29" />ọmaana Bala, ọmaana Iyim, ọmaana Ezem, <verse eid="JOS 15:29" /><verse number="30" style="v" sid="JOS 15:30" />ọmaana Eltolad, ọmaana Kesil, ọmaana Họrma, <verse eid="JOS 15:30" /><verse number="31" style="v" sid="JOS 15:31" />ọmaana Ziklag, ọmaana Madmana, ọmaana Sansana, <verse eid="JOS 15:31" /><verse number="32" style="v" sid="JOS 15:32" />ọmaana Lebayọt, ọmaana Shilhim, ọmaana Ayin ọttara Rimọn. Kibung-kibungọ, wa ode ibhon ẹrọbh okwuma osowanẹ ọmaana ibhonva sabẹ.<verse eid="JOS 15:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="JOS 15:33" />Z'igbemmo, z'ẹbhaakẹ ch'ewuchen ed-edimẹ, ode Eshtaol, ọmaana Zọra, ọmaana Ashna,<verse eid="JOS 15:33" /></para>
  <para style="pi">
    <verse number="34" style="v" sid="JOS 15:34" />ọmaana Zanoa, ọmaana En-Ganim, ọmaana Tapua, ọmaana Enam, <verse eid="JOS 15:34" /><verse number="35" style="v" sid="JOS 15:35" />ọmaana Jarmut, ọmaana Adulam, ọmaana Soko, ọmaana Azeka, <verse eid="JOS 15:35" /><verse number="36" style="v" sid="JOS 15:36" />ọmaana Sharayim, ọmaana aditayim, ọttara Gẹdẹra (kw'mabir ayerẹ Gẹdẹrotayim). Kibung-kibungọ, wa ode ibhon siden osowanẹ kw'ichi ọttara ibhonva sabẹ.<verse eid="JOS 15:36" /></para>
  <para style="pi">
    <verse number="37" style="v" sid="JOS 15:37" />Ibhon s'ibir ittara nya ide Zenan, ọmaana Hadasha, ọmaana Migdal-Gad, <verse eid="JOS 15:37" /><verse number="38" style="v" sid="JOS 15:38" />ọmaana Dilean, ọmaana Mizpa, ọmaana Joktẹl, <verse eid="JOS 15:38" /><verse number="39" style="v" sid="JOS 15:39" />ọmaana Lakish, ọmaana Boskat, ọmaana Ẹglọn, <verse eid="JOS 15:39" /><verse number="40" style="v" sid="JOS 15:40" />ọmaana Kabon, ọmaana Lahmas, ọmaana Kitlish, <verse eid="JOS 15:40" /><verse number="41" style="v" sid="JOS 15:41" />ọmaana Gẹdẹrọt, ọmaana Bẹt-Dagọn, ọmaana Nama, ọttara Makẹda. Kibung-kibungọ, wa ode ibhon siden ichi kkawanẹ, ọmaana ibhonva sabẹ.<verse eid="JOS 15:41" /></para>
  <para style="pi">
    <verse number="42" style="v" sid="JOS 15:42" />Ibhon s'ibir ininga nya ide Libna, ọmaana Ẹtẹr, ọmaana Ashan, <verse eid="JOS 15:42" /><verse number="43" style="v" sid="JOS 15:43" />ọmaana Iphta, ọmaana Ashna, ọmaana Nẹzib, <verse eid="JOS 15:43" /><verse number="44" style="v" sid="JOS 15:44" />ọmaana Keila, ọmaana Akzib, ọttara Marẹsha. Kibung-kibungọ, wa ode ibhon siden osowanẹ ọmaana ibhonva sabẹ.<verse eid="JOS 15:44" /></para>
  <para style="pi">
    <verse number="45" style="v" sid="JOS 15:45" />S'ibir ittara nya ide Ekrọn, ọmaana ibhon s'ikọbh-ẹ, ọttara ibhonva sabẹ. <verse eid="JOS 15:45" /><verse number="46" style="v" sid="JOS 15:46" />Z'okwubha kw'ewuchen ed-edimẹ, ode Ekrọn, ọmaana ibhon maphyir z'okwubha kw'Ashọd ọmaana ibhonva sabẹ; <verse eid="JOS 15:46" /><verse number="47" style="v" sid="JOS 15:47" />Ashọd ọmaana ibhon s'ikọbh-ẹ, ọmaana ibhonva sabẹ, ọmaana Gaza, ọttara ibhonva sẹ maa, pyirẹ z'Ekeka ch'Ijip, ọmaana araangakonga p'ọraanga kwiden kw'Mẹditereniya.<verse eid="JOS 15:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="JOS 15:48" />Z'ẹbhaakẹ ch'agbeso, ode Shamir, ọmaana Jatir, ọmaana Sọkọ,<verse eid="JOS 15:48" /></para>
  <para style="pi">
    <verse number="49" style="v" sid="JOS 15:49" />ọmaana Dana, ọmaana Kiriyat-Sana (kw'ode Debir), <verse eid="JOS 15:49" /><verse number="50" style="v" sid="JOS 15:50" />ọmaana Anab, ọmaana Eshtemọ, ọmaana Anim, <verse eid="JOS 15:50" /><verse number="51" style="v" sid="JOS 15:51" />ọmaana Goshen, ọmaana Holọn, ọttara Gilọ. Kibung-kibungọ, wa ode ibhon siden ijobh kawanẹ, ọmaana ibhonva sabẹ.<verse eid="JOS 15:51" /></para>
  <para style="pi">
    <verse number="52" style="v" sid="JOS 15:52" />Wa obir ode ibhon s'Arab, ọmaana Duma, ọmaana Eshan, <verse eid="JOS 15:52" /><verse number="53" style="v" sid="JOS 15:53" />ọmaana Janim, ọmaana Bẹt-Tapua, ọmaana Apheka, <verse eid="JOS 15:53" /><verse number="54" style="v" sid="JOS 15:54" />ọmaana Humta, ọmaana Kiriyat-Arba (kw'ode Hẹbrọn), ọttara Zior. Kibung-kibungọ, wa ode ibhon siden osowanẹ, ọmaana ibhonva sabẹ.<verse eid="JOS 15:54" /></para>
  <para style="pi">
    <verse number="55" style="v" sid="JOS 15:55" />Wa obir ode ibhon s'Maon, ọmaana Kamẹl, ọmaana Ziph, ọmaana Juta, <verse eid="JOS 15:55" /><verse number="56" style="v" sid="JOS 15:56" />ọmaana Jẹzrẹl, ọmaana Jokeam, ọmaana Zanoa, <verse eid="JOS 15:56" /><verse number="57" style="v" sid="JOS 15:57" />ọmaana Kain, ọmaana Gibea, ọttara Timna. Kibung-kibungọ, wa ode ibhon siden ijobh, ọmaana ibhonva sabẹ.<verse eid="JOS 15:57" /></para>
  <para style="pi">
    <verse number="58" style="v" sid="JOS 15:58" />Wa obir ode ibhon s'Halhul, ọmaana Bẹt-Zur, ọmaana Gẹdọr, <verse eid="JOS 15:58" /><verse number="59" style="v" sid="JOS 15:59" />ọmaana Maarat, ọmaana Bẹt-Anọt, ọttara Eltẹkon. Kibung-kibungọ, wa ode ibhon siden ichadanẹ, ọmaana ibhonva sabẹ.<verse eid="JOS 15:59" /></para>
  <para style="pi">
    <verse number="60" style="v" sid="JOS 15:60" />Wa obir ode ibhon s'Kiriyat-Baal (kw'ode Kiriyat-Jearim), ọmaana Raba, kw'ode ibhon siden ifa ọttara ibhonva sabẹ.<verse eid="JOS 15:60" /></para>
  <para style="m">
    <verse number="61" style="v" sid="JOS 15:61" />Z'ibyi s'anọng nna arukọ, ode Bẹt-Araba, ọmaana Midin, ọmaana Sẹkaka,<verse eid="JOS 15:61" /></para>
  <para style="pi">
    <verse number="62" style="v" sid="JOS 15:62" />ọmaana Nibshan, ọmaana Obhon kwiden kw'Onung, ọmaana En-Gẹdi. Kibung-kibungọ, wa ode ibhon ichadanẹ, ọmaana ibhonva sabẹ.<verse eid="JOS 15:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="JOS 15:63" />Wa anọng p'Juda, manọng p'Jebus p'arukọ ny'Jẹrusalẹm kakpo akwubh. Maa, pyirẹ menda, anọng p'Jẹbus atim arukọ nya amaana anọng p'Juda.<verse eid="JOS 15:63" /></para>
  <chapter eid="JOS 15" />
  <chapter number="16" style="c" sid="JOS 16" />
  <para style="s1">Okebh f'Ephraim ọmaana Manasẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1" />Wa okebh f'Josẹph, ọtọm z'Jọrdan z'Jẹriko, z'ẹbhaakẹ ch'ewuchen ed-eyin, z'nkeka s'Jeriko, etima mina maa, evura z'ibyi s'anọng nna arukọ, maa, ekwu epyirẹ z'ẹkọma ch'egbe ch'Bẹtẹl. <verse eid="JOS 16:1" /><verse number="2" style="v" sid="JOS 16:2" />Ebina ny'Bẹtẹl (kw'ode Luz), ejeka z'ẹkọma ch'anọng p'Ark, z'Atarọt, <verse eid="JOS 16:2" /><verse number="3" style="v" sid="JOS 16:3" />ẹwọna za ch'ewuchen ed-edimẹ, z'ẹkọma ch'anọng p'Japhlẹt maa, pyirẹ z'izek-izek kw'Bẹt-Họrọn, etima maa, epyirẹ z'Gẹzẹr, ẹd-ẹkpọka z'ọraanga kwiden kw'Mẹditereniya.<verse eid="JOS 16:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="JOS 16:4" />Minna kw'anọng p'Manasẹ, ọmaana Ephraim, p'uwa made iva p'iva p'Josẹph, matọk okebh fabẹ.<verse eid="JOS 16:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="JOS 16:5" />Ma wọ ode ẹkọma ch'Ephraim, atorọ k'nnọmma sabẹ:</para>
  <para style="b" vid="JOS 16:5" />
  <para style="pi1" vid="JOS 16:5">Wa enem ch'okebh fabẹ, ẹtọm z'Atarọt-Adar, za ch'ewuchen ed-eyin, maa, epyirẹ z'ebir-ebir kw'Bẹt-Họrọn, <verse eid="JOS 16:5" /><verse number="6" style="v" sid="JOS 16:6" />etima maa, epyirẹ z'ọraanga kwiden kw'Mẹditereniya. Tọma ny'ebir-ebir kw'Mikmẹtat, ẹkwọrọ echina z'Taanat-Shilo, ẹkpan ezeng z'Jonoa, za ch'ewuchen ed-eyin. <verse eid="JOS 16:6" /><verse number="7" style="v" sid="JOS 16:7" />Enem ndo ebina z'Janoa, ẹwọna echina z'Atarọt, z'Naara, ẹd-ẹbọka z'Jeriko, pira neyinẹ z'Jọrdan. <verse eid="JOS 16:7" /><verse number="8" style="v" sid="JOS 16:8" />Tọma z'Tapua, enem ndo echina z'ilokodo s'Kana, ẹd-ẹkpọka z'ẹbhaakẹ ch'ọraanga kwiden kw'Meditereniya. Ma wọ ode okebh f'ẹkọma ch'Ephraim, atorọ k'nnọmma sabẹ. <verse eid="JOS 16:8" /><verse number="9" style="v" sid="JOS 16:9" />Wa okebh fabẹ ọttar ibhon maphyir, ọmaana ibhonva s'makọm asok anọng Ephraim ny'ẹtaanga kw'okebh f'Manasẹ.<verse eid="JOS 16:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="JOS 16:10" />Wa bẹ m'anọng p'Kenaan p'arukọ z'Gẹzẹr kakwubhọ. Maa, pyirẹ m'ewu ch'menda, anọng p'Kenaan atim arukọ amaana anọng Ephraim, okenaka, mad-agwa bẹ k'ẹfa bẹ́, masi itọhm.<verse eid="JOS 16:10" /></para>
  <chapter eid="JOS 16" />
  <chapter number="17" style="c" sid="JOS 17" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1" />Ma wọ uwa ode okebh f'ofonamma kw'Manasẹ kw'ode ochedennwa kw'Josẹph. Makir kw'ode ochedennwa kw'Manasẹ, obir ode otte kwiden kw'anọng p'Gilead, wa manangẹ Gilead, ọmaana Bashan mach'okebh fẹ, okurọ ch'iwa ode okkikkaama. <verse eid="JOS 17:1" /><verse number="2" style="v" sid="JOS 17:2" />Nya o, okebh mva, wa ode f'anọng mboza maphyir p'ade nnọmma s'Manasẹ, p'ade Abiezer, ọmaana Hẹlẹk, ọmaana Asriyẹl, ọmaana Shẹkẹm, ọmaana Hephe, ọttara Shẹmida. Ayok mba bọ ade ajinọngva mboza p'abin k'ntaak s'Manasẹ kw'Josẹph obhonọ, atorọ k'nnọmma sabẹ.<verse eid="JOS 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 17:3" />Zelophedad kw'ode nnwa kw'Hepher, kw'ode nnwa kw'Gilead, kw'ode nnwa kw'Makir kw'Manasẹ obhonọ, wa ajinọngva kobhonọ, kw'ọkpanẹ panọngva bẹ-bẹ, p'akpen Mahlah, ọmaana Noa, ọmaana Hogla, ọmaana Milka ọttara Tirza. <verse eid="JOS 17:3" /><verse number="4" style="v" sid="JOS 17:4" />Mabina, mad-akebha Eleazer kw'ode ọfọhn-ẹja, ọmaana Joshua kw'ode nnwa kw'Nun, ọttara asonọng, maben bẹ bẹ́, “Ọvaar Ibinọkpaabyi obenẹ Mosẹs bẹ́, ọnang mina okebh k'ottem kw'ivotte pamina.” Minna kw'Joshua ọnang bẹ ọttara ivotte okebh fabẹ, otor k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi. <verse eid="JOS 17:4" /><verse number="5" style="v" sid="JOS 17:5" />Wa okebh f'anọng p'Manasẹ ode azek-kpaama ijobh, agbaarẹ Gilead ọmaana Bashan abharẹ z'okwubha kw'ewuchen ed-eyin z'Jọrdan, <verse eid="JOS 17:5" /><verse number="6" style="v" sid="JOS 17:6" />okurọ bẹ́, wa aminava ọmaana ajinọngva, matọn ayena okebh ny'efona ch'Manasẹ. Wa izek z'Gilead nikwu iyena iva p'Manasẹ maphyir.<verse eid="JOS 17:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="JOS 17:7" />Wa ẹkọma ch'Manasẹ ẹtọm z'Ashẹr maa, epyirẹ z'Mikmẹtat z'ẹbhaakẹ ch'ewuchen ed-eyin z'Shẹkẹm. Enem ndo ẹwọna izek-izek maa, ẹd-ẹbọka z'anọng p'arukọ z'Ẹn-Tapua. <verse eid="JOS 17:7" /><verse number="8" style="v" sid="JOS 17:8" />(Manasẹ wọ oyen izek s'Tapua, okenaka, chibhẹ ch'Tapua oning k'enem ch'Manasẹ anọng Ephraim bọ uwa ayen.) <verse eid="JOS 17:8" /><verse number="9" style="v" sid="JOS 17:9" />Minna kw'enem ndo etim maa, epyirẹ z'ẹwọn-ẹwọna kw'ilokodo s'Kana. Wa oyen ibhon s'Ephraim s'ining imaana ibhon s'Manasẹ. Okenaka, wa enem ch'Manasẹ ening ebir-ebir kw'ilokodo, ẹd-ẹkpọka z'ọraanga kwiden kw'Meditereniya. <verse eid="JOS 17:9" /><verse number="10" style="v" sid="JOS 17:10" />Wa Ephraim oyen ẹwọn-ẹwọna, Manasẹ oyena ebir-ebir kw'izek njo. Ẹkọma ch'Manasẹ etima maa, epyirẹ z'ọraanga kwiden kw'Meditereniya, ẹd-ẹbọka z'ebir-ebir kw'Ashẹr, ọmaana z'ẹbhaakẹ ch'ewuchen ed-eyin z'Isaaka.<verse eid="JOS 17:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="JOS 17:11" />Ny'ẹkọma ch'Isaaka, ọmaana ch'Ashẹr, wa Manasẹ obir oyena ibhon s'ide Bẹt-Shan, ọmaana Ibleam, ọttara anọng p'Dọr, ọmaana Endọr, ọmaana Taanak, ọmaana Mẹdigo ọttara ibhon s'ikọbh bẹ (ẹkọma ch'ettong ittaan ede Naphọt).<verse eid="JOS 17:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="JOS 17:12" />Chibhẹ nya, wa anọng p'Manasẹ ny'ibhon njo kakpo aruk, okurọ ch'anọng p'Kenaan macher obo bẹ́, mm'aruk ny'ẹbhaakẹ ndo. <verse eid="JOS 17:12" /><verse number="13" style="v" sid="JOS 17:13" />Okenaka, k'ogbe kw'anọng p'Israẹl nkk'ẹfa ayena, m'anọng p'Kenaan kibung-kibungọ kakwubhọ. Wa mad-agwa bẹ k'ẹfa bẹ́, masi itọhm.<verse eid="JOS 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 17:14" />Anọng p'Joshua akwu aben Josẹph bẹ, “Osempira anang mina okebh mavanẹ vẹ-vẹ, abira anang mina ẹkọma madanẹ dẹ-dẹ? Mina mọsaabh-ọsaabh, Ọvaar Ibinọkpaabyi kk'mina obir ọda mawuriji.”<verse eid="JOS 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 17:15" />Joshua ọpọhna bẹ bẹ́, “Ó̱de ode bẹ́, bọnga masaabh-ọsaabh, obira ode bẹ́, ẹkọma ch'Ephraim ch'egbe, ọdọk bọnga kebeng, màchina z'ẹtam ch'ening z'Periz ọmaana Rephayit, mattem ibyi za, maninga.”<verse eid="JOS 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 17:16" />Anọng p'Josẹph apọhna bẹ́, “Ẹbhaakẹ ndo ch'agbeso, mina kebeng. Anọng p'Kenaan maphyir p'arukọ z'mkpẹmẹ, mayen ijaar s'nnyanya id-itọr s'ide mgbaka-mgbaka, ozeng k'anọng p'Bẹt-Shan, ọmaana anọng p'arukọ z'ibhonva, ọttara anọng p'arukọ z'ilokodo s'Jẹzrẹl.”<verse eid="JOS 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 17:17" />Okenaka, Joshua oben nkọma s'Josẹph s'ide Ephraim, ọmaana Manasẹ bẹ́, “Bọnga masaabh-ọsaabh, mabira ayena efa mawuriji. Bọnga mm'ẹkọma madanẹ dẹ-dẹ, mayena. <verse eid="JOS 17:17" /><verse number="18" style="v" sid="JOS 17:18" />Bọnga mm'abira atọka ẹbhaakẹ ch'ẹtam ch'agbe. Ibyi s'mattem apyirẹ, m'ide sabọnga. Zabẹ anọng p'Kenaan ayen ijaar s'nnyanya id-itọr s'ide mgbaka-mgbaka, mabir ayena ẹfa, bọnga makpokpo akwubh bẹ.”<verse eid="JOS 17:18" /></para>
  <chapter eid="JOS 17" />
  <chapter number="18" style="c" sid="JOS 18" />
  <para style="s1">Ekebha ch'izek s'irikẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1" />Wa ikpakaana s'anọng p'Israẹl k'ibungọ, ikwu ittonga z'Shilo, ibira ittima ikkira s'etobha za. Wa ẹkọma ndo nening kabẹ k'ẹfa. <verse eid="JOS 18:1" /><verse number="2" style="v" sid="JOS 18:2" />Okenaka, wa mfonamma ichenọmfa s'Israẹl itim irikẹ za, s'ina okebh fabẹ itim itọka. <verse eid="JOS 18:2" /><verse number="3" style="v" sid="JOS 18:3" />Nya o, Joshua oben anọng p'Israẹl bẹ́, “Kwuna m'ọtọka bọnga ogbe opyirẹ yen o, pira matọka izek njo s'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'ab'atte, ikk'bọnga ọnanga o? <verse eid="JOS 18:3" /><verse number="4" style="v" sid="JOS 18:4" />Màteka ajinọng attaan-attaan k'ofonamma kpenamkpen. Kaam m'ntọhm bẹ bẹ́, mabaana izek njo, ọfha makkẹr k'ose kw'ide, otor k'okebh f'ofonamma kpenamkpen, pira makwuna akebh-m ka. <verse eid="JOS 18:4" /><verse number="5" style="v" sid="JOS 18:5" />Màkebh izek njo k'akwumọ achenọmfa. Tte Juda ochina ororo oninga k'ẹbhaakẹ chẹ ch'ẹwọn-ẹwọna. Nnọmma s'Josẹph ibira ido ininga k'ẹbhaakẹ chabẹ ch'ebir-ebir. <verse eid="JOS 18:5" /><verse number="6" style="v" sid="JOS 18:6" />Ó̱de nkk'ose kw'akwumọ achenọmfa p'izek njo ade akkẹra maphyir, màtọka chen-m ma. Kaam m'mmarẹ ọsẹ nang bọnga k'ititika s'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwamina. <verse eid="JOS 18:6" /><verse number="7" style="v" sid="JOS 18:7" />Okenaka, anọng p'Lẹvi m'ibyi kayen mach'bọnga, okurọ bẹ́, ọtọhm f'ẹja ch'Ọvaar Ibinọkpaabyi ofufọhnọ, vọ ode okebh fabẹ. Gad, ọmaana Reubẹn, ọttara igboka janẹ s'efona ch'Manasẹ, nkk'okebh f'abẹ atọka z'ẹbhaakẹ ch'ewuchen ed-eyin z'Jọrdan. Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi, wọ uwa ọnang bẹ.” <verse eid="JOS 18:7" /><verse number="8" style="v" sid="JOS 18:8" />K'ose kw'ajinọng mbo mabin bẹ́, matọma okebh f'izek njo, Joshua ọtọhn bẹ bẹ́, “Màzọhng baana izek njo, makkẹr ose kw'ide, pira makwuna akebh-m ma. Kaam m'mmarẹ ọsẹ nnang bọnga m'Shilo k'ititika s'Ọvaar Ibinọkpaabyi.” <verse eid="JOS 18:8" /><verse number="9" style="v" sid="JOS 18:9" />Minna kw'ajinọng mbo mabin, mazenga akọbha izek njo. Makkẹr k'ose kw'ide k'ibhon-k'ibhon, k'ikwumọ ichenọmfa make k'ọnwẹrkpa, pira nn'akwun akebha Joshua z'Shilo. <verse eid="JOS 18:9" /><verse number="10" style="v" sid="JOS 18:10" />Nya o, Joshua ọbharẹ ọsẹ ọnang bẹ z'Shilo, k'ititika s'Ọvaar Ibinọkpaabyi. Wa obira oninga nya okebh izek njo otor k'nkwurọ s'mfonamma sabẹ, ọnang anọng p'Israẹl.<verse eid="JOS 18:10" /></para>
  <para style="s1">Okebh f'Bẹnjamin</para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 18:11" />Ọsẹ kw'uwa machi eden abharẹ otto k'ofonamma kw'Bẹnjamin, otor k'nnọmma sabẹ. Ibyi s'iwa manangẹ bẹ, ining ny'njeka kw'ofonama kw'Juda ọmaana kw'Josẹph: <verse eid="JOS 18:11" /><verse number="12" style="v" sid="JOS 18:12" />Z'ẹbhaakẹ ch'ebir-ebir, enem chabẹ ẹtọm z'Jọrdan, ejeka z'isakada s'ebir-ebir kw'Jẹriko, echina z'okwubha kw'ewuchen ed-edimẹ, z'ẹkọma ch'egbe, minna maa, eyin z'ibyi s'anọng nna arukọ, z'Bẹt-Aven. <verse eid="JOS 18:12" /><verse number="13" style="v" sid="JOS 18:13" />Ebina nya, ejeka z'isakada s'Luz (kw'ode Bẹtẹl), ebira ẹsaka z'Atarọt-Ada, z'egbe ch'ening z'ẹwọn-ẹwọna kw'Izek-izek kw'Bẹt-Horon.<verse eid="JOS 18:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="JOS 18:14" />Tọma z'egbe ch'ekkerẹ z'Bẹt-Horon z'ẹwọn-ẹwọna, enem ndo ẹbhakẹ ny'ẹwọn-ẹwọna, ezenga ny'ẹbhaakẹ ch'ewuchen ed-edimẹ, eyin z'Kiriat Baal (kw'ode Kiriyat-Jearim), kw'ode obhon wanẹ kw'anọng p'Juda. Ẹbhaakẹ ch'iwa ewuchen ed-edimẹ dọ ma.<verse eid="JOS 18:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="JOS 18:15" />Ẹbhaakẹ ch'ẹwọn-ẹwọna ẹtọm z'mbọr-mbọr kw'Kiriyat-Jearim, z'ẹbhaakẹ ch'ewuchen ed-edimẹ. Enem ndo ebira ekwu eyin z'ekeka ch'asi p'Nẹphtoa. <verse eid="JOS 18:15" /><verse number="16" style="v" sid="JOS 18:16" />Ekwu ẹwọna z'mmo s'egbe ndo ch'ekkerẹ z'ilokodo s'Bẹn-Hinnọm, z'ebir-ebir kw'ilokodo s'Rephaim. Minna kw'echin ororo ẹsaka z'ilokodo s'Hinnọm, etor ny'isakada s'ẹbhaakẹ ch'ẹwọn-ẹwọna kw'ebhondim ch'anọng p'Jebu maa, epyirẹ z'Ẹn-Rogel. <verse eid="JOS 18:16" /><verse number="17" style="v" sid="JOS 18:17" />Ekwu ẹkwọr echina ebir-ebir kw'Shẹmẹsh, echina ororo z'Gẹlilọt kw'okkerẹ ititika z'eden ch'Adumin, maa, ẹsaka z'Ọta kw'Boham, kw'ode nnwa kw'Reubẹn. <verse eid="JOS 18:17" /><verse number="18" style="v" sid="JOS 18:18" />Etima minna maa, epyirẹ z'isakada s'ebir-ebir kw'Bẹt- Araba, ẹwọna maa, epyirẹ z'Araba. <verse eid="JOS 18:18" /><verse number="19" style="v" sid="JOS 18:19" />Pira nechin z'isakada s'ebir-ebir kw'Bẹt-Hogla, ekwu eyin k'ebir-ebir kw'ẹka ch'Ọraanga kw'onung, za ch'ọyaakẹ z'ẹwọn-ẹwọna kw'Jọrdan. Wa enem ch'ẹwọn-ẹwọna ede minna.<verse eid="JOS 18:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="JOS 18:20" />Wa Jọrdan wọ ode enem z'ẹbhaakẹ ch'ewuchen ed-eyin.</para>
  <para style="m" vid="JOS 18:20">Nnem nja jọ iwa ikọhk okebh f'nnọmma s'Bẹnjamin k'ẹbhaakẹ kpenamkpen.<verse eid="JOS 18:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="JOS 18:21" />Ibhon s'isi efona ch'Bẹnjamin atorọ k'nnọma sabẹ ide; Jẹriko, ọmaana Bẹt-Hogla, ọmaana Ẹmẹk-Kẹziz, ọmaana<verse eid="JOS 18:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="JOS 18:22" />Bẹt-Araba, ọmaana Zemaraim, ọmaana Bẹthẹl, ọmaana <verse eid="JOS 18:22" /><verse number="23" style="v" sid="JOS 18:23" />Avim, ọmaana Para, ọmaana Ophra, ọmaana <verse eid="JOS 18:23" /><verse number="24" style="v" sid="JOS 18:24" />Kẹphar-Amoni, ọmaana Ophni, ọttara Geba. Kibung-kibungọ, wa ode ibhon siden ijobh kkamfa, ọttara ibhonva sabẹ.<verse eid="JOS 18:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="JOS 18:25" />Ibhon s'iwa ittar nya ide Gibeọn, ọmaana Rama, ọmaana Bẹrọt, ọmaana <verse eid="JOS 18:25" /><verse number="26" style="v" sid="JOS 18:26" />Mizpa, ọmaana Kephira, ọmaana Moza, ọmaana <verse eid="JOS 18:26" /><verse number="27" style="v" sid="JOS 18:27" />Rekem, ọmaana Irpẹl, ọmaana Tarala, ọmaana <verse eid="JOS 18:27" /><verse number="28" style="v" sid="JOS 18:28" />Zẹla, ọttara Haeleph, kw'ode ebhondim ch'anọng p'Jẹbus (kw'ode Jẹrusalẹm), ọmaana Gibea, ọttara Kiriyat. Kibung-kibungọ, wa ode ibhon siden osowanẹ kw'ichi ọmaana ibhonva sabẹ.</para>
  <para style="m" vid="JOS 18:28">Minna kw'uwa okebh f'efona ch'Bẹnjamin ode, atorọ k'nnọmma sabẹ.<verse eid="JOS 18:28" /></para>
  <chapter eid="JOS 18" />
  <chapter number="19" style="c" sid="JOS 19" />
  <para style="s1">Okebh f'Simeon</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1" />Izek ttong ifa s'iwa makebhẹ, ide s'izek s'efona ch'Simeon, otor k'ẹnọmma chẹ. Wa okebh f'abẹ, oning k'ẹbhaakẹ ch'Juda. <verse eid="JOS 19:1" /><verse number="2" style="v" sid="JOS 19:2" />Okebh f'uwa ọttar nya, ode:</para>
  <para style="pi1" vid="JOS 19:2">Beershẹba (kw'ode Shẹba), ọmaana Molada, ọmaana <verse eid="JOS 19:2" /><verse number="3" style="v" sid="JOS 19:3" />Hazar-Shual, ọmaana Bala, ọmaana Ezem, ọmaana <verse eid="JOS 19:3" /><verse number="4" style="v" sid="JOS 19:4" />Eltolad, ọmaana Bethul, ọmaana Horma, ọmaana <verse eid="JOS 19:4" /><verse number="5" style="v" sid="JOS 19:5" />Ziklag, ọmaana Beth-Markabot, ọmaana Hazar-Susa, ọmaana <verse eid="JOS 19:5" /><verse number="6" style="v" sid="JOS 19:6" />Beth-Lebaot ọttara Sharuhen. Kibung-kibungọ, wa ode ibhon siden ijobh kkanttaan ọmaana ibhonva sabẹ.<verse eid="JOS 19:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="JOS 19:7" />K'ẹbhaakẹ ọdọk-ọdọk, wa ode ibhon nna, ọmaana ibhonva sabẹ, s'ide Ain, ọmaana Rimmon, ọmaana Ether, ọttara Ashan, <verse eid="JOS 19:7" /><verse number="8" style="v" sid="JOS 19:8" />ọmaana ibhonva njoza s'ikọbh ibhon nja siden maa, pyirẹ z'Baalat-Beer (kw'ode Rama z'ẹwọn-ẹwọna). Okebh f'uwa anọng p'Simeon ayen vọ nya, atorọ k'nnọmma sabẹ.<verse eid="JOS 19:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="JOS 19:9" />Okebh f'uwa efona ch'Simeon oyen, wa mayekẹ z'okebh f'efona ch'Juda okurọ bẹ́, wa okebh f'Juda ọbarẹ ọyọhnga ọsaabh fabẹ. Ofona nya, efona ch'Simeon eyen okebh fabẹ ny'izek s'Juda.<verse eid="JOS 19:9" /></para>
  <para style="s1">Okebh f'Zebulun</para>
  <para style="m">
    <verse number="10" style="v" sid="JOS 19:10" />Wa okebh f'ottong attaan ode f'efona ch'Zebulum, otor k'nnọmma sẹ.</para>
  <para style="pi" vid="JOS 19:10">Wa enem ch'izek sabẹ, etim maa, epyirẹ z'Sarid. <verse eid="JOS 19:10" /><verse number="11" style="v" sid="JOS 19:11" />Achin z'ẹbhaakẹ ch'ewuchen ed-edimẹ, enem ndo etim minna maa, epyirẹ z'Marala, ẹbọka z'Dabeshet, ebir etima maa, epyirẹ z'ekeka ch'ẹnyọm Jokneam. <verse eid="JOS 19:11" /><verse number="12" style="v" sid="JOS 19:12" />Ekwu ẹbhakẹ z'Sarid z'ẹbhaakẹ ch'ewuchen ed-eyin, ekkerẹ ititika z'ẹkọma ch'Kisloth-Tabọr, ezeng z'Dabera, minna maa, epyirẹ z'Japhiya. <verse eid="JOS 19:12" /><verse number="13" style="v" sid="JOS 19:13" />Echina ororo z'ẹbhaakẹ ch'ewuchen ed-eyin z'Gath-Hepher, ọmaana Eth-Kazi, ọttara Rimmon, maa, ẹbhakẹ echina z'Nea. <verse eid="JOS 19:13" /><verse number="14" style="v" sid="JOS 19:14" />Enem ch'Zebulun z'ebir-ebir, ejek Hannathon, ekwu ẹkpọka z'ilokodo s'Iphta-el. <verse eid="JOS 19:14" /><verse number="15" style="v" sid="JOS 19:15" />Ibhon siden s'ibir ittara m'ẹbhaakẹ nda, ide Kattat, ọmaana Nahalal, ọmaana Shimron, ọmaana Idala, ọttara Bẹtẹlẹhẹm. Kibung-kibungọ, wa ode ibhon siden ijobh kkamfa, ọmaana ibhonva sabẹ.<verse eid="JOS 19:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="JOS 19:16" />Ibhon nja siden ọttara ibhonva sabẹ jọ s'iwa manangẹ efona ch'Zebulun, atorọ k'nnọmma sabẹ.<verse eid="JOS 19:16" /></para>
  <para style="s1">Okebh f'manangẹ Isaka</para>
  <para style="m">
    <verse number="17" style="v" sid="JOS 19:17" />Okebh f'ottong nna, ode f'efona ch'Isaka, atorọ k'nnọmma sẹ. <verse eid="JOS 19:17" /><verse number="18" style="v" sid="JOS 19:18" />Ibhon s'iwa ittar ny'ẹkọma ndo ide,</para>
  <para style="pi1" vid="JOS 19:18">Jẹzrẹl, ọmaana Kesullot, ọmaana Shunem, ọmaana <verse eid="JOS 19:18" /><verse number="19" style="v" sid="JOS 19:19" />Hapharayim, ọmaana Shion, ọmaana Anaharat, ọmaana <verse eid="JOS 19:19" /><verse number="20" style="v" sid="JOS 19:20" />Rabit, ọmaana Kishion, ọmaana Ebez, ọmaana <verse eid="JOS 19:20" /><verse number="21" style="v" sid="JOS 19:21" />Remet, ọmaana En-gannim, ọmaana En-Hadda, ọttara Bẹt-Pazez. <verse eid="JOS 19:21" /><verse number="22" style="v" sid="JOS 19:22" />Enem ndo ebir epyi mbọhk z'Tabọr, ọmaana Shahazuma, ọttara Bẹt-shẹmẹsh, ekwu ẹkpọka z'ọraanga kw'Jọrdan. Kibung-kibungọ, wa ode ibhon siden ichi kawanẹ, attar ibhonva sabẹ.<verse eid="JOS 19:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="JOS 19:23" />Ibhon nja siden, ọmaana ibhonva sabẹ, jẹ jọ s'iwa manangẹ efona ch'Isaka ator k'nnọmma sabẹ.<verse eid="JOS 19:23" /></para>
  <para style="s1">Okebh f'Asher</para>
  <para style="m">
    <verse number="24" style="v" sid="JOS 19:24" />Wa okebh f'ottong nchen ode f'efona ch'Asher, otor k'ẹnọmma chẹ. <verse eid="JOS 19:24" /><verse number="25" style="v" sid="JOS 19:25" />Ibhon siden s'iwa ittar nya ide:</para>
  <para style="pi1" vid="JOS 19:25">Helkat, ọmaana Hali, ọmaana Beten, ọmaana Akshaph, ọmaana <verse eid="JOS 19:25" /><verse number="26" style="v" sid="JOS 19:26" />Alammelek, ọmaana Amad, ọttara Mishal. Z'ẹbhaakẹ ch'ewuchen ed-edimẹ, enem ndo epyi mbọhk z'Karmẹl, ọmaana Shihor-Libnat, <verse eid="JOS 19:26" /><verse number="27" style="v" sid="JOS 19:27" />ẹbhakẹ ekkerẹ ititika z'ẹbhaakẹ ch'Bẹt-dagon, z'ẹbhaakẹ ch'ewuchen ed-eyin, etima minna maa, etto z'Zebulun ọmaana z'ilokokodo s'Iphta-el. Pira nechin ebir-ebir kw'Bet-emek, ọmaana Neyiel. Itima minna maa, echina ebir-ebir kw'Kabul, <verse eid="JOS 19:27" /><verse number="28" style="v" sid="JOS 19:28" />ọmaana Abdon, ọmaana Rehob, ọmaana Hammon, ọmaana Kana, maa, ezeng z'Sidon Kwiden. <verse eid="JOS 19:28" /><verse number="29" style="v" sid="JOS 19:29" />Enem ndo ẹbhakẹ ekkerẹ Rama, ọmaana ifa-byi s'Taya, ekwu ẹbhakẹ nya, echina ẹbhaakẹ ch'Hosa, ekwu etto z'ọraanga kw'Meditereniya. Nnem s'ibir ittara nya ide: Mehebẹl, ọmaana Akzib, ọmaana <verse eid="JOS 19:29" /><verse number="30" style="v" sid="JOS 19:30" />Umma, ọmaana Aphek, ọttara Rehob. Kibung-kibungọ, wa ode ibhon siden ẹrọbh okwuma ifa ọmaana ibhonva sabẹ.<verse eid="JOS 19:30" /></para>
  <para style="b" />
  <para style="m">
    <verse number="31" style="v" sid="JOS 19:31" />Ibhon nja siden ọmaana ibhonva sabẹ jọ ide okebh f'ẹkọma ch'Asher otor k'nnọmma sabẹ.<verse eid="JOS 19:31" /></para>
  <para style="s1">Okebh f'Naphtali</para>
  <para style="m">
    <verse number="32" style="v" sid="JOS 19:32" />Okebh f'ottong ichadanẹ ode f'efona ch'Naphtali, otor k'nnọmma sẹ.<verse eid="JOS 19:32" /></para>
  <para style="pi">
    <verse number="33" style="v" sid="JOS 19:33" />Enem chabẹ ẹtọm z'Heleph, z'oak-chi kwiden z'Zaanannim, ejeka z'Adami-nekeb, ọmaana z'Jabneel, maa, tto z'Lakum, ẹd-ẹkpọka z'ọraanga kw'Jọrdan. <verse eid="JOS 19:33" /><verse number="34" style="v" sid="JOS 19:34" />Enem ndo ẹbhakẹ ekkerẹ Aznot-Tabor z'ẹbhaakẹ ch'ewuchen ed-edimẹ, ezeng z'Hukkok, ed-epyi mbọhk z'enem ch'Zebulun, z'ẹwọn-ẹwọna kw'enem ch'Asher, za ch'ewuchen ed-edimẹ, ọmaana z'ọraanga kw'Jọrdan, z'ẹbhaakẹ ch'ewuchen ed-eyin. <verse eid="JOS 19:34" /><verse number="35" style="v" sid="JOS 19:35" />Ibhon siden s'iwa ide ifa-byi ide, Zidim, ọmaana Zer, ọmaana Hammat, ọmaana Rakat, ọmaana Kinneret, ọmaana <verse eid="JOS 19:35" /><verse number="36" style="v" sid="JOS 19:36" />Adama, ọmaana Rama, ọmaana Hazor, ọmaana <verse eid="JOS 19:36" /><verse number="37" style="v" sid="JOS 19:37" />Kedesh, ọmaana Edrei, ọmaana En-hazor, ọmaana <verse eid="JOS 19:37" /><verse number="38" style="v" sid="JOS 19:38" />Yiron, ọmaana Migdal-El, ọmaana Horem, ọmaana Bẹt-Anat, ọttara Bẹt-Shẹmẹsh. Kibung-kibungọ, wa ode ibhon siden osowanẹ kw'ẹrọbh, ọmaana ibhonva sabẹ.<verse eid="JOS 19:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="JOS 19:39" />Ibhon nja siden ọmaana ibhonva sabẹ jọ ide okebh f'efona ch'Naphtali, otor k'nnọmma sabẹ.<verse eid="JOS 19:39" /></para>
  <para style="s1">Okebh f'Dan</para>
  <para style="m">
    <verse number="40" style="v" sid="JOS 19:40" />Okebh f'ottong ochenọmfa ode f'efona ch'Dan, otor k'nnọmma sẹ. <verse eid="JOS 19:40" /><verse number="41" style="v" sid="JOS 19:41" />Ẹbhaakẹ ch'iwa ede okebh fabẹ ede:</para>
  <para style="pi1" vid="JOS 19:41">Zora, ọmaana Eshtaol, ọmaana Ir-Shẹmẹsh, ọmaana <verse eid="JOS 19:41" /><verse number="42" style="v" sid="JOS 19:42" />Shaalabin, ọmaana Aijalon, ọmaana Itla, ọmaana <verse eid="JOS 19:42" /><verse number="43" style="v" sid="JOS 19:43" />Elon, ọmaana Timna, ọmaana Ekron, ọmaana <verse eid="JOS 19:43" /><verse number="44" style="v" sid="JOS 19:44" />Elteke, ọmaana Gibeton, ọmaana Baalat, ọmaana <verse eid="JOS 19:44" /><verse number="45" style="v" sid="JOS 19:45" />Jehud, ọmaana Bene-Berak, ọmaana Gat-Rimmon, ọmaana <verse eid="JOS 19:45" /><verse number="46" style="v" sid="JOS 19:46" />Me-Jarkon, ọmaana Rakon, ọttara ẹkọma ch'ening z'ititika kw'Jọpa.<verse eid="JOS 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JOS 19:47" />K'ogbe kw'mana efona ch'Dan izek sabẹ, anọng p'Dan ad-arima anọng p'Leshem ábẹ̀, makema anọng p'Leshem. Anọng p'Dan atọka ẹkọma ndo kibungọ, mafhọ anọng p'aning nya, pira masi oruk kwabẹ nya. Mabhona eche ch'obhon nwo, nnakpe obhon nwo bẹ́, Dan, k'ose kw'uwa ttatta kwabẹ kw'ode Dan, okpen.<verse eid="JOS 19:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="JOS 19:48" />Ibhon nja siden ọmaana ibhonva nja sabẹ, jẹ jọ uwa ide okebh f'efona ch'Dan, otor k'nnọmma sabẹ.<verse eid="JOS 19:48" /></para>
  <para style="s1">Okebh f'Joshua</para>
  <para style="p">
    <verse number="49" style="v" sid="JOS 19:49" />K'ogbe kw'uwa nkk'izek njo akebha maphyir anang mfona njo, anọng p'Israẹl akwu atọka izek janẹ, manang Joshua kw'ode nnwa kw'Nun mach'okebh fẹ. <verse eid="JOS 19:49" /><verse number="50" style="v" sid="JOS 19:50" />Manang-ẹ obhon kw'ororọ z'Timnat-sera, z'ẹkọma ch'Ephraim ch'egbe, otor k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi. Osi obhon kwiden, oruk nya.<verse eid="JOS 19:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JOS 19:51" />Okebh mva vọ f'uwa Eleazar kw'ode ọfọhn-ẹja, ọmaana Joshua kw'ode nnwa kw'Nun, ọmaana aso p'mfona ọmaana p'nnọmma s'Israẹl, masi. Wa maning z'ẹsọhmma ch'ikkira s'etobha z'Shilọ, ny'Ọvaar Ibinọkpaabyi k'ititika, mabharẹ ọsẹ kw'matim asi okebh mva. Minna kw'uwa macher okebh f'ozek mvo.<verse eid="JOS 19:51" /></para>
  <chapter eid="JOS 19" />
  <chapter number="20" style="c" sid="JOS 20" />
  <para style="s1">Ibhondim s'etubha</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1" />Ọvaar Ibinọkpaabyi oben Joshua bẹ́, <verse eid="JOS 20:1" /><verse number="2" style="v" sid="JOS 20:2" />“Ben anọng p'Israẹl bẹ́, màkpe ibhondim njo ache, k'ose kw'ntọhnọ Mosẹs, <verse eid="JOS 20:2" /><verse number="3" style="v" sid="JOS 20:3" />mfha ọnọng kpenamkpen kw'ọfhọ ọnọng ch'ina ọkaamẹ bẹ́, ọfhẹ-ẹ, wanẹma, ọnọng k'ẹyaaka kobir ọfhọ, óde ọrọbhọ od-otubha za, ọnọng kw'im'otuk-otuka, oning-ẹ oze.<verse eid="JOS 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 20:4" />K'ogbe kw'marọbhọ achina m'ibhondim nja, mm'abe ny'ọmma kw'ebhumma ch'ebhondim agbaak odik kw'majẹ anang asonọng p'ebhondim ndo. Asonọng mbo manang ọnọng nwo kw'ọjẹ odik ibyi s'im'oruk ny'ottem kwabẹ ny'ebhondim ndo. <verse eid="JOS 20:4" /><verse number="5" style="v" sid="JOS 20:5" />Ó̱de ọnọng okwubhọ ọnọng kw'ọrọbhọ ebhon maa, opyirẹ ny'ebhondim ndo, asonọng p'ebhondim ndo, m'ọnọng nwo kw'ọrọbhọ ebhon ọbọhk matte anang ọnọng nwo kw'okwubh-ẹ, okurọ bẹ́, oyok k'ẹyaaka kọfhọ. <verse eid="JOS 20:5" /><verse number="6" style="v" sid="JOS 20:6" />Ọnọng nwo kw'ọrọbhọ ebhon m'oninga ny'ebhondim maa, obe aponga k'ititika s'ikpakaana njo. Ọnọng nwo m'oninga nya maa, opyire k'ogbe kw'ọfọhn-ẹja kwiden kw'osi ọtọhm ny'ogbe nwo, ope. Ny'ogbese nwo, ọnọng nwo, oning ch'ọbhan z'ikẹ k'obhon.”<verse eid="JOS 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 20:7" />Ofona nya, mateka Kedesh z'Galili, z'ogbe-bhon kw'Naphtali, asok okikaan, marọhbha Shẹkẹm z'ogbe-bhon kw'Ephraim, mabir arọhbha Kiriyat-Arba (kw'ode Hẹbrọn) z'ogbe-bhon kw'Juda. <verse eid="JOS 20:7" /><verse number="8" style="v" sid="JOS 20:8" />Z'Jọrdan, z'ẹbhaakẹ ch'ewuchen ed-eyin (z'ọbọhk nwoza kw'Jẹriko), wa marọhbha Bẹzẹr z'ibyi s'anọng nna arukọ, z'ẹkpẹmẹ ch'efona ch'Reuben, marọhbha Ramọt z'Gilead z'efona ch'Gad, marọhbha Golan z'Bashan z'ẹkọma ch'Manasẹ. <verse eid="JOS 20:8" /><verse number="9" style="v" sid="JOS 20:9" />Ọnọng kpenamkpen kw'ofon Israẹl, wanẹma, okikennọng kw'orukọ ny'Israẹl kw'ina ọnọng k'ẹyaaka ọfhọ, oning ch'ọrọbhọ od-oninga m'ibhondim nja s'mapyi ache ma, ọfha ọnaanga k'mbọhk s'ọnọng kw'im'otuk-otuka, pira opyire ny'ewu ndo ch'im'obe aponga k'ititika s'ikpakaana njo.<verse eid="JOS 20:9" /></para>
  <chapter eid="JOS 20" />
  <chapter number="21" style="c" sid="JOS 21" />
  <para style="s1">Ibhon s'anọng p'Lẹvi</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 21:1" />Wa asonọng p'nnọhma s'anọng p'Lẹvi, mabin ad-akebha Eleazar kw'ode ọfọhn-ẹja, ọmaana Joshua kw'ode nnwa kw'Nun, ọttara aso mboza p'mfona s'Israẹl <verse eid="JOS 21:1" /><verse number="2" style="v" sid="JOS 21:2" />z'Shilọ z'Kenaan. Maben bẹ bẹ́, “Wa Ọvaar Ibinọkpaabyi otim Mosẹs oben bọnga bẹ́, mànang mina ibyi s'mm'oruk, ọmaana izek s'etirakpo pyamina im'eyena ọchattọhk.” <verse eid="JOS 21:2" /><verse number="3" style="v" sid="JOS 21:3" />K'ose kw'Ọvaar Ibinọkpaabyi ikk'obena, wa anọng p'Israẹl achin ny'ibhon janẹ s'ide okebh fabẹ, ọmaana izek sabẹ s'etirakpo im'eyena ọchattọhk, matọka anang efona ch'Lẹvi.<verse eid="JOS 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 21:4" />Wa okebh f'echeden, ode f'anọng p'efona ch'Kohat, otor k'nnọma sabẹ. Anọng mbo p'Lẹvi p'uwa made ẹnọmma ch'Arọn kw'ode ọfọhn-ẹja, manang bẹ ibhon siden ijobh kkanttaan z'efona ch'Juda, ọmaana Simeon ọttara Bẹnjamin. <verse eid="JOS 21:4" /><verse number="5" style="v" sid="JOS 21:5" />Iva p'iva mboza p'Kohat, manang bẹ ibhon siden ijobh z'nkọma s'mfona s'Ephraim, ọmaana Dan, ọmaana igboka janẹ s'efona ch'Manasẹ.<verse eid="JOS 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 21:6" />Iva p'iva p'Gershon wa manang bẹ ibhon ijobh kkanttaan s'ifon z'nkọma s'efona ch'Isakar, ọmaana s'Ashẹr, ọmaana Naphtali ọttara igboka janẹ s'efona ch'Manasẹ z'Bashan.<verse eid="JOS 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 21:7" />Wa manang iva p'iva p'Merari ibhon siden ijobh kkamfa ator k'nnọmma s'Reubẹn, ọmaana Gad, ọttara Zebulun.<verse eid="JOS 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 21:8" />Minna kw'uwa anọng p'Israẹl atim ọsẹ akebh ibhon nja siden ọmaana ozek f'etirakpo pyabẹ m'echi ọttọhk, anang anọng p'Lẹvi k'ose kw'uwa Ọvaar Ibinọkpaabyi kk'Mosẹs obena.<verse eid="JOS 21:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="JOS 21:9" />Ibhon siden s'ibin z'ẹkọma ch'Juda ọmaana Simeon s'mayerẹ bẹ k'ache, manangẹ bẹ <verse eid="JOS 21:9" /><verse number="10" style="v" sid="JOS 21:10" />mfona s'Kohat s'ifon z'nnọmma s'Lẹvi, s'ide iva p'iva p'Aarọn p'uwa ọsẹ ocheden otto kabẹ.<verse eid="JOS 21:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="JOS 21:11" />Wa manang bẹ Kiriyat-Arba (kw'ode Hẹbrọn) z'ogbe-bhon kw'Juda ọmaana ozek f'ọkọbh bẹ, f'etirakpo im'eyena ọchattọhk. (Arba wọ uwa ode ttatta kwabẹ.) <verse eid="JOS 21:11" /><verse number="12" style="v" sid="JOS 21:12" />Okenaka, wa nkk'mgba njoza, ọmaana ibhonva s'ikọbh ebhondim, atọka anang Kalẹb kw'ode nnwa kw'Jephunẹ mach'okebh fẹ.<verse eid="JOS 21:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="JOS 21:13" />Iva p'iva p'Aarọn kw'ode ọfọhn-ẹja, manangẹ bẹ Hẹbrọn (kw'ode itubha-byi s'ọnọng kw'ọfhọ ọnọng), ọmaana Libna, ọmaana <verse eid="JOS 21:13" /><verse number="14" style="v" sid="JOS 21:14" />Jattir, ọmaana Eshtemoa, ọmaana <verse eid="JOS 21:14" /><verse number="15" style="v" sid="JOS 21:15" />Holon, ọmaana Debir, ọmaana <verse eid="JOS 21:15" /><verse number="16" style="v" sid="JOS 21:16" />Ayin, ọmaana Jutta, ọttara Bẹt-Shẹmẹsh. Kibung-kibungọ, wa ode ibhon osowanẹ s'ibin m'nkọma nja mfa.<verse eid="JOS 21:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="JOS 21:17" />Z'ẹkọma ch'Bẹnjamin, ibhon ọmaana ozek f'etirakpo m'eyena ọchattọhk f'uwa manang afọhn-ẹja, ode Gibeọn, ọmaana Geba, ọmaana <verse eid="JOS 21:17" /><verse number="18" style="v" sid="JOS 21:18" />Anatot, ọttara Almọn. Ó̱de ágbak-ọgbaka, wa ode ibhon nna.<verse eid="JOS 21:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="JOS 21:19" />Kibung-kibungọ, ibhon ijobh kkanttaan, ọmaana ozek fabẹ f'etirakpo im'eyena ọchattọhk, vẹ vọ f'uwa manang afọhn-ẹja, p'ade iva p'iva p'Aarọn.<verse eid="JOS 21:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="JOS 21:20" />Anọng mboza p'ade ẹnọmma ch'Kohat, p'afon z'efona ch'Lẹvi, manangẹ bẹ, ibhon siden z'efona ch'Ephraim.<verse eid="JOS 21:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="JOS 21:21" />Z'ẹkọma ch'Ephraim ch'egbe, wa manangẹ bẹ Shẹkẹm (kw'ode ebhondim ch'itubha-byi s'ọnọng kw'mabenẹ bẹ́, ọfhọ ọnọng), ọmaana Gezer, ọmaana <verse eid="JOS 21:21" /><verse number="22" style="v" sid="JOS 21:22" />Kibzayim, ọmaana Bẹt-Horon, ọttara ozek fabẹ f'etirakpo m'eyena ọchattọhk. Kibung-kibungọ, wa ode ibhon siden nna.<verse eid="JOS 21:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="JOS 21:23" />Z'ẹkọma ch'Dan ọdọk, ozek f'uwa matọk anang bẹ ode, Elteke, ọmaana Gibbeton, ọmaana <verse eid="JOS 21:23" /><verse number="24" style="v" sid="JOS 21:24" />Aijalọn, ọttara Gat-rimmọn, ọmaana ozek f'etirakpo m'eyena ọchattọhk. Kibung-kibungọ, wa ode ibhon siden nna.<verse eid="JOS 21:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="JOS 21:25" />Igboka janẹ s'efona ch'Manasẹ ẹtọk ibhon nja s'm'ntta ma, ọmaana ozek f'etirakpo im'eyena ọchattọhk, ẹnang afọhn-ẹja: Taanak, ọmaana Gat-rimmon. Kibung-kibungọ, ode ibhon nna.<verse eid="JOS 21:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="JOS 21:26" />Kibung-kibungọ, ibhon ijobh ọmaana ozek f'abẹ f'etirakpo m'eyena ọchattọhk, vẹ vọ f'uwa manang mfona njoza s'Kohat s'irik-orik.<verse eid="JOS 21:26" /></para>
  <para style="b" />
  <para style="m">
    <verse number="27" style="v" sid="JOS 21:27" />Wa iva p'iva p'Gershon, kw'ode efona ọdọk-ọdọk ny'ẹkọma ch'Lẹvi, matọk ibhon nja s'm'ntta ma, ọmaana ozek fabẹ f'etirakpo im'eyena ọchattọhk</para>
  <para style="li4" vid="JOS 21:27">z'igboka janẹ s'efona ch'Manasẹ:</para>
  <para style="li4" vid="JOS 21:27">Golan z'Bashan (kw'ode itubha-byi s'anọng p'afhọ ọnọng), ọmaana Be-Eshtera. Kibung-kibungọ, wa ode ibhon siden ifa,<verse eid="JOS 21:27" /></para>
  <para style="li4">
    <verse number="28" style="v" sid="JOS 21:28" />z'ẹkọma ch'Isaka, manangẹ bẹ ibhon s'ide,</para>
  <para style="li4" vid="JOS 21:28">Kishon ọmaana Dabera, ọmaana <verse eid="JOS 21:28" /><verse number="29" style="v" sid="JOS 21:29" />Jarmut, ọmaana En-Gannim, ttara obyi fabẹ f'etirakpo min'eyena ọchattọhk. Kibung-kibungọ, wa ode ibhon siden nna.<verse eid="JOS 21:29" /></para>
  <para style="li4">
    <verse number="30" style="v" sid="JOS 21:30" />Z'ẹkọma ch'Asher, manangẹ bẹ ibhon s'ide</para>
  <para style="li4" vid="JOS 21:30">Mishal, ọmaana Abdon, ọmaana <verse eid="JOS 21:30" /><verse number="31" style="v" sid="JOS 21:31" />Helkat, ọmaana Rehob, ttara z'obyi fabẹ f'etirakpo min'echi ọttọhk. Kibung-kibungọ, wa ode ibhon siden nna.<verse eid="JOS 21:31" /></para>
  <para style="li4">
    <verse number="32" style="v" sid="JOS 21:32" />Z'ẹkọma ch'Naphtali, manangẹ bẹ ibhon s'ide</para>
  <para style="li4" vid="JOS 21:32">Kedesh z'Galili (kw'ode itubha-byi s'ọnọng kw'mabenẹ bẹ́, ọfhọ ọnọng), ọmaana Hammot-Dor, ọttara Kartan, ttara obyi fabẹ f'etirakpo min'eyena ọchattọhk. Kibung-kibungọ, wa ode ibhon siden ittaan.<verse eid="JOS 21:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="JOS 21:33" />Wa efona ch'Gershon ẹtọk ibhondim ẹrọbh okwuma ijobh, ọmaana obyi fabẹ f'etirakpo min'eyena ọchattọhk.<verse eid="JOS 21:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="JOS 21:34" />Mfona s'Merari (kw'ode efona ch'Lẹvi ch'erikẹ), wa manangẹ bẹ ibhon</para>
  <para style="li4" vid="JOS 21:34">Z'ẹkọma ch'Zebulun, ọmaana</para>
  <para style="li4" vid="JOS 21:34">Jokneam, ọmaana Karta, ọmaana <verse eid="JOS 21:34" /><verse number="35" style="v" sid="JOS 21:35" />Dimna, ọmaana Nahalal, ttara obyi fabẹ f'etirakpo min'eyena ọchattọhk. Kibung-kibungọ, wa ode ibhon siden nna.<verse eid="JOS 21:35" /></para>
  <para style="li4">
    <verse number="36" style="v" sid="JOS 21:36" />Z'ẹkọma ch'Reubẹn, manangẹ bẹ</para>
  <para style="li4" vid="JOS 21:36">Bezer, ọmaana Jahaz, ọmaana <verse eid="JOS 21:36" /><verse number="37" style="v" sid="JOS 21:37" />Kedemot, ọmaana Mephaat, ttara obyi fabẹ f'etirakpo min'eyena ọchattọhk. Kibung-kibungọ, wa ode ibhon siden nna.<verse eid="JOS 21:37" /></para>
  <para style="li4">
    <verse number="38" style="v" sid="JOS 21:38" />Z'ẹkọma ch'Gad, manangẹ bẹ Ramọt z'Gilead (kw'ode itubha-byi s'ọnọng kw'mabenẹ bẹ́, ọfhọ ọnọng), ọmaana Mahanayim, ọmaana <verse eid="JOS 21:38" /><verse number="39" style="v" sid="JOS 21:39" />Heshbon, ọmaana Jazer, ttara obyi fabẹ f'etirakpo min'eyena ọchattọhk. Kibung-kibungọ, wa ode ibhon siden nna.<verse eid="JOS 21:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="JOS 21:40" />Efona ch'Merari (kw'ode anọng p'Lẹvi p'arik-orik), manangẹ bẹ ibhon siden ijobh kkamfa.<verse eid="JOS 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JOS 21:41" />Wa anọng p'Lẹvi atọk izek sabẹ z'izek s'Israẹl okkikken oyena. Kibung-kibungọ, wa ode ibhon siden arọbh afa okwuma ochenọnttaan, ttara obyi fabẹ f'etirakpo min'eyena ọchattọhk. <verse eid="JOS 21:41" /><verse number="42" style="v" sid="JOS 21:42" />Wa ibhon nja maphyir iyen obyi f'etirakpo min'echi ọttọhk f'ọkọbh ibhon njo, ọkọbha. Wa ode ose nwo mawanẹ ọmaana ibhondim nja maphyir.<verse eid="JOS 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 21:43" />Minna kw'uwa Ọvaar Ibinọkpaabyi ọnang anọng p'Israẹl ozek mvo maphyir f'uwa ikk'ocheka bẹ́, m'ọnang ab'ttatta pabẹ. Anọng p'Israẹl atọka obyi mvo, masi oruk kwabẹ nya. <verse eid="JOS 21:43" /><verse number="44" style="v" sid="JOS 21:44" />Ọvaar Ibinọkpaabyi ọnang anọng p'Israẹl ẹmẹm k'ẹbhaakẹ kpenamkpen k'ose kw'uwa ikk'ocheka ọnang ab'ttatta pabẹ. Ọwawunanọng kwabẹ mawanẹ kode kw'okpo bẹ ábẹ̀. Ọvaar Ibinọkpaabyi ọtọka awawunanọng pabẹ maphyir, oke bẹ k'mbọhk, makema bẹ. <verse eid="JOS 21:44" /><verse number="45" style="v" sid="JOS 21:45" />Ny'nchekẹ ọkkọkka maphyir s'iwa Ọvaar Ibinọkpaabyi ochekẹ ọnang anọng p'Israẹl, echekẹ madanẹ ch'etun-otuna kede. Wa ettem ening ọnọng kpenamkpen ẹwọr.<verse eid="JOS 21:45" /></para>
  <chapter eid="JOS 21" />
  <chapter number="22" style="c" sid="JOS 22" />
  <para style="s1">Ẹkọma ch'ẹbhaakẹ ch'ewuchen ed-eyin ekwun k'obhon</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1" />Nya o, Joshua oyerẹ efona ch'Reuben, ọmaana ch'Gad ọttara igboka janẹ s'efona ch'Manasẹ. <verse eid="JOS 22:1" /><verse number="2" style="v" sid="JOS 22:2" />Oben bẹ bẹ́, “Nkk'ọttọhk kpenamkpen asa f'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ọsan bẹ, mabir akpobh-m k'idik maphyir s'mbenẹ bọnga. <verse eid="JOS 22:2" /><verse number="3" style="v" sid="JOS 22:3" />Node ogbe kw'okem ebhira, maa pyirẹ m'ewu ch'menda, bọnga m'ayok Israẹl kabhumọ. Nkk'ọtọhm f'Ọvaar Ibinọkpaabyi kw'ode Ọvaar Ibinọkpaabyi kwabọnga ọnang bọnga atera asa maphyir. <verse eid="JOS 22:3" /><verse number="4" style="v" sid="JOS 22:4" />Ch'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga kk'bọnga ẹmẹm ọnanga k'ẹbhaakẹ kpenamkpen k'ose kw'ochekẹ, màkpa nnam z'obhon kwabọnga, za ch'Mosẹs kw'ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi ọnang bọnga z'okwubha kw'Jọrdan. <verse eid="JOS 22:4" /><verse number="5" style="v" sid="JOS 22:5" />Okenaka, màtọka ogbe, kpobha ọsana ọmaana ọpaanga kw'Mosẹs kw'ode ọtọhmnọng kw'Ibinọkpaabyi, ọnang bọnga kw'obenẹ bẹ́, tte Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga, ọdaak bọnga, màzenga maan-ẹ k'ikpukpobha, màbọk-ẹ tima mawuriji, màtima ettem madanẹ, ọmaana ọgbagba kwabọnga kpobh-ẹ.”<verse eid="JOS 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 22:6" />Nya o, Joshua osi bẹ ittabọhng, pira notte bẹ ọbọhk, mabhana. Minna kw'mabhan zabẹ k'ibhon. <verse eid="JOS 22:6" /><verse number="7" style="v" sid="JOS 22:7" />(Wa Mosẹs kk'igboka janẹ s'efona ch'Manasẹ izek ọnanga z'Bashan, Joshua ọnang igboka njoza izek ọnyọma ayok-Israẹl z'ẹbhaakẹ ch'ewuchen ed-edimẹ z'Jọrdan.) K'ogbe kw'Joshua kk'bẹ ọtọhma bẹ́, mabhana o, osi bẹ ittabọhng, <verse eid="JOS 22:7" /><verse number="8" style="v" sid="JOS 22:8" />oben bẹ́, “Màtima ojibhada-kkatam kwabọnga, bhana z'abọnga k'ibhon, ọmaana etirakpo pyabọnga k'ọsaabh, ọmaana silva, ọmaana gol, ọmaana bronz, ọmaana mbaanga, ọmaana ọbara k'ọsaabh. Màkebh ekpo py'mana awawunanọng pabọnga maana ayok-Israẹl.”<verse eid="JOS 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 22:9" />Nya o, efona ch'Reubẹn, ọmaana ch'Gad, ọttara igboka janẹ s'efona ch'Manasẹ, ebina erik anọng p'Israẹl p'aning z'Shilọ z'Kenaan, ẹbhana z'Gilead kw'ode obhon kwabẹ oyenẹ kw'uwa Mosẹs ọnang bẹ otor k'ọgbaakadik kw'Ọvaar Ibinọkpaabyi.<verse eid="JOS 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 22:10" />K'ogbe kw'mapyirẹ z'Gelilot, za ch'ọnyọm Jọrdan, z'izek s'Kenaan, efona ch'Reubẹn, ọmaana ch'Gad, ọttara igboka janẹ s'efona ch'Manasẹ, ittima ija-byi s'ikem ẹbara, nya ch'ọnyọm Jọrdan. <verse eid="JOS 22:10" /><verse number="11" style="v" sid="JOS 22:11" />K'ogbe kw'anọng p'Israẹl abhaang bẹ́, mfona njo kk'ija-byi ittima z'enem ch'Kenaan, z'Gelilot kw'ọnyọm Jọrdan, z'ẹbhaakẹ ch'anọng p'Israẹl, <verse eid="JOS 22:11" /><verse number="12" style="v" sid="JOS 22:12" />anọng p'Israẹl abina obhon kibungọ, mattonga z'Shilọ bẹ́, marima bẹ ábẹ̀.<verse eid="JOS 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 22:13" />Minna kw'anọng p'Israẹl atọhmọ Phinẹhas kw'ode nnwa kw'Eleazar kw'ode ọfọhn-ẹja z'ẹkọma ch'Gilead bẹ́, okebha anọng p'Reubẹn, ọmaana p'Gad, ọttara igboka janẹ s'efona ch'Manasẹ. <verse eid="JOS 22:13" /><verse number="14" style="v" sid="JOS 22:14" />Anọng p'uwa mator-ẹ ny'ozenga nwo ade asonọng ijobh p'abin k'efona ọmaana echimma kpenamkpen ch'Israẹl.<verse eid="JOS 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 22:15" />K'ogbe kw'mapyirẹ z'ẹkọma ch'Gilead, makebha anọng p'Reubẹn, ọmaana p'Gad, ọttara igboka janẹ s'efona ch'Manasẹ, maben bẹ bẹ́, <verse eid="JOS 22:15" /><verse number="16" style="v" sid="JOS 22:16" />“Anọng p'Ọvaar Ibinọkpaabyi kibungọ abenẹ bẹ́, ‘Kayen kw'malukọ Ibinọkpaabyi kw'Israẹl m'edense nda, m'ọdọk kẹ kakpobh? Kayen kw'makpa nnam abọr-ẹ, matera attima ija-byi sabọnga s'matim alukọ Ọvaar Ibinọkpaabyi o? <verse eid="JOS 22:16" /><verse number="17" style="v" sid="JOS 22:17" />Ma, mpyibha s'iwa mosi z'Peor, itim isaabha o? Maa, pyirẹ m'ewu ch'menda, m'mpyibha njo m'amina k'ifor otim ogbobha, chibhẹ ch'iwa itim itama ikwu k'ikpakaana s'anọng p'Ọvaar Ibinọkpaabyi! <verse eid="JOS 22:17" /><verse number="18" style="v" sid="JOS 22:18" />Ma, bọnga mmin'akpa nnam abọra Ọvaar Ibinọkpaabyi o?</para>
  <para style="p" vid="JOS 22:18">“ ‘Ó̱de bọ́nga makpa nnam abọra Ọvaar Ibinọkpaabyi m'ewu ch'menda, ophyinẹ kẹ m'ọdọk-ẹ ọmaana anọng p'Israẹl kibungọ.<verse eid="JOS 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 22:19" />Ó̱de izek sabọnga s'mayen ikk'ikibha, màjeka kwuna k'izek s'Ọvaar Ibinọkpaabyi, ka ch'iruk-byi, ining, mfha mọtọn oruk m'izek nja. Kojibhẹ bẹ́, mattima ija-byi sabọnga k'ifor s'mm'atima ayoma mina ọmaana Ọvaar Ibinọkpaabyi k'isung. M'ija-byi ọdọk-ọdọk kattima, kw'ọkpanẹ ija-byi s'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwamina. <verse eid="JOS 22:19" /><verse number="20" style="v" sid="JOS 22:20" />K'ogbe kw'Akan kw'ode nnwa kw'Zera opinẹ ọmaana ekpo py'Ibinọkpaabyi, wa ikpakaana s'Israẹl maphyir itọk irem s'ottempyibha kw'Ibinọkpaabyi. Wa kẹ-kẹ kope k'mpyibha sẹ.’ ”<verse eid="JOS 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 22:21" />Nya o, anọng p'Reubẹn, ọmaana p'Gad, ọttara igboka janẹ s'efona ch'Manasẹ, mapọhna asogbọhkọnọng p'mfona s'Israẹl bẹ́, <verse eid="JOS 22:21" /><verse number="22" style="v" sid="JOS 22:22" />“Ibinọkpaabyi nwo mawanẹ kw'ẹfa, kw'ode Ọvaar Ibinọkpaabyi! Ibinọkpaabyi nwo mawanẹ kw'ẹfa, kw'ode Ọvaar Ibinọkpaabyi! Ozong ma! Tte Israẹl obir ozonga! Ó̱de mina m'obe idungsẹ ọmaana Ọvaar Ibinọkpaabyi, mobir ọmyaan-ẹ, m'mina kayobh m'ewu ch'menda. <verse eid="JOS 22:22" /><verse number="23" style="v" sid="JOS 22:23" />Ó̱de mina m'ottim ija-byi samina k'ifor bẹ́, m'otima ọkpa nnam ọbọra Ọvaar Ibinọkpaabyi, m'obir otima ija-byi njo ọfọhnọ nja s'ẹkwọmọ, ọmaana s'akpomọma, wanẹma, s'ẹforgbaka, tte Ọvaar Ibinọkpaabyi ozeng mmo oyerẹ mina aponga.<verse eid="JOS 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 22:24" />“Mma e! Mosi minna okurọ ojora bẹ́, kwuna ewu danẹ, iva p'iva aning ch'abenẹ mina bẹ́, ‘Bọng-ọttọhk vọ ọmyẹ bọnga ọmaana Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl o? <verse eid="JOS 22:24" /><verse number="25" style="v" sid="JOS 22:25" />Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi, kk'Jọrdan otima oke enem ch'mina, ọmaana bọnga p'made anọng p'Reubẹn ọmaana anọng p'Gad. M'okebh kpenamkpen kayen k'Ọvaar Ibinọkpaabyi.’ Ofona nya, iva p'iva pabọnga m'awọhkọ iva p'iva pamina, maning Ọvaar Ibinọkpaabyi akpobh.<verse eid="JOS 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 22:26" />“Nya wọ osi moben bẹ́, ‘Tte mottima ija-byi s'nna ẹja ch'ẹkwọmọ, ọmaana nja njoza mọfọhnọ.’ <verse eid="JOS 22:26" /><verse number="27" style="v" sid="JOS 22:27" />K'eden ndoza, oter ode nttẹsẹ kw'bọnga ọmaana mina, ọmaana ipemaanitor bẹ́, mina mm'otima nnanga samina s'ẹkwọmọ, ọmaana nja, ọttara nnanga s'ẹkwọmọ, okwu okpobha Ọvaar Ibinọkpaabyi m'ibyi s'awuriji. Z'ogbe ororo, iva p'iva pabọnga m'ọdọk ayok pamina maben bẹ́, ‘Bọnga m'okebh k'Ọvaar Ibinọkpaabyi kayen.’<verse eid="JOS 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 22:28" />“Minna kw'mobenẹ bẹ́, ‘Ó̱de íkwuna mabọbh mina, wanẹma, mabọbh iva p'iva pamina, mm'ọpọhna bẹ́, ‘Makirẹ okerim kw'ija-byi s'Ọvaar Ibinọkpaabyi s'ab'ttatta pamina mattim asok k'nnanga s'ẹkwọmọ, ọmaana nja ofufọhnọ. Jẹ jọ ide nttẹsẹ kwabọnga ọmaana mina.’<verse eid="JOS 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 22:29" />“Ọttọhk kode f'im'osi mina mọmyaana Ọvaar Ibinọkpaabyi, mobir ọkpa nnam ọbọr-ẹ m'ewu ch'menda, pira mosi ija-byi s'ẹja ch'ẹkwọmọ, ọmaana nnanga s'akpomọma, ọmaana nja njoza, kw'ọkpanẹ ija-byi s'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwamina s'ining m'iruk-byi sẹ.”<verse eid="JOS 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 22:30" />K'ogbe kw'Phinẹhas kw'ode ọfọhn-ẹja, ọmaana asonọng p'abaabh ẹkọma ndo, ọttara aso p'nchimma s'Israẹl ibhaang odik kw'Reubẹn ọmaana Gad, ọttara Manasẹ magbaakẹ, ettem ẹdaam bẹ. <verse eid="JOS 22:30" /><verse number="31" style="v" sid="JOS 22:31" />Phinẹhas kw'ode nnwa kw'Eleazar, obir ode ọfọhn-ẹja, oben Reubẹn, ọmaana Gad, ọttara Manasẹ bẹ́, “Menda nkk'ozonga bẹ́, Ọvaar Ibinọkpaabyi oning ma ọmaana mina, okurọ bẹ́, m'odik nwa, bọnga m'nnam kakpa abọr-ẹ. Ofona nya, bọnga nkk'anọng p'Israẹl arọhbha k'mbọhk s'Ọvaar Ibinọkpaabyi.”<verse eid="JOS 22:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 22:32" />Nya o, Phinẹhas kw'ode nnwa kw'Eleazar, obir ode ọfọhn-ẹja, ọmaana asonọng mbo, mabina arik anọng p'Reubẹn, ọmaana p'Gad z'Gilead ny'etobha ndo, makpa nnam z'Kenaan, mad-atek anọng p'Israẹl odik nwo. <verse eid="JOS 22:32" /><verse number="33" style="v" sid="JOS 22:33" />Wa nttem idaam bẹ ch'mabhaang ẹkkaabha ndo, matọhnga Ibinọkpaabyi. Makpa nnam abọra ochibhẹ kw'mm'atima egbong adimẹ ẹkọma ch'anọng p'Reubẹn ọmaana Gad.<verse eid="JOS 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 22:34" />Anọng p'Reubẹn ọmaana p'Gad mayerẹ ija-byi njo bẹ́, “Nttẹsẹ kw'mina ọmaana bọnga bẹ́, Ọvaar Ibinọkpaabyi wọ ode Ibinọkpaabyi.”<verse eid="JOS 22:34" /></para>
  <chapter eid="JOS 22" />
  <chapter number="23" style="c" sid="JOS 23" />
  <para style="s1">Ikpongannamdik s'Joshua ọgbaakẹ ọnang aso p'Israẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1" />K'ogbe kw'uwa Ọvaar Ibinọkpaabyi ikk'anọng p'Israẹl ẹmẹm ọnanga k'awawunanọng maphyir p'akọbh bẹ ọkọbha, ny'ogbe nwo kw'uwa Joshua ikk'ọtama mawuriji, <verse eid="JOS 23:1" /><verse number="2" style="v" sid="JOS 23:2" />Joshua owon ọkwa kw'anọng p'Israẹl, ọmaana asonọng, ọmaana abaabh pabẹ, ọmaana akpaar-aponga, ọttara adukwa, oben bẹ bẹ́, “Kaam kk'ntama mawuriji. <verse eid="JOS 23:2" /><verse number="3" style="v" sid="JOS 23:3" />Bọnga oyenẹ nkk'ọttọhk kpenamkpen aza f'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga ikk'ọsa ọnang nkọma nja maphyir okurọ bọnga. Ọvaar Ibinọkpaabyi wọ uwa orim erima chabọnga. <verse eid="JOS 23:3" /><verse number="4" style="v" sid="JOS 23:4" />Màjima ose kw'izek nkebha nnang nkọma njo s'iwa irikẹ maa, ozeng k'nkọma s'iwa ntim egbong ntọka ny'njeka kw'Jọrdan, ọmaana Meditereniya, z'ẹbhaakẹ ch'ewuchen ed-edimẹ. <verse eid="JOS 23:4" /><verse number="5" style="v" sid="JOS 23:5" />Ọvaar Ibinọkpaabyi oyenẹ kw'ode Ibinọkpaabyi kwabọnga, m'ozeng mmo, okwubh bẹ okurọ bọnga. M'okwubh bẹ ny'abọnga k'ititika, mfha bọnga mad-atọka izek sabẹ k'ẹfa, k'ose kw'Ọvaar Ibinọkpaabyi ochekẹ ọnang bọnga.<verse eid="JOS 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 23:6" />“Màgaangẹ ifor, màkonga k'ose kw'mm'akpobha okpenamkpen f'makkẹrẹ ny'Nnwẹr kw'asana p'Mosẹs. M'eden kpenamkpen kàtena o! <verse eid="JOS 23:6" /><verse number="7" style="v" sid="JOS 23:7" />M'ẹgbaka kpenamkpen kàyena amaana anọng p'arikẹ ny'ottem kwabọnga. M'ache p'aka pabẹ kàyerẹ o, m'ache p'aka pabẹ kabir achekẹ o. M'aka mbo, kàkpobha, m'eso kabir araka anang bẹ. <verse eid="JOS 23:7" /><verse number="8" style="v" sid="JOS 23:8" />Okenaka, bọnga mm'abọka Ọvaar Ibinọkpaabyi kwabọnga k'ẹbọhk-gaangẹ, k'ose kw'nkk'asa maa, pyirẹ ma.<verse eid="JOS 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 23:9" />“Pira bọnga mapyirẹ ma, Ọvaar Ibinọkpaabyi kk'nkọma s'igaang-ọgaangẹ, ibir iyena ẹfa, okwubha. Maa, pyirẹ m'ewu ch'menda, ọnọng kode kw'okpo orima bọnga ábẹ̀. <verse eid="JOS 23:9" /><verse number="10" style="v" sid="JOS 23:10" />Ọnọng od-okpo anọng nnọhna mfa okwuma arọbh ijobh okema, okurọ bẹ́, Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga, kẹ wọ od-osi erima chabọnga k'ose kw'ọnwọhngọ. <verse eid="JOS 23:10" /><verse number="11" style="v" sid="JOS 23:11" />Ofona nya, màtọka ogbe yena ọdaakẹ maana Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabọnga.<verse eid="JOS 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 23:12" />“Okenaka, óde makpa nnam abọr-ẹ, magbaka ifor amaana anọng p'nkọma nja s'irikẹ ny'ottem kwabọnga, óde masi ọbada amaana bẹ, makwu azenga ẹkaan madanẹ. <verse eid="JOS 23:12" /><verse number="13" style="v" sid="JOS 23:13" />Màzonga bẹ́, Ọvaar Ibinọkpaabyi ọdọk nkọma njo mokwubh ny'ititika sabọnga. Nna akkerẹ, nkọma njo m'itera ikwu ide amma p'mm'abọka bọnga, ọmaana ayaangẹ p'mm'asi bọnga abhaak k'nnam, ọttara nchi s'im'ilukọ bọnga achen. Minna kw'mm'atọka irem njo maa, madimẹ eche m'izek ọkkọkka nja s'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga, ikk'bọnga ọnanga.<verse eid="JOS 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 23:14" />“Madidanma, kaam min'ntte iyagbin ọbọhk. Bọnga maphyir mazong z'nttem sabọnga ọmaana z'agbagba pabọnga bẹ́, ny'nchekẹ ọkkọkka njo s'Ọvaar Ibinọkpaabyi ọnang bọnga maphyir, madanẹ ch'etun-otuna kede. Nchekẹ njo maphyir, iyinẹ mbengana. Madanẹ ch'etun-otuna, kede. <verse eid="JOS 23:14" /><verse number="15" style="v" sid="JOS 23:15" />Okenaka, k'ose kw'idik ọkkọkka njo s'Ọvaar Ibinọkpaabyi ochekẹ maphyir ikk'bọnga ikebha, minna kw'im'obir otima idiktama njo maphyir s'ochekẹ, okwu ọfọra bọnga ny'ifor maa, odimẹ bọnga eche m'izek ọkkọkka nja s'ikk'bọnga ọnanga. <verse eid="JOS 23:15" /><verse number="16" style="v" sid="JOS 23:16" />Ó̱de bọnga m'avọhkọ echekẹ ch'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga, makpa nnam abọra asana pẹ p'ọnangẹ bọnga, mafona ad-akpobha aka, mabir araka nso anang aka mbo, ottempyibha kw'Ọvaar Ibinọkpaabyi m'ovura bọnga. Minna kw'bọnga mm'adimẹ eche ẹbhar-ẹbhar m'izek ọkkọkka nja s'ikk'bọnga ọnanga.<verse eid="JOS 23:16" /></para>
  <chapter eid="JOS 23" />
  <chapter number="24" style="c" sid="JOS 24" />
  <para style="s1">Anọng p'Israẹl ado echekẹ ch'masi z'Shẹkẹm</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1" />Nya o, Joshua oyerẹ mfona s'Israẹl maphyir, ittonga z'Shẹkẹm. Oyerẹ asogbọhkọnọng, ọmaana asonọng, ọmaana akpaar-aponga, ọttara adukwa p'Israẹl. Bẹ maphyir makwu abe k'ititika s'Ibinọkpaabyi.<verse eid="JOS 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 24:2" />Joshua oben anọng mbo maphyir bẹ́, “Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl obenẹ bẹ́, ‘Wa k'ẹtama, ab'ttatta pabọnga, ozeng k'Tera kw'obhonọ Abraham ọmaana Nahọr, marukọ za ch'ikk'Yupharetes akpana, makpobha aka ọdọk-ọdọk. <verse eid="JOS 24:2" /><verse number="3" style="v" sid="JOS 24:3" />Kaam o, nkwu nrọhbha Abraham kw'ode atte kwabọnga z'izek s'ikk'Yupharetes akpana, ntim-ẹ nzenga ny'Kenaan maphyir, nnang-ẹ iva k'ọsaabh, ọmaana iva p'iva, mbir nnang-ẹ Isaak. <verse eid="JOS 24:3" /><verse number="4" style="v" sid="JOS 24:4" />Nzenga ny'Isaak, nnang-ẹ Jekọb ọmaana Esau. Ntọka ẹkọma ch'Seir ch'ening z'agbe, nnang Esau. Jekọb kẹ otima echimma chẹ ochina z'Ijip.<verse eid="JOS 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 24:5" />“Minna kw'ntọhmọ Mosẹs ọmaana Aarọn z'Ijip, ntima ọttọhk f'nsi z'Ijip, nyak ọbọhk ntte itama ivura anọng p'Ijip, pira n'ntim bọnga nyin k'iyaan. <verse eid="JOS 24:5" /><verse number="6" style="v" sid="JOS 24:6" />K'ogbe kw'ntim anọng pabọnga mbina z'Ijip, mazenga maa, makwu apyirẹ z'ẹraanga-kora, anọng p'Ijip atima ijaar s'nnyanya id-itọr, ọmaana nnyanya<note caller="+" style="f"><char style="fr" closed="false">24.6 </char><char style="fq" closed="false">nnyanya </char><char style="ft" closed="false">anọng p'nd-ayaar nnyanya</char></note>, makwubh bẹ maa, mapyirẹ z'ẹraanga-kora. <verse eid="JOS 24:6" /><verse number="7" style="v" sid="JOS 24:7" />Mabhom akpẹkẹ Ọvaar Ibinọkpaabyi bẹ́, ọkkaana bẹ. Minna kw'Ibinọkpaabyi oke orungibanga ny'ottem kwabọnga ọmaana anọng p'Ijip, otima asi p'ọraanga ọbhọrọ bẹ, marubhọ maphyir. Bọnga oyenẹ matima achen pabọnga aze ọttọhk f'nsi anọng p'Ijip. Wa bọnga makwu aninga z'ibyi s'owora k'ogbe kw'obhir-obhir.<verse eid="JOS 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 24:8" />“Nkwu ntima bọnga nchina z'izek s'anọng p'Amọn p'aning z'Jọrdan, z'ẹbhaakẹ ch'ewuchen ed-eyin. Marima bọnga ábẹ̀, ntọka bẹ nke bọnga k'mbọhk. Mfhọ bẹ ny'abọnga k'ititika, pira n'ntte bọnga ọbọhk, matọka izek sabẹ ayena. <verse eid="JOS 24:8" /><verse number="9" style="v" sid="JOS 24:9" />K'ogbe kw'Balak kw'ode nnwa kw'Zipor kw'ode ọvaarnọng kw'Moab odo ifor bẹ́, orima Israẹl ábẹ̀, ọtọhm bẹ́, mayerẹ Balaam kw'ode nnwa kw'Beor okwu ọnang bọnga ẹmma. <verse eid="JOS 24:9" /><verse number="10" style="v" sid="JOS 24:10" />Okenaka, Balaam itọhng kìnyong. Oter od-odo bọnga ọttar-ọttara. Ny'eden ndo, nkkaana bọnga k'mbọhk sẹ.<verse eid="JOS 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 24:11" />“K'ogbe kw'majek Ọraanga kw'Jọrdan makwu apyirẹ Jẹriko, anọng p'Jẹriko arima bọnga ábẹ̀ mach'anọng p'Amọr, ọmaana p'Periz, ọmaana p'Kenaan, ọmaana p'Het, ọmaana p'Girgash, ọmaana p'Hiv ọttara p'Jebus. Wa nkema mgbong njo maphyir, nnang bọnga. <verse eid="JOS 24:11" /><verse number="12" style="v" sid="JOS 24:12" />Nkwu ntọhm agurubhebhe bẹ́, machi bọnga eden mad-akwubh avaar afa p'Amọr. Akkangkkang ọmaana ayuk ọttara abufhọ pabọnga azang akem egbong ndo anang bọnga. <verse eid="JOS 24:12" /><verse number="13" style="v" sid="JOS 24:13" />Nkwu ntọka izek s'nna ọtọhm nya asi, nnang bọnga. Mbir ntọka ibhon s'bọnga nna mbọhk sabọnga atim asi, kw'ode ibhon s'marukọ maa, pyirẹ ma. Nnang bọnga iwonọ s'grep ọmaana s'oliv s'nna atubhọ bẹ́, machi.’<verse eid="JOS 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 24:14" />“Ofona nya, màtte Ọvaar Ibinọkpaabyi ojora bọnga, màbir kpobh-ẹ k'odik ọkkọkka. Màbharẹ aka p'ab'ttatta pabọnga akpobh z'okwubha kw'Ọraanga kw'Yupharetes ọmaana z'Ijip. Màkpobha Ọvaar Ibinọkpaabyi. <verse eid="JOS 24:14" /><verse number="15" style="v" sid="JOS 24:15" />Okenaka, óde Ibinọkpaabyi okpukpobha ina bọnga ọdaakẹ, màteka ọnọng kw'mm'akpobha menda nwa, zaa ode aka p'ab'ttatta pabọnga makpobh z'okwubha kw'Ọraanga kw'Yupharetes, wanẹma, aka p'anọng p'Amọr p'bọnga marukọ z'izek sabẹ. Ṉ́nòde kaam ọmaana ẹsọhmmọr chaam, mm'okpobha Ọvaar Ibinọkpaabyi.”<verse eid="JOS 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 24:16" />Nya o, anọng mbo apọhna bẹ́, “Tọm-tọm kponga za! M'Ọvaar Ibinọkpaabyi mòbhum, mokpobha aka! <verse eid="JOS 24:16" /><verse number="17" style="v" sid="JOS 24:17" />Ọvaar Ibinọkpaabyi wọ uwa otim mina ọmaana ab'ttatta pamina obina z'Ijip, ny'izek njo s'iwa moning k'ebira, osi adikdim mbo p'akkonọ ọnọng okkonọ ny'amina k'ititika. Ny'ozenga kwamina kw'mosi maphyir, kẹ wọ okkerẹ mina z'eden, obira ọkaam mina ny'nkọma s'mojek maphyir. <verse eid="JOS 24:17" /><verse number="18" style="v" sid="JOS 24:18" />Kẹ Ọvaar Ibinọkpaabyi nwo wọ okwubhọ nkọma maphyir ny'ititika samina, maa, ozeng k'anọng p'Amọr p'uwa marukọ ny'izek njo. Mina mm'obira okpobha Ọvaar Ibinọkpaabyi ọdọk, okurọ bẹ́, kẹ wọ ode Ibinọkpaabyi kwamina.”<verse eid="JOS 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 24:19" />Joshua oben anọng mbo bẹ́, “Bọnga m'Ọvaar Ibinọkpaabyi makpo akpobha, okurọ bẹ́, kẹ ode Ibinọkpaabyi kw'Owur-owur, obir ode Ibinọkpaabyi kw'oyen ottemma k'anọng p'akpobh aka. Kẹ bọnga mobina ọnang k'osogaangẹ, ọmaana mpyibha sabọnga. <verse eid="JOS 24:19" /><verse number="20" style="v" sid="JOS 24:20" />Ó̱de mabhumọ Ọvaar Ibinọkpaabyi, matera akpobha aka p'nkọma ọdọk-ọdọk, zaabẹ wa kẹ kk'ejibha ọsa ọnang bọnga k'ochedengbe, kẹ m'ọkpa nnam ọbọra bọnga, obira osi bọnga itama, pira odimẹ bọnga eche.”<verse eid="JOS 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 24:21" />Wa anọng mbo mapọhna Joshua bẹ́, “Mma! Mina mm'okpobha Ọvaar Ibinọkpaabyi.”<verse eid="JOS 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 24:22" />Joshua oben bẹ bẹ́, “Bọnga mabhakẹ abe anttẹsẹ pabọnga k'ifor bẹ́, bọnga nkk'achera bẹ́, mm'akpobha Ọvaar Ibinọkpaabyi.”</para>
  <para style="p" vid="JOS 24:22">Mapọhna bẹ́, “Iye, mina bọ mode anttẹsẹ pamina.”<verse eid="JOS 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 24:23" />Joshua nobenẹ bẹ bẹ́, “Ch'inode minna, màbharẹ aka mbo p'nkọma ọdọk-ọdọk p'aning ny'abọnga k'ottem, matte nttem sabọnga ọbọhk anang Ọvaar Ibinọkpaabyi, kw'ode Ọvaar Ibinọkpaabyi kw'Israẹl.”<verse eid="JOS 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 24:24" />Anọng mbo aben Joshua bẹ́, “Mina mm'okpobha Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwamina, mobir ọraka nso, ọnang-ẹ.”<verse eid="JOS 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 24:25" />Ny'ewu ndo, Joshua odim k'echekẹ k'anọng mbo k'eso z'Shẹkẹm, obira ojima bẹ asana ọmaana apaanga p'mm'akpobha. <verse eid="JOS 24:25" /><verse number="26" style="v" sid="JOS 24:26" />Joshua ọkkẹr idik nja maphyir z'Nnwẹr kw'Asana p'Ibinọkpaabyi. Pira ọtọka ẹtakpa, ottima ny'orin kw'oak, nya ch'ọnyọm ibyi s'Ọvaar Ibinọkpaabyi s'iwur-owur.<verse eid="JOS 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 24:27" />Oben bẹ maphyir bẹ́, “Màze e, ẹta nda m'ede nttẹsẹ kwamina. Ẹta nda kk'idik maphyir s'Ọvaar Ibinọkpaabyi ọgbaakẹ ọnang mina, ẹbhaanga. Ó̱de nna Ibinọkpaabyi k'ọkkọkka atorọ, ẹta ndo m'ede nttẹsẹ k'itama sabọnga.”<verse eid="JOS 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 24:28" />Nya o, Joshua offurọ bẹ. Ọnọng-ọnọng ọbhana z'izek s'ide okebh fẹ.<verse eid="JOS 24:28" /></para>
  <para style="s1">Obo ọmaana ẹnọhnga ch'Joshua</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 24:29" />K'ogbe kw'idik nja maphyir ikk'iyina, Joshua kw'ode nnwa kw'Nun, obira ode ọtọhmnọng kw'Ọvaar Ibinọkpaabyi, okwu ope ch'inode icho arọbh achen okwuma ijobh. <verse eid="JOS 24:29" /><verse number="30" style="v" sid="JOS 24:30" />Manọhng-ẹ z'izek sẹ z'Timnat-Sera, z'ẹkọma ch'Ephraim ch'egbe, z'ebir-ebir kw'egbe ch'Gaash.<verse eid="JOS 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 24:31" />Anọng p'Israẹl akpobha Ọvaar Ibinọkpaabyi ny'ogbe nwo maphyir kw'Joshua oruk akpen, ọmaana ny'ogbe kw'asogbọhkọnọng p'ayọhng-ẹ k'icho, p'ade mbo p'aze idik maphyir s'Ọvaar Ibinọkpaabyi ikk'ọsa, ọnang bẹ.<verse eid="JOS 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 24:32" />Akọbhọ p'Josẹph p'uwa anọng p'Israẹl matim abina z'Ijip, manọhnga bẹ ny'Shẹkẹm, ny'izek s'iwa Josẹph odebhẹ k'mbọhk s'iva p'Hamọr kw'ode otte kw'Shẹkẹm, k'asilva arọbh achen. Izek njo jọ ina ikwu ide okebh f'iva p'iva p'Josẹph.<verse eid="JOS 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 24:33" />Eleazar kw'ode nnwa kw'Aarọn okwu ope, manọhng-ẹ z'Gibea kw'uwa makebhẹ anang Phinẹhas kw'ode nnwa kwẹ, z'ẹkọma ch'Ephraim ch'ening k'egbe.<verse eid="JOS 24:33" /></para>
  <chapter eid="JOS 24" />
</usx>