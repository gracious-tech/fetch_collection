<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Mbembe Adun [mfn]</book>
  <para style="h">Hosea</para>
  <para style="toc3" />
  <para style="toc2">Hosea</para>
  <para style="rem" />
  <para style="h" />
  <para style="toc1">Nnwẹr kw'Hosea</para>
  <para style="mt1">Hosea</para>
  <para style="imt" />
  <para style="im">Hosea kw'ode ọgbaak-ettem ch'Ibinọkpaabyi ọgbaakẹ odik ọnang anọng p'Israẹl p'aning z'ebir-ebir k'ogbe kw'maning k'adama k'ogbe kw'ikk'icho nnọhna mfa ọkpana. K'ogbe kw'Jeroboam ttong afa ikk'ọpa o, Israẹl okwu oyena avaar achadanẹ k'icho s'ikpanẹ ẹrọbh. Wa avaar ana mafhọ bẹ ọfhọ, ayok mboza p'akpongannam, marọhbha bẹ ọrọhbha k'ẹfa ọr m'ana bẹ ẹvaar k'ẹfaorm'ana bẹ ẹvaar ọna.</para>
  <para style="ip" />
  <para style="ip" />
  <para style="ie" />
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />Ma wọ ode ọgbaakadik kw'Ọvaar Ibinọkpaabyi ọgbaak Hosea kw'ode nnwa kw'Beeri, k'ogbe kw'uwa Uziya, ọmaana Jotam, ọmaana Ahaz, ọttara Hezekiya nkk'Juda abaabha. Ny'ogbe nwo wọ kw'uwa Jẹroboam kw'Jehoash obhonọ, obir ọbaabha Israẹl.<verse eid="HOS 1:1" /></para>
  <para style="s1">Ibinọkpaabyi obenẹ Hosea bẹ́, ọtọka kwanọng</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />K'ogbe kw'Ọvaar Ibinọkpaabyi ọtọm odik ogbugbaak ọnang Hosea, wa obenẹ Hosea bẹ́, “Zọhng tọka ọzaza-kwanọng k'ọbada, ọmaan-ọ iva, kirẹ k'ose kw'aponga apyibhẹ kwanọng kw'otto k'ẹfẹbhẹ, minna kw'aponga apyibhẹ ẹkọma nda k'izazadik s'masi anang Ọvaar Ibinọkpaabyi.” <verse eid="HOS 1:2" /><verse number="3" style="v" sid="HOS 1:3" />Nya o, Hosea ọtọka Goma kw'ode ominanwa kw'Diblaim k'ọbada. Goma okwu otima ibhọr, ọmaan Hosea ojinọngnwa.<verse eid="HOS 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4" />Ọvaar Ibinọkpaabyi oben Hosea bẹ́, “Kpe nnwa nwo bẹ́, Jẹzrẹl, okurọ bẹ́, ogbe mọ̀tọka, kaam m'nnang ọsọhm kw'Jehu irem k'anọng p'uwa mafhọ z'ẹkọma ch'Jẹzrẹl. Kaam m'mbira mkpọka ẹvaar ch'ẹkọma ch'Israẹl. <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />Ny'ewu ndo, kaam m'nsi ẹfa ch'anọng p'Israẹl ẹsa z'ilokodo s'Jẹzrẹl.”<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />Goma obira otima ibhọr, ọmaan kwanọngnwa. Ọvaar Ibinọkpaabyi oben Hosea bẹ́, “Kpe kwanọngnwa nwo bẹ́, Lo-Ruhama (kw'oyinẹ bẹ́, “ọnọng kọdaakẹ”), kirẹ kaam ọdọk ọdaakẹ mìnyena mmaana anọng p'Israẹl maphyir-phyir k'ose kw'úwúra mbin nnang bẹ. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />Okenaka, kaam m'nkọhka anọng p'Juda ọdaakẹ, mbira nkkaana bẹ. Oyuk azang kw'm'ntima nkkaana bẹ́, ọkkangkkang azang, egbong azang, nnyanya ọmaana ayaar-nnyanya mìmbira ntima. Okenaka, kaam Ọvaar Ibinọkpaabyi, kw'nde Ibinọkpaabyi kwabẹ, m'nkkaana bẹ.”<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />K'ogbe kw'ikk'Lo-Ruhama okwura, Goma obira otima ibhọr, ọmaan ojinọngnwa. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />Ọvaar Ibinọkpaabyi oben Hosea bẹ́, “Kpẹ-ẹ bẹ́, Lo-Ammi (kw'oyinẹ bẹ́, “anọng paam azang”), kirẹ bọnga m'anọng paam kade, kaam Ibinọkpaabyi kwabọnga kìmbir nde.<verse eid="HOS 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10" />“Okenaka, kwuna anọng p'Israẹl m'asaabh mach'ofong kw'ẹraangaka kw'ina eyoma ode, ebhika kobir ode. Ny'ibyi njo s'iwa mabenẹ bẹ bẹ́, ‘Bọnga m'anọng paam kade,’ nya kw'mm'ayerẹ bẹ bẹ́, ‘Iva p'Ibinọkpaabyi kw'orukọ akpen.’ <verse eid="HOS 1:10" /><verse number="11" style="v" sid="HOS 1:11" />Anọng p'Juda ọttara p'Israẹl mm'akwu agbaka. Bẹ mm'atéka osonọng mawanẹ, mabir abina ny'izek njo, kirẹ, ewu ch'Jẹzrẹl, m'ede ewu chiden.<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1" />“Màyerẹ ivotte pabọnga p'ejinọng bẹ́, ‘Anọng paam,’ mayerẹ ivotte pabọnga p'panọng bẹ́, ‘Adaakẹ-nọng paam.’<verse eid="HOS 2:1" /></para>
  <para style="s1">Manangẹ Israẹl irem mabira azẹ-ẹ okwo</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2" />“Màgbaak odik nang akka kwabọnga, màgbaak odik nang-ẹ,</para>
  <para style="q2" vid="HOS 2:2">kirẹ kẹ kwanọng kwaam kode,</para>
  <para style="q2" vid="HOS 2:2">kaam odim kwẹ kimbir nde.</para>
  <para style="q1" vid="HOS 2:2">Tte ọkpọka ikkikkerẹ s'ọzaza,</para>
  <para style="q2" vid="HOS 2:2">ọttara izazadik s'od-otima aba pẹ osi.<verse eid="HOS 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3" />Ina minna ode, kaam m'nwọr-ẹ ekpo, okwu otima erinikwum,</para>
  <para style="q2" vid="HOS 2:3">kaam m'njanẹ erinikwum chẹ k'iyaan k'ose kw'uwa mamaan-ẹ;</para>
  <para style="q1" vid="HOS 2:3">kaam m'nsẹ-ẹ ode mach'izek s'anọng nnarukọ,</para>
  <para style="q2" vid="HOS 2:3">m'mbhak-ẹ okwu ode mach'izek s'ina ekpo ed-ejibh,</para>
  <para style="q2" vid="HOS 2:3">m'mbira ntima esi-daaka mfhẹ-ẹ.<verse eid="HOS 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4" />Kaam iva pẹ ọdaakẹ kwaam mìnkọhka,</para>
  <para style="q2" vid="HOS 2:4">okurọ bẹ́, mamaanẹ bẹ k'ẹzaza.<verse eid="HOS 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5" />Ọkka kwabẹ ode ọzaza,</para>
  <para style="q2" vid="HOS 2:5">obira otima ibhọr sabẹ k'eden ch'ina ikpukpobha iyen.</para>
  <para style="q1" vid="HOS 2:5">Oben bẹ́, ‘Kaam m'ntor adaakẹ-nọng paam,</para>
  <para style="q2" vid="HOS 2:5">p'mad-anang-m ọchattọhk ọttara asi,</para>
  <para style="q2" vid="HOS 2:5">ọmaana owu, ọmaana ọbara-wurọ, ọmaana ana p'oliv, ọttara atuk.’<verse eid="HOS 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6" />Ofona nya o, kaam m'ntima akkaangẹ, mkpa ọbhaang kw'kwanọng nwa;</para>
  <para style="q2" vid="HOS 2:6">kaam m'ntima etumọ mkpẹ-ẹ z'ẹtaanga, ọfha oning eden ozong.<verse eid="HOS 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7" />Kẹ kwanọng nwo m'okwubh adaakẹ-nọng pẹ p'ejinọng, okenaka, bẹ mokebha;</para>
  <para style="q2" vid="HOS 2:7">kẹ m'oror bẹ, okenaka, bẹ moze.</para>
  <para style="q1" vid="HOS 2:7">Nya wọ kw'kẹ m'oben bẹ́,</para>
  <para style="q2" vid="HOS 2:7">‘Kaam m'mkpa nnam z'odim kwaam kw'echeden,</para>
  <para style="q2" vid="HOS 2:7">kirẹ za kw'uwa ojibhẹ ọtam ọnang-m, ọyọhnga ma.’<verse eid="HOS 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8" />Kẹ kojim bẹ́, kaam wọ nde nwo</para>
  <para style="q2" vid="HOS 2:8">kw'uwa nnang-ẹ akpomọma mbo, ọmaana abhatuk, ọttara ana,</para>
  <para style="q1" vid="HOS 2:8">mbir nde nwo kw'uwa nnang-ẹ silva ọmaana gol k'ọsaabh</para>
  <para style="q2" vid="HOS 2:8">kw'uwa matim akpobha ọka f'Baal.<verse eid="HOS 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9" />“Ofona nya o, kaam m'ntọka akpomọma paam k'ogbe kw'ikk'ẹttama,</para>
  <para style="q2" vid="HOS 2:9">m'mbira ntọka abhatuk paam k'ogbe kw'nkk'pẹ apa.</para>
  <para style="q1" vid="HOS 2:9">Kaam m'mkpa nnam ntọka owu ọttara ọbara-wurọ kwaam,</para>
  <para style="q2" vid="HOS 2:9">kw'uwura obubh-ẹ erinikwum.<verse eid="HOS 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10" />Kaam m'nyaakẹ erinikwum chẹ</para>
  <para style="q2" vid="HOS 2:10">ny'ititika s'adaakẹ-nọng pẹ;</para>
  <para style="q2" vid="HOS 2:10">ọnọng mawanẹ-wanẹ kode kw'im'ọkpẹ-ẹ ọkkaana k'mbọhk saam.<verse eid="HOS 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11" />Kaam m'mkpọka odidaama kwẹ maphyir;</para>
  <para style="q2" vid="HOS 2:11">ọmaana ididaamawu sẹ s'icho kpenamkpen, ọttara ididaamawu sẹ s'aphe abhapẹ,</para>
  <para style="q2" vid="HOS 2:11">mbir mkpọka iwọhngkwokawu s'ide ididaamawu sẹ maphyir.<verse eid="HOS 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12" />Kaam m'nkibhẹ iwonọ sẹ s'grep, ọttara nchi sẹ s'fig,</para>
  <para style="q2" vid="HOS 2:12">s'obenẹ bẹ́, jẹ jọ ide ẹphya ch'adaakẹ-nọng pẹ manang-ẹ;</para>
  <para style="q1" vid="HOS 2:12">Kaam m'nsi iwonọ njo sẹ s'grep, ọttara nchi sẹ s'fig ibhakẹ ẹdabhẹ,</para>
  <para style="q2" vid="HOS 2:12">mgbaten m'ibira ikibhẹ jẹ.<verse eid="HOS 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13" />Ọvaar Ibinọkpaabyi kk'ọgbaaka bẹ́,</para>
  <para style="q2" vid="HOS 2:13">Kaam m'nnang-ẹ irem ny'iwu njo;</para>
  <para style="q1" vid="HOS 2:13">s'ọkwọmọ insẹns ọnang ọka f'Baal;</para>
  <para style="q2" vid="HOS 2:13">osi ẹnya ch'oke mbaanga ọttara ekpo py'ẹdọngọ,</para>
  <para style="q2" vid="HOS 2:13">otima oyin ẹzaza z'adaakẹ-nọng pẹ,</para>
  <para style="q4" vid="HOS 2:13">okenaka, ọzaama kaam.”<verse eid="HOS 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14" />“Ofona nya, kaam m'ndaabh-ẹ;</para>
  <para style="q2" vid="HOS 2:14">ntim-ẹ nzeng z'ibyi s'anọng nna arukọ</para>
  <para style="q2" vid="HOS 2:14">mbira mgbaak odik k'ẹmmakpa ch'izek-izek, nnang-ẹ.<verse eid="HOS 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15" />Za wọ kw'm'mkpa nnam ntte iwonọ sẹ s'grep ọbọhk, nnang-ẹ,</para>
  <para style="q2" vid="HOS 2:15">Kaam m'nsi ilokodo s'Akọr ide ọmma kwẹ kw'ichen osisok.</para>
  <para style="q1" vid="HOS 2:15">Za wọ kw'im'ọbhaang-m odik mach'ogbe kw'uwa ode ominanwa,</para>
  <para style="q2" vid="HOS 2:15">mach'ewu ndo ch'iwa obin z'Ijip.<verse eid="HOS 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16" />Ọvaar Ibinọkpaabyi ọgbaakẹ bẹ́, “Ny'ewu ndo,</para>
  <para style="q2" vid="HOS 2:16">kọ m'ayer-m bẹ́, ‘odim kwaam’;</para>
  <para style="q2" vid="HOS 2:16">ọdọk kaam màyerẹ bẹ́, ‘atte kwaam.’<verse eid="HOS 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17" />Kaam m'nrọhbha ache p'aka p'Baal z'ẹmma chẹ;</para>
  <para style="q2" vid="HOS 2:17">ọnọng ọdọk ache pabẹ, mochekẹ.<verse eid="HOS 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18" />Ny'ewu ndo, kaam m'ntima nten s'ẹgba, ọmaana ọnọhn f'ẹrọng,</para>
  <para style="q2" vid="HOS 2:18">ọttara ekpo py'ezeng k'izek,</para>
  <para style="q2" vid="HOS 2:18">nchekẹ nnang bẹ.</para>
  <para style="q1" vid="HOS 2:18">Kaam m'mkpọka oyuk,</para>
  <para style="q2" vid="HOS 2:18">ọmaana ọkkangkkang, ọttara egbong ny'izek njo,</para>
  <para style="q2" vid="HOS 2:18">mfha anọng maphyir, maninga k'odiriji.<verse eid="HOS 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19" />Kaam m'nrọk-ọ omina ttattampe;</para>
  <para style="q2" vid="HOS 2:19">m'ntima atoriji ọmaana odik ọkkọkka nrọk-ọ omina,</para>
  <para style="q2" vid="HOS 2:19">mbir nkọhk-ọ ọdaakẹ ọttara ikwosisi.<verse eid="HOS 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20" />Kaam m'ntima atoriji, nrọk-ọ omina,</para>
  <para style="q2" vid="HOS 2:20">nya kw'kọ m'azonga Ọvaar Ibinọkpaabyi.<verse eid="HOS 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21" />Ọvaar Ibinọkpaabyi ọgbaakẹ bẹ́,</para>
  <para style="q2" vid="HOS 2:21">“Ny'ewu ndo,</para>
  <para style="q1" vid="HOS 2:21">kaam m'nnang ọrọngkpakpa ẹpọhna,</para>
  <para style="q2" vid="HOS 2:21">ọrọngkpakpa obira ọnang izek ẹpọhna;<verse eid="HOS 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22" />izek m'inang akpomọma mbo ẹpọhna,</para>
  <para style="q2" vid="HOS 2:22">abhatuk ọmaana ana p'oliv</para>
  <para style="q2" vid="HOS 2:22">mm'anang Jẹzrẹl ẹpọhna.<verse eid="HOS 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23" />Kaam m'nttim-ẹ ny'izek njo mach'ọnọng kwaam,</para>
  <para style="q2" vid="HOS 2:23">m'nkọhka ọdaakẹ kwaam ny'anọng mbo p'nyerẹ bẹ́, ‘Adaakẹ-nọng paam azang,’</para>
  <para style="q1" vid="HOS 2:23">ayok mbo p'mayerẹ bẹ́, ‘Anọng paam azang,’ kaam m'nyerẹ bẹ bẹ́, ‘Bọnga bọ made anọng paam’;</para>
  <para style="q2" vid="HOS 2:23">bẹ mm'abira aben bẹ́, ‘Kọ wọ ade Ibinọkpaabyi kwamina.’ ”<verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s1">Hosea ọgba ọmaana kwanọng kwẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />Wa Ọvaar Ibinọkpaabyi oben-m bẹ́, “Zọhng, kpa nnam z'kwanọng kwọ, abir atọma ọdaakẹ oyiyena amaan-ẹ, zaa wura ọdaakẹ ojinọng ọdọk-ọdọk, obira ode ọzaza. Tte ọdaak-ọ k'ose kw'anọng p'Israẹl madaakẹ Ọvaar Ibinọkpaabyi, zaa wura mabhakẹ ator aka, igbogbo s'matim grep kw'ogwu-ogwu asi, ibir idaak bẹ.”<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />Ofona nya o, ndebhẹ kwanọng nwo k'ashẹkẹl ichi p'silva, ọttara barli kw'im'ofu ọgbangbang kwiden, ọmaana ogbobhmbọhk. <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />Ntek-ẹ bẹ́, “Kọ m'aruk amaan-m k'iwu k'ẹkaan; kọ ọzaza màde, iyok màbir asi amaana ojinọng kpenamkpen. Minna kw'kaam m'mbir nsi mmaan-ọ.”<verse eid="HOS 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4" />Kirẹ anọng p'Israẹl m'aruk akpen k'iwu k'ẹkaan, m'ọvaarnọng màyena, m'osonọng màyena, ẹja ofufọhnọ mèninga, ata p'awur-owur màninga, ozeng k'ẹphọd, ọmaana aka p'ẹsọhmmọr, mmàyena. <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />Z'ogbe ororo, kwuna anọng p'Israẹl m'akpa nnam, maror Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabẹ, ọttara Devid kw'ode ọvaarnọng kwabẹ. Minna kw'mm'atima ifufọnọ, akwu ator Ọvaar Ibinọkpaabyi, mabira atọka ẹda chẹ k'okpongannamgbe.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s1">Ọvaar Ibinọkpaabyi oyerẹ anọng p'Israẹl aponga</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1" />Bọnga anọng p'Israẹl, màbhaanga odik kw'Ọvaar Ibinọkpaabyi,</para>
  <para style="q2" vid="HOS 4:1">okurọ bẹ́, Ọvaar Ibinọkpaabyi oyen odik kw'im'otima</para>
  <para style="q2" vid="HOS 4:1">oyerẹ bọnga aponga ny'izek njo s'marukọ:</para>
  <para style="q1" vid="HOS 4:1">“Odik ọkkọkka kode, ọdaakẹ kode,</para>
  <para style="q2" vid="HOS 4:1">ezonga ch'Ibinọkpaabyi ny'izek njo kede.<verse eid="HOS 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2" />Idik s'iter ininga ide ẹmma oninang, ọmaana afọra, ọmaana inọngfhufha,</para>
  <para style="q2" vid="HOS 4:2">ọmaana orubh ofufu, ọttara ẹzaza;</para>
  <para style="q1" vid="HOS 4:2">mabir avọhkọ asana maphyir,</para>
  <para style="q2" vid="HOS 4:2">makibhẹ izẹ k'ogbe kpenamkpen.<verse eid="HOS 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3" />Ofon nya pira izek njo igwu <char style="it">bẹ́ kẹkẹdẹ, </char></para>
  <para style="q2" vid="HOS 4:3">anọng maphyir p'arukọ nya, mape maphyir;</para>
  <para style="q1" vid="HOS 4:3">nten s'ẹgba, ọmaana ọnọhn f'ẹrọng</para>
  <para style="q2" vid="HOS 4:3">ọmaana nten s'ọraanga kwiden, ipe maphyir.<verse eid="HOS 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4" />“Okenaka, tte ọnọng mawanẹ-wanẹ oning ọnọng aponga oyerẹ,</para>
  <para style="q2" vid="HOS 4:4">tte ọnọng mawanẹ-wanẹ oning oyok odik ọnan,</para>
  <para style="q1" vid="HOS 4:4">kirẹ anọng pabọnga makerẹ ayok mbo</para>
  <para style="q2" vid="HOS 4:4">p'mad-anana ọfọhn-ẹja odik.<verse eid="HOS 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5" />Bọnga mad-asira k'ẹya, ọmaana k'erungọ,</para>
  <para style="q2" vid="HOS 4:5">agbaak-ettem ch'Ibinọkpaabyi mabir ator bọnga masira.</para>
  <para style="q1" vid="HOS 4:5">Ofona nya, kaam m'mfhọ akka kwọ.<verse eid="HOS 4:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6" />Anọng paam adimẹ, okurọ ch'maworọ ezonga.</para>
  <para style="b" vid="HOS 4:6" />
  <para style="q1" vid="HOS 4:6">“Ch'bọnga nkk'ezonga abhuma,</para>
  <para style="q2" vid="HOS 4:6">kaam kk'bọnga mbira mbhuma mach'afọhn-ẹja paam;</para>
  <para style="q1" vid="HOS 4:6">ch'bọnga nkk'ọpaanga kw'Ibinọkpaabyi kwabọnga azaama,</para>
  <para style="q2" vid="HOS 4:6">kaam m'mbira nzaama iva pabọnga.<verse eid="HOS 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7" />K'ose kw'uwa afọhn-ẹja masaabhẹ,</para>
  <para style="q2" vid="HOS 4:7">minna kw'machin ororo apin-m;</para>
  <para style="q2" vid="HOS 4:7">mabhona Ibinọkpaabyi kwabẹ kw'abarada, k'ọtọk f'ode igbardik.<verse eid="HOS 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8" />Mpyibha s'anọng paam, jẹ jọ ide ọchattọhk fabẹ,</para>
  <para style="q2" vid="HOS 4:8">epyibha ch'anọng paam, ebir ilebh bẹ nttem.<verse eid="HOS 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9" />K'ose kw'im'ode ọmaana anọng mboka, minna kw'im'ode ọmaana afọhn-ẹja.</para>
  <para style="q2" vid="HOS 4:9">Kaam m'nnang bẹ irem k'ozenga-bho kwabẹ,</para>
  <para style="q2" vid="HOS 4:9">mbira ntuka idik s'masi.<verse eid="HOS 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10" />“Bẹ mm'achi ọttọhk, okenaka, mmàdọbh;</para>
  <para style="q2" vid="HOS 4:10">bẹ mm'asi ẹzaza, okenaka, bẹ okwonọ mẹ̀kaama,</para>
  <para style="q1" vid="HOS 4:10">okurọ bẹ́, bẹ nkk'Ọvaar Ibinọkpaabyi kwabẹ abhuma,</para>
  <para style="q2" vid="HOS 4:10">matọka ifor sabẹ <verse eid="HOS 4:10" /><verse number="11" style="v" sid="HOS 4:11" />asok k'ẹzaza;</para>
  <para style="q1" vid="HOS 4:11">abhingatuk ọmaana abhatuk,</para>
  <para style="q2" vid="HOS 4:11">matọka edikzonga chabẹ.<verse eid="HOS 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12" />Ọkpata kw'matim echi agwa, kẹ kw'anọng paam ad-abọbh odik,</para>
  <para style="q2" vid="HOS 4:12">ẹzangachi chabẹ ẹgbaak bẹ odik.</para>
  <para style="q1" vid="HOS 4:12">Ẹzazamaana etima bẹ ettena eden;</para>
  <para style="q2" vid="HOS 4:12">m'ettem madanẹ katim ator Ibinọkpaabyi kwabẹ.<verse eid="HOS 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13" />Bẹ mad-afọhnọ ẹja z'agbeso,</para>
  <para style="q2" vid="HOS 4:13">mabir akwọmọ nnanga z'agbe,</para>
  <para style="q1" vid="HOS 4:13">ọmaana z'orin kw'ochi kw'oak, ọmaana kw'ochi kw'popla, ọttara kw'ochi kw'terebint,</para>
  <para style="q2" vid="HOS 4:13">za ch'ofokodo ode mawuriji.</para>
  <para style="q1" vid="HOS 4:13">Ofona nya, aminava pabọnga asi ẹzaza,</para>
  <para style="q2" vid="HOS 4:13">aminava p'ade anyẹ pabọnga abira alobh ẹfẹbhẹ.<verse eid="HOS 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14" />“Kaam panọngva pabọnga irem mìnang</para>
  <para style="q2" vid="HOS 4:14">k'ogbe kw'masi ẹzaza,</para>
  <para style="q1" vid="HOS 4:14">anyẹ pabọnga p'panọng irem mìmbira nnang</para>
  <para style="q2" vid="HOS 4:14">k'ogbe kw'mayim amaana ajinọng p'nna adim pabẹ ade,</para>
  <para style="q1" vid="HOS 4:14">okurọ bẹ́, ajinọng oyenẹ ny'abẹ k'ifor, mad-aninga amaana azaza,</para>
  <para style="q2" vid="HOS 4:14">mabira afọhnọ ẹja z'ẹzaza-kwuna,</para>
  <para style="q2" vid="HOS 4:14">anọng p'aworọ edikzonga, mm'adok-odok!<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15" />“Zaa bọnga anọng p'Israẹl matto k'ẹfẹbhẹ,</para>
  <para style="q2" vid="HOS 4:15">m'anọng p'Juda ọbọhk katte, mapinẹ.</para>
  <para style="b" vid="HOS 4:15" />
  <para style="q1" vid="HOS 4:15">“Bọnga nz'Gilgal kàta;</para>
  <para style="q2" vid="HOS 4:15">nz'Bẹt-Avẹn kàta.</para>
  <para style="q2" vid="HOS 4:15">Ńkàbirá achekẹ bẹ́, ‘K'odik ọkkọkka, k'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen!’<verse eid="HOS 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16" />Anọng p'Israẹl magaangẹ eso</para>
  <para style="q2" vid="HOS 4:16">mach'ọbhaamkwa kw'ikarẹ.</para>
  <para style="q1" vid="HOS 4:16">Yen kw'Ọvaar Ibinọkpaabyi mokpo bẹ ọchattọhk ọnang</para>
  <para style="q2" vid="HOS 4:16">mach'manangẹ arọkimaanva ọchattọhk z'ewonọ-kpa ch'azizaarẹ o?<verse eid="HOS 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17" />Ephraim norukọ z'aka; .</para>
  <para style="q2" vid="HOS 4:17">màttẹ-ẹ ọbọhk!<verse eid="HOS 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18" />Zaa atuk pabẹ kk'asa,</para>
  <para style="q2" vid="HOS 4:18">machin ororo k'ẹzaza za,</para>
  <para style="q2" vid="HOS 4:18">ekpo py'igbardik ẹdaakẹ abaabh pabẹ ẹyọhng-ọyọhnga.<verse eid="HOS 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19" />Bhaka-bhaka m'ọtaang bẹ ọbharẹ,</para>
  <para style="q2" vid="HOS 4:19">nja sabẹ m'ke bẹ k'mgbar.<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="s1">Aponga apyibhẹ Israẹl</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1" />Bọnga afọhn-ẹja, màyonga itọhng m'odik nwa!</para>
  <para style="q2" vid="HOS 5:1">Bọnga anọng p'Israẹl, màke otum m'odik nwa!</para>
  <para style="q1" vid="HOS 5:1">Ọvaarsọhm, yonga itọhng!</para>
  <para style="q2" vid="HOS 5:1">Aponga mba ade pabọnga:</para>
  <para style="q1" vid="HOS 5:1">Bọnga made ọmma kw'manwọn z'Mizpa,</para>
  <para style="q2" vid="HOS 5:1">ọmaana ibin s'mabharẹ z'Tabọr.<verse eid="HOS 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2" />Anọng p'ad-akaanga odik kk'adima k'epyibha ch'inọng-fhufha mawuriji.</para>
  <para style="q2" vid="HOS 5:2">Kaam m'nnang bẹ maphyir irem.<verse eid="HOS 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3" />Kaam nzong odik kpenamkpen kw'ọmaan Ephraim;</para>
  <para style="q2" vid="HOS 5:3">Anọng p'Israẹl otutubha katubh m'kaam k'ititika.</para>
  <para style="q1" vid="HOS 5:3">Bọnga anọng p'Ephraim nnasi ẹzaza;</para>
  <para style="q2" vid="HOS 5:3">Israẹl kk'odoka e.<verse eid="HOS 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4" />Itama sabẹ kìcher bẹ́,</para>
  <para style="q2" vid="HOS 5:4">makpa nnam z'Ibinọkpaabyi kwabẹ.</para>
  <para style="q1" vid="HOS 5:4">Ẹzazamaana kk'nttem sabẹ ẹbhọra;</para>
  <para style="q2" vid="HOS 5:4">M'ọdọk Ọvaar Ibinọkpaabyi kazong.<verse eid="HOS 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5" />Eforga ch'Israẹl kk'bẹ ẹka k'odik;</para>
  <para style="q2" vid="HOS 5:5">Anọng p'Israẹl, ozeng k'anọng p'Ephraim, masir k'epyibha chabẹ;</para>
  <para style="q2" vid="HOS 5:5">anọng p'Juda abir ator bẹ masira.<verse eid="HOS 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6" />K'ogbe kw'matim arọkimaan ọmaana abhaam pabẹ bẹ́,</para>
  <para style="q2" vid="HOS 5:6">mad-aror Ọvaar Ibinọkpaabyi,</para>
  <para style="q1" vid="HOS 5:6">m'kẹ màze;</para>
  <para style="q2" vid="HOS 5:6">kẹ kk'bẹ mbọhk ogbura.<verse eid="HOS 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7" />Bẹ m'Ọvaar Ibinọkpaabyi kakpobh amaana ettem madanẹ;</para>
  <para style="q2" vid="HOS 5:7">iva pabẹ p'mamaanẹ, m'ab'otte kayen.</para>
  <para style="q1" vid="HOS 5:7">K'ogbe kw'mm'asi odidaama kwabẹ kw'Ophe Ọbhakwẹ,</para>
  <para style="q2" vid="HOS 5:7">kẹ m'odimẹ bẹ eche, obira okibhẹ iwonọ sabẹ.<verse eid="HOS 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8" />“Màje enyi-sa z'Gibea,</para>
  <para style="q2" vid="HOS 5:8">maje ẹsa z'Rama.</para>
  <para style="q1" vid="HOS 5:8">Màwon egbong-mọng z'Bẹt-Aven;</para>
  <para style="q2" vid="HOS 5:8">Bẹnjamin, tima mina eden e.<verse eid="HOS 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9" />Ephraim m'oze irem</para>
  <para style="q2" vid="HOS 5:9">ny'ewu ch'im'mkpaara aponga.</para>
  <para style="q1" vid="HOS 5:9">Odik kw'mgbaakẹ ma,</para>
  <para style="q2" vid="HOS 5:9">m'oyin mbengana ny'nkọma s'Israẹl.<verse eid="HOS 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10" />Adidennọng p'Juda made</para>
  <para style="q2" vid="HOS 5:10">mach'anọng p'mad-arọhbha ata p'enem.</para>
  <para style="q1" vid="HOS 5:10">Kaam m'ntima ottempyibha kwaam ntor bẹ,</para>
  <para style="q2" vid="HOS 5:10">mach'ẹnwa-nwa.<verse eid="HOS 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11" />Ephraim oning k'irem,</para>
  <para style="q2" vid="HOS 5:11">aponga kk'bẹ apyibha,</para>
  <para style="q2" vid="HOS 5:11">ochibhẹ kwabẹ ochin k'aka okpukpobha.<verse eid="HOS 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12" />Kaam nde mach'ọgọgọ kw'anọng p'Ephraim,</para>
  <para style="q2" vid="HOS 5:12">mbira nde mach'echi ch'ẹlọbh-ọlọbha ch'anọng p'Juda.<verse eid="HOS 5:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13" />“K'ogbe kw'Ephraim oze ọkọhmaana fẹ,</para>
  <para style="q2" vid="HOS 5:13">Juda oze abhaak pẹ,</para>
  <para style="q1" vid="HOS 5:13">minna kw'Ephraim ochin z'Asiriya,</para>
  <para style="q2" vid="HOS 5:13">ọtọhm bẹ́, ọvaarnọng kwiden, ọkkaan-ẹ.</para>
  <para style="q1" vid="HOS 5:13">Okenaka, ọvaarnọng kọ kokpo obina k'ọkọhmaana fọ,</para>
  <para style="q2" vid="HOS 5:13">abhaak pọ kobir okpo osi, mape.<verse eid="HOS 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14" />Kaam m'nde mach'eche ch'im'esi Ephraim itama,</para>
  <para style="q2" vid="HOS 5:14">mbira nde mach'eche chiden ch'im'esi Juda itama.</para>
  <para style="q1" vid="HOS 5:14">Kaam m'nyaakẹ anọng p'Ephraim ọmaana p'Juda k'akpa-k'akpa, mbina mfona;</para>
  <para style="q2" vid="HOS 5:14">Kaam m'ntọr bẹ ntima mfona, ọnọng kode kw'im'ọkkaana bẹ.<verse eid="HOS 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15" />Nya kw'kaam Ibinọkpaabyi m'mkpa nnam z'iruk-byi saam,</para>
  <para style="q2" vid="HOS 5:15">maa, matọka irem s'epyibha chabẹ,</para>
  <para style="q2" vid="HOS 5:15">mabira aror-m.</para>
  <para style="q1" vid="HOS 5:15">Ny'ogbe nwo kw'irem, nya</para>
  <para style="q2" vid="HOS 5:15">kw'mm'atima ettem madanẹ maror-m.”<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s1">Anọng p'Israẹl ọmaana p'Juda m'nttem kacher abhona</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1" />“Màkwu, mọkpa nnam z'Ọvaar Ibinọkpaabyi.</para>
  <para style="q1" vid="HOS 6:1">Kẹ kk'mina ọyaaka k'akpa-k'akpa,</para>
  <para style="q2" vid="HOS 6:1">okenaka, kẹ m'obina mina k'ọkọhmaana;</para>
  <para style="q1" vid="HOS 6:1">kẹ kk'mina ọttọhk omuma,</para>
  <para style="q2" vid="HOS 6:1">okenaka, kẹ m'ogbobhọ abhaak pamina ogbobhọ.<verse eid="HOS 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2" />Ó̱de iwu ifa ikk'ikpana, kẹ m'obir ọnang mina akpen ọnang;</para>
  <para style="q2" vid="HOS 6:2">óttong iwu ittaan, kẹ m'ọnang mina oforgaangẹ ọnang,</para>
  <para style="q2" vid="HOS 6:2">mfha moruk ọmaan-ẹ.<verse eid="HOS 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3" />Tte mozonga Ọvaar Ibinọkpaabyi;</para>
  <para style="q2" vid="HOS 6:3">tte mokonga k'ose kw'mm'ozong-ẹ.</para>
  <para style="q1" vid="HOS 6:3">K'ose kw'ewuchen ina ed-etuna bẹ́, eyin,</para>
  <para style="q2" vid="HOS 6:3">minna kw'kẹ im'okwu okebha mina;</para>
  <para style="q1" vid="HOS 6:3">kẹ m'okwu okebha mina mach'ẹrọng ch'ekok-wu,</para>
  <para style="q2" vid="HOS 6:3">obir okwu mach'ẹrọng ch'oyomọ, ch'ed-edirẹ izek.”<verse eid="HOS 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4" />“Ephraim, kaam m'ntim-ọ nsi mbọng?</para>
  <para style="q2" vid="HOS 6:4">Juda, kaam m'ntim-ọ nsi mbọng?</para>
  <para style="q1" vid="HOS 6:4">Ọdaakẹ kwabọnga okerẹ ifọhng,</para>
  <para style="q2" vid="HOS 6:4">obir oker abubura p'ekpebha, p'nd-asa ẹbhar-ẹbhar.<verse eid="HOS 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5" />Ofona nya, kaam ntim agbaak-ettem ch'Ibinọkpaabyi paam mkpaara bọnga k'akwuma-k'akwuma.</para>
  <para style="q2" vid="HOS 6:5">Ntima igbaakadik s'ẹmma chaam, mfhọ bọnga,</para>
  <para style="q2" vid="HOS 6:5">pira epongakpaara chaam n'eyinẹ mach'ewuchen.<verse eid="HOS 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6" />Kaam nnorọ ididaaka s'ifon-ọ z'ettem, ẹja ofufọhnọ azang ch'nnorọ.</para>
  <para style="q2" vid="HOS 6:6">Nnorọ bẹ́, azonga Ibinọkpaabyi, nja s'ẹkwọmọ azang s'nnorọ.<verse eid="HOS 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7" />Bẹ nkk'echekẹ chaam avọhka mach'iwa Adam osi;</para>
  <para style="q2" vid="HOS 6:7">wa m'kaam kakpobh amaana ettem madanẹ.<verse eid="HOS 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8" />Gilead ode ebhondim ch'anọng p'ad-asi itama marukọ.</para>
  <para style="q2" vid="HOS 6:8">Adenkpaarẹ pabẹ maphyir, made azẹ-azẹ.<verse eid="HOS 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9" />K'ose kw'arurubha nd-atubha k'eden mafu anọng ekpo,</para>
  <para style="q2" vid="HOS 6:9">minna kw'nkaan s'afọhn-ẹja ibir ide;</para>
  <para style="q1" vid="HOS 6:9">mad-afhọ anọng ny'eden ch'echin z'Shẹkẹm;</para>
  <para style="q2" vid="HOS 6:9">mabir asi nttọhna-tama.<verse eid="HOS 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10" />Kaam kk'ẹkọngkwurọ nza ny'Israẹl:</para>
  <para style="q2" vid="HOS 6:10">Nya wọ kw'Ephraim otte ifor sẹ ọbọhk ọnang k'ẹzaza.</para>
  <para style="q2" vid="HOS 6:10">Israẹl kk'odoka e.<verse eid="HOS 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11" />“Kọ Juda ọdọk,</para>
  <para style="q2" vid="HOS 6:11">kk'ẹphawu chọ nka.</para>
  <para style="b" vid="HOS 6:11" />
  <para style="q1" vid="HOS 6:11">“K'ogbe kpenamkpen kw'm'nsi idik ikwuna anọng paam,<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1" />ogbe kpenamkpen kw'im'ibina Israẹl k'ọkọhmaana,</para>
  <para style="q1" vid="HOS 7:1">epyibha ch'Ephraim ẹd-ẹjan k'iyaan,</para>
  <para style="q2" vid="HOS 7:1">mpinẹ s'Samariya iyaakẹ k'ọyaankpa.</para>
  <para style="q1" vid="HOS 7:1">wa ẹ́mmáaná chabẹ ede itwutwukọ,</para>
  <para style="q2" vid="HOS 7:1">arurubha mad-avọhkọ isọhm mafu orubh,</para>
  <para style="q2" vid="HOS 7:1">arurubha mafu anọng irubh z'adenkpaarẹ;<verse eid="HOS 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2" />Bẹ nkazong bẹ́,</para>
  <para style="q2" vid="HOS 7:2">kaam njim itama sabẹ maphyir.</para>
  <para style="q1" vid="HOS 7:2">Mpyibha sabẹ kk'bẹ ibhọra maphyir;</para>
  <para style="q2" vid="HOS 7:2">mpyibha njo ijanẹ m'ikaam k'ititika k'ogbe kpenamkpen.<verse eid="HOS 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3" />“Matim itama sabẹ asi ettem elebh ọvaarnọng,</para>
  <para style="q2" vid="HOS 7:3">matima afọra asi nttem ilebh asonọng pabẹ.<verse eid="HOS 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4" />Bẹ maphyir made azaza,</para>
  <para style="q2" vid="HOS 7:4">made mach'okpon-kkin kw'nkwuka</para>
  <para style="q1" vid="HOS 7:4">kw'ọnọng kw'osi brẹd ina ọbaan bẹ́, ogbokọ</para>
  <para style="q2" vid="HOS 7:4">maa, abuma p'brẹd abir.<verse eid="HOS 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5" />K'ewu ch'ọvaarnọng kwamina osi odidaama,</para>
  <para style="q2" vid="HOS 7:5">asonọng mabuma atuk,</para>
  <para style="q2" vid="HOS 7:5">mawọhkọ ọvaarnọng ochi ẹbọhk-bhina ọmaana anọng p'ad-alokọ ọnọng.<verse eid="HOS 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6" />Nttem sabẹ ikọmọ mach'okpon-kkin kw'nkwuka;</para>
  <para style="q2" vid="HOS 7:6">matima nkkaar ator-ẹ.</para>
  <para style="q1" vid="HOS 7:6">K'orungiwu kibungọ, ottempyibha kwabẹ ode mach'ekpon ch'ede <char style="it">ma tanitaanẹ;</char></para>
  <para style="q2" vid="HOS 7:6">k'ekpebha, ottempyibha nwo ọyaak mach'okponkkin.<verse eid="HOS 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7" />Bẹ maphyir makọmọ nttem mach'ekpon ch'nkwuka;</para>
  <para style="q2" vid="HOS 7:7">mafhọ abaabh pabẹ.</para>
  <para style="q1" vid="HOS 7:7">Avaarnọng pabẹ maphyir, mape,</para>
  <para style="q2" vid="HOS 7:7">ọnọng mawanẹ kw'obhomọ ẹkkaana ọkpẹk-m kode.<verse eid="HOS 7:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8" />“Ephraim nọgbak ifor ọmaana nkọma ọdọk-ọdọk;</para>
  <para style="q2" vid="HOS 7:8">Ephraim node brẹd kw'obyi ẹbhaakẹ danẹ.<verse eid="HOS 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9" />Akikennọng kk'ẹ ẹfa ana,</para>
  <para style="q2" vid="HOS 7:9">okenaka, kozong.</para>
  <para style="q1" vid="HOS 7:9">Atam kk'ẹ abọka,</para>
  <para style="q2" vid="HOS 7:9">okenaka, ifor sẹ kotinẹ.<verse eid="HOS 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10" />Eforga ch'Israẹl kk'ẹ ẹka k'odik.</para>
  <para style="q2" vid="HOS 7:10">Chibhẹ ny'idik nja maphyir s'ikk'iyina,</para>
  <para style="q1" vid="HOS 7:10">kẹ nnam kọkpa otor Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwẹ,</para>
  <para style="q2" vid="HOS 7:10">Ibinọkpaabyi kobir oror.<verse eid="HOS 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11" />“Ephraim ode mach'ikpommuka</para>
  <para style="q2" vid="HOS 7:11">s'ichamẹ ẹbọhra, ibira iwor ezonga,</para>
  <para style="q1" vid="HOS 7:11">od-oror ẹkkaana z'Ijip,</para>
  <para style="q2" vid="HOS 7:11">ọmaana z'Asiriya.<verse eid="HOS 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12" />K'ogbe kw'mm'afona, kaam m'mbharẹ ibin saam ibubha bẹ;</para>
  <para style="q2" vid="HOS 7:12">Kaam m'ntọr bẹ mbin k'izek mach'ọnọhn f'iwokọ.</para>
  <para style="q1" vid="HOS 7:12">K'ogbe kw'mbhaang bẹ ch'maning k'ibyi majanẹ,</para>
  <para style="q2" vid="HOS 7:12">kaam m'mbọka bẹ.<verse eid="HOS 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13" />M'opyibh ọnang bẹ</para>
  <para style="q2" vid="HOS 7:13">okurọ bẹ́, nkk'eden chaam attena!</para>
  <para style="q1" vid="HOS 7:13">Itama m'ikpẹkẹ bẹ,</para>
  <para style="q2" vid="HOS 7:13">okurọ ch'magaangẹ nso atima ator-m!</para>
  <para style="q1" vid="HOS 7:13">Kaam nd-nkam bẹ́, nkkaana bẹ,</para>
  <para style="q2" vid="HOS 7:13">okenaka, bẹ mad-agbaak afora anan-m.<verse eid="HOS 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14" />Ẹmọng ch'bẹ mabhomọ ayer-m, bẹ z'nttem, kefon.</para>
  <para style="q2" vid="HOS 7:14">Okenaka, matera aninga z'mbin sabẹ mabhom ayer-m.</para>
  <para style="q1" vid="HOS 7:14">Mapyi abhaak zabẹ k'ifor, makwukọ aka pabẹ bẹ́,</para>
  <para style="q2" vid="HOS 7:14">manang bẹ akpomọma, ọmaana abhatuk.</para>
  <para style="q2" vid="HOS 7:14">okenaka, magbaarẹ kaam abharẹ.<verse eid="HOS 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15" />Kaam nnang bẹ okpebhẹ ọkkọkka, mbira nsi mbọhk igaangẹ bẹ,</para>
  <para style="q2" vid="HOS 7:15">okenaka, bẹ machibhẹ itama amaan-m.<verse eid="HOS 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16" />Bẹ m'nnam kakpa ator Ibinọkpaabyi kw'Ọyọhng;</para>
  <para style="q2" vid="HOS 7:16">bẹ made mach'oyuk kw'ina ojibhẹ.</para>
  <para style="q1" vid="HOS 7:16">Ọkkangkkang wọ im'ọfhọ aso pabẹ,</para>
  <para style="q2" vid="HOS 7:16">okurọ ililẹkẹ-dik sabẹ.</para>
  <para style="q1" vid="HOS 7:16">M'ofona m'idik nja, matima bẹ masi ekirẹ</para>
  <para style="q2" vid="HOS 7:16">ny'ẹkọma ch'Ijip.<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s1">Anọng p'Israẹl m'atọka irem k'itama sabẹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1" />“Màtima enyisa won ẹmọng z'ẹmma!</para>
  <para style="q2" vid="HOS 8:1">Kirẹ etingẹ kk'ẹsaka ny'Ọsọhm kw'Ọvaar Ibinọkpaabyi,</para>
  <para style="q1" vid="HOS 8:1">okurọ bẹ́, nkk'odik kwaam abhuma,</para>
  <para style="q2" vid="HOS 8:1">m'ọdọk asana paam kakpobh.<verse eid="HOS 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2" />Anọng p'Israẹl abhomọ ayere-m bẹ́,</para>
  <para style="q2" vid="HOS 8:2">“O Ibinọkpaabyi kwamina, mina motim ozong-ọ ka e.”<verse eid="HOS 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3" />Anọng p'Israẹl kk'ọttọhk ọkkọkka abhuma;</para>
  <para style="q2" vid="HOS 8:3">ọwawunanọng m'okwubh bẹ.<verse eid="HOS 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4" />Bẹ masi anọng mvaar, m'kaam kabọbhọ.</para>
  <para style="q2" vid="HOS 8:4">Mateka asonọng, m'kaam katekẹ.</para>
  <para style="q1" vid="HOS 8:4">Matima silva ọmaana gol pabẹ oyenẹ</para>
  <para style="q2" vid="HOS 8:4">masi akpata</para>
  <para style="q2" vid="HOS 8:4">p'abhakẹ asi bẹ itama.<verse eid="HOS 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5" />Bọnga anọng p'Samariya, màrọhbha ọkpata kwabọnga kw'ọbhaamnwa, bharẹ o!</para>
  <para style="q2" vid="HOS 8:5">Ettem kk'aam epyibha ẹmaana bẹ.</para>
  <para style="q1" vid="HOS 8:5">Ogbe m'obhir otuma yen, pira maruk akpen p'awur-owur o?<verse eid="HOS 8:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6" />Ọkpata nwo ofon z'Israẹl!</para>
  <para style="q1" vid="HOS 8:6">Ọbhaamnwa nwoma ode ọtọhmbọhk f'otiteka;</para>
  <para style="q2" vid="HOS 8:6">Ibinọkpaabyi azang nya.</para>
  <para style="q1" vid="HOS 8:6">Mm'avọhkọ ọbhaamnwa nwo</para>
  <para style="q2" vid="HOS 8:6">kw'Samariya <char style="it">ma tukutuku </char>.<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7" />“Bẹ matubhọ ofum,</para>
  <para style="q2" vid="HOS 8:7">mapha bhakabhaka.</para>
  <para style="q1" vid="HOS 8:7">Ch'ekpo py'matubhọ ina agbok esi;</para>
  <para style="q2" vid="HOS 8:7">ekpo mbyo mẹ̀wọm.</para>
  <para style="q1" vid="HOS 8:7">Ó̱de ébir ẹwọm-ọwọm,</para>
  <para style="q2" vid="HOS 8:7">akikennọng m'achi pyẹ maphyir.<verse eid="HOS 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8" />Israẹl kk'oluka e;</para>
  <para style="q2" vid="HOS 8:8">kẹ node mach'ẹkọma ch'ina ọttọhk áfẹ̀ ọbang</para>
  <para style="q2" vid="HOS 8:8">z'ititika s'nkọma njoza.<verse eid="HOS 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9" />Bẹ nkk'achina z'Asiriya</para>
  <para style="q2" vid="HOS 8:9">mach'ẹnyanya ch'ẹd-ẹtọhka ekpo ch'nna otum ake, ed-etten-ottena.</para>
  <para style="q2" vid="HOS 8:9">Ephraim kk'ifor sẹ ọkpa ọnang adaakẹ-nọng pẹ.<verse eid="HOS 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10" />Zaabẹ́ nkk'ifor sabẹ akpa anang ayok-nkọma ọdọk-ọdọk,</para>
  <para style="q2" vid="HOS 8:10">kaam m'ntobha bẹ k'ibyi majanẹ.</para>
  <para style="q1" vid="HOS 8:10">Mm'atọma irem otitọka</para>
  <para style="q2" vid="HOS 8:10">k'mbọhk s'avaar p'mm'atima ẹfa abaabh bẹ.<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11" />“Zaabẹ́ Ephraim kk'ọja-byi f'epyibha ogbugbobhọ ottima k'ọsaabh,</para>
  <para style="q2" vid="HOS 8:11">ọja-byi mvo noter ode obyi f'mpyibha osisi.<verse eid="HOS 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12" />Kaam nkkẹrẹ idik saabhada s'imaan apaanga paam, nnang bẹ,</para>
  <para style="q2" vid="HOS 8:12">okenaka, bẹ maze jẹ mach'idik s'ibin nkọma ọdọk-ọdok.<verse eid="HOS 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13" />Zaabẹ́ matim nnanga afọhnọ nja anang-m,</para>
  <para style="q2" vid="HOS 8:13">mabira achi nten s'nnanga njo,</para>
  <para style="q2" vid="HOS 8:13">nja njo kaam Ọvaar Ibinọkpaabyi ettem melebh.</para>
  <para style="q1" vid="HOS 8:13">Kẹ m'ojima itama sabẹ madidanma,</para>
  <para style="q2" vid="HOS 8:13">obira ọnang bẹ irem k'mpyibha sabẹ.</para>
  <para style="q2" vid="HOS 8:13">Bẹ mm'akpa nnam z'Ijip.<verse eid="HOS 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14" />Israẹl kk'Ọnọng kw'osi bẹ ọzaama,</para>
  <para style="q2" vid="HOS 8:14">obir ottima adimpa;</para>
  <para style="q2" vid="HOS 8:14">Juda kk'ibhon siden s'ẹfa ọsa k'ọsaabh.</para>
  <para style="q1" vid="HOS 8:14">Okenaka, kaam m'ntọhm ekpon ny'ibhondim sabẹ,</para>
  <para style="q2" vid="HOS 8:14">mfha ẹkwọmọ ọfa-byi fabẹ maphyir.”<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s1">Irem s'anọng p'Israẹl mm'atọka</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1" />Bọnga anọng p'Israẹl, ettem ening bọnga ẹdaamẹ;</para>
  <para style="q2" vid="HOS 9:1">m'odidaama kasi mach'nkọma njoza.</para>
  <para style="q1" vid="HOS 9:1">Kirẹ bọnga <char style="it">mm'apyir </char>kabe amaana Ibinọkpaabyi;</para>
  <para style="q2" vid="HOS 9:1">Atọhm-kpuka p'ọzaza bọ adaakẹ bọnga</para>
  <para style="q2" vid="HOS 9:1">k'ọgbaarẹ kpenamkpen kw'nd-agwuma akpo- mọma.<verse eid="HOS 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2" />Agbaarẹ p'mad-agwuma akpo mọmma, ọmaana obyi f'mad-amyaana atuk p'achiduk, m'anọng ọchattọhk manang;</para>
  <para style="q2" vid="HOS 9:2">m'atuk abhapẹ mabir aze.<verse eid="HOS 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3" />Bẹ nny'izek s'Ọvaar Ibinọkpaabyi maruk achina ororo;</para>
  <para style="q2" vid="HOS 9:3">Anọng p'Ephraim m'akwuna z'Ijip,</para>
  <para style="q2" vid="HOS 9:3">bẹ mm'achi ọchattọhk f'ọbang-ọbangẹ z'Asiriya.<verse eid="HOS 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4" />Bẹ m'atuk mabyenga mach'nnanga anang Ọvaar Ibinọkpaabyi,</para>
  <para style="q2" vid="HOS 9:4">ozeng k'nja sabẹ s'mm'afọhnọ, Ọvaar Ibinọkpaabyi ettem mèlebh.</para>
  <para style="q1" vid="HOS 9:4">Njase njo sabẹ m'ide mach'ọchattọhk f'anọng p'aning k'oforpyibha;</para>
  <para style="q2" vid="HOS 9:4">bẹ mbo maphyir p'achi ọchattọhk mvo, mm'abang-ọbangẹ.</para>
  <para style="q1" vid="HOS 9:4">Ọchattọhk mva m'ode fabẹ vẹ-vẹ;</para>
  <para style="q2" vid="HOS 9:4">ọchattọhk mvo k'ọsọhm kw'Ọvaar Ibinọkpaabyi mòdim.<verse eid="HOS 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5" />Bọnga mm'asi bọng k'ididaamawu sabọnga,</para>
  <para style="q2" vid="HOS 9:5">ọmaana k'ididaamawu s'Ọvaar Ibinọkpaabyi?<verse eid="HOS 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6" />Zaabẹ́ marọbhọ itama s'im'ikebha bẹ,</para>
  <para style="q2" vid="HOS 9:6">anọng p'Ijip m'atobha bẹ k'ibyi majanẹ,</para>
  <para style="q2" vid="HOS 9:6">anọng p'Mẹmphis manọhnga bẹ.</para>
  <para style="q1" vid="HOS 9:6">Akkaangẹ m'amen, matọka oyena kwabẹ kw'silva maphyir,</para>
  <para style="q2" vid="HOS 9:6">isidima m'ibir imen, itọka iruk-byi sabẹ maphyir.<verse eid="HOS 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7" />Iwu s'irem ikwuma,</para>
  <para style="q2" vid="HOS 9:7">iwu s'eponga-kpaara n'be ma.</para>
  <para style="q2" vid="HOS 9:7">Tte anọng p'Ijip azonga odik nwa.</para>
  <para style="q1" vid="HOS 9:7">Kirẹ mpyibha sabọnga isaabhẹ ọkpan,</para>
  <para style="q2" vid="HOS 9:7">iwawuna sabọnga ibir ibar ọkpan,</para>
  <para style="q1" vid="HOS 9:7">matọk ọgbaak-ettem ch'Ibinọkpaabyi mach'ọnọng kw'otur-oturọ,</para>
  <para style="q2" vid="HOS 9:7">mabir atọka ọnọng kw'oyen egwugwuma ch'Ibinọkpaabyi mach'odingidingẹ.<verse eid="HOS 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8" />Ọgbaak-ettem ch'Ibinọkpaabyi, ọmaana Ibinọkpaabyi kwaam,</para>
  <para style="q2" vid="HOS 9:8">bẹ bọ akkerẹ Ephraim,</para>
  <para style="q1" vid="HOS 9:8">chibhẹ nya, amma ánwọn atik-ẹ z'nden sẹ maphyir,</para>
  <para style="q2" vid="HOS 9:8">iwawuna ibir itik-ẹ z'ọsọhm kw'Ibinọkpaabyi kwẹ.<verse eid="HOS 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9" />Bẹ nkk'itama asa mawuriji,</para>
  <para style="q2" vid="HOS 9:9">mach'iwa Gibea osi.</para>
  <para style="q1" vid="HOS 9:9">Ibinọkpaabyi m'ojima itama sabẹ,</para>
  <para style="q2" vid="HOS 9:9">obir ọnang bẹ irem k'mpyibha sabẹ.<verse eid="HOS 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10" />K'ogbe kw'nze anọng p'Israẹl,</para>
  <para style="q2" vid="HOS 9:10">wa ode mach'nze grep z'ibyi s'anọng nna arukọ;</para>
  <para style="q1" vid="HOS 9:10">k'ogbe kw'uwa nze ab'ttatta pabọnga,</para>
  <para style="q2" vid="HOS 9:10">wa ode mach'nze acheden-duk p'fig.</para>
  <para style="q1" vid="HOS 9:10">Okenaka, k'ogbe kw'mapyirẹ z'Baal-Peọr,</para>
  <para style="q2" vid="HOS 9:10">matte ifor sabẹ ọbọhk anang ọkpata nwo kw'ina ọttọhk áfẹ̀ ọbang,</para>
  <para style="q2" vid="HOS 9:10">makwu apyibh mach'ọkpata nwo kw'ọdaakẹ bẹ bẹ́, makpobha.<verse eid="HOS 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11" />Abarada p'Ephraim mm'akwur afona mach'inọhn s'ẹrọng,</para>
  <para style="q2" vid="HOS 9:11">ọdọk ọmaan mòsi, ibhọr mòtima, ophe kẹ mòbir okponga.<verse eid="HOS 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12" />Zaabẹ mamaanẹ iva,</para>
  <para style="q2" vid="HOS 9:12">m'nsi bẹ mape maphyir.</para>
  <para style="q1" vid="HOS 9:12">M'opyibh ọnang bẹ,</para>
  <para style="q2" vid="HOS 9:12">k'ogbe kw'mkpa nnam mbọra bẹ!<verse eid="HOS 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13" />Kaam kk'Ephraim nza mach'nze anọng p'Taya</para>
  <para style="q2" vid="HOS 9:13">p'mattim k'ibyi ọkkọkka.</para>
  <para style="q1" vid="HOS 9:13">Okenaka, iva p'Ephraim m'atto k'mbọhk s'anọng</para>
  <para style="q2" vid="HOS 9:13">p'mm'afhọ bẹ.”<verse eid="HOS 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14" />O Ọvaar Ibinọkpaabyi, nang bẹ,</para>
  <para style="q2" vid="HOS 9:14">bọng-ọttọhk f'm'anang bẹ o?</para>
  <para style="q1" vid="HOS 9:14">Si ọbhọr fabẹ oyin,</para>
  <para style="q2" vid="HOS 9:14">asi aba pabẹ akka asi.<verse eid="HOS 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15" />Bẹ mabọk-m idik okurọ itama s'masi z'Gilgal,</para>
  <para style="q2" vid="HOS 9:15">kaam m'nkwubh bẹ z'ọsọhm kwaam, okurọ mpyibha s'mad-asi.</para>
  <para style="q1" vid="HOS 9:15">Kaam ọdọk bẹ ọdaakẹ kwaam mìnkọhka,</para>
  <para style="q2" vid="HOS 9:15">asonọng pabẹ</para>
  <para style="q1" vid="HOS 9:15">maphyir,</para>
  <para style="q2" vid="HOS 9:15">made akikọhra.<verse eid="HOS 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16" />Anọng p'Ephraim ade mach'echi ch'ẹpọhk-ọpọhka,</para>
  <para style="q2" vid="HOS 9:16">ẹranga chẹ kk'ẹpa,</para>
  <para style="q2" vid="HOS 9:16">aduk kẹwọmọ.</para>
  <para style="q1" vid="HOS 9:16">Zaabẹ́ mamaanẹ iva,</para>
  <para style="q2" vid="HOS 9:16">kaam m'mfhọ iva mbo p'akpẹ bẹ z'nttem.”<verse eid="HOS 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17" />Ibinọkpaabyi kwaam m'obhum bẹ,</para>
  <para style="q2" vid="HOS 9:17">okurọ bẹ́, m'ikẹ kakpobh;</para>
  <para style="q2" vid="HOS 9:17">bẹ mm'ade attittenanọng k'ottem kw'nkọma s'iyagbin.<verse eid="HOS 9:17" /></para>
  <para style="b" />
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1" />Wa anọng p'Israẹl made mach'echi ch'grep ch'ẹd-ẹnyaam-ọnyaamẹ;</para>
  <para style="q2" vid="HOS 10:1">ẹwọm aduk p'ikẹ k'ifor.</para>
  <para style="q1" vid="HOS 10:1">K'ose kw'aduk pẹ asaabhẹ,</para>
  <para style="q2" vid="HOS 10:1">minna kw'mattim ọja-byi k'ọsaabh;</para>
  <para style="q1" vid="HOS 10:1">k'ose kw'izek sabẹ ijibh ekpo,</para>
  <para style="q2" vid="HOS 10:1">minna kw'madok ata p'aka p'mad-akpobha.<verse eid="HOS 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2" />Nttem sabẹ id-ibọhra bẹ ọbọhra,</para>
  <para style="q2" vid="HOS 10:2">ofona nya, bẹ mm'atọka irem k'mpyibha sabẹ m'ogbe nwa.</para>
  <para style="q1" vid="HOS 10:2">Ọvaar Ibinọkpaabyi m'ọvọhkọ ọja-byi fabẹ,</para>
  <para style="q2" vid="HOS 10:2">obir okibhẹ ata p'aka p'mad-akpobha.<verse eid="HOS 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3" />Nya o, mm'aben bẹ́, “Mina m'ọvaarnọng koyen</para>
  <para style="q2" vid="HOS 10:3">okurọ ch'nna Ọvaar Ibinọkpaabyi okpobh.</para>
  <para style="q1" vid="HOS 10:3">Okenaka, zaa wura moyen ọvaarnọng oyena,</para>
  <para style="q2" vid="HOS 10:3">bọng-ọttọhk f'kẹ im'osi ọnang mina o?”<verse eid="HOS 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4" />Bẹ mad-atọka nwọhngọ k'ọsaabh,</para>
  <para style="q2" vid="HOS 10:4">masi nchekẹ k'ẹfọraden, mabira asi nttọhna;</para>
  <para style="q2" vid="HOS 10:4">ofona nya, aponga-tama masaabh</para>
  <para style="q1" vid="HOS 10:4">mach'azizaarẹ</para>
  <para style="q2" vid="HOS 10:4">p'amenẹ k'owonọ kw'nkk'atubha.<verse eid="HOS 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5" />Anọng p'arukọ z'Samariya aning k'ojora</para>
  <para style="q2" vid="HOS 10:5">okurọ ọkpata kw'ọbhaamnwa kw'Bẹt-Avẹn.</para>
  <para style="q1" vid="HOS 10:5">Anọng p'akpobh ọkpata nwo mm'aninga k'oforpyibha,</para>
  <para style="q2" vid="HOS 10:5">ozeng k'afọhn-ẹja pẹ,</para>
  <para style="q1" vid="HOS 10:5">ọttara ayok mbo p'uwa ad-alobh ajibhada p'ọkpata nwo,</para>
  <para style="q2" vid="HOS 10:5">okurọ ch'iwa mana bẹ atima achina k'ẹkọma ọdọk-ọdọk.<verse eid="HOS 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6" />Bẹ mm'atinẹ ọkpata nwo atima achina z'Asiriya,</para>
  <para style="q2" vid="HOS 10:6">mad-anang ọvaarnọng kwiden mach'ntuma.</para>
  <para style="q1" vid="HOS 10:6">Bẹ mm'asi anọng p'Ephraim igbardik;</para>
  <para style="q2" vid="HOS 10:6">mgbar m'isi anọng p'Israẹl okurọ eforgbaka ch'mayen amaana aka.<verse eid="HOS 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7" />Bẹ mm'afhọ ọvaarnọng kw'Samariya,</para>
  <para style="q2" vid="HOS 10:7">madim-ẹ eche mach'ochikpakpa kw'owokọ k'asi.<verse eid="HOS 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8" />Mm'avọhkọ ọja-byi f'ọyaankpa f'mad-aninga asi epyibha,</para>
  <para style="q2" vid="HOS 10:8">kw'ode epyibha ch'anọng p'Israẹl.</para>
  <para style="q1" vid="HOS 10:8">Akkaangẹ, ọmaana isidima mm'amen,</para>
  <para style="q2" vid="HOS 10:8">mabhọrọ ọja-byi fabẹ.</para>
  <para style="q1" vid="HOS 10:8">Nya kw'mm'aben agbe p'agor-ogorọ bẹ́,</para>
  <para style="q2" vid="HOS 10:8">“Màbubha mina!’’</para>
  <para style="q2" vid="HOS 10:8">mabira aben agbe p'ikarẹ bẹ́, ‘‘Màtto kpẹkẹ mina!”<verse eid="HOS 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9" />“Tọma z'ogbe kw'Gibea, bọnga anọng p'Israẹl nkk'mpyibha asa,</para>
  <para style="q2" vid="HOS 10:9">maa pyirẹ ma, matim aning ny'mpyibha njo.</para>
  <para style="q1" vid="HOS 10:9">Ma, egbong ọdọk mètto ch'im'ẹfhọ</para>
  <para style="q2" vid="HOS 10:9">anọng-tama m'Gibea yirẹ?<verse eid="HOS 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10" />Kaam m'nnang bẹ irem k'ogbe kw'ọdaak-m;</para>
  <para style="q2" vid="HOS 10:10">nkọma m'igbaka, irima bẹ ábẹ̀,</para>
  <para style="q2" vid="HOS 10:10">isok bẹ k'irem okurọ epyibha chabẹ ch'masi mabira-obira.<verse eid="HOS 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11" />Ephraim ode ọbhaamkwa kw'ikk'okpebhẹ ọkkọkka ọtọka;</para>
  <para style="q2" vid="HOS 10:11">kw'ọdaak-ẹ bẹ́, oduk barli;</para>
  <para style="q1" vid="HOS 10:11">kaam m'nkẹ-ẹ ikwubha</para>
  <para style="q2" vid="HOS 10:11">k'ekikora.</para>
  <para style="q1" vid="HOS 10:11">Kaam m'nkwubh anọng p'Ephraim,</para>
  <para style="q2" vid="HOS 10:11">anọng p'Juda matubh izek,</para>
  <para style="q2" vid="HOS 10:11">anọng p'Jekọb m'achaara izek.<verse eid="HOS 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12" />Bọnga màsi ẹ́mmáaná ch'etoro-otor,</para>
  <para style="q2" vid="HOS 10:12">mfha maze ejibha ch'ọdaakẹ kw'ina ẹkpọka oyen.</para>
  <para style="q1" vid="HOS 10:12">Màbhona akpentama pabọnga,</para>
  <para style="q2" vid="HOS 10:12">okurọ bẹ́, ogbe kw'mm'aror Ọvaar Ibinọkpaabyi wọ ma,</para>
  <para style="q1" vid="HOS 10:12">maa, kwuna otima atoriji pẹ okwu</para>
  <para style="q2" vid="HOS 10:12">odo bọnga.<verse eid="HOS 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13" />Okenaka, bọnga nkk'itama atubha,</para>
  <para style="q2" vid="HOS 10:13">mapha itama,</para>
  <para style="q2" vid="HOS 10:13">bọnga nkk'ochiduk kw'ẹnọngbọhra acha.</para>
  <para style="q1" vid="HOS 10:13">Ch'bọnga maphe nnam k'ẹfa chabọnga, ọmaana k'ẹfa ch'akkikkaama saabhada</para>
  <para style="q2" vid="HOS 10:13">pabọnga,<verse eid="HOS 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14" />anọng p'abhaang ẹmọng ch'egbong m'arima anọng pabọnga ábẹ̀,</para>
  <para style="q2" vid="HOS 10:14">ofona nya, mm'avọhkọ ọfa-byi fabọnga maphyir</para>
  <para style="q1" vid="HOS 10:14">mach'iwa Shalam ọvọhkọ Bẹt-Arbẹl k'ewu ch'egbong,</para>
  <para style="q2" vid="HOS 10:14">k'ogbe kw'uwa matọk ab'ọkka, ọmaana iva pabẹ mamaam z'izek.<verse eid="HOS 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15" />Minna kw'im'oyin ọmaana bọnga anọng p'Bẹtẹl,</para>
  <para style="q2" vid="HOS 10:15">okurọ bẹ́, itama sabọnga ibar-ọbar.</para>
  <para style="q1" vid="HOS 10:15">Ó̱de éwu ndo ikk'epyira,</para>
  <para style="q2" vid="HOS 10:15">ọvaarnọng kw'Israẹl m'odimẹ eche kibung-kibungọ.<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s1">Ọdaakẹ kw'Ibinọkpaabyi oyen ọmaana anọng p'Israẹl</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1" />“K'ogbe kw'uwa Israẹl otim ode nnwa-nnwa, nyen ọdaakẹ mmaan-ẹ,</para>
  <para style="q2" vid="HOS 11:1">nyerẹ nnwa kwaam z'Ijip.<verse eid="HOS 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2" />Okenaka, k'ose kw'nyerẹ bẹ,</para>
  <para style="q2" vid="HOS 11:2">minna kw'makpa nnam abọr-m.</para>
  <para style="q1" vid="HOS 11:2">Mafọhnọ nja anang aka p'Baal,</para>
  <para style="q2" vid="HOS 11:2">mabira akwọmọ insẹns anang akpata.<verse eid="HOS 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3" />Kaam wọ uwa mkpebhẹ Ephraim ozenga,</para>
  <para style="q2" vid="HOS 11:3">ntọka bẹ nwọhka k'mbọhk saam;</para>
  <para style="q1" vid="HOS 11:3">okenaka, bẹ nkazong bẹ́,</para>
  <para style="q2" vid="HOS 11:3">kaam wọ mbin bẹ k'ọkọhmaana.<verse eid="HOS 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4" />Ọphyaam f'ettem chaam, vẹ f'ntim nchi bẹ eden,</para>
  <para style="q2" vid="HOS 11:4">mgbaka ifor mmaana bẹ k'ọdaakẹ.</para>
  <para style="q1" vid="HOS 11:4">Wa kaam nde mach'ọnọng kw'ọrọhbh</para>
  <para style="q2" vid="HOS 11:4">ọbhanwa irem k'ẹdọngọ</para>
  <para style="q2" vid="HOS 11:4">mbir nraka-ọraka nnang bẹ ọchattọhk.<verse eid="HOS 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5" />“Bẹ m'nnam z'Ijip makpa,</para>
  <para style="q2" vid="HOS 11:5">Asiriya wọ im'ọbaabha bẹ,</para>
  <para style="q2" vid="HOS 11:5">okurọ ch'nna acher abhona.<verse eid="HOS 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6" />Anọng m'atima akkangkkang arima ibhondim sabẹ,</para>
  <para style="q2" vid="HOS 11:6">mafhọ anọng p'ad-agbaak ettem ch'Ibinọkpaabyi k'ẹfọraden,</para>
  <para style="q2" vid="HOS 11:6">mabira akpọka nttọhna sabẹ.<verse eid="HOS 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7" />Anọng paam acher obo bẹ́, mm'akpa nnam abọr-m.</para>
  <para style="q2" vid="HOS 11:7">Zaabẹ́ nnayer-m Ọvaar Ibinọkpaabyi kw'Ọyọhng,</para>
  <para style="q2" vid="HOS 11:7">eden kede ch'kaam m'nnang bẹ ikpukpobha.<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8" />“Anọng p'Ephraim,</para>
  <para style="q2" vid="HOS 11:8">kaam bọnga m'nzaama.</para>
  <para style="q1" vid="HOS 11:8">Anọng p'Israẹl, kaam bọnga ọbọhk mìntte.</para>
  <para style="q2" vid="HOS 11:8">Kaam bọnga mìnsi mach'nsi Adma.</para>
  <para style="q1" vid="HOS 11:8">Kaam bọnga mìnsi mach'nsi Zeboyim.</para>
  <para style="q2" vid="HOS 11:8">Kaam kk'achibhẹ paam mmona; ikwosisi saam maphyir k'nnam ikpa.<verse eid="HOS 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9" />Kaam ottempyibha kwaam mìnkọhka,</para>
  <para style="q2" vid="HOS 11:9">ọdọk Ephraim itama mìmbir nsi.</para>
  <para style="q1" vid="HOS 11:9">Kaam nde Ibinọkpaabyi, oyokinọng kinde,</para>
  <para style="q2" vid="HOS 11:9">kaam kw'nwur-owur k'ottem kwabọnga.</para>
  <para style="q2" vid="HOS 11:9">Kaam ibhondim sabọnga itama mìnsi.<verse eid="HOS 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10" />Bẹ mm'ator Ọvaar Ibinọkpaabyi;</para>
  <para style="q2" vid="HOS 11:10">kẹ Ọvaar Ibinọkpaabyi m'osi ẹmọng mach'eche.</para>
  <para style="q1" vid="HOS 11:10">K'ogbe kw'osi ẹmọng ndo,</para>
  <para style="q2" vid="HOS 11:10">iva pẹ m'atima ifufọnọ abina z'ẹbhaakẹ ch'ewuchen ed-edimẹ, makwu.<verse eid="HOS 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11" />Bẹ mm'abina z'Ijip akwu,</para>
  <para style="q2" vid="HOS 11:11">mafọnọ mach'ọrarora,</para>
  <para style="q2" vid="HOS 11:11">mabir abina z'Asiriya, makwur mach'okpommuka.</para>
  <para style="q1" vid="HOS 11:11">Kaam m'ntima bẹ mkpa nnam zabẹ k'ibhon,”</para>
  <para style="q2" vid="HOS 11:11">kaam Ọvaar Ibinọkpaabyi wọ mgbaakẹ minna.<verse eid="HOS 11:11" /></para>
  <para style="s1">Epyibha ch'anọng p'Israẹl</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12" />Anọng p'Ephraim kk'afọra atima akọbh-m ake k'ettem,</para>
  <para style="q2" vid="HOS 11:12">anọng p'Israẹl atima ẹbọhra ator-m.</para>
  <para style="q1" vid="HOS 11:12">Anọng p'Juda z'okwubha, magaangẹ nso atima ator Ibinọkpaabyi,</para>
  <para style="q2" vid="HOS 11:12">magaangẹ nso maa, matima ator kẹ nwo kw'owur-owur kw'od-obe k'odik kwẹ.<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1" />Ọttọhk kpenamkpen f'anọng p'Ephraim asi, k'eden kod-oyin,</para>
  <para style="q2" vid="HOS 12:1">bẹ mad-atima ewu kibungọ makwubh ebum ch'ẹbhaakẹ ch'ewuchen ed-eyin,</para>
  <para style="q2" vid="HOS 12:1">mabir asi afọra k'ẹmma, ọttara ikọrdik.</para>
  <para style="q1" vid="HOS 12:1">Mad-asi nttọhna amaana Asiriya</para>
  <para style="q2" vid="HOS 12:1">mabir atọhm ana p'oliv z'Ijip.<verse eid="HOS 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2" />Ọvaar Ibinọkpaabyi oyen aponga p'm'oyerẹ Juda;</para>
  <para style="q2" vid="HOS 12:2">m'ọnang Jekọb irem otor k'osisi kwẹ,</para>
  <para style="q2" vid="HOS 12:2">obir otuk-ẹ otor k'ose kw'ẹ́mmáaná-tama chẹ ede.<verse eid="HOS 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3" />K'ogbe kw'oning z'ọkka k'ẹbhọr, kẹ ọbọk ọgbaanotte k'ebhokọhrọ,</para>
  <para style="q2" vid="HOS 12:3">k'ogbe kw'ikk'ọbara, orima ọmaana Ibinọkpaabyi.<verse eid="HOS 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4" />Wa orim ọmaana ozeng-eden kw'Ọvaar Ibinọkpaabyi maa, okem-ẹ;</para>
  <para style="q2" vid="HOS 12:4">obhom ẹmọng okwukọ ozeng-eden nwo bẹ́, ọkkaan-ẹ.</para>
  <para style="q1" vid="HOS 12:4">Ottema ọmaana Ibinọkpaabyi z'Bẹtẹl,</para>
  <para style="q2" vid="HOS 12:4">Ibinọkpaabyi ọgbaak odik ọmaan-ẹ za.<verse eid="HOS 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5" />Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir,</para>
  <para style="q2" vid="HOS 12:5">Ọvaar Ibinọkpaabyi wọ ode eche chẹ!<verse eid="HOS 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6" />Ofona nya, bọnga mm'akpa nnam ator Ibinọkpaabyi kwabọnga;</para>
  <para style="q2" vid="HOS 12:6">màchina ororo k'ọdaakẹ kwabọnga ọmaana idik s'itor-otor,</para>
  <para style="q2" vid="HOS 12:6">mabir aninga atik Ibinọkpaabyi kwabọnga k'ogbe kpenamkpen.<verse eid="HOS 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7" />Ozeng-ẹphya od-otima ọgbangbang kw'ina ọbaan, oyoma ekpo,</para>
  <para style="q2" vid="HOS 12:7">kẹ ọd-ọdaak-ẹ bẹ́, ottukọ ọnọng.<verse eid="HOS 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8" />Ephraim od-osi ẹmma bẹ́,</para>
  <para style="q2" vid="HOS 12:8">“Kaam ojibh-m mawuriji. Kaam n'nde ọnọng kw'oyen oyena mawuriji.</para>
  <para style="q1" vid="HOS 12:8">Ọnọng itama saam mòze, wanẹma, epyibha ch'kaam k'ifor,</para>
  <para style="q2" vid="HOS 12:8">okurọ oyena nwa kwaam maphyir.”<verse eid="HOS 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9" />“Kaam kk'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga nda</para>
  <para style="q2" vid="HOS 12:9">tọma z'ogbe kw'mabin z'Ijip;</para>
  <para style="q1" vid="HOS 12:9">kaam m'nsi bọnga mabir aruk k'okkira,</para>
  <para style="q2" vid="HOS 12:9">mach'iwu njo s'iwa mad-asi odidaama kwabọnga.<verse eid="HOS 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10" />Kaam mgbaakẹ odik nnang agbaak-ettem ch'Ibinọkpaabyi,</para>
  <para style="q2" vid="HOS 12:10">nkọhka bẹ idik saabhada</para>
  <para style="q2" vid="HOS 12:10">mbira ntima bẹ mgbaak nzẹmẹ.”<verse eid="HOS 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11" />Ma, Gilead osi ẹyaaka o?</para>
  <para style="q2" vid="HOS 12:11">Anọng pẹ ọttọhk áfẹ̀ kabang!</para>
  <para style="q1" vid="HOS 12:11">Ma, mad-atima abhaam afọhnọ nja z'Gilgal o?</para>
  <para style="q2" vid="HOS 12:11">Ọja-byi fabẹ m'ode mach'atakkin</para>
  <para style="q2" vid="HOS 12:11">p'aning k'owonọ kw'matubh-otubh.<verse eid="HOS 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12" />Jekọb ọrọbhọ ozeng z'ẹkọma ch'Aram;</para>
  <para style="q2" vid="HOS 12:12">Israẹl osi agbugbina pira ọtọka kwanọng,</para>
  <para style="q2" vid="HOS 12:12">obir okkerẹ arọkimaan otima ọnang ẹba-phya chẹ.<verse eid="HOS 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13" />Ọvaar Ibinọkpaabyi otim ọgbaak-ettem ch'Ibinọkpaabyi otima anọng p'Israẹl obina z'Ijip,</para>
  <para style="q2" vid="HOS 12:13">obir otima ọgbaak-ettem ch'Ibinọkpaabyi okkerẹ bẹ.<verse eid="HOS 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14" />Okenaka, Ephraim kk'ettem ọsa epyibh Ibinọkpaabyi kwẹ mawuriji.</para>
  <para style="q2" vid="HOS 12:14">Ọvaar Ibinọkpaabyi kwẹ m'ọttẹ-ẹ ọbọhk ọtọka irem k'ọzẹ f'okibhẹ</para>
  <para style="q2" vid="HOS 12:14">obir ọnang-ẹ irem k'ẹnọng-myaana chẹ.<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s1">Ottempyibha kw'Ọvaar Ibinọkpaabyi m'otima otor anọng p'Israẹl</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1" />K'ogbe kw'Ephraim ọgbaak odik, anọng ad-afọnọ-ọfọn k'ifor;</para>
  <para style="q2" vid="HOS 13:1">wa matin-ẹ k'ẹrọng z'Israẹl.</para>
  <para style="q2" vid="HOS 13:1">Okenaka, okwu otto k'epinẹ ch'okpobh Baal, ofona nya, ope.<verse eid="HOS 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2" />Machina ororo asi mpyibha;</para>
  <para style="q2" vid="HOS 13:2">matima silva pabẹ asi akpata anang ifor sabẹ,</para>
  <para style="q1" vid="HOS 13:2">matima ezonga marabha agbagba,</para>
  <para style="q2" vid="HOS 13:2">mbyo maphyir ede itọhmbọhk s'amengkkanọng.</para>
  <para style="q1" vid="HOS 13:2">Mad-aben odik kw'anọng mba bẹ́,</para>
  <para style="q2" vid="HOS 13:2">“Bẹ mad-atima ayokinọng afọhnọ nja!</para>
  <para style="q2" vid="HOS 13:2">Mad-abaaka akpata p'abhaamva!”<verse eid="HOS 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3" />Ofona nya, bẹ mm'ade mach'ebonọ ch'ekpebha,</para>
  <para style="q2" vid="HOS 13:3">mm'ade mach'ifọhng s'ekpebha s'id-ininga k'egbeva,</para>
  <para style="q2" vid="HOS 13:3">mm'ade mach'abhera p'magwum z'ọgbaarẹ kw'nd-aduk wit,</para>
  <para style="q2" vid="HOS 13:3">mm'ade mach'izizong s'izeng k'ọmma kw'ofum iyin k'iyaan.<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4" />“Okenaka, kaam wọ nde Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabọnga</para>
  <para style="q2" vid="HOS 13:4">tọma z'ogbe kw'mabin z'Ijip.</para>
  <para style="q1" vid="HOS 13:4">Bọnga m'ọttọhk ọdọk-ọdọk màkpobha kw'ọkpanẹ kaam Ibinọkpaabyi,</para>
  <para style="q2" vid="HOS 13:4">m'ọkkaan kpenamkpen màbira atin, kw'ọkpanẹ kaam.<verse eid="HOS 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5" />Kaam wọ nkkerẹ bọnga z'ibyi s'anọng nna arukọ,</para>
  <para style="q2" vid="HOS 13:5">z'izek s'asi nnade.<verse eid="HOS 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6" />K'ogbe kw'nnangẹ bẹ ọchattọhk, machi maa madọhbh;</para>
  <para style="q2" vid="HOS 13:6">ch'nkk'adọhbha o, makwu ayena ẹgaga;</para>
  <para style="q2" vid="HOS 13:6">minna kw'mazeng azaam-m.<verse eid="HOS 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7" />Ofona nya, kaam m'nde mach'eche nnang bẹ,</para>
  <para style="q2" vid="HOS 13:7">m'mbir nde mach'ochenyang kw'otubh k'ọbhaang otik ayok-nten.<verse eid="HOS 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8" />Kaam m'nde mach'eten-tama ch'manẹ-ẹ iva pẹ</para>
  <para style="q2" vid="HOS 13:8">kaam m'nrima bẹ ábẹ̀, mbhaaka mmọr sabẹ;</para>
  <para style="q1" vid="HOS 13:8">kaam m'nchi bẹ mach'eche,</para>
  <para style="q2" vid="HOS 13:8">etentama m'ẹyaakẹ bẹ k'akpa k'akpa.<verse eid="HOS 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9" />“Kwọ kk'ọsa e, Israẹl,</para>
  <para style="q2" vid="HOS 13:9">ch'akpa nnam abọra kaam oyenẹ, kaam kw'nde ọkkaan kwọ.<verse eid="HOS 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10" />Ọvaarnọng kwọ kẹ o, ọfha ọkkaan-ọ?</para>
  <para style="q2" vid="HOS 13:10">Abaabh p'ibhon sọ maphyir kẹ o,</para>
  <para style="q1" vid="HOS 13:10">p'ad-aben bẹ́,</para>
  <para style="q2" vid="HOS 13:10">‘Nang-m ọvaarnọng abir anang-m ajinọngva p'ọvaarnọng’?<verse eid="HOS 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11" />Nya o, ntima ottempyibha nnang-ọ ọvaarnọng,</para>
  <para style="q2" vid="HOS 13:11">mbir ntima ottempyibha kwaam kwiden, ntọk-ẹ ntima mfona.<verse eid="HOS 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12" />Maye epyibha ch'Ephraim oye,</para>
  <para style="q2" vid="HOS 13:12">makkẹrẹ mpyibha sẹ k'nnwẹr aye.<verse eid="HOS 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13" />Iremse s'kwanọng ọd-ọtọka k'ogbe kw'ọmaan, jẹ jọ ikebh-ẹ,</para>
  <para style="q2" vid="HOS 13:13">okenaka, kẹ ode nnwa kw'ina ezonga oyen;</para>
  <para style="q1" vid="HOS 13:13">óde ópyirẹ k'ogbe kw'ọmaan,</para>
  <para style="q2" vid="HOS 13:13">edikzonga koyen ch'im'otima oyin k'iyaan z'ẹbhọr.<verse eid="HOS 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14" />“Kaam m'nkkaana nrọbha bọnga k'ẹfa ch'obo;</para>
  <para style="q2" vid="HOS 13:14">m'nkkaana bọnga manaanga k'ẹfa epekwuk.</para>
  <para style="q1" vid="HOS 13:14">Kọ obo, itama sọ kẹ o?</para>
  <para style="q2" vid="HOS 13:14">Kọ epekwuk, ẹfa chọ kẹ o?</para>
  <para style="b" vid="HOS 13:14" />
  <para style="q1" vid="HOS 13:14">“Kaam inọngkwo ọdọk mìnyena mmaana bọnga,<verse eid="HOS 13:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15" />zaa wura ojibh-ẹ ọyọhnga ivotte.</para>
  <para style="q1" vid="HOS 13:15">Ebum ch'efon z'Ọvaar Ibinọkpaabyi z'ẹbhaakẹ ch'ewuchen ed-eyin, ekwuma,</para>
  <para style="q2" vid="HOS 13:15">m'ẹtọma z'ibyi s'anọng nna arukọ egwuma;</para>
  <para style="q1" vid="HOS 13:15">ekeka chẹ, ọdọk asi mèyin</para>
  <para style="q2" vid="HOS 13:15">esipe chẹ m'ebir ẹkka.</para>
  <para style="q1" vid="HOS 13:15">Ikaanga sẹ m'iwor ọttọhk kpenamkpen f'ọbarẹ odik.<verse eid="HOS 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16" />Anọng p'Samariya m'atọka irem k'mpyibha sabẹ,</para>
  <para style="q2" vid="HOS 13:16">okurọ bẹ́, nkk'eso agaanga amaana Ibinọkpaabyi kwabẹ.</para>
  <para style="q1" vid="HOS 13:16">Akkangkkang bọ p'mm'atima afhọ bẹ;</para>
  <para style="q2" vid="HOS 13:16">mm'anyunọ ivava pabẹ amaam ny'izek,</para>
  <para style="q2" vid="HOS 13:16">mm'abhaaka mmọr s'panọng pabẹ p'atim ibhọr.”<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s1">Akpen obhubhona m'atima ẹda akwu</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1" />Israẹl o, màkpa nnam z'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwabọnga.</para>
  <para style="q2" vid="HOS 14:1">Mpyibha sabọnga jọ iwọhkọ bọnga matto!<verse eid="HOS 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2" />Màtima nkwukọ</para>
  <para style="q2" vid="HOS 14:2">kpa nnam z'Ọvaar Ibinọkpaabyi.</para>
  <para style="q1" vid="HOS 14:2">Màben-ẹ bẹ́,</para>
  <para style="q2" vid="HOS 14:2">“Bina nang mpyibha samina maphyir,</para>
  <para style="q1" vid="HOS 14:2">abira atọka mina k'ottemlebh</para>
  <para style="q2" vid="HOS 14:2">mfha motima ẹmma chamina, ọtọhng-ọ.<verse eid="HOS 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3" />Asiriya mina mòkpo ọkkaana,</para>
  <para style="q2" vid="HOS 14:3">m'ọdọk nnyanya mòvura bẹ́, moyin egbong.</para>
  <para style="q1" vid="HOS 14:3">Ogbe kode kw'mm'obir oben</para>
  <para style="q2" vid="HOS 14:3">ekpo py'mbọhk samina isi bẹ́, ‘Aka pamina’</para>
  <para style="q2" vid="HOS 14:3">okurọ bẹ́, anọng p'nna ab'otte ayen, mad-ayena ikwosisi ny'ikọ.”<verse eid="HOS 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4" />“Kaam m'nsi bẹ makpọka ewéna chabẹ,</para>
  <para style="q2" vid="HOS 14:4">m'mbir nkọhka bẹ ọdaakẹ kw'ofon-m z'ettem,</para>
  <para style="q2" vid="HOS 14:4">okurọ bẹ́, ottempyibha kw'nyen mmaana bẹ́, kk'aam ọsa z'ettem.<verse eid="HOS 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5" />Kaam m'nde mach'ifọhng nnang Israẹl;</para>
  <para style="q2" vid="HOS 14:5">kẹ m'ovoma mach'azizaarẹ p'akekakonga.</para>
  <para style="q1" vid="HOS 14:5">K'ose kw'Sida kw'Lẹbanọn ode,</para>
  <para style="q2" vid="HOS 14:5">minna kw'aranga pẹ m'adim z'izek,<verse eid="HOS 14:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6" />amenẹ pẹ m'agorọ.</para>
  <para style="q1" vid="HOS 14:6">Ajibhada pẹ m'ade mach'ochi kw'oliv,</para>
  <para style="q2" vid="HOS 14:6">eruk chẹ elebh mach'sida kw'Lẹbanọn.<verse eid="HOS 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7" />Anọng m'abir akwu aruk ny'ofokodo kwẹ;</para>
  <para style="q2" vid="HOS 14:7">m'ojibh ọnang bẹ mach'akpomọma,</para>
  <para style="q1" vid="HOS 14:7">mm'avoma mach'ochi kw'grep,</para>
  <para style="q2" vid="HOS 14:7">Israẹl m'oyin eche mach'atuk p'Lẹbanọn.<verse eid="HOS 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8" />Ephraim, kaam m'mbira ntima aka nsi mbọng o?</para>
  <para style="q2" vid="HOS 14:8">Kaam m'nnang-ẹ ẹpọhna, mbira nkker-ẹ.</para>
  <para style="q1" vid="HOS 14:8">Kaam nde mach'ochi kw'Juniper kw'ovom-ovomọ;</para>
  <para style="q2" vid="HOS 14:8">ọkkọkka kwọ ofon k'kaam.”<verse eid="HOS 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9" />Anyi wọ ode odikzonganọng ma? Tte idik nja ittaan-ẹ.</para>
  <para style="q2" vid="HOS 14:9">Bọng-ọnọng wọ od-otin idik k'akpen pẹ? Tte ozonga idik nja.</para>
  <para style="q1" vid="HOS 14:9">Nden s'Ọvaar Ibinọkpaabyi itor-otor;</para>
  <para style="q2" vid="HOS 14:9">anọng p'ator-otor ad-azenga ny'nden njo,</para>
  <para style="q2" vid="HOS 14:9">ńnòde anọng p'agaangẹ nso, mm'asira nya, matto.<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>