<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Mbembe Adun [MFNAdun]</book>
  <para style="h">Ichedendik</para>
  <para style="toc1">Nnwẹr kw'Ichedendik</para>
  <para style="toc2">Ichedendik</para>
  <para style="mt1">Nnwẹr kw'Ichedendik</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">Ẹtọma ch'iyagbin</para>
  <para style="pi">
    <verse number="1" style="v" sid="GEN 1:1" />Wa k'ẹtọma, Ibinọkpaabyi ọbhaak ẹrọng ọttara izek. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Ny'ogbe nwo, ọttọhk kpenamkpen kode, iyagbin itte eje. Ibyi kpenamkpen ipyi ewu <char style="it">bẹ́ kkang</char>. Egwugwuma ch'Ibinọkpaabyi ed-ezenga ẹkọbha asi.<verse eid="GEN 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 1:3" />Pira Ibinọkpaabyi oben bẹ́, “Tte ọyaanttaana oyin.” Ọyaanttaana oyin. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Ibinọkpaabyi oze bẹ́, ọyaanttaana nwo kk'ojibha. Tọma ny'ogbe nwo, Ibinọkpaabyi ọbhaangẹ ọyaanttaana z'orungibanga. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Oyerẹ ọyaanttaana nwo bẹ́, ẹya, obir oyerẹ orungibanga bẹ́, erungọ. Ewu ndo epyi, esobha. Nya wọ ode echedenwu m'iyagbin.<verse eid="GEN 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 1:6" />Ibinọkpaabyi obir oben bẹ́, “Tte ẹbhaangẹ eninga ch'im'esok asi k'ibyi ifa.” <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />Minna kw'Ibinọkpaabyi ọbhaangẹ asi p'izek-izek z'asi p'ẹrọng. Okwu ode minna. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Ibinọkpaabyi oyerẹ ẹbhaangẹ ndo bẹ́, ọrọngkpakpa. Ewu ndo epyi, esobha. Nya wọ ode ewu ch'ettong mfa m'iyagbin.<verse eid="GEN 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 1:9" />Ibinọkpaabyi obir oben bẹ́, “Tte asi p'aning izek-izek kw'ọrọngkpakpa, makwu atobha k'ibyi majanẹ, mfha ogbin oyin.” Okwu ode minna. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Ibinọkpaabyi oyerẹ ogbin nwo bẹ́, izek, obir oyerẹ asi mbo p'nkk'atobha bẹ́, araanga piden. Ibinọkpaabyi oze bẹ́, kk'ojibha.<verse eid="GEN 1:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="GEN 1:11" />Ibinọkpaabyi obir oben bẹ́, “Tte ekpo k'akira k'akira emen m'izek: azizaarẹ p'mm'awọm amọma, ọmaana nchi s'im'iwọm aduk, ọttara eborakpo py'im'ẹwọm amọma k'okira kwabẹ.” Okwu ode minna. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Izek imen azizaarẹ ọmaana ekpo k'akira k'akira ọttara nchi s'id-iwọm aduk ọttara amọma k'okira kwabẹ. Ibinọkpaabyi oze bẹ́, kk'ojibha. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Ewu ndo epyi, esobha. Nya wọ ode ewu ch'ettong ittaan m'iyagbin.<verse eid="GEN 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 1:14" />Ibinọkpaabyi obir oben bẹ́, “Tte mkpon ininga z'ọrọngkpakpa s'im'ibhaangẹ ẹya z'erungọ. Tte mkpon njo ide ẹkọhka ch'nyọhm s'ididaamawu, ọmaana iwu, ọttara ocho. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Tte mkpon njo inna z'ọrọngkpakpa, mfha inang ọyaanttaana k'iyagbin.” Okwu ode minna. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Ibinọkpaabyi osi mkpon mfa siden: ndo ch'ẹbar-ọbar ẹbaabha ẹya, ch'ẹcham-ọchamẹ ẹbaabha erungọ. Obir osi ndidorọ. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Ibinọkpaabyi osok mkpon njo z'ọrọngkpakpa bẹ́, imaanẹ k'izek, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />ọfha ibaabha ẹya, ọttara erungọ, ibir ibhaangẹ ọyaanttaana z'orungibanga. Ibinọkpaabyi oze bẹ́, kk'ojibha. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />Ewu ndo epyi, esobha. Nya wọ ode ewu ch'ettong nna m'iyagbin.<verse eid="GEN 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="GEN 1:20" />Ibinọkpaabyi obir oben bẹ́, “Tte nten k'akira k'akira s'ining akpen, ifu ny'asi <char style="it">bẹ́ tap.</char> Tte ọnọhn oninga f'im'okwur z'ẹrọng.” <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Minna kw'Ibinọkpaabyi osi nten siden osok k'araanga, obir osi nten njo maphyir k'akira k'akira s'ifu ny'araanga, ọttara ọnọhn k'akira k'akira. Ibinọkpaabyi oze bẹ́, kk'ojibha. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />Ibinọkpaabyi osi nten njo maphyir s'ikk'ọsa ittabọhng, oben bẹ bẹ́, “Màmaan k'ọsaabh, mànyaamẹ k'araanga piden maphyir. Tte ọnọhn obir ọsaabh ny'iyagbin.” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Ewu ndo epyi, esobha. Nya wọ ode ewu ch'ettong ichen m'iyagbin.<verse eid="GEN 1:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 1:24" />Ibinọkpaabyi obir oben bẹ́, “Tte nten k'akira k'akira s'ining akpen, iyin z'izek: etirakpo ọmaana nten s'ẹgba, ọttara nten s'itim ẹbhọr izenga.” Okwu ode minna. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Ibinọkpaabyi osi mgbaten k'okira kwabẹ, obir osi etirakpo k'okira kwabẹ, osi ọttọhk kpenamkpen f'ọd-ọnaangẹ k'izek k'okira kwabẹ. Ibinọkpaabyi oze bẹ́, kk'ojibha.<verse eid="GEN 1:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="GEN 1:26" />Nya o, Ibinọkpaabyi oben bẹ́, “Tte mosi ayokinọng made mach'mina, mabir akerẹ mina. Tte màbaabha nten s'asi, ọmaana ọnọhn f'ẹrọng, ọmaana etirakpo, ọmaana mgbaten maphyir, ọttara ekpo mbyoza maphyir py'ẹd-ẹnaangẹ k'izek.”<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />Minna kw'uwa Ibinọkpaabyi osi ayokinọng made mach'ikẹ,</para>
  <para style="q2" vid="GEN 1:27">osi bẹ made mach'ikẹ Ibinọkpaabyi,</para>
  <para style="q2" vid="GEN 1:27">osi ojinọng ọmaana kwanọng.<verse eid="GEN 1:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="GEN 1:28" />Ibinọkpaabyi osi bẹ ittabọhng, oben bẹ bẹ́, “Màmaan iva k'ọsaabh, màfu izek, mabir abaabha iyagbin. Màbaabha nten s'asi, ọmaana ọnọhn f'ẹrọng ọttara ọttọhk kpenamkpen f'ozeng m'izek.”<verse eid="GEN 1:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="GEN 1:29" />Nya o, Ibinọkpaabyi oben bẹ́, “Màyonga itọhng! Kaam kk'bọnga eborakpo maphyir py'ẹd-ẹwọm-ọwọm m'iyagbin nnanga; mbir nnang bọnga nchi maphyir s'iwọmọ aduk ibir iyena amọma z'ẹtaanga. Nnang bọnga mach'ọchattọhk fabọnga. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Ṉ́nòde nten maphyir m'izek, ọmaana ọnọhn f'ẹrọng, ọttara ọttọhk kpenamkpen f'ozeng m'izek obir oruk akpen, nnang bẹ okwongitọhng kpenamkpen bẹ́, machi mach'ọchattọhk fabẹ.” Okwu ode minna.<verse eid="GEN 1:30" /></para>
  <para style="pi">
    <verse number="31" style="v" sid="GEN 1:31" />Ibinọkpaabyi oze bẹ́, ọttọhk kpenamkpen f'ikk'ọsa, kk'ojibha mawuriji. Ewu ndo epyi, esobha. Nya wọ ode ewu ch'ettong ichadanẹ m'iyagbin.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Minna kw'uwa Ibinọkpaabyi ocher ọtọhm f'ẹrọng ọmaana izek osisi, ọttara ekpo maphyir py'ening ny'ẹtaanga.<verse eid="GEN 2:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 2:2" />Ny'ewu ndo ch'ettong ichenọmfa, Ibinọkpaabyi kk'ọtọhm f'od-osi ochera. Ofona nya o, okwoka ọwọhng k'ọtọhm fẹ maphyir ny'ewu ndo. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Minna kw'Ibinọkpaabyi odo ewu ndo ch'ettong ichenọmfa, obir osok dẹ mach'ewu ch'ewur-owur, okurọ ch'iwa okwok ọwọhng k'ọtọhm f'ekpo maphyir obhubhaaka ny'ewu ndo.<verse eid="GEN 2:3" /></para>
  <para style="s">Ose kw'uwa Ibinọkpaabyi osi achedennọng</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />Ma wọ ode ose kw'uwa Ibinọkpaabyi ozeng ọbhaaka ẹrọng ọttara izek.</para>
  <para style="b" vid="GEN 2:4" />
  <para style="p" vid="GEN 2:4">K'ogbe kw'Ọvaar Ibinọkpaabyi ọbhaak izek ọmaana ẹrọng, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />wa ọttọhk kpenamkpen ny'izek otim omena, echi kede ch'ebir ekpong emen, okurọ bẹ́, wa Ọvaar Ibinọkpaabyi ẹrọng ny'izek otim otebha, ọnọng kobir oninga kw'osi ọtọhm ny'izek. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />Okenaka, wa asi ad-ayin z'izek, masi izek maphyir idirẹ.<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />Nya o, Ọvaar Ibinọkpaabyi otima ididọhbh oyok ojinọng, pira ogwuma iwọhng s'akpen ọkẹ-ẹ ny'asungmma. Ojinọng nwo okwu ode oyokinọng kw'oning akpen.<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />Ọvaar Ibinọkpaabyi osi owonọ z'ẹbhaakẹ ch'ewuchen ed-eyin, za ch'mayerẹ Iden, pira ọtọka ọnọng nwo kw'ikk'ọsa osok nya. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Minna kw'Ọvaar Ibinọkpaabyi osi nchi k'akira k'akira imen ny'izek njo, nchi s'ijibhẹ ekkerẹ, ọttara s'ibaan k'ẹcha. Ny'ewonittem ndo, echi ch'akpen ebe nya, ọttara echi ch'ezonga ch'ejibha ọmaana ch'itama.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Ọraanga kw'ọd-ọnang owonọ nwo asi, ọd-ọtọma z'Iden obhobh maa okwu ọbhaangẹ k'ibyi nna. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Ọraanga kw'ocheden okpen Pishọn; kẹ od-obhobh ọkọbha izek s'Havila, za ch'gol oning. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />Gol kw'oning ny'izek njo, ojibh-ojibh, ana p'alebhẹ eruk, ọttara ata p'ajibhẹ mach'oniks, mabir aninga nya. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Ọraanga kw'ottong afa, okpen Gihọn, kw'obhobhọ ọkọbha izek s'Kush maphyir. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Ọraanga kw'ottong attaan, okpen Tigiris, kw'obhobhọ ochina z'ẹbhaakẹ ch'ewuchen ed-eyin, za ch'otum Asiriya. Ọraanga kw'ottong anna, okpen Yupharetes.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Ọvaar Ibinọkpaabyi, ọtọka ọnọng nwo kw'ikk'ọsa, osok ny'owonọ nwo kw'Iden bẹ́, osi ọtọhm nya, obir okkerẹ wẹ. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Minna kw'Ọvaar Ibinọkpaabyi oben ọnọng nwo bẹ́, “Kaam nttọ-ọ ọbọhk bẹ́, achi ochiduk kw'echi kpenamkpen m'owonọ nwa. <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />Ṉ́nòde aduk p'echi ndo ch'ezonga ch'ejibha ọmaana ch'itama, kàchi, kirẹ, óde achi aduk p'echi ndo, ny'ewu ndo, m'apope.”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Nya o, Ọvaar Ibinọkpaabyi oben bẹ́, “Kojibhẹ bẹ́, ojinọng oninga manchenẹ; kaam m'nsi oyok-ẹkaan kw'ọbaan-ẹ.”<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />M'ogbese nwa, Ọvaar Ibinọkpaabyi kk'mgbaten maphyir ọsa, ọmaana ọnọhn f'ẹrọng, ọtọka bẹ ochena ọnọng nwo bẹ́, okpe bẹ ache. Eche kpenamkpen ch'ojinọng nwo oyerẹ ọttọhk kpenamkpen f'orukọ akpen, dẹ dọ ede eche chẹ. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Minna kw'ojinọng nwo okpe etirakpo, ọmaana ọnọhn f'ẹrọng, ọttara mgbaten maphyir ache.</para>
  <para style="p" vid="GEN 2:20">Ṉ́nòde ojinọng nwo, oyok-ẹkaan kw'ọbaan-ẹ koze. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Nya o, Ọvaar Ibinọkpaabyi osi ojinọng nwo otto ọda <char style="it">bẹ́ ttoobh</char>. Ch'oning nya ọttaabh ọda, ọrọbha otitaanchakpa wanẹ kwẹ, otima ẹkpakpa obubha ibyi njo. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Ọvaar Ibinọkpaabyi otima otitaanchakpa nwo kw'ikk'ọrọbha ny'ojinọng k'ifor, osi kwanọng, ọtọk-ẹ ochena ọjinọng.<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />Ojinọng nwo oben bẹ́,</para>
  <para style="q1" vid="GEN 2:23">“Ma wọ ode ọkọbhọ kw'akọbhọ paam,</para>
  <para style="q2" vid="GEN 2:23">ọmaana ẹnang ch'anang paam.</para>
  <para style="q1" vid="GEN 2:23">Mmin'ad-ayer-ẹ bẹ́, kwanọng</para>
  <para style="q2" vid="GEN 2:23">okurọ ch'marọhbh-ẹ k'ojinọng k'ifor.”<verse eid="GEN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />Ofona nya, ojinọng m'obina orik otte ọttara ọkka, ọd-ọgbaka ifor ọmaana kwanọng kwẹ, mfha bẹ anọng mbo afa makwu ade mawanẹ.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Wa ojinọng nwo ọttara kwanọng kwẹ mazeng erinikwum, mgbar bẹ kisi.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">Ose kw'oyokinọng ozeng opinẹ Ibinọkpaabyi</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Wa ijọhk jọ iyọhng ẹgbaten kpenamkpen k'nkkaar ny'mgba-nten s'Ọvaar Ibinọkpaabyi ikk'ọsa. Ijọhk njo ibọbh kwanọng bẹ́, “Ma, Ibinọkpaabyi obenẹ bọnga majijik bẹ́, maning ochiduk kw'echi kpenamkpen m'owonọ nwa achi o?”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />Kwanọng nwo ọpọhn-ẹ bẹ́, “Ibinọkpaabyi otte mina ọbọhk bẹ́, mochi achiduk mba maphyir, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />okenaka, obenẹ bẹ́, moning achiduk p'echi ndo ch'ebe ny'ewonittem ochi, moning ọbọhk obir otwu. Ó̱de m'oyom, mm'opope.”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Ijọhk njo iben kwanọng nwo bẹ́, “M'op'pe màpe, <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />kirẹ, Ibinọkpaabyi ozong bẹ́, óde machi, achen m'attaanẹ bọnga, mm'abir ade mach'ikẹ Ibinọkpaabyi, mazonga f'ode ejibha, ọmaana f'ode itama.”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Ch'kwanọng nwo oze bẹ́, ochiduk nwo ojibhẹ ekkerẹ, obir ọbaana ẹcha, obir ọdaak-ẹ bẹ́, wura ochi ọfha ozonga odik, ọpha aduk banẹ ochi, obir ọtọka banẹ ọnang odim kwẹ, odim obir ochi. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Machi nya o, achen attaanẹ bẹ, mazonga bẹ́, matim erinikwum. Ofona nya o, makwum akwongitọhng p'fig matima abubha ifor sabẹ.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Okwu opyirẹ k'ẹsọhka, ojinọng nwo ọmaana kwanọng kwẹ mabhaanga ntọkọ s'Ọvaar Ibinọkpaabyi ch'od-ozenga ny'owonọ nwo. Mabhaang nya, marọbh atubha ny'nchi s'owonọ nwo. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />Okenaka, Ọvaar Ibinọkpaabyi owon ojinọng nwo bẹ́, “Aning men o?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />Kẹ ọpọhna bẹ́, “Kaam mmaang ntọkọ sọ ch'ad-azenga ny'owonọ, ojora osi-m, okurọ ch'ntim erinikwum. Kẹ wọ osi ntubha.”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />Ibinọkpaabyi ọbọbh-ẹ bẹ́, “Anyi wọ otek-ọ bẹ́, atim erinikwum? Ma, nkk'ochiduk nwo acha kw'ntọrọ bọnga itọhng bẹ́, maning achi o?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Ojinọng nwo ọpọhn-ẹ bẹ́, “Kwanọng nwo kw'anang-m bẹ́, mọtọn oninga ma, kẹ wọ ọnang-m achiduk banẹ p'afon ny'echi ndo, nchi e.”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Nya o, Ọvaar Ibinọkpaabyi oben kwanọng nwo bẹ́, “Bọng-ọttọhk f'asi ma?”</para>
  <para style="p" vid="GEN 3:13">Kwanọng nwo oben bẹ́, “Ijọhk jọ ibọhr-m, pira nchi.”<verse eid="GEN 3:13" /></para>
  <para style="s">Ibinọkpaabyi ọkpaar aponga pabẹ</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Nya o, Ọvaar Ibinọkpaabyi oben ijọhk bẹ́,</para>
  <para style="q1" vid="GEN 3:14">“Okurọ ch'ikk'asa minna, nnang-ọ ẹmma ch'ẹyọhng ch'etirakpo maphyir</para>
  <para style="q2" vid="GEN 3:14">ọmaana mgbaten maphyir.</para>
  <para style="q1" vid="GEN 3:14">Kọ min'ad-atima ẹbhọr azenga,</para>
  <para style="q2" vid="GEN 3:14">m'abira achi izek k'akpen pọ maphyir.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />Kaam m'nsi kọ ọttara kwanọng maninga k'iwawuna,</para>
  <para style="q2" vid="GEN 3:15">iva pẹ ọttara iva pọ, mm'abira awuna ayok.</para>
  <para style="q1" vid="GEN 3:15">Kẹ m'ọvọhk-ọ eso,</para>
  <para style="q2" vid="GEN 3:15">kọ m'abir agaak-ẹ k'ebhokọhrọ.”<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Ibinọkpaabyi oben kwanọng bẹ́,</para>
  <para style="q1" vid="GEN 3:16">“Kaam m'nttar-ọ irem siden k'ogbe kw'ọmaan,</para>
  <para style="q2" vid="GEN 3:16">kọ min'ad-atọka irem k'ogbe kw'im'amaan iva.</para>
  <para style="q1" vid="GEN 3:16">Zaabẹ́ aze irem yen, m'ọdaak-ọ z'ettem bẹ́, agbaka ifor amaana odim,</para>
  <para style="q2" vid="GEN 3:16">kẹ m'obir ọbaabh-ọ.”<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Ibinọkpaabyi oben Adam bẹ́, “Kọ ayong itọhng k'odik kw'kwanọng kwọ, achi ochiduk nwo kw'ntor-ọ itọhng bẹ́, aning achi.</para>
  <para style="q1" vid="GEN 3:17">Ofona nya, kk'izek ẹmma nnanga okurọ kọ.</para>
  <para style="q2" vid="GEN 3:17">M'atọka irem pira achi ọttọhk f'ofon ny'izek njo,</para>
  <para style="q2" vid="GEN 3:17">k'akpen pọ maphyir.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Akkaangẹ ọmaana azizaaritama m'amen ny'izek,</para>
  <para style="q2" vid="GEN 3:18">kọ m'abir achi akwongitọhng p'ẹgba.<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Kọ min'ad-asi ọtọhm maa, arunga,</para>
  <para style="q2" vid="GEN 3:19">pira ayena ọchattọhk,</para>
  <para style="q1" vid="GEN 3:19">matẹtẹma opyirẹ k'ogbe kw'im'akpa nnam z'izek.</para>
  <para style="q1" vid="GEN 3:19">Kirẹ, matim izek asọ-ọ,</para>
  <para style="q2" vid="GEN 3:19">ny'izek jọ s'im'abir akpa nnam.”<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Wa Adam<note caller="+" style="f"><char style="fr" closed="false">3.20 </char><char style="fq" closed="false">Adam </char><char style="ft" closed="false">k'eHiburu oyinẹ bẹ́, ojinọng. </char></note> okpe kwanọng kwẹ bẹ́, Iv<note caller="+" style="f"><char style="fr" closed="false">3.20 </char><char style="fq" closed="false">Iv </char><char style="ft" closed="false">oyinẹ bẹ́, akpen.</char></note>, okurọ bẹ́, kẹ wọ im'okwu ode ọkka kw'anọng maphyir p'aning akpen.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />Ọvaar Ibinọkpaabyi otima ntenkpa osi ẹfọrakpo ọnang Adam ọttara kwanọng kwẹ bẹ́, matima abubha erinikwum chabẹ.<verse eid="GEN 3:21" /></para>
  <para style="s">Ibinọkpaabyi okwubhọ Adam ọmaana Iv z'owonọ kw'Iden</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />Nya o, Ọvaar Ibinọkpaabyi oben bẹ́, “Oyokinọng node mach'amina. Kẹ kk'ejibha ọmaana itama ozonga. M'ikẹ ọbọhk mòtte onemẹ ọbọhk ọpha oduk kw'echi ch'akpen ochi, obir oruk akpen ttattampe.” <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />Ofona nya o, Ọvaar Ibinọkpaabyi okwubh Adam ny'owonọ kw'Iden, bẹ́, od-otubh owonọ ny'izek njo s'otim ọsẹ-ẹ. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Okwubh ojinọng nwo nya o, ọtọka acherubim osok ny'ebhumma ch'owonọ nwo kw'Iden, z'ẹbhaakẹ ch'ewuchen ed-eyin, obir osok ọkkangkkang kw'oyen ekpondaak kw'ọd-ọbhakẹ ẹmma okkerẹ k'ibyi kpenamkpen, mfha ọnọng oning odimẹ opyirẹ za ch'echi ndo ch'akpen ening.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">Odik kw'Ken ọmaana Ebẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Wa Adam oyim ọmaana kwanọng kwẹ kw'ode Iv. Iv otima ibhọr, ọmaan Ken, oben bẹ́, “Ọvaar Ibinọkpaabyi kk'aam ọkkaana, mmaan ojinọng.” <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Obir otima ibhọr, ọmaan Ebẹl kw'otorọ Ken nnam.</para>
  <para style="p" vid="GEN 4:2">Wa Ebẹl od-otir arọkimaan, Ken ode owonitọhmnọng. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />Otum k'ogbe wanẹ, Ken otima achiduk banẹ p'ọpha z'izek bẹ́, ọd-ọnang Ọvaar Ibinọkpaabyi. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Ebẹl ọtọka arọkimaanva banẹ p'ade ifor <char style="it">ma dọrọdọrọ</char>, p'afon k'ichedenbhọr s'arọkimaan pẹ, ọnang Ọvaar Ibinọkpaabyi. Ọvaar Ibinọkpaabyi ọdaam ettem ọmaana Ebẹl ọttara k'ẹnanga chẹ. <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />Ṉ́nòde Ken ọmaana ẹnanga chẹ, Ibinọkpaabyi ettem kelebhẹ. Ofona nya o, Ken ọdọk-ẹ maa, obhor ititika.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />Nya o, Ọvaar Ibinọkpaabyi ọbọbh Ken bẹ́, “Ọd-ọdọk-ọ mbọng o? Osempira abhor ititika? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Wúra asi mawuriji, wura ntọk-ọ ọtọka. Ó̱de ina mawuriji asi, epyibha ẹbaam-ọ nya bẹ́, ẹbọk-ọ. Okenaka, kọ makikema chẹ.”<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Ny'ogbe nwo, Ken oben Ebẹl bẹ́, “Tte moyin z'ẹgba.” Mapyirẹ za o, Ken obina ọbọka ọgbaanọkka Ebẹl k'ẹfa, ọfhọ.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Nya o, Ọvaar Ibinọkpaabyi ọbọbh Ken bẹ́, “Agbaanakka kwọ Ebẹl kẹ?” Ken ọpọhn-ẹ bẹ́, “Kaam kinzong. Ma, kaam wọ nd-nkkerẹ agbaanakka kwaam yirẹ?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Ọvaar Ibinọkpaabyi oben Ken bẹ́, “Bọng-ọttọhk f'asi ma? Ẹmọng ch'izẹ s'agbaanakka kk'ebina ny'izek ekebh-m ka. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Ofona nya, kk'ọ ẹmma nnanga, mbir nkwubh-ọ ny'izek njo s'ikk'ẹmma iwonga bẹ́, itọka izẹ s'agbaanakka ny'ikọ k'mbọhk. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />K'ogbe kw'atubhọ ọttọhk ny'izek, ọttọhk mvo ọdọk kọ mòjibh ọnang. Kọ m'ade ottittenanọng kw'ina ẹwọhngkwoka mòyena m'iyagbin.”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />Ken oben Ọvaar Ibinọkpaabyi bẹ́, “Irem nja s'anang-m ma, ibarẹ iyọhng-m ẹfa. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Menda kk'aam akwubha bẹ́, nning ọdọk izek ọbọhk ntwu, nning ọdọk k'ikọ k'ititika mbe, mbir nde ottittenanọng kw'ina ẹwọhngkwoka oyen m'iyagbin. Ó̱nọng kpenamkpen obir oze-m, m'ọfhọ-m.”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Okenaka, Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, “Minna kode. Ó̱de ọnọ́ng ọfhọ-ọ, kaam m'ntuka, nnang-ẹ irem igbedim ichenọmfa.” Ofona nya o, Ọvaar Ibinọkpaabyi oke Ken ebhora, ọfha ọ́nọ́ng ọzẹ-ẹ, oning-ẹ ọfhọ. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Minna kw'Ken obin ny'ititika s'Ọvaar Ibinọkpaabyi, ottena ochina z'ẹkọma ch'Nọd, ọkpan ẹbhaakẹ ch'ewuchen ed-eyin, z'Iden.<verse eid="GEN 4:16" /></para>
  <para style="s">Efonamma ch'Ken</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Ken oyima ọmaana kwanọng kwẹ. Kwanọng nwo otima ibhọr, ọmaan ojinọngnwa kw'okpen Ẹnọk. Ny'ogbe nwo, wa Ken od-osi obhon, kw'okpe eche ch'nnwa kwẹ, Ẹnọk.<verse eid="GEN 4:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="GEN 4:18" />Wa Ẹnọk obhonọ Irad,</para>
  <para style="q2" vid="GEN 4:18">Irad obhon Mehujayẹl,</para>
  <para style="q2" vid="GEN 4:18">Mehujayẹl obhon Metusayẹl,</para>
  <para style="q2" vid="GEN 4:18">Metusayẹl obhon Lamẹk.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />Wa Lamẹk ọtọk panọng afa, wanẹ okpena Ada, nwoza okpena Zila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Wa Ada ọmaanẹ ojinọngnwa kw'okpen Jabal kw'uwa ode otte kw'anọng mbo p'arukọ k'okkira, p'mabir ad-atir nten. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Ọgbaanọkka kw'Jabal, okpena Jubal, kw'ode otte kw'anọng mbo maphyir p'mad-akir ogim-ogim, mabir aje nsa.<verse eid="GEN 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 4:22" />Zila ọdọk, ọmaan ojinọngnwa kw'okpen Tubal-Ken. Kẹ wọ uwa od-otima opo ọmaana ẹgbaka osi ẹtọhmkpo k'akira k'akira. Ọgbaanọkka kw'Tubal-Ken k'ẹpanọng ode Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Lamẹk oben panọng pẹ bẹ́,</para>
  <para style="q1" vid="GEN 4:23">“Ada ọmaana Zila, màyong-m itọhng;</para>
  <para style="q2" vid="GEN 4:23">Panọng p'Lamẹk màbhaanga idik saam.</para>
  <para style="q1" vid="GEN 4:23">Kaam kk'ojinọng wanẹ mfha okurọ ch'opyi-m ẹbhaak,</para>
  <para style="q2" vid="GEN 4:23">mfhọ odikkobh okurọ ch'omum-m ọttọhk.<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />Ó̱de matuk odik kw'Ken igbedim ichenọmfa,</para>
  <para style="q2" vid="GEN 4:24">kw'Lamẹk, mm'atuka igbedim arọbh attaan okwuma ichi kkamfa.”<verse eid="GEN 4:24" /></para>
  <para style="s">Ẹmmaana ch'Sẹt ọmaana Ẹnọs</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Adam obir oyima ọmaana kwanọng kwẹ. Kwanọng kwẹ otima ibhọr, ọmaan ojinọngnwa kw'ọkpẹ-ẹ Sẹt, oben bẹ́, “Ibinọkpaabyi kk'aam nnwa ọdọk-ọdọk ọnanga kw'ntim ntera Ebẹl kw'uwa Ken ọfhọ.”<verse eid="GEN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 4:26" />Sẹt ọdọk, obhon ojinọngnwa, ọkpẹ-ẹ Ẹnọs.</para>
  <para style="p" vid="GEN 4:26">Ny'ogbe nwo wọ kw'uwa anọng atọm Ọvaar Ibinọkpaabyi okpukpobha.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">Efonamma ch'Adam</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Ma wọ ode nnwẹr kw'ọmaan efonamma ch'Adam.</para>
  <para style="p" vid="GEN 5:1">K'ogbe kw'uwa Ibinọkpaabyi osi ayokinọng, wa osi bẹ maker-ẹ. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Osi bẹ ojinọng ọmaana kwanọng. Osi bẹ ittabọhng, oyerẹ bẹ bẹ́, “Ayokinọng.”<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />K'ogbe kw'Adam ikk'icho arọbh achadanẹ okwuma ijobh oruka, obhon ojinọngnwa kw'oker-ẹ, obir ode mach'ikẹ, ọkpẹ-ẹ Sẹt. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Ch'Adam kk'Sẹt obhona, oruk k'icho nnọhna mfa, obir obhon ajinọngva ọttara panọngva ọdọk ọdọk. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Kibung-kibungọ, wa Adam orukọ k'icho nnọhna mfa okwuma arọbh achadanẹ okwuma ijobh, pira nope.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />K'ogbe kw'Sẹt ikk'icho arọbh achen okwuma icho ichen oruka, nya kw'uwa obhonọ Ẹnọs. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Ch'iwa Sẹt ikk'Ẹnọs obhona, okwu oruk k'icho nnọhna mfa okwuma ichenọmfa, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Kibung-kibungọ, wa Sẹt orukọ k'icho nnọhna mfa okwuma arọbh achen, okwuma ijobh kkamfa, pira nope.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />K'ogbe kw'Ẹnọs ikk'icho, arọbh anna okwuma ijobh oruka, nya wọ kw'obhonọ Kenan. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Ch'Ẹnọs kk'Kenan obhona, obir oruk k'icho nnọhna mfa okwuma ichi, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Kibung-kibungọ, wa Ẹnọs orukọ k'icho nnọhna mfa okwuma arọbh achen okwuma ichen, pira nope.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />K'ogbe kw'Kenan kk'icho arọbh attaan okwuma ijobh oruka, okwu obhon Mahalalẹl. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Ch'Kenan kk'Mahalalẹl obhona, Kenan obir oruk k'icho nnọhna mfa okwuma arọbh afa, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Kibung-kibungọ, wa Kenan orukọ k'icho nnọhna mfa okwuma arọbh achen okwuma ijobh, pira nope.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />K'ogbe kw'Mahalalẹl ikk'icho arọbh attaan okwuma ichen oruka, obhon Jarẹd. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Ch'ikk'Jarẹd obhona, Mahalalẹl obir oruk k'icho nnọhna mfa okwuma ẹrọbh okwuma ijobh, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Kibung-kibungọ, wa Mahalalẹl orukọ k'icho nnọhna mfa okwuma arọbh anna okwuma ichi, pira nope.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />K'ogbe kw'Jarẹd ikk'icho arọbh ochenọnttaan okwuma ifa oruka, obhon Ẹnọk. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Ch'ikk'Ẹnọk obhona, wa Jarẹd orukọ k'icho nnọhna mfa, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Kibung-kibungọ, wa Jarẹd orukọ k'icho nnọhna mfa okwuma arọbh ochenọnttaan okwuma ifa, pira nope.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />K'ogbe kw'Ẹnọk ikk'icho arọbh attaan okwuma achen oruka, obhon Mẹtusẹla. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Ch'ikk'Mẹtusẹla obhona, Ẹnọk ọgbaka ifor ọmaana Ibinọkpaabyi k'icho arọbh ichi, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Kibung-kibungọ, wa Ẹnọk orukọ k'icho arọbh ichi kkanttaan okwuma ichen. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Wa Ẹnọk ọgbak ifor ọmaana Ibinọkpaabyi. Oninga nya, ọnọng ọdọk kẹ koze okurọ ch'Ibinọkpaabyi ọtọk-ẹ otima ofona.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />K'ogbe kw'uwa Mẹtusẹla ikk'icho arọbh osowanẹ okwuma ichenọmfa oruka, nya wọ kw'obhonọ Lamẹk. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Ch'ikk'Lamẹk obhona, wa Mẹtusẹla orukọ k'icho ẹnọhna okwuma arọbh osowanẹ kw'ẹrọbh okwuma ifa, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Kibung-kibungọ, wa Mẹtusẹla orukọ k'icho nnọhna mfa okwuma arọbh ochenọnttaan okwuma osowanẹ, pira nope.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />K'ogbe kw'uwa Lamẹk ikk'icho arọbh osowanẹ okwuma ifa oruka, nya kw'obhonọ ojinọngnwa, <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />ọkpẹ-ẹ Noa, oben bẹ́, “Kẹ wọ im'ofokọ mina nttem k'ọtọhm ọmaana irem s'izek s'Ọvaar Ibinọkpaabyi ikk'ẹmma ọnanga, ichen mina.”<verse eid="GEN 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 5:30" />Ch'iwa Noa kk'ọmmaana, Lamẹk orukọ k'icho ẹnọhna okwuma arọbh osowanẹ okwuma ichi, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Kibung-kibungọ, wa Lamẹk orukọ k'icho ẹnọhna okwuma arọbh ichi kkanttaan okwuma ichi kkamfa, pira nope.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Ch'iwa Noa kk'akpen oruka k'icho ẹnọhna okwuma arọbh achen, nya kw'obhonọ Shẹm, ọmaana Ham, ọttara Japhẹt.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">Nkwurọ s'ayokinọng</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />K'ogbe kw'uwa ayokinọng nkk'atọma osisaabh m'iyagbin, panọngva mabir ammaana. <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />Iva p'Ibinọkpaabyi maze bẹ́, panọngva p'ayokinọng ajibh-ojibh. Ofona nya o, matéka okpenamkpen kw'ọdaakẹ bẹ maba. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />Nya o, Ọvaar Ibinọkpaabyi oben bẹ́, “Egwugwuma chaam ọdọk oyokinọng mèkpo eninga ẹmaana ttattampe; okurọ bẹ́, oyokinọng ode ọkpakpa. Kẹ akpen mòruk ọkpaan icho arọbh achadanẹ.”<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Ny'ogbe nwo, wa <char style="w" lemma="Nephilim">aNephilim</char> aning m'iyagbin. Nya ch'ogbe nwo kk'obir ọkpana, iva p'Ibinọkpaabyi mad-ayima panọngva p'ayokinọng ábẹ̀, mabhon iva. Bẹ bọ iwa made akem-akpa p'ẹtama, mabir ade ajinọng p'ayinẹ eche.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Ọvaar Ibinọkpaabyi oze ose kw'itama s'oyokinọng ikk'ilora m'iyagbin, ọmaana bẹ́, achibhẹ p'ettem chẹ made itama k'ogbe kpenamkpen. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Ifor ipyibh Ọvaar Ibinọkpaabyi, obir ọmmẹ-ẹ z'ettem bẹ́, kk'oyokinọng ọsa osok m'iyagbin. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Ofona nya o, Ọvaar Ibinọkpaabyi oben bẹ́, “Kaam m'ndimẹ ayokinọng maphyir p'ikk'nsa m'iyagbin. M'ndimẹ ayokinọng ọmaana nten, ọmaana ekpo maphyir py'ezeng m'izek, ọttara ọnọhn f'iwokọ, okurọ bẹ́, ọmma-m z'ettem bẹ́, wa kaam kk'bẹ nsa.”<verse eid="GEN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 6:8" />Okenaka, wa Noa ofu Ọvaar Ibinọkpaabyi k'ichen.<verse eid="GEN 6:8" /></para>
  <para style="s">Odik kw'ọmaan Noa</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Ma wọ ode odik kw'ọmaan Noa.</para>
  <para style="p" vid="GEN 6:9">Wa Noa ode ọnọng kw'otor-otor, epinẹ koyen mach'anọng p'arukọ ny'ogbe kwẹ, obir ọgbaka ifor ọmaana Ibinọkpaabyi. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Wa Noa obhonọ ajinọngva attaan, p'ade Shẹm, ọmaana Ham, ọttara Japhẹt.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />Ny'ogbe nwo, Ibinọkpaabyi oze bẹ́, iyagbin maphyir kk'ikibha, ibir ide ẹkọhr-ẹkọhr. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Ibinọkpaabyi oze bẹ́, iyagbin kk'ikibha okurọ bẹ́, ayokinọng maphyir p'aning m'iyagbin nkk'akibha. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Minna kw'Ibinọkpaabyi oben Noa bẹ́, “M'ndimẹ ayokinọng maphyir, kirẹ, iyagbin nide ẹkọhr-ẹkọhr okurọ itama s'ayokinọng. K'odik ọkkọkka, kaam m'ndimẹ bẹ ọttara iyagbin. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Nya o, tima agbaaka p'agaang-ọgaangẹ, kọma ọkpaar kwiden kw'ikọ k'ifor, asi odongọ z'ẹtaanga kwẹ, afoka ana p'apyi <char style="it">bẹ́ kkang</char> mabang-ọbanga, z'ẹtaanga ọmaana k'iyaan. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Minna wọ kw'im'akọma ọkpaar nwo: adum pẹ mm'ade ntọkọ ẹnọhna okwuma arọbh afa okwuma ijobh, ẹkpa chẹ m'ede ntọkọ arọbh attaan okwuma ichi, agoriji pẹ m'ade ntọkọ arọbh afa okwuma nchen. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />M'amin mgbodo kw'im'atima abubha ọkpaar nwo. Tọma z'akpaar-bem pyirẹ ny'mgbodo, sok obhokọ kw'im'ode ẹtọkọ kibungọ ọmaana igboka. Sok ọmma k'ẹbhaakẹ danẹ ch'ọkpaar nwo, abir asi agbaarẹ ny'izek-izek, wanẹ ny'njeka, nwoza z'ẹrọng. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />Kirẹ, kaam m'ntima ẹnwanwa nchi iyagbin maphyir. Ẹnwanwa ndo m'ekibhẹ ọttọhk kpenamkpen f'ọgwọkọ iwọhng f'oning nya. Ọttọhk kpenamkpen f'oning m'iyagbin m'ope. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Ṉ́nòde kọ, kaam m'nsi Echekẹ mmaan-ọ. Kọ m'adim ny'ọkpaar nwo, kọ ọmaana ajinọngva pọ, ọmaana kwanọng kwọ, ọttara panọng p'ajinọngva pọ. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Ekpo maphyir py'eruk akpen, k'ejinọng ọttara k'ẹpanọng, byẹ py'matima ẹfa-ẹfa adim ny'ọkpaar nwo, mfha eruk akpen ẹmaan-ọ. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Odimkwẹ, ọmaana ikwakwẹ kw'ọnọhnkira kpenamkpen, ọmaana kw'otenkira kpenamkpen, ọmaana kw'ọttọhkkira kpenamkpen f'ozeng m'izek, m'etor-ọ madim nya, mfha eninga akpen. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />M'atima ọttọhkkira kpenamkpen f'ẹcha, f'im'aye mach'ọchattọhk f'ikọ ọttara bẹ, mm'achi.”<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Noa osi ọttọhk kpenamkpen mbengana k'ose kw'Ibinọkpaabyi ọtọhn-ẹ.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">Ose kw'uwa asi achi iyagbin</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Ọvaar Ibinọkpaabyi okwu oben Noa bẹ́, “Tima ẹsọhmmọr chọ kibungọ dim ny'ọkpaar nwo; kaam kk'nza bẹ́, m'iyagbin maphyir, kọ-kọ wọ asi idik s'itor-otor. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Tọka nten mfa-mfa k'ibyi ichenọmfa s'otenkira kpenamkpen kw'ọbaan k'ẹja ofufọhnọ, odim kwẹ ọmaana ikwakwẹ, ọttara nten mfa s'otenkira kpenamkpen kw'ina k'ẹja ofufọhnọ, ọbaan, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />abir atọka ọnọhn ọfa-ọfa k'ibyi ichenọmfa f'ọnọhnkira kpenamkpen, odimkwẹ ọttara ikwakwẹ, atima adim za, mfha otenkira kpenamkpen oninga akpen m'iyagbin maphyir. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Ó̱de iwu ichenọmfa ikk'ikpana, kaam m'ntebh ẹrọng m'iyagbin k'iwu arọbh afa, ọmaana irungiwu arọbh afa, mbir ndimẹ ọttọhk kpenamkpen f'oning akpen f'ikk'nsa m'iyagbin.”<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />Noa osi ọttọhk kpenamkpen mbengana k'ose kw'Ọvaar Ibinọkpaabyi ọtọhn-ẹ.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />Wa Noa ode icho ẹnọhna okwuma arọbh ijobh k'atam, k'ogbe kw'asi achi iyagbin. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Noa ọmaana ajinọngva pẹ, ọmaana kwanọng kwẹ, ọmaana panọng p'iva pẹ, madim ny'ọkpaar nwo, mfha manaanga ny'ẹnwanwa ndo. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Nten mfa-mfa s'ibaan k'ẹja ofufọhnọ, ọmaana ọnọhn, ọttara ekpo maphyir py'ezeng m'izek, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />adimpẹ ọmaana ipapẹ, ekwu etor Noa edim ny'ọkpaar nwo k'ose kw'Ibinọkpaabyi ikk'Noa ọtọhna. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Iwu njo ichenọmfa ikpanẹ nya o, ẹnwanwa ndo ekwu ẹbhọrọ iyagbin.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />K'ogbe kw'Noa node icho ẹnọhna okwuma arọbh ijobh k'atam; k'iwu ichi kkamfa s'ophe kw'ottong afa, ny'ewu ndo dọ ch'asi ayinẹ z'izek <char style="it">bẹ́ porr</char>, ọrọngkpakpa obir owonga, ẹrọng ewona k'izek <char style="it">bẹ́ wọọọọ</char>. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Ẹrọng etebh k'iwu arọbh afa ọmaana irungiwu arọbh afa.<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />Ny'ewu ndo dọ ch'Noa otim ajinọngva pẹ p'ade Shẹm, ọmaana Ham, ọmaana Japhẹt, ọmaana kwanọng kwẹ, ọttara panọng p'iva pẹ attaan, madim z'ọkpaar. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Matima ẹgbaten kpenamkpen k'okira kwẹ, ọmaana etirakpo maphyir k'okira kwabẹ, ọmaana ọttọhk kpenamkpen f'ozeng m'izek k'okira kwẹ, ọmaana inọhn kpenamkpen k'okira kwẹ, ọttara ọttọhk kpenamkpen f'omenẹ mbubaang. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Ekpo mbyo maphyir py'eruk akpen ezenga ẹfa-ẹfa etor Noa madim z'ọkpaar. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Nten s'iwa id-idim nya maphyir ide adimpẹ ọmaana ipapẹ p'etenkira kpenamkpen, tor k'ose kw'Ibinọkpaabyi obenẹ. Ch'nkk'adima z'ẹtaanga, Ọvaar Ibinọkpaabyi obhen-ẹ ọmma.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />Ẹnwanwa echina ororo k'iwu arọbh afa. K'ose kw'asi mbo anwa, minna kw'matinẹ ọkpaar nwo z'izek owok ny'asi ẹrọng. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Asi mbo anwa mach'manwa nya maa, malorọ. Ọkpaar nwo nowok ny'asi ẹrọng. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Asi mbo anwa mawuriji ny'iyagbin maa, mabhọrọ agbeso maphyir p'aning k'izek. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />Asi mbo anwa maa, mabhọrọ agbe maphyir, adongiji pabẹ tọma ny'agbeso, mayọhnga ntọkọ ẹrọbh. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Ọttọhk kpenamkpen f'orukọ akpen ope: ọnọhn ọmaana etirakpo, ọmaana mgbaten, ọmaana ekpo maphyir py'efu m'izek, ọttara ayokinọng maphyir. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Ọttọhk kpenamkpen m'iyagbin f'ọgwọkọ iwọhng, ope. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Minna kw'Ibinọkpaabyi odimẹ ọttọhk kpenamkpen f'oning akpen m'iyagbin. Ayokinọng ọmaana nten, ozeng k'ọjọhk ọttara ọnọhn f'ẹrọng, ọfhọ bẹ maphyir. Ọnọng bung-bungọ kw'uwa orikẹ ode Noa ọmaana ayok mboza p'aning amaan-ẹ z'ọkpaar ẹtaanga.<verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />Ẹnwanwa ndo ẹbhọrọ iyagbin k'iwu arọbh achenọmfa okwuma ijobh.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">Ose kw'ẹnwanwa ẹtọm ẹwọra</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />Ny'ogbe nwo kw'asi abhọrọ iyagbin, Ibinọkpaabyi Noa kọzaam, nten njo maphyir s'iwa ining imaan-ẹ z'ọkpaar ẹtaanga, kobir ọzaama. Ọtọhm ebum egwuma ny'izek, asi mbo matọma ẹwọra. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Ny'ogbe nwo, asi ọdọk z'izek kayinẹ, ẹrọng ọdọk ketebhẹ. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Asi mbo awọra mach'mawọr nya. Okwu opyirẹ k'ewu ch'ettong arọbh achenọmfa okwuma ijobh, asi kk'awọra mawuriji. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />Okwu opyirẹ k'ewu ch'ettong ichi kkamfa k'ophe kw'ottong achenọmfa, ọkpaar nwo ofuka ny'ogbeso nwo kw'mayerẹ Ararat. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Asi mawọra mach'mawọr nya maa, okwu opyirẹ k'ophe kw'ottong ijobh. K'echedenwu ch'ophe kw'ottong ijobh, agbeso ayin k'ose kw'ọnọng m'oze. <figure style="fig" alt="Dove flying" file="hk00064c.tif" size="col" loc="8.5" copy="Illustrations by Horace Knowles, © The British &amp; Foreign Bible Society, 1954, 1967, 1972, 1995" ref="8.5" /><verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />Ch'iwu arọbh afa ikk'ikpana, Noa ogwunga ọmma kw'ikk'ọsa ny'ọkpaar nwo, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />ozenga nya, ọtọhm okwukwọhkọ oyin k'iyaan. Okwukwọhkọ nwo, okwur ochina k'ibyi k'ibyi maa, asi mbo makka maphyir ny'izek. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Ny'ogbe nwo, Noa obir ọtọhm ikpommuka, ọfha ozonga óde asi mbo nkk'awọra. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Ikpommuka njo, iyin k'iyaan, ikwur matẹtẹmaa, ibyi kize s'im'inana okurọ bẹ́, wa asi atim abhọrọ izek maphyir. Ofona nya o, ikpa nnam ikebha Noa z'ọkpaar. Noa onemẹ ọbọhk ọbọk-ẹ otima odim z'ọkpaar.<verse eid="GEN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 8:10" />Noa obir oninga otik maa, iwu ichenọmfa ikpan, pira obir ọtọhm ikpommuka njo k'iyaan. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />K'ogbe kw'ikpommuka njo ikwun ikebha Noa ny'ẹsọhka ch'ewu ndo, itima okwongitọhng-kikebhẹ kw'oliv kw'iram ophupha ny'ẹmma. Noa oze nya o, ozonga bẹ́, asi kk'awọra. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Obir oninga otik k'iwu ichenọmfa, pira ọtọhm ikpommuka njo k'iyaan odọk. M'ogbe nwa, ikpommuka njo, ọdọk kikwun.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Okwu opyirẹ ny'echedenwu ch'ochedenphe kw'Noa ode icho ẹnọhna okwuma arọbh ijobh, okwuma icho mawanẹ, asi kk'akka maphyir. Noa ọrọhbha mgbodo kw'uwa otim obubha ọkpaar, okkerẹ, oze bẹ́, izek kk'igwa. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Okwu opyirẹ iwu ẹrọbh okwuma ichenọmfa, s'ophe kw'ottong afa, izek igwu maphyir.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />Nya o, Ọvaar Ibinọkpaabyi obenẹ Noa bẹ́, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“Tima kwanọng kwọ, ọmaana ajinọngva pọ, ọttara panọng pabẹ, yin k'iyaan. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Bir tima ọttọhkkira kpenamkpen f'orukọ akpen f'oning ọmaan-ọ, yin ka, kw'ode ọnọhn, ọmaana nten s'ogbin, ọmaana ekpo maphyir py'ezeng m'izek, mfha ẹmaan ayok, ebira ẹnyaamẹ m'iyagbin.”<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />Minna kw'Noa oyinẹ k'iyaan ọmaana ajinọngva pẹ, ọmaana kwanọng kwẹ, ọttara panọng p'iva pẹ. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Nten maphyir, ọmaana ọnọhn, ọttara ekpo maphyir py'ezeng m'izek, eyin ny'ọkpaar nwo. Okira kpenamkpen ozenga ẹkaan chẹ.<verse eid="GEN 8:19" /></para>
  <para style="s">Noa ọfọhnọ ẹja ọnang Ibinọkpaabyi</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Nya o, Noa ottima ija-byi s'Ibinọkpaabyi, otima nten janẹ ọmaana ọnọhn vanẹ f'ọbaan k'ẹjafọhnọ, ọfọhnọ ẹja ch'ẹkwọmọ, ọnang Ọvaar Ibinọkpaabyi. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Ọvaar Ibinọkpaabyi ọbhaang olebh f'eruk ch'ẹja ndo nya o, oben z'ettem bẹ́, “Kaam kwuna ọdọk iyagbin ẹmma mìnang okurọ oyokinọng, zaa wura ochibhẹ kpenamkpen kwẹ ọtọm k'ẹvava, ode itama. Kaam ọdọk ekpo maphyir py'ening akpen mìnkibhẹ mach'nkibhẹ m'ogbe nwa.<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />K'ose kw'iyagbin ining ichina ororo,</para>
  <para style="q1" vid="GEN 8:22">ọyaabhagbe ọmaana ọphagbe,</para>
  <para style="q1" vid="GEN 8:22">ekok ọmaana ọyaakiji,</para>
  <para style="q1" vid="GEN 8:22">etitebhẹ ọmaana oyomọ,</para>
  <para style="q1" vid="GEN 8:22">ẹya ọmaana erungọ, ẹkpọka mèyena.”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">Ibinọkpaabyi ochekẹ ọnang Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Nya o, Ibinọkpaabyi osi Noa ọttara iva pẹ ittabọhng, oben bẹ bẹ́, “Tte ojibh ọnang bọnga. Tte iva pabọnga masaabh, mabir anyaamẹ m'iyagbin. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Tọma ma china ororo, nten maphyir s'ining m'iyagbin, ọmaana ọnọhn maphyir, ọmaana ekpo maphyir py'ening ny'ogbin, ọttara nten maphyir s'ining z'ọraanga, ekpo mbyo maphyir, m'eyena ojora kwiden k'abọnga k'ifor. Kk'bọnga ẹfa nnanga ch'mm'atima abaabha bẹ. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Ọttọhk kpenamkpen f'oning akpen, obir oninga m'iyagbin, m'ode ọchattọhk ọnang bọnga. K'ose kw'uwa nchi eden nnang bọnga eborakpo, minna kw'nnang bọnga ekpo maphyir bẹ́, machi.<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />“Okenaka, ọttọhk f'bọnga nna màchi, ode eten ch'etim eyen izẹ, okurọ bẹ́, izẹ jọ ide akpen. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Ó̱de ọnọng ọfhọ ọnọng, kaam m'nnor izẹ sẹ z'mbọhk s'ọnọng kw'ọfhẹ-ẹ. Zaabẹ́ eten dọ ẹfhọ oyokinọng, obir ode bẹ́, oyokinọng wọ ọfhọ oyok-oyok, kaam m'nnor izẹ sẹ mbọbh ọnọng kw'ọfhẹ-ẹ.<verse eid="GEN 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />Ọnọng kpenamkpen kw'ọfhọ oyokinọng,</para>
  <para style="q2" vid="GEN 9:6">oyokinọng m'obir ọfhọ kẹ ọdọk,</para>
  <para style="q1" vid="GEN 9:6">okurọ bẹ́, Ibinọkpaabyi osi</para>
  <para style="q2" vid="GEN 9:6">oyokinọng okerẹ kẹ.<verse eid="GEN 9:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7" />“Ṉ́nòde bọnga, màsi ọmaan k'ọsaabh, mànyaamẹ k'ibyi kpenamkpen m'iyagbin.”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Nya o, Ibinọkpaabyi oben Noa ọmaana ajinọngva pẹ p'aning amaan-ẹ bẹ́, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“Nchekẹ nnang bọnga, ọttara iva p'iva pabọnga. <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />Mbir nchekẹ nnang ọttọhk kpenamkpen f'oning akpen f'iwa oning ọmaana bọnga ny'ọkpaar: ọnọhn, ọmaana etirakpo, ọmaana mgbaten maphyir, ọttara ekpo mbyo maphyir py'matọnọ ayin k'iyaan ny'ọkpaar nwo, kw'ode ọttọhk kpenamkpen f'orukọ akpen m'iyagbin. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Nchekẹ nnang bọnga bẹ́, kwuna ọdọk ẹnwanwa mìntima ndimẹ akpen; ẹnwanwa mèbir eninga ch'im'ekibhẹ iyagbin.”<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />Ibinọkpaabyi obir oben bẹ́, “Ma wọ ode ẹkọhka ch'echekẹ chaam ọmaana bọnga, ọmaana ọttọhk kpenamkpen f'orukọ akpen f'oning ọmaan-ọ, kw'ode echekẹ chaam ọmaana iva p'iva pọ maphyir p'mm'ammaana z'ogbe ororo. <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Kaam kk'esidibhada chaam nsoka z'ebonọ ch'ọrọngkpakpa, dẹ dọ im'ede ẹkọhka ch'echekẹ chaam ọmaana iyagbin. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Ogbe kpenamkpen kw'nsi ẹrọng epyi, esidibhada ebir eyin ny'ebonọ ch'ọrọngkpakpa, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />kaam m'njima echekẹ ch'nsi mmaana bọnga, ọmaana ekpo k'akira k'akira maphyir py'eruk akpen. Kwuna asi ọdọk mànwa maa, makibhẹ ekpo maphyir py'eruk akpen. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Ogbe kpenamkpen kw'esidibhada eyinẹ ny'ebonọ, kaam m'nze chẹ, njima echekẹ chaam ch'ttattampe ch'nsi mmaana ekpo k'akira k'akira maphyir py'eruk akpen m'iyagbin.”<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Minna kw'Ibinọkpaabyi oben Noa bẹ́, “Esidibhada nda dọ ede ẹkọhka ch'echekẹ chaam ọmaana ayokinọng maphyir p'aning akpen m'iyagbin.”<verse eid="GEN 9:17" /></para>
  <para style="s">Osisi kw'iva p'Noa</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Iva p'Noa p'uwa mayinẹ ny'ọkpaar nwo, made Shẹm, ọmaana Ham, ọttara Japhẹt. Ham wọ wa obhonọ Kenaan. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Wa Noa obhonọ iva mba attaan. Iva mba bọ masi ayokinọng p'anyaamẹ m'iyagbin nja kibungọ. <figure style="fig" alt="picture of a grape vine" file="hk00110c.tif" size="col" loc="gen 9:20" ref="9.20">Echi ch'ẹd-ẹwọm grep</figure><verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />Wa Noa ode owonitọhmnọng. Kẹ wọ wa ode ochedennọng kw'otubhọ owonọ kw'achiduk p'grep. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />K'ogbe kw'Noa ogwo atuk p'afon nya, atuk asẹ-ẹ, oyima erinikwum z'ikkira sẹ. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Ham kw'ode otte kw'Kenaan, okwu oze otte ch'oyim erinikwum nya. Ofona od-otek ivọkka pẹ anọng afa. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Nya o, Shẹm ọmaana Japhẹt matọka ibara anana k'mbubaang, matima nnam-nnam azenga akwu abubha erinikwum ch'otte, mabhakẹ ititika akkerẹ ẹbhaakẹ danẹ, mfha maning erinikwum ch'otte aze.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />K'ogbe kw'Noa ọphyabh, ch'atuk kk'ẹ attaana, ozonga ọttọhk f'nnwa kwẹ kw'ikarẹ ọsẹ-ẹ, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />oben bẹ́,</para>
  <para style="q1" vid="GEN 9:25">“Tte opyibh ọnang Kenaan,</para>
  <para style="q2" vid="GEN 9:25">kẹ m'ode obira kw'abira kw'ivọkka pẹ.”<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />Obir oben bẹ́,</para>
  <para style="q1" vid="GEN 9:26">“Tte ẹtọhnga ide ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Shẹm okpobh.</para>
  <para style="q2" vid="GEN 9:26">Tte Kenaan ode obira kw'Shẹm.<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />Tte Ibinọkpaabyi osi ẹkọma ch'Japhẹt ẹmaama ẹkpa,</para>
  <para style="q2" vid="GEN 9:27">tte Japhẹt ọmaana Shẹm matọn aruk k'ibyi majanẹ.</para>
  <para style="q2" vid="GEN 9:27">Tte Kenaan obir ode obira kw'Japhẹt.”<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Ch'ẹnwanwa ndo ikk'ẹsa, wa Noa orukọ k'icho arọbh ichi kkamfa okwuma ijobh. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Kibung-kibungọ, wa Noa orukọ k'icho nnọhna mfa, okwuma arọbh achenọmfa okwuma ijobh, pira nope.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">Efonamma ch'Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Ma wọ ode efonamma ch'Noa kw'obhonọ Shẹm, ọmaana Ham, ọttara Japhẹt. Wa bẹ mabhakẹ abhon iva k'ogbe kw'ẹnwanwa ikk'ẹsa.<verse eid="GEN 10:1" /></para>
  <para style="s">Ẹnọmma ch'Japhẹt</para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 10:2" />Ajinọngva p'Japhẹt obhonọ, wa made:</para>
  <para style="li2" vid="GEN 10:2">Goma, ọmaana Magọg, ọmaana Madai, ọmaana Javan, ọmaana Tubal, ọmaana Mẹshẹk, ọttara Tiras.<verse eid="GEN 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 10:3" />Ajinọngva p'Goma wa made:</para>
  <para style="li2" vid="GEN 10:3">Askenaz, ọmaana Riphat, ọttara Togama.<verse eid="GEN 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 10:4" />Ajinọngva p'Javan wa made:</para>
  <para style="li2" vid="GEN 10:4">Ẹlisha, ọmaana Tarshish, ọmaana Kitim, ọttara Dodanim. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />Wa ofon m'iva mba pira anọng p'arukọ z'ọraang-ọraanga manyaamẹ ator k'mfona sabẹ, mad-aruk k'nkọma sabẹ, ẹkọma kpenamkpen ẹd-ẹgbaak ebhon chẹ.<verse eid="GEN 10:5" /></para>
  <para style="s">Ẹnọmma ch'Ham</para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6" />Ajinọngva p'Ham wa made:</para>
  <para style="li2" vid="GEN 10:6">Kush, ọmaana Ijip, ọmaana Put, ọttara Kenaan.<verse eid="GEN 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7" />Ajinọngva p'Kush wa made:</para>
  <para style="li2" vid="GEN 10:7">Seba, ọmaana Havila, ọmaana Sabata, ọmaana Rama, ọttara Sabateka.</para>
  <para style="li1" vid="GEN 10:7">Ajinọngva p'Rama wa made:</para>
  <para style="li2" vid="GEN 10:7">Shẹba ọmaana Dedan.<verse eid="GEN 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />Kush wọ wa ode otte kw'Nimrọd kw'uwa ode okkikkaama kwiden m'iyagbin. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Wa Nimrọd ode ọgbaaji kwiden z'Ọvaar Ibinọkpaabyi k'ititika. Kẹ wọ osi anọng ad-asi ase bẹ́, “Mach'Nimrọd kw'ode ọgbaaji kwiden z'Ọvaar Ibinọkpaabyi k'ititika.” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Ibhon s'iwa ichi eden ide ọvaarbhon kwẹ ide Babẹl, ọmaana Ẹrẹk, ọmaana Akad, ọttara Kalnẹ, kw'ode ibhon s'ining z'ẹkọma ch'Shina. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Obina nya ochina z'ẹbhaakẹ ch'Asiriya, od-osi obhon kw'Nineva, ọmaana Rehobot-Ir, ọmaana Kala <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ọttara Resen, kw'ode odiden-bhon kw'oning k'njeka kw'Nineva, ọmaana Kala.<verse eid="GEN 10:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="GEN 10:13" />Ijip wọ wa obhonọ ab'Lud, ọmaana ab'Anam,</para>
  <para style="li2" vid="GEN 10:13">ọmaana ab'Lehab, ọmaana ab'Naphatu, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />ọmaana ab'Patarus, ọmaana ab'Kasalu, (kw'ode ẹnọmma ch'aPhilistiya mafon), ọmaana ab'Kaphatọr.<verse eid="GEN 10:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 10:15" />Wa Kenaan wọ ode otte kw'Sidon kw'ode ochedennwa kwẹ. Kenaan obir obhon ab'Het<note caller="+" style="f"><char style="fr" closed="false">10.15 </char><char style="fq" closed="false">Ab'Het </char><char style="ft" closed="false">made anọng p'uwa acheden aruk k'ọsaabh z'izek s'Kenaan. Anọng banẹ ad-ayerẹ bẹ bẹ́, Hit.</char></note>, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />ab'Jebus, ọmaana ab'Amọr, ọmaana ab'Girgash, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />ọmaana ab'Hiv, ọmaana ab'Ak, ọmaana ab'Sin, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />ọmaana ab'Avad, ọmaana ab'Zẹma, ọttara ab'Hamat.</para>
  <para style="p" vid="GEN 10:18">Otum k'ogbe, nnọmma s'Kenaan inyaamẹ. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />Nnem s'Kenaan itọm z'Sidon ichina z'Gẹra, maa, ibọka z'Gaza, pira nichin z'Sọdọm, ọmaana Gọmọra, ọmaana Adama, ọttara Zeboyim, maa ipyirẹ z'Lasha.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />Minna wọ kw'uwa ajinọngva p'Ham ade, atorọ k'nnọmma sabẹ, ọmaana k'mmon sabẹ, ọmaana k'nnem sabẹ, ọttara k'nkọma sabẹ.<verse eid="GEN 10:20" /></para>
  <para style="s">Ẹnọmma ch'Shẹm</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Shẹm kw'uwa Japhẹt otorọ nnam, kẹ wọ ode otte kw'Ẹbẹr ọttara iva pẹ maphyir.<verse eid="GEN 10:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22" />Iva p'Shẹm wa made:</para>
  <para style="li2" vid="GEN 10:22">Ẹlam, ọmaana Ashur, ọmaana Arpaksad, ọmaana Lud, ọttara Aram.<verse eid="GEN 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23" />Iva p'Aram wa made:</para>
  <para style="li2" vid="GEN 10:23">Uz, ọmaana Hul, ọmaana Gẹta, ọttara Mash.<verse eid="GEN 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24" />Arphaksad wọ wa ode otte kw'Shẹla,</para>
  <para style="li2" vid="GEN 10:24">Shẹla ode otte kw'Ẹbẹr.<verse eid="GEN 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25" />Wa Ẹbẹr obhonọ ajinọngva afa, ocheden okpen</para>
  <para style="li2" vid="GEN 10:25">Pẹlẹg<note caller="+" style="f"><char style="fr" closed="false">10.25 </char><char style="fq" closed="false">Pẹlẹg </char><char style="ft" closed="false">oyinẹ bẹ́, ẹ̀bhàangẹ̀.</char></note>, okurọ bẹ́, ny'ogbe kwẹ wọ kw'uwa ayagbin abhaangẹ. Oyok kw'otor-ẹ okpena Jọktan.<verse eid="GEN 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26" />Jọktan wọ wa ode otte</para>
  <para style="li2" vid="GEN 10:26">kw'Almodad, ọmaana Shẹlẹph, ọmaana Hazamavẹt, ọmaana Jẹra, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />ọmaana Hadoram, ọmaana Uzal, ọmaana Dikala, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ọmaana Ọbal, ọmaana Abimayẹl, ọmaana Shẹba, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ọmaana Ophir, ọmaana Havila, ọttara Jobab. Anọng mba maphyir, wa made iva p'Jọktan.<verse eid="GEN 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 10:30" />Ẹkọma ch'iwa anọng mba marukọ ẹtọm z'Mẹsha echina z'ẹbhaakẹ ch'Sẹphar, z'ẹkọma ch'agbe, za ch'ewuchen ed-eyin.<verse eid="GEN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31" />Minna wọ kw'uwa iva p'Shẹm ade, atorọ k'nnọmma sabẹ, ọmaana k'mmon sabẹ, ọmaana k'ozek fabẹ, ọttara k'nkọma sabẹ.<verse eid="GEN 10:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Minna wọ kw'uwa nnọmma s'iva p'Noa ide, atorọ k'ntaak s'mammaan z'nkọma sabẹ. Ofon m'anọng mba, nkọma inyaamẹ m'iyagbin maphyir, k'ogbe kw'ẹnwanwa ikk'ẹsa.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">Ọsọhm kw'ogor-ogorọ z'Babẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Wa iyagbin maphyir iyen ebhon madanẹ, ibir igbaak odik mawanẹ.<verse eid="GEN 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 11:2" />K'ose kw'anọng azeng achina z'ẹbhaakẹ ch'ewuchen ed-eyin, maze ẹkpẹmẹ z'Shina<note caller="+" style="f"><char style="fr" closed="false">11.2 </char><char style="fq" closed="false">Shina </char><char style="ft" closed="false">obir okpena Babiloniya.</char></note>, masi oruk nya.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Maben ayok bẹ́, “Màkwu motima ididọhbh mosi ata p'ọsọhm, mọbhaabh bẹ mawuriji.” Nya o, matima asọhm-ta mbo atera ata ọkkọkka. Mabir atima irurugbaar atera ididọhbh s'malọhkọ-ọlọhkọ. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Maben ayok bẹ́, “Màkwu mosi ebhondim, mobir osi ọsọhm kw'ogor-ogorọ kw'im'opyirẹ z'ọrọngkpakpa, mfha ẹgọhma chamina epyirẹ k'ibyi kpenamkpen, mfha moning ọdọk m'iyagbin maphyir ọraamẹ.”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />Nya o, Ọvaar Ibinọkpaabyi ọsaka, okwu oze ebhondim ndo, ọttara ọsọhm-gorada nwo kw'ayokinọng ad-asi. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Ọvaar Ibinọkpaabyi oben bẹ́, “Ch'anọng mba p'agbaak ebhon madanẹ nkk'ọttọhkse mva atọma osisi, oyinẹ bẹ́, ọttọhk kode f'mm'akam bẹ́, masi pira ọkaar bẹ ọkaara. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Tte mọsaka, mod-oke adama ny'ebhon chabẹ, mfha maning ọdọk ayok abhaang.”<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Minna kw'Ọvaar Ibinọkpaabyi osi anọng mbo maraamẹ k'ibyi k'ibyi m'iyagbin, makpọka ebhondim ndo osisi. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Kẹ wọ osi pira wa mayerẹ ibyi njo bẹ́, Babẹl<note caller="+" style="f"><char style="fr" closed="false">11.9 </char><char style="fq" closed="false">Babẹl </char><char style="ft" closed="false">obir okpena Babilọn. K'eHiburu, </char><char style="fq" closed="false">Babẹl </char><char style="ft" closed="false">oyinẹ ọttọhk mach'damadama.</char></note>, okurọ bẹ́, nya wọ kw'uwa Ọvaar Ibinọkpaabyi oke damadama k'ebhon ch'iyagbin kibungọ. Tọma nya, Ọvaar Ibinọkpaabyi osi bẹ maraamẹ m'iyagbin maphyir.<verse eid="GEN 11:9" /></para>
  <para style="s">Ẹnọmma ch'Shẹm</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Ma wọ ode ose kw'ẹnọmma ch'Shẹm ede. Ch'icho ifa ikk'ikpana, tọma ny'ogbe kw'ẹnwanwa ẹsa, ch'Shẹm node icho arọbh achen, nya wọ kw'obhonọ Arphaksad. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Ch'ikk'Arphaksad obhona, Shẹm obir oruk k'icho ẹnọhna okwuma arọbh achen, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Ch'Arphaksad kk'icho ẹrọbh okwuma ichi oruka, nya wọ kw'obhonọ Shẹla. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Ch'ikk'Shẹla obhona o, Arphaksad oruk k'icho ẹnọhna okwuma ittaan, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />K'ogbe kw'uwa Shẹla ode icho ẹrọbh okwuma ijobh, nya wọ kw'obhonọ Ẹbẹr. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Ch'ikk'Ẹbẹr obhona, Shẹla oruk k'icho ẹnọhna okwuma ittaan, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Ch'uwa Ẹbẹr kk'icho ẹrọbh okwuma osowanẹ kw'ichi oruka, obhon Pẹlẹg. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Ch'ikk'Pẹlẹg obhona, Ẹbẹr oruk k'icho ẹnọhna okwuma ẹrọbh okwuma ijobh, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Ch'Pẹlẹg kk'icho ẹrọbh okwuma ijobh oruka, obhon Rewu. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Ch'ikk'Rewu obhona, Pẹlẹg oruk k'icho arọbh ijobh okwuma osowanẹ, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Ch'Rewu, kk'icho ẹrọbh okwuma ijobh kkamfa oruka, obhon Serug. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Ch'ikk'Serug obhona, Rewu oruk k'icho arọbh ijobh okwuma ichenọmfa, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Ch'Serug, kk'icho ẹrọbh okwuma ijobh oruka, obhon Nahọr. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Ch'ikk'Nahọr obhona, Serug oruk k'icho arọbh ijobh, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Ch'Nahọr kk'icho ẹrọbh okwuma osowanẹ oruka, obhon Tẹra. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Ch'ikk'Tẹra obhona, Nahọr oruk k'icho arọbh achen okwuma osowanẹ kw'ẹrọbh, obir obhon ajinọngva ọttara panọngva ọdọk-ọdọk.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Ch'Tẹra kk'icho arọbh attaan okwuma ijobh oruka, obhon Abram, ọmaana Nahọr, ọttara Haran.<verse eid="GEN 11:26" /></para>
  <para style="s">Ẹnọmma ch'Tẹra</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Ma wọ ode ose kw'ẹnọmma ch'Tẹra ede. Tẹra obhon Abram, ọmaana Nahọr, ọttara Haran. Haran obhon Lọt. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Nya ch'iwa Tẹra otim oning akpen, Haran ope z'Ur z'ẹbhaakẹ ch'aKaldi kw'ode obhon kw'uwa ọmmaan.<verse eid="GEN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 11:29" />Wa Abram ọttara Nahọr matọk panọng. Kwanọng kw'Abram okpen Sarai. Kwanọng kw'Nahọr okpena Milka, kw'ode ominanwa kw'Haran obhonọ. Wa Haran wọ obir obhon Milka ọttara Iska. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Ny'ogbe nwo, wa Sarai ọkpaan-ọkpaana.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Tẹra ọtọka Abram kw'ode nnwa kwẹ, ọttara Lọt kw'ode nnwa kw'Haran ope orik, ọttara Sarai kw'ode kwanọng kw'Abram. Bẹ maphyir mabina z'Ur kw'oning z'ẹbhaakẹ ch'aKaldi bẹ́, machina z'Kenaan. Okenaka, ch'mapyirẹ z'Haran, makpọka nya, masi oruk kwabẹ nya.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />Tẹra ope ny'Haran k'ogbe kw'ode icho arọbh ijobh okwuma ichen.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">Ibinọkpaabyi oyerẹ Abram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />K'ogbe wanẹ, Ọvaar Ibinọkpaabyi oben Abram bẹ́, “Bina rik ẹkọma chọ, ọmaana echimma chọ, ọttara oter kw'atte, achina z'ẹkọma ch'ikaam m'ntibh-ọ.<verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />Kaam m'nsọ-ọ ade otte kw'ẹkọma chiden.</para>
  <para style="q2" vid="GEN 12:2">Kaam m'ndọ-ọ, mbira nsọ-ọ ayin eche.</para>
  <para style="q1" vid="GEN 12:2">Kaam m'nzenga ny'ikọ, ndo anọng saabhada.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />Ọnọng kpenamkpen kw'osi ejibha ọnang-ọ, kaam m'mbira nsi ejibha nnang-ẹ.</para>
  <para style="q1" vid="GEN 12:3">Ọnọng kw'ọsọ-ọ itama, kaam m'mbir ndim-ẹ kibung-kibungọ.</para>
  <para style="q1" vid="GEN 12:3">Kaam m'nzenga ny'ikọ ndo nkọma s'iyagbin maphyir.”<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Minna kw'Abram obin ozenga k'ose kw'Ọvaar Ibinọkpaabyi ikk'ẹ obena bẹ́, osi. Lọt otor-ẹ mafona. Wa Abram ode icho arọbh attaan okwuma ichi k'ogbe kw'obin z'Haran. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Wa otim kwanọng kwẹ Sarai, ọttara Lọt kw'ode nnwa kw'ọgbaanọkka, obir otima oyena kwabẹ maphyir, ọttara anọng pẹ maphyir p'ikk'oyena z'Haran, mabina, matọma ozenga achina z'ẹkọma ch'Kenaan maa, mapyirẹ za.<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />Abram ozenga ny'Kenaan, okwu opyirẹ nya ch'echi chiden ch'Morẹ ening, z'Shẹkẹm. Ny'ogbe nwo, wa anọng p'Kenaan, matim arukọ ny'izek njo. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />Nya wọ kw'Ọvaar Ibinọkpaabyi oyinẹ okebha Abram, oben-ẹ bẹ́, “M'ntte izek nja ọbọhk nnang ẹnọmma chọ.” Ofona nya o, Abram ommin ija-byi s'Ọvaar Ibinọkpaabyi kw'ikk'oyina okebh-ẹ nya.<verse eid="GEN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8" />Tọma nya, Abram obina ochina z'ẹbhaakẹ ch'agbe p'Bẹtẹl, za ch'ewuchen ed-eyin, ommin ikkira sẹ nya. Bẹtẹl oning ẹwọn-ẹwọna kw'ikkira njo, za ch'ewuchen ed-edimẹ, Ayi oninga ebir-ebir, za ch'ewuchen ed-eyin. Abram ommin ija-byi s'Ọvaar Ibinọkpaabyi, obir okpobha Ọvaar Ibinọkpaabyi ny'ibyi njo.<verse eid="GEN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 12:9" />Minna kw'Abram obin ozenga, okkerẹ ititika z'ẹbhaakẹ ch'Nẹgẹv.<verse eid="GEN 12:9" /></para>
  <para style="s1">Abram ọmaana Sarai madim Ijip</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Wa ny'ogbe nwo, okwo fiden oning ny'ẹkọma ndo. Ofona nya o, Abram obina, ochina z'Ijip bẹ́, od-oninga nya k'ogbe biribirẹ, okurọ bẹ́, wa ọchattọhk oworọ mawuriji. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />K'ogbe kw'min'odim z'Ijip, Abram oben kwanọng kwẹ bẹ́, “Sarai, kaam nzong bẹ́, ajibhẹ kwanọng mawuriji. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Ó̱de anọng p'Ijip azọ-ọ, mm'aben bẹ́, kwanọng kwẹ wọ ma. M'ofona nya mm'afhọ-m, matte kọ ọbọhk aruk. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Nya o, ben bẹ bẹ́, kaam ọttara kọ, mode ivọkka, mfha mazenga kọ ábẹ̀, matim-m mawuriji, mabir atte-m ọbọhk nruk akpen okurọ kọ.”<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />K'ogbe kw'Abram opyirẹ z'Ijip, anọng p'Ijip maze bẹ́, Sarai ojibh kwanọng mawuriji. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />K'ose kw'asonọng p'Phero<note caller="+" style="f"><char style="fr" closed="false">12.15 </char><char style="fq" closed="false">Phero </char><char style="ft" closed="false">ode ediden ch'mad-anang ọvaarnọng kw'Ijip.</char></note> maze Sarai nya, matọhng-ẹ ny'ititika s'Phero, mabir atim-ẹ achina z'odimpa. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Wa Phero ozeng Sarai ábẹ̀, osi ejibha mawuriji ọnang Abram. Ọnang-ẹ arọkimaan, ọmaana abhaam, ọmaana nnyanya s'ejinọng ọmaana s'ẹpanọng, ọttara abira k'ejinọng, ọmaana k'ẹpanọng, ọttara nten siden s'mayerẹ akamẹl.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Okenaka, Ọvaar Ibinọkpaabyi ọnang Phero ọttara ẹsọhmmọr chẹ ikọhmaana okurọ ch'Phero ọtọk Sarai kw'ode kwanọng kw'Abram. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Minna kw'Phero oyerẹ Abram ọbọbh-ẹ bẹ́, “Bọng-ọttọhk f'asi-m ma? Osempira kaam katekẹ bẹ́, Sarai ode kwanọng kwọ? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Kayen kw'atek-m bẹ́, kẹ ọttara kọ, made ivọkka, abira achera bẹ́, kaam ntọk-ẹ k'ọba? Kirẹ kwanọng kwọ ma. Tọk-ẹ tima zọhng!” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />Phero ọnang anọng pẹ ẹfa bẹ́, matọka Abram mad-arik. Minna kw'matọk Abram ọmaana kwanọng kwẹ, ttara oyena kwẹ maphyir, mad-arik.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">Ẹbhaangẹ ch'Abram ọmaana Lọt</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Minna kw'Abram otte Ijip ọbọhk, otima kwanọng kwẹ ọttara oyena kwẹ maphyir, obina orik obhon nwo, ọkpa nnam z'ẹbhaakẹ ch'Nẹgẹv, Lọt matọn afona. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />Abram nokwu ojibh-ẹ mawuriji; oyena etirakpo, ọmaana asilva, ọttara agol k'ọsaabh.<verse eid="GEN 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3" />Tọma ny'ẹbhaakẹ ch'Nẹgẹv, Abram ochina ororo k'ozenga kwẹ, od-obhing k'ibyi k'ibyi, maa, okwu opyirẹ z'ẹbhaakẹ ch'Bẹtẹl, ny'njeka kw'Bẹtẹl ọmaana Ayi, za ch'iwa ochi eden obhing. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />Nya wọ kw'uwa Abram ochi eden osi ija-byi. Nya wọ kw'uwa obir oyerẹ eche ch'Ọvaar Ibinọkpaabyi.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />Lọt kw'uwa od-ozenga ọmaana Abram, obir oyena arọkimaan ọttara abhaam saabhada; anọng p'ator-ẹ, mabira asaabh. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Okenaka, wa izek njo ọdọk bẹ kibeng k'ose kw'mm'atọn aninga, okurọ oyena kwabẹ kw'uwa okem ẹsaabha. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />Ẹkọhr okwu etto akker-etirakpo py'Abram ọmaana akker-etirakpo py'Lọt. Ny'ogbe nwo, wa anọng p'Kenaan, ọmaana anọng p'Periz, matim arukọ ny'izek njo.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Minna kw'Abram oben Lọt bẹ́, “Kọ ọttara kaam, mode ivotte. Kojibhẹ bẹ́, mosi ẹkọhr. Kobir ojibh bẹ́, akker-etirakpo pọ ọttara paam, maninga k'ẹkọhr. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Izek nja maphyir samina jọ. Tte mọbhaangẹ ayok. Ó̱de atọk ẹbhaakẹ ch'odimbọhk, kaam m'ntọka ch'obhurubọhk. Ó̱de atọk ẹbhaakẹ ch'obhurubọhk, kaam m'ntọka ch'odimbọhk.”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />Lọt okkerẹ, oze bẹ́, ẹkpẹmẹ ndo ch'Jọrdan k'ibungọ eyen asi mach'owonọ kw'Ọvaar Ibinọkpaabyi, ebir ede mach'izek s'Ijip, z'ẹbhaakẹ ch'Zoar. (Wa ode ch'Ọvaar Ibinọkpaabyi ina ibhon s'Sọdọm ọmaana Gọmọra otim odima m'iyagbin.) <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Minna kw'Lọt ochem ẹkpẹmẹ ch'Jọrdan k'ibungọ, z'ẹbhaakẹ ch'ewuchen ed-eyin. Nya o, bẹ anọng afa mabhaangẹ ayok. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Wa Abram, orukọ z'Kenaan, Lọt oruk z'ibhon siden s'ining ny'ẹkpẹmẹ ndo, ottima okkira fẹ ọnyọma Sọdọm. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />Wa anọng p'Sọdọm, made anọng p'asi ẹyaaka mawuriji, mabira ad-asi mpyibha siden z'Ọvaar Ibinọkpaabyi k'ititika.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />K'ogbe kw'Abram ọmaana Lọt nkk'ayok abhaanga, Ọvaar Ibinọkpaabyi okwu oben Abram bẹ́, “Tinẹ achen pọ k'ẹrọng nya ch'abe nya, akkerẹ z'ebir-ebir, akkerẹ z'ẹwọn-ẹwọna, akkerẹ za ch'ewuchen ed-eyin, ọmaana za ch'ewuchen ed-edimẹ. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Izek njo maphyir s'aze nya, kaam m'ntọka nnang kọ ọttara iva pọ, ọttara iva p'iva pọ bẹ́, mayena ttattampe. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Kaam m'nsi iva p'iva pọ masaabh mach'oyiyeng kw'ina obhika ode. Ó̱de ọ́nọng m'okpo oyiyeng obhik, oyinẹ bẹ́, ọnọng m'okpo iva p'iva pọ obhik-obhik. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Bina, zenga baana adum ọttara ẹkpa ch'izek njo, okurọ bẹ́, sẹ jọ s'im'nnang-ọ.”<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Minna kw'Abram otinẹ okkira fẹ, od-oruk ọnyọma nchi siden s'Mamrẹ, z'Hẹbrọn. Nya wọ kw'ottim ija-byi s'Ọvaar Ibinọkpaabyi.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">Abram ọkkaan Lọt</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Ny'ogbe nwo, wa Amaraphẹl wọ ode ọvaarnọng kw'Shina, Ariyok ode ọvaarnọng kw'Ẹlasa, Kedor-laomer ode ọvaarnọng kw'Ẹlam, Tidal ode ọvaarnọng kw'Goyim. <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />Wa avaarnọng mba anna, mabin mad-arima egbong amaana Bera kw'ode ọvaarnọng kw'Sọdọm, ọmaana Birasha kw'ode ọvaarnọng kw'Gọmọra, ọmaana Shinab kw'ode ọvaarnọng kw'Adama, ọmaana Shemebẹr kw'ode ọvaarnọng kw'Zeboyim, ọttara ọvaarnọng kw'Bẹla, kw'obir okpena Zoar. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Wa avaarnọng mba achen, magbaka ifor ọmaana ayok z'ilokodo s'Sidim, kw'ode Ọraanga kw'Onung. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />K'icho ijobh kkamfa, maning k'ẹbaabha ch'Kedor-laomer. Ottong icho ijobh kkanttaan, mabhum ẹbaabha chẹ.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Okwu opyirẹ icho osowanẹ kw'ichi, Kedor-laomer, ọttara avaarnọng p'agbak ifor amaan-ẹ, makema egbong ch'marim ọmaana anọng p'Rẹpha z'ẹbhaakẹ ch'Ashterọt-Karnayim, ọmaana anọng p'Zuz z'ẹbhaakẹ ch'Ham, ọmaana ẹkọma ch'Ẹm z'ẹbhaakẹ ch'Shavẹ-Kiriyatayim, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />ọttara anọng p'Họr z'ẹbhaakẹ ch'agbe p'Seir, maa, pyirẹ z'Ẹl-Paran, kw'ọnyọm ibyi s'anọng nna arukọ. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Nya o, makpa nnam achina z'Ẹn-Mishpat, kw'ode Kadẹsh, mabira ad-akema anọng p'Amalẹk, ọttara anọng p'Amọr p'uwa marukọ z'Hazazọn-Tama.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Nya o, avaarnọng mbo achen p'abaabh Sọdọm, ọmaana Gọmọra, ọmaana Adama, ọmaana Zeboyim, ọttara Bẹla (kw'ode Zoar), mabina ayin egbong z'ilokodo s'Sidim, <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />mad-arima avaarnọng mboza anna ábẹ̀, p'ade ọvaar Kedor-laomer kw'ọbaabh Ẹlam, ọmaana ọvaar Tidal kw'ọbaabh Goyim, ọmaana ọvaar Amaraphẹl kw'ọbaabh Shina, ọttara ọvaar Ariyok kw'ọbaabh Ẹlasa.<verse eid="GEN 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 14:10" />Ny'ilokodo s'Sidim, wa ape p'ayen ana p'apyi <char style="it">bẹ́ kkang</char>, mabang-ọbanga, masaabh-ọsaabh. K'ogbe kw'avaar p'Sọdọm ọmaana Gọmọra marọbhọ, ayok banẹ matto ny'ape mbo, mboza marọbh machina z'agbe. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Nya o, avaarnọng mbo anna, mana ayok p'Sọdọm ọmaana Gọmọra ekpo maphyir, ọttara ẹchakpo pyabẹ maphyir, matima afona. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Mabir abọka Lọt kw'ode nnwa kw'ọgbaanọkka kw'Abram, kw'uwa orukọ z'Sọdọm, mabọk-ẹ ọttara oyena kwẹ maphyir matima afona.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Ọnọng wanẹ kw'ọrọbhọ ọnaanga, okwu otek Abram kw'ode oHiburu-nọng odik nwa. M'ogbe nwoma, wa Abram orukọ ọnyọma nchi siden s'Mamrẹ kw'ofon Amọr, kw'ode ọgbaanọkka kw'Ẹshkọl, ọmaana Anẹr, kw'bẹ maphyir magbak ifor amaana Abram. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Ch'Abram ọbhaang bẹ́, nkk'ọgbaanotte abọka k'ẹmmọri, oyerẹ anọng arọbh ichi okwuma ichi kkanttaan p'mammaan ny'ikẹ k'ẹsọhmmọr p'akpo egbong oririma, otima okwubh bẹ maa, mapyirẹ z'ẹbhaakẹ ch'Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Otum ny'erungọ, Abram okebh agbongnọng pẹ k'nkaana k'nkaana, otima orima bẹ ábẹ̀ maa, ọna bẹ mkpaang. Okwubh bẹ maa, opyirẹ z'Hoba, z'ebir-ebir kw'Damaskọs. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Abram ọna anọng mbo ekpo maphyir py'matọk, obir ọna bẹ Lọt ọmaana oyena kwẹ, ọmaana panọng, ọttara anọng mboza maphyir.<verse eid="GEN 14:16" /></para>
  <para style="s">Ọvaar Mẹlkizẹdẹk osi Abram ittabọhng</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Ch'Abram kk'okwuna za ch'okem Kedor-laomer, ọttara avaar p'agbak ifor amaan-ẹ, ọvaarnọng kw'Sọdọm, okwu okebh-ẹ z'ilokodo, s'Shavẹ, s'mayerẹ “Ilokodo s'Ọvaarnọng.”<verse eid="GEN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18" />Nya o, Mẹlkizẹdẹk, kw'ode ọvaarnọng kw'Salẹm, obir ode ọfọhn-nja kw'Ibinọkpaabyi kw'Ọyọhng, otima brẹd ọmaana atuk ochena Abram. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />Osi Abram ittabọhng, oben-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 14:19">“Tte Ibinọkpaabyi kw'Ọyọhng, kw'osi ẹrọng ọmaana izek, ọdọ-ọ.<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Tte ẹtọhnga ede ch'Ibinọkpaabyi kw'Ọyọhng,</para>
  <para style="q2" vid="GEN 14:20">kw'ọtọk awawunanọng pọ ọkọ-ọ k'ọbọhk.”</para>
  <para style="m" vid="GEN 14:20">Nya o, Abram ọnang-ẹ igboka majanẹ s'ekpo ijobh k'ọttọhk kpenamkpen.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />Ọvaarnọng kw'Sọdọm, oben Abram bẹ́, “Nang-m ayokinọng, kọ atọka ekpo mbyoza ayena.”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Abram ọpọhna ọvaarnọng kw'Sọdọm bẹ́, “Kaam kk'ọbọhk nyaanga k'ẹrọng, nchekẹ k'eche ch'Ọvaar Ibinọkpaabyi kw'Ọyọhng, kw'osi ẹrọng ọmaana izek bẹ́, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ọttọhk fọ mavanẹ-vanẹ mìntọka, zaabẹ́ ode ẹbarakpa, obir ode edik ch'ntọkọ, ọfha kwuna aning abenẹ bẹ́, ‘Kaam wọ nsi Abram ojibh-ẹ.’ <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Kaam ọttọhk kpenamkpen fọ mìntọka, kw'ọkpanẹ ọchattọhk mvo f'anọng paam nkk'acha, ọttara okebh f'anọng p'ator-m. Tte Anẹr, ọmaana Ẹshkọl, ọttara Mamrẹ mayena okebh fabẹ.”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">Ibinọkpaabyi ochekẹ ọnang Abram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Nwonya ọsa nya o, Ọvaar Ibinọkpaabyi oyin okebha Abram, oben-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 15:1">“Abram, oning-ọ ojor,</para>
  <para style="q2" vid="GEN 15:1">kaam m'nkker-ọ ọfha ọttọhk oning-ọ osi,</para>
  <para style="q2" vid="GEN 15:1">kaam m'mbira nsi ẹtaam chiden nnang-ọ.”<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />Abram ọbhaang nya o, oben bẹ́, “O Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir, bọng-ọttọhk f'ikọ im'anang-m ch'kaam ina nnwa nyen? Ọnọng kw'im'ochi obo kwaam ode Eliyeza kw'ofon Damaskọs.” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Abram obir oben bẹ́, “Kọ kaam nnwa kanangẹ. Oyinẹ bẹ́, ọtọhmnọng kw'ikaam k'ọsọhm wọ im'ochi obo kwaam.”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Pira Ọvaar Ibinọkpaabyi obir ọgbaak odik, oben Abram bẹ́, “Mma e, minna mòde. Ọtọhmnọng nwa azang wọ im'ochi obo kwọ. Nnwa kwọ oyene, kw'ofon ny'ikọ k'adima, kẹ wọ im'ochi obo kwọ.” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />Pira Ibinọkpaabyi otima Abram oyin k'iyaan, ọkọhk-ẹ ndidorọ z'ọrọngkpakpa, oben-ẹ bẹ́, “Kk'aza k'ose kw'ndidorọ isaabhẹ za, ọnọng kode kw'im'okpo obhik. Minna kw'kwuna iva p'iva pọ mm'asaabh.”<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />Abram ochera ọmaana Ọvaar Ibinọkpaabyi. Ofona nya, Ibinọkpaabyi ọtọk-ẹ mach'ọnọng kw'otor-otor.<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />Ọvaar Ibinọkpaabyi obir oben Abram bẹ́, “Kaam wọ nde Ọvaar Ibinọkpaabyi, kw'ọtọk-ọ z'Ur z'ẹbhaakẹ ch'anọng p'Kaldi bẹ́, nnang-ọ izek nja ayena.”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />Abram ọpọhn-ẹ bẹ́, “O Ọvaar Ibinọkpaabyi, kaam m'nsi yen pira nzonga bẹ́, izek njoma m'ide saam?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, “Chen-m ọbhaamkwa, ọmaana ovukwa, ọttara ọrọkimaandim kw'ode icho ittaan-ittaan k'atam, ọmaana ikpommuka, ọttara igbe.”<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />Abram otima nten njo ochena Ibinọkpaabyi, ọkpaara jẹ akwuma afa-afa, otobha jẹ ikkerẹ ayok ititika. Ṉ́nòde ọnọhn, akwuma afa kọkpaar. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Nya o, attẹrẹ asaka bẹ́, makwu achi aforbukọ p'nten njo, Abram o, okwubh bẹ.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />K'ose kw'ewu ẹd-ẹsaka ny'ẹsọhka, Abram ọttaabha ọda maa, ọmọm. Orungibanga kw'opyi <char style="it">bẹ́ kkang</char>, obir ojor-ojora, obubh-ẹ. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Nya o, Ọvaar Ibinọkpaabyi oben Abram bẹ́, “Zonga k'odik ọkkọkka bẹ́, iva p'iva pọ, mm'ade akikennọng k'ẹkọma ch'anọng. Bẹ mm'aninga k'ebira, mm'abir anang bẹ irem, k'icho minna ẹnọhna. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Okenaka, kaam m'nnang ẹkọma ch'esok bẹ ebira irem. K'okpongannamgbe, bẹ mm'atima oyena kwiden abina arik ẹkọma ndo. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Ṉ́nòde kọ, m'aninga akpen matẹtẹmaa atam, pira ape ator ab'atte k'ọdaam. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />K'ipemaanitor s'ittong nna, iva p'iva pọ m'akpa nnam m'izek nja, okurọ bẹ́, ogbe otima opyira kw'im'nkwubh anọng p'Amọr okurọ mpyibha sabẹ.”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />K'ogbe kw'ewu ikk'ẹsa, ebir epyi <char style="it">bẹ́ kkang</char>, izọhka s'itim izizong, ọmaana akpondaak, iyin izenga ny'atenkwuma mbo. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />Ny'ewu ndo, Ọvaar Ibinọkpaabyi osi echekẹ ọmaana Abram. Oben-ẹ bẹ́, “Iva p'iva pọ bọ p'm'nnang izek nja, tọma z'ọraanga kw'Ijip maa, pyirẹ z'ọraanga kwiden kw'Yupharetes. <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />Madidaanma, ibhon s'itim irukọ m'izek njoma, ide Ken, ọmaana Keniz, ọmaana Kadamọn, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />ọmaana Hit, ọmaana Periz, ọmaana Rẹphayim, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />ọmaana Amọr, ọmaana Kenaan, ọmaana Girgash, ọttara ayok p'Jebus.”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">Hagar ọmaana nnwa kwẹ Ishimayẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Wa Sarai kw'ode kwanọng kw'Abram, ọkpaan-ọkpaana, nnwa kọmaanẹ ọnang Abram. Okenaka, wa Sarai oyen obira kwanọng wanẹ kw'ofon Ijip kw'okpen Hagar. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />Sarai oben Abram bẹ́, “Ọvaar Ibinọkpaabyi kk'aam ọmaan ọrama. Zọhng tor obira nwa kwaam eyima. Ṉ́nòsi m'nzenga ny'ikẹ, nyena echimma.”</para>
  <para style="p" vid="GEN 16:2">Abram ochera odik kw'Sarai ọgbaakẹ. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Ch'Abram kk'oruka ny'Kenaan k'icho ijobh, nya kw'Sarai ọtọk Hagar, obira-kwanọng kwẹ kw'ofon Ijip, ọnang odim bẹ́, ọba. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Abram oyima ọmaana Hagar, Hagar otima ibhọr.</para>
  <para style="p" vid="GEN 16:4">K'ogbe kw'Hagar ozong bẹ́, kk'ibhọr otima, ọtọma Sarai kw'ode ọkka kwẹ olulukọ. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />Nya o, Sarai oben Abram bẹ́, “Kọ wọ ajẹ odik nwa kw'id-ntọka irem sẹ ma. Ntọk obira kwaam nkọ-ọ ny'mbọhk. Ma ch'inozong bẹ́, kk'ibhọr otima, kẹ nọmyan-m ọmyana. Tte Ọvaar Ibinọkpaabyi osi aponga p'kaam ọttara kọ.”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Abram oben-ẹ bẹ́, “Obira-nwa nwoma otim ode nnwa kwọ e. Sẹ-ẹ k'ose kw'ọdaak-ọ.” Tọma ny'ogbe nwo, Sarai ọdọk Hagar mawuriji kotim. Ofona nya o, Hagar ọrọbh.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Hagar ọrọbhọ nya o, ozeng-eden kw'Ibinọkpaabyi, oyin okebh-ẹ ny'esipe danẹ ch'ening ẹnyọma ibyi s'anọng nna arukọ. Esipe ndo ening etuma eden ch'echin z'Shur. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />Ozeng-eden nwo, oben Hagar bẹ́, “Kọ Hagar kw'ade obira kw'Sarai, afon memma? M'abir ata men?” Hagar, ọpọhn-ẹ bẹ́, “Nd-nrọbh-ọrọbh z'mbọhk s'nna kwaam ma, kw'ode Sarai.”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Ozeng-eden nwo kw'Ọvaar Ibinọkpaabyi, oben Hagar bẹ́, “Kpa nnam tor akka, abir akpobh-ẹ.” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Obir oben-ẹ bẹ́, “Kaam m'nsi iva p'iva pọ masaabh maa, maning obhika ade.”<verse eid="GEN 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11" />Ozeng-eden nwo obir oben-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 16:11">“Ibhọr njo s'atim nya,</para>
  <para style="q2" vid="GEN 16:11">m'amaan ojinọngnwa;</para>
  <para style="q1" vid="GEN 16:11">m'akpẹ-ẹ Ishimayẹl<note caller="+" style="f"><char style="fr" closed="false">16.11 </char><char style="fq" closed="false">Ishimayẹl </char><char style="ft" closed="false">oyinẹ bẹ́, Ibinọkpaabyi ọbhaang odik.</char></note>,</para>
  <para style="q2" vid="GEN 16:11">okurọ bẹ́, Ọvaar Ibinọkpaabyi k'ẹmọng ch'irem sọ ọbhaanga.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Kẹ m'osi ẹjagbara mach'ẹnyanya ch'nna otitir atirẹ,</para>
  <para style="q1" vid="GEN 16:12">kẹ m'ode ọwawunanọng kw'anọng maphyir,</para>
  <para style="q2" vid="GEN 16:12">anọng maphyir mabir awun-ẹ;</para>
  <para style="q1" vid="GEN 16:12">m'oruk akọhr-kpen ọmaana ivotte maphyir.”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Hagar okpe Ọvaar Ibinọkpaabyi kw'ọgbaak-ẹ odik bẹ́, “Kọ wọ ade Ibinọkpaabyi kw'oze-m. Kaam kk'ọnọng nza kw'od-oze-m.” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Kẹ wọ osi wa mayerẹ esipe ndo bẹ́, Beer-Lahai-Roi<note caller="+" style="f"><char style="fr" closed="false">16.14 </char><char style="fq" closed="false">Beer-Lahai-Roi </char><char style="ft" closed="false">oyinẹ bẹ́, Esipe ch'Kẹ kw'Oning akpen, kw'oze-m. </char></note>. Esipe ndo etim ening ny'njeka kw'Kadẹsh ọmaana Bẹrẹd.<verse eid="GEN 16:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Minna kw'Hagar ọmaanẹ Abram ojinọngnwa. Abram ọkpẹ-ẹ Ishimayẹl. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Wa Abram ode icho arọbh anna okwuma ichadanẹ k'atam k'ogbe kw'Hagar ọmaanẹ Abram ojinọngnwa.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">Ẹkọhka ch'Ibinọkpaabyi ọnang Abram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />K'ogbe kw'uwa Abram node icho arọbh anna okwuma osowanẹ kw'ẹrọbh k'atam, Ọvaar Ibinọkpaabyi oyin okebh-ẹ nya, oben-ẹ bẹ́, “Kaam nde Ibinọkpaabyi kw'Ẹfa maphyir, tor ẹtọkọ chaam, abir asi ẹmmaana ch'etor-otor. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Kaam m'nsi k'ose kw'uwa ikk'ncheka nnang-ọ bẹ́, kwuna iva p'iva pọ m'asaabh mawuriji.”<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />Abram ọbhaang idik njo nya o, otto okwubha ititika ny'izek. Ibinọkpaabyi obir oben-ẹ bẹ́, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“Ma wọ ode odik kw'ikaam ikk'ncheka mmaan-ọ bẹ́, kọ m'ade otte kw'nkọma k'ẹkaan. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Kọ ọdọk Abram màkpena, kọ m'akpena Abraham<note caller="+" style="f"><char style="fr" closed="false">17.5 </char><char style="fq" closed="false">Abraham </char><char style="ft" closed="false">oyinẹ bẹ́, Otte kw'anọng saabhada.</char></note>, okurọ bẹ́, kaam nsọ-ọ otte kw'nkọma saabhada. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Kaam m'nsọ-ọ abhon iva p'nna obhika ade. Nkọma k'ẹkaan, ọmaana avaarnọng piden m'afona k'ikọ. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Kaam m'nsi echekẹ nda ch'ikaam nyen mmaan-ọ ettima ttattampe. M'ede ch'ikaam ọttara kọ, m'ebir ede ch'iva p'iva pọ k'ogbe kw'ikọ ikk'apa. Kaam m'nde Ibinọkpaabyi kwọ, m'mbira nde Ibinọkpaabyi kw'iva p'iva pọ k'epemaanitor <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Kaam m'ntọka izek nja maphyir s'Kenaan s'aning ma mach'okikennọng, nnang kọ ọttara efona chọ, mayena ttattampe. Kaam m'nde Ibinọkpaabyi kw'efonamma chọ.”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Ibinọkpaabyi obir oben Abraham bẹ́, “Ṉ́nòde kọ ọttara efona chọ, mm'akpobha idik s'echekẹ ndo chaam, ttattampe. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Ma wọ ode echekẹ ch'nchekẹ mmaana kọ ọttara iva p'iva, ch'mm'akpobha: mm'abhirẹ ojinọng kpenamkpen kw'oning ọmaana bọnga ọnọm. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Ẹnọmbhirẹ ndo ch'bọnga mm'asi m'ẹkọhka anọng bẹ́, kaam ọttara bọnga, nkk'echekẹ ọsa. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Tọma m'ogbe nwa china ororo, ojinọngnwa kpenamkpen kw'ọmmaan k'abọnga k'ottem, ópyirẹ iwu ochenọnttaan, mm'abhir-ẹ ọnọm. Tte ajinọng maphyir p'ammaan mabhirẹ inọm, ammaana, ọttara abira. Ozeng k'abira mbo p'mamaanẹ ny'abọnga k'ottem, ọttara mbo p'bọnga madebh-odebh, màbhirẹ bẹ ọnọm maphyir. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Zaabẹ́ ode nnwa kw'mabhonọ ny'ọsọhm, obir ode kw'matim akpuka adebh o, mm'abhir-ẹ ọnọm. Echekẹ chaam ch'ẹnọmbhirẹ m'ede ch'ttattampe. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Ojinọng kpenamkpen kw'ina ọnọm obhirẹ, mm'abhaangẹ z'ikpakaana s'anọng pẹ, okurọ bẹ́, kk'echekẹ chaam obhuma.”<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Ibinọkpaabyi obir oben Abraham bẹ́, “Ṉ́nòde Sarai, kw'ode kwanọng kwọ, tọma ma china ororo, ọdọk Sarai mòkpena, kẹ min'okpena bẹ́, Sara<note caller="+" style="f"><char style="fr" closed="false">17.15 </char><char style="fq" closed="false">Sara </char><char style="ft" closed="false">oyinẹ bẹ́, nnwa kw'ọvaarnọng.</char></note>. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Kaam m'ndẹ-ẹ, mbir nnang-ọ ojinọng kw'ofon ny'ẹbhọr chẹ. Kaam m'ndẹ-ẹ ọfha okwu ode ọkka kw'nkọma s'isaabh-ọsaabh. Avaar p'abaabh nkọma m'abir afona ny'ikẹ.”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Abraham otto okwubha ititika ny'izek; z'ettem, ọmma asa, oben bẹ́, “Ọnọng kw'ode icho arọbh achen mach'ikaam ma, m'osi yen pira obir obhon nnwa? Sara kw'obir ode icho arọbh anna okwuma ijobh ọdọk, m'osi yen pira ọmaan nnwa?”<verse eid="GEN 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 17:18" />Nya o, Abraham oben Ibinọkpaabyi bẹ́, “Wúra acher bẹ́, Ishimayẹl ọtọka ẹda chọ kẹ!”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Ma e. Kwanọng kwọ Sara, m'ọmaan-ọ ojinọngnwa kw'im'akpẹ-ẹ Isaak<note caller="+" style="f"><char style="fr" closed="false">17.19 </char><char style="fq" closed="false">Isaak </char><char style="ft" closed="false">oyinẹ bẹ́, Ọmma asa.</char></note>. Kaam m'nsi echekẹ ch'ttattampe mmaan-ẹ, ch'im'ebir ede ch'iva p'iva pẹ k'ogbe kw'ikẹ ikk'ọpa. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Ṉ́nòde odik kw'Ishimayẹl, kaam kk'ọ mmaanga. Kaam m'ndẹ-ẹ, nnang-ẹ iva k'ọsaabh. Iva p'iva pẹ mm'abir asaabh mawuriji. M'obhon avaar ijobh kkamfa, m'mbir nsi iva p'iva pẹ made ẹkọma chiden. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Okenaka, echekẹ chaam m'ebe ọmaana Isaak kw'Sara m'ọmaan, icho ogbese nwa.”<verse eid="GEN 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 17:22" />Ibinọkpaabyi ọgbaak odik nwo maphyir nya o, ofona orik Abraham nya.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Ny'ewu ndo madanẹ-danẹ, Abraham ọtọka Ishimayẹl kw'ode ojinọngnwa kwẹ, ọttara ajinọng maphyir p'ammaan ny'ikẹ k'ẹsọhmmọr, ọttara mbo p'odebh-odebh, obhirẹ bẹ ọnọm, k'ose kw'Ibinọkpaabyi otek-ẹ. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Wa Abraham ode icho arọbh anna okwuma osowanẹ kw'ẹrọbh k'atam k'ogbe kw'obhirẹ ọnọm. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />Ishimayẹl, nnwa kw'Abraham, wa ode icho ijobh kkanttaan k'ogbe kw'mabhir-ẹ ọnọm. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Ny'ewu ndo madanẹ dọ ch'Abraham ọmaana Ishimayẹl, mabhirẹ ọnọm. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />Ojinọng kpenamkpen kw'oning ny'Abraham k'ẹsọhmmọr, ámmáaná, ọttara ayok p'madebh bẹ z'okikennọng, wa mabir abhirẹ inọm.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">Ibinọkpaabyi obir ochekẹ bẹ́, Sara m'ọmaan ojinọngnwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Wa Ọvaar Ibinọkpaabyi oyin okebha Abraham za ch'ọnyọm nchi siden s'Mamrẹ. Wa ode k'ọyakpattem, k'ogbe kw'Abraham oning ẹwọr ny'ẹsọhmma ch'ikkira sẹ. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Abraham otinẹ ichen oze anọng minna attaan p'abe anyọm-ẹ nya. Oze bẹ nya o, obina ẹbhar-ẹbhar ny'ẹsọhmma ch'ikkira sẹ, od-okebha bẹ, ọraka eso ọnang bẹ.<verse eid="GEN 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 18:3" />Oben bẹ́, “Ttatta, óde ndaak-ọ idik, ọsọhm kw'ọtọhmnọng kwọ, kàkpan. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Tte mochena bọnga asi biribirẹ mfha magbobhọ mmo, mabir akwoka ọwọhng m'ofokodo kw'echi nda. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Tte ntima ọchattọhk nchena bọnga machi, mfha mayena ẹfa machina ororo k'ozenga kwabọnga, ch'nkk'achera bẹ́, mm'asaka ọtọhmnọng kwabọnga.”</para>
  <para style="p" vid="GEN 18:5">Mapọhn-ẹ bẹ́, “Ojibh-ojibh. Si k'ose kw'abenẹ nya.”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />Minna kw'Abraham ọsẹr-ọsẹr okebha Sara z'ẹtaanga, oben-ẹ bẹ́, “Tọka nrakpa nttaan s'agwu-buma ọkkọkka, atima si brẹd ẹbhar-ẹbhar.”<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Abraham obir ọsẹr-ọsẹr ochina z'etirakpo pyẹ, otéka ọbhaamnwa kw'ode ifor <char style="it">ma dọrọdọrọ</char>, ọtọka ọnang ọtọhmnọng wanẹ kwẹ bẹ́, ọfhọ ẹbhar-ẹbhar otima osi ọchattọhk. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Pira ọtọka abasi, ọmaana eten ndo obera bẹ. Ch'maning nya achi o, Abraham obe otuma bẹ ny'ofokodo kw'echi ndo.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Pira anọng mbo mabọbh Abraham bẹ́, “Sara kw'ode kwanọng kwọ kẹ?” Kẹ ọpọhna bẹ bẹ́, “Oning z'ikkira ẹtaanga.”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Ọnọng wanẹ ny'anọng mbo attaan, oben bẹ́, “K'odik ọkkọkka, ím'od-opyirẹ icho ogbese nwa, kaam m'mkpa nnam nkebha bọnga ma. Kwanọng kwọ Sara, m'ọmaan ojinọngnwa.”</para>
  <para style="p" vid="GEN 18:10">M'ogbe nwa, wa Sara obe ny'ẹsọhmma ch'ikkira njo s'ọnọng nwo ọkpa nnam ọbọra, od-oyong-ẹ itọhng. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Wa Abraham ọmaana Sara, nkk'atama mawuriji, Sara ọdọk ofor kotto. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Ofona nya, Sara ọmma asa, oben z'ettem bẹ́, “Kaam kw'ikk'ntama, odim kwaam obir ọtam, kaam m'mbir nyena olebh f'eyima?”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Ọvaar Ibinọkpaabyi, oben Abraham bẹ́, “Kayen kw'Sara ọmma asa, obir oben bẹ́, ‘Ma, ina mbir mmaan nnwa kk'atama o?’ <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Ọttọhk oning za f'Ọvaar Ibinọkpaabyi ini mòkpo osi o? Ó̱de ogbe nwo ikk'opyira, kaam m'mkpa nnam nkebha bọnga ma. Sara m'ọmaan ojinọngnwa.”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Sara ọbhaang idik njo nya o, ojor-ẹ. Kẹ okona, oben bẹ́, “Ttophyẹrẹ! Kaam asa kimma.”</para>
  <para style="p" vid="GEN 18:15">Ibinọkpaabyi oben-ẹ bẹ́, “K'odik ọkkọkka, kk'asa amma.”<verse eid="GEN 18:15" /></para>
  <para style="s">Abraham okwukọ Ibinọkpaabyi k'nso s'anọng p'Sọdọm</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />K'ogbe kw'anọng mbo attaan abin bẹ́, mafona, mad-abe k'ibyi janẹ, maze obhon kw'Sọdọm <char style="it">bẹ́ ttaan</char>. Abraham otor bẹ, od-orik bẹ z'eden. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Nya o, Ọvaar Ibinọkpaabyi ọbọbh ifor sẹ bẹ́, “Ma, ọbaan za bẹ́, ndubh Abraham odik nwa kw'nd-nkaam bẹ́, nsi ma yirẹ? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />K'odik ọkkọkka, kwuna iva p'iva p'Abraham mm'akwu ade ẹkọma chiden ch'im'ebir eyena ẹfa. Nkọma s'iyagbin maphyir m'ibir izenga ny'ikẹ, iyena ẹda. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Kẹ wọ kw'ikk'nteka bẹ́, okkerẹ iva pẹ, ọttara ẹsọhmmọr chẹ maphyir, otibh bẹ ose kw'mm'azenga k'eden ch'Ọvaar Ibinọkpaabyi k'ogbe kw'ikẹ ikk'ọpa. Osi bẹ masi idik ọkkọkka, ọmaana idik s'itor-otor, ọfha Ọvaar Ibinọkpaabyi osi idik njo maphyir s'ochekẹ ọnang-ẹ.”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Nya o, Ọvaar Ibinọkpaabyi oben bẹ́, “Anọng kk'adiktama p'Sọdọm ọmaana Gọmọra achona makpaar. Mpyibha sabẹ kk'ibir isaabha mawuriji. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />Kaam min'nsaka nd-nze óde epyibha ch'bẹ masi, ede k'odik ọkkọkka k'ose kw'anọng abenẹ. Ó̱de ina minna ode, m'nzong-ozonga.”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Pira ajinọng mbo mafona, machina z'ẹbhaakẹ ch'Sọdọm, marik Abraham ch'obe nya ọmaana Ọvaar Ibinọkpaabyi. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />Nya o, Abraham ozenga otuma Ibinọkpaabyi z'ifor, ọbọbh-ẹ bẹ́, “Ma, kọ m'agbaama anọng p'ator-otor, ọmaana anọng p'asi ẹyaaka afhọ o? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Ó̱de ode bẹ́, anọng arọbh afa okwuma ijobh maning ny'obhon nwo p'ator-otor, ma, kọ m'agbaama bẹ afhọ maphyir o? Anọng mbo arọbh afa okwuma ijobh màzenga ábẹ̀ akkaana obhon nwo o? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Tcha! Minna mòde, bẹ́, kọ m'agbaama anọng p'ator-otor, ọmaana anọng p'asi ẹyaaka, asi ose mawanẹ. Kayen kw'Ọkpaar-aponga kw'ayagbin maphyir ina ọttọhk f'otor-otor mòsi?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />Ọvaar Ibinọkpaabyi oben bẹ́, “Ó̱de nze anọng arọbh afa okwuma ijobh p'ator-otor ny'obhon kw'Sọdọm, kaam m'nzenga bẹ ábẹ̀, ntte obhon nwo kibungọ ọbọhk, ọdọk bẹ ọttọhk mìnsi.”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Minna kw'Abraham obir ọgbaak odik, oben Ọvaar Ibinọkpaabyi bẹ́, “Ch'ikk'ettem ngaanga bẹ́, mgbaak odik nnang-ọ, chibhẹ ch'nzong bẹ́, nkenka nde ididọhbh ọmaana ititọhng, <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />ńnòsi obhon nwo m'owor anọng achen p'iwura otim ottonga anọng arọbh afa okwuma ijobh p'ator-otor. Ma, kọ mafhọ ebhondim ndo k'ibungọ okurọ anọng achen o?”</para>
  <para style="p" vid="GEN 18:28">Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Mma e, óde oyen anọng arọbh afa okwuma achen p'ator-otor nya, kaam obhon nwo mìnkibhẹ.”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />Abraham ochina ororo okwukọ Ibinọkpaabyi, oben bẹ́, “Ó̱de ode bẹ́, anọng arọbh afa bẹ-bẹ bọ ator-otor, m'asi yen?”</para>
  <para style="p" vid="GEN 18:29">Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Ó̱de nze anọng arọbh afa ny'obhon nwo p'ator-otor, m'nzenga bẹ ábẹ̀, obhon nwo mìnkibhẹ.”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Abraham obir oben bẹ́, “Ttatta, ototo, oning-ọ ọdọkọ, tte-m ọbọhk nchina ororo mgbaak odik nwa. Ó̱de ode bẹ́ anọng ẹrọbh okwuma ijobh bẹ-bẹ bọ ator-otor ny'obhon nwo kẹ?”</para>
  <para style="p" vid="GEN 18:30">Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Zaabẹ́ anọng p'ator-otor made anọng ẹrọbh okwuma ijobh bẹ-bẹ, kaam m'ntte obhon nwo ọbọhk.”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Abraham oben bẹ́, “Tte mbọbh, ch'ikk'ottem gaangẹ nyena bẹ́, mgbaak odik nang Ọvaar Ibinọkpaabyi. Ó̱de aze anọng ẹrọbh bẹ-bẹ kẹ?”</para>
  <para style="p" vid="GEN 18:31">Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Ó̱de nze anọng ẹrọbh bẹ-bẹ, m'nzenga bẹ ábẹ̀ obhon nwo mìnkibhẹ.”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Nya o, Abraham oben bẹ́, “Ọvaar Ibinọkpaabyi, tte oning-ọ ọdọkọ, kenaka tte-m ọbọhk mgbaak okpongannamdik nwa. Ó̱de ode anọng ijobh bẹ-bẹ bọ aning nya kẹ?”</para>
  <para style="p" vid="GEN 18:32">Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́, “M'nzenga anọng mbo ijobh ábẹ̀, obhon nwo mìnkibhẹ.”<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />K'ogbe kw'Ọvaar Ibinọkpaabyi kk'idik njo ọgbaaka maphyir ọmaana Abraham, ofona. Abraham o, ọkpa nnam z'iruk-byi sẹ.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">Mpyibha s'anọng p'Sọdọm</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Okwu opyirẹ ny'ẹsọhka, azeng-eden mbo afa p'Ibinọkpaabyi mapyirẹ ny'Sọdọm. Ny'ogbe nwo, Lọt oning ẹwọr ny'ebhumma ch'obhon. Oze bẹ nya o, obina, ozenga okebha bẹ za, ọraka eso otwu ititika ny'izek k'ekpukamaana, ọnang bẹ. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />Oben bẹ bẹ́, “Ab'ttatta, ototo, makwuna k'ọsọhm kw'ọtọhmnọng kwabọnga, mfha m'agbobhọ mmo, mabira abhing nya. Ewu esobh k'ekpebha, mabina ozenga kwabọnga.”</para>
  <para style="p" vid="GEN 19:2">Akikennọng mbo nkacher, maben bẹ́, “Ttophyẹrẹ, mina mm'oyima z'ẹbhaama m'erungọ.”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Okenaka Lọt ochina ororo okwukọ bẹ maa, pira nnacher bẹ mator-ẹ mad-abhung z'ikẹ k'ọsọhm. Mapyirẹ za o, Lọt osi ọchattọhk ọnang bẹ, obir osi brẹd kw'ina obibir d'obir, machi. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />M'okwu opyirẹ k'ogbe kw'mmin'anwa, ajinọng p'Sọdọm maphyir, makwu nya, adikkobh ọttara ataminọng p'afon k'akpaarẹ maphyir p'ebhondim ndo, makwu akọbha ọsọhm nwo ake k'ettem.<verse eid="GEN 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 19:5" />Minna kw'mawon Lọt, maben-ẹ bẹ́, “Ajinọng mbo p'asak-ọ m'erungọ nda kẹ? Tọka bẹ nang mina moyima bẹ ábẹ̀.”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Lọt oyin z'iyaan okebh bẹ za. Obhen akikennọng mbo ọmma z'ẹtaanga, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />oben bẹ bẹ́, “Abayi, ototo, m'itamase nja kàsi. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Kaam nyena aminava afa ka p'nna ojinọng atima azonga. M'ntte bẹ ọbọhk nnang bọnga, mfha masi bẹ k'ose kw'ọdaakẹ bọnga. Ṉ́nòde ajinọng mba, ototo, màtte bẹ ọbọhk, kirẹ bẹ made akikennọng p'asak-m ọsaka e.”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Maben Lọt bẹ́, “Bhonga mina eden. Kọ nwa kw'ade okikennọng, kọ min'akwu ade ọkpaar-aponga? Í̱na mina eden abhong, f'mm'ọsọ-ọ, m'opyibh ọyọhnga fabẹ.” Minna kw'anọng mbo achin ororo make Lọt eso, marima k'ose kw'mm'avọhkọ ọmma. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />Okenaka, ajinọng mbo p'aning z'ẹtaanga, manemẹ ọbọhk, matọr Lọt atima adim z'ọsọhm, mabhen ọmma. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Pira nnasi ajinọng mbo maphyir p'abe ny'ẹsọhmma, adikkobh ọmaana ataminọng, makpa achen, mfha maning ọdọk eden ch'ọmma azong.<verse eid="GEN 19:11" /></para>
  <para style="s">Ebina ch'Lọt z'Sọdọm</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Nya kw'akikennọng mbo afa mabenẹ Lọt bẹ́, “Ma, ayen anọng ọdọk ọdọk z'ebhonmọr yirẹ, mach'anyẹ, ọmaana ajinọngva, wanẹma aminava? Tima bẹ bina ma, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />okurọ bẹ́, min'okibhẹ obhon nwoma maphyir. Ọvaar Ibinọkpaabyi kk'ọbhaanga ose kw'anọng p'obhon nwa mazeng apyibh. Kẹ wọ osi ọtọhm mina bẹ́, mokwu okibhẹ obhon nwoma maphyir.”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Minna kw'Lọt oyin k'iyaan, od-okebha ajinọng p'arọkọ aminava pẹ, oben bẹ bẹ́, “Màbina ẹbhar-ẹbhar, mọrọbh orik obhon nwa. Kirẹ Ọvaar Ibinọkpaabyi min'okibhẹ obhon nwoma.”</para>
  <para style="p" vid="GEN 19:14">Ajinọng mbo p'arọkọ aminava pẹ osi bẹ bẹ́, Lọt osi olokọ.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Ch'ewu min'esobha, azeng-eden p'Ibinọkpaabyi mabhọkọ Lọt bẹ́, “Tima kwanọng kwọ, ọttara aminava pọ afa p'aning ma, rọbh rik obhon nwa ẹbhar-ẹbhar. Ína minna ode, ekibhẹ ch'obhon nwa m'ẹbọka kọ ọttara.”<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Ch'Lọt okibhẹ ogbe kidaam o, azeng-eden mbo mabọka kẹ ọmaana kwanọng kwẹ, ọttara aminava pẹ afa ny'mbọhk, matima bẹ <char style="it">bẹ́ bẹẹẹm</char> mabina ny'obhon nwo, okurọ bẹ́, wa Ọvaar Ibinọkpaabyi oyen ikwosisi ọmaana bẹ. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />K'ose kw'matim bẹ ayin k'iyaan nya, ọnọng wanẹ ny'azeng-eden mbo, oben bẹ bẹ́, “Màrọbh k'ose kw'mm'akkaana akpen pabọnga. M'nnam kàbhakẹ o! Nk'ibyi kpenamkpen ny'ẹkpẹmẹ kàbir akpọka o. Màrọbh china z'agbe, ína minna ode, mm'ataang bọnga maphyir afhọ.”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Okenaka, Lọt oben bẹ bẹ́, “Mma o, ab'ttatta paam, ototo, <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />bọnga nkk'ọphyaam fiden asa anang-m, mabir asok-m akpen. Kaam mìmkpo nrọbh mpyirẹ z'agbe. Ó̱de njaar, itama nja m'ibọk-m k'eden, kaam m'mbir mpope. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Màkirẹ ebhonva dọ ẹnyọm ma. Tte nrọbh nchina nya, ọfha nyena ẹnaanga.”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Ozeng-eden nwo oben-ẹ bẹ́, “Ojibh-ojibh. Kaam m'nsosi k'ose kw'aphyem-m ma. Obhon nwo kw'agbaak odik amaana mìnkibhẹ. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Màsẹr-ọsẹr tima ẹbhar china za. Kaam ọttọhk kpenamkpen mìnsi maa, bọnga mapyirẹ ny'obhon.” Kẹ wọ osi pira mayerẹ obhon nwo bẹ́, Zoar<note caller="+" style="f"><char style="fr" closed="false">19.22 </char><char style="fq" closed="false">Zoar </char><char style="ft" closed="false">oyinẹ bẹ́, obiribirẹ.</char></note>.<verse eid="GEN 19:22" /></para>
  <para style="s">Ibinọkpaabyi okibhẹ Sọdọm ọmaana Gọmọra</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />K'ogbe kw'Lọt ọmaana anọng pẹ, nnapyirẹ z'Zoar, ode ch'ewu ikk'ẹnyaana. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Ny'ẹmma ndo, Ọvaar Ibinọkpaabyi oninga z'ẹrọng ọtọhm ata p'awọm ekpon ny'Sọdọm ọmaana Gọmọra. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Minna kw'Ibinọkpaabyi otim ekpon okibhẹ ibhondim njo, ọmaana ẹkpẹmẹ ndo k'ibungọ. Obir ọfhọ ayokinọng maphyir p'arukọ ny'ibhondim njo, ọttara ekpo maphyir py'emenẹ ny'izek njo.<verse eid="GEN 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 19:26" />Okenaka, kwanọng kw'Lọt ọbhakẹ nnam. Minna kw'ọbhakẹ ozeng enung-takpa ch'ebe <char style="it">bẹ́ pyirr</char>.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Ny'ekpikpebha kw'owusobha, Abraham ọpọm ochina za ch'wendo obe ọgbaak odik ọmaana Ọvaar Ibinọkpaabyi. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Okkerẹ z'ẹbhaakẹ ch'Sọdọm, ọmaana Gọmọra, ọttara ozek f'ẹkpẹmẹ ndo. Oze izizong s'ikk'idabha <char style="it">bẹ́ gwẹk</char>, ipyi ewu <char style="it">bẹ́ kkang</char>.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />K'ogbe kw'Ibinọkpaabyi kk'ibhondim njo s'ẹkpẹmẹ okibha maphyir, ojima Abraham. Ọrọbha Lọt ny'itama njo s'ikpẹkẹ ibhondim njo s'iwa Lọt orukọ.<verse eid="GEN 19:29" /></para>
  <para style="s">Ẹtọma ch'Moab ọmaana Ammọn</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Wa Lọt ojor-ẹ ojora bẹ́, oruk ny'Zoar. Ofona nya, otima aminava pẹ afa, obina ochina z'agbe, mad-aruk k'ọtakpamma wanẹ.<verse eid="GEN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 19:31" />Otum k'ewu danẹ, ochedennwa kwẹ oben oyok kw'ikarẹ bẹ́, “Atte kwamina kk'ọtama. Ojinọng ọdọk-ọdọk ma kode kw'im'oyima mina ábẹ̀, k'ose kw'ẹmmaana ch'iyagbin maphyir ede. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Tte mọnang atte kwamina atuk ogwo maa, masẹ-ẹ k'ose kw'mm'oyima ọmaan-ẹ, ọfha ofona ny'ikẹ, echimma chamina ening edimẹ.”<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />Otum ny'erungọ, manang otte atuk, ogwo maa masẹ-ẹ. Ochedennwa nwo odim okebha za, od-oyima ọmaan-ẹ. Otte ogbe kozong kw'nnwa kwẹ okwu oyima nya, ogbe kobir ozonga kw'obin orik-ẹ nya.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Ewu esobh nya, ocheden nwo oben oyok kw'ikarẹ bẹ́, “Chena k'erungọ nyim mmaana atte kwaam. Tte mobir ọnang-ẹ atuk m'erungọ maa, masẹ-ẹ, k'ose kw'ikọ mabir ayima amaan-ẹ, ọfha ofona ny'ikẹ, echimma chamina ening edimẹ.”<verse eid="GEN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 19:35" />Minna kw'mabir anang otte atuk ny'erungọ maa, masẹ-ẹ, oyok kw'ikarẹ obir odim od-oyima ọmaan-ẹ. Otte ogbe kobir ozonga kw'nnwa kwẹ oyim ọmaan-ẹ, ogbe kobir ozonga kw'obin orik-ẹ nya.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Minna kw'uwa panọngva mbo afa p'Lọt mazeng atima ibhọr s'otte kwabẹ oke bẹ. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Ochedennwa nwo ọmaan ojinọngnwa, ọkpẹ-ẹ, Moab. Nnwa nwo wọ ode otte kw'anọng p'Moab nda. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Oyok kw'ikarẹ obir ọmaan ojinọngnwa, ọkpẹ-ẹ Bẹn-Ammi. Kẹ wọ ode otte kw'anọng p'Ammọn p'aning m'iyagbin maa, pyirẹ menda.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">Abraham ọmaana Abimẹlẹk</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />M'ogbese nwa, Abraham obina orik Mamrẹ, ozenga ochina z'ẹbhaakẹ ch'Nẹgẹv, od-oruk ny'njeka kw'Kadẹsh ọmaana Shur. Oninga ny'Gẹra k'ogbe biribirẹ. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />Nya wọ kw'otek anọng bẹ́, Sara ode ọgbaanotte kwẹ. Ofona nya o, Abimẹlẹk kw'ode ọvaarnọng kw'Gẹra ọtọhm bẹ́, mayerẹ Sara anang-ẹ.<verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />Okenaka, k'orungiwu wanẹ, Ibinọkpaabyi oyin okebha Abimẹlẹk k'ọda, oben-ẹ bẹ́, “Kọ kk'opupe apa e, okurọ bẹ́, kwanọng nwo kw'atọk nya, kk'odim ọba.”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />Ny'ogbe nwo, Abimẹlẹk ọmaana Sara m'ifor atima abhina. Ofona nya o, ọbọbh Ibinọkpaabyi bẹ́, “Ọvaar Ibinọkpaabyi, ma, ọbaan za bẹ́, akibhẹ ẹkọma ch'mbọhk sẹ iwur-owur o? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Abraham ny'ikẹ k'ifor otek-m bẹ́, Sara ode ọgbaanotte kwẹ. Sara oyenẹ obir otek-m bẹ́, Abraham ode ọgbaanotte kwẹ. Ettem chaam ọmaana achibhẹ paam made <char style="it">bẹ́ ttaan</char>.”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Ofona nya, Ibinọkpaabyi oben Abimẹlẹk k'idachen bẹ́, “Iye, kaam kk'nzonga bẹ́, odik nwa k'ẹyaaka kasi. Ofona nya, mkpọ-ọ eden bẹ́, aning epyibha asi k'ikaam k'ititika. Kẹ wọ osi pira kìmbir nchera bẹ́, ayim-ẹ ábẹ̀. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Tera tte kwanọngnwa ọbọhk ọkpa nnam z'odim. Odim kwẹ ode ọgbaak-ettem ch'Ibinọkpaabyi. Kẹ m'oze njọm ọnang-ọ ọfha, aruk akpen. Okenaka, óde ina Sara ọbọhk atte ọkpa nnam z'odim, zonga bẹ́, kọ ọttara anọng pọ maphyir, mm'ape.”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />K'ekpikpebha ch'ewu esobh, Abimẹlẹk oyerẹ adidennọng pẹ maphyir, otek bẹ odik kw'oyinẹ maphyir. Ojora osi bẹ mawuriji. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Pira Abimẹlẹk oyerẹ Abraham, ọbọbh-ẹ bẹ́, “Bọng-odik wọ kw'asi mina ma o? Mpin-ọ yen, kw'awọhkọ odik katamse nwa anang-m ọttara ọvaarbhon kwaam o? Ọttọhk f'asi anang-m ma, kọbaan.” <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Abimẹlẹk ochina ororo, ọbọbh Abraham bẹ́, “Bọng-ọttọhk f'azeng ábẹ̀ asi-m odikse nwa?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />Abraham ọpọhn-ẹ bẹ́, “Kaam osi-m bẹ́, anọng p'obhon nwoma, m'opoma f'Ibinọkpaabyi kayen, mbir nchibhẹ bẹ́, mm'afhọ-m okurọ kwanọng kwaam. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Obir ode k'odik ọkkọkka bẹ́, otte mawanẹ wọ obhonọ mina, za wura mọkọm abakka. Kaam ntọk-ẹ mach'kwanọng kwaam. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />K'ogbe kw'Ibinọkpaabyi osi-m mbina nrik oter kw'atte kwaam mkpaanga k'ibyi k'ibyi, mben Sara bẹ́, minna kw'mad-atima akọhk-m ọdaakẹ kwọ: k'ibyi kpenamkpen s'im'opyirẹ, tek anọng bẹ́, kaam nde ọgbaanotte kwọ.”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Nya o, Abimẹlẹk ọtọka arọkimaan ọmaana adamogbodo, ọmaana abira p'ejinọng, ọttara p'ẹpanọng, ọnang Abraham, obir otte Sara ọbọhk, ọnang-ẹ. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Abimẹlẹk oben Abraham bẹ́, “Kirẹ izek saam jọ ining-ọ m'ititika, ruk k'ibyi kpenamkpen s'idaak-ọ.”<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />Abimẹlẹk obir oben Sara bẹ́, “Kaam m'nnang agbaanatte ashẹkẹl p'silva nnọhna mfa okwuma arọbh ijobh; ọfha otima odimẹ odik nwo z'ititika s'anọng mbo p'aning amaan-ọ. Minna wọ im'ọkọhka bẹ́, epinẹ kpenamkpen kàsi.”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Nya o, Abraham oze njọm ọnang Abimẹlẹk, Ibinọkpaabyi okwu obina ọnang Abimẹlẹk, ọmaana kwanọng kwẹ, ọttara abirapanọngva pẹ, mfha mabir akpo ọmaan asi, <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />okurọ bẹ́, wa Ibinọkpaabyi kk'Sara, kw'ode kwanọng kw'Abraham ozenga ábẹ̀ osi ẹsọhmmọr ch'Abimẹlẹk ẹkpaana.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">Ose kw'uwa Isaak ozeng ọmmaana</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Wa Ọvaar Ibinọkpaabyi osi ejibha ọnang Sara k'ose kw'uwa ikk'ocheka. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Sara okwu otima ibhọr, ọmaan Abraham ojinọngnwa k'ogbe kw'Abraham ikk'ọtama. Wa nnwa nwo ọmmaan k'ogbe kw'Ibinọkpaabyi ochekẹ bẹ́, m'ọmmaana. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Abraham ọkpẹ-ẹ Isaak.<verse eid="GEN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 21:4" />Okwu opyirẹ iwu ochenọnttaan s'nnwa nwo ọmmaan, Abraham obhir-ẹ ọnọm k'ose kw'Ibinọkpaabyi ikk'ẹ oteka. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Ny'ogbe kw'Isaak ọmmaan, Abraham ode icho arọbh achen.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />Sara oben bẹ́, “Ibinọkpaabyi kk'aam ọsa bẹ́, mma asa. Ọnọng kpenamkpen kw'ọbhaang odik nwa, m'otor-m mọmma asa.” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Obir oben bẹ́, “Bọng-ọnọng wọ iwura oben Abraham bẹ́, Sara m'ọmaan iva? Chibhẹ nya, kk'ojinọngnwa mmaana nnang-ẹ k'atam.”<verse eid="GEN 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Minna kw'nnwa nwo obeng maa, matim-ẹ ẹba. Okwu opyirẹ ny'ewu ch'makwur-ẹ, Abraham osi odidaama kwiden.<verse eid="GEN 21:8" /></para>
  <para style="s">Abraham okwubhọ Hagar ọmaana Ishimayẹl</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />Ewu danẹ, Sara oze nnwa kw'Hagar nwo kw'ofon Ijip ọmaanẹ ọnang Abraham, ch'ọd-ọmma Isaak asa. <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />Sara oze nya o, oben Abraham bẹ́, “Kwubh obirakwanọng nwoma ọttara nnwa kwẹ mafona. Kọbaan bẹ́, nnwa kw'obira nwoma oyen okebh k'ojibhada kwọ kw'nnwa kwaam Isaak im'ochi obo.”<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Odik nwo ọyakẹ Abraham odik z'ettem mawuriji, okurọ bẹ́, Ishimayẹl obir ode nnwa kwẹ ọdọk. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Okenaka, Ibinọkpaabyi okwu oben Abraham bẹ́, “Ettem ening-ọ odik ẹyakẹ okurọ nnwa nwo kwọ ọmaana ọkka kwẹ. Si ọttọhk kpenamkpen f'Sara oben-ọ bẹ́, asi, okurọ bẹ́, m'ofona k'Isaak, kọ ayena iva k'ọsaabh k'ose kw'uwa ikk'ncheka nnang-ọ. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Kaam m'nsi nnwa nwo kw'obiranọng nwo ọmaanẹ, obir oyena iva k'ọsaabh p'mm'asi ẹkọma chiden, okurọ bẹ́, kẹ obir ode nnwa kwọ ọdọk.”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />Minna kw'Abraham obin k'ekpikpebha, ọtọka ọchattọhk ọnang Hagar, obir oke asi k'ẹkpa ch'matim etenkpa asi, ọnang-ẹ, ọtọka ekpo mbyo ọnan-ẹ k'ebubaang, okwubh-ẹ ọttara nnwa kwẹ. Kwanọng nwo ofona, od-owena z'ibyi s'anọng nna arukọ, z'ẹbhaakẹ ch'Beershẹba.<verse eid="GEN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15" />K'ogbe kw'asi mbo nkk'asa maphyir, Hagar ọtọka nnwa nwo osok ny'ofokodo kw'echi danẹ, <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />ofona orik-ẹ nya, ozenga makikaarẹ od-oninga ẹwọr, oben ifor sẹ bẹ́, “Kaam mìmkpo nninga nze ch'nnwa nwo im'ope.” K'ose kw'oning ẹwọr nya, osorọ asen.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Ibinọkpaabyi ọbhaanga ẹmọng ch'nnwa nwo, ozeng-eden kw'Ibinọkpaabyi oninga z'ẹrọng, owon Hagar, oben-ẹ bẹ́, “Hagar, ode yen? Oning-ọ ojor, Ibinọkpaabyi kk'ẹmọng ch'nnwa kwọ ọbhaanga ch'oyim nya. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Bina, zọhng bọk-ẹ ny'ọbọhk. Kirẹ kaam m'nsẹ-ẹ ode otte kw'ẹkọma chiden.”<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />Nya o, Ibinọkpaabyi owonga Hagar achen, oze esipe, ọd-ọtọka ẹkpa ndo chẹ, ọkaabha asi oke nya maa, mafu, ọtọka ọnang nnwa, ogwo.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />Wa Ibinọkpaabyi oning ọmaana nnwa nwo k'ose kw'od-obenga. Kẹ wa orukọ z'ibyi s'anọng nna arukọ, okwu ode ọgbaaji kwiden. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Nya ch'iwa orukọ za ch'anọng nna arukọ z'Paran, ọkka ọd-ọtọka kwanọng z'Ijip, ọnang-ẹ k'ọba.<verse eid="GEN 21:21" /></para>
  <para style="s">Abraham ọmaana Abimẹlẹk machekẹ anang ayok</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Ny'ogbe nwo, Abimẹlẹk otima Phikol kw'ode osonọng kw'asoja pẹ, oben Abraham bẹ́, “Mina nkk'ọza bẹ́, Ibinọkpaabyi oning ọmaan-ọ k'idik maphyir s'ikọ asi. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Nya o, kaam mben-ọ bẹ́, achekẹ anang-m k'Ibinọkpaabyi k'ititika bẹ́, kọ kaam mabọhra, ọmaana iva paam, ọttara iva p'iva p'ikwuna iva paam mm'abhon. K'ose kw'nd-nsi ẹmmaana ọkkọkka ntima ntor-ọ, ọbaan bẹ́, kọ abir agbaka ifor amaana kaam ọttara ẹkọma nda ch'arukọ ma mach'okikennọng.”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />Abraham ọpọhn-ẹ bẹ́, “Kaam kk'ncheka minna.”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Nya o, Abraham otek Abimẹlẹk odik kw'esipe ch'atọhmnọng p'ikẹ Abimẹlẹk nkk'ẹ ana. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />Abimẹlẹk oben-ẹ bẹ́, “Ọnọng kw'osi ọttọhkse mva kinzong, kọ kaam odik nwoma katekẹ. Ma wọ ode ocheden-gbe kw'ikaam mmaang odik nwa.”<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Nya o, Abraham ọtọka arọkimaan ọttara adamogbodo ọnang Abimẹlẹk, bẹ anọng afa machekẹ anang ayok. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Abraham ọrọhbha arọkimaanpa pẹ achenọmfa, ọkọm osok. <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />Abimẹlẹk ọbọbh Abraham bẹ́, “Arọkimaanpa pẹ achenọmfa mba p'akọm asok ma, ayinẹ yen?” <verse eid="GEN 21:29" /><verse number="30" style="v" sid="GEN 21:30" />Abraham ọpọhn-ẹ bẹ́, “Kọ chera bẹ́, m'atọka arọkimaanva mba achenọmfa m'kaam k'ọbọhk mach'nttẹsẹ bẹ́, kaam wọ ntumọ esipe nda.”<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Ofona nya o, mayerẹ ibyi njo bẹ́, Beershẹba, okurọ bẹ́, nya wọ kw'anọng mbo afa maning achekẹ anang ayok.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />Ch'nkk'echekẹ ndo achera z'Beershẹba, Abimẹlẹk ọmaana Phikol kw'ode oso kw'asoja mabina abhana z'ẹbhaakẹ ch'aPhilistiya. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Nya o, Abraham ogbon echi ch'mayerẹ tamarisk ny'Beershẹba, oninga nya okpobha Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'ttattampe. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Wa Abraham orukọ mach'okikennọng ny'ẹbhaakẹ ch'aPhilistiya k'icho k'ẹkaan.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s1">Ibinọkpaabyi ọnang Abraham eyoma</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Okwu opyirẹ k'ogbe wanẹ, Ibinọkpaabyi ọnang Abraham eyoma. Oyer-ẹ bẹ́, “Abraham!”</para>
  <para style="p" vid="GEN 22:1">Abraham ọpọhn-ẹ bẹ́ “Kirẹ kaam ma.”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Ibinọkpaabyi oben-ẹ bẹ, “Tọka ojinọngnwa kwọ Isaak, kw'ode ojinọngnwa kwọ manchenẹ kw'asokọ ettem, tim-ẹ china z'ẹbhaakẹ ch'Moriya. Tim-ẹ fọhnọ ẹja ch'ẹkwọmọ ny'egbe danẹ ch'im'ntibh-ọ nang-m.”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Ewu esobh nya, k'ekpikpebha, Abraham obina, ọtọka ẹtọhka ọdabh ẹnyanya chẹ, ọtọka atọhmọ pẹ afa ọttara nnwa kwẹ, Isaak, ọkpaara ommenẹ f'im'obeng-ẹ k'ẹja ch'ẹkwọmọ, ọtọma ozenga ochina z'ibyi s'Ibinọkpaabyi ikk'ẹ otibha.<verse eid="GEN 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 22:4" />Ottong iwu ittaan nya o, Abraham otinẹ achen k'ẹrọng, oze ibyi njo s'Ibinọkpaabyi oben-ẹ z'ororo. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Oben atọhmọ pẹ bẹ́, “Màbe ma maana ẹnyanya nda; kaam ọttara ojinọngnwa nwoma, mm'ochina kina ororo, mod-okpobha Ibinọkpaabyi. Ode nkk'ochera, mm'ọkpa nnam okebha bọnga ma.”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Abraham ọtọka ommenẹ f'im'otima ọfọhnọ ẹja ch'ẹkwọmọ, ọnana Isaak, kẹ oyenẹ otima ekpon ọttara imaana. <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />Ch'nd-azenga ny'eden o, Isaak ọbọbh otte Abraham bẹ́, “Ttatta kwaam?”</para>
  <para style="p" vid="GEN 22:7">Otte ochera bẹ́, “Owee, nnwa kwaam.”</para>
  <para style="p" vid="GEN 22:7">Isaak oben-ẹ bẹ́, “Ommen ọttara ekpon ening ma. Okenaka, ọrọkimaan kw'mm'otima ọfọhnọ ẹja ch'ẹkwọmọ kẹ?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />Abraham ọpọhn-ẹ bẹ́, “Nnwa kwaam, Ibinọkpaabyi ny'ikẹ k'ifor m'ọnang mina ọrọkimaan kw'mm'otima ọfọhnọ ẹja ndo ch'ẹkwọmọ.”</para>
  <para style="p" vid="GEN 22:8">Minna kw'bẹ anọng afa machin ororo k'ozenga kwabẹ.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Mapyirẹ ny'ibyi s'Ibinọkpaabyi otibh-ẹ nya o, Abraham ottima ija-byi nya, obir ọtọka ommen otobha nya. Okwu ọtọka nnwa kwẹ, Isaak ọdabh-ẹ mbọhk ọttara mmo, otin-ẹ orurọ ny'ommen ẹrọng. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Okwu onemẹ ọbọhk ọtọka imaana bẹ́, ọfhọ nnwa kwẹ.<verse eid="GEN 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 22:11" />Pira ozeng-eden kw'Ọvaar Ibinọkpaabyi oninga z'ẹrọng oyer-ẹ bẹ́, “Abraham! Abraham!” Kẹ ọpọhna bẹ́, “Kirẹ kaam ma.”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />Ozeng-eden nwo oben-ẹ bẹ́, “Nnwa nwo ọttọhk kpenamkpen kàsi o! Kaam kk'nza bẹ́, kọ ayen ojora f'Ibinọkpaabyi mawuriji, okurọ ch'ina abhumọ bẹ́, anang-m nnwa kwọ manchenẹ.”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Minna kw'Abraham otinẹ ichen oze ọrọkimaandim kw'ikk'abhik otima ọdama ny'ẹdabhẹ. Ọtọka ọrọkimaandim nwo otima ọfọhnọ ẹja ch'ẹkwọmọ, k'eso ch'nnwa kwẹ. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Nya o, Abraham oyerẹ ibyi njo bẹ́, “Ọvaar Ibinọkpaabyi wọ im'ọnang.” Tọma za maa pyirẹ menda, anọng ad-aben bẹ́, “Ny'egbe ch'Ọvaar Ibinọkpaabyi, Kẹ m'ọnang-ọnang.”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />Ozeng-eden kw'Ọvaar Ibinọkpaabyi obir oninga z'ẹrọng oyerẹ Abraham ttonga igbedim ifa, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />oben bẹ́, “Nchekẹ k'eche ch'kaam Ọvaar Ibinọkpaabyi bẹ́, okurọ ch'ina abhumọ bẹ́, anang-m ojinọngnwa kwọ manchenẹ, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />kaam m'ndọ-ọ k'odik ọkkọkka, mbir nsi iva p'iva pọ masaabh mach'ndidorọ s'ọrọngkpakpa, mabir asaabh mach'ofong kw'ẹraangapa. Iva p'iva pọ mm'ana awawunanọng pabẹ ibhondim sabẹ. <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />M'ofona ny'iva p'iva pọ, nkọma s'iyagbin maphyir iyena ẹda chaam, okurọ bẹ́, akpobh idik saam.”<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Nya o, Abraham ọkpa nnam od-okebha atọhmnọng pẹ za, matọn abhana z'Beershẹba. Wa Abraham osi oruk kwẹ ny'Beershẹba.<verse eid="GEN 22:19" /></para>
  <para style="s1">Ẹnọmma ch'Nahọr</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />K'ogbe wanẹ, matekẹ Abraham bẹ́, Milka kk'ajinọngva ọmaana ọnang Nahọr, kw'ode ọgbaanọkka kw'Abraham. Wa iva mbo made<verse eid="GEN 22:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 22:21" />Uz kw'ode ochedennwa,</para>
  <para style="li1" vid="GEN 22:21">ọmaana Buz kw'otor-ẹ nnam,</para>
  <para style="li1" vid="GEN 22:21">ọmaana Kẹmuẹl (kw'ode otte kw'Aram),<verse eid="GEN 22:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 22:22" />ọmaana Kẹsẹd,</para>
  <para style="li1" vid="GEN 22:22">ọmaana Hazo,</para>
  <para style="li1" vid="GEN 22:22">ọmaana Pildash,</para>
  <para style="li1" vid="GEN 22:22">ọmaana Jidlaph,</para>
  <para style="li1" vid="GEN 22:22">ọttara Bẹtuẹl. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Bẹtuẹl wọ uwa ode otte kw'Rẹbẹka. Wa Milka ọmaanẹ iva mba ochenọnttaan ọnang Nahọr kw'ode ọgbaanọkka kw'Abraham.<verse eid="GEN 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 22:24" />Wa kwanọng ọdọk-ọdọk kw'Nahọr kw'okpen Reuma, obir ọmaan-ẹ ajinọngva, p'ade Tẹba, ọmaana Gaham, ọmaana Tahash, ọttara Maaka.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s1">Obo ọmaana ẹnọhnga ch'Sara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Wa Sara orukọ icho arọbh achadanẹ okwuma ichenọmfa. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Ope z'Kiriyat-Arba, kw'mabir ayerẹ, Hẹbrọn, z'ẹbhaakẹ ch'Kenaan. Abraham ọtọka ogbe obhom Sara mawuriji.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Obhom-ẹ nya o, obina orik ibyi s'kwanọng kwẹ ope, ochina z'anọng p'Het, oben bẹ bẹ́, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“Kaam nde okikennọng kw'nrukọ ma mmaana bọnga. Ototo, màkpe-m izek s'im'nnọhnga kwanọng kwaam.”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />Anọng p'Het apọhn-ẹ bẹ́, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“Ttatta, yonga mina itọhng. Moze bẹ́, kọ ade odidennọng kw'okem ẹbara ma; nọhnga kwanọng kwọ m'ẹbhaakẹ chamina k'epekwuk kpenamkpen ch'ẹdaak-ọ. Ọnọng m'amina kode kw'im'ọram-ọ ibyi s'im'anọhnga kwanọng kwọ.”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Minna kw'Abraham obin ọraka eso ọnang anọng p'Het, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />oben bẹ bẹ́, “Ó̱de bọnga nkk'achera bẹ́, nnọhnga offuranọng kwaam, tte mbir mphyem bọnga odik mawanẹ. Ototo, màphyem Ẹpharọn, kw'ode nnwa kw'Zoha k'kaam k'eso. <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />Màben-ẹ bẹ́, ọtọka ọtakpamma kw'Makpẹla okpe-m. Ọtakpamma nwo oning z'ewonọ-so chẹ. Màben-ẹ bẹ́, okpe-m ibyi njo k'ẹphya ch'ẹbaan, ọfha ntima mach'ibyi s'min'nd-nnọhnga affuranọng.”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />Mach'Abraham ọd-ọgbaak odik nwo, kẹ Ẹpharọn kw'ofon Hit, oning ẹwọr nya ọmaana anọng pẹ, ọbhaanga idik s'Abraham. Ọpọhna Abraham odik nwo k'ose kw'anọng mbo maphyir p'nkk'akwa ny'ebhumma ch'obhon nwo, mabhaang. <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />Oben-ẹ bẹ́, “Mma e, ttatta kwaam. Yong-m itọhng; kaam nnang-ọ izek njo ọttara ọtakpamma kw'oning nya. Ntte ọbọhk nnang-ọ m'ititika s'anọng paam. Nọhnga offuranọng kwọ nya.”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />Nya o, Abraham obir ọraka eso k'ekpukpobha-maana ọnang anọng p'obhon nwo, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />ọgbaak Ẹpharọn k'ose kw'anọng mbo mm'abhaanga, oben-ẹ bẹ́, “Ototo, yong-m itọhng. Kaam m'nnang-ọ akpuka p'abaan ny'izek njo. Ototo, tọka, ọfha nnọhnga offuranọng kwaam nya.”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />Ẹpharọn ọpọhna Abraham bẹ́, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“Ttatta kwaam, yong-m itọhng. Ẹphya ch'izek njo m'epyirẹ ashẹkẹl p'silva ẹnọhna, okenaka, akpuka mbo m'ọttọhk-afẹ kabang z'ẹgbaka ch'kaam ọttara kọ moyen. Nọhnga offuranọng kwọ nya.”<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />Abraham ochera nttọhna s'Ẹpharọn, oyoma ashẹkẹl p'silva k'ose kw'obenẹ, ọnang-ẹ ny'ikpakaana s'anọng p'Het. Wa adọhbhiji p'silva mbo made ashẹkẹl ẹnọhna, k'ose kw'okpukabhik ode ny'ogbe nwo.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Ofona nya, izek s'Ẹpharọn s'ining z'Makpẹla, s'inyọm Mamrẹ, ọmaana ọtakpamma kw'oning nya, ọttara nchi maphyir s'ibe ny'enem ch'izek njo, wa nnatte ọbọhk anang Abraham <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />mach'izek sẹ ny'ititika s'anọng p'Het maphyir p'nkk'attonga ny'ebhumma ch'obhon nwo. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Nwonya ọsa nya o, Abraham ọd-ọnọhnga kwanọng kwẹ Sara ny'ọtakpamma nwo ny'izek s'Makpẹla s'inyọm Mamrẹ, z'ẹbhaakẹ ch'Hẹbrọn, z'ẹkọma ch'Kenaan. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Minna kw'uwa anọng p'Het mazeng asi nttọhna, matọka izek ọttara ọtakpamma nwo kw'oning nya, manang Abraham bẹ́, oyena mach'ibyi s'im'ọd-ọnọhnga affuranọng.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s1">Isaak ọmaana Rẹbẹka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />K'ogbe kw'uwa Abraham kk'ọtama mawuriji, obir oruk icho k'ẹkaan, wa Ọvaar Ibinọkpaabyi kk'ẹ ọda k'eden kpenamkpen. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Oben oso kw'atọhmnọng p'ẹsọhmmọr chẹ bẹ́, “Yika ọbọhk kwọ m'ntaak saam. <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />Nnorọ bẹ́, anwọhngọ k'eche ch'Ọvaar Ibinọkpaabyi kw'osi ẹrọng ọmaana izek bẹ́, kọ kwanọng kw'ofon m'Kenaan kw'nrukọ màtọka anang Isaak kw'ode nnwa kwaam. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />Kọ m'atera achina z'obhon kwaam, z'anọng paam, atọka kwanọng anang nnwa kwaam Isaak.”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />Ọtọhmnọng nwo ọbọbh-ẹ bẹ́, “Ó̱de kwanọng nwo ina ocher bẹ́, m'otor-m okwu m'izek nja kẹ? Ma, arorọ bẹ́, ntọka nnwa kwọ ntima nchina z'ibyi s'afon yirẹ?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Abraham oben ọtọhmnọng kwẹ bẹ́, “Mma e, eso ening-ọ ẹkpanẹ bẹ́, atima nnwa kwaam akpa nnam z'ibyi njo o. <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Ọvaar Ibinọkpaabyi kw'ẹrọng, otim-m obina orik ẹsọhmmọr ch'atte kwaam, ọmaana obhon kwaam maphyir. Ọgbaak-m odik, obir ọnwọhngọ ọnang-m bẹ́, m'ọtọka izek nja s'moning ma ọnang efona chaam. Oben-m bẹ́, iva p'iva paam, bẹ bọ mm'ayena ẹkọma nda. Kẹ Ibinọkpaabyi m'ọtọhm ozeng-eden kwẹ, otim-ọ eden ad-atọka kwanọng za, anang ojinọngnwa kwaam. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Ó̱de kwanọng nwo ina ocher bẹ́, otor-ọ makwu, kk'anaanga m'nwọhngọ nja saam. Okenaka, nnwa kwaam nnam za kàtima akpa.”<verse eid="GEN 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 24:9" />Minna kw'ọtọhmnọng nwo, ọtọk ọbọhk kwẹ oyika otte Abraham ny'ntaak, ọnwọhngọ bẹ́, m'osi k'ose kw'otte ikk'ẹ obena.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Nya o, ọtọhmnọng kw'Abraham obina ofona, ọtọka nten ijobh s'otte s'mayerẹ kamẹl, ọttara ekpo saabhada k'akira k'akira py'ejibh-ojibh. Ọtọma ozenga ochina z'Aram-Naharaim z'obhon kw'uwa Nahọr kw'ode ọgbaanọkka kw'Abraham orukọ. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Opyirẹ za o, ochina z'esipe ch'ening ny'obhon okikaan, osi akamẹl mbo mattima ndudungọ anyọhma ny'esipe ndo. Wa ode k'ẹsọhka k'ogbe kw'panọng mad-ayin esikaabha.<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />Obe nya oze njọm bẹ́, “O Ọvaar Ibinọkpaabyi kw'atte kwaam okpobh, kwu kkaan-m menda akọhka Abraham kw'ode atte kwaam ọdaakẹ kwiden. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Kirẹ kaam wọ mbe m'okikaan kw'ekeka nda ch'aminava p'obhon nwoma mad-akwu akaabha asi. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Tte ominanwa kw'im'mben bẹ́, ‘Ototo, tte ngwo asi k'isi-zọhka sọ,’ oben-m bẹ́, ‘Gwo, kaam m'mbir nnang akamẹl pọ asi,’ tte ode bẹ́, kẹ ominanwa nwo wọ kw'ikk'atéka asok ọtọhmnọng kwọ Isaak. Minna kw'im'ntima nzonga bẹ́, kọ kk'ọphyaam asa anang atte kwaam.”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Min'ochera njọm ozize, Rẹbẹka oyin ka, ọmaana isi-zọhka sẹ s'ọnan ny'ebubaang. Wa kẹ ode ominanwa kw'Bẹtuẹl, kw'ode nnwa kw'Milka kw'uwa ode kwanọng kw'Nahọr, ọgbaanọkka kw'Abraham. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Wa Rẹbẹka ojibh ominanwa mawuriji, obir ode bẹ́, ojinọng otim ozonga. Minna kw'ọsak z'ekeka ọkaabha asi maa, isi-zọhka ifu, otima ovura.<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />Ọtọhmnọng kw'Abraham ọsẹr-ọsẹr od-okebh Rẹbẹka oben-ẹ bẹ́ “Ototo, nang-m asi biribirẹ ny'isi-zọhka sọ, ngwo.”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Kẹ Rẹbẹka ọpọhn-ẹ bẹ́, “Atte kwaam, kwu gwo.” Ọsaka isi-zọhka sẹ ẹbhar-ẹbhar ọnang-ẹ asi ogwo.<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />Ch'ikk'ẹ asi ọnanga ogwo o, oben-ẹ bẹ́, “Kaam m'mbir nkaabha asi nnang akamẹl pọ maa, mabenga bẹ.” <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />Minna kw'ọsẹr-ọsẹr owona asi pẹ ny'ẹjọ ch'eber nya, ọkpa nnam ẹbhar-ẹbhar ọd-ọtọhr asi oke ny'isi-zọhka k'ose kw'mm'abenga akamẹl p'ọjinọng nwo. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Kẹ ojinọng nwo omyi <char style="it">bẹ́ sẹẹbh</char>, oke otum mawuriji mfha ozonga ode Ọvaar Ibinọkpaabyi ikk'ẹ owujibha ọnanga ny'ozenga nwo kwẹ.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />K'ogbe kw'akamẹl mbo ikk'asi agwa maphyir, ọtọhmnọng nwo ọrọbha ẹbaanga ch'isung ch'ede gol kw'adọhbhiji made bẹka mawanẹ, ọmaana agol p'mbọhk p'adọhbhiji pabẹ made ashẹkẹl ijobh. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Ọbọbh-ẹ bẹ́, “Anyi wọ ode atte kwọ? Ototo, tek-m, nna idongọ ininga z'atte k'ọsọhm s'mm'oyima m'erungọ?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Rẹbẹka ọpọhn-ẹ bẹ́, “Kaam nde nnwa kw'Bẹtuẹl, kw'Milka obhonọ ọnang Nahọr.” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Obira oben bẹ́, “Moyen ọchattọhk f'nten f'ọsaabh-ọsaabh za ọmaana ibyi s'bọnga mm'ayima m'erungọ.”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Minna kw'ojinọng nwo ọrak eso okpobha Ibinọkpaabyi, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />oben bẹ́, “Tte mọtọhnga Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'atte kwaam Abraham! Kẹ otim ochin ororo osi ọphyaam k'ogbe kpenamkpen ọnang atte kwaam, obira ọgbaka ifor ọmaan-ẹ. Ṉ́nòde kaam, Ọvaar Ibinọkpaabyi kk'aam otima m'ozenga nwa <char style="it">bẹ bẹẹm</char> maa, mpyirẹ k'ọsọhm kw'anọng p'atte kwaam.”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Ominanwa nwo otima ẹbhar od-otek anọng p'ọkka idik nja. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Ny'ogbe nwo, Rẹbẹka oyen ọgbaanọkka kw'ejinọng kw'okpen Laban. Laban ọsẹr-ọsẹr od-okebha ọtọhmnọng kw'Abraham z'ekeka. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />K'ose kw'ozize ẹbaanga ndo ch'isung, ọttara abaanga-chigimẹ ny'ọgbaanọkka k'mbọhkdọngọ, obira ọbhaanga idik s'Rẹbẹka otek-ẹ s'ọnọng nwo ọgbaak-ẹ, od-okebha ojinọng nwo ch'obe ọmaana akamẹl mbo za ch'ọnyọm ekeka. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />Oben-ẹ bẹ́, “Kwu, kọ kw'Ibinọkpaabyi ikk'ọda. Kọ ad-abe ma asi mbọng? K'ibyi nda nsok-ọ, ọmaana ibyi s'akamẹl pọ.”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Minna kw'ọtọhmnọng kw'Abraham ochin z'ọsọhm, ọchaarẹ akamẹl mbo ntọhka z'ifor. Pira matọka ọchattọhk achena bẹ, mabira atọka asi achena ọtọhmnọng kw'Abraham ọttara anọng p'matọnọ bẹ́, magbobhọ mmo sabẹ. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Nya o, maber-ẹ ọchattọhk. Kẹ oben bẹ́, “Mma e, kaam ọttọhk mìmkponga nchi maa, ntek bọnga ọttọhk f'm'atọhm-m.”</para>
  <para style="p" vid="GEN 24:33">Laban oben-ẹ bẹ́, “Tek mina kẹ.”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Nya o, otek bẹ bẹ́, “Kaam nde ọtọhmnọng kw'Abraham. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />Ọvaar Ibinọkpaabyi kk'atte kwaam ọda mawuriji maa, okwu ode ojibhadanọng. Ibinọkpaabyi kk'ẹ arọkimaan ọnanga, ọmaana abhaam, ọmaana asilva ọttara agol, ọmaana atọhmọ k'ejinọng ọttara k'ẹpanọng, ọmaana akamẹl ọttara nnyanya. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Sara kw'ode kwanọng kw'atte kwaam ọmaan-ẹ ojinọngnwa k'atam. Ofona nya, otte ọttọhk kpenamkpen f'oyen ọbọhk ọnang nnwa nwo. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Kẹ atte kwaam osi-m nchekẹ bẹ́, kaam kwanọng m'ntọka ny'aminava p'Kenaan kw'orukọ, nnang nnwa kwẹ k'ọba. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />Otek-m bẹ́, nchina z'efona ch'otte kwẹ, ntọka kwanọng za nnang nnwa kwẹ.<verse eid="GEN 24:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39" />“Nya kw'kaam n'mbọbhọ atte kwaam bẹ́, ‘Ó̱de kwanọng nwo oben bẹ́, kaam mòtor mokwuna kẹ?’<verse eid="GEN 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 24:40" />“Kẹ ọpọhn-m bẹ́, ‘Ọvaar Ibinọkpaabyi kw'ntorọ eden chẹ, m'ọtọhm ozeng-eden kwẹ ozenga ọmaan-ọ, ọfha ozenga kwọ ode ọkkọkka ọnang-ọ, abira atọka kwanọng kw'ofon z'efona chaam, ọttara z'anọng p'atte kwaam, anang nnwa kwaam. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Ó̱de achin z'efona chaam, echekẹ nda kọ mẹ̀bọka, zaabẹ́ m'ikọ kwanọng nwo kanangẹ.’<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />“Nya o, ch'iwura nkwu m'ekeka nda menda, nze njọm, mben bẹ́, ‘O Ọvaar Ibinọkpaabyi, kw'atte kwaam Abraham okpobh, óde ọdaak-ọ, ototo, nang-m owujibh m'ozenga nwa. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Kirẹ kaam mbe m'akeka-konga. Ó̱de mbenẹ ominanwa kw'im'okwu ọkaabha asi ma bẹ́, “Tte ngwo asi biribirẹ ny'isi-zọhka sọ,” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />óde oben-m bẹ́, “Gwo, kaam m'mbira nkaabha asi nnang akamẹl pọ,” tte kẹ nwo ode kwanọng kw'Ọvaar Ibinọkpaabyi ikk'oteka ọnang nnwa kw'atte kwaam.’<verse eid="GEN 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45" />“Pira nkwu nchera njọm ozize z'ettem chaam, Rẹbẹka oyin ka ọmaana isi-zọhka sẹ ny'ebubaang. Minna kw'ọsak z'ekeka ọkaabha asi. Kaam mben-ẹ bẹ ‘Ototo nang-m asi ngwo.’<verse eid="GEN 24:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46" />“Minna kw'ọsẹr-ọsẹr ọsaka isi-zọhka sẹ z'ebubaang, oben-m bẹ́, ‘Gwo, kaam m'mbira nkaabha asi nnang akamẹl pọ.’ Minna kw'ngwo asi mbo, obira ọkaabha ọnang akamẹl paam.<verse eid="GEN 24:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47" />“Mbọbh-ẹ bẹ́, ‘Kọ ade nnwa kw'anyi?’ Ọpọhn-m bẹ́, ‘Kaam nde nnwa kw'Bẹtuẹl kw'ode ojinọngnwa kw'Nahọr kw'Milka ọmaanẹ ọnang-ẹ.’</para>
  <para style="p" vid="GEN 24:47">“Minna kw'nkk'ẹ ẹbaanga ny'isung, mbira nkk'ẹ abaanga-chigimẹ ny'mbọhkdọngọ, <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />pira nraka eso mkpobha Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'atte kwaam Abraham. Ntọhng-ẹ mawuriji ch'otibh-m eden ch'ntim nkwu ntọka ominanwa kw'ọgbaanotte kw'atte kwaam nnang nnwa kwẹ. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Ofona nya o, óde mm'akọhka atte kwaam ọdaakẹ kwiden ọmaana ejibha, màtek-m. Ó̱de nna minna acher, màtek-m, ọfha nzonga ose kw'im'nsi.”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Laban ọmaana Bẹtuẹl mapọhn-ẹ bẹ́, “Odik nwoma ofon z'Ọvaar Ibinọkpaabyi, Mina m'odik koyen kw'mm'ọpọhna. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Kirẹ Rẹbẹka ma. Tọk-ẹ tima zọhng. Tte ode kwanọng kw'nnwa kw'atte, k'ose kw'Ọvaar Ibinọkpaabyi ikk'ophyika.”<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Ọtọhmnọng kw'Abraham ọbhaang odik kw'magbaakẹ nya o, ọraka eso k'ikpukpobha ọnang Ọvaar Ibinọkpaabyi. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Pira ọrọhbha ekpo py'ẹdọngọ py'matim gol ọmaana silva asi, ọttara ọbara, ọnang Rẹbẹka; obira ọtọka nnanga s'igaangẹ ẹphya mawuriji ọnang ọgbaanọkka ọttara ọkka kwẹ. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Pira kẹ ọttara ajinọng mbo p'matọnọ nnachi ọttọhk mabira agwo asi, mayima nya.</para>
  <para style="p" vid="GEN 24:54">Maphyabh ny'ekpebha o, oben bẹ bẹ́, “Màzọhng rik-m k'eden, ọfha mkpa nnam ntor atte kwaam.”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Okenaka, ọgbaanọkka kw'Rẹbẹka ọmaana ọkka mapọhn-ẹ bẹ́, “Tte Rẹbẹka ọbọhk oninga ọmaana mina k'iwu ijobh pira matọn afona.”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Ọtọhmnọng nwo ọpọhna bẹ bẹ́, “Ototo, m'kaam ma kàsok. Ọvaar Ibinọkpaabyi kk'aam owujibha ọnanga m'ozenga nwa. Màtte-m obọhk, màd-arik-m k'eden, ọfha mkpa nnam ntor atte kwaam.”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Maben ayok bẹ́, “Tte moyerẹ Rẹbẹka oyenẹ mọbọbh-ẹ.” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />Minna kw'mayerẹ Rẹbẹka mabọbh-ẹ bẹ́, “Ina achera ator ọnọng nwa mafona yirẹ?”</para>
  <para style="p" vid="GEN 24:58">Ọpọhn bẹ bẹ́, “Iye, kaam kk'nchera bẹ́, m'ntọr-ẹ mofona.”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Minna kw'mazeng ad-arik ọgbaanọkka kwabẹ Rẹbẹka k'eden, ọmaana kwanọng kw'od-okker-ẹ, ọmaana ọtọhmnọng kw'Abraham, ọttara anọng pẹ. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Minna kw'masi Rẹbẹka ittabọhng, maben-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 24:60">“Agbaanakka kwamina, moze njọm bẹ́,</para>
  <para style="q2" vid="GEN 24:60">asi ọmaan k'ọsaabh, k'nnọhna k'nnọhna;</para>
  <para style="q1" vid="GEN 24:60">tte iva p'iva pọ makwu atọka</para>
  <para style="q2" vid="GEN 24:60">ibhon s'awawunanọng pabẹ.”<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Rẹbẹka okwu obina ọttara aminava p'aruk-ẹ ábẹ̀, mavura k'akamẹl, mator ojinọng nwo mafona. Ọtọhmnọng kw'Abraham ọtọka Rẹbẹka otima ofona.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Ny'ogbe nwo, wa Isaak kk'obina z'Beer-Lahai-Roi, od-oruk z'ẹkọma ch'Nẹgẹv. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />K'ẹsọhka danẹ, ọraanga ochina za ch'etirakpo ed-echi azizaarẹ bẹ́, oninga za osi achibhẹ. K'ose kw'otin-ẹ ititika k'ẹrọng, oze akamẹl p'ad-akwu za. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Rẹbẹka obira otinẹ ititika k'ẹrọng oze Isaak za. Ọsaka z'kamẹl kwẹ, <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />ọbọbh ọtọhmnọng kw'Abraham bẹ́, “Bọng-ojinọng wọ kina wọ od-ozenga ọnyọma mina k'ifor o?”</para>
  <para style="p" vid="GEN 24:65">Ọtọhmnọng nwo ọpọhn-ẹ bẹ́, “Atte kwaam wọ e.” Minna kw'Rẹbẹka ọtọk ọphyọng obubha ifor sẹ maphyir.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Nya o, ọtọhmnọng nwo otek Isaak ọttọhk kpenamkpen f'ikk'ọsa. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Otima Rẹbẹka odim z'iruk-byi s'iwa ọkka kwẹ Sara orukọ, maba ayok. Rẹbẹka okwu ode kwanọng kwẹ, ọdaak-ẹ mawuriji, okwu oyena ottem-fukọ ch'iwa ọkka kw'kk'ẹ Isaak ikk'ọpa.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s1">Obo kw'Abraham</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Wa Abraham obir ọtọka kwanọng ọdọk-ọdọk kw'okpen Kẹtura. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Kẹtura ọmaan-ẹ Zimran, ọmaana Jọkshan, ọmaana Medan, ọmaana Midiyan, ọmaana Ishbak, ọttara Shua. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />Jọkshan wọ wa obhonọ Shẹba ọttara Dedan; ẹnọmma ch'Dedan ede ab'Ashur, ọmaana ab'Lẹtush ọttara ab'Leum. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />Ajinọngva p'Midiyan wa made Ẹpha, ọmaana Ẹphẹr, ọmaana Hanọk, ọmaana Abida, ọttara Ẹlda. Anọng mba maphyir bọ mafon k'ntaak s'Kẹtura.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Wa Abraham otte oyena kwẹ maphyir ọbọhk ọnang Isaak. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Okenaka, k'ogbe kw'uwa otim orukọ akpen, Abraham okebh nnanga ọnang iva p'ayokinọng pẹ, obir okwubh bẹ machina z'ẹbhaakẹ ch'ewuchen ed-eyin, mfha marik nnwa kwẹ Isaak obhokọ.<verse eid="GEN 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />K'akpen pẹ maphyir, wa Abraham orukọ icho arọbh ochenọnttaan okwuma ichi. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Nya o, Abraham okwu ope ch'ikk'ọtama, otor ab'ttatta pẹ z'izek. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Iva pẹ, p'ade Isaak ọmaana Ishimayẹl, manọhng-ẹ z'ọtakpamma kw'Makpẹla kw'ọnyọm Mamrẹ z'ẹbhaakẹ ch'ewuchen ed-eyin, z'izek s'Ẹpharọn kw'ode nnwa kw'Zoha kw'ofon Het. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />Wa Abraham odebhẹ izek njo k'mbọhk s'anọng p'Het. Wa manọhng Abraham ny'ibyi njo s'iwa manọhng kwanọng kwẹ Sara. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />K'ogbe kw'Abraham ikk'ọpa, Ibinọkpaabyi odo nnwa kwẹ, Isaak, kw'uwa norukọ ọnyọma esipe ch'Beer-Lahai-Roi.<verse eid="GEN 25:11" /></para>
  <para style="s1">Efonamma ch'Ishimayẹl</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Ma wọ ode efonamma ch'Ishimayẹl kw'uwa Abraham obhonọ k'ntaak s'Hagar kw'ofon Ijip, kw'uwa ode obira kw'Sara.<verse eid="GEN 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13" />Ma wọ ode ache p'iva p'Ishimayẹl k'ose kw'mazeng ammaana: ocheden ode Nẹbayọt. Ayok p'ator-ẹ ade Kẹda, ọmaana Adbẹl, ọmaana Mibsam, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />ọmaana Mishma, ọmaana Duma, ọmaana Masa, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />ọmaana Hadad, ọmaana Tẹma, ọmaana Jetur, ọmaana Naphish ọttara Kẹdẹma. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />Ma wọ ode ajinọngva p'Ishimayẹl p'mabaabh nkọma ijobh kkamfa, s'ikpen ache ibhina bẹ, atorọ k'obhingabyi fabẹ. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />K'akpen pẹ kibungọ, wa Ishimayẹl orukọ icho arọbh achadanẹ okwuma ichi kkamfa pira nope. Manọhng-ẹ, otor ab'ttatta pẹ z'izek. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Wa masi oruk kwabẹ tọma ny'ẹbhaakẹ ch'Havila pyirẹ z'Shur kw'oning okkerẹ Ijip z'ẹbhaakẹ ch'Asiriya. Wa marukọ k'iwawuna amaana ivotte pabẹ maphyir.<verse eid="GEN 25:18" /></para>
  <para style="s1">Ẹmmaana ch'Ẹsau ọmaana Jekọb</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Ma wọ ode efonamma ch'Isaak. Abraham wọ uwa obhonọ Isaak.<verse eid="GEN 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 25:20" />K'ogbe kw'uwa Isaak node icho arọbh afa, nya kw'ọtọk Rẹbẹka k'ọbada. Rẹbẹka nwo ode nnwa kw'Bẹtuẹl kw'ofon Padan-Aram, obira ode ọgbaanọkka kw'Laban kw'ofon Aram.<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />Isaak oze njọm k'eso ch'kwanọng kwẹ okurọ ch'ọkpaan-ọkpaana. Ọvaar Ibinọkpaabyi ọbhaanga njọm sẹ, osi Rẹbẹka otima ibhọr. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Iva afa p'aning-ẹ z'ẹbhọr marima ayok ábẹ̀, pira ọkka ọbọbh bẹ́, “Bọng-odik wọ od-oyin ọmaan-m ma yirẹ?” Minna kw'ofon ọd-ọbọbh Ọvaar Ibinọkpaabyi.<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />Ọvaar Ibinọkpaabyi ọpọhn-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 25:23">“Nkọma mfa jọ ining-ọ ny'ẹbhọr.</para>
  <para style="q2" vid="GEN 25:23">Nkọma njo mfa s'ining-ọ ny'ẹbhọr, m'ibhaangẹ ayok.</para>
  <para style="q1" vid="GEN 25:23">Ẹkọma danẹ m'eyena ẹfa ẹyọhnga ndoza,</para>
  <para style="q2" vid="GEN 25:23">ẹkọma ndo ch'echi eden ẹmmaana, m'ẹraka eso ẹnang ch'ikarẹ.”<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Okwu opyirẹ k'ogbe kw'im'ọmaan, ajinọngva afa bọ aning-ẹ z'ẹbhọr. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Oyok kw'ochi eden otto okor-okor, ifor sẹ ide mach'ibara s'isaabhẹ iphyabha. Ofona nya, makpẹ-ẹ bẹ́, Ẹsau. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Ogbe kobhirẹ, ọgbaanọkka obira otto, ọgbana Ẹsau ny'ebhokọhrọ. Nya o, makpẹ-ẹ, Jekọb. Wa Isaak node icho arọbh attaan k'atam k'ogbe kw'Rẹbẹka ọmaanẹ iva mbo.<verse eid="GEN 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />K'ose kw'ajinọngva mbo mabeng k'icho, Ẹsau okwu ode ọgbaaji, kw'orukọ ayaankpa-kpen; Jekọb ode ọnọng kw'odirẹ ẹmaana, kw'ọd-ọkọhng eninga k'ọsọhm. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Wa Isaak ode ọnọng kw'ẹgbaten ẹd-ẹdaak-ẹ ẹcha, ofona nya, Ẹsau kw'ode ọgbaaji ọdaak-ẹ idik. Okenaka, Jekọb ọdaak Rẹbẹka idik.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />K'ogbe wanẹ kw'uwa Jekọb ọd-ọwọhn ọchattọhk, Ẹsau okwuna eyina ọmaana okwo f'ikk'ẹ ọkaam mawuriji. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />Minna kw'obenẹ Jekọb bẹ́, “Mek-m ẹwa-kora ndo, kirẹ okwo ọkaam-m ọkpan!” (Kẹ wọ osi pira wa mabira ayerẹ Ẹsau bẹ́, Edom.<note caller="+" style="f"><char style="fr" closed="false">25.30 </char><char style="fq" closed="false">Edom </char><char style="ft" closed="false">oyinẹ bẹ́, ekora.</char></note>)<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Jekọb o, ọpọhn-ẹ bẹ́, “Kọ chi eden kpe ediden chọ anang-m.”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />Ẹsau ọpọhn-ẹ bẹ́, “Bọng-ọttọhk vọ ode ediden ch'okwo min'ọfhọ-m ma?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />Jekọb oben-ẹ bẹ́, “Chi eden chekẹ nang-m bẹ́, m'atte ediden chọ ọbọhk anang-m.” Minna kw'Ẹsau ochekẹ, ọtọka ediden chẹ okpe ọnang Jekọb.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />Ofona nya o, Jekọb ọtọka brẹd ọttara awa mbo ọnang-ẹ. Ochi, obira ogwo maa ọdọhbh, obina ofona. Minna kw'uwa Ẹsau ozeng olukọ ediden chẹ.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s1">Isaak ọmaana Abimẹlẹk</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Ny'ogbe nwo, wa okwo f'ọgaang-ọgaangẹ oning ny'ẹkọma ndo, agbaarẹ ndo ch'iwa etto z'ogbe kw'Abraham abharẹ. Minna kw'Isaak obin ochina z'Gẹra, od-okebha Abimẹlẹk kw'ode ọvaarnọng kw'aPhilistiya. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Ọvaar Ibinọkpaabyi oyin okebha Isaak, oben-ẹ bẹ́, “Z'Ijip kàta o! Ruk ny'izek s'mben-ọ bẹ́, aruk. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Ninga m'izek nja k'ogbe biribirẹ, kaam m'nninga mmaan-ọ, mbir ndọ-ọ. Kaam m'nnang kọ ọttara iva p'iva pọ ozek mva maphyir. M'mbir nsi k'ose kw'uwa ikk'ncheka nnang atte kwọ Abraham. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Kaam m'nsi iva p'iva pọ masaabh mach'ndidorọ s'ọrọngkpakpa. M'mbir nnang bẹ ozek mva maphyir. M'obir ofona ny'iva p'iva pọ nkọma s'iyagbin maphyir iyena ẹda, <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />okurọ bẹ́, Abraham okpobh-m, osi ọttọhk kpenamkpen f'mben-ẹ, osok asana ọttara apaanga paam maphyir.” <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />Ofona nya o, Isaak oninga ny'Gẹra, ọdọk ibyi kọta.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />K'ogbe kw'anọng p'obhon nwo mabọbh Isaak odik ọmaana kwanọng kwẹ, kẹ otek bẹ bẹ́, “Ọgbaanọkka kwaam wọ.” Obenẹ minna okurọ bẹ́, wa ojor-ẹ ojora bẹ́, oben bẹ́, kwanọng kwẹ wọ. Kẹ wa ochibhẹ z'ettem bẹ́, “Ajinọng p'obhon nwa m'afhọ-m ọfhọ okurọ bẹ́, Rẹbẹka ojibhẹ kwanọng mawuriji.”<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Ch'iwa Isaak ikk'oninga nya k'ogbe kw'ikk'obhira, Abimẹlẹk kw'ode ọvaarnọng kw'aPhilistiya ozenga z'ọmma kw'ofum oze Isaak ch'ọd-ọbaaka Rẹbẹka. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Nya o, Abimẹlẹk oyerẹ Isaak oben-ẹ bẹ́, “Kẹ ode kwanọng kwọ k'odik ọkkọkka! Osi yen pira aben bẹ́, ọgbaanọkka kwọ wọ?”</para>
  <para style="p" vid="GEN 26:9">Isaak ọpọhn-ẹ bẹ́, “Kaam osi-m bẹ́, mm'afhọ-m okurọ kẹ.”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Abimẹlẹk oben-ẹ bẹ́, “Bọng-ọttọhkkira f'asi ma? Wúra ọnọng wanẹ ikk'oyima ọmaana kwanọng kwọ, wura mina k'odik kwiden atima aka o?”<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Minna kw'Abimẹlẹk ọnang ọsana z'obhon bẹ́, “Ọnọng kpenamkpen kw'ọlẹkẹ ojinọng nwoma, obir ode kwanọng kwẹ, obo mọ̀naanga.”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Ny'icho nwo, Isaak otubh owonọ ny'izek njo, ọpha ekpo mawuriji okurọ ch'iwa Ọvaar Ibinọkpaabyi ikk'ẹ ọda. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Minna kw'uwa ozeng okwu ode ojibhadanọng. Ojibhada kwẹ ọttara mach'ọttar nya maa, okwu ode ojibhadanọng kwiden. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Oyena etirakpo ọmaana atọhmnọng p'aruk-ẹ ábẹ̀ k'ọsaabh. Ofona nya, aPhilistiya mbo matọm-ẹ ojijọhmọ. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Matima ididọhbh akpa nsi-pe njo maphyir s'atọhmnọng p'otte atumọ z'ogbe kw'Abraham oning akpen.<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />Minna kw'Abimẹlẹk oben Isaak bẹ́, “Bina rik obhon kwamina, okurọ bẹ́, kọ kk'mina ẹfa, ayọhnga.”<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Minna kw'Isaak obin nya ochina z'ilokodo s'Gẹra od-osi oruk kwẹ za. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Obir okwu otum nsi-pe njo s'iwa matumọ z'ogbe kw'otte Abraham orukọ akpen, k'ogbe kw'Abraham ikk'ọpa. Isaak obir ọnang nsi-pe njo ache mbo p'uwa otte ọnang jẹ.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />K'ose kw'atọhmnọng p'Isaak mad-atum izek ny'ilokodo, minna kw'mad-adwu k'esipe ch'asi asaabhẹ maa, mabhobh-obhobh. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Okenaka, wa akker-arọkimaan p'Gẹra masi ẹkọhr amaana akker-arọkimaan p'Isaak okurọ ch'matọk bẹ́, asi pabẹ bọ. Ofona ny'ẹkọhr ndo o, Isaak okpe esi-pe ndo bẹ́, Esek<note caller="+" style="f"><char style="fr" closed="false">26.20 </char><char style="fq" closed="false">Esek </char><char style="ft" closed="false">oyinẹ bẹ́, nkaanga.</char></note>, okurọ bẹ́, makaang-ẹ odik. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Anọng p'Isaak mabira atum esi-pe ẹbhachẹ, anọng mabira asi ẹkọhr nya. Ofona nya o, okpe chẹ bẹ́, Sitna<note caller="+" style="f"><char style="fr" closed="false">26.21 </char><char style="fq" closed="false">Sitna </char><char style="ft" closed="false">oyinẹ bẹ́, nkaanga.</char></note>. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Obina nya od-otum esi-pe ọdọk-ọdọk, ọnọng ẹkọhr nya kosi. Ofona nya, Isaak okpe esi-pe ndo bẹ́, Rehobot.<note caller="+" style="f"><char style="fr" closed="false">26.22 </char><char style="fq" closed="false">Rehobot </char><char style="ft" closed="false">oyinẹ bẹ́, obhokọ.</char></note> Oben bẹ́, “Ọvaar Ibinọkpaabyi kk'mina obhokọ ọnanga m'izek nja s'mm'oninga osi ojibhada.”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Isaak obin nya o, ochina z'Beershẹba. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Ny'erungọ ndo, Ọvaar Ibinọkpaabyi oyin okebh-ẹ nya, oben-ẹ bẹ́, “Kaam wọ nde Ibinọkpaabyi kw'atte kwọ Abraham. Oning-ọ ojor, kaam nning ma mmaan-ọ. Kaam m'ndọ-ọ, mbir nsi iva p'iva pọ masaabh mawuriji okurọ atte Abraham kw'uwa ode ọtọhmnọng kwaam.”<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />Minna kw'Isaak ottim ija-byi nya, okpobha eche ch'Ọvaar Ibinọkpaabyi. Ottima ikkira sẹ nya, atọhmnọng pẹ mabir atum esi-pe nya.<verse eid="GEN 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Ny'ogbe nwo, Abimẹlẹk otima Ahuzat kw'ọd-ọtọhn-ẹ idik, ọmaana Phikol kw'ode odidennọng kw'asoja, obina z'Gẹra okwu. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Isaak ọbọbh bẹ bẹ́, “Ode yen kw'nnazeng minna, ch'ogbe nwo bọnga mawun-m minna, mabir akwubh-m z'abọnga k'obhon o?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />Mapọhn-ẹ bẹ́, “Mina nkk'ọza k'odik ọkkọkka bẹ́, Ọvaar Ibinọkpaabyi oning ọmaan-ọ. Ofona nya, moben bẹ́, ọbaan bẹ́, kọ ttara mina mochekẹ ọnang ayok. Tte mosi nttọhna ọttara kọ bẹ́, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />kọ mina itama màsi, k'ose kw'mina nna kọ itama osi. Mm'okker-ọ k'eden ọkkọkka maa, morik-ọ k'ẹmẹm. Madidanma, Ọvaar Ibinọkpaabyi kk'ọ ọda.”<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Isaak okwu osok eninga ọnang bẹ, machi, mabir agwo. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />K'ekpikpebha ch'ewu esobh nya, bẹ ajinọng mbo machekẹ anang ayok. Pira Isaak nod-orik bẹ k'eden, mabhana k'ẹmẹm.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Ny'ewu ndo, atọhmnọng p'Isaak makwu atek-ẹ odik kw'ọmaan esi-pe ch'nkk'atuma. Maben-ẹ bẹ́, “Nkk'asi ọza!” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Oyerẹ esi-pe ndo eche bẹ́, Shiba<note caller="+" style="f"><char style="fr" closed="false">26.33 </char><char style="fq" closed="false">Shiba </char><char style="ft" closed="false">oyinẹ bẹ́, echekẹ, wanẹma, achenọmfa.</char></note>. Tọma za maa pyirẹ menda, obhon nwo okpen Beershẹba<note caller="+" style="f"><char style="fr" closed="false">26.33 </char><char style="fq" closed="false">Beershẹba </char><char style="ft" closed="false">k'eHiburu okpo-okpo oyin bẹ́, esi-pe ch'echekẹ, wanẹma, esi-pe ch'achenọmfa.</char></note>.<verse eid="GEN 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />K'ogbe kw'Ẹsau node icho arọbh afa, ọtọka kwanọng kw'okpen Judit, kw'ode ominanwa kw'Beeri kw'ofon Het. Obir ọtọka Basẹmat, ominanwa kw'Ẹlọn, kw'obir ofona Hit. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Bẹ panọng mbo afa wa mawọhkọ Isaak ọmaana Rẹbẹka masọhrọ asen machi masọhrọ nya.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s1">Jekọb ọtọk ittabọhng s'Ẹsau</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />K'ogbe kw'uwa Isaak ikk'ọtama, ọdọk iyaan mawuriji koze, oyerẹ ochedennwa kwẹ kw'ode Ẹsau, oben-ẹ bẹ́, “Nnwa kwaam.”</para>
  <para style="p" vid="GEN 27:1">Ẹsau ọpọhn-ẹ bẹ́, “Ttatta, kirẹ kaam ma.”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />Isaak oben-ẹ bẹ́, “Kaam kk'ntama, ewu ch'im'mpe kinzong. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Tọka ẹgbaajikpo pyọ, ọmaana oyuk kwọ ọttara akọhn pọ, yin ẹgbaaji afhọ nten achen-m. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Si ọchattọhk f'olebh-olebh f''ọdaak-m, chen-m, nchi, ọfha nsọ-ọ ittabọhng pira mpe.”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />Wa Rẹbẹka od-oyonga itọhng ọbhaanga idik s'Isaak ọd-ọgbaak Ẹsau. K'ose kw'Ẹsau obin oyin ẹgbaaji bẹ́, ọd-ọfhọ eten otima okwuna, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />minna kw'Rẹbẹka obin oben nnwa kwẹ Jekọb bẹ́, “Kirẹ ẹ, mmaang ch'atte od-oben Ẹsau bẹ́, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‘Bina yin ẹgbaaji, ad-afhọ nten atima akwu asi ọchattọhk f'olebh-olebh anang-m nchi, ọfha nsọ-ọ ittabọhng ny'Ọvaar Ibinọkpaabyi k'ititika pira mpe.’ <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Nya o, nnwa kwaam, yong-m itọhng mawuriji, asi ọttọhk f'mben-ọ bẹ́, asi. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Zọhng za ch'avu aning, teka avu p'ikarẹ minna afa chen-m, ọfha ntima nsi ọchattọhk-kira f'ọd-ọdaak atte. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Kọ m'atọka ọchattọhk mvo achen-ẹ, ọfha ochi, otima ọsọ-ọ ittabọhng, pira ope.”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Jekọb okwu oben ọkka bẹ́, “Agbaanakka kwaam Ẹsau, omenẹ iphyabha k'ifor mawuriji, kaam nsọhmọ ẹkpakpa. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Ó̱de atte kwaam otwu-m kẹ? M'ọsẹ-ẹ bẹ́, kaam mbọhr-ẹ ọbọhra. Kẹ m'oter ọnang-m ẹmma otwu kw'im'osi-m ittabọhng.”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Ọkka ọpọhn-ẹ bẹ́, “Nnwa kwaam, tte ẹmma ndo ẹbọka kaam e. Kọ tera si k'ose kw'mben-ọ. Zọhng tọka ekpo mbyo chen-m.”<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />Minna kw'Jekọb ofon, ọd-ọtọka avu afa ochena ọkka, otima osi ọchattọhk f'olebh-olebh k'ose kw'ọdaak otte. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Rẹbẹka ọtọka ẹnya ch'ochedennwa kwẹ Esau ch'ejibhẹ ọtam, ọfọra Jekọb kw'ode nnwa kwẹ kw'ikarẹ. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Obir otima evukpakpa obubh-ẹ mbọhk ọmaana ẹdọngọ okurọ ch'isisa ina ide. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Nya o, ọtọka ọchattọhk ọkkọkka mvo f'ikk'ọsa, ttara brẹd ọnang nnwa kwẹ Jekọb.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Jekọb obina okebha otte za, oben-ẹ bẹ́, “Atte kwaam.” Otte ọpọhn-ẹ bẹ́, “Kirẹ kaam ma, nnwa kwaam. Kọ anyi wọ o?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />Jekọb ọpọhn-ẹ bẹ́, “Kaam Ẹsau kw'nde ochedennwa kwọ wọ e. Kaam kk'nsa k'ose kw'aben-m bẹ́, nsi. Ototo, bina ninga ẹwọr achi ọttọhk, ọfha asi-m ittabọhng sọ.”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />Isaak ọbọbh-ẹ bẹ́, “Nnwa kwaam, asi yen aze eten ẹbhar-ẹbhar minna?”</para>
  <para style="p" vid="GEN 27:20">Jekọb ọpọhn-ẹ bẹ́, “Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwọ, kẹ wọ ọnang-m owujibha e.”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Nya o, Isaak oben Jekọb bẹ́, “Nnwa kwaam, nyọm-m ka ntwọ-ọ, ọfha nzonga ode ade nnwa kwaam Ẹsau majijik.”<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />Jekọb obina ọnyọma otte z'ifor, otte ọtwẹ-ẹ, pira oben bẹ́, “Ọgbaakadik kwọ okerẹ kw'Jekọb, okenaka, mbọhk sọ ide mbọhk s'Ẹsau.” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Wa kẹ kotinẹ okurọ bẹ́, wa mbọhk sẹ ide iphyabha-iphyabha mach'mbọhk s'ọgbaanọkka Ẹsau. Ofona nya, Isaak ọtọm-ẹ ittabọhng osisi. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />Otte obir ọbọbh-ẹ bẹ́, “K'odik ọkkọkka, kọ Ẹsau kw'ade nnwa kwaam wọ o?”</para>
  <para style="p" vid="GEN 27:24">Jekọb ọpọhn-ẹ bẹ́, “Iye e, kaam wọ e.”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Otte oben-ẹ bẹ́, “Nnwa kwaam, tọka ọchattọhk fọ nang-m nchi, ọfha nsọ-ọ ittabọhng.”</para>
  <para style="p" vid="GEN 27:25">Jekọb ọtọka ọchattọhk mvo ọnang-ẹ ochi, obir ọnang-ẹ atuk ogwo.<verse eid="GEN 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 27:26" />Nya o, otte Isaak oben-ẹ bẹ́, “Nnwa kwaam, kwu baak-m.”<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />Jekọb obina, ọd-ọbaak-ẹ. Ch'Isaak ọbhaang eruk ch'ekpo py'ọfọr nya o, ọsẹ-ẹ ittabọhng, oben-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 27:27">“K'odik ọkkọkka, eruk ch'nnwa kwaam</para>
  <para style="q2" vid="GEN 27:27">ede mach'eruk ch'owonọ</para>
  <para style="q2" vid="GEN 27:27">kw'Ọvaar Ibinọkpaabyi ikk'ọda.<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />Tte Ibinọkpaabyi osi iffọhng s'ẹrọng itebh-ọ, ọnang-ọ ọchattọhk k'ọsaabh,</para>
  <para style="q2" vid="GEN 27:28">abir ayena ọchattọhk</para>
  <para style="q2" vid="GEN 27:28">ọttara atuk k'ọsaabh.<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />Tte nkọma s'iyagbin maphyir ikpobh-ọ,</para>
  <para style="q2" vid="GEN 27:29">anọng maphyir araka nso anang-ọ.</para>
  <para style="q1" vid="GEN 27:29">Kọ m'ade oso kw'ivọkka pọ,</para>
  <para style="q2" vid="GEN 27:29">tte echimma chọ ẹraka eso ẹnang-ọ.</para>
  <para style="q1" vid="GEN 27:29">Tte ẹmma ẹbhakẹ ẹbọka anọng p'anang-ọ ẹmma.</para>
  <para style="q2" vid="GEN 27:29">Tte anọng p'adọ-ọ mabir ayena ẹda.”<verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />K'ose kw'Isaak osi Jekọb ittabọhng nya maphyir, ogbe kobhirẹ kw'Jekọb obin, ọgbaanọkka Ẹsau, okwuna ẹgbaaji. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Kẹ obir osi ọchattọhk f'olebh-olebh ochena otte, oben otte bẹ́, “Atte kwaam, ototo, bina chi ọchattọhk faam, ọfha asi-m ittabọhng sọ.”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Otte Isaak ọbọbh-ẹ bẹ́, “Kọ anyi wọ o?”</para>
  <para style="p" vid="GEN 27:32">Ẹsau ọpọhn-ẹ bẹ́, “Kaam ochedennwa kwọ Ẹsau wọ e.”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Minna kw'Isaak ọfọnọ <char style="it">ma tiki-tiki</char> k'ẹfa-k'ẹfa, oben bẹ́, “Bọng-ọnọng wọ oyinẹ ẹgbaaji otima osi ọchattọhk ochen-m o? Yina kw'nd-nchi ọchattọhk mvo ma, pira apyirẹ ma. Kaam kk'ẹ nda, m'oyena ẹda k'odik ọkkọkka!”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />K'ose kw'Ẹsau ọbhaang idik s'otte ọgbaakẹ nya, minna kw'obokọ edimmọng k'ẹrọng, oben otte bẹ́, “Atte kwaam, si-m ittabọhng, bira si kaam ittabọhng ọdọk!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />Okenaka, otte ọpọhn-ẹ bẹ́, “Agbaanakka okwu ọbọhr-m, ọtọka ittabọhng sọ.”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Ẹsau okwu oben bẹ́, “Kẹ zang okpen Jekọb o<note caller="+" style="f"><char style="fr" closed="false">27.36 </char><char style="fq" closed="false">Jekọb </char><char style="ft" closed="false">k'eHiburu ekkerẹ ọttọhk mach'ọbọhr-ọnọng.</char></note>? Kẹ kk'aam ọbọhra igbedim ifa. K'ochedengbe, osi-m ichen, ọna-m ediden chaam ch'ochedennwa. Ma, kk'aam ittabọhng saam obir ọna!” Ẹsau nokwu ọbọbh otte bẹ́, “Kaam ittabọhng kpenamkpen karikẹ o?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />Isaak ọpọhn-ẹ bẹ́, “Kaam kk'ẹ nsa bẹ́, ọbaabh-ọ, mbir nsi anọng pẹ maphyir bẹ́, maninga izek-izek kwẹ, mbir nnang-ẹ ẹda ch'ọchattọhk ọttara atuk k'ọsaabh. Mbọng vọ orikẹ f'iwura nsi nnang-ọ, nnwa kwaam?”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Ẹsau ọpọhna otte bẹ́, “Atte kwaam, kọ ayen ittabọhng majanẹ jẹ-jẹ o? Atte kwaam, m'abir ado kaam e!” Minna kw'Ẹsau obhom ẹmọng k'ẹrọng.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Otte ọpọhn-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 27:39">“Oruk kwọ z'izek</para>
  <para style="q2" vid="GEN 27:39">s'id-ijibh ekpo mọ̀nyọma,</para>
  <para style="q2" vid="GEN 27:39">iffọhng s'ẹrọng màbir aruk anyọma.<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />Kọ m'aruk k'egbong k'egbong,</para>
  <para style="q2" vid="GEN 27:40">abir ade ọtọhmnọng kw'agbaanakka.</para>
  <para style="q1" vid="GEN 27:40">Okenaka, óde asi ọmmakkaarẹ amaan-ẹ,</para>
  <para style="q2" vid="GEN 27:40">m'arọbha ẹdọhrọ ndo chẹ ny'ikọ k'ifor.”<verse eid="GEN 27:40" /></para>
  <para style="s1">Jekọb ọrọbhọ okebha Laban</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />Ẹsau osok Jekọb iwawuna z'ettem okurọ ittabọhng njo s'otte ọsẹ-ẹ. Oben ifor sẹ bẹ́, “Iwu s'obo kw'atte kwaam iningka inyọm. Kaam m'mfhọ agbaanakka kwaam Jekọb.”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />K'ogbe kw'magbaak Rẹbẹka odik kw'ochedennwa kwẹ ọgbaakẹ, oyerẹ Jekọb kw'ode nnwa kwẹ kw'ikarẹ, oben-ẹ bẹ́, “Agbaanakka Ẹsau ọkamẹ za bẹ́, m'ọfhọ otima ofokọ ifor sẹ ettem e. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Ofona nya, nnwa kwaam, ogbe maphyir-phyir kakibhẹ. Rọbh china z'Haran, za ch'Laban kw'ode agbaanakka kwaam oning. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Ninga maan-ẹ maa, ettem ẹsaka agbaanakka. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Ó̱de idididọkọ sẹ ikk'isa, obir ọzaama odik kw'asẹ-ẹ, nya kw'im'ntọhm bẹ́, akwuna. Kinnorọ bẹ́, ngwana bọnga anọng afa k'ewu madanẹ.”<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Nya o, Rẹbẹka oben Isaak bẹ́, “Akpen kk'aam abenga okurọ panọng mba p'Het. Ó̱de Jekọb obir ọtọka kwanọng m'panọng mba p'afon Het, zonga bẹ́, kaam ọdọk akpen minruk.”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Nya o, Isaak oyerẹ Jekọb, obir ọsẹ-ẹ ittabọhng, oben-ẹ bẹ́, “Kwanọng kw'ofon m'ẹkọma ch'Kenaan kàtọka k'ọbada o. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Tera zọhng z'Padan-Aram, z'ọsọhm kw'Bẹtuẹl kw'ode atte kw'akka. Ny'panọngva p'Laban kw'ode ọgbaanọkka kw'akka, nya kw'm'atọka oyok wanẹ k'ọbada. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Tte Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir ọdọ-ọ, obir ọnang-ọ iva k'ọsaabh maa, asi nkọma s'isaabh-ọsaabh. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Tte Ibinọkpaabyi ọnang kọ ọttara iva p'iva pọ ẹdase ch'iwa ọnang Abraham, ọfha atọka izek nja s'aning ma mach'okikennọng ayena. Izek njo jọ ide izek s'Ibinọkpaabyi ọnang Abraham.” <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />Minna kw'Isaak ọtọhmọ Jekọb z'Padan-Aram bẹ́, od-okebha Laban kw'ode nnwa kw'Bẹtuẹl kw'ofon Aram, kw'ode ọgbaanọkka kw'Rẹbẹka kw'ode ọkka kw'Jekọb ọmaana Ẹsau.<verse eid="GEN 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Ẹsau okwu ozonga bẹ́, Isaak kk'Jekọb ittabọhng ọsa, obir ọtọhm-ẹ z'Padan-Aram bẹ́, ọd-ọtọka kwanọng kw'im'ọba za, obir ọtọr-ẹ itọhng bẹ́, oning kwanọng kw'ofon ny'Kenaan ọtọk, <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />obir oze bẹ́, Jekọb kk'nttọhna s'otte ọttara s'ọkka ọtọka, ochina z'Padan-Aram. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Kẹ Ẹsau okwu ozonga bẹ́, aminava p'Kenaan m'otte idik kadaakẹ. <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />Nya o, obina okebha Ishimayẹl kw'ode nnwa kw'Abraham za, ọtọka ominanwa wanẹ kwẹ kw'okpen Mahalat, kw'ode ọgbaanotte kw'Nẹbayọt k'ọbada, ọttara z'panọng mboza p'okkikken oyena.<verse eid="GEN 28:9" /></para>
  <para style="s">Jekọb ọttaar idachen z'Bẹtẹl</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Jekọb obina z'Beershẹba, ozenga ochina z'Haran. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Okwu opyirẹ k'ibyi janẹ o, oyima nya okurọ ch'ewu kk'ẹpya. Odunga ọta kw'ọnyọm-ẹ nya ọnana eso ọttaabha. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Ọttaabh ọda nya o, ọttaara ch'oze abhuka p'abin m'izek apyirẹ z'obhon kw'Ibinọkpaabyi. Oze azeng-eden p'Ibinọkpaabyi ch'nd-azenga nya avura, mabir azenga asaka. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Ọvaar Ibinọkpaabyi oninga z'abhuka mbo ẹrọng, ọgbaak odik oben bẹ́, “Kaam wọ nde Ọvaar Ibinọkpaabyi kw'ab'atte Abraham ọttara Isaak makpobh. Kaam m'nnang kọ ọttara iva p'iva pọ izek njo s'ayim nya. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Iva p'iva pọ m'asaabh mach'oyiyeng kw'izek, mm'abir anyaamẹ, tọma za ch'ewuchen ed-eyin, pyirẹ za ch'ewuchen ed-edimẹ, maa, pyirẹ z'ebir-ebir, ọmaana z'ẹwọn-ẹwọna. Kaam m'nzenga ny'ikọ ọttara iva p'iva pọ, ndo nkọma s'iyagbin maphyir. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Kaam m'nninga mmaan-ọ, m'mbir nkker-ọ k'ibyi kpenamkpen s'ata. M'mbir ntim-ọ <char style="it">bẹ́ bẹẹm</char>, mkpa nnam m'izek nja. Kaam kọ ọbọhk mìntte, oye bẹ́, kaam kk'nsa k'ose kw'nchekẹ nnang-ọ.”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Jekọb ọphyabh nya o, oben bẹ́, “K'odik ọkkọkka, Ibinọkpaabyi oning m'ibyi nja kaam kinzong!” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Ojor-ẹ, oben bẹ́, “Tcha! Bọng-ibyi jọ ijor minna! Ibyi nja m'ide ọsọhm kw'Ibinọkpaabyi; ebhumma ch'obhon kw'Ibinọkpaabyi dọ ma e.”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />Ewu esobh nya o, Jekọb obina ny'ekpikpebha, otinẹ ọta nwo kw'oyim ọnana eso, omin obe-obe, pira nobyeng-ẹ ana p'matim oliv asi. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Jekọb okpe ibyi njo bẹ́, Bẹtẹl. Ibyi njo wa ichi eden ikpena Luz.<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />Nya o, Jekọb ọtọka nwọhngọ k'ititika s'Ibinọkpaabyi, oben bẹ́, “Ó̱de kọ Ibinọkpaabyi aning amaan-m, akker-m m'ozenga nwa, anang-m ọchattọhk ọmaana ekpo py'ẹfọra, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />abir atim-m <char style="it">bẹ́ bẹẹm</char> mkpa nnam z'atte kwaam k'osọhm, k'odik ọkkọkka, kọ Ọvaar Ibinọkpaabyi m'ade Ibinọkpaabyi kw'kaam m'mkpobha. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />Ọta nwa kw'ikk'mmina wọ im'ode ọsọhm kw'Ibinọkpaabyi. Kaam m'nkebh ọttọhk kpenamkpen f'ikọ Ibinọkpaabyi anang-m k'ibyi ijobh, ntọka okebh mavanẹ nnang-ọ.”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">Jekọb opyirẹ z'Padan-Aram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Nya o, Jekọb ochina ororo ny'ozenga nwo maa, opyirẹ ny'izek s'anọng p'ẹbhaakẹ ch'ewuchen ed-eyin. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Okwu oze esipe ch'edong-odong ny'ẹgba, ọmaana etirakpo nkaana nttaan s'iyim inyọma nya, okurọ ch'ode nya kw'uwa ed-egwo asi. Wa ẹtakpa ẹbar-ọbar ch'ebubh esipe ndo ny'ẹmma.<verse eid="GEN 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 29:3" />K'ogbe kw'etirakpo mbyo ikk'ẹkwa ettonga nya, akker-arọkimaan mbo, mad-abingẹ ẹtakpa ndo ny'ẹmma ch'esipe ndo, makaabha asi anang etirakpo mbyo, pira mabir abingẹ chẹ, mabubha esipe ndo.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />Jekọb ọbọbh akker-arọkimaan mbo bẹ́, “Abayi, bọnga mafon men o?”</para>
  <para style="p" vid="GEN 29:4">Bẹ mapọhn-ẹ bẹ́, “Mina mofon Haran.”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />Obir ọbọbh bẹ bẹ́, “Mazong ojinọng kw'okpen Laban, kw'Nahọr obhonọ ma o?”</para>
  <para style="p" vid="GEN 29:5">Mabir apọhn-ẹ bẹ́, “Iye e, mozong-ẹ ma.”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Nya kw'Jekọb nọbọbh bẹ bẹ́, “Ma, ọsẹ-ẹ yen za?”</para>
  <para style="p" vid="GEN 29:6">Mapọhn-ẹ bẹ́, “Oning za k'ọkkọkka. Kirẹ Rachẹl kw'ode ominanwa kwẹ wọ od-otera okwu kina ọmaana arọkimaan e.”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />Jekọb oben bẹ bẹ́, “Kirẹ e, echekira etim ẹgaang-ọgaangẹ. M'arọkimaan mbo k'ibyi majanẹ kakponga atobha. Màtera nang bẹ asi, màtima bẹ akpa nnam za ch'mm'achi azizaarẹ.”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Mapọhn-ẹ bẹ́, “Mina mminna mokpo osi, oye bẹ́, arọkimaan mboza maphyir kk'nnam akpa, mabir abingẹ ẹtakpa ndo ny'ẹmma ch'esipe, pira mọkaabha asi ọnang arọkimaan mbo.”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Ch'Jekọb otim ọgbaak odik ọgbaak ọnang bẹ, Rachẹl otima arọkimaan p'otte opyirẹ nya. Wa Rachẹl ode okker-arọkimaan. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Jekọb oze Rachẹl kw'ode ominanwa kw'Laban kw'ode ọgbaanọkka kw'ọkka ch'od-ozenga ọmaana arọkimaan p'Laban. Ọzẹ-ẹ nya o, ofona od-obingẹ ẹtakpa ndo ny'ẹmma ch'esipe ndo, ọkaabha asi ọnang arọkimaan p'ọgbaanọkka kw'ọkka. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Nya o, Jekọb ọbaaka Rachẹl, obhom ẹmọng k'ẹrọng. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Jekọb otek Rachẹl bẹ́, kẹ Jekọb ọttara Laban kw'ode otte kw'ikẹ Rachẹl, makaang ochi, kẹ Jekọb obir ode ojinọngnwa kw'Rẹbẹka. Ofona nya, Rachẹl otima ẹbhar, od-otek otte.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Laban ọbhaang nya bẹ́, Jekọb kw'ode nnwa kw'ọgbaanọkka kw'kwanọng kk'opyira, otima ẹbhar okebh-ẹ z'eden, ọbaak-ẹ, pira notim-ẹ ochina z'ọsọhm. Jekọb ọgbaak Laban idik njo maphyir s'iyinẹ. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />Laban o, oben-ẹ bẹ́, “Kaam ọttara kọ mode echimma madanẹ k'odik ọkkọkka!”</para>
  <para style="s" vid="GEN 29:14">Jekọb ọtọka Lea ọmaana Rachẹl k'ọbada</para>
  <para style="p" vid="GEN 29:14">Ch'Jekọb ikk'oninga ọmaana Laban k'ophe kibungọ, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />Laban oben-ẹ bẹ́, “Zaabẹ́ kọ ọmaana kaam mode echimma madanẹ, nya zang im'osi kọ asi-m ọtọhm k'ajaaka. Tek-m ọttọhk f'imin'atọka k'ọtọhm fọ.”<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />Laban obhonọ panọngva afa: ocheden okpen Lea, oyok kw'otor-ẹ okpena Rachẹl. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Ny'bẹ anọng mbo afa, Lea oyen adaakẹ-chen, Rachẹl oyena idaakẹ-for, obir ojibh kwanọng. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Wa Rachẹl okwu ọdaak Jekọb. Ofona nya, oben otte kw'Rachẹl bẹ́, “Atte, óde im'achera bẹ́, atọka Rachẹl kw'ode ominanwa kwọ kw'ikarẹ anang-m k'ọbada, kaam m'nsọ-ọ ọtọhm k'icho ichenọmfa.”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />Laban oben-ẹ bẹ́, “Oter ojibh ọtam bẹ́, ntọk-ẹ nnang-ọ ọyọhnga bẹ́, ntọk-ẹ nnang ọnọng ọdọk-ọdọk. Ninga ma maan-m.” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />Nya o, Jekọb osi oyonga-tọhm k'icho ichenọmfa ọfha ọtọka Rachẹl. Okenaka, ocho mvo kẹ ọttọhk kokerẹ okurọ ọdaakẹ kw'oyen ọmaana Rachẹl.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Opyirẹ ny'ogbe nwo kw'Jekọb m'ọtọka Rachẹl k'ọbada, Jekọb oben Laban bẹ́, “Kaam kk'oyonga-tọhm faam nchera, nang-m kwanọng kwaam ọfha nyim-ẹ ábẹ̀.”<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />Nya o, Laban osok eninga, ọphyẹ anọng maphyir p'ibyi njo. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Ewu epyi nya, Laban ọd-ọtọka Lea ochena Jekọb, oyim-ẹ ábẹ̀. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Laban obir ọtọka ọtọhmnọng kwẹ Zilpa, ọnang Lea mach'itọhmọ sẹ.<verse eid="GEN 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25" />Ewu esobh nya o, Jekọb oze bẹ́, Lea wọ kw'otim oyima nya. Ofona nya, od-oben Laban bẹ́, “Bọng-ọttọhk f'asi-m minna? Rachẹl azang kw'nzeng ábẹ̀ nsọ-ọ ọtọhm o? Osi yen kw'abọhr-m o?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />Laban ọpọhn-ẹ bẹ́, “Ẹmmaana chamina azang bẹ́, mọtọka ominanwa kw'ikarẹ ọnang k'ọbada, ch'ocheden ina odim otima ọba e. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Ninga tik, mochera eninga nda ch'ọbada m'ẹphyawu nda, ntọka Rachẹl nnang-ọ, óde m'achera bẹ́, abir asi-m ọtọhm k'icho ichenọmfa.”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />Jekọb ochera ọmaan-ẹ. Ẹphyawu ndo ch'odidaama ẹsa nya, Laban ọtọka ominanwa kwẹ Rachẹl ọnang Jekọb k'ọbada. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Laban obir ọtọka ọtọhmnọng kwẹ Bilha, ọnang Rachẹl mach'itọhmọ sẹ. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Jekọb obir oyima ọmaana Rachẹl. Rachẹl ọdaak-ẹ ọyọhnga Lea. Jekọb obir okwu osi Laban oyonga-tọhm k'icho ichenọmfa.<verse eid="GEN 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Ch'Ibinọkpaabyi nokwu oze bẹ́, Rachẹl ọdaakẹ Jekọb ọtam ọyọhnga Lea, osi Lea ọmaan iva, osi Rachẹl ọkpaana. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Lea okwu otima ibhọr, ọmaan ojinọngnwa. Ọkpẹ-ẹ Reubẹn, okurọ ch'obenẹ bẹ́, “Ọvaar Ibinọkpaabyi kk'irem saam ọza. M'ofona m'nnwa nwoma ndaak odim kwaam.”<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />Lea obir otima ibhọr, ọmaan ojinọngnwa. Oben bẹ́, “Ọvaar Ibinọkpaabyi ọnang-m nnwa nwoma okurọ ch'ọbhaang bẹ́, Jekọb kindaakẹ.” Ofona nya, ọkpẹ-ẹ Simeọn.<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Lea obir otima ibhọr ọmaan ojinọngnwa. Oben bẹ́, “Mọkpanda, odim kwaam min'ọnyọm-m k'ifọr okurọ ch'ikk'ẹ ajinọngva attaan mmaana.” Ofona nya, ọkpẹ-ẹ Lẹvi.<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Lea obir otima ibhọr ọmaan ojinọngnwa. Ofona nya, oben bẹ́, “Mọkpanda, m'mkpobha Ọvaar Ibinọkpaabyi.” Lea okpe nnwa nwo Juda. Minna kw'ozeng ọkpọka ọmaan.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />K'ogbe kw'Rachẹl oze bẹ́, iva kọmaanẹ ọnang Jekọb, ọjọhmọ ọgbaanọkka kwẹ. Ofona nya, oben Jekọb bẹ́, “Nang-m iva, ini minna ode, m'mpe-ope!”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />Jekọb ọdọk-ẹ ọmaana Rachẹl, oben-ẹ bẹ́, “Kaam wọ nde Ibinọkpaabyi kw'ọsọ-ọ iva kamaanẹ o?”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Rachẹl oben-ẹ bẹ́, “Kirẹ Bilha kw'ode ọtọhmnọng kwaam ma. Yima maan-ẹ, ọfha ọmaan iva ọnang-m, mbir nzenga ny'ikẹ, nyena echimma.”<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Minna kw'Rachẹl ọtọk Bilha ọnang Jekọb mach'kwanọng kwẹ. Jekọb oyim-ẹ ábẹ̀. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />Bilha otima ibhọr, ọmaan Jekọb ojinọngnwa. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />Rachẹl oben bẹ́, “Ibinọkpaabyi kk'aam asen ọfọhna, ọbhaanga njọm saam, ọnang-m ojinọngnwa.” Rachẹl okpe nnwa nwo Dan.<verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />Bilha kw'ode ọtọhmnọng kw'Rachẹl obir otima ibhọr, ọmaan Jekọb ojinọngnwa kw'ottong afa. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Rachẹl oben bẹ́, “Kaam kk'nrima mmaana agbaanakka kwaam mawuriji maa, nkema.” Ofona nya, ọkpẹ-ẹ Naphtali<note caller="+" style="f"><char style="fr" closed="false">30.8 </char><char style="fq" closed="false">Naphtali </char><char style="ft" closed="false">k'eHiburu oyinẹ bẹ́, erima chaam.</char></note>.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />K'ogbe kw'Lea okwu oze bẹ́, kk'ọmaan ọkpọka, ọtọka Zilpa kw'ode ọtọhmnọng kwẹ ọnang Jekọb mach'kwanọng kwẹ. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Zilpa ọmaan Jekọb ojinọngnwa. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Lea oben bẹ́, “Kaam kk'owujibha nyena.” Ofona nya, okpe nnwa nwo bẹ́, Gad<note caller="+" style="f"><char style="fr" closed="false">30.11 </char><char style="fq" closed="false">Gad </char><char style="ft" closed="false">k'eHiburu oyinẹ bẹ́, owujibha.</char></note>.<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Zilpa kw'ode ọtọhmnọng kw'Lea ọmaan Jekọb ojinọngnwa kw'ottong afa. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />Lea oben bẹ́, “Ettem kk'aam ẹdaama. Panọng mayer-m ottemdaam.” Ofona nya, ọkpẹ-ẹ Asha<note caller="+" style="f"><char style="fr" closed="false">30.13 </char><char style="fq" closed="false">Asha </char><char style="ft" closed="false">k'eHiburu oyinẹ bẹ́, ottemdaam.</char></note>.<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Otum k'ọphagbe kw'wit, Reubẹn oyin z'owonọ, od-oze amandrek<note caller="+" style="f"><char style="fr" closed="false">30.14 </char><char style="fq" closed="false">mandrek </char><char style="ft" closed="false">mandrek ode echikira ch'panọng ad-achi mfha matima ibhọr. Akkaara abir ayer-ẹ ochiduk kw'ọdaakẹ.</char></note> banẹ, ọtọka ọnang Lea kw'ode ọkka kwẹ. Rachẹl oben Lea bẹ́, “Ototo, mek-m amandrek banẹ p'nnwa kwọ otim okwuna.”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Lea ọpọhn-ẹ bẹ́, “Kọ kk'odim kwaam atọka! Min'abir atọka amandrek p'nnwa kwaam o?”</para>
  <para style="p" vid="GEN 30:15">Rachẹl oben-ẹ bẹ́, “Odik kode. Kẹ m'oyima ọmaan-ọ m'erungọ nda.”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />K'ogbe kw'Jekọb okwun eyina ny'ẹsọhka, Lea obina okebh-ẹ za, oben-ẹ bẹ́, “Menda m'ayima amaan-m okurọ bẹ́, kk'amandrek p'ojinọngnwa kwaam ntima ndebh-ọ.” Ofona nya o, Jekọb oyim-ẹ ábẹ̀ ny'erungọ ndo.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />Ibinọkpaabyi ọbhaanga njọm s'Lea, Lea otima ibhọr, ọmaan Jekọb ojinọngnwa kw'ottong achen. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Lea oben bẹ́, “Ibinọkpaabyi kk'aam ọtaama, okurọ ch'ntọk ọtọhmnọng kwaam nnang odim kwaam bẹ́, oyima ọmaan-ẹ.” Nya o, okpe nnwa nwo Isaka.<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Lea obir otima ibhọr, ọmaan Jekọb ojinọngnwa kw'ottong achadanẹ. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Oben bẹ́, “Ibinọkpaabyi kk'aam ẹnanga ch'ejibh-ojibh ọnanga. Mọkpanda, odim kwaam min'oke-m otum, okurọ bẹ́, kk'ẹ ajinọngva achadanẹ mmaana.” Nya o, ọkpẹ-ẹ Zẹbulun.<verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />K'ogbe wanẹ z'ititika, Lea obir ọmaan kwanọngnwa, ọkpẹ-ẹ Daina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Nya o, Ibinọkpaabyi okwu ojima Rachẹl, ọbhaanga njọm sẹ, ogwunga ẹbhọr chẹ. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Obir otima ibhọr, ọmaan ojinọngnwa. Oben bẹ́, “Ibinọkpaabyi kk'aam ọrọhbha k'mgbar.” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Ọkpẹ-ẹ Josẹph. Obir oben bẹ́, “Tte Ọvaar Ibinọkpaabyi ọttar-m ojinọngnwa.”<verse eid="GEN 30:24" /></para>
  <para style="s">Etirakpo py'Jekọb edo ẹsaabh</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />K'ogbe kw'Rachẹl ikk'Josẹph ọmaana, Jekọb oben Laban bẹ́, “Tte-m ọbọhk mkpa nnam z'ọmmaana-bhon kwaam. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Nang-m panọng paam ọttara iva paam p'nzeng ábẹ̀, nsi ọtọhm nnang-ọ. Kọ azong ọtọhm f'ikk'nsa nnang-ọ ma.”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Laban oben-ẹ bẹ́, “Ó̱de kk'aam kk'ọ idik ndaaka, ototo, ninga ma pira. Kaam kk'ọsẹ mmara kw'ntim nzonga bẹ́, Ọvaar Ibinọkpaabyi kk'aam ọda okurọ kọ.” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Laban obir oben-ẹ bẹ́, “Gbaak-m ẹphya ch'ọtọhm f'asi anang-m, kaam m'nnang-ọ ọnang.”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Jekọb ọpọhn-ẹ bẹ́, “Kọ azong ọtọhm f'ikk'nsa nnang-ọ ma, abir azonga ose kw'etirakpo pyọ ikk'ejibha k'kaam k'ọbọhk. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Pira kaam nkwu ma, wa ayen etirakpo py'ina ẹsaabhẹ. Ma, etirakpo mbyo kk'ẹsaabha mawuriji. Ibinọkpaabyi kk'ọ ọda k'ibyi kpenamkpen s'nchin. Okenaka, bọng-ogbe kw'ikaam im'ntima nsi ọttọhk f'im'ntima mbaabha ẹsọhmmọr chaam o?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />Laban ọbọbh-ẹ bẹ́, “M'nnang-ọ mbọng?” Jekọb ọpọhn-ẹ bẹ́, “Kaam ọttọhk kpenamkpen kànang. Ó̱de im'asi ọttọhk mva mavanẹ anang-m, kaam m'nchina ororo nkkerẹ etirakpo pyọ. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Tte mbaana ẹrọkimaan-kaana nda chọ maphyir menda, ọfha nteka arọkimaan p'asi ase, wanẹma, p'attim akkẹkkẹk, ọmaana arọkimaanva p'apyi bẹ́, <char style="it">kaang</char>, ọttara avugboka p'asi ase, wanẹma, p'attim akkẹkkẹk. Bẹ bọ mm'ade ẹtọhm-phya chaam. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Ọkkọkka kwaam m'osi ẹyaakẹ z'ogbe z'ororo, k'ogbe kw'im'akwu abaana etirakpo py'anang-m. Evu kpenamkpen ch'ening ẹmaan-m ch'ina ase esi, wanẹma, ọbhaamnwa kw'ina <char style="it">bẹ́ kaang</char> opyi, tọka bẹ́, mfu-ofu.”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />Laban ochera, oben bẹ́, “Tte ode k'ose kw'ikk'abena.”<verse eid="GEN 30:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 30:35" />Ny'ewu ndo madanẹ-danẹ, Laban ọrọhbha avudim, ọmaana avupa p'asi ase, ọmaana p'attim akkẹkkẹk, ọmaana p'ade awurọ maphyir, ọttara arọkimaanva p'apyi-opyi, ọtọka ọnang ajinọngva pẹ bẹ́, makkerẹ. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Otima bẹ osi ozenga k'iwu ittaan. Jekọb okkerẹ mboza p'Laban. <verse eid="GEN 30:36" /><verse number="37" style="v" sid="GEN 30:37" />Jekọb ọtọka achibọhnga kikebhẹ p'nchi s'mayerẹ pọpla, ọmaana almọn, ọttara p'nchi njoza ọkkọkka, oborọ achikpakpa p'achibọnga mbo, pira nọtaarẹ akpaama-wurọ. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Ọtọka achibọhnga mbo ọjẹ ọnyọma ny'akkora p'esigwa maphyir p'arọkimaan ad-agwo asi, ọfha eninga ny'ititika kw'arọkimaan mbo k'ogbe kw'mm'akwu agwo asi, mabir avura ayok. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />Nya o, k'ogbe kw'nten njo ivur ayok ny'ititika s'achibọhnga mbo, mamaan ayok p'asi ase, ọmaana p'asi akkẹkkẹk. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />Jekọb ọbhaangẹ ẹkaana ch'atenva ọkọm osok, osi njoza ikkerẹ ititika z'nten s'isi ase, ọmaana s'ipyi-opyi, s'ide nten s'Laban. Minna kw'otim ọbhaangẹ etenkaana chẹ z'nten s'Laban. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />K'ogbe kw'ifor ibin nten s'ide panọng p'ifor igaangẹ ọtam, Jekọb m'ọtọka achibọhnga mbo oyika ny'akkora p'esigwa ny'ititika s'nten njo, ọfha mavura ayok anyọma ny'achibọhnga mbo. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />Ó̱de nten imọm ifor, bẹ ny'akkora p'esigwa mòsok. Nten s'imọm ifor, osok Laban, s'igaangẹ ifor, kẹ ọtọka. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Ofona nya, Jekọb okwu ojibh-ẹ mawuriji, oyena atọhmnọng k'ẹpanọng ọttara k'ejinọng, ọmaana akamẹl ọttara nnyanya.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">Jekọb ọrọbhọ z'Laban k'mbọhk</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Jekọb ọbhaang bẹ́, ajinọngva p'Laban kk'atọma ogbugbaak bẹ́, “Jekọb kk'oyena kw'atte kwamina ọtọka maphyir, otima osi ojibhada kwẹ.” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Jekọb okwu ozonga bẹ́, osisi kw'Laban inod-osi ọmaan-ẹ, ọdọk ọkkọkka kode.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />Nya o, Ọvaar Ibinọkpaabyi oben Jekọb bẹ́, “Kpa nnam z'izek s'ab'atte, ọttara z'anọng pọ. Kaam m'nninga mmaan-ọ.”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Nya o, Jekọb ọtọhm ẹkkaabha ọnang Rachẹl ọmaana Lea bẹ́, makebh-ẹ za ch'od-oninga okkerẹ etirakpo. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />Oben bẹ bẹ́, “Kaam kk'nza bẹ́, osisi kw'atte kwabọnga ọdọk mbengana kode ọmaan-m. Okenaka, Ibinọkpaabyi kw'atte kwaam, oning ka ọmaan-m. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Bọnga nkk'zonga bẹ́, kaam ntim ẹfa chaam maphyir nsi ọtọhm nnang atte kwabọnga. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />Chibhẹ nya, atte kwabọnga kk'aam ottuka, obhona ẹtọhm-phya chaam k'igbedim ijobh. Okenaka, Ibinọkpaabyi kk'ẹ ọbọhk kotte bẹ́, osi-m ọttọhk. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Ó̱de oben bẹ́, ‘Nten s'isi ase jọ im'ide ẹphya ch'ọtọhm fọ,’ minna kw'nten maphyir im'isi ase. Ó̱de obir oben bẹ́, ‘Njo s'isi akkẹkkẹk jọ im'ide ẹphya ch'ọtọhm fọ,’ minna kw'nten njo ibir imaan iva p'asi akkẹkkẹk. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Ibinọkpaabyi kk'ozenga m'eden nda, ọtọka nten s'atte ọnang-m.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />“K'ogbe kw'nten id-iyima ayok ábẹ̀, nttaar idachen k'ewu danẹ, nze bẹ́, avudim p'ad-avura avugboka, masi ase, mabir attima akkẹkkẹk. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />Ny'idachen njo, ozeng-eden kw'Ibinọkpaabyi oyer-m bẹ́, ‘Jekọb.’ Kaam nchera bẹ́, ‘Kirẹ kaam ma.’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Ozeng-eden nwo oben bẹ́, ‘Tinẹ ititika kkerẹ k'ẹrọng, maze bẹ́, avudim maphyir p'asi ase, ọmaana p'attim akkẹkkẹk, mavur avugboka. Kaam kk'okpenamkpen nza f'Laban od-osi ọnang-ọ. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Kaam wọ nde Ibinọkpaabyi kw'oyinẹ okebh-ọ z'Bẹtẹl, za ch'abyeng ọta ana k'eso, abir achekẹ anang-m. Ofona nya, bina m'izek nja, kpa nnam z'ọmmaana-bhon kwọ.’ ”<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Nya o, Rachẹl ọmaana Lea mapọhn-ẹ bẹ́, “Ma, mina motim oyen okebh z'oyena kw'atte kwamina yirẹ? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Ma, kẹ nọtọk mina mach'akikennọng yirẹ? Kẹ kk'mina ọtọka okpe, obir ọkpa nnam ochi akpuka p'manang-ẹ k'amina k'nso. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />K'odik ọkkọkka, ojibhada maphyir kw'Ibinọkpaabyi ọtọk z'atte kwamina, oyen mina, ọmaana iva pamina. Nya o, si k'ose kw'Ibinọkpaabyi ikk'ọ obena.”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Minna kw'Jekọb ọtọk iva pẹ, ttara panọng pẹ, ọnana k'akamẹl, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />otima etirakpo pyẹ, ọmaana oyena kwẹ maphyir kw'oyen z'Padan-Aram, obina ozenga bẹ́, ochina z'izek s'Kenaan, okebha otte Isaak za.<verse eid="GEN 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19" />K'ogbe kw'Laban ikk'obina bẹ́, od-ophyirẹ arọkimaan pẹ iphyabha, Rachẹl obina, od-ofu akpata p'ẹsọhmmọr ch'otte. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Obir ode bẹ́, Jekọb ọbọhr Laban kw'ofon Aram, kẹ kotekẹ bẹ́, m'ọrọbh-ọrọbh. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Minna wọ kw'ọrọbhọ ọttara oyena kwẹ maphyir, otima ojeka ọraanga kw'Yupharetes, okkerẹ eso z'Gilead, z'ẹbhaakẹ ch'agbe.<verse eid="GEN 31:21" /></para>
  <para style="s">Laban okwubhọ Jekọb</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Ottong iwu ittaan nya, matek Laban bẹ́, Jekọb kk'ọrọbha. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Laban otima achimmanọng pẹ, makwubh Jekọb k'iwu ichenọmfa, pira nnakebh-ẹ z'Gilead, z'ẹkọma ch'egbe. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />Ny'erungọ, Ibinọkpaabyi oyin k'idachen okebha Laban kw'ofon Aram, ọtọr-ẹ itọhng bẹ́, “Kker-ọ ifor o! Jekọb odik kpenamkpen kàben ọ, zaa wura ojibh-ojibh, wanẹma, opyibh-opyibh o.”<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Wa ch'Jekọb ikk'ikkira sẹ ottima z'Gilead, z'ẹkọma ch'egbe, Laban, ọmaana achimmanọng pẹ, makebh-ẹ nya, mabir asi okkira fabẹ, mabhing nya. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />Nya o, Laban oben Jekọb bẹ́, “Osi yen kw'asi minna? Kk'aam abọhra, atim panọngva paam arọbh mach'anọng p'mabọk k'ẹmmọri. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Kayen kw'abọr-m atubh-otubha arọbh? Kayen kw'ina kaam atekẹ, ọfha ntima mbin, ọttara ọkkọhna, nrik bọnga k'eden? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Kọ kaam ọbọhk katte bẹ́, mbaaka iva p'iva paam, ọmaana panọngva paam, mbenẹ bẹ bẹ́, mayima. Ọttọhk f'asi ma, ode eturọ. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Kaam nyen ẹfa ch'iwura ntim nsọ-ọ ọttọhk. Okenaka, chena k'erungọ, Ibinọkpaabyi kw'atte kwọ, oyinẹ okebh-m, ọtọr-m itọhng bẹ́, ‘Kker-ọ ifor o! Jekọb odik kpenamkpen kàben ọ, zaa wura ojibh-ojibh, wanẹma, opyibh-opyibh o.’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Ma, kk'afona okurọ ch'ọjọkọ bẹ́, akpa nnam z'atte k'obhon. Okenaka, Asi yen afu akpata paam o?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />Jekọb ọpọhn-ẹ bẹ́, “Kaam nrọbhọ okurọ ch'ojor-m bẹ́, mana-m panọngva pọ k'ẹfa. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Okenaka, óde aze ọnọng kw'otim akpata pọ ma, ọnọng nwo akpen mòruk. Baana m'ititika s'anọng pamina, óde aze ọttọhk kpenamkpen f'ode fọ, tọka.” Jekọb kozong bẹ́, Rachẹl kk'akpata mbo, ọfa.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Laban ocheden ọfọhngọ ikkira s'Jekọb, pira ochina za s'Lea, ọmaana s'atọhmnọng mbo afa, ọttọhk koze. Ch'ikk'ochera z'ikkira s'Lea, odim z'ikkira s'Rachẹl. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Wa Rachẹl kk'akpata mbo odubha z'iwọr-ninga-byi s'kamẹl kwẹ, oninga ẹwọr ọyakẹ bẹ. Laban ọfọhngọ ibyi kpenamkpen z'ikkira s'Rachẹl, ọttọhk koze.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />Rachẹl oben otte bẹ́, “Ttatta, ototo, oning-ọ ọdọkọ ch'ina m'mbina mbe-obe m'ikọ k'ititika. Kaam ntto ofor.” Laban ochina ororo ọfọhngọ ikkira s'Rachẹl, akpata pẹ koze.<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />Ettem epyibh Jekọb, ọbọbh Laban bẹ́, “Njẹ mbọng o? Bọng-epyibha ch'nsi ch'ad-azeng ábẹ̀, akwubh-m ẹfa-ẹfa minna? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Ma ch'ikk'ekpo pyaam afọhnga maphyir, bọng ọttọhk fọ f'ikk'aza? Jẹ fẹ m'ititika s'anọng pọ, ọttara paam, tte bẹ makpaara aponga anang mina nnam mfa.<verse eid="GEN 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38" />“Kaam kk'nninga mmaan-ọ k'icho minna ẹrọbh, ibhọr arọkimaan pọ, ọmaana avu pọ kiyinẹ, arọkimaandim pọ kimbir nchi. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Nten sọ s'mgbatten ifhọ, kk'ọ ntima nd-nchena. Kaam wọ kw'id-idimẹ. Kọ ad-asi-m ntuk eten kpenamkpen ch'orubh ofu: ode k'ẹya o, ode k'erungọ. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Wa echekira ẹd-ẹmaan-m k'ẹya, ekok esi-m k'erungọ, mbir ntim ọda. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Wa ode minna k'icho ẹrọbh s'nning mmaan-ọ. Nsi ọtọhm k'icho osowanẹ kw'ichi ọfha anang-m panọngva pọ afa, mbir nkkerẹ nten sọ k'icho ichadanẹ. Chibhẹ nya, kọ ayekẹ ẹphya ch'ọtọhm faam igbedim ijobh. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Wura ina Ibinọkpaabyi kw'atte kwaam Abraham, ọmaana kw'Isaak ode, wura wa akwubh-m mbọhk-mbọhk. Okenaka, Ibinọkpaabyi kk'irem saam, ọmaana ọtọhm faam ọza. Kẹ wọ osi, chena k'erungọ, opyim-ọ.”<verse eid="GEN 31:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Laban ọpọhna Jekọb bẹ́, “Panọng mba ade aminava paam, iva pabẹ made iva paam, etirakpo mbya, ede pyaam. Ọttọhk kpenamkpen f'aze ma, ode faam. Kọ achibhẹ bẹ́, kaam m'nsi mbọng mmaana aminava mba paam, wanẹma iva p'nkk'amaana? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Kwu, kọ ọmaana kaam mochekẹ ọnang ayok. Tte echekẹ ndo ede nttẹsẹ kwamina.”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Nya o, Jekọb ọtọka ọta ommin, ọsẹ-ẹ ebe mach'ẹkpọmmachi. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Oben anọng pẹ bẹ́, “Màtobha ata.” Minna kw'matobh ata k'okkin, maninga anyọma nya, machi ọttọhk.<verse eid="GEN 31:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 31:47" />Laban oyerẹ ọtakkin nwo bẹ́, Jegar-Sahaduta<note caller="+" style="f"><char style="fr" closed="false">31.47 </char><char style="fq" closed="false">Jegar-Sahaduta: </char><char style="ft" closed="false">K'eHiburu oyinẹ bẹ́, okkin kw'nttẹsẹ.</char></note>, Jekọb oyerẹ wẹ bẹ́, Galeed.<verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />Laban oben bẹ́, “Ọtakkin nwa ode nttẹsẹ ọnang kọ ọttara kaam menda.” Kẹ wọ osi, wa mayerẹ wẹ bẹ́, Galeed. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />Wa ibyi njo ibira ikpena Mizpa<note caller="+" style="f"><char style="fr" closed="false">31.49 </char><char style="fq" closed="false">Mizpa </char><char style="ft" closed="false">oyinẹ bẹ́, ikkerẹ-byi, wanẹma, ibyi s'ekkerẹ. </char></note> okurọ ch'iwa obenẹ bẹ́, “Tte Ọvaar Ibinọkpaabyi okkerẹ kọ ọmaana kaam k'ogbe kw'nkk'ayok ọbọhk ọta. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Ó̱de anang panọngva paam irem, obir ode bẹ́, atọk panọng ọdọk-ọdọk, zaabẹ́ ọnọng mina koning ọmaana, jima bẹ́, Ibinọkpaabyi wọ ode nttẹsẹ kw'ikọ ọmaana kaam.”<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />Laban obir oben Jekọb bẹ́, “Kirẹ ọtakkin, kirẹ ẹkpọmmachi ch'ikk'mmina k'njeka kw'ikọ ọttara kaam. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Ọtakkin nwa, ọmaana ẹkpọmmachi nda, ede nttẹsẹ bẹ́, kaam ọtakkin nwa mìnjeka nchina z'ikọ k'ẹbhaakẹ nsọ-ọ itama, kọ ọdọk, ọtakkin nwa ọmaana ẹkpọmmachi nda mabir ajeka, asi-m itama. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Tte Ibinọkpaabyi kw'Abraham ọmaana kw'Nahọr makpobh, ọkpaara aponga p'mina anọng afa.”</para>
  <para style="p" vid="GEN 31:53">Nya o, Jekọb ochekẹ k'eche ch'Ibinọkpaabyi kw'ab'otte makpobh. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Jekọb ọfhọ ọrọkimaan otima ọfọhnọ ẹja ny'ogbeso nwo, oyerẹ anọng pẹ ọchattọhk. Ch'nkk'ọttọhk acha maphyir, mabhing nya ny'erungọ ndo. <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />K'ekpikpebha ch'ewu esobh, Laban ọbaaka iva p'iva pẹ ọmaana panọngva pẹ, obir osi bẹ ittabọhng. Ocher nya o, ọbhana z'ikẹ k'obhon.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">Jekọb odo ifor bẹ́, okebha Ẹsau</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Jekọb obir obina ozenga, azeng-eden p'Ibinọkpaabyi ayin akebh-ẹ.<verse eid="GEN 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 32:2" />Oze bẹ nya, oben bẹ́, “Ma wọ ode ibhinga-byi s'Ibinọkpaabyi.” Ofona nya, okpe ibyi njo Mahanayim<note caller="+" style="f"><char style="fr" closed="false">32.2 </char><char style="fq" closed="false">Mahanayim </char><char style="ft" closed="false">oyinẹ bẹ́, obhinga-byi ọfa.</char></note>.<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />Jekọb ọtọhm azeng-eden pẹ bẹ́, machẹ-ẹ eden akebha ọgbaanọkka Ẹsau z'Seir kw'ode ẹkọma ch'Edom. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />Oben bẹ bẹ́, “Odik kw'mm'agbaak atte kwaam Ẹsau ode bẹ́, ‘Kaam ọtọhmnọng kwọ Jekọb, mbenẹ bẹ́, tọma za maa, pyirẹ ma, nning mmaana Laban. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Kaam kk'abhaam, ọmaana nnyanya, ọmaana arọkimaan, ọmaana avu, ọttara atọhmnọng k'ejinọng, ọttara k'ẹpanọng, nyena. Ntọhmọ ẹkkaabha nda nnang kọ atte kwaam, ọfha nyena ọdaam z'ikọ k'ititika.’ ”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />K'ogbe kw'azeng-eden mbo p'Jekọb makpa nnam za ch'ọtọhmọ bẹ, makebh-ẹ, maben-ẹ bẹ́, “Nkk'agbaanakka kwọ Ẹsau ọd-ọza. Kẹ oter okwuma z'eden ọmaana anọng ẹnọhna bẹ́, okwu okebh-ọ e.”<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Nya o, Jekọb okwu ojor-ẹ, ettem ebir ẹyak-ẹ odik maa, ọtọka anọng p'otim, ọbhaangẹ k'nkwurọ mfa, obir ọbhaangẹ arọkimaan, ọmaana abhaam, ọttara akamẹl. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Ochibhẹ bẹ́, “Ó̱de Ẹsau okwu orima ẹkaan danẹ ábẹ̀, ńnòsi ndoza ch'erikẹ, m'ẹrọbh ẹnaanga.”<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Nya o, Jekọb oze njọm bẹ́, “O Ọvaar Ibinọkpaabyi kw'atte kwaam Abraham, ọmaana kw'atte kwaam Isaak, kọ kw'aben-m bẹ́, ‘Kpa nnam z'ẹkọma chọ, ọmaana z'anọng pọ. Kaam m'nsi idik ijibh inang-ọ.’ <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />Kaam ọtọhmnọng kwọ k'ọphyaam fọ, ọmaana ididaaka sọ maphyir-phyir, kimbaan. Kaam wa njek ọraanga kw'Jọrdan mmaana ochikwura kwaam kẹ-kẹ. Menda, kaam n'nde nkkaana mfa. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Ototo, kkaan-m arọhbh-m k'mbọhk s'agbaanakka kwaam Ẹsau. Ojor-m bẹ́, kẹ m'okwu orim-m ábẹ̀, obir orima ọmaana iva paam, ọttara ab'ọkka. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Okenaka, kọ wa abenẹ bẹ́, ‘Kaam m'nsi idik ijibh inang-ọ, mbir nsi iva p'iva pọ masaabh mach'ofong kw'ẹraangaka kw'ina obhika ode.’ ”<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />Ny'erungọ ndo, Jekọb obhing nya, oteka nnanga ny'oyena kwẹ, s'im'ọnang ọgbaanọkka, Ẹsau. Nnanga njo ide: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />avugboka arọbh ijobh, ọmaana abhọngkpẹ ẹrọbh, ọmaana arọkimaan p'panọng arọbh ijobh, ọttara arọkimaandim ẹrọbh, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />ọmaana akamẹl p'panọng ẹrọbh obhirẹ ijobh, ọttara iva pabẹ, ọmaana abhaam p'panọng arọbh afa, ọmaana abhaamdim ijobh, ọmaana nnyanya s'panọng ẹrọbh, ọttara adimpẹ pẹ ijobh. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Ọtọka ẹkaan kadanẹ-kadanẹ, ọnang atọhmnọng bẹ́, makkerẹ, obir oben bẹ bẹ́, “Màchi-m eden zọhng. Tte ẹkkaan kpenamkpen ezenga erik oyok obhokọ.”<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />Oben oyok kw'ochi eden bẹ́, “K'ogbe kw'attem amaana agbaanakka kwaam Ẹsau, óde ọbọbh-ọ bẹ́, ‘Kọ ade kw'anyi? M'ata men? Anyi wọ oyen nten nja s'ining-ọ m'ititika?’ <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />Kọ m'apọhn-ẹ bẹ́, ‘Ọtọhmnọng kwọ Jekọb wọ oyen e. Ẹnanga ch'ọtọhmọ ọnang atte kwaam Ẹsau, dọ nya e. Kẹ oyenẹ okwuma z'eden e.’ ”<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Minna kw'Jekọb obir ọtọhn ẹkaan ch'ettong mfa, ọmaana ch'ettong nttaan, ọttara ayok p'atorọ nten njoza maphyir bẹ́, “Bọnga mm'agbaak edikdaak ndo madanẹ k'ogbe kw'mattem amaana Ẹsau. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Nkàzaama bẹ́, matek-ẹ bẹ́, ‘Ọtọhmnọng kwọ Jekọb, okwuma z'eden.’ ” Jekọb oben z'ettem bẹ́, “Kaam m'ntima nnanga nja s'ikk'eden icha, nsi ettem elebh-ẹ, ọfha k'ogbe kw'mm'oze ayok, ọtọk-m k'ettem ọkkọkka.” <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Nya o, atọhmnọng p'Jekọb, matima nnanga achi eden afona. Kẹ oyenẹ, oyima ny'ibhinga-byi ny'erungọ ndo.<verse eid="GEN 32:21" /></para>
  <para style="s">Jekọb orim ọmaana Ibinọkpaabyi</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Ny'erungọ ndo, Jekọb obina, ọtọka panọng pẹ afa, ọmaana atọhmnọng pẹ afa p'panọng, ọttara ajinọngva pẹ ijobh kawanẹ, ozenga ny'ibyi s'igbẹr-ọgbẹrẹ ojeka ọraanga kw'Jabọk. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />Ojek bẹ nya o, obir ọtọhm oyena kwẹ maphyir ojeka z'okwubha. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />Okwu orik Jekọb kẹ-kẹ nya. Ojinọng wanẹ okwu orim-ẹ ábẹ̀ maa, ewu esobha. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />K'ogbe kw'ojinọng nwo oze bẹ́, kẹ kokpo okema, otwu Jekọb ny'ogbok, ogbok-kọbhọ kw'Jekọb ọpyaarẹ. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />Nya o, ojinọng nwo oben-ẹ bẹ́, “Tte-m ọbọhk mfona, kirẹ ewu k'esobha.” Jekọb ọpọhn-ẹ bẹ́, “Kaam kọ ọbọhk mìntte, oye bẹ́, kk'aam ada.”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Ojinọng nwo ọbọbh-ẹ bẹ́, “Kọ akpen yen?” Kẹ ọpọhn-ẹ bẹ́, “Mkpen Jekọb.”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Ojinọng nwo oben-ẹ bẹ́, “Kọ ọdọk Jekọb màkpena, nakpen Israẹl, okurọ bẹ́, kk'arima amaana Ibinọkpaabyi, ọttara ayokinọng, akema.”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Nya o, Jekọb oben-ẹ bẹ́, “Ototo, tek-m eche chọ.” Kẹ ọpọhn-ẹ bẹ́, “Kayen kw'abọbhọ eche chaam?” Minna kw'ozeng odo Jekọb nya.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Ofona nya, Jekọb okpe ibyi njo bẹ́, Pẹniẹl<note caller="+" style="f"><char style="fr" closed="false">32.30 </char><char style="fq" closed="false">Pẹniẹl </char><char style="ft" closed="false">oyinẹ bẹ́, ititika s'Ibinọkpaabyi.</char></note>, oben bẹ́, “Kaam kk'Ibinọkpaabyi nza ttara achen paam afa, chibhẹ nya, ntim nrukọ akpen ka.”<verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />Nya ch'ewu nebe k'eso, Jekọb ọkpan Pẹniẹl, od-ogbekẹ okurọ ogbok-kọbhọ kwẹ. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Kẹ wọ osi, tọma z'ogbe nwo maa, pyirẹ ma, anọng p'Israẹl m'eten ch'ẹbọk ọkọbhọ kw'ogbok kw'eten kpenamkpen kad-achi, okurọ bẹ́, ny'ogbok wọ kw'uwa mamumọ Jekọb ọttọhk.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">Ẹmẹm ch'Jekọb ọmaana Ẹsau</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Jekọb otinẹ ichen, oze bẹ́, Ẹsau okwuma, ọmaana anọng ẹnọhna pẹ. Minna kw'okebhẹ iva pẹ ọnang Lea, ọmaana Rachẹl, ọttara atọhmnọng pẹ p'panọng afa. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Osok atọhmnọng pẹ, ttara iva pabẹ z'ititika, Lea ọmaana iva pẹ mator bẹ, pira Rachẹl ọmaana Josẹph nnakpong nnam. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Kẹ oyenẹ ochi bẹ eden. K'ose kw'ọd-ọnyọma ọgbaanọkka, ọraka otima eso ny'izek ọnang-ẹ, igbedim ichenọmfa.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />Ẹsau oter otima ẹbhar, od-ọwọhmọ Jekọb, ọgaar-ẹ mbọhk z'ẹdọngọ, ọbaak-ẹ. Bẹ anọng afa, masọhrọ asen. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Ẹsau otinẹ ichen okkerẹ, oze panọng ọmaana iva mbo, ọbọbh Jekọb bẹ́, “Bọng-anọng bọ matọnọ ma?”</para>
  <para style="p" vid="GEN 33:5">Jekọb ọpọhn-ẹ bẹ́, “Iva p'Ibinọkpaabyi ikk'ọphyaam fẹ otima ọnang ọtọhmnọng kwọ bọ e.”<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Nya o, atọhmnọng pẹ p'panọng, ọmaana iva pabẹ, mazenga anyọma Esau, maraka nso anang-ẹ. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Ọpọhn za, Lea, ọmaana iva pẹ, maraka nso anang-ẹ. Pira Rachẹl, ọmaana Josẹph nnakpong nnam makwu araka nso anang-ẹ.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />Ẹsau ọbọbh Jekọb bẹ́, “Etirakpo mbya maphyir py'nkebh ma, eyinẹ yen o?”</para>
  <para style="p" vid="GEN 33:8">Jekọb ọpọhn-ẹ bẹ́, “Atte, ntim pyẹ bẹ́, nsi ettem ẹdaam-ọ ẹmaan-m e.”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Ẹsau ọpọhn-ẹ bẹ́, “Mma e, agbaanakka kwaam. Kaam kk'ekpo ntera nyena k'ọsaabh e. Kọ tera sok mbyo py'ikk'ayena za.” <verse eid="GEN 33:9" /><verse number="10" style="v" sid="GEN 33:10" />Jekọb ọpọhn-ẹ bẹ́, “Mma e, nkwuk-ọ-okwukọ! Ó̱de ikk'ọ ndaaka z'ettem, tọka ẹnanga nda chaam. Kirẹ ẹza ch'nzọ-ọ ma, ode mach'nze ititika s'Ibinọkpaabyi, ch'ikọ kk'aam abir atọka k'ettem ọkkọkka. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Ototo, tọka ẹnanga nda ch'nnang-ọ, okurọ bẹ́, Ibinọkpaabyi kk'ọphyaam ọsa ọnang-m. Kaam nyen ọttọhk kpenamkpen f'nnorọ.” Ẹsau okwu oze bẹ́, Jekọb obe ny'odik kwẹ, ofona nya, ochera ọmaan-ẹ, ọtọka ẹnanga ndo.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Ẹsau oben-ẹ bẹ́, “Tte mọtọma ozenga. Kaam m'nchọ-ọ eden.” <verse eid="GEN 33:12" /><verse number="13" style="v" sid="GEN 33:13" />Jekọb ọpọhn-ẹ bẹ́, “Atte kwaam azong ma bẹ́, iva mba atim achamẹ ọkpan, ọmaana bẹ́, kaam m'nkkerẹ etirakpo py'etim ẹrọkọ iva pabẹ ọrọk. Ó̱de nna bẹ <char style="it">ma bẹẹm </char> ayaarẹ, zaabẹ́ ewu madanẹ dọ, mm'ape-ope. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Tte atte kwaam ochi ọtọhmnọng kwẹ eden, kaam m'nyaar nyaak-ẹ nnam, <char style="it">ma bẹm bẹm</char> k'ose kw'ina etirakpo mbyo, ọmaana iva pabẹ mọkọhn maa, nkebha atte kwaam z'Seir.”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />Ẹsau oben Jekọb bẹ́, “Ó̱de ode minna, tte nnang-ọ ajinọng banẹ paam, matọn afona kẹ.”</para>
  <para style="p" vid="GEN 33:15">Okenaka, Jekọb ọpọhn-ẹ bẹ́, “Kayen kw'masi minna? Bung-bungọ f'nnorọ ode bẹ́, nyena ọdaam f'ikọ atte kwaam.”<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Minna kw'Ẹsau ọtọm ozenga ny'ewu ndo, ọkpa nnam z'Seir. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Okenaka, Jekọb ochina z'Sukọt, od-osi ọsọhm kwẹ za, obir osi okkira f'etirakpo pyẹ. Kẹ wọ osi, makpe ibyi njo bẹ́, Sukọt<note caller="+" style="f"><char style="fr" closed="false">33.17 </char><char style="fq" closed="false">Sukọt </char><char style="ft" closed="false">oyinẹ bẹ́, okkira.</char></note>.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Ch'Jekọb obin z'Padan-Aram opyirẹ z'ebhondim ch'Shẹkẹm, z'ẹkọma ch'Kenaan, osi ibhinga-byi ọnyọma Shẹkẹm. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Wa Jekọb otim asilva arọbh achen, odebh izek s'ottim ikkira sẹ. Iva p'Hamọr kw'ode otte kw'Shẹkẹm, bẹ bọ uwa makpẹ-ẹ izek njo. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Nya wọ kw'osi ija-byi s'Ibinọkpaabyi, okpe sẹ bẹ́, Ẹl Ẹlọhe Israẹl.<note caller="+" style="f"><char style="fr" closed="false">33.20 </char><char style="fq" closed="false">Ẹl Ẹlọhe </char><char style="ft" closed="false">oyinẹ bẹ́, Ibinọkpaabyi wọ ode Ibinọkpaabyi kw'Israẹl.</char></note><verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">Daina ọmaana anọng p'Shẹkẹm</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Ewu danẹ, Daina kw'ode ominanwa kw'Lea ọmaanẹ ọnang Jekọb, obin ọta idibhada z'panọng banẹ p'obhon nwo. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />K'ogbe kw'Shẹkẹm kw'ode nnwa kw'Hamọr kw'ode ọvaarnọng kw'Hiv oze Daina nya, ọbọk-ẹ k'ẹfa, oyim-ẹ ábẹ̀. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Ch'oze Daina kw'ode ominanwa kw'Jekọb, ọdaak-ẹ maa, oyer-ẹ eyonga. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Shẹkẹm oben otte kwẹ Hamọr bẹ́, “Tọka ominanwa nwoma, nang-m k'ọbada.”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Jekọb okwu ọbhaanga bẹ́, nkk'nnwa kwẹ Daina alẹka, mayim-ẹ ábẹ̀. Ode ch'iva p'Jekọb atim aning z'ẹgba ọmaana etirakpo py'otte. Omyi odik nwo nya maa, iva mbo makwuna.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Nya o, Hamọr kw'ode otte kw'Shẹkẹm obina oyin nttọhna ọmaana Jekọb k'odik kw'oyinẹ. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />K'ogbe kw'ajinọngva p'Jekọb mabhaang odik nwo nya, makwuna eyina ny'eninga ndo, nttem ibhem bẹ, ibir ipyibh bẹ mawuriji okurọ ọgbardik-ttọhk f'Shẹkẹm osi ọnang Israẹl, ch'oyim ominanwa kw'Jekọb ábẹ̀ k'ẹfa, ọttọhk f'ina maphyir-phyir ọbaan bẹ́, osi.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />Okenaka, Hamọr oben bẹ bẹ́, “Ettem ch'ojinọngnwa kwaam Shẹkẹm, ẹgban k'ominanwa kwọ e. Ototo, ttẹ-ẹ ọbọhk maba ayok. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Màtte mọbhakẹ ọba ayok: tte aminava pabọnga aba mina, aminava pamina mabira aba bọnga. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Màruk maana mina m'izek nja s'itte eje ma, mazenga mphya s'idaakẹ bọnga, mabira asi oyena kwabọnga ma.”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Nya o, Shẹkẹm oben otte kw'Daina, ọmaana ivotte bẹ́, “Ototokinẹ, màsi ọkkaan nwa nang-m. Kaam m'nnang bọnga ọttọhk kpenamkpen f'marorọ. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Tek-m ẹba-phya, ọmaana ẹnanga k'ose kw'ọdaak-ọ, kaam m'nnang bọnga ọttọhk kpenamkpen f'maben-m. Màkenaka nang-m ominanwa nwo k'ọbada.”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Ajinọngva p'Jekọb matima nkkar apọhna Shẹkẹm, ọmaana otte Hamọr odik nwo, okurọ ch'nkk'Daina kw'ode ọgbaanotte kwabẹ, alẹka. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />Maben bẹ bẹ́, “Mina m'ọttọhkse mvo mòsi bẹ́, motte agbaanatte kwamina ọbọhk, ọba ojinọng kw'ina ọnọm obhirẹ. M'ode ọgbardik-ttọhk ọnang mina. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Mina mm'okenaka ochera ọmaana bọnga, óde nkk'achera bẹ́, ajinọng pabọnga maphyir abhirẹ inọm mach'mina. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Nya wọ kw'mina mm'ọnang bọnga aminava pamina maba, mina mobir ọba pabọnga. Ó̱de mási minna, mm'oruk ọmaana bọnga, mobira ode ọttọhk mavanẹ. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Okenaka, óde bọnga nnacher bẹ́, mm'abhirẹ inọm, mina mm'ọtọka agbaanatte kwamina otima ofona.”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Ochibhẹ kwabẹ ọdaam Hamọr, ọmaana ojinọngnwa kwẹ Shẹkẹm ettem. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Minna kw'Shẹkẹm nwo kw'ode ojinọngnwa kw'oyen ikpukpobha ọyọhnga ayok maphyir ny'echimma ch'otte, ina ogbe okibhẹ bẹ́, od-osi k'ose kw'maben-ẹ, okurọ ọdaakẹ kw'oyen k'ominanwa kw'Jekọb. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Ofona nya, Hamọ ọmaana Shẹkẹm machina z'ẹbhaama chabẹ, mad-agbaak anọng pabẹ bẹ́, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />“Ajinọng mba ajibhẹ ẹ́mmáaná atima ator mina. Tte motte bẹ ọbọhk maruk amaana mina, mazenga mphya s'idaakẹ bẹ. Izek s'moyen ma, m'ibenga bẹ obenga. Mina mm'ọtọka aminava pabẹ k'ọbada, bẹ mabira atọka pamina. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Anọng mba m'akenaka achera bẹ́, moruk mach'anọng mabanẹ, óde ajinọng pamina mm'achera abhirẹ inọm mach'abẹ. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Ó̱de m'osi minna, nten sabẹ, ọmaana oyena kwabẹ maphyir, m'ode kwamina. Tte mochera ọmaana bẹ bẹ́, mm'obhirẹ inọm, mfha bẹ machera bẹ́, maruk amaan mina.”<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Ajinọng mbo maphyir p'mata z'ẹbhaama, machera amaana Hamọr, ọmaana Shẹkẹm. Ojinọng kpenamkpen kw'obhon nwo, obhir ọnọm.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Ch'iwu ittaan s'ẹnọmbhirẹ ikk'ikpana, nya ch'abhaak atim amma bẹ ọmma, ajinọngva afa p'Jekọb p'ade Simeọn, ọmaana Lẹvi, p'ade ivọkka p'Daina, matọka akkangkkang pabẹ matima arima ajinọng p'obhon nwo k'ogbe kw'ina ichen asokọ, mafhọ bẹ maphyir. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Mabira afhọ Hamọ ọttara Shẹkẹm, matọka Daina z'Shẹkẹm k'ọsọhm atim afona. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Ajinọngva p'Jekọb machina nya ch'affuranọng mbo mayim nya <char style="it">bẹ́ bangẹ-bangẹ</char>, madim ny'obhon kw'manang ọgbaanotte igbardik, macha oyena kwabẹ atima afona. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Matọka nten sabẹ s'matirẹ, ọmaana oyena kpenamkpen kw'mayen ny'obhon ọmaana z'iwonọ. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Matọka oyena kwabẹ maphyir, ọmaana ivava pabẹ, ọmaana panọng pabẹ maphyir, ọttara ọttọhk kpenamkpen f'oning zabẹ k'isọhm.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Nya o, Jekọb oben Simeọn ọmaana Lẹvi bẹ́, “Nkk'odik aja anang-m. Nkk'aam asoka k'iwawuna ọmaana anọng p'Kenaan ọmaana anọng p'Periz p'arukọ m'izek nja. Mina nkọsaabhẹ. Ó̱de bẹ m'agbak, marim-m ábẹ̀, mm'afhọ-m ọmaana ẹsọhmmọr chaam maphyir.”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Bẹ mapọhna otte bẹ́, “Ọbaan za bẹ́, Shẹkẹm osi agbaanakka kwamina mach'ọzaza o?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">Jekọb ọkpa nnam z'Bẹtẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Nya o, Ibinọkpaabyi oben Jekọb bẹ́, “Bina china z'Bẹtẹl asi oruk kwọ za, abira asi ija-byi nya anang kaam Ibinọkpaabyi kw'oyinẹ okebh-ọ k'ogbe kw'ad-arọbh z'mbọhk s'agbaanakka Ẹsau.”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Nya o, Jekọb oben ẹsọhmmọr chẹ ọttara anọng p'aning amaan-ẹ maphyir bẹ́, “Màtọka akpata mbo p'aning amaana bọnga bharẹ, masok ifor sabọnga iwur-owur, mabira abhona ẹfọrakpo py'abọnga k'ifor. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Nya o, màkwu mochina z'Bẹtẹl, za ch'im'nsi ija-byi nnang Ibinọkpaabyi kw'ọbhaang njọm saam k'ogbe kw'nning k'adama, obira oninga ọmaan-m k'ibyi kpenamkpen s'ikk'nta.” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />Minna kw'matte akpata pabẹ maphyir ọbọhk, ọttara ekpo py'itọhng pyabẹ manang Jekọb, ọtọka ọnọhnga z'echirin ch'oak, ch'ẹnyọm Shẹkẹm.<verse eid="GEN 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 35:5" />K'ose kw'Jekọb ọmaana ajinọngva pẹ matọm ozenga, ojora fiden f'Ibinọkpaabyi ọsaka ny'ibhon njo maphyir s'ikọbh bẹ, ọfha ọnọng oning bẹ okwubhọ.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />Jekọb ọmaana anọng pẹ maphyir mapyirẹ z'Luz, kw'obira okpena Bẹtẹl, z'ẹkọma ch'Kenaan. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Nya wọ kw'uwa osi ija-byi s'oyerẹ Ẹl-Bẹtẹl<note caller="+" style="f"><char style="fr" closed="false">35.7 </char><char style="fq" closed="false">Ẹl-Bẹtẹl </char><char style="ft" closed="false">oyinẹ bẹ́, Ibinọkpaabyi kw'Bẹtẹl.</char></note>, okurọ bẹ́, nya wọ kw'uwa Ibinọkpaabyi ọyaakẹ ifor sẹ ọnang-ẹ, k'ogbe kw'uwa ọd-ọrọbh z'ọgbaanọkka k'mbọhk.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Ny'ogbe nwo, wa Dẹbọra kw'ode orirọka kw'Rẹbẹka okwu ope, manọhng-ẹ z'echirin ch'oak, z'izek-izek kw'Bẹtẹl. Ofona nya, wa mayerẹ ibyi njo bẹ́, Alon-Bakut<note caller="+" style="f"><char style="fr" closed="false">35.8 </char><char style="fq" closed="false">Alon-Bakut </char><char style="ft" closed="false">oyinẹ bẹ́, echi ch'ebhoma.</char></note>.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />K'ogbe kw'Jekọb ikk'obina z'Padan-Aram okwuna, Ibinọkpaabyi obira oyin okebh-ẹ, ọsẹ-ẹ ittabọhng, <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />oben-ẹ bẹ́, “Kọ akpen Jekọb, okenaka, ọdọk Jekọb màkpena. Min'akpena Israẹl.” Minna kw'Ibinọkpaabyi ọkpẹ-ẹ Israẹl.<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />Ọvaar Ibinọkpaabyi obira oben-ẹ bẹ́, “Kaam wọ nde Ọvaar Ibinọkpaabyi kw'Ẹfa maphyir. Màbhon iva k'ọsaabh. Ẹkọma ch'im'esi nkọma s'isaabh-ọsaabh m'efona k'ikọ. Avaarnọng mabira afona ny'ikọ k'ntaak. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Izek njo s'iwa nnang Abraham ọttara Isaak, jẹ jọ s'im'nnang-ọ. M'mbira ntte izek njo ọbọhk nnang obhon fọ.” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />Ibinọkpaabyi obina orik-ẹ ny'ibyi njo, ch'ikk'ẹ odik ọgbaaka maphyir.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />Jekọb ommin ọta ny'ibyi njo s'Ibinọkpaabyi ọgbaakẹ odik ọnang-ẹ, obyenga atuk ọmaana ana p'oliv ọnang Ibinọkpaabyi nya. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Jekọb oyerẹ ibyi njo s'Ibinọkpaabyi oyinẹ okebh-ẹ bẹ́, Bẹtẹl.<verse eid="GEN 35:15" /></para>
  <para style="s">Obo kw'Rachẹl ọmaana Isaak</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Jekọb ọmaana anọng pẹ mabina z'Bẹtẹl, mad-azenga z'Ẹphrat. Ch'mazeng nya o, ọmaan f'ọgaang-ọgaangẹ ọbọka Rachẹl. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Okker-ọmaan oben Rachẹl bẹ́, “Oning-ọ ojor. Kk'ojinọng abir amaana.” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Nya ch'imin'ope, okpe ojinọngnwa nwo kwẹ bẹ́, Bẹn-Ọni<note caller="+" style="f"><char style="fr" closed="false">35.18 </char><char style="fq" closed="false">Bẹn-Ọni </char><char style="ft" closed="false">oyinẹ bẹ́, nnwa kw'irem.</char></note>. Okenaka, otte ọkpẹ-ẹ, Bẹnjamin<note caller="+" style="f"><char style="fr" closed="false">35.18 </char><char style="fq" closed="false">Bẹnjamin </char><char style="ft" closed="false">oyinẹ bẹ́, nnwa kw'odimbọhk.</char></note>.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Nya o, wa Rachẹl okwu ope, manọhng-ẹ ny'eden ch'nd-azenga achina Ẹphrat, kw'ode Bẹtẹlẹhẹm. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Jekọb ommin ọta ny'epekwuk ndo. Tọma za maa, pyirẹ ma, ọta nwo kw'mad-atima ajima epekwuk ch'Rachẹl.<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />Jekọb kw'inokpen Israẹl, ochina ororo maa, od-osi iruk-byi sẹ z'okwubha kw'Migdal-Eder. <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />K'ose kw'Israẹl orukọ ny'izek njo, Reubẹn od-oyima ọmaana Bilha kw'ode oyok-nọng kw'otte. Otte ozonga odik nwo.</para>
  <para style="m" vid="GEN 35:22">Wa Jekọb obhonọ ajinọngva ijobh kkamfa:<verse eid="GEN 35:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 35:23" />Ajinọngva p'uwa Lea ọmaanẹ made:</para>
  <para style="li2" vid="GEN 35:23">Reubẹn, kw'ode ocheden kw'Jekọb,</para>
  <para style="li2" vid="GEN 35:23">ọmaana Simeọn, ọmaana Lẹvi, ọmaana Juda, ọmaana Isaka, ọttara Zẹbulun.<verse eid="GEN 35:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24" />Ajinọngva p'Rachẹl wa made:</para>
  <para style="li2" vid="GEN 35:24">Josẹph ọttara Bẹnjamin.<verse eid="GEN 35:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25" />Ajinọngva p'Bilha kw'ode ọtọhmnọng kw'Rachẹl made:</para>
  <para style="li2" vid="GEN 35:25">Dan ọttara Naphtali.<verse eid="GEN 35:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26" />Ajinọngva p'Zilpa kw'ode ọtọhmnọng kw'Lea made:</para>
  <para style="li2" vid="GEN 35:26">Gad ọttara Asha.</para>
  <para style="p" vid="GEN 35:26">Ajinọngva mba bọ p'uwa Jekọb obhonọ z'Padan-Aram.<verse eid="GEN 35:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Wa Jekọb ọkpa nnam otor otte Isaak z'Mamrẹ kw'ọnyọm Kiriyat-Arba (kw'mabir ayerẹ Hẹbrọn), za ch'iwa Abraham ọmaana Isaak marukọ. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Wa Isaak orukọ icho arọbh osowanẹ. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Nya o, okwu ope k'atam, od-okebha ab'ttatta pẹ. Ẹsau ọmaana Jekọb p'ade ajinọngva pẹ, manọhng-ẹ.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">Efonamma ch'Ẹsau</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Ma wọ ode efonamma ch'Ẹsau, kw'obir okpena Edom.<verse eid="GEN 36:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="GEN 36:2" />Wa Ẹsau ọtọk panọng p'afon Kenaan. Kwanọng wanẹ okpen Ada kw'ode ominanwa kw'Ẹlọn kw'ofon Hit. Kwanọng nwoza okpena Oholibama kw'ode nnwa kw'Ana. Wa Ana ode nnwa kw'Zibeọn kw'ofon Hiv. <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />Kwanọng kw'Esau kw'ottong attaan okpen Basẹmat kw'ode nnwa kw'Ishimayẹl ọttara ọgbaanọkka kw'Nẹbayọt.<verse eid="GEN 36:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="GEN 36:4" />Wa Ada ọmaanẹ Eliphaz ọnang Ẹsau. Basẹmat ọmaan Reuẹl, <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />Oholibama ọmaan Jeush, ọmaana Jalam, ọttara Kora. Ajinọngva p'uwa mamaanẹ anang Ẹsau z'Kenaan bọ nya.<verse eid="GEN 36:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="GEN 36:6" />Ẹsau ọtọka panọng pẹ, ọmaana ajinọngva pẹ, ọmaana aminava pẹ, ọmaana ọnọng kpenamkpen kw'ẹsọhmmọr chẹ, ttara etirakpo pyẹ, ọmaana oyena kwẹ maphyir kw'ikk'ọsa ny'Kenaan, obina orik ọgbaanọkka Jekọb nya, ofona od-osi oruk kwẹ z'ibyi ọdọk-ọdọk. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Wa izek ọdọk bẹ kibeng okurọ ọsaabh kw'oyena ọttara etirakpo pyabẹ. Ofona nya, m'ọdọk ibyi majanẹ kakpo aruk. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Nya o, Ẹsau kw'obir okpena Edom osi oruk kwẹ z'ẹkọma ch'egbe ch'Seir.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Ma wọ ode efonamma ch'Ẹsau kw'ode otte kwiden kw'anọng p'Edom p'arukọ z'ẹkọma ch'egbe ch'Seir.<verse eid="GEN 36:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="GEN 36:10" />Ache p'ajinọngva p'Ẹsau made:</para>
  <para style="li2" vid="GEN 36:10">Eliphaz kw'Ada ọmaanẹ,</para>
  <para style="li2" vid="GEN 36:10">ọttara Reuẹl kw'Basẹmat ọmaanẹ.<verse eid="GEN 36:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 36:11" />Ajinọngva p'Eliphaz obhonọ made: Teman, ọmaana Ọma, ọmaana Zepho, ọmaana Gatam, ọttara Kenaz. <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />Wa Eliphaz kw'ode nnwa kw'Ẹsau obir oyena oyok-nọng kw'okpen Timna kw'ọmaan-ẹ nnwa kw'okpen Amalẹk. Ada kw'ode kwanọng kw'Ẹsau wọ ode ọkka kwiden kw'iva mba.<verse eid="GEN 36:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 36:13" />Wa ajinọngva p'Reuẹl made: Nahat, ọmaana Zẹra, ọmaana Shama, ọttara Miza. Basẹmat kw'ode kwanọng kw'Ẹsau wọ ode ọkka kwiden kw'iva mba.<verse eid="GEN 36:13" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="14" style="v" sid="GEN 36:14" />Ajinọngva p'Oholibama, ominanwa kw'Ana kw'otte kwiden okpen Zibeọn ọmaanẹ ọnang Ẹsau made: Jeush ọmaana Jalam ọttara Kọra.<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Avaar p'efonamma ch'Ẹsau, p'afon k'ẹnọmma ch'Eliphaz kw'ode ochedennwa kw'Ẹsau made: Teman, ọmaana Ọma, ọmaana Zepho, ọmaana Kenaz,<verse eid="GEN 36:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="GEN 36:16" />ọmaana Kọra, ọmaana Gatam, ọttara Amalẹk. Anọng mba bọ uwa matim mvaar ny'ẹnọmma ch'Eliphaz ny'Edom. Ada wọ ode ọkka kwiden kw'iva mba.<verse eid="GEN 36:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 36:17" />Avaar p'afon k'ẹnọmma ch'Reuẹl kw'Ẹsau obhonọ z'ẹkọma ch'Edom made: Nahat, ọmaana Zẹra, ọmaana Shama, ọttara Miza. Basẹmat kw'ode kwanọng kw'Ẹsau wọ ode ọkka kwiden kw'avaar mba.<verse eid="GEN 36:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 36:18" />Avaar p'afon k'ntaak s'Oholibama kw'ode kwanọng kw'Esau, obira ode nnwa kw'Ana, made: Jeush, ọmaana Jalam, ọttara Kọra.<verse eid="GEN 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19" />Nya wọ ode ajinọngva p'Ẹsau, kw'obira okpena Edom, ttara avaar p'nnọmma sabẹ.<verse eid="GEN 36:19" /></para>
  <para style="s">Ẹnọmma ch'Seir</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Ajinọngva p'Seir kw'ofon Họr, p'uwa arukọ ny'ẹbhaakẹ ch'Edom made:</para>
  <para style="li1" vid="GEN 36:20">Lotan, ọmaana Shobal, ọmaana Zibeọn, ọmaana Ana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />ọmaana Dishọn, ọmaana Ẹzẹr, ọttara Dishan. Ajinọngva mba p'Seir p'abin k'efona ch'Edom bọ iwa made avaarnọng p'ẹkọma ch'Họr.<verse eid="GEN 36:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 36:22" />Wa ajinọngva p'Lotan made: Hori ọttara Homam. Timna wọ uwa ode ọgbaanọkka kw'Lotan k'ẹpanọng.<verse eid="GEN 36:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 36:23" />Wa ajinọngva p'Shobal obhonọ made: Alvan, ọmaana Manahat, ọmaana Ebal, ọmaana Shepho, ọttara Ọnam.<verse eid="GEN 36:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 36:24" />Wa Zibeọn obhonọ ajinọngva afa, p'ade Aiya, ọttara Ana. Ana nwa wọ uwa oze nkeka s'asi pẹ akọm-ọkọm, za ch'uwa ọd-ọnang nnyanya s'Zibeọn kw'ode otte ọchattọhk z'ibyi s'owora.<verse eid="GEN 36:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 36:25" />Wa Ana obhonọ Dishọn ọttara ominanwa kw'okpen Oholibama.<verse eid="GEN 36:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 36:26" />Dishọn wa obhonọ ajinọngva p'akpen Hemdan, ọmaana Ẹshban, ọmaana Itiran, ọttara Keran.<verse eid="GEN 36:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 36:27" />Ajinọngva p'Ẹzẹr ade: Bilhan, ọmaana Zaavan ọttara Akan.<verse eid="GEN 36:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 36:28" />Ajinọngva p'Dishan made: Uz, ọttara Aran.<verse eid="GEN 36:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="GEN 36:29" />Avaar p'ẹkọma ch'Họr wa made: Lotan, ọmaana Shobal, ọmaana Zibeọn, ọmaana Ana, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />ọmaana Dishọn, ọmaana Ẹzẹr, ọttara Dishan. Bẹ bọ uwa ade avaarnọng p'ab'Họr, atorọ k'nkwurọ sabẹ ny'Seir.<verse eid="GEN 36:30" /></para>
  <para style="s">Avaar p'abaabh ẹkọma ch'Edom</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Ma wọ ode avaar p'uwa achi eden abaabha Edom, pira wa Israẹl noning-oninga oyena abaabh:<verse eid="GEN 36:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="GEN 36:32" />Bẹla kw'ode ojinọngnwa kw'Beor wọ uwa ode ọvaarnọng kw'Edom. Ebhondim chẹ ekpen Dinhaba.<verse eid="GEN 36:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="GEN 36:33" />Bẹla ope nya, Jobab kw'ode ojinọngnwa kw'Zẹra kw'ofon Bozra okwu ode ọvaarnọng.<verse eid="GEN 36:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34" />Jobab ope nya, Husham kw'ofon Teman okwu ode ọvaarnọng.<verse eid="GEN 36:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35" />Husham ope nya, Hadad kw'ode ojinọngnwa kw'Bẹdad, kw'uwa okem Midiyan z'ẹkọma ch'Moab, okwu ode ọvaarnọng. Wa ebhondim chẹ ekpen Avit.<verse eid="GEN 36:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36" />Hadad ope nya, Samla kw'ofon Masreka okwu ode ọvaarnọng.<verse eid="GEN 36:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37" />Samla ope nya o, Shaul kw'ofon Rẹhobọt kw'ọnyọm ọraanga, okwu ode ọvaarnọng.<verse eid="GEN 36:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38" />Shaul ope nya o, Baal-Hanan kw'ode ojinọngnwa kw'Akbọ, okwu ode ọvaarnọng.<verse eid="GEN 36:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39" />Baal-Hanan, ojinọngnwa kw'Akbọ ope nya o, Hadad okwu ode ọvaarnọng. Wa ebhondim chẹ ekpen Pau, kwanọng kwẹ okpena Mehetabẹl kw'ode ominanwa kw'Matarẹd. Matarẹd wa ode nnwa kw'Me-Zahab.<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Ache p'avaar p'abin k'ẹnọmma ch'Ẹsau, atorọ k'ose kw'nkwurọ, ọmaana oruk kwabẹ ode:</para>
  <para style="li1" vid="GEN 36:40">Timna, ọmaana Alva, ọmaana Jetẹt, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />ọmaana Oholibama, ọmaana Ẹla, ọmaana Pinọn, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />ọmaana Kenaz, ọmaana Teman, ọmaana Mibzar, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />ọmaana Magdiẹl, ọttara Iram. Ma wọ ode avaarnọng p'Edom, atorọ k'ose kw'oruk kwabẹ ny'izek njo ode.</para>
  <para style="p" vid="GEN 36:43">Ẹsau nwa wọ ode otte kwiden kw'anọng p'ẹkọma ch'Edom.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">Ọdachen f'Josẹph ọttaar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Wa Jekọb orukọ z'Kenaan, za ch'iwa otte ikk'oruka.<verse eid="GEN 37:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />Ma wọ ode ose kw'ọmaan Jekọb, ọmaana ẹsọhmmọr chẹ.</para>
  <para style="p" vid="GEN 37:2">Ny'ogbe nwo, wa Josẹph ode icho ichikkamfa. Wa kẹ od-otor iva p'Bilha, ọmaana p'Zilpa p'ade ivotte pẹ, mad-akkerẹ etirakpo py'otte. Kẹ wa ọd-ọpọhra ayok ọnang otte.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />Ny'iva p'Jekọb obhonọ maphyir, wa Josẹph wọ ọdaak-ẹ ọtam, okurọ ch'obhon-ẹ k'atam. Ofona nya o, okwum-ẹ ọnọhma kw'osi ase. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Ch'ivotte mboza maze bẹ́, Josẹph ọdaakẹ otte ọtam, mawun-ẹ maa, m'ọkkọkka kad-agbaak amaan-ẹ.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />K'ogbe wanẹ, Josẹph ọttaara idachen, ọtọka otek ivotte pẹ, osi bẹ matera adẹ-ẹ awun-owuna. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />Josẹph oben bẹ bẹ́, “Màyonga itọhng bhaanga idachen s'ntaar. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Z'idachen, moning z'owonọ nd-ọdaabh abarli-ke. Minna kw'ẹbarli-ke chaam ebin ebe-obe, pira abarli-ke pabọnga nabira abina abe, makọbha ndo chaam, mabira araka nso anang-ẹ.”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Ivotte abhaang nya o, mapọhn-ẹ bẹ́, “Nya kọ nachibhẹ bẹ́, kọ m'abaabha mina yirẹ? Ma, mina mmin'oninga izek-izek kwọ yirẹ?” Minna kw'madẹ-ẹ awun-owuna okurọ idachen sẹ, ọmaana idik sẹ.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Wa Josẹph obira okwu ọttaara idachen ọdọk-ọdọk, otek ivotte bẹ́, “Màyong-m itọhng, mbira nttaara idachen e. Mọkpanda, nttaar ch'ewuchen, ọmaana ophe, ọmaana ndidorọ ijobh kawanẹ id-irak nso inang-m.”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />K'ogbe kw'Josẹph otek otte idachen njo, otte ọkwọhr-ẹ ẹmọng, ọpọhn-ẹ bẹ́, “Bọng-idachense s'attaar ma? Oyinẹ bẹ́, akka, ọmaana kaam, ọttara ivotte, mm'okwu ọraka nso ọnang kọ o?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Wa ivotte ayen ottemma amaan-ẹ, okenaka, otte oye odik nwo z'ettem.<verse eid="GEN 37:11" /></para>
  <para style="s">Ivotte p'Josẹph makpẹ-ẹ anang aphyanọng p'Ishmayẹl</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />K'ogbe wanẹ, ivotte p'Josẹph matima etirakpo py'otte mad-anang bẹ azizaarẹ za ch'ọnyọm Shẹkẹm. <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />Israẹl oyerẹ Josẹph oben-ẹ bẹ́, “Kọ azong ma bẹ́, ivotte atim etirakpo ad-anang azizaarẹ za ch'ọnyọm Shẹkẹm. Kwu ntọhm-ọ akebha bẹ za.”</para>
  <para style="p" vid="GEN 37:13">Josẹph ọpọhn-ẹ bẹ́, “Atte, kirẹ kaam ma.”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />Nya o, oben-ẹ bẹ́, “Zọhng baana óde ivotte ọmaana etirakpo maning za k'ọkkọkka, akwu atek-m.” Minna kw'oning ny'ilokodo s'Hẹbrọn ọtọhm-ẹ za.</para>
  <para style="p" vid="GEN 37:14">Ch'Josẹph kk'opyira z'Shẹkẹm, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />ojinọng wanẹ ọzẹ-ẹ nya ch'od-ottena ny'owonọ wanẹ, ọbọbh-ẹ bẹ́, “Ad-aror mbọng?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Josẹph ọpọhn-ẹ bẹ́, “Nd-nnor ivotte paam e. Ma, azong ibyi s'maning anang etirakpo azizaarẹ ma yirẹ?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Ojinọng nwo ọpọhn-ẹ bẹ́, “Nkk'abina ma e. Wura mmaang ch'mad-aben bẹ́, mm'achina z'Dọtan.”</para>
  <para style="p" vid="GEN 37:17">Nya o, Josẹph okebh ivotte pẹ za ch'ọnyọm Dọtan. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />K'ose kw'mazẹ-ẹ za ch'od-okwu-okwu, pira okwu opyirẹ nya, nkk'attọhna bẹ́, mafhẹ-ẹ.<verse eid="GEN 37:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19" />Maben ayok bẹ́, “Ọttaar-ọdachen nwo okwuma ka! <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Makwu mọfhẹ-ẹ ọbharẹ k'esipe danẹ ma ch'edung-odung, moben bẹ́, ẹgbaten-tama danẹ dọ ẹbọk-ẹ ẹyaakẹ k'akpa-k'akpa, mfha moze ose kw'ọdachen fẹ im'oyin-ẹ k'eden.”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Reubẹn ọbhaang nya o, ọkaam-ẹ z'ayok k'mbọhk, oben bẹ bẹ́, “Tte moning-ẹ ofhufhọ ọfhọ. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Tte ọnọng oning izẹ okibhẹ. Tte motera ọtọk-ẹ ọbharẹ k'esipe danẹ ch'edung-odung m'ibyi s'anọng nna arukọ.” Wa Reubẹn ọd-ọgbaak minna, ọfha ọkkaan-ẹ, ọtọk-ẹ ochena otte.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Ch'Josẹph opyirẹ nya ch'ivotte maning, mabọk-ẹ awọra ọnọhma-baba ọkkọkka nwo kwẹ, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />pira nnatọk-ẹ abharẹ z'esipe ch'edung-odung. Wa asi ny'epe ndo kade.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />K'ogbe kw'nkk'ẹwọr aninga bẹ́, machi ọttọhk, matinẹ ichen aze ẹkaan ch'aphyanọng p'Ishimayẹl p'abin z'Gilead. Nkk'ẹchattọhk-kpo py'elebhẹ eruk, ọmaana ina s'ifor s'ilebhẹ eruk, adabha k'akamẹl bẹ́, matima azeng z'Ijip.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />Juda oben ivotte pẹ bẹ́, “Ma, bọng-ọttọhk vọ im'ode iru samina óde m'ọfhọ agbaanatte kwamina mobubha odik nwo? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Tte motera ọkpẹ-ẹ ọnang anọng mba p'Ishimayẹl. Mba kẹ obir ode agbaanatte kwamina, kw'izẹ majanẹ isi mina.” Ivotte machera amaan-ẹ.<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />K'ogbe kw'aphyanọng mbo p'Ishimayẹl, p'abir ade anọng p'Midiyan, mmin'akpan, ivotte p'Josẹph marọhbh-ẹ z'esipe ndo, makpẹ-ẹ anang aphyanọng mbo k'ashẹkẹl p'silva ẹrọbh. Aphyanọng mbo matim-ẹ azeng z'Ijip.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />K'ogbe kw'Reubẹn ọkpa nnam ny'epe ndo, ọdọk Josẹph nya koze, ọyaakẹ ekpo py'ọfọr ny'ifor. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Ofona od-otek ivotte bẹ́, “Nnwa nwo ọdọk za kode. Ma min'nsi yen?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Minna kw'mafhọ evu, matọka ọnọhma-baba kw'Josẹph alọhbh ny'ivu-zẹ njo. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />Matima ọnọhma-baba nwo kw'osi ase ad-akọhka otte. Maben otte bẹ́, “Kirẹ ọttọhk f'moze e. Baana, óde ọnọhma kw'nnwa kwọ wọ.”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Otte otin ọnọhma nwo oben bẹ́, “K'odik ọkkọkka, ọnọhma kw'nnwa kwaam wọ ma! Oyinẹ bẹ́, ẹgbaten-tama danẹ kk'ẹ ẹyaaka k'akpa-k'akpa.”<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Minna kw'Jekọb ọyaakẹ ekpo py'ọfọr z'ifor ọbharẹ, ọfọra akpobina otima obhom nnwa kwẹ k'iwu k'ẹkaan. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Ajinọngva ọttara panọngva pẹ maphyir makwu afok-ẹ nttem. Oben bẹ bẹ́, “Màtte-m ọbọhk. Kaam m'nchina ororo mbhom nnwa kwaam maa, mpe ntor-ẹ.”<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Anọng mbo p'Midiyan mapyirẹ z'Ijip, makpe Josẹph anang Pọtipha kw'ode osonọng wanẹ kw'Phero, obira ode oso kw'anọng p'ad-akkerẹ Phero.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">Juda ọmaana Tamar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Wa ny'ogbe nwo, Juda obin orik ivọkka pẹ ofona, od-oninga ọmaana ojinọng wanẹ kw'okpen Hira, kw'ofon Adulam. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />K'ose kw'opyirẹ za o, okebha ominanwa wanẹ kw'oKenaannọng kw'okpen Shua, ọtọk-ẹ k'ọbada. Minna kw'oyim ọmaan-ẹ, <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />otima ibhọr ọmaan ojinọngnwa kw'makpẹ-ẹ Ẹr.<verse eid="GEN 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 38:4" />Obira otima ibhọr ọmaan ojinọngnwa, ọkpẹ-ẹ Ọnan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Okwu ọmaan ojinọngnwa kw'ottong attaan, ọkpẹ-ẹ Shẹla. Wa ọmaan-ẹ ch'otim oning z'Kezib.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Wa Juda ọtọk kwanọng kw'okpen Tamar, ọnang Ẹr kw'ode ochedennwa kwẹ k'ọbada. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Okenaka, Ẹr kw'ode ochedennwa kw'Juda wa osi ẹyaaka k'ititika s'Ọvaar Ibinọkpaabyi. Ofona nya, Ọvaar Ibinọkpaabyi ọtọka akpen pẹ.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Nya o, Juda oben Ọnan bẹ́, “Zọhng yima maana kwanọng kw'agbaanakka, k'ose kw'ẹmmaana chamina ede, ofha ọmaan iva ọnang agbaanakka kwọ.” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Okenaka, ch'Ọnan ozong bẹ́, iva mbo m'iva pẹ màde, kẹ od-obyenga adima z'izek, k'ogbe kpenamkpen kw'oyim ọmaana kwanọng kw'ọgbaanọkka, mfha oning iva obhonọ ọnang ọgbaanọkka. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Ọttọhk mvo f'osi nya, opyibhẹ mawuriji z'Ọvaar Ibinọkpaabyi k'ititika. Ofona nya, Ọvaar Ibinọkpaabyi obira ọtọka akpen pẹ.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Juda okwu oben Tamar kw'ode kwanọng kw'nnwa kwẹ bẹ́, “Kpa nnam z'atte k'ọsọhm mach'opokwa, aninga za atik maa, Shẹla kw'ode ojinọngnwa kwaam ọbar.” Ọgbaak odik nwo okurọ ch'ojor-ẹ bẹ́, Shẹla m'obira ope mach'ivọkka pẹ mad-ape. Ofona nya o, Tamar obina od-oruk z'otte k'ọsọhm.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Ogbe obhirẹ nya o, kwanọng kw'Juda kw'ode nnwa kw'Shua, ope. K'ogbe kw'Juda kk'kwanọng kwẹ obhoma maa, ọsẹ-ẹ z'ettem, otima Hira kw'ode oyok-odikkobh kw'ofon Adulam, ochina z'Timna, za ch'mad-aphyirẹ arọkimaan pẹ iphyabha.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Magbaak Tamar bẹ́, “Otte kw'odim ochin z'Timna bẹ́, od-ophyirẹ arọkimaan pẹ iphyabha e.” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />Tamar ọwọra abarabina p'ọfọr, otima ọbaranwa obubha ititika, pira od-oninga ẹwọr nya ch'mad-azenga adim ny'obhon kw'mayerẹ Ẹnayim, kw'oning ny'eden ch'nd-azenga achina z'Timna. Osi minna okurọ ch'oze bẹ́, Shẹla kk'ọbara opyirẹ k'edimba, okenaka, nkacher bẹ́, matọk-ẹ anang-ẹ k'ọbada.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Juda ọzẹ-ẹ nya, ọsẹ-ẹ bẹ́, ọzaza wọ, okurọ ch'obubh ititika sẹ.<verse eid="GEN 38:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 38:16" />Okebh-ẹ nya adenkonga, oben-ẹ bẹ́, “Kwu nyima mmaan-ọ.” Kẹ kozong bẹ́, kwanọng kw'nnwa kwẹ wọ. Kwanọng nwo ọbọbh-ẹ bẹ́, “Manang-m mbọng, óde nyim mmaan-ọ?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />Kẹ ọpọhn-ẹ bẹ́, “Kaam m'nrọhbha ovunwa wanẹ ny'avu paam, ntọhm nnang-ọ.” Kwanọng nwo ọpọhn-ẹ bẹ́, “Ina abhik-m ọttọhk vanẹ, pira atọhm ovunwa nwo achen-m?”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Juda ọbọbh-ẹ bẹ́, “Bọng-ọttọhk vọ f'm'mbhik-ọ?” Tamar ọpọhn-ẹ bẹ́, “Ẹbaanga ch'ẹnọhna ch'etim ebhora chọ, ọttara ochikwura kw'atim ny'ọbọhk.” Juda ọtọka pyẹ maphyir ọnang-ẹ, oyima ọmaan-ẹ, ọkẹ-ẹ ibhọr.<verse eid="GEN 38:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 38:19" />K'ogbe kw'Tamar obin ofona, ọd-ọwọra ọbaranwa nwo, ọfọra abarabina pẹ.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />Juda okwu ọtọhm Hira kw'ode oyok-odikkobh kwẹ kw'ofon Adulam bẹ́, ochena kwanọng nwo ovunwa nwo, ọfha ọtọka ekpo py'obhik-ẹ ochen-ẹ. Okenaka, kwanọng nwo koze. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Ọbọbh ajinọng p'arukọ nya bẹ́, “Ọzazakwanọng nwo kw'od-oninga m'adenkonga p'Ẹnayim kẹ o?”</para>
  <para style="p" vid="GEN 38:21">Mapọhn-ẹ bẹ́, “Ọzazakwanọng kpenamkpen ma otima od-oninga e.”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Minna kw'ọkpa nnam od-otek Juda bẹ́, “Kaam kẹ kinze. Ajinọng p'arukọ nya ater atek-m bẹ́, ọzazakwanọng kpenamkpen nya otima od-oninga.”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Juda o, oben bẹ́, “Ttẹ-ẹ ọbọhk otima ekpo mbyo, kinnorọ bẹ́, anọng amma mina asa. Mba kk'aza bẹ́, kk'ọ ovunwa nnanga bẹ́, achen-ẹ, okenaka, kẹ kaze.”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Opyirẹ ọttọhk k'aphe attaan nya o, matek Juda bẹ́, “Tamar kw'ode kwanọng kw'nnwa kwọ nod-osi ẹzazamaana. Madidaanma, kk'ibhọr otima.”</para>
  <para style="p" vid="GEN 38:24">Juda oben bẹ́, “Màtim-ẹ yin k'iyaan, mfha makwọm-ẹ maa, ope!”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />K'ose kw'mad-atim-ẹ ayinẹ k'iyaan o, ọtọhm ẹkkaabha ọnang otte kw'odim bẹ́, “Ojinọng kw'oyen ekpo mbya wọ oke-m ibhọr e. Kkerẹ, ode im'akpo atin ọnọng kw'oyen ẹbaanga nda ch'ẹnọhna, ọmaana ọttọhk f'ẹdọngọ f'otim ebhora, ọttara ochikwura nwa.”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />Juda okwu otin ekpo mbyo, oben bẹ́, “Kẹ wọ otorọ ọtam ọyọhnga kaam, ch'ina kẹ ntọk nnang nnwa kwaam Shẹla k'ọbada.” Juda o, ọdọk kẹ ábẹ̀ koyim.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Okwu opyirẹ k'ogbe kw'im'ọmaan, maze bẹ́, ajinọngva afa bọ aning-ẹ z'ẹbhọr. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Nya ch'imin'ọmaan, ọbọhk kw'oyok wanẹ oyin k'iyaan, okker-ọmaan otima edik-kora ọkpẹ-ẹ ny'ẹbọhkdọngọ, oben bẹ́, “Nwoma wọ ochi eden oyin.” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />Okenaka, nnwa nwo ọtọr ọbọhk kwẹ odim z'ẹtaanga, ọgbaanọkka ochi eden oyin. Okker-ọmaan nwo oben bẹ́, “Minna kw'azeng ayin o!” Ofona nya, makpẹ-ẹ Pẹrẹz<note caller="+" style="f"><char style="fr" closed="false">38.29 </char><char style="fq" closed="false">Pẹrẹz </char><char style="ft" closed="false">oyinẹ bẹ́, ose kw'ozeng oyin.</char></note>. <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />Ogbe kobhirẹ, ọgbaanọkka obira oyin ttara edik-kora ny'ọbọhk, makpẹ-ẹ Zẹra<note caller="+" style="f"><char style="fr" closed="false">38.30 </char><char style="fq" closed="false">Zẹra </char><char style="ft" closed="false">oyinẹ bẹ́, okorọ ọnna-ọnna.</char></note>.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">Josẹph ọmaana kwanọng kw'Pọtipha</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Ny'ogbe nwa, anọng p'Ishimayẹl nkk'Josẹph atima achina z'Ijip, makpẹ-ẹ anang oJipnọng kw'okpen Pọtipha, kw'ode osonọng wanẹ kw'Phero, obira ode oso kw'anọng p'ad-akkerẹ Phero.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />Ch'iwa Josẹph orukọ ọmaana atte nwo z'Ijip, Ọvaar Ibinọkpaabyi oning ọmaan-ẹ, osi idik ijibh inang-ẹ. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Pọtipha oze bẹ́, Ọvaar Ibinọkpaabyi oning ọmaana Josẹph, ọttọhk kpenamkpen f'ọsi ojibh ọnang-ẹ, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />nya o, Josẹph okwu ọdaak-ẹ idik maa, osok-ẹ mach'ọtọhmnọng kwẹ oyenẹ. Pọtipha ọtọka ẹsọhmmọr chẹ, ọttara ọttọhk kpenamkpen f'oyen ọkẹ-ẹ ny'mbọhk bẹ́, okkerẹ. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Tọma ny'ogbe kw'Pọtipha otte ẹsọhmmọr chẹ ọbọhk ọnang Josẹph, Ọvaar Ibinọkpaabyi ozeng Josẹph ábẹ̀, odo ẹsọhmmọr ch'Pọtipha ọmaana oyena kwẹ maphyir maa, ozeng z'owonọ kwẹ. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Ofona nya, Pọtipha otte oyena kwẹ ọbọhk maphyir, oke Josẹph k'mbọhk, ettem kọyọhnọ k'ọttohk kpenamkpen, kw'ọkpanẹ ọchattọhk f'im'ochi.</para>
  <para style="p" vid="GEN 39:6">Kẹ Josẹph wa ofu k'ifor <char style="it">bẹ́ gbuk</char> obira ojibh ojinọng. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Ogbe kobhirẹ, kwanọng kw'otte ọtọm-ẹ adaakẹ-chen okkikkerẹ, oben-ẹ bẹ́, “Kwu yim-m ábẹ̀!”<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Josẹph obhum. Oben-ẹ bẹ́, “Mma e, atte kw'nrukọ ábẹ̀ ọdọk achibhẹ pẹ maphyir-phyir k'ẹsọhmkpo pyẹ koyik. Kk'pyẹ maphyir ọtọka oke-m k'mbọhk bẹ́, nkkerẹ. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Ọnọng kw'oyen ẹfa ọyọhng-m m'ọsọhm nwa kode. Atte kwaam kaam ọttọhk kpenamkpen m'ọsọhm nwa kọchọn, kw'ọkpanẹ kọ kwanọng kwẹ. Kayen kw'kaam m'nsi itama, ọmaana epyibhase ndo z'ititika s'Ibinọkpaabyi o?” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />Chibhẹ ch'ọyak-ẹ odik k'ewu k'ewu, Josẹph kocher bẹ́, oyima ọmaan-ẹ. Kobir ochera bẹ́, ọnyọm-ẹ k'ifor.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />Ewu danẹ, Josẹph odim z'ọsọhm bẹ́, od-osi ọtọhm fẹ. Ny'ewu ndo, ayok-atọhmnọng pẹ nya kade. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Kwanọng nwo okwu ọbọka Josẹph ny'ẹbarakpa ch'ọpaabh, oben-ẹ bẹ́, “Kwu yim-m ábẹ̀!” Josẹph ọrọbh oyin z'iyaan, orik ẹbarakpa chẹ ny'mbọhk s'kwanọng nwo.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />K'ogbe kw'kwanọng nwo oze bẹ́, Josẹph kk'ọrọbha orik ẹbarakpa chẹ ny'ikẹ k'mbọhk oyin z'iyaan, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />oyerẹ atọhmnọng pẹ, oben bẹ bẹ́, “Makirẹ oHiburu-nọng nwa e! Matim-ẹ akwu ma bẹ́, olukọ mina e! Kẹ odimẹ okebh-m z'ọsọhm ẹtaanga bẹ́, oyim-m ábẹ̀, okenaka, mbok ẹmọng k'ẹrọng. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Ọbhaang-m ch'nd-mbok ẹmọng k'ẹrọng nya o, ọrọbh oyin k'iyaan, orik ẹbarakpa chẹ m'kaam k'mbọhk.”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Kwanọng nwo osok ẹbarakpa ndo maa, otte kw'Josẹph okwuna. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Ọtọka odik nwo ọgbaak-ẹ bẹ́, “OHiburu-nọng nwoma kw'asokọ m'ọsọhm, ọkamẹ bẹ́, oyim-m ábẹ̀ k'ẹfa. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Mbok ẹmọng k'ẹrọng nya o, ọrọbh oyin k'iyaan, orik ẹbarakpa chẹ m'kaam k'mbọhk.”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />K'ogbe kw'otte kw'Josẹph ọbhaang odik kw'kwanọng kwẹ ọgbaakẹ nya, ettem epyibh-ẹ mawuriji, ch'kwanọng kwẹ obenẹ bẹ́, “Minna wọ kw'obira kwọ, osi-m e.” <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Ofona nya, ọnang ẹfa bẹ́, make Josẹph mgbakkọhbhọ, masok-ẹ za ch'agbakkọhbhinọng p'ọvaar Phero, aning.</para>
  <para style="p" vid="GEN 39:20">Chibhẹ ch'Josẹph oning ny'mgbakkọhbhọ, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />wa Ọvaar Ibinọkpaabyi, ochin ororo oninga ọmaan-ẹ, osi ọphyaam ọnang-ẹ, obira osi okker-agbakkọhbhinọng oyena ọdaakẹ ọmaan-ẹ. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Minna kw'okker-agbakkọhbhinọng ọtọk agbakkọhbhinọng maphyir oke Josẹph k'mbọhk, obir ọsẹ-ẹ oso kw'ọttọhk okpenamkpen f'oyinẹ nya. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Okker-agbakkọhbhinọng nwo ọrọhbha ichen k'idik maphyir s'ining Josẹph k'mbọhk, okurọ ch'Ọvaar Ibinọkpaabyi oning ọmaana Josẹph, obira osi idik ijibh inang-ẹ.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">Josẹph osi ẹyaakẹ ch'ọdachen f'agbakkọhbhinọng</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />K'ogbe wanẹ, ọtọhmnọng kw'ọd-ọnang ọvaar Phero kw'Ijip atuk, ọmaana oyok kw'od-osi ọchattọhk ọnang-ẹ, mapinẹ otte kwabẹ. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Phero okwu ọdọk-ẹ ọmaana aso mbo afa, p'ade oso kw'anọng p'ad-anang ọvaarnọng atuk, ọmaana oso kw'anọng p'ad-asi brẹd anang ọvaarnọng. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />Ọtọka bẹ ọd-ọgbak z'ọgbakkọhbhisọhm kw'odidennọng kw'akker-agbakkọhbhinọng, za ch'iwa magbakẹ Josẹph. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Odidennọng kw'ọgbakkọhbhisọhm nwo ọtọka bẹ ọnang Josẹph bẹ́, okkerẹ bẹ.</para>
  <para style="p" vid="GEN 40:4">Ch'nkk'aninga ny'ọgbakkọhbhiter k'ogbe, <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />k'orungiwu wanẹ, oyok nwo kw'ọd-ọnang ọvaarnọng atuk, ọmaana oyok kw'od-osi ọchattọhk, mattaara ọdachen. Idachen kpenamkpen iyen ẹyaakẹ chẹ.<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />Ch'Josẹph okwu ọbaana bẹ ch'ewu kk'esobha, oze bẹ́, nttem iyakẹ bẹ odik. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Ofona nya, ọbọbh bẹ bẹ́, “Ode yen kw'mad-akkerẹ mach'ọttọhk ọyakẹ bọnga odik o?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Mapọhn-ẹ bẹ́, “Chena k'erungọ, mina anọng afa, ọnọng-ọnọng ọttaar idachen sẹ. Okenaka, m'ọnọng koze kw'osi ẹyaakẹ ch'ọdachen mvo.”</para>
  <para style="p" vid="GEN 40:8">Josẹph ọpọhna bẹ bẹ́, “Mazonga bẹ́, Ibinọkpaabyi wọ ọd-ọyaakẹ ọdachen ọnang anọng. Màtek-m ọdachen f'mattaar.”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Nya o, oso kw'anọng p'ad-anang Phero atuk otek Josẹph idachen sẹ bẹ́, “Nttaar, ch'nze echi ch'grep ch'ebe-m ny'ititika. <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />Echi ndo eyen abọhnga attaan. K'ose kw'abọhnga mbo mayinẹ, minna kw'esi agbok, ẹwọm achiduk p'makorọ ny'eninga ndo. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Minna kw'ntim ibhok s'Phero ny'ọbọhk, mmyana achiduk mbo nke nya, pira n'ntọk nke Phero ny'ọbọhk.”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />Josẹph oben-ẹ bẹ́, “Achibọhnga mbo attaan, mayinẹ iwu ittaan. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Kw'oyinẹ bẹ́, iwu ittaan mọ̀kpan, Phero m'ọrọhbh-ọ ma, akpa nnam z'ọtọhm fọ k'ose kw'uwa akkikken ade. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Okenaka, kaam kàzaama k'ogbe kw'idik m'ijibh inang-ọ. Si-m ejibha agbaak odik kwaam anang Phero, ọfha ọrọhbh-m m'mgbakkọhbhọ nja. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Wa mabọk-m k'ẹfa z'izek s'aHiburu atima akwu m'obhon nwa. Ch'mbira nninga m'Ijip, itama kpenamkpen kinsi s'wura isi-m nyima mgbakkọhbhọ.”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Ọtọhmnọng kw'od-osi ọchattọhk okwu oze bẹ́, ẹyaakẹ ch'Josẹph osi k'idachen s'oyok ede ọkkọkka, kẹ oben Josẹph bẹ́, “Kaam mbira nttaara idachen e. Z'idachen, ntọhk ọkariba ọttaan f'ọchattọhk. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Z'ikariba s'ikpa nso, nkk'ẹchakpo k'akira k'akira py'Phero ayika nya, okenaka, ọnọhn f'iwokọ okebha nya osorọ otima ofona.”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />Josẹph oben-ẹ bẹ́, “Tte ntek-ọ ose kw'idachen njo iyinẹ. Ọkariba mvo ọttaan, oyinẹ iwu ittaan. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Iwu ittaan mọ̀kpan, Phero m'ọpọ-ọ eso, ọtọk-ọ orena k'echi, ọnọhn mach'attẹrẹ, m'akebha obukọ nwo nya, masorọ maphyir.”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Ny'ewu ndo ch'ettong ittaan, Phero osi odidaama kw'ẹmmaanawu chẹ ọnang atọhmnọng pẹ maphyir. Ọtọka ọtọhmnọng kw'ọd-ọnang-ẹ atuk, ọmaana oyok kw'od-osi ọchattọhk, ọkọhka atọhmnọng mboza ny'ọyaankpa. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Okwu oben ọtọhmnọng nwo kw'od-ọnang-ẹ atuk bẹ́, ọkpa nnam z'ọtọhm fẹ, <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />ọtọka oyok kw'od-osi ọchattọhk oren-ẹ edik, k'ose kw'Josẹph ikk'ẹyaakẹ ch'idachen sẹ ọsa.<verse eid="GEN 40:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23" />Chibhẹ nya, ọtọhmnọng nwo kw'ọd-ọnang Phero atuk, ọzaama Josẹph.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">Josẹph ọyaakẹ ọdachen f'Phero</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Wa k'ewu danẹ, ch'icho ifa ikk'ikpana, Phero ọttaar idachen. Ny'idachen njo, ọttaar ch'obe ny'araangakonga p'Nile, <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />oze abhaam achenọmfa p'ajibh-ojibh, mabira ade ifor <char style="it">ma dọrọdọrọ</char> p'mayinẹ ny'ẹraangattem, m'atọma azizaarẹ ochi-chi ny'araangakonga. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Obira oze ch'abhaam achenọmfa p'makok-okokọ, mabira apyibh k'ifor, mayinẹ ny'ọraanga, makwu abe atuma mboza ny'araangakonga. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Nya o, abhaam mbo p'apyibhẹ k'ifor, mabọka mboza p'ade ifor <char style="it">ma dọrọdọrọ</char> machi maphyir. Phero okwu ọphyabha k'ọda.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Phero obira oyima, ọttaara idachen ọdọk-ọdọk, oze agwu-bhọr achenọmfa p'ade ifor<char style="it">ma dọrọdọrọ</char> p'maning k'ochi mawanẹ. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Obira oze ch'agwu-bhọr achenọmfa p'akok-okokọ ayinẹ nya. Ofum kw'ofon z'ẹbhaakẹ ch'ewuchen ed-eyin, egwu bẹ k'ifor <char style="it">bẹ́ kẹkẹdẹ</char>. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Nya o, agwu-bhọr mbo p'akok-okokọ matera amyi mboza achenọmfa p'ade ifor <char style="it">ma dọrọdọrọ</char>. Phero o, okwu ọphyabha, pira notinẹ bẹ́, idachen jọ s'ọttaar nya.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Otum ny'ekpebha, ettem ẹtọm-ẹ odik oyiyak. Oyerẹ abọhnganọng ọmaana adikzonganọng p'Ijip maphyir, ọgbaak bẹ ọdachen mvo. Ọnọng kw'okpo ọdachen mvo ọyaakẹ kode.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />Nya o, oso kw'anọng p'ad-anang Phero atuk oben Phero bẹ́, “Ttatta, menda asi-m njima epinẹ chaam e. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Oyen ogbe wanẹ kw'uwa ọdọk-ọ ọmaana kaam, ọttara oso kw'anọng p'ad-anang-ọ ọchattọhk, pira atọka mina ad-agbak z'ọgbakkọhbhisọhm kw'odidennọng kw'akker-agbakkọhbhinọng. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />K'orungiwu wanẹ, mina anọng afa mọttaar ọdachen. Idachen kpenamkpen iyen ẹyaakẹ chẹ. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Wa oyen oHiburu-dikkobh kw'ode ọtọhmnọng kw'odidennọng kw'od-okkerẹ ọgbakkọhbhisọhm. Kẹ wọ kw'uwa mọgbaak ọdachen famina, pira ọyaakẹ ọnang mina. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Idik njo ikwu iyin mbengana k'ose kw'uwa ọyaakẹ ọdachen famina. Minna kw'uwa kaam mkpa nnam z'ọtọhm faam, oyok nwoza mafhẹ-ẹ arena k'echi.”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Minna kw'Phero ọtọhmọ bẹ́, mayerẹ Josẹph anang-ẹ. Mafona mad-ayerẹ Josẹph ẹbhar-ẹbhar z'ọgbakkọhbhisọhm. Ogwo ẹmma nya maphyir o, obhona ẹnya chẹ, pira okwu obe Phero k'ititika.<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />Josẹph okwu nya, Phero oben-ẹ bẹ́, “Nttaara idachen e. Ọnọng kw'okpo ẹyaakẹ osi ọnang-m kode. Okenaka, nkk'aam ateka bẹ́, óde ọnọng ọttaar idachen ọgbaak-ọ, ad-asi ẹyaakẹ anang-ẹ.”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />Josẹph ọpọhna Phero bẹ́, “Kaam ẹfase ndo kinyen. Ibinọkpaabyi wọ im'osi ẹyaakẹ ọkkọkka ch'idachen njo ọnang-ọ.”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Nya o, Phero oben Josẹph bẹ́, “Nttaar ch'mbe ny'araangakonga p'Nile, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />nze ch'abhaam achenọmfa p'ade ifor <char style="it">ma dọrọdọrọ</char> mayinẹ ny'ọraanga, mad-achi azizaarẹ ny'araangakonga. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Ogbe kobhirẹ, abhaam achenọmfa p'akkok-okkokọ, mabira apyibh k'ifor mayin ny'ọraanga ọdọk. Ch'obobe ode, ẹbhaam ch'epyibhẹ k'ifor mach'abhaam mba ntima nd-nza m'Ijip. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Abhaam mbo p'akkok-okkokọ mabira apyibh k'ifor, mabina akwu achi abhaam mboza achenọmfa p'ajibhẹ k'ifor p'achi eden ayin. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Chibhẹ ch'nkk'ayok p'ajibhẹ k'ifor acha, matima apyibhẹ ifor mach'makkikken ade. Minna kw'nkwu mgbe mphyabha.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />“Mbir nyim nya, nttaara ch'nze agwu-bhọr achenọmfa p'ajibh-ojibh, p'abin k'ochi mawanẹ. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Pira agwu-bhọr achenọmfa p'achamẹ ifor mayin. Ofum kw'ofon z'ẹbhaakẹ ch'ewuchen ed-eyin, esi bẹ mayọhna. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Nya o, agwu-bhọr mbo p'acham-ọchamẹ, mamyi mboza achenọmfa p'majibh-ojibh. Ntek anọng p'ad-asi mbọn ọdachen mva, ọnọng kw'okpo ẹyaakẹ osi ọnang-m kode.”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Josẹph oben Phero bẹ́, “Ọdachen mvo ọfa oyinẹ ose mawanẹ. K'odik ọkkọkka, Ibinọkpaabyi kk'ẹyaakẹ ọsa ọnang-ọ k'ọttọhk f'im'osi. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Abhaam mbo achenọmfa p'ajibh-ojibh, ọmaana agwu-bhọr p'abira ajibh-ojibh, mayinẹ ocho ochenọmfa. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Abhaam mbo achenọmfa p'akpong nnam ayin, p'apyibh-opyibh, mabira akkok-okkokọ, mayinẹ icho ichenọmfa s'okwo fiden. Agwu-bhọr mbo achenọmfa p'ofum kw'ofon za ch'ewuchen ed-eyin, magwu k'ifor, mabira ayin icho ichenọmfa s'okwo fiden.<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />“Ttatta, ode k'ose kw'mgbaak-ọ nya bẹ́, Ibinọkpaabyi kk'ọ ọttọhk ọkọhka f'ọkamẹ bẹ́, m'osi. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />K'icho ichenọmfa, ẹkọma ch'Ijip maphyir m'eyena ọchattọhk f'ọsaabh-ọsaabh. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />Ó̱gbe nwo ọkpanẹ nya, okwo fiden m'okwu m'izek s'Ijip k'icho ichenọmfa. M'ọgaangẹ maa, anọng m'azaama nyọm njoza s'ọchattọhk olor-olorọ. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Okwo mvo m'ọgaangẹ minna maa, anọng m'ọdọk ogbe kw'ochi-chi màjima. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />K'odik ọkkọkka, pira attaara ọdachen mva igbedim ifa, Ibinọkpaabyi kk'ọttọhk ophyika f'im'osi. Ogbe mòbhir, m'osi-osi.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />“Madidanma, tte Phero oror ọnọng kw'oyen ezonga ọmaana ekkoji, ọnang-ẹ ẹfa ch'im'okkerẹ izek s'Ijip maphyir. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Tte Phero obir ọrọhbha adidennọng ny'obhon, p'mm'ad-akebh ipha s'Ijip k'ibyi ichen, matọka igboka janẹ aye k'ẹyọm kpenamkpen ny'ocho mvo ochenọmfa f'ọchattọhk m'olor-olorọ. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Tte matobha ẹchakpo maphyir py'mm'ayena ny'ocho mvo f'm'okwu f'ọchattọhk m'olor-olorọ, m'aye z'ibhondim, k'ẹfa Phero. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Mm'aye ẹchakpo mbyo, m'anang anọng z'ogbe kw'ocho f'owora im'okwu ny'Ijip, mfha anọng aning ape k'okwo.”<verse eid="GEN 41:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Achibhẹ mbo makwu adaakẹ Phero ọmaana anọng p'otim ọbaabha obhon. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />Ofona nya, Phero ọbọbh bẹ bẹ́, “Ma, anyi wọ kw'mm'oze kw'ode mach'ojinọng nwoma, kw'oyen egwugwuma ch'Ibinọkpaabyi yirẹ?”<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Nya o, Phero oben Josẹph bẹ́, “Ch'Ibinọkpaabyi kk'ẹyaakẹ ch'idik nja maphyir ọsa ọnang-ọ, oyinẹ bẹ́, ọnọng kw'oyen ekkoji ọmaana ezonga mach'ikọ kode. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Kaam kk'ọ nrọhbha bẹ́, ade osonọng kw'ọvaardimpa kwaam. Anọng paam maphyir m'akpobha ọgbaakadik kwọ. Ikpukpobha s'ẹvaar chaam dẹ-dẹ im'ikọhka bẹ́, kaam mbarẹ nyọhng-ọ.”<verse eid="GEN 41:40" /></para>
  <para style="s">Manang Josẹph ediden z'Ijip</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />Phero ochina ororo oben Josẹph bẹ́, “Tọma menda, kk'ọ ẹfa nnanga bẹ́, abaabha Ijip maphyir.”<verse eid="GEN 41:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 41:42" />Phero ọwọra ẹvaarbaanga z'ẹnọhna chẹ, oke Josẹph, ọsẹ-ẹ ọfaang kw'ojibh-ojibh, pira nọkẹ-ẹ ọmaan f'gol ny'ẹdọngọ. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Ọtọk-ẹ ọnana k'ọkpaar kwẹ kw'nnyanya id-itọr, mach'odukwa kwẹ. Anọng mad-akwọrọ k'ẹrọng bẹ́, “Màbhong-ẹ eden o!” Minna kw'Phero ozeng ọnang Josẹph ediden ch'Ijip maphyir.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />Phero obir oben Josẹph bẹ́, “Kaam Phero wọ nde ọvaarnọng, okenaka, ọgbaakadik kwọ wọ im'ọbaabha ọttọhk kpenamkpen f'ọnọng osi m'Ijip.” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />Phero okpe Josẹph bẹ́, Zaphenat-Panea, obira ọnang-ẹ ominanwa kw'okpen Asenat k'ọbada, kw'otte kwẹ okpen Potiphera, ọfọhn-nja kw'On.</para>
  <para style="p" vid="GEN 41:45">Josẹph obina, od-osi ọtọhm fẹ, ozenga ọbaana Ijip maphyir.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />Wa Josẹph ode icho ẹrọbh okwuma ijobh ny'ogbe nwo kw'ọtọm ọtọhm osisi ọmaana Phero kw'ode ọvaarnọng kw'Ijip maphyir. Josẹph obina orik Phero, ọkpaanga Ijip maphyir. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Ny'ocho mvo ochenọmfa f'ochi-chi, wa izek ijibhẹ ekpo mawuriji. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Josẹph otobha ẹchakpo py'mapha ny'nyọm ọkkọkka njo ichenọmfa ny'Ijip, od-oye z'ibhondim. Wa od-oye ọchattọhk f'obhon kpenamkpen otor k'ọchattọhk f'matubhọ anyọma ny'obhon nwo. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Wa Josẹph oye agwu p'asaabhẹ mach'offong kw'ọraanga. Wa masaabhẹ maa, m'ọdọk obhik fabẹ kazong.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Pira wa ocho f'okwo fiden okwu, wa Josẹph kk'ajinọngva afa obhona k'ikwanọng kwẹ, kw'ode Asenat, nnwa kw'Potiphera, ọfọhn-nja kw'On. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Wa Josẹph okpe ochedennwa kwẹ bẹ́, Manasẹ<note caller="+" style="f"><char style="fr" closed="false">41.51 </char><char style="fq" closed="false">Manasẹ </char><char style="ft" closed="false">k'eHiburu oyinẹ ọttọhk mach'Ibinọkpaabyi kk'ọsa nzaama.</char></note>, oben bẹ́, “K'odik ọkkọkka, Ibinọkpaabyi kk'aam ọsa bẹ́, nzaama irem saam, ọttara echimma ch'atte kwaam.” <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Josẹph okpe ojinọngnwa kw'ottong afa Ephraim<note caller="+" style="f"><char style="fr" closed="false">41.52 </char><char style="fq" closed="false">Ephraim </char><char style="ft" closed="false">k'eHiburu oyinẹ ọttọhk mach'iva obhubhon.</char></note>, oben bẹ́, “Ibinọkpaabyi kk'aam ọsa nyena iva m'izek nja s'ntọk irem.”<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Nya o, ocho mvo ochenọmfa f'ochi-chi ny'Ijip okwu ọkpọka, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />ocho ochenọmfa f'owora ọtọma, mbengana k'ose kw'uwa Josẹph ikk'ọgbaaka. Wa ọchattọhk oworọ mawuriji z'nkọma njoza maphyir. Z'Ijip kẹ-kẹ kw'uwa ọchattọhk ọsaabh-ọsaabh. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />K'ogbe kw'ọchattọhk ọtọm owuwor ny'Ijip, okwo fiden ọtọma anọng okikaama, minna kw'mabhomọ akpẹkẹ Phero. Ofona nya, Phero oben bẹ bẹ́, “Màzọhng kebha Josẹph za, màsi k'ose kw'obenẹ bọnga.”<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />K'ogbe kw'uwa okwo kk'ọgaanga maa, ọnyaamẹ ny'Ijip maphyir, Josẹph ogwunga isọhm njo s'iwa maye ẹchakpo, okpe fẹ ọnang anọng p'Ijip. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Wa anọng mad-abina z'nkọma ọdọk-ọdọk makwu ny'Ijip, madebh ọchattọhk ny'Josẹph k'mbọhk, okurọ bẹ́, wa okwo okem ẹgaanga k'ibyi kpenamkpen.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">Ivotte p'Josẹph ata z'Ijip</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />K'ogbe kw'Jekọb ọbhaang bẹ́, ọchattọhk oning z'Ijip, oben iva pẹ bẹ́, “Ode yen kw'mad-aninga ma akkerẹ ayok minna?” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Obir obenẹ bẹ bẹ́, “Mmaang bẹ́, ọchattọhk oning z'Ijip. Màzọhng debh tima kwu, ọfha moning ope k'okwo.”<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Nya o, ivotte p'Josẹph anọng ijobh, mabina bẹ́, mad-adebh ọchattọhk z'Ijip. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Wa Jekọb kocher bẹ́, Bẹnjamin kw'ode ọgbaanọkka kw'Josẹph, otor ayok, okurọ ch'ojor-ẹ bẹ́, odiktama oning ch'oyinẹ ọmaan-ẹ za. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Wa iva p'Jekọb attar k'anọng p'achin z'Ijip bẹ́, mad-adebh ọchattohk, okurọ bẹ́, wa okwo mvo ọnyaamẹ maa, opyirẹ z'Kenaan.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />Wa ny'ogbe nwo, Josẹph notim ediden ny'Ijip, od-okpe ọchattọhk ọnang anọng. Ivotte pẹ apyirẹ nya o, maraka attima nso z'izek anang-ẹ. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Josẹph oze ivotte pẹ nya o, otin bẹ, okenaka, osi mach'ina bẹ ozong. Otima ẹfa-ẹfa ọbọbh bẹ bẹ́, “Mafon memma?”</para>
  <para style="p" vid="GEN 42:7">Mapọhn-ẹ bẹ́, “Mobin z'obhon kw'Kenaan bẹ́, mokwu odebh ọchattọhk.”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Chibhẹ ch'Josẹph ikk'ivotte otina, bẹ m'kẹ katinẹ. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Nya o, okwu ojima ọdachen f'iwa ọttaar ọmaana bẹ. Pira oben bẹ bẹ́, “Bọnga made anọng p'makwu bẹ́, mabaana ibyi s'obhon kwamina otte eje.”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Mapọhn-ẹ bẹ́, “Mma o, atte! Atọhmnọng pọ akwu bẹ́, makwu adebh ọchattọhk e. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Atte mawanẹ wọ obhonọ mina. Mina moyen ẹmmaana ọkkọkka. M'obhon obubaana kokwu.”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Josẹph oben bẹ bẹ́, “Masi afọra! Makwu bẹ́, mabaana ibyi s'obhon kwamina otte eje.”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />Mapọhna Josẹph bẹ́, “Ttatta, mina atọhmnọng pọ mode nso ijobh kkamfa kw'atte mawanẹ obhonọ mina z'obhon kw'Kenaan. Okpongannam kwamina oning za ọmaana atte kwamina, oyok wanẹ ọdọk k'akpen kode.”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />Josẹph ochina ororo oben bẹ bẹ́, “K'odik ọkkọkka, makwu bẹ́, makwu abaana ibyi s'obhon kwamina otte eje! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />M'nnang bọnga eyoma. Eyoma ede bẹ́, k'eche ch'Phero, bọnga m'ibyi màta, oyebẹ okpongannam kwabọnga kk'ọkwa ma. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Màtọhm ọnọng wanẹ ma, ọd-ọtọka okpongannam kwabọnga otima okwu; bọnga ayok mboza, mm'aninga m'ọgbakkọhbhisọhm, ọfha mozonga óde magbaak odik ọkkọkka. Ó̱de mágbaak afọra, k'eche ch'Phero, mm'ozonga bẹ́, makwu bẹ́, mabaana obhon kwamina!” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />Ọtọka bẹ osok z'ọgbakkọhbhisọhm k'iwu ittaan.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />Ottong iwu ittaan nya o, Josẹph obenẹ bẹ bẹ́, “Kaam nyen ojora f'Ibinọkpaabyi. Màsi ọttọhk f'ntekẹ bọnga bẹ́, masi, mfha maruk akpen. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Ó̱de bọnga mad-agbaak odik ọkkọkka, tte ọnọng wanẹ kwabọnga oninga m'ọgbakkọhbhiter, ayok mboza atima ọchattọhk achena ayok p'okwo oning za ọkaam z'oter. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Màtima okpongannam kwabọnga chen-m, ọfha nze óde magbaak odik ọkkọkka, mfha maning ape.” Bẹ machera, masi k'ose kw'obenẹ bẹ.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Mabhakẹ aben ayok bẹ́, “K'odik ọkkọkka, irem s'mọd-ọtọka ma, ifon k'itama s'iwa mosi ọnang agbaanatte kwamina. Chibhẹ ch'iwa okwukọ mina, m'ikẹ itọhng koyong.”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />Reubẹn ọpọhna bẹ bẹ́, “Wa ntekẹ bọnga bẹ́, maning nnwa nwo itama asi. M'kaam itọhng kayong! Ma, node ogbe kw'mm'otuk izẹ sẹ s'mokibhẹ.” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />Wa bẹ nkazong bẹ́, Josẹph ọbhaang bẹ za, okurọ bẹ́, wa od-otima ọnọng osi ẹyaakẹ k'ebhon ch'od-otima ọgbaak odik ọnang bẹ.<verse eid="GEN 42:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 42:24" />Josẹph ọbhakẹ ititika okkerẹ z'okwubha, ọsọrọ asen. K'ogbe kw'ikẹ ottona, obira ọkpa nnam ọgbaak odik ọmaana bẹ. Ọnang anọng pẹ ẹfa bẹ́, mabọka Simeọn adabh-ẹ ndik ny'abẹ k'ititika.<verse eid="GEN 42:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Josẹph ọnang atọhmnọng pẹ ẹfa bẹ́, make ọchattọhk z'abẹ k'mkpa, mabira ake bẹ akpuka mbo p'matim akwu adebh ọchattọhk z'mkpa, mabira anang bẹ ọchattọhk f'mm'achi z'eden. Ch'nkk'asa minna o, <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />matọka ọchattọhk mvo madabh z'nnyanya sabẹ, mabhana.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Mápyirẹ ny'ibyi s'mm'abhing ch'ewu ikk'ẹpya, oyok wanẹ ọchaarẹ ẹkpa chẹ, ọfha ọnang ẹnyanya chẹ ọchattọhk, oze akpuka pẹ ny'ẹkpamma. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Oben ayok bẹ́, “Nkk'akpuka paam anwọhnga anang-m e. Kirẹ bẹ m'kaam k'ẹkpa e!”</para>
  <para style="p" vid="GEN 42:28">Nttem irọbh. Mabọbh ayok bẹ́, “Ma, bọng-ọttọhk-kira f'Ibinọkpaabyi osi ọnang mina ma o?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Mápyirẹ z'Kenaan, makebha otte Jekọb, matek-ẹ idik maphyir s'iyinẹ ikebha bẹ. Maben-ẹ bẹ́, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“Ọnọng kw'ọbaabh ẹkọma ch'Ijip ọgbaak odik akkaam-akkaam ọmaana mina, obira ọtọka mina mach'anọng p'makwu obhon obubaana. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Mina motek-ẹ bẹ́, ‘Mina moyen ẹmmaana ọkkọkka, m'obhon obubaana kokwu. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Wa mode iva ijobh kkamfa p'atte mawanẹ obhonọ, wanẹ ọdọk kode, okpongannam oning za ọmaana atte kwamina z'Kenaan.’<verse eid="GEN 42:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33" />“Ọnọng nwo kw'otim ediden ch'Ijip oben mina bẹ́, ‘Eden ch'im'ntima nzonga óde bọnga made anọng ọkkọkka ede bẹ́, màtte agbaanatte wanẹ kwabọnga ọbọhk nang-m, bọnga màtọka ọchattọhk chena ẹsọhmmọr chabọnga ch'eyim okwo. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Okenaka, màtima okpongannam nwo kwabọnga chen-m, ọfha ntima nzonga bẹ́, made anọng ọkkọkka, m'obhon obubaana kakwu. Ṉ́kk'asa minna, kaam m'ntte agbaanatte kwabọnga ọbọhk nnang bọnga, mbira ntte bọnga ọbọhk mazenga mphya m'izek nja.’ ”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />K'ogbe kw'nnad-awonga mkpa sabẹ, ọnọng-ọnọng oze bẹ́, okpuka kw'otim od-odebh ọchattọhk oning za. K'ose kw'otte ọmaana bẹ maze akpuka mbo ny'mkpa njo, ojora ọbọka bẹ. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Jekọb kw'ode otte kwabẹ, oben bẹ bẹ́, “Bọnga nkk'aam asa ngwaana iva paam maphyir. Josẹph ọdọk kode, Simeọn ọdọk kode. Ma, nna abira akwu bẹ́, matima Bẹnjamin afona. Kaam wọ ma kw'iyagbin ikpẹkẹ o!”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Reubẹn oben otte bẹ́, “Tte Bẹnjamin ọbọhk nang-m. Ó̱de ina kẹ ntim mkpa nnam nchen-ọ, fhọ ajinọngva paam afa.”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />Jekọb ochina ororo oben bẹ́, “Kaam Bẹnjamin ọbọhk mìntte otor bọnga. Ọgbaanọkka kwẹ kk'ọpa, orik kẹ-kẹ. Ó̱de itama iyinẹ imaan-ẹ ny'ozenga nwo, m'isi-m mpe k'atam mmaana isen k'ettem.”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">Ivotte p'Josẹph atim Bẹnjamin akpa nnam z'Ijip</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />M'ogbe nwa, okwo f'ọgaang-ọgaangẹ otim oning z'Kenaan. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />K'ogbe kw'Israẹl ọmaana ẹsọhmmọr chẹ nkk'ọchattọhk f'madebhẹ z'Ijip acha maphyir, otte oben bẹ bẹ́, “Màbira kpa nnam z'Ijip zọhng debh ọchattọhk tima kwu.”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Juda oben otte bẹ́, “Ojinọng nwo ọtọhrọ mina itọhng bẹ́, m'ọdọk ititika sẹ moze, oye bẹ́, motim agbaanatte nwoza kwamina okwu. <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Ó̱de ácher, atte agbaanatte kwamina ọbọhk otor mina, mm'od-odebh ọchattọhk ochen-ọ. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Okenaka, óde ina kẹ ọbọhk atte otor mina, m'ọdọk nnam za mọ̀kpa, okurọ bẹ́, ojinọng nwo kk'mina obena bẹ́, m'ọdọk ititika sẹ moze, oye bẹ́, motim agbaanatte nwoza kwamina, okwu.”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Jekọb, kw'obir okpena Israẹl, ọbọbh bẹ bẹ́, “Ode yen kw'make-m odikse nwa k'ẹdọngọ? Osempira matek ojinọng nwo bẹ́, bọnga mayen agbaanatte ọdọk-ọdọk ka?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Mapọhn-ẹ bẹ́, “Ojinọng nwo, ọsak ifor ọbọbh mina idik s'imaan ẹsọhmmọr chamina bẹ́, ‘Ma, atte kwabọnga otim orukọ akpen za? Ma, mayen agbaanatte ọdọk-ọdọk za?’ Mina mọpọhn-ẹ ambuma mbo maphyir. Yen kw'wura mina mozong bẹ́, kẹ m'oben mina bẹ́, ‘Màtima agbaanatte nwoza kwabọnga kwu’?”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Nya o, Juda oben bẹ́, “Tte nnwa nwa ọbọhk nang-m mọtọn ofona, mfha okwo oning kọ ọmaana mina, ọttara iva pamina ọfhọ. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Kaam nnwọhngọ nnang-ọ bẹ́, ọttọhk kẹ mòsi. Ó̱de ina kẹ ntim nkwuna, kaam wọ kw'm'agbana. Tte mgbar ibira ide saam ttattampe. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Wúra ńna ogbe oter okibhẹ ma, wura nkk'igbedim ifa ọta okwuna.”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Ofona nya o, otte kwabẹ Israẹl oben bẹ bẹ́, “Ó̱de ode minna, màtọka ekpo byanẹ py'ejibh-ojibh py'efon m'izek nja mach'ana p'ẹchọkọ, ọmaana akọhnsi biribirẹ, ọmaana ana p'alebh eruk, ọmaana myrrh, ọmaana nkọbh s'mayerẹ kashu, ọttara achiduk p'almọn, yika z'mkpa, mfha mápyirẹ za, manang ojinọng nwo mach'ẹnanga. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Màtọka asilva p'asaabhẹ ayọhnga mbo p'wendo oyik ny'abọnga k'mkpa, chen-ẹ. Ṉ́nòsi, wendo mapin-opinẹ. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Màbir tima agbaanatte kwabọnga ọdọk, kpa nnam z'ojinọng nwo. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Tte Ibinọkpaabyi kw'Ẹfa maphyir osi ojinọng nwo oyena ikwosisi ọmaana bọnga, otte agbaanatte nwoza, ọmaana Bẹnjamin ọbọhk, mator bọnga makwuna. Ṉ́nòde kaam, óde iva mbo paam adim-m, oyinẹ bẹ́, nkk'aam adima.”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Minna kw'ajinọng mbo atọk nnanga njo ọmaana asilva p'ade igbedim ifa p'uwa bẹ matim, ttara Bẹnjamin, maduk-oduka mafona achina z'Ijip, mad-akebha Josẹph za.<verse eid="GEN 43:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 43:16" />K'ogbe kw'Josẹph oze Bẹnjamin ttara bẹ, oben ọtọhmnọng kwẹ bẹ́, “Tima anọng mba china z'kaam k'ọsọhm, afhọ eten atima asi ọchattọhk, okurọ bẹ́, bẹ mm'achi ọttọhk amaan-m m'ẹya.”<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />Ojinọng nwo osi k'ose kw'Josẹph obenẹ, otima ivotte mbo ochina z'Josẹph k'ọsọhm. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />K'ose kw'mapyirẹ ny'ọsọhm kw'Jọsẹph, ojora osi bẹ, machibhẹ bẹ́, “Ṉ́nosi matim mina akwu ma okurọ asilva p'wendo mayik z'amina k'mkpa k'ochedengbe kw'mokwu. Ma, ọd-ọkam bẹ́, ọna mina nnyanya samina, obira otima mina osi abira pẹ yirẹ?”<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Nya o, mazenga akebha ọtọhmnọng kw'Josẹph ny'ẹsọhmma, maben-ẹ bẹ́, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />“Ototo, atte, wendo mokwu odebh ọchattọhk ma k'ochedengbe. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />K'ogbe kw'mọsak k'ibyi janẹ bẹ́, mobhing nya okurọ ch'ewu ikk'ẹpya, ch'nnowong mkpa samina, moze okpuka-bhikse mawanẹ k'ẹkpamma ch'ọnọng-ọnọng. Nkk'akpuka mbo otima ọkpa nnam. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />M'ọnọng kozong kw'ọtọk akpuka mbo oyika z'amina k'mkpa. Nkk'akpuka ọdọk-ọdọk otima okwu ma bẹ́, modebh ọchattọhk.”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />Ọtọhmnọng nwo oben bẹ bẹ́, “Oning bọnga ojor, odik kode. Ibinọkpaabyi kwabọnga, kw'ode Ibinọkpaabyi kw'uwa ab'atte akpobh, kẹ wọ oke akpuka mbo z'abọnga k'mkpa. Kaam wendo kk'akpuka pabọnga ntọka.” Minna kw'ọd-ọtọka Simeọn ochen bẹ.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />Ọtọhmnọng nwo otima bẹ ochina z'Josẹph k'ọsọhm, ọnang bẹ asi p'mm'atim agbobhọ mmo, obira ọnang nnyanya sabẹ ọchattọhk. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Bẹ mado ifor mabira atobha nnanga sabẹ, atima atik Josẹph ch'im'okwuna ny'ẹya, okurọ ch'nkk'abhaanga bẹ́, mm'aninga nya achi ọttọhk.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />Josẹph okwun nya o, manang-ẹ nnanga njo s'matim, mabira araka nso anang-ẹ. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Josẹph ọbọbh bẹ bẹ́, “Osi bọnga yen? Atte nwo kwabọnga kw'ikk'ọtama, kw'wendo magbaak-m odik kwẹ, otim oning akpen za o?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Mapọhn-ẹ bẹ́, “Ọtọhmnọng kwọ, kw'ode atte kwamina, otim oning akpen za k'ofor-gaangẹ.” Minna kw'marak nso, mabir atto ayima z'izek, manang-ẹ ikpukpobha.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />K'ose kw'Josẹph otinẹ ichen, oze ọgbaanọkka Bẹnjamin, ọbọbh bẹ bẹ́, “Agbaanatte nwo kwabọnga kw'ikarẹ kw'wendo mad-aben wọ ma o?” Oben Bẹnjamin bẹ́, “Nnwa kwaam, tte Ibinọkpaabyi osi ọphyaam ọnang-ọ.”<verse eid="GEN 43:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 43:30" />Josẹph oze ọgbaanọkka nya o, okwo ọsẹ-ẹ z'ettem maa, obina orik bẹ nya, ọd-ọsọhrọ asen z'idongọ sẹ.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />Obin nya o, oruma ititika, ọbọka ettem, okebh bẹ za, oben bẹ́, “Màbera ọchattọhk.”<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />Manang Josẹph ọchattọhk fẹ nkọmẹ, manang ivotte pẹ ọchattọhk fabẹ nkọmẹ, mabira anang anọng mbo p'Ijip p'aning amaana bẹ nya nkọmẹ. K'ẹmaana ch'anọng p'Ijip, ode ẹpaanga bẹ́, oJipnọng ochi ọttọhk k'ibyi majanẹ ọmaana oHiburu-nọng. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Wa ivotte mbo aning ẹwọr ny'Josẹph k'ititika ator k'ose kw'ọgbọ kwabẹ ode, tọma k'ocheden maa, pyirẹ k'okpongannam. Pira nnad-abhakẹ akkerẹ ayok, okkonọ bẹ okkonọ. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />K'ogbe kw'makebh ọchattọhk f'obin z'Josẹph k'okpokkoro anang ivotte pẹ, okebh f'Bẹnjamin otim igbedim ichen ọyọhnga f'ayok. Minna kw'masi odidaama, mabira anyaana ifor agwu atuk amaana Josẹph.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">Josẹph ọnang ivotte pẹ eyoma</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Nya o, Josẹph oben ọtọhmnọng kwẹ bẹ́, “Tọka ọchattọhk f'ọsaabh-ọsaabh ke anọng mbo ny'mkpa sabẹ k'ose kw'mm'akpo atọhka. Abira ayika asilva p'ọnọng-ọnọng ny'ẹkpamma chẹ. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Akwu atọka ọkkọbh kwaam kw'ode silva ayika ny'ẹkpa ch'oyok kw'ikarẹ, ọttara asilva pẹ p'otim odebh ọchattọhk.” Ọtọhmnọng nwo, osi k'ose kw'Josẹph obenẹ.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />K'ose kw'ewu esobh, ny'ekpikpebha, matọhm ajinọng mba k'eden ọmaana nnyanya sabẹ, mafona. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Ogbe kobhirẹ, Josẹph oben ọtọhmnọng kwẹ bẹ́, “Sẹr-ọsẹr kwubh anọng mbo z'eden. Ó̱de ákebh bẹ, ben bẹ bẹ́, ‘Ó̱de yen kw'matim epyibha atera ejibha ch'masi anang bọnga o? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Ọkkọbh kw'atte kwaam od-otima ogwo asi, obira od-otima ọbharẹ ọsẹ zang ma? Ọttọhk f'masi ma, maphyir-phyir, kojibhẹ.’ ”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Ọtọhmnọng nwo okebhẹ bẹ nya o, ọgbaak odik nwo-nwo ọnang bẹ. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Mapọhn-ẹ bẹ́, “Osempira odikse nwo oyin ttatta kwamina k'ẹmma? Mina mm'osi yen osi ọttọhkse mvo? <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Mina moter otima asilva p'moze z'amina k'mkpa z'Kenaan okwu orik. Kayen kw'mina mm'ofu silva, obir ode gol kw'atte o? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Ọnọng kpenamkpen kw'maze ọkkọbh nwo z'ikẹ k'ẹkpa, m'opupe. Tte mina ayok mboka maphyir, mode abira p'atte kwọ.”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />Ọtọhmnọng nwo ọpọhn-ẹ bẹ́, “Iya, tte ode mach'mabenẹ. Ọnọng kw'mm'nzẹ ọkkọbh nwo k'ikẹ k'ẹkpa, m'ode obira kwaam. Bọnga ayok mboza, mbọhk sabọnga iwur-owur.”<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />Minna kw'ọnọng-ọnọng ọsak ẹkpa chẹ ny'izek, ọchaarẹ ẹkpamma. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Ọtọhmnọng nwo o, ọtọma ny'odidennọng kwabẹ, ogbokọ maa, opyirẹ z'oyok kw'ikarẹ. Nnaze ọkkọbh nwo z'Bẹnjamin k'ẹkpa. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Maze nya o, ivotte ayaakẹ ẹfọrakpo py'abẹ k'ifor. Matọka ntọhka sabẹ anana nnyanya, makpa nnam z'obhon kw'uwura mafon.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Wa Josẹph otim oning z'ọsọhm k'ogbe kw'Juda ọmaana ivotte mapyirẹ za. Minna kw'matto z'izek, matọma nkwukọ. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />Josẹph oben bẹ bẹ́, “Bọng-ọttọhk-kira f'masi ma? Oye bọnga nkazong bẹ́, ọnọngkira mach'kaam oze iyaan s'm'okpo ozonga odik kw'im'oyin z'ogbe ororo?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Juda ọpọhn-ẹ bẹ́, “Atte, bọng-odik kw'mm'obira ọgbaak ọdọk o? Yen kw'mm'ozenga okona ifor samina? Ibinọkpaabyi kk'itama s'mina atọhmnọng pọ ọyaaka k'ọyaankpa. Tọma menda, mina ọttara oyok nwo kw'maze ọkkọbh nwo z'kẹ k'ẹkpa, nnode abira pọ.”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />Okenaka, Josẹph oben bẹ́, “Tcha! Kaam minna mìnsi e. Ọnọng nwo kw'ofu ọkkọbh kwaam wọ im'ode obira kwaam e. Bọnga mboza maphyir, mabhana kebha atte za k'ọdaam.”<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Nya o, Juda obina okebha Josẹph, oben-ẹ bẹ́, “Ttatta, nyen odik kw'nd-nkam bẹ́, mgbaak-ọ. Ototo, oning-ọ ọdọkọ. Nzong za bẹ́, kọ ade mbengana mach'Phero. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Ttatta, k'ogbe kw'abọbh mina bẹ́, ‘Ma, bọnga mayen atte ọttara agbaanatte ọdọk-ọdọk za yirẹ?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Mọpọhn-ọ bẹ́, ‘Moyen atte kw'ikk'ọtama, ọmaana ojinọngnwa wanẹ kw'obhonọ k'atam. Wa ọgbaanọkka kwẹ kk'ọpa. Kẹ-kẹ wọ inorikẹ ch'ọkka ọmaanẹ bẹ. Kẹ ọdaak otte mawuriji.’<verse eid="GEN 44:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21" />“Nya o, aben mina atọhmnọng pọ bẹ́, ‘Màzọhng tọk-ẹ tima kwu, nzẹ-ẹ k'ichen.’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Motek kọ ttatta kwamina bẹ́, ‘Nnwa nwo, otte ọbọhk mòkpo otte. Ó̱de ọttẹ-ẹ ọbọhk, otte m'ope-ope e.’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Okenaka, aben mina atọhmnọng pọ bẹ́, ‘Oye bẹ́, agbaanatte kwabọnga kw'ikarẹ otorọ bọnga makwu ma, ọdọk bọnga otum mìnke.’ <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />K'ogbe kw'mọkpa nnam okebha atte kwamina kw'ode ọtọhmnọng kwọ za, motek-ẹ k'ose kw'kọ ttatta kwamina, agbaakẹ.<verse eid="GEN 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25" />“Minna kw'atte kwamina obenẹ mina bẹ́, ‘Mm'abira ad-adebh ọchattọhk akwu attara.’ <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />Mina moben-ẹ bẹ́, ‘Nza mokpo ọta. Ó̱de agbaanatte kwamina kw'ikarẹ otorọ mina, nya wọ kw'mm'ọta za. M'ititika s'ọnọng nwo moze, ode agbaanatte kwamina kw'ikarẹ ina mina otorọ.’<verse eid="GEN 44:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27" />“Nya o, ọtọhmnọng kwọ kw'ode atte kwaam, oben mina bẹ́, ‘Mba nkk'azonga bẹ́, kwanọng kwaam ọmaan-m ajinọngva afa bẹ-bẹ. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Oyok wanẹ ofona orik-m. Ntọka bẹ́, “Ẹgbaten-tama danẹ kk'ẹ ẹyaaka k'akpa-k'akpa.” Tọma za maa, pyirẹ ma, kẹ k'ichen kinze. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Ó̱de mabira atima oyok nwoma afona, itama iyinẹ ikebh-ẹ, m'iwọhkọ, ntima isen mpe k'atam.’<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />“Ofona nya, óde mkpa nnam nd-nkebha ọtọhmnọng kwọ kw'ode atte kwaam ch'nnwa nwo nna ọtọnọ, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />óde otte oze bẹ́, mina kotorọ mokwuna, m'ope-ope. Zonga bẹ́, mina atọhmnọng pọ mm'ọwọhkọ atte kwamina ope ọmaan isen k'ichen. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Kaam ọtọhmnọng kwọ nchekẹ nnang atte kwaam bẹ́, ‘Ó̱de kaam ina nnwa nwo ntim mkpa nnam, tte epyima ede chaam ttattampe!’<verse eid="GEN 44:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33" />“Ofona nya, nkwuk-ọ bẹ́, atte kaam ọbọhk ntera eso ch'ojinọngnwa nwo mach'obira kwọ, ọfha attẹ-ẹ ọbọhk otor ivotte mabhana. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Yen kw'm'nzenga nd-nkebha atte kwaam, óde ojinọngnwa nwo nna ọtọnọ? Mma e! Kaam akpen mìnninga nze itama s'im'ikebha atte kwaam e.”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">Josẹph ọyaakẹ ifor sẹ ọnang ivotte</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Ny'ogbe kw'Josẹph ina ọdọk ifor okpo ọbọka, oben anọng p'abe amaan-ẹ nya bẹ́, “Màrik-m obhokọ!” Ọnọng kw'uwa obir oninga ny'ogbe kw'Josẹph ọyaakẹ ifor ọnang ivotte kode.<verse eid="GEN 45:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 45:2" />Josẹph obhom ẹmọng k'ẹrọng maa, anọng p'Ijip abhaanga, anọng p'ọvaar-dimpa kw'Phero abira abhaanga.<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />Minna kw'Josẹph oben ivotte bẹ́, “Kaam Josẹph wọ e! Atte kwaam otim orukọ akpen za o?” Ivotte pẹ m'ikẹ odik nwo kakpo apọhna, okurọ opoma f'osi bẹ ny'ikẹ k'ititika.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Josẹph obir oben ivotte pẹ bẹ́, “Mazọhkọ tum-m ka.” Mazọhkọ atum-ẹ nya o, ọgbaak bẹ bẹ́, “Kaam wọ nde Josẹph, agbaanatte nwo kwabọnga kw'uwa makpe anang aphyanọng p'Ijip. <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Nttem ining bọnga odik iyakẹ, m'ayok odik kàbir aze ch'iwa makpe-m. Ibinọkpaabyi wọ oter ọtọhm-m ma bẹ́, nchi bọnga eden nkkaana akpen p'ayokinọng. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Node ocho ọfa f'okwo fiden ikk'oninga m'izek nja. K'icho ichen z'ititika, ọnọng ọttọhk mòtwubh, ọnọng ọttọhk mòbira ọpha. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Okenaka, Ọvaar Ibinọkpaabyi ọtọhm-m bẹ́, nkkikken nkwu nye bọnga ekimẹ-kimẹ m'izek, mfha bọnga ọttara iva pabọnga maruk akpen.<verse eid="GEN 45:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 45:8" />“Nya o, bọnga zang masi pira nkwu ma, Ibinọkpaabyi wọ ọtọhm-m. Kẹ wọ osi-m nde ọnọng kw'ọd-ọnang Phero ntọhna. Obira osi-m mbaabha ẹsọhmmọr chẹ, ttara anọng p'Ijip maphyir. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />Màbhana madidanma kebha atte kwaam za. Màtek-ẹ bẹ́, nnwa kwọ Josẹph obenẹ bẹ́, ‘Ọvaar Ibinọkpaabyi kk'aam oso ọsa z'Ijip, nde ọbaabh kw'Ijip maphyir. Kwu ẹbhar-ẹbhar kebh-m ka. Ogbe kàkibhẹ. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Kọ m'aruk k'ẹkọma ch'Goshẹn ch'ẹnyọm-m. M'aruk nya amaana iva pọ, ọmaana iva p'iva, ọmaana etirakpo, ọttara oyena kwọ maphyir. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Kaam m'nrọk bọnga ny'Goshẹn, okurọ bẹ́, okwo f'icho ichen okwuma z'ititika. Ini minna ode, ogbor m'ochi kọ ọmaana ẹsọhmmọr chọ, ọmaana anọng maphyir p'ade pọ.’ ”<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />Josẹph obira oben ivotte bẹ́, “Bọnga ọttara agbaanakka kwaam Bẹnjamin, nkk'aza k'odik ọkkọkka bẹ́, kaam Josẹph wọ nd-mgbaak odik ma. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Màgbaak atte kwaam ikpukpobha s'anọng p'Ijip ad-anang-m, ttara ọttọhk kpenamkpen f'nkk'aza ma. Ṉ́kk'ẹ agbaaka, màtim-ẹ ẹbhar-ẹbhar kwu ma.”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Nya o, Josẹph ọgaara ọgbaanọkka Bẹnjamin, kẹ Bẹnjamin ọbaak-ẹ ọdọk. Mabhom amọng. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Minna kw'obira otima ẹmọng ọbaaka ivotte pẹ maphyir. Nya wọ kw'ivotte, nnayen ettem, agbaak odik amaan-ẹ.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />K'ose kw'ẹgọhma epyirẹ z'Phero k'odimpa bẹ́, ivotte p'Josẹph kk'apyira ny'Ijip, ọdaam Phero oyenẹ ọmaana adukwa pẹ maphyir. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Phero oben Josẹph bẹ́, “Ben ivotte pọ, mànang nnyanya sabẹ ẹtọhka matima akpa nnam z'ẹkọma ch'Kenaan, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />màbira tima atte kwabọnga ttara isọhmmọr sabọnga achen-m. Kaam m'ntọka izek njo s'ijibh ọtam m'Ijip nnang bẹ, mfha maruk mawuriji.<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />“Kọ màbir aben bẹ bẹ́, ‘Ọttọhk f'mm'asi ode bẹ́, màtima ijaar s'ogbin m'Ijip zọhng, mad-ayika iva pabọnga, ọmaana panọng pabọnga, ọttara atte kwabọnga, màtima bẹ akwu. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />M'nttem z'oyena kwabọnga kàyika, okurọ bẹ́, ọttọhk kpenamkpen f'ojibhẹ ọtam m'Ijip, m'ode fabọnga.’ ”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Iva p'Israẹl asi k'ose kw'matọhnọ bẹ. Josẹph osi k'ose kw'Phero ikk'ẹ obena, ọnang bẹ ijaar, obira ọnangẹ bẹ ọchattọhk f'mm'achi z'eden. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Ọnang ọnọng-ọnọng ẹfọrakpo ẹbhapyẹ, ọnang Bẹnjamin ashẹkẹl arọbh ichi p'silva, ọttara ẹfọrakpo echen. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Wa Josẹph oyika ekpo ọkkọkka py'Ijip k'nnyanya-dimpe ijobh, oyika agwu k'nnyanya-pa pẹ ijobh, ttara ẹchakpo ọdọk-ọdọk, ọnang ivotte bẹ́, machena otte, k'ozenga kw'mm'asi. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />Nya o, Josẹph oben ivotte pẹ bẹ́, mazọhng! Ch'nkk'abina bẹ́ m'atọma ozenga, oben bẹ bẹ́, “M'ẹkọhr z'eden kasi o!”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Nya o, ivotte p'Josẹph mabina ny'Ijip, makpa nnam akebha otte kwabẹ z'Kenaan. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />Mapyirẹ za o, matek otte bẹ́, “Josẹph otima oruk akpen za e! Kẹ wọ node osonọng z'Ijip maphyir e.” Ettem ẹbhaaka Jekọb <char style="it">bẹ́ waa</char>, odik nwo maphyir-phyir kocher. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />K'ogbe kw'nkk'ẹ idik njo agbaaka maphyir s'Josẹph ikk'bẹ oteka, obira oze ijaar njo s'Josẹph ọtọhmọ bẹ́, mayik-ẹ atima abhana z'Ijip, ifor iphyabh-ẹ. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Ofona nya o, Jekọb oben bẹ́, “Kaam kk'nchera k'odik ọkkọkka bẹ́, nnwa kwaam Josẹph otima oning akpen za. Kaam m'nd-nzẹ-ẹ pira obo ọtọk-m.”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">Jekọb ọmaana ẹsọhmmọr chẹ machin z'Ijip</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Minna kw'Israẹl ọtọk ekpo py'oyen maphyir otima obina ozenga. Opyirẹ z'Beershẹba, ọfọhnọ nja ọnang Ibinọkpaabyi kw'uwa Isaak kw'ode otte kwẹ okpobh. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />Otum k'erungọ, Ibinọkpaabyi oyin okebh-ẹ k'ọda, oyer-ẹ bẹ́, “Jekọb! Jekọb!”</para>
  <para style="p" vid="GEN 46:2">Jekọb ọpọhna bẹ́, “Kirẹ kaam ma.”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />Ibinọkpaabyi oben-ẹ bẹ́ “Kaam wọ nde Ibinọkpaabyi, Ibinọkpaabyi kw'atte kwọ okpobh. Oning-ọ ojor bẹ achina z'Ijip, okurọ bẹ́, za wọ kw'kaam m'nsọ-ọ ade ẹkọma chiden. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Kaam m'ntim-ọ nta z'Ijip, mbira ntim-ọ mkpa nnam. Íkk'apa, Josẹph wọ im'ọnọhng-ọ.”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Nya o, Jekọb obina orik Beershẹba. Iva pẹ mayik-ẹ k'ijaar s'ogbin s'Phero ikk'ọtọhma, mabir ayika panọng pabẹ nya, ọttara iva pabẹ, mafona. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Mabira atima etirakpo pyabẹ ọmaana oyena kw'nkk'asa ny'Kenaan, ọttara ẹsọhmmọr chẹ maphyir, mazeng z'Ijip. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Minna kw'Jekọb otim ajinọngva pẹ, ọmaana iva p'iva maphyir, ọmaana iva p'panọng ọttara ẹsọhmmọr chẹ maphyir ochina z'Ijip.<verse eid="GEN 46:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Ma wọ ode ache p'ajinọngva p'Israẹl, p'uwa achin z'Ijip:</para>
  <para style="b" vid="GEN 46:8" />
  <para style="li1" vid="GEN 46:8">Reubẹn kw'ode ochedennwa kw'Jekọb.<verse eid="GEN 46:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 46:9" />Ajinọngva p'Reubẹn made:</para>
  <para style="q2" vid="GEN 46:9">Hanọk ọmaana Palu,</para>
  <para style="q2" vid="GEN 46:9">Hẹzrọn ọmaana Karmi.<verse eid="GEN 46:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10" />Ajinọngva p'Simeọn made:</para>
  <para style="q2" vid="GEN 46:10">Jemuyẹl, ọmaana Jamin, ọmaana</para>
  <para style="q2" vid="GEN 46:10">Ọhad, ọmaana Jakin, ọmaana Zoha</para>
  <para style="q2" vid="GEN 46:10">ọttara Shaul kw'ode ojinọngnwa kw'kwanọng wanẹ kw'ofon Kenaan ọmaanẹ.<verse eid="GEN 46:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 46:11" />Ajinọngva p'Lẹvi made:</para>
  <para style="li2" vid="GEN 46:11">Gershon ọmaana Kohat</para>
  <para style="li2" vid="GEN 46:11">ọttara Mẹrari.<verse eid="GEN 46:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 46:12" />Ajinọngva p'Juda made:</para>
  <para style="li2" vid="GEN 46:12">Ẹr ọmaana Ọnan ọmaana Shẹla,</para>
  <para style="li2" vid="GEN 46:12">ọmaana Pẹrẹz ọttara Zẹra.</para>
  <para style="li2" vid="GEN 46:12">(Ẹr ọttara Ọnan wa mape z'Kenaan).</para>
  <para style="li2" vid="GEN 46:12">Ajinọngva p'Pẹrẹz made:</para>
  <para style="li3" vid="GEN 46:12">Hẹzrọn ọttara Hamul.<verse eid="GEN 46:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 46:13" />Ajinọngva p'Isaka made:</para>
  <para style="li2" vid="GEN 46:13">Tola, ọmaana Pua, ọmaana Jashub,</para>
  <para style="li2" vid="GEN 46:13">ọttara Shimrọn.<verse eid="GEN 46:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 46:14" />Ajinọngva p'Zẹbulun made:</para>
  <para style="li2" vid="GEN 46:14">Sẹrẹd ọmaana Ẹlọn ọttara Jalẹl.<verse eid="GEN 46:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15" />Ma wọ ode ajinọngva p'uwa Lea ọmaanẹ ọnang Jekọb z'Padan-Aram, agbaarẹ Daina kw'ode ominanwa kwẹ abharẹ. Wa iva mba pẹ maphyir made ẹrọbh okwuma ijobh kkanttaan.<verse eid="GEN 46:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="GEN 46:16" />Ajinọngva p'Gad, wa made:</para>
  <para style="li2" vid="GEN 46:16">Ziphon, ọmaana Haggi,</para>
  <para style="li2" vid="GEN 46:16">ọmaana Shuni, ọmaana Ẹzbọn,</para>
  <para style="li2" vid="GEN 46:16">ọmaana Eri, ọmaana Arodi,</para>
  <para style="li2" vid="GEN 46:16">ọttara Areli.<verse eid="GEN 46:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 46:17" />Ajinọngva p'Asha made:</para>
  <para style="li2" vid="GEN 46:17">Imna, ọmaana Ishva,</para>
  <para style="li2" vid="GEN 46:17">ọmaana Ishvi, ọttara Beriya.</para>
  <para style="li2" vid="GEN 46:17">Sera wọ uwa ode ọgbaanọkka kwabẹ k'ẹpanọng.</para>
  <para style="li2" vid="GEN 46:17">Ajinọngva p'Beriya made:</para>
  <para style="li3" vid="GEN 46:17">Heber ọmaana Malkiyẹl.<verse eid="GEN 46:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 46:18" />Nya wọ ode ajinọngva p'uwa Zilpa ọmaanẹ ọnang Jekọb. Zilpa nwa wọ ode obira kw'uwa Laban otte ọbọhk ọnang ominanwa kwẹ, Lea. Wa iva mba ade ichi kawanẹ p'uwa Zilpa ọmaanẹ ọnang Jekọb.<verse eid="GEN 46:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />Ajinọngva p'Jekọb obhonọ k'kwanọng kwẹ Rachẹl made:</para>
  <para style="li1" vid="GEN 46:19">Josẹph ọttara Bẹnjamin. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Z'Ijip, wa Josẹph obhonọ Manasẹ ọmaana Ephraim k'kwanọng kwẹ Asenat, kw'ode ominanwa kw'Potiphera kw'ode ọfọhn-nja kw'On.<verse eid="GEN 46:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 46:21" />Ajinọngva p'Bẹnjamin made:</para>
  <para style="li2" vid="GEN 46:21">Bẹla, ọmaana Beker, ọmaana Ashbẹl, ọmaana Gera, ọmaana Naaman, ọmaana Ehi, ọmaana Rosh, ọmaana Mupim, ọmaana Hupim, ọttara Ard.<verse eid="GEN 46:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22" />Wa ajinọngva mba ade osowanẹ kw'ichi p'uwa Rachẹl ọmaanẹ ọnang Jekọb.<verse eid="GEN 46:22" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="23" style="v" sid="GEN 46:23" />Ojinọngnwa kw'uwa Dan obhonọ okpen, Hushim.<verse eid="GEN 46:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 46:24" />Ajinọngva p'Naphtali made: Jazel, ọmaana Guni, ọmaana Jezer, ọttara Shilẹm.<verse eid="GEN 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 46:25" />Ajinọngva mba achenọmfa bọ p'uwa Bilha ọmaanẹ ọnang Jekọb. Bilha ode obira kw'uwa Laban ọnang Rachẹl.<verse eid="GEN 46:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Anọng p'Jekọb maphyir p'uwa matọnọ achina z'Ijip p'ade iva p'iva pẹ, ágbaarẹ panọng p'iva pẹ abharẹ, wa made anọng arọbh attaan okwuma achadanẹ. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Kibung-kibungọ, óde attar ajinọngva afa p'uwa makkikken ammaan anang Josẹph ny'Ijip, ọnọng-bhik kw'ẹsọhmmọr ch'Jekọb ch'echin z'Ijip ode anọng arọbh attaan okwuma ijobh.<verse eid="GEN 46:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />Nya o, Jekọb ọtọhm Juda bẹ́, ochi eden ọd-ọbọbh Josẹph eden ch'echin z'Goshẹn. K'ose kw'mapyirẹ ny'ẹbhaakẹ ch'Goshẹn, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />Josẹph oben bẹ matima ijaar sẹ s'nnyanya id-itọr ayin ka, ofona od-oze otte. K'ose kw'oyiyin ny'otte k'ititika, ọbharẹ mbọhk, ọgaara otte, ọsọhrọ asen k'ogbe kw'okem ebhira.<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />Israẹl oben Josẹph bẹ́, “Iya! Obo oning ch'ọtọk-m yina, ch'ikk'achen paam ntima nze bẹ́, aruk akpen ka.”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Josẹph ọgbaak odik ọnang ivotte pẹ, ọmaana ẹsọhmmọr ch'otte maphyir, oben bẹ bẹ́, “Kaam m'nd-mgbaak Phero bẹ́, ẹsọhmmọr ch'atte kwaam, kk'ebina z'Kenaan kw'uwa marukọ, ekebh-m ka. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Bẹ made akker-arọkimaan, mabir ad-atir nten. Ofona nya, nkk'etirakpo ọmaana ọttọhk kpenamkpen f'ode fabẹ atima akwu. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Ó̱de Phero ọbọbh bọnga bẹ́, ‘Bọng-ọttọhk vọ ode ọtọhmbọhk fabọnga?’ <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />màpọhn-ẹ bẹ́, ‘Mina atọhmnọng pọ, mode akker-arọkimaan tọma k'ẹvava chamina, k'ose kw'uwa ab'atte pamina ad-asi.’ Minna kw'mm'atima atte bọnga ọbọhk maruk ny'ẹbhaakẹ ndo ch'Goshẹn, okurọ ch'akker-arọkimaan abọkọ anọng p'Ijip idik minna.”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Nya o, Josẹph obina od-otek Phero bẹ́, “Atte kwaam ọmaana ivotte paam kk'etirakpo pyabẹ ọmaana oyena kwabẹ atima abina z'Kenaan apyirẹ m'Goshẹn.” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />Josẹph ọrọhbha ivotte pẹ anọng achen, otima bẹ ọd-ọkọhka Phero.<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />Phero ọbọbh bẹ bẹ́, “Bọng-ọttọhk vọ ode ọtọhmbọhk fabọnga?”</para>
  <para style="p" vid="GEN 47:3">Mapọhn-ẹ bẹ́, “Ttatta, mina atọhmnọng pọ mode akker-arọkimaan mach'iwa ab'atte pamina ade. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Mina nkk'ọkwa ma bẹ́, moruk k'ogbe biribirẹ, okurọ bẹ́, okwo f'oning z'Kenaan okem ẹgaanga. Etirakpo pyamina ọdọk azizaarẹ keyen py'echi. Ototo, tte mina ọbọhk moruk m'Goshẹn.”<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />Phero oben Josẹph bẹ́, “Ch'atte ọmaana ivotte nkk'ọ akebha ka, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />kkerẹ izek s'ijibh-ojibh nang bẹ maruk. Izek s'Ijip ining k'ikọ k'mbọhk. Tte bẹ maruk ny'Goshẹn. Ó̱de abira azonga anọng ny'abẹ k'ottem p'otentọhm ọkaam okkunọ mawuriji, tte etirakpo pyaam ọbọhk nang bẹ makkerẹ.”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Nya o, Josẹph otima otte ọd-ọkọhka Phero. Jekọb osi Phero ittabọhng. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />Phero ọbọbh Jekọb bẹ́, “Ma, kọ ade icho iphaang o?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />Jekọb ọpọhn-ẹ bẹ́, “Kaam kk'ozenga nsa k'icho arọbh achadanẹ okwuma ijobh. Icho saam kìsaabhẹ, idik ibira igaang-m. Icho saam kipyirẹ mach'icho s'ab'ttatta paam atim asi ozenga kwabẹ.” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />Nya o, Jekọb obir osi Phero ittabọhng, pira nobin ny'ikẹ k'ititika.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Minna kw'Josẹph osi k'ose kw'Phero ikk'obena. Ọtọka izek njo s'ijibh-ọtam, z'ẹbhaakẹ ch'Rameses, ọnang otte ọmaana ivotte bẹ́, maruk. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Obira ochina ororo ọrọk otte, ọmaana ivotte, ọttara ẹsọhmmọr ch'otte maphyir. Wa ọd-ọnang bẹ ọchattọhk otor k'ose kw'obhik f'iva pabẹ ode.<verse eid="GEN 47:12" /></para>
  <para style="s">Okwo fiden otto z'Ijip</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Ny'ogbe nwo, wa ọchattọhk okem ewora ny'izek njo maphyir okurọ ch'iwa ekimẹ-kimẹ ẹyak ọbọhk ẹgaangẹ. Anọng p'Ijip ọmaana p'Kenaan mayọhna k'ifor mawuriji okurọ okwo mvo. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Josẹph otobha akpuka maphyir p'ikk'anọng p'Ijip ọttara anọng p'Kenaan ọchattọhk ọkpa, ochena Phero z'odimpa. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />K'ogbe kw'akpuka ikk'anọng p'Ijip ọmaana anọng p'Kenaan asa, anọng p'Ijip maphyir mabina akebha Josẹph, maben-ẹ bẹ́, “Atte, akpuka kk'mina asa e. Kayen kw'mm'ope m'ikọ k'ititika? Nang mina ọchattọhk! Akpuka pamina kk'asa.”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />Josẹph oben bẹ bẹ́, “Ó̱de akpuka pabọnga kk'asa, màchen-m etirakpo pyabọnga ntima nsi mmona k'ọchattọhk.” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />Minna kw'mafon ad-atọka etirakpo pyabẹ achena Josẹph, osi mmona k'ọchattọhk ọmaana nnyanya sabẹ, ọmaana arọkimaan ọttara avu pabẹ, ọmaana abhaam ọttara nnyanyava. Ọnang bẹ ọchattọhk f'machi ny'icho nwo k'mmona s'etirakpo pyabẹ.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />K'ogbe kw'icho nwo kk'ọsa, makwu akebha Josẹph ch'icho kk'ọbhaka, maben-ẹ bẹ́, “Atte, m'ọdọk kọ odik mokpo odubh. Akpuka kk'mina asa, etirakpo pyamina nede pyọ. M'ọttọhk ọdọk-ọdọk koyen kw'ọkpanẹ ifor ọttara izek samina jẹ-jẹ. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Kayen kw'm'akkerẹ mina nya mope ttara izek samina m'ikọ k'ititika? Debh mina ọttara izek samina, mfha m'oyena ọchattọhk f'mm'ochi. Mina ọmaana izek samina mm'oninga k'ebira ch'Phero. Bira nang mina akpomọma, mfha izek samina ining ilukọ.”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Minna kw'Josẹph ozeng odebh izek s'Ijip maphyir ọnang Phero. Anọng p'Ijip makpe ozek fabẹ kawanẹ-kawanẹ maa, ọsa, okurọ ch'iwa okwo ọyak ọbọhk ọgaangẹ. Izek njo ikwu ide s'Phero. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />Nya o, Josẹph osi anọng mbo made abira z'ẹkọma ch'Ijip maphyir. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Okenaka, wa Phero izek s'afọhn-nja kodebhẹ, okurọ bẹ́, wa Phero oyen okebh f'ọd-ọnang bẹ k'ogbe k'ogbe. Nya wọ osi m'izek sabẹ kakpe.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />Josẹph oben anọng mbo bẹ́, “Bọnga nkk'aza bẹ́, kk'bọnga ọttara izek sabọnga ndebha nnang Phero. Màtọka akpomọma mba zọhng gbon z'abọnga k'iwonọ. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Ṉ́kk'ipha asa, màkebh ekpo mbyo k'nkwurọ ichen, matọka ekwurọ danẹ anang Phero. Nkwurọ njoza nna, màsok k'ẹtubha, mabir asok mach'ọchattọhk f'isọhmmọr sabọnga ọttara f'iva pabọnga.”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />Bẹ maben bẹ́, “Kọ kk'akpen pamina akkaana! Tte ettem ẹdaam ttatta kwamina. Nkk'ochera bẹ́, mode abira p'Phero.”<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Minna kw'uwa Josẹph osok ọsana kw'ọmaan izek s'Ijip bẹ́, anọng min'ad-akebh ekpo py'mapha k'nkwurọ ichen, matọka ekwurọ danẹ anang Phero. Ọsana nwo otim obe za maa, pyirẹ menda. Izek bung-bungọ s'iwa ina s'Phero ide, ide izek s'afọhn-nja.<verse eid="GEN 47:26" /></para>
  <para style="s">Jekọb ophyemẹ Josẹph ọttọhk</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Minna kw'uwa anọng p'Israẹl marukọ ny'Ijip ny'ẹbhaakẹ ch'Goshẹn. Makwu ayena izek nya. Idik ijibh inang bẹ, mayena iva k'ọsaabh.<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />Wa Jekọb orukọ ny'Ijip k'icho ichi kkamfa. K'akpen pẹ kibung-kibungọ, wa orukọ icho arọbh achenọmfa okwuma achenọmfa. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />K'ogbe kw'kẹ min'ope, Jekọb oyerẹ nnwa kwẹ Josẹph, oben-ẹ bẹ́, “Ó̱de ikk'ọ idik ndaaka, si ọkkaan nwa nang-m. Yika ọbọhk kwọ m'kaam k'ntaak, chekẹ bẹ́, kọ m'asi ọphyaam anang-m, abira asi ọkkọkka anang-m bẹ́, kaam m'Ijip manọhnga. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Tin-m m'Ijip ad-anọhng-m za ch'ab'ttatta paam manọhng.”</para>
  <para style="p" vid="GEN 47:30">Josẹph ọpọhn-ẹ bẹ́, “Kaam m'nsi-osi k'ose kw'abenẹ.”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />Jekọb oben-ẹ bẹ́, “Chekẹ nang-m.” Josẹph o, ochekẹ ọnang-ẹ. Minna kw'Israẹl ọrak eso ọnana agba ny'ochikwura kwẹ, ọnang Ibinọkpaabyi ikpukpobha.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">Jekọb osi iva p'Josẹph ittabọhng</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />K'ogbe wanẹ z'ititika, matekẹ Josẹph bẹ́, “Atte kwọ ọmmẹ-ẹ ọmma.” Minna kw'Josẹph otim ajinọngva afa pẹ p'ade Manasẹ ọmaana Ephraim od-oze otte. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />Jekọb ọbhaang nya bẹ́, nnwa kwẹ Josẹph kk'ọkwa, okonga obina oninga ẹwọr ny'ebin.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />Jekọb oben Josẹph bẹ́, “Ibinọkpaabyi kw'Ẹfa maphyir oyinẹ okebh-m z'Luz, z'izek s'Kenaan, osi-m ittabọhng. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />Obira oben-m bẹ́, ‘Kaam m'nsọ-ọ asi obhon mawuriji, abira ayena iva k'ọsaabh. Iva pọ m'akwu ade ẹkọma chiden. M'mbira ntọka izek nja nnang iva p'iva pọ, mayena ttattampe.’<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />“Ofona nya, Manasẹ ọmaana Ephraim p'ade ajinọngva afa p'abhonọ m'Ijip pira nkwu ma, mm'ade iva paam, k'ose kw'Reubẹn ọmaana Simeọn made iva paam. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Iva ọdọk-ọdọk p'm'abhon, mm'ade pọ. Bẹ mm'ayena okebh ny'izek s'Manasẹ ọmaana Ephraim. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Ch'iwa mbin z'Padan-Aram d'nkwun-okwuna, ọttọhk f'osi-m okwo ode bẹ́, Rachẹl ope-m z'ẹkọma ch'Kenaan, ch'ẹnyọm Ẹphrat. Nya o, ntọk-ẹ nnọhnga nyọma ny'eden ch'echin Ẹphrat (kw'ode Bẹtẹlẹhẹm).”<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />K'ogbe kw'Jekọb oze ajinọngva p'Josẹph nya o, ọbọbh bẹ́, “Ma bọng-anọng bọ ma?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />Josẹph ọpọhn-ẹ bẹ́, “Iva paam p'Ibinọkpaabyi kk'aam ọnanga m'Ijip bọ e.”</para>
  <para style="p" vid="GEN 48:9">Jekọb oben bẹ́, “Tima bẹ kwu ọfha nsi bẹ ittabọhng.”<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />Wa Jekọb ọdọk iyaan mawuriji koze okurọ ch'ikk'ọtama. Josẹph otima ajinọngva mbo pẹ okebh-ẹ, pira Jekọb nọbaak bẹ.<verse eid="GEN 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11" />Jekọb oben Josẹph bẹ́, “Kaam ichen kinsokọ bẹ́, m'mbira nzọ-ọ, okenaka, Ibinọkpaabyi kk'ọsa bẹ́, mbira nze iva pọ ọdọk.”<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Nya o, Josẹph ọrọhbha bẹ z'ntaak s'Jekọb, ọraka eso k'ikpukpobha ọnang-ẹ. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Ọtọka Ephraim osok z'odimbọhk kwẹ, kw'ode obhurubọhk kw'Jekọb, obira ọtọka Manasẹ osok z'obhurubọhk kwẹ, kw'ode odimbọhk kw'Jekọb. Osok bẹ manyọm-ẹ z'ifor. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Jekọb ozema mbọhk sẹ, ọtọka odimbọhk kwẹ ọnana Ephraim k'eso, chibhẹ ch'ode kẹ wọ ode nnwanwa. Ọnana Manasẹ obhurubọhk kwẹ k'eso, chibhẹ ch'ode kẹ wọ ode odidennọng.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Minna kw'osi Josẹph ittabọhng, oben bẹ́,</para>
  <para style="q1" vid="GEN 48:15">“Tte Ọvaar Ibinọkpaabyi kw'ab'atte paam, Abraham ọmaana Isaak akpobh,</para>
  <para style="q1" vid="GEN 48:15">Ibinọkpaabyi nwo kw'ikk'aam okkera</para>
  <para style="q2" vid="GEN 48:15">k'akpen paam maphyir maa pyirẹ menda,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />tte ozeng-eden kw'Ibinọkpaabyi</para>
  <para style="q2" vid="GEN 48:16">kw'ikk'aam ọkkaana k'itama kpenamkpen,</para>
  <para style="q2" vid="GEN 48:16">odo iva mba.</para>
  <para style="q1" vid="GEN 48:16">Tte ofona m'ajinọngva mba,</para>
  <para style="q2" vid="GEN 48:16">eche chaam ọmaana ache p'ab'atte paam, Abraham ọmaana Isaak, akpobha achina ororo.</para>
  <para style="q1" vid="GEN 48:16">Tte m'asaabh ayọhng-ọyọhnga m'iyagbin.”<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Ch'Josẹph oze bẹ́, odimbọhk kw'otte otera ọnana Ephraim k'eso, kẹ obhem ettem, od-otinẹ ọbọhk nwo, ọnana z'Manasẹ k'eso. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />Josẹph oben otte bẹ́, “Mma e, atte. Oyok nwa wọ ode ocheden e. Kẹ kw'm'anana odimbọhk kwọ k'eso e.”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Otte obhum, oben bẹ́, “Nnwa kwaam, kaam nzong ọttọhk f'nd-nsi ma e. Nzong ma bẹ́, kwuna iva p'iva p'Manasẹ mm'ade ẹkọma, mabir ayin eche. Okenaka, ọgbaanọkka kw'ikarẹ m'oyin eche ọyọhng-ẹ, obhon fẹ m'okwu osi nkọma k'ẹkaan.” <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />Minna kw'ozeng osi bẹ ittabọhng ny'ewu ndo, oben bẹ́,</para>
  <para style="q1" vid="GEN 48:20">“Kwuna anọng p'Israẹl mm'ad-atima eche chọ asi ayok ittabọhng bẹ́,</para>
  <para style="q2" vid="GEN 48:20">‘Tte Ibinọkpaabyi ọdọ-ọ mach'Ephraim ọmaana Manasẹ.’ ”</para>
  <para style="p" vid="GEN 48:20">Minna kw'Jekọb osi Ephraim oso kw'Manasẹ.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Nya o, Israẹl oben Josẹph bẹ́, “Ebo-wu chaam kk'ẹnyọma. Ọvaar Ibinọkpaabyi m'oninga ọmaana bọnga, obira otima bọnga ọkpa nnam z'izek s'ab'ttatta pabọnga. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Ṉ́nòde kọ, mgbaarẹ ayok njẹ, nnang-ọ izek ọkkọkka njo s'agbe, s'iwa ntim ọkkangkkang ọmaana oyuk nna anọng p'Amọr.”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">Jekọb osi iva pẹ ittabọhng</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Nya o, Jekọb oyerẹ ajinọngva pẹ maphyir, oben bẹ bẹ́, “Màkwu ninga ma, ọfha mgbaak bọnga idik s'im'iyin ọmaana bọnga z'ogbe ororo.<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />“Bọnga iva p'Jekọb, màttonga ma,</para>
  <para style="q2" vid="GEN 49:2">màyonga kaam Israẹl kw'ode atte kwabọnga itọhng.<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />“Reubẹn, kọ wọ ade ochedennwa kwaam,</para>
  <para style="q2" vid="GEN 49:3">abira ade ẹfa chaam,</para>
  <para style="q1" vid="GEN 49:3">kọ wọ abir ade ẹkọhka ch'ejinọng chaam,</para>
  <para style="q2" vid="GEN 49:3">abira ayin eche k'ikpubhakka ọmaana ẹfa ayọhnga iva paam maphyir.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />K'ose kw'esi-bogada ede, minna kw'im'ode ọmaan-ọ k'akpen,</para>
  <para style="q2" vid="GEN 49:4">okurọ ch'achin z'kaam atte k'ebin,</para>
  <para style="q2" vid="GEN 49:4">alẹk-m, ayima oyok-nọng kwaam ábẹ̀.<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“Simeọn ọmaana Lẹvi made ivọkka p'ayen ẹmmaana madanẹ.</para>
  <para style="q2" vid="GEN 49:5">Akkangkkang pabẹ ade p'idik okikibhẹ.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Tte nning ẹkaan chabẹ ntorọ,</para>
  <para style="q2" vid="GEN 49:6">tte nning k'ekwurọ chabẹ nttar,</para>
  <para style="q1" vid="GEN 49:6">okurọ bẹ́, bẹ nkk'ottempyibha kwabẹ atima afhọ anọng saabhada,</para>
  <para style="q2" vid="GEN 49:6">mabira asi etirakpo ẹyaaka, mabọka pyẹ agbana k'ose kw'ọdaakẹ bẹ.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Tte opyibh ọnang ottempyibha kwabẹ,</para>
  <para style="q2" vid="GEN 49:7">ọmaana akkaamiji pabẹ!</para>
  <para style="q1" vid="GEN 49:7">Kaam m'mfurọ bẹ ny'ẹkọma ch'Jekọb,</para>
  <para style="q2" vid="GEN 49:7">mm'araamẹ z'ẹkọma ch'Israẹl.<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />“Ṉ́nòde Juda, ivotte pọ m'atọhng-ọ mawuriji;</para>
  <para style="q2" vid="GEN 49:8">kọ m'arima awawunanọng pọ, akema bẹ.</para>
  <para style="q2" vid="GEN 49:8">Ivotte pọ maphyir, m'araka eso anang-ọ.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Kọ nnwa kwaam Juda, ade mach'oche-dim</para>
  <para style="q2" vid="GEN 49:9">kw'okwun za ch'ọd-ọbọka ayok-nten ochi,</para>
  <para style="q1" vid="GEN 49:9">mach'eche ẹd-ẹbaam maa, ẹkpẹ z'izek,</para>
  <para style="q2" vid="GEN 49:9">mach'oche-kwa ode, ọnọng oning za kw'im'okpo ọmyaan-ẹ yirẹ?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Ẹvaar ny'Juda mèbina,</para>
  <para style="q2" vid="GEN 49:10">ẹvaarchi ny'ntaak sẹ mèbira ẹrọbha,</para>
  <para style="q1" vid="GEN 49:10">maa, etto k'ọnọng kw'ẹbaan.</para>
  <para style="q2" vid="GEN 49:10">Nkọma maphyir m'iraka eso inang-ọ.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Kẹ m'ọgbana ẹnyanya chẹ k'echi ch'grep,</para>
  <para style="q2" vid="GEN 49:11">m'ọgbana ọnyanyanwa kwẹ k'echi-bọhnga ch'ẹdaak-ẹ;</para>
  <para style="q1" vid="GEN 49:11">m'od-otima atuk ogbobhọ ọbara fẹ,</para>
  <para style="q2" vid="GEN 49:11">obira otima asi p'grep ogbobhọ anọhma-baba pẹ.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />Kẹ m'ọgaangẹ ichen, ọyọhnga etuk-kpan,</para>
  <para style="q2" vid="GEN 49:12">asa pẹ m'awur ayọhnga abasi.<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“Zẹbulun, m'osi oruk kwẹ z'akonga p'ọraanga kwiden,</para>
  <para style="q2" vid="GEN 49:13">ẹka chẹ m'ebir ede obhon kw'akkaara-kpaar m'asaka akwoka ọwọhng.</para>
  <para style="q2" vid="GEN 49:13">Enem chẹ m'etima maa epyirẹ z'ẹbhaakẹ ch'Sidon.<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“Isaka ọgaangẹ mach'ẹnyanya ch'eyen ẹfa,</para>
  <para style="q2" vid="GEN 49:14">ch'eyim k'njeka kw'mkpa s'ẹtọhka efu z'ẹtaanga.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />K'ogbe kw'oze ose kw'iwọhngkwoka-byi ijibhẹ,</para>
  <para style="q2" vid="GEN 49:15">ọmaana ose kw'izek sẹ ibir idaam eninga,</para>
  <para style="q1" vid="GEN 49:15">ọraka ebubang chẹ ọtọhka ẹtọhka,</para>
  <para style="q2" vid="GEN 49:15">obir ochera bẹ́, m'osi ọfa-ọtọhm mach'obira.<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />“Dan, m'ode ọkpaar-aponga kw'im'ọbaabha anọng pẹ k'eden ọkkọkka</para>
  <para style="q2" vid="GEN 49:16">k'efonamma danẹ ch'Israẹl.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />Dan m'ojora mach'ijọhk s'ining k'adenkonga,</para>
  <para style="q2" vid="GEN 49:17">m'ode mach'ititaama</para>
  <para style="q1" vid="GEN 49:17">s'im'igaakẹ ẹnyanya ny'abhokọrọ,</para>
  <para style="q2" vid="GEN 49:17">ọfha ọyaar-ẹnyanya ndo otto abherekpa-afa z'izek.<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“O Ọvaar Ibinọkpaabyi, kaam nning ntik ẹnaanga chọ.<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“Ẹkaan ch'arurubha m'erima Gad ábẹ̀,</para>
  <para style="q2" vid="GEN 49:19">okenaka, kẹ m'omuma bẹ ekpo ny'abhokọrọ ch'mmad-arọbh.<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“Asha m'oyena ọchattọhk ọkkọkka k'ọsaabh,</para>
  <para style="q2" vid="GEN 49:20">m'obera ọchattọhk f'm'ọbaana bẹ́, avaar mad-achi.<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“Naphtali ode mach'ochimẹ kw'magbur edik ozenga k'ikẹ k'ifor,</para>
  <para style="q2" vid="GEN 49:21">mach'ochimẹ-kwa kw'ọmaan achimẹva p'ajibh-ojibh.<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“Josẹph ode mach'echi ch'ẹd-ẹwọm aduk p'grep</para>
  <para style="q2" vid="GEN 49:22">ch'emenẹ k'akeka-konga,</para>
  <para style="q2" vid="GEN 49:22">ẹsaabh abọhnga mawuriji.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Akkikkaama atim ottempyibha arim-ẹ ábẹ̀,</para>
  <para style="q2" vid="GEN 49:23">matima iwawuna attẹ-ẹ.<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />Odo oyuk kwẹ otima,</para>
  <para style="q2" vid="GEN 49:24">mbọhk kẹ kilebhẹ,</para>
  <para style="q1" vid="GEN 49:24">ofona k'Ọvaar Ibinọkpaabyi kw'Jekọb, kẹ kw'oyen ẹfa,</para>
  <para style="q2" vid="GEN 49:24">kẹ kw'ode Okker-arọkimaan kw'Israẹl, obir ode Ẹtakpa ch'Israẹl.<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />Ibinọkpaabyi kw'atte kwọ okpobh wọ ọd-ọkkaan-ọ,</para>
  <para style="q2" vid="GEN 49:25">Tte Ibinọkpaabyi kw'Ẹfa maphyir ọdọ-ọ,</para>
  <para style="q1" vid="GEN 49:25">tte otima ẹda ch'efon z'ẹrọng ọdọ-ọ,</para>
  <para style="q2" vid="GEN 49:25">ọmaana ẹda ch'ening z'izek ẹtaanga,</para>
  <para style="q2" vid="GEN 49:25">ọmaana ẹda ch'ọmmaan osisi ọttara ch'ẹba.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />Nda s'atte kwọ iyọhng nda s'agbe p'ẹtama,</para>
  <para style="q1" vid="GEN 49:26">ibir isaabh iyọhnga ekpo ọkkọkka py'agbe p'ẹtama.</para>
  <para style="q2" vid="GEN 49:26">Tte nda nja maphyir, inana Josẹph ny'eso, ọmaana ny'akwukwungọ, kẹ kw'node oso kw'ivotte pẹ.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“Bẹnjamin ode ochenyang</para>
  <para style="q2" vid="GEN 49:27">kw'ochi ayok-nten; k'ekpebha ochi bẹ,</para>
  <para style="q2" vid="GEN 49:27">k'ẹsọhka, ochi bẹ kibung-kibungọ.”<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Ajinọngva mba maphyir bọ masi mfona ijobh kkamfa s'Israẹl. Idik s'otte ọgbaak bẹ k'ogbe kw'osi ọnọng-ọnọng ittabọhng s'ibaan-ẹ jọ ma.<verse eid="GEN 49:28" /></para>
  <para style="s">Obo kw'Jekọb</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Nya o, Jekọb oben iva pẹ bẹ́, “Ogbe kk'ọnyọma kw'kaam min'ntor ab'ttatta paam. Màtọk-m nọhnga za ch'iwa manọhng ab'atte paam, z'ọtakpa-sọhm kw'Ẹpharọn kw'anọng p'Het. <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />Ọtakpa-sọhm nwo oning z'izek s'Makpẹla kw'oning ọnyọma Mamrẹ, z'Kenaan. Wa Abraham odebhẹ ọtakpa-sọhm nwo, ọttara izek njo k'mbọhk s'Ẹpharọn kw'ofon Het bẹ́, mad-anọhnga affuranọng. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Nya wọ kw'manọhng Abraham ọttara kwanọng kwẹ Sara. Nya kw'manọhng Isaak ọttara kwanọng kwẹ Rẹbẹka. Nya kw'mbir nnọhnga Lea. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />Wa madebhẹ izek njo ọttara ọtakpa-sọhm nwo z'mbọhk s'anọng p'Het.”<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />K'ogbe kw'Jekọb kk'iva pẹ ntọhna ọnanga maphyir, otinẹ mmo ọnana z'ebin, ọsaka ettem, ofona okebha ab'otte za.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Josẹph otto ọkpẹkẹ oforbukọ kw'otte, obhom ẹmọng, obira ọbaak-ẹ. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Pira oben achiranganọng p'mabira ade atọhmnọng pẹ bẹ́, màdo oforbukọ kw'otte, ọfha oning ọlọbh. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Wa mayẹ-ẹ k'iwu arọbh afa, k'ose kw'ẹmmaana chabẹ ede. Anọng p'Ijip maninga k'ofor-pyibha k'iwu arọbh attaan okwuma ijobh.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />K'ogbe kw'nkk'Jekọb abhoma ma iwu ittonga, Josẹph oben asonọng p'Phero bẹ́, “Ó̱de ndaakẹ bọnga idik, màkkaan-m tek ọvaar Phero bẹ́, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />‘Wa atte kwaam osi-m, nchekẹ bẹ́, kaam m'nnọhng-ẹ z'epekwubh ch'iwa ikk'otuma osok z'izek s'Kenaan. Ototo, tte-m ọbọhk nd-nnọhng-ẹ za. M'mkpa nnam ọkpa.’ ”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />Phero ọpọhn-ẹ bẹ́, “Zọhng nọhnga atte k'ose kw'uwa ọsọ-ọ achekẹ.”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Minna kw'Josẹph ofon bẹ́, ọd-ọnọhnga otte. Adukwa p'Phero maphyir, ọmaana asonọng p'ọsọhm kwẹ, ọttara adidennọng p'Ijip maphyir mayak-ẹ nnam, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />maa ozeng k'ẹsọhmmọr chẹ maphyir, ọmaana ivotte pẹ, ọttara anọng p'abin z'ẹsọhmmọr ch'otte. Iva pabẹ, ọmaana etirakpo pyabẹ byẹ-byẹ iwa nerikẹ ny'Goshẹn. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Wa asoja p'ayaarẹ k'ijaar s'nnyanya id-itọr, ọmaana p'ayaarẹ nnyanya, mabir akwubh Josẹph obo nwo. Wa ede eyokinọngkaan ch'ẹsaabhẹ mawuriji.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Ch'mapyirẹ z'ibyi s'mad-aninga agwuma barli z'Atad kw'ọnyọm Jọrdan, machinẹ k'ẹrọng <char style="it">matamatama</char>. Ny'ibyi njo jọ s'iwa Josẹph otim iwu ichenọmfa obhom otte. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />K'ogbe kw'anọng p'Kenaan p'arukọ nya maze ose kw'ab'Josẹph mabhomọ obo kw'Israẹl ny'ibyi s'mad-agwuma abarli ny'Atad, maben bẹ́, “Anọng p'Ijip asokọ eninga ch'ọmọng-bhoma e!” Kẹ wọ osi pira wa makpe ibyi njo s'nyọm Jọrdan bẹ́, Abẹl-Mizirayim.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Minna kw'uwa iva p'Jekọb masi k'ose kw'otte ikk'bẹ ọtọhna. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Matinẹ oforbukọ kw'otte atima achina z'Kenaan, mad-anọhnga z'ọtakpa-sọhm z'izek s'Makpẹla, kw'ọnyọm Mamrẹ. Ọtakpa-sọhm nwo wọ kw'uwa Abraham odebh ọmaana izek njo z'mbọhk s'Ẹpharọn kw'ofon Hẹt, mach'ifuranọng-byi. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Josẹph ọnọhng otte nya o, ọkpa nnam z'Ijip ọmaana ivotte, ọttara anọng mboza maphyir p'makwubh-ẹ obo nwo.<verse eid="GEN 50:14" /></para>
  <para style="s">Josẹph osi nttem s'ivotte ininga ẹwọr</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Ch'ivotte p'Josẹph makwu aze bẹ́, otte kk'ọpa, maben ayok bẹ́, “Mm'osi yen, óde Josẹph otim oyen ididọkọ z'ettem ọmaana mina k'adiktama mbo p'uwa mọsẹ-ẹ, ochibhẹ bẹ́, m'osi mina itama?” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />Ofona nya, matọhm ẹkkaabha anang Josẹph bẹ́, “Ntọhna s'iwa atte ọnang-ẹ pira ope ide bẹ́, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />motek-ọ bẹ́, ‘Abina anang ivotte pọ k'mpinẹ s'nkk'asa amaan-ọ.’ Mokwukọ-okwukọ bẹ́, abina anang mina k'mpinẹ samina, mina p'mode atọhmnọng p'Ibinọkpaabyi kw'atte kwọ okpobh.” Josẹph ọbhaang ẹkkaabha ndo nya o, obhom ẹmọng.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Nya o, ivotte mbo pẹ makwu atto akwubh-ẹ ny'izek, maben-ẹ bẹ́, “Mina nnode abira pọ.”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Josẹph oben bẹ bẹ́, “Oning bọnga ojor. Bọnga machibhẹ bẹ́, kaam wọ nde Ibinọkpaabyi o? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Bọnga makamẹ epyibha amaan-m, okenaka, Ibinọkpaabyi ọbhakẹ osok k'ejibha, ọfha nkkaana akpen p'anọng saabhada. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Tte oning bọnga ojor. Kaam m'nkkerẹ bọnga ọmaana iva pabọnga.” Minna kw'ofokọ bẹ nttem, ọgbaak odik k'ẹdaak ọkkọkka ọnang bẹ.<verse eid="GEN 50:21" /></para>
  <para style="s">Obo kw'Josẹph</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Nya o, Josẹph ochina ororo oruk ny'Ijip ọmaana nchimma s'otte. Oning akpen k'icho arọbh achen okwuma ijobh. <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />Obir okebha obhon f'iva p'iva p'ojinọngnwa kwẹ Ephraim ọdọk. Obir oruk oze ch'iva p'Makir kw'ode nnwa kw'Manasẹ obhonọ, m'ammaan ny'ikẹ k'echimma.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Otum k'ogbe wanẹ, Josẹph oben ivotte bẹ́, “Kaam min'nkkikken mpe e. Ibinọkpaabyi m'okkerẹ bọnga, otima bọnga obina m'izek nja, ochina z'izek s'iwa ikk'ocheka ọnang Abraham, ọmaana Isaak, ọttara Jekọb.” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />Josẹph osi ivotte machekẹ, oben bẹ bẹ́, “Ibinọkpaabyi m'okkikkaana bọnga, otima bọnga eden. Màkpokọ akọbhọ paam tima bina m'izek nja.”<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Nya o, Josẹph okwu ope ch'inode icho arọbh achen okwuma ijobh k'atam. Mado oforbukọ kwẹ, mayika k'ifura-kwukwu ny'Ijip.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>