<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1KI" style="id">- Mbembe Adun [MFNAdun]</book>
  <para style="h">1 Avaarnọng</para>
  <para style="toc2">1 Avaarnọng</para>
  <para style="toc1">Ocheden-nwẹr kw'Avaarnọng</para>
  <para style="mt1">Ocheden-nwẹr kw'Avaarnọng</para>
  <para style="imt" />
  <para style="im" />
  <para style="ie" />
  <chapter number="1" style="c" sid="1KI 1" />
  <para style="s1">Ogbe kw'Devid ikk'ọtama</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 1:1" />Wa Devid kk'ọtama maa, zaa nnabubh-ẹ ọbara, ekok ẹsẹ-ẹ nya. <verse eid="1KI 1:1" /><verse number="2" style="v" sid="1KI 1:2" />Ofona nya o, atọhmnọng pẹ aben-ẹ bẹ́, “Ttatta, mochibhẹ bẹ́, wura mororọ ókwúrà-kwúrà wanẹ ochen-ọ kw'min'okker-ọ. Okwura-kwura nwo m'oyima otum-ọ, ọfha ekok ening ọvaarnọng kwamina esi.”<verse eid="1KI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 1:3" />Minna kw'mabin, mad-aror ominanwa kw'ojibhẹ kwanọng ny'Israẹl maphyir, maze Abishag kw'ofon Shunam. Matọk-ẹ achena ọvaarnọng. <verse eid="1KI 1:3" /><verse number="4" style="v" sid="1KI 1:4" />Wa ominanwa nwo ojibhẹ kwanọng mawuriji, obir okkerẹ ọvaarnọng k'ọkkọkka. Okenaka, ọvaarnọng kẹ abẹ koyim.<verse eid="1KI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 1:5" />Minna kw'Adonija kw'Hagit ọmaanẹ ọnang Devid obin, ọtọma ẹmma osisi, oben bẹ́, “Kaam m'nde ọvaarnọng!” Ọtọka ijaar s'nnyanya id-itọr, ọmaana ayaar-ọyaar p'ade anọng arọbh afa okwuma ijobh bẹ́, machẹ-ẹ eden. <verse eid="1KI 1:5" /><verse number="6" style="v" sid="1KI 1:6" />(Ch'uwa obobe ode, otte kẹ kọgbọbhọ bẹ́, “Osempira asi minna?” Wa kẹ ojibhẹ ojinọng mawuriji. Kẹ wọ iwa otorọ Absalọm nnam.)<verse eid="1KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 1:7" />Adonija ọd-ọttọhna ọmaana Joab kw'ode nnwa kw'Zeruya, ọmaana Abiyata kw'ode ọfọhn-ẹja. Machera, mabẹ-ẹ k'nnam. <verse eid="1KI 1:7" /><verse number="8" style="v" sid="1KI 1:8" />Anọng p'uwa nna k'Adonija abe, made Zadọk kw'ode ọfọhn-ẹja, ọmaana Bẹnaya kw'ode nnwa kw'Jehoyada, ọmaana Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, ọmaana Shimeyi, ọmaana Reyi, ọttara afanọng p'Devid.<verse eid="1KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 1:9" />Adonija otima arọkimaan, ọmaana adamogbodo, ọttara abhaamva p'mabhaar-ọbhaar, ọfọhnọ ẹja k'Ọta kw'Zohẹlẹt, kw'oning ọnyọma Ẹn Rogẹl. Ọphyẹ ivotte p'ejinọng maphyir p'ọvaarnọng obhonọ, ọttara adukwa p'Juda maphyir. <verse eid="1KI 1:9" /><verse number="10" style="v" sid="1KI 1:10" />Wa Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi kọphyẹ, Bẹnaya ọmaana afanọng p'Devid kọphyẹ, Sọlọmọn kw'ode ọgbaanotte kobir ọphyẹ.<verse eid="1KI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 1:11" />Nya o, Natan ọbọbh Batshẹba kw'ode ọkka kw'Sọlọmọn bẹ́, “Ma, kọ kabhaang bẹ́, Adonija kw'ode nnwa kw'Hagit node ọvaarnọng, ọvaar Devid kwamina odik nwo kozong o? <verse eid="1KI 1:11" /><verse number="12" style="v" sid="1KI 1:12" />Ofona nya, tte nnang-ọ ntọhna k'ose kw'm'akkaana akpen pọ, ọmaana p'Sọlọmọn kw'ode nnwa kwọ. <verse eid="1KI 1:12" /><verse number="13" style="v" sid="1KI 1:13" />Zọhng kebha ọvaar Devid aben-ẹ bẹ́, “Ttatta ọvaarnọng kwaam, mba wa achekẹ anang kaam ọtọhmnọng kwọ bẹ́, ‘K'odik ọkkọkka, Sọlọmọn kw'ode nnwa kwọ wọ im'otima ẹvaar chọ o? Kọ zang abir achekẹ bẹ́, kẹ wọ im'oninga ẹwọr ny'ẹvaarkkọhbhọ chọ o? Adonija nosi yen ode ọvaarnọng o?’ <verse eid="1KI 1:13" /><verse number="14" style="v" sid="1KI 1:14" />Kaam m'nkwu ny'ogbe kw'atim agbaak ọvaarnọng odik nwa, ọfha nttara iwọhng saam ny'odik nwo.”<verse eid="1KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 1:15" />Minna kw'Batshẹba ofon od-okebha ọvaar Devid kw'ikk'ọtama z'idongọ sẹ, za ch'Abishag kw'ofon Shunam od-okker-ẹ. <verse eid="1KI 1:15" /><verse number="16" style="v" sid="1KI 1:16" />Batshẹba ọraka eso ọnang ọvaarnọng k'ekpukpobha-maana.</para>
  <para style="p" vid="1KI 1:16">Ọvaarnọng ọbọbh-ẹ bẹ́, “Arorọ mbọng o?”<verse eid="1KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 1:17" />Ọpọhn-ẹ bẹ́, “Ttatta kwaam, wa achekẹ k'eche ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwọ, anang kaam ọtọhmnọng kwọ bẹ́, ‘Sọlọmọn kw'ode nnwa kwọ wọ im'otima ẹvaar chọ, obir oninga ewọr ny'ẹvaarkkọhbhọ chọ.’ <verse eid="1KI 1:17" /><verse number="18" style="v" sid="1KI 1:18" />Okenaka, Adonija nosi yen ọtọka ẹvaar, kọ ttatta ọvaarnọng kwaam odik nwo kazong o? <verse eid="1KI 1:18" /><verse number="19" style="v" sid="1KI 1:19" />Kẹ kk'adamogbodo, ọmaana àbhàamvà p'mabhaar-ọbhaar, ọttara arọkimaan k'ọsaabh otima ọfọhnọ ẹja. Obira ọphyẹ ivotte p'ejinọng maphyir p'ọvaarnọng obhonọ, ọmaana Abiyata kw'ode ọfọhn-ẹja, ọttara Joab kw'ode oso kw'asoja. Okenaka, Sọlọmọn kw'ode ọtọhmnọng kwọ, kọphyẹ. <verse eid="1KI 1:19" /><verse number="20" style="v" sid="1KI 1:20" />Ttatta ọvaarnọng, anọng p'Israẹl maphyir natikẹ kọ bẹ́, atek bẹ ọnọng kw'im'oninga ẹwọr ny'ẹvaarkkọhbhọ chọ. <verse eid="1KI 1:20" /><verse number="21" style="v" sid="1KI 1:21" />Ína minna ode, óde ttatta ọvaarnọng kwaam obubh ẹmma, otor ab'otte za, mm'asi kaam ọmaana nnwa kwaam Sọlọmọn mach'arurubha.”<verse eid="1KI 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 1:22" />Ny'ẹmma ndo ch'otim ọgbaak odik ọnang ọvaarnọng, Natan, kw'ode ọgbaak-ettem ch'Ibinọkpaabyi opyirẹ. <verse eid="1KI 1:22" /><verse number="23" style="v" sid="1KI 1:23" />Matek ọvaarnọng bẹ́, “Natan, kw'ode ọgbaak-ettem ch'Ibinọkpaabyi kk'opyira ma.” Minna kw'ofon okebha ọvaarnọng za, ọraka eso k'ekpukpobha-maana ọnang-ẹ.<verse eid="1KI 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 1:24" />Natan oben bẹ́, “Ttatta ọvaarnọng kwaam, ma, kk'abena bẹ́, Adonija wọ im'otima ẹvaar chọ, obira ọnana ny'ẹvaarkkọhbhọ chọ o? <verse eid="1KI 1:24" /><verse number="25" style="v" sid="1KI 1:25" />Ch'nd-mgbaak ma, kẹ kk'adamogbodo, ọmaana àbhàamvà p'mabhaar-ọbhaar, ọttara arọkimaan k'ọsaabh, otima ọfọhnọ ẹja. Oyerẹ ivotte p'ejinọng maphyir p'ọvaarnọng obhonọ, ọmaana Abiyata kw'ode ọfọhn-ẹja, ọttara Joab kw'ode oso kw'asoja. Ch'moning ma, maning za ator-ẹ machi, mabira agwo, mad-aben bẹ́, ‘Tte ọvaar Adonija oruk akpen p'adum-odum!’ <verse eid="1KI 1:25" /><verse number="26" style="v" sid="1KI 1:26" />Okenaka, kaam ọtọhmnọng kwọ, ọmaana Zadọk kw'ode ọfọhn-ẹja, ọmaana Bẹnaya kw'ode nnwa kw'Jehoyada, ọttara ọtọhmnọng kwọ Sọlọmọn, kọphyẹ. <verse eid="1KI 1:26" /><verse number="27" style="v" sid="1KI 1:27" />Oyinẹ bẹ́, ttatta ọvaarnọng kwaam kk'odik nwoma ọsa, mina atọhmnọng pẹ kotekẹ ọnọng kw'im'ọtọka ẹvaar chẹ, obira oninga ẹwọr ny'ẹvaarkkọhbhọ chẹ o?”<verse eid="1KI 1:27" /></para>
  <para style="s">Devid osi Sọlọmọn ẹvaar</para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 1:28" />Nya o, ọvaar Devid oben bẹ́, “Màyerẹ Batshẹba chen-m.” Mayer-ẹ, odim z'ẹtaanga, obe ny'ititika s'ọvaarnọng.<verse eid="1KI 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 1:29" />Ọvaarnọng ochekẹ, oben bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi kw'ọrọhbh-m k'adama kpenamkpen oruk akpen, <verse eid="1KI 1:29" /><verse number="30" style="v" sid="1KI 1:30" />kaam m'nsi nnang-ọ menda nwa, k'ose kw'uwa nwọhngọ k'eche ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl bẹ́: Sọlọmọn kw'ode nnwa kwọ wọ im'otima ẹvaar chaam, obir oninga ẹwọr ny'ẹvaarkkọhbhọ chaam.”<verse eid="1KI 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 1:31" />Nya o, Batshẹba ọraka maa otwu ititika z'izek k'ekpukpobha-maana, oben bẹ́, “Tte ọvaar Devid, kw'ode ttatta kwaam, oruk akpen ttattampe!”<verse eid="1KI 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 1:32" />Ọvaar Devid oben bẹ́, “Màyerẹ Zadọk kw'ode ọfọhn-ẹja, ọmaana Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, ọttara Bẹnaya kw'ode nnwa kw'Jehoyada, makwu.” Minna kw'makwu akebha ọvaarnọng nya. <verse eid="1KI 1:32" /><verse number="33" style="v" sid="1KI 1:33" />Oben bẹ bẹ́, “Màtọka atọhmnọng p'kaam ọvaarnọng kwabọnga tima zọhng. Mànana Sọlọmọn kw'ode nnwa kwaam ny'ẹnyanya chaam, matim-ẹ achina z'Gihọn. <verse eid="1KI 1:33" /><verse number="34" style="v" sid="1KI 1:34" />Ṉ́kk'apyira za, Zadọk kw'ode ọfọhn-ẹja, ọmaana Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, mm'ayaan-ẹ, masẹ-ẹ ọvaarnọng kw'Israẹl. Màje enyisa, màbira akwọhrọ k'ẹrọng bẹ́, ‘Tte ọvaar Sọlọmọn oruk akpen p'adum-odum!’ <verse eid="1KI 1:34" /><verse number="35" style="v" sid="1KI 1:35" />Bọnga mm'atọn azenga maa, okwu oninga ny'ẹvaarkkọhbhọ chaam, obira ọtọka eninga chaam mach'ọvaarnọng. Kaam kk'ẹ ntéka bẹ́, ọbaabha Israẹl ọmaana Juda.”<verse eid="1KI 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 1:36" />Bẹnaya kw'ode nnwa kw'Jehoyada, ọpọhna ọvaarnọng bẹ́, “Tte ode minna! Tte Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'ttatta ọvaarnọng kwaam oben minna. <verse eid="1KI 1:36" /><verse number="37" style="v" sid="1KI 1:37" />Tte Ọvaar Ibinọkpaabyi oninga ọmaana Sọlọmọn k'ose kw'oning ọmaana ttatta ọvaarnọng kwaam. Tte osi ẹvaar chẹ ekpobha ẹyọhnga ch'ttatta ọvaar Devid kwaam!”<verse eid="1KI 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 1:38" />Minna kw'Zadọk kw'ode ọfọhn-ẹja, ọmaana Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, ọmaana Bẹnaya kw'ode nnwa kw'Jehoyada, ọmaana anọng p'Kẹrẹt, ọttara anọng p'Pẹlẹt, manan Sọlọmọn k'ẹnyanya ch'ọvaar Devid, matim-ẹ achina z'Gihọn. <verse eid="1KI 1:38" /><verse number="39" style="v" sid="1KI 1:39" />Zadọk kw'ode ọfọhn-ẹja, odim z'ikkira s'awuriji, ọtọka mpyi kw'ana ayik, ọyaana Sọlọmọn. Minna kw'maje enyisa, anọng maphyir makwọhrọ k'ẹrọng bẹ́, “Tte ọvaar Sọlọmọn oruk akpen p'adum-odum!” <verse eid="1KI 1:39" /><verse number="40" style="v" sid="1KI 1:40" />Anọng maphyir mazenga ayak-ẹ nnam, malobh, mabira aje nsa maa, izek inyengẹ <char style="it">bẹ́ tikitiki</char>.<verse eid="1KI 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 1:41" />Adonija, ọmaana anọng maphyir p'ọphyẹ eninga, maninga za abhaanga ch'mad-alobh k'ogbe kw'eninga min'ẹsa. Mabhaang enyisa ch'ed-eje nya o, Joab ọbọbh bẹ́, “Izozo s'nd-ọbhaanga kina ebhondim iyinẹ yen o?”<verse eid="1KI 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1KI 1:42" />Nya ch'otim otim odik ny'ẹmma, Jonatan kw'ode nnwa kw'Abiyata, kw'ode ọfọhn-ẹja, opyirẹ. Adonija oben-ẹ bẹ́ “Dim ka ẹtaanga. Ọnọng ọkkọkka mach'ikọ ọbaan bẹ́, otima ẹkkaabha ọkkọkka okwu.”<verse eid="1KI 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 1:43" />Jonatan ọpọhn-ẹ bẹ́, “Minna kode! Ọvaar Devid kwamina kk'Sọlọmọn ẹvaar ọsa e. <verse eid="1KI 1:43" /><verse number="44" style="v" sid="1KI 1:44" />Ọvaarnọng kk'Zadọk kw'ode ọfọhn-ẹja, ọmaana Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, ọmaana Bẹnaya kw'ode nnwa kw'Jehoyada, ọmaana anọng p'Kẹrẹt, ọttara anọng p'Pẹlẹt ọtọhma bẹ́, mazenga amaan-ẹ. Nkk'ẹ anana z'ẹnyanya ch'ọvaarnọng. <verse eid="1KI 1:44" /><verse number="45" style="v" sid="1KI 1:45" />Zadọk kw'ode ọfọhn-ẹja, ọmaana Natan kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, nkk'ẹ ayaana bẹ́, ode ọvaarnọng z'Gihọn. Nkk'atọma za alobh maa, matọka ebhondim kibungọ. Izozo s'ad-abhaanga jọ nya e. <verse eid="1KI 1:45" /><verse number="46" style="v" sid="1KI 1:46" />Ch'nd-mgbaak-ọgbaak ma, Sọlọmọn kk'ẹwọr oninga z'ẹvaarkkọhbhọ e. <verse eid="1KI 1:46" /><verse number="47" style="v" sid="1KI 1:47" />Adukwa p'ọvaarnọng kk'abira akwa bẹ́, makwu azima ttatta ọvaar Devid kwamina. Nkk'ẹ abena bẹ́, ‘Tte Ibinọkpaabyi kwọ osi eche ọmaana ẹvaar ch'Sọlọmọn ekpobha ẹyọhnga chọ!’ Minna kw'ọvaarnọng ọrak eso ny'ikẹ k'ebin, <verse eid="1KI 1:47" /><verse number="48" style="v" sid="1KI 1:48" />oben bẹ́, ‘Ẹtọhnga ede ch'Ọvaar Ibinọkpaabyi kw'Israẹl kw'ikk'ọsa bẹ́, ntima achen paam nze ọnọng kw'im'otera eso chaam menda.’ ”<verse eid="1KI 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1KI 1:49" />Anọng p'Adonija ọphyẹ, mabhaang nya o, opoma osi bẹ, maffurọ maphyir. <verse eid="1KI 1:49" /><verse number="50" style="v" sid="1KI 1:50" />Minna kw'ojora f'Adonija oyen k'Sọlọmọn ọwọhkọ Adonija ọd-ọbọka abhik p'ija-byi <char style="it">bẹ́ gwẹk</char>. <verse eid="1KI 1:50" /><verse number="51" style="v" sid="1KI 1:51" />Itekẹ ipyirẹ Sọlọmọn bẹ́, “Ọvaar Sọlọmọn ojor Adonija ojora. Ofona nya, kk'abhik p'ija-byi odo ọbọka. Obenẹ za bẹ́, ‘Tte ọvaar Sọlọmọn ochekẹ bẹ́, ọkkangkkang mòtima ọfhọ kaam ọtọhmnọng kwẹ.’ ” <verse eid="1KI 1:51" /><verse number="52" style="v" sid="1KI 1:52" />Sọlọmọn ọpọhna bẹ́, “Ó̱de ọkọhk bẹ́, ode ọnọng ọkkọkka, osisa-naanga mawanẹ kw'eso chẹ, k'izek mòtto. Okenaka, óde itama ining-ẹ z'ettem, m'opope.” <verse eid="1KI 1:52" /><verse number="53" style="v" sid="1KI 1:53" />Minna kw'ọvaar Sọlọmọn ọtọhm anọng bẹ́, mad-atọk-ẹ z'ija-byi atima akwu. Adonija opyirẹ nya o, ọraka eso k'ekpukpobha-maana ọnang ọvaar Sọlọmọn, pira Sọlọmọn oben-ẹ bẹ́, “Zọhng bhana z'ikọ k'ọsọhm.”<verse eid="1KI 1:53" /></para>
  <chapter eid="1KI 1" />
  <chapter number="2" style="c" sid="1KI 2" />
  <para style="s1">Ikpongannamtọhna s'Devid ọnang Sọlọmọn</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 2:1" />Wa ch'ogbe kk'ọnyọma kw'Devid m'ope, oyerẹ nnwa kwẹ Sọlọmọn, ọnang-ẹ ntọhna, oben-ẹ bẹ́,<verse eid="1KI 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 2:2" />“Oning ka ọdọhbh-m e. Gaangẹ ifor asi mach'ojinọng! <verse eid="1KI 2:2" /><verse number="3" style="v" sid="1KI 2:3" />Si idik s'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ oben-ọ bẹ́, asi. Kpobha idik sẹ, ọmaana asana pẹ, ọmaana apaanga pẹ, ọttara ntọhna sẹ, k'ose kw'makkẹrẹ z'nnwẹr kw'apaanga p'Mosẹs. Si minna, ọfha ojibh ọnang-ọ k'ọttọhk kpenamkpen f'asi, ọttara k'ibyi kpenamkpen s'ata. <verse eid="1KI 2:3" /><verse number="4" style="v" sid="1KI 2:4" />M'ofona nya, Ọvaar Ibinọkpaabyi osi k'ose kw'uwa ochekẹ ọnang-m bẹ́, ‘Ó̱de iva p'iva pọ mazeng k'eden ọkkọkka, matima nttem sabẹ maphyir, ọmaana agbagba pabẹ maphyir mator-m, eden za kede ch'ọnọng ina nya moninga kw'im'ọnana ny'ẹvaarkkọhbhọ ch'Israẹl.’<verse eid="1KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 2:5" />“Kọ oyenẹ azong ọttọhk f'uwa Joab kw'ode nnwa kw'Zeruya osi-m ma. Wa kẹ ọfhọ asonọng afa p'asoja p'Israẹl, p'ade Abnẹr kw'ode nnwa kw'Nẹr, ọmaana Amasa kw'ode nnwa kw'Jẹtẹr. Wa ọfhọ bẹ mach'moning k'egbong, zangke, moning k'ẹmẹm. Ọzẹ fabẹ ọpyak-ẹ z'odikpa kw'ọkpaam z'erin, ọmaana z'ntọkọ s'oke z'mmo. <verse eid="1KI 2:5" /><verse number="6" style="v" sid="1KI 2:6" />Kọ tima ezonga chọ sẹ-ẹ k'ose kw'ọdaak-ọ. Kẹ ọbọhk kàtte otima ẹmẹm ọsaka izek k'atam.<verse eid="1KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 2:7" />“Ṉ́nòde iva p'Barzilayi kw'ofon Gilead, tte bẹ mattara k'anọng p'mm'achi ọttọhk amaan-ọ. Kirẹ wa bẹ mabe amaan-m k'ogbe kw'nrọbhọ z'mbọhk s'agbaanakka Absalọm.<verse eid="1KI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 2:8" />“Kàzaama bẹ́, Shimeyi kw'Gẹra obhonọ, kw'ofon Bahurim, z'ẹkọma ch'Bẹnjamin, oning nya ọmaan-ọ. Wa ọtwọ-m mawuriji ny'ewu ch'nd-nchina z'Mahanaim. Ch'iwa nokwu okebh-m z'ọraanga kw'Jọrdan, nchekẹ nnang-ẹ k'eche ch'Ọvaar Ibinọkpaabyi bẹ́, ‘Kaam ọkkangkkang mìntima mfhọ-ọ.’ <verse eid="1KI 2:8" /><verse number="9" style="v" sid="1KI 2:9" />Okenaka, tọma ma, tọk-ẹ mach'ọnọng kw'ikk'opina. Kọ mach'ọnọng kw'oyen ezonga, azong ọttọhk f'm'asẹ-ẹ ma. K'eden kpenamkpen, kẹ ọbọhk katte oruk akpen.”<verse eid="1KI 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 2:10" />Devid o, okwu ope, otor ab'ttatta pẹ za. Manọhng-ẹ z'ebhondim ch'Devid. <verse eid="1KI 2:10" /><verse number="11" style="v" sid="1KI 2:11" />Kibung-kibungọ, wa Devid otim ẹvaar ch'Israẹl k'icho arọbh afa. Ọbaabh Hẹbrọn k'icho ichenọmfa, ọbaabha Jẹrusalẹm k'icho ẹrọbh okwuma ijobh kkanttaan. <verse eid="1KI 2:11" /><verse number="12" style="v" sid="1KI 2:12" />Minna kw'Sọlọmọn okwu otima ẹvaar ch'otte Devid. Ẹvaar chẹ ettima.<verse eid="1KI 2:12" /></para>
  <para style="s1">Ẹvaar ch'Sọlọmọn ettim</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 2:13" />Adonija kw'ode nnwa kw'Hagit obina od-okebha Batshẹba kw'ode ọkka kw'Sọlọmọn. Batshẹba ọbọbh-ẹ bẹ́, “Mba ẹkwa nda chọ, ch'ọdaam dọ o?” Adonija apọhn-ẹ bẹ́, “Iye, nkwu k'ọdaam e.”<verse eid="1KI 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 2:14" />Obira ọttara bẹ́, “Nyen odik kw'nd-mben bẹ́, mgbaak-ọ.”</para>
  <para style="p" vid="1KI 2:14">Batshẹba ọpọhn-ẹ bẹ́, “Gbaak-m.”<verse eid="1KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 2:15" />Adonija oben-ẹ bẹ́, “Kọ azong ma bẹ́, wa ẹvaar ndo ede chaam. Anọng p'Israẹl maphyir asokọ ichen bẹ́, kaam wọ im'mbaabha bẹ. Okenaka, idik ikwu ibhakẹ. Ọvaar Ibinọkpaabyi noter ọtọka ẹvaar ndo ọnang agbaanatte kwaam. <verse eid="1KI 2:15" /><verse number="16" style="v" sid="1KI 2:16" />Nyen ọttọhk mavanẹ f'm'mphyem-ọ. Ototo, kaam ọttọhk mvo karaam o.”</para>
  <para style="p" vid="1KI 2:16">Batshẹba oben-ẹ bẹ́, “Gbaak-m.”<verse eid="1KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 2:17" />Adonija oben-ẹ bẹ́, “Ototo, ben ọvaar Sọlọmọn bẹ́, ọtọka Abishag kw'ofon Shunam ọnang-m mach'kwanọng kwaam. Kaam nzong bẹ́, kọ mọraam.”<verse eid="1KI 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 2:18" />Batshẹba ọpọhn-ẹ bẹ́, “Iya, ojibhẹ ma. Kaam m'mgbaak ọvaarnọng odik nwo k'kọ k'eso.”<verse eid="1KI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 2:19" />K'ogbe kw'Batshẹba ofon bẹ́, ọd-ọgbaak Sọlọmọn kw'ode ọvaarnọng odik kw'Adonija ọtọhm-ẹ. Ọvaarnọng ọzẹ-ẹ nya o, obina okebh-ẹ, ọraka eso ọnang-ẹ, pira nofon od-oninga ẹwọr z'ẹvaarkkọhbhọ chẹ. Ọtọhm bẹ́, matọka ọvaargbera anang ọkka oninga ẹwọr. Ọkka o, oninga otum-ẹ ny'odimbọhk.<verse eid="1KI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 2:20" />Oben ọvaarnọng bẹ́, “Oyen ẹttọhkva ch'nd-nkam bẹ́, mphyem-ọ. Ototo, kaam karaam o.”</para>
  <para style="p" vid="1KI 2:20">Ọvaarnọng ọpọhn-ẹ bẹ́, “Nna kwaam, phyem-m, kaam kọ mìnram.”<verse eid="1KI 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 2:21" />Nya o, Batshẹba oben ọvaarnọng bẹ́, “Tte Abishag kw'ofon Shunam ọbọhk nang Adonija kw'ode agbaanatte mach'kwanọng kwẹ.”<verse eid="1KI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 2:22" />Ọvaar Sọlọmọn ọbọbh ọkka bẹ́, “Osempira aphyem-m bẹ́, ntte Abishag kw'ofon Shunam ọbọhk nnang Adonija k'ọbada? Ina akkerẹ, ewu danẹ maphyem-m bẹ́, ntte ẹvaar ọbọhk nnang-ẹ, okurọ ch'ode agbaanatte kwaam kwiden. Mabira aphyem anang Abiyata kw'ode ọfọhn-ẹja, ọttara Joab kw'ode nnwa kw'Zeruya!”<verse eid="1KI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 2:23" />Nya o, ọvaar Sọlọmọn ochekẹ k'eche ch'Ọvaar Ibinọkpaabyi bẹ́, “Tte Ibinọkpaabyi ọnang-m irem, zaa m'bar yen, óde Adonija ina akpen pẹ otim otera eso ch'ọttọhk mva f'ophyemẹ ma! <verse eid="1KI 2:23" /><verse number="24" style="v" sid="1KI 2:24" />Ofona nya, k'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, kẹ nwo kw'ọnang-m ẹvaar, osi dẹ ettima mach'ẹvaar ch'atte kwaam Devid, obira osi ivaartaak saam ibe, k'ose kw'uwa ochekẹ, Adonija m'ope menda!” <verse eid="1KI 2:24" /><verse number="25" style="v" sid="1KI 2:25" />Minna kw'ọvaar Sọlọmọn ọnang Bẹnaya kw'ode nnwa kw'Jẹhoyada ẹfa bẹ́, ọfhọ Adonija. Bẹnaya obin-ẹ ọttọhk, ope.<verse eid="1KI 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 2:26" />Ọvaarnọng oben Abiyata kw'ode ọfọhn-ẹja bẹ́, “Kpa nnam z'iwonọ sọ z'Anatọt. Kọ abaan k'obo, okenaka, kọ mimkponga mfhọ okurọ bẹ́, kọ w'uwa ad-atima Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi kw'Ọyọhng, ny'ogbe kw'atte kwaam Devid, abira atọka irem amaan-ẹ k'adiktama maphyir p'akebh-ẹ.” <verse eid="1KI 2:26" /><verse number="27" style="v" sid="1KI 2:27" />Minna kw'Sọlọmọn ọrọhbh Abiyata z'ọtọhm f'ẹja ch'Ibinọkpaabyi ofufọhnọ, k'ose kw'uwa Ọvaar Ibinọkpaabyi ikk'ocheka ọmaana ọsọhm kw'Ẹli z'Shilo.<verse eid="1KI 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 2:28" />K'ogbe kw'ẹkkaabha ndo etto Joab k'itọhng o, ọrọbh odim z'ikkira s'Ọvaar Ibinọkpaabyi, ọd-ọbọka abhik p'ija-byi, okurọ ch'iwa ikk'ikwu ọcha ọmaana Adonija, obhum ẹkaan ch'Absalọm. <verse eid="1KI 2:28" /><verse number="29" style="v" sid="1KI 2:29" />Itekẹ ipyirẹ ọvaar Sọlọmọn bẹ́, Joab kk'ọrọbha odim z'ikkira s'Ọvaar Ibinọkpaabyi, od-oninga ọnyọma ija-byi. Sọlọmọn ọnang Bẹnaya kw'ode nnwa kw'Jẹhoyada ẹfa bẹ́, “Zọhng bin-ẹ ọttọhk, afhẹ-ẹ!”<verse eid="1KI 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 2:30" />Bẹnaya odim okebha Joab z'ikkira s'Ọvaar Ibinọkpaabyi, oben-ẹ bẹ́, “Ọvaarnọng obenẹ bẹ́, ayin k'iyaan!”</para>
  <para style="p" vid="1KI 2:30">Okenaka, Joab ọpọhn-ẹ bẹ́, “Minna mode, m'mpe ma.”</para>
  <para style="p" vid="1KI 2:30">Bẹnaya o, ọkpa nnam od-otek ọvaarnọng k'ose kw'Joab ọpọhn-ẹ.<verse eid="1KI 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 2:31" />Ọvaarnọng oben Bẹnaya bẹ́, “Si k'ose kw'obenẹ. Bin-ẹ ọttọhk afhẹ-ẹ, anọhng-ẹ, mfha itama s'anọng p'mbọhk sabẹ iwur-owur p'Joab ọfhọ, obyenga izẹ sabẹ, ining kaam ọmaana ẹsọhmmọr chaam kibungọ, ibẹ.” <verse eid="1KI 2:31" /><verse number="32" style="v" sid="1KI 2:32" />Ọzẹ f'anọng mbo afa p'ọbọr atte kwaam Devid nnam, otima ọkkangkkang ọfhọ, Ọvaar Ibinọkpaabyi m'otuka ny'Joab. Wa anọng mbo afa p'ọfhọ made Abnẹr, kw'ode nnwa kw'Nẹr, obira ode oso kw'asoja p'Israẹl. Nwoza ode Amasa, kw'ode nnwa kw'Jẹtẹr, obira ode oso kw'asoja p'Juda. Bẹ anọng mbo afa wa majibhẹ ọtam, mabir ator ọtam ayọhnga Joab. <verse eid="1KI 2:32" /><verse number="33" style="v" sid="1KI 2:33" />Tte ọzẹ fabẹ ọkpẹkẹ Joab ọmaana iva p'iva pẹ ttattampe. Ṉ́nòde Devid ọmaana iva p'iva pẹ, ọmaana ẹsọhmmọr chẹ, ọttara ẹvaar chẹ, tte odiriji kw'Ọvaar Ibinọkpaabyi oninga ọmaana bẹ ttattampe.<verse eid="1KI 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 2:34" />Minna kw'Bẹnaya kw'ode nnwa kw'Jẹhoyada ofon od-obin Joab ọttọhk, ọfhẹ-ẹ. Manọhng-ẹ z'obhon kwẹ, z'ibyi s'anọng nna arukọ. <verse eid="1KI 2:34" /><verse number="35" style="v" sid="1KI 2:35" />Ọvaarnọng oteka Bẹnaya kw'ode nnwa kw'Jẹhoyada bẹ́, ọtọka eninga ch'Joab kw'ode oso kw'asoja. Obira oteka Zadọk kw'ode ọfọhn-ẹja bẹ́, ọtọka eninga ch'Abiyata.<verse eid="1KI 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 2:36" />Ọvaarnọng ọtọhm bẹ́, mayerẹ Shimeyi okwu. Okwu nya o, oben-ẹ bẹ́, “Si ọsọhm kwọ z'Jẹrusalẹm, aruk nya. K'ibyi ọdọk-ọdọk kata o. <verse eid="1KI 2:36" /><verse number="37" style="v" sid="1KI 2:37" />Ewu kpenamkpen ch'asọbhọ ẹtọkọ ajeka ilokodo s'Kidrọn, zonga bẹ́, m'apope. Izẹ sọ m'ibira ibhakẹ ikpẹk-ọ.”<verse eid="1KI 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 2:38" />Shimeyi ọpọhna ọvaarnọng bẹ́, “Ttatta, odik kw'agbaakẹ ojibh-ojibh. Kaam ọtọhmnọng kwọ m'nsi k'ose kw'ttatta ọvaarnọng kwaam obenẹ.” Minna kw'Shimeyi orukọ ny'Jẹrusalẹm maa, ogbe ode.<verse eid="1KI 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 2:39" />Okwu opyirẹ icho ittaan o, abira afa p'Shimeyi arọbh akebha Akish kw'ode nnwa kw'Maaka kw'ode ọvaarnọng kw'Gat. Itekẹ ipyirẹ Shimeyi bẹ́, “Abira pọ aning z'Gat e.” <verse eid="1KI 2:39" /><verse number="40" style="v" sid="1KI 2:40" />Shimeyi odo ibyi s'im'oninga ẹwọr ny'ẹnyanya chẹ, ochina z'Akish, od-oror abira pẹ. Oze bẹ nya o, otima bẹ z'Gat ọkpa nnam ka Jẹrusalẹm.<verse eid="1KI 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 2:41" />K'ogbe kw'matekẹ Sọlọmọn bẹ́, Shimeyi kk'obina ny'Jẹrusalẹm, ọta z'Gat okwuna, <verse eid="1KI 2:41" /><verse number="42" style="v" sid="1KI 2:42" />ọvaarnọng oyerẹ Shimeyi oben-ẹ bẹ́, “Kọ zang kw'nsi achekẹ k'eche ch'Ọvaar Ibinọkpaabyi, mbira ntọr-ọ itọhng bẹ́, ‘Ewu kpenamkpen ch'abin ma, ata ibyi kpenamkpen, zonga bẹ́, m'apope?’ Kọ zang apọhn-m bẹ́, ‘Odik kw'agbaakẹ ma, ojibh-ojibh, kaam m'mkpobha wẹ?’ <verse eid="1KI 2:42" /><verse number="43" style="v" sid="1KI 2:43" />Osempira ọdọk kasi k'ose kw'achekẹ anang Ọvaar Ibinọkpaabyi, abira akpobha ọgbaakadik kwaam o?”<verse eid="1KI 2:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 2:44" />Ọvaarnọng obira oben Shimeyi bẹ́, “Ny'ettem chọ, kọ azong itama maphyir s'iwa asi anang Devid kw'ode atte kwaam ma. Ọvaar Ibinọkpaabyi m'otuka idiktama njo s'asi. <verse eid="1KI 2:44" /><verse number="45" style="v" sid="1KI 2:45" />Ṉ́nòde ọvaar Sọlọmọn, Ọvaar Ibinọkpaabyi m'ọdẹ-ẹ, obira osi ẹvaar ch'Devid kw'ode otte, ekpen ttattampe.”<verse eid="1KI 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 2:46" />Ọvaarnọng ọnang Bẹnaya kw'ode nnwa kw'Jẹhoyada ẹfa bẹ́, ọd-ọfhọ Shimeyi. Minna kw'ofon od-obin-ẹ ọttọhk, ope.</para>
  <para style="p" vid="1KI 2:46">Wa ẹvaar ndo ekwu ettima k'ogbe kw'Sọlọmọn.<verse eid="1KI 2:46" /></para>
  <chapter eid="1KI 2" />
  <chapter number="3" style="c" sid="1KI 3" />
  <para style="s1">Sọlọmọn ophyemẹ ezonga</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 3:1" />Sọlọmọn odim k'nttọhna ọmaana ọvaar Phero kw'Ijip, ọtọka ominanwa kw'Phero k'ọbada. Otim-ẹ od-oruk z'ebhondim ch'Devid maa, ochera ọvaarter kwẹ, ọmaana Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọttara ọbaaka kw'otim ata osi ọkọbha Jẹrusalẹm maphyir. <verse eid="1KI 3:1" /><verse number="2" style="v" sid="1KI 3:2" />Ny'ogbe nwo, wa anọng p'Israẹl mad-afọhnọ nja k'ọja-byi f'oning k'ọyaankpa, okurọ ch'iwa nna ọsọhm kw'otim eche ch'Ọvaar Ibinọkpaabyi atima asa. <verse eid="1KI 3:2" /><verse number="3" style="v" sid="1KI 3:3" />Eden ch'iwa Sọlọmọn ọkọhk ọdaakẹ kw'oyen ọmaana Ọvaar Ibinọkpaabyi ede bẹ́, wa orukọ akpen p'otte Devid ọtọhn-ẹ. Ọttọhk f'uwa osi f'ode nkọmẹ ode bẹ́, wa ọd-ọfọhnọ nja obira ọkwọmọ insẹns k'ọja-byi f'ọyaankpa.<verse eid="1KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 3:4" />Ọvaar Sọlọmọn ochina z'Gibeọn bẹ́, ọd-ọfọhnọ nja, okurọ ch'ode za wọ kw'ija-byi s'ibarẹ odik mawuriji ining. Nya wọ kw'uwa ọnang nnanga s'ẹkwọmọ nnọhna mfa okwuma arọbh ijobh. <verse eid="1KI 3:4" /><verse number="5" style="v" sid="1KI 3:5" />Ny'erungọ, ch'Sọlọmọn kk'oyima z'Gibeon, Ọvaar Ibinọkpaabyi oyin okebh-ẹ k'ọda, oben-ẹ bẹ́, “Phyem-m ọttọhk kpenamkpen f'arorọ bẹ́, nnang-ọ.”<verse eid="1KI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 3:6" />Sọlọmọn ọpọhn-ẹ bẹ́, “Kk'ejibha chiden asa anang ọtọhmnọng kwọ Devid kw'ode atte kwaam, okurọ bẹ́, wa okpobh-ọ ọmaana ettem madanẹ, osi ẹmmaana ch'etor-otor, obir oyena ẹmaana ch'ede <char style="it">bẹ́ gbẹẹng</char>. Maa pyirẹ menda, atim achin ororo asi ejibha chiden anang-ẹ, okurọ bẹ́, kọ kk'ẹ nnwa ananga kw'im'otima ẹvaar chẹ.<verse eid="1KI 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 3:7" />“Ofona nya, o Ọvaar Ibinọkpaabyi, kw'ade Ibinọkpaabyi kwaam, kk'kaam ọtọhmnọng kwọ ẹvaar asa bẹ́, ntera eso ch'Devid kw'ode atte kwaam. Okenaka, kaam ntim nde nnwa-nnwa, ose kw'im'nsi ọtọhm faam kinzong. <verse eid="1KI 3:7" /><verse number="8" style="v" sid="1KI 3:8" />Kirẹ kaam ọtọhmnọng kwọ m'ikpakaana s'ọnọng-saabh nwa kw'ikk'ateka kw'ina obhika ode. <verse eid="1KI 3:8" /><verse number="9" style="v" sid="1KI 3:9" />Ofona nya, nang kaam ọtọhmnọng kwọ ezonga ch'im'ntima mbaabha anọng pọ, mbira ntima nzonga odik kw'otor-otor ọmaana kw'ina otorọ, ina minna ode, ọnọng kw'im'okpo ọnọng-saabh nwa ọbaabha kode.”<verse eid="1KI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 3:10" />Wa ettem ẹdaamẹ Ọvaar Ibinọkpaabyi k'ọttọhk f'Sọlọmọn ophyemẹ. <verse eid="1KI 3:10" /><verse number="11" style="v" sid="1KI 3:11" />Nya o, Ibinọkpaabyi oben-ẹ bẹ́, “Ch'ina kaam akpen p'adum-odum aphyemẹ, kaam ojibhada kabira aphyem, kaam kabira aphyem bẹ́, mfhọ awawunanọng pọ, atera aphyem-m ezonga ch'im'atima akpaara aponga k'eden ch'etor-otor, <verse eid="1KI 3:11" /><verse number="12" style="v" sid="1KI 3:12" />kaam m'nsi ọttọhk f'aphyemẹ. M'nnang-ọ ezonga, ọmaana ọyaanttaana kw'ettem, ọfha ọnọng oning oning kw'uwa ikk'ọda mach'ikọ, wanẹma, kw'ikwuna m'ode mach'ikọ. <verse eid="1KI 3:12" /><verse number="13" style="v" sid="1KI 3:13" />Kaam m'mbira nnang-ọ ekpo mbyoza py'ina kaam aphyemẹ, ekpo mach'ojibhada ọmaana ikpobhaakka, ọfha k'akpen pọ maphyir, ọvaarnọng oning oning kw'im'ode mbengana ọmaan-ọ. <verse eid="1KI 3:13" /><verse number="14" style="v" sid="1KI 3:14" />Ó̱de atorọ eden chaam, akpobha apaanga ọmaana asana paam k'ose kw'Devid kw'ode atte osi, kaam m'nnang-ọ akpen p'adum-odum.”<verse eid="1KI 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 3:15" />Nya wọ kw'Sọlọmọn nogbe z'ọda, otin bẹ́, idachen jọ. Ọkpa nnam z'Jẹrusalẹm, od-obe ny'ititika s'Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, oninga nya ọfọhnọ nja s'ẹkwọmọ ọmaana nnanga s'eforgbaka. Ocher nya o, osi odidaama ọnang atọhmnọng pẹ maphyir.<verse eid="1KI 3:15" /></para>
  <para style="s1">Sọlọmọn ọkọhk ezonga chẹ</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 3:16" />K'ogbe wanẹ, azaza afa akwu akebha ọvaarnọng nya. <verse eid="1KI 3:16" /><verse number="17" style="v" sid="1KI 3:17" />Oyok wanẹ oben bẹ́, “Ttatta kwaam, kaam ọmaana kwanọng nwa mọtọn oruk k'ọsọhm mawanẹ. Kaam mmaanẹ nnwa k'ogbe kw'oning ny'ọsọhm ọmaan-m. <verse eid="1KI 3:17" /><verse number="18" style="v" sid="1KI 3:18" />Ny'ewu ttong ittaan ch'mmaanẹ nnwa kwaam, kwanọng nwa obira ọmaan nnwa ọdọk. Ny'ọsọhm nwo, mode mina anọng afa bẹ-bẹ. Ọnọng ọdọk-ọdọk kw'oning nya ọmaana mina kode.<verse eid="1KI 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 3:19" />“Otum ny'erungọ, nnwa kw'kwanọng nwa ope, okurọ ch'oyim ọyak-ẹ. <verse eid="1KI 3:19" /><verse number="20" style="v" sid="1KI 3:20" />Minna kw'obin ny'orungittem, ny'ogbe kw'kaam ntim nttaabh-ọttaabha, otinẹ nnwa kwaam za ch'oyim ọmaan-m, orurọ ọnyọma ẹba chẹ, okwu otinẹ kwẹ kw'ikk'ọpa, orurọ ọnyọma ẹba chaam. <verse eid="1KI 3:20" /><verse number="21" style="v" sid="1KI 3:21" />K'ogbe kw'ewu ikk'esobha, mbina bẹ́, nnang nnwa kwaam ẹba, nze bẹ́, kk'ọpa. Ewu ẹttaanẹ nya o, nkker-ẹ mawuriji, nze bẹ́, nnwa kw'mmaanẹ azang nya.”<verse eid="1KI 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 3:22" />Kwanọng nwoza oben bẹ́, “Mma! Nnwa kw'oruk-oruk wọ ode kwaam, nwo kw'ikk'ọpa ode kwọ.”</para>
  <para style="p" vid="1KI 3:22">Ocheden-kwanọng ọgbana bẹ́, “Mma! Nnwa kw'oruk-oruk ode kwaam, nwo kw'ikk'ọpa ode kwọ.” Minna kw'makaang ayok odik nwo ny'ọvaarnọng k'ititika.<verse eid="1KI 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 3:23" />Ọvaarnọng oben bẹ́, “Oyok wanẹ od-oben bẹ́, ‘Nnwa kwaam wọ orukọ akpen, kwọ wọ opope’, oyok nwoza oben bẹ́, ‘Mma! Kwọ wọ opope, kwaam orukọ akpen.’ ”<verse eid="1KI 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 3:24" />Nya kw'ọvaarnọng nobenẹ bẹ́, “Mànang-m ọkkangkkang.” Matọka ọkkangkkang achen-ẹ. <verse eid="1KI 3:24" /><verse number="25" style="v" sid="1KI 3:25" />Ọvaarnọng ọnang ẹfa, oben bẹ́, “Màkebh nnwa kw'orukọ akpen agboka afa. Màtọka igboka janẹ nang oyok wanẹ, màtọka igboka njoza anang oyok nwoza.”<verse eid="1KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 3:26" />Kwanọng nwo kw'oyen nnwa kw'orukọ akpen otima ẹ́kká-ttem, oben ọvaarnọng bẹ́, “Ttatta kwaam, ototo, tte nnwa nwo kw'oruk akpen ọbọhk nang-ẹ za! Kẹ kafhọ!”</para>
  <para style="p" vid="1KI 3:26">Okenaka, kwanọng nwoza oben bẹ́, “Mina anọng afa, ọnọng kw'im'oyena nnwa nwo kode. Màkebh-ẹ k'ibyi ifa!”<verse eid="1KI 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 3:27" />Nya o, ọvaarnọng ọkpaara aponga mbo, oben bẹ́, “M'nnwa nwo kw'orukọ akpen kafhọ. Màtọk-ẹ nang ocheden-kwanọng nwo, kirẹ kẹ wọ ode ọkka.”<verse eid="1KI 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 3:28" />K'ogbe kw'anọng p'Israẹl maphyir mabhaang aponga mbo p'ọvaarnọng ọkpaar nya, bẹ maphyir maninga k'ojora f'ọvaarnọng, okurọ ch'maze bẹ́, Ibinọkpaabyi kk'ẹ ezonga ọnanga ch'otim ọkpaara aponga k'eden ọkkọkka.<verse eid="1KI 3:28" /></para>
  <chapter eid="1KI 3" />
  <chapter number="4" style="c" sid="1KI 4" />
  <para style="s1">Asonọng p'Sọlọmọn otim ọbaabha</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 4:1" />Ọvaar Sọlọmọn wọ uwa ọbaabh Israẹl maphyir. <verse eid="1KI 4:1" /><verse number="2" style="v" sid="1KI 4:2" />Asonọng p'uwa otim ọbaabha made:</para>
  <para style="b" vid="1KI 4:2" />
  <para style="li1" vid="1KI 4:2">Azariya kw'ode nnwa kw'Zadọk, kw'ode ọfọhn-ẹja:<verse eid="1KI 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1KI 4:3" />Eliorẹph ọmaana Ahija p'ade iva p'Shisha, made akkẹrẹ;</para>
  <para style="li1" vid="1KI 4:3">Jehoshaphat kw'ode nnwa kw'Ahilud, ode oye-idik;<verse eid="1KI 4:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1KI 4:4" />Bẹnaya kw'ode nnwa kw'Jehoyada, ode oso kw'asoja;</para>
  <para style="li1" vid="1KI 4:4">Zadọk ọmaana Abiyata, made afọhn-ẹja;<verse eid="1KI 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1KI 4:5" />Azariya kw'ode nnwa kw'Natan, okkerẹ anọng p'abaabh nkọma;</para>
  <para style="li1" vid="1KI 4:5">Zabud kw'ode nnwa kw'Natan, ode ọfọhn-ẹja, ọmaana ọnọng kw'ọd-ọnang ọvaarnọng ntọhna;<verse eid="1KI 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1KI 4:6" />Ahishar, ode okkerẹ-itọhm s'odimpa;</para>
  <para style="li1" vid="1KI 4:6">Adoniram kw'ode nnwa kw'Abda, okkerẹ itọhm s'mad-agwa anọng k'ẹfa.<verse eid="1KI 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="1KI 4:7" />Kibung-kibungọ, wa Sọlọmọn oyen anọng ijobh kkamfa p'abaabh nkọma s'Israẹl maphyir. Bẹ bọ uwa mad-aror ọchattọhk achena ọvaarnọng ọttara ẹsọhmmọr chẹ. K'icho kibungọ, wa ọnọng-ọnọng od-oror ọchattọhk f'ophe mawanẹ ochena ọvaarnọng. <verse eid="1KI 4:7" /><verse number="8" style="v" sid="1KI 4:8" />Wa ache p'avaarnọng mbo ade</para>
  <para style="b" vid="1KI 4:8" />
  <para style="li1" vid="1KI 4:8">Bẹn-Hur, kw'ọbaabh ẹkọma ch'Ephraim kw'ode obhon kw'ọnan k'egbe.<verse eid="1KI 4:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1KI 4:9" />Bẹn-Dẹkẹr, kw'ọbaabh Makaz, ọmaana Shalbim, ọmaana Bẹt-Shẹmẹsh, ọttara Ẹlọn-Bẹtanan;<verse eid="1KI 4:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1KI 4:10" />Bẹn-Hẹsẹd, ọbaabha Arubot. (Kẹ wọ uwa obira ọbaabha Soko ọmaana Hẹphẹr kibungọ);<verse eid="1KI 4:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1KI 4:11" />Bẹn-Abinadab, ọbaabh Naphot-Dọr. (Kẹ wọ uwa ọtọk Taphat kw'ode ominanwa kw'Sọlọmọn k'ọbada);<verse eid="1KI 4:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1KI 4:12" />Baana kw'ode nnwa kw'Ahilud, ọbaabh Taanak, ọmaana Megido, ọmaana ẹkọma ch'Bẹt-Shan maphyir ch'ening ẹnyọma Zarẹtan, z'ẹwọn-ẹwọna kw'Jẹzrẹl. Ọbaabha tọma ny'Bẹt-Shan maa, pyirẹ Abẹl-Mẹhola, maa, jeka z'Jokmeam;<verse eid="1KI 4:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1KI 4:13" />Bẹn-Gẹbẹr, ọbaabha Ramọt-Gilead. (Wa obira ọbaabha abhonva ny'Gilead p'Jair kw'ode nnwa kw'Manasẹ ọbaabh, ọmaana nkọma s'Argọb s'ining z'Bashan, ọttara ibhondim arọbh attaan s'matim bronz asi mbhumma sabẹ;<verse eid="1KI 4:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1KI 4:14" />Ahinadab kw'ode nnwa kw'Ido, ọbaabha Mahanayim;<verse eid="1KI 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1KI 4:15" />Ahimaz, ọbaabha Naphtali. (Kẹ wọ uwa ọtọk Basemat kw'ode ominanwa kw'Sọlọmọn k'ọba);<verse eid="1KI 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1KI 4:16" />Baana kw'ode nnwa kw'Hushayi, ọbaabha Ashẹr ọmaana Alọt;<verse eid="1KI 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1KI 4:17" />Jehoshaphat kw'ode nnwa kw'Parua, ọbaabha Isaka;<verse eid="1KI 4:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1KI 4:18" />Shimeyi kw'ode nnwa kw'Ẹla, ọbaabha Bẹnjamin;<verse eid="1KI 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1KI 4:19" />Gẹbẹr kw'ode nnwa kw'Uri, ọbaabha Gilead. (Wa ọvaar Sihọn kw'Amọr ọmaana ọvaar Ọg kw'Bashan nkk'ẹkọma nda achi eden abaabha). Kẹ-kẹ wọ uwa ode ọbaabh kw'ẹkọma ndo maphyir.<verse eid="1KI 4:19" /></para>
  <para style="s1">Ezonga ch'Sọlọmọn ọmaana oyena kwẹ</para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 4:20" />Wa anọng p'Juda ọmaana p'Israẹl masaabhẹ mach'ofong kw'ẹraangaka. Mad-achi, magwo mabira aninga k'ottemlebh. <verse eid="1KI 4:20" /><verse number="21" style="v" sid="1KI 4:21" />Wa Sọlọmọn ọbaabh nkọma maphyir, s'itọm z'ọraanga kw'Yupharetes maa, ipyirẹ z'izek s'Philistiya. Ẹbaabha ndo etima minna maa, epyirẹ z'enem ch'Ijip. K'akpen p'Sọlọmọn maphyir, wa nkọma nja ining izek-izek kwẹ, ibira id-inang-ẹ ntuma.<verse eid="1KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 4:22" />Ọchattọhk f'uwa Sọlọmọn ororọ k'ewu-k'ewu, ode abushẹl p'agwubuma arọbh achenọmfa okwuma ijobh, ọmaana abushẹl p'ẹchakpo ọdọk-ọdọk arọbh ichi, <verse eid="1KI 4:22" /><verse number="23" style="v" sid="1KI 4:23" />ọmaana abhaam ijobh p'manangẹ ọchattọhk z'ọbhaamsọhm, ọmaana abhaam ẹrọbh p'ad-azenga achi azizaarẹ, ọmaana arọkimaan arọbh achen, ọmaana avu, ọmaana achimẹ, ọmaana ayibh, ọttara ọnọhn f'ọbar-ọbar. <verse eid="1KI 4:23" /><verse number="24" style="v" sid="1KI 4:24" />Wa ọbaabh nkọma njo maphyir s'ining z'ọraanga kw'Yupharetes, z'ẹbhaakẹ ch'ewuchen ed-edimẹ, tọma z'Tiphsa, pyirẹ z'Gaza. Wa orukọ k'ẹmẹm ọmaana obhon kpenamkpen kw'mayen ayok enem. <verse eid="1KI 4:24" /><verse number="25" style="v" sid="1KI 4:25" />K'ogbe kw'Sọlọmọn oruk akpen, Israẹl ọmaana Juda maning k'ẹmẹm, tọma z'Dan maa, pyirẹ z'Beershẹba, ọnọng-ọnọng oyen agrepchi ọmaana afigchi pẹ.<verse eid="1KI 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 4:26" />Wa Sọlọmọn oyen obyi nnọhna ijobh f'mad-asok ijaar s'nnyanya id-itọr, obira oyena nnyanya nnọhna ẹrọbh okwuma ijobh.<verse eid="1KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 4:27" />K'ophe kpenamkpen, abaabh p'nkọma njo, óphe kw'ọnọng-ọnọng opyirẹ, mad-atọka ẹchakpo z'ẹkọma ch'mabaabh, machena ọvaar Sọlọmọn k'ose kw'im'obenga anọng p'ad-achi ọttọhk amaan-ẹ. Wa mobhokọ kw'owora kasokọ. <verse eid="1KI 4:27" /><verse number="28" style="v" sid="1KI 4:28" />Minna kw'mabira atima abarli ọmaana azizaarẹ-bukọ p'nnyanya s'id-itọr ijaar, ọmaana nnyanya njoza, k'ose kw'ọtabha kw'ọnọng-ọnọng ode. Matọka ekpo mbyo asok k'ibyi s'ibaan-ọbaana.<verse eid="1KI 4:28" /></para>
  <para style="s1">Ezonga ch'Sọlọmọn</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 4:29" />Ibinọkpaabyi ọnang Sọlọmọn ezonga, ọmaana ọyaanttaana ọttara edikzonga chiden ch'ede mach'ofong kw'ẹraangaka kw'ina obhika ede. <verse eid="1KI 4:29" /><verse number="30" style="v" sid="1KI 4:30" />Wa ezonga ch'Sọlọmọn ẹyọhng ch'ọnọng kpenamkpen kw'ofon z'ẹbhaakẹ ch'ewuchen ed-eyin, ebira ẹyọhnga ch'anọng p'Ijip maphyir. <verse eid="1KI 4:30" /><verse number="31" style="v" sid="1KI 4:31" />Wa ọyọhng anọng maphyir k'ezonga. Oyena ezonga ọyọhnga Ẹtan kw'ofon Ẹzra. Obira oyena ezonga ọyọhnga ajinọngva p'Mahọl p'ade Heman, ọmaana Kalkol, ọttara Darda. Eche chẹ ẹnyaamẹ ny'nkọma maphyir s'manyọm ayok. <verse eid="1KI 4:31" /><verse number="32" style="v" sid="1KI 4:32" />Wa ọgbaakẹ nzẹmẹ nnọhna ichenọmfa okwuma arọbh ijobh. Obira ọkkọhn amọng nnọhna mfa okwuma arọbh ijobh okwuma achen. <verse eid="1KI 4:32" /><verse number="33" style="v" sid="1KI 4:33" />Ọgbaak idik s'imaan ekpo py'emen-omen, tọma k'ochi kw'sida ch'emenẹ z'Lebanọn, tto z'hisop kw'omenẹ k'ntumọ, ọmaana idik s'imaan k'mgbaten, ọmaana ọnọhn, ọmaana ọjọhk, ọmaana nten s'itim mkpabhọr izenga, ọttara nten s'asi. <verse eid="1KI 4:33" /><verse number="34" style="v" sid="1KI 4:34" />Wa avaar p'nkọma s'iyagbin maphyir p'abhaang ezonga ch'Sọlọmọn, mad-atọhm anọng za bẹ́, mad-ayonga itọhng k'ezonga chẹ.<verse eid="1KI 4:34" /></para>
  <chapter eid="1KI 4" />
  <chapter number="5" style="c" sid="1KI 5" />
  <para style="s1">Nttọhna s'Ọsọhm kw'Ibinọkpaabyi osisi</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 5:1" />Wa ọvaar Hiram kw'Taya, kw'ozeng iyok ọmaana Devid, ọbhaang bẹ́, nkk'Sọlọmọn ayaana bẹ́, otima ẹvaar ch'otte Devid. Minna kw'ọtọhm atọhmnọng banẹ pẹ z'Sọlọmọn bẹ́, mazim-ẹ. <verse eid="1KI 5:1" /><verse number="2" style="v" sid="1KI 5:2" />Sọlọmọn ọbhaang ezima ndo nya o, ọtọhm ẹkkaabha ochena Hiram, oben bẹ́:<verse eid="1KI 5:2" /></para>
  <para style="pm">
    <verse number="3" style="v" sid="1KI 5:3" />“Kọ azong ma bẹ́, wa Devid kw'ode atte kwaam, obenẹ bẹ́, osi Ọsọhm kw'otim eche ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwẹ. Okenaka, kokpo osi okurọ ch'iwa awawunanọng pẹ matim mgbong akọbh-ẹ ọkọbha. Wa ọsọhm nwo kosi maa, opyirẹ ny'ogbe kw'Ọvaar Ibinọkpaabyi okem awawunanọng mbo pẹ maphyir. <verse eid="1KI 5:3" /><verse number="4" style="v" sid="1KI 5:4" />Ma ch'nning ma, Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwaam kk'aam ẹmẹm ọnanga k'ibyi kpenamkpen. Ọdọk ọwawunanọng kinyen, itama kaam kibir ikebha. <verse eid="1KI 5:4" /><verse number="5" style="v" sid="1KI 5:5" />Nya wọ osi o, nkamẹ bẹ́, nsi Ọsọhm kw'im'otima eche ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwaam, k'ose kw'uwa Ọvaar Ibinọkpaabyi obenẹ Devid kw'ode atte kwaam bẹ́, ‘Nnwa kwọ kw'im'ọtọka eninga chọ, kẹ wọ im'osi Ọsọhm kw'Ibinọkpaabyi kw'mm'aninga akpobha eche chaam.’<verse eid="1KI 5:5" /></para>
  <para style="pm">
    <verse number="6" style="v" sid="1KI 5:6" />“Ofona nya, ke ẹfa bẹ́, màkkọhbh nchi s'sida z'Lebanọn anang-m. Kaam m'ntọhm atọhmnọng paam, makwu ator atọhmnọng pọ masi ọtọhm. M'mbira nnang-ọ akpuka p'ọtọhm k'ose kw'aphyikẹ. Kọ azong za bẹ́, mina m'anọng koyen p'akpo nchi ojijẹ mach'anọng p'Sidon.”<verse eid="1KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 5:7" />Hiram ọbhaang ẹkkaabha ch'Sọlọmọn nya o, ettem ẹdaam-ẹ maa, oben bẹ́, “Tte ẹtọhnga ede ch'Ọvaar Ibinọkpaabyi menda, ch'ọnang Devid nnwa kw'oyen ezonga bẹ́, ọbaabha ẹkọma katam nda.”<verse eid="1KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 5:8" />Minna kw'Hiram ọnang Sọlọmọn ẹpọhna, oben bẹ́:</para>
  <para style="pm" vid="1KI 5:8">“Kaam kk'ẹkkaabha chọ mmaanga. Kaam kk'ifor nda bẹ́, nsi okpenamkpen f'arorọ. M'nnang-ọ nchi njo s'sida ọmaana s'junipa ọnang.<verse eid="1KI 5:8" /></para>
  <para style="pm">
    <verse number="9" style="v" sid="1KI 5:9" />Ajinọng paam màtima jẹ abina z'Lebanọn asaka z'Ọraanga kwiden. Nya kw'im'ntọhn jẹ, k'ose kw'mm'ayaar ny'asi atima achina k'ibyi kpenamkpen s'arorọ bẹ́, masok. Nya wọ kw'm'nchaarẹ jẹ k'ose kw'im'atọka atima afona. F'im'asi anang kaam ode bẹ́, anang ẹsọhmmọr chaam ọchattọhk f'mm'achi.”<verse eid="1KI 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 5:10" />Minna kw'Hiram ọnang Sọlọmọn nchi njo maphyir s'sida ọmaana s'junipa k'ose kw'ororọ. <verse eid="1KI 5:10" /><verse number="11" style="v" sid="1KI 5:11" />Sọlọmọn ọnang ẹsọhmmọr ch'Hiram awit p'ade azaangva nnọhna arọbh afa okwuma ijobh, ọmaana ana-chang nnọhna arọbh afa okwuma ijobh p'oliv kw'nkk'amyaana. Wa Sọlọmọn ọd-ọnang Hiram ekpo mbya k'icho k'icho. <verse eid="1KI 5:11" /><verse number="12" style="v" sid="1KI 5:12" />Minna kw'Ọvaar Ibinọkpaabyi ọnang Sọlọmọn ezonga k'ose kw'ikk'ocheka ọnang-ẹ. Kẹ Hiram ọmaana Sọlọmọn makwu aruk k'ẹmẹm. Ofona nya, madim k'ẹttọhna.<verse eid="1KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 5:13" />Ọvaar Sọlọmọn ozeng ny'Israẹl maphyir, ọ̀gwà anọng nnọhna arọbh attaan okwuma ichi k'ẹfa bẹ́, masi itọhm. <verse eid="1KI 5:13" /><verse number="14" style="v" sid="1KI 5:14" />Ọtọhm bẹ z'Lebanọn. Wa k'ophe kpenamkpen, ọd-ọtọhm ẹkaan ch'atọhmnọng nnọhna ẹrọbh okwuma nchen z'Lebanọn. Mm'aninga ophe mawanẹ z'Lebanọn, maninga aphe afa z'obhon kwabẹ. Adoniram wọ uwa od-okkerẹ atọhmnọng mbo p'magwa k'ẹfa. <verse eid="1KI 5:14" /><verse number="15" style="v" sid="1KI 5:15" />Wa Sọlọmọn obira oyena anọng nnọhna ochenọnttaan okwuma ichi p'ad-atọhka ekpo, ọmaana anọng nnọhna arọbh ijobh p'ad-aphaakẹ ata z'ẹkọma ch'agbe, <verse eid="1KI 5:15" /><verse number="16" style="v" sid="1KI 5:16" />ọttara anọng nnọhna ochenọnttaan okwuma ẹrọbh okwuma achen p'ad-akkerẹ ọtọhm. <verse eid="1KI 5:16" /><verse number="17" style="v" sid="1KI 5:17" />Ọvaarnọng ọnang ẹfa bẹ́, atọhmnọng mbo maphaakẹ atakpa piden p'ajibh-ojibh, mfha matima aphaakẹ izek s'Ọsọhm kw'Ibinọkpaabyi. <verse eid="1KI 5:17" /><verse number="18" style="v" sid="1KI 5:18" />Amengkkanọng p'Sọlọmọn, ọmaana p'Hiram, ọmaana atọhmnọng p'abin z'Gẹbal, magbaka mbọhk makpaara nchi ọmaana ata mbo k'eden ch'mm'atima asi Ọsọhm kw'Ibinọkpaabyi.<verse eid="1KI 5:18" /></para>
  <chapter eid="1KI 5" />
  <chapter number="6" style="c" sid="1KI 6" />
  <para style="s1">Sọlọmọn osi Ọsọhm kw'Ibinọkpaabyi</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 6:1" />Wa Sọlọmọn ọtọm Ọsọhm kw'Ọvaar Ibinọkpaabyi osisi k'ophe kw'Ziv, kw'ode ophe kw'ottong afa kw'icho nna s'ọbaabh Israẹl. Wa node icho ẹnọhna okwuma arọbh anna kw'anọng p'Israẹl mabin arik Ijip.<verse eid="1KI 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 6:2" />Ọsọhm nwo kw'uwa ọvaar Sọlọmọn osi ọnang Ọvaar Ibinọkpaabyi, wa ode ntọkọ arọbh anna okwuma ijobh k'adum, ẹkpa chẹ ede ntọkọ ẹrọbh okwuma ijobh, agoriji pẹ ade ntọkọ arọbh afa okwuma nchen. <verse eid="1KI 6:2" /><verse number="3" style="v" sid="1KI 6:3" />Adum p'ẹsọhmva ch'iyaan ade ntọkọ ẹrọbh okwuma ijobh, kw'ode mbengana mach'ẹkpa ch'Ọsọhm kw'Ibinọkpaabyi. Bina ny'ẹsọhmva ndo pyirẹ ny'ititika s'Ọsọhm kw'Ibinọkpaabyi, ode ntọkọ ichi. <verse eid="1KI 6:3" /><verse number="4" style="v" sid="1KI 6:4" />Osi amma p'ofum z'ẹrọng-ẹrọng kw'ntumọ s'Ọsọhm kw'Ibinọkpaabyi mabhọk-ọbhọkọ. <verse eid="1KI 6:4" /><verse number="5" style="v" sid="1KI 6:5" />Oke etumọ ọkọbha ọsọhm kw'Ibinọkpaabyi ọmaana ibyi s'awuriji, pira nọjọhkọ adongọva ọbọka ny'etumọ ch'ọsọhm nwo. <verse eid="1KI 6:5" /><verse number="6" style="v" sid="1KI 6:6" />Ọgbaarẹ kw'izek-izek ode ntọkọ nchenọmfa ọmaana ibhaaka, ọgbaarẹ kw'njeka ode ntọkọ osowanẹ, ọgbaarẹ kw'ebir-ebir ode ntọkọ ijobh ọmaana ibhaaka. Osi otergba obubha ny'ntumọ njo maphyir, mfha ọnọng oning z'iyaan oning ọnọhma ọttọhk maa, oyin z'etumọ ch'Ọsọhm kw'Ibinọkpaabyi.<verse eid="1KI 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 6:7" />Ny'ogbe nwo kw'mad-asi Ọsọhm kw'Ibinọkpaabyi, wa matim ata p'nkk'aphaaka z'ibyi s'ata. Wa ọnọng ẹmọng ch'ọttọhk f'mamin-omin kọbhaang, ch'ọttọhk f'madọng-ọdọngọ kọbir ọbhaanga, ozeng k'ẹmọng ch'ọtọhm-ttọhk ọdọk-ọdọk, ọnọng kọbhaang.<verse eid="1KI 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 6:8" />Wa ọmma kw'ọgbaarẹ kw'izek-izek oning z'ẹwọn-ẹwọna kw'Ọsọhm nwo. Abhuka pẹ atima minna maa, mayaakẹ z'ọgbaarẹ kw'ottem, mabira atima minna maa, mayaakẹ z'ọgbaarẹ kw'oning z'ebir-ebir. <verse eid="1KI 6:8" /><verse number="9" style="v" sid="1KI 6:9" />Minna kw'Sọlọmọn osi Ọsọhm nwo kw'Ibinọkpaabyi maa, ọsa. Otima agbaakakpa ọmaana agbaaka p'sida obubha wẹ. <verse eid="1KI 6:9" /><verse number="10" style="v" sid="1KI 6:10" />Ọkkọma odongọ ny'ntumọ njo maphyir s'Ọsọhm kw'Ibinọkpaabyi ọtọhnga ny'agbaaka mbo p'ochi kw'sida. Agoriji p'idongọ kpenamkpen nya ide ntọkọ nchenọmfa ọmaana ibhaaka.<verse eid="1KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 6:11" />Nya o, Ọvaar Ibinọkpaabyi oben Sọlọmọn bẹ́: <verse eid="1KI 6:11" /><verse number="12" style="v" sid="1KI 6:12" />“Ó̱dik ókurọ Ọsọhm nwa kw'ad-asi ma, óde atorọ asana ọmaana apaanga paam, abira araka eso anang-m, kaam m'nzenga ny'ikọ, nsi f'uwa nchekẹ nnang Devid kw'ode atte kwọ. <verse eid="1KI 6:12" /><verse number="13" style="v" sid="1KI 6:13" />Kaam m'nruk ny'ottem kw'anọng p'Israẹl. Kaam anọng paam p'ade Israẹl mìmbhum.”<verse eid="1KI 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 6:14" />Minna kw'Sọlọmọn osi Ọsọhm nwo kw'Ibinọkpaabyi, ochera. <verse eid="1KI 6:14" /><verse number="15" style="v" sid="1KI 6:15" />Otima agbaakakpa p'ochi kw'sida ọbhọrọ ẹtaang-ẹtaanga kw'Ọsọhm nwo, tọma z'ọgbaarẹ pyirẹ z'mgbodo. Pira notim agbaakakpa p'ochi kw'junipa, ọbhọrọ ọgbaarẹ maphyir. <verse eid="1KI 6:15" /><verse number="16" style="v" sid="1KI 6:16" />Otima agbaakakpa p'ochi kw'sida okebh idongọ ọdọk-ọdọk ide ntọkọ ẹrọbh okwuma ijobh z'nnam-nnam kw'Ọsọhm nwo ẹtaanga, s'ide Ibyi s'Awuriji p'Ayọhng-ọyọhnga. <verse eid="1KI 6:16" /><verse number="17" style="v" sid="1KI 6:17" />Adum p'ẹgbaarẹkpattem ch'ening ny'ititika s'idongọ njo s'Awuriji p'Ayọhng, made ntọkọ arọbh attaan. <verse eid="1KI 6:17" /><verse number="18" style="v" sid="1KI 6:18" />Z'ẹtaanga kw'Ọsọhm nwo kw'Ibinọkpaabyi, wa otim agbaakakpa p'ochi kw'sida osi ntumọ sẹ. Madoka adimava ọmaana agbok nya maphyir. Ọttọhk kpenamkpen f'matim nya ode ochi kw'sida, ẹta ny'ọsọhm nwo maze.<verse eid="1KI 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 6:19" />Osi ibyi z'ẹtaanga kw'ibyi s'Awuriji ny'Ọsọhm kw'Ibinọkpaabyi bẹ́, ọnana Ẹkkọhbhọ ch'Echekẹ ch'Ibinọkpaabyi. <verse eid="1KI 6:19" /><verse number="20" style="v" sid="1KI 6:20" />Adum, ọmaana ẹkpa, ọttara agoriji p'ibyi njo s'Awuriji, made ntọkọ ẹrọbh okwuma ijobh. Otima gol ọbhọrọ z'ẹtaanga maphyir. Obira otima gol ọbhọrọ ija-byi s'matim agbaaka p'ochi kw'sida asi. <verse eid="1KI 6:20" /><verse number="21" style="v" sid="1KI 6:21" />Sọlọmọn otima gol ọkkọkka ọbhọrọ ẹtaanga kw'Ọsọhm nwo kw'Ibinọkpaabyi, obira ọgbana mgbakkọhbhọ k'ẹkaan f'ode gol ny'ititika s'ibyi s'Awuriji s'matim gol abhọrọ. <verse eid="1KI 6:21" /><verse number="22" style="v" sid="1KI 6:22" />Minna kw'otim gol ọbhọrọ ẹtaang-ẹtaanga kw'Ọsọhm nwo maphyir. Obira otima gol ọbhọrọ ija-byi s'ining z'ẹtaanga kw'ibyi s'Awuriji.<verse eid="1KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 6:23" />Z'ẹtaang-ẹtaanga kw'ibyi s'Awuriji, otim ochi kw'oliv ọgwa chẹrubim afa. Agoriji p'chẹrub kpenamkpen ade ntọkọ ichi. <verse eid="1KI 6:23" /><verse number="24" style="v" sid="1KI 6:24" />Ebubaang madanẹ ch'chẹrubim kw'ochi eden ede ntọkọ nchenọmfa ọmaana ibhaaka k'adum, ndoza ebir ede ntọkọ nchenọmfa ọmaana ibhaaka. Tọma k'ebubaangso danẹ, pyirẹ z'ebubaangso ndoza, ede ntọkọ ichi. <verse eid="1KI 6:24" /><verse number="25" style="v" sid="1KI 6:25" />Mbubaang s'chẹrub ttong afa ibira ide ntọkọ ichi. Chẹrubim mbo afa wa mabeng ifor, mabir aker ayok. <verse eid="1KI 6:25" /><verse number="26" style="v" sid="1KI 6:26" />Agoriji p'chẹrub kpenamkpen made ntọkọ ichi. <verse eid="1KI 6:26" /><verse number="27" style="v" sid="1KI 6:27" />Ọtọka chẹrubim mbo osok z'ẹtaang-ẹtaanga kw'idongọ kw'Ọsọhm kw'Ibinọkpaabyi. Ebubaang ch'chẹrub wanẹ ẹmmaama etwu etumọ danẹ, ch'chẹrub nwoza ebir ẹmmaama etwu etumọ ndoza. Mbubaang njo sabẹ ikwu twu ayok ny'njeka kw'idongọ njo. <verse eid="1KI 6:27" /><verse number="28" style="v" sid="1KI 6:28" />Otima gol ọbhọrọ chẹrubim mbo.<verse eid="1KI 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 6:29" />Ny'ntumọ s'Ọsọhm kw'Ibinọkpaabyi maphyir, ọmaana s'odongọ, ọgwa chẹrubim, ọmaana ajigba, ọmaana agbok p'nkk'ammaama, otima odoka jẹ z'ẹtaanga ọmaana z'iyaan. <verse eid="1KI 6:29" /><verse number="30" style="v" sid="1KI 6:30" />Obira otima gol oke agbaarẹ z'odongọ f'ẹtaang-ẹtaanga ọmaana f'iyaan-iyaan f'Ọsọhm kw'Ibinọkpaabyi.<verse eid="1KI 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 6:31" />Ny'ẹsọhmma ch'echin z'ẹtaanga kw'ibyi s'Awuriji, otima ochi kw'oliv osi ammakwukpa achen. <verse eid="1KI 6:31" /><verse number="32" style="v" sid="1KI 6:32" />Ny'amma mbo afa p'otim ochi kw'oliv osi, ọgwa chẹrubim, ọmaana ajigba, ọmaana agbok, otima gol kw'maduk-oduk odoka chẹrubim ọmaana ajigba mbo. <verse eid="1KI 6:32" /><verse number="33" style="v" sid="1KI 6:33" />Ny'eden ndo madan-danẹ, otima ochi kw'oliv osi mmakwukchi s'adum, ọmaana ẹkpa chabẹ ede mbengana ny'ẹgbaarẹkpattem ch'Ọsọhm kw'Ibinọkpaabyi. <verse eid="1KI 6:33" /><verse number="34" style="v" sid="1KI 6:34" />Obira otima ochi kw'junipa osi amma afa p'ayen ammakwukpa afa afa. <verse eid="1KI 6:34" /><verse number="35" style="v" sid="1KI 6:35" />Ny'amma mbo, ọgwa chẹrubim, ọmaana ajigba, ọmaana agbok p'nkk'ammaama, pira notim gol kw'maduk-oduk ọbhọrọ pyẹ ose mawanẹ k'ose kw'ikk'pyẹ ọgwa.<verse eid="1KI 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 6:36" />Otima ata p'madok-odoka oyika akaana attaan p'ntumọ s'eterttem. Otima ochi kw'sida osi ibyi s'ammakwukchi anan.<verse eid="1KI 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 6:37" />Wa maphaakẹ izek s'Ọsọhm kw'Ọvaar Ibinọkpaabyi k'ophe kw'Ziv, k'icho ttong nna s'Sọlọmọn ọbaabh Israẹl. <verse eid="1KI 6:37" /><verse number="38" style="v" sid="1KI 6:38" />Ny'icho ttong ijobh kkawanẹ kw'ẹbaabha ch'Sọlọmọn, k'ophe kw'Bul, kw'ode ophe ttong ochenọnttaan, nya kw'uwa Sọlọmọn ocher Ọsọhm kw'Ibinọkpaabyi k'ose kw'matọhn-ẹ. Kibung-kibungọ, wa otim icho ichenọmfa osi Ọsọhm kw'Ibinọkpaabyi.<verse eid="1KI 6:38" /></para>
  <chapter eid="1KI 6" />
  <chapter number="7" style="c" sid="1KI 7" />
  <para style="s1">Sọlọmọn osi ọvaarter kwẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 7:1" />Wa Sọlọmọn otim icho ijobh kanttaan ochera ọvaarter kwẹ osisi, <verse eid="1KI 7:1" /><verse number="2" style="v" sid="1KI 7:2" />okpe ọsọhm nwo bẹ́, Ọvaarter kw'Ẹtam ch'Lebanọn. Adum pẹ ade ntọkọ arọbh achenọmfa okwuma ijobh. Ẹkpa chẹ ede arọbh attaan okwuma ichi. Agoriji pẹ ade ntọkọ arọbh afa okwuma nchen. Ọvaarter nwo oyen mkpọmmachi nna s'ochi kw'sida s'manan agbaaka p'magwọhr-ọgwọhrọ p'ochi kw'sida. <verse eid="1KI 7:2" /><verse number="3" style="v" sid="1KI 7:3" />Wa matim ochi kw'sida mabubha wẹ z'agbaaka mbo p'anan ny'mkpọmmachi. Agbaaka mbo ade arọbh afa okwuma achen, mabir ade ichi-ichi k'ọkaana. <verse eid="1KI 7:3" /><verse number="4" style="v" sid="1KI 7:4" />Oke amma attaan-attaan p'ofum z'ẹrọng, makkerẹ ayok ititika. <verse eid="1KI 7:4" /><verse number="5" style="v" sid="1KI 7:5" />Isọhmma s'ọvaarter nwo maphyir iyen ammakwukchi p'ade ose mawanẹ k'adum, made nkọmẹ k'ẹkpa chabẹ, ininga k'nkwurọ nttaan, ikkerẹ ayok ititika.<verse eid="1KI 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 7:6" />Wa otim mkpọmmachi osi ọpabọhk kw'ode ntọkọ arọbh attaan okwuma ichi k'adum, ẹkpa chẹ ede ntọkọ arọbh afa okwuma nchen. Ny'ititika s'ọpabọhk nwo, wa matim mkpọmmachi asi ẹsọhmva ch'mabubh-obubha.<verse eid="1KI 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 7:7" />Osi idongọ s'ẹvaarkkọhbhọ s'ikẹ min'od-oninga ọttọhna aponga. Otima agbaaka p'ochi kw'sida, ọtọma ny'ọgbaarẹ, obubha idongọ njo maa, opyirẹ z'mgbodo. <verse eid="1KI 7:7" /><verse number="8" style="v" sid="1KI 7:8" />Ọsọhm kw'kẹ oyenẹ m'oruk, kw'ode eterttem ch'ening z'ẹpannam ndoza, ode ose mawanẹ. Wa Sọlọmọn obir osi ọsọhm kw'ode mach'ọvaarsọhm kwẹ, ọnang ominanwa kw'Phero kw'ọtọk k'ọba.<verse eid="1KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 7:9" />Isọhm nja maphyir s'itọm z'iyaan ipyirẹ z'eterttem-gbaakakpa ndo, ibir itọma za ch'maphaakẹ izek, ipyirẹ z'ipatera, wa makkẹbhẹ ata ọkkọkka masọhm-ọsọhmọ, matima asi z'ẹtaanga ọmaana k'iyaan. <verse eid="1KI 7:9" /><verse number="10" style="v" sid="1KI 7:10" />Wa matim ntakpa ọkkọkka aphaakẹ izek s'ọsọhm nwo. Ata banẹ ade ntọkọ ichi, banẹ ade ntọkọ ijobh kkamfa, k'adum. <verse eid="1KI 7:10" /><verse number="11" style="v" sid="1KI 7:11" />Wa mabir atima ata p'agaangẹ ẹphya p'mayom-oyoma z'ẹrọng-ẹrọng kw'ọsọhm nwo, mabir atima ochi kw'sida asi ibyi s'ide ẹnana. <verse eid="1KI 7:11" /><verse number="12" style="v" sid="1KI 7:12" />Wa etumọ ch'matim ata p'madok-odoka ake k'akaana attaan, mabir atima agbaaka p'ochi kw'sida ake ọkaana mawanẹ, ẹkọbh eterttemdim ndo ọkọbha. Minna kw'uwa Ọsọhm kw'Ibinọkpaabyi ode z'ẹtaanga kw'eterttem, ọmaana idongọ s'im'azenga adim z'ẹtaanga.<verse eid="1KI 7:12" /></para>
  <para style="s1">Edoka ch'Ọsọhm kw'Ibinọkpaabyi</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 7:13" />Ọvaar Sọlọmọn ọtọhm ẹkkaabha bẹ́, mayerẹ Hiram z'Taya anang-ẹ. <verse eid="1KI 7:13" /><verse number="14" style="v" sid="1KI 7:14" />Ọkka kw'Hiram wa ode opokwa kw'ofon ẹkọma ch'Naphtali. Otte kwẹ ofon ẹbhaakẹ ch'Taya, ode omengkka kw'od-otima bronz osi ekpo k'akira k'akira. Kẹ Hiram wa ode omengkka kw'oyen ezonga ọmaana ọyaanttaana k'ọttọhk kpenamkpen f'ọmaan bronz. Okwu ochera eyerẹ ch'ọvaar Sọlọmọn bẹ́, okwu osi ọtọhm kpenamkpen f'bronz.<verse eid="1KI 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 7:15" />Otima bronz ọrabha mkpọmmachi mfa. Agoriji p'ẹkpọmmachi kpenamkpen ade ntọkọ ẹrọbh okwuma nchenọmfa. Izizing-izizing kwabẹ ode ntọkọ ichi kkanttaan. <verse eid="1KI 7:15" /><verse number="16" style="v" sid="1KI 7:16" />Z'aso p'mkpọmmachi njo, otima bronz osi ndoka mfa, s'agoriji pabẹ ade ntọkọ nchenọmfa ọmaana ibhaaka. <verse eid="1KI 7:16" /><verse number="17" style="v" sid="1KI 7:17" />Otima obin ochenọmfa f'matim mgbakkọhbhọ ayok, odoka eso ch'ẹkpọmmachi kpenamkpen. <verse eid="1KI 7:17" /><verse number="18" style="v" sid="1KI 7:18" />Osi pomegrenet k'akaana afa, otima ọkọbha ibin kpenamkpen s'otim odoka eso ch'ẹkpọmmachi kpenamkpen. Osi minna k'eso kpenamkpen. <verse eid="1KI 7:18" /><verse number="19" style="v" sid="1KI 7:19" />Wa madok aso p'mkpọmmachi njo s'ẹsọhmma mach'agbok p'lili. Agoriji p'aso mbo made ntọkọ nchadanẹ. <verse eid="1KI 7:19" /><verse number="20" style="v" sid="1KI 7:20" />Ny'ndoka s'aso p'mkpọmmachi njo mfa, ny'ẹrọng-ẹrọng kw'ọttọhk f'okerẹ ọgbangbang oning ọnyọma ibin njo, nya wọ kw'apomegrenet arọbh ijobh aning k'akaana, makọbha aso mbo maphyir. <verse eid="1KI 7:20" /><verse number="21" style="v" sid="1KI 7:21" />Hiram ottima mkpọmmachi njo ny'ẹsọhmva ch'im'azenga adim z'Ọsọhm kw'Ibinọkpaabyi. Okpe ẹkpọmmachi ch'ening ẹwọn-ẹwọna bẹ́, Jakin, okpe ch'ening ebir-ebir bẹ́, Boaz. <verse eid="1KI 7:21" /><verse number="22" style="v" sid="1KI 7:22" />Wa osi aso p'mkpọmmachi njo z'ẹrọng, odoka mach'agbok p'lili. Ny'eden ndo o, ọtọhm f'mkpọmmachi osisi, ọsa.<verse eid="1KI 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 7:23" />Hiram obira otima bronz osi ẹgbangbangjọ chiden ch'asi okike. Ammabem p'ẹgbangbangjọ ndo made ntọkọ ichi. Agoriji pẹ ade ntọkọ nchenọmfa ọmaana ibhaaka. Izizing-izizing kw'ẹgbangbangjọ ndo, ede arọbh afa okwuma nchen. <verse eid="1KI 7:23" /><verse number="24" style="v" sid="1KI 7:24" />Izek-izek kw'ammabem mbo oyen akaana afa p'adimava p'akọbh ẹgbangbangjọ ndo ọkọbha. Wa marabh adimava mbo agbaka z'ẹgbangbangjọ ndo k'ibyi majanẹ.<verse eid="1KI 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 7:25" />Ẹgbangbangjọ ndo ẹnana k'abhaam ijobh kkamfa p'matim bronz asi. Attaan akkerẹ ebir-bir, attaan mboza akkerẹ za ch'ewuchen ed-edimẹ, attaan ọdọk-ọdọk akkerẹ z'ẹwọn-ẹwọna, pira attaan nakkerẹ z'ẹbhaakẹ ch'ewuchen ed-eyin. Bẹ maphyir makpa nnam abọra ayok. <verse eid="1KI 7:25" /><verse number="26" style="v" sid="1KI 7:26" />Wa ẹgbangbangjọ ndo edinẹ mach'ẹbọhk-kpattem. Abem pẹ ade mach'abem p'ọkkọbh, mabir ade mach'agbok p'lili p'ikk'ammaama. Ẹgbangbangjọ ndo etim asi-kpọ p'ade nnọhna nchen.<verse eid="1KI 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 7:27" />Hiram obira otima bronz osi ekpo ijobh mach'ọkpaar kw'ogbin. Okpenamkpen ode ntọkọ nchadanẹ k'adum, ntọkọ nchadanẹ k'ẹkpa, ntọkọ nna ọmaana ibhaaka k'agoriji. <verse eid="1KI 7:27" /><verse number="28" style="v" sid="1KI 7:28" />Eden ch'iwa masi mmo s'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin ede bẹ́, wa mabira asi abem attara ny'okikaan kwabẹ. <verse eid="1KI 7:28" /><verse number="29" style="v" sid="1KI 7:29" />Ny'njeka kw'abem kw'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin, ode ndoka s'nche, ọmaana abhaam, ọmaana acherubim. Z'ẹrọng-ẹrọng ọmaana ny'izek-izek kw'ndoka njo, obir ode nkaar s'agbok p'maduk-oduk. <verse eid="1KI 7:29" /><verse number="30" style="v" sid="1KI 7:30" />Okpenamkpen ny'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin, oyen mmo nna s'matim bronz asi, ọmaana mbaanga s'bronz s'ibọk mmo njo. Okpenamkpen obira oyena ọgbangbang kw'ọnan k'mmo nna s'marabh ẹkaar ch'agbok abẹ k'ẹbhaakẹ kpenamkpen. <verse eid="1KI 7:30" /><verse number="31" style="v" sid="1KI 7:31" />Ny'ẹtaanga kw'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin, ọmma oning nya kw'ode ẹtọkọ madanẹ ọmaana igboka k'adongiji. Oyena mmo s'adum pẹ ade ntọka mfa ọmaana igboka. Ny'abem p'ọmma nwo, masi ndoka akọbha. Abem p'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin ede mbengana, izizing-izizing kede. <verse eid="1KI 7:31" /><verse number="32" style="v" sid="1KI 7:32" />Mmo njo nna ining izek-izek kw'abem kw'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin. Mbaanga s'mmo njo itọhnga ny'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin. Obho kpenamkpen nya, ode ntọkọ mfa ọmaana igboka k'agoriji. <verse eid="1KI 7:32" /><verse number="33" style="v" sid="1KI 7:33" />Osi mmo sabẹ mach'mmo s'ọkpaar kw'ẹnyanya ẹd-ẹtọr, otima bronz ọrabha mbaanga s'ibọk mmo njo.<verse eid="1KI 7:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 7:34" />Ọttọhk kpenamkpen mvo f'okerẹ ọkpaar kw'ogbin, oyen mbọhk-bọka nna. Okonga kpenamkpen oyena ẹbọhk-bọka madanẹ. <verse eid="1KI 7:34" /><verse number="35" style="v" sid="1KI 7:35" />Z'ẹrọng-ẹrọng kw'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin, makpa adikpa p'ade izizing-zizing, adongiji pabẹ made ẹtọkọ madanẹ ọmaana igboka. Mbaanga njo ọmaana abem pẹ, ẹd-ẹgbaka ayok z'ẹrọng kw'ọttọhk mvo f'okerẹ ọkpaar kw'ogbin. <verse eid="1KI 7:35" /><verse number="36" style="v" sid="1KI 7:36" />Ọgwa achẹrubim, ọmaana nche, ọmaana ajigba ọbẹ ny'iyaan-iyaan kw'mbaanga, ọmaana ny'abem, ọttara k'ibyi kpenamkpen s'obhokọ oning. Pira notim ẹkaar ch'agbok, ọbẹ ọkọbha. <verse eid="1KI 7:36" /><verse number="37" style="v" sid="1KI 7:37" />Eden ch'iwa osi ekpo mbyo ijobh py'ekerẹ ọkpaar kw'ogbin ede bẹ́, wa ọrabh byẹ ose mawanẹ, ebira eker ayok.<verse eid="1KI 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 7:38" />Hiram obira otima bronz osi agbangbang ijobh ny'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin. Ọgbangbang kpenamkpen, otim asi-kpọ arọbh ijobh kkamfa. <verse eid="1KI 7:38" /><verse number="39" style="v" sid="1KI 7:39" />Ny'ekpo mbyo py'ekerẹ ọkpaar kw'ogbin, ọtọka echen nya, osok z'ẹwọn-ẹwọna kw'Ọsọhm kw'Ibinọkpaabyi, obir osok echen z'ebir-ebir kw'Ọsọhm nwo. Ọtọka ẹgbangbanjọ chiden osok z'ẹwọn-ẹwọna kw'Ọsọhm nwo, z'ẹbhaakẹ ch'ewuchen ed-eyin. <verse eid="1KI 7:39" /><verse number="40" style="v" sid="1KI 7:40" />Wa obira osi ọzọhka, ọmaana asọvẹl, ọttara agbangbang p'asi ochichakẹ.</para>
  <para style="p" vid="1KI 7:40">Minna kw'Hiram ocher ọtọhm f'Ọsọhm kw'Ọvaar Ibinọkpaabyi, f'osi ọnang ọvaar Sọlọmọn:<verse eid="1KI 7:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1KI 7:41" />wa osi mkpọmmachi mfa,</para>
  <para style="li1" vid="1KI 7:41">ọmaana ndoka s'ikerẹ agbangbang p'manan z'aso p'mkpọmmachi,</para>
  <para style="li1" vid="1KI 7:41">ọmaana atergba afa p'matim adoka agbangbang p'aso p'mkpọmmachi,<verse eid="1KI 7:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1KI 7:42" />ọmaana apomegrenet ẹnọhna, p'magwa ny'atergba mbo afa, (otergba kpenamkpen oyen akaana afa p'pomegrenet, p'mabira atima adoka agbangbang p'aso p'mkpọmmachi),<verse eid="1KI 7:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1KI 7:43" />ọmaana ekpo mbyo ijobh py'ekerẹ ọkpaar kw'ogbin py'etim agbangbang ijobh,<verse eid="1KI 7:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1KI 7:44" />ọmaana ẹgbangbangjọ chiden ch'asi okike, ọttara abhaam ijobh kkamfa p'aning k'izek-izek kwẹ,<verse eid="1KI 7:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1KI 7:45" />ọmaana ọzọhka, ọmaana asọvẹl, ọttara agbangbang p'asi ochichakẹ.</para>
  <para style="b" vid="1KI 7:45" />
  <para style="p" vid="1KI 7:45">Wa Hiram otim bronz kw'ọnọhn k'ekpon, osi ekpo mbya maphyir py'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọnang ọvaar Sọlọmọn. <verse eid="1KI 7:45" /><verse number="46" style="v" sid="1KI 7:46" />Wa ọvaarnọng obenẹ bẹ bẹ́, mabhaabh ididọhbh s'ose z'ẹkpẹmẹ ch'Jọrdan kw'oning k'njeka kw'Sukọt ọmaana Zarẹtan. <verse eid="1KI 7:46" /><verse number="47" style="v" sid="1KI 7:47" />Wa ekpo mbya ẹsaabhẹ maa, Sọlọmọn ọdọk adọhbhiji pabẹ koyom, ozeng k'bronz, adọhbhiji pẹ kobir oyoma.<verse eid="1KI 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 7:48" />Wa Sọlọmọn osi ekpo maphyir py'matim adoka Ọsọhm kw'Ọvaar Ibinọkpaabyi py'ede:</para>
  <para style="b" vid="1KI 7:48" />
  <para style="li1" vid="1KI 7:48">ija-byi s'matim gol asi,</para>
  <para style="li1" vid="1KI 7:48">ọmaana okpokkoro kw'matim gol asi, kw'brẹd kw'Awuriji ọd-ọnana,<verse eid="1KI 7:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1KI 7:49" />ọmaana ettoringkkang-nana ch'matim gol ọkkọkka asi asok ny'ititika kw'ibyi s'Awuriji, (masok nchen k'obhurubọhk, nchen z'odimbọhk),</para>
  <para style="li1" vid="1KI 7:49">ọmaana agbok p'matim gol asi, ọmaana attoringkkang, ọttara mbaanga sẹ,<verse eid="1KI 7:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1KI 7:50" />ọmaana agbangbang p'matim gol ọkkọkka asi, ọmaana attoringkkang-nọhm, ọmaana agbangbang p'asi ochichakẹ, ọmaana agbangbangva p'nd-atima akwọmọ insẹns,</para>
  <para style="li1" vid="1KI 7:50">ọmaana mgbaka s'matim gol asi s'idongọ s'ẹtaang-ẹtaanga, s'ide Ibyi s'Awuriji, ọttara s'amma p'Ọsọhm kw'Ibinọkpaabyi oyenẹ.<verse eid="1KI 7:50" /></para>
  <para style="b" />
  <para style="p">
    <verse number="51" style="v" sid="1KI 7:51" />K'ogbe kw'uwa ọvaar Sọlọmọn ikk'ọtọhm f'Ọsọhm kw'Ọvaar Ibinọkpaabyi ochera, ọtọka ekpo py'awuriji py'iwa Devid kw'ode otte oyen, osok za ch'nd-aye ekpo py'Ọsọhm kw'Ọvaar Ibinọkpaabyi. Wa ekpo mbyo ede silva, ọmaana gol, ọttara ekpo mbyoza py'ndoka.<verse eid="1KI 7:51" /></para>
  <chapter eid="1KI 7" />
  <chapter number="8" style="c" sid="1KI 8" />
  <para style="s1">Matim Ẹkkọhbhọ ch'Echekẹ akwu k'Ọsọhm kw'Ibinọkpaabyi</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 8:1" />Wa ọvaar Sọlọmọn oyerẹ asogbọhkọnọng p'Israẹl ny'Jẹrusalẹm, ọmaana aso p'mfonamma maphyir, ọttara avaar p'nnọmma s'Israẹl bẹ́, makwu, mfha matinẹ Ẹkkọhbhọ ch'Echekẹ ch'Ọvaar Ibinọkpaabyi z'Zayọn, kw'ode ebhondim ch'Devid. <verse eid="1KI 8:1" /><verse number="2" style="v" sid="1KI 8:2" />Ajinọng p'Israẹl maphyir makwu attonga z'ọvaar Sọlọmọn k'ogbe kw'odidaama, k'ophe kw'Ẹtanim, kw'ode ophe kw'ottong achenọmfa k'icho.<verse eid="1KI 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 8:3" />K'ogbe kw'asogbọhkọnọng p'Israẹl maphyir nkk'attonga, afọhn-ẹja atinẹ Ẹkkọhbhọ ndo ch'Echekẹ. <verse eid="1KI 8:3" /><verse number="4" style="v" sid="1KI 8:4" />Matima Ẹkkọhbhọ ndo, ọmaana ikkira s'etobha, ọttara ekpo py'awuriji maphyir py'ening ny'ẹtaanga, akwu z'Ọsọhm kw'Ibinọkpaabyi. Afọhn-ẹja ọttara aLẹvi, matinẹ byẹ. <verse eid="1KI 8:4" /><verse number="5" style="v" sid="1KI 8:5" />Ọvaar Sọlọmọn ọmaana anọng p'Israẹl maphyir p'nkk'attonga nya amaan-ẹ ny'ititika s'Ẹkkọhbhọ ch'Echekẹ, matima arọkimaan k'ọsaabh, ọmaana adamogbodo p'nna obhika ade, mafọhnọ ẹja.<verse eid="1KI 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 8:6" />Afọhn-ẹja mbo matinẹ Ẹkkọhbhọ ndo ch'Echekẹ ch'Ọvaar Ibinọkpaabyi, mad-anana z'ibyi sẹ, z'ẹtaanga kw'ibyi s'awuriji z'Ọsọhm kw'Ibinọkpaabyi, kw'ode Ibyi s'Awuriji p'Ayọhng. Masok Ẹkkọhbhọ ndo k'izek-izek kw'mbubang s'cherubim. <verse eid="1KI 8:6" /><verse number="7" style="v" sid="1KI 8:7" />Achẹrubim mbo ammaama mbubang sabẹ abubha ibyi njo maphyir s'Ẹkkọhbhọ ch'Echekẹ ening, ọttara nzemachi s'nd-atima atọhk-ẹ. <verse eid="1KI 8:7" /><verse number="8" style="v" sid="1KI 8:8" />Wa nzemachi nja idumọ mawuriji. Ọnọng ẹkpọka chabẹ mokpo oze, oye bẹ́, od-obe za ch'Ibyi s'Iwur-owur ining, ny'ititika kw'Ibyi s'Awuriji. Nchi njo itim ining za maa, pyirẹ menda. <verse eid="1KI 8:8" /><verse number="9" style="v" sid="1KI 8:9" />Wa ọttọhk kpenamkpen ny'Ẹkkọhbhọ ch'Echekẹ kode, kw'ọkpanẹ anwẹrta afa p'uwa Mosẹs oyik ny'ẹtaanga, ch'iwa oning z'egbe ch'Horẹb, ny'ogbe kw'uwa Ọvaar Ibinọkpaabyi osi echekẹ ọmaana anọng p'Israẹl ch'nkk'abina z'Ijip.<verse eid="1KI 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 8:10" />K'ogbe kw'afọhn-ẹja mayibhẹ ny'Ibyi s'Awuriji, ebonọ ebubha Ọsọhm kw'Ọvaar Ibinọkpaabyi. <verse eid="1KI 8:10" /><verse number="11" style="v" sid="1KI 8:11" />Ebonọ ndo ẹwọhkọ afọhn-ẹja m'ọdọk ọtọhm fabẹ kakpo asi, okurọ ch'abarada p'Ọvaar Ibinọkpaabyi mafu Ọsọhm kw'Ibinọkpaabyi.<verse eid="1KI 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 8:12" />Nya o, Sọlọmọn oben bẹ́, “Ọvaar Ibinọkpaabyi kk'obena bẹ́, kẹ m'oruk k'ebonọ ch'epyi-opyi; <verse eid="1KI 8:12" /><verse number="13" style="v" sid="1KI 8:13" />ofona nya, kaam kk'ọsọhm kw'abarada nsa nnang-ọ k'odik ọkkọkka, kw'ode iruk-byi sọ ttattampe.”<verse eid="1KI 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 8:14" />Nya ch'ikpakaana njo s'anọng p'Israẹl kibungọ itim ibe nya, ọvaar Sọlọmọn ọbhakẹ nnam, osi bẹ ittabọhng. <verse eid="1KI 8:14" /><verse number="15" style="v" sid="1KI 8:15" />Nya o, oben bẹ́, “Ẹtọhnga ede ch'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl. Kẹ kk'ọbọhk kwẹ oyenẹ otima osi ọttọhk f'otim ẹmma chẹ ochekẹ ọnang Devid kw'ode atte kwaam, ch'obenẹ bẹ́,<verse eid="1KI 8:15" /></para>
  <para style="pm">
    <verse number="16" style="v" sid="1KI 8:16" />‘Tọma za ch'ntim anọng paam p'Israẹl mbina z'Ijip, ebhondim kpenamkpen ny'mfonamma s'Israẹl ntim nteka bẹ́, esi Ọsọhm kw'Ibinọkpaabyi kw'mm'aninga nya akpobha eche chaam. Okenaka, kaam kk'Devid nteka bẹ́, ọbaabha anọng paam p'Israẹl.’<verse eid="1KI 8:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="1KI 8:17" />“Wa obin Devid kw'ode atte kwaam z'ettem bẹ́, osi ọsọhm k'eche ch'Ibinọkpaabyi, kw'mmad-aninga akpobha Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl. <verse eid="1KI 8:17" /><verse number="18" style="v" sid="1KI 8:18" />Okenaka, Ọvaar Ibinọkpaabyi oben Devid kw'ode atte kwaam bẹ́, ‘Kk'asa mawuriji ch'obin-ọ z'ettem bẹ́, asi ọsọhm kw'Eche chaam. <verse eid="1KI 8:18" /><verse number="19" style="v" sid="1KI 8:19" />Zaa wura ode minna, kọ zang im'asi ọsọhm kw'Ibinọkpaabyi. Nnwa kwọ, kw'ode izẹ sọ oyenẹ wọ im'osi ọsọhm kw'Ibinọkpaabyi, k'eche chaam.’<verse eid="1KI 8:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1KI 8:20" />“Ọvaar Ibinọkpaabyi kk'ọsa k'ose kw'ochekẹ. Kaam kk'eso ch'Devid kw'ode atte kwaam, ntera. Ma, n'nnan k'ẹvaarkkọhbhọ ch'Israẹl, k'ose kw'uwa Ọvaar Ibinọkpaabyi ikk'ocheka. Kaam kk'Ọsọhm kw'Ibinọkpaabyi nsa, k'eche ch'ikẹ kw'ode Ọvaar Ibinọkpaabyi kw'Israẹl. <verse eid="1KI 8:20" /><verse number="21" style="v" sid="1KI 8:21" />Kaam kk'ibyi s'Ẹkkọhbhọ ch'Echekẹ m'eninga nsa nya. Ny'Ẹkkọhbhọ ndo, nya kw'Echekẹ ch'Ọvaar Ibinọkpaabyi ochekẹ ọmaana ab'ttatta pamina eyik, k'ogbe kw'uwa otim bẹ obina z'Ijip.”<verse eid="1KI 8:21" /></para>
  <para style="s1">Njọm s'Sọlọmọn ch'otte Ọsọhm ọbọhk ọnang Ibinọkpaabyi</para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 8:22" />Wa Sọlọmọn obe ny'ititika s'ija-byi s'Ọvaar Ibinọkpaabyi, ny'ititika s'ikpakaana s'anọng p'Israẹl k'ibungọ, ọmmaama mbọhk otena z'ọrọngkpakpa, <verse eid="1KI 8:22" /><verse number="23" style="v" sid="1KI 8:23" />oben bẹ́, “O Ọvaar Ibinọkpaabyi, Ibinọkpaabyi kw'Israẹl. Ibinọkpaabyi za kode kw'ode mach'ikọ, z'ẹrọng ọttara m'izek! Kọ nwo kw'ad-akpobha echekẹ ch'ọdaakẹ kw'ayen amaana atọhmnọng pọ, p'akpobh-ọ achina ororo ọmaana ettem madanẹ.<verse eid="1KI 8:23" /></para>
  <para style="pm">
    <verse number="24" style="v" sid="1KI 8:24" />“Kọ kk'echekẹ chọ akpobha, ch'achekẹ anang Devid kw'ode ọtọhmnọng kwọ, kw'ode atte kwaam. K'ose kw'uwa atim ẹmma chọ achekẹ, k'ọbọhk kwọ abira atima asi, mach'ode ma menda.<verse eid="1KI 8:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1KI 8:25" />“O Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl, kpobha nchekẹ sọ s'achekẹ anang ọtọhmnọng kwọ Devid, kw'ode atte kwaam. Wa aben-ẹ bẹ́, ‘Kwuna otera kw'im'ọnana ny'ẹvaarkkọhbhọ ch'Israẹl mowor m'ititika saam, óde iva p'iva pọ mazong bẹ ifor, matima nttem sabẹ azenga amaan-m k'ose kw'ikọ ikk'asa.’ <verse eid="1KI 8:25" /><verse number="26" style="v" sid="1KI 8:26" />O Ibinọkpaabyi kw'Israẹl, tte odik kwọ kw'achekẹ anang ọtọhmnọng kwọ Devid, kw'ode atte kwaam, ode minna.<verse eid="1KI 8:26" /></para>
  <para style="pm">
    <verse number="27" style="v" sid="1KI 8:27" />“Okenaka, ina Ibinọkpaabyi oruk m'izek o? Ozeng k'ọrọngkpakpa kw'ogorọ ọyọhng-ọyọhnga, kọ mokpo obenga. Pira nkwu mben ọsọhm nwa kw'Ibinọkpaabyi kw'ikk'nsa! <verse eid="1KI 8:27" /><verse number="28" style="v" sid="1KI 8:28" />Zaa ode ch'ode, o Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwaam, bhaanga njọm s'ọtọhmnọng kwọ, ọttara nkwukọ sẹ s'ikwosisi. Tte ẹmọng ọttara njọm s'ọtọhmnọng kwọ oze m'ititika sọ menda, ittọ-ọ k'itọhng. <verse eid="1KI 8:28" /><verse number="29" style="v" sid="1KI 8:29" />Tte achen pọ awonga akkerẹ ọsọhm nwa kwọ, k'erungọ ọttara k'ẹya, m'ibyi nja s'abenẹ bẹ́, ‘Eche chaam m'eninga nya,’ ọfha abhaanga njọm s'ọtọhmnọng kwọ im'od-oninga ma oze. <verse eid="1KI 8:29" /><verse number="30" style="v" sid="1KI 8:30" />Bhaanga ẹmọng ch'ọtọhmnọng kwọ, ọttara ch'anọng pọ p'Israẹl, k'ogbe kw'maze njọm akkerẹ ibyi nja. Ninga z'ẹrọng kw'ode irukbyi sọ abhaanga. Íkk'abhaanga, bina anang bẹ.<verse eid="1KI 8:30" /></para>
  <para style="pm">
    <verse number="31" style="v" sid="1KI 8:31" />“Ó̱de ọ́nọng opinẹ oyok-oter kwẹ, k'odik kw'ọbaan bẹ́, m'ochek-ochekẹ, óde okwu ochekẹ m'ititika s'ija-byi sọ, m'ọsọhm nwa kw'Ibinọkpaabyi, <verse eid="1KI 8:31" /><verse number="32" style="v" sid="1KI 8:32" />ninga z'ẹrọng bhaanga, abira asi f'ọbaan. Si aponga p'atọhmnọng pọ, tte itama s'oyok kw'opin-opinẹ ikpẹk-ẹ k'ọttọhk f'ikk'ọsa. Ṉ́nòde ọnọng kw'ina odik ososo ọwọr-ọwọr ozong, tte aponga adaam-ẹ ator k'ose kw'mbọhk sẹ iwurọ.<verse eid="1KI 8:32" /></para>
  <para style="pm">
    <verse number="33" style="v" sid="1KI 8:33" />“K'ogbe kw'ọwawunanọng kk'anọng pọ p'Israẹl okema okurọ k'mpyibha s'masi, óde makpa nnam akwu akebh-ọ, makpobha eche chọ, maze njọm, mabir abhom akpẹk-ọ m'ọsọhm nwa kwọ, <verse eid="1KI 8:33" /><verse number="34" style="v" sid="1KI 8:34" />ninga z'ẹrọng bhaanga ẹmọng chabẹ, abira abina anang anọng pọ p'Israẹl k'epyibha chabẹ, atima bẹ akpa nnam z'izek s'iwa anang ab'ttatta pabẹ.<verse eid="1KI 8:34" /></para>
  <para style="pm">
    <verse number="35" style="v" sid="1KI 8:35" />“K'ogbe kw'agbakẹ ọrọngkpakpa, abira akpọka ẹrọng bẹ́, ening etebhẹ okurọ mpyibha s'anọng pọ masi, óde máze njọm akkerẹ m'ibyi nja, manang eche chọ ikpukpobha, mabir akpa nnam abọra epyibha chabẹ, okurọ itama s'ikk'bẹ asa, <verse eid="1KI 8:35" /><verse number="36" style="v" sid="1KI 8:36" />ninga z'ẹrọng bhaanga, abira abina anang epyibha ch'atọhmnọng pọ p'ade anọng p'Israẹl. Kpebhẹ bẹ oruk kw'otor-otor, abira atebh ẹrọng k'izek s'anang anọng pọ, mach'okebh fabẹ.<verse eid="1KI 8:36" /></para>
  <para style="pm">
    <verse number="37" style="v" sid="1KI 8:37" />“K'ogbe kw'okwo fiden okwu, wanẹma ebubuka, wanẹma ọkọhmaana f'eborakpo, wanẹma mbonana, wanẹma agurubhebhe, wanẹma afha-afha, wanẹma ode bẹ́, ọwawunanọng wọ ọkọbh ebhondim kpenamkpen chabẹ oke k'ettem, wanẹma, okwurọ-dik kpenamkpen, obira ode bẹ́, ọkọhm-kọhmọ wọ okwu, <verse eid="1KI 8:37" /><verse number="38" style="v" sid="1KI 8:38" />ode ọnọng wanẹ m'ẹkaan ch'anọng pọ p'Israẹl oze njọm, wanẹma ophyem-ọ ọttọhk k'ọkọhmaana f'ọnọng-ọnọng ozong bẹ́, ọmmẹ-ẹ z'ettem, ọmmaama mbọhk sẹ otena m'ọsọhm nwa kw'Ibinọkpaabyi, <verse eid="1KI 8:38" /><verse number="39" style="v" sid="1KI 8:39" />ninga z'obhon kwọ z'ẹrọng, abhaanga. Bina nang bẹ, abira asi f'ọbaan. Si nang ọnọng-ọnọng tor k'osisi kwẹ maphyir, ch'ode kọ wọ azong nttem sabẹ (kirẹ kọ-kọ wọ azong nttem s'ayokinọng maphyir), <verse eid="1KI 8:39" /><verse number="40" style="v" sid="1KI 8:40" />mfha bẹ maruk k'ojora kwọ k'akpen pabẹ maphyir, ny'izek s'anang ab'ttatta pamina.<verse eid="1KI 8:40" /></para>
  <para style="pm">
    <verse number="41" style="v" sid="1KI 8:41" />“Ṉ́nòde okikennọng kw'oning m'Israẹl, kw'ozeng eche chọ abẹ́, ofona z'odenbhir okwu, <verse eid="1KI 8:41" /><verse number="42" style="v" sid="1KI 8:42" />m'ofona ny'ikẹ, anọng abhaanga eche chọ ch'ekpobh-okpobha, ọmaana ẹfa chọ, ọmaana idik siden s'ad-asi. Ó̱de ọ́nọngse nwo okwu oze njọm okkerẹ m'ọsọhm nwa kw'Ibinọkpaabyi, <verse eid="1KI 8:42" /><verse number="43" style="v" sid="1KI 8:43" />ninga z'obhon kwọ z'ẹrọng kw'ode iruk-byi sọ, abhaanga. Si okpenamkpen f'okikennọng nwo ophyem-ọ, mfha ayagbin maphyir mazonga eche chọ, mabira ayena ojora fọ, k'ose kw'anọng pọ p'Israẹl mayen ojora k'ikọ. Nya kw'mm'azonga bẹ́, ọsọhm nwa kw'kk'nsa otim Eche chọ.<verse eid="1KI 8:43" /></para>
  <para style="pm">
    <verse number="44" style="v" sid="1KI 8:44" />“K'ogbe kw'anọng pọ mayinẹ egbong amaana awawunanọng pabẹ k'ibyi kpenamkpen s'atọhmọ bẹ, óde maze njọm anang kọ Ọvaar Ibinọkpaabyi, makkerẹ ititika k'ebhondim ch'ikọ ikk'ateka, ọttara k'Ọsọhm kw'Ibinọkpaabyi kw'kk'nsa k'Eche chọ, <verse eid="1KI 8:44" /><verse number="45" style="v" sid="1KI 8:45" />ninga z'ẹrọng bhaanga njọm sabẹ, ọmaana ọttọhk f'maphyem-ọ, anang bẹ ẹkkaana.<verse eid="1KI 8:45" /></para>
  <para style="pm">
    <verse number="46" style="v" sid="1KI 8:46" />“K'ogbe kw'mapin-ọ, pira ọdọk-ọ ọmaana bẹ, ch'ọnọng ina ode kw'oworọ epyibha, óde atọk bẹ anang ọwawunanọng, ọbọka bẹ k'ẹmmọri otima ozeng z'ẹkọma chẹ oyenẹ ch'ebhirẹ eden, wanẹma ch'effor-offora, <verse eid="1KI 8:46" /><verse number="47" style="v" sid="1KI 8:47" />ókwu óde bẹ́, maning z'nkọma s'mabọk bẹ k'ẹmmọri, mabhakẹ nttem sabẹ, makwuk-ọ, maben-ọ bẹ́, ‘Mina nkk'epyibha ọsa, mopin-opinẹ, mobira osi itama mawuriji’, <verse eid="1KI 8:47" /><verse number="48" style="v" sid="1KI 8:48" />óde mátim nttem sabẹ ọmaana agbagba pabẹ maphyir makpa nnam ator-ọ, za ch'awawunanọng pabẹ mabọk bẹ k'ẹmmọri, óde maze njọm akkerẹ m'izek s'iwa anang ab'ttatta pabẹ, m'ebhondim ch'kk'ateka, ọmaana m'ọsọhm kw'kk'nsa k'Eche chọ; <verse eid="1KI 8:48" /><verse number="49" style="v" sid="1KI 8:49" />ninga z'obhon kwọ z'ẹrọng kw'ode irukbyi sọ, abhaanga njọm ọmaana ọttọhk f'maphyem-ọ, anang bẹ ẹkkaana. <verse eid="1KI 8:49" /><verse number="50" style="v" sid="1KI 8:50" />Abira abina anang anọng pọ p'nkk'ọ epyibha asa. Bina nang mpinẹ maphyir s'nkk'ọ asa, abira asi anọng p'abọk bẹ k'ẹmmọri maze bẹ okwo, <verse eid="1KI 8:50" /><verse number="51" style="v" sid="1KI 8:51" />kirẹ bẹ bọ made anọng pọ oyenẹ, mabira ade oyena kwọ, kw'atim abina z'Ijip, kw'arọbh z'ekpon ch'ẹd-ẹyaana mgbaka.<verse eid="1KI 8:51" /></para>
  <para style="pm">
    <verse number="52" style="v" sid="1KI 8:52" />Tte achen pọ awonga aze ọttọhk f'kaam ọtọhmnọng kwọ mphyem-ọ, ọmaana f'anọng pọ p'ade Israẹl. Yonga bẹ itọhng k'ogbe kpenamkpen kw'mabhomọ akpẹk-ọ. <verse eid="1KI 8:52" /><verse number="53" style="v" sid="1KI 8:53" />Kirẹ kọ wọ uwa atim Mosẹs kw'ode ọtọhmnọng kwọ asi ẹyaakẹ bẹ́, bẹ bọ p'atek m'nkọma s'iyagbin maphyir bẹ́, made anọng pọ oyenẹ, ny'ogbe kw'uwa kọ Ọvaar Ibinọkpaabyi kw'ọyọhng, atim ab'ttatta pamina abina z'Ijip.”<verse eid="1KI 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1KI 8:54" />K'ogbe kw'Sọlọmọn kk'njọm nja ọza maphyir, ọmaana idik s'ophyemẹ Ọvaar Ibinọkpaabyi, obina ny'ititika s'ija-byi s'Ọvaar Ibinọkpaabyi, s'iwura ọtọm k'ogbe ottima ndudungọ, ọmmaama mbọhk otena z'ẹrọng. <verse eid="1KI 8:54" /><verse number="55" style="v" sid="1KI 8:55" />Obe ny'iyokinọng-kpakaana njo s'Israẹl maphyir, osi bẹ ittabọhng, oben k'ẹrọng bẹ́:<verse eid="1KI 8:55" /></para>
  <para style="pm">
    <verse number="56" style="v" sid="1KI 8:56" />“Ẹtọhnga ede ch'Ọvaar Ibinọkpaabyi, kw'ọnang anọng p'Israẹl p'ade anọng pẹ ẹwọhngkwoka, k'ose kw'uwa ochekẹ. Odik mawan-wanẹ kode kw'ina osi ny'idik ọkkọkka maphyir s'otim Mosẹs kw'ode ọtọhmnọng kwẹ, ochekẹ. <verse eid="1KI 8:56" /><verse number="57" style="v" sid="1KI 8:57" />Tte Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwamina, oninga ọmaan mina, k'ose kw'uwa oning ọmaana ab'ttatta pamina. Tte oning mina ọbọhk otte, tte oning mina obir ọzaama. <verse eid="1KI 8:57" /><verse number="58" style="v" sid="1KI 8:58" />Tte ọbhakẹ nttem samina motor-ẹ, mfha mọsaka nso ọnang-ẹ, mobir okpobha asana pẹ, ọmaana apaanga pẹ, ọttara idik sẹ s'iwa ọnang ab'ttatta pamina. <verse eid="1KI 8:58" /><verse number="59" style="v" sid="1KI 8:59" />Tte idik nja saam s'kk'ntima nze njọm m'Ọvaar Ibinọkpaabyi k'ititika, ininga Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwamina z'ettem, k'ẹya ọmaana k'erungọ. Tte ọkkaana ọtọhmnọng kwẹ ọttara anọng pẹ p'ade Israẹl otor k'idik s'imyẹ bẹ k'ewu k'ewu, <verse eid="1KI 8:59" /><verse number="60" style="v" sid="1KI 8:60" />mfha ayagbin maphyir mazonga bẹ́, Ọvaar Ibinọkpaabyi wọ ode Ibinọkpaabyi, Ibinọkpaabyi ọdọk-ọdọk za kode. <verse eid="1KI 8:60" /><verse number="61" style="v" sid="1KI 8:61" />Màtte nttem sabọnga kibung-kibungọ iyika k'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwamina, mfha maruk ator k'asana pẹ ọmaana apaanga pẹ, k'ose kw'ode m'ogbe nwa.”<verse eid="1KI 8:61" /></para>
  <para style="s1">Sọlọmọn otte Ọsọhm ọbọhk ọnang Ibinọkpaabyi</para>
  <para style="p">
    <verse number="62" style="v" sid="1KI 8:62" />Nya o, ọvaar Sọlọmọn ọmaana anọng p'Israẹl maphyir, mafọhnọ nja anang Ọvaar Ibinọkpaabyi. <verse eid="1KI 8:62" /><verse number="63" style="v" sid="1KI 8:63" />Sọlọmọn otima adamogbodo nnọhna arọbh afa okwuma ichi, ọmaana arọkimaan ọmaana avu nnọhna arọbh ichi, ọfọhnọ ẹja ch'eforgbaka ọnang Ọvaar Ibinọkpaabyi. Minna kw'ọvaarnọng ọttara anọng p'Israẹl maphyir, matte Ọsọhm nwo ọbọhk anang Ọvaar Ibinọkpaabyi.<verse eid="1KI 8:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1KI 8:64" />Ny'ewu ndo madan-danẹ, ọvaarnọng ọtọka ottem kw'eterttem kw'oning ny'ititika s'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọkọm osok mach'ibyi s'Ibinọkpaabyi. Oninga nya ọfọhnọ nja s'ẹkwọmọ, ọmaana nnanga s'akpomọma, ọttara iyaak s'ifon z'nnanga s'eforgbaka. Wa osi minna okurọ bẹ́, ija-byi s'ide brons s'ining ny'Ọvaar Ibinọkpaabyi k'ititika, ichamẹ ọkpan bẹ́, ibenga nnanga s'ẹkwọmọ, ọmaana s'akpomọma, ọttara nnanga s'iyaak s'eforgbaka.<verse eid="1KI 8:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="1KI 8:65" />Minna kw'uwa Sọlọmọn osi odidaama ny'ogbe nwo, ọmaana anọng p'Israẹl maphyir. Wa ode ikpakaana s'ibar-ọbar s'anọng abin tọma z'Lẹbo Hamat maa, pyirẹ z'akekava p'Ijip. Wa masi odidaama nwo k'iwu ichenọmfa, k'ititika s'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwamina, mabira attara wẹ k'iwu ichenọmfa. Kibung-kibungọ, wa matim iwu osowanẹ kw'ichi masi odidaama nwo. <verse eid="1KI 8:65" /><verse number="66" style="v" sid="1KI 8:66" />Ewu esobh nya o, ọvaarnọng oben anọng mbo bẹ́, mabhana. Manang kẹ ọvaarnọng ezima, pira nnabhan z'isọhm sabẹ. Ettem ẹdaam bẹ, ebira elebh bẹ, k'ejibha maphyir ch'Ọvaar Ibinọkpaabyi kk'ọsa ọnang ọtọhmnọng kwẹ Devid, ọttara anọng pẹ p'Israẹl.<verse eid="1KI 8:66" /></para>
  <chapter eid="1KI 8" />
  <chapter number="9" style="c" sid="1KI 9" />
  <para style="s1">Ibinọkpaabyi oyinẹ okebha Sọlọmọn</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 9:1" />K'ogbe kw'Sọlọmọn kk'Ọsọhm kw'Ọvaar Ibinọkpaabyi ọmaana odimpa ọsa maphyir, ọmaana idik njoza maphyir s'idaak-ẹ bẹ́, osi, <verse eid="1KI 9:1" /><verse number="2" style="v" sid="1KI 9:2" />Ọvaar Ibinọkpaabyi oyin okebh-ẹ ttong igbedim ifa, k'ose kw'uwa oyinẹ okebh-ẹ z'Gibeọn. <verse eid="1KI 9:2" /><verse number="3" style="v" sid="1KI 9:3" />Ọvaar Ibinọkpaabyi oben-ẹ bẹ́,</para>
  <para style="pm" vid="1KI 9:3">“Kaam kk'njọm ọmaana ẹmọng chọ mmaanga. Kaam kk'Ọsọhm nwa kw'Ibinọkpaabyi kw'asi ma ntọka mach'Ọsọhm kwaam. Kk'eche chaam nka nya ttattampe. Achen paam ọmaana ettem chaam m'eninga nya k'ogbe kpenamken.<verse eid="1KI 9:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1KI 9:4" />Ṉ́nòde kọ, óde ator-m ọmaana ettem madanẹ, ọmaana ẹmmaana ọkkọkka, ọmaana atoriji p'ettem k'ose kw'uwa atte Devid osi, abira asi idik maphyir s'mbenẹ, akpobha asana ọmaana apaanga paam, <verse eid="1KI 9:4" /><verse number="5" style="v" sid="1KI 9:5" />kaam m'nsi ẹvaar chọ ettima m'Israẹl ttattampe, k'ose kw'nchekẹ nnang Devid kw'ode atte kwọ bẹ́, ‘Kwuna ọnọng mòwor kw'm'otera eso chọ ny'ẹvaarkkọhbhọ ch'Israẹl.’<verse eid="1KI 9:5" /></para>
  <para style="pm">
    <verse number="6" style="v" sid="1KI 9:6" />“Okenaka, ode kọ, wanẹma, ode iva p'iva pọ bọ akpa nnam abọr-m, m'idik saam ọttara asana p'kk'ọ nnanga ọdọk kakpobh, matera ad-araka nso makpobha ekpo ọdọk-ọdọk, <verse eid="1KI 9:6" /><verse number="7" style="v" sid="1KI 9:7" />nya kw'kaam m'nrọbha anọng p'Israẹl z'izek s'kk'bẹ nnanga. M'mbira mbhum ọsọhm nwa kw'Ibinọkpaabyi kw'kk'nteka nkọm nsok k'eche chaam okpukpobha. Nya kw'anọng p'Israẹl nna ọdọk ọttọhk áfẹ̀ mabanga, anọng maphyir m'amma bẹ asa. <verse eid="1KI 9:7" /><verse number="8" style="v" sid="1KI 9:8" />Ọsọhm nwa kw'Ibinọkpaabyi m'okwu ode ọtakkin kw'ọsọhm kw'ikk'ọvọhka. M'ope anọng maphyir p'akpan-ọkpan ifor, obira okkonọ bẹ maa, m'aben bẹ́, ‘Ode yen kw'Ọvaar Ibinọkpaabyi osi ọttọhkse mva m'izek nja, ọmaana m'ọsọhm nwa kw'Ibinọkpaabyi?’ <verse eid="1KI 9:8" /><verse number="9" style="v" sid="1KI 9:9" />Anọng m'apọhna bẹ́, ‘Ofon ch'nkk'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwabẹ kw'uwa otim ab'ttatta pabẹ obina z'Ijip, abhuma. Bẹ matera akpobha aka, mabira araka nso anang aka mbo. Kẹ wọ osi Ọvaar Ibinọkpaabyi ọtọhm itama nja maphyir ọnang bẹ.’ ”<verse eid="1KI 9:9" /></para>
  <para style="s1">Idik ọdọk-ọdọk s'Sọlọmọn osi</para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 9:10" />Wa node icho ẹrọbh ch'Sọlọmọn osi isọhm njoma ifa, kw'ode Ọsọhm kw'Ọvaar Ibinọkpaabyi ọmaana odimpa. <verse eid="1KI 9:10" /><verse number="11" style="v" sid="1KI 9:11" />Ọvaar Sọlọmọn ọtọka ibhon ẹrọbh s'ining ny'Galili ọnang Hiram, kw'ode ọvaarnọng kw'Taya, okurọ ch'Hiram ikk'ẹ nchi s'sida ọmaana siprẹs ọttara gol maphyir kw'ororọ, ọnanga. <verse eid="1KI 9:11" /><verse number="12" style="v" sid="1KI 9:12" />Okenaka, ch'Hiram nobin z'Taya od-oze ibhon njo s'Sọlọmọn ikk'ẹ ọnanga, ibhon njo kẹ ettem kidaamẹ. <verse eid="1KI 9:12" /><verse number="13" style="v" sid="1KI 9:13" />Ọbọbh Sọlọmọn bẹ́, “Agbaanatte kwaam, bọng-ibhonse jọma s'anang-m ma o?” Oyerẹ ibhon njo bẹ́, Ẹkọma ch'Kabul<note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="fq" closed="false">Kabul </char><char style="ft" closed="false">kw'oyinẹ k'eHiburu bẹ́, “Izek s'ina k'eden iyinẹ.”</char></note>. Ẹkọma ndo etim ekpen za minna maa, pyirẹ menda. <verse eid="1KI 9:13" /><verse number="14" style="v" sid="1KI 9:14" />Ode ch'iwa Hiram kk'atalẹnt p'gol arọbh achadanẹ ọtọhma ochena ọvaar Sọlọmọn.<verse eid="1KI 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 9:15" />Ma wọ ode ose kw'uwa Ọvaar Sọlọmọn ọgwa anọng k'ẹfa otima osi ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana odimpa kwẹ oyenẹ, ọmaana abhukakpa, ọmaana etumọ ch'Jẹrusalẹm, ọmaana Hazọ, ọmaana Megido, ọttara Gẹza. <verse eid="1KI 9:15" /><verse number="16" style="v" sid="1KI 9:16" />(Ode ch'iwa Phero kw'ode ọvaarnọng kw'Ijip kk'egbong orima, ọbọka obhon kw'Gẹza. Wa oke wẹ ekpon, ọkwọmọ. Obira ọfhọ anọng p'Kenaan p'arukọ nya. Pira nọtọk izek njo s'Gẹza ọnang ominanwa kwẹ mach'ẹtaam, k'ọba kw'osi ọmaana Sọlọmọn. <verse eid="1KI 9:16" /><verse number="17" style="v" sid="1KI 9:17" />Minna kw'Sọlọmọn nobir okwu osi obhon kw'Gẹza obe.) Wa obira osi izek-izek kw'obhon kw'Bẹt-Horon, <verse eid="1KI 9:17" /><verse number="18" style="v" sid="1KI 9:18" />ọmaana Baalat, ọttara Tamar z'ẹbhaakẹ ch'anọng nna arukọ, ny'izek njo sẹ. <verse eid="1KI 9:18" /><verse number="19" style="v" sid="1KI 9:19" />Wa obira osi ibhondim sẹ maphyir s'od-oye ekpo, ọmaana ibhon s'od-osok ijaar sẹ s'nnyanya id-itọr, ttara nnyanya oyenẹ. Osi ọttọhk kpenamkpen f'ọdaak-ẹ bẹ́, osi z'Jẹrusalẹm, ọmaana z'Lebanọn, ọttara z'nkọma maphyir s'ikẹ ọbaabh.<verse eid="1KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 9:20" />Wa anọng banẹ p'afon Amọr, ọmaana Hit, ọmaana Periz, ọmaana Hiv, ọttara Jebus, atim arikẹ nya. (Wa anọng mba mammaana p'Israẹl kade). <verse eid="1KI 9:20" /><verse number="21" style="v" sid="1KI 9:21" />Iva p'iva pabẹ p'arik-orik, p'uwa anọng p'Israẹl nnafhọ, bẹ bọ p'uwa Sọlọmọn ọgwa k'ẹfa mach'abira pẹ, od-otima osi itọhm. Otim ode za minna maa, pyirẹ menda nwa. <verse eid="1KI 9:21" /><verse number="22" style="v" sid="1KI 9:22" />Ọnọng mawanẹ kode kw'ofon Israẹl, kw'uwa Sọlọmọn osi ebira. Bẹ bọ p'uwa otim osi arimanọng pẹ, ọmaana adukwa p'ẹbaabha chẹ, ọmaana asonọng pẹ, ọmaana abaabh-agbongso pẹ, ọmaana aso p'ijaar sẹ s'nnyanya id-itọr. <verse eid="1KI 9:22" /><verse number="23" style="v" sid="1KI 9:23" />Bẹ bọ uwa mabira ade adukwa mbo p'ade anọng ẹnọhna okwuma arọbh achenọmfa okwuma ijobh, p'atim itọhm s'Sọlọmọn, mabira akkerẹ atọhmnọng.<verse eid="1KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 9:24" />Ch'ominanwa kw'Phero kk'obina z'ebhondim ch'Devid okwu z'ọvaardimpa kw'Sọlọmọn kk'ọsa ọnang-ẹ, nya kw'Sọlọmọn oke abhukakpa mbo.<verse eid="1KI 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 9:25" />Igbedim ittaan k'icho, wa Sọlọmọn ọd-ọfọhnọ ẹja ch'ẹkwọmọ ọttara ẹja ch'eforgbaka ny'ija-byi s'ikk'ọsa ọnang Ọvaar Ibinọkpaabyi. Wa obira ọd-ọkwọmọ insẹns ny'Ọvaar Ibinọkpaabyi k'ititika. Minna kw'uwa ozeng ochera itọhm s'ọsọhm kw'Ibinọkpaabyi.<verse eid="1KI 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 9:26" />Wa ọvaar Sọlọmọn obira osi akkaara-kpaar z'Ẹziyọn-Gẹbẹr kw'ọnyọm Elat kw'oning z'ẹkọma ch'Edom, z'ẹpa ch'ẹraangakora. <verse eid="1KI 9:26" /><verse number="27" style="v" sid="1KI 9:27" />Nya o, Hiram ọtọhm ajinọng pẹ pad-ayaar asi, mabira azonga ọraanga kwiden bẹ́, mator anọng p'Sọlọmọn mayaar akkaara-kpaar mbo. <verse eid="1KI 9:27" /><verse number="28" style="v" sid="1KI 9:28" />Mayaar achina z'Ophir, matima gol kw'ode atalẹnt ẹnọhna okwuma ẹrọbh, machena ọvaar Sọlọmọn.<verse eid="1KI 9:28" /></para>
  <chapter eid="1KI 9" />
  <chapter number="10" style="c" sid="1KI 10" />
  <para style="s">Ọvaar kwanọng kw'Shẹba odibhẹ Sọlọmọn</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 10:1" />K'ogbe kw'ọvaar kwanọng kw'Shẹba ọbhaang ose kw'Sọlọmọn okpobh, ọmaana ose kw'ozeng ẹkaan ọmaana Ọvaar Ibinọkpaabyi, otima ambuma p'agaang-ọgaangẹ okwu ọnang-ẹ eyoma. <verse eid="1KI 10:1" /><verse number="2" style="v" sid="1KI 10:2" />Otima eyokinọngkaan ch'ẹsaabh-ọsaabh ọmaana akamẹl opyirẹ z'Jẹrusalẹm. Akamẹl mbo matọhka ekpo py'elebhẹ eruk, ọmaana agol k'akkin-k'akkin, ọttara ata p'ajibh-ojibh, p'ochen Sọlọmọn. Wa obira ọgbaak idik maphyir s'ining-ẹ z'ettem ọmaan-ẹ. <verse eid="1KI 10:2" /><verse number="3" style="v" sid="1KI 10:3" />Sọlọmọn ọpọhna ambuma maphyir p'ọbọbh-ẹ. Mbuma kode kw'uwa ọkaar ọvaar Sọlọmọn ọkaara bẹ́, ọnang-ẹ ọyaanttaana. <verse eid="1KI 10:3" /><verse number="4" style="v" sid="1KI 10:4" />Ch'ọvaar kwanọng nwo kw'Shẹba oze ezonga-kira ch'Sọlọmọn oyen, ọmaana odimpa kw'ikk'ọsa, <verse eid="1KI 10:4" /><verse number="5" style="v" sid="1KI 10:5" />ọmaana ọchattọhk f'ọnan z'okpokkoro kwẹ, ọmaana ose kw'iwọrninga-byi s'adukwa pẹ ide, ọmaana atọhmnọng pẹ, ọmaana nnya s'mafọr, ọmaana anọng p'ad-anang-ẹ atuk, ọmaana nnanga s'ẹkwọmọ s'ọnangẹ z'ọsọhm kw'Ọvaar Ibinọkpaabyi, okkon-ẹ makpaar.<verse eid="1KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 10:6" />Oben ọvaarnọng bẹ́, “Odik kw'mmaang z'kaam k'ẹkọma kw'ozeng ọmaana idik s'ikk'asa, ọmaana ezonga chọ, ode odik ọkkọkka. <verse eid="1KI 10:6" /><verse number="7" style="v" sid="1KI 10:7" />Kaam idik nja kincher maa, nkwu nze k'achen paam oyenẹ. K'odik ọkkọkka, kk'nza bẹ́, matek-m odik kwọ <char style="it">bẹ kẹrẹm</char>. Ezonga chọ ọmaana oyena kwọ, ẹbarẹ ẹyọhnga k'ose kw'mmaang. <verse eid="1KI 10:7" /><verse number="8" style="v" sid="1KI 10:8" />Anọng pọ m'aninga k'ottemdaam! Adukwa pọ p'aning amaan-ọ k'ogbe kpenamkpen, mabhaanga ezonga chọ, mm'abira aninga k'ottemdaam! <verse eid="1KI 10:8" /><verse number="9" style="v" sid="1KI 10:9" />Ẹtọhnga ede ch'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ. Ofon k'ottemlebh kw'oyen k'ikọ, ọtọk-ọ ọnana k'ẹvaarkkọhbhọ ch'Israẹl. Ọvaar Ibinọkpaabyi ozeng ọdaakẹ kw'ttattampe kw'oyen ọmaana anọng p'Israẹl ábubẹ̀, ọsọ-ọ ọvaarnọng bẹ́, ad-akpaara aponga k'eden ọkkọkka ọmaana k'eden ch'etor-otor.”<verse eid="1KI 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 10:10" />Wa ọvaar kwanọng nwo ọnangẹ ọvaar Sọlọmọn atalẹnt arọbh achadanẹ p'gol, ọmaana ekpo k'akkin-k'akkin py'elebhẹ eruk ọttara ata p'ajibh-ojibh. Ogbe kode kw'uwa ọnọng obir otima ekpo py'elebhẹ eruk py'ẹsaabhẹ mach'mbyo py'ọvaar kwanọng kw'Sheba, ochena ọvaar Sọlọmọn. <verse eid="1KI 10:10" /><verse number="11" style="v" sid="1KI 10:11" />(Wa akkaara-kpaar p'Hiram matim gol z'Ophir akwu. Mabir atima ẹtọhka chiden ch'agbaaka p'ochi kw'almug, ọttara ata p'ajibh-ojibh. <verse eid="1KI 10:11" /><verse number="12" style="v" sid="1KI 10:12" />Ọvaarnọng otima agbaaka p'ochi kw'almug otuma Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana ọvaardimpa. Wa obira otima agbaaka mbo osi agim-agim ọttara agaang ọnang akkọhn-ẹmọng. Tọma za maa pyirẹ ma, m'agbaaka p'ochi kw'almug k'ọsaabh minna ọdọk kadebhẹ, nkk'ichen kabir aze.)<verse eid="1KI 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 10:13" />Wa ọvaar Sọlọmọn ọnang ọvaar-kwanọng kw'Shẹba ọttọhk kpenamkpen f'ọdaakẹ, ọmaana mbyo py'ophyem-ẹ ophyem, ágbaarẹ mbyo py'ikk'ẹ ọnanga k'ọphyaam f'ikẹ Sọlọmọn. Nya o, ọvaarkwanọng nwo kw'Shẹba otima ẹnọngkaan chẹ, obina ọbhana z'ikẹ k'ẹkọma.<verse eid="1KI 10:13" /></para>
  <para style="s1">Oyena kw'Sọlọmọn</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 10:14" />K'icho kpenamkpen, adọhbhiji p'gol kw'uwa Sọlọmọn ọd-ọtọka made atalẹnt ẹnọhna okwuma arọbh ijobh kkanttaan okwuma achadanẹ. <verse eid="1KI 10:14" /><verse number="15" style="v" sid="1KI 10:15" />Ikpuka s'ifon z'ayaam-mphya, ọmaana z'avaar p'Arabiya, ọttara abaabh-nkọma, wa nnya kattar.<verse eid="1KI 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 10:16" />Ọvaar Sọlọmọn otima gol kw'maduk-oduk osi agbongtergba piden arọbh ijobh. Ogbongtergba kpenamkpen ọtọk ashẹkẹl ẹnọhna okwuma arọbh ijobh p'gol. <verse eid="1KI 10:16" /><verse number="17" style="v" sid="1KI 10:17" />Wa obir otima gol kw'maduk-oduk osi agbongtergba p'karẹ arọbh ichi. Wa ogbongtergba kpenamkpen otim amina attaan p'gol. Ọtọka ekpo mbyo osok z'odimpa kw'Ẹtam ch'Lebanọn.<verse eid="1KI 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 10:18" />Ọvaarnọng okwu otima enyisa osi ẹvaarkkọhbhọ chiden, obir otima gol ọkkọkka ọbhọrọ dẹ. <verse eid="1KI 10:18" /><verse number="19" style="v" sid="1KI 10:19" />Ẹvaarkkọhbhọ ndo eyen abhukakpa achadanẹ. Z'nnam kwẹ z'ẹrọng, ede izizing. Wa ẹvaarkkọhbhọ ndo eyen agbera-bọhk k'okwubha-k'okwubha. Masi ndoka s'nche ny'okikaan kw'ogbera-bọhk kpenamkpen. <verse eid="1KI 10:19" /><verse number="20" style="v" sid="1KI 10:20" />Nche ijobh kkamfa ibe ny'abhukakpa mbo achadanẹ, madanẹ ebe k'ebhukakpaso kpenamkpen. Ẹkọma ọdọk-ọdọk za kede ch'iwa ikk'ọttọhk f'ode minna ẹsa. <verse eid="1KI 10:20" /><verse number="21" style="v" sid="1KI 10:21" />Wa matim gol asi akkọbh p'atuk p'ọvaar Sọlọmọn maphyir. Mabir atima gol ọkkọkka asi ekpo maphyir py'ening z'odimpa kw'Ẹtam ch'Lebanọn. Ọttọhk mavanẹ-vanẹ kode f'uwa matim silva asi, okurọ bẹ́, z'ogbe kw'Sọlọmọn, wa silva odik kọbarẹ. <verse eid="1KI 10:21" /><verse number="22" style="v" sid="1KI 10:22" />Ọvaarnọng oyena akkaara-kpaar k'ọsaabh, p'ẹphya oyiyaama z'ọraanga kwiden, mach'akkaara-kpaar p'Hiram. Akkaara-kpaar mbo mad-akwuna ozenga ogbe mawanẹ k'icho ittaan. K'ogbe kw'makwun, mad-atọhka gol, ọmaana silva, ọmaana nnyisa, ọmaana oyobha, ọttara nzizangkkọng.<verse eid="1KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 10:23" />Wa ọvaar Sọlọmọn ọyọhng avaarnọng mboza maphyir p'iyagbin k'ojibhada ọmaana k'ezonga. <verse eid="1KI 10:23" /><verse number="24" style="v" sid="1KI 10:24" />Ọyagbinnọng kode kw'uwa ina ororọ bẹ́, oninga ọmaana Sọlọmọn, mfha ọbhaanga ezonga ndo ch'Ibinọkpaabyi kk'ẹ ọnanga. <verse eid="1KI 10:24" /><verse number="25" style="v" sid="1KI 10:25" />K'icho k'icho, ọnọng kpenamkpen kw'okwu ọzẹ-ẹ, od-otima ẹnanga ch'silva, ọmaana ch'gol, ọmaana ch'anọhma-baba, ọmaana ch'egbongkpo, ọmaana ch'ekpo py'elebhẹ eruk, ọmaana ch'nnyanya, ọttara nnyanya s'id-itọhka ekpo.<verse eid="1KI 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 10:26" />Wa Sọlọmọn oyen ijaar s'nnyanya id-itọr, ọttara nnyanya k'ọsaabh. Wa ijaar s'nnyanya id-itọr ide nnọhna nttaan okwuma arọbh ijobh, ọmaana nnyanya nnọhna ẹrọbh okwuma ijobh. Wa osokọ jẹ z'ebhondim ch'ijaar s'nnyanya id-itọr, osok mbyoza eninga ẹmaan-ẹ z'Jẹrusalẹm. <verse eid="1KI 10:26" /><verse number="27" style="v" sid="1KI 10:27" />Ọvaar Sọlọmọn osi silva ọsaabh z'Jẹrusalẹm mach'ata. Obira osi sidar ọsaabh mach'ochi kw'sikamọ z'agbe-rin p'Juda. <verse eid="1KI 10:27" /><verse number="28" style="v" sid="1KI 10:28" />Z'Ijip, ọmaana z'Kuwe, za wọ kw'uwa Sọlọmọn od-odebh nnyanya sẹ. Ayaam-mphya p'ọvaarnọng bọ uwa mad-adebh jẹ z'Kuwe k'ẹphya ch'ogbe nwo. <verse eid="1KI 10:28" /><verse number="29" style="v" sid="1KI 10:29" />Wa madebhẹ ọkpaar kw'ẹnyanya ẹd-ẹtọr z'Ijip k'ashẹkẹl p'silva ẹnọhna okwuma arọbh ijobh. Makwu adebh ẹnyanya k'ashẹkẹl p'silva arọbh achenọmfa okwuma ijobh. Mabir akpe jẹ anang avaarnọng maphyir p'ẹkọma ch'Het ọmaana ch'Aram.<verse eid="1KI 10:29" /></para>
  <chapter eid="1KI 10" />
  <chapter number="11" style="c" sid="1KI 11" />
  <para style="s1">Panọng p'Sọlọmọn</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 11:1" />Wa ọvaar Sọlọmọn oyen panọng k'ọsaabh p'adaak-ẹ p'afon nkọma ọdọk-ọdọk. Ó̱de ágbaarẹ ominanwa kw'Phero abharẹ, wa ọtọk panọng z'ẹkọma ch'Moab, ọmaana ch'Amọn, ọmaana ch'Edom, ọmaana ch'Sidon ọttara ch'Het. <verse eid="1KI 11:1" /><verse number="2" style="v" sid="1KI 11:2" />Wa panọng mbo afon nkọma njo s'iwa Ọvaar Ibinọkpaabyi ọtọr anọng p'Israẹl itọhng bẹ́, “Kwuna bọnga ọmaana anọng p'afon ma, maning ayok k'ọbada atọk o, okurọ bẹ́, k'odik ọkkọkka, mm'abhakẹ bọnga nttem ọbhakẹ, masi bọnga makpobha aka pabẹ.” Nya kw'uwa nnater ado Sọlọmọn adaak-ọdaak. <verse eid="1KI 11:2" /><verse number="3" style="v" sid="1KI 11:3" />Wa ọtọk panọng ẹnọhna okwuma arọbh ichi p'afon k'ivaar-taak, obira osi iyok ọmaana panọng arọbh ichi. Panọng mbo pẹ, matim-ẹ attena eden. <verse eid="1KI 11:3" /><verse number="4" style="v" sid="1KI 11:4" />K'ogbe kw'Sọlọmọn kk'ọtama, panọng pẹ abhak-ẹ ettem, nokpobha aka. Wa ọdọk ettem chẹ maphyir k'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwẹ koyik, k'ose kw'uwa Devid kw'ode otte, okpobh-ẹ. <verse eid="1KI 11:4" /><verse number="5" style="v" sid="1KI 11:5" />Wa kẹ nokpobh Ashtọrẹt, kw'ode ọka f'kwanọng f'anọng p'Sidọn, ọmaana Molẹk kw'ode ọka f'ọbọk-ọbọkọ f'anọng p'Amọn. <verse eid="1KI 11:5" /><verse number="6" style="v" sid="1KI 11:6" />Ofona nya o, Sọlọmọn osi itama z'Ọvaar Ibinọkpaabyi k'ititika. Ọdọk Ọvaar Ibinọkpaabyi kokpobh ọmaana ettem chẹ maphyir, k'ose kw'uwa Devid kw'ode otte, okpobh-ẹ.<verse eid="1KI 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 11:7" />K'egbe ch'ening z'ẹbhaakẹ ch'ewuchen ed-eyin z'Jẹrusalẹm, nya kw'Sọlọmọn osi ija-byi s'ọyaankpa s'mm'ad-akpobha Kẹmọsh, kw'ode ọka f'ọbọk-ọbọkọ f'anọng p'Moab. Obira osi ibyise njo s'mm'ad-akpobha Molẹk, kw'ode ọka f'ọbọk-ọbọkọ f'anọng p'Amọn. <verse eid="1KI 11:7" /><verse number="8" style="v" sid="1KI 11:8" />Minna kw'uwa osi obyi mvo ọnang panọng mbo pẹ maphyir p'afon nkọma ọdọk-ọdọk, mfha mad-akwọmọ insẹns, mabira afọhnọ nja anang aka pabẹ.<verse eid="1KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 11:9" />Wa Ọvaar Ibinọkpaabyi okwu ọdọk-ẹ ọmaana Sọlọmọn, okurọ bẹ́, kk'ettem chẹ ọrọhbha z'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl kw'ikk'oyina okebh-ẹ igbedim ifa. <verse eid="1KI 11:9" /><verse number="10" style="v" sid="1KI 11:10" />Chibhẹ ch'iwa ikk'Sọlọmọn eden ọkpa k'ekpo ọdọk-ọdọk okpukpobha, Sọlọmọn odik kw'Ọvaar Ibinọkpaabyi kokpobh. <verse eid="1KI 11:10" /><verse number="11" style="v" sid="1KI 11:11" />Nya o, Ọvaar Ibinọkpaabyi oben Sọlọmọn bẹ́, “Ch'ode minna wọ nnode osisi kwọ, bẹ́, abhum echekẹ chaam ọttara asana p'nnang-ọ okpukpobha, eden za kede ch'ina ọvaarbhon nwo mìnkebh nnang ọnọng wanẹ kw'oning izek-izek kwọ. <verse eid="1KI 11:11" /><verse number="12" style="v" sid="1KI 11:12" />Okenaka, m'nzenga Devid kw'ode atte kwọ ábubẹ̀, mkpa nnam mbọra odik nwo m'ogbe kw'ikọ aning akpen. Kaam m'nkebh wẹ k'ogbe kw'nnwa kwọ m'ọbaabha. <verse eid="1KI 11:12" /><verse number="13" style="v" sid="1KI 11:13" />Zaa ode yen, ọvaarbhon nwo k'ibungọ mìnkebh. Kaam m'nzenga Devid kw'ode ọtọhmnọng kwaam, ọmaana Jẹrusalẹm kw'kk'nteka ábubẹ̀, nnang-ẹ ofonamma mawanẹ.”<verse eid="1KI 11:13" /></para>
  <para style="s1">Awawunanọng p'Sọlọmọn</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 11:14" />Minna kw'Ọvaar Ibinọkpaabyi ọtọhmọ Hadad kw'ofon z'ivaartaak s'Edom bẹ́, oninga k'iwawuna ọmaana Sọlọmọn. <verse eid="1KI 11:14" /><verse number="15" style="v" sid="1KI 11:15" />Wa k'ogbe wanẹ, ch'Devid od-orima anọng p'Edom ábẹ̀, Joab kw'ode oso kw'asoja kk'ọta za bẹ́, ọd-ọnọhnga ayok p'nkk'apa. Minna kw'okporiza, ọfhọ ajinọng p'ẹkọma ch'Edom maphyir. <verse eid="1KI 11:15" /><verse number="16" style="v" sid="1KI 11:16" />Joab ọmaana anọng p'Israẹl maphyir maninga nya k'aphe achadanẹ. Maninga nya maa, mafhọ ajinọng p'Edom maphyir. <verse eid="1KI 11:16" /><verse number="17" style="v" sid="1KI 11:17" />Okenaka, Hadad kw'uwa otim ode odikkobh, ọrọbh ozeng z'Ijip, kẹ ọmaana atọhmnọng banẹ p'nkk'ọtọhm asa amaana otte kwẹ. <verse eid="1KI 11:17" /><verse number="18" style="v" sid="1KI 11:18" />Mabina z'Midiyan machina z'Paran. Minna kw'matọk anọng banẹ ny'Paran p'matim azeng z'Ijip, makebh Phero kw'ode ọvaarnọng kw'Ijip. Phero ọnang Hadad ọsọhm ọmaana izek, ọttara ọchattọhk.<verse eid="1KI 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 11:19" />Wa ettem ẹdaamẹ Phero ẹmaana Hadad maa, ọtọka ọgbaanọkka kw'ọvaarkwanọng kwẹ kw'ode Tahpẹnẹs, ọnang Hadad k'ọba. <verse eid="1KI 11:19" /><verse number="20" style="v" sid="1KI 11:20" />Ọgbaanọkka nwo kw'Tahpẹnẹs, ọmmaan ojinọngnwa kw'okpen Gẹnubat ọnang Hadad. Tahpẹnẹs ọrọk Gẹnubat ny'ọvaarter. Wa Gẹnubat orukọ nya ọmaana iva p'Phero.<verse eid="1KI 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 11:21" />Ch'iwa Hadad otim oning z'Ijip, ọbhaanga bẹ́, Devid kk'ọpa okebh ab'otte z'izek, ọttara bẹ́, Joab kw'ode oso kw'asoja kk'ọpa ọdọk, minna kw'Hadad oben Phero bẹ́, “Tte mbhana, mkpa nnam z'ẹkọma chaam.”<verse eid="1KI 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 11:22" />Phero ọbọbh-ẹ bẹ́, “Mbọng vọ owor-ọ ma, f'azeng ábẹ̀ aben bẹ́, m'akpa nnam z'ẹkọma chọ?” Hadad ọpọhn-ẹ bẹ́, “Ọttọhk kaam koworọ. Okenaka, tte-m ọbọhk nzọhng!”<verse eid="1KI 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 11:23" />Ibinọkpaabyi obira ọphyẹ iwawuna ọdọk-ọdọk ọnang Sọlọmọn. Wa notim Rezon kw'ode nnwa kw'Eliyada, kw'uwa ọrọbh-ọrọbh z'Hadadẹza kw'ode otte kw'oruk-ẹ ábẹ̀, obira ode ọvaarnọng kw'Zoba. <verse eid="1KI 11:23" /><verse number="24" style="v" sid="1KI 11:24" />K'ogbe kw'Devid okem asoja p'Zoba, Rezon otobha ẹkaan ch'akkikkaama, kẹ ode bẹ oso. Mabina ad-aruk z'Damaskus, mabira asẹ-ẹ ẹvaar za. <verse eid="1KI 11:24" /><verse number="25" style="v" sid="1KI 11:25" />Wa Rezon ode ọwawunanọng kw'Israẹl ny'ogbe kw'Sọlọmọn orukọ akpen. Hadad obira oke anọng p'Israẹl ẹkọhr. Minna kw'Rezon ọbaabh z'Aram, ttara k'iwawuna s'osokọ anọng p'Israẹl.<verse eid="1KI 11:25" /></para>
  <para style="s1">Jẹroboam oke Sọlọmọn ẹkọhr</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 11:26" />Wa Jẹroboam kw'ode ojinọngnwa kw'Nẹbat obhonọ, obira oke ọvaarnọng ẹkọhr. Wa kẹ obira ode odukwa wanẹ kw'Sọlọmọn kw'ofon z'Zereda, z'ẹkọma ch'Ephraim. Wa ọkka kwẹ ode opokwa kw'okpen Zẹruya.<verse eid="1KI 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 11:27" />Ọttọhk f'uwa Jẹroboam ozeng ábẹ̀ oke ọvaarnọng ẹkọhr ode bẹ́, wa Sọlọmọn osi abhukakpa, obira ọkpa áphaangẹ̀ p'etumọ ch'ebhondim ch'Devid kw'ode otte kwẹ. <verse eid="1KI 11:27" /><verse number="28" style="v" sid="1KI 11:28" />Wa Jẹroboam ode ojinọng kw'ọgbọhk-ọgbọhkọ. Ch'Sọlọmọn oze ose kw'ojinọngnwa nwo ọgbọhkọ ọtọhm, ọsẹ-ẹ oso kw'atọhmnọng maphyir p'nkọma s'Josẹf.<verse eid="1KI 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 11:29" />Ny'ogbe nwo, wa Jẹroboam obin z'Jẹrusalẹm bẹ́, oyin k'iyaan. Ahija kw'ode ọgbaak-ettem ch'Ibinọkpaabyi kw'ofon Shilọ, ọfọra ọnọhma-baba ọbhakwẹ otima okebh-ẹ z'eden. Wa mazeng bẹ anọng afa bẹ-bẹ, mabina z'obhon. <verse eid="1KI 11:29" /><verse number="30" style="v" sid="1KI 11:30" />Ahija ọbọka ọnọhma-baba ọbhakwẹ nwo kw'ọfọr, ọyaakẹ k'mkpa ijobh kkamfa. <verse eid="1KI 11:30" /><verse number="31" style="v" sid="1KI 11:31" />Pira nobenẹ Jẹroboam bẹ́, “Kọ tọka mkpa ijobh, kirẹ Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl obenẹ bẹ́, ‘Kirẹ e, kaam m'nkebh ọvaarbhon nwo ny'Sọlọmọn k'mbọhk, ntọka mfonamma ijobh, nnang kọ. <verse eid="1KI 11:31" /><verse number="32" style="v" sid="1KI 11:32" />Okenaka, kaam m'nzenga Devid kw'ode ọtọhmnọng kwaam ábubẹ̀, ọmaana ebhondim ch'Jẹrusalẹm ch'kk'nteka m'mfonamma s'Israẹl maphyir, nnang-ẹ ofonamma mawanẹ. <verse eid="1KI 11:32" /><verse number="33" style="v" sid="1KI 11:33" />Kaam m'nsi minna okurọ bẹ́, bẹ nkk'nnam akpa abọr-m, matera akpobha Ashtọrẹt kw'ode ọpanọngka f'anọng p'Sidọn, ọmaana Kẹmọsh kw'ode ọka f'anọng p'Moab, ọttara Molek kw'ode ọka f'anọng p'Amọn. M'nden saam katorọ. M'ọttọhk f'otor-otor kabira asi k'kaam k'ititika. Bẹ nkabir asi k'ose kw'uwa Devid kw'obhonọ Sọlọmọn okpobh asana ọmaana apaanga paam. <verse eid="1KI 11:33" /><verse number="34" style="v" sid="1KI 11:34" />Okenaka, kaam ọvaarbhon nwo k'ibungọ mìntọka z'Sọlọmọn k'ọbọhk. Kaam kk'ẹ ọbaabh nsa k'akpen pẹ maphyir, okurọ Devid kw'ode ọtọhmnọng kwaam kw'ikk'nteka, kw'obira okpobha idik saam ọmaana asana paam. <verse eid="1KI 11:34" /><verse number="35" style="v" sid="1KI 11:35" />Kaam m'ntọka ọvaarbhon nwo z'mbọhk s'ojinọngnwa kwẹ, nnang kọ mfonamma ijobh. <verse eid="1KI 11:35" /><verse number="36" style="v" sid="1KI 11:36" />Kaam m'nnang ojinọngnwa kwẹ ofonamma mawanẹ, ọfha ẹnọmma ch'Devid kw'ode ọtọhmnọng kwaam echina ororo ẹbaabha Jẹrusalẹm, kw'ode ebhondim ch'ikk'nteka bẹ́, anọng aninga akpobh-m. <verse eid="1KI 11:36" /><verse number="37" style="v" sid="1KI 11:37" />Ṉ́nòde kọ, kaam m'nnang-ọ ẹvaar ch'm'abaabha obyi maphyir f'ọdaak-ọ z'ettem. Kọ m'ade ọvaarnọng kw'Israẹl. <verse eid="1KI 11:37" /><verse number="38" style="v" sid="1KI 11:38" />Ó̱de asi ọttọhk kpenamkpen f'mben-ọ, ator ẹtọkọ chaam, abira asi idik s'itor-otor k'kaam k'ititika, abira asok asana paam, ọmaana apaanga paam, k'ose kw'uwa Devid kw'ode ọtọhmnọng kwaam, osi, kaam m'nninga mmaan-ọ, nsi ivaartaak sọ ikpen, mach'iwa nsi s'Devid. Kaam m'mbira nnang-ọ Israẹl. <verse eid="1KI 11:38" /><verse number="39" style="v" sid="1KI 11:39" />Kaam m'nsaka iva p'iva p'Devid eninga okurọ odik nwa. Okenaka, ttattampe mòde.’ ”<verse eid="1KI 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 11:40" />Sọlọmọn okonga bẹ́, ọfhọ Jẹroboam, okenaka, Jẹroboam ọrọbh ozeng z'Ijip, okebha ọvaar Shishak za. Za kw'uwa oning maa, Sọlọmọn ope.<verse eid="1KI 11:40" /></para>
  <para style="s1">Obo kw'Sọlọmọn</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 11:41" />Ṉ́nòde idik njoza s'Sọlọmọn osi maphyir k'ogbe kw'ọbaabh, ttara ezonga ch'iwa ọd-ọkọhka, makkẹrẹ z'nnwẹr kw'idik s'Sọlọmọn. <verse eid="1KI 11:41" /><verse number="42" style="v" sid="1KI 11:42" />Wa Sọlọmọn oning ny'Jẹrusalẹm, ọbaabha Israẹl maphyir k'icho arọbh afa. <verse eid="1KI 11:42" /><verse number="43" style="v" sid="1KI 11:43" />Sọlọmọn ope, otor ab'otte. Manọhng-ẹ z'ebhondim ch'Devid kw'ode otte. Rẹhoboam kw'ode ojinọngnwa kwẹ, okwu otima ẹvaar ch'otte.<verse eid="1KI 11:43" /></para>
  <chapter eid="1KI 11" />
  <chapter number="12" style="c" sid="1KI 12" />
  <para style="s1">Anọng p'Israẹl make Rẹhoboam ẹkọhr</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 12:1" />Rẹhoboam ochina z'Shẹkẹm, za ch'anọng p'Israẹl maphyir nkk'attonga bẹ́, masẹ-ẹ ẹvaar. <verse eid="1KI 12:1" /><verse number="2" style="v" sid="1KI 12:2" />K'ogbe kw'Jẹroboam kw'ode ojinọngnwa kw'Nẹbat, ọbhaang odik nwa (ch'otim oning z'Ijip, za ch'ọrọbh ebira ch'ọvaar Sọlọmọn), obina z'Ijip okwuna. <verse eid="1KI 12:2" /><verse number="3" style="v" sid="1KI 12:3" />Minna kw'matọhmọ bẹ́, Jẹroboam okwu. Kẹ ọmaana ẹnọngkaan ch'Israẹl maphyir, mafona akebha Rẹhoboam, maben-ẹ bẹ́, <verse eid="1KI 12:3" /><verse number="4" style="v" sid="1KI 12:4" />“Wa atte kwọ ọyakẹ mina ẹtọhka ch'ẹdọhbh-ọdọhbh. Kọ n'yekẹ mina atọhm-gbọhka, ọmaana ẹtọhka ndo ch'ọyakẹ. Mina mm'ode atọhmnọng pọ.”<verse eid="1KI 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 12:5" />Rẹhoboam ọpọhna bẹ́, “Màzọhng, màkpa nnam k'iwu ittaan.” Minna kw'anọng mbo mafon.<verse eid="1KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 12:6" />Nya o, ọvaar Rẹhoboam obina okebha asogbọhkọnọng mbo p'uwa nkk'ọtọhm asa anang Sọlọmọn kw'ode otte k'ogbe kw'oning akpen. Ọbọbh bẹ bẹ́, “Yen kw'mm'atọhn-m bẹ́, mpọhna anọng mba?”<verse eid="1KI 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 12:7" />Bẹ mapọhn-ẹ bẹ́, “Ó̱de kọ m'ade ọtọhmnọng kw'anọng mba menda, kw'im'osi ọtọhm ọnang bẹ, abira anang bẹ ẹpọhna ọkkọkka, bẹ mm'ade atọhmnọng pọ k'igbe maphyir.”<verse eid="1KI 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 12:8" />Okenaka, Rẹhoboam obhum ntọhna s'asogbọhkọnọng mbo manang-ẹ. Ofona od-okebha ayok adikkobhva p'matọn akwurọ, p'ad-asi ọtọhm anang-ẹ. <verse eid="1KI 12:8" /><verse number="9" style="v" sid="1KI 12:9" />Ọbọbh bẹ bẹ́, “Ntọhna sabọnga ide yen? Yen kw'mm'ọpọhna anọng mba p'aben-m bẹ́, yekẹ mina ẹtọhka ch'atte ọyakẹ mina’?”<verse eid="1KI 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 12:10" />Ayok adikkobhva mbo p'matọn akwurọ mapọhn-ẹ bẹ́, “Tek anọng mba p'nkk'ọ abena bẹ́, ‘Wa atte kwọ ọyakẹ mina ẹtọhka ch'ẹdọhbh-ọdọhbh, okenaka, kọ n'si ẹtọhka ndo ebhekẹ mina obhekẹ.’ Tek bẹ bẹ́, ‘Ẹnọhna-gberẹ chaam, edinẹ ọtam ẹyọhnga erin ch'atte kwaam. <verse eid="1KI 12:10" /><verse number="11" style="v" sid="1KI 12:11" />Wa atte kwaam ọyakẹ bọnga ẹtọhka ch'ẹdọhbh-ọdọhbh, kaam m'ntera nsi chẹ nẹdọhbh bọnga ọtam. Wa atte kwaam otim ayaangẹ ottema bọnga, kaam m'ntima aninaangẹ nttem bọnga.’ ”<verse eid="1KI 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 12:12" />Iwu ittaan ikpanẹ nya o, Jẹroboam ọmaana anọng p'Israẹl maphyir makpa nnam akwu akebha ọvaar Rẹhoboam k'ose kw'kk'obena bẹ́, “Màkpa nnam k'iwu ittaan, makwu aze-m.” <verse eid="1KI 12:12" /><verse number="13" style="v" sid="1KI 12:13" />Ọvaar Rehoboam ọpọhna anọng mbo odik ẹgbọhk-ẹgbọhka. Obhum ntọhna njo s'asogbọhkọnọng mbo manang-ẹ, <verse eid="1KI 12:13" /><verse number="14" style="v" sid="1KI 12:14" />oter otor ntọhna s'ayok adikkobhva anang-ẹ. Oben bẹ́, “Wa atte kwaam ọyakẹ bọnga ẹtọhka ch'ẹdọhbh-ọdọhbh. Kaam m'ntera nsi chẹ nẹdọhbh ẹyọhng-ọyọhnga. Wa atte kwaam otim nnyaangichi ottema bọnga, kaam m'ntima aninaangẹ nttema bọnga.” <verse eid="1KI 12:14" /><verse number="15" style="v" sid="1KI 12:15" />Minna kw'ọvaarnọng obhumọ anọng mbo itọhng oyiyonga. Wa Ọvaar Ibinọkpaabyi wọ osi bẹ́, idik njo iyin minna, mfha ode k'ose kw'uwa ikk'Ahija kw'ofon Shilọ otima ọgbaak odik ọnang Jẹroboam, kw'Nẹbat obhonọ.<verse eid="1KI 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 12:16" />K'ogbe kw'anọng p'Israẹl maphyir makwu aze bẹ́, ọvaarnọng odik kwabẹ kọtọk, mapọhna ọvaarnọng bẹ́,</para>
  <para style="q1" vid="1KI 12:16">“Bọng-okebh f'moyen k'Devid,</para>
  <para style="q2" vid="1KI 12:16">Bọng-ọttọhk vọ ọmyẹ mina ọmaana nnwa kw'Jẹsẹ?</para>
  <para style="q1" vid="1KI 12:16">O bọnga anọng p'Israẹl, màbhana z'abọnga k'isọhm!</para>
  <para style="q2" vid="1KI 12:16">Devid o, zenga mmo kkerẹ ọsọhm kwọ!” Minna kw'anọng p'Israẹl mabhan kabẹ k'isọhm.<verse eid="1KI 12:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="1KI 12:17" />Okenaka, wa Rẹhoboam nọbaabh anọng mbo p'Israẹl p'arukọ ny'ibhon s'Juda bẹ-bẹ.<verse eid="1KI 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 12:18" />Ọvaar Rẹhoboam okwu ọtọhm Adoniram kw'uwa od-okkerẹ anọng p'ad-asi agbugbuna. Minna kw'anọng p'Israẹl maphyir, mater atọhbh-ẹ ata maa, ope. Ọvaar Rẹhoboam oyena owujibha, ọsẹr-ọsẹr oyika k'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr, ọrọbh ọnaanga, ozeng z'Jẹrusalẹm. <verse eid="1KI 12:18" /><verse number="19" style="v" sid="1KI 12:19" />Minna kw'anọng p'Israẹl atọm nya, mattaangẹ ivaartaak s'Devid maa, pyirẹ menda.<verse eid="1KI 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 12:20" />K'ogbe kw'anọng p'Israẹl maphyir mabhaang bẹ́, Jẹroboam kk'okwuna, mayer-ẹ k'ikpakaana sabẹ, masẹ-ẹ ọvaarnọng kw'Israẹl maphyir. Ofonamma kw'Juda kẹ-kẹ wọ uwa norikẹ kw'okpobh ivaartaak s'Devid.<verse eid="1KI 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 12:21" />K'ogbe kw'Rẹhoboam opyirẹ z'Jẹrusalẹm, otobha arimanọng p'ọsọhm kw'Juda kibungọ, ọttara p'ofonamma kw'Bẹnjamin, p'ade anọng nnọhna ẹnọhna okwuma arọbh afa, okwuma ijobh bẹ́, marima anọng p'Israẹl ábẹ̀, ọfha ẹvaar ebira ẹkpa nnam z'Rẹhoboam, kw'ode nnwa kw'Sọlọmọn.<verse eid="1KI 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 12:22" />Okenaka, Ibinọkpaabyi oben Shẹmaya kw'ode ọgbaak-ettem ch'Ibinọkpaabyi bẹ́: <verse eid="1KI 12:22" /><verse number="23" style="v" sid="1KI 12:23" />“Ben Rẹhoboam kw'ọvaar Sọlọmọn obhonọ, ọmaana ọsọhm kw'Juda kibungọ, ọmaana anọng p'Bẹnjamin, ọttara anọng mboza maphyir bẹ́, <verse eid="1KI 12:23" /><verse number="24" style="v" sid="1KI 12:24" />‘Ọvaar Ibinọkpaabyi obenẹ bẹ́, M'erima kasi amaana Israẹl, kirẹ ivotte pabọnga bọ. Ọnọng kpenamkpen ọzọhng ọbhana. Kaam wọ nsi odik nwa.’ ” Minna kw'makpobh ọgbaakadik kw'Ọvaar Ibinọkpaabyi, makpa nnam abhana k'ose kw'Ọvaar Ibinọkpaabyi kk'bẹ obena.<verse eid="1KI 12:24" /></para>
  <para style="s1">Jẹroboam otim gol osi akpata p'abhaam</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 12:25" />Wa Jẹroboam osi obhon kw'Shẹkẹm z'ẹkọma ch'agbe, z'ẹbhaakẹ ch'Ephraim, oruk nya. Obina nya obira od-osi obhon kw'Pẹniyẹl.<verse eid="1KI 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 12:26" />Jẹroboam ochibhẹ z'ettem bẹ́, “Oker-m bẹ́, ẹvaar nda min'ebira ẹkpa nnam z'ọsọhm kw'Devid. <verse eid="1KI 12:26" /><verse number="27" style="v" sid="1KI 12:27" />Ó̱de ánọng mba mata z'Jẹrusalẹm bẹ́, mad-afọhnọ nja z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, maning ch'mabira araka nso anang Rẹhoboam kw'ode ttatta kwabẹ, ọmaana ọvaarnọng kw'Juda. Bẹ mm'akpo-okpo afhọ-m, makpa nnam ator ọvaar Rẹhoboam.”<verse eid="1KI 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 12:28" />Ch'ikk'anọng ọbọbha ose kw'im'osi, ọvaarnọng otima gol osi akpata afa p'abhaam. Oben anọng mbo bẹ́, “Kọbaan bẹ́, mabir ata z'Jẹrusalẹm. Anọng p'Israẹl o, màkirẹ aka pabọnga ma e, p'atim bọnga abina z'Ijip e.” <verse eid="1KI 12:28" /><verse number="29" style="v" sid="1KI 12:29" />Ọtọka ọkpata wanẹ ommin z'Bẹtẹl, obira ommin nwoza z'Dan. <verse eid="1KI 12:29" /><verse number="30" style="v" sid="1KI 12:30" />Ọttọhk mva f'osi ma, okwu ode epyibha. Wa anọng mbo mad-azenga k'odenbhir mad-akpobha ọka f'oning z'Bẹtẹl, mabir azenga k'odenbhir mad-akpobha mvoza f'oning z'Dan.<verse eid="1KI 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 12:31" />Jẹroboam osi akapa p'ọyaankpa. Ọrọhbha anọng-kira kpenamkpen p'mm'ad-ataam aka mbo, zaa wura k'efona ch'Lẹvi kafon. <verse eid="1KI 12:31" /><verse number="32" style="v" sid="1KI 12:32" />Jẹroboam ọbhaaka edidaamawu osok k'iwu ichi s'ophe kw'ottong ochenọnttaan, mach'odidaama nwo kw'mad-asi z'Juda. Obira ọfọhnọ nja ny'ija-byi. Minna kw'uwa obira od-osi z'Bẹtẹl, ọd-ọfọhnọ nja ọnang akpata p'abhaam mbo p'ikk'ọsa. Za Bẹtẹl ọdọk, wa osokọ afọhn-ẹja p'akapa mbo p'ikk'ommina k'ọja-byi f'ọyaankpa. <verse eid="1KI 12:32" /><verse number="33" style="v" sid="1KI 12:33" />Ny'iwu ichi s'ophe kw'ottong ochenọnttaan, kw'ode ophe nwo kw'ozeng mmo oteka, ọd-ọfọhnọ nja k'ija-byi s'ikk'ọsa z'Bẹtẹl. Minna kw'uwa Jẹroboam ọbhaak edidaamawu osok anọng p'Israẹl, kẹ ozeng z'ija-byi, ọd-ọnang nnanga.<verse eid="1KI 12:33" /></para>
  <chapter eid="1KI 12" />
  <chapter number="13" style="c" sid="1KI 13" />
  <para style="s1">Ọgbaak-ettem ch'Ibinọkpaabyi kw'ofon z'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 13:1" />Wa ọgbaakadik kw'Ọvaar Ibinọkpaabyi otim ọgbaak-ettem ch'Ibinọkpaabyi obina z'Juda ozeng z'Bẹtẹl, od-okebha Jẹroboam ch'obe ny'ija-byi bẹ́, ọnang ẹnanga. <verse eid="1KI 13:1" /><verse number="2" style="v" sid="1KI 13:2" />Ọgbaakadik kw'Ọvaar Ibinọkpaabyi otim-ẹ ọkwọhrọ ija-byi njo ẹmọng bẹ́, “Ija-byi! Ija-byi! Bhaanga odik kw'Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Kwuna ojinọngnwa kw'okpen Josaya m'ọmmaana ny'ọsọhm kw'Devid. Afọhn-ẹja p'mad-anang nnanga s'ija-byi s'ọyaankpa bọ p'm'otima ọfọhnọ ẹja m'ija-byi nja. Akọbhọ p'ayokinọng bọ p'mm'abira akwọm-ọ ny'ifor.’ ” <verse eid="1KI 13:2" /><verse number="3" style="v" sid="1KI 13:3" />Ny'ewu ndo madan-danẹ, ọgbaak-ettem ch'Ibinọkpaabyi osi ẹkọhka danẹ ọnang bẹ, oben bẹ́, “Ma wọ ode ẹkọhka ch'Ọvaar Ibinọkpaabyi obenẹ, ija-byi njo m'bhaaka, ititọhng s'inan nya, inyaanẹ.”<verse eid="1KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 13:4" />K'ogbe kw'ọvaar Jẹroboam ọbhaang ẹmọng ndo ch'ọgbaak-ettem ch'Ibinọkpaabyi ọkwọhrọ ija-byi s'Bẹtẹl, Jẹroboam oninga ny'ija-byi njo, onemẹ ọbọhk kwẹ, oben bẹ́, “Màbọk-ẹ!” Minna kw'ọbọhk nwo kw'onemẹ otena ọgbaak-ettem ch'Ibinọkpaabyi ope, ọkaka, ọdọk k'izek kokpo ọsaka. <verse eid="1KI 13:4" /><verse number="5" style="v" sid="1KI 13:5" />Minna kw'ija-byi njo ibira ibhaaka. Ititọhng s'inan nya inyaanẹ, itor k'ẹkọhka ch'ọgbaak-ettem ch'Ibinọkpaabyi otim ẹfa ch'ọgbaakadik kw'Ọvaar Ibinọkpaabyi, ọnang.<verse eid="1KI 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 13:6" />Nya o, ọvaar Jẹroboam oben ọgbaak-ettem ch'Ibinọkpaabyi nwo bẹ́, “Ototo, kwukọ Ọvaar Ibinọkpaabyi kwọ k'kaam k'eso, abira aze njọm, ọfha ọbọhk kwaam obira ode k'ose kw'okkikken ode.” Minna kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo oze njọm ọnang Ọvaar Ibinọkpaabyi, ọbọhk nwo kw'ọvaarnọng obira okwu ode mbengana. <verse eid="1KI 13:6" /><verse number="7" style="v" sid="1KI 13:7" />Ọvaarnọng oben ọgbaak-ettem ch'Ibinọkpaabyi nwo bẹ́, “Kwu mọtọn ofona z'ọsọhm, ọfha ad-achi ọttọhk, mbira nsọ-ọ ẹtaam.”<verse eid="1KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 13:8" />Ọgbaak-ettem ch'Ibinọkpaabyi nwo ọpọhna ọvaarnọng bẹ́, “Zaa wura akebhẹ oyena kwọ k'ibyi ifa anang-m igboka janẹ, kaam kọ mìntor mofona, ọchattọhk ma mìnchi, asi ma m'mbira ngwo. <verse eid="1KI 13:8" /><verse number="9" style="v" sid="1KI 13:9" />Ọgbaakadik kw'Ọvaar Ibinọkpaabyi oben-m bẹ́, ‘Ọttọhk kàchi, asi kàgwo, ny'eden ch'azeng akwu kabira azenga abhana.’ ” <verse eid="1KI 13:9" /><verse number="10" style="v" sid="1KI 13:10" />Nya o, ọgbaak-ettem ch'Ibinọkpaabyi nwo, nozenga k'eden ọdọk-ọdok ọbhana, ọdọk ny'eden ch'iwura ozeng ochina z'Bẹtẹl, kozeng.<verse eid="1KI 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 13:11" />Wa oyen ọgbaak-ettem ch'Ibinọkpaabyi wanẹ kw'ikk'ọtama kw'orukọ ny'Bẹtẹl. Ajinọngva pẹ akwu atek-ẹ idik maphyir s'ọgbaak-ettem ch'Ibinọkpaabyi nwo ikk'ọsa ny'ibyi njo, ny'ewu ndo. Mabira atek otte odik kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo ikk'ọgbaaka ọnang ọvaarnọng. <verse eid="1KI 13:11" /><verse number="12" style="v" sid="1KI 13:12" />Otte kwabẹ ọbọbh bẹ bẹ́, “Memma kw'ozeng o?” Ajinọngva mbo matibh-ẹ eden ch'ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ofon z'Juda, ozeng ofona. <verse eid="1KI 13:12" /><verse number="13" style="v" sid="1KI 13:13" />Nya kw'nobenẹ ajinọngva pẹ bẹ́, “Màdo iwọrninga-byi ny'ẹnyanya nang-m.” Ch'nkk'iwọrninga-byi ada ny'ẹnyanya anang-ẹ, ovura ọnana, <verse eid="1KI 13:13" /><verse number="14" style="v" sid="1KI 13:14" />ọyaar okwubh ọgbaak-ettem ch'Ibinọkpaabyi nwo z'eden. Od-okebh-ẹ ch'oning ẹwọr z'echirin ch'oak, ọbọbh-ẹ bẹ́, “Ma, kọ wọ ade ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ofon z'Juda yirẹ?” Ọgbaak-ettem ch'Ibinọkpaabyi nwo ọpọhn-ẹ bẹ́, “Iye, kaam wọ e.”<verse eid="1KI 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 13:15" />Minna kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ikk'ọtama oben-ẹ bẹ́, “Kwu mofona, ad-achi ọttọhk z'kaam k'ọsọhm.”<verse eid="1KI 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 13:16" />Ọgbaak-ettem ch'Ibinọkpaabyi nwo oben-ẹ bẹ́, “Kaam kọ mìntor mọkpa nnam. Ọchattọhk mìmbir nchi mmaan-ọ, ozeng k'asi pọ, mìmbira ngwo. <verse eid="1KI 13:16" /><verse number="17" style="v" sid="1KI 13:17" />Ọgbaakadik kw'Ọvaar Ibinọkpaabyi kk'aam obena bẹ́: ‘Ọchattọhk za kachi o, asi za kàgwo o, ny'eden ndo ch'azeng ata kabira azenga akwuna o.’ ”<verse eid="1KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 13:18" />Ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ikk'ọtama ọpọhna bẹ́, “Kaam mbira nde ọgbaak-ettem ch'Ibinọkpaabyi mach'ikọ e. Ọvaar Ibinọkpaabyi wọ otim ozeng-eden wanẹ kwẹ oben-m bẹ́, ‘Tim-ẹ kpa nnam z'ọsọhm kwọ, ọfha ochi ọttọhk, obira ogwo asi.’ ” (Zanga, wa ọd-ọbọhr-ẹ ọbọhra.) <verse eid="1KI 13:18" /><verse number="19" style="v" sid="1KI 13:19" />Minna kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo otor-ẹ makpa nnam, od-ochi ọttọhk, obira ogwo asi z'ọsọhm kwẹ.<verse eid="1KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 13:20" />Nya ch'matim achi ọttọhk ny'okpokkoro, Ọvaar Ibinọkpaabyi ọtọhm ẹkkaabha ọnang ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ikk'ọtama, kw'otim oyok ọkpa nnam. <verse eid="1KI 13:20" /><verse number="21" style="v" sid="1KI 13:21" />Ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ikk'ọtama, oben ọgbaak-ettem ch'Ibinọkpaabyi nwoza kw'ofon z'Juda k'ẹrọng bẹ́, “Ọvaar Ibinọkpaabyi obenẹ bẹ́: ‘Kọ kk'ọgbaakadik kw'Ọvaar Ibinọkpaabyi atwa. Ọsana kw'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ kabira akpobha. <verse eid="1KI 13:21" /><verse number="22" style="v" sid="1KI 13:22" />Kọ akpa nnam ad-achi ọttọhk, abira agwo asi z'ibyi s'mben-ọ bẹ́, aning ọttọhk nya achi, aning asi nya abira agwo. Ch'node minna, ọkpakpa kwọ ọdọk z'epekwuk ch'ab'atte, mọ̀nọhnga.’ ”<verse eid="1KI 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 13:23" />K'ogbe kw'ọgbaak-ettem ch'Ibinọkpaabyi kw'ofon z'Juda kk'ọttọhk ọcha kpo, obira ogwo asi, ọgbaak-ettem ch'Ibinọkpaabyi nwoza kw'ọtọk-ẹ z'eden otima ọkpa nnam, odo iwọrninga-byi ny'ẹnyanya chẹ, ọnang-ẹ. <verse eid="1KI 13:23" /><verse number="24" style="v" sid="1KI 13:24" />Ch'nọbhan-ọbhana o, eche ekebh-ẹ z'eden ẹfhọ, ẹbharẹ ọkpakpa kwẹ ny'eden. Ẹnyanya chẹ ọttara eche ndo ch'ẹfhẹ-ẹ, ebe etum-ẹ ny'ẹbhaakẹ danẹ. <verse eid="1KI 13:24" /><verse number="25" style="v" sid="1KI 13:25" />Anọng banẹ p'akpanẹ nya, maze ọkpakpa nwo kwẹ ch'oyim ny'izek, ttara eche ndo ch'ebe etum-ẹ nya. Anọng mbo afona mad-agbaak anọng z'ebhondim ch'ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ikk'ọtama, orukọ.<verse eid="1KI 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 13:26" />K'ogbe kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'otim-ẹ z'eden okpa nnam ọbhaang odik nwo nya, oben bẹ́, “Ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ọtwọ ọgbaakadik kw'Ọvaar Ibinọkpaabyi wọ e. Ọvaar Ibinọkpaabyi kk'ẹ ọbọhk ọtta ọnang eche, ẹyaak-ẹ k'akpa-k'akpa, ebira ẹfhẹ-ẹ, k'ose kw'ọgbaakadik kw'Ọvaar Ibinọkpaabyi kk'ẹ itọhng ọtọra.”<verse eid="1KI 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 13:27" />Ọgbaak-ettem ch'Ibinọkpaabyi nwo, oben ajinọngva pẹ bẹ́, “Màdo iwọrninga-byi ny'ẹnyanya nang-m.” Iva mbo masi minna. <verse eid="1KI 13:27" /><verse number="28" style="v" sid="1KI 13:28" />Minna kw'ofon od-oze oforbukọ nwo ch'oyim ny'eden, ọmaana ẹnyanya, ọttara eche ndo ch'ebe etuma oforbukọ nwo ny'ẹbhaakẹ danẹ. Eche ndo oforbukọ nwo kechi, ẹnyanya ndo k'akpa-k'akpa kebir ẹyaakẹ. <verse eid="1KI 13:28" /><verse number="29" style="v" sid="1KI 13:29" />Minna kw'ọgbaak-ettem ch'Ibinọkpaabyi nwo kw'ikk'ọtama, otinẹ oforbukọ nwo kw'ọgbaak-ettem ch'Ibinọkpaabyi ọnana ny'ẹnyanya, otim-ẹ ọbhana z'ebhondim ch'ikẹ kw'otin-ẹ otinẹ, ọfha obhom-ẹ, obira ọnọhng-ẹ. <verse eid="1KI 13:29" /><verse number="30" style="v" sid="1KI 13:30" />Wa ọnọhnga oforbukọ nwo z'epekwuk chẹ oyenẹ. K'ose kw'anọng abhom-ẹ, kẹ oben bẹ́, “O agbaanatte kwaam e!”<verse eid="1KI 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 13:31" />Ch'ikẹ ọnọhnga o, oben ajinọngva pẹ bẹ́, “Óbo ókwu-m, mànọhng-m ny'epekwuk ndo ch'ọgbaak- ettem ch'Ibinọkpaabyi nwo ọnọhng. Màrurọ akọbhọ paam k'ẹbhaakẹ danẹ ch'akọbhọ pẹ. <verse eid="1KI 13:31" /><verse number="32" style="v" sid="1KI 13:32" />Kirẹ, ẹkkaabha ndo ch'Ọvaar Ibinọkpaabyi ọtọhm-ẹ bẹ́, ọgbaak ọnang ija-byi s'Bẹtẹl ọmaana akapa maphyir p'ibhon s'Samariya, m'ede minna k'odik ọkkọkka.”<verse eid="1KI 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 13:33" />Chibhẹ ch'idik nja kk'iyina, Jẹroboam nnam kọtọrọ k'adik-tama. Wa obira od-oteka ọnọngkira kpenamkpen ọsẹ-ẹ ọfọhn-ẹja kw'akapa. Ọnọng kpenamkpen kw'uwa ororọ bẹ́, ode ọfọhn-ẹja, waJẹroboam ọd-ọsẹ-ẹ ọfọhn-ẹja kw'ọkapa kw'agbeso. <verse eid="1KI 13:33" /><verse number="34" style="v" sid="1KI 13:34" />Epyibha ch'iwa ẹnọmma ch'Jẹroboam esi dọ ma, ch'etim ẹnọmma chẹ etto, ẹvọhkọ maa, edimẹ eche m'iyagbin.<verse eid="1KI 13:34" /></para>
  <chapter eid="1KI 13" />
  <chapter number="14" style="c" sid="1KI 14" />
  <para style="s1">Ọgbaakadik kw'Ahija kw'ọmaan Jẹroboam</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 14:1" />Ny'ogbe nwo, Abija kw'ode nnwa kw'Jẹroboam okwu ọmmẹ-ẹ. <verse eid="1KI 14:1" /><verse number="2" style="v" sid="1KI 14:2" />Jẹroboam oben kwanọng kwẹ bẹ, “Zọhng bhona ifor k'ose kw'nna kọ matin bẹ́, ade kwanọng kw'Jẹroboam. Íkk'asa minna, china z'Shilo, za ch'Ahija kw'ode ọgbaak-ettem ch'Ibinọkpaabyi orukọ. Kẹ wọ wa ọgbaak-m bẹ́, kaam wọ im'nde ọvaarnọng kw'anọng mba. <verse eid="1KI 14:2" /><verse number="3" style="v" sid="1KI 14:3" />Tọka abrẹd-duk ijobh, ọmaana ayokpa, ọttara akọhnsi k'egbomma, atima akebh-ẹ za. Kẹ m'otek-ọ odik kw'im'oyin ọmaana odikkobh nwo.” <verse eid="1KI 14:3" /><verse number="4" style="v" sid="1KI 14:4" />Minna kw'kwanọng kw'Jẹroboam osi k'ose kw'obenẹ, obina ochina z'ọsọhm kw'Ahija z'Shilọ. Wa ny'ogbe nwo, Ahija kk'achen ọkpa okurọ ch'ikk'ọtama.<verse eid="1KI 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 14:5" />Okenaka, Ọvaar Ibinọkpaabyi kk'Ahija okkikken otek bẹ́, “Kwanọng kw'Jẹroboam okwuma bẹ́, ọbọbh-ọ odik kw'ọmaan nnwa kwẹ kw'ọmm-ẹ ọmma. Ó̱de ókwu, m'apọhn-ẹ minna minna bẹ́. Ch'kwanọng nwo m'opyirẹ, m'osi k'ose kw'ina kẹ matin.”<verse eid="1KI 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 14:6" />Ch'Ahija ọbhaang ntọkọ sẹ ny'ọmma, oben-ẹ bẹ́, “Kwanọng kw'Jẹroboam, dim ka ọsọhm. Osempira ad-asi mach'ina kọ ode? Manang-m ẹkkaabhatama bẹ́, nchen-ọ. <verse eid="1KI 14:6" /><verse number="7" style="v" sid="1KI 14:7" />Zọhng, ad-agbaak Jẹroboam bẹ́, odik kw'Ọvaar Ibinọkpaabyi kw'Israẹl ọgbaakẹ ode bẹ́, “Wa kaam nrọhbh-ọ ny'ikpakaana s'anọng, mbira nsọ-ọ bẹ́, abaabha anọng paam p'Israẹl. <verse eid="1KI 14:7" /><verse number="8" style="v" sid="1KI 14:8" />Kaam ntọk ẹvaar z'ntaak s'Devid nnang-ọ. Okenaka, kọ mach'Devid kw'ode ọtọhmnọng kwaam, kade. Kẹ okpobh asana paam, obir otima ettem chẹ maphyir otor-m, od-osi idik s'itor-otor jẹ-jẹ.<verse eid="1KI 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 14:9" />Kọ kk'mpyibha asa s'iyọhng s'anọng maphyir p'nkk'eden acha, abaabha. Kọ kk'nnam akpa abọr-m, abira asi ettem ebhem-m, okurọ bẹ́, atim m̀gbáká asi aka, ọmaana akpata akpobha.<verse eid="1KI 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 14:10" />Ofona nya, kaam m'ntọhm itama ikpẹkẹ ẹnọmma ch'Jẹroboam. Kaam m'mbira mfhọ ojinọngnwa kpenamkpen kw'Jẹroboam kw'ode okpongannam, zaa wura ode obira, obir ode ọmmaana. Kaam m'ndimẹ ẹnọmma ch'Jẹroboam mach'ọnọng ọkwọmọ ẹbọr maa, ẹsa maphyir. <verse eid="1KI 14:10" /><verse number="11" style="v" sid="1KI 14:11" />Mfa m'ichi anọng p'Jẹroboam p'ape z'ebhondim. Ọnọhn m'obir ochi anọng pẹ p'ape z'ẹgba. Odik kw'Ọvaar Ibinọkpaabyi ikk'ọgbaaka wọ ma.”<verse eid="1KI 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 14:12" />Ṉ́nòde kọ, bina bhana. K'ose kw'abarẹ ẹtọkọ chọ ny'ebhondim, ojinọngnwa nwo m'ope. <verse eid="1KI 14:12" /><verse number="13" style="v" sid="1KI 14:13" />Anọng p'Israẹl maphyir m'abhom-ẹ, mabira anọhng-ẹ. Kẹ-kẹ wọ kw'mm'anọhnga mawuriji ny'ẹnọmma ch'Jẹroboam, okurọ bẹ kẹ-kẹ wọ kw'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl, ọdaam ettem ọmaana.<verse eid="1KI 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 14:14" />“Ọvaar Ibinọkpaabyi m'ozeng mmo ọrọhbha ọnọng kw'im'ode ovaarnọng kw'Israẹl kw'im'odimẹ ẹnọmma ch'Jẹroboam. <verse eid="1KI 14:14" /><verse number="15" style="v" sid="1KI 14:15" />Ọvaar Ibinọkpaabyi m'ọnang anọng p'Israẹl irem maa, makerẹ ozizaarẹ kw'asi kw'ọd-ọdang-ọdanga. Kẹ m'obik anọng p'Israẹl m'izek ọkkọkka nja s'iwa ọnang ab'ttatta pabẹ. M'obir osi bẹ maraamẹ maa, makpan ọraanga kw'Eupharetes, okurọ ch'masi ọka f'Ashẹra, mawọhkọ ettem ebhem Ọvaar Ibinọkpaabyi. <verse eid="1KI 14:15" /><verse number="16" style="v" sid="1KI 14:16" />Ọvaar Ibinọkpaabyi m'ọkpa nnam ọbọra anọng p'Israẹl okurọ mpyibha s'Jẹroboam ikk'ọsa, ọttara s'ọwọhkọ anọng p'Israẹl masi.”<verse eid="1KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 14:17" />Nya o, kwanọng kw'Jẹroboam obina ọkpa nnam z'Tirza. K'ose kw'ọbarẹ ẹtọkọ ny'ẹsọhmma chẹ, ojinọngnwa nwo kwẹ, ope. <verse eid="1KI 14:17" /><verse number="18" style="v" sid="1KI 14:18" />Anọng p'Israẹl maphyir mabhom-ẹ, mabira atọk-ẹ anọhnga k'ose kw'Ọvaar Ibinọkpaabyi ikk'Ahija kw'ode ọgbaak-ettem ch'Ibinọkpaabyi otima ọgbaak.<verse eid="1KI 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 14:19" />Idik njoza s'iyinẹ k'ogbe kw'Jẹroboam ọbaabh, ọmaana mgbong s'orim, wa makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="1KI 14:19" /><verse number="20" style="v" sid="1KI 14:20" />Wa Jẹroboam ọbaabh k'icho ẹrọbh okwuma ifa, pira nope okebha ab'otte z'izek. Wa Nadab kw'ode ojinọngnwa kwẹ, okwu ọtọka eninga chẹ mach'ọvaarnọng.<verse eid="1KI 14:20" /></para>
  <para style="s1">Rẹhoboam otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 14:21" />Wa Rẹhoboam kw'ode nnwa kw'Sọlọmọn ode ọvaarnọng kw'Juda. Wa ode icho arọbh afa okwuma mawanẹ ch'ọtọm ẹbaabha. Ọbaabha k'icho ichi kkamfa ny'Jẹrusalẹm kw'ode ebhondim ch'Ọvaar Ibinọkpaabyi ikk'oteka ny'mfonamma s'Israẹl maphyir bẹ́, maninga akpobha eche chẹ. Ọkka kw'Rẹhoboam okpen Naama, ofona Ammọn.<verse eid="1KI 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 14:22" />Wa anọng p'Juda asi itama z'Ọvaar Ibinọkpaabyi k'ititika. Ofona ny'mpyibha njo s'masi, Ibinọkpaabyi ọdọk-ẹ ọyọhnga ose kw'uwa ọdọk-ẹ ọmaana ab'ttatta pabẹ. <verse eid="1KI 14:22" /><verse number="23" style="v" sid="1KI 14:23" />Wa mattim ọja-byi f'ọyaankpa, mabira attima ata p'mm'akpobha, mafu nchi s'ọka f'Ashẹra k'ogbeso kpenamkpen, ọmaana k'echi kpenamkpen ch'eyen ofokodo. <verse eid="1KI 14:23" /><verse number="24" style="v" sid="1KI 14:24" />Wa mayen aka-pa p'azaza p'ejinọng ny'ẹkọma ndo. Anọng mbo mabira asi idik maphyir s'ibọk-ọbọkọ, s'ide mach'njo s'iwọhkọ Ọvaar Ibinọkpaabyi okwubh nkọma s'iwa ining nya, pira anọng p'Israẹl apyirẹ.<verse eid="1KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 14:25" />Ny'icho ttong ichen s'Rẹhoboam ọbaabh Juda, ọvaar Shishak kw'Ijip, orima Jẹrusalẹm ábẹ̀. <verse eid="1KI 14:25" /><verse number="26" style="v" sid="1KI 14:26" />Wa Shishak ọcha oyena kw'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana oyena kw'ọvaardimpa, otima ofona. Obir ọtọka ọttọhk kpenamkpen, ozeng k'agbongtergba p'gol p'uwa Sọlọmọn ikk'ọsa. <verse eid="1KI 14:26" /><verse number="27" style="v" sid="1KI 14:27" />Nya o, Rẹhoboam otima bronz osi agbongtergba, otima otera mboza. Ọtọka okebh ọnang asonọng p'ad-akkerẹ ebhumma ch'ọvaardimpa. <verse eid="1KI 14:27" /><verse number="28" style="v" sid="1KI 14:28" />Ogbe kpenamkpen kw'ọvaarnọng ochin z'Ọsọhm kw'Ọvaar Ibinọkpaabyi, akker-ibyi m'atima agbongtergba mbo. Mácher nya, matọka ad-arik z'idongọ s'akker-ibyi.<verse eid="1KI 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 14:29" />Idik njoza s'imaan ẹbaabha ch'Rẹhoboam, ọttara ekpo maphyir py'osi, makkẹrẹ z'anwẹr p'avaar p'Juda. <verse eid="1KI 14:29" /><verse number="30" style="v" sid="1KI 14:30" />Wa Rẹhoboam ọmaana Jẹroboam marim ayok ábẹ̀ k'ogbe kpenamkpen. <verse eid="1KI 14:30" /><verse number="31" style="v" sid="1KI 14:31" />Wa Rẹhoboam okwu ope, manọhng-ẹ z'ebhondim ch'Devid, okebha ab'otte z'izek. Wa ọkka kwẹ okpen Naama, kw'ofon Ammọn. Abija kw'uwa ode ojinọngnwa kw'Rẹhoboam, okwu ọtọka ẹvaarninga ch'otte.<verse eid="1KI 14:31" /></para>
  <chapter eid="1KI 14" />
  <chapter number="15" style="c" sid="1KI 15" />
  <para style="s1">Abija otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 15:1" />Ny'icho ttong ichi kkanttaan s'ẹbaabha ch'Jẹroboam kw'ode nnwa kw'Nẹbat, nya kw'Abija otim ẹvaar ch'Juda. <verse eid="1KI 15:1" /><verse number="2" style="v" sid="1KI 15:2" />Wa ọbaabh Jẹrusalẹm k'icho ittaan. Ọkka kwẹ okpen Maaka, kw'ode ominanwa kw'Abishalọm.<verse eid="1KI 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 15:3" />Wa kẹ osi mpyibha njo maphyir s'iwa oze otte ch'od-osi. Ettem chẹ maphyir kotim okpobha Ọvaar Ibinọkpaabyi k'ose kw'uwa Devid kw'ode ttatta kwẹ, osi. <verse eid="1KI 15:3" /><verse number="4" style="v" sid="1KI 15:4" />Okenaka, Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwẹ, ozenga Devid ábẹ̀, ọnang-ẹ ojinọngnwa kw'im'ọtọka eninga chẹ, obir osi Jẹrusalẹm ọgaangẹ. <verse eid="1KI 15:4" /><verse number="5" style="v" sid="1KI 15:5" />Wa osi minna okurọ bẹ́, wa Devid kk'idik s'itor-otor ọsa z'Ọvaar Ibinọkpaabyi k'ititika, obir okpobha asana p'Ọvaar Ibinọkpaabyi k'akpen pẹ maphyir, kw'ọkpanẹ odik kw'Uriya kw'ofon Het.<verse eid="1KI 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 15:6" />K'akpen p'Abija maphyir, wa kẹ ọmaana Jẹroboam marukọ egbong-egbong. <verse eid="1KI 15:6" /><verse number="7" style="v" sid="1KI 15:7" />Ṉ́nòde idik njoza s'iyinẹ k'ogbe kw'Abija ọbaabh, makkẹrẹ z'anwẹr p'avaar p'Juda. Wa Abija ọmaana Jẹroboam marukọ egbong-egbong. <verse eid="1KI 15:7" /><verse number="8" style="v" sid="1KI 15:8" />Abija okwu ope, matọk-ẹ anọhnga z'ebhondim ch'Devid, okebha ab'otte z'izek. Asa kw'ode ojinọngnwa kwẹ, okwu ọtọka ẹvaarninga ch'otte.<verse eid="1KI 15:8" /></para>
  <para style="s1">Asa otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 15:9" />Ny'icho ttong ẹrọbh s'Jẹroboam ọbaabh Israẹl, nya wọ kw'manang Asa ẹvaar ch'Juda. <verse eid="1KI 15:9" /><verse number="10" style="v" sid="1KI 15:10" />Ọbaabha Jẹrusalẹm k'icho arọbh afa okwuma mawanẹ. Wa ọkka kwẹ kwiden okpen Maaka, obir ode nnwa kw'Abishalọm.<verse eid="1KI 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 15:11" />Wa Asa osi idik s'itor-otor z'ititika s'Ọvaar Ibinọkpaabyi, k'ose kw'uwa Devid kw'ode otte, osi. <verse eid="1KI 15:11" /><verse number="12" style="v" sid="1KI 15:12" />Wa odimẹ aka-pa p'azaza p'ejinọng ny'izek njo, obir odimẹ akpata maphyir p'uwa ab'ttatta pẹ nkk'asa. <verse eid="1KI 15:12" /><verse number="13" style="v" sid="1KI 15:13" />Wa ọrọhbh ọkka kwẹ kwiden k'eninga ch'ọvaarkwanọng, okurọ bẹ́, osi ọkpata kw'Ashẹra kw'ọbọk-ọbọkọ bẹ́, anọng akpobha. Asa opekẹ ọkpata nwo, obir ọkwọmọ wẹ z'ilokodo s'Kidrọn. <verse eid="1KI 15:13" /><verse number="14" style="v" sid="1KI 15:14" />Chibhẹ ch'iwa ina ọja-byi f'ọyaankpa odimẹ, wa ettem chẹ eyik k'Ọvaar Ibinọkpaabyi k'akpen pẹ maphyir. <verse eid="1KI 15:14" /><verse number="15" style="v" sid="1KI 15:15" />Asa otima silva, ọmaana gol, ọttara ekpo mbyoza py'kẹ ọmaana otte nkk'ọbọhk atta anang Ibinọkpaabyi, okwu osok z'Ọsọhm kw'Ibinọkpaabyi.<verse eid="1KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 15:16" />Asa ọmaana Baasha wa marukọ egbong-egbong ny'ogbe nwo maphyir kw'mabaabh. <verse eid="1KI 15:16" /><verse number="17" style="v" sid="1KI 15:17" />Ọvaar Baasha kw'Israẹl obina od-orima Juda ábẹ̀. Ọkpa nden s'Rama, ọfha ọnọng kpenamkpen oning k'iyaan oyinẹ, wanẹma, odim z'ẹkọma ch'ọvaar Asa kw'Juda.<verse eid="1KI 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 15:18" />Nya o, Asa ọtọka asilva, ọmaana gol p'arikẹ z'ẹkpa ch'Ọsọhm kw'Ọvaar Ibinọkpaabyi, ọmaana z'ẹkpa ch'odimpa kwẹ oyenẹ, ọnang adukwa pẹ. Pira ọtọhm bẹ z'Bẹn-Hadad kw'ode nnwa kw'Tabrimọn kw'ọvaar Eziyọn kw'Aram obhonọ, kw'uwa obir ọbaabha Damaskọs. <verse eid="1KI 15:18" /><verse number="19" style="v" sid="1KI 15:19" />Oben-ẹ bẹ́, “Tte kaam ọmaana kọ mochekẹ ọnang ayok mach'iwa ab'atte pamina masi. Kaam m'ntọhm silva ọmaana gol nnang-ọ mach'ẹnanga. Ofona nya, gbira mbọhk z'echekẹ ch'asi amaana ọvaar Baasha kw'Israẹl, ọfha ọrọhbh-m ichen.”<verse eid="1KI 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 15:20" />Bẹn-Hadad okwu ochera ọmaana ọvaar Asa. Ọtọhm agbongsonọng pẹ, mad-arima ibhon s'Israẹl ábẹ̀. Okema obhon kw'Ijọn, ọmaana kw'Dan, ọmaana kw'Abẹl-Bẹt Maaka, ọmaana kw'Kinẹrẹt maphyir, ọttara ẹkọma ch'Naptali. <verse eid="1KI 15:20" /><verse number="21" style="v" sid="1KI 15:21" />Baasha ọbhaang odik nwa nya o, ọkpọka ọtọhm z'Rama osisi, ọrọbh ozeng z'Tirza. <verse eid="1KI 15:21" /><verse number="22" style="v" sid="1KI 15:22" />Nya o, ọvaar Asa oke ẹfa bẹ́, ọnọng kpenamkpen kw'ofon Juda, ọd-ọtọhka ata, ọmaana agbaaka p'uwa Baasha od-otima osi obhon kw'Rama. Byẹ byọ py'uwa ọvaar Asa notim osi obhon kw'Gẹba, z'ẹbhaakẹ ch'Bẹnjamin, ọttara obhon kw'Mizpa.<verse eid="1KI 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 15:23" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Asa ọbaabh, ọmaana nkema sẹ, ọmaana ibhondim maphyir s'osi, makkẹrẹ z'anwẹr p'avaar p'Juda. Okenaka, k'atam pẹ, wa nọmm-ẹ k'mmokpatọkọ. <verse eid="1KI 15:23" /><verse number="24" style="v" sid="1KI 15:24" />Asa okwu ope, okebha ab'otte z'izek. Manọhng-ẹ z'ebhondim ch'Devid kw'ode otte. Jẹhoshafat kw'ode nnwa kwẹ, okwu ọtọka ẹvaarninga ch'otte.<verse eid="1KI 15:24" /></para>
  <para style="s1">Nadab otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 15:25" />Wa Nadab kw'ode nnwa kw'Jẹroboam okwu ode ọvaarnọng kw'Israẹl k'icho ttong ifa s'ọvaar Asa ọbaabh Juda. Kẹ ọbaabh Israẹl k'icho ifa. <verse eid="1KI 15:25" /><verse number="26" style="v" sid="1KI 15:26" />Kẹ wa osi itama z'ititika s'Ọvaar Ibinọkpaabyi. Otor ntọkọ s'otte, obira osi mpyibha njo s'iwa otte otim anọng p'Israẹl osi.<verse eid="1KI 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 15:27" />Wa Baasha kw'ode nnwa kw'Ahija kw'ofon k'efona ch'Isaka, ochi Nadab ikwu, ọfhẹ-ẹ z'Gibeton kw'ode obhon wanẹ kw'Philistiya. Ny'ogbe nwo, wa Nadab ọmaana anọng p'Israẹl maphyir mayim egbong ny'Gibeton. <verse eid="1KI 15:27" /><verse number="28" style="v" sid="1KI 15:28" />K'icho ttong ittaan s'Asa ọbaabh Juda, nya kw'uwa Baasha ọfhọ Nadab, obir ọtọka ẹvaar chẹ.<verse eid="1KI 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 15:29" />K'ose kw'ọtọm ẹbaabha nya, ọfhọ ẹsọhmmọr ch'Jẹroboam kibungọ. Ọnọng mawanẹ kw'Jẹroboam kw'oruk akpen kode kw'uwa ina ọfhọ ny'ọsọhm. Wa ọfhọ bẹ maphyir, otor k'ose kw'uwa Ọvaar Ibinọkpaabyi otim Ahija kw'ode ọtọhmnọng kwẹ kw'ofon Shilon, ọgbaak. <verse eid="1KI 15:29" /><verse number="30" style="v" sid="1KI 15:30" />Wa idik njoma iyinẹ okurọ mpyibha s'Jẹroboam ikk'ọsa, ọmaana s'ikk'ọwọhka anọng p'Israẹl masi. Ọttara bẹ́, wa osi Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl ọdọk-ẹ.<verse eid="1KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 15:31" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Nadab ọbaabh, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="1KI 15:31" /><verse number="32" style="v" sid="1KI 15:32" />Wa ọvaar Asa ọmaana ọvaar Baasha kw'Israẹl, marukọ egbong-egbong k'ẹbaabha chabẹ maphyir.<verse eid="1KI 15:32" /></para>
  <para style="s1">Baasha otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 15:33" />Ny'icho ttong ittaan s'ọvaar Asa ọbaabh Juda, nya kw'Baasha kw'ode nnwa kw'Ahija oning z'Tirza, ọbaabha Israẹl maphyir. Wa otim ẹvaar k'icho ẹrọbh okwuma nna. <verse eid="1KI 15:33" /><verse number="34" style="v" sid="1KI 15:34" />Wa Asa osi itama z'ititika s'Ọvaar Ibinọkpaabyi mach'Jẹroboam kw'ọwọhkọ anọng p'Israẹl abira asi mpyibha.<verse eid="1KI 15:34" /></para>
  <chapter eid="1KI 15" />
  <chapter number="16" style="c" sid="1KI 16" />
  <para style="p">
    <verse number="1" style="v" sid="1KI 16:1" />Wa Ọvaar Ibinọkpaabyi otim Jehu kw'ode nnwa kw'Hanani ọgbaak odik kw'ọmaan Baasha bẹ́, <verse eid="1KI 16:1" /><verse number="2" style="v" sid="1KI 16:2" />“Wa ngwọhng-ọ z'ididọhbh, nsọ-ọ ọbaabh kw'anọng p'Israẹl. Okenaka, kọ ator nden s'Jẹroboam. Ofona nya, awọhkọ Israẹl p'ade anọng paam, masi epyibha, mabir asi ettem ebhem-m. <verse eid="1KI 16:2" /><verse number="3" style="v" sid="1KI 16:3" />Nya o, kaam kk'ifor nda s'm'ndimẹ Baasha, ọmaana ẹnọmma chẹ, k'ose kw'nsi ẹnọmma ch'Jẹroboam kw'ode nnwa kw'Nẹbat. <verse eid="1KI 16:3" /><verse number="4" style="v" sid="1KI 16:4" />Mffa m'ichi aforbukọ p'anọng p'Baasha p'ape ny'ebhondim, ọnọhn f'ẹrọng m'ochi aforbukọ p'anọng p'ape z'ẹgba.<verse eid="1KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 16:5" />Idik njoza s'iyinẹ k'ogbe kw'Baasha ọbaabh, ọmaana idik s'osi, ọttara mgbong s'iwa okem, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="1KI 16:5" /><verse number="6" style="v" sid="1KI 16:6" />Baasha o, okwu ope, manọhng-ẹ z'Tirza, okebha ab'otte z'izek. Ẹla kw'ode ojinọngnwa kwẹ, okwu ọtọka ẹvaarninga ch'otte.<verse eid="1KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 16:7" />Ọvaar Ibinọkpaabyi obir otima Jehu kw'ode ọgbaak-ettem ch'Ibinọkpaabyi, obir ode nnwa kw'Hanani, ọgbaak odik ọnang Baasha ọmaana ẹnọmma chẹ okurọ itama maphyir s'ikk'ọsa z'Ọvaar Ibinọkpaabyi k'ititika. Adiktama mbo p'uwa Baasha osi mach'ẹnọmma ch'Jẹroboam, epyibh Ibinọkpaabyi ettem, okurọ ch'odimẹ ẹnọmma ch'Jẹroboam.<verse eid="1KI 16:7" /></para>
  <para style="s1">Ẹla otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 16:8" />Ny'icho ttong ẹrọbh okwuma ichadanẹ s'Asa ode ọvaarnọng kw'Juda, nya kw'Ẹla, kw'ode nnwa kw'Baasha, otim ẹvaar ch'Israẹl. Oninga ny'Tirza ọbaabha Israẹl k'icho ifa.<verse eid="1KI 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 16:9" />Zimri kw'uwa ode osonọng wanẹ kw'od-okkerẹ ẹbhaakẹ danẹ ch'ijaar s'egbong, ochi Ẹla ikwu. Ny'ogbe nwo, Ẹla kk'atuk ọdọhbha z'ọsọhm kw'Arza kw'ode okker-itọhm s'odimpa kw'Tirza. <verse eid="1KI 16:9" /><verse number="10" style="v" sid="1KI 16:10" />Ny'icho ttong ẹrọbh okwuma ichenọmfa s'Asa ọbaabh Juda, nya wọ kw'Zimri odimẹ z'ọsọhm kw'Arza, ọfhọ Ẹla, ọtọka ẹvaar chẹ otima.<verse eid="1KI 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 16:11" />K'ose kw'Zimri ọtọm ẹbaabha nya, ọfhọ ẹnọmma ch'Baasha maphyir. Ojinọngnwa mawanẹ kw'oyobh-oyobh kode. Ọtọma z'anọng p'Baasha, ọfhọ bẹ maa, ozeng z'ayok-odikkobh pẹ. <verse eid="1KI 16:11" /><verse number="12" style="v" sid="1KI 16:12" />Minna kw'Zimri ozeng ọfhọ anọng p'Baasha mapyhir, k'ose kw'uwa Jehu kw'ode ọgbaak-ettem ch'Ibinọkpaabyi ikk'odik ọgbaaka kw'ọmaan Baasha. <verse eid="1KI 16:12" /><verse number="13" style="v" sid="1KI 16:13" />Ofon k'mpyibha s'Baasha, ọmaana Ẹla kw'ode nnwa kwẹ masi, ọmaana s'mabir awọhkọ anọng p'Israẹl masi, ttara z'aka-tama p'Israẹl akpobh, pira ettem ebhem Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl.<verse eid="1KI 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 16:14" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Ẹla ọbaabh, ọmaana idik s'osi, makkẹrẹ z'anwẹr p'avaar p'Israẹl.<verse eid="1KI 16:14" /></para>
  <para style="s1">Zimri otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 16:15" />Ny'icho ttong ẹrọbh okwuma ichenọmfa s'Asa ọbaabh Juda, nya kw'Zimri oning ny'Tirza, ọbaabha Israẹl k'iwu ichenọmfa. Ny'ogbe nwo, ode ch'asoja mabhingẹ anyọma Gibetọn kw'ode obhon wanẹ kw'ẹkọma ch'Philistiya. <verse eid="1KI 16:15" /><verse number="16" style="v" sid="1KI 16:16" />K'ogbe kw'anọng p'Israẹl p'aning z'ibhinga-byi mabhaang bẹ́, Zimri kk'ọvaarnọng ikwu ọcha, obir ọfhẹ-ẹ, ny'ewu ndo madan-danẹ, masi Omri kw'ode osonọng kw'Asoja ẹvaar bẹ́, ọbaabha Israẹl. <verse eid="1KI 16:16" /><verse number="17" style="v" sid="1KI 16:17" />Nya o, Omri ọmaana anọng p'Israẹl p'aning amaan-ẹ, matọr ifor z'Gibeton, mad-ayima egbong z'Tirza. <verse eid="1KI 16:17" /><verse number="18" style="v" sid="1KI 16:18" />K'ogbe kw'Zimri oze bẹ́, nkk'ebhondim chẹ abọka, obina odim z'ẹtaanga kw'ifa-byi s'odimpa kwẹ, oke ekpon okporọ ifor sẹ za, ope. <verse eid="1KI 16:18" /><verse number="19" style="v" sid="1KI 16:19" />Wa ode minna okurọ mpyibha, ọmaana itama s'ikk'ọsa z'Ọvaar Ibinọkpaabyi k'ititika, obir otor nden s'Jẹroboam k'mpyibhase s'iwa osi, obir otima anọng p'Israẹl masi.<verse eid="1KI 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 16:20" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Zimri ọbaabh, ọmaana ikwu s'ochi, makkẹrẹ z'anwẹr p'avaar p'Israẹl.<verse eid="1KI 16:20" /></para>
  <para style="s1">Omri otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 16:21" />Wa anọng p'Israẹl akwu abhaangẹ k'nkwurọ mfa. Ekwurọ danẹ ebe ẹmaana Tibni kw'ode nnwa kw'ọvaar Ginat bẹ́, otima ẹvaar. Ekwurọ ndoza ebe ẹmaana Omri. <verse eid="1KI 16:21" /><verse number="22" style="v" sid="1KI 16:22" />K'okponganamgbe, ekwurọ ch'ebe ẹmaana Omri, ẹgaangẹ ẹyọhnga ekwurọ ch'Tibni kw'ode nnwa kw'Ginat. Ofona nya, Tibni ope. Omri okwu otima ẹvaar.<verse eid="1KI 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 16:23" />Ny'icho ttong ẹrọbh okwuma ijobh kawanẹ s'Asa ọbaabh Juda, nya kw'Omri otim ẹvaar ch'Israẹl. Wa ọbaabh k'icho ijobh kkamfa. Otima icho ichadanẹ oninga z'Tirza. <verse eid="1KI 16:23" /><verse number="24" style="v" sid="1KI 16:24" />Omri odebh egbe ch'Samariya z'Shema k'ọbọhk, k'atalen afa p'silva. Osi ebhondim ny'egbe ndo, okpe chẹ bẹ́, Samariya, ọfha otima ojima Shẹma kw'uwa oyen egbe ndo.<verse eid="1KI 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 16:25" />Okenaka, wa Omri osi itama z'ititika s'Ọvaar Ibinọkpaabyi s'iyọhng s'anọng p'echeden asi. <verse eid="1KI 16:25" /><verse number="26" style="v" sid="1KI 16:26" />Omri otor ntọkọ s'Jẹroboam kw'ode nnwa kw'Nẹbat. Wa osi mpyibhase njo s'Jẹroboam otim anọng p'Israẹl osi, mabira akpobha aka-tama p'awọhkọ ettem ebhem Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl.<verse eid="1KI 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 16:27" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Omri ọbaabh, idik s'osi ọmaana ẹfa chẹ, makkẹrẹ z'anwẹr p'avaar p'Israẹl. <verse eid="1KI 16:27" /><verse number="28" style="v" sid="1KI 16:28" />Wa Omri ope, manọhng-ẹ z'Samariya. Ahab kw'ode ojinọngnwa kwẹ ọtọka ẹvaarninga ch'otte.<verse eid="1KI 16:28" /></para>
  <para style="s1">Ahab otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 16:29" />Ny'icho ttong ẹrọbh okwuma ichi kkanttaan s'Asa ọbaabh Juda, nya kw'Ahab kw'ode nnwa kw'Omri otim ẹvaar ch'Israẹl. Wa Ahab oning z'Samariya ọbaabha Israẹl k'icho ẹrọbh okwuma ifa. <verse eid="1KI 16:29" /><verse number="30" style="v" sid="1KI 16:30" />Wa Ahab kw'ode nnwa kw'Omri osi itama z'Ọvaar Ibinọkpaabyi k'ititika, s'iyọhng s'anọng p'achẹ-ẹ eden k'ẹbaabha. <verse eid="1KI 16:30" /><verse number="31" style="v" sid="1KI 16:31" />Wa kọkpọk bẹ́, kẹ oze mpyibhase s'Jẹroboam mach'ipyibh-opyibh, wa obir ochina ororo, ọtọka Jẹzẹbẹl kw'ode ominanwa kw'ọvaar Ẹthbaal kw'Sidọn k'ọbada, obir okpobha Baal ọttara. <verse eid="1KI 16:31" /><verse number="32" style="v" sid="1KI 16:32" />Wa Ahab ottim ija-byi z'ọsọhm kw'Baal kw'osi z'Samariya. <verse eid="1KI 16:32" /><verse number="33" style="v" sid="1KI 16:33" />Obir osi ọka f'Ashẹra, ọmaana idik s'iyọhng nya s'ibhemẹ Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl, ettem. Wa osisi kwẹ ọyọhng kw'anọng p'achẹ-ẹ eden k'ẹbaabha.<verse eid="1KI 16:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 16:34" />Ny'ogbe kw'Ahab ọbaabh, nya kw'Hiyẹl kw'ofon Bẹtẹl ọtọm obhon kw'Jẹriko odido. K'ogbe kw'ọphaakẹ izek, nya kw'uwa Hiram kw'ode ochedennwa kwẹ ope. K'ogbe kw'oke ebhumma ch'obhon nwo, nya kw'Segub kw'ode okpongannam kwẹ ope, otor k'ọgbaakadik kw'uwa Ọvaar Ibinọkpaabyi ikk'Joshua kw'ode nnwa kw'Nun otima ọgbaak.<verse eid="1KI 16:34" /></para>
  <chapter eid="1KI 16" />
  <chapter number="17" style="c" sid="1KI 17" />
  <para style="s1">Ẹlaija oze iyoma siden s'im'ikwu</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 17:1" />Wa Ẹlaija kw'ofon Tishbẹ, z'ẹbhaakẹ ch'Gilead, obenẹ Ahab bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Israẹl ọmaana Ibinọkpaabyi kw'kaam mbir mkpobha, orukọ akpen, ifọhng mìtebh, ẹrọng mèbir etebh k'ocho-va z'ititika, oye bẹ́, kk'mbena bẹ́, etebh.”<verse eid="1KI 17:1" /></para>
  <para style="s1">Ntọrikwukwu inang Ẹlaija ọchattọhk</para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 17:2" />Nya o, Ọvaar Ibinọkpaabyi oben Ẹlaija bẹ́, <verse eid="1KI 17:2" /><verse number="3" style="v" sid="1KI 17:3" />“Bina m'ibyi nja, ad-atubha z'ekeka ch'Kẹrit, ch'ening ẹnyọma ẹbhaakẹ ch'ewuchen ed-eyin, z'ọraanga kw'Jọrdan. <verse eid="1KI 17:3" /><verse number="4" style="v" sid="1KI 17:4" />Kọ m'agwo asi p'ekeka ndo. Kaam kk'ntọrikwukwu mbira ntọhma bẹ́, ichen-ọ ọchattọhk nya.”<verse eid="1KI 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 17:5" />Minna kw'Ẹlaija osi k'ose kw'Ọvaar Ibinọkpaabyi oben-ẹ. Obina od-obhing z'ekeka ch'Kẹrit, ch'ening ẹnyọma ẹbhaakẹ ch'ewuchen ed-eyin, z'ọraanga kw'Jọrdan. <verse eid="1KI 17:5" /><verse number="6" style="v" sid="1KI 17:6" />K'ekpebha ọmaana k'ẹsọhka, ntọrikwukwu ichen-ẹ brẹd ọmaana mgbaten. Obir ogwo asi ny'ekeka ch'Kẹrit.<verse eid="1KI 17:6" /></para>
  <para style="s1">Ẹlaija ottem ọmaana opokwa kw'Zarẹphat</para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 17:7" />Otum k'ogbe wanẹ, ekeka ndo ekwu ẹkka maphyir okurọ ch'ẹrọng ina ọdọk ny'izek njo, etebhẹ. <verse eid="1KI 17:7" /><verse number="8" style="v" sid="1KI 17:8" />Nya o, Ọvaar Ibinọkpaabyi oben Ẹlaija bẹ́, <verse eid="1KI 17:8" /><verse number="9" style="v" sid="1KI 17:9" />“Zọhng <char style="it">bẹ́ kpaar</char> china z'Zarẹphat, z'ẹbhaakẹ ch'Sidon, ad-aninga za. Kaam kk'opokwa wanẹ ntọhma nya bẹ́, ochen-ọ ọchattọhk.” <verse eid="1KI 17:9" /><verse number="10" style="v" sid="1KI 17:10" />Minna kw'obin ochina z'Zarẹphat. K'ose kw'opyirẹ ny'ebhumma ch'obhon, okebha opokwa wanẹ nya ch'od-otobha omenẹ. Oyer-ẹ, oben-ẹ bẹ́, “Ototo, kaabha asi biribirẹ k'ọkkọbh anang-m, mgwo.” <verse eid="1KI 17:10" /><verse number="11" style="v" sid="1KI 17:11" />K'ose kw'ofon bẹ́, ọd-ọkaabha asi mbo, obira oyer-ẹ, oben-ẹ bẹ́, “ Ototo, ttara brẹd biribirẹ nya, chen-m.”<verse eid="1KI 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 17:12" />Opokwa nwo ọpọhna bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwọ orukọ akpen, brẹd kpenamkpen kinyen. Ọttọhk f'nnyen ma, ode agwubuma p'ayik k'ẹjọ, ọmaana anava p'oliv p'aning k'egbomma. Nd-ntobha amenẹva mba bẹ́, ntima mbhana, ọfha nsi ọchattọhk f'kaam ọmaana nnwa kwaam mm'ochi, pira mope.”<verse eid="1KI 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 17:13" />Ẹlaija oben-ẹ bẹ́, “Oning-ọ ojor. Zọhng bhana, ad-asi k'ose kw'abenẹ nya. Pira afona, chi eden tima ekpo mbyo py'ayen, si brẹd biribirẹ nang-m, pira ad-asi ọchattọhk f'ikọ ọmaana nnwa kwọ mm'achi. <verse eid="1KI 17:13" /><verse number="14" style="v" sid="1KI 17:14" />Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl kk'obena bẹ́, ‘Agwubuma mbo p'ọkkọbh, mmàsa. Ana mbo p'egbomma, mmàbir asa maa, opyirẹ ewu ch'Ọvaar Ibinọkpaabyi im'otebh ẹrọng m'izek.’ ”<verse eid="1KI 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 17:15" />Opokwa nwo, ofona od-osi k'ose kw'Ẹlaija ikk'ẹ obena. Minna kw'ọchattọhk ozeng oninga k'ewu kpenamkpen f'Ẹlaija, ọmaana kwanọng nwo, ọttara ẹsọhmmọr chẹ, machi. <verse eid="1KI 17:15" /><verse number="16" style="v" sid="1KI 17:16" />Okwu ode k'ose kw'Ọvaar Ibinọkpaabyi ikk'Ẹlaija otima oben. Agwubuma mbo p'ọkkọbh, ọmaana ana mbo p'egbomma m'ọdọk kasa.<verse eid="1KI 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 17:17" />Otum k'ogbe, nnwa kw'kwanọng nwo kw'oyen ọsọhm, okwu ọmmẹ-ẹ. Ọkọhmaana mvo opyibh maa, ọdọk iwọhng kọgwọkọ. <verse eid="1KI 17:17" /><verse number="18" style="v" sid="1KI 17:18" />Kwanọng nwo oben Ẹlaija bẹ́, “O ọgbaak-ettem ch'Ibinọkpaabyi, njọ-ọ mbọng o? Ma, akwu bẹ́, akwu ajim-m epyibha chaam, abir afhọ-m nnwa o?”<verse eid="1KI 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 17:19" />Ẹlaija oben kwanọng nwo bẹ́, “Nang-m nnwa kwọ.” Minna kw'ọtọk-ẹ ny'ọkka k'mbọhk, otim-ẹ ovura z'idongọ s'ẹrọng, za ch'ikẹ Ẹlaija od-oninga. Orur-ẹ ny'ebin. <verse eid="1KI 17:19" /><verse number="20" style="v" sid="1KI 17:20" />Obhom ọkpẹkẹ Ọvaar Ibinọkpaabyi k'ẹrọng bẹ́, “O Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwaam. Ma, atọhmọ itamase nja anang opokwa nwoma kw'nning mmaana o, bẹ́, afhọ nnwa kwẹ o?” <verse eid="1KI 17:20" /><verse number="21" style="v" sid="1KI 17:21" />Minna kw'oyim ọbaaka nnwa nwo ny'ifor igbedim ittaan. Obhom oyerẹ Ọvaar Ibinọkpaabyi bẹ́, “O Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kwaam, ototo, tte akpen p'nnwa nwoma akpa nnam!”<verse eid="1KI 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 17:22" />Ọvaar Ibinọkpaabyi ọbhaanga ẹmọng ch'Ẹlaija, ogbe nnwa nwo, okwu oninga akpen. <verse eid="1KI 17:22" /><verse number="23" style="v" sid="1KI 17:23" />Ẹlaija o, otinẹ nnwa nwo ny'idongọ s'ẹrọng, otim-ẹ ọsaka z'izek. Ọtọk-ẹ ọnang ọkka, oben-ẹ bẹ́, “Kirẹ e, nnwa kwọ k'akpen oruka e!”<verse eid="1KI 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 17:24" />Kwanọng nwo oben Ẹlaija bẹ́, “Menda kk'nzonga bẹ́, ade ọgbaak-ettem ch'Ibinọkpaabyi. Mbira nzonga bẹ́, ọgbaakadik kpenamkpen kw'Ọvaar Ibinọkpaabyi kw'oyin-ọ ny'ẹmma, ode odik ọkkọkka.”<verse eid="1KI 17:24" /></para>
  <chapter eid="1KI 17" />
  <chapter number="18" style="c" sid="1KI 18" />
  <para style="s1">Ẹlaija ottem ọmaana Ọbadaya</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 18:1" />Wa k'ogbe kw'ikk'obhira, ny'icho ttong ittaan s'íyomà ikwu, Ọvaar Ibinọkpaabyi ọtọhm ọgbaakadik kwẹ ọnang Ẹlaija bẹ́, “Zọhng kọhka Ahab ifor sọ, kirẹ kaam m'ntebh ẹrọng ny'izek njo.” <verse eid="1KI 18:1" /><verse number="2" style="v" sid="1KI 18:2" />Ẹlaija ofona, ọd-ọkọhka Ahab ifor sẹ.</para>
  <para style="p" vid="1KI 18:2">Ny'ogbe nwo, owora kw'oning ny'Samariya ọgaang-ọgaangẹ. <verse eid="1KI 18:2" /><verse number="3" style="v" sid="1KI 18:3" />Ode ch'Ahab ikk'Ọbadaya kw'od-okkerẹ idik s'odimpa kwẹ, oyera. (Wa Ọbadaya ocher k'Ọvaar Ibinọkpaabyi mawuriji. <verse eid="1KI 18:3" /><verse number="4" style="v" sid="1KI 18:4" />K'ogbe kw'Jẹzẹbẹl ọd-ọfhọ agbaak-ettem ch'Ọvaar Ibinọkpaabyi, wa Ọbadaya ọtọk bẹ anọng arọbh achen od-odubh k'atakpamma afa. Anọng arọbh afa okwuma ijobh k'ọtakpamma. Obir od-ochena bẹ ọchattọhk ọmaana asi za.) <verse eid="1KI 18:4" /><verse number="5" style="v" sid="1KI 18:5" />Ahab oben Ọbadaya bẹ́, “Zenga baana nkeka maphyir, ọmaana ilokodo kpenamkpen s'ining m'ẹkọma nda maphyir. Baana, óde mm'oze azizaarẹ p'mm'ọnang nnyanya ọmaana abhaam machi atima aruk akpen, mfha nten samina ining mina inang ipe.” <verse eid="1KI 18:5" /><verse number="6" style="v" sid="1KI 18:6" />Minna kw'makebhẹ ẹkọma ndo k'ose kw'ọnọng-ọnọng m'ọbaana ẹbhaakẹ chẹ. Ahab ochina k'ẹbhaakẹ danẹ, Ọbadaya ochina k'ẹbhaakẹ ndoza.<verse eid="1KI 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 18:7" />K'ose kw'Ọbadaya od-ozenga ny'eden o, ottema ọmaana Ẹlaija. Ọbadaya otin-ẹ, ọraka eso k'ekpukpobhamaana ọnang-ẹ. Oben-ẹ bẹ́, “Ttatta kwaam Ẹlaija, kọ wọ k'odik ọkkọkka o?”<verse eid="1KI 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 18:8" />Ẹlaija ọpọhn-ẹ bẹ́, “Iye! Zọhng tek ttatta kwọ bẹ́, ‘Ẹlaija oning ma e.’ ”<verse eid="1KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 18:9" />Ọbadaya ọbọbh-ẹ bẹ́, “Njẹ mbọng o, kw'ad-aben bẹ́, atọka ọtọhmnọng kwọ anang Ahab bẹ́, ọfhọ o? <verse eid="1KI 18:9" /><verse number="10" style="v" sid="1KI 18:10" />K'ose kw'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kwọ orukọ akpen, ẹkọma ọmaana ọvaarbhon kode kw'ttatta kwaam ina anọng ọtọhmọ bẹ́, maror-ọ. Ó̱de mopyirẹ k'ẹkọma kpenamkpen, ọmaana ọvaarbhon kpenamkpen, óde anọng p'aning nya abenẹ bẹ́, m'kọ nya kaze, kẹ m'osi bẹ machekẹ bẹ́, m'kọ kaze. <verse eid="1KI 18:10" /><verse number="11" style="v" sid="1KI 18:11" />Ma o, kọ nad-atọhm-m bẹ́, nd-ntek ttatta kwaam bẹ́, ‘Ẹlaija oning ma.’ <verse eid="1KI 18:11" /><verse number="12" style="v" sid="1KI 18:12" />Kaam ibyi kizong s'egwugwuma ch'Ọvaar Ibinọkpaabyi m'etim-ọ echina, izaa mbin nrik-ọ ma. Ó̱de ḿfon nd-ntek Ahab bẹ́, aning ma, óde ína kọ m'ibyi nja okebh, m'ọfhọ-m ọfhọ. Kọ azong ma bẹ́, kaam ntọm k'edikkobh chaam mkpobha Ọvaar Ibinọkpaabyi. <verse eid="1KI 18:12" /><verse number="13" style="v" sid="1KI 18:13" />Ttatta kwaam, ma ọttọhk f'uwa nsi atim abhaanga o? Ch'iwa Jẹzẹbẹl ọd-ọfhọ agbaak-ettem ch'Ọvaar Ibinọkpaabyi, wa ntọk bẹ anọng arọbh achen nd-ndubh k'atakpamma afa. Anọng arọbh afa okwuma ijobh k'ọtakpamma. Nchena bẹ ọchattọhk ọmaana asi za. <verse eid="1KI 18:13" /><verse number="14" style="v" sid="1KI 18:14" />Ma, kọ nad-atọhm-m bẹ́, nd-ntek ttatta kwaam bẹ́, ‘Ẹlaija oning ma.’ Kẹ m'ọfhọ-m ọfhọ e!”<verse eid="1KI 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 18:15" />Ẹlaija obenẹ bẹ́, “K'ose kw'Ọvaar Ibinọkpaabyi kw'ẹfa mapyhir kw'mkpobh orukọ akpen, kaam m'nkọhka Ahab ifor saam ọkọhka menda.”<verse eid="1KI 18:15" /></para>
  <para style="s1">Ẹlaija oning z'egbe ch'Kaamẹl</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 18:16" />Minna kw'Ọbadaya ofon od-okebha Ahab, otek-ẹ odik nwo. Ahab ofona od-okebha Ẹlaija. <verse eid="1KI 18:16" /><verse number="17" style="v" sid="1KI 18:17" />K'ogbe kw'Ahab oze Ẹlaija nya, oben-ẹ bẹ́, “Kọ wọ ma kw'ad-ake Israẹl ẹkọhr?”<verse eid="1KI 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 18:18" />Ẹlaija ọpọhn-ẹ bẹ́, “Kaam Israẹl ẹkọhr kìnke. Kọ ọmaana ẹsọhmmọr ch'atte, bọnga mater ake Israẹl ẹkọhr e! Bọnga nkk'asana p'Ọvaar Ibinọkpaabyi abhuma, mater akpobha aka p'Baal. <verse eid="1KI 18:18" /><verse number="19" style="v" sid="1KI 18:19" />Ofona nya, yerẹ anọng p'Israẹl mapyhir makebh-m z'egbe ch'Kaamẹl. Abir atima abọhnganọng p'Baal anọng ẹnọhna okwuma arọbh afa okwuma ijobh akwu, ọmaana abọhnganọng p'Ashẹra anọng ẹnọhna p'mad-achi ọttọhk amaana Jẹzẹbẹl.”<verse eid="1KI 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 18:20" />Minna kw'Ahab ọtọhmọ ẹkkaabha ọkọma Israẹl maphyir, otobha abọhnganọng mbo z'egbe ch'Kaamẹl. <verse eid="1KI 18:20" /><verse number="21" style="v" sid="1KI 18:21" />Ẹlaija ofona od-obe ny'anọng mbo k'ititika, oben bẹ bẹ́, “Bọnga mm'asi ttena-ttena k'achibhẹ afa atuma yen o? Ó̱de Ọvaar Ibinọkpaabyi wọ ode Ibinọkpaabyi, mator-ẹ. Okenaka, óde Baal wọ ode Ibinọkpaabyi, mator-ẹ.” Anọng mbo odik kpenamkpen kagbaakẹ.<verse eid="1KI 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 18:22" />Nya o, Ẹlaija oben bẹ bẹ́, “Kaam-kaam wọ nde ọgbaak-ettem ch'Ibinọkpaabyi kw'norikẹ. Okenaka, abọhnganọng p'Baal ade anọng ẹnọhna okwuma arọbh afa okwuma ijobh. <verse eid="1KI 18:22" /><verse number="23" style="v" sid="1KI 18:23" />Mànang mina abhaamdim afa. Tte abọhnganọng p'Baal ateka danẹ. Tte màkpaara dẹ k'akwuma-k'akwuma mànana k'omenẹ, màning ekpon ake. Kaam m'mbira mkpaara ndoza chaam, nnana k'omenẹ, ekpon nya mìmbir nke.<verse eid="1KI 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 18:24" />Bọnga mm'ayerẹ eche ch'ọka fabọnga, kaam nyerẹ eche ch'Ọvaar Ibinọkpaabyi. Kẹ nwo kw'otim ekpon ọpọhna, kẹ wọ ode Ibinọkpaabyi.”</para>
  <para style="p" vid="1KI 18:24">Nya o, anọng maphyir maben bẹ́, “Odik kw'agbaakẹ nya ojibh-ojibh.” <verse eid="1KI 18:24" /><verse number="25" style="v" sid="1KI 18:25" />Ẹlaija oben abọhnganọng mbo p'Baal bẹ́, “Bọnga màchi eden teka ọbhaamdim mawanẹ, màkpaara wẹ k'ose kw'mbenẹ, manana k'omenẹ. M'ekpon kake o.” <verse eid="1KI 18:25" /><verse number="26" style="v" sid="1KI 18:26" />Minna kw'matọk ọbhaamdim nwo kw'manang bẹ, makpaara maphyir anana ny'omenẹ.</para>
  <para style="p" vid="1KI 18:26">Matọma k'ekpebha, mayerẹ eche ch'Baal maa, opyirẹ k'ẹya. Makwọhrọ k'ẹrọng bẹ́, “Baal, nang mina ẹpọhna!” Okenaka, m'ẹpọhna kpenamkpen kayen. Mabira atubh ebin akọbha ija-byi njo s'nkk'asa.<verse eid="1KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 18:27" />Otum ny'ẹya, Ẹlaija ọtọma bẹ ọkkọnnyika osisi, oben bẹ bẹ́, “Màkwọhr-ẹ mawuriji. K'odik ọkkọkka, kẹ kw'bọnga makpobh! Ṉ́nòsi otim ochibhẹ idik, wanẹma, idik isaabh-ẹ ọsaabh, ina akkerẹ, ọta ozenga. Okpokpo ode bẹ́, ọttaabh ọda. Ọbaan bẹ́, màyem-ẹ!” <verse eid="1KI 18:27" /><verse number="28" style="v" sid="1KI 18:28" />Minna kw'mado akwọhr-ọkwọhrọ. Mabir asi k'ose kw'ẹmmaana chabẹ ede, matima akkangkkang ọmaana akọhn mamuma ifor sabẹ ekpo maa, mabhobh azẹ. <verse eid="1KI 18:28" /><verse number="29" style="v" sid="1KI 18:29" />Ọyakpattem okwu ọkpan, bẹ machina ororo akwọhrọ maa, opyirẹ k'ogbe kw'nd-afọhnọ ẹja ch'ẹsọhka. Chibhẹ nya, m'ẹpọhna kpenamkpen kayen, ọnọng bẹ ẹmọng kosi, ọnọng bẹ otum kobir oke.<verse eid="1KI 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 18:30" />Nya o, Ẹlaija oben anọng mbo maphyir bẹ́, “Màzenga nyọm-m ka.” Mazenga anyọm-ẹ za. Ẹlaija odo ija-byi s'Ọvaar Ibinọkpaabyi s'nkk'avọhka. <verse eid="1KI 18:30" /><verse number="31" style="v" sid="1KI 18:31" />Ọtọka ata ijobh kkamfa otor k'mfonamma ijobh kkamfa s'Jekọb kw'uwa Ọvaar Ibinọkpaabyi obenẹ bẹ́, “Kọ m'akpena Israẹl.” <verse eid="1KI 18:31" /><verse number="32" style="v" sid="1KI 18:32" />Otima ata mbo osi ija-byi k'eche ch'Ọvaar Ibinọkpaabyi. Otum epe ch'ewen-owen ch'im'ẹtọka asikpọ anna, ọkọbh-ọkọbha. <verse eid="1KI 18:32" /><verse number="33" style="v" sid="1KI 18:33" />Otobha omenẹ mvo, pira ọjọhkọ ọbhaamdim nwo k'akwuma- k'akwuma, ọtọka ọnana ny'omenẹ mvo. Oben bẹ bẹ́, “Màke asi maa, mafu nsẹbin siden nna, màkwu awona m'ẹja nda, ọmaana m'omenẹ mva.”<verse eid="1KI 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 18:34" />Oben bẹ bẹ́, “Màbira kwu wona asi.” Bẹ masi minna.</para>
  <para style="p" vid="1KI 18:34">Obira oben bẹ bẹ́, “Màkwu wona asi ttong igbedim ittaan.” Minna kw'mabira akwu awona asi ttong igbedim ittaan. <verse eid="1KI 18:34" /><verse number="35" style="v" sid="1KI 18:35" />Asi mbo mabhobh akọbha ija-ibyi njo mapyhir, mabira afu epe ndo.<verse eid="1KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 18:36" />Nokwu opyirẹ k'ogbe kw'ẹja ofufọhnọ o, Ẹlaija kw'ode ọgbaak-ettem ch'Ọvaar Ibinọkpaabyi oyin obe ny'abẹ k'ititika, oze njọm, oben bẹ́, “O Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi kw'Abraham, ọmaana kw'Isaak, ọttara kw'Israẹl, si anọng mboma azonga menda bẹ́, kọ wọ ade Ibinọkpaabyi kw'Israẹl. Si bẹ mazonga bẹ́, kaam nde ọtọhmnọng kwọ, mabira azonga bẹ́, okpenamkpen f'nsi ma, nsi k'ẹfa ch'ọgbaakadik kwọ. <verse eid="1KI 18:36" /><verse number="37" style="v" sid="1KI 18:37" />O Ọvaar Ibinọkpaabyi, bhaanga njọm saam. Ototo, bhaanga njọm saam, mfha anọng mboma azonga bẹ, kọ wọ ade Ọvaar Ibinọkpaabyi, kw'ode Ibinọkpaabyi. Abira asi bẹ mazonga bẹ́, ad-atima nttem sabẹ akpa nnam z'kọ k'ifor.”<verse eid="1KI 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 18:38" />Minna kw'ekpon ch'Ọvaar Ibinọkpaabyi ẹsak, ẹkwọmọ ẹnanga ndo, ọmaana omenẹ mvo, ọmaana ata mbo. Ebir ẹwọma ny'izek maa, egwo asi p'epe ndo maphyir.<verse eid="1KI 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 18:39" />K'ogbe kw'anọng mbo maphyir maze odik nwo nya, minna kw'matto ayima z'izek, mabhom bẹ́, “Ọvaar Ibinọkpaabyi wọ ode Ibinọkpaabyi! Ọvaar Ibinọkpaabyi wọ ode Ibinọkpaabyi!”<verse eid="1KI 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 18:40" />Nya o, Ẹlaija oke ẹfa, bẹ́, “Màbọka abọhnganọng p'Baal. M'ọnọng mawan-wanẹ ọbọhk katte ọnaanga bọnga o!” Minna kw'mabọk bẹ, Ẹlaija otima bẹ ochina z'ilokodo s'Kishọn, ọd-ọfhọ bẹ za.<verse eid="1KI 18:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 18:41" />Ẹlaija oben Ahab bẹ́, “Bhana. Zọhng chi, abir agwo, okurọ bẹ́, kaam kk'etum ch'ẹrọng chiden mmaanga ch'im'etebh.” <verse eid="1KI 18:41" /><verse number="42" style="v" sid="1KI 18:42" />Minna kw'Ahab obin ofona bẹ́, od-ochi, obira ogwo. Ẹlaija ovura z'ogbeso kw'Kaamẹl, ọraka, oyika eso ny'ntaak sẹ.<verse eid="1KI 18:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 18:43" />Oben ọtọhmnọng kwẹ bẹ́, “Zọhng kkerẹ z'ẹbhaakẹ ch'ọraanga kwiden.” Ofona od-okkerẹ.</para>
  <para style="p" vid="1KI 18:43">Otek-ẹ bẹ́, “Ọttọhk za kinze.”</para>
  <para style="p" vid="1KI 18:43">Ẹlaija ọtọhm-ẹ maa, opyirẹ igbedim ichenọmfa, oben-ẹ bẹ́, “Kpa nnam zọhng kkerẹ.”<verse eid="1KI 18:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 18:44" />Ttong igbedim ichenọmfa, ọtọhmnọng nwo otek-ẹ bẹ́, “Nze ebonọ ch'ẹchamẹ mach'ọbọhk kw'oyokinọng, ch'ebin z'ọraanga kwiden ed-evur-ovura.”</para>
  <para style="p" vid="1KI 18:44">Ẹlaija oben-ẹ bẹ́, “Zọhng tek Ahab bẹ́, ovura z'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr ofona, ọfha ẹrọng ening-ẹ ẹkpa.”<verse eid="1KI 18:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 18:45" />Ny'ogbe nwo ẹrọng kk'ẹpya, ebum ẹtọma osisi, ẹrọng chiden ẹtọma otitebh. Ahab ọyaar ochina z'Jẹzrẹl. <verse eid="1KI 18:45" /><verse number="46" style="v" sid="1KI 18:46" />Ẹfa ch'Ọvaar Ibinọkpaabyi ẹsaka, ẹnwa Ẹlaija z'ifor. Minna kw'ọdabh odikpa ny'owurọ-baba kwẹ ny'ifor, otima ẹbhar od-ochi Ahab eden maa, opyirẹ z'Jẹzrẹl.<verse eid="1KI 18:46" /></para>
  <chapter eid="1KI 18" />
  <chapter number="19" style="c" sid="1KI 19" />
  <para style="s1">Ẹlaija ọrọbhọ ochina z'Horẹb</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 19:1" />K'ogbe kw'Ahab opyirẹ z'ọsọhm, otek Jẹzẹbẹl ọttọhk kpenamkpen f'Ẹlaija kk'ọsa, ọmaana ose kw'otim ọkkangkkang ọfhọ abọhnganọng p'Baal maphyir. <verse eid="1KI 19:1" /><verse number="2" style="v" sid="1KI 19:2" />Minna kw'Jẹzẹbẹl ọtọhm ozeng-eden wanẹ ẹkkaabha z'Ẹlaija bẹ́, “Ophyinẹ ogbe ose nwa, óde ína akpen pọ ndimẹ k'ose kw'adimẹ akpen p'abọhnganọng p'Baal, tte aka asi-m k'ose kpenamkpen kw'ọdaakẹ bẹ.”<verse eid="1KI 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 19:3" />Ẹlaija okwu ojor-ẹ, ọrọbh, mfha ọkkaana akpen pẹ. Ch'opyirẹ z'Beershẹba, z'ẹkọma ch'Juda, obina orik ọtọhmnọng kwẹ nya. <verse eid="1KI 19:3" /><verse number="4" style="v" sid="1KI 19:4" />Kẹ osi ozenga kw'ewu kibungọ ochina z'ibyi s'anọng nna arukọ. Okwu opyirẹ k'ofokodo kw'echi danẹ, ọphyak ẹwor oninga nya, oze njọm bẹ́, wura ope, oben bẹ́, “Ọvaar Ibinọkpaabyi, akpen kk'aam abenga e! Tọka akpen paam, kire kaam kìnjibhẹ nyọhnga ab'ttatta paam.” <verse eid="1KI 19:4" /><verse number="5" style="v" sid="1KI 19:5" />Minna kw'oyim ny'echirin ndo, ọttaabha.</para>
  <para style="p" vid="1KI 19:5">Ogbe kobhirẹ, ozeng-eden kw'Ọvaar Ibinọkpaabyi ọtwẹ-ẹ, oben-ẹ bẹ́, “Bin-obina, chi ọttọhk.” <verse eid="1KI 19:5" /><verse number="6" style="v" sid="1KI 19:6" />Okkerẹ ọkọbha, oze brẹd ny'eso kw'nkk'abhaabha k'ekpon, ọmaana ógberénwa kw'asi. Ochi ọttọhk, obir ogwo asi, pira nobir oyima.<verse eid="1KI 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 19:7" />Ozeng-eden kw'Ọvaar Ibinọkpaabyi okpa nnam ttong igbedim ifa, ọtwẹ-ẹ, oben-ẹ bẹ́, “Bina, chi ọttọhk, kirẹ ozenga kw'm'asi, okem ẹbara e.” <verse eid="1KI 19:7" /><verse number="8" style="v" sid="1KI 19:8" />Minna kw'obin ochi ọttọhk, obir ọgwa asi. Ọchattọhk mvo ọnang-ẹ ẹfa ch'otim osi ozenga kw'iyawu arọbh afa ọmaana irungiwu arọbh afa. Ozenga maa, opyirẹ z'Horẹb, kw'ode egbe ch'Ibinọkpaabyi. <verse eid="1KI 19:8" /><verse number="9" style="v" sid="1KI 19:9" />Nya wọ kw'nodimẹ k'ọtakpamma wanẹ, obhing nya.</para>
  <para style="s1" vid="1KI 19:9">Ọvaar Ibinọkpaabyi oyinẹ okebha Ẹlaija</para>
  <para style="p" vid="1KI 19:9">Minna Ọvaar Ibinọkpaabyi ọtọhm ẹkkaabha ọnang-ẹ bẹ́, “Ẹlaija, ad-asi mbọng ma?”<verse eid="1KI 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 19:10" />Ẹlaija ọpọhn-ẹ bẹ́, “Kaam ncher obo k'Ọvaar Ibinọkpaabyi kw'Ẹfa mapyhir. Anọng p'Israẹl kk'echekẹ chọ abhuma, machikẹ ọja-byi fọ maphyir, mabir atima akkangkkang afhọ agbaak-ettem chọ. Kaam kaam wọ ina nrikẹ, kẹ kw'nnad-akam bẹ́, macher-m afhọ ma.”<verse eid="1KI 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 19:11" />Ọvaar Ibinọkpaabyi oben bẹ́, “Yin k'iyaan zọhng be z'egbe k'ititika s'Ọvaar Ibinọkpaabyi, kirẹ Ọvaar Ibinọkpaabyi min'ọkpan nya.”</para>
  <para style="p" vid="1KI 19:11">Nya o, ebum ch'ẹgaang-ọgaangẹ etima ẹfa, ẹbhaaka agbe k'akpa, ebir ẹvọhkọ ntakpa <char style="it">ma tuku-tuku</char> ny'ititika s'Ọvaar Ibinọkpaabyi. Wa Ọvaar Ibinọkpaabyi ny'ebum ndo kode. Ebum ndo ẹkpọk nya o, izek itọma onyinyengẹ, okenaka, wa Ọvaar Ibinọkpaabyi ny'izek njo s'nyeng-onyenga kode. <verse eid="1KI 19:11" /><verse number="12" style="v" sid="1KI 19:12" />K'ose kw'izek ikpọk enyengẹ, ekpon ẹwọma. Okenaka, wa Ọvaar Ibinọkpaabyi ny'ekpon ndo kode. K'ose kw'ekpon ndo edimẹ, okwu ọbhaanga ayaabhẹ. <verse eid="1KI 19:12" /><verse number="13" style="v" sid="1KI 19:13" />K'ogbe kw'Ẹlaija ọbhaang ayaabhẹ mbo nya o, okpena owurọ-baba kw'obubh ny'ititika, oyin z'iyaan od-obe ny'ititika s'ọtakpamma.</para>
  <para style="p" vid="1KI 19:13">Nya kw'ọbhaang ẹmọng ch'ẹbọbh-ẹ bẹ́, “Ẹlaija, ad-asi mbọng ma?”<verse eid="1KI 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 19:14" />Ẹlaija ọpọhna bẹ́, “Kaam ncher obo k'Ọvaar Ibinọkpaabyi kw'ẹfa mapyhir. Anọng p'Israẹl kk'echekẹ chọ abhuma, machikẹ ọja-byi fọ maphyir, mabir atima akkangkkang afhọ agbaak-ettem chọ. Kaam kaam wọ ina nrikẹ, kẹ kw'nnad-akam bẹ́, macher-m afhọ ma.”<verse eid="1KI 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 19:15" />Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, “Zọhng kpa nnam z'eden ch'iwura azeng akwu, achina z'ibyi s'anọng nna arukọ, z'ẹbhaakẹ ch'Damaskọs. Ápyirẹ za, yaana Hazayẹl mach'Ọvaarnọng kw'Aram. <verse eid="1KI 19:15" /><verse number="16" style="v" sid="1KI 19:16" />Abir ayaana Jehu kw'ode nnwa kw'Nimshi mach'Ọvaarnọng kw'Israẹl. Akwu ayaana Ẹlisha kw'ode nnwa kw'Shafat kw'ofon Abẹl-Mẹhola bẹ́, otera eso chọ mach'ọgbaak-ettem ch'Ibinọkpaabyi. <verse eid="1KI 19:16" /><verse number="17" style="v" sid="1KI 19:17" />Jehu m'ọfhọ ọnọng kpenamkpen kw'ọnaang ọkkangkkang kw'Hazayẹl. Ẹlisha m'ọfhọ ọnọng kpenamkpen kw'ọnaang ọkkangkkang kw'Jehu. <verse eid="1KI 19:17" /><verse number="18" style="v" sid="1KI 19:18" />Chibhẹ ch'ode minna, kaam kk'anọng nnọhna ichi kkamfa okwuma arọbh afa okwuma ijobh nkọma nsok ny'Israẹl, p'nna ndudungọ attim anang Baal, ọttara ayok p'nna kẹ abir abaaka.”<verse eid="1KI 19:18" /></para>
  <para style="s1">Eyerẹ ch'Ẹlisha</para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 19:19" />Minna kw'Ẹlaija ofon od-oze Ẹlisha kw'ode nnwa kw'Shafat ch'ode otima abhaam ijobh kkamfa, otima ọbhakẹ izek. Wa kẹ oyenẹ, ọd-ọyaar ẹbhaam ndo ch'ettong ijobh kkamfa. Ẹlaija obina okebh-ẹ za, ọwọra owurọ-baba kwẹ, obubh-ẹ. <verse eid="1KI 19:19" /><verse number="20" style="v" sid="1KI 19:20" />Nya o, Ẹlisha obina orik abhaam pẹ, otima ẹbhar otor Ẹlaija. Oben bẹ́, “Tte nd-mbaaka atte kwaam ọmaana akka kwaam, mben bẹ bẹ́, ‘Màyima,’ pira nkwu ntorọ.”</para>
  <para style="p" vid="1KI 19:20">Ẹlaija ọpọhn-ẹ bẹ́, “Zọhng kpa nnam. Kaam kọ eden kimkpa.”<verse eid="1KI 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 19:21" />Minna kw'Ẹlisha ọkpa nnam, ọd-ọtọka abhaam pẹ ọfhọ. Ọtọka ẹtọhmkpo py'od-otima ọbhakẹ izek, oke ekpon ch'otim ọwọhn nten njo, ọtọka ọnang anọng pẹ, machi. Nya o, Ẹlisha ofona, otor Ẹlaija, okwu ode ọtọhmnọng kwẹ.<verse eid="1KI 19:21" /></para>
  <chapter eid="1KI 19" />
  <chapter number="20" style="c" sid="1KI 20" />
  <para style="s1">Bẹn-Hadad orim Samariya ábẹ̀</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 20:1" />Ny'ogbe nwo, Bẹn-Hadad kw'ode ọvaarnọng kw'Aram<note caller="+" style="f"><char style="fr" closed="false">20.1 </char><char style="fq" closed="false">Aram </char><char style="ft" closed="false">obir okpena Syria</char></note> oyerẹ asoja pẹ maphyir mattonga. Avaar minna ẹrọbh okwuma ijobh kkamfa, mator-ẹ, ọmaana nnyanya, ọttara ijaar s'nnyanya id-itọr. Otima ayok ofona, mad-ayima egbong z'Samariya, marim-ẹ ábẹ̀. <verse eid="1KI 20:1" /><verse number="2" style="v" sid="1KI 20:2" />Minna kw'ọtọhmọ azeng-eden pẹ z'Ahab kw'ode ọvaarnọng kw'Israẹl bẹ́, matek-ẹ bẹ́, “Bẹn-Hadad obenẹ bẹ́, <verse eid="1KI 20:2" /><verse number="3" style="v" sid="1KI 20:3" />‘Silva ọmaana gol pọ, made paam, panọng pọ p'ajibhẹ ọtam, ọmaana iva pọ, made paam.’ ”<verse eid="1KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 20:4" />Ọvaarnọng kw'Israẹl ọpọhn-ẹ bẹ́, “Ode k'ose kw'ttatta ọvaarnọng kwaam obenẹ nya. Kaam ọttara ọttọhk kpenamkpen f'ode faam, ode fọ.”<verse eid="1KI 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 20:5" />Azeng-eden mbo mabir akwu atek Ahab bẹ́, “Bẹn-Hadad obenẹ bẹ́, ‘Ntọhmọ ẹkkaabha nnang-ọ bẹ́, atte silva pọ, ọmaana gol pọ, ọmaana panọng pọ, ọttara iva pọ ọbọhk, anang-m. <verse eid="1KI 20:5" /><verse number="6" style="v" sid="1KI 20:6" />Ophyinẹ ogbese nwa, m'ntọhm adukwa paam makwu akebh-ọ. Mm'agbọngọ ọsọhm kwọ maphyir, ọmaana isọhm s'atọhmọ pọ. Mm'anọ-ọ ọttọhk kpenamkpen f'asokọ ettem, matima afona.’ ”<verse eid="1KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 20:7" />Minna kw'ọvaar Ahab kw'Israẹl oyerẹ ọkwa kw'asogbọhkọnọng maphyir p'izek njo, oben bẹ bẹ́, “Nkk'aza ose kw'ọnọng nwa od-oror ẹkọhr ka! Ọtọhmọ anọng bẹ́, nnang-ẹ panọng paam, ọmaana iva paam, ọmaana silva paam, ọmaana gol paam, nchera mmaan-ẹ.’ ”<verse eid="1KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 20:8" />Minna kw'asogbọhkọnọng mbo ọmaana anọng mboza maphyir mapọhn bẹ́, “Kẹ itọhng kàyonga, odik kwẹ kabir achera.”<verse eid="1KI 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 20:9" />Okwu oben azeng-eden mbo p'Bẹn-Hadad bẹ́, “Màd-itek ttatta ọvaarnọng kwaam bẹ́, ‘Idik njo maphyir s'achi eden aben kaam ọtọhmnọng kwọ bẹ́, nsi, m'nsosi. Ṉ́nòde mvoma f'aphyem-m ma, ọttọhkse mvo, mìmkpo nsi.’ ” Azeng-eden mbo makpa nnam achena Bẹn-Hadad ẹpọhna ndo.<verse eid="1KI 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 20:10" />Bẹn-Hadad o, ọtọhm ẹkkaabha ọdọk-ọdọk ochena Ahab, oben-ẹ bẹ́, “Tte aka asi-m k'ose kpenamkpen kw'ọdaakẹ bẹ, óde ína ọttọhk kpenamkpen ny'Samariya nkibhẹ maa, owor eyiyeng ch'im'efu ẹbọhkpattem ch'asoja paam.”<verse eid="1KI 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 20:11" />Ọvaarnọng kw'Israẹl ọpọhna bẹ́, “Màtek-ẹ bẹ́, ‘Ọnọng kw'ọfọr egbongkpo, ẹmma kod-osi mach'ọnọng kw'ọwọr egbongkpo e.’ ”<verse eid="1KI 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 20:12" />Ẹkkaabha ndo epyirẹ Bẹn-Hadad ọmaana avaarnọng mbo k'ogbe kw'mad-agwo atuk z'okkira fabẹ. Ọbhaang nya o, oben anọng pẹ bẹ́, “Màdo ifor s'erima.” Minna kw'mado ifor s'mm'ayin erima ny'ebhondim ndo.<verse eid="1KI 20:12" /></para>
  <para style="s1">Ahab okem Bẹn-Hadad</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 20:13" />Ny'ogbe nwo, ọgbaak-ettem ch'Ibinọkpaabyi wanẹ okwu okebha Ahab kw'ode ọvaarnọng kw'Israẹl nya, oben-ẹ bẹ́, “Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Kk'esojakaan nda aza? Kaam m'ntọka dẹ, nkọ-ọ ny'mbọhk menda. Nya kw'm'azonga bẹ́, kaam wọ nde Ọvaar Ibinọkpaabyi.’ ”<verse eid="1KI 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 20:14" />Ahab ọbọbh-ẹ bẹ́, “Bọng-ọnọng wọ im'osi erima nda?”</para>
  <para style="p" vid="1KI 20:14">Ọgbaak-ettem ch'Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Odik kw'Ọvaar Ibinọkpaabyi obenẹ ode bẹ́, ‘Asoja mbo p'ikarẹ p'maning izek-izek kw'agbongsonọng, bẹ bọ mm'asi.’ ”</para>
  <para style="p" vid="1KI 20:14">Ahab ọbọbh-ẹ bẹ́, “Anyi wọ im'ochi eden ọtọma erima oyenẹ?”</para>
  <para style="p" vid="1KI 20:14">Ọgbaak-ettem ch'Ibinọkpaabyi ọpọhn-ẹ bẹ́, “Kọ wọ im'atọma.”<verse eid="1KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 20:15" />Nya o, Ahab otobha asoja mbo p'ikarẹ p'aning izek-izek kw'agbongsonọng maphyir p'ẹbhaakẹ ndo. Wa made asoja anọng arọbh ijobh kawanẹ okwuma ijobh kkamfa. Ocher nya, obir otobha anọng mboza p'Israẹl maphyir p'ade anọng nnọhna ichi kkamfa okwuma arọbh ijobh. <verse eid="1KI 20:15" /><verse number="16" style="v" sid="1KI 20:16" />Minna kw'mabin ny'ẹya ndo, k'ogbe kw'Bẹn-Hadad ọmaana avaar ẹrọbh okwuma ijobh kkamfa p'mator-ẹ, maning za abum atuk z'okkira fabẹ. <verse eid="1KI 20:16" /><verse number="17" style="v" sid="1KI 20:17" />Asoja mbo p'ikarẹ p'aning izek-izek kw'agbongsonọng, machi eden ayin k'iyaan.</para>
  <para style="p" vid="1KI 20:17">Ny'ogbe nwo, Bẹn-Hadad kk'anọng banẹ ọtọhma bẹ́, mad-aninga abaana ibyi. Anọng akwu atek-ẹ bẹ́, “Anọng p'afon Samariya azeng k'ọsaabh akwuma ka e!”<verse eid="1KI 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 20:18" />Bẹn-Hadad oben bẹ́, “Ó̱de makwu ẹmẹm, màbọka bẹ k'mbọhk. Ó̱de makwu egbong, màbọka bẹ k'mbọhk.”<verse eid="1KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 20:19" />Asoja mbo p'ikarẹ p'aning izek-izek kw'agbongsonọng, mayin z'iyaan kw'ebhondim ndo, asoja mboza mayakẹ bẹ nnam. <verse eid="1KI 20:19" /><verse number="20" style="v" sid="1KI 20:20" />Minna kw'ọnọng-ọnọng ọfhọ ọwawunanọng kwẹ. Anọng p'Aram marọbh, anọng p'Israẹl makwubh bẹ. Okenaka, Bẹn-Hadad kw'ode ọvaarnọng kw'Aram ọnana k'ẹnyanya, kẹ ọmaana ayaar-nnyanya banẹ, marọbh anaanga. <verse eid="1KI 20:20" /><verse number="21" style="v" sid="1KI 20:21" />Ọvaarnọng kw'Israẹl okwubh nnyanya njo, ọmaana ijaar s'nnyanya id-itọr, ọna bẹ mkpang, obir ọfhọ anọng p'Aram k'ọsaabh.<verse eid="1KI 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 20:22" />Ogbe nwo ọkpanẹ nya o, ọgbaak-ettem ch'Ibinọkpaabyi okwu okebha ọvaarnọng kw'Israẹl oben-ẹ bẹ́, “Ifor ining-ọ imọmọ o. Chibhẹ ọttọhk f'm'asi, kirẹ ẹyọhm ẹbhakẹ ma, ọvaarnọng kw'Aram obir okwuma bẹ́, orim-ọ ábẹ̀.”<verse eid="1KI 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 20:23" />Minna kw'adukwa p'ọvaarnọng kw'Aram maben-ẹ bẹ́, “Aka pabẹ ade aka p'agbe. Kẹ wọ osi pira magaangẹ ayọhnga mina. Okenaka, óde mórim bẹ ábẹ̀ z'ẹkpẹmẹ, mm'ọgaangẹ ọyọhnga bẹ. <verse eid="1KI 20:23" /><verse number="24" style="v" sid="1KI 20:24" />Ọttọhk f'masi ode bẹ́, m'asaka avaar mbo maphyir k'nninga sabẹ, atima agbongsonọng p'asoja atera nso sabẹ. <verse eid="1KI 20:24" /><verse number="25" style="v" sid="1KI 20:25" />Ọbaan bẹ́, atobha asoja p'asaabhẹ mach'mbo p'apope, k'ose kw'ẹnyanya m'ekkerẹ ẹnyanya, mfha mokpo orima Israẹl ábẹ̀ z'mkpẹmẹ. Ny'ogbese nwo, nya kw'maze ose kw'mọgaangẹ ọyọhnga bẹ.” Bẹn-Hadad okwu oyonga bẹ itọhng, osi k'ose kw'mabenẹ.<verse eid="1KI 20:25" /></para>
  <para style="s">Ahab okem Bẹn-Hadad ttong igbedim ifa</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 20:26" />Ẹyọhm ẹbhakẹ nya o, Bẹn-Hadad otobha asoja p'Aram maphyir, machina z'Aphek bẹ́, mad-arima Israẹl ábẹ̀. <verse eid="1KI 20:26" /><verse number="27" style="v" sid="1KI 20:27" />Anọng p'Israẹl abir atobha ifor sabẹ, manang bẹ ekpo py'marorọ, mabina ayin erima amaana bẹ. Anọng p'Israẹl ayima egbong k'ọbọhk nwoka mach'akaana biribirẹ afa p'avu, makkerẹ ayok ititika. Anọng p'Aram z'okwubha, mattonga z'ẹkọma ndoza <char style="it">bẹ́ byimm</char>.<verse eid="1KI 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 20:28" />Minna kw'ọgbaak-ettem ch'Ibinọkpaabyi wanẹ ozeng ọnyọma ọvaarnọng kw'Israẹl, oben-ẹ bẹ́, “Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Ch'anọng p'Aram achibhẹ bẹ́, Ọvaar Ibinọkpaabyi ode ọka f'agbe vẹ-vẹ, ọka f'ilokodo kode, kaam m'ntọka esojakaan nda maphyir, nkkọ-ọ k'mbọhk, mfha atima azonga bẹ́, kaam wọ nde Ọvaar Ibinọkpaabyi.’ ”<verse eid="1KI 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 20:29" />Mabhing egbong z'ibhingabyi akkerẹ ayok ititika k'iwu ichenọmfa. Ny'ewu ndo ch'ettong ichenọmfa, egbong ẹtọma. Anọng p'Israẹl afhọ asoja p'Aram anọng nnọhna arọbh ijobh kkamfa okwuma ijobh k'ewu madanẹ. <verse eid="1KI 20:29" /><verse number="30" style="v" sid="1KI 20:30" />Ayok mboza arọbh achina z'ebhondim ch'Aphẹk. Etumọ etto ẹkpẹkẹ bẹ anọng ẹrọbh okwuma ochenọnttaan. Bẹn-Hadad ọdọk, ọrọbh od-otubha z'ẹtaanga kw'idongọ janẹ ny'ebhondim ndo.<verse eid="1KI 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 20:31" />Asonọng pẹ aben-ẹ bẹ́, “Nkk'ọbhaanga bẹ́, avaar p'Israẹl azong inọngkwo. Tte mọkpa abara-bina k'erin, mobir ọdabh ndik k'eso, motima okebha avaar p'Israẹl za. Ina akkerẹ, m'okpo-okpo ọttọ-ọ ọbọhk, aruk akpen.”<verse eid="1KI 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 20:32" />Minna kw'mafọr abara-bina k'erin, mabir adabh ndik k'eso, mafona, mad-akebha ọvaarnọng kw'Israẹl za. Maben-ẹ bẹ́, “Bẹn-Hadad kw'ode ọtọhmnọng kwọ, okwukọ bẹ́, ‘Ototo, tte-m ọbọhk nruk akpen.’ ”</para>
  <para style="p" vid="1KI 20:32">Ọvaarnọng kw'Israẹl ọpọhna bẹ bẹ́, “Otim oning akpen za? Agbaanakka kwaam wọ.”<verse eid="1KI 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 20:33" />Wa anọng mbo mad-atik bẹ́, maze ẹkọhka ọkkọkka ch'efon z'ọvaarnọng. Minna kw'manẹ-ẹ z'ẹmma bẹ́, “Iye, Bẹn-Hadad agbaanakka kwọ e!”</para>
  <para style="p" vid="1KI 20:33">Ọvaarnọng oben bẹ bẹ́, “Màd-itọk-ẹ tima kwu.” Ch'Bẹn-Hadad opyirẹ nya, Ahab otim-ẹ ovura z'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr.<verse eid="1KI 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 20:34" />Bẹn-Hadad oben Ahab bẹ́, “Ibhondim njo maphyir s'iwa atte kwaam ọna atte kwọ, m'ntte jẹ ọbọhk maphyir, nnang-ọ. Ó̱de ódaak-ọ, kwu ttima mphya sọ z'Damaskus k'ose kw'uwa atte kwaam osi z'Samariya.”</para>
  <para style="p" vid="1KI 20:34">Ahab oben-ẹ bẹ́, “Kaam m'nttọ-ọ ọbọhk azong afona okurọ nttọhna nja.” Minna kw'Ahab osi echekẹ ọmaan-ẹ, ọttẹ-ẹ ọbọhk ofona.<verse eid="1KI 20:34" /></para>
  <para style="s1">Ọgbaak-ettem ch'Ibinọkpaabyi opyimẹ Ahab</para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 20:35" />Ọgbaak-ettem ch'Ibinọkpaabyi wanẹ ny'abẹ k'ẹkaan, otima ẹfa ch'ọgbaakadik kw'Ibinọkpaabyi oben oyok-ẹkaan bẹ́, “Mum-m ọttọhk.” Okenaka, oyok obhum.<verse eid="1KI 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 20:36" />Ofona nya o, ọgbaak-ettem ch'Ibinọkpaabyi nwo oben bẹ́, “Ch'abhumọ ọgbaakadik kw'Ọvaar Ibinọkpaabyi okpukpobha, óde ábin arik-m ma, eche m'ẹfhọ-ọ.” K'ose kw'obin orik-ẹ nya, ogbe kobhirẹ, eche eyin nya, ẹfhẹ-ẹ.<verse eid="1KI 20:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 20:37" />Kẹ ọgbaak ettem ch'Ibinọkpaabyi nwo o, od-oze ọnọng ọdọk-ọdọk, oben-ẹ bẹ́, “Mum-m ọttọhk.” Minna kw'ọnọng nwo omum-ẹ ọttọhk <char style="it">bẹ́ gbirr.</char> <verse eid="1KI 20:37" /><verse number="38" style="v" sid="1KI 20:38" />Nya o, ọgbaak-ettem ch'Ibinọkpaabyi nwo ofona, od-obe z'eden otik ọvaarnọng. Ọfọra ekpo mach'ina kẹ ode. Ọkpa ẹbarakpa chẹ ch'eso ebubh-ẹ achen. <verse eid="1KI 20:38" /><verse number="39" style="v" sid="1KI 20:39" />K'ose kw'ọvaarnọng ọd-ọkpan nya, ọgbaak-ettem ch'Ibinọkpaabyi nwo ọsẹ-ẹ ẹmọng, oben-ẹ bẹ́, “Kaam ọtọhmnọng kwọ ntim maa, mpyirẹ z'ettem kw'egbong. Nya wọ kw'osojanọng ochen-m ọnọng kw'mabọk k'egbong, oben-m bẹ́, ‘Kkerẹ ọnọng nwa; óde nnor-ẹ oror, m'atima akpen pọ atera akpen pẹ, wanẹma, anang talẹn mawanẹ kw'silva.’ <verse eid="1KI 20:39" /><verse number="40" style="v" sid="1KI 20:40" />Ch'oning nya ọyak-m, ọnọng nwo ọnaang-m ọrọbh.”</para>
  <para style="p" vid="1KI 20:40">Ọvaarnọng kw'Israẹl oben-ẹ bẹ́, “Minna kw'aponga pọ mm'ade e! Kọ kk'aponga pọ azeng mmo akpaara e.”<verse eid="1KI 20:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 20:41" />Nya o, ọgbaak-ettem ch'Ibinọkpaabyi nwo ọsẹr-ọsẹr, ọwọra ẹbarakpa ndo ch'eso ny'ichen. Ọvaarnọng kw'Israẹl otin-ẹ bẹ́, ọgbaak-ettem ch'Ibinọkpaabyi wanẹ wọ. <verse eid="1KI 20:41" /><verse number="42" style="v" sid="1KI 20:42" />Ọgbaak-ettem ch'Ibinọkpaabyi nwo oben ọvaarnọng kw'Israẹl bẹ́, “Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Ch'atte ọnọng nwo kw'kaam kk'mphyika bẹ́, ope ọrọbh, akpen pọ bọ mm'atera eso ch'akpen pẹ, akpen p'anọng pọ abira atera eso ch'akpen p'anọng pẹ.’ ” <verse eid="1KI 20:42" /><verse number="43" style="v" sid="1KI 20:43" />Minna kw'ọvaarnọng kw'Israẹl, otim ottempyibha, ọmaana ididọkọ ochina z'ikẹ k'odimpa z'Samariya.<verse eid="1KI 20:43" /></para>
  <chapter eid="1KI 20" />
  <chapter number="21" style="c" sid="1KI 21" />
  <para style="s1">Ahab ọtọk owonọ kw'Nabọt</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 21:1" />K'ogbe wanẹ, wa odik oyinẹ kw'ọmaan owonọ kw'grep kw'Nabọt kw'ofon Jẹzẹrẹl. Owonọ nwo, wa oning z'Jẹzẹrẹl, ọnyọma odimpa kw'Ahab kw'ode ọvaarnọng kw'Samariya. <verse eid="1KI 21:1" /><verse number="2" style="v" sid="1KI 21:2" />Otum k'ogbe wanẹ, Ahab oben Nabọt bẹ́, “Nang-m owonọ kwọ kw'grep ntima nsi ewonọva ma ch'ọnyọm odimpa kwaam. Kaam ọttara kọ mm'osi mmona s'owonọ kw'grep. Kaam m'nnang-ọ owonọ kw'ojibhẹ ọyọhnga nwoma. Ó̱de nwo nya ini kọ ọdaakẹ, kaam m'nnang-ọ akpuka kpenamkpen p'owonọ nwo ope.”<verse eid="1KI 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 21:3" />Nabọt ọpọhna Ahab bẹ́, “Ọvaar Ibinọkpaabyi mòchera bẹ́, ntọka ebo-cha ch'ab'ttatta paam, nnang-ọ.”<verse eid="1KI 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 21:4" />Minna kw'Ahab otim ididọkọ ọmaana ottempyibha ofona z'ọsọhm, okurọ ch'Nabọt kw'ofon Jẹzẹrẹl obenẹ bẹ́, “Kọ ebo-cha ch'ab'ttatta paam mìnnang.” Otima ididọkọ oyima z'ikẹ k'ebin, obhum ọttọhk ochichi.<verse eid="1KI 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 21:5" />Jẹzẹbẹl kw'ode kwanọng kwẹ, okwu okebh-ẹ nya, ọbọbh-ẹ bẹ́, “Ode yen kw'ọdọkọ minna? Ode yen kw'ina ọttọhk acher achi?” <verse eid="1KI 21:5" /><verse number="6" style="v" sid="1KI 21:6" />Ahab ọpọhn-ẹ bẹ́, “Ofon ch'mbenẹ Nabọt kw'ofon Jẹzẹrẹl bẹ́, ‘Kpe-m owonọ kwọ kw'grep. Ó̱de ini kọ minna ọdaakẹ, tte mosi mmona s'owonọ kw'grep ọdọk-ọdọk.’ Nabọt oben-m bẹ́, ‘Kaam kọ owonọ kwaam kw'grep mìnnang.’ ”<verse eid="1KI 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 21:7" />Jẹzẹbẹl kw'ode kwanọng kwẹ, oben-ẹ bẹ́, “Minna wọ kw'ọvaarnọng kw'Israẹl ọbaan bẹ́, osi o? Bin-obina chi ọttọhk, ayan-ọyan z'ititika. Kaam m'ntọka owonọ nwo kw'grep kw'Nabọt kw'ofon Jẹzẹrẹl nnang-ọ.”<verse eid="1KI 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 21:8" />Minna kw'otim eche ch'Ahab, ọkkẹr nkkaabha, ottima ẹnọhna ch'Ahab ny'nkkaabha njo, ọtọhm ọnang asogbọhkọnọng ọmaana asonọng p'Nabọt matọn aruk ny'ebhondim ndo madanẹ. <verse eid="1KI 21:8" /><verse number="9" style="v" sid="1KI 21:9" />Ny'nkkaabha njo, kwanọng nwo ọkkẹrẹ bẹ́, “Màyerẹ ọkwa, màtim ọchattọhk. Màtọka Nabọt sok k'ibyi s'ọnọng kpenamkpen m'ọzẹ-ẹ. <verse eid="1KI 21:9" /><verse number="10" style="v" sid="1KI 21:10" />Màtọka affutẹtẹ-nọng banẹ sok. Tte maninga akkerẹ Nabọt ititika, mabọhm-ẹ odik bẹ́, ọtwọ Ibinọkpaabyi ọmaana ọvaarnọng. Pira nnatim-ẹ ayin z'iyaan, matọbh-ẹ ata maa, ope.”<verse eid="1KI 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 21:11" />Nya o, asogbọhkọnọng, ọmaana asonọng mbo p'Nabọt matọn aruk ny'ebhondim ndo madanẹ, masi k'ose kw'Jẹzẹbẹl ikk'ọkkẹra ọtọhn bẹ bẹ́, masi. <verse eid="1KI 21:11" /><verse number="12" style="v" sid="1KI 21:12" />Minna kw'mayerẹ ọkwa, matim ọchattọhk, matọka Nabọt asok k'ibyi s'ọnọng kpenamkpen m'ọzẹ-ẹ. <verse eid="1KI 21:12" /><verse number="13" style="v" sid="1KI 21:13" />Minna kw'affutẹtẹ-nọng afa mayinẹ ka, maninga akkerẹ Nabọt ititika, matọma Nabọt idik obubọhma ny'anọng k'ititika, maben bẹ́, “Nabọt kk'Ibinọkpaabyi ọmaana ọvaarnọng ọtwa e!” Nya o, matọk-ẹ atima abina arik ebhondim, matọhbh-ẹ ata maa, ope. <verse eid="1KI 21:13" /><verse number="14" style="v" sid="1KI 21:14" />Nya o, matọhm ẹkkaabha anang Jẹzẹbẹl bẹ́, “Nkk'Nabọt ata ọtọhbha maa, ope.”<verse eid="1KI 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 21:15" />K'ose kw'Jẹzẹbẹl obhubhaanga nya bẹ́, nkk'ata atima afhọ Nabọt, oben odim bẹ́, “Bina, zọhng tọka owonọ nwo kw'grep kw'Nabọt kw'ofon Jẹzẹrẹl, ayena, owonọ nwo kw'obhumọ bẹ́, ọkpọ-ọ. Nabọt ọdọk k'akpen kode, kk'ọpa e.” <verse eid="1KI 21:15" /><verse number="16" style="v" sid="1KI 21:16" />K'ogbe kw'Ahab ọbhaang bẹ́, Nabọt kk'ọpa, obina, ofona bẹ́, ọd-ọtọka owonọ nwo kw'grep kw'Nabọt oyena.<verse eid="1KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 21:17" />Nya kw'ẹkkaabha ch'Ọvaar Ibinọkpaabyi ekwu ekebha Ẹlaija kw'ofon Tishbe bẹ́, <verse eid="1KI 21:17" /><verse number="18" style="v" sid="1KI 21:18" />“Bina, zọhng kebha Ahab kw'ode ọvaarnọng kw'Israẹl, kw'ọbaabh Samariya. Madidanma, oning z'owonọ kw'grep kw'Nabọt. Kk'ochina za bẹ́, ọd-ọtọka oyena. <verse eid="1KI 21:18" /><verse number="19" style="v" sid="1KI 21:19" />Ó̱de apyirẹ za, tek-ẹ bẹ́, ‘Ọvaar Ibinọkpaabyi obenẹ bẹ́, mba kk'ọnọng afha anẹ-ẹ oyena kwẹ o?’ China ororo ben-ẹ bẹ́, ‘Ọvaar Ibinọkpaabyi obenẹ bẹ́, ny'ibyi njo s'mffa igbẹnẹ izẹ s'Nabọt, nya wọ kw'mffa im'ibir igbẹnẹ izẹ sọ. Iye, izẹ sọ oyenẹ e.’ ”<verse eid="1KI 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 21:20" />Nya o, Ahab oben Ẹlaija bẹ́, “Kọ ọwawunanọng kwaam, mba kk'aam arora maa, kk'aam aza!” Ẹlaija ọpọhna bẹ́, “Iye, kk'ọ nza, okurọ bẹ́, atte ifor sọ ọbọhk anang epyibha k'ititika s'Ọvaar Ibinọkpaabyi. <verse eid="1KI 21:20" /><verse number="21" style="v" sid="1KI 21:21" />Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Kaam m'ntte itama siden ikpẹk-ọ. Kaam m'ndimẹ ẹnọmma chọ maphyir. Ozeng ny'Israẹl, ojinọngnwa kpenamkpen kw'ode okpongannam ny'ntaak s'Ahab, zaa ode ọmmaana, obir ode obira, m'ndim-ẹ eche. <verse eid="1KI 21:21" /><verse number="22" style="v" sid="1KI 21:22" />Kaam m'nsi ẹsọhmmọr chọ ede mach'ndo ch'Jẹroboam kw'ode nnwa kw'Nẹbat, mbir nsi chẹ ede mach'ndo ch'Baasha kw'ode nnwa kw'Ahija, okurọ bẹ́, kọ kk'ottempyibha kwaam agboka, ch'awọhkọ anọng p'Israẹl masi epyibha.’<verse eid="1KI 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 21:23" />“Ṉ́nòde odik kw'ọmaan Jẹzẹbẹl, Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Ny'etumọ ch'Jẹzẹrẹl, nya wọ kw'mffa im'ichi Jẹzẹbẹl.’<verse eid="1KI 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 21:24" />“Mffa m'ichi ọnọng kpenamkpen kw'Ahab kw'ope z'ebhondim. Ayok p'ape z'ẹgba, attẹrẹ m'asorọ bẹ.”<verse eid="1KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 21:25" />(Wa ọnọng kode kw'osi epyibha obenga Ahab ábẹ̀, k'ititika s'Ibinọkpaabyi. Kẹ wa otte ifor sẹ ọbọhk ọnang epyibha. Jẹzẹbẹl kw'ode kwanọng kwẹ wọ uwa ọd-ọchọhm-ẹ. <verse eid="1KI 21:25" /><verse number="26" style="v" sid="1KI 21:26" />Wa ọd-ọyak ọbọhk osi ibyibyadik, od-okpobha aka mach'anọng p'Amọr p'Ọvaar Ibinọkpaabyi okwubhọ pira ọtọka izek njo ọnang Israẹl.)<verse eid="1KI 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 21:27" />K'ogbe kw'Ahab ọbhaang idik nja, ọyaakẹ ekpo py'ọfọr maphyir, ọtọka abara-bina ọfọra, otim ọchattọhk. Od-oyima ọmaana abara-bina mbo, od-ozenga mach'ọnọng kw'okom ifor kidaam.<verse eid="1KI 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 21:28" />Nya o, Ọvaar Ibinọkpaabyi ọtọhm ẹkkaabha ọnang Ẹlaija kw'ofon Tishbe, oben-ẹ bẹ́, <verse eid="1KI 21:28" /><verse number="29" style="v" sid="1KI 21:29" />“Kk'Ahab otum aka k'ose kw'ikk'ifor sẹ ọsaka m'kaam k'ititika? Efor-saka ndo ch'm'nzenga ábẹ̀, mkpa nnam mbọra itama njo s'nkamẹ m'ogbe kw'ikẹ oning akpen. Kwuna min'nsi itama njo nnang ẹsọhmmọr chẹ, k'ogbe kw'nnwa kwẹ m'ọbaabha.”<verse eid="1KI 21:29" /></para>
  <chapter eid="1KI 21" />
  <chapter number="22" style="c" sid="1KI 22" />
  <para style="s1">Mikaya ọgbaakẹ itama s'im'iyin Ahab</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 22:1" />K'icho minna ittaan, wa anọng p'Aram ọmaana Israẹl m'egbong karim. <verse eid="1KI 22:1" /><verse number="2" style="v" sid="1KI 22:2" />Ny'icho kw'ottong ittaan, Jehoshaphat kw'ode ọvaarnọng kw'Juda obina, od-okebha ọvaarnọng kw'Israẹl. <verse eid="1KI 22:2" /><verse number="3" style="v" sid="1KI 22:3" />Ode ch'ọvaarnọng kw'Israẹl ikk'asonọng pẹ obena bẹ́, “Bọnga mazong za bẹ́, mina bọ moyen Ramọt-Gilead? Ọbaan bẹ́, mosi k'ose kw'mm'ọtọka wẹ z'mbọhk s'ọvaarnọng kw'Aram.”<verse eid="1KI 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 22:4" />Minna kw'ọbọbh Jehoshaphat bẹ́, “Ína ator-m moyin erima z'Ramọt-Gilead?” Jehoshaphat kw'ode ọvaarnọng kw'Juda ọpọhn-ẹ bẹ́, “Kaam ọmaana kọ mode ọttọhk mavanẹ, anọng paam abir ade anọng pọ, nnyanya saam ibir ide sọ.”<verse eid="1KI 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 22:5" />Jehoshaphat obir oben ọvaarnọng kw'Israẹl bẹ́, “Ọbaan bẹ́, achi eden abhaanga ọgbaakadik z'Ọvaar Ibinọkpaabyi k'ẹmma.”<verse eid="1KI 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 22:6" />Minna kw'ọvaarnọng kw'Israẹl oyerẹ agbaak-ettem ch'Ibinọkpaabyi p'mm'apyirẹ anọng ẹnọhna, otobha bẹ k'ibyi majanẹ, ọbọbh bẹ bẹ́, “Ma, nyin egbong oririma mmaana anọng p'Ramọt-Gilead o? Ma, nninga ẹwọr o?”</para>
  <para style="p" vid="1KI 22:6">Mapọhn-ẹ bẹ́, “Zọhng, kirẹ Ibinọkpaabyi m'ọtọka bẹ, oke ọvaarnọng ny'mbọhk.”<verse eid="1KI 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 22:7" />Okenaka, Jehoshaphat ọbọbh bẹ́, “Ma, ọgbaak-ettem ch'Ibinọkpaabyi ọdọk-ọdok za kode kw'wura mọbọbhọ yirẹ?”<verse eid="1KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 22:8" />Ọvaarnọng kw'Israẹl ọpọhna Jehoshaphat bẹ́, “Ọgbaak-ettem ch'Ibinọkpaabyi wanẹ oning za kw'wura-wura mọbọbh-ẹ ochibhẹ kw'Ọvaar Ibinọkpaabyi, okenaka, kẹ kaam idik kọdaakẹ okurọ bẹ́, ọkkọkka otim ọd-ọgbaaka kw'ọmaan-m. Ọd-ọgbaak epyibha dẹ-dẹ ọmaan-m. Kẹ okpen Mikaya, kw'ode nnwa kw'Imla.”</para>
  <para style="p" vid="1KI 22:8">Jehoshaphat ọpọhn-ẹ bẹ́, “Mma o! Tte ọvaarnọng oning odikse nwo ọgbaakẹ o!”<verse eid="1KI 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 22:9" />Nya o, ọvaarnọng kw'Israẹl oyerẹ osonọng wanẹ kwẹ, oben-ẹ bẹ́, “Sẹr-ọsẹr, yerẹ Mikaya kw'ode nnwa kw'Imla, chen-m.”<verse eid="1KI 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 22:10" />Ny'ogbese nwo, ọvaarnọng kw'Israẹl ọmaana ọvaarnọng kw'Juda nkk'ẹnya ch'avaar afọra, maninga ny'mvaarkkọhbhọ sabẹ, ny'ọgbaarẹ kw'mad-aduk barli kw'oning ny'ẹmma-ẹmma kw'ebhumma ch'Samariya. Agbaak-ettem ch'Ibinọkpaabyi mbo maphyir mad-aninga ny'abẹ k'ititika, magbaak idik s'maze. <verse eid="1KI 22:10" /><verse number="11" style="v" sid="1KI 22:11" />Zedekaya kw'ode nnwa kw'Kenaana otima mbaanga osi abhik, oben bẹ́, “Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Ekpo mbyoma py'im'atima anyunọ anọng p'Aram maa, madimẹ eche.’ ”<verse eid="1KI 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 22:12" />Agbaak-ettem ch'Ibinọkpaabyi mboza maphyir magbaak ose nwo-nwo, mad-aben bẹ́, “Zọhng rima Ramọt-Gilead ábẹ̀, akema. Ọvaar Ibinọkpaabyi m'ọtọka obhon nwo, oke ọvaarnọng ny'mbọhk.”<verse eid="1KI 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 22:13" />Ozeng-eden kw'ofon bẹ́, od-oyerẹ Mikaya oben-ẹ bẹ́, “Agbaak-ettem ch'Ibinọkpaabyi mboza maphyir magbaakẹ edik-daak madanẹ bẹ́, egbong m'ejibh-ojibh ẹnang ọvaarnọng. Tte odik kwọ ode mbengana ọmaana kwabẹ. Gbaak-ẹ bẹ́, mm'akem-okema.”<verse eid="1KI 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 22:14" />Nya o, Mikaya oben-ẹ, bẹ́,“K'ose kw'Ọvaar Ibinọkpaabyi orukọ akpen, okpenamkpen f'ọgbaak-m, vẹ vọ f'kaam m'mgbaak-ẹ.”<verse eid="1KI 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 22:15" />K'ogbe kw'Mikaya opyirẹ nya, ọvaar Ahab ọbọbh-ẹ bẹ́, “Mikaya, ma, moyin egbong ọmaana Ramọt Gilead o? Ma, moninga ẹwọr o?”</para>
  <para style="p" vid="1KI 22:15">Mikaya ọpọhn-ẹ bẹ́, “Yin egbong akema. Ọvaar Ibinọkpaabyi m'ọtọka bẹ oke ọvaarnọng ny'mbọhk.”<verse eid="1KI 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 22:16" />Ọvaarnọng oben-ẹ bẹ́, “Igbedim iphaang s'kaam min'mben-ọ bẹ́, achekẹ bẹ́, m'agbaak-m odik ọkkọkka k'eche ch'Ibinọkpaabyi?”<verse eid="1KI 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 22:17" />Nya o, Mikaya ọpọhna bẹ́, “Nze ch'anọng p'Israẹl maphyir maraamẹ z'agbe mach'arọkimaan p'nna ọnọng ayen kw'okkerẹ bẹ. Pira Ọvaar Ibinọkpaabyi oben bẹ́, ‘Anọng mboma m'otte kayen e. Tte ọnọng-ọnọng ọzọhng ọbhana k'ọdaam.”<verse eid="1KI 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 22:18" />Minna kw'ọvaarnọng kw'Israẹl obenẹ Jehoshaphat bẹ́, “Mba kk'ọ nteka bẹ́, odik ọkkọkka otim ọd-ọgbaaka kw'ọmaan-m, kw'ọkpanẹ itama jẹ-jẹ?”<verse eid="1KI 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 22:19" />Mikaya ochina ororo oben bẹ́, “Bhaanga odik nwa kw'Ọvaar Ibinọkpaabyi ọgbaakẹ: Nze Ọvaar Ibinọkpaabyi ch'oning k'ẹkkọhbhọ chẹ, ọmaana eyokinọn-gkaan ndo maphyir ch'obhon kw'Ibinọkpaabyi ch'ebe ẹkọbh-ẹ k'odimbọhk ọmaana k'obhurubọhk. <verse eid="1KI 22:19" /><verse number="20" style="v" sid="1KI 22:20" />Minna kw'Ọvaar Ibinọkpaabyi obenẹ bẹ́, ‘Anyi wọ im'ọbọhra Ahab bẹ́, oyin egbong ọmaana anọng p'Ramọt-Gilead, ọfha ope za?’</para>
  <para style="p" vid="1KI 22:20">“Ọnọng wanẹ oyoma odik wanẹ, nwoza oyoma ọdọk-ọdọk.<verse eid="1KI 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 22:21" />K'okpongannamgbe, egwugwuma danẹ eyin ka, ebe ny'Ọvaar Ibinọkpaabyi k'ititika, eben bẹ́, ‘Kaam m'mbọhr-ẹ.’<verse eid="1KI 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 22:22" />“Ọvaar Ibinọkpaabyi ọbọbh egwugwuma ndo bẹ́, ‘Bọng-eden ch'm'atima abọhr-ẹ?’</para>
  <para style="p" vid="1KI 22:22">“Egwugwuma ndo ẹpọhna bẹ́, ‘Kaam m'mfona, nd-nde egwugwuma ch'afọra k'ẹmma ch'anọng p'ad-agbaak-ettem ch'Ibinọkpaabyi anang Ahab.’</para>
  <para style="p" vid="1KI 22:22">“Ọvaar Ibinọkpaabyi oben-ẹ bẹ́, ‘M'akpo-okpo abọhr-ẹ. Zọhng si minna.’<verse eid="1KI 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 22:23" />“Nya o, Ọvaar Ibinọkpaabyi kk'egwugwuma ch'ẹd-ẹbọhra ọnọng ọtọka oke agbaak-ettem ch'Ibinọkpaabyi mba pọ maphyir k'ẹmma. Ọvaar Ibinọkpaabyi kk'itama ophyika osok-ọ.”<verse eid="1KI 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 22:24" />Nya o, Zedekaya kw'ode nnwa kw'Kenaanat, obina ọd-ọphaakẹ Mikaya ọbọhk, ọbọbh-ẹ bẹ́, “Memma kw'egwugwuma ch'Ọvaar Ibinọkpaabyi ette kaam ọbọhk, pira ẹd-ẹgbaak odik ẹnang kọ?”<verse eid="1KI 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 22:25" />Mikaya ọpọhn-ẹ bẹ́, “M'azong-ozonga ny'ewu ndo ch'm'arọbh ad-atubha z'idongọ ẹtaanga.”<verse eid="1KI 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 22:26" />Nya kw'ọvaarnọng kw'Israẹl nọnang ẹfa bẹ́, “Màbọka Mikaya, màtọm-ẹ chena Amọn kw'ọbaabh ebhondim, ọmaana Joash kw'ode nnwa kw'ọvaarnọng. <verse eid="1KI 22:26" /><verse number="27" style="v" sid="1KI 22:27" />Ó̱de mápyirẹ za, maben bẹ bẹ́, ‘Ọvaarnọng obenẹ bẹ́, màke ojinọng nwa mgbakkọhbhọ, m'ikẹ ọchattọhk f'oyinẹ k'eden kànang, kw'ọkpanẹ brẹd ọmaana asi. Tte oninga nya maa, nkwuna egbong nda k'ọdaam.’ ”<verse eid="1KI 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 22:28" />Mikaya oben bẹ́, “Ó̱de akwun egbong ndo k'ọdaam, zonga bẹ́, Ọvaar Ibinọkpaabyi kaam kod-otima ọgbaak odik. Obir oben bẹ́, “Bọnga maphyir, màjima odik nwa o!”<verse eid="1KI 22:28" /></para>
  <para style="s1">Mafhọ Ahab k'egbong z'Ramọt-Gilead</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 22:29" />Minna kw'ọvaar Ahab kw'Israẹl ọmaana ọvaar Jehoshaphat kw'Juda mabin ayin egbong z'Ramọt-Gilead. <verse eid="1KI 22:29" /><verse number="30" style="v" sid="1KI 22:30" />Ọvaarnọng kw'Israẹl oben Jehoshaphat bẹ́, “Kaam m'mfọra ekpo k'ose kw'ọnọng ina kaam mokpo otim, ntima nyin egbong ndo. Kọ, fọra ẹvaarkpo pyọ.” Minna kw'ọvaarnọng kw'Israẹl ọfọr ekpo k'ose kw'ọnọng ina kẹ mokpo otin, obina oyin egbong.<verse eid="1KI 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 22:31" />Ny'ogbe nwo, ọvaarnọng kw'Aram kk'anọng ẹrọbh okwuma ijobh kkamfa p'ade aso p'ayaar-ijaar s'nnyanya id-itọr obena bẹ́, “M'egbong kàrima amaana ọnọng kpenamkpen: ọcham-ọchamẹ, ọbar-ọbar. Ọvaarnọng kw'Israẹl wọ kw'mm'akkerẹ ichen.” <verse eid="1KI 22:31" /><verse number="32" style="v" sid="1KI 22:32" />K'ogbe kw'asonọng p'ayaar-ijaar s'nnyanya id-itọr maze Jehoshaphat, machibhẹ bẹ́, “K'odik ọkkọkka, ọvaarnọng kw'Israẹl wọ ma.” Minna kw'mabhakẹ, makker-ẹ ichen. Jehoshaphat ọgọhma ẹmọng. <verse eid="1KI 22:32" /><verse number="33" style="v" sid="1KI 22:33" />Asonọng p'ayaar-ijaar s'nnyanya id-itọr, maze bẹ́, ọvaarnọng kw'Israẹl azang nya, mattik-ẹ okwukwubh.<verse eid="1KI 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 22:34" />Okenaka, ọnọng wanẹ okkerẹ nya, ọtta oyuk kwẹ k'ibyi-k'ibyi. Oyuk nwo, ozenga ny'abhokọ p'egbongkpo py'ọvaarnọng kw'Israẹl ọfọr, okwum-ẹ ny'ittemmọma. Ọvaar Ahab kw'Israẹl oben ọnọng kw'ọd-ọyaar ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr bẹ́, “Bhakẹ eso, atim-m ayaar abina m'egbong nda, kirẹ nkk'aam ọttọhk amuma.” <verse eid="1KI 22:34" /><verse number="35" style="v" sid="1KI 22:35" />Ny'ewu ndo kibungọ, egbong ndo ẹkọmọ mach'ẹkọmọ nya. Ọvaarnọng ophe ny'ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr, okkerẹ anọng p'Aram. Otum ny'ẹsọhka, ope. Izẹ s'iyinẹ ny'ọttọhk f'mamum-ẹ, ibhobh ny'ọgbaarẹ kw'ọkpaar nwo. <verse eid="1KI 22:35" /><verse number="36" style="v" sid="1KI 22:36" />Nya ch'ewu min'ẹsa, ẹmọng etto za ch'asoja maphyir mayim egbong bẹ́, “Ọnọng-ọnọng ọbhana z'ẹkọma chẹ. Ọnọng-ọnọng ọbhana z'obhon kwẹ.”<verse eid="1KI 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 22:37" />Minna kw'ọvaar Ahab ope. Matim-ẹ achina z'Samariya, manọhng-ẹ za. <verse eid="1KI 22:37" /><verse number="38" style="v" sid="1KI 22:38" />Makwu agbobhọ ọkpaar kwẹ kw'ẹnyanya ẹd-ẹtọr ny'ekeka ch'Samariya (kw'ode ekeka ch'azaza ad-agbobha asi). Mffa ikwu igbẹnẹ izẹ sẹ, k'ose kw'Ọvaar Ibinọkpaabyi ikk'obena.<verse eid="1KI 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 22:39" />Idik njoza s'iyinẹ k'ogbe kw'Ahab ọbaabh, ọmaana idik njoza maphyir s'osi, maa, tto z'ọvaarsọhm kw'otim ekpo py'ẹnna <char style="it">mawere-were</char> osi, pyirẹ z'ibhondim s'osi, makkẹrẹ jẹ z'anwẹr p'idik s'avaar p'Israẹl. <verse eid="1KI 22:39" /><verse number="40" style="v" sid="1KI 22:40" />Nya o, Ahab okwu ope, Ahaziya kw'ode nnwa kwẹ, okwu otima ẹvaar chẹ.<verse eid="1KI 22:40" /></para>
  <para style="s1">Jehoshaphat otim ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 22:41" />Ny'icho ttong nna s'Ahab ọbaabh Israẹl, nya kw'Jehoshaphat kw'ode nnwa kw'Asa, otim ẹvaar ch'Juda. <verse eid="1KI 22:41" /><verse number="42" style="v" sid="1KI 22:42" />Wa Jehoshaphat ode icho ẹrọbh okwuma ichi k'ogbe kw'masẹ-ẹ ẹvaar. Oninga z'Jẹrusalẹm ọbaabha Juda k'icho ẹrọbh okuma ichen. Wa ọkka kwẹ okpen Azuba, kw'ode kwanọngnwa kw'Shilhi. <verse eid="1KI 22:42" /><verse number="43" style="v" sid="1KI 22:43" />Wa Jehoshaphat otorọ ẹtọkọ ch'Asa kw'ode otte kwẹ. K'ọttọhk kpenamkpen f'osi, wa nden s'otte kọ̀gbaarẹ ọbharẹ. Wa osi idik s'itor-otor z'Ọvaar Ibinọkpaabyi k'ititika. Ọttọhk f'uwa ina osi ode bẹ́, wa ọja-byi mvo f'ọyaankpa kọvọhkọ, ọwọhkọ anọng achina ororo afọhnọ nja, mabira akwọmọ insẹns nya. <verse eid="1KI 22:43" /><verse number="44" style="v" sid="1KI 22:44" />Wa Jehoshaphat obir oruk k'ẹmẹm ọmaana ọvaarnọng kw'Israẹl.<verse eid="1KI 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 22:45" />Idik njoza maphyir s'iyinẹ k'ogbe kw'Jehoshaphat ọbaabh, tọma z'ẹfa ch'oyen, pyirẹ z'mgbong s'orim okema, makkẹrẹ z'anwẹr p'idik s'avaarnọng p'Juda. <verse eid="1KI 22:45" /><verse number="46" style="v" sid="1KI 22:46" />Ochina z'ekwuna ch'azaza p'ejinọng, okwubh ayok p'uwa nnarikẹ ny'izek njo k'ogbe kw'Asa ọbaabh. <verse eid="1KI 22:46" /><verse number="47" style="v" sid="1KI 22:47" />Ny'ogbe nwo kw'Jehoshaphat ọbaabh, wa ẹkọma ch'Edom ọvaarnọng keyen. Otor-m kw'ọvaarnọng wọ uwa ọbaabh nya.<verse eid="1KI 22:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 22:48" />Jehoshaphat osi akkaara-kpaar p'mad-atima ayaama ẹphya ch'gol z'Ophir. Okenaka, m'ibyi kpenamkpen kata, akpaar mbo marubhọ bẹ z'Eziyon-Gẹbẹr. <verse eid="1KI 22:48" /><verse number="49" style="v" sid="1KI 22:49" />Ny'ogbe nwo, Ahaziya kw'ode nnwa kw'Ahab, oben Jehoshaphat bẹ́, “Tte anọng paam mator anọng pọ mata ẹwọna kẹ o.” Jehoshaphat obhum.<verse eid="1KI 22:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1KI 22:50" />Wa o, Jehoshaphat okwu ope, manọhng-ẹ za ch'iwa manọhng ab'ttatta pẹ, z'ebhondim ch'Devid kw'ode otte. Minna kw'Jehoram kw'ode nnwa kwẹ okwu ọtọka eninga chẹ mach'ọvaarnọng.<verse eid="1KI 22:50" /></para>
  <para style="s1">Ahaziya otim ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 22:51" />Wa Ahaziya kw'ode nnwa kw'Ahab okwu otima ẹvaar ch'Israẹl ny'Samariya ny'icho ttong ichenọmfa s'Jehoshaphat ọbaabh Juda. Ahaziya ọbaabha Israẹl k'icho ifa. <verse eid="1KI 22:51" /><verse number="52" style="v" sid="1KI 22:52" />Wa osi itama z'Ibinọkpaabyi k'ititika okurọ ch'otorọ ntọkọ s'otte, ọmaana s'ọkka, ọttara s'Jẹroboam kw'ode nnwa kw'Nẹbat, p'uwa mawọhkọ anọng p'Israẹl asi epyibha. <verse eid="1KI 22:52" /><verse number="53" style="v" sid="1KI 22:53" />Wa kẹ ocher k'Baal, obir okpobha Baal nwo k'ose kw'uwa otte osi. Vẹ vọ uwa oyemẹ ottempyibha kw'Ọvaar Ibinọkpaabyi kw'ode Ibinọkpaabyi kw'Israẹl.<verse eid="1KI 22:53" /></para>
  <chapter eid="1KI 22" />
</usx>