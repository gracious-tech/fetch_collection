<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open New Oromo Contemporary Version 2022</book>
  <para style="h">Faarfannaa</para>
  <para style="toc1">Kitaabota Faarfannaa</para>
  <para style="toc2">Faarfannaa</para>
  <para style="toc3">Far</para>
  <para style="mt2">Kitaabota</para>
  <para style="mt1">Faarfannaa</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">Kitaaba Tokkoffaa</para>
  <para style="mr">
    <ref loc="PSA 1-41">Faarfannaa 1–41</ref></para>
  <para style="cl">Faarfannaa 1</para>
  <para style="ms1">Karaa Lamaan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Namni gorsa hamootaatiin hin deddeebine,</para>
  <para style="q2" vid="PSA 1:1">yookaan karaa cubbamootaa irra hin dhaabanne,</para>
  <para style="q2" vid="PSA 1:1">yookaan barcuma qoostotaa irra hin teenye, eebbifamaa dha.<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>Garuu inni seera <char style="nd">Waaqayyootti</char> gammada;</para>
  <para style="q2" vid="PSA 1:2">seera isaas halkanii guyyaa irra deddeebiʼee itti yaada.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Inni akkuma muka qarqara bishaan yaaʼuu dhaabamee</para>
  <para style="q2" vid="PSA 1:3">yeroo isaatti ija isaa kennu,</para>
  <para style="q1" vid="PSA 1:3">kan baalli isaas hin coollagnee ti;</para>
  <para style="q2" vid="PSA 1:3">wanni inni hojjetu hundinuus ni tolaaf.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Hamoonni garuu akkana miti;</para>
  <para style="q2" vid="PSA 1:4">isaan akka habaqii qilleensi fudhatee balleessuu ti.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Kanaafuu hamoonni murtii dura,</para>
  <para style="q2" vid="PSA 1:5">yookaan cubbamoonni waldaa qajeeltotaa keessa hin dhaabatan.<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>
    <char style="nd">Waaqayyo</char> karaa qajeeltotaa ni beekaatii;</para>
  <para style="q2" vid="PSA 1:6">karaan hamootaa garuu gara badiitti geessa.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">Faarfannaa 2</para>
  <para style="ms1">Mooticha Waaqni Dibee Moosise</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Namoonni maaliif akkanumaan malatu?</para>
  <para style="q2" vid="PSA 2:1">Saboonnis maaliif waan akkanumaan mariʼatu?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Mootonni lafaa kaʼanii,</para>
  <para style="q2" vid="PSA 2:2">bulchitoonnis <char style="nd">Waaqayyoo</char> fi Masiihii isaatiin mormuuf</para>
  <para style="q2" vid="PSA 2:2">walitti qabaman;<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>isaanis, “Kottaa foncaa isaanii of irraa kukkunnaa;</para>
  <para style="q2" vid="PSA 2:3">hidhaa isaaniis of irraa hiiknee gannaa” jedhu.<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Inni samii keessa, teessoo irra taaʼee jiru ni kolfa;</para>
  <para style="q2" vid="PSA 2:4">Gooftaanis isaanitti qoosa.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Innis aarii isaatiin isaan ifata;</para>
  <para style="q2" vid="PSA 2:5">dheekkamsa isaatiinis isaan naasisa;<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>innis, “Ani tulluu koo qulqulluu irra, Xiyoon irra,</para>
  <para style="q2" vid="PSA 2:6">mootii koo teessifadheera” jedha.<verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>Ani seera <char style="nd">Waaqayyoo</char> nan labsa:</para>
  <para style="b" vid="PSA 2:7"/>
  <para style="q1" vid="PSA 2:7">innis akkana anaan jedhe; “Ati ilma koo ti;</para>
  <para style="q2" vid="PSA 2:7">ani harʼa si dhalcheera.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Na kadhadhu;</para>
  <para style="q2" vid="PSA 2:8">ani saboota dhaala kee,</para>
  <para style="q2" vid="PSA 2:8">handaara lafaas qabeenya kee godhee siifan kenna.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Ati ulee sibiilaatiin isaan cabsita;</para>
  <para style="q2" vid="PSA 2:9">akka qodaa supheettis isaan hurreessita.”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Kanaafuu yaa mootota, qalbeeffadhaa;</para>
  <para style="q2" vid="PSA 2:10">bulchitoonni lafaas of eeggadhaa.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Sodaadhaan <char style="nd">Waaqayyoon</char> tajaajilaa;</para>
  <para style="q2" vid="PSA 2:11">hollachaas gammadaa.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Akka inni hin aarreef,</para>
  <para style="q2" vid="PSA 2:12">isinis akka karaa irratti hin badneef ilma isaa dhungadhaa;</para>
  <para style="q1" vid="PSA 2:12">dheekkamsi isaa dafee bobaʼaatii.</para>
  <para style="q2" vid="PSA 2:12">Warri isatti kooluu galan hundi eebbifamoo dha.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">Faarfannaa 3</para>
  <para style="ms1">Kadhannaa Nama Ariʼatamaa Jiruu</para>
  <para style="d">Faarfannaa Daawit yeroo ilma isaa Abesaaloom jalaa baqatetti faarfate.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>Yaa <char style="nd">Waaqayyo</char>, diinonni koo akkam baayʼatu!</para>
  <para style="q2" vid="PSA 3:1">Namoonni baayʼeen natti kaʼaniiru!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>Namoonni baayʼeen, “Waaqni isa hin baraaru” jedhanii</para>
  <para style="q2" vid="PSA 3:2">waaʼee koo dubbatu.<verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>Yaa <char style="nd">Waaqayyo</char>, ati garuu naannoo kootti gaachana koo ti;</para>
  <para style="q2" vid="PSA 3:3">ulfina kootis; mataa koos kan ol qabdu suma.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Ani guddisee <char style="nd">Waaqayyotti</char> nan iyyadha;</para>
  <para style="q2" vid="PSA 3:4">innis tulluu isaa qulqulluu irraa deebii naa kenna.<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Ani nan ciisa; nan rafas;</para>
  <para style="q2" vid="PSA 3:5">waan <char style="nd">Waaqayyo</char> ol na qabuuf nan dammaqa.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Saba kumaatama qixa hundaan</para>
  <para style="q2" vid="PSA 3:6">kaʼee na marse ani hin sodaadhu.<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Yaa <char style="nd">Waaqayyo</char> kaʼi!</para>
  <para style="q2" vid="PSA 3:7">Yaa Waaqa koo na baraari!</para>
  <para style="q1" vid="PSA 3:7">Mangaagaa diinota kootii hundumaa rukuti;</para>
  <para style="q2" vid="PSA 3:7">ilkaan hamootaa illee caccabsi.<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>Fayyinni kan <char style="nd">Waaqayyoo</char> ti.</para>
  <para style="q2" vid="PSA 3:8">Eebbi kee saba kee irra haa jiraatu.<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">Faarfannaa 4</para>
  <para style="ms1">Kadhannaa Galgalaa</para>
  <para style="d">Dura buʼaa Faarfattootaatiif. Faarfannaa Daawit kan Baganaadhaan Faarfatamu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>Yaa Waaqa qajeelumma kootii,</para>
  <para style="q2" vid="PSA 4:1">yommuu ani si waammadhutti deebii naa kenni.</para>
  <para style="q1" vid="PSA 4:1">Ati yeroo rakkina kootti na boqochiisi;</para>
  <para style="q2" vid="PSA 4:1">araara kee naa buusi; kadhaa koos dhagaʼi.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>Yaa ilmaan namootaa, isin hamma yoomiitti ulfina koo gara salphinaatti deebiftu?</para>
  <para style="q2" vid="PSA 4:2">Isin hamma yoomiitti waan faayidaa hin qabne jaallattanii soba barbaaddu?<verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>Isin akka <char style="nd">Waaqayyo</char> warra isaaf bulan ofii isaatiif addaan baafate beekaa;</para>
  <para style="q2" vid="PSA 4:3">
    <char style="nd">Waaqayyo</char> yommuu ani isa waammadhutti na dhagaʼa.<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Yeroo aartanitti cubbuu hin hojjetinaa;</para>
  <para style="q2" vid="PSA 4:4">yommuu siree keessan irra jirtanitti,</para>
  <para style="q2" vid="PSA 4:4">garaa keessan keessatti yaadaa; calʼisaas.<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>Aarsaa qajeelummaa dhiʼeessaa;</para>
  <para style="q2" vid="PSA 4:5">
    <char style="nd">Waaqayyonis</char> amanadhaa.<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>Namoonni, “Eenyutu waan gaarii nu argi argisiisa?” jedhan baayʼee dha;</para>
  <para style="q2" vid="PSA 4:6">yaa <char style="nd">Waaqayyo</char>, ifni fuula keetii nurratti haa ifu.<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Gammachuu isaan yeroo midhaanii fi daadhiin wayinii isaanii baayʼatutti argatan caalaa,</para>
  <para style="q2" vid="PSA 4:7">ati garaa koo gammachuu guddaadhaan guutteerta.<verse eid="PSA 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Ani nagaadhaan nan ciisa; nan rafas;</para>
  <para style="q2" vid="PSA 4:8">yaa <char style="nd">Waaqayyo</char> si qofatu,</para>
  <para style="q2" vid="PSA 4:8">sodaa malee na jiraachisaatii.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">Faarfannaa 5</para>
  <para style="ms1">Kadhannaa Ganamaa</para>
  <para style="d">Faarfannaa Daawitii kan ululleedhaan faarfatamu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>Yaa <char style="nd">Waaqayyo</char>, gurra kee dubbii kootti qabi;</para>
  <para style="q2" vid="PSA 5:1">aaduu koo illee naa hubadhu.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>Yaa mootii koo fi Waaqa ko,</para>
  <para style="q2" vid="PSA 5:2">iyya ani gargaarsaaf iyyadhu dhaggeeffadhu;</para>
  <para style="q2" vid="PSA 5:2">ani sin kadhadhaatii.<verse eid="PSA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>Yaa <char style="nd">Waaqayyo</char>, ganamaan sagalee koo ni dhageessa;</para>
  <para style="q2" vid="PSA 5:3">anis ganamaan kadhata koo fuula kee duratti nan dhiʼeessa;</para>
  <para style="q2" vid="PSA 5:3">abdiidhaanis nan eeggadha.<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>Ati Waaqa hamminatti gammadu miti;</para>
  <para style="q2" vid="PSA 5:4">hamaanis si wajjin hin jiraatu.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Of tuultonni fuula kee dura dhaabachuu hin dandaʼan.</para>
  <para style="q2" vid="PSA 5:5">Atis warra jalʼina hojjetan hunda ni jibbita;<verse eid="PSA 5:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 5:6"/>Ati warra soba dubbatan ni balleessita.</para>
  <para style="q1" vid="PSA 5:6">
    <char style="nd">Waaqayyo</char> warra dhiiga dheebotanii fi</para>
  <para style="q2" vid="PSA 5:6">warra nama gowwoomsan ni xireeffata.<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>Ani garuu araara kee baayʼee sanaan mana keetti ol nan gala;</para>
  <para style="q2" vid="PSA 5:7">si sodaachuudhaanis gad jedhee</para>
  <para style="q2" vid="PSA 5:7">gara mana qulqullummaa kee qulqulluu sanaatti garagalee nan sagada.<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>Yaa <char style="nd">Waaqayyo</char>, sababii diinota kootiif jedhiitii</para>
  <para style="q2" vid="PSA 5:8">qajeelummaa keetiin na dura buʼi;</para>
  <para style="q2" vid="PSA 5:8">karaa kees fuula koo duratti naa qajeelchi.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>Dubbiin afaan isaaniitii baʼu tokko iyyuu hin amanamu;</para>
  <para style="q2" vid="PSA 5:9">garaan isaanii badiisaan guutameera.</para>
  <para style="q1" vid="PSA 5:9">Laagaan isaanii awwaala banamaa dha;</para>
  <para style="q2" vid="PSA 5:9">arraba isaaniitiin ni sobu.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>Yaa Waaqayyo, yakkitoota taʼuu isaanii isaanitti beeksisi!</para>
  <para style="q2" vid="PSA 5:10">Daba isaaniitiinis haa kufan.</para>
  <para style="q1" vid="PSA 5:10">Baayʼina cubbuu isaaniitiin isaan balleessi;</para>
  <para style="q2" vid="PSA 5:10">isaan sitti fincilaniiruutii.<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>Warri kooluu sitti galan hundinuu garuu haa gammadan;</para>
  <para style="q2" vid="PSA 5:11">bara baraanis gammachuudhaan haa faarfatan.</para>
  <para style="q1" vid="PSA 5:11">Akka warri maqaa kee jaallatan sitti gammadaniif</para>
  <para style="q2" vid="PSA 5:11">ati eegumsa kee isaan irra diriirsi.<verse eid="PSA 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>Yaa <char style="nd">Waaqayyo</char>, ati qajeeltota ni eebbiftaatii;</para>
  <para style="q2" vid="PSA 5:12">akka gaachanaattis surraa keetiin isaan marsita.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">Faarfannaa 6</para>
  <para style="ms1">Kadhannaa Yeroo Dhiphinaa</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Baganaadhaan faarfatamu. Faarfannaa Daawit kan akka sirna <char style="tl">Shamiiniitiitti</char> faarfatamu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>Yaa <char style="nd">Waaqayyo</char> aarii keetiin na hin hifatin;</para>
  <para style="q2" vid="PSA 6:1">yookaan dheekkamsa keetiin na hin adabin.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Naa gameeraatii yaa <char style="nd">Waaqayyo</char> naaf araarami;</para>
  <para style="q2" vid="PSA 6:2">lafeen koos jeeqameeraatii yaa <char style="nd">Waaqayyo</char> na fayyisi.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Lubbuun koo akka malee jeeqameera;</para>
  <para style="q2" vid="PSA 6:3">kun hamma yoomiitti? Yaa <char style="nd">Waaqayyo</char>, hamma yoomiitti?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>Yaa <char style="nd">Waaqayyo</char>, deebiʼiitii lubbuu koo oolchi;</para>
  <para style="q2" vid="PSA 6:4">araara keetiif jedhiitii na fayyisi.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Namni duʼe si hin yaadatu.</para>
  <para style="q2" vid="PSA 6:5">Siiʼool keessatti eenyutu si galateeffata?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Ani aaduu kootiin bututeera.</para>
  <para style="b" vid="PSA 6:6"/>
  <para style="q1" vid="PSA 6:6">Halkan hunda booʼichaan siree koo nan dhiqa;</para>
  <para style="q2" vid="PSA 6:6">imimmaaniinis iddoo ciisichaa koo nan tortorsa.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Iji koo gaddaan fajajeera;</para>
  <para style="q2" vid="PSA 6:7">sababii diinota koo hundaatiifis dadhabeera.<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Warri hamaa hojjettan hundinuu narraa fagaadhaa;</para>
  <para style="q2" vid="PSA 6:8">
    <char style="nd">Waaqayyo</char> sagalee booʼicha koo dhagaʼeeraatii.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>
    <char style="nd">Waaqayyo</char> waammata koo dhagaʼeera;</para>
  <para style="q2" vid="PSA 6:9">
    <char style="nd">Waaqayyo</char> kadhannaa koo ni fudhata.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Diinonni koo hundinuu haa qaanaʼan; akka malees haa rifatan;</para>
  <para style="q2" vid="PSA 6:10">qaanii tasaatiinis of irra haa garagalan.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">Faarfannaa 7</para>
  <para style="ms1">Kadhannaa Namni Qajeelaan Kadhatu</para>
  <para style="d">
    <char style="tl">Shiigaayoonni</char> Daawit kan inni waaʼee Kuushi namicha gosa Beniyaamiif jedhee <char style="nd">Waaqayyoof</char> faarfate.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>Yaa <char style="nd">Waaqayyo</char> Waaqa ko, ani kooluu sitti nan gala;</para>
  <para style="q2" vid="PSA 7:1">warra na ariʼatan hunda jalaa na baasi; na oolchis;<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>yoo kanaa achii isaan yeroo namni na oolchu hin jirretti,</para>
  <para style="q2" vid="PSA 7:2">akka leencaa na cicciratu; na kukkutatus.<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>Yaa <char style="nd">Waaqayyo</char> Waaqa ko, yoo ani waan kana godhee jiraadhe</para>
  <para style="q2" vid="PSA 7:3">yoo harka koo keessa yakki jiraate,<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>yoo ani nama nagaadhaan na wajjin jiraatutti hamaa hojjedhee jiraadhe,</para>
  <para style="q2" vid="PSA 7:4">yookaan yoo ani sababii malee diina koo saamee jiraadhe,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>diinni koo ariʼee na haa qabatu;</para>
  <para style="q2" vid="PSA 7:5">jireenya koo lafatti haa dhidhiitu;</para>
  <para style="q2" vid="PSA 7:5">ulfina koos awwaara keessa haa buusu.<verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>Yaa <char style="nd">Waaqayyo</char> aarii keetiin kaʼi;</para>
  <para style="q2" vid="PSA 7:6">dheekkamsa diinota kootti kaʼi.</para>
  <para style="q2" vid="PSA 7:6">Yaa Waaqa koo anaaf dammaqi; murtii qajeelaa labsi.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>Yaaʼiin namootaa naannoo keetti walitti haa qabamu;</para>
  <para style="q2" vid="PSA 7:7">atis ol gubbaadhaa isaan bulchi.<verse eid="PSA 7:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8"/>
    <char style="nd">Waaqayyo</char> sabootaaf murtii haa kennu.</para>
  <para style="q1" vid="PSA 7:8">Yaa <char style="nd">Waaqayyo</char>, akka qajeelummaa kootiitti,</para>
  <para style="q2" vid="PSA 7:8">akka amanamummaa kootiittis naa murteessi.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>Yaa Waaqa qajeelaa,</para>
  <para style="q2" vid="PSA 7:9">kan yaadaa fi garaa namaa qortu,</para>
  <para style="q1" vid="PSA 7:9">fincila hamootaa balleessi;</para>
  <para style="q2" vid="PSA 7:9">qajeeltota immoo jabeessii dhaabi.<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>Gaachanni koo Waaqa;</para>
  <para style="q2" vid="PSA 7:10">inni gara toleeyyii ni oolcha.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Waaqni abbaa murtii qajeelaa dha;</para>
  <para style="q2" vid="PSA 7:11">inni Waaqa guyyaa hunda dheekkamsa isaa mulʼisuu dha.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Yoo namni qalbii jijjiirrachuu baate,</para>
  <para style="q2" vid="PSA 7:12">inni goraadee isaa ni qarata;</para>
  <para style="q2" vid="PSA 7:12">iddaa isaas dabsee qopheeffata.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>Inni meeshaa nama ajjeesu</para>
  <para style="q2" vid="PSA 7:13">qopheeffateera; xiyya bobaʼus ni qopheeffata.<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Kunoo, namni hamaan hammina ulfaaʼa;</para>
  <para style="q2" vid="PSA 7:14">jalʼina garaatti baata; soba dhala.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Inni gad fageessee boolla qota;</para>
  <para style="q2" vid="PSA 7:15">boolla qopheesse sana keessas ni buʼa.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>Dabni isaa matuma isaatti deebiʼa;</para>
  <para style="q2" vid="PSA 7:16">jalʼinni isaas gubbee mataa isaa irra buʼa.<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Qajeelummaa isaatiif <char style="nd">Waaqayyoon</char> nan galateeffadha;</para>
  <para style="q2" vid="PSA 7:17">maqaa <char style="nd">Waaqayyoo</char> Waaqa Waan Hundaa Oliis faarfannaadhaan nan jajadha.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">Faarfannaa 8</para>
  <para style="ms1">Ulfina Waaqayyoo</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit kan <char style="tl">Gitiitiidhaan</char> faarfatamu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>Yaa <char style="nd">Waaqayyo</char> Gooftaa keenya,</para>
  <para style="q2" vid="PSA 8:1">maqaan kee lafa hundatti akkam ulfina qabeessa!</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">Ati ulfina kee</para>
  <para style="q2" vid="PSA 8:1">samiiwwan irratti diriirsiteerta.<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>Sababii diinota keetiitiif, amajaajii fi nama haaloo baafatu</para>
  <para style="q2" vid="PSA 8:2">afaan qabachiisuuf jettee, afaan daaʼimmaniitii fi</para>
  <para style="q2" vid="PSA 8:2">mucoolii harma hodhanii irraa galata qopheessiteerta.<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Yommuu ani hojii quba keetii,</para>
  <para style="q2" vid="PSA 8:3">samiiwwan kee,</para>
  <para style="q2" vid="PSA 8:3">jiʼaa fi urjiiwwan ati hundeessitee ilaalutti,<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>akka ati isaaf yaadduuf namni maali?</para>
  <para style="q2" vid="PSA 8:4">Akka isaaf dhimmituuf ilmi namaa maali?<verse eid="PSA 8:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Ati xinnoo ishee ofii keetii gad isa goote;</para>
  <para style="q2" vid="PSA 8:5">ulfinaa fi kabajaan isa gonfite.<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Hojii harka keetii irratti bulchaa isa goote;</para>
  <para style="q2" vid="PSA 8:6">waan hundas miilla isaa jala galchite;<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>bushaayee fi loon hunda,</para>
  <para style="q2" vid="PSA 8:7">bineensota bosonaas,<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>simbirroota samii irraa, qurxummii galaanaa,</para>
  <para style="q2" vid="PSA 8:8">waan daandii galaanaatiin darbu</para>
  <para style="q2" vid="PSA 8:8">hundas miilla isaa jala galchite.<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>Yaa <char style="nd">Waaqayyo</char> Gooftaa keenya,</para>
  <para style="q2" vid="PSA 8:9">maqaan kee lafa hundumaa irratti akkam ulfina qabeessa!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">Faarfannaa 9</para>
  <para style="ms1">Murtii Waaqayyoo</para>
  <para style="d">Dura buʼaa faarfattootaatiif; Yeedaloo, “Duʼa ilmaa” jedhamu. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>Yaa <char style="nd">Waaqayyo</char>, ani garaa koo guutuudhaan sin galateeffadha;</para>
  <para style="q2" vid="PSA 9:1">waaʼee dinqii kee hundumaas nan odeessa.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Ani sittin gammada; nan ililchas;</para>
  <para style="q2" vid="PSA 9:2">yaa Waaqa Waan Hundaa Olii, faarfannaadhaan maqaa kee nan jajadha.<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Diinonni koo dugda duubatti ni deebiʼu;</para>
  <para style="q2" vid="PSA 9:3">ni gufatu; fuula kee duraas ni badu.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Mirga koo fi dhimma koo qabatteerta;</para>
  <para style="q2" vid="PSA 9:4">atis murtii qajeelaa kennaa teessoo kee irra teesseerta.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Saboota ifattee hamootas balleessiteerta;</para>
  <para style="q2" vid="PSA 9:5">maqaa isaaniis baraa hamma bara baraatti haqxeerta.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Diinonni badiisa bara baraatiin balleeffamu;</para>
  <para style="q2" vid="PSA 9:6">ati magaalaawwan isaanii bubuqqifteerta;</para>
  <para style="q2" vid="PSA 9:6">seenaan isaaniis barbadeeffameera.<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>
    <char style="nd">Waaqayyo</char> garuu bara baraan ni moʼa;</para>
  <para style="q2" vid="PSA 9:7">teessoo isaas murtiidhaaf dhaabbateera.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Inni qajeelummaadhaan addunyaadhaaf murtii ni kenna;</para>
  <para style="q2" vid="PSA 9:8">sabootas murtii qajeelaadhaan bulcha.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>
    <char style="nd">Waaqayyo</char> warra cunqurfamaniif irkoo dha;</para>
  <para style="q2" vid="PSA 9:9">yeroo rakkinaattis daʼoo dha.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Warri maqaa kee beekan si amanatu;</para>
  <para style="q2" vid="PSA 9:10">yaa <char style="nd">Waaqayyo</char>, ati warra si barbaadan gattee hin beektuutii.<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>
    <char style="nd">Waaqayyo</char> isa Xiyoon irra jiraatu faarfannaadhaan jajadhaa;</para>
  <para style="q2" vid="PSA 9:11">hojii isaa illee saboota keessatti labsaa.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Inni haaloo dhiigaa baasu sunis isaan yaadataatii;</para>
  <para style="q2" vid="PSA 9:12">iyya warra dhiphataniis hin irraanfatu.<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>Yaa <char style="nd">Waaqayyo</char>, hammam akka diinonni koo na ariʼatan ilaali!</para>
  <para style="q2" vid="PSA 9:13">Naaf araaramiitii afaan boolla duʼaa keessaa na baasi;<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>kunis ani karra Intala Xiyoon irratti</para>
  <para style="q2" vid="PSA 9:14">akka galata kee labsuu fi fayyisuu keettis</para>
  <para style="q2" vid="PSA 9:14">baayʼisee gammaduuf.<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>Saboonni boolla qotan keessa buʼan;</para>
  <para style="q2" vid="PSA 9:15">miilli isaaniis kiyyoodhuma isaan dhoksaniin qabame.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>
    <char style="nd">Waaqayyo</char> murtii qajeelaa kennuudhaan beekama;</para>
  <para style="q2" vid="PSA 9:16">hamoonni garuu hojii harka isaaniitiin kiyyoo seenu.<verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>Namoonni hamoon,</para>
  <para style="q2" vid="PSA 9:17">warri Waaqa irraanfatan hundinuus siiʼoolitti gad buʼu.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>Rakkattoonni garuu yoom iyyuu hin irraanfataman;</para>
  <para style="q2" vid="PSA 9:18">abdiin hiyyeeyyiis bara baraan hin badu.<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>Yaa <char style="nd">Waaqayyo</char> kaʼi; jabinni namaa hin mulʼatin;</para>
  <para style="q2" vid="PSA 9:19">fuula kee duratti sabootatti haa muramu.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>Yaa <char style="nd">Waaqayyo</char>, sodaa isaanitti buusi;</para>
  <para style="q2" vid="PSA 9:20">saboonnis akka namuma taʼan haa beekan.<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">Faarfannaa 10</para>
  <para style="ms1">Murtii Qajeelaa Argachuuf Waaqa Kadhachuu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>Yaa <char style="nd">Waaqayyo</char>, ati maaliif achi fagaattee dhaabatta?</para>
  <para style="q2" vid="PSA 10:1">Yeroo rakkinaattis maaliif of dhoksita?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Namni hamaan of tuulummaa isaatiin hiyyeessa adamsa;</para>
  <para style="q2" vid="PSA 10:2">inni maluma malatuun haa qabamu.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Namni hamaan hawwii isaatiin of jaja; ofittoo ni eebbisa;</para>
  <para style="q2" vid="PSA 10:3">
    <char style="nd">Waaqayyoon</char> immoo ni arrabsa.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Namni hamaan sababii of tuuluuf Waaqa hin barbaadu;</para>
  <para style="q2" vid="PSA 10:4">yaada isaa hundumaa keessas Waaqni hin jiru.<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Karaan isaa yeroo hunda ni milkaaʼaaf; inni of tuula;</para>
  <para style="q2" vid="PSA 10:5">seerri kees isa irraa fagoo dha;</para>
  <para style="q2" vid="PSA 10:5">diinota isaa hundattis tuffiidhaan qummaada.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Innis, “Wanni na sochoosu hin jiru;</para>
  <para style="q2" vid="PSA 10:6">rakkinnis gonkumaa na hin argatu” ofiin jedha.<verse eid="PSA 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>Afaan isaa abaarsaan, sobaa fi doorsisaan guutameera;</para>
  <para style="q2" vid="PSA 10:7">dabaa fi hamminni arraba isaa jala jiru.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Inni gandoota keessatti riphee eeggata;</para>
  <para style="q2" vid="PSA 10:8">iddoo dhokataattis warra yakka hin qabne ajjeesa.</para>
  <para style="q1" vid="PSA 10:8">Ija isaatiinis hiyyeeyyii gaada.<verse eid="PSA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 10:9"/>Akka leenca daggala isaa keessaatti riphee eeggata.</para>
  <para style="q1" vid="PSA 10:9">Hiyyeessa qabachuudhaaf dhokatee eeggata;</para>
  <para style="q2" vid="PSA 10:9">hiyyeessas qabatee kiyyoo isaatiin harkifata.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Hiyyeessi sunis ni caccaba; gad of qabas;</para>
  <para style="q2" vid="PSA 10:10">humna nama hamaa jalattis ni kufa.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>Innis, “Waaqa irraanfateera;</para>
  <para style="q2" vid="PSA 10:11">fuula isaas dhokfateera; gonkumaa hin argu” ofiin jedha.<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>Yaa <char style="nd">Waaqayyo</char> kaʼi! Yaa Waaqi harka kee ol kaafadhu.</para>
  <para style="q2" vid="PSA 10:12">Rakkataas hin dagatin.<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Namni hamaan maaliif Waaqa arrabsa?</para>
  <para style="q2" vid="PSA 10:13">Maaliifis garaa isaatti,</para>
  <para style="q2" vid="PSA 10:13">“Inni waan kanatti na hin gaafatu” jedha?<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>Yaa Waaqi, ati garuu rakkinaa fi gadda warra miidhamanii ni argita;</para>
  <para style="q2" vid="PSA 10:14">harka keetiinis gatii baasifta.</para>
  <para style="q1" vid="PSA 10:14">Deegaan dabarsee sitti of kenna;</para>
  <para style="q2" vid="PSA 10:14">ati ijoollee abbaa hin qabneef gargaaraa dha.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>Irree nama hamaatii fi jalʼaa cabsi;</para>
  <para style="q2" vid="PSA 10:15">hamma hamminni isaa dhumee dhabamutti,</para>
  <para style="q2" vid="PSA 10:15">hammina isaatti isa gaafadhu.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>
    <char style="nd">Waaqayyo</char> bara baraa hamma bara baraatti Mootii dha;</para>
  <para style="q2" vid="PSA 10:16">ormoonni lafa isaa irraa ni barbadaaʼu.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>Yaa <char style="nd">Waaqayyo</char>, ati hawwii rakkattootaa ni dhageessa;</para>
  <para style="q2" vid="PSA 10:17">isaan jajjabeessita; iyya isaanii illee ni dhaggeeffatta;<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>kunis akka namni biyyoo irraa uumame siʼachi isaan hin cunqursineef</para>
  <para style="q2" vid="PSA 10:18">ati ijoollee abbaa hin qabnee fi</para>
  <para style="q2" vid="PSA 10:18">cunqurfamtootaaf akka dhaabattuuf.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">Faarfannaa 11</para>
  <para style="ms1">Waaqa Amanachuu</para>
  <para style="d">Dura buʼaa Faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>Ani <char style="nd">Waaqayyotti</char> kooluu galeera.</para>
  <para style="q2" vid="PSA 11:1">Yoos isin akkamitti lubbuu kootiin akkana jechuu dandeessu:</para>
  <para style="q2" vid="PSA 11:1">“Ati akkuma simbirroo tulluu keetti barrisi.<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Kunoo namoonni hamoon iddaa isaanii dabsataniiru;</para>
  <para style="q2" vid="PSA 11:2">isaan warra toloota taʼan,</para>
  <para style="q1" vid="PSA 11:2">dukkana keessa waraanuuf jedhanii,</para>
  <para style="q2" vid="PSA 11:2">xiyya isaanii ribuutti dhaabbataniiru.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Yoo hundeewwan diigaman, namni qajeelaan</para>
  <para style="q2" vid="PSA 11:3">maal gochuu dandaʼa?”<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>
    <char style="nd">Waaqayyo</char> mana qulqullummaa isaa qulqulluu sana keessa jira;</para>
  <para style="q2" vid="PSA 11:4">teessoon <char style="nd">Waaqayyoo</char> samii irra jira.</para>
  <para style="q1" vid="PSA 11:4">Inni ilmaan namootaa ni ilaala;</para>
  <para style="q2" vid="PSA 11:4">iji isaas namoota ni qora.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>
    <char style="nd">Waaqayyo</char> qajeeltotaa fi jalʼoota ni qora;</para>
  <para style="q2" vid="PSA 11:5">lubbuun isaa garuu nama goolii jaallatu ni jibbiti.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Inni hamoota irratti, barbadaa ibiddaatii fi</para>
  <para style="q2" vid="PSA 11:6">dinyii bobaʼu ni roobsa;</para>
  <para style="q2" vid="PSA 11:6">qoodni isaaniis bubbee finiinaa dha.<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>
    <char style="nd">Waaqayyo</char> waan qajeelaa taʼeef,</para>
  <para style="q2" vid="PSA 11:7">murtii qajeelaa jaallata;</para>
  <para style="q2" vid="PSA 11:7">toloonnis fuula isaa ni argu.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">Faarfannaa 12</para>
  <para style="ms1">Kadhannaa Gargaarsa Barbaachaaf Kadhatame</para>
  <para style="d">Dura buʼaa Faarfattootaatiif. Faarfannaa Daawit kan akka sirna <char style="tl">Shamiiniitiitti</char> faarfatamu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>Yaa <char style="nd">Waaqayyo</char>, namni Waaqa sodaatu hin jiruutii ati na gargaar;</para>
  <para style="q2" vid="PSA 12:1">ilmaan namaa keessaas namni amanamu dhabameeraatii.<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>Namni hundinuu ollaa isaatti soba dubbata;</para>
  <para style="q2" vid="PSA 12:2">isaan nama saadanii garaa lamaan dubbatu.<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>
    <char style="nd">Waaqayyo</char> afaan nama saadu hunda,</para>
  <para style="q2" vid="PSA 12:3">arraba of tuulu hundas haa kukkutu;<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>isaanis, “Nu arraba keenyaan ni moona;</para>
  <para style="q2" vid="PSA 12:4">hidhiin keenyas keenyuma;</para>
  <para style="q2" vid="PSA 12:4">eenyutu nurratti gooftummaa qaba?” jedhu.<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>
    <char style="nd">Waaqayyo</char>, “Ani sababii hacuucamuu hiyyeeyyiitiif,</para>
  <para style="q2" vid="PSA 12:5">sababii aaduu rakkattootaatiifis amma nan kaʼa.</para>
  <para style="q2" vid="PSA 12:5">Nagaa isaan hawwan keessas isaan nan jiraachisa” jedha.<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>Dubbiin <char style="nd">Waaqayyoo</char> hirʼina hin qabu;</para>
  <para style="q2" vid="PSA 12:6">innis akka meetii boolla ibiddaa keessatti baqfamee</para>
  <para style="q2" vid="PSA 12:6">yeroo torba qulqulleeffamee ti.<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>Yaa <char style="nd">Waaqayyo</char> ati nu eegda;</para>
  <para style="q2" vid="PSA 12:7">dhaloota akkanaa irraas bara baraan nu oolchita.<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>Yeroo wanni faayidaa hin qabne ilmaan namaa gidduutti kabajamutti</para>
  <para style="q2" vid="PSA 12:8">hamoonni of dhiibuudhaan kallattii hundaan asii fi achi naannaʼu.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">Faarfannaa 13</para>
  <para style="ms1">Iyyata Nama Waaqa Amanatee</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>Yaa <char style="nd">Waaqayyo</char>, hamma yoomiitti?</para>
  <para style="q2" vid="PSA 13:1">Ati hamma bara baraatti na irraanfattaa?</para>
  <para style="q2" vid="PSA 13:1">Hamma yoomiittis fuula kee na duraa dhoksita?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Ani hamma yoomiittin rakkina obsee</para>
  <para style="q2" vid="PSA 13:2">guyyaa guutuu garaa koo keessatti gadda?</para>
  <para style="q2" vid="PSA 13:2">Hamma yoomiitti diinni koo narra aana?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>Yaa <char style="nd">Waaqayyo</char> Waaqa ko, na ilaali; deebii illee naa kenni.</para>
  <para style="q2" vid="PSA 13:3">Akka ani hirriba duʼaa hin rafneefis ija kootiif ifa kenni;<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>diinni koo, “Ani isa moʼadheera” jedha;</para>
  <para style="q2" vid="PSA 13:4">amajaajiiwwan koos kufaatii kootti gammadu.<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Ani garuu araara kee nan amanadha;</para>
  <para style="q2" vid="PSA 13:5">garaan koos fayyisuu keetti ni gammada.<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>Ani <char style="nd">Waaqayyoof</char> nan faarfadha;</para>
  <para style="q2" vid="PSA 13:6">arjummaan isaa naa baayʼateeraatii.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">Faarfannaa 14</para>
  <para style="ms1">Namoota Waaqaaf Hin Bulle</para>
  <para style="mr">
    <ref loc="PSA 14:1-7">14:1‑7</ref> kwf – <char style="xt"><ref loc="PSA 53:1-6">Far 53:1‑6</ref></char></para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>Gowwaan garaa isaatti,</para>
  <para style="q2" vid="PSA 14:1">“Waaqni hin jiru” jedha.</para>
  <para style="q1" vid="PSA 14:1">Isaan xuraaʼaniiru; hojiin isaaniis jibbisiisaa dha;</para>
  <para style="q2" vid="PSA 14:1">namni waan gaarii hojjetu tokko iyyuu hin jiru.<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>
    <char style="nd">Waaqayyo</char> yoo namni waa hubatu,</para>
  <para style="q2" vid="PSA 14:2">kan Waaqas barbaadu, tokko iyyuu jiraate arguuf jedhee,</para>
  <para style="q2" vid="PSA 14:2">samii irraa ilmaan namootaa gad ilaala.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Hundinuu dogoggoraniiru; hundi isaaniis xuraaʼaniiru;</para>
  <para style="q2" vid="PSA 14:3">namni waan gaarii hojjetu tokko hin jiru;</para>
  <para style="q2" vid="PSA 14:3">tokkumti iyyuu hin jiru.<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Warri hammina hojjetan</para>
  <para style="q2" vid="PSA 14:4">kanneen akkuma waan buddeena nyaataniitti saba koo nyaatan,</para>
  <para style="q2" vid="PSA 14:4">warri <char style="nd">Waaqayyoon</char> hin waammanne hundinuu homaa hin beekanii?<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>Isaan sodaadhaan liqimfamaniiru;</para>
  <para style="q2" vid="PSA 14:5">Waaqni dhaloota qajeeltotaa wajjin jiraatii.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Isin jalʼoonni karoora hiyyeeyyii jalaa fashaleessitu;</para>
  <para style="q2" vid="PSA 14:6">
    <char style="nd">Waaqayyo</char> garuu daʼoo isaanii ti.<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>Maaloo utuu Xiyoon keessaa fayyinni Israaʼeliif dhufee!</para>
  <para style="q2" vid="PSA 14:7">Yommuu <char style="nd">Waaqayyo</char> saba isaa warra boojiʼaman deebisutti,</para>
  <para style="q2" vid="PSA 14:7">Yaaqoob haa ililchu; Israaʼelis haa gammadu!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">Faarfannaa 15</para>
  <para style="ms1">Nama Akkamiitu Mana Waaqaa Keessa Jiraachuu Dandaʼa?</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>Yaa <char style="nd">Waaqayyo</char>, eenyutu dunkaana kee keessa jiraata?</para>
  <para style="q2" vid="PSA 15:1">Eenyutu tulluu kee qulqulluu sana irra jiraachuu dandaʼa?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Nama adeemsi isaa mudaa hin qabnee fi</para>
  <para style="q2" vid="PSA 15:2">nama waan qajeelaa hojjetu,</para>
  <para style="q2" vid="PSA 15:2">nama garaa isaatii dhugaa dubbatuu fi<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>kan arraba isaatiin nama hin hamanne,</para>
  <para style="q2" vid="PSA 15:3">nama ollaa isaatti waan hamaa hin hojjennee fi</para>
  <para style="q2" vid="PSA 15:3">nama ollaa isaa maqaa hin balleessine,<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>kan nama hamaa tuffatee warra <char style="nd">Waaqayyoon</char> sodaatan garuu kabaju,</para>
  <para style="q2" vid="PSA 15:4">yoo waan isa miidhu taʼe illee nama kakuu isaa eegu,<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>nama maallaqa isaa hiiqiidhaan hin liqeessinee fi</para>
  <para style="q2" vid="PSA 15:5">kan nama yakka hin qabne miidhuuf jedhee mattaʼaa hin fudhannee dha.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">Namni wantoota kanneen hojjetu,</para>
  <para style="q2" vid="PSA 15:5">gonkumaa hin raafamu.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">Faarfannaa 16</para>
  <para style="ms1">Waaqayyo Dhaala Koo ti</para>
  <para style="d">
    <char style="tl">Miiktaamii</char> Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>Yaa Waaqi, ani kooluu sitti galeeraatii,</para>
  <para style="q2" vid="PSA 16:1">ati na eegi.<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Anis <char style="nd">Waaqayyoon</char>, “Ati Gooftaa koo ti;</para>
  <para style="q2" vid="PSA 16:2">ani si malee gaarummaa hin qabu” nan jedha.<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>Qulqulloonni lafa irraa garuu ulfina qabeeyyii dha;</para>
  <para style="q2" vid="PSA 16:3">anis isaanitti baayʼee nan gammada.<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Warra waaqota tolfamoo duukaa buʼan,</para>
  <para style="q2" vid="PSA 16:4">gaddi isaanii ni guddata.</para>
  <para style="q1" vid="PSA 16:4">Dhibaayyuu dhiigaa ani isaaniif hin dhibaafadhu;</para>
  <para style="q2" vid="PSA 16:4">yookaan afaan kootiin maqaa isaanii hin dhaʼu.<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>
    <char style="nd">Waaqayyo</char> qooda dhaala kootii fi qooda xoofoo koo ti;</para>
  <para style="q2" vid="PSA 16:5">ixaa koos situ naa jiraachisa.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>Funyoon daangaa iddoo gaarii naa buʼeera;</para>
  <para style="q2" vid="PSA 16:6">dhugumaan ani dhaala nama gammachiisu qaba.<verse eid="PSA 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>
    <char style="nd">Waaqayyo</char> isa na gorsu sana ani nan jajadha;</para>
  <para style="q2" vid="PSA 16:7">halkanis yaadni koo na qajeelcha.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>Ani yeroo hunda fuula koo duraa <char style="nd">Waaqayyoon</char> qaba.</para>
  <para style="q2" vid="PSA 16:8">Waan inni mirga koo jiruuf ani hin raafamu.<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Kanaaf garaan koo ni gammada; arrabni koos ni ililcha;</para>
  <para style="q2" vid="PSA 16:9">foon koos nagaadhaan jiraata;<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>ati siiʼool keessatti na hin dhiiftuutii,</para>
  <para style="q2" vid="PSA 16:10">yookaan amanamaan kee akka tortoru hin gootu.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Ati karaa jireenyaa na barsiifta; fuula kee durattis</para>
  <para style="q2" vid="PSA 16:11">gammachuudhaan na guutta;</para>
  <para style="q2" vid="PSA 16:11">gara mirga keetii gammachuu bara baraatu jira.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">Faarfannaa 17</para>
  <para style="ms1">Iyyata Nama Qajeelaa</para>
  <para style="d">Kadhannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>Yaa <char style="nd">Waaqayyo</char>, iyyata ani murtii qajeelaaf iyyadhu dhagaʼi;</para>
  <para style="q2" vid="PSA 17:1">booʼicha koos dhaggeeffadhu.</para>
  <para style="q1" vid="PSA 17:1">Kadhannaa koo kan afaan nama hin gowwoomsine</para>
  <para style="q2" vid="PSA 17:1">keessaa baʼuufis gurra kenni.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Murtiin koo si biraa haa dhufu;</para>
  <para style="q2" vid="PSA 17:2">iji kees waan qajeelaa haa argu.<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Ati yoo garaa koo qorte, halkaniinis yoo na ilaalte,</para>
  <para style="q2" vid="PSA 17:3">yoo na sakattaates, homaa narratti hin argattu;</para>
  <para style="q2" vid="PSA 17:3">ani akka afaan koo cubbuu hin hojjenneef kutadheeraatii.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Waaʼee hojii namootaa immoo ani dubbii afaan keetiitiin</para>
  <para style="q2" vid="PSA 17:4">karaa gooltotaa irraa of eeggadheera.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Tarkaanfiin koo karaa kee irratti cimeera;</para>
  <para style="q2" vid="PSA 17:5">miilli koos hin mucucaanne.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Yaa Waaqi, waan ati deebii naa kennituuf ani sin waammadha;</para>
  <para style="q2" vid="PSA 17:6">gurra kee gara kootti qabiitii kadhannaa koo dhagaʼi.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Yaa isa warra diinota isaanii jalaa sitti baqatan</para>
  <para style="q2" vid="PSA 17:7">harka kee mirgaatiin oolchitu,</para>
  <para style="q2" vid="PSA 17:7">ati jaalala kee isa hin geeddaramne sana haala dinqisiisaadhaan argisiisi.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Akka agartuu ija keetiitti na eegi;</para>
  <para style="q2" vid="PSA 17:8">gaaddidduu qoochoo keetiitiinis na dhoksi;<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>hamoota na dhiphisan jalaa,</para>
  <para style="q2" vid="PSA 17:9">diinota na ajjeesuuf na marsan jalaa na baasi.<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Isaan garaa isaanii kan namaa hin naane sana ni guduunfu;</para>
  <para style="q2" vid="PSA 17:10">afaan isaaniis of tuulummaadhaan dubbata.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Isaan faana na dhaʼu; ammas na marsaniiru;</para>
  <para style="q2" vid="PSA 17:11">lafaan na dhaʼuudhaafis ija babaasu.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Isaan akka leenca waa kukkutachuu kajeeluu ti;</para>
  <para style="q2" vid="PSA 17:12">akka leenca guddaa riphee waa gaaduu ti.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>Yaa <char style="nd">Waaqayyo</char> kaʼi; itti baʼiitii isaan kuffisi;</para>
  <para style="q2" vid="PSA 17:13">goraadee keetiinis hamoota jalaa na baasi.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>Yaa <char style="nd">Waaqayyo</char>, namoota akkanaa jalaa,</para>
  <para style="q2" vid="PSA 17:14">namoota addunyaa kanaa warra qoodni isaanii jireenyuma ammaa taʼe jalaa <optbreak/> harka keetiin na baraari.</para>
  <para style="q1" vid="PSA 17:14">Garaan isaanii waan ati isaaniif kuufte haa quufu;</para>
  <para style="q2" vid="PSA 17:14">ijoolleen isaaniis akka malee haa quufan;</para>
  <para style="q2" vid="PSA 17:14">isaanis waan isaan irraa hafe daaʼimman isaaniitiif haa kaaʼan.<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Ani garuu qajeelummaadhaan fuula kee nan arga;</para>
  <para style="q2" vid="PSA 17:15">yommuun dammaquttis ani ulfina kee arguudhaan nan quufa.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">Faarfannaa 18</para>
  <para style="ms1">Faarfannaa Moʼannaa</para>
  <para style="mr">
    <ref loc="PSA 18:1-50">18:1‑50</ref> kwf – <char style="xt"><ref loc="2SA 22:1-51">2Sm 22:1‑51</ref></char></para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit garbicha <char style="nd">Waaqayyoo</char>; innis yommuu <char style="nd">Waaqayyo</char> harka diinota isaa hundaa fi harka Saaʼol jalaa isa baasetti dubbii faarfannaa kana <char style="nd">Waaqayyoof</char> faarfate. Innis akkana jedhe:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>Yaa <char style="nd">Waaqayyo</char> jabina ko, ani sin jaalladha.<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>
    <char style="nd">Waaqayyo</char> kattaa koo, daʼannoo kootii fi oolchaa koo ti;</para>
  <para style="q2" vid="PSA 18:2">Waaqni koo kattaa koo kan ani kooluu itti galuu dha;</para>
  <para style="q2" vid="PSA 18:2">inni gaachana kootii fi gaanfa fayyina koo ti; daʼannoo koo cimaa dha.<verse eid="PSA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>Ani <char style="nd">Waaqayyo</char> galanni isaaf malu sana nan waammadha;</para>
  <para style="q2" vid="PSA 18:3">diinota koo jalaas nan baraarama.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>Funyoon duʼaa na xaxe;</para>
  <para style="q2" vid="PSA 18:4">lolaan badiisaas na liqimseera.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Funyoon siiʼool natti marame;</para>
  <para style="q2" vid="PSA 18:5">kiyyoon duʼaas natti dhufe.<verse eid="PSA 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>Ani dhiphina koo keessatti <char style="nd">Waaqayyoon</char> nan waammadhe;</para>
  <para style="q2" vid="PSA 18:6">gargaarsaafis Waaqa kootti nan iyyadhe.</para>
  <para style="q1" vid="PSA 18:6">Innis mana qulqullummaa isaatii sagalee koo dhagaʼe;</para>
  <para style="q2" vid="PSA 18:6">iyyi koos gurra isaa seene.<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>Lafti ni hollatte; ni sochootes;</para>
  <para style="q2" vid="PSA 18:7">hundeewwan tulluuwwaniis ni raafaman;</para>
  <para style="q2" vid="PSA 18:7">sababii inni dheekkameefis isaan ni hollatan.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Aarri funyaan isaatii ol baʼe;</para>
  <para style="q2" vid="PSA 18:8">ibiddi waa barbadeessu afaan isaatii baʼe;</para>
  <para style="q2" vid="PSA 18:8">cileen bobaʼus afaan isaatii baʼe.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Inni samiiwwan tarsaasee gad buʼe;</para>
  <para style="q2" vid="PSA 18:9">duumessoonni gurraachis miilla isaa jala turan.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Inni kiirubeelin yaabbatee barrise;</para>
  <para style="q2" vid="PSA 18:10">qoochoo qilleensaatiinis ol baʼe.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Inni dukkana haguuggii isaa, duumessa samii kan</para>
  <para style="q2" vid="PSA 18:11">bokkaadhaan dukkanaaʼe immoo godoo isaa godhate.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Ifa fuula isaa keessaas duumessi dhagaa cabbiitii fi</para>
  <para style="q2" vid="PSA 18:12">bakakkaadhaan tarsaasee baʼe.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>
    <char style="nd">Waaqayyo</char> samiidhaa ni qaqawweessaʼe;</para>
  <para style="q2" vid="PSA 18:13">sagaleen Waaqa Waan Hundaa Oliis ni dhagaʼame.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>Inni xiyya isaa darbatee diinota bittinneesse;</para>
  <para style="q2" vid="PSA 18:14">bakakkaas gad dhiisee isaan fixe.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Yaa <char style="nd">Waaqayyo</char>, dheekkamsa keetiin,</para>
  <para style="q2" vid="PSA 18:15">humna hafuura funyaan keetii baʼuutiinis,</para>
  <para style="q1" vid="PSA 18:15">sululawwan galaanaa ifatti baafaman;</para>
  <para style="q2" vid="PSA 18:15">hundeewwan lafaas qullaa hafan.<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Inni ol gubbaadhaa gad hiixatee na qabe;</para>
  <para style="q2" vid="PSA 18:16">bishaanota gad fagoo keessaas na baase.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>Inni diina koo isa jabaa jalaa, amajaajota koo</para>
  <para style="q2" vid="PSA 18:17">warra akka malee natti ciman jalaas na baase.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Isaan guyyaa rakkina kootti natti dhufan;</para>
  <para style="q2" vid="PSA 18:18">
    <char style="nd">Waaqayyo</char> garuu gargaarsa koo ture.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>Inni iddoo balʼaatti na baase;</para>
  <para style="q2" vid="PSA 18:19">waan natti gammadeefis na oolche.<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>
    <char style="nd">Waaqayyo</char> akkuma qajeelummaa kootiitti naa kenneera;</para>
  <para style="q2" vid="PSA 18:20">akkuma qulqullina harka koottis na badhaase.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>Ani karaa <char style="nd">Waaqayyoo</char> eegeeraatii;</para>
  <para style="q2" vid="PSA 18:21">Waaqa koo irraa garagalee hammina hin hojjenne.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>Seerri isaa hundinuu fuula koo dura jira;</para>
  <para style="q2" vid="PSA 18:22">anis labsii isaa irraa hin gorre.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Ani fuula isaa duratti mudaa hin qabu ture;</para>
  <para style="q2" vid="PSA 18:23">cubbuu irraas of eeggadheera.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>
    <char style="nd">Waaqayyo</char> akkuma qajeelumma kootti,</para>
  <para style="q2" vid="PSA 18:24">akkuma harki koo fuula isaa duratti qulqulluu taʼettis na badhaaseera.<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Ati nama amanamaatti amanamummaa kee argisiifta;</para>
  <para style="q2" vid="PSA 18:25">nama mudaa hin qabnettis kan mudaa hin qabne taata.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>Nama qulqulluutti qulqulluu taata;</para>
  <para style="q2" vid="PSA 18:26">nama jalʼaatti immoo jalʼaa taata.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>Ati warra gad of qaban ni oolchita;</para>
  <para style="q2" vid="PSA 18:27">ija of tuulu garuu gad deebifta.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>Yaa <char style="nd">Waaqayyo</char> ati ibsaa koo jabeessitee ni ibsita;</para>
  <para style="q2" vid="PSA 18:28">Waaqni koo dukkana koo ifatti ni geeddara.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Ani gargaarsa keetiin loltoota dhiibbadhee nan deema;</para>
  <para style="q2" vid="PSA 18:29">Waaqa kootiinis dallaa utaaluu nan dandaʼa.<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Waaqa kana karaan isaa mudaa hin qabu;</para>
  <para style="q2" vid="PSA 18:30">dubbiin <char style="nd">Waaqayyoo</char> hirʼina hin qabu;</para>
  <para style="q2" vid="PSA 18:30">warra isatti kooluu galan hundaaf <char style="nd">Waaqayyo</char> gaachana taʼa.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>
    <char style="nd">Waaqayyo</char> malee Waaqni eenyu?</para>
  <para style="q2" vid="PSA 18:31">Waaqa keenya malees kattaan eenyu?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Kan humna na hidhachiisu,</para>
  <para style="q2" vid="PSA 18:32">kan akka karaan koos nagaa taʼu godhu Waaqa.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>Inni miilla koo akka miilla borofaa godha;</para>
  <para style="q2" vid="PSA 18:33">iddoo ol dheeraa irras na dhaabachiisa.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Inni harka koo waraanaaf leenjisa;</para>
  <para style="q2" vid="PSA 18:34">irreen koos iddaa naasii dabsuu ni dandaʼa.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Ati gargaarsa kee kan nama fayyisu gaachana naaf goota;</para>
  <para style="q2" vid="PSA 18:35">harki kee mirgaa ol na qabeera;</para>
  <para style="q2" vid="PSA 18:35">gargaarsi kees nama guddaa na godhe.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Akka koomeen koo hin mucucaanneef,</para>
  <para style="q2" vid="PSA 18:36">miilla kootiif daandii balʼifteerta.<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Ani diinota koo ariʼee nan qaqqabadhe;</para>
  <para style="q2" vid="PSA 18:37">hamma isaan barbadaaʼanittis ani duubatti hin deebine.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Ani akka isaan deebiʼanii kaʼuu hin dandeenyeef isaan nan barbadeesse;</para>
  <para style="q2" vid="PSA 18:38">isaanis miilla koo jalatti ni kufan.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Ati lolaaf humna na hidhachiifte;</para>
  <para style="q2" vid="PSA 18:39">amajaajota koos fuula koo duratti gad deebifte.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Akka diinonni koo dugda duubatti deebiʼanii baqatan gooteerta;</para>
  <para style="q2" vid="PSA 18:40">anis amajaajota koo barbadeesseera.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Isaan gargaarsaaf iyyan; garuu kan isaan oolchu tokko iyyuu hin turre;</para>
  <para style="q2" vid="PSA 18:41">gara <char style="nd">Waaqayyoottis</char> ni iyyatan; inni garuu deebii hin kennineef.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Anis akkuma awwaara bubbeen fudhatuutti isaan nan daake;</para>
  <para style="q2" vid="PSA 18:42">akkuma dhoqqee daandii irraatti isaan nan dhidhiite.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Ati lola namootaa jalaa na baafteerta;</para>
  <para style="q2" vid="PSA 18:43">mataa sabootaa na gooteerta;</para>
  <para style="q2" vid="PSA 18:43">sabni ani hin beekne na tajaajila.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Namoonni ormaa na sossobatan;</para>
  <para style="q2" vid="PSA 18:44">isaan akkuma waaʼee koo dhagaʼaniin naaf ajajaman.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Isaan hundi abdii kutatan;</para>
  <para style="q2" vid="PSA 18:45">hollachaas daʼannoo isaanii jabaa keessaa baʼan.<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>
    <char style="nd">Waaqayyo</char> jiraataa dha! Kattaan koo haa eebbifamu!</para>
  <para style="q2" vid="PSA 18:46">Waaqni Fayyisaan koo ol ol haa jedhu!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>Inni Waaqa haaloo naa baasu,</para>
  <para style="q2" vid="PSA 18:47">kan sabootas na jalatti bulchuu dha;<verse eid="PSA 18:47"/></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 18:48"/>diinota koo jalaas na baasa.</para>
  <para style="q1" vid="PSA 18:48">Ati amajaajota kootii ol na goota;</para>
  <para style="q2" vid="PSA 18:48">gooltota jalaas na baafte.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>Kanaafuu yaa <char style="nd">Waaqayyo</char>, ani saboota gidduutti sin leellisa;</para>
  <para style="q2" vid="PSA 18:49">faarfannaa galataa illee maqaa keetiif nan faarfadha.<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>Inni moʼannaawwan gurguddaa mootii isaatiif ni kenna;</para>
  <para style="q2" vid="PSA 18:50">dibamaa isaa Daawitii fi sanyii isaatiif,</para>
  <para style="q2" vid="PSA 18:50">jaalala bara baraa ni argisiisa.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">Faarfannaa 19</para>
  <para style="ms1">Waaqayyo Biiftuu Qajeelummaati</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>Samiiwwan ulfina Waaqaa odeessu;</para>
  <para style="q2" vid="PSA 19:1">bantiin samiis hojii harka isaa labsa.<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Guyyaan tokko guyyaa kaanitti odeessa,</para>
  <para style="q2" vid="PSA 19:2">halkan tokkos halkan kaanitti beekumsa mulʼisa.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Haasaan yookaan dubbiin hin jiru;</para>
  <para style="q2" vid="PSA 19:3">sagaleen isaaniis hin dhagaʼamu.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>Taʼus sagaleen isaanii lafa hundumaa,</para>
  <para style="q2" vid="PSA 19:4">dubbiin isaaniis handaara addunyaa gaʼe.</para>
  <para style="q1" vid="PSA 19:4">Inni samiiwwan keessatti biiftuudhaaf dunkaana dhaabe;<verse eid="PSA 19:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5"/>biiftuunis akkuma misirricha dinqa isaatii baʼuutii fi</para>
  <para style="q2" vid="PSA 19:5">akkuma moʼataa fiigicha dorgomutti gammadu tokkoo ti.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Isheenis handaara samiiwwanii tokkoo baatee</para>
  <para style="q2" vid="PSA 19:6">gara handaara kaaniitti naannofti;</para>
  <para style="q2" vid="PSA 19:6">wanni hoʼa ishee jalaa dhokatu tokko iyyuu hin jiru.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>Seerri <char style="nd">Waaqayyoo</char> mudaa hin qabu;</para>
  <para style="q2" vid="PSA 19:7">lubbuu namatti deebisa.</para>
  <para style="q1" vid="PSA 19:7">Ajajni <char style="nd">Waaqayyoo</char> amanamaa dha;</para>
  <para style="q2" vid="PSA 19:7">nama wallaalaa beekaa godha.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>Seerri <char style="nd">Waaqayyoo</char> qajeelaa dha;</para>
  <para style="q2" vid="PSA 19:8">garaadhaaf gammachuu kenna.</para>
  <para style="q1" vid="PSA 19:8">Ajajni <char style="nd">Waaqayyoo</char> qulqulluu dha;</para>
  <para style="q2" vid="PSA 19:8">ijaafis ifa kenna.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>
    <char style="nd">Waaqayyoon</char> sodaachuun qulqulluu dha;</para>
  <para style="q2" vid="PSA 19:9">bara baraan jiraata.</para>
  <para style="q1" vid="PSA 19:9">Murtiin <char style="nd">Waaqayyoo</char> dhugaa dha;</para>
  <para style="q2" vid="PSA 19:9">walumaa galattis qajeelaa dha.<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Inni warqee caalaa, warqee akka malee qulqulleeffame</para>
  <para style="q2" vid="PSA 19:10">caalaa iyyuu gatii qabeessa;</para>
  <para style="q1" vid="PSA 19:10">inni damma caalaa,</para>
  <para style="q2" vid="PSA 19:10">nadhii dammaa caalaa miʼaawaa dha.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Murtii kanaanis tajaajilaan kee ni gorfama;</para>
  <para style="q2" vid="PSA 19:11">isa eeguunis gatii guddaa qaba.<verse eid="PSA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>Eenyutu dogoggora isaa hubachuu dandaʼa?</para>
  <para style="q2" vid="PSA 19:12">Yakka koo isa dhokfamaa irraa na qulqulleessi.<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Tajaajilaa kee cubbuu ija jabinaan hojjetamu irraa eegi;</para>
  <para style="q2" vid="PSA 19:13">cubbuun kunis na hin moʼatin.</para>
  <para style="q1" vid="PSA 19:13">Yoos ani hirʼina malee nan jiraadha;</para>
  <para style="q2" vid="PSA 19:13">dogoggora guddaa irraas qulqulluu nan taʼa.<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Yaa <char style="nd">Waaqayyo</char>, Kattaa koo fi Furii ko,</para>
  <para style="q2" vid="PSA 19:14">dubbiin afaan kootii fi yaadni garaa koo</para>
  <para style="q2" vid="PSA 19:14">fuula kee duratti fudhatamaa haa taʼu.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">Faarfannaa 20</para>
  <para style="ms1">Kadhannaa Mootiif Kadhatame</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>Guyyaa rakkinaatti <char style="nd">Waaqayyo</char> deebii siif haa kennu;</para>
  <para style="q2" vid="PSA 20:1">maqaan Waaqa Yaaqoobis si haa eegu.<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Inni iddoo qulqulluudhaa gargaarsa siif haa ergu;</para>
  <para style="q2" vid="PSA 20:2">Xiyoon irraas jabina siif haa kennu.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>Aarsaa kee hunda siif haa yaadatu;</para>
  <para style="q2" vid="PSA 20:3">qalma kee kan gubamus siif haa fudhatu.<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Hawwii garaa keetii siif haa kennu;</para>
  <para style="q2" vid="PSA 20:4">karoora kee hundas fiixaan siif haa baasu.<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Yommuu ati moʼattutti ililchinee</para>
  <para style="q2" vid="PSA 20:5">maqaa Waaqa keenyaatiin faajjii keenya ol fudhanna.</para>
  <para style="b" vid="PSA 20:5"/>
  <para style="q1" vid="PSA 20:5">
    <char style="nd">Waaqayyo</char> waan ati kadhattu hundumaa siif haa kennu.<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Ani akka <char style="nd">Waaqayyo</char> dibamaa isaa fayyisu amma beeka;</para>
  <para style="q2" vid="PSA 20:6">Waaqayyo humna nama fayyisu kan harka isaa mirgaa keessa jiru sanaan</para>
  <para style="q2" vid="PSA 20:6">samii isaa qulqulluu keessaa deebii ni kennaaf.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Namoonni tokko tokko gaariiwwan amanatu; kaan immoo fardeen amanatu;</para>
  <para style="q2" vid="PSA 20:7">nu garuu maqaa <char style="nd">Waaqayyo</char> Waaqa keenyaa amananna.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Isaan gufatanii kufu; nu garuu ol kaana;</para>
  <para style="q2" vid="PSA 20:8">jabaannees ni dhaabanna.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>Yaa <char style="nd">Waaqayyo</char>, ati mootiidhaaf moʼannaa kenni!</para>
  <para style="q2" vid="PSA 20:9">Yommuu nu si waammannuttis deebii nuu kenni!<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">Faarfannaa 21</para>
  <para style="ms1">Galata Waaʼee Mootichaatiif Dhiʼaate</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>Yaa <char style="nd">Waaqayyo</char>, mootiin jabina keetti baayʼee gammada.</para>
  <para style="q2" vid="PSA 21:1">Gargaarsa keettis gammachuun isaa hammam guddaa dha!<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>Ati hawwii garaa isaa kenniteefii jirta;</para>
  <para style="q2" vid="PSA 21:2">kadhannaa afaan isaas isa hin dhowwanne.<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Ati eebba guddaadhaan isa simatte;</para>
  <para style="q2" vid="PSA 21:3">gonfoo warqee qulqulluus mataa isaa irra keesse.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>Inni jireenya si kadhate; atis ni kenniteef;</para>
  <para style="q2" vid="PSA 21:4">bara dheeraas bara baraa hamma bara baraatti kenniteef.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Ulfinni isaa moʼannaa ati isaaf kenniteen guddaa taʼe;</para>
  <para style="q2" vid="PSA 21:5">atis ulfinaa fi surraa isatti uwwifte.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Ati eebba bara baraa kenniteef;</para>
  <para style="q2" vid="PSA 21:6">akka inni gammachuu argama keetiitiin gammadus goote.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Mootichi <char style="nd">Waaqayyoon</char> amanataatii;</para>
  <para style="q2" vid="PSA 21:7">sababii jaalala Waaqa Waan Hundaa Olii</para>
  <para style="q2" vid="PSA 21:7">kan hin geeddaramne sanaatiifis inni hin raafamu.<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Harki kee diinota kee hunda ni qabata;</para>
  <para style="q2" vid="PSA 21:8">harki kee mirgaas warra si jibban ni qaba.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>Yeroo mulʼachuu keetiitti,</para>
  <para style="q2" vid="PSA 21:9">akka boolla ibiddi keessaa bobaʼuu isaan goota.</para>
  <para style="q1" vid="PSA 21:9">
    <char style="nd">Waaqayyo</char> dheekkamsa isaatiin isaan liqimsa;</para>
  <para style="q2" vid="PSA 21:9">ibiddis isaan fixa.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Ati sanyii isaanii lafa irraa,</para>
  <para style="q2" vid="PSA 21:10">ijoollee isaaniis ilmaan namaa gidduudhaa ni balleessita.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Isaan yoo waan hamaa sitti yaadan,</para>
  <para style="q2" vid="PSA 21:11">yoo daba sitti mariʼatanis hin milkaaʼan.<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>Ati yommuu iddaa kee isaanitti qabdutti,</para>
  <para style="q2" vid="PSA 21:12">akka isaan baqatan gootaatii.<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>Yaa <char style="nd">Waaqayyo</char>, jabina keetiin ol ol jedhi;</para>
  <para style="q2" vid="PSA 21:13">nu humna kee ni jajanna; ni faarfannas.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">Faarfannaa 22</para>
  <para style="ms1">Rakkinaa Fi Abdii Nama Qajeelaa</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Yeedaloo “Borofa Ganamaa” jedhu. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>Yaa Waaqa ko, yaa Waaqa ko, ati maaliif na dhiifte?</para>
  <para style="q2" vid="PSA 22:1">Ati na gargaaruu irraa,</para>
  <para style="q2" vid="PSA 22:1">iyya koo irraas maaliif akkas fagaatta?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>Yaa Waaqa ko, ani guyyaa guyyaa sittin iyyadha;</para>
  <para style="q2" vid="PSA 22:2">ati garuu deebii naaf hin deebiftu;</para>
  <para style="q2" vid="PSA 22:2">halkan halkanis afaan hin qabadhu.<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>Ati garuu Qulqullicha teessoo irra taaʼuu dha;</para>
  <para style="q2" vid="PSA 22:3">ati galata Israaʼel.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Abbootiin keenya si amanatan;</para>
  <para style="q2" vid="PSA 22:4">isaan si amanatan; atis isaan oolchite.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>Isaan sitti iyyatan; ni fayyifamanis;</para>
  <para style="q2" vid="PSA 22:5">si amanatan; hin qaanofnes.<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>Ani garuu raammoodha malee nama miti;</para>
  <para style="q2" vid="PSA 22:6">ani nama namni itti qoosuu fi sabnis tuffatuu dha.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Warri na argan hundinuu natti kolfu;</para>
  <para style="q2" vid="PSA 22:7">mataa isaanii raasanii na arrabsu.<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>Akkanas jedhu; “Inni <char style="nd">Waaqayyoon</char> amanata;</para>
  <para style="q2" vid="PSA 22:8">mee <char style="nd">Waaqayyo</char> isa haa oolchu kaa.</para>
  <para style="q2" vid="PSA 22:8">Inni waan isatti gammaduuf, isa haa oolchu.”<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>Ati garuu gadameessa keessaa na baafte;</para>
  <para style="q2" vid="PSA 22:9">harma haadha koo irrattis, situ nagaan na eege.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Ani gaafan dhaladhee jalqabee sirratti nan gatame;</para>
  <para style="q2" vid="PSA 22:10">erga haati koo na deessee jalqabdee ati Waaqa koo ti.<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>Ati narraa hin fagaatin;</para>
  <para style="q2" vid="PSA 22:11">rakkinni dhiʼaateeraatii;</para>
  <para style="q2" vid="PSA 22:11">namni na gargaarus hin jiru.<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Korommiin baayʼeen na marsu;</para>
  <para style="q2" vid="PSA 22:12">korommiin Baashaan jajjaboonis karaa hundumaan na marsu.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Isaanis akka leenca beelaʼee aaduu</para>
  <para style="q2" vid="PSA 22:13">afaan isaanii balʼisanii natti banatu.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Ani akkuma bishaaniitti nan dhangalaafame;</para>
  <para style="q2" vid="PSA 22:14">lafeen koo hundinuus wal gad dhiise.</para>
  <para style="q1" vid="PSA 22:14">Onneen koo gara gagaatti geeddarame;</para>
  <para style="q2" vid="PSA 22:14">na keessattis baqe.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Jabinni koo akka qiraacii goge;</para>
  <para style="q2" vid="PSA 22:15">arrabni koo laagaatti na maxxane;</para>
  <para style="q2" vid="PSA 22:15">awwaara duʼaa keessas na ciibsite.<verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Saroonni na marsaniiru;</para>
  <para style="q2" vid="PSA 22:16">gareen namoota hamoo na marseera;</para>
  <para style="q2" vid="PSA 22:16">isaanis harkaa fi miilla koo waraananii fullaasaniiru.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Ani lafee koo hunda lakkaaʼuu nan dandaʼa;</para>
  <para style="q2" vid="PSA 22:17">isaanis ija babaasanii na ilaalu; akkas taʼuu koottis ni gammadu.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Isaan wayyaa koo hiratan;</para>
  <para style="q2" vid="PSA 22:18">uffata koottis ixaa buufatan.<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>Yaa <char style="nd">Waaqayyo</char>, ati garuu narraa hin fagaatin;</para>
  <para style="q2" vid="PSA 22:19">yaa Jabina koo na gargaaruuf ariifadhu.<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Lubbuu koo goraadee jalaa,</para>
  <para style="q2" vid="PSA 22:20">jireenya koo immoo humna sarootaa jalaa baasi.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Afaan leencaa jalaa na miliqsi;</para>
  <para style="q2" vid="PSA 22:21">gaanfa gafarsaa jalaas na baasi.<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Maqaa kee obboloota kootti nan labsa;</para>
  <para style="q2" vid="PSA 22:22">waldaa keessattis sin jajadha.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>Isin warri <char style="nd">Waaqayyoon</char> sodaattan isa jajadhaa!</para>
  <para style="q2" vid="PSA 22:23">Isin sanyiin Yaaqoob hundinuu isa ulfeessaa!</para>
  <para style="q2" vid="PSA 22:23">Sanyiin Israaʼel hundinuus isa sodaadhaa!<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>Inni dhiphina nama dhiphatee hin tuffanne</para>
  <para style="q2" vid="PSA 22:24">yookaan hin balfineetii;</para>
  <para style="q1" vid="PSA 22:24">yommuu inni gargaarsaaf isatti iyyatettis,</para>
  <para style="q2" vid="PSA 22:24">ni dhagaʼeef malee fuula isaa hin dhokfanne.<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Galanni ani yaaʼii guddaa irratti siif galchu si biraa dhufa;</para>
  <para style="q2" vid="PSA 22:25">warra si sodaatan durattis wareega koo of irraa nan baasa.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Hiyyeeyyiin nyaatanii quufu;</para>
  <para style="q2" vid="PSA 22:26">warri <char style="nd">Waaqayyoon</char> barbaaddatanis isa ni jajatu;</para>
  <para style="q2" vid="PSA 22:26">garaan keessan bara baraan haa jiraatu!<verse eid="PSA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Handaarri lafaa hundinuu ni yaadata;</para>
  <para style="q2" vid="PSA 22:27">gara <char style="nd">Waaqayyoottis</char> ni deebiʼa;</para>
  <para style="q1" vid="PSA 22:27">maatiiwwan sabootaa hundinuus</para>
  <para style="q2" vid="PSA 22:27">fuula isaa duratti ni sagadu;<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>mootummaan kan <char style="nd">Waaqayyootii</char>;</para>
  <para style="q2" vid="PSA 22:28">innis saboota hunda ni bulcha.<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>Sooreyyiin lafaa hundinuu ni nyaatu; ni waaqeffatus;</para>
  <para style="q2" vid="PSA 22:29">warri of jiraachisuu hin dandeenye kanneen biyyoo seenan hundi</para>
  <para style="q2" vid="PSA 22:29">fuula isaa duratti ni jilbeenfatu.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Dhaloonni dhufu isa tajaajila;</para>
  <para style="q2" vid="PSA 22:30">dhaloota boriittis waaʼeen Gooftaa ni himama.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Sababii inni waan kana hojjeteef,</para>
  <para style="q2" vid="PSA 22:31">isaan saba dhalachuuf jirutti qajeelummaa isaa ni labsu.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">Faarfannaa 23</para>
  <para style="ms1">Tiksee Gaarii</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>
    <char style="nd">Waaqayyo</char> tiksee koo ti; ani homaa hin dhabu.<verse eid="PSA 23:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 23:2"/>Inni marga lalisaa keessa na boqochiisa;</para>
  <para style="q1" vid="PSA 23:2">gara bishaan tasgabbaaʼaattis na geessa;<verse eid="PSA 23:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3"/>inni lubbuu natti deebisa.</para>
  <para style="q1" vid="PSA 23:3">Maqaa isaatiif jedhees</para>
  <para style="q2" vid="PSA 23:3">karaa qajeelaa irra na deemsisa.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Ani yoon sulula gaaddisa duʼaa keessa deeme illee</para>
  <para style="q2" vid="PSA 23:4">ati waan na wajjin jirtuuf, homaa hin sodaadhu;</para>
  <para style="q2" vid="PSA 23:4">uleen keetii fi bokkuun kee na jajjabeessu.<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Ati utuma diinonni koo ilaalanuu</para>
  <para style="q2" vid="PSA 23:5">fuula koo duratti maaddii naa qopheessita.</para>
  <para style="q1" vid="PSA 23:5">Mataa koo zayitii dibda;</para>
  <para style="q2" vid="PSA 23:5">xoofoon koos guutuu irraan dhangalaʼaa dha.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Dhugumaan gaarummaan keetii fi araarri kee,</para>
  <para style="q2" vid="PSA 23:6">bara jireenya kootii hunda na duukaa buʼu;</para>
  <para style="q2" vid="PSA 23:6">anis bara baraan, mana <char style="nd">Waaqayyoo</char> keessa nan jiraadha.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">Faarfannaa 24</para>
  <para style="ms1">Faarfannaa Mootii Ulfinaatiif Faarfatame</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>Laftii fi wanni lafa irra jiru hundinuu,</para>
  <para style="q2" vid="PSA 24:1">addunyaa fi wanni ishee keessa jiraatu hundinuus kan <char style="nd">Waaqayyoo</char> ti;<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>inni galaanota irratti ishee hundeesseeraatii;</para>
  <para style="q2" vid="PSA 24:2">bishaan irras ishee dhaabeera.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>Eenyutu tulluu <char style="nd">Waaqayyootti</char> ol baʼa?</para>
  <para style="q2" vid="PSA 24:3">Iddoo isaa qulqulluu sanas eenyutu dhaabata?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>Nama harka qulqulluu fi garaa qulqulluu qabu,</para>
  <para style="q2" vid="PSA 24:4">nama lubbuu isaa gara waaqa tolfamaatti ol hin kaafne</para>
  <para style="q2" vid="PSA 24:4">yookaan nama sobaan hin kakannee dha.<verse eid="PSA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>Inni <char style="nd">Waaqayyo</char> biraa eebba,</para>
  <para style="q2" vid="PSA 24:5">Waaqa Fayyisaa isaa biraa immoo qajeelummaa ni argata.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>Dhaloonni kun dhaloota warra isa barbaadanii ti;</para>
  <para style="q2" vid="PSA 24:6">kan dhaloota warra fuula Waaqa Yaaqoob barbaadanii ti.<verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>Yaa karroota nana, mataa keessan ol qabadhaa;</para>
  <para style="q2" vid="PSA 24:7">isinis balbalawwan durii,</para>
  <para style="q2" vid="PSA 24:7">akka mootiin ulfinaa ol galuuf ol qabamaa.<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>Mootiin ulfinaa kun eenyu?</para>
  <para style="q2" vid="PSA 24:8">
    <char style="nd">Waaqayyo</char> jabaa fi humna qabeessa,</para>
  <para style="q2" vid="PSA 24:8">
    <char style="nd">Waaqayyo</char> isa waraana keessattis humna qabu sanaa dha.<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>Yaa karroota nana, mataa keessan ol qabadhaa;</para>
  <para style="q2" vid="PSA 24:9">isinis balbalawwan durii akka mootiin ulfinaa ol galuuf</para>
  <para style="q2" vid="PSA 24:9">mataa keessan ol qabadhaa.<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>Mootiin ulfinaa kun eenyu?</para>
  <para style="q2" vid="PSA 24:10">
    <char style="nd">Waaqayyoon</char> Waan Hunda Dandaʼu sun,</para>
  <para style="q2" vid="PSA 24:10">inni Mootii ulfinaa ti.<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">Faarfannaa 25</para>
  <para style="ms1">Kadhannaa Yeroo Balaa</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>Yaa <char style="nd">Waaqayyo</char>, ani lubbuu koo gara keetti</para>
  <para style="q2" vid="PSA 25:1">ol nan qaba.<verse eid="PSA 25:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>Yaa Waaqa koo ani sin amanadha.</para>
  <para style="q2" vid="PSA 25:2">Ati na hin qaanessin;</para>
  <para style="q2" vid="PSA 25:2">akka diinonni koo na moʼatanis hin godhin.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Namni si eeggatu tokko iyyuu</para>
  <para style="q2" vid="PSA 25:3">yoom iyyuu hin qaaneffamu;</para>
  <para style="q1" vid="PSA 25:3">warri sababii malee yakka hojjetan</para>
  <para style="q2" vid="PSA 25:3">garuu ni qaaneffamu.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>Yaa <char style="nd">Waaqayyo</char>, karaa kee na argisiisi;</para>
  <para style="q2" vid="PSA 25:4">daandii kees na barsiisi;<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>ati Waaqa Fayyisaa koo waan taateef,</para>
  <para style="q2" vid="PSA 25:5">dhugaa keetiin na dura buʼi; na barsiisi;</para>
  <para style="q2" vid="PSA 25:5">anis guyyaa guutuu sin eeggadha.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>Yaa <char style="nd">Waaqayyo</char>, araara keetii fi jaalala kee yaadadhu;</para>
  <para style="q2" vid="PSA 25:6">isaan durumaa jalqabanii jiruutii.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>Cubbuu afaan kootii</para>
  <para style="q2" vid="PSA 25:7">yookaan dogoggora koo hin yaadatin;</para>
  <para style="q1" vid="PSA 25:7">yaa <char style="nd">Waaqayyo</char>, gaarummaa keetiif jedhiitii</para>
  <para style="q2" vid="PSA 25:7">akkuma araara keetiitti na yaadadhu.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>
    <char style="nd">Waaqayyo</char> gaarii dha; tolaadhas;</para>
  <para style="q2" vid="PSA 25:8">kanaafuu inni daandii isaa cubbamootatti argisiisa.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>Warra gad of qaban waan qajeelaa taʼeen geggeessa;</para>
  <para style="q2" vid="PSA 25:9">karaa isaas isaan barsiisa.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>Karaan <char style="nd">Waaqayyoo</char> hundinuu</para>
  <para style="q2" vid="PSA 25:10">warra kakuu isaatii fi seera isaa eeganiif araaraa fi dhugaa dha.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>Yaa <char style="nd">Waaqayyo</char>, cubbuun koo guddaa taʼu iyyuu</para>
  <para style="q2" vid="PSA 25:11">maqaa keetiif jedhiitii dhiifama naa godhi.<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Namni <char style="nd">Waaqayyoon</char> sodaatu eenyu?</para>
  <para style="q2" vid="PSA 25:12">Waaqayyo karaa inni filachuu qabu isa argisiisa.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>Lubbuun isaa badhaadhummaadhaan jiraatti;</para>
  <para style="q2" vid="PSA 25:13">sanyiin isaas lafa dhaala.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>
    <char style="nd">Waaqayyo</char> icciitii isaa warra isa sodaatan duraa hin dhoksu;</para>
  <para style="q2" vid="PSA 25:14">kakuu isaa illee isaan beeksisa.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Iji koo yeroo hunda gara <char style="nd">Waaqayyoo</char> ilaala;</para>
  <para style="q2" vid="PSA 25:15">inni miilla koo kiyyoo keessaa ni baasaatii.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>Gara kootti garagali; garaas naa laafi;</para>
  <para style="q2" vid="PSA 25:16">ani kophaa koon jiraatii; rakkataadhas.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Yaaddoon garaa kootii baayʼateera;</para>
  <para style="q2" vid="PSA 25:17">dhiphina koo keessaas na baasi.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Dhiphina kootii fi rakkina koo ilaali;</para>
  <para style="q2" vid="PSA 25:18">cubbuu koo hunda naa dhiisi.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Akka diinonni koo baayʼatan,</para>
  <para style="q2" vid="PSA 25:19">hammam akka cimsanii na jibban argi!<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Lubbuu koo eegi; na oolchis;</para>
  <para style="q2" vid="PSA 25:20">sababii ani kooluu sitti galeef,</para>
  <para style="q2" vid="PSA 25:20">akka ani qaanaʼu na hin godhin.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Waan ani si eeggadhuuf, amanamummaa fi</para>
  <para style="q2" vid="PSA 25:21">qajeelummaan ana haa eegan.<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>Yaa Waaqayyo, rakkina isaa hundumaa keessaa</para>
  <para style="q2" vid="PSA 25:22">Israaʼelin furi!<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">Faarfannaa 26</para>
  <para style="ms1">Kadhannaa nama qajeelaa</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>Yaa <char style="nd">Waaqayyo</char>, sababii ani jireenya hirʼina</para>
  <para style="q2" vid="PSA 26:1">hin qabne jiraadheef, ati naa murteessi;</para>
  <para style="q1" vid="PSA 26:1">anis utuu asii fi achi hin raafamin,</para>
  <para style="q2" vid="PSA 26:1">
    <char style="nd">Waaqayyoon</char> amanadheera.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>Yaa <char style="nd">Waaqayyo</char>, qoriitii na ilaali;</para>
  <para style="q2" vid="PSA 26:2">garaa koo fi qalbii koo qori;<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>jaalalli kee kan hin geeddaramne sun ija koo dura jiraatii;</para>
  <para style="q2" vid="PSA 26:3">anis dhugaa keetiin nan deddeebiʼa.<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Ani warra nama gowwoomsan wajjin hin taaʼu,</para>
  <para style="q2" vid="PSA 26:4">yookaan fakkeessitoota wajjin tokkummaa hin qabaadhu;<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>ani waldaa warra hammina hojjetanii nan jibba;</para>
  <para style="q2" vid="PSA 26:5">hamoota wajjinis hin taaʼu.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Yaa <char style="nd">Waaqayyo</char>, ani harka koo qulqullummaadhaan nan dhiqadha;</para>
  <para style="q2" vid="PSA 26:6">iddoo aarsaa keetii irras nan naannaʼa.<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>Faarfannaa galataa guddisee nan faarfadha;</para>
  <para style="q2" vid="PSA 26:7">dinqii hojii keetii hunda nan odeessa.<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>Yaa <char style="nd">Waaqayyo</char>, mana ati keessa jiraattu,</para>
  <para style="q2" vid="PSA 26:8">iddoo ulfinni kee jirus nan jaalladha.<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Lubbuu koo cubbamoota wajjin, jireenya koos</para>
  <para style="q2" vid="PSA 26:9">warra dhiiga dhangalaasan wajjin hin balleessin;<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>warra harka isaanii keessa karoorri jalʼinaa jiru</para>
  <para style="q2" vid="PSA 26:10">kanneen harki isaanii mirgaa mattaʼaadhaan guutame wajjin na hin balleessin.<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>Ani garuu jireenya hirʼina hin qabne nan jiraadha;</para>
  <para style="q2" vid="PSA 26:11">ati na furi; araaras naa buusi.<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Miilli koo lafa wal qixxee irra dhaabata;</para>
  <para style="q2" vid="PSA 26:12">waldaa guddaa keessattis <char style="nd">Waaqayyoon</char> nan jajadha.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">Faarfannaa 27</para>
  <para style="ms1">Ija Jabina Nama Waaqayyoo</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>
    <char style="nd">Waaqayyo</char> ibsaa kootii fi fayyina koo ti;</para>
  <para style="q2" vid="PSA 27:1">ani eenyunan sodaadha?</para>
  <para style="q1" vid="PSA 27:1">
    <char style="nd">Waaqayyo</char> daʼoo jireenya kootii ti;</para>
  <para style="q2" vid="PSA 27:1">eenyutu na sodaachisa?<verse eid="PSA 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Namoonni hamoon yommuu</para>
  <para style="q2" vid="PSA 27:2">foon koo nyaachuudhaaf natti dhufan,</para>
  <para style="q1" vid="PSA 27:2">diinonni koo fi amajaajonni koo</para>
  <para style="q2" vid="PSA 27:2">yommuu na miidhuuf natti kaʼan, gufatanii kufu.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Yoo duulli na marse illee,</para>
  <para style="q2" vid="PSA 27:3">garaan koo hin sodaatu;</para>
  <para style="q1" vid="PSA 27:3">yoo waraanni natti baname illee</para>
  <para style="q2" vid="PSA 27:3">ani hin raafamu.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Ani waan tokko <char style="nd">Waaqayyoon</char> nan kadhadha;</para>
  <para style="q2" vid="PSA 27:4">waan kanas nan barbaada:</para>
  <para style="q1" vid="PSA 27:4">Kunis bara jireenya kootii guutuu</para>
  <para style="q2" vid="PSA 27:4">mana <char style="nd">Waaqayyoo</char> keessa jiraachuu,</para>
  <para style="q1" vid="PSA 27:4">miidhagina <char style="nd">Waaqayyoo</char> ilaaluu fi mana qulqullummaa isaa</para>
  <para style="q2" vid="PSA 27:4">keessatti isa kadhachuu dha.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Inni guyyaa rakkinaa</para>
  <para style="q2" vid="PSA 27:5">iddoo ofii jiraatu na kaaʼataatii;</para>
  <para style="q1" vid="PSA 27:5">daʼoo dunkaana isaa jala na dhoksa;</para>
  <para style="q2" vid="PSA 27:5">kattaa gubbaattis ol na baasa.<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>Yommus diinota na marsanii olitti</para>
  <para style="q2" vid="PSA 27:6">mataan koo ol jedha;</para>
  <para style="q1" vid="PSA 27:6">dunkaana isaa keessatti illee ililleedhaan aarsaa nan dhiʼeessa;</para>
  <para style="q2" vid="PSA 27:6">
    <char style="nd">Waaqayyoof</char> nan faarfadha; nan weeddisas.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>Yaa <char style="nd">Waaqayyo</char>, yommuu ani si waammadhu, sagalee koo dhagaʼi;</para>
  <para style="q2" vid="PSA 27:7">naaf araarami; deebiis naaf kenni.<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Yommuu ati, “Fuula koo barbaadaa!” jettetti,</para>
  <para style="q2" vid="PSA 27:8">garaan koo, “Yaa <char style="nd">Waaqayyo</char>, ani fuula kee nan barbaada” siin jedha.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Fuula kee na duraa hin dhoksin;</para>
  <para style="q2" vid="PSA 27:9">aartee tajaajilaa kee of irraa hin deebisin;</para>
  <para style="q2" vid="PSA 27:9">ati gargaaraa koo taateerta.</para>
  <para style="q1" vid="PSA 27:9">Yaa Waaqayyo, Fayyisaa ko,</para>
  <para style="q2" vid="PSA 27:9">na hin gatin; na hin dhiisinis.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Yoo abbaan kootii fi haati koo na dhiisan illee,</para>
  <para style="q2" vid="PSA 27:10">
    <char style="nd">Waaqayyo</char> na simata.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>Yaa <char style="nd">Waaqayyo</char>, karaa kee na barsiisi;</para>
  <para style="q2" vid="PSA 27:11">sababii ani diinota baayʼee qabuuf</para>
  <para style="q2" vid="PSA 27:11">daandii qajeelaa irra na buusi.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Fedhii diinota kootiitti dabarsitee na hin kennin;</para>
  <para style="q2" vid="PSA 27:12">dhuga baatonni sobduun narratti kaʼaniiruutii;</para>
  <para style="q2" vid="PSA 27:12">isaanis hafuura jalʼinaa baafatu.<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>Anis biyya jiraattotaa keessatti</para>
  <para style="q2" vid="PSA 27:13">gaarummaa <char style="nd">Waaqayyoo</char> akkan argu</para>
  <para style="q2" vid="PSA 27:13">amma iyyuu nan amana.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>
    <char style="nd">Waaqayyoon</char> eeggadhu;</para>
  <para style="q2" vid="PSA 27:14">cimi; jabaadhus;</para>
  <para style="q2" vid="PSA 27:14">
    <char style="nd">Waaqayyoon</char> eeggadhu.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">Faarfannaa 28</para>
  <para style="ms1">Kadhannaa Fi Galata</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>Yaa <char style="nd">Waaqayyo</char>, Kattaa ko, ani sin waammadha;</para>
  <para style="q2" vid="PSA 28:1">ati na jalaa hin didin.</para>
  <para style="q1" vid="PSA 28:1">Yoo ati na jalaa didde,</para>
  <para style="q2" vid="PSA 28:1">ani akka warra boolla buʼanii nan taʼa.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Yommuu ani gargaarsaaf si waammadhee harka koo illee</para>
  <para style="q2" vid="PSA 28:2">gara Iddoo Qulqullummaa kee</para>
  <para style="q1" vid="PSA 28:2">kan Waan Hundumaa Caalaa Qulqulluu taʼe</para>
  <para style="q2" vid="PSA 28:2">sanaatti ol kaafadhu, sagalee kadhannaa koo naa dhagaʼi.<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>Namoota hamoo warra jalʼina hojjetan wajjin,</para>
  <para style="q2" vid="PSA 28:3">warra garaa isaaniitti hammina qabatanii</para>
  <para style="q1" vid="PSA 28:3">olloota isaanii wajjin garuu</para>
  <para style="q2" vid="PSA 28:3">nagaa dubbatan wajjin na hin balleessin.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>Akka hojii isaaniitti,</para>
  <para style="q2" vid="PSA 28:4">akkuma hojii isaanii hamaa sanaattis deebisiif;</para>
  <para style="q1" vid="PSA 28:4">akkuma hojii harka isaaniitti kenniif;</para>
  <para style="q2" vid="PSA 28:4">gatii isaaniif malu isaanumatti deebisi.<verse eid="PSA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Sababii isaan hojii <char style="nd">Waaqayyoo</char>,</para>
  <para style="q2" vid="PSA 28:5">yookaan waan harki isaa hojjete hin kabajneef</para>
  <para style="q1" vid="PSA 28:5">inni isaan diiga;</para>
  <para style="q2" vid="PSA 28:5">deebisees isaan hin ijaaru.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>
    <char style="nd">Waaqayyo</char> haa eebbifamu!</para>
  <para style="q2" vid="PSA 28:6">Inni iyya kadhannaa kootii naa dhagaʼeeraatii.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>
    <char style="nd">Waaqayyo</char> jabina koo fi gaachana koo ti;</para>
  <para style="q2" vid="PSA 28:7">garaan koo isa amanata; anis gargaarsa argadheera.</para>
  <para style="q1" vid="PSA 28:7">Garaan koo baayʼee gammada;</para>
  <para style="q2" vid="PSA 28:7">anis faarfannaadhaan isa nan galateeffadha.<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>
    <char style="nd">Waaqayyo</char> jabina saba isaa ti;</para>
  <para style="q2" vid="PSA 28:8">dibamaa isaatiifis daʼoo fayyinaa ti.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>Saba kee fayyisi; dhaala kees eebbisi;</para>
  <para style="q2" vid="PSA 28:9">tiksee isaanii taʼii bara baraan isaan baadhu.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">Faarfannaa 29</para>
  <para style="ms1">Faarfannaa Gooftaa Bubbeetiif Dhiʼaate</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>Isin jajjabeeyyiin, <char style="nd">Waaqayyoof</char> fidaa;</para>
  <para style="q2" vid="PSA 29:1">ulfinaa fi jabina <char style="nd">Waaqayyoof</char> fidaa.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Ulfina maqaa isaatiif malu <char style="nd">Waaqayyoof</char> kennaa;</para>
  <para style="q2" vid="PSA 29:2">iddoo qulqullummaa isaatti <char style="nd">Waaqayyoon</char> waaqeffadhaa.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>Sagaleen <char style="nd">Waaqayyoo</char> bishaanota irra jira;</para>
  <para style="q2" vid="PSA 29:3">Waaqni ulfinaa ni qaqawweessaʼa;</para>
  <para style="q2" vid="PSA 29:3">
    <char style="nd">Waaqayyo</char> bishaanota baayʼee irratti ni qaqawweessaʼa.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>Sagaleen <char style="nd">Waaqayyoo</char> humna qaba;</para>
  <para style="q2" vid="PSA 29:4">sagaleen <char style="nd">Waaqayyoo</char> surra qabeessa.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>Sagaleen <char style="nd">Waaqayyoo</char> birbirsa ni cabsa;</para>
  <para style="q2" vid="PSA 29:5">
    <char style="nd">Waaqayyo</char> birbirsa Libaanoon ni caccabsa.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Inni Libaanoonin akka jabbiitti,</para>
  <para style="q2" vid="PSA 29:6">Siiriyoonin immoo akka dibicha gafarsaatti ni utaalchisa.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>Sagaleen <char style="nd">Waaqayyoo</char></para>
  <para style="q2" vid="PSA 29:7">balaqqeessa bakakkaatiin rukuta.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>Sagaleen <char style="nd">Waaqayyoo</char> gammoojjii sochoosa;</para>
  <para style="q2" vid="PSA 29:8">
    <char style="nd">Waaqayyo</char> Gammoojjii Qaadesh sochoosa.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>Sagaleen <char style="nd">Waaqayyoo</char> qilxuu micciira;</para>
  <para style="q2" vid="PSA 29:9">bosonas qullaatti hambisa.</para>
  <para style="q1" vid="PSA 29:9">Hundinuus mana qulqullummaa isaa keessatti, “Ulfina!” jedhee iyya.<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>
    <char style="nd">Waaqayyo</char> lolaa badiisaatiin olitti teessoo isaa irra taaʼa;</para>
  <para style="q2" vid="PSA 29:10">
    <char style="nd">Waaqayyo</char> Mootii taʼee bara baraan teessoo isaa irra taaʼa.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>
    <char style="nd">Waaqayyo</char> saba isaatiif jabina kenna;</para>
  <para style="q2" vid="PSA 29:11">
    <char style="nd">Waaqayyo</char> saba isaa nagaadhaan eebbisa.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">Faarfannaa 30</para>
  <para style="ms1">Galata Nama Afaan Duʼaatii Deebiʼee</para>
  <para style="d">Faarfannaa eebba mana qulqullummaatiif Faarfatame. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>Yaa <char style="nd">Waaqayyo</char>, sababii ati ol na fuutee</para>
  <para style="q2" vid="PSA 30:1">akka diinonni koo natti hin gammanne gooteef,</para>
  <para style="q2" vid="PSA 30:1">ani sin jajadha.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>Yaa <char style="nd">Waaqayyo</char> Waaqa ko,</para>
  <para style="q2" vid="PSA 30:2">ani gargaarsaaf sin waammadhe; atis na fayyifte.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>Yaa <char style="nd">Waaqayyo</char>, ati lubbuu koo siiʼoolii baafte;</para>
  <para style="q2" vid="PSA 30:3">akka ani boolla hin buune gootees na jiraachifte.<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Isin qulqulloonni isaa, faarfannaadhaan <char style="nd">Waaqayyoon</char> jajadhaa;</para>
  <para style="q2" vid="PSA 30:4">maqaa isaa qulqulluu sanaafis galata galchaa.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Dheekkamsi isaa hamma liphsuu ijaa ti;</para>
  <para style="q2" vid="PSA 30:5">gaarummaan isaa immoo bara jireenyaa guutuudhaaf tura;</para>
  <para style="q1" vid="PSA 30:5">booʼichi galgala tokko qofaaf tura;</para>
  <para style="q2" vid="PSA 30:5">ganama garuu ililleetu taʼa.<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Anis yommuun nagaa argadhetti,</para>
  <para style="q2" vid="PSA 30:6">“Ani gonkumaa hin raafamu” nan jedhe.<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>Yaa <char style="nd">Waaqayyo</char>, ati jaalala keetiin</para>
  <para style="q2" vid="PSA 30:7">akka tulluu jabaatti na dhaabde;</para>
  <para style="q1" vid="PSA 30:7">yeroo ati fuula kee na duraa dhoksitetti garuu</para>
  <para style="q2" vid="PSA 30:7">naasuutu na qabate.<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>Yaa <char style="nd">Waaqayyo</char>, ani sin waammadha;</para>
  <para style="q2" vid="PSA 30:8">ani gara Gooftaatti akkana jedhee araaraaf nan iyyadha:<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“Duʼuu koo keessaa, boolla buʼuu koo keessaas</para>
  <para style="q2" vid="PSA 30:9">faayidaa maaliitu argama?</para>
  <para style="q1" vid="PSA 30:9">Biyyoon si galateeffataa?</para>
  <para style="q2" vid="PSA 30:9">Amanamummaa kees ni odeessaa?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>Yaa <char style="nd">Waaqayyo</char> na dhagaʼi; na maaris;</para>
  <para style="q2" vid="PSA 30:10">Yaa <char style="nd">Waaqayyo</char>, gargaarsa naa taʼi.”<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Ati booʼicha koo shuubbisuutti geeddarte;</para>
  <para style="q2" vid="PSA 30:11">wayyaa gaddaa narraa baaftee gammachuu natti uwwifte;<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>kunis akka lubbuun koo faarfannaadhaan si jajattuu fi <optbreak/> akka isheen hin calʼisneefii dha.</para>
  <para style="q2" vid="PSA 30:12">Yaa <char style="nd">Waaqayyo</char> Waaqa ko, ani bara baraan sin galateeffadha.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">Faarfannaa 31</para>
  <para style="ms1">Kadhannaa Yeroo Rakkinaa</para>
  <para style="mr">
    <ref loc="PSA 31:1-4">31:1‑4</ref> kwf – <char style="xt"><ref loc="PSA 71:1-3">Far 71:1‑3</ref></char></para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>Yaa <char style="nd">Waaqayyo</char>, ani kooluu sitti galeera;</para>
  <para style="q2" vid="PSA 31:1">ati gonkumaa na hin qaanessin;</para>
  <para style="q2" vid="PSA 31:1">qajeelummaa keetiin na oolchi.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Gurra kee gara kootti qabi; dafiitii na oolchi;</para>
  <para style="q2" vid="PSA 31:2">kattaa ani itti kooluu galu naa taʼi;</para>
  <para style="q2" vid="PSA 31:2">na oolchuudhaafis daʼoo jabaa naa taʼi.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Ati waan kattaa koo fi daʼoo koo taateef,</para>
  <para style="q2" vid="PSA 31:3">maqaa keetiif jedhiitii na qajeelchi; karaa irras na buusi.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Ati iddoo ani itti baqadhu waan taateef,</para>
  <para style="q2" vid="PSA 31:4">kiyyoo diinonni koo naa kaaʼan keessaa na baasi.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Ani hafuura koo dabarsee harka keettin kennadha;</para>
  <para style="q2" vid="PSA 31:5">yaa <char style="nd">Waaqayyo</char> Waaqa dhugaa, ati na furi.<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Ani warra waaqota faayidaa hin qabne abdatan nan jibba;</para>
  <para style="q2" vid="PSA 31:6">
    <char style="nd">Waaqayyoon</char> garuu nan amanadha.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Ani jaalala kee kan hin geeddaramne sanatti nan gammada; nan ililchas;</para>
  <para style="q2" vid="PSA 31:7">ati dhiphina koo argiteertaatii;</para>
  <para style="q2" vid="PSA 31:7">rakkina lubbuu kootii illee beekteerta.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>Ati dabarsitee diinatti na hin kennine;</para>
  <para style="q2" vid="PSA 31:8">miilla koos iddoo balʼaa irra dhaabdeerta.<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>Yaa <char style="nd">Waaqayyo</char>, ani dhiphina keessan jiraatii na baasi;</para>
  <para style="q2" vid="PSA 31:9">iji koo gaddaan, lubbuun koo fi dhagni koo gaddaan dadhabaniiru.<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Jireenyi koo gaddaan, umuriin koo aaduudhaan dhumeera;</para>
  <para style="q2" vid="PSA 31:10">jabinni koo sababii dhiphina kootiitiif laafeera;</para>
  <para style="q2" vid="PSA 31:10">lafeen koos xuuxameera.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Sababii diinota koo hundaatiif,</para>
  <para style="q2" vid="PSA 31:11">ani olloota koo biratti waan sodaachisaa,</para>
  <para style="q1" vid="PSA 31:11">michoota koo biratti immoo waan jibbisiisaa taʼeera;</para>
  <para style="q2" vid="PSA 31:11">warri karaa irratti na arganis na baqatu.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>Ani akkuma nama duʼeetti irraanfatameera;</para>
  <para style="q2" vid="PSA 31:12">akkuma qodaa cabaas nan taʼe.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Asaasa namoota baayʼee nan dhagaʼaatii;</para>
  <para style="q2" vid="PSA 31:13">kallattii hundaan sodaatu jira!</para>
  <para style="q1" vid="PSA 31:13">Isaan natti malatanii</para>
  <para style="q2" vid="PSA 31:13">lubbuu koo balleessuuf mariʼatan.<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>Yaa <char style="nd">Waaqayyo</char>, ani garuu sin amanadha;</para>
  <para style="q2" vid="PSA 31:14">“Ati Waaqa koo ti” nan jedha.<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Barri koo si harka jira; diinota koo jalaa,</para>
  <para style="q2" vid="PSA 31:15">warra na ariʼatan harkaas na baasi.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Fuulli kee tajaajilaa kee irratti haa ifu;</para>
  <para style="q2" vid="PSA 31:16">jaalala kee kan hin geeddaramne sanaanis na baraari.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>Yaa <char style="nd">Waaqayyo</char>, ani hin qaaneffamin;</para>
  <para style="q2" vid="PSA 31:17">ani si waammadheeraatii;</para>
  <para style="q1" vid="PSA 31:17">warri hamoon garuu haa qaaneffaman;</para>
  <para style="q2" vid="PSA 31:17">calʼisaniis siiʼool keessa haa buʼan.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>Afaan soba dubbatu,</para>
  <para style="q2" vid="PSA 31:18">kan of tuulummaa fi tuffiidhaan,</para>
  <para style="q2" vid="PSA 31:18">nama qajeelaatti kooree dubbatu haa duudu.<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>Gaarummaan kee kan ati warra si sodaataniif ol keesse,</para>
  <para style="q2" vid="PSA 31:19">kan ati fuula namootaa duratti</para>
  <para style="q2" vid="PSA 31:19">warra kooluu sitti galaniif kennite akkam guddaa dha!<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Daʼoo fuula keetiitiin,</para>
  <para style="q2" vid="PSA 31:20">waan namoonni isaanitti malatan jalaa isaan dhoksita;</para>
  <para style="q2" vid="PSA 31:20">dunkaana kee keessattis dubbiin tuttuquu jalaa isaan daʼeessita.<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>
    <char style="nd">Waaqayyo</char> haa eebbifamu;</para>
  <para style="q2" vid="PSA 31:21">inni yeroo ani magaalaa marfamte keessa turetti,</para>
  <para style="q2" vid="PSA 31:21">jaalala isaa dinqisiisaa sana na argisiiseeraatii.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Ani yeroon akka malee dhiphadhetti,</para>
  <para style="q2" vid="PSA 31:22">“Ani fuula kee duraa badeera!” jedheen ture.</para>
  <para style="q1" vid="PSA 31:22">Ati garuu yeroo ani gargaarsaaf sitti iyyadhetti,</para>
  <para style="q2" vid="PSA 31:22">kadhannaa koo naa dhageesse.<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>Qulqulloonni isaa hundinuu, <char style="nd">Waaqayyoon</char> jaalladhaa!</para>
  <para style="q2" vid="PSA 31:23">
    <char style="nd">Waaqayyo</char> amanamoota ni eega;</para>
  <para style="q2" vid="PSA 31:23">of tuultotaaf garuu akkuma hojii isaaniitti irra dabarsee deebisaaf.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Warri <char style="nd">Waaqayyoon</char> abdattan hundinuu jabaadhaa;</para>
  <para style="q2" vid="PSA 31:24">garaan keessan hin sodaatin.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">Faarfannaa 32</para>
  <para style="ms1">Cubbuu Himachuu</para>
  <para style="d">Faarfannaa Daawit. <char style="tl">Maskiil.</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>Namni yakki isaa dhiifameef,</para>
  <para style="q2" vid="PSA 32:1">kan cubbuun isaas haguugameef,</para>
  <para style="q2" vid="PSA 32:1">eebbifamaa dha.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>Namni <char style="nd">Waaqayyo</char> cubbuu itti hin lakkoofne,</para>
  <para style="q2" vid="PSA 32:2">kan hafuura isaa keessas gowwoomsaan hin jirre,</para>
  <para style="q2" vid="PSA 32:2">eebbifamaa dha.<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Yeroo ani cubbuu koo himachuu dhiisetti,</para>
  <para style="q2" vid="PSA 32:3">guyyaa guutuu aaduu kootiin,</para>
  <para style="q2" vid="PSA 32:3">lafeen koo ni bosose.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Harki kee halkanii fi guyyaa natti ulfaateeraatii;</para>
  <para style="q2" vid="PSA 32:4">jabinni koos akkuma waan hoʼa bonaatiin taʼuutti xuuxame.<verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>Ergasiis cubbuu koo sitti nan himadhe;</para>
  <para style="q2" vid="PSA 32:5">balleessaa koos si hin dhokfanne.</para>
  <para style="q1" vid="PSA 32:5">Anis, “Irra daddarba koo, <char style="nd">Waaqayyootti</char> nan himadha” nan jedhe;</para>
  <para style="q2" vid="PSA 32:5">atis yakka cubbuu kootii, naa dhiifteerta.<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Kanaafuu namni amanamaan kam iyyuu,</para>
  <para style="q2" vid="PSA 32:6">yeroo ati itti argamtutti si haa kadhatu;</para>
  <para style="q2" vid="PSA 32:6">lolaan bishaan guddaas isa bira hin gaʼu.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>Ati iddoo ani itti dhokadhuu dha;</para>
  <para style="q2" vid="PSA 32:7">rakkina irraa na eegda;</para>
  <para style="q2" vid="PSA 32:7">faarfannaa moʼannaatiinis na marsita.<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>Ani karaa ati irra deemtu irratti sin qajeelcha; sin barsiisas;</para>
  <para style="q2" vid="PSA 32:8">ani ija koo jaalalaatiin sin ilaala; sin gorsa.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Isin akka farda yookaan gaangoo</para>
  <para style="q2" vid="PSA 32:9">hubannaa hin qabnee hin taʼinaa;</para>
  <para style="q1" vid="PSA 32:9">isaan yoo luugamaa fi fuuloodhaan qabaman malee</para>
  <para style="q2" vid="PSA 32:9">gara kee hin dhufan.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Dhiphinni namoota hamoo baayʼee dha;</para>
  <para style="q2" vid="PSA 32:10">araarri <char style="nd">Waaqayyoo</char> garuu nama isa amanatu ni marsa.<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>Yaa qajeeltota, isin <char style="nd">Waaqayyotti</char> gammadaa; ililchaas;</para>
  <para style="q2" vid="PSA 32:11">warri garaa qulqulluu qabdan hundinuu ililchaa.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">Faarfannaa 33</para>
  <para style="ms1">Waaqa Jajachuu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>Yaa qajeeltota, isin <char style="nd">Waaqayyotti</char> gammadaa;</para>
  <para style="q2" vid="PSA 33:1">isa jajuun tolootaaf ni mala.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>Kiraaraan <char style="nd">Waaqayyoon</char> galateeffadhaa;</para>
  <para style="q2" vid="PSA 33:2">baganaa ribuu kudhan qabuun isaaf faarfadhaa.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Faarfannaa haaraa isaaf faarfadhaa; ribuu haalaan rukutaa;</para>
  <para style="q2" vid="PSA 33:3">sirriitti rukutaa; gammachuudhaanis ililchaa.<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>Dubbiin <char style="nd">Waaqayyoo</char> qajeelaadhaatii;</para>
  <para style="q2" vid="PSA 33:4">inni waan hojjetu hundumaatti amanamaa dha.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>
    <char style="nd">Waaqayyo</char> qajeelummaa fi murtii qajeelaa jaallata;</para>
  <para style="q2" vid="PSA 33:5">laftis jaalala isaa kan hin geeddaramneen guutamteerti.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>Samiiwwan dubbii <char style="nd">Waaqayyootiin</char> hojjetaman;</para>
  <para style="q2" vid="PSA 33:6">tuunni urjiiwwanii hundinuus <optbreak/> hafuura afaan isaatii baʼuun uumaman.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Inni bishaan galaanaa akka tuullaatti walitti qaba;</para>
  <para style="q2" vid="PSA 33:7">bishaan tuujubaas kuusaa keessa kaaʼa.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Lafti hundi <char style="nd">Waaqayyoon</char> haa sodaatu;</para>
  <para style="q2" vid="PSA 33:8">sabni addunyaa irra jiraatu hundinuus, guddisee isa haa sodaatu.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Inni dubbateeraatii, wanni inni dubbate ni taʼe;</para>
  <para style="q2" vid="PSA 33:9">inni ni ajaje; wanni inni ajajes ni raawwate.<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>
    <char style="nd">Waaqayyo</char> marii sabootaa ni fashaleessa;</para>
  <para style="q2" vid="PSA 33:10">akka karoorri namootaa hojii irra hin oolles ni godha.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>Karoorri <char style="nd">Waaqayyoo</char> garuu bara baraan, yaadni garaa isaas</para>
  <para style="q2" vid="PSA 33:11">dhaloota hundumaa keessatti cimee ni dhaabata.<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Sabni <char style="nd">Waaqayyo</char> Waaqa isaaf taʼe,</para>
  <para style="q2" vid="PSA 33:12">namoonni inni akka dhaala ofii isaatti filate eebbifamoo dha.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>
    <char style="nd">Waaqayyo</char> samii irraa gad ni ilaala;</para>
  <para style="q2" vid="PSA 33:13">ilmaan namootaa hundas ni arga;<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>inni teessoo isaa irra taaʼee,</para>
  <para style="q2" vid="PSA 33:14">warra lafa irra jiraatan hunda gad ilaala;<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>inni garaa nama hundumaa uumu sun,</para>
  <para style="q2" vid="PSA 33:15">hojii isaanii hunda ni hubata.<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>Mootiin baayʼina loltoota isaatiin duʼa hin oolu;</para>
  <para style="q2" vid="PSA 33:16">jagnis guddina humna isaatiin duʼa jalaa hin baʼu.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Fardi moʼannaadhaaf abdii gatii hin qabnee dha;</para>
  <para style="q2" vid="PSA 33:17">guddinni humna isaas nama hin oolchu.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>Garuu iji <char style="nd">Waaqayyoo</char> warra isa sodaatan irra,</para>
  <para style="q2" vid="PSA 33:18">warra araara isaa abdatan irras jira;<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>inni lubbuu isaanii duʼa jalaa ni baasa;</para>
  <para style="q2" vid="PSA 33:19">bara beelaas isaan ni jiraachisa.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Lubbuun keenya abdiidhaan <char style="nd">Waaqayyoon</char> eeggatti;</para>
  <para style="q2" vid="PSA 33:20">innis gargaarsa keenyaa fi gaachana keenya.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Garaan keenya isatti ni gammadaatii;</para>
  <para style="q2" vid="PSA 33:21">nu maqaa isaa qulqulluu ni amanannaatii.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>Yaa <char style="nd">Waaqayyo</char>, akkuma nu abdii keenya</para>
  <para style="q2" vid="PSA 33:22">sirra kaaʼannutti, araarri kee nurra haa buʼu.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">Faarfannaa 34</para>
  <para style="ms1">Waaqa Murtii Qajeelaa Jajachuu</para>
  <para style="d">Faarfannaa Daawit. Innis fuula Abiimelek duratti maraatuu of fakkeesseef Abiimelek isa ariinaan yeroo achii deemetti faarfate.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>Ani yeroo hunda <char style="nd">Waaqayyoon</char> nan eebbisa;</para>
  <para style="q2" vid="PSA 34:1">galanni isaas yeroo hunda afaanii na hin buʼu.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Lubbuun koo <char style="nd">Waaqayyoon</char> boonti;</para>
  <para style="q2" vid="PSA 34:2">cunqurfamtoonni dhagaʼanii haa gammadan.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>Na wajjin <char style="nd">Waaqayyoof</char> ulfina kennaa;</para>
  <para style="q2" vid="PSA 34:3">kottaa walii wajjin maqaa isaa ol kaafnaa.<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>
    <char style="nd">Waaqayyoon</char> nan barbaaddadhe; innis deebii naa kenne;</para>
  <para style="q2" vid="PSA 34:4">sodaa koo hunda keessaas na baase.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Warri gara isaa ilaalan ni ifu;</para>
  <para style="q2" vid="PSA 34:5">fuulli isaaniis yoom iyyuu hin qaanaʼu.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Hiyyeessi kun ni iyye; <char style="nd">Waaqayyos</char> isa dhagaʼe;</para>
  <para style="q2" vid="PSA 34:6">rakkina isaa hundumaa keessaas isa baase.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>Ergamaan <char style="nd">Waaqayyoo</char> naannoo warra Waaqa sodaatanii</para>
  <para style="q2" vid="PSA 34:7">ni qubata; isaan ni oolchas.<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>Akka <char style="nd">Waaqayyo</char> gaarii taʼe mee miʼeeffadhaa ilaalaa;</para>
  <para style="q2" vid="PSA 34:8">namni isatti kooluu galu eebbifamaa dha.<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>Isin qulqulloonni isaa <char style="nd">Waaqayyoon</char> sodaadhaa;</para>
  <para style="q2" vid="PSA 34:9">warri isa sodaatan homaa hin dhabaniitii.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Leenci saafelli iyyuu waa ni dhaba; ni beelaʼas;</para>
  <para style="q2" vid="PSA 34:10">namni <char style="nd">Waaqayyoon</char> barbaaddatu garuu <optbreak/> waan gaarii tokko illee hin dhabu.<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Yaa ijoollee ko, kottaa na dhagaʼaa;</para>
  <para style="q2" vid="PSA 34:11">anis <char style="nd">Waaqayyoon</char> sodaachuu isinan barsiisa.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Namni jireenya jaallatu, kan bara gaarii arguudhaafis</para>
  <para style="q2" vid="PSA 34:12">bara baayʼee hawwu eenyu?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>Arraba kee waan hamaa irraa,</para>
  <para style="q2" vid="PSA 34:13">afaan kees soba dubbachuu irraa eeggadhu.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Hammina irraa deebiʼi; gaarii hojjedhu;</para>
  <para style="q2" vid="PSA 34:14">nagaa barbaadi; duukaa buʼis.<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>Iji <char style="nd">Waaqayyoo</char> qajeeltota irra jira;</para>
  <para style="q2" vid="PSA 34:15">gurri isaas iyya isaaniitiif banamaa dha;<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>yaadannoo isaanii lafa irraa balleessuudhaaf,</para>
  <para style="q2" vid="PSA 34:16">fuulli <char style="nd">Waaqayyoo</char> warra hamaa hojjetanitti ni hammaata.<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>Qajeeltonni gargaarsaaf iyyatu; <char style="nd">Waaqayyos</char> isaan dhagaʼa.</para>
  <para style="q2" vid="PSA 34:17">Rakkina isaanii hunda keessaas isaan baasa.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>
    <char style="nd">Waaqayyo</char> warra garaan isaanii cabetti dhiʼoo dha;</para>
  <para style="q2" vid="PSA 34:18">warra abdii kutatanis ni fayyisa.<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>Rakkinni nama qajeelaa baayʼee dha;</para>
  <para style="q2" vid="PSA 34:19">
    <char style="nd">Waaqayyo</char> garuu hunda isaa jalaa isa baasa;<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>lafee isaa hunda ni eega;</para>
  <para style="q2" vid="PSA 34:20">isaan keessaas tokko illee hin cabu.<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>Hamoota hamminatu ajjeesa;</para>
  <para style="q2" vid="PSA 34:21">warra nama qajeelaa jibbanitti ni murteeffama.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>
    <char style="nd">Waaqayyo</char> lubbuu tajaajiltoota isaa ni fura;</para>
  <para style="q2" vid="PSA 34:22">warra isatti kooluu galan keessaa tokkotti illee hin murteeffamu.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">Faarfannaa 35</para>
  <para style="ms1">Kadhannaa Nama Dhiphatee</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>Yaa <char style="nd">Waaqayyo</char>, warra anaan mormaniin mormi;</para>
  <para style="q2" vid="PSA 35:1">warra na lolanis loli.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>Gaachanaa fi miʼa lolaa qabadhu;</para>
  <para style="q2" vid="PSA 35:2">na gargaaruudhaafis kaʼi.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Warra na ariʼanitti</para>
  <para style="q2" vid="PSA 35:3">eeboo fi bodee luqqifadhu.</para>
  <para style="q1" vid="PSA 35:3">Lubbuu kootiinis,</para>
  <para style="q2" vid="PSA 35:3">“Fayyinni kee ana” jedhi.<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>Warri lubbuu koo barbaadan,</para>
  <para style="q2" vid="PSA 35:4">haa qaanaʼan; haa salphatanis;</para>
  <para style="q1" vid="PSA 35:4">warri na balleessuuf mariʼatanis,</para>
  <para style="q2" vid="PSA 35:4">abdii kutatanii duubatti haa deebiʼan.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>Akka habaqii qilleensaan fudhatamee haa taʼan;</para>
  <para style="q2" vid="PSA 35:5">ergamaan <char style="nd">Waaqayyoos</char> isaan haa ariʼu.<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>Karaan isaanii dukkanaaʼaa fi mucucaataa haa taʼu;</para>
  <para style="q2" vid="PSA 35:6">ergamaan <char style="nd">Waaqayyoos</char> isaan haa ariʼu.<verse eid="PSA 35:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Isaan sababii malee kiyyoo isaanii dhoksanii <optbreak/> na dura kaaʼaniiruutii;</para>
  <para style="q2" vid="PSA 35:7">sababii malees boolla naa qotaniiru;<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>utuu inni hin beekin badiisni isatti haa dhufu;</para>
  <para style="q2" vid="PSA 35:8">kiyyoon inni dhokse sunis isuma haa qabu;</para>
  <para style="q2" vid="PSA 35:8">boolluma qote sanattis haa kufu.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>Yoos lubbuun ko, <char style="nd">Waaqayyotti</char> gammaddi;</para>
  <para style="q2" vid="PSA 35:9">fayyisuu isaattis ni ililchiti.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Lafeen koo hundi akkana siin jedha:</para>
  <para style="q2" vid="PSA 35:10">“Yaa <char style="nd">Waaqayyo</char>, kan akka keetii eenyu?</para>
  <para style="q1" vid="PSA 35:10">Ati dadhabdoota warra isaan caalaa jabaatan jalaa baafta;</para>
  <para style="q2" vid="PSA 35:10">hiyyeeyyii fi rakkattoota illee saamtota jalaa baafta.”<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>Dhuga baatonni sobaa natti kaʼan;</para>
  <para style="q2" vid="PSA 35:11">waan ani waaʼee isaa hin beeknes na gaafatu.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Isaan qooda waan gaarii waan hamaa naa deebisu;</para>
  <para style="q2" vid="PSA 35:12">lubbuu koos kophaatti hambisu.<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>Ani garuu yeroo isaan dhibamanitti, <optbreak/> wayyaa gaddaa nan uffadhe;</para>
  <para style="q2" vid="PSA 35:13">lubbuu koos soomaan nan miidhe.</para>
  <para style="q1" vid="PSA 35:13">Yeroo kadhannaan koo deebii malee hafettis<verse eid="PSA 35:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14"/>ani akkuma waan michuu kootiif yookaan obboleessa kootiif gadduutti,</para>
  <para style="q2" vid="PSA 35:14">gaddaan asii fi achi deddeebiʼe.</para>
  <para style="q1" vid="PSA 35:14">Akkuma waan haadha kootiif booʼuuttis,</para>
  <para style="q2" vid="PSA 35:14">gaddaan mataa koo nan buuse.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>Isaan garuu yeroo ani gufadhetti gammadanii walitti qabaman;</para>
  <para style="q2" vid="PSA 35:15">utuu ani hin beekin na marsan;</para>
  <para style="q2" vid="PSA 35:15">utuu wal irraa hin kutinis na cicciratan.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Isaan akkuma warra Waaqatti hin bulleetti hamminaan natti qoosan;</para>
  <para style="q2" vid="PSA 35:16">ilkaan isaanii illee natti qaratan.<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>Yaa Gooftaa, ati hamma yoomiitti calʼistee ilaalta?</para>
  <para style="q2" vid="PSA 35:17">Lubbuu koo badiisa isaan fidan jalaa,</para>
  <para style="q2" vid="PSA 35:17">jireenya koos leenca jalaa baasi.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>Ani wal gaʼii guddaa keessatti sin galateeffadha;</para>
  <para style="q2" vid="PSA 35:18">tuuta guddaa keessatti sin jajadha.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>Warri akkasumaan diina natti taʼan natti hin gammadin;</para>
  <para style="q2" vid="PSA 35:19">warri sababii malee na jibban sunis ija natti hin qisin.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Isaan nagaa hin dubbatan;</para>
  <para style="q2" vid="PSA 35:20">warra qabbanaan biyya keessa jiraatanittis,</para>
  <para style="q2" vid="PSA 35:20">mala sobaa malatu.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Isaanis, “Baga! Baga! Ijuma keenyaan isa argine”</para>
  <para style="q2" vid="PSA 35:21">jedhanii afaan natti banatu.<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>Yaa <char style="nd">Waaqayyo</char>, ati waan kana argiteerta; hin calʼisin.</para>
  <para style="q2" vid="PSA 35:22">Yaa gooftaa, narraa hin fagaatin.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>Yaa Waaqa koo fi Gooftaa ko, ati mirga kootiif,</para>
  <para style="q2" vid="PSA 35:23">dhimma kootiifis dammaqi; kaʼi!<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>Yaa <char style="nd">Waaqayyo</char> Waaqa ko,</para>
  <para style="q2" vid="PSA 35:24">akkuma qajeelummaa keetiitti naa murteessi;</para>
  <para style="q2" vid="PSA 35:24">akka isaan natti gammadanis hin godhin.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Akka isaan, “Baga! Akkuma nu barbaanne taʼeera!” jedhan,</para>
  <para style="q2" vid="PSA 35:25">yookaan akka isaan, “Nu isa liqimsineerra” jedhan hin godhin.<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Warri dhiphina kootti gammadan hundinuu</para>
  <para style="q2" vid="PSA 35:26">haa qaanaʼan; haa burjaajaʼanis;</para>
  <para style="q1" vid="PSA 35:26">warri natti kooran hundinuus,</para>
  <para style="q2" vid="PSA 35:26">qaanii fi salphina haa uffatan.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Warri qajeelumma koo jaallatan,</para>
  <para style="q2" vid="PSA 35:27">sagalee guddaadhaan haa ililchan; haa gammadanis.</para>
  <para style="q1" vid="PSA 35:27">Isaan yeroo hunda,</para>
  <para style="q2" vid="PSA 35:27">“<char style="nd">Waaqayyo</char> inni nagaa garbicha isaatti gammadu <optbreak/> guddaa dha” haa jedhan.<verse eid="PSA 35:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Arrabni koo qajeelummaa kee,</para>
  <para style="q2" vid="PSA 35:28">guyyaa guutuus galata kee odeessa.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">Faarfannaa 36</para>
  <para style="ms1">Jalʼina Namaatii Fi Gaarummaa Waaqayyoo</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit Garbicha <char style="nd">Waaqayyoo</char>.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>Ani waaʼee cubbamootaa,</para>
  <para style="q2" vid="PSA 36:1">ergaa Waaqa bira dhufe garaa koo keessaa qaba:</para>
  <para style="q2" vid="PSA 36:1">Waaqa sodaachuun ija isaanii dura hin jiru.<verse eid="PSA 36:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>Akka cubbuun isaanii ifatti baʼee hin jibbamneefis,</para>
  <para style="q2" vid="PSA 36:2">isaan ijuma ofii isaanii duratti akka malee of saadu.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>Dubbiin afaan isaanii jalʼinaa fi gowwoomsaa dha;</para>
  <para style="q2" vid="PSA 36:3">isaan ogummaadhaan hojjechuu fi waan gaarii gochuu dhiisaniiru.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Siree isaanii irratti iyyuu isaan hammina xaxu;</para>
  <para style="q2" vid="PSA 36:4">karaa cubbuutti of kennu; waan hamaas hin lagatan.<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>Yaa <char style="nd">Waaqayyo</char>, araarri kee samiiwwan bira,</para>
  <para style="q2" vid="PSA 36:5">amanamummaan kees duumessa bira gaʼa.<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>Qajeelummaan kee akka tulluuwwan gurguddaa ti;</para>
  <para style="q2" vid="PSA 36:6">murtiin kees akkuma tuujuba guddaa ti.</para>
  <para style="q2" vid="PSA 36:6">Yaa <char style="nd">Waaqayyo</char>, ati namaa fi bineensa ni jiraachifta.<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>Yaa Waaqi, jaalalli kee inni hin geeddaramne sun akkam ulfina qabeessa!</para>
  <para style="q2" vid="PSA 36:7">Ilmaan namootaa, gaaddisa qoochoo keetii jalatti kooluu galu.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Isaan badhaadhummaa mana keetii nyaatanii quufu;</para>
  <para style="q2" vid="PSA 36:8">atis laga gammachuu keetii irraa isaan obaafta.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>Burqaan jireenyaa si bira jiraatii;</para>
  <para style="q2" vid="PSA 36:9">nu ifa keetiin ifa argina.<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>Jaalala kee warra si beekaniif,</para>
  <para style="q2" vid="PSA 36:10">qajeelummaa kees gara toleeyyiidhaaf ittuma fufi.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Miilli of tuultotaa natti hin dhufin;</para>
  <para style="q2" vid="PSA 36:11">harki hamootaas dhiibee na hin fageessin.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Warri waan hamaa hojjetan kunoo kufanii diriiraniiru;</para>
  <para style="q2" vid="PSA 36:12">gad darbatamaniiru; kaʼuus hin dandaʼan!<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">Faarfannaa 37</para>
  <para style="ms1">Qooda Nama Qajeelaa Fi Hamaa</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>Ati sababii namoota hamootiif jettee hin aarin</para>
  <para style="q2" vid="PSA 37:1">yookaan warra jalʼina hojjetanitti hin hinaafin.<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>Isaan akkuma margaa dafanii coollagu;</para>
  <para style="q2" vid="PSA 37:2">akkuma biqiltuu misee dafanii gogu.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>
    <char style="nd">Waaqayyoon</char> amanadhu; waan gaariis hojjedhu;</para>
  <para style="q2" vid="PSA 37:3">biyyattii keessa jiraadhu; nagaas qabaadhu.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>
    <char style="nd">Waaqayyotti</char> gammadi;</para>
  <para style="q2" vid="PSA 37:4">innis hawwii garaa keetii siif guuta.<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>Karaa kee <char style="nd">Waaqayyotti</char> kennadhu;</para>
  <para style="q2" vid="PSA 37:5">isa amanadhu; inni siif milkeessa.<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>Inni qajeelummaa kee akka aduu ganamaatti,</para>
  <para style="q2" vid="PSA 37:6">murtii kee immoo akka aduu saafaatti ibsa.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>
    <char style="nd">Waaqayyo</char> duratti calʼisi;</para>
  <para style="q2" vid="PSA 37:7">obsaanis isa eeggadhu;</para>
  <para style="q1" vid="PSA 37:7">nama karaan isaa qajeeleefitti,</para>
  <para style="q2" vid="PSA 37:7">kan hammina hojjetuttis hin hinaafin.<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Aarii irraa of eegi; dheekkamsa irraas deebiʼi;</para>
  <para style="q2" vid="PSA 37:8">hin aarin; aariin hammina qofatti nama geessaatii.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Namoonni hamoon ni balleeffamuutii;</para>
  <para style="q2" vid="PSA 37:9">warri <char style="nd">Waaqayyoon</char> abdatan garuu lafa dhaalu.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Namoonni hamoon yeroo xinnoodhaaf malee siʼachi hin jiraatan;</para>
  <para style="q2" vid="PSA 37:10">yoo ati isaan barbaadde illee hin argaman.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>Garraamonni garuu lafa ni dhaalu;</para>
  <para style="q2" vid="PSA 37:11">nagaa guddaadhaanis ni gammadu.<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Namoonni hamoon nama qajeelaatti mariʼatu;</para>
  <para style="q2" vid="PSA 37:12">ilkaan isaaniis isatti qaratu;<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>Gooftaan hamootatti ni kolfa;</para>
  <para style="q2" vid="PSA 37:13">inni akka guyyaan isaanii dhiʼaate ni beekaatii.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Namoonni hamoon hiyyeeyyii fi</para>
  <para style="q2" vid="PSA 37:14">rakkattoota lafaan dhaʼuudhaaf,</para>
  <para style="q1" vid="PSA 37:14">warra karaan isaanii qajeelaa taʼe immoo gorraʼuudhaaf,</para>
  <para style="q2" vid="PSA 37:14">goraadee isaanii luqqifatu; iddaa isaaniis ni dabsatu.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>Goraadeen isaanii garuu garaadhuma isaanii waraana;</para>
  <para style="q2" vid="PSA 37:15">iddaan isaaniis ni caccaba.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>Badhaadhummaa hamoonni baayʼeen qaban irra,</para>
  <para style="q2" vid="PSA 37:16">waan xinnoo namni qajeelaan qabu wayya;<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>humni hamootaa ni cabaatii;</para>
  <para style="q2" vid="PSA 37:17">
    <char style="nd">Waaqayyo</char> garuu qajeeltota jabeessee ni dhaaba.<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>
    <char style="nd">Waaqayyo</char> bara tolootaa ni beeka;</para>
  <para style="q2" vid="PSA 37:18">dhaalli isaaniis bara baraan jiraata.<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>Isaan bara hamaa keessa hin qaanaʼan;</para>
  <para style="q2" vid="PSA 37:19">bara beelaa keessas ni quufu.<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>Namoonni hamoon garuu ni barbadaaʼu;</para>
  <para style="q2" vid="PSA 37:20">diinonni <char style="nd">Waaqayyoos</char> akkuma miidhagina daraaraa dirree ti;</para>
  <para style="q2" vid="PSA 37:20">isaan ni badu; akkuma aaraa ni badu.<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Namoonni hamoon ni liqeeffatu;</para>
  <para style="q2" vid="PSA 37:21">garuu deebisanii of irraa hin baasan;</para>
  <para style="q2" vid="PSA 37:21">qajeeltonni garuu arjummaadhaan kennu;<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>warri <char style="nd">Waaqayyo</char> eebbisu lafa ni dhaalu;</para>
  <para style="q2" vid="PSA 37:22">warri inni abaaru garuu ni balleeffamu.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>Adeemsi nama <char style="nd">Waaqayyo</char> biraa ajajama;</para>
  <para style="q2" vid="PSA 37:23">inni karaa namicha sanaatti ni gammada.<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>Inni yoo gufate illee lafa hin gaʼu;</para>
  <para style="q2" vid="PSA 37:24">
    <char style="nd">Waaqayyo</char> harka isaatiin qabee isa dhaabaatii.<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Ani dargaggeessan ture; amma immoo dulloomeera;</para>
  <para style="q2" vid="PSA 37:25">garuu qajeeltonni gatamuu isaanii</para>
  <para style="q2" vid="PSA 37:25">yookaan ijoolleen isaaniis buddeena kadhachuu isaanii hin argine.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>Qajeeltonni yeroo hundumaa ni arjoomu; ni liqeessus;</para>
  <para style="q2" vid="PSA 37:26">ijoolleen isaaniis ni eebbifamu.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Waan hamaa irraa deebiʼiitii waan gaarii hojjedhu;</para>
  <para style="q2" vid="PSA 37:27">yoos ati bara baraan ni jiraatta.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>
    <char style="nd">Waaqayyo</char> murtii qajeelaa jaallataatii;</para>
  <para style="q2" vid="PSA 37:28">warra isaaf amanamanis hin gatu.</para>
  <para style="b" vid="PSA 37:28"/>
  <para style="q1" vid="PSA 37:28">Isaanis bara baraan ni eegamu;</para>
  <para style="q2" vid="PSA 37:28">sanyiin hamootaa garuu ni balleeffama.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>Qajeeltonni lafa ni dhaalu;</para>
  <para style="q2" vid="PSA 37:29">bara baraanis ishee irra ni jiraatu.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Afaan nama qajeelaa ogummaa dubbata;</para>
  <para style="q2" vid="PSA 37:30">arrabni isaas murtii qajeelaa labsa.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>Seerri Waaqa isaa garaa isaa keessa jira;</para>
  <para style="q2" vid="PSA 37:31">miilli isaas hin mucucaatu.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Namoonni hamoon qajeeltota gaadu;</para>
  <para style="q2" vid="PSA 37:32">isaan ajjeesuus ni barbaadu;<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>
    <char style="nd">Waaqayyo</char> garuu harka isaaniitti jara hin dhiisu</para>
  <para style="q2" vid="PSA 37:33">yookaan yommuu isaan murtiitti dhiʼeeffamanitti,</para>
  <para style="q2" vid="PSA 37:33">akka isaanitti murteeffamu hin eeyyamu.<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>
    <char style="nd">Waaqayyoon</char> eeggadhu; karaa isaas eegi.</para>
  <para style="q2" vid="PSA 37:34">Inni akka ati lafa dhaaltuuf ulfina siif kenna;</para>
  <para style="q2" vid="PSA 37:34">atis badiisa hamootaa ni argita.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Nama hamaa fi gara jabeessa,</para>
  <para style="q2" vid="PSA 37:35">isaa akkuma muka iddoon isaa itti tolee jiru nan arge.<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>Ergasiis achiin nan darbe; inni garuu achi hin turre;</para>
  <para style="q2" vid="PSA 37:36">ani cimsee isa nan barbaade; inni garuu hin argamne.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Nama mudaa hin qabne yaadatti qabadhu; tolootas ilaali;</para>
  <para style="q2" vid="PSA 37:37">sanyiin nama nagaa hin baduutii.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>Cubbamoonni hundinuu garuu ni barbadeeffamu;</para>
  <para style="q2" vid="PSA 37:38">galgalli nama hamaas hin tolu.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>Fayyinni qajeeltotaa <char style="nd">Waaqayyo</char> biraa dhufa;</para>
  <para style="q2" vid="PSA 37:39">inni yeroo rakkinaatti daʼoo isaanii ti.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>
    <char style="nd">Waaqayyo</char> isaan gargaara; isaan oolchas;</para>
  <para style="q2" vid="PSA 37:40">harka namoota hamoo jalaa isaan baasa;</para>
  <para style="q2" vid="PSA 37:40">isaan baraaras; isaan isatti kooluu galaniiruutii.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">Faarfannaa 38</para>
  <para style="ms1">Kadhannaa yeroo dhiphinaa</para>
  <para style="d">Faarfannaa Daawit. Yaadannoodhaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>Yaa <char style="nd">Waaqayyo</char>, aarii keetiin na hin ifatin</para>
  <para style="q2" vid="PSA 38:1">yookaan dheekkamsa keetiin na hin adabin.<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>Xiyyooliin kee na waraananiiru;</para>
  <para style="q2" vid="PSA 38:2">harki kees akka malee natti ulfaateera.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>Sababii dheekkamsa keetiitiif dhagni koo fayyaa dhabeera;</para>
  <para style="q2" vid="PSA 38:3">sababii cubbuu kootiifis lafeen koo nagaa dhabeera.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Cubbuun koo na liqimseeraatii;</para>
  <para style="q2" vid="PSA 38:4">akkuma baʼaa baatamuu hin dandaʼamne tokkoottis natti ulfaateera.<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Sababii gowwummaa kootiitiif,</para>
  <para style="q2" vid="PSA 38:5">madaan koo malaa naqate; ni ajaaʼes.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Ani gad nan qabame; gadis nan cabe;</para>
  <para style="q2" vid="PSA 38:6">guyyaa guutuus gaddaan oola.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Dugdi koo na bobaʼa;</para>
  <para style="q2" vid="PSA 38:7">dhagni koos fayyaa hin qabu.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Ani laafeera; akka malees bututeera;</para>
  <para style="q2" vid="PSA 38:8">garaan koo dhiphatee ani aadaan jira.<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>Yaa Gooftaa, hawwiin koo hundinuu fuula kee duratti beekamaa dha;</para>
  <para style="q2" vid="PSA 38:9">argansuun koo si duraa hin dhokatu.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>Lapheen koo ni dhaʼatti; jilbis na laafeera;</para>
  <para style="q2" vid="PSA 38:10">ifni ija kootiis badeera.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Michoonni koo fi miiltoon koo sababii madaa kootiitiif narraa hiiqan;</para>
  <para style="q2" vid="PSA 38:11">firoonni koos narraa fagaatanii dhadhaabatu.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Warri lubbuu koo galaafachuu barbaadan kiyyoo naa kaaʼaniiru;</para>
  <para style="q2" vid="PSA 38:12">warri na miidhuu barbaadanis waaʼee badiisa kootii dubbatu;</para>
  <para style="q2" vid="PSA 38:12">guyyaa guutuus hammina natti yaadu.<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Ani garuu akkuma duudaa dhagaʼuu hin dandeenyee,</para>
  <para style="q2" vid="PSA 38:13">akkuma arrab-didaa dubbachuu hin dandeenyeetii.<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Ani akka nama dhagaʼuu hin dandeenyee,</para>
  <para style="q2" vid="PSA 38:14">akkuma nama afaan isaa deebii kennuu hin dandeenyees taʼeera.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>Yaa <char style="nd">Waaqayyo</char>, ani sin eeggadha;</para>
  <para style="q2" vid="PSA 38:15">yaa Waaqayyo Gooftaa ko, ati deebii naa kennita.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Ani, “Akka diinonni koo natti gammadan</para>
  <para style="q2" vid="PSA 38:16">yookaan akka isaan yeroo miilli koo mucucaatutti natti of jajan</para>
  <para style="q2" vid="PSA 38:16">hin eeyyamin” jedheeraatii.<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Ani kufuu gaʼeeraatii;</para>
  <para style="q2" vid="PSA 38:17">dhukkubbiin koos takkumaa na hin dhiifne.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Ani balleessaa koo nan himadha;</para>
  <para style="q2" vid="PSA 38:18">sababii cubbuu kootiitiifis nan gadda.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Warri akkasumaan diinota koo taʼan jajjaboo dha;</para>
  <para style="q2" vid="PSA 38:19">warri sababii malee na jibbanis hedduu dha.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Warri qooda waan gaarii waan hamaa naa deebisan diinota koo ti;</para>
  <para style="q2" vid="PSA 38:20">ani waan gaarii duukaa nan buʼaatii.<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>Yaa <char style="nd">Waaqayyo</char>, ati na hin gatin;</para>
  <para style="q2" vid="PSA 38:21">yaa Waaqa ko, narraa hin fagaatin.<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>Yaa Gooftaa, yaa fayyisaa ko,</para>
  <para style="q2" vid="PSA 38:22">na gargaaruudhaaf ariifadhu!<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">Faarfannaa 39</para>
  <para style="ms1">Fuula Waaqaa Duratti Namni Xinnaa Dha</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeduutuuniif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>Ani akkana nan jedhe; “Ani karaa koo nan eeggadha;</para>
  <para style="q2" vid="PSA 39:1">arraba koos cubbuu irraa nan ittisa;</para>
  <para style="q1" vid="PSA 39:1">hamma namni hamaan na bira jiruttis,</para>
  <para style="q2" vid="PSA 39:1">afaan kootti luugama nan kaaʼadha.”<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>Ani calʼisee akkuma duudaa nan taʼe;</para>
  <para style="q2" vid="PSA 39:2">waan gaarii dubbachuu irraas of nan qusadhe;</para>
  <para style="q2" vid="PSA 39:2">dhiphinni koo garuu ittuma caale;<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>onneen koo na keessatti bulluqaa deeme;</para>
  <para style="q2" vid="PSA 39:3">yeroo ani irra deddeebiʼee yaadettis ibiddi sun ni bobaʼe;</para>
  <para style="q2" vid="PSA 39:3">anis arraba kootiin akkana jedheen dubbadhe:<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>Yaa <char style="nd">Waaqayyo</char>, ati dhuma jireenya kootii na argisiisi;</para>
  <para style="q2" vid="PSA 39:4">dheerina umurii kootiis na barsiisi;</para>
  <para style="q2" vid="PSA 39:4">jireenyi koo akkam dafee akka darbus na beeksisi.<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>Kunoo, ati bara koo taakkuu tokkittii gooteerta;</para>
  <para style="q2" vid="PSA 39:5">umuriin koos fuula kee duratti homaattuu hin hedamu;</para>
  <para style="q2" vid="PSA 39:5">jireenyi nama hundumaas akkuma qilleensa shuf jedhee darbuu ti.<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>Dhuguma iyyuu namni akkuma gaaddidduu deddeebiʼa;</para>
  <para style="q2" vid="PSA 39:6">dhugumaan inni akkasumaan goolama;</para>
  <para style="q2" vid="PSA 39:6">namni qabeenya ni kuusa; garuu eenyuuf akka walitti qabu hin beeku.<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>“Egaa amma yaa Gooftaa, ani maalin eeggadha?</para>
  <para style="q2" vid="PSA 39:7">Abdiin koo suma irra jira.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>Dogoggora koo hunda irraa na oolchi;</para>
  <para style="q2" vid="PSA 39:8">nama gowwoonni itti kolfan na hin godhin.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Ani duudaa dha; afaan koos hin saaqqadhu;</para>
  <para style="q2" vid="PSA 39:9">kan waan kana godhe sumaatii.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>Ani rukuttaa harka keetiitiin dhumeeraatii;</para>
  <para style="q2" vid="PSA 39:10">dhaʼicha kee narraa fuudhi.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Ati sababii cubbuu isaaniitiif namoota ifatta; ni adabdas;</para>
  <para style="q2" vid="PSA 39:11">akkuma biliis qabeenya isaanii ni balleessita;</para>
  <para style="q2" vid="PSA 39:11">dhugumaan namni hundinuu qilleensuma shuf jedhee darbuu dha.<verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>“Yaa <char style="nd">Waaqayyo</char>, kadhannaa koo naa dhagaʼi;</para>
  <para style="q2" vid="PSA 39:12">iyya ani gargaarsa barbaachaaf iyyus dhaggeeffadhu;</para>
  <para style="q2" vid="PSA 39:12">booʼicha koos calʼistee hin ilaalin.</para>
  <para style="q1" vid="PSA 39:12">Ani akka alagaatti si bira nan jiraadhaatii;</para>
  <para style="q2" vid="PSA 39:12">akkuma abbootii koo hundumaattis ani nama biyya ormaa ti.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>Utuun godaanee lafa irraa hin dhabamin dura</para>
  <para style="q2" vid="PSA 39:13">akkan deebiʼee gammaduuf, ija kee narraa deebifadhu.”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">Faarfannaa 40</para>
  <para style="ms1">Faarfannaa Galataatii fi Kadhannaa</para>
  <para style="mr">
    <ref loc="PSA 40:13-17">40:13‑17</ref> kwf – <char style="xt"><ref loc="PSA 70:1-5">Far 70:1‑5</ref></char></para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>Ani obsaan <char style="nd">Waaqayyoon</char> nan eeggadhe;</para>
  <para style="q2" vid="PSA 40:1">innis gara kootti garagalee iyya koo naa dhagaʼe.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Inni boolla sodaachisaa keessaa,</para>
  <para style="q2" vid="PSA 40:2">dhoqqee nama liqimsu keessaas na baase;</para>
  <para style="q1" vid="PSA 40:2">miilla koo kattaa irra dhaabe;</para>
  <para style="q2" vid="PSA 40:2">ejjeta koos naa jabeesse.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Innis faarfannaa haaraa,</para>
  <para style="q2" vid="PSA 40:3">faarfannaa galataas afaan koo keessa <optbreak/> Waaqa keenyaaf kaaʼe.</para>
  <para style="q1" vid="PSA 40:3">Namoonni baayʼeen arganii <char style="nd">Waaqayyo</char> sodaatu;</para>
  <para style="q2" vid="PSA 40:3">isas ni amanatu.<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>Namni <char style="nd">Waaqayyoon</char> abdatu,</para>
  <para style="q2" vid="PSA 40:4">kan gara of tuultotaa hin ilaalle,</para>
  <para style="q1" vid="PSA 40:4">namni warra karaa irraa jalʼatanii</para>
  <para style="q2" vid="PSA 40:4">waaqota sobaa duukaa buʼinitti hin gara galle <optbreak/> eebbifamaa dha.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>Yaa <char style="nd">Waaqayyo</char> Waaqa ko,</para>
  <para style="q2" vid="PSA 40:5">dinqiin ati hojjette baayʼee dha;</para>
  <para style="q1" vid="PSA 40:5">waan ati nuuf yaadde,</para>
  <para style="q2" vid="PSA 40:5">namni tokko tokkoon sitti himuu dandaʼu</para>
  <para style="q2" vid="PSA 40:5">tokko iyyuu hin jiru;</para>
  <para style="q1" vid="PSA 40:5">yoo ani waaʼee isaanii labsee dubbadhe illee,</para>
  <para style="q2" vid="PSA 40:5">baayʼinni isaanii hamma hin qabu.<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>Ati aarsaa fi kennaa hin feene;</para>
  <para style="q2" vid="PSA 40:6">gurra koo garuu naa banteerta;</para>
  <para style="q2" vid="PSA 40:6">aarsaa gubamuu fi aarsaa cubbuu ati hin barbaanne.<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>Yeroo sana ani akkana nan jedhe; “Ani kunoo ti; ani dhufeera;</para>
  <para style="q2" vid="PSA 40:7">waaʼeen koo kitaaba maramaa keessatti barreeffameera.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>Yaa Waaqa ko, ani fedhii kee raawwachuutti nan gammada;</para>
  <para style="q2" vid="PSA 40:8">seerri kee garaa koo keessa jira.”<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>Ani yaaʼii guddaa keessatti qajeelummaa nan labsa;</para>
  <para style="q2" vid="PSA 40:9">Yaa <char style="nd">Waaqayyo</char>, akkuma ati beektu,</para>
  <para style="q2" vid="PSA 40:9">ani afaan koo hin qabadhu.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Ani qajeelummaa kee garaa koo keessa hin dhoksu;</para>
  <para style="q2" vid="PSA 40:10">waaʼee amanamummaa keetiitii fi waaʼee fayyisuu keetii nan odeessa;</para>
  <para style="q1" vid="PSA 40:10">jaalala keetii fi dhugaa kees</para>
  <para style="q2" vid="PSA 40:10">yaaʼii guddaa duraa hin dhoksu.<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>Yaa <char style="nd">Waaqayyo</char> araara kee na hin dhowwatin;</para>
  <para style="q2" vid="PSA 40:11">jaalalli keetii fi dhugaan kee yeroo hunda ana haa eegan.<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>Rakkinni hamma hin qabne na marseeraatii;</para>
  <para style="q2" vid="PSA 40:12">cubbuun koos na liqimseera; arguus dadhabeera;</para>
  <para style="q1" vid="PSA 40:12">cubbuun koo rifeensa mataa koo caalaa baayʼata;</para>
  <para style="q2" vid="PSA 40:12">onneen koos na keessatti laafteerti.<verse eid="PSA 40:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>Yaa <char style="nd">Waaqayyo</char>, na fayyisuutti gammadi;</para>
  <para style="q2" vid="PSA 40:13">yaa <char style="nd">Waaqayyo</char>, na gargaaruudhaaf dafii kottu.<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>Warri lubbuu koo galaafachuu barbaadan hundinuu,</para>
  <para style="q2" vid="PSA 40:14">haa qaanaʼan; haa burjaajaʼanis.</para>
  <para style="q1" vid="PSA 40:14">Warri badii koo hawwan hundi,</para>
  <para style="q2" vid="PSA 40:14">qaanaʼanii duubatti haa deebiʼan.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Warri, “Baga! Baga!” anaan jedhan,</para>
  <para style="q2" vid="PSA 40:15">qaanii isaaniitiin haa rifatan.<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>Warri si barbaadan hundinuu garuu</para>
  <para style="q2" vid="PSA 40:16">sitti gammadanii haa ililchan.</para>
  <para style="q1" vid="PSA 40:16">Warri fayyisuu kee jaallatan yeroo hunda,</para>
  <para style="q2" vid="PSA 40:16">“<char style="nd">Waaqayyo</char> guddaa dha!” haa jedhan.<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Ani garuu hiyyeessaa fi rakkataa dha;</para>
  <para style="q2" vid="PSA 40:17">taʼus Gooftaan naaf yaada.</para>
  <para style="q1" vid="PSA 40:17">Ati gargaarsa koo fi fayyisaa koo ti;</para>
  <para style="q2" vid="PSA 40:17">yaa Waaqa ko, hin turin.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">Faarfannaa 41</para>
  <para style="ms1">Kadhannaa Nama Dhukkubsatee</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>Namni hiyyeessaaf yaadu eebbifamaa dha;</para>
  <para style="q2" vid="PSA 41:1">guyyaa rakkinaatti <char style="nd">Waaqayyo</char> isa ni oolcha.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>
    <char style="nd">Waaqayyo</char> isa ni eega; bara jireenya isaas ni dheeressa;</para>
  <para style="q2" vid="PSA 41:2">lafa irratti isa eebbisa;</para>
  <para style="q2" vid="PSA 41:2">hawwii diinota isaattis dabarsee isa hin kennu.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>
    <char style="nd">Waaqayyo</char> siree inni dhukkubsatee irra ciisu irratti isa kunuunsa;</para>
  <para style="q2" vid="PSA 41:3">fayyisees siree dhukkubaa irraa isa ni kaasa.<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>Anis, “Yaa <char style="nd">Waaqayyo</char> na maari;</para>
  <para style="q2" vid="PSA 41:4">ani cubbuu sitti hojjedheeraatii na fayyisi” nan jedhe.<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Diinonni koo hamminaan, “Inni yoom duʼee maqaan isaa</para>
  <para style="q2" vid="PSA 41:5">lafa irraa bada?” jedhanii waaʼee koo dubbatu.<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>Namni tokko yeroo na gaafachuu dhufutti,</para>
  <para style="q2" vid="PSA 41:6">utuma garaa isaatti hammina kuufatee qabuu, sobee dubbata;</para>
  <para style="q2" vid="PSA 41:6">gad baʼees iddoo hundumatti odeessa.<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Warri na jibban hundinuu waaʼee koo walitti hasaasu;</para>
  <para style="q2" vid="PSA 41:7">waan akka malee hamaa taʼes natti mariʼatu.<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>Isaanis, “Dhukkubni hamaan isa qabateera;</para>
  <para style="q2" vid="PSA 41:8">inni siʼachi iddoo ciisu sanaa hin kaʼu” jedhu.<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Michuun koo inni natti dhiʼaatu,</para>
  <para style="q2" vid="PSA 41:9">inni ani amanadhe,</para>
  <para style="q1" vid="PSA 41:9">inni buddeena koo nyaate</para>
  <para style="q2" vid="PSA 41:9">koomee isaa natti ol fudhate.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>Ati garuu yaa <char style="nd">Waaqayyo</char> na baasi;</para>
  <para style="q2" vid="PSA 41:10">akka ani haaloo baafadhuufis ol na kaasi.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Akka ati natti gammaddu ani beeka;</para>
  <para style="q2" vid="PSA 41:11">diinni koo narra hin aanuutii.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Ati sababii amanamummaa kootiitiif utubdee na qabda;</para>
  <para style="q2" vid="PSA 41:12">baruma baraanis fuula kee dura na dhaabda.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>
    <char style="nd">Waaqayyo</char> Waaqni Israaʼel,</para>
  <para style="q2" vid="PSA 41:13">bara baraa hamma bara baraatti haa eebbifamu.</para>
  <para style="qc" vid="PSA 41:13">Ameen; Ameen.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">Kitaaba Lammaffaa</para>
  <para style="mr">
    <ref loc="PSA 42-72">Faarfannaa 42–72</ref></para>
  <para style="cl">Faarfannaa 42</para>
  <para style="ms1">Waaqayyon Dheebochuu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. <char style="tl">Maskiilii</char> Ilmaan Qooraahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>Akkuma gadamsi bishaan yaaʼutti gaggabu sana,</para>
  <para style="q2" vid="PSA 42:1">yaa Waaqa ko, lubbuun koo sitti gaggabdi.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>Lubbuun koo Waaqayyoon Waaqa jiraataa dheebotti.</para>
  <para style="q2" vid="PSA 42:2">Ani yoomin dhaqee fuula Waaqaa arga?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Imimmaan koo halkanii guyyaa soora naa taʼeera;</para>
  <para style="q2" vid="PSA 42:3">namoonni guyyaa guutuu “Waaqni kee eessa jira?” anaan jedhuutii.<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Ani yommuun waan kana yaadadhutti,</para>
  <para style="q2" vid="PSA 42:4">lubbuu koo of keessatti nan dhangalaasa:</para>
  <para style="q1" vid="PSA 42:4">ilillee fi faarfannaa galataatiin</para>
  <para style="q2" vid="PSA 42:4">tuuta ayyaana ayyaaneffatu tokko,</para>
  <para style="q1" vid="PSA 42:4">hiriiraan gara mana Waaqaatti geggeessaa</para>
  <para style="q2" vid="PSA 42:4">tuuticha wajjin akkamitti akka ani deemaa ture yaadadha.<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>Yaa lubbuu ko, ati maaliif gaddita?</para>
  <para style="q2" vid="PSA 42:5">Na keessattis maaliif raafamta?</para>
  <para style="q1" vid="PSA 42:5">Abdii kee Waaqa irra keeyyadhu;</para>
  <para style="q2" vid="PSA 42:5">ani amma iyyuu isa nan jajadha.</para>
  <para style="q2" vid="PSA 42:5">Fayyisaa koo fi Waaqa koo nan jajadha.<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>Lubbuun koo na keessatti gadditeerti;</para>
  <para style="q2" vid="PSA 42:6">kanaafuu ani biyya Yordaanos irraa,</para>
  <para style="q1" vid="PSA 42:6">fiixee Hermoonii fi</para>
  <para style="q2" vid="PSA 42:6">Gaara Miizaarii irraa si yaadadha.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>Huursaa fincaaʼaa keetiitiin,</para>
  <para style="q2" vid="PSA 42:7">tuujubni tuujuba waama;</para>
  <para style="q2" vid="PSA 42:7">dambalii fi dhaʼaan kee hundinuu, narra yaaʼan.<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>
    <char style="nd">Waaqayyo</char> guyyaadhaan jaalala isaa kan hin geeddaramne ni ajaja;</para>
  <para style="q2" vid="PSA 42:8">halkan immoo faarfannaan isaa na wajjin jira;</para>
  <para style="q2" vid="PSA 42:8">kunis kadhannaa ani Waaqa jireenya kootii kadhadhuu dha.<verse eid="PSA 42:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>Anis Waaqa Kattaa kootiin akkana nan jedha;</para>
  <para style="q2" vid="PSA 42:9">“Ati maaliif na dagatte?</para>
  <para style="q2" vid="PSA 42:9">Maaliif ani diinaan cunqurfamee gaddaan jiraadha?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Amajaajonni koo guyyaa guutuu,</para>
  <para style="q2" vid="PSA 42:10">“Waaqni kee eessa jira?” jedhanii natti qoosudhaan,</para>
  <para style="q2" vid="PSA 42:10">akkuma goraadee lafee koo keessaatti na dhiphisu.<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>Yaa lubbuu ko, ati maaliif gaddita?</para>
  <para style="q2" vid="PSA 42:11">Na keessattis maaliif raafamta?</para>
  <para style="q1" vid="PSA 42:11">Abdii kee Waaqa irra kaaʼadhu;</para>
  <para style="q2" vid="PSA 42:11">ani amma iyyuu isa nan galateeffadha;</para>
  <para style="q2" vid="PSA 42:11">Fayyisaa koo fi Waaqa koo nan jajadha.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">Faarfannaa 43</para>
  <para style="ms1">Tumsaa fi Furama Barbaachaaf Kadhachuu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>Yaa Waaqi, naa murteessi;</para>
  <para style="q2" vid="PSA 43:1">saba hin amanametti dubbii koo naa falmi;</para>
  <para style="q2" vid="PSA 43:1">gowwoomsitootaa fi jalʼoota jalaas na baasi.<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>Ati Waaqa jabina kootii ti.</para>
  <para style="q2" vid="PSA 43:2">Maaliif na gatte?</para>
  <para style="q1" vid="PSA 43:2">Ani maaliifin diinaan cunqurfamee</para>
  <para style="q2" vid="PSA 43:2">gaddaan jiraadha?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Ifa keetii fi dhugaa kee ergi;</para>
  <para style="q2" vid="PSA 43:3">isaan na haa qajeelchan;</para>
  <para style="q1" vid="PSA 43:3">gara tulluu kee qulqulluutti,</para>
  <para style="q2" vid="PSA 43:3">gara iddoo ati jiraattu sanaatti ana haa fiddan.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>Yoos ani gara iddoo aarsaa Waaqaa,</para>
  <para style="q2" vid="PSA 43:4">gara Waaqa gammachuu fi ilillee koo nan dhaqa.</para>
  <para style="q1" vid="PSA 43:4">Yaa Waaqayyo, Waaqa ko,</para>
  <para style="q2" vid="PSA 43:4">ani baganaadhaan sin galateeffadha.<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>Yaa lubbuu ko, ati maaliif gaddita?</para>
  <para style="q2" vid="PSA 43:5">Na keessattis maaliif raafamta?</para>
  <para style="q1" vid="PSA 43:5">Abdii kee Waaqa irra kaaʼadhu;</para>
  <para style="q2" vid="PSA 43:5">ani amma iyyuu isa nan galateeffadha;</para>
  <para style="q2" vid="PSA 43:5">Fayyisaa koo fi Waaqa koo nan jajadha.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">Faarfannaa 44</para>
  <para style="ms1">Faaruu Booʼichaa</para>
  <para style="d">Dura buʼaa faarfattootaatiif. <char style="tl">Maskiilii</char> Ilmaan Qooraahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>Yaa Waaqi, waan ati bara durii,</para>
  <para style="q2" vid="PSA 44:1">jabana isaanii keessa hojjette sana,</para>
  <para style="q1" vid="PSA 44:1">abbootiin keenya nutti himaniiru;</para>
  <para style="q2" vid="PSA 44:1">nuus gurra keenyaan dhageenyeerra.<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>Ati harka keetiin saboota ariitee baafte;</para>
  <para style="q2" vid="PSA 44:2">abbootii keenya immoo ni dhaabde;</para>
  <para style="q1" vid="PSA 44:2">namoota ni balleessite;</para>
  <para style="q2" vid="PSA 44:2">abbootii keenya garuu bilisa baafte.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Harka kee mirgaatiin, irree keetii fi ifa fuula keetiitiin dhaalan malee</para>
  <para style="q2" vid="PSA 44:3">isaan goraadee isaaniitiin lafa sana hin dhaalle;</para>
  <para style="q1" vid="PSA 44:3">yookaan irreen isaanii moʼannoo isaaniif hin fidne;</para>
  <para style="q2" vid="PSA 44:3">ati isaan jaallatteertaatii.<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>Ati Mootii koo fi Waaqa koo</para>
  <para style="q2" vid="PSA 44:4">kan Yaaqoobiif moʼicha ajajjuu dha.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>Nu siin diinota keenya duubatti deebifna;</para>
  <para style="q2" vid="PSA 44:5">maqaa keetiinis amajaajota keenya gad dhidhiinna.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Ani iddaa koo hin amanadhu;</para>
  <para style="q2" vid="PSA 44:6">goraadeen koos moʼannaa naa hin fidu;<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>ati garuu diinota keenya jalaa nu oolchita;</para>
  <para style="q2" vid="PSA 44:7">warra nu jibban immoo ni qaanessita.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Nu yeroo hundumaa Waaqaan dhaadanna;</para>
  <para style="q2" vid="PSA 44:8">maqaa kees bara baraan ni galateeffanna.<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>Amma garuu ati nu gatteerta; gadis nu deebifteerta;</para>
  <para style="q2" vid="PSA 44:9">ati loltoota keenya wajjin hin baane.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Akka nu diinota keenya baqannu nu gooteerta;</para>
  <para style="q2" vid="PSA 44:10">warri nu jibbanis nu saamaniiru.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Ati akka hoolota qalamuuf qopheeffamanii nu gooteerta;</para>
  <para style="q2" vid="PSA 44:11">ormoota keessas nu bittinneessiteerta.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Saba kee gatii xinnaatti gurgurteerta;</para>
  <para style="q2" vid="PSA 44:12">gurgurtaa isaanii irraas buʼaa hin arganne.<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Ollaa keenya duratti nama kolfaa,</para>
  <para style="q2" vid="PSA 44:13">warra naannoo keenyaa birattis <optbreak/> waan qoosaatii fi nama tuffii nu gooteerta.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Ormoota keessatti waan mammaaksaa nu goote;</para>
  <para style="q2" vid="PSA 44:14">namoonnis mataa nutti raasan.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Salphinni koo guyyaa guutuu fuula koo dura jira;</para>
  <para style="q2" vid="PSA 44:15">fuulli koos qaaniidhaan haguugameera.<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>Kunis sababii dubbii warra na tuffataniitii fi warra na arrabsaniitiif,</para>
  <para style="q2" vid="PSA 44:16">sababii diinaatii fi sababii nama haaloo baafatuutiif taʼe.<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>Kun hundi nutti dhufeera;</para>
  <para style="q2" vid="PSA 44:17">taʼus nu si hin daganne;</para>
  <para style="q2" vid="PSA 44:17">yookaan kakuu kee keessatti amanamummaa hin dhabne.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Garaan keenya dugda duubatti hin deebine;</para>
  <para style="q2" vid="PSA 44:18">tarkaanfiin keenyas karaa kee irraa hin jalʼanne.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>Ati garuu iddoo waangoonni jiraatanitti nu caccabsite;</para>
  <para style="q2" vid="PSA 44:19">dukkana hamaadhaan nu haguugde.<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>Utuu nu maqaa Waaqa keenyaa irraanfannee,</para>
  <para style="q2" vid="PSA 44:20">yookaan utuu harka keenya gara waaqa ormaatti balʼifannee jiraannee,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>silaa Waaqni waan kana bira hin gaʼu turee?</para>
  <para style="q2" vid="PSA 44:21">Inni icciitii garaa namaa beekaatii.<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>Nu siif jennee guyyaa guutuu ni ajjeefamna;</para>
  <para style="q2" vid="PSA 44:22">akka hoolota qalamuuf jiraniittis lakkaaʼamneerra.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>Yaa Gooftaa dammaqi! Ati maaliif rafta?</para>
  <para style="q2" vid="PSA 44:23">Kaʼi! Bara baraanis nu hin gatin.<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>Ati maaliif fuula kee dhokfatta?</para>
  <para style="q2" vid="PSA 44:24">Maaliifis dhiphinaa fi hacuucamuu keenya irraanfatta?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Lubbuun keenya biyyootti dabalamteertii;</para>
  <para style="q2" vid="PSA 44:25">garaan keenyas lafatti maxxaneera.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>Kaʼiitii nu gargaar; sababii jaalala kee</para>
  <para style="q2" vid="PSA 44:26">kan hin geeddaramneetiifis nu furi.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">Faarfannaa 45</para>
  <para style="ms1">Faarfannaa Cidha Mootii</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeedaloo ilmaan Qooraahi kan “Daraaraa” jedhamu. <char style="tl">Maskiil.</char> Faarfannaa cidhaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>Yommuu ani mootiidhaaf faarfadhutti,</para>
  <para style="q2" vid="PSA 45:1">yaadni gaariin garaa koo guutee irra dhangalaʼa;</para>
  <para style="q2" vid="PSA 45:1">arrabni koos akkuma biirii barreessaa ogeessa tokkoo ti.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>Ati nama hundumaa caalaa miidhagaa dha;</para>
  <para style="q2" vid="PSA 45:2">hidhii kee irra surraatu dhangalaʼa;</para>
  <para style="q2" vid="PSA 45:2">kanaafuu Waaqni bara baraan si eebbiseera.<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>Yaa gooticha, goraadee kee luqqeettuutti hidhadhu;</para>
  <para style="q2" vid="PSA 45:3">ulfinaa fi surraa uffadhu.<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>Sababii dubbii dhugaatiif, gad of qabiisaa fi qajeelummaatiif,</para>
  <para style="q2" vid="PSA 45:4">miidhagina keetiin moʼannaadhaan fuula duratti gulufi;</para>
  <para style="q2" vid="PSA 45:4">harki kee mirgaas hojii sodaachisaa haa hojjetu.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>Xiyyawwan kee qara qabeeyyiin sun onnee diinota mootii haa waraanan;</para>
  <para style="q2" vid="PSA 45:5">saboonnis miilla kee jalatti haa jijjiganii.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>Yaa Waaqayyo, teessoon kee bara baraa hamma bara baraatti ni jiraata;</para>
  <para style="q2" vid="PSA 45:6">bokkuun qajeelummaas bokkuu mootummaa keetii ni taʼa.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>Ati qajeelummaa jaallatta; jalʼina immoo ni jibbita;</para>
  <para style="q2" vid="PSA 45:7">kanaafuu Waaqayyo, Waaqni kee hiriyoota kee caalaatti,</para>
  <para style="q2" vid="PSA 45:7">zayitiidhaan gammachuu si dibeera.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Uffanni kee hundinuu qumbiidhaan,</para>
  <para style="q2" vid="PSA 45:8">argeessaa fi qundhiidhaan ni urgaaʼa;</para>
  <para style="q1" vid="PSA 45:8">masaraawwan ilka arbaatiin miidhagfaman keessattis</para>
  <para style="q2" vid="PSA 45:8">muuziiqaan miʼa ribuu si gammachiisa.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Intallan moototaa dubartoota kee warra kabajamoo keessa jiru;</para>
  <para style="q2" vid="PSA 45:9">mootittiinis warqee Oofiiriitiin miidhagfamtee</para>
  <para style="q2" vid="PSA 45:9">karaa harka mirga keetii dhaabatti.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>Yaa intalaa dhagaʼi; hubadhu; gurra kees as qabi;</para>
  <para style="q2" vid="PSA 45:10">saba keetii fi mana abbaa keetii irraanfadhu.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Mootiin miidhagina kee hawwa;</para>
  <para style="q2" vid="PSA 45:11">waan inni gooftaa kee taʼeef isa kabaji.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Intalli Xiiroos kennaa fiddee dhufti;</para>
  <para style="q2" vid="PSA 45:12">sooreyyiinis garaa si laafifachuu barbaadu.<verse eid="PSA 45:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Intalli mootii ulfina guddaadhaan diinqa ishee jirti;</para>
  <para style="q2" vid="PSA 45:13">uffanni ishees warqeedhaan dhaʼame.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Isheenis uffata halluu garaa garaa qabu uffattee <optbreak/> gara mootiitti geeffamti;</para>
  <para style="q2" vid="PSA 45:14">durboonni waaʼelli ishees ishee duukaa buʼanii <optbreak/> gara keetti fidamu.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Isaanis gammachuu fi ililleedhaan ol galfamu;</para>
  <para style="q2" vid="PSA 45:15">masaraa mootichaas ni seenu.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Ilmaan kee iddoo abbootii keetii buʼan;</para>
  <para style="q2" vid="PSA 45:16">atis lafa hunda irratti isaan ni moosifta.<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>Ani akka maqaan kee dhaloota hunda keessatti yaadatamu nan godha;</para>
  <para style="q2" vid="PSA 45:17">kanaafuu saboonni bara baraa hamma bara baraatti si jajatu.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">Faarfannaa 46</para>
  <para style="ms1">Waaqayyo nu wajjin jira</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Ilmaan Qooraahi. Haala <char style="tl">Alaamootiitiin</char>.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>Waaqni daʼoo fi jabina keenya;</para>
  <para style="q2" vid="PSA 46:1">inni gargaarsa yeroo hunda rakkina keessatti nu wajjin jiruu dha.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Kanaafuu yoo lafti raafamtee</para>
  <para style="q2" vid="PSA 46:2">tulluuwwanis garaa galaanaa keessa gadi buʼan iyyuu nu hin sodaannu.<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>Utuu bishaan isaas huursee hoomachaaʼee</para>
  <para style="q2" vid="PSA 46:3">tulluuwwanis raafama isaatiin sochoʼan iyyuu nu hin sodaannu.<verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>Lagni yaaʼaan isaa magaalaa Waaqaa gammachiisu</para>
  <para style="q2" vid="PSA 46:4">kan iddoo qulqulluu Waaqni Waan Hundaa Olii jiraatuuf <optbreak/> gammachuu kennu tokko jira.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Waaqni magaalattii keessa jira; isheenis hin raafamtu;</para>
  <para style="q2" vid="PSA 46:5">ganama barii Waaqni ishee gargaara.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Saboonni ni raafaman; mootummoonnis ni kufan;</para>
  <para style="q2" vid="PSA 46:6">inni sagalee isaa dhageessise; laftis ni baqxe.<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>
    <char style="nd">Waaqayyoon</char> Waan Hunda Dandaʼu nu wajjin jira;</para>
  <para style="q2" vid="PSA 46:7">Waaqni Yaaqoob daʼoo keenya.<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>Kottaa, hojii <char style="nd">Waaqayyoo</char> ilaalaa;</para>
  <para style="q2" vid="PSA 46:8">badiisa inni lafa irratti fides argaa.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>Inni hamma handaara lafaatti waraana ni balleessa;</para>
  <para style="q2" vid="PSA 46:9">iddaa ni cabsa; eeboo ni burkuteessa;</para>
  <para style="q2" vid="PSA 46:9">gaachanas ibiddaan guba.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>“Calʼisaa; akka ani Waaqa taʼes beekaa;</para>
  <para style="q2" vid="PSA 46:10">ani saboota gidduutti ol ol nan jedha;</para>
  <para style="q2" vid="PSA 46:10">lafa irrattis ol ol nan jedha.”<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>
    <char style="nd">Waaqayyoon</char> Waan Hunda Dandaʼu nu wajjin jira;</para>
  <para style="q2" vid="PSA 46:11">Waaqni Yaaqoob daʼoo keenya.<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">Faarfannaa 47</para>
  <para style="ms1">Waaqayyo Mootii Addunyaa ti</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Ilmaan Qooraahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>Isin saboonni hundinuu harka keessan rukutaa;</para>
  <para style="q2" vid="PSA 47:1">sagalee ol fudhadhaatii gammachuudhaan Waaqaaf ililchaa.<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>
    <char style="nd">Waaqayyo</char> Waaqa Waan Hundaa Olii,</para>
  <para style="q2" vid="PSA 47:2">Mootichi guddaan lafa hundumaa, sodaachisaadhaatii!<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Inni saboota nu jala,</para>
  <para style="q2" vid="PSA 47:3">namootas miilla keenya jala galcheera.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>Innis nu warra Yaaqoob isa inni jaallate sanaaf ulfina taaneef,</para>
  <para style="q2" vid="PSA 47:4">dhaala keenya nuu fileera.<verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Waaqni ililleedhaan, <char style="nd">Waaqayyo</char> sagalee</para>
  <para style="q2" vid="PSA 47:5">malakataatiin ol baʼe.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>Faarfannaa galataa Waaqaaf faarfadhaa;</para>
  <para style="q2" vid="PSA 47:6">faarfannaa galataa faarfadhaa;</para>
  <para style="q1" vid="PSA 47:6">faarfannaa galataa Mootii keenyaaf faarfadhaa;</para>
  <para style="q2" vid="PSA 47:6">faarfannaa galataa faarfadhaa.<verse eid="PSA 47:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>Waaqni Mootii lafa hundaa ti;</para>
  <para style="q2" vid="PSA 47:7">faarfannaa galataa hubannaadhaan faarfadhaa.<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Waaqni saboota irratti Mootii dha;</para>
  <para style="q2" vid="PSA 47:8">Waaqni teessoo isaa qulqulluu irra taaʼeera.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Qondaaltonni sabootaa,</para>
  <para style="q2" vid="PSA 47:9">akkuma saba Waaqa Abrahaamitti walitti qabamu;</para>
  <para style="q1" vid="PSA 47:9">mootonni lafa irraa kan Waaqaatii;</para>
  <para style="q2" vid="PSA 47:9">innis guddisee ol ol jedheera.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">Faarfannaa 48</para>
  <para style="ms1">Xiyoon Tulluu Waaqayyoo</para>
  <para style="d">Weedduu. Faarfannaa Ilmaan Qooraahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>Magaalaa Waaqa keenyaa keessatti,</para>
  <para style="q2" vid="PSA 48:1">tulluu isaa qulqulluu irrattis, <char style="nd">Waaqayyo</char> guddaa dha;</para>
  <para style="q2" vid="PSA 48:1">waan hundaa olittis galanni isaaf mala.<verse eid="PSA 48:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>Tulluun Xiyoon gara kaabaatti argama;</para>
  <para style="q2" vid="PSA 48:2">dheerina isaatiinis ni bareeda.</para>
  <para style="q1" vid="PSA 48:2">Innis gammachuu addunyaa hundaa ti;</para>
  <para style="q2" vid="PSA 48:2">magaalaa Mooticha Guddaatis.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>Waaqni daʼannoo ishee keessa jira;</para>
  <para style="q2" vid="PSA 48:3">inni daʼannoo ishee taʼuu isaa argisiiseera.<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>Mootonni humna walitti daratanii</para>
  <para style="q2" vid="PSA 48:4">tokkummaadhaan itti qajeelan.<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>Isaanis ishee arganii dinqifatan;</para>
  <para style="q2" vid="PSA 48:5">sodaataniis baqatan.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>Achittis akkuma muddama dubartii ciniinsifattuutti,</para>
  <para style="q2" vid="PSA 48:6">hollannaan isaan qabate.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Atis bubbee baʼa biiftuutiin</para>
  <para style="q2" vid="PSA 48:7">dooniiwwan Tarshiish caccabsite.<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Akkuma dhageenye sana,</para>
  <para style="q2" vid="PSA 48:8">magaalaa <char style="nd">Waaqayyoo</char> Waan Hunda Dandaʼuu keessatti,</para>
  <para style="q1" vid="PSA 48:8">magaalaa Waaqa keenyaa keessatti, akkasuma argineerra;</para>
  <para style="q2" vid="PSA 48:8">Waaqni bara baraan jabeessee ishee dhaaba.<verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>Yaa Waaqayyo, nu mana qulqullummaa kee keessatti,</para>
  <para style="q2" vid="PSA 48:9">jaalala kee kan hin geeddaramne sana irra deddeebinee yaadna.<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>Yaa Waaqayyo, galanni kee akkuma maqaa keetii</para>
  <para style="q2" vid="PSA 48:10">handaara lafaa gaʼa;</para>
  <para style="q2" vid="PSA 48:10">harki kee mirgaas qajeelummaan guutameera.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Sababii murtii keetiitiif,</para>
  <para style="q2" vid="PSA 48:11">Tulluun Xiyoon haa gammaddu;</para>
  <para style="q2" vid="PSA 48:11">intallan Yihuudaas haa ililchan.<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Xiyoon irra naannaʼaa; naannoo ishee irras adeemaa;</para>
  <para style="q2" vid="PSA 48:12">gamoowwan ishees lakkaaʼaa.<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>Dhaloota itti aanutti akka himtaniif,</para>
  <para style="q2" vid="PSA 48:13">dallaa eegumsa ishee sirriitti hubadhaa;</para>
  <para style="q2" vid="PSA 48:13">galma ishees ilaalaa.<verse eid="PSA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>Waaqni kun bara baraa hamma bara baraatti Waaqa keenyaatii;</para>
  <para style="q2" vid="PSA 48:14">inni hamma dhumaatti illee nu qajeelcha.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">Faarfannaa 49</para>
  <para style="ms1">Qabeenya abdachuun faayidaa hin qabu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Ilmaan Qooraahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>Yaa namoota, isin hundi waan kana dhagaʼaa;</para>
  <para style="q2" vid="PSA 49:1">warri addunyaa kana irra jiraattan hundinuu dhaggeeffadhaa;<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>xinnaa fi guddaan, sooressii fi hiyyeessi walumaan</para>
  <para style="q2" vid="PSA 49:2">dhaggeeffadhaa; kunis:<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Afaan koo dubbii ogummaa dubbata;</para>
  <para style="q2" vid="PSA 49:3">wanti ani garaatti yaadus hubannaa kenna.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Gurra koo gara mammaaksaatti nan qabadha;</para>
  <para style="q2" vid="PSA 49:4">hibboo koos baganaadhaan nan ibsadha.<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>Bara rakkinaa, yeroo gowwoomsitoonni hamoon</para>
  <para style="q2" vid="PSA 49:5">na marsanitti, ani maaliifan sodaadha?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>Isaan qabeenya isaanii amanatu;</para>
  <para style="q2" vid="PSA 49:6">guddina sooruma isaaniitiinis boonu.<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>Namni lubbuu nama gara biraa furu,</para>
  <para style="q2" vid="PSA 49:7">yookaan gatii furii nama sanaa Waaqaaf baasu tokko iyyuu hin jiru;<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>furiin lubbuu namaa gatii guddaa qabaatii;</para>
  <para style="q2" vid="PSA 49:8">gatiin quufsaanis yoom iyyuu hin argamu;<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>silaa inni bara baraan ni jiraata;</para>
  <para style="q2" vid="PSA 49:9">hin tortorus ture.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>Akka ogeeyyiin duʼan namni hundinuu ni arga;</para>
  <para style="q2" vid="PSA 49:10">gowwoonnii fi raatuwwanis akkasuma ni badu;</para>
  <para style="q2" vid="PSA 49:10">qabeenya isaaniis warra kaaniif dhiisu.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Isaan yoo lafa maqaa isaaniitiin waamamtu qabaatan illee,</para>
  <para style="q2" vid="PSA 49:11">awwaalli isaanii bara baraan mana isaanii,</para>
  <para style="q2" vid="PSA 49:11">dhalootaa hamma dhalootaattis iddoo boqonnaa isaanii taʼee hafa.<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>Namni garuu qabeenya qabaatu illee bara dheeraa hin jiraatu;</para>
  <para style="q2" vid="PSA 49:12">inni akkuma bineensa duʼee baduu ti.<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Wanni namoota ofitti amanatanii fi</para>
  <para style="q2" vid="PSA 49:13">warra isaan duukaa buʼanii dubbii isaanii hoʼisan eeggatu kanuma.<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Isaan akkuma hoolaa duʼaaf ramadamaniiru;</para>
  <para style="q2" vid="PSA 49:14">duuti tiksee isaanii ti;</para>
  <para style="q2" vid="PSA 49:14">toloonni ganamaan isaan irratti aangoo qabaatu;</para>
  <para style="q1" vid="PSA 49:14">dhagni isaanii mana isaanii irraa fagaatee awwaala keessatti ni tortora;</para>
  <para style="q2" vid="PSA 49:14">awwaallis mana jireenya isaanii ti.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Waaqni garuu lubbuu koo humna siiʼool jalaa baasa;</para>
  <para style="q2" vid="PSA 49:15">inni dhugumaan ofitti na fudhata.<verse eid="PSA 49:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Yommuu namni tokko sooromu,</para>
  <para style="q2" vid="PSA 49:16">yommuu ulfinni mana isaas guddatu hin sodaatin.<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>Inni yommuu duʼutti waanuma tokko illee fudhatee hin deemuutii;</para>
  <para style="q2" vid="PSA 49:17">ulfinni isaas isa wajjin hin dhaqu.<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>Inni bara jireenya isaa lubbuu isaa eebbisu iyyuu,</para>
  <para style="q2" vid="PSA 49:18">yoo namoonni yeroo ati waan gaarii ofii keetii godhattutti si jajan illee,<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>inni gara dhaloota abbootii isaa,</para>
  <para style="q2" vid="PSA 49:19">gara warra gonkumaa deebiʼanii ifa jireenyaa hin arginee ni dhaqa.<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>Namni badhaadhaan hubannaa hin qabne,</para>
  <para style="q2" vid="PSA 49:20">akkuma bineensaa duʼee bada.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">Faarfannaa 50</para>
  <para style="ms1">Waaqeffannaa Dhugaa</para>
  <para style="d">Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>
    <char style="nd">Waaqayyo</char>, Humna Qabeessi dubbatee</para>
  <para style="q2" vid="PSA 50:1">baʼa biiftuutii jalqabee hamma lixa biiftuutti</para>
  <para style="q2" vid="PSA 50:1">lafa waameera.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Xiyoon ishee miidhaginni ishee</para>
  <para style="q2" vid="PSA 50:2">hirʼina hin qabne irraa Waaqni ni ibsa.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Waaqni keenya ni dhufa; hin calʼisus;</para>
  <para style="q2" vid="PSA 50:3">ibiddi hamaan fuula isaa dura,</para>
  <para style="q2" vid="PSA 50:3">bubbeen jabaanis naannoo isaa jira.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>Inni saba isaatti muruuf jedhee,</para>
  <para style="q2" vid="PSA 50:4">samiiwwan oliitii fi lafa akkana jedhee ni waama:<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“Qulqulloota koo warra aarsaadhaan na wajjin kakuu galan,</para>
  <para style="q2" vid="PSA 50:5">gara kootti walitti naa qabaa.”<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Samiiwwan qajeelummaa isaa ni labsu;</para>
  <para style="q2" vid="PSA 50:6">Waaqni mataan isaa abbaa murtiitii.<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“Yaa saba ko, nan dubbadhaatii dhagaʼi;</para>
  <para style="q2" vid="PSA 50:7">yaa Israaʼel, ani dhugaa sitti nan baʼa:</para>
  <para style="q2" vid="PSA 50:7">Ani Waaqni Waaqa kee ti.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Ani aarsaa keetiif sitti hin dheekkamu;</para>
  <para style="q2" vid="PSA 50:8">aarsaan kee inni gubamu yeroo hunda fuula koo dura jira.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Ani dallaa kee keessaa korma,</para>
  <para style="q2" vid="PSA 50:9">yookaan karra kee keessaa korbeessa reʼee hin barbaadu.<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>Bineensi bosonaa hundinuu,</para>
  <para style="q2" vid="PSA 50:10">horiin tulluu kuma irratti bobbaʼus kan kootii.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Ani simbirroota tulluuwwan irraa hunda beeka;</para>
  <para style="q2" vid="PSA 50:11">wanni lafa irra sosochoʼu hundinuus kan koo ti.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Ani utuun beelaʼee iyyuu sitti hin himadhu ture;</para>
  <para style="q2" vid="PSA 50:12">addunyaa fi wanni ishee keessa jiru hundi kanuma kootii.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Ani foon korommii nan nyaadhaa?</para>
  <para style="q2" vid="PSA 50:13">Yookaan dhiiga reʼootaa nan dhugaa?<verse eid="PSA 50:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>“Aarsaa galataa Waaqaaf dhiʼeessi; wareega kee illee</para>
  <para style="q2" vid="PSA 50:14">Waaqa Waan Hundaa Oliitiif galchi;<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>guyyaa rakkinaa na waammadhu;</para>
  <para style="q2" vid="PSA 50:15">ani sin oolchaa; atis ulfina naa kennita.”<verse eid="PSA 50:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16"/>Waaqni garuu nama hamaadhaan akkana jedha:</para>
  <para style="q1" vid="PSA 50:16">“Ati seera koo labsuudhaaf,</para>
  <para style="q2" vid="PSA 50:16">kakuu koos afaan keetiin dubbachuudhaaf <optbreak/> mirga maalii qabda?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Ati adaba koo ni jibbita;</para>
  <para style="q2" vid="PSA 50:17">dubbii koos of duubatti gatta.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Ati yoo hattuu argite isa michuu godhatta;</para>
  <para style="q2" vid="PSA 50:18">ejjitoota wajjinis qooda qabaatta.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Ati afaan kee waan hamaa dubbachuuf itti fayyadamta;</para>
  <para style="q2" vid="PSA 50:19">arraba kees gowwoomsaadhaaf dheereffatta.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Ati teessee obboleessa kee hamatta;</para>
  <para style="q2" vid="PSA 50:20">ilma haadha kee maqaa balleessita.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Ati waan kana hunda hojjetteerta; ani immoo inuma calʼise;</para>
  <para style="q2" vid="PSA 50:21">ati akkuma ofii keetii na seete.</para>
  <para style="q1" vid="PSA 50:21">Amma garuu ani sin ifadha;</para>
  <para style="q2" vid="PSA 50:21">ifatti baasees sin himadha.<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“Isin warri Waaqa irraanfattan waan kana hubadhaa;</para>
  <para style="q2" vid="PSA 50:22">yoo kanaa achii ani isin nan ciccira;</para>
  <para style="q2" vid="PSA 50:22">namni isin oolchu tokko iyyuu hin jiru.<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Namni aarsaa galataa dhiʼeessu ulfina naa kenna;</para>
  <para style="q2" vid="PSA 50:23">anis warra hirʼina hin qabnetti fayyisuu Waaqaa nan argisiisa.”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">Faarfannaa 51</para>
  <para style="ms1">Kadhannaa Dhiifama Cubbuu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit. Faarfannaa kanas inni erga Batisheebaa bira gaʼee booddee yeroo Naataan raajichi gara isaa dhufetti faarfate.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>Yaa Waaqayyo, akkuma jaalala kee</para>
  <para style="q2" vid="PSA 51:1">kan hin geeddaramne sanaatti na maari;</para>
  <para style="q1" vid="PSA 51:1">akkuma baayʼina araara keetiitti,</para>
  <para style="q2" vid="PSA 51:1">yakka koo narraa haqi.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Yakka koo hundumaa narraa dhiqi;</para>
  <para style="q2" vid="PSA 51:2">cubbuu koo irraas na qulqulleessi.<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Ani yakka koo beekaatii;</para>
  <para style="q2" vid="PSA 51:3">cubbuun koos yeroo hunda fuula koo dura jira.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Ani sitti, suma qofatti cubbuu hojjedheera;</para>
  <para style="q2" vid="PSA 51:4">waan fuula kee duratti hamaa taʼes hojjedheera;</para>
  <para style="q1" vid="PSA 51:4">kanaafuu ati murtii keetiin qajeelaa dha;</para>
  <para style="q2" vid="PSA 51:4">yommuu murtii kennituttis hin dogoggortu.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>Dhuguma iyyuu ani cubbuudhaanan dhaladhe;</para>
  <para style="q2" vid="PSA 51:5">yeroo haati koo na ulfooftee jalqabees cubbamaan ture.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Ati keessa namaatti dhugaa hawwita;</para>
  <para style="q2" vid="PSA 51:6">kanaafuu keessa kootti ogummaa na barsiisi.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Hiisophiidhaan cubbuu irraa na qulqulleessi; anis nan qulqullaaʼa;</para>
  <para style="q2" vid="PSA 51:7">na dhiqi; anis cabbii caalaatti nan addaadha.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Gammachuu fi ilillee na dhageessisi;</para>
  <para style="q2" vid="PSA 51:8">lafeen ati caccabsites haa ililchu.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Fuula kee cubbuu koo irraa deebifadhu;</para>
  <para style="q2" vid="PSA 51:9">yakka koo hundas narraa haqi.<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>Yaa Waaqayyo, garaa qulqulluu na keessatti uumi;</para>
  <para style="q2" vid="PSA 51:10">Hafuura qajeelaas na keessatti haaromsi.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Fuula kee duraa na hin balleessin;</para>
  <para style="q2" vid="PSA 51:11">Hafuura kee Qulqulluus narraa hin fudhatin.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Gammachuu fayyina keetii naa deebisi;</para>
  <para style="q2" vid="PSA 51:12">na jiraachisuudhaafis hafuura sarmu naa kenni.<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Anis warra karaa kee irraa jalʼatan nan barsiisa;</para>
  <para style="q2" vid="PSA 51:13">cubbamoonnis gara kee ni deebiʼu.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>Yaa Waaqi, Waaqa na Fayyiftu,</para>
  <para style="q2" vid="PSA 51:14">ati dhiiga dhangalaasuu irraa na oolchi;</para>
  <para style="q2" vid="PSA 51:14">arrabni koos qajeelummaa kee ni faarfata.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>Yaa Gooftaa, hidhii koo naa bani;</para>
  <para style="q2" vid="PSA 51:15">afaan koos galata kee labsa.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Ati aarsaatti hin gammaddu malee silaa nan dhiʼeessa ture;</para>
  <para style="q2" vid="PSA 51:16">aarsaa gubamuttis hin gammaddu.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>Aarsaan Waaqni fudhatu hafuura cabaa dha;</para>
  <para style="q2" vid="PSA 51:17">Yaa Waaqi, ati garaa cabaa fi kan gaabbu hin tuffatu.<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Jaalala keetiin Xiyooniif waan gaarii godhi;</para>
  <para style="q2" vid="PSA 51:18">dallaa Yerusaalem ijaari.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Yoos ati aarsaa qajeelaatti, qalma gubamuu fi</para>
  <para style="q2" vid="PSA 51:19">qalma akkuma jirutti gubamutti ni gammadda;</para>
  <para style="q2" vid="PSA 51:19">korommiinis iddoo aarsaa kee irratti ni dhiʼeeffaman.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">Faarfannaa 52</para>
  <para style="ms1">Waan Nama Hamaa Eeggatu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. <char style="tl">Maskiilii</char> Daawit. Dooʼeeg namni biyya Edoomii yeroo gara Saaʼolii dhaqee, “Daawit gara mana Ahiimelekii dhufeera” jedhee itti himetti faarfatame.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>Yaa nama jabaa nana, ati maaliif hamminaan koorta?</para>
  <para style="q2" vid="PSA 52:1">Ati namni fuula Waaqaa duratti tuffatamtu,</para>
  <para style="q2" vid="PSA 52:1">maaliif guyyaa guutuu koorta?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>Ati namni nama gowwoomsitu,</para>
  <para style="q2" vid="PSA 52:2">arrabni kee badiisa qopheessa;</para>
  <para style="q2" vid="PSA 52:2">arrabni kee akkuma qarabaa qaramee ti.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>Ati waan gaarii irra waan hamaa jaallatta;</para>
  <para style="q2" vid="PSA 52:3">dhugaa dubbachuu irra immoo soba dubbachuu jaallatta.<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>Yaa arraba gowwoomsituu nana,</para>
  <para style="q2" vid="PSA 52:4">ati dubbii nama miidhu hunda jaallatta.<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>Kanaafuu Waaqni bara baraan si balleessa:</para>
  <para style="q2" vid="PSA 52:5">Inni dunkaana kee keessaa butee si ciccira;</para>
  <para style="q2" vid="PSA 52:5">biyya jiraattotaa keessaas si buqqisa.<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Qajeeltonni waan kana arganii sodaatan;</para>
  <para style="q2" vid="PSA 52:6">isaanis akkana jedhanii isatti kolfan;<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“Kunoo, namicha Waaqa daʼoo isaa hin godhatin,</para>
  <para style="q2" vid="PSA 52:7">qooda kanaa immoo baayʼina qabeenya isaa amanatee</para>
  <para style="q2" vid="PSA 52:7">jalʼina ofiitti ciche!”<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>Ani garuu akkuma ejersa</para>
  <para style="q2" vid="PSA 52:8">mana Waaqaa keessatti lalisuu ti;</para>
  <para style="q1" vid="PSA 52:8">baraa hamma bara baraattis, jaalala Waaqaa kan</para>
  <para style="q2" vid="PSA 52:8">hin geeddaramne sana nan amanadha.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Sababii ati waan kana gooteef</para>
  <para style="q2" vid="PSA 52:9">ani bara baraan sin galateeffadha;</para>
  <para style="q1" vid="PSA 52:9">sababii maqaan kee gaarii taʼeef ani maqaa kee nan abdadha.</para>
  <para style="q2" vid="PSA 52:9">Fuula qulqulloota kee durattis sin leellisa.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">Faarfannaa 53</para>
  <para style="ms1">Waan Warra Waaqatti Hin Bulle Eeggatu</para>
  <para style="mr">
    <ref loc="PSA 53:1-6">53:1‑6</ref> kwf – <char style="xt"><ref loc="PSA 14:1-7">Far 14:1‑7</ref></char></para>
  <para style="d">Dura buʼaa faarfattootaatiif. Gosa Muuziiqaa <char style="tl">maahilaati</char> jedhamuun faarfatame. <char style="tl">Maskiilii</char> Daawiti.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>Gowwaan garaa isaatti, “Waaqni hin jiru” jedha.</para>
  <para style="q2" vid="PSA 53:1">Isaan xuraaʼaniiru; karaan isaaniis jibbisiisaa dha;</para>
  <para style="q2" vid="PSA 53:1">namni waan gaarii hojjetu tokko iyyuu hin jiru.<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>Waaqni yoo namni waa hubatu,</para>
  <para style="q2" vid="PSA 53:2">kan Waaqas barbaadu tokko iyyuu jiraate</para>
  <para style="q1" vid="PSA 53:2">arguuf jedhee,</para>
  <para style="q2" vid="PSA 53:2">samii irraa ilmaan namootaa gad ilaala.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>Hundinuu dogoggoraniiru;</para>
  <para style="q2" vid="PSA 53:3">hundi isaaniis xuraaʼaniiru;</para>
  <para style="q1" vid="PSA 53:3">namni waan gaarii hojjetu tokko iyyuu hin jiru;</para>
  <para style="q2" vid="PSA 53:3">tokkumti iyyuu hin jiru.<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Warri hammina hojjetan,</para>
  <para style="q2" vid="PSA 53:4">kanneen akkuma waan buddeena nyaataniitti saba koo nyaatan,</para>
  <para style="q2" vid="PSA 53:4">warri Waaqa hin waammanne hundinuu homaa hin beekanii?<verse eid="PSA 53:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>Isaan iddoo wanni sodaatamu hin jirretti,</para>
  <para style="q2" vid="PSA 53:5">sodaadhaan liqimfamaniiru.</para>
  <para style="q1" vid="PSA 53:5">Waaqni lafee warra si marsanii ni bittinneessa;</para>
  <para style="q2" vid="PSA 53:5">sababii Waaqni isaan tuffateef, ati isaan qaanessite.<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>Maaloo utuu Xiyoon keessaa fayyinni Israaʼeliif dhufee!</para>
  <para style="q2" vid="PSA 53:6">Yommuu Waaqni saba isaa warra boojiʼaman deebisutti,</para>
  <para style="q2" vid="PSA 53:6">Yaaqoob haa ililchu; Israaʼelis haa gammadu!<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">Faarfannaa 54</para>
  <para style="ms1">Waaqayyotti Abbaa Murtii Qajeelaatti Iyyachuu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Miʼa ribuutiin. <char style="tl">Maskiilii</char> Daawit. Yeroo warri Ziif Saaʼol bira dhaqanii, “Daawit nu gidduu dhokatee jira” jedhanitti faarfatame.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>Yaa Waaqi, maqaa keetiin na fayyisi;</para>
  <para style="q2" vid="PSA 54:1">humna keetiinis naa murteessi.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>Yaa Waaqi, kadhannaa koo naa dhagaʼi,</para>
  <para style="q2" vid="PSA 54:2">dubbii afaan kootiis dhaggeeffadhu.<verse eid="PSA 54:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>Keessumoonni natti kaʼaniiruutii;</para>
  <para style="q2" vid="PSA 54:3">warri garaa namaa hin laafne lubbuu koo galaafachuu barbaadu;</para>
  <para style="q2" vid="PSA 54:3">Isaanis warra Waaqaaf ulfina hin kenninee dha.<verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Kunoo, Waaqni gargaaraa koo ti;</para>
  <para style="q2" vid="PSA 54:4">Gooftaan jiraachisaa lubbuu koo ti.<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Hamminni warra maqaa na balleessanii isaanumatti haa deebiʼu;</para>
  <para style="q2" vid="PSA 54:5">atis amanamummaa keetiin isaan balleessi.<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>Ani fedhii kootiin aarsaa siif dhiʼeessa;</para>
  <para style="q2" vid="PSA 54:6">yaa <char style="nd">Waaqayyo</char>, ani maqaa kee nan galateeffadha;</para>
  <para style="q2" vid="PSA 54:6">inni gaariidhaatii.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Inni dhiphina koo hundumaa keessaa na baaseeraatii;</para>
  <para style="q2" vid="PSA 54:7">iji koos ol aantummaadhaan diinota koo of jalatti ilaaleera.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">Faarfannaa 55</para>
  <para style="ms1">Kadhannaa Yeroo Ariʼatamaa</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Miʼa ribuutiin. <char style="tl">Maskiilii</char> Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>Yaa Waaqi, kadhannaa koo dhagaʼi;</para>
  <para style="q2" vid="PSA 55:1">waammata koo jalaas hin didin.<verse eid="PSA 55:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2"/>Na dhagaʼiitii deebii naa kenni;</para>
  <para style="q1" vid="PSA 55:2">komiin koo na dhiphisa; anis nagaa dhabeera.<verse eid="PSA 55:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3"/>Sagalee diinaatiin,</para>
  <para style="q2" vid="PSA 55:3">cunqursa namoota hamoos dhufe;</para>
  <para style="q1" vid="PSA 55:3">isaan dhiphina natti fiduutii;</para>
  <para style="q2" vid="PSA 55:3">aariidhaanis na jibbu.<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>Lapheen koo na keessatti dhiphatte;</para>
  <para style="q2" vid="PSA 55:4">sodaan duʼaas na qabate.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Sodaa fi hollannaan natti dhufeera;</para>
  <para style="q2" vid="PSA 55:5">naasuunis na fudhateera.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Anis akkana nan jedhe; <optbreak/> “Utuu ani akkuma gugee qoochoo qabaadhee!</para>
  <para style="q2" vid="PSA 55:6">Silaa asii barrisee nan boqodhan ture.<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>Silaa fagootti baqadhee</para>
  <para style="q2" vid="PSA 55:7">gammoojjii keessa nan bubbula ture;<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>silaa bubbee hamaa fi qilleensa jabaa irraa fagaadhee</para>
  <para style="q2" vid="PSA 55:8">gara iddoo boqonnaa kootti nan ariifadhan ture.”<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>Yaa Gooftaa, namoota hamoo burjaajessi;</para>
  <para style="q2" vid="PSA 55:9">dubbii isaaniis waliin dhaʼi;</para>
  <para style="q2" vid="PSA 55:9">ani magaalaa keessatti goolii fi lola argeeraatii.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>Isaan halkanii guyyaa ol baʼanii dallaa ishee irra naannaʼu;</para>
  <para style="q2" vid="PSA 55:10">jalʼinnii fi rakkinni ishee keessa jira.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Ishee keessa badiisatu jira;</para>
  <para style="q2" vid="PSA 55:11">nama cunqursuu fi gowwoomsuun daandii ishee irraa hin dhabamu.<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Utuu diinni na arrabsee,</para>
  <para style="q2" vid="PSA 55:12">silaa obsuu nan dandaʼa ture;</para>
  <para style="q1" vid="PSA 55:12">utuu amajaajiin natti kaʼee,</para>
  <para style="q2" vid="PSA 55:12">silaa jalaa dhokachuu nan dandaʼa ture.<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>Garuu siʼi namuma akka kootii,</para>
  <para style="q2" vid="PSA 55:13">hiriyaa koo, michuu koo kan natti dhiʼaatutu waan kana godhe.<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>Tokkummaadhaan mana Waaqaa walii wajjin deemne;</para>
  <para style="q2" vid="PSA 55:14">haasaa miʼaawaas walii wajjin haasofne.<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>Duuti tasa isaanitti haa dhufu;</para>
  <para style="q2" vid="PSA 55:15">utuma lubbuudhaan jiranuu siiʼool keessa haa buʼan;</para>
  <para style="q2" vid="PSA 55:15">hamminni mana isaaniitii fi garaa isaanii keessa jiraattii.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>Ani garuu Waaqa nan waammadha;</para>
  <para style="q2" vid="PSA 55:16">
    <char style="nd">Waaqayyos</char> jalaa na baasa.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>Ani galgala, ganamaa fi waareetti dhiphinaan nan iyya;</para>
  <para style="q2" vid="PSA 55:17">innis sagalee koo ni dhagaʼa.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Yoo namni baayʼeen anaan morme illee,</para>
  <para style="q2" vid="PSA 55:18">inni waraana natti kaʼe jalaa miidhaa malee na baasa.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Waaqni inni durumaa jalqabee teessoo irra jiru sun,</para>
  <para style="q2" vid="PSA 55:19">Namoota karaa isaanii hin geeddaranne,</para>
  <para style="q1" vid="PSA 55:19">kanneen Waaqa hin sodaanne ni dhagaʼa;</para>
  <para style="q2" vid="PSA 55:19">isaan qaanessas.<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Hiriyaan koo michoota isaatti harka isaa ol fudhate;</para>
  <para style="q2" vid="PSA 55:20">kakuu isaa illee ni cabse.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Dubbiin isaa akkuma dhadhaa ti; nama hin quuqu;</para>
  <para style="q2" vid="PSA 55:21">garaa isaa keessa garuu lolatu jira;</para>
  <para style="q1" vid="PSA 55:21">dubbiin isaa zayitii caalaa lallaafa;</para>
  <para style="q2" vid="PSA 55:21">garuu goraadee luqqifamee dha.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>Yaaddoo kee <char style="nd">Waaqayyotti</char> kennadhu;</para>
  <para style="q2" vid="PSA 55:22">inni si jiraachisa;</para>
  <para style="q2" vid="PSA 55:22">namni qajeelaan akka jeqamus hin godhu.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>Yaa Waaqayyo, ati garuu</para>
  <para style="q2" vid="PSA 55:23">namoota hamoo boolla badiisaa keessa ni buufta;</para>
  <para style="q1" vid="PSA 55:23">warri dhiiga dhangalaasanii fi gowwoomsitoonni,</para>
  <para style="q2" vid="PSA 55:23">walakkaa bara jireenya isaanii iyyuu hin jiraatan.</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q1" vid="PSA 55:23">Ani garuu sin amanadha.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">Faarfannaa 56</para>
  <para style="ms1">Waaqa Amanachuu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeedaloo “Gugee Qilxuu Fagoo irraa” jedhuun faarfatame. <char style="tl">Miiktaamii</char> Faarfannaa Daawit. Innis yeroo Filisxeemonni Gaati keessatti isa qaban faarfate.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>Yaa Waaqi na maari;</para>
  <para style="q2" vid="PSA 56:1">diinonni koo akka malee na ariʼu;</para>
  <para style="q2" vid="PSA 56:1">guyyaa guutuus na cunqursu.<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>Diinonni koo guyyaa guutuu na gaadu;</para>
  <para style="q2" vid="PSA 56:2">namoonni baayʼeen of tuulummaadhaan na lolu.<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Ani yommuun sodaadhutti sin amanadha.<verse eid="PSA 56:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 56:4"/>Waaqa ani dubbii isaa jajadhu,</para>
  <para style="q1" vid="PSA 56:4">Waaqa nan amanadha; homaa hin sodaadhu.</para>
  <para style="q2" vid="PSA 56:4">Namni duʼa hin oolle maal na gochuu dandaʼa?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Isaan guyyaa guutuu dubbii koo micciiru;</para>
  <para style="q2" vid="PSA 56:5">na miidhuudhaafis yeroo hunda natti malatu.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Isaan ni mariʼatu; ni riphus;</para>
  <para style="q2" vid="PSA 56:6">lubbuu koo galaafachuuf jedhanii</para>
  <para style="q2" vid="PSA 56:6">tarkaanfii koo eeggatu.<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Sababii hammina isaaniitiif akka isaan miliqan hin godhin;</para>
  <para style="q2" vid="PSA 56:7">yaa Waaqi, dheekkamsa keetiin saboota gad deebisi.<verse eid="PSA 56:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Gadadamu koo galmeessi;</para>
  <para style="q2" vid="PSA 56:8">imimmaan koos kitaaba kee keessatti barreessi;</para>
  <para style="q2" vid="PSA 56:8">isaan galmee kee keessa jiru mitii?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Yommuu ani gargaarsaaf si waammadhutti,</para>
  <para style="q2" vid="PSA 56:9">diinonni koo dugda duuba deebiʼu.</para>
  <para style="q2" vid="PSA 56:9">Anis kanaan akka Waaqni na wajjin jiru beeka.<verse eid="PSA 56:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Waaqa ani dubbii isaa jajadhu,</para>
  <para style="q2" vid="PSA 56:10">
    <char style="nd">Waaqayyo</char> ani dubbii isaa jajadhu,<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>Waaqa nan amanadha; ani homaa hin sodaadhu.</para>
  <para style="q2" vid="PSA 56:11">Namni maal na gochuu dandaʼa?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>Yaa Waaqi wareegni kee narra jira;</para>
  <para style="q2" vid="PSA 56:12">aarsaa galataas siif nan dhiʼeessa.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>Akka ani fuula Waaqaa dura,</para>
  <para style="q2" vid="PSA 56:13">ifa jireenyaa keessa deddeebiʼuuf,</para>
  <para style="q1" vid="PSA 56:13">ati lubbuu koo duʼa jalaa,</para>
  <para style="q2" vid="PSA 56:13">miilla koos gufachuu oolchiteertaatii.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">Faarfannaa 57</para>
  <para style="ms1">Diinota Gara Jabeeyyii Gidduutti</para>
  <para style="mr">
    <ref loc="PSA 57:7-11">57:7‑11</ref> kwf – <char style="xt"><ref loc="PSA 108:1-5">Far 108:1‑5</ref></char></para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeedaloo “Hin balleessin” jedhuun faarfatame. Faarfannaa Daawit. <char style="tl">Miiktaamii.</char> Innis yeroo Saaʼol jalaa baqatee holqatti galee faarfate.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>Na maari; yaa Waaqa na maari;</para>
  <para style="q2" vid="PSA 57:1">lubbuun koo sitti kooluu galtiitii.</para>
  <para style="q1" vid="PSA 57:1">Anis hamma balaan darbutti,</para>
  <para style="q2" vid="PSA 57:1">gaaddisa qoochoo keetii jalatti kooluu nan gala.<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Ani gara Waaqa Waan Hundaa Oliitti,</para>
  <para style="q2" vid="PSA 57:2">gara Waaqa haaloo naa baasuutti nan iyya.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Inni samii irraa ergee na oolcha;</para>
  <para style="q2" vid="PSA 57:3">warra akka malee na ariʼan ni ifata;</para>
  <para style="q2" vid="PSA 57:3">Waaqni jaalala isaatii fi amanamummaa isaa ni erga.<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>Ani leencota gidduun jira;</para>
  <para style="q2" vid="PSA 57:4">ani bineensota nama nyaatan,</para>
  <para style="q1" vid="PSA 57:4">namoota ilkaan isaanii eeboo fi xiyyaa</para>
  <para style="q2" vid="PSA 57:4">kanneen arrabni isaanii akka goraadee qaramaa gidduu ciiseera.<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>Yaa Waaqi, ati samiiwwaniin olitti ol ol jedhi;</para>
  <para style="q2" vid="PSA 57:5">ulfinni kees lafa hunda irra haa jiraatu.<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>Isaanis kiyyoo miilla kootiif kaaʼan;</para>
  <para style="q2" vid="PSA 57:6">lubbuun koos dhiphinaan gad gogdeerti.</para>
  <para style="q1" vid="PSA 57:6">Isaan karaa koo irratti boolla qotan;</para>
  <para style="q2" vid="PSA 57:6">garuu isaanumattu keessatti kufe.<verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>Yaa Waaqi, garaan koo hin raafamu;</para>
  <para style="q2" vid="PSA 57:7">garaan koo hin raafamu;</para>
  <para style="q2" vid="PSA 57:7">ani nan faarfadha; nan weeddisas.<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>Yaa lubbuu ko, dammaqi!</para>
  <para style="q2" vid="PSA 57:8">Yaa kiraaraa fi baganaa dammaqaa!</para>
  <para style="q2" vid="PSA 57:8">Anis ganamaan nan dammaqa.<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>Yaa Gooftaa, ani saboota gidduutti galata siif nan galcha;</para>
  <para style="q2" vid="PSA 57:9">namoota gidduuttis waaʼee kee nan faarfadha.<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>Jaalalli kee guddaa dha; samiiwwanis gaʼaatii;</para>
  <para style="q2" vid="PSA 57:10">amanamummaan kees samiiwwan qaqqaba.<verse eid="PSA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>Yaa Waaqi, ati samiiwwaniin olitti ol ol jedhi;</para>
  <para style="q2" vid="PSA 57:11">ulfinni kees lafa hunda irra haa jiraatu.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">Faarfannaa 58</para>
  <para style="ms1">Abbaa Murtii Kan Abbootii Murtii Biyya Lafaa</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeedaloo “Hin balleessin” jedhuun faarfatame. Faarfannaa Daawiti. <char style="tl">Miiktaamii.</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>Yaa bulchitoota, isin dhugumaan waan qajeelaa dubbattanii?</para>
  <para style="q2" vid="PSA 58:1">Nama gidduuttis murtii qajeelaa kennitanii?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>Akkas miti; isin garaa keessan keessatti hammina yaaddu;</para>
  <para style="q2" vid="PSA 58:2">harki keessanis lafa irratti goolii kaasa.<verse eid="PSA 58:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Namoonni hamoon dhalootumaa kaasanii karaa irraa jalʼatu;</para>
  <para style="q2" vid="PSA 58:3">gadameessa haadha isaaniitii jalqabniis karaa irraa goranii soba dubbatu.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Hadhaan isaanii akkuma hadhaa bofaa ti;</para>
  <para style="q2" vid="PSA 58:4">isaan akkuma buutii duudaa gurra isaa cuqqaalatee<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>sagalee nama isa raatessuu yookaan nama waan ittiin isa raatessu</para>
  <para style="q2" vid="PSA 58:5">hojjetu tokkoo dhagaʼuu diduu ti.<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>Yaa Waaqi ati ilkaan isaanii afaan isaanii keessatti caccabsi;</para>
  <para style="q2" vid="PSA 58:6">qarriffaa leencotaas daaki, yaa <char style="nd">Waaqayyo</char>!<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>Isaan akkuma bishaan dhangalaʼee baduutti haa badan;</para>
  <para style="q2" vid="PSA 58:7">yeroo iddaa futtaasanitti xiyyi isaanii haa doomu.<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>Akkuma ciilalluu yommuu deemu baquutti,</para>
  <para style="q2" vid="PSA 58:8">akkuma daaʼima utuu yeroon hin gaʼin dhalatuuttis aduu hin argin.<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Utuu okkoteen keessan ibidda qoraattiitiin hin hoʼin,</para>
  <para style="q2" vid="PSA 58:9">jiidhaas taʼu gogaan isaanii haxaaʼamanii balleeffamu.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Namni qajeelaan yommuu haaloo baʼuu kana argutti ni gammada;</para>
  <para style="q2" vid="PSA 58:10">miilla isaas dhiiga namoota hamootiin ni dhiqata.<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>Yommus namoonni akkana ni jedhu;</para>
  <para style="q2" vid="PSA 58:11">“Dhugumaan nama qajeelaadhaaf badhaasni jira;</para>
  <para style="q2" vid="PSA 58:11">dhugumaan Waaqni lafa irratti murtii kennu jira.”<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">Faarfannaa 59</para>
  <para style="ms1">Kadhannaa Diina Jalaa Baʼuuf Dhiʼaate</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeedaloo Daawit kan “Hin balleessin” jedhuun faarfatame. <char style="tl">Miiktaamii.</char> Daawitis yeroo Saaʼol isa ajjeesuudhaaf jedhee namoota ergee mana isaa eegsisetti faarfate.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>Yaa Waaqi, diinota koo jalaa na baasi;</para>
  <para style="q2" vid="PSA 59:1">warra natti kaʼan jalaas na furi.<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>Warra hammina hojjetan jalaa na baasi;</para>
  <para style="q2" vid="PSA 59:2">namoota dhiiga dhangalaasan jalaas na baraari.<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Ilaa, isaan riphanii na eeggachaa jiruu!</para>
  <para style="q2" vid="PSA 59:3">Yaa <char style="nd">Waaqayyo</char>, namoonni hamoon,</para>
  <para style="q2" vid="PSA 59:3">utuu ani balleessaa fi cubbuu hin qabaatin lola natti kaasu.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Ani balleessaa tokko illee hin hojjennee;</para>
  <para style="q2" vid="PSA 59:4">isaan garuu na loluuf qophaaʼaniiru.</para>
  <para style="q2" vid="PSA 59:4">Na gargaaruudhaaf kaʼi; rakkina koos ilaali!<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>Yaa <char style="nd">Waaqayyo</char>, Waaqa Waan Hunda Dandaʼu,</para>
  <para style="q2" vid="PSA 59:5">yaa Waaqa Israaʼel, saboota hunda adabuudhaaf kaʼi;</para>
  <para style="q2" vid="PSA 59:5">warra hammina isaaniitiin yakka hojjetan tokko illee hin maarin.<verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>Isaanis galgala galgala deebiʼanii,</para>
  <para style="q2" vid="PSA 59:6">akka saree gururiʼaa magaalattii irra naannaʼu.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>Waan isaan afaan isaaniitii baasan ilaali;</para>
  <para style="q2" vid="PSA 59:7">hidhii isaanii irra goraadeetu jira;</para>
  <para style="q2" vid="PSA 59:7">isaanis, “Eenyutu nu dhagaʼuu dandaʼa?” jedhu.<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>Yaa <char style="nd">Waaqayyo</char>, ati garuu isaanitti kolfita;</para>
  <para style="q2" vid="PSA 59:8">saboota sana hundumattis ni qoosta.<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>Yaa Jabina ko, ani sin eeggadha;</para>
  <para style="q2" vid="PSA 59:9">yaa Waaqi ati daʼoo koo,<verse eid="PSA 59:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10"/>Waaqa na jaallatuu dha.</para>
  <para style="b" vid="PSA 59:10"/>
  <para style="q1" vid="PSA 59:10">Waaqni fuula koo dura deema;</para>
  <para style="q2" vid="PSA 59:10">akka ani diinota koo moʼannoodhaan of jalatti ilaalu godha.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>Yaa Gooftaa, yaa gaachana keenya,</para>
  <para style="q2" vid="PSA 59:11">ati garuu isaan hin ajjeesin;</para>
  <para style="q1" vid="PSA 59:11">yoo kanaa achii sabni koo ni irraanfata.</para>
  <para style="q2" vid="PSA 59:11">Humna keetiin akka isaan jooran godhi; gad isaan deebisis.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Sababii cubbuu afaan isaaniitiif,</para>
  <para style="q2" vid="PSA 59:12">sababii dubbii hidhii isaaniitiif,</para>
  <para style="q2" vid="PSA 59:12">isaan of tuulummaa isaaniitiin haa qabaman.</para>
  <para style="q1" vid="PSA 59:12">Sababii abaarsaa fi soba isaan dubbataniitiif,<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>dheekkamsaan isaan balleessi;</para>
  <para style="q2" vid="PSA 59:13">akka isaan deebiʼanii hin argamneef isaan balleessi.</para>
  <para style="q1" vid="PSA 59:13">Kanaanis akka Waaqni Yaaqoob irratti mootii taʼe,</para>
  <para style="q2" vid="PSA 59:13">hamma handaara lafaatti ni beekama.<verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>Isaanis galgala galgala deebiʼanii,</para>
  <para style="q2" vid="PSA 59:14">akka saree gururiʼaa, magaalattii irra naannaʼu.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>Isaan waan nyaatan barbaacha asii fi achi jooru;</para>
  <para style="q2" vid="PSA 59:15">yoo quufuu baatan immoo ni iyyu.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Ani garuu waaʼee jabina keetii nan faarfadha;</para>
  <para style="q2" vid="PSA 59:16">ganamaanis waaʼee jaalala keetii nan faarfadha;</para>
  <para style="q1" vid="PSA 59:16">ati daʼoo kootii; yeroo rakkina koottis</para>
  <para style="q2" vid="PSA 59:16">ati iddoo ani itti kooluu galuu dha.<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>Yaa Jabina ko, ani faarfannaa galataa siifin faarfadha;</para>
  <para style="q2" vid="PSA 59:17">yaa Waaqi, ati daʼoo koo ti;</para>
  <para style="q2" vid="PSA 59:17">ati Waaqa ani abdadhuu dha.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">Faarfannaa 60</para>
  <para style="ms1">Kadhannaa Moʼamuu Booddee Dhiʼeeffame</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeedaloo “Daraaraa kakuu” jedhamuun faarfatame. <char style="tl">Miiktaamii</char> Daawit. Barsiisuuf. Yeroo inni Arraam Nahaaraayimii fi Arraam Zoobaa lolee fi yeroo Yooʼaabin deebisee warra Edoomii keessaa namoota kuma kudha lama Sulula soogiddaa keessatti fixetti faarfatame.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>Yaa Waaqi, ati nu gatteerta; nu caccabsiteertas;</para>
  <para style="q2" vid="PSA 60:1">nutti aarteerta; amma garuu iddootti nu deebisi!<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>Ati lafa sochoofteerta; tarsaaftees afaan bansiifteerta;</para>
  <para style="q2" vid="PSA 60:2">caccabaa ishees walitti suphi; isheen raafamteertii.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>Ati akka sabni kee waan hamaadhaan dhiphatu gooteerta;</para>
  <para style="q2" vid="PSA 60:3">daadhii wayinii nu gatantarsus nuu kenniteerta.<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>Akka isaan iddaa jalaa gara isaatti baqataniif,</para>
  <para style="q2" vid="PSA 60:4">ati warra si sodaataniif mallattoo kenniteerta.<verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Akka warri ati jaallattu furamaniif,</para>
  <para style="q2" vid="PSA 60:5">harka kee mirgaatiin nu oolchi; nu gargaaris.<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>Waaqni iddoo qulqullummaa isaatii akkana jedhee dubbateera;</para>
  <para style="q2" vid="PSA 60:6">“Ani gammachuudhaan Sheekemin gargar nan qooda;</para>
  <para style="q2" vid="PSA 60:6">Sulula Sukootis nan safara.<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>Giliʼaad kan koo ti; Minaaseenis kan koo ti.</para>
  <para style="q2" vid="PSA 60:7">Efreem gonfoo sibiilaa koo ti;</para>
  <para style="q2" vid="PSA 60:7">Yihuudaanis bokkuu mootummaa koo ti.<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Moʼaab caabii dhiqannaa koo ti;</para>
  <para style="q2" vid="PSA 60:8">Edoom irra kophee koo darbadhee nan buusa;</para>
  <para style="q2" vid="PSA 60:8">Filisxeem irrattis moʼannaadhaan nan geerara.”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>Eenyutu magaalaa jabeeffamtee ijaaramtetti na fida?</para>
  <para style="q2" vid="PSA 60:9">Eenyutu Edoomitti na geessa?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>Yaa Waaqi, kan nu gatte suma mitii?</para>
  <para style="q2" vid="PSA 60:10">Yaa Waaqi, kan loltoota keenya wajjin baʼuu diddes suma mitii?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>Diina keenya of irraa dhowwuu nu gargaar;</para>
  <para style="q2" vid="PSA 60:11">gargaarsi namaa faayidaa hin qabuutii.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>Nu Waaqa wajjin ni moʼanna;</para>
  <para style="q2" vid="PSA 60:12">innis diinota keenya gad dhidhiita.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">Faarfannaa 61</para>
  <para style="ms1">Faarfannaa Nama Boojiʼamee</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit kan miʼa ribuutiin faarfatame.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>Yaa Waaqi, iyyata koo dhagaʼi;</para>
  <para style="q2" vid="PSA 61:1">kadhannaa koos dhaggeeffadhu.<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>Yeroo garaan koo citetti,</para>
  <para style="q2" vid="PSA 61:2">ani handaara lafaatii sin waammadha;</para>
  <para style="q2" vid="PSA 61:2">ati gara kattaa na caalaa ol dheeratuutti na geessi.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>Ati iddoo ani itti kooluu galuudhaatii;</para>
  <para style="q2" vid="PSA 61:3">fuula diina koo durattis gamoo jabaa dha.<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>Ani bara baraan dunkaana kee keessa jiraachuu,</para>
  <para style="q2" vid="PSA 61:4">gaaddisa qoochoo keetii jalattis kooluu galuu nan hawwa.<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>Yaa Waaqi, ati wareega koo dhageesseertaatii;</para>
  <para style="q2" vid="PSA 61:5">dhaala warri maqaa kee sodaatan argatanis naa kenniteerta.<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>Bara jireenya mootii, umurii isaa illee</para>
  <para style="q2" vid="PSA 61:6">dhalootaa gara dhalootaatti dheeressi.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>Innis fuula Waaqaa duratti bara baraan haa moʼu;</para>
  <para style="q2" vid="PSA 61:7">akka jaalalli keetii fi amanamummaan kee isa eeganis godhi.<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Anis faarfannaa galataa maqaa keetiif nan faarfadha;</para>
  <para style="q2" vid="PSA 61:8">guyyuma guyyaanis wareega koo nan guuttadha.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">Faarfannaa 62</para>
  <para style="ms1">Waaqa Qofa Abdachuu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeduutuuniif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>Lubbuun koo Waaqa qofa eeggatti;</para>
  <para style="q2" vid="PSA 62:1">fayyinni koos isa biraa naa dhufa.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>Kattaan kootii fi fayyinni koo isa qofa;</para>
  <para style="q2" vid="PSA 62:2">inni daʼoo koo ti; ani gonkumaa hin raafamu.<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Isin hamma yoomiitti nama miitu?</para>
  <para style="q2" vid="PSA 62:3">Hamma yoomiitti akka keenyan manaa kan duufeetti,</para>
  <para style="q2" vid="PSA 62:3">akka dallaa raafameettis lafaan isa dhaʼuu barbaaddu?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Isaan aangoo isaa guddaa sana irraa,</para>
  <para style="q2" vid="PSA 62:4">guutummaatti gad isa deebisuu barbaadu;</para>
  <para style="q2" vid="PSA 62:4">isaan sobatti ni gammadu.</para>
  <para style="q1" vid="PSA 62:4">Afaan isaaniitiin ni eebbisu;</para>
  <para style="q2" vid="PSA 62:4">garaa isaaniitiin garuu ni abaaru.<verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>Lubbuun koo Waaqa qofa obsaan eeggatti;</para>
  <para style="q2" vid="PSA 62:5">abdiin koo isa biraa dhufaatii.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>Kattaan kootii fi fayyinni koo isa qofa;</para>
  <para style="q2" vid="PSA 62:6">inni daʼoo koo ti; ani hin raafamu.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>Fayyinni kootii fi ulfinni koo harka Waaqaa keessa jira;</para>
  <para style="q2" vid="PSA 62:7">kattaan koo jabaan, iddoon ani itti kooluu galu Waaqa.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>Yaa namoota, yeroo hunda isa amanadhaa;</para>
  <para style="q2" vid="PSA 62:8">garaa keessanis fuula isaa duratti dhangalaasaa;</para>
  <para style="q2" vid="PSA 62:8">Waaqni iddoo nu itti kooluu galluudhaatii.<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>Gosa tuffatamaa irraa dhalachuun homaa miti;</para>
  <para style="q2" vid="PSA 62:9">gosa kabajamaa irraa dhalachuunis sobuma;</para>
  <para style="q1" vid="PSA 62:9">yoo madaaliidhaan madaalaman</para>
  <para style="q2" vid="PSA 62:9">lachanuu qilleensa caalaa salphatu.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Waan saamichaan argattan hin amanatinaa;</para>
  <para style="q2" vid="PSA 62:10">waan hatameenis hin koorinaa.</para>
  <para style="q1" vid="PSA 62:10">Yoo qabeenyi keessan guddate illee,</para>
  <para style="q2" vid="PSA 62:10">qalbii keessan isa irra hin kaaʼatinaa.<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Waaqni yeroo tokko dubbate;</para>
  <para style="q2" vid="PSA 62:11">ani immoo yeroo lama nan dhagaʼe;</para>
  <para style="q1" vid="PSA 62:11">kunis akka humni kan Waaqaa taʼee dha.<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>Yaa Gooftaa araarri kan kee ti.</para>
  <para style="q1" vid="PSA 62:12">Ati dhugumaan tokkoo tokkoo namaa</para>
  <para style="q2" vid="PSA 62:12">akkuma hojii isaatti gatii isaa ni kennitaaf.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">Faarfannaa 63</para>
  <para style="ms1">Waaqa Barbaacha</para>
  <para style="d">Faarfannaa Daawit. Yeroo inni Gammoojjii Yihuudaa keessa turetti.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>Yaa Waaqi, ati Waaqa koo ti;</para>
  <para style="q2" vid="PSA 63:1">ani dhugumaan sin barbaadadha;</para>
  <para style="q1" vid="PSA 63:1">lafa gogaa fi gammoojjii,</para>
  <para style="q2" vid="PSA 63:1">lafa bishaan hin jirretti,</para>
  <para style="q1" vid="PSA 63:1">lubbuun koo si dheebotti;</para>
  <para style="q2" vid="PSA 63:1">foon koos sitti gaggaba.<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>Kanaafuu ani iddoo qulqulluu keessattin si arge;</para>
  <para style="q2" vid="PSA 63:2">humna keetii fi ulfina kees nan ilaale.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Waan jaalalli kee jireenya caaluuf,</para>
  <para style="q2" vid="PSA 63:3">hidhiin koo si jajatti.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Ani hamman jirutti sin eebbisa;</para>
  <para style="q2" vid="PSA 63:4">maqaa keetiinis harka koo ol nan qabadha.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Lubbuun koo akka nama dhukaa fi cooma quufeetti quufti;</para>
  <para style="q2" vid="PSA 63:5">afaan koos hidhii ililleetiin si jajata.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Ani siree koo irratti sin yaadadha;</para>
  <para style="q2" vid="PSA 63:6">halkan guutuus waaʼee kee nan yaada.<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>Waan ati gargaarsa koo taateef,</para>
  <para style="q2" vid="PSA 63:7">ani gaaddisa qoochoo keetii jalatti gammachuudhaan nan faarfadha.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Lubbuun koo sitti maxxanti;</para>
  <para style="q2" vid="PSA 63:8">harki kee mirgaa ol na qaba.<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Warri lubbuu koo galaafachuu barbaadan garuu</para>
  <para style="q2" vid="PSA 63:9">boolla lafaa isa gad fagoo keessa buʼu.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Isaan dabarfamanii goraadeetti kennamu;</para>
  <para style="q2" vid="PSA 63:10">nyaata waangoos ni taʼu.<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>Mootiin garuu Waaqaatti ni gammada;</para>
  <para style="q2" vid="PSA 63:11">namni Waaqaan kakatu hundinuu ulfina argata;</para>
  <para style="q2" vid="PSA 63:11">afaan warra soba dubbatuu immoo ni cufama.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">Faarfannaa 64</para>
  <para style="ms1">Warri Nama Arrabsan Adabamuu Isaanii</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>Yaa Waaqi, yommuu ani iyyadhu sagalee koo dhagaʼi;</para>
  <para style="q2" vid="PSA 64:1">lubbuu koos doorsisuu diinaa duraa baasi.<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>Marii jalʼootaa duraa,</para>
  <para style="q2" vid="PSA 64:2">mala namoota hamoo duraas na dhoksi.<verse eid="PSA 64:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Isaan arraba isaanii akka goraadee qaratan;</para>
  <para style="q2" vid="PSA 64:3">dubbii hadhaaʼaas akkuma xiyyaatti qopheeffatu.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>Isaan riphanii nama yakka hin qabnetti futtaasu;</para>
  <para style="q2" vid="PSA 64:4">akkuma tasaas sodaa malee itti gad dhiisu.<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Kaayyoo jalʼinaa irratti wal jajjabeessu;</para>
  <para style="q2" vid="PSA 64:5">waaʼee dhoksanii kiyyoo kaaʼuus ni mariʼatu;</para>
  <para style="q2" vid="PSA 64:5">“Eenyutu isa arguu dandaʼa?” jedhaniis ni yaadu.<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Isaanis jalʼina yaaduudhaan,</para>
  <para style="q2" vid="PSA 64:6">“Nu mala hirʼina hin qabne malanneerra!” jedhu;</para>
  <para style="q2" vid="PSA 64:6">yaadnii fi keessi garaa namaa gad fagoodhaatii.<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>Waaqni garuu xiyya isaa isaanitti futtaasa;</para>
  <para style="q2" vid="PSA 64:7">isaanis akkuma tasaa madaaʼu.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Innis arrabuma isaaniin isaan balleessa;</para>
  <para style="q2" vid="PSA 64:8">warri isaan argan hundinuu tuffiidhaan mataa raasu.<verse eid="PSA 64:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>Namoonni hundinuu ni sodaatu;</para>
  <para style="q2" vid="PSA 64:9">isaan hojii Waaqaa ni labsu;</para>
  <para style="q2" vid="PSA 64:9">waan inni hojjete illee ni qalbeeffatu.<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Namni qajeelaan <char style="nd">Waaqayyotti</char> gammada;</para>
  <para style="q2" vid="PSA 64:10">isattis kooluu gala;</para>
  <para style="q2" vid="PSA 64:10">gara toleeyyiin hundinuu isaan ulfina argatu.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">Faarfannaa 65</para>
  <para style="ms1">Sababii Kennaa Isaatiif Waaqayyon Jajachuu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>Yaa Waaqi, Xiyoon keessatti galatatu si eeggata;</para>
  <para style="q2" vid="PSA 65:1">wareegni keenyas siif galfama.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>Yaa isa kadhannaa namaa dhageessu,</para>
  <para style="q2" vid="PSA 65:2">namni hundinuu gara kee ni dhufa.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Yeroo cubbuun na moʼattetti,</para>
  <para style="q2" vid="PSA 65:3">ati yakka keenya nuu dhiifteerta.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>Warri ati filattee akka isaan qeʼee kee jiraataniif</para>
  <para style="q2" vid="PSA 65:4">ofitti dhiʼeessite eebbifamoo dha!</para>
  <para style="q1" vid="PSA 65:4">Nus waan gaarii mana keetiitiin,</para>
  <para style="q2" vid="PSA 65:4">kan mana qulqullummaa keetiitiinis ni quufna.<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Yaa Waaqi Fayyisaa keenya,</para>
  <para style="q2" vid="PSA 65:5">ati hojii qajeelummaa sodaachisaadhaan <optbreak/> deebii nuu kennita;</para>
  <para style="q1" vid="PSA 65:5">daarii lafaa hundumaaf,</para>
  <para style="q2" vid="PSA 65:5">galaana fagootti argamuufis ati abdii dha;<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>ati humna uffatteerta;</para>
  <para style="q2" vid="PSA 65:6">jabina keetiinis tulluuwwan hundeessite;<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>ati huursaa galaanaa,</para>
  <para style="q2" vid="PSA 65:7">huursaa dhaʼaa bishaanii,</para>
  <para style="q2" vid="PSA 65:7">raafama uummataas ni calʼisiifte.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Warri fagoo jiraatan dinqiiwwan kee ni sodaatu;</para>
  <para style="q2" vid="PSA 65:8">ati yeroo bariʼuu fi yeroo dhiʼutti,</para>
  <para style="q2" vid="PSA 65:8">akka faarfannaan gammachuu faarfatamu ni goota.<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Ati lafa ni eegda; bishaanis ni obaafta;</para>
  <para style="q2" vid="PSA 65:9">akka malees ni gabbifta;</para>
  <para style="q1" vid="PSA 65:9">akka namootaaf midhaan kennaniifis</para>
  <para style="q2" vid="PSA 65:9">lageen Waaqaa bishaaniin guutamaniiru;</para>
  <para style="q2" vid="PSA 65:9">ati kanumaaf qopheessiteertaatii.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Boʼoo isaa bishaan quubsita;</para>
  <para style="q2" vid="PSA 65:10">biyyoo isaas wal qixxeessita;</para>
  <para style="q1" vid="PSA 65:10">tiifuu bokkaatiinis ni jiifta;</para>
  <para style="q2" vid="PSA 65:10">biqila isaas ni eebbifta.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Gaarummaa keetiin bara ni gonfita;</para>
  <para style="q2" vid="PSA 65:11">daandiiwwan kees cooma coccobsu.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>Lafti margaa kan gammoojjii akka malee misa;</para>
  <para style="q2" vid="PSA 65:12">gaarranis gammachuudhaan guutamu.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Dirreewwan bushaayeedhaan guutamu;</para>
  <para style="q2" vid="PSA 65:13">sululoonni midhaaniin haguugamu;</para>
  <para style="q2" vid="PSA 65:13">isaanis ililleedhaan iyyanii faarfatu.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">Faarfannaa 66</para>
  <para style="ms1">Waaqa Galateeffachuu</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>Isin lafti hundinuu ililleedhaan gara Waaqaatti iyyaa!<verse eid="PSA 66:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2"/>Ulfina maqaa isaa faarfadhaa;</para>
  <para style="q2" vid="PSA 66:2">galata isaatiifis ulfina kennaa!<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Waaqaan akkana jedhaa;</para>
  <para style="q2" vid="PSA 66:3">“Hojiin kee akkam sodaachisaa dha!</para>
  <para style="q1" vid="PSA 66:3">Sababii humni kee guddaa taʼeef,</para>
  <para style="q2" vid="PSA 66:3">diinonni kee fuula kee duratti hollatu.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>Lafti hundinuu siif sagadu;</para>
  <para style="q2" vid="PSA 66:4">faarfannaa galataa siif faarfatu;</para>
  <para style="q2" vid="PSA 66:4">maqaa keetiifis faarfatu.”<verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Kottaatii waan Waaqni hojjete,</para>
  <para style="q2" vid="PSA 66:5">hojii sodaachiisaa inni namaaf hojjete ilaalaa!<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>Inni galaana lafa gogaatti geeddare;</para>
  <para style="q2" vid="PSA 66:6">isaanis miilla isaaniitiin laga ceʼan;</para>
  <para style="q2" vid="PSA 66:6">kottaa isatti haa gammannu!<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>Inni bara baraan humna isaatiin bulcha;</para>
  <para style="q2" vid="PSA 66:7">iji isaas saboota ilaala;</para>
  <para style="q2" vid="PSA 66:7">finciltoonni ol ol of hin qabin.<verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>Yaa saboota, Waaqa keenya eebbisaa;</para>
  <para style="q2" vid="PSA 66:8">sagaleen isa galateeffatus haa dhagaʼamu;<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>inni lubbuu keenya jiraachiseera;</para>
  <para style="q2" vid="PSA 66:9">miilla keenyas mucucaachuu oolcheera.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>Yaa Waaqayyo, ati nu qorteertaatii;</para>
  <para style="q2" vid="PSA 66:10">akkuma meetiis nu qulqulleessiteerta.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Ati kiyyootti nu galchiteerta;</para>
  <para style="q2" vid="PSA 66:11">dugda keenya irras baʼaa keesseerta.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Akka namoonni mataa keenya yaabbatan gooteerta;</para>
  <para style="q2" vid="PSA 66:12">nu ibiddaa fi bishaan keessa dabarre;</para>
  <para style="q2" vid="PSA 66:12">ati garuu iddoo badhaadhummaatti nu fidde.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Anis qalma gubamu qabadhee <optbreak/> mana qulqullummaa kee nan seena;</para>
  <para style="q2" vid="PSA 66:13">wareega koos siif nan galcha;<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>kunis wareega yeroo ani rakkina keessa turetti</para>
  <para style="q2" vid="PSA 66:14">arrabni koo waadaa galee afaan koos dubbatee dha.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Anis horii coccoomoo, qalma gubamu,</para>
  <para style="q2" vid="PSA 66:15">korbeeyyii hoolaa immoo aarsaa godhee siif nan dhiʼeessa;</para>
  <para style="q2" vid="PSA 66:15">jibootaa fi reʼoota illee aarsaa siifin dhiʼeessa.<verse eid="PSA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Isin warri Waaqa sodaattan hundi kottaa dhaggeeffadhaa;</para>
  <para style="q2" vid="PSA 66:16">anis waan inni naaf godhe isinitti nan hima.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Ani afaan kootiin isatti nan iyye;</para>
  <para style="q2" vid="PSA 66:17">galanni isaas arraba koo irra ture.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Utuu ani garaa koo keessa cubbuu kaaʼadhee jiraadhee,</para>
  <para style="q2" vid="PSA 66:18">silaa Gooftaan naaf hin dhagaʼu ture;<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>Waaqni garuu dhugumaan na dhaggeeffateera;</para>
  <para style="q2" vid="PSA 66:19">sagalee kadhannaa kootiis dhagaʼeera.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Waaqni kadhannaa koo hin didin</para>
  <para style="q2" vid="PSA 66:20">yookaan jaalala isaa na hin dhowwatin haa eebbifamu!<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">Faarfannaa 67</para>
  <para style="ms1">Faarfannaa Yeroo Midhaan Galfamuu</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Miʼa ribuutiin. Faarfannaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>Waaqni garaa nuuf laafu; nu haa eebbisus;</para>
  <para style="q2" vid="PSA 67:1">fuula isaas nurratti haa ibsu;<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>kunis akka karaan kee lafa irratti,</para>
  <para style="q2" vid="PSA 67:2">fayyisuun kee immoo saboota hundumaa biratti beekamuuf.<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>Yaa Waaqayyo, saboonni si haa jajatan;</para>
  <para style="q2" vid="PSA 67:3">saboonni hundii si haa jajatan.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>Ati waan qajeelummaadhaan namoota bulchituuf,</para>
  <para style="q2" vid="PSA 67:4">saboota lafa irraas waan geggeessituuf,</para>
  <para style="q2" vid="PSA 67:4">saboonni haa gammadanis; ililchaniis haa faarfatan.<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Yaa Waaqayyo, saboonni si haa jajatan;</para>
  <para style="q2" vid="PSA 67:5">saboonni hundii si haa jajatan.<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>Lafti midhaan kenniteerti;</para>
  <para style="q2" vid="PSA 67:6">Waaqayyo Waaqni keenyas nu eebbiseera.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Waaqni nu eebbiseera;</para>
  <para style="q2" vid="PSA 67:7">handaarri lafaa hundi isa haa sodaatu.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">Faarfannaa 68</para>
  <para style="ms1">Faarfannaa Moʼannoo</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>Waaqni haa kaʼu; diinonni isaas haa bittinnaaʼan;</para>
  <para style="q2" vid="PSA 68:1">warri isa jibbanis fuula isaa duraa haa baqatan.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Akkuma aarri bittinnaaʼu, ati isaan bittinneessi;</para>
  <para style="q2" vid="PSA 68:2">akkuma gagaan ibidda duratti baqu,</para>
  <para style="q2" vid="PSA 68:2">hamoonni fuula Waaqaa duraa haa badan.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>Qajeelonni garuu haa gammadan;</para>
  <para style="q2" vid="PSA 68:3">fuula Waaqaa durattis baayʼee haa gammadan;</para>
  <para style="q2" vid="PSA 68:3">isaan gammachuudhaan haa ililchan.<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>Waaqaaf faarfadhaa;</para>
  <para style="q2" vid="PSA 68:4">faarfannaa galataa maqaa isaatiif faarfadhaa;</para>
  <para style="q2" vid="PSA 68:4">isa duumessaan gulufu sana jajadhaa;</para>
  <para style="q1" vid="PSA 68:4">maqaan isaa <char style="nd">Waaqayyoo</char> dha;</para>
  <para style="q2" vid="PSA 68:4">fuula isaa durattis baayʼee gammadaa.<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>Waaqni warra abbaa hin qabneef abbaa,</para>
  <para style="q2" vid="PSA 68:5">niitota dhirsoonni irraa duʼaniifis falmaa taʼe sun</para>
  <para style="q2" vid="PSA 68:5">iddoo jireenya isaa qulqulluu keessa jira.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Waaqni warra kophaa taʼan maatii keessa jiraachisa;</para>
  <para style="q2" vid="PSA 68:6">warra hidhamanis mana hidhaatii baasa;</para>
  <para style="q2" vid="PSA 68:6">finciltoonni garuu lafa gogaa irra jiraatu.<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>Yaa Waaqayyo, gaafa ati saba kee dura baate,</para>
  <para style="q2" vid="PSA 68:7">gaafa ati gammoojjii keessa dabarte,<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>fuula Waaqaa, Waaqa Siinaa duratti,</para>
  <para style="q2" vid="PSA 68:8">fuula Waaqaa, Waaqa Israaʼel duratti,</para>
  <para style="q2" vid="PSA 68:8">lafti ni raafamte; samiiwwanis bokkaa roobsan.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>Yaa Waaqayyo, ati bokkaa baayʼee roobsite;</para>
  <para style="q2" vid="PSA 68:9">dhaala kee kan dadhabe illee ni quubsite.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>Sabni kee achi qubate;</para>
  <para style="q2" vid="PSA 68:10">yaa Waaqayyo, ati badhaadhummaa kee keessaa <optbreak/> hiyyeeyyii soorte.<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>Gooftaan dubbii isaa kenne;</para>
  <para style="q2" vid="PSA 68:11">dubartoonni dubbii sana labsanis baayʼee dha:<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“Mootonnii fi loltoonni ariitiin baqatan;</para>
  <para style="q2" vid="PSA 68:12">dubartoonni qeʼee oolan boojuu qooddatan.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>Yoo gola hoolotaa gidduutti argamtan illee,</para>
  <para style="q2" vid="PSA 68:13">isin akka gugee qoochoon ishee meetiidhaan uffifamee</para>
  <para style="q2" vid="PSA 68:13">baalleen ishee immoo warqee calaqqisuun uffifamee ti.”<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Yommuu Waaqni Waan Hunda Dandaʼu</para>
  <para style="q2" vid="PSA 68:14">mootota achitti bittinneessetti, <optbreak/> Zalmoon irratti cabbiin buʼe.<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Yaa tulluu Baashaan, yaa tulluu surra qabeessa,</para>
  <para style="q2" vid="PSA 68:15">yaa Tulluu Baashaan, yaa tulluu fiixee baayʼee qabu,<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>yaa tulluu fiixee baayʼee qabdu,</para>
  <para style="q2" vid="PSA 68:16">ati maaliif tulluu Waaqni bulchuuf filate,</para>
  <para style="q2" vid="PSA 68:16">iddoo <char style="nd">Waaqayyo</char> bara baraan jiraatu sana <optbreak/> hinaaffaadhaan ilaalta?<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>Gaariiwwan Waaqaa kuma hedduu dha;</para>
  <para style="q2" vid="PSA 68:17">isaan kumaatama yeroo kumaatamaa ti;</para>
  <para style="q2" vid="PSA 68:17">Gooftaanis Siinaadhaa gara iddoo qulqulluu dhufeera.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Ati yommuu ol gubbaa baatetti</para>
  <para style="q2" vid="PSA 68:18">boojuu baayʼee fudhate;</para>
  <para style="q1" vid="PSA 68:18">yaa <char style="nd">Waaqayyo</char>, yaa Waaqi, ati achi jiraachuuf jettee,</para>
  <para style="q2" vid="PSA 68:18">namoota irraa, finciltoota irraas kennaa fudhatte.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>Gooftaan guyyuma guyyaan baʼaa keenya baatu,</para>
  <para style="q2" vid="PSA 68:19">Waaqni Fayyissaa keenya taʼe sun haa eebbifamu.<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Waaqni keenya Waaqa fayyinaa ti; duʼa jalaa baʼuunis</para>
  <para style="q2" vid="PSA 68:20">
    <char style="nd">Waaqayyo</char> Goofticha biraa dhufa.<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Waaqni dhugumaan mataa diina isaa,</para>
  <para style="q2" vid="PSA 68:21">gubbee mataa warra cubbuu isaaniitti fufanii <optbreak/> kan rifeensa qabu ni caccabsa.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>Gooftaan akkana jedha; “Ani deebisee Baashaanii isaan nan fida;</para>
  <para style="q2" vid="PSA 68:22">tuujuba galaanaa keessaas deebisee isaan nan fida;<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>kunis akka ati dhiiga diinota keetii miilla keetiin borcituuf;</para>
  <para style="q2" vid="PSA 68:23">arrabni saroota keetiis akka qooda isaanii qabaatuuf.”<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>Yaa Waaqayyo, hiriirri kee mulʼateera;</para>
  <para style="q2" vid="PSA 68:24">hiriirri Waaqa kootiitii fi mootii kootii iddoo qulqulluutti ol galeera.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Fuula duraan faarfattoota,</para>
  <para style="q2" vid="PSA 68:25">dugda duubaan immoo warra muuziiqaa taphatantu ture;</para>
  <para style="q2" vid="PSA 68:25">dubartoonni dibbee rukutanis gidduu isaanii turan.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Waldaa guddaa keessatti Waaqa jajadhaa;</para>
  <para style="q2" vid="PSA 68:26">yaaʼii Israaʼel keessattis <char style="nd">Waaqayyoon</char> jajadhaa.<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>Beniyaam gosti xinnichi isaan dura deema;</para>
  <para style="q2" vid="PSA 68:27">tuunni ilmaan mootota Yihuudaas achi turan;</para>
  <para style="q2" vid="PSA 68:27">ilmaan mootota Zebuuloonii fi Niftaalemis achi turan.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>Yaa Waaqayyo, humna kee ajaji;</para>
  <para style="q2" vid="PSA 68:28">yaa Waaqa keenya, akkuma duraan goote sana <optbreak/> jabina kee nu argisiisi.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>Sababii mana qulqullummaa keetii kan Yerusaalem keessaatiif</para>
  <para style="q2" vid="PSA 68:29">mootonni kennaa siif fidu.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Bineensota shambaqqoo keessaa,</para>
  <para style="q2" vid="PSA 68:30">karra korommii jabboota sabootaa keessaas ifadhu.</para>
  <para style="q1" vid="PSA 68:30">Warra meetii fidan gad deebisi.</para>
  <para style="q2" vid="PSA 68:30">Warra waraanatti gammadanis bittinneessi.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Ergamoonni Gibxi ni dhufu;</para>
  <para style="q2" vid="PSA 68:31">Itoophiyaanis daftee harka ishee Waaqatti balʼifatti.<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>Yaa mootummoota lafaa, Waaqa faarfadhaa;</para>
  <para style="q2" vid="PSA 68:32">faarfannaa galataas Gooftaadhaaf faarfadhaa;<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>isa samiiwwan durii keessa gulufu,</para>
  <para style="q2" vid="PSA 68:33">isa sagalee jabaadhaan qaqawweessaʼu sana faarfadhaa.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>Waaqa ulfinni isaa Israaʼel irra jiru,</para>
  <para style="q2" vid="PSA 68:34">isa miidhaginni isaa</para>
  <para style="q2" vid="PSA 68:34">samiiwwan keessa jiru sana humna isaa labsaa.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>Yaa Waaqayyo, ati iddoo qulqullummaa keetiitti sodaachisaa dha;</para>
  <para style="q2" vid="PSA 68:35">Waaqni Israaʼel saba isaatiif humnaa fi jabina ni kenna.</para>
  <para style="b" vid="PSA 68:35"/>
  <para style="q1" vid="PSA 68:35">Waaqni haa eebbifamu!<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">Faarfannaa 69</para>
  <para style="ms1">Faaruu Booʼichaa</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Yeedaloo “Daraaraatiin.” Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>Yaa Waaqi, ati na baasi;</para>
  <para style="q2" vid="PSA 69:1">bishaan ol dhufee morma na gaʼeeraatii.<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Ani raaree keessa, lafa iddoon miilla dhaabatan</para>
  <para style="q2" vid="PSA 69:2">hin jirre keessa seeneera.</para>
  <para style="q1" vid="PSA 69:2">Ani tuujuba bishaanii keessa seeneera;</para>
  <para style="q2" vid="PSA 69:2">lolaanis narra garagaleera.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Ani iyyuudhaan dadhabeera;</para>
  <para style="q2" vid="PSA 69:3">laagaan koo babbaqaqeera;</para>
  <para style="q2" vid="PSA 69:3">iji koo, Waaqa koo eeggachuudhaan dadhabeera.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Warri lafumaa kaʼanii na jibban</para>
  <para style="q2" vid="PSA 69:4">rifeensa mataa kootii caalaa baayʼatu;</para>
  <para style="q1" vid="PSA 69:4">warri na ajjeesuu barbaadan,</para>
  <para style="q2" vid="PSA 69:4">warri akkasumaan diina koo taʼan baayʼee dha.</para>
  <para style="q1" vid="PSA 69:4">Ani akkan waan hin hatin</para>
  <para style="q2" vid="PSA 69:4">deebisu dirqameera.<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>Yaa Waaqi, ati gowwummaa koo ni beekta;</para>
  <para style="q2" vid="PSA 69:5">yakki koos si duraa hin dhokatu.<verse eid="PSA 69:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>Yaa Gooftaa, <char style="nd">Waaqayyo</char> Waan Hunda Dandeessu,</para>
  <para style="q2" vid="PSA 69:6">warri abdii sirra kaaʼatan,</para>
  <para style="q2" vid="PSA 69:6">sababii kootiif hin qaanaʼin;</para>
  <para style="q1" vid="PSA 69:6">yaa Waaqa Israaʼel, warri si barbaadan,</para>
  <para style="q2" vid="PSA 69:6">sababii kootiif hin qaaneffamin.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Ani siif jedhee tuffii obseeraatii;</para>
  <para style="q2" vid="PSA 69:7">qaaniinis fuula koo haguugeera.<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Ani obboloota kootti keessummaa,</para>
  <para style="q2" vid="PSA 69:8">ilmaan haadha kootiittis alagaa dha;<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>Hinaaffaan mana keetii na guggubeeraatii;</para>
  <para style="q2" vid="PSA 69:9">arrabsoon warra si arrabsaniis narra buʼeera.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>Booʼuu fi soomuun koo,</para>
  <para style="q2" vid="PSA 69:10">arrabsoo natti taʼe.<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>Yommuu ani wayyaa gaddaa uffadhetti,</para>
  <para style="q2" vid="PSA 69:11">namoonni natti qoosu.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Warri karra dura tataaʼan natti qoosu;</para>
  <para style="q2" vid="PSA 69:12">machooftonnis waaʼee kootiin sirbu.<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>Ani garuu yaa <char style="nd">Waaqayyo</char>,</para>
  <para style="q2" vid="PSA 69:13">yeroo ati filattutti sin kadhadha;</para>
  <para style="q1" vid="PSA 69:13">yaa Waaqi, jaalala kee guddichaan</para>
  <para style="q2" vid="PSA 69:13">fayyina kee kan dhugaatiinis deebii naaf kenni.<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Akka ani hin liqimfamneef,</para>
  <para style="q2" vid="PSA 69:14">raaree keessaa na baasi;</para>
  <para style="q1" vid="PSA 69:14">warra na jibban jalaa,</para>
  <para style="q2" vid="PSA 69:14">bishaanota gad fagoo keessaas na baasi.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Ati akka lolaan na hin fudhanne,</para>
  <para style="q2" vid="PSA 69:15">akka tuujubni na hin liqimsine,</para>
  <para style="q2" vid="PSA 69:15">akka boollis afaan isaa natti hin cufanne godhi.<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>Yaa <char style="nd">Waaqayyo</char>, gaarummaa jaalala keetiitiin <optbreak/> deebii naaf kenni;</para>
  <para style="q2" vid="PSA 69:16">araara kee guddichaanis natti garagali.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>Fuula kee tajaajilaa kee duraa hin dhokfatin;</para>
  <para style="q2" vid="PSA 69:17">waan ani rakkina keessa jiruuf dafiitii deebii naaf kenni.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Natti dhiʼaadhuutii na furi;</para>
  <para style="q2" vid="PSA 69:18">xiiqii diinota kootiif jedhii na baasi.<verse eid="PSA 69:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Ati akka ani hammam tuffatamee,</para>
  <para style="q2" vid="PSA 69:19">salphifamee fi akka ani qaaneffame ni beekta;</para>
  <para style="q2" vid="PSA 69:19">diinonni koo hundinuus fuula koo dura jiru.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Arrabsoon garaa koo cabse;</para>
  <para style="q2" vid="PSA 69:20">anis abdii kutadheera.</para>
  <para style="q1" vid="PSA 69:20">Ani nama garaa naaf laafu nan barbaade; garuu nan dhabe;</para>
  <para style="q2" vid="PSA 69:20">nama na jajjabeessus nan barbaade; <optbreak/> garuu tokko illee hin arganne.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Nyaata kootti hadhooftuu makan;</para>
  <para style="q2" vid="PSA 69:21">akka ani dhuguuf immoo waan dhangaggaaʼaa naa kennan.<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>Maaddiin isaanii iddaa isaanitti haa taʼu;</para>
  <para style="q2" vid="PSA 69:22">adabaa fi kiyyoo isaanitti haa taʼu.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>Akka arguu hin dandeenyeef iji isaanii haa haguuggamu;</para>
  <para style="q2" vid="PSA 69:23">dugdi isaaniis bara baraan haa goophatu.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>Dheekkamsa kee isaan irratti dhangalaasi;</para>
  <para style="q2" vid="PSA 69:24">aariin kee bobaʼaan sunis isaan irra haa buʼu.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Qeʼeen isaanii haa onu;</para>
  <para style="q2" vid="PSA 69:25">namni dunkaana isaanii keessa jiraatu tokko iyyuu hin hafin.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>Isaan warra ati madeessite sana ni ariʼatuutii;</para>
  <para style="q2" vid="PSA 69:26">waaʼee dhukkubbii warra ati miite sanaas ni odeessu.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Yakka irratti yakka isaanitti dabali;</para>
  <para style="q2" vid="PSA 69:27">isaan gara qajeelumma keetii hin dhufin.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Maqaan isaanii kitaaba jireenyaa keessaa haa haqamu;</para>
  <para style="q2" vid="PSA 69:28">qajeeltota wajjinis hin galmeeffamin.<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>Ani garuu dhiphinaa fi rakkina keessan jira;</para>
  <para style="q2" vid="PSA 69:29">yaa Waaqi, fayyinni kee ol na haa qabu.<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Ani faarfannaadhaan maqaa Waaqaa nan galateeffadha;</para>
  <para style="q2" vid="PSA 69:30">galataanis ulfina nan kennaaf.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Kunis sangaa caalaa, korma gaanfaa fi</para>
  <para style="q2" vid="PSA 69:31">kottee qabu dhiʼeessuu caalaa <char style="nd">Waaqayyoon</char> gammachiisa.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Hiyyeeyyiin waan kana arganii ni gammadu;</para>
  <para style="q2" vid="PSA 69:32">isin warri Waaqa barbaaddan garaan keessan jiraata haa taʼu!<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>
    <char style="nd">Waaqayyo</char> rakkattoota ni dhagaʼa;</para>
  <para style="q2" vid="PSA 69:33">namoota isaa warra hidhamanis hin tuffatu.<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>Samii fi lafti, galaanonnii fi</para>
  <para style="q2" vid="PSA 69:34">wanni isaan keessa jiraatan hundinuu isa haa leellissan.<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>Waaqni Xiyoonin ni fayyisaatii;</para>
  <para style="q2" vid="PSA 69:35">magaalaawwan Yihuudaas deebisee ni ijaara.</para>
  <para style="q1" vid="PSA 69:35">Sabni isaas achi qubata; ni dhaalas.<verse eid="PSA 69:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36"/>Sanyiin tajaajiltoota isaa magaalattii ni dhaalu;</para>
  <para style="q2" vid="PSA 69:36">warri maqaa isaa jaallatanis achi jiraatu.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">Faarfannaa 70</para>
  <para style="ms1">Iyya Dhiphinaa</para>
  <para style="mr">
    <ref loc="PSA 70:1-5">70:1‑5</ref> kwf – <char style="xt"><ref loc="PSA 40:13-17">Far 40:13‑17</ref></char></para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawiti.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>Yaa Waaqi, na fayyisuuf ariifadhu;</para>
  <para style="q2" vid="PSA 70:1">yaa <char style="nd">Waaqayyo</char>, na gargaaruuf dafii kottu.<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>Warri lubbuu koo galaafachuu barbaadan</para>
  <para style="q2" vid="PSA 70:2">hundinuu, haa qaanaʼan; haa burjaajaʼanis;</para>
  <para style="q1" vid="PSA 70:2">warri badii koo hawwan hundi</para>
  <para style="q2" vid="PSA 70:2">qaanaʼanii duubatti haa deebiʼan.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>Warri, “Baga! Baga!” anaan jedhan</para>
  <para style="q2" vid="PSA 70:3">qaanaʼanii duubatti haa deebiʼan.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>Warri si barbaadan hundinuu garuu</para>
  <para style="q2" vid="PSA 70:4">sitti gammadanii haa ililchan;</para>
  <para style="q1" vid="PSA 70:4">warri fayyisuu kee jaallatan,</para>
  <para style="q2" vid="PSA 70:4">yeroo hunda, “Waaqni guddaa dha!” haa jedhan.<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Ani garuu hiyyeessaa fi rakkataa dha;</para>
  <para style="q2" vid="PSA 70:5">yaa Waaqi, dafii na qaqqabi.</para>
  <para style="q1" vid="PSA 70:5">Ati gargaaraa koo fi fayyisaa koo ti;</para>
  <para style="q2" vid="PSA 70:5">yaa <char style="nd">Waaqayyo</char> hin turin.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">Faarfannaa 71</para>
  <para style="ms1">Kadhannaa Jaarsaa</para>
  <para style="mr">
    <ref loc="PSA 71:1-3">71:1‑3</ref> kwf – <char style="xt"><ref loc="PSA 31:1-4">Far 31:1‑4</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>Yaa <char style="nd">Waaqayyo</char>, ani kooluu sitti galeera;</para>
  <para style="q2" vid="PSA 71:1">ati gonkumaa na hin qaanessin.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>Qajeelummaa keetiin na baasi; na oolchis;</para>
  <para style="q2" vid="PSA 71:2">gurra kee gara kootti qabi; na fayyisis.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Ati kattaa ani kooluu itti galu,</para>
  <para style="q2" vid="PSA 71:3">iddoo ani yeroo hunda itti baqadhu naa taʼi;</para>
  <para style="q1" vid="PSA 71:3">ati waan kattaa koo fi daʼoo koo taateef,</para>
  <para style="q2" vid="PSA 71:3">na baraaruuf ajaja kenni.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>Yaa Waaqa ko, harka nama hamaa,</para>
  <para style="q2" vid="PSA 71:4">qabaa nama jalʼaatii fi gara jabeessaa keessaa na baasi.<verse eid="PSA 71:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Yaa <char style="nd">Waaqayyo</char> Gooftaa, ati abdii kootii;</para>
  <para style="q2" vid="PSA 71:5">ijoollummaa kootii kaaftees ati Waaqa ani amanadhuu dha.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Ani gaafan dhaladhee jalqabee sitti irkadheera;</para>
  <para style="q2" vid="PSA 71:6">gadameessa haadha koo keessaas situ na baase.</para>
  <para style="q2" vid="PSA 71:6">Ani yeroo hunda sin galateeffadha.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Ani namoota baayʼeedhaaf mallattoo taʼeera;</para>
  <para style="q2" vid="PSA 71:7">ati garuu daʼoo koo isa jabaa dha.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Afaan koo guyyaa guutuu,</para>
  <para style="q2" vid="PSA 71:8">galataa fi ulfina keetiin guutama.<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Yeroo ani dulloomutti ati na hin gatin;</para>
  <para style="q2" vid="PSA 71:9">yeroo humni koo dhumuttis na hin dhiisin.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Diinonni koo natti mariʼatuutii;</para>
  <para style="q2" vid="PSA 71:10">warri na ajjeesuuf riphanii eeggatanis walii wajjin natti mariʼatu.<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>Isaanis, “Waaqni isa dhiiseera;</para>
  <para style="q2" vid="PSA 71:11">namni isa oolchu tokko iyyuu hin jiruutii</para>
  <para style="q2" vid="PSA 71:11">faana buʼaatii qabaa” jedhu.<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>Yaa Waaqi, narraa hin fagaatin;</para>
  <para style="q2" vid="PSA 71:12">yaa Waaqa ko, na gargaaruuf dafii kottu.<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Warri na himatan qaanaʼanii haa badan;</para>
  <para style="q2" vid="PSA 71:13">warri na miidhuu barbaadanis</para>
  <para style="q2" vid="PSA 71:13">tuffii fi salphina haa uffatan.<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Ani garuu yeroo hundumaa abdii qaba;</para>
  <para style="q2" vid="PSA 71:14">ittuma caalchisees sin galateeffadha.<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Ani yoo hammam akka inni gaʼu beekuu baadhe illee,</para>
  <para style="q2" vid="PSA 71:15">afaan koo waaʼee qajeelummaa keetiitii fi</para>
  <para style="q2" vid="PSA 71:15">waaʼee fayyisuu keetii guyyaa guutuu ni odeessa.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Yaa <char style="nd">Waaqayyo</char> Gooftaa, ani dhufee</para>
  <para style="q2" vid="PSA 71:16">hojii kee humna qabeessa sana nan odeessa;</para>
  <para style="q2" vid="PSA 71:16">ani qajeelummaa kee qofa labsa.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>Yaa Waaqi, ati ijoollummaa kootii jalqabdee na barsiifteerta;</para>
  <para style="q2" vid="PSA 71:17">anis hamma harʼaatti hojii kee dinqisiisaa sana nan labsa.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>Yaa Waaqayyo, yeroo ani dulloomee mataan koo arrii taʼutti illee,</para>
  <para style="q2" vid="PSA 71:18">hamma ani humna kee dhaloota kanatti,</para>
  <para style="q1" vid="PSA 71:18">jabina kees dhaloota dhufuuf jiru hundatti labsuutti,</para>
  <para style="q2" vid="PSA 71:18">ati na hin dhiisin.<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>Yaa Waaqi, qajeelummaan kee samiiwwan bira gaʼa;</para>
  <para style="q2" vid="PSA 71:19">ati waan gurguddaa hojjetteerta;</para>
  <para style="q2" vid="PSA 71:19">yaa Waaqi, kan akka keetii eenyu?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Ati rakkinaa fi dhiphina baayʼee na argisiifteerta;</para>
  <para style="q2" vid="PSA 71:20">taʼus jireenya koo deebiftee ni haaromsita,</para>
  <para style="q2" vid="PSA 71:20">qilee lafaa keessaas deebiftee ol na baafta.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Ulfina koo ni guddifta;</para>
  <para style="q2" vid="PSA 71:21">amma illee na jajjabeessita.<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>Yaa Waaqa ko, ani amanamummaa keetiif,</para>
  <para style="q2" vid="PSA 71:22">kiraaraan sin faarfadha;</para>
  <para style="q1" vid="PSA 71:22">Yaa Qulqullicha Israaʼel</para>
  <para style="q2" vid="PSA 71:22">ani kiraaraan faarfannaa galataa siif faarfadha.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Yommuu ani faarfannaa galataa siif faarfadhutti, hidhiin koo,</para>
  <para style="q2" vid="PSA 71:23">lubbuun koo kan ati furtes guddisanii ni ililchu.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Warri na miidhuu barbaadan,</para>
  <para style="q2" vid="PSA 71:24">waan qaanaʼanii burjaajaʼaniif</para>
  <para style="q1" vid="PSA 71:24">arrabni koo guyyaa guutuu</para>
  <para style="q2" vid="PSA 71:24">qajeelummaa kee odeessa.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">Faarfannaa 72</para>
  <para style="ms1">Mooticha Abdiin Eegamu</para>
  <para style="d">Faarfannaa Solomoon.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>Yaa Waaqi, murtii kee mootiidhaaf,</para>
  <para style="q2" vid="PSA 72:1">qajeelumma kee immoo ilma mootiitiif kenni.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>Innis saba keetiif qajeelummaadhaan murteessa;</para>
  <para style="q2" vid="PSA 72:2">hiyyeeyyiifis murtii qajeelaa kenna.<verse eid="PSA 72:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Tulluuwwan badhaadhummaa,</para>
  <para style="q2" vid="PSA 72:3">gaarran immoo ija qajeelummaa sabaaf haa fidan.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Inni hiyyeeyyii saba keessa jiraataniif ni falma;</para>
  <para style="q2" vid="PSA 72:4">ijoollee rakkattootaa ni oolcha;</para>
  <para style="q2" vid="PSA 72:4">cunqursituu immoo ni barbadeessa.<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Namoonni hamma aduun jiraattuu fi hamma jiʼi jiraatutti,</para>
  <para style="q2" vid="PSA 72:5">dhalootaa hamma dhalootaatti si sodaatu.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Inni akkuma bokkaa marga haamame irratti roobuu,</para>
  <para style="q2" vid="PSA 72:6">akkuma tiifuu lafa jiisuuttis ni dhufa.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>Bara isaa keessa qajeelummaan ni daraara;</para>
  <para style="q2" vid="PSA 72:7">nageenyis hamma jiʼi dhabamutti ni baayʼata.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Innis galaanaa hamma galaanaatti,</para>
  <para style="q2" vid="PSA 72:8">Laga Efraaxiisii hamma moggaa lafaatti ni bulcha.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Warri gammoojjii keessa jiraatan fuula isaa duratti ni sagadu;</para>
  <para style="q2" vid="PSA 72:9">diinonni isaas biyyoo arraabu.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Mootonni Tarshiishii fi mootonni</para>
  <para style="q2" vid="PSA 72:10">biyyoota qarqarawwan galaana fagoo gibira isaaf ni fidu;</para>
  <para style="q2" vid="PSA 72:10">mootonni Shebaatii fi mootonni Saabaa kennaa ni fiduuf.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Mootonni hundinuus isaaf ni sagadu;</para>
  <para style="q2" vid="PSA 72:11">saboonni hundinuus isa ni tajaajilu.<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>Inni nama rakkatee gara isaatti iyyu,</para>
  <para style="q2" vid="PSA 72:12">hiyyeessaa fi nama gargaarsa hin qabne ni baraaraatii.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Nama dadhabaa fi rakkataaf garaa lafa;</para>
  <para style="q2" vid="PSA 72:13">nama rakkataas duʼa jalaa baasa.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Lubbuu isaaniis hacuuccaa fi cunqursaa jalaa ni fura;</para>
  <para style="q2" vid="PSA 72:14">dhiigni isaanii fuula isaa duratti gatii guddaa qabaatii.<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Umuriin isaa haa dheeratu;</para>
  <para style="q2" vid="PSA 72:15">warqeen Shebaa isaaf haa kennamu.</para>
  <para style="q1" vid="PSA 72:15">Yeroo hunda Waaqa isaaf haa kadhatan;</para>
  <para style="q2" vid="PSA 72:15">guyyaa guutuus isa haa eebbisan.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Lafa irratti midhaan akka malee haa baayʼatu;</para>
  <para style="q2" vid="PSA 72:16">fiixee tulluuwwanii irras asii fi achi haa raafamu.</para>
  <para style="q1" vid="PSA 72:16">Iji isaa akka Libaanoon haa tolu;</para>
  <para style="q2" vid="PSA 72:16">akka marga lafaas haa misu.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Maqaan isaa bara baraan haa jiraatu;</para>
  <para style="q2" vid="PSA 72:17">Akkuma aduus itti fufee haa jiraatu.</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">Saboonni hundinuu isaan ni eebbifamu;</para>
  <para style="q2" vid="PSA 72:17">jarris eebbifamaa jedhaanii isa waamu.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Inni kophaa isaa waan dinqii hojjetu,</para>
  <para style="q2" vid="PSA 72:18">
    <char style="nd">Waaqayyo</char> Waaqni, Waaqni Israaʼel haa eebbifamu.<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Maqaa isaa ulfaataa sanaaf bara baraan galanni haa taʼu;</para>
  <para style="q2" vid="PSA 72:19">lafti hundinuu ulfina isaatiin haa guutamu.</para>
  <para style="qc" vid="PSA 72:19">Ameen; Ameen.<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Kadhannaan Daawit ilma Isseey as irratti xumurame.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">Kitaaba Sadaffaa</para>
  <para style="mr">
    <ref loc="PSA 73-89">Faarfannaa 73–89</ref></para>
  <para style="cl">Faarfannaa 73</para>
  <para style="ms1">Moʼannoo Murtii Qajeelaa</para>
  <para style="d">Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>Dhugumaan Waaqni Israaʼeliif,</para>
  <para style="q2" vid="PSA 73:1">warra garaan isaanii qulqulluu taʼeef gaarii dha.<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Ani garuu miilli koo gufachuu gaʼee,</para>
  <para style="q2" vid="PSA 73:2">faanni koos mucucaachuu gaʼee ture.<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>Ani yommuun badhaadhummaa hamootaa argetti,</para>
  <para style="q2" vid="PSA 73:3">of tuultotatti hinaafeen tureetii.<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Isaan hin dhiphatan;</para>
  <para style="q2" vid="PSA 73:4">dhagni isaaniis fayyaa dha; cimaa dhas.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Rakkinni nama biraatti dhufu isaanitti hin dhufu;</para>
  <para style="q2" vid="PSA 73:5">isaan akka namoota kaanii dhukkubaan hin dhaʼaman.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Kanaafuu of tuulummaan faaya morma isaanii ti;</para>
  <para style="q2" vid="PSA 73:6">fincilas akka wayyaatti uffatu.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Iji isaanii coomee alatti dhiibama;</para>
  <para style="q2" vid="PSA 73:7">hamminni isaan garaatti yaadan dhuma hin qabu.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Isaan ni qoosu; hamminas ni dubbatu;</para>
  <para style="q2" vid="PSA 73:8">of tuulaa cunqursaadhaan nama doorsisu.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Afaan isaanii samii falmata;</para>
  <para style="q2" vid="PSA 73:9">arrabni isaaniis lafa dhaala.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Kanaafuu sabni gara isaaniitti dachaʼee</para>
  <para style="q2" vid="PSA 73:10">bishaan baayʼee dhuga.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Isaanis, “Waaqni akkamitti beekuu dandaʼaa?</para>
  <para style="q2" vid="PSA 73:11">Waaqni Waan Hundaa Olii beekumsa qabaa?” jedhu.<verse eid="PSA 73:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Egaa namoonni hamoon akkana;</para>
  <para style="q2" vid="PSA 73:12">isaan yeroo hunda yaaddoo malee jiraatu;</para>
  <para style="q2" vid="PSA 73:12">badhaadhummaanis guddachaa deemu.<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Yoos ani akkasumaan garaa koo qulqullinaan eeggadhee</para>
  <para style="q2" vid="PSA 73:13">harka koos akkasumaan dhiqadhe kaa!<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Ani guyyaa guutuu dhaʼameera;</para>
  <para style="q2" vid="PSA 73:14">ganama ganamas adabameera.<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Ani utuu, “Akkana nan dubbadha” jedhee jiraadhee</para>
  <para style="q2" vid="PSA 73:15">silaa ijoollee kee nan yakkan ture.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>Garuu yommuu ani waan kana hunda hubachuu yaaletti,</para>
  <para style="q2" vid="PSA 73:16">wanni kun hojii dadhabsiisaa natti taʼe.<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>Kunis hamma ani iddoo qulqullummaa Waaqaa seenutti ture;</para>
  <para style="q2" vid="PSA 73:17">ergasiis ani galgala isaanii nan hubadhe.<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Dhugumaan ati iddoo mucucaataa irra isaan dhaabde;</para>
  <para style="q2" vid="PSA 73:18">akka isaan kufanii caccabaniifis gad isaan darbatte.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Isaan akkamiin guutumaan guutuutti sodaadhaan fudhatamanii</para>
  <para style="q2" vid="PSA 73:19">akkuma tasaa barbadaaʼan!<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>Akkuma abjuun yeroo namni hirribaa dammaqutti taʼu sana,</para>
  <para style="q2" vid="PSA 73:20">atis yaa Gooftaa, akkasuma yommuu ol kaatu,</para>
  <para style="q2" vid="PSA 73:20">hawwii garaa isaanii ni busheessita.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Yommuu lubbuun koo gadditee</para>
  <para style="q2" vid="PSA 73:21">onneen koos waraanamtetti,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>ani gowwaa fi wallaalaan ture;</para>
  <para style="q2" vid="PSA 73:22">fuula kee durattis akka horii nan taʼe.<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Taʼus ani yeroo hunda si wajjinan jira;</para>
  <para style="q2" vid="PSA 73:23">atis harka koo mirgaa ni qabda.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Ati gorsa keetiin na qajeelchita;</para>
  <para style="q2" vid="PSA 73:24">ergasii immoo ulfinatti na galchita.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>Ani samii keessaa eenyunan qaba?</para>
  <para style="q2" vid="PSA 73:25">Lafa irraas si malee homaa hin fedhu.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>Foon koo fi onneen koo dadhabuu dandaʼu;</para>
  <para style="q2" vid="PSA 73:26">Waaqni garuu jabina garaa koo ti;</para>
  <para style="q2" vid="PSA 73:26">bara baraanis inni qooda koo.<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Warri sirraa fagoo jiran ni badu;</para>
  <para style="q2" vid="PSA 73:27">atis warra siif hin amanamne hunda ni balleessita.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>Akka ani yaadutti garuu Waaqatti dhiʼaachuun gaarii dha;</para>
  <para style="q2" vid="PSA 73:28">
    <char style="nd">Waaqayyo</char> Gooftaa daʼoo koo godhadheera;</para>
  <para style="q2" vid="PSA 73:28">ani hojii kee hunda nan labsa.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">Faarfannaa 74</para>
  <para style="ms1">Booʼicha Waaʼee Diigamuu Mana Qulqullummaa</para>
  <para style="d">
    <char style="tl">Maskiilii</char> Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>Yaa Waaqi, ati maaliif bara baraan nu gatte?</para>
  <para style="q2" vid="PSA 74:1">Aariin kee maaliif hoolota ati bobbaafte irratti akka malee bobaʼa?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Saba ati dur filatte,</para>
  <para style="q2" vid="PSA 74:2">gosa dhaala keetii, warra ati furte,</para>
  <para style="q2" vid="PSA 74:2">Tulluu Xiyoon iddoo ati jiraattes yaadadhu.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Tarkaanfii kee gara waan bara baraan diigameetti qajeelfadhu;</para>
  <para style="q2" vid="PSA 74:3">diinni waan mana qulqullummaa keessa jiru hunda barbadeesseera.<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Diinonni kee iddoo qulqulluu kee keessatti bookkisan;</para>
  <para style="q2" vid="PSA 74:4">mallattoo isaaniis mallattoo godhanii dhaabbatan.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Isaan nama bosona keessatti muka muruuf</para>
  <para style="q2" vid="PSA 74:5">qottoo ol fudhatu fakkaatu.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Isaanis waan soofame hunda,</para>
  <para style="q2" vid="PSA 74:6">qottoo fi burrusaan caccabsan.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Isaan mana qulqullummaa kee guban;</para>
  <para style="q2" vid="PSA 74:7">lafa jireenya Maqaa keetiis ni xureessan.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>Garaa isaanii keessatti, “Nu guutumaan guutuutti <optbreak/> isaan barbadeessina!” jedhan.</para>
  <para style="q2" vid="PSA 74:8">Iddoo Waaqni biyyattii keessatti itti waaqeffamaa ture hundumas ni guban.<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>Mallattoon dinqii nuu hin kennamne;</para>
  <para style="q2" vid="PSA 74:9">siʼachi raajiin tokko illee hin jiru;</para>
  <para style="q2" vid="PSA 74:9">wanni kun hamma yoomiitti akka turu <optbreak/> nu keessaa namni beeku hin jiru.<verse eid="PSA 74:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>Yaa Waaqi, hamma yoomiitti diinni sitti qoosa?</para>
  <para style="q2" vid="PSA 74:10">Amajaajiinis bara baraan maqaa kee xureessaa?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Ati maaliif harka kee, harka kee mirgaa dachaafatta?</para>
  <para style="q2" vid="PSA 74:11">Harka kee bobaa jalaa baafadhuutii isaan barbadeessi!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>Yaa Waaqi, ati durumaa jalqabdee mootii koo ti;</para>
  <para style="q2" vid="PSA 74:12">lafa irrattis hojii fayyinaa hojjetta.<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>Situ humna keetiin galaana gargar qoode;</para>
  <para style="q2" vid="PSA 74:13">ati bishaan keessattis mataa bineensa jawwee fakkaatuu caccabsite.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>Situ mataa Lewaataan caccabsee nyaata godhee</para>
  <para style="q2" vid="PSA 74:14">uumamawwan gammoojjii jiraataniif kenne.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>Situ burqaawwanii fi bishaan yaaʼuuf karaa bane;</para>
  <para style="q2" vid="PSA 74:15">ati laga yeroo hunda yaaʼu illee gogsiteerta.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Guyyaan kan kee ti; halkanis keetuma;</para>
  <para style="q2" vid="PSA 74:16">ati aduu fi jiʼa uumteerta.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>Situ daarii lafaa hunda dhaabe;</para>
  <para style="q2" vid="PSA 74:17">ati bonaa fi ganna uumteerta.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>Yaa <char style="nd">Waaqayyo</char>, akkamitti akka diinni sitti qoosu,</para>
  <para style="q2" vid="PSA 74:18">akkamitti akka namoonni gowwoonnis maqaa kee xureessan yaadadhu.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Lubbuu gugee keetii dabarsitee bineensa bosonaatti hin kennin;</para>
  <para style="q2" vid="PSA 74:19">jireenya saba kee hiyyoomee bara baraan hin irraanfatin.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Kakuu kee eegi;</para>
  <para style="q2" vid="PSA 74:20">iddoon lafaa dukkanaaʼaan hundinuu <optbreak/> gooliidhaan guutameeraatii.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Warri cunqurfaman qaanaʼanii duubatti hin deebiʼin;</para>
  <para style="q2" vid="PSA 74:21">hiyyeeyyii fi rakkattoonni maqaa kee haa galateeffatan.<verse eid="PSA 74:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>Yaa Waaqi kaʼi; dubbii kees falmadhu;</para>
  <para style="q2" vid="PSA 74:22">akka gowwoonni guyyaa guutuu sitti qoosan yaadadhu.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Dhaadachuu diinota keetii, bookkisuu diina keetii</para>
  <para style="q2" vid="PSA 74:23">kan gargar hin cinne sana hin dagatin.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">Faarfannaa 75</para>
  <para style="ms1">Abbaa Murtii Addunyaa Hundaa</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Yeedaloo, “Hin balleessin” jedhuun faarfatame. Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>Yaa Waaqi, nu si galateeffanna;</para>
  <para style="q2" vid="PSA 75:1">sababii Maqaan kee dhiʼoo taʼeef galata siif galchina;</para>
  <para style="q2" vid="PSA 75:1">namoonni waaʼee dinqii hojii keetii odeessu.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>Ati akkana jetta; “Ani yeroo murteeffame nan filadha;</para>
  <para style="q2" vid="PSA 75:2">kan qajeelummaadhaan muru ana.<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>Yommuu laftii fi sabni ishee hundi raafamanitti,</para>
  <para style="q2" vid="PSA 75:3">kan utubaa ishee jabeessee qabu ana.<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>Ani of tuultotaan akkana nan jedha; ‘Of hin jajinaa.’</para>
  <para style="q2" vid="PSA 75:4">Hamootaanis, ‘Gaanfa keessan ol hin qabatinaa.<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>Gaanfa keessan samiitti hin kaasinaa;</para>
  <para style="q2" vid="PSA 75:5">morma keessan dheereffattanii hin dubbatinaa.’ ”<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>Ulfinni baʼa biiftuutii yookaan lixa biiftuutii</para>
  <para style="q2" vid="PSA 75:6">yookaan lafa onaatii hin dhufuutii.<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>Garuu kan murtii kennu Waaqa;</para>
  <para style="q2" vid="PSA 75:7">inni nama tokko gad buusa; kaan immoo ol baasa.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Harka <char style="nd">Waaqayyoo</char> keessa,</para>
  <para style="q2" vid="PSA 75:8">xoofoo wayinii urgooftuudhaan walitti makame</para>
  <para style="q2" vid="PSA 75:8">kan hoomachaan guutame tokkotu jira;</para>
  <para style="q1" vid="PSA 75:8">inni wayinii sana gad naqa;</para>
  <para style="q2" vid="PSA 75:8">hamoonni lafaa hundinuu utuu siicoo isaa illee hin hambisin <optbreak/> xuruurfatanii dhugu.<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>Ani garuu bara baraan waan kana nan labsa;</para>
  <para style="q2" vid="PSA 75:9">Waaqa Yaaqoobis nan faarfadha.<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>Gaanfa hamoota hundaa nan caccabsa;</para>
  <para style="q2" vid="PSA 75:10">gaanfi qajeeltotaa garuu ol ol jedha.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">Faarfannaa 76</para>
  <para style="ms1">Faarfannaa Waaqa Sodaatamuu Qabuuf Faarfatame</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Miʼa Ribuutiin. Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>Yihuudaa keessatti Waaqni beekamaa dha;</para>
  <para style="q2" vid="PSA 76:1">maqaan isaas Israaʼel keessatti guddaa dha.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Dunkaanni isaa Saalem keessa,</para>
  <para style="q2" vid="PSA 76:2">iddoon jireenya isaa Xiyoon keessa jira.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>Innis achitti xiyya bobaʼuu fi gaachana, goraadee fi</para>
  <para style="q2" vid="PSA 76:3">meeshaawwan waraanaa caccabse.<verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Ati ifa uffattee miidhagdeerta;</para>
  <para style="q2" vid="PSA 76:4">ati tulluuwwan bara baraa caalaa Surra qabeessa.<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Gootonni boojiʼamaniiru;</para>
  <para style="q2" vid="PSA 76:5">hirribaanis fudhatamaniiru;</para>
  <para style="q1" vid="PSA 76:5">duultota keessaas namni tokko iyyuu</para>
  <para style="q2" vid="PSA 76:5">harka sochoofachuu hin dandeenye.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>Yaa Waaqa Yaaqoob, ifannaa keetiin fardeenii</para>
  <para style="q2" vid="PSA 76:6">fi warri fardeen yaabbatan of wallaalaniiru.<verse eid="PSA 76:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>Siʼi qofatu sodaatamuu qaba.</para>
  <para style="q2" vid="PSA 76:7">Yommuu ati aartu eenyutu fuula kee dura dhaabachuu dandaʼaa?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Ati samii irraa murtii kennite;</para>
  <para style="q2" vid="PSA 76:8">laftis ni sodaatte; ni calʼiftes;<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>yaa Waaqi, wanni kunis yommuu ati murtii kennuudhaaf,</para>
  <para style="q2" vid="PSA 76:9">rakkattoota biyyattii fayyisuuf kaatetti taʼe.<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>Dheekkamsi ati namatti dheekkamtu dhugumaan ulfina siif fida;</para>
  <para style="q2" vid="PSA 76:10">warra dheekkamsa kee irraa hafanis ni hidhatta.<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>
    <char style="nd">Waaqayyo</char> Waaqa keessaniif wareegaa; wareegichas guuttadhaa;</para>
  <para style="q2" vid="PSA 76:11">warri naannoo isaa jiraatan hundinuus</para>
  <para style="q2" vid="PSA 76:11">Waaqa sodaatamuu qabu sanaaf kennaawwan haa fidan.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>Inni hafuura bulchitootaa ni cabsa;</para>
  <para style="q2" vid="PSA 76:12">mootonni lafaas isa sodaatu.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">Faarfannaa 77</para>
  <para style="ms1">Seenaa Israaʼel Yaaduu</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Yeduutuuniif. Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>Ani gargaarsaaf gara Waaqaatti nan iyyadhe;</para>
  <para style="q2" vid="PSA 77:1">ani akka Waaqni na dhagaʼuuf nan iyyadhe.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Yeroo rakkina kootiitti Gooftaa nan barbaaddadhe;</para>
  <para style="q2" vid="PSA 77:2">halkanis utuu hin dadhabin harka koo nan diriirfadhe;</para>
  <para style="q2" vid="PSA 77:2">lubbuun koos jajjabaachuu didde.<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>Yaa Waaqi, ani yommuun si yaadadhu nan aada;</para>
  <para style="q2" vid="PSA 77:3">ani irra deddeebiʼee nan yaade; hafuurri koos ni laafe.<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Ati akka iji koo hin dunuunfanne goote;</para>
  <para style="q2" vid="PSA 77:4">ani akka malee lubbamee dubbachuu iyyuu dadhabe.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Ani waaʼee bara durii,</para>
  <para style="q2" vid="PSA 77:5">waaʼee waggoota durii duriis nan yaade;<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>ani halkaniin faarfannaa koo nan yaadadhe.</para>
  <para style="q2" vid="PSA 77:6">Ani irra deddeebiʼee na yaade; <optbreak/> hafuurri koos akkana jedhee qorate:<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“Gooftaan bara baraan nama gataa?</para>
  <para style="q2" vid="PSA 77:7">Inni deebiʼee garaa hin laafuu?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>Araarri isaa bara baraan badee?</para>
  <para style="q2" vid="PSA 77:8">Waadaan isaa bara baraan guutamuu dhabee?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Waaqni arjoomuu irraanfateeraa?</para>
  <para style="q2" vid="PSA 77:9">Inni aariidhaan gara laafina isaa dhiiseeraa?”<verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Anis, “Harki mirgaa kan Waaqa Waan Hundaa Olii</para>
  <para style="q2" vid="PSA 77:10">jijjiirameera jedhee yaaduun koo, dadhabbii koo ti” nan jedhe.<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Ani hojii <char style="nd">Waaqayyoo</char> nan yaadadha;</para>
  <para style="q2" vid="PSA 77:11">dhugumaan dinqii kee kan durii nan yaadadhaa.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Ani waan ati hojjette hunda irra deddeebiʼee nan yaada;</para>
  <para style="q2" vid="PSA 77:12">waaʼee hojii keetii illee nan dubbadha.<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>Yaa Waaqi, karaan kee qulqulluu dha.</para>
  <para style="q2" vid="PSA 77:13">Waaqni guddaan akka Waaqa keenyaa eessa jira?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>Ati Waaqa hojii dinqii hojjettuu dha;</para>
  <para style="q2" vid="PSA 77:14">saboota gidduuttis humna kee ni argisiifta.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Irree kee cimaadhaan saba kee,</para>
  <para style="q2" vid="PSA 77:15">sanyii Yaaqoobii fi sanyii Yoosef furteerta.<verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>Yaa Waaqi, bishaanonni si argan;</para>
  <para style="q2" vid="PSA 77:16">bishaanonni si arganii sodaatan;</para>
  <para style="q2" vid="PSA 77:16">tuujubawwan ni hollatan.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>Duumessi bishaan gad dhangalaase;</para>
  <para style="q2" vid="PSA 77:17">samiiwwan ni qaqawweessaʼan;</para>
  <para style="q2" vid="PSA 77:17">xiyyi kees qixa hundaan balaqqise.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>Bakakkaan kee bubbee hamaa keessaa dhagaʼame;</para>
  <para style="q2" vid="PSA 77:18">balaqqeesi kee addunyaa ibse;</para>
  <para style="q2" vid="PSA 77:18">laftis hollattee sochoote.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>Daandiin kee galaana keessa,</para>
  <para style="q2" vid="PSA 77:19">karaan kee immoo bishaanota gurguddaa keessa baʼa;</para>
  <para style="q2" vid="PSA 77:19">garuu faanni kee hin argamne.<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Ati harka Museetii fi harka Arooniin,</para>
  <para style="q2" vid="PSA 77:20">saba kee akka bushaayeetti geggeessite.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">Faarfannaa 78</para>
  <para style="ms1">Seenaa Saba Israaʼel</para>
  <para style="d">
    <char style="tl">Maskiilii</char> Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>Yaa saba ko, barsiisa koo dhagaʼaa;</para>
  <para style="q2" vid="PSA 78:1">dubbii afaan koo dhaggeeffadhaa.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>Ani fakkeenyaan afaan koo nan banadha;</para>
  <para style="q2" vid="PSA 78:2">waan durumaa jalqabee dhokfames nan dubbadha.<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>Kunis waanuma nu dhageenyee fi waanuma nu beeknu,</para>
  <para style="q2" vid="PSA 78:3">waan abbootiin keenya nutti himanii dha.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Nus waan kana ijoollee isaanii duraa hin dhoksinu;</para>
  <para style="q2" vid="PSA 78:4">hojii <char style="nd">Waaqayyoo</char> ulfina qabeessa sana,</para>
  <para style="q1" vid="PSA 78:4">humna isaatii fi dinqii inni hojjete,</para>
  <para style="q2" vid="PSA 78:4">dhaloota itti aanutti ni himna.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>Inni Yaaqoobiif sirna dhaabe;</para>
  <para style="q2" vid="PSA 78:5">Israaʼeliif immoo seera kenne;</para>
  <para style="q1" vid="PSA 78:5">waan kana illee akka isaan <optbreak/> ijoollee isaanii barsiisaniif,</para>
  <para style="q2" vid="PSA 78:5">abbootii keenya ajaje;<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>kunis akka dhaloonni itti aanu beeku,</para>
  <para style="q2" vid="PSA 78:6">akka ijoolleen amma iyyuu hin dhalatin beekan,</para>
  <para style="q2" vid="PSA 78:6">isaanis akka ijoollee isaaniitti dabarsanii himaniif.<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>Yoos isaan Waaqa amanatu;</para>
  <para style="q2" vid="PSA 78:7">ajaja isaas ni eegu malee hojii isaa hin irraanfatan.<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>Isaan akka abbootii isaanii,</para>
  <para style="q2" vid="PSA 78:8">akka dhaloota mata jabeessaa fi fincilaa,</para>
  <para style="q1" vid="PSA 78:8">warra garaan isaanii Waaqaaf hin ajajamnee,</para>
  <para style="q2" vid="PSA 78:8">akka warra hafuurri isaanii isaaf hin amanamin sanaa hin taʼan.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Namoonni Efreem xiyya qabatanii turan;</para>
  <para style="q2" vid="PSA 78:9">taʼus gaafa lolaa duubatti deebiʼan.<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Isaan kakuu Waaqaa hin eegne;</para>
  <para style="q2" vid="PSA 78:10">seera isaattis buluu didan.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Isaan hojii inni hojjete,</para>
  <para style="q2" vid="PSA 78:11">dinqii inni isaanitti argisiises ni irraanfatan.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>Inni fuula abbootii isaanii duratti,</para>
  <para style="q2" vid="PSA 78:12">biyya Gibxi kutaa Zooʼaanitti waan nama dinqisiisu hojjete.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>Inni galaana gargar qoodee gidduun isaan dabarse;</para>
  <para style="q2" vid="PSA 78:13">bishaan sanas akkuma keenyan manaa dhaabachiise.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>Guyyaa duumessaan, halkan guutuu immoo</para>
  <para style="q2" vid="PSA 78:14">ifa ibiddaatiin isaan geggeesse.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>Inni gammoojjii keessatti kattaa dayyaasee</para>
  <para style="q2" vid="PSA 78:15">bishaan akka galaanaa baayʼatu isaanii kenne.<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>Kattaa keessaa burqaa burqisiisee</para>
  <para style="q2" vid="PSA 78:16">akka bishaan akkuma lagaatti yaaʼu godhe.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>Isaan garuu gammoojjii keessatti Waaqa Waan Hundaa Oliitti fincilan;</para>
  <para style="q2" vid="PSA 78:17">ittuma fufaniis isatti cubbuu hojjetan.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>Isaan nyaata dharraʼanii, “Fidi” jechuudhaan</para>
  <para style="q2" vid="PSA 78:18">beekumsa Waaqaa qoran.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Akkana jedhanii Waaqa hamatan;</para>
  <para style="q2" vid="PSA 78:19">“Waaqni gammoojjii keessatti maaddii qopheessuu dandaʼaa?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Inni kattaa rukunnaan bishaan humnaan keessaa burqe;</para>
  <para style="q2" vid="PSA 78:20">burqaan guutee irraan dhangalaʼe.</para>
  <para style="q1" vid="PSA 78:20">Garuu inni nyaata nuu kennuu dandaʼaa?</para>
  <para style="q2" vid="PSA 78:20">Saba isaatiifis foon kennuu dandaʼaa?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>
    <char style="nd">Waaqayyo</char> yommuu waan kana dhagaʼetti baayʼee aare;</para>
  <para style="q2" vid="PSA 78:21">Yaaqoob irratti ibiddi isaa ni qabsiifame;</para>
  <para style="q2" vid="PSA 78:21">dheekkamsi isaas Israaʼelitti dhufe;<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>isaan Waaqa hin amananneetii;</para>
  <para style="q2" vid="PSA 78:22">fayyisuu isaattis hin amanne.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>Inni garuu samii gubbaatiif ajaja kenne;</para>
  <para style="q2" vid="PSA 78:23">balbala samiis ni bane;<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>akka isaan nyaataniif mannaa gad roobseef;</para>
  <para style="q2" vid="PSA 78:24">midhaan samiis isaaniif kenne.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Namoonni buddeena ergamoota Waaqayyoo nyaatan;</para>
  <para style="q2" vid="PSA 78:25">inni waan isaan nyaatanii quufan ergeef.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Inni akka bubbeen baʼa biiftuu samii keessaa bubbisu godhe;</para>
  <para style="q2" vid="PSA 78:26">bubbee kibbaas humna ofii isaatiin oofe.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>Foon akkuma awwaaraatti, simbirroota barrisanis</para>
  <para style="q2" vid="PSA 78:27">akkuma cirracha galaanaatti gad isaaniif roobse.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Innis akka isaan qubata isaanii keessatti</para>
  <para style="q2" vid="PSA 78:28">naannoo dunkaanota isaaniitti gad harcaʼan godhe.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Isaanis nyaatanii quufan;</para>
  <para style="q2" vid="PSA 78:29">inni waan isaan dharraʼan isaaniif kenneeraatii.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>Garuu utuu isaan nyaata dharraʼan sana hin quufin,</para>
  <para style="q2" vid="PSA 78:30">utuma nyaanni sun afaan isaanii keessa jiruu,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>dheekkamsi Waaqaa isaanitti dhufe;</para>
  <para style="q2" vid="PSA 78:31">innis isaan keessaa warra jajjabeeyyii galaafate;</para>
  <para style="q2" vid="PSA 78:31">dargaggeeyyii Israaʼelis ni fixe.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>Isaan waan kana hunda irra darbanii cubbuu hojjechuutti fufan;</para>
  <para style="q2" vid="PSA 78:32">dinqii isaattis hin amanne.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Kanaafuu inni akka barri isaanii faayidaa malee darbu,</para>
  <para style="q2" vid="PSA 78:33">akka waggoonni isaaniis sodaadhaan dhuman godhe.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>Yeroo Waaqni isaan ajjeese kamitti iyyuu, <optbreak/> isaan isa barbaaddatan;</para>
  <para style="q2" vid="PSA 78:34">isaan ammas fedhiidhaan gara isaatti deebiʼan.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Akka Waaqni Kattaa isaanii taʼe,</para>
  <para style="q2" vid="PSA 78:35">akka Waaqni Waan Hundaa Olii Furii isaanii taʼe yaadatan.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>Isaan garuu afaan isaaniitiin isa saadan;</para>
  <para style="q2" vid="PSA 78:36">arraba isaaniitiinis isa soban;<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>garaan isaanii isaaf amanamaa hin turre;</para>
  <para style="q2" vid="PSA 78:37">isaan kakuu isaatiif hin amanamne.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>Inni garuu araara qabeessa waan taʼeef,</para>
  <para style="q2" vid="PSA 78:38">cubbuu isaanii ni dhiiseef malee isaan hin fixne.</para>
  <para style="q1" vid="PSA 78:38">Inni yeroo yerootti aarii isaa ittifate;</para>
  <para style="q2" vid="PSA 78:38">dheekkamsa isaa hundaas hin kakaafne.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Innis akka isaan nama duʼa hin oolle,</para>
  <para style="q2" vid="PSA 78:39">qilleensuma darbu kan deebiʼee hin dhufne taʼan yaadate.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Isaan hammam gammoojjii keessatti isatti fincilanii</para>
  <para style="q2" vid="PSA 78:40">gammoojjii keessattis isa gaddisiisan<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Isaan ammumaa amma Waaqa qoran;</para>
  <para style="q2" vid="PSA 78:41">Qulqullicha Israaʼel sanas ni aarsan.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Isaan humna isaa yookaan guyyaa inni itti</para>
  <para style="q2" vid="PSA 78:42">diinota isaanii jalaa isaan baase hin yaadanne.<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>Guyyaa inni itti biyya Gibxi keessatti mallattoo isaa,</para>
  <para style="q2" vid="PSA 78:43">kutaa Zooʼaan keessatti immoo dinqii isaa argisiise isaan hin yaadanne.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>Inni lageen isaanii dhiigatti geeddare;</para>
  <para style="q2" vid="PSA 78:44">isaanis burqaawwan isaanii dhuguu hin dandeenye.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>Innis tuuta tisiisaa kan isaan balleessu,</para>
  <para style="q2" vid="PSA 78:45">fattee isaan barbadeessu itti erge.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>Midhaan isaanii ilmaan hawwaannisaatiif,</para>
  <para style="q2" vid="PSA 78:46">buʼaa dadhabbii isaanii immoo hawwaannisaaf kenne.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>Muka wayinii isaanii cabbiidhaan,</para>
  <para style="q2" vid="PSA 78:47">harbuu isaanii immoo dhaamocha hamaan dhaʼe.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>Loon isaanii cabbiif,</para>
  <para style="q2" vid="PSA 78:48">horii isaanii immoo bakakkaaf dabarsee kenne.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Inni ergamoota badiisa fidan isaanitti erguudhaan</para>
  <para style="q2" vid="PSA 78:49">aarii isaa sodaachisaa, dheekkamsa isaa,</para>
  <para style="q2" vid="PSA 78:49">dallansuu isaatii fi rakkoo isaanitti gad lakkise.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Inni aarii isaatiif daandii qopheesse;</para>
  <para style="q2" vid="PSA 78:50">lubbuu isaanii dabarsee dhaʼichatti kenne malee</para>
  <para style="q2" vid="PSA 78:50">duʼa isaan hin oolchine.<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>Hangafoota Gibxi hunda,</para>
  <para style="q2" vid="PSA 78:51">ilmaan jalqabatti dhalatanis dunkaana Haam keessatti dhaʼe.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>Saba isaa garuu akkuma nama bushaayee bobbaasuutti achii baase;</para>
  <para style="q2" vid="PSA 78:52">akkuma hoolaas gammoojjii keessa isaan geggeesse.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>Inni nagaadhaan isaan geggeesse; <optbreak/> kanaafuu isaan homaa hin sodaanne;</para>
  <para style="q2" vid="PSA 78:53">diinota isaanii garuu galaanatu liqimse.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>Innis gara daarii biyya isaa qulqulluutti,</para>
  <para style="q2" vid="PSA 78:54">gara biyya gaaraa kan harki isaa mirgaa fudhateetti isaan galche.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>Inni ormoota isaan duraa ariʼe;</para>
  <para style="q2" vid="PSA 78:55">lafa jaraas dhaala godhee isaanii qoode;</para>
  <para style="q2" vid="PSA 78:55">gosa Israaʼelis dunkaana isaanii keessa qubachiise.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>Isaan garuu Waaqa qoran;</para>
  <para style="q2" vid="PSA 78:56">Waaqa Waan Hundaa Oliitti fincilan;</para>
  <para style="q2" vid="PSA 78:56">ajaja isaas hin eegne.<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>Akkuma abbootii isaanii duubatti deebiʼan; amanamuus ni didan;</para>
  <para style="q2" vid="PSA 78:57">akka iddaa micciiramaattis jajalʼatan.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Isaan iddoowwan sagadaa isaanii kanneen gaarran irraatiin isa aarsan;</para>
  <para style="q2" vid="PSA 78:58">waaqota isaanii tolfamoodhaanis hinaaffaadhaaf isa kakaasan.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Waaqnis yeroo isaan dhagaʼetti akka malee dheekkame;</para>
  <para style="q2" vid="PSA 78:59">guutumaan guutuuttis Israaʼelin gate.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Innis iddoo jireenya isaa kan Shiiloo keessaa,</para>
  <para style="q2" vid="PSA 78:60">dunkaana inni namoota gidduu dhaabbate sanas ni dhiise.<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>Humna isaa boojuutti,</para>
  <para style="q2" vid="PSA 78:61">ulfina isaa immoo harka diinaatti dabarsee kenne.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>Saba isaa dabarsee goraadeef kenne;</para>
  <para style="q2" vid="PSA 78:62">handhuuraa isaattis akka malee dheekkame.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Dargaggoota isaanii ibiddatu fixe;</para>
  <para style="q2" vid="PSA 78:63">durboota isaaniitiifis sirbi heerumaa hin sirbamne;<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>luboonni isaanii goraadeedhaan dhuman;</para>
  <para style="q2" vid="PSA 78:64">niitonni dhirsoonni irraa duʼan immoo booʼuu hin dandeenye.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Gooftaanis akkuma waan hirribaa dammaquutti,</para>
  <para style="q2" vid="PSA 78:65">akkuma goota sababii wayiniitiin iyyuuttis dammaqe.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>Inni diinota isaa rukutee duubatti deebise;</para>
  <para style="q2" vid="PSA 78:66">qaanii bara baraa keessas isaan buuse.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Dunkaanota Yoosef ni tuffate;</para>
  <para style="q2" vid="PSA 78:67">gosa Efreemis hin filanne;<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>inni garuu gosa Yihuudaa,</para>
  <para style="q2" vid="PSA 78:68">Tulluu Xiyoon kan jaallatu sana ni filate.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Mana qulqullummaa isaa akka samii ol dheeraatti,</para>
  <para style="q2" vid="PSA 78:69">akka lafa bara baraan hundeesseettis ijaare.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Inni Daawit garbicha isaa ni filate;</para>
  <para style="q2" vid="PSA 78:70">dallaa hoolotaa keessaas isa waammate;<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>akka inni saba isaa Yaaqoobin,</para>
  <para style="q2" vid="PSA 78:71">handhuuraa isaa Israaʼelin tiksuuf jedhee</para>
  <para style="q2" vid="PSA 78:71">hoolota tiksuu irraa isa fide.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>Daawitis garaa qajeelaadhaan isaan tikse;</para>
  <para style="q2" vid="PSA 78:72">ogummaa harka isaatiinis isaan dura buʼe.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">Faarfannaa 79</para>
  <para style="ms1">Faaruu Booʼichaa Biyyoolessaa</para>
  <para style="d">Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>Yaa Waaqi, namoonni ormaa handhuuraa kee qabataniiru;</para>
  <para style="q2" vid="PSA 79:1">mana qulqullummaa kee qulqullicha xureessaniiru;</para>
  <para style="q2" vid="PSA 79:1">Yerusaaleminis barbadeessaniiru.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Akka isaan nyaata isaaniif taʼaniif,</para>
  <para style="q2" vid="PSA 79:2">reeffa garboota keetii allaattii samiitiif,</para>
  <para style="q2" vid="PSA 79:2">foon qulqulloota keetii immoo bineensota lafaatiif kennaniiru.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Dhiiga isaaniis naannoo Yerusaalemitti</para>
  <para style="q2" vid="PSA 79:3">akkuma bishaanii dhangalaasan;</para>
  <para style="q2" vid="PSA 79:3">namni isaan awwaalu tokko illee hin argamne.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Ollaa keenya biratti maqaan nu badeera;</para>
  <para style="q2" vid="PSA 79:4">warra naannoo keenya jiran birattis nama tuffii fi kolfaa taane.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>Yaa <char style="nd">Waaqayyo</char>, kun hamma yoomiitti?</para>
  <para style="q2" vid="PSA 79:5">Ati hamma bara baraatti aartaa?</para>
  <para style="q2" vid="PSA 79:5">Hinaaffaan kees hamma yoomiitti akka ibiddaa bobaʼa?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>Dheekkamsa kee sana saboota si hin beekne irratti,</para>
  <para style="q2" vid="PSA 79:6">mootummoota maqaa kee hin waammanne irratti <optbreak/> gad dhangalaasi;<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>isaan Yaaqoobin liqimsaniiruutii;</para>
  <para style="q2" vid="PSA 79:7">iddoo jireenya isaas balleessaniiru.<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>Cubbuu abbootii keenyaa nutti hin herregin;</para>
  <para style="q2" vid="PSA 79:8">waan nu baayʼee gad deebifamneef,</para>
  <para style="q2" vid="PSA 79:8">araarri kee dafee nu bira haa gaʼu.<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>Yaa Waaqi Fayyisaa keenya,</para>
  <para style="q2" vid="PSA 79:9">ulfina maqaa keetiitiif jedhii nu gargaari;</para>
  <para style="q1" vid="PSA 79:9">maqaa keetiif jedhiitii nu oolchi;</para>
  <para style="q2" vid="PSA 79:9">cubbuu keenya illee nuu dhiisi.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>Ormoonni maaliif,</para>
  <para style="q2" vid="PSA 79:10">“Waaqni isaanii eessa jira?” jedhu ree?</para>
  <para style="b" vid="PSA 79:10"/>
  <para style="q1" vid="PSA 79:10">Dhiiga tajaajiltoota keetii kan dhangalaafame sanaaf,</para>
  <para style="q2" vid="PSA 79:10">akka haaloo baaftu ija keenya duratti saboota gidduutti beeksisi.<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Aaduun hidhamtootaa fuula kee dura haa gaʼu;</para>
  <para style="q2" vid="PSA 79:11">jabina irree keetiitiin warra duuti itti murame oolchi.<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>Yaa Gooftaa, arraba isaan ittiin si arrabsan,</para>
  <para style="q2" vid="PSA 79:12">dachaa torba godhiitii ollaa keenyatti deebisi.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>Yoos nu sabni kee, hoolonni tika keetii,</para>
  <para style="q2" vid="PSA 79:13">bara baraan si jajanna;</para>
  <para style="q1" vid="PSA 79:13">dhalootaa hamma dhalootaattis,</para>
  <para style="q2" vid="PSA 79:13">galata kee ni odeessina.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">Faarfannaa 80</para>
  <para style="ms1">Haaromfama Israaʼeliif Waaqa kadhachuu</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Yeedaloo, “Daraaraa Kakuutiin” Faarfatame. Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>Yaa tiksee saba Israaʼel,</para>
  <para style="q2" vid="PSA 80:1">kan akkuma bushaayeetti Yoosefin geggeessitu nu dhagaʼi;</para>
  <para style="q2" vid="PSA 80:1">ati kan kiirubeel gidduu teessoo irra teessu, ifiitii mulʼadhu.<verse eid="PSA 80:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>Fuula Efreem, Beniyaamii fi Minaasee duratti</para>
  <para style="q2" vid="PSA 80:2">humna kee sochoosi; kottuutii nu fayyisi.<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>Yaa Waaqi, iddoo keenyatti nu deebisi;</para>
  <para style="q2" vid="PSA 80:3">akka fayyinuufis fuula kee nurratti ibsi.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>Yaa <char style="nd">Waaqayyo</char>, Waaqa Waan Hunda Dandeessu,</para>
  <para style="q2" vid="PSA 80:4">ati hamma yoomiitti kadhannaa saba keetiitti aarta?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>Ati buddeena imimmaanii isaan nyaachifte;</para>
  <para style="q2" vid="PSA 80:5">imimmaan waciitii guutuus isaan obaafte.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Ati akka olloonni keenya nu tuffatan goote;</para>
  <para style="q2" vid="PSA 80:6">diinonni keenyas nutti qoosu.<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>Yaa Waaqa Waan Hunda Dandeessu, <optbreak/> iddoo keenyatti nu deebisi;</para>
  <para style="q2" vid="PSA 80:7">akka nu fayyinuufis fuula kee nurratti ibsi.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>Ati muka wayinii biyya Gibxii buqqiftee fidde;</para>
  <para style="q2" vid="PSA 80:8">ormootas ariitee muka sana dhaabde.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Mukichaafis lafa qopheessite;</para>
  <para style="q2" vid="PSA 80:9">mukni sunis hidda gad fageeffatee biyyattii guute.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Tulluuwwan gaaddisa isaatiin,</para>
  <para style="q2" vid="PSA 80:10">birbirsawwan gurguddaanis <optbreak/> dameewwan isaatiin haguugaman.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Innis dameewwan isaa gara Galaanaatti,</para>
  <para style="q2" vid="PSA 80:11">lata isaas hamma Lagaatti diriirfate.<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Yoos ati maaliif akka namni achiin darbu hundinuu</para>
  <para style="q2" vid="PSA 80:12">ija isaa ciratu gochuuf jettee dallaa isaa diigde ree?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Kormi booyyee bosona keessaa baʼee isa ni balleessa;</para>
  <para style="q2" vid="PSA 80:13">bineensi dirrees isa ni nyaata.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>Yaa Waaqa Waan Hunda Dandeessu, <optbreak/> si kadhannaa gara keenyatti deebiʼi!</para>
  <para style="q2" vid="PSA 80:14">Samii irraa gad ilaalii argi!</para>
  <para style="q1" vid="PSA 80:14">Muka wayinii kana eegi;<verse eid="PSA 80:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15"/>mukni kun muka wayinii kan harki kee mirgaa dhaabee dha;</para>
  <para style="q2" vid="PSA 80:15">biqiltuu ati ofii keetiif guddifattee dha.<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>Wayiniin kee ciramee ibiddaan gubameera;</para>
  <para style="q2" vid="PSA 80:16">sabni kees dheekkamsa keetiin bada.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Harki kee namicha karaa harka kee mirgaa jiru irra,</para>
  <para style="q2" vid="PSA 80:17">ilma namaa kan ati ofii keetiif guddifatte irra haa boqotu.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Yoos nu sirraa hin garagallu;</para>
  <para style="q2" vid="PSA 80:18">jireenya nuu kenni; nus maqaa kee ni waammannaa.<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>Yaa <char style="nd">Waaqayyo</char>, Waaqa Waan Hunda Dandeessu</para>
  <para style="q2" vid="PSA 80:19">iddoo keenyatti nu deebisi;</para>
  <para style="q2" vid="PSA 80:19">akka nu fayyinuufis fuula kee nurratti ibsi.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">Faarfannaa 81</para>
  <para style="ms1">Ayyaana Daasiitiif</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Asaaf Kan <char style="tl">Gitiitiidhaan</char> Faarfatamu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>Waaqa jabina nuu taʼeef gammachuudhaan faarfadhaa;</para>
  <para style="q2" vid="PSA 81:1">Waaqa Yaaqoobiitiif gammachuudhaan ililchaa!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Faarfachuu jalqabaa; dibbees rukutaa;</para>
  <para style="q2" vid="PSA 81:2">baganaa fi kiraara sagalee gaarii qabu rukutaa.<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Yeroo Baatiin dhalattu, yommuu jiʼi goobanutti,</para>
  <para style="q2" vid="PSA 81:3">guyyaa ayyaana keenyaa malakata afuufaa;<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>kun seera Israaʼeliif kenname,</para>
  <para style="q2" vid="PSA 81:4">ajaja Waaqa Yaaqoob.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>Inni yeroo biyya Gibxi dhaʼuuf baʼetti,</para>
  <para style="q2" vid="PSA 81:5">waan kana Yoosefiif seera godhee dhaabe.</para>
  <para style="b" vid="PSA 81:5"/>
  <para style="q1" vid="PSA 81:5">Anis afaan duraan hin beekin tokko dhagaʼe.<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>Innis akkana jedhe; <optbreak/> “Ani gatiittii isaanii irraa baʼaa buuseera;</para>
  <para style="q2" vid="PSA 81:6">harki isaanis guuboo baachuu jalaa baʼe.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>Ati dhiphina kee keessatti na waammatte; anis sin oolche;</para>
  <para style="q2" vid="PSA 81:7">anis lafa bakakkaan itti dhokatu keessaa deebii siifin kenne;</para>
  <para style="q2" vid="PSA 81:7">bishaan Mariibaa birattis sin qore.<verse eid="PSA 81:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>“Yaa saba koo dhagaʼi; ani siin akeekkachiisa;</para>
  <para style="q2" vid="PSA 81:8">yaa Israaʼel ati utuu na dhaggeeffate!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>Waaqni ormaa tokko iyyuu isin gidduu hin jiraatin;</para>
  <para style="q2" vid="PSA 81:9">ana malee waaqa biraa hin waaqeffatin.<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>Ani <char style="nd">Waaqayyo</char> Waaqa kee,</para>
  <para style="q2" vid="PSA 81:10">kan Gibxii baasee isin fidee dha.</para>
  <para style="q2" vid="PSA 81:10">Afaan kee balʼisii banadhu; ani nan guutaa.<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“Sabni koo garuu na hin dhaggeeffanne;</para>
  <para style="q2" vid="PSA 81:11">Israaʼel anaaf hin bulle.<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>Kanaafuu ani akka isaan karaa fedhii isaanii deemaniif</para>
  <para style="q2" vid="PSA 81:12">dabarsee mata jabina isaaniitti isaan kenne.<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>“Utuu sabni koo na dhaggeeffatee,</para>
  <para style="q2" vid="PSA 81:13">utuu Israaʼel karaa koo irra deemee jiraatee,<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>ani silaa akkam dafee diinota isaanii jilbeenfachiisee</para>
  <para style="q2" vid="PSA 81:14">harka koos amajaajota isaaniitti nan kaasa ture!<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>Warri <char style="nd">Waaqayyoon</char> jibban fuula isaa duratti ni gugguufu;</para>
  <para style="q2" vid="PSA 81:15">adabbiin isaaniis bara baraan itti fufa.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>Ani garuu qamadii qulqulluu isin soora;</para>
  <para style="q2" vid="PSA 81:16">damma kattaa keessaa baafames isinan quubsa.”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">Faarfannaa 82</para>
  <para style="ms1">Abbootii Murtii Kanneen Murtii Jalʼisan</para>
  <para style="d">Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>Waaqni, waldaa waaqotaa gidduu dhaabata;</para>
  <para style="q2" vid="PSA 82:1">“waaqota” gidduuttis murtii kenna; akkanas jedha:<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“Isin hamma yoomiitti seera jalʼiftu?</para>
  <para style="q2" vid="PSA 82:2">Hamma yoomiittis jalʼootaaf dhaabattu?<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>Dadhabdootaa fi ijoollee abbaa hin qabneef murtii qajeelaa kennaa;</para>
  <para style="q2" vid="PSA 82:3">mirga hiyyeeyyiitii fi cunqurfamtootaas eegsisaa.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>Warra dadhabaa fi rakkattoota baraaraa;</para>
  <para style="q2" vid="PSA 82:4">harka jalʼootaatiis isaan baasaa.<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>“Isaan homaa hin beekan; homaa illee hin hubatan.</para>
  <para style="q2" vid="PSA 82:5">Isaan dukkana keessa jiraatu;</para>
  <para style="q2" vid="PSA 82:5">hundeen lafaa hundinuu ni raafame.<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>“Anis, ‘Isin, “waaqota;”</para>
  <para style="q2" vid="PSA 82:6">hundi keessan ilmaan Waaqa Waan Hundaa Olii ti’ jedheera.<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>Taʼus isin akkuma namatti ni duutu;</para>
  <para style="q2" vid="PSA 82:7">akkuma bulchitoota kamii iyyuu ni kuftu.”<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>Yaa Waaqi kaʼi; lafatti muri;</para>
  <para style="q2" vid="PSA 82:8">sabni hundinuu kan keetiitii.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">Faarfannaa 83</para>
  <para style="ms1">Kadhannaa Diinota Israaʼel Irratti Dhiʼaate</para>
  <para style="d">Faarfannaa Asaaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>Yaa Waaqi gab hin jedhin;</para>
  <para style="q2" vid="PSA 83:1">yaa Waaqi, hin calʼisin;</para>
  <para style="q2" vid="PSA 83:1">akkasumattis hin dhiisin.<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>Diinonni kee akkam akka kakaʼan,</para>
  <para style="q2" vid="PSA 83:2">warri si jibbanis akkam akka mataa ol qabatan ilaali.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Isaan saba keetti daba karoorfatu;</para>
  <para style="q2" vid="PSA 83:3">warra ati eegdutti mariʼatu.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>Isaanis, “Kottaa akka maqaan Israaʼel lammata hin yaadatamneef,</para>
  <para style="q2" vid="PSA 83:4">akka isaan saba hin taaneef isaan barbadeessinaa” jedhu.<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Isaan yaada tokkoon walii galu;</para>
  <para style="q2" vid="PSA 83:5">sittis ni gurmaaʼu;<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>isaanis dunkaanota Edoom, Ishmaaʼeeloota,</para>
  <para style="q2" vid="PSA 83:6">Moʼaabii fi gosa Aggaar,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>Gebaal, Amoonii fi Amaaleq,</para>
  <para style="q2" vid="PSA 83:7">Filisxeemii fi namoota biyya Xiiroos wajjin turan.<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>Warri Asooriis, ilmaan Looxiitiif irree jabaa</para>
  <para style="q2" vid="PSA 83:8">taʼuudhaaf isaanitti makaman.<verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Ati akkuma Midiyaanin goote,</para>
  <para style="q2" vid="PSA 83:9">akkuma laga Qiishooniitti Siisaaraa fi Yaabiinin goote sana isaan godhi;<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>isaan Eendooritti dhumanii</para>
  <para style="q2" vid="PSA 83:10">akkuma kosii lafaa taʼan.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>Gurguddoota isaanii akka Hereebiitii fi Zeʼeeb,</para>
  <para style="q2" vid="PSA 83:11">ilmaan mootota isaanii immoo akka Zebaa fi Zalmunaa godhi;<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>isaan warra, “Kottaa, lafa tika Waaqaa fudhannee</para>
  <para style="q2" vid="PSA 83:12">kan dhuunfaa keenyaa godhannaa” jedhanii dha.<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>Yaa Waaqa ko, akka awwaara bubbeen fudhatuu,</para>
  <para style="q2" vid="PSA 83:13">akka habaqii qilleensi bittinneessuu isaan godhi.<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>Akkuma ibiddi bosona balleessu,</para>
  <para style="q2" vid="PSA 83:14">yookaan akkuma arrabni ibiddaa tulluuwwan gubu,<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>atis akkasuma aarii keetiin isaan gugsi;</para>
  <para style="q2" vid="PSA 83:15">bubbee keetiin isaan sodaachisi.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>Yaa <char style="nd">Waaqayyo</char>, akka isaan maqaa kee barbaaddataniif,</para>
  <para style="q2" vid="PSA 83:16">fuula isaanii qaaniin haguugi.<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Isaan yeroo hunda qaanaʼanii haa dhiphatan;</para>
  <para style="q2" vid="PSA 83:17">salphinaanis haa badan.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>Isaan akka ati kan maqaan kee <char style="nd">Waaqayyo</char> taʼe sun qofti,</para>
  <para style="q2" vid="PSA 83:18">lafa hundumaa irratti Waaqa Waan Hundaa Olii taate haa beekan.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">Faarfannaa 84</para>
  <para style="ms1">Faarfannaa Yeroo Mana Qulqullummaa Dhaqan Faarfatamu</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Kan <char style="tl">Gitiitiidhaan</char> Faarfatamu. Faarfannaa Ilmaan Qooraahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>Yaa <char style="nd">Waaqayyoo</char> Waan Hunda Dandeessu,</para>
  <para style="q2" vid="PSA 84:1">iddoon ati jiraattu akkam namatti tola!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>Lubbuun koo oobdiiwwan <char style="nd">Waaqayyoo</char> hawwiti;</para>
  <para style="q2" vid="PSA 84:2">akka malees itti gaggabdi;</para>
  <para style="q1" vid="PSA 84:2">onneen koo fi foon koo</para>
  <para style="q2" vid="PSA 84:2">Waaqa jiraataadhaaf ililleedhaan ni faarfatu.<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>Yaa <char style="nd">Waaqayyoo</char> Waan Hunda Dandeessu,</para>
  <para style="q2" vid="PSA 84:3">Mootii koo fi Waaqa ko,</para>
  <para style="q1" vid="PSA 84:3">iddoo aarsaa keetii biratti, dimbiitiin iddoo jireenyaa,</para>
  <para style="q2" vid="PSA 84:3">girrisnis ofii isheetiif manʼee cuucii ishee keessa kaaʼattu argatti.<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>Warri mana kee keessa jiraatan eebbifamoo dha;</para>
  <para style="q2" vid="PSA 84:4">isaan yeroo hundumaa si jajatuutii.<verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>Warri sirraa jabina argatan,</para>
  <para style="q2" vid="PSA 84:5">kanneen garaa isaaniitiin karaa kee yaadan eebbifamoo dha.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Isaan yommuu Sulula Baakaa keessa darbanitti,</para>
  <para style="q2" vid="PSA 84:6">iddoo sana lafa bishaan keessaa burqu godhatu;</para>
  <para style="q2" vid="PSA 84:6">bokkaan jalqabaas eebba itti dhangalaasa.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Isaan hamma Xiyoon keessatti fuula Waaqaa duratti mulʼatanitti,</para>
  <para style="q2" vid="PSA 84:7">jabina irraa gara jabinaatti ni darbu.<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>Yaa <char style="nd">Waaqayyo</char>, Waaqa Waan Hunda Dandeessu, <optbreak/> kadhannaa koo dhagaʼi;</para>
  <para style="q2" vid="PSA 84:8">yaa Waaqa Yaaqoob na dhaggeeffadhu.<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>Yaa Waaqayyo, gara gaachana keenyaa ilaali;</para>
  <para style="q2" vid="PSA 84:9">fuula dibamaa kee sanaas ilaali.<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Guyyaa kuma tokko iddoo biraa jiraachuu irra,</para>
  <para style="q2" vid="PSA 84:10">guyyaa tokko oobdii keetii irra ooluu wayya;</para>
  <para style="q1" vid="PSA 84:10">dunkaana hamootaa keessa jiraachuu irra,</para>
  <para style="q2" vid="PSA 84:10">eegduu balbala mana Waaqa koo taʼuu naa wayya.<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>
    <char style="nd">Waaqayyo</char> Waaqni aduu fi gaachanaatii;</para>
  <para style="q2" vid="PSA 84:11">
    <char style="nd">Waaqayyo</char> surraa fi ulfina ni kenna;</para>
  <para style="q2" vid="PSA 84:11">inni toloota waan gaarii hin dhowwatu.<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>Yaa <char style="nd">Waaqayyoo</char> Waan Hunda Dandeessu,</para>
  <para style="q2" vid="PSA 84:12">namni si amanatu eebbifamaa dha.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">Faarfannaa 85</para>
  <para style="ms1">Kadhannaa Nagaaf Dhiʼaate</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Ilmaan Qooraahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>Yaa <char style="nd">Waaqayyo</char>, ati lafa keetiif arjoomteerta;</para>
  <para style="q2" vid="PSA 85:1">boojuu Yaaqoobis deebifteerta.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>Ati balleessaa uummata keetii dhiifteertaaf;</para>
  <para style="q2" vid="PSA 85:2">cubbuu isaanii hundumaas dhoksiteerta.<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Dheekkamsa kee hunda fageessiteerta;</para>
  <para style="q2" vid="PSA 85:3">aarii kee sodaachisaa sana irraas deebiteerta.<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>Yaa Waaqa Fayyisaa keenya, iddoo keenyatti nu deebisi;</para>
  <para style="q2" vid="PSA 85:4">dheekkamsa kees nurraa qabi.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Ati bara baraan nutti aartaa? Dheekkamsa kee</para>
  <para style="q2" vid="PSA 85:5">dhaloota tokko irraa dhaloota kaanitti dabarsitaa?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Akka sabni kee sitti gammaduuf,</para>
  <para style="q2" vid="PSA 85:6">ati lubbuu nutti hin deebiftuu?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>Yaa <char style="nd">Waaqayyo</char>, araara kee nutti mulʼisi;</para>
  <para style="q2" vid="PSA 85:7">fayyina kees nuu kenni.<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>Ani waan <char style="nd">Waaqayyo</char> Waaqni jedhu nan dhaggeeffadha;</para>
  <para style="q2" vid="PSA 85:8">inni saba isaa qulqullootaaf nagaa abdachiisa;</para>
  <para style="q2" vid="PSA 85:8">isaan garuu gara gowwummaatti hin deebiʼin.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Akka ulfinni isaa lafa keenya irra jiraatuuf,</para>
  <para style="q2" vid="PSA 85:9">fayyisuun isaa dhugumaan warra isa sodaatanitti dhiʼoo jira.<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Jaalallii fi amanamummaan wal gaʼan;</para>
  <para style="q2" vid="PSA 85:10">qajeelummaa fi nagaan wal dhungatan.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Amanamummaan lafa keessaa burqa;</para>
  <para style="q2" vid="PSA 85:11">qajeelummaan immoo samii irraa gad ilaala.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>
    <char style="nd">Waaqayyo</char> dhugumaan waan gaarii ni kenna;</para>
  <para style="q2" vid="PSA 85:12">lafti keenyas midhaan ishee ni kenniti.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>Qajeelummaan fuula isaa dura deema;</para>
  <para style="q2" vid="PSA 85:13">miilla isaatiifis karaa qopheessa.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">Faarfannaa 86</para>
  <para style="ms1">Kadhannaa Yeroo Rakkinaa</para>
  <para style="d">Kadhannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>Yaa <char style="nd">Waaqayyo</char>, waan ani hiyyeessaa fi rakkataa taʼeef,</para>
  <para style="q2" vid="PSA 86:1">na dhagaʼiitii deebii naa kenni.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>Ani sitti of kenneeraatii lubbuu koo eegi.</para>
  <para style="q2" vid="PSA 86:2">Ati Waaqa koo ti;</para>
  <para style="q2" vid="PSA 86:2">garbicha kee kan si amanatu oolchi.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>Yaa Gooftaa na maari;</para>
  <para style="q2" vid="PSA 86:3">ani guyyaa guutuu sin waammadhaatii.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>Lubbuu garbicha keetii gammachiisi;</para>
  <para style="q2" vid="PSA 86:4">yaa Gooftaa, ani lubbuu koo gara keetti oli nan fuudhaatii.<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>Yaa Gooftaa ati gaarii dha; dhiifamas namaa goota;</para>
  <para style="q2" vid="PSA 86:5">warra si waammatan hundaafis jaalalli kee guddaa dha.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>Yaa <char style="nd">Waaqayyo</char>, kadhannaa koo dhagaʼi;</para>
  <para style="q2" vid="PSA 86:6">iyya waammata koos dhaggeeffadhu.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Ani guyyaa rakkina kootiitti sin waammadha;</para>
  <para style="q2" vid="PSA 86:7">ati deebii naa kennitaatii.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>Yaa Gooftaa, waaqota keessaa kan akka keetii hin jiru;</para>
  <para style="q2" vid="PSA 86:8">hojiin hojii keetiin wal qixxaatu tokko iyyuu hin jiru.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>Yaa Gooftaa, saboonni ati uumte hundinuu dhufanii,</para>
  <para style="q2" vid="PSA 86:9">fuula kee duratti ni sagadu;</para>
  <para style="q2" vid="PSA 86:9">maqaa keetiifis ulfina fidu.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Ati guddaa fi kan hojii dinqisiisaa hojjettuu dha;</para>
  <para style="q2" vid="PSA 86:10">Waaqni suma qofa.<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>Yaa <char style="nd">Waaqayyo</char>, karaa kee na barsiisi;</para>
  <para style="q2" vid="PSA 86:11">anis dhugaa keetiin nan bula;</para>
  <para style="q1" vid="PSA 86:11">akka ani maqaa kee sodaadhuuf,</para>
  <para style="q2" vid="PSA 86:11">garaa gargar hin qoodamne naa kenni.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>Yaa Waaqa koo Gooftaa, ani garaa koo guutuudhaan sin galateeffadha;</para>
  <para style="q2" vid="PSA 86:12">maqaa kee illee bara baraan nan ulfeessa.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>Jaalalli ati naa qabdu guddaadhaatii;</para>
  <para style="q2" vid="PSA 86:13">lubbuu koo dhidhima siiʼool keessaa baafteerta.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>Yaa Waaqi, of tuultonni natti kaʼaniiru;</para>
  <para style="q2" vid="PSA 86:14">tuunni finciltootaa, namoonni si hin sodaanne</para>
  <para style="q2" vid="PSA 86:14">lubbuu koo galaafachuu barbaadu.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>Yaa Gooftaa, ati garuu Waaqa garaa laafessaa fi arjaa dha;</para>
  <para style="q2" vid="PSA 86:15">daftee hin aartu; jaalallii fi amanamummaan kee dhuma hin qabu.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Gara kootti deebiʼiitii na maari;</para>
  <para style="q2" vid="PSA 86:16">jabina kee tajaajilaa keetii kenni;</para>
  <para style="q2" vid="PSA 86:16">ilma garbittii keetiis oolchi.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Akka diinonni koo arganii qaanaʼaniif,</para>
  <para style="q2" vid="PSA 86:17">mallattoo gaarummaa keetii naa kenni;</para>
  <para style="q2" vid="PSA 86:17">yaa <char style="nd">Waaqayyo</char>, ati na gargaartee na jajjabeessiteertaatii.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">Faarfannaa 87</para>
  <para style="ms1">Xiyoon, Haadha Sabootaa</para>
  <para style="d">Faarfannaa Ilmaan Qooraahi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>Hundeen magaalaa isaa tulluu qulqulluu irra jira.<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>
    <char style="nd">Waaqayyo</char> iddoo jireenya Yaaqoob hunda caalaa,</para>
  <para style="q2" vid="PSA 87:2">karrawwan Xiyoon jaallata.<verse eid="PSA 87:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>Yaa magaalaa Waaqaa,</para>
  <para style="q2" vid="PSA 87:3">waaʼee keetiif wanni kabajamaan akkana jedhamee ni dubbatama:<verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“Ani Raʼaabii fi Baabilonin</para>
  <para style="q2" vid="PSA 87:4">warra na beekan gidduutti maqaa nan dhaʼa;</para>
  <para style="q1" vid="PSA 87:4">kunoo, Filisxeemii fi Xiiroos Itoophiyaa wajjin,</para>
  <para style="q2" vid="PSA 87:4">‘Namichi kun achitti dhalate’ jedhu.”<verse eid="PSA 87:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Dhugumaan waaʼee Xiyoon,</para>
  <para style="q2" vid="PSA 87:5">“Inni kunii fi inni sun ishee keessatti dhalatan;</para>
  <para style="q2" vid="PSA 87:5">Waaqni Waan Hunda Olii mataan isaa iyyuu ishee dhaaba” jedhama.<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>
    <char style="nd">Waaqayyo</char> yeroo saboota galmeessutti,</para>
  <para style="q2" vid="PSA 87:6">“Namichi kun achitti dhalate” jedhee barreessa.<verse eid="PSA 87:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Warri faarfatanii fi warri meeshaa muuziiqaa taphatan,</para>
  <para style="q2" vid="PSA 87:7">“Burqaan koo hundi si keessatti argama” jedhu.<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">Faarfannaa 88</para>
  <para style="ms1">Kadhannaa Yeroo Rakkinaa</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Ilmaan Qooraahi kan <char style="tl">maahilaati liinootiin</char><note caller="+" style="f"><char style="fr" closed="false">88:0 </char><char style="ft" closed="false">Maahilaati liinootiin <char style="it">gosa muuziiqaa ti.</char></char></note> Faarfatame. <char style="tl">Maskiilii</char> Heemaan Izraahichaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>Yaa <char style="nd">Waaqayyo</char>, Waaqa na fayyiftu,</para>
  <para style="q2" vid="PSA 88:1">ani halkanii fi guyyaa fuula kee duratti nan iyyadha.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>Kadhannaan koo fuula kee duratti haa dhiʼaatu;</para>
  <para style="q2" vid="PSA 88:2">atis gurra kee gara iyyannaa kootiitti qabi.<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>Lubbuun koo rakkinaan guutamteertii;</para>
  <para style="q2" vid="PSA 88:3">jireenyi koos awwaalatti dhiʼaateera.<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Ani warra boolla keessa buʼanitti nan lakkaaʼame;</para>
  <para style="q2" vid="PSA 88:4">akka nama humna hin qabnees nan taʼe.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>Ani akka nama gorraʼamee awwaala keessa ciisuutti,</para>
  <para style="q2" vid="PSA 88:5">akka nama ati deebitee hin yaadanneetti,</para>
  <para style="q1" vid="PSA 88:5">akka warra eegumsa kee jalaa baʼaniitti,</para>
  <para style="q2" vid="PSA 88:5">warra duʼan wajjin gatameera.<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Ati boolla gad fagoo keessa,</para>
  <para style="q2" vid="PSA 88:6">dukkana hamaa keessas na buufteerta.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Dheekkamsi kee ulfaatee narra ciiseera;</para>
  <para style="q2" vid="PSA 88:7">dambalii kee hundas narra garagalchiteerta.<verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Michoota koo narraa fageessiteerta;</para>
  <para style="q2" vid="PSA 88:8">isaan biratti jibbamaa na gooteerta;</para>
  <para style="q1" vid="PSA 88:8">akka ani jalaa hin baanettis balballi natti cufameera.<verse eid="PSA 88:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9"/>Iji koo gaddaan dadhabeera.</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q1" vid="PSA 88:9">Yaa <char style="nd">Waaqayyo</char>, ani guyyuma guyyaan sin waammadha;</para>
  <para style="q2" vid="PSA 88:9">harka koo illee gara keetti nan balʼifadha.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>Ati dinqii kee warra duʼanitti ni argisiiftaa?</para>
  <para style="q2" vid="PSA 88:10">Warri duʼanis kaʼanii si galateeffatuu?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Jaalalli kee awwaala keessatti,</para>
  <para style="q2" vid="PSA 88:11">amanamummaan kee immoo Qilee keessatti ni labsamaa?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Dinqiiwwan kee dukkana keessatti,</para>
  <para style="q2" vid="PSA 88:12">yookaan qajeelummaan kee biyya irraanfannaa keessatti ni beekamaa?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Yaa <char style="nd">Waaqayyo</char>, ani garuu akka ati na gargaartuuf <optbreak/> gara keetti nan iyyadha;</para>
  <para style="q2" vid="PSA 88:13">ganamaanis kadhannaan koo fuula kee duratti ni dhiʼaata.<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>Yaa <char style="nd">Waaqayyo</char>, ati maaliif na gatta?</para>
  <para style="q2" vid="PSA 88:14">Fuula kees maaliif na duraa dhokfatta?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>Ani ijoollummaa kootii jalqabee rakkadhee duʼuu gaʼeen ture;</para>
  <para style="q2" vid="PSA 88:15">naasisuun kee na dhiphiseera; abdiis kutadheera.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Dheekkamsi kee narra yaaʼe;</para>
  <para style="q2" vid="PSA 88:16">naasisuun kees na balleesseera.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Isaan guyyaa guutuu akkuma lolaa bishaanii na marsu;</para>
  <para style="q2" vid="PSA 88:17">guutumaan guutuuttis na liqimsaniiru.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Michoota koo fi warra na jaallatan narraa fudhatteerta;</para>
  <para style="q2" vid="PSA 88:18">dukkana qofatu michuu naa taʼe.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">Faarfannaa 89</para>
  <para style="ms1">Faarfannaa Fi Kadhannaa Amanamummaa Waaqaatiif Dhiʼaate</para>
  <para style="d">
    <char style="tl">Maskiilii</char> Eetaan Izraahichaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>Ani waaʼee araara <char style="nd">Waaqayyoo</char> bara baraan nan faarfadha;</para>
  <para style="q2" vid="PSA 89:1">afaan kootiinis amanamummaa kee dhaloota hundumatti nan labsa.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Akka araarri kee bara baraan jiraatu,</para>
  <para style="q2" vid="PSA 89:2">akka ati amanamummaa kee samii keessatti jabeessitee dhaabde nan labsa.<verse eid="PSA 89:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Ati akkana jetteerta; “Ani filatamaa koo wajjin kakuu galeera;</para>
  <para style="q2" vid="PSA 89:3">Daawit tajaajilaa kootiif illee akkana jedhee kakadheera;<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘Ani bara baraan sanyii kee nan dhaaba;</para>
  <para style="q2" vid="PSA 89:4">teessoo kees dhaloota hundaaf nan cimsa.’ ”<verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>Yaa <char style="nd">Waaqayyo</char>, samiiwwan dinqii kee jaju;</para>
  <para style="q2" vid="PSA 89:5">yaaʼii qulqullootaa keessattis amanamummaa kee jaju.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Samii keessatti eenyutu <char style="nd">Waaqayyoon</char> qixxaachuu dandaʼa?</para>
  <para style="q2" vid="PSA 89:6">Uumamawwan samii keessaa kan <char style="nd">Waaqayyoon</char> fakkaatu eenyu?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Waaqni waldaa qulqullootaa keessatti baayʼee sodaatama;</para>
  <para style="q2" vid="PSA 89:7">warra naannoo isaa jiran hunda keessaas isatu sodaachisaa dha.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>Yaa <char style="nd">Waaqayyo</char>, Waaqa Waan Hunda Dandeessu, <optbreak/> kan akka keetii eenyu?</para>
  <para style="q2" vid="PSA 89:8">Yaa <char style="nd">Waaqayyo</char>, ati jabaa dha; amanamummaan kees si marsa.<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>Ati raafama galaanaa ni moota;</para>
  <para style="q2" vid="PSA 89:9">yommuu dhaʼaan isaa jabaatus ni tasgabbeessita.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Akka warra qalamaniitti Raʼaabin bulleessite;</para>
  <para style="q2" vid="PSA 89:10">irree kee jabaa sanaanis diinota kee ni bittinneessite.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Samiiwwan kan kee ti; laftis akkasuma kan kee ti;</para>
  <para style="q2" vid="PSA 89:11">ati addunyaa fi waan ishee keessa jiru hunda hundeessiteerta.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>Kaabaa fi kibba situ uume;</para>
  <para style="q2" vid="PSA 89:12">Taaboorii fi Hermoon gammachuudhaan <optbreak/> maqaa kee galateeffatu.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>Ati irree jabaa qabda; harki kee jabaa dha;</para>
  <para style="q2" vid="PSA 89:13">harki kee mirgaas ol kaʼeera.<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Qajeelummaa fi murtiin qajeelaan hundee teessoo keetii ti;</para>
  <para style="q2" vid="PSA 89:14">araarrii fi amanamummaan fuula kee dura deemu.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Yaa <char style="nd">Waaqayyo</char>, warri siif ililchuu beekan,</para>
  <para style="q2" vid="PSA 89:15">warri ifa iddoo ati jirtuu keessa jiraatan eebbifamoo dha.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Isaan guyyaa guutuu maqaa keetiin gammadu;</para>
  <para style="q2" vid="PSA 89:16">qajeelummaa keetiinis si jajatu.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Ati ulfina jabina isaanii ti;</para>
  <para style="q2" vid="PSA 89:17">jaalala keetiinis gaanfa keenya ol qabdeerta.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Dhugumaan gaachanni keenya kan <char style="nd">Waaqayyoo</char> ti;</para>
  <para style="q2" vid="PSA 89:18">kan mootii keenya Qulqullicha Israaʼelii ti.<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Ati dur akkana jettee saba kee amanamaatti</para>
  <para style="q2" vid="PSA 89:19">mulʼataan dubbatteerta:</para>
  <para style="q1" vid="PSA 89:19">“Ani loltuu tokkoof humna kenneera;</para>
  <para style="q2" vid="PSA 89:19">dargaggeessa saba keessaa filatame tokkos ani ol guddiseera.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>Ani garbicha koo Daawitin argadheera;</para>
  <para style="q2" vid="PSA 89:20">zayitii koo qulqulluunis isa dibeera.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>Harki koo isa wajjin jira;</para>
  <para style="q2" vid="PSA 89:21">irreen koos isa jajjabeessa.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Diinni tokko iyyuu isa hin moʼatu;</para>
  <para style="q2" vid="PSA 89:22">namni hamaanis isa hin hacuucu.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Amajaajota isaa fuula isaa duratti nan barbadeessa;</para>
  <para style="q2" vid="PSA 89:23">warra isa jibbanis nan dhaʼa.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Amanamummaa fi araarri koo isa wajjin jiraata;</para>
  <para style="q2" vid="PSA 89:24">gaanfi isaas maqaa kootiin ol jedha.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Ani harka isaa galaana irra,</para>
  <para style="q2" vid="PSA 89:25">harka isaa mirgaas lageen irra nan kaaʼa.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>Innis, ‘Ati Abbaa koo ti;</para>
  <para style="q2" vid="PSA 89:26">Waaqa koo ti, Kattaa Fayyina koo ti’ jedhee na waammata.<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Anis ilma koo hangafa,</para>
  <para style="q2" vid="PSA 89:27">kan mootota lafaa hundaa olii isa nan godha.<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>Jaalala koos bara baraan isaaf nan tursa;</para>
  <para style="q2" vid="PSA 89:28">kakuun ani isa wajjin qabus hin cabu.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>Hidda sanyii isaa bara baraan,</para>
  <para style="q2" vid="PSA 89:29">teessoo isaa illee hamma samiiwwan jiraatanitti nan dhaaba.<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“Yoo ilmaan isaa seera koo eeguu didan,</para>
  <para style="q2" vid="PSA 89:30">yoo isaan ajaja koo faana buʼuu baatan,<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>yoo isaan sirna koo cabsanii</para>
  <para style="q2" vid="PSA 89:31">ajaja koo illee eeguu baatan,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>ani cubbuu isaanii uleedhaan,</para>
  <para style="q2" vid="PSA 89:32">yakka isaanii immoo qacceedhaan nan adaba;<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>ani garuu jaalala koo isa irraa hin fudhadhu;</para>
  <para style="q2" vid="PSA 89:33">yookaan amanamummaa koo sobatti hin geeddaru.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Ani kakuu koo hin cabsu;</para>
  <para style="q2" vid="PSA 89:34">yookaan waan afaan koo dubbates hin geeddaru.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Siʼa tokko yeroo hundaaf, qulqullina kootiin kakadheera;</para>
  <para style="q2" vid="PSA 89:35">ani Daawitin hin sobu.<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>Sanyiin isaa bara baraan itti fufa;</para>
  <para style="q2" vid="PSA 89:36">teessoon isaas akkuma aduu fuula koo dura jiraata;<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>akkuma jiʼaas bara baraan ni jiraata;</para>
  <para style="q2" vid="PSA 89:37">hamma samiiwwan jiranittis cimee dhaabata.”<verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>Ati amma garuu isa dhiifteerta; tuffatteertas;</para>
  <para style="q2" vid="PSA 89:38">isa dibde sanatti baayʼee aarteerta.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Kakuu tajaajilaa kee wajjin galte cabsiteerta;</para>
  <para style="q2" vid="PSA 89:39">gonfoo isaas awwaara keessa buuftee xureessiteerta.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Dallaa isaa hunda caccabsiteerta;</para>
  <para style="q2" vid="PSA 89:40">daʼoo isaa jajjabaas barbadeessiteerta.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>Warri achiin darban hundi isa saamu;</para>
  <para style="q2" vid="PSA 89:41">olloonni isaas itti qoosu.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Ati harka amajaajii isaa mirgaa ol qabdeerta;</para>
  <para style="q2" vid="PSA 89:42">akka diinonni isaa hundi gammadan gooteerta.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Arfii goraadee isaa duubatti deebifteerta;</para>
  <para style="q2" vid="PSA 89:43">waraana keessattis isa hin gargaarre.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Surraa isaa isa irraa balleessiteerta;</para>
  <para style="q2" vid="PSA 89:44">teessoo isaas lafatti gatteerta.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Umurii dargaggummaa isaa gabaabsiteerta;</para>
  <para style="q2" vid="PSA 89:45">qaaniidhaanis isa haguugdeerta.<verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>Yaa <char style="nd">Waaqayyo</char>, kun hamma yoomiitti?</para>
  <para style="q2" vid="PSA 89:46">Ati bara baraan of dhoksitaa?</para>
  <para style="q2" vid="PSA 89:46">Dheekkamsi kee hamma yoomiitti akka ibiddaa bobaʼa?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>Umuriin koo hammam akka gabaabaa taʼe yaadadhu.</para>
  <para style="q2" vid="PSA 89:47">Ati badiisa akkamiitiif ilmaan namaa hunda uumte!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>Utuu duʼa hin argin jiraachuu kan dandaʼu</para>
  <para style="q2" vid="PSA 89:48">yookaan humna siiʼool jalaa of baasuu <optbreak/> kan dandaʼu nama akkamii ti?<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>Yaa Gooftaa, jaalalli kee guddaan durii kan ati amanamummaa keetiin</para>
  <para style="q2" vid="PSA 89:49">Daawitiif kakatte sun eessa jira?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>Yaa Gooftaa, akkamitti akka tajaajilaan kee tuffatame,</para>
  <para style="q2" vid="PSA 89:50">akkamitti akka ani arrabsoo saboota hundaa <optbreak/> bobaatti baadhe yaadadhu;<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>yaa <char style="nd">Waaqayyo</char>, qoosaa diinonni kee natti qoosan,</para>
  <para style="q2" vid="PSA 89:51">kan isaan ittiin tarkaanfii dibamaa keetii hundatti qoosan yaadadhu.<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>Galanni bara baraan <char style="nd">Waaqayyoof</char> haa taʼu!</para>
  <para style="qr" vid="PSA 89:52">Ameen; Ameen.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">Kitaaba Afuraffaa</para>
  <para style="mr">
    <ref loc="PSA 90-106">Faarfannaa 90–106</ref></para>
  <para style="cl">Faarfannaa 90</para>
  <para style="ms1">Namni Dadhabaa Taʼuu Isaa</para>
  <para style="d">Kadhannaa Musee Nama Waaqaa Sanaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>Yaa Gooftaa, ati dhaloota hunda keessatti</para>
  <para style="q2" vid="PSA 90:1">iddoo jireenyaa nuu taateerta.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Utuu tulluuwwan hin dhalatin</para>
  <para style="q2" vid="PSA 90:2">yookaan utuu ati lafaa fi addunyaa hin uumin,</para>
  <para style="q2" vid="PSA 90:2">baraa baraa hamma bara baraatti ati Waaqa.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>Atis, “Yaa ilmaan namootaa, biyyootti deebiʼaa”</para>
  <para style="q2" vid="PSA 90:3">jettee namoota biyyootti deebista.<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>Fuula kee duratti waggaan kumni tokko,</para>
  <para style="q2" vid="PSA 90:4">akkuma guyyaa kaleessa darbee ti;</para>
  <para style="q2" vid="PSA 90:4">yookaan akkuma dabaree eegumsa halkanii tokkoo ti.<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>Ati hirriba duʼaatiin namoota haxooftee balleessita;</para>
  <para style="q2" vid="PSA 90:5">isaan akkuma marga ganama bayyanatuu ti;<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>margi sun ganama ganama bayyanatu illee</para>
  <para style="q2" vid="PSA 90:6">galgala galgala garuu coollagee goga.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Aariin kee nu fixeera;</para>
  <para style="q2" vid="PSA 90:7">dheekkamsi kees nu naasiseera.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Yakka keenya fuula kee dura,</para>
  <para style="q2" vid="PSA 90:8">cubbuu keenya dhokataa sanas ifa fuula keetii dura keesseerta.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Barri keenya hundinuu dheekkamsa keetiin dhumeeraatii;</para>
  <para style="q2" vid="PSA 90:9">umurii keenyas aaduudhaan fixanna.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Dheerinni bara keenyaa waggaa torbaatama,</para>
  <para style="q2" vid="PSA 90:10">yoo jabaanne immoo waggaa saddeettama taʼa;</para>
  <para style="q1" vid="PSA 90:10">kuni iyyuu garri caalaan isaa dadhabbii fi rakkinaan guutameera;</para>
  <para style="q2" vid="PSA 90:10">inni dafee darbaatii; nus barrifnee ni sokkina.<verse eid="PSA 90:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>Humna aarii keetii eenyutu beeka?</para>
  <para style="q2" vid="PSA 90:11">Dheekkamsi kee akkuma sodaa nu siif qabaachuu qabnu sanaa <optbreak/> guddaadhaatii.<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Akka nu garaa ogummaadhaan guutame qabaannuuf,</para>
  <para style="q2" vid="PSA 90:12">bara keenya lakkaaʼuu nu barsiisi.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>Yaa <char style="nd">Waaqayyo</char>, deebiʼi! Kun hamma yoomiitti taʼa?</para>
  <para style="q2" vid="PSA 90:13">Tajaajiltoota keetiifis garaa laafi.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>Akka nu bara keenya guutuu gammannee ililchinuuf,</para>
  <para style="q2" vid="PSA 90:14">ganama ganama araara keetiin nu quufsi.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Hamma baayʼina guyyoota ati nu miite sanaa,</para>
  <para style="q2" vid="PSA 90:15">hamma baayʼina waggoota nu rakkanne sanaas nu gammachiisi.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Hojiin kee tajaajiltoota keetti,</para>
  <para style="q2" vid="PSA 90:16">ulfinni kees ijoollee isaaniitti haa mulʼifamu.<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Eebbi Waaqa keenya Gooftichaa nurra haa buʼu;</para>
  <para style="q2" vid="PSA 90:17">hojii harka keenyaas jabeessii nuu dhaabi;</para>
  <para style="q2" vid="PSA 90:17">eeyyee, hojii harka keenyaa jabeessii nuu dhaabi.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">Faarfannaa 91</para>
  <para style="ms1">Eegumsa Waaqaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>Namni daʼoo Waaqa Waan Hundaa Olii keessa jiraatu,</para>
  <para style="q2" vid="PSA 91:1">gaaddisa Waaqa Waan Hunda Dandaʼu sanaa jala boqota.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>Anis <char style="nd">Waaqayyoon</char>, “Inni iddoo ani itti kooluu galuu fi <optbreak/> daʼannoo koo ti;</para>
  <para style="q2" vid="PSA 91:2">Waaqa koo kan ani amanadhuu dha” nan jedha.<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>Inni dhugumaan kiyyoo adamsaa jalaa,</para>
  <para style="q2" vid="PSA 91:3">dhukkuba nama fixu jalaas si baasa.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>Inni baallee isaatiin si dhoksa;</para>
  <para style="q2" vid="PSA 91:4">atis qoochoo isaa jalatti kooluu ni galta;</para>
  <para style="q2" vid="PSA 91:4">amanamummaan isaa gaachanaa fi dallaa eegumsaa siif taʼa.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Atis naasuu halkanii,</para>
  <para style="q2" vid="PSA 91:5">yookaan xiyya guyyaan futtaafamu hin sodaattu;<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>golfaa dukkana keessa deemu,</para>
  <para style="q2" vid="PSA 91:6">yookaan dhaʼicha guyyaa saafaan nama balleessu hin sodaannu.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Kumni tokko si cinatti,</para>
  <para style="q2" vid="PSA 91:7">kumni kudhan immoo mirga keetti ni kufa;</para>
  <para style="q2" vid="PSA 91:7">garuu sitti hin dhiʼaatu.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Ati ijuma kee qofaan ilaalta;</para>
  <para style="q2" vid="PSA 91:8">adaba hamootatti dhufus ni argita.<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Ati waan <char style="nd">Waaqayyoon</char> iddoo kooluu itti galtu,</para>
  <para style="q2" vid="PSA 91:9">Waaqa Waan Hundaa Olii iddoo jireenya keetii godhatteef,<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>wanni hamaan si hin tuqu;</para>
  <para style="q2" vid="PSA 91:10">dhaʼichis dunkaana keetti hin dhiʼaatu.<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>Inni akka isaan karaa kee hunda irratti si eeganiif,</para>
  <para style="q2" vid="PSA 91:11">ergamoota isaa siif ni ajaja;<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>isaanis akka miilla keetiin dhagaatti hin buuneef</para>
  <para style="q2" vid="PSA 91:12">harka isaaniitiin ol si fuudhu.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>Ati leencaa fi buutii irra ejjetta;</para>
  <para style="q2" vid="PSA 91:13">leenca saafelaa fi jawwee ni dhidhiitta.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>
    <char style="nd">Waaqayyos</char> akkana jedha;</para>
  <para style="q2" vid="PSA 91:14">“Sababii inni na jaallatuuf, ani isa nan oolcha;</para>
  <para style="q2" vid="PSA 91:14">waan inni maqaa koo beekuuf isa nan eega.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>Inni na waammata; anis nan deebisaaf;</para>
  <para style="q2" vid="PSA 91:15">rakkina keessatti ani isa wajjin nan taʼa;</para>
  <para style="q2" vid="PSA 91:15">isa nan oolcha; ulfinas nan kennaaf.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Ani umurii dheeraa isa nan quufsa;</para>
  <para style="q2" vid="PSA 91:16">fayyisuu koos isatti argisiisa.”<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">Faarfannaa 92</para>
  <para style="ms1">Gammachuu Nama Qajeelaa,</para>
  <para style="d">Faarfannaa Guyyaa Sanbataa Faarfatamu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>
    <char style="nd">Waaqayyoon</char>, galateeffachuun, yaa Waaqa Waan Hundaa Olii,</para>
  <para style="q2" vid="PSA 92:1">maqaa keetiif faarfachuun gaarii dha.<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>Jaalala kee ganamaan,</para>
  <para style="q2" vid="PSA 92:2">amanamummaa kees halkaniin labsuun,<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>kiraara ribuu kudhaniitiin,</para>
  <para style="q2" vid="PSA 92:3">sagalee baganaatiinis labsuun gaarii dha.<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>Yaa <char style="nd">Waaqayyo</char>, ati hojii keetiin na gammachiiftaatii;</para>
  <para style="q2" vid="PSA 92:4">ani sababii hojii harka keetiitiif gammachuudhaan nan faarfadha.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>Yaa <char style="nd">Waaqayyo</char>, hojiin kee akkam guddaa dha;</para>
  <para style="q2" vid="PSA 92:5">yaadni kees akkam gad fagoo dha!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Namni qalbii hin qabne waan kana beekuu hin dandaʼu;</para>
  <para style="q2" vid="PSA 92:6">gowwaanis hin hubatu;<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>hamoonni yoo akkuma margaa biqilan iyyuu,</para>
  <para style="q2" vid="PSA 92:7">jalʼoonni hundinuus yoo daraaran iyyuu,</para>
  <para style="q2" vid="PSA 92:7">isaan bara baraan ni barbadaaʼu.<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>Yaa <char style="nd">Waaqayyo</char>, ati garuu bara baraan ol ol jetta.<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>Yaa <char style="nd">Waaqayyo</char>, kunoo diinota kee,</para>
  <para style="q2" vid="PSA 92:9">kunoo diinonni kee ni badu;</para>
  <para style="q2" vid="PSA 92:9">warri jalʼina hojjetan hundinuus ni bittinneeffamu.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Ati gaanfa koo akka gaanfa gafarsaa ol ol qabde;</para>
  <para style="q2" vid="PSA 92:10">zayitii haaraa natti dhangalaafte.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Iji koo moʼatamuu diinota koo argeera;</para>
  <para style="q2" vid="PSA 92:11">gurri koos badiisa jalʼoota natti kaʼanii dhagaʼeera.<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Qajeeltonni akkuma muka meexxii ni dagaagu;</para>
  <para style="q2" vid="PSA 92:12">akkuma birbirsa Libaanoonitti ni guddatu;<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>isaan mana <char style="nd">Waaqayyoo</char> keessa dhaabamanii jiru;</para>
  <para style="q2" vid="PSA 92:13">oobdii Waaqa keenyaa keessattis itti tolee misanii jiran.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>Isaan amma iyyuu bara dullumaa keessa ija naqatu;</para>
  <para style="q2" vid="PSA 92:14">gabbataniis dagaaganii jiraatu.<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>Isaanis, “<char style="nd">Waaqayyo</char> tolaa dha; inni Kattaa koo ti;</para>
  <para style="q2" vid="PSA 92:15">hamminni isa keessa hin jiru” jedhanii labsu.<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">Faarfannaa 93</para>
  <para style="ms1">Miidhagina <char style="nd">Waaqayyoo</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>
    <char style="nd">Waaqayyo</char> ni moʼa; surraas ni uffata;</para>
  <para style="q2" vid="PSA 93:1">
    <char style="nd">Waaqayyo</char> surra ni uffata; jabinas hidhata.</para>
  <para style="q2" vid="PSA 93:1">Addunyaan cimtee dhaabamteerti; hin sochoofamtus.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>Teessoon kee durumaa jalqabee cimee dhaabateera;</para>
  <para style="q2" vid="PSA 93:2">ati durii duriitii jalqabdee jirta.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>Yaa <char style="nd">Waaqayyo</char>, galaanonni ol kaasaniiru;</para>
  <para style="q2" vid="PSA 93:3">galaanonni sagalee isaanii ol kaafataniiru;</para>
  <para style="q2" vid="PSA 93:3">galaanonni huursuu isaanii ol kaafataniiru.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Sagalee bishaan baayʼee caalaa,</para>
  <para style="q2" vid="PSA 93:4">jabina dhaʼaa galaanaa caalaas,</para>
  <para style="q2" vid="PSA 93:4">
    <char style="nd">Waaqayyo</char> ol gubbaa jiru sun humna qabeessa.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>Seerri kee jabaatee ni dhaabata;</para>
  <para style="q2" vid="PSA 93:5">Yaa <char style="nd">Waaqayyo</char>, qulqullummaan bara baraan</para>
  <para style="q2" vid="PSA 93:5">faaya mana keetii ti.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">Faarfannaa 94</para>
  <para style="ms1">Waaqa Murtii Qajeelaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>Yaa <char style="nd">Waaqayyo</char>, Waaqa haaloo baaftu,</para>
  <para style="q2" vid="PSA 94:1">Yaa Waaqa haaloo baaftu, ifii mulʼadhu.<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Yaa Abbaa Murtii lafa kanaa kaʼi;</para>
  <para style="q2" vid="PSA 94:2">of tuultotaaf illee waan isaanii malu kenni.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>Yaa <char style="nd">Waaqayyo</char>, hamma yoomiitti warri hamoon,</para>
  <para style="q2" vid="PSA 94:3">warri hamoon hamma yoomiitti burraaqu?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Isaan dubbii of tuulummaa gad roobsu;</para>
  <para style="q2" vid="PSA 94:4">jalʼoonni hundinuu of dhiibuudhaan guutaman.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>Yaa <char style="nd">Waaqayyo</char>, isaan saba kee miidhu;</para>
  <para style="q2" vid="PSA 94:5">handhuuraa kees ni hacuucu.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Haadha hiyyeessaatii fi keessummaa ni gorraʼu;</para>
  <para style="q2" vid="PSA 94:6">ijoollee abbaa hin qabnes ni ajjeesu.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>Isaan, “<char style="nd">Waaqayyo</char> hin argu;</para>
  <para style="q2" vid="PSA 94:7">Waaqni Yaaqoob hin qalbeeffatu” jedhu.<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>Warri saba keessaa raatoftan mee hubadhaa;</para>
  <para style="q2" vid="PSA 94:8">isin warri gowwoonni yoom ogeeyyii taatu?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Inni gurra uume sun hin dhagaʼuu?</para>
  <para style="q2" vid="PSA 94:9">Inni ija uume hin argu?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Inni saboota sirreessu sun hin adabuu?</para>
  <para style="q2" vid="PSA 94:10">Inni nama barsiisu sun beekumsa hin qabuu?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>
    <char style="nd">Waaqayyo</char> yaada namaa beeka;</para>
  <para style="q2" vid="PSA 94:11">akka yaadni namaa faayidaa hin qabnes ni beeka.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>Yaa <char style="nd">Waaqayyo</char>, namni ati adabdu,</para>
  <para style="q2" vid="PSA 94:12">namni ati seera kee irraa barsiiftu eebbifamaa dha;<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>hamma hamootaaf boolli qotamutti,</para>
  <para style="q2" vid="PSA 94:13">guyyaa rakkinaatti ati boqonnaa kennitaaf.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>
    <char style="nd">Waaqayyo</char> saba isaa hin gatuutii;</para>
  <para style="q2" vid="PSA 94:14">inni akkana illee jedhee handhuuraa ofii isaa hin dhiisu.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>Murtiin qajeelummaa irratti hundeeffama;</para>
  <para style="q2" vid="PSA 94:15">toloonni hundinuus isa faana buʼu.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>Eenyutu hamootatti naa kaʼa?</para>
  <para style="q2" vid="PSA 94:16">Eenyutu na cina dhaabatee warra jalʼina hojjetaniin morma?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Utuu <char style="nd">Waaqayyo</char> na gargaaruu baatee,</para>
  <para style="q2" vid="PSA 94:17">silaa yoona lubbuun koo boolla duʼaa keessa jirti.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Yaa <char style="nd">Waaqayyo</char> yeroo ani, “Miilli koo mucucaateera” jedhetti,</para>
  <para style="q2" vid="PSA 94:18">araarri kee ol qabee na dhaabe.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Yommuu yaaddoon natti baayʼatetti,</para>
  <para style="q2" vid="PSA 94:19">jajjabeessuun kee lubbuu koo gammachiise.<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Bulchitoonni hamoon, warri seeratti fayyadamanii jalʼina hojjetan</para>
  <para style="q2" vid="PSA 94:20">si wajjin tokkummaa qabaachuu dandaʼuu?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Isaan tokkummaadhaan nama qajeelaatti kaʼanii</para>
  <para style="q2" vid="PSA 94:21">nama yakka hin qabnetti duʼa muru.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>
    <char style="nd">Waaqayyo</char> garuu daʼoo,</para>
  <para style="q2" vid="PSA 94:22">Waaqni koos, kattaa ani itti baqadhu naa taʼeera.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Inni gatii cubbuu isaanii isaanumatti deebisa;</para>
  <para style="q2" vid="PSA 94:23">sababii hammina isaaniitiif illee isaan balleessa;</para>
  <para style="q2" vid="PSA 94:23">
    <char style="nd">Waaqayyo</char> Waaqni keenya isaan barbadeessa.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">Faarfannaa 95</para>
  <para style="ms1">Faarfannaa Guyyaa Guyyaatti Faarfatamu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>Kottaa <char style="nd">Waaqayyoof</char> faarfannaa;</para>
  <para style="q2" vid="PSA 95:1">Kattaa fayyina keenyaatiifis ni ililchinaa.<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Galataan fuula isaa duratti haa dhiʼaannu;</para>
  <para style="q2" vid="PSA 95:2">faarfannaadhaanis isa haa leellifnu.<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>
    <char style="nd">Waaqayyo</char> Waaqa guddaadhaatii;</para>
  <para style="q2" vid="PSA 95:3">inni waaqota hundaa olitti Mootii guddaa dha.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Qileewwan lafaa harka isaa keessa jiru;</para>
  <para style="q2" vid="PSA 95:4">fiixeewwan tulluus kan isaa ti.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>Galaanni kan isaa ti; isatu hojjeteetii;</para>
  <para style="q2" vid="PSA 95:5">lafa gogaa illee harka isaatu uume.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Kottaa gad jennee sagadnaa;</para>
  <para style="q2" vid="PSA 95:6">Uumaa keenya <char style="nd">Waaqayyo</char> duratti ni jilbeenfannaa;<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>inni Waaqa keenyaatii;</para>
  <para style="q2" vid="PSA 95:7">nu immoo saba eegumsa isaa jala jirruu dha;</para>
  <para style="q2" vid="PSA 95:7">bushaayee harka isaa keessa jiruudhas.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">Isin harʼa yoo sagalee isaa dhageessan,<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>akka Mariibaatti gootan sana,</para>
  <para style="q2" vid="PSA 95:8">akka gaafa gammoojjii keessatti Maasaatti gootan sanaa <optbreak/> mataa hin jabaatinaa;<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>abbootiin keessan utuma hojii koo arganuu,</para>
  <para style="q2" vid="PSA 95:9">achitti qoranii na ilaalan.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Dhaloota sanatti ani waggaa afurtama nan dheekkame;</para>
  <para style="q2" vid="PSA 95:10">anis, “Isaan saba garaan isaanii karaa irraa jalʼatee dha;</para>
  <para style="q2" vid="PSA 95:10">isaan karaa koo hin beekne” nan jedheen.<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Kanaafuu ani dheekkamsa kootiin,</para>
  <para style="q2" vid="PSA 95:11">“Isaan boqonnaa kootti hin galan” jedhee kakadhe.<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">Faarfannaa 96</para>
  <para style="ms1">Waaqni Mootii Fi Abbaa Murtii ti</para>
  <para style="mr">
    <ref loc="PSA 96:1-13">96:1‑13</ref> kwf – <char style="xt"><ref loc="1CH 16:23-33">1Sn 16:23‑33</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>Faarfannaa haaraa <char style="nd">Waaqayyoof</char> faarfadhaa;</para>
  <para style="q2" vid="PSA 96:1">lafti hundinuu <char style="nd">Waaqayyoon</char> faarfadhaa.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>
    <char style="nd">Waaqayyoon</char> faarfadhaa; maqaa isaa eebbisaa;</para>
  <para style="q2" vid="PSA 96:2">fayyisuu isaas guyyuma guyyaan labsaa.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Ulfina isaa saboota gidduutti,</para>
  <para style="q2" vid="PSA 96:3">hojii isaa dinqisiisaa sana immoo namoota hunda keessatti labsaa.<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>
    <char style="nd">Waaqayyo</char> guddaadhaatii galanni baayʼeen isaaf ni mala;</para>
  <para style="q2" vid="PSA 96:4">inni waaqota hundaa olittis sodaatamuu qaba.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Waaqonni saboota ormaa hundinuu waaqota tolfamoodhaatii;</para>
  <para style="q2" vid="PSA 96:5">
    <char style="nd">Waaqayyo</char> garuu samiiwwan uume.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>Miidhaginnii fi surraan fuula isaa dura jiru;</para>
  <para style="q2" vid="PSA 96:6">jabinnii fi ulfinni iddoo qulqullummaa isaa keessa jiru.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>Yaa maatiiwwan sabootaa <char style="nd">Waaqayyoof</char> kennaa;</para>
  <para style="q2" vid="PSA 96:7">ulfinaa fi jabina <char style="nd">Waaqayyoof</char> kennaa.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Ulfina maqaa isaatiif malu <char style="nd">Waaqayyoof</char> kennaa;</para>
  <para style="q2" vid="PSA 96:8">aarsaa fidaatii oobdii isaa seenaa.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Bareedina qulqullummaa isaatiin <char style="nd">Waaqayyoon</char> waaqeffadhaa;</para>
  <para style="q2" vid="PSA 96:9">isin lafti hundinuu fuula isaa duratti holladhaa.<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Saboota gidduutti, “<char style="nd">Waaqayyo</char> mootii dha” jedhaa;</para>
  <para style="q2" vid="PSA 96:10">addunyaan jabaattee dhaabatteerti; sochoofamuus hin dandeessu.</para>
  <para style="q2" vid="PSA 96:10">Inni qajeelummaadhaan sabootaaf murtii kenna.<verse eid="PSA 96:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Samiiwwan haa ililchan; laftis haa gammaddu;</para>
  <para style="q2" vid="PSA 96:11">galaannii fi wanni isa keessa jiru hundinuu haa huursu.<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>Dirreewwanii fi wanni isaan irra jiran hundinuu haa gammadan.</para>
  <para style="q2" vid="PSA 96:12">Mukkeen bosonaa hundinuus gammachuudhaan haa faarfatan.<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>Uumamni hundi fuula <char style="nd">Waaqayyoo</char> duratti haa faarfatu; inni ni dhufaatii;</para>
  <para style="q2" vid="PSA 96:13">inni lafatti murteessuuf ni dhufa.</para>
  <para style="q1" vid="PSA 96:13">Addunyaatti qajeelummaadhaan,</para>
  <para style="q2" vid="PSA 96:13">sabootatti immoo dhugaa isaatiin ni mura.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">Faarfannaa 97</para>
  <para style="ms1">Moʼachuu <char style="nd">Waaqayyo</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>
    <char style="nd">Waaqayyo</char> moʼeera; lafti haa gammaddu;</para>
  <para style="q2" vid="PSA 97:1">biyyoonni qarqara galaanaa hedduunis haa ililchan.<verse eid="PSA 97:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Duumessaa fi dukkanni limixiin isa marsaniiru;</para>
  <para style="q2" vid="PSA 97:2">qajeelummaa fi murtii qajeelaan hundee teessoo isaa ti.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Ibiddi fuula isaa dura deemee</para>
  <para style="q2" vid="PSA 97:3">diinota isaa naannoo isaatii fixa.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>Balaqqeen isaa addunyaa ibsa;</para>
  <para style="q2" vid="PSA 97:4">laftis argitee hollatti.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Tulluuwwan fuula <char style="nd">Waaqayyoo</char> duratti,</para>
  <para style="q2" vid="PSA 97:5">fuula Gooftaa lafa hundumaa durattis akkuma gagaa baqu.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>Samiiwwan qajeelummaa isaa labsu;</para>
  <para style="q2" vid="PSA 97:6">saboonni hundinuus ulfina isaa argu.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Warri fakkii waaqeffatan,</para>
  <para style="q2" vid="PSA 97:7">kanneen waaqota tolfamoon of jajan hundi haa qaaneffaman;</para>
  <para style="q2" vid="PSA 97:7">isin waaqonni hundinuus isa waaqeffadhaa!<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Yaa <char style="nd">Waaqayyo</char>, sababii murtii keetiitiif,</para>
  <para style="q2" vid="PSA 97:8">Xiyoon dhageessee ililchiti;</para>
  <para style="q2" vid="PSA 97:8">gandoonni Yihuudaas ni gammadu.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>Yaa <char style="nd">Waaqayyo</char>, ati lafa hundumaa irratti Waaqa Waan Hundaa Olii ti;</para>
  <para style="q2" vid="PSA 97:9">ati waaqota hundumaa irra akka malee ol ol jetteerta.<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>Sababii inni lubbuu amanamoota isaa eegee,</para>
  <para style="q2" vid="PSA 97:10">harka hamootaa jalaa isaan baasuuf,</para>
  <para style="q2" vid="PSA 97:10">warri <char style="nd">Waaqayyoon</char> jaallatan hammina haa jibban.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Qajeeltota irratti ifni ni ifa;</para>
  <para style="q2" vid="PSA 97:11">gara tolootaafis gammachuun ni dhufa.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>Isin qajeeltonni <char style="nd">Waaqayyotti</char> gammadaa;</para>
  <para style="q2" vid="PSA 97:12">maqaa isaa qulqulluus galateeffadhaa.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">Faarfannaa 98</para>
  <para style="ms1">Abbaa Murtii Addunyaa Hundaa</para>
  <para style="d">Faarfannaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>
    <char style="nd">Waaqayyoof</char> faarfannaa haaraa faarfadhaa;</para>
  <para style="q2" vid="PSA 98:1">inni dinqii hojjeteeratii;</para>
  <para style="q1" vid="PSA 98:1">harki isaa inni mirgaatii fi irreen isaa qulqulluun,</para>
  <para style="q2" vid="PSA 98:1">akka inni moʼannaa argatu godhaniiru.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>
    <char style="nd">Waaqayyo</char> akka fayyisuun isaa beekamu godheera;</para>
  <para style="q2" vid="PSA 98:2">qajeelummaa isaas sabootatti mulʼiseera.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>Inni jaalala isaatii fi amanamummaa isaa</para>
  <para style="q2" vid="PSA 98:3">mana Israaʼeliif yaadateera;</para>
  <para style="q1" vid="PSA 98:3">daariin lafaa hundinuu,</para>
  <para style="q2" vid="PSA 98:3">fayyisuu Waaqa keenyaa arganiiru.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Lafti hundinuu <char style="nd">Waaqayyoof</char> ililchaa;</para>
  <para style="q2" vid="PSA 98:4">faarfannaa gammachuutiin iyyaa; weedduu galataas weeddisaa;<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>baganaadhaan faarfannaa galataa,</para>
  <para style="q2" vid="PSA 98:5">baganaa fi sagalee weedduutiin <char style="nd">Waaqayyoof</char> faarfadhaa;<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>malakataa fi sagalee gaanfaatiin,</para>
  <para style="q2" vid="PSA 98:6">fuula <char style="nd">Waaqayyo</char> mootichaa duratti ililchaa.<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Galaannii fi wanni isa keessa jiru hundinuu,</para>
  <para style="q2" vid="PSA 98:7">addunyaa fi wanti ishee keessa jiraatu hundinuu haa huursan.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Lageen harka isaanii haa rurrukutan;</para>
  <para style="q2" vid="PSA 98:8">tulluuwwanis tokkummaadhaan haa ililchan;<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>isaan fuula <char style="nd">Waaqayyoo</char> duratti haa faarfatan;</para>
  <para style="q2" vid="PSA 98:9">inni lafatti murteessuu ni dhufaatii.</para>
  <para style="q1" vid="PSA 98:9">Inni addunyaaf qajeelummaadhaan,</para>
  <para style="q2" vid="PSA 98:9">namootaaf immoo utuu wal hin caalchisin murtii kenna.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">Faarfannaa 99</para>
  <para style="ms1">Waaqa Qajeelaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>
    <char style="nd">Waaqayyo</char> moʼeera;</para>
  <para style="q2" vid="PSA 99:1">saboonni haa hollatan;</para>
  <para style="q1" vid="PSA 99:1">inni kiirubeel gidduu, teessoo isaa irra taaʼa;</para>
  <para style="q2" vid="PSA 99:1">lafti haa raafamtu.<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>
    <char style="nd">Waaqayyo</char> Xiyoon keessatti guddaa dha;</para>
  <para style="q2" vid="PSA 99:2">inni saboota hunda irra ol ol jedheera.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Isaan maqaa kee guddichaa fi sodaachisaa sana haa jajan;</para>
  <para style="q2" vid="PSA 99:3">inni qulqulluu dha.<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Mootichi humna qabeessa; inni murtii qajeelaa jaallata;</para>
  <para style="q2" vid="PSA 99:4">ati tola hundeessiteerta;</para>
  <para style="q1" vid="PSA 99:4">Yaaqoob keessattis haqaa fi</para>
  <para style="q2" vid="PSA 99:4">qajeelummaa hojjetteerta.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>
    <char style="nd">Waaqayyo</char> Waaqa keenya leellisaa;</para>
  <para style="q2" vid="PSA 99:5">ejjeta miilla isaa jalatti sagadaa;</para>
  <para style="q2" vid="PSA 99:5">inni qulqulluu dha.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Musee fi Aroon luboota isaa keessa turan;</para>
  <para style="q2" vid="PSA 99:6">Saamuʼeelis warra maqaa isaa waammatan keessa ture;</para>
  <para style="q1" vid="PSA 99:6">isaan <char style="nd">Waaqayyoon</char> waammatan;</para>
  <para style="q2" vid="PSA 99:6">innis deebii kenneef.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>Inni utubaa duumessaa keessaa isaanitti dubbate;</para>
  <para style="q2" vid="PSA 99:7">isaanis sirna isaatii fi seera inni isaaniif kenne eegan.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>Yaa <char style="nd">Waaqayyo</char> Waaqa keenya,</para>
  <para style="q2" vid="PSA 99:8">ati deebii isaanii kennite;</para>
  <para style="q1" vid="PSA 99:8">ati balleessaa isaanii adabdu illee,</para>
  <para style="q2" vid="PSA 99:8">Israaʼeliif Waaqa dhiifama gootu turte.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Waaqa keenya <char style="nd">Waaqayyoon</char> leellisaa;</para>
  <para style="q2" vid="PSA 99:9">tulluu isaa qulqulluu irrattis waaqeffadhaa;</para>
  <para style="q2" vid="PSA 99:9">
    <char style="nd">Waaqayyo</char> Waaqni keenya Waaqa qulqulluudhaatii.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">Faarfannaa 100</para>
  <para style="ms1">Gorsa Galata Galchuu</para>
  <para style="d">Faarfannaa Galataa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>Lafti hundinuu <char style="nd">Waaqayyoof</char> ililchaa.<verse eid="PSA 100:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2"/>Gammachuudhaan <char style="nd">Waaqayyoon</char> waaqeffadhaa;</para>
  <para style="q2" vid="PSA 100:2">faarfannaa gammachuutiinis fuula isaa duratti dhiʼaadhaa.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Akka <char style="nd">Waaqayyo</char> Waaqa taʼe beekaa;</para>
  <para style="q2" vid="PSA 100:3">isattu nu uume; nu kan isaa ti;</para>
  <para style="q2" vid="PSA 100:3">nu saba isaa ti; hoolota tika isaa jala jirruu dha.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Galateeffachuudhaan karrawwan isaa,</para>
  <para style="q2" vid="PSA 100:4">jajachuudhaanis oobdii isaa seenaa;</para>
  <para style="q2" vid="PSA 100:4">isa galateeffadhaa; maqaa isaa illee eebbisaa.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>
    <char style="nd">Waaqayyo</char> gaariidhaatii; araarri isaa kan bara baraa ti;</para>
  <para style="q2" vid="PSA 100:5">amanamummaan isaas dhalootaa gara dhalootaatti itti fufa.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">Faarfannaa 101</para>
  <para style="ms1">Bulchiinsa Qajeelaa</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>Ani jaalala keetii fi murtii kee qajeelaa sanaaf nan faarfadha;</para>
  <para style="q2" vid="PSA 101:1">Yaa <char style="nd">Waaqayyo</char> ani siif nan faarfadha.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Ani jireenya hirʼina hin qabne jiraachuuf of nan eeggadha;</para>
  <para style="q2" vid="PSA 101:2">ati yoom gara koo dhufta?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">Ani garaa qulqulluudhaan,</para>
  <para style="q2" vid="PSA 101:2">mana koo nan jiraadha.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Ani ija koo dura,</para>
  <para style="q2" vid="PSA 101:3">waan hamaa hin kaaʼu.</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q1" vid="PSA 101:3">Hojii jalʼootaa nan jibba;</para>
  <para style="q2" vid="PSA 101:3">nattis hin qabatu.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Namoonni yaada micciiramaa qaban narraa haa fagaatan;</para>
  <para style="q2" vid="PSA 101:4">ani jalʼina wajjin tokkummaa hin qabaadhu.<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Nama dhoksaan ollaa isaa hamatu kam iyyuu,</para>
  <para style="q2" vid="PSA 101:5">ani afaan nan qabachiisa;</para>
  <para style="q1" vid="PSA 101:5">nama tuffiin nama ilaaluu fi kan garaa of tuulu qabuuf,</para>
  <para style="q2" vid="PSA 101:5">ani obsa hin qabaadhu.<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Akka isaan na wajjin jiraataniif,</para>
  <para style="q2" vid="PSA 101:6">iji koo amanamoota biyyattii irra jiraatti;</para>
  <para style="q2" vid="PSA 101:6">namni karaa qajeelaa irra deemu, inni na tajaajila.<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Namni nama gowwoomsu tokko iyyuu</para>
  <para style="q2" vid="PSA 101:7">mana koo keessa hin jiraatu;</para>
  <para style="q1" vid="PSA 101:7">namni soba dubbatu tokko iyyuu</para>
  <para style="q2" vid="PSA 101:7">fuula koo dura hin dhaabatu.<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Ani jalʼoota biyyattii hunda,</para>
  <para style="q2" vid="PSA 101:8">ganama ganama nan barbadeessa;</para>
  <para style="q1" vid="PSA 101:8">warra waan hamaa hojjetan</para>
  <para style="q2" vid="PSA 101:8">magaalaa <char style="nd">Waaqayyoo</char> keessaa nan balleessa.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">Faarfannaa 102</para>
  <para style="ms1">Kadhannaa Yeroo Rakkinaa</para>
  <para style="d">Kadhannaa Namni Dhiphate Tokko Faaruu Booʼichaa Faarsee Fuula <char style="nd">Waaqayyoo</char> Duratti Dhiʼeeffatu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>Yaa <char style="nd">Waaqayyo</char>, kadhannaa koo naa dhagaʼi;</para>
  <para style="q2" vid="PSA 102:1">iyyi ani gargaarsaaf iyyadhus si bira haa gaʼu.<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>Yeroo ani dhiphadhetti,</para>
  <para style="q2" vid="PSA 102:2">fuula kee na duraa hin dhoksin.</para>
  <para style="q1" vid="PSA 102:2">Gurra kee gara kootti deebisi;</para>
  <para style="q2" vid="PSA 102:2">yommuu ani si waammadhu dafiitii deebii naa kenni.<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Barri koo akkuma aaraatti ni badaatii;</para>
  <para style="q2" vid="PSA 102:3">lafeen koos akkuma barbadaa ibiddaa bobaʼaa jira.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>Garaan koo dhukkubsatee akkuma margaa coollageera;</para>
  <para style="q2" vid="PSA 102:4">ani nyaata koo nyaachuu irraanfadheera.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Sababii ani guddisee aaduuf,</para>
  <para style="q2" vid="PSA 102:5">lafeen koo gogaa kootti maxxaneera.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Ani akka urunguu gammoojjii,</para>
  <para style="q2" vid="PSA 102:6">akka urunguu lafa barbadaaʼe keessaa nan taʼe.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Ani hirriba malee nan bula;</para>
  <para style="q2" vid="PSA 102:7">akka simbirroo kophaa ishee guutuu manaa irra jirtuus taʼeera.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Diinonni koo guyyaa guutuu na arrabsu;</para>
  <para style="q2" vid="PSA 102:8">warri natti qoosanis abaarsaaf maqaa kootti fayyadamu.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Ani akkuma buddeenaatti daaraa nyaadheeraattii;</para>
  <para style="q2" vid="PSA 102:9">dhugaatii koottis imimmaan makadheera;<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>kunis sababii aarii fi dheekkamsa keetiitiif natti dhufe;</para>
  <para style="q2" vid="PSA 102:10">ati ol na fuutee gad na darbatteertaatii.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>Barri koo akkuma gaaddidduu galgalaa ti;</para>
  <para style="q2" vid="PSA 102:11">anis akkuma margaa gogeera.<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>Yaa <char style="nd">Waaqayyo</char>, ati bara baraan teessoo irra jirta;</para>
  <para style="q2" vid="PSA 102:12">yaadannoon kees dhaloota hundatti darba.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Ati kaatee Xiyooniif garaa ni laafta;</para>
  <para style="q2" vid="PSA 102:13">yeroon itti isheen fudhatama argachuu qabdu ammumaatii;</para>
  <para style="q2" vid="PSA 102:13">yeroon murteeffame sun gaʼeeraa.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>Garboonni kee dhagaa isheetti gammaduutii;</para>
  <para style="q2" vid="PSA 102:14">biyyoo ishees ni mararfatu.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Saboonni maqaa <char style="nd">Waaqayyoo</char> ni sodaatu;</para>
  <para style="q2" vid="PSA 102:15">mootonni lafaa hundinuus ulfina kee ni kabaju.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>
    <char style="nd">Waaqayyo</char> deebisee Xiyoonin ijaaraatii;</para>
  <para style="q2" vid="PSA 102:16">ulfina isaatiinis ni mulʼata.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>Inni kadhannaa gadadamtootaa ni dhagaʼa;</para>
  <para style="q2" vid="PSA 102:17">waammata isaaniis hin tuffatu.<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Akka sabni hamma ammaatti hin dhalatin <char style="nd">Waaqayyoon</char> galateeffatuuf,</para>
  <para style="q2" vid="PSA 102:18">wanni kun akkana jedhamee dhaloota dhufuuf haa barreeffamu:<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>“<char style="nd">Waaqayyo</char> iddoo qulqullummaa isaa gubbaa irraa gad ilaale;</para>
  <para style="q2" vid="PSA 102:19">samii irraas gara lafaa gad milʼate;<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>kanas aaduu warra hidhamanii dhagaʼuu fi</para>
  <para style="q2" vid="PSA 102:20">warra duuti itti murame baasuudhaaf hojjete.”<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>Akkasiin maqaan <char style="nd">Waaqayyoo</char> Xiyoon keessatti,</para>
  <para style="q2" vid="PSA 102:21">galanni isaas Yerusaalem keessatti ni labsama;<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>kunis yommuu saboonnii fi mootummoonni,</para>
  <para style="q2" vid="PSA 102:22">
    <char style="nd">Waaqayyoon</char> waaqeffachuuf walitti qabamanitti taʼa.<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>Inni jabina koo karaatti hambise;</para>
  <para style="q2" vid="PSA 102:23">umurii koos ni gabaabse.<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>Anis akkanan jedhe:</para>
  <para style="q2" vid="PSA 102:24">“Yaa Waaqa ko, walakkaa umurii kootti na hin fudhatin;</para>
  <para style="q2" vid="PSA 102:24">waggoonni kee dhalootaa hamma dhaloota hundaatti itti fufu.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Ati jalqabatti lafa hundeessite;</para>
  <para style="q2" vid="PSA 102:25">samiiwwanis hojii harka keetii ti.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>Isaan ni badu; ati garuu ni jiraatta;</para>
  <para style="q2" vid="PSA 102:26">hundumti isaanii akkuma wayyaa ni dhumu.</para>
  <para style="q1" vid="PSA 102:26">Ati akkuma uffataa isaan geeddarta;</para>
  <para style="q2" vid="PSA 102:26">isaanis ni badu.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>Ati garuu sanuma;</para>
  <para style="q2" vid="PSA 102:27">umuriin kees gonkumaa dhuma hin qabu.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Ijoolleen garboota keetii sodaa malee jiraatu;</para>
  <para style="q2" vid="PSA 102:28">sanyiin isaaniis fuula kee dura jiraata.”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">Faarfannaa 103</para>
  <para style="ms1">Waaqni Jaalala</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>Yaa lubbuu ko, <char style="nd">Waaqayyoon</char> eebbisi;</para>
  <para style="q2" vid="PSA 103:1">keessi namummaa koo hundi maqaa isaa qulqulluu sana eebbisaa.<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>Yaa lubbuu koo <char style="nd">Waaqayyoon</char> eebbisi;</para>
  <para style="q2" vid="PSA 103:2">tola isaa hundas hin irraanfatin.<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>Inni cubbuu kee hundumaa siif dhiisa;</para>
  <para style="q2" vid="PSA 103:3">dhukkuba kee hundumaa ni fayyisa;<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>jireenya kee boolla irraa ni baraara;</para>
  <para style="q2" vid="PSA 103:4">jaalalaa fi gara laafinaan si gonfa;<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>akka dargaggummaan kee akkuma risaa haaromfamuufis,</para>
  <para style="q2" vid="PSA 103:5">inni fedhii kee waan gaariidhaan ni guuta.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>
    <char style="nd">Waaqayyo</char> warra cunqurfaman</para>
  <para style="q2" vid="PSA 103:6">hundaaf qajeelummaa fi murtii qajeelaa kenna.<verse eid="PSA 103:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>Inni karaa isaa Museetti,</para>
  <para style="q2" vid="PSA 103:7">hojii isaa immoo saba Israaʼelitti beeksise.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>
    <char style="nd">Waaqayyo</char> gara laafessaa fi arjaa dha;</para>
  <para style="q2" vid="PSA 103:8">inni aaruuf hin ariifatu; jaalalli isaas baayʼee dha.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>Inni yeroo hunda hin dheekkamu;</para>
  <para style="q2" vid="PSA 103:9">aarii isaa illee bara baraan hin kuufatu;<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>inni akka cubbuu keenyaatti nu hin adabne;</para>
  <para style="q2" vid="PSA 103:10">yookaan akka balleessaa keenyaatti nuuf hin deebifne.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Akkuma samiiwwan lafa irraa ol fagaatan sana,</para>
  <para style="q2" vid="PSA 103:11">jaalalli inni warra isa sodaataniif qabu akkasuma guddaa dha;<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>akkuma baʼi biiftuu lixa biiftuu irraa fagaatu,</para>
  <para style="q2" vid="PSA 103:12">akkasuma inni balleessaa keenya nurraa haqeera.<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Akkuma abbaan ijoollee isaatiif garaa laafu,</para>
  <para style="q2" vid="PSA 103:13">
    <char style="nd">Waaqayyo</char> warra isa sodaataniif garaa ni laafa;<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>inni akka nu itti uumamne ni beekaatii;</para>
  <para style="q2" vid="PSA 103:14">akka nu biyyoo taanes ni yaadata.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Barri namaa akkuma margaa ti;</para>
  <para style="q2" vid="PSA 103:15">akka abaaboo dirrees ni misa;<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>inni yeroo bubbeen itti bubbisutti ni bada;</para>
  <para style="q2" vid="PSA 103:16">iddoon isaas deebiʼee isa hin yaadatu.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Jaalalli <char style="nd">Waaqayyoo</char> garuu bara baraa hamma bara baraatti</para>
  <para style="q2" vid="PSA 103:17">warra isa sodaatan wajjin ni jiraata;</para>
  <para style="q2" vid="PSA 103:17">qajeelummaan isaa immoo ijoollee ijoollee isaaniitti darba;<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>warra kakuu isaa eeganitti,</para>
  <para style="q2" vid="PSA 103:18">warra ajaja isaatti buluu yaadatanittis ni darba.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>
    <char style="nd">Waaqayyo</char> teessoo isaa samii keessa dhaabbateera;</para>
  <para style="q2" vid="PSA 103:19">mootummaan isaas waan hunda bulcha.<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>Isin ergamoonni isaa, warri ajaja isaa eegdan jajjaboon,</para>
  <para style="q2" vid="PSA 103:20">warri dubbii isaatiif ajajamtanis <char style="nd">Waaqayyoon</char> eebbisaa.<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>Raayyaan isaa hundinuu, isin tajaajiltoonni isaa</para>
  <para style="q2" vid="PSA 103:21">warri fedhii isaa guuttan <char style="nd">Waaqayyoon</char> eebbisaa.<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Uumamawwan bulchiinsa isaa</para>
  <para style="q2" vid="PSA 103:22">jala lafa hunda jirtan hundi <char style="nd">Waaqayyoon</char> eebbisaa.</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q1" vid="PSA 103:22">Yaa lubbuu ko, <char style="nd">Waaqayyoon</char> eebbisi.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">Faarfannaa 104</para>
  <para style="ms1">Ulfina Uumamaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>Yaa lubbuu ko, <char style="nd">Waaqayyoon</char> eebbisi.</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q1" vid="PSA 104:1">Yaa <char style="nd">Waaqayyo</char>, Waaqa ko, ati akka malee guddaa dha;</para>
  <para style="q2" vid="PSA 104:1">miidhaginaa fi surraa uffatteerta.<verse eid="PSA 104:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>Ati akkuma wayyaa ifa uffatta;</para>
  <para style="q2" vid="PSA 104:2">samiiwwanis akkuma dunkaanaa diriirsita.<verse eid="PSA 104:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3"/>Dareeraa diinqa isaa bishaanota irra buufta.</para>
  <para style="q1" vid="PSA 104:3">Duumessoota gaarii isaa godhata;</para>
  <para style="q2" vid="PSA 104:3">qoochoo bubbee yaabbattee deema.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Inni ergamoota isaa hafuurota,</para>
  <para style="q2" vid="PSA 104:4">tajaajiltoota isaa immoo arraba ibiddaa godha.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Inni lafa hundee ishee irra dhaabeera;</para>
  <para style="q2" vid="PSA 104:5">isheenis gonkumaa hin sochootu.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Ati akkuma wayyaatti tuujubaan ishee haguugde;</para>
  <para style="q2" vid="PSA 104:6">bishaanonnis tulluuwwanii ol dhaabatan.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>Ati ifannaan bishaanonni baqatan;</para>
  <para style="q2" vid="PSA 104:7">sagalee qaqawwee keetii dhageenyaan gugatan.<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>Isaan tulluuwwan irraan dhangalaʼan;</para>
  <para style="q2" vid="PSA 104:8">gara iddoo ati isaanii qopheessitee,</para>
  <para style="q2" vid="PSA 104:8">gara sululootaatti gad yaaʼan.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Akka isaan deebiʼanii lafa hin haguugneef</para>
  <para style="q2" vid="PSA 104:9">ati daarii isaan darbuu hin dandeenye isaan dura dhaabde.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Akka burqaawwan sululoota keessa yaaʼan goota;</para>
  <para style="q2" vid="PSA 104:10">isaanis tulluuwwan gidduu yaaʼu.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>Isaan bineensota bakkee hundaaf bishaan kennu;</para>
  <para style="q2" vid="PSA 104:11">harroonni diidaas dheebuu baʼu.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>Simbirroonni samii bishaanota biratti mandhee ijaarratan;</para>
  <para style="q2" vid="PSA 104:12">dameewwan gidduutti ni faarfatan.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Inni mana isaa kan olii irraa tulluuwwan bishaan obaafta;</para>
  <para style="q2" vid="PSA 104:13">laftis ija hojii keetiitiin quufti.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Inni lafa irraa nyaata kennuuf jedhee looniif marga,</para>
  <para style="q2" vid="PSA 104:14">faayidaa namaatiif immoo biqiltuuwwan biqilcha;<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>akka daadhiin wayinii garaa nama gammachiisu,</para>
  <para style="q2" vid="PSA 104:15">akka zayitiin fuula nama cululuqsuu fi</para>
  <para style="q2" vid="PSA 104:15">akka midhaan nama jajjabeessu ni goota.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Mukkeen <char style="nd">Waaqayyoo</char>,</para>
  <para style="q2" vid="PSA 104:16">birbirsi Libaanoon kan inni dhaabe sun bishaan quufaniiru.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>Simbirroonni achitti mandhee isaanii ijaarratu;</para>
  <para style="q2" vid="PSA 104:17">huummoonis birbirsa irraa mana qabdi.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>Tulluuwwan dhedheeroon daʼoo reʼee diidaa ti;</para>
  <para style="q2" vid="PSA 104:18">holqi kattaawwanii immoo daʼoo osolee ti.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Inni akka jiʼi waqtiilee gargar qoodu godha;</para>
  <para style="q2" vid="PSA 104:19">biiftuunis yeroo itti lixxu ni beekti.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Ati dukkana uumta; halkanis ni taʼa;</para>
  <para style="q2" vid="PSA 104:20">bineensonni bosonaa hundis gad yaaʼu.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Leenci saafelli waan nyaatu barbaadee aada;</para>
  <para style="q2" vid="PSA 104:21">nyaata isaas Waaqa bira barbaada.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>Isaan yommuu biiftuun baatutti walitti qabamu;</para>
  <para style="q2" vid="PSA 104:22">dachaʼaniis goda isaanii keessa ciciisu.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>Namni gara hojii isaatti,</para>
  <para style="q2" vid="PSA 104:23">hamma galgalaattis gara jiruu isaatti ni baʼa.<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>Yaa <char style="nd">Waaqayyo</char>, hojiin kee akkam baayʼee dha!</para>
  <para style="q2" vid="PSA 104:24">Ati hunda isaanii ogummaadhaan hojjette;</para>
  <para style="q2" vid="PSA 104:24">laftis uumamawwan keetiin guutamte.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Galaanni guddaa fi balʼaan kun,</para>
  <para style="q2" vid="PSA 104:25">uumamawwan hamma hin qabneen guutame;</para>
  <para style="q2" vid="PSA 104:25">kan lubbuu qabeeyyiin gurguddaa fi <optbreak/> xixinnoon keessa jiraatan kuunnoo jira.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>Dooniiwwan as irra deddeebiʼu;</para>
  <para style="q2" vid="PSA 104:26">lewaataan kan akka inni achi keessa <optbreak/> taphatuuf ati uumtes achi jira.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>Akka ati nyaata isaanii yeroo barbaachisuutti isaaniif kennituuf,</para>
  <para style="q2" vid="PSA 104:27">isaan hundi si eeggatu.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Yeroo ati isaaniif kennitutti,</para>
  <para style="q2" vid="PSA 104:28">isaan walitti qabatu;</para>
  <para style="q1" vid="PSA 104:28">yeroo ati harka kee balʼiftutti,</para>
  <para style="q2" vid="PSA 104:28">isaan waan gaarii quufu.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>Yeroo ati fuula kee dhokfattutti,</para>
  <para style="q2" vid="PSA 104:29">isaan ni naʼu;</para>
  <para style="q1" vid="PSA 104:29">yeroo ati hafuura isaanii fudhattutti,</para>
  <para style="q2" vid="PSA 104:29">isaan duʼanii biyyootti deebiʼu.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Yeroo ati Hafuura kee ergitutti isaan ni uumamu;</para>
  <para style="q2" vid="PSA 104:30">atis fuula lafaa ni haaromsita.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Ulfinni <char style="nd">Waaqayyoo</char> bara baraan haa jiraatu;</para>
  <para style="q2" vid="PSA 104:31">
    <char style="nd">Waaqayyo</char> hojii isaatti haa gammadu;<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>inni ilaallaan lafti hollatte;</para>
  <para style="q2" vid="PSA 104:32">inni tuqnaan tulluuwwan keessaa aarrii baʼe.<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Bara jireenya koo guutuu ani <char style="nd">Waaqayyoof</char> nan faarfadha;</para>
  <para style="q2" vid="PSA 104:33">hamma lubbuun koo jirtuttis faarfannaadhaan <optbreak/> Waaqa koo nan galateeffadha.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Irra deddeebiʼee yaaduun koo isa haa gammachiisu;</para>
  <para style="q2" vid="PSA 104:34">ani <char style="nd">Waaqayyotti</char> nan gammadaatii.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Cubbamoonni lafa irraa haa badan;</para>
  <para style="q2" vid="PSA 104:35">hamoonnis siʼachi hin jiraatin.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Yaa lubbuu koo <char style="nd">Waaqayyoon</char> eebbisi.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Haalleluuyaa.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">Faarfannaa 105</para>
  <para style="ms1">Seenaa Israaʼel Isa Dinqisiisaa</para>
  <para style="mr">
    <ref loc="PSA 105:1-15">105:1‑15</ref> kwf – <char style="xt"><ref loc="1CH 16:8-22">1Sn 16:8‑22</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>
    <char style="nd">Waaqayyoof</char> galata galchaa; maqaa isaas waammadhaa;</para>
  <para style="q2" vid="PSA 105:1">waan inni hojjetes saboota gidduutti beeksisaa.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Isaaf faarfadhaa; faarfannaadhaan isa galateeffadhaa;</para>
  <para style="q2" vid="PSA 105:2">waaʼee hojii isaa isa dinqisiisaa hundaas odeessaa.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Maqaa isaa qulqulluu sanaan boonaa;</para>
  <para style="q2" vid="PSA 105:3">garaan warra <char style="nd">Waaqayyoon</char> barbaadanii haa gammadu.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>
    <char style="nd">Waaqayyoo</char> fi humna isaa barbaaddadhaa;</para>
  <para style="q2" vid="PSA 105:4">yeroo hunda fuula isaa barbaadaa.<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>Dinqii inni hojjete,</para>
  <para style="q2" vid="PSA 105:5">hojii isaa dinqii sanaa fi murtii inni labse yaadadhaa;<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>isin tajaajiltoonni isaa, warri sanyii Abrahaam taatan,</para>
  <para style="q2" vid="PSA 105:6">isin filatamtoonni isaa, ilmaan Yaaqoobis kana yaadadhaa.<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>Inni <char style="nd">Waaqayyo</char> Waaqa keenya;</para>
  <para style="q2" vid="PSA 105:7">murtiin isaas lafa hunda irra jira.<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>Inni kakuu isaa bara baraan,</para>
  <para style="q2" vid="PSA 105:8">waadaa gale sanas dhaloota kumaaf ni yaadata;<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>inni kakuu Abrahaam wajjin gale,</para>
  <para style="q2" vid="PSA 105:9">kakuu Yisihaaqiif kakates ni yaadata.<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>Kanas Yaaqoobiif seera,</para>
  <para style="q2" vid="PSA 105:10">Israaʼeliif immoo kakuu bara baraa godhee <optbreak/> akkana jedhee mirkaneesseera:<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>“Ani biyya Kanaʼaan</para>
  <para style="q2" vid="PSA 105:11">qooda ati dhaaltu godhee siif nan kenna.”<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Isaan yeroo lakkoobsaan xinnoo turanitti,</para>
  <para style="q2" vid="PSA 105:12">dhugumaanuu xinnoo fi biyyattii keessattis <optbreak/> keessummoota turanitti,<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>sabaa gara sabaatti, mootummaa tokkoo gara</para>
  <para style="q2" vid="PSA 105:13">mootummaa biraatti jooran.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>Inni akka namni tokko iyyuu isaan cunqursu hin eeyyamne;</para>
  <para style="q2" vid="PSA 105:14">sababii isaaniitiifis akkana jedhee mootota ifate:<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“Dibamtoota koo hin tuqinaa;</para>
  <para style="q2" vid="PSA 105:15">raajota koos hin miidhinaa.”<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>Inni beela biyyattiitti waame;</para>
  <para style="q2" vid="PSA 105:16">midhaan nyaataa hundas ni balleesse;<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>innis Yoosef namicha akka garbaatti</para>
  <para style="q2" vid="PSA 105:17">gurgurame tokko isaan dura erge.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>Isaan foncaadhaan miilla isaa luqqisan;</para>
  <para style="q2" vid="PSA 105:18">mormi isaas sibiila keessa galfame;<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>hamma wanni inni duraan dursee dubbate guutamutti</para>
  <para style="q2" vid="PSA 105:19">dubbiin <char style="nd">Waaqayyoo</char> isa qore.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>Mootiin nama ergee gad isa dhiisise;</para>
  <para style="q2" vid="PSA 105:20">bulchaan sabaa isa hiiksise.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>Mootichis mana isaa irratti ajajaa,</para>
  <para style="q2" vid="PSA 105:21">qabeenya isaa hunda irratti immoo bulchaa isa godhate;<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>kanas akka inni akkuma fedhetti qondaaltota isaa gorsuuf,</para>
  <para style="q2" vid="PSA 105:22">akka inni maanguddoota isaa ogummaa barsiisuuf godhe.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>Israaʼel biyya Gibxi dhaqe;</para>
  <para style="q2" vid="PSA 105:23">Yaaqoobis akka alagaatti biyya Haam keessa jiraate.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>
    <char style="nd">Waaqayyo</char> saba isaa akka malee baayʼise;</para>
  <para style="q2" vid="PSA 105:24">akka isaan amajaajota isaanii caalaa jabaatanis godhe;<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>innis akka isaan saba isaa jibbanii fi</para>
  <para style="q2" vid="PSA 105:25">akka isaan tajaajiltoota isaatti mariʼataniif yaada isaanii geeddare.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>Waaqnis Musee tajaajilaa isaatii fi</para>
  <para style="q2" vid="PSA 105:26">Aroon filatamaa isaa erge.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Isaanis jara gidduutti mallattoo isaa,</para>
  <para style="q2" vid="PSA 105:27">biyya Haam keessatti immoo dinqii isaa argisiisan.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>Inni dukkana ergee biyyattii dukkaneesse;</para>
  <para style="q2" vid="PSA 105:28">isaan dubbii isaatti fincilaniiruutii.<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>Inni bishaanota isaanii dhiigatti geeddaree</para>
  <para style="q2" vid="PSA 105:29">akka qurxummiiwwan isaanii dhuman godhe.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>Fatteen biyya isaanii guutee</para>
  <para style="q2" vid="PSA 105:30">diinqa mootota isaanii keessa yaaʼe.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>Inni dubbannaan tuunni tisiisaatii fi</para>
  <para style="q2" vid="PSA 105:31">bookeen biyya isaanii hunda keessa guutte.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>Inni qooda bokkaa cabbii isaaniif roobse;</para>
  <para style="q2" vid="PSA 105:32">bakakkaas biyya isaaniitti erge;<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>wayinii isaaniitii fi muka harbuu isaanii balleesse;</para>
  <para style="q2" vid="PSA 105:33">mukkeen biyya isaaniis ni caccabse.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>Inni dubbannaan hawwaannisnii fi</para>
  <para style="q2" vid="PSA 105:34">korophisni hedduun dhufan;<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>isaanis biqiltuu biyya jaraa hunda nyaatan;</para>
  <para style="q2" vid="PSA 105:35">waan lafti isaanii baases ni fixan.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>Ergasii inni hangafa biyya isaanii hunda,</para>
  <para style="q2" vid="PSA 105:36">jabina isaanii jalqabaas ni dhaʼe.<verse eid="PSA 105:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>Akka sabni Israaʼel meetii fi warqee baadhatee baʼu godhe;</para>
  <para style="q2" vid="PSA 105:37">gosa isaanii keessaa namni tokko iyyuu hin gufanne.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>Israaʼeloonni baanaan warri Gibxi gammadan;</para>
  <para style="q2" vid="PSA 105:38">isaan Israaʼelin sodaatanii turaniitii.<verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>Inni akka gaaddisaatti duumessa isaan irra qabe;</para>
  <para style="q2" vid="PSA 105:39">akka halkaniin isaaniif ibsuuf immoo ibidda qabsiiseef.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>Isaan kadhannaan inni dimbiriqqee kenneef;</para>
  <para style="q2" vid="PSA 105:40">buddeena samiitiinis isaan quufse.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>Innis kattaa bane; bishaanis keessaa gad dhangalaʼe;</para>
  <para style="q2" vid="PSA 105:41">akkuma bishaan lagaattis gammoojjii keessaa yaaʼe.<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>Inni waadaa isaa qulqulluu,</para>
  <para style="q2" vid="PSA 105:42">kan garbicha isaa Abrahaamiif gale sana yaadateeraatii.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>Inni saba isaa gammachuun,</para>
  <para style="q2" vid="PSA 105:43">warra isaaf filataman immoo ililleedhaan baaseera;<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>inni biyya ormootaa isaaniif kenne;</para>
  <para style="q2" vid="PSA 105:44">isaanis waan saboonni sun itti dadhaban dhaalan;<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>kanas akka isaan sirna isaa eeganii</para>
  <para style="q2" vid="PSA 105:45">seera isaatiif bulaniif godhe.</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">Haalleluuyaa.<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">Faarfannaa 106</para>
  <para style="ms1">Uummanni Cubbuu Isaa Himate</para>
  <para style="mr">
    <ref loc="PSA 106:1">106:1</ref>,<ref loc="PSA 106:47-48">47‑48</ref> kwf – <char style="xt"><ref loc="1CH 16:34-36">1Sn 16:34‑36</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q1" vid="PSA 106:1">
    <char style="nd">Waaqayyoof</char> galata galchaa; inni gaariidhaatii;</para>
  <para style="q2" vid="PSA 106:1">jaalalli isaa bara baraan jiraata.<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>Eenyutu hojii <char style="nd">Waaqayyoo</char> jabaa sana labsuu,</para>
  <para style="q2" vid="PSA 106:2">yookaan galata isaa guutummaatti odeessuu dandaʼaa?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>Warri jabeessanii murtii qajeelaa eegan,</para>
  <para style="q2" vid="PSA 106:3">warri yeroo hunda waan qajeelaa hojjetan eebbifamoo dha.<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>Yaa <char style="nd">Waaqayyo</char>, yommuu saba keetti faara toltutti na yaadadhu;</para>
  <para style="q2" vid="PSA 106:4">yommuu isaan oolchituttis na gargaari;<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>akka ani badhaadhummaa filatamtoota keetii arguuf,</para>
  <para style="q2" vid="PSA 106:5">akka ani gammachuu saba keetii keessatti hirmaadhee</para>
  <para style="q2" vid="PSA 106:5">dhaala kee wajjin boonuuf na yaadadhu.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Nu akkuma abbootii keenyaa cubbuu hojjenneerra;</para>
  <para style="q2" vid="PSA 106:6">yakka hojjenneerra; hamminas hojjenneerra.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>Abbootiin keenya yeroo biyya Gibxi keessa turanitti,</para>
  <para style="q2" vid="PSA 106:7">dinqii kee hin hubanne;</para>
  <para style="q1" vid="PSA 106:7">baayʼina araara keetiis hin yaadanne;</para>
  <para style="q2" vid="PSA 106:7">isaan galaana biratti, Galaana Diimaa biratti sitti fincilan.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>Taʼus inni akka humni isaa guddaan sun beekamuuf,</para>
  <para style="q2" vid="PSA 106:8">maqaa isaatiif jedhee isaan oolche.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>Inni Galaana Diimaa ifate; galaanichis ni goge;</para>
  <para style="q2" vid="PSA 106:9">akkuma waan gammoojjii keessa dabarsuutti lafa gogaa irra isaan dabarse.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>Harka amajaajii isaanii keessaa isaan baase;</para>
  <para style="q2" vid="PSA 106:10">humna diinaa jalaas isaan fure.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>Bishaanonni diinota isaanii liqimsan;</para>
  <para style="q2" vid="PSA 106:11">tokkoon isaanii iyyuu hin hafne.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>Ergasii isaan dubbii isaa amananii</para>
  <para style="q2" vid="PSA 106:12">faarfannaadhaan isa galateeffatan.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>Isaan garuu yommusuma waan inni hojjetee ture dagatan;</para>
  <para style="q2" vid="PSA 106:13">gorsa isaas obsaan hin eegganne.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>Gammoojjii keessatti dharraa hamaadhaan guutaman;</para>
  <para style="q2" vid="PSA 106:14">lafa onaa keessattis Waaqa qoran.<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>Kanaafuu inni waan isaan kadhatan kenneef;</para>
  <para style="q2" vid="PSA 106:15">garuu dhukkuba nama huqqisu isaanitti erge.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Isaan qubata keessatti Musee fi</para>
  <para style="q2" vid="PSA 106:16">Aroon qulqullicha <char style="nd">Waaqayyootti</char> hinaafan.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Lafti afaan banattee Daataanin liqimsite;</para>
  <para style="q2" vid="PSA 106:17">garee Abiiraamis gad fudhatte.<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Duuka buutoota isaanii gidduutti ibiddi bobaʼe;</para>
  <para style="q2" vid="PSA 106:18">arrabni ibiddaas hamoota fixe.<verse eid="PSA 106:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>Isaan Kooreebitti jabbii tolfatan;</para>
  <para style="q2" vid="PSA 106:19">fakkii baqfamee tolfames waaqeffatan.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Isa Ulfina isaanii taʼe sana,</para>
  <para style="q2" vid="PSA 106:20">fakkii sangaa marga dheeduutti geeddaran.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Waaqa isaan fayyise,</para>
  <para style="q2" vid="PSA 106:21">isa biyya Gibxitti waan gurguddaa hojjete sana irraanfatan.<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>Dinqii inni biyya Haam keessatti hojjete,</para>
  <para style="q2" vid="PSA 106:22">hojii sodaachisaa inni Galaana Diimaa irratti hojjetes ni irraanfatan.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Kanaafuu utuu filatamaan isaa Museen</para>
  <para style="q2" vid="PSA 106:23">akka dheekkamsi Waaqaa isaan hin balleessineef</para>
  <para style="q1" vid="PSA 106:23">gidduu galee fuula isaa dura dhaabachuu baatee silaa</para>
  <para style="q2" vid="PSA 106:23">Waaqni akka isaan balleessu dubbatee ture.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Isaanis biyya namatti tolu sana tuffatan;</para>
  <para style="q2" vid="PSA 106:24">waadaa Waaqni gales hin amanne.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>Dunkaanota isaanii keessatti ni guunguman;</para>
  <para style="q2" vid="PSA 106:25">
    <char style="nd">Waaqayyoofis</char> hin ajajamne.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Kanaafuu inni akka gammoojjii keessatti</para>
  <para style="q2" vid="PSA 106:26">isaan gatu harka isaa ol qabatee kakate;<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>sanyii isaanii akka saboota gidduutti gatu,</para>
  <para style="q2" vid="PSA 106:27">biyyoota hunda keessas akka isaan bittinneessu kakate.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Isaan Baʼaal Pheʼooritti of kennanii</para>
  <para style="q2" vid="PSA 106:28">aarsaa waaqota lubbuu hin qabneef dhiʼeeffame nyaatan.<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>Hojii isaanii hamaa sanaan <optbreak/> <char style="nd">Waaqayyoon</char> dheekkamsaaf kakaasan;</para>
  <para style="q2" vid="PSA 106:29">dhaʼichis isaan irra buʼe.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Garuu Fiinehaas kaʼee gidduu seennaan</para>
  <para style="q2" vid="PSA 106:30">dhaʼichi sun dhaabate.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Kunis dhalootaa hamma dhalootaatti,</para>
  <para style="q2" vid="PSA 106:31">akka qajeelummaatti isaaf herregame.<verse eid="PSA 106:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Isaan bishaan Mariibaa biratti akka <char style="nd">Waaqayyo</char> aaru godhan.</para>
  <para style="q2" vid="PSA 106:32">Museenis sababii isaaniitiif rakkate;<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>sababii isaan Hafuura Waaqaatti fincilaniif</para>
  <para style="q2" vid="PSA 106:33">Museen utuu itti hin yaadin dubbate.<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Isaan akka <char style="nd">Waaqayyo</char> isaan ajajetti,</para>
  <para style="q2" vid="PSA 106:34">saboota hin balleessine;<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>isaan garuu ormootatti makamanii</para>
  <para style="q2" vid="PSA 106:35">duudhaa isaanii baratan.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Waaqota isaanii tolfamoo,</para>
  <para style="q2" vid="PSA 106:36">kanneen kiyyoo isaanitti taʼan waaqeffatan.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Ilmaan isaaniitii fi intallan isaanii</para>
  <para style="q2" vid="PSA 106:37">aarsaa godhanii hafuurota hamoof dhiʼeessan.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Isaanis dhiiga warra balleessaa hin qabnee,</para>
  <para style="q2" vid="PSA 106:38">dhiiga ilmaan isaaniitii fi intallan isaanii,</para>
  <para style="q1" vid="PSA 106:38">kan waaqota tolfamoo Kanaʼaaniif</para>
  <para style="q2" vid="PSA 106:38">aarsaa godhanii dhiʼeessan sana dhangalaasan;</para>
  <para style="q2" vid="PSA 106:38">biyyattiinis dhiiga isaaniitiin faalamte.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Isaan waanuma hojjetaniin of xureessan;</para>
  <para style="q2" vid="PSA 106:39">hojii isaaniitiin sagaagaltoota of taasisan.<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>Kanaafuu <char style="nd">Waaqayyo</char> saba isaatti aare;</para>
  <para style="q2" vid="PSA 106:40">handhuuraa isaas ni balfe.<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>Inni dabarsee ormootatti isaan kenne;</para>
  <para style="q2" vid="PSA 106:41">amajaajonni isaaniis of jalatti isaan bulchan.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Diinonni isaanii isaan cunqursan;</para>
  <para style="q2" vid="PSA 106:42">humna isaanii jalas isaan galfatan.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>Inni yeroo baayʼee isaan baraare;</para>
  <para style="q2" vid="PSA 106:43">isaan garuu ittuma fufanii fincilan;</para>
  <para style="q2" vid="PSA 106:43">ittuma caalchisaniis cubbuu hojjetan.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Inni garuu yommuu iyya isaanii dhagaʼetti,</para>
  <para style="q2" vid="PSA 106:44">rakkina isaanii hubate;<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>isaaniif jedhee kakuu isaa yaadate;</para>
  <para style="q2" vid="PSA 106:45">sababii jaalala isaa guddaa sanaatiif garaa laafeef.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Inni akka warri isaan boojiʼan hundinuu</para>
  <para style="q2" vid="PSA 106:46">garaa isaaniif laafaniif godhe.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>Yaa <char style="nd">Waaqayyo</char>, Waaqa keenya nu oolchi;</para>
  <para style="q2" vid="PSA 106:47">akka nu maqaa kee qulqulluu sana galateeffannuuf,</para>
  <para style="q1" vid="PSA 106:47">akka galata keetiin of jajnuufis,</para>
  <para style="q2" vid="PSA 106:47">ormoota keessaa walitti nu qabi.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>
    <char style="nd">Waaqayyo</char>, Waaqa Israaʼeliitiif,</para>
  <para style="q2" vid="PSA 106:48">bara baraa hamma bara baraatti galanni haa gaʼu.</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Namni hundinuu “Ameen!” haa jedhu.</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Haalleluuyaa!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">Kitaaba Shanaffaa</para>
  <para style="mr">
    <ref loc="PSA 107-150">Faarfannaa 107–150</ref></para>
  <para style="cl">Faarfannaa 107</para>
  <para style="ms1">Waaqa Rakkina Hunda Keessaa Nama Baasu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>
    <char style="nd">Waaqayyoof</char> galata galchaa; inni gaariidhaatii;</para>
  <para style="q2" vid="PSA 107:1">jaalalli isaa bara baraan jiraata.<verse eid="PSA 107:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Warri <char style="nd">Waaqayyo</char> isaan fure,</para>
  <para style="q2" vid="PSA 107:2">warri inni harka diinaatii baase,<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>warri inni biyya gara garaatii,</para>
  <para style="q2" vid="PSA 107:3">baʼaa fi lixa biiftuutii, kaabaa fi kibbaa walitti qabe waan kana haa dubbatan.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Isaan keessaa tokko tokko gammoojjii goggogaa keessa jooran;</para>
  <para style="q2" vid="PSA 107:4">magaalaa keessa jiraachuu dandaʼanis hin arganne.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Isaan ni beelaʼan; ni dheebotanis;</para>
  <para style="q2" vid="PSA 107:5">lubbuun isaaniis isaan keessatti gaggabde.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Isaan rakkina isaanii keessatti <char style="nd">Waaqayyotti</char> iyyatan;</para>
  <para style="q2" vid="PSA 107:6">innis dhiphina isaanii keessaa isaan baase.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>Inni hamma isaan magaalaa keessa jiraachuu dandaʼan gaʼanitti</para>
  <para style="q2" vid="PSA 107:7">karaa qajeelaa irra isaan qajeelche.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>Isaan sababii jaalala isaa kan hin geeddaramne sanaatii fi</para>
  <para style="q2" vid="PSA 107:8">hojii dinqii kan inni ilmaan namaatiif hojjete sanaatiif <optbreak/> <char style="nd">Waaqayyoon</char> haa galateeffatan;<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>inni warra dheebotan dheebuu baasee</para>
  <para style="q2" vid="PSA 107:9">warra beelaʼan illee waan gaariidhaan quufsaatii.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Isaan keessaas tokko tokko sibiilaan hidhamanii rakkachaa,</para>
  <para style="q2" vid="PSA 107:10">dukkanaa fi dimimmisa keessa jiraatan;<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>isaan dubbii Waaqaatti fincilanii</para>
  <para style="q2" vid="PSA 107:11">gorsa Waaqa Waan Hundaa Oliis tuffataniiruutii.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>Kanaafuu inni dabarsee hojii dadhabsiisaatti isaan kenne;</para>
  <para style="q2" vid="PSA 107:12">isaanis ni gufatan; namni isaan gargaaru tokko iyyuu hin argamne.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Isaan rakkina isaanii keessatti <char style="nd">Waaqayyotti</char> iyyatan;</para>
  <para style="q2" vid="PSA 107:13">innis dhiphina isaanii keessaa isaan baase.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>Inni dukkanaa fi dimimmisa keessaa isaan baase;</para>
  <para style="q2" vid="PSA 107:14">foncaa isaanis gargar kukkute.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>Isaan sababii jaalala isaa kan hin geeddaramne sanaatii fi</para>
  <para style="q2" vid="PSA 107:15">hojii dinqii kan inni ilmaan namaatiif hojjete sanaatiif <optbreak/> <char style="nd">Waaqayyoon</char> haa galateeffatan;<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>inni balbalawwan naasii caccabsee</para>
  <para style="q2" vid="PSA 107:16">danqaraawwan sibiilaa illee kukkutaatii.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Isaan keessaa tokko tokko cubbuu mataa isaaniitiin gowwooman;</para>
  <para style="q2" vid="PSA 107:17">sababii balleessaa isaaniitiifis gadadoo keessa seenan.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Isaan nyaata gosa kamii iyyuu balfanii</para>
  <para style="q2" vid="PSA 107:18">afaan boolla duʼaa gaʼan.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Rakkina isaanii keessatti <char style="nd">Waaqayyotti</char> iyyatan;</para>
  <para style="q2" vid="PSA 107:19">innis dhiphina isaanii keessaa isaan baase.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>Inni dubbii isaa ergee isaan fayyise;</para>
  <para style="q2" vid="PSA 107:20">awwaala keessaas isaan baase.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Isaan sababii jaalala isaa kan hin geeddaramne sanaatii fi</para>
  <para style="q2" vid="PSA 107:21">hojii dinqii kan inni ilmaan namaatiif hojjete sanaatiif, <optbreak/> <char style="nd">Waaqayyoon</char> haa galateeffatan!<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Aarsaa galataa haa dhiʼeessan;</para>
  <para style="q2" vid="PSA 107:22">faarfannaa gammachuutiinis hojii isaa haa himan.<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Isaan keessaa tokko tokko dooniidhaan galaana irra deemanii</para>
  <para style="q2" vid="PSA 107:23">bishaanota gurguddaa irratti daldalan.<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>Isaanis hojii <char style="nd">Waaqayyootii</char> fi</para>
  <para style="q2" vid="PSA 107:24">hojii isaa dinqisiisaa sana tuujuba keessatti argan.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>Inni dubbatee bubbee jabaa</para>
  <para style="q2" vid="PSA 107:25">dambalii galaanaa ol fuudhu tokko kaaseeraatii.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Isaan samiitti ol baʼanii tuujubatti gad buʼan;</para>
  <para style="q2" vid="PSA 107:26">rakkina isaanii keessattis abdii kutatan.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Akka nama machaaʼee daddarbatamanii gatantaran</para>
  <para style="q2" vid="PSA 107:27">ogummaan isaanis faayidaa dhabe.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Isaan rakkina isaanii keessatti <char style="nd">Waaqayyotti</char> iyyatan;</para>
  <para style="q2" vid="PSA 107:28">innis dhiphina isaanii keessaa isaan baase.<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>Inni akka dambaliin sun qabbanaaʼuuf</para>
  <para style="q2" vid="PSA 107:29">dhaʼaa galaanaa calʼisiise.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Isaan waan dambalii fi dhaʼaan galaanaa sun calʼisaniif ni gammadan;</para>
  <para style="q2" vid="PSA 107:30">haala kanaanis gara qubata doonii barbaadaniitti isaan geesse.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Isaan sababii jaalala isaa kan hin geeddaramne sanaatii fi</para>
  <para style="q2" vid="PSA 107:31">hojii dinqii kan inni ilmaan namaatiif hojjete sanaatiif <optbreak/> <char style="nd">Waaqayyoon</char> haa galateeffatan.<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Waldaa namootaa keessatti isa haa leellisan;</para>
  <para style="q2" vid="PSA 107:32">wal gaʼii maanguddootaa keessattis isa haa jajan.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Innis lagoota gammoojjii taasisee</para>
  <para style="q2" vid="PSA 107:33">burqaawwan bishaanis gara lafa goggogaatti geeddare;<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>sababii hammina warra achi jiraataniitiif,</para>
  <para style="q2" vid="PSA 107:34">biyya midhaan baasu lafa soogiddaa taasise.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>Gammoojjii kuusaa bishaaniitti,</para>
  <para style="q2" vid="PSA 107:35">lafa goggogaa immoo burqaa bishaaniitti geeddare;<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>inni akka warri beelaʼan achi jiraatan godhe;</para>
  <para style="q2" vid="PSA 107:36">isaanis magaalaa keessa jiraatan ijaarratan.<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>Lafa qotiisaa isaanii facaafatanii wayiniis ni dhaabbatan;</para>
  <para style="q2" vid="PSA 107:37">midhaan gaariis argatan.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>Inni isaan eebbise; baayʼina isaaniis akka malee dabale;</para>
  <para style="q2" vid="PSA 107:38">akka loon isaanii lakkoobsaan yarachaa deeman hin goone.<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Yeroo isaan cunqursaadhaan, rakkinaa fi</para>
  <para style="q2" vid="PSA 107:39">gaddaan xinnaatanii gad deebiʼanitti,<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>inni namoota bebeekamoo irratti tuffii roobsee</para>
  <para style="q2" vid="PSA 107:40">akka isaan gammoojjii karaa hin qabne keessa jooran godhe.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>Inni garuu rakkattoota dhiphina isaanii keessaa baase;</para>
  <para style="q2" vid="PSA 107:41">maatii isaanis akkuma bushaayee baayʼise.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Qajeeltonni waan kana arganii ililchu;</para>
  <para style="q2" vid="PSA 107:42">hamoonni hundinuu garuu afaan qabatu.<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Ogeessi kam iyyuu waan kana yaadatti haa qabatu;</para>
  <para style="q2" vid="PSA 107:43">jaalala <char style="nd">Waaqayyoo</char> kan dhuma hin qabne sana illee haa hubatu.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">Faarfannaa 108</para>
  <para style="ms1">Faarfannaa Ganamaatii Fi Kadhannaa Biyyoolessaa</para>
  <para style="mr">
    <ref loc="PSA 108:1-5">108:1‑5</ref> kwf – <char style="xt"><ref loc="PSA 57:7-11">Far 57:7‑11</ref></char></para>
  <para style="mr">
    <ref loc="PSA 108:6-13">108:6‑13</ref> kwf – <char style="xt"><ref loc="PSA 60:5-12">Far 60:5‑12</ref></char></para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>Yaa Waaqi, garaan koo hin raafamu; ani nan faarfadha;</para>
  <para style="q2" vid="PSA 108:1">lubbuu koo guutuudhaanis sin galateeffadha.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>Yaa kiraaraa fi baganaa dammaqaa!</para>
  <para style="q2" vid="PSA 108:2">Anis ganamaan nan dammaqa.<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>Yaa <char style="nd">Waaqayyo</char>, ani saboota gidduutti galata siif nan galcha;</para>
  <para style="q2" vid="PSA 108:3">namoota gidduuttis waaʼee kee nan faarfadha.<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>Jaalalli kee guddaa dha; samiiwwanis caalaa ol dheeraadhaatii;</para>
  <para style="q2" vid="PSA 108:4">amanamummaan kees samiiwwan qaqqaba.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>Yaa Waaqi, ati samiiwwaniin olitti ol ol jedhi;</para>
  <para style="q2" vid="PSA 108:5">ulfinni kees lafa hunda irra haa jiraatu.<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>Akka warri ati jaallattu furamaniif,</para>
  <para style="q2" vid="PSA 108:6">harka kee mirgaatiin nu oolchi; nu gargaaris;<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>Waaqni iddoo qulqullummaa isaatii akkana jedhee dubbateera:</para>
  <para style="q2" vid="PSA 108:7">“Ani gammachuudhaan Sheekemin gargar nan qooda;</para>
  <para style="q2" vid="PSA 108:7">Sulula Sukootis nan safara.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Giliʼaad kan koo ti; Minaaseenis kan koo ti;</para>
  <para style="q2" vid="PSA 108:8">Efreem gonfoo sibiilaa koo ti;</para>
  <para style="q2" vid="PSA 108:8">Yihuudaanis bokkuu mootummaa koo ti.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Moʼaab caabii dhiqannaa koo ti;</para>
  <para style="q2" vid="PSA 108:9">Edoom irra kophee koo darbadhee nan buusa;</para>
  <para style="q2" vid="PSA 108:9">Filisxeem irrattis moʼannaadhaan nan geerara.”<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>Eenyutu magaalaa jabeeffamtee ijaaramtetti na fida?</para>
  <para style="q2" vid="PSA 108:10">Eenyutu Edoomitti na geessa?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>Yaa Waaqi kan nu gatte,</para>
  <para style="q2" vid="PSA 108:11">kan loltoota keenya wajjin baʼuu diddes suma mitii?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>Diina keenya of irraa dhowwuu nu gargaar,</para>
  <para style="q2" vid="PSA 108:12">gargaarsi namaa faayidaa hin qabuutii.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Nu Waaqa wajjin ni moʼanna;</para>
  <para style="q2" vid="PSA 108:13">innis diinota keenya gad dhidhiita.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">Faarfannaa 109</para>
  <para style="ms1">Kadhannaa Haaloo Baasuuf Dhiʼaate</para>
  <para style="d">Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>Yaa Waaqa ani galateeffadhu</para>
  <para style="q2" vid="PSA 109:1">ati hin calʼisin;<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>namoonni hamoonnii fi gowwoomsitoonni,</para>
  <para style="q2" vid="PSA 109:2">afaan isaanii natti banatanii jiruutii;</para>
  <para style="q2" vid="PSA 109:2">isaan arraba sobaatiin maqaa na balleessaniiru.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Isaan dubbii jibbaatiin na marsan;</para>
  <para style="q2" vid="PSA 109:3">sababii tokko malees na lolan.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>Utuma ani isaan jaalladhuu na himatan;</para>
  <para style="q2" vid="PSA 109:4">ani garuu nan kadhadha.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Qooda waan gaarii hammina,</para>
  <para style="q2" vid="PSA 109:5">qooda jaalala koo immoo jibba naa deebisan.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Akka inni isa mormuuf nama itti ramadi;</para>
  <para style="q2" vid="PSA 109:6">seexannis karaa mirga isaa haa dhaabatu.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Yommuu qoratamutti isatti haa muramu;</para>
  <para style="q2" vid="PSA 109:7">kadhannaan isaas cubbuu isatti haa taʼu.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>Umuriin isaa haa gabaabbatu,</para>
  <para style="q2" vid="PSA 109:8">aangoo isaa namni biraa haa fudhatu.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Ijoolleen isaa abbaa malee haa hafan;</para>
  <para style="q2" vid="PSA 109:9">niitiin isaas haadha hiyyeessaa haa taatu.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Ijoolleen isaa kadhattoota asii fi achi jooran haa taʼan;</para>
  <para style="q2" vid="PSA 109:10">mana isaanii diigamaa keessaa illee haa ariʼaman.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Waan inni qabu hunda namni isa irraa liqii qabu haa fudhatu;</para>
  <para style="q2" vid="PSA 109:11">buʼaa dadhabbii isaa illee karaa adeemtonni haa saaman.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Namni tokko iyyuu isaaf hin naʼin,</para>
  <para style="q2" vid="PSA 109:12">yookaan ijoollee isaa kanneen abbaa hin qabneef garaa hin laafin.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Sanyiin isaa haa dhumu;</para>
  <para style="q2" vid="PSA 109:13">maqaan isaanii dhaloota itti aanu keessaa haa balleeffamu.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Balleessaan abbootii isaa fuula <char style="nd">Waaqayyoo</char> duratti haa yaadatamu;</para>
  <para style="q2" vid="PSA 109:14">cubbuun haadha isaas hin haqamin.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Akka inni seenaa isaanii lafa irraa balleessuuf,</para>
  <para style="q2" vid="PSA 109:15">cubbuun isaanii yeroo hunda fuula <char style="nd">Waaqayyoo</char> dura haa jiraatu.<verse eid="PSA 109:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>Inni hiyyeeyyii fi rakkattoota,</para>
  <para style="q2" vid="PSA 109:16">warra garaan isaanii madaaʼes hamma duʼaatti gugse malee</para>
  <para style="q2" vid="PSA 109:16">garaa isaaniif laafuu hin yaadneetii.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>Inni abaaruu jaallate;</para>
  <para style="q2" vid="PSA 109:17">abaarsi sun isumatti haa deebiʼu;</para>
  <para style="q1" vid="PSA 109:17">inni eebbisuu hin jaallanne;</para>
  <para style="q2" vid="PSA 109:17">eebbis isa irraa haa fagaatu.<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Inni akkuma uffata isaatti abaarsa uffata;</para>
  <para style="q2" vid="PSA 109:18">abaarsis akkuma bishaanii dhagna isaa seena;</para>
  <para style="q2" vid="PSA 109:18">akkuma zayitiis lafee isaa lixa.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>Abaarsi sun akkuma uffata inni ittiin of haguuguu,</para>
  <para style="q2" vid="PSA 109:19">sabbata inni yeroo hunda hidhatuus isatti haa taʼu.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Kaffaltiin <char style="nd">Waaqayyo</char> warra na himatanii fi</para>
  <para style="q2" vid="PSA 109:20">warra jireenya koo irratti waan hamaa dubbataniif kaffalu kanuma haa taʼu.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>Yaa <char style="nd">Waaqayyo</char> Gooftaa,</para>
  <para style="q2" vid="PSA 109:21">ati garuu maqaa keetiif jedhii na gargaar;</para>
  <para style="q2" vid="PSA 109:21">gaarummaa jaalala keetiitiif jedhiitii na oolchi.<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>Ani hiyyeessaa fi rakkataadhaatii;</para>
  <para style="q2" vid="PSA 109:22">garaan koos na keessatti madaaʼeera.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Ani akkuma gaaddidduu galgalaa badeera;</para>
  <para style="q2" vid="PSA 109:23">akkuma hawwaannisaas olii gad oofameera.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Jilbi koo soomuudhaan dadhabeera;</para>
  <para style="q2" vid="PSA 109:24">dhagni koos huqqatee lafeetti baʼeera.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>Ani warra na himatan biratti waan tuffii taʼeera;</para>
  <para style="q2" vid="PSA 109:25">isaan yommuu na argan mataa isaanii raasu.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>Yaa <char style="nd">Waaqayyo</char> Waaqa ko, na gargaari;</para>
  <para style="q2" vid="PSA 109:26">akkuma jaalala keetiittis na oolchi.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>Yaa <char style="nd">Waaqayyo</char>, akka wanni kun harka kee taʼe,</para>
  <para style="q2" vid="PSA 109:27">akka ati waan kana hojjette isaan haa beekan.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Isaan ni abaaru; ati garuu ni eebbifta;</para>
  <para style="q2" vid="PSA 109:28">yommuu natti kaʼan isaan ni qaanaʼu;</para>
  <para style="q2" vid="PSA 109:28">tajaajilaan kee garuu ni gammada.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Himattoonni koo salphina haa uffatan;</para>
  <para style="q2" vid="PSA 109:29">akkuma nama waaroo uffatuutti qaaniidhaan haa haguugaman.<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Ani afaan kootiin guddisee <char style="nd">Waaqayyoon</char> nan galateeffadha;</para>
  <para style="q2" vid="PSA 109:30">waldaa guddaa gidduuttis isa nan jajadha.<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>Innis warra lubbuu isaatti muran jalaa isa baasuuf jedhee,</para>
  <para style="q2" vid="PSA 109:31">karaa harka mirga rakkataatiin dhaabataatii.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">Faarfannaa 110</para>
  <para style="ms1">
    <char style="nd">Waaqayyo</char> Mootiidhaaf Ol aantummaa Kennuu Isaa</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>
    <char style="nd">Waaqayyo</char>, gooftaa kootiin:</para>
  <para style="b" vid="PSA 110:1"/>
  <para style="q1" vid="PSA 110:1">“Hamma ani diinota kee ejjeta miilla keetii godhutti,</para>
  <para style="q2" vid="PSA 110:1">karaa mirga koo taaʼi” jedhe.<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>
    <char style="nd">Waaqayyo</char>, “Diinota kee gidduutti moʼi” jedhee</para>
  <para style="q2" vid="PSA 110:2">bokkuu aangoo keetii Xiyoonii siif erga.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Gaafa ati waraanaaf baatu,</para>
  <para style="q2" vid="PSA 110:3">loltoonni kee fedhee isaaniitiin si faana qajeelu.</para>
  <para style="q1" vid="PSA 110:3">Ati gadameessa ganamaa keessaa,</para>
  <para style="q2" vid="PSA 110:3">surraa qulqulluu gonfattee fixeensa dargaggummaa keetii qabaatta.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>
    <char style="nd">Waaqayyo</char>, “Akka sirna Malkiiseedeqitti,</para>
  <para style="q2" vid="PSA 110:4">ati luba bara baraa ti” jedhee kakateera.</para>
  <para style="q2" vid="PSA 110:4">Inni yaada isaa hin geeddaru.<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>Gooftaan karaa harka kee mirgaa jira;</para>
  <para style="q2" vid="PSA 110:5">inni guyyaa dheekkamsa isaatti mootota ni burkuteessa.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>Inni reeffa tuuluudhaan, bulchitoota guutummaa lafaa</para>
  <para style="q2" vid="PSA 110:6">barbadeessuudhaan sabootatti mura.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Innis laga karaa cina jiru keessaa ni dhuga;</para>
  <para style="q2" vid="PSA 110:7">kanaafuu mataa ol qabata.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">Faarfannaa 111</para>
  <para style="ms1">Hojii <char style="nd">Waaqayyoo</char> Dinqisiifachuu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">Ani waldaa tolootaatii fi wal gaʼii keessatti,</para>
  <para style="q2" vid="PSA 111:1">garaa koo guutuudhaan <char style="nd">Waaqayyoon</char> nan galateeffadha.<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>Hojiin <char style="nd">Waaqayyoo</char> guddaa dha;</para>
  <para style="q2" vid="PSA 111:2">warri itti gammadan hundinuus irra deddeebiʼanii yaadan.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Hojiin isaa surra qabeessaa fi kabajamaa dha;</para>
  <para style="q2" vid="PSA 111:3">qajeelummaan isaas bara baraan jiraata.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Inni akka dinqiin isaa yaadatamu godheera;</para>
  <para style="q2" vid="PSA 111:4">
    <char style="nd">Waaqayyo</char> arjaa fi gara laafessa.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Inni warra isa sodaataniif nyaata kenna;</para>
  <para style="q2" vid="PSA 111:5">kakuu isaas bara baraan ni yaadata.<verse eid="PSA 111:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Lafa saboota kaanii isaaniif</para>
  <para style="q2" vid="PSA 111:6">kennuudhaan humna hojii isaa saba isaatti mulʼiseera.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Hojiin harka isaa amanamaa fi qajeelaa dha;</para>
  <para style="q2" vid="PSA 111:7">ajajni isaa hundinuus amanamaa dha.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>Isaanis bara baraa hamma bara baraatti jabaatanii dhaabatu;</para>
  <para style="q2" vid="PSA 111:8">amanamummaa fi qajeelummaadhaanis hojjetamu.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>Inni saba isaatiif furii ergeera;</para>
  <para style="q2" vid="PSA 111:9">kakuu isaas bara baraan ajajeera;</para>
  <para style="q2" vid="PSA 111:9">maqaan isaa qulqulluu fi sodaachisaa dha.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>
    <char style="nd">Waaqayyoon</char> sodaachuun jalqaba ogummaa ti;</para>
  <para style="q2" vid="PSA 111:10">warri sirna isaa faana buʼan hundinuu hubannaa gaarii qabu.</para>
  <para style="q2" vid="PSA 111:10">Galanni isaa bara baraan jiraata.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">Faarfannaa 112</para>
  <para style="ms1">Eebbifamuu Nama Qajeelaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">Namni <char style="nd">Waaqayyoon</char> sodaatu,</para>
  <para style="q2" vid="PSA 112:1">kan ajaja isaatti baayʼee gammadu eebbifamaa dha.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Sanyiin isaa lafa irratti jabaa taʼa;</para>
  <para style="q2" vid="PSA 112:2">dhaloonni tolootaa ni eebbifama.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Qabeenyii fi badhaadhummaan mana isaa keessa jira;</para>
  <para style="q2" vid="PSA 112:3">qajeelummaan isaas bara baraan jiraata.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Nama tolaa fi arjaadhaaf,</para>
  <para style="q2" vid="PSA 112:4">gara laafessaa fi qajeelaaf, <optbreak/> dukkana keessatti iyyuu ifni ni baʼa.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Nama arjaa fi nama waa namaa liqeessuuf,</para>
  <para style="q2" vid="PSA 112:5">nama hojii isaa qajeelummaadhaan adeemsifatuuf <optbreak/> waan gaariitu taʼa.<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Dhugumaan inni gonkumaa hin raafamu;</para>
  <para style="q2" vid="PSA 112:6">namni qajeelaan bara baraan yaadatama.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Inni oduu hamaa hin sodaatu;</para>
  <para style="q2" vid="PSA 112:7">garaan isaas <char style="nd">Waaqayyoon</char> amanachuudhaan <optbreak/> jabaatee dhaabata.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Garaan isaa hin raafamu; hin sodaatus;</para>
  <para style="q2" vid="PSA 112:8">dhuma irrattis diinota isaa moʼata.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>Inni ni bittinneesse; hiyyeeyyiifis ni kenne;</para>
  <para style="q2" vid="PSA 112:9">qajeelummaan isaa bara baraan ni jiraata;</para>
  <para style="q2" vid="PSA 112:9">gaanfi isaas ulfinaan ol qabama.<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Namni hamaan waan kana argee aara;</para>
  <para style="q2" vid="PSA 112:10">ilkaan isaa qara; baqees ni bada;</para>
  <para style="q2" vid="PSA 112:10">hawwiin hamootaa faayidaa malee hafa.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">Faarfannaa 113</para>
  <para style="ms1">Galata <char style="nd">Waaqayyoof</char> Dhiʼeeffame</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 113:1"/>
  <para style="q1" vid="PSA 113:1">Yaa tajaajiltoota <char style="nd">Waaqayyoo</char>, galata galchaa;</para>
  <para style="q2" vid="PSA 113:1">maqaa <char style="nd">Waaqayyoo</char> jajadhaa.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>Ammaa hamma bara baraatti</para>
  <para style="q2" vid="PSA 113:2">maqaan <char style="nd">Waaqayyoo</char> haa eebbifamu.<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>Baʼa biiftuutii hamma lixa biiftuutti,</para>
  <para style="q2" vid="PSA 113:3">maqaan <char style="nd">Waaqayyoo</char> haa jajamu.<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>
    <char style="nd">Waaqayyo</char> saba hundaa ol jira;</para>
  <para style="q2" vid="PSA 113:4">ulfinni isaas samiiwwanii ol.<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>Kan akka <char style="nd">Waaqayyo</char> Waaqa keenya</para>
  <para style="q2" vid="PSA 113:5">isa gubbaa teessoo isaa irra taaʼu sanaa eenyu?<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>Kan gad jedhee</para>
  <para style="q2" vid="PSA 113:6">samii fi lafa ilaalu eenyu?<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>Inni hiyyeessa awwaara keessaa ni kaasa;</para>
  <para style="q2" vid="PSA 113:7">rakkataas tuulaa daaraa keessaa ol fuudha;<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>inni bulchitoota gidduu,</para>
  <para style="q2" vid="PSA 113:8">bulchitoota saba isaa gidduus isaan teessisa.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Inni akkuma haadha ijoollee kan gammachuudhaan jiraattuutti,</para>
  <para style="q2" vid="PSA 113:9">dubartii maseena mana ishee keessa ni jiraachisa.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q1" vid="PSA 113:9">Haalleluuyaa.<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">Faarfannaa 114</para>
  <para style="ms1">Faarfannaa Faasiikaaf Dhiʼeeffamu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>Yeroo sabni Israaʼel biyya Gibxii, manni Yaaqoobis</para>
  <para style="q2" vid="PSA 114:1">saba afaan ormaa dubbatu keessaa baʼetti,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Yihuudaan mana qulqullummaa Waaqaa,</para>
  <para style="q2" vid="PSA 114:2">Israaʼel immoo bulchiinsa isaa taʼe.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>Galaanni argee baqate;</para>
  <para style="q2" vid="PSA 114:3">Yordaanosis duubatti deebiʼe;<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>tulluuwwan akka korbeeyyii hoolaa,</para>
  <para style="q2" vid="PSA 114:4">gaarranis akkuma xobbaallaawwan hoolaa burraaqan.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>Yaa galaana, ati maaliif baqatte?</para>
  <para style="q2" vid="PSA 114:5">Yaa Yordaanos, atis maaliif duubatti deebite?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>Yaa tulluuwwan, isin maaliif akka korbeeyyii hoolaa,</para>
  <para style="q2" vid="PSA 114:6">yaa gaarran isinis maaliif akka xobbaallaawwan hoolaa burraaqxu?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>Yaa lafa, fuula Gooftaa duratti,</para>
  <para style="q2" vid="PSA 114:7">fuula Waaqa Yaaqoob duratti holladhu;<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>inni kattaa gara harootti,</para>
  <para style="q2" vid="PSA 114:8">kattaa jabaa immoo gara burqaa bishaaniitti geeddare.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">Faarfannaa 115</para>
  <para style="ms1">Waaqa Dhugaa Tokkicha</para>
  <para style="mr">
    <ref loc="PSA 115:4-11">115:4‑11</ref> kwf – <char style="xt"><ref loc="PSA 135:15-20">Far 135:15‑20</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Nuuf miti; yaa <char style="nd">Waaqayyo</char>, nuuf miti;</para>
  <para style="q2" vid="PSA 115:1">garuu jaalalaa fi amanamummaa keetiif jedhiitii</para>
  <para style="q2" vid="PSA 115:1">maqaa keetiif ulfina kenni.<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Saboonni maaliif,</para>
  <para style="q2" vid="PSA 115:2">“Waaqni isaanii eessa jira?” jedhu?<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Waaqni keenya samii keessa jira;</para>
  <para style="q2" vid="PSA 115:3">inni waan isa gammachiisu kam iyyuu ni hojjeta.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>Waaqonni isaanii tolfamoon garuu meetii fi</para>
  <para style="q2" vid="PSA 115:4">warqee harka namaatiin hojjetamanii dha.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>Isaan afaan qabu; garuu dubbachuu hin dandaʼan;</para>
  <para style="q2" vid="PSA 115:5">ijas qabu; garuu arguu hin dandaʼan;<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>gurra qabu; garuu dhagaʼuu hin dandaʼan;</para>
  <para style="q2" vid="PSA 115:6">funyaan qabu; garuu fuunfachuu hin dandaʼan;<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>harka qabu; garuu qaqqabachuu hin dandaʼan;</para>
  <para style="q2" vid="PSA 115:7">miilla qabu; garuu deemuu hin dandaʼan;</para>
  <para style="q2" vid="PSA 115:7">laagaa isaanii keessattis sagalee tokko illee hin uuman.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>Warri isaan tolchan</para>
  <para style="q2" vid="PSA 115:8">kanneen isaan amanatan hundi akkuma isaanii taʼu.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>Yaa mana Israaʼel, <char style="nd">Waaqayyoon</char> amanadhu;</para>
  <para style="q2" vid="PSA 115:9">inni gargaarsaa fi gaachana isaanii ti.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>Yaa mana Aroon, <char style="nd">Waaqayyoon</char> amanadhu;</para>
  <para style="q2" vid="PSA 115:10">inni gargaarsaa fi gaachana isaanii ti.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>Isin warri isa sodaattan, <char style="nd">Waaqayyoon</char> amanadhaa;</para>
  <para style="q2" vid="PSA 115:11">inni gargaarsaa fi gaachana isaanii ti.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>
    <char style="nd">Waaqayyo</char> nu yaadata; nu eebbisas;</para>
  <para style="q2" vid="PSA 115:12">inni mana Israaʼel ni eebbisa;</para>
  <para style="q2" vid="PSA 115:12">mana Aroonis ni eebbisa;<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>inni warra <char style="nd">Waaqayyoon</char> sodaatan,</para>
  <para style="q2" vid="PSA 115:13">xinnaas guddaas ni eebbisa.<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>
    <char style="nd">Waaqayyo</char>, isinii fi</para>
  <para style="q2" vid="PSA 115:14">ijoollee keessan haa baayʼisu.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>
    <char style="nd">Waaqayyo</char> samii fi</para>
  <para style="q2" vid="PSA 115:15">lafa Uume sun isin haa eebbisu.<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Samiin samiiwwanii oliis kan <char style="nd">Waaqayyoo</char> ti;</para>
  <para style="q2" vid="PSA 115:16">lafa garuu inni namaaf kenneera.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>Warri duʼan yookaan warri gara iddoo calʼisanitti gad buʼan</para>
  <para style="q2" vid="PSA 115:17">
    <char style="nd">Waaqayyoon</char> galateeffachuu hin dandaʼan;<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>nu garuu ammaa jalqabnee bara baraan</para>
  <para style="q2" vid="PSA 115:18">
    <char style="nd">Waaqayyoon</char> ni eebbifna.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">Haalleluuyaa.<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">Faarfannaa 116</para>
  <para style="ms1">Haalleluuyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>Ani <char style="nd">Waaqayyoon</char> nan jaalladha;</para>
  <para style="q2" vid="PSA 116:1">inni sagalee waammata kootii naa dhagaʼeeraatii.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>Sababii inni gurra isaa gara kootti deebiseef,</para>
  <para style="q2" vid="PSA 116:2">ani hamman lubbuun jiraadhutti isa nan waammadha.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Kiyyoon duʼaa na marse;</para>
  <para style="q2" vid="PSA 116:3">dhiphinni Siiʼoolis na qabate;</para>
  <para style="q2" vid="PSA 116:3">ani rakkinaa fi gaddaan nan moʼame.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>Anis, “Yaa <char style="nd">Waaqayyo</char> na oolchi!” jedhee</para>
  <para style="q2" vid="PSA 116:4">maqaa <char style="nd">Waaqayyoo</char> nan waammadhe.<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>
    <char style="nd">Waaqayyo</char> arjaa fi qajeelaa dha;</para>
  <para style="q2" vid="PSA 116:5">Waaqni keenya gara laaffessa.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>
    <char style="nd">Waaqayyo</char> garraamota ni eega;</para>
  <para style="q2" vid="PSA 116:6">yeroo ani baayʼee rakkadhetti isatu na gargaare.<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>Yaa lubbuu ko, boqonnaa keetti deebiʼi;</para>
  <para style="q2" vid="PSA 116:7">
    <char style="nd">Waaqayyo</char> waan gaarii siif godheeraatii.<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>Ati yaa <char style="nd">Waaqayyo</char> lubbuu koo duʼa irraa,</para>
  <para style="q2" vid="PSA 116:8">ija koo imimmaan irraa,</para>
  <para style="q2" vid="PSA 116:8">miilla koo gufachuu irraa waan oolchiteef,<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>ani biyya warra jiraatoo keessa,</para>
  <para style="q2" vid="PSA 116:9">fuula <char style="nd">Waaqayyoo</char> dura nan jiraadha.<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>Ani yeroo, “Ani baayʼee dhiphadheera” jedhetti,</para>
  <para style="q2" vid="PSA 116:10">amantii koo eeggadheera.<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>Ani yommuun burjaajaʼetti,</para>
  <para style="q2" vid="PSA 116:11">“Namni hundinuu sobduu dha” nan jedhe.<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>Waan gaarii inni naa godhe hundaaf,</para>
  <para style="q2" vid="PSA 116:12">ani <char style="nd">Waaqayyoof</char> maalan deebisa?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Ani xoofoo fayyinaa ol kaasee</para>
  <para style="q2" vid="PSA 116:13">maqaa <char style="nd">Waaqayyoo</char> nan waammadha.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Fuula saba isaa hundumaa duratti,</para>
  <para style="q2" vid="PSA 116:14">ani wareega koo <char style="nd">Waaqayyoof</char> nan galcha.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>Duuti qulqulloota isaa,</para>
  <para style="q2" vid="PSA 116:15">fuula <char style="nd">Waaqayyoo</char> duratti ulfina qaba.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>Yaa <char style="nd">Waaqayyo</char>, ani dhugumaan tajaajilaa kee ti;</para>
  <para style="q2" vid="PSA 116:16">ani tajaajilaa kee ilma tajaajiltuu keetii ti;</para>
  <para style="q2" vid="PSA 116:16">ati foncaa koo narraa hiikteerta.<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>Ani aarsaa galataa siif nan dhiʼeessa;</para>
  <para style="q2" vid="PSA 116:17">maqaa <char style="nd">Waaqayyoos</char> nan waammadha.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Iddoo sabni isaa hundi jirutti,</para>
  <para style="q2" vid="PSA 116:18">ani wareega koo <char style="nd">Waaqayyoof</char> nan galcha;<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>yaa Yerusaalem si keessatti,</para>
  <para style="q2" vid="PSA 116:19">oobdii mana <char style="nd">Waaqayyoo</char> irrattis nan galcha.</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">Haalleluuyaa.<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">Faarfannaa 117</para>
  <para style="ms1">Waamicha Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>Saboonni hundi <char style="nd">Waaqayyoon</char> jajadhaa;</para>
  <para style="q2" vid="PSA 117:1">isin namoonni hundinuu isa leellisaa.<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Jaalalli inni nuuf qabu guddaadhaatii;</para>
  <para style="q2" vid="PSA 117:2">amanamummaan <char style="nd">Waaqayyoo</char> bara baraan jiraata.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">Haalleluuyaa.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">Faarfannaa 118</para>
  <para style="ms1">Faarfannaa Ayyaana Daasii</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>
    <char style="nd">Waaqayyoof</char> galata galchaa; inni gaariidhaatii;</para>
  <para style="q2" vid="PSA 118:1">jaalalli isaa bara baraan jiraata.<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>Sabni Israaʼel, “Jaalalli isaa</para>
  <para style="q2" vid="PSA 118:2">bara baraan jiraata” haa jedhu.<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>Manni Aroonis,</para>
  <para style="q2" vid="PSA 118:3">“Jaalalli isaa bara baraan jiraata” haa jedhu.<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>Warri <char style="nd">Waaqayyoon</char> sodaatan,</para>
  <para style="q2" vid="PSA 118:4">“Jaalalli isaa bara baraan jiraata” haa jedhan.<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>Dhiphina koo keessatti ani <char style="nd">Waaqayyotti</char> nan iyyadhe;</para>
  <para style="q2" vid="PSA 118:5">innis deebii naa kenne; iddoo balʼaas na qubachiise.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>
    <char style="nd">Waaqayyo</char> na wajjin jira; ani hin sodaadhu;</para>
  <para style="q2" vid="PSA 118:6">namni maal na gochuu dandaʼa?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>
    <char style="nd">Waaqayyo</char> na wajjin jira; inni gargaaraa koo ti.</para>
  <para style="q2" vid="PSA 118:7">Anis diinota koo nan moʼadha.<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Nama amanachuu irra,</para>
  <para style="q2" vid="PSA 118:8">
    <char style="nd">Waaqayyotti</char> kooluu galuu wayya.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Qondaaltota amanachuu irra,</para>
  <para style="q2" vid="PSA 118:9">
    <char style="nd">Waaqayyotti</char> kooluu galuu wayya.<verse eid="PSA 118:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Saboonni hundinuu na marsan;</para>
  <para style="q2" vid="PSA 118:10">ani garuu maqaa <char style="nd">Waaqayyootiin</char> isaan nan barbadeesse.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Isaan karaa hundaan na marsan;</para>
  <para style="q2" vid="PSA 118:11">ani garuu maqaa <char style="nd">Waaqayyootiin</char> isaan nan barbadeesse.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Akkuma tuuta kanniisaa na marsan;</para>
  <para style="q2" vid="PSA 118:12">garuu akka qoraattii gubatuutti barbadaaʼan;</para>
  <para style="q2" vid="PSA 118:12">anis maqaa <char style="nd">Waaqayyootiin</char> isaan nan barbadeesse.<verse eid="PSA 118:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Ani dhiibamee kufuu gaʼeen ture;</para>
  <para style="q2" vid="PSA 118:13">
    <char style="nd">Waaqayyo</char> garuu na gargaare.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>
    <char style="nd">Waaqayyo</char> jabina kootii fi faarfannaa koo ti;</para>
  <para style="q2" vid="PSA 118:14">inni fayyina koo taʼeera.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Sagaleen gammachuutii fi moʼannaa dunkaanota</para>
  <para style="q2" vid="PSA 118:15">qajeeltotaa keessaa ni dhagaʼama;</para>
  <para style="q1" vid="PSA 118:15">“Harki <char style="nd">Waaqayyoo</char> kan mirgaa waan jabaa hojjeteera!<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>Harki <char style="nd">Waaqayyo</char> mirgaa ol qabameera;</para>
  <para style="q2" vid="PSA 118:16">harki <char style="nd">Waaqayyoo</char> mirgaa waan jabaa hojjeteera!”<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Ani nan jiraadha malee hin duʼu;</para>
  <para style="q2" vid="PSA 118:17">waan <char style="nd">Waaqayyo</char> hojjetes nan labsa.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>
    <char style="nd">Waaqayyo</char> jabeessee na adabeera;</para>
  <para style="q2" vid="PSA 118:18">garuu dabarsee duʼatti na hin kennine.<verse eid="PSA 118:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>Karra qajeelummaa naa banaa;</para>
  <para style="q2" vid="PSA 118:19">anis ol galee <char style="nd">Waaqayyoof</char> galata nan galcha.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>Kun karra <char style="nd">Waaqayyoo</char>,</para>
  <para style="q2" vid="PSA 118:20">kan qajeeltonni ittiin ol galanii dha.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Ati deebii naa kenniteertaatii, ani sin galateeffadha;</para>
  <para style="q2" vid="PSA 118:21">ati fayyina naa taateerta.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>Dhagaan ijaartonni tuffatan,</para>
  <para style="q2" vid="PSA 118:22">dhagaa golee taʼeera;<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>
    <char style="nd">Waaqayyo</char> waan kana hojjeteera;</para>
  <para style="q2" vid="PSA 118:23">kunis ija keenyatti dinqii dha.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Guyyaan kun guyyaa <char style="nd">Waaqayyo</char> uumee dha;</para>
  <para style="q2" vid="PSA 118:24">kottaa ni ililchina; itti gammannas.<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>Yaa <char style="nd">Waaqayyo</char>, si kadhannaa nu oolchi;</para>
  <para style="q2" vid="PSA 118:25">Yaa <char style="nd">Waaqayyo</char>, si kadhannaa nu milkoomsi.<verse eid="PSA 118:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>Kan maqaa <char style="nd">Waaqayyootiin</char> dhufu eebbifamaa dha.</para>
  <para style="q2" vid="PSA 118:26">Nu mana <char style="nd">Waaqayyoo</char> keessaa isin eebbifna.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>
    <char style="nd">Waaqayyo</char> Waaqa;</para>
  <para style="q2" vid="PSA 118:27">ifa isaas nuu irratti ibseera.</para>
  <para style="q1" vid="PSA 118:27">Dameewwan harkatti qabadhaatii <optbreak/> warra ayyaaneffachuu dhaqanitti makamaa;</para>
  <para style="q2" vid="PSA 118:27">gara gaanfawwan iddoo aarsaas dhaqaa.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>Ati Waaqa koo ti; ani sin galateeffadha;</para>
  <para style="q2" vid="PSA 118:28">ati Waaqa koo ti; anis sin leellisa.<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>
    <char style="nd">Waaqayyoof</char> galata galchaa; inni gaariidhaatii;</para>
  <para style="q2" vid="PSA 118:29">jaalalli isaa bara baraan jiraata.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">Faarfannaa 119</para>
  <para style="ms1">Seera Waaqaa Jajachuu</para>
  <para style="qa">א Aleef</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>Warri jireenyi isaanii mudaa hin qabne,</para>
  <para style="q2" vid="PSA 119:1">kanneen akka seera <char style="nd">Waaqayyootti</char> jiraattan eebbifamoo dha.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>Warri ajajawwan isaa eegan,</para>
  <para style="q2" vid="PSA 119:2">kanneen garaa guutuun isa barbaadan eebbifamoo dha.<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>Isaan balleessaa hin hojjetan;</para>
  <para style="q2" vid="PSA 119:3">karaa isaa irras ni deemu.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Akka Seerri kee amanamummaadhaan</para>
  <para style="q2" vid="PSA 119:4">eegamuuf ati ajajjeerta.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>Akka ani ajaja kee eeguuf</para>
  <para style="q2" vid="PSA 119:5">utuu karaan koo naa qajeelee jiraatee!<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Ani utuun ajajawwan kee hunda xiyyeeffadhee ilaalee</para>
  <para style="q2" vid="PSA 119:6">silaa hin qaanaʼun ture.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Ani yommuun seera kee qajeelaa sana baradhutti,</para>
  <para style="q2" vid="PSA 119:7">garaa tolaadhaan sin galateeffadha.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Ani sirna keetiif nan bula;</para>
  <para style="q2" vid="PSA 119:8">ati gonkumaa na hin dhiisin.<verse eid="PSA 119:8"/></para>
  <para style="qa">ב Beet</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Dargaggeessi akkamitti jireenya qulqulluu jiraachuu dandaʼa?</para>
  <para style="q2" vid="PSA 119:9">Akka dubbii keetiitti jiraachuudhaan.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Ani garaa koo guutuudhaan sin barbaada;</para>
  <para style="q2" vid="PSA 119:10">akka ani ajajawwan kee irraa jalʼadhu na hin godhin.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Ani akkan cubbuu sitti hin hojjenneef,</para>
  <para style="q2" vid="PSA 119:11">dubbii kee garaa koo keessa dhokfadheera.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>Yaa <char style="nd">Waaqayyo</char>, galanni siif haa taʼu;</para>
  <para style="q2" vid="PSA 119:12">sirna kee na barsiisi.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Ani seera afaan keetii baʼu hundumaa,</para>
  <para style="q2" vid="PSA 119:13">afaan kootiin nan dubbadha.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Akkuma namni tokko badhaadhummaa guddaatti gammadu,</para>
  <para style="q2" vid="PSA 119:14">ani ajaja kee faana buʼuutti nan gammada.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Ajajawwan kee irra deddeebiʼee nan yaada;</para>
  <para style="q2" vid="PSA 119:15">karaa kee irraas ija koo hin buqqifadhu.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Ani sirna keetti nan gammada;</para>
  <para style="q2" vid="PSA 119:16">dubbii kees hin dagadhu.<verse eid="PSA 119:16"/></para>
  <para style="qa">ג Giimeel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Akka ani jiraadhuu fi dubbii kee eeguuf,</para>
  <para style="q2" vid="PSA 119:17">garbicha keetiif waan gaarii godhi.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Akka ani seera kee keessatti</para>
  <para style="q2" vid="PSA 119:18">waan dinqisiisaa arguuf, ija koo naa bani.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>Ani lafa irratti keessummaa dha;</para>
  <para style="q2" vid="PSA 119:19">ajajawwan kee na duraa hin dhoksin.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Lubbuun koo yeroo hunda</para>
  <para style="q2" vid="PSA 119:20">seera kee hawwuudhaan, laafaa jirti.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Ati of tuultota warra abaaramoo,</para>
  <para style="q2" vid="PSA 119:21">kanneen ajajawwan kee irraa jalʼatan ni ifatta.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Waan ani seera kee eeguuf,</para>
  <para style="q2" vid="PSA 119:22">arrabsoo fi tuffii isaanii narraa fageessi.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Bulchitoonni walii wajjin taaʼanii yoo maqaa na balleessan iyyuu,</para>
  <para style="q2" vid="PSA 119:23">tajaajilaan kee irra deddeebiʼee labsii kee ni yaada.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Ajajni kee gammachuu koo ti;</para>
  <para style="q2" vid="PSA 119:24">gorsituu kootis.<verse eid="PSA 119:24"/></para>
  <para style="qa">ד Daalet</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Lubbuun koo biyyootti maxxante;</para>
  <para style="q2" vid="PSA 119:25">ati akkuma dubbii keetiitti na oolchi.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Yeroo ani waaʼee karaa koo sitti himetti,</para>
  <para style="q2" vid="PSA 119:26">ati deebii naa kennite; sirna kees na barsiisi.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Barsiisa seera keetii na hubachiisi;</para>
  <para style="q2" vid="PSA 119:27">anis irra deddeebiʼee dinqii kee nan yaada.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>Lubbuun koo gaddaan laafteerti;</para>
  <para style="q2" vid="PSA 119:28">ati akkuma dubbii keetiitti na jabeessi.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Karaa sobaa irraa na fageessi;</para>
  <para style="q2" vid="PSA 119:29">arjumaadhaanis seera kee na barsiisi.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Ani karaa dhugaa filadheera;</para>
  <para style="q2" vid="PSA 119:30">seera kees of dura kaaʼadheera.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>Yaa <char style="nd">Waaqayyo</char>, ani ajaja kee</para>
  <para style="q2" vid="PSA 119:31">jabeessee qabadheera; ati na hin qaanessin.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Sababii ati hubannaa koo naa balʼifteef</para>
  <para style="q2" vid="PSA 119:32">ani daandii ajajawwan keetii irra nan fiiga.<verse eid="PSA 119:32"/></para>
  <para style="qa">ה Hee</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>Yaa <char style="nd">Waaqayyo</char>, akka ani sirna kee duukaa buʼu na barsiisi;</para>
  <para style="q2" vid="PSA 119:33">anis hamma dhumaatti isa nan eega.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Akka ani seera kee eegee garaa koo guutuun</para>
  <para style="q2" vid="PSA 119:34">isaaf ajajamuuf hubannaa naa kenni.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Daandii ajajawwan keetii irra na deemsisi;</para>
  <para style="q2" vid="PSA 119:35">anis achitti gammachuu nan argadhaatii.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Garaa koo gara ofittummaadhaan faayidaa argachuutti utuu hin taʼin,</para>
  <para style="q2" vid="PSA 119:36">gara sirna keetiitti naa deebisi.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Ija koo waan faayidaa hin qabne irraa deebisi;</para>
  <para style="q2" vid="PSA 119:37">akkuma dubbii keetiittis na jiraachisi.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>Ati akka sodaatamtuuf,</para>
  <para style="q2" vid="PSA 119:38">waadaa kee garbicha keetiif guuti.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Salphina ani sodaadhu narraa fageessi;</para>
  <para style="q2" vid="PSA 119:39">seerri kee gaariidhaatii.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Kunoo, ani sirna kee nan hawwa;</para>
  <para style="q2" vid="PSA 119:40">qajeelummaa keetiin na jiraachisi.<verse eid="PSA 119:40"/></para>
  <para style="qa">ו Waw</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>Yaa <char style="nd">Waaqayyo</char>, jaalalli kee kan hin geeddaramne sun,</para>
  <para style="q2" vid="PSA 119:41">fayyisuun kees akkuma dubbii keetiitti gara koo haa dhufu;<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>yoos ani sababii dubbii kee amanadhuuf,</para>
  <para style="q2" vid="PSA 119:42">warra na arrabsaniif deebii kenna.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Waan ani seera kee abdadheef,</para>
  <para style="q2" vid="PSA 119:43">ati dubbii dhugaa afaan koo keessaa hin balleessin.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Bara baraa hamma bara baraatti,</para>
  <para style="q2" vid="PSA 119:44">ani yeroo hunda seera kee nan eega.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Ani ajaja kee waanan barbaaduuf,</para>
  <para style="q2" vid="PSA 119:45">bilisummaadhaan nan deddeebiʼa.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Ani waaʼee ajaja keetii mootota duratti nan dubbadha;</para>
  <para style="q2" vid="PSA 119:46">hin qaaneffamus;<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>waan ani ajajawwan kee jaalladhuuf,</para>
  <para style="q2" vid="PSA 119:47">isaanitti nan gammada.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Ani gara ajajawwan kee kanneen ani jaalladhu sanaatti <optbreak/> harka koo ol nan fudhadha;</para>
  <para style="q2" vid="PSA 119:48">labsii kees irra deddeebiʼee nan yaada.<verse eid="PSA 119:48"/></para>
  <para style="qa">ז Zaayin</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Waadaa tajaajilaa keetiif seente sana yaadadhu;</para>
  <para style="q2" vid="PSA 119:49">ati isumaan abdii naa kenniteertaatii.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Rakkina koo keessatti jajjabinni koo kana:</para>
  <para style="q2" vid="PSA 119:50">Waadaan kee na jiraachisa.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Of tuultonni akkuma barbaadanitti natti qoosu;</para>
  <para style="q2" vid="PSA 119:51">ani garuu seera kee irraa hin jalʼadhu.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>Yaa <char style="nd">Waaqayyo</char>, ani seera kee durii sana nan yaadadha;</para>
  <para style="q2" vid="PSA 119:52">isa keessattis jajjabina nan argadha.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Sababii hamoota warra seera kee dhiisaniitiif,</para>
  <para style="q2" vid="PSA 119:53">aariin na gugguba.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Iddoo keessummummaa koo hundatti</para>
  <para style="q2" vid="PSA 119:54">seerri kee faarfannaa koo ti.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>Yaa <char style="nd">Waaqayyo</char>, ani halkan keessa maqaa kee nan yaadadha;</para>
  <para style="q2" vid="PSA 119:55">seera kees nan eega.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Waan ani ajaja kee eegeef,</para>
  <para style="q2" vid="PSA 119:56">kun naaf taʼeera.<verse eid="PSA 119:56"/></para>
  <para style="qa">ח Heeti</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>Yaa <char style="nd">Waaqayyo</char>, ati qooda koo ti;</para>
  <para style="q2" vid="PSA 119:57">anis dubbii keetiif ajajamuuf waadaa galeera.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Ani garaa koo guutuun fuula kee barbaaddadheera;</para>
  <para style="q2" vid="PSA 119:58">ati akkuma waadaa keetiitti naa araarami.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Ani karaa koo itti deddeebiʼee yaadeera;</para>
  <para style="q2" vid="PSA 119:59">tarkaanfii koo gara sirna keetiitti deebiseera.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>Ani ajajawwan kee eeguuf,</para>
  <para style="q2" vid="PSA 119:60">nan ariifadha; hin barfadhus.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>Hamoonni yoo funyoodhaan na hidhan iyyuu,</para>
  <para style="q2" vid="PSA 119:61">ani seera kee hin irraanfadhu.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>Sababii seera kee qajeelaa sanaatiif,</para>
  <para style="q2" vid="PSA 119:62">ani si galateeffachuuf jedhee halkan walakkaa nan kaʼa.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>Ani warra si sodaatan hundaaf,</para>
  <para style="q2" vid="PSA 119:63">warra ajaja kee eegan hundaafis michuu dha.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>Yaa <char style="nd">Waaqayyo</char>, lafti jaalala keetiin guutamteerti;</para>
  <para style="q2" vid="PSA 119:64">sirna kee na barsiisi.<verse eid="PSA 119:64"/></para>
  <para style="qa">ט Teeti</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>Yaa <char style="nd">Waaqayyo</char>, ati akkuma dubbii keetiitti,</para>
  <para style="q2" vid="PSA 119:65">tajaajilaa keetiif waan gaarii gooteerta.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Murtii gaarii fi beekumsa na barsiisi;</para>
  <para style="q2" vid="PSA 119:66">ani ajajawwan keetti nan amanaatii.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Ani utuun hin rakkatin karaa irraa badee ture;</para>
  <para style="q2" vid="PSA 119:67">amma garuu dubbii kee nan eega.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Ati gaarii dha; wanni ati hojjettus gaarii dha;</para>
  <para style="q2" vid="PSA 119:68">sirna kee na barsiisi.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Of tuultonni yoo sobaan maqaa na balleessan iyyuu,</para>
  <para style="q2" vid="PSA 119:69">ani garaa koo guutuudhaan seera kee nan eega.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Onneen isaanii mooraan haguugamteerti;</para>
  <para style="q2" vid="PSA 119:70">ani garuu seera keetti nan gammada.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Akka ani sirna kee baradhuuf,</para>
  <para style="q2" vid="PSA 119:71">rakkachuun koo anaaf gaarii ture.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Meetii fi warqee kumaatama irra,</para>
  <para style="q2" vid="PSA 119:72">seeri afaan keetii baʼu anaaf gaariidha.<verse eid="PSA 119:72"/></para>
  <para style="qa">י Yood</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Harki kee na uume; na tolches;</para>
  <para style="q2" vid="PSA 119:73">akka ani ajaja kee baradhuuf ati hubannaa naa kenni.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Sababii ani dubbii kee abdadheef,</para>
  <para style="q2" vid="PSA 119:74">warri si sodaatan yommuu na arganitti haa gammadan.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>Yaa <char style="nd">Waaqayyo</char>, ani akka murtiin kee qajeelaa taʼe,</para>
  <para style="q2" vid="PSA 119:75">akka atis amanamummaadhaan na dhiphiste beeka.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>Akkuma ati tajaajilaa keetiif waadaa galte sanatti,</para>
  <para style="q2" vid="PSA 119:76">jaalalli kee kan hin geeddaramne sun na haa jajjabeessu.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Akka ani lubbuun jiraadhuuf gara laafinni kee gara koo haa dhufu;</para>
  <para style="q2" vid="PSA 119:77">seerri kee gammachuu kootii.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Of tuultonni waan sababii malee na yakkaniif haa qaanaʼan;</para>
  <para style="q2" vid="PSA 119:78">ani garuu irra deddeebiʼee seera kee nan yaada.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>Warri si sodaatan, kanneen seera kee hubatan</para>
  <para style="q2" vid="PSA 119:79">gara kootti haa deebiʼan.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Akka ani hin qaanofneef</para>
  <para style="q2" vid="PSA 119:80">garaan koo seera kee duratti hanqina hin qabaatin.<verse eid="PSA 119:80"/></para>
  <para style="qa">כ Kaaf</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Lubbuun koo fayyisuu kee hawwuudhaan gaggabdi;</para>
  <para style="q2" vid="PSA 119:81">ani garuu dubbii kee nan abdadha.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Iji koo waadaa kee eeggachuudhaan dadhabe;</para>
  <para style="q2" vid="PSA 119:82">anis, “Ati yoom na jajjabeessita?” nan jedha.<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Qalqalloo wayinii kan aara keessa ture</para>
  <para style="q2" vid="PSA 119:83">fakkaadhus ani ajaja kee hin irraanfadhu.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Tajaajilaan kee hamma yoomiitti obsuu qaba?</para>
  <para style="q2" vid="PSA 119:84">Ati warra na ariʼatanitti yoom murta?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Of tuultonni warri akka seera keetiitti hin bulle,</para>
  <para style="q2" vid="PSA 119:85">boolla naa qotaniiru.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Ajajawwan kee hundinuu amanamoo dha;</para>
  <para style="q2" vid="PSA 119:86">namoonni sababii malee waan na ariʼataniif ati na gargaari.<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Isaan lafa irraa na balleessuu gaʼanii turan;</para>
  <para style="q2" vid="PSA 119:87">ani garuu sirna kee hin dhiifne.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Ati akkuma jaalala keetiitti lubbuu koo baraari;</para>
  <para style="q2" vid="PSA 119:88">anis seera afaan keetii baʼu nan eega.<verse eid="PSA 119:88"/></para>
  <para style="qa">ל Laamed</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>Yaa <char style="nd">Waaqayyo</char>, dubbiin kee bara baraan jiraata;</para>
  <para style="q2" vid="PSA 119:89">samii keessas jabaatee ni dhaabata.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Amanamummaan kee dhaloota hundaaf itti fufa;</para>
  <para style="q2" vid="PSA 119:90">ati lafa hundeessite; isheenis ni jiraatti.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Sababii wanni hundinuu si tajaajiluuf,</para>
  <para style="q2" vid="PSA 119:91">seerri kee hamma harʼaatti jiraateera.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Utuu seerri kee gammachuu naa taʼuu baatee,</para>
  <para style="q2" vid="PSA 119:92">ani silaa rakkina kootiin badeen ture.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Sababii ati isaan na jiraachifteef,</para>
  <para style="q2" vid="PSA 119:93">ani gonkumaa ajaja kee hin irraanfadhu.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Sababii ani kan kee taʼeef na fayyisi;</para>
  <para style="q2" vid="PSA 119:94">anis sirna kee barbaadeera.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Hamoonni na balleessuuf na eeggachaa jiru;</para>
  <para style="q2" vid="PSA 119:95">ani garuu irra deddeebiʼee seera kee nan yaada.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Ani akka wanni mudaa hin qabnee hundinuu daangaa qabu argeera;</para>
  <para style="q2" vid="PSA 119:96">ajajni kee garuu baayʼee balʼaa dha.<verse eid="PSA 119:96"/></para>
  <para style="qa">מ Meem</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>Ani seera kee akkaman jaalladha!</para>
  <para style="q2" vid="PSA 119:97">Guyyaa guutuu irra deddeebiʼee waaʼee isaa nan yaada.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>Ajajawwan kee waan yeroo hunda na wajjin jiraniif,</para>
  <para style="q2" vid="PSA 119:98">diinota koo caalaa ogeessa na godhan.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>Ani sababiin irra deddeebiʼee seera kee yaaduuf,</para>
  <para style="q2" vid="PSA 119:99">barsiisota koo hundumaa caalaa hubannaa qaba.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Ani sababiin ajaja kee eeguuf,</para>
  <para style="q2" vid="PSA 119:100">maanguddoota caalaa hubannaa guddaan qaba.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Ani akkan dubbii kee eeguuf,</para>
  <para style="q2" vid="PSA 119:101">karaa hamaa hunda irraa miilla koo adabadheera.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Waan ati mataan kee na barsiifteef,</para>
  <para style="q2" vid="PSA 119:102">ani seera kee irraa hin fagaanne.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>Dubbiin kee akkam arraba kootti miʼaawa;</para>
  <para style="q2" vid="PSA 119:103">nadhii dammaa caalaa afaan kootti miʼaawa!<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Ani qajeelfama kee irraa hubannaa argadheera;</para>
  <para style="q2" vid="PSA 119:104">kanaafuu daandii sobaa hunda nan jibba.<verse eid="PSA 119:104"/></para>
  <para style="qa">נ Nuun</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Dubbiin kee miilla kootiif ibsaa dha;</para>
  <para style="q2" vid="PSA 119:105">daandii kootiif immoo ifa.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Ani akkan seera kee qajeelaa sana eeguuf, kakadheera;</para>
  <para style="q2" vid="PSA 119:106">kanas mirkaneesseera.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Ani akka malee dhiphadheen jira; yaa <char style="nd">Waaqayyo</char>,</para>
  <para style="q2" vid="PSA 119:107">ati akkuma dubbii keetiitti lubbuu koo baraari.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>Yaa <char style="nd">Waaqayyo</char>, <optbreak/> galata fedhiidhaan afaan kootii baʼu fudhadhu;</para>
  <para style="q2" vid="PSA 119:108">seera kees na barsiisi.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>Jireenyi koo yeroo hunda harka koo keessa jiraatu iyyuu,</para>
  <para style="q2" vid="PSA 119:109">ani seera kee hin irraanfadhu.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Hamoonni kiyyoo naa kaaʼaniiru;</para>
  <para style="q2" vid="PSA 119:110">ani garuu ajaja kee irraa hin jalʼanne.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Seerri kee dhaala koo kan bara baraa ti;</para>
  <para style="q2" vid="PSA 119:111">gammachuu garaa kootiitis.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Garaan koo hamma dhumaatti</para>
  <para style="q2" vid="PSA 119:112">ajaja kee eeguuf kutateera.<verse eid="PSA 119:112"/></para>
  <para style="qa">ס Saamek</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Ani nama yaada lamaa nan jibba;</para>
  <para style="q2" vid="PSA 119:113">seera kee garuu nan jaalladha.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>Ati iddoo ani itti baqadhuu fi gaachana koo ti;</para>
  <para style="q2" vid="PSA 119:114">ani dubbii kee abdadheera.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Akka ani ajajawwan Waaqa koo eeguuf,</para>
  <para style="q2" vid="PSA 119:115">isin warri waan hamaa hojjettan narraa fagaadhaa!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Ati akkuma waadaa keetiitti na deeggari; <optbreak/> anis nan jiraadha;</para>
  <para style="q2" vid="PSA 119:116">akka ani abdii kootti qaanaʼu na hin godhin.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>Akka ani nagaadhaan jiraadhuuf na deeggari;</para>
  <para style="q2" vid="PSA 119:117">yeroo hunda seera kee nan kabaja.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Sababii gowwoomsaan isaanii faayidaa hin qabneef;</para>
  <para style="q2" vid="PSA 119:118">ati warra seera kee irraa jalʼatan hunda tuffattee gatta.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Ati hamoota lafa irraa hunda akka kosiitti gatta;</para>
  <para style="q2" vid="PSA 119:119">kanaafuu ani seera kee nan jaalladha.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Foon koo si sodaachuudhaan hollata;</para>
  <para style="q2" vid="PSA 119:120">anis murtii kee nan sodaadha.<verse eid="PSA 119:120"/></para>
  <para style="qa">ע Aayin</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>Ani waan qajeelaa fi tolaa hojjedheera;</para>
  <para style="q2" vid="PSA 119:121">ati warra na hacuucanitti dabarsitee na hin kennin.<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Nagaan jiraachuu tajaajilaa keetii mirkaneessi;</para>
  <para style="q2" vid="PSA 119:122">akka of tuultonni na cunqursanis hin eeyyamin.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Iji koo fayyisuu kee eeguudhaan,</para>
  <para style="q2" vid="PSA 119:123">waadaa kee qajeelaas eeguudhaanis dadhabeera.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Akkuma jaalala keetiitti tajaajilaa kee yaadadhu;</para>
  <para style="q2" vid="PSA 119:124">seera kees na barsiisi.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>Ani tajaajilaa kee ti;</para>
  <para style="q2" vid="PSA 119:125">akka ani ajaja kee beekuuf hubannaa naa kenni.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>Yaa <char style="nd">Waaqayyo</char>, kun yeroo ati itti hojjettuu dha;</para>
  <para style="q2" vid="PSA 119:126">seerri kee cabsamaa jiraatii.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Kanaafuu ani warqee caalaa,</para>
  <para style="q2" vid="PSA 119:127">warqee qulqulluu caalaa, ajajawwan kee nan jaalladha;<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>ani akka seerri kee hundi qajeelaa taʼe nan amana;</para>
  <para style="q2" vid="PSA 119:128">daandii sobaa hundas nan jibba.<verse eid="PSA 119:128"/></para>
  <para style="qa">פ Pee</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Sirni kee dinqisiisaa dha;</para>
  <para style="q2" vid="PSA 119:129">kanaafuu ani isa nan eega.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Ibsamuun dubbii keetii ifa kenna;</para>
  <para style="q2" vid="PSA 119:130">wallaalotaafis hubannaa kenna.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Ani ajajawwan kee hawwuudhaan</para>
  <para style="q2" vid="PSA 119:131">afaan koo banee nan hargana.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Ati akkuma yeroo hunda warra maqaa kee jaalataniif gootu sana,</para>
  <para style="q2" vid="PSA 119:132">gara kootti garagalii na maari.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Akkuma dubbii keetiitti tarkaanfii miilla kootii naa qajeelchi;</para>
  <para style="q2" vid="PSA 119:133">cubbuun tokko iyyuu narratti hin moʼin.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Akka ani ajaja kee eeguuf</para>
  <para style="q2" vid="PSA 119:134">hacuuccaa namootaa jalaa na furi.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>Akka fuulli kee tajaajilaa kee irratti ifu godhi;</para>
  <para style="q2" vid="PSA 119:135">sirna kees na barsiisi.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Sababii namoonni seerra kee hin eegneef,</para>
  <para style="q2" vid="PSA 119:136">iji koo imimmaan lolaasa.<verse eid="PSA 119:136"/></para>
  <para style="qa">צ Tsaade</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>Yaa <char style="nd">Waaqayyo</char>, ati qajeelaa dha;</para>
  <para style="q2" vid="PSA 119:137">murtiin kees qajeelaa dha.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Seerri ati kennite qajeelaa dha;</para>
  <para style="q2" vid="PSA 119:138">guutummaattis amanamaa dha.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Sababii diinonni koo dubbii kee dagataniif,</para>
  <para style="q2" vid="PSA 119:139">hinaaffaan ani qabu na guggubeera.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Waadaan kee sirriitti qoramee ilaalameera;</para>
  <para style="q2" vid="PSA 119:140">tajaajilaan kees isa jaallata.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Xinnaadhee tuffatamu iyyuu,</para>
  <para style="q2" vid="PSA 119:141">ani ajaja kee hin irraanfadhu.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Qajeelummaan kee bara baraan jiraata;</para>
  <para style="q2" vid="PSA 119:142">seerri kees dhugaa dha.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Rakkinnii fi dhiphinni natti dhufeera;</para>
  <para style="q2" vid="PSA 119:143">ajajawwan kee garuu gammachuu koo ti.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Seerri kee bara baraan qajeelaa dha;</para>
  <para style="q2" vid="PSA 119:144">akka ani jiraadhuuf hubannaa naa kenni.<verse eid="PSA 119:144"/></para>
  <para style="qa">ק Qoof</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>Yaa <char style="nd">Waaqayyo</char>, ani garaa koo guutuudhaan sin waammadha;</para>
  <para style="q2" vid="PSA 119:145">deebii naa kenni; anis sirna keetiif nan ajajama.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Ani sittin iyyadha; ati na fayyisi;</para>
  <para style="q2" vid="PSA 119:146">seera kees nan eega.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Ani utuu lafti hin bariʼin kaʼee gargaarsaaf nan iyyadha;</para>
  <para style="q2" vid="PSA 119:147">ani dubbii kee abdadheera.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Akka ani irra deddeebiʼee waadaa kee yaaduuf,</para>
  <para style="q2" vid="PSA 119:148">iji koo halkan guutuu banamee bula.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Akkuma jaalala keetiitti sagalee koo dhagaʼi;</para>
  <para style="q2" vid="PSA 119:149">Yaa <char style="nd">Waaqayyo</char>, akkuma seera keetiitti lubbuu koo baraari.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Warri daba mariʼatan as dhiʼoo jiru;</para>
  <para style="q2" vid="PSA 119:150">seera kee irraa garuu fagoo jiru.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>Yaa <char style="nd">Waaqayyo</char>, ati garuu dhiʼoo jirta;</para>
  <para style="q2" vid="PSA 119:151">ajajawwan kee hundis dhugaa dha.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Akka ati ajajawwan kee bara baraan hundeessite,</para>
  <para style="q2" vid="PSA 119:152">ani seera kee irraa dur baradheera.<verse eid="PSA 119:152"/></para>
  <para style="qa">ר Reesh</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>Dhiphina koo argiitii na oolchi;</para>
  <para style="q2" vid="PSA 119:153">ani seera kee hin daganneetii.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>Dubbii koo naa falmi; na furis;</para>
  <para style="q2" vid="PSA 119:154">akkuma waadaa keetiitti lubbuu koo baraari.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Sababii isaan sirna kee hin barbaanneef,</para>
  <para style="q2" vid="PSA 119:155">fayyinni hamoota irraa fagaateera.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>Yaa <char style="nd">Waaqayyo</char>, gara laafinni kee guddaa dha;</para>
  <para style="q2" vid="PSA 119:156">akkuma seera keetiitti lubbuu koo baraari.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Diinonni koo warri na ariʼatan baayʼee dha;</para>
  <para style="q2" vid="PSA 119:157">ani garuu seera kee irraa hin jalʼanne.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Sababii isaan dubbii keetiif hin ajajamneef,</para>
  <para style="q2" vid="PSA 119:158">ani warra amantii hin qabne ija jibbaatiin nan ilaala.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Akkam akka ani qajeelfama kee jaalladhu mee ilaali;</para>
  <para style="q2" vid="PSA 119:159">Yaa <char style="nd">Waaqayyo</char>, akkuma jaalala keetiitti lubbuu koo baraari.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Dubbiin kee hundinuu dhugaa dha;</para>
  <para style="q2" vid="PSA 119:160">seerri kee qajeelaan hundinuus bara baraan jiraata.<verse eid="PSA 119:160"/></para>
  <para style="qa">ש Siinii fi Shiin</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>Bulchitoonni sababii malee na ariʼatan;</para>
  <para style="q2" vid="PSA 119:161">garaan koo garuu dubbii kee <optbreak/> sodaachuudhaan hollata.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Ani akka nama boojuu guddaa argate tokkootti,</para>
  <para style="q2" vid="PSA 119:162">dubbii keetti nan gammada.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Ani soba nan jibba; nan xireeffadhas;</para>
  <para style="q2" vid="PSA 119:163">seera kee garuu nan jaalladha.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Sababii seera kee qajeelaa sanaatiif,</para>
  <para style="q2" vid="PSA 119:164">ani guyyaatti yeroo torba sin galateeffadha.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Warri seera kee jaallatan nagaa guddaa qabu;</para>
  <para style="q2" vid="PSA 119:165">wanni isaan gufachiisu tokko iyyuu hin jiru.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>Yaa <char style="nd">Waaqayyo</char>, ani fayyisuu kee nan abdadha;</para>
  <para style="q2" vid="PSA 119:166">ajaja kee duukaas nan buʼa.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Ani waanan guddaa isa jaalladhuuf,</para>
  <para style="q2" vid="PSA 119:167">ajaja kee nan eega.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Ati karaa koo hunda waan beektuuf,</para>
  <para style="q2" vid="PSA 119:168">ani sirna keetii fi seera kee nan eega.<verse eid="PSA 119:168"/></para>
  <para style="qa">ת Taaw</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>Yaa <char style="nd">Waaqayyo</char>, iyyi koo fuula kee dura haa gaʼu;</para>
  <para style="q2" vid="PSA 119:169">ati akkuma dubbii keetiitti hubannaa naa kenni.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Waammanni koo fuula kee dura haa gaʼu;</para>
  <para style="q2" vid="PSA 119:170">akkuma waadaa keetiitti na baasi.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Sababii ati qajeelfama kee na barsiiftuuf,</para>
  <para style="q2" vid="PSA 119:171">hidhiin koo galata haa dhangalaasu.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Arrabni koo dubbii kee haa faarfatu;</para>
  <para style="q2" vid="PSA 119:172">ajajni kee hundi qajeelaadhaatii.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Waan ani sirna kee filadheef,</para>
  <para style="q2" vid="PSA 119:173">harki kee na gargaaruuf haa qophaaʼu.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>Yaa <char style="nd">Waaqayyo</char>, ani fayyisuu kee nan hawwa;</para>
  <para style="q2" vid="PSA 119:174">seerri kees gammachuu koo ti.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>Lubbuun koo si galateeffachuuf haa jiraattu;</para>
  <para style="q2" vid="PSA 119:175">seerri kees na haa gargaaru.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Ani akkuma hoolaa badee karaa irraa jalʼadheera.</para>
  <para style="q2" vid="PSA 119:176">Ani ajajawwan kee hin irraanfanneetii,</para>
  <para style="q2" vid="PSA 119:176">tajaajilaa kee barbaadi.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">Faarfannaa 120</para>
  <para style="ms1">Farra Nagaa</para>
  <para style="d">Faarfannaa Ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>Ani rakkina koo keessatti <char style="nd">Waaqayyotti</char> nan iyyadha;</para>
  <para style="q2" vid="PSA 120:1">innis deebii naa kenna.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>Yaa <char style="nd">Waaqayyo</char>, afaan sobuu fi</para>
  <para style="q2" vid="PSA 120:2">arraba nama gowwoomsu jalaa na baasi.<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>Yaa arraba gowwoomsituu nana, maaltu siif kennama?</para>
  <para style="q2" vid="PSA 120:3">Kana caalaas maal godhamta?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>Inni xiyya loltootaa kan qarameen,</para>
  <para style="q2" vid="PSA 120:4">barbadaa ibiddaa qacamaatiin si adaba.<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>Ani waanan Meshek keessa taaʼee</para>
  <para style="q2" vid="PSA 120:5">dunkaanota Qeedaar gidduu jiraadhuuf, anaaf wayyoo!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Warra nagaa jibban gidduu,</para>
  <para style="q2" vid="PSA 120:6">ani yeroo dheeraa jiraadheera.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>Ani nama nagaa barbaadu dha;</para>
  <para style="q2" vid="PSA 120:7">isaan garuu yeroo ani dubbadhu lolaaf kakaʼan.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">Faarfannaa 121</para>
  <para style="ms1">Eegduu Israaʼel</para>
  <para style="d">Faarfannaa Ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>Ani ija koo gara tulluuwwaniitti ol nan qabadha;</para>
  <para style="q2" vid="PSA 121:1">gargaarsi koo eessaa dhufa?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Gargaarsi koo <char style="nd">Waaqayyo</char></para>
  <para style="q2" vid="PSA 121:2">samii fi lafa uume biraa dhufa.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>Inni akka miilli kee mucucaatu hin godhu;</para>
  <para style="q2" vid="PSA 121:3">kan si eegu hin mugu;<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>dhugumaan inni Israaʼelin eegu</para>
  <para style="q2" vid="PSA 121:4">hin mugu; hin rafus.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>
    <char style="nd">Waaqayyo</char> si eega;</para>
  <para style="q2" vid="PSA 121:5">
    <char style="nd">Waaqayyo</char> karaa mirga keetiitiin gaaddisa siif taʼa;<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>guyyaa aduun si hin gubu;</para>
  <para style="q2" vid="PSA 121:6">halkanis jiʼi si hin miidhu.<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>
    <char style="nd">Waaqayyo</char> miidhaa hunda irraa si eega;</para>
  <para style="q2" vid="PSA 121:7">inni lubbuu kee ni eega;<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>
    <char style="nd">Waaqayyo</char> ammaa jalqabee</para>
  <para style="q2" vid="PSA 121:8">hamma bara baraatti, baʼuu fi galuu kee ni eega.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">Faarfannaa 122</para>
  <para style="ms1">Yaa Yerusaalem Ililchi</para>
  <para style="d">Faarfannaa Ol baʼuu. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>Yommuu isaan, “Kottu gara mana <char style="nd">Waaqayyoo</char> dhaqnaa”</para>
  <para style="q2" vid="PSA 122:1">naan jedhanitti, ani nan gammade.<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>Yaa Yerusaalem,</para>
  <para style="q2" vid="PSA 122:2">miilli keenya karrawwan kee irra dhaabata.<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Yerusaalem akka magaalaa walitti maxxantee</para>
  <para style="q2" vid="PSA 122:3">gobbatte tokkootti ijaaramte.<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>Kunis iddoo gosoonni,</para>
  <para style="q2" vid="PSA 122:4">gosoonni <char style="nd">Waaqayyo</char>,</para>
  <para style="q1" vid="PSA 122:4">akka sirna Israaʼeliif kenname sanaatti,</para>
  <para style="q2" vid="PSA 122:4">maqaa <char style="nd">Waaqayyoo</char> galateeffachuuf itti ol baʼanii dha.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Teessoowwan murtii,</para>
  <para style="q2" vid="PSA 122:5">teessoowwan mana Daawit achi dhaabatu.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Akkana jedhaa nagaa Yerusaalemiif kadhadhaa:</para>
  <para style="q2" vid="PSA 122:6">“Warri si jaallatan nagaan haa jiraatan.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Dallaa kee keessa nagaan,</para>
  <para style="q2" vid="PSA 122:7">masaraa mootummaa keetii keessa immoo tasgabbiin haa jiraatu.”<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Ani obboloota kootii fi michoota kootiif jedhee,</para>
  <para style="q2" vid="PSA 122:8">“Nagaan si keessa haa jiraatu” nan jedha.<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>Mana <char style="nd">Waaqayyo</char> Waaqa keenyaatiif jedhee,</para>
  <para style="q2" vid="PSA 122:9">ani akka wanni gaariin siif taʼu nan hawwa.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">Faarfannaa 123</para>
  <para style="ms1">Kadhannaa Yeroo Rakkinaa</para>
  <para style="d">Faarfannaa ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>Yaa isa teessoon kee samii irra jiru,</para>
  <para style="q2" vid="PSA 123:1">ani ija koo gara keetti ol nan qabadha.<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Akkuma iji garbootaa harka gooftaa isaanii,</para>
  <para style="q2" vid="PSA 123:2">iji garbittii immoo harka giiftii ishee ilaalu sana,</para>
  <para style="q1" vid="PSA 123:2">hamma inni araara nuu buusutti,</para>
  <para style="q2" vid="PSA 123:2">iji keenyas gara <char style="nd">Waaqayyo</char> Waaqa keenyaa ni ilaala.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>Nuu araarami; yaa <char style="nd">Waaqayyo</char>, nuu araarami;</para>
  <para style="q2" vid="PSA 123:3">tuffatamuun nutti baayʼateeraatii.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Arrabni warra of jajaniitii fi</para>
  <para style="q2" vid="PSA 123:4">tuffiin warra of tuulanii nutti baayʼateera.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">Faarfannaa 124</para>
  <para style="ms1">Fayyisaa Israaʼel</para>
  <para style="d">Faarfannaa ol baʼuu. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>Israaʼel akkana haa jedhu:</para>
  <para style="q2" vid="PSA 124:1">Utuu <char style="nd">Waaqayyo</char> garee keenya taʼuu baatee,<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>utuu <char style="nd">Waaqayyo</char> garee keenya taʼuu baatee,</para>
  <para style="q2" vid="PSA 124:2">yommuu namoonni nutti kaʼanitti,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>yommuu aariin isaanii nutti bobaʼetti,</para>
  <para style="q2" vid="PSA 124:3">silaa isaan utuu nu lubbuun jirruu nu liqimsu turan;<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>lolaan nu liqimsee</para>
  <para style="q2" vid="PSA 124:4">dhaʼaan bishaanii nurra yaaʼa ture;<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>bishaan hamaan</para>
  <para style="q2" vid="PSA 124:5">nu fudhatee bada ture.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>
    <char style="nd">Waaqayyo</char> akka nu ilkaan isaaniitiin cicciramnuuf</para>
  <para style="q2" vid="PSA 124:6">dabarsee itti nu hin kennin sun haa eebbifamu.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Akkuma simbirri kiyyoo adamsituu jalaa baatu,</para>
  <para style="q2" vid="PSA 124:7">nu isaan jalaa baaneerra;</para>
  <para style="q1" vid="PSA 124:7">kiyyoon ni ciccite;</para>
  <para style="q2" vid="PSA 124:7">nus jalaa baane.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Gargaarsi keenya maqaa <char style="nd">Waaqayyoo</char>,</para>
  <para style="q2" vid="PSA 124:8">Uumaa samii fi lafa sanaa ti.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">Faarfannaa 125</para>
  <para style="ms1">Waaqayyo Amanamtoota Isaa Ni eega</para>
  <para style="d">Faarfannaa ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>Warri <char style="nd">Waaqayyoon</char> amanatan akka Tulluu Xiyoon</para>
  <para style="q2" vid="PSA 125:1">kan hin raafamne, kan bara baraan jiraatu sanaa ti.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Akkuma tulluuwwan Yerusaalemin marsan sana,</para>
  <para style="q2" vid="PSA 125:2">
    <char style="nd">Waaqayyo</char> ammaa jalqabee hamma bara baraatti,</para>
  <para style="q2" vid="PSA 125:2">saba isaa ni marsa.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Akka qajeeltonni jalʼina hojjechuuf</para>
  <para style="q2" vid="PSA 125:3">harka isaanii ol hin diriirfanneef,</para>
  <para style="q1" vid="PSA 125:3">bokkuun hamootaa lafa qajeeltotaaf</para>
  <para style="q2" vid="PSA 125:3">ixaadhaan qoodame irra hin jiraatu.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>Yaa <char style="nd">Waaqayyo</char>, warra gaariif,</para>
  <para style="q2" vid="PSA 125:4">warra garaa isaaniitiin toloota taʼaniifis waan gaarii godhi.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>Warra karaa micciiramaatti garagalan garuu,</para>
  <para style="q2" vid="PSA 125:5">
    <char style="nd">Waaqayyo</char> akkuma warra hammina hojjetan balleessu jaras ni balleessa.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q1" vid="PSA 125:5">Nagaan Israaʼeliif haa taʼu.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">Faarfannaa 126</para>
  <para style="ms1">Faarfannaa Warra Boojuudhaa Deebiʼanii</para>
  <para style="d">Faarfannaa ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>Yeroo <char style="nd">Waaqayyo</char> warra boojiʼamanii turan gara Xiyoonitti deebisetti,</para>
  <para style="q2" vid="PSA 126:1">nu akka warra abjuu abjootanii taane.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Afaan keenya kolfaan, arrabni keenya immoo</para>
  <para style="q2" vid="PSA 126:2">faarfannaa gammachuutiin guutame.</para>
  <para style="q1" vid="PSA 126:2">Kana irratti saboota gidduutti,</para>
  <para style="q2" vid="PSA 126:2">“<char style="nd">Waaqayyo</char> waan guddaa isaaniif godheera” jedhame.<verse eid="PSA 126:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>
    <char style="nd">Waaqayyo</char> waan guddaa nuuf godhe;</para>
  <para style="q2" vid="PSA 126:3">nus ni gammanne.<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>Yaa <char style="nd">Waaqayyo</char>, akkuma lagoota Negeeb,</para>
  <para style="q2" vid="PSA 126:4">boojuu keenya nuu deebisi.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Warri imimmaaniin facaasan,</para>
  <para style="q2" vid="PSA 126:5">faarfannaa gammachuutiin ni haammatu.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Namni sanyii facaafamu baadhatee booʼaa gad baʼu,</para>
  <para style="q2" vid="PSA 126:6">bissii isaa baadhatee faarfannaa gammachuu faarfachaa deebiʼa.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">Faarfannaa 127</para>
  <para style="ms1">Waaqa Amanachuu</para>
  <para style="d">Faarfannaa Ol baʼuu. Faarfannaa Solomoon.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>
    <char style="nd">Waaqayyo</char> mana ijaaruu baannaan,</para>
  <para style="q2" vid="PSA 127:1">warri ijaaran akkasumaan dadhabu.</para>
  <para style="q1" vid="PSA 127:1">
    <char style="nd">Waaqayyo</char> magaalaa eeguu baannaan,</para>
  <para style="q2" vid="PSA 127:1">warri eegan akkasumaan dhaabachaa bulu.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>Isin buddeena dadhabbii guddaan argame nyaachuuf jettanii,</para>
  <para style="q2" vid="PSA 127:2">barii barraaqaan kaʼuun keessan,</para>
  <para style="q1" vid="PSA 127:2">turtanii rafuun keessan faayidaa hin qabu;</para>
  <para style="q2" vid="PSA 127:2">inni warra jaallatuuf utuma isaan rafanii iyyuu <optbreak/> waan isaan barbaachisu ni kennaaf.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Kunoo, ijoolleen kennaa <char style="nd">Waaqayyoo</char> ti;</para>
  <para style="q2" vid="PSA 127:3">iji gadameessaas badhaasa isaa ti.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Ijoolleen dargaggummaa keessa dhalchan,</para>
  <para style="q2" vid="PSA 127:4">akkuma xiyya harka goota tokkoo keessa jiruu ti.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>Namni korojoon isaa xiyyaan guutame eebbifamaa dha.</para>
  <para style="q2" vid="PSA 127:5">Inni yommuu karra duratti diinota isaatiin falmutti hin qaanaʼu.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">Faarfannaa 128</para>
  <para style="ms1">Eebba Qajeeltonni Argatan</para>
  <para style="d">Faarfannaa Ol Baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>Warri <char style="nd">Waaqayyoon</char> sodaatan,</para>
  <para style="q2" vid="PSA 128:1">kanneen karaa isaa irra deeman eebbifamoo dha.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Ati buʼaa dadhabbii keetii ni nyaatta;</para>
  <para style="q2" vid="PSA 128:2">ni eebbifamta; jireenyis sitti tola.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Niitiin kee mana kee keessatti,</para>
  <para style="q2" vid="PSA 128:3">akka muka wayinii kan ija naqatee ni taati;</para>
  <para style="q1" vid="PSA 128:3">ijoolleen kees naannoo maaddii keetiitti,</para>
  <para style="q2" vid="PSA 128:3">akka lataa muka ejersaa ni taʼu.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Namni <char style="nd">Waaqayyoon</char> sodaatu</para>
  <para style="q2" vid="PSA 128:4">akkasitti eebbifama.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>Bara jireenya keetii guutuu,</para>
  <para style="q2" vid="PSA 128:5">
    <char style="nd">Waaqayyo</char> Xiyoon irraa si haa eebbisu;</para>
  <para style="q2" vid="PSA 128:5">atis badhaadhummaa Yerusaalem argi.<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>ijoollee ijoollee keetii ni argi;</para>
  <para style="q2" vid="PSA 128:6">nagaan Israaʼeliif haa taʼu.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">Faarfannaa 129</para>
  <para style="ms1">Kadhannaa Diinota Xiyooniin Mormuuf Kadhatame</para>
  <para style="d">Faarfannaa ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>Israaʼel akkana haa jedhu;</para>
  <para style="q2" vid="PSA 129:1">“Isaan dargaggummaa kootii jalqabanii akka malee na cunqursaniiru;<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>isaan dargaggummaa kootii jalqabanii akka malee na cunqursaniiru;</para>
  <para style="q2" vid="PSA 129:2">garuu na hin moʼanne.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Warri qootiisa qotan dugda koo qotan;</para>
  <para style="q2" vid="PSA 129:3">boʼoo isaaniis ni dheeressan.<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>
    <char style="nd">Waaqayyo</char> garuu qajeelaa dha;</para>
  <para style="q2" vid="PSA 129:4">funyoo jalʼootaa gargar kukkuteera.”<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Warri Xiyoonin jibban hundinuu,</para>
  <para style="q2" vid="PSA 129:5">qaaniidhaan duubatti haa deebiʼan.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Isaan akka marga bantii manaa irraa</para>
  <para style="q2" vid="PSA 129:6">kan utuu hin guddatin goguu haa taʼan;<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>namichi haamu qabaa isaa guuttachuu,</para>
  <para style="q2" vid="PSA 129:7">yookaan namichi walitti qabu bissii isaa guuttachuu hin dandaʼu.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Warri achiin darban, “Eebbi <char style="nd">Waaqayyoo</char> isiniif haa taʼu;</para>
  <para style="q2" vid="PSA 129:8">maqaa <char style="nd">Waaqayyootiin</char> isin eebbifna” isaaniin hin jedhin.<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">Faarfannaa 130</para>
  <para style="ms1">Waamicha Gargaarsaaf Dhiʼaate</para>
  <para style="d">Faarfannaa ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>Yaa <char style="nd">Waaqayyo</char>, ani boolla gad fagoo keessaa <optbreak/> sitti nan iyyadha;<verse eid="PSA 130:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2"/>yaa Gooftaa, sagalee koo dhagaʼi.</para>
  <para style="q1" vid="PSA 130:2">Gurri kees sagalee waammata koo</para>
  <para style="q2" vid="PSA 130:2">xiyyeeffatee haa dhagaʼu.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>Yaa <char style="nd">Waaqayyo</char>, utuu ati cubbuu lakkooftee,</para>
  <para style="q2" vid="PSA 130:3">yaa gooftaa silaa eenyutu dhaabachuu dandaʼa?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>Garuu dhiifamni si bira jira;</para>
  <para style="q2" vid="PSA 130:4">kanaaf ati ni sodaatamta.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Ani <char style="nd">Waaqayyoon</char> nan eeggadha; lubbuun koos isa eeggatti;</para>
  <para style="q2" vid="PSA 130:5">dubbii isaas nan abdadha.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Eegdota barii lafaa eeggatan caalaa,</para>
  <para style="q2" vid="PSA 130:6">dhugumaan eegdota barii lafaa eeggatan caalaa</para>
  <para style="q2" vid="PSA 130:6">lubbuun koo Gooftaa eeggatti.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>Yaa Israaʼel, ati <char style="nd">Waaqayyoon</char> abdadhu;</para>
  <para style="q2" vid="PSA 130:7">
    <char style="nd">Waaqayyo</char> bira jaalalli dhuma hin qabne,</para>
  <para style="q2" vid="PSA 130:7">furiin guutuunis ni jiraatii.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>Inni mataan isaa cubbuu isaanii</para>
  <para style="q2" vid="PSA 130:8">hundumaa irraa Israaʼelin ni fura.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">Faarfannaa 131</para>
  <para style="ms1">Waaqa Amanachuu</para>
  <para style="d">Faarfannaa ol baʼuu. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>Yaa <char style="nd">Waaqayyo</char>, garaan koo of hin jaju;</para>
  <para style="q2" vid="PSA 131:1">iji koos of hin tuulu;</para>
  <para style="q2" vid="PSA 131:1">ani waan guddaa fi waan humna kootii ol taʼe keessa hin seenu.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>Ani garuu lubbuu koo afaan qabachiiseera; calʼisiiseeras;</para>
  <para style="q2" vid="PSA 131:2">akkuma daaʼimni harma haadha isaa guusan tokko haadhatti irkatee boqotu sana,</para>
  <para style="q2" vid="PSA 131:2">akkuma daaʼima harma haadha isaa guusanii lubbuun koo na keessatti calʼiste.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>Yaa Israaʼel, ammaa fi bara baraaf,</para>
  <para style="q2" vid="PSA 131:3">
    <char style="nd">Waaqayyoon</char> abdadhu.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">Faarfannaa 132</para>
  <para style="ms1">Faarfannaa Deebifamuu Taabotaa</para>
  <para style="mr">
    <ref loc="PSA 132:8-10">132:8‑10</ref> kwf – <char style="xt"><ref loc="2CH 6:41-42">2Sn 6:41‑42</ref></char></para>
  <para style="d">Faarfannaa ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>Yaa <char style="nd">Waaqayyo</char>, Daawitii fi</para>
  <para style="q2" vid="PSA 132:1">rakkina inni obse hundumaa yaadadhu.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>Inni kakuu tokko <char style="nd">Waaqayyoof</char> kakatee</para>
  <para style="q2" vid="PSA 132:2">Waaqa Yaaqoob Jabaa sanaaf akkana jedhee wareege:<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“Ani mana koo ol hin seenu;</para>
  <para style="q2" vid="PSA 132:3">yookaan siree kootti ol hin baʼu.<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>Ani ija kootiif hirriba,</para>
  <para style="q2" vid="PSA 132:4">baallee ija kootiitiif immoo mugaatii hin eeyyamu;<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>kunis hamma ani <char style="nd">Waaqayyoof</char> iddoo argutti,</para>
  <para style="q2" vid="PSA 132:5">Waaqa Yaaqoob Jabaa sanaaf iddoo jireenyaa argutti.”<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Kunoo, Efraataatti waaʼee isaa dhageenye;</para>
  <para style="q2" vid="PSA 132:6">Yaaʼaarittis isa arganne:<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“Kottaa iddoo jireenya isaa dhaqnaa;</para>
  <para style="q2" vid="PSA 132:7">ejjeta miilla isaa jalattis kufnee waaqeffannaa.<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>‘Yaa <char style="nd">Waaqayyo</char> kaʼiitii, gara iddoo boqonnaa keetii kottu;</para>
  <para style="q2" vid="PSA 132:8">atii fi taabonni jabina keetiis kottaa.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Luboonni kee qajeelummaa haa uffatan;</para>
  <para style="q2" vid="PSA 132:9">qulqulloonni kees gammachuudhaan haa faarfatan.’ ”<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Sababii garbicha kee Daawitiif jedhiitii,</para>
  <para style="q2" vid="PSA 132:10">dibamaa kee hin gatin.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>
    <char style="nd">Waaqayyo</char> akkana jedhee kakuu dhugaa tokko Daawitiif kakateera;</para>
  <para style="q2" vid="PSA 132:11">inni kakuu kana irraa duubatti hin deebiʼu:</para>
  <para style="q2" vid="PSA 132:11">“Ani ilmaan kee keessaa isa tokko teessoo kee irra nan teessisa;<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>yoo ilmaan kee kakuu koo fi seera ani isaan barsiisu eegan,</para>
  <para style="q2" vid="PSA 132:12">ilmaan isaaniis akkasuma bara baraa hamma bara baraatti <optbreak/> teessoo kee irra ni taaʼu.”<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>
    <char style="nd">Waaqayyo</char> Xiyoonin filateeraatii;</para>
  <para style="q2" vid="PSA 132:13">akka isheen iddoo jireenya isaa taatus fedhee akkana jedheera:<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“Kun bara baraa hamma bara baraatti iddoo jireenyaa koo ti;</para>
  <para style="q2" vid="PSA 132:14">kanas ani waanan fedheef, as nan jiraadha.<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>Ani waan hundaan ishee nan eebbisa;</para>
  <para style="q2" vid="PSA 132:15">hiyyeeyyii ishee illee buddeena nan quubsa.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Luboota isheetti fayyina nan uffisa;</para>
  <para style="q2" vid="PSA 132:16">qulqulloonni ishees gammachuudhaan ni faarfatu.<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“Ani achitti akka gaanfi tokko Daawitiif biqilu nan godha;</para>
  <para style="q2" vid="PSA 132:17">dibamaa koofis ibsaa qopheesseera.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Diinota isaatti qaanii nan uffisa;</para>
  <para style="q2" vid="PSA 132:18">gonfoon mataa isaa irraa garuu ni ifa.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">Faarfannaa 133</para>
  <para style="ms1">Jaalala Obbolummaa</para>
  <para style="d">Faarfannaa ol baʼuu. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>Obboloonni tokkummaadhaan walii wajjin jiraachuun,</para>
  <para style="q2" vid="PSA 133:1">akkam gaarii dha! Akkam namatti tolas!<verse eid="PSA 133:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Kun akka zayitii gatii guddaa</para>
  <para style="q2" vid="PSA 133:2">kan mataa irratti dhangalaafamee,</para>
  <para style="q1" vid="PSA 133:2">akka isa areeda irra gad yaaʼuu,</para>
  <para style="q2" vid="PSA 133:2">areeda Aroon irra, morma uffata isaa irras gad yaaʼa ti.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Innis akkuma fixeensa Hermoon,</para>
  <para style="q2" vid="PSA 133:3">kan Tulluu Xiyoon irra gad yaaʼuu ti.</para>
  <para style="q1" vid="PSA 133:3">Achi irratti <char style="nd">Waaqayyo</char> hamma bara baraatti eebba isaa,</para>
  <para style="q2" vid="PSA 133:3">jireenyas ajajeeraatii.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">Faarfannaa 134</para>
  <para style="ms1">Faarfannaa Halkanii</para>
  <para style="d">Faarfannaa ol baʼuu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>Isin tajaajiltoonni <char style="nd">Waaqayyoo</char>,</para>
  <para style="q2" vid="PSA 134:1">warri halkan mana <char style="nd">Waaqayyoo</char> keessa tajaajiltan hundinuu,</para>
  <para style="q2" vid="PSA 134:1">
    <char style="nd">Waaqayyoon</char> galateeffadhaa.<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>Mana qulqullummaa keessatti harka keessan ol qabaatii</para>
  <para style="q2" vid="PSA 134:2">
    <char style="nd">Waaqayyoon</char> galateeffadhaa.<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>
    <char style="nd">Waaqayyo</char> samii fi lafa uume sun</para>
  <para style="q2" vid="PSA 134:3">Xiyoon irraa isin haa eebbisu.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">Faarfannaa 135</para>
  <para style="ms1">Faarfannaa Galataa</para>
  <para style="mr">
    <ref loc="PSA 135:15-20">135:15‑20</ref> kwf – <char style="xt"><ref loc="PSA 115:4-11">Far 115:4‑11</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">Maqaa <char style="nd">Waaqayyoo</char> jajadhaa;</para>
  <para style="q2" vid="PSA 135:1">isin garboonni <char style="nd">Waaqayyoo</char> isa galateeffadhaa.<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>Isin warri mana <char style="nd">Waaqayyoo</char> keessa,</para>
  <para style="q2" vid="PSA 135:2">oobdii mana Waaqa keenyaa keessa tajaajiltan, isa galateeffadhaa.<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>
    <char style="nd">Waaqayyo</char> gaariidhaatii, <char style="nd">Waaqayyoon</char> galateeffadhaa;</para>
  <para style="q2" vid="PSA 135:3">inni arjaadhaatii maqaa isaatiif faarfadhaa.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>
    <char style="nd">Waaqayyo</char> Yaaqoobin ofii isaatiif,</para>
  <para style="q2" vid="PSA 135:4">Israaʼelin immoo dhaala dhuunfaa isaa godhee filateeraatii.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Ani akka <char style="nd">Waaqayyo</char> guddaa taʼe,</para>
  <para style="q2" vid="PSA 135:5">akka Gooftaan keenya waaqota hunda caalaa guddaa taʼe beeka.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>
    <char style="nd">Waaqayyo</char> samiiwwan keessattii fi lafa irratti,</para>
  <para style="q2" vid="PSA 135:6">galaanotaa fi tuujuba isaanii hunda keessatti,</para>
  <para style="q2" vid="PSA 135:6">waan isa gammachiisu kam iyyuu ni hojjeta.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Inni akka duumessoonni daarii lafaatii kaʼan ni godha;</para>
  <para style="q2" vid="PSA 135:7">bokkaa wajjin balaqqee erga;</para>
  <para style="q2" vid="PSA 135:7">gombisaa isaa keessaas bubbee gad baasa.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>Inni hangafoota Gibxi,</para>
  <para style="q2" vid="PSA 135:8">kan namaatii fi kan horii ni dhaʼe.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>Yaa Gibxi, inni gidduu keetti,</para>
  <para style="q2" vid="PSA 135:9">Faraʼoonii fi tajaajiltoota isaa hundatti mallattoo fi dinqii isaa ergeera.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>Inni saboota baayʼee dhaʼee</para>
  <para style="q2" vid="PSA 135:10">mootota jajjaboo ajjeese;<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>Sihoon mootii warra Amoorotaa,</para>
  <para style="q2" vid="PSA 135:11">Oogi mootii Baashaanii fi mootota Kanaʼaan hunda ni ajjeese;<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>lafa isaanii dhaala godhee</para>
  <para style="q2" vid="PSA 135:12">akka dhaala isaanii taʼuufis saba isaa Israaʼeliif kenne.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>Yaa <char style="nd">Waaqayyo</char>, maqaan kee bara baraan jiraata;</para>
  <para style="q2" vid="PSA 135:13">yaa <char style="nd">Waaqayyo</char>, ati dhaloota hunda keessatti ni yaadatamta.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>
    <char style="nd">Waaqayyo</char> saba isaatiif ni falma;</para>
  <para style="q2" vid="PSA 135:14">tajaajiltoota isaatiifis garaa laafa.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>Waaqonni tolfamoon namoota ormaa meetii fi</para>
  <para style="q2" vid="PSA 135:15">warqee harka namaatiin hojjetamanii dha.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>Isaan afaan qabu; garuu dubbachuu hin dandaʼan;</para>
  <para style="q2" vid="PSA 135:16">ijas qabu; garuu arguu hin dandaʼan;<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>gurra qabu; garuu dhagaʼuu hin dandaʼan;</para>
  <para style="q2" vid="PSA 135:17">yookaan hafuurri tokko iyyuu afaan isaanii keessa hin jiru.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Warri isaan tolchan kanneen isaan amanatan hundi</para>
  <para style="q2" vid="PSA 135:18">akkuma isaanii taʼu.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>Yaa mana Israaʼel <char style="nd">Waaqayyoon</char> eebbisaa;</para>
  <para style="q2" vid="PSA 135:19">yaa mana Aroon <char style="nd">Waaqayyoon</char> eebbisaa;<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>yaa mana Lewwii <char style="nd">Waaqayyoon</char> eebbisaa;</para>
  <para style="q2" vid="PSA 135:20">isin warri isa sodaattanis, <char style="nd">Waaqayyoon</char> eebbisaa.<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>
    <char style="nd">Waaqayyo</char> inni Yerusaalem keessa jiraatu sun,</para>
  <para style="q2" vid="PSA 135:21">Xiyoon irraa haa eebbifamu.</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">Haalleluuyaa!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">Faarfannaa 136</para>
  <para style="ms1">Faarfannaa Wal jalaa Qabanii Faarfatan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>
    <char style="nd">Waaqayyoof</char> galata galchaa; inni gaariidhaatii.</para>
  <para style="qr" vid="PSA 136:1">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Waaqa waaqotaatiif galata galchaa.</para>
  <para style="qr" vid="PSA 136:2">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Gooftaa Gooftotaatiif galata galchaa:</para>
  <para style="qr" vid="PSA 136:3">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>inni kophaa isaa dinqii gurguddaa hojjeta;</para>
  <para style="qr" vid="PSA 136:4">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>inni ogummaa isaatiin samiiwwan uume;</para>
  <para style="qr" vid="PSA 136:5">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>inni bishaanota irratti lafa diriirse;</para>
  <para style="qr" vid="PSA 136:6">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>inni ifa gurguddaa hojjete;</para>
  <para style="qr" vid="PSA 136:7">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>inni akka biiftuun guyyaa mootu godhe;</para>
  <para style="qr" vid="PSA 136:8">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>inni akka jiʼii fi urjiiwwan halkan moʼan godhe;</para>
  <para style="qr" vid="PSA 136:9">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>inni hangafa Gibxi dhaʼe;</para>
  <para style="qr" vid="PSA 136:10">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>inni isaan gidduudhaa Israaʼelin baase;</para>
  <para style="qr" vid="PSA 136:11">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>harka jabaa fi irree diriiraadhaan Israaʼelin baase;</para>
  <para style="qr" vid="PSA 136:12">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>inni Galaana Diimaa iddoo lamatti gargarii qoode;</para>
  <para style="qr" vid="PSA 136:13">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>inni galaana gidduudhaan Israaʼelin dabarse;</para>
  <para style="qr" vid="PSA 136:14">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>Faraʼoonii fi loltoota isaa garuu Galaana Diimaatti naqe;</para>
  <para style="qr" vid="PSA 136:15">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>inni saba ofii isaa gammoojjii keessa geggeesse;</para>
  <para style="qr" vid="PSA 136:16">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>inni mootota gurguddaa dhaʼe;</para>
  <para style="qr" vid="PSA 136:17">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>inni mootota jajjaboo fixe;</para>
  <para style="qr" vid="PSA 136:18">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>inni Sihoon mootii Amoorotaa ajjeese;</para>
  <para style="qr" vid="PSA 136:19">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>inni Oogi mootii Baashaan ajjeese;</para>
  <para style="qr" vid="PSA 136:20">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>inni biyya isaanii dhaala godhee kenne;</para>
  <para style="qr" vid="PSA 136:21">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>dhaala godhee garbicha isaa Israaʼeliif kenne;</para>
  <para style="qr" vid="PSA 136:22">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>Inni yeroo nu gad deebinetti nu yaadate;</para>
  <para style="qr" vid="PSA 136:23">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>inni harka diinota keenyaatii nu baase,</para>
  <para style="qr" vid="PSA 136:24">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>inni uumama hundaaf soora kenna;</para>
  <para style="qr" vid="PSA 136:25">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Waaqa samiitiif galata galchaa.</para>
  <para style="qr" vid="PSA 136:26">Jaalalli isaa bara baraan jiraata.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">Faarfannaa 137</para>
  <para style="ms1">Faarfannaa Boojiʼamtootaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>Nu yeroo Xiyoonin yaadannetti,</para>
  <para style="q2" vid="PSA 137:1">lageen Baabilon bira teenyee boonye.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>Achittis kiraara keenya</para>
  <para style="q2" vid="PSA 137:2">muka alaltuutti fannifne;<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>achitti warri nu boojiʼan faarfannaa, warri nu dhiphisanis,</para>
  <para style="q2" vid="PSA 137:3">“Faarfannaawwan Xiyoon keessaa tokko nuu faarfadhaa!”</para>
  <para style="q2" vid="PSA 137:3">jedhanii akka nu faarfannaa gammachuu isaaniif faarfannu nu gaafatan.<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>Nu utuu biyya ormaa jirruu,</para>
  <para style="q2" vid="PSA 137:4">akkamitti faarfannaa <char style="nd">Waaqayyoo</char> faarfachuu dandeenya?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>Yaa Yerusaalem, yoo ani si irraanfadhe,</para>
  <para style="q2" vid="PSA 137:5">harki koo mirgaa ogummaa isaa haa irraanfatu.<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>Yoo ani si yaadachuu baadhe,</para>
  <para style="q2" vid="PSA 137:6">yoo ani gammachuu koo guddichaa olitti</para>
  <para style="q1" vid="PSA 137:6">Yerusaalemin ilaaluu baadhe,</para>
  <para style="q2" vid="PSA 137:6">arrabni koo laagaa kootti haa maxxanu.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>Yaa <char style="nd">Waaqayyo</char>, waan warri Edoom</para>
  <para style="q2" vid="PSA 137:7">gaafa Yerusaalem diigamte jedhan sana yaadadhu;</para>
  <para style="q1" vid="PSA 137:7">isaanis, “Ishee diigaa!</para>
  <para style="q2" vid="PSA 137:7">Hamma hundee isheetti ishee diigaa!” jedhanii iyyan.<verse eid="PSA 137:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>Yaa intala Baabilon, kan baduudhaaf qophoofte,</para>
  <para style="q2" vid="PSA 137:8">inni waan ati nu goote sanaaf,</para>
  <para style="q2" vid="PSA 137:8">gatii kee siif kennu eebbifamaa dha.<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>Inni daaʼimman kee qabee</para>
  <para style="q2" vid="PSA 137:9">dhagaa irratti caccabsu sun eebbifamaa dha.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">Faarfannaa 138</para>
  <para style="ms1">Faarfannaa Galataa</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>Yaa <char style="nd">Waaqayyo</char>, ani garaa koo guutuudhaan sin galateeffadha;</para>
  <para style="q2" vid="PSA 138:1">fuula “waaqotaa” durattis galata kee nan faarfadha.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Sababii ati maqaa keetii fi dubbii kee waan hundaa olitti guddifteef,</para>
  <para style="q2" vid="PSA 138:2">ani sababii jaalalaa fi amanamummaa keetiitiif</para>
  <para style="q1" vid="PSA 138:2">gara mana qulqullummaa kee qulqullichaatti gad jedhee,</para>
  <para style="q2" vid="PSA 138:2">maqaa kee nan leellisa.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>Yeroo ani si waammadhetti ati deebii naa kennite;</para>
  <para style="q2" vid="PSA 138:3">irree keetiinis na jabeessite.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>Yaa <char style="nd">Waaqayyo</char>, mootonni lafaa hundinuu,</para>
  <para style="q2" vid="PSA 138:4">yeroo dubbii afaan keetii dhagaʼanitti si haa leellisan.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Ulfinni <char style="nd">Waaqayyoo</char>, guddaadhaatii,</para>
  <para style="q2" vid="PSA 138:5">isaan waaʼee karaa <char style="nd">Waaqayyoo</char> haa faarfatan.<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>
    <char style="nd">Waaqayyo</char> yoo ol fagoo jiraate iyyuu, <optbreak/> nama gad qabame ni ilaala;</para>
  <para style="q2" vid="PSA 138:6">nama of tuulu immoo fagootti beeka.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Ani rakkina keessa jiraadhu iyyuu,</para>
  <para style="q2" vid="PSA 138:7">ati lubbuu koo ni eegda;</para>
  <para style="q1" vid="PSA 138:7">aarii diina kootti harka kee ni diriirsita;</para>
  <para style="q2" vid="PSA 138:7">harka kee mirgaatiinis na oolchita.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>
    <char style="nd">Waaqayyo</char> kaayyoo isaa fiixaan naa baasa;</para>
  <para style="q2" vid="PSA 138:8">yaa <char style="nd">Waaqayyo</char>, jaalalli kee bara baraan jiraata;</para>
  <para style="q2" vid="PSA 138:8">hojii harka keetii hin gatin.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">Faarfannaa 139</para>
  <para style="ms1">Waaqa Waan Hunda Beeku</para>
  <para style="d">Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>Yaa <char style="nd">Waaqayyo</char>, ati na qorteerta;</para>
  <para style="q2" vid="PSA 139:1">na beekteertas.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Ati yeroo ani gad taaʼuu fi yeroo ani ol kaʼu ni beekta;</para>
  <para style="q2" vid="PSA 139:2">yaada koos fagootti hubatta.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Deemuu koo fi ciisuu koo addaan baaftee beekta;</para>
  <para style="q2" vid="PSA 139:3">karaa koo hundas beekta.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>Yaa <char style="nd">Waaqayyo</char>, akka dubbiin tokko iyyuu arraba koo hin jirre,</para>
  <para style="q2" vid="PSA 139:4">ati guutumaan guutuutti ni beekta.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Ati duraa fi duubaan na marsiteerta;</para>
  <para style="q2" vid="PSA 139:5">harka kees narra keesseerta.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>Beekumsi akkanaa anaaf akka malee dinqii dha;</para>
  <para style="q2" vid="PSA 139:6">hubachuufis akka malee narraa fagoo dha.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>Hafuura kee biraa ani eessa dhaquun dandaʼa?</para>
  <para style="q2" vid="PSA 139:7">Fuula kee duraas ani eessatti baqachuun dandaʼa?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>Yoo ani samiiwwanitti ol baʼe, ati achi jirta;</para>
  <para style="q2" vid="PSA 139:8">yoo ani siree koo siiʼool keessa dhaabbadhes, achis ni jirta.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Yoo ani qoochoo ganamaatiin</para>
  <para style="q2" vid="PSA 139:9">barrisee qarqara galaanaa fagoo irra qubadhe,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>achittis harki kee karaa na argisiisa;</para>
  <para style="q2" vid="PSA 139:10">harki kee mirgaas jabeessee na qaba.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>Yoo ani, “Dhugumaan dukkanni na dhoksa;</para>
  <para style="q2" vid="PSA 139:11">ifnis naannoo kootti halkan taʼa” jedhe,<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>dukkanni iyyuu siif dukkana hin taʼu;</para>
  <para style="q2" vid="PSA 139:12">halkanis akkuma guyyaa ifa;</para>
  <para style="q2" vid="PSA 139:12">dukkanni siif akkuma ifaatii.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>Ati namummaa koo isa keessaa uumteertaatii;</para>
  <para style="q2" vid="PSA 139:13">gadameessa haadha koo keessattis na tolchite.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Ani sababii haala sodaachisaa fi dinqisiisaadhaan uumameef</para>
  <para style="q2" vid="PSA 139:14">sin galateeffadha;</para>
  <para style="q1" vid="PSA 139:14">hojiin kee dinqisiisaa dha;</para>
  <para style="q2" vid="PSA 139:14">kanas ani akka gaariittan beeka.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>Yeroo ani iddoo dhoksaatti uumame,</para>
  <para style="q2" vid="PSA 139:15">lafeen koo si duraa hin dhokanne.</para>
  <para style="q2" vid="PSA 139:15">Yeroo ani dhidhima lafaa keessatti tolfame,<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>iji kee dhagna koo kan hin tolfamin arge.</para>
  <para style="q2" vid="PSA 139:16">Guyyoonni duraan dursanii naaf murteeffaman hundi <optbreak/> utuu hin jiraatin,</para>
  <para style="q2" vid="PSA 139:16">kitaaba kee keessatti barreeffamaniiru.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>Yaa Waaqi, yaada kee hubachuun akkam ulfaata!</para>
  <para style="q2" vid="PSA 139:17">Baayʼinni isaas akkam guddaa dha!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Utuu ani isaan lakkaaʼee jiraadhee,</para>
  <para style="q2" vid="PSA 139:18">silaa lakkoobsi isaanii cirracha irra baayʼata.</para>
  <para style="q2" vid="PSA 139:18">Ani yeroon dammaqutti, amma iyyuu suma wajjinan jira.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>Maaloo yaa Waaqi, ati utuu hamoota fixxee!</para>
  <para style="q2" vid="PSA 139:19">Warri dhiiga namaa dhangalaaftan, narraa fagaadhaa!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Isaan yaada hamaadhaan waaʼee kee dubbatu;</para>
  <para style="q2" vid="PSA 139:20">diinonni kee akkasumaan maqaa kee dhaʼu.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>Yaa <char style="nd">Waaqayyo</char>, ani warra si jibban hin jibbuu?</para>
  <para style="q2" vid="PSA 139:21">Warra sitti kaʼanis hin xireeffadhuu?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Ani hamma dhumaatti isaan jibbeera;</para>
  <para style="q2" vid="PSA 139:22">akka diina koottis isaan nan heda.<verse eid="PSA 139:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>Yaa Waaqi, na sakattaʼi; garaa koos beeki;</para>
  <para style="q2" vid="PSA 139:23">qoriitii na ilaali; yaada koos beeki.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Yoo karaan hamminaa na keessa jiraate mee ilaali;</para>
  <para style="q2" vid="PSA 139:24">karaa bara baraa irras na adeemsisi.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">Faarfannaa 140</para>
  <para style="ms1">Kadhannaa Hamoota Irratti Dhiʼaate</para>
  <para style="d">Dura Buʼaa faarfattootaatiif. Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>Yaa <char style="nd">Waaqayyo</char>, namoota hamoo jalaa na baasi;</para>
  <para style="q2" vid="PSA 140:1">namoota finciltoota<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>warra garaa isaanii keessatti hammina yaadanii</para>
  <para style="q2" vid="PSA 140:2">guyyaa hunda waraana kaasan narraa eegi.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Isaan arraba isaanii akkuma bofaa qaratu;</para>
  <para style="q2" vid="PSA 140:3">hadhaan buutii hidhii isaanii jala jira.<verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>Yaa <char style="nd">Waaqayyo</char>, harka hamootaa narraa eegi;</para>
  <para style="q2" vid="PSA 140:4">namoota finciltoota <optbreak/> warra miilla koo kiyyootti galchuu yaadan jalaa na baasi.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>Of tuultonni dhoksanii kiyyoo na dura kaaʼaniiru;</para>
  <para style="q2" vid="PSA 140:5">ribuu kiyyoo isaanii diriirsaniiru;</para>
  <para style="q2" vid="PSA 140:5">karaa koo irras kiyyoo isaanii kaaʼaniiru.<verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>Yaa <char style="nd">Waaqayyo</char>, ani, “Ati Waaqa koo ti” siin nan jedha.</para>
  <para style="q2" vid="PSA 140:6">Yaa <char style="nd">Waaqayyo</char>, waammata koo dhagaʼi.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>Yaa <char style="nd">Waaqayyo</char> Gooftaa, fayyisaa koo jabaa,</para>
  <para style="q2" vid="PSA 140:7">ati guyyaa waraanaatti gaachana mataa naa taate.<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>Yaa <char style="nd">Waaqayyo</char>, akka fedhiin hamootaa fiixaan baʼu hin godhin;</para>
  <para style="q2" vid="PSA 140:8">akka isaan of hin tuulleef, akka karoorri isaanii milkaaʼu hin godhin.<verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>Mataan warra na marsanii,</para>
  <para style="q2" vid="PSA 140:9">hammina afaan isaaniitii baʼuun haa haguugamu.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Barbadaan ibiddaa isaan irra haa buʼu;</para>
  <para style="q2" vid="PSA 140:10">isaan ibiddatti illee haa darbataman;</para>
  <para style="q2" vid="PSA 140:10">akka lammata hin kaaneefis boolla qileetti haa darbataman.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Maqa balleessitoonni lafa irra hin jiraatin;</para>
  <para style="q2" vid="PSA 140:11">namni jalʼaan waan hamaadhaan haa badu.<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>
    <char style="nd">Waaqayyo</char> rakkattootaaf falmee</para>
  <para style="q2" vid="PSA 140:12">hiyyeeyyiif illee murtii qajeelaa akka kennu ani beeka.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Dhugumaan namni qajeelaan maqaa kee ni galateeffata;</para>
  <para style="q2" vid="PSA 140:13">namni tolaanis fuula kee dura ni jiraata.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">Faarfannaa 141</para>
  <para style="ms1">Akka Qananii Jaldhootaatiin Hin fudhatamne Waaqa Kadhachuu</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>Yaa <char style="nd">Waaqayyo</char>, ani sin waammadha; dafii na qaqqabi.</para>
  <para style="q2" vid="PSA 141:1">Yommuu ani si waammadhus sagalee koo dhagaʼi.<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>Kadhannaan koo fuula kee duratti akka ixaanaatti anaaf haa fudhatamu;</para>
  <para style="q2" vid="PSA 141:2">harka koo ol qabachuun koos akka aarsaa galgalaa anaaf haa taʼu.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>Yaa <char style="nd">Waaqayyo</char>, afaan kootiif eegduu naa dhaabi;</para>
  <para style="q2" vid="PSA 141:3">balbala afaan kootiis naa eegi.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Garaan koo namoota waan hamaa hojjetan wajjin,</para>
  <para style="q2" vid="PSA 141:4">hojii hamminaa keessatti hirmaachuuf,</para>
  <para style="q1" vid="PSA 141:4">gara jalʼina kamiitti iyyuu hin harkifamin;</para>
  <para style="q2" vid="PSA 141:4">akka ani nyaata isaanii miʼaawaa nyaadhus anaaf hin eeyyamin.<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Namni qajeelaan na haa rukutu; kun gara laafinaatii;</para>
  <para style="q2" vid="PSA 141:5">inni ana haa ifatu; kunis zayitii mataa koo irraatti.</para>
  <para style="q1" vid="PSA 141:5">Mataan koo waan kana hin didu.</para>
  <para style="q2" vid="PSA 141:5">Taʼus kadhannaan koo yoom iyyuu hojii hamootaatiin mormuu dha.<verse eid="PSA 141:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>Bulchitoonni isaanii ededa boollaa irraa gad ni darbatamu;</para>
  <para style="q2" vid="PSA 141:6">isaan dubbii koo ni dhagaʼu; dubbiin koo ni miʼaawaatii.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Isaanis, “Akkuma namni lafa qotu biyyoo bulleessu sana,</para>
  <para style="q2" vid="PSA 141:7">lafeen keenya afaan siiʼool irratti bittinneeffamee jira” jedhu.<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>Yaa <char style="nd">Waaqayyo</char> Gooftaa, ani garuu ija koo sirraa hin buqqifadhu;</para>
  <para style="q2" vid="PSA 141:8">ani kooluu sitti galeera; dabarsitee duʼatti na hin kennin.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Kiyyoo isaan naaf kaaʼan irraa,</para>
  <para style="q2" vid="PSA 141:9">kiyyoo warri jalʼina hojjetan naaf qopheessan irraas na eegi.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Warri hamoon kiyyoo ofii isaaniitiin haa qabaman;</para>
  <para style="q2" vid="PSA 141:10">ani garuu nagumaan nan baʼa.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">Faarfannaa 142</para>
  <para style="ms1">Kadhannaa Nama Ariʼatamaa Jiru Tokkoo</para>
  <para style="d">
    <char style="tl">Maaskiilii</char> Daawit</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>Ani gara <char style="nd">Waaqayyotti</char> nan iyya;</para>
  <para style="q2" vid="PSA 142:1">sagalee kootiinis fuula <char style="nd">Waaqayyoo</char> duratti <optbreak/> waammata koo nan dhiʼeeffadha.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Ani guungummii koo fuula isaa duratti nan dhangalaasa;</para>
  <para style="q2" vid="PSA 142:2">dhibee koos fuula isaa duratti nan himadha.<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>Yeroof hafuurri koo na keessatti laafu,</para>
  <para style="q2" vid="PSA 142:3">situ karaa koo beeka.</para>
  <para style="q1" vid="PSA 142:3">Namoonni daandii ani deemu irra,</para>
  <para style="q2" vid="PSA 142:3">kiyyoo naa kaaʼaniiru.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Gara mirga koo ilaali; argis;</para>
  <para style="q2" vid="PSA 142:4">namni naa yaadu tokko iyyuu hin jiru;</para>
  <para style="q1" vid="PSA 142:4">ani iddoon itti kooluu galu tokko illee hin qabu;</para>
  <para style="q2" vid="PSA 142:4">namni jireenya kootiif yaadus hin jiru.<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>Yaa <char style="nd">Waaqayyo</char>, sitti nan iyyadha;</para>
  <para style="q2" vid="PSA 142:5">“Ati iddoo ani itti kooluu galuu dha;</para>
  <para style="q2" vid="PSA 142:5">biyya warra jiraatoo keessattis ati qooda koo ti” nan jedha.<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>Ani abdii kutadheeraatii,</para>
  <para style="q2" vid="PSA 142:6">kadhannaa koo naa dhagaʼi;</para>
  <para style="q1" vid="PSA 142:6">warra na ariʼatan jalaa na baasi;</para>
  <para style="q2" vid="PSA 142:6">isaan akka malee natti cimaniiruutii.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>Akka ani maqaa kee galateeffadhuuf,</para>
  <para style="q2" vid="PSA 142:7">lubbuu koo mana hidhaatii naa baasi.</para>
  <para style="b" vid="PSA 142:7"/>
  <para style="q1" vid="PSA 142:7">Sababii ati waan gaarii naa gooteef,</para>
  <para style="q2" vid="PSA 142:7">qajeeltonni naannoo kootti walitti qabamu.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">Faarfannaa 143</para>
  <para style="ms1">Gad of qabanii Waaqa Kadhachuu</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>Yaa <char style="nd">Waaqayyo</char>, kadhannaa koo naa dhagaʼi;</para>
  <para style="q2" vid="PSA 143:1">gurra kees gara waammata kootiitti deebisi;</para>
  <para style="q1" vid="PSA 143:1">amanamummaa fi</para>
  <para style="q2" vid="PSA 143:1">qajeelummaa keetiin, na gargaari.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>Ati garbicha kee murtiitti hin dhiʼeessin;</para>
  <para style="q2" vid="PSA 143:2">namni lubbuun jiraatu kam iyyuu fuula kee duratti qajeelaa mitiitii.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Diinni lubbuu koo ariʼachaa jiraatii;</para>
  <para style="q2" vid="PSA 143:3">jireenya koos butuchee biyyootti make.</para>
  <para style="q1" vid="PSA 143:3">Akkuma warra dur duʼaniittis</para>
  <para style="q2" vid="PSA 143:3">dukkana keessa na jiraachiseera.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Kanaafuu hafuurri koo na keessatti gaggabeera;</para>
  <para style="q2" vid="PSA 143:4">onneen koos na keessatti rifatteerti.<verse eid="PSA 143:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Ani guyyoota durii nan yaadadha;</para>
  <para style="q2" vid="PSA 143:5">waan ati hojjette hundas irra deddeebiʼee nan yaada;</para>
  <para style="q2" vid="PSA 143:5">waan harki kee hojjete illee nan heda.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Harka koo gara keetti nan diriirfadha;</para>
  <para style="q2" vid="PSA 143:6">lubbuun koos akkuma lafa gogaa si dheebotti.<verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>Yaa <char style="nd">Waaqayyo</char>, dafii deebii naa kenni;</para>
  <para style="q2" vid="PSA 143:7">hafuurri koo dadhabeera.</para>
  <para style="q1" vid="PSA 143:7">Fuula kee na duraa hin dhoksin</para>
  <para style="q2" vid="PSA 143:7">yookaan ani akka warra boolla buʼanii nan taʼa.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Ani waanan si amanadheef,</para>
  <para style="q2" vid="PSA 143:8">akka ani ganama ganama oduu jaalala keetii dhagaʼu godhi.</para>
  <para style="q1" vid="PSA 143:8">Ani lubbuu koo gara keetti ol nan kaasaatii,</para>
  <para style="q2" vid="PSA 143:8">karaa ani irra deemuu qabu natti argisiisi.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>Yaa <char style="nd">Waaqayyo</char>, ani akka ati na dhoksituuf <optbreak/> sitti nan baqadhaatii,</para>
  <para style="q2" vid="PSA 143:9">diinota koo jalaa na baasi.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Ati sababii Waaqa koo taateef,</para>
  <para style="q2" vid="PSA 143:10">akka ani fedhii kee guutu na barsiisi;</para>
  <para style="q1" vid="PSA 143:10">hafuurri kee gaariin sun</para>
  <para style="q2" vid="PSA 143:10">karaa wal qixxee irra na haa qajeelchu.<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>Yaa <char style="nd">Waaqayyo</char>, maqaa keetii jedhiitii lubbuu koo jiraachisi;</para>
  <para style="q2" vid="PSA 143:11">qajeelummaa keetiinis rakkina keessaa na baasi.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Ati sababii na jaallattuuf diinota koo fixi;</para>
  <para style="q2" vid="PSA 143:12">waan ani garbicha kee taʼeef,</para>
  <para style="q2" vid="PSA 143:12">warra na cunqursan hunda barbadeessi.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">Faarfannaa 144</para>
  <para style="ms1">Moʼannaa Argachuuf Kadhachuu</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>
    <char style="nd">Waaqayyo</char> kattaa koo,</para>
  <para style="q2" vid="PSA 144:1">isa harka koo waraanaaf,</para>
  <para style="q2" vid="PSA 144:1">quba koos lolaaf leenjisu sanaaf galanni haa gaʼu.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>Inni Waaqa na jaallatuu fi daʼoo koo ti;</para>
  <para style="q2" vid="PSA 144:2">iddoo ani itti daʼadhuu fi fayyisaa koo ti.</para>
  <para style="q1" vid="PSA 144:2">Gaachana koo, iddoo ani itti kooluu galu,</para>
  <para style="q2" vid="PSA 144:2">kan na jalatti saba naaf bulchuu dha.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>Yaa <char style="nd">Waaqayyo</char>, akka ati waaʼee isaa yaadduuf, namni maali?</para>
  <para style="q2" vid="PSA 144:3">Akka ati isaaf yaadduuf ilmi namaa maali?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>Namni akkuma qilleensa shuf jedhee darbuuti,</para>
  <para style="q2" vid="PSA 144:4">barri isaas akkuma gaaddisa darbuu ti.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>Yaa <char style="nd">Waaqayyo</char>, samiiwwan kee tarsaasii gad buʼi;</para>
  <para style="q2" vid="PSA 144:5">akka aarri isaan keessaa yaaʼuufis tulluuwwan tuqi.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Bakakkaa ergiitii diina bittinneessi;</para>
  <para style="q2" vid="PSA 144:6">xiyya kee darbadhuutii isaan balleessi.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Ol gubbaadhaa harka kee gad hiixadhuutii</para>
  <para style="q2" vid="PSA 144:7">bishaan jabaa jalaa,</para>
  <para style="q1" vid="PSA 144:7">harka alagaa duraas,</para>
  <para style="q2" vid="PSA 144:7">na baasi; na oolchis;<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>warra afaan isaanii sobaan guutame,</para>
  <para style="q2" vid="PSA 144:8">warra harki isaanii mirgaa nama dogoggorsu duraa na baasi.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>Yaa Waaqi, ani faarfannaa haaraa siif nan faarfadha;</para>
  <para style="q2" vid="PSA 144:9">kiraara ribuu kudhaniitiinis siifin weeddisa;<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>isa moototaaf moʼannoo kennuuf, isa garbicha isaa Daawitin</para>
  <para style="q2" vid="PSA 144:10">goraadee nama ajjeesu jalaa baasuuf nan faarfadha.<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Harka Ormootaa duraa,</para>
  <para style="q2" vid="PSA 144:11">warra afaan isaanii sobaan guutame,</para>
  <para style="q1" vid="PSA 144:11">warra harki isaanii mirgaa</para>
  <para style="q2" vid="PSA 144:11">nama dogoggorsu jalaa na baasi; na oolchis.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Ilmaan keenya dargaggummaa isaanii keessatti,</para>
  <para style="q2" vid="PSA 144:12">akka biqiltuu tolee guddatee haa taʼan;</para>
  <para style="q1" vid="PSA 144:12">intallan keenyas akka utubaa golee,</para>
  <para style="q2" vid="PSA 144:12">kan masaraa mootummaa miidhagsuuf <optbreak/> soofamee haa taʼan.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Gombisaawwan keenya,</para>
  <para style="q2" vid="PSA 144:13">midhaan gosa garaa garaatiin haa guutaman.</para>
  <para style="q1" vid="PSA 144:13">Hoolonni keenya kumaatama haa dhalan;</para>
  <para style="q2" vid="PSA 144:13">dirree keenya irrattis kumaatama kudhaniin <optbreak/> haa baayʼatan;<verse eid="PSA 144:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14"/>loon keenya haa dorroban hin gatatin</para>
  <para style="q1" vid="PSA 144:14">yookaan yeroo malee hin dhalin;</para>
  <para style="q2" vid="PSA 144:14">boojiʼamuunis hin jiraatin;</para>
  <para style="q2" vid="PSA 144:14">wawwaachuunis karaa keenya irratti hin dhagaʼamin.<verse eid="PSA 144:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>Warri eebbi kun taʼeef haa gammadan;</para>
  <para style="q2" vid="PSA 144:15">warri <char style="nd">Waaqayyo</char> Waaqa isaanii taʼeef eebbifamoo dha.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">Faarfannaa 145</para>
  <para style="ms1">Waaqayyo Mootichaaf Galata Galchuu</para>
  <para style="d">Faarfannaa Daawit.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>Yaa Waaqa koo Mooticha, ani sin leellisa;</para>
  <para style="q2" vid="PSA 145:1">bara baraa hamma bara baraattis maqaa kee nan galateeffadha.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Ani guyyuma guyyaan sin galateeffadha;</para>
  <para style="q2" vid="PSA 145:2">bara baraa hamma bara baraattis maqaa kee nan leellisa.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>
    <char style="nd">Waaqayyo</char> guddaa dha; galateeffamuunis baayʼee malaaf;</para>
  <para style="q2" vid="PSA 145:3">guddina isaa qoratanii itti baʼuun hin dandaʼamu.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Dhaloonni tokko dhaloota biraatti hojii kee ni hima;</para>
  <para style="q2" vid="PSA 145:4">hojiiwwan kee jajjaboos ni labsa.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Isaanis waaʼee miidhagina ulfina qabeessa <optbreak/> surraa kee sanaa ni dubbatu;</para>
  <para style="q2" vid="PSA 145:5">anis waaʼee hojii kee dinqisiisaa sanaa irra deddeebiʼee <optbreak/> itti nan yaada.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Isaan waaʼee hojii kee sodaachisaa sanaa ni odeessu;</para>
  <para style="q2" vid="PSA 145:6">anis guddina kee nan labsa.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Isaan yaadannoo gaarummaa keetii baayʼisanii odeessu;</para>
  <para style="q2" vid="PSA 145:7">waaʼee qajeelummaa keetiis ililchanii faarfatu.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>
    <char style="nd">Waaqayyo</char> arjaa fi gara laafessa;</para>
  <para style="q2" vid="PSA 145:8">inni aaruuf hin ariifatu; jaalalli isaas baayʼee dha.<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>
    <char style="nd">Waaqayyo</char>, nama hundaaf gaarii dha;</para>
  <para style="q2" vid="PSA 145:9">inni waan uume hundaaf garaa ni laafa.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>Yaa <char style="nd">Waaqayyo</char>, hojiin kee hundinuu si galateeffata;</para>
  <para style="q2" vid="PSA 145:10">qulqulloonni kees si leellisu.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Isaan waaʼee ulfina mootummaa keetii ni odeessu;</para>
  <para style="q2" vid="PSA 145:11">waaʼee humna keetiis ni dubbatu;<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>kunis akka namoonni hundi hojii kee humna qabeessa,</para>
  <para style="q2" vid="PSA 145:12">surraa ulfina qabeessa mootummaa kee sanaas beekaniif.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Mootummaan kee mootummaa bara baraa ti;</para>
  <para style="q2" vid="PSA 145:13">bulchiinsi kees dhalootaa gara dhalootaatti darba.</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">
    <char style="nd">Waaqayyo</char> dubbii isaa hundaan amanamaa dha;</para>
  <para style="q2" vid="PSA 145:13">hojii isaa hundaanis arjaa dha.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>
    <char style="nd">Waaqayyo</char> warra kufan hunda ol qaba;</para>
  <para style="q2" vid="PSA 145:14">warra gad qabaman hundas ni kaasa.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>Iji nama hundaa si eeggata;</para>
  <para style="q2" vid="PSA 145:15">atis yeroo barbaachisutti nyaata isaaniif ni kennita.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Ati harka kee balʼiftee</para>
  <para style="q2" vid="PSA 145:16">fedhii warra lubbuu qaban hundaa ni guutta.<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>
    <char style="nd">Waaqayyo</char> karaa isaa hundaan qajeelaa dha;</para>
  <para style="q2" vid="PSA 145:17">hojii isaa hundaanis arjaa dha.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>
    <char style="nd">Waaqayyo</char> warra isa waammatan hundatti,</para>
  <para style="q2" vid="PSA 145:18">warra dhugaadhaan isa waammatan hundatti dhiʼoo dha.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>Inni fedhii warra isa sodaatanii ni guuta;</para>
  <para style="q2" vid="PSA 145:19">kadhannaa isaanis dhagaʼee isaan oolcha.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>
    <char style="nd">Waaqayyo</char> warra isa jaallatan hunda ni eega;</para>
  <para style="q2" vid="PSA 145:20">jalʼoota hunda garuu ni balleessa.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Afaan koo <char style="nd">Waaqayyoon</char> galateeffachuudhaan ni dubbata.</para>
  <para style="q2" vid="PSA 145:21">Uumamni hundinuu maqaa isaa qulqulluu sana</para>
  <para style="q2" vid="PSA 145:21">bara baraa hamma bara baraatti haa eebbisu.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">Faarfannaa 146</para>
  <para style="ms1">Waaqa Nama Gargaaru Faarfachuu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q1" vid="PSA 146:1">Yaa lubbuu ko, <char style="nd">Waaqayyoon</char> galateeffadhu.<verse eid="PSA 146:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>Ani bara jireenya koo guutuu <char style="nd">Waaqayyoon</char> nan galateeffadha;</para>
  <para style="q2" vid="PSA 146:2">ani hamman jirutti Waaqaaf nan faarfadha.<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>Abdii keessan bulchitoota irra,</para>
  <para style="q2" vid="PSA 146:3">namoota duʼa hin oolle <optbreak/> warra isin gargaaruu hin dandeenye irra hin kaaʼatinaa.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>Isaan yeruma lubbuun isaan keessaa baatu gara lafaatti deebiʼu;</para>
  <para style="q2" vid="PSA 146:4">guyyuma sanas karoorri isaanii bada.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>Namni gargaarsi isaa Waaqa Yaaqoob taʼe, kan abdiin isaas</para>
  <para style="q2" vid="PSA 146:5">
    <char style="nd">Waaqayyo</char> Waaqa isaa taʼe eebbifamaa dha.<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>
    <char style="nd">Waaqayyo</char> Uumaa samii fi lafaa,</para>
  <para style="q2" vid="PSA 146:6">galaanaa fi waan isaan keessa jiru hundaa ti;</para>
  <para style="q2" vid="PSA 146:6">inni bara baraan amanamaa taʼe jiraata.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Inni warra cunqurfamaniif ni mura;</para>
  <para style="q2" vid="PSA 146:7">warra beelaʼaniif nyaata kenna.</para>
  <para style="q1" vid="PSA 146:7">
    <char style="nd">Waaqayyo</char> warra hidhaman illee ni hiika;<verse eid="PSA 146:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8"/>
    <char style="nd">Waaqayyo</char> jaamotaaf agartuu ni kenna;</para>
  <para style="q1" vid="PSA 146:8">
    <char style="nd">Waaqayyo</char> warra gad deebiʼan ol qaba;</para>
  <para style="q2" vid="PSA 146:8">
    <char style="nd">Waaqayyo</char> qajeeltota ni jaallata.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>
    <char style="nd">Waaqayyo</char> alagaadhaaf eegumsa ni godha;</para>
  <para style="q2" vid="PSA 146:9">ijoollee haadhaa fi abbaa hin qabnee fi</para>
  <para style="q1" vid="PSA 146:9">dubartoota dhirsoonni irraa duʼan ni jiraachisa;</para>
  <para style="q2" vid="PSA 146:9">karaa jalʼootaa garuu ni balleessa.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>
    <char style="nd">Waaqayyo</char> bara baraan ni moʼa;</para>
  <para style="q2" vid="PSA 146:10">Yaa Xiyoon, Waaqni kee dhaloota hundaaf mootii taʼa.</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q1" vid="PSA 146:10">Haalleluuyaa.<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">Faarfannaa 147</para>
  <para style="ms1">Faarfannaa Waaqa Waan Hunda Dandaʼuuf Faarfatame</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q1" vid="PSA 147:1">Faarfannaadhaan Waaqa galateeffachuun akkam gaarii dha;</para>
  <para style="q2" vid="PSA 147:1">isa galateeffachuun akkam gammachiisaa fi kan maluu dha!<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>
    <char style="nd">Waaqayyo</char> Yerusaalemin ni ijaara;</para>
  <para style="q2" vid="PSA 147:2">Israaʼeloota boojiʼamanis walitti qaba.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Warra garaan cabe ni fayyisa;</para>
  <para style="q2" vid="PSA 147:3">madaa isaaniis walitti hodha.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>Inni baayʼina urjiiwwanii ni beeka;</para>
  <para style="q2" vid="PSA 147:4">tokkoo tokkoo isaaniis maqaa maqaadhaan waama.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Gooftaan keenya guddaa dha; humni isaas jabaa dha;</para>
  <para style="q2" vid="PSA 147:5">hubannaan isaas dhuma hin qabu.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>
    <char style="nd">Waaqayyo</char> warra gad qabaman ni jiraachisa;</para>
  <para style="q2" vid="PSA 147:6">hamoota garuu lafatti darbata.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>Galata galchaa <char style="nd">Waaqayyoon</char> faarfadhaa;</para>
  <para style="q2" vid="PSA 147:7">baganaadhaanis Waaqa keenyaaf weeddisaa.<verse eid="PSA 147:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>Inni samiiwwani duumessaan haguuga;</para>
  <para style="q2" vid="PSA 147:8">lafaafis bokkaa kenna;</para>
  <para style="q2" vid="PSA 147:8">tulluuwwan irrattis marga biqilcha.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Horiidhaaf waan isaan dheedan,</para>
  <para style="q2" vid="PSA 147:9">yommuu ilmaan arraagessaa iyyanitti <optbreak/> nyaata isaaniif ni kenna.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>Inni jabina fardaatti hin gammadu;</para>
  <para style="q2" vid="PSA 147:10">yookaan miilli namaa isa hin gammachiisu;<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>
    <char style="nd">Waaqayyo</char> warra isa sodaatanitti,</para>
  <para style="q2" vid="PSA 147:11">warra araara isaa abdatanitti ni gammada.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>Yaa Yerusaalem, <char style="nd">Waaqayyoon</char> galateeffadhu;</para>
  <para style="q2" vid="PSA 147:12">Yaa Xiyoon Waaqa kee galateeffadhu.<verse eid="PSA 147:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>Inni danqaraa karra keetii ni jabeessaatii;</para>
  <para style="q2" vid="PSA 147:13">ijoollee kees si keessatti eebbisa.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>Daarii keetiif nagaa kenna;</para>
  <para style="q2" vid="PSA 147:14">qamadii qulqulluudhaanis si quubsa.<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>Inni ajaja isaa gara lafaatti ni erga;</para>
  <para style="q2" vid="PSA 147:15">dubbiin isaas ni ariifata.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>Inni cabbii akkuma suufiitti diriirsa;</para>
  <para style="q2" vid="PSA 147:16">qorras akkuma daaraatti bittinneessa.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>Dhagaa cabbii akkuma cirrachaa gad darbata.</para>
  <para style="q2" vid="PSA 147:17">Dhaamocha isaa dura eenyutu dhaabachuu dandaʼa?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>Inni dubbii isaa ergee isaan baqsa;</para>
  <para style="q2" vid="PSA 147:18">bubbee isaa ni kaasa; bishaanonnis ni yaaʼu.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>Inni dubbii isaa Yaaqoobitti,</para>
  <para style="q2" vid="PSA 147:19">seeraa fi sirna isaa immoo Israaʼelitti mulʼiseera.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>Waan kana saba biraa tokkoof iyyuu hin goone;</para>
  <para style="q2" vid="PSA 147:20">isaan seera isaa hin beekan.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">Haalleluuyaa.<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">Faarfannaa 148</para>
  <para style="ms1">Uumamni Hundi Waaqa Haa Galateeffatuu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">Samiiwwan irraa <char style="nd">Waaqayyoon</char> galateeffadhaa;</para>
  <para style="q2" vid="PSA 148:1">ol gubbaatti isa galateeffadhaa.<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Ergamoonni isaa hundinuu isa galateeffadhaa;</para>
  <para style="q2" vid="PSA 148:2">raayyaan isaa hundinuus isa galateeffadhaa.<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Aduu fi jiʼi isa galateeffadhaa;</para>
  <para style="q2" vid="PSA 148:3">urjiiwwan ibsitan hundinuus isa galateeffadhaa.<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Samiiwwan samii isa galateeffadhaa;</para>
  <para style="q2" vid="PSA 148:4">bishaanonni samiin ol jirtanis isa galateeffadhaa.<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>Isaan maqaa <char style="nd">Waaqayyoo</char> haa galateeffatan;</para>
  <para style="q2" vid="PSA 148:5">inni ajajnaan, isaan uumamaniitii.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>Inni bara baraa hamma bara baraatti isaan dhaabeera;</para>
  <para style="q2" vid="PSA 148:6">seera hin geeddaramnes isaaniif kenneera.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Uumamawwan galaanaatii fi tuujubawwan hundi,</para>
  <para style="q2" vid="PSA 148:7">lafa irraa <char style="nd">Waaqayyoon</char> galateeffadhaa;<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>bakakkaa fi dhagaan cabbii, cabbii fi duumessi,</para>
  <para style="q2" vid="PSA 148:8">bubbeen jabaan ajaja isaa raawwatan,<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>tulluuwwanii fi gaarran hundinuu,</para>
  <para style="q2" vid="PSA 148:9">mukkeen ija naqatanii fi birbirsi hundinuu,<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>bineensonnii fi loon hundinuu,</para>
  <para style="q2" vid="PSA 148:10">uumamawwan xixinnoo fi simbirroonni barrisan,<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>mootonni lafaatii fi saboonni hundinuu,</para>
  <para style="q2" vid="PSA 148:11">ilmaan moototaatii fi bulchitoonni lafaa hundinuu,<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>dargaggoonnii fi shamarran,</para>
  <para style="q2" vid="PSA 148:12">jaarsolii fi daaʼimman isa galateeffadhaa.<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>Maqaan isaa qofti ol ol jedheeraatii,</para>
  <para style="q2" vid="PSA 148:13">isaan maqaa <char style="nd">Waaqayyoo</char> haa galateeffatan;</para>
  <para style="q2" vid="PSA 148:13">ulfinni isaas lafaa fi samiiwwanii ol jira.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Inni saba isaatiif gaanfa ol kaaseera;</para>
  <para style="q2" vid="PSA 148:14">kunis qulqulloota isaa hundaaf,</para>
  <para style="q2" vid="PSA 148:14">saba Israaʼel warra isatti dhiʼoo jiran hundaaf ulfina.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">Haalleluuyaa.<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">Faarfannaa 149</para>
  <para style="ms1">Faarfannaa Moʼannoo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q1" vid="PSA 149:1">Faarfannaa haaraa <char style="nd">Waaqayyoof</char> faarfadhaa;</para>
  <para style="q2" vid="PSA 149:1">waldaa qulqullootaa keessatti illee isa jajadhaa.<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Israaʼel Uumaa isaatti haa gammadu;</para>
  <para style="q2" vid="PSA 149:2">sabni Xiyoon Mootii isaatti haa gammadu.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Maqaa isaas shuubbisuudhaan haa jajatu;</para>
  <para style="q2" vid="PSA 149:3">dibbee fi baganaadhaan isaaf haa faarfatu.<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>
    <char style="nd">Waaqayyo</char> saba isaatti ni gammadaatii;</para>
  <para style="q2" vid="PSA 149:4">warra gad of qabanis fayyina gonfachiisa.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Qulqulloonni ulfina kanatti haa gammadan;</para>
  <para style="q2" vid="PSA 149:5">siree isaanii irrattis gammachuudhaan haa faarfatan.<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Galanni Waaqaa afaan isaanii keessa haa jiraatu;</para>
  <para style="q2" vid="PSA 149:6">goraadeen afaan lamaas harka isaanii keessa haa jiraattu;<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>kunis sabootatti haaloo baʼuu fi</para>
  <para style="q2" vid="PSA 149:7">namoota adabuudhaaf;<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>mootota isaanii foncaan,</para>
  <para style="q2" vid="PSA 149:8">hangafoota isaaniis funyoo sibiilaatiin hidhuudhaaf,<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>murtii barreeffame sana isaan irratti dhugaa baʼuudhaaf.</para>
  <para style="q2" vid="PSA 149:9">Kunis amanamtoota isaa hundaaf ulfina.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">Haalleluuyaa.<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">Faarfannaa 150</para>
  <para style="ms1">Faarfannaa Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Haalleluuyaa.</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">Mana qulqullummaa isaa keessatti Waaqa galateeffadhaa;</para>
  <para style="q2" vid="PSA 150:1">samiiwwan isaa humna qabeeyyii keessattis isa galateeffadhaa.<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Hojiiwwan isaa jajjaboo sanaaf isa leellisaa;</para>
  <para style="q2" vid="PSA 150:2">guddina isaa hamma hin qabne sanaaf isa leellisaa.<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Malakata afuufuudhaan isa galateeffadhaa;</para>
  <para style="q2" vid="PSA 150:3">baganaa fi kiraaraan isa galateeffadhaa;<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>dibbeedhaan shuubbisaatii isa jajadhaa;</para>
  <para style="q2" vid="PSA 150:4">miʼa ribuutii fi ululleedhaan isa jajadhaa.<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>Kilillee sagalee qabuun isa jajadhaa;</para>
  <para style="q2" vid="PSA 150:5">kilillee sagalee guddaatiin isa jajadhaa.<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Wanni hafuura baafatu hundinuu <char style="nd">Waaqayyoon</char> haa jajatu.</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">Haalleluuyaa.<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
