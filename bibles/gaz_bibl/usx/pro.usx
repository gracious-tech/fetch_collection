<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open New Oromo Contemporary Version 2022</book>
  <para style="h">Fakkeenya</para>
  <para style="toc1">Kitaaba Fakkeenyaa</para>
  <para style="toc2">Fakkeenya</para>
  <para style="toc3">Fak</para>
  <para style="mt2">Kitaaba</para>
  <para style="mt1">Fakkeenyaa</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="ms1">Kaayyoo Ijoo Dubbii Kitaabichaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>Fakkeenya Solomoon Ilma Daawit, mootii Israaʼel:<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>Ogummaa fi qajeelfama qabaachuudhaaf,</para>
  <para style="q2" vid="PRO 1:2">dubbii beekumsa guddaa hubachuudhaaf;<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>ogummaadhaan jiraachuudhaan, qajeelummaadhaan,</para>
  <para style="q2" vid="PRO 1:3">murtii qajeelaa kennuu fi nama wal qixxeessuudhaan <optbreak/> qajeelfama argachuudhaaf;<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>warra waa hin beekneef of eeggannoo kennuudhaaf,</para>
  <para style="q2" vid="PRO 1:4">dargaggootaaf immoo beekumsaa fi hubannaa kennuudhaaf,<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>ogeeyyiin dhaggeeffatanii barumsa isaanii irratti waa haa dabalatan;</para>
  <para style="q2" vid="PRO 1:5">warri qalbii qabanis qajeelfama haa argatan;<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>kunis fakkeenyaa fi hiikkaa,</para>
  <para style="q2" vid="PRO 1:6">jechaa fi hibboo ogeeyyii hubachuudhaaf.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>
    <char style="nd">Waaqayyoon</char> sodaachuun jalqaba ogummaa ti;</para>
  <para style="q2" vid="PRO 1:7">gowwoonni garuu ogummaa fi adabamuu tuffatu.<verse eid="PRO 1:7"/></para>
  <para style="ms1">Gorsa Akka Namni Ogummaa Argatuuf Kenname</para>
  <para style="s1">Gowwoomfamuu Irraa Of Eeguu</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>Yaa ilma ko, gorsa abbaa keetii dhaggeeffadhu;</para>
  <para style="q2" vid="PRO 1:8">barsiisa haadha keetii illee hin gatin.<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>Wanni kun mataa kee miidhagsuudhaaf gonfoo,</para>
  <para style="q2" vid="PRO 1:9">morma kee bareechuudhaaf immoo faaya siif taʼa.<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>Yaa ilma ko, yoo cubbamoonni sossobanii</para>
  <para style="q2" vid="PRO 1:10">ofitti si harkisan, tole hin jedhiniif.<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>Yoo isaan, “Nu wajjin kottu;</para>
  <para style="q2" vid="PRO 1:11">riphnee dhiiga namaa dhangalaasnaa;</para>
  <para style="q2" vid="PRO 1:11">nama balleessaa hin qabne galaafachuudhaafis <optbreak/> dhokannee eeggannaa;<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>kottu akkuma awwaalaa jiraatti isaan liqimsinaa;</para>
  <para style="q2" vid="PRO 1:12">akkuma warra boolla keessa buufamaniis</para>
  <para style="q2" vid="PRO 1:12">guutumaan guutuutti isaan liqimsinaa;<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>nu waan gatii qabu kan gosa hundaa ni arganna;</para>
  <para style="q2" vid="PRO 1:13">manneen keenya illee boojuudhaan guuttanna;<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>ixaa kee nu wajjin buufadhu;</para>
  <para style="q2" vid="PRO 1:14">nus korojoo tokko si wajjin qooddannaa” siin jedhan,<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>yaa ilma ko, ati isaan wajjin hin deemin;</para>
  <para style="q2" vid="PRO 1:15">miilla keetiin karaa isaanii irra illee hin ejjetin;<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>miilli isaanii cubbuutti ariifataatii;</para>
  <para style="q2" vid="PRO 1:16">isaan dhiiga dhangalaasuuf jarjaru.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>Utuma simbirroonni hundi arganuu,</para>
  <para style="q2" vid="PRO 1:17">kiyyoo buusuun waan gatii hin qabnee dha!<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>Namoonni kunneen dhiiguma ofii isaanii riphanii eeggatu;</para>
  <para style="q2" vid="PRO 1:18">lubbuma ofii isaanii gaadu!<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>Kun dhuma warra qabeenya karaa hamaadhaan argamu duukaa buʼan hundaa ti;</para>
  <para style="q2" vid="PRO 1:19">wanni akkasii jireenya warra isa argatanii balleessa.<verse eid="PRO 1:19"/></para>
  <para style="s1">Akeekkachiisa Ogummaa Tuffachuu Irratti Kenname</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>Ogummaan karaa irratti guddiftee iyyiti;</para>
  <para style="q2" vid="PRO 1:20">iddoo wal gaʼii uummataattis sagalee ishee ol fudhatti.<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>Isheen fiixee daandii irraa iyyiti;</para>
  <para style="q2" vid="PRO 1:21">karra magaalaa duraas akkana jettee dubbatti:<verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“Isin warri homaa hin beekne</para>
  <para style="q2" vid="PRO 1:22">kun hamma yoomiitti karaa keessan kan faayidaa hin qabne sana jaallattu?</para>
  <para style="q1" vid="PRO 1:22">Warri namatti qoosan hamma yoomiitti qoosaa sanatti gammadanii</para>
  <para style="q2" vid="PRO 1:22">gowwoonnis beekumsa jibbu?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>Mormii koo qalbeeffadhaa;</para>
  <para style="q2" vid="PRO 1:23">ani yaada koo isinii nan dhangalaasa;</para>
  <para style="q2" vid="PRO 1:23">dubbii koos isiniifin ibsa.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>Garuu sababii isin yeroo ani isin waametti diddanii</para>
  <para style="q2" vid="PRO 1:24">yeroo ani harka balʼifadhetti namni tokko iyyuu na hin dhaggeeffatiniif,<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>waan isin gorsa koo hunda tuffattanii</para>
  <para style="q2" vid="PRO 1:25">dheekkamsa koo dhagaʼuu diddaniif,<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>anis badiisa keessanitti nan kolfa,</para>
  <para style="q2" vid="PRO 1:26">yeroo balaan isinitti dhufuttis nan qoosa;<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>yeroo balaan akkuma bubbeetti isin fudhatutti,</para>
  <para style="q2" vid="PRO 1:27">yeroo badiisni akkuma bubbee hamaatti isin haxaaʼutti,</para>
  <para style="q2" vid="PRO 1:27">yeroo dhiphinaa fi rakkinni isinitti dhufutti ani isinittan qoosa.<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>“Yeroo sana isaan na waammatu; ani garuu isaan jalaa hin owwaadhu;</para>
  <para style="q2" vid="PRO 1:28">isaan na barbaadu; garuu na hin argatan.<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>Isaan waan beekumsa jibbanii</para>
  <para style="q2" vid="PRO 1:29">
    <char style="nd">Waaqayyoon</char> sodaachuu illee filachuu didaniif,<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>waan gorsa koo fudhachuu didanii</para>
  <para style="q2" vid="PRO 1:30">dheekkamsa koos tuffataniif,<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>isaan gatii karaa isaanii ni nyaatu;</para>
  <para style="q2" vid="PRO 1:31">buʼaa jalʼina isaaniis ni quufu.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>Gowwoota waa dagachuutu isaan balleessaatii;</para>
  <para style="q2" vid="PRO 1:32">quufni gowwootaa isaanuma balleessa;<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>namni na dhaggeeffatu kam iyyuu garuu nagaadhaan jiraata;</para>
  <para style="q2" vid="PRO 1:33">inni qabbanaan jiraata; wanni hamaanis isa hin sodaachisu.”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Badhaasa Ogummaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>Yaa ilma ko, yoo ati dubbii koo fudhattee</para>
  <para style="q2" vid="PRO 2:1">ajaja koos of keessatti kuufatte,<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>yoo ati gurra kee ogummaatti garagalfattee</para>
  <para style="q2" vid="PRO 2:2">yaada kee hubannaatti deebifatte,<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>yoo ati jabaattee qalbeeffannaa barbaaddee</para>
  <para style="q2" vid="PRO 2:3">hubannaa argachuuf jettee iyyitee kadhatte,<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>yoo ati akkuma meetiitti isa barbaaddattee</para>
  <para style="q2" vid="PRO 2:4">akkuma qabeenya dhokfameetti isa barbaadde,<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>ati <char style="nd">Waaqayyoon</char> sodaachuu ni hubatta;</para>
  <para style="q2" vid="PRO 2:5">Waaqa beekuus ni argatta.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>
    <char style="nd">Waaqayyo</char> ogummaa namaa kennaatii;</para>
  <para style="q2" vid="PRO 2:6">afaan isaa keessaa illee beekumsaa fi hubannaatu baʼa.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>Inni qajeeltotaaf ogummaa dhugaa kuusa;</para>
  <para style="q2" vid="PRO 2:7">warra adeemsi isaanii mudaa hin qabneef gaachana;<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>inni daandii tolootaa ni eega;</para>
  <para style="q2" vid="PRO 2:8">karaa qulqulloota isaa illee ni tiksa.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>Ergasii ati qajeelummaa fi murtii qajeelaa,</para>
  <para style="q2" vid="PRO 2:9">nama wal qixxeessuu, karaa qajeelaa hundas ni hubatta.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>Ogummaan garaa kee seena;</para>
  <para style="q2" vid="PRO 2:10">beekumsis lubbuu kee gammachiisa.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>Qalbeeffannaan si eega;</para>
  <para style="q2" vid="PRO 2:11">hubannaanis si tiksa.<verse eid="PRO 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>Ogummaan karaa hamootaa irraa,</para>
  <para style="q2" vid="PRO 2:12">namoota daba dubbatan jalaas si baraara;<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>warra karaa dukkanaa irra deemuudhaaf jedhanii</para>
  <para style="q2" vid="PRO 2:13">daandii qajeelaa dhiisan,<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>warra waan hamaa hojjechuutti gammadan,</para>
  <para style="q2" vid="PRO 2:14">warra jalʼina hojjechuun itti tolu,<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>warra daandiin isaanii jalʼate,</para>
  <para style="q2" vid="PRO 2:15">warra karaan isaanii dabe jalaa si baraara.<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>Ogummaatu dubartii ganda labee,</para>
  <para style="q2" vid="PRO 2:16">niitii dubbiidhaan sossobdee ofitti nama harkiftu jalaa si baraara;<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>niitii dhirsa ishee kan jalqabaa dhiiftee</para>
  <para style="q2" vid="PRO 2:17">kakuu fuula Waaqaa duratti galte sana dagatte jalaa si baraara.<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>Manni ishee gara duʼaatti, karaan ishee immoo</para>
  <para style="q2" vid="PRO 2:18">gara hafuurota warra duʼaniitti nama geessaatii.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>Namni gara ishee dhaqu tokko iyyuu hin deebiʼu</para>
  <para style="q2" vid="PRO 2:19">yookaan karaa jireenyaa hin argatu.<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>Kanaafuu ati karaa namoota gaggaarii irra ni deemta;</para>
  <para style="q2" vid="PRO 2:20">daandii qajeeltotaa irraas hin jalʼattu.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>Toloonni biyyattii keessa ni jiraatuutii;</para>
  <para style="q2" vid="PRO 2:21">warri mudaa hin qabnes achi keessa jiraatu;<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>hamoonni garuu biyyattii keessaa ni balleeffamu;</para>
  <para style="q2" vid="PRO 2:22">warri hin amanamnes ishee keessaa buqqifamu.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">Eebba Ogummaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>Yaa ilma ko, barumsa ani siif kennu hin dagatin;</para>
  <para style="q2" vid="PRO 3:1">ajaja koos garaatti qabadhu;<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>isaan bara baayʼee fi umurii dheeraa,</para>
  <para style="q2" vid="PRO 3:2">nagaa fi badhaadhummaa siif dabaluutii.<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>Jaalallii fi amanamummaan yoom iyyuu sirraa hin fagaatin;</para>
  <para style="q2" vid="PRO 3:3">morma keetti hidhadhu;</para>
  <para style="q2" vid="PRO 3:3">gabatee garaa kee irrattis barreeffadhu.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>Ati karaa kanaan fuula Waaqaatii fi</para>
  <para style="q2" vid="PRO 3:4">fuula namaa duratti surraa fi maqaa gaarii ni argatta.<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>Garaa kee guutuun <char style="nd">Waaqayyoon</char> amanadhu;</para>
  <para style="q2" vid="PRO 3:5">hubannaa kees hin abdatin;<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>karaa kee hunda keessatti isa dursi;</para>
  <para style="q2" vid="PRO 3:6">innis daandii kee siif qajeelcha.<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>Ani ogeessa ofiin hin jedhin;</para>
  <para style="q2" vid="PRO 3:7">
    <char style="nd">Waaqayyoon</char> sodaadhu; waan hamaa irraas fagaadhu.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>Wanni kun dhagna keetiif fayyaa kenna;</para>
  <para style="q2" vid="PRO 3:8">lafee kee illee ni haaromsa.<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>Qabeenya keetiin,</para>
  <para style="q2" vid="PRO 3:9">mataa midhaan keetii hundaanis <char style="nd">Waaqayyoon</char> kabaji;<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>yoos gombisaan kee hamma irraan dhangalaʼutti guutama;</para>
  <para style="q2" vid="PRO 3:10">iddoon cuunfaa wayinii keetiis <optbreak/> daadhiidhaan guutamee irraan dhangalaʼa.<verse eid="PRO 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>Yaa ilma ko, adabbii <char style="nd">Waaqayyoo</char> hin tuffatin;</para>
  <para style="q2" vid="PRO 3:11">dheekkamsa isaas hin jibbin.<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>
    <char style="nd">Waaqayyo</char> akkuma abbaa ilma ofii isaa jaallatu tokkootti</para>
  <para style="q2" vid="PRO 3:12">warra jaallatu ni adabaatii.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>Namni ogummaa argatu</para>
  <para style="q2" vid="PRO 3:13">kan hubannaas argatu eebbifamaa dha;<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>ogummaan meetii caalaa faayidaa qabaatii;</para>
  <para style="q2" vid="PRO 3:14">warqee caalaas buʼaa namaaf buusa.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Gatiin ishee gatii lula diimaa caala;</para>
  <para style="q2" vid="PRO 3:15">wanni ati akka malee hawwitu kam iyyuu isheedhaan wal qixxaachuu hin dandaʼu.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Jireenyi dheeraan harka ishee mirgaa keessa jira;</para>
  <para style="q2" vid="PRO 3:16">badhaadhummaa fi ulfinni harka ishee bitaa keessa jiru.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>Karaan ishee karaa nama gammachiisuu dha;</para>
  <para style="q2" vid="PRO 3:17">daandiin ishee hundis nagaa dha.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>Isheen warra jabeessanii ishee qabataniif muka jireenyaa ti;</para>
  <para style="q2" vid="PRO 3:18">warri itti cichanii ishee qabatan immoo ni eebbifamu.<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>
    <char style="nd">Waaqayyo</char> ogummaadhaan hundee lafaa buuse;</para>
  <para style="q2" vid="PRO 3:19">hubannaadhaanis samiiwwan iddoo isaanii kaaʼe;<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>beekumsa isaatiin tuujubawwan gargar qoodaman;</para>
  <para style="q2" vid="PRO 3:20">duumessoonnis fixeensa coccobsan.<verse eid="PRO 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>Yaa ilma ko ogummaa fi hubannaa dhugaa eeggadhu;</para>
  <para style="q2" vid="PRO 3:21">isaanis fuula kee duraa hin dhabamin;<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>isaan jireenya siif taʼu;</para>
  <para style="q2" vid="PRO 3:22">morma kee miidhagsuufis faaya mormaa siif taʼu.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>Yoos ati karaa kee nagumaan deemta;</para>
  <para style="q2" vid="PRO 3:23">miilli kees hin gufatu;<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>ati yoo raftu hin sodaattu;</para>
  <para style="q2" vid="PRO 3:24">hirribni kees yoo ati raftu sitti miʼaawa.<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>Balaa akkuma tasaa sitti dhufu</para>
  <para style="q2" vid="PRO 3:25">yookaan badiisa hamoota galaafatu hin sodaatin;<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>
    <char style="nd">Waaqayyo</char> irkoo siif taʼaatii;</para>
  <para style="q2" vid="PRO 3:26">akka miilli kee kiyyoodhaan hin qabamnes si eega.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>Ati yeroo waan tokko gochuudhaaf aangoo qabdutti,</para>
  <para style="q2" vid="PRO 3:27">warra wanni gaariin isaaniif malu irraa waan sana hin hanqisin.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>Utuu amma waa qabduu,</para>
  <para style="q2" vid="PRO 3:28">ollaa keetiin, “Yeroo biraa deebiʼii kottu;</para>
  <para style="q2" vid="PRO 3:28">ani bori siifin kennaatii” hin jedhin.<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>Ollaa kee kan si amanee si cina jiraatu miidhuuf jettee</para>
  <para style="q2" vid="PRO 3:29">waan hamaa itti hin yaadin.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>Nama tokko utuu inni homaa si hin godhin</para>
  <para style="q2" vid="PRO 3:30">akkasumaan hin miidhin.<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>Nama dabaatti hin hinaafin;</para>
  <para style="q2" vid="PRO 3:31">yookaan karaa isaa tokko illee hin filatin.<verse eid="PRO 3:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>
    <char style="nd">Waaqayyo</char> nama jalʼaa ni jibbaatii;</para>
  <para style="q2" vid="PRO 3:32">nama qajeelaa garuu ofitti aanfata.<verse eid="PRO 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>Abaarsi <char style="nd">Waaqayyoo</char> mana nama hamaa irra buʼa;</para>
  <para style="q2" vid="PRO 3:33">inni garuu mana nama qajeelaa ni eebbisa.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>Inni qoostota of tuultotatti ni qoosa;</para>
  <para style="q2" vid="PRO 3:34">warra gad of qabaniif immoo ayyaana kenna.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>Ogeeyyiin ulfina dhaalu;</para>
  <para style="q2" vid="PRO 3:35">gowwoota garuu inni ni qaanessa.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Ogummaan Waan Hunda Caalti</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>Yaa ilmaan ko, mee gorsa abbaan namaaf kennu dhagaʼaa;</para>
  <para style="q2" vid="PRO 4:1">qalbeeffadhaatii hubannaa argadhaa.<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>Ani barumsa gaarii isinii nan kenna;</para>
  <para style="q2" vid="PRO 4:2">kanaafuu barsiisa koo hin dhiisinaa.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>Yeroo ani mucaa xinnaa taʼee mana abbaa koo turetti,</para>
  <para style="q2" vid="PRO 4:3">yeroo ani daaʼima dhiiga taʼee haadha kootiif ilma tokkicha turetti,<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>inni akkana jedhee na barsiise;</para>
  <para style="q2" vid="PRO 4:4">“Garaa kee guutuudhaan dubbii koo jabeessii qabadhu;</para>
  <para style="q2" vid="PRO 4:4">seera koo eegi; ati ni jiraattaatii.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>Ogummaa argadhu; hubannaas argadhu;</para>
  <para style="q2" vid="PRO 4:5">dubbii koo hin dagatin yookaan irraa hin jalʼatin.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>Ogummaa hin dhiisin; isheen si eegdii;</para>
  <para style="q2" vid="PRO 4:6">ishee jaalladhu; isheenis si tiksitii.<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>Ogummaan waan hunda caalti; kanaafuu ogummaa argadhu.</para>
  <para style="q2" vid="PRO 4:7">Yoo isheen waan ati qabdu hunda si baasifte illee hubannaa argadhu.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>Ogummaa kabaji; inni ol si guddisaatii;</para>
  <para style="q2" vid="PRO 4:8">isa hammadhu; innis si kabajaatii.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>Isheen kallacha bareedaa mataa kee irra siif keessi;</para>
  <para style="q2" vid="PRO 4:9">gonfoo miidhagaa illee siif kenniti.”<verse eid="PRO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>Yaa ilma ko dhagaʼi; waan ani jedhu illee fudhadhu;</para>
  <para style="q2" vid="PRO 4:10">barri jireenya keetiis ni baayʼataa.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>Ani karaa ogummaa irra sin qajeelcha;</para>
  <para style="q2" vid="PRO 4:11">daandii qajeelaa irras sin buusa.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>Yeroo ati deemtu, tarkaanfiin kee hin ittifamu;</para>
  <para style="q2" vid="PRO 4:12">yoo fiigdu illee ati hin gufattu.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>Qajeelfama jabeessii qabadhu; gad hin dhiisin;</para>
  <para style="q2" vid="PRO 4:13">waan inni jireenya kee taʼeef jabeessii eeggadhu.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>Daandii hamootaa irra miilla kee hin dhaabin</para>
  <para style="q2" vid="PRO 4:14">yookaan karaa jalʼootaa irra hin deemin.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>Irraa fagaadhu; irras hin deemin;</para>
  <para style="q2" vid="PRO 4:15">irraa goriitii karaa kee irra qajeeli.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>Isaan waan hamaa hojjetan malee rafuu hin dandaʼaniitii;</para>
  <para style="q2" vid="PRO 4:16">isaan hamma nama gufachiisanitti hirriba hin argatan.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>Isaan buddeena hamminaa nyaatu;</para>
  <para style="q2" vid="PRO 4:17">daadhii wayinii kan dabaan argame dhugu.<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>Karaan qajeeltotaa akkuma ifa barii barraaqaa</para>
  <para style="q2" vid="PRO 4:18">kan hamma saafaatti ittuma fufee ifaa deemuu ti.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>Karaan hamootaa garuu akkuma dukkana guddaa ti;</para>
  <para style="q2" vid="PRO 4:19">isaan waan isaan gufachiisu hin beekan.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>Yaa ilma ko, waan ani jedhu qalbeeffadhu;</para>
  <para style="q2" vid="PRO 4:20">dubbii kootiifis gurra kenni.<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>Akka inni fuula kee duraa dhabamu hin godhin;</para>
  <para style="q2" vid="PRO 4:21">garaa kee keessa ol kaaʼadhu;<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>inni warra isa argatuuf jireenya,</para>
  <para style="q2" vid="PRO 4:22">dhagna namaa guutuufis fayyinaatii.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>Waan hunda caalaa qalbii kee eeggadhu;</para>
  <para style="q2" vid="PRO 4:23">burqaan jireenyaa achii baʼaatii.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>Dubbii jalʼinaa afaan kee keessaa balleessi;</para>
  <para style="q2" vid="PRO 4:24">haasaa hamaas arraba kee irraa fageessi.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>Iji kee kallattiidhaan qajeelchee haa ilaalu;</para>
  <para style="q2" vid="PRO 4:25">atis xiyyeeffadhuu fuula kee dura ilaali.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>Miilla keetiif daandii wal qixxeeffadhu;</para>
  <para style="q2" vid="PRO 4:26">karaan kee hundinuu haa jabaatu.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>Gara mirgaatti yookaan gara bitaatti hin gorin;</para>
  <para style="q2" vid="PRO 4:27">miilla kee hammina irraa eeggadhu.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">Ejja Irraa Of Eeggachuu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>Yaa ilma ko, ogummaa koo qalbeeffadhu;</para>
  <para style="q2" vid="PRO 5:1">hubannaa kootiif illee gurra kenni;<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>kunis akka ati hubannaa turfattee</para>
  <para style="q2" vid="PRO 5:2">arrabni kees beekumsa kuufattuuf.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>Hidhiin ejjituu damma coccobsa;</para>
  <para style="q2" vid="PRO 5:3">haasaan ishee zayitii caalaa lallaafa;<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>dhuma irratti garuu isheen akkuma hadhooftuu hadhoofti;</para>
  <para style="q2" vid="PRO 5:4">akkuma goraadee afaan lamaas qara qabeettii dha.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>Miilli ishee gara duʼaatti gad buʼa;</para>
  <para style="q2" vid="PRO 5:5">tarkaanfiin ishee awwaalatti nama geessa.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>Isheen waaʼee karaa jireenyaa dhimma hin qabdu;</para>
  <para style="q2" vid="PRO 5:6">daandiin ishee jalʼaa dha; isheen garuu kana hin beektu.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>Egaa yaa ilmaan ko, mee na dhagaʼaa;</para>
  <para style="q2" vid="PRO 5:7">waan ani jedhu irraa gara kamitti iyyuu hin gorinaa.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>Karaa keessan ishee irraa fageeffadhaa;</para>
  <para style="q2" vid="PRO 5:8">balbala mana isheetti hin dhiʼaatinaa;<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>kunis akka ati ulfina kee nama biraatiif,</para>
  <para style="q2" vid="PRO 5:9">umurii kees nama namaaf hin naaneef hin kennineef;<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>akkasumas qabeenya kee ormatu nyaata;</para>
  <para style="q2" vid="PRO 5:10">dadhabbiin kees mana alagaa badhaasa.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>Dhuma jireenya keetiitti,</para>
  <para style="q2" vid="PRO 5:11">yeroo foonii fi dhagni kee dhumutti ati ni aadda.<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>Atis akkana jetta; “Ani akkamittin adabamuu jibbee!</para>
  <para style="q2" vid="PRO 5:12">Garaan koos akkam sirreeffamuu tuffate!<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>Ani barsiistota kootiif hin ajajamne</para>
  <para style="q2" vid="PRO 5:13">yookaan qajeelchitoota koo hin dhaggeeffanne.<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>Ani waldaa guutuu gidduutti</para>
  <para style="q2" vid="PRO 5:14">qarqara badiisaa gaʼeen ture.”<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>Eela kee keessaa bishaan,</para>
  <para style="q2" vid="PRO 5:15">boolla bishaanii kee keessaa immoo bishaan qulqulluu dhugi.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>Burqaan kee guutee daandii irra, bishaan kee kan yaaʼus</para>
  <para style="q2" vid="PRO 5:16">oobdii keessa dhangalaʼuu qabaa?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>Isaan kan kee haa taʼan;</para>
  <para style="q2" vid="PRO 5:17">ormi si wajjin qooddachuu hin qabu.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>Burqaan kee haa eebbifamu;</para>
  <para style="q2" vid="PRO 5:18">niitii dargaggummaa keetiitti gammadi.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>Isheen miidhagduu akka borofaa, bareedduu akka gadamsaa ti;</para>
  <para style="q2" vid="PRO 5:19">harmi ishee yeroo hunda sitti haa tolu;</para>
  <para style="q2" vid="PRO 5:19">yeroo hunda jaalalli ishee si haa boojiʼu.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>Yaa ilma ko, ati maaliif ejjituudhaan boojiʼamta?</para>
  <para style="q2" vid="PRO 5:20">Maaliif bobaa niitii nama biraa hammatta?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>Karaan namaa guutumaan guutuutti fuula <char style="nd">Waaqayyoo</char> dura jiraatii;</para>
  <para style="q2" vid="PRO 5:21">innis daandii namaa hunda ni toʼata.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>Balleessaan nama hamaa isuma qabaata;</para>
  <para style="q2" vid="PRO 5:22">funyoon cubbuu isaa jabeessee isa qaba.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>Inni sababii adabamuu dhabeef duʼa;</para>
  <para style="q2" vid="PRO 5:23">guddinni gowwummaa isaas karaa irraa isa balleessa.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Akeekkachiisa Waaʼee Gowwummaa Irratti Kenname</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>Yaa ilma ko, ati yoo ollaa keetiif wabii taatee</para>
  <para style="q2" vid="PRO 6:1">harka dhooftee nama ormaatiif kakatte,<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>yoo waanuma dubbatteen qabamtee</para>
  <para style="q2" vid="PRO 6:2">dubbuma afaan keetiitiin kiyyoo seente,<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>yoos yaa ilma ko, <optbreak/> ati sababii harka ollaa keetii seentee jirtuuf</para>
  <para style="q2" vid="PRO 6:3">ati of baasuudhaaf</para>
  <para style="q1" vid="PRO 6:3">dafii dhaqiitii gad of qabii</para>
  <para style="q2" vid="PRO 6:3">jabeessiitii ollaa kee kadhadhu!<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>Ija keetiif hirriba,</para>
  <para style="q2" vid="PRO 6:4">baallee ija keetiitiif immoo mugaatii hin eeyyamin.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>Ati akkuma kuruphee harka adamsituutii baatuutti,</para>
  <para style="q2" vid="PRO 6:5">akkuma simbirroo kiyyoo nama ishee qabuu jalaa baatuutti of oolchi.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>Yaa dhibaaʼaa nana mee gara goondaa dhaqi;</para>
  <para style="q2" vid="PRO 6:6">karaa ishee qalbeeffadhuutii ogeessa taʼi!<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>Inni ajajaa hin qabu;</para>
  <para style="q2" vid="PRO 6:7">toʼataa yookaan bulchaa hin qabu;<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>taʼu illee inni bona keessa nyaata isaa kuufata;</para>
  <para style="q2" vid="PRO 6:8">yeroo midhaan galfamutti immoo nyaata isaa walitti qabata.<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>Yaa dhibaaʼaa nana, ati hamma yoomiitti ciifta?</para>
  <para style="q2" vid="PRO 6:9">Ati yoomi hirriba keetii kaata?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>Hirriba xinnaa, mugaatii xinnaa,</para>
  <para style="q2" vid="PRO 6:10">xinnoo harka walitti marachuu,<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>hiyyummaanis akkuma hattuutti sitti dhufa;</para>
  <para style="q2" vid="PRO 6:11">deegummaanis akkuma loltuu hidhateetti sitti dhufa.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>Namni rakkisaan, namni hamaan,</para>
  <para style="q2" vid="PRO 6:12">dubbii sobaatiin asii fi achi naannaʼa;<verse eid="PRO 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13"/>inni ijaan dhaʼa;</para>
  <para style="q2" vid="PRO 6:13">miilla isaatiinis mallattoo kenna;</para>
  <para style="q2" vid="PRO 6:13">quba isaatiin argisiisa;<verse eid="PRO 6:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14"/>inni garaa isaa isa sobaadhaan hammina yaada;</para>
  <para style="q2" vid="PRO 6:14">yeroo hundas lola kakaasa.<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>Kanaafuu badiisni yommusuma isatti dhufa;</para>
  <para style="q2" vid="PRO 6:15">inni akkuma tasaa caba; deebiʼees hin fayyu.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16"/>
    <char style="nd">Waaqayyo</char> waan jaʼa jibba;</para>
  <para style="li2" vid="PRO 6:16">waan torba immoo ni xireeffata; isaanis:<verse eid="PRO 6:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17"/>Ija of tuulu,</para>
  <para style="li3" vid="PRO 6:17">arraba sobu,</para>
  <para style="li3" vid="PRO 6:17">harka dhiiga nama balleessaa hin qabnee dhangalaasu,<verse eid="PRO 6:17"/></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18"/>garaa mala hamaa malu,</para>
  <para style="li3" vid="PRO 6:18">miilla gara jalʼinaatti ariifatu,<verse eid="PRO 6:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19"/>dhuga baatuu sobaa kan soba dhangalaasu,</para>
  <para style="li3" vid="PRO 6:19">nama obboloota gidduutti lola kakaasuu dha.<verse eid="PRO 6:19"/></para>
  <para style="s1">Akeekkachiisa Waaʼee Ejjaa Irratti Kenname</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>Yaa ilma ko, ajaja abbaa keetii eegi;</para>
  <para style="q2" vid="PRO 6:20">barsiisa haadha keetii illee hin gatin.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>Bara baraan garaa keetti qabadhu;</para>
  <para style="q2" vid="PRO 6:21">morma keettis hidhadhu.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>Yeroo ati deemtu isaan si qajeelchu;</para>
  <para style="q2" vid="PRO 6:22">yeroo ati raftu si eegu;</para>
  <para style="q2" vid="PRO 6:22">yeroo ati hirribaa kaatu illee si haasofsiisu.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>Ajajni kun ibsaadhaatii;</para>
  <para style="q2" vid="PRO 6:23">barsiisni kunis ifa;</para>
  <para style="q2" vid="PRO 6:23">sirreeffamni amalaa immoo karaa jireenyaa ti;<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>isaan dubartii hamtuu irraa,</para>
  <para style="q2" vid="PRO 6:24">niitii kashlabbee afaan dammaa irraa si eegu.<verse eid="PRO 6:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>Garaa kee keessatti bareedina ishee hin dharraʼin;</para>
  <para style="q2" vid="PRO 6:25">yookaan akka isheen ija isheetiin si boojitu hin godhin.<verse eid="PRO 6:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>Sagaagaltuun buddeena tokkoon bitamtiitii;</para>
  <para style="q2" vid="PRO 6:26">ejjituunis jireenyuma kee adamsiti.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>Namni bobaa jalatti ibidda baadhatee</para>
  <para style="q2" vid="PRO 6:27">wayyaan isaa hin gubanne jiraa?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>Namni ibidda cilee irra ejjetee</para>
  <para style="q2" vid="PRO 6:28">miilli isaa hin gubanne jiraa?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>Namni niitii nama biraa wajjin ciisus akkasuma taʼa;</para>
  <para style="q2" vid="PRO 6:29">namni ishee tuqu kam iyyuu utuu hin adabamin hin hafu.<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>Yoo hattuun tokko beela baʼuuf jedhee hate,</para>
  <para style="q2" vid="PRO 6:30">namoonni hin tuffatan.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>Garuu inni yoo qabame dachaa torba baasa;</para>
  <para style="q2" vid="PRO 6:31">miʼa mana isaa hundas ni kenna.<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>Namni sagaagalu qalbii hin qabu;</para>
  <para style="q2" vid="PRO 6:32">namni waan akkasii hojjetu ofuma galaafata.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>Qoodni isaa dhaanamuu fi salphachuu dha;</para>
  <para style="q2" vid="PRO 6:33">qaaniin isaa yoom iyyuu isa irraa hin haqamu.<verse eid="PRO 6:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>Hinaaffaan aarii dhirsaa kakaasaatii;</para>
  <para style="q2" vid="PRO 6:34">inni yeroo haaloo baʼutti dhiifama tokko iyyuu hin godhu.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>Inni beenyaa tokko illee hin fudhatu;</para>
  <para style="q2" vid="PRO 6:35">hammam baayʼatu iyyuu inni mattaʼaa ni dida.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">Sagaagaltuu Irraa Of Eeggachuu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>Yaa ilma ko, dubbii koo eegiitii</para>
  <para style="q2" vid="PRO 7:1">ajaja koos of keessatti kuufadhu.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>Ajaja koo eegi, ati ni jiraataatii;</para>
  <para style="q2" vid="PRO 7:2">barsiisa koos akkuma qaroo ija keetiitti eegi.<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>Quba keetti isaan hidhadhu;</para>
  <para style="q2" vid="PRO 7:3">gabatee garaa keetii irrattis barreeffadhu.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>Ogummaan, “Ati obboleettii koo ti” jedhi;</para>
  <para style="q2" vid="PRO 7:4">hubannaa immoo, fira koo jedhii waami;<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>isaan sagaagaltuu irraa, niitii kashlabbee dubbii isheetiin</para>
  <para style="q2" vid="PRO 7:5">nama harkiftu irraa si eegu.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>Ani foddaa mana koo biraa keessaan,</para>
  <para style="q2" vid="PRO 7:6">karaa qaawwaatiin ala ilaale.<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>Ani warra homaa hin dandeenye keessatti,</para>
  <para style="q2" vid="PRO 7:7">dargaggoota keessatti hubadhee</para>
  <para style="q2" vid="PRO 7:7">dargaggeessa qalbii hin qabne tokko arge.<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>Innis karaa mana ishee dhaqu qabatee</para>
  <para style="q2" vid="PRO 7:8">daandii golee mana ishee bira jiruutiin gad buʼaa ture.<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>Kunis yeroo aduun dhiitee lafti dimimmisaaʼaa turetti,</para>
  <para style="q2" vid="PRO 7:9">yeroo halkan dukkanaaʼuu jalqabetti ture.<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>Dubartiin tokko akka sagaagaltuutti uffattee</para>
  <para style="q2" vid="PRO 7:10">yaada haxxummaatiin isa simachuuf gad baate.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>Isheen iyyituu fi kashlabbee dha;</para>
  <para style="q2" vid="PRO 7:11">miilli ishee mana hin dhaabatu;<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>takka daandii irratti, takka oobdii irratti,</para>
  <para style="q2" vid="PRO 7:12">golee hundatti riphxee nama eeggatti.<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>Isheen qabdee isa dhungatti;</para>
  <para style="q2" vid="PRO 7:13">fuula qaanii hin qabneen akkana jettiin:<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“Ani aarsaa nagaa dhiʼeessuun qaba;</para>
  <para style="q2" vid="PRO 7:14">harʼa wareega koo guuttadheera.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>Kanaafuu ani si simachuufin gad baʼe;</para>
  <para style="q2" vid="PRO 7:15">ani barbaadee si argadheera!<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>Ani wayyaa bareedduu quncee talbaa irraa hojjetame kan Gibxii dhufeen,</para>
  <para style="q2" vid="PRO 7:16">siree koo afee miidhagseera.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>Ani qumbiin, argeessaa fi qarafaan</para>
  <para style="q2" vid="PRO 7:17">siree koo urgeesseera.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>Kottu mee hamma bariitti gad fageenya jaalalaa walii wajjin dhugnaa;</para>
  <para style="q2" vid="PRO 7:18">kottu jaalalaan of gammachiifnaa!<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>Dhirsi koo mana hin jiru;</para>
  <para style="q2" vid="PRO 7:19">inni karaa dheeraa deemeera.<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>Inni boorsaa isaa maallaqaan guuttatee deeme;</para>
  <para style="q2" vid="PRO 7:20">hamma jiʼi goobanutti manatti hin deebiʼu.”<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>Isheen dubbii miʼooftuudhaan karaa irraa isa jalʼifte;</para>
  <para style="q2" vid="PRO 7:21">haasaa nama sossobuunis isa dirqisiifte.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>Innis akkuma sangaa qalamuuf deemuutti,</para>
  <para style="q2" vid="PRO 7:22">akkuma gadamsa kiyyoo keessa seenuuttis</para>
  <para style="q1" vid="PRO 7:22">yommusuma kaʼee ishee duukaa buʼe;<verse eid="PRO 7:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23"/>akkuma simbira kiyyootti ariifattuutti,</para>
  <para style="q1" vid="PRO 7:23">inni hamma xiyyi tiruu isaa waraanutti</para>
  <para style="q2" vid="PRO 7:23">akka wanni kun lubbuu isaa galaafatu hin beeku.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>Egaa yaa ilmaan ko, na dhaggeeffadhaa;</para>
  <para style="q2" vid="PRO 7:24">waan ani jedhus qalbeeffadhaa.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>Akka garaan kee karaa isheetti garagalu hin godhin;</para>
  <para style="q2" vid="PRO 7:25">karaa kee irraas baddee daandii ishee irra hin buʼin.<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>Namoonni hedduun warra isheen lafaan dhooftee dha;</para>
  <para style="q2" vid="PRO 7:26">namoonni jajjaboon baayʼeenis harka isheetti dhumaniiru.<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>Manni ishee karaa qileetti nama geessu,</para>
  <para style="q2" vid="PRO 7:27">kan gola duʼaatti gad nama buusuu dha.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">Waamicha Ogummaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>Ogummaan hin iyyuu?</para>
  <para style="q2" vid="PRO 8:1">Hubannaanis sagalee isaa ol hin fudhatuu?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>Isheen qarqara karaa, lafa ol kaʼaa irra,</para>
  <para style="q2" vid="PRO 8:2">iddoo daandiin itti wal gaʼu dhaabatti;<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>karra magaalaatti nama galchu bira,</para>
  <para style="q2" vid="PRO 8:3">balbala dura dhaabattee akkana jettee iyyiti:<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>“Yaa namoota, ani iyyeen isin waama;</para>
  <para style="q2" vid="PRO 8:4">ani ilmaan namaa hundatti sagalee koo ol nan fudhadha.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>Isin warri homaa hin beekne, qalbii horadhaa;</para>
  <para style="q2" vid="PRO 8:5">isin warri gowwaan hubannaa argadhaa.<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>Ani waan faayidaa qabu nan dubbadhaatii, dhagaʼaa;</para>
  <para style="q2" vid="PRO 8:6">waan qajeelaa dubbachuufis afaan koo nan banadha.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>Afaan koo dhugaa dubbata;</para>
  <para style="q2" vid="PRO 8:7">arrabni koo hammina jibbaatii.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>Dubbiin afaan koo hundinuu qajeelaa dha;</para>
  <para style="q2" vid="PRO 8:8">dubbii koo keessaa tokko iyyuu jalʼaa yookaan micciiramaa miti.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>Nama waa hubatuuf dubbiin koo hundinuu qajeelaa dha;</para>
  <para style="q2" vid="PRO 8:9">warra beekumsa qabuufis hirʼina hin qabu.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>Qooda meetii gorsa koo,</para>
  <para style="q2" vid="PRO 8:10">warqee qulqulluu caalaas beekumsa filadhu;<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>ogummaan lula diimaa caalaa gatii guddaa qabdii;</para>
  <para style="q2" vid="PRO 8:11">wanni ati hawwitu tokko iyyuu isheedhaan wal hin madaalu.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>“Ani ogummaan, qalbii wajjin nan jiraadha;</para>
  <para style="q2" vid="PRO 8:12">ani beekumsaa fi hubannaa qaba.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>
    <char style="nd">Waaqayyoon</char> sodaachuun jibbuu dha;</para>
  <para style="q2" vid="PRO 8:13">hammina ani of tuulummaa fi of guddisuu,</para>
  <para style="q2" vid="PRO 8:13">amala hamaa fi haasaa jalʼaa nan jibba.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>Gorsaa fi murtiin dhugaa kan koo ti;</para>
  <para style="q2" vid="PRO 8:14">ani hubannaa fi humna qaba.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>Mootonni anaan moʼu;</para>
  <para style="q2" vid="PRO 8:15">bulchitoonnis anaan seera qajeelaa baasu.<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>Ilmaan moototaa anaan bulchu;</para>
  <para style="q2" vid="PRO 8:16">namoonni bebeekamoon hundis anaan biyya bulchu.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>Ani warra na jaallatan nan jaalladha;</para>
  <para style="q2" vid="PRO 8:17">warri na barbaadanis na argatu.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>Soorumnii fi ulfinni, qabeenyii fi</para>
  <para style="q2" vid="PRO 8:18">badhaadhummaan dhuma hin qabne harkuma koo jiru.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>Iji koo warqee qulqulluu caala;</para>
  <para style="q2" vid="PRO 8:19">buʼaan narraa argamus meetii filatamaa caala.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>Ani karaa qajeelummaa irra,</para>
  <para style="q2" vid="PRO 8:20">daandii qajeelaa irras nan deema;<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>warra na jaallatutti qabeenya nan dhangalaasa;</para>
  <para style="q2" vid="PRO 8:21">mankuusa qabeenya isaanii illee nan guuta.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>“<char style="nd">Waaqayyo</char> waan bara durii hojjeteen dura,</para>
  <para style="q2" vid="PRO 8:22">hojii isaa kan jalqabaatiin dura na aanfate;<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>ani utuu addunyaan hin uumamin dura,</para>
  <para style="q2" vid="PRO 8:23">jalqabumatti, bara hamma hin qabneen dura nan muudame.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>Ani utuu tuujubni hin jiraatin,</para>
  <para style="q2" vid="PRO 8:24">utuu burqaawwan bishaaniin hin guutamin dhaladhe;<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>utuu tulluuwwan iddoo isaanii hin dhaabamin dura,</para>
  <para style="q2" vid="PRO 8:25">ani gaarraniin dura nan dhaladhe;<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>utuu inni lafa yookaan dirree ishee</para>
  <para style="q2" vid="PRO 8:26">yookaan biyyoo addunyaa tokko iyyuu <optbreak/> hin uumin dura nan dhaladhe.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>Yeroo inni samiiwwan hundeessetti,</para>
  <para style="q2" vid="PRO 8:27">yeroo inni dhidhima irra muummee kaaʼetti ani achin ture;<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>yeroo inni gubbaatti duumessa jabeessee dhaabee</para>
  <para style="q2" vid="PRO 8:28">madda tuujubaa illee hundeessetti ani achin ture;<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>yeroo inni akka bishaanonni ajaja isaa hin cabsineef jedhee,</para>
  <para style="q2" vid="PRO 8:29">galaanaaf daangaa dhaabetti,</para>
  <para style="q1" vid="PRO 8:29">yeroo inni lafa hundeessetti ani achin ture.<verse eid="PRO 8:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30"/>Yeroo sanatti ani ogeessa hojii harkaa taʼee isa biran ture.</para>
  <para style="q1" vid="PRO 8:30">Ani yeroo hunda fuula isaa dura burraaqaa,</para>
  <para style="q2" vid="PRO 8:30">guyyuma guyyaadhaan gammachuudhaan guutamaan ture;<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>ani guutummaa addunyaa isaa keessatti ililchaa,</para>
  <para style="q2" vid="PRO 8:31">ilmaan namaatti illee gammadaan ture.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“Eegaa yaa ilmaan ko, mee na dhagaʼaa;</para>
  <para style="q2" vid="PRO 8:32">warri karaa koo eegan eebbifamoo dha.<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>Gorsa koo dhaggeeffadhaatii ogeeyyii taʼaa;</para>
  <para style="q2" vid="PRO 8:33">isa hin tuffatinaa.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>Namni na dhagaʼu,</para>
  <para style="q2" vid="PRO 8:34">kan guyyaa hunda balbala koo eegu,</para>
  <para style="q2" vid="PRO 8:34">kan karra koo dura turu eebbifamaa dha.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>Namni na argatu kam iyyuu jireenya argata;</para>
  <para style="q2" vid="PRO 8:35">
    <char style="nd">Waaqayyo</char> biratti illee fudhatama argata.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>Namni na hin arganne garuu ofuma miidha;</para>
  <para style="q2" vid="PRO 8:36">namni na jibbu hundinuu duʼa jaallata.”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">Ogummaa fi Gowwummaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>Ogummaan mana ishee ijaarratte;</para>
  <para style="q2" vid="PRO 9:1">utubaa ishee torbanis dhagaa irraa qopheeffate.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>Isheen horii qalattee daadhii wayinii ishee bulbulatte;</para>
  <para style="q2" vid="PRO 9:2">maaddii ishee illee qopheeffatte.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>Tajaajiltoota ishee dubarran ergattee</para>
  <para style="q2" vid="PRO 9:3">fiixee magaalaa irraa lallabde.<verse eid="PRO 9:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4"/>Isheen warra qalbii hin qabneen akkana jetti;</para>
  <para style="q1" vid="PRO 9:4">“Isin warri homaa hin beekne hundi as kottaa!<verse eid="PRO 9:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5"/>Kottaatii nyaata koo nyaadhaa;</para>
  <para style="q2" vid="PRO 9:5">daadhii wayinii ani bulbuladhe illee dhugaa.<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>Karaa gowwummaa keessanii sana dhiisaatii jiraadhaa;</para>
  <para style="q2" vid="PRO 9:6">karaa hubannaa irra deemaa.<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>“Namni nama namatti qoosu gorsu kam iyyuu ni arrabsama;</para>
  <para style="q2" vid="PRO 9:7">namni nama hamaa ifatu kam iyyuu ni salphata.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>Ati nama namatti qoosu hin ifatin; inni si jibbaatii;</para>
  <para style="q2" vid="PRO 9:8">nama ogeessa ifadhu; inni si jaallataatii.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>Nama ogeessa gorsi; inni ittuma caalchisee ogeessa taʼaa;</para>
  <para style="q2" vid="PRO 9:9">nama qajeelaaf barumsa kenni; inni beekumsa isaatti dabalaatii.<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>“<char style="nd">Waaqayyoon</char> sodaachuun jalqaba ogummaa ti;</para>
  <para style="q2" vid="PRO 9:10">isa Qulqulluu Sana beekuun hubannaa dha.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>Karaa kootiin barii jireenya keetii ni dheerata;</para>
  <para style="q2" vid="PRO 9:11">jireenya kee irrattis waggoonni ni dabalamuutii.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>Yoo ati nama ogeessa taate, ogummaan kee si badhaasa;</para>
  <para style="q2" vid="PRO 9:12">yoo ati kan namatti qoostu taate suma qofatu gidirama.”<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>Dubartiin gowwaan oduu baayʼifti;</para>
  <para style="q2" vid="PRO 9:13">isheen raatuu homaa hin beeknee dha.<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>Isheen balbala mana ishee dura,</para>
  <para style="q2" vid="PRO 9:14">fiixee magaalaa gubbaa barcuma irra teessee<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>warra achiin darban, kanneen qajeelanii</para>
  <para style="q2" vid="PRO 9:15">daandii isaanii irra deeman waamti.<verse eid="PRO 9:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16"/>Isheen warra qalbii hin qabneen akkana jetti.</para>
  <para style="q1" vid="PRO 9:16">“Isin warri homaa hin beekne hundi as kottaa!<verse eid="PRO 9:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17"/>Bishaan hatan ni miʼaawa;</para>
  <para style="q2" vid="PRO 9:17">nyaanni dhoksaan nyaatanis guddoo namatti tola!”<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>Isaan garuu akka warri duʼan achi jiran,</para>
  <para style="q2" vid="PRO 9:18">akka keessumoonni ishee dhidhima awwaalaa keessa jiran illee <optbreak/> xinnuma beeku.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="ms1">Fakkeenyawwan Solomoon</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>Fakkeenyawwan Solomoon:</para>
  <para style="q1" vid="PRO 10:1">Ilmi ogeessi abbaa isaa gammachiisa;</para>
  <para style="q2" vid="PRO 10:1">ilmi gowwaan garuu haadha isaa gaddisiisa.<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>Qabeenyi karaa hamaadhaan horatan gatii hin qabu;</para>
  <para style="q2" vid="PRO 10:2">qajeelummaan garuu duʼa jalaa nama baasa.<verse eid="PRO 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>
    <char style="nd">Waaqayyo</char> akka warri qajeelaan beelaʼan hin eeyyamu;</para>
  <para style="q2" vid="PRO 10:3">hawwii jalʼootaa garuu ni busheessa.<verse eid="PRO 10:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>Harki hojii hin hojjenne nama hiyyoomsa;</para>
  <para style="q2" vid="PRO 10:4">harki jabaatee hojii hojjetu garuu nama sooromsa.<verse eid="PRO 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>Namni yeroo bonaa midhaan walitti qabatu ilma ogeessa;</para>
  <para style="q2" vid="PRO 10:5">kan yeroo midhaan galfamutti rafu immoo <optbreak/> ilma nama qaanessuu dha.<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>Eebbi mataa qajeeltotaatti gonfoo kaaʼa;</para>
  <para style="q2" vid="PRO 10:6">afaan hamootaa irra garuu jeequmsatu lolaʼa.<verse eid="PRO 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>Yaadannoon nama qajeelaa eebba taʼa;</para>
  <para style="q2" vid="PRO 10:7">maqaan nama hamaa garuu lafa irraa bada.<verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>Namni garaa isaatti ogeessa taʼe ajaja fudhata;</para>
  <para style="q2" vid="PRO 10:8">gowwaan oduu baayʼisu garuu ni bada.<verse eid="PRO 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>Namni amanamaan sodaa malee deema;</para>
  <para style="q2" vid="PRO 10:9">kan karaa isaa jalʼisu garuu ni saaxilama.<verse eid="PRO 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>Namni ija hamminaatiin waa namaan jedhu rakkoo uuma;</para>
  <para style="q2" vid="PRO 10:10">gowwaan oduu baayʼisu garuu ni bada.<verse eid="PRO 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>Afaan nama qajeelaa burqaa jireenyaa ti;</para>
  <para style="q2" vid="PRO 10:11">afaan hamootaa irra garuu jeequmsatu lolaʼa.<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>Jibbi lola kakaasa;</para>
  <para style="q2" vid="PRO 10:12">jaalalli garuu balleessaa hunda haguuga.<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>Ogummaan hidhii nama waa hubatuu irratti argamti;</para>
  <para style="q2" vid="PRO 10:13">uleen immoo dirra nama hubannaa hin qabnee irra buʼa.<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>Namoonni ogeeyyiin beekumsa kuufatu;</para>
  <para style="q2" vid="PRO 10:14">afaan gowwaa garuu badiisa waama.<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>Qabeenyi sooreyyii isaaniif magaalaa daʼoo qabduu dha;</para>
  <para style="q2" vid="PRO 10:15">hiyyummaan garuu badiisa hiyyeeyyii ti.<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>Mindaan qajeeltotaa jireenya;</para>
  <para style="q2" vid="PRO 10:16">galiin hamootaa garuu cubbuu fi duʼa.<verse eid="PRO 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>Namni gorsa fudhatu karaa jireenyaa irra deema;</para>
  <para style="q2" vid="PRO 10:17">namni adaba didu kam iyyuu garuu warra kaan karaa irraa jalʼisa.<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>Namni hidhii sobuun jibba dhokfatu,</para>
  <para style="q2" vid="PRO 10:18">kan maqaa namaa balleessus gowwaa dha.<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>Yoo dubbiin baayʼatu, cubbuun keessaa hin dhabamu;</para>
  <para style="q2" vid="PRO 10:19">namni arraba isaa eeggatu garuu ogeessa.<verse eid="PRO 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>Arrabni nama qajeelaa meetii filatamaa dha;</para>
  <para style="q2" vid="PRO 10:20">garaan nama hamaa garuu faayidaa xinnoo qaba.<verse eid="PRO 10:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>Arrabni nama qajeelaa nama hedduu soora;</para>
  <para style="q2" vid="PRO 10:21">gowwoonni garuu hubannaa dhabiisaan duʼu.<verse eid="PRO 10:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>Eebbi <char style="nd">Waaqayyoo</char> nama sooromsa;</para>
  <para style="q2" vid="PRO 10:22">inni rakkina tokko illee itti hin dabalu.<verse eid="PRO 10:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>Gowwaan amala hamaadhaan gammachuu argata;</para>
  <para style="q2" vid="PRO 10:23">namni waa hubatu garuu ogummaatti gammada.<verse eid="PRO 10:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>Wanni namni hamaan sodaatu isumatti dhufa;</para>
  <para style="q2" vid="PRO 10:24">hawwiin nama qajeelaa immoo ni guutamaaf.<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>Yeroo bubbeen hamaan bubbisu namoonni hamoon ni badu;</para>
  <para style="q2" vid="PRO 10:25">qajeeltonni garuu bara baraan jabaatanii jiraatu.<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Akkuma wanni dhangaggaaʼaan ilkaan miidhee, <optbreak/> aarris ija miidhu sana</para>
  <para style="q2" vid="PRO 10:26">namni dhibaaʼaan warra isa ergatu miidha.<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>
    <char style="nd">Waaqayyoon</char> sodaachuun bara jireenya namaa dheeressa;</para>
  <para style="q2" vid="PRO 10:27">umuriin nama hamaa garuu ni gabaabbata.<verse eid="PRO 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>Abdiin nama qajeelaa gammachuu taʼa;</para>
  <para style="q2" vid="PRO 10:28">wanni namni hamaan eeggatu garuu ni bada.<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>Karaan <char style="nd">Waaqayyoo</char> nama qajeelaaf daʼoo dha;</para>
  <para style="q2" vid="PRO 10:29">nama jalʼaaf garuu badiisa.<verse eid="PRO 10:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>Qajeeltonni yoom iyyuu hin fonqolfaman;</para>
  <para style="q2" vid="PRO 10:30">hamoonni garuu lafa irratti hin hafan.<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>Afaan nama qajeelaa ogummaa dubbata;</para>
  <para style="q2" vid="PRO 10:31">arrabni jalʼaan garuu ni kutama.<verse eid="PRO 10:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>Arrabni nama qajeelaa waan fudhatama qabu dubbata;</para>
  <para style="q2" vid="PRO 10:32">afaan nama hamaa garuu waan jalʼaa qofa dubbata.<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>
    <char style="nd">Waaqayyo</char> madaalii hin amanamne ni balfa;</para>
  <para style="q2" vid="PRO 11:1">madaalii dhugaatti immoo ni gammada.<verse eid="PRO 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>Gaafa of tuuluun dhufu, salphinatu dhufa;</para>
  <para style="q2" vid="PRO 11:2">gad of qabiisa wajjin immoo ogummaatu dhufa.<verse eid="PRO 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>Amanamummaan tolootaa isaan dura deema;</para>
  <para style="q2" vid="PRO 11:3">warri hin amanamne garuu dabuma isaaniitiin badu.<verse eid="PRO 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>Guyyaa dheekkamsaatti qabeenyi faayidaa hin qabu;</para>
  <para style="q2" vid="PRO 11:4">qajeelummaan garuu duʼa jalaa nama baasa.<verse eid="PRO 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>Qajeelummaan warra mudaa hin qabnee <optbreak/> karaa qajeelaa baasaaf;</para>
  <para style="q2" vid="PRO 11:5">hamoonni garuu hamminuma isaaniitiin badu.<verse eid="PRO 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>Qajeelummaan tolootaa isaan oolcha;</para>
  <para style="q2" vid="PRO 11:6">warri hin amanamne garuu <optbreak/> hawwii hamaadhaan qabamu.<verse eid="PRO 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>Yeroo namni hamaan duʼu, abdiin isaas ni bada;</para>
  <para style="q2" vid="PRO 11:7">wanni namni hamaan eeggatus ni barbadeeffama.<verse eid="PRO 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>Namni qajeelaan rakkoo jalaa ni baafama;</para>
  <para style="q2" vid="PRO 11:8">rakkoon sunis qooda isaa nama hamaa irra gaʼa.<verse eid="PRO 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>Namni Waaqatti hin bulle dubbii afaan isaatiin ollaa isaa balleessa;</para>
  <para style="q2" vid="PRO 11:9">namni qajeelaan immoo beekumsaan miliqa.<verse eid="PRO 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>Yommuu namni qajeelaan badhaadhu magaalaan ni gammada;</para>
  <para style="q2" vid="PRO 11:10">yommuu namni hamaan barbadaaʼu immoo iyya gammachuutu dhagaʼama.<verse eid="PRO 11:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>Eebba nama tolaatiin magaalaan ulfina argata;</para>
  <para style="q2" vid="PRO 11:11">afaan nama hamaatiin garuu ni barbadeeffama.<verse eid="PRO 11:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>Namni sammuu hin qabne ollaa isaa tuffata;</para>
  <para style="q2" vid="PRO 11:12">kan hubannaa qabu garuu ni calʼisa.<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>Namni odeessu dhoksaa gad baasa;</para>
  <para style="q2" vid="PRO 11:13">kan amanamu garuu icciitii eega.<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>Qajeelfama dhabiisaan sabni ni kufa;</para>
  <para style="q2" vid="PRO 11:14">baayʼina gorsitootaatiin garuu nagaatu argama.<verse eid="PRO 11:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>Namni nama hin beekneef wabii taʼu ni rakkata;</para>
  <para style="q2" vid="PRO 11:15">namni namaaf kakachuuf jedhee harka dhaʼuu didu immoo <optbreak/> nagaan jiraata.<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>Dubartiin gara laafettiin ulfina argatti;</para>
  <para style="q2" vid="PRO 11:16">namoonni garaa dhagaa immoo qabeenya qofa argatu.<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>Namni gaariin of fayyada;</para>
  <para style="q2" vid="PRO 11:17">gara jabeessi garuu rakkina ofitti fida.<verse eid="PRO 11:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>Namni hamaan mindaa sobaa argata;</para>
  <para style="q2" vid="PRO 11:18">kan qajeelummaa facaafatu immoo badhaasa dhugaa argata.<verse eid="PRO 11:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>Namni qajeelaan dhugumaan jireenya argata;</para>
  <para style="q2" vid="PRO 11:19">kan waan hamaa duukaa buʼu garuu gara duʼaa argata.<verse eid="PRO 11:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>
    <char style="nd">Waaqayyo</char> warra yaada jalʼaa qaban balfa;</para>
  <para style="q2" vid="PRO 11:20">warra karaan isaanii mudaa hin qabnetti immoo ni gammada.<verse eid="PRO 11:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>Waan kana hubadhu: Namni hamaan utuu hin adabamin hin hafu;</para>
  <para style="q2" vid="PRO 11:21">qajeeltonni garuu bilisa baʼu.<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>Dubartiin miidhagduun qalbii hin qabne</para>
  <para style="q2" vid="PRO 11:22">akkuma qubeelaa warqee kan funyaan booyyeetti jirtuu ti.<verse eid="PRO 11:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>Wanni qajeeltonni hawwan gaarii taʼaaf;</para>
  <para style="q2" vid="PRO 11:23">abdiin hamootaa garuu dheekkamsa qofa taʼa.<verse eid="PRO 11:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>Namni tokko toluma waa namaa kenna;</para>
  <para style="q2" vid="PRO 11:24">taʼus ittuma caalchisee sooroma;</para>
  <para style="q2" vid="PRO 11:24">kaan immoo waan kennuu malu dhowwata; <optbreak/> taʼus inuma hiyyooma.<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>Namni arjaan ni badhaadha;</para>
  <para style="q2" vid="PRO 11:25">namni warra kaan dheebuu baasu ofii isaatii illee dheebuu baʼa.<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>Nama dhoksee midhaan kuufatu sabni ni abaara;</para>
  <para style="q2" vid="PRO 11:26">kan gurguruuf fedhii qabu immoo eebbatu gonfoo taʼaaf.<verse eid="PRO 11:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>Namni waan gaarii barbaadu carraa gaarii argata;</para>
  <para style="q2" vid="PRO 11:27">hamminni garuu nama hammina barbaadutti dhufa.<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Namni sooruma ofii isaa abdatu kam iyyuu ni kufa;</para>
  <para style="q2" vid="PRO 11:28">qajeelaan garuu akkuma baala magariisaatti lalisa.<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>Namni maatii isaatti rakkoo fidu bubbee qofa dhaala;</para>
  <para style="q2" vid="PRO 11:29">gowwaan immoo garbicha nama ogeessaa taʼa.<verse eid="PRO 11:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>Iji nama qajeelaa muka jireenyaa ti;</para>
  <para style="q2" vid="PRO 11:30">namni lubbuu namaa baraaru immoo ogeessa.<verse eid="PRO 11:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>Erga qajeeltonni lafa irratti gatii isaanii argatanii,</para>
  <para style="q2" vid="PRO 11:31">namni Waaqatti hin bullee fi cubbamaan <optbreak/> hammam caalaa haa argatanii ree!<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>Namni adabamuu jaallatu kam iyyuu beekumsa jaallata;</para>
  <para style="q2" vid="PRO 12:1">kan sirreeffamuu jibbu garuu gowwaa dha.<verse eid="PRO 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>Namni gaariin <char style="nd">Waaqayyo</char> biratti fudhatama argata;</para>
  <para style="q2" vid="PRO 12:2">
    <char style="nd">Waaqayyo</char> garuu nama hammina malatutti ni mura.<verse eid="PRO 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>Namni tokko hamminaan jabaatee hin dhaabatu;</para>
  <para style="q2" vid="PRO 12:3">qajeelaan garuu hin buqqifamu.<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Niitiin amala gaarii dhirsa isheetiif gonfoo dha;</para>
  <para style="q2" vid="PRO 12:4">niitiin qaanessitu garuu akkuma tortora lafee isaa keessaa ti.<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>Karoorri qajeeltotaa qajeelaa dha;</para>
  <para style="q2" vid="PRO 12:5">gorsi jalʼootaa garuu gowwoomsaa dha.<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>Dubbiin hamootaa dhiiga dhangalaasuuf <optbreak/> riphee nama eeggata;</para>
  <para style="q2" vid="PRO 12:6">haasaan tolootaa garuu duʼa jalaa nama baasa.<verse eid="PRO 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>Namoonni hamoon ni garagalfamu; deebiʼaniis hin argaman;</para>
  <para style="q2" vid="PRO 12:7">manni qajeeltotaa garuu jabaatee dhaabata.<verse eid="PRO 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>Namni tokko akkuma ogummaa isaatti jajama;</para>
  <para style="q2" vid="PRO 12:8">namni yaada jalʼaa qabu immoo ni tuffatama.<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>Namni tuffatamaan hojjetaa qabu tokko,</para>
  <para style="q2" vid="PRO 12:9">nama of kabaju kan waan nyaatu iyyuu hin qabne caala.<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>Namni qajeelaan lubbuu horii isaatiif yaada;</para>
  <para style="q2" vid="PRO 12:10">hojiin jalʼootaa garuu tolaan isaa iyyuu hammina.<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>Namni lafa isaa qotatu nyaata guddaa argata;</para>
  <para style="q2" vid="PRO 12:11">kan yaada faayidaa hin qabne duukaa buʼu garuu hubannaa hin qabu.<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>Hamoonni boojuu jalʼootaa hawwu;</para>
  <para style="q2" vid="PRO 12:12">hiddi qajeeltotaa garuu ni lalisa.<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>Namni hamaan cubbuu afaan isaatiin qabama;</para>
  <para style="q2" vid="PRO 12:13">namni qajeelaan garuu rakkoo jalaa miliqa.<verse eid="PRO 12:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>Namni waan afaan isaatii baʼuun waan gaariin guutama;</para>
  <para style="q2" vid="PRO 12:14">hojiin harka namaas isumaaf deebiʼa.<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>Nama gowwaa karaan isaa qajeelaa itti fakkaata;</para>
  <para style="q2" vid="PRO 12:15">namni ogeessi garuu gorsa dhagaʼa.<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Aariin gowwaa yommusuma isa irraa beekama;</para>
  <para style="q2" vid="PRO 12:16">namni hubataan garuu arrabsoo tuffata.<verse eid="PRO 12:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>Namnii dhugaa dubbatu ragaa amanamaa kenna;</para>
  <para style="q2" vid="PRO 12:17">dhuga baatuun sobaa garuu soba dubbatti.<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Dubbiin of eeggannaa hin qabne <optbreak/> akkuma goraadee nama waraana;</para>
  <para style="q2" vid="PRO 12:18">arrabni nama ogeessaa garuu nama fayyisa.<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>Afaan dhugaa dubbatu bara baraan jiraata;</para>
  <para style="q2" vid="PRO 12:19">arrabni soba dubbatu garuu yeroo gabaabaa qofa jiraata.<verse eid="PRO 12:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>Garaa warra waan hamaa malatanii keessa <optbreak/> gowwoomsaatu jira;</para>
  <para style="q2" vid="PRO 12:20">warri nagaa buusan garuu gammachuu qabu.<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>Qajeeltotatti miidhaan tokko iyyuu hin dhufu;</para>
  <para style="q2" vid="PRO 12:21">hamoonni rakkinaan guutamu.<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>
    <char style="nd">Waaqayyo</char> arraba sobu ni jibba;</para>
  <para style="q2" vid="PRO 12:22">warra dhugaa dubbatutti garuu ni gammada.<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>Namni hubataan beekaa taʼuu isaa dhokfata;</para>
  <para style="q2" vid="PRO 12:23">gowwoonni garuu gowwummaa isaanii labsu.<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>Harki nama jabaatee hojjetuu ni moʼa;</para>
  <para style="q2" vid="PRO 12:24">dhibaaʼummaan garuu garbummaatti nama geessa.<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>Garaan yaaddaʼu gad nama deebisa;</para>
  <para style="q2" vid="PRO 12:25">dubbiin tolaan immoo nama gammachiisa.<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>Namni qajeelaan ollaa isaa karaa argisiisa;</para>
  <para style="q2" vid="PRO 12:26">karaan hamootaa garuu karaa irraa nama jalʼisa.<verse eid="PRO 12:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>Namni dhibaaʼaan waan adamsee ajjeese hin waaddatu;</para>
  <para style="q2" vid="PRO 12:27">kan jabaatee hojjetu immoo qabeenya gatii guddaa argata.<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>Karaa qajeelummaa irra jireenyatu jira;</para>
  <para style="q2" vid="PRO 12:28">daandii sana irra duuti hin jiru.<verse eid="PRO 12:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>Ilmi ogeessi gorsa abbaa isaa dhagaʼa;</para>
  <para style="q2" vid="PRO 13:1">qoostuun namaa immoo dheekkamsa hin dhaggeeffatu.<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>Namni waan afaan isaatii baʼuun waan gaariin gammada;</para>
  <para style="q2" vid="PRO 13:2">namni hin amanamne garuu jeequmsaaf ariifata.<verse eid="PRO 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Namni arraba isaa eeggatu, jireenya isaa eeggata;</para>
  <para style="q2" vid="PRO 13:3">kan of eeggachuu malee dubbatu immoo baduuf ariifata.<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>Fedhiin dhibaaʼaa yoom iyyuu hin guutamu;</para>
  <para style="q2" vid="PRO 13:4">fedhiin nama jabaatee hojjetuu immoo guutumaan ni milkaaʼa.<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>Namni qajeelaan soba jibba;</para>
  <para style="q2" vid="PRO 13:5">namni hamaan garuu qaanii fi salphina fida.<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>Qajeelummaatu nama tolaa tiksa;</para>
  <para style="q2" vid="PRO 13:6">hamminni garuu cubbamaa galaafata.<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>Namni tokko sooressa of fakkeessa; garuu homaa hin qabu;</para>
  <para style="q2" vid="PRO 13:7">tokko immoo hiyyeessa of fakkeessa; garuu qabeenya guddaa qaba.<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>Soorumni nama tokkoo furii jireenya isaa taʼuu dandaʼa;</para>
  <para style="q2" vid="PRO 13:8">hiyyeessi garuu ifannaa hin dhagaʼu.<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>Ifni nama qajeelaa akka gaarii ifa;</para>
  <para style="q2" vid="PRO 13:9">ibsaan nama hamaa garuu ni dhaama.<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>Of tuulummaan lola qofa baayʼisa; ogummaan garuu</para>
  <para style="q2" vid="PRO 13:10">warra gorsa dhagaʼan biratti argamti.<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>Maallaqni karaa sobaatiin dhufu dafee bada;</para>
  <para style="q2" vid="PRO 13:11">namni xinnoo xinnoon maallaqa walitti qabatu garuu ni kuufata.<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>Abdiin lafa irra harkifatu garaa nama dhukkubsa;</para>
  <para style="q2" vid="PRO 13:12">hawwiin guutamu garuu muka jireenyaa ti.<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>Namni gorsa tuffatu badiisa ofitti fida;</para>
  <para style="q2" vid="PRO 13:13">kan ajaja ulfeessu immoo badhaasa argata.<verse eid="PRO 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>Barsiisni nama ogeessaa burqaa jireenyaa ti;</para>
  <para style="q2" vid="PRO 13:14">kiyyoo duʼaa irraas nama deebisa.<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>Hubannaan gaariin surraa argamsiisa;</para>
  <para style="q2" vid="PRO 13:15">karaan warra hin amanamnee garuu <optbreak/> badiisatti isaan geessa.<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>Namni qalbii qabu kam iyyuu beekumsaan hojjeta;</para>
  <para style="q2" vid="PRO 13:16">gowwaan immoo gowwummaa isaa mulʼisa.<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>Ergamaan hamaan rakkoo keessa seena;</para>
  <para style="q2" vid="PRO 13:17">ergamaan amanamaan garuu fayyina fida.<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>Namni adabamuu jibbu ni hiyyooma; ni qaanaʼas;</para>
  <para style="q2" vid="PRO 13:18">kan sirreeffama kabaju immoo ulfina argata.<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>Hawwiin guutame namatti miʼaawa;</para>
  <para style="q2" vid="PRO 13:19">gowwoonni garuu waan hamaa irraa deebiʼuu balfu.<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>Namni nama ogeessa wajjin deemu ogeessa taʼa,</para>
  <para style="q2" vid="PRO 13:20">michuun gowwootaa garuu ni miidhama.<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>Wanni hamaan cubbamoota ariʼata;</para>
  <para style="q2" vid="PRO 13:21">badhaadhummaan immoo badhaasa qajeelotaa ti.<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>Namni gaariin ilmaan ilmaan isaatiif dhaala dabarsa;</para>
  <para style="q2" vid="PRO 13:22">qabeenyi nama cubbamaa garuu qajeeltotaaf kuufama.<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>Qonnaan hiyyeessaa midhaan guddaa baasa;</para>
  <para style="q2" vid="PRO 13:23">murtiin jalʼaan garuu haxaaʼee duraa balleessa.<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>Namni harcummee qusatu ilma isaa jibba;</para>
  <para style="q2" vid="PRO 13:24">kan ilma ofii jaallatu immoo ilaallachaa isa adaba.<verse eid="PRO 13:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>Namni qajeelaan hamma quufutti nyaata;</para>
  <para style="q2" vid="PRO 13:25">garaan nama hamaa garuu ni beelaʼa.<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>Dubartiin ogeettiin mana ishee ijaarratti;</para>
  <para style="q2" vid="PRO 14:1">gowwaan immoo harkuma isheetiin mana ofii diigdi.<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>Namni qajeelummaan jiraatu <char style="nd">Waaqayyoon</char> sodaata;</para>
  <para style="q2" vid="PRO 14:2">kan karaan isaa jalʼaa taʼe garuu isa tuffata.<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>Afaan nama gowwaa dugda isaatti ulee of tuulummaa fida;</para>
  <para style="q2" vid="PRO 14:3">arrabni ogeeyyii garuu isaan eega.<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Yoo qotiyyoon hin jirre, dallaan duwwaa taʼa;</para>
  <para style="q2" vid="PRO 14:4">garuu humna qotiyyoo tokkootiin midhaan baayʼeen argama.<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>Dhuga baatuun amanamaan hin sobu;</para>
  <para style="q2" vid="PRO 14:5">dhuga baatuun sobaa immoo dhara of keessaa gad naqa.<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>Qoostuun namaa ogummaa barbaadee hin argatu;</para>
  <para style="q2" vid="PRO 14:6">nama waa hubatuuf garuu beekumsi dadhabbii malee dhufa.<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>Ati nama gowwaa irraa fagaadhu;</para>
  <para style="q2" vid="PRO 14:7">arraba isaa irraa beekumsa hin argattuutii.<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>Ogummaan hubattootaa akka isaan karaa isaanii beekan isaan godha;</para>
  <para style="q2" vid="PRO 14:8">gowwummaan gowwootaa garuu karaa irraa isaan balleessa.<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>Gowwoonni cubbuutti qoosu;</para>
  <para style="q2" vid="PRO 14:9">qajeeltota gidduutti garuu hawwii gaariitu argama.<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>Garaan gadda ofii isaa ni beeka;</para>
  <para style="q2" vid="PRO 14:10">namni biraa tokko iyyuu gammachuu isaa irraa hin qooddatu.<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>Manni nama hamaa ni bada;</para>
  <para style="q2" vid="PRO 14:11">dunkaanni nama qajeelaa immoo ni daraara.<verse eid="PRO 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>Karaan qajeelaa namatti fakkaatu tokko jira;</para>
  <para style="q2" vid="PRO 14:12">dhuma irratti garuu duʼatti nama geessa.<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>Kolfa keessatti iyyuu garaan nama dhukkubuu dandaʼa;</para>
  <para style="q2" vid="PRO 14:13">gammachuunis gaddaan dhumuu dandaʼa.<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>Namni hin amanamne gatii karaa isaa,</para>
  <para style="q2" vid="PRO 14:14">namni gaariin immoo gatii hojii isaa argata.<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>Namni homaa hin beekne waan hunda amana;</para>
  <para style="q2" vid="PRO 14:15">namni qalbii qabu garuu tarkaanfii isaa ilaallata.<verse eid="PRO 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>Namni ogeessi of eeggata; waan hamaa irraas ni deebiʼa;</para>
  <para style="q2" vid="PRO 14:16">gowwaan garuu waan hundatti jarjara; of illee hin eeggatu.<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>Namni dafee aaru gowwummaa hojjeta;</para>
  <para style="q2" vid="PRO 14:17">namni daba hojjetu garuu ni jibbama.<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>Namni homaa hin beekne gowwummaa dhaala;</para>
  <para style="q2" vid="PRO 14:18">qalbeeffataan garuu beekumsa gonfata.<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>Namoonni hamoon fuula namoota gaarii duratti,</para>
  <para style="q2" vid="PRO 14:19">jalʼoonnis karra qajeeltotaa duratti sagadu.<verse eid="PRO 14:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>Hiyyeeyyii olloonni isaanii iyyuu ni jibbu;</para>
  <para style="q2" vid="PRO 14:20">sooreyyiin immoo michoota hedduu qabu.<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>Namni ollaa isaa tuffatu cubbuu hojjeta;</para>
  <para style="q2" vid="PRO 14:21">kan rakkataaf garaa laafu garuu eebbifamaa dha.<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>Namni hammina yaadu karaa irraa hin baduu?</para>
  <para style="q2" vid="PRO 14:22">Warri waan gaarii karoorsan garuu jaalalaa fi <optbreak/> amanamummaa argatu.<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>Jabaatanii hojjechuun hundi buʼaa buusa;</para>
  <para style="q2" vid="PRO 14:23">oduun faayidaa hin qabne garuu hiyyummaa qofa fida.<verse eid="PRO 14:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>Gonfoon ogeeyyii qabeenya isaanii ti;</para>
  <para style="q2" vid="PRO 14:24">gowwummaan gowwootaa garuu gowwummaa dhala.<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>Dhuga baatuun dhugaa lubbuu baraara;</para>
  <para style="q2" vid="PRO 14:25">dhuga baatuun sobaa immoo soba dubbata.<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>Namni <char style="nd">Waaqayyoon</char> sodaatu daʼannoo jabaa qaba;</para>
  <para style="q2" vid="PRO 14:26">ijoolleen isaas daʼoo argatu.<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>
    <char style="nd">Waaqayyoon</char> sodaachuun burqaa jireenyaa ti;</para>
  <para style="q2" vid="PRO 14:27">kiyyoo duʼaa irraas nama deebisa.<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>Ulfinni mootii tokkoo baayʼina uummata isaa ti;</para>
  <para style="q2" vid="PRO 14:28">yoo uummanni hin jirre garuu ilmi mootiis ni bada.<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>Namni obsa qabu hubannaa guddaa qaba;</para>
  <para style="q2" vid="PRO 14:29">kan dafee aaru garuu gowwummaa mulʼisa.<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>Garaan nagaa qabu dhagnaaf jireenya kenna;</para>
  <para style="q2" vid="PRO 14:30">hinaaffaan garuu lafee tortorsa.<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>Namni hiyyeessa cunqursu kan isa Uume tuffata;</para>
  <para style="q2" vid="PRO 14:31">namni hiyyeessaaf garaa laafu immoo Waaqa kabaja.<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>Hamoonni jalʼinuma isaaniitiin badu;</para>
  <para style="q2" vid="PRO 14:32">qajeeltonni garuu duʼa keessatti illee <optbreak/> amanamummaa isaaniitiin daʼannoo argatu.<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>Ogummaan qalbii nama waa hubatuu keessa jirti;</para>
  <para style="q2" vid="PRO 14:33">garaa gowwootaa keessatti garuu hin beekamtu.<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>Qajeelummaan saba ol guddisa;</para>
  <para style="q2" vid="PRO 14:34">cubbuun garuu saba kamiif iyyuu salphina.<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>Mootiin tajaajilaa ogeessatti ni gammada;</para>
  <para style="q2" vid="PRO 14:35">kan isa qaanessutti garuu ni dheekkama.<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>Deebiin laafaan dheekkamsa qabbaneessa;</para>
  <para style="q2" vid="PRO 15:1">jechi hamaan garuu aarii kakaasa.<verse eid="PRO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>Arrabni nama ogeessaa beekumsa jaja;</para>
  <para style="q2" vid="PRO 15:2">afaan nama gowwaa garuu gowwummaa dhangalaasa.<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>Iji <char style="nd">Waaqayyoo</char> idduma hunda jira;</para>
  <para style="q2" vid="PRO 15:3">nama hamaa fi gaariis ni toʼata.<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>Arrabni fayyina fidu muka jireenyaa ti;</para>
  <para style="q2" vid="PRO 15:4">arrabni sobu garuu hafuura cabsa.<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>Gowwaan adabbii abbaa isaa tuffata;</para>
  <para style="q2" vid="PRO 15:5">namni sirreeffama fudhatu kam iyyuu garuu qalbii qabeessa.<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>Manni nama qajeelaa badhaadhummaa guddaa qaba;</para>
  <para style="q2" vid="PRO 15:6">galiin nama hamaa garuu rakkoo isatti fida.<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>Arrabni nama ogeessaa beekumsa facaasa;</para>
  <para style="q2" vid="PRO 15:7">garaan nama gowwaa garuu akkas miti.<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>
    <char style="nd">Waaqayyo</char> aarsaa hamootaa ni balfa;</para>
  <para style="q2" vid="PRO 15:8">kadhannaan tolootaa garuu isa gammachiisa.<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>
    <char style="nd">Waaqayyo</char> karaa hamootaa ni balfa;</para>
  <para style="q2" vid="PRO 15:9">warra qajeelummaa duukaa buʼan garuu ni jaallata.<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>Nama daandii irraa jalʼatu adabbii hamaatu isa eeggata;</para>
  <para style="q2" vid="PRO 15:10">kan sirreeffama jibbu ni duʼa.<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>Duʼaa fi Badiisni fuula <char style="nd">Waaqayyoo</char> duratti beekamoo dha;</para>
  <para style="q2" vid="PRO 15:11">yoos garaan namaa hammam caalaa haa beekamu ree!<verse eid="PRO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>Namni qoosu sirreeffama hin jaallatu;</para>
  <para style="q2" vid="PRO 15:12">nama ogeessaanis hin mariʼatu.<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>Garaan gammadu akka fuulli ifu godha;</para>
  <para style="q2" vid="PRO 15:13">gaddi garaa garuu hafuura cabsa.<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>Garaan waa qalbeeffatu beekumsa barbaada;</para>
  <para style="q2" vid="PRO 15:14">afaan gowwaa garuu gowwummaa nyaata.<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>Barri nama hacuucamee guutumaan guutuutti gadadoo dha;</para>
  <para style="q2" vid="PRO 15:15">garaa gammaduuf garuu guyyaan hundinuu cidha.<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>Qabeenya guddaa rakkina of keessaa qabuu mannaa,</para>
  <para style="q2" vid="PRO 15:16">
    <char style="nd">Waaqayyoon</char> sodaachaa waan xinnaa qabaachuu wayya.<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Jibbaan cooma sangaa nyaachuu mannaa,</para>
  <para style="q2" vid="PRO 15:17">jaalalaan raafuu nyaachuu wayya.<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Namni dafee aaru lola kakaasa;</para>
  <para style="q2" vid="PRO 15:18">namni obsa qabu garuu lola qabbaneessa.<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>Karaan nama dhibaaʼaa qoraattiidhaan cufama;</para>
  <para style="q2" vid="PRO 15:19">daandiin tolootaa garuu karaa diriiraa dha.<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>Ilmi ogeessi abbaa isaa gammachiisa;</para>
  <para style="q2" vid="PRO 15:20">namni gowwaan garuu haadha isaa tuffata.<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>Nama qalbii hin qabne gowwummaatu isa gammachiisa;</para>
  <para style="q2" vid="PRO 15:21">namni hubataan garuu daandii qajeelaa irra deema.<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>Karoorri gorsa hin qabne fiixaan hin baʼu;</para>
  <para style="q2" vid="PRO 15:22">garuu gorsitoota hedduudhaan ni milkaaʼa.<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>Namni tokko deebii malu kennuudhaan gammachuu argata;</para>
  <para style="q2" vid="PRO 15:23">dubbiin yeroo isaatti dubbatamu akkam gaarii dha!<verse eid="PRO 15:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>Daandiin nama hubataa akka inni siiʼoolitti gad hin buuneef</para>
  <para style="q2" vid="PRO 15:24">gara jireenyaatti ol isa baasa.<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>
    <char style="nd">Waaqayyo</char> mana nama of tuuluu ni diiga;</para>
  <para style="q2" vid="PRO 15:25">daangaa haadha hiyyeessaa garuu ni dhaaba.<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>
    <char style="nd">Waaqayyo</char> yaada nama hamaa ni balfa;</para>
  <para style="q2" vid="PRO 15:26">yaadni nama qulqulluu garuu isa gammachiisa.<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>Namni doqni maatii isaatti rakkina fida;</para>
  <para style="q2" vid="PRO 15:27">kan mattaʼaa jibbu garuu ni jiraata.<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>Garaan nama qajeelaa haala ittiin deebii kennu yaada;</para>
  <para style="q2" vid="PRO 15:28">afaan nama hamaa garuu hammina dhangalaasa.<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>
    <char style="nd">Waaqayyo</char> nama hamaa irraa fagoo jira;</para>
  <para style="q2" vid="PRO 15:29">kadhannaa nama qajeelaa garuu ni dhagaʼa.<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>Fuulli ifaan garaa gammachiisa;</para>
  <para style="q2" vid="PRO 15:30">oduun gaariinis lafee haaromsa.<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>Namni adabbii jireenya kennu dhaggeeffatu,</para>
  <para style="q2" vid="PRO 15:31">ogeeyyii gidduu jiraata.<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>Namni adabbii tuffatu ofuma tuffata;</para>
  <para style="q2" vid="PRO 15:32">kan sirreeffama fudhatu garuu hubannaa argata.<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>
    <char style="nd">Waaqayyoon</char> sodaachuun ogummaa nama barsiisa;</para>
  <para style="q2" vid="PRO 15:33">gad of qabuunis ulfina dura dhufa.<verse eid="PRO 15:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>Karoorri garaa kan namaa ti;</para>
  <para style="q2" vid="PRO 16:1">deebiin arrabaa garuu <char style="nd">Waaqayyo</char> biraa dhufa.<verse eid="PRO 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>Nama tokko karaan isaa hundi qulqulluu itti fakkaata;</para>
  <para style="q2" vid="PRO 16:2">yaada namaa garuu <char style="nd">Waaqayyotu</char> madaala.<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>Waan hojjettu hunda <char style="nd">Waaqayyotti</char> kennadhu;</para>
  <para style="q2" vid="PRO 16:3">karoorri kees siif milkaaʼa.<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>
    <char style="nd">Waaqayyo</char> waan hunda kaayyoo ofii isaatiif hojjeta;</para>
  <para style="q2" vid="PRO 16:4">hamoota iyyuu guyyaa badiisaatiif qopheessa.<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>Namni of tuulu kam iyyuu fuula <char style="nd">Waaqayyoo</char> duratti balfamaa dha;</para>
  <para style="q2" vid="PRO 16:5">dhugumaan inni utuu hin adabamin hin hafu.<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>Namni jaalalaa fi amanamummaadhaan araara cubbuu argata;</para>
  <para style="q2" vid="PRO 16:6">
    <char style="nd">Waaqayyoon</char> sodaachuudhaanis hammina irraa cita.<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>Yoo karaan namaa <char style="nd">Waaqayyoon</char> gammachiise,</para>
  <para style="q2" vid="PRO 16:7">inni akka diinonni isaas nagaan isa wajjin jiraatan ni godha.<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>Galii guddaa jalʼinaan argatan mannaa</para>
  <para style="q2" vid="PRO 16:8">waan xinnoo qajeelummaan argatan wayya.<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>Namni garaa isaa keessatti karaa isaa karoorfata;</para>
  <para style="q2" vid="PRO 16:9">
    <char style="nd">Waaqayyo</char> garuu tarkaanfii isaa illee ni murteessa.<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>Hidhiin mootii hooda dubbata;</para>
  <para style="q2" vid="PRO 16:10">afaan isaa illee murtii hin jalʼisu.<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>Madaallii fi safartuun qajeelaan kan <char style="nd">Waaqayyoo</char> ti;</para>
  <para style="q2" vid="PRO 16:11">ulfinni korojoo keessa jiru hundinuu hojii isaa ti.<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>Sababii teessoon qajeelummaadhaan jabaatee dhaabatuuf</para>
  <para style="q2" vid="PRO 16:12">mootonni waan hamaa hojjechuu ni balfu.<verse eid="PRO 16:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>Mootonni afaan dhugaa dubbatutti ni gammadu;</para>
  <para style="q2" vid="PRO 16:13">isaan nama dhugaa dubbatu ni jaallatu.<verse eid="PRO 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>Dheekkamsi mootii ergamaa duʼaa ti;</para>
  <para style="q2" vid="PRO 16:14">namni ogeessi garuu ni qabbaneessa.<verse eid="PRO 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>Jireenyi ifa fuula mootii keessa jira;</para>
  <para style="q2" vid="PRO 16:15">surraan isaa akkuma duumessa bokkaa arfaasaa ti.<verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>Ogummaa argachuun warqee caala;</para>
  <para style="q2" vid="PRO 16:16">hubannaa argachuunis meetii caala!<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>Daandiin nama tolaa hammina irraa fagoo dha;</para>
  <para style="q2" vid="PRO 16:17">namni karaa isaa eegus jireenya isaa eeggata.<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>Of tuuluun badiisaan dura,</para>
  <para style="q2" vid="PRO 16:18">of bokoksuunis kufaatiin dura deema.<verse eid="PRO 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>Warra of tuulu wajjin boojuu qooddachuu mannaa,</para>
  <para style="q2" vid="PRO 16:19">hafuuraan gad of qabanii warra cunqurfame wajjin jiraachuu wayya.<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>Namni gorsa fudhatu kam iyyuu ni milkaaʼa;</para>
  <para style="q2" vid="PRO 16:20">kan <char style="nd">Waaqayyoon</char> amanatus eebbifamaa dha.<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>Namni garaadhaan ogeessa taʼe qalbeeffataa jedhama;</para>
  <para style="q2" vid="PRO 16:21">dubbiin miʼaawu immoo gorsa dabala.<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>Hubannaan nama isa qabuuf madda jireenyaa ti;</para>
  <para style="q2" vid="PRO 16:22">gowwummaan garuu gowwootatti adabbii fida.<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>Garaan nama ogeessaa arraba isaa qajeelcha;</para>
  <para style="q2" vid="PRO 16:23">afaan isaas gorsa dabala.<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>Dubbiin nama gammachiisu dhaaba dammaa ti;</para>
  <para style="q2" vid="PRO 16:24">inni lubbuutti ni miʼaawa; lafees ni fayyisa.<verse eid="PRO 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>Karaan qajeelaa namatti fakkaatu tokko jira;</para>
  <para style="q2" vid="PRO 16:25">dhuma irratti garuu duʼatti nama geessa.<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>Fedhiin hojjetaan tokko nyaataaf qabu</para>
  <para style="q2" vid="PRO 16:26">hojiif isa kakaasa; beelaʼuun isaas ittuma cima.<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>Namni faayidaa hin qabne hammina malata;</para>
  <para style="q2" vid="PRO 16:27">haasaan isaas akkuma ibidda waa gubuu ti.<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>Namni jalʼaan lola kakaasa; hamattuun immoo</para>
  <para style="q2" vid="PRO 16:28">michoota walitti dhiʼaatan gargar baafti.<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>Namni jeequmsaan deemu ollaa isaa gowwoomsee</para>
  <para style="q2" vid="PRO 16:29">karaa jalʼaatti isa geessa.<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>Namni ija qisu jalʼina karoorfata;</para>
  <para style="q2" vid="PRO 16:30">kan hidhii ciniinnatu immoo hammina fida.<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>Arriin gonfoo ulfinaa ti;</para>
  <para style="q2" vid="PRO 16:31">innis karaa qajeelaadhaan argama.<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Goota waraanaa irra nama obsa qabu,</para>
  <para style="q2" vid="PRO 16:32">nama magaalaa tokko boojiʼee fudhatu irra kan of qabu wayya.<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>Ixaan gudeeda irratti buufama;</para>
  <para style="q2" vid="PRO 16:33">murtoon isaa garuu guutumaan guutuutti <char style="nd">Waaqayyo</char> biraa dhufa.<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Mana nyaataa dhugaatiin guutame kan lola qabuu mannaa,</para>
  <para style="q2" vid="PRO 17:1">iddoo nagaan jirutti hurraaʼaa buddeena goggogaa wayya.<verse eid="PRO 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>Garbichi hubataan ilma salphaa bulcha;</para>
  <para style="q2" vid="PRO 17:2">obboloota gidduuttis dhaala qooddata.<verse eid="PRO 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>Okkoteen waa itti baqsan meetiif, boolli ibiddaa immoo warqeef;</para>
  <para style="q2" vid="PRO 17:3">
    <char style="nd">Waaqayyo</char> garuu garaa namaa qora.<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>Namni hamaan dubbii gowwoomsaa dhaggeeffata;</para>
  <para style="q2" vid="PRO 17:4">sobaanis arraba balaʼamaadhaaf gurra kenna.<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>Namni hiyyeeyyiitti qoosu kan isaan Uume sana tuffata;</para>
  <para style="q2" vid="PRO 17:5">kan badiisa namaatti gammadu utuu hin adabamin hin hafu.<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>Nama jaare tokkoof ilmaan ilmaan isaa gonfoo dha;</para>
  <para style="q2" vid="PRO 17:6">haadhaa fi abbaanis ijoollee isaaniitiif ulfina.<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>Dubbiin baʼeessi nama gowwaatti hin tolu;</para>
  <para style="q2" vid="PRO 17:7">hidhiin sobu immoo hammam bulchaa tokkotti haa hammaatu ree!<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>Mattaʼaan namicha kennuuf miʼa falfalaa ti;</para>
  <para style="q2" vid="PRO 17:8">inni lafa dhaqu kamitti iyyuu ni milkaaʼa.<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Namni balleessaa namaaf dhiisu jaalala guddisa;</para>
  <para style="q2" vid="PRO 17:9">namni waan tokko irra deddeebiʼu, <optbreak/> garuu michoota walitti dhiʼaatan gargar baasa.<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>Hamma gowwaan yeroo dhibba garafamee itti dhagaʼamu caalaa</para>
  <para style="q2" vid="PRO 17:10">ifannaan nama waa hubatutti dhagaʼama.<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>Namni hamaan fincila qofa barbaada;</para>
  <para style="q2" vid="PRO 17:11">ergamaan namaa hin naane isatti ni ergama.<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>Gowwaa gowwummaa isa keessa jiruun</para>
  <para style="q2" vid="PRO 17:12">walitti dhufuu mannaa amaaketa dhaltuu ilmaan ishee <optbreak/> jalaa fudhatamaniin walitti dhufuu wayya.<verse eid="PRO 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>Nama qooda gaarii hamaa deebisu,</para>
  <para style="q2" vid="PRO 17:13">hamminni mana isaa keessaa hin baʼu.<verse eid="PRO 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>Lola jalqabuun akkuma bishaan cabsanii yaasuu ti;</para>
  <para style="q2" vid="PRO 17:14">kanaafuu utuu lolli hin hoʼin dubbii dhiisi.<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>
    <char style="nd">Waaqayyo</char> waan kana lachuu ni balfa;</para>
  <para style="q2" vid="PRO 17:15">kunis nama yakka qabu qulqulluu gochuu fi <optbreak/> nama balleessaa hin qabnetti muruu dha.<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>Sababii inni ogummaa argachuuf fedhii hin qabneef,</para>
  <para style="q2" vid="PRO 17:16">maallaqni harka gowwaa jiru faayidaa maalii qaba?<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>Michuun yeroo hunda nama jaallata;</para>
  <para style="q2" vid="PRO 17:17">obboleessi immoo guyyaa rakkootiif dhalata.<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>Namni qalbii hin qabne harka dhaʼee waa namaaf kakata;</para>
  <para style="q2" vid="PRO 17:18">fuula ollaa ofii isaa durattis wabii taʼa.<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>Namni lola jaallatu cubbuu jaallata;</para>
  <para style="q2" vid="PRO 17:19">namni karra ol dheeraa ijaarus badiisa waama.<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>Namni yaada hamaa qabu hin milkaaʼu;</para>
  <para style="q2" vid="PRO 17:20">kan arrabni isaa nama gowwoomsus rakkoo keessa seena.<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>Ilmi gowwaan abbaa isaatti gadda fida;</para>
  <para style="q2" vid="PRO 17:21">abbaan ilma gowwaas hin gammadu.<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>Garaan gammadu qoricha gaarii dha;</para>
  <para style="q2" vid="PRO 17:22">hafuurri cabe immoo lafee gogsa.<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>Namni hamaan karaa murtii qajeelaa jalʼisuuf jedhee</para>
  <para style="q2" vid="PRO 17:23">dhoksaadhaan mattaʼaa fudhata.<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>Namni hubataan fuula isaa gara ogummaatti deebifata;</para>
  <para style="q2" vid="PRO 17:24">iji gowwaa garuu hamma handaara lafaatti joora.<verse eid="PRO 17:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>Ilmi gowwaan abbaa isaatti gadda fida;</para>
  <para style="q2" vid="PRO 17:25">haadha isa deessettis jireenya hadheessa.<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>Nama balleessaa hin qabne tokko adabuun gaarii miti;</para>
  <para style="q2" vid="PRO 17:26">qondaaltota amanamoo rukutuunis sirrii miti.<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>Namni beekaan of qusachaa dubbata;</para>
  <para style="q2" vid="PRO 17:27">namni hubataanis hafuura qabanaaʼaa qaba.<verse eid="PRO 17:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>Gowwaan iyyuu yommuu calʼisu ogeessa fakkaata;</para>
  <para style="q2" vid="PRO 17:28">yommuu arraba isaa toʼatus hubataa fakkaata.<verse eid="PRO 17:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>Namni addaan of baasu ofittummaa duukaa buʼa;</para>
  <para style="q2" vid="PRO 18:1">murtii dhugaa hundaanis ni morma.<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>Namni gowwaan hubannaa argachuutti hin gammadu;</para>
  <para style="q2" vid="PRO 18:2">garuu yaaduma isaa ibsuutti gammada.<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>Yeroo hamminni dhufu tuffiin dhufa;</para>
  <para style="q2" vid="PRO 18:3">salphinnis qaanii wajjin dhufa.<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>Dubbiin afaan namaa bishaan gad fagoo dha;</para>
  <para style="q2" vid="PRO 18:4">burqaan ogummaa garuu bishaan yaaʼuu dha.<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>Gara nama hamaa goruun <optbreak/> yookaan nama balleessaa hin qabne</para>
  <para style="q2" vid="PRO 18:5">murtii qajeelaa dhowwachuun gaarii miti.<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>Hidhiin gowwaa lola fida;</para>
  <para style="q2" vid="PRO 18:6">afaan isaas rukutamuu itti waama.<verse eid="PRO 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>Afaan gowwaa badiisa isaa ti;</para>
  <para style="q2" vid="PRO 18:7">hidhiin isaas kiyyoo lubbuu isaa ti.<verse eid="PRO 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>Dubbiin hamattuu akkuma gurshaa miʼaawuu ti;</para>
  <para style="q2" vid="PRO 18:8">gara kutaa garaattis gad buʼa.<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>Namni hojii isaa irratti dhibaaʼu,</para>
  <para style="q2" vid="PRO 18:9">obboleessa nama waa balleessuu ti.<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>Maqaan <char style="nd">Waaqayyoo</char> gamoo jabaa dha;</para>
  <para style="q2" vid="PRO 18:10">namni qajeelaan itti baqatee badiisa oola.<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Qabeenyi sooreyyii isaaniif magaalaa daʼoo qabduu dha;</para>
  <para style="q2" vid="PRO 18:11">isaanis akka dallaa ol dheeraatti hedu.<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>Kufaatiidhaan dura garaan namaa of tuula;</para>
  <para style="q2" vid="PRO 18:12">gad of qabuun garuu ulfinaan dura dhufa.<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>Utuu hin dhaggeeffatin deebii kennuun,</para>
  <para style="q2" vid="PRO 18:13">gowwummaa fi qaanii dha.<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>Hafuurri namaa dhukkuba ni obsa;</para>
  <para style="q2" vid="PRO 18:14">hafuura cabe garuu eenyutu obsuu dandaʼa?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>Garaan nama hubataa beekumsa argata;</para>
  <para style="q2" vid="PRO 18:15">gurri ogeessaas waan kana barbaada.<verse eid="PRO 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>Kennaan abbicha kennuuf karaa bana;</para>
  <para style="q2" vid="PRO 18:16">fuula namoota gurguddaa durattis isa dhiʼeessa.<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>Hamma namni biraa dhufee isaan mormutti,</para>
  <para style="q2" vid="PRO 18:17">namni jalqabatti himata isaa dhiʼeeffatu tokko <optbreak/> dhugaa qabeessa fakkaata.<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>Ixaa buusuun wal falmii qabbaneessa;</para>
  <para style="q2" vid="PRO 18:18">namoota wal lolan jajjaboos addaan galcha.<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Obboleessa yakkame tokko deebisuun <optbreak/> magaalaa daʼoo qabdu irra ulfaata;</para>
  <para style="q2" vid="PRO 18:19">wal falmiinis akkuma danqaraa karra dallaa dhagaa ti.<verse eid="PRO 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>Ija afaan isaatiin garaan namaa quufa;</para>
  <para style="q2" vid="PRO 18:20">dubbii arraba isaatiinis ni guuta.<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>Arrabni humna jireenyaatii fi duʼaa qaba;</para>
  <para style="q2" vid="PRO 18:21">warri isa jaallatanis ija isaa nyaatu.<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>Namni niitii argatu waan gaarii argata;</para>
  <para style="q2" vid="PRO 18:22">fuula <char style="nd">Waaqayyoo</char> durattis surraa argata.<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>Hiyyeessi arraba laafaadhaan dubbata;</para>
  <para style="q2" vid="PRO 18:23">sooressi garuu sagalee jabaadhaan deebii kenna.<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>Namni michoota baayʼisu ni bada;</para>
  <para style="q2" vid="PRO 18:24">garuu michuun obboleessa caalaa namatti aanu ni jira.<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>Gowwaa daba dubbatuu mannaa</para>
  <para style="q2" vid="PRO 19:1">hiyyeessa amanamummaadhaan jiraatu wayya.<verse eid="PRO 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>Namni beekumsa hin qabne gaarii miti;</para>
  <para style="q2" vid="PRO 19:2">miilli jarjarus karaa irraa jalʼata.<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>Gowwummaan namaa karaa isaa jalʼisa;</para>
  <para style="q2" vid="PRO 19:3">garaan isaa immoo <char style="nd">Waaqayyotti</char> aara.<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>Badhaadhummaan michoota hedduu nama argachiisa;</para>
  <para style="q2" vid="PRO 19:4">hiyyeessi garuu michoota isaa irraa gargar baʼa.<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>Namni sobaan dhugaa baʼu utuu hin adabamin hin hafu;</para>
  <para style="q2" vid="PRO 19:5">namni soba odeessuus jalaa hin baʼu.<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>Namni hedduun bulchaa biratti surraa argachuu barbaada;</para>
  <para style="q2" vid="PRO 19:6">namni hundis michuu nama waa namaa kennuu ti.<verse eid="PRO 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>Obboloonni hiyyeessaa hundinuu isa jibbu;</para>
  <para style="q2" vid="PRO 19:7">yoos michoonni isaa hammam caalaa isa irraa haa fagaatan ree!</para>
  <para style="q1" vid="PRO 19:7">Inni kadhachaa isaan duukaa buʼu iyyuu</para>
  <para style="q2" vid="PRO 19:7">isaan eessattuu hin argaman.<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>Namni qalbii qabu ofii isaa jaallata;</para>
  <para style="q2" vid="PRO 19:8">namni hubannaa jaallatu ni milkaaʼa.<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>Namni sobaan dhugaa baʼu utuu hin adabamin hin hafu;</para>
  <para style="q2" vid="PRO 19:9">namni soba odeessus ni bada.<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>Jireenya qananii jiraachuun gowwaaf hin malu;</para>
  <para style="q2" vid="PRO 19:10">yoos ilmaan mootii bulchuun garbichaaf <optbreak/> hammam caalaa haa hammaatu ree?<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>Ogummaan nama tokkoo obsa kennaaf;</para>
  <para style="q2" vid="PRO 19:11">balleessaa namaa irra darbuunis isaaf ulfina.<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>Dheekkamsi mootii akkuma aaduu leencaa ti,</para>
  <para style="q2" vid="PRO 19:12">surraan isaa immoo akkuma fixeensa marga irratti.<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>Ilmi gowwaan abbaa isaatiif badiisa;</para>
  <para style="q2" vid="PRO 19:13">niitiin nyakkiftunis</para>
  <para style="q2" vid="PRO 19:13">akka mana yeroo hundumaa dhimmisuu ti.<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Manaa fi qabeenyi warra ofii irraa dhaalamu;</para>
  <para style="q2" vid="PRO 19:14">niitii qalbii qabdu garuu <char style="nd">Waaqayyotu</char> namaaf kenna.<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>Dhibaaʼummaan hirriba guddaa namatti buusa;</para>
  <para style="q2" vid="PRO 19:15">namni hojii malee taaʼus ni beelaʼa.<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>Namni ajaja eegu lubbuu isaa eeggata;</para>
  <para style="q2" vid="PRO 19:16">kan karaa isaa tuffatu immoo ni duʼa.<verse eid="PRO 19:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>Namni hiyyeessaaf garaa laafu <char style="nd">Waaqayyoof</char> liqeessa;</para>
  <para style="q2" vid="PRO 19:17">Waaqnis waan inni hojjete sanaaf isa badhaasa.<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>Yeroo abdiin jirutti ilma kee adabadhu;</para>
  <para style="q2" vid="PRO 19:18">akka inni duʼuufis calʼistee hin ilaalin.<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>Namni dafee aaru adabamuu qaba;</para>
  <para style="q2" vid="PRO 19:19">ati yoo isa oolchite, amma illee akkasuma gochuu qabda.<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>Gorsa namaa dhaggeeffadhu; sirreeffamas fudhadhu;</para>
  <para style="q2" vid="PRO 19:20">dhuma irratti ati nama ogeessa taata.<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>Garaa namaa keessa karoora baayʼeetu jira;</para>
  <para style="q2" vid="PRO 19:21">garuu wanni fiixaan baʼu kaayyoo <char style="nd">Waaqayyoo</char> ti.<verse eid="PRO 19:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>Wanni namni hawwu jaalala dhuma hin qabnee dha;</para>
  <para style="q2" vid="PRO 19:22">sobduu taʼuu mannaa hiyyeessa taʼuu wayya.<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>
    <char style="nd">Waaqayyoon</char> sodaachuun jireenyatti nama geessa;</para>
  <para style="q2" vid="PRO 19:23">yoos namni boqonnaadhaan jiraata; <optbreak/> rakkinnis isa hin argatu.<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>Dhibaaʼaan harka isaa waciitii keessa kaaʼa;</para>
  <para style="q2" vid="PRO 19:24">gara afaan isaattis hin deebifatu!<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>Qoostuu garafi; wallaalaan hubannaa argataa;</para>
  <para style="q2" vid="PRO 19:25">nama qalbii qabu ifadhu; inni beekumsa argataatii.<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>Namni abbaa isaa saamu, haadha isaas kan manaa ariʼu,</para>
  <para style="q2" vid="PRO 19:26">ilma qaanii fi salphina fiduu dha.<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>Yaa ilma ko, mee qajeelfama dhaggeeffachuu dhiisi;</para>
  <para style="q2" vid="PRO 19:27">ati dubbii beekumsaa irraa ni baddaa.<verse eid="PRO 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>Dhuga baʼaan faayidaa hin qabne murtii qajeelaa tuffata;</para>
  <para style="q2" vid="PRO 19:28">afaan hamootaa immoo hammina liqimsa.<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>Qoostotaaf adabbii,</para>
  <para style="q2" vid="PRO 19:29">dugda gowwootaatiif immoo rukuttaatu qopheeffama.<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>Daadhiin wayinii nama qoostuu, <optbreak/> dhugaatiin cimaan immoo waccuu nama godha;</para>
  <para style="q2" vid="PRO 20:1">namni isaaniin fudhatamus ogeessa miti.<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>Dheekkamsi mootii akkuma aaduu leencaa ti;</para>
  <para style="q2" vid="PRO 20:2">namni isa aarsus lubbuu ofii isaa dhaba.<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>Lola irraa fagaachuun ulfina;</para>
  <para style="q2" vid="PRO 20:3">gowwaan hundi garuu lolatti ariifata.<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>Dhibaaʼaan yeroodhaan hin qotatu;</para>
  <para style="q2" vid="PRO 20:4">kanaafuu inni yeroo haamaatti ni ilaala malee <optbreak/> homaa hin argatu.<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>Yaadni qalbii namaa akkuma bishaan gad fagoo ti;</para>
  <para style="q2" vid="PRO 20:5">hubataan namaa garuu ni waraabbata.<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>Namni hedduun akka jaalala hin dhumne qabu dubbata;</para>
  <para style="q2" vid="PRO 20:6">nama amanamaa garuu eenyutu argachuu dandaʼa?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>Namni qajeelaan amanamummaadhaan jiraata;</para>
  <para style="q2" vid="PRO 20:7">ijoolleen isaa warri booddee dhalatanis ni eebbifamu.<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>Mootiin tokko yeroo murtii kennuuf teessoo isaa irra taaʼutti,</para>
  <para style="q2" vid="PRO 20:8">waan hamaa hunda ijuma isaatiin gingilchee addaan baasa.<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>Eenyutu, “Ani garaa koo qulqulleeffadheera;</para>
  <para style="q2" vid="PRO 20:9">ani qulqulluu dha; cubbuus hin qabu” jechuu dandaʼa?<verse eid="PRO 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>Madaalii jalʼaa fi safartuu jalʼaa</para>
  <para style="q2" vid="PRO 20:10">lamaanuu <char style="nd">Waaqayyo</char> ni balfa.<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>Mucaan xinnaan iyyuu amalli isaa qulqulluu fi</para>
  <para style="q2" vid="PRO 20:11">qajeelaa taʼuun isaa hojii isaatiin beekama.<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>Gurra dhagaʼuu fi ija argu,</para>
  <para style="q2" vid="PRO 20:12">lachanuu <char style="nd">Waaqayyotu</char> uume.<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>Akka hin hiyyoomneef, hirriba hin jaallatin;</para>
  <para style="q2" vid="PRO 20:13">midhaan akka quuftuuf, dammaqii jiraadhu.<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>Namni waa bitatu, “Wanni kun gaarii miti; <optbreak/> wanni kun gaarii miti!” jedha;</para>
  <para style="q2" vid="PRO 20:14">ergasii immoo dhaqee waaʼee waan bitate sanaa boona.<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>Warqeen ni jira; lulli diimaanis baayʼinaan jira;</para>
  <para style="q2" vid="PRO 20:15">arrabni beekumsa dubbatu garuu faaya gatii guddaa ti.<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>Nama nama ormaatiif wabii taʼe irraa uffata isaa fudhadhu;</para>
  <para style="q2" vid="PRO 20:16">yoo inni dubartii ormaatiif wabii taʼes uffata sana qabdii qabadhu.<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>Nyaanni gowwoomsaadhaan argame namatti miʼaawa;</para>
  <para style="q2" vid="PRO 20:17">dhuma irratti garuu afaan nama sanaa cirrachatu guuta.<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>Gorsaan karoora baafadhu;</para>
  <para style="q2" vid="PRO 20:18">qajeelfama ogummaatiin waraana bani.<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>Hamattuun icciitii baafti;</para>
  <para style="q2" vid="PRO 20:19">kanaafuu odeessituu wajjin tokkummaa hin qabaatin.<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>Namni tokko yoo abbaa isaa yookaan haadha isaa abaare,</para>
  <para style="q2" vid="PRO 20:20">ibsaan isaa dukkana hamaa keessatti dhaama.<verse eid="PRO 20:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>Dhaalli jalqabumatti dafee argame</para>
  <para style="q2" vid="PRO 20:21">dhumni isaa eebba hin qabaatu.<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>Ati, “Yakka ati hojjette kanaaf <optbreak/> ani gatii kee siifin kenna!” hin jedhin;</para>
  <para style="q2" vid="PRO 20:22">
    <char style="nd">Waaqayyoon</char> eeggadhu; inni si baasa.<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>
    <char style="nd">Waaqayyo</char> madaalii jalʼaa ni balfa;</para>
  <para style="q2" vid="PRO 20:23">safartuu sobaattis hin gammadu.<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>Adeemsi namaa <char style="nd">Waaqayyoon</char> qajeelfama.</para>
  <para style="q2" vid="PRO 20:24">Yoos namni kam iyyuu akkamiin karaa ofii isaa hubachuu dandaʼa ree?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>Namni utuu itti hin yaadin, <optbreak/> “Wanni kun Waaqaaf qulqulleeffameera” jedhee</para>
  <para style="q2" vid="PRO 20:25">ergasii immoo waan wareege sana gaabbe kiyyoo isatti taʼa.<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>Mootiin ogeessi hamoota gingilchee addaan baasa;</para>
  <para style="q2" vid="PRO 20:26">geengoo ittiin midhaan dhaʼan illee isaan irra oofa.<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>Ibsaan <char style="nd">Waaqayyoo</char> hafuura namaa sakattaʼa;</para>
  <para style="q2" vid="PRO 20:27">inni keessa namaa illee isumaan qora.<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>Jaalallii fi amanamummaan mootii tokko nagaan jiraachisu;</para>
  <para style="q2" vid="PRO 20:28">teessoon mootummaa isaas jaalalaan eegama.<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>Ulfinni dargaggootaa jabina isaanii ti;</para>
  <para style="q2" vid="PRO 20:29">arriin mataa kabaja nama umuriin dheeratee ti.<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>Abootteen nama madeessu hammina nama irraa qulqulleessa;</para>
  <para style="q2" vid="PRO 20:30">garaffiin immoo keessa namaa geeddara.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>Yaadni mootii akkuma yaaʼaa bishaanii harka <char style="nd">Waaqayyoo</char> keessa jira;</para>
  <para style="q2" vid="PRO 21:1">innis garuma fedhetti qajeelcha.<verse eid="PRO 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>Karaan namaa hundinuu ija ofii isaa duratti qajeelaa itti fakkaata;</para>
  <para style="q2" vid="PRO 21:2">
    <char style="nd">Waaqayyo</char> garuu yaada namaa madaala.<verse eid="PRO 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>Fuula <char style="nd">Waaqayyoo</char> duratti aarsaa caalaa,</para>
  <para style="q2" vid="PRO 21:3">waan qajeelaa fi sirrii taʼe hojjechuutu fudhatama qaba.<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>Iji of jajuu fi garaan of tuuluu maasii hamootaa</para>
  <para style="q2" vid="PRO 21:4">kan hin qotaminii dha; <optbreak/> innis cubbuu dhala.<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>Karoorri nama tattaaffatuu buʼaa argamsiisa;</para>
  <para style="q2" vid="PRO 21:5">namni ariifatu garuu ni hiyyooma.<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>Qabeenyi arraba sobuun argamu,</para>
  <para style="q2" vid="PRO 21:6">urrii bittinnaaʼee baduu fi kiyyoo duʼaa ti.<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>Sababii isaan waan qajeelaa hojjechuu didaniif,</para>
  <para style="q2" vid="PRO 21:7">fincilli hamootaa isaanuma balleessa.<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>Karaan nama balleessaa qabuu jalʼaa dha;</para>
  <para style="q2" vid="PRO 21:8">amalli nama qulqulluu garuu qajeelaa dha.<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Niitii nyakkiftuu wajjin mana tokko keessa jiraachuu mannaa,</para>
  <para style="q2" vid="PRO 21:9">golee bantii manaa irra jiraachuu wayya.<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>Namni hamaan jalʼina dharraʼa;</para>
  <para style="q2" vid="PRO 21:10">ollaan isaa gara laafina tokko iyyuu isa irraa hin argatu.<verse eid="PRO 21:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>Yeroo namni qoosu tokko adabamutti, <optbreak/> wallaalaan ogummaa argata;</para>
  <para style="q2" vid="PRO 21:11">namni ogeessi yeroo gorfamutti beekumsa argata.<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>Namni qajeelaan mana hamootaa qalbeeffatee ilaala;</para>
  <para style="q2" vid="PRO 21:12">hamootas ni balleessa.<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>Namni tokko yoo iyya hiyyeessaatiif gurra kennuu dide,</para>
  <para style="q2" vid="PRO 21:13">innis ni iyya; deebiis hin argatu.<verse eid="PRO 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>Wanni dhoksaadhaan namaaf kennan aarii qabbaneessa;</para>
  <para style="q2" vid="PRO 21:14">mattaʼaan harka bobaa jalaatiin kennanis <optbreak/> dheekkamsa guddaa gab godha.<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>Murtii qajeelaa kennuun qajeeltotaaf gammachuu kenna;</para>
  <para style="q2" vid="PRO 21:15">hamootatti immoo raafama fida.<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>Namni karaa hubannaa irraa badu kam iyyuu</para>
  <para style="q2" vid="PRO 21:16">waldaa warra duʼaniitti dabalama.<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>Namni qananii jaallatu ni deega;</para>
  <para style="q2" vid="PRO 21:17">kan daadhii wayiniitii fi zayitii jaallatu immoo hin sooromu.<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>Namni hamaan nama qajeelaadhaaf,</para>
  <para style="q2" vid="PRO 21:18">kan hin amanamne immoo nama tolaadhaaf furii taʼa.<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>Niitii nyakkiftuu fi kan daftee aartu wajjin jiraachuu mannaa,</para>
  <para style="q2" vid="PRO 21:19">gammoojjii keessa jiraachuu wayya.<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>Mana nama ogeessaa keessa qabeenya gatii guddaatii fi zayitiitu jira;</para>
  <para style="q2" vid="PRO 21:20">gowwaan garuu waan qabu hunda nyaatee fixa.<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>Namni qajeelummaa fi jaalala duukaa buʼu,</para>
  <para style="q2" vid="PRO 21:21">jireenya, badhaadhummaa fi ulfina argata.<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>Namni ogeessi magaalaa nama jabaatti baʼee</para>
  <para style="q2" vid="PRO 21:22">daʼoo jabaa inni amanatu jalaa diiga.<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>Namni afaan isaatii fi arraba isaa eeggatu,</para>
  <para style="q2" vid="PRO 21:23">balaa irraa of eega.<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>Nama of jajuu fi of tuulu maqaan isaa, “Qoostuu dha;”</para>
  <para style="q2" vid="PRO 21:24">inni akka malee koora.<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>Sababii harki isaa hojii hojjechuu hin jaallanneef,</para>
  <para style="q2" vid="PRO 21:25">hawwiin nama dhibaaʼaa duʼa isatti fida.<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>Inni guyyaa guutuu kajeela;</para>
  <para style="q2" vid="PRO 21:26">namni qajeelaan garuu utuu hin qusatin kenna.<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>Aarsaan nama hamaa balfamaa dha;</para>
  <para style="q2" vid="PRO 21:27">yoos yoo inni yaada hamaadhaan dhiʼeesse <optbreak/> hammam sana caalaa haa balfamu ree!<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>Dhuga baatuun sobaa ni bada;</para>
  <para style="q2" vid="PRO 21:28">namni isa dhagaʼu kam iyyuus bara baraan bada.<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>Namni hamaan ija jabaata;</para>
  <para style="q2" vid="PRO 21:29">namni tolaan garuu karaa isaa qajeelfata.<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>Ogummaan, hubannaanii fi karoorri</para>
  <para style="q2" vid="PRO 21:30">
    <char style="nd">Waaqayyoon</char> mormee milkaaʼuu hin jiru.<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>Fardi guyyaa waraanaatiif qopheeffama;</para>
  <para style="q2" vid="PRO 21:31">moʼichi garuu kan <char style="nd">Waaqayyoo</char> ti.<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Maqaan gaariin badhaadhummaa guddaa caalaa filatamaa dha;</para>
  <para style="q2" vid="PRO 22:1">kabajamuunis meetii fi warqee caala.<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Wanni sooressaa fi hiyyeessa wal fakkeessu kanaa dha:</para>
  <para style="q2" vid="PRO 22:2">Uumaan hunda isaanii <char style="nd">Waaqayyoo</char> dha.<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>Namni hubataan balaa argee jalaa dhokata;</para>
  <para style="q2" vid="PRO 22:3">wallaalaan immoo ittuma deemee adabama.<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>Gad of qabiisnii fi <char style="nd">Waaqayyoon</char> sodaachuun,</para>
  <para style="q2" vid="PRO 22:4">qabeenya, ulfinaa fi jireenya namaa kennu.<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>Karaa hamootaa irra qoraattii fi kiyyootu jira;</para>
  <para style="q2" vid="PRO 22:5">namni lubbuu isaa eeggatu garuu <optbreak/> waan kana irraa fagaatee jiraata.<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>Daaʼima tokko karaa inni irra deemuu qabu barsiisi;</para>
  <para style="q2" vid="PRO 22:6">inni gaafa dulloome iyyuu karaa sana irraa hin jalʼatu.<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>Sooressi hiyyeessa bulcha;</para>
  <para style="q2" vid="PRO 22:7">liqeeffataan garbicha liqeessituu ti.<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>Namni hammina facaasu rakkina haammata;</para>
  <para style="q2" vid="PRO 22:8">uleen aarii isaas ni hurraaʼaa.<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>Namni arjaan waan nyaata isaa hiyyeeyyiif qooduuf</para>
  <para style="q2" vid="PRO 22:9">ofii isaatii ni eebbifama.<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>Qoostuu of biraa ariʼi; lolli ni qabbanaaʼaa;</para>
  <para style="q2" vid="PRO 22:10">wal diddaa fi arrabsoonis hin jiraatu.<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>Nama qulqullina garaa jaallatuu fi</para>
  <para style="q2" vid="PRO 22:11">dubbiin isaa namatti tolu mootiin michuu isaaf taʼa.<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>Iji <char style="nd">Waaqayyoo</char> xiyyeeffatee beekumsa ilaala;</para>
  <para style="q2" vid="PRO 22:12">inni garuu dubbii nama hin amanamnee ni busheessa.<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>Dhibaaʼaan, “Leenci ala jira!</para>
  <para style="q2" vid="PRO 22:13">Ani karaa gubbaatti nan ajjeefama!” jedha.<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>Afaan ejjituu boolla gad fagoo dha;</para>
  <para style="q2" vid="PRO 22:14">namni dheekkamsa <char style="nd">Waaqayyoo</char> jala jiru achi keessa buʼa.<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>Gowwummaan yaada daaʼimaa keessatti hidhameera;</para>
  <para style="q2" vid="PRO 22:15">uleen ittiin adaban garuu irraa fageessa.<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>Namni qabeenya isaa guddifachuuf jedhee</para>
  <para style="q2" vid="PRO 22:16">hiyyeessa hacuucuu fi kan sooressaaf kennaa kennu ni deega.<verse eid="PRO 22:16"/></para>
  <para style="ms1">Jechoota Soddomman Nama Ogeessaa</para>
  <para style="s2">Jecha tokkoffaa</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>Qalbeeffadhuutii waan namni ogeessi jedhu dhaggeeffadhu;</para>
  <para style="q2" vid="PRO 22:17">yaada kees gara waan ani barsiisuutti deebifadhu;<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>yoo ati qalbiitti qabattee <optbreak/> hunduma isaa hidhii kee irratti qopheeffatte</para>
  <para style="q2" vid="PRO 22:18">wanni kun nama gammachiisaatii.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>Akka abdiin kee <char style="nd">Waaqayyo</char> taʼuuf</para>
  <para style="q2" vid="PRO 22:19">ani harʼa suma mataa kee iyyuu nan barsiisa.<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>Ani jecha soddoma, jecha gorsaatii fi</para>
  <para style="q2" vid="PRO 22:20">beekumsaa siif hin barreessinee?<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>Kanas ani akka ati warra si erganiif</para>
  <para style="q2" vid="PRO 22:21">deebii dhugaa kennituuf waan qajeelaa fi</para>
  <para style="q2" vid="PRO 22:21">dhugaa si argisiisuufin barreesse mitii?<verse eid="PRO 22:21"/></para>
  <para style="s2">Jecha lammaffaa</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Ati sababii inni hiyyeessa taʼeef jettee hiyyeessa hin saamin;</para>
  <para style="q2" vid="PRO 22:22">rakkataas mana murtiitti hin cunqursin;<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>
    <char style="nd">Waaqayyo</char> dubbii isaanii ni ilaalaaf;</para>
  <para style="q2" vid="PRO 22:23">jireenya warra isaan saamaniis ni saamaatii.<verse eid="PRO 22:23"/></para>
  <para style="s2">Jecha sadaffaa</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>Nama dafee aaru michuu hin godhatin;</para>
  <para style="q2" vid="PRO 22:24">nama akka salphaatti dheekkamu wajjinis <optbreak/> tokkummaa hin qabaatin;<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>yoo kana goote karaa isaa baratta;</para>
  <para style="q2" vid="PRO 22:25">ofii kees kiyyootti galchita.<verse eid="PRO 22:25"/></para>
  <para style="s2">Jecha afraffaa</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>Nama harka dhaʼee waadaa galu</para>
  <para style="q2" vid="PRO 22:26">yookaan nama liqii namaatiif wabii taʼu hin taʼin;<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>yoo ati waan baaftu dhabde,</para>
  <para style="q2" vid="PRO 22:27">sireen kee iyyuu si jalaa fudhatama.<verse eid="PRO 22:27"/></para>
  <para style="s2">Jecha shanaffaa</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>Dhagaa daarii durii,</para>
  <para style="q2" vid="PRO 22:28">kan abbootiin kee dhaaban hin dhiibin.<verse eid="PRO 22:28"/></para>
  <para style="s2">Jecha jaʼaffaa</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>Nama hojii isaa keessatti ogummaa qabu argitee?</para>
  <para style="q2" vid="PRO 22:29">Inni fuula moototaa dura dhaabata;</para>
  <para style="q2" vid="PRO 22:29">fuula namoota kaanii dura garuu hin dhaabatu.<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="s2">Jecha torbaffaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>Ati yeroo waa nyaachuuf bulchaa tokko wajjin teessutti,</para>
  <para style="q2" vid="PRO 23:1">waan fuula kee dura jiru hubadhuu ilaali;<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>ati yoo nyaataaf fedhii guddaa qabaatte,</para>
  <para style="q2" vid="PRO 23:2">qoonqoo kee irra billaa kaaʼi.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>Waan nyaanni sun nama gowwoomsuuf,</para>
  <para style="q2" vid="PRO 23:3">miʼaa isaatti hin gaggabin.<verse eid="PRO 23:3"/></para>
  <para style="s2">Jecha saddeettaffaa</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Sooromuuf jettee of hin dadhabsiisin;</para>
  <para style="q2" vid="PRO 23:4">of qabuufis ogummaa qabaadhu.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>Sooromni yommuu ati ija irra buufattutti ni bada;</para>
  <para style="q2" vid="PRO 23:5">inni dhugumaan Baallee baafatee</para>
  <para style="q2" vid="PRO 23:5">akkuma risaa gara samiitti ol barrisaatii.<verse eid="PRO 23:5"/></para>
  <para style="s2">Jecha saglaffaa</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>Buddeena doqnaa hin nyaatin;</para>
  <para style="q2" vid="PRO 23:6">cidha isaas hin kajeelin;<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>inni yeroo hunda waaʼee gatii yaadaatii.</para>
  <para style="q2" vid="PRO 23:7">Inni, “Nyaadhuu dhugi” siin jedha;</para>
  <para style="q2" vid="PRO 23:7">garaan isaa garuu si wajjin hin jiru.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>Ati waanuma xinnoo nyaatte sana ni diddigda;</para>
  <para style="q2" vid="PRO 23:8">dubbii kee gaarii sana illee ni dhabda.<verse eid="PRO 23:8"/></para>
  <para style="s2">Jecha kurnaffaa</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>Sababii inni ogummaa dubbii keetii tuffatuuf</para>
  <para style="q2" vid="PRO 23:9">ati nama gowwaatti hin dubbatin.<verse eid="PRO 23:9"/></para>
  <para style="s2">Jecha kudha tokkoffaa</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>Dhagaa daangaa durii hin dhiibin</para>
  <para style="q2" vid="PRO 23:10">yookaan lafa qotiisaa ijoollee abbaa hin qabneetti hin darbin.<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>Furiin isaanii jabaadhaatii;</para>
  <para style="q2" vid="PRO 23:11">inni gara isaanii goree sitti falma.<verse eid="PRO 23:11"/></para>
  <para style="s2">Jecha kudha lammaffaa</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>Qalbii kee gara gorsaatti, gurra kee immoo</para>
  <para style="q2" vid="PRO 23:12">gara dubbii beekumsaatti deebifadhu.<verse eid="PRO 23:12"/></para>
  <para style="s2">Jecha kudha sadaffaa</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>Ijoollee kee adabachuu hin dhiisin;</para>
  <para style="q2" vid="PRO 23:13">yoo ati arcummeedhaan adabde isaan hin duʼan.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>Arcummeedhaan isaan adabiitii</para>
  <para style="q2" vid="PRO 23:14">lubbuu isaanii duʼa oolchi.<verse eid="PRO 23:14"/></para>
  <para style="s2">Jecha kudha afraffaa</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>Yaa ilma ko, yoo garaan kee ogeessa taʼe,</para>
  <para style="q2" vid="PRO 23:15">garaan koo ni gammada;<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>yoo arrabni kee waan qajeelaa dubbate,</para>
  <para style="q2" vid="PRO 23:16">keessi koo baayʼee gammada.<verse eid="PRO 23:16"/></para>
  <para style="s2">Jecha kudha shanaffaa</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>Garaan kee cubbamootatti hin hinaafin;</para>
  <para style="q2" vid="PRO 23:17">garuu yeroo hunda <char style="nd">Waaqayyoon</char> sodaadhu.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>Ati dhugumaan gara fuulduraatti abdii qabda;</para>
  <para style="q2" vid="PRO 23:18">abdiin kees hin citu.<verse eid="PRO 23:18"/></para>
  <para style="s2">Jecha kudha jaʼaffaa</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>Yaa ilma ko, dhaggeeffadhu; ogeessa taʼi;</para>
  <para style="q2" vid="PRO 23:19">qalbii kee daandii qajeelaa irra buufadhu.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>Warra daadhii wayinii baayʼee dhuganitti</para>
  <para style="q2" vid="PRO 23:20">yookaan warra foonitti gaggabanitti hin makamin;<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>machooftuu fi albaadheyyiin ni hiyyoomu;</para>
  <para style="q2" vid="PRO 23:21">hirriba baayʼisuunis moofaa nama uffachiisa.<verse eid="PRO 23:21"/></para>
  <para style="s2">Jecha kudha torbaffaa</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>Abbaa kee kan si dhalche dhagaʼi;</para>
  <para style="q2" vid="PRO 23:22">haadha kees yeroo isheen jaartu hin tuffatin.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>Dhugaa bitadhu malee hin gurgurin;</para>
  <para style="q2" vid="PRO 23:23">ogummaa, qajeelfamaa fi hubannaas bitadhu.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>Abbaan nama qajeelaa gammachuu guddaa qaba;</para>
  <para style="q2" vid="PRO 23:24">namni ilma ogeessa qabu isatti gammada.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>Abbaan keetii fi haati kee haa gammadan;</para>
  <para style="q2" vid="PRO 23:25">isheen si deesse sun haa ililchitu!<verse eid="PRO 23:25"/></para>
  <para style="s2">Jecha kudha saddeettaffaa</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>Yaa ilma ko, garaa kee naa kenni;</para>
  <para style="q2" vid="PRO 23:26">iji kees karaa koo haa ilaalu;<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>sagaagaltuun boolla gad fagoodhaatii,</para>
  <para style="q2" vid="PRO 23:27">niitiin ganda labeenis boolla bishaanii dhiphaa dha.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>Isheen akkuma saamtuutti riphxee nama eeggatti;</para>
  <para style="q2" vid="PRO 23:28">namoota gidduuttis warra hin amanamne baayʼifti.<verse eid="PRO 23:28"/></para>
  <para style="s2">Jecha kudha saglaffaa</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>Eenyutu, “Anaaf wayyoo!” jedha? Eenyutu gadda qaba?</para>
  <para style="q2" vid="PRO 23:29">Eenyutu lola qaba? Eenyutu komii qaba?</para>
  <para style="q2" vid="PRO 23:29">Eenyutu sababii malee madaaʼa? Kan iji isaa diimatu eenyu?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>Warra daadhii wayinii dhuguu irra akka malee turan,</para>
  <para style="q2" vid="PRO 23:30">warra daadhii wayinii walmakaa afaaniin qabuu dhaqanii dha.<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>Yeroo inni diimatutti, yeroo inni billillee keessa ol xixinniqutti,</para>
  <para style="q2" vid="PRO 23:31">yeroo inni suuta jedhee gad buʼutti</para>
  <para style="q2" vid="PRO 23:31">daadhii wayinii ija itti qabdee hin ilaalin.<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>Dhuma irratti akkuma bofaa nama idda;</para>
  <para style="q2" vid="PRO 23:32">akkuma buutiis nama ciniina.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>Iji kee waan haaraa arga;</para>
  <para style="q2" vid="PRO 23:33">qalbiin kees jalʼina yaada.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>Ati akkuma nama walakkaa galaana guddaa ciisuu ti;</para>
  <para style="q2" vid="PRO 23:34">akkuma nama fiixee utubaa doonii irra ciisuu taata.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>Ati akkana jetta; “Isaan na dhaʼan;</para>
  <para style="q2" vid="PRO 23:35">ani garuu hin miidhamne!</para>
  <para style="q1" vid="PRO 23:35">Isaan na tuman; garuu natti hin dhagaʼamne!</para>
  <para style="q2" vid="PRO 23:35">Ani dhugaatii biraa barbaaddachuuf yooman dammaqa?”<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="s2">Jecha digdammaffaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>Hamootatti hin hinaafin;</para>
  <para style="q2" vid="PRO 24:1">garee isaanii taʼuus hin hawwin;<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>garaan isaanii hammina malataatii;</para>
  <para style="q2" vid="PRO 24:2">hidhiin isaaniis rakkina odeessa.<verse eid="PRO 24:2"/></para>
  <para style="s2">Jecha digdamii tokkoffaa</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>Manni ogummaadhaan ijaarama;</para>
  <para style="q2" vid="PRO 24:3">hubannaadhaanis jabeeffamee dhaabama;<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>kutaawwan isaas, beekumsaan, qabeenya gatii guddaatii fi</para>
  <para style="q2" vid="PRO 24:4">miidhagaadhaan guutamu.<verse eid="PRO 24:4"/></para>
  <para style="s2">Jecha digdamii lammaffaa</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>Ogeessi humna guddaa qaba;</para>
  <para style="q2" vid="PRO 24:5">beekaan namaa immoo jabina itti dabalata;<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>waraana banuuf qajeelfama,</para>
  <para style="q2" vid="PRO 24:6">moʼannaa argachuudhaaf immoo gorsitoota hedduu si barbaachisa.<verse eid="PRO 24:6"/></para>
  <para style="s2">Jecha digdamii sadaffaa</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>Gowwaa irraa ogummaan akka malee ol fagoo dha;</para>
  <para style="q2" vid="PRO 24:7">inni karra duratti afaan isaa hin saaqqatu.<verse eid="PRO 24:7"/></para>
  <para style="s2">Jecha digdamii afraffaa</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>Namni hammina malu,</para>
  <para style="q2" vid="PRO 24:8">“Maltee” jedhama.<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>Malli gowwummaa cubbuu dha;</para>
  <para style="q2" vid="PRO 24:9">namoonnis qoostuu ni balfu.<verse eid="PRO 24:9"/></para>
  <para style="s2">Jecha digdamii shanaffaa</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>Ati yoo gaafa rakkinaa laafte,</para>
  <para style="q2" vid="PRO 24:10">jabinni kee dhugumaanuu xinnaa dha!<verse eid="PRO 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>Warra gara duʼaatti geeffamaa jiran duʼa jalaa baasi;</para>
  <para style="q2" vid="PRO 24:11">warra ajjeefamuuf qopheeffamanis oolchi.<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>Yoo ati, “Nu waan kana homaa hin beekne” jette,</para>
  <para style="q2" vid="PRO 24:12">inni yaada namaa madaalu sun hin hubatuu?</para>
  <para style="q1" vid="PRO 24:12">Kan lubbuu kee eegu sun waan kana hin beekuu?</para>
  <para style="q2" vid="PRO 24:12">Inni nama hundaaf akkuma hojii isaatti gatii hin kennuu?<verse eid="PRO 24:12"/></para>
  <para style="s2">Jecha digdamii jaʼaffaa</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>Yaa ilma ko, dammi waan gaarii taʼeef nyaadhu;</para>
  <para style="q2" vid="PRO 24:13">nadhiin dammaa sitti ni miʼaawa.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>Akka ogummaan lubbuu keetti miʼaawu illee beeki;</para>
  <para style="q2" vid="PRO 24:14">ati yoo isa argatte fuul duratti abdii qabda;</para>
  <para style="q2" vid="PRO 24:14">abdiin kees hin citu.<verse eid="PRO 24:14"/></para>
  <para style="s2">Jecha digdamii torbaffaa</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>Akka nama seeraan hin bulleetti mana nama qajeelaa <optbreak/> riphxee hin eeggatin;</para>
  <para style="q2" vid="PRO 24:15">mana jireenya isaas hin saamin.<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>Namni qajeelaan yeroo torba kufu iyyuu, deebiʼee ni kaʼaatii;</para>
  <para style="q2" vid="PRO 24:16">namni hamaan garuu yeroo balaan itti dhufutti ni gufata.<verse eid="PRO 24:16"/></para>
  <para style="s2">Jecha digdamii saddeettaffaa</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>Yeroo diinni kee kufutti hin ililchin;</para>
  <para style="q2" vid="PRO 24:17">yeroo inni gufatuttis garaan kee hin gammadin;<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>yoo kanaa achii <char style="nd">Waaqayyo</char> waan kanatti ni gaddaatii;</para>
  <para style="q2" vid="PRO 24:18">dheekkamsa isaas isa irraa deebisa.<verse eid="PRO 24:18"/></para>
  <para style="s2">Jecha digdamii saglaffaa</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>Ati sababii jalʼootaatiif aariidhaan hin gubatin;</para>
  <para style="q2" vid="PRO 24:19">hamootattis hin hinaafin.<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>Namni jalʼaan fuul duratti abdii hin qabuutii;</para>
  <para style="q2" vid="PRO 24:20">ibsaan hamootaas ni dhaama.<verse eid="PRO 24:20"/></para>
  <para style="s2">Jecha soddommaffaa</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>Yaa ilma ko, <char style="nd">Waaqayyoo</char> fi mootii sodaadhu;</para>
  <para style="q2" vid="PRO 24:21">finciltootattis hin makamin;<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>badiisni akkuma tasaa isaanitti dhufaatii;</para>
  <para style="q2" vid="PRO 24:22">balaa isaan lachuu fidan eenyutu beeka?<verse eid="PRO 24:22"/></para>
  <para style="ms1">Jecha Ogeessaa Kan Itti Fufe</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>Kunneenis jechoota ogeessaa ti:</para>
  <para style="q1" vid="PRO 24:23">Murtii kennuu irratti nama wal caalchisuun gaarii miti:<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>Kan nama yakka qabuun, “Ati balleessaa hin qabdu”</para>
  <para style="q2" vid="PRO 24:24">jedhu kam iyyuu namni isa abaara; sabnis isa balaaleffata.<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>Warri nama yakka hojjetu ifatan garuu ni gammadu;</para>
  <para style="q2" vid="PRO 24:25">eebbi guddaanis ni dhufaaf.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>Deebiin qajeelaan,</para>
  <para style="q2" vid="PRO 24:26">akkuma hidhii dhungachuu ti.<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>Hojii kee kan diidaa raawwadhuutii</para>
  <para style="q2" vid="PRO 24:27">lafa qotiisaa kees qopheeffadhu;</para>
  <para style="q2" vid="PRO 24:27">ergasii mana kee ijaarradhu.<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>Sababii tokko malee ollaa keetti dhugaa hin baʼin</para>
  <para style="q2" vid="PRO 24:28">yookaan hidhii keetiin hin gowwoomsin.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>Ati, “Waanuma inni na godhe anis isa nan godha;</para>
  <para style="q2" vid="PRO 24:29">waan inni hojjeteefis gatii isaa nan deebisa” hin jedhin.<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Ani lafa qotiisaa nama dhibaaʼaa keessa baʼee,</para>
  <para style="q2" vid="PRO 24:30">iddoo dhaabaa wayinii nama qalbii hin qabnee keessas darbe;<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>qoraattiin lafa hunda guuteera;</para>
  <para style="q2" vid="PRO 24:31">laftis aramaadhaan fudhatameera;</para>
  <para style="q2" vid="PRO 24:31">dallaan dhagaas diigameera.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Ani argeen waan sana qalbeeffadhe;</para>
  <para style="q2" vid="PRO 24:32">waanan arge sana irraas barumsa nan argadhe:<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>hirriba xinnaa; mugaatii xinnaa;</para>
  <para style="q2" vid="PRO 24:33">xinnoo harka walitti marachuu;<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>hiyyummaanis akkuma hattuutti,</para>
  <para style="q2" vid="PRO 24:34">deegummaanis akkuma loltuu hidhateetti sitti dhufa.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="ms1">Fakkeenya Solomoon Dabalataa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>Fakkeenyawwan kunneen fakkeenyawwan Solomoon kanneen namoonni Hisqiyaas, mooticha Yihuudaa garagalchanii dha:<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>Waa dhoksuun Waaqaaf ulfina isaa ti;</para>
  <para style="q2" vid="PRO 25:2">waa sakattaʼanii bira gaʼuun immoo ulfina moototaa ti.<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>Akkuma samiiwwan ol dheeratanii</para>
  <para style="q2" vid="PRO 25:3">laftis gad fagaatu sana, yaadni moototaa qoratamee bira hin gaʼamu.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>Meetii irraa xurii baasi;</para>
  <para style="q2" vid="PRO 25:4">ergasii tumtuun qodaa tolchuu dandaʼa.<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>Nama hamaa fuula mootii duraa balleessi;</para>
  <para style="q2" vid="PRO 25:5">ergasii teessoon isaa qajeelummaadhaan ni jabaata.<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>Fuula mootii duratti ol of hin qabin;</para>
  <para style="q2" vid="PRO 25:6">iddoo namoota gurguddaas hin dhaabatin;<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>inni fuula namoota bebeekamoo duratti si salphisuu irra,</para>
  <para style="q2" vid="PRO 25:7">yoo inni, “As ol kottu” siin jedhe wayyaa.</para>
  <para style="b" vid="PRO 25:7"/>
  <para style="q1" vid="PRO 25:7">Ati waan ija keetiin argite,<verse eid="PRO 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8"/>daftee mana murtiitti hin fidin;</para>
  <para style="q1" vid="PRO 25:8">yoo ollaan kee si qaanesse,</para>
  <para style="q2" vid="PRO 25:8">dhuma irratti ati maal gochuu dandeessa?<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>Dhimma kee ollaa kee wajjin falmadhu;</para>
  <para style="q2" vid="PRO 25:9">iccitii nama kaanii immoo hin baasin;<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>yoo kanaa achii namni waan sana dhagaʼee si qaanessa;</para>
  <para style="q2" vid="PRO 25:10">maqaan hamaan siif kenname sunis sirraa hin baʼu.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Dubbiin yeroo isaatti dubbatame,</para>
  <para style="q2" vid="PRO 25:11">akkuma hudhaa warqee kan meetii irratti hojjetamee ti.<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>Ifanni nama ogeessaa gurra dhaggeeffatuuf,</para>
  <para style="q2" vid="PRO 25:12">lootii warqee yookaan faaya warqee qulqulluu ti.<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>Ergamaan amanamaan tokko warra isa ergataniif</para>
  <para style="q2" vid="PRO 25:13">akkuma qabbana cabbii kan yeroo midhaan haamanii ti;</para>
  <para style="q2" vid="PRO 25:13">inni hafuura gooftota isaa haaromsaatii.<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>Namni kennaa namaaf hin kennineen boonu tokko</para>
  <para style="q2" vid="PRO 25:14">akkuma duumessaa fi bubbee bokkaa hin qabnee ti.<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Obsaan bulchaa tokko garaa laafifachuun ni dandaʼama;</para>
  <para style="q2" vid="PRO 25:15">dubbiin malaan dubbatame lafee ni cabsa.<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>Damma yoo argatte hamma si gaʼu nyaadhu;</para>
  <para style="q2" vid="PRO 25:16">yoo baayʼiftee nyaatte ni diddigda.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>Mana ollaa keetii dhaquu hin baayʼisin;</para>
  <para style="q2" vid="PRO 25:17">yoo ati miilla itti baayʼifte inni si jibba.<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>Namni sobaan ollaa isaatti dhugaa baʼu, akkuma bokkuu yookaan</para>
  <para style="q2" vid="PRO 25:18">goraadee yookaan xiyya qara qabuu ti.<verse eid="PRO 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Nama hin amanamne tokko yeroo rakkootti abdachuun</para>
  <para style="q2" vid="PRO 25:19">akkuma ilkaan cabee yookaan miilla okkoluu ti.<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>Nama garaan isaa gaddeef sirba sirbuun</para>
  <para style="q2" vid="PRO 25:20">akkuma nama guyyaa dhaamochaa wayyaa of irraa baasuu,</para>
  <para style="q2" vid="PRO 25:20">yookaan madaa irratti dhangaggaaʼaa dhangalaasuu ti.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>Yoo diinni kee beelaʼe waan inni nyaatu kenniif;</para>
  <para style="q2" vid="PRO 25:21">yoo inni dheebotes bishaan inni dhugu kenniif.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>Kana gochuu keetiin barbadaa ibiddaa mataa isaa irra tuulta;</para>
  <para style="q2" vid="PRO 25:22">
    <char style="nd">Waaqayyos</char> si badhaasa.<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>Akkuma bubbeen kaabaa bokkaa fidu,</para>
  <para style="q2" vid="PRO 25:23">arrabni hamatus fuula dheekkamu fida.<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>Niitii nyakkiftuu wajjin mana tokko keessa jiraachuu mannaa,</para>
  <para style="q2" vid="PRO 25:24">golee bantii manaa irra jiraachuu wayya.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>Oduun gaariin biyya fagootii dhufu,</para>
  <para style="q2" vid="PRO 25:25">akkuma bishaan qabbanaaʼaa lubbuu dheebotteef taʼuu ti.<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>Namni qajeelaan fuula hamootaa duratti kufu,</para>
  <para style="q2" vid="PRO 25:26">akkuma burqaa dhoqqaaʼee yookaan boolla bishaanii faalame tokkoo ti.<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>Damma baayʼee nyaachuun gaarii miti;</para>
  <para style="q2" vid="PRO 25:27">ulfina mataa ofii barbaaduunis ulfina miti.<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Namni of hin qabne,</para>
  <para style="q2" vid="PRO 25:28">akkuma magaalaa dallaan isaa diigamee ti.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>Akkuma cabbii yeroo bonaa yookaan bokkaa yeroo haamaa,</para>
  <para style="q2" vid="PRO 26:1">nama gowwaaf ulfinni hin malu.<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>Akkuma simbirri barriftu yookaan daaloteen barriftu</para>
  <para style="q2" vid="PRO 26:2">abaarsi sababii malee dhufu nama irra hin buʼu.<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>Alangaan fardaaf, luugamni harreef,</para>
  <para style="q2" vid="PRO 26:3">uleen immoo dugda gowwaatiif mala!<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>Gowwaadhaaf akka gowwummaa isaatti hin deebisin;</para>
  <para style="q2" vid="PRO 26:4">yoo akkas goote ati mataan kee iyyuu akkuma isaa taata.<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>Gowwaadhaaf deebii gowwummaa isaatiif malu kenni;</para>
  <para style="q2" vid="PRO 26:5">yoo kanaa achii inni ogeessa of seʼaa.<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>Harka nama gowwaatti ergaa ergachuun,</para>
  <para style="q2" vid="PRO 26:6">akkuma miilla ofii irraa muruu yookaan summii dhuguu ti.<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>Afaan nama gowwaa keessatti,</para>
  <para style="q2" vid="PRO 26:7">fakkeenyi akkuma miilla naafaa ti.<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>Namni gowwaadhaaf ulfina kennu,</para>
  <para style="q2" vid="PRO 26:8">akkuma nama furrisaatti dhagaa guduunfuu ti.<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>Fakkeenyi afaan gowwaa keessatti</para>
  <para style="q2" vid="PRO 26:9">akkuma qoraattii harka nama machaaʼee keessaa ti.<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>Namni gowwaa yookaan kara deemaa qaxaratu</para>
  <para style="q2" vid="PRO 26:10">akkuma adamsaa nama hunda xiyyaan madeessuu ti.<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>Akkuma sareen diddiga isheetti deebitu sana,</para>
  <para style="q2" vid="PRO 26:11">gowwaan gowwummaa isaa irra deddeebiʼa.<verse eid="PRO 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>Ati nama akka ilaalcha ofii isaatti ogeessa taʼe argitaa?</para>
  <para style="q2" vid="PRO 26:12">Isa irra gowwaatu abdii caalu qaba.<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>Dhibaaʼaan, “Leenci karaa irra jira;</para>
  <para style="q2" vid="PRO 26:13">leenci sodaachisaan daandii irra jira!” jedha.<verse eid="PRO 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>Akkuma saanqaan muchoo isaa irra naannaʼu,</para>
  <para style="q2" vid="PRO 26:14">dhibaaʼaan siree ofii irra gaggaragala<verse eid="PRO 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>Dhibaaʼaan harka isaa waciitii keessa kaaʼa;</para>
  <para style="q2" vid="PRO 26:15">gara afaan isaatti deebifachuuf ni dhibaaʼa.<verse eid="PRO 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>Dhibaaʼaan namoota hubannaadhaan</para>
  <para style="q2" vid="PRO 26:16">deebii kennan torba caalaa ogeessa of seʼa.<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>Namni lola nama biraa keessa seenu,</para>
  <para style="q2" vid="PRO 26:17">akkuma nama harkaan gurra saree qabuu ti.<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>Akkuma maraatuu ibidda yookaan xiyya</para>
  <para style="q2" vid="PRO 26:18">namatti gad dhiisu tokkoo<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>namni, “Ani nan qoose!” jedhee</para>
  <para style="q2" vid="PRO 26:19">ollaa isaa gowwoomsus akkasuma.<verse eid="PRO 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>Ibiddi yoo qoraan dhabe ni dhaama;</para>
  <para style="q2" vid="PRO 26:20">hamiin yoo hin jiraanne, lolli ni qabbanaaʼa.<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>Akkuma cileen barbadaa ibiddaa bobeessee <optbreak/> qoraan ibidda qabsiisu sana</para>
  <para style="q2" vid="PRO 26:21">namni lola jaallatu lola kakaasa.<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>Dubbiin hamattuu akkuma gurshaa miʼaawuu ti;</para>
  <para style="q2" vid="PRO 26:22">gara kutaa garaattis gad buʼa.<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>Dubbiin gaariin garaa hamaa keessaa baʼu</para>
  <para style="q2" vid="PRO 26:23">akkuma okkotee meetiin irra dibamee ti.<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>Namni maqaa namaa balleessu tokko <optbreak/> arrabuma ofiitiin nama tolaa of fakkeessa;</para>
  <para style="q2" vid="PRO 26:24">garaa isaa keessatti immoo gowwoomsaa guduunfata.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>Yoo dubbiin isaa sitti miʼaawe iyyuu isa hin amanin;</para>
  <para style="q2" vid="PRO 26:25">wanni jibbisiisaan torba garaa isaa guuteeraatii.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>Jalʼinni isaa sobaan haguugamee dhokfamuu dandaʼa;</para>
  <para style="q2" vid="PRO 26:26">hamminni isaa garuu fuula waldaa duratti ifatti baʼa.<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>Namni boolla qotu boolla keessa buʼa;</para>
  <para style="q2" vid="PRO 26:27">nama dhagaa gangalchus, <optbreak/> dhagaan sun isumatti deebiʼa.<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>Arrabni sobu tokko warruma miidhu sana jibba;</para>
  <para style="q2" vid="PRO 26:28">afaan saadu tokkos badiisa fida.<verse eid="PRO 26:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>Ati waaʼee boriitiin hin boonin;</para>
  <para style="q2" vid="PRO 27:1">waan guyyaan fidu hin beektuutii.<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>Namni biraa si haa jaju malee ati afaan keetiin of hin jajin;</para>
  <para style="q2" vid="PRO 27:2">namni kaan si haa jajuu malee hidhiin kee si hin jajin.<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>Dhagaan ni ulfaata; cirrachis baʼaa dha;</para>
  <para style="q2" vid="PRO 27:3">tuttuqaan gowwaa garuu lachuu caalaa ulfaata.<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>Dheekkamsi gara jabeessa; aariinis guutee dhangalaʼa;</para>
  <para style="q2" vid="PRO 27:4">hinaaffaa dura garuu eenyutu dhaabachuu dandaʼa?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>Jaalala dhokfamee mannaa</para>
  <para style="q2" vid="PRO 27:5">ifannaa ifatti baʼe wayya.<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Madaan michuun nama madeessu amanamaa dha;</para>
  <para style="q2" vid="PRO 27:6">dhungachuun diinaa garuu gowwoomsaa dha.<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>Namni quufe damma illee ni balfa;</para>
  <para style="q2" vid="PRO 27:7">kan beelaʼe garuu wanni hadhaaʼu iyyuu itti miʼaawa.<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>Namni mana isaatii badu tokko,</para>
  <para style="q2" vid="PRO 27:8">akkuma simbirroo manʼee isheetii badduu ti.<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>Shittoo fi ixaanni garaa nama gammachiisu;</para>
  <para style="q2" vid="PRO 27:9">gorsi michuus garaa nama ciibsa.<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>Michoota keetii fi michoota abbaa keetii hin gatin;</para>
  <para style="q2" vid="PRO 27:10">yoo balaan sitti dhufe mana obboleessa keetii hin dhaqin;</para>
  <para style="q2" vid="PRO 27:10">obboleessa fagoo jiru irra ollaa dhiʼoo jiru wayya.<verse eid="PRO 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>Yaa ilma ko, ogeessa taʼiitii garaa koo gammachiisi;</para>
  <para style="q2" vid="PRO 27:11">ergasii ani nama na tuffatu hundaaf <optbreak/> deebii kennuu nan dandaʼa.<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>Namni hubataan balaa argee jalaa dhokata;</para>
  <para style="q2" vid="PRO 27:12">wallaalaan immoo ittuma deemee adabama.<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>Nama nama ormaatiif wabii taʼe irraa uffata isaa fudhadhu;</para>
  <para style="q2" vid="PRO 27:13">yoo inni dubartii ormaatiif wabii taʼes uffata sana qabdii qabadhu.<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>Namni tokko ganamaan sagalee ol fudhatee <optbreak/> ollaa isaa yoo eebbise</para>
  <para style="q2" vid="PRO 27:14">wanni sun akka abaarsaatti fudhatama.<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>Niitiin nyakkiftuun, akkuma bokkaa guyyaa roobaa</para>
  <para style="q2" vid="PRO 27:15">dhimmisaa ooluu ti;<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>ishee ittisuun akkuma bubbee ittisuu ti</para>
  <para style="q2" vid="PRO 27:16">yookaan akkuma zayitii harkaan qabuu ti.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>Akkuma sibiilli sibiila qaru,</para>
  <para style="q2" vid="PRO 27:17">namni tokko nama kaan qara.<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>Namni muka harbuu eeggatu tokko ija isaa nyaata;</para>
  <para style="q2" vid="PRO 27:18">namni gooftaa isaa eeggatus ulfina argata.<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>Akkuma bishaan fuula namaa argisiisu sana</para>
  <para style="q2" vid="PRO 27:19">garaan nama tokkoo eenyummaa namichaa argisiisa.<verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>Duʼaa fi Badiisni gonkumaa hin quufan;</para>
  <para style="q2" vid="PRO 27:20">iji namaas akkasuma.<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>Okkoteen waa itti baqsan meetiif;</para>
  <para style="q2" vid="PRO 27:21">boolli ibiddaa immoo warqeef;</para>
  <para style="q2" vid="PRO 27:21">namni immoo ulfina argatuun qorama.<verse eid="PRO 27:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>Gowwaa mooyyee keessatti yoo tumte iyyuu,</para>
  <para style="q2" vid="PRO 27:22">akkuma midhaaniitti muka mooyyeetiin isa bulleessite iyyuu,</para>
  <para style="q2" vid="PRO 27:22">ati gowwummaa isa irraa hin balleessitu.<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>Haala bushaayeen kee keessa jiran sirriitti beeki;</para>
  <para style="q2" vid="PRO 27:23">loon keetiifis xiyyeeffannaa kenni;<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>soorumni bara baraan itti hin fufuutii;</para>
  <para style="q2" vid="PRO 27:24">gonfoonis dhaloota irraa dhalootatti hin darbu.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>Yeroo okaan haamamee biqilaa haaraan jalaan biqilee</para>
  <para style="q2" vid="PRO 27:25">margi tulluu irraa walitti qabamutti,<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>xobbaallaawwaniin daara baata;</para>
  <para style="q2" vid="PRO 27:26">reʼoonni immoo gatii lafa qotiisaa siif taʼu.<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>Ati ofii keetii fi maatii kee, <optbreak/> xomboreewwan kees ittiin jiraachisuuf</para>
  <para style="q2" vid="PRO 27:27">aannan reʼootaa baayʼee ni qabaatta.<verse eid="PRO 27:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>Namni hamaan utuu namni tokko iyyuu isa hin ariʼin baqata;</para>
  <para style="q2" vid="PRO 28:1">qajeeltonni garuu akkuma leencaa ija jabaatu.<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>Biyya fincilu keessa bulchitoota hedduutu jira;</para>
  <para style="q2" vid="PRO 28:2">bulchaan hubataanii fi beekaan garuu seera eegsisa.<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>Bulchaan hiyyeessa hacuucu tokko</para>
  <para style="q2" vid="PRO 28:3">akkuma bokkaa jabaa midhaan lafa irraa balleessuu ti.<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>Warri seera didan hamoota jaju;</para>
  <para style="q2" vid="PRO 28:4">warri seera eegan garuu isaaniin mormu.<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>Jalʼoonni murtii qajeelaa hin hubatan;</para>
  <para style="q2" vid="PRO 28:5">warri <char style="nd">Waaqayyoon</char> barbaadan immoo <optbreak/> guutumaan guutuutti hubatu.<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>Sooressa karaan isaa jalʼaa taʼe mannaa</para>
  <para style="q2" vid="PRO 28:6">hiyyeessa adeemsi isaa mudaa hin qabne wayya.<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>Namni seera eegu ilma ogeessa;</para>
  <para style="q2" vid="PRO 28:7">michuun albaadhessaa immoo abbaa isaa qaanessa.<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>Namni dhalaa fi hiiqiidhaan qabeenya isaa guddifatu kam iyyuu,</para>
  <para style="q2" vid="PRO 28:8">nama hiyyeessaaf garaa laafuuf walitti qaba.<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>Nama seeraaf gurra kennuu didu kam iyyuu,</para>
  <para style="q2" vid="PRO 28:9">kadhannaan isaa balfamaa dha.<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>Namni nama tolaa karaa jalʼaa irra adeemsisu kam iyyuu</para>
  <para style="q2" vid="PRO 28:10">kiyyoo ofii isaa keessa seena;</para>
  <para style="q2" vid="PRO 28:10">namni balleessaa hin qabne garuu dhaala gaarii argata.<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>Namni sooressi ogeessa of seʼa;</para>
  <para style="q2" vid="PRO 28:11">hiyyeessi hubannaa qabu garuu isa qoree bira gaʼa.<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>Yeroo namni qajeelaan moʼatutti gammachuu guddaatu taʼa;</para>
  <para style="q2" vid="PRO 28:12">yeroo namni hamaan aangoo qabatutti garuu <optbreak/> namoonni ni dhokatu.<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>Namni cubbuu ofii dhokfatu hin milkaaʼu;</para>
  <para style="q2" vid="PRO 28:13">kan cubbuu isaa himatee irraa deebiʼu garuu araara argata.<verse eid="PRO 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>Namni yeroo hunda <char style="nd">Waaqayyoon</char> sodaatu eebbifamaa dha;</para>
  <para style="q2" vid="PRO 28:14">kan mataa jabaatu garuu rakkoo keessatti kufa.<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>Namni hamaan hiyyeeyyii bulchu,</para>
  <para style="q2" vid="PRO 28:15">akkuma leenca aaduu yookaan amaaketa wayitti ariifatuu ti.<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>Bulchaan akka malee nama cunqursu hubannaa hin qabu;</para>
  <para style="q2" vid="PRO 28:16">kan buʼaa karaa hin malleen argamu jibbu garuu bara dheeraa jiraata.<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>Namni yakki dhiiga namaa dhangalaasuu isa irra jiru,</para>
  <para style="q2" vid="PRO 28:17">boollatti baqata;</para>
  <para style="q2" vid="PRO 28:17">namni tokko iyyuu isa hin gargaarin.<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>Namni adeemsi isaa mudaa hin qabne nagumaan jiraata;</para>
  <para style="q2" vid="PRO 28:18">kan karaan isaa jalʼaa taʼe garuu boollatti kufa.<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>Namni lafa isaa qotatu nyaata guddaa argata;</para>
  <para style="q2" vid="PRO 28:19">kan yaada faayidaa hin qabne duukaa buʼu garuu <optbreak/> hiyyumaan guutama.<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>Namni amanamaan eebba quufa;</para>
  <para style="q2" vid="PRO 28:20">kan sooromuutti gaggabu garuu adabbii jalaa hin baʼu.<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>Nama wal caalchisuun gaarii miti;</para>
  <para style="q2" vid="PRO 28:21">namni garuu muraa buddeenaa argachuuf jedhee yakka hojjeta.<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>Namni waa kajeelu sooromuuf jarjara;</para>
  <para style="q2" vid="PRO 28:22">inni akka hiyyummaan isa eeggatu hin beeku.<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>Namni nama ifatu dhuma irratti</para>
  <para style="q2" vid="PRO 28:23">nama arrabaan nama saadu caalaa surraa argata.<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>Namni abbaa yookaan haadha isaa saamee,</para>
  <para style="q2" vid="PRO 28:24">“Kun balleessaa miti” jedhu</para>
  <para style="q2" vid="PRO 28:24">garee nama waa balleessuu ti.<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>Namni wayitti gaggabu lola kakaasa;</para>
  <para style="q2" vid="PRO 28:25">kan <char style="nd">Waaqayyoon</char> amanatu garuu ni badhaadha.<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>Namni of amanatu gowwaa dha;</para>
  <para style="q2" vid="PRO 28:26">kan ogummaadhaan deemu immoo nagaadhaan jiraata.<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>Namni hiyyeessaaf kennu waan tokko illee hin dhabu;</para>
  <para style="q2" vid="PRO 28:27">kan ija dunuunfatu garuu abaarsa baayʼee argata.<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>Yeroo namni hamaan aangoo qabatutti <optbreak/> namoonni ni dhokatu;</para>
  <para style="q2" vid="PRO 28:28">yeroo namni hamaan badutti garuu qajeeltonni ni baayʼatu.<verse eid="PRO 28:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>Namni ifannaa baayʼee booddee</para>
  <para style="q2" vid="PRO 29:1">mataa jabaatu kam iyyuu akkuma tasaa caba; hin fayyus.<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>Yommuu namni qajeelaan aangoo qabatutti, sabni ni ililcha;</para>
  <para style="q2" vid="PRO 29:2">yommuu namni hamaan bulchu garuu sabni ni guunguma.<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>Namni ogummaa jaallatu abbaa isaa gammachiisa;</para>
  <para style="q2" vid="PRO 29:3">miiltoon sagaagaltuu garuu qabeenya isaa barbadeessa.<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>Mootiin murtii qajeelaadhaan biyyaaf nagaa buusa;</para>
  <para style="q2" vid="PRO 29:4">kan mattaʼaaf gaggabu immoo biyya gargar qoqqooda.<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>Namni ollaa isaa jaju,</para>
  <para style="q2" vid="PRO 29:5">miilluma isaatiif kiyyoo kaaʼa.<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>Namni hamaan cubbuu ofii isaatiin qabama;</para>
  <para style="q2" vid="PRO 29:6">qajeelaan garuu ni faarfata; ni ililchas.<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>Namni qajeelaan mirga hiyyeessaatiif dhaabata;</para>
  <para style="q2" vid="PRO 29:7">namni hamaan garuu dhimma akkanaa hin qabu.<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>Qoostonni magaalaa jeequ;</para>
  <para style="q2" vid="PRO 29:8">ogeeyyiin garuu aarii qabbaneessu.<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>Yoo ogeessi gowwaa wajjin mana murtii dhaqe,</para>
  <para style="q2" vid="PRO 29:9">gowwaan sun ni aara yookaan ni kolfa; nagaanis hin jiraatu.<verse eid="PRO 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>Namoonni dhiiga dheebotan, nama amanamaa jibbu;</para>
  <para style="q2" vid="PRO 29:10">nama tolaas ajjeesuu barbaadu.<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>Gowwaan guutumaan guutuutti aariitti of kenna;</para>
  <para style="q2" vid="PRO 29:11">ogeessi garuu of qaba.<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>Yoo bulchaan tokko soba dhaggeeffate,</para>
  <para style="q2" vid="PRO 29:12">qondaaltonni isaa hundi ni hammaatu.<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>Hiyyeessaa fi namni nama cunqursu waan kanaan wal fakkaatu:</para>
  <para style="q2" vid="PRO 29:13">
    <char style="nd">Waaqayyo</char> ija lachan isaaniitiifuu agartuu kenna.<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>Yoo mootiin tokko wal qixxummaadhaan <optbreak/> hiyyeeyyiif murtii kenne,</para>
  <para style="q2" vid="PRO 29:14">teessoon isaa bara baraan jabaatee dhaabata.<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>Ulee fi ifannaan ogummaa kennu; daaʼimni akkasumatti</para>
  <para style="q2" vid="PRO 29:15">gad dhiifame garuu haadha isaa salphisa.<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>Yommuu hamoonni aangoo qabatan, cubbuutu baayʼata;</para>
  <para style="q2" vid="PRO 29:16">qajeeltonni garuu kufaatii jaraa argu.<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>Ilma kee adabadhu, inni nagaa siif kenna;</para>
  <para style="q2" vid="PRO 29:17">lubbuu kees ni gammachiisa.<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>Iddoo mulʼanni hin jirretti sabni gad dhiisii taʼa;</para>
  <para style="q2" vid="PRO 29:18">namni seera eegu garuu eebbifamaa dha.<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>Garbichi dubbii afaanii qofaan hin sirreeffamu;</para>
  <para style="q2" vid="PRO 29:19">inni yoo hubate illee deebii hin kennuutii.<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>Ati nama jarjarsuun dubbatu argitee?</para>
  <para style="q2" vid="PRO 29:20">Isa irra gowwaatu abdii caalu qaba.<verse eid="PRO 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>Nama garbicha ofii isaa <optbreak/> ijoollummaa isaatii jalqabee qanansiisu,</para>
  <para style="q2" vid="PRO 29:21">galgalli isaa rakkina.<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>Namni aaru lola kakaasa;</para>
  <para style="q2" vid="PRO 29:22">kan dafee aarus cubbuu hedduu hojjeta.<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>Of tuulummaan namaa isuma gad deebisa;</para>
  <para style="q2" vid="PRO 29:23">namni hafuuraan gad of qabu garuu ulfina argata.<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>Namni hattuu wajjin qooddatu lubbuu ofii isaa jibba;</para>
  <para style="q2" vid="PRO 29:24">inni ni kakata; garuu waan tokko illee hin himu.<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>Nama sodaachuun kiyyoo namatti taʼa;</para>
  <para style="q2" vid="PRO 29:25">kan <char style="nd">Waaqayyoon</char> amanatu garuu nagaadhaan jiraata.<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>Namni hedduun bulchaa biratti surraa argachuu barbaada;</para>
  <para style="q2" vid="PRO 29:26">murtiin qajeelaan garuu <char style="nd">Waaqayyo</char> biraa dhufa.<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>Qajeelaan sobduu xireeffata;</para>
  <para style="q2" vid="PRO 29:27">hamaan immoo nama tolaa jibba.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="ms1">Jecha Aguur</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>Jecha Aguur ilma Yaaqee.</para>
  <para style="q1" vid="PRO 30:1">Dubbiin nama kanaa akkana jedhee Iitiiʼeeliitti dubbatame:</para>
  <para style="b" vid="PRO 30:1"/>
  <para style="q2" vid="PRO 30:1">“Innis Iitiiʼeeliittii fi Ukaalitti dubbate:<verse eid="PRO 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>Ani dhugumaan doofaa nama hundaa gadii ti;</para>
  <para style="q2" vid="PRO 30:2">ani hubannaa namni qabu hin qabu.<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>Ani ogummaa hin baranne yookaan beekumsa</para>
  <para style="q2" vid="PRO 30:3">Isa Qulqulluu sanaa hin qabu.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>Eenyutu samiitti ol baʼee deebiʼee dhufe?</para>
  <para style="q2" vid="PRO 30:4">Kan harki isaa bubbee walitti qabe eenyu?</para>
  <para style="q1" vid="PRO 30:4">Namni bishaan uffataan mare eenyu?</para>
  <para style="q2" vid="PRO 30:4">Kan daarii lafaa hunda jabeessee dhaabe eenyu?</para>
  <para style="q1" vid="PRO 30:4">Maqaan isaatii fi maqaan ilma isaa eenyu?</para>
  <para style="q2" vid="PRO 30:4">Mee yoo beekte natti himi!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>“Dubbiin Waaqaa hundinuu hirʼina hin qabu;</para>
  <para style="q2" vid="PRO 30:5">warra isatti kooluu galaniif, inni gaachana.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>Dubbii isaatti homaa hin dabalin;</para>
  <para style="q2" vid="PRO 30:6">yoo kanaa achii inni si ifata; atis sobduu taatee argamta.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>“Yaa <char style="nd">Waaqayyo</char> ani wantoota lama sin kadhadha;</para>
  <para style="q2" vid="PRO 30:7">isaanis utuu hamman jirutti ana hin dhowwatin.<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>Gowwoomsaa fi soba narraa fageessi;</para>
  <para style="q2" vid="PRO 30:8">hiyyummaa yookaan sooruma naaf hin kennin;</para>
  <para style="q2" vid="PRO 30:8">garuu buddeena koo guyyaa guyyaan naaf kenni.<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>Yoo kanaa achii ani akka malee quufee si ganee</para>
  <para style="q2" vid="PRO 30:9">‘<char style="nd">Waaqayyo</char> eenyuu dha?’ nan jedha;</para>
  <para style="q1" vid="PRO 30:9">yookaan hiyyoomee hatee,</para>
  <para style="q2" vid="PRO 30:9">akkasiin maqaa Waaqa koo nan salphisa.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>“Garbicha tokko gooftaa isaa biratti hin hamatin,</para>
  <para style="q2" vid="PRO 30:10">yoo kanaa achii inni si abaaraa; atis waan kanatti ni gaafatamta.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>“Dhaloota abbaa isaa abaaru</para>
  <para style="q2" vid="PRO 30:11">kan haadha isaa illee hin eebbifnetu jira;<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>dhaloota qulqulluu of seʼu,</para>
  <para style="q2" vid="PRO 30:12">kan xurii isaa irraa hin qulqulleeffamintu jiru;<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>dhaloota iji isaa akka malee of tuulu,</para>
  <para style="q2" vid="PRO 30:13">kan baalleen ija isaas nama tuffatutu jira;<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>dhaloota hiyyeeyyii lafa irraa fixuuf</para>
  <para style="q2" vid="PRO 30:14">rakkattoota illee gidduu namaatii balleessuuf</para>
  <para style="q1" vid="PRO 30:14">ilkaan isaa goraadee,</para>
  <para style="q2" vid="PRO 30:14">haʼoon isaa immoo billaa taʼe jira.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>“Dhulaandhulli intallan,</para>
  <para style="q2" vid="PRO 30:15">‘Kenni! Kenni!’ jedhanii iyyan lama qabdi.</para>
  <para style="b" vid="PRO 30:15"/>
  <para style="li1" vid="PRO 30:15">“Wantoota gonkumaa hin quufne sadiitu jira;</para>
  <para style="li2" vid="PRO 30:15">kanneen gonkumaa, ‘Nu gaʼe!’ hin jenne immoo afurtu jira:<verse eid="PRO 30:15"/></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16"/>isaanis Siiʼool,</para>
  <para style="li3" vid="PRO 30:16">gadameessa maseene,</para>
  <para style="li3" vid="PRO 30:16">lafa gonkumaa bishaan hin quufnee fi</para>
  <para style="li3" vid="PRO 30:16">ibidda gonkumaa, ‘Na gaʼe!’ hin jennee dha.<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>“Ija abbaatti qoosu,</para>
  <para style="q2" vid="PRO 30:17">kan ajaja haadhaa tuffatu</para>
  <para style="q1" vid="PRO 30:17">arraagessa sululaatiin baafama;</para>
  <para style="q2" vid="PRO 30:17">joobiraanis ni nyaatama.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18"/>“Wantoonni akka malee na dinqisiisan sadiitu jira;</para>
  <para style="li2" vid="PRO 30:18">afur immoo ani hin hubadhu; kunis:<verse eid="PRO 30:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19"/>Karaan risaa samii irra,</para>
  <para style="li3" vid="PRO 30:19">karaan bofaa kattaa irra,</para>
  <para style="li3" vid="PRO 30:19">karaan doonii galaana guddaa irra,</para>
  <para style="li3" vid="PRO 30:19">karaan dhiiraa immoo dubartii wajjin taʼuu isaa ti.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>“Karaan ejjituu kana:</para>
  <para style="q2" vid="PRO 30:20">Isheen waa nyaattee afaan haqatti;</para>
  <para style="q2" vid="PRO 30:20">ergasii immoo, ‘Ani homaa hin balleessine’ jetti.<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21"/>“Lafti waan sadii jalatti hollatti;</para>
  <para style="li2" vid="PRO 30:21">afur immoo baachuu hin dandeessu; kunis:<verse eid="PRO 30:21"/></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22"/>Garbicha mootii taʼu,</para>
  <para style="li3" vid="PRO 30:22">gowwaa nyaatee quufu,<verse eid="PRO 30:22"/></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23"/>dubartiin jibbamte yeroo dhirsa argattu,</para>
  <para style="li3" vid="PRO 30:23">garbittii giiftii ishee dhaaltu.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24"/>“Wantoonni xixinnoon afur lafa irra jiru;</para>
  <para style="li2" vid="PRO 30:24">taʼu illee isaan akka malee ogeeyyii dha; isaanis:<verse eid="PRO 30:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25"/>Goondaawwan tuuta jabina hin qabnee dha;</para>
  <para style="li3" vid="PRO 30:25">taʼus isaan yeroo bonaa nyaata isaanii walitti qaban;<verse eid="PRO 30:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26"/>osoleewwan uumamawwan humna hin qabnee dha;</para>
  <para style="li3" vid="PRO 30:26">garuu kattaa keessa jiraatu;<verse eid="PRO 30:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27"/>hawwaannisni mootii hin qabu;</para>
  <para style="li3" vid="PRO 30:27">garuu tarree galee yaaʼa;<verse eid="PRO 30:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28"/>loccuun harkaan qabamuu dandeessi;</para>
  <para style="li3" vid="PRO 30:28">garuu masaraa mootii keessatti argamti.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29"/>“Wantoota deemsa tolan sadiitu jira;</para>
  <para style="li2" vid="PRO 30:29">kanneen tarkaanfii bareedanis afurtu jira; isaanis:<verse eid="PRO 30:29"/></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30"/>Leenca bineensa hunda keessaa jabaa, kan waan tokko illee sodaatee duubatti hin deebine;<verse eid="PRO 30:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31"/>korma indaanqoo kan kooraa deemu,</para>
  <para style="li3" vid="PRO 30:31">korbeessa reʼeetii fi,</para>
  <para style="li3" vid="PRO 30:31">mootii loltoota isaa dura deemu.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>“Ati yoo of jajuudhaan gowwoomte,</para>
  <para style="q2" vid="PRO 30:32">yookaan yoo hammina malatte,</para>
  <para style="q2" vid="PRO 30:32">harka kee afaan kee irra kaaʼadhu!<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>Akkuma aannan raasuun dhadhaa baasu,</para>
  <para style="q2" vid="PRO 30:33">funyaan micciiruunis dhiiga baasu sana,</para>
  <para style="q2" vid="PRO 30:33">aarii kakaasuun lola fida.”<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="ms1">Jecha Limuuʼel Mootichaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Jecha Lemuuʼeel mootichaa kan haati isaa isa barsiifte:<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>“Maali yaa ilma ko, maali yaa ilma gadameessa ko,</para>
  <para style="q2" vid="PRO 31:2">maali yaa ilma wareega ko,<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>humna kee dubartoota irratti,</para>
  <para style="q2" vid="PRO 31:3">jabina kee warra mootota balleessan irratti hin fixin.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>“Yaa Lemuuʼeel, wanni kun moototaaf hin malu;</para>
  <para style="q2" vid="PRO 31:4">daadhii wayinii dhuguun moototaaf hin malu;</para>
  <para style="q2" vid="PRO 31:4">dhugaatii cimaatti gaggabuunis bulchitootaaf hin malu;<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>kunis akka isaan dhuganii waan seerri jedhu dagatanii</para>
  <para style="q2" vid="PRO 31:5">warra hacuucaman hunda mirga isaanii hin dhowwanneef.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>Warra baduuf jiraniif dhugaatii cimaa,</para>
  <para style="q2" vid="PRO 31:6">warra jireenyi itti hadhaaʼeef daadhii wayinii kenni;<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>isaan dhuganii hiyyummaa isaanii haa irraanfatan;</para>
  <para style="q2" vid="PRO 31:7">rakkina isaaniis deebiʼanii hin yaadatin.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>“Warra ofii isaaniitiif dubbachuu hin dandeenyeef,</para>
  <para style="q2" vid="PRO 31:8">mirga warra gatamaniitiifis falmi.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>Afaan kee banadhu; murtii qajeelaas kenni;</para>
  <para style="q2" vid="PRO 31:9">mirga hiyyeeyyiitii fi rakkattootaatiif falmi.”<verse eid="PRO 31:9"/></para>
  <para style="ms1">Xumura: Niitii Amala Gaarii Qabdu</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>Niitii amala gaarii qabdu eenyutu argachuu dandaʼa?</para>
  <para style="q2" vid="PRO 31:10">Isheen lula diimaa caalaa gati qabeettii dha.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>Dhirsi ishee guddisee ishee amanata;</para>
  <para style="q2" vid="PRO 31:11">inni waan faayidaa qabu tokko illee hin dhabu.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>Isheen bara jireenya ishee guutuu</para>
  <para style="q2" vid="PRO 31:12">waan gaarii isaaf fiddi malee isa hin miitu.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>Isheen suufii fi quncee talbaa barbaaddee</para>
  <para style="q2" vid="PRO 31:13">harka ishee kan hojii jaallatuun footi.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>Isheen akkuma doonii daldalaatti</para>
  <para style="q2" vid="PRO 31:14">lafa fagoodhaa nyaata ishee fidatti.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>Isheen utuu lafti hin bariʼin hirribaa kaatee</para>
  <para style="q2" vid="PRO 31:15">maatii isheetiif nyaata kenniti;</para>
  <para style="q2" vid="PRO 31:15">xomboreewwan isheefis hojii qooddi.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>Isheen lafa qotiisaa hubattee ilaaltee bitti;</para>
  <para style="q2" vid="PRO 31:16">waan hojjettee argattu keessaa wayinii dhaabdi.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>Isheen jabinaan mudhii ishee hidhattee</para>
  <para style="q2" vid="PRO 31:17">hojiidhaaf irree ishee jabeeffatti.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>Isheen akka daldalli ishee buʼaa qabu hubatti;</para>
  <para style="q2" vid="PRO 31:18">ibsaan ishees halkaniin hin dhaamu.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>Mukni itti jirbii maran harka ishee keessa jira;</para>
  <para style="q2" vid="PRO 31:19">quba isheetiin immoo calii qabatti.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>Isheen hiyyeessaaf harka hiixatti;</para>
  <para style="q2" vid="PRO 31:20">dhabaadhaaf illee harka balʼifti.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>Yoo cabbiin buʼe illee isheen maatii isheetiif hin yaaddoftu;</para>
  <para style="q2" vid="PRO 31:21">isaan hundinuu uffata bildiimaa uffataniiruutii.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>Isheen wayyaa siree dhaʼatti;</para>
  <para style="q2" vid="PRO 31:22">uffata dhiilgee quncee talbaa haphii irraa <optbreak/> hojjetames uffatti.<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>Dhirsi ishee yommuu karra magaalaa dura,</para>
  <para style="q2" vid="PRO 31:23">jaarsolii biyyaa gidduu taaʼu ni kabajama.<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>Isheen wayyaa quncee talbaa dhooftee gurgurti;</para>
  <para style="q2" vid="PRO 31:24">daldaltootaafis sabbata dhiʼeessiti.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>Isheen jabinaa fi ulfina uffatti;</para>
  <para style="q2" vid="PRO 31:25">bara dhufaa jiruttis kolfuu dandeessi.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>Afaan ishee ogummaadhaan banatti;</para>
  <para style="q2" vid="PRO 31:26">gorsi gara laafinaas arraba ishee irra jira.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>Isheen mana ishee toʼatti;</para>
  <para style="q2" vid="PRO 31:27">isheen buddeena dhibaaʼummaas hin nyaattu.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>Ijoolleen ishee kaʼanii, eebbifamtuu jedhuun;</para>
  <para style="q2" vid="PRO 31:28">dhirsi ishees akkasuma jedhaan; akkana jedhees ishee jaja:<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“Dubartoonni hedduun waan gaarii hojjetu;</para>
  <para style="q2" vid="PRO 31:29">ati garuu isaan hunda caalta.”<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>Simboon nama gowwoomsa; miidhaginnis ni darba;</para>
  <para style="q2" vid="PRO 31:30">dubartiin <char style="nd">Waaqayyoon</char> sodaattu garuu galateeffamtuu dha.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>Buʼaa harka ishee kennaafii;</para>
  <para style="q2" vid="PRO 31:31">hojiin ishee karra magaalaa duratti ishee haa jaju.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
