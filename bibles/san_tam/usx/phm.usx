<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHM" style="id">Sanskrit Bible (NT) in Tamil Script (ஸத்யவேத³​:।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philemon</para>
  <para style="toc1">பி²லோமோநம்ʼ பத்ரம்ʼ</para>
  <para style="toc2">பி²லோமோந​:</para>
  <para style="toc3">பி²லோமோந​:</para>
  <para style="mt1">பி²லோமோநம்ʼ பத்ரம்ʼ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>க்²ரீஷ்டஸ்ய யீஸோ² ர்ப³ந்தி³தா³ஸ​: பௌலஸ்தீதி²யநாமா ப்⁴ராதா ச ப்ரியம்ʼ ஸஹகாரிணம்ʼ பி²லீமோநம்ʼ</para>
  <para style="p">
    <verse number="2" style="v"/>ப்ரியாம் ஆப்பியாம்ʼ ஸஹஸேநாம் ஆர்கி²ப்பம்ʼ பி²லீமோநஸ்ய க்³ருʼஹே ஸ்தி²தாம்ʼ ஸமிதிஞ்ச ப்ரதி பத்ரம்ʼ லிக²த​:|</para>
  <para style="p">
    <verse number="3" style="v"/>அஸ்மாகம்ʼ தாத ஈஸ்²வர​: ப்ரபு⁴ ர்யீஸு²க்²ரீஷ்டஸ்²ச யுஷ்மாந் ப்ரதி ஸா²ந்திம் அநுக்³ரஹஞ்ச க்ரியாஸ்தாம்ʼ|</para>
  <para style="p">
    <verse number="4" style="v"/>ப்ரபு⁴ம்ʼ யீஸு²ம்ʼ ப்ரதி ஸர்வ்வாந் பவித்ரலோகாந் ப்ரதி ச தவ ப்ரேமவிஸ்²வாஸயோ ர்வ்ருʼத்தாந்தம்ʼ நிஸ²ம்யாஹம்ʼ</para>
  <para style="p">
    <verse number="5" style="v"/>ப்ரார்த²நாஸமயே தவ நாமோச்சாரயந் நிரந்தரம்ʼ மமேஸ்²வரம்ʼ த⁴ந்யம்ʼ வதா³மி|</para>
  <para style="p">
    <verse number="6" style="v"/>அஸ்மாஸு யத்³யத் ஸௌஜந்யம்ʼ வித்³யதே தத் ஸர்வ்வம்ʼ க்²ரீஷ்டம்ʼ யீஸு²ம்ʼ யத் ப்ரதி ப⁴வதீதி ஜ்ஞாநாய தவ விஸ்²வாஸமூலிகா தா³நஸீ²லதா யத் ஸப²லா ப⁴வேத் தத³ஹம் இச்சா²மி|</para>
  <para style="p">
    <verse number="7" style="v"/>ஹே ப்⁴ராத​:, த்வயா பவித்ரலோகாநாம்ʼ ப்ராண ஆப்யாயிதா அப⁴வந் ஏதஸ்மாத் தவ ப்ரேம்நாஸ்மாகம்ʼ மஹாந் ஆநந்த³​: ஸாந்த்வநா ச ஜாத​:|</para>
  <para style="p">
    <verse number="8" style="v"/>த்வயா யத் கர்த்தவ்யம்ʼ தத் த்வாம் ஆஜ்ஞாபயிதும்ʼ யத்³யப்யஹம்ʼ க்²ரீஷ்டேநாதீவோத்ஸுகோ ப⁴வேயம்ʼ ததா²பி வ்ருʼத்³த⁴</para>
  <para style="p">
    <verse number="9" style="v"/>இதா³நீம்ʼ யீஸு²க்²ரீஷ்டஸ்ய ப³ந்தி³தா³ஸஸ்²சைவம்பூ⁴தோ ய​: பௌல​: ஸோ(அ)ஹம்ʼ த்வாம்ʼ விநேதும்ʼ வரம்ʼ மந்யே|</para>
  <para style="p">
    <verse number="10" style="v"/>அத​: ஸ்²ருʼங்க²லப³த்³தோ⁴(அ)ஹம்ʼ யமஜநயம்ʼ தம்ʼ மதீ³யதநயம் ஓநீஷிமம் அதி⁴ த்வாம்ʼ விநயே|</para>
  <para style="p">
    <verse number="11" style="v"/>ஸ பூர்வ்வம்ʼ தவாநுபகாரக ஆஸீத் கிந்த்விதா³நீம்ʼ தவ மம சோபகாரீ ப⁴வதி|</para>
  <para style="p">
    <verse number="12" style="v"/>தமேவாஹம்ʼ தவ ஸமீபம்ʼ ப்ரேஷயாமி, அதோ மதீ³யப்ராணஸ்வரூப​: ஸ த்வயாநுக்³ருʼஹ்யதாம்ʼ|</para>
  <para style="p">
    <verse number="13" style="v"/>ஸுஸம்ʼவாத³ஸ்ய க்ருʼதே ஸ்²ருʼங்க²லப³த்³தோ⁴(அ)ஹம்ʼ பரிசாரகமிவ தம்ʼ ஸ்வஸந்நிதௌ⁴ வர்த்தயிதும் ஐச்ச²ம்ʼ|</para>
  <para style="p">
    <verse number="14" style="v"/>கிந்து தவ ஸௌஜந்யம்ʼ யத்³ ப³லேந ந பூ⁴த்வா ஸ்வேச்சா²யா​: ப²லம்ʼ ப⁴வேத் தத³ர்த²ம்ʼ தவ ஸம்மதிம்ʼ விநா கிமபி கர்த்தவ்யம்ʼ நாமந்யே|</para>
  <para style="p">
    <verse number="15" style="v"/>கோ ஜாநாதி க்ஷணகாலார்த²ம்ʼ த்வத்தஸ்தஸ்ய விச்சே²தோ³(அ)ப⁴வத்³ ஏதஸ்யாயம் அபி⁴ப்ராயோ யத் த்வம் அநந்தகாலார்த²ம்ʼ தம்ʼ லப்ஸ்யஸே</para>
  <para style="p">
    <verse number="16" style="v"/>புந ர்தா³ஸமிவ லப்ஸ்யஸே தந்நஹி கிந்து தா³ஸாத் ஸ்²ரேஷ்ட²ம்ʼ மம ப்ரியம்ʼ தவ ச ஸா²ரீரிகஸம்ப³ந்தா⁴த் ப்ரபு⁴ஸம்ப³ந்தா⁴ச்ச ததோ(அ)தி⁴கம்ʼ ப்ரியம்ʼ ப்⁴ராதரமிவ|</para>
  <para style="p">
    <verse number="17" style="v"/>அதோ ஹேதோ ர்யதி³ மாம்ʼ ஸஹபா⁴கி³நம்ʼ ஜாநாஸி தர்ஹி மாமிவ தமநுக்³ருʼஹாண|</para>
  <para style="p">
    <verse number="18" style="v"/>தேந யதி³ தவ கிமப்யபராத்³த⁴ம்ʼ துப்⁴யம்ʼ கிமபி தா⁴ர்ய்யதே வா தர்ஹி தத் மமேதி விதி³த்வா க³ணய|</para>
  <para style="p">
    <verse number="19" style="v"/>அஹம்ʼ தத் பரிஸோ²த்ஸ்யாமி, ஏதத் பௌலோ(அ)ஹம்ʼ ஸ்வஹஸ்தேந லிகா²மி, யதஸ்த்வம்ʼ ஸ்வப்ராணாந் அபி மஹ்யம்ʼ தா⁴ரயஸி தத்³ வக்தும்ʼ நேச்சா²மி|</para>
  <para style="p">
    <verse number="20" style="v"/>போ⁴ ப்⁴ராத​:, ப்ரபோ⁴​: க்ருʼதே மம வாஞ்சா²ம்ʼ பூரய க்²ரீஷ்டஸ்ய க்ருʼதே மம ப்ராணாந் ஆப்யாயய|</para>
  <para style="p">
    <verse number="21" style="v"/>தவாஜ்ஞாக்³ராஹித்வே விஸ்²வஸ்ய மயா ஏதத் லிக்²யதே மயா யது³ச்யதே ததோ(அ)தி⁴கம்ʼ த்வயா காரிஷ்யத இதி ஜாநாமி|</para>
  <para style="p">
    <verse number="22" style="v"/>தத்கரணஸமயே மத³ர்த²மபி வாஸக்³ருʼஹம்ʼ த்வயா ஸஜ்ஜீக்ரியதாம்ʼ யதோ யுஷ்மாகம்ʼ ப்ரார்த²நாநாம்ʼ ப²லரூபோ வர இவாஹம்ʼ யுஷ்மப்⁴யம்ʼ தா³யிஷ்யே மமேதி ப்ரத்யாஸா² ஜாயதே|</para>
  <para style="p">
    <verse number="23" style="v"/>க்²ரீஷ்டஸ்ய யீஸா²​: க்ருʼதே மயா ஸஹ ப³ந்தி³ரிபாப்²ரா</para>
  <para style="p">
    <verse number="24" style="v"/>மம ஸஹகாரிணோ மார்க ஆரிஷ்டார்கோ² தீ³மா லூகஸ்²ச த்வாம்ʼ நமஸ்காரம்ʼ வேத³யந்தி|</para>
  <para style="p">
    <verse number="25" style="v"/>அஸ்மாகம்ʼ ப்ரபோ⁴ ர்யீஸு²க்²ரீஷ்டஸ்யாநுக்³ரஹோ யுஷ்மாகம் ஆத்மநா ஸஹ பூ⁴யாத்| ஆமேந்|</para>
</usx>
