<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Mishle</para>
  <para style="toc2">Mishle</para>
  <para style="toc1">Mishle</para>
  <para style="mt1">Mishle</para>
  <chapter number="1" style="c" pubnumber="א" sid="PRO 1" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />di shprichverter fun Shlomo dem zun fun Dovidn, dem melech fun Yisroel;<verse eid="PRO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2" />kedei tsu visen chochme un musar,</para>
  <para style="q" vid="PRO 1:2">tsu farshtein di verter fun farshtandikeit;<verse eid="PRO 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3" />tsu nemen dem musar fun klugshaft,</para>
  <para style="q" vid="PRO 1:3">gerechtikeit un recht un yoisher;<verse eid="PRO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4" />tsu gebn di narn geshaitkeit,</para>
  <para style="q" vid="PRO 1:4">dem yungn kenshaft un gedanken;<verse eid="PRO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5" />der chochem zol hern un mern lernung,</para>
  <para style="q" vid="PRO 1:5">un der farshtandiker zol krign tachbulos;<verse eid="PRO 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6" />tsu farshtein a shprichvort un a melitse,</para>
  <para style="q" vid="PRO 1:6">di verter fun di chachomim un zeyere retenishn.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7" />der onheib fun kenshaft iz moire far Hashem,</para>
  <para style="q" vid="PRO 1:7">ober di narn farachten chochme un musar.<verse eid="PRO 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8" />her tsu, main zun, dem musar fun dain foter,</para>
  <para style="q" vid="PRO 1:8">un zolst nisht farlozen di ler fun dain muter;<verse eid="PRO 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9" />vorem a krants fun chein veln zei zain far dain kop,</para>
  <para style="q" vid="PRO 1:9">un haldzbender far dain haldz.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10" />main zun, az di zindike veln dich onredn,</para>
  <para style="q" vid="PRO 1:10">zolstu nisht ainvilikn.<verse eid="PRO 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11" />az zei veln zogn: kum mit undz!</para>
  <para style="q" vid="PRO 1:11">lomir loiern oif blut,</para>
  <para style="q" vid="PRO 1:11">lomir lakern oifn umshuldikn far umzist;<verse eid="PRO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12" />lomir zei ainshlingen lebedikerheit vi di Sheol,</para>
  <para style="q" vid="PRO 1:12">un gantserheit vi di vos nidern in grub;<verse eid="PRO 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13" />alerlei taiere guts veln mir gefinen,</para>
  <para style="q" vid="PRO 1:13">mir veln onfiln undzer hoiz mit roib;<verse eid="PRO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14" />vorf dain goirl tsvishn undz,</para>
  <para style="q" vid="PRO 1:14">ein baitl vet zain bai undz alemen;<verse eid="PRO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15" />zolstu nisht gein, main zun, mit zei in veg,</para>
  <para style="q" vid="PRO 1:15">farmaid dain fus fun zeyer shteg.<verse eid="PRO 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16" />vorem zeyere fis loifn tsu beiz,</para>
  <para style="q" vid="PRO 1:16">un zei ailn tsu fargisen blut.<verse eid="PRO 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17" />vorem far umzist iz oisgeshpreit di nets,</para>
  <para style="q" vid="PRO 1:17">in di oign fun ale gefliglte,<verse eid="PRO 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18" />beeis me loiert oif zeyer blut,</para>
  <para style="q" vid="PRO 1:18">me lokert oif zeyere lebns.<verse eid="PRO 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19" />azoi zainen di vegen fun itlechn vos iz gaitsik noch roib;</para>
  <para style="q" vid="PRO 1:19">es nemt avek dos lebn fun dem vos hot es.<verse eid="PRO 1:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20" />di chochme shrait oif der gas,</para>
  <para style="q" vid="PRO 1:20">in di merk lozt zi arois ir kol;<verse eid="PRO 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21" />in ek fun roishike gasn ruft zi,</para>
  <para style="q" vid="PRO 1:21">bai di toieraingangen,</para>
  <para style="q" vid="PRO 1:21">in shtot, redt zi ire reid:<verse eid="PRO 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22" />biz vanen, ir farnarte, vet ir lib hobn narishkeit,</para>
  <para style="q" vid="PRO 1:22">un di shpeter veln zich glustn geshpet,</para>
  <para style="q" vid="PRO 1:22">un di narn veln faint hobn visen?<verse eid="PRO 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23" />kert aich tsu main musar,</para>
  <para style="q" vid="PRO 1:23">ot vel ich oisgisen main gaist tsu aich,</para>
  <para style="q" vid="PRO 1:23">ich vel aich machn visen maine verter.<verse eid="PRO 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24" />vail ich hob gerufn, un ir hot nisht gevolt,</para>
  <para style="q" vid="PRO 1:24">oisgeshtrekt main hant, un keiner hot nisht farnumen,<verse eid="PRO 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25" />nor ir hot gemacht tsu nisht main yetveder eitse,</para>
  <para style="q" vid="PRO 1:25">un main musar hot ir nisht gevolt,<verse eid="PRO 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26" />vel ich oich lachn oif aier broch,</para>
  <para style="q" vid="PRO 1:26">ich vel shpetn ven aier shrek vet kumen;<verse eid="PRO 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27" />ven es kumt vi a geviter aier shrek,</para>
  <para style="q" vid="PRO 1:27">un aier broch vet vi a shturemvint onkumen;</para>
  <para style="q" vid="PRO 1:27">ven es kumt oif aich noit un angst.<verse eid="PRO 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28" />dentsmol veln zei mich rufn, un ich vel nisht entfern,</para>
  <para style="q" vid="PRO 1:28">zei veln mich zuchn, un veln mich nisht gefinen.<verse eid="PRO 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29" />derfar vos zei hobn faint gehat visen,</para>
  <para style="q" vid="PRO 1:29">un moire far Hashem nisht oisgeveilt;<verse eid="PRO 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30" />nisht aingevilikt tsu main eitse,</para>
  <para style="q" vid="PRO 1:30">faracht main gantsn musar.<verse eid="PRO 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31" />derum veln zei esen fun der frucht fun zeyer veg,</para>
  <para style="q" vid="PRO 1:31">un mit zeyere etsut zich zetn.<verse eid="PRO 1:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32" />vorem di opkerung fun di farnarte vet zei hargen,</para>
  <para style="q" vid="PRO 1:32">un di shalve fun di narn vet zei unterbrengen.<verse eid="PRO 1:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33" />ober der vos hert mir tsu vet voinen in zicherkeit,</para>
  <para style="q" vid="PRO 1:33">un barut zain fun shrek far beiz.<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="PRO 2" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1" />main zun, az du vest onnemen maine verter,</para>
  <para style="q" vid="PRO 2:1">un maine gebot vestu bahaltn bai zich,<verse eid="PRO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2" />tsutsuleigen tsu chochme dain oier,</para>
  <para style="q" vid="PRO 2:2">naign dain harts tsu farshtandikeit;<verse eid="PRO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3" />nor bloiz tsum seichel vestu rufn,</para>
  <para style="q" vid="PRO 2:3">tsu farshtandikeit oifheibn dain kol;<verse eid="PRO 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4" />az du vest zi zuchn vi zilber,</para>
  <para style="q" vid="PRO 2:4">un vi noch oitseres zi forshn;<verse eid="PRO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5" />dentsmol vestu farshtein moire far Hashem,</para>
  <para style="q" vid="PRO 2:5">un derkenung fun Elokim vestu gefinen.<verse eid="PRO 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6" />vorem Hashem shenkt chochme,</para>
  <para style="q" vid="PRO 2:6">fun zain moil iz visen un farshtandikeit.<verse eid="PRO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7" />er hot bahaltn far di rechtfartikn zaine lernungen,</para>
  <para style="q" vid="PRO 2:7">er iz a shild far di vos geyen oifrichtik,<verse eid="PRO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8" />oiftsupasn di shtegn fun gerechtikeit,</para>
  <para style="q" vid="PRO 2:8">un di vegen fun zaine frume bahit er.<verse eid="PRO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9" />dentsmol vestu farshtein gerechtikeit un recht</para>
  <para style="q" vid="PRO 2:9">un yoisher – yetveder gutn veg.<verse eid="PRO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10" />vorem chochme vet kumen in dain hartsn,</para>
  <para style="q" vid="PRO 2:10">un visen vet zain zis far dain zel.<verse eid="PRO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11" />klugshaft vet oifpasn oif dir,</para>
  <para style="q" vid="PRO 2:11">farshtandikeit vet dich bahitn;<verse eid="PRO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12" />dich matsl tsu zain fun dem shlechtn veg,</para>
  <para style="q" vid="PRO 2:12">fun di lait vos redn farkertkeit;<verse eid="PRO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13" />vos farlozen di shtegn fun rechtfartikeit,</para>
  <para style="q" vid="PRO 2:13">tsu gein in di vegen fun fintsternish;<verse eid="PRO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14" />vos freyen zich tsu ton beiz,</para>
  <para style="q" vid="PRO 2:14">vos kveln fun beizer farkertkeit;<verse eid="PRO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15" />vos zeyere vegen zainen krum,</para>
  <para style="q" vid="PRO 2:15">un vos zainen fardreit in zeyere geng.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16" />kedei dich matsl tsu zain fun der fremder froi,</para>
  <para style="q" vid="PRO 2:16">fun der umbakenter vos macht glat ire reid;<verse eid="PRO 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17" />vos farlozt dem har fun ir yugnt,</para>
  <para style="q" vid="PRO 2:17">un dem bris fun ir Elokim hot zi fargesen;<verse eid="PRO 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18" />vorem ir hoiz nidert tsum toit,</para>
  <para style="q" vid="PRO 2:18">un ire shtegn tsu di meisim;<verse eid="PRO 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19" />ale vos kumen tsu ir, kern zich nisht um,</para>
  <para style="q" vid="PRO 2:19">un dergreichn nisht di vegen fun lebn.<verse eid="PRO 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20" />kedei zolst gein in dem veg fun di gute,</para>
  <para style="q" vid="PRO 2:20">un di shtegn fun di gerechte zolstu ophiten.<verse eid="PRO 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21" />vorem di rechtfartikn veln bavoinen dos land,</para>
  <para style="q" vid="PRO 2:21">un di umshuldike veln blaibn derin.<verse eid="PRO 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22" />ober di reshoim veln farshnitn vern fun land,</para>
  <para style="q" vid="PRO 2:22">un di felsher veln aroisgerisn vern fun ir.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="PRO 3" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1" />main zun, zolst nisht fargesen main lernung,</para>
  <para style="q" vid="PRO 3:1">un maine gebot zol hitn dain harts.<verse eid="PRO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2" />vorem aricht-yamim un yorn fun lebn</para>
  <para style="q" vid="PRO 3:2">un frid veln zei dir tsugebn.<verse eid="PRO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3" />genod un emes zoln dich nisht farlozen,</para>
  <para style="q" vid="PRO 3:3">bind zei arum dain haldz,</para>
  <para style="q" vid="PRO 3:3">shraib zei on oifn tovl fun dain hartsn,<verse eid="PRO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4" />un gefin chein un gutn seichel</para>
  <para style="q" vid="PRO 3:4">in di oign fun Elokim un fun lait.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5" />farzicher zich oif Hashem mit dain gantsn hartsn,</para>
  <para style="q" vid="PRO 3:5">un oif dain farshtandikeit zolstu zich nisht onlenen.<verse eid="PRO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6" />in ale daine vegen tu im kenen,</para>
  <para style="q" vid="PRO 3:6">un er vet glaich machn daine shtegn.<verse eid="PRO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7" />zolst nisht zain a chochem in daine oign,</para>
  <para style="q" vid="PRO 3:7">hob moire far Hashem, un ker zich op fun beiz.<verse eid="PRO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8" />dos vet zain a heilung far dain nopl,</para>
  <para style="q" vid="PRO 3:8">un a zaft far daine beiner.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9" />gib koved tsu Hashem fun dain guts,</para>
  <para style="q" vid="PRO 3:9">un funem ershtn fun al dain tvue,<verse eid="PRO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10" />un daine shpaichlers veln ful zain mit zet,</para>
  <para style="q" vid="PRO 3:10">un daine kelters veln fleitsn mit vain.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11" />dem musar fun Hashem zolstu, main zun, nisht farachten,</para>
  <para style="q" vid="PRO 3:11">un zolst nisht farumverdikn zain shtrof.<verse eid="PRO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12" />vorem dem vos Hashem hot lib, dem shtroft er,</para>
  <para style="q" vid="PRO 3:12">un vi a foter dem zun vos er hot lib.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13" />voil tsu dem mentshn vos gefint chochme,</para>
  <para style="q" vid="PRO 3:13">un dem mentshn vos krigt farshtandikeit.<verse eid="PRO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14" />vorem ir sechoire iz beser vi sechoire fun zilber,</para>
  <para style="q" vid="PRO 3:14">un mer vi gingold ir ainkum.<verse eid="PRO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15" />zi iz taierer fun perl,</para>
  <para style="q" vid="PRO 3:15">un ale daine cheftsim zainen nisht glaich tsu ir.<verse eid="PRO 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16" />aricht-yamim iz in ir rechter hant,</para>
  <para style="q" vid="PRO 3:16">in ir linker eshires un koved.<verse eid="PRO 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17" />ire vegen zainen vegen fun liblechkeit,</para>
  <para style="q" vid="PRO 3:17">un ale ire shtegn zainen sholem.<verse eid="PRO 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18" />a boim fun lebn iz zi far di vos haltn zi fest,</para>
  <para style="q" vid="PRO 3:18">un der vos halt zich on ir iz baglikt.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19" />Hashem hot mit chochme gegruntfest di erd,</para>
  <para style="q" vid="PRO 3:19">er hot oifgeshtelt di himlen mit farshtandikeit.<verse eid="PRO 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20" />durch zain visen hobn zich di tehomen geshpoltn,</para>
  <para style="q" vid="PRO 3:20">un di himlen trifn toi.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21" />main zun, zoln zei nisht avek fun daine oign;</para>
  <para style="q" vid="PRO 3:21">hit klugshaft un geshaitkeit,<verse eid="PRO 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22" />un zei veln zain lebn far dain laib,</para>
  <para style="q" vid="PRO 3:22">un chein oif dain haldz.<verse eid="PRO 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23" />dentsmol vestu gein in zicherkeit dain veg,</para>
  <para style="q" vid="PRO 3:23">un vest nisht opshlogn dain fus.<verse eid="PRO 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24" />az du vest zich leign vestu nisht angstn,</para>
  <para style="q" vid="PRO 3:24">un vest lign, un zis vet zain dain shlof.<verse eid="PRO 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25" />zolst nisht moire hobn far an umgerichtn shrek,</para>
  <para style="q" vid="PRO 3:25">un far der farvistung fun di reshoim, ven zi kumt.<verse eid="PRO 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26" />vorem Hashem vet zain dain bitochen,</para>
  <para style="q" vid="PRO 3:26">un vet hitn dain fus fun batsvingenish.<verse eid="PRO 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27" />zolst nisht farmaidn guts fun dem vos darf es,</para>
  <para style="q" vid="PRO 3:27">ven dain hant hot bekoyech tsu ton.<verse eid="PRO 3:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28" />zolst nisht zogn tsu dain chever:</para>
  <para style="q" vid="PRO 3:28">gei, un kum vider,</para>
  <para style="q" vid="PRO 3:28">un morgn vel ich gebn,</para>
  <para style="q" vid="PRO 3:28">ven du host bai zich.<verse eid="PRO 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29" />zolst nisht trachtn a roeh oif dain chever,</para>
  <para style="q" vid="PRO 3:29">ven er zitst in zicherkeit bai dir.<verse eid="PRO 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30" />zolst zich nisht krign mit a mentshn umzist,</para>
  <para style="q" vid="PRO 3:30">oib er hot dir nisht geton kein roeh.<verse eid="PRO 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31" />zolst nisht mekane zain dem man fun umrecht,</para>
  <para style="q" vid="PRO 3:31">un zolst nisht oisveiln keinem fun zaine vegen.<verse eid="PRO 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32" />vorem an umverdikeit bai Hashem iz der farkerter,</para>
  <para style="q" vid="PRO 3:32">un mit di rechtfartikn iz er fartroit.<verse eid="PRO 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33" />di klole fun Hashem iz in hoiz fun roshe,</para>
  <para style="q" vid="PRO 3:33">un di voinung fun tsadik bentsht er.<verse eid="PRO 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34" />oib shpeter – macht er zei tsum geshpet,</para>
  <para style="q" vid="PRO 3:34">ober di shtile git er chein.<verse eid="PRO 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35" />koved arben di chachomim,</para>
  <para style="q" vid="PRO 3:35">un narn klaibn oif shand.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="PRO 4" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1" />hert tsu, kinder, dem musar fun a foter,</para>
  <para style="q" vid="PRO 4:1">un farnemt, kedei tsu kenen farshtandikeit.<verse eid="PRO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2" />vorem a gute lere gib ich aich,</para>
  <para style="q" vid="PRO 4:2">ir zolt main toyre nisht farlozen.<verse eid="PRO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3" />vorem ich bin oich geven a zun bai main foter,</para>
  <para style="q" vid="PRO 4:3">a tsiteriker un an eineintsiker far main muter.<verse eid="PRO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4" />un er hot mich gelernt, un mir gezogt:</para>
  <para style="q" vid="PRO 4:4">zol dain harts zich haltn on maine verter,</para>
  <para style="q" vid="PRO 4:4">hit maine gebot, un leb.<verse eid="PRO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5" />koif chochme, koif farshtandikeit; zolst nisht fargesen,</para>
  <para style="q" vid="PRO 4:5">un zich nisht opnaign fun di verter fun main moil.<verse eid="PRO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6" />zolst zi nisht farlozen, un zi vet dich bahitn,</para>
  <para style="q" vid="PRO 4:6">hob zi lib, un zi vet dich oifpasn.<verse eid="PRO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7" />der onheib fun chochme iz: koif chochme,</para>
  <para style="q" vid="PRO 4:7">yo, mit dain gantsn eigens koif farshtandikeit.<verse eid="PRO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8" />halt zi hoich, un zi vet dich derheibn;</para>
  <para style="q" vid="PRO 4:8">zi vet dir onton koved, az du vest zi haldzn.<verse eid="PRO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9" />zi vet gebn dain kop a krants fun chein,</para>
  <para style="q" vid="PRO 4:9">a kroin fun sheinkeit vet zi dir derlangen.<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10" />her, main zun, un farnem maine verter,</para>
  <para style="q" vid="PRO 4:10">un dir veln gemert vern yorn fun lebn.<verse eid="PRO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11" />in dem veg fun chochme hob ich dich gelernt,</para>
  <para style="q" vid="PRO 4:11">dich gefirt in di shtegn fun rechtfartikeit.<verse eid="PRO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12" />az du vest gein, vet nisht eng zain dain trit,</para>
  <para style="q" vid="PRO 4:12">un az du vest loifn, vestu nisht geshtroichlt vern.<verse eid="PRO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13" />halt zich on musar, zolst nisht oplozen,</para>
  <para style="q" vid="PRO 4:13">hit dos op, vorem dos iz dain lebn.<verse eid="PRO 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14" />in shteg fun di reshoim zolstu nisht kumen,</para>
  <para style="q" vid="PRO 4:14">un nisht tretn in veg fun di shlechte.<verse eid="PRO 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15" />maid im ois, zolst im nisht farbaigein,</para>
  <para style="q" vid="PRO 4:15">vaich fun im, un gei avek.<verse eid="PRO 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16" />vorem zei kenen nisht shlofn vu zei tuen nisht shlechts,</para>
  <para style="q" vid="PRO 4:16">un zeyer shlof iz geroibt vu zei machn nisht shtroichlen.<verse eid="PRO 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17" />vorem zei shpaizn zich mit shpaiz fun shlechts,</para>
  <para style="q" vid="PRO 4:17">un vain fun roib trinken zei.<verse eid="PRO 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18" />ober der shteg fun di tsadikim iz vi dos licht fun baginen,</para>
  <para style="q" vid="PRO 4:18">vos vert alts lichtiker biz in rechtn tog.<verse eid="PRO 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19" />der veg fun di reshoim iz vi fintsternish,</para>
  <para style="q" vid="PRO 4:19">zei veisn nisht on vos zei veln geshtroichlt vern.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20" />main zun, farnem maine reid,</para>
  <para style="q" vid="PRO 4:20">naig tsu dain oier tsu maine verter.<verse eid="PRO 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21" />zoln zei zich nisht opton fun daine oign;</para>
  <para style="q" vid="PRO 4:21">hit zei in dain hartsn.<verse eid="PRO 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22" />vorem zei zainen lebn far di vos gefinen zei,</para>
  <para style="q" vid="PRO 4:22">un a heilung far zeyer gantsn laib.<verse eid="PRO 4:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23" />mer fun yetveder hitung pas oif dain harts,</para>
  <para style="q" vid="PRO 4:23">vorem fun im zainen di aroisgangen fun lebn.<verse eid="PRO 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24" />tu op fun dir a krum moil,</para>
  <para style="q" vid="PRO 4:24">un farkerte lipn dervaiter fun dir.<verse eid="PRO 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25" />daine oign zoln kukn antkegen,</para>
  <para style="q" vid="PRO 4:25">un daine bremen zoln blikn glaich far dir.<verse eid="PRO 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26" />halt glaich dem shteg fun daine fis,</para>
  <para style="q" vid="PRO 4:26">un ale daine vegen zoln zain richtik.<verse eid="PRO 4:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27" />zolst zich nisht naign rechts oder links,</para>
  <para style="q" vid="PRO 4:27">tu op dain fus fun shlechts.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="PRO 5" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1" />main zun, farnem main chochme,</para>
  <para style="q" vid="PRO 5:1">naig dain oier tsu main farshtandikeit,<verse eid="PRO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2" />kedei zolst ophiten geshaitkeit,</para>
  <para style="q" vid="PRO 5:2">un daine lipn zoln oifpasn kenshaft.<verse eid="PRO 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3" />vorem honikzaft trifn di lipn fun der fremder,</para>
  <para style="q" vid="PRO 5:3">un glater fun boimel iz ir gumen.<verse eid="PRO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4" />ober ir sof iz biter vi vermut,</para>
  <para style="q" vid="PRO 5:4">sharf vi a tsveishnaidike shverd.<verse eid="PRO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5" />ire fis nidern tsum toit,</para>
  <para style="q" vid="PRO 5:5">in Sheol shparn on ire fis.<verse eid="PRO 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6" />kedei zi zol nisht gein dem glaichn veg fun lebn,</para>
  <para style="q" vid="PRO 5:6">voglen ire shtegn, zi veis nisht vuhin.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7" />un atsund, kinder, hert mir tsu,</para>
  <para style="q" vid="PRO 5:7">un ir zolt nisht opkeren fun di verter fun main moil.<verse eid="PRO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8" />dervaiter fun ir dain veg,</para>
  <para style="q" vid="PRO 5:8">un zolst nisht genenen tsum aingang fun ir hoiz,<verse eid="PRO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9" />kedei zolst nisht gebn tsu andere dain frishkeit,</para>
  <para style="q" vid="PRO 5:9">un daine yorn tsu an achzer;<verse eid="PRO 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10" />kedei fremde zoln zich nisht zetn mit dain kraft,</para>
  <para style="q" vid="PRO 5:10">un dain mi zol nisht onkumen in hoiz fun a vildfremdn;<verse eid="PRO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11" />un vest brumen in dain sof,</para>
  <para style="q" vid="PRO 5:11">ven dain laib un dain fleish vet zain farlendt,<verse eid="PRO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12" />un vest zogn: vi hob ich faint gehat musar,</para>
  <para style="q" vid="PRO 5:12">un shtrof hot faracht main harts,<verse eid="PRO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13" />un ich hob nisht tsugehert dem kol fun maine vegvaizer,</para>
  <para style="q" vid="PRO 5:13">un tsu maine lerer nisht tsugenaigt main oier!<verse eid="PRO 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14" />nor in a kleinkeit hob ich geven in ale shlechte zachn</para>
  <para style="q" vid="PRO 5:14">in der ainzamlung un eide.<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15" />trink vaser fun dain grub,</para>
  <para style="q" vid="PRO 5:15">un loifiks fun dain brunem.<verse eid="PRO 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16" />daine kvaln veln zich tseshpreitn deroisn,</para>
  <para style="q" vid="PRO 5:16">in di gasn – di bechn vaser.<verse eid="PRO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17" />dir alein veln zei gehern,</para>
  <para style="q" vid="PRO 5:17">un nisht tsu fremde mit dir.<verse eid="PRO 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18" />zol dain kval zain gebentsht,</para>
  <para style="q" vid="PRO 5:18">un frei zich mit der vaib fun dain yugnt.<verse eid="PRO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19" />di libleche hindin, un di chenevdike hirshin,</para>
  <para style="q" vid="PRO 5:19">ire brist zoln dich zetn in ale tsaitn,</para>
  <para style="q" vid="PRO 5:19">un tsu ir libshaft zolstu zain ibergegebn tamid.<verse eid="PRO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20" />un noch vos, main zun, zolstu zich opgebn mit a fremder,</para>
  <para style="q" vid="PRO 5:20">un arumnemen dem buzem fun an anderer?<verse eid="PRO 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21" />vorem far Hashems oign zainen di vegen fun a mentshn,</para>
  <para style="q" vid="PRO 5:21">un ale zaine shtegn leigt er ois.<verse eid="PRO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22" />zaine eigene zind batsvingen dem roshe,</para>
  <para style="q" vid="PRO 5:22">un in di shtrik fun zain chet vert er farhaltn.<verse eid="PRO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23" />er shtarbt on musar;</para>
  <para style="q" vid="PRO 5:23">un durch zain grois narishkeit vert er farblondzhet.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="PRO 6" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1" />main zun, oib du bist orev geven far dain chever,</para>
  <para style="q" vid="PRO 6:1">gegebn dain hant far a fremdn,<verse eid="PRO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2" />bistu gechapt in di verter fun dain moil,</para>
  <para style="q" vid="PRO 6:2">bistu gefangen in di verter fun dain moil.<verse eid="PRO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3" />tu dos den, main zun, un ver nitsl,</para>
  <para style="q" vid="PRO 6:3">az du bist araingefaln in dain chavers hant:</para>
  <para style="q" vid="PRO 6:3">gei, vorf zich anider, un shtei-tsu tsu dain chever.<verse eid="PRO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4" />zolst nisht gebn kein shlof tsu daine oign,</para>
  <para style="q" vid="PRO 6:4">un kein shlumer tsu daine bremen.<verse eid="PRO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5" />zai dich matsl vi a hirsh ois der hant,</para>
  <para style="q" vid="PRO 6:5">un vi a foigel fun fangers hant.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6" />gei tsu der murazhke, du foiler,</para>
  <para style="q" vid="PRO 6:6">ze ire vegen, un ver klug;<verse eid="PRO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7" />hagam zi hot nisht kein har,</para>
  <para style="q" vid="PRO 6:7">kein oifzeer un kein geveltiker,<verse eid="PRO 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8" />greit zi on um zumer ir broit,</para>
  <para style="q" vid="PRO 6:8">hot zi ongeklibn in shnittsait ir shpaiz.<verse eid="PRO 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9" />biz vanen, du foiler, vestu lign?</para>
  <para style="q" vid="PRO 6:9">ven vestu oifshtein fun dain shlof?<verse eid="PRO 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10" />noch a bisel shlof, noch a bisel dremlen,</para>
  <para style="q" vid="PRO 6:10">noch a bisel lign mit farleigte hent;<verse eid="PRO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11" />un kumen vi a gei-cheil vet dain orimkeit,</para>
  <para style="q" vid="PRO 6:11">un dain noit vi a gepantserter man.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12" />a nidertrechtiker mentsh, a man fun umrecht,</para>
  <para style="q" vid="PRO 6:12">iz der vos geit um mit a krumen moil,<verse eid="PRO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13" />vos vinkt mit zaine oign, vos shart mit zaine fis,</para>
  <para style="q" vid="PRO 6:13">vos taitlt mit zaine finger.<verse eid="PRO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14" />farkertkeit iz in zain hartsn,</para>
  <para style="q" vid="PRO 6:14">er tracht beiz in yetveder tsait,</para>
  <para style="q" vid="PRO 6:14">krig macht er on.<verse eid="PRO 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15" />derum vet plutsling kumen zain umglik,</para>
  <para style="q" vid="PRO 6:15">plutsem vet er tsebrochn vern az kein heilung vet nisht zain.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16" />zeks zainen di vos Hashem hot faint,</para>
  <para style="q" vid="PRO 6:16">un zibn di umverdikeit fun zain zel:<verse eid="PRO 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17" />hoferdike oign, a lignerishe tsung,</para>
  <para style="q" vid="PRO 6:17">un hent vos fargisen umshuldik blut;<verse eid="PRO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18" />a harts vos tracht machshoves fun umrecht;</para>
  <para style="q" vid="PRO 6:18">fis vos ailn tsu loifn tsum beizn;<verse eid="PRO 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19" />a falsher eides vos otemt mit ligns,</para>
  <para style="q" vid="PRO 6:19">un der vos macht on krig tsvishn brider.<verse eid="PRO 6:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20" />hit, main zun, dos gebot fun dain foter,</para>
  <para style="q" vid="PRO 6:20">un zolst nisht farlozen di ler fun dain muter.<verse eid="PRO 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21" />bind zei oif dain hartsn tamid,</para>
  <para style="q" vid="PRO 6:21">knip zei oif dain haldz.<verse eid="PRO 6:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22" />az du vest gein, vet es dich firn,</para>
  <para style="q" vid="PRO 6:22">az du vest zich leign, vet es dich hitn,</para>
  <para style="q" vid="PRO 6:22">un az du vest zich oifchapn, vet es redn tsu dir.<verse eid="PRO 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23" />vorem dos gebot iz a licht, un di lernung a lichtikeit,</para>
  <para style="q" vid="PRO 6:23">un der veg fun lebn zainen shtrofreid fun musar;<verse eid="PRO 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24" />dich tsu hitn fun der shlechter vaibsparshoin,</para>
  <para style="q" vid="PRO 6:24">fun der glater tsung fun der fremder.<verse eid="PRO 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25" />zolst nisht glustn ir sheinkeit in dain hartsn,</para>
  <para style="q" vid="PRO 6:25">un zol zi dich nisht nemen mit ire bremen.<verse eid="PRO 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26" />vorem iber a zoine kumt men biz a lebl broit,</para>
  <para style="q" vid="PRO 6:26">un an eshet-ish fangt di taierste zel.<verse eid="PRO 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27" />ken a mentsh sharn koiln in zain buzem,</para>
  <para style="q" vid="PRO 6:27">un zaine begadim zoln zich nisht ontsindn?<verse eid="PRO 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28" />tsi ken a mentsh gein oif koiln,</para>
  <para style="q" vid="PRO 6:28">un zaine fis zoln nisht ongebrent vern?<verse eid="PRO 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29" />azoi iz der vos kumt tsu zain chavers vaib,</para>
  <para style="q" vid="PRO 6:29">keiner vos rirt zi on, kumt nisht op glat.<verse eid="PRO 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30" />me ken nisht farachten dem ganev az er ganvet,</para>
  <para style="q" vid="PRO 6:30">ontsufiln zain laib ven er iz hungerik.<verse eid="PRO 6:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31" />ober az er vert gefunen, batsolt er zibn mol azoi fil;</para>
  <para style="q" vid="PRO 6:31">dem gantsn farmeg fun zain hoiz muz er avekgebn.<verse eid="PRO 6:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32" />der vos iz mizane mit a froi, iz on seichel,</para>
  <para style="q" vid="PRO 6:32">zich alein brengt um der vos tut dos.<verse eid="PRO 6:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33" />shleg un shand vet er krign,</para>
  <para style="q" vid="PRO 6:33">un zain charpe vet nisht opgemekt vern.<verse eid="PRO 6:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34" />vorem eiferzucht iz der grimtsorn fun a man,</para>
  <para style="q" vid="PRO 6:34">un er vet nisht shoinen in tog fun nekome.<verse eid="PRO 6:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35" />er vet nisht achten kein oisleizgelt,</para>
  <para style="q" vid="PRO 6:35">un nisht bavilikn, vi du zolst mern shochad.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="PRO 7" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1" />main zun, hit maine verter,</para>
  <para style="q" vid="PRO 7:1">un maine gebot zolstu bahaltn bai dir.<verse eid="PRO 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2" />hit maine gebot, kedei zolst lebn,</para>
  <para style="q" vid="PRO 7:2">un main lernung, vi dem shvartsapl fun daine oign.<verse eid="PRO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3" />bind zei on oif daine finger,</para>
  <para style="q" vid="PRO 7:3">shraib zei on oif dem tovl fun dain hartsn.<verse eid="PRO 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4" />zog tsu der chochme: du bist main shvester;</para>
  <para style="q" vid="PRO 7:4">un farshtandikeit zolstu rufn fraint;<verse eid="PRO 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5" />kedei zei zoln dich bahitn fun der fremder froi,</para>
  <para style="q" vid="PRO 7:5">fun der umbakenter vos macht glat ire reid.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6" />vorem durchn fentster fun main hoiz,</para>
  <para style="q" vid="PRO 7:6">durch main fortke hob ich aroisgekukt;<verse eid="PRO 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7" />un ich hob gezen tsvishn di narn,</para>
  <para style="q" vid="PRO 7:7">gemerkt tsvishn di yungelait,</para>
  <para style="q" vid="PRO 7:7">a yung on seichel,<verse eid="PRO 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8" />vi er geit farbai in gas lebn ir vinkel,</para>
  <para style="q" vid="PRO 7:8">un shpraizt oifn veg tsu ir hoiz,<verse eid="PRO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9" />farnacht in ovnt fun tog,</para>
  <para style="q" vid="PRO 7:9">in tifer nacht un fintsternish.<verse eid="PRO 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10" />ersht a froi kumt im on antkegen,</para>
  <para style="q" vid="PRO 7:10">mit dem ontu fun a zoine,</para>
  <para style="q" vid="PRO 7:10">un mit a bahaltenem hartsn.<verse eid="PRO 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11" />roishik iz zi un oisgelasn,</para>
  <para style="q" vid="PRO 7:11">ire fis ruen nisht in ir hoiz.<verse eid="PRO 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12" />a mol in gas, a mol oif di merk,</para>
  <para style="q" vid="PRO 7:12">un bai ale ekn tut zi loiern.<verse eid="PRO 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13" />un zi nemt im on, un zi kusht im,</para>
  <para style="q" vid="PRO 7:13">zi farshait ir ponem un zogt tsu im:<verse eid="PRO 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14" />zibachei Shalemim hob ich oif mir,</para>
  <para style="q" vid="PRO 7:14">haint batsol ich maine nedrim.<verse eid="PRO 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15" />derum bin ich arois dir antkegen,</para>
  <para style="q" vid="PRO 7:15">tsu zuchn dain ponem, un ich hob dich gefunen.<verse eid="PRO 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16" />mit dekn hob ich ibergedekt main bet,</para>
  <para style="q" vid="PRO 7:16">mit geshtraifte geshpinsn fun Mitsrayim.<verse eid="PRO 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17" />ich hob bashpritst main geleger</para>
  <para style="q" vid="PRO 7:17">mit mire, aloe, un tsimering.<verse eid="PRO 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18" />kum, lomir zich zetn mit libe bizn frimorgn,</para>
  <para style="q" vid="PRO 7:18">lomir zich kvikn mit libshaft.<verse eid="PRO 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19" />vorem main man iz nishto in der heim,</para>
  <para style="q" vid="PRO 7:19">er iz avek oif a vaitn veg.<verse eid="PRO 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20" />dos baitl gelt hot er mitgenumen mit zich,</para>
  <para style="q" vid="PRO 7:20">in tog fun halbn choidesh vet er kumen aheim.<verse eid="PRO 7:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21" />zi tsit im mit ir fil ainredenish,</para>
  <para style="q" vid="PRO 7:21">mit ire glate lipn farfirt zi im.<verse eid="PRO 7:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22" />er geit ir noch bald,</para>
  <para style="q" vid="PRO 7:22">vi an oks vos geit tsu der shechite,</para>
  <para style="q" vid="PRO 7:22">un vi oif a keit tsu der shtrof fun dem narn.<verse eid="PRO 7:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23" />biz a fail shpalt durch zain leber;</para>
  <para style="q" vid="PRO 7:23">vi a foigel ailt tsu der nets,</para>
  <para style="q" vid="PRO 7:23">un veis nisht az es iz um ir lebn.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24" />un atsund, kinder, hert mir tsu,</para>
  <para style="q" vid="PRO 7:24">un farnemt di verter fun main moil.<verse eid="PRO 7:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25" />zol nisht opkeren tsu ire vegen dain harts,</para>
  <para style="q" vid="PRO 7:25">zolst nisht farblondzhen in ire shtegn.<verse eid="PRO 7:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26" />vorem a sach dershlogene hot zi avekgeleigt,</para>
  <para style="q" vid="PRO 7:26">un fil zainen ire derhrgete.<verse eid="PRO 7:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27" />vegen tsu der Sheol iz ir hoiz,</para>
  <para style="q" vid="PRO 7:27">zei nidern in di kamern fun toit.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="PRO 8" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1" />far vor, di chochme ruft,</para>
  <para style="q" vid="PRO 8:1">un farshtandikeit lozt arois ir kol.<verse eid="PRO 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2" />oifn shpits fun di hoiche erter baim veg,</para>
  <para style="q" vid="PRO 8:2">baim tsunoifkum fun shtegn, hot zi zich geshtelt;<verse eid="PRO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3" />lebn di toiern, baim aingang fun shtot,</para>
  <para style="q" vid="PRO 8:3">baim arainkum in di tirn shrait zi ois:<verse eid="PRO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4" />tsu aich, mener, ruf ich,</para>
  <para style="q" vid="PRO 8:4">un main kol iz tsu di mentshnkinder.<verse eid="PRO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5" />ir farnarte, farshteit klugshaft,</para>
  <para style="q" vid="PRO 8:5">un ir narn, krigt a farshtandik harts!<verse eid="PRO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6" />hert tsu, vorem gehoibns vel ich redn,</para>
  <para style="q" vid="PRO 8:6">un di efenung fun maine lipn vet zain di richtikeit.<verse eid="PRO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7" />vorem main gumen vet redn emes,</para>
  <para style="q" vid="PRO 8:7">un shlechts iz di umverdikeit fun maine lipn.<verse eid="PRO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8" />mit gerechtikeit zainen ale verter fun main moil</para>
  <para style="q" vid="PRO 8:8">nishto in zei fardreits un krums.<verse eid="PRO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9" />zei ale zainen klor faran farshtandikn,</para>
  <para style="q" vid="PRO 8:9">un rechtfartik far di vos gefinen kenshaft.<verse eid="PRO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10" />nemt main musar, un nisht zilber,</para>
  <para style="q" vid="PRO 8:10">un kenshaft eider geklibnste gold.<verse eid="PRO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11" />vorem chochme iz beser fun perl,</para>
  <para style="q" vid="PRO 8:11">un kein cheftsim zainen nisht glaich tsu ir.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12" />ich chochme voin mit geshaitkeit,</para>
  <para style="q" vid="PRO 8:12">un kenshaft fun ainfaln tu ich gefinen.<verse eid="PRO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13" />moire far Hashem iz faint hobn shlechts;</para>
  <para style="q" vid="PRO 8:13">hoferdikeit un gaive, un dem veg fun shlechts,</para>
  <para style="q" vid="PRO 8:13">un a moil mit farkertkeit hob ich faint.<verse eid="PRO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14" />ich hob etsut un brihshaft,</para>
  <para style="q" vid="PRO 8:14">ich bin farshtandikeit, gevure iz main.<verse eid="PRO 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15" />durch mir kinign mlochim,</para>
  <para style="q" vid="PRO 8:15">un firshtn machn gerechte gezetsn.<verse eid="PRO 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16" />durch mir hershn di hersher,</para>
  <para style="q" vid="PRO 8:16">un di adllait – ale richter fun der erd.<verse eid="PRO 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17" />ich hob lib maine libhober,</para>
  <para style="q" vid="PRO 8:17">un maine zucher gefinen mich.<verse eid="PRO 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18" />eshires un koved zainen bai mir,</para>
  <para style="q" vid="PRO 8:18">grois guts un tsedoke.<verse eid="PRO 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19" />main frucht iz beser fun gold un fun gingold,</para>
  <para style="q" vid="PRO 8:19">un main ainkum fun geklibnstn zilber.<verse eid="PRO 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20" />in dem veg fun rechtfartikeit gei ich,</para>
  <para style="q" vid="PRO 8:20">in di shtegn fun gerechtikeit;<verse eid="PRO 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21" />tsu machn arben maine libhober guts,</para>
  <para style="q" vid="PRO 8:21">un zeyere shatskamern zol ich onfiln.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22" />Hashem hot mich farmogt in onheib fun zain veg,</para>
  <para style="q" vid="PRO 8:22">eider er hot bashafn zaine meisim.<verse eid="PRO 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23" />fun eibik on bin ich gefuremt,</para>
  <para style="q" vid="PRO 8:23">fun onheib, fun eider di erd iz geven.<verse eid="PRO 8:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24" />ven di tehomen zainen noch nisht geven</para>
  <para style="q" vid="PRO 8:24">bin ich geborn gevorn,</para>
  <para style="q" vid="PRO 8:24">ven nisht geven noch kein kvaln mit vaser balodn.<verse eid="PRO 8:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25" />eider di berg zainen araingezetst gevorn,</para>
  <para style="q" vid="PRO 8:25">far di heichn, bin ich geborn gevorn;<verse eid="PRO 8:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26" />ven er hot noch nisht gehat gemacht erd un felder,</para>
  <para style="q" vid="PRO 8:26">un di ershte shtoibn fun der velt.<verse eid="PRO 8:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27" />ven er hot tsugegreit di himlen, bin ich geven derbai;</para>
  <para style="q" vid="PRO 8:27">ven er hot getseichnt a tsirkl oifn gezicht fun tehom;<verse eid="PRO 8:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28" />ven er hot bafestikt di volkens fun oiben,</para>
  <para style="q" vid="PRO 8:28">ven er hot baveltikt di kvaln fun tehom,<verse eid="PRO 8:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29" />ven er hot geshtelt dem yam zain gezets,</para>
  <para style="q" vid="PRO 8:29">az di vasern zoln nisht aribergein zain rand,</para>
  <para style="q" vid="PRO 8:29">ven er hot bashtimt di gruntfestn fun der erd,<verse eid="PRO 8:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30" />demolt bin ich geven bai im,</para>
  <para style="q" vid="PRO 8:30">vi a meister Baal arbeter,</para>
  <para style="q" vid="PRO 8:30">un ich bin geven ale tog far zain tenug,</para>
  <para style="q" vid="PRO 8:30">freyen zich shtendik far im,<verse eid="PRO 8:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31" />zich geshpilt oif zain erdisher velt,</para>
  <para style="q" vid="PRO 8:31">un main freid gehat bai di mentshnkinder.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32" />un atsund, kinder, hert mir tsu,</para>
  <para style="q" vid="PRO 8:32">un voil tsu di vos hitn maine vegen.<verse eid="PRO 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33" />hert tsu musar, un vert klug,</para>
  <para style="q" vid="PRO 8:33">un ir zolt nisht farvildert vern.<verse eid="PRO 8:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34" />voil tsu dem mentshn vos hert mir tsu,</para>
  <para style="q" vid="PRO 8:34">tsu vachn bai maine tirn togteglech,</para>
  <para style="q" vid="PRO 8:34">tsu hitn di baishtidlen fun maine aingangen!<verse eid="PRO 8:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35" />vorem der vos gefint mich, gefint lebn,</para>
  <para style="q" vid="PRO 8:35">un krigt bavilikung fun Hashem.<verse eid="PRO 8:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36" />un der vos farfelt mich, baroibt zich alein,</para>
  <para style="q" vid="PRO 8:36">ale vos hobn mich faint hobn lib dem toit.<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="PRO 9" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1" />chochme hot oifgeboit ir hoiz,</para>
  <para style="q" vid="PRO 9:1">oisgehakt ire zibn zailn.<verse eid="PRO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2" />zi hot geshochtn ir shechtung,</para>
  <para style="q" vid="PRO 9:2">gemisht ir vain, oich gegreit ir tish.<verse eid="PRO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3" />zi shikt ire meidlech, zi ruft</para>
  <para style="q" vid="PRO 9:3">oif di hoiche erter fun shtot:<verse eid="PRO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4" />ver es iz a nor zol farkern aher;</para>
  <para style="q" vid="PRO 9:4">vu einer on seichel zogt zi tsu im:<verse eid="PRO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5" />kumt est fun main broit,</para>
  <para style="q" vid="PRO 9:5">un trinkt fun dem vain vos ich hob gemisht.<verse eid="PRO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6" />farlozt narishkeitn, kedei ir zolt lebn,</para>
  <para style="q" vid="PRO 9:6">un tret in veg fun farshtandikeit.<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7" />der vos musert dem shpeter nemt zich shand,</para>
  <para style="q" vid="PRO 9:7">un der vos shtroft dem roshe – tadl oif zich.<verse eid="PRO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8" />zolst nisht shtrofn dem shpeter, vorem er vet dich faint krign,</para>
  <para style="q" vid="PRO 9:8">shtrof dem klugn, un er vet dich lib krign.<verse eid="PRO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9" />gib dem klugn, un er vet noch kliger vern,</para>
  <para style="q" vid="PRO 9:9">lern dem gerechtn, un er vet mern lernung. –<verse eid="PRO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10" />der onheib fun chochme iz moire far Hashem,</para>
  <para style="q" vid="PRO 9:10">un di derkenung fun dem heilikn iz farshtandikeit.<verse eid="PRO 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11" />vorem durch mir veln gemert vern daine teg,</para>
  <para style="q" vid="PRO 9:11">un yorn fun lebn vet men dir tsuleigen.<verse eid="PRO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12" />oib du bist klug, bistu klug far zich,</para>
  <para style="q" vid="PRO 9:12">un bistu a shpeter, vestu alein laidn.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13" />di vaibsparshoin narishkeit liaremt;</para>
  <para style="q" vid="PRO 9:13">loiter laichtzinikeit un veis gornisht.<verse eid="PRO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14" />un zi zitst baim aingang fun ir hoiz,</para>
  <para style="q" vid="PRO 9:14">oif a shtul oif di hoiche erter fun shtot,<verse eid="PRO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15" />tsu rufn di farbaigeyer</para>
  <para style="q" vid="PRO 9:15">vos geyen oif zeyere glaiche vegen:<verse eid="PRO 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16" />ver es iz a nor zol farkern aher;</para>
  <para style="q" vid="PRO 9:16">un vu einer on seichel zogt zi tsu im:<verse eid="PRO 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17" />gegnvet vaser iz zis,</para>
  <para style="q" vid="PRO 9:17">un farborgen broit iz geshmak.<verse eid="PRO 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18" />un er veis nisht az meisim zainen dortn,</para>
  <para style="q" vid="PRO 9:18">in di tifenishn fun Sheol zainen ire gest.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" pubnumber="י" sid="PRO 10" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />di shprichverter fun Shlomoen.</para>
  <para style="b" vid="PRO 10:1" />
  <para style="q" vid="PRO 10:1">a zun a chochem derfreit zain foter,</para>
  <para style="q" vid="PRO 10:1">un a zun a nor iz der kumer fun zain muter.<verse eid="PRO 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2" />umgerechte oitseres nutsn nisht,</para>
  <para style="q" vid="PRO 10:2">ober gerechtikeit iz matsl fun toit.<verse eid="PRO 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3" />Hashem lozt nisht farhungern dem laib fun dem tsadik,</para>
  <para style="q" vid="PRO 10:3">un di gerikeit fun di reshoim farshtoist er.<verse eid="PRO 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4" />orim iz der vos arbet mit an opgelozter hant,</para>
  <para style="q" vid="PRO 10:4">un di hant fun di fleisike vert raich.<verse eid="PRO 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5" />a kluger zun zamlt um zumer,</para>
  <para style="q" vid="PRO 10:5">a zun a toigenichts shloft in shnittsait.<verse eid="PRO 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6" />broches oifn kop iz der tsadik;</para>
  <para style="q" vid="PRO 10:6">un dos moil fun di reshoim farshpreit umrecht.<verse eid="PRO 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7" />di dermonung fun tsadik iz a bentshung,</para>
  <para style="q" vid="PRO 10:7">un der nomen fun di reshoim vert farfoilt.<verse eid="PRO 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8" />der klughartsiker nemt on bafeln,</para>
  <para style="q" vid="PRO 10:8">un der lipnnar vert geshtroichlt.<verse eid="PRO 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9" />der vos geit mit erlechkeit geit in zicherkeit,</para>
  <para style="q" vid="PRO 10:9">un der vos fardreit zaine vegen vert ongelernt.<verse eid="PRO 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10" />der vos vinkt mitn oig shaft fardros,</para>
  <para style="q" vid="PRO 10:10">un der lipnnar vert geshtroichlt.<verse eid="PRO 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11" />dos moil fun dem tsadik iz a kval fun lebn,</para>
  <para style="q" vid="PRO 10:11">un dos moil fun di reshoim farshpreit umrecht.<verse eid="PRO 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12" />sine vekt oif krig,</para>
  <para style="q" vid="PRO 10:12">un oif ale farbrechn fardekt libshaft.<verse eid="PRO 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13" />oif di lipn fun dem farshtandikn</para>
  <para style="q" vid="PRO 10:13">gefint zich chochme,</para>
  <para style="q" vid="PRO 10:13">un a rut faran rukn</para>
  <para style="q" vid="PRO 10:13">fun dem vos on seichel.<verse eid="PRO 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14" />chachomim bahaltn di kenshaft,</para>
  <para style="q" vid="PRO 10:14">ober dos moil fun di narn iz a nonter broch.<verse eid="PRO 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15" />der farmeg fun dem oysher iz zain bafestike shtot,</para>
  <para style="q" vid="PRO 10:15">der broch fun di orime lait iz zeyer dlut.<verse eid="PRO 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16" />der loin fun dem tsadik iz lebn,</para>
  <para style="q" vid="PRO 10:16">der ainkum fun dem roshe iz zind.<verse eid="PRO 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17" />oifn veg fun lebn iz der vos acht oif musar,</para>
  <para style="q" vid="PRO 10:17">un der vos farlozt shtrofreid farblondzhet.<verse eid="PRO 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18" />der vos fardekt sine mit falshe lipn,</para>
  <para style="q" vid="PRO 10:18">un der vos farshpreit rechiles, er iz a nor.<verse eid="PRO 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19" />bai fil verter ken nisht oisgemitn vern zind,</para>
  <para style="q" vid="PRO 10:19">un der vos kargt zaine lipn iz a kluger.<verse eid="PRO 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20" />geklibnste zilber iz di tsung fun dem tsadik,</para>
  <para style="q" vid="PRO 10:20">der seichel fun di reshoim iz vintsik vos vert.<verse eid="PRO 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21" />di lipn fun di tsadikim shpaizn a sach,</para>
  <para style="q" vid="PRO 10:21">ober di narn shtarbn vail zei felt seichel.<verse eid="PRO 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22" />di broche fun Hashem, zi macht raich,</para>
  <para style="q" vid="PRO 10:22">me darf tsu mol nisht tsuleigen mi derbai.<verse eid="PRO 10:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23" />vi a shpilchl iz baim narn ton a nevole,</para>
  <para style="q" vid="PRO 10:23">un a chochme – bai a mentshn mit seichel.<verse eid="PRO 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24" />di shrekenish fun dem roshe, zi vet kumen oif im,</para>
  <para style="q" vid="PRO 10:24">un dem bager fun di tsadikim vet men gebn.<verse eid="PRO 10:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25" />vi a shturem geit ariber, azoi iz der roshe nishto,</para>
  <para style="q" vid="PRO 10:25">ober der tsadik iz an eibiker gruntfest.<verse eid="PRO 10:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26" />vi esik far di tsein, un vi roich far di oign,</para>
  <para style="q" vid="PRO 10:26">azoi iz der foiler far di vos shikn im.<verse eid="PRO 10:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27" />moire far Hashem leigt tsu teg,</para>
  <para style="q" vid="PRO 10:27">un di yorn fun di reshoim vern gekirtst.<verse eid="PRO 10:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28" />di vartenish fun di tsadikim lozt zich ois in freid,</para>
  <para style="q" vid="PRO 10:28">un di hofenung fun di reshoim vet untergein.<verse eid="PRO 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29" />a bashitsung far erlechkeit iz der veg fun Hashem,</para>
  <para style="q" vid="PRO 10:29">ober a broch far di vos tuen umrecht.<verse eid="PRO 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30" />der tsadik vet zich kein mol nisht oisglitshn,</para>
  <para style="q" vid="PRO 10:30">ober di reshoim veln nisht blaibn in land.<verse eid="PRO 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31" />dos moil fun dem tsadik shprotst mit chochme,</para>
  <para style="q" vid="PRO 10:31">un di farkerte tsung vert farshnitn.<verse eid="PRO 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32" />di lipn fun dem tsadik veisn gutvilikeit,</para>
  <para style="q" vid="PRO 10:32">un dos moil fun di reshoim – farkertkeit.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="PRO 11" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1" />falshe vogsholn zainen di umverdikeit fun Hashem,</para>
  <para style="q" vid="PRO 11:1">un a ful gevicht iz zain rotsn.<verse eid="PRO 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2" />kumt mutvilikeit, kumt shand,</para>
  <para style="q" vid="PRO 11:2">ober bai di shtile iz chochme.<verse eid="PRO 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3" />di erlechkeit fun di rechtfartikn vet zei firn,</para>
  <para style="q" vid="PRO 11:3">un di fardreitkeit fun di felsher vet zei farvistn.<verse eid="PRO 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4" />farmeg nutst nisht in tog fun tsorn,</para>
  <para style="q" vid="PRO 11:4">ober gerechtikeit iz matsl fun toit.<verse eid="PRO 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5" />di gerechtikeit fun dem erlechn vet glaich machn zain veg,</para>
  <para style="q" vid="PRO 11:5">un durch zain shlechtikeit vet faln der shlechter.<verse eid="PRO 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6" />di gerechtikeit fun di rechtfartikn iz zei matsl,</para>
  <para style="q" vid="PRO 11:6">un in zeyere gerikeit vern di felsher batsvungen.<verse eid="PRO 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7" />az a shlechter mentsh shtarbt, geit unter zain hofenung,</para>
  <para style="q" vid="PRO 11:7">un der oiskuk fun di taּkifim geit unter.<verse eid="PRO 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8" />der tsadik vert aroisgetsoign fun a tsore,</para>
  <para style="q" vid="PRO 11:8">un der roshe kumt on oif zain ort.<verse eid="PRO 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9" />mitn moil vil der zindiker umbrengen zain chever,</para>
  <para style="q" vid="PRO 11:9">ober durch farshtandikeit vern di tsadikim derleizt.<verse eid="PRO 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10" />az di tsadikim iz gut, freit zich di shtot,</para>
  <para style="q" vid="PRO 11:10">un az di reshoim geyen unter iz a gezang.<verse eid="PRO 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11" />durch der broche fun di rechtfartikn vert a shtot derhoibn,</para>
  <para style="q" vid="PRO 11:11">un durch dem moil fun di reshoim vert zi tseshtert.<verse eid="PRO 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12" />mevaze zain chever, iz der vos on seichel,</para>
  <para style="q" vid="PRO 11:12">ober a mentsh mit farshtandikeit farshvaigt.<verse eid="PRO 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13" />der rechiles-traiber zogt ois a sod,</para>
  <para style="q" vid="PRO 11:13">ober der vos hot a trai gemit fardekt a zach.<verse eid="PRO 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14" />on a firung falt a folk,</para>
  <para style="q" vid="PRO 11:14">un hilf iz durch fil yoetsim.<verse eid="PRO 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15" />shlecht shnaidt men op az me iz orev far a fremdn,</para>
  <para style="q" vid="PRO 11:15">ober der vos hot faint gutzogenish iz zicher.<verse eid="PRO 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16" />a bachente froi krigt koved,</para>
  <para style="q" vid="PRO 11:16">un shtarke krign eshires.<verse eid="PRO 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17" />zich alein tut guts der genodiker mentsh,</para>
  <para style="q" vid="PRO 11:17">un zain eigen laib farumglikt der achzer.<verse eid="PRO 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18" />der roshe fardint falshn loin,</para>
  <para style="q" vid="PRO 11:18">ober der vos zeit gerechtikeit – emesn Sachar.<verse eid="PRO 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19" />feste gerechtikeit firt tsum lebn,</para>
  <para style="q" vid="PRO 11:19">un der vos yogt zich noch beiz, yogt zich noch zain toit.<verse eid="PRO 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20" />an umverdikeit bai Hashem zainen krumhartsike,</para>
  <para style="q" vid="PRO 11:20">un zain rotsn, di vos zeyer veg iz erlech.<verse eid="PRO 11:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21" />na dir main hant!</para>
  <para style="q" vid="PRO 11:21">dem shlechtn vet nisht geshonken vern,</para>
  <para style="q" vid="PRO 11:21">ober der zomen fun di tsadikim vert antrunen.<verse eid="PRO 11:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22" />a gilderner nozring oifn noz fun a chazir,</para>
  <para style="q" vid="PRO 11:22">iz a froi vos iz shein nor opgeton fun seichel.<verse eid="PRO 11:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23" />der bager fun di tsadikim iz rak gut,</para>
  <para style="q" vid="PRO 11:23">di hofenung fun di reshoim iz chutspe.<verse eid="PRO 11:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24" />faran der vos tseteilt, un es kumt noch tsu,</para>
  <para style="q" vid="PRO 11:24">un der vos kargt mer vi me darf, bloiz tsu farminerung.<verse eid="PRO 11:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25" />a fraigebike zel vert fet,</para>
  <para style="q" vid="PRO 11:25">un der vos zet on, vert er oich gezet.<verse eid="PRO 11:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26" />der vos halt tsurik tvue, im shilt dos folk,</para>
  <para style="q" vid="PRO 11:26">ober a broche oifn kop fun dem vos farkoift.<verse eid="PRO 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27" />der vos zucht guts, zucht gutvilikeit,</para>
  <para style="q" vid="PRO 11:27">un der vos iz oisn beiz, vet es im onkumen.<verse eid="PRO 11:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28" />der vos farzichert zich oif zain eshires, er vet faln,</para>
  <para style="q" vid="PRO 11:28">un vi a blat veln shprotsn di tsadikim.<verse eid="PRO 11:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29" />der vos farumglikt zain hoiz, vet arben vint;</para>
  <para style="q" vid="PRO 11:29">un der nor iz a knecht baim klughartsikn.<verse eid="PRO 11:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30" />di frucht fun dem tsadik iz a boim fun lebn,</para>
  <para style="q" vid="PRO 11:30">un der vos gevinen nefoshes iz a chochem.<verse eid="PRO 11:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31" />ze, der tsadik krigt batsolt oif der erd,</para>
  <para style="q" vid="PRO 11:31">haint vi shoin der roshe un der zindiker!<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="PRO 12" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1" />der vos hot lib visen, hot lib musar,</para>
  <para style="q" vid="PRO 12:1">ober der fargrebter hot faint shtrof.<verse eid="PRO 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2" />der guter krigt bavilikung fun Hashem,</para>
  <para style="q" vid="PRO 12:2">ober dem man mit beize gedanken farmishpet er.<verse eid="PRO 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3" />kein mentsh ken nisht bashtein durch shlechts,</para>
  <para style="q" vid="PRO 12:3">ober der vortsel fun di tsadikim rirt zich nisht.<verse eid="PRO 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4" />an eshet-cheil iz di kroin fun ir man,</para>
  <para style="q" vid="PRO 12:4">un vi a foilung in zaine beiner iz a toigenichts.<verse eid="PRO 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5" />di machshoves fun di tsadikim zainen gerechtikeit,</para>
  <para style="q" vid="PRO 12:5">di tachbulos fun di reshoim zainen batrug.<verse eid="PRO 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6" />di reid fun di reshoim zainen tsu loiern oif blut,</para>
  <para style="q" vid="PRO 12:6">ober dos moil fun di rechtfartikn iz zei matsl.<verse eid="PRO 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7" />di reshoim vern ibergekert, un zei zainen nishto,</para>
  <para style="q" vid="PRO 12:7">ober dos hoiz fun di tsadikim vet bashtein.<verse eid="PRO 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8" />vedlik zain seichel vert a mentsh geloibt,</para>
  <para style="q" vid="PRO 12:8">un der vos hot a fardreit harts, vert tsu shpot.<verse eid="PRO 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9" />beser der vos iz gringgeshatst un hot a knecht,</para>
  <para style="q" vid="PRO 12:9">eider der vos shtelt zich far a nichbad, un im felt broit.<verse eid="PRO 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10" />der gerechter kimert zich um dem lebn fun zain beheime,</para>
  <para style="q" vid="PRO 12:10">un dos harts fun di reshoim iz umderbaremdik.<verse eid="PRO 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11" />der vos baarbet zain erd, hot broit tsu zat,</para>
  <para style="q" vid="PRO 12:11">un der vos yogt zich noch puste zachn, iz on seichel.<verse eid="PRO 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12" />der roshe glust dos gefang fun di shlechte,</para>
  <para style="q" vid="PRO 12:12">ober der vortsel fun di tsadikim brengt ain.<verse eid="PRO 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13" />in a farze fun di lipn iz a shtroichlung faran shlechtn,</para>
  <para style="q" vid="PRO 12:13">ober der tsadik kumt arois fun a tsore.<verse eid="PRO 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14" />fun der frucht fun mentshns moil vet er zich zetn mit guts,</para>
  <para style="q" vid="PRO 12:14">un di tuung fun a mentshns hent vet men im umkeren.<verse eid="PRO 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15" />der veg fun dem narn iz glaich in zaine oign,</para>
  <para style="q" vid="PRO 12:15">ober der chochem hert tsu an eitse.<verse eid="PRO 12:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16" />dem narns ergernish vert bakant in eigenem tog,</para>
  <para style="q" vid="PRO 12:16">ober der kluger fardekt di shand.<verse eid="PRO 12:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17" />der vos otemt mit emes, vet dervaizn di richtikeit,</para>
  <para style="q" vid="PRO 12:17">ober der falsher eides iz an opnar.<verse eid="PRO 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18" />faran der vos plaplt vi shtech fun a shverd,</para>
  <para style="q" vid="PRO 12:18">ober di tsung fun di kluge iz a heilung.<verse eid="PRO 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19" />di lip fun emes vet bashtein oif eibik,</para>
  <para style="q" vid="PRO 12:19">ober oif a rege iz di tsung fun lign.<verse eid="PRO 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20" />opgenart vert dos harts fun di vos trachtn beiz,</para>
  <para style="q" vid="PRO 12:20">ober bai di vos barotn frid, iz a freid.<verse eid="PRO 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21" />dem tsadik vet nisht ainfaln kein shum umrecht,</para>
  <para style="q" vid="PRO 12:21">ober di reshoim zainen ful mit beiz.<verse eid="PRO 12:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22" />an umverdikeit bai Hashem zainen lignerishe lipn,</para>
  <para style="q" vid="PRO 12:22">un zain rotsn, di vos bageyen zich vorhaftik.<verse eid="PRO 12:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23" />a kluger mentsh fardekt di kenshaft,</para>
  <para style="q" vid="PRO 12:23">ober dos harts fun di narn ruft ois di tipshes.<verse eid="PRO 12:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24" />di hant fun di fleisike vet geveltikn,</para>
  <para style="q" vid="PRO 12:24">un di opgelozte vet vern tsu tsindz.<verse eid="PRO 12:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25" />iz do a zorg in emitsns hartsn, zol men zi fardrikn,</para>
  <para style="q" vid="PRO 12:25">vorem a gut vort macht zi freilech.<verse eid="PRO 12:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26" />der tsadik gefint ois fun zain chever,</para>
  <para style="q" vid="PRO 12:26">un der veg fun di reshoim farfirt zei.<verse eid="PRO 12:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27" />der opgelozter vet nisht chapn zain fang,</para>
  <para style="q" vid="PRO 12:27">un dos taierste guts fun a mentshn iz flaisik zain.<verse eid="PRO 12:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28" />in dem shteg fun gerechtikeit iz lebn,</para>
  <para style="q" vid="PRO 12:28">un oifn shliach fun ir veg iz nishto kein toit.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="PRO 13" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1" />a kluger zun lozt zich musar fun foter,</para>
  <para style="q" vid="PRO 13:1">ober der shpeter vil nisht hern a beizer.<verse eid="PRO 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2" />fun der frucht fun zain moil est a mentsh guts,</para>
  <para style="q" vid="PRO 13:2">ober der bager fun di felsher iz umrecht.<verse eid="PRO 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3" />der vos past oif zain moil, farhit zain zel,</para>
  <para style="q" vid="PRO 13:3">der vos shpart oif zaine lipn, oif im vet zain a broch.<verse eid="PRO 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4" />di zel fun dem foiln gart un hot gornisht,</para>
  <para style="q" vid="PRO 13:4">ober di zel fun di fleisike vet vern fet.<verse eid="PRO 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5" />der tsadik hot faint a falsh vort,</para>
  <para style="q" vid="PRO 13:5">un der roshe firt zich mies un shendlech.<verse eid="PRO 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6" />rechtfartikeit farhit dem vos zain veg iz erlech,</para>
  <para style="q" vid="PRO 13:6">un shlechtikeit fardreit dem zindikn.<verse eid="PRO 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7" />faran der vos shtelt zich raich un hot gornisht,</para>
  <para style="q" vid="PRO 13:7">der vos shtelt zich orim bai a grois farmeg.<verse eid="PRO 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8" />an oisleiz far a mentshns lebn iz zain eshires,</para>
  <para style="q" vid="PRO 13:8">ober der oreman hert tsu mol nisht kein ongeshrei.<verse eid="PRO 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9" />di lichtikeit fun di tsadikim iz freilech,</para>
  <para style="q" vid="PRO 13:9">ober dos licht fun di reshoim lesht zich ois.<verse eid="PRO 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10" />durch mutvilikeit macht men bloiz on krig,</para>
  <para style="q" vid="PRO 13:10">ober bai di iberleigte iz chochme.<verse eid="PRO 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11" />a raichtum fun der luft vert geminert,</para>
  <para style="q" vid="PRO 13:11">ober der vos klaibt bislechvaiz farmert.<verse eid="PRO 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12" />a fartsoigene vartenish macht krank dos harts,</para>
  <para style="q" vid="PRO 13:12">un a boim fun lebn iz a bager vos kumt on.<verse eid="PRO 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13" />der vos faracht dos vort, im vet geshen beiz,</para>
  <para style="q" vid="PRO 13:13">ober der vos hot moire faran gebot, er vet baloint vern.<verse eid="PRO 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14" />di lernung fun dem chochem iz a kval fun lebn,</para>
  <para style="q" vid="PRO 13:14">zich optsukeren fun di netsn fun toit.<verse eid="PRO 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15" />a guter seichel git tsu chein,</para>
  <para style="q" vid="PRO 13:15">ober der veg fun di felsher iz hart.<verse eid="PRO 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16" />yetveder kluger firt zich mit farshtandikeit,</para>
  <para style="q" vid="PRO 13:16">ober der nor shpreit ois di tipshes.<verse eid="PRO 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17" />an umerlecher sheliech vet arainfaln in an umglik,</para>
  <para style="q" vid="PRO 13:17">un a traier geshikter iz a heilung.<verse eid="PRO 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18" />orimkeit un shand hot der vos maidt ois musar,</para>
  <para style="q" vid="PRO 13:18">un der vos acht oif shtrof vet krign koved.<verse eid="PRO 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19" />a gebrochene teive iz voil far der zel,</para>
  <para style="q" vid="PRO 13:19">ober an umverdikeit bai narn iz zich opkeren fun shlechts.<verse eid="PRO 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20" />der vos geit um mit kluge, vet klug vern,</para>
  <para style="q" vid="PRO 13:20">un der vos chavert zich mit narn, vet farumglikt vern.<verse eid="PRO 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21" />di zindike yogt noch dos beiz,</para>
  <para style="q" vid="PRO 13:21">un di tsadikim batsolt men guts.<verse eid="PRO 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22" />der guter lozt yerushe far kinds-kinder,</para>
  <para style="q" vid="PRO 13:22">un bahaltn faran tsadik iz der farmeg fun dem zindikn.<verse eid="PRO 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23" />fil shpaiz brengt der aker fun di orime,</para>
  <para style="q" vid="PRO 13:23">un raichtum vert opgeton durch umgerechtikeit.<verse eid="PRO 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24" />der vos kargt zain rut, hot faint zain zun,</para>
  <para style="q" vid="PRO 13:24">un der vos hot im lib, shtroft musar im batsaitns.<verse eid="PRO 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25" />der tsadik est biz zain laib vert zat,</para>
  <para style="q" vid="PRO 13:25">un dem boich fun di reshoim felt ois.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="PRO 14" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1" />a kluge vaib boit oif ir hoiz,</para>
  <para style="q" vid="PRO 14:1">un a narinte tseshtert es mit ire hent.<verse eid="PRO 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2" />der vos geit in zain rechtfartikeit, hot moire far Hashem,</para>
  <para style="q" vid="PRO 14:2">un der vos zaine vegen zainen fardreit, faracht im.<verse eid="PRO 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3" />in narns moil iz a shtekn far zain gaive,</para>
  <para style="q" vid="PRO 14:3">un di lipn fun di kluge farhitn zei.<verse eid="PRO 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4" />on oksen iz di korite leidik,</para>
  <para style="q" vid="PRO 14:4">un fil tvue iz in koiech fun dem oks.<verse eid="PRO 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5" />a bagloibter eides nart nisht op,</para>
  <para style="q" vid="PRO 14:5">un mit opnarenishn otemt der falsher eides.<verse eid="PRO 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6" />der shpeter zucht chochme un nishto,</para>
  <para style="q" vid="PRO 14:6">un visen iz gring dem farshtandikn.<verse eid="PRO 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7" />gei avek fun a mentshn a nor,</para>
  <para style="q" vid="PRO 14:7">saidn vilst nisht kenen farshtandike lipn.<verse eid="PRO 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8" />di chochme fun dem klugn iz in batrachtn zain veg,</para>
  <para style="q" vid="PRO 14:8">un di tipshes fun dem narn iz in batrug.<verse eid="PRO 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9" />bai di narn iz zind a firshprecher,</para>
  <para style="q" vid="PRO 14:9">un tsvishn di rechtfartikn – gutvilikeit.<verse eid="PRO 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10" />dos harts veis ir eigene biterkeit,</para>
  <para style="q" vid="PRO 14:10">un in ir simche ken zich a fremder nisht mishn.<verse eid="PRO 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11" />dos hoiz fun di reshoim vert fartilikt,</para>
  <para style="q" vid="PRO 14:11">un dos getselt fun di rechtfartikn blit.<verse eid="PRO 14:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12" />faran a veg vos shaint tsu zain rechtfartik far a mentsh,</para>
  <para style="q" vid="PRO 14:12">un zain sof zainen vegen fun toit.<verse eid="PRO 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13" />afile baim lachn tut vei dos harts,</para>
  <para style="q" vid="PRO 14:13">un der sof fun simche iz troier.<verse eid="PRO 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14" />fun zaine vegen vet gezetikt vern der falshhartsiker,</para>
  <para style="q" vid="PRO 14:14">un der guter mentsh fun vos in im.<verse eid="PRO 14:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15" />a nor gloibt altsding,</para>
  <para style="q" vid="PRO 14:15">ober der kluger batracht zain trit.<verse eid="PRO 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16" />der chochem shait zich, un kert zich op fun shlechts,</para>
  <para style="q" vid="PRO 14:16">un der nor nemt zich iber, un iz zicher.<verse eid="PRO 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17" />a gicher kesn bageit narishkeit,</para>
  <para style="q" vid="PRO 14:17">un a mentsh mit beize gedanken vert farhast.<verse eid="PRO 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18" />laichtzinike arben narishkeit,</para>
  <para style="q" vid="PRO 14:18">un kluge bakreinen zich mit kenshaft.<verse eid="PRO 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19" />di shlechte beigen zich far di gute,</para>
  <para style="q" vid="PRO 14:19">un di reshoim far di toiern fun tsadik.<verse eid="PRO 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20" />afile bai zain chever vert farhast der oreman,</para>
  <para style="q" vid="PRO 14:20">un di gute fraint fun oysher zainen fil.<verse eid="PRO 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21" />der vos iz mevaze zain chever, zindikt,</para>
  <para style="q" vid="PRO 14:21">un der vos laitzelikt di gedrikte, az voil iz tsu im!<verse eid="PRO 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22" />far vor, di vos trachtn beiz blondzhen,</para>
  <para style="q" vid="PRO 14:22">un genod un traishaft far di vos trachtn guts.<verse eid="PRO 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23" />in yetveder onshtreng iz do a nuts,</para>
  <para style="q" vid="PRO 14:23">ober lipngereid iz bloiz tsum shodn.<verse eid="PRO 14:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24" />a kroin far di chachomim iz zeyer eshires,</para>
  <para style="q" vid="PRO 14:24">di tipshes fun di narn blaibt tipshes.<verse eid="PRO 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25" />an emeser eides ratevet nefoshes,</para>
  <para style="q" vid="PRO 14:25">ober der vos otemt mit ligns iz an opnar.<verse eid="PRO 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26" />in moire far Hashem iz a shtarker bitochen,</para>
  <para style="q" vid="PRO 14:26">un far di kinder vet es zain a bashitsung.<verse eid="PRO 14:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27" />moire far Hashem iz a kval fun lebn,</para>
  <para style="q" vid="PRO 14:27">zich optsukeren fun di netsn fun toit.<verse eid="PRO 14:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28" />in fil folk iz di pracht fun dem melech,</para>
  <para style="q" vid="PRO 14:28">un on folk iz a broch faran firsht.<verse eid="PRO 14:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29" />der vos iz aingehaltn in tsorn,</para>
  <para style="q" vid="PRO 14:29">hot grois farshtandikeit,</para>
  <para style="q" vid="PRO 14:29">un der vos hot a kurts gemit,</para>
  <para style="q" vid="PRO 14:29">klaibt oif narishkeit.<verse eid="PRO 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30" />a gezunt faran laib iz a gelasn harts,</para>
  <para style="q" vid="PRO 14:30">un a foilung in di beiner iz kine.<verse eid="PRO 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31" />der vos drikt dem oreman, lestert zain Bashefer,</para>
  <para style="q" vid="PRO 14:31">un der vos derbaremt zich oifn evyon, git im koved.<verse eid="PRO 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32" />in zain umglik vert geshtoisn der roshe,</para>
  <para style="q" vid="PRO 14:32">ober der tsadik iz bashitst biz in zain toit.<verse eid="PRO 14:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33" />in hartsn fun farshtandikn rut di chochme,</para>
  <para style="q" vid="PRO 14:33">ober vos ineveinik bai di narn vert bakant.<verse eid="PRO 14:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34" />gerechtikeit derheibt a folk,</para>
  <para style="q" vid="PRO 14:34">un zind iz di shand fun umes.<verse eid="PRO 14:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35" />dem melechs gutvilikeit iz tsum klugn knecht,</para>
  <para style="q" vid="PRO 14:35">un zain grimtsorn vet zain oifn toigenichts.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="PRO 15" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1" />a veicher entfer halt op tsorn,</para>
  <para style="q" vid="PRO 15:1">un a fardrosik vort brengt oif kaas.<verse eid="PRO 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2" />di tsung fun di kluge iz voilkenevdik,</para>
  <para style="q" vid="PRO 15:2">un dos moil fun narn gavert tipshes.<verse eid="PRO 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3" />in yetveder ort zainen di oign fun Hashem,</para>
  <para style="q" vid="PRO 15:3">zei zeen di shlechte un di gute.<verse eid="PRO 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4" />a milde tsung iz a boim fun lebn,</para>
  <para style="q" vid="PRO 15:4">un falshkeit oif ir iz a broch faran gaist.<verse eid="PRO 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5" />der nor faracht zain foters musar,</para>
  <para style="q" vid="PRO 15:5">un der vos acht oif shtrof iz geshait.<verse eid="PRO 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6" />in hoiz fun dem tsadik iz grois raichtum,</para>
  <para style="q" vid="PRO 15:6">un in ainkum fun roshe iz a tsore.<verse eid="PRO 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7" />di lipn fun di kluge farshpreitn kenshaft,</para>
  <para style="q" vid="PRO 15:7">un der seichel fun di narn – nisht richtiks.<verse eid="PRO 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8" />dos shlachtopfer fun di reshoim iz an umverdikeit bai Hashem,</para>
  <para style="q" vid="PRO 15:8">un di tfile fun rechtfartikn iz zain rotsn.<verse eid="PRO 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9" />an umverdikeit bai Hashem iz der veg fun dem roshe,</para>
  <para style="q" vid="PRO 15:9">un dem vos yogt zich noch gerechtikeit hot er lib.<verse eid="PRO 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10" />a beize shtrof iz far dem vos farlozt dem veg,</para>
  <para style="q" vid="PRO 15:10">der vos hot faint musar vet shtarbn.<verse eid="PRO 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11" />di Sheol un der opgrunt zainen far Hashem,</para>
  <para style="q" vid="PRO 15:11">haint vi shoin di hertser fun di mentshnkinder!<verse eid="PRO 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12" />der shpeter hot nisht lib me zol im shtrofn,</para>
  <para style="q" vid="PRO 15:12">er vil nisht gein tsu chachomim.<verse eid="PRO 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13" />a freilech harts muntert oif dem ponem,</para>
  <para style="q" vid="PRO 15:13">un fun hartsklemenish vert dos gemit dershlogn.<verse eid="PRO 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14" />dos harts fun dem farshtandikn zucht kenshaft,</para>
  <para style="q" vid="PRO 15:14">un dos moil fun di narn fitert zich oif tipshes.<verse eid="PRO 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15" />ale teg fun dem oreman zainen shlechte,</para>
  <para style="q" vid="PRO 15:15">ober bai dem vos hot a freilech harts iz tamid a sude.<verse eid="PRO 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16" />beser vintsik mit moire far Hashem,</para>
  <para style="q" vid="PRO 15:16">eider a groiser oitser mit tsetumltkeit derbai.<verse eid="PRO 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17" />beser a moltsait fun grins vu libshaft iz do,</para>
  <para style="q" vid="PRO 15:17">eider a geshtopter oks mit sine derbai.<verse eid="PRO 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18" />a kesn macht on shtrait,</para>
  <para style="q" vid="PRO 15:18">un an aingehaltener in tsorn shtilt ein krig.<verse eid="PRO 15:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19" />der veg fun dem foiln iz vi fartsamt mit derner,</para>
  <para style="q" vid="PRO 15:19">ober der shteg fun dem rechtfartikn iz oisgeglaicht.<verse eid="PRO 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20" />a kluger zun derfreit dem foter,</para>
  <para style="q" vid="PRO 15:20">un a narisher mentsh iz mevaze zain muter.<verse eid="PRO 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21" />narishkeit iz a freid bai dem vos felt seichel,</para>
  <para style="q" vid="PRO 15:21">ober a mentsh mit farshtandikeit geit glaich.<verse eid="PRO 15:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22" />on barot vern trachtungen farshtert,</para>
  <para style="q" vid="PRO 15:22">un durch fil yoetsim kumen zei tsu shtand.<verse eid="PRO 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23" />a mentsh hot freid fun dem entfer fun zain moil,</para>
  <para style="q" vid="PRO 15:23">un a vort in der tsait – vi gut dos iz!<verse eid="PRO 15:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24" />der veg fun lebn iz aroif tsu faran klugn,</para>
  <para style="q" vid="PRO 15:24">kedei zich optsukeren fun der Sheol unten.<verse eid="PRO 15:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25" />dos hoiz fun di shtoltse raist Hashem ois,</para>
  <para style="q" vid="PRO 15:25">un er shtelt oif dem grenets fun der almone.<verse eid="PRO 15:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26" />an umverdikeit bai Hashem zainen machshoves fun beiz,</para>
  <para style="q" vid="PRO 15:26">un rein bai im zainen verter fun liblechkeit.<verse eid="PRO 15:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27" />zain hoiz farumglikt der vos iz gaitsik noch gevin,</para>
  <para style="q" vid="PRO 15:27">un der vos hot faint matonus vet lebn.<verse eid="PRO 15:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28" />dos harts fun dem tsadik klert-noch tsu entfern,</para>
  <para style="q" vid="PRO 15:28">un dos moil fun reshoim gavert beizenishn.<verse eid="PRO 15:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29" />vait iz Hashem fun reshoim,</para>
  <para style="q" vid="PRO 15:29">ober di tfile fun tsadikim hert er.<verse eid="PRO 15:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30" />a licht in di oign iz der vos derfreit dos harts,</para>
  <para style="q" vid="PRO 15:30">a gute besoire macht fet dos gebein.<verse eid="PRO 15:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31" />dos oier vos hert tsu dem musar fun lebn,</para>
  <para style="q" vid="PRO 15:31">vet tsvishn di chachomim ruen.<verse eid="PRO 15:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32" />der vos maidt ois musar, faracht zain zel,</para>
  <para style="q" vid="PRO 15:32">un der vos hert tsu shtrof, krigt seichel.<verse eid="PRO 15:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33" />moire far Hashem iz di musar fun chochme,</para>
  <para style="q" vid="PRO 15:33">un far koved kumt anives.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="PRO 16" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1" />dem mentshns zainen di tsugreitenishn fun hartsn,</para>
  <para style="q" vid="PRO 16:1">ober fun Hashem iz der entfer fun der tsung.<verse eid="PRO 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2" />ale vegen fun a mentshn zainen rein in zaine oign,</para>
  <para style="q" vid="PRO 16:2">ober Hashem forsht di gaister.<verse eid="PRO 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3" />leig aroif daine tuungen oif Hashem,</para>
  <para style="q" vid="PRO 16:3">un daine machshoves veln tsu shtand kumen.<verse eid="PRO 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4" />alts hot Hashem gemacht far zain tsvek,</para>
  <para style="q" vid="PRO 16:4">un oich dem roshe faran tog fun beiz.<verse eid="PRO 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5" />an umverdikeit bai Hashem iz itlecher</para>
  <para style="q" vid="PRO 16:5">vos hot a hoferdik harts;</para>
  <para style="q" vid="PRO 16:5">na dir main hant! im vet nisht geshonken vern.<verse eid="PRO 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6" />durch genod un emes vert zind fargebn,</para>
  <para style="q" vid="PRO 16:6">un durch moire far Hashem kert men zich op fun shlechts.<verse eid="PRO 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7" />az Hashem bavilikt di vegen fun a mentshn,</para>
  <para style="q" vid="PRO 16:7">macht er afile zaine faint sholem mit im.<verse eid="PRO 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8" />beser vintsik durch gerechtikeit,</para>
  <para style="q" vid="PRO 16:8">eider fil hchnosut durch umrecht.<verse eid="PRO 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9" />dem mentshns harts denkt zain veg,</para>
  <para style="q" vid="PRO 16:9">ober Hashem lenkt zain trit.<verse eid="PRO 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10" />a kishef iz oifn melechs lipn,</para>
  <para style="q" vid="PRO 16:10">zain moil felsht nisht baim mishpot.<verse eid="PRO 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11" />richtike vog un vogsholn zainen fun Hashem,</para>
  <para style="q" vid="PRO 16:11">zain verk zainen ale vogshteiner fun baitl.<verse eid="PRO 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12" />an umverdikeit bai mlochim iz ton shlechts,</para>
  <para style="q" vid="PRO 16:12">vorem durch gerechtikeit bashteit der tron.<verse eid="PRO 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13" />der rotsn fun mlochim iz oif richtike lipn,</para>
  <para style="q" vid="PRO 16:13">un dem vos redt di richtikeit hobn zei lib.<verse eid="PRO 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14" />der grimtsorn fun melech iz a malach-hmut,</para>
  <para style="q" vid="PRO 16:14">ober a kluger man shtilt im ain.<verse eid="PRO 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15" />in shain fun melechs ponem iz lebn,</para>
  <para style="q" vid="PRO 16:15">un zain gutvilikeit iz vi a volken fun shpetregn.<verse eid="PRO 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16" />vi beser zich aintsukoifn chochme eider gold!</para>
  <para style="q" vid="PRO 16:16">un zich aintsukoifn seichel iz bilcher vi zilber.<verse eid="PRO 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17" />der shteg fun di rechtfartikn</para>
  <para style="q" vid="PRO 16:17">iz zich optsukeren fun shlechts,</para>
  <para style="q" vid="PRO 16:17">der vos hit zain zel, past oif zain veg.<verse eid="PRO 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18" />far a broch kumt shtolts,</para>
  <para style="q" vid="PRO 16:18">un far an aniderfal, a hoferdik gemit.<verse eid="PRO 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19" />beser a niderik gemit tsvishn di basheidene,</para>
  <para style="q" vid="PRO 16:19">eider teiln roib mit di shtoltse.<verse eid="PRO 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20" />der vos acht oif dem vort, vet gefinen guts,</para>
  <para style="q" vid="PRO 16:20">un der vos farzichert zich oif Hashem, az voil iz tsu im!<verse eid="PRO 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21" />mitn klughartsikn treft zich der farshtandiker,</para>
  <para style="q" vid="PRO 16:21">un ziskeit fun di lipn mert lernung.<verse eid="PRO 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22" />seichel iz a kval fun lebn far dem vos hot es,</para>
  <para style="q" vid="PRO 16:22">un narishkeit iz a shtrof faran narn.<verse eid="PRO 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23" />dos harts fun dem chochem macht klug zain moil,</para>
  <para style="q" vid="PRO 16:23">un mert lernung oif zaine lipn.<verse eid="PRO 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24" />honikzaft zainen libleche reid,</para>
  <para style="q" vid="PRO 16:24">zis far der zel, un a heilung faran gebein.<verse eid="PRO 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25" />faran a veg vos iz glaich baim mentshn,</para>
  <para style="q" vid="PRO 16:25">un zain sof zainen vegen fun toit.<verse eid="PRO 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26" />der hunger fun arbeter arbet in im,</para>
  <para style="q" vid="PRO 16:26">vorem zain moil traibt im on.<verse eid="PRO 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27" />der nidertrechtiker mentsh grobt ois beiz,</para>
  <para style="q" vid="PRO 16:27">un oif zain lip iz vi a brandfaier.<verse eid="PRO 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28" />der mentsh fun farkertkeit macht on krig,</para>
  <para style="q" vid="PRO 16:28">un der unterhetser tsesheidt gute fraint.<verse eid="PRO 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29" />der man fun umrecht redt on zain chever,</para>
  <para style="q" vid="PRO 16:29">un firt im oifn nisht gutn veg.<verse eid="PRO 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30" />der vos drikt-tsu di oign,</para>
  <para style="q" vid="PRO 16:30">iz dos oistsuklern farkertkeit;</para>
  <para style="q" vid="PRO 16:30">der vos baist di lipn, vil oisfirn shlechts.<verse eid="PRO 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31" />a sheine kroin iz a groer kop;</para>
  <para style="q" vid="PRO 16:31">oifn veg fun gerechtikeit vert zi gefunen.<verse eid="PRO 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32" />beser an aingehaltener in tsorn</para>
  <para style="q" vid="PRO 16:32">eider a gibor,</para>
  <para style="q" vid="PRO 16:32">un der vos geveltikt iber zain gemit,</para>
  <para style="q" vid="PRO 16:32">eider der vos batsvingt a shtot.<verse eid="PRO 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33" />in shoim vorft men dem goirl,</para>
  <para style="q" vid="PRO 16:33">ober fun Hashem iz zain yetveder basheid.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="PRO 17" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1" />beser a trukener bisn un shalve derbai,</para>
  <para style="q" vid="PRO 17:1">eider a hoiz ful mit zevachim un krig dermit.<verse eid="PRO 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2" />a kluger knecht geveltikt iber a zun a toigenichts,</para>
  <para style="q" vid="PRO 17:2">un tsvishn di brider krigt er a chelek yerushe.<verse eid="PRO 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3" />a tigl far zilber, un a shmeltsoivn far gold,</para>
  <para style="q" vid="PRO 17:3">ober di hertser pruvet Hashem.<verse eid="PRO 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4" />der shlechtstuer hert zich ain tsu der lip fun umrecht,</para>
  <para style="q" vid="PRO 17:4">der ligner horcht tsu der tsung fun farbrech.<verse eid="PRO 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5" />der vos shpot fun an oreman, lestert zain Bashefer;</para>
  <para style="q" vid="PRO 17:5">dem vos freit zich oif a broch, vet nisht geshonken vern.<verse eid="PRO 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6" />di kroin fun alte lait zainen kinds-kinder,</para>
  <para style="q" vid="PRO 17:6">un di tsirung fun kinder zainen zeyere eltern.<verse eid="PRO 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7" />dem menuvl past nisht di shprach fun breitkeit,</para>
  <para style="q" vid="PRO 17:7">noch vintsiker dem nadivn di shprach fun lign.<verse eid="PRO 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8" />a chein-diment iz shochad in di oign fun zain Baaln;</para>
  <para style="q" vid="PRO 17:8">vuhin nor me kert zich dermit baglikt men.<verse eid="PRO 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9" />der vos zucht libshaft, fardekt oif zind,</para>
  <para style="q" vid="PRO 17:9">un der vos chazert iber gereid, tsesheidt gute fraint.<verse eid="PRO 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10" />a beizer virkt mer oifn farshtandikn,</para>
  <para style="q" vid="PRO 17:10">vi hundert klep oifn narn.<verse eid="PRO 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11" />rak der vidershpeniker zucht beiz,</para>
  <para style="q" vid="PRO 17:11">ober an umderbaremdiker sheliech vet ongeshikt vern oif im.<verse eid="PRO 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12" />beser a mentshn zol ontrefn a berinte baroibt fun ire yunge,</para>
  <para style="q" vid="PRO 17:12">abi nisht a nor mit zain tipshes.<verse eid="PRO 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13" />der vos kert um a roeh far a toive,</para>
  <para style="q" vid="PRO 17:13">vet zich nisht opton beiz fun zain hoiz.<verse eid="PRO 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14" />vi me lozt loiz vaser iz der onheib fun mchlukut,</para>
  <para style="q" vid="PRO 17:14">derum, eider der krig brecht ois, loz op.<verse eid="PRO 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15" />der vos macht gerecht dem shuldikn, un der vos macht</para>
  <para style="q" vid="PRO 17:15">shuldik dem gerechtn,</para>
  <para style="q" vid="PRO 17:15">zei beide zainen an umverdikeit bai Hashem.<verse eid="PRO 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16" />vos toig gelt in dem narns hant oif tsu koifn chochme,</para>
  <para style="q" vid="PRO 17:16">az kein seichel iz nishto?<verse eid="PRO 17:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17" />in ale tsaitn iz a chever a guter fraint,</para>
  <para style="q" vid="PRO 17:17">ober far a tsore iz a bruder geborn.<verse eid="PRO 17:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18" />a mentsh on seichel iz der vos git a hant,</para>
  <para style="q" vid="PRO 17:18">vos iz orev an eorvut far zain chever.<verse eid="PRO 17:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19" />der vos hot lib krig, hot lib farbrech,</para>
  <para style="q" vid="PRO 17:19">der vos macht hoich zain tir, zucht a broch.<verse eid="PRO 17:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20" />der vos hot a krum harts, vet nisht gefinen kein guts,</para>
  <para style="q" vid="PRO 17:20">un der vos dreit mit der tsung, vet arainfaln in beiz.<verse eid="PRO 17:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21" />der vos gebert a narn, iz dos tsu zain kumer,</para>
  <para style="q" vid="PRO 17:21">un der foter fun dem nidertrechtikn hot nisht kein Nachat.<verse eid="PRO 17:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22" />a freilech harts iz a gute refue,</para>
  <para style="q" vid="PRO 17:22">un a dershlogn gemit triknt ois dos gebein.<verse eid="PRO 17:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23" />der roshe nemt on shochad oisn buzem,</para>
  <para style="q" vid="PRO 17:23">tsu fardreyen di vegen fun gerechtikeit.<verse eid="PRO 17:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24" />faran ponem fun farshtandikn iz di chochme,</para>
  <para style="q" vid="PRO 17:24">un di oign fun dem narn zainen in ek velt.<verse eid="PRO 17:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25" />an ergernish far zain foter iz a zun a nor,</para>
  <para style="q" vid="PRO 17:25">un a biternish far zain gevinerin.<verse eid="PRO 17:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26" />kein guts kumt nisht arois fun shtrofn oich dem tsadik,</para>
  <para style="q" vid="PRO 17:26">fun shlogn adllait far rechtfartikeit.<verse eid="PRO 17:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27" />der vos veis kenshaft, kargt zaine verter,</para>
  <para style="q" vid="PRO 17:27">a mentsh mit farshtandikeit iz shporevdik in gemit.<verse eid="PRO 17:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28" />afile a nor az er shvaigt vert gerechnt a chochem;</para>
  <para style="q" vid="PRO 17:28">der vos macht tsu zaine lipn, a farshtandiker.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="PRO 18" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1" />der vos sheidt zich op, iz oisn zain viln;</para>
  <para style="q" vid="PRO 18:1">bai yetveder barot vil er zich aroisvaizn.<verse eid="PRO 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2" />der nor vil nisht farshtandikeit,</para>
  <para style="q" vid="PRO 18:2">nor az zain seichel zol antplekt vern.<verse eid="PRO 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3" />az der roshe kumt, kumt oich farachtung,</para>
  <para style="q" vid="PRO 18:3">un mit shendlechkeit – shpot.<verse eid="PRO 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4" />tife vasern zainen di verter fun a mentshns moil,</para>
  <para style="q" vid="PRO 18:4">a kveliker taich iz der brunem fun chochme.<verse eid="PRO 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5" />kein guts kumt nisht arois fun shaneven dem roshe,</para>
  <para style="q" vid="PRO 18:5">kedei tsu krivden dem gerechtn baim mishpot.<verse eid="PRO 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6" />di lipn fun dem narn kumen mit krig,</para>
  <para style="q" vid="PRO 18:6">un zain moil ruft tsu geshleg.<verse eid="PRO 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7" />dos moil fun dem narn iz a broch far im,</para>
  <para style="q" vid="PRO 18:7">un zaine lipn zainen a nets far zain zel.<verse eid="PRO 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8" />di verter fun dem unterhetser zainen vi geshmake bisns,</para>
  <para style="q" vid="PRO 18:8">un zei nidern in di kamern fun laib.<verse eid="PRO 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9" />oich der vos iz opgelozt in zain arbet,</para>
  <para style="q" vid="PRO 18:9">iz a bruder tsu a man an oisbrenger.<verse eid="PRO 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10" />a shtarker turem iz der nomen fun Hashem,</para>
  <para style="q" vid="PRO 18:10">tsu im loift der tsadik un vert bashitst.<verse eid="PRO 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11" />der farmeg fun dem oysher iz zain bafestikte shtot,</para>
  <para style="q" vid="PRO 18:11">un vi in a hoicher moier iz er in zain ainbildenish.<verse eid="PRO 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12" />far a broch vert hoferdik dem mentshns harts,</para>
  <para style="q" vid="PRO 18:12">un far koved kumt anives.<verse eid="PRO 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13" />der vos entfert a zach eider er hot oisgehert,</para>
  <para style="q" vid="PRO 18:13">iz dos fun im a narishkeit un a shand.<verse eid="PRO 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14" />a mentshns gemit ken oishaltn zain krankshaft,</para>
  <para style="q" vid="PRO 18:14">ober a dershlogn gemit, ver ken es aribertrogn?<verse eid="PRO 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15" />dos harts fun dem farshtandikn koift zich ain kenshaft,</para>
  <para style="q" vid="PRO 18:15">un dos oier fun di kluge zucht kenshaft.<verse eid="PRO 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16" />a mentshns matone macht far im a vare,</para>
  <para style="q" vid="PRO 18:16">un zi brengt im far groise lait.<verse eid="PRO 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17" />gerecht iz der ershter in zain taine,</para>
  <para style="q" vid="PRO 18:17">ober zain chever kumt un forsht im ois.<verse eid="PRO 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18" />der goirl macht oifhern krig,</para>
  <para style="q" vid="PRO 18:18">un tsvishn di shtraiter tsesheidt er.<verse eid="PRO 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19" />a gekrivdetn bruder iz shverer tsu gevinen</para>
  <para style="q" vid="PRO 18:19">vi a bafestikte shtot,</para>
  <para style="q" vid="PRO 18:19">un krig zainen vi riglen fun a palats.<verse eid="PRO 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20" />fun der frucht fun a mentshns moil vet zich zetn zain laib,</para>
  <para style="q" vid="PRO 18:20">fun ainkum fun zaine lipn vet er zich zetn.<verse eid="PRO 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21" />toit un lebn zainen in der macht fun der tsung,</para>
  <para style="q" vid="PRO 18:21">un ire gute fraint veln esen ir frucht.<verse eid="PRO 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22" />der vos hot gefunen a vaib, hot gefunen guts,</para>
  <para style="q" vid="PRO 18:22">un krigt bavilikung fun Hashem.<verse eid="PRO 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23" />tchnunim redt der oreman,</para>
  <para style="q" vid="PRO 18:23">ober der oysher entfert azes.<verse eid="PRO 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24" />faran chaverim oif zich tsu farumglikn</para>
  <para style="q" vid="PRO 18:24">un faran a guter fraint mer tsugeton fun a bruder.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="PRO 19" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1" />beser an oreman vos geit in zain erlechkeit,</para>
  <para style="q" vid="PRO 19:1">eider der vos hot farkrimte lipn, un iz a nor.<verse eid="PRO 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2" />oich, fun zich alein nisht kenen, kumt nisht kein guts,</para>
  <para style="q" vid="PRO 19:2">un der vos ailt mit di fis, zindikt.<verse eid="PRO 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3" />a mentshns narishkeit fardreit zain veg,</para>
  <para style="q" vid="PRO 19:3">un oif Hashem tsernt zain harts.<verse eid="PRO 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4" />raichtum krigt tsu fil gute fraint,</para>
  <para style="q" vid="PRO 19:4">un der oreman vert tsesheidt fun zain gutn fraint.<verse eid="PRO 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5" />a falshn eides vet nisht geshonken vern,</para>
  <para style="q" vid="PRO 19:5">un der vos otemt mit lign, vet nisht antrunen vern.<verse eid="PRO 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6" />fil zuchn di laitzelikeit fun dem nadvn,</para>
  <para style="q" vid="PRO 19:6">un itlecher iz a guter fraint dem geber.<verse eid="PRO 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7" />ale brider fun dem oreman hobn im faint,</para>
  <para style="q" vid="PRO 19:7">un vi shoin dervaitern zich fun im zaine gute fraint!</para>
  <para style="q" vid="PRO 19:7">der vos zei yogt zich arum mit verter</para>
  <para style="q" vid="PRO 19:7">vet er bai zei blaibn nisht.<verse eid="PRO 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8" />der vos koift zich ain seichel, hot lib zain zel,</para>
  <para style="q" vid="PRO 19:8">der vos hit farshtandikeit, vet gefinen guts,<verse eid="PRO 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9" />a falshn eides vet nisht geshonken vern,</para>
  <para style="q" vid="PRO 19:9">un der vos otemt mit ligns, vet untergein.<verse eid="PRO 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10" />tenug past nisht faran narn,</para>
  <para style="q" vid="PRO 19:10">haint vi shoin far a knecht tsu geveltikn iber harn!<verse eid="PRO 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11" />der seichel fun a mentshn iz aintsuhaltn zain tsorn,</para>
  <para style="q" vid="PRO 19:11">un a tsirung far im iz tsu fargebn zind.<verse eid="PRO 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12" />a brum vi fun a yungn leib iz dem melechs tsorn,</para>
  <para style="q" vid="PRO 19:12">un vi toi oifn groz zain gutvilikeit.<verse eid="PRO 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13" />an umglik far zain foter iz a zun a nor;</para>
  <para style="q" vid="PRO 19:13">un vi a nudne trifenish zainen di krig fun a vaib.<verse eid="PRO 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14" />hoiz un guts iz a yerushe fun eltern,</para>
  <para style="q" vid="PRO 19:14">ober a gerotene vaib iz fun Hashem.<verse eid="PRO 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15" />foilkeit vorft on a dreml,</para>
  <para style="q" vid="PRO 19:15">un an opgelozter nefesh vet hungern.<verse eid="PRO 19:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16" />der vos hit dos gebot, hit zain zel,</para>
  <para style="q" vid="PRO 19:16">der vos farvarlozt zaine vegen, vet shtarbn.<verse eid="PRO 19:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17" />der vos shenkt dem oreman, antlait Hashem,</para>
  <para style="q" vid="PRO 19:17">un zain toive vet er im umkeren.<verse eid="PRO 19:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18" />shtrof dain zun, ven es iz noch do a hofenung,</para>
  <para style="q" vid="PRO 19:18">ober zolst zich nisht onleign im umtsubrengen.<verse eid="PRO 19:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19" />a mentsh fun grois tsorn vet trogn zaine shtrof,</para>
  <para style="q" vid="PRO 19:19">ober ven du vest im ein mol matsl zain, azoi vest du es muzn mer ton.<verse eid="PRO 19:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20" />hertsu an eitse, un nem on musar,</para>
  <para style="q" vid="PRO 19:20">kedei du zolst klug zain in dain sof.<verse eid="PRO 19:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21" />fil machshoves zainen in mentshns hartsn,</para>
  <para style="q" vid="PRO 19:21">ober Hashems barot, er vet bashtein.<verse eid="PRO 19:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22" />vos iz bagert in a mentsh iz zain genod;</para>
  <para style="q" vid="PRO 19:22">un beser an oreman eider a kzvn.<verse eid="PRO 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23" />moire far Hashem firt tsum lebn,</para>
  <para style="q" vid="PRO 19:23">un me blaibt zat,</para>
  <para style="q" vid="PRO 19:23">un vert nisht geshtroft mit kein beiz.<verse eid="PRO 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24" />az der foiler shtekt arain zain hant in shisel,</para>
  <para style="q" vid="PRO 19:24">vil er zi tsu mol nisht tsutrogn tsu zain moil.<verse eid="PRO 19:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25" />shlogstu dem shpeter, vert der nor geshait,</para>
  <para style="q" vid="PRO 19:25">un musert men dem farshtendikn, lernt er visen.<verse eid="PRO 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26" />a zun vos brengt shand un charpe,</para>
  <para style="q" vid="PRO 19:26">farvist zain foter, fartraibt zain muter.<verse eid="PRO 19:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27" />main zun, her oif tsu hern dem musar,</para>
  <para style="q" vid="PRO 19:27">un du vest zich farblondzhen fun di verter fun visnshaft.<verse eid="PRO 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28" />gerechtikeit shpot fun dem nidertrechtikn eides,</para>
  <para style="q" vid="PRO 19:28">un falshkeit tsemisht dos moil fun di reshoim.<verse eid="PRO 19:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29" />ongebreit far di shpeter zainen shtrofn,</para>
  <para style="q" vid="PRO 19:29">un klep faran rukn fun di narn.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="PRO 20" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1" />a shpeter iz der vain, a liaremer der trank,</para>
  <para style="q" vid="PRO 20:1">un itlecher vos git zich op dermit, iz nisht kein chochem.<verse eid="PRO 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2" />a brum vi fun a yungn leib iz dem melechs eime,</para>
  <para style="q" vid="PRO 20:2">der vos dertsernt im farzindikt zain lebn.<verse eid="PRO 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3" />a koved far a mentshn iz zich optsuhaltn fun krig,</para>
  <para style="q" vid="PRO 20:3">ober itlecher nor brecht arois.<verse eid="PRO 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4" />der foiler akert nisht um vinter,</para>
  <para style="q" vid="PRO 20:4">un in shnittsait betlt er, un hot gornisht.<verse eid="PRO 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5" />a tifer vaser iz der main in a mentshns harts,</para>
  <para style="q" vid="PRO 20:5">ober a mentsh mit farshtandikeit shept im arois.<verse eid="PRO 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6" />dos rov mentshn rufn ois itlecher zain gintsikeit,</para>
  <para style="q" vid="PRO 20:6">ober a getraien mentshn ver ken gefinen?<verse eid="PRO 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7" />in zain erlechkeit geit der tsadik;</para>
  <para style="q" vid="PRO 20:7">az voil tsu zaine kinder noch im!<verse eid="PRO 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8" />der melech vos zitst oifn tron fun mishpot,</para>
  <para style="q" vid="PRO 20:8">zipt durch mit zaine oign al dos beiz.<verse eid="PRO 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9" />ver ken zogn: ich hob gelaitert main harts,</para>
  <para style="q" vid="PRO 20:9">ich bin rein fun maine zind?<verse eid="PRO 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10" />tsveyerlei vogshteiner, tsveyerlei mosn,</para>
  <para style="q" vid="PRO 20:10">zei beide zainen an umverdikeit bai Hashem.<verse eid="PRO 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11" />shoin a yingel vert derkent on zaine meisim,</para>
  <para style="q" vid="PRO 20:11">oib rein un oib rechtfartik iz zain ton.<verse eid="PRO 20:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12" />dos oier vos hert, un dos oig vos zet,</para>
  <para style="q" vid="PRO 20:12">zei beide hot Hashem gemacht.<verse eid="PRO 20:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13" />zolst nisht lib hobn shlof, kedei zolst nisht farorimt vern,</para>
  <para style="q" vid="PRO 20:13">halt daine oign ofen, vestu hobn broit tsu zat.<verse eid="PRO 20:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14" />shlecht! shlecht! zogt der kunh,</para>
  <para style="q" vid="PRO 20:14">un geit er avek, dentsmol baremt er zich.<verse eid="PRO 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15" />faran gold un perl a sach,</para>
  <para style="q" vid="PRO 20:15">ober di taierste tsirung zainen lipn mit kenshaft.<verse eid="PRO 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16" />nem tsu zain beged, oib er iz orev geven far an andern,</para>
  <para style="q" vid="PRO 20:16">un nem zain meshkun far der fremder.<verse eid="PRO 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17" />zis iz dem mentshn broit fun falshkeit,</para>
  <para style="q" vid="PRO 20:17">ober dernoch vert zain moil ful mit zhvir.<verse eid="PRO 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18" />gedanken kumen tsu shtand durch an eitse,</para>
  <para style="q" vid="PRO 20:18">un mit tachbulos fir milchome.<verse eid="PRO 20:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19" />a rechiles-traiber antplekt a sod,</para>
  <para style="q" vid="PRO 20:19">un mit dem vos hot ofene lipn zolstu zich nisht mishn.<verse eid="PRO 20:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20" />der vos shilt zain foter un zain muter,</para>
  <para style="q" vid="PRO 20:20">vet zain licht farloshn vern in shtokfintsternish.<verse eid="PRO 20:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21" />a nachle vos kumt on gich in onheib,</para>
  <para style="q" vid="PRO 20:21">vet ir sof zain nisht gebentsht.<verse eid="PRO 20:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22" />zolst nisht zogn: ich vel optsolen shlechts;</para>
  <para style="q" vid="PRO 20:22">hof tsu Hashem, un er vet dich helfn.<verse eid="PRO 20:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23" />an umverdikeit bai Hashem iz tsveyerlei vogshteiner,</para>
  <para style="q" vid="PRO 20:23">un fun falshe vogsholn kumt nisht kein guts.<verse eid="PRO 20:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24" />fun Hashem zainen dem mentshns trit,</para>
  <para style="q" vid="PRO 20:24">un vos farshteit der mentsh zain veg?<verse eid="PRO 20:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25" />a shtroichlung far a mentshn iz zich aroistsuredn: heilik!</para>
  <para style="q" vid="PRO 20:25">un nochn neyder ibertsuklern.<verse eid="PRO 20:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26" />a kluger melech vintshuflt di reshoim,</para>
  <para style="q" vid="PRO 20:26">un er kert oif zei dem dreshrod.<verse eid="PRO 20:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27" />a licht fun Hashem iz dem mentshns neshome,</para>
  <para style="q" vid="PRO 20:27">es zucht-durch ale kamern fun laib.<verse eid="PRO 20:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28" />genod un emes bahitn dem melech,</para>
  <para style="q" vid="PRO 20:28">un er halt-oif mit genod zain tron.<verse eid="PRO 20:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29" />di tsirung fun yungelait iz zeyer koiech,</para>
  <para style="q" vid="PRO 20:29">un di sheinkeit fun zkeinim iz a groer kop.<verse eid="PRO 20:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30" />vundike bailn zainen a laiterung fun beiz,</para>
  <para style="q" vid="PRO 20:30">dos glaichn shlek ineveinik in laib.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="PRO 21" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1" />bechn vaser iz dem melechs harts in Hashems hant,</para>
  <para style="q" vid="PRO 21:1">vuhin nor er vil, naigt er es.<verse eid="PRO 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2" />yetveder veg fun mentshn iz glaich in zaine oign,</para>
  <para style="q" vid="PRO 21:2">ober Hashem forsht di hertser.<verse eid="PRO 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3" />ton gerechtikeit un recht</para>
  <para style="q" vid="PRO 21:3">iz bilcher bai Hashem vi a shlachtopfer.<verse eid="PRO 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4" />hoferdike oign un a shtolts harts</para>
  <para style="q" vid="PRO 21:4">iz der zindiker aker fun di reshoim.<verse eid="PRO 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5" />di gedanken fun fleisikn firn rak tsu shefe,</para>
  <para style="q" vid="PRO 21:5">un itlecher vos iz ailik – rak tsu farminerung.<verse eid="PRO 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6" />oitseres gemacht durch a falsher tsung</para>
  <para style="q" vid="PRO 21:6">zainen avekgeblozener hoich;</para>
  <para style="q" vid="PRO 21:6">di vos zuchn zei zuchn dem toit.<verse eid="PRO 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7" />der roib fun di reshoim shlept zei avek,</para>
  <para style="q" vid="PRO 21:7">vail zei viln nisht ton kein gerechtikeit.<verse eid="PRO 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8" />farkert iz dem mentshns veg un fremd,</para>
  <para style="q" vid="PRO 21:8">ober der reiner, zain ton iz rechtfartik.<verse eid="PRO 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9" />beser voinen oif a vinkel dach,</para>
  <para style="q" vid="PRO 21:9">eider in ein hoiz mit a vaib a krigerin.<verse eid="PRO 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10" />di zel fun dem roshe glust beiz,</para>
  <para style="q" vid="PRO 21:10">zain chever vert nisht gelaitzelikt in zaine oign.<verse eid="PRO 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11" />az me shtroft dem shpeter, vert der nor klug;</para>
  <para style="q" vid="PRO 21:11">un az me lernt dem klugn, krigt er kenshaft.<verse eid="PRO 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12" />az der tsadik hot ainzeenish mitn roshes hoiz,</para>
  <para style="q" vid="PRO 21:12">farfirt er di reshoim tsum beizn.<verse eid="PRO 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13" />der vos farshtopt zain oier far dem oremans geshrei,</para>
  <para style="q" vid="PRO 21:13">vet er oich rufn, un nisht geentfert vern.<verse eid="PRO 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14" />a matone farborgenerheit farbeigt dem kaas,</para>
  <para style="q" vid="PRO 21:14">un shochad in buzem, dem shtarkstn grimtsorn.<verse eid="PRO 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15" />a freid faran tsadik iz ton gerechtikeit,</para>
  <para style="q" vid="PRO 21:15">un a shrek far di vos tuen umrecht.<verse eid="PRO 21:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16" />a mentsh vos blondzhet fun dem veg fun klugshaft,</para>
  <para style="q" vid="PRO 21:16">vet ruen in dem gezeml fun meisim.<verse eid="PRO 21:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17" />der vos hot lib voiltog, vert an oreman,</para>
  <para style="q" vid="PRO 21:17">der vos hot lib vain un eil, vert nisht raich.<verse eid="PRO 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18" />an oisleiz far dem tsadik iz der roshe,</para>
  <para style="q" vid="PRO 21:18">un anshtot di rechtfartikn kumt der felsher.<verse eid="PRO 21:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19" />beser tsu voinen in a midber-land,</para>
  <para style="q" vid="PRO 21:19">eider mit a vaib a krigerin in ergernish.<verse eid="PRO 21:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20" />a glustiker oitser un eil iz in der voinung fun dem chochem,</para>
  <para style="q" vid="PRO 21:20">ober der narisher mentsh shlingt es ain.<verse eid="PRO 21:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21" />der vos yogt zich noch gerechtikeit un genod,</para>
  <para style="q" vid="PRO 21:21">gefint lebn, hatsloche, un koved.<verse eid="PRO 21:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22" />der chochem kumt oif a shtot fun giborim,</para>
  <para style="q" vid="PRO 21:22">un macht nidern ir zichere festung.<verse eid="PRO 21:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23" />der vos hit zain moil un zain tsung,</para>
  <para style="q" vid="PRO 21:23">hit fun tsores zain zel.<verse eid="PRO 21:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24" />der mutviliker baal-gavah, zain nomen iz shpeter –</para>
  <para style="q" vid="PRO 21:24">der vos firt zich mit mutviliker chutspe.<verse eid="PRO 21:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25" />di teive fun dem foiln teit im avek,</para>
  <para style="q" vid="PRO 21:25">vail zaine hent viln nisht arbeten.<verse eid="PRO 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26" />a gantsn tog bagert der geriker,</para>
  <para style="q" vid="PRO 21:26">ober der tsadik git un hert nisht oif.<verse eid="PRO 21:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27" />dos shlachtopfer fun di reshoim iz an umverdikeit,</para>
  <para style="q" vid="PRO 21:27">haint vi noch az me brengt es mit a beizer machshove!<verse eid="PRO 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28" />a falsher eides vert tsemisht,</para>
  <para style="q" vid="PRO 21:28">ober der mentsh vos hot gehert, redt mit festikeit.<verse eid="PRO 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29" />der shlechter mentsh geit mit a farshait ponem,</para>
  <para style="q" vid="PRO 21:29">ober der rechtfariker, er past oif zain veg.<verse eid="PRO 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30" />nishto kein chochme un kein farshtandikeit</para>
  <para style="q" vid="PRO 21:30">un kein eitse akegn Hashem.<verse eid="PRO 21:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31" />der ferd vert tsugegreit far dem tog fun milchome,</para>
  <para style="q" vid="PRO 21:31">ober di yeshue iz fun Hashem.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="PRO 22" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1" />a nomen iz beser fun grois eshires,</para>
  <para style="q" vid="PRO 22:1">a guter chein, fun zilber un fun gold.<verse eid="PRO 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2" />raich un orim shtoisn zich on einander,</para>
  <para style="q" vid="PRO 22:2">ober zei beidn hot Hashem bashafn.<verse eid="PRO 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3" />der kluger zet, un farborgt zich,</para>
  <para style="q" vid="PRO 22:3">un di narn geyen vaiter, un vern geshtroft.<verse eid="PRO 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4" />der loin fun anives – fun moire far Hashem,</para>
  <para style="q" vid="PRO 22:4">iz eshires, un koved, un lebn.<verse eid="PRO 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5" />derner un netsn zainen oifn veg fun dem krumen,</para>
  <para style="q" vid="PRO 22:5">der vos hit zain zel, zol zich dervaitern fun zei.<verse eid="PRO 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6" />geveinen dem yingel oif zain veg;</para>
  <para style="q" vid="PRO 22:6">afile az er vet alt vern, vet er zich nisht opkeren derfun.<verse eid="PRO 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7" />der oysher geveltikt iber di orime,</para>
  <para style="q" vid="PRO 22:7">un der laier iz a knecht baim mlvh.<verse eid="PRO 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8" />der vos zeit umrecht vet shnaidn umglik,</para>
  <para style="q" vid="PRO 22:8">un di rut fun zain chutspe vet farlendt vern.<verse eid="PRO 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9" />der vos hot a gut oig, er vert gebentsht,</para>
  <para style="q" vid="PRO 22:9">vail er git fun zain broit dem oreman.<verse eid="PRO 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10" />traib arois dem shpeter, un krig vet avek,</para>
  <para style="q" vid="PRO 22:10">un shtrait un shand veln oifhern.<verse eid="PRO 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11" />der vos hot lib reinhartsikeit,</para>
  <para style="q" vid="PRO 22:11">vos hot chein oif di lipn, iz der melech zain chever.<verse eid="PRO 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12" />di oign fun Hashem hitn dem farshtandikn,</para>
  <para style="q" vid="PRO 22:12">un er fardreit di reid fun dem felsher.<verse eid="PRO 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13" />der foiler zogt: a leib iz deroisn,</para>
  <para style="q" vid="PRO 22:13">ich vel in gas geharget vern.<verse eid="PRO 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14" />a tife grub iz dos moil fun fremde froien,</para>
  <para style="q" vid="PRO 22:14">der farsholtener fun Hashem falt arain ahin.<verse eid="PRO 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15" />narishkeit iz aingebundn bai dem yingel in hartsn,</para>
  <para style="q" vid="PRO 22:15">di shtrofrut vet zi dervaitern fun im.<verse eid="PRO 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16" />me roibt dem oreman, un bai im mert zich,</para>
  <para style="q" vid="PRO 22:16">me git dem oysher, un es vert bloiz geminert.<verse eid="PRO 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17" />naig tsu dain oier, un her di verter fun di chachomim,</para>
  <para style="q" vid="PRO 22:17">un dain harts zolstu tsuleigen tsu main kenshaft.<verse eid="PRO 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18" />vorem voil vet zain, az du vest zei hitn in dain laib,</para>
  <para style="q" vid="PRO 22:18">az zei veln ale zain ongebreit oif daine lipn.<verse eid="PRO 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19" />kedei dain bitochen zol zain oif Hashem,</para>
  <para style="q" vid="PRO 22:19">hob ich es haint dich gemacht visen, yo dich.<verse eid="PRO 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20" />far vor ich hob dir oifgeshribn draisik verter,</para>
  <para style="q" vid="PRO 22:20">in etsut un kenshaft.<verse eid="PRO 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21" />kedei dich tsu machn visen di richtike verter fun emes,</para>
  <para style="q" vid="PRO 22:21">kedei zolst entfern emese verter di vos hobn dich geshikt.<verse eid="PRO 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22" />zolst nisht bagzlen dem shvachn, vail er iz shvach,</para>
  <para style="q" vid="PRO 22:22">un nisht drikn dem oreman in toier.<verse eid="PRO 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23" />vorem Hashem vet zich onnemen zeyer krig,</para>
  <para style="q" vid="PRO 22:23">un roibn zeyere roiber dos lebn.<verse eid="PRO 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24" />zolst zich nisht Chevron mit a tsorndikn mentshn,</para>
  <para style="q" vid="PRO 22:24">un mit a kesn zolstu nisht tsunoifkumen;<verse eid="PRO 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25" />tomer vestu lernen zaine vegen,</para>
  <para style="q" vid="PRO 22:25">un vest nemen a shtroichlung far dain zel.<verse eid="PRO 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26" />zolst nisht zain fun di vos gibn a hant,</para>
  <para style="q" vid="PRO 22:26">fun di vos zainen orev far choives.<verse eid="PRO 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27" />az du vest nisht hobn tsu batsoln,</para>
  <para style="q" vid="PRO 22:27">noch vos zol men tsunemen dain geleger fun unter dir?<verse eid="PRO 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28" />zolst nisht iberrukn dem grenets fun fartsaitn,</para>
  <para style="q" vid="PRO 22:28">vos daine eltern hobn gemacht.<verse eid="PRO 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29" />zestu a mentshn flink in zain arbet,</para>
  <para style="q" vid="PRO 22:29">vet er shtein far mlochim;</para>
  <para style="q" vid="PRO 22:29">er vet nisht shtein far niderike.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="PRO 23" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1" />az du zetsst zich esen mit a geveltiker,</para>
  <para style="q" vid="PRO 23:1">zolstu gut farshtein vemen du host far dir;<verse eid="PRO 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2" />vorem du shtekst zich arain a meser in der kel,</para>
  <para style="q" vid="PRO 23:2">oib du bist a mentsh a freser.<verse eid="PRO 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3" />zolst nisht gorn noch zaine maicholim,</para>
  <para style="q" vid="PRO 23:3">vorem dos iz falshe shpaiz.<verse eid="PRO 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4" />zolstu zich nisht matern tsu vern raich;</para>
  <para style="q" vid="PRO 23:4">fun zinen shlog es dir arois.<verse eid="PRO 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5" />heibst oif daine oign deroif, un shoin iz es nishto;</para>
  <para style="q" vid="PRO 23:5">vorem machn fliglen macht es zich,</para>
  <para style="q" vid="PRO 23:5">vi an odler vos flit tsum himel.<verse eid="PRO 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6" />zolst nisht esen dos broit fun dem vos hot a beiz oig,</para>
  <para style="q" vid="PRO 23:6">un zolst nisht gorn noch zaine maicholim;<verse eid="PRO 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7" />vorem es iz azoi vi er volt oisrechenen bai zich;</para>
  <para style="q" vid="PRO 23:7">es un trink! zogt er tsu dir,</para>
  <para style="q" vid="PRO 23:7">ober zain harts iz nisht mit dir.<verse eid="PRO 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8" />dain bisn vos du host oifgegesn, vestu oisbrechn,</para>
  <para style="q" vid="PRO 23:8">un host umzist oisgebracht daine zise reid.<verse eid="PRO 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9" />in di oiern fun dem narn zolstu nisht redn,</para>
  <para style="q" vid="PRO 23:9">vorem er vet farachten dem seichel fun daine verter.<verse eid="PRO 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10" />zolst nisht iberrukn dem grenets fun fartsaitn,</para>
  <para style="q" vid="PRO 23:10">un in di felder fun yesoimim zolstu nisht araingein;<verse eid="PRO 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11" />vorem zeyer oisleizer iz shtark,</para>
  <para style="q" vid="PRO 23:11">er vet zich onnemen zeyer krig akegn dir.<verse eid="PRO 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12" />leig tsu dain harts tsu musar,</para>
  <para style="q" vid="PRO 23:12">un daine oiern tsu verter fun farshtandikeit.<verse eid="PRO 23:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13" />zolst nisht farmaidn shtrof fun dem yingel;</para>
  <para style="q" vid="PRO 23:13">az du vest im shlogn mit der rut, vet er nisht shtarbn.<verse eid="PRO 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14" />du vest im shlogn mit der rut,</para>
  <para style="q" vid="PRO 23:14">un vest matsl zain zain zel fun der Sheol.<verse eid="PRO 23:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15" />main zun, az dain harts vet zain klug,</para>
  <para style="q" vid="PRO 23:15">vet oich main harts zich freyen.<verse eid="PRO 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16" />un maine nirn veln onkveln,</para>
  <para style="q" vid="PRO 23:16">az daine lipn veln redn di richtikeit.<verse eid="PRO 23:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17" />zol dain harts nisht mekane zain di zindike,</para>
  <para style="q" vid="PRO 23:17">nor bloiz di moire far Hashem a gantsn tog.<verse eid="PRO 23:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18" />vorem far vor, es iz do a letst,</para>
  <para style="q" vid="PRO 23:18">un dain hofenung vet nisht farshnitn vern.<verse eid="PRO 23:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19" />her tsu, zun mainer, un ver klug,</para>
  <para style="q" vid="PRO 23:19">un fir oifn veg dain harts.<verse eid="PRO 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20" />zolst nisht zain fun di vos zoifn vain,</para>
  <para style="q" vid="PRO 23:20">fun di vos presn zich on mit fleish;<verse eid="PRO 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21" />vorem a freser un a zoifer vert farorimt.</para>
  <para style="q" vid="PRO 23:21">un shmates kleidt on shleferai.<verse eid="PRO 23:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22" />her tsu dain foter vos hot dich geborn,</para>
  <para style="q" vid="PRO 23:22">un zolst nisht farachten dain muter az zi iz alt.<verse eid="PRO 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23" />koif emes, un zolst es nisht farkoifen –</para>
  <para style="q" vid="PRO 23:23">chochme, un musar, un farshtandikeit.<verse eid="PRO 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24" />kveln kvelt on der foter fun dem tsadik,</para>
  <para style="q" vid="PRO 23:24">un der vos hot geborn a chochem freit zich mit im.<verse eid="PRO 23:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25" />zol zich freyen dain foter un dain muter,</para>
  <para style="q" vid="PRO 23:25">un zol kveln dain gevinerin.<verse eid="PRO 23:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26" />gib mir, main zun, dain harts,</para>
  <para style="q" vid="PRO 23:26">un daine oign zoln hitn maine vegen.<verse eid="PRO 23:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27" />vorem a tifer grobn iz a zoine,</para>
  <para style="q" vid="PRO 23:27">un an enge grub iz di fremde.<verse eid="PRO 23:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28" />dertsu loiert zi vi a roiber,</para>
  <para style="q" vid="PRO 23:28">un mert felsher tsvishn di mentshn.<verse eid="PRO 23:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29" />bai vemen iz oi? bai vemen iz vei?</para>
  <para style="q" vid="PRO 23:29">bai vemen krig? bai vemen klog?</para>
  <para style="q" vid="PRO 23:29">bai vemen umzistike vundn?</para>
  <para style="q" vid="PRO 23:29">bai vemen roite oign?<verse eid="PRO 23:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30" />bai di vos shpetikn zich baim vain,</para>
  <para style="q" vid="PRO 23:30">bai di vos kumen farzuchn dem mishtrank.<verse eid="PRO 23:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31" />zolst nisht kukn oifn vain vi er roitlt zich,</para>
  <para style="q" vid="PRO 23:31">vi er shpiglt in kos zain farb,</para>
  <para style="q" vid="PRO 23:31">vi er glitsht zich glatik arop.<verse eid="PRO 23:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32" />in zain sof vet er vi a shlang ainbaisn,</para>
  <para style="q" vid="PRO 23:32">un vi a noter vet er fargiftn.<verse eid="PRO 23:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33" />daine oign veln zen fremde zachn,</para>
  <para style="q" vid="PRO 23:33">un dain harts vet redn farkertkeit;<verse eid="PRO 23:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34" />un vest zain vi einer vos ligt in mitn yam,</para>
  <para style="q" vid="PRO 23:34">oder vi einer vos ligt oif a shpits mast.<verse eid="PRO 23:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35" />zei hobn mich geshlogn, un mir hot nisht vei geton,</para>
  <para style="q" vid="PRO 23:35">zei hobn mich tseklapt, un ich hob nisht geshpirt;</para>
  <para style="q" vid="PRO 23:35">ven nichter ich zich ois,</para>
  <para style="q" vid="PRO 23:35">vel ich es noch vider zuchn.<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="PRO 24" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1" />zolst nisht zain mekane beize lait,</para>
  <para style="q" vid="PRO 24:1">un zolst nisht gorn tsu zain mit zei,<verse eid="PRO 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2" />vorem farvistung tracht zeyer harts,</para>
  <para style="q" vid="PRO 24:2">un umglik redn zeyere lipn.<verse eid="PRO 24:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3" />mit chochme vert a hoiz geboit,</para>
  <para style="q" vid="PRO 24:3">un mit farshtandikeit vert es bafestikt;<verse eid="PRO 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4" />un durch kenshaft vern di kamern ongefilt</para>
  <para style="q" vid="PRO 24:4">mit alerlei taiern un liblechn guts.<verse eid="PRO 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5" />a kluger man iz in macht,</para>
  <para style="q" vid="PRO 24:5">un a mentsh mit kenshaft hot a shtarke gevure;<verse eid="PRO 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6" />vorem mit tachbulos muztu onfirn dain milchome,</para>
  <para style="q" vid="PRO 24:6">un hilf kumt durch fil yoetsim.<verse eid="PRO 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7" />tsu hoich far dem narn iz chochme,</para>
  <para style="q" vid="PRO 24:7">in toier efent er nisht zain moil.<verse eid="PRO 24:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8" />der vos klert tsu ton shlechts,</para>
  <para style="q" vid="PRO 24:8">im vet men nochrufn beizviliker mentsh.<verse eid="PRO 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9" />di trachtenish fun dem narn iz zind,</para>
  <para style="q" vid="PRO 24:9">un an umverdikeit bai mentshn iz der shpeter.<verse eid="PRO 24:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10" />loztu zich op in tog fun noit,</para>
  <para style="q" vid="PRO 24:10">iz dain koiech a knaper.<verse eid="PRO 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11" />zai matsl di vos vern genumen tsum toit,</para>
  <para style="q" vid="PRO 24:11">un di ongebreite tsum hargen, oib du kenst ophaltn.<verse eid="PRO 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12" />az du vest zogn: mir hobn doch derfun nisht gevust –</para>
  <para style="q" vid="PRO 24:12">far vor, der forsher fun di hertser, er vet merkn,</para>
  <para style="q" vid="PRO 24:12">un der hiter fun dain zel, er vet visen,</para>
  <para style="q" vid="PRO 24:12">un vet umkeren itlechn loit zaine meisim.<verse eid="PRO 24:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13" />es, main zun, honik, vail es iz gut,</para>
  <para style="q" vid="PRO 24:13">un honikzaft vos iz zis far dain gumen;<verse eid="PRO 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14" />azoi, zai visen, iz chochme far dain zel,</para>
  <para style="q" vid="PRO 24:14">az du host zi gefunen vet zain a gute letst,</para>
  <para style="q" vid="PRO 24:14">un dain hofenung vet nisht farshnitn vern.<verse eid="PRO 24:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15" />zolst nisht loiern, roshe, oif der voinung fun dem tsadik,</para>
  <para style="q" vid="PRO 24:15">zolst nisht farvistn zain menuche;<verse eid="PRO 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16" />vorem zibn mol falt der tsadik, un shteit oif,</para>
  <para style="q" vid="PRO 24:16">un di reshoim vern geshtroichlt in umglik.<verse eid="PRO 24:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17" />az dain soine falt, zolstu zich nisht freyen,</para>
  <para style="q" vid="PRO 24:17">un az er vert geshtroichlt, zol nisht onkveln dain harts;<verse eid="PRO 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18" />vorem Hashem vet zen, un es vet shlecht zain in zaine oign,</para>
  <para style="q" vid="PRO 24:18">un er vet opkeren fun im zain tsorn.<verse eid="PRO 24:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19" />zolst zich nisht ergern vegen di shlechtstuer,</para>
  <para style="q" vid="PRO 24:19">zolst nisht mekane zain di reshoim;<verse eid="PRO 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20" />vorem der shlechter vet nisht hobn kein letst,</para>
  <para style="q" vid="PRO 24:20">dos licht fun di reshoim vet oisgeloshn vern.<verse eid="PRO 24:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21" />hob moire far Hashem, main zun, un faran melech,</para>
  <para style="q" vid="PRO 24:21">mit iberandersher zolstu zich nisht mishn;<verse eid="PRO 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22" />vorem plutsling vet kumen zeyer broch,</para>
  <para style="q" vid="PRO 24:22">un ver veis dos umglik fun zei beidn?<verse eid="PRO 24:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23" />oich di dozike zainen fun di chachomim.</para>
  <para style="b" vid="PRO 24:23" />
  <para style="q" vid="PRO 24:23">fun shaneven in a mishpot kumt nisht arois kein guts.<verse eid="PRO 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24" />der vos zogt tsum shuldikn: du bist gerecht,</para>
  <para style="q" vid="PRO 24:24">shiltn im felker, fluchn im umes.<verse eid="PRO 24:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25" />ober di vos mishpetn richtik, zei iz voil,</para>
  <para style="q" vid="PRO 24:25">un oif zei kumt a broche fun guts.<verse eid="PRO 24:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26" />di lipn darf men kushn</para>
  <para style="q" vid="PRO 24:26">dem vos entfert di richtike reid.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27" />farricht deroisn dain arbet,</para>
  <para style="q" vid="PRO 24:27">un greit es dir tsu oifn feld,</para>
  <para style="q" vid="PRO 24:27">dernoch zolstu boien dain hoiz.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28" />zolst nisht zain an eides akegn dain chever on a far vos,</para>
  <para style="q" vid="PRO 24:28">un narn mit daine lipn.<verse eid="PRO 24:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29" />zolst nisht zogn:</para>
  <para style="q" vid="PRO 24:29">vi er hot mir geton, azoi vel ich im ton;</para>
  <para style="q" vid="PRO 24:29">ich vel dem mentshn umkeren loit zain ton.<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30" />farbai a feld fun a foiln man bin ich farbaigegangen,</para>
  <para style="q" vid="PRO 24:30">un farbai a vaingorten fun a mentshn on seichel;<verse eid="PRO 24:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31" />ersht es iz in gantsn geven farvaksn mit derner,</para>
  <para style="q" vid="PRO 24:31">zain eiberflech iz geven badekt mit vilde geveksn,</para>
  <para style="q" vid="PRO 24:31">un zain shteinerne tsam iz geven aingefaln.<verse eid="PRO 24:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32" />ich hob gekukt, un mir araingenumen in hartsn,</para>
  <para style="q" vid="PRO 24:32">ich hob gezen, un genumen a musar.<verse eid="PRO 24:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33" />noch a bisel shlof, noch a bisel dremlen,</para>
  <para style="q" vid="PRO 24:33">noch a bisel lign mit farleigte hent –<verse eid="PRO 24:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34" />un kumen azoi vi a vanderer dain orimkeit,</para>
  <para style="q" vid="PRO 24:34">un dain noit vi a man fun milchome.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="PRO 25" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 25:1" />oich di dozike zainen shprichverter fun Shlomoen,</para>
  <para style="q" vid="PRO 25:1">vos di lait fun Chizkiyah dem melech fun Yehudah</para>
  <para style="q" vid="PRO 25:1">hobn ibergeshribn.<verse eid="PRO 25:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2" />der koved fun Elokim iz farborgen a zach,</para>
  <para style="q" vid="PRO 25:2">un der koved fun mlochim iz oisforshn a zach.<verse eid="PRO 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3" />der himel in heich, un di erd in tifkeit,</para>
  <para style="q" vid="PRO 25:3">un dos harts fun mlochim, iz nisht tsu derforshn.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4" />nem arois di psoles fun zilber,</para>
  <para style="q" vid="PRO 25:4">un baim shmeltser kumt arois a keile;<verse eid="PRO 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5" />nem avek dem roshe fun faran melech,</para>
  <para style="q" vid="PRO 25:5">un zain tron vet shtein fest oif gerechtikeit.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6" />zolst zich nisht sheindlen faran melech,</para>
  <para style="q" vid="PRO 25:6">un in dem ort fun groise lait zolstu nisht shtein.<verse eid="PRO 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7" />vorem beser me zol dir zogn: kum aroif aher!</para>
  <para style="q" vid="PRO 25:7">eider me zol dich dernidern far dem firsht,</para>
  <para style="q" vid="PRO 25:7">vemen daine oign hobn gezen.<verse eid="PRO 25:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8" />zolst nisht aroisgein hastik zich krign,</para>
  <para style="q" vid="PRO 25:8">vorem vos vestu ton tsum sof derfun,</para>
  <para style="q" vid="PRO 25:8">az dain chever vet dich machn tsu shand?<verse eid="PRO 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9" />krig zich dain krig mit dain chever,</para>
  <para style="q" vid="PRO 25:9">ober a fremdns sod zolstu nisht antplekn;<verse eid="PRO 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10" />kedei der tsuherer zol dich nisht zidlen,</para>
  <para style="q" vid="PRO 25:10">vorem dain rechiles ken nisht tsurikgenumen vern.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11" />gilderne Ofel in zilberne puts-keilim,</para>
  <para style="q" vid="PRO 25:11">iz a vort geredt tsu der zach.<verse eid="PRO 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12" />a gilderner oiring un a tsirung fun gingold</para>
  <para style="q" vid="PRO 25:12">iz a kluger musar-zoger faran oier fun herer.<verse eid="PRO 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13" />vi shnei kelt in tog fun shnit,</para>
  <para style="q" vid="PRO 25:13">iz a bagloibter sheliech far di vos shikn im;</para>
  <para style="q" vid="PRO 25:13">vorem er derkvikt di zel fun zain har.<verse eid="PRO 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14" />volkens un vint on regn,</para>
  <para style="q" vid="PRO 25:14">iz a mentsh vos rimt zich mit a falsher matone.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15" />mit aingehaltnkeit vert ibergeredt der firsht,</para>
  <para style="q" vid="PRO 25:15">un a veiche tsung tsebrecht a bein.<verse eid="PRO 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16" />hostu gefunen honik, es fil es iz genug far dir,</para>
  <para style="q" vid="PRO 25:16">kedei zolst zich nisht iberzetn dermit, un es oisbrechn.<verse eid="PRO 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17" />mach dain fus zeltn in hoiz fun dain chever,</para>
  <para style="q" vid="PRO 25:17">kedei er zol nisht zat vern mit dir, un dich faint krign.<verse eid="PRO 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18" />a brechshtang un a shverd un sharfe fail</para>
  <para style="q" vid="PRO 25:18">iz a mentsh vos zogt falshe eides oif zain chever.<verse eid="PRO 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19" />a tsebrochener tson un an oisgelunkener fus,</para>
  <para style="q" vid="PRO 25:19">iz di farzicherung fun dem felsher in tog fun noit.<verse eid="PRO 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20" />vi der vos tut ois dem beged in a kaltn tog,</para>
  <para style="q" vid="PRO 25:20">vi esik oif loigzalts,</para>
  <para style="q" vid="PRO 25:20">azoi der vos zingt lider</para>
  <para style="q" vid="PRO 25:20">far an umetikn hartsn.<verse eid="PRO 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21" />az dain soine iz hungerik, gib im esen broit,</para>
  <para style="q" vid="PRO 25:21">un az er iz dorshtik, gib im trinken vaser;<verse eid="PRO 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22" />vorem koiln shitstu im oifn kop,</para>
  <para style="q" vid="PRO 25:22">un Hashem vet dir batsoln.<verse eid="PRO 25:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23" />tsofn-vint brengt regn,</para>
  <para style="q" vid="PRO 25:23">un a farshtelte tsung fardrosike penemer.<verse eid="PRO 25:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24" />beser voinen oif a vinkel dach,</para>
  <para style="q" vid="PRO 25:24">eider in ein hoiz mit a vaib a krigerin.<verse eid="PRO 25:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25" />kalte vaser far a farshmachter zel,</para>
  <para style="q" vid="PRO 25:25">azoi iz a gute besoire fun a vaitn land.<verse eid="PRO 25:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26" />a koitiker kval, un a dumpiker brunem</para>
  <para style="q" vid="PRO 25:26">iz a tsadik vos beigt zich faran roshe.<verse eid="PRO 25:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27" />tsu fil honik esen iz nisht gut;</para>
  <para style="q" vid="PRO 25:27">un zain eigenem koved oistsuforshn iz oich nit gut.<verse eid="PRO 25:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28" />an aingebrochene shtot on a moier</para>
  <para style="q" vid="PRO 25:28">iz a mentsh vos nishto kein ophalt far zain gemit.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="PRO 26" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1" />vi shnei um zumer, un vi regn in shnit,</para>
  <para style="q" vid="PRO 26:1">azoi past nisht faran narn koved.<verse eid="PRO 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2" />vi a shperl vos vandert, vi a shvalb vos flit,</para>
  <para style="q" vid="PRO 26:2">azoi vet an umziste klole onkumen oif zich alein.<verse eid="PRO 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3" />a baitsh faran ferd, a tsam faran eizl,</para>
  <para style="q" vid="PRO 26:3">un a rut faran rukn fun dem narn.<verse eid="PRO 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4" />zolst nisht entfern dem narn azoi vi zain narishkeit,</para>
  <para style="q" vid="PRO 26:4">kedei du oich zolst nisht vern glaich tsu im.<verse eid="PRO 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5" />entfer dem narn vedlik zain narishkeit,</para>
  <para style="q" vid="PRO 26:5">kedei er zol nisht zain a chochem in zaine oign.<verse eid="PRO 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6" />di fis hakt zich op, mit ergernish trinkt zich on,</para>
  <para style="q" vid="PRO 26:6">der vos shikt zachn durch der hant fun a narn.<verse eid="PRO 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7" />di fis bomblen zich baim hinkedikn,</para>
  <para style="q" vid="PRO 26:7">un a Mashal in moil fun a narn.<verse eid="PRO 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8" />azoi vi einer vos bindt a shtein in a shlaider,</para>
  <para style="q" vid="PRO 26:8">azoi az me git koved a narn.<verse eid="PRO 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9" />a dorn vos kumt in der hant fun a shikurn,</para>
  <para style="q" vid="PRO 26:9">azoi iz a Mashal in moil fun a narn.<verse eid="PRO 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10" />vi a boign-mn vos araingeshtocht ale,</para>
  <para style="q" vid="PRO 26:10">azoi iz der vos dingen di nor, oder dingen di paserbei.<verse eid="PRO 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11" />vi a hunt vos kert zich um tsu zain meikechts,</para>
  <para style="q" vid="PRO 26:11">chazert iber der nor zain tipshes.<verse eid="PRO 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12" />zestu a mentshn vos iz a chochem in zaine oign,</para>
  <para style="q" vid="PRO 26:12">iz do mer hofenung far a narn vi far im.<verse eid="PRO 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13" />der foiler zogt: a vild leib iz in veg,</para>
  <para style="q" vid="PRO 26:13">a leib iz in di gasn.<verse eid="PRO 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14" />di tir dreit zich shoin oif ir angl,</para>
  <para style="q" vid="PRO 26:14">un der foiler iz noch oif zain bet.<verse eid="PRO 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15" />az der foiler shtekt arain zain hant in shisel,</para>
  <para style="q" vid="PRO 26:15">iz er tsu mid zi tsutsutrogn tsu zain moil.<verse eid="PRO 26:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16" />der foiler iz kliger in zaine oign</para>
  <para style="q" vid="PRO 26:16">fun zibn geshaite entferer.<verse eid="PRO 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17" />vi der vos nemt on a hunt far di oiern,</para>
  <para style="q" vid="PRO 26:17">iz a farbaigeyer vos hitst zich iber a krig vos nisht zains.<verse eid="PRO 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18" />vi a meshugener vos vorft</para>
  <para style="q" vid="PRO 26:18">brenedike shaitn, failn, un toit,<verse eid="PRO 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19" />azoi iz der mentsh vos nart op zain chever,</para>
  <para style="q" vid="PRO 26:19">un zogt: ich shtif doch bloiz.<verse eid="PRO 26:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20" />on holts farlesht zich dos faier,</para>
  <para style="q" vid="PRO 26:20">un on an unterhetser hert oif krig.<verse eid="PRO 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21" />koiln far zhar, un holts far faier,</para>
  <para style="q" vid="PRO 26:21">un a mentsh a kriger oif ontsutsindn a shtrait.<verse eid="PRO 26:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22" />di verter fun dem unterhetser zainen vi geshmake bisns,</para>
  <para style="q" vid="PRO 26:22">un zei nidern in di kamern fun laib.<verse eid="PRO 26:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23" />psultdik zilber batsoign oif leim,</para>
  <para style="q" vid="PRO 26:23">zainen heise lipn un a beiz harts.<verse eid="PRO 26:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24" />mit zain lip farshtelt zich der soine,</para>
  <para style="q" vid="PRO 26:24">ober in zich greit er tsu batrug.<verse eid="PRO 26:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25" />az er macht laitzelik zain kol, zolstu im nisht gloibn,</para>
  <para style="q" vid="PRO 26:25">vorem zibn umverdikeitn zainen in zain hartsn.<verse eid="PRO 26:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26" />meg zich fardekn zain sine mit opnarenish,</para>
  <para style="q" vid="PRO 26:26">vet antplekt vern zain beiz far an oilem.<verse eid="PRO 26:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27" />der vos grobt a grub, vet in ir arainfaln,</para>
  <para style="q" vid="PRO 26:27">un der vos kaiklt a shtein,</para>
  <para style="q" vid="PRO 26:27">vet er zich umkeren tsu im.<verse eid="PRO 26:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28" />der dershlogener hot faint a falshe tsung,</para>
  <para style="q" vid="PRO 26:28">ober a glat moil fun chenife macht tseshterung.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="PRO 27" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1" />zolst zich nisht rimen mit dem morgedikn tog,</para>
  <para style="q" vid="PRO 27:1">vorem du veist nisht vos der tog vet gebern.<verse eid="PRO 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2" />zol dich loibn an anderer, un nisht dain moil,</para>
  <para style="q" vid="PRO 27:2">a fremder, un nisht daine lipn.<verse eid="PRO 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3" />shver iz shtein, un a mase iz zamd,</para>
  <para style="q" vid="PRO 27:3">ober der kaas fun a narn iz shverer fun zei beidn.<verse eid="PRO 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4" />umderbaremdik iz grimtsorn, un a fleitsung iz kaas,</para>
  <para style="q" vid="PRO 27:4">ober ver ken bashtein far kine?<verse eid="PRO 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5" />beser an ofener forvurf</para>
  <para style="q" vid="PRO 27:5">eider farborgene libshaft.<verse eid="PRO 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6" />getroilech zainen di vundn fun a gutn fraint,</para>
  <para style="q" vid="PRO 27:6">un tsu last zainen di kushn fun a soine.<verse eid="PRO 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7" />a zate zel tret oif honikzaft,</para>
  <para style="q" vid="PRO 27:7">un a hungeriker zel iz itlech biters zis.<verse eid="PRO 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8" />vi a foigel farvogelt fun ir nest,</para>
  <para style="q" vid="PRO 27:8">azoi iz a mentsh farvogelt fun zain heim.<verse eid="PRO 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9" />eil un vairech derfreit dos harts,</para>
  <para style="q" vid="PRO 27:9">dos glaichn di ziskeit fun a chever durch a hartsiker eitse.<verse eid="PRO 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10" />dain gutn fraint,</para>
  <para style="q" vid="PRO 27:10">un dain foters gutn fraint zolstu nisht farlozen;</para>
  <para style="q" vid="PRO 27:10">un zolst nisht kumen in dain bruders hoiz in tog fun dain broch;</para>
  <para style="q" vid="PRO 27:10">beser a nonter shochn eider a vaiter bruder.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11" />zai klug, main zun, un derfrei main harts,</para>
  <para style="q" vid="PRO 27:11">un ich vel kenen entfern dem vos lestert mich.<verse eid="PRO 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12" />der kluger zet dos beiz, farborgt er zich,</para>
  <para style="q" vid="PRO 27:12">di narn geyen vaiter, vern zei geshtroft.<verse eid="PRO 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13" />nem tsu zain beged oib er iz orev geven far an andern,</para>
  <para style="q" vid="PRO 27:13">un nem zain meshkun far der fremder.<verse eid="PRO 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14" />der vos bentsht zain gutn fraint</para>
  <para style="q" vid="PRO 27:14">oif a hoichn kol peire baginen,</para>
  <para style="q" vid="PRO 27:14">vet es im vi a klole gerechnt vern.<verse eid="PRO 27:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15" />a nudne trifenish in a regndikn tog,</para>
  <para style="q" vid="PRO 27:15">un a vaib a krigerin, zainen glaich.<verse eid="PRO 27:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16" />der vos bahalt zi, bahalt vint,</para>
  <para style="q" vid="PRO 27:16">un vi tsu haltn eil in zain rechte hant.<verse eid="PRO 27:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17" />aizn shlaift men mit aizn,</para>
  <para style="q" vid="PRO 27:17">un ein mentsh shlaift dem sharf fun dem andern.<verse eid="PRO 27:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18" />der vos hit dem faignboim, vet esen zain frucht,</para>
  <para style="q" vid="PRO 27:18">un der vos past oif zain har, vet hobn koved.<verse eid="PRO 27:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19" />vi in vaser iz a ponem kegen a ponem,</para>
  <para style="q" vid="PRO 27:19">azoi iz dos harts fun a mentshn tsu a mentshn.<verse eid="PRO 27:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20" />Sheol un der opgrunt vern nisht zat,</para>
  <para style="q" vid="PRO 27:20">un di oign fun dem mentshn vern nisht zat.<verse eid="PRO 27:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21" />a tigl far zilber, un a shmeltsoivn far gold,</para>
  <para style="q" vid="PRO 27:21">un a mentsh loit zain loib.<verse eid="PRO 27:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22" />ven du zolst shtoisn dem narn</para>
  <para style="q" vid="PRO 27:22">in a shteisl mit a merzer tsvishn grits,</para>
  <para style="q" vid="PRO 27:22">vet zich nisht opton fun im zain narishkeit.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23" />kenen zolstu kenen dos oiszen fun daine shof,</para>
  <para style="q" vid="PRO 27:23">gib achtung oif di stades;<verse eid="PRO 27:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24" />vorem nisht oif eibik iz raichtum;</para>
  <para style="q" vid="PRO 27:24">un iz den a kroin oif dor-doires?<verse eid="PRO 27:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25" />di hei iz opgeshnitn, un frishe groz bavaizt zich,</para>
  <para style="q" vid="PRO 27:25">un aingezamlt zainen di kraitecher fun di berg,<verse eid="PRO 27:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26" />veln di shepsn zain far dain kleidung,</para>
  <para style="q" vid="PRO 27:26">un tsu batsoln far a feld di bek;<verse eid="PRO 27:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27" />un genug tsignmilch vet zain far dain shpaiz –</para>
  <para style="q" vid="PRO 27:27">far dem shpaiz fun dain hoizgezint,</para>
  <para style="q" vid="PRO 27:27">un dernerung far daine dinstmeidlech.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="PRO 28" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1" />der roshe loift ven keiner yogt nisht,</para>
  <para style="q" vid="PRO 28:1">ober di tsadikim zainen zicher vi a yunger leib.<verse eid="PRO 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2" />durch dem farbrech fun a land zainen fil ire harn,</para>
  <para style="q" vid="PRO 28:2">ober durch a farshtandikn man vos veis,</para>
  <para style="q" vid="PRO 28:2">halt on lang der bashtand.<verse eid="PRO 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3" />an oreman vos drikt di shvache,</para>
  <para style="q" vid="PRO 28:3">iz a shlaksregn vos lozt on broit.<verse eid="PRO 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4" />di vos farlozen di toyre, loibn di reshoim,</para>
  <para style="q" vid="PRO 28:4">ober di vos hitn di toyre, krign zich mit zei.<verse eid="PRO 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5" />shlechte mentshn farshteyen nisht gerechtikeit,</para>
  <para style="q" vid="PRO 28:5">ober di vos zuchn Hashem, farshteyen alts.<verse eid="PRO 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6" />beser an oreman vos geit mit zain erlechkeit,</para>
  <para style="q" vid="PRO 28:6">eider der vos zaine vegen zainen krum, un er iz an oysher.<verse eid="PRO 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7" />a farshtandiker zun hit di lernung,</para>
  <para style="q" vid="PRO 28:7">ober der vos chavert zich mit fresers, farshemt zain foter.<verse eid="PRO 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8" />der vos mert zain farmeg durch tsindzn un merung,</para>
  <para style="q" vid="PRO 28:8">zamlt es far dem vos vet shenken tsu orime.<verse eid="PRO 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9" />der vos kert op zain oier fun tsu hern di lernung,</para>
  <para style="q" vid="PRO 28:9">iz afile zain tfile an umverdikeit.<verse eid="PRO 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10" />der vos farfirt di rechtfartikn oif a shlechtn veg,</para>
  <para style="q" vid="PRO 28:10">vet er arainfaln in zain eigener grub,</para>
  <para style="q" vid="PRO 28:10">un di erleche veln arben guts.<verse eid="PRO 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11" />der raicher man iz a chochem in zaine oign,</para>
  <para style="q" vid="PRO 28:11">ober der kluge oreman forsht im durch.<verse eid="PRO 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12" />az tsadikim freyen zich iz a groise gdulh,</para>
  <para style="q" vid="PRO 28:12">ober az reshoim kumen oif, muz men zuchn a mentshn.<verse eid="PRO 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13" />der vos fardekt zaine zind, vet nisht baglikn,</para>
  <para style="q" vid="PRO 28:13">ober der vos iz zich moide un farlozt zei,</para>
  <para style="q" vid="PRO 28:13">vet derbaremt vern.<verse eid="PRO 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14" />voil tsu dem mentshn vos forcht tamid,</para>
  <para style="q" vid="PRO 28:14">un der vos macht hart zain harts vet arainfaln in beiz.<verse eid="PRO 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15" />a brumiker leib, un a hungeriker Beor,</para>
  <para style="q" vid="PRO 28:15">iz a roshe vos geveltikt iber orim folk.<verse eid="PRO 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16" />a firsht felik in seichel iz grois in roiberaien;</para>
  <para style="q" vid="PRO 28:16">un der vos hot faint umerlechn gevin iz maarich-yamim.<verse eid="PRO 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17" />a mentsh vos hot oif zich dos blut fun a nefesh,</para>
  <para style="q" vid="PRO 28:17">vet loifn bizn grub,</para>
  <para style="q" vid="PRO 28:17">me vet im nisht baishtein.<verse eid="PRO 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18" />der vos geit erlech vet geholfn vern,</para>
  <para style="q" vid="PRO 28:18">un der vos zaine vegen zainen krum, vet faln mit ein mol.<verse eid="PRO 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19" />der vos baarbet zain erd vet hobn broit tsu zat,</para>
  <para style="q" vid="PRO 28:19">un der vos yogt zich noch puste zachn vet zat zain mit dlut.<verse eid="PRO 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20" />an erlecher mentsh krigt fil broches,</para>
  <para style="q" vid="PRO 28:20">ober der vos vil gich raich vern vet nisht opkumen glat.<verse eid="PRO 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21" />fun shaneven kumt nisht arois kein guts,</para>
  <para style="q" vid="PRO 28:21">ober um a shtikl broit farzindikt zich der mentsh.<verse eid="PRO 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22" />farhavet noch raichtum iz a mentsh a nisht farginer,</para>
  <para style="q" vid="PRO 28:22">un er veis nisht az di noit vet kumen oif im.<verse eid="PRO 28:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23" />der vos shtroft emitsn, vet shpeter gefinen mer chein</para>
  <para style="q" vid="PRO 28:23">vi der vos hot a glate tsung.<verse eid="PRO 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24" />der vos bagzlt zain foter un zain muter,</para>
  <para style="q" vid="PRO 28:24">un zogt: es iz nisht kein farbrech,</para>
  <para style="q" vid="PRO 28:24">er iz a chever tsu a mentshn an umbrenger.<verse eid="PRO 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25" />der vos hot a farlangerishe zel, macht on krig,</para>
  <para style="q" vid="PRO 28:25">ober der vos farzichert zich oif Hashem, vert gezetikt.<verse eid="PRO 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26" />der vos iz batuach in zain hartsn, er iz a nor,</para>
  <para style="q" vid="PRO 28:26">un der vos geit mit chochme, vet antrunen vern.<verse eid="PRO 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27" />dem vos git dem oreman vet nisht feln,</para>
  <para style="q" vid="PRO 28:27">ober der vos farhoilt zaine oign, vet krign fil kloles.<verse eid="PRO 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28" />az di reshoim shteyen oif, bahaltn zich di mentshn,</para>
  <para style="q" vid="PRO 28:28">un az zei geyen unter, mern zich di tsadikim.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="PRO 29" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1" />a mentsh a gemusrter vos macht hart zain nakn,</para>
  <para style="q" vid="PRO 29:1">vet plutsling tsebrochn vern</para>
  <para style="q" vid="PRO 29:1">az kein heilung vet nisht zain.<verse eid="PRO 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2" />az di tsadikim mern zich, freit zich dos folk,</para>
  <para style="q" vid="PRO 29:2">ober az der roshe geveltikt, ziftst dos folk.<verse eid="PRO 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3" />a mentsh vos hot lib chochme, derfreit zain foter,</para>
  <para style="q" vid="PRO 29:3">ober der vos chavert zich mit zoinus, brengt ois dem farmeg.<verse eid="PRO 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4" />a melech halt oif mit gerechtikeit dos land,</para>
  <para style="q" vid="PRO 29:4">un der Baaln oif matonus tseshtert es.<verse eid="PRO 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5" />der mentsh vos chanfet zain chever,</para>
  <para style="q" vid="PRO 29:5">shpreit ois a nets far zaine trit.<verse eid="PRO 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6" />in dem farbrech fun dem shlechtn mentshn iz a shtroichlung,</para>
  <para style="q" vid="PRO 29:6">ober der tsadik zingt un iz freilech.<verse eid="PRO 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7" />der tsadik veis dos recht fun di orime,</para>
  <para style="q" vid="PRO 29:7">der roshe kimert zich nisht tsu visen.<verse eid="PRO 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8" />lait fun shpot blozn-oif di shtot,</para>
  <para style="q" vid="PRO 29:8">ober kluge haltn op dem tsorn.<verse eid="PRO 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9" />az a kluger mentsh tainet mit a narn,</para>
  <para style="q" vid="PRO 29:9">sai er beizert zich, sai er shmeichlt, hot er nisht kein Nachat.<verse eid="PRO 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10" />blutike lait hobn faint dem umshuldikn,</para>
  <para style="q" vid="PRO 29:10">ober di rechtfartikn gorn noch im.<verse eid="PRO 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11" />zain gants gemit lozt arois der nor,</para>
  <para style="q" vid="PRO 29:11">ober der chochem halt es tsurik.<verse eid="PRO 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12" />a geveltiker vos horcht tsu gereid fun lign,</para>
  <para style="q" vid="PRO 29:12">zainen ale zaine meshoresim reshoim.<verse eid="PRO 29:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13" />der oreman un der driker shtoisn zich on einander,</para>
  <para style="q" vid="PRO 29:13">ober der derlaichter fun beidns oign iz Hashem.<verse eid="PRO 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14" />a melech vos mishpot mit emes di orime,</para>
  <para style="q" vid="PRO 29:14">vet zain tron bashtein shtendik.<verse eid="PRO 29:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15" />di rut un musar gibn chochme,</para>
  <para style="q" vid="PRO 29:15">un a loizgelozt yingel brengt shand zain muter.<verse eid="PRO 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16" />az di reshoim mern zich, mert zich farbrech,</para>
  <para style="q" vid="PRO 29:16">ober di tsadikim veln zen zeyer mapole.<verse eid="PRO 29:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17" />shtrof dain zun, un er vet dir onton Nachat,</para>
  <para style="q" vid="PRO 29:17">un gebn tenug tsu dain zel.<verse eid="PRO 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18" />on a zeung vert dos folk farvildert,</para>
  <para style="q" vid="PRO 29:18">un der vos hit di toyre, az voil iz tsu im!<verse eid="PRO 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19" />mit verter ken a knecht nisht oisgemusrt vern,</para>
  <para style="q" vid="PRO 29:19">vorem er meg farshtein, ober folgn vet er nisht.<verse eid="PRO 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20" />zestu a mentshn hastik mit zaine verter,</para>
  <para style="q" vid="PRO 29:20">iz do mer hofenung far a narn vi far im.<verse eid="PRO 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21" />der vos fartsertlt fun yugnt zain knecht,</para>
  <para style="q" vid="PRO 29:21">vet er tsum sof vern an eiberhar.<verse eid="PRO 29:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22" />a tsorndiker mentsh macht on krig,</para>
  <para style="q" vid="PRO 29:22">un a kesn bageit fil farbrechn.<verse eid="PRO 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23" />di gaive fun a mentshn dernidert im,</para>
  <para style="q" vid="PRO 29:23">un der vos iz shofl in gemit vet krign koved.<verse eid="PRO 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24" />der vos teilt zich mit a ganev, iz a soine zich alein:</para>
  <para style="q" vid="PRO 29:24">er hert di klole, un zogt nisht ois.<verse eid="PRO 29:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25" />moire far a mentshn leigt a shtroichlung,</para>
  <para style="q" vid="PRO 29:25">ober der vos farzichert zich oif Hashem, vert bashitst.<verse eid="PRO 29:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26" />fil zuchn dem ponem fun dem geveltiker,</para>
  <para style="q" vid="PRO 29:26">ober fun Hashem iz dem mentshns mishpot.<verse eid="PRO 29:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27" />an umverdikeit bai di tsadikim iz der man fun umrecht,</para>
  <para style="q" vid="PRO 29:27">un an umverdikeit bai di reshoim, der vos zain veg iz glaich.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" pubnumber="ל" sid="PRO 30" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />di verter fun Agur der zun fun Yakehn; a musar. der man hot gezogt tsu Itieln, tsu Itieln un Ucaln:<verse eid="PRO 30:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2" />far vor, ich bin fargrebter fun itlechn,</para>
  <para style="q" vid="PRO 30:2">un ich hob nisht kein farshtandikeit fun a mentshn,<verse eid="PRO 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3" />un ich hob nisht gelernt kein chochme,</para>
  <para style="q" vid="PRO 30:3">az derkenung fun heilikn zol ich visen.<verse eid="PRO 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4" />ver iz aroif oifn himel, un aropgenidert?</para>
  <para style="q" vid="PRO 30:4">ver hot gezamlt dem vint in zaine foistn?</para>
  <para style="q" vid="PRO 30:4">ver hot aingebundn di vasern in a tuch?</para>
  <para style="q" vid="PRO 30:4">ver hot oifgeshtelt ale ekn fun der erd?</para>
  <para style="q" vid="PRO 30:4">vos iz zain nomen?</para>
  <para style="q" vid="PRO 30:4">un vos iz der nomen fun zain zun,</para>
  <para style="q" vid="PRO 30:4">oib du veist?<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5" />itlech vort fun Eloah iz gelaitert;</para>
  <para style="q" vid="PRO 30:5">er iz a shild far di vos shitsn zich in im.<verse eid="PRO 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6" />zolst nisht tsuleigen tsu zaine verter,</para>
  <para style="q" vid="PRO 30:6">kedei er zol dich nisht forhaltn, un vest blaibn a ligner.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7" />tsvei zachn bet ich bai dir,</para>
  <para style="q" vid="PRO 30:7">zolst zei nisht farmaidn fun mir, eider ich shtarb:<verse eid="PRO 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8" />falshkeit un verter fun lign dervaiter fun mir;</para>
  <para style="q" vid="PRO 30:8">nisht orimkeit un nisht eshires zolstu mir gebn,</para>
  <para style="q" vid="PRO 30:8">shpaiz mich mit broit far main oiskumenish;<verse eid="PRO 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9" />kedei ich zol nisht vern tsu zat,</para>
  <para style="q" vid="PRO 30:9">un leikenen, un zogn: ver iz Hashem?</para>
  <para style="q" vid="PRO 30:9">un kedei ich zol nisht vern tsu orim, un ganven,</para>
  <para style="q" vid="PRO 30:9">un onrirn dem nomen fun main G-t.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10" />zolst nisht farmasrn a knecht far zain har,</para>
  <para style="q" vid="PRO 30:10">vorem er vet dich shiltn, un vest zich farshuldikn.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11" />faran a dor vos shilt zain foter,</para>
  <para style="q" vid="PRO 30:11">un bentsht nisht zain muter.<verse eid="PRO 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12" />faran a dor rein in zaine oign,</para>
  <para style="q" vid="PRO 30:12">un fun zain koit nisht opgevashn.<verse eid="PRO 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13" />faran a dor – vi hoich zainen zaine oign!</para>
  <para style="q" vid="PRO 30:13">un zaine bremen vi oifgehoibn!<verse eid="PRO 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14" />faran a dor vos zaine tsein zainen shverdn,</para>
  <para style="q" vid="PRO 30:14">un zaine baktseiner, mesers,</para>
  <para style="q" vid="PRO 30:14">tsu fartseren di orime oisn land,</para>
  <para style="q" vid="PRO 30:14">un di evyonim fun tsvishn mentshn.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15" />fun alukohn: faran tsvei techter: gib! gib!</para>
  <para style="q" vid="PRO 30:15">faran drai vos vern nisht zat,</para>
  <para style="q" vid="PRO 30:15">fir vos zogn nisht genug:<verse eid="PRO 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16" />Sheol, di farshlosene geber־muter,</para>
  <para style="q" vid="PRO 30:16">di erd vos vert nisht zat mit vaser,</para>
  <para style="q" vid="PRO 30:16">un dos faier vos zogt nisht, genug!<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17" />dos oig vos shpot fun a foter,</para>
  <para style="q" vid="PRO 30:17">un faracht tsu gehorchn a muter,</para>
  <para style="q" vid="PRO 30:17">zoln es oispikn di robn fun tal,</para>
  <para style="q" vid="PRO 30:17">un zoln es oifesn di kinder fun odler.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18" />faran drai vos zainen farhoiln fun mir,</para>
  <para style="q" vid="PRO 30:18">yo, fir vos ich farshtei zei nisht:<verse eid="PRO 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19" />der veg fun odler in himel,</para>
  <para style="q" vid="PRO 30:19">der veg fun der shlang oif a feldz,</para>
  <para style="q" vid="PRO 30:19">der veg fun a shif in mitn yam,</para>
  <para style="q" vid="PRO 30:19">un der veg fun a man mit a yungfroi.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20" />azoi iz der shteiger fun a froi a noyefte:</para>
  <para style="q" vid="PRO 30:20">zi est un visht op ir moil,</para>
  <para style="q" vid="PRO 30:20">un zogt: ich hob nisht geton kein beiz.<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21" />unter draien tsitert di erd,</para>
  <para style="q" vid="PRO 30:21">yo, unter firn ken zi nisht oishaltn:<verse eid="PRO 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22" />unter a knecht, az er vert a melech,</para>
  <para style="q" vid="PRO 30:22">un a menuvl, az er hot broit tsu zat;<verse eid="PRO 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23" />unter a miuser, az zi krigt a man,</para>
  <para style="q" vid="PRO 30:23">un a dinst, az zi yershet ir harinte.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24" />fir zainen di klenste oif der erd,</para>
  <para style="q" vid="PRO 30:24">un zei zainen di kligste chachomim:<verse eid="PRO 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25" />di murazhkes zainen a folk nisht shtark,</para>
  <para style="q" vid="PRO 30:25">un zei greitn on um zumer zeyer shpaiz;<verse eid="PRO 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26" />di kinigls zainen a folk nisht machtik,</para>
  <para style="q" vid="PRO 30:26">un zei machn in feldz zeyer hoiz;<verse eid="PRO 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27" />nishto kein melech bai di heisherikn,</para>
  <para style="q" vid="PRO 30:27">un zei geyen arois in machnus ale;<verse eid="PRO 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28" />di yashtsherke kenstu mit di hent onnemen,</para>
  <para style="q" vid="PRO 30:28">un zi iz in kinigleche palatsn.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29" />drai hobn a sheinem trot,</para>
  <para style="q" vid="PRO 30:29">yo, fir geyen shein:<verse eid="PRO 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30" />der leib, der shtarkster tsvishn di chayes,</para>
  <para style="q" vid="PRO 30:30">vos kert zich nisht op far keinem;<verse eid="PRO 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31" />der shpatsirt zich arum hon, un der bok;</para>
  <para style="q" vid="PRO 30:31">un der melech, vos nishto kegen im kein bashtand.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32" />oib du host zich farmiust durch ibernemen zich,</para>
  <para style="q" vid="PRO 30:32">iz, oib du bist iberleigt, tu di hant oifn moil,<verse eid="PRO 30:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33" />vorem drikn milch brengt arois puter,</para>
  <para style="q" vid="PRO 30:33">un drikn di noz brengt arois blut,</para>
  <para style="q" vid="PRO 30:33">un drikn tsorn brengt arois krig.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" pubnumber="לא" sid="PRO 31" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 31:1" />di verter fun melech Lemuel,</para>
  <para style="q" vid="PRO 31:1">a musar vos zain muter hot im gelernt.<verse eid="PRO 31:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2" />nein, main zun! un nein, zun fun main laib,</para>
  <para style="q" vid="PRO 31:2">un nein, zun fun maine nedrim;<verse eid="PRO 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3" />zolst nisht avekgebn oif vaiber dain koiech,</para>
  <para style="q" vid="PRO 31:3">un daine vegen oif vos brengt um mlochim.<verse eid="PRO 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4" />nisht far mlochim, Lemuel,</para>
  <para style="q" vid="PRO 31:4">nisht far mlochim iz trinken vain,</para>
  <para style="q" vid="PRO 31:4">un vu far firshtn getrank!<verse eid="PRO 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5" />kedei zei zoln nisht trinken un fargesen dos gezets,</para>
  <para style="q" vid="PRO 31:5">un fardreyen dem mishpot fun ale gedrikte.<verse eid="PRO 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6" />git getrank tsum farlorenem,</para>
  <para style="q" vid="PRO 31:6">un vain tsu di farbiterte in gemit.<verse eid="PRO 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7" />zol er trinken un fargesen zain orimkeit</para>
  <para style="q" vid="PRO 31:7">un zain maternish mer nisht gedenken.<verse eid="PRO 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8" />efen dain moil far dem shtumen,</para>
  <para style="q" vid="PRO 31:8">far dem recht fun ale fargEike.<verse eid="PRO 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9" />efen dain moil, mishpot mit gerechtikeit,</para>
  <para style="q" vid="PRO 31:9">un tu recht dem oreman un dem evyon.<verse eid="PRO 31:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10" />an eshet-cheil ver ken gefinen?</para>
  <para style="q" vid="PRO 31:10">un hecher fun perl iz ir vert.<verse eid="PRO 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11" />dos harts fun ir man farzichert zich oif ir,</para>
  <para style="q" vid="PRO 31:11">un im felt nisht kein ainkum.<verse eid="PRO 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12" />zi tut im guts un nisht shlechts,</para>
  <para style="q" vid="PRO 31:12">ale teg fun ir lebn.<verse eid="PRO 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13" />zi zucht oif vol un flaks,</para>
  <para style="q" vid="PRO 31:13">un arbet mit ire vilike hent.<verse eid="PRO 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14" />zi iz azoi vi di handlshifn,</para>
  <para style="q" vid="PRO 31:14">fun der vaitn brengt zi ir broit.<verse eid="PRO 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15" />un zi shteit oif ven noch nacht,</para>
  <para style="q" vid="PRO 31:15">un greit tsu shpaiz far ir hoizgezint,</para>
  <para style="q" vid="PRO 31:15">un di oiskumenish far ire dinstmeidlech.<verse eid="PRO 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16" />zi fartracht a feld, un koift es,</para>
  <para style="q" vid="PRO 31:16">fun der frucht fun ire hent flantst zi a vaingorten.<verse eid="PRO 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17" />zi gurt on mit kraft ire lendn,</para>
  <para style="q" vid="PRO 31:17">un zi shtarkt ire orems.<verse eid="PRO 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18" />zi merkt az ir fardinst iz gut;</para>
  <para style="q" vid="PRO 31:18">nisht farloshn bai nacht vert ir licht.<verse eid="PRO 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19" />ire hent leigt zi tsum shpinrod,</para>
  <para style="q" vid="PRO 31:19">un ire hantflechn haltn dem shpindl.<verse eid="PRO 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20" />ir hantflech shpreit zi ois tsum oreman,</para>
  <para style="q" vid="PRO 31:20">un ire hent shtrekt zi ois tsum evyon.<verse eid="PRO 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21" />zi hot nisht moire vegen ir hoizgezint far shnei,</para>
  <para style="q" vid="PRO 31:21">vorem ir gants hoizgezint iz ongeton in roitgevant.<verse eid="PRO 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22" />dekn macht zi zich,</para>
  <para style="q" vid="PRO 31:22">fainlainen un purpl iz ir malbesh.<verse eid="PRO 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23" />bakant in di toiern iz ir man,</para>
  <para style="q" vid="PRO 31:23">ven er zitst mit di eltste fun land.<verse eid="PRO 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24" />a lainentuch macht zi un farkoift,</para>
  <para style="q" vid="PRO 31:24">un gartelen shtelt zi tsu dem handlsman.<verse eid="PRO 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25" />shtarkeit un sheinkeit iz ir malbesh,</para>
  <para style="q" vid="PRO 31:25">un zi lacht fun shpeterdikn tog.<verse eid="PRO 31:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26" />ir moil efent zi mit chochme,</para>
  <para style="q" vid="PRO 31:26">un di lernung fun genod iz oif ir tsung.<verse eid="PRO 31:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27" />zi kukt noch dem gang fun ir hoiz,</para>
  <para style="q" vid="PRO 31:27">un zi est nisht dos broit fun foilkeit.<verse eid="PRO 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28" />ire kinder shteyen oif un loibn zi,</para>
  <para style="q" vid="PRO 31:28">ir man – un er rimt zi:<verse eid="PRO 31:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29" />fil techter hobn oifgeton brihshaft,</para>
  <para style="q" vid="PRO 31:29">ober du shtaigst zei ale ariber.<verse eid="PRO 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30" />chein iz an opnar, un sheinkeit iz nishtik,</para>
  <para style="q" vid="PRO 31:30">a G-tsforchtike vaib, zi zol gerimt vern.<verse eid="PRO 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31" />git ir fun der frucht fun ire hent,</para>
  <para style="q" vid="PRO 31:31">un zoln ire meisim zi rimen in di toiern.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>