<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Ovadyah</para>
  <para style="toc2">Ovadyah</para>
  <para style="toc1">Ovadyah</para>
  <para style="mt1">Ovadyah</para>
  <chapter number="1" style="c" pubnumber="א" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />di zeung fun Ovadyahn.</para>
  <para style="b" vid="OBA 1:1" />
  <para style="q" vid="OBA 1:1">azoi hot gezogt Adonoi Hashem oif Edom:</para>
  <para style="q" vid="OBA 1:1">a herung hobn mir gehert fun Hashem,</para>
  <para style="q" vid="OBA 1:1">un a sheliech iz geshikt tsvishn di felker:</para>
  <para style="q" vid="OBA 1:1">shteit oif, un lomir oifshtein in milchome oif ir.<verse eid="OBA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="OBA 1:2" />ze, klein mach ich dich tsvishn di felker,</para>
  <para style="q" vid="OBA 1:2">faracht zeyer verstu.<verse eid="OBA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="OBA 1:3" />di mutvilikeit fun dain hartsn hot dich farfirt,</para>
  <para style="q" vid="OBA 1:3">du vos rust in di shpaltn fun feldz,</para>
  <para style="q" vid="OBA 1:3">in der heich fun dain voinung;</para>
  <para style="q" vid="OBA 1:3">vos zogst in dain hartsn:</para>
  <para style="q" vid="OBA 1:3">ver vet mich aropnideren tsu der erd?<verse eid="OBA 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="OBA 1:4" />ven du zolst zich vi an odler derheibn,</para>
  <para style="q" vid="OBA 1:4">un ven du machst tsvishn shtern dain nest,</para>
  <para style="q" vid="OBA 1:4">vel ich fun dortn dich aropnideren,</para>
  <para style="q" vid="OBA 1:4">zogt Hashem.<verse eid="OBA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="OBA 1:5" />oib ganovem voltn gekumen tsu dir, oib nachtroiber –</para>
  <para style="q" vid="OBA 1:5">vi bistu farshnitn gevorn! –</para>
  <para style="q" vid="OBA 1:5">voltn zei doch bloiz gegnvet genug far zich;</para>
  <para style="q" vid="OBA 1:5">oib harbster voltn gekumen tsu dir,</para>
  <para style="q" vid="OBA 1:5">voltn zei doch a nochklaib ibergelozt.<verse eid="OBA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="OBA 1:6" />vi iz durchgezucht gevorn Esav,</para>
  <para style="q" vid="OBA 1:6">antplekt gevorn zaine baheltenishn!<verse eid="OBA 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="OBA 1:7" />biz tsum gemark hobn zei dir baleit,</para>
  <para style="q" vid="OBA 1:7">ale daine bundslait;</para>
  <para style="q" vid="OBA 1:7">dich farfirt, dich baigekumen hobn di gute fraint daine.</para>
  <para style="q" vid="OBA 1:7">di vos hobn dain broit gegesn</para>
  <para style="q" vid="OBA 1:7">hobn geshtelt a nets unter dir.</para>
  <para style="q" vid="OBA 1:7">nisht geven kein farshtandikeit in im.<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="OBA 1:8" />far vor, in yenem tog, zogt Hashem,</para>
  <para style="q" vid="OBA 1:8">vel ich unterbrengen di chachomim, fun Edom,</para>
  <para style="q" vid="OBA 1:8">un di farshtandikeit, fun barg Esav.<verse eid="OBA 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="OBA 1:9" />un daine giborim, Teman, veln tsebrochn vern,</para>
  <para style="q" vid="OBA 1:9">kedei itlecher zol farshnitn vern</para>
  <para style="q" vid="OBA 1:9">fun barg Esav durch teitung.<verse eid="OBA 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="OBA 1:10" />far dem umrecht tsu dain bruder Yaakov</para>
  <para style="q" vid="OBA 1:10">vet dich a bushe badekn,</para>
  <para style="q" vid="OBA 1:10">un vest farshnitn vern oif eibik.<verse eid="OBA 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="OBA 1:11" />in dem tog vos du bist geshtanen fun vaitn,</para>
  <para style="q" vid="OBA 1:11">in dem tog vos fremde hobn gefangen zain farmeg,</para>
  <para style="q" vid="OBA 1:11">un vildfremde zainen gekumen in zaine toiern,</para>
  <para style="q" vid="OBA 1:11">un oif Yerushalayim goirl gevorfn,</para>
  <para style="q" vid="OBA 1:11">bistu oich geven vi einer fun zei.<verse eid="OBA 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="OBA 1:12" />un du host nisht gezolt tsuzen dem tog</para>
  <para style="q" vid="OBA 1:12">fun dain bruder,</para>
  <para style="q" vid="OBA 1:12">in tog fun zain umglik,</para>
  <para style="q" vid="OBA 1:12">un nisht gezolt zich freyen iber di kinder fun Yehudah,</para>
  <para style="q" vid="OBA 1:12">in tog fun zeyer untergang,</para>
  <para style="q" vid="OBA 1:12">un nisht gezolt greisn dain moil,</para>
  <para style="q" vid="OBA 1:12">in tog fun noit.<verse eid="OBA 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="OBA 1:13" />host nisht gezolt kumen in toier fun main folk,</para>
  <para style="q" vid="OBA 1:13">in tog fun zain broch,</para>
  <para style="q" vid="OBA 1:13">nisht gezolt tsuzen, du oich, zain umglik,</para>
  <para style="q" vid="OBA 1:13">in tog fun zain broch,</para>
  <para style="q" vid="OBA 1:13">un nisht gezolt oisshtrekn di hant oif zain farmeg,</para>
  <para style="q" vid="OBA 1:13">in tog fun zain broch.<verse eid="OBA 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="OBA 1:14" />un host nisht gezolt shtein baim sheidveg,</para>
  <para style="q" vid="OBA 1:14">tsu farshnaidn zaine antrunene,</para>
  <para style="q" vid="OBA 1:14">un nisht gezolt iberentfern zaine geblibene,</para>
  <para style="q" vid="OBA 1:14">in tog fun noit.<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="OBA 1:15" />vorem nont iz der tog fun Hashem oif ale felker;</para>
  <para style="q" vid="OBA 1:15">vi du host geton, vet geton vern tsu dir,</para>
  <para style="q" vid="OBA 1:15">dain tuung vet zich umkeren oif dain kop.<verse eid="OBA 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="OBA 1:16" />vorem vi ir hot getrunken oif main heilikn barg,</para>
  <para style="q" vid="OBA 1:16">veln trinken ale felker tamid;</para>
  <para style="q" vid="OBA 1:16">yo, zei veln trinken un zupn,</para>
  <para style="q" vid="OBA 1:16">un vern vi kein mol nisht geven.<verse eid="OBA 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="OBA 1:17" />ober oif dem barg Tsiyon vet zain an antrinung,</para>
  <para style="q" vid="OBA 1:17">un er vet zain heilik;</para>
  <para style="q" vid="OBA 1:17">un dos hoiz fun Yaakov vet arben zeyere arbungen.<verse eid="OBA 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="OBA 1:18" />un dos hoiz fun Yaakov vet zain a faier,</para>
  <para style="q" vid="OBA 1:18">un dos hoiz fun Yosef a flam,</para>
  <para style="q" vid="OBA 1:18">un dos hoiz fun Esav tsu shtroi,</para>
  <para style="q" vid="OBA 1:18">un zei veln zei ontsindn un zei fartseren,</para>
  <para style="q" vid="OBA 1:18">un kein iberblaib vet nisht zain fun dem hoiz fun Esav;</para>
  <para style="q" vid="OBA 1:18">vorem Hashem hot geredt.<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="OBA 1:19" />un di vos in dorem veln arben dem barg Esav,</para>
  <para style="q" vid="OBA 1:19">un di vos in der niderung – di Pelishtim;</para>
  <para style="q" vid="OBA 1:19">un zei veln arben dos feld fun Efrayim,</para>
  <para style="q" vid="OBA 1:19">un dos feld fun Shomron;</para>
  <para style="q" vid="OBA 1:19">un Binyamin vet arben Gilad.<verse eid="OBA 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="OBA 1:20" />un di dozike fartribene machne fun di kinder fun Yisroel</para>
  <para style="q" vid="OBA 1:20">veln yrsheanen di Kenaanim biz Tsarfat,</para>
  <para style="q" vid="OBA 1:20">un di fartribene fun Yerushalayim vos in Sefarad,</para>
  <para style="q" vid="OBA 1:20">veln arben di shtet fun dorem.<verse eid="OBA 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="OBA 1:21" />un helfer veln aroifgein oifn barg Tsiyon,</para>
  <para style="q" vid="OBA 1:21">tsu mishpetn dem barg Esav,</para>
  <para style="q" vid="OBA 1:21">un di meluche vet zain bai Hashem.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>