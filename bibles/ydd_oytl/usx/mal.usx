<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAL" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Malachi</para>
  <para style="toc2">Malachi</para>
  <para style="toc1">Malachi</para>
  <para style="mt1">Malachi</para>
  <chapter number="1" style="c" pubnumber="א" sid="MAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAL 1:1" />di nevue fun Hashems vort tsu Yisroel durch Malachien:<verse eid="MAL 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="MAL 1:2" />ich hob aich lib gehat, zogt Hashem.</para>
  <para style="q" vid="MAL 1:2">un ir zogt: mit vos hostu undz lib gehat?</para>
  <para style="q" vid="MAL 1:2">iz nisht Esav Yaakovs a bruder? zogt Hashem,</para>
  <para style="q" vid="MAL 1:2">fun dervegn hob ich Yaakovn lib gehat,<verse eid="MAL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAL 1:3" />un Esavn hob ich faint gehat,</para>
  <para style="q" vid="MAL 1:3">un gemacht zaine berg a vistenish,</para>
  <para style="q" vid="MAL 1:3">un zain nachle far midber-shakaln.<verse eid="MAL 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAL 1:4" />oib Edom zogt:</para>
  <para style="q" vid="MAL 1:4">mir zainen tseshtert gevorn,</para>
  <para style="q" vid="MAL 1:4">ober mir veln vider opboien di churves,</para>
  <para style="q" vid="MAL 1:4">hot Hashem Tseva'ot azoi gezogt:</para>
  <para style="q" vid="MAL 1:4">zei veln boien, un ich vel tseshtern,</para>
  <para style="q" vid="MAL 1:4">un me vet zei rufn der gemark fun shlechtikeit,</para>
  <para style="q" vid="MAL 1:4">un dos folk vos Hashem hot farsholten oif eibik.<verse eid="MAL 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAL 1:5" />un aiere oign veln zen,</para>
  <para style="q" vid="MAL 1:5">un ir vet zogn:</para>
  <para style="q" vid="MAL 1:5">Hashem iz grois ariber dem gemark fun Yisroel.<verse eid="MAL 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MAL 1:6" />a zun git koved a foter,</para>
  <para style="q" vid="MAL 1:6">un a knecht zain har;</para>
  <para style="q" vid="MAL 1:6">iz oib ich bin a foter,</para>
  <para style="q" vid="MAL 1:6">vu iz main koved?</para>
  <para style="q" vid="MAL 1:6">un oib ich bin a har,</para>
  <para style="q" vid="MAL 1:6">vu iz di moire far mir?</para>
  <para style="q" vid="MAL 1:6">zogt Hashem Tseva'ot tsu aich, koyanim,</para>
  <para style="q" vid="MAL 1:6">vos zait mevaze main nomen.</para>
  <para style="q" vid="MAL 1:6">un ir zogt: mit vos zainen mir mevaze dain nomen?<verse eid="MAL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAL 1:7" />ir brengt oif main mizbeyech umverdike shpaiz.</para>
  <para style="q" vid="MAL 1:7">un ir zogt: mit vos hobn mir dich farumverdikt?</para>
  <para style="q" vid="MAL 1:7">mit aier zogn: der tish fun Hashem iz nimes.<verse eid="MAL 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAL 1:8" />un az ir brengt a blinds korben tsu shlachtn,</para>
  <para style="q" vid="MAL 1:8">iz kein beiz nisht!</para>
  <para style="q" vid="MAL 1:8">un az ir brengt a hinkediks un a kranks,</para>
  <para style="q" vid="MAL 1:8">iz kein beiz nisht!</para>
  <para style="q" vid="MAL 1:8">genen es akorsht tsu dain firsht,</para>
  <para style="q" vid="MAL 1:8">tsi er vet dich bavilikn,</para>
  <para style="q" vid="MAL 1:8">oder vet dich oifnemen?</para>
  <para style="q" vid="MAL 1:8">zogt Hashem Tseva'ot.<verse eid="MAL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAL 1:9" />un atsund bet akorsht bai El,</para>
  <para style="q" vid="MAL 1:9">er zol undz laitzelikn!</para>
  <para style="q" vid="MAL 1:9">durch aier hant iz dos geshen;</para>
  <para style="q" vid="MAL 1:9">ken er oifnemen dem ponem fun emitsn fun aich?</para>
  <para style="q" vid="MAL 1:9">zogt Hashem Tseva'ot.<verse eid="MAL 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="MAL 1:10" />volt gor ver fun aich tsushlisen di tirn,</para>
  <para style="q" vid="MAL 1:10">un ir zolt nisht ontsindn faier oif main mizbeyech umzist!</para>
  <para style="q" vid="MAL 1:10">ich vil aich nisht hobn,</para>
  <para style="q" vid="MAL 1:10">zogt Hashem Tseva'ot,</para>
  <para style="q" vid="MAL 1:10">un vel nisht bavilikn kein korben fun aier hant.<verse eid="MAL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAL 1:11" />vorem fun oifgang fun der zun un biz ir untergang</para>
  <para style="q" vid="MAL 1:11">iz main nomen grois tsvishn di felker,</para>
  <para style="q" vid="MAL 1:11">un in itlechn ort vert vairech gebracht tsu main nomen</para>
  <para style="q" vid="MAL 1:11">un shpaizopfer reine;</para>
  <para style="q" vid="MAL 1:11">vail main nomen iz grois tsvishn di felker,</para>
  <para style="q" vid="MAL 1:11">zogt Hashem Tseva'ot.<verse eid="MAL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAL 1:12" />un ir farshvecht im mit aier zogn:</para>
  <para style="q" vid="MAL 1:12">der tish fun Adonoi iz umverdik,</para>
  <para style="q" vid="MAL 1:12">un zain frucht, zain shpaiz, iz nimes.<verse eid="MAL 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MAL 1:13" />un ir zogt: ze, vos far a tirch!</para>
  <para style="q" vid="MAL 1:13">un ir blozt deroif,</para>
  <para style="q" vid="MAL 1:13">zogt Hashem Tseva'ot;</para>
  <para style="q" vid="MAL 1:13">un ir brengt a gegzlt,</para>
  <para style="q" vid="MAL 1:13">un a hinkediks un a kranks;</para>
  <para style="q" vid="MAL 1:13">un az ir brengt dem korben,</para>
  <para style="q" vid="MAL 1:13">zol ich im bavilikn fun aier hant?</para>
  <para style="q" vid="MAL 1:13">zogt Hashem.<verse eid="MAL 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MAL 1:14" />un farsholten zol zain der listiker,</para>
  <para style="q" vid="MAL 1:14">vos in zain stade iz do a zocher,</para>
  <para style="q" vid="MAL 1:14">un er iz mender un shlacht a gefelerts tsu Adonoi;</para>
  <para style="q" vid="MAL 1:14">vorem a groiser kinig bin ich,</para>
  <para style="q" vid="MAL 1:14">zogt Hashem Tseva'ot,</para>
  <para style="q" vid="MAL 1:14">un main nomen iz forchtik tsvishn di felker.<verse eid="MAL 1:14" /></para>
  <chapter eid="MAL 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="MAL 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAL 2:1" />un atsund, tsu aich iz der doziker onzog, ir koyanim:<verse eid="MAL 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="MAL 2:2" />oib ir vet nisht tsuhern,</para>
  <para style="q" vid="MAL 2:2">un oib ir vet nisht arainnemen in hartsn,</para>
  <para style="q" vid="MAL 2:2">tsu gebn koved tsu main nomen,</para>
  <para style="q" vid="MAL 2:2">zogt Hashem Tseva'ot,</para>
  <para style="q" vid="MAL 2:2">vel ich onshikn oif aich a klole,</para>
  <para style="q" vid="MAL 2:2">un ich vel farshiltn aiere geretenishn,</para>
  <para style="q" vid="MAL 2:2">yo, ich tu zei farshiltn,</para>
  <para style="q" vid="MAL 2:2">vail ir nemt nisht tsum hartsn.<verse eid="MAL 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAL 2:3" />zet, ich vel onshraien bai aich oif der zerie;</para>
  <para style="q" vid="MAL 2:3">un ich vel tseshitn mist oif aiere penemer,</para>
  <para style="q" vid="MAL 2:3">dem mist fun aiere yom-tov-korbones;</para>
  <para style="q" vid="MAL 2:3">un me vet aich avektrogen mit im.<verse eid="MAL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAL 2:4" />un ir vet visen</para>
  <para style="q" vid="MAL 2:4">az ich hob aich geshikt dem dozikn onzog,</para>
  <para style="q" vid="MAL 2:4">kedei main bris zol blaibn mit Levi,</para>
  <para style="q" vid="MAL 2:4">zogt Hashem Tseva'ot.<verse eid="MAL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAL 2:5" />main bris iz mit im geven oif lebn un frid,</para>
  <para style="q" vid="MAL 2:5">un ich hob zei im gegebn,</para>
  <para style="q" vid="MAL 2:5">oif moire, un er hot far mir moire gehat,</para>
  <para style="q" vid="MAL 2:5">un far main nomen hot er geangst.<verse eid="MAL 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAL 2:6" />di toyre fun emes iz geven in zain moil,</para>
  <para style="q" vid="MAL 2:6">un kein umrecht hot zich nisht gefunen oif zaine lipn;</para>
  <para style="q" vid="MAL 2:6">in frid un in rechtfartikeit iz er mit mir gegangen,</para>
  <para style="q" vid="MAL 2:6">un fil hot er opgekert fun zind.<verse eid="MAL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAL 2:7" />vorem di lipn fun koyen darfn hitn kenshaft,</para>
  <para style="q" vid="MAL 2:7">un di toyre darf men zuchn fun zain moil,</para>
  <para style="q" vid="MAL 2:7">vail der sheliech fun Hashem Tseva'ot iz er.<verse eid="MAL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAL 2:8" />ober ir hot zich opgekert fun veg,</para>
  <para style="q" vid="MAL 2:8">ir hot gemacht shtroichlen fil in der toyre,</para>
  <para style="q" vid="MAL 2:8">ir hot fardorben dem bris fun Levi,</para>
  <para style="q" vid="MAL 2:8">zogt Hashem Tseva'ot.<verse eid="MAL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAL 2:9" />derum hob ich oich aich gemacht</para>
  <para style="q" vid="MAL 2:9">nivze un shofl bai dem gantsn folk,</para>
  <para style="q" vid="MAL 2:9">vedlik vi ir hit nisht maine vegen,</para>
  <para style="q" vid="MAL 2:9">un shanevet mentshn in gezets.<verse eid="MAL 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="MAL 2:10" />iz nisht ein foter bai undz alemen?</para>
  <para style="q" vid="MAL 2:10">hot undz nisht ein El bashafn?</para>
  <para style="q" vid="MAL 2:10">far vos zoln mir felshn einer on andern,</para>
  <para style="q" vid="MAL 2:10">tsu farshvechn dem bris fun undzere eltern?<verse eid="MAL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAL 2:11" />gefelsht hot Yehudah,</para>
  <para style="q" vid="MAL 2:11">un umverdikeit iz geton gevorn</para>
  <para style="q" vid="MAL 2:11">in Yisroel un in Yerushalayim,</para>
  <para style="q" vid="MAL 2:11">vorem farshvecht hot Yehudah</para>
  <para style="q" vid="MAL 2:11">di heilikeit fun Hashem vos er hot lib gehat,</para>
  <para style="q" vid="MAL 2:11">un hot bamant di tochter fun a fremdn G-t.<verse eid="MAL 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAL 2:12" />Hashem vet farshnaidn bai dem man vos tut dos,</para>
  <para style="q" vid="MAL 2:12">a rufer un an entferer fun di getseltn fun Yaakov,</para>
  <para style="q" vid="MAL 2:12">un dem vos brengt a korben tsu Hashem Tseva'ot.<verse eid="MAL 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="MAL 2:13" />un tsveitns tut ir ot vos:</para>
  <para style="q" vid="MAL 2:13">ir badekt dem mizbeyech fun Hashem mit trern.</para>
  <para style="q" vid="MAL 2:13">mit gevein un mit ziftsenish,</para>
  <para style="q" vid="MAL 2:13">biz er ken zich mer nisht kern tsum korben,</para>
  <para style="q" vid="MAL 2:13">un im onnemen mit bavilikung fun aier hant.<verse eid="MAL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MAL 2:14" />un ir zogt: far vos? –</para>
  <para style="q" vid="MAL 2:14">vail Hashem iz eides</para>
  <para style="q" vid="MAL 2:14">tsvishn dir un der vaib fun dain yugnt,</para>
  <para style="q" vid="MAL 2:14">vos du host gefelsht on ir,</para>
  <para style="q" vid="MAL 2:14">hagam zi iz dain chaverte,</para>
  <para style="q" vid="MAL 2:14">un di vaib fun dain bris.<verse eid="MAL 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAL 2:15" />un kein einer vet dos nisht ton</para>
  <para style="q" vid="MAL 2:15">vos hot an iberblaib fun gaist.</para>
  <para style="q" vid="MAL 2:15">vorem vos farlangt yetveder einer?</para>
  <para style="q" vid="MAL 2:15">a zomen fun Elokim.</para>
  <para style="q" vid="MAL 2:15">derum zolt ir zain opgehit in aier gaist,</para>
  <para style="q" vid="MAL 2:15">un on der vaib fun zain yugnt zol men nisht felshn.<verse eid="MAL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAL 2:16" />vorem ich hob faint sheidung,</para>
  <para style="q" vid="MAL 2:16">zogt Hashem Elokei Yisroel,</para>
  <para style="q" vid="MAL 2:16">un dem vos badekt zain kleid mit umrecht,</para>
  <para style="q" vid="MAL 2:16">zogt Hashem Tseva'ot;</para>
  <para style="q" vid="MAL 2:16">derum zolt ir zain opgehit in aier gaist,</para>
  <para style="q" vid="MAL 2:16">az ir zolt nisht felshn.<verse eid="MAL 2:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="MAL 2:17" />ir hot mid gemacht Hashem mit aiere reid,</para>
  <para style="q" vid="MAL 2:17">un ir zogt: mit vos hobn mir mid gemacht?</para>
  <para style="q" vid="MAL 2:17">mit aier zogn: itlecher vos tut beiz,</para>
  <para style="q" vid="MAL 2:17">iz gut in di oign fun Hashem,</para>
  <para style="q" vid="MAL 2:17">un zei vil er hobn;</para>
  <para style="q" vid="MAL 2:17">oder, vu iz der Elokim fun gerechtikeit?<verse eid="MAL 2:17" /></para>
  <chapter eid="MAL 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="MAL 3" />
  <para style="q">
    <verse number="1" style="v" sid="MAL 3:1" />ze, ich shik main sheliech,</para>
  <para style="q" vid="MAL 3:1">un er vet opramen dem veg far mir,</para>
  <para style="q" vid="MAL 3:1">un plutsling vet kumen tsu zain heichl</para>
  <para style="q" vid="MAL 3:1">HaAdon vemen ir zucht;</para>
  <para style="q" vid="MAL 3:1">un der sheliech fun bris vemen ir bagert,</para>
  <para style="q" vid="MAL 3:1">ot kumt er, zogt Hashem Tseva'ot.<verse eid="MAL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MAL 3:2" />un ver ken oishaltn dem tog fun zain kumen?</para>
  <para style="q" vid="MAL 3:2">un ver iz der vos ken bashtein, ven er bavaizt zich?</para>
  <para style="q" vid="MAL 3:2">vorem er iz vi faier fun dem shmeltser,</para>
  <para style="q" vid="MAL 3:2">un vi loig fun vesher.<verse eid="MAL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAL 3:3" />un er vet zitsn vi a shmeltser un a reiniker fun zilber,</para>
  <para style="q" vid="MAL 3:3">un vet reiniken di kinder fun Levi,</para>
  <para style="q" vid="MAL 3:3">un zei laitern vi gold un vi zilber;</para>
  <para style="q" vid="MAL 3:3">un zei veln brengen tsu Hashem</para>
  <para style="q" vid="MAL 3:3">korbones in gerechtikeit.<verse eid="MAL 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAL 3:4" />un ongeleigt vet zain bai Hashem</para>
  <para style="q" vid="MAL 3:4">der korben fun Yehudah un Yerushalayim,</para>
  <para style="q" vid="MAL 3:4">vi in di teg fun amol,</para>
  <para style="q" vid="MAL 3:4">un vi in fartsaitike yorn.<verse eid="MAL 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAL 3:5" />un ich vel genenen tsum mishpot oif aich,</para>
  <para style="q" vid="MAL 3:5">un ich vel zain a shneler eides,</para>
  <para style="q" vid="MAL 3:5">akegn di mechashfim, un akegn di nofim,</para>
  <para style="q" vid="MAL 3:5">un akegn di vos shvern falsh,</para>
  <para style="q" vid="MAL 3:5">un akegn di vos roibn dem loinarbeter fun zain loin,</para>
  <para style="q" vid="MAL 3:5">di almone un dem yosem,</para>
  <para style="q" vid="MAL 3:5">un krivden dem fremdn,</para>
  <para style="q" vid="MAL 3:5">un hobn nisht kein moire far mir,</para>
  <para style="q" vid="MAL 3:5">zogt Hashem Tseva'ot.<verse eid="MAL 3:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MAL 3:6" />ober ich Hashem ender zich nisht,</para>
  <para style="q" vid="MAL 3:6">un ir kinder fun Yaakov vet nisht farlendt vern.<verse eid="MAL 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAL 3:7" />fun di teg fun aiere eltern on</para>
  <para style="q" vid="MAL 3:7">hot ir zich opgekert fun maine gezetsn,</para>
  <para style="q" vid="MAL 3:7">un zei nisht gehit;</para>
  <para style="q" vid="MAL 3:7">kert aich um tsu mir, un ich vel zich umkeren tsu aich,</para>
  <para style="q" vid="MAL 3:7">zogt Hashem Tseva'ot.</para>
  <para style="q" vid="MAL 3:7">ober ir zogt: vegen vos zoln mir zich umkeren?<verse eid="MAL 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAL 3:8" />tsi darf a mentsh baroibn Elokim,</para>
  <para style="q" vid="MAL 3:8">vos ir baroibt mich?</para>
  <para style="q" vid="MAL 3:8">un ir zogt: in vos baroibn mir dich?</para>
  <para style="q" vid="MAL 3:8">in dem maiser un der opsheidung.<verse eid="MAL 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAL 3:9" />ir zait mit a klole farsholten ,</para>
  <para style="q" vid="MAL 3:9">fun dest vegen baroibt ir mich,</para>
  <para style="q" vid="MAL 3:9">dos gantse folk.<verse eid="MAL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAL 3:10" />brengt dem gantsn maiser in shatshoiz,</para>
  <para style="q" vid="MAL 3:10">un zol zain shpaiz in main hoiz,</para>
  <para style="q" vid="MAL 3:10">un pruvet mich akorsht dermit,</para>
  <para style="q" vid="MAL 3:10">zogt Hashem Tseva'ot,</para>
  <para style="q" vid="MAL 3:10">oib ich vel aich nisht efenen di fentster fun himel,</para>
  <para style="q" vid="MAL 3:10">un vel aich nisht aropgisn a broche</para>
  <para style="q" vid="MAL 3:10">biz iber genug.<verse eid="MAL 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAL 3:11" />un ich vel onshraien fun aiertvegn oif dem fartserer,</para>
  <para style="q" vid="MAL 3:11">un er vet aich nisht farvistn di frucht fun der erd,</para>
  <para style="q" vid="MAL 3:11">un aier vainshtok vet nisht farvorfen in feld,</para>
  <para style="q" vid="MAL 3:11">zogt Hashem Tseva'ot.<verse eid="MAL 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAL 3:12" />un ale felker veln aich shatsn gliklech,</para>
  <para style="q" vid="MAL 3:12">vorem ir vet zain a gevintsht land,</para>
  <para style="q" vid="MAL 3:12">zogt Hashem Tseva'ot.<verse eid="MAL 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="MAL 3:13" />farshait zainen aiere reid kegen mir,</para>
  <para style="q" vid="MAL 3:13">zogt Hashem. un ir zogt:</para>
  <para style="q" vid="MAL 3:13">vos hobn mir geredt akegn dir?<verse eid="MAL 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MAL 3:14" />ir hot gezogt: umzist iz dinen Elokim,</para>
  <para style="q" vid="MAL 3:14">un vos kumt arois az mir hobn gehit zain hitung,</para>
  <para style="q" vid="MAL 3:14">un az mir zainen umgegangen fintster</para>
  <para style="q" vid="MAL 3:14">fun vegen Hashem Tseva'ot?<verse eid="MAL 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAL 3:15" />iz, atsund shatsn mir gliklech di mutvilike;</para>
  <para style="q" vid="MAL 3:15">yo, oifgericht gevorn zainen di vos tuen shlechts,</para>
  <para style="q" vid="MAL 3:15">yo, zei hobn gepruvet Elokim, un zainen antrunen gevorn.<verse eid="MAL 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="MAL 3:16" />dens mol hobn di forchtike fun Hashem</para>
  <para style="q" vid="MAL 3:16">geredt einer tsum andern,</para>
  <para style="q" vid="MAL 3:16">un G-t hot farnumen un tsugehert,</para>
  <para style="q" vid="MAL 3:16">un a buch fun dermonung iz ongeshriben gevorn bai im,</para>
  <para style="q" vid="MAL 3:16">far di vos forchtn Hashem,</para>
  <para style="q" vid="MAL 3:16">un trachtn on zain nomen.<verse eid="MAL 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MAL 3:17" />un zei veln mir zain a taier eigens,</para>
  <para style="q" vid="MAL 3:17">zogt Hashem Tseva'ot,</para>
  <para style="q" vid="MAL 3:17">in dem tog vos ich basher;</para>
  <para style="q" vid="MAL 3:17">un ich vel zich derbaremen oif zei,</para>
  <para style="q" vid="MAL 3:17">vi a man derbaremt zich oif zain zun vos dint im.<verse eid="MAL 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAL 3:18" />un ir vet vider ainzen</para>
  <para style="q" vid="MAL 3:18">tsvishn dem tsadik un dem roshe,</para>
  <para style="q" vid="MAL 3:18">tsvishn dem vos dint Elokim,</para>
  <para style="q" vid="MAL 3:18">un der vos dint im nisht.<verse eid="MAL 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" pubnumber="4.1" sid="MAL 3:19" /> vorem ze, der tog kumt,</para>
  <para style="q" vid="MAL 3:19">er brent vi an oivn,</para>
  <para style="q" vid="MAL 3:19">un ale mutvilike un ale vos tuen shlechts</para>
  <para style="q" vid="MAL 3:19">veln zain shtroi,</para>
  <para style="q" vid="MAL 3:19">un ontsindn vet zei der tog vos kumt,</para>
  <para style="q" vid="MAL 3:19">zogt Hashem Tseva'ot,</para>
  <para style="q" vid="MAL 3:19">az er vet zei nisht iberlozen</para>
  <para style="q" vid="MAL 3:19">a vortsel oder a tsvaig.<verse eid="MAL 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" pubnumber="4.2" sid="MAL 3:20" /> ober aich, vos hot moire far main nomen,</para>
  <para style="q" vid="MAL 3:20">vet oifgein di zun fun gerechtikeit</para>
  <para style="q" vid="MAL 3:20">mit heilung in ire fliglen;</para>
  <para style="q" vid="MAL 3:20">un ir vet aroisgein</para>
  <para style="q" vid="MAL 3:20">un vet shpringen vi kelber fun shtal.<verse eid="MAL 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" pubnumber="4.3" sid="MAL 3:21" /> un ir vet tsudrikn di reshoim,</para>
  <para style="q" vid="MAL 3:21">vorem zei veln zain ash unter aiere fustrit</para>
  <para style="q" vid="MAL 3:21">in dem tog vos ich basher,</para>
  <para style="q" vid="MAL 3:21">zogt Hashem Tseva'ot.<verse eid="MAL 3:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" pubnumber="4.4" sid="MAL 3:22" /> gedenkt di toyre fun main knecht Mosheen,</para>
  <para style="q" vid="MAL 3:22">vos ich hob im bafoiln in Chorev far gants Yisroel,</para>
  <para style="q" vid="MAL 3:22">chukkim un gezetsn.<verse eid="MAL 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" pubnumber="4.5" sid="MAL 3:23" /> zet, ich shik tsu aich Eliyahu hanovi,</para>
  <para style="q" vid="MAL 3:23">eider es kumt der tog fun Hashem,</para>
  <para style="q" vid="MAL 3:23">der groiser un der mordiker.<verse eid="MAL 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" pubnumber="4.6" sid="MAL 3:24" /> un er vet umkeren dos harts fun di avot tsu di kinder,</para>
  <para style="q" vid="MAL 3:24">un dos harts fun di kinder tsu zeyere avot,</para>
  <para style="q" vid="MAL 3:24">kedei ich zol nisht kumen,</para>
  <para style="q" vid="MAL 3:24">un shlogn di erd mit a cheirem.<verse eid="MAL 3:24" /></para>
  <chapter eid="MAL 3" />
  <chapter number="4" style="c" sid="MAL 4" />
  <chapter eid="MAL 4" />
</usx>