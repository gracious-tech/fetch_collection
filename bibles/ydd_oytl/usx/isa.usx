<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Yeshayah</para>
  <para style="toc2">Yeshayah</para>
  <para style="toc1">Yeshayah</para>
  <para style="mt1">Yeshayah</para>
  <chapter number="1" style="c" pubnumber="א" sid="ISA 1" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1" />di zeung fun Yeshayahu dem zun fun Amotsn, vos er hot gezen oif Yehudah un Yerushalayim, in di teg fun Uziyahu, Yotam, Achaz, Yechizkiyahu, di mlochim fun Yehudah.<verse eid="ISA 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 1:2" />hert ir himlen, un farnem du erd,</para>
  <para style="q" vid="ISA 1:2">vorem Hashem hot geredt:</para>
  <para style="q" vid="ISA 1:2">kinder hob ich dertsoign un oifgebracht,</para>
  <para style="q" vid="ISA 1:2">un zei hobn gebrochn on mir.<verse eid="ISA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 1:3" />an oks veis zain baal-habait,</para>
  <para style="q" vid="ISA 1:3">un an eizl di korite fun zain har;</para>
  <para style="q" vid="ISA 1:3">Yisroel veis nisht,</para>
  <para style="q" vid="ISA 1:3">main folk kukt zich nisht um.<verse eid="ISA 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 1:4" />vei, zindike ume,</para>
  <para style="q" vid="ISA 1:4">folk mit farbrechn bashvert,</para>
  <para style="q" vid="ISA 1:4">zomen fun shlechtstuer, kinder fardorbene!</para>
  <para style="q" vid="ISA 1:4">farlozt hobn zei Hashem,</para>
  <para style="q" vid="ISA 1:4">gelestert dem heilikn fun Yisroel,</para>
  <para style="q" vid="ISA 1:4">ahinter zich opgekert.<verse eid="ISA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 1:5" />vu noch vilt ir geshlogn vern,</para>
  <para style="q" vid="ISA 1:5">vos ir kert aich noch mer op?</para>
  <para style="q" vid="ISA 1:5">der gantser kop iz krank,</para>
  <para style="q" vid="ISA 1:5">un dos gantse harts iz in veitog;<verse eid="ISA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 1:6" />fun fustrit bizn kop</para>
  <para style="q" vid="ISA 1:6">iz in im kein gants glid nishto,</para>
  <para style="q" vid="ISA 1:6">nor a ris un a beil un an aiterik vund;</para>
  <para style="q" vid="ISA 1:6">nisht oisgedrikt zainen zei gevorn,</para>
  <para style="q" vid="ISA 1:6">un nisht farbundn, un nisht mit eil derveicht.<verse eid="ISA 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 1:7" />aier land iz a vistenish,</para>
  <para style="q" vid="ISA 1:7">aiere shtet zainen in faier farbrent;</para>
  <para style="q" vid="ISA 1:7">aier erd – fremde fartseren zi aich antkegen,</para>
  <para style="q" vid="ISA 1:7">un vist iz zi vi der iberker fun a fleitsung.<verse eid="ISA 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 1:8" />un geblibn iz tochter Tsiyon,</para>
  <para style="q" vid="ISA 1:8">vi a baidl in a vaingorten,</para>
  <para style="q" vid="ISA 1:8">vi a nachtleg in a plutserfeld,</para>
  <para style="q" vid="ISA 1:8">vi a vachbud fun ritlech.<verse eid="ISA 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 1:9" />ven nisht Hashem Tseva'ot</para>
  <para style="q" vid="ISA 1:9">volt undz a klein iberblaib gelozt,</para>
  <para style="q" vid="ISA 1:9">voltn mir vi Sodom gevorn,</para>
  <para style="q" vid="ISA 1:9">tsu Amora voltn mir geven geglichn.<verse eid="ISA 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 1:10" />hert dos vort fun Hashem,</para>
  <para style="q" vid="ISA 1:10">ir harn fun Sodom;</para>
  <para style="q" vid="ISA 1:10">farnemt di toyre fun Elokeinu,</para>
  <para style="q" vid="ISA 1:10">ir folk fun Amora.<verse eid="ISA 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 1:11" />tsu vos mir</para>
  <para style="q" vid="ISA 1:11">aiere fil shlachtopfer? zogt Hashem,</para>
  <para style="q" vid="ISA 1:11">ich bin zat mit brandopfer fun viders,</para>
  <para style="q" vid="ISA 1:11">un mit fets fun geshtopte;</para>
  <para style="q" vid="ISA 1:11">un blut fun oksen un shepsn un bek</para>
  <para style="q" vid="ISA 1:11">vil ich nisht farlangen.<verse eid="ISA 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 1:12" />az ir kumt zich vaizn far mir,</para>
  <para style="q" vid="ISA 1:12">ver bet dos fun aich maine hoifn tsu tretn?<verse eid="ISA 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 1:13" />nisht brengt mer korbones umzist,</para>
  <para style="q" vid="ISA 1:13">an umverdike demfung iz dos mir;</para>
  <para style="q" vid="ISA 1:13">rosh-choidesh un Shabbos, rufn a farzamlunge –</para>
  <para style="q" vid="ISA 1:13">umrecht mit ainzamlung ken ich nisht laidn;<verse eid="ISA 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 1:14" />aiere rosh-choideshn un aiere yom-tuvim</para>
  <para style="q" vid="ISA 1:14">hot faint main zel;</para>
  <para style="q" vid="ISA 1:14">zei zainen mir tsu last gevorn,</para>
  <para style="q" vid="ISA 1:14">ich ken zei nisht fartrogen.<verse eid="ISA 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 1:15" />un az ir shpreit ois aiere hent,</para>
  <para style="q" vid="ISA 1:15">vel ich farhoiln maine oign fun aich;</para>
  <para style="q" vid="ISA 1:15">un fil ir zolt nisht tfile ton,</para>
  <para style="q" vid="ISA 1:15">her ich nisht tsu;</para>
  <para style="q" vid="ISA 1:15">aiere hent zainen ful mit blut.<verse eid="ISA 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 1:16" />vasht aich, reinikt aich,</para>
  <para style="q" vid="ISA 1:16">tut op aiere shlechte meisim</para>
  <para style="q" vid="ISA 1:16">fun kegen maine oign,</para>
  <para style="q" vid="ISA 1:16">hert oif shlechts ton;<verse eid="ISA 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 1:17" />lernt guts ton,</para>
  <para style="q" vid="ISA 1:17">zucht gerechtikeit,</para>
  <para style="q" vid="ISA 1:17">shtarkt dem gedriktn,</para>
  <para style="q" vid="ISA 1:17">tut recht dem yosem,</para>
  <para style="q" vid="ISA 1:17">nemt zich on far der almone.<verse eid="ISA 1:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 1:18" />kumt nor, un lomir zich durchredn,</para>
  <para style="q" vid="ISA 1:18">zogt Hashem:</para>
  <para style="q" vid="ISA 1:18">oib aiere zind veln vi karmin zain,</para>
  <para style="q" vid="ISA 1:18">veln zei vais vi shnei vern;</para>
  <para style="q" vid="ISA 1:18">oib zei veln roit zain vi vermilfarb,</para>
  <para style="q" vid="ISA 1:18">veln zei vi vol vern.<verse eid="ISA 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 1:19" />oib ir vet veln un vet tsuhern,</para>
  <para style="q" vid="ISA 1:19">vet ir esen dos guts funem land;<verse eid="ISA 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 1:20" />ober az ir vet nisht veln, un vet vidershpenikn,</para>
  <para style="q" vid="ISA 1:20">vet ir fun der shverd gegesn vern;</para>
  <para style="q" vid="ISA 1:20">vorem dos moil fun Hashem hot geredt.<verse eid="ISA 1:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 1:21" />vi iz a zoine gevorn di getraie shtot!</para>
  <para style="q" vid="ISA 1:21">geven ful mit gerechtikeit,</para>
  <para style="q" vid="ISA 1:21">rechtfartikeit flegt ruen in ir,</para>
  <para style="q" vid="ISA 1:21">un atsunderto – merders.<verse eid="ISA 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 1:22" />dain zilber iz psoles gevorn,</para>
  <para style="q" vid="ISA 1:22">dain trank iz mit vaser gemisht.<verse eid="ISA 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 1:23" />daine harn zainen opkerers,</para>
  <para style="q" vid="ISA 1:23">un chaverim fun ganovem;</para>
  <para style="q" vid="ISA 1:23">itlecher hot lib shochad,</para>
  <para style="q" vid="ISA 1:23">un yogt zich noch getsolt;</para>
  <para style="q" vid="ISA 1:23">dem yosem tuen zei nisht kein recht,</para>
  <para style="q" vid="ISA 1:23">un der shtrait fun der almone geit zei nisht on.<verse eid="ISA 1:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 1:24" />derum zogt der har,</para>
  <para style="q" vid="ISA 1:24">Hashem Tseva'ot, der machtiker fun Yisroel:</para>
  <para style="q" vid="ISA 1:24">o, ich vel zich shtiln on maine faint,</para>
  <para style="q" vid="ISA 1:24">un zich noikem zain on maine sonim.<verse eid="ISA 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 1:25" />un ich vel kern main hant oif dir,</para>
  <para style="q" vid="ISA 1:25">un laitern vi mit loig daine psoles,</para>
  <para style="q" vid="ISA 1:25">un opton ale daine blaien.<verse eid="ISA 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 1:26" />un ich vel umkeren daine richter vi tsuersht,</para>
  <para style="q" vid="ISA 1:26">un daine yoetsim vi in onheib;</para>
  <para style="q" vid="ISA 1:26">dernoch vet men dich rufn</para>
  <para style="q" vid="ISA 1:26">der kerch fun gerechtikeit, di getraie shtot.<verse eid="ISA 1:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 1:27" />Tsiyon vet durch gerechtikeit derleizt vern,</para>
  <para style="q" vid="ISA 1:27">un ire tsurikgekerte durch rechtfartikeit.<verse eid="ISA 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 1:28" />un a broch oif di farbrecher un zindike in einem;</para>
  <para style="q" vid="ISA 1:28">un di vos farlozen Hashem, veln farlendt vern.<verse eid="ISA 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 1:29" />vorem me vet tsu shand vern</para>
  <para style="q" vid="ISA 1:29">fun di eichnbeimer vos ir hot geglust,</para>
  <para style="q" vid="ISA 1:29">un ir vet zich shemen</para>
  <para style="q" vid="ISA 1:29">mit di gertner vos ir hot oisderveilt.<verse eid="ISA 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 1:30" />vorem ir vet zain vi a terebint</para>
  <para style="q" vid="ISA 1:30">vos zain blat vert farvelkt,</para>
  <para style="q" vid="ISA 1:30">un vi a gortn</para>
  <para style="q" vid="ISA 1:30">vos hot nisht kein vaser.<verse eid="ISA 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 1:31" />un der shtarker vet vern vi flaksshtroi,</para>
  <para style="q" vid="ISA 1:31">un zain verk a funk</para>
  <para style="q" vid="ISA 1:31">un beide in einem veln brenen,</para>
  <para style="q" vid="ISA 1:31">un kein lesher vet nisht zain.<verse eid="ISA 1:31" /></para>
  <chapter eid="ISA 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="ISA 2" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1" />dos vort vos Yeshayahu der zun fun Amotsn hot gezen oif Yehudah un Yerushalayim.<verse eid="ISA 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 2:2" />un es vet zain in sof fun di teg,</para>
  <para style="q" vid="ISA 2:2">vet shtein fest der barg fun Hashems hoiz</para>
  <para style="q" vid="ISA 2:2">oiben on fun di berg,</para>
  <para style="q" vid="ISA 2:2">un derhoibn iber di heichn;</para>
  <para style="q" vid="ISA 2:2">un ale felker veln tsu im shtromen.<verse eid="ISA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 2:3" />un fil umes veln gein un veln zogn:</para>
  <para style="q" vid="ISA 2:3">kumt, un lomir aroifgein tsum barg fun Hashem,</para>
  <para style="q" vid="ISA 2:3">tsum hoiz fun dem Elokei Yaakov;</para>
  <para style="q" vid="ISA 2:3">un er vet undz lernen fun zaine vegen,</para>
  <para style="q" vid="ISA 2:3">un mir veln gein in zaine shtegn;</para>
  <para style="q" vid="ISA 2:3">vorem fun Tsiyon vet aroisgein a toyre,</para>
  <para style="q" vid="ISA 2:3">un Hashems vort fun Yerushalayim.<verse eid="ISA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 2:4" />un er vet mishpetn tsvishn di felker,</para>
  <para style="q" vid="ISA 2:4">un antsheiden iber fil umes;</para>
  <para style="q" vid="ISA 2:4">un zei veln shmidn zeyere shverdn oif akeraizns,</para>
  <para style="q" vid="ISA 2:4">un zeyere shpizn oif tsvaigmesers;</para>
  <para style="q" vid="ISA 2:4">a folk kegen a folk vet nisht heibn a shverd,</para>
  <para style="q" vid="ISA 2:4">un me vet nisht mer lernen milchome.<verse eid="ISA 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 2:5" />hoiz fun Yaakov, kumt, un lomir gein</para>
  <para style="q" vid="ISA 2:5">in dem licht fun Hashem.<verse eid="ISA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 2:6" />vorem host farlozt dain folk, dos hoiz fun Yaakov,</para>
  <para style="q" vid="ISA 2:6">vail zei zainen ful mit kishef fun mizrech,</para>
  <para style="q" vid="ISA 2:6">un mit vorzoger azoi vi di Pelishtim,</para>
  <para style="q" vid="ISA 2:6">un mit fremdgeborene zachn gibn zei zich op.<verse eid="ISA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 2:7" />un ongefilt gevorn iz zain land mit zilber un gold,</para>
  <para style="q" vid="ISA 2:7">un nishto kein shieur tsu zaine oitseres;</para>
  <para style="q" vid="ISA 2:7">un ongefilt gevorn iz zain land mit ferd,</para>
  <para style="q" vid="ISA 2:7">un nishto kein shieur tsu zaine raitvegn.<verse eid="ISA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 2:8" />un ongefilt gevorn iz zain land mit opgeter;</para>
  <para style="q" vid="ISA 2:8">tsum verk fun zeyere hent tuen zei zich bukn,</para>
  <para style="q" vid="ISA 2:8">tsu vos zeyere finger hobn gemacht.<verse eid="ISA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 2:9" />un geboign iz der mentsh,</para>
  <para style="q" vid="ISA 2:9">un niderik iz der man,</para>
  <para style="q" vid="ISA 2:9">un du kenst zei nisht fargebn.<verse eid="ISA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 2:10" />gei arain in feldz,</para>
  <para style="q" vid="ISA 2:10">un bahalt zich in shtoib,</para>
  <para style="q" vid="ISA 2:10">far der forchtikeit fun Hashem,</para>
  <para style="q" vid="ISA 2:10">un far der pracht fun zain groiskeit.<verse eid="ISA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 2:11" />di hoferdike oign fun mentshn vern dernidert,</para>
  <para style="q" vid="ISA 2:11">un di hoichkeit fun lait vet geboign vern,</para>
  <para style="q" vid="ISA 2:11">un Hashem alein vet zain derhoibn in yenem tog.<verse eid="ISA 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 2:12" />vorem a tog iz do bai Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 2:12">oif alem shtoltsn un hoichn,</para>
  <para style="q" vid="ISA 2:12">un oif alem derhoibenem,</para>
  <para style="q" vid="ISA 2:12">es zol dernidert vern;<verse eid="ISA 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 2:13" />un oif ale tsedern fun Levanon,</para>
  <para style="q" vid="ISA 2:13">di hoiche un derhoibene,</para>
  <para style="q" vid="ISA 2:13">un oif ale eichnbeimer fun Bashan;<verse eid="ISA 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 2:14" />un oif ale hoiche berg,</para>
  <para style="q" vid="ISA 2:14">un oif ale derhoibene heichn;<verse eid="ISA 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 2:15" />un oif yetveder hoichn turem,</para>
  <para style="q" vid="ISA 2:15">un oif yetveder bafestikter moier;<verse eid="ISA 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 2:16" />un oif ale shifn fun Tarshish,</para>
  <para style="q" vid="ISA 2:16">un oif ale glustike shifn.<verse eid="ISA 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 2:17" />un di hoferdikeit fun mentshn vet geboign vern,</para>
  <para style="q" vid="ISA 2:17">un di hoichkeit fun lait vet dernidert vern,</para>
  <para style="q" vid="ISA 2:17">un Hashem alein vet zain derhoibn in yenem tog.<verse eid="ISA 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 2:18" />un di opgeter veln in gantsn fargein.<verse eid="ISA 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 2:19" />un me vet araingein in heiln fun feldzn,</para>
  <para style="q" vid="ISA 2:19">un in lecher fun der erd,</para>
  <para style="q" vid="ISA 2:19">far der forchtikeit fun Hashem,</para>
  <para style="q" vid="ISA 2:19">un far der pracht fun zain groiskeit,</para>
  <para style="q" vid="ISA 2:19">ven er shteit oif di erd oiftsutreislen.<verse eid="ISA 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 2:20" />in yenem tog vet avekvarfn der mentsh</para>
  <para style="q" vid="ISA 2:20">zaine opgeter fun zilber, un zaine opgeter fun gold,</para>
  <para style="q" vid="ISA 2:20">vos zei hobn zich gemacht, zich tsu bukn,</para>
  <para style="q" vid="ISA 2:20">far di krotn un far di fledermaiz;<verse eid="ISA 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 2:21" />kedei araintsugein in lecher fun feldzn,</para>
  <para style="q" vid="ISA 2:21">un in shpaltn fun shteiner,</para>
  <para style="q" vid="ISA 2:21">far der forchtikeit fun Hashem,</para>
  <para style="q" vid="ISA 2:21">un far der pracht fun zain groiskeit,</para>
  <para style="q" vid="ISA 2:21">ven er shteit oif di erd oiftsutreislen.<verse eid="ISA 2:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 2:22" />farmaidt aich funem mentshn vos a otem iz in zain noz,</para>
  <para style="q" vid="ISA 2:22">vorem vos iz er gerechnt?<verse eid="ISA 2:22" /></para>
  <chapter eid="ISA 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="ISA 3" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 3:1" />vorem ze, der har, Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 3:1">tut op fun Yerushalayim un fun Yehudah</para>
  <para style="q" vid="ISA 3:1">an unterlen un an onlen;</para>
  <para style="q" vid="ISA 3:1">yetveder unterlen fun broit,</para>
  <para style="q" vid="ISA 3:1">un yetveder unterlen fun vaser.<verse eid="ISA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 3:2" />dem gibor un dem man fun milchome,</para>
  <para style="q" vid="ISA 3:2">dem richter un dem novi,</para>
  <para style="q" vid="ISA 3:2">un dem vorzoger un dem eltstn;<verse eid="ISA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 3:3" />dem hoiptman fun fuftsik,</para>
  <para style="q" vid="ISA 3:3">un dem ongezeenem un dem baal-yoets,</para>
  <para style="q" vid="ISA 3:3">un dem klugn tsoiberer,</para>
  <para style="q" vid="ISA 3:3">un dem shpruchkener.<verse eid="ISA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 3:4" />un ich vel machn yinglech far zeyere harn,</para>
  <para style="q" vid="ISA 3:4">un kinder veln geveltikn iber zei.<verse eid="ISA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 3:5" />un dos folk vet zich drikn,</para>
  <para style="q" vid="ISA 3:5">einer dem andern,</para>
  <para style="q" vid="ISA 3:5">un itlecher zain chever;</para>
  <para style="q" vid="ISA 3:5">a yingel vet zich greisn kegen zoken,</para>
  <para style="q" vid="ISA 3:5">un der nivze kegen nichbad.<verse eid="ISA 3:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 3:6" />az emetser vet onchapn</para>
  <para style="q" vid="ISA 3:6">zain bruder fun zain foters hoiz:</para>
  <para style="q" vid="ISA 3:6">a beged hostu, a har zolstu undz zain,</para>
  <para style="q" vid="ISA 3:6">un di dozike shtroichlenish zol zain unter dain hant,<verse eid="ISA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 3:7" />vet er shvern in yenem tog, azoi tsu zogn:</para>
  <para style="q" vid="ISA 3:7">ich vel nisht zain kein heiler,</para>
  <para style="q" vid="ISA 3:7">az in main hoiz iz nishto kein broit un kein beged;</para>
  <para style="q" vid="ISA 3:7">ir vet mich nisht machn faran har fun folk.<verse eid="ISA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 3:8" />vorem geshtroichlt iz Yerushalayim,</para>
  <para style="q" vid="ISA 3:8">un Yehudah iz gefaln;</para>
  <para style="q" vid="ISA 3:8">vail zeyer tsung un zeyere meisim zainen kegen Hashem,</para>
  <para style="q" vid="ISA 3:8">tsu vidershpenikn di oign fun zain koved.<verse eid="ISA 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 3:9" />der onblik fun zeyer ponem zogt eides oif zei;</para>
  <para style="q" vid="ISA 3:9">un zeyer zind zogn zei ois vi Sodom, zei farleikenen nisht.</para>
  <para style="q" vid="ISA 3:9">vei tsu zeyer zel,</para>
  <para style="q" vid="ISA 3:9">vos zei hobn zich alein beiz geton.<verse eid="ISA 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 3:10" />zogt dem gerechtn az im vet zain gut,</para>
  <para style="q" vid="ISA 3:10">vail di frucht fun zeyere meisim veln zei esen.<verse eid="ISA 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 3:11" />vei tsu dem roshe, im vet zain shlecht,</para>
  <para style="q" vid="ISA 3:11">vorem di tuung fun zaine hent vet im geshen.<verse eid="ISA 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 3:12" />main folk – zaine batsvinger zainen kinder,</para>
  <para style="q" vid="ISA 3:12">un vaiber geveltikn iber im.</para>
  <para style="q" vid="ISA 3:12">main folk! daine harn zainen farfirer,</para>
  <para style="q" vid="ISA 3:12">un dem veg fun daine shtegn hobn zei tsemisht.<verse eid="ISA 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 3:13" />Hashem shteit oif zich tsu krign,</para>
  <para style="q" vid="ISA 3:13">un er shtelt zich tsu mishpetn di felker.<verse eid="ISA 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 3:14" />Hashem vet gein in a mishpot</para>
  <para style="q" vid="ISA 3:14">mit di eltste fun zain folk un zaine harn:</para>
  <para style="q" vid="ISA 3:14">dos hot ir opgegesen dem vaingorten,</para>
  <para style="q" vid="ISA 3:14">di gzeile fun oreman iz in aiere haizer.<verse eid="ISA 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 3:15" />vos meint ir, vos ir tsedrikt main folk,</para>
  <para style="q" vid="ISA 3:15">un dem ponem fun di orime tsemolt ir?</para>
  <para style="q" vid="ISA 3:15">zogt der Adonoi, Hashem Tseva'ot.<verse eid="ISA 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 3:16" />un Hashem hot gezogt:</para>
  <para style="q" vid="ISA 3:16">vail di techter fun Tsiyon zainen hoferdik,</para>
  <para style="q" vid="ISA 3:16">un geyen farrisn dem haldz,</para>
  <para style="q" vid="ISA 3:16">un vinkendik mit di oign;</para>
  <para style="q" vid="ISA 3:16">geyen shvebndik geyen zei,</para>
  <para style="q" vid="ISA 3:16">un mit zeyere fusringen klingen zei;<verse eid="ISA 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 3:17" />derum vet Adonoi kretsik machn</para>
  <para style="q" vid="ISA 3:17">dem kop fun di techter fun Tsiyon,</para>
  <para style="q" vid="ISA 3:17">un Hashem vet zeyer shand antplekn.<verse eid="ISA 3:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18" />in yenem tog vet Adonoi opton di sheinkeit fun di fusringen, un di shternbender, un di levonelech; <verse eid="ISA 3:18" /><verse number="19" style="v" sid="ISA 3:19" />di bomberlech, un di orembender, un di shleyers; <verse eid="ISA 3:19" /><verse number="20" style="v" sid="ISA 3:20" />di kopticher, un di tritkeitlech, un di gartelen, un di laiblech, un di kameyus; <verse eid="ISA 3:20" /><verse number="21" style="v" sid="ISA 3:21" />di fingerlech, un di nozringen; <verse eid="ISA 3:21" /><verse number="22" style="v" sid="ISA 3:22" />di fartichter, un di mantlen, un di iberdekn, un di baitlen; <verse eid="ISA 3:22" /><verse number="23" style="v" sid="ISA 3:23" />di tuln, un di lainene ticher, un di hoibn, un di dekticher.<verse eid="ISA 3:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 3:24" />un es vet zain,</para>
  <para style="q" vid="ISA 3:24">anshtot b'somaim vet zain tsefoiltkeit,</para>
  <para style="q" vid="ISA 3:24">un anshtot a gartel, a shtrik,</para>
  <para style="q" vid="ISA 3:24">un anshtot kroizn, a plich,</para>
  <para style="q" vid="ISA 3:24">un anshtot a brusttuch, a zakgurt;</para>
  <para style="q" vid="ISA 3:24">a brand anshtot sheinkeit.<verse eid="ISA 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 3:25" />daine mener veln durchn shverd faln,</para>
  <para style="q" vid="ISA 3:25">un daine giborim in milchome.<verse eid="ISA 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 3:26" />un klogn un troiern veln ire toiern,</para>
  <para style="q" vid="ISA 3:26">un oisgeleidikt vet zi vern,</para>
  <para style="q" vid="ISA 3:26">oif der erd vet zi zitsn.<verse eid="ISA 3:26" /></para>
  <chapter eid="ISA 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="ISA 4" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 4:1" />un zibn vaiber veln onhaltn ein man in yenem tog, azoi tsu zogn: undzer broit veln mir esen, un undzer kleid veln mir onton, nor dain nomen zol gerufn vern oif undz; tu op undzer shand.<verse eid="ISA 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2" />in yenem tog vet di tsemach fun Hashem zain far a sheinkeit un far a koved, un di frucht fun land far a shtolts un far a tsirung, far di antrunene fun Yisroel. <verse eid="ISA 4:2" /><verse number="3" style="v" sid="ISA 4:3" />un es vet zain, der vos iz geblibn in Tsiyon, un der vos hot zich opgeshtelt in Yerushalayim, vet heiliker gezogt vern tsu im – itlecher vos iz farshribn tsum lebn in Yerushalayim; <verse eid="ISA 4:3" /><verse number="4" style="v" sid="ISA 4:4" />ven Adonoi hot opgevashn dem koit fun di techter fun Tsiyon, un dos blut fun Yerushalayim shvenkt er op fun ir mit, mit a gaist fun gerechtikeit, un mit a gaist fun farbrenung. <verse eid="ISA 4:4" /><verse number="5" style="v" sid="ISA 4:5" />un Hashem vet bashafn oifn gantsn plats fun barg Tsiyon, un oif ire zamlerter, a volken un roich bai tog, un a shain fun flamfaier bai nacht; vorem, iber al der prachtikeit vet zain a chupe. <verse eid="ISA 4:5" /><verse number="6" style="v" sid="ISA 4:6" />un an iberdek vet zain far a shotn fun hits bai tog, un far a bashitsung un far a farborgenish fun gus un fun regn.<verse eid="ISA 4:6" /></para>
  <chapter eid="ISA 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="ISA 5" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 5:1" />lomich zingen fun main libn fraint,</para>
  <para style="q" vid="ISA 5:1">dos gezang fun main balibtn oif zain vaingorten.</para>
  <para style="q" vid="ISA 5:1">a vaingorten hot main liber fraint gehat,</para>
  <para style="q" vid="ISA 5:1">oif a bergel a fetn.<verse eid="ISA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 5:2" />un er hot im tsegrobn un im oisgeshteint,</para>
  <para style="q" vid="ISA 5:2">un im baflantst mit taiern vainshtok,</para>
  <para style="q" vid="ISA 5:2">un oisgeboit a turem in im,</para>
  <para style="q" vid="ISA 5:2">un oich a kelter oisgehakt derin;</para>
  <para style="q" vid="ISA 5:2">un er hot gehoft er zol vaintroiben brengen,</para>
  <para style="q" vid="ISA 5:2">un er hot vildtroibn gebracht.<verse eid="ISA 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 5:3" />un atsund, ir bavoiner fun Yerushalayim,</para>
  <para style="q" vid="ISA 5:3">un mener fun Yehudah,</para>
  <para style="q" vid="ISA 5:3">mishpot, ich bet aich, tsvishn mir un tsvishn main vaingorten.<verse eid="ISA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 5:4" />vos noch iz geven tsu ton far main vaingorten,</para>
  <para style="q" vid="ISA 5:4">vos ich hob in im nisht geton?</para>
  <para style="q" vid="ISA 5:4">far vos, az ich hob gehoft er zol vaintroiben brengen,</para>
  <para style="q" vid="ISA 5:4">hot er vildtroibn gebracht?<verse eid="ISA 5:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 5:5" />un atsund, lomich aich lozn visen,</para>
  <para style="q" vid="ISA 5:5">vos ich vel ton tsu main vaingorten:</para>
  <para style="q" vid="ISA 5:5">opton zain tsam,</para>
  <para style="q" vid="ISA 5:5">un er zol opgegesen vern;</para>
  <para style="q" vid="ISA 5:5">tsebrechn zain ploit,</para>
  <para style="q" vid="ISA 5:5">un er zol tsetretn vern.<verse eid="ISA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 5:6" />un ich vel im machn a vistenish;</para>
  <para style="q" vid="ISA 5:6">nisht bashnitn un nisht arumgegrobn vet er vern,</para>
  <para style="q" vid="ISA 5:6">un er vet farvaksn mit derner un vildgeveks,</para>
  <para style="q" vid="ISA 5:6">un oich di volkens vel ich bafeln,</para>
  <para style="q" vid="ISA 5:6">nisht tsu regenen oif im kein regn.<verse eid="ISA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 5:7" />vorem der vaingorten fun Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 5:7">iz dos hoiz fun Yisroel;</para>
  <para style="q" vid="ISA 5:7">un di mener fun Yehudah,</para>
  <para style="q" vid="ISA 5:7">zain getsertlte flantsung;</para>
  <para style="q" vid="ISA 5:7">un er hot gehoft oif gerechtikeit,</para>
  <para style="q" vid="ISA 5:7">ersht es iz shlechtikeit,</para>
  <para style="q" vid="ISA 5:7">oif tsidkut, ersht es iz a yomerai.<verse eid="ISA 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 5:8" />vei, di vos rukn a hoiz tsu a hoiz,</para>
  <para style="q" vid="ISA 5:8">genenen a feld tsu a feld, biz nishto mer kein ort,</para>
  <para style="q" vid="ISA 5:8">un ir alein blaibt zitsn in land!<verse eid="ISA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 5:9" />in maine oiern Hashem Tseva'ot:</para>
  <para style="q" vid="ISA 5:9">oib fil haizer vist vern,</para>
  <para style="q" vid="ISA 5:9">groise un sheine, on a bavoiner!<verse eid="ISA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 5:10" />vorem tsen aker vaingorten veln brengen ein bat,</para>
  <para style="q" vid="ISA 5:10">un a chomer zomen vet brengen an eife.<verse eid="ISA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 5:11" />vei, di vos federn zich in der peire,</para>
  <para style="q" vid="ISA 5:11">dem trunk nochtsuyogn, di vos shpetikn zich bai nacht,</para>
  <para style="q" vid="ISA 5:11">biz der vain tsindt zei on!<verse eid="ISA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 5:12" />un mit harf un gitar, mit poik un fleit ,</para>
  <para style="q" vid="ISA 5:12">un mit vain, iz zeyer moltsait;</para>
  <para style="q" vid="ISA 5:12">un dos verk fun Hashem kukn zei nisht on,</para>
  <para style="q" vid="ISA 5:12">un di tuung fun zaine hent zeen zei nisht.<verse eid="ISA 5:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 5:13" />derum geit in goles main folk,</para>
  <para style="q" vid="ISA 5:13">fun nisht farshtandikeit;</para>
  <para style="q" vid="ISA 5:13">un zaine nechbdim vern hungerleit,</para>
  <para style="q" vid="ISA 5:13">un zain hamon fun dorsht fartriknt.<verse eid="ISA 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 5:14" />derum hot di Sheol oisgebreit ir shlund,</para>
  <para style="q" vid="ISA 5:14">un oifgeshpart ir moil on a mos:</para>
  <para style="q" vid="ISA 5:14">un nidern vet ir pracht,</para>
  <para style="q" vid="ISA 5:14">un ir tuml un ir geroish,</para>
  <para style="q" vid="ISA 5:14">un vu a lustiker in ir.<verse eid="ISA 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 5:15" />un geboign vert der mentsh,</para>
  <para style="q" vid="ISA 5:15">un dernidert vert der man,</para>
  <para style="q" vid="ISA 5:15">un di oign fun di hoiche velz dernidert vern.<verse eid="ISA 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 5:16" />un Hashem Tseva'ot vert derheicht durch gerechtikeit,</para>
  <para style="q" vid="ISA 5:16">un HaEl der heiliker vert geheilikt durch rechtfartikeit.<verse eid="ISA 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 5:17" />un di shof veln zich pashen vi oif zeyer fiterplats,</para>
  <para style="q" vid="ISA 5:17">un di churves fun di raiche veln fartsert vern fun vanderer.<verse eid="ISA 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 5:18" />vei, di vos shlepn dem farbrech mit shnurn fun nishtikeit,</para>
  <para style="q" vid="ISA 5:18">un vi mit a vognshtrik di zind!<verse eid="ISA 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 5:19" />di vos zogn: zol er ailn vos gicher zain verk,</para>
  <para style="q" vid="ISA 5:19">kedei mir zoln zen;</para>
  <para style="q" vid="ISA 5:19">un zol genenen un kumen der barot fun dem heilikn fun Yisroel,</para>
  <para style="q" vid="ISA 5:19">un lomir gevoir vern.<verse eid="ISA 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 5:20" />vei, di vos zogn oif shlechts gut,</para>
  <para style="q" vid="ISA 5:20">un oif gut shlecht;</para>
  <para style="q" vid="ISA 5:20">vos machn fintsternish far lichtikeit,</para>
  <para style="q" vid="ISA 5:20">un lichtikeit far fintsternish;</para>
  <para style="q" vid="ISA 5:20">vos machn biter far zis,</para>
  <para style="q" vid="ISA 5:20">un zis far biter!<verse eid="ISA 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 5:21" />vei, di vos zainen chachomim in zeyere oign,</para>
  <para style="q" vid="ISA 5:21">un farshtandik in zeyer ongezicht!<verse eid="ISA 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 5:22" />vei, di giborim oif trinken vain,</para>
  <para style="q" vid="ISA 5:22">un heldishe lait oif mishn dem trunk;<verse eid="ISA 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 5:23" />vos machn gerecht dem shuldikn um shochad,</para>
  <para style="q" vid="ISA 5:23">un dos recht fun gerechtn nemen zei fun im avek!<verse eid="ISA 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 5:24" />derum, azoi vi di tsung fun faier fartsert shtroi,</para>
  <para style="q" vid="ISA 5:24">un shprei tsekricht in a flam,</para>
  <para style="q" vid="ISA 5:24">azoi vet zeyer vortsel vi a tsefoilung vern,</para>
  <para style="q" vid="ISA 5:24">un zeyer bliung vet vi shtoib oifgein;</para>
  <para style="q" vid="ISA 5:24">vail zei hobn faracht di toyre fun Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 5:24">un gelestert dos vort fun dem heilikn fun Yisroel.<verse eid="ISA 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 5:25" />derum hot gegrimt der tsorn fun Hashem oif zain folk,</para>
  <para style="q" vid="ISA 5:25">un er hot oisgeshtrekt zain hant oif im,</para>
  <para style="q" vid="ISA 5:25">un hot im geshlogn, az di berg hobn getsitert;</para>
  <para style="q" vid="ISA 5:25">un zeyere toite leiber zainen gevorn vi mist in der mit fun di gasn.</para>
  <para style="q" vid="ISA 5:25">bai alem dem iz nisht opgegangen zain kaas.</para>
  <para style="q" vid="ISA 5:25">un zain hant iz noch oisgeshtrekt.<verse eid="ISA 5:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="ISA 5:26" />un er vet oifheibn a fon tsu di felker fun der vait,</para>
  <para style="q" vid="ISA 5:26">un vet shtutsern tsu im fun ek erd,</para>
  <para style="q" vid="ISA 5:26">un ze, ailik flink vet er kumen;<verse eid="ISA 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 5:27" />nishto kein mider un kein shtroichler bai im,</para>
  <para style="q" vid="ISA 5:27">er shlumert nisht un shloft nisht,</para>
  <para style="q" vid="ISA 5:27">un nisht opgebundn iz der gartel fun zaine lendn,</para>
  <para style="q" vid="ISA 5:27">un nisht tserisn a bendl fun zaine shich.<verse eid="ISA 5:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 5:28" />vos zaine failn zainen gesharft,</para>
  <para style="q" vid="ISA 5:28">un ale zaine boigns geshpant;</para>
  <para style="q" vid="ISA 5:28">di kloien fun zaine ferd zainen vi kizl gerechnt,</para>
  <para style="q" vid="ISA 5:28">un zaine reder vi der shturemvint.<verse eid="ISA 5:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 5:29" />o bril hot er vi di leibinte,</para>
  <para style="q" vid="ISA 5:29">un er brilt vi yungleibn,</para>
  <para style="q" vid="ISA 5:29">un brumt, un chapt roib,</para>
  <para style="q" vid="ISA 5:29">un trogt avek, un nishto ver zol matsl zain.<verse eid="ISA 5:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 5:30" />un er vet brumen oif im in yenem tog,</para>
  <para style="q" vid="ISA 5:30">azoi vi di brumung fun yam;</para>
  <para style="q" vid="ISA 5:30">un me vet a kuk ton tsu der erd,</para>
  <para style="q" vid="ISA 5:30">ersht an enge fintsternish,</para>
  <para style="q" vid="ISA 5:30">un dos licht iz fintster in ire himlen.<verse eid="ISA 5:30" /></para>
  <chapter eid="ISA 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="ISA 6" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1" />in dem yor vos der melech Uziyahu iz geshtorbn, hob ich gezen Adonoi zitsn oif a tron derhoibenem un zeyer hoich, un zaine kiniglech mantl hobn ongefilt dem heichl. <verse eid="ISA 6:1" /><verse number="2" style="v" sid="ISA 6:2" />Sarafim zainen geshtanen iber im; tsu zeks fliglen, tsu zeks fliglen hot itlecher gehat: mit tsvei hot er fardekt zain ponem, un mit tsvei hot er fardekt zaine fis, un mit tsvei iz er gefloign. <verse eid="ISA 6:2" /><verse number="3" style="v" sid="ISA 6:3" />un einer hot gerufn tsum andern, un hot gezogt:</para>
  <para style="q" vid="ISA 6:3">heilik, heilik, heilik iz Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 6:3">di gantse erd iz ful mit zain pracht.<verse eid="ISA 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 6:4" />un di baishtidlech fun di shveln hobn zich getreislt fun dem kol fun di rufer, un dos hoiz iz ful gevorn mit roich. <verse eid="ISA 6:4" /><verse number="5" style="v" sid="ISA 6:5" />hob ich gezogt: vei mir, vorem ich bin farshnitn; vail a mentsh mit umreine lipn bin ich, un tsvishn a folk mit umreine lipn zits ich; vorem dem kinig Hashem Tseva'ot hobn gezen maine oign.<verse eid="ISA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6" />iz tsugefloign tsu mir einer fun di Sarafim, un in zain hant iz geven an ongebrenter shtein, vos er hot mit a faiertsvang genumen fun mizbeyech; <verse eid="ISA 6:6" /><verse number="7" style="v" sid="ISA 6:7" />un er hot im tsugerirt tsu main moil, un hot gezogt: ze, dos dozike hot ongerirt oif daine lipn, opton vet zich dain farbrech, un dain zind vet fargebn vern.<verse eid="ISA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8" />un ich hob gehert dem kol fun Adonoi vi er zogt: vemen zol ich shikn, un ver zol undz gein?</para>
  <para style="p" vid="ISA 6:8">hob ich gezogt: do bin ich; shik mich. <verse eid="ISA 6:8" /><verse number="9" style="v" sid="ISA 6:9" />hot er gezogt: gei un zolst zogn tsu dem dozikn folk:</para>
  <para style="b" vid="ISA 6:9" />
  <para style="q" vid="ISA 6:9">hern zolt ir hern, ober nisht farshtein,</para>
  <para style="q" vid="ISA 6:9">un zen zolt ir zen, ober nisht merkn.<verse eid="ISA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 6:10" />mach fet dos harts fun dem dozikn folk,</para>
  <para style="q" vid="ISA 6:10">un zaine oiern mach shver,</para>
  <para style="q" vid="ISA 6:10">un zaine oign farklep,</para>
  <para style="q" vid="ISA 6:10">tomer vet er zen mit zaine oign,</para>
  <para style="q" vid="ISA 6:10">un mit zaine oiern hern,</para>
  <para style="q" vid="ISA 6:10">un zain harts vet farshtein,</para>
  <para style="q" vid="ISA 6:10">un er vet zich umkeren, un geheilt vern.<verse eid="ISA 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 6:11" />hob ich gezogt: biz vanen, Adonoi?</para>
  <para style="q" vid="ISA 6:11">un er hot gezogt:</para>
  <para style="q" vid="ISA 6:11">biz az shtet veln zain vist on a bavoiner,</para>
  <para style="q" vid="ISA 6:11">un haizer on a mentshn</para>
  <para style="q" vid="ISA 6:11">un di erd vet farvist vern in a vistenish;<verse eid="ISA 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 6:12" />un Hashem vet dervaitern di mentshn,</para>
  <para style="q" vid="ISA 6:12">un di farloznkeit vet zain grois in land.<verse eid="ISA 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 6:13" />un blaibt noch a tsent-chelek drinen,</para>
  <para style="q" vid="ISA 6:13">vet es vider oisgeramt vern;</para>
  <para style="q" vid="ISA 6:13">vi a terebint un vi an eichnboim,</para>
  <para style="q" vid="ISA 6:13">vos nor zeyer shtam blaibt ven bleter tsefaln;</para>
  <para style="q" vid="ISA 6:13">der heiliker zomen vet zain ir shtam.<verse eid="ISA 6:13" /></para>
  <chapter eid="ISA 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="ISA 7" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1" />un es iz geven in di teg fun Achaz dem zun fun Yotam dem zun fun Uziyahun, dem melech fun Yehudah, iz Retsin der melech fun Aram, un Pekach der zun fun Remalyahuen, der melech fun Yisroel, aroifgegangen oif Yerushalayim, in milchome oif ir, ober zei hobn zi nisht gekent baikumen. <verse eid="ISA 7:1" /><verse number="2" style="v" sid="ISA 7:2" />un es iz ongezogt gevorn in hoiz fun Dovid, azoi tsu zogn: Aram lagert in einem mit Efrayim. un zain harts un dos harts fun zain folk hot zich getreislt, azoi vi es treislen zich di beimer fun vald faran vint.<verse eid="ISA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3" />hot Hashem gezogt tsu Yeshayahuen: gei akorsht arois antkegen Achazn, du un dain zun Shear-Yashuv, baim breg grobn fun dem oibershtn taich, oif dem veg fun vesherfeld, <verse eid="ISA 7:3" /><verse number="4" style="v" sid="ISA 7:4" />un zolst zogn tsu im: zai gezetst un ruik, zolst nisht moire hobn, un dain harts zol nisht shlof vern, far di dozike tsvei reicherdike ekn faierheltser; iber dem grimtsorn fun Retsin un Aram, un dem zun fun Remalyahuen. <verse eid="ISA 7:4" /><verse number="5" style="v" sid="ISA 7:5" />vail Aram hot barotn oif dir beiz, Efrayim un der zun fun Remalyahuen, azoi tsu zogn: <verse eid="ISA 7:5" /><verse number="6" style="v" sid="ISA 7:6" />lomir aroifgein oif Yehudah un zi ainshrekn – un lomir zi ainbrechn far undz, un lomir machn far a melech in ir dem zun fun Taveln –<verse eid="ISA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 7:7" />hot Adonoi Hashem azoi gezogt:</para>
  <para style="b" vid="ISA 7:7" />
  <para style="q" vid="ISA 7:7">es vet nisht bashtein, un vet nisht geshen.<verse eid="ISA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 7:8" />vorem der kop fun Aram iz Damesek,</para>
  <para style="q" vid="ISA 7:8">un der kop fun Damesek iz Retsin;</para>
  <para style="q" vid="ISA 7:8">un in noch finf un zechtsik yor</para>
  <para style="q" vid="ISA 7:8">vet Efrayim tsebrochn vern far ois folk.<verse eid="ISA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 7:9" />un der kop fun Efrayim iz Shomron,</para>
  <para style="q" vid="ISA 7:9">un der kop fun Shomron iz der zun fun Remalyahuen.</para>
  <para style="q" vid="ISA 7:9">un ven ir vet nisht gloibn,</para>
  <para style="q" vid="ISA 7:9">azoi vet ir nisht bashtein kenen.<verse eid="ISA 7:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10" />un Hashem hot vider geredt tsu Achazn, azoi tsu zogn: <verse eid="ISA 7:10" /><verse number="11" style="v" sid="ISA 7:11" />bet dir a tseichn fun Hashem dain G-t; bet fun der tifenish, oder fun oiben in der heich. <verse eid="ISA 7:11" /><verse number="12" style="v" sid="ISA 7:12" />hot Achaz gezogt: ich vel nisht betn, un nisht pruvn Hashem. <verse eid="ISA 7:12" /><verse number="13" style="v" sid="ISA 7:13" />hot er gezogt: hert akorsht, ir hoiz fun Dovid: iz aich vintsik mid tsu machn mentshn, az ir vilt oich main G-t mid machn? <verse eid="ISA 7:13" /><verse number="14" style="v" sid="ISA 7:14" />derum vet Adonoi alein aich gebn a tseichn: ot vert di almah yungfroi betulah trogedik, un zi gebert a zun, un vet rufn zain nomen Immanuel. <verse eid="ISA 7:14" /><verse number="15" style="v" sid="ISA 7:15" />shmant un honik vet er esen, ven er vet visen faint tsu hobn shlechts, un oistsuklaibn guts. – <verse eid="ISA 7:15" /><verse number="16" style="v" sid="ISA 7:16" />yo, noch eider der yingel vet visen faint tsu hobn shlechts, un oistsuklaibn guts, vet farlozen vern di erd vos du shrekst zich far ire tsvei mlochim. – <verse eid="ISA 7:16" /><verse number="17" style="v" sid="ISA 7:17" />Hashem vet brengen oif dir, un oif dain folk, un oif dain foters hoiz, teg vos zainen nisht geven fun dem tog vos Efrayim hot zich opgekert fun Yehudah – dem melech fun Ashur.<verse eid="ISA 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18" />un es vet zain in yenem tog, vet Hashem a shmutser ton tsu der flig vos in ek taichn fun Mitsrayim, un tsu der bin vos in land Ashur. <verse eid="ISA 7:18" /><verse number="19" style="v" sid="ISA 7:19" />un zei veln kumen, un veln ale ruen in di viste toln un in di shpaltn fun feldzn, un in ale derner un in ale vilde beimlech.<verse eid="ISA 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 7:20" />in yenem tog vet Adonoi opgolen mit dem golmeser gedungen oif yener zait taich – mit dem melech fun Ashur, dem kop un di hor fun di fis, un oich di bord vet es aropnemen.<verse eid="ISA 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 7:21" />un es vet zain in yenem tog, az a man vet oifhodeven a yunge ku un tsvei shof, <verse eid="ISA 7:21" /><verse number="22" style="v" sid="ISA 7:22" />iz, fun fil milch vos zei veln gebn, vet er esen shmant; vorem shmant un honik vet esen itlecher vos iz geblibn in land.<verse eid="ISA 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 7:23" />un es vet zain in yenem tog, iz, itlecher ort vu es zainen do toiznt vainshtokn vert toiznt zilbershtik, vet far derner un far vildgeveks zain. <verse eid="ISA 7:23" /><verse number="24" style="v" sid="ISA 7:24" />mit failn un mit boign vet men kumen ahin, vorem derner un vildgeveks vet zain dos gantse land. <verse eid="ISA 7:24" /><verse number="25" style="v" sid="ISA 7:25" />un ale berg vos vern mit a grobaizn gegrobn, vestu ahin nisht kumen ois moire far derner un vildgeveks, nor es vet zain far oksen aroistsulozn, un far shof tsum tretn.<verse eid="ISA 7:25" /></para>
  <chapter eid="ISA 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="ISA 8" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1" />un Hashem hot tsu mir gezogt: nem dir a groisn tovl, un shraib on deroif mitn shrift fun folk: Maher-Shalal-Chash-Baz. <verse eid="ISA 8:1" /><verse number="2" style="v" sid="ISA 8:2" />un ich zol mir shteln bagloibte eides, Uriyah dem koyen, un Zecharyahu dem zun fun Yeverekhyahuen.<verse eid="ISA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 8:3" />un ich hob genent tsu der neviye, un zi iz trogedik gevorn, un hot geborn a zun. un Hashem hot tsu mir gezogt: ruf zain nomen: Maher-Shalal-Chash-Baz. <verse eid="ISA 8:3" /><verse number="4" style="v" sid="ISA 8:4" />vorem eider der yingel vet visen tsu rufn tate un mame, vet men avektrogen dem farmeg fun Damesek, un dem zakroib fun Shomron, farois far dem melech fun Ashur.<verse eid="ISA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5" />un Hashem hot noch vider tsu mir geredt, azoi tsu zogn:<verse eid="ISA 8:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 8:6" />vail dos dozike folk hot faracht</para>
  <para style="q" vid="ISA 8:6">di vasern fun Shelach vos geyen pamelech,</para>
  <para style="q" vid="ISA 8:6">un zich gefreit mit Retsin un dem zun fun Remalyahuen,<verse eid="ISA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 8:7" />drumech ze, Adonoi brengt aroif oif zei</para>
  <para style="q" vid="ISA 8:7">di groise un machtike vasern fun taich,</para>
  <para style="q" vid="ISA 8:7">dem melech fun Ashur mit zain gantser machne,</para>
  <para style="q" vid="ISA 8:7">un er vet iberloifn iber ale zaine grobns,</para>
  <para style="q" vid="ISA 8:7">un aribergein iber zaine ale bregn;<verse eid="ISA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 8:8" />un er vet durchtsien durch Yehudah,</para>
  <para style="q" vid="ISA 8:8">fleitsndik vet er durchshtromen,</para>
  <para style="q" vid="ISA 8:8">bizn haldz vet er greichn,</para>
  <para style="q" vid="ISA 8:8">un di shpreitungen fun zaine fliglen</para>
  <para style="q" vid="ISA 8:8">veln onfiln di breit fun dain land, Immanuel!<verse eid="ISA 8:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 8:9" />liaremt, ir felker, ober ir vet tsebrochn vern;</para>
  <para style="q" vid="ISA 8:9">yo, farnemt ale vaitenishn fun der erd;</para>
  <para style="q" vid="ISA 8:9">gurt aich on, ober ir vet tsebrochn vern,</para>
  <para style="q" vid="ISA 8:9">gurt aich on, ober ir vet tsebrochn vern.<verse eid="ISA 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 8:10" />eitset an eitse, un zi vet farshtert vern,</para>
  <para style="q" vid="ISA 8:10">redt op a zach, un zi vet nisht bashtein,</para>
  <para style="q" vid="ISA 8:10">vorem El iz mit undz.<verse eid="ISA 8:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11" />vorem azoi hot gezogt Hashem tsu mir mit a shtarker hant, un er hot mich gevornt, nisht tsu gein in veg fun dem dozikn folk, azoi tsu zogn: <verse eid="ISA 8:11" /><verse number="12" style="v" sid="ISA 8:12" />ir zolt nisht zogn bunt oif alts vos dos dozike folk zogt bunt, un zain moire zolt ir nisht moire hobn, un nisht forchtn. <verse eid="ISA 8:12" /><verse number="13" style="v" sid="ISA 8:13" />Hashem Tseva'ot, im zolt ir heilikn, un er zol zain aier moire, un er aier forcht. <verse eid="ISA 8:13" /><verse number="14" style="v" sid="ISA 8:14" />un er vet zain far a mikdash, ober oich far a shtein fun onshtoisung, un far a feldz fun shtroichlung, far beide haizer fun Yisroel; far a nets un far a pastke far dem bavoiner fun Yerushalayim. <verse eid="ISA 8:14" /><verse number="15" style="v" sid="ISA 8:15" />un fil tsvishn zei veln geshtroichlt vern, un faln un tsebrochn vern, un gefangen un batsvungen vern.<verse eid="ISA 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 8:16" />farbindn di vorenish, farchtmen di lernung tsvishn maine lerners! <verse eid="ISA 8:16" /><verse number="17" style="v" sid="ISA 8:17" />un ich vel hofn oif Hashem vos farborgt zain ponem fun dem hoiz fun Yaakov, un vel hofn tsu im. <verse eid="ISA 8:17" /><verse number="18" style="v" sid="ISA 8:18" />ot bin ich un di kinder vos Hashem hot mir gegebn, far simonim un far tseichns in Yisroel fun Hashem Tseva'ot vos rut oif barg Tsiyon.<verse eid="ISA 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19" />un az zei veln zogn tsu aich: fregt bai di gaister un bai di ruches vos pipsn un vos murmlen, zolt ir zogn: darf nisht a folk fregn bai zain G-t? tsu vos fregn far di lebedike bai di toite? <verse eid="ISA 8:19" /><verse number="20" style="v" sid="ISA 8:20" />tsu der toyre un tsu dem eides, ven zei zogn nisht azoi vi dos dozike vort, azoi iz es vail zei hot nisht kein morgn licht. <verse eid="ISA 8:20" /><verse number="21" style="v" sid="ISA 8:21" />un durchgein vet durch danen a gedrikter un a hungeriker; un es vet zain, az er vet hungern, vet er tserenen, un vet shiltn zain melech un zain G-t; un er vet zich kern tsu der heich, <verse eid="ISA 8:21" /><verse number="22" style="v" sid="ISA 8:22" />un vet kukn tsu der erd, ersht noit un fintsternish, angstike tunklenish, un choishechnish oisgeshpreit.<verse eid="ISA 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="9.1" sid="ISA 8:23" /> vorem es blaibt nisht fintster, vu es iz itst yesurim: in ershtn mol hot er gebracht dos land Zevulun un dos land Naftali in charpe, un in dem letstn brengt er koved dem veg baim yam, fun der ander zait Yarden, dem Galil fun di Goim.<verse eid="ISA 8:23" /></para>
  <chapter eid="ISA 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="ISA 9" />
  <para style="q">
    <verse number="1" style="v" pubnumber="9.2" sid="ISA 9:1" /> dos folk vos iz gegangen in fintsternish,</para>
  <para style="q" vid="ISA 9:1">hot derzen a grois lichtikeit;</para>
  <para style="q" vid="ISA 9:1">di vos zainen gezesn in land fun toitshotn,</para>
  <para style="q" vid="ISA 9:1">oif zei hot a lichtikeit geshaint.<verse eid="ISA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="9.3" sid="ISA 9:2" /> host gemert dos folk,</para>
  <para style="q" vid="ISA 9:2">host gegreist zain freid;</para>
  <para style="q" vid="ISA 9:2">zei freyen zich far dir, vi di freid baim shnit,</para>
  <para style="q" vid="ISA 9:2">vi men kvelt ven me teilt zich mit roib.<verse eid="ISA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="9.4" sid="ISA 9:3" /> vorem dem yoch fun zain last,</para>
  <para style="q" vid="ISA 9:3">un dem shtang fun zain nakn,</para>
  <para style="q" vid="ISA 9:3">di rut fun zain driker,</para>
  <para style="q" vid="ISA 9:3">hostu tsebrochn vi in tog fun Midyan.<verse eid="ISA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" pubnumber="9.5" sid="ISA 9:4" /> vorem yetveder shuch vos hot geshart mit raash,</para>
  <para style="q" vid="ISA 9:4">un yetveder mantl gevelgert in blut,</para>
  <para style="q" vid="ISA 9:4">vet zain tsu brand,</para>
  <para style="q" vid="ISA 9:4">a shpaiz faran faier.<verse eid="ISA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="9.6" sid="ISA 9:5" /> vorem a kind iz undz geborn gevorn,</para>
  <para style="q" vid="ISA 9:5">a zun iz undz gegebn gevorn,</para>
  <para style="q" vid="ISA 9:5">un di hershaft iz oif zain aksl;</para>
  <para style="q" vid="ISA 9:5">un me ruft zain nomen:</para>
  <para style="q" vid="ISA 9:5">Pele-Yoets El-gibor,</para>
  <para style="q" vid="ISA 9:5">Avi-Eid Sar-Sholem;<verse eid="ISA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" pubnumber="9.7" sid="ISA 9:6" /> tsu mern di hershaft,</para>
  <para style="q" vid="ISA 9:6">un tsu sholem on shieur,</para>
  <para style="q" vid="ISA 9:6">oif dem tron fun Dovid,</para>
  <para style="q" vid="ISA 9:6">un oif zain meluche;</para>
  <para style="q" vid="ISA 9:6">zi tsu festikn un zi untertsulenen</para>
  <para style="q" vid="ISA 9:6">mit recht un gerechtikeit,</para>
  <para style="q" vid="ISA 9:6">fun atsund un biz eibik;</para>
  <para style="q" vid="ISA 9:6">dos onnemen zich fun Hashem Tseva'ot tut dos dozike.<verse eid="ISA 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" pubnumber="9.8" sid="ISA 9:7" /> Adonoi hot a vort geshikt in Yaakov,</para>
  <para style="q" vid="ISA 9:7">un es iz gefaln in Yisroel.<verse eid="ISA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="9.9" sid="ISA 9:8" /> un visen vet dos gantse folk,</para>
  <para style="q" vid="ISA 9:8">Efrayim un der bavoiner fun Shomron,</para>
  <para style="q" vid="ISA 9:8">vos zogt mit gaive un mit gadles fun hartsn:<verse eid="ISA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" pubnumber="9.10" sid="ISA 9:9" /> tsigl zainen aingefaln,</para>
  <para style="q" vid="ISA 9:9">un gehakte shteiner veln mir boien;</para>
  <para style="q" vid="ISA 9:9">vilde faignbeimer zainen opgehakt gevorn,</para>
  <para style="q" vid="ISA 9:9">un mit tsedern veln mir zei farbaiten.<verse eid="ISA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="9.11" sid="ISA 9:10" /> derum derheibt Hashem di faint fun Retsin oif im,</para>
  <para style="q" vid="ISA 9:10">un zaine sonim vet er onreitsn;<verse eid="ISA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" pubnumber="9.12" sid="ISA 9:11" /> Aram fun forent, un Pelishtim fun hintn;</para>
  <para style="q" vid="ISA 9:11">un zei esen Yisroel mitn gantsn moil.</para>
  <para style="b" vid="ISA 9:11" />
  <para style="q" vid="ISA 9:11">bai alem dem iz nisht opgegangen zain kaas,</para>
  <para style="q" vid="ISA 9:11">un zain hant iz noch oisgeshtrekt.<verse eid="ISA 9:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" pubnumber="9.13" sid="ISA 9:12" /> ober dos folk kert zich nisht tsu zain shleger,</para>
  <para style="q" vid="ISA 9:12">un Hashem Tseva'ot zuchn zei nisht.<verse eid="ISA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="9.14" sid="ISA 9:13" /> un Hashem farshnaidt fun Yisroel kop un ek,</para>
  <para style="q" vid="ISA 9:13">teitltsvaig un taichritl, in ein tog.<verse eid="ISA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" pubnumber="9.15" sid="ISA 9:14" /> der zoken un der ongezeener, dos iz der kop,</para>
  <para style="q" vid="ISA 9:14">un der novi vos lernt lign, dos iz der ek.<verse eid="ISA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" pubnumber="9.16" sid="ISA 9:15" /> un di harn fun dem dozikn folk zainen farfirer,</para>
  <para style="q" vid="ISA 9:15">un zeyere gefirte zainen tsemisht.<verse eid="ISA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" pubnumber="9.17" sid="ISA 9:16" /> derum freit zich nisht Adonoi mit zaine yunge lait,</para>
  <para style="q" vid="ISA 9:16">un zaine yesoimim un almones derbaremt er nisht;</para>
  <para style="q" vid="ISA 9:16">vorem itlecher iz zindik un tut shlechts,</para>
  <para style="q" vid="ISA 9:16">un itlech moil redt shendlechkeit.</para>
  <para style="b" vid="ISA 9:16" />
  <para style="q" vid="ISA 9:16">bai alem dem iz nisht opgegangen zain kaas,</para>
  <para style="q" vid="ISA 9:16">un zain hant iz noch oisgeshtrekt.<verse eid="ISA 9:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" pubnumber="9.18" sid="ISA 9:17" /> vorem di shlechtikeit brent vi a faier,</para>
  <para style="q" vid="ISA 9:17">zi fartsert derner un vildgeveks,</para>
  <para style="q" vid="ISA 9:17">un tsindt di getsvaign fun vald,</para>
  <para style="q" vid="ISA 9:17">biz zei knoiln zich in zailn fun roich.<verse eid="ISA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" pubnumber="9.19" sid="ISA 9:18" /> durch dem tsorn fun Hashem Tseva'ot</para>
  <para style="q" vid="ISA 9:18">iz tseflakert dos land,</para>
  <para style="q" vid="ISA 9:18">un dos folk iz vi shpaiz faran faier;</para>
  <para style="q" vid="ISA 9:18">zei derbaremen zich nisht keiner oif zain bruder,<verse eid="ISA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" pubnumber="9.20" sid="ISA 9:19" /> un me raist rechts, un blaibt hungerik,</para>
  <para style="q" vid="ISA 9:19">un me est links, un vert nisht zat;</para>
  <para style="q" vid="ISA 9:19">zei esen itlecher dos fleish fun zain orem:<verse eid="ISA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" pubnumber="9.21" sid="ISA 9:20" /> Menasheh Efrayimen, un Efrayim Menashehn,</para>
  <para style="q" vid="ISA 9:20">zei in einem oif Yehudah.</para>
  <para style="b" vid="ISA 9:20" />
  <para style="q" vid="ISA 9:20">bai alem dem iz nisht opgegangen zain kaas,</para>
  <para style="q" vid="ISA 9:20">un zain hant iz noch oisgeshtrekt.<verse eid="ISA 9:20" /></para>
  <chapter eid="ISA 9" />
  <chapter number="10" style="c" pubnumber="י" sid="ISA 10" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 10:1" />vei, di vos machn umgerechte gezets,</para>
  <para style="q" vid="ISA 10:1">un shraiber vos hobn umrecht geshribn,<verse eid="ISA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 10:2" />kedei optsuneigen fun mishpot di baderftike,</para>
  <para style="q" vid="ISA 10:2">un gazlen dos recht fun di orime fun main folk;</para>
  <para style="q" vid="ISA 10:2">kedei almones zoln zain zeyer roib,</para>
  <para style="q" vid="ISA 10:2">un yesoimim zoln zei barabeven!<verse eid="ISA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 10:3" />un vos vet ir ton in tog fun rechnshaft,</para>
  <para style="q" vid="ISA 10:3">un in der farvistung vos kumt fun der vait?</para>
  <para style="q" vid="ISA 10:3">tsu vemen vet ir loifn noch hilf?</para>
  <para style="q" vid="ISA 10:3">un vu vet ir iberlozen aier raichtum?<verse eid="ISA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 10:4" />nisht andersh vi knien unter gefangene,</para>
  <para style="q" vid="ISA 10:4">un unter herugim tsu faln.</para>
  <para style="b" vid="ISA 10:4" />
  <para style="q" vid="ISA 10:4">bai alem dem iz nisht opgegangen zain kaas,</para>
  <para style="q" vid="ISA 10:4">un zain hant iz noch oisgeshtrekt.<verse eid="ISA 10:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 10:5" />vei, Ashur, di rut fun main tsorn,</para>
  <para style="q" vid="ISA 10:5">vos main kaas iz a shtekn in zeyer hant!<verse eid="ISA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 10:6" />oif a zindikn folk tu ich im shikn,</para>
  <para style="q" vid="ISA 10:6">un oif der ume fun main tsorn tu ich im bafeln,</para>
  <para style="q" vid="ISA 10:6">tsu roibn zakroib, un tsu rabeven roib,</para>
  <para style="q" vid="ISA 10:6">un zi machn tsu tretn vi koit fun di gasn.<verse eid="ISA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 10:7" />ober nisht azoi meint er,</para>
  <para style="q" vid="ISA 10:7">un nisht azoi tracht zain harts,</para>
  <para style="q" vid="ISA 10:7">naiert tsu fartiliken iz in zain hartsn,</para>
  <para style="q" vid="ISA 10:7">un tsu farshnaidn felker nisht vintsik.<verse eid="ISA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 10:8" />vorem er zogt:</para>
  <para style="q" vid="ISA 10:8">zainen nisht maine harn mlochim ale?<verse eid="ISA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 10:9" />iz nisht vi Karkemish Kalno?</para>
  <para style="q" vid="ISA 10:9">tsi iz nisht vi Arpad Chammat?</para>
  <para style="q" vid="ISA 10:9">tsi iz nisht vi Damesek Shomron?<verse eid="ISA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 10:10" />azoi vi main hant hot dergreicht</para>
  <para style="q" vid="ISA 10:10">di kinigraichn fun di opgeter,</para>
  <para style="q" vid="ISA 10:10">vos zeyere getsn zainen mer geven</para>
  <para style="q" vid="ISA 10:10">vi fun Yerushalayim un fun Shomron –<verse eid="ISA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 10:11" />far vor, azoi vi ich hob geton</para>
  <para style="q" vid="ISA 10:11">tsu Shomron un tsu ire opgeter,</para>
  <para style="q" vid="ISA 10:11">azoi vel ich ton tsu Yerushalayim</para>
  <para style="q" vid="ISA 10:11">un tsu ire getsnbilder.<verse eid="ISA 10:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12" />ober es vet zain, az Adonoi vet endikn al zain verk oif barg Tsiyon un oif Yerushalayim, vel ich zich rechenen far der frucht fun dem shtoltsn hartsn fun dem melech fun Ashur, un far der rimerai fun zaine hoferdike oign.<verse eid="ISA 10:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 10:13" />vorem er hot gezogt:</para>
  <para style="q" vid="ISA 10:13">mit koiech fun main hant hob ich oifgeton,</para>
  <para style="q" vid="ISA 10:13">un mit main chochme, vail ich bin farshtandik;</para>
  <para style="q" vid="ISA 10:13">un ich tu op di gemarkn fun felker,</para>
  <para style="q" vid="ISA 10:13">un zeyere shatsn hob ich tseroibt,</para>
  <para style="q" vid="ISA 10:13">un machtik tu ich nidern di bavoiner.<verse eid="ISA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 10:14" />un main hant hot gefunen vi a nest</para>
  <para style="q" vid="ISA 10:14">dem farmeg fun di felker,</para>
  <para style="q" vid="ISA 10:14">un vi me klaibt oif aier farlozene,</para>
  <para style="q" vid="ISA 10:14">hob ich di gantse erd oifgeklibn;</para>
  <para style="q" vid="ISA 10:14">un nisht geven ver zol a fligel rirn,</para>
  <para style="q" vid="ISA 10:14">oder efenen a moil un a pips ton.<verse eid="ISA 10:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 10:15" />ken di hak zich rimen kegen dem vos hakt mit ir?</para>
  <para style="q" vid="ISA 10:15">ken di zeg zich greisn kegen dem vos tsit zi?</para>
  <para style="q" vid="ISA 10:15">vi a rut zol fochn mit ire oifheiber,</para>
  <para style="q" vid="ISA 10:15">vi a shtekn zol oifheibn</para>
  <para style="q" vid="ISA 10:15">dem vos nisht holts!<verse eid="ISA 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 10:16" />derum vet der har, Hashem Tseva'ot</para>
  <para style="q" vid="ISA 10:16">onshikn a mogerkeit deroif zain fetkeit;</para>
  <para style="q" vid="ISA 10:16">un anshtot zain pracht vet zich tsebrenen a brand,</para>
  <para style="q" vid="ISA 10:16">vi di brand fun a faier.<verse eid="ISA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 10:17" />un dos licht fun Yisroel vet zain a faier,</para>
  <para style="q" vid="ISA 10:17">un zain heiliker a flam,</para>
  <para style="q" vid="ISA 10:17">un zi vet brenen un fartseren zaine derner</para>
  <para style="q" vid="ISA 10:17">un zain vildgeveks in ein tog.<verse eid="ISA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 10:18" />un di pracht fun zain vald un zain fruchtgortn</para>
  <para style="q" vid="ISA 10:18">vet er laib un zel farlendn;</para>
  <para style="q" vid="ISA 10:18">un es vet zain vi dos oisgein fun a guss.<verse eid="ISA 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 10:19" />un der resht beimer fun zain vald veln zain getseilte,</para>
  <para style="q" vid="ISA 10:19">un a yingel vet zei kenen oifshraibn.<verse eid="ISA 10:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="ISA 10:20" />un es vet zain in yenem tog, vet der iberblaib fun Yisroel, un di antrunene fun hoiz fun Yaakov, zich mer nisht onlenen oif zeyer shleger, nor zich onlenen mit emes oif Hashem, dem heilikn fun Yisroel. <verse eid="ISA 10:20" /><verse number="21" style="v" sid="ISA 10:21" />an iberblaib vet zich umkeren, an iberblaib fun Yaakov, tsu El-gibor. <verse eid="ISA 10:21" /><verse number="22" style="v" sid="ISA 10:22" />vorem oib dain folk, Yisroel, zol zain vi zamd fun yam, vet nor an iberblaib fun im zich umkeren; a farlendung iz nigzar gevorn, zi fleitst mit gerechtikeit. <verse eid="ISA 10:22" /><verse number="23" style="v" sid="ISA 10:23" />vorem a farlendenish un a gzar macht Adonoi, Hashem Tseva'ot, in gantsn land.<verse eid="ISA 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24" />far vor, azoi hot gezogt Adonoi, Hashem Tseva'ot: zolst nisht moire hobn, main folk, bavoiner fun Tsiyon, far Ashur vos shlogt dich mit der rut, un heibt zain shtekn oif dir, oifn shteiger fun Mitsrayim. <verse eid="ISA 10:24" /><verse number="25" style="v" sid="ISA 10:25" />vorem noch a klein vail, un der kaas vet zich endikn, un main tsorn vet zain tsu zeyer fartilikung. <verse eid="ISA 10:25" /><verse number="26" style="v" sid="ISA 10:26" />un Hashem Tseva'ot vet dervekn oif im a rut, azoi vi in dem shlak fun Midyan in Tsur-Orev, un vi zain shtekn ibern yam; un er vet zi oifheibn oifn shteiger fun Mitsrayim. <verse eid="ISA 10:26" /><verse number="27" style="v" sid="ISA 10:27" />un es vet zain in yenem tog, vet opgeton vern zain last fun dain rukn, un zain yoch fun dain haldz, un der yoch vet tsebrochn vern funem fets.<verse eid="ISA 10:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="ISA 10:28" />er iz gekumen oif Ayat,</para>
  <para style="q" vid="ISA 10:28">er iz durchgegangen Migron,</para>
  <para style="q" vid="ISA 10:28">in Michmas lozt er iber zain gepek;<verse eid="ISA 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 10:29" />zei zainen ariber dem iberfor,</para>
  <para style="q" vid="ISA 10:29">in Geva hobn zei nachtleg gehaltn.</para>
  <para style="q" vid="ISA 10:29">Ramah tut tsiteren,</para>
  <para style="q" vid="ISA 10:29">Giv'at-Shaul iz antlofn.<verse eid="ISA 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 10:30" />shrai oifn kol, tochter Gallim!</para>
  <para style="q" vid="ISA 10:30">horch, Layish! orime Anatot!<verse eid="ISA 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 10:31" />Madmannah voglt,</para>
  <para style="q" vid="ISA 10:31">di voiner fun Gevim antrinen.<verse eid="ISA 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 10:32" />noch haint vet er zich opshteln in Nov;</para>
  <para style="q" vid="ISA 10:32">er focht zain hant oifn barg fun tochter Tsiyon,</para>
  <para style="q" vid="ISA 10:32">oif dem hoichn ort fun Yerushalayim.<verse eid="ISA 10:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="ISA 10:33" />ze, der har, Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 10:33">brecht op di tsvaign mit mordikeit,</para>
  <para style="q" vid="ISA 10:33">un di hoichgevaksene vern opgeshnitn,</para>
  <para style="q" vid="ISA 10:33">un di derhoibene veln dernidert vern.<verse eid="ISA 10:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="ISA 10:34" />un er vet ophakn di getsvaign fun vald mit an aizn,</para>
  <para style="q" vid="ISA 10:34">un der Levanon vet durch a machtikn faln.<verse eid="ISA 10:34" /></para>
  <chapter eid="ISA 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="ISA 11" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 11:1" />un a rut vet arois fun dem boim shtam fun Yishai,</para>
  <para style="q" vid="ISA 11:1">un a tsvaig fun zaine vortselen vet shprotsn.<verse eid="ISA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 11:2" />un ruen vet oif im der gaist fun Hashem,</para>
  <para style="q" vid="ISA 11:2">der gaist fun chochme un farshtandikeit,</para>
  <para style="q" vid="ISA 11:2">der gaist fun eitse un gevure,</para>
  <para style="q" vid="ISA 11:2">der gaist fun derkenung un gotsforchtikeit.<verse eid="ISA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 11:3" />un zain kvikung vet zain in forcht fun Hashem;</para>
  <para style="q" vid="ISA 11:3">un nisht noch der oiszen fun zaine oign vet er mishpetn,</para>
  <para style="q" vid="ISA 11:3">un nisht noch der herung fun zaine oiern vet er antsheiden;<verse eid="ISA 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 11:4" />nor er vet mishpetn mit gerechtikeit di orime,</para>
  <para style="q" vid="ISA 11:4">un antsheiden mit yoisher far di gedrikte fun land;</para>
  <para style="q" vid="ISA 11:4">un er vet shlogn dos land mit der rut fun zain moil,</para>
  <para style="q" vid="ISA 11:4">un mitn otem fun zaine lipn vet er teitn dem roshe.<verse eid="ISA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 11:5" />un gerechtikeit vet zain der ongurt fun zaine lendn,</para>
  <para style="q" vid="ISA 11:5">un traishaft der gartel fun zaine dichn.<verse eid="ISA 11:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 11:6" />un a volf vet hoizn mit a sheps,</para>
  <para style="q" vid="ISA 11:6">un a lempert mit a tsikele vet hoiern,</para>
  <para style="q" vid="ISA 11:6">un a kalb un a yungleib un a fet rind bainand;</para>
  <para style="q" vid="ISA 11:6">un a klein yingel vet zei firn.<verse eid="ISA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 11:7" />un a ku mit a Beor veln zich fitern,</para>
  <para style="q" vid="ISA 11:7">bainand veln hoiern zeyere yunge;</para>
  <para style="q" vid="ISA 11:7">un a leib vet vi a rind esen shtroi.<verse eid="ISA 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 11:8" />un a zoigediker vet zich shpiln</para>
  <para style="q" vid="ISA 11:8">oifn loch fun a shlang,</para>
  <para style="q" vid="ISA 11:8">un oif der nore fun a noter</para>
  <para style="q" vid="ISA 11:8">vet an antvointer zain hant leign.<verse eid="ISA 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 11:9" />zei veln nisht beiz ton un nisht fardorben</para>
  <para style="q" vid="ISA 11:9">oif main gantsn heilikn barg;</para>
  <para style="q" vid="ISA 11:9">vorem di erd vet zain ful mit derkenung fun Hashem,</para>
  <para style="q" vid="ISA 11:9">vi di vasern badekn dem yam.<verse eid="ISA 11:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10" />un es vet zain in yenem tog: der vortsel fun Yishai, vos shteit far a fon fun di felker – tsu im veln di umes zich venadn, un zain ruung vet zain a prachtikeit.<verse eid="ISA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 11:11" />un es vet zain in yenem tog, vet Adonoi vider oisshtrekn zain hant, a tsveit mol, oistsukoifn dem iberblaib fun zain folk, vos vet blaibn fun Ashur, un fun Mitsrayim, un fun Patros, un fun Kush, un fun Eilam, un fun Shinar, un fun Chammat, un fun di indzelen fun yam.<verse eid="ISA 11:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 11:12" />un er vet oifheibn a fon tsu di felker,</para>
  <para style="q" vid="ISA 11:12">un vet ainzamlen di farshtoisene fun Yisroel,</para>
  <para style="q" vid="ISA 11:12">un di tseshpreite fun Yehudah vet er oifklaibn</para>
  <para style="q" vid="ISA 11:12">fun di fir ekn fun der erd.<verse eid="ISA 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 11:13" />un opgeton vet vern di kine fun Efrayim,</para>
  <para style="q" vid="ISA 11:13">un di faint fun Yehudah veln farshnitn vern;</para>
  <para style="q" vid="ISA 11:13">Efrayim vet nisht mekane zain Yehudah,</para>
  <para style="q" vid="ISA 11:13">un Yehudah vet nisht faintn Efrayim.<verse eid="ISA 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 11:14" />un zei veln onflien bainand oif di Pelishtim tsu mayrev,</para>
  <para style="q" vid="ISA 11:14">in einem veln zei roibn di kinder fun mizrech,</para>
  <para style="q" vid="ISA 11:14">oif Edom un Moav veln zei shtrekn zeyer hant,</para>
  <para style="q" vid="ISA 11:14">un di kinder fun Amon veln gehorchn tsu zei.<verse eid="ISA 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 11:15" />un Hashem vet farvistn di tsung fun dem yam fun Mitsrayim;</para>
  <para style="q" vid="ISA 11:15">un er vet fochn zain hant oifn taich mit zain heisn vint,</para>
  <para style="q" vid="ISA 11:15">un vet im tseshlogn oif zibn bechn,</para>
  <para style="q" vid="ISA 11:15">un machn mit shich aribertsushpraizn.<verse eid="ISA 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 11:16" />un a veg vet zain far dem iberblaib fun zain folk,</para>
  <para style="q" vid="ISA 11:16">vos vet blaibn fun Ashur,</para>
  <para style="q" vid="ISA 11:16">azoi vi es iz geven far Yisroel</para>
  <para style="q" vid="ISA 11:16">in tog fun zain aroifgein fun land Mitsrayim.<verse eid="ISA 11:16" /></para>
  <chapter eid="ISA 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="ISA 12" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 12:1" />un vest zogn in yenem tog:</para>
  <para style="q" vid="ISA 12:1">ich dank dir, Hashem,</para>
  <para style="q" vid="ISA 12:1">hagam du host getsernt oif mir;</para>
  <para style="q" vid="ISA 12:1">opgegangen iz dain kaas,</para>
  <para style="q" vid="ISA 12:1">un du host mich getreist.<verse eid="ISA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 12:2" />ze, El iz main yeshue;</para>
  <para style="q" vid="ISA 12:2">ich bin zicher un angst nisht,</para>
  <para style="q" vid="ISA 12:2">vorem main shtarkeit un gezang iz G-t Hashem,</para>
  <para style="q" vid="ISA 12:2">un er iz mir geven a yeshue.<verse eid="ISA 12:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="ISA 12:3" />un ir vet shepen vaser mit simche, fun di kvaln fun yeshue. <verse eid="ISA 12:3" /><verse number="4" style="v" sid="ISA 12:4" />un in yenem tog vet ir zogn:</para>
  <para style="b" vid="ISA 12:4" />
  <para style="q" vid="ISA 12:4">dankt tsu Hashem, ruft ois zain nomen,</para>
  <para style="q" vid="ISA 12:4">lozt visen tsvishn di felker zaine tuungen,</para>
  <para style="q" vid="ISA 12:4">dertseilt az derhoibn iz zain nomen.<verse eid="ISA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 12:5" />zingt tsu Hashem vorem er hot oifgeton grois,</para>
  <para style="q" vid="ISA 12:5">bavust zol dos zain oif der gantser erd.<verse eid="ISA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 12:6" />shrai ois un zing, bavoinerin fun Tsiyon,</para>
  <para style="q" vid="ISA 12:6">vorem grois tsvishn dir iz der heiliker fun Yisroel.<verse eid="ISA 12:6" /></para>
  <chapter eid="ISA 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="ISA 13" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1" />di nevue oif Bavel, vos Yeshayahu der zun fun Amotsn hot gezen:<verse eid="ISA 13:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 13:2" />oif a hoichn barg shtelt oif a fon,</para>
  <para style="q" vid="ISA 13:2">heibt oif dem kol tsu zei,</para>
  <para style="q" vid="ISA 13:2">focht mit der hant,</para>
  <para style="q" vid="ISA 13:2">zei zoln kumen in di toiern fun firshtn.<verse eid="ISA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 13:3" />ich hob bafoiln maine geheilikte,</para>
  <para style="q" vid="ISA 13:3">yo, gerufn maine giborim far main tsorn,</para>
  <para style="q" vid="ISA 13:3">maine shtoltslustike.<verse eid="ISA 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 13:4" />horch! a tuml oif di berg,</para>
  <para style="q" vid="ISA 13:4">glaich vi fun folk a sach.</para>
  <para style="q" vid="ISA 13:4">horch! a geroish fun meluchut, fun umes farzamlte.</para>
  <para style="q" vid="ISA 13:4">Hashem Tseva'ot bafelt a cheil fun milchome.<verse eid="ISA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 13:5" />zei kumen fun a land a vaitn,</para>
  <para style="q" vid="ISA 13:5">fun ek funem himel –</para>
  <para style="q" vid="ISA 13:5">Hashem un di getsaig fun zain tsorn,</para>
  <para style="q" vid="ISA 13:5">di gantse erd tsu tseshtern.<verse eid="ISA 13:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 13:6" />iomert, vorem nont iz der tog fun Hashem,</para>
  <para style="q" vid="ISA 13:6">vi a broch fun Shaddai vet er kumen.<verse eid="ISA 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 13:7" />derum veln ale hent shlof vern,</para>
  <para style="q" vid="ISA 13:7">un itlech harts fun a mentshn vet tsegein.<verse eid="ISA 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 13:8" />un zei veln dershrokn vern;</para>
  <para style="q" vid="ISA 13:8">yesurim un veyen veln zei krign,</para>
  <para style="q" vid="ISA 13:8">vi a gevinerin veln zei zich dreyen;</para>
  <para style="q" vid="ISA 13:8">einer oifn andern veln zei gafn,</para>
  <para style="q" vid="ISA 13:8">zeyere penemer, penemer fun flamen.<verse eid="ISA 13:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 13:9" />ze, der tog fun Hashem kumt,</para>
  <para style="q" vid="ISA 13:9">umderbaremdik mit kaas un grimtsorn,</para>
  <para style="q" vid="ISA 13:9">tsu machn di erd far a vistenish,</para>
  <para style="q" vid="ISA 13:9">un fartiliken ire zindike fun ir.<verse eid="ISA 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 13:10" />vorem di shtern fun himel un zaine mezlut</para>
  <para style="q" vid="ISA 13:10">veln nisht shainen zeyer licht;</para>
  <para style="q" vid="ISA 13:10">di zun vet zain fintster in ir oifgang,</para>
  <para style="q" vid="ISA 13:10">un di levone vet nisht shimern ir licht.<verse eid="ISA 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 13:11" />un ich vel zich rechenen mit der velt faran beiz,</para>
  <para style="q" vid="ISA 13:11">un mit di reshoim far zeyer zind;</para>
  <para style="q" vid="ISA 13:11">un ich vel farshtern dem shtolts fun di mutvilike,</para>
  <para style="q" vid="ISA 13:11">un di gaive fun di machtike vel ich dernidern.<verse eid="ISA 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 13:12" />ich vel machn a man zeltener fun gingold,</para>
  <para style="q" vid="ISA 13:12">un a mentshn, fun Ofir-gold.<verse eid="ISA 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 13:13" />vegen dem vel ich machn tsiteren di himlen,</para>
  <para style="q" vid="ISA 13:13">un di erd vet oifshturemen fun ir ort,</para>
  <para style="q" vid="ISA 13:13">in dem kaas fun Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 13:13">un in dem tog fun zain grimtsorn.<verse eid="ISA 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 13:14" />un es vet zain: azoi vi a hirsh a geyogter,</para>
  <para style="q" vid="ISA 13:14">un azoi vi shof on an ainzamler,</para>
  <para style="q" vid="ISA 13:14">veln zei itlecher tsu zain folk zich kern,</para>
  <para style="q" vid="ISA 13:14">un itlecher tsu zain land veln zei antloifn.<verse eid="ISA 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 13:15" />itlecher vos vert gefunen,</para>
  <para style="q" vid="ISA 13:15">vet dershtochn vern,</para>
  <para style="q" vid="ISA 13:15">un itlecher vos vert gechapt,</para>
  <para style="q" vid="ISA 13:15">vet faln durchn shverd.<verse eid="ISA 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 13:16" />un zeyere kleine kinder veln tsehakt vern</para>
  <para style="q" vid="ISA 13:16">far zeyere oign;</para>
  <para style="q" vid="ISA 13:16">zeyere haizer veln tseroibt vern,</para>
  <para style="q" vid="ISA 13:16">un zeyere vaiber veln geshendt vern.<verse eid="ISA 13:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 13:17" />ze, ich dervek oif zei Madai,</para>
  <para style="q" vid="ISA 13:17">vos zilber achten zei nisht,</para>
  <para style="q" vid="ISA 13:17">un gold, dos viln zei nisht.<verse eid="ISA 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 13:18" />un boigns veln tsehakn yinglech,</para>
  <para style="q" vid="ISA 13:18">un oif frucht fun laib veln zei nisht rachmones hobn,</para>
  <para style="q" vid="ISA 13:18">oif kinder vet zich nisht derbaremen zeyer oig.<verse eid="ISA 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 13:19" />un Bavel, dos sheindl fun meluchut,</para>
  <para style="q" vid="ISA 13:19">di shtoltse pracht fun di Kasdim,</para>
  <para style="q" vid="ISA 13:19">vet zain vi G-ts iberkerenish</para>
  <para style="q" vid="ISA 13:19">fun Sodom un Amora.<verse eid="ISA 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 13:20" />zi vet eibik nisht bazetst vern,</para>
  <para style="q" vid="ISA 13:20">un nisht bavoint zain oif dor-doires;</para>
  <para style="q" vid="ISA 13:20">un kein araber vet dort nisht oifshteln a getselt,</para>
  <para style="q" vid="ISA 13:20">un kein pastucher veln dort nisht machn hoiern.<verse eid="ISA 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 13:21" />nor vilde kets veln dortn hoiern,</para>
  <para style="q" vid="ISA 13:21">un zeyere haizer veln ful zain mit klog-chayes;</para>
  <para style="q" vid="ISA 13:21">un shtroisfoiglen veln dort ruen,</para>
  <para style="q" vid="ISA 13:21">un Shedim veln dort umtantsn.<verse eid="ISA 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 13:22" />un shakaln veln voien in zeyere palatsn</para>
  <para style="q" vid="ISA 13:22">un midber-hint in di palaien fun tenug;</para>
  <para style="q" vid="ISA 13:22">un nont iz ir tsait tsu kumen,</para>
  <para style="q" vid="ISA 13:22">un ire teg veln zich nisht fartsien.<verse eid="ISA 13:22" /></para>
  <chapter eid="ISA 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="ISA 14" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 14:1" />vorem Hashem vet derbaremen Yaakov, un vet vider oisderveilen Yisroel, un zei baruyen oif zeyer erd; un fremde veln zich baheftn tsu zei, un veln tsushtein tsum hoiz fun Yaakov. <verse eid="ISA 14:1" /><verse number="2" style="v" sid="ISA 14:2" />un felker veln zei nemen, un veln zei brengen oif zeyer ort, un dos hoiz fun Yisroel vet zei arben oif Hashems erd far knecht un far dinstn; un zei veln vern di fangers fun zeyere fangers, un veln geveltikn iber zeyere driker.<verse eid="ISA 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3" />un es vet zain, in dem tog vos Hashem barut dich fun dain pain un fun dain tsiterenish, un fun der shverer arbet vos me hot gearbet mit dir, <verse eid="ISA 14:3" /><verse number="4" style="v" sid="ISA 14:4" />vestu oifheibn dem dozikn Mashal oifn melech fun Bavel, un zogn:</para>
  <para style="b" vid="ISA 14:4" />
  <para style="q" vid="ISA 14:4">vi hot oifgehert der driker,</para>
  <para style="q" vid="ISA 14:4">oifgehert di goldgeitsike!<verse eid="ISA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 14:5" />tsebrochn hot Hashem dem shtekn fun di reshoim,</para>
  <para style="q" vid="ISA 14:5">di rut fun di geveltiker,<verse eid="ISA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 14:6" />vos hot geshlogn di felker mit kaas,</para>
  <para style="q" vid="ISA 14:6">shlek on an oifher,</para>
  <para style="q" vid="ISA 14:6">vos hot geveltikt mit tsorn oif di umes,</para>
  <para style="q" vid="ISA 14:6">geroideft on ophalt.<verse eid="ISA 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 14:7" />ruik barut iz di gantse erd,</para>
  <para style="q" vid="ISA 14:7">zei brechn ois in gezang.<verse eid="ISA 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 14:8" />afile di tsipresn freyen zich iber dir,</para>
  <para style="q" vid="ISA 14:8">di tsedern fun Levanon:</para>
  <para style="q" vid="ISA 14:8">fun zint du host zich avekgeleigt,</para>
  <para style="q" vid="ISA 14:8">kumt nisht der heker oif undz.<verse eid="ISA 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 14:9" />di Sheol fun unten tsitert oif tsulib dir,</para>
  <para style="q" vid="ISA 14:9">antkegen dain kumen;</para>
  <para style="q" vid="ISA 14:9">zi vekt di toite tsulib dir,</para>
  <para style="q" vid="ISA 14:9">ale harn fun der erd;</para>
  <para style="q" vid="ISA 14:9">zi macht oifshtein fun zeyere tronen</para>
  <para style="q" vid="ISA 14:9">ale mlochim fun di felker.<verse eid="ISA 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 14:10" />zei ale rufn zich op, un zogn tsu dir:</para>
  <para style="q" vid="ISA 14:10">du oich bist avekgefaln vi mir,</para>
  <para style="q" vid="ISA 14:10">geglichn gevorn tsu undz!<verse eid="ISA 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 14:11" />genidert in Sheol iz dain shtolts,</para>
  <para style="q" vid="ISA 14:11">di brumung fun daine harfn;</para>
  <para style="q" vid="ISA 14:11">unter dir zainen verem gebet,</para>
  <para style="q" vid="ISA 14:11">un dain tsudek iz verem.<verse eid="ISA 14:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 14:12" />vi bistu fun himel gefaln,</para>
  <para style="q" vid="ISA 14:12">du lichtiker morgenshteren!</para>
  <para style="q" vid="ISA 14:12">vi bistu opgehakt gevorn tsu der erd,</para>
  <para style="q" vid="ISA 14:12">du goirl-varfer oif felker!<verse eid="ISA 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 14:13" />un du host gezogt in dain hartsn:</para>
  <para style="q" vid="ISA 14:13">in himel vel ich aroifgein,</para>
  <para style="q" vid="ISA 14:13">iber di shtern fun El</para>
  <para style="q" vid="ISA 14:13">vel ich main tron derheibn;</para>
  <para style="q" vid="ISA 14:13">un ich vel zitsn oifn barg fun ainzamlung,</para>
  <para style="q" vid="ISA 14:13">in di ekn fun tsofn.<verse eid="ISA 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 14:14" />ich vel aroifgein iber di heichn fun volken,</para>
  <para style="q" vid="ISA 14:14">ich vel tsum Elyon zich glaichn.<verse eid="ISA 14:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 14:15" />ober in Sheol vestu genidert vern,</para>
  <para style="q" vid="ISA 14:15">in di ekn fun grub.<verse eid="ISA 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 14:16" />daine zeer veln dich batrachtn,</para>
  <para style="q" vid="ISA 14:16">zei veln dich onkukn:</para>
  <para style="q" vid="ISA 14:16">iz dos der man vos hot gemacht tsiteren di erd,</para>
  <para style="q" vid="ISA 14:16">vos hot oifgeshturemt meluchut,<verse eid="ISA 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 14:17" />gemacht di velt vi a midber,</para>
  <para style="q" vid="ISA 14:17">un tseshtert ire shtet;</para>
  <para style="q" vid="ISA 14:17">zaine gefangene nisht frai gelozt aheim?<verse eid="ISA 14:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 14:18" />ale mlochim fun di felker lign in koved ale,</para>
  <para style="q" vid="ISA 14:18">itlecher in zain heim.<verse eid="ISA 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 14:19" />un du bist avekgevorfen vait fun dain keyver,</para>
  <para style="q" vid="ISA 14:19">vi an umverdik ritl,</para>
  <para style="q" vid="ISA 14:19">arumgeton mit herugim, fun shverd dershtochene,</para>
  <para style="q" vid="ISA 14:19">vos nidern tsu di shteiner fun grub,</para>
  <para style="q" vid="ISA 14:19">vi a peger a tsetretener.<verse eid="ISA 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 14:20" />vest nisht bainand zain mit zei in keyver,</para>
  <para style="q" vid="ISA 14:20">vorem dain land hostu umgebracht,</para>
  <para style="q" vid="ISA 14:20">dain folk hostu geharget;</para>
  <para style="q" vid="ISA 14:20">oif eibik zol nisht ongerufn vern</para>
  <para style="q" vid="ISA 14:20">der zomen fun shlechtstuer.<verse eid="ISA 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 14:21" />breit on oif zaine kinder a shechite,</para>
  <para style="q" vid="ISA 14:21">far der zind fun zeyere eltern,</para>
  <para style="q" vid="ISA 14:21">zei zoln nisht oifshtein un yarshen di erd,</para>
  <para style="q" vid="ISA 14:21">un onfiln dos gezicht fun der velt mit shtet.<verse eid="ISA 14:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 14:22" />un ich vel oifshtein oif zei,</para>
  <para style="q" vid="ISA 14:22">zogt Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 14:22">un vel farshnaidn fun Bavel a nomen un an iberblaib,</para>
  <para style="q" vid="ISA 14:22">un a kind un a kindskind, zogt Hashem.<verse eid="ISA 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 14:23" />un ich vel zei machn tsum arav faran zumpbushl,</para>
  <para style="q" vid="ISA 14:23">un gemoizechtsn vaser;</para>
  <para style="q" vid="ISA 14:23">un ich vel zei avekbezemen mitn bezem fun fartilikung,</para>
  <para style="q" vid="ISA 14:23">zogt Hashem Tseva'ot.<verse eid="ISA 14:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 14:24" />geshvorn hot Hashem Tseva'ot, azoi tsu zogn:</para>
  <para style="q" vid="ISA 14:24">far vor, vi ich hob getracht, azoi vet geshen,</para>
  <para style="q" vid="ISA 14:24">un vi ich hob barotn, dos vet bashtein:<verse eid="ISA 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 14:25" />ich zol tsebrechn Ashur in main land,</para>
  <para style="q" vid="ISA 14:25">un oif maine berg im tsetretn;</para>
  <para style="q" vid="ISA 14:25">un opgeton zol vern fun zei zain yoch,</para>
  <para style="q" vid="ISA 14:25">un zain last zol opgeton vern fun zeyer rukn.<verse eid="ISA 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 14:26" />dos iz der barot vos iz barotn</para>
  <para style="q" vid="ISA 14:26">oif der gantser erd,</para>
  <para style="q" vid="ISA 14:26">un dos iz di hant</para>
  <para style="q" vid="ISA 14:26">vos iz oisgeshtrekt oif ale felker.<verse eid="ISA 14:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 14:27" />vorem Hashem Tseva'ot hot barotn,</para>
  <para style="q" vid="ISA 14:27">un ver vet farshtern?</para>
  <para style="q" vid="ISA 14:27">un zain hant iz oisgeshtrekt</para>
  <para style="q" vid="ISA 14:27">un ver vet zi ophaltn?<verse eid="ISA 14:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28" />in dem yor vos der melech Achaz iz geshtorbn, iz geven di dozike nevue:<verse eid="ISA 14:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="ISA 14:29" />nisht freit zich gants Peleshet,</para>
  <para style="q" vid="ISA 14:29">vos di rut fun dain shleger iz tsebrochn;</para>
  <para style="q" vid="ISA 14:29">vorem fun vortsel fun der shlang vet arois a noter,</para>
  <para style="q" vid="ISA 14:29">un zain frucht iz a fliediker lindvorem.<verse eid="ISA 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 14:30" />un di orimste fun di orime veln zich fitern,</para>
  <para style="q" vid="ISA 14:30">un di baderftike veln hoiern in zicherkeit;</para>
  <para style="q" vid="ISA 14:30">un ich vel teitn mit hunger dain vortsel,</para>
  <para style="q" vid="ISA 14:30">un dain iberblaib vet men oishrgen.<verse eid="ISA 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 14:31" />iomer, du toier, shrai, du shtot,</para>
  <para style="q" vid="ISA 14:31">ver tsegangen, gants Peleshet,</para>
  <para style="q" vid="ISA 14:31">vorem fun tsofn kumt a roich,</para>
  <para style="q" vid="ISA 14:31">un nishto kein opgeshtanener in zaine machnus.<verse eid="ISA 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 14:32" />un vos zol men entfern di shluchim fun dem folk? –</para>
  <para style="q" vid="ISA 14:32">az Hashem hot gegruntfest Tsiyon,</para>
  <para style="q" vid="ISA 14:32">un in ir veln zich shitsn di orime fun zain folk.<verse eid="ISA 14:32" /></para>
  <chapter eid="ISA 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="ISA 15" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1" />di nevue oif Moav:</para>
  <para style="b" vid="ISA 15:1" />
  <para style="q" vid="ISA 15:1">far vor, iber nacht iz farvist gevorn Ar-Moav,</para>
  <para style="q" vid="ISA 15:1">farshnitn gevorn;</para>
  <para style="q" vid="ISA 15:1">far vor, iber nacht iz farvist gevorn Kir-Moav,</para>
  <para style="q" vid="ISA 15:1">farshnitn gevorn.<verse eid="ISA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 15:2" />er iz aroifgegangen kein beis un Divon,</para>
  <para style="q" vid="ISA 15:2">oif di bamot tsu veinen;</para>
  <para style="q" vid="ISA 15:2">oif Nevo un oif Medeva tut yomern Moav;</para>
  <para style="q" vid="ISA 15:2">oif ale zaine kep iz a plich,</para>
  <para style="q" vid="ISA 15:2">yetveder bord iz opgeshnitn.<verse eid="ISA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 15:3" />in zaine gasn gurt men on zak;</para>
  <para style="q" vid="ISA 15:3">oif ire decher un in ire merk,</para>
  <para style="q" vid="ISA 15:3">tut itlecher yomern, tsegeit in gevein.<verse eid="ISA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 15:4" />un klogn tut Cheshbon un Elealeh,</para>
  <para style="q" vid="ISA 15:4">biz Yahats vert gehert zeyer kol;</para>
  <para style="q" vid="ISA 15:4">derum shraien di bavofnte fun Moav;</para>
  <para style="q" vid="ISA 15:4">zain zel tut im tsiteren.<verse eid="ISA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 15:5" />main harts oif Moav tut klogn,</para>
  <para style="q" vid="ISA 15:5">ire antlofene greichn biz Tsoar,</para>
  <para style="q" vid="ISA 15:5">der eglt־shlishih;</para>
  <para style="q" vid="ISA 15:5">vorem der aroifgang fun Luchit,</para>
  <para style="q" vid="ISA 15:5">im geit men aroif mit gevein;</para>
  <para style="q" vid="ISA 15:5">vorem oif dem veg fun Choronayim</para>
  <para style="q" vid="ISA 15:5">a brochgeshrei heibn zei oif.<verse eid="ISA 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 15:6" />vorem di vasern fun Nimrim veln a vistenish vern;</para>
  <para style="q" vid="ISA 15:6">vorem fardart iz dos kraitechts,</para>
  <para style="q" vid="ISA 15:6">farlendt iz dos groz,</para>
  <para style="q" vid="ISA 15:6">kein grins iz nishto.<verse eid="ISA 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 15:7" />derum, di shefe vos zei hobn ongezamlt,</para>
  <para style="q" vid="ISA 15:7">un dos vos zei hobn bahaltn,</para>
  <para style="q" vid="ISA 15:7">veln zei tsum taich fun di verbes avektrogen.<verse eid="ISA 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 15:8" />vorem dos geshrei hot arumgeringlt</para>
  <para style="q" vid="ISA 15:8">dem gemark fun Moav;</para>
  <para style="q" vid="ISA 15:8">biz Eglayim geit ir yelole.</para>
  <para style="q" vid="ISA 15:8">un biz Beer-Elim, ir yelole.<verse eid="ISA 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 15:9" />vorem di vasern fun Dimon zainen ful mit blut;</para>
  <para style="q" vid="ISA 15:9">vorem ich vel Dimon noch gebn a tsulog:</para>
  <para style="q" vid="ISA 15:9">a leib far di antrunene fun Moav,</para>
  <para style="q" vid="ISA 15:9">un far dem iberblaib fun land.<verse eid="ISA 15:9" /></para>
  <chapter eid="ISA 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="ISA 16" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 16:1" />shikt lemer tsum geveltiker fun land,</para>
  <para style="q" vid="ISA 16:1">fun di feldzn vos tsum midber,</para>
  <para style="q" vid="ISA 16:1">tsum barg fun tochter Tsiyon.<verse eid="ISA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 16:2" />un es vet zain:</para>
  <para style="q" vid="ISA 16:2">vi a foigel a farvoglter, vi a nest a tsetribener,</para>
  <para style="q" vid="ISA 16:2">veln zain di techter fun Moav,</para>
  <para style="q" vid="ISA 16:2">bai di iberforn fun Arnon.<verse eid="ISA 16:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 16:3" />nem ein eitse, thua mishpot;</para>
  <para style="q" vid="ISA 16:3">mach dain shotn vi di nacht, in mitn heln tog;</para>
  <para style="q" vid="ISA 16:3">farborg di farshtoisene,</para>
  <para style="q" vid="ISA 16:3">dem farvogltn zolstu nisht antplekn.<verse eid="ISA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 16:4" />maine farshtoisene zoln voinen bai dir – Moav;</para>
  <para style="q" vid="ISA 16:4">zai zei a farborgenish fun dem roiber,</para>
  <para style="q" vid="ISA 16:4">biz avek iz di drikung,</para>
  <para style="q" vid="ISA 16:4">geendikt der roib,</para>
  <para style="q" vid="ISA 16:4">farlendt di tsetreter oisn land;<verse eid="ISA 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 16:5" />vorem oifgeshtelt oif genod iz der tron,</para>
  <para style="q" vid="ISA 16:5">un oif im zitst mit emes, in Dovids getselt,</para>
  <para style="q" vid="ISA 16:5">a richter vos zucht recht,</para>
  <para style="q" vid="ISA 16:5">un iz gich oif gerechtikeit.<verse eid="ISA 16:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 16:6" />mir hobn gehert di shtoltskeit fun Moav,</para>
  <para style="q" vid="ISA 16:6">vi zeyer shtolts er iz;</para>
  <para style="q" vid="ISA 16:6">zain gaive un zain shtoltskeit un zain chutspe,</para>
  <para style="q" vid="ISA 16:6">zaine barimeraien on a haft.<verse eid="ISA 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 16:7" />derum vet yomern Moav oif Moav,</para>
  <para style="q" vid="ISA 16:7">itlecher vet yomern;</para>
  <para style="q" vid="ISA 16:7">noch di rozinkekuchns fun Kir-Chareset vet ir ziftsn,</para>
  <para style="q" vid="ISA 16:7">in gantsn dershlogene.<verse eid="ISA 16:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 16:8" />vorem di felder fun Cheshbon zainen farvelkt,</para>
  <para style="q" vid="ISA 16:8">der vainshtok fun Sivmah,</para>
  <para style="q" vid="ISA 16:8">vos zaine roittroibn hobn fartumlt di harn fun di felker;</para>
  <para style="q" vid="ISA 16:8">biz Yazer hobn zei dergreicht,</para>
  <para style="q" vid="ISA 16:8">bizn midber hobn zei gevandert;</para>
  <para style="q" vid="ISA 16:8">ire tsvaign hobn zich tseshpreit,</para>
  <para style="q" vid="ISA 16:8">biz tsum yam zainen zei ariber.<verse eid="ISA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 16:9" />derum bavein ich in dem gevein fun Yazer,</para>
  <para style="q" vid="ISA 16:9">dem vainshtok fun Sivmah;</para>
  <para style="q" vid="ISA 16:9">ich trink dich on mit maine trern,</para>
  <para style="q" vid="ISA 16:9">Cheshbon un Elealeh;</para>
  <para style="q" vid="ISA 16:9">vorem oif dain harbstung un oif dain shnit</para>
  <para style="q" vid="ISA 16:9">iz a kriggeshrei gefaln.<verse eid="ISA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 16:10" />un aingeton iz di freid</para>
  <para style="q" vid="ISA 16:10">un di lustikeit fun dem fruchtgortn;</para>
  <para style="q" vid="ISA 16:10">un in di vaingertner vert nisht gezungen,</para>
  <para style="q" vid="ISA 16:10">vert nisht geshalt;</para>
  <para style="q" vid="ISA 16:10">kein vain in di keltern tret nisht der treter;</para>
  <para style="q" vid="ISA 16:10">ich hob gemacht oifhern heidad!<verse eid="ISA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 16:11" />derum brumen vi a harf maine gederim oif Moav,</para>
  <para style="q" vid="ISA 16:11">un maine ingeveid oif Kir-Charesh.<verse eid="ISA 16:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ISA 16:12" />un es vet zain, az es vet zich aroisvaizn az Moav hot zich umzist aingemit oif der bamah, vet er araingein in zain heiliktum tfile ton, ober er vet gornisht oisrichtn.<verse eid="ISA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13" />dos iz dos vort vos Hashem hot geredt oif Moav a mol. <verse eid="ISA 16:13" /><verse number="14" style="v" sid="ISA 16:14" />ober atsund hot Hashem geredt, azoi tsu zogn: in drai yor, vi di yorn fun a gedungenem, vet gringeshatst vern der koved fun Moav, bai al dem groisn tuml; un der iberblaib vet zain a klein vintsikeit on shtarkeit.<verse eid="ISA 16:14" /></para>
  <chapter eid="ISA 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="ISA 17" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 17:1" />di nevue oif Damesek:</para>
  <para style="b" vid="ISA 17:1" />
  <para style="q" vid="ISA 17:1">ze Damesek vert ois shtot,</para>
  <para style="q" vid="ISA 17:1">un vet vern a churve-hoifn.<verse eid="ISA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 17:2" />farlozen di shtet fun Aroer,</para>
  <para style="q" vid="ISA 17:2">far stades veln zei zain;</para>
  <para style="q" vid="ISA 17:2">un zei veln hoiern,</para>
  <para style="q" vid="ISA 17:2">un keiner vet nisht opshrekn.<verse eid="ISA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 17:3" />un opgeton vet vern a festung fun Efrayim,</para>
  <para style="q" vid="ISA 17:3">un a meluche fun Damesek;</para>
  <para style="q" vid="ISA 17:3">un der iberblaib fun Aram</para>
  <para style="q" vid="ISA 17:3">vet vern vi di pracht fun di kinder fun Yisroel,</para>
  <para style="q" vid="ISA 17:3">zogt Hashem Tseva'ot.<verse eid="ISA 17:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 17:4" />un es vet zain in yenem tog,</para>
  <para style="q" vid="ISA 17:4">vet farorimt vern di pracht fun Yaakov,</para>
  <para style="q" vid="ISA 17:4">un di fetkeit fun zain laib vet opgetsert vern.<verse eid="ISA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 17:5" />un es vet zain vi a shniter zamlt tvue,</para>
  <para style="q" vid="ISA 17:5">un shnaidt mit zain orem di zangen;</para>
  <para style="q" vid="ISA 17:5">un es vet zain vi me klaibt zangen</para>
  <para style="q" vid="ISA 17:5">in tal fun Refaim.<verse eid="ISA 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 17:6" />nor a nochklaib vet blaibn oif im,</para>
  <para style="q" vid="ISA 17:6">vi baim opklapn an eilbertboim,</para>
  <para style="q" vid="ISA 17:6">tsvei drai perlech oiben baim shpits,</para>
  <para style="q" vid="ISA 17:6">fir finf oif zaine tsvaign, oib fruchtik,</para>
  <para style="q" vid="ISA 17:6">zogt Hashem, Elokei Yisroel.<verse eid="ISA 17:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="ISA 17:7" />in yenem tog vet der mentsh zich kern tsu zain Bashefer, un zaine oign veln kukn tsum heilikn fun Yisroel. <verse eid="ISA 17:7" /><verse number="8" style="v" sid="ISA 17:8" />un er vet zich nisht kern tsu di mizbeyches, di verk fun zaine hent, un nisht onkukn vos zaine finger hobn gemacht, un di getsnbeimer un di zunzailn. <verse eid="ISA 17:8" /><verse number="9" style="v" sid="ISA 17:9" />in yenem tog veln zaine feste shtet zain vi di farloznkeit fun di velder un di bargshpitsn, vos me hot farlozen fun vegen di kinder fun Yisroel; un es vet zain a vistenish.<verse eid="ISA 17:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 17:10" />vorem host fargesen dem G-t fun dain hilf,</para>
  <para style="q" vid="ISA 17:10">un dem feldz fun dain shtarkeit hostu nisht dermont;</para>
  <para style="q" vid="ISA 17:10">derum hostu libleche flantsn geflantst,</para>
  <para style="q" vid="ISA 17:10">un a fremdn tsvaig aingezetst drinen;<verse eid="ISA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 17:11" />in tog fun dain flantsung host es gemacht vaksn,</para>
  <para style="q" vid="ISA 17:11">un frimorgns hostu dain zomen gemacht blien –</para>
  <para style="q" vid="ISA 17:11">a hoifn ritlech in tog fun shtarke</para>
  <para style="q" vid="ISA 17:11">krankshaft un veitog.<verse eid="ISA 17:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 17:12" />vei, di brumung fun fil umes,</para>
  <para style="q" vid="ISA 17:12">vos brumen vi dos brumen fun yamen;</para>
  <para style="q" vid="ISA 17:12">un di roishung fun felker,</para>
  <para style="q" vid="ISA 17:12">vos roishn vi di roishung fun machtike vasern!<verse eid="ISA 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 17:13" />di felker roishn vi di roishung fun fil vasern,</para>
  <para style="q" vid="ISA 17:13">ober er vet onshraien oif zei,</para>
  <para style="q" vid="ISA 17:13">un zei veln antloifn in der vait,</para>
  <para style="q" vid="ISA 17:13">un geyogt vern vi shprei fun di berg faran vint,</para>
  <para style="q" vid="ISA 17:13">un vi a shtoibrod faran shturem.<verse eid="ISA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 17:14" />tsu ovnttsait, ze, a shrekenish!</para>
  <para style="q" vid="ISA 17:14">eider frimorgn zainen zei nishto.</para>
  <para style="q" vid="ISA 17:14">dos iz der chelek fun undzere roiber,</para>
  <para style="q" vid="ISA 17:14">un der goirl far undzere oisroiber.<verse eid="ISA 17:14" /></para>
  <chapter eid="ISA 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="ISA 18" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 18:1" />o, dos land fun fliglzhumerai,</para>
  <para style="q" vid="ISA 18:1">vos fun yener zait taichn fun Kush;<verse eid="ISA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 18:2" />vos shikt ibern yam shluchim,</para>
  <para style="q" vid="ISA 18:2">un in shifn fun yamsh oifn vaser!</para>
  <para style="q" vid="ISA 18:2">geit, shluchim flinke, tsu der hoicher un glantsiker ume,</para>
  <para style="q" vid="ISA 18:2">tsu a folk moiredik fun eibik on,</para>
  <para style="q" vid="ISA 18:2">an ume fun macht un tsetretung,</para>
  <para style="q" vid="ISA 18:2">vos taichn shnaidn durch ir land.<verse eid="ISA 18:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 18:3" />ir ale voiner fun der velt,</para>
  <para style="q" vid="ISA 18:3">un ir vos rut oif der erd,</para>
  <para style="q" vid="ISA 18:3">ven me heibt oif a fon oif di berg, vet ir zen,</para>
  <para style="q" vid="ISA 18:3">un ven me blozt a shoifer, vet ir hern.<verse eid="ISA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 18:4" />vorem azoi hot Hashem gezogt tsu mir:</para>
  <para style="q" vid="ISA 18:4">ich vel ruik tsukukn in main ort,</para>
  <para style="q" vid="ISA 18:4">vi klore hits in zunlicht,</para>
  <para style="q" vid="ISA 18:4">vi a toivolkn in der hits fun shnit.<verse eid="ISA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 18:5" />vorem faran shnit, ven geendikt di bliechts,</para>
  <para style="q" vid="ISA 18:5">un der shprots vert a vaintroib vos tsaitikt zich,</para>
  <para style="q" vid="ISA 18:5">vet er opshnaiden di henglech mit tsvaigmesers,</para>
  <para style="q" vid="ISA 18:5">un di tsvaign tut er op un vorft avek.<verse eid="ISA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 18:6" />zei veln ibergelozt vern in einem</para>
  <para style="q" vid="ISA 18:6">faran roibfoigl fun di berg,</para>
  <para style="q" vid="ISA 18:6">un far der chaye fun der erd;</para>
  <para style="q" vid="ISA 18:6">un vet zumern deroif der roibfoigl,</para>
  <para style="q" vid="ISA 18:6">un itlech chaye fun der erd vet deroif vintern.<verse eid="ISA 18:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 18:7" />in yener tsait vet gebracht vern</para>
  <para style="q" vid="ISA 18:7">a matone tsu Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 18:7">fun der hoicher un glantsiker ume,</para>
  <para style="q" vid="ISA 18:7">fun an ume moiredik fun eibik on,</para>
  <para style="q" vid="ISA 18:7">a folk fun macht un tsetretung,</para>
  <para style="q" vid="ISA 18:7">vos taichn shnaidn durch zain land,</para>
  <para style="q" vid="ISA 18:7">tsum ort fun dem nomen fun Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 18:7">tsum barg Tsiyon.<verse eid="ISA 18:7" /></para>
  <chapter eid="ISA 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="ISA 19" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 19:1" />di nevue oif Mitsrayim:</para>
  <para style="b" vid="ISA 19:1" />
  <para style="q" vid="ISA 19:1">ze, Hashem rait oif a volken a flinkn,</para>
  <para style="q" vid="ISA 19:1">un er kumt kein Mitsrayim;</para>
  <para style="q" vid="ISA 19:1">un di opgeter fun Mitsrayim veln zich treislen far im,</para>
  <para style="q" vid="ISA 19:1">un dos harts fun Mitsrayim vet tsegein in im.<verse eid="ISA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 19:2" />un ich vel onreitsn Mitsrayim oif Mitsrayim,</para>
  <para style="q" vid="ISA 19:2">un zei veln milchome haltn itlecher kegen zain bruder,</para>
  <para style="q" vid="ISA 19:2">a shtot kegen a shtot, a kinigraich kegen a kinigraich.<verse eid="ISA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 19:3" />un oisgeleidikt vet vern der gaist fun Mitsrayim in ir,</para>
  <para style="q" vid="ISA 19:3">un ir eitse vel ich tsunisht machn;</para>
  <para style="q" vid="ISA 19:3">un zei veln forshn bai di opgeter, un bai di prepler,</para>
  <para style="q" vid="ISA 19:3">un bai di gaister, un bai di ruches.<verse eid="ISA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 19:4" />un ich vel iberentfern Mitsrayim</para>
  <para style="q" vid="ISA 19:4">in der hant fun a hartn har,</para>
  <para style="q" vid="ISA 19:4">un a shtrenger melech vet geveltikn iber zei,</para>
  <para style="q" vid="ISA 19:4">zogt der har, Hashem Tseva'ot.<verse eid="ISA 19:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 19:5" />un di vasern veln oisgein fun yam,</para>
  <para style="q" vid="ISA 19:5">un der taich vet oisgetriknt un trukn vern.<verse eid="ISA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 19:6" />un dumpik veln vern di taichn,</para>
  <para style="q" vid="ISA 19:6">farminert un oisgetriknt vern di flusn fun Mitsrayim;</para>
  <para style="q" vid="ISA 19:6">ruhrn un air vern farvelkt.<verse eid="ISA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 19:7" />hoil vert baim Nilus, baim rand funem Nilus,</para>
  <para style="q" vid="ISA 19:7">un al dos farzeite baim Nilus</para>
  <para style="q" vid="ISA 19:7">vert fartriknt, farveit, un nishto.<verse eid="ISA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 19:8" />un klogn veln di fisher,</para>
  <para style="q" vid="ISA 19:8">un troiern veln ale vos vorfn a ventke in Nilus,</para>
  <para style="q" vid="ISA 19:8">un di vos shpreitn a nets oifn vaser vern farshnitn.<verse eid="ISA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 19:9" />un farshemt veln vern</para>
  <para style="q" vid="ISA 19:9">di arbeter fun gekamtn flaks,</para>
  <para style="q" vid="ISA 19:9">un di veber fun veistsaig.<verse eid="ISA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 19:10" />un ire grindungn veln zain tsedrikt;</para>
  <para style="q" vid="ISA 19:10">ale loinarbeter batribt in gemit.<verse eid="ISA 19:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 19:11" />loiter narn zainen di harn fun Tsoan,</para>
  <para style="q" vid="ISA 19:11">di kligste yoetsim fun Pharaohn zainen a narisher barot.</para>
  <para style="q" vid="ISA 19:11">vi kent ir zogn tsu Pharaohn:</para>
  <para style="q" vid="ISA 19:11">a zun fun chachomim bin ich,</para>
  <para style="q" vid="ISA 19:11">a zun fun mlochim fartsaitike?<verse eid="ISA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 19:12" />vu zainen zei den daine chachomim?</para>
  <para style="q" vid="ISA 19:12">zoln zei akorsht dir zogn;</para>
  <para style="q" vid="ISA 19:12">un lamen visen vos Hashem Tseva'ot</para>
  <para style="q" vid="ISA 19:12">hot barotn oif Mitsrayim.<verse eid="ISA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 19:13" />farnarisht zainen di harn fun Tsoan,</para>
  <para style="q" vid="ISA 19:13">opgenart zainen di harn fun Nof;</para>
  <para style="q" vid="ISA 19:13">farfirt hobn Mitsrayim</para>
  <para style="q" vid="ISA 19:13">di pnei fun ire shvotim.<verse eid="ISA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 19:14" />Hashem hot araingegosn in ir</para>
  <para style="q" vid="ISA 19:14">a gaist fun fardreyenish;</para>
  <para style="q" vid="ISA 19:14">un zei hobn gemacht Mitsrayim zich vaklen in al zain tuung</para>
  <para style="q" vid="ISA 19:14">vi a shiker tut zich vaklen bai zain brechn.<verse eid="ISA 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 19:15" />un in Mitsrayim vet nisht zain an oiftu</para>
  <para style="q" vid="ISA 19:15">vos a kop oder an ek,</para>
  <para style="q" vid="ISA 19:15">a teitltsvaig oder a taichritl zol oifton.<verse eid="ISA 19:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16" />in yenem tog vet Mitsrayim zain azoi vi vaiber, un er vet tsiteren un angstn faran fach fun der hant fun Hashem Tseva'ot, vos er tut fochn oif im. <verse eid="ISA 19:16" /><verse number="17" style="v" sid="ISA 19:17" />un dos land fun Yehudah vet vern far Mitsrayim a shrekenish; ven nor me vet es im dermonen, vet er angstn far dem barot fun Hashem Tseva'ot, vos er tut barotn oif im.<verse eid="ISA 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18" />in yenem tog veln zain in land Mitsrayim finf shtet vos redn di shprach fun Kenaan, un shvern tsu Hashem Tseva'ot; di shtot fun tseshterung vet eine gerufn vern.<verse eid="ISA 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19" />in yenem tog vet zain a mizbeyech tsu Hashem in mitn land Mitsrayim, un a zailshtein tsu Hashem bai ir gemark. <verse eid="ISA 19:19" /><verse number="20" style="v" sid="ISA 19:20" />un es vet zain tsum tseichn un tsum eides far Hashem Tseva'ot in land Mitsrayim; az zei veln shraien tsu Hashem fun vegen driker, vet er zei shikn a helfer un a shtraiter, un er vet zei matsl zain. <verse eid="ISA 19:20" /><verse number="21" style="v" sid="ISA 19:21" />un Hashem vet zich lozn derkenen tsu Mitsrayim, un di Mitsrayim veln derkenen Hashem in yenem tog, un dinen mit shlachtopfer un shpaizopfer, un mender zain a neyder tsu Hashem un batsoln. <verse eid="ISA 19:21" /><verse number="22" style="v" sid="ISA 19:22" />un Hashem vet plogn Mitsrayim – plogn un heiln; un az zei veln zich umkeren tsu Hashem, vet er zich iberbeten tsu zei, un zei heiln.<verse eid="ISA 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23" />in yenem tog vet zain a veg fun Mitsrayim kein Ashur, un Ashur vet kumen in Mitsrayim, un Mitsrayim in Ashur, un Mitsrayim vet dinen Hashem mit Ashur.<verse eid="ISA 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 19:24" />in yenem tog vet Yisroel zain a driter tsu Mitsrayim un tsu Ashur, a bentshung in mitn fun der erd; <verse eid="ISA 19:24" /><verse number="25" style="v" sid="ISA 19:25" />vail Hashem Tseva'ot hot im gebentsht, azoi tsu zogn: gebentsht zol zain main folk Mitsrayim, un dos verk fun maine hent, Ashur, un main arbung, Yisroel.<verse eid="ISA 19:25" /></para>
  <chapter eid="ISA 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="ISA 20" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1" />in dem yor vos Tartan iz gekumen kein Ashdod, ven Sargon der melech fun Ashur hot im geshikt, un er hot milchome gehaltn mit Ashdod, un hot zi batsvungen; <verse eid="ISA 20:1" /><verse number="2" style="v" sid="ISA 20:2" />in yener tsait hot Hashem geredt durch Yeshayahu dem zun fun Amotsn, azoi tsu zogn: gei, un zolst opbindn dos zak fun daine lendn, un dain shuch zolstu aroptsien fun dain fus. hot er azoi geton: arumgegangen naket un borves.<verse eid="ISA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3" />un Hashem hot gezogt: azoi vi main knecht Yeshayahu iz arumgegangen naket un borves drai yor, far a simen un a tseichn oif Mitsrayim un oif Kush, <verse eid="ISA 20:3" /><verse number="4" style="v" sid="ISA 20:4" />azoi vet der melech fun Ashur avekfiren di gefangene fun Mitsrayim, un di fartribene fun Kush, yunge un alte, naket un borves, mit opgedektn hinter-laib, tsu der shand fun Mitsrayim. <verse eid="ISA 20:4" /><verse number="5" style="v" sid="ISA 20:5" />un zei veln zain tsebrochn un farshemt fun vegen Kush, zeyer oiskuk, un fun vegen Mitsrayim, zeyer baremung. <verse eid="ISA 20:5" /><verse number="6" style="v" sid="ISA 20:6" />un der bavoiner fun dozikn bregland vet zogn in yenem tog: ze, azoi iz gevorn fun undzer oiskuk, vos mir zainen ahin gelofn noch hilf, nitsl tsu vern fun melech fun Ashur, un vi veln mir antrunen vern?<verse eid="ISA 20:6" /></para>
  <chapter eid="ISA 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="ISA 21" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 21:1" />di nevue oif dem midber baim yam:</para>
  <para style="b" vid="ISA 21:1" />
  <para style="q" vid="ISA 21:1">vi shturems in dorem vet es durchgein;</para>
  <para style="q" vid="ISA 21:1">fun midber kumt es, fun a moyredikn land.<verse eid="ISA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 21:2" />a shvere zeung iz mir ongezogt gevorn:</para>
  <para style="q" vid="ISA 21:2">der felsher felsht, un der roiber roibt.</para>
  <para style="q" vid="ISA 21:2">gei, aroif Eilam! baleger, Madai!</para>
  <para style="q" vid="ISA 21:2">ale ziftsn vos durch ir mach ich oifhern.<verse eid="ISA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 21:3" />derum zainen maine lendn ful mit tsiterenish,</para>
  <para style="q" vid="ISA 21:3">veyen hobn mich ongenumen</para>
  <para style="q" vid="ISA 21:3">vi veyen fun a gevinerin;</para>
  <para style="q" vid="ISA 21:3">ich bin tsekrimt un ken nisht hern,</para>
  <para style="q" vid="ISA 21:3">ich bin tsetumlt un ken nisht zen.<verse eid="ISA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 21:4" />tsedult iz main harts,</para>
  <para style="q" vid="ISA 21:4">an angst hot mich tsegroilt;</para>
  <para style="q" vid="ISA 21:4">main glustikn ovnt</para>
  <para style="q" vid="ISA 21:4">hot men mir tsu shoider gemacht.<verse eid="ISA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 21:5" />me greit dem tish, me dekt di deke,</para>
  <para style="q" vid="ISA 21:5">me est, me trinkt –</para>
  <para style="q" vid="ISA 21:5">shteit oif, ir harn, bazalbt dem shild!<verse eid="ISA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 21:6" />vorem azoi hot tsu mir Adonoi gezogt:</para>
  <para style="q" vid="ISA 21:6">gei shtel a vechter;</para>
  <para style="q" vid="ISA 21:6">vos er vet zen zol er zogn.<verse eid="ISA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 21:7" />un az er vet zen a gerait, geshpanen ferd,</para>
  <para style="q" vid="ISA 21:7">a gerait eizlen, a gerait kemlen,</para>
  <para style="q" vid="ISA 21:7">zol er horchn a horchung, a horchung a groise.<verse eid="ISA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 21:8" />hot er oisgeshrien vi a leib:</para>
  <para style="q" vid="ISA 21:8">oifn vachturem, Adonoi, shtei ich tamid bai tog,</para>
  <para style="q" vid="ISA 21:8">un oif main hitung bin ich geshtelt ale necht.<verse eid="ISA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 21:9" />un ze, ot iz gekumen a gerait mentshn,</para>
  <para style="q" vid="ISA 21:9">geshpanen ferd; un er hot oisgerufn un gezogt:</para>
  <para style="q" vid="ISA 21:9">gefaln, gefaln iz Bavel,</para>
  <para style="q" vid="ISA 21:9">un ale ire shnitsgeter</para>
  <para style="q" vid="ISA 21:9">hot men tsebrochn tsu der erd.<verse eid="ISA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 21:10" />du gedroshene maine, un kind fun main shaier,</para>
  <para style="q" vid="ISA 21:10">vos ich hob gehert fun Hashem Tseva'ot Elokei Yisroel,</para>
  <para style="q" vid="ISA 21:10">aich hob ich dertseilt.<verse eid="ISA 21:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11" />di nevue oif Dumah.</para>
  <para style="b" vid="ISA 21:11" />
  <para style="q" vid="ISA 21:11">tsu mir ruft men fun Seir:</para>
  <para style="q" vid="ISA 21:11">vechter, vos fun der nacht?</para>
  <para style="q" vid="ISA 21:11">vechter, vos fun der nacht?<verse eid="ISA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 21:12" />zogt der vechter: gekumen frimorgn un oich nacht;</para>
  <para style="q" vid="ISA 21:12">oib ir vilt fregn, fregt,</para>
  <para style="q" vid="ISA 21:12">kumt vider tsu gein.<verse eid="ISA 21:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13" />di nevue oif Arav:</para>
  <para style="b" vid="ISA 21:13" />
  <para style="q" vid="ISA 21:13">vi in vald vet ir nechtikn in Arav,</para>
  <para style="q" vid="ISA 21:13">karavanen fun dedonim.<verse eid="ISA 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 21:14" />brengt vaser antkegen dem dorshtikn;</para>
  <para style="q" vid="ISA 21:14">di bavoiner fun land Tema</para>
  <para style="q" vid="ISA 21:14">zoln bagegenen mit broit far im dem farvogltn.<verse eid="ISA 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 21:15" />vorem fun shverdn zainen zei antlofn,</para>
  <para style="q" vid="ISA 21:15">fun der getsoigener shverd,</para>
  <para style="q" vid="ISA 21:15">un fun dem geshpantn boign,</para>
  <para style="q" vid="ISA 21:15">un fun der shverer milchome.<verse eid="ISA 21:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16" />vorem azoi hot tsu mir Adonoi gezogt: in noch a yor, vi di yorn fun a gedungenem, vet farlendt vern di gantse pracht fun Kedar, <verse eid="ISA 21:16" /><verse number="17" style="v" sid="ISA 21:17" />un di geblibene tsol boignlait, di giborim fun di kinder fun Kedar, veln zain vintsik, vorem Hashem Elokei Yisroel hot geredt.<verse eid="ISA 21:17" /></para>
  <chapter eid="ISA 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="ISA 22" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 22:1" />di nevue oif dem tal fun zeung:</para>
  <para style="b" vid="ISA 22:1" />
  <para style="q" vid="ISA 22:1">vos iz dir den</para>
  <para style="q" vid="ISA 22:1">vos du bist in gantsn oif di decher aroif,<verse eid="ISA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 22:2" />du fule mit tuml,</para>
  <para style="q" vid="ISA 22:2">du roishike shtot, du lustiker kerch?</para>
  <para style="q" vid="ISA 22:2">daine dershlogene zainen nisht fun shverd dershlogn,</para>
  <para style="q" vid="ISA 22:2">un nisht in milchome geteite.<verse eid="ISA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 22:3" />ale daine harn zainen in einem antlofn,</para>
  <para style="q" vid="ISA 22:3">on a boign zainen zei gefangen gevorn;</para>
  <para style="q" vid="ISA 22:3">ale daine gefunene zainen in einem gefangen gevorn –</para>
  <para style="q" vid="ISA 22:3">di vos zainen in der vait antlofn.<verse eid="ISA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 22:4" />derum hob ich gezogt:</para>
  <para style="q" vid="ISA 22:4">kert aich op fun mir, lomich biterlech veinen;</para>
  <para style="q" vid="ISA 22:4">ir zolt nisht tsushtein mich tsu treistn,</para>
  <para style="q" vid="ISA 22:4">oif dem broch fun der tochter main folk.<verse eid="ISA 22:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 22:5" />vorem a tog fun tuml un tretung un tsetumltkeit</para>
  <para style="q" vid="ISA 22:5">iz bai Adonoi, Hashem Tseva'ot, in tal fun zeung;</para>
  <para style="q" vid="ISA 22:5">me brecht moiern, un a geshrei bizn barg.<verse eid="ISA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 22:6" />un Eilam trogt dem failbaitl,</para>
  <para style="q" vid="ISA 22:6">mit a machne mentshn raiter,</para>
  <para style="q" vid="ISA 22:6">un Kir hot antbloizt dem shild.<verse eid="ISA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 22:7" />un es iz geven,</para>
  <para style="q" vid="ISA 22:7">az daine beste toln zainen ful gevorn mit raitvegn,</para>
  <para style="q" vid="ISA 22:7">un di raiter hobn shteln zich oisgeshtelt kegen toier,<verse eid="ISA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 22:8" />un dem tsudek fun Yehudah hot men opgedekt.</para>
  <para style="b" vid="ISA 22:8" />
  <para style="p" vid="ISA 22:8">in yenem tog hostu oisgekukt oifn vafn fun vald-hoiz. <verse eid="ISA 22:8" /><verse number="9" style="v" sid="ISA 22:9" />un di shpaltn fun Dovids-shtot hot ir gezen az zei zainen fil; un ir hot aingezamlt dos vaser fun untershtn taich. <verse eid="ISA 22:9" /><verse number="10" style="v" sid="ISA 22:10" />un di haizer fun Yerushalayim hot ir fartseichnt, un aingevorfn di haizer tsu bafestikn di moier. <verse eid="ISA 22:10" /><verse number="11" style="v" sid="ISA 22:11" />un a zamlort tsvishn di tsvei moiern hot ir gemacht, far dem vaser fun alten taich. un ir hot nisht gekukt tsu dem vos hot es geton, un dem vos hot es bashert fun lang on hot ir nisht gezen.<verse eid="ISA 22:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 22:12" />un Adonoi, Hashem Tseva'ot, hot gerufn in yenem tog,</para>
  <para style="q" vid="ISA 22:12">tsu gevein un tsu klog un tsu plichenish,</para>
  <para style="q" vid="ISA 22:12">un tsum ongurtn zak;<verse eid="ISA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 22:13" />ersht es iz sason-usimchh,</para>
  <para style="q" vid="ISA 22:13">koiln rinder un shechtn shof,</para>
  <para style="q" vid="ISA 22:13">esen fleish, un trinken vain;</para>
  <para style="q" vid="ISA 22:13">esen un trinken, vorem morgn veln mir shtarbn.<verse eid="ISA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 22:14" />un Hashem Tseva'ot hot zich antplekt in maine oiern:</para>
  <para style="q" vid="ISA 22:14">oib di dozike zind vet aich fargebn vern</para>
  <para style="q" vid="ISA 22:14">biz ir vet shtarbn!</para>
  <para style="q" vid="ISA 22:14">hot gezogt Adonoi, Hashem Tseva'ot.<verse eid="ISA 22:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15" />azoi hot gezogt Adonoi, Hashem Tseva'ot: gei kum tsu dem dozikn oifzeer, tsu Shevna vos ibern palats: <verse eid="ISA 22:15" /><verse number="16" style="v" sid="ISA 22:16" />vos hostu do, un vemen hostu do, vos du host dir do a keyver oisgehakt, du vos host oisgehakt in der heich dain keyver, zich oisgeshniten in feldz a voinung? <verse eid="ISA 22:16" /><verse number="17" style="v" sid="ISA 22:17" />ze, Hashem shlaidert dich a machtikn shlaider, un dreit dich um dreyendik; <verse eid="ISA 22:17" /><verse number="18" style="v" sid="ISA 22:18" />kulien in a kol vet er dich avekkulien, vi a bal, in a breitroimik land. dortn vestu shtarbn, un dortn veln zain daine prachtike raitvegn, du shand fun dem hoiz fun dain har! <verse eid="ISA 22:18" /><verse number="19" style="v" sid="ISA 22:19" />un ich vel dich aropshtoisn fun dain shtand, un fun dain shtel vet men dich aropvarfen. <verse eid="ISA 22:19" /><verse number="20" style="v" sid="ISA 22:20" />un es vet zain in yenem tog, vel ich rufn main knecht Elyakim dem zun fun Chilkiyahun. <verse eid="ISA 22:20" /><verse number="21" style="v" sid="ISA 22:21" />un ich vel im onton dain mantl, un dain gartel vel ich im arumbindn, un dain memshole vel ich gebn in zain hant; un er vet zain far a foter tsum bavoiner fun Yerushalayim, un tsum hoiz fun Yehudah. <verse eid="ISA 22:21" /><verse number="22" style="v" sid="ISA 22:22" />un ich vel gebn dem shlisel fun Dovids hoiz oif zain aksl, un er vet efenen, un keiner vet nisht farshlisn, un er vet farshlisn, un keiner vet nisht efenen. <verse eid="ISA 22:22" /><verse number="23" style="v" sid="ISA 22:23" />un ich vel im bafestikn vi a flekl in a zichern ort; un er vet zain a tron fun koved far zain foters hoiz. <verse eid="ISA 22:23" /><verse number="24" style="v" sid="ISA 22:24" />un dos gantse gezeml fun zain foters hoiz, kind un keit, veln onhengen oif im ale kleine gefesn, fun di bekngefesn un biz ale kruggefesn. <verse eid="ISA 22:24" /><verse number="25" style="v" sid="ISA 22:25" />in yenem tog, zogt Hashem Tseva'ot, vet opgeton vern dos flekl vos iz bafestikt in a zichern ort, un vet opgehakt vern un aropfaln, un di mase vos oif im vet farshnitn vern; vorem Hashem hot geredt.<verse eid="ISA 22:25" /></para>
  <chapter eid="ISA 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="ISA 23" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 23:1" />di nevue oif Tsor:</para>
  <para style="b" vid="ISA 23:1" />
  <para style="q" vid="ISA 23:1">iomert ir shifn fun Tarshish,</para>
  <para style="q" vid="ISA 23:1">vorem zi iz farvist, on a hoiz, on an aingang;</para>
  <para style="q" vid="ISA 23:1">fun land fun di Kittim</para>
  <para style="q" vid="ISA 23:1">iz dos zei antplekt gevorn.<verse eid="ISA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 23:2" />zait shtil, ir bavoiner fun indzel;</para>
  <para style="q" vid="ISA 23:2">du vos di sochrim fun Tsidon,</para>
  <para style="q" vid="ISA 23:2">di yam-forer, hobn dich ongefilt.<verse eid="ISA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 23:3" />un iber groise vasern iz der zomen fun Shichor,</para>
  <para style="q" vid="ISA 23:3">der shnit fun Nilus, ir ainkum geven;</para>
  <para style="q" vid="ISA 23:3">un zi iz geven der mark fun di felker.<verse eid="ISA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 23:4" />shem zich Tsidon, vorem der yam hot gezogt,</para>
  <para style="q" vid="ISA 23:4">di festung fun yam, azoi tsu zogn:</para>
  <para style="q" vid="ISA 23:4">vi ich volt gornisht geveitokt un nisht geborn,</para>
  <para style="q" vid="ISA 23:4">un kein bochurim nisht dertsoign,</para>
  <para style="q" vid="ISA 23:4">oder yungfroin oifgebracht.<verse eid="ISA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 23:5" />az me vet hern in Mitsrayim,</para>
  <para style="q" vid="ISA 23:5">vet men tsiteren bai der herung fun Tsor.<verse eid="ISA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 23:6" />geit ariber kein Tarshish,</para>
  <para style="q" vid="ISA 23:6">iomert, ir bavoiner fun indzel.<verse eid="ISA 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 23:7" />iz dos aich di freileche shtot,</para>
  <para style="q" vid="ISA 23:7">vos fun frie fartsaitike teg flegn zi firn ire fis</para>
  <para style="q" vid="ISA 23:7">in der vaitn tsu voinen?<verse eid="ISA 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 23:8" />ver hot dos barotn oif Tsor der bakrointer,</para>
  <para style="q" vid="ISA 23:8">vos ire sochrim zainen geven srores,</para>
  <para style="q" vid="ISA 23:8">ire handlslait di nichbodim fun der erd?<verse eid="ISA 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 23:9" />Hashem Tseva'ot hot dos barotn,</para>
  <para style="q" vid="ISA 23:9">tsu farshvechn dem shtolts fun al der sheinkeit,</para>
  <para style="q" vid="ISA 23:9">tsu machn gringgeshatst ale nichbodim fun der erd.<verse eid="ISA 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 23:10" />iberfleits dain land vi der Nilus, tochter Tarshish,</para>
  <para style="q" vid="ISA 23:10">nishto mer kein aintsam.<verse eid="ISA 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 23:11" />er hot oisgeshtrekt zain hant ibern yam,</para>
  <para style="q" vid="ISA 23:11">er hot gemacht tsiteren meluchut;</para>
  <para style="q" vid="ISA 23:11">Hashem hot bafoiln vegen Kenaan,</para>
  <para style="q" vid="ISA 23:11">tsu fartiliken ire festungen.<verse eid="ISA 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 23:12" />un er hot gezogt: vest nisht mer lustik zain,</para>
  <para style="q" vid="ISA 23:12">geshendte yungfroi tochter Tsidon.</para>
  <para style="q" vid="ISA 23:12">shtei oif, gei ariber kein Kittim;</para>
  <para style="q" vid="ISA 23:12">oich dort vestu kein menuche nisht hobn.<verse eid="ISA 23:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ISA 23:13" />ze, dos land fun di Kasdim – di dozike ume iz noch nisht geven ven Ashur hot es gegruntfest far midber-bashefenishn – zei hobn oifgeshtelt zeyere balegerturems, zei hobn aingevorfn ire palatsn; me hot zei gemacht far a churve.<verse eid="ISA 23:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 23:14" />iomert ir shifn fun Tarshish,</para>
  <para style="q" vid="ISA 23:14">vorem farvist gevorn iz aier festung.<verse eid="ISA 23:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15" />un es vet zain in yenem tog: vet Tsor zain fargesen zibetsik yor, azoi vi di teg fun ein melech; tsum sof fun zibetsik yor vet geshen mit Tsor azoi vi in gezang fun der zoine:<verse eid="ISA 23:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 23:16" />nem a harf,</para>
  <para style="q" vid="ISA 23:16">gei um in shtot,</para>
  <para style="q" vid="ISA 23:16">fargesene zoine;</para>
  <para style="q" vid="ISA 23:16">shpil shein,</para>
  <para style="q" vid="ISA 23:16">zing fil,</para>
  <para style="q" vid="ISA 23:16">kedei zolst dermont vern.<verse eid="ISA 23:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17" />un es vet zain tsum sof fun zibetsik yor, vet Hashem zich dermonen on Tsor, un zi vet zich umkeren tsu ir zoine-loin, un vet vider farkern mit ale kinigraichn fun der velt oifn gezicht fun der erd. <verse eid="ISA 23:17" /><verse number="18" style="v" sid="ISA 23:18" />ober ir fardinst un ir zoine-loin vet zain heilik tsu Hashem; er vet nisht bahaltn un nisht aingeshlosn vern; naiert far di vos zitsn far Hashem vet zain ir fardinst, tsu esen tsu zat, un far a tsudek a sheinem.<verse eid="ISA 23:18" /></para>
  <chapter eid="ISA 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="ISA 24" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 24:1" />ze, Hashem leidikt ois di erd un farvist zi,</para>
  <para style="q" vid="ISA 24:1">un vet tsedreyen ir ponem,</para>
  <para style="q" vid="ISA 24:1">un tseshpreitn ire bavoiner.<verse eid="ISA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 24:2" />un es vet zain,</para>
  <para style="q" vid="ISA 24:2">azoi dos folk azoi der koyen,</para>
  <para style="q" vid="ISA 24:2">azoi der knecht azoi zain har,</para>
  <para style="q" vid="ISA 24:2">azoi di dinst azoi ir harinte,</para>
  <para style="q" vid="ISA 24:2">azoi der koifer azoi der farkoifer,</para>
  <para style="q" vid="ISA 24:2">azoi der mlvh azoi der laier,</para>
  <para style="q" vid="ISA 24:2">azoi der moner azoi der vos me mont fun im.<verse eid="ISA 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 24:3" />oisgeleidikt vet oisgeleidikt vern di erd,</para>
  <para style="q" vid="ISA 24:3">un tseroibt vet zi tseroibt vern;</para>
  <para style="q" vid="ISA 24:3">vorem Hashem hot geredt dos dozike vort.<verse eid="ISA 24:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 24:4" />farovlt, farvelkt iz di erd,</para>
  <para style="q" vid="ISA 24:4">farshnitn, farvelkt iz di velt,</para>
  <para style="q" vid="ISA 24:4">farshnitn di hoiche lait fun der erd.<verse eid="ISA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 24:5" />un di erd iz zindik unter ire bavoiner,</para>
  <para style="q" vid="ISA 24:5">vorem zei hobn oiver geven oif di toyres,</para>
  <para style="q" vid="ISA 24:5">ibergetretn dos gezets,</para>
  <para style="q" vid="ISA 24:5">farshtert dem eibikn bris.<verse eid="ISA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 24:6" />derum est oif a klole di erd,</para>
  <para style="q" vid="ISA 24:6">un farshuldikt zainen di voiner derin;</para>
  <para style="q" vid="ISA 24:6">derum geyen ain di bavoiner fun der erd,</para>
  <para style="q" vid="ISA 24:6">un mentshn blaibn vintsik.<verse eid="ISA 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 24:7" />es troiert der vain, farvelkt iz der vainshtok,</para>
  <para style="q" vid="ISA 24:7">es ziftsn ale freileche hertser.<verse eid="ISA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 24:8" />oifgehert hot di freid fun di poikn,</para>
  <para style="q" vid="ISA 24:8">farmitn iz der liarem fun di lustike,</para>
  <para style="q" vid="ISA 24:8">oifgehert hot di freid fun der harf.<verse eid="ISA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 24:9" />me trinkt nisht kein vain mit gezang,</para>
  <para style="q" vid="ISA 24:9">biter iz der trunk zaine trinker.<verse eid="ISA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 24:10" />tsebrochn iz di nishtike shtot,</para>
  <para style="q" vid="ISA 24:10">farshlosn itlech hoiz nisht araintsugein.<verse eid="ISA 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 24:11" />a veigeshrei in di gasn baim vain;</para>
  <para style="q" vid="ISA 24:11">farfintstert iz itleche simche,</para>
  <para style="q" vid="ISA 24:11">farvogelt di freid funem land.<verse eid="ISA 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 24:12" />geblibn iz a vistkeit in shtot,</para>
  <para style="q" vid="ISA 24:12">un tsehakt in a churve iz der toier.<verse eid="ISA 24:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 24:13" />vorem azoi vet es zain in mitn fun der erd,</para>
  <para style="q" vid="ISA 24:13">tsvishn di felker; vi baim opklapn an eilbertboim,</para>
  <para style="q" vid="ISA 24:13">vi a nochklaib ven di lez iz geendikt.<verse eid="ISA 24:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 24:14" />di dozike veln oifheibn zeyer kol in gezang,</para>
  <para style="q" vid="ISA 24:14">vegen der groiskeit fun Hashem tuen zei shaln fun im.<verse eid="ISA 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 24:15" />derum tut erlechn Hashem in di lender fun licht,</para>
  <para style="q" vid="ISA 24:15">oif di inzlen fun yam, dem nomen fun Hashem Elokei Yisroel.<verse eid="ISA 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 24:16" />fun ek erd hobn mir gezangen gehert:</para>
  <para style="q" vid="ISA 24:16">pracht tsu dem gerechtn!</para>
  <para style="q" vid="ISA 24:16">ober ich zog: ich gei ain,</para>
  <para style="q" vid="ISA 24:16">ich gei ain, vei iz mir!</para>
  <para style="q" vid="ISA 24:16">di felsher tuen felshn,</para>
  <para style="q" vid="ISA 24:16">yo, a felshung felshn di felsher.<verse eid="ISA 24:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 24:17" />a groil un a grub un a nets</para>
  <para style="q" vid="ISA 24:17">oif dir, bavoiner fun der erd.<verse eid="ISA 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 24:18" />un es vet zain,</para>
  <para style="q" vid="ISA 24:18">der vos antloift fun dem kol fun groil,</para>
  <para style="q" vid="ISA 24:18">vet arainfaln in grub,</para>
  <para style="q" vid="ISA 24:18">un der vos kumt aroif fun grub,</para>
  <para style="q" vid="ISA 24:18">vet gefangen vern in nets;</para>
  <para style="q" vid="ISA 24:18">vorem di fentster fun der heich hobn zich geefent,</para>
  <para style="q" vid="ISA 24:18">un es shturemen di gruntfestn fun der erd.<verse eid="ISA 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 24:19" />brechn tsebrecht zich di erd,</para>
  <para style="q" vid="ISA 24:19">breklen tsebreklt zich di erd,</para>
  <para style="q" vid="ISA 24:19">vaklen tut zich vaklen di erd.<verse eid="ISA 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 24:20" />shoklen vi a shikurer vet zich shoklen di erd,</para>
  <para style="q" vid="ISA 24:20">un vet zich treislen vi a nachtbaidl;</para>
  <para style="q" vid="ISA 24:20">un shver vet zain ir farbrech oif ir,</para>
  <para style="q" vid="ISA 24:20">un zi vet faln, un mer nisht oifshtein.<verse eid="ISA 24:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 24:21" />un es vet zain in yenem tog,</para>
  <para style="q" vid="ISA 24:21">vet Hashem zich rechenen mit dem cheil</para>
  <para style="q" vid="ISA 24:21">fun der heich in der heich,</para>
  <para style="q" vid="ISA 24:21">un mit di mlochim fun der erd</para>
  <para style="q" vid="ISA 24:21">oif der erd.<verse eid="ISA 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 24:22" />un zei veln aingezamlt vern</para>
  <para style="q" vid="ISA 24:22">vi me zamlt gefangene in tefish,</para>
  <para style="q" vid="ISA 24:22">un zei veln aingeshlosn vern in festung,</para>
  <para style="q" vid="ISA 24:22">un ersht noch fil teg veln zei dermont vern.<verse eid="ISA 24:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 24:23" />un di levone vet zich shemen,</para>
  <para style="q" vid="ISA 24:23">un di zun vet farshemt vern,</para>
  <para style="q" vid="ISA 24:23">vorem Hashem Tseva'ot tut kinign</para>
  <para style="q" vid="ISA 24:23">oif barg Tsiyon, un in Yerushalayim;</para>
  <para style="q" vid="ISA 24:23">un antkegen zaine eltste vet zain a prachtikeit.<verse eid="ISA 24:23" /></para>
  <chapter eid="ISA 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="ISA 25" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 25:1" />Hashem, du bist main G-t,</para>
  <para style="q" vid="ISA 25:1">ich vel dich derheibn,</para>
  <para style="q" vid="ISA 25:1">ich vel loibn dain nomen,</para>
  <para style="q" vid="ISA 25:1">vorem host oifgeton vunder;</para>
  <para style="q" vid="ISA 25:1">di barotn fun lang on –</para>
  <para style="q" vid="ISA 25:1">mit traier getraishaft.<verse eid="ISA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 25:2" />vorem host gemacht fun a shtot a hoifn,</para>
  <para style="q" vid="ISA 25:2">a bafestiktn kerch far a churve,</para>
  <para style="q" vid="ISA 25:2">di palatsn fun fremde far ois shtot,</para>
  <para style="q" vid="ISA 25:2">zei zoln eibik nisht opgeboit vern.<verse eid="ISA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 25:3" />derum vet dich erlechn di shtarke ume,</para>
  <para style="q" vid="ISA 25:3">der kerch fun machtike felker vet dich forchtn.<verse eid="ISA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 25:4" />vorem bist geven a festung dem oreman,</para>
  <para style="q" vid="ISA 25:4">a festung dem baderftikn in zain noit,</para>
  <para style="q" vid="ISA 25:4">a shuts fun gusregn,</para>
  <para style="q" vid="ISA 25:4">a shotn fun hits;</para>
  <para style="q" vid="ISA 25:4">vorem der tsorn fun di machtike</para>
  <para style="q" vid="ISA 25:4">iz vi a gusregn oif a vant.<verse eid="ISA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 25:5" />azoi vi hits in a trukenem land,</para>
  <para style="q" vid="ISA 25:5">dos geroish fun di fremde untertenikstu;</para>
  <para style="q" vid="ISA 25:5">vi hits durch a volknshotn,</para>
  <para style="q" vid="ISA 25:5">vert dos gezang fun di machtike fardrikt.<verse eid="ISA 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 25:6" />un Hashem Tseva'ot vet machn</para>
  <para style="q" vid="ISA 25:6">far ale felker oif dem dozikn barg,</para>
  <para style="q" vid="ISA 25:6">a moltsait fun fetshpaizn,</para>
  <para style="q" vid="ISA 25:6">a moltsait fun heivnvainen,</para>
  <para style="q" vid="ISA 25:6">fetshpaizn marchike,</para>
  <para style="q" vid="ISA 25:6">heivnvainen gelaiterte.<verse eid="ISA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 25:7" />un er vet fartiliken oif dem dozikn barg</para>
  <para style="q" vid="ISA 25:7">dem tsudek vos dekt tsu ale felker,</para>
  <para style="q" vid="ISA 25:7">un dem shleyer vos iz geshleyert oif ale umes.<verse eid="ISA 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 25:8" />er vet fartiliken dem toit oif eibik;</para>
  <para style="q" vid="ISA 25:8">un Adonoi Hashem vet opvishn</para>
  <para style="q" vid="ISA 25:8">di trer fun itlechn ponem,</para>
  <para style="q" vid="ISA 25:8">un di shand fun zain folk</para>
  <para style="q" vid="ISA 25:8">vet er opton fun der gantser erd;</para>
  <para style="q" vid="ISA 25:8">vorem Hashem hot geredt.<verse eid="ISA 25:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 25:9" />un me vet zogn in yenem tog:</para>
  <para style="q" vid="ISA 25:9">ze, dos iz Elokeinu,</para>
  <para style="q" vid="ISA 25:9">vos mir hobn gehoft tsu im er zol undz helfn,</para>
  <para style="q" vid="ISA 25:9">dos iz Hashem vos mir hobn gehoft tsu im,</para>
  <para style="q" vid="ISA 25:9">lomir lustik zain un zich freyen mit zain hilf.<verse eid="ISA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 25:10" />vorem di hant fun Hashem vet ruen oif dem dozikn barg,</para>
  <para style="q" vid="ISA 25:10">un Moav vet tsetretn vern oif zain ort,</para>
  <para style="q" vid="ISA 25:10">vi shtroi vert tsetretn in misthoifn.<verse eid="ISA 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 25:11" />un er vet oisshpreitn derin zaine hent,</para>
  <para style="q" vid="ISA 25:11">vi a shvimer shpreit ois tsum shvimen;</para>
  <para style="q" vid="ISA 25:11">ober me vet dernidern zain gaive</para>
  <para style="q" vid="ISA 25:11">mit di kuntsn fun zaine hent:<verse eid="ISA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 25:12" />un di hoiche festung fun daine moiern</para>
  <para style="q" vid="ISA 25:12">beigt er, dernidert er,</para>
  <para style="q" vid="ISA 25:12">brengt er tsu der erd bizn shtoib.<verse eid="ISA 25:12" /></para>
  <chapter eid="ISA 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="ISA 26" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 26:1" />in yenem tog vet gezungen vern</para>
  <para style="q" vid="ISA 26:1">dos dozike gezang in land Yehudah:</para>
  <para style="b" vid="ISA 26:1" />
  <para style="q" vid="ISA 26:1">a shtarke shtot hobn mir;</para>
  <para style="q" vid="ISA 26:1">moiern un festungen macht er far hilf.<verse eid="ISA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 26:2" />efent di toiern,</para>
  <para style="q" vid="ISA 26:2">un zol araingein dos gerechte folk,</para>
  <para style="q" vid="ISA 26:2">vos hit op vorheit.<verse eid="ISA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 26:3" />dos gemit vos farlozt zich</para>
  <para style="q" vid="ISA 26:3">bahitstu in sholem;</para>
  <para style="q" vid="ISA 26:3">in sholem, vail es gloibt in dir.<verse eid="ISA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 26:4" />farzichert aich oif Hashem biz eibik,</para>
  <para style="q" vid="ISA 26:4">vorem in G-t Hashem iz an eibiker feldz.<verse eid="ISA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 26:5" />vorem er hot gebeigt di vos zitsn in der heich,</para>
  <para style="q" vid="ISA 26:5">di derhoibene shtot;</para>
  <para style="q" vid="ISA 26:5">er dernidert zi, er dernidert zi biz der erd,</para>
  <para style="q" vid="ISA 26:5">er brengt zi bizn shtoib.<verse eid="ISA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 26:6" />der fus vet zi tsetretn,</para>
  <para style="q" vid="ISA 26:6">di fis fun dem orimen,</para>
  <para style="q" vid="ISA 26:6">di trit fun baderftike.<verse eid="ISA 26:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 26:7" />der veg fun gerechtn iz glaich;</para>
  <para style="q" vid="ISA 26:7">du rechtfartiker, machst glat dem shteg fun gerechtn;<verse eid="ISA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 26:8" />yo, oif dem veg fun daine mishpotim</para>
  <para style="q" vid="ISA 26:8">hobn mir gehoft oif dir, Hashem;</para>
  <para style="q" vid="ISA 26:8">tsu dain nomen un tsu dain gedechenish</para>
  <para style="q" vid="ISA 26:8">iz di glustung fun der zel.<verse eid="ISA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 26:9" />mit main zel hob ich dich geglust bai nacht,</para>
  <para style="q" vid="ISA 26:9">yo, mit main gaist in mir hob ich dich gezucht,</para>
  <para style="q" vid="ISA 26:9">vorem az daine mishpotim zainen oif der erd,</para>
  <para style="q" vid="ISA 26:9">lernen gerechtikeit di bavoiner fun der velt.<verse eid="ISA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 26:10" />vert der roshe gelaitzelikt,</para>
  <para style="q" vid="ISA 26:10">lernt er nisht gerechtikeit;</para>
  <para style="q" vid="ISA 26:10">in land fun erlechkeit tut er umrecht,</para>
  <para style="q" vid="ISA 26:10">un er zet nisht di groiskeit fun Hashem.<verse eid="ISA 26:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 26:11" />Hashem, oifgehoibn iz dain hant,</para>
  <para style="q" vid="ISA 26:11">ober zei zeen nisht;</para>
  <para style="q" vid="ISA 26:11">zoln zei zen un zich shemen</para>
  <para style="q" vid="ISA 26:11">dain onnemen zich faran folk;</para>
  <para style="q" vid="ISA 26:11">yo, a faier zol daine faint fartseren.<verse eid="ISA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 26:12" />Hashem, basher undz sholem,</para>
  <para style="q" vid="ISA 26:12">vorem oich ale undzere oiftuen</para>
  <para style="q" vid="ISA 26:12">host du oisgefirt far undz.<verse eid="ISA 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 26:13" />Hashem Elokeinu,</para>
  <para style="q" vid="ISA 26:13">harn achuts dir hobn gehersht iber undz.</para>
  <para style="q" vid="ISA 26:13">ober nor dich hobn mir dermont – dain nomen.<verse eid="ISA 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 26:14" />di meisim veln nisht lebedik vern,</para>
  <para style="q" vid="ISA 26:14">di toite veln nisht oifshtein;</para>
  <para style="q" vid="ISA 26:14">far vor host geshtroft un zei fartilikt,</para>
  <para style="q" vid="ISA 26:14">un untergebracht yetveder dermonung fun zei.<verse eid="ISA 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 26:15" />du host gemert dos folk, Hashem,</para>
  <para style="q" vid="ISA 26:15">du host gemert dos folk, es iz dain koved;</para>
  <para style="q" vid="ISA 26:15">host dergreicht ale vaite ekn fun der land.<verse eid="ISA 26:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 26:16" />Hashem, in noit hobn zei dich dermont,</para>
  <para style="q" vid="ISA 26:16">zei hobn oisgegosen a shtil gebet,</para>
  <para style="q" vid="ISA 26:16">ven dain shtrof iz geven oif zei.<verse eid="ISA 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 26:17" />vi a trogedike vos geit tsu kind,</para>
  <para style="q" vid="ISA 26:17">dreit zich, shrait in ire veyen,</para>
  <para style="q" vid="ISA 26:17">azoi zainen mir geven far dir, Hashem.<verse eid="ISA 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 26:18" />mir hobn getrogn, mir hobn geveitokt,</para>
  <para style="q" vid="ISA 26:18">un azoi vi mir voltn vint geborn;</para>
  <para style="q" vid="ISA 26:18">kein yeshues hobn mir nisht oisgevirkt in land,</para>
  <para style="q" vid="ISA 26:18">un nisht oifgelebt hobn di bavoiner fun der velt.<verse eid="ISA 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 26:19" />daine toite veln zei zain lebedik,</para>
  <para style="q" vid="ISA 26:19">tsuzamen mit main toitn laib vele zei oifshtein;</para>
  <para style="q" vid="ISA 26:19">vacht oif, un zingt, ir vos rut in dem shtoib!</para>
  <para style="q" vid="ISA 26:19">vorem dain toi iz vi der toi fun frimorgn,</para>
  <para style="q" vid="ISA 26:19">un di erd vet aroisvarfn di toite.<verse eid="ISA 26:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 26:20" />kum, main folk, gei arain in daine kamern,</para>
  <para style="q" vid="ISA 26:20">un farshlis dain tir hinter dir;</para>
  <para style="q" vid="ISA 26:20">bahalt zich oif a klein vaile,</para>
  <para style="q" vid="ISA 26:20">biz der tsorn vet ariber.<verse eid="ISA 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 26:21" />vorem ze, Hashem geit arois fun zain ort,</para>
  <para style="q" vid="ISA 26:21">tsu bashtrofn di bavoiner fun der erd far zeyer zind,</para>
  <para style="q" vid="ISA 26:21">un di erd vet antplekn ir blut,</para>
  <para style="q" vid="ISA 26:21">un vet mer nisht fardekn ire herugim.<verse eid="ISA 26:21" /></para>
  <chapter eid="ISA 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="ISA 27" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 27:1" />in yenem tog vet Hashem bashtrofn</para>
  <para style="q" vid="ISA 27:1">mit zain harter un groiser un shtarker shverd,</para>
  <para style="q" vid="ISA 27:1">dem lioiotn, di loifike shlang,</para>
  <para style="q" vid="ISA 27:1">un dem lioiotn, di gedreite shlang;</para>
  <para style="q" vid="ISA 27:1">un er vet teitn dem krokodil vos in yam.<verse eid="ISA 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 27:2" />in yenem tog zingt tsu ir:</para>
  <para style="q" vid="ISA 27:2">vaingorten fun shoimikn vain!<verse eid="ISA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 27:3" />ich Hashem bin zain hiter,</para>
  <para style="q" vid="ISA 27:3">ale rege bavaser ich im;</para>
  <para style="q" vid="ISA 27:3">tomer vet men im beiz ton,</para>
  <para style="q" vid="ISA 27:3">im hit ich bai nacht un bai tog.<verse eid="ISA 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 27:4" />kein tsorn iz nishto in mir;</para>
  <para style="q" vid="ISA 27:4">ven dos iz mir derner un vildgeveks!</para>
  <para style="q" vid="ISA 27:4">ich volt in milchome getretn deroif;</para>
  <para style="q" vid="ISA 27:4">ich volt es farbrent mit anander.<verse eid="ISA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 27:5" />ven er zol zich nor haltn on main shtarkeit,</para>
  <para style="q" vid="ISA 27:5">machn sholem mit mir,</para>
  <para style="q" vid="ISA 27:5">mit mir sholem machn!<verse eid="ISA 27:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 27:6" />in di kumedike teg vet zich ainvortslen Yaakov,</para>
  <para style="q" vid="ISA 27:6">shprotsn un blien vet Yisroel,</para>
  <para style="q" vid="ISA 27:6">un dos gezicht fun der velt vet ful zain mit frucht.<verse eid="ISA 27:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 27:7" />hot er im geshlogn vi er hot zain shleger geshlogn?</para>
  <para style="q" vid="ISA 27:7">oder iz er vi di teitung fun zaine geteite geteit gevorn?<verse eid="ISA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 27:8" />ven ful di mos, bashtrofstu zi mit avekshikn;</para>
  <para style="q" vid="ISA 27:8">er hot zi fartriben in zain shver gemit</para>
  <para style="q" vid="ISA 27:8">in tog fun mizrech-vint.<verse eid="ISA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 27:9" />derum vet dermit fargebn vern di zind fun Yaakov,</para>
  <para style="q" vid="ISA 27:9">un dos iz al der optsol far opton zain chet:</para>
  <para style="q" vid="ISA 27:9">ven er vet machn ale mizbeyech-shteiner</para>
  <para style="q" vid="ISA 27:9">vi kalchshteiner tsehakte,</para>
  <para style="q" vid="ISA 27:9">az mer zoln nisht oifshtein</para>
  <para style="q" vid="ISA 27:9">kein getsnbeimer un kein zunzailn.<verse eid="ISA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 27:10" />vorem di bafestikte shtot iz alein,</para>
  <para style="q" vid="ISA 27:10">a voinung avekgevorfen un farlozt vi a midber;</para>
  <para style="q" vid="ISA 27:10">dort vet zich fitern a kalb, un dort vet es hoiern,</para>
  <para style="q" vid="ISA 27:10">un farlendn ire tsvaign.<verse eid="ISA 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 27:11" />ven ire ritlech zainen fardart,</para>
  <para style="q" vid="ISA 27:11">veln zei opgebrachn vern;</para>
  <para style="q" vid="ISA 27:11">vaiber kumen un tsindn zi on.</para>
  <para style="q" vid="ISA 27:11">vorem a folk on farshtandikeit iz dos;</para>
  <para style="q" vid="ISA 27:11">derum vet im nisht derbaremen zain boire,</para>
  <para style="q" vid="ISA 27:11">un zain Bashefer vet im nisht laitzelikn.<verse eid="ISA 27:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12" />un es vet zain in yenem tog, vet Hashem opklapn zain frucht fun shtrom fun dem taich, biz dem taich fun Mitsrayim, un ir vet oifgeklibn vern eintsik-eintsikvaiz, kinder fun Yisroel. <verse eid="ISA 27:12" /><verse number="13" style="v" sid="ISA 27:13" />un es vet zain in yenem tog, vet geblozn vern in a groisn shoifer, un es veln kumen di farlorene in land Ashur, un di farshtoisene in land Mitsrayim, un zei veln zich bukn tsu Hashem oifn heilikn barg in Yerushalayim.<verse eid="ISA 27:13" /></para>
  <chapter eid="ISA 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="ISA 28" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 28:1" />vei, di shtoltse kroin</para>
  <para style="q" vid="ISA 28:1">fun di shikurim fun Efrayim,</para>
  <para style="q" vid="ISA 28:1">un di velkedike bliechts</para>
  <para style="q" vid="ISA 28:1">fun zain prachtiker sheinkeit,</para>
  <para style="q" vid="ISA 28:1">vos oifn shtoltsbazalbtn kop</para>
  <para style="q" vid="ISA 28:1">fun di vainfartumlte!<verse eid="ISA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 28:2" />ze, Adonoi hot a shtarkn un a machtikn,</para>
  <para style="q" vid="ISA 28:2">vi a hoglgeviter, a shturem fun tseshterung,</para>
  <para style="q" vid="ISA 28:2">vi a shtrom fun shtarke, fleitsike vasern,</para>
  <para style="q" vid="ISA 28:2">vos leigt tsu der erd mit gevalt.<verse eid="ISA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 28:3" />mit di fis vet tsetretn vern</para>
  <para style="q" vid="ISA 28:3">di shtoltse kroin fun di shikurim fun Efrayim.<verse eid="ISA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 28:4" />un di velkedike bliechts fun zain prachtiker sheinkeit,</para>
  <para style="q" vid="ISA 28:4">vos oifn shtoltsbazalbtn kop,</para>
  <para style="q" vid="ISA 28:4">vet zain vi an ershtfrucht far zumer,</para>
  <para style="q" vid="ISA 28:4">vos az der zeer derzet zi,</para>
  <para style="q" vid="ISA 28:4">shlingt er zi ain ven zi iz noch in zain hant.<verse eid="ISA 28:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 28:5" />in yenem tog vet Hashem Tseva'ot zain</para>
  <para style="q" vid="ISA 28:5">far a kroin fun sheinkeit,</para>
  <para style="q" vid="ISA 28:5">un far a krants fun prachtikeit,</para>
  <para style="q" vid="ISA 28:5">far dem iberblaib fun zain folk,<verse eid="ISA 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 28:6" />un far a gaist fun mishpot</para>
  <para style="q" vid="ISA 28:6">far dem vos zitst ibern mishpot,</para>
  <para style="q" vid="ISA 28:6">un far gevure tsu di</para>
  <para style="q" vid="ISA 28:6">vos shlogn tsurik di milchome baim toier.<verse eid="ISA 28:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 28:7" />un oich di dozike vaklen zich fun vain,</para>
  <para style="q" vid="ISA 28:7">un shoklen zich fun trunk;</para>
  <para style="q" vid="ISA 28:7">der koyen un der novi vaklen zich fun trunk,</para>
  <para style="q" vid="ISA 28:7">zei zainen tsemisht fun vain,</para>
  <para style="q" vid="ISA 28:7">zei shoklen zich fun trunk,</para>
  <para style="q" vid="ISA 28:7">zei vaklen zich in der zeung,</para>
  <para style="q" vid="ISA 28:7">zei vern geshtroichlt baim mishpot.<verse eid="ISA 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 28:8" />vorem ale tishn zainen ful mit shmutsiker meikechts,</para>
  <para style="q" vid="ISA 28:8">biz nishto an ort a reiner.<verse eid="ISA 28:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 28:9" />vemen zol men lernen visen?</para>
  <para style="q" vid="ISA 28:9">un vemen gebn tsu farshtein di herung?</para>
  <para style="q" vid="ISA 28:9">fun milch antvointe?</para>
  <para style="q" vid="ISA 28:9">fun brust avekgenumene?<verse eid="ISA 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 28:10" />vorem es iz a gebot tsu a gebot, a gebot tsu a gebot,</para>
  <para style="q" vid="ISA 28:10">a shtrich tsu a shtrich, a shtrich tsu a shtrich,</para>
  <para style="q" vid="ISA 28:10">a bisel do, a bisel dort.<verse eid="ISA 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 28:11" />vorem mit a shtamldiker lip, un mit a fremdn loshen,</para>
  <para style="q" vid="ISA 28:11">muz men redn tsu dem dozikn folk,<verse eid="ISA 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 28:12" />vos me hot tsu zei gezogt: dos iz di ruung,</para>
  <para style="q" vid="ISA 28:12">macht ruen dem midn;</para>
  <para style="q" vid="ISA 28:12">un dos iz di menuche;</para>
  <para style="q" vid="ISA 28:12">ober zei hobn nisht gevolt hern.<verse eid="ISA 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 28:13" />un dos vort fun Hashem iz bai zei</para>
  <para style="q" vid="ISA 28:13">a gebot tsu a gebot, a gebot tsu a gebot,</para>
  <para style="q" vid="ISA 28:13">a shtrich tsu a shtrich, a shtrich tsu a shtrich,</para>
  <para style="q" vid="ISA 28:13">a bisel do, a bisel dort;</para>
  <para style="q" vid="ISA 28:13">kedei zei zoln gein un geshtroichlt vern ahinter,</para>
  <para style="q" vid="ISA 28:13">un tsebrochn un gefangen un batsvungen vern.<verse eid="ISA 28:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 28:14" />derum hert dos vort fun Hashem, ir lait fun geshpet,</para>
  <para style="q" vid="ISA 28:14">ir vertlzoger fun dozikn folk vos in Yerushalayim:<verse eid="ISA 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 28:15" />vail ir hot gezogt:</para>
  <para style="q" vid="ISA 28:15">mir hobn geshlosn a bris mitn toit,</para>
  <para style="q" vid="ISA 28:15">un mit Sheol hobn mir an opmach gemacht;</para>
  <para style="q" vid="ISA 28:15">az di fleitsike rut vet durchgein,</para>
  <para style="q" vid="ISA 28:15">vet zi tsu undz nisht kumen,</para>
  <para style="q" vid="ISA 28:15">vorem mir hobn lign gemacht undzer bashitsung,</para>
  <para style="q" vid="ISA 28:15">un in falshkeit hobn mir zich farborgen;<verse eid="ISA 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 28:16" />derum hot Adonoi Hashem azoi gezogt:</para>
  <para style="q" vid="ISA 28:16">ze, ich gruntfest in Tsiyon a shtein,</para>
  <para style="q" vid="ISA 28:16">a gepruvtn shtein, a taiern vinkel, a festn gruntfest;</para>
  <para style="q" vid="ISA 28:16">der vos gloibt, zol nisht ailn.<verse eid="ISA 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 28:17" />un ich vel machn gerechtikeit far a mestshnur,</para>
  <para style="q" vid="ISA 28:17">un rechtfartikeit far a boigevicht;</para>
  <para style="q" vid="ISA 28:17">un a hogel vet avekkeren di bashitsung fun lign,</para>
  <para style="q" vid="ISA 28:17">un di farborgenish veln vasern avekfleitsn.<verse eid="ISA 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 28:18" />un opgemekt vet vern aier bris mitn toit,</para>
  <para style="q" vid="ISA 28:18">un aier opmach mit der Sheol vet nisht bashtein.</para>
  <para style="q" vid="ISA 28:18">az di fleitsike rut vet durchgein,</para>
  <para style="q" vid="ISA 28:18">vet ir fun ir tsetretn vern.<verse eid="ISA 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 28:19" />vi oft zi geit durch vet zi aich nemen;</para>
  <para style="q" vid="ISA 28:19">vorem frimorgn in frimorgn vet zi durchgein,</para>
  <para style="q" vid="ISA 28:19">bai tog un bai nacht;</para>
  <para style="q" vid="ISA 28:19">un a hoile shrek vet zain tsu banemen di herung.<verse eid="ISA 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 28:20" />vorem dos bet iz tsu kurts zich oistsutsien,</para>
  <para style="q" vid="ISA 28:20">un der tsudek tsu shmol az me dreit zich tsunoif.<verse eid="ISA 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 28:21" />vorem azoi vi oif barg Peratsim vet Hashem oifshtein,</para>
  <para style="q" vid="ISA 28:21">azoi vi in tal fun Givon vet er tserenen,</para>
  <para style="q" vid="ISA 28:21">tsu ton zain tuung – fremd iz zain tuung,</para>
  <para style="q" vid="ISA 28:21">un tsu verkn zain verk – oisterlish iz zain verk.<verse eid="ISA 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 28:22" />un atsund zolt ir nisht shpetn,</para>
  <para style="q" vid="ISA 28:22">kedei aiere bindshtrik zoln nisht fester vern;</para>
  <para style="q" vid="ISA 28:22">vorem a farlendung un a gzar</para>
  <para style="q" vid="ISA 28:22">hob ich gehert fun Adonoi, Hashem Tseva'ot,</para>
  <para style="q" vid="ISA 28:22">oifn gantsn land.<verse eid="ISA 28:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 28:23" />leigt tsu dos oier, un hert main kol,</para>
  <para style="q" vid="ISA 28:23">farnemt un hert main vort;<verse eid="ISA 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 28:24" />akert den nochanand der akerer oif tsu zeyen,</para>
  <para style="q" vid="ISA 28:24">un efent un tsehakt zain erd?<verse eid="ISA 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 28:25" />far vor, az er hot oisgeglichn ir eiberflech,</para>
  <para style="q" vid="ISA 28:25">tseshpreit er shvartskiml, un kimel vorft er ois,</para>
  <para style="q" vid="ISA 28:25">un tut arain veits in shurus,</para>
  <para style="q" vid="ISA 28:25">un gersht oifn ongetseichntn ort,</para>
  <para style="q" vid="ISA 28:25">un tunklveits baim rand derfun.<verse eid="ISA 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 28:26" />vorem im hot richtik gelernt,</para>
  <para style="q" vid="ISA 28:26">im tut vaizn zain G-t.<verse eid="ISA 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 28:27" />yo, nisht mit a dreshshlitn vert shvartskiml gedroshn,</para>
  <para style="q" vid="ISA 28:27">un a rod fun a vogn vert nisht oif kimel gedreit;</para>
  <para style="q" vid="ISA 28:27">naiert mit a shtekn vert shvartskiml geklapt,</para>
  <para style="q" vid="ISA 28:27">un kimel mit a rut.<verse eid="ISA 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 28:28" />vert broitkorn tsedrikt?</para>
  <para style="q" vid="ISA 28:28">far vor, nisht eibik dreshn dresht er es;</para>
  <para style="q" vid="ISA 28:28">hagam es raisht der valts fun zain vogn mit zaine tsakn –</para>
  <para style="q" vid="ISA 28:28">tsedrikn vet er es nisht.<verse eid="ISA 28:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 28:29" />dos oich iz arois fun Hashem Tseva'ot;</para>
  <para style="q" vid="ISA 28:29">vunderlech iz er in barot, grois iz er in chochme.<verse eid="ISA 28:29" /></para>
  <chapter eid="ISA 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="ISA 29" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 29:1" />vei, Ariel, Ariel, shtot vu Dovid hot gerut!</para>
  <para style="q" vid="ISA 29:1">mert a yor oif a yor,</para>
  <para style="q" vid="ISA 29:1">zoln di yom-tuvim zich arumdreyen,<verse eid="ISA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 29:2" />un ich vel drikn Ariel,</para>
  <para style="q" vid="ISA 29:2">un es vet zain a klog un a klogenish,</para>
  <para style="q" vid="ISA 29:2">un er vet mir zain azoi vi an Ariel.<verse eid="ISA 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 29:3" />un ich vel lagern arum dir vi a rod,</para>
  <para style="q" vid="ISA 29:3">un vel dich balegern mit an erdval,</para>
  <para style="q" vid="ISA 29:3">un oifshteln oif dir balegerverk.<verse eid="ISA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 29:4" />un niderik fun der erd vestu redn,</para>
  <para style="q" vid="ISA 29:4">un tif fun shtoib vet kumen dain vort;</para>
  <para style="q" vid="ISA 29:4">un vi a gaist fun der erd vet zain dain kol,</para>
  <para style="q" vid="ISA 29:4">un fun shtoib vet pipsn dain vort.<verse eid="ISA 29:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 29:5" />ober di dine shtoib vet vern der hamon fun daine faint,</para>
  <para style="q" vid="ISA 29:5">un vi shprei vos fargeit der hamon fun di machtike;</para>
  <para style="q" vid="ISA 29:5">un plutsim-plutsling vet es geshen.<verse eid="ISA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 29:6" />fun Hashem Tseva'ot vet kumen di shtrof,</para>
  <para style="q" vid="ISA 29:6">mit duner un mit erdtsiternish un grois gepilder,</para>
  <para style="q" vid="ISA 29:6">shturem un geviter un flamfaier vos fartsert.<verse eid="ISA 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 29:7" />un azoi vi a cholem, a zeung fun der nacht,</para>
  <para style="q" vid="ISA 29:7">vet zain der hamon fun ale felker</para>
  <para style="q" vid="ISA 29:7">vos haltn milchome oif Ariel –</para>
  <para style="q" vid="ISA 29:7">i ale vos haltn milchome oif ir,</para>
  <para style="q" vid="ISA 29:7">i di balegerfestung arum ir,</para>
  <para style="q" vid="ISA 29:7">i di vos drikn zi.<verse eid="ISA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 29:8" />un es vet zain:</para>
  <para style="q" vid="ISA 29:8">azoi vi a hungerikn chelumt zich, ersht er est,</para>
  <para style="q" vid="ISA 29:8">un er chapt zich oif, un zain laib iz leidik,</para>
  <para style="q" vid="ISA 29:8">un azoi vi a dorshtikn chelumt zich, ersht er trinkt,</para>
  <para style="q" vid="ISA 29:8">un er chapt zich oif, ersht er iz shlof,</para>
  <para style="q" vid="ISA 29:8">un zain zel iz farshmacht,</para>
  <para style="q" vid="ISA 29:8">azoi vet zain der hamon fun ale felker,</para>
  <para style="q" vid="ISA 29:8">vos haltn milchome oif barg Tsiyon.<verse eid="ISA 29:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 29:9" />fardult aich un zait tsedult!</para>
  <para style="q" vid="ISA 29:9">farblendt aich un zait blind!</para>
  <para style="q" vid="ISA 29:9">ir vos zait shiker un nisht fun vain,</para>
  <para style="q" vid="ISA 29:9">vos shoklt zich un nisht fun trunk.<verse eid="ISA 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 29:10" />vorem Hashem hot oisgegosen oif aich</para>
  <para style="q" vid="ISA 29:10">a gaist fun hinerplet,</para>
  <para style="q" vid="ISA 29:10">un hot tsugemacht aiere oign, di neviim,</para>
  <para style="q" vid="ISA 29:10">un aiere kep, di zeers, hot er fardekt.<verse eid="ISA 29:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11" />un di zeung fun alts ding iz far aich azoi vi verter fun a farchtmetn geshrifts, vos az me git es tsu dem vos ken geshrifts, azoi tsu zogn: leyen dos, ich bet dich, zogt er: ich ken nisht, vorem es iz farchasmet. <verse eid="ISA 29:11" /><verse number="12" style="v" sid="ISA 29:12" />un az dos geshrifts vert gegebn tsu dem vos ken nisht kein geshrifts, azoi tsu zogn: leyen dos, ich bet dich, zogt er: ich ken nisht kein geshrifts.<verse eid="ISA 29:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 29:13" />un Adonoi hot gezogt:</para>
  <para style="q" vid="ISA 29:13">vail dos dozike folk hot genent mit zain moil,</para>
  <para style="q" vid="ISA 29:13">un mit zaine lipn mich geerlecht,</para>
  <para style="q" vid="ISA 29:13">ober zain harts hot er dervaitert fun mir,</para>
  <para style="q" vid="ISA 29:13">un zeyer moire far mir</para>
  <para style="q" vid="ISA 29:13">iz vi an aingelernt gebot fun mentshn,<verse eid="ISA 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 29:14" />derum ze, ich tu noch mer farvundern dos dozike folk,</para>
  <para style="q" vid="ISA 29:14">vunderlech farvundern;</para>
  <para style="q" vid="ISA 29:14">un farlorn vern vet di chochme fun zaine chachomim,</para>
  <para style="q" vid="ISA 29:14">un di farshtandikeit fun zaine farshtandike vet farhoiln vern.<verse eid="ISA 29:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 29:15" />vei, di vos farhoiln tif zeyer barot fun Hashem,</para>
  <para style="q" vid="ISA 29:15">un in der fintster zainen zeyere meisim,</para>
  <para style="q" vid="ISA 29:15">un zei zogn: ver zet undz?</para>
  <para style="q" vid="ISA 29:15">un ver veis undz?<verse eid="ISA 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 29:16" />di farkertkeit aiere!</para>
  <para style="q" vid="ISA 29:16">tsi iz der teper vi leim gerechnt,</para>
  <para style="q" vid="ISA 29:16">az dos verk zol zogn oif zain mainster:</para>
  <para style="q" vid="ISA 29:16">er hot mich nisht gemacht?</para>
  <para style="q" vid="ISA 29:16">un der bashaf zol zogn oif zain Bashefer:</para>
  <para style="q" vid="ISA 29:16">er farshteit nisht?<verse eid="ISA 29:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 29:17" />far vor, in noch a klein vaile,</para>
  <para style="q" vid="ISA 29:17">vet der Levanon farkert vern in a fruchtgortn,</para>
  <para style="q" vid="ISA 29:17">un der fruchtgortn vet far a vald gerechnt vern.<verse eid="ISA 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 29:18" />un di toibe in yenem tog</para>
  <para style="q" vid="ISA 29:18">veln hern di verter fun a buch,</para>
  <para style="q" vid="ISA 29:18">un fun choishech un fintsternish</para>
  <para style="q" vid="ISA 29:18">veln zen di oign fun blinde.<verse eid="ISA 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 29:19" />un di farlitene veln mern zeyer simche in Hashem,</para>
  <para style="q" vid="ISA 29:19">un di baderftike tsvishn mentshn</para>
  <para style="q" vid="ISA 29:19">veln mitn heilikn fun Yisroel zich freyen.<verse eid="ISA 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 29:20" />vorem avek der machtiker,</para>
  <para style="q" vid="ISA 29:20">un farlendt vet zain der shpeter,</para>
  <para style="q" vid="ISA 29:20">un farshnitn ale vos loiern oif umrecht;<verse eid="ISA 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 29:21" />di vos machn shuldik a mentshn mit a vort,</para>
  <para style="q" vid="ISA 29:21">un dem shtrofzoger leign zei a shtroichlung in toier,</para>
  <para style="q" vid="ISA 29:21">un fardreyen mit nisht dem gerechtn.<verse eid="ISA 29:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22" />derum hot Hashem, vos hot oisgeleizt Avrahamen, azoi gezogt oifn hoiz fun Yaakov:</para>
  <para style="b" vid="ISA 29:22" />
  <para style="q" vid="ISA 29:22">atsund vet nisht farshemt vern Yaakov,</para>
  <para style="q" vid="ISA 29:22">un atsund vet zain ponem nisht blas vern;<verse eid="ISA 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 29:23" />yo, az er vet zen zaine kinder,</para>
  <para style="q" vid="ISA 29:23">dos verk fun maine hent, in zain mit,</para>
  <para style="q" vid="ISA 29:23">vi zei heilikn main nomen;</para>
  <para style="q" vid="ISA 29:23">vorem zei veln heilikn dem heilikn fun Yaakov,</para>
  <para style="q" vid="ISA 29:23">un Elokei Yisroel veln zei forchtn.<verse eid="ISA 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 29:24" />un di farfirte in gaist veln visen tsu farshtein,</para>
  <para style="q" vid="ISA 29:24">un di murmler veln lernen a musar.<verse eid="ISA 29:24" /></para>
  <chapter eid="ISA 29" />
  <chapter number="30" style="c" pubnumber="ל" sid="ISA 30" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 30:1" />vei, kinder opkerer, zogt Hashem,</para>
  <para style="q" vid="ISA 30:1">tsu machn etsut vos nisht fun mir,</para>
  <para style="q" vid="ISA 30:1">un tsu vebn gevebn vos nisht main gaist,</para>
  <para style="q" vid="ISA 30:1">kedei tsu mern zind oif zind!<verse eid="ISA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 30:2" />di vos geyen nidern kein Mitsrayim,</para>
  <para style="q" vid="ISA 30:2">un main moil hobn zei nisht gefregt;</para>
  <para style="q" vid="ISA 30:2">zich tsu shitsn in der bashitsung fun Pharaohn,</para>
  <para style="q" vid="ISA 30:2">un zich tsu bashiremen in shotn fun Mitsrayim.<verse eid="ISA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 30:3" />ober di bashitsung fun Pharaohn vet aich vern tsu bushe,</para>
  <para style="q" vid="ISA 30:3">un di bashiremung in shotn fun Mitsrayim tsu shand.<verse eid="ISA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 30:4" />vorem in Tsoan zainen geven zaine harn,</para>
  <para style="q" vid="ISA 30:4">un zaine shluchim tuen kein Chanes dergreichn.<verse eid="ISA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 30:5" />ale veln zei zich shemen</para>
  <para style="q" vid="ISA 30:5">iber dem folk vos ken zei nisht nutsn,</para>
  <para style="q" vid="ISA 30:5">vos zainen nisht tsu hilf un nisht tsu nuts,</para>
  <para style="q" vid="ISA 30:5">nor tsu bushe un tsu charpe.<verse eid="ISA 30:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6" />di nevue oifn beheimes fun dorem:</para>
  <para style="b" vid="ISA 30:6" />
  <para style="q" vid="ISA 30:6">durch a land fun noit un angst,</para>
  <para style="q" vid="ISA 30:6">vos di leibinte un der leib iz fun dortn,</para>
  <para style="q" vid="ISA 30:6">der pipernoter un der fliediker lindvorem,</para>
  <para style="q" vid="ISA 30:6">firn zei oifn rukn fun yungeizlen zeyere farmegens,</para>
  <para style="q" vid="ISA 30:6">un oifn hoiker fun kemlen zeyere oitseres,</para>
  <para style="q" vid="ISA 30:6">tsu a folk vos ken nisht nutsn.<verse eid="ISA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 30:7" />un Mitsrayim iz hevl un leidikeit;</para>
  <para style="q" vid="ISA 30:7">derfar hob ich dos gerufn: rahab — zei zainen in ru.<verse eid="ISA 30:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 30:8" />atsund kum farshraib es oif a tovl bai zei,</para>
  <para style="q" vid="ISA 30:8">un in a buch fartseichn es,</para>
  <para style="q" vid="ISA 30:8">un es zol zain bizn letstn tog,</para>
  <para style="q" vid="ISA 30:8">oif eibik un shtendik.<verse eid="ISA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 30:9" />vorem a vidershpenik folk iz dos,</para>
  <para style="q" vid="ISA 30:9">kinder leikener,</para>
  <para style="q" vid="ISA 30:9">kinder vos viln nisht hern</para>
  <para style="q" vid="ISA 30:9">di lernung fun Hashem;<verse eid="ISA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 30:10" />vos zogn tsu di neviim: ir zolt nisht nevies zogn;</para>
  <para style="q" vid="ISA 30:10">un tsu di zeers:</para>
  <para style="q" vid="ISA 30:10">ir zolt undz nisht zen di richtikeit;</para>
  <para style="q" vid="ISA 30:10">redt undz glate reid,</para>
  <para style="q" vid="ISA 30:10">zet genarenishn.<verse eid="ISA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 30:11" />kert aich op fun veg,</para>
  <para style="q" vid="ISA 30:11">naigt aich op fun shteg,</para>
  <para style="q" vid="ISA 30:11">tut op fun undzer ponem dem heilikn fun Yisroel!<verse eid="ISA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 30:12" />derum hot der heiliker fun Yisroel azoi gezogt:</para>
  <para style="q" vid="ISA 30:12">vail ir faracht dos dozike vort,</para>
  <para style="q" vid="ISA 30:12">un ir hot aich farzichert oif roib un batrug,</para>
  <para style="q" vid="ISA 30:12">un aich ongelent deroif,<verse eid="ISA 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 30:13" />derum vet aich zain di dozike zind</para>
  <para style="q" vid="ISA 30:13">azoi vi an onkreitiker broch</para>
  <para style="q" vid="ISA 30:13">antplekt in a hoicher moier,</para>
  <para style="q" vid="ISA 30:13">vos plutsim-plutsling vet kumen ir tsebrechenish.<verse eid="ISA 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 30:14" />un er vet zi tsebrechn vi me tsebrecht</para>
  <para style="q" vid="ISA 30:14">a tepergefes tsehakn un nisht shoinen;</para>
  <para style="q" vid="ISA 30:14">un in ire shtiker vet zich nisht gefinen a sharbn</para>
  <para style="q" vid="ISA 30:14">oif aroissharn faier fun oivn,</para>
  <para style="q" vid="ISA 30:14">oder onshepn vaser fun grub.<verse eid="ISA 30:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 30:15" />vorem azoi hot gezogt</para>
  <para style="q" vid="ISA 30:15">Adonoi Hashem, der heiliker fun Yisroel:</para>
  <para style="q" vid="ISA 30:15">durch tshuvh un menuche vet ir geholfn vern,</para>
  <para style="q" vid="ISA 30:15">in ru un zicherkeit vet zain aier gevure;</para>
  <para style="q" vid="ISA 30:15">ober ir hot nisht gevolt.<verse eid="ISA 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 30:16" />un ir hot gezogt:</para>
  <para style="q" vid="ISA 30:16">nein, naiert oif ferd veln mir loifn;</para>
  <para style="q" vid="ISA 30:16">derum vet ir loifn;</para>
  <para style="q" vid="ISA 30:16">un: oif flinke veln mir raitn;</para>
  <para style="q" vid="ISA 30:16">derum veln flink zain aiere nochyogers.<verse eid="ISA 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 30:17" />a toiznt far dem ongeshrei fun einem,</para>
  <para style="q" vid="ISA 30:17">far dem ongeshrei fun finf vet ir ale antloifn;</para>
  <para style="q" vid="ISA 30:17">biz vanen ir vet blaibn vi a shtang oif a shpits barg,</para>
  <para style="q" vid="ISA 30:17">un vi a fon oif a hoichn ort.<verse eid="ISA 30:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 30:18" />ober fun dest vegen tut Hashem harn</para>
  <para style="q" vid="ISA 30:18">aich tsu laitzelikn,</para>
  <para style="q" vid="ISA 30:18">un fun dest vegen tut er gorn</para>
  <para style="q" vid="ISA 30:18">aich tsu derbaremen;</para>
  <para style="q" vid="ISA 30:18">vorem a G-t fun gerechtikeit iz Hashem,</para>
  <para style="q" vid="ISA 30:18">voil tsu di vos harn oif im.<verse eid="ISA 30:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19" />vorem du folk vos zitsst in Tsiyon, in Yerushalayim, veinen vestu mer nisht veinen; laitzelikn vet er dich laitzelikn oif dem kol fun dain geshrei, vi er vet hern, tut er dir entfern. <verse eid="ISA 30:19" /><verse number="20" style="v" sid="ISA 30:20" />un Adonoi vet aich gebn karg broit un knap vaser, ober dain lerer vet mer nisht zain farhoiln, un daine oign veln zen dain lerer. <verse eid="ISA 30:20" /><verse number="21" style="v" sid="ISA 30:21" />un daine oiern veln hern a vort hinter dir, azoi tsu zogn: dos iz der veg, geit oif im, sai ir vet zich kern rechts, un sai ir vet zich kern links. <verse eid="ISA 30:21" /><verse number="22" style="v" sid="ISA 30:22" />un ir vet farumreinikn dem ibertsug fun daine zilbergetsn, un dem bakleid fun dain gegosenem goldgets. avekvarfn vestu zei azoi vi umreins; arois! vestu zogn dertsu. <verse eid="ISA 30:22" /><verse number="23" style="v" sid="ISA 30:23" />un er vet gebn regn far dain zerie vos du vest zeyen in der erd, un dos broit fun der tvue fun der erd vet zain fet un zaftik. dain fich vet zich fitern in yenem tog oif a lonke a breiter. <verse eid="ISA 30:23" /><verse number="24" style="v" sid="ISA 30:24" />un di rinder un di yungeizlen vos baarbetn di erd, veln esen geshmake futer, vos me vintshuflt mit a vintgafl un mit a vintshufl. <verse eid="ISA 30:24" /><verse number="25" style="v" sid="ISA 30:25" />un oif yetveder hoichn barg, un oif yetveder derhoibenem bergel, veln zain bechn, shtromen vaser, in dem tog fun grois teitung, ven turems tuen faln. <verse eid="ISA 30:25" /><verse number="26" style="v" sid="ISA 30:26" />un dos licht fun der levone vet zain vi dos licht fun der zun, un dos licht fun der zun vet zain zibnfach – vi dos licht fun zibn teg, in dem tog vos Hashem farbindt dem broch fun zain folk, un dem ris fun zain vund tut er heiln.<verse eid="ISA 30:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 30:27" />ze, der nomen fun Hashem kumt on fun der vait,</para>
  <para style="q" vid="ISA 30:27">zain tsorn brent, un a shverer roich heibt zich oif;</para>
  <para style="q" vid="ISA 30:27">zaine lipn zainen ful mit tsorn,</para>
  <para style="q" vid="ISA 30:27">un zain tsung vi a faier vos fartsert;<verse eid="ISA 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 30:28" />un zain otem vi a fleitsiker shtrom,</para>
  <para style="q" vid="ISA 30:28">vos greicht biz tsum haldz;</para>
  <para style="q" vid="ISA 30:28">tsu Zipen di felker in a zip fun farvistung,</para>
  <para style="q" vid="ISA 30:28">mit a farfiriker tsam oif di bakn fun di umes.<verse eid="ISA 30:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="ISA 30:29" />a gezang vet bai aich zain, vi in der nacht vos a yom-tov vert geheilikt, un a hartsike simche, vi bai dem vos geit mit a fleit , tsu kumen oifn barg fun Hashem, tsum feldz fun Yisroel. <verse eid="ISA 30:29" /><verse number="30" style="v" sid="ISA 30:30" />un Hashem vet lozn hern dem hilch fun zain kol, un vet vaizn dem aroploz fun zain orem, mit grimtsorn un flamfaier vos fartsert, mit volknbroch un fleitsung un hoglshtein. <verse eid="ISA 30:30" /><verse number="31" style="v" sid="ISA 30:31" />vorem fun dem kol fun Hashem vet tsebrochn vern Ashur, di rut mit vos er flegt shlogn. <verse eid="ISA 30:31" /><verse number="32" style="v" sid="ISA 30:32" />un vu nor es geit durch der shtekn fun basherung, vos Hashem vet aroplozen oif im, vet es zain mit poikn un mit harfn; un mit oifgehoibene milchomes vet er milchome haltn oif zei. <verse eid="ISA 30:32" /><verse number="33" style="v" sid="ISA 30:33" />vorem ongegreit fun nechtn iz der faierort, yo, faran melech iz er tsugegreit, tif iz er, breit iz er; zain hoifn hot faier un holts a sach, Hashems otem tut brenen vi a taich shvebl derin.<verse eid="ISA 30:33" /></para>
  <chapter eid="ISA 30" />
  <chapter number="31" style="c" pubnumber="לא" sid="ISA 31" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 31:1" />vei, di vos nidern kein Mitsrayim noch hilf,</para>
  <para style="q" vid="ISA 31:1">un oif ferd farlozen zei zich;</para>
  <para style="q" vid="ISA 31:1">un zei farzichern zich oif raitvegn, vail zei zainen fil,</para>
  <para style="q" vid="ISA 31:1">un oif raiter, vail zei zainen machtik zeyer;</para>
  <para style="q" vid="ISA 31:1">un zei kern zich nisht tsu dem heilikn fun Yisroel,</para>
  <para style="q" vid="ISA 31:1">un Hashem tuen zei nisht zuchn!<verse eid="ISA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 31:2" />ober far vor, er iz klug, un er brengt dos beiz,</para>
  <para style="q" vid="ISA 31:2">un zaine verter tut er nisht op.</para>
  <para style="q" vid="ISA 31:2">un er vet oifshtein kegen hoiz fun di shlechtstuer,</para>
  <para style="q" vid="ISA 31:2">un kegen der hilf fun di vos verkn umrecht.<verse eid="ISA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 31:3" />un di Mitsrayim zainen mentshn, un nisht El,</para>
  <para style="q" vid="ISA 31:3">un zeyere ferd zainen fleish, un nisht gaist;</para>
  <para style="q" vid="ISA 31:3">un Hashem vet oisshtrekn zain hant,</para>
  <para style="q" vid="ISA 31:3">un shtroichlen vet der helfer,</para>
  <para style="q" vid="ISA 31:3">un faln vet der geholfener,</para>
  <para style="q" vid="ISA 31:3">un ale in einem veln zei farlendt vern.<verse eid="ISA 31:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 31:4" />vorem azoi hot gezogt Hashem tsu mir:</para>
  <para style="q" vid="ISA 31:4">azoi vi der leib un der yungleib brumt iber zain roib,</para>
  <para style="q" vid="ISA 31:4">hagam a fule pastucher zainen aingezamlt arum im;</para>
  <para style="q" vid="ISA 31:4">far zeyer kol dershrekt er zich nisht,</para>
  <para style="q" vid="ISA 31:4">un far zeyer liarem beigt er zich nisht;</para>
  <para style="q" vid="ISA 31:4">azoi vet Hashem Tseva'ot nidern,</para>
  <para style="q" vid="ISA 31:4">tsu haltn milchome oifn barg fun Tsiyon</para>
  <para style="q" vid="ISA 31:4">un oif ir hoichn ort.<verse eid="ISA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 31:5" />vi foiglen flaterndik,</para>
  <para style="q" vid="ISA 31:5">azoi vet Hashem Tseva'ot bashiremen Yerushalayim,</para>
  <para style="q" vid="ISA 31:5">bashiremen un matsl zain,</para>
  <para style="q" vid="ISA 31:5">parshoinen un rateven.<verse eid="ISA 31:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6" />kert aich um tsu vemen ir hot tif vidershpenikt, kinder fun Yisroel. <verse eid="ISA 31:6" /><verse number="7" style="v" sid="ISA 31:7" />far vor, in yenem tog veln zei farachten itlecher zaine opgeter fun zilber, un zaine opgeter fun gold, vos aiere hent hobn aich gemacht tsu zind.<verse eid="ISA 31:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 31:8" />un Ashur vet faln durch der shverd fun nisht a man,</para>
  <para style="q" vid="ISA 31:8">un di shverd fun nisht a mentshn vet im fartseren;</para>
  <para style="q" vid="ISA 31:8">un er vet antloifn faran shverd,</para>
  <para style="q" vid="ISA 31:8">un zaine yunge lait veln tsu tsindz vern.<verse eid="ISA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 31:9" />un zain feldz vet fun moire fargein,</para>
  <para style="q" vid="ISA 31:9">un angstn far der fon veln zaine harn,</para>
  <para style="q" vid="ISA 31:9">zogt Hashem, vos zain faier iz in Tsiyon,</para>
  <para style="q" vid="ISA 31:9">un zain oivn in Yerushalayim.<verse eid="ISA 31:9" /></para>
  <chapter eid="ISA 31" />
  <chapter number="32" style="c" pubnumber="לב" sid="ISA 32" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 32:1" />ze, mit rechtfartikeit vet kinign der kinig,</para>
  <para style="q" vid="ISA 32:1">un harn – zei veln hershn mit gerechtikeit.<verse eid="ISA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 32:2" />un itlecher vet zain</para>
  <para style="q" vid="ISA 32:2">vi a baheltenish fun vint,</para>
  <para style="q" vid="ISA 32:2">un a farborgenish fun gusregn;</para>
  <para style="q" vid="ISA 32:2">vi a bechn vaser in a trikenish,</para>
  <para style="q" vid="ISA 32:2">vi der shotn fun a shvern feldz</para>
  <para style="q" vid="ISA 32:2">in a farshmachtn land.<verse eid="ISA 32:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 32:3" />un nisht farklept zain veln di oign fun di zeer,</para>
  <para style="q" vid="ISA 32:3">un di oiern fun di herer veln farnemen.<verse eid="ISA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 32:4" />un dos harts fun di iberailte vet farshtein tsu visen,</para>
  <para style="q" vid="ISA 32:4">un di tsung fun di shtamler vet redn geloifik klor.<verse eid="ISA 32:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 32:5" />un dem gemeinem vet men nisht rufn mer adlman,</para>
  <para style="q" vid="ISA 32:5">un oifn geitsikn vet men nisht zogn mer nadivn.<verse eid="ISA 32:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 32:6" />vorem der gemeiner redt gemein,</para>
  <para style="q" vid="ISA 32:6">un zain harts arbet umrecht, tsu ton falshkeit,</para>
  <para style="q" vid="ISA 32:6">un tsu redn vegen Hashem mit genar;</para>
  <para style="q" vid="ISA 32:6">tsu lozn leidik dem laib fun dem hungerikn,</para>
  <para style="q" vid="ISA 32:6">un dem trank fun dem dorshtikn tsu minern.<verse eid="ISA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 32:7" />un der geitsiker, zaine getsaig zainen shlecht,</para>
  <para style="q" vid="ISA 32:7">beize machshoves barot er,</para>
  <para style="q" vid="ISA 32:7">umtsubrengen dem oreman mit reid fun lign,</para>
  <para style="q" vid="ISA 32:7">afile ven der evyon tainet gerecht.<verse eid="ISA 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 32:8" />ober der adlman barot adlkeit,</para>
  <para style="q" vid="ISA 32:8">un oif adlkeit vet er bashtein.<verse eid="ISA 32:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 32:9" />ir ruike vaiber, shteit oif,</para>
  <para style="q" vid="ISA 32:9">hert main kol, ir zichere techter,</para>
  <para style="q" vid="ISA 32:9">farnemt main zog.<verse eid="ISA 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 32:10" />teg un yorn vet ir tsiteren,</para>
  <para style="q" vid="ISA 32:10">ir zichere,</para>
  <para style="q" vid="ISA 32:10">vorem di lez iz farlendt,</para>
  <para style="q" vid="ISA 32:10">kein ainzamlung vet nisht kumen.<verse eid="ISA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 32:11" />shoidert, ir ruike,</para>
  <para style="q" vid="ISA 32:11">tsitert, ir zichere;</para>
  <para style="q" vid="ISA 32:11">tut aich ois un antbloizt aich,</para>
  <para style="q" vid="ISA 32:11">un gurt zak oif di lendn,<verse eid="ISA 32:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 32:12" />oif di brist zich shlogndik,</para>
  <para style="q" vid="ISA 32:12">iber di glustike felder,</para>
  <para style="q" vid="ISA 32:12">ibern fruchtikn vainshtok;<verse eid="ISA 32:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 32:13" />iber der erd fun main folk,</para>
  <para style="q" vid="ISA 32:13">farvaksn mit derner un vildgeveks;</para>
  <para style="q" vid="ISA 32:13">yo, iber ale haizer fun lustikeit,</para>
  <para style="q" vid="ISA 32:13">ibern freilechn kerch.<verse eid="ISA 32:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 32:14" />vorem der palats iz farlozt,</para>
  <para style="q" vid="ISA 32:14">der tuml fun shtot hot oifgehert;</para>
  <para style="q" vid="ISA 32:14">der erdval un der turem zainen far heiln oif eibik,</para>
  <para style="q" vid="ISA 32:14">a freid far valdeizlen,</para>
  <para style="q" vid="ISA 32:14">a fiterung far stades.<verse eid="ISA 32:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 32:15" />biz oisgegosen vet vern oif undz</para>
  <para style="q" vid="ISA 32:15">der ruach hkdsh fun der heich,</para>
  <para style="q" vid="ISA 32:15">un der midber vet vern a fruchtgortn,</para>
  <para style="q" vid="ISA 32:15">un der fruchtgortn vet far a vald gerechnt vern.<verse eid="ISA 32:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 32:16" />un in midber vet ruen gerechtikeit,</para>
  <para style="q" vid="ISA 32:16">un rechtfartikeit vet voinen in fruchtgortn.<verse eid="ISA 32:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 32:17" />un dos verk fun rechtfartikeit vet zain sholem,</para>
  <para style="q" vid="ISA 32:17">un der oiftu fun rechtfartikeit –</para>
  <para style="q" vid="ISA 32:17">ru un zicherkeit oif eibik.<verse eid="ISA 32:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 32:18" />un main folk vet zitsn in a voinung fun sholem,</para>
  <para style="q" vid="ISA 32:18">un in voinerter zichere,</para>
  <para style="q" vid="ISA 32:18">un in ruungen shtile.<verse eid="ISA 32:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 32:19" />un me vet zich tseshpreitn</para>
  <para style="q" vid="ISA 32:19">oif dem aropgang fun vald,</para>
  <para style="q" vid="ISA 32:19">un biz in der niderung vet nidern di shtot.<verse eid="ISA 32:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 32:20" />voil tsu aich vos zeit bai ale vasern,</para>
  <para style="q" vid="ISA 32:20">vos lozt arois frai dem fus fun dem oks un dem eizl.<verse eid="ISA 32:20" /></para>
  <chapter eid="ISA 32" />
  <chapter number="33" style="c" pubnumber="לג" sid="ISA 33" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 33:1" />vei, du farvister vos verst nisht farvist,</para>
  <para style="q" vid="ISA 33:1">un du felsher vos me felsht nisht on dir!</para>
  <para style="q" vid="ISA 33:1">az du vest oifhern farvistn, vestu farvist vern,</para>
  <para style="q" vid="ISA 33:1">az du vest endikn felshn, vet men felshn on dir.<verse eid="ISA 33:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 33:2" />Hashem laitzelik undz,</para>
  <para style="q" vid="ISA 33:2">tsu dir hobn mir gehoft;</para>
  <para style="q" vid="ISA 33:2">zai zeyer orem ale frimorgn,</para>
  <para style="q" vid="ISA 33:2">un undzer hilf in tsait fun noit.<verse eid="ISA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 33:3" />fun kol fun dem tuml zainen di umes antlofn,</para>
  <para style="q" vid="ISA 33:3">fun dain oifheibn zich vern di felker tseshpreit.<verse eid="ISA 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 33:4" />un oifgeklibn vet vern aier roib</para>
  <para style="q" vid="ISA 33:4">vi der heisherik klaibt oif,</para>
  <para style="q" vid="ISA 33:4">vi griln shpringen,</para>
  <para style="q" vid="ISA 33:4">tut men shpringen deroif.<verse eid="ISA 33:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 33:5" />derhoibn iz Hashem, vorem er rut in der heich;</para>
  <para style="q" vid="ISA 33:5">er filt on Tsiyon mit recht un gerechtikeit.<verse eid="ISA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 33:6" />un di zicherkeit fun daine tsaitn vet zain</para>
  <para style="q" vid="ISA 33:6">a shats mit yeshues, chochme un derkenung;</para>
  <para style="q" vid="ISA 33:6">moire far Hashem, dos vet zain zain oitser.<verse eid="ISA 33:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 33:7" />ze, zeyere heldn klogn droisn,</para>
  <para style="q" vid="ISA 33:7">di shluchim fun sholem tuen biter veinen.<verse eid="ISA 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 33:8" />farvist zainen di vegen,</para>
  <para style="q" vid="ISA 33:8">oifgehert der vegforer;</para>
  <para style="q" vid="ISA 33:8">er hot farshtert dem bris,</para>
  <para style="q" vid="ISA 33:8">er hot faracht di shtet,</para>
  <para style="q" vid="ISA 33:8">er acht nisht oif kein mentshn.<verse eid="ISA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 33:9" />fartroiert, farshnitn iz dos land,</para>
  <para style="q" vid="ISA 33:9">farshemt iz der Levanon, farvelkt;</para>
  <para style="q" vid="ISA 33:9">der Sharon iz vi a midber gevorn,</para>
  <para style="q" vid="ISA 33:9">un opgetreislt iz Bashan un Karmel.<verse eid="ISA 33:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 33:10" />atsund vel ich oifshtein, zogt Hashem,</para>
  <para style="q" vid="ISA 33:10">atsund vel ich zich derheichn,</para>
  <para style="q" vid="ISA 33:10">atsund vel ich zich oifheibn.<verse eid="ISA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 33:11" />ir trogt shprei, vet ir gebern shtroi;</para>
  <para style="q" vid="ISA 33:11">aier otem – a faier vos vet aich fartseren.<verse eid="ISA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 33:12" />un di felker veln zain vi kalch farbrente,</para>
  <para style="q" vid="ISA 33:12">vi derner opgehakte vos vern in faier getsundn.<verse eid="ISA 33:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 33:13" />hert, ir vaite, vos ich hob geton,</para>
  <para style="q" vid="ISA 33:13">un veist, ir nonte, main gevure.<verse eid="ISA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 33:14" />es angstn in Tsiyon di zindike,</para>
  <para style="q" vid="ISA 33:14">a tsiterenish hot ongenumen di falshe:</para>
  <para style="q" vid="ISA 33:14">ver fun undz ken vailn in dem faier vos fartsert?</para>
  <para style="q" vid="ISA 33:14">ver fun undz ken vailn in di eibike brandn?<verse eid="ISA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 33:15" />der vos geit in rechtfartikeit, un redt erlech,</para>
  <para style="q" vid="ISA 33:15">der vos faracht dem gevin fun roib,</para>
  <para style="q" vid="ISA 33:15">der vos shoklt op zaine hent fun onnemen shochad,</para>
  <para style="q" vid="ISA 33:15">der vos farshtopt zain oier fun hern vegen blut,</para>
  <para style="q" vid="ISA 33:15">un fardrikt zaine oign fun kukn oif shlechts.<verse eid="ISA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 33:16" />er vet ruen in der heich;</para>
  <para style="q" vid="ISA 33:16">festungen fun feldzn veln zain zain bashitsung;</para>
  <para style="q" vid="ISA 33:16">zain broit iz gegebn, zain vaser iz zicher.<verse eid="ISA 33:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 33:17" />dem melech in zain sheinkeit veln onkukn daine oign;</para>
  <para style="q" vid="ISA 33:17">zei veln zen a land fun vaitenishn.<verse eid="ISA 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 33:18" />dain harts vet trachtn on der eime:</para>
  <para style="q" vid="ISA 33:18">vu iz der vos hot getseilt?</para>
  <para style="q" vid="ISA 33:18">vu der vos hot gevoign?</para>
  <para style="q" vid="ISA 33:18">vu der vos hot di turems getseilt?<verse eid="ISA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 33:19" />dos farshaite folk vestu mer nisht zen,</para>
  <para style="q" vid="ISA 33:19">dos folk mit a tunkeler shprach, nisht tsu farshtein,</para>
  <para style="q" vid="ISA 33:19">mit a shtamldikn loshen, nisht klug tsu vern.<verse eid="ISA 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 33:20" />kuk on Tsiyon, di shtot fun undzer ainzamlung;</para>
  <para style="q" vid="ISA 33:20">daine oign veln zen Yerushalayim,</para>
  <para style="q" vid="ISA 33:20">a voinung a ruike,</para>
  <para style="q" vid="ISA 33:20">a getselt vos vet nisht avekgerukt vern,</para>
  <para style="q" vid="ISA 33:20">vos zaine fleklech veln eibik nisht aroisgetsoign vern,</para>
  <para style="q" vid="ISA 33:20">un ale zaine shtrik veln nisht opgerisn vern.<verse eid="ISA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 33:21" />nor dortn vet Hashem undz zain machtik,</para>
  <para style="q" vid="ISA 33:21">vi an ort fun taichn, shtromen breitroimike,</para>
  <para style="q" vid="ISA 33:21">vos kein rudershif ken oif im nisht gein,</para>
  <para style="q" vid="ISA 33:21">un kein shtarker okrent ken im nisht iberforn.<verse eid="ISA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 33:22" />vorem Hashem iz undzer richter,</para>
  <para style="q" vid="ISA 33:22">Hashem iz undzer gezetsgeber,</para>
  <para style="q" vid="ISA 33:22">Hashem iz undzer melech;</para>
  <para style="q" vid="ISA 33:22">er vet undz helfn.<verse eid="ISA 33:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 33:23" />loiz gevorn zainen daine shtrik,</para>
  <para style="q" vid="ISA 33:23">zei haltn nisht fest zeyer mast,</para>
  <para style="q" vid="ISA 33:23">zei shpreitn dem zagl nisht ois.</para>
  <para style="q" vid="ISA 33:23">dentsmol vert fang fun fil zakroib tseteilt,</para>
  <para style="q" vid="ISA 33:23">hinkedike roibn roib.<verse eid="ISA 33:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 33:24" />un kein ainvoiner vet nisht zogn: ich bin krank;</para>
  <para style="q" vid="ISA 33:24">dem folk vos zitst derin iz fargebn di zind.<verse eid="ISA 33:24" /></para>
  <chapter eid="ISA 33" />
  <chapter number="34" style="c" pubnumber="לד" sid="ISA 34" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 34:1" />genent, ir felker, tsu hern,</para>
  <para style="q" vid="ISA 34:1">un ir umes, farnemt;</para>
  <para style="q" vid="ISA 34:1">zol hern di erd un ir fulkeit,</para>
  <para style="q" vid="ISA 34:1">di velt un ale ire shprotsungen.<verse eid="ISA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 34:2" />vorem Hashem hot a kaas oif ale felker,</para>
  <para style="q" vid="ISA 34:2">un a grimtsorn oif zeyer gantsn cheil;</para>
  <para style="q" vid="ISA 34:2">er hot zei tsu cheirem gemacht,</para>
  <para style="q" vid="ISA 34:2">zei ibergegebn tsu der shechite.<verse eid="ISA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 34:3" />un zeyere dershlogene veln zich valgern,</para>
  <para style="q" vid="ISA 34:3">– un fun zeyere pegorim vet oifgein a geshtank,</para>
  <para style="q" vid="ISA 34:3">un di berg veln tsegein fun zeyer blut.<verse eid="ISA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 34:4" />un der gantser cheil fun himel vet tsekrichn,</para>
  <para style="q" vid="ISA 34:4">un di himlen veln vi a megile zich oifviklen,</para>
  <para style="q" vid="ISA 34:4">un zeyer gants cheil vet aropvelkn,</para>
  <para style="q" vid="ISA 34:4">vi a blat velkt fun vainshtok,</para>
  <para style="q" vid="ISA 34:4">un vi farvelkt fun a faignboim.<verse eid="ISA 34:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 34:5" />vorem ongetrunken in himel hot zich main shverd,</para>
  <para style="q" vid="ISA 34:5">ot vet zi oif Edom aropnideren,</para>
  <para style="q" vid="ISA 34:5">un oif dem folk fun main cheirem, tsum mishpot.<verse eid="ISA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 34:6" />G-ts shverd iz ful mit blut,</para>
  <para style="q" vid="ISA 34:6">gezeftikt mit fets,</para>
  <para style="q" vid="ISA 34:6">mit blut fun lemer un bek,</para>
  <para style="q" vid="ISA 34:6">mit nirnfets fun viders;</para>
  <para style="q" vid="ISA 34:6">vorem Hashem hot a shlachtung in Botsrah,</para>
  <para style="q" vid="ISA 34:6">un a groise shechtung in land Edom.<verse eid="ISA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 34:7" />un nidern veln vizltirn mit zei,</para>
  <para style="q" vid="ISA 34:7">un buln mit oksen;</para>
  <para style="q" vid="ISA 34:7">un ontrinken vet zich zeyer erd mit blut,</para>
  <para style="q" vid="ISA 34:7">un zeyer shtoib vet zich zeftikn mit fets.<verse eid="ISA 34:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 34:8" />vorem a tog fun nekome iz bai Hashem,</para>
  <para style="q" vid="ISA 34:8">a yor fun batsolung far dem krig fun Tsiyon.<verse eid="ISA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 34:9" />un farkert vern in pech veln ire shtromen,</para>
  <para style="q" vid="ISA 34:9">un ir shtoib in shvebl,</para>
  <para style="q" vid="ISA 34:9">un ir erd vet vern brenendike pech.<verse eid="ISA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 34:10" />tog un nacht vet zi nisht farloshn vern,</para>
  <para style="q" vid="ISA 34:10">oif eibik vet oifgein ir roich;</para>
  <para style="q" vid="ISA 34:10">fun dor tsu dor vet zi vist zain,</para>
  <para style="q" vid="ISA 34:10">oif eibikeibikeitn vet keiner nisht durchgein durch ir.<verse eid="ISA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 34:11" />un yarshen veln zi der pelikan un der zumpbushl,</para>
  <para style="q" vid="ISA 34:11">un di sove un der rob veln ruen in ir;</para>
  <para style="q" vid="ISA 34:11">un er vet tsien oif ir a shnur fun vistkeit,</para>
  <para style="q" vid="ISA 34:11">un a gruntvog fun leidikeit.<verse eid="ISA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 34:12" />fun ire adllait vet nisht zain dort</para>
  <para style="q" vid="ISA 34:12">ver es zol a meluche oisrufn;</para>
  <para style="q" vid="ISA 34:12">un ale ire srores veln vern tsu nisht.<verse eid="ISA 34:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 34:13" />un oifgein veln derner in ire palatsn,</para>
  <para style="q" vid="ISA 34:13">un kropive un shtechgeveks in ire festungen;</para>
  <para style="q" vid="ISA 34:13">un zi vet zain a voinung fun shakaln,</para>
  <para style="q" vid="ISA 34:13">a geheft far shtroisfoiglen.<verse eid="ISA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 34:14" />un vilde kets veln ontrefn midber-hint,</para>
  <para style="q" vid="ISA 34:14">un a shed vet rufn tsu zain chever;</para>
  <para style="q" vid="ISA 34:14">yo, dortn tut lilit ruen,</para>
  <para style="q" vid="ISA 34:14">un gefint ir menuche.<verse eid="ISA 34:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 34:15" />dort macht di failshlang ir nest, un leigt,</para>
  <para style="q" vid="ISA 34:15">un brit un varemt in ir shotn;</para>
  <para style="q" vid="ISA 34:15">yo, dort zamlen zich habichfoiglen</para>
  <para style="q" vid="ISA 34:15">einer tsum andern.<verse eid="ISA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 34:16" />forsht in Hashems buch, un leyent;</para>
  <para style="q" vid="ISA 34:16">keins fun di dozike iz nisht geminert,</para>
  <para style="q" vid="ISA 34:16">keins felt nisht tsum andern.</para>
  <para style="q" vid="ISA 34:16">vorem main moil hot bafoiln,</para>
  <para style="q" vid="ISA 34:16">un zain ruach hot zei aingezamlt.<verse eid="ISA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 34:17" />un er hot zei gevorfn a goirl,</para>
  <para style="q" vid="ISA 34:17">un zain hant hot es zei tseteilt mit a shnur;</para>
  <para style="q" vid="ISA 34:17">biz eibik veln zei es yarshen,</para>
  <para style="q" vid="ISA 34:17">oif dor-doires veln zei ruen derin.<verse eid="ISA 34:17" /></para>
  <chapter eid="ISA 34" />
  <chapter number="35" style="c" pubnumber="לה" sid="ISA 35" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 35:1" />lustik zain veln der midber un di trikenish,</para>
  <para style="q" vid="ISA 35:1">un freyen vet zich di viste,</para>
  <para style="q" vid="ISA 35:1">un blien vi a roiz.<verse eid="ISA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 35:2" />blien vet zi blien, un zich freyen,</para>
  <para style="q" vid="ISA 35:2">yo, mit freid un gezang;</para>
  <para style="q" vid="ISA 35:2">di pracht fun Levanon iz ir gegebn,</para>
  <para style="q" vid="ISA 35:2">di sheinkeit fun Karmel un Sharon;</para>
  <para style="q" vid="ISA 35:2">zei veln zen di pracht fun Hashem,</para>
  <para style="q" vid="ISA 35:2">di sheinkeit fun Elokeinu.<verse eid="ISA 35:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 35:3" />shtarkt di shlafe hent,</para>
  <para style="q" vid="ISA 35:3">un di shtroichldike kni tut festikn.<verse eid="ISA 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 35:4" />zogt tsu di umruike hertser:</para>
  <para style="q" vid="ISA 35:4">zait shtark, hot nisht moire;</para>
  <para style="q" vid="ISA 35:4">ot iz Elokeichem, er vet kumen mit nekome,</para>
  <para style="q" vid="ISA 35:4">mit fargeltung fun Elokim</para>
  <para style="q" vid="ISA 35:4">vet er kumen un aich helfn.<verse eid="ISA 35:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 35:5" />dentsmol veln oifgemacht vern di oign fun blinde,</para>
  <para style="q" vid="ISA 35:5">un di oiern fun toibe veln geefent vern.<verse eid="ISA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 35:6" />dentsmol vet a hinkediker shpringen vi a hind,</para>
  <para style="q" vid="ISA 35:6">un di tsung fun a shtumen vet zingen;</para>
  <para style="q" vid="ISA 35:6">vorem in midber brechn ois vasern,</para>
  <para style="q" vid="ISA 35:6">un bechn in der viste.<verse eid="ISA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 35:7" />un dos heise gezemdn vet vern a taich,</para>
  <para style="q" vid="ISA 35:7">un der dorshtiker land — kvaln vaser;</para>
  <para style="q" vid="ISA 35:7">in voinort fun shakaln, vu zei hobn leign, vet zain groz,</para>
  <para style="q" vid="ISA 35:7">mit ror un yamsh.<verse eid="ISA 35:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 35:8" />un dort vet zain a shteg un a veg,</para>
  <para style="q" vid="ISA 35:8">un der heiliker veg vet men im rufn;</para>
  <para style="q" vid="ISA 35:8">nisht durchgein vet im an umreiner,</para>
  <para style="q" vid="ISA 35:8">naiert far zei vet er zain;</para>
  <para style="q" vid="ISA 35:8">veggeyer afile umgenite veln nisht blondzhen.<verse eid="ISA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 35:9" />dort vet nisht zain kein leib,</para>
  <para style="q" vid="ISA 35:9">un kein vilde chaye vet nisht aroifgein oif im –</para>
  <para style="q" vid="ISA 35:9">zei veln zich dort nisht gefinen.</para>
  <para style="q" vid="ISA 35:9">un di oisgeleizte veln gein,<verse eid="ISA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 35:10" />un di derleizte fun Hashem veln tsurikkern,</para>
  <para style="q" vid="ISA 35:10">un veln kumen kein Tsiyon mit gezang,</para>
  <para style="q" vid="ISA 35:10">un an eibike simche vet zain oif zeyer kop;</para>
  <para style="q" vid="ISA 35:10">sason un simche vet zei bakumen,</para>
  <para style="q" vid="ISA 35:10">un antloifn veln troier un ziftsenish.<verse eid="ISA 35:10" /></para>
  <chapter eid="ISA 35" />
  <chapter number="36" style="c" pubnumber="לו" sid="ISA 36" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1" />un es iz geven in fertsntn yor fun melech Chizkiyahun, iz aroifgegangen Sancheriv der melech fun Ashur oif ale bafestikte shtet fun Yehudah, un hot zei aingenumen. <verse eid="ISA 36:1" /><verse number="2" style="v" sid="ISA 36:2" />un der melech fun Ashur hot geshikt Ravshokehn fun Lachish kein Yerushalayim tsum melech Chizkiyahun mit a groisn cheil. un er hot zich geshtelt bai dem grobn fun dem oibershtn taich oifn veg fun vesherfeld. <verse eid="ISA 36:2" /><verse number="3" style="v" sid="ISA 36:3" />iz aroisgegangen tsu im Elyakim der zun fun Chilkiyahun, vos ibern palats, un Shevna der shraiber, un Yoach der zun fun ASafn, der dermoner.<verse eid="ISA 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4" />un Ravshakeh hot tsu zei gezogt: zogt akorsht tsu Chizkiyahun: azoi hot gezogt der groiser melech, der melech fun Ashur: vos iz di dozike farzicherung vos du farzicherst zich? <verse eid="ISA 36:4" /><verse number="5" style="v" sid="ISA 36:5" />du zogst, ober es iz nor a vort fun di lipn, ich hob eitse un shtarkeit tsu milchome. itst, oif vemen hostu zich farlozt, az du host zich kegen mir gebuntevet? <verse eid="ISA 36:5" /><verse number="6" style="v" sid="ISA 36:6" />ze, du farzicherst zich oif dem shtekn fun dem dozikn tsebrochenem ror – oif Mitsrayim – vos az a mentsh lent zich oif im on, geit er im arain in der hant, un lechert zi durch; azoi iz Pharaoh der melech fun Mitsrayim far ale vos farzichern zich oif im. <verse eid="ISA 36:6" /><verse number="7" style="v" sid="ISA 36:7" />un az du vest mir zogn: mir farzichern zich oif Hashem Elokeinu; iz dos nisht der vos Chizkiyah hot opgeton zaine bamot un zaine mizbeyches, un hot gezogt tsu Yehudah un tsu Yerushalayim: far dem dozikn mizbeyech zolt ir zich bukn? <verse eid="ISA 36:7" /><verse number="8" style="v" sid="ISA 36:8" />un atsund, farvet zich akorsht mit main har dem melech fun Ashur, un ich vel dir gebn tsvei toiznt ferd, oib du kenst dir aroifzetsn raiter oif zei. <verse eid="ISA 36:8" /><verse number="9" style="v" sid="ISA 36:9" />haint vi kenstu opshtoisn dem ponem fun a hoiptman, einem fun di klenste knecht fun main har? fun dest vegen farzicherstu zich oif Mitsrayim vegen raitvegn un raiter. <verse eid="ISA 36:9" /><verse number="10" style="v" sid="ISA 36:10" />un atsund, bin ich den on Hashem aroifgekumen oif dem dozikn land, es tsu farvistn? Hashem hot tsu mir gezogt: gei aroif oif dem dozikn land, un farvist es.<verse eid="ISA 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11" />hot Elyakim un Shevna un Yoach gezogt tsu Ravshokehn: red, ich bet dich, tsu daine knecht Aramish, vorem mir farshteyen es, un red nisht tsu undz Yehudish in di oiern fun dem dozikn folk vos oif der moier.<verse eid="ISA 36:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12" />hot Ravshakeh gezogt: hot den tsu dain har un tsu dir mich geshikt main har tsu redn di dozike verter, un nisht tsu di mentshn vos zitsn oif der moier, tsu esen zeyer koit, un tsu trinken zeyer laib-vaser, bai aich?<verse eid="ISA 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13" />un Ravshakeh hot zich geshtelt, un hot oisgerufn oif a hoichn kol, oif Yehudish, un hot gezogt: hert di verter fun dem groisn melech, dem melech fun Ashur: <verse eid="ISA 36:13" /><verse number="14" style="v" sid="ISA 36:14" />azoi hot gezogt der melech: zol aich Chizkiyah nisht narn, vorem er ken aich nisht matsl zain. <verse eid="ISA 36:14" /><verse number="15" style="v" sid="ISA 36:15" />un zol aich Chizkiyah nisht farzichern oif Hashem, azoi tsu zogn: matsl zain vet undz matsl zain G-t; di dozike shtot vet nisht ibergegebn vern in der hant fun dem melech fun Ashur. <verse eid="ISA 36:15" /><verse number="16" style="v" sid="ISA 36:16" />ir zolt zich nisht tsuhern tsu Chizkiyahun, vorem azoi hot gezogt der melech fun Ashur: macht mit mir sholem, un kumt arois tsu mir, un est itlecher fun zain vainshtok un itlecher fun zain faignboim, un trinkt itlecher dos vaser fun zain brunem; <verse eid="ISA 36:16" /><verse number="17" style="v" sid="ISA 36:17" />biz ich kum, un vel aich nemen in a land azoi vi aier land, a land fun tvue un vain, a land fun broit un vaingertner. <verse eid="ISA 36:17" /><verse number="18" style="v" sid="ISA 36:18" />zol aich nor Chizkiyah nisht ainredn, azoi tsu zogn: Hashem vet undz matsl zain. hobn den matsl geven di g‑ter fun di felker itlecher zain land fun der hant fun dem melech fun Ashur? <verse eid="ISA 36:18" /><verse number="19" style="v" sid="ISA 36:19" />vu zainen di g‑ter fun Chammat un Arpad? vu zainen di g‑ter fun Sefarvayim? un hobn zei den matsl geven Shomron fun main hant? <verse eid="ISA 36:19" /><verse number="20" style="v" sid="ISA 36:20" />ver zainen tsvishn ale g‑ter fun di dozike lender, vos hobn matsl geven zeyer land fun main hant, az Hashem zol matsl zain Yerushalayim fun main hant?<verse eid="ISA 36:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21" />hobn zei geshvigen, un hobn im a vort nisht geentfert, vorem der bafel fun melech iz geven, azoi tsu zogn: ir zolt im nisht entfern.<verse eid="ISA 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22" />iz gekumen Elyakim der zun fun Chilkiyahun, vos ibern palats, un Shevna der shraiber, un Yoach der zun fun ASafn, der dermoner, tsu Chizkiyahun, mit tserisene kleider, un zei hobn im dertseilt di verter fun Ravshokehn.<verse eid="ISA 36:22" /></para>
  <chapter eid="ISA 36" />
  <chapter number="37" style="c" pubnumber="לז" sid="ISA 37" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1" />un es iz geven, vi der melech Chizkiyah hot es gehert, azoi hot er tserisn zaine kleider, un zich tsugedekt mit zak, un er iz gekumen in hoiz fun Hashem. <verse eid="ISA 37:1" /><verse number="2" style="v" sid="ISA 37:2" />un er hot geshikt Elyakimen vos ibern palats, un Shevna dem shraiber, un di eltste fun di koyanim, tsugedekte mit zakkleider, tsu Yeshayahu hanovi dem zun fun Amotsn. <verse eid="ISA 37:2" /><verse number="3" style="v" sid="ISA 37:3" />un zei hobn tsu im gezogt: azoi hot gezogt Chizkiyah: a tog fun noit un shtrof un shmach iz der haintiker tog; vorem di kinder zainen gekumen tsum mutermoil, un nishto kein koiech tsu gebern. <verse eid="ISA 37:3" /><verse number="4" style="v" sid="ISA 37:4" />efsher vet Hashem dain G-t hern di verter fun Ravshokehn, vos zain har der melech fun Ashur hot im geshikt tsu lestern dem lebedikn Elokim, un er vet shtrofn far di reid vos Hashem dain G-t hot gehert; derum zolstu oifheibn a tfile far dem iberblaib vos gefint zich do.<verse eid="ISA 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5" />un vi di knecht fun Chizkiyahun zainen gekumen tsu Yeshayahuen, <verse eid="ISA 37:5" /><verse number="6" style="v" sid="ISA 37:6" />hot Yeshayahu tsu zei gezogt: azoi zolt ir zogn tsu aier har: azoi hot Hashem gezogt: zolst nisht moire hobn far di verter vos du host gehert, mit vos di yungen fun dem melech fun Ashur hobn mich geshendt. <verse eid="ISA 37:6" /><verse number="7" style="v" sid="ISA 37:7" />ze, ich gib arain in im a gaist, un er vet hern a herung, un vet zich umkeren tsu zain land; un ich vel im machn faln durchn shverd in zain land.<verse eid="ISA 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8" />un Ravshakeh hot zich umgekert, un hot gefunen dem melech fun Ashur milchome haltndik oif Livnah; vorem er hot gehat gehert az er hot avekgetsoign fun Lachish.<verse eid="ISA 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9" />un hot gehert oif Tirhakah dem melech fun Kush, azoi tsu zogn: er iz aroisgegangen milchome tsu haltn mit dir. un vi er hot dos gehert, hot er geshikt shluchim tsu Chizkiyahun, azoi tsu zogn: <verse eid="ISA 37:9" /><verse number="10" style="v" sid="ISA 37:10" />azoi zolt ir zogn tsu Chizkiyah dem melech fun Yehudah, azoi tsu zogn: zol dir nisht narn dain G-t vos du farzicherst zich oif im, azoi tsu zogn: Yerushalayim vet nisht ibergegebn vern in der hant fun dem melech fun Ashur. <verse eid="ISA 37:10" /><verse number="11" style="v" sid="ISA 37:11" />ot hostu gehert vos di mlochim fun Ashur hobn geton tsu ale lender, zei tsu farvistn, un du vilst nitsl vern? <verse eid="ISA 37:11" /><verse number="12" style="v" sid="ISA 37:12" />hobn di g‑ter fun di felker matsl geven di vos maine eltern hobn tseshtert, Gozan, un Charan, un Retsef, un di kinder fun Eden vos in Telassar? <verse eid="ISA 37:12" /><verse number="13" style="v" sid="ISA 37:13" />vu iz der melech fun Chammat, un der melech fun Arpad, un der melech fun der shtot Sefarvayim, fun Hena, un Ivah?<verse eid="ISA 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14" />hot Chizkiyah tsugenumen dem briv fun der hant fun di shluchim, un hot im ibergeleyent, un er iz aroifgegangen in hoiz fun Hashem. <verse eid="ISA 37:14" /><verse number="15" style="v" sid="ISA 37:15" />un Chizkiyah hot im oisgeshpreit far Hashem. un Chizkiyah hot mispalel geven tsu Hashem, azoi tsu zogn: <verse eid="ISA 37:15" /><verse number="16" style="v" sid="ISA 37:16" />Hashem Tseva'ot, Elokei Yisroel vos zitsst iber di kruvim; du alein bist der Elokim iber ale kinigraichn fun der erd; du host gemacht di himlen un di erd. <verse eid="ISA 37:16" /><verse number="17" style="v" sid="ISA 37:17" />naig, Hashem, dain oier, un her; efen, Hashem, daine oign, un ze; un her di ale verter fun Sancherivn, vos hot geshikt tsu lestern dem lebedikn Elokim. <verse eid="ISA 37:17" /><verse number="18" style="v" sid="ISA 37:18" />emes, Hashem, di mlochim fun Ashur hobn chorev gemacht di ale medines mit zeyer land, <verse eid="ISA 37:18" /><verse number="19" style="v" sid="ISA 37:19" />un zei hobn ibergegebn zeyere g‑ter tsum faier; vorem zei zainen kein g‑ter nisht geven, nor bloiz dos verk fun a mentshns hent, holts un shtein; derum hobn zei zei untergebracht. <verse eid="ISA 37:19" /><verse number="20" style="v" sid="ISA 37:20" />un atsund, Hashem Elokeinu, helf undz fun zain hant, un zoln ale kinigraichn fun der erd visen az du alein bist Hashem.<verse eid="ISA 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21" />hot Yeshayahu der zun fun Amotsn geshikt tsu Chizkiyahun, azoi tsu zogn: azoi hot gezogt Hashem Elokei Yisroel: vos du host mispalel geven tsu mir vegen Sancheriv dem melech fun Ashur – <verse eid="ISA 37:21" /><verse number="22" style="v" sid="ISA 37:22" />iz dos dos vort vos Hashem hot vegen im geredt:</para>
  <para style="b" vid="ISA 37:22" />
  <para style="q" vid="ISA 37:22">es faracht dich, es shpot fun dir</para>
  <para style="q" vid="ISA 37:22">di yungfroi tochter Tsiyon;</para>
  <para style="q" vid="ISA 37:22">es shoklt dem kop hinter dir</para>
  <para style="q" vid="ISA 37:22">di tochter Yerushalayim.<verse eid="ISA 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 37:23" />vemen hostu gelestert un geshendt?</para>
  <para style="q" vid="ISA 37:23">un oif vemen hostu dain kol oifgehoibn?</para>
  <para style="q" vid="ISA 37:23">yo, host gehoibn daine oign in der heich,</para>
  <para style="q" vid="ISA 37:23">akegn dem heilikn fun Yisroel.<verse eid="ISA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 37:24" />durch daine knecht hostu gelestert Adonoi,</para>
  <para style="q" vid="ISA 37:24">un gezogt: mit maine fil raitvegn</para>
  <para style="q" vid="ISA 37:24">bin ich tsu der heich fun di berg aroif,</para>
  <para style="q" vid="ISA 37:24">tsu di vinklen fun Levanon;</para>
  <para style="q" vid="ISA 37:24">un ich hak op zaine hoiche tsedern,</para>
  <para style="q" vid="ISA 37:24">zaine geklibene tsipresbeimer;</para>
  <para style="q" vid="ISA 37:24">un ich kum tsu zain hechstn shpits,</para>
  <para style="q" vid="ISA 37:24">tsum vald fun zain fruchtgortn.<verse eid="ISA 37:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 37:25" />ich hob gegrobn un getrunken vaser,</para>
  <para style="q" vid="ISA 37:25">un trikn ois mit maine fustrit</para>
  <para style="q" vid="ISA 37:25">ale taichn fun Mitsrayim.<verse eid="ISA 37:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="ISA 37:26" />hostu den nisht gehert?</para>
  <para style="q" vid="ISA 37:26">fun lang on hob ich es tsugegreit,</para>
  <para style="q" vid="ISA 37:26">fun alte teg hob ich es gefuremt;</para>
  <para style="q" vid="ISA 37:26">atsund hob ich es gebracht es zol geshen,</para>
  <para style="q" vid="ISA 37:26">tsu farvistn oif churve-hoifns</para>
  <para style="q" vid="ISA 37:26">bafestikte shtet.<verse eid="ISA 37:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 37:27" />derum zainen zeyere bavoiner kurtsmachtik,</para>
  <para style="q" vid="ISA 37:27">zei zainen tsebrochn un farshemt;</para>
  <para style="q" vid="ISA 37:27">zei zainen gevorn groz fun feld,</para>
  <para style="q" vid="ISA 37:27">un kraitechts grine,</para>
  <para style="q" vid="ISA 37:27">mach fun di decher,</para>
  <para style="q" vid="ISA 37:27">un a feld eider oifgevaksn.<verse eid="ISA 37:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="ISA 37:28" />ober ich veis dain zitsn</para>
  <para style="q" vid="ISA 37:28">un dain gein un dain kumen,</para>
  <para style="q" vid="ISA 37:28">un dain shturemen kegen mir.<verse eid="ISA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 37:29" />vail dain shturemen kegen mir</para>
  <para style="q" vid="ISA 37:29">un dain liarem iz aroif in maine oiern,</para>
  <para style="q" vid="ISA 37:29">derum vel ich arainton main ring in dain noz,</para>
  <para style="q" vid="ISA 37:29">un main tsam in daine lipn,</para>
  <para style="q" vid="ISA 37:29">un ich vel dich umkeren oif dem veg</para>
  <para style="q" vid="ISA 37:29">vos du bist gekumen oif im.<verse eid="ISA 37:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30" />un dos vet dir zain der tseichn: ir vet esen hayyor nochvuks, un oifn tsveitn yor vidervuks; un oifn dritn yor zeit un shnaidt, un flantst vaingertner, un est zeyer frucht. <verse eid="ISA 37:30" /><verse number="31" style="v" sid="ISA 37:31" />un der antrunener iberblaib fun dem hoiz fun Yehudah vet vider vortselen unten, un trogn frucht oiben. <verse eid="ISA 37:31" /><verse number="32" style="v" sid="ISA 37:32" />vorem fun Yerushalayim vet aroiskumen an iberblaib, un an antrinung fun barg Tsiyon; dos onnemen zich fun Hashem Tseva'ot vet dos ton.<verse eid="ISA 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33" />far vor, azoi hot Hashem gezogt oif dem melech fun Ashur: er vet nisht arainkumen in der doziker shtot, un nisht arainshisn ahin a fail, un nisht kumen far ir mit a shild, un nisht onshitn arum ir an erdval. <verse eid="ISA 37:33" /><verse number="34" style="v" sid="ISA 37:34" />oif dem veg vos er iz gekumen, oif im vet er zich umkeren, un in der doziker shtot vet er nisht arainkumen, zogt Hashem. <verse eid="ISA 37:34" /><verse number="35" style="v" sid="ISA 37:35" />un ich vel bashiremen di dozike shtot, zi tsu helfn, fun mainet vegen un fun main knecht Dovids vegen.<verse eid="ISA 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36" />un a malach fun Hashem iz aroisgegangen, un hot geshlogn in dem lager fun Ashur hundert un finf un achtsik toiznt; un az me iz oifgeshtanen in der peire, ersht zei zainen ale toite pegorim. <verse eid="ISA 37:36" /><verse number="37" style="v" sid="ISA 37:37" />un Sancheriv der melech fun Ashur hot avekgetsoign, un iz gegangen un hot zich umgekert; un er iz geblibn in Nineveh. <verse eid="ISA 37:37" /><verse number="38" style="v" sid="ISA 37:38" />un es iz geven, vi er bukt zich in hoiz fun zain G-t nisruch, azoi hobn zaine zin Adramelech un saretser im dershlogn mitn shverd; un zei zainen antrunen gevorn in land Ararat. un zain zun Esar-Chaddon iz gevorn melech oif zain ort.<verse eid="ISA 37:38" /></para>
  <chapter eid="ISA 37" />
  <chapter number="38" style="c" pubnumber="לח" sid="ISA 38" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1" />in yener tsait iz Chizkiyah krank gevorn tsu shtarbn; iz tsu im gekumen Yeshayahu hanovi der zun fun Amotsn, un hot tsu im gezogt: azoi hot Hashem gezogt: mach dain tsevaeh vegen dain hoizgezint, vorem du shtarbst, un vest nisht genezn vern.<verse eid="ISA 38:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2" />hot Chizkiyah umgedreit zain ponem tsu der vant, un hot mispalel geven tsu Hashem, <verse eid="ISA 38:2" /><verse number="3" style="v" sid="ISA 38:3" />un hot gezogt: ich bet dich, Hashem, gedenk vi ich bin gegangen far dir mit emes un mit a gantsn hartsn, un vos iz gut in daine oign hob ich geton. un Chizkiyah hot geveint a grois gevein.<verse eid="ISA 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4" />iz dos vort fun Hashem geven tsu Yeshayahuen, azoi tsu zogn: <verse eid="ISA 38:4" /><verse number="5" style="v" sid="ISA 38:5" />gei un zolst zogn tsu Chizkiyahun: azoi hot gezogt Hashem der G-t fun dain foter Dovid: ich hob gehert dain tfile, ich hob gezen dain trer; ze, ich leig‑tsu tsu daine teg fuftsn yor. <verse eid="ISA 38:5" /><verse number="6" style="v" sid="ISA 38:6" />un fun der hant fun dem melech fun Ashur vel ich dich un di dozike shtot matsl zain, un ich vel bashiremen di dozike shtot.<verse eid="ISA 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7" />un dos vet dir zain a tseichn fun Hashem, az Hashem vet ton di dozike zach vos er hot geredt: <verse eid="ISA 38:7" /><verse number="8" style="v" sid="ISA 38:8" />ze, ich ker um dem shotn fun di shtaplen vos hot aropgenidert oif di zunshtaplen fun Achazn, tsurik tsen shtaplen. un di zun hot zich umgekert tsen shtaplen, oif di shtaplen vos zi hot aropgenidert.<verse eid="ISA 38:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9" />a geshrifts fun Chizkiyah dem melech fun Yehudah, ven er iz krank geven, un iz genezn gevorn fun zain krankshaft.<verse eid="ISA 38:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 38:10" />ich hob gevest gezogt: in mitn fun maine teg</para>
  <para style="q" vid="ISA 38:10">vel ich avekgein in di toiern fun Sheol;</para>
  <para style="q" vid="ISA 38:10">ich ver geminert dem resht fun maine yorn.<verse eid="ISA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 38:11" />ich hob gezogt: ich vel nisht zen Hashem,</para>
  <para style="q" vid="ISA 38:11">Hashem in land fun di lebedike;</para>
  <para style="q" vid="ISA 38:11">ich vel mer a mentshn nisht onkukn</para>
  <para style="q" vid="ISA 38:11">mit di bavoiner fun der velt.<verse eid="ISA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 38:12" />main voinung iz avekgerukt un opgeton fun mir,</para>
  <para style="q" vid="ISA 38:12">azoi vi a pastuchgetselt;</para>
  <para style="q" vid="ISA 38:12">ich hob oifgeviklt vi a veber main lebn;</para>
  <para style="q" vid="ISA 38:12">fun der tsoit vet er mich opraisn;</para>
  <para style="q" vid="ISA 38:12">fun tog biz nacht vestu mich endikn.<verse eid="ISA 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 38:13" />ich hob getracht biz frimorgn,</para>
  <para style="q" vid="ISA 38:13">vi a leib, azoi vet er ale maine beiner tsebrechn;</para>
  <para style="q" vid="ISA 38:13">fun tog biz nacht vestu mich endikn.<verse eid="ISA 38:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 38:14" />vi a shvalb, vi a bushl, azoi hob ich gepipst,</para>
  <para style="q" vid="ISA 38:14">ich hob gebrumt vi a toib;</para>
  <para style="q" vid="ISA 38:14">maine oign zainen oisgegangen tsu der heich:</para>
  <para style="q" vid="ISA 38:14">Adonoi, gedrikt bin ich, shtel zich ain far mir.<verse eid="ISA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 38:15" />vos zol ich redn?</para>
  <para style="q" vid="ISA 38:15">az er hot mir gezogt, un er hot geton;</para>
  <para style="q" vid="ISA 38:15">zacht vel ich gein ale maine yorn,</para>
  <para style="q" vid="ISA 38:15">iber der biternish fun main zel.<verse eid="ISA 38:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 38:16" />Adonoi, deroif lebt men,</para>
  <para style="q" vid="ISA 38:16">un in gantsn derin iz dos lebn fun main gaist;</para>
  <para style="q" vid="ISA 38:16">derum shtark mich, un loz mich lebn.<verse eid="ISA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 38:17" />ze, tsum gutn iz mir farbaiten gevorn di biternish,</para>
  <para style="q" vid="ISA 38:17">un du host geglust main zel,</para>
  <para style="q" vid="ISA 38:17">fun der grub fun untergang;</para>
  <para style="q" vid="ISA 38:17">vorem host avekgevorfen hinter dain rukn</para>
  <para style="q" vid="ISA 38:17">ale maine zind.<verse eid="ISA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 38:18" />vorem nisht di Sheol tut dich loibn,</para>
  <para style="q" vid="ISA 38:18">nisht der toit tut dich rimen;</para>
  <para style="q" vid="ISA 38:18">es hofn nisht oif dain emes</para>
  <para style="q" vid="ISA 38:18">di vos nidern in grub.<verse eid="ISA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 38:19" />der lebediker, der lebediker,</para>
  <para style="q" vid="ISA 38:19">er tut dich loibn, azoi vi ich haint;</para>
  <para style="q" vid="ISA 38:19">a foter macht visen di kinder dain emes.<verse eid="ISA 38:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 38:20" />Hashem iz do mich tsu helfn;</para>
  <para style="q" vid="ISA 38:20">un maine gezangen veln mir zingen,</para>
  <para style="q" vid="ISA 38:20">ale teg fun undzer lebn in hoiz fun Hashem.<verse eid="ISA 38:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21" />un Yeshayahu hot gezogt: zol men nemen gepreste faign, un onraibn oif dem oisshlog, un er vet genezn vern.<verse eid="ISA 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22" />hot Chizkiyah gezogt: vos iz der tseichn az ich vel aroifgein in hoiz fun Hashem?<verse eid="ISA 38:22" /></para>
  <chapter eid="ISA 38" />
  <chapter number="39" style="c" pubnumber="לט" sid="ISA 39" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1" />in yener tsait hot Merodach-Baladan der zun fun Baladanen, der melech fun Bavel, geshikt a briv un a matone tsu Chizkiyahun; vorem er hot gehert az er iz geven krank, un iz gezunt gevorn. <verse eid="ISA 39:1" /><verse number="2" style="v" sid="ISA 39:2" />hot Chizkiyah zich derfreit mit zei, un er hot zei gevizn zain shatshoiz, dos zilber, un dos gold, un di b'somaim, un dos gute eil, un dos gantse hoiz fun zaine vofn, un alts vos hot zich gefunen in zaine shatskamern; nisht geven a zach in zain hoiz, un in zain gantser geveltikeit, vos Chizkiyah hot zei nisht gevizn. <verse eid="ISA 39:2" /><verse number="3" style="v" sid="ISA 39:3" />iz Yeshayahu hanovi gekumen tsum melech Chizkiyahun, un hot tsu im gezogt: vos hobn di dozike mener gezogt? un fun vanen kumen zei tsu dir? hot Chizkiyah gezogt: fun a vaitn land zainen zei tsu mir gekumen, fun Bavel. <verse eid="ISA 39:3" /><verse number="4" style="v" sid="ISA 39:4" />hot er gezogt: vos hobn zei gezen in dain hoiz? hot Chizkiyah gezogt: alts vos in main hoiz hobn zei gezen; nisht geven a zach in maine shatskamern vos ich hob zei nisht gevizn.<verse eid="ISA 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5" />hot Yeshayahu gezogt tsu Chizkiyahun: her dos vort fun Hashem Tseva'ot: <verse eid="ISA 39:5" /><verse number="6" style="v" sid="ISA 39:6" />ze, teg kumen, un alts vos in dain hoiz, un vos daine eltern hobn ongeklibn biz haintikn tog, vet avekgetrogen vern kein Bavel; kein zach vet nisht iberblaiben, zogt Hashem. <verse eid="ISA 39:6" /><verse number="7" style="v" sid="ISA 39:7" />un fun daine zin vos veln aroisgein fun dir, vos du vest gebern, vet men nemen, un zei veln zain hoifdiner in palats fun dem melech fun Bavel.<verse eid="ISA 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8" />hot Chizkiyah gezogt tsu Yeshayahuen: gut iz dos vort fun Hashem vos du host geredt. un er hot gezogt: oib sholem un zicherkeit vet zain in maine teg!<verse eid="ISA 39:8" /></para>
  <chapter eid="ISA 39" />
  <chapter number="40" style="c" pubnumber="מ" sid="ISA 40" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 40:1" />treist, treist main folk, zogt Elokeichem.<verse eid="ISA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 40:2" />redt tsum hartsn fun Yerushalayim,</para>
  <para style="q" vid="ISA 40:2">un ruft tsu ir,</para>
  <para style="q" vid="ISA 40:2">az zi hot derfilt ir tsait,</para>
  <para style="q" vid="ISA 40:2">az opgetsolt iz ir farbrech;</para>
  <para style="q" vid="ISA 40:2">az zi hot gekrign fun Hashems hant</para>
  <para style="q" vid="ISA 40:2">topl far ale ire zind.<verse eid="ISA 40:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 40:3" />a kol ruft in der midber:</para>
  <para style="q" vid="ISA 40:3">macht tsurecht dem veg fun Hashem,</para>
  <para style="q" vid="ISA 40:3">macht grod in der viste</para>
  <para style="q" vid="ISA 40:3">a shteg far Elokeinu.<verse eid="ISA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 40:4" />yetveder tal zol derhoibn vern,</para>
  <para style="q" vid="ISA 40:4">un yetveder barg un heich zol dernidert vern;</para>
  <para style="q" vid="ISA 40:4">un dos krume zol vern glaich,</para>
  <para style="q" vid="ISA 40:4">un di bargkeitn a ploin.<verse eid="ISA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 40:5" />un der koved fun Hashem vet antplekt vern,</para>
  <para style="q" vid="ISA 40:5">un ale laiber in einem veln zen;</para>
  <para style="q" vid="ISA 40:5">vorem dos moil fun Hashem hot geredt.<verse eid="ISA 40:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 40:6" />a kol zogt: ruf!</para>
  <para style="q" vid="ISA 40:6">un er zogt: vos zol ich rufn?</para>
  <para style="q" vid="ISA 40:6">ale laiber zainen groz,</para>
  <para style="q" vid="ISA 40:6">un al zeyer chein vi a blum fun feld;<verse eid="ISA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 40:7" />fartriknt vert dos groz,</para>
  <para style="q" vid="ISA 40:7">farvelkt vert di blum,</para>
  <para style="q" vid="ISA 40:7">az der hoich fun Hashem blozt deroif;</para>
  <para style="q" vid="ISA 40:7">far vor, groz iz dos folk.<verse eid="ISA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 40:8" />fartriknt vert dos groz,</para>
  <para style="q" vid="ISA 40:8">farvelkt vert di blum,</para>
  <para style="q" vid="ISA 40:8">ober dos vort fun Elokeinu vet oif eibik bashtein.<verse eid="ISA 40:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 40:9" />oif a hoichn barg gei dir aroif,</para>
  <para style="q" vid="ISA 40:9">mevaseret fun Tsiyon;</para>
  <para style="q" vid="ISA 40:9">heib oif mit koiech dain kol,</para>
  <para style="q" vid="ISA 40:9">mevaseret fun Yerushalayim;</para>
  <para style="q" vid="ISA 40:9">heib oif, hob nisht moire,</para>
  <para style="q" vid="ISA 40:9">zog tsu di shtet fun Yehudah: ot iz Elokeichem!<verse eid="ISA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 40:10" />ze, Adonoi Hashem kumt a machtiker,</para>
  <para style="q" vid="ISA 40:10">un zain orem geveltikt far im;</para>
  <para style="q" vid="ISA 40:10">ze, zain Sachar iz mit im,</para>
  <para style="q" vid="ISA 40:10">un zain loin im farois;<verse eid="ISA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 40:11" />vi a pastuch vet er fitern zain stade,</para>
  <para style="q" vid="ISA 40:11">mit zain orem vet er ainzamlen di lemer,</para>
  <para style="q" vid="ISA 40:11">un in zain buzem zei trogn;</para>
  <para style="q" vid="ISA 40:11">di zeigedike vet er firn.<verse eid="ISA 40:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 40:12" />ver hot gemestn di vasern mit zain hantful,</para>
  <para style="q" vid="ISA 40:12">un di himlen mit a shpan oisgemostn,</para>
  <para style="q" vid="ISA 40:12">un bafast in a draitl dem shtoib fun der erd,</para>
  <para style="q" vid="ISA 40:12">un opgevoign mit a vog di berg,</para>
  <para style="q" vid="ISA 40:12">un di heichn mit vogsholn?<verse eid="ISA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 40:13" />ver hot ongevizen dem gaist fun Hashem?</para>
  <para style="q" vid="ISA 40:13">un ver iz zain baal-eitse vos hot im tsugevaizn?<verse eid="ISA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 40:14" />mit vemen hot er zich meyayets geven,</para>
  <para style="q" vid="ISA 40:14">vos hot im gegebn tsu farshtein,</para>
  <para style="q" vid="ISA 40:14">un im gelernt dem veg fun gerechtikeit,</para>
  <para style="q" vid="ISA 40:14">un im gelernt kenshaft,</para>
  <para style="q" vid="ISA 40:14">un dem veg fun farshtandikeit im gemacht visen?<verse eid="ISA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 40:15" />ze, felker zainen vi a trif fun an emer,</para>
  <para style="q" vid="ISA 40:15">un vi shtoib fun vogsholn zainen zei gerechnt;</para>
  <para style="q" vid="ISA 40:15">ze, indzelen heibt er oif vi a zemdl.<verse eid="ISA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 40:16" />un der Levanon iz nisht genug brenvarg,</para>
  <para style="q" vid="ISA 40:16">un zaine chayes nisht genug brandopfer.<verse eid="ISA 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 40:17" />ale felker zainen vi gornit kegen im,</para>
  <para style="q" vid="ISA 40:17">fun nisht un gornisht zainen zei gerechnt bai im.<verse eid="ISA 40:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 40:18" />un tsu vemen kent ir tsuglaichn El?</para>
  <para style="q" vid="ISA 40:18">un voser geshtalt kent ir im glaich shteln?<verse eid="ISA 40:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 40:19" />dem gets vos a mainster hot oisgegosen,</para>
  <para style="q" vid="ISA 40:19">un a shmeltser tsit im iber mit gold,</para>
  <para style="q" vid="ISA 40:19">un shmeltst-tsu keitlech fun zilber?<verse eid="ISA 40:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 40:20" />a shteindemb vert oisgeklibn,</para>
  <para style="q" vid="ISA 40:20">holts vos foilt nisht veilt men ois;</para>
  <para style="q" vid="ISA 40:20">a klugn mainster zucht men zich,</para>
  <para style="q" vid="ISA 40:20">oiftsushteln a gets vos zol zich nisht vaklen.<verse eid="ISA 40:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 40:21" />veist ir den nisht?</para>
  <para style="q" vid="ISA 40:21">hert ir den nisht?</para>
  <para style="q" vid="ISA 40:21">iz aich fun onheib on nisht dertseilt gevorn?</para>
  <para style="q" vid="ISA 40:21">farshteit ir nisht di gruntfestn fun der erd?<verse eid="ISA 40:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 40:22" />er iz der vos zitst iber dem tsirkl fun der erd,</para>
  <para style="q" vid="ISA 40:22">un ire bavoiner zainen vi heisherikn;</para>
  <para style="q" vid="ISA 40:22">der vos shpreit vi a tul di himlen,</para>
  <para style="q" vid="ISA 40:22">un tsit zei ois vi a getselt tsum voinen;<verse eid="ISA 40:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 40:23" />der vos farkert firshtn tsu nivets,</para>
  <para style="q" vid="ISA 40:23">vos macht vi gornit di richter fun der erd.<verse eid="ISA 40:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 40:24" />noch tsu mol nisht aingeflantst zainen zei,</para>
  <para style="q" vid="ISA 40:24">noch tsu mol nisht farzeit zainen zei,</para>
  <para style="q" vid="ISA 40:24">noch tsu mol nisht aingevortslt in der erd zeyer shtam,</para>
  <para style="q" vid="ISA 40:24">un shoin tut er a bloz oif zei, un zei vern fartriknt,</para>
  <para style="q" vid="ISA 40:24">un a shturem trogt zei vi shtroi avek.<verse eid="ISA 40:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="ISA 40:25" />un tsu vemen kent ir mich tsuglaichn, ich zol glaich zain?</para>
  <para style="q" vid="ISA 40:25">zogt der heiliker.<verse eid="ISA 40:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 40:26" />heibt oif in der heich aiere oign, un zet:</para>
  <para style="q" vid="ISA 40:26">ver hot bashafn di dozike?</para>
  <para style="q" vid="ISA 40:26">er, vos firt arois mit a tsol zeyer cheil,</para>
  <para style="q" vid="ISA 40:26">zei ale ruft er mitn nomen;</para>
  <para style="q" vid="ISA 40:26">durch grois macht, un vail er iz shtark in koiech,</para>
  <para style="q" vid="ISA 40:26">iz keiner nisht geminert.<verse eid="ISA 40:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 40:27" />far vos zolstu zogn Yaakov,</para>
  <para style="q" vid="ISA 40:27">un zolstu redn, Yisroel:</para>
  <para style="q" vid="ISA 40:27">farborgen iz main veg fun Hashem,</para>
  <para style="q" vid="ISA 40:27">un fun main G-t iz main mishpot avek.<verse eid="ISA 40:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 40:28" />veistu den nisht?</para>
  <para style="q" vid="ISA 40:28">tsi hostu nisht gehert?</para>
  <para style="q" vid="ISA 40:28">Hashem iz der eibiker Elokim,</para>
  <para style="q" vid="ISA 40:28">der Bashefer fun di ekn fun der erd.</para>
  <para style="q" vid="ISA 40:28">er vert nisht mid un nisht mat;</para>
  <para style="q" vid="ISA 40:28">nisht tsu derforshn iz zain farshtandikeit.<verse eid="ISA 40:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 40:29" />er git dem midn koiech,</para>
  <para style="q" vid="ISA 40:29">un dem ummachtikn mert er shtarkeit.<verse eid="ISA 40:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 40:30" />un yunge lait veln mid un mat vern,</para>
  <para style="q" vid="ISA 40:30">un yunge veln shtroichlen geshtroichlt vern;<verse eid="ISA 40:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 40:31" />ober di vos hofn oif Hashem veln banayen dem koiech,</para>
  <para style="q" vid="ISA 40:31">zei veln oifheibn fliglen vi di odlers;</para>
  <para style="q" vid="ISA 40:31">zei veln loifn un nisht mid vern,</para>
  <para style="q" vid="ISA 40:31">zei veln gein un nisht mat vern.<verse eid="ISA 40:31" /></para>
  <chapter eid="ISA 40" />
  <chapter number="41" style="c" pubnumber="מא" sid="ISA 41" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 41:1" />shvaigt far mir, ir indzelen,</para>
  <para style="q" vid="ISA 41:1">un zoln di felker banayen dem koiech;</para>
  <para style="q" vid="ISA 41:1">zoln zei zich nentern, dentsmol zoln zei redn;</para>
  <para style="q" vid="ISA 41:1">bainand lomir tsum mishpot genenen.<verse eid="ISA 41:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 41:2" />ver hot dervekt fun mizrech dem gerechtn,</para>
  <para style="q" vid="ISA 41:2">ruft im tsu zain fus?</para>
  <para style="q" vid="ISA 41:2">er git far im felker,</para>
  <para style="q" vid="ISA 41:2">un macht im geveltign iber mlochim;</para>
  <para style="q" vid="ISA 41:2">er macht vi shtoib zaier shverd,</para>
  <para style="q" vid="ISA 41:2">vi tsveiyete shtroi zaier boign.<verse eid="ISA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 41:3" />er folgt zei noch,</para>
  <para style="q" vid="ISA 41:3">er geit durch besholem, oif a veg</para>
  <para style="q" vid="ISA 41:3">vos mit zaine fis iz er nisht gegangen.<verse eid="ISA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 41:4" />ver hot dos geton un oisgefirt?</para>
  <para style="q" vid="ISA 41:4">der vos ruft di doires fun onhoib on;</para>
  <para style="q" vid="ISA 41:4">ich, der eibiker, bin der ershter,</para>
  <para style="q" vid="ISA 41:4">un mit di letste bin ich derzelber.<verse eid="ISA 41:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 41:5" />di indzelen hobn gezen, un hobn moire,</para>
  <para style="q" vid="ISA 41:5">di ekn fun der erd tuen tsiteren;</para>
  <para style="q" vid="ISA 41:5">zei hobn genent un zainen gekumen.<verse eid="ISA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 41:6" />einer helft dem andern,</para>
  <para style="q" vid="ISA 41:6">un er zogt tsu zain bruder: zai shtark;<verse eid="ISA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 41:7" />un der tishler shtarkt dem shmeltser,</para>
  <para style="q" vid="ISA 41:7">der vos glet mitn hamer,</para>
  <para style="q" vid="ISA 41:7">dem vos klapt oifn ambos;</para>
  <para style="q" vid="ISA 41:7">er zogt oifn tsunoifleit: er iz gut;</para>
  <para style="q" vid="ISA 41:7">un bafestikt es mit negl,</para>
  <para style="q" vid="ISA 41:7">es zol zich nisht vaklen.<verse eid="ISA 41:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 41:8" />un du Yisroel main knecht,</para>
  <para style="q" vid="ISA 41:8">Yaakov, vos ich hob dich oisderveilt,</para>
  <para style="q" vid="ISA 41:8">der zomen fun Avraham main libhober,<verse eid="ISA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 41:9" />vos ich hob dich ongenumen fun di ekn erd,</para>
  <para style="q" vid="ISA 41:9">un fun ire bregn dich gerufn,</para>
  <para style="q" vid="ISA 41:9">un gezogt tsu dir: main knecht bistu,</para>
  <para style="q" vid="ISA 41:9">ich hob dich oisderveilt un dich nisht faracht;<verse eid="ISA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 41:10" />zolst nisht moire hobn, vorem ich bin mit dir,</para>
  <para style="q" vid="ISA 41:10">zolst zich nisht umkukn, vorem ich bin dain G-t;</para>
  <para style="q" vid="ISA 41:10">ich shtark dich un ich helf dich,</para>
  <para style="q" vid="ISA 41:10">un ich len dich unter mit der rechter hant fun main gerechtikeit.<verse eid="ISA 41:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 41:11" />ze, farshemt un tsu shand veln vern</para>
  <para style="q" vid="ISA 41:11">ale vos zainen ongetsundn oif dir;</para>
  <para style="q" vid="ISA 41:11">vi nisht veln vern</para>
  <para style="q" vid="ISA 41:11">un untergein di mentshn in krig mit dir;<verse eid="ISA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 41:12" />vest zei zuchn un zei nisht gefinen,</para>
  <para style="q" vid="ISA 41:12">di mentshn in shtrait mit dir;</para>
  <para style="q" vid="ISA 41:12">vi nisht un vi gornisht veln vern</para>
  <para style="q" vid="ISA 41:12">di mentshn in milchome mit dir.<verse eid="ISA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 41:13" />vorem ich bin Hashem dain G-t</para>
  <para style="q" vid="ISA 41:13">vos halt dain rechte hant,</para>
  <para style="q" vid="ISA 41:13">der vos zogt tsu dir:</para>
  <para style="q" vid="ISA 41:13">zolst nisht moire hobn, ich helf dich.<verse eid="ISA 41:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 41:14" />zolst nisht moire hobn, vorem Yaakov, heifele Yisroel;</para>
  <para style="q" vid="ISA 41:14">ich helf dich, zogt Hashem,</para>
  <para style="q" vid="ISA 41:14">un dain oisleizer iz der heiliker fun Yisroel.<verse eid="ISA 41:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 41:15" />ze, ich mach dich far a dreshshlitn a naiem,</para>
  <para style="q" vid="ISA 41:15">mit shpitsn a sach;</para>
  <para style="q" vid="ISA 41:15">vest dreshn berg un tsemoln,</para>
  <para style="q" vid="ISA 41:15">– un heichn vestu vi shprei machn.<verse eid="ISA 41:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 41:16" />vest zei vintshuflen,</para>
  <para style="q" vid="ISA 41:16">un a vint vet zei avektrogen,</para>
  <para style="q" vid="ISA 41:16">un a shturem vet zei tseshpreitn;</para>
  <para style="q" vid="ISA 41:16">un du vest zich freyen mit Hashem,</para>
  <para style="q" vid="ISA 41:16">mit dem heilikn fun Yisroel vestu zich rimen.<verse eid="ISA 41:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 41:17" />di orime un baderftike zuchn vaser un nishto,</para>
  <para style="q" vid="ISA 41:17">zeyer tsung iz fartriknt fun dorsht;</para>
  <para style="q" vid="ISA 41:17">ich, Hashem, vel zei entfern,</para>
  <para style="q" vid="ISA 41:17">ich, Elokei Yisroel, vel zei nisht farlozen.<verse eid="ISA 41:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 41:18" />ich vel efenen shtromen oif hoiche erter,</para>
  <para style="q" vid="ISA 41:18">un kvaln in mitn fun toln;</para>
  <para style="q" vid="ISA 41:18">ich vel machn dem midber far a gemoizechts vaser,</para>
  <para style="q" vid="ISA 41:18">un trukn land far oisgangen vaser.<verse eid="ISA 41:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 41:19" />ich vel gebn in midber tseder,</para>
  <para style="q" vid="ISA 41:19">akatsie, un mirt, un eilboim;</para>
  <para style="q" vid="ISA 41:19">ich vel ainzetsn in der viste tsipres,</para>
  <para style="q" vid="ISA 41:19">tenenboim un buksnboim in einem;<verse eid="ISA 41:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 41:20" />kedei zei zoln zen un visen,</para>
  <para style="q" vid="ISA 41:20">un batrachtn un farshtein tsuglaich,</para>
  <para style="q" vid="ISA 41:20">az di hant fun Hashem hot dos geton,</para>
  <para style="q" vid="ISA 41:20">un der heiliker fun Yisroel hot es geshafn.<verse eid="ISA 41:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 41:21" />brengt aher aier krig, zogt Hashem,</para>
  <para style="q" vid="ISA 41:21">genent aiere tainus, zogt der kinig fun Yaakov.<verse eid="ISA 41:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 41:22" />zoln zei genenen un undz zogn</para>
  <para style="q" vid="ISA 41:22">di zachn vos gesheen;</para>
  <para style="q" vid="ISA 41:22">di frierdike – vos zainen zei?</para>
  <para style="q" vid="ISA 41:22">zogt, kedei mir zoln tsuleigen undzer harts,</para>
  <para style="q" vid="ISA 41:22">un derkenen zeyer oislozen;</para>
  <para style="q" vid="ISA 41:22">oder di kumedike lozt undz hern.<verse eid="ISA 41:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 41:23" />dertseilt undz vos vet kumen shpeter,</para>
  <para style="q" vid="ISA 41:23">un mir veln visen az ir zait g‑ter;</para>
  <para style="q" vid="ISA 41:23">yo, tut guts oder tut shlechts,</para>
  <para style="q" vid="ISA 41:23">un mir veln zich umkukn un zen tsuglaich.<verse eid="ISA 41:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 41:24" />zet, ir zait fun nisht,</para>
  <para style="q" vid="ISA 41:24">un aier verk fun gornisht;</para>
  <para style="q" vid="ISA 41:24">umverdik iz der vos tut aich oisveiln.<verse eid="ISA 41:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="ISA 41:25" />ich hob dervekt fun tsofn, un er iz gekumen,</para>
  <para style="q" vid="ISA 41:25">fun zunoifgang dem vos ruft main nomen;</para>
  <para style="q" vid="ISA 41:25">un er geit oif firshtn vi oif koit,</para>
  <para style="q" vid="ISA 41:25">un vi a teper tret leim.<verse eid="ISA 41:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 41:26" />ver hot ongezogt fun onheib, az mir zoln visen,</para>
  <para style="q" vid="ISA 41:26">un fun frier, az mir zoln zogn: er iz gerecht?</para>
  <para style="q" vid="ISA 41:26">keiner tsu mol hot nisht ongezogt,</para>
  <para style="q" vid="ISA 41:26">keiner tsu mol hot nisht gelozt hern,</para>
  <para style="q" vid="ISA 41:26">keiner tsu mol hot nisht gehert aiere verter.<verse eid="ISA 41:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 41:27" />an ershter kein Tsiyon: ze, on zainen zei!</para>
  <para style="q" vid="ISA 41:27">un Yerushalayim vel ich gebn a mevaser.<verse eid="ISA 41:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 41:28" />ober ich kuk, un keiner iz nishto,</para>
  <para style="q" vid="ISA 41:28">un fun di dozike iz nishto kein yoets,</para>
  <para style="q" vid="ISA 41:28">vos ich zol zei fregn,</para>
  <para style="q" vid="ISA 41:28">un zei zoln entfern a vort.<verse eid="ISA 41:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 41:29" />ze, zei ale zainen beizs,</para>
  <para style="q" vid="ISA 41:29">nishtik zainen zeyere verk,</para>
  <para style="q" vid="ISA 41:29">vint un vistkeit zeyere getsn.<verse eid="ISA 41:29" /></para>
  <chapter eid="ISA 41" />
  <chapter number="42" style="c" pubnumber="מב" sid="ISA 42" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 42:1" />ot iz main knecht vos ich len im unter,</para>
  <para style="q" vid="ISA 42:1">main oisderveilter vos main zel bagert;</para>
  <para style="q" vid="ISA 42:1">ich hob aroifgeton main gaist oif im,</para>
  <para style="q" vid="ISA 42:1">a mishpot tsu di felker vet er aroislozn.<verse eid="ISA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 42:2" />er vet nisht shraien, un nisht hilchn,</para>
  <para style="q" vid="ISA 42:2">un nisht lozn hern in gas zain kol.<verse eid="ISA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 42:3" />an aingebrochn shtekl vet er nisht tsebrechn,</para>
  <para style="q" vid="ISA 42:3">un a tunkeln knoit vet er nisht farleshn;</para>
  <para style="q" vid="ISA 42:3">loitn emes vet er aroislozn a mishpot.<verse eid="ISA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 42:4" />er vet nisht mat vern un nisht gebrochn vern,</para>
  <para style="q" vid="ISA 42:4">biz er vet ton oif der erd gerechtikeit;</para>
  <para style="q" vid="ISA 42:4">un indzelen veln vartn oif zain toyre.<verse eid="ISA 42:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 42:5" />azoi hot gezogt HaEl Hashem,</para>
  <para style="q" vid="ISA 42:5">vos hot bashafn di himlen un zei oisgetsoign,</para>
  <para style="q" vid="ISA 42:5">vos hot oisgeshpreit di erd mit ire shprotsungen,</para>
  <para style="q" vid="ISA 42:5">vos git otem dem folk oif ir,</para>
  <para style="q" vid="ISA 42:5">un a gaist di vos geyen oif ir:<verse eid="ISA 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 42:6" />ich Hashem hob dich gerufn in gerechtikeit,</para>
  <para style="q" vid="ISA 42:6">un ich vel onnemen dain hant, un dich hitn,</para>
  <para style="q" vid="ISA 42:6">un dich machn far a bris mit di felker,</para>
  <para style="q" vid="ISA 42:6">far a licht fun di umes;<verse eid="ISA 42:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 42:7" />tsu efenen blinde oign,</para>
  <para style="q" vid="ISA 42:7">aroistsutsien fun gefenkenish dem gefangenem,</para>
  <para style="q" vid="ISA 42:7">fun tefish di vos zitsn in fintsternish.<verse eid="ISA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 42:8" />ich bin Hashem, dos iz main nomen;</para>
  <para style="q" vid="ISA 42:8">un main koved vel ich tsu kein andern nisht gebn,</para>
  <para style="q" vid="ISA 42:8">un main loib – tsu kein getsn.<verse eid="ISA 42:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 42:9" />dos frierdike, ze, iz ongekumen,</para>
  <para style="q" vid="ISA 42:9">un nais vel ich onzogen;</para>
  <para style="q" vid="ISA 42:9">eider es shprotst arois</para>
  <para style="q" vid="ISA 42:9">vel ich es aich machn hern.<verse eid="ISA 42:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 42:10" />zingt tsu Hashem a nai gezang,</para>
  <para style="q" vid="ISA 42:10">zain loib fun ek fun der erd,</para>
  <para style="q" vid="ISA 42:10">ir vos nidert oifn yam un zain fulkeit,</para>
  <para style="q" vid="ISA 42:10">indzelen un zeyere bavoiner.<verse eid="ISA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 42:11" />zoln hilchn der midber un zaine shtet,</para>
  <para style="q" vid="ISA 42:11">di derfer vos Kedar bavoint;</para>
  <para style="q" vid="ISA 42:11">zoln zingen di bavoiner fun feldz,</para>
  <para style="q" vid="ISA 42:11">fun shpits berg zoln zei shraien.<verse eid="ISA 42:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 42:12" />zoln zei ton koved tsu Hashem,</para>
  <para style="q" vid="ISA 42:12">un zain loib in di indzelen dertseiln.<verse eid="ISA 42:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 42:13" />Hashem vet aroisgein vi a gibor,</para>
  <para style="q" vid="ISA 42:13">vi a krigsman vet er veken zain kine;</para>
  <para style="q" vid="ISA 42:13">er vet shaln un vet shraien,</para>
  <para style="q" vid="ISA 42:13">iber di faint zaine vet er zich shtarkn.<verse eid="ISA 42:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 42:14" />ich hob geshvigen fun lang on,</para>
  <para style="q" vid="ISA 42:14">ich fleg shtil zain, zich ainhaltn;</para>
  <para style="q" vid="ISA 42:14">atsund vel ich shraien vi a gevinerin,</para>
  <para style="q" vid="ISA 42:14">ich vel heshen un sopen in einem.<verse eid="ISA 42:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 42:15" />ich vel farvistn di berg un di heichn,</para>
  <para style="q" vid="ISA 42:15">un al zeyer groz vel ich fardarn;</para>
  <para style="q" vid="ISA 42:15">un ich vel machn taichn far indzelen,</para>
  <para style="q" vid="ISA 42:15">un gemoizechts vel ich fartrikenen.<verse eid="ISA 42:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 42:16" />un ich vel machn gein blinde</para>
  <para style="q" vid="ISA 42:16">oif a veg vos zei hobn nisht gevust,</para>
  <para style="q" vid="ISA 42:16">oif shtegn vos zei hobn nisht gevust</para>
  <para style="q" vid="ISA 42:16">vel ich zei firn;</para>
  <para style="q" vid="ISA 42:16">ich vel machn zei farois fintsternish tsu licht,</para>
  <para style="q" vid="ISA 42:16">un krumenishn far a ploin.</para>
  <para style="q" vid="ISA 42:16">di dozike zachn, zei tu ich,</para>
  <para style="q" vid="ISA 42:16">un loz zei nisht ois.<verse eid="ISA 42:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 42:17" />optretn ahinter, shemen veln zich shemen,</para>
  <para style="q" vid="ISA 42:17">di vos farzichern zich oifn geshnitstn bild,</para>
  <para style="q" vid="ISA 42:17">di vos zogn tsu gegosene getsn:</para>
  <para style="q" vid="ISA 42:17">ir zait undzere g‑ter.<verse eid="ISA 42:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 42:18" />ir toibe hert,</para>
  <para style="q" vid="ISA 42:18">un ir blinde, kukt zet.<verse eid="ISA 42:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 42:19" />ver iz blind oib nisht main knecht?</para>
  <para style="q" vid="ISA 42:19">oder toib vi main sheliech vos ich shik?</para>
  <para style="q" vid="ISA 42:19">ver iz blind vi der vos iz frum,</para>
  <para style="q" vid="ISA 42:19">un blind vi der knecht fun Hashem?<verse eid="ISA 42:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 42:20" />gezen fil, ober du merkst nisht;</para>
  <para style="q" vid="ISA 42:20">ofen di oiern, ober er hert nisht.<verse eid="ISA 42:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 42:21" />Hashem hot bavilikt fun vegen zain gerechtikeit,</para>
  <para style="q" vid="ISA 42:21">er zol greisn di toyre un prachtikn.<verse eid="ISA 42:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 42:22" />ober es iz a baroibt un barabevet folk,</para>
  <para style="q" vid="ISA 42:22">gefangen in lecher hot men zei ale,</para>
  <para style="q" vid="ISA 42:22">un in tfisut zainen zei bahaltn;</para>
  <para style="q" vid="ISA 42:22">zei zainen gevorn tsu roib,</para>
  <para style="q" vid="ISA 42:22">un nishto ver zol matsl zain,</para>
  <para style="q" vid="ISA 42:22">tsu oisroibung, un nishto ver zol zogn: ker um!<verse eid="ISA 42:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 42:23" />ver tsvishn aich vil farnemen dos dozike,</para>
  <para style="q" vid="ISA 42:23">horchn un farshtein farois?<verse eid="ISA 42:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 42:24" />ver hot gegebn tsu oisroibung Yaakov,</para>
  <para style="q" vid="ISA 42:24">un Yisroel tsu roiber?</para>
  <para style="q" vid="ISA 42:24">iz dos nisht Hashem, vos mir hobn gezindikt tsu im,</para>
  <para style="q" vid="ISA 42:24">un in zaine vegen hot men nisht gevolt gein,</para>
  <para style="q" vid="ISA 42:24">un zain toyre hot men nisht tsugehert?<verse eid="ISA 42:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 42:25" />derum hot er oisgegosen oif im</para>
  <para style="q" vid="ISA 42:25">dem geirem fun zain tsorn,</para>
  <para style="q" vid="ISA 42:25">un di shtarkeit fun milchome;</para>
  <para style="q" vid="ISA 42:25">un zi hot im ongetsundn rund arum,</para>
  <para style="q" vid="ISA 42:25">un er hot nisht gemerkt,</para>
  <para style="q" vid="ISA 42:25">un zi hot im gebrent,</para>
  <para style="q" vid="ISA 42:25">un er nemt nisht tsum hartsn.<verse eid="ISA 42:25" /></para>
  <chapter eid="ISA 42" />
  <chapter number="43" style="c" pubnumber="מג" sid="ISA 43" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 43:1" />un atsund hot azoi gezogt Hashem dain boire, Yaakov,</para>
  <para style="q" vid="ISA 43:1">un dain furemer, Yisroel;</para>
  <para style="q" vid="ISA 43:1">zolst nisht moire hobn, vorem ich leiz dich ois,</para>
  <para style="q" vid="ISA 43:1">ich ruf dich baim nomen, mainer bistu.<verse eid="ISA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 43:2" />az du vest gein durch vaser, bin ich mit dir,</para>
  <para style="q" vid="ISA 43:2">un az durch taichn, veln zei dich nisht farfleitsn;</para>
  <para style="q" vid="ISA 43:2">un du vest gein durch faier, vestu nisht ongebrent vern,</para>
  <para style="q" vid="ISA 43:2">un kein flam vet dich nisht ontsindn.<verse eid="ISA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 43:3" />vorem ich bin Hashem dain G-t,</para>
  <para style="q" vid="ISA 43:3">der heiliker fun Yisroel, dain helfer;</para>
  <para style="q" vid="ISA 43:3">ich gib Mitsrayim far dain oisleiz,</para>
  <para style="q" vid="ISA 43:3">Kush un Seva anshtot dir.<verse eid="ISA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 43:4" />vail taier bistu in maine oign,</para>
  <para style="q" vid="ISA 43:4">geacht, un ich hob dich lib;</para>
  <para style="q" vid="ISA 43:4">derum gib ich mentshn anshtot dir,</para>
  <para style="q" vid="ISA 43:4">un felker anshtot dain lebn.<verse eid="ISA 43:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 43:5" />zolst nisht moire hobn,</para>
  <para style="q" vid="ISA 43:5">vorem ich bin mit dir;</para>
  <para style="q" vid="ISA 43:5">fun mizrech vel ich brengen dain zomen,</para>
  <para style="q" vid="ISA 43:5">un fun mayrev vel ich dich ainzamlen;<verse eid="ISA 43:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 43:6" />ich vel zogn tsu tsofn: gib aher!</para>
  <para style="q" vid="ISA 43:6">un tsu dorem: zolst nisht tsurikhaltn!</para>
  <para style="q" vid="ISA 43:6">breng maine zin fun der vait,</para>
  <para style="q" vid="ISA 43:6">un maine techter fun ek erd;<verse eid="ISA 43:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 43:7" />itlechn vos vert gerufn mit main nomen,</para>
  <para style="q" vid="ISA 43:7">un vos ich hob im far main koved bashafn,</para>
  <para style="q" vid="ISA 43:7">im gefuremt un im gemacht.<verse eid="ISA 43:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 43:8" />tsit arois dos folk vos iz blind, un hot oign,</para>
  <para style="q" vid="ISA 43:8">un di vos zainen toib, un hobn oiern.<verse eid="ISA 43:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 43:9" />ale felker zoln zich ainzamlen in einem,</para>
  <para style="q" vid="ISA 43:9">un lozn zich oifklaibn di umes;</para>
  <para style="q" vid="ISA 43:9">ver tsvishn zei ken dos zogn,</para>
  <para style="q" vid="ISA 43:9">un faroisgezens undz lozn hern?</para>
  <para style="q" vid="ISA 43:9">zoln zei brengen zeyere eides, un gerecht zain,</para>
  <para style="q" vid="ISA 43:9">un zol men hern un zogn: es iz emes.<verse eid="ISA 43:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 43:10" />ir zait maine eides, zogt Hashem,</para>
  <para style="q" vid="ISA 43:10">un main knecht vos ich hob oisderveilt,</para>
  <para style="q" vid="ISA 43:10">kedei ir zolt visen, un gloibn in mir,</para>
  <para style="q" vid="ISA 43:10">un farshtein az ich bin dos;</para>
  <para style="q" vid="ISA 43:10">far mir iz nisht geshafn gevorn kein El,</para>
  <para style="q" vid="ISA 43:10">un noch mir vet nisht zain.<verse eid="ISA 43:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 43:11" />ich, ich bin Hashem,</para>
  <para style="q" vid="ISA 43:11">un chuts mir iz kein helfer nishto.<verse eid="ISA 43:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 43:12" />ich hob ongezogt un geholfn,</para>
  <para style="q" vid="ISA 43:12">un ich hob gemacht hern,</para>
  <para style="q" vid="ISA 43:12">un nisht a fremder iz geven tsvishn aich;</para>
  <para style="q" vid="ISA 43:12">un ir zait maine eides, zogt Hashem,</para>
  <para style="q" vid="ISA 43:12">az ich bin El.<verse eid="ISA 43:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 43:13" />oich haint bin ich der eigener,</para>
  <para style="q" vid="ISA 43:13">un nishto ver zol matsl zain fun main hant;</para>
  <para style="q" vid="ISA 43:13">ich tu, un ver ken es ophaltn?<verse eid="ISA 43:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 43:14" />azoi hot gezogt Hashem aier oisleizer,</para>
  <para style="q" vid="ISA 43:14">der heiliker fun Yisroel:</para>
  <para style="q" vid="ISA 43:14">fun aiert vegen shik ich kein Bavel,</para>
  <para style="q" vid="ISA 43:14">un vel zei ale machn nidern antlofene,</para>
  <para style="q" vid="ISA 43:14">un di Kasdim – in zeyere lustike shifn.<verse eid="ISA 43:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 43:15" />ich bin Hashem, aier heiliker,</para>
  <para style="q" vid="ISA 43:15">der Bashefer fun Yisroel, aier kinig.<verse eid="ISA 43:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 43:16" />azoi hot Hashem gezogt,</para>
  <para style="q" vid="ISA 43:16">der vos hot gegebn durchn yam a veg,</para>
  <para style="q" vid="ISA 43:16">un durch machtike vasern a shteg;<verse eid="ISA 43:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 43:17" />vos hot gelozt aroistsien</para>
  <para style="q" vid="ISA 43:17">raitvegn un ferd, cheil un shtarkeit,</para>
  <para style="q" vid="ISA 43:17">zei zoln lign in einem, zei zoln nisht oifshtein –</para>
  <para style="q" vid="ISA 43:17">zei hobn getsankt, zei hobn vi a knoit zich oisgeloshn:<verse eid="ISA 43:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 43:18" />ir zolt nisht dermonen dos frierdike,</para>
  <para style="q" vid="ISA 43:18">un dos amolike zolt ir nisht bartrachtn.<verse eid="ISA 43:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 43:19" />ot tu ich a nais;</para>
  <para style="q" vid="ISA 43:19">atsund shprotst es; derkent ir es nisht?</para>
  <para style="q" vid="ISA 43:19">yo, ich vel machn in midber a veg,</para>
  <para style="q" vid="ISA 43:19">in der vistenish taichn.<verse eid="ISA 43:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 43:20" />erlechn vet mich di chaye fun feld,</para>
  <para style="q" vid="ISA 43:20">shakaln un shtroisfoiglen,</para>
  <para style="q" vid="ISA 43:20">vail ich gib in midber vaser,</para>
  <para style="q" vid="ISA 43:20">taichn in der vistenish,</para>
  <para style="q" vid="ISA 43:20">ontsutrinken main folk, main oisderveilts;<verse eid="ISA 43:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 43:21" />dos folk vos ich hob mir bashafn,</para>
  <para style="q" vid="ISA 43:21">zei zoln dertseiln main loib.<verse eid="ISA 43:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 43:22" />un mich hostu nisht gerufn, Yaakov,</para>
  <para style="q" vid="ISA 43:22">az du zolst zain mid fun mir, Yisroel;<verse eid="ISA 43:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 43:23" />host mir nisht gebracht dos lam fun daine brandopfer,</para>
  <para style="q" vid="ISA 43:23">un mit daine shlachtopfer hostu mich nisht geerlecht;</para>
  <para style="q" vid="ISA 43:23">ich hob dich nisht bashvert mit shpaizopfer,</para>
  <para style="q" vid="ISA 43:23">un dich nisht mid gemacht mit vairech.<verse eid="ISA 43:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 43:24" />host mir nisht gekoift far gelt gevirtsror,</para>
  <para style="q" vid="ISA 43:24">un mit fets fun daine shlachtopfer mich nisht gezet;</para>
  <para style="q" vid="ISA 43:24">naiert host mich bashvert mit daine chatoim,</para>
  <para style="q" vid="ISA 43:24">mich mid gemacht mit daine zind.<verse eid="ISA 43:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="ISA 43:25" />ich, ich bin der vos mek ois</para>
  <para style="q" vid="ISA 43:25">daine ibertretn fun mainet vegen,</para>
  <para style="q" vid="ISA 43:25">un daine chatoim vel ich nisht dermonen.<verse eid="ISA 43:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 43:26" />dermon mir, lomir zich mishpetn mit anander,</para>
  <para style="q" vid="ISA 43:26">dertseil du, kedei zolst gerecht zain.<verse eid="ISA 43:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 43:27" />dain ershter foter hot gezindikt,</para>
  <para style="q" vid="ISA 43:27">un daine firshprecher hobn gebrochn on mir.<verse eid="ISA 43:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 43:28" />derum hob ich farshvecht di harn fun heiliktum,</para>
  <para style="q" vid="ISA 43:28">un gegebn tsu farvistung Yaakov,</para>
  <para style="q" vid="ISA 43:28">un Yisroel tsu lesterung.<verse eid="ISA 43:28" /></para>
  <chapter eid="ISA 43" />
  <chapter number="44" style="c" pubnumber="מד" sid="ISA 44" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 44:1" />un atsund, her, Yaakov main knecht,</para>
  <para style="q" vid="ISA 44:1">un Yisroel, vemen ich hob oisderveilt;<verse eid="ISA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 44:2" />azoi hot gezogt Hashem dain Bashefer,</para>
  <para style="q" vid="ISA 44:2">un dain furemer fun muterlaib, vos helft dich:</para>
  <para style="q" vid="ISA 44:2">zolst nisht moire hobn, main knecht Yaakov,</para>
  <para style="q" vid="ISA 44:2">un Yeshurun, vemen ich hob oisderveilt.<verse eid="ISA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 44:3" />vorem ich vel gisn vaser oif dorshtik land,</para>
  <para style="q" vid="ISA 44:3">un flusn oif trikenish;</para>
  <para style="q" vid="ISA 44:3">ich vel oisgisen main gaist oif dain zomen,</para>
  <para style="q" vid="ISA 44:3">un main broche oif daine shprotsn.<verse eid="ISA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 44:4" />un zei veln shprotsn vi tsvishn groz,</para>
  <para style="q" vid="ISA 44:4">vi verbes bai bechn vaser.<verse eid="ISA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 44:5" />der vet zogn: ich geher tsu Hashem;</para>
  <para style="q" vid="ISA 44:5">un der vet zich rufn mitn nomen fun Yaakov,</para>
  <para style="q" vid="ISA 44:5">un der vet oifshbraibn oif zain hant tsu Hashem,</para>
  <para style="q" vid="ISA 44:5">un mitn nomen Yisroel zich titlen.<verse eid="ISA 44:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 44:6" />azoi hot gezogt Hashem, der kinig fun Yisroel,</para>
  <para style="q" vid="ISA 44:6">un zain oisleizer, Hashem Tseva'ot:</para>
  <para style="q" vid="ISA 44:6">ich bin der ershter, un ich bin der letster,</para>
  <para style="q" vid="ISA 44:6">un chuts mir iz nishto kein Elokim.<verse eid="ISA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 44:7" />un ver vi ich ken faroisrufn –</para>
  <para style="q" vid="ISA 44:7">zol er es zogn un oisleigen far mir –</para>
  <para style="q" vid="ISA 44:7">fun zint ich hob bashafn dos eltste folk?</para>
  <para style="q" vid="ISA 44:7">un dos kumedike un vos vet geshen</para>
  <para style="q" vid="ISA 44:7">zoln zei dertseiln.<verse eid="ISA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 44:8" />ir zolt nisht angstn un nisht forchtn;</para>
  <para style="q" vid="ISA 44:8">far vor, fun lang on</para>
  <para style="q" vid="ISA 44:8">hob ich dich gelozt hern un dertseilt,</para>
  <para style="q" vid="ISA 44:8">un ir zait maine eides.</para>
  <para style="q" vid="ISA 44:8">iz den do a G-t achuts mir,</para>
  <para style="q" vid="ISA 44:8">az nishto a feldz ich zol nisht visen?<verse eid="ISA 44:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ISA 44:9" />di furemer fun a gets zainen nishtik ale, un zeyere glustike bilder nutsn nisht; un zei alein zainen zeyere eides, az zei hern nisht un veisn nisht; derum veln zei farshemt vern. <verse eid="ISA 44:9" /><verse number="10" style="v" sid="ISA 44:10" />ver furemt es a G-t, un gist ois a gets vos nutst nisht! <verse eid="ISA 44:10" /><verse number="11" style="v" sid="ISA 44:11" />ze, ale bahefte in im veln zich shemen, un di mainsters – zei mer fun ale mentshn; zoln zei oifshtein; ober zei veln moire hobn, zoln zei ale zich ainzamlen, zich shemen, in einem.<verse eid="ISA 44:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 44:12" />der aiznshmid a hak, un arbet oif koiln, un mit hamers tut er zi furemen, un arbet zi ois mit zain shtarkn orem; oich vert er hungerik, un iz on koiech, er trinkt nisht kein vaser, un vert farshmacht. <verse eid="ISA 44:12" /><verse number="13" style="v" sid="ISA 44:13" />der holtsmeinster tsit ois a shnur; er tseichnt es mit a shtift, er macht es mit hublen tsurecht, un mit a tsirkl tseichnt er es arum, un er macht es loit der geshtalt fun a man, loit der sheinkeit fun a mentshn, oif tsu voinen in a hoiz. <verse eid="ISA 44:13" /><verse number="14" style="v" sid="ISA 44:14" />er hakt zich ois tsedern, un nemt a hartdemb oder an eichnboim, un veilt zich ois tsvishn di beimer fun vald; er flantst a fichtboim, un der regn macht vaksn. <verse eid="ISA 44:14" /><verse number="15" style="v" sid="ISA 44:15" />un es iz far dem mentshn oif tsu brenen; un er nemt derfun, un varemt zich, oich heitst er, un bakt broit; dertsu macht er a G-t un bukt zich; macht es tsum gets, un knit dertsu. <verse eid="ISA 44:15" /><verse number="16" style="v" sid="ISA 44:16" />teil derfun hot er farbrent in faier, oif teil derfun est er fleish – brot brotn un zetikt zich, oich varemt er zich, un zogt: ah! mir iz varem, ich shpir dos faier; <verse eid="ISA 44:16" /><verse number="17" style="v" sid="ISA 44:17" />un dem iberblaib derfun macht er far a G-t – far zain gets; knit tsu im un bukt zich un tut tfile tsu im, un zogt: rateve mich, vorem main G-t bistu.<verse eid="ISA 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 44:18" />zei veisn nisht, un zei farshteyen nisht, vorem farklept fun tsu zen zainen zeyere oign, fun tsu farshtein – zeyere hertser. <verse eid="ISA 44:18" /><verse number="19" style="v" sid="ISA 44:19" />un keiner iberleigt nisht in zain hartsn, un nishto kein derkenung un kein seichel tsu zogn: teil derfun hob ich farbrent in faier, un oich gebakt oif zaine koiln broit, gebrotn fleish un gegesn; un dem resht derfun zol ich far an umverdikeit machn? tsu a shait holts zol ich knien? <verse eid="ISA 44:19" /><verse number="20" style="v" sid="ISA 44:20" />er yogt zich noch ash, a farnart harts hot im aropgefirt, un er iz nisht matsl zain nefesh, un zogt nisht: far vor, lign iz in main rechter hant.<verse eid="ISA 44:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 44:21" />gedenk dos dozike, Yaakov, un Yisroel,</para>
  <para style="q" vid="ISA 44:21">az main knecht bistu;</para>
  <para style="q" vid="ISA 44:21">ich hobn dich gefuremt, a knecht bistu mir;</para>
  <para style="q" vid="ISA 44:21">Yisroel, zolst mich nisht fargesen.<verse eid="ISA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 44:22" />ich hob opgemekt vi a chemare daine farbrechn,</para>
  <para style="q" vid="ISA 44:22">un vi a volken daine zind;</para>
  <para style="q" vid="ISA 44:22">ker zich um tsu mir, vorem ich hob dich oisgeleizt.<verse eid="ISA 44:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 44:23" />zingt ir himlen, vorem Hashem hot oifgeton;</para>
  <para style="q" vid="ISA 44:23">shalt, ir tifenishn fun der erd,</para>
  <para style="q" vid="ISA 44:23">brecht ois, ir berg, in gezang,</para>
  <para style="q" vid="ISA 44:23">der vald un yetveder boim in im;</para>
  <para style="q" vid="ISA 44:23">vorem Hashem hot oisgeleizt Yaakov,</para>
  <para style="q" vid="ISA 44:23">un mit Yisroel tut er zich rimen.<verse eid="ISA 44:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 44:24" />azoi hot gezogt Hashem dain oisleizer,</para>
  <para style="q" vid="ISA 44:24">un dain furemer fun muterlaib:</para>
  <para style="q" vid="ISA 44:24">ich bin Hashem vos hob alts ding gemacht,</para>
  <para style="q" vid="ISA 44:24">vos hob oisgetsoign di himlen alein,</para>
  <para style="q" vid="ISA 44:24">vos hob oisgeshpreit di erd fun mir zelbert;<verse eid="ISA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 44:25" />vos farshtert di tseichns fun di ligners,</para>
  <para style="q" vid="ISA 44:25">un di vorzoger macht er tsedult;</para>
  <para style="q" vid="ISA 44:25">vos kert di chachomim ahinter,</para>
  <para style="q" vid="ISA 44:25">un zeyer seichel banarisht er;<verse eid="ISA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 44:26" />vos iz mekayem dos vort fun zain knecht,</para>
  <para style="q" vid="ISA 44:26">un dem barot fun zaine shluchim firt er ois;</para>
  <para style="q" vid="ISA 44:26">vos zogt oif Yerushalayim: zei zol bazetst vern;</para>
  <para style="q" vid="ISA 44:26">un oif di shtet fun Yehudah: zei zoln opgeboit vern,</para>
  <para style="q" vid="ISA 44:26">un ire churves vel ich oifrichtn;<verse eid="ISA 44:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 44:27" />vos zogt tsu der tifenish: ver trukn,</para>
  <para style="q" vid="ISA 44:27">un daine taichn vel ich oistrikenen;<verse eid="ISA 44:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 44:28" />vos zogt oif Koreshn: er iz main pastuch,</para>
  <para style="q" vid="ISA 44:28">un al main bager vet er oisfirn,</para>
  <para style="q" vid="ISA 44:28">tsu zogn oif Yerushalayim: zi zol geboit vern,</para>
  <para style="q" vid="ISA 44:28">un tsum heichl: zolst gegruntfest vern.<verse eid="ISA 44:28" /></para>
  <chapter eid="ISA 44" />
  <chapter number="45" style="c" pubnumber="מה" sid="ISA 45" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 45:1" />azoi hot gezogt Hashem tsu zain gezalbtn,</para>
  <para style="q" vid="ISA 45:1">tsu Koreshn vos ich halt zain rechte hant,</para>
  <para style="q" vid="ISA 45:1">tsu machn untertenik far im felker,</para>
  <para style="q" vid="ISA 45:1">un ich zol loiz machn di lendn fun mlochim;</para>
  <para style="q" vid="ISA 45:1">tsu efenen far im tirn,</para>
  <para style="q" vid="ISA 45:1">un toiern zoln nisht farshlosn zain:<verse eid="ISA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 45:2" />ich vel gein dir farois,</para>
  <para style="q" vid="ISA 45:2">un krume erter vel ich oisglaichn;</para>
  <para style="q" vid="ISA 45:2">kuperne tirn vel ich tsebrechn,</para>
  <para style="q" vid="ISA 45:2">un aizerne riglen vel ich tsehakn.<verse eid="ISA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 45:3" />un ich vel dir gebn di oitseres fun der fintsternish,</para>
  <para style="q" vid="ISA 45:3">un di shatsn fun farborgenishn,</para>
  <para style="q" vid="ISA 45:3">kedei zolst visen az ich bin Hashem,</para>
  <para style="q" vid="ISA 45:3">vos ruft dich baim nomen, Elokei Yisroel.<verse eid="ISA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 45:4" />fun vegen dem knecht mainem Yaakov,</para>
  <para style="q" vid="ISA 45:4">un Yisroel main oisderveiltn,</para>
  <para style="q" vid="ISA 45:4">hob ich dich gerufn bai dain nomen,</para>
  <para style="q" vid="ISA 45:4">dich batitlt, hagam du host mich nisht gekent.<verse eid="ISA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 45:5" />ich bin Hashem, un mer iz nishto,</para>
  <para style="q" vid="ISA 45:5">chuts mir iz kein Elokim nisht faran;</para>
  <para style="q" vid="ISA 45:5">ich hob dich bagurt, hagam du host mich nisht gekent;<verse eid="ISA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 45:6" />kedei me zol visen fun oifgang fun zun</para>
  <para style="q" vid="ISA 45:6">un fun ir untergang,</para>
  <para style="q" vid="ISA 45:6">az nishto oiser mir;</para>
  <para style="q" vid="ISA 45:6">ich bin Hashem, un mer iz nishto;<verse eid="ISA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 45:7" />der vos furemt licht, un bashaft fintsternish,</para>
  <para style="q" vid="ISA 45:7">macht frid, un bashaft beiz;</para>
  <para style="q" vid="ISA 45:7">ich Hashem mach al di dozike.<verse eid="ISA 45:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 45:8" />trift, ir himlen, fun oiben,</para>
  <para style="q" vid="ISA 45:8">un di volkens zoln rinen gerechtikeit;</para>
  <para style="q" vid="ISA 45:8">zol di erd zich efenen,</para>
  <para style="q" vid="ISA 45:8">un yeshues zoln zich fruchpern.</para>
  <para style="q" vid="ISA 45:8">un rechtfartikeit zol zei machn shprotsn baglaich;</para>
  <para style="q" vid="ISA 45:8">ich Hashem hob dos bashafn.<verse eid="ISA 45:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 45:9" />vei, der vos krigt zich mit zain Bashefer –</para>
  <para style="q" vid="ISA 45:9">a sherbl tsvishn sherblech fun der erd!</para>
  <para style="q" vid="ISA 45:9">vet den zogn der leim tsu zain furemer: vos tustu?</para>
  <para style="q" vid="ISA 45:9">oder: dain arbet iz on hent?<verse eid="ISA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 45:10" />vei, der vos zogt tsu dem foter:</para>
  <para style="q" vid="ISA 45:10">noch vos machstu gebern?</para>
  <para style="q" vid="ISA 45:10">un tsu der froi:</para>
  <para style="q" vid="ISA 45:10">noch vos hostu veyen?<verse eid="ISA 45:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 45:11" />azoi hot Hashem gezogt,</para>
  <para style="q" vid="ISA 45:11">der heiliker fun Yisroel un zain furemer:</para>
  <para style="q" vid="ISA 45:11">fregt mich dos kumedike,</para>
  <para style="q" vid="ISA 45:11">bafelt mir vegen maine kinder</para>
  <para style="q" vid="ISA 45:11">un vegen dem verk fun maine hent?<verse eid="ISA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 45:12" />ich hob gemacht di erd,</para>
  <para style="q" vid="ISA 45:12">un dem mentshn oif ir bashafn;</para>
  <para style="q" vid="ISA 45:12">ich – maine hent hobn oisgetsoign di himlen,</para>
  <para style="q" vid="ISA 45:12">un zeyer gantsn cheil hob ich bafoiln.<verse eid="ISA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 45:13" />ich hob im dervekt mit gerechtikeit,</para>
  <para style="q" vid="ISA 45:13">un ale zaine vegen vel ich oisglaichn;</para>
  <para style="q" vid="ISA 45:13">er vet boien main shtot,</para>
  <para style="q" vid="ISA 45:13">un maine fartribene vet er aroislozn,</para>
  <para style="q" vid="ISA 45:13">nisht um getsolt, un nisht um shochad,</para>
  <para style="q" vid="ISA 45:13">zogt Hashem Tseva'ot.<verse eid="ISA 45:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 45:14" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="ISA 45:14">di mi fun Mitsrayim, un der mischar fun Kush,</para>
  <para style="q" vid="ISA 45:14">un di Sevaim, di vuksike lait,</para>
  <para style="q" vid="ISA 45:14">veln ibergein tsu dir, un daine veln zei vern;</para>
  <para style="q" vid="ISA 45:14">hinter dir veln zei gein,</para>
  <para style="q" vid="ISA 45:14">in keitn veln zei ariberkumen,</para>
  <para style="q" vid="ISA 45:14">un bukn veln zei zich tsu dir;</para>
  <para style="q" vid="ISA 45:14">betn veln zei zich bai dir:</para>
  <para style="q" vid="ISA 45:14">nor bai dir iz El,</para>
  <para style="q" vid="ISA 45:14">un achuts dir iz nisht do kein Elokim.<verse eid="ISA 45:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 45:15" />far vor, bist an El vos farborgt zich,</para>
  <para style="q" vid="ISA 45:15">Elokei Yisroel, du helfer.<verse eid="ISA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 45:16" />farshemt un oich tsu shand vern zei ale,</para>
  <para style="q" vid="ISA 45:16">mit shand geyen avek in einem</para>
  <para style="q" vid="ISA 45:16">ale mainsters fun getsnbilder.<verse eid="ISA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 45:17" />Yisroel vert geholfn fun Hashem</para>
  <para style="q" vid="ISA 45:17">an eibike hilf;</para>
  <para style="q" vid="ISA 45:17">ir vet nisht farshemt</para>
  <para style="q" vid="ISA 45:17">un nisht hobn mit vos zich tsu shemen biz eibikeibikeitn.<verse eid="ISA 45:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 45:18" />vorem azoi hot gezogt Hashem der Bashefer fun di himlen,</para>
  <para style="q" vid="ISA 45:18">– er, HaElokim, vos hot gefuremt di erd un zi gemacht;</para>
  <para style="q" vid="ISA 45:18">er vos hot zi oifgeshtelt,</para>
  <para style="q" vid="ISA 45:18">nisht far a vistenish zi bashafn,</para>
  <para style="q" vid="ISA 45:18">nor tsum voinen zi gefuremt:</para>
  <para style="q" vid="ISA 45:18">ich bin Hashem, un achuts iz nisht do kein Elokim.<verse eid="ISA 45:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 45:19" />nisht in farborgenish hob ich geredt,</para>
  <para style="q" vid="ISA 45:19">in an ort fun fintsterland;</para>
  <para style="q" vid="ISA 45:19">ich hob nisht gezogt tsu dem zomen fun Yaakov:</para>
  <para style="q" vid="ISA 45:19">in vistenish zucht mich;</para>
  <para style="q" vid="ISA 45:19">ich Hashem red gerechtikeit,</para>
  <para style="q" vid="ISA 45:19">zog on di richtikeit.<verse eid="ISA 45:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 45:20" />zamlt aich ain un kumt genent in einem,</para>
  <para style="q" vid="ISA 45:20">ir antrunene fun di felker;</para>
  <para style="q" vid="ISA 45:20">on farshtand zainen di vos trogn zeyer holtsgeshnits,</para>
  <para style="q" vid="ISA 45:20">un tuen tfile tsu an El vos helft nisht.<verse eid="ISA 45:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 45:21" />zogt on, un macht zei genenen,</para>
  <para style="q" vid="ISA 45:21">un lamen haltn an eitse in einem:</para>
  <para style="q" vid="ISA 45:21">ver hot dos gelozt hern fun fartsaitn,</para>
  <para style="q" vid="ISA 45:21">fun lang on dos ongezogt?</para>
  <para style="q" vid="ISA 45:21">far vor, ich Hashem,</para>
  <para style="q" vid="ISA 45:21">un nishto mer kein Elokim achuts mir,</para>
  <para style="q" vid="ISA 45:21">an El a gerechter un a helfer;</para>
  <para style="q" vid="ISA 45:21">un achuts iz nisht do kein Elokim.<verse eid="ISA 45:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 45:22" />kert aich tsu mir, un vert geholfn,</para>
  <para style="q" vid="ISA 45:22">ale ekn fun der erd;</para>
  <para style="q" vid="ISA 45:22">vorem ich bin El,</para>
  <para style="q" vid="ISA 45:22">un achuts iz nisht do kein Elokim.<verse eid="ISA 45:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 45:23" />ich hob geshvorn bai mir:</para>
  <para style="q" vid="ISA 45:23">a vort iz arois fun main moil in gerechtikeit,</para>
  <para style="q" vid="ISA 45:23">un vet zich nisht umkeren,</para>
  <para style="q" vid="ISA 45:23">az tsu mir zol zich beigen yetveder kni,</para>
  <para style="q" vid="ISA 45:23">zol shvern yetveder tsung.<verse eid="ISA 45:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 45:24" />nor in Hashem – vet men zogn fun mir –</para>
  <para style="q" vid="ISA 45:24">gerechtikeit un shtarkeit;</para>
  <para style="q" vid="ISA 45:24">tsu im veln kumen un zich shemen</para>
  <para style="q" vid="ISA 45:24">ale vos zainen ongetsundn oif im.<verse eid="ISA 45:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 45:25" />durch Hashem vet der gantser zomen</para>
  <para style="q" vid="ISA 45:25">fun Yisroel gerecht vern</para>
  <para style="q" vid="ISA 45:25">un zich rimen in im.<verse eid="ISA 45:25" /></para>
  <chapter eid="ISA 45" />
  <chapter number="46" style="c" pubnumber="מו" sid="ISA 46" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 46:1" />geknit iz Bel, geboign iz Nevo;</para>
  <para style="q" vid="ISA 46:1">zeyere getsn zainen oif beheimes un oif lastfi;</para>
  <para style="q" vid="ISA 46:1">di vos ir flegt zich umtrogn mit zei,</para>
  <para style="q" vid="ISA 46:1">zainen oifgelodn, a mase oif mide beheimes.<verse eid="ISA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 46:2" />zei zainen geboign, geknit in einem;</para>
  <para style="q" vid="ISA 46:2">zei hobn nisht gekent rateven di mase,</para>
  <para style="q" vid="ISA 46:2">un zei alein zainen in gefangenshaft avek.<verse eid="ISA 46:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 46:3" />hert mir tsu, ir hoiz fun Yaakov,</para>
  <para style="q" vid="ISA 46:3">un der gantser iberblaib fun hoiz Yisroel,</para>
  <para style="q" vid="ISA 46:3">ir gepestete fun muterlaib,</para>
  <para style="q" vid="ISA 46:3">ir getrogene fun gebermuter:<verse eid="ISA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 46:4" />afile biz elter bin ich der eigener,</para>
  <para style="q" vid="ISA 46:4">un biz groe hor vel ich trogn;</para>
  <para style="q" vid="ISA 46:4">ich hob gemacht, un ich vel trogn,</para>
  <para style="q" vid="ISA 46:4">un ich vel oif zich nemen un vel rateven.<verse eid="ISA 46:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 46:5" />tsu vemen vilt ir mich tsuglaichn un glaichshteln,</para>
  <para style="q" vid="ISA 46:5">un mich farglaichn, az mir zoln glaich zain?<verse eid="ISA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 46:6" />ir vos shit gold fun baitl,</para>
  <para style="q" vid="ISA 46:6">un vegt zilber oifn vogshtang;</para>
  <para style="q" vid="ISA 46:6">vos dingt a shmeltser er zol derfun machn a G-t,</para>
  <para style="q" vid="ISA 46:6">me zol zich knien un bukn.<verse eid="ISA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 46:7" />me nemt im oifn aksl, me trogt im,</para>
  <para style="q" vid="ISA 46:7">un me shtelt im avek oif zain plats,</para>
  <para style="q" vid="ISA 46:7">un er shteit, er rirt zich nisht fun zain ort;</para>
  <para style="q" vid="ISA 46:7">afile emetser shrait tsu im, entfert er nisht,</para>
  <para style="q" vid="ISA 46:7">fun zain noit tut er nisht helfn.<verse eid="ISA 46:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 46:8" />gedenkt dos, un mintert aich oif,</para>
  <para style="q" vid="ISA 46:8">nemt, ir farbrecher, tsum hartsn.<verse eid="ISA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 46:9" />gedenkt dos frierdike fun eibik on:</para>
  <para style="q" vid="ISA 46:9">az ich bin El, un mer iz nishto,</para>
  <para style="q" vid="ISA 46:9">Elokim, un nishto main glaichn.<verse eid="ISA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 46:10" />ich zog on fun onheib dem sof,</para>
  <para style="q" vid="ISA 46:10">un fun fartsaitn, vos iz noch nisht geshen;</para>
  <para style="q" vid="ISA 46:10">ich zog: main barot zol bashtein,</para>
  <para style="q" vid="ISA 46:10">un al main bager vel ich ton.<verse eid="ISA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 46:11" />ich ruf fun mizrech dem roibfoigl,</para>
  <para style="q" vid="ISA 46:11">fun a vaitn land dem man fun main barot;</para>
  <para style="q" vid="ISA 46:11">yo, ich hob geredt, un ich vel es brengen,</para>
  <para style="q" vid="ISA 46:11">ich hob bashert, un ich vel es ton.<verse eid="ISA 46:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 46:12" />hert mir tsu, ir shtarkhartsike,</para>
  <para style="q" vid="ISA 46:12">vos shpirt zich vait fun gerechtikeit:<verse eid="ISA 46:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 46:13" />iz dernentern main gerechtikeit,</para>
  <para style="q" vid="ISA 46:13">zi iz nisht vait,</para>
  <para style="q" vid="ISA 46:13">un main yeshue vet nisht zamen;</para>
  <para style="q" vid="ISA 46:13">un ich vel gebn in Tsiyon a yeshue</para>
  <para style="q" vid="ISA 46:13">far Yisroel main tsirung.<verse eid="ISA 46:13" /></para>
  <chapter eid="ISA 46" />
  <chapter number="47" style="c" pubnumber="מז" sid="ISA 47" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 47:1" />nider arop un zits in shtoib</para>
  <para style="q" vid="ISA 47:1">yungfroi tochter Bavel;</para>
  <para style="q" vid="ISA 47:1">zits oif der erd on a tron,</para>
  <para style="q" vid="ISA 47:1">tochter fun Kasdim;</para>
  <para style="q" vid="ISA 47:1">vorem mer vet men dich nisht rufn</para>
  <para style="q" vid="ISA 47:1">eidele un fartsertlte.<verse eid="ISA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 47:2" />nem a zhorne, un mol mel;</para>
  <para style="q" vid="ISA 47:2">dek op dain shleyer, heib oif di shlep,</para>
  <para style="q" vid="ISA 47:2">antplek di hift, gei taichn ariber.<verse eid="ISA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 47:3" />opgedekt vet vern dain naketkeit,</para>
  <para style="q" vid="ISA 47:3">oich gezen vern vet dain shand;</para>
  <para style="q" vid="ISA 47:3">nekome vel ich nemen,</para>
  <para style="q" vid="ISA 47:3">un nisht lozn a mentshn zich opbetn.<verse eid="ISA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 47:4" />undzer oisleizer – Hashem Tseva'ot iz zain nomen,</para>
  <para style="q" vid="ISA 47:4">der heiliker fun Yisroel.<verse eid="ISA 47:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 47:5" />zits shtil, un gei arain in fintsternish,</para>
  <para style="q" vid="ISA 47:5">tochter fun Kasdim,</para>
  <para style="q" vid="ISA 47:5">vorem mer vet men dich nisht rufn</para>
  <para style="q" vid="ISA 47:5">harinte fun kinigraichn.<verse eid="ISA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 47:6" />ich hob getsernt oif main folk,</para>
  <para style="q" vid="ISA 47:6">ich hob farshvecht main arav,</para>
  <para style="q" vid="ISA 47:6">un zei gegebn in dain hant;</para>
  <para style="q" vid="ISA 47:6">hostu zei kein rachmones nisht geshenkt,</para>
  <para style="q" vid="ISA 47:6">oif a zoken hostu bashvert dain yoch biz gor.<verse eid="ISA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 47:7" />un host gezogt:</para>
  <para style="q" vid="ISA 47:7">oif eibik vel ich a harinte zain;</para>
  <para style="q" vid="ISA 47:7">azoi az du host dos nisht genumen tsum hartsn,</para>
  <para style="q" vid="ISA 47:7">nisht gedacht on dem sof derfun.<verse eid="ISA 47:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 47:8" />un atsund her dos tsu, du voiltogerin,</para>
  <para style="q" vid="ISA 47:8">– vos zitst in zicherkeit,</para>
  <para style="q" vid="ISA 47:8">vos zogt in ir hartsn:</para>
  <para style="q" vid="ISA 47:8">ich, un chuts mir iz nishto mer.</para>
  <para style="q" vid="ISA 47:8">ich vel nisht zitsn an almone,</para>
  <para style="q" vid="ISA 47:8">un nisht visen fun blaibn on kinder:<verse eid="ISA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 47:9" />ober di dozike beide veln kumen oif dir</para>
  <para style="q" vid="ISA 47:9">in a rege in ein tog:</para>
  <para style="q" vid="ISA 47:9">blaibn on kinder un almoneshaft;</para>
  <para style="q" vid="ISA 47:9">in zeyer fuler mos kumen zei oif dir,</para>
  <para style="q" vid="ISA 47:9">bai al daine fil kishefn,</para>
  <para style="q" vid="ISA 47:9">bai al der grois shtarkeit fun daine shpruchn.<verse eid="ISA 47:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 47:10" />un bist geven zicher in dain shlechtikeit,</para>
  <para style="q" vid="ISA 47:10">host gezogt: keiner zet mich nisht;</para>
  <para style="q" vid="ISA 47:10">dain chochme un dain kenshaft,</para>
  <para style="q" vid="ISA 47:10">zi hot dich farfirt;</para>
  <para style="q" vid="ISA 47:10">un host gezogt in dain hartsn:</para>
  <para style="q" vid="ISA 47:10">ich, un chuts mir iz nishto mer.<verse eid="ISA 47:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 47:11" />ober kumen vet oif dir a beiz</para>
  <para style="q" vid="ISA 47:11">vos du vest nisht visen vi es optsushprechn,</para>
  <para style="q" vid="ISA 47:11">un onfaln vet oif dir a broch</para>
  <para style="q" vid="ISA 47:11">vos du vest im nisht kenen opton,</para>
  <para style="q" vid="ISA 47:11">un kumen vet oif dir plutsling a farvistung,</para>
  <para style="q" vid="ISA 47:11">az du vest gornisht merkn.<verse eid="ISA 47:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 47:12" />shtei akorsht oif mit daine shpruchn,</para>
  <para style="q" vid="ISA 47:12">un mit daine fil kishefn,</para>
  <para style="q" vid="ISA 47:12">oif vos du host zich gemit fun dain yugnt on;</para>
  <para style="q" vid="ISA 47:12">efsher vestu kenen nutsn,</para>
  <para style="q" vid="ISA 47:12">efsher vestu onshrekn.<verse eid="ISA 47:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 47:13" />bist mid fun daine fil etsut;</para>
  <para style="q" vid="ISA 47:13">zoln di himlkuker,</para>
  <para style="q" vid="ISA 47:13">di shternzeer,</para>
  <para style="q" vid="ISA 47:13">di faroiszoger fun di chodeshim,</para>
  <para style="q" vid="ISA 47:13">akorsht oifshtein un dich helfn</para>
  <para style="q" vid="ISA 47:13">fun di vos veln kumen oif dir.<verse eid="ISA 47:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 47:14" />ze, zei vern azoi vi shtroi,</para>
  <para style="q" vid="ISA 47:14">a faier tut zei farbrenen,</para>
  <para style="q" vid="ISA 47:14">zei veln zich alein nisht matsl zain</para>
  <para style="q" vid="ISA 47:14">fun der macht fun der flam;</para>
  <para style="q" vid="ISA 47:14">nisht a koil zich tsu varemen vet es zain –</para>
  <para style="q" vid="ISA 47:14">a faier tsu zitsn far im.<verse eid="ISA 47:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 47:15" />azoi vern tsu dir di vos du host zich gemit um zei;</para>
  <para style="q" vid="ISA 47:15">di vos hobn gehandlt mit dir fun dain yugnt on,</para>
  <para style="q" vid="ISA 47:15">vandern itlecher in zain zait,</para>
  <para style="q" vid="ISA 47:15">keiner helft dich nisht.<verse eid="ISA 47:15" /></para>
  <chapter eid="ISA 47" />
  <chapter number="48" style="c" pubnumber="מח" sid="ISA 48" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 48:1" />hert dos tsu, ir hoiz fun Yaakov,</para>
  <para style="q" vid="ISA 48:1">di vos vern gerufn mitn nomen Yisroel,</para>
  <para style="q" vid="ISA 48:1">un fun kval fun Yehudah zainen zei arois;</para>
  <para style="q" vid="ISA 48:1">vos shvern baim nomen Hashem,</para>
  <para style="q" vid="ISA 48:1">un Elokei Yisroel dermonen zei –</para>
  <para style="q" vid="ISA 48:1">nisht mit emes, un nisht mit gerechtikeit.<verse eid="ISA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 48:2" />vorem oif der heiliker shtot rufn zei zich,</para>
  <para style="q" vid="ISA 48:2">un oif Elokei Yisroel lenen zei zich,</para>
  <para style="q" vid="ISA 48:2">vos Hashem Tseva'ot iz zain nomen.<verse eid="ISA 48:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 48:3" />dos frierdike hob ich fun a mol ongezogt,</para>
  <para style="q" vid="ISA 48:3">un fun moil iz es arois,</para>
  <para style="q" vid="ISA 48:3">un ich hob es gelozt hern;</para>
  <para style="q" vid="ISA 48:3">plutsem hob ich geton, un es iz geshen.<verse eid="ISA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 48:4" />vail ich hob gevust az hart bistu,</para>
  <para style="q" vid="ISA 48:4">un an aizerner oder iz dain nakn,</para>
  <para style="q" vid="ISA 48:4">un dain shtern iz kuper;<verse eid="ISA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 48:5" />derum hob ich dir ongezogt fun a mol,</para>
  <para style="q" vid="ISA 48:5">eider es iz gekumen, hob ich dich gelozt hern;</para>
  <para style="q" vid="ISA 48:5">kedei zolst nisht zogn: main gets hot es geton,</para>
  <para style="q" vid="ISA 48:5">un main geshnitst un main gegosn bild hot es bafoiln.<verse eid="ISA 48:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 48:6" />host gehert, ze, al dos dozike,</para>
  <para style="q" vid="ISA 48:6">un ir vet es doch tsugebn;</para>
  <para style="q" vid="ISA 48:6">ich hob dich gelozt hern naisn atsund,</para>
  <para style="q" vid="ISA 48:6">un farborgns vos du host nisht gevust.<verse eid="ISA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 48:7" />atsund iz es bashafn gevorn, un nisht fun a mol,</para>
  <para style="q" vid="ISA 48:7">un a tog frier hostu fun dem nisht gehert;</para>
  <para style="q" vid="ISA 48:7">kedei zolst nisht zogn: ze, ich hob es gevust.<verse eid="ISA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 48:8" />nisht tsu mol gehert hostu, nisht tsu mol gevust hostu,</para>
  <para style="q" vid="ISA 48:8">nisht tsu mol geefent hot zich dain oier fun a mol;</para>
  <para style="q" vid="ISA 48:8">vorem ich hob gevust az felshn vestu felshn,</para>
  <para style="q" vid="ISA 48:8">un farbrecher fun muterlaib hot men dich gerufn.<verse eid="ISA 48:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 48:9" />fun main nomen vegen vel ich ainhaltn main tsorn,</para>
  <para style="q" vid="ISA 48:9">fun main loib vegen vel ich mich tsamen kegen dir,</para>
  <para style="q" vid="ISA 48:9">kedei dich nisht tsu farshnaidn.<verse eid="ISA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 48:10" />ze, ich hob dich gelaitert, ober nisht vi zilber,</para>
  <para style="q" vid="ISA 48:10">ich hob dich gepruvet in shmeltsoivn fun pain.<verse eid="ISA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 48:11" />fun mainet vegen, fun mainet vegen vel ich ton;</para>
  <para style="q" vid="ISA 48:11">vorem vi zol main nomen farshvecht vern?</para>
  <para style="q" vid="ISA 48:11">un main koved vel ich kein andern nisht gebn.<verse eid="ISA 48:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 48:12" />her mir tsu, Yaakov,</para>
  <para style="q" vid="ISA 48:12">un Yisroel main gerufener:</para>
  <para style="q" vid="ISA 48:12">ich bin dos; ich bin der ershter,</para>
  <para style="q" vid="ISA 48:12">ich bin oich der letster.<verse eid="ISA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 48:13" />yo, main hant hot gegruntfest di erd,</para>
  <para style="q" vid="ISA 48:13">un main rechte hot oisgeshpreit di himlen;</para>
  <para style="q" vid="ISA 48:13">ich ruf tsu zei,</para>
  <para style="q" vid="ISA 48:13">shteln zei zich oif in einem.<verse eid="ISA 48:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 48:14" />zamlt aich ain, ir ale, un hert:</para>
  <para style="q" vid="ISA 48:14">ver tsvishn zei hot faroisgezogt dos dozike?</para>
  <para style="q" vid="ISA 48:14">der vos Hashem hot im lib, vet ton zain bager in Bavel,</para>
  <para style="q" vid="ISA 48:14">un zain orem vet zain oif di Kasdim.<verse eid="ISA 48:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 48:15" />ich, ich hob geredt, un hob im gerufn,</para>
  <para style="q" vid="ISA 48:15">im gebracht, un er vet baglikn oif zain veg.<verse eid="ISA 48:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 48:16" />genent tsu mir, hert dos tsu:</para>
  <para style="q" vid="ISA 48:16">fun onheib on hob ich nisht in farborgenish geredt,</para>
  <para style="q" vid="ISA 48:16">fun zint es geshet bin ich derbai;</para>
  <para style="q" vid="ISA 48:16">un atsund hot Adonoi Hashem mich geshikt mit zain gaist.<verse eid="ISA 48:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 48:17" />azoi hot gezogt Hashem dain oisleizer,</para>
  <para style="q" vid="ISA 48:17">der heiliker fun Yisroel.</para>
  <para style="q" vid="ISA 48:17">ich, Hashem dain G-t, lern dich tsu nuts,</para>
  <para style="q" vid="ISA 48:17">fir dich oif dem veg vos du zolst gein.<verse eid="ISA 48:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 48:18" />halevay volstu farnumen maine gebot,</para>
  <para style="q" vid="ISA 48:18">volt geven vi a taich dain sholem,</para>
  <para style="q" vid="ISA 48:18">un dain hilf vi di indn fun yam;<verse eid="ISA 48:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 48:19" />un geven vi zamd volt dain zomen,</para>
  <para style="q" vid="ISA 48:19">un di shprotsn fun dain laib vi zaine kerner;</para>
  <para style="q" vid="ISA 48:19">nisht farshnitn un nisht fartilikt</para>
  <para style="q" vid="ISA 48:19">volt vern zain nomen fun far mir.<verse eid="ISA 48:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 48:20" />geit arois fun Bavel,</para>
  <para style="q" vid="ISA 48:20">antloift fun di Kasdim,</para>
  <para style="q" vid="ISA 48:20">mit a kol fun gezang;</para>
  <para style="q" vid="ISA 48:20">zogt on, macht dos hern,</para>
  <para style="q" vid="ISA 48:20">trogt es funander biz tsum ek fun der erd;</para>
  <para style="q" vid="ISA 48:20">zogt: Hashem hot oisgeleizt Yaakov zain knecht.<verse eid="ISA 48:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 48:21" />un zei hobn nisht gedorsht</para>
  <para style="q" vid="ISA 48:21">ven er hot zei durch vistenishn gefirt;</para>
  <para style="q" vid="ISA 48:21">vaser fun feldz hot er gemacht rinen far zei;</para>
  <para style="q" vid="ISA 48:21">yo, a feldz hot er geshpoltn,</para>
  <para style="q" vid="ISA 48:21">un vaser hot geflosn.<verse eid="ISA 48:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 48:22" />nishto kein sholem, zogt Hashem,</para>
  <para style="q" vid="ISA 48:22">far di reshoim.<verse eid="ISA 48:22" /></para>
  <chapter eid="ISA 48" />
  <chapter number="49" style="c" pubnumber="מט" sid="ISA 49" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 49:1" />hert mir tsu, ir indzelen,</para>
  <para style="q" vid="ISA 49:1">un farnemt, ir felker fun der vait:</para>
  <para style="q" vid="ISA 49:1">Hashem hot mich fun tracht gerufn,</para>
  <para style="q" vid="ISA 49:1">fun main muters laib hot er main nomen dermont.<verse eid="ISA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 49:2" />un er hot gemacht main moil vi a sharfe shverd,</para>
  <para style="q" vid="ISA 49:2">in shotn fun zain hant hot er mich bahaltn;</para>
  <para style="q" vid="ISA 49:2">un er hot mich gemacht far a blanker fail,</para>
  <para style="q" vid="ISA 49:2">in zain failbaitl hot er mich farborgen.<verse eid="ISA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 49:3" />un er hot tsu mir gezogt: main knecht bistu, o Yisroel,</para>
  <para style="q" vid="ISA 49:3">vos ich rim zich mit dir.<verse eid="ISA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 49:4" />un ich hob gevest gezogt: umnisht hob ich mich gemit,</para>
  <para style="q" vid="ISA 49:4">oif nisht un nivets hob ich main koiech farlendt;</para>
  <para style="q" vid="ISA 49:4">ober main mishpot iz bai Hashem,</para>
  <para style="q" vid="ISA 49:4">un main loin bai main G-t.<verse eid="ISA 49:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 49:5" />un atsund hot Hashem gezogt –</para>
  <para style="q" vid="ISA 49:5">der vos hot mich gefuremt fun tracht</para>
  <para style="q" vid="ISA 49:5">far a knecht tsu im –</para>
  <para style="q" vid="ISA 49:5">umtsukeren tsu zich Yaakov,</para>
  <para style="q" vid="ISA 49:5">un Yisroel zol aingezamlt vern tsu im;</para>
  <para style="q" vid="ISA 49:5">un ich bin geert in di oign fun Hashem,</para>
  <para style="q" vid="ISA 49:5">un main G-t iz main shtarkeit.<verse eid="ISA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 49:6" />un er hot gezogt:</para>
  <para style="q" vid="ISA 49:6">knap iz – vail du bist main knecht –</para>
  <para style="q" vid="ISA 49:6">oiftsurichtn di shtamen fun Yaakov,</para>
  <para style="q" vid="ISA 49:6">un di tsvaign fun Yisroel umtsukeren;</para>
  <para style="q" vid="ISA 49:6">nor ich vel dich machn far a licht fun di felker.</para>
  <para style="q" vid="ISA 49:6">az main hilf zol zain biz tsum ek fun der erd.<verse eid="ISA 49:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 49:7" />azoi hot Hashem gezogt,</para>
  <para style="q" vid="ISA 49:7">der oisleizer fun Yisroel, un zain heiliker,</para>
  <para style="q" vid="ISA 49:7">tsu dem vos iz farachtet in zain nefesh,</para>
  <para style="q" vid="ISA 49:7">tsu dem farumverdiktn fun felker,</para>
  <para style="q" vid="ISA 49:7">tsu dem knecht fun geveltiker:</para>
  <para style="q" vid="ISA 49:7">mlochim veln zen un veln oifshtein,</para>
  <para style="q" vid="ISA 49:7">srores – un veln zich bukn,</para>
  <para style="q" vid="ISA 49:7">fun vegen Hashem vos iz getrai,</para>
  <para style="q" vid="ISA 49:7">dem heilikn fun Yisroel vos hot dich oisderveilt.<verse eid="ISA 49:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 49:8" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="ISA 49:8">in tsait fun bavilikung tu ich dir entfern,</para>
  <para style="q" vid="ISA 49:8">un in tog fun yeshue tu ich dich helfn;</para>
  <para style="q" vid="ISA 49:8">un ich vel dich hitn,</para>
  <para style="q" vid="ISA 49:8">un dich machn far a bris tsu di umes,</para>
  <para style="q" vid="ISA 49:8">kedei du zolst oifrichtn dos land,</para>
  <para style="q" vid="ISA 49:8">az du zolst zei machn yarshenen di viste nachlut;<verse eid="ISA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 49:9" />tsu zogn tsu di gefangene: geit arois!</para>
  <para style="q" vid="ISA 49:9">tsu di vos in fintsternish: antplekt aich!</para>
  <para style="q" vid="ISA 49:9">bai di vegen veln zei zich fitern,</para>
  <para style="q" vid="ISA 49:9">un oif ale hoiche erter vet zain zeyer fiterung.<verse eid="ISA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 49:10" />zei veln nisht hungern un nisht dorshtn,</para>
  <para style="q" vid="ISA 49:10">un nisht plogn vet zei hits un zun,</para>
  <para style="q" vid="ISA 49:10">vorem zeyer derbaremer vet zei baleitn,</para>
  <para style="q" vid="ISA 49:10">un bai kvaln vaser vet er zei firn.<verse eid="ISA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 49:11" />un ich vel machn ale maine berg far a veg,</para>
  <para style="q" vid="ISA 49:11">un maine shtegn veln derheicht vern.<verse eid="ISA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 49:12" />ze, di veln kumen fun der vaitn,</para>
  <para style="q" vid="ISA 49:12">un ze, yene fun tsofn un fun mayrev,</para>
  <para style="q" vid="ISA 49:12">un di, fun land Sinim.<verse eid="ISA 49:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 49:13" />zingt, ir himlen, un frei zich, du erd,</para>
  <para style="q" vid="ISA 49:13">un brecht ois, ir berg, in gezang,</para>
  <para style="q" vid="ISA 49:13">vorem Hashem hot getreist zain folk,</para>
  <para style="q" vid="ISA 49:13">un zaine orime tut er derbaremen.<verse eid="ISA 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 49:14" />un Tsiyon hot gezogt: farlozen hot mich Hashem,</para>
  <para style="q" vid="ISA 49:14">un Adonoi hot fargesen on mir.<verse eid="ISA 49:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 49:15" />ken a froi fargesen ir brustkind,</para>
  <para style="q" vid="ISA 49:15">nisht tsu derbaremen dem zun fun ir laib?</para>
  <para style="q" vid="ISA 49:15">afile di dozike zoln fargesen,</para>
  <para style="q" vid="ISA 49:15">vel ich on dir nisht fargesen.<verse eid="ISA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 49:16" />ze, oif di hantflechn hob ich dich oisgekritst,</para>
  <para style="q" vid="ISA 49:16">daine moiern zainen tamid far mir.<verse eid="ISA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 49:17" />ailik kumen daine kinder;</para>
  <para style="q" vid="ISA 49:17">daine tseshterer un daine farvister</para>
  <para style="q" vid="ISA 49:17">veln arois fun dir.<verse eid="ISA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 49:18" />heib oif rund arum daine oign, un ze:</para>
  <para style="q" vid="ISA 49:18">zei ale zainen aingezamlt, un kumen tsu dir.</para>
  <para style="q" vid="ISA 49:18">azoi vi ich leb, zogt Hashem,</para>
  <para style="q" vid="ISA 49:18">az zei ale vestu vi a tsirung onton,</para>
  <para style="q" vid="ISA 49:18">un vest zei onknipn azoi vi a kale;<verse eid="ISA 49:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ISA 49:19" />vorem daine churves un daine vistenishn,</para>
  <para style="q" vid="ISA 49:19">un dain land dos tseshterte –</para>
  <para style="q" vid="ISA 49:19">far vor, vest atsund eng zain fun voiner,</para>
  <para style="q" vid="ISA 49:19">un dervaitert veln zain daine umbrenger.<verse eid="ISA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 49:20" />zogn veln noch in daine oiern</para>
  <para style="q" vid="ISA 49:20">daine ongevorene kinder:</para>
  <para style="q" vid="ISA 49:20">eng iz mir der ort,</para>
  <para style="q" vid="ISA 49:20">tret mir op, ich zol kenen voinen.<verse eid="ISA 49:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 49:21" />un vest zogn in dain hartsn:</para>
  <para style="q" vid="ISA 49:21">ver hot mir di dozike geborn?</para>
  <para style="q" vid="ISA 49:21">ich bin geven on kinder un akore,</para>
  <para style="q" vid="ISA 49:21">fartriben un farvogelt;</para>
  <para style="q" vid="ISA 49:21">un di dozike ver hot oifgetsoign?</para>
  <para style="q" vid="ISA 49:21">ze, ich bin doch geblibn alein,</para>
  <para style="q" vid="ISA 49:21">di dozike vu zainen geven?<verse eid="ISA 49:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 49:22" />azoi hot gezogt Adonoi Hashem:</para>
  <para style="q" vid="ISA 49:22">ze, ich vel oifheibn tsu di felker main hant,</para>
  <para style="q" vid="ISA 49:22">un tsu di umes vel ich oifshteln main fon,</para>
  <para style="q" vid="ISA 49:22">un zei veln brengen daine zin in buzem,</para>
  <para style="q" vid="ISA 49:22">un daine techter veln oifn aksl getrogn vern.<verse eid="ISA 49:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 49:23" />un mlochim veln zain daine dertsier,</para>
  <para style="q" vid="ISA 49:23">un zeyer sroretes daine nas nianie;</para>
  <para style="q" vid="ISA 49:23">mitn ponem tsu der erd veln zei zich bukn tsu dir,</para>
  <para style="q" vid="ISA 49:23">un dem shtoib fun daine fis veln zei lekn;</para>
  <para style="q" vid="ISA 49:23">un vest visen az ich bin Hashem,</para>
  <para style="q" vid="ISA 49:23">vos nisht farshemt vern di vos hofn tsu mir.<verse eid="ISA 49:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 49:24" />vert avekgenumen fun dem gibor der roib,</para>
  <para style="q" vid="ISA 49:24">tsi vert der fang fun dem ziger antrunen?<verse eid="ISA 49:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 49:25" />far vor, azoi zogt Hashem:</para>
  <para style="q" vid="ISA 49:25">afile der fang fun dem gibor zol avekgenumen vern,</para>
  <para style="q" vid="ISA 49:25">un der roib fun dem shtarkn zol antrunen vern,</para>
  <para style="q" vid="ISA 49:25">ober mit daine kriger vel ich krign,</para>
  <para style="q" vid="ISA 49:25">un daine kinder vel ich helfn.<verse eid="ISA 49:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 49:26" />un ich vel machn esen daine driker zeyer fleish,</para>
  <para style="q" vid="ISA 49:26">un vi troibnzaft veln zei zeyer blut shikurn;</para>
  <para style="q" vid="ISA 49:26">un ale laiber veln visen az ich Hashem bin dain helfer,</para>
  <para style="q" vid="ISA 49:26">un dain oisleizer goel iz der machtiker fun Yaakov.<verse eid="ISA 49:26" /></para>
  <chapter eid="ISA 49" />
  <chapter number="50" style="c" pubnumber="נ" sid="ISA 50" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 50:1" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="ISA 50:1">vu iz der get fun aier muter,</para>
  <para style="q" vid="ISA 50:1">az ich hob zi avekgeshikt?</para>
  <para style="q" vid="ISA 50:1">oder ver iz fun maine moner,</para>
  <para style="q" vid="ISA 50:1">vos ich hob aich farkoift tsu im?</para>
  <para style="q" vid="ISA 50:1">zet, iber aiere zind zait ir farkoift gevorn,</para>
  <para style="q" vid="ISA 50:1">un iber aiere farbrechn iz aier muter avekgeshikt gevorn.<verse eid="ISA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 50:2" />far vos bin ich gekumen, un kein mentsh iz nisht geven?</para>
  <para style="q" vid="ISA 50:2">gerufn, un keiner hot nisht geentfert?</para>
  <para style="q" vid="ISA 50:2">iz den kurts main hant oistsuleizn,</para>
  <para style="q" vid="ISA 50:2">tsi nishto kein koiech in mir, aich matsl tsu zain?</para>
  <para style="q" vid="ISA 50:2">zet, mit main ongeshrei trikn ich ois dem yam.</para>
  <para style="q" vid="ISA 50:2">ich mach fun taichn a midber;</para>
  <para style="q" vid="ISA 50:2">zeyere fish vern dumpik on vaser,</para>
  <para style="q" vid="ISA 50:2">un shtarbn fun dorshtikeit.<verse eid="ISA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 50:3" />ich kleid di himlen in shvartskeit,</para>
  <para style="q" vid="ISA 50:3">un mach zak zeyer tsudek.<verse eid="ISA 50:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 50:4" />Adonoi Hashem hot mir gegebn</para>
  <para style="q" vid="ISA 50:4">a tsung fun gelernte,</para>
  <para style="q" vid="ISA 50:4">tsu visen tsu helfn dem midn mit a vort;</para>
  <para style="q" vid="ISA 50:4">er vekt frimorgn in frimorgn,</para>
  <para style="q" vid="ISA 50:4">er vekt mir dos oier,</para>
  <para style="q" vid="ISA 50:4">tsu hern azoi vi di gelernte.<verse eid="ISA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 50:5" />Adonoi Hashem hot mir geefent dos oier,</para>
  <para style="q" vid="ISA 50:5">un ich hob nisht vidershpenikt,</para>
  <para style="q" vid="ISA 50:5">nisht opgetretn ahinter.<verse eid="ISA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 50:6" />main rukn hob ich gegebn tsu di shleger,</para>
  <para style="q" vid="ISA 50:6">un maine bakn tsu di vos reisn ois dem bart;</para>
  <para style="q" vid="ISA 50:6">ich hob nisht farborgen main ponem</para>
  <para style="q" vid="ISA 50:6">fun shandn un shpaiechts.<verse eid="ISA 50:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 50:7" />ober Adonoi Hashem vet mir helfn,</para>
  <para style="q" vid="ISA 50:7">derum bin ich nisht farshemt;</para>
  <para style="q" vid="ISA 50:7">derum hob ich gemacht main ponem vi kizl,</para>
  <para style="q" vid="ISA 50:7">un ich veis az ich vel nisht in biesh blaibn.<verse eid="ISA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 50:8" />nont iz main gerechtgeber;</para>
  <para style="q" vid="ISA 50:8">ver vil zich lodn mit mir?</para>
  <para style="q" vid="ISA 50:8">lomir zich shteln bainand;</para>
  <para style="q" vid="ISA 50:8">ver iz main baal-din?</para>
  <para style="q" vid="ISA 50:8">zol er genenen tsu mir.<verse eid="ISA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 50:9" />ze, Adonoi Hashem vet mir helfn;</para>
  <para style="q" vid="ISA 50:9">ver iz der vos vet mich umgerecht machn?</para>
  <para style="q" vid="ISA 50:9">ze, zei ale veln vi a beged tsefaln,</para>
  <para style="q" vid="ISA 50:9">moil vet zei oifesn.<verse eid="ISA 50:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 50:10" />ver iz tsvishn aich vos hot moire far Hashem,</para>
  <para style="q" vid="ISA 50:10">vos hert tsu dem kol fun zain knecht?</para>
  <para style="q" vid="ISA 50:10">vos iz gegangen in fintsternish,</para>
  <para style="q" vid="ISA 50:10">un hot kein licht nisht gehat?</para>
  <para style="q" vid="ISA 50:10">zol er zich farzichern oif dem nomen fun Hashem,</para>
  <para style="q" vid="ISA 50:10">un zich onlenen oif zain G-t.<verse eid="ISA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 50:11" />ot ir ale vos tsindt on a faier,</para>
  <para style="q" vid="ISA 50:11">vos gurt on funken –</para>
  <para style="q" vid="ISA 50:11">geit in der flam fun aier faier,</para>
  <para style="q" vid="ISA 50:11">un in di funken vos ir hot ongetsundn!</para>
  <para style="q" vid="ISA 50:11">fun main hant geshet dos aich,</para>
  <para style="q" vid="ISA 50:11">in veitog vet ir lign.<verse eid="ISA 50:11" /></para>
  <chapter eid="ISA 50" />
  <chapter number="51" style="c" pubnumber="נא" sid="ISA 51" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 51:1" />hert mir tsu, ir vos yogt zich noch gerechtikeit,</para>
  <para style="q" vid="ISA 51:1">ir vos zucht Hashem:</para>
  <para style="q" vid="ISA 51:1">kukt oif dem feldz fun vanen ir zait oisgehakt,</para>
  <para style="q" vid="ISA 51:1">un oif der brunemgrub fun vanen ir zait oisgegrobn;<verse eid="ISA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 51:2" />kukt oif Avraham aier foter,</para>
  <para style="q" vid="ISA 51:2">un oif Sarahn vos hot aich geborn;</para>
  <para style="q" vid="ISA 51:2">hagam einer, hob ich im gerufn,</para>
  <para style="q" vid="ISA 51:2">kedei ich zol im bentshn, un zol im mern.<verse eid="ISA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 51:3" />far vor, Hashem tut treistn Tsiyon,</para>
  <para style="q" vid="ISA 51:3">er treist ale ire churves;</para>
  <para style="q" vid="ISA 51:3">er vet machn ire midber azoi vi Eden,</para>
  <para style="q" vid="ISA 51:3">un ire viste erter azoi vi dem gortn fun Hashem,</para>
  <para style="q" vid="ISA 51:3">freid un simche vet in ir gefunen vern,</para>
  <para style="q" vid="ISA 51:3">loib un a kol fun gezang.<verse eid="ISA 51:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 51:4" />horcht tsu mir, main folk,</para>
  <para style="q" vid="ISA 51:4">un farnemt tsu mir, main ume,</para>
  <para style="q" vid="ISA 51:4">vorem a toyre vet aroisgein fun mir,</para>
  <para style="q" vid="ISA 51:4">un main mishpot vel ich tsum licht fun di felker aroislozn.<verse eid="ISA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 51:5" />nont iz main gerechtikeit,</para>
  <para style="q" vid="ISA 51:5">arois iz main hilf,</para>
  <para style="q" vid="ISA 51:5">un maine orems veln mishpetn di felker;</para>
  <para style="q" vid="ISA 51:5">di indzelen veln hofn oif mir,</para>
  <para style="q" vid="ISA 51:5">un oif main orem veln zei hofn.<verse eid="ISA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 51:6" />heibt oif tsu di himlen aiere oign,</para>
  <para style="q" vid="ISA 51:6">un kukt oif der erd fun unten,</para>
  <para style="q" vid="ISA 51:6">vorem di himlen vern vi roich tsekrochn,</para>
  <para style="q" vid="ISA 51:6">un di erd vet vi a beged tsefaln,</para>
  <para style="q" vid="ISA 51:6">un ire bavoiner veln vi umgetsifer shtarbn;</para>
  <para style="q" vid="ISA 51:6">ober main hilf vet zain eibik,</para>
  <para style="q" vid="ISA 51:6">un main gerechtikeit vet nisht opgebrachn vern.<verse eid="ISA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 51:7" />hert mir tsu, ir vos veist gerechtikeit,</para>
  <para style="q" vid="ISA 51:7">dos folk vos main toyre iz in zeyer hartsn:</para>
  <para style="q" vid="ISA 51:7">ir zolt nisht moire hobn faran shmach fun mentshn,</para>
  <para style="q" vid="ISA 51:7">un far zeyere lesterungen zolt ir nisht angstn.<verse eid="ISA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 51:8" />vorem azoi vi a beged vet zei moil oifesn,</para>
  <para style="q" vid="ISA 51:8">un azoi vi vol vet zei der vorem oifesn,</para>
  <para style="q" vid="ISA 51:8">ober main gerechtikeit vet zain eibik,</para>
  <para style="q" vid="ISA 51:8">un main hilf oif dor-doires.<verse eid="ISA 51:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 51:9" />dervek dich, dervek dich,</para>
  <para style="q" vid="ISA 51:9">bakleid dich mit shtarkeit, du orem fun Hashem;</para>
  <para style="q" vid="ISA 51:9">dervek dich vi in di teg fun a mol,</para>
  <para style="q" vid="ISA 51:9">in di doires fun fartsaitn.</para>
  <para style="q" vid="ISA 51:9">bistu nisht der vos hot tsehakt rahav,</para>
  <para style="q" vid="ISA 51:9">vos hot araingeshtochn di shlang?<verse eid="ISA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 51:10" />bistu nisht der vos hot oisgetriknt dem yam,</para>
  <para style="q" vid="ISA 51:10">di vasern fun dem tehom dem groisn;</para>
  <para style="q" vid="ISA 51:10">vos hot gemacht di tifenishn fun yam far a veg,</para>
  <para style="q" vid="ISA 51:10">far di oisgeleizte aribertsugein?<verse eid="ISA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 51:11" />un di derleizte fun Hashem zoln zich umkeren,</para>
  <para style="q" vid="ISA 51:11">un kumen kein Tsiyon mit gezang,</para>
  <para style="q" vid="ISA 51:11">un an eibike simche zol zain oif zeyer kop;</para>
  <para style="q" vid="ISA 51:11">sason-usimchh zol zei onyogn,</para>
  <para style="q" vid="ISA 51:11">antloifn zoln troier un ziftsenish.<verse eid="ISA 51:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 51:12" />ich, ich bin aier treister;</para>
  <para style="q" vid="ISA 51:12">ver bistu, zolst moire hobn far a mentshn vos shtarbt,</para>
  <para style="q" vid="ISA 51:12">un far a mentshnkind vos vert tsu groz gemacht?<verse eid="ISA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 51:13" />un host fargesen on Hashem dain Bashefer,</para>
  <para style="q" vid="ISA 51:13">vos hot oisgeshpreit di himlen,</para>
  <para style="q" vid="ISA 51:13">un gegruntfest di erd;</para>
  <para style="q" vid="ISA 51:13">un host geangst nochanand a gantsn tog</para>
  <para style="q" vid="ISA 51:13">faran grimtsorn fun dem driker,</para>
  <para style="q" vid="ISA 51:13">vi er hot zich ongebreit umtsubrengen;</para>
  <para style="q" vid="ISA 51:13">ober vu iz der grimtsorn fun dem driker?<verse eid="ISA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 51:14" />gich vert der gefangener opgebundn,</para>
  <para style="q" vid="ISA 51:14">un er vet nisht shtarbn in grub,</para>
  <para style="q" vid="ISA 51:14">un nisht geminert vern vet zain broit.<verse eid="ISA 51:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 51:15" />vorem ich bin Hashem dain G-t,</para>
  <para style="q" vid="ISA 51:15">vos tserudert dem yam, un zaine indn brumen,</para>
  <para style="q" vid="ISA 51:15">vos Hashem Tseva'ot iz zain nomen.<verse eid="ISA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 51:16" />un ich hob araingeton maine verter in dain moil,</para>
  <para style="q" vid="ISA 51:16">un mitn shotn fun main hant hob ich dich tsugedekt,</para>
  <para style="q" vid="ISA 51:16">kedei tsu flantsn di himlen, un tsu gruntfestn di erd,</para>
  <para style="q" vid="ISA 51:16">un zogn tsu Tsiyon: main folk bistu.<verse eid="ISA 51:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 51:17" />dervek dich, dervek dich, shtei oif, Yerushalayim,</para>
  <para style="q" vid="ISA 51:17">du vos host getrunken fun Hashems hant</para>
  <para style="q" vid="ISA 51:17">dem kos fun zain grimtsorn; dem becher,</para>
  <para style="q" vid="ISA 51:17">dem kos fun fartumlenish, getrunken un oisgezoign.<verse eid="ISA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 51:18" />nishto ver zol zi firn,</para>
  <para style="q" vid="ISA 51:18">fun ale zin vos zi hot geborn,</para>
  <para style="q" vid="ISA 51:18">un nishto ver zol haltn ir hant,</para>
  <para style="q" vid="ISA 51:18">fun ale zin vos zi hot oifgetsoign.<verse eid="ISA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 51:19" />di beide hobn dich getrofn –</para>
  <para style="q" vid="ISA 51:19">ver ken dich baklogn?</para>
  <para style="q" vid="ISA 51:19">farvistung un broch, un hunger un shverd –</para>
  <para style="q" vid="ISA 51:19">vi ken ich dich treistn?<verse eid="ISA 51:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 51:20" />daine zin lign gechlshte in ale ek gasn,</para>
  <para style="q" vid="ISA 51:20">vi a vildtsig in nets;</para>
  <para style="q" vid="ISA 51:20">ful mit dem grimtsorn fun Hashem,</para>
  <para style="q" vid="ISA 51:20">mit dem ongeshrei fun dain G-t.<verse eid="ISA 51:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 51:21" />derum her nor tsu dos dozike, du orime,</para>
  <para style="q" vid="ISA 51:21">un farshikurte, ober nisht fun vain;<verse eid="ISA 51:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 51:22" />azoi hot gezogt dain har Hashem,</para>
  <para style="q" vid="ISA 51:22">un dain G-t vos nemt zich on far zain folk:</para>
  <para style="q" vid="ISA 51:22">ze, ich hob avekgenumen fun dain hant</para>
  <para style="q" vid="ISA 51:22">dem kos fun fartumlenish,</para>
  <para style="q" vid="ISA 51:22">dem becher, dem kos fun main grimtsorn;</para>
  <para style="q" vid="ISA 51:22">vest im mer vider nisht trinken.<verse eid="ISA 51:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 51:23" />un ich vel im arainton in der hant fun daine veituer,</para>
  <para style="q" vid="ISA 51:23">vos hobn gezogt tsu dain zel:</para>
  <para style="q" vid="ISA 51:23">beig zich ain, mir zoln aribergein;</para>
  <para style="q" vid="ISA 51:23">un host gemacht vi di erd dain rukn,</para>
  <para style="q" vid="ISA 51:23">un vi di gas far aribergeyer.<verse eid="ISA 51:23" /></para>
  <chapter eid="ISA 51" />
  <chapter number="52" style="c" pubnumber="נב" sid="ISA 52" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 52:1" />dervek dich, dervek dich,</para>
  <para style="q" vid="ISA 52:1">tu on dain shtarkeit, Tsiyon;</para>
  <para style="q" vid="ISA 52:1">tu on daine prachtike begadim,</para>
  <para style="q" vid="ISA 52:1">Yerushalayim, du heilike shtot;</para>
  <para style="q" vid="ISA 52:1">vorem mer vider vet nisht kumen in dir</para>
  <para style="q" vid="ISA 52:1">kein arel un kein tome.<verse eid="ISA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 52:2" />shokl dich op fun shtoib,</para>
  <para style="q" vid="ISA 52:2">heib dich oif, zets dich, Yerushalayim;</para>
  <para style="q" vid="ISA 52:2">mach dir loiz di bindshtrik fun dain haldz,</para>
  <para style="q" vid="ISA 52:2">gefangene tochter Tsiyon.<verse eid="ISA 52:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3" />vorem azoi hot Hashem gezogt: umzist zait ir farkoift gevorn, un nisht far gelt vet ir oisgeleizt vern. <verse eid="ISA 52:3" /><verse number="4" style="v" sid="ISA 52:4" />vorem azoi hot gezogt Adonoi Hashem: kein Mitsrayim hot genidert main folk tsuersht, dortn tsu voinen, un Ashur hot im far gornisht gedrikt. <verse eid="ISA 52:4" /><verse number="5" style="v" sid="ISA 52:5" />un atsund, vos hob ich do, zogt Hashem, ven main folk iz avekgenumen gevorn far umzist? zaine geveltiker rimen zich, zogt Hashem, un tamid a gantsn tog vert main nomen gelestert. <verse eid="ISA 52:5" /><verse number="6" style="v" sid="ISA 52:6" />derum vet main folk gevor vern main nomen; far vor, in yenem tog – az ich bin der vos redt; do bin ich.<verse eid="ISA 52:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 52:7" />vi shein zainen oif di berg di fis fun dem mevaser</para>
  <para style="q" vid="ISA 52:7">vos lozt hern sholem, vos iz mevaser gutem,</para>
  <para style="q" vid="ISA 52:7">vos lozt hern hilf:</para>
  <para style="q" vid="ISA 52:7">vos zogt tsu Tsiyon: dain G-t tut kinign.<verse eid="ISA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 52:8" />horch! daine vechter heibn oif zeyer kol,</para>
  <para style="q" vid="ISA 52:8">zei zingen in einem,</para>
  <para style="q" vid="ISA 52:8">vorem oig in oig zeen zei</para>
  <para style="q" vid="ISA 52:8">vi Hashem kert zich um kein Tsiyon.<verse eid="ISA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 52:9" />brecht ois, zingt in einem,</para>
  <para style="q" vid="ISA 52:9">ir churves fun Yerushalayim,</para>
  <para style="q" vid="ISA 52:9">vorem Hashem hot getreist zain folk,</para>
  <para style="q" vid="ISA 52:9">er hot oisgeleizt Yerushalayim.<verse eid="ISA 52:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 52:10" />Hashem hot antbloizt zain heilikn orem</para>
  <para style="q" vid="ISA 52:10">far di oign fun ale felker,</para>
  <para style="q" vid="ISA 52:10">un ale ekn fun der erd</para>
  <para style="q" vid="ISA 52:10">veln zen di yeshue fun Elokeinu.<verse eid="ISA 52:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 52:11" />tut aich op, tut aich op, geit arois fun dortn,</para>
  <para style="q" vid="ISA 52:11">umreins zolt ir nisht onrirn;</para>
  <para style="q" vid="ISA 52:11">geit arois fun ir mit,</para>
  <para style="q" vid="ISA 52:11">reinikt aich, ir treger fun di keilim fun Hashem!<verse eid="ISA 52:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 52:12" />far vor, nisht in ailenish vet ir arois,</para>
  <para style="q" vid="ISA 52:12">un nisht in gelaf vet ir gein;</para>
  <para style="q" vid="ISA 52:12">vorem aich farois geit Hashem,</para>
  <para style="q" vid="ISA 52:12">un aich nochbaleit Elokei Yisroel.<verse eid="ISA 52:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 52:13" />ze, baglikn vet main knecht,</para>
  <para style="q" vid="ISA 52:13">er vet zain derhoibenem un zain zeyer hoich.<verse eid="ISA 52:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 52:14" />azoi vi fil hobn gegaft oif dir –</para>
  <para style="q" vid="ISA 52:14">azoi farkriplt, nisht fun a mentshn iz geven zain oiszen,</para>
  <para style="q" vid="ISA 52:14">un zain geshtalt nisht fun mentshnkinder –<verse eid="ISA 52:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 52:15" />azoi vet er bashprenklen fil felker,</para>
  <para style="q" vid="ISA 52:15">mlochim veln tsumachn zeyer moil far im;</para>
  <para style="q" vid="ISA 52:15">vorem vos zei iz nisht dertseilt gevorn,</para>
  <para style="q" vid="ISA 52:15">veln zei zen,</para>
  <para style="q" vid="ISA 52:15">un vos zei hobn nisht gehert</para>
  <para style="q" vid="ISA 52:15">veln zei onkukn.<verse eid="ISA 52:15" /></para>
  <chapter eid="ISA 52" />
  <chapter number="53" style="c" pubnumber="נג" sid="ISA 53" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 53:1" />ver volt gegloibt vos mir hobn gehert?</para>
  <para style="q" vid="ISA 53:1">un der orem fun Hashem hot zich oif vemen antplekt?<verse eid="ISA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 53:2" />vorem er iz oifgegangen vi a shprots glaich aroif,</para>
  <para style="q" vid="ISA 53:2">un vi a vortsel fun trukener erd;</para>
  <para style="q" vid="ISA 53:2">er hot kein geshtalt nisht gehat un kein pracht,</para>
  <para style="q" vid="ISA 53:2">az mir zoln im onkukn,</para>
  <para style="q" vid="ISA 53:2">un kein oiszen, az mir zoln im glustn.<verse eid="ISA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 53:3" />er iz geven faracht, un farvorfen fun mentshn,</para>
  <para style="q" vid="ISA 53:3">a mentsh mit veitikn un tsu yesurim bakent,</para>
  <para style="q" vid="ISA 53:3">un vi einer vos me farborgt dem ponem fun im;</para>
  <para style="q" vid="ISA 53:3">faracht, un mir hobn im gerechnt far gornisht.<verse eid="ISA 53:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 53:4" />far vor er hot avekgetrogen undzere yesurim,</para>
  <para style="q" vid="ISA 53:4">un undzere veitikn, zei hot er getrogn,</para>
  <para style="q" vid="ISA 53:4">ober mir hobn im gerechnt als einer,</para>
  <para style="q" vid="ISA 53:4">vos iz geplegt fun Elokim un gepainiktn.<verse eid="ISA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 53:5" />un er iz araingeshtochn geven iber undzere ibertretn,</para>
  <para style="q" vid="ISA 53:5">er iz tseshtoisn gevorn vegen undzere umgerechtikeitn;</para>
  <para style="q" vid="ISA 53:5">di shtrof far undzer fridn iz geven oif im,</para>
  <para style="q" vid="ISA 53:5">un durch zaine beiln zainen mir geheilt gevorn.<verse eid="ISA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 53:6" />mir ale hobn vi shof geblondzhet,</para>
  <para style="q" vid="ISA 53:6">itlecher mentsh hot zich tsu zain veg gekert;</para>
  <para style="q" vid="ISA 53:6">un Hashem hot geplogn oif im</para>
  <para style="q" vid="ISA 53:6">di zind fun undz alemen.<verse eid="ISA 53:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 53:7" />er iz gedrikt gevorn, un er iz tsepainikt,</para>
  <para style="q" vid="ISA 53:7">un er nisht oifgemacht zain moil,</para>
  <para style="q" vid="ISA 53:7">vi a lam vos vert tsu der shechite gefirt,</para>
  <para style="q" vid="ISA 53:7">un vi a sheps vos iz shtum far ire sherer;</para>
  <para style="q" vid="ISA 53:7">yo, er nisht oifgemacht zain moil.<verse eid="ISA 53:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 53:8" />durch drikung tefish un durch shtrof iz er avekgenumen gevorn,</para>
  <para style="q" vid="ISA 53:8">un mit zain dor ver hot bamerkt?</para>
  <para style="q" vid="ISA 53:8">vorem er iz opgeshnitn gevorn</para>
  <para style="q" vid="ISA 53:8">fun land fun di lebedike,</para>
  <para style="q" vid="ISA 53:8">far dem ibertretn fun main folk.<verse eid="ISA 53:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 53:9" />un me hot gemacht mit reshoim zain keyver,</para>
  <para style="q" vid="ISA 53:9">un mitn di raiche in zain toit,</para>
  <para style="q" vid="ISA 53:9">hagam er hot kein umrecht nisht geton,</para>
  <para style="q" vid="ISA 53:9">un kein batrug iz nisht geven in zain moil.<verse eid="ISA 53:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 53:10" />ober Hashem hot im gevolt tseshtoisn,</para>
  <para style="q" vid="ISA 53:10">un hot im dertrogt yesurim;</para>
  <para style="q" vid="ISA 53:10">ven du vest machn zain neshome als a shuldopfer;</para>
  <para style="q" vid="ISA 53:10">kedei er zol zen zomen</para>
  <para style="q" vid="ISA 53:10">un derlengern zaine teg,</para>
  <para style="q" vid="ISA 53:10">un der rotsn fun Hashem durch zain hant zol gelingen.<verse eid="ISA 53:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 53:11" />fun vegen dem yesurim fun zain nefesh vet er zen un zat vern;</para>
  <para style="q" vid="ISA 53:11">durch derkentenish fun im</para>
  <para style="q" vid="ISA 53:11">vet main gerechter knecht fil gerecht machn,</para>
  <para style="q" vid="ISA 53:11">un zeyere zind vet er trogn.<verse eid="ISA 53:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 53:12" />derum vel ich im ainteiln tsvishn di groise,</para>
  <para style="q" vid="ISA 53:12">un mit machtike vet er teiln roib;</para>
  <para style="q" vid="ISA 53:12">derfar vos er hot oisgegosen tsum toit zain neshome,</para>
  <para style="q" vid="ISA 53:12">un iz mit farbrecher getseilt gevorn,</para>
  <para style="q" vid="ISA 53:12">un dem chet fun fil hot er getrogn,</para>
  <para style="q" vid="ISA 53:12">un er hot gebetn far di ibershpraizers.<verse eid="ISA 53:12" /></para>
  <chapter eid="ISA 53" />
  <chapter number="54" style="c" pubnumber="נד" sid="ISA 54" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 54:1" />zing, du akore, vos hot nisht geborn,</para>
  <para style="q" vid="ISA 54:1">brech ois in gezang un shrai ois,</para>
  <para style="q" vid="ISA 54:1">du vos host nisht geveitokt;</para>
  <para style="q" vid="ISA 54:1">vorem mer zainen di kinder fun der vister,</para>
  <para style="q" vid="ISA 54:1">vi di kinder fun der bamanter, zogt Hashem.<verse eid="ISA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 54:2" />breit ois dem ort fun dain getselt,</para>
  <para style="q" vid="ISA 54:2">un di umhangen fun daine voinungen zol men oisshtrekn;</para>
  <para style="q" vid="ISA 54:2">nisht shpor, mach lang daine shtrik,</para>
  <para style="q" vid="ISA 54:2">un daine fleklech bafestik.<verse eid="ISA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 54:3" />vorem rechts un links vestu zich shpreitn,</para>
  <para style="q" vid="ISA 54:3">un dain zomen vet arben di felker,</para>
  <para style="q" vid="ISA 54:3">un shtet farviste veln zei bazetsn.<verse eid="ISA 54:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 54:4" />zolst nisht moire hobn,</para>
  <para style="q" vid="ISA 54:4">vorem vest nisht in biesh blaibn,</para>
  <para style="q" vid="ISA 54:4">un zolst nisht farshemt zain,</para>
  <para style="q" vid="ISA 54:4">vorem vest nisht tsu shand vern.</para>
  <para style="q" vid="ISA 54:4">vorem dem biesh fun dain yugnt vestu fargesen,</para>
  <para style="q" vid="ISA 54:4">un di charpe fun dain almoneshaft vestu mer nisht dermonen.<verse eid="ISA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 54:5" />vorem dain Bashefer iz dain man,</para>
  <para style="q" vid="ISA 54:5">Hashem Tseva'ot iz zain nomen;</para>
  <para style="q" vid="ISA 54:5">un dain oisleizer iz der heiliker fun Yisroel,</para>
  <para style="q" vid="ISA 54:5">Elokim fun der gantser erd vert er gerufn.<verse eid="ISA 54:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 54:6" />vorem vi a vaib farlozen un farumert in gemit</para>
  <para style="q" vid="ISA 54:6">tut dich tsurikrufn Hashem;</para>
  <para style="q" vid="ISA 54:6">un a yugntvaib, ken zi den nems vern?</para>
  <para style="q" vid="ISA 54:6">zogt dain G-t.<verse eid="ISA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 54:7" />oif a klein rege hob ich dich farlozen,</para>
  <para style="q" vid="ISA 54:7">ober mit grois derbaremung vel ich dich ainzamlen.<verse eid="ISA 54:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 54:8" />in oisgus fun kaas</para>
  <para style="q" vid="ISA 54:8">hob ich a rege farborgen main ponem fun dir,</para>
  <para style="q" vid="ISA 54:8">ober mit eibiker genod</para>
  <para style="q" vid="ISA 54:8">tu ich dich derbaremen,</para>
  <para style="q" vid="ISA 54:8">zogt dain oisleizer, Hashem.<verse eid="ISA 54:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 54:9" />vorem dos geviser fun Noach iz dos mir:</para>
  <para style="q" vid="ISA 54:9">azoi vi ich hob geshvorn az dos geviser fun Noach</para>
  <para style="q" vid="ISA 54:9">zol mer nisht aribergein iber der erd,</para>
  <para style="q" vid="ISA 54:9">azoi hob ich geshvorn nisht tsu tserenen oif dir,</para>
  <para style="q" vid="ISA 54:9">un nisht ontsushraien oif dir.<verse eid="ISA 54:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 54:10" />vorem di berg megn zich opton,</para>
  <para style="q" vid="ISA 54:10">un di heichn megn zich vaklen,</para>
  <para style="q" vid="ISA 54:10">ober main genod vet zich fun dir nisht opton,</para>
  <para style="q" vid="ISA 54:10">un main bris fun sholem vet zich nisht vaklen,</para>
  <para style="q" vid="ISA 54:10">zogt dain derbaremer, Hashem.<verse eid="ISA 54:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 54:11" />du orime, fun shturem getribene, du nisht getreiste,</para>
  <para style="q" vid="ISA 54:11">ze, ich leig ois daine shteiner in farbn,</para>
  <para style="q" vid="ISA 54:11">un vel dich gruntfestn mit sapirshteiner.<verse eid="ISA 54:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 54:12" />un ich vel machn daine turemshpitsn fun rubin,</para>
  <para style="q" vid="ISA 54:12">un daine toiern fun garfunklshteiner,</para>
  <para style="q" vid="ISA 54:12">un dain gantsn gemark fun glustike shteiner.<verse eid="ISA 54:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 54:13" />un ale daine kinder veln zain gelernte fun Hashem;</para>
  <para style="q" vid="ISA 54:13">un grois vet zain der sholem fun daine kinder.<verse eid="ISA 54:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 54:14" />oif gerechtikeit vestu oifgeshtelt vern;</para>
  <para style="q" vid="ISA 54:14">zai vait fun drikung,</para>
  <para style="q" vid="ISA 54:14">vorem darfst nisht moire hobn,</para>
  <para style="q" vid="ISA 54:14">un fun a broch,</para>
  <para style="q" vid="ISA 54:14">vorem er vet nisht genenen tsu dir.<verse eid="ISA 54:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 54:15" />ze, zamlen meg men zich zamlen, ober on main viln;</para>
  <para style="q" vid="ISA 54:15">ver es zamlt zich oif dir, vet faln fun vegen dir.<verse eid="ISA 54:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 54:16" />ze, ich hob bashafn dem mainster,</para>
  <para style="q" vid="ISA 54:16">vos blozt in dem koilfaier,</para>
  <para style="q" vid="ISA 54:16">un brengt arois a getsaig far zain arbet;</para>
  <para style="q" vid="ISA 54:16">un ich hob bashafn dem farvister tsu tseshtern.<verse eid="ISA 54:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 54:17" />itlech getsaig vos vet gefuremt vern</para>
  <para style="q" vid="ISA 54:17">kegen dir, vet nisht gelingen,</para>
  <para style="q" vid="ISA 54:17">un itlech tsung vos vet zich shteln in mishpot mit dir,</para>
  <para style="q" vid="ISA 54:17">vestu shuldik machn.</para>
  <para style="q" vid="ISA 54:17">dos iz di arav fun di knecht fun Hashem,</para>
  <para style="q" vid="ISA 54:17">un zeyer gerechter loin fun mir, zogt Hashem.<verse eid="ISA 54:17" /></para>
  <chapter eid="ISA 54" />
  <chapter number="55" style="c" pubnumber="נה" sid="ISA 55" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 55:1" />hei, ale dorshtike, kumt noch vaser,</para>
  <para style="q" vid="ISA 55:1">tsu mol der vos hot nisht kein gelt;</para>
  <para style="q" vid="ISA 55:1">kumt shaft aich ain un est,</para>
  <para style="q" vid="ISA 55:1">un kumt shaft aich ain on gelt</para>
  <para style="q" vid="ISA 55:1">un on getsolt vain un milch.<verse eid="ISA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 55:2" />noch vos zolt ir gelt tsoln far nisht-broit?</para>
  <para style="q" vid="ISA 55:2">un aier mi far vos zetikt nisht?</para>
  <para style="q" vid="ISA 55:2">hern hert mir tsu, un est guts,</para>
  <para style="q" vid="ISA 55:2">un aier zel vet zich kvikn mit fets.<verse eid="ISA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 55:3" />naigt aier oier, un kumt tsu mir,</para>
  <para style="q" vid="ISA 55:3">hert, un aier zel vet lebn;</para>
  <para style="q" vid="ISA 55:3">un ich vel aich shlisn an eibikn bris,</para>
  <para style="q" vid="ISA 55:3">vi di getraie chasadim tsu Dovidn.<verse eid="ISA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 55:4" />ze, an eides tsu di felker hob ich im gemacht,</para>
  <para style="q" vid="ISA 55:4">a firsht un bafeler fun di umes.<verse eid="ISA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 55:5" />ze, a folk vos du kenst nisht, vestu rufn,</para>
  <para style="q" vid="ISA 55:5">un a folk vos ken dich nisht, vet loifn tsu dir,</para>
  <para style="q" vid="ISA 55:5">fun vegen Hashem dain G-t,</para>
  <para style="q" vid="ISA 55:5">un tsulib dem heilikn fun Yisroel,</para>
  <para style="q" vid="ISA 55:5">vail er hot dich basheint.<verse eid="ISA 55:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 55:6" />zucht Hashem ven er ken gefunen vern,</para>
  <para style="q" vid="ISA 55:6">ruft im ven er iz nont.<verse eid="ISA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 55:7" />zol der roshe farlozen zain veg,</para>
  <para style="q" vid="ISA 55:7">un der man fun umrecht zaine trachtungen;</para>
  <para style="q" vid="ISA 55:7">un zol er zich umkeren tsu Hashem,</para>
  <para style="q" vid="ISA 55:7">un er vet im derbaremen,</para>
  <para style="q" vid="ISA 55:7">un tsu Elokeinu, vorem er fargit a sach.<verse eid="ISA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 55:8" />vorem nisht maine trachtungen zainen aiere trachtungen,</para>
  <para style="q" vid="ISA 55:8">un nisht aiere vegen zainen maine vegen, zogt Hashem.<verse eid="ISA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 55:9" />vorem vi der himel iz hecher fun der erd,</para>
  <para style="q" vid="ISA 55:9">azoi zainen maine vegen hecher fun aiere vegen,</para>
  <para style="q" vid="ISA 55:9">un maine trachtungen fun aiere trachtungen.<verse eid="ISA 55:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 55:10" />vorem azoi vi es nidert fun himel</para>
  <para style="q" vid="ISA 55:10">der regn un der shnei,</para>
  <para style="q" vid="ISA 55:10">un kert zich ahin tsu nisht um,</para>
  <para style="q" vid="ISA 55:10">naiert er trinkt on di erd,</para>
  <para style="q" vid="ISA 55:10">un bafrucht zi un bashprotst zi,</para>
  <para style="q" vid="ISA 55:10">un git zerie tsu dem zeyer,</para>
  <para style="q" vid="ISA 55:10">un broit tsu dem eser;<verse eid="ISA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 55:11" />azoi vet zain main vort vos geit arois fun main moil:</para>
  <para style="q" vid="ISA 55:11">es vet zich nisht umkeren tsu mir leidik,</para>
  <para style="q" vid="ISA 55:11">naiert es vet ton vos ich hob gevolt,</para>
  <para style="q" vid="ISA 55:11">un baglikn um vos ich hob es geshikt.<verse eid="ISA 55:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 55:12" />vorem mit simche vet ir aroisgein,</para>
  <para style="q" vid="ISA 55:12">un besholem vet ir gefirt vern;</para>
  <para style="q" vid="ISA 55:12">di berg un di heichn</para>
  <para style="q" vid="ISA 55:12">veln oisbrechn far aich in gezang,</para>
  <para style="q" vid="ISA 55:12">un ale beimer fun feld veln klapn di hent.<verse eid="ISA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 55:13" />anshtotn dorn vet oifgein a tsipres,</para>
  <para style="q" vid="ISA 55:13">un anshtotn vildgeveks vet oifgein a mirt;</para>
  <para style="q" vid="ISA 55:13">un es vet zain far a nomen tsu Hashem,</para>
  <para style="q" vid="ISA 55:13">far an eibikn tseichn vos vet nisht farshnitn vern.<verse eid="ISA 55:13" /></para>
  <chapter eid="ISA 55" />
  <chapter number="56" style="c" pubnumber="נו" sid="ISA 56" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 56:1" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="ISA 56:1">hit recht, un tut gerechtikeit,</para>
  <para style="q" vid="ISA 56:1">vorem nont iz main hilf tsu kumen,</para>
  <para style="q" vid="ISA 56:1">un main gerechtikeit zich tsu antplekn.<verse eid="ISA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 56:2" />voil tsu dem man vos tut dos dozike,</para>
  <para style="q" vid="ISA 56:2">un dem mentshnkind vos halt zich deron!</para>
  <para style="q" vid="ISA 56:2">vos hit Shabbos, im nisht tsu farshvechn,</para>
  <para style="q" vid="ISA 56:2">un hit zain hant fun tsu ton a shum beiz.<verse eid="ISA 56:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 56:3" />un nisht zogn zol der fremd-geborener,</para>
  <para style="q" vid="ISA 56:3">vos baheft zich tsu Hashem, azoi tsu zogn:</para>
  <para style="q" vid="ISA 56:3">opzundern vet mich opzundern Hashem fun zain folk;</para>
  <para style="q" vid="ISA 56:3">un nisht zogn zol der saris:</para>
  <para style="q" vid="ISA 56:3">ze, ich bin a trukener boim.<verse eid="ISA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 56:4" />vorem azoi hot Hashem gezogt</para>
  <para style="q" vid="ISA 56:4">oif di sarisim vos hitn maine Shabbosim,</para>
  <para style="q" vid="ISA 56:4">un veiln ois dos vos ich vil,</para>
  <para style="q" vid="ISA 56:4">un haltn zich on main bris:<verse eid="ISA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 56:5" />zei vel ich gebn in main hoiz</para>
  <para style="q" vid="ISA 56:5">un in maine moiern an ondenk un a nomen,</para>
  <para style="q" vid="ISA 56:5">beser fun zin un fun techter;</para>
  <para style="q" vid="ISA 56:5">an eibikn nomen vel ich zei gebn,</para>
  <para style="q" vid="ISA 56:5">vos vet nisht farshnitn vern.<verse eid="ISA 56:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 56:6" />un di fremdgeborene vos baheftn zich tsu Hashem,</para>
  <para style="q" vid="ISA 56:6">im tsu ton dinst,</para>
  <para style="q" vid="ISA 56:6">un lib tsu hobn dem nomen fun Hashem,</para>
  <para style="q" vid="ISA 56:6">im tsu zain far knecht;</para>
  <para style="q" vid="ISA 56:6">itlecher vos hit Shabbos im nisht tsu farshvechn,</para>
  <para style="q" vid="ISA 56:6">un vos haltn main bris.<verse eid="ISA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 56:7" />zei vel ich brengen tsu main heilikn barg,</para>
  <para style="q" vid="ISA 56:7">un vel zei derfreyen in main hoiz fun gebet;</para>
  <para style="q" vid="ISA 56:7">zeyere brandopfer un zeyere shlachtopfer</para>
  <para style="q" vid="ISA 56:7">veln zain tsu bavilikung oif main mizbeyech;</para>
  <para style="q" vid="ISA 56:7">vorem main hoiz vet gerufn vern</para>
  <para style="q" vid="ISA 56:7">dos hoiz fun gebet far ale felker.<verse eid="ISA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 56:8" />azoi zogt Adonoi Hashem,</para>
  <para style="q" vid="ISA 56:8">der vos zamlt ain di farshtoisene fun Yisroel zogt:</para>
  <para style="q" vid="ISA 56:8">ich vel noch ainzamlen tsu im,</para>
  <para style="q" vid="ISA 56:8">tsu zaine gezamelte.<verse eid="ISA 56:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 56:9" />ale chayes fun feld, kumt aher esen,</para>
  <para style="q" vid="ISA 56:9">ale chayes in vald!<verse eid="ISA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 56:10" />zaine vechter zainen blinde ale,</para>
  <para style="q" vid="ISA 56:10">zei veisn gornit;</para>
  <para style="q" vid="ISA 56:10">shtume hint zainen zei ale, zei kenen nisht biln;</para>
  <para style="q" vid="ISA 56:10">zei lign un cholemen, zei hobn lib shlofn.<verse eid="ISA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 56:11" />un di hint zainen vild zhedne, zei veisn nisht fun zet;</para>
  <para style="q" vid="ISA 56:11">un yene zainen pastucher vos veisn nisht acht tsu gebn;</para>
  <para style="q" vid="ISA 56:11">zei ale kern zich tsu zeyer veg,</para>
  <para style="q" vid="ISA 56:11">itlecher tsu zain gaitsikeit, fun ek tsu ek.<verse eid="ISA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 56:12" />kumt, ich vel brengen vain,</para>
  <para style="q" vid="ISA 56:12">un lomir zoifn dem trunk;</para>
  <para style="q" vid="ISA 56:12">un vi der azoi zol zain morgediker tog,</para>
  <para style="q" vid="ISA 56:12">un greser noch fil.<verse eid="ISA 56:12" /></para>
  <chapter eid="ISA 56" />
  <chapter number="57" style="c" pubnumber="נז" sid="ISA 57" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 57:1" />der gerechter geit unter,</para>
  <para style="q" vid="ISA 57:1">un kein mentsh nemt nisht tsum hartsn,</para>
  <para style="q" vid="ISA 57:1">un frume lait vern avekgenumen,</para>
  <para style="q" vid="ISA 57:1">un keiner batracht nisht, az fun vegen der shlechtikeit</para>
  <para style="q" vid="ISA 57:1">iz avekgenumen gevorn der gerechter.<verse eid="ISA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 57:2" />er geit tsu zain frid;</para>
  <para style="q" vid="ISA 57:2">oif zeyere keyver-gelegers ruen</para>
  <para style="q" vid="ISA 57:2">di vos zainen gegangen in zeyer erlechkeit.<verse eid="ISA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 57:3" />un ir genent aher,</para>
  <para style="q" vid="ISA 57:3">zin fun a kishufmacherin,</para>
  <para style="q" vid="ISA 57:3">zomen fun a noyef un a zoine.<verse eid="ISA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 57:4" />oif vemen macht ir aich lustik?</para>
  <para style="q" vid="ISA 57:4">oif vemen raist ir oif dos moil,</para>
  <para style="q" vid="ISA 57:4">shtekt ir arois a tsung?</para>
  <para style="q" vid="ISA 57:4">far vor, ir zait kinder fun farbrech,</para>
  <para style="q" vid="ISA 57:4">zomen fun lign,<verse eid="ISA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 57:5" />ir vos derhitst aich tsvishn di eichnbeimer,</para>
  <para style="q" vid="ISA 57:5">unter yetveder tsvaighaftikn boim;</para>
  <para style="q" vid="ISA 57:5">vos shecht di kinder in di toln,</para>
  <para style="q" vid="ISA 57:5">unter di shpaltn fun di feldzn.<verse eid="ISA 57:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 57:6" />tsvishn di glate shteiner fun tal iz dain teil,</para>
  <para style="q" vid="ISA 57:6">zei, zei zainen dain goirl;</para>
  <para style="q" vid="ISA 57:6">tsu zei oich hostu gegosn gisopfer,</para>
  <para style="q" vid="ISA 57:6">hostu oifgebracht shpaizopfer.</para>
  <para style="q" vid="ISA 57:6">zol ich vegen dem zich baruyen?<verse eid="ISA 57:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 57:7" />oif a hoichn un derhoibenem barg</para>
  <para style="q" vid="ISA 57:7">hostu dain geleger gemacht;</para>
  <para style="q" vid="ISA 57:7">ahin oich bistu aroifgegangen shlachtopfer tsu shlachtn.<verse eid="ISA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 57:8" />un hinter der tir un dem mezuzah</para>
  <para style="q" vid="ISA 57:8">hostu aroifgeton dain dermontseichn,</para>
  <para style="q" vid="ISA 57:8">vorem fun mir bistu ofen avekgegangen;</para>
  <para style="q" vid="ISA 57:8">host breit gemacht dain geleger,</para>
  <para style="q" vid="ISA 57:8">un host dir mit zei a bund gemacht</para>
  <para style="q" vid="ISA 57:8">vos du host zeyer geleger lib gehat,</para>
  <para style="q" vid="ISA 57:8">zeyer hant gezen.<verse eid="ISA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 57:9" />un bist gegangen tsum melech mit zalb,</para>
  <para style="q" vid="ISA 57:9">un host gemert daine b'somaim;</para>
  <para style="q" vid="ISA 57:9">un host geshikt daine shluchim biz in der vait,</para>
  <para style="q" vid="ISA 57:9">un biz in Sheol gemacht nidern.<verse eid="ISA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 57:10" />fun daine fil vegen bistu mid gevorn,</para>
  <para style="q" vid="ISA 57:10">ober host nisht gezogt: farfaln!</para>
  <para style="q" vid="ISA 57:10">shtarkeit in dain hant hostu gefunen,</para>
  <para style="q" vid="ISA 57:10">derum hostu zich nisht gekimert.<verse eid="ISA 57:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 57:11" />un far vemen hostu zich geshrokn un moire gehat,</para>
  <para style="q" vid="ISA 57:11">az du zolst zich farshteln?</para>
  <para style="q" vid="ISA 57:11">az on mir hostu nisht gedacht,</para>
  <para style="q" vid="ISA 57:11">nisht genumen zich tsum hartsn;</para>
  <para style="q" vid="ISA 57:11">far vor, ich shvaig, un fun eibik on,</para>
  <para style="q" vid="ISA 57:11">derum hostu nisht moire far mir.<verse eid="ISA 57:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 57:12" />vel ich dertseiln dain gerechtikeit,</para>
  <para style="q" vid="ISA 57:12">un daine meisim, zei veln dir nisht guts ton.<verse eid="ISA 57:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 57:13" />az du shraist, zoln daine gezemlen dich matsl zain;</para>
  <para style="q" vid="ISA 57:13">ober zei alemen vet der vint avektrogen,</para>
  <para style="q" vid="ISA 57:13">vet a hoich aveknemen;</para>
  <para style="q" vid="ISA 57:13">un der vos bashitst zich in mir vet arben dos land,</para>
  <para style="q" vid="ISA 57:13">un yarshen main heilikn barg.<verse eid="ISA 57:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 57:14" />un er vet zogn:</para>
  <para style="q" vid="ISA 57:14">tret ois, tret ois, ramt op dem veg,</para>
  <para style="q" vid="ISA 57:14">heibt oif di shtroichlung</para>
  <para style="q" vid="ISA 57:14">fun dem veg fun main folk.<verse eid="ISA 57:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 57:15" />vorem azoi zogt der hoicher un derhoibener,</para>
  <para style="q" vid="ISA 57:15">der vos voint in eibikeit, un heilik iz zain nomen:</para>
  <para style="q" vid="ISA 57:15">in hoichkeit un heilikeit tu ich ruen,</para>
  <para style="q" vid="ISA 57:15">ober oich baim dershlogenem un gefalenem in gemit,</para>
  <para style="q" vid="ISA 57:15">oiftsulebn dos gemit fun gefalene,</para>
  <para style="q" vid="ISA 57:15">un oiftsulebn dos harts fun dershlogene.<verse eid="ISA 57:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 57:16" />vorem nisht eibik tu ich krign,</para>
  <para style="q" vid="ISA 57:16">un nisht tamid tu ich tserenen;</para>
  <para style="q" vid="ISA 57:16">vorem der gaist vos bakleidt zich, iz fun mir,</para>
  <para style="q" vid="ISA 57:16">un di neshomes hob ich gemacht.<verse eid="ISA 57:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 57:17" />far der zind fun zain gaitsikeit</para>
  <para style="q" vid="ISA 57:17">hob ich getsernt, un im geshlogn,</para>
  <para style="q" vid="ISA 57:17">mich farborgen un getsernt,</para>
  <para style="q" vid="ISA 57:17">vail er iz opkererish gegangen</para>
  <para style="q" vid="ISA 57:17">in veg fun zain hartsn.<verse eid="ISA 57:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 57:18" />ich hob gezen zaine vegen,</para>
  <para style="q" vid="ISA 57:18">ober ich vel im heiln, un vel im firn,</para>
  <para style="q" vid="ISA 57:18">un vel batsoln nchmut</para>
  <para style="q" vid="ISA 57:18">im un zaine troierer.<verse eid="ISA 57:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 57:19" />ich bashaf a lipnfrucht:</para>
  <para style="q" vid="ISA 57:19">sholem, sholem tsum nontn un tsum vaitn!</para>
  <para style="q" vid="ISA 57:19">zogt Hashem,</para>
  <para style="q" vid="ISA 57:19">un ich vel im heiln.<verse eid="ISA 57:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 57:20" />ober di reshoim zainen vi a yam a getribener,</para>
  <para style="q" vid="ISA 57:20">vos ken zich nisht ainshtiln,</para>
  <para style="q" vid="ISA 57:20">un zaine vasern traibn koit un leim.<verse eid="ISA 57:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 57:21" />nishto kein sholem, zogt main G-t,</para>
  <para style="q" vid="ISA 57:21">far di reshoim.<verse eid="ISA 57:21" /></para>
  <chapter eid="ISA 57" />
  <chapter number="58" style="c" pubnumber="נח" sid="ISA 58" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 58:1" />ruf mit kel, zolst nisht tsurikhaltn,</para>
  <para style="q" vid="ISA 58:1">azoi vi a shoifer heib oif dain kol,</para>
  <para style="q" vid="ISA 58:1">un zog main folk zeyer farbrech,</para>
  <para style="q" vid="ISA 58:1">un dem hoiz fun Yaakov zeyere zind.<verse eid="ISA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 58:2" />un zei zuchn mich noch tog far tog,</para>
  <para style="q" vid="ISA 58:2">un visen maine vegen bageren zei!</para>
  <para style="q" vid="ISA 58:2">azoi vi a folk vos tut gerechtikeit,</para>
  <para style="q" vid="ISA 58:2">un farlozt nisht dos gezets fun zain G-t,</para>
  <para style="q" vid="ISA 58:2">farlangen zei fun mir mishpotim gerechte,</para>
  <para style="q" vid="ISA 58:2">di nontkeit fun Hashem bageren zei.<verse eid="ISA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 58:3" />far vos fasten mir, un du zest nisht?</para>
  <para style="q" vid="ISA 58:3">painiken mir undzer zel, un du merkst nisht?</para>
  <para style="q" vid="ISA 58:3">zet, in tog fun aier fasten gefint ir an esk,</para>
  <para style="q" vid="ISA 58:3">un ale aiere arbeter tut ir drikn.<verse eid="ISA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 58:4" />ir fast doch nor far krig un shtrait,</para>
  <para style="q" vid="ISA 58:4">un tsu shlogn mitn foist fun umrecht;</para>
  <para style="q" vid="ISA 58:4">ir fast nisht in aza tog</para>
  <para style="q" vid="ISA 58:4">tsu machn hern in der heich aier kol.<verse eid="ISA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 58:5" />iz aza dos fasten vos ich hob oisgeveilt?</para>
  <para style="q" vid="ISA 58:5">a tog far a mentshn tsu painiken zain zel?</para>
  <para style="q" vid="ISA 58:5">tsu beigen vi a vaserritl zain kop,</para>
  <para style="q" vid="ISA 58:5">un zak un ash zol er zich oisbetn?</para>
  <para style="q" vid="ISA 58:5">tsi dos rufstu fasten,</para>
  <para style="q" vid="ISA 58:5">un a tog fun bavilikung tsu Hashem?<verse eid="ISA 58:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 58:6" />iz nisht dos dos fasten vos ich hob oisgeveilt:</para>
  <para style="q" vid="ISA 58:6">loiz machn di keitn fun umrecht,</para>
  <para style="q" vid="ISA 58:6">opbindn di bindshtrik fun yoch,</para>
  <para style="q" vid="ISA 58:6">un aroislozn frai di gedrikte,</para>
  <para style="q" vid="ISA 58:6">un yetveder yoch zolt ir tsebrechn?<verse eid="ISA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 58:7" />iz es nisht, optsubrechn fun dain broit dem hungerikn,</para>
  <para style="q" vid="ISA 58:7">un farvoglte orime zolstu arainbrengen in hoiz?</para>
  <para style="q" vid="ISA 58:7">az du zest a naketn, zolstu im badekn,</para>
  <para style="q" vid="ISA 58:7">un fun dain eigen fleish zolstu zich nisht farhoiln?<verse eid="ISA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 58:8" />dentsmol vet oisbrechn vi der frimorgn dain licht,</para>
  <para style="q" vid="ISA 58:8">un dain heilung vet aroisshprotsn gich;</para>
  <para style="q" vid="ISA 58:8">un dir farois vet gein dain gerechtikeit,</para>
  <para style="q" vid="ISA 58:8">un di pracht fun Hashem vet dich nochbaleitn.<verse eid="ISA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 58:9" />dentsmol vestu rufn, un Hashem vet entfern;</para>
  <para style="q" vid="ISA 58:9">vest shraien, un er vet zogn: do bin ich!</para>
  <para style="q" vid="ISA 58:9">az du vest opton fun tsvishn dir faryochung,</para>
  <para style="q" vid="ISA 58:9">teitlen mitn finger, un redn umrecht;<verse eid="ISA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 58:10" />un vest oisshtrekn tsum hungerikn dain zel,</para>
  <para style="q" vid="ISA 58:10">un di gedrikte zel vestu zetn;</para>
  <para style="q" vid="ISA 58:10">dentsmol vet oifshainen in choishech dain licht,</para>
  <para style="q" vid="ISA 58:10">un dain fintsterkeit vi mitn tog.<verse eid="ISA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 58:11" />un Hashem vet dich firn tamid,</para>
  <para style="q" vid="ISA 58:11">un vet zetn in trikenishn dain zel,</para>
  <para style="q" vid="ISA 58:11">un daine beiner vet er shtarkn;</para>
  <para style="q" vid="ISA 58:11">un vest zain vi a gortn an ongetrunkener,</para>
  <para style="q" vid="ISA 58:11">un vi an oisgang vaser</para>
  <para style="q" vid="ISA 58:11">vos zaine vasern tuen nisht felshn.<verse eid="ISA 58:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 58:12" />un me vet opboien bai dir eibike churves,</para>
  <para style="q" vid="ISA 58:12">gruntfestn fun dor-doires vestu oifshteln;</para>
  <para style="q" vid="ISA 58:12">un me vet dich rufn farmoierer fun brochn,</para>
  <para style="q" vid="ISA 58:12">banaier fun vegen tsum voinen.<verse eid="ISA 58:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 58:13" />az du vest ophaltn tsulib Shabbos dain fus,</para>
  <para style="q" vid="ISA 58:13">fun ton daine eskim in main heilikn tog;</para>
  <para style="q" vid="ISA 58:13">un vest rufn Shabbos a tenug,</para>
  <para style="q" vid="ISA 58:13">dem heilikn fun Hashem, geerlecht;</para>
  <para style="q" vid="ISA 58:13">un vest im erlechn, nisht tsu ton daine gangen,</para>
  <para style="q" vid="ISA 58:13">nisht tsu gefinen dir an esk, oder opredn a zach.<verse eid="ISA 58:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 58:14" />dentsmol vestu zich kvikn mit Hashem,</para>
  <para style="q" vid="ISA 58:14">un ich vel dich aroifzetsn oif di heichn fun der erd,</para>
  <para style="q" vid="ISA 58:14">un dich machn esen di arav fun dain foter Yaakov;</para>
  <para style="q" vid="ISA 58:14">vorem dos moil fun Hashem hot geredt.<verse eid="ISA 58:14" /></para>
  <chapter eid="ISA 58" />
  <chapter number="59" style="c" pubnumber="נט" sid="ISA 59" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 59:1" />zet, di hant fun Hashem iz nisht kurts tsu helfn,</para>
  <para style="q" vid="ISA 59:1">un zain oier iz nisht shver tsu hern;<verse eid="ISA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 59:2" />nor aiere zind flegn tsesheidn tsvishn aich un Elokeichem,</para>
  <para style="q" vid="ISA 59:2">un aiere chatoim hobn farborgen zain ponem fun aich,</para>
  <para style="q" vid="ISA 59:2">nisht tsutsuhern.<verse eid="ISA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 59:3" />vorem aiere hent zainen baflekt mit blut,</para>
  <para style="q" vid="ISA 59:3">un aiere finger mit zind;</para>
  <para style="q" vid="ISA 59:3">aiere lipn zogn lign,</para>
  <para style="q" vid="ISA 59:3">aiere tsung redt umrecht.<verse eid="ISA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 59:4" />keiner lodt nisht mit gerechtikeit,</para>
  <para style="q" vid="ISA 59:4">un keiner tainet nisht mit emes;</para>
  <para style="q" vid="ISA 59:4">me farzichert zich oif nisht, un me redt falsh,</para>
  <para style="q" vid="ISA 59:4">me trogt umglik, un me gebert umrecht.<verse eid="ISA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 59:5" />aier fun a shlang brien zei ois,</para>
  <para style="q" vid="ISA 59:5">un shpinvebs tuen zei vebn;</para>
  <para style="q" vid="ISA 59:5">der vos est fun zeyere aier shtarbt,</para>
  <para style="q" vid="ISA 59:5">un dos tsedrikte brecht ois in an otershlang.<verse eid="ISA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 59:6" />zeyere gevebn zainen nisht oif a beged,</para>
  <para style="q" vid="ISA 59:6">un men ken zich nisht tsudekn mit zeyere arbet;</para>
  <para style="q" vid="ISA 59:6">zeyere arbet iz arbet fun umrecht,</para>
  <para style="q" vid="ISA 59:6">un oiftu fun roib iz in zeyere hent.<verse eid="ISA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 59:7" />zeyere fis loifn tsu shlechts,</para>
  <para style="q" vid="ISA 59:7">un zei ailn tsu fargisen umshuldik blut;</para>
  <para style="q" vid="ISA 59:7">zeyere trachtungen zainen trachtungen fun umrecht,</para>
  <para style="q" vid="ISA 59:7">farvistung un broch zainen in zeyere shliachn.<verse eid="ISA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 59:8" />dem veg fun sholem veisn zei nisht,</para>
  <para style="q" vid="ISA 59:8">un nishto kein gerechtikeit in zeyere geng;</para>
  <para style="q" vid="ISA 59:8">zei hobn farkrimt zeyere shtegn,</para>
  <para style="q" vid="ISA 59:8">keiner vos tret deroif veis nisht fun sholem.<verse eid="ISA 59:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 59:9" />derum iz gerechtikeit vait fun undz,</para>
  <para style="q" vid="ISA 59:9">un undz dergreicht nisht kein hilf;</para>
  <para style="q" vid="ISA 59:9">mir hofn oif licht, ersht es iz choishech,</para>
  <para style="q" vid="ISA 59:9">oif shain, un mir geyen in fintsternish.<verse eid="ISA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 59:10" />mir tapn vi blinde on der vant,</para>
  <para style="q" vid="ISA 59:10">un azoi vi on oign tapn mir arum;</para>
  <para style="q" vid="ISA 59:10">mir shtroichlen in mitn tog, vi in ovnt,</para>
  <para style="q" vid="ISA 59:10">mir zainen tsvishn gezunte azoi vi di meisim.<verse eid="ISA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 59:11" />mir brumen vi di beren ale,</para>
  <para style="q" vid="ISA 59:11">un klogn vi di toibn klogn mir;</para>
  <para style="q" vid="ISA 59:11">mir hofn oif gerechtikeit, un nishto,</para>
  <para style="q" vid="ISA 59:11">oif a yeshue, un zi iz vait fun undz.<verse eid="ISA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 59:12" />vorem fil zainen undzere farbrechn far dir,</para>
  <para style="q" vid="ISA 59:12">un undzere chatoim zogn eides kegen undz;</para>
  <para style="q" vid="ISA 59:12">vorem undzere farbrechn zainen bai undz,</para>
  <para style="q" vid="ISA 59:12">un undzere zind – zei veisn mir voil:<verse eid="ISA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 59:13" />brechn un leikenen on Hashem,</para>
  <para style="q" vid="ISA 59:13">un zich opkeren fun hinter Elokeinu,</para>
  <para style="q" vid="ISA 59:13">redn roib un opkerung,</para>
  <para style="q" vid="ISA 59:13">trogn un aroisbrengen fun hartsn falshe reid.<verse eid="ISA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 59:14" />un opgetretn ahinter iz gerechtikeit,</para>
  <para style="q" vid="ISA 59:14">un rechtfartikeit shteit fun der vaitn,</para>
  <para style="q" vid="ISA 59:14">vorem geshtroichlt in gas iz der emes,</para>
  <para style="q" vid="ISA 59:14">un erlechkeit ken nisht arainkumen.<verse eid="ISA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 59:15" />un der emes felt,</para>
  <para style="q" vid="ISA 59:15">un der vos kert zich op fun beiz,</para>
  <para style="q" vid="ISA 59:15">vert far meshuge gehaltn.</para>
  <para style="b" vid="ISA 59:15" />
  <para style="q" vid="ISA 59:15">un Hashem hot gezen,</para>
  <para style="q" vid="ISA 59:15">un es iz geven shlecht in zaine oign,</para>
  <para style="q" vid="ISA 59:15">vos kein gerechtikeit iz nishto.<verse eid="ISA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 59:16" />un er hot gezen, az kein mentsh iz nishto,</para>
  <para style="q" vid="ISA 59:16">un zich farvundert, vos keiner shtelt zich nisht ain;</para>
  <para style="q" vid="ISA 59:16">hot im zain orem geholfn,</para>
  <para style="q" vid="ISA 59:16">un zain gerechtikeit, zi hot im untergelent.<verse eid="ISA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 59:17" />un er hot ongeton gerechtikeit vi a shild,</para>
  <para style="q" vid="ISA 59:17">un a kiver fun hilf oif zain kop;</para>
  <para style="q" vid="ISA 59:17">un er hot ongeton kleider fun nekome tsum malbesh,</para>
  <para style="q" vid="ISA 59:17">un zich aingeviklt vi in a mantl in tsorn.<verse eid="ISA 59:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 59:18" />azoi vi noch di tuungen, azoiernoch vet er batsoln,</para>
  <para style="q" vid="ISA 59:18">grimtsorn tsu zaine faint, fargeltung tsu zaine sonim;</para>
  <para style="q" vid="ISA 59:18">tsu di indzelen vet er fargeltung batsoln.<verse eid="ISA 59:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 59:19" />un me vet moire hobn faran nomen Hashem fun mayrev,</para>
  <para style="q" vid="ISA 59:19">un fun oifgang fun zun far zain koved;</para>
  <para style="q" vid="ISA 59:19">vorem der faint vet arainkumen vi a taich,</para>
  <para style="q" vid="ISA 59:19">un der ruach fun Hashem vet zich oifheibn a fon kegen im.<verse eid="ISA 59:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 59:20" />un der oisleizer vet kumen tsu Tsiyon,</para>
  <para style="q" vid="ISA 59:20">un tsu im vos tuen aveknemen zind in Yaakov,</para>
  <para style="q" vid="ISA 59:20">zogt Hashem.<verse eid="ISA 59:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="ISA 59:21" />un ich – dos iz main bris mit zei, zogt Hashem: main gaist vos oif dir, un maine verter vos ich hob araingeton in dain moil, veln zich nisht opton fun dain moil, un fun dem moil fun daine kinder, un fun dem moil fun daine kinds-kinder, zogt Hashem, fun atsund un biz eibik.<verse eid="ISA 59:21" /></para>
  <chapter eid="ISA 59" />
  <chapter number="60" style="c" pubnumber="ס" sid="ISA 60" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 60:1" />shtei oif, laicht oif, vorem dain licht iz gekumen,</para>
  <para style="q" vid="ISA 60:1">un di pracht fun Hashem shaint oif iber dir.<verse eid="ISA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 60:2" />vorem ze, fintsternish vet badekn di erd,</para>
  <para style="q" vid="ISA 60:2">un a nebl di felker,</para>
  <para style="q" vid="ISA 60:2">ober oif dir vet oifshainen Hashem,</para>
  <para style="q" vid="ISA 60:2">un zain pracht vet zich vaizn oif dir.<verse eid="ISA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 60:3" />un felker veln gein far dain licht,</para>
  <para style="q" vid="ISA 60:3">un mlochim far der helkeit fun dain shain.<verse eid="ISA 60:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 60:4" />heib oif rund arum daine oign, un ze:</para>
  <para style="q" vid="ISA 60:4">zei ale zainen aingezamlt, zei kumen tsu dir:</para>
  <para style="q" vid="ISA 60:4">daine zin kumen on fun der vait,</para>
  <para style="q" vid="ISA 60:4">un daine techter vern oifn zait getrogn.<verse eid="ISA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 60:5" />dentsmol vestu zen un vest laichtn,</para>
  <para style="q" vid="ISA 60:5">un tsiteren un breit vern vet dain harts;</para>
  <para style="q" vid="ISA 60:5">vorem ibergein tsu dir vet di raichkeit fun yam,</para>
  <para style="q" vid="ISA 60:5">der farmeg fun di felker vet kumen tsu dir.<verse eid="ISA 60:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 60:6" />a shefe fun kemlen vet dich badekn,</para>
  <para style="q" vid="ISA 60:6">yungkemlen fun Midyan un Eifah,</para>
  <para style="q" vid="ISA 60:6">ale fun Sheva gekumen;</para>
  <para style="q" vid="ISA 60:6">gold un vairech veln zei trogn,</para>
  <para style="q" vid="ISA 60:6">un zei veln mevaser zain dem loibn fun Hashem.<verse eid="ISA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 60:7" />ale shof fun Kedar veln aingezamlt vern tsu dir,</para>
  <para style="q" vid="ISA 60:7">di viders fun Nevayot veln zain dir tsu dinst;</para>
  <para style="q" vid="ISA 60:7">zei veln oifgein mit bavilikung oif main mizbeyech;</para>
  <para style="q" vid="ISA 60:7">un main hoiz fun sheinkeit vel ich basheinen.<verse eid="ISA 60:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 60:8" />ver zainen di dozike vos flien vi a volken,</para>
  <para style="q" vid="ISA 60:8">un vi di toibn tsu zeyere fentster?<verse eid="ISA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 60:9" />far vor, tsu mir veln di indzelen zich hofn,</para>
  <para style="q" vid="ISA 60:9">un di shifn fun Tarshish tsuersht,</para>
  <para style="q" vid="ISA 60:9">tsu brengen daine kinder fun der vait,</para>
  <para style="q" vid="ISA 60:9">zeyer gold un zeyer zilber mit zei,</para>
  <para style="q" vid="ISA 60:9">tsum nomen fun Hashem dain G-t,</para>
  <para style="q" vid="ISA 60:9">un tsum heilikn fun Yisroel,</para>
  <para style="q" vid="ISA 60:9">vail er hot dich basheint.<verse eid="ISA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 60:10" />un fremdgeborene veln boien daine moiern,</para>
  <para style="q" vid="ISA 60:10">un zeyere mlochim veln dich badinen;</para>
  <para style="q" vid="ISA 60:10">vorem in main tsorn hob ich dich geshlogn,</para>
  <para style="q" vid="ISA 60:10">un in main bavilikung hob ich dich derbaremt.<verse eid="ISA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 60:11" />un ofen veln zain daine toiern tamid,</para>
  <para style="q" vid="ISA 60:11">tog un nacht veln zei nisht farshlosn vern,</para>
  <para style="q" vid="ISA 60:11">kedei tsu brengen dem farmeg fun di felker tsu dir;</para>
  <para style="q" vid="ISA 60:11">un zeyere mlochim veln mitforn.<verse eid="ISA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 60:12" />vorem dos folk un dos kinigraich,</para>
  <para style="q" vid="ISA 60:12">vos veln dir nisht dinen, veln untergein,</para>
  <para style="q" vid="ISA 60:12">un di felker veln vist farvist vern.<verse eid="ISA 60:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 60:13" />di pracht fun Levanon vet kumen tsu dir,</para>
  <para style="q" vid="ISA 60:13">tsipres, tenenboim, un buksnboim in einem,</para>
  <para style="q" vid="ISA 60:13">tsu basheinen dem ort fun main mikdash;</para>
  <para style="q" vid="ISA 60:13">un dem ort fun maine fis vel ich erlechn.<verse eid="ISA 60:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 60:14" />un geboign veln kumen tsu dir</para>
  <para style="q" vid="ISA 60:14">di zin fun daine painiker,</para>
  <para style="q" vid="ISA 60:14">un bukn zich tsu daine fustrit</para>
  <para style="q" vid="ISA 60:14">veln ale daine lesterer;</para>
  <para style="q" vid="ISA 60:14">un zei veln dich rufn di shtot fun Hashem,</para>
  <para style="q" vid="ISA 60:14">Tsiyon fun dem heilikn fun Yisroel.<verse eid="ISA 60:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 60:15" />anshtot dain zain farlozt un farhast,</para>
  <para style="q" vid="ISA 60:15">un on a durchgeyer,</para>
  <para style="q" vid="ISA 60:15">vel ich dich machn tsum eibikn groiskeit,</para>
  <para style="q" vid="ISA 60:15">a freid oif dor-doires.<verse eid="ISA 60:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 60:16" />un vest zeign dos milch fun di felker,</para>
  <para style="q" vid="ISA 60:16">un di brust fun mlochim vestu zeign;</para>
  <para style="q" vid="ISA 60:16">un du vest visen az ich Hashem bin dain helfer,</para>
  <para style="q" vid="ISA 60:16">un dain derleizer, der shtarker fun Yaakov.<verse eid="ISA 60:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 60:17" />anshtotn kuper vel ich brengen gold,</para>
  <para style="q" vid="ISA 60:17">un anshtotn aizn vel ich brengen zilber,</para>
  <para style="q" vid="ISA 60:17">un anshtot di holtsn, kuper,</para>
  <para style="q" vid="ISA 60:17">un anshtot di shteiner, aizn;</para>
  <para style="q" vid="ISA 60:17">un ich vel machn far dain oifzeer sholem,</para>
  <para style="q" vid="ISA 60:17">un far daine hersher gerechtikeit.<verse eid="ISA 60:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 60:18" />mer vet nisht gehert vern roib in dain land</para>
  <para style="q" vid="ISA 60:18">farvistung un broch in daine gemarkn;</para>
  <para style="q" vid="ISA 60:18">un vest rufn daine moiern yeshue,</para>
  <para style="q" vid="ISA 60:18">un daine toiern loib.<verse eid="ISA 60:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ISA 60:19" />di zun vet dir mer nisht zain far licht bai tog,</para>
  <para style="q" vid="ISA 60:19">un far helkeit vet dir nisht shainen di levone,</para>
  <para style="q" vid="ISA 60:19">nor Hashem vet dir zain far an eibikn licht,</para>
  <para style="q" vid="ISA 60:19">un dain G-t far dain sheinkeit.<verse eid="ISA 60:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 60:20" />nisht untergein vet dain zun mer,</para>
  <para style="q" vid="ISA 60:20">un dain levone vet nisht aingeton vern,</para>
  <para style="q" vid="ISA 60:20">vorem Hashem vet dir zain far an eibikn licht,</para>
  <para style="q" vid="ISA 60:20">un geendikt veln zain di teg fun dain troier.<verse eid="ISA 60:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 60:21" />un dain folk veln zain ale gerechte,</para>
  <para style="q" vid="ISA 60:21">oif eibik veln zei arben dos land –</para>
  <para style="q" vid="ISA 60:21">der tsvaig fun main flantsung,</para>
  <para style="q" vid="ISA 60:21">dos verk fun maine hent zich tsum rimen.<verse eid="ISA 60:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 60:22" />der klenster vet vern tsu toiznt,</para>
  <para style="q" vid="ISA 60:22">un der mindster tsum machtikn folk;</para>
  <para style="q" vid="ISA 60:22">ich Hashem vel dos ailn in zain tsait.<verse eid="ISA 60:22" /></para>
  <chapter eid="ISA 60" />
  <chapter number="61" style="c" pubnumber="סא" sid="ISA 61" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 61:1" />der gaist fun Adonoi Hashem iz oif mir,</para>
  <para style="q" vid="ISA 61:1">vail Hashem hot mich gezalbt</para>
  <para style="q" vid="ISA 61:1">tsu brengen besoire tsu di farlitene;</para>
  <para style="q" vid="ISA 61:1">mich geshikt tsu farbindn di tsebrochene hertser,</para>
  <para style="q" vid="ISA 61:1">oistsurufn fraishaft tsu di gefangene,</para>
  <para style="q" vid="ISA 61:1">un loizlozung tsu di gebundene;<verse eid="ISA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 61:2" />oistsurufn a yor fun bavilikung fun Hashem,</para>
  <para style="q" vid="ISA 61:2">un a tog fun nekome fun Elokeinu;</para>
  <para style="q" vid="ISA 61:2">tsu treistn ale troierer;<verse eid="ISA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 61:3" />tsu bashern di troierer fun Tsiyon,</para>
  <para style="q" vid="ISA 61:3">zei tsu gebn a hoib anshtot shtoib,</para>
  <para style="q" vid="ISA 61:3">eil fun freid anshtot troier,</para>
  <para style="q" vid="ISA 61:3">a mantl fun loib anshtot a batribt gemit;</para>
  <para style="q" vid="ISA 61:3">un me vet zei rufn di eichnbeimer fun gerechtikeit,</para>
  <para style="q" vid="ISA 61:3">di flantsung fun Hashem zich tsum rimen.<verse eid="ISA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 61:4" />un zei veln opboien eibike churves,</para>
  <para style="q" vid="ISA 61:4">vistenishn fun fartsaitn veln zei oifrichtn,</para>
  <para style="q" vid="ISA 61:4">un zei veln banayen cherve shtet,</para>
  <para style="q" vid="ISA 61:4">vistenishn fun dor-doires.<verse eid="ISA 61:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 61:5" />un fremde veln shtein un fitern aiere shof,</para>
  <para style="q" vid="ISA 61:5">un fremdgeborene veln zain</para>
  <para style="q" vid="ISA 61:5">aiere akerlait un aiere vaingertnirer.<verse eid="ISA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 61:6" />un ir vet koyanim fun Hashem gerufn vern,</para>
  <para style="q" vid="ISA 61:6">diner fun Elokeinu vet gezogt vern oif aich.</para>
  <para style="q" vid="ISA 61:6">dem farmeg fun di felker vet ir esen,</para>
  <para style="q" vid="ISA 61:6">un zeyer pracht vet ir ibernemen.<verse eid="ISA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 61:7" />far aier topeler bushe,</para>
  <para style="q" vid="ISA 61:7">un vail me flegt zingen: shand iz zeyer chelek,</para>
  <para style="q" vid="ISA 61:7">derum veln zei yarshen topl in zeyer land;</para>
  <para style="q" vid="ISA 61:7">an eibike freid vet bai zei zain.<verse eid="ISA 61:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 61:8" />vorem ich Hashem hob lib gerechtikeit;</para>
  <para style="q" vid="ISA 61:8">ich hob faint gzeile mit umrecht,</para>
  <para style="q" vid="ISA 61:8">un ich vel gebn vorhaftik zeyer loin,</para>
  <para style="q" vid="ISA 61:8">un an eibikn bris vel ich zei shlisn.<verse eid="ISA 61:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 61:9" />un bavust bai di felker vet zain zeyer zomen,</para>
  <para style="q" vid="ISA 61:9">un zeyere shprotsn tsvishn di umes;</para>
  <para style="q" vid="ISA 61:9">ale vos zeen zei veln zei derkenen,</para>
  <para style="q" vid="ISA 61:9">az zei zainen der zomen vos Hashem hot gebentsht.<verse eid="ISA 61:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 61:10" />freyen frei ich zich mit Hashem,</para>
  <para style="q" vid="ISA 61:10">lustik iz main zel mit main G-t,</para>
  <para style="q" vid="ISA 61:10">vorem er hot mir ongeton kleider fun hilf,</para>
  <para style="q" vid="ISA 61:10">a mantl fun gerechtikeit mir arumgeviklt,</para>
  <para style="q" vid="ISA 61:10">vi a chosen tut on a koyen-hoib,</para>
  <para style="q" vid="ISA 61:10">un vi a kale tsirt zich on mit ire taּchshitin.<verse eid="ISA 61:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 61:11" />vorem vi di erd lozt arois ir shprotsung,</para>
  <para style="q" vid="ISA 61:11">un vi a gortn macht shprotsn zaine zomen,</para>
  <para style="q" vid="ISA 61:11">azoi vet Adonoi Hashem machn shprotsn zig un loib,</para>
  <para style="q" vid="ISA 61:11">antkegen far ale felker.<verse eid="ISA 61:11" /></para>
  <chapter eid="ISA 61" />
  <chapter number="62" style="c" pubnumber="סב" sid="ISA 62" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 62:1" />fun vegen Tsiyon vel ich nisht shvaign,</para>
  <para style="q" vid="ISA 62:1">un fun vegen Yerushalayim vel ich nisht ruen,</para>
  <para style="q" vid="ISA 62:1">biz arois vi der shain vet ir gerechtikeit,</para>
  <para style="q" vid="ISA 62:1">un ir hilf vi a flam vos brent.<verse eid="ISA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 62:2" />un di felker veln zen dain gerechtikeit,</para>
  <para style="q" vid="ISA 62:2">un ale mlochim dain koved;</para>
  <para style="q" vid="ISA 62:2">un me vet dich rufn a naiem nomen,</para>
  <para style="q" vid="ISA 62:2">vos dos moil fun Hashem vet im onrufn.<verse eid="ISA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 62:3" />un vest zain a kroin fun sheinkeit</para>
  <para style="q" vid="ISA 62:3">in der hant fun Hashem,</para>
  <para style="q" vid="ISA 62:3">un a malchutdike hoib</para>
  <para style="q" vid="ISA 62:3">in der hantflech fun dain G-t.<verse eid="ISA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 62:4" />oif dir vet mer nisht gezogt vern farlozte,</para>
  <para style="q" vid="ISA 62:4">un oif dain land vet mer nisht gezogt vern vistenish,</para>
  <para style="q" vid="ISA 62:4">nor dich vet men rufn main-glust-tsu-ir,</para>
  <para style="q" vid="ISA 62:4">un dos land dains bamante;</para>
  <para style="q" vid="ISA 62:4">vorem Hashem tut dich glustn,</para>
  <para style="q" vid="ISA 62:4">un dain land vet bamant vern.<verse eid="ISA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 62:5" />vorem vi a bocher bamant a yungfroi,</para>
  <para style="q" vid="ISA 62:5">veln dich bamanen daine kinder;</para>
  <para style="q" vid="ISA 62:5">un vi di freid fun a chosen mit der kale,</para>
  <para style="q" vid="ISA 62:5">vet zich freyen mit dir dain G-t.<verse eid="ISA 62:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 62:6" />oif daine moiern, Yerushalayim, hob ich oifgeshtelt shomrim,</para>
  <para style="q" vid="ISA 62:6">a gantsn tog un a gantse nacht, zei zoln tamid nisht shvaign.</para>
  <para style="q" vid="ISA 62:6">ir dermoner fun Hashem, kein ru nisht tsu aich!<verse eid="ISA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 62:7" />un ir zolt nisht gebn kein ru tsu im,</para>
  <para style="q" vid="ISA 62:7">biz er vet oifrichtn, un biz er vet machn Yerushalayim</para>
  <para style="q" vid="ISA 62:7">a loib oif der erd.<verse eid="ISA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 62:8" />Hashem hot geshvorn bai zain rechter hant,</para>
  <para style="q" vid="ISA 62:8">un bai zain machtikn orem:</para>
  <para style="q" vid="ISA 62:8">oib ich vel mer gebn dain tvue</para>
  <para style="q" vid="ISA 62:8">far shpaiz tsu daine faint!</para>
  <para style="q" vid="ISA 62:8">un oib fremdgeborene veln trinken dain vain</para>
  <para style="q" vid="ISA 62:8">vos du host zich gemit oif im!<verse eid="ISA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 62:9" />naiert ire arainnemer veln zi esen,</para>
  <para style="q" vid="ISA 62:9">un veln loibn Hashem;</para>
  <para style="q" vid="ISA 62:9">un zaine ainzamler veln im trinken</para>
  <para style="q" vid="ISA 62:9">in di hoifn fun main heiliktum.<verse eid="ISA 62:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 62:10" />geit durch, geit durch durch di toiern,</para>
  <para style="q" vid="ISA 62:10">ramt op dem veg fun dem folk!</para>
  <para style="q" vid="ISA 62:10">tret ois, tret ois dem shteg,</para>
  <para style="q" vid="ISA 62:10">reinikt op fun shteiner!</para>
  <para style="q" vid="ISA 62:10">heibt oif a fon tsu di felker!<verse eid="ISA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 62:11" />ze, Hashem hot gemacht hern</para>
  <para style="q" vid="ISA 62:11">biz tsum ek fun der erd:</para>
  <para style="q" vid="ISA 62:11">zogt tsu tochter Tsiyon: ze, dain hilf iz gekumen;</para>
  <para style="q" vid="ISA 62:11">ze, zain loin iz mit im,</para>
  <para style="q" vid="ISA 62:11">un zain fargeltung im farois.<verse eid="ISA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 62:12" />un me vet zei rufn dos heilike folk,</para>
  <para style="q" vid="ISA 62:12">di oisderleizte fun Hashem;</para>
  <para style="q" vid="ISA 62:12">un dich vet men rufn gezuchte,</para>
  <para style="q" vid="ISA 62:12">nisht farlozene shtot.<verse eid="ISA 62:12" /></para>
  <chapter eid="ISA 62" />
  <chapter number="63" style="c" pubnumber="סג" sid="ISA 63" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 63:1" />ver iz der vos kumt fun Edom,</para>
  <para style="q" vid="ISA 63:1">in geroitikte begadim fun Botsrah?</para>
  <para style="q" vid="ISA 63:1">der vos iz prachtik in zain malbesh,</para>
  <para style="q" vid="ISA 63:1">oisgeboign in zain grois shtarkeit?</para>
  <para style="q" vid="ISA 63:1">ich vos red mit gerechtikeit,</para>
  <para style="q" vid="ISA 63:1">vos bin machtik tsu helfn.<verse eid="ISA 63:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 63:2" />far vos iz roit oif dain kleid,</para>
  <para style="q" vid="ISA 63:2">un daine begadim vi baim treter in a kelter?<verse eid="ISA 63:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 63:3" />ich hob getretn a kelter alein,</para>
  <para style="q" vid="ISA 63:3">un fun di felker iz keiner mit mir nisht geven;</para>
  <para style="q" vid="ISA 63:3">un ich hob zei getretn in main kaas,</para>
  <para style="q" vid="ISA 63:3">un zei getramplt in main grimtsorn;</para>
  <para style="q" vid="ISA 63:3">hot geshpritst zeyer zaft oif maine begadim,</para>
  <para style="q" vid="ISA 63:3">un ale maine kleider hob ich baflekt.<verse eid="ISA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 63:4" />vorem a tog fun nekome iz in main hartsn,</para>
  <para style="q" vid="ISA 63:4">un main yor fun derleizung iz gekumen.<verse eid="ISA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 63:5" />un ich hob mich umgekukt,</para>
  <para style="q" vid="ISA 63:5">un nisht geven kein helfer,</para>
  <para style="q" vid="ISA 63:5">un ich hob mich gevundert,</para>
  <para style="q" vid="ISA 63:5">un nisht geven kein unterlener;</para>
  <para style="q" vid="ISA 63:5">hot mich main orem geholfn,</para>
  <para style="q" vid="ISA 63:5">un main grimtsorn, er hot mich untergelent.<verse eid="ISA 63:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 63:6" />un ich hob getretn di felker in main kaas,</para>
  <para style="q" vid="ISA 63:6">un zei farshikurt mit main grimtsorn,</para>
  <para style="q" vid="ISA 63:6">un gemacht nidern tsu der erd zeyer zaft.<verse eid="ISA 63:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 63:7" />di chasadim fun Hashem vel ich dermonen,</para>
  <para style="q" vid="ISA 63:7">di loibungen fun Hashem,</para>
  <para style="q" vid="ISA 63:7">vedlik alts vos Hashem hot undz geton,</para>
  <para style="q" vid="ISA 63:7">un di fil toivus tsum hoiz fun Yisroel,</para>
  <para style="q" vid="ISA 63:7">vos er hot geton tsu zei loit zain baremhartsikeit,</para>
  <para style="q" vid="ISA 63:7">un loit zaine fil chasadim.<verse eid="ISA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 63:8" />vorem er hot gezogt: zei zainen fort main folk,</para>
  <para style="q" vid="ISA 63:8">kinder vos veln nisht felshn;</para>
  <para style="q" vid="ISA 63:8">un er iz zei geven far a helfer.<verse eid="ISA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 63:9" />in al zeyer laid hot er gelitn,</para>
  <para style="q" vid="ISA 63:9">un der malach fun zain ponem hot zei geholfn;</para>
  <para style="q" vid="ISA 63:9">in zain libshaft un in zain derbaremung</para>
  <para style="q" vid="ISA 63:9">hot er zei oisgeleizt,</para>
  <para style="q" vid="ISA 63:9">un zei gehoibn un zei getrogn</para>
  <para style="q" vid="ISA 63:9">ale teg fun fartsaitn.<verse eid="ISA 63:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 63:10" />ober zei hobn vidershpenikt</para>
  <para style="q" vid="ISA 63:10">un batribt zain heilikn gaist,</para>
  <para style="q" vid="ISA 63:10">un er iz zei farkert gevorn in a faint;</para>
  <para style="q" vid="ISA 63:10">er hot milchome gehaltn oif zei.<verse eid="ISA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 63:11" />un zain folk hot gedacht</para>
  <para style="q" vid="ISA 63:11">on di teg fun fartsaitn, fun Mosheen:</para>
  <para style="q" vid="ISA 63:11">vu iz der vos hot zei oifgebracht fun yam,</para>
  <para style="q" vid="ISA 63:11">durch dem pastuch fun zaine shof?</para>
  <para style="q" vid="ISA 63:11">vu iz der vos hot zei araingeton in im</para>
  <para style="q" vid="ISA 63:11">zain heilikn gaist?<verse eid="ISA 63:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 63:12" />vu iz er, vos hot baleit di rechte hant fun Mosheen</para>
  <para style="q" vid="ISA 63:12">mit dem orem fun zain pracht?</para>
  <para style="q" vid="ISA 63:12">vos hot geshpoltn di vasern fun far zei,</para>
  <para style="q" vid="ISA 63:12">zich tsu machn an eibikn nomen?<verse eid="ISA 63:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 63:13" />vos hot zei gefirt durch tehomen</para>
  <para style="q" vid="ISA 63:13">vi a ferd durch a step,</para>
  <para style="q" vid="ISA 63:13">zei zoln nisht geshtroichlt vern?<verse eid="ISA 63:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 63:14" />vi fich vos tut nidern in tal,</para>
  <para style="q" vid="ISA 63:14">hot der gaist fun Hashem zei barut;</para>
  <para style="q" vid="ISA 63:14">azoi hostu gefirt dain folk,</para>
  <para style="q" vid="ISA 63:14">dir tsu machn a prachtikn nomen.<verse eid="ISA 63:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 63:15" />lug fun himel un ze,</para>
  <para style="q" vid="ISA 63:15">fun dain heiliker un prachtiker voinung;</para>
  <para style="q" vid="ISA 63:15">vu iz dain onnemen zich un daine gevuros?</para>
  <para style="q" vid="ISA 63:15">di brumung fun daine ingeveid un dain baremhartsikeit</para>
  <para style="q" vid="ISA 63:15">haltn zich ain kegen mir.<verse eid="ISA 63:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 63:16" />far vor, du bist undzer foter;</para>
  <para style="q" vid="ISA 63:16">vorem Avraham veis undz nisht,</para>
  <para style="q" vid="ISA 63:16">un Yisroel ken undz nisht;</para>
  <para style="q" vid="ISA 63:16">du, Hashem, bist undzer foter,</para>
  <para style="q" vid="ISA 63:16">undzer oisleizer iz dain nomen fun eibik on.<verse eid="ISA 63:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 63:17" />far vos, Hashem, loztu undz blondzhen fun daine vegen,</para>
  <para style="q" vid="ISA 63:17">machst hart undzer harts, nisht moire tsu hobn far dir?</para>
  <para style="q" vid="ISA 63:17">ker zich um fun vegen daine knecht,</para>
  <para style="q" vid="ISA 63:17">di shvotim fun dain arav.<verse eid="ISA 63:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 63:18" />kemat fartriben hobn zei dain heilik folk;</para>
  <para style="q" vid="ISA 63:18">undzere faint hobn tsetretn dain heiliktum.<verse eid="ISA 63:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 63:19" />mir zainen gevorn vi di</para>
  <para style="q" vid="ISA 63:19">vos du host kein mol nisht geveltikt oif zei,</para>
  <para style="q" vid="ISA 63:19">vos dain nomen iz nisht gerufn gevorn oif zei.</para>
  <para style="b" vid="ISA 63:19" />
  <para style="q" vid="ISA 63:19">
    <char style="va">64.1</char>halevay tseraistu di himlen un niderst arop,</para>
  <para style="q" vid="ISA 63:19">di berg zoln zich treislen far dir;<verse eid="ISA 63:19" /></para>
  <chapter eid="ISA 63" />
  <chapter number="64" style="c" pubnumber="סד" sid="ISA 64" />
  <para style="q">
    <verse number="1" style="v" pubnumber="64.2" sid="ISA 64:1" /> azoi vi faier tsindt on trukene tsvaign,</para>
  <para style="q" vid="ISA 64:1">vi faier tut vaser tseblezlen –</para>
  <para style="q" vid="ISA 64:1">kedei tsu machn visen dain nomen tsu daine faint;</para>
  <para style="q" vid="ISA 64:1">di felker zoln tsiteren far dir,<verse eid="ISA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="64.3" sid="ISA 64:2" /> ven du tust forchtike zachn</para>
  <para style="q" vid="ISA 64:2">vos mir hobn tsu mol nisht gehoft –</para>
  <para style="q" vid="ISA 64:2">halevay niderstu arop,</para>
  <para style="q" vid="ISA 64:2">di berg zoln zich treislen far dir! –<verse eid="ISA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="64.4" sid="ISA 64:3" /> un vos zei hobn kein mol nisht gehert, nisht farnumen,</para>
  <para style="q" vid="ISA 64:3">vos kein oig hot nisht gezen,</para>
  <para style="q" vid="ISA 64:3">az a G-t achuts dir zol ton</para>
  <para style="q" vid="ISA 64:3">far dem vos tut harn oif im.<verse eid="ISA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" pubnumber="64.5" sid="ISA 64:4" /> host trefst dem vos hot zich gefreit tsu ton recht,</para>
  <para style="q" vid="ISA 64:4">di vos hobn gedacht on dir mit daine vegen;</para>
  <para style="q" vid="ISA 64:4">ze, du host getsernt, vail mir hobn gezindikt,</para>
  <para style="q" vid="ISA 64:4">durch zei ober flegn mir eibik geholfn vern.<verse eid="ISA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="64.6" sid="ISA 64:5" /> un mir zainen gevorn vi a tome ale,</para>
  <para style="q" vid="ISA 64:5">un ale undzere gerechtikeitn iz vi a baflekt kleid</para>
  <para style="q" vid="ISA 64:5">un mir velkn azoi vi a blat ale,</para>
  <para style="q" vid="ISA 64:5">un undzer zind trogt undz vi der vint avek.<verse eid="ISA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" pubnumber="64.7" sid="ISA 64:6" /> un nishto ver zol rufn dain nomen,</para>
  <para style="q" vid="ISA 64:6">ver zol zich dervekn zich tsu haltn on dir;</para>
  <para style="q" vid="ISA 64:6">vorem host farborgen dain ponem tsu undz,</para>
  <para style="q" vid="ISA 64:6">un undz gemacht tsegein durch undzere zind.<verse eid="ISA 64:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" pubnumber="64.8" sid="ISA 64:7" /> un atsund, Hashem, du bist undzer foter,</para>
  <para style="q" vid="ISA 64:7">mir zainen der leim, un du bist undzer teper,</para>
  <para style="q" vid="ISA 64:7">un dos verk fun daine hent zainen mir ale.<verse eid="ISA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="64.9" sid="ISA 64:8" /> nisht tserenen zolstu, Hashem, biz gor,</para>
  <para style="q" vid="ISA 64:8">un nisht oif eibik gedenken di zind;</para>
  <para style="q" vid="ISA 64:8">ze, lug, ich bet dich, dain folk zainen mir ale.<verse eid="ISA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" pubnumber="64.10" sid="ISA 64:9" /> daine heilike shtet zainen gevorn a midber,</para>
  <para style="q" vid="ISA 64:9">Tsiyon iz a midber gevorn,</para>
  <para style="q" vid="ISA 64:9">Yerushalayim a vistenish;<verse eid="ISA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="64.11" sid="ISA 64:10" /> undzer heilik un undzer prachtik hoiz,</para>
  <para style="q" vid="ISA 64:10">vu undzere eltern hobn dich geloibt,</para>
  <para style="q" vid="ISA 64:10">iz avek in brandfaier,</para>
  <para style="q" vid="ISA 64:10">un ale undzere glustikeitn zainen gevorn tsu vist.<verse eid="ISA 64:10" /></para>
  <para style="q">
    <verse number="11" style="v" pubnumber="64.12" sid="ISA 64:11" /> vilstu oif dem zich ainhaltn, Hashem?</para>
  <para style="q" vid="ISA 64:11">vilstu shvaign un undz painiken biz gor?<verse eid="ISA 64:11" /></para>
  <chapter eid="ISA 64" />
  <chapter number="65" style="c" pubnumber="סה" sid="ISA 65" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 65:1" />ich bin geven tsu derbetn</para>
  <para style="q" vid="ISA 65:1">far di vos hobn nisht gefregt;</para>
  <para style="q" vid="ISA 65:1">ich bin geven tsu gefinen</para>
  <para style="q" vid="ISA 65:1">far di vos hobn mich nisht gezucht;</para>
  <para style="q" vid="ISA 65:1">ich hob gezogt: do bin ich, do bin ich!</para>
  <para style="q" vid="ISA 65:1">tsu a folk vos ruft zich nisht oif main nomen.<verse eid="ISA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 65:2" />ich hob oisgeshpreit maine hent a gantsn tog</para>
  <para style="q" vid="ISA 65:2">tsu a folk an opkerer</para>
  <para style="q" vid="ISA 65:2">vos geit oifn nisht gutn veg,</para>
  <para style="q" vid="ISA 65:2">noch di trachtungen zeyere;<verse eid="ISA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 65:3" />tsu a folk vos dertsernt mich</para>
  <para style="q" vid="ISA 65:3">in main ponem nochanand;</para>
  <para style="q" vid="ISA 65:3">vos shlachtn in di gertner,</para>
  <para style="q" vid="ISA 65:3">un reichern oif di tsigl;<verse eid="ISA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 65:4" />vos zitsn tsvishn di kvorim,</para>
  <para style="q" vid="ISA 65:4">un in baheltenishn nechtikn zei;</para>
  <para style="q" vid="ISA 65:4">vos esen fleish fun chazir,</para>
  <para style="q" vid="ISA 65:4">un zup fun umverdikeitn iz in zeyere keilim;<verse eid="ISA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 65:5" />vos zogn: ruk dich op, zolst nisht genenen tsu mir,</para>
  <para style="q" vid="ISA 65:5">vorem ich bin dir heilik.</para>
  <para style="q" vid="ISA 65:5">di dozike zainen a roich in main noz,</para>
  <para style="q" vid="ISA 65:5">a faier vos brent a gantsn tog.<verse eid="ISA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 65:6" />ze, oifgeshribn iz dos far mir;</para>
  <para style="q" vid="ISA 65:6">ich vel nisht shvaign saidn ich hob opgetsolt,</para>
  <para style="q" vid="ISA 65:6">yo, opgetsolt in zeyer buzem,<verse eid="ISA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 65:7" />aiere zind in einem mit di zind</para>
  <para style="q" vid="ISA 65:7">fun aiere eltern, zogt Hashem,</para>
  <para style="q" vid="ISA 65:7">vos hobn gereichert oif di berg,</para>
  <para style="q" vid="ISA 65:7">un oif di heichn mich gelestert;</para>
  <para style="q" vid="ISA 65:7">derum vel ich opmestn tsuersht</para>
  <para style="q" vid="ISA 65:7">zeyer loit in zeyer buzem.<verse eid="ISA 65:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 65:8" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="ISA 65:8">azoi vi az der vain gefint zich in hengl,</para>
  <para style="q" vid="ISA 65:8">zogt men: zolst es nisht tseshtern,</para>
  <para style="q" vid="ISA 65:8">vorem a bentshung iz in im;</para>
  <para style="q" vid="ISA 65:8">azoi vel ich ton fun vegen maine knecht,</para>
  <para style="q" vid="ISA 65:8">nisht tsu tseshtern in gantsn.<verse eid="ISA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 65:9" />un ich vel aroisbrengen fun Yaakov a zomen,</para>
  <para style="q" vid="ISA 65:9">un fun Yehudah dem yoiresh fun maine berg;</para>
  <para style="q" vid="ISA 65:9">un yarshen veln es maine oisderveilte,</para>
  <para style="q" vid="ISA 65:9">un maine knecht veln dort voinen.<verse eid="ISA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 65:10" />un der Sharon vet zain far a fiterplats fun shof,</para>
  <para style="q" vid="ISA 65:10">un der tal Achor far a hoierung fun rinder,</para>
  <para style="q" vid="ISA 65:10">far main folk vos hot mich gezucht.<verse eid="ISA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 65:11" />ober ir vos farlozt Hashem,</para>
  <para style="q" vid="ISA 65:11">vos fargest on main heilikn barg,</para>
  <para style="q" vid="ISA 65:11">vos greit a tish tsum mezl,</para>
  <para style="q" vid="ISA 65:11">un filt on a mishtrank tsum basher,<verse eid="ISA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 65:12" />ich vel aich bashern tsum shverd,</para>
  <para style="q" vid="ISA 65:12">un ir ale vet knien tsu der shechite;</para>
  <para style="q" vid="ISA 65:12">vail ich hob gerufn un ir hot nisht geentfert,</para>
  <para style="q" vid="ISA 65:12">geredt, un ir hot nisht gehert;</para>
  <para style="q" vid="ISA 65:12">nor ir hot geton vos iz shlecht in maine oign,</para>
  <para style="q" vid="ISA 65:12">un vos ich hob nisht gevolt, hot ir oisgeveilt.<verse eid="ISA 65:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 65:13" />derum hot Adonoi Hashem azoi gezogt:</para>
  <para style="q" vid="ISA 65:13">ze, maine knecht veln esen,</para>
  <para style="q" vid="ISA 65:13">un ir vet zain hungerik;</para>
  <para style="q" vid="ISA 65:13">ze, maine knecht veln trinken,</para>
  <para style="q" vid="ISA 65:13">un ir vet zain dorshtik;</para>
  <para style="q" vid="ISA 65:13">ze, maine knecht veln zich freyen,</para>
  <para style="q" vid="ISA 65:13">un ir vet farshemt vern.<verse eid="ISA 65:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 65:14" />ze, maine knecht veln zingen fun hartsfreid,</para>
  <para style="q" vid="ISA 65:14">un ir vet shraien fun hartsvei,</para>
  <para style="q" vid="ISA 65:14">un fun a tsebrochn gemit vet ir yomern.<verse eid="ISA 65:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 65:15" />un ir vet lozn aier nomen</para>
  <para style="q" vid="ISA 65:15">far a klole tsu maine oisderveilte:</para>
  <para style="q" vid="ISA 65:15">azoi zol Adonoi Hashem dich teitn!</para>
  <para style="q" vid="ISA 65:15">un zaine knecht vet er rufn an ander nomen;<verse eid="ISA 65:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 65:16" />az der vos bentsht zich oif der erd,</para>
  <para style="q" vid="ISA 65:16">vet zich bentshn baim Elokim fun emes,</para>
  <para style="q" vid="ISA 65:16">un der vos shvert oif der erd,</para>
  <para style="q" vid="ISA 65:16">vet shvern baim Elokim fun emes;</para>
  <para style="q" vid="ISA 65:16">vail fargesen zainen di frierdike tsores,</para>
  <para style="q" vid="ISA 65:16">un vail zei zainen farborgen fun maine oign.<verse eid="ISA 65:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 65:17" />vorem ze, ich bashaf himlen naie,</para>
  <para style="q" vid="ISA 65:17">un an erd a naie;</para>
  <para style="q" vid="ISA 65:17">un dos frierdike vet nisht gedacht vern,</para>
  <para style="q" vid="ISA 65:17">un oifn zinen nisht in dem harts oifkumen.<verse eid="ISA 65:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 65:18" />nor zait lustik un freit zich biz eibik</para>
  <para style="q" vid="ISA 65:18">mit dem vos ich bashaf;</para>
  <para style="q" vid="ISA 65:18">vorem ze, ich bashaf Yerushalayim far a lustikeit,</para>
  <para style="q" vid="ISA 65:18">un ir folk far a freid.<verse eid="ISA 65:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 65:19" />un ich vel zich freyen mit Yerushalayim,</para>
  <para style="q" vid="ISA 65:19">un vel lustik zain mit main folk;</para>
  <para style="q" vid="ISA 65:19">un nisht gehert vern vet in ir mer</para>
  <para style="q" vid="ISA 65:19">a kol fun gevein, un a kol fun geshrei.<verse eid="ISA 65:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 65:20" />mer vet nisht zain fun dortn</para>
  <para style="q" vid="ISA 65:20">a kind in teg, oder a zoken,</para>
  <para style="q" vid="ISA 65:20">vos vet nisht derfiln zaine teg;</para>
  <para style="q" vid="ISA 65:20">vorem der yingster vet tsu hundert yor shtarbn,</para>
  <para style="q" vid="ISA 65:20">un a zindiker vet mit hundert yor gesholtn vern.<verse eid="ISA 65:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 65:21" />un zei veln boien haizer un bavoinen,</para>
  <para style="q" vid="ISA 65:21">un flantsn vaingertner un esen zeyer frucht.<verse eid="ISA 65:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 65:22" />zei veln nisht boien,</para>
  <para style="q" vid="ISA 65:22">un an anderer zol bavoinen,</para>
  <para style="q" vid="ISA 65:22">zei veln nisht flantsn,</para>
  <para style="q" vid="ISA 65:22">un an anderer zol esen;</para>
  <para style="q" vid="ISA 65:22">vorem azoi vi di teg fun a boim</para>
  <para style="q" vid="ISA 65:22">veln zain di teg fun main folk,</para>
  <para style="q" vid="ISA 65:22">un maine oisderveilte veln farnutsn</para>
  <para style="q" vid="ISA 65:22">dos verk fun zeyere hent.<verse eid="ISA 65:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 65:23" />zei veln zich nisht mien umnisht,</para>
  <para style="q" vid="ISA 65:23">zei veln nisht gebern far a behole,</para>
  <para style="q" vid="ISA 65:23">vorem a zomen gebentsht fun Hashem zainen zei,</para>
  <para style="q" vid="ISA 65:23">un zeyere shprotsn mit zei.<verse eid="ISA 65:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 65:24" />un es vet zain,</para>
  <para style="q" vid="ISA 65:24">eider zei rufn, vel ich entfern,</para>
  <para style="q" vid="ISA 65:24">vi zei redn noch, azoi vel ich tsuhern.<verse eid="ISA 65:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 65:25" />a volf un a lam veln zich fitern in einem,</para>
  <para style="q" vid="ISA 65:25">un a leib vet vi a rind esen shtroi;</para>
  <para style="q" vid="ISA 65:25">un a shlang – ir shpaiz vet zain shtoib;</para>
  <para style="q" vid="ISA 65:25">zei veln nisht beiz ton un nisht fardorben</para>
  <para style="q" vid="ISA 65:25">oif main gantsn heilikn barg,</para>
  <para style="q" vid="ISA 65:25">zogt Hashem.<verse eid="ISA 65:25" /></para>
  <chapter eid="ISA 65" />
  <chapter number="66" style="c" pubnumber="סו" sid="ISA 66" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 66:1" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="ISA 66:1">der himel iz main tron,</para>
  <para style="q" vid="ISA 66:1">un di erd iz main fusbenkel;</para>
  <para style="q" vid="ISA 66:1">vu iz dos hoiz vos ir kent mir boien?</para>
  <para style="q" vid="ISA 66:1">un vu der ort fun main ruung?<verse eid="ISA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 66:2" />az di ale hot main hant gemacht,</para>
  <para style="q" vid="ISA 66:2">un azoi zainen di ale gevorn,</para>
  <para style="q" vid="ISA 66:2">zogt Hashem.</para>
  <para style="q" vid="ISA 66:2">ober oif azelchn tu ich kukn:</para>
  <para style="q" vid="ISA 66:2">oif dem oreman un dershlogenem in gemit,</para>
  <para style="q" vid="ISA 66:2">un dem vos tsitert iber main vort.<verse eid="ISA 66:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 66:3" />der vos shecht an oks,</para>
  <para style="q" vid="ISA 66:3">dershlogt a mentshn;</para>
  <para style="q" vid="ISA 66:3">der vos shlacht a sheps,</para>
  <para style="q" vid="ISA 66:3">hakt op dos genik fun a hunt;</para>
  <para style="q" vid="ISA 66:3">der vos brengt oif a shpaizopfer,</para>
  <para style="q" vid="ISA 66:3">brengt oif blut fun a chazir;</para>
  <para style="q" vid="ISA 66:3">der vos reichert vairech,</para>
  <para style="q" vid="ISA 66:3">bentsht an opgot.</para>
  <para style="q" vid="ISA 66:3">azoi vi zei hobn oisgeveilt zeyere vegen,</para>
  <para style="q" vid="ISA 66:3">un zeyere umverdikeitn hot bagert zeyer zel,<verse eid="ISA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 66:4" />azoi vel ich oich oisveiln geshpetn iber zei,</para>
  <para style="q" vid="ISA 66:4">un zeyere shrekenishn vel ich brengen oif zei;</para>
  <para style="q" vid="ISA 66:4">vail ich hob gerufn, un keiner hot nisht geentfert,</para>
  <para style="q" vid="ISA 66:4">geredt, un zei hobn nisht gehert;</para>
  <para style="q" vid="ISA 66:4">nor zei hobn geton vos iz shlecht in maine oign,</para>
  <para style="q" vid="ISA 66:4">un vos ich hob nisht gevolt hobn zei oisgeveilt.<verse eid="ISA 66:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 66:5" />hert dos vort fun Hashem,</para>
  <para style="q" vid="ISA 66:5">ir vos tsitert iber zain vort:</para>
  <para style="q" vid="ISA 66:5">es hobn gezogt aiere brider vos hobn aich faint,</para>
  <para style="q" vid="ISA 66:5">di vos farshtoisen aich fun vegen main nomen:</para>
  <para style="q" vid="ISA 66:5">zol Hashem geerlecht vern,</para>
  <para style="q" vid="ISA 66:5">un lomir zen aier simche!</para>
  <para style="q" vid="ISA 66:5">ober zei veln farshemt vern.<verse eid="ISA 66:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 66:6" />a kol fun tuml fun der shtot,</para>
  <para style="q" vid="ISA 66:6">a kol fun dem heichl!</para>
  <para style="q" vid="ISA 66:6">a kol fun Hashem vos batsolt</para>
  <para style="q" vid="ISA 66:6">fargeltung tsu zaine faint.<verse eid="ISA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 66:7" />eider zi hot geveitokt,</para>
  <para style="q" vid="ISA 66:7">hot zi geborn;</para>
  <para style="q" vid="ISA 66:7">eider veyenish iz gekumen oif ir,</para>
  <para style="q" vid="ISA 66:7">azoi hot zi a yingel gehat.<verse eid="ISA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 66:8" />ver hot gehert azoins?</para>
  <para style="q" vid="ISA 66:8">ver hot gezen azoi-vos?</para>
  <para style="q" vid="ISA 66:8">vert a land oisgeveitokt in ein tog?</para>
  <para style="q" vid="ISA 66:8">vert geborn a folk mit ein mol?</para>
  <para style="q" vid="ISA 66:8">vorem vi Tsiyon hot geveitokt,</para>
  <para style="q" vid="ISA 66:8">azoi hot zi ire kinder geborn.<verse eid="ISA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 66:9" />vel ich biz geburt brengen,</para>
  <para style="q" vid="ISA 66:9">un nisht machn gebern? zogt Hashem;</para>
  <para style="q" vid="ISA 66:9">vel ich, vos mach gebern, farhaltn?</para>
  <para style="q" vid="ISA 66:9">zogt dain G-t.<verse eid="ISA 66:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 66:10" />freit zich mit Yerushalayim,</para>
  <para style="q" vid="ISA 66:10">un kvelt on in ir, ale ire libhober;</para>
  <para style="q" vid="ISA 66:10">lustikt aich lustik mit ir,</para>
  <para style="q" vid="ISA 66:10">ir ale vos troiert oif ir;<verse eid="ISA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 66:11" />vail ir vet zeign un zich zetn</para>
  <para style="q" vid="ISA 66:11">fun der brust fun ire nchmut,</para>
  <para style="q" vid="ISA 66:11">vail ir vet zupn un zich kvikn</para>
  <para style="q" vid="ISA 66:11">fun dem zoignopl fun ir shefe.<verse eid="ISA 66:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 66:12" />vorem azoi hot Hashem gezogt:</para>
  <para style="q" vid="ISA 66:12">ze, ich naig tsu ir sholem vi a taich,</para>
  <para style="q" vid="ISA 66:12">un vi a fleitsikn shtrom di raichkeit fun di felker,</para>
  <para style="q" vid="ISA 66:12">un ir vet zeign derfun.</para>
  <para style="q" vid="ISA 66:12">oifn zait vet ir getrogn vern,</para>
  <para style="q" vid="ISA 66:12">un oif di kni vet ir getsertlt vern.<verse eid="ISA 66:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 66:13" />vi einer vos zain muter tut im treistn,</para>
  <para style="q" vid="ISA 66:13">azoi vel ich aich treistn;</para>
  <para style="q" vid="ISA 66:13">un in Yerushalayim vet ir getreist vern.<verse eid="ISA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 66:14" />un ir vet zen, un aier harts vet zich freyen,</para>
  <para style="q" vid="ISA 66:14">un aiere beiner veln vi groz blien;</para>
  <para style="q" vid="ISA 66:14">un di hant fun Hashem vet dervust vern bai zaine knecht,</para>
  <para style="q" vid="ISA 66:14">un er vet tserenen oif zaine faint.<verse eid="ISA 66:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 66:15" />vorem ze, Hashem vet kumen mit faier,</para>
  <para style="q" vid="ISA 66:15">un vi a shturemvint zaine raitvegn,</para>
  <para style="q" vid="ISA 66:15">oistsulozn mit geirem zain tsorn,</para>
  <para style="q" vid="ISA 66:15">un zain ongeshrei mit flamen faier.<verse eid="ISA 66:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 66:16" />vorem mit faier tut zich mishpetn Hashem,</para>
  <para style="q" vid="ISA 66:16">un mit zain shverd, mit ale laiber;</para>
  <para style="q" vid="ISA 66:16">un fil veln zain di dershlogene fun Hashem.<verse eid="ISA 66:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17" />di vos heilikn zich un reiniken zich tsu gein in di gertner, hinter einer in mitn, di vos esen fleish fun chazir, un umverdikeitn un maiz, veln in einem farlendt vern, zogt Hashem. <verse eid="ISA 66:17" /><verse number="18" style="v" sid="ISA 66:18" />vorem zeyere meisim un zeyere trachtungen; di tsait kumt aintsuzamlen ale felker un leshoines, zei zoln kumen un zen main koved. <verse eid="ISA 66:18" /><verse number="19" style="v" sid="ISA 66:19" />un ich vel ton tsvishn zei a vundertseichn, un ich vel shikn fun zei antrunene tsu di felker, tsu Tarshish, Pul, un Lud, di boignshpaners, tsu Tuval un Yavan, di vaite indzelen, vos hobn nisht gehert main herung, un nisht gezen main koved; un zei veln dertseiln main koved tsvishn di felker. <verse eid="ISA 66:19" /><verse number="20" style="v" sid="ISA 66:20" />un zei veln brengen ale aiere brider, fun ale felker, a matone tsu Hashem, oif ferd un oif kotshn un oif trogvegn, un oif moileizlen, un oif yogkemlen, tsu main heilikn barg Yerushalayim, zogt Hashem, azoi vi di kinder fun Yisroel brengen dos shpaizopfer in a reiner keile in hoiz fun Hashem. <verse eid="ISA 66:20" /><verse number="21" style="v" sid="ISA 66:21" />un oich fun zei vel ich nemen far koyanim un far Leviim, zogt Hashem.<verse eid="ISA 66:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 66:22" />vorem vi di naie himlen,</para>
  <para style="q" vid="ISA 66:22">un di naie erd, vos ich mach,</para>
  <para style="q" vid="ISA 66:22">veln bashtein far mir, zogt Hashem,</para>
  <para style="q" vid="ISA 66:22">azoi vet bashtein aier zomen un aier nomen.<verse eid="ISA 66:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 66:23" />un es vet zain,</para>
  <para style="q" vid="ISA 66:23">rosh-choidesh in rosh-choidesh,</para>
  <para style="q" vid="ISA 66:23">un Shabbos in Shabbos,</para>
  <para style="q" vid="ISA 66:23">veln kumen ale laiber,</para>
  <para style="q" vid="ISA 66:23">zich bukn far mir, zogt Hashem.<verse eid="ISA 66:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="ISA 66:24" />un zei veln aroisgein un veln kukn oif di pegorim fun di mentshn vos hobn gebrochn on mir; vorem zeyer vorem vet nisht shtarbn, un zeyer faier vet nisht farloshn vern, un zei veln zain an farshemen far ale fleish.<verse eid="ISA 66:24" /></para>
  <chapter eid="ISA 66" />
</usx>