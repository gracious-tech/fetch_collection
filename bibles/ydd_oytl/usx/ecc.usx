<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Kohelet</para>
  <para style="toc2">Kohelet</para>
  <para style="toc1">Kohelet</para>
  <para style="mt1">Kohelet</para>
  <chapter number="1" style="c" pubnumber="א" sid="ECC 1" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />di verter fun Kohelet dem zun fun Dovidn, dem melech in Yerushalayim.<verse eid="ECC 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ECC 1:2" />nishtikeit fun nishtikeitn, zogt Kohelet,</para>
  <para style="q" vid="ECC 1:2">nishtikeit fun nishtikeitn, alts iz nishtikeit.<verse eid="ECC 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 1:3" />vos far a nuts hot der mentsh fun zain gantser mi</para>
  <para style="q" vid="ECC 1:3">vos er mit zich unter der zun?<verse eid="ECC 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 1:4" />a dor fargeit, un a dor kumt,</para>
  <para style="q" vid="ECC 1:4">un di erd bashteit eibik.<verse eid="ECC 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 1:5" />un di zun geit oif, un di zun geit unter,</para>
  <para style="q" vid="ECC 1:5">un yogt tsu ir ort vu zi geit oif.<verse eid="ECC 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 1:6" />der vint geit kein dorem,</para>
  <para style="q" vid="ECC 1:6">un fardreit zich kein tsofn,</para>
  <para style="q" vid="ECC 1:6">rund arum, rund arum geit er,</para>
  <para style="q" vid="ECC 1:6">un tsu zaine gedreyen kert zich um der vint.<verse eid="ECC 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 1:7" />ale taichn geyen tsum yam,</para>
  <para style="q" vid="ECC 1:7">un der yam vert nisht ful;</para>
  <para style="q" vid="ECC 1:7">tsu dem ort vuhin di taichn geyen,</para>
  <para style="q" vid="ECC 1:7">ahin geyen zei vider.<verse eid="ECC 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 1:8" />ale zachn vern mid,</para>
  <para style="q" vid="ECC 1:8">kein mentsh ken es nisht aroisredn;</para>
  <para style="q" vid="ECC 1:8">dos oig ken zich nisht onkukn zat,</para>
  <para style="q" vid="ECC 1:8">un dos oier ken zich nisht onhern ful.<verse eid="ECC 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 1:9" />vos iz geven dos vet zain,</para>
  <para style="q" vid="ECC 1:9">un vos iz geshen dos vet geshen,</para>
  <para style="q" vid="ECC 1:9">un nishto kein nais unter der zun.<verse eid="ECC 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ECC 1:10" />faran a zach vos me zogt deroif:</para>
  <para style="q" vid="ECC 1:10">ze, dos iz a nais;</para>
  <para style="q" vid="ECC 1:10">iz es shoin geven in alte tsaitn</para>
  <para style="q" vid="ECC 1:10">vos zainen geven far undz.<verse eid="ECC 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 1:11" />nishto kein zocher fun di frierdike,</para>
  <para style="q" vid="ECC 1:11">un fun di shpeterdike vos veln ersht zain,</para>
  <para style="q" vid="ECC 1:11">oich fun zei vet kein zocher nisht zain,</para>
  <para style="q" vid="ECC 1:11">tsvishn di vos veln zain noch shpeter.<verse eid="ECC 1:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />ich Kohelet bin geven a melech iber Yisroel in Yerushalayim. <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />un ich hob opgegebn main harts tsu zuchn un tsu forshn mit chochme vegen alts vos geshet unter di himlen. dos iz a shlechter Unnien vos Elokim hot gegebn di mentshnkinder, zich tsu farnemen dermit. <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />ich hob gezen ale tuenishn vos vern geton unter der zun, ersht alts iz nishtikeit un vintyogenish;<verse eid="ECC 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ECC 1:15" />a krumkeit vos me ken nisht oisglaichn,</para>
  <para style="q" vid="ECC 1:15">un a feler vos ken nisht gut gemacht vern.<verse eid="ECC 1:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />ich hob getenht mit main hartsn azoi tsu zogn: ot hob ich gehat chochme greser un mer eider ale vos zainen geven far mir in Yerushalayim, un main harts hot gezen fil chochme un kentshaft. <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />un ich hob opgegebn main harts tsu farshtein chochme, oich farshtein meshugas un narishkeit – bin ich gevor gevorn az dos oich iz vintyogenish.<verse eid="ECC 1:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ECC 1:18" />vorem in fil chochme iz fil fardros,</para>
  <para style="q" vid="ECC 1:18">un mert men kentshaft, mert men veitog.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="ECC 2" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />ich hob gezogt bai mir in hartsn: kum akorsht, lomich dich pruvn mit freid, un hob voiltog; ersht dos oich iz nishtikeit. <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />oif gelechter hob ich gezogt: es iz meshuge; un oif freid: vos tut zi oif? <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />ich hob oisgeklert bai mir in hartsn tsu fartsien main laib mit vain, az i main harts zol zich firn mit chochme, i ich zol mich haltn on narishkeit, biz ich vel zen vos iz beser far di mentshnkinder az zei zoln ton untern himel in di getseilte teg fun zeyer lebn. <verse eid="ECC 2:3" /><verse number="4" style="v" sid="ECC 2:4" />ich hob mir oifgeton groise zachn; ich hob mir geboit haizer, ich hob mir geflantst vaingertner; <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />ich hob mir gemacht gertner un seder un aingeflantst in zei beimer fun alerlei peires. <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />ich hob mir gemacht vasertaichn ontsutrinken fun zei dem vaksikn vald vos shprotst mit beimer. <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />ich hob aingekoift knecht un dinstn, un hoizgeborene hob ich gehat; oich an eigens fun rinder un shof a sach hob ich gehat, mer fun ale vos zainen geven far mir in Yerushalayim. <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />ich hob mir ongezamlt oich zilber un gold, un shatsn fun mlochim un medines. ich hob mir aingeshaft zingers un zingerins, un tenugim fun mentshnkinder, vaiber oif vaiber.<verse eid="ECC 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9" />un ich bin geven greser un hob farmogt mer fun ale vos zainen geven far mir in Yerushalayim; oich iz main chochme mir baigeshtanen. <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />un vos nor maine oign hobn farlangt, hob ich fun zei nisht geminert; ich hob nisht farmitn main harts fun kein freid, naiert main harts hot zich voil geton mit main gantser mi, vorem dos iz geven main chelek fun main gantser mi. <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />ober ich hob zich umgekukt oif ale maine oiftuen vos maine hent hobn oifgeton, un oif der mi vos ich hob mich gemit kedei dos oiftsuton, ersht alts nishtikeit un vintyogenish, un gornisht kumt arois unter der zun.<verse eid="ECC 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />un ich hob mich gekert tsu bakukn chochme un meshugas un narishkeit; vorem vos ken oifton der mentsh vos kumt nochn melech? bloiz dos vos me hot shoin frier geton. <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />un ich hob aingezen az di maile fun chochme iber narishkeit iz azoi vi di maile fun lichtikeit iber fintsternish. <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />der chochem hot zaine oign in kop, un der nor geit in der fintster. ober ich hob oich gemerkt az ein traf treft zei alemen. <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />un ich hob gezogt bai mir in hartsn: azoi vi es treft dem narn azoi vet oich mich trefn, haint noch vos den bin ich geven kliger? un ich hob getenht bai mir in hartsn, az dos oich iz nishtikeit. <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />vorem fun dem chochem azoi vi fun dem narn blaibt nisht kein zocher oif eibik; vail in di kumedike teg vet alts zain shoin fargesen; un vi shtarbt der chochem? azoi vi der nor. <verse eid="ECC 2:16" /><verse number="17" style="v" sid="ECC 2:17" />un ich hob faint gekrogn dos lebn, vorem mir iz oisgekumen shlecht di gesheung vos geshet unter der zun, vail alts iz nishtikeit un vintyogenish.<verse eid="ECC 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 2:18" />un ich hob faint gekrogn main gantse mi vos ich mi mich deroif unter der zun, kedei az ich muz es iberlozen tsu a mentshn vos vet zain noch mir. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />un ver veis oib er vet zain a chochem oder a nor? fun dest vegen vet er geveltikn iber main gantser mi vos ich hob mich gemit un gekligt deroif unter der zun. dos oich iz nishtikeit. <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />un ich hob mich umgedreit tsu lozn main harts zich meyaesh tsu zain fun der gantser mi vos ich hob mich gemit unter der zun. <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />vorem faran a mentsh vos zain mi iz mit chochme, un mit kenshaft, un mit brihshaft, un er lozt es iber far a chelek tsu a mentshn vos hot zich deroif nisht gemit. dos oich iz nishtikeit un a grois beiz. <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />vorem vos hot der mentsh fun zain gantser mi, un fun dem havn fun zain hartsn, az er zol zich mien unter der zun? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />vorem ale zaine teg zainen veitogn, un zain esk iz ergernish; afile bai nacht ligt nisht ain zain harts. dos oich iz nishtikeit.<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />nishto besers faran mentshn, vi er zol esen un trinken, un zich lozn voil gein far zain mi. dos oich, hob ich aingezen, az dos iz fun G-ts hant – <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />vorem: ver zol esen un ver zol hanoe hobn, on im – Hashem? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />vail dem mentshn vos iz voilgefeln far im, git er chochme, un kenshaft, un freid; un dem zindikn git er an esk tsu klaibn un tsu zamlen, kedei ibertsulozn tsu dem vos iz voilgefeln far Elokim. dos oich iz nishtikeit un vintyogenish.<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="ECC 3" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />oif alts iz do a sheh, un a tsait far itlecher zach untern himel:<verse eid="ECC 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ECC 3:2" />a tsait geborn tsu vern,</para>
  <para style="q" vid="ECC 3:2">un a tsait tsu shtarbn;</para>
  <para style="q" vid="ECC 3:2">a tsait tsu flantsn,</para>
  <para style="q" vid="ECC 3:2">un a tsait oistsuraisn dos geflantste.<verse eid="ECC 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 3:3" />a tsait tsu hargen,</para>
  <para style="q" vid="ECC 3:3">un a tsait tsu heiln;</para>
  <para style="q" vid="ECC 3:3">a tsait tsu brechn,</para>
  <para style="q" vid="ECC 3:3">un a tsait tsu boien.<verse eid="ECC 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 3:4" />a tsait tsu veinen,</para>
  <para style="q" vid="ECC 3:4">un a tsait tsu lachn;</para>
  <para style="q" vid="ECC 3:4">a tsait tsu klogn,</para>
  <para style="q" vid="ECC 3:4">un a tsait tsu tantsn.<verse eid="ECC 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 3:5" />a tsait avektsuvarfn shteiner,</para>
  <para style="q" vid="ECC 3:5">un a tsait oiftsuklaibn shteiner;</para>
  <para style="q" vid="ECC 3:5">a tsait tsu haldzn,</para>
  <para style="q" vid="ECC 3:5">un a tsait zich tsu dervaitern fun haldzn.<verse eid="ECC 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 3:6" />a tsait tsu zuchn,</para>
  <para style="q" vid="ECC 3:6">un a tsait ontsuvern;</para>
  <para style="q" vid="ECC 3:6">a tsait tsu hitn,</para>
  <para style="q" vid="ECC 3:6">un a tsait avektsuvarfn.<verse eid="ECC 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 3:7" />a tsait tsu raisn,</para>
  <para style="q" vid="ECC 3:7">un a tsait tsu neyen;</para>
  <para style="q" vid="ECC 3:7">a tsait tsu shvaign,</para>
  <para style="q" vid="ECC 3:7">un a tsait tsu redn.<verse eid="ECC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 3:8" />a tsait lib tsu hobn,</para>
  <para style="q" vid="ECC 3:8">un tsait faint tsu hobn;</para>
  <para style="q" vid="ECC 3:8">a tsait far milchome,</para>
  <para style="q" vid="ECC 3:8">un a tsait far sholem.<verse eid="ECC 3:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />vos far a nutsn hot der tuer fun der arbet in dem vos er bamit zich? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />ich hob gezen dem esk vos Elokim hot gegebn di mentshnkinder zich tsu eskn dermit. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />altsding hot er gemacht shein in zain tsait, er hot afile di oilem gegebn in zeyer harts di kavone az der mentsh zol nisht kenen oisgefinen di meisim vos G-t hot geton fun onheib biz tsum sof. <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />ich veis az nishto besers far zei, vi nor zich tsu freyen, un zich voil tsu ton, in zeyer lebn. ober oich az emetser a mentsh est un trinkt, un hot voiltog far al zain mi, <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />iz dos a matone fun Elokim.<verse eid="ECC 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14" />ich veis az alts vos Elokim macht, dos vet zain eibik; dertsu iz nisht tsutsuleigen, un derfun iz nisht tsu minern; un Elokim hot gemacht az me zol moire hobn far im. <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />dos vos iz shoin geven iz itst; un dos vos vet noch zain iz oich shoin geven un Elokim vet rufn dos vos iz fargangen tsu rechenshaft.<verse eid="ECC 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />un noch hob ich gezen unter der zun: in dem ort fun gerechtikeit, dortn iz umrecht, un in dem ort fun rechtfartikeit, dortn iz umrecht. <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />hob ich gezogt bai zich in hartsn: i dem tsadik i dem roshe vet Elokim mishpetn, vorem a tsait far itlecher zach un far itlecher tuung iz dortn do. <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />ich hob gezogt bai zich in hartsn: dos iz fun vegen di mentshnkinder; kedei Elokim zol zei laitern, un kedei zei alein zoln zen az zei zainen vi a beheime. <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />vorem der traf fun di mentshnkinder iz der traf fun der beheime; ein traf bai zei. vi der shtarbt, azoi shtarbt der, un ein otem bai beidn, un kein maile fun mentshn iber der beheime iz nishto, vorem alts iz nishtikeit. <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />beide kumen ahin in ein ort, beide zainen fun shtoib, un beide kern zich um tsu shtoib. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />ver veis dem gaist fun di mentshnkinder, oib er geit aroif in der heich, un dem gaist fun der beheime, oib er nidert unten tsu der erd? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />un ich hob aingezen az nishto besers, vi der mentsh zol hanoe hobn fun zaine oiftuen, vorem dos iz zain chelek; vail ver vet im brengen ontsukukn vos vet zain noch im?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />un ich hob vider gezen ale roiberaien vos vern opgeton unter der zun. un ot zainen di trern fun di gedrikte, un nishto ver zol zei treistn; un oif der zait fun zeyere driker iz di macht, un nishto ver zol zei treistn. <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />derum halt ich di toite vos zainen shoin geshtorbn far gliklecher fun di lebedike vos lebn noch. <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />un beser fun zei beidn iz dem vos iz noch nisht geven, vos hot nisht gezen di shlechte meisim vos vern opgeton unter der zun.<verse eid="ECC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />un ich hob gezen yetveder mi, un yetveder brihshaft in arbet, az dos iz ois kine fun einem tsum andern. dos oich iz nishtikeit un vintyogenish.<verse eid="ECC 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 4:5" />der nor farleigt zaine hent, un est zain eigen fleish.<verse eid="ECC 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 4:6" />beser a hantful menuche, eider fule hoifns mi un vintyogenish.<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />un ich hob vider gezen nishtikeit unter der zun. <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />faran einer, on a tsveitn tsu zich; tsu mol a zun oder a bruder hot er nisht, fun dest vegen iz nishto kein end tsu zain mienish, un zain oig ken zich nisht onzetn mit eshires, un far vemen mi ich mich, un miner zich fun guts? dos oich iz nishtikeit, un es iz a shlechter Unnien.<verse eid="ECC 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />beser tsvei eider einer, vorem zei hobn a gutn loin far zeyer mi. <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />vorem az zei faln, heibt einer oif dem andern, ober vei tsu dem eintslnem vos falt, un nishto a tsveiter im oiftsuheibn. <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />dos glaichn az tsvei lign bainand, iz zei varem, ober einem vi ken varem vern? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />un oib emetser ken ibershtarkn dem einem, veln ober tsvei zich shteln kegen im. un a draifold fodem vet nisht oif gich tserisn vern.<verse eid="ECC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />beser an orim yingel un a chochem, eider an alter melech un a nor, vos veis nisht mer tsu zain opgehit. <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />vorem fun gefenkenish iz yener aroisgegangen tsu vern a melech, hagam er iz geborn gevorn orim, unter zain meluche. <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />ich hob gezen ale lebedike vos geyen unter der zun, haltn mit dem yingel, dem tsveitn vos shteit oif zain ort; <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />nisht geven kein end tsu al dem folk, tsu ale vos er iz geven zeyer onfirer; fun dest vegen veln di shpeterdike zich nisht freyen mit im. yo, dos oich iz nishtikeit un vintyogenish.<verse eid="ECC 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="5.1" sid="ECC 4:17" /> hit dain fus, az du geist in dem hoiz fun HaElokim, vorem gehorchn iz ongeleigter, vi vos di narn gibn a shlachtopfer; hagam zei veisn nisht az zei tuen shlecht.<verse eid="ECC 4:17" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="ECC 5" />
  <para style="p">
    <verse number="1" style="v" pubnumber="5.2" sid="ECC 5:1" /> zolst nisht zain hastik mit dain moil, un dain harts zol zich nisht ailn aroistsulozn a vort far Elokim, vorem Elokim iz in himel un du bist oif der erd; derum zoln daine verter zain vintsik. <verse eid="ECC 5:1" /><verse number="2" style="v" pubnumber="5.3" sid="ECC 5:2" /> vorem a cholem kumt mit fil geshilder, un der kol fun a narn mit fil verter.<verse eid="ECC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="5.4" sid="ECC 5:3" />az du bist mender a neyder tsu Elokim, zolstu zich nisht shpetikn im tsu batsoln, vorem er hot nisht lib narn; vos du bist mender, batsol. <verse eid="ECC 5:3" /><verse number="4" style="v" pubnumber="5.5" sid="ECC 5:4" /> beser zolst nisht mender zain, eider zolst mender zain un nisht batsoln. <verse eid="ECC 5:4" /><verse number="5" style="v" pubnumber="5.6" sid="ECC 5:5" /> zolst nisht derlozn dain moil tsu farzindiken dain laib, un zolst nisht zogn far dem sheliech fun Elokim, az dos iz geven a farze. noch vos zol Elokim tserenen oif dain kol, un tseshtern dos verk fun daine hent? <verse eid="ECC 5:5" /><verse number="6" style="v" pubnumber="5.7" sid="ECC 5:6" /> vorem fun fil chaloimes un narishkeitn kumen arois fil tsuzogn, ober hob moire far Elokim.<verse eid="ECC 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="5.8" sid="ECC 5:7" /> az du zest di drikung fun dem oreman, un di baroibung fun recht un gerechtikeit in der medine, zolstu zich nisht vundern oif der zach, vorem iber dem hoichn git achtung a hecherer, un noch hechere iber zei. <verse eid="ECC 5:7" /><verse number="8" style="v" pubnumber="5.9" sid="ECC 5:8" /> un a maile fun a land in alem, iz a melech ibergegebn tsu feld.<verse eid="ECC 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="5.10" sid="ECC 5:9" /> der vos hot lib gelt ken zich nisht onzetn mit gelt, un nisht ver es hot lib raichtum – mitn ainkum. dos oich iz nishtikeit. <verse eid="ECC 5:9" /><verse number="10" style="v" pubnumber="5.11" sid="ECC 5:10" /> az dos guts mert zich, mern zich zaine esers; un vos kumt arois dem eigentimer, achuts dos onkukn mit zaine oign? <verse eid="ECC 5:10" /><verse number="11" style="v" pubnumber="5.12" sid="ECC 5:11" /> zis iz der shlof fun dem vos arbet, sai er est vintsik, sai fil, ober di zet fun dem oysher lozt im nisht shlofn.<verse eid="ECC 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="5.13" sid="ECC 5:12" /> faran a fardrosiker veitog vos ich hob gezen unter der zun: an eshires vos vert gehit fun dem eigentimer im tsum beizn. <verse eid="ECC 5:12" /><verse number="13" style="v" pubnumber="5.14" sid="ECC 5:13" /> un di eshires vert farlorn in a shlechtn esk; un az er hot a zun, blaibt gornisht in zain hant. <verse eid="ECC 5:13" /><verse number="14" style="v" pubnumber="5.15" sid="ECC 5:14" /> azoi vi er iz arois fun zain muterlaib, geit er naket tsurik, azoi vi er iz gekumen, un kein zach nemt er nisht mit far zain mi, kedei er zol es avektrogen in zain hant. <verse eid="ECC 5:14" /><verse number="15" style="v" pubnumber="5.16" sid="ECC 5:15" /> yo, dos oich iz a fardrosiker veitog, vos genoi vi er iz gekumen, azoi geit er avek; un vos kumt im arois vos er mit zich faran vint? <verse eid="ECC 5:15" /><verse number="16" style="v" pubnumber="5.17" sid="ECC 5:16" /> dertsu fartsert er ale zaine teg in fintsternish, un ergert zich a sach, un hot ergernish un krenkenish un tsorn.<verse eid="ECC 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="5.18" sid="ECC 5:17" />ot vos ich hob aingezen: beser un shener volt geven tsu esen un trinken, un hobn voiltog far zain gantser mi vos er mit zich unter der zun in di getseilte teg fun zain lebn vos Elokim hot im geshonken; vorem dos iz zain chelek. <verse eid="ECC 5:17" /><verse number="18" style="v" pubnumber="5.19" sid="ECC 5:18" /> un itlecher mentsh vos Elokim shenkt im eshires un giter, un git im shlite tsu esen derfun, un tsu nemen zain chelek, un zich voil tsu ton far zain mi, iz dos a matone fun Elokim. <verse eid="ECC 5:18" /><verse number="19" style="v" pubnumber="5.20" sid="ECC 5:19" /> yo, er darf gedenken az di teg fun zain lebn zainen nisht fil – ven Elokim bavert im noch di freid fun zain hartsn.<verse eid="ECC 5:19" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />faran an umglik vos ich hob gezen unter der zun, un es iz zeyer oft baim mentshn: <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />a mentsh vos Elokim shenkt im eshires un giter un koved, un im geit nisht op far zich kein zach fun alts vos er gelust, ober Elokim hot im nisht gegebn kein shlite tsu esen derfun, nor a fremder mentsh est es. dos iz nishtikeit, un a fardrosiker veitog. <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />az a mentsh zol hobn hundert kinder, un lebn a sach yorn, iz, vifel di teg fun zaine yorn zoln zain, oib zain zel zetikt zich nisht fun dem guts, un tsu mol kein kvure hot er nisht, zog ich: beser fun im iz dem mapl-kind. <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />vorem in nishtikeit kumt es, un in fintsternish fargeit es, un in fintsternish vert tsugedekt zain nomen. <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />es hot tsu mol di zun nisht gezen un nisht gekent; es hot mer Nachat vi yener. <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />un ven er zol lebn tsvei mol toiznt yor, un nisht onzen kein guts, geyen den nisht ale in ein ort?<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />di gantse mi fun mentshn iz far zain moil, un fun dest vegen vert di zel nisht ongefilt. <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />vorem vos iz di maile fun dem chochem iber dem narn? vos, fun dem oreman vos farshteit? – vi umtsugein mitn lebn. <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />beser zeung fun di oign, eider vandernish fun der zel. dos oich iz nishtikeit un vintyogenish.<verse eid="ECC 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10" />vos geshet iz lang tsurik ongerufn gevorn mitn nomen, un es iz bavust farois vos der mentsh iz; un er ken zich nisht hampern mit dem vos iz shtarker fun im. <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />oib fil verter mern oft nishtikeit, vos iz di maile mitn mentshn? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />vorem ver veis vos iz beser faran mentshn in lebn, in di getseilte teg fun zain nishtikn lebn vos er macht durch vi a shotn? vail ver ken zogn dem mentshn, vos vet zain noch im unter der zun?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="ECC 7" />
  <para style="q">
    <verse number="1" style="v" sid="ECC 7:1" />a guter nomen iz beser fun gutn eil;</para>
  <para style="q" vid="ECC 7:1">un der tog fun toit, fun dem tog vos me vert geborn.<verse eid="ECC 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 7:2" />beser tsu gein in hoiz fun troier,</para>
  <para style="q" vid="ECC 7:2">eider tsu gein in hoiz fun a sude;</para>
  <para style="q" vid="ECC 7:2">vail dos iz der sof fun yetveder mentshn,</para>
  <para style="q" vid="ECC 7:2">un der lebediker darf zich nemen tsum hartsn.<verse eid="ECC 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 7:3" />beser kumer eider gelechter,</para>
  <para style="q" vid="ECC 7:3">vorem az der ponem iz troierik, iz beser faran hartsn.<verse eid="ECC 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 7:4" />dos harts fun di kluge iz in hoiz fun troier,</para>
  <para style="q" vid="ECC 7:4">un dos harts fun di narn in hoiz fun freid.<verse eid="ECC 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 7:5" />beser tsu hern dem ongeshrei fun a klugn,</para>
  <para style="q" vid="ECC 7:5">eider me zol hern dos loib-gezang fun narn.<verse eid="ECC 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 7:6" />vorem azoi vi dos knakn fun derner untern top,</para>
  <para style="q" vid="ECC 7:6">azoi iz dos gelechter fun dem narn.</para>
  <para style="q" vid="ECC 7:6">un dos oich iz nishtikeit.<verse eid="ECC 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 7:7" />far vor, roib tsedult dem chochem,</para>
  <para style="q" vid="ECC 7:7">un shochad firt iber dos harts.<verse eid="ECC 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 7:8" />beser der sof fun a zach eider ir onheib;</para>
  <para style="q" vid="ECC 7:8">beser aingehaltn in gemit, eider hoferdik in gemit.<verse eid="ECC 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 7:9" />zolst nisht zain hastik in dain gemit tsu vern in kaas,</para>
  <para style="q" vid="ECC 7:9">vorem kaas rut in buzem fun di narn.<verse eid="ECC 7:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />zolst nisht zogn: vi iz dos, vos di frierdike teg zainen geven beser vi di itstike? vorem nisht fun chochme fregstu vegen dem. <verse eid="ECC 7:10" /><verse number="11" style="v" sid="ECC 7:11" />gut iz chochme mit a nachle, un a maile far di vos zeen di zun. <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />vorem chochme iz a bashiremung, gelt iz a bashiremung, ober di maile fun kenshaft iz, vos chochme halt oif dos lebn fun dem vos hot zi. <verse eid="ECC 7:12" /><verse number="13" style="v" sid="ECC 7:13" />kuk on dos verk fun Elokim; vorem ver ken oisglaichn vos er hot gemacht krum?<verse eid="ECC 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 7:14" />in tog fun glik zai gliklech, un in tog fun umglik kuk zich arum – dos oich azoi vi yens hot Elokim gemacht – vorem der mentsh vet dernoch gornisht shpiren.<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />alts hob ich gezen in maine nishtike teg: faran a tsadik vos geit unter in zain tsdikut, un faran a roshe vos iz maarich-yamim in zain shlechtikeit. <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />zolst nisht zain tsu fil tsadik, un zolst zich nisht klign ibriks; noch vos zolstu zich umbrengen? <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />zolst nisht zain tsu shlecht, un zolst nisht zain kein nor; noch vos zolstu shtarbn far der tsait? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />gut iz du zolst zich haltn on dem, un oich fun yenem nisht oplozen dain hant; vorem der vos hot moire far Elokim, kumt durch mit beide.<verse eid="ECC 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19" />di chochme bashitst dem chochem mer vi tsen geveltiker vos zainen in shtot.<verse eid="ECC 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 7:20" />avdi nishto a mentsh a tsadik oif der erd vos zol ton loiter guts, un nisht zindikn.<verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />zolst oich nisht leign dain harts oif ale verter vos me redt, kedei zolst nisht hern vi dain knecht shilt dich; <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />vorem dain harts veis az fil mol host du oich gesholtn andere.<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />dos alts hob ich oisgepruvet mit chochme; ich hob gezogt: ich vel klug vern; ober es iz geven vait fun mir. <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />dos vos iz vait un tif-tif, ver ken es oisgefinen?<verse eid="ECC 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ECC 7:25" />ich hob mich arumgedreit, un main harts iz geven oif tsu farshtein un tsu forshn un zuchn chochme un a Cheshbon, un tsu derkenen az shlechtikeit iz tipshes, un narishkeit iz meshugas. <verse eid="ECC 7:25" /><verse number="26" style="v" sid="ECC 7:26" />un ich gefin az biterer fun toit iz di froi, vos ir harts iz pastkes un netsn, ire hent zainen bindshtrik. der vos iz voilgefeln far Elokim, vert antrunen fun ir, un der zindiker vert gefangen fun ir. <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />ze, dos hob ich oisgefunen, zogt Kohelet, ven ich hob tsugeleigt eins tsum andern, kedei tsu gefinen dem Cheshbon. <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />vos main zel zucht nochanand, un ich gefin nisht: ein man tsvishn toiznt hob ich gefunen, ober a froi tsvishn di ale hob ich nisht gefunen. <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />ze, dos alein hob ich oisgefunen, az Elokim hot bashafn dem mentshn glaich, ober zei hobn gezucht fil oistrachtenishn.<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="ECC 8" />
  <para style="q">
    <verse number="1" style="v" sid="ECC 8:1" />ver iz vi der chochem?</para>
  <para style="q" vid="ECC 8:1">un ver veis dem basheid fun a zach?</para>
  <para style="q" vid="ECC 8:1">a mentshns chochme balaicht zain ponem,</para>
  <para style="q" vid="ECC 8:1">un di farshaitkeit fun zain ponem vert farbaiten.<verse eid="ECC 8:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />ich zog: hit dem melechs bafel fun vegen der shvue tsu Elokim. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />zolst nisht avekgein iberailt fun zain ponem; zolst nisht tsushtein tsu a shlechter zach, vorem alts vos er vil, tut er. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />machmas dos vort fun dem melech iz geveltikung; un ver ken im zogn: vos tustu? <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />der vos vil nisht visen fun kein beiz gesheenish, hit dos gebot, un dem klugns harts veis az faran a tsait un a mishpot. <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />vorem far yetveder zach iz do a tsait un a mishpot, vail dos beiz fun dem mentshn iz grois oif im. <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />vorem er veis nisht vos vet geshen; vorem ven es darf geshen, ver vet es im zogn? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />kein mentsh geveltikt nisht ibern vint, tsu kenen ainhaltn dem vint, un nishto kein geveltikung in tog fun toit, un nishto kein urloib in milchome, un dos beiz vet nisht rateven zain tuer. <verse eid="ECC 8:8" /><verse number="9" style="v" sid="ECC 8:9" />dos alts hob ich gezen, un hob mir araingenumen in hartsn vegen yetveder tuung vos vert geton unter der zun, beeis ein mentsh geveltikt ibern andern im shlechts tsu ton.<verse eid="ECC 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10" />un azoi hob ich gezen az reshoim zainen bagrobn gevorn, un zainen gekumen tsu zeyer ru, un di vos hobn geton recht zainen avek fun dem heilikn ort, un zainen fargesen gevorn in shtot. dos oich iz nishtikeit. <verse eid="ECC 8:10" /><verse number="11" style="v" sid="ECC 8:11" />vail der psak far di shlechte meisim vert nisht geton oif gich, derum dervegt zich dos harts fun di mentshnkinder in zei tsu ton shlechts; <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />vorem a zindiker tut hundert mol shlechts, un me farlengert im. ober ich veis fort az di vos hobn moire far Elokim vet zain gut, vail zei hobn moire far im; <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />un dem roshe vet zain nisht gut, un azoi vi a shotn vet er nisht mairech yamim zain, vail er hot nisht moire far Elokim.<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />faran a nishtikeit vos geshet oif der erd: vos es zainen faran tsadikim vos zei geit vedlik di meisim fun di reshoim, un faran reshoim vos zei geit vedlik di meisim fun di tsadikim. hob ich gezogt: dos oich iz nishtikeit. <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />un ich hob geloibt di freid, vorem nishto besers faran mentshn unter der zun, vi tsu esen un trinken un zain freilech, un az dos zol im baleitn in zain mi, durch di teg fun zain lebn vos Elokim hot im geshonken unter der zun.<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />azoi vi ich hob opgegebn main harts tsu kenen chochme, un tsu zen di tuenish vos vert geton oif der erd – vorem sai bai tog sai bai nacht zet der mentsh nisht on kein shlof in zaine oign – <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />hob ich gezen in ale meisim fun Elokim, az der mentsh ken nisht oisgefinen di meisim vos vern geton unter der zun; vorem vi der mentsh zol zich mien tsu zuchn, vet er es nisht gefinen; un afile az der chochem zogt, er veis es, ken er es nisht oisgefinen.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="ECC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />vorem dos alts hob ich mir araingenumen in hartsn, kedei klor tsu machn dos alts: az di tsadikim un di chachomim mit zeyere meisim zainen in der hant fun Elokim; sai libshaft, sai sine – der mentsh veis nisht; alts ligt zei farois. <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />altsding vi far alemen; ein traf far dem tsadik un far dem roshe, far dem gutn un dem reinem, un far dem umreinem, un far dem vos shlacht a korben, un far dem vos shlacht nisht; azoi der guter azoi der zindiker, der vos shvert vi der vos shait zich fun a shvue. <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />dos iz dos beiz in alts vos geshet unter der zun, vos ein traf iz far alemen, un oich iz dos harts fun di mentshnkinder ful mit beiz, un meshugas iz in zeyer hartsn bai zeyer lebn, un dernoch geyen zei tsu di toite. <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />vorem bai dem vos iz noch baheft tsu ale lebedike iz do a hofenung, vail a lebedikn hunt iz beser vi a toitn leib. <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />vorem di lebedike veisn az zei veln shtarbn, ober di toite veisn gornisht, un zei hobn nisht mer kein loin; vorem zeyer zocher iz fargesen. <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />i zeyer libshaft i zeyer sine i zeyer kine iz lang untergegangen, un zei hobn kein mol mer nisht kein chelek in alts vos vert geton unter der zun.<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />gei es mit simche dain broit, un trink mit a freilechn hartsn dain vain, vorem Elokim hot shoin bavilikt daine meisim.<verse eid="ECC 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 9:8" />tsu yetveder tsait zoln daine begadim zain vais, un eil zol nisht feln oif dain kop.<verse eid="ECC 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 9:9" />genis dos lebn mit der vaib vos du host lib, ale teg fun dain nishtikn lebn vos me hot dir geshonken unter der zun, ale daine nishtike teg; vorem dos iz dain chelek in lebn, un in dain mi vos du mihst zich unter der zun. <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />alts vos dain hant farmogt tsu ton mit dain koiech, tu, vorem nishto kein ton, oder oisrechenung, oder kenshaft, oder chochme, in der Sheol vos du geist ahin.<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />ich hob vider gezen unter der zun, az nisht di flinke gevinen dem gevetloif, un nisht di giborim di milchome, un oich nisht di chachomim broit, un oich nisht di farshtandike eshires, un oich nisht di voilkenevdike chein; nor tsait un tsufal treft zei alemen. <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />vorem der mentsh veis tsu mol nisht zain tsait; azoi vi fish vos vern gechapt in a beizer nets, un azoi vi foiglen vos vern gechapt in a pastke, azoi vi zei, vern di mentshnkinder gefangen in a beizer tsait, ven zi falt oif zei plutsling.<verse eid="ECC 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />ober dos hob ich gezen far chochme unter der zun, un dos iz grois bai mir: <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />geven a kleine shtot mit vintsik mentshn in ir; iz oif ir gekumen a groiser melech, un hot zi arumgeringlt, un geboit arum ir groise balegerverk.<verse eid="ECC 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 9:15" />hot men gefunen in ir an oreman a chochem, un er hot geratevet di shtot mit zain chochme; hagam kein mentsh hot nisht gedacht on dem dozikn oreman. <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />hob ich gezogt: beser chochme eider gevure; hagam di chochme fun oreman vert faracht, un zaine verter vern nisht gehert.<verse eid="ECC 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 9:17" />di verter fun di kluge mit gelasnkeit vern mer tsugehert vi der ongeshrei fun a geveltiker tsvishn narn. <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />beser chochme eider keile-milchome; un ein zindiker firt iber a sach guts.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" pubnumber="י" sid="ECC 10" />
  <para style="q">
    <verse number="1" style="v" sid="ECC 10:1" />toite flign farshtinken un tseblezlen dem zalbmishers eil,</para>
  <para style="q" vid="ECC 10:1">azoi vegt ariber a bisel narishkeit chochme un koved.<verse eid="ECC 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 10:2" />der seichel fun dem chochem iz oif zain rechter zait,</para>
  <para style="q" vid="ECC 10:2">un der seichel fun narn oif zain linker.<verse eid="ECC 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 10:3" />un oich az der nor geit in veg,</para>
  <para style="q" vid="ECC 10:3">felt im seichel, un er zogt alemen ois</para>
  <para style="q" vid="ECC 10:3">az er iz a nor.<verse eid="ECC 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 10:4" />az dos gemit fun dem geveltiker heibt zich oif kegen dir,</para>
  <para style="q" vid="ECC 10:4">zolstu nisht farlozen dain ort;</para>
  <para style="q" vid="ECC 10:4">vorem gelasnkeit barut groise zind.<verse eid="ECC 10:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5" />faran an umglik vos ich hob gezen unter der zun, azoi vi a farze vos geit arois fun a geveltiker: <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />narishkeit vert geshtelt in groise heichn, un negidim zitsn in der nider. <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />ich hob gezen knecht oif ferd, un harn vos geyen vi knecht oif der erd.<verse eid="ECC 10:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ECC 10:8" />der vos grobt a grub, vet in ir arainfaln,</para>
  <para style="q" vid="ECC 10:8">un der vos brecht durch a tsam, im vet ainbaisn a shlang.<verse eid="ECC 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 10:9" />der vos hakt arois shteiner vet zich vei ton on zei,</para>
  <para style="q" vid="ECC 10:9">der vos shpalt holts iz in sekone durch dem.<verse eid="ECC 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ECC 10:10" />az der aizn iz shtump,</para>
  <para style="q" vid="ECC 10:10">un me hot dem sharf nisht farshlaift,</para>
  <para style="q" vid="ECC 10:10">muz men shtarkn di koiches;</para>
  <para style="q" vid="ECC 10:10">un di maile fun chochme iz tsugreiten.<verse eid="ECC 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 10:11" />az di shlang baist ain faran opshprechn,</para>
  <para style="q" vid="ECC 10:11">iz ois maile fun dem man mit der tsung.<verse eid="ECC 10:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ECC 10:12" />di verter fun dem chachams moil zainen mit chein,</para>
  <para style="q" vid="ECC 10:12">un di lipn fun dem narn brengen im um.<verse eid="ECC 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ECC 10:13" />der onheib fun di verter fun zain moil iz narishkeit,</para>
  <para style="q" vid="ECC 10:13">un der sof fun zain redn iz beize meshugas.<verse eid="ECC 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ECC 10:14" />yo, der nor mert verter,</para>
  <para style="q" vid="ECC 10:14">ober der mentsh veis nisht vos geshet;</para>
  <para style="q" vid="ECC 10:14">un vos vet geshen noch im,</para>
  <para style="q" vid="ECC 10:14">ver vet im dertseiln?<verse eid="ECC 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ECC 10:15" />di mi fun dem narn farmatert im,</para>
  <para style="q" vid="ECC 10:15">vorem er veis nisht tsu mol vi tsu gein in shtot.<verse eid="ECC 10:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ECC 10:16" />vei dir land, vos dain melech iz a yung,</para>
  <para style="q" vid="ECC 10:16">un daine harn machn sudus in der peire!<verse eid="ECC 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ECC 10:17" />voil dir land, vos dain melech iz a fraigeborener,</para>
  <para style="q" vid="ECC 10:17">un daine harn esen in der tsait,</para>
  <para style="q" vid="ECC 10:17">in manhaftikeit un nisht in zoiferai.<verse eid="ECC 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ECC 10:18" />fun foilkeit falt ain der balkn,</para>
  <para style="q" vid="ECC 10:18">un fun opgelozte hent rint dos hoiz.<verse eid="ECC 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ECC 10:19" />a sude macht men fun freilechkeit vegen,</para>
  <para style="q" vid="ECC 10:19">un vain macht lustik dos lebn;</para>
  <para style="q" vid="ECC 10:19">ober gelt bavert alts.<verse eid="ECC 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ECC 10:20" />afile in dain gedanken zolstu nisht shiltn dem melech,</para>
  <para style="q" vid="ECC 10:20">un in daine shlofkamern zolstu nisht shiltn dem oysher;</para>
  <para style="q" vid="ECC 10:20">vorem a foigel fun himel vet avektrogen dem kol,</para>
  <para style="q" vid="ECC 10:20">un der vos hot fliglen vet dertseiln di zach.<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="ECC 11" />
  <para style="q">
    <verse number="1" style="v" sid="ECC 11:1" />loz avek dain broit oifn vaser,</para>
  <para style="q" vid="ECC 11:1">vorem in fil teg arum vestu es gefinen.<verse eid="ECC 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 11:2" />tseteil a chelek oif zibn, un afile oif acht,</para>
  <para style="q" vid="ECC 11:2">vorem veist nisht vos far a beiz es ken zain oif der erd.<verse eid="ECC 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 11:3" />az di volken vern ful mit regn,</para>
  <para style="q" vid="ECC 11:3">leidikn zei zich ois oif der erd;</para>
  <para style="q" vid="ECC 11:3">un sai a boim falt in tsofn un sai in dorem –</para>
  <para style="q" vid="ECC 11:3">in ort vu der boim falt, dortn vet er blaibn.<verse eid="ECC 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 11:4" />der vos past-oif dem vint vet nisht zeyen,</para>
  <para style="q" vid="ECC 11:4">un der vos kukt oif di volkens vet nisht shnaidn.<verse eid="ECC 11:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="ECC 11:5" />azoi vi du veist nisht vos iz der veg fun dem vint, oder vi es vern beiner in laib fun a trogediker, azoi veistu nisht di tuung fun Elokim vos tut altsding.<verse eid="ECC 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 11:6" />in frimorgn zei dain zomen, un in ovnt zolstu nisht oplozen dain hant, vorem du veist nisht voser vet gerotn, dos oder yens, oder beide baglaich veln zain gut.<verse eid="ECC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />un zis iz di lichtikeit, un gut iz far di oign tsu zen di zun.<verse eid="ECC 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 11:8" />vorem vifel yorn der mentsh zol lebn, zol er in zei ale zain freilech; un zol er gedenken di teg fun fintsternish, az zei veln zain fil. alts vos geshet iz nishtikeit.<verse eid="ECC 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />frei zich, bocher, in dain yugnt, un loz voil gein dain harts in daine bochurshe teg, un gei in di vegen fun dain hartsn, un noch der zeung fun daine oign; ober zai visen az far alem dem vet Elokim dich brengen tsum mishpot.<verse eid="ECC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 11:10" />un tu op ergernish fun dain hartsn, un halt op beiz fun dain laib, vorem yinglshaft un yugnt zainen a hoich.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />un gedenk dain Bashefer in daine bochurshe teg, eider es veln kumen di shlechte teg, un onkumen veln di yorn, vos du vest zogn: ich hob nisht kein hanoe fun zei; <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />eider es vet fintster vern di zun un dos licht, un di levone un di shtern; un di volkens veln vider kern nochn regn; <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />in dem tog vos di hoizvechter veln zich treislen, un di chils-lait veln zich oiskrimen, un di molerins veln nisht arbeten, vail zei zainen vintsik, un di kukerins veln tunkel zain in di fentster, <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />un di tirn tsum gas veln farshlosn vern; ven niderik vet zain dos roishn fun der mil, un me vet zich opshteln baim pips fun a foigel, un farshtikt veln zain ale techter fun gezang; <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />oich vet men moire hobn far a hoichn ort, un shrekenishn veln zain oifn veg; un der mandlboim vet blien, un der heisherik vet zich shlepn, un di kaperfrucht vet oifhern, vail der mentsh geit tsu zain eibiker heim, un di bakloger veln zich umdreyen in gas; <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />eider di zilberne shnur vet tserisn vern, un der gilderner bekn vet tsehakt vern, un der krug vet tsebrochn vern baim kval, un der rod falt a tsehakter in brunem; <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />un der shtoib vet zich umkeren tsu der erd, vi geven, un der gaist vet zich umkeren tsu Elokim vos hot im gegebn. <verse eid="ECC 12:7" /><verse number="8" style="v" sid="ECC 12:8" />nishtikeit fun nishtikeit, zogt Kohelet, alts iz nishtikeit.<verse eid="ECC 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />un achuts vos Kohelet iz geven a chochem, hot er noch gelernt dos folk kenshaft; un er hot gevoign un geforsht, un tsunoifgeshtelt shprichverter a sach. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />Kohelet hot gezucht tsu gefinen nutsleche zachn, un vos iz geshribn oifrichtik – metdike verter.<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />di verter fun di chachomim zainen azoi vi traibshpitsn, un vi negl araingeshlogene zainen di tsunoifgezamlte reid; zei zainen gegebn gevorn fun ein pastuch. <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />un vaiter, main zun, zai gevornt: tsu machn fil sforim iz nishto kein end, ober zich griblen tsu fil matert op dem laib.<verse eid="ECC 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13" />der sof fun der zach, noch dem vi alts iz gehert gevorn, iz: hob moire far Elokim, un hit zaine gebot, vorem dos iz der gantser mentsh. <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />vail dem gantsn bashaf vet Elokim brengen far a mishpot iber alem farhoilenem, sai gut un sai shlecht.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>