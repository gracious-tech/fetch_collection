<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Chabakuk</para>
  <para style="toc2">Chabakuk</para>
  <para style="toc1">Chabakuk</para>
  <para style="mt1">Chabakuk</para>
  <chapter number="1" style="c" pubnumber="א" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />di nevue vos Chabakuk der novi hot gezen.<verse eid="HAB 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="HAB 1:2" />biz vanen, Hashem, vel ich rufn,</para>
  <para style="q" vid="HAB 1:2">un du vest nisht hern?</para>
  <para style="q" vid="HAB 1:2">shraien tsu dir gevalt,</para>
  <para style="q" vid="HAB 1:2">un du vest nisht helfn?<verse eid="HAB 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 1:3" />far vos loztu mich zen umrecht,</para>
  <para style="q" vid="HAB 1:3">un kukst-tsu umglik?</para>
  <para style="q" vid="HAB 1:3">un roib un gzeile zainen far mir,</para>
  <para style="q" vid="HAB 1:3">un es iz krig, un shtrait heibt zich oif.<verse eid="HAB 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 1:4" />derum iz opgeshlaft di toyre,</para>
  <para style="q" vid="HAB 1:4">un kein mol kumt nisht arois a mishpot;</para>
  <para style="q" vid="HAB 1:4">vail der roshe ringlt arum dem tsadik,</para>
  <para style="q" vid="HAB 1:4">derum kumt arois der mishpot fardreit.<verse eid="HAB 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HAB 1:5" />zet bai di felker un kukt-tsu,</para>
  <para style="q" vid="HAB 1:5">un vundern farvundert aich,</para>
  <para style="q" vid="HAB 1:5">vorem a tuung tut men in aiere teg</para>
  <para style="q" vid="HAB 1:5">ir vet nisht gloibn, az es vet dertseilt vern.<verse eid="HAB 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 1:6" />vorem zet, ich mach oifshtein di Kasdim,</para>
  <para style="q" vid="HAB 1:6">dos bitere un dos hastike folk,</para>
  <para style="q" vid="HAB 1:6">vos geit iber der breit fun der erd,</para>
  <para style="q" vid="HAB 1:6">tsu arben voinungen nisht zaine.<verse eid="HAB 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 1:7" />forchtik un moiredik iz er,</para>
  <para style="q" vid="HAB 1:7">fun im alein geit arois zain recht un zain macht.<verse eid="HAB 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 1:8" />un flinker fun lempertn zainen zaine ferd,</para>
  <para style="q" vid="HAB 1:8">un sharfer fun ovntvelf;</para>
  <para style="q" vid="HAB 1:8">un zaine raiter farshpreitn zich,</para>
  <para style="q" vid="HAB 1:8">yo, zaine raiter kumen fun der vaitn,</para>
  <para style="q" vid="HAB 1:8">zei flien vi an odler vos ailt tsu fartseren.<verse eid="HAB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 1:9" />zei ale kumen oif roib,</para>
  <para style="q" vid="HAB 1:9">dos tsien fun zeyere penemer iz farois tsu;</para>
  <para style="q" vid="HAB 1:9">un er zamlt vi zamd gefangene.<verse eid="HAB 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 1:10" />un er shpot fun mlochim,</para>
  <para style="q" vid="HAB 1:10">un firshtn zainen a shpilchl bai im;</para>
  <para style="q" vid="HAB 1:10">er lacht fun itlecher festung,</para>
  <para style="q" vid="HAB 1:10">vorem er shit on erd, un batsvingt zi.<verse eid="HAB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 1:11" />dentsmol geit im ariber vi der vint,</para>
  <para style="q" vid="HAB 1:11">un er tret iber un farshuldikt veren;</para>
  <para style="q" vid="HAB 1:11">zain doziker koiech vert bai im tsum G-t.<verse eid="HAB 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="HAB 1:12" />far vor, du bist doch fun eibik on,</para>
  <para style="q" vid="HAB 1:12">Hashem main G-t, main heiliker,</para>
  <para style="q" vid="HAB 1:12">lomir nisht umkumen;</para>
  <para style="q" vid="HAB 1:12">Hashem, du host im far a mishpot gemacht,</para>
  <para style="q" vid="HAB 1:12">un du, feldz, host im tsu shtrofn geshtelt.<verse eid="HAB 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 1:13" />daine oign zainen tsu rein tsu zen shlechts,</para>
  <para style="q" vid="HAB 1:13">un tsukukn umrecht kenstu nisht;</para>
  <para style="q" vid="HAB 1:13">far vos kukstu-tsu di vos felshn,</para>
  <para style="q" vid="HAB 1:13">shvaigst ven der roshe shlingt ain</para>
  <para style="q" vid="HAB 1:13">dem vos iz gerechter fun im?<verse eid="HAB 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 1:14" />un host gemacht mentshn vi di fishn fun yam,</para>
  <para style="q" vid="HAB 1:14">vi shrotsim on a geveltiker iber zei;<verse eid="HAB 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 1:15" />er tsit zei ale aroif mit a ventke,</para>
  <para style="q" vid="HAB 1:15">er shlept zei aroif in der nets,</para>
  <para style="q" vid="HAB 1:15">un er zamlt zei ain in zain fangnets;</para>
  <para style="q" vid="HAB 1:15">derum freit er zich un kvelt.<verse eid="HAB 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 1:16" />derum shlacht er tsu zain nets,</para>
  <para style="q" vid="HAB 1:16">un reichert tsu zain fangnets,</para>
  <para style="q" vid="HAB 1:16">vorem durch zei iz fet zain chelek,</para>
  <para style="q" vid="HAB 1:16">un zain esen iz zaftik.<verse eid="HAB 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 1:17" />zol er derum oisleidikn zain nets,</para>
  <para style="q" vid="HAB 1:17">un tamid hargen felker on derbaremung?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="HAB 2" />
  <para style="q">
    <verse number="1" style="v" sid="HAB 2:1" />ich shtei oif main vach,</para>
  <para style="q" vid="HAB 2:1">un ich shtel zich oifn turem,</para>
  <para style="q" vid="HAB 2:1">un kuk tsu zen vos Hashem vet mit mir redn,</para>
  <para style="q" vid="HAB 2:1">un ich zol entfern, oif der taine tsu mir.<verse eid="HAB 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="HAB 2:2" />hot mir Hashem geentfert un gezogt:</para>
  <para style="q" vid="HAB 2:2">farshraib di zeung,</para>
  <para style="q" vid="HAB 2:2">un fartseichn klor oif tovlen,</para>
  <para style="q" vid="HAB 2:2">kedei me zol es geloifik leyenen.<verse eid="HAB 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 2:3" />vorem di zeung iz noch oif a tsait,</para>
  <para style="q" vid="HAB 2:3">un zi redt fun dem kets, un zogt nisht kein lign;</para>
  <para style="q" vid="HAB 2:3">oib er vet zich zamen, tu harn oif im,</para>
  <para style="q" vid="HAB 2:3">vorem kumen vet er kumen, er vet nisht farshpetikn.<verse eid="HAB 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HAB 2:4" />ze, hoferdik, nisht rechtfartik, iz zain zel in im,</para>
  <para style="q" vid="HAB 2:4">ober der gerechter lebt mit zain emune.<verse eid="HAB 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HAB 2:5" />un far vor, vi der vain tut felshn,</para>
  <para style="q" vid="HAB 2:5">azoi vet der shtoltser mentsh nisht onhaltn;</para>
  <para style="q" vid="HAB 2:5">der vos macht breit vi di untererd zain bager,</para>
  <para style="q" vid="HAB 2:5">un er vet vi der toit nisht zat,</para>
  <para style="q" vid="HAB 2:5">un zamlt tsu zich ale felker,</para>
  <para style="q" vid="HAB 2:5">un klaibt tsu zich ale umes.<verse eid="HAB 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="HAB 2:6" />far vor, di ale veln oifheibn a Mashal oif im,</para>
  <para style="q" vid="HAB 2:6">un a shpotretenish iber im,</para>
  <para style="q" vid="HAB 2:6">un me vet zogn: vei, der vos mert nisht-zains –</para>
  <para style="q" vid="HAB 2:6">biz vanen? – un lodt oif zich choives!<verse eid="HAB 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 2:7" />far vor, plutsling veln oifshtein daine tsinzmoner,</para>
  <para style="q" vid="HAB 2:7">un dervekn veln zich daine oiftreisler,</para>
  <para style="q" vid="HAB 2:7">un vest vern tsu roib far zei.<verse eid="HAB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 2:8" />vail du host baroibt fil felker,</para>
  <para style="q" vid="HAB 2:8">veln dich baroibn ale iberike umes;</para>
  <para style="q" vid="HAB 2:8">fun vegen mentshns blut, un dem umrecht tsum land,</para>
  <para style="q" vid="HAB 2:8">tsu der shtot un ale voiner in ir.<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="HAB 2:9" />vei, der vos havet noch beizn gevin far zain hoiz,</para>
  <para style="q" vid="HAB 2:9">tsu machn in der heich zain nest,</para>
  <para style="q" vid="HAB 2:9">nitsl tsu vern fun der hant fun beiz!<verse eid="HAB 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 2:10" />host barotn shand far dain hoiz;</para>
  <para style="q" vid="HAB 2:10">farshnitn fil felker, un farzindikt dain zel.<verse eid="HAB 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 2:11" />vorem a shtein fun der vant vet shraien,</para>
  <para style="q" vid="HAB 2:11">un a balkn fun dem holts vet im entfern.<verse eid="HAB 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 2:12" />vei, der vos boit a shtot mit blut,</para>
  <para style="q" vid="HAB 2:12">un shtelt oif a krach oif umrecht!<verse eid="HAB 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 2:13" />far vor, ze, es iz fun Hashem Tseva'ot,</para>
  <para style="q" vid="HAB 2:13">az felker zoln zich matern faran faier,</para>
  <para style="q" vid="HAB 2:13">un umes zoln zich mien umnisht.<verse eid="HAB 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 2:14" />vorem di erd vet ful vern mit der kenung fun Hashems pracht,</para>
  <para style="q" vid="HAB 2:14">azoi vi di vasern badekn dem yam.<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HAB 2:15" />vei, der vos trinkt on zain chever!</para>
  <para style="q" vid="HAB 2:15">mishst-tsu dain gift, un machst oich shikur,</para>
  <para style="q" vid="HAB 2:15">kedei tsu kukn oif zeyer naketkeit!<verse eid="HAB 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 2:16" />host zich gezetikt mit shand anshtot koved –</para>
  <para style="q" vid="HAB 2:16">trink du oich un ver opgedekt.</para>
  <para style="q" vid="HAB 2:16">umdreyen vet zich tsu dir der becher fun Hashems rechter hant,</para>
  <para style="q" vid="HAB 2:16">un koit vet zain oif dain koved.<verse eid="HAB 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 2:17" />vorem dos umrecht tsum Levanon vet dich tsudekn,</para>
  <para style="q" vid="HAB 2:17">un di farvistung fun di chayes vos hot zei tsebrochn;</para>
  <para style="q" vid="HAB 2:17">fun vegen mentshns blut, un dem umrecht tsum land,</para>
  <para style="q" vid="HAB 2:17">tsu der shtot un ale voiner in ir.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="HAB 2:18" />vos nutst der geshnitster gets,</para>
  <para style="q" vid="HAB 2:18">az zain furemer hot im oisgeshnitst?</para>
  <para style="q" vid="HAB 2:18">vos der gegosener gets, un der falsher lerer,</para>
  <para style="q" vid="HAB 2:18">az der furemer fun zain furemung hot zich farzichert deroif,</para>
  <para style="q" vid="HAB 2:18">tsu machn opgeter shtume?<verse eid="HAB 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 2:19" />vei, der vos zogt tsu a holts: chap zich oif!</para>
  <para style="q" vid="HAB 2:19">dervek dich! tsu a shtein a shtumen. er zol lernen?</para>
  <para style="q" vid="HAB 2:19">ze, er iz aingefast in gold un zilber,</para>
  <para style="q" vid="HAB 2:19">un a shum otem iz in im nishto.<verse eid="HAB 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HAB 2:20" />ober Hashem iz in zain heilikn heichl;</para>
  <para style="q" vid="HAB 2:20">shtil far im, di gantse erd!<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="HAB 3" />
  <para style="q">
    <verse number="1" style="v" sid="HAB 3:1" />a tfile fun Chabakuk dem novi oif shigionut.<verse eid="HAB 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="HAB 3:2" />Hashem, ich hob gehert dain herung; ich shrek mich;</para>
  <para style="q" vid="HAB 3:2">Hashem, leb oif dain verk in di nonte yorn,</para>
  <para style="q" vid="HAB 3:2">in di nonte yorn mach es bakant;</para>
  <para style="q" vid="HAB 3:2">in tsorn gedenk on derbaremen.<verse eid="HAB 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 3:3" />Eloah kumt fun Teman,</para>
  <para style="q" vid="HAB 3:3">un der heiliker fun barg Paran.</para>
  <para style="q" vid="HAB 3:3">Selah.</para>
  <para style="q" vid="HAB 3:3">zain glants badekt di himlen,</para>
  <para style="q" vid="HAB 3:3">un mit zain lichtikeit iz ful di erd.<verse eid="HAB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 3:4" />un der shimer iz vi zunlicht,</para>
  <para style="q" vid="HAB 3:4">shtraln hot er fun zain zait;</para>
  <para style="q" vid="HAB 3:4">un dortn iz di baheltenish fun zain macht.<verse eid="HAB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 3:5" />im farois geit di pest,</para>
  <para style="q" vid="HAB 3:5">un der blits geit arois noch zaine fis.<verse eid="HAB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 3:6" />er shteit oif, un tsetreislt di erd,</para>
  <para style="q" vid="HAB 3:6">er git a kuk, un macht shpringen di felker,</para>
  <para style="q" vid="HAB 3:6">un di eibike berg vern tsepitslt,</para>
  <para style="q" vid="HAB 3:6">di uralte heichn faln anider;</para>
  <para style="q" vid="HAB 3:6">dos zainen zaine eibike vegen.<verse eid="HAB 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 3:7" />unter umglik ze ich di getseltn fun Kushan,</para>
  <para style="q" vid="HAB 3:7">di forhangen fun Midyan-land tsiteren.<verse eid="HAB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 3:8" />hot oif di taichn, Hashem,</para>
  <para style="q" vid="HAB 3:8">hot oif di taichn gegrimt dain tsorn?</para>
  <para style="q" vid="HAB 3:8">tsi iz oif dem yam dain kaas?</para>
  <para style="q" vid="HAB 3:8">vos du raitst oif daine ferd,</para>
  <para style="q" vid="HAB 3:8">oif daine raitvegn fun zig?<verse eid="HAB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 3:9" />bloiz antbloizt iz dain boign,</para>
  <para style="q" vid="HAB 3:9">bashvorn di failn fun dain vort. Selah.</para>
  <para style="q" vid="HAB 3:9">in taichn tseshpaltstu di erd.<verse eid="HAB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 3:10" />gezen dich – tsiteren di berg,</para>
  <para style="q" vid="HAB 3:10">a fleitsung vaser iz aribergegangen,</para>
  <para style="q" vid="HAB 3:10">der tehom hot aroisgelozt zain kol,</para>
  <para style="q" vid="HAB 3:10">er hot oifgehoibn in der heich zaine hent.<verse eid="HAB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 3:11" />di zun, di levone, hot zich opgeshtelt in ir voinung,</para>
  <para style="q" vid="HAB 3:11">far dem shain fun daine failn vos loifn,</para>
  <para style="q" vid="HAB 3:11">far dem shimer fun dain blitsikn shpiz.<verse eid="HAB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 3:12" />mit tsorn shpraiztu iber der erd,</para>
  <para style="q" vid="HAB 3:12">mit kaas dreshstu di umes.<verse eid="HAB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 3:13" />bist arois tsu hilf dain folk,</para>
  <para style="q" vid="HAB 3:13">tsu hilf dain gezalbtn;</para>
  <para style="q" vid="HAB 3:13">host tsehakt dem kop, fun dem reshes hoiz,</para>
  <para style="q" vid="HAB 3:13">host oifgedekt dem grunt bizn haldz.</para>
  <para style="q" vid="HAB 3:13">Selah.<verse eid="HAB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 3:14" />host tselechert mit zaine failn dem kop fun zaine krigers,</para>
  <para style="q" vid="HAB 3:14">vos shturemen mich tsu tseshpreitn;</para>
  <para style="q" vid="HAB 3:14">vos zeyer freid iz vi oiftsuesn dem oreman in farborgenish.<verse eid="HAB 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 3:15" />host getretn dem yam mit daine ferd,</para>
  <para style="q" vid="HAB 3:15">dem shoim fun di groise vasern.<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="HAB 3:16" />ich hob gehert, un main laib hot getsitert,</para>
  <para style="q" vid="HAB 3:16">fun dem kol hobn maine lipn geklapt;</para>
  <para style="q" vid="HAB 3:16">a foilung iz arain in maine beiner,</para>
  <para style="q" vid="HAB 3:16">un ich tsiter oif main ort:</para>
  <para style="q" vid="HAB 3:16">az ich zol zain barut in tog fun noit,</para>
  <para style="q" vid="HAB 3:16">ven me kumt oifn folk im tsu bafaln.<verse eid="HAB 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 3:17" />far vor, der faignboim blit nisht,</para>
  <para style="q" vid="HAB 3:17">un nishto kein frucht oif di vainshtokn,</para>
  <para style="q" vid="HAB 3:17">gefelsht hot der ainkum fun eilbertboim,</para>
  <para style="q" vid="HAB 3:17">un di felder gibn nisht kein shpaiz,</para>
  <para style="q" vid="HAB 3:17">opgeshnitn fun geheft iz di shof,</para>
  <para style="q" vid="HAB 3:17">un nishto kein rinder in di shtaln,<verse eid="HAB 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 3:18" />ober ich vel mich freyen mit Hashem,</para>
  <para style="q" vid="HAB 3:18">un lustik zain mit dem G-t fun main hilf.<verse eid="HAB 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 3:19" />Hashem Adonoi iz main shtarkeit,</para>
  <para style="q" vid="HAB 3:19">un er macht maine fis vi di hindn,</para>
  <para style="q" vid="HAB 3:19">un oif maine heichn macht er mich tretn.</para>
  <para style="b" vid="HAB 3:19" />
  <para style="q" vid="HAB 3:19">far dem gezangmaister. mit main struneshpil.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>