<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Nachum</para>
  <para style="toc2">Nachum</para>
  <para style="toc1">Nachum</para>
  <para style="mt1">Nachum</para>
  <chapter number="1" style="c" pubnumber="א" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />di nevue oif Nineveh; dos buch fun der zeung fun Nachum dem Elkosh.<verse eid="NAM 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="NAM 1:2" />a G-t an El Kanno un a rachenemer iz Hashem,</para>
  <para style="q" vid="NAM 1:2">Hashem iz a rachenemer un ful mit grimtsorn,</para>
  <para style="q" vid="NAM 1:2">Hashem iz zich noikem on zaine faint,</para>
  <para style="q" vid="NAM 1:2">un er halt dem kaas tsu zaine sonem.<verse eid="NAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 1:3" />Hashem iz aingehaltn in tsorn,</para>
  <para style="q" vid="NAM 1:3">un grois in macht,</para>
  <para style="q" vid="NAM 1:3">er lozt nisht frai, er vet zicher nisht lozn di shuldike umbashtroft.</para>
  <para style="q" vid="NAM 1:3">Hashem – mit vint un mit shturem iz zain veg,</para>
  <para style="q" vid="NAM 1:3">un volken der shtoib fun zaine fis.<verse eid="NAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 1:4" />er shrait on oifn yam, un triknt im ois,</para>
  <para style="q" vid="NAM 1:4">un ale taichn macht er trukn;</para>
  <para style="q" vid="NAM 1:4">farvelkt vert der Bashan un Karmel,</para>
  <para style="q" vid="NAM 1:4">un di bliung fun Levanon vert farvelkt.<verse eid="NAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 1:5" />di berg tsiteren far im,</para>
  <para style="q" vid="NAM 1:5">un di toln tuen zich vaklen,</para>
  <para style="q" vid="NAM 1:5">un di erd vert oifgetreislt fun zain ponem,</para>
  <para style="q" vid="NAM 1:5">i di velt i ale voiner in ir.<verse eid="NAM 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="NAM 1:6" />far zain kaas ver ken zich shteln?</para>
  <para style="q" vid="NAM 1:6">un ver ken bashtein in zain grimtsorn?</para>
  <para style="q" vid="NAM 1:6">zain tsorn gist zich ois vi faier,</para>
  <para style="q" vid="NAM 1:6">un di feldzn vern tseshtoisn far im.<verse eid="NAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 1:7" />gut iz Hashem,</para>
  <para style="q" vid="NAM 1:7">far a festung in tog fun noit;</para>
  <para style="q" vid="NAM 1:7">un er veis di vos shitsn zich in im.<verse eid="NAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 1:8" />ober mit a shtromiker fleitsung</para>
  <para style="q" vid="NAM 1:8">vet er machn a farlendung fun ir ort,</para>
  <para style="q" vid="NAM 1:8">un zaine faint vet nochyogn fintsternish.<verse eid="NAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 1:9" />vos tracht ir akegn Hashem?</para>
  <para style="q" vid="NAM 1:9">a farlendung vet er machn,</para>
  <para style="q" vid="NAM 1:9">di tsore vet nisht oifshtein a tsveit mol.<verse eid="NAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 1:10" />vorem beeis zei zainen vi derner aingeflochtene,</para>
  <para style="q" vid="NAM 1:10">un vi zei shikurn farshikurte,</para>
  <para style="q" vid="NAM 1:10">veln zei in gantsn fartsert vern vi trukene shtroi.<verse eid="NAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 1:11" />fun dir iz aroisgekumen</para>
  <para style="q" vid="NAM 1:11">der vos tracht beiz akegn Hashem,</para>
  <para style="q" vid="NAM 1:11">vos barot nidertrechtikeit.<verse eid="NAM 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="NAM 1:12" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="NAM 1:12">vi gezunt un azoi fil vi zei zainen,</para>
  <para style="q" vid="NAM 1:12">azoi veln zei farshnitn vern un fargein;</para>
  <para style="q" vid="NAM 1:12">hagam ich hob dich gepainikt,</para>
  <para style="q" vid="NAM 1:12">vel ich mer dich nisht painiken.<verse eid="NAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 1:13" />un atsund vel ich tsebrechn zain yochshtang fun dir,</para>
  <para style="q" vid="NAM 1:13">un daine bindshtrik vel ich tseraisn.<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="NAM 1:14" />un Hashem hot bafoiln vegen dir,</para>
  <para style="q" vid="NAM 1:14">az fun dain nomen zol mer kein zomen nisht zain;</para>
  <para style="q" vid="NAM 1:14">fun hoiz fun dain g‑ts vel ich farshnaidn</para>
  <para style="q" vid="NAM 1:14">geshnitste un gegosene g‑tsn;</para>
  <para style="q" vid="NAM 1:14">ich vel dir a keyver machn,</para>
  <para style="q" vid="NAM 1:14">vail du bist tsu shand gevorn.<verse eid="NAM 1:14" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="NAM 2" />
  <para style="q">
    <verse number="1" style="v" pubnumber="1.15" sid="NAM 2:1" /> ze oif di berg di fis fun dem mevaser</para>
  <para style="q" vid="NAM 2:1">vos macht hern sholem!</para>
  <para style="q" vid="NAM 2:1">faier, Yehudah, daine faierteg,</para>
  <para style="q" vid="NAM 2:1">batsol daine nedrim,</para>
  <para style="q" vid="NAM 2:1">vorem mer vet nisht durchgein in dir der nidertrechtiker,</para>
  <para style="q" vid="NAM 2:1">er iz in gantsn farshnitn.<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" pubnumber="2.1" sid="NAM 2:2" /> a tsebrecher geit aroif akegn dir;</para>
  <para style="q" vid="NAM 2:2">hit di festung. kuk ois oifn veg,</para>
  <para style="q" vid="NAM 2:2">festik di lendn, shtark zeyer dain koiech. –<verse eid="NAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="2.2" sid="NAM 2:3" /> vorem Hashem kert um dem shtolts fun Yaakov</para>
  <para style="q" vid="NAM 2:3">vi dem shtolts fun Yisroel;</para>
  <para style="q" vid="NAM 2:3">vorem oisleidiker hobn zei oisgeleidikt,</para>
  <para style="q" vid="NAM 2:3">un zeyere tsvaign fardorben.<verse eid="NAM 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" pubnumber="3" sid="NAM 2:4" /> der shild fun zaine giborim iz geroitikt,</para>
  <para style="q" vid="NAM 2:4">di krigslait in vermilfarb,</para>
  <para style="q" vid="NAM 2:4">in faierdikn shtol di raitvegn,</para>
  <para style="q" vid="NAM 2:4">in tog fun zeyer tsugreitung;</para>
  <para style="q" vid="NAM 2:4">un di tsipresshpizn vern gefocht.<verse eid="NAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="4" sid="NAM 2:5" /> durch di gasn vildeven di raitvegn,</para>
  <para style="q" vid="NAM 2:5">zei shturemen durch di merk,</para>
  <para style="q" vid="NAM 2:5">zeyer onblik iz vi flamen,</para>
  <para style="q" vid="NAM 2:5">vi di blitsn loifn zei um.<verse eid="NAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="NAM 2:6" /> er tracht on zaine machtike,</para>
  <para style="q" vid="NAM 2:6">ober zei vern geshtroichlt in zeyer gang;</para>
  <para style="q" vid="NAM 2:6">me ailt tsu der moier,</para>
  <para style="q" vid="NAM 2:6">un tsugegreit vert der shiremdach.<verse eid="NAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="NAM 2:7" /> di toiern fun di taichn zainen geefent,</para>
  <para style="q" vid="NAM 2:7">un der palats vert tserunen.<verse eid="NAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="NAM 2:8" /> un di malke vert an opgedekte avekgenumen,</para>
  <para style="q" vid="NAM 2:8">un ire dinstn klogn azoi vi der kol fun toibn,</para>
  <para style="q" vid="NAM 2:8">zich klapndik oif di hertser.<verse eid="NAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="NAM 2:9" /> un Nineveh iz vi a taich vaser</para>
  <para style="q" vid="NAM 2:9">fun zint di teg vos zi iz;</para>
  <para style="q" vid="NAM 2:9">ober zei antloifn: shteit! shteit!</para>
  <para style="q" vid="NAM 2:9">ober keiner kert zich nisht um.<verse eid="NAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="NAM 2:10" /> roibt zilber, roibt gold,</para>
  <para style="q" vid="NAM 2:10">nishto kein shieur tsu dem oisshtat,</para>
  <para style="q" vid="NAM 2:10">a raichtum fun ale glustike zachn.<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="NAM 2:11" /> zi vert pust un vist un farvist,</para>
  <para style="q" vid="NAM 2:11">un dos harts vert tsegangen,</para>
  <para style="q" vid="NAM 2:11">un a vaklenish fun kni,</para>
  <para style="q" vid="NAM 2:11">un a tsiterenish in ale lendn;</para>
  <para style="q" vid="NAM 2:11">un zeyere alemens penemer nemen on a fintsternish.<verse eid="NAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="NAM 2:12" /> vu iz di voinung fun di leibn,</para>
  <para style="q" vid="NAM 2:12">vos iz geven der fiterplats far yungleibn,</para>
  <para style="q" vid="NAM 2:12">vos dortn iz umgegangen der leib, di leibinte,</para>
  <para style="q" vid="NAM 2:12">dos kleine leibl, un keiner hot nisht geshrokn?<verse eid="NAM 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="NAM 2:13" /> der leib flegt fartsukn genug far zaine yunge,</para>
  <para style="q" vid="NAM 2:13">un vergn far zaine leibintes,</para>
  <para style="q" vid="NAM 2:13">un hot ongefilt mit fartsukung zaine lecher,</para>
  <para style="q" vid="NAM 2:13">un zaine voinungen mit fartsukte.<verse eid="NAM 2:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" altnumber="13" sid="NAM 2:14" /> ze, ich vel kumen oif dir, zogt Hashem Tseva'ot, un ich vel farbrenen oif roich ire raitvegn, un daine yungleibn vet fartseren di shverd; un ich vel farshnaidn fun der erd dain roib, un mer vet nisht gehert vern der kol fun daine shluchim.<verse eid="NAM 2:14" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="NAM 3" />
  <para style="q">
    <verse number="1" style="v" sid="NAM 3:1" />vei di blutike shtot,</para>
  <para style="q" vid="NAM 3:1">in gantsn mit falshkeit, mit roib, ongefilt!</para>
  <para style="q" vid="NAM 3:1">es tut zich nisht op di fartsukung.<verse eid="NAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 3:2" />a knal fun baitshn,</para>
  <para style="q" vid="NAM 3:2">un a raash-gepilder fun reder,</para>
  <para style="q" vid="NAM 3:2">un ferd yogn,</para>
  <para style="q" vid="NAM 3:2">un raitvegn shpringen;<verse eid="NAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 3:3" />raiter shturemen aroif,</para>
  <para style="q" vid="NAM 3:3">un flam fun shverd, un blits fun shpiz,</para>
  <para style="q" vid="NAM 3:3">un a sach dershlogene, un a hoifn pegorim,</para>
  <para style="q" vid="NAM 3:3">un on shieur toite laiber;</para>
  <para style="q" vid="NAM 3:3">un zei shtroichlen on zeyere toite laiber.<verse eid="NAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 3:4" />fun vegen di fil znusn fun der voil-chnevdiker zoine,</para>
  <para style="q" vid="NAM 3:4">der mainsterin fun kishef,</para>
  <para style="q" vid="NAM 3:4">vos farkoift felker mit ire znusn,</para>
  <para style="q" vid="NAM 3:4">un mishpoches mit ire kishefn.<verse eid="NAM 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="NAM 3:5" />ze, ich kum tsu dir, zogt Hashem Tseva'ot,</para>
  <para style="q" vid="NAM 3:5">un ich vel oifdekn daine bregn oif dain ponem,</para>
  <para style="q" vid="NAM 3:5">un vel vaizn di felker dain naketkeit,</para>
  <para style="q" vid="NAM 3:5">un di kinigraichn dain shand.<verse eid="NAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 3:6" />un ich vel aroifvarfn oif dir umverdikeitn,</para>
  <para style="q" vid="NAM 3:6">un vel dich farmioisn, un dich machn vi mist.<verse eid="NAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 3:7" />un es vet zain, ale vos zeen dich,</para>
  <para style="q" vid="NAM 3:7">veln vaichn fun dir, un zogn:</para>
  <para style="q" vid="NAM 3:7">farvist gevorn iz Nineveh; ver ken zi baklogn?</para>
  <para style="q" vid="NAM 3:7">fun vanen zol ich zuchn treister far dir?<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="NAM 3:8" />bistu den beser fun No-Amon,</para>
  <para style="q" vid="NAM 3:8">vos iz gezesn tsvishn taichn, mit vaser arum ir;</para>
  <para style="q" vid="NAM 3:8">vos ir festung iz geven der yam,</para>
  <para style="q" vid="NAM 3:8">fun yam iz geven ir moier?<verse eid="NAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 3:9" />Kush iz geven a shtarkeit, un Mitsrayim on shieur,</para>
  <para style="q" vid="NAM 3:9">Put un Luvim zainen geven dir tsu hilf.<verse eid="NAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 3:10" />ober oich zi iz in goles,</para>
  <para style="q" vid="NAM 3:10">in gefangenshaft iz zi gegangen;</para>
  <para style="q" vid="NAM 3:10">oich ire kleine kinder zainen tsehakt gevorn</para>
  <para style="q" vid="NAM 3:10">in ale ek gasn;</para>
  <para style="q" vid="NAM 3:10">un oif ire nichbdim hot men goirl gevorfn,</para>
  <para style="q" vid="NAM 3:10">un ale ire groise lait zainen in keitn geshmidt gevorn.<verse eid="NAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 3:11" />du oich vest shikur vern, vest zain a gechlshte,</para>
  <para style="q" vid="NAM 3:11">du oich vest zuchn a bashitsung fun faint.<verse eid="NAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 3:12" />ale daine festungen veln zain vi faignbeimer mit ershtfaign:</para>
  <para style="q" vid="NAM 3:12">vos az zei vern getreislt,</para>
  <para style="q" vid="NAM 3:12">faln zei dem eser in moil.<verse eid="NAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 3:13" />ze, dain folk in dir zainen vaiber,</para>
  <para style="q" vid="NAM 3:13">ofen geefent gevorn far daine faint</para>
  <para style="q" vid="NAM 3:13">zainen di toiern fun dain land,</para>
  <para style="q" vid="NAM 3:13">fartsert hot a faier daine riglen.<verse eid="NAM 3:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="NAM 3:14" />vaser far balegerung shep dir on,</para>
  <para style="q" vid="NAM 3:14">farshtark daine festungen,</para>
  <para style="q" vid="NAM 3:14">gei in leim un tret vapne,</para>
  <para style="q" vid="NAM 3:14">nem on di tsiglfurem.<verse eid="NAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 3:15" />dentsmol vet dich a faier fartseren,</para>
  <para style="q" vid="NAM 3:15">a shverd vet dich farshnaidn;</para>
  <para style="q" vid="NAM 3:15">zi vet dich oifesn vi der heisherik;</para>
  <para style="q" vid="NAM 3:15">megst zich mern vi der heisherik,</para>
  <para style="q" vid="NAM 3:15">megst zich mern vi der gril.<verse eid="NAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NAM 3:16" />host gemert daine handlslait main fun di shtern fun himel –</para>
  <para style="q" vid="NAM 3:16">hot der heisherik zich oisgeshpreit un iz avekgefloign.<verse eid="NAM 3:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="NAM 3:17" />daine gekrointe zainen vi griln,</para>
  <para style="q" vid="NAM 3:17">un daine komandir vi a machne heisherikn,</para>
  <para style="q" vid="NAM 3:17">vos lagern oif di ploitn in a kaltn tog;</para>
  <para style="q" vid="NAM 3:17">geit oif di zun, azoi flien zei avek,</para>
  <para style="q" vid="NAM 3:17">un me veist nisht zeyer ort vu zei zainen.<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="NAM 3:18" />aingeshlofn zainen daine pastucher, melech fun Ashur,</para>
  <para style="q" vid="NAM 3:18">es ruen daine machtike,</para>
  <para style="q" vid="NAM 3:18">tseshpreit oif di berg iz dain folk,</para>
  <para style="q" vid="NAM 3:18">un nishto ver zol ainzamlen.<verse eid="NAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NAM 3:19" />nishto kein linderung far dain broch,</para>
  <para style="q" vid="NAM 3:19">shver iz dain vund;</para>
  <para style="q" vid="NAM 3:19">ale vos hern dain herung,</para>
  <para style="q" vid="NAM 3:19">klapn mit di hent oif dir,</para>
  <para style="q" vid="NAM 3:19">vorem oif vemen iz nisht ariber tamid dain beiz?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>