<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Hoshea</para>
  <para style="toc2">Hoshea</para>
  <para style="toc1">Hoshea</para>
  <para style="mt1">Hoshea</para>
  <chapter number="1" style="c" pubnumber="א" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />dos vort fun Hashem vos iz geven tsu Hoshea dem zun fun Beerien, in di teg fun Uziyah, Yotam, Achaz, Yechizkiyah, di mlochim fun Yehudah, un in di teg fun Yarovam dem zun fun Yoashn, dem melech fun Yisroel.<verse eid="HOS 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />dos ershte vos Hashem hot geredt tsu Hoshean, hot Hashem gezogt tsu Hoshean: gei nem dir a vaib a zoine, un kinder fun a zoine, vorem mizane tut mizane zain dos land, avek fun hinter Hashem. <verse eid="HOS 1:2" /><verse number="3" style="v" sid="HOS 1:3" />iz er gegangen un hot genumen Gomer di tochter fun Divlayimen, un zi iz trogedik gevorn, un hot im geborn a zun.<verse eid="HOS 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4" />un Hashem hot tsu im gezogt: ruf zain nomen Yizreel, vorem noch a klein vaile, un ich vel zich rechenen far dem blut fun Yizreel mit dem hoiz fun Yehu, un ich vel farshtern di meluche fun dem hoiz fun Yisroel. <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />un es vet zain in yenem tog, vel ich tsebrechn dem boign fun Yisroel in tal Yizreel.<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />un zi iz vider trogedik gevorn, un hot geborn a tochter. un er hot tsu im gezogt: ruf ir nomen Lo-Ruchamah, vorem ich vel mer vider nisht rachmones hobn oif dem hoiz fun Yisroel, az fargebn zol ich zei fargebn. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />ober oif dem hoiz fun Yehudah vel ich rachmones hobn, un ich vel zei helfn durch Hashem zeyer G-t, un ich vel zei nisht helfn durch boign un durch shverd un durch milchome, durch ferd un durch raiter.<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />un zi hot antvoint Lo-Ruchamahn, un zi iz trogedik gevorn, un hot geborn a zun. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />un er hot gezogt: ruf zain nomen nisht-main-folk, vorem ir zeit nisht main folk, un ich bin nisht aiere.<verse eid="HOS 1:9" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1.10" sid="HOS 2:1" /> un di tsol fun di kinder fun Yisroel vet zain azoi vi di zamd fun yam, vos ken nisht gemestn un nisht getseilt vern; un es vet zain, anshtot vos tsu zei flegt gezogt vern: ir zait nisht main folk, vet tsu zei gezogt vern: kinder fun dem lebedikn El. <verse eid="HOS 2:1" /><verse number="2" style="v" pubnumber="1.11" sid="HOS 2:2" /> un di kinder fun Yehudah un di kinder fun Yisroel veln zich ainzamlen in einem, un zei veln zich machn ein hoiptman, un zei veln aroifgein fun dem land, vorem grois vet zain der tog fun Yizreel.<verse eid="HOS 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="2.1" sid="HOS 2:3" /> zogt tsu aiere brider: Ami, un tsu aier shvester: ruchame.<verse eid="HOS 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" pubnumber="2.2" sid="HOS 2:4" /> krigt aich mit aier muter, krigt aich,</para>
  <para style="q" vid="HOS 2:4">vorem zi iz nisht main vaib,</para>
  <para style="q" vid="HOS 2:4">un ich bin nisht ir man;</para>
  <para style="q" vid="HOS 2:4">un zol zi opton ir zoines fun ir ponem,</para>
  <para style="q" vid="HOS 2:4">un ir niuf fun tsvishn ire brist.<verse eid="HOS 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="2.3" sid="HOS 2:5" /> anit vel ich zi oiston a nakete,</para>
  <para style="q" vid="HOS 2:5">un zi lozn shtein vi in tog fun ir gebornshaft;</para>
  <para style="q" vid="HOS 2:5">un ich vel zi machn vi a midber,</para>
  <para style="q" vid="HOS 2:5">un zi lozn vern vi a trukn land,</para>
  <para style="q" vid="HOS 2:5">un zi teitn mit dorsht.<verse eid="HOS 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" pubnumber="2.4" sid="HOS 2:6" /> un ire kinder vel ich nisht derbaremen,</para>
  <para style="q" vid="HOS 2:6">vorem kinder fun zoines zainen zei.<verse eid="HOS 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" pubnumber="2.5" sid="HOS 2:7" /> vorem mizane geven hot zeyer muter,</para>
  <para style="q" vid="HOS 2:7">farmiust hot zich zeyer gevinerin.</para>
  <para style="q" vid="HOS 2:7">vorem zi hot gezogt: ich vel gein noch maine libhober,</para>
  <para style="q" vid="HOS 2:7">di vos gibn main broit un main vaser,</para>
  <para style="q" vid="HOS 2:7">main vol un main flaks, main eil un main trank.<verse eid="HOS 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="2.6" sid="HOS 2:8" /> derum ze, ich farshtel dain veg mit derner,</para>
  <para style="q" vid="HOS 2:8">un vel fartsamen a tsam arum ir,</para>
  <para style="q" vid="HOS 2:8">az zi zol ire shtegn nisht gefinen.<verse eid="HOS 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" pubnumber="2.7" sid="HOS 2:9" /> un zi vet nochyogn ire libhober</para>
  <para style="q" vid="HOS 2:9">un zei nisht dergreichn,</para>
  <para style="q" vid="HOS 2:9">un zi vet zei zuchn un nisht gefinen;</para>
  <para style="q" vid="HOS 2:9">un zi vet zogn:</para>
  <para style="q" vid="HOS 2:9">ich vel gein un zich umkeren tsu main ershtn man,</para>
  <para style="q" vid="HOS 2:9">vorem dentsmol iz mir beser geven vi atsund.<verse eid="HOS 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="2.8" sid="HOS 2:10" /> un zi veis nisht, az dos hob ich ir gegebn</para>
  <para style="q" vid="HOS 2:10">di tvue, dem vain, un dos eil;</para>
  <para style="q" vid="HOS 2:10">un dos zilber un gold vos ich hob ir gemert,</para>
  <para style="q" vid="HOS 2:10">hobn zei farton oif Baal.<verse eid="HOS 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" pubnumber="2.9" sid="HOS 2:11" /> derum vel ich tsuriknemen</para>
  <para style="q" vid="HOS 2:11">main tvue in ir tsait,</para>
  <para style="q" vid="HOS 2:11">un main vain in zain geshtelter tsait,</para>
  <para style="q" vid="HOS 2:11">un ich vel avekraisn main vol un main flaks,</para>
  <para style="q" vid="HOS 2:11">vos iz geven ir naketkeit tsu fardekn.<verse eid="HOS 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" pubnumber="2.10" sid="HOS 2:12" /> un atsund vel ich antplekn ir shand</para>
  <para style="q" vid="HOS 2:12">far di oign fun ire libhober,</para>
  <para style="q" vid="HOS 2:12">un keiner vet zi nisht matsl zain fun main hant.<verse eid="HOS 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="2.11" sid="HOS 2:13" /> un ich vel machn oifhern ir gantse freid;</para>
  <para style="q" vid="HOS 2:13">ir yom-tov, ir rosh-choidesh, un ir Shabbos,</para>
  <para style="q" vid="HOS 2:13">un ale ire faierteg.<verse eid="HOS 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" pubnumber="2.12" sid="HOS 2:14" /> un ich vel farvistn ir vainshtok un ir faignboim,</para>
  <para style="q" vid="HOS 2:14">vos zi hot gezogt: a matone zainen zei mir,</para>
  <para style="q" vid="HOS 2:14">vos maine libhober hobn mir gegebn;</para>
  <para style="q" vid="HOS 2:14">un ich vel zei machn far a vald,</para>
  <para style="q" vid="HOS 2:14">un di chaye fun feld vet zei oifesn.<verse eid="HOS 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" pubnumber="2.13" sid="HOS 2:15" /> un ich vel zich rechenen mit ir</para>
  <para style="q" vid="HOS 2:15">far di teg fun di Baal-geter,</para>
  <para style="q" vid="HOS 2:15">vos zi hot gereichert tsu zei,</para>
  <para style="q" vid="HOS 2:15">un ongeton ire oiringen un ir tsirung,</para>
  <para style="q" vid="HOS 2:15">un gegangen noch ire libhober,</para>
  <para style="q" vid="HOS 2:15">un on mir hot zi fargesen, zogt Hashem.<verse eid="HOS 2:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" pubnumber="2.14" sid="HOS 2:16" /> ober ze, ich red zi iber,</para>
  <para style="q" vid="HOS 2:16">un vel zi avekfiren in midber,</para>
  <para style="q" vid="HOS 2:16">un vel redn tsu ir hartsn.<verse eid="HOS 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" pubnumber="2.15" sid="HOS 2:17" /> un ich vel tsu ir fun dort opgebn ire vaingertner,</para>
  <para style="q" vid="HOS 2:17">un dem tal Achor far a tir fun hofenung;</para>
  <para style="q" vid="HOS 2:17">un zi vet dortn oprufn zich vi in di teg fun ir yugnt</para>
  <para style="q" vid="HOS 2:17">un vi in tog fun ir aroifgein fun land Mitsrayim.<verse eid="HOS 2:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" pubnumber="2.16" sid="HOS 2:18" /> un es vet zain in yenem tog, zogt Hashem, vestu rufn: main man, un vest mich mer nisht rufn: main Baal. <verse eid="HOS 2:18" /><verse number="19" style="v" pubnumber="2.17" sid="HOS 2:19" /> un ich vel opton di nemen fun di Baal-geter fun ir moil, un zei veln mer nisht gedacht vern mit zeyer nomen. <verse eid="HOS 2:19" /><verse number="20" style="v" pubnumber="2.18" sid="HOS 2:20" /> un ich vel zei shlisn a bris in yenem tog, mit der chaye fun feld, un mit dem foigel fun himel, un mit dem sherets fun der erd. un a boign un shverd un milchome vel ich tsebrechn fun land, un ich vel zei machn lign in zicherkeit. <verse eid="HOS 2:20" /><verse number="21" style="v" pubnumber="2.19" sid="HOS 2:21" /> un ich vel dich farknasn tsu mir oif eibik, un dich farknasn tsu mir mit recht un mit gerechtikeit, un mit genod un mit baremhartsikeit. <verse eid="HOS 2:21" /><verse number="22" style="v" pubnumber="2.20" sid="HOS 2:22" /> un ich vel dich farknasn tsu mir mit traishaft, un vest derkenen Hashem.<verse eid="HOS 2:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" pubnumber="2.21" sid="HOS 2:23" /> un es vet zain in yenem tog,</para>
  <para style="q" vid="HOS 2:23">vel ich entfern, zogt Hashem,</para>
  <para style="q" vid="HOS 2:23">vel ich entfern di himlen,</para>
  <para style="q" vid="HOS 2:23">un zei veln entfern der erd,<verse eid="HOS 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" pubnumber="2.22" sid="HOS 2:24" /> un di erd vet entfern der tvue,</para>
  <para style="q" vid="HOS 2:24">un dem vain, un dem eil,</para>
  <para style="q" vid="HOS 2:24">un zei veln entfern Yizreel.<verse eid="HOS 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" pubnumber="2.23" sid="HOS 2:25" /> un ich vel zi mir ainzeyen in land,</para>
  <para style="q" vid="HOS 2:25">un ich vel derbaremen di nisht derbaremte,</para>
  <para style="q" vid="HOS 2:25">un vel zogn tsu nisht-main-folk: main folk bistu,</para>
  <para style="q" vid="HOS 2:25">un er vet zogn: main G-t.<verse eid="HOS 2:25" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="HOS 3" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />un Hashem hot tsu mir gezogt: gei vider hob lib a froi, gelibt fun a libhober, ober a noyefte; azoi vi Hashem hot lib di kinder fun Yisroel, un zei kern zich tsu fremder g‑ter, un hobn lib rozinkeskuchns.<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />hob ich zi mir gekoift far fuftsn zilbershtik, un a chomer gershtn, un a letech gershtn. <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />un ich hob tsu ir gezogt: fil teg zolstu mir zitsn alein, zolst nisht mizane zain, un nisht gehern tsu kein man, un des glaichn ich kegen dir. <verse eid="HOS 3:3" /><verse number="4" style="v" sid="HOS 3:4" />vorem fil teg veln di kinder fun Yisroel zitsn on a melech, un on a har, un on a shlachtopfer, un on a zailshtein, un on an ephod un trofim. <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />dernoch veln di kinder fun Yisroel zich umkeren, un zei veln zuchn Hashem zeyer G-t, un Dovid zeyer melech, un zei veln angstn tsu Hashem un tsu zain guts, in sof fun di teg.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="HOS 4" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 4:1" />hert dos vort fun Hashem, ir kinder fun Yisroel,</para>
  <para style="q" vid="HOS 4:1">vorem Hashem hot a krig mit di bavoiner fun land,</para>
  <para style="q" vid="HOS 4:1">vail kein emes un kein genod,</para>
  <para style="q" vid="HOS 4:1">un kein derkenung fun Elokim iz nishto in land.<verse eid="HOS 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 4:2" />shvern un leikenen un teitn</para>
  <para style="q" vid="HOS 4:2">un ganven un mizane zain, zainen farshpreit,</para>
  <para style="q" vid="HOS 4:2">un blut on blut rirt zich on.<verse eid="HOS 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 4:3" />derum ver troiern dos land,</para>
  <para style="q" vid="HOS 4:3">un farvelkt vern vet itlecher voiner derin,</para>
  <para style="q" vid="HOS 4:3">mit der chaye fun feld, un mitn foigel fun himel;</para>
  <para style="q" vid="HOS 4:3">un afile di fishn fun yam veln aingeton vern.<verse eid="HOS 4:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 4:4" />ober keiner tor zich nisht krign,</para>
  <para style="q" vid="HOS 4:4">un nisht shtrofn tor keiner,</para>
  <para style="q" vid="HOS 4:4">vorem dain folk zainen azelche</para>
  <para style="q" vid="HOS 4:4">vos krign zich mitn koyen.<verse eid="HOS 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 4:5" />derum vestu shtroichlen bai tog,</para>
  <para style="q" vid="HOS 4:5">un oich der novi vet geshtroichlt vern mit dir bai nacht,</para>
  <para style="q" vid="HOS 4:5">un ich vel farshnaidn dain muter.<verse eid="HOS 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 4:6" />farshnitn vert main folk fun nisht visnshaft;</para>
  <para style="q" vid="HOS 4:6">vail du host faracht visnshaft,</para>
  <para style="q" vid="HOS 4:6">derum hob ich dich faracht fun tsu zain mir a koyen;</para>
  <para style="q" vid="HOS 4:6">az du host fargesen di toyre fun dain G-t,</para>
  <para style="q" vid="HOS 4:6">vel ich oich fargesen on daine kinder.<verse eid="HOS 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 4:7" />vi zei hobn zich gemert, azoi hobn zei gezindikt tsu mir;</para>
  <para style="q" vid="HOS 4:7">vel ich zeyer koved oif shand umbaitn.<verse eid="HOS 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 4:8" />zei esen oif di zindopfer fun main folk,</para>
  <para style="q" vid="HOS 4:8">un oif zeyer farbrech kukn zei ois.<verse eid="HOS 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 4:9" />derum vet zain, azoi dos folk azoi der koyen,</para>
  <para style="q" vid="HOS 4:9">un ich vel zich rechenen mit im far zaine vegen,</para>
  <para style="q" vid="HOS 4:9">un zaine meisim vel ich im umkeren.<verse eid="HOS 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 4:10" />un zei veln esen un nisht zat vern,</para>
  <para style="q" vid="HOS 4:10">zei zainen mizane, ober zei veln zich nisht mern;</para>
  <para style="q" vid="HOS 4:10">vail zei hobn oifgehert oif Hashem tsu achten.<verse eid="HOS 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 4:11" />zoines un vain un troibnzaft</para>
  <para style="q" vid="HOS 4:11">farknechtikn dos harts.<verse eid="HOS 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 4:12" />main folk fregt bai zei holts,</para>
  <para style="q" vid="HOS 4:12">un zain shtekn basheidt im;</para>
  <para style="q" vid="HOS 4:12">vorem a gaist fun zoines hot farfirt,</para>
  <para style="q" vid="HOS 4:12">un zei hobn zich opgekert fun unter zeyer G-t.<verse eid="HOS 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 4:13" />oif di shpitsn berg shlachtn zei,</para>
  <para style="q" vid="HOS 4:13">un oif di heichn reichern zei,</para>
  <para style="q" vid="HOS 4:13">unter eichnboim un topolie un terebint,</para>
  <para style="q" vid="HOS 4:13">vail zain shotn iz gut.</para>
  <para style="q" vid="HOS 4:13">derum zainen aiere techter mizane,</para>
  <para style="q" vid="HOS 4:13">un aiere shenir zainen umgetrai.<verse eid="HOS 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 4:14" />ich fardenk nisht aiere techter vos zei zainen mizane,</para>
  <para style="q" vid="HOS 4:14">un aiere shenir vos zei zainen umgetrai,</para>
  <para style="q" vid="HOS 4:14">vail di mentshn alein geyen mit zoinus avek,</para>
  <para style="q" vid="HOS 4:14">un mit shandvaiber brengen zei shlachtopfer;</para>
  <para style="q" vid="HOS 4:14">un dos folk vos farshteit nisht, vert geshtroichlt.<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 4:15" />oib du Yisroel bist mizane,</para>
  <para style="q" vid="HOS 4:15">zol zich Yehudah nisht farshuldikn;</para>
  <para style="q" vid="HOS 4:15">un kumt nisht kein Gilgal,</para>
  <para style="q" vid="HOS 4:15">un geit nisht aroif kein Beis-Aven,</para>
  <para style="q" vid="HOS 4:15">un shvert nisht: azoi vi Hashem lebt!<verse eid="HOS 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 4:16" />vorem azoi vi a vidershpenike ku</para>
  <para style="q" vid="HOS 4:16">hot vidershpenikt Yisroel;</para>
  <para style="q" vid="HOS 4:16">zol Hashem zei atsund fitern</para>
  <para style="q" vid="HOS 4:16">vi a sheps in derbreiternish?<verse eid="HOS 4:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="HOS 4:17" />baheft tsu getsnbilder iz Efrayim,</para>
  <para style="q" vid="HOS 4:17">loz im tsu ru.<verse eid="HOS 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HOS 4:18" />geit op zeyer shikres,</para>
  <para style="q" vid="HOS 4:18">zainen zei in zoines farzunken;</para>
  <para style="q" vid="HOS 4:18">aingelibt in shand zainen ire bashitser.<verse eid="HOS 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 4:19" />der vint hot zei aingebundn in zaine fliglen;</para>
  <para style="q" vid="HOS 4:19">un zei veln zich shemen mit zeyere shlachtopfer.<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="HOS 5" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 5:1" />hert dos tsu, ir koyanim,</para>
  <para style="q" vid="HOS 5:1">un farnemt, ir hoiz fun Yisroel,</para>
  <para style="q" vid="HOS 5:1">un ir hoiz fun melech, leigt tsu dos oier,</para>
  <para style="q" vid="HOS 5:1">vorem oif aich iz a mishpot faran,</para>
  <para style="q" vid="HOS 5:1">vail a pastke zait ir geven far Mitspah,</para>
  <para style="q" vid="HOS 5:1">un an oisgeshpreite nets oif Tavor.<verse eid="HOS 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 5:2" />un di opkerer zainen in shechtn fartift,</para>
  <para style="q" vid="HOS 5:2">un ich bin geven a shtrof bai zei alemen.<verse eid="HOS 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 5:3" />ich ken Efrayim,</para>
  <para style="q" vid="HOS 5:3">un Yisroel iz nisht farhoiln fun mir;</para>
  <para style="q" vid="HOS 5:3">vorem atsund hostu mizane geven, Efrayim,</para>
  <para style="q" vid="HOS 5:3">farumreinikt gevorn iz Yisroel.<verse eid="HOS 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 5:4" />zeyere meisim lozn zei nisht</para>
  <para style="q" vid="HOS 5:4">zich umtsukeren tsu zeyer G-t,</para>
  <para style="q" vid="HOS 5:4">vorem a gaist fun zoines iz in zei,</para>
  <para style="q" vid="HOS 5:4">un Hashem kenen zei nisht.<verse eid="HOS 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 5:5" />un der shtolts fun Yisroel vet dershpalt vern far zain ponem,</para>
  <para style="q" vid="HOS 5:5">un Yisroel un Efrayim veln geshtroichlt vern durch zeyer zind,</para>
  <para style="q" vid="HOS 5:5">oich Yehudah tut shtroichlen mit zei.<verse eid="HOS 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 5:6" />mit zeyere shof un mit zeyere rinder</para>
  <para style="q" vid="HOS 5:6">veln zei gein zuchn Hashem,</para>
  <para style="q" vid="HOS 5:6">ober zei veln nisht gefinen –</para>
  <para style="q" vid="HOS 5:6">er hot zich opgeton fun zei.<verse eid="HOS 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 5:7" />zei hobn on Hashem gefelsht,</para>
  <para style="q" vid="HOS 5:7">vorem fremde kinder hobn zei geborn;</para>
  <para style="q" vid="HOS 5:7">atsund vet zei a choidesh fartseren mit zeyere felder.<verse eid="HOS 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="HOS 5:8" />blozt a shoifer in Givah, a trumeiter in Ramah;</para>
  <para style="q" vid="HOS 5:8">shalt in Beis-Aven: kuk zich um, Binyamin!<verse eid="HOS 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 5:9" />Efrayim vet tsu vist vern in tog fun shtrof;</para>
  <para style="q" vid="HOS 5:9">in di shvotim fun Yisroel tu ich es tsu visen oif zicher.<verse eid="HOS 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 5:10" />di harn fun Yehudah zainen vi grenetsfarchaper,</para>
  <para style="q" vid="HOS 5:10">oif zei vel ich oisgisen vi vaser main tsorn.<verse eid="HOS 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 5:11" />gedrikt vert Efrayim, tsebrochn fun mishpot,</para>
  <para style="q" vid="HOS 5:11">vail er iz vilendik gegangen noch gebot.<verse eid="HOS 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 5:12" />un ich bin vi a milb tsu Efrayim,</para>
  <para style="q" vid="HOS 5:12">un vi a foilung tsu dem hoiz fun Yehudah.<verse eid="HOS 5:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="HOS 5:13" />un Efrayim hot gezen zain krankshaft,</para>
  <para style="q" vid="HOS 5:13">un Yehudah zain vund;</para>
  <para style="q" vid="HOS 5:13">iz Efrayim gegangen tsu Ashur,</para>
  <para style="q" vid="HOS 5:13">un hot geshikt tsum melech yoreb;</para>
  <para style="q" vid="HOS 5:13">ober er ken aich nisht heiln,</para>
  <para style="q" vid="HOS 5:13">un er vet nisht opton fun aich di vund.<verse eid="HOS 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 5:14" />vorem ich vel zain vi a leib tsu Efrayim,</para>
  <para style="q" vid="HOS 5:14">un vi a yungleib tsum hoiz fun Yehudah;</para>
  <para style="q" vid="HOS 5:14">ich, ich vel fartsukn un avekgein,</para>
  <para style="q" vid="HOS 5:14">avektrogen, un keiner vet nisht matsl zain.<verse eid="HOS 5:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 5:15" />ich vel gein, ich vel zich umkeren tsu main ort,</para>
  <para style="q" vid="HOS 5:15">biz zei veln zich shpiren shuldikn,</para>
  <para style="q" vid="HOS 5:15">un zuchn main ponem;</para>
  <para style="q" vid="HOS 5:15">in zeyer noit veln zei mich forshn.<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="HOS 6" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 6:1" />kumt un lomir zich umkeren tsu Hashem,</para>
  <para style="q" vid="HOS 6:1">vorem er hot fartsukt, un er vet undz heiln,</para>
  <para style="q" vid="HOS 6:1">er shlogt un er vet undz farbindn,<verse eid="HOS 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 6:2" />noch tsvei teg vet er undz oiflebn,</para>
  <para style="q" vid="HOS 6:2">oifn dritn tog vet er undz oifrichtn,</para>
  <para style="q" vid="HOS 6:2">un mir veln lebn far im.<verse eid="HOS 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 6:3" />un lomir derkenen, lomir zich yogn tsu derkenen Hashem;</para>
  <para style="q" vid="HOS 6:3">zicher vi der baginen iz zain aroisgang;</para>
  <para style="q" vid="HOS 6:3">un er vet kumen tsu undz vi der regn,</para>
  <para style="q" vid="HOS 6:3">un vi shpetregn vos bavasert di erd.<verse eid="HOS 6:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 6:4" />vos zol ich ton tsu dir, Efrayim?</para>
  <para style="q" vid="HOS 6:4">vos zol ich ton tsu dir, Yehudah?</para>
  <para style="q" vid="HOS 6:4">az aier gutskeit iz vi a frimorgnvolkn,</para>
  <para style="q" vid="HOS 6:4">un vi der toi vos fargeit in der peire.<verse eid="HOS 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 6:5" />derum hob ich gehakt durch di neviim,</para>
  <para style="q" vid="HOS 6:5">zei geharget mit di verter fun main moil;</para>
  <para style="q" vid="HOS 6:5">kedei dain mishpot zol vi dos licht arois.<verse eid="HOS 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 6:6" />vorem chesed hob ich bagert un nisht shlachtopfer,</para>
  <para style="q" vid="HOS 6:6">un derkenung fun Elokim eider brandopfer.<verse eid="HOS 6:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 6:7" />ober zei vi Adam hobn ibergetretn dem bris;</para>
  <para style="q" vid="HOS 6:7">on hobn zei gefelsht on mir.<verse eid="HOS 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 6:8" />Gilad iz a shtot fun umrechttuer,</para>
  <para style="q" vid="HOS 6:8">oisgetretn mit blut.<verse eid="HOS 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 6:9" />un vi bandes vos loiern oif mentshn,</para>
  <para style="q" vid="HOS 6:9">iz di chvrh fun di koyanim;</para>
  <para style="q" vid="HOS 6:9">zei teitn oifn veg kein Shechem,</para>
  <para style="q" vid="HOS 6:9">yo, shendlechkeit bageyen zei.<verse eid="HOS 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 6:10" />in hoiz fun Yisroel hob ich shoiderhaftiks gezen,</para>
  <para style="q" vid="HOS 6:10">on iz zoines bai Efrayim,</para>
  <para style="q" vid="HOS 6:10">farumreinikt iz Yisroel.<verse eid="HOS 6:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 6:11" />oich oif dir, Yehudah, hot men a shnit bashert.</para>
  <para style="b" vid="HOS 6:11" />
  <para style="q" vid="HOS 6:11">az ich vil umkeren di gefangenshaft fun main folk,<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="HOS 7" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 7:1" />vi ich vil heiln Yisroel,</para>
  <para style="q" vid="HOS 7:1">azoi vert antplekt di zind fun Efrayim,</para>
  <para style="q" vid="HOS 7:1">un di beizn fun Shomron;</para>
  <para style="q" vid="HOS 7:1">vorem zei bageyen falshkeit,</para>
  <para style="q" vid="HOS 7:1">un a ganev brecht ain,</para>
  <para style="q" vid="HOS 7:1">a bande bafalt oif der gas.<verse eid="HOS 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 7:2" />un zoln zei zich nisht trachtn in zeyer hartsn,</para>
  <para style="q" vid="HOS 7:2">al dos beiz zeyers gedenk ich;</para>
  <para style="q" vid="HOS 7:2">atsund hobn zeyere meisim zei arumgeringlt,</para>
  <para style="q" vid="HOS 7:2">akegn main ponem zainen zei.<verse eid="HOS 7:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 7:3" />mit zeyer beiz derfreyen zei dem melech,</para>
  <para style="q" vid="HOS 7:3">un mit zeyere ligns di harn.<verse eid="HOS 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 7:4" />ale zainen zei nofim,</para>
  <para style="q" vid="HOS 7:4">vi an oivn ongeheitst fun beker,</para>
  <para style="q" vid="HOS 7:4">vos me hert bloiz oif sharn</para>
  <para style="q" vid="HOS 7:4">fun farknetn dem teig biz zain zoier vern.<verse eid="HOS 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 7:5" />in dem tog fun undzer melech,</para>
  <para style="q" vid="HOS 7:5">zainen di harn krank fun vainderhitsung;</para>
  <para style="q" vid="HOS 7:5">er alein shtrekt ois zain hant mit di shpeter.<verse eid="HOS 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 7:6" />vorem zei hobn tsugebreit zeyer harts</para>
  <para style="q" vid="HOS 7:6">vi an oivn in zeyer loier;</para>
  <para style="q" vid="HOS 7:6">a gantse nacht shloft zeyer beker,</para>
  <para style="q" vid="HOS 7:6">frimorgns brent er azoi vi flamfaier.<verse eid="HOS 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 7:7" />zei ale glien vi an oivn,</para>
  <para style="q" vid="HOS 7:7">un zei fartseren zeyere richter;</para>
  <para style="q" vid="HOS 7:7">ale zeyere mlochim zainen gefaln,</para>
  <para style="q" vid="HOS 7:7">keiner tsvishn zei ruft nisht tsu mir.<verse eid="HOS 7:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="HOS 7:8" />Efrayim, er misht zich mit di felker,</para>
  <para style="q" vid="HOS 7:8">Efrayim iz gevorn a nisht ibergekerter kuchn.<verse eid="HOS 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 7:9" />fremde hobn oifgegesn zain koiech,</para>
  <para style="q" vid="HOS 7:9">un er merkt nisht;</para>
  <para style="q" vid="HOS 7:9">shoin groe hor durchgeshpritst bai im,</para>
  <para style="q" vid="HOS 7:9">un er merkt nisht.<verse eid="HOS 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 7:10" />un der shtolts fun Yisroel iz geboign far zain ponem,</para>
  <para style="q" vid="HOS 7:10">ober zei kern zich nisht um tsu Hashem zeyer G-t,</para>
  <para style="q" vid="HOS 7:10">un zei zuchn im nisht bai alem dem.<verse eid="HOS 7:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 7:11" />un Efrayim iz gevorn vi a narishe toib, on seichel,</para>
  <para style="q" vid="HOS 7:11">Mitsrayim hobn zei gerufn,</para>
  <para style="q" vid="HOS 7:11">kein Ashur zainen zei gegangen.<verse eid="HOS 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 7:12" />vi zei veln gein, vel ich oisshpreitn oif zei main nets,</para>
  <para style="q" vid="HOS 7:12">vi foiglen fun himel vel ich zei aropnideren;</para>
  <para style="q" vid="HOS 7:12">ich vel zei shtrofn vi ich hob gelozt hern zeyer eide.<verse eid="HOS 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 7:13" />vei tsu zei, vos zei zainen avek fun mir!</para>
  <para style="q" vid="HOS 7:13">farvistung oif zei, vos zei hobn gebrochn on mir!</para>
  <para style="q" vid="HOS 7:13">un ich zol zei oisleizen,</para>
  <para style="q" vid="HOS 7:13">ven zei hobn geredt ligns oif mir?<verse eid="HOS 7:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="HOS 7:14" />un zei shraien nisht tsu mir mit zeyer hartsn,</para>
  <para style="q" vid="HOS 7:14">az zei yomern oif zeyere gelegers;</para>
  <para style="q" vid="HOS 7:14">vegen tvue un vain rudlen zei zich,</para>
  <para style="q" vid="HOS 7:14">on mir vidershpenikn zei.<verse eid="HOS 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 7:15" />un ich hob gelernt,</para>
  <para style="q" vid="HOS 7:15">geshtarkt zeyere orems,</para>
  <para style="q" vid="HOS 7:15">ober zei trachtn shlechts oif mir.<verse eid="HOS 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 7:16" />zei kern zich, ober nisht tsu der heich,</para>
  <para style="q" vid="HOS 7:16">vi a falsher boign zainen zei gevorn.</para>
  <para style="q" vid="HOS 7:16">veln faln durchn shverd zeyere harn</para>
  <para style="q" vid="HOS 7:16">far dem tsorn fun zeyer tsung;</para>
  <para style="q" vid="HOS 7:16">dos vet zain a shpot fun zei in land Mitsrayim.<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="HOS 8" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 8:1" />tsu dain gumen a shoifer!</para>
  <para style="q" vid="HOS 8:1">vi an odler kumt oif Hashems hoiz;</para>
  <para style="q" vid="HOS 8:1">vail zei hobn ibergetretn main bris,</para>
  <para style="q" vid="HOS 8:1">un kegen main toyre farbrochn.<verse eid="HOS 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 8:2" />ken Yisroel den shraien tsu mir:</para>
  <para style="q" vid="HOS 8:2">main G-t, mir kenen dich?<verse eid="HOS 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 8:3" />Yisroel hot farlozt dos guts,</para>
  <para style="q" vid="HOS 8:3">zol im der faint nochyogn.<verse eid="HOS 8:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 8:4" />zei hobn gemacht mlochim, ober on mir,</para>
  <para style="q" vid="HOS 8:4">gemacht harn, un ich hob nisht gevust;</para>
  <para style="q" vid="HOS 8:4">fun zeyer zilber un zeyer gold</para>
  <para style="q" vid="HOS 8:4">hobn zei zich getsnbilder gemacht;</para>
  <para style="q" vid="HOS 8:4">derum vet er farshnitn vern.<verse eid="HOS 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 8:5" />farlozen vert dain kalb, Shomron;</para>
  <para style="q" vid="HOS 8:5">main tsorn tut grimen oif zei;</para>
  <para style="q" vid="HOS 8:5">biz vanen noch veln zei nisht kenen zich reiniken?<verse eid="HOS 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 8:6" />vorem es kumt fun Yisroel,</para>
  <para style="q" vid="HOS 8:6">un dos hot a mainster gemacht,</para>
  <para style="q" vid="HOS 8:6">un kein G-t iz dos nisht;</para>
  <para style="q" vid="HOS 8:6">far vor, shpendlech vet vern dos kalb fun Shomron.<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 8:7" />vorem vint zeyen zei,</para>
  <para style="q" vid="HOS 8:7">un shturem veln zei shnaidn;</para>
  <para style="q" vid="HOS 8:7">kein zang hot es nisht –</para>
  <para style="q" vid="HOS 8:7">a shprotsung vos brengt nisht kein mel;</para>
  <para style="q" vid="HOS 8:7">tomer vet es brengen, veln es fremde ainshlingen.<verse eid="HOS 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 8:8" />aingeshlungen gevorn iz Yisroel,</para>
  <para style="q" vid="HOS 8:8">atsund zainen zei gevorn tsvishn di felker,</para>
  <para style="q" vid="HOS 8:8">vi a nishtvertike keile.<verse eid="HOS 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 8:9" />vorem zei zainen aroifgegangen tsu Ashur,</para>
  <para style="q" vid="HOS 8:9">a vildeizl bazunder far zich;</para>
  <para style="q" vid="HOS 8:9">Efrayim hot libshaft gedungen.<verse eid="HOS 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 8:10" />ober hagam zei dingen tsvishn di felker,</para>
  <para style="q" vid="HOS 8:10">vel ich atsundert zei ainzamlen;</para>
  <para style="q" vid="HOS 8:10">un zei veln onheibn miner vern</para>
  <para style="q" vid="HOS 8:10">fun der mase fun melech un harn.<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 8:11" />vorem Efrayim hot gemert mizbeyches tsum zindikn,</para>
  <para style="q" vid="HOS 8:11">bai im zainen mizbeyches tsum zindikn geven.<verse eid="HOS 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 8:12" />vi fil fun main toyre ich zol im shraibn,</para>
  <para style="q" vid="HOS 8:12">iz dos bai im vi fremd farrechnt.<verse eid="HOS 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 8:13" />maine brandopfer zoln zei shlachtn far fleish un esen,</para>
  <para style="q" vid="HOS 8:13">Hashem tut zei nisht bafilikn.</para>
  <para style="q" vid="HOS 8:13">atsund vet er gedenken zeyer farbrech,</para>
  <para style="q" vid="HOS 8:13">un vet rechenen zeyere zind;</para>
  <para style="q" vid="HOS 8:13">kein Mitsrayim veln zei zich umkeren.<verse eid="HOS 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 8:14" />vorem Yisroel hot fargesen on zain Bashefer,</para>
  <para style="q" vid="HOS 8:14">un hot hichlut geboit,</para>
  <para style="q" vid="HOS 8:14">un Yehudah hot gemert bafestikte shtet:</para>
  <para style="q" vid="HOS 8:14">derum vel ich shikn a faier in zaine shtet,</para>
  <para style="q" vid="HOS 8:14">un es vet fartseren ire palatsn.<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="HOS 9" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 9:1" />nisht freyen zolstu zich, Yisroel,</para>
  <para style="q" vid="HOS 9:1">mit simche azoi vi di felker,</para>
  <para style="q" vid="HOS 9:1">vorem host zich opgekert fun dain G-t,</para>
  <para style="q" vid="HOS 9:1">host lib gehat zoine-loin oif ale tvue dresh-shaier.<verse eid="HOS 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 9:2" />der dresh-shaier un der kelter vet zei nisht shpaizn,</para>
  <para style="q" vid="HOS 9:2">un der frishvain vet felshn on zei.<verse eid="HOS 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 9:3" />zei veln nisht zitsn in land fun Hashem,</para>
  <para style="q" vid="HOS 9:3">un Efrayim vet zich kein Mitsrayim umkeren,</para>
  <para style="q" vid="HOS 9:3">un in Ashur veln zei umreins esen.<verse eid="HOS 9:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 9:4" />zei veln nisht gisn tsu Hashem vain,</para>
  <para style="q" vid="HOS 9:4">un nisht ongeleigt veln im zain zeyere shlachtopfer,</para>
  <para style="q" vid="HOS 9:4">azoi vi broit fun avlut vet es zei zain,</para>
  <para style="q" vid="HOS 9:4">ale vos esen es veln zich farumreinikn;</para>
  <para style="q" vid="HOS 9:4">vorem zeyer broit vet zain far zeyer laib,</para>
  <para style="q" vid="HOS 9:4">es vet nisht kumen in hoiz fun Hashem.<verse eid="HOS 9:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HOS 9:5" />vos vet ir ton in a yom-tov,</para>
  <para style="q" vid="HOS 9:5">un in a faiertog fun Hashem?<verse eid="HOS 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 9:6" />vorem ze, zei zainen avek fun dem broch,</para>
  <para style="q" vid="HOS 9:6">vet Mitsrayim zei ainzamlen,</para>
  <para style="q" vid="HOS 9:6">Memfis vet zei bagrobn;</para>
  <para style="q" vid="HOS 9:6">di shatsn fun zeyer zilber, zei vet shtechgeveks yarshen,</para>
  <para style="q" vid="HOS 9:6">derner veln zain in zeyere getseltn.<verse eid="HOS 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 9:7" />gekumen zainen di teg fun rechnshaft,</para>
  <para style="q" vid="HOS 9:7">gekumen di teg fun batsolung;</para>
  <para style="q" vid="HOS 9:7">gevor vern vet Yisroel.</para>
  <para style="q" vid="HOS 9:7">a nor iz der novi,</para>
  <para style="q" vid="HOS 9:7">meshuge iz der man fun gaist!</para>
  <para style="q" vid="HOS 9:7">fun vegen dain grois zind,</para>
  <para style="q" vid="HOS 9:7">un vail grois iz di faintshaft.<verse eid="HOS 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 9:8" />der vechter fun Efrayim iz mit main G-t,</para>
  <para style="q" vid="HOS 9:8">dem novi shtelt er a pastke oif ale zaine vegen,</para>
  <para style="q" vid="HOS 9:8">faintshaft in hoiz fun zain G-t.<verse eid="HOS 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 9:9" />tif fardorben zainen zei,</para>
  <para style="q" vid="HOS 9:9">azoi vi in di teg fun Givah;</para>
  <para style="q" vid="HOS 9:9">er vet gedenken zeyer farbrech,</para>
  <para style="q" vid="HOS 9:9">er vet rechenen zeyere zind.<verse eid="HOS 9:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="HOS 9:10" />vi vaintroiben in midber hob ich gefunen Yisroel,</para>
  <para style="q" vid="HOS 9:10">vi an ershtfrucht fun faignboim in zain onheib</para>
  <para style="q" vid="HOS 9:10">hob ich gezen aiere eltern;</para>
  <para style="q" vid="HOS 9:10">zainen zei gekumen kein Baal-Peor,</para>
  <para style="q" vid="HOS 9:10">un zich opgesheidt tsum shandgets,</para>
  <para style="q" vid="HOS 9:10">un gevorn umverdik vi dos vos zei hobn lib gekrogn.<verse eid="HOS 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 9:11" />Efrayim – vi a foigel vet zeyer koved avekflien,</para>
  <para style="q" vid="HOS 9:11">ois geburt, un ois muterlaib, un ois trogshaft!<verse eid="HOS 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 9:12" />afile az zei veln oifbrengen zeyere kinder,</para>
  <para style="q" vid="HOS 9:12">vel ich zei baroibn fun zei,</para>
  <para style="q" vid="HOS 9:12">az kein mentsh zol nisht blaibn;</para>
  <para style="q" vid="HOS 9:12">yo, vei oich tsu zei ven ich tu zich op fun zei!<verse eid="HOS 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 9:13" />Efrayim, vi ich hob Tsor gezen,</para>
  <para style="q" vid="HOS 9:13">iz geflantst in a sheinem ort,</para>
  <para style="q" vid="HOS 9:13">ober Efrayim vet aroisfirn</para>
  <para style="q" vid="HOS 9:13">zaine kinder tsum teiter<verse eid="HOS 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 9:14" />gib zei, Hashem, vos du darfst zei gebn!</para>
  <para style="q" vid="HOS 9:14">gib zei a tracht vos farvorft, un brist fardarte!<verse eid="HOS 9:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 9:15" />al dos beiz zeyers iz in Gilgal,</para>
  <para style="q" vid="HOS 9:15">yo, dort hob ich zei faint gekrogn;</para>
  <para style="q" vid="HOS 9:15">far di beize meisim zeyere</para>
  <para style="q" vid="HOS 9:15">vel ich zei fun main hoiz aroistraibn;</para>
  <para style="q" vid="HOS 9:15">ich vel zei mer nisht lib hobn;</para>
  <para style="q" vid="HOS 9:15">ale zeyere harn zainen opkerer.<verse eid="HOS 9:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="HOS 9:16" />geshlogn gevorn iz Efrayim,</para>
  <para style="q" vid="HOS 9:16">zeyer vortsel iz fartriknt,</para>
  <para style="q" vid="HOS 9:16">kein frucht veln zei nisht brengen;</para>
  <para style="q" vid="HOS 9:16">afile az zei veln gebern,</para>
  <para style="q" vid="HOS 9:16">vel ich teitn di glustike fun zeyer laib.<verse eid="HOS 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 9:17" />farachten vet zi main G-t,</para>
  <para style="q" vid="HOS 9:17">vail zei hobn nisht tsugehert tsu im,</para>
  <para style="q" vid="HOS 9:17">un zei veln umvoglen tsvishn di felker.<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" pubnumber="י" sid="HOS 10" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 10:1" />a fruchtbar vainshtok iz Yisroel geven,</para>
  <para style="q" vid="HOS 10:1">zain frucht flegt a verde hobn;</para>
  <para style="q" vid="HOS 10:1">iz, vos merer zain frucht, hot er mizbeyches gemert,</para>
  <para style="q" vid="HOS 10:1">vos shener zain land, hobn zei shenere zailshteiner gemacht.<verse eid="HOS 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 10:2" />zeyer harts iz tseteilt;</para>
  <para style="q" vid="HOS 10:2">atsund veln zei zeyer shuld laidn;</para>
  <para style="q" vid="HOS 10:2">er vet tsebrechn zeyere mizbeyches,</para>
  <para style="q" vid="HOS 10:2">er vet farvistn zeyere zailshteiner.<verse eid="HOS 10:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 10:3" />far vor, atsund veln zei zogn:</para>
  <para style="q" vid="HOS 10:3">nishto kein melech bai undz,</para>
  <para style="q" vid="HOS 10:3">vail mir hobn nisht moire gehat far Hashem;</para>
  <para style="q" vid="HOS 10:3">un der melech, vos ken ton far undz?<verse eid="HOS 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 10:4" />zei redn gereidn,</para>
  <para style="q" vid="HOS 10:4">shvern falsh, shlisn a bris,</para>
  <para style="q" vid="HOS 10:4">ober der mishpot vet shprotsn vi biterkroit</para>
  <para style="q" vid="HOS 10:4">oif di baitn fun feld.<verse eid="HOS 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 10:5" />um di kelber fun Beis-Aven</para>
  <para style="q" vid="HOS 10:5">veln angstn di voiner fun Shomron;</para>
  <para style="q" vid="HOS 10:5">vorem zain folk tut oif im troiern,</para>
  <para style="q" vid="HOS 10:5">un zaine prister veln tsiteren vegen im,</para>
  <para style="q" vid="HOS 10:5">vegen zain koved vos iz avek fun im.<verse eid="HOS 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 10:6" />im oich vet men kein Ashur avekfiren,</para>
  <para style="q" vid="HOS 10:6">a matone tsum melech shtreiter;</para>
  <para style="q" vid="HOS 10:6">shand vet krign Efrayim,</para>
  <para style="q" vid="HOS 10:6">un Yisroel vet zich shemen mit zain barot.<verse eid="HOS 10:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 10:7" />farshnitn vert der melech fun Shomron,</para>
  <para style="q" vid="HOS 10:7">azoi vi tsvaigl oifn vaser.<verse eid="HOS 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 10:8" />un fartilikt vern veln</para>
  <para style="q" vid="HOS 10:8">di bamot fun Aven, di zind fun Yisroel;</para>
  <para style="q" vid="HOS 10:8">derner un vildgeveks veln oifgein oif zeyere mizbeyches</para>
  <para style="q" vid="HOS 10:8">un zei veln zogn tsu di berg: dekt undz tsu!</para>
  <para style="q" vid="HOS 10:8">un tsu di heichn: falt oif undz aroif!<verse eid="HOS 10:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="HOS 10:9" />mer vi in di teg fun Givah</para>
  <para style="q" vid="HOS 10:9">hostu gezindikt, Yisroel;</para>
  <para style="q" vid="HOS 10:9">dort hot men zich akegngeshtelt;</para>
  <para style="q" vid="HOS 10:9">far zei ober vet nisht klekn</para>
  <para style="q" vid="HOS 10:9">a milchome vi in Givah akegn di farbrecher.<verse eid="HOS 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 10:10" />ven ich tu bageren, vel ich zei shtrofn,</para>
  <para style="q" vid="HOS 10:10">un felker veln zich ainzamlen kegen zei,</para>
  <para style="q" vid="HOS 10:10">ven me shpant zei in zeyere tsvei yochringen.<verse eid="HOS 10:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 10:11" />un Efrayim iz a kalb a genits,</para>
  <para style="q" vid="HOS 10:11">tsu dreshn hot es lib;</para>
  <para style="q" vid="HOS 10:11">ober ich bin aribergegangen iber ir fetn haldz:</para>
  <para style="q" vid="HOS 10:11">ich vel ainshpanen Efrayim,</para>
  <para style="q" vid="HOS 10:11">akeren zol Yehudah,</para>
  <para style="q" vid="HOS 10:11">broneven zol Yaakov.<verse eid="HOS 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 10:12" />zait aich far gerechtikeit,</para>
  <para style="q" vid="HOS 10:12">vet ir shnaidn loit genod;</para>
  <para style="q" vid="HOS 10:12">akert aich an aker,</para>
  <para style="q" vid="HOS 10:12">vorem es iz tsait tsu zuchn Hashem,</para>
  <para style="q" vid="HOS 10:12">biz er vet kumen un regenen oif aich gerechtikeit.<verse eid="HOS 10:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="HOS 10:13" />ir hot geakert shlechts,</para>
  <para style="q" vid="HOS 10:13">hot ir umrecht geshnitn,</para>
  <para style="q" vid="HOS 10:13">hot ir gegesn di frucht fun lign;</para>
  <para style="q" vid="HOS 10:13">vorem host zich farzichert oif dain veg,</para>
  <para style="q" vid="HOS 10:13">oif di fil giborim daine.<verse eid="HOS 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 10:14" />derum vet oifshtein a churvn oif daine machnus,</para>
  <para style="q" vid="HOS 10:14">un ale daine festungen veln farvist vern,</para>
  <para style="q" vid="HOS 10:14">vi Shalman hot farvist Beis-Arbel, in tog fun milchome –</para>
  <para style="q" vid="HOS 10:14">muters mit kinder zainen tsehakt gevorn.<verse eid="HOS 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 10:15" />azoi hot geton tsu aich, Beis-El,</para>
  <para style="q" vid="HOS 10:15">fun vegen aier beizer shlechtikeit;</para>
  <para style="q" vid="HOS 10:15">in a frimorgn farshnitn vert farshnitn</para>
  <para style="q" vid="HOS 10:15">der melech fun Yisroel.<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="HOS 11" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 11:1" />az Yisroel iz yung geven hob ich im lib gehat,</para>
  <para style="q" vid="HOS 11:1">un fun Mitsrayim hob ich gerufn main zun.<verse eid="HOS 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 11:2" />vi zei hobn gerufn tsu zei,</para>
  <para style="q" vid="HOS 11:2">azoi zainen zei avek fun zei;</para>
  <para style="q" vid="HOS 11:2">tsu di Baal-geter hobn zei geshlacht,</para>
  <para style="q" vid="HOS 11:2">un tsu di getsn hobn zei gereichert.<verse eid="HOS 11:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 11:3" />un ich hob gelernt gein Efrayim,</para>
  <para style="q" vid="HOS 11:3">zei far zeyere orems genumen,</para>
  <para style="q" vid="HOS 11:3">ober zei hobn nisht gemerkt</para>
  <para style="q" vid="HOS 11:3">az ich hob zei gevalt heiln.<verse eid="HOS 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 11:4" />mit mentshleche shtrik hob ich zei tsugetsoign,</para>
  <para style="q" vid="HOS 11:4">mit shnurn fun libshaft,</para>
  <para style="q" vid="HOS 11:4">un ich bin zei geven</para>
  <para style="q" vid="HOS 11:4">vi di aropnemer fun dem yoch oif zeyere kinbakn:</para>
  <para style="q" vid="HOS 11:4">un esen fleg ich im derlangen.<verse eid="HOS 11:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HOS 11:5" />er vet zich nisht umkeren kein land Mitsrayim,</para>
  <para style="q" vid="HOS 11:5">ober Ashur, er vet zain melech zain,</para>
  <para style="q" vid="HOS 11:5">vail zei hobn nisht gevolt tsurikkern.<verse eid="HOS 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 11:6" />un a shverd vet faln in zaine shtet,</para>
  <para style="q" vid="HOS 11:6">un vet farlendn zaine riglen un fartseren,</para>
  <para style="q" vid="HOS 11:6">fun vegen zeyere barotungen.<verse eid="HOS 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 11:7" />un main folk kvenklt zich umtsukeren tsu mir,</para>
  <para style="q" vid="HOS 11:7">un me ruft im tsu der heich,</para>
  <para style="q" vid="HOS 11:7">ober er tut zich nisht derheibn.<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="HOS 11:8" />vi ken ich dich ibergebn, Efrayim?</para>
  <para style="q" vid="HOS 11:8">dich iberentfern, Yisroel?</para>
  <para style="q" vid="HOS 11:8">vi ken ich dich machn vi Admah?</para>
  <para style="q" vid="HOS 11:8">dich lozn vern vi Tsevoim?</para>
  <para style="q" vid="HOS 11:8">main harts kert zich um in mir,</para>
  <para style="q" vid="HOS 11:8">main gantse rachmones tsindt zich on.<verse eid="HOS 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 11:9" />ich vel nisht oisfirn main grimtsorn,</para>
  <para style="q" vid="HOS 11:9">ich vel mer nisht umbrengen Efrayim;</para>
  <para style="q" vid="HOS 11:9">vorem El bin ich un nisht a mentsh –</para>
  <para style="q" vid="HOS 11:9">der heiliker tsvishn dir –</para>
  <para style="q" vid="HOS 11:9">un ich vel nisht kumen mit tsorn.<verse eid="HOS 11:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="HOS 11:10" />noch Hashem veln zei gein –</para>
  <para style="q" vid="HOS 11:10">azoi vi a leib vet er briln;</para>
  <para style="q" vid="HOS 11:10">yo, er vet briln,</para>
  <para style="q" vid="HOS 11:10">un di kinder veln ailn fun mayrev.<verse eid="HOS 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 11:11" />zei veln ailn vi a foigel, fun Mitsrayim,</para>
  <para style="q" vid="HOS 11:11">un vi a toib, fun land Ashur,</para>
  <para style="q" vid="HOS 11:11">un ich vel zei bazetsn in zeyere haizer,</para>
  <para style="q" vid="HOS 11:11">zogt Hashem.<verse eid="HOS 11:11" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="HOS 12" />
  <para style="q">
    <verse number="1" style="v" pubnumber="11.12" sid="HOS 12:1" /> arumgeringlt mit lign hot mich Efrayim,</para>
  <para style="q" vid="HOS 12:1">un mit batrug dos hoiz fun Yisroel;</para>
  <para style="q" vid="HOS 12:1">un Yehudah hersht noch mit El,</para>
  <para style="q" vid="HOS 12:1">un mit dem heilikn getraien.<verse eid="HOS 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="12.1" sid="HOS 12:2" /> Efrayim loift noch vint, un yogt zich noch mizrech-vint,</para>
  <para style="q" vid="HOS 12:2">a gantsn tog mert er lign un roib;</para>
  <para style="q" vid="HOS 12:2">un a bris mit Ashur shlisn zei,</para>
  <para style="q" vid="HOS 12:2">un eil vert kein Mitsrayim gefirt.<verse eid="HOS 12:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="HOS 12:3" /> ober Hashem hot a krig mit Yehudah,</para>
  <para style="q" vid="HOS 12:3">un vet zich rechenen mit Yaakov loit zaine vegen,</para>
  <para style="q" vid="HOS 12:3">loit zaine meisim vet er im umkeren.<verse eid="HOS 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="HOS 12:4" /> in muterlaib hot er baim trit gechapt zain bruder,</para>
  <para style="q" vid="HOS 12:4">un mit zain koiech hot er zich geranglt mit G-t;<verse eid="HOS 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="HOS 12:5" /> yo, er hot geshtritn kegen a malach un iz baigekumen;</para>
  <para style="q" vid="HOS 12:5">er hot geveint un zich gebetn bai im:</para>
  <para style="q" vid="HOS 12:5">in Beis-El vet er im trefn,</para>
  <para style="q" vid="HOS 12:5">un dortn vet er redn mit im.<verse eid="HOS 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="HOS 12:6" /> un Hashem iz Elokei Tseva'ot,</para>
  <para style="q" vid="HOS 12:6">Hashem iz zain gedechenish.<verse eid="HOS 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="HOS 12:7" /> derum zolst du tsu dain G-t zich umkeren;</para>
  <para style="q" vid="HOS 12:7">frumkeit un gerechtikeit hit op,</para>
  <para style="q" vid="HOS 12:7">un hof tsu dain G-t tamid.<verse eid="HOS 12:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="HOS 12:8" /> Kenaan hot falshe vogsholn in zain hant,</para>
  <para style="q" vid="HOS 12:8">tsu baroibn hot er lib.<verse eid="HOS 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="HOS 12:9" /> un Efrayim zogt: far vor, ich bin raich,</para>
  <para style="q" vid="HOS 12:9">ich hob mir dergreicht a farmeg;</para>
  <para style="q" vid="HOS 12:9">in al main mi vet men bai mir nisht gefinen</para>
  <para style="q" vid="HOS 12:9">an umrecht vos iz a zind.<verse eid="HOS 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="HOS 12:10" /> ober ich bin Hashem dain G-t fun land Mitsrayim on,</para>
  <para style="q" vid="HOS 12:10">ich vel dich vider machn voinen in getseltn,</para>
  <para style="q" vid="HOS 12:10">vi in di teg fun yener tsait.<verse eid="HOS 12:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="HOS 12:11" /> un ich hob geredt tsu di neviim,</para>
  <para style="q" vid="HOS 12:11">un ich hob zeungen gemert,</para>
  <para style="q" vid="HOS 12:11">un durch di neviim fleg ich mashalim gebn.<verse eid="HOS 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="HOS 12:12" /> az Gilad iz nishtikeit,</para>
  <para style="q" vid="HOS 12:12">loiter falshkeit zainen zei gevorn!</para>
  <para style="q" vid="HOS 12:12">in Gilgal hobn zei oksen geshlacht;</para>
  <para style="q" vid="HOS 12:12">yo, zeyere mizbeyches zainen vi hoifns</para>
  <para style="q" vid="HOS 12:12">oif di baitn fun feld.<verse eid="HOS 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="HOS 12:13" /> un Yaakov iz antlofn in feld fun Aram,</para>
  <para style="q" vid="HOS 12:13">un Yisroel hot gedint um a vaib,</para>
  <para style="q" vid="HOS 12:13">un um a vaib hot er shof gehit.<verse eid="HOS 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="HOS 12:14" /> un durch a novi hot Hashem oifgebracht Yisroel fun Mitsrayim,</para>
  <para style="q" vid="HOS 12:14">un durch a novi iz er opgehit gevorn.<verse eid="HOS 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="HOS 12:15" /> biter dertsernt hot Efrayim,</para>
  <para style="q" vid="HOS 12:15">derum vet er oislozen zain blut oif im,</para>
  <para style="q" vid="HOS 12:15">un zain lesterung vet im umkeren zain har.<verse eid="HOS 12:15" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="HOS 13" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 13:1" />az Efrayim hot geredt iz geven a tsiterenish,</para>
  <para style="q" vid="HOS 13:1">der hoib iz er geven in Yisroel;</para>
  <para style="q" vid="HOS 13:1">hot er zich farshuldikt mit Baal, un iz geshtorbn.<verse eid="HOS 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 13:2" />un atsund zindikn zei alts mer,</para>
  <para style="q" vid="HOS 13:2">un hobn zich gemacht a gegosn bild fun zeyer zilber,</para>
  <para style="q" vid="HOS 13:2">getsn loit zeyer seichel,</para>
  <para style="q" vid="HOS 13:2">dos verk fun mainsters ale.</para>
  <para style="q" vid="HOS 13:2">oif zei ken men zogn:</para>
  <para style="q" vid="HOS 13:2">mentshn shechtn zei, kelber kushn zei.<verse eid="HOS 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 13:3" />derum veln zei zain vi a frimorgnvolkn,</para>
  <para style="q" vid="HOS 13:3">un vi der toi vos fargeit in der peire,</para>
  <para style="q" vid="HOS 13:3">vi shprei vos vert avekgeblozn fun dresh-shaier,</para>
  <para style="q" vid="HOS 13:3">un vi roich durchn fentster.<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 13:4" />un ich bin Hashem dain G-t fun land Mitsrayim on,</para>
  <para style="q" vid="HOS 13:4">un kein G-t achuts mir kenst du nisht,</para>
  <para style="q" vid="HOS 13:4">un nishto kein helfer oiser mir.<verse eid="HOS 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 13:5" />ich hob dich derkent in der midber,</para>
  <para style="q" vid="HOS 13:5">in a land fun trikenish.<verse eid="HOS 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 13:6" />vi zei hobn zich gefitert, azoi zainen zei zat gevorn;</para>
  <para style="q" vid="HOS 13:6">zei zainen zat gevorn, un zeyer harts hot zich derhoibn,</para>
  <para style="q" vid="HOS 13:6">derfar hobn zei fargesen on mir.<verse eid="HOS 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 13:7" />derum bin ich tsu zei vi a leib gevorn,</para>
  <para style="q" vid="HOS 13:7">vi a lempert oifn veg vel ich loiern;<verse eid="HOS 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 13:8" />ich vel zei bagegenen vi a berinte fun kinder baroibt,</para>
  <para style="q" vid="HOS 13:8">un ich vel oifraisn dem sheid fun zeyer hartsn,</para>
  <para style="q" vid="HOS 13:8">un vel zei oifesn dortn vi a leibinte;</para>
  <para style="q" vid="HOS 13:8">di chaye fun feld vet zei tseraisn.<verse eid="HOS 13:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="HOS 13:9" />oi, ysrl, du host zich alein fardorben, vail dain hilf iz in mir,</para>
  <para style="q" vid="HOS 13:9">vos du bist kegen mir, kegen dain hilf.<verse eid="HOS 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 13:10" />vu den iz dain melech,</para>
  <para style="q" vid="HOS 13:10">er zol dich helfn in ale daine shtet?</para>
  <para style="q" vid="HOS 13:10">un daine richter, vos du host gezogt:</para>
  <para style="q" vid="HOS 13:10">gib mir a melech un harn?<verse eid="HOS 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 13:11" />ich gib dir a melech in main kaas,</para>
  <para style="q" vid="HOS 13:11">un nem avek in main grimtsorn.<verse eid="HOS 13:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="HOS 13:12" />aingebundn iz di zind fun Efrayim,</para>
  <para style="q" vid="HOS 13:12">bahaltn iz zain chet.<verse eid="HOS 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 13:13" />veyen fun a gevinerin veln kumen oif im;</para>
  <para style="q" vid="HOS 13:13">a nisht klug kind iz er,</para>
  <para style="q" vid="HOS 13:13">vorem es iz tsait, er zol nisht shtein blaibn</para>
  <para style="q" vid="HOS 13:13">in dem geberort fun kinder.<verse eid="HOS 13:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="HOS 13:14" />zol ich fun der hant fun Sheol zei oisleizen?</para>
  <para style="q" vid="HOS 13:14">zol ich fun toit zei oiskoifn?</para>
  <para style="q" vid="HOS 13:14">vu zainen daine mageyfus, toit?</para>
  <para style="q" vid="HOS 13:14">vu dain pest, untererd?</para>
  <para style="q" vid="HOS 13:14">derbaremung zol farborgen zain fun maine oign.<verse eid="HOS 13:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 13:15" />vorem er meg vet zain fruchtbar tsvishn di brider,</para>
  <para style="q" vid="HOS 13:15">doch vet kumen a mizrech-vint,</para>
  <para style="q" vid="HOS 13:15">a shturem fun Hashem fun midber geit oif</para>
  <para style="q" vid="HOS 13:15">un trukn vern vet zain brunem,</para>
  <para style="q" vid="HOS 13:15">un oistrikenen vet zain kval;</para>
  <para style="q" vid="HOS 13:15">er vet tseroibn dem shats fun ale glustike zachn.<verse eid="HOS 13:15" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="HOS 14" />
  <para style="q">
    <verse number="1" style="v" pubnumber="13.16" sid="HOS 14:1" /> farshuldikt iz Shomron,</para>
  <para style="q" vid="HOS 14:1">vorem zi hot vidershpenikt on ir G-t;</para>
  <para style="q" vid="HOS 14:1">durchn shverd veln zei faln,</para>
  <para style="q" vid="HOS 14:1">zeyere kleine kinder veln tsehakt vern,</para>
  <para style="q" vid="HOS 14:1">un zaine trogedike veln oifgeshpoltn vern.<verse eid="HOS 14:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" pubnumber="14.1" sid="HOS 14:2" /> ker zich um, Yisroel, tsu Hashem dain G-t,</para>
  <para style="q" vid="HOS 14:2">vorem host geshtroichlt durch daine zind.<verse eid="HOS 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="HOS 14:3" /> nemt mit aich verter,</para>
  <para style="q" vid="HOS 14:3">un kert aich um tsu Hashem;</para>
  <para style="q" vid="HOS 14:3">zogt tsu im: fargib ale zind,</para>
  <para style="q" vid="HOS 14:3">un nem on dos gute;</para>
  <para style="q" vid="HOS 14:3">un lomir tsoln anshtot oksen mit undzere lipn.<verse eid="HOS 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="HOS 14:4" /> Ashur vet undz nisht helfn,</para>
  <para style="q" vid="HOS 14:4">oif ferd veln mir nisht raitn,</para>
  <para style="q" vid="HOS 14:4">un mir veln mer nisht zogn: Elokeinu,</para>
  <para style="q" vid="HOS 14:4">tsum verk fun undzere hent;</para>
  <para style="q" vid="HOS 14:4">vorem durch dir vert derbaremt der elnder.<verse eid="HOS 14:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="HOS 14:5" /> ich vel heiln zeyer opkerung,</para>
  <para style="q" vid="HOS 14:5">ich vel zei lib hobn hartsik,</para>
  <para style="q" vid="HOS 14:5">vorem main tsorn hot zich opgekert fun im.<verse eid="HOS 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="HOS 14:6" /> ich vel zain vi der toi tsu Yisroel;</para>
  <para style="q" vid="HOS 14:6">er vet blien vi a lilie,</para>
  <para style="q" vid="HOS 14:6">un shlogn zaine vortselen vi der Levanon.<verse eid="HOS 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="HOS 14:7" /> zaine tsvaign veln zich shpreitn,</para>
  <para style="q" vid="HOS 14:7">un zain glants vet zain vi fun eilbertboim,</para>
  <para style="q" vid="HOS 14:7">un a reyech vet er hobn vi der Levanon.<verse eid="HOS 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="HOS 14:8" /> di vos zitsn in zain shotn</para>
  <para style="q" vid="HOS 14:8">veln vider oifbrengen tvue,</para>
  <para style="q" vid="HOS 14:8">un zei veln blien vi a vainshtok;</para>
  <para style="q" vid="HOS 14:8">zain duft vi der vain fun Levanon.<verse eid="HOS 14:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="HOS 14:9" /> Efrayim vet zogn:</para>
  <para style="q" vid="HOS 14:9">vos ker ich zich on mer mit getsnbilder.</para>
  <para style="q" vid="HOS 14:9">ich entfer, un vel im onkukn;</para>
  <para style="q" vid="HOS 14:9">ich bin vi a tsvaighaftiker tsipres;</para>
  <para style="q" vid="HOS 14:9">fun mir vert gekrogn dain frucht.<verse eid="HOS 14:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="HOS 14:10" /> ver klug iz zol dos farshtein,</para>
  <para style="q" vid="HOS 14:10">ver farshtandik zol es merkn,</para>
  <para style="q" vid="HOS 14:10">vorem rechtfartik zainen di vegen fun Hashem,</para>
  <para style="q" vid="HOS 14:10">un di gerechte geyen in zei,</para>
  <para style="q" vid="HOS 14:10">un di farbrecher vern geshtroichlt in zei.<verse eid="HOS 14:10" /></para>
  <chapter eid="HOS 14" />
</usx>