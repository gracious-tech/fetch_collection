<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Tehillim</para>
  <para style="toc2">Tehillim</para>
  <para style="toc1">Tehillim</para>
  <para style="mt1">Tehillim</para>
  <chapter number="1" style="c" pubnumber="א" sid="PSA 1" />
  <para style="ms">ershter sefer</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1" />voil tsu dem mentshn vos iz nisht gegangen</para>
  <para style="q" vid="PSA 1:1">in der eitse fun di reshoim.</para>
  <para style="q" vid="PSA 1:1">un oif dem veg fun di zindike, iz er nisht geshtanen,</para>
  <para style="q" vid="PSA 1:1">un in der zitsung fun di shpeter iz er nisht gezesn.<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />naiert tsu der toyre fun Hashem iz zain bager,</para>
  <para style="q" vid="PSA 1:2">un on zain toyre tracht er tog un nacht.<verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />un er vet zain vi a boim geflantst bai bechn vaser,</para>
  <para style="q" vid="PSA 1:3">vos git zain frucht in zain tsait,</para>
  <para style="q" vid="PSA 1:3">un zain blat vert nisht farvelkt;</para>
  <para style="q" vid="PSA 1:3">un in alts vos er tut vet er baglikn.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4" />nisht azoi zainen di reshoim;</para>
  <para style="q" vid="PSA 1:4">naiert vi der shprei vos a vint faryogt im,<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />derum veln di reshoim nisht bashtein faran mishpot,</para>
  <para style="q" vid="PSA 1:5">un di zindike in der eide fun di tsadikim,<verse eid="PSA 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />vorem Hashem merkt dem veg fun di tsadikim,</para>
  <para style="q" vid="PSA 1:6">un der veg fun di reshoim vet untergein.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="PSA 2" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />far vos rudern di felker,</para>
  <para style="q" vid="PSA 2:1">un di umes tuen brumen umnisht?<verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />di mlochim fun der erd shteln zich oif,</para>
  <para style="q" vid="PSA 2:2">un di firshtn eitsen zich in einem</para>
  <para style="q" vid="PSA 2:2">oif Hashem un oif zain gezalbtn:<verse eid="PSA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />lomir tseraisn zeyere bind,</para>
  <para style="q" vid="PSA 2:3">un aropvarfen fun undz zeyere shtrik.<verse eid="PSA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />der vos zitst in himel lacht,</para>
  <para style="q" vid="PSA 2:4">Adonoi tut shpetn fun zei.<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />dentsmol vet er redn tsu zei in zain kaas,</para>
  <para style="q" vid="PSA 2:5">un in zain grimtsorn vet er zei dershrekn:<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />dos hob ich doch oifgeshtelt main melech</para>
  <para style="q" vid="PSA 2:6">oif Tsiyon main heilikn barg.<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />lomir dertseiln fun der basherung:</para>
  <para style="q" vid="PSA 2:7">Hashem hot mir gezogt:</para>
  <para style="q" vid="PSA 2:7">main zun bistu,</para>
  <para style="q" vid="PSA 2:7">ich hob haint dich geborn.<verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />bet bai mir, un ich vel gebn felker far dain arav,</para>
  <para style="q" vid="PSA 2:8">un far dain eigentum di ekn fun der erd.<verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />vest zei tsebrechn mit an aizerner rut,</para>
  <para style="q" vid="PSA 2:9">vi a tepergefes zei tsepitslen.<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />un atsund, ir mlochim, batracht,</para>
  <para style="q" vid="PSA 2:10">lozt aich lernen, ir richter fun der erd.<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11" />dint Hashem mit moire,</para>
  <para style="q" vid="PSA 2:11">un shoidert in tsiterenish.<verse eid="PSA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12" />kisht dem zun, kedei er zol nisht tserenen,</para>
  <para style="q" vid="PSA 2:12">un ir vet umkumen fun dem veg,</para>
  <para style="q" vid="PSA 2:12">az zain kaas vet zich ontsindn bald;</para>
  <para style="b" vid="PSA 2:12" />
  <para style="q" vid="PSA 2:12">voil iz tsu ale vos shitsn zich in im.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="PSA 3" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 3:1" />a mizmor fun Dovidn, ven er iz antlofn fun zain zun Avshalomen.<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 3:2" /> Hashem, vi fil zainen maine faint!</para>
  <para style="q" vid="PSA 3:2">fil di vos shteyen on oif mir!<verse eid="PSA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 3:3" /> fil zogn oif main zel:</para>
  <para style="q" vid="PSA 3:3">nishto far im kein hilf bai Elokim. Selah.<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 3:4" /> ober du Hashem bist a shild far mir,</para>
  <para style="q" vid="PSA 3:4">main koved un der derheiber fun main kop.<verse eid="PSA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 3:5" /> mit main kol tu ich rufn tsu Hashem,</para>
  <para style="q" vid="PSA 3:5">un er entfert mir fun zain heilikn barg. Selah.<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 3:6" /> ich leig zich un shlof ain,</para>
  <para style="q" vid="PSA 3:6">ich vach oif, vail Hashem lent mich unter.<verse eid="PSA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 3:7" /> ich hob nisht moire far tsentoizntn folk,</para>
  <para style="q" vid="PSA 3:7">vos hobn rund arum zich ongezetst oif mir.<verse eid="PSA 3:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 3:8" /> shtei oif, Hashem, helf mich main G-t,</para>
  <para style="q" vid="PSA 3:8">vorem host geshlogn ale maine faint oif der bak,</para>
  <para style="q" vid="PSA 3:8">di tsein fun di reshoim hostu tsebrochn.<verse eid="PSA 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 3:9" /> bai Hashem iz di hilf;</para>
  <para style="q" vid="PSA 3:9">zol kumen dain broche oif dain folk! Selah.<verse eid="PSA 3:9" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="PSA 4" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 4:1" />far dem gezangmaister, mit struneshpil; a mizmor fun Dovidn.<verse eid="PSA 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 4:2" /> az ich ruf, entfer mir, du G-t fun main gerechter;</para>
  <para style="q" vid="PSA 4:2">in engenish zolstu mir derbreitern;</para>
  <para style="q" vid="PSA 4:2">laitzelik mich, un her tsu main tfile.<verse eid="PSA 4:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 4:3" /> ir mentshnkinder,</para>
  <para style="q" vid="PSA 4:3">biz vanen vet main koved tsu shand zain,</para>
  <para style="q" vid="PSA 4:3">vet ir lib hobn nishtikeit,</para>
  <para style="q" vid="PSA 4:3">vet ir zuchn lign? Selah.<verse eid="PSA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 4:4" /> ober zait visen, az Hashem sheidt op zain frumen,</para>
  <para style="q" vid="PSA 4:4">Hashem vet hern az ich vel rufn tsu im.<verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 4:5" /> tsitert un ir zolt nisht zindikn,</para>
  <para style="q" vid="PSA 4:5">baklert in aier hartsn oif aier geleger,</para>
  <para style="q" vid="PSA 4:5">un vert antshvigen. Selah.<verse eid="PSA 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 4:6" /> shlacht shlachtopfer fun gerechtikeit,</para>
  <para style="q" vid="PSA 4:6">un farzichert aich oif Hashem.<verse eid="PSA 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 4:7" /> fil zogn: ver vet undz vaizn guts?</para>
  <para style="q" vid="PSA 4:7">Hashem, heib dos licht fun dain ponem oif undz.<verse eid="PSA 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 4:8" /> host mir gegebn mer simche in hartsn,</para>
  <para style="q" vid="PSA 4:8">vi beeis zeyer tvue un zeyer vain zainen fil.<verse eid="PSA 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 4:9" /> besholem vi ich leig zich azoi shlof ich ain,</para>
  <para style="q" vid="PSA 4:9">vorem du Hashem machst mich voinen bazunder in zicherkeit.<verse eid="PSA 4:9" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="PSA 5" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 5:1" />far dem gezangmaister oif nchilut; a mizmor fun Dovidn.<verse eid="PSA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 5:2" /> farnem maine verter, Hashem.</para>
  <para style="q" vid="PSA 5:2">merk main ziftsenish.<verse eid="PSA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 5:3" /> horch tsum kol fun main geshrei, main kinig un main G-t,</para>
  <para style="q" vid="PSA 5:3">vorem tsu dir tu ich betn.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 5:4" /> Hashem, frimorgns her tsu main kol,</para>
  <para style="q" vid="PSA 5:4">frimorgns taine ich tsu dir, un kuk ois.<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 5:5" /> vorem nisht an El vos vil umrecht bistu,</para>
  <para style="q" vid="PSA 5:5">bai dir ken nisht vailn kein shlechts.<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 5:6" /> proler kenen nisht shtein far daine oign,</para>
  <para style="q" vid="PSA 5:6">host faint ale tuer fun umrecht.<verse eid="PSA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 5:7" /> brengst unter di vos redn lign;</para>
  <para style="q" vid="PSA 5:7">dem man fun blut un batrug farumverdikt Hashem.<verse eid="PSA 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 5:8" /> ober ich vel kumen</para>
  <para style="q" vid="PSA 5:8">in dain hoiz durch dain grois genod,</para>
  <para style="q" vid="PSA 5:8">ich vel mich bukn in dain heilikn heichl</para>
  <para style="q" vid="PSA 5:8">tsvishn daine forchter.<verse eid="PSA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 5:9" /> Hashem, fir mich in dain gerechtikeit</para>
  <para style="q" vid="PSA 5:9">fun vegen maine loierer,</para>
  <para style="q" vid="PSA 5:9">mach glaich dain veg far mir.<verse eid="PSA 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 5:10" /> vorem nishto in zeyer moil kein richtikeit,</para>
  <para style="q" vid="PSA 5:10">zeyer ingeveid iz an untergang,</para>
  <para style="q" vid="PSA 5:10">an ofener keyver iz zeyer kel;</para>
  <para style="q" vid="PSA 5:10">zeyer tsung machn zei glat.<verse eid="PSA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 5:11" /> farmishpet zei Elokim,</para>
  <para style="q" vid="PSA 5:11">zoln zei faln durch zeyere barotn;</para>
  <para style="q" vid="PSA 5:11">farshtois zei far zeyere fil farbrechn,</para>
  <para style="q" vid="PSA 5:11">vail zei hobn vidershpenikt on dir.<verse eid="PSA 5:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 5:12" /> un ale vos shitsn zich in dir, veln zich freyen,</para>
  <para style="q" vid="PSA 5:12">eibik veln zei zingen, vorem vest zei bashiremen,</para>
  <para style="q" vid="PSA 5:12">un di libhober fun dain nomen</para>
  <para style="q" vid="PSA 5:12">veln zain lustik mit dir.<verse eid="PSA 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 5:13" /> vorem du bentshst dem tsadik, Hashem,</para>
  <para style="q" vid="PSA 5:13">vi a shild mit gutvilikeit ringlstu im arum.<verse eid="PSA 5:13" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="PSA 6" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 6:1" />far dem gezangmaister, mit struneshpil, oif shminit; a mizmor fun Dovidn.<verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 6:2" /> nisht in dain kaas zolstu mich musern, Hashem,</para>
  <para style="q" vid="PSA 6:2">un nisht in dain grimtsorn zolstu mich shtrofn.<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 6:3" /> laitzelik mich, Hashem,</para>
  <para style="q" vid="PSA 6:3">vorem ich ver farshnitn,</para>
  <para style="q" vid="PSA 6:3">heil mich, Hashem,</para>
  <para style="q" vid="PSA 6:3">vorem maine beiner zainen dershrokn,<verse eid="PSA 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 6:4" /> un main zel iz dershrokn zeyer,</para>
  <para style="q" vid="PSA 6:4">un du Hashem, biz vanen?<verse eid="PSA 6:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 6:5" /> ker zich um, Hashem, derleiz main zel,</para>
  <para style="q" vid="PSA 6:5">helf mich fun vegen dain genod.<verse eid="PSA 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 6:6" /> vorem nishto in toit dain dermonung,</para>
  <para style="q" vid="PSA 6:6">in Sheol ver vet dich loibn?<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 6:7" /> ich bin mid fun main ziftsn,</para>
  <para style="q" vid="PSA 6:7">ich bavash ale nacht main geleger,</para>
  <para style="q" vid="PSA 6:7">ich mach tsegein in maine trern main bet.<verse eid="PSA 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 6:8" /> mat gevorn fun kumer iz main oig,</para>
  <para style="q" vid="PSA 6:8">alt gevorn fun vegen ale maine faint.<verse eid="PSA 6:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 6:9" /> kert aich op fun mir, ale tuer fun umrecht,</para>
  <para style="q" vid="PSA 6:9">vorem Hashem hot gehert dem kol fun main gevein.<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 6:10" /> Hashem hot gehert main gebet,</para>
  <para style="q" vid="PSA 6:10">Hashem nemt on main tfile.<verse eid="PSA 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 6:11" /> farshemt un dershrokn zeyer</para>
  <para style="q" vid="PSA 6:11">veln vern ale maine faint;</para>
  <para style="q" vid="PSA 6:11">zei veln optretn farshemt in a rege.<verse eid="PSA 6:11" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="PSA 7" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 7:1" />a shigoen fun Dovidn, vos er hot gezungen tsu Hashem fun vegen Kush dem Binyaminer.<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 7:2" /> Hashem main G-t, in dir hob ich mich geshitst,</para>
  <para style="q" vid="PSA 7:2">helf mich fun ale maine nochyoger, un zai mich matsl,<verse eid="PSA 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 7:3" /> me zol nisht fartsukn vi a leib main zel, tseraisn,</para>
  <para style="q" vid="PSA 7:3">un keiner zol nisht matsl zain.<verse eid="PSA 7:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 7:4" /> Hashem main G-t, oib ich hob azoi vos geton,</para>
  <para style="q" vid="PSA 7:4">oib umrecht iz do in maine hent,<verse eid="PSA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 7:5" /> oib ich hob geton beiz main gutn fraint,</para>
  <para style="q" vid="PSA 7:5">oder baroibt tsu mol main umzistikn faint,<verse eid="PSA 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 7:6" /> zol der soine mich nochyogn un dergreichn,</para>
  <para style="q" vid="PSA 7:6">un tretn tsu der erd main lebn,</para>
  <para style="q" vid="PSA 7:6">un main koved in shtoib leign.</para>
  <para style="q" vid="PSA 7:6">Selah.<verse eid="PSA 7:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 7:7" /> shtei oif, Hashem, in dain kaas,</para>
  <para style="q" vid="PSA 7:7">derheib dich in grimtsorn kegen maine faint,</para>
  <para style="q" vid="PSA 7:7">un dervek far mir dem mishpot vos du host ongezogt.<verse eid="PSA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 7:8" /> un vi di eide fun di felker dich ringlt arum,</para>
  <para style="q" vid="PSA 7:8">ker zich um iber ir tsu der heich.<verse eid="PSA 7:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 7:9" /> Hashem, vos mishpetst di felker,</para>
  <para style="q" vid="PSA 7:9">mishpot mich, Hashem, loit main gerechtikeit</para>
  <para style="q" vid="PSA 7:9">un loit main erlechkeit in mir.<verse eid="PSA 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 7:10" /> zol shoin zich ekn dos beiz fun di reshoim,</para>
  <para style="q" vid="PSA 7:10">un du zolst oifrichtn dem tsadik;</para>
  <para style="q" vid="PSA 7:10">vorem du pruvst di hertser un nirn, Elokim du gerechter.<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 7:11" /> main bashits iz oif Elokim;</para>
  <para style="q" vid="PSA 7:11">er helft di rechtfartikn hertser.<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 7:12" /> Elokim iz a gerechter richter,</para>
  <para style="q" vid="PSA 7:12">un a tserndiker El ale tog.<verse eid="PSA 7:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 7:13" /> far vor, er shlaift nochanand zain shverd,</para>
  <para style="q" vid="PSA 7:13">er shpant zain boign un shtelt im on.<verse eid="PSA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 7:14" /> un er greit zich on getsaig fun toit,</para>
  <para style="q" vid="PSA 7:14">er macht brenedik sharf zaine failn.<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 7:15" /> ze, er antfangt umrecht,</para>
  <para style="q" vid="PSA 7:15">un er trogt umglik, un gebert lign.<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 7:16" /> er grobt a grub un hoilt zi ois,</para>
  <para style="q" vid="PSA 7:16">un falt in dem opgrunt vos er macht,<verse eid="PSA 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 7:17" /> zain umrecht vet zich umkeren oif zain kop,</para>
  <para style="q" vid="PSA 7:17">un oif zain sharbn vet nidern zain farbrech.<verse eid="PSA 7:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 7:18" /> ich vel loibn Hashem loit zain gerechtikeit,</para>
  <para style="q" vid="PSA 7:18">un bazingen dem nomen fun Hashem dem Elyon.<verse eid="PSA 7:18" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="PSA 8" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 8:1" />far dem gezangmaister, oif gitit; a mizmor fun Dovidn.<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 8:2" /> Hashem undzer har,</para>
  <para style="q" vid="PSA 8:2">vi prachtik iz dain nomen oif der gantser erd,</para>
  <para style="q" vid="PSA 8:2">az der loib fun dain glants iz iber di himlen!<verse eid="PSA 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 8:3" /> fun dem moil fun eyfelech un zoigedike</para>
  <para style="q" vid="PSA 8:3">hostu bafestikt dain macht;</para>
  <para style="q" vid="PSA 8:3">fun vegen daine faint –</para>
  <para style="q" vid="PSA 8:3">kedei shtil tsu machn dem soine un rachenemer.<verse eid="PSA 8:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 8:4" /> az ich ze di himlen, dos verk fun daine finger,</para>
  <para style="q" vid="PSA 8:4">di levone un shtern vos du host oifgeshtelt –<verse eid="PSA 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 8:5" /> vos iz a mentsh, az du zolst im gedenken?</para>
  <para style="q" vid="PSA 8:5">un a mentshnkind, az du zolst im dermonen?<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 8:6" /> vorem host im gemacht shir nisht miner fun Elokim,</para>
  <para style="q" vid="PSA 8:6">un mit koved un sheinkeit bakreinstu im.<verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 8:7" /> machst im geveltikn iber di verk fun daine hent,</para>
  <para style="q" vid="PSA 8:7">altsding hostu geleigt unter zaine fis;<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 8:8" /> shof un rinder ale,</para>
  <para style="q" vid="PSA 8:8">un afile chayes fun feld;<verse eid="PSA 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 8:9" /> dem foigel fun himel, un di fishn fun yam –</para>
  <para style="q" vid="PSA 8:9">vos nor es tsit durch di shtegn fun yamen.<verse eid="PSA 8:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 8:10" /> Hashem undzer har,</para>
  <para style="q" vid="PSA 8:10">vi prachtik iz dain nomen oif der gantser erd!<verse eid="PSA 8:10" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="PSA 9" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 9:1" />far dem gezangmaister, oif mut-laben; a mizmor fun Dovidn.<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 9:2" /> ich vel loibn Hashem mit main gantsn hartsn,</para>
  <para style="q" vid="PSA 9:2">ich vel dertseiln ale daine vunder.<verse eid="PSA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 9:3" /> ich vel zich freyen un lustik zain mit dir,</para>
  <para style="q" vid="PSA 9:3">ich vel bazingen dain nomen, du Elyon;<verse eid="PSA 9:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 9:4" /> ven maine faint kern zich ahinter,</para>
  <para style="q" vid="PSA 9:4">vern geshtroichlt un geyen unter far dir,<verse eid="PSA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 9:5" /> vorem host geton main mishpot un main recht,</para>
  <para style="q" vid="PSA 9:5">host zich gezetst oifn tron, du richter gerechter.<verse eid="PSA 9:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 9:6" /> host ongeshrien oif di felker,</para>
  <para style="q" vid="PSA 9:6">host untergebracht dem roshe,</para>
  <para style="q" vid="PSA 9:6">zeyer nomen hostu oisgemekt oif eibik un shtendik.<verse eid="PSA 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 9:7" /> du faint, farlendt zainen di churves oif tamid;</para>
  <para style="q" vid="PSA 9:7">un shtet hostu oisgerisn,</para>
  <para style="q" vid="PSA 9:7">zeyer zocher iz untergegangen,<verse eid="PSA 9:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 9:8" /> ober Hashem vet eibik blaibn,</para>
  <para style="q" vid="PSA 9:8">er shtelt oif tsum mishpot zain tron;<verse eid="PSA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 9:9" /> un er vet mishpetn di velt mit gerechtikeit,</para>
  <para style="q" vid="PSA 9:9">er vet Dan zain di felker mit yoisher.<verse eid="PSA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 9:10" /> un Hashem vet zain a festung dem gedriktn,</para>
  <para style="q" vid="PSA 9:10">a festung in tsaitn fun noit.<verse eid="PSA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 9:11" /> un farzichern veln zich oif dir di vos kenen dain nomen,</para>
  <para style="q" vid="PSA 9:11">vorem du farlozt nisht di vos zuchn dich, Hashem.<verse eid="PSA 9:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 9:12" /> zingt tsu Hashem, bavoiner fun Tsiyon,</para>
  <para style="q" vid="PSA 9:12">dertseilt tsvishn di felker zaine meisim.<verse eid="PSA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 9:13" /> vorem der oifmoner fun blut gedenkt zei,</para>
  <para style="q" vid="PSA 9:13">er fargest nisht dos geshrei fun di farlitene.<verse eid="PSA 9:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 9:14" /> laitzelik mich, Hashem,</para>
  <para style="q" vid="PSA 9:14">ze main pain fun maine faint,</para>
  <para style="q" vid="PSA 9:14">main derheiber fun di toiern fun toit;<verse eid="PSA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 9:15" /> kedei ich zol dertseiln al dain loib,</para>
  <para style="q" vid="PSA 9:15">in di toiern fun tochter Tsiyon mich freyen mit dain hilf.<verse eid="PSA 9:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 9:16" /> aingezunken zainen di felker,</para>
  <para style="q" vid="PSA 9:16">in der grub vos zei hobn gemacht,</para>
  <para style="q" vid="PSA 9:16">in der nets vos zei hobn bahaltn</para>
  <para style="q" vid="PSA 9:16">iz batsvungen zeyer fus.<verse eid="PSA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 9:17" /> Hashem iz bavust gevorn, er hot a mishpot geton –</para>
  <para style="q" vid="PSA 9:17">in dem verk fun zaine hent iz geshtroichlt gevorn der roshe.</para>
  <para style="q" vid="PSA 9:17">Higayon Selah.<verse eid="PSA 9:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 9:18" /> di reshoim veln onkumen in Sheol –</para>
  <para style="q" vid="PSA 9:18">ale felker vos fargesen on Elokim.<verse eid="PSA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 9:19" /> vorem nisht shtendik vet fargesen zain der evyon,</para>
  <para style="q" vid="PSA 9:19">di hofenung fun di orime vet nisht farlorn zain oif eibik.<verse eid="PSA 9:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 9:20" /> shtei oif, Hashem, zol der mentsh nisht farshait zain,</para>
  <para style="q" vid="PSA 9:20">zoln gemishpet vern di felker far dir.<verse eid="PSA 9:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 9:21" /> tu, Hashem, a moire oif zei;</para>
  <para style="q" vid="PSA 9:21">zoln visen di felker az zei zainen nor mentshn.</para>
  <para style="q" vid="PSA 9:21">Selah.<verse eid="PSA 9:21" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" pubnumber="י" sid="PSA 10" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />far vos, Hashem, shteistu fun der vaitn,</para>
  <para style="q" vid="PSA 10:1">farhoilstu zich in tsaitn fun noit?<verse eid="PSA 10:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />mit gaive fun roshe yogt men dem oreman;</para>
  <para style="q" vid="PSA 10:2">zoln zei gechapt vern in di plener vos zei hobn oisgeklert!<verse eid="PSA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />vorem der roshe prolt in der teive fun zain zel,</para>
  <para style="q" vid="PSA 10:3">un der geitsiker rimt zich: er shpot fun Hashem.<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />der roshe zogt in dem shtolts fun zain ponem: me mont nisht;</para>
  <para style="q" vid="PSA 10:4">nishto kein Elokim, zainen ale zaine trachtungen.<verse eid="PSA 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />zaine vegen baglikn tsu yetveder tsait,</para>
  <para style="q" vid="PSA 10:5">vait iber im zainen daine mishpotim;</para>
  <para style="q" vid="PSA 10:5">ale zaine faint – er blozt oif zei.<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />er zogt in zain hartsn: ich vel nisht umfaln,</para>
  <para style="q" vid="PSA 10:6">oif dor-doires nisht zain in kein beiz.<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />mit kloles iz ful zain moil, un mit batrug un drikung,</para>
  <para style="q" vid="PSA 10:7">unter zain tsung iz umrecht un farbrechn.<verse eid="PSA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />er zitst in loier fun di geheftn,</para>
  <para style="q" vid="PSA 10:8">in farborgenishn harget er dem umshuldikn;</para>
  <para style="q" vid="PSA 10:8">zaine oign lakern oifn umgliklechn.<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />er loiert in farborgenish vi a leib in zain tsudek,</para>
  <para style="q" vid="PSA 10:9">er loiert tsu chapn dem oreman;</para>
  <para style="q" vid="PSA 10:9">er chapt dem oreman, az er tsit im in zain nets.<verse eid="PSA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />er drikt zich, er beigt zich,</para>
  <para style="q" vid="PSA 10:10">biz di umglikleche faln in zaine kloien.<verse eid="PSA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />er zogt in zain hartsn: fargesen hot El;</para>
  <para style="q" vid="PSA 10:11">er hot farborgen zain ponem, er vet oif eibik nisht zen.<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />shtei oif Hashem, El, heib oif dain hant,</para>
  <para style="q" vid="PSA 10:12">zolst nisht fargesen di gedrikte.<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />far vos lestert der roshe Elokim,</para>
  <para style="q" vid="PSA 10:13">zogt in zain hartsn: du monst nisht?<verse eid="PSA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />du host gezen; vorem du kukst tsu laid un kumer,</para>
  <para style="q" vid="PSA 10:14">kedei zei tsu fargletn mit dain hant.</para>
  <para style="q" vid="PSA 10:14">oif dir farlozt zich der umgliklecher,</para>
  <para style="q" vid="PSA 10:14">dem elndn bist du geven a helfer.<verse eid="PSA 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />tsebrech dem orem fun dem roshe,</para>
  <para style="q" vid="PSA 10:15">un baim shlechtn zolstu zuchn zain beiz</para>
  <para style="q" vid="PSA 10:15">biz vest mer nisht gefinen.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />Hashem iz a melech eibik un shtendik,</para>
  <para style="q" vid="PSA 10:16">di felker geyen unter fun zain land.<verse eid="PSA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />dos krechtsn fun di farlitene hostu tsugehert, Hashem;</para>
  <para style="q" vid="PSA 10:17">festikst zeyer harts, naigst tsu dain oier;<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />tsu ton recht dem yosem un dem gedriktn;</para>
  <para style="q" vid="PSA 10:18">az kein mentsh fun der erd zol mer nisht shrekn.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="PSA 11" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 11:1" />far dem gezangmaister, fun Dovidn.</para>
  <para style="q" vid="PSA 11:1">
    <char style="va">1</char>in Hashem tu ich mich shitsn;</para>
  <para style="q" vid="PSA 11:1">vi kent ir zogn tsu main zel:</para>
  <para style="q" vid="PSA 11:1">antloif! tsu aier barg, ir foiglen?<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />vorem ze, di reshoim shpanen dem boign,</para>
  <para style="q" vid="PSA 11:2">zei hobn ongeshtelt zeyer fail oifn shtrikl,</para>
  <para style="q" vid="PSA 11:2">tsu shisn in der fintster di rechtfartikn hertser<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />az di gruntzailn vern tseshtert,</para>
  <para style="q" vid="PSA 11:3">vos kenen di tsadikim ton?<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />Hashem iz in zain heilikn heichl,</para>
  <para style="q" vid="PSA 11:4">Hashem – zain tron iz in himel;</para>
  <para style="q" vid="PSA 11:4">zaine oign zeen,</para>
  <para style="q" vid="PSA 11:4">zaine bremen pruvn di mentshnkinder.<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />Hashem pruvet dem tsadik,</para>
  <para style="q" vid="PSA 11:5">ober der roshe un dem vos hot lib roib,</para>
  <para style="q" vid="PSA 11:5">hot faint zain zel.<verse eid="PSA 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />er vet machn regenen oif di reshoim</para>
  <para style="q" vid="PSA 11:6">koiln, faier, un shvebl;</para>
  <para style="q" vid="PSA 11:6">un a brenediker vint</para>
  <para style="q" vid="PSA 11:6">iz zeyer tsugeteilter kos.<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />vorem gerecht iz Hashem, di rechtfartikn veln zen zain ponem.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="PSA 12" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 12:1" />far dem gezangmaister, oif shminit; a mizmor fun Dovidn.<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 12:2" /> helf, Hashem, vorem geendikt hobn zich di frume,</para>
  <para style="q" vid="PSA 12:2">vorem oisgegangen zainen di getraie fun di mentshnkinder.<verse eid="PSA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 12:3" /> falsh redn zei einer mitn andern,</para>
  <para style="q" vid="PSA 12:3">mit a glater lip, mit a tsveyikn hartsn redn zei.<verse eid="PSA 12:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 12:4" /> Hashem zol farshnaidn ale glate lipn,</para>
  <para style="q" vid="PSA 12:4">di tsung vos redt grois!<verse eid="PSA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 12:5" /> di vos zogn: mit undzer tsung zainen mir shtark,</para>
  <para style="q" vid="PSA 12:5">undzere lipn zainen mit undz, ver iz undz a har?<verse eid="PSA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 12:6" /> fun vegen der baroibung fun di orime,</para>
  <para style="q" vid="PSA 12:6">fun vegen dem krechtsn fun di baderftike,</para>
  <para style="q" vid="PSA 12:6">atsund vel ich oifshtein, zogt Hashem;</para>
  <para style="q" vid="PSA 12:6">ich vel bashern mit hilf dem vos me blozt oif im.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 12:7" /> di verter fun Hashem zainen reine verter,</para>
  <para style="q" vid="PSA 12:7">zilber geshmoltsn in a tigl oif der erd,</para>
  <para style="q" vid="PSA 12:7">zibn mol gelaitert.<verse eid="PSA 12:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 12:8" /> du Hashem vest zei hitn,</para>
  <para style="q" vid="PSA 12:8">vest zei eibik bahitn fun dozikn dor.<verse eid="PSA 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 12:9" /> umetum geyen um di reshoim,</para>
  <para style="q" vid="PSA 12:9">ven gemeinkeit vert derhoibn bai di mentshnkinder.<verse eid="PSA 12:9" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="PSA 13" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 13:1" />far dem gezangmaister; a mizmor fun Dovidn.<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 13:2" /> biz vanen, Hashem, vestu mich tamid fargesen?</para>
  <para style="q" vid="PSA 13:2">biz vanen vestu farborgen dain ponem fun mir?<verse eid="PSA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 13:3" /> biz vanen vel ich haltn etsut bai zich,</para>
  <para style="q" vid="PSA 13:3">mit kumer in main hartsn durchn tog?</para>
  <para style="q" vid="PSA 13:3">biz vanen vet main faint zich derheibn oif mir?<verse eid="PSA 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 13:4" /> kuk-tsu, entfer mir, Hashem main G-t,</para>
  <para style="q" vid="PSA 13:4">derlaicht maine oign, ich zol nisht ainshlofn tsum toit;<verse eid="PSA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 13:5" /> main faint zol nisht zogn:</para>
  <para style="q" vid="PSA 13:5">ich bin im baigekumen;</para>
  <para style="q" vid="PSA 13:5">maine sonem zoln zich nisht freyen,</para>
  <para style="q" vid="PSA 13:5">az ich vel umfaln.<verse eid="PSA 13:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 13:6" /> ober ich farzicher mich oif dain chesed;</para>
  <para style="q" vid="PSA 13:6">main harts vet zich freyen mit dain hilf;</para>
  <para style="q" vid="PSA 13:6">
    <char style="va">6</char> ich vel zingen tsu Hashem,</para>
  <para style="q" vid="PSA 13:6">vos er hot mir guts geton.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="PSA 14" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 14:1" />far dem gezangmaister; fun Dovidn.</para>
  <para style="q" vid="PSA 14:1">
    <char style="va">1</char>der nor zogt in zain hartsn: nishto kein Elokim!</para>
  <para style="q" vid="PSA 14:1">fardorben zainen zei, umverdik bageyen zei zich,</para>
  <para style="q" vid="PSA 14:1">keiner tut nisht kein guts.<verse eid="PSA 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />Hashem hot fun himel gelugt oif di mentshnkinder,</para>
  <para style="q" vid="PSA 14:2">tsu zen oib faran a farshtandiker vos zucht Elokim.<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />itlecher iz opgekert, ale zainen zei fardorben,</para>
  <para style="q" vid="PSA 14:3">keiner tut nisht kein guts, nisht tsu mol einer.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />far vor, dershpirn veln ale tuer fun umrecht,</para>
  <para style="q" vid="PSA 14:4">di vos esen main folk vi me est broit,</para>
  <para style="q" vid="PSA 14:4">di vos rufn nisht Hashem.<verse eid="PSA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />on angstn zei in angst,</para>
  <para style="q" vid="PSA 14:5">vorem Elokim iz mit dem gerechtn dor.<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />di trachtung fun oreman macht ir tsu shand,</para>
  <para style="q" vid="PSA 14:6">ober Hashem iz zain bashitsung.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />ven kumt fun Tsiyon di yeshue fun Yisroel!</para>
  <para style="q" vid="PSA 14:7">ven Hashem kert um di gefangenshaft fun zain folk,</para>
  <para style="q" vid="PSA 14:7">vet lustik zain Yaakov, vet zich freyen Yisroel.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="PSA 15" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 15:1" />a mizmor fun Dovidn.</para>
  <para style="q" vid="PSA 15:1">
    <char style="va">1</char> Hashem, ver ken voinen in dain getselt?</para>
  <para style="q" vid="PSA 15:1">ver ken ruen oif dain heilikn barg?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />der vos geit erlech un tut gerechtikeit,</para>
  <para style="q" vid="PSA 15:2">un redt emes in zain hartsn;<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />nisht getrogn kein rechiles oif zain tsung,</para>
  <para style="q" vid="PSA 15:3">nisht geton zain chever kein roeh,</para>
  <para style="q" vid="PSA 15:3">un nisht trogn kein shand oif zain nontn;<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />der nivze iz faracht in zaine oign,</para>
  <para style="q" vid="PSA 15:4">un di yirei Hashem git er koved;</para>
  <para style="q" vid="PSA 15:4">er hot geshvorn zich tsum beizn, un endert nisht;<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />zain gelt hot er nisht gegebn oif tsindzn,</para>
  <para style="q" vid="PSA 15:5">un shochad kegen an umshuldikn nisht genumen;</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q" vid="PSA 15:5">der vos tut dos vet kein mol nisht umfaln.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="PSA 16" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 16:1" />a miktam fun Dovidn.</para>
  <para style="q" vid="PSA 16:1">
    <char style="va">1</char> bahit mich, El,</para>
  <para style="q" vid="PSA 16:1">vorem ich hob mich bashitst in dir.<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />host gezogt tsu Hashem: Adonoi bistu,</para>
  <para style="q" vid="PSA 16:2">main guts iz bloiz bai dir.<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />di heilike vos zainen oif der erd,</para>
  <para style="q" vid="PSA 16:3">zei zainen di firshtn vos al main bager iz tsu zei.<verse eid="PSA 16:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />zoln mern zeyere getsn di vos ailn tsu an andern;</para>
  <para style="q" vid="PSA 16:4">ich vel nisht gisn zeyere gisopfer fun blut,</para>
  <para style="q" vid="PSA 16:4">un nisht nemen zeyere nemen oif maine lipn.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />Hashem iz main basherter teil un main becher;</para>
  <para style="q" vid="PSA 16:5">du haltst oif main goirl.<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />chalokim zainen mir tsugefaln libleche,</para>
  <para style="q" vid="PSA 16:6">yo, a sheine nachle iz mir ongekumen.<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />ich loib Hashem, vos er hot mir gerotn,</para>
  <para style="q" vid="PSA 16:7">yo, in di necht hobn mich maine nirn gelernt.<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />ich halt Hashem far mir tamid,</para>
  <para style="q" vid="PSA 16:8">vorem az er iz bai main rechter hant, vel ich nisht umfaln.<verse eid="PSA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />derum iz freilech main harts, un lustik main zel,</para>
  <para style="q" vid="PSA 16:9">oich main laib rut in zicherkeit.<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />vorem du vest nisht iberlozen main nefesh in des Sheol,</para>
  <para style="q" vid="PSA 16:10">du vest nisht lozn dain chosid</para>
  <para style="q" vid="PSA 16:10">zen di fardorbenkeit.<verse eid="PSA 16:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />vest mich machn visen dem veg fun lebn;</para>
  <para style="q" vid="PSA 16:11">a zetikeit fun freidn iz far dain ponem,</para>
  <para style="q" vid="PSA 16:11">tenugim in dain rechter hant eibik.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="PSA 17" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 17:1" />a tfile fun Dovidn.</para>
  <para style="q" vid="PSA 17:1">
    <char style="va">1</char> her tsu, Hashem, gerechtikeit,</para>
  <para style="q" vid="PSA 17:1">horch tsu main geshrei,</para>
  <para style="q" vid="PSA 17:1">farnem main tfile fun lipn on falshkeit.<verse eid="PSA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />fun far dir zol main mishpot aroisgein,</para>
  <para style="q" vid="PSA 17:2">daine oign zoln zen di richtikeit.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />host gepruvet main harts,</para>
  <para style="q" vid="PSA 17:3">host nochgezucht bai nacht,</para>
  <para style="q" vid="PSA 17:3">host mich gelaitert, un nisht gefunen</para>
  <para style="q" vid="PSA 17:3">ich zol trachtn vos darf nisht ariber main moil.<verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />in meisim fun mentshn,</para>
  <para style="q" vid="PSA 17:4">hob ich, loitn vort fun daine lipn,</para>
  <para style="q" vid="PSA 17:4">mich gehit fun di vegen fun dem farshaitn.<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />maine trit hobn zich gehaltn on daine shtegn,</para>
  <para style="q" vid="PSA 17:5">nisht oisgeglitsht hobn zich maine fis.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />ich hob dich gerufn, vorem du vest mir entfern, El;</para>
  <para style="q" vid="PSA 17:6">naig dain oier tsu mir, her tsu main vort.<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />mach vunderlech daine chasadim,</para>
  <para style="q" vid="PSA 17:7">du vos helfst di vos shitsn zich</para>
  <para style="q" vid="PSA 17:7">fun onfaler in dain rechter hant.<verse eid="PSA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />hit mich vi a shvartsapl fun oig,</para>
  <para style="q" vid="PSA 17:8">in shotn fun daine fliglen zolstu mich farborgen<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />fun di reshoim vos baroibn mich,</para>
  <para style="q" vid="PSA 17:9">maine sonem um lebn vos ringlen mich arum.<verse eid="PSA 17:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />zeyer fet harts hobn zei farshlosn,</para>
  <para style="q" vid="PSA 17:10">mit zeyer moil redn zei hoferdik.<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />oif undzer trit hobn zei atsund undz arumgeringlt,</para>
  <para style="q" vid="PSA 17:11">zeyere oign shteln zei on undz tsu naign tsu der erd.<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />er iz geglichn tsu a leib vos glust tsu fartsukn,</para>
  <para style="q" vid="PSA 17:12">un tsu a yungleib vos zitst in farborgenishn.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />shtei oif, Hashem, gei im akegn, vorf im anider,</para>
  <para style="q" vid="PSA 17:13">mach antrinen main zel fun dem roshe mit dain shverd,<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />fun mentshn, Hashem, mit dain hant –</para>
  <para style="q" vid="PSA 17:14">fun mentshn fun der velt, vos zeyer chelek iz baim lebn,</para>
  <para style="q" vid="PSA 17:14">un mit dain shats filstu on zeyer boich;</para>
  <para style="q" vid="PSA 17:14">zat zainen zeyere kinder,</para>
  <para style="q" vid="PSA 17:14">un zei lozn zeyer shefe tsu zeyere yunge.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />ich ober vel zen dain ponem in gerechtikeit,</para>
  <para style="q" vid="PSA 17:15">ich vel mich zetn oifn vachn in dain geshtalt.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="PSA 18" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 18:1" />far dem gezangmaister; fun dem knecht fun Hashem, fun Dovidn, vos hot geredt tsu Hashem di verter fun dem dozikn gezang in dem tog vos Hashem hot im matsl geven fun der hant fun ale zaine faint, un fun der macht fun Shauln. <verse eid="PSA 18:1" /><verse number="2" style="v" sid="PSA 18:2" />un er hot gezogt:</para>
  <para style="q" vid="PSA 18:2">
    <char style="va">1</char> ich hob dich lib, Hashem main shtarkeit;<verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 18:3" /> Hashem iz main feldz un main festung,</para>
  <para style="q" vid="PSA 18:3">un der vos macht mich antrinen.</para>
  <para style="q" vid="PSA 18:3">main El iz main feldz vos ich shits mich in im,</para>
  <para style="q" vid="PSA 18:3">main shild un der horn fun main hilf, main turem.<verse eid="PSA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 18:4" /> ich ruf: Baruch Hashem!</para>
  <para style="q" vid="PSA 18:4">un fun maine faint ver ich geholfn.<verse eid="PSA 18:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 18:5" /> arumgeringlt hobn mich shtrik fun Sheol,</para>
  <para style="q" vid="PSA 18:5">un taichn fun untergang hobn mich geshrokn.<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 18:6" /> shtrik fun untererd hobn mich arumgeknipt,</para>
  <para style="q" vid="PSA 18:6">akegngekumen zainen mir netsn fun toit.<verse eid="PSA 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 18:7" /> hob ich in main noit gerufn tsu Hashem,</para>
  <para style="q" vid="PSA 18:7">un tsu main G-t hob ich geshrien;</para>
  <para style="q" vid="PSA 18:7">hot er gehert fun zain heichl main kol,</para>
  <para style="q" vid="PSA 18:7">un main geshrei far im iz gekumen in zaine oiern.<verse eid="PSA 18:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 18:8" /> un geshoklt un gevaklt hot zich di erd,</para>
  <para style="q" vid="PSA 18:8">un di gruntfestn fun di berg hobn getsitert;</para>
  <para style="q" vid="PSA 18:8">zich geshoklt, vail er hot getsernt.<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 18:9" /> a roich iz oifgegangen in zain noz,</para>
  <para style="q" vid="PSA 18:9">un fun zain moil hot a faier fartsert;</para>
  <para style="q" vid="PSA 18:9">koiln hobn gebrent fun im.<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 18:10" /> un er hot geneigt dem himel un genidert,</para>
  <para style="q" vid="PSA 18:10">mit a nebl unter zaine fis.<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 18:11" /> un er iz geritn oif a kruv un gefloign,</para>
  <para style="q" vid="PSA 18:11">un geshvebt oif fliglen fun vint.<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 18:12" /> er hot gemacht fintsternish zain baheltenish,</para>
  <para style="q" vid="PSA 18:12">zain baidl arum im –</para>
  <para style="q" vid="PSA 18:12">a choishech fun vasern, volkens gedichte.<verse eid="PSA 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 18:13" /> fun dem shimer far im zainen zaine volkens tsegangen</para>
  <para style="q" vid="PSA 18:13">in hogel un faierkoiln.<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 18:14" /> un gedunert in himel hot Hashem,</para>
  <para style="q" vid="PSA 18:14">un der Elyon hot aroisgelozt zain kol,</para>
  <para style="q" vid="PSA 18:14">mit hogel un faierkoiln.<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 18:15" /> un er hot aroisgeshikt zaine failn un zei tseshpreit,</para>
  <para style="q" vid="PSA 18:15">un blitsn geshosn, un zei fartumlt.<verse eid="PSA 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 18:16" /> un di grobns fun vasern hobn zich bavizn,</para>
  <para style="q" vid="PSA 18:16">un di gruntfestn fun der velt zainen antplekt gevorn,</para>
  <para style="q" vid="PSA 18:16">fun dain ongeshrei, Hashem,</para>
  <para style="q" vid="PSA 18:16">fun dem otembloz fun dain noz.<verse eid="PSA 18:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 18:17" /> er hot oisgeshtrekt fun der heich un mich genumen,</para>
  <para style="q" vid="PSA 18:17">mich aroisgetsoign fun vasern groise.<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 18:18" /> er hot mich matsl geven fun main machtikn faint,</para>
  <para style="q" vid="PSA 18:18">un fun maine sonem,</para>
  <para style="q" vid="PSA 18:18">ven zei zainen geven shtarker fun mir.<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 18:19" /> zei zainen mir akegngekumen in tog fun main broch,</para>
  <para style="q" vid="PSA 18:19">ober Hashem iz mir tsum onlen geven.<verse eid="PSA 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 18:20" /> un er hot mich aroisgefirt in derbreiternish,</para>
  <para style="q" vid="PSA 18:20">mich aroisgetsoign, vail er hot mich bagert.<verse eid="PSA 18:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 18:21" /> Hashem hot mir fargoltn loit main gerechtikeit,</para>
  <para style="q" vid="PSA 18:21">loit der reinkeit fun maine hent hot er mir umgekert.<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 18:22" /> vorem ich hob gehit di vegen fun Hashem,</para>
  <para style="q" vid="PSA 18:22">un nisht farbrochn akegn main G-t.<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 18:23" /> vorem ale zaine gezetsn zainen far mir,</para>
  <para style="q" vid="PSA 18:23">un zaine chukkim tu ich nisht op fun mir.<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 18:24" /> un ich bin geven tsu im gants,</para>
  <para style="q" vid="PSA 18:24">un hob mich gehit fun main zindikeit.<verse eid="PSA 18:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 18:25" /> derum hot mir Hashem umgekert loit main gerechtikeit,</para>
  <para style="q" vid="PSA 18:25">loit der reinkeit fun maine hent far zaine oign.<verse eid="PSA 18:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 18:26" /> mit dem genodikn vaiztu zich genodik,</para>
  <para style="q" vid="PSA 18:26">mit dem erlechn man vaiztu zich erlech.<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 18:27" /> mit dem reinem vaiztu zich rein,</para>
  <para style="q" vid="PSA 18:27">un mit dem krumen vaiztu zich fardreit.<verse eid="PSA 18:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 18:28" /> vorem dos orime folk tustu helfn,</para>
  <para style="q" vid="PSA 18:28">un hoiche oign derniderstu.<verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 18:29" /> vorem du machst laichtn main licht;</para>
  <para style="q" vid="PSA 18:29">Hashem main G-t bashaint main fintsternish.<verse eid="PSA 18:29" /></para>
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 18:30" /> vorem mit dir loif ich kegen a machne,</para>
  <para style="q" vid="PSA 18:30">un mit main G-t shpring ich a moier ariber.<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 18:31" /> HaEl – zain veg iz gants;</para>
  <para style="q" vid="PSA 18:31">dos vort fun Hashem iz gelaitert;</para>
  <para style="q" vid="PSA 18:31">er iz a shild far ale vos shitsn zich in im.<verse eid="PSA 18:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 18:32" /> vorem ver iz Eloah oiser Hashem?</para>
  <para style="q" vid="PSA 18:32">un ver a feldz achuts Elokeinu?<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" altnumber="32" sid="PSA 18:33" /> HaEl vos bagurt mich mit shtarkeit,</para>
  <para style="q" vid="PSA 18:33">un macht glaich main veg.<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" altnumber="33" sid="PSA 18:34" /> er macht maine fis glaich vi di hindn,</para>
  <para style="q" vid="PSA 18:34">un oif maine heichn tut er mich shteln.<verse eid="PSA 18:34" /></para>
  <para style="q">
    <verse number="35" style="v" altnumber="34" sid="PSA 18:35" /> er lernt maine hent tsu milchome,</para>
  <para style="q" vid="PSA 18:35">un a kupernem boign beigen arop maine orems.<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" altnumber="35" sid="PSA 18:36" /> un host mir gegebn dem shild fun dain hilf,</para>
  <para style="q" vid="PSA 18:36">un dain rechte hant lent mich unter,</para>
  <para style="q" vid="PSA 18:36">un dain mildkeit tut mich greisn.<verse eid="PSA 18:36" /></para>
  <para style="q">
    <verse number="37" style="v" altnumber="36" sid="PSA 18:37" /> host derbreitert main trit unter mir,</para>
  <para style="q" vid="PSA 18:37">un nisht oisgeglitsht hobn zich maine knechlech.<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" altnumber="37" sid="PSA 18:38" /> ich hob geyogt maine faint un zei dergreicht,</para>
  <para style="q" vid="PSA 18:38">un zich nisht umgekert biz ich hob zei farlendt.<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" altnumber="38" sid="PSA 18:39" /> ich hob zei tsehakt, az zei kenen nisht oifshtein;</para>
  <para style="q" vid="PSA 18:39">zei zainen gefaln unter maine fis.<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" altnumber="39" sid="PSA 18:40" /> un host mich bagurt mit shtarkeit far milchome,</para>
  <para style="q" vid="PSA 18:40">host gebeigt maine kegnshteyer unter mir.<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" altnumber="40" sid="PSA 18:41" /> un maine faint hostu gemacht mitn nakn tsu mir,</para>
  <para style="q" vid="PSA 18:41">un maine sonem, zei hob ich farshnitn.<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" altnumber="41" sid="PSA 18:42" /> zei hobn geshrien, un kein helfer iz nisht geven,</para>
  <para style="q" vid="PSA 18:42">tsu Hashem – un er hot zei nisht geentfert.<verse eid="PSA 18:42" /></para>
  <para style="q">
    <verse number="43" style="v" altnumber="42" sid="PSA 18:43" /> un ich hob zei tseribn vi shtoib faran vint,</para>
  <para style="q" vid="PSA 18:43">vi gasnkoit zei aroisgevorfn.<verse eid="PSA 18:43" /></para>
  <para style="b" />
  <para style="q">
    <verse number="44" style="v" altnumber="43" sid="PSA 18:44" /> host mich gemacht antrinen fun di krig fun folk,</para>
  <para style="q" vid="PSA 18:44">host mich gemacht far dem kop fun di umes;</para>
  <para style="q" vid="PSA 18:44">a folk vos ich ken nisht tut mir dinen,<verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" altnumber="44" sid="PSA 18:45" /> fun hern mitn oier gehorchn zei mir;</para>
  <para style="q" vid="PSA 18:45">di kinder fun fremdn geyen ain far mir.<verse eid="PSA 18:45" /></para>
  <para style="q">
    <verse number="46" style="v" altnumber="45" sid="PSA 18:46" />di kinder fun dem fremdn vern farvelkt,</para>
  <para style="q" vid="PSA 18:46">un zei kumen tsiterendik arois fun zeyere festungen.<verse eid="PSA 18:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" altnumber="46" sid="PSA 18:47" />es lebt Hashem, un geloibt iz main feldz,</para>
  <para style="q" vid="PSA 18:47">un derhoibn iz der Elokim fun main hilf;<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" altnumber="47" sid="PSA 18:48" /> HaEl vos git mir nkmut</para>
  <para style="q" vid="PSA 18:48">un untertenikt di umes unter mir.<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" altnumber="48" sid="PSA 18:49" /> er macht mich antrinen fun maine faint;</para>
  <para style="q" vid="PSA 18:49">yo, iber maine kegnshteyer derheibstu mich,</para>
  <para style="q" vid="PSA 18:49">fun dem roibmentshn bistu mich matsl.<verse eid="PSA 18:49" /></para>
  <para style="q">
    <verse number="50" style="v" altnumber="49" sid="PSA 18:50" /> derum loib ich dich, Hashem, tsvishn di felker,</para>
  <para style="q" vid="PSA 18:50">un tsu dain nomen tu ich zingen.<verse eid="PSA 18:50" /></para>
  <para style="q">
    <verse number="51" style="v" altnumber="50" sid="PSA 18:51" /> er greist di yeshues fun zain melech,</para>
  <para style="q" vid="PSA 18:51">un er tut chesed mit zain gezalbtn,</para>
  <para style="q" vid="PSA 18:51">mit Dovidn un mit zain zomen biz eibik.<verse eid="PSA 18:51" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="PSA 19" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 19:1" />far dem gezangmaister; a mizmor fun Dovidn.<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 19:2" /> di himlen dertseiln dem koved fun El,</para>
  <para style="q" vid="PSA 19:2">un di verk fun zaine hent zogt der himlvelb on.<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 19:3" /> a tog tsu a tog redt a vort,</para>
  <para style="q" vid="PSA 19:3">un a nacht tsu a nacht git tsu visen,<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 19:4" /> nishto a vort un nishto kein gesheenishn,</para>
  <para style="q" vid="PSA 19:4">vu zeyer vider-kol vert nisht gehert;<verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 19:5" /> iber der gantser erd geit arois zeyer klang,</para>
  <para style="q" vid="PSA 19:5">un biz ek velt zeyere reid.</para>
  <para style="q" vid="PSA 19:5">far der zun hot er gemacht a getselt in zei;<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 19:6" /> un er geit arois vi a chosen fun zain kamer.</para>
  <para style="q" vid="PSA 19:6">er freit zich vi a gibor tsu loifn dem veg.<verse eid="PSA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 19:7" /> fun ek fun di himlen iz zain oisgang,</para>
  <para style="q" vid="PSA 19:7">un zain arumdrei iz biz zeyere ekn,</para>
  <para style="q" vid="PSA 19:7">un nishto kein farborgns fun zain hits.<verse eid="PSA 19:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 19:8" /> di toyre fun Hashem iz gants,</para>
  <para style="q" vid="PSA 19:8">zi bakert di neshome;</para>
  <para style="q" vid="PSA 19:8">der tseignim fun Hashem iz zicher,</para>
  <para style="q" vid="PSA 19:8">er macht klug dem narn.<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 19:9" /> di bafeln fun Hashem zainen rechtfartik,</para>
  <para style="q" vid="PSA 19:9">zei derfreyen dos harts;</para>
  <para style="q" vid="PSA 19:9">dos gebot fun Hashem iz loiter,</para>
  <para style="q" vid="PSA 19:9">es macht lichtik di oign.<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 19:10" /> di moire far Hashem iz rein,</para>
  <para style="q" vid="PSA 19:10">zi bashteit oif eibik;</para>
  <para style="q" vid="PSA 19:10">di mishpotim fun Hashem zainen emes,</para>
  <para style="q" vid="PSA 19:10">zei zainen ale gerecht;<verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 19:11" /> zei zainen glustiker fun gold,</para>
  <para style="q" vid="PSA 19:11">un fun gingold a sach,</para>
  <para style="q" vid="PSA 19:11">un ziser fun honik, un trifhonik.<verse eid="PSA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 19:12" /> oich dain knecht vert gevornt in zei;</para>
  <para style="q" vid="PSA 19:12">in hitn zei iz grois Sachar faran.<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 19:13" /> farzeen ver ken merkn?</para>
  <para style="q" vid="PSA 19:13">fun farborgene tu mich reiniken.<verse eid="PSA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 19:14" /> oich farmaid dain knecht fun mutvilike,</para>
  <para style="q" vid="PSA 19:14">zei zoln nisht geveltikn iber mir;</para>
  <para style="q" vid="PSA 19:14">dentsmol vel ich gants zain,</para>
  <para style="q" vid="PSA 19:14">un vel rein zain fun farbrech a sach.<verse eid="PSA 19:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 19:15" /> zoln zain tsu bavilikung di verter fun main moil,</para>
  <para style="q" vid="PSA 19:15">un di trachtung fun main hartsn far dir,</para>
  <para style="q" vid="PSA 19:15">Hashem main feldz, un main derleizer.<verse eid="PSA 19:15" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="PSA 20" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 20:1" />far dem gezangmaister; a mizmor fun Dovidn.<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 20:2" /> Hashem vet dir entfern in tog fun noit,</para>
  <para style="q" vid="PSA 20:2">dich vet shtarkn der nomen fun Elokei Yaakov.<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 20:3" /> er vet shikn dain hilf fun heiliktum,</para>
  <para style="q" vid="PSA 20:3">un fun Tsiyon vet er dich unterlenen.<verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 20:4" /> er vet achten oif ale daine shpaizopfer,</para>
  <para style="q" vid="PSA 20:4">un dos fets fun dain brandopfer vet er onnemen.</para>
  <para style="q" vid="PSA 20:4">Selah.<verse eid="PSA 20:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 20:5" /> er vet dir gebn loit dain hartsn,</para>
  <para style="q" vid="PSA 20:5">un dain yetveder barot vet er derfiln.<verse eid="PSA 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 20:6" /> mir veln zingen in dain yeshue,</para>
  <para style="q" vid="PSA 20:6">un in nomen fun Elokeinu veln mir a fon heibn;</para>
  <para style="q" vid="PSA 20:6">Hashem vet derfiln ale daine farlangen.<verse eid="PSA 20:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 20:7" /> atsund veis ich az Hashem helft zain gezalbtn,</para>
  <para style="q" vid="PSA 20:7">er vet im entfern fun zain heilikn himel,</para>
  <para style="q" vid="PSA 20:7">mit di bahilfike gevuros fun zain rechter hant.<verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 20:8" /> di mit raitvegn, un di mit ferd,</para>
  <para style="q" vid="PSA 20:8">ober mir veln dermonen dem nomen fun Hashem Elokeinu.<verse eid="PSA 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 20:9" /> zei beigen zich un faln,</para>
  <para style="q" vid="PSA 20:9">un mir heibn zich un shteln zich vider.<verse eid="PSA 20:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 20:10" /> helf du, Hashem!</para>
  <para style="q" vid="PSA 20:10">zol der kinig undz entfern in tog vos mir rufn.<verse eid="PSA 20:10" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="PSA 21" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 21:1" />far dem gezangmaister; a mizmor fun Dovidn.<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 21:2" /> Hashem, mit dain shtarkeit freit zich der melech,</para>
  <para style="q" vid="PSA 21:2">un mit dain hilf vi zeyer lustik iz er!<verse eid="PSA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 21:3" /> dem bager fun zain hartsn hostu im gegebn,</para>
  <para style="q" vid="PSA 21:3">un dem farlang fun zaine lipn hostu nisht farmitn.</para>
  <para style="q" vid="PSA 21:3">Selah.<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 21:4" /> vorem du trogst im antkegen broches fun guts,</para>
  <para style="q" vid="PSA 21:4">tust on oif zain kop fun gingold a kroin.<verse eid="PSA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 21:5" /> lebn hot er gebetn bai dir, hostu im gegebn;</para>
  <para style="q" vid="PSA 21:5">aricht-yamim oif eibik un shtendik.<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 21:6" /> grois iz zain koved durch dain hilf,</para>
  <para style="q" vid="PSA 21:6">glants un sheinkeit tustu oif im aroif.<verse eid="PSA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 21:7" /> vorem du machst im far a bentshung oif eibik,</para>
  <para style="q" vid="PSA 21:7">derfreist im mit simche far dain ponem.<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 21:8" /> vorem der melech farzichert zich oif Hashem,</para>
  <para style="q" vid="PSA 21:8">un durch dem chesed fun Elyon vet er nisht umfaln.<verse eid="PSA 21:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 21:9" /> dain hant vet dergreichn ale daine faint,</para>
  <para style="q" vid="PSA 21:9">dain rechte vet dergreichn daine sonem.<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 21:10" /> vest zei machn vi a faieroivn in tsait fun dain tsorn;</para>
  <para style="q" vid="PSA 21:10">Hashem vet zei umbrengen in zain kaas,</para>
  <para style="q" vid="PSA 21:10">un a faier vet zei fartseren.<verse eid="PSA 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 21:11" /> zeyer frucht vestu unterbrengen fun der erd,</para>
  <para style="q" vid="PSA 21:11">un zeyer zomen fun mentshnkinder.<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 21:12" /> vorem zei hobn ongetsoign shlechts kegen dir;</para>
  <para style="q" vid="PSA 21:12">zei hobn getracht beize gedanken, veln zei nisht oisfirn.<verse eid="PSA 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 21:13" /> vorem vest zei machn umkeren dem rukn,</para>
  <para style="q" vid="PSA 21:13">mit daine boignshtrik vestu tsiln oif zeyer ponem.<verse eid="PSA 21:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 21:14" /> derheib dich, Hashem, in dain shtarkeit;</para>
  <para style="q" vid="PSA 21:14">mir veln zingen un loibn dain gevure.<verse eid="PSA 21:14" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="PSA 22" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 22:1" />far dem gezangmaister; oif Ayelet-HaShachar. a mizmor fun Dovidn.<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 22:2" /> main El, main El, far vos hostu mich farlozen?</para>
  <para style="q" vid="PSA 22:2">vait fun main hilf zainen di verter fun main geshrei.<verse eid="PSA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 22:3" />o main G-t, ich ruf bai tog, un du entferst nisht,</para>
  <para style="q" vid="PSA 22:3">un bai nacht un oich iz kein shtilung tsu mir.<verse eid="PSA 22:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 22:4" />du bist doch der heiliker,</para>
  <para style="q" vid="PSA 22:4">vos tront oif di loibgezangen fun Yisroel.<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 22:5" />oif dir hobn zich farzichert undzere eltern,</para>
  <para style="q" vid="PSA 22:5">zich farzichert, un du host zei derleizt.<verse eid="PSA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 22:6" />tsu dir hobn zei geshrien, un antrunen gevorn,</para>
  <para style="q" vid="PSA 22:6">oif dir zich farzichert, un nisht farshemt gevorn.<verse eid="PSA 22:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 22:7" />ober ich bin a vorem un nisht kein mentsh,</para>
  <para style="q" vid="PSA 22:7">a charpe far lait, un faracht fun folk.<verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 22:8" />ale vos zeen mich, lachn fun mir,</para>
  <para style="q" vid="PSA 22:8">zei tsien mit der lip, zei shoklen dem kop:<verse eid="PSA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 22:9" />zol er zich aroifleigen oif Hashem, er zol im derleizn,</para>
  <para style="q" vid="PSA 22:9">im matsl zain, oib er tut im bageren.<verse eid="PSA 22:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 22:10" />far vor, du host mich aroisgetsoign fun muterlaib,</para>
  <para style="q" vid="PSA 22:10">mich farzichert oif main muters brust.<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 22:11" />oif dir bin ich aroifgevorfn fun gebermuter on,</para>
  <para style="q" vid="PSA 22:11">fun main muterlaib on bist du main El.<verse eid="PSA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 22:12" />nisht dervaiter zich fun mir, vorem di noit iz nont,</para>
  <para style="q" vid="PSA 22:12">vorem nishto ver zol helfn.<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 22:13" />arumgeringlt hobn mich oksen fil,</para>
  <para style="q" vid="PSA 22:13">buln fun Bashan zainen mich bafaln arum.<verse eid="PSA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 22:14" />zei hobn oifgeshpart zeyer moil oif mir,</para>
  <para style="q" vid="PSA 22:14">vi a leib vos fartsukt un brumt.<verse eid="PSA 22:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 22:15" />vi vaser bin ich tserunen gevorn,</para>
  <para style="q" vid="PSA 22:15">un ale maine beiner hobn zich tseshotn;</para>
  <para style="q" vid="PSA 22:15">main harts iz gevorn vi vaks,</para>
  <para style="q" vid="PSA 22:15">tsegangen in maine ingeveid.<verse eid="PSA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 22:16" />oisgetriknt vi a sharbn iz main koiech,</para>
  <para style="q" vid="PSA 22:16">un main tsung iz tsugeklept tsu main gumen;</para>
  <para style="q" vid="PSA 22:16">un in dem shtoib fun toit tustu mich leign.<verse eid="PSA 22:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 22:17" />vorem arumgeringlt hobn mich hint,</para>
  <para style="q" vid="PSA 22:17">a bande shlechtstuer hot mich arumgenumen,</para>
  <para style="q" vid="PSA 22:17">zei hobn maine hent un maine fis durchgeshtochn.<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 22:18" />ich ken ibertseilen ale maine beiner;</para>
  <para style="q" vid="PSA 22:18">zei glotsn, zei kukn oif mir.<verse eid="PSA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 22:19" />zei tseteiln maine begadim tsvishn zich,</para>
  <para style="q" vid="PSA 22:19">un oif main malbesh vorfn zei goirl.<verse eid="PSA 22:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 22:20" />ober du Hashem, zolst zich nisht dervaitern,</para>
  <para style="q" vid="PSA 22:20">main shtarkeit, ail mir tsu hilf.<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 22:21" />zai matsl fun shverd main zel,</para>
  <para style="q" vid="PSA 22:21">fun der macht fun hunt main eineintsike.<verse eid="PSA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 22:22" />helf mich fun dem leibs moil,</para>
  <para style="q" vid="PSA 22:22">un fun di herner fun vizltirn. zolstu mir entfern.<verse eid="PSA 22:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 22:23" />ich vel dertseiln dain nomen tsu maine brider,</para>
  <para style="q" vid="PSA 22:23">in gezeml vel ich dich loibn:<verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 22:24" />ir yirei Hashem, halalu Hashem,</para>
  <para style="q" vid="PSA 22:24">al der zomen fun Yaakov, git im koved,</para>
  <para style="q" vid="PSA 22:24">un hot moire far im, al der zomen fun Yisroel.<verse eid="PSA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 22:25" />vorem er faracht nisht</para>
  <para style="q" vid="PSA 22:25">un farumverdikt nisht di pain fun oreman,</para>
  <para style="q" vid="PSA 22:25">un er farborgt nisht zain ponem fun im,</para>
  <para style="q" vid="PSA 22:25">un az er shrait tsu im, hert er tsu.<verse eid="PSA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 22:26" />fun dir vet zain main loib in a grois gezeml;</para>
  <para style="q" vid="PSA 22:26">ich vel batsoln maine nedrim antkegen far zaine forchter.<verse eid="PSA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 22:27" />esen veln di gedrikte un zat zain,</para>
  <para style="q" vid="PSA 22:27">loibn veln Hashem di vos zuchn im;</para>
  <para style="q" vid="PSA 22:27">zol oiflebn aier harts oif eibik!<verse eid="PSA 22:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 22:28" />baklern veln zich, un zich umkeren tsu Hashem,</para>
  <para style="q" vid="PSA 22:28">ale ekn fun der erd;</para>
  <para style="q" vid="PSA 22:28">un bukn veln zich far dir</para>
  <para style="q" vid="PSA 22:28">ale mishpoches fun di felker.<verse eid="PSA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 22:29" />vorem di meluche iz Hashems,</para>
  <para style="q" vid="PSA 22:29">un er geveltikt iber di felker.<verse eid="PSA 22:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 22:30" />esen ale fetsn fun land,</para>
  <para style="q" vid="PSA 22:30">un zich bukn, knien far im,</para>
  <para style="q" vid="PSA 22:30">veln ale vos hobn in shtoib genidert,</para>
  <para style="q" vid="PSA 22:30">un zeyer zel nisht derhaltn gekent.<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 22:31" />a zomen veln im dinen,</para>
  <para style="q" vid="PSA 22:31">fun Adonoi vet dertseilt vern dem kumedikn dor.<verse eid="PSA 22:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 22:32" />me vet kumen un onzogen zain gerechtikeit,</para>
  <para style="q" vid="PSA 22:32">dem folk vos vet geborn vern – az er hot es geton.<verse eid="PSA 22:32" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="PSA 23" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 23:1" />a mizmor fun Dovidn.</para>
  <para style="q" vid="PSA 23:1">
    <char style="va">1</char> Hashem iz main pastuch,</para>
  <para style="q" vid="PSA 23:1">mir vet nisht feln.<verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />oif grozike fiterpletser macht er mich leign,</para>
  <para style="q" vid="PSA 23:2">bai ruike vasern tut er mich firn.<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />er derkvikt main zel;</para>
  <para style="q" vid="PSA 23:3">er firt mich in richtike shtegn</para>
  <para style="q" vid="PSA 23:3">fun vegen zain nomen.<verse eid="PSA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />afile az ich gei in tal fun toitshotn,</para>
  <para style="q" vid="PSA 23:4">hob ich nisht moire far beiz,</para>
  <para style="q" vid="PSA 23:4">vorem du bist mit mir;</para>
  <para style="q" vid="PSA 23:4">dain rut un dain shtekn, zei tuen mich treistn.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />du greitst far mir a tish</para>
  <para style="q" vid="PSA 23:5">antkegen maine faint;</para>
  <para style="q" vid="PSA 23:5">host bazalbt mit eil main kop,</para>
  <para style="q" vid="PSA 23:5">main kos loift ariber.<verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />nor guts un genod veln mir nochgein</para>
  <para style="q" vid="PSA 23:6">ale teg fun main lebn,</para>
  <para style="q" vid="PSA 23:6">un ich vel zitsn in Hashems hoiz</para>
  <para style="q" vid="PSA 23:6">oif lange teg.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="PSA 24" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 24:1" />fun Dovidn a mizmor.</para>
  <para style="q" vid="PSA 24:1">
    <char style="va">1</char>Hashems iz di erd un ir fulkeit,</para>
  <para style="q" vid="PSA 24:1">di velt un di voiner in ir.<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />vorem er hot zi oif yamen gegruntfest,</para>
  <para style="q" vid="PSA 24:2">un hot zi oif taichn geshtelt.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />ver ken aroifgein oif dem barg fun Hashem?</para>
  <para style="q" vid="PSA 24:3">un ver ken shtein in zain heilikn ort?<verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />der vos hot reine hent un a loiter harts,</para>
  <para style="q" vid="PSA 24:4">vos hot mich nisht dermont tsum falshn,</para>
  <para style="q" vid="PSA 24:4">un nisht geshvorn mit batrug.<verse eid="PSA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />er vet krign a broche fun Hashem,</para>
  <para style="q" vid="PSA 24:5">un genod fun dem Elokim fun zain hilf.<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />dos iz der dor fun di vos forshn im,</para>
  <para style="q" vid="PSA 24:6">vos zuchn dain ponem o Yaakov.</para>
  <para style="q" vid="PSA 24:6">Selah.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />heibt oif, ir toiern, aiere kep, un heibt aich oif, ir</para>
  <para style="q" vid="PSA 24:7">eibike tirn,</para>
  <para style="q" vid="PSA 24:7">un zol araingein der kinig fun pracht.<verse eid="PSA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />ver iz der kinig fun pracht?</para>
  <para style="q" vid="PSA 24:8">Hashem der shtarker un der gibor,</para>
  <para style="q" vid="PSA 24:8">Hashem der gibor fun milchome.<verse eid="PSA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />heibt oif, ir toiern, aiere kep,</para>
  <para style="q" vid="PSA 24:9">un heibt oif, ir eibike tirn,</para>
  <para style="q" vid="PSA 24:9">un zol araingein der kinig fun pracht.<verse eid="PSA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />ver iz der kinig fun pracht?</para>
  <para style="q" vid="PSA 24:10">Hashem Tseva'ot, er iz der kinig fun pracht.</para>
  <para style="q" vid="PSA 24:10">Selah.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="PSA 25" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 25:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 25:1">
    <char style="va">1</char> tsu dir, Hashem, heib ich oif main zel.<verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />main G-t, oif dir farzicher ich mich,</para>
  <para style="q" vid="PSA 25:2">lomich nisht farshemt vern,</para>
  <para style="q" vid="PSA 25:2">zoln nisht kveln oif mir maine faint.<verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />yo, ale vos hofn oif dir zoln nisht farshemt vern;</para>
  <para style="q" vid="PSA 25:3">farshemt vern zoln di vos felshn far gornisht.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />daine vegen, Hashem, mach mich visen,</para>
  <para style="q" vid="PSA 25:4">daine shtegn lern mich.<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />fir mich in dain emes, un lern mich,</para>
  <para style="q" vid="PSA 25:5">vorem du bist der Elokim fun main hilf;</para>
  <para style="q" vid="PSA 25:5">tsu dir hob ich gehoft a gantsn tog.<verse eid="PSA 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />dermon, Hashem, dain derbaremung un daine chasadim,</para>
  <para style="q" vid="PSA 25:6">vorem zei zainen fun eibik on.<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />di zind fun main yugnt un maine farbrechn</para>
  <para style="q" vid="PSA 25:7">zolstu nisht dermonen;</para>
  <para style="q" vid="PSA 25:7">loit dain chesed dermon zich du on mir,</para>
  <para style="q" vid="PSA 25:7">fun vegen dain gutskeit, Hashem.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />gut un rechtfartik iz Hashem,</para>
  <para style="q" vid="PSA 25:8">derum oislernt er di zindike dem veg.<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />er firt di shtile in gerechtikeit,</para>
  <para style="q" vid="PSA 25:9">un lernt di shtile zain veg.<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />ale vegen fun Hashem zainen chesed un traishaft</para>
  <para style="q" vid="PSA 25:10">tsu di vos hitn zain bris un zaine tseignim.<verse eid="PSA 25:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />fun vegen dain nomen, Hashem,</para>
  <para style="q" vid="PSA 25:11">zolstu fargebn main zind, vorem zi iz grois.<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />ver nor a man vos forcht Hashem,</para>
  <para style="q" vid="PSA 25:12">vet er im vaizn dem veg vos er zol veiln.<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />zain zel vet ruen in guts,</para>
  <para style="q" vid="PSA 25:13">un zain zomen vet arben dos land.<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />Hashems fartroitkeit iz mit di vos forchtn im,</para>
  <para style="q" vid="PSA 25:14">un zain bris, kedei zei tsu lernen.<verse eid="PSA 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />maine oign zainen tamid tsu Hashem,</para>
  <para style="q" vid="PSA 25:15">vorem er tsit arois fun nets maine fis.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />ker zich tsu mir, un laitzelik mich,</para>
  <para style="q" vid="PSA 25:16">vorem elnd un orim bin ich.<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />di tsores fun main hartsn hobn zich oisgebreit,</para>
  <para style="q" vid="PSA 25:17">fun maine drikenishn tsi mich arois.<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />ze main pain un main maternish,</para>
  <para style="q" vid="PSA 25:18">un fargib ale maine zind.<verse eid="PSA 25:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />ze vi maine sonem zainen fil,</para>
  <para style="q" vid="PSA 25:19">un di umgerechte faintshaft vos zei hobn mich faint.<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />hit main zel un zai mich matsl,</para>
  <para style="q" vid="PSA 25:20">lomich nisht farshemt vern, vail ich shits mich in dir.<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />zol erlechkeit un rechtfartikeit mich bahitn,</para>
  <para style="q" vid="PSA 25:21">vorem ich tu hofn tsu dir.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />derleiz, Elokim, Yisroel</para>
  <para style="q" vid="PSA 25:22">fun ale zaine tsores.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="PSA 26" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 26:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 26:1">
    <char style="va">1</char>tu mir recht, Hashem,</para>
  <para style="q" vid="PSA 26:1">vorem ich bin gegangen in main erlechkeit,</para>
  <para style="q" vid="PSA 26:1">un ich hob mich farzichert oif Hashem, zich nisht gevaklt.<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />pruv mich, Hashem, un prubir mich,</para>
  <para style="q" vid="PSA 26:2">laiter maine nirn un main harts.<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />vorem dain chesed iz far maine oign,</para>
  <para style="q" vid="PSA 26:3">un ich gei in dain emes.<verse eid="PSA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />ich bin nisht gezesn mit falshe mentshn,</para>
  <para style="q" vid="PSA 26:4">un mit farshtelte kum ich nisht tsunoif.<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />ich hob faint dos gezeml fun shlechtstuer,</para>
  <para style="q" vid="PSA 26:5">un mit reshoim tu ich nisht zitsn.<verse eid="PSA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />ich vash in reinkeit maine hent,</para>
  <para style="q" vid="PSA 26:6">un ich gei arum dain mizbeyech, Hashem,<verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />tsu lozn hern a kol fun dank,</para>
  <para style="q" vid="PSA 26:7">un tsu dertseiln ale daine vunder.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />Hashem, ich hob lib di voinung fun dain hoiz,</para>
  <para style="q" vid="PSA 26:8">un dem ort fun der ruung fun dain koved.<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />zolst nisht ainton mit zindike main zel,</para>
  <para style="q" vid="PSA 26:9">un mit blutike lait main lebn,<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />vos in zeyere hent iz listikeit,</para>
  <para style="q" vid="PSA 26:10">un zeyer rechte iz ful shochad.<verse eid="PSA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />ober ich gei in main erlechkeit;</para>
  <para style="q" vid="PSA 26:11">leiz mich ois, un laitzelik mich.<verse eid="PSA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />ven main fus shteit oif glaichn,</para>
  <para style="q" vid="PSA 26:12">vel ich in gezemlen loibn Hashem.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="PSA 27" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 27:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 27:1">
    <char style="va">1</char>Hashem iz main licht un main hilf,</para>
  <para style="q" vid="PSA 27:1">far vemen zol ich moire hobn?</para>
  <para style="q" vid="PSA 27:1">Hashem iz di festung fun main lebn,</para>
  <para style="q" vid="PSA 27:1">far vemen zol ich angstn?<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />az di shlechtstuer genenen tsu mir</para>
  <para style="q" vid="PSA 27:2">tsu esen main fleish –</para>
  <para style="q" vid="PSA 27:2">maine driker un maine faint –</para>
  <para style="q" vid="PSA 27:2">vern zei geshtroichlt un faln.<verse eid="PSA 27:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />az a machne zol lagern oif mir,</para>
  <para style="q" vid="PSA 27:3">vet nisht moire hobn main harts;</para>
  <para style="q" vid="PSA 27:3">az a milchome zol onshtein oif mir,</para>
  <para style="q" vid="PSA 27:3">bin ich fun dest vegen zicher.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />eins hob ich farlangt fun Hashem,</para>
  <para style="q" vid="PSA 27:4">dos tu ich betn:</para>
  <para style="q" vid="PSA 27:4">ich zol zitsn in hoiz fun Hashem</para>
  <para style="q" vid="PSA 27:4">ale teg fun main lebn,</para>
  <para style="q" vid="PSA 27:4">tsu zen di liblechkeit fun Hashem,</para>
  <para style="q" vid="PSA 27:4">un zich tsu federn in zain heichl.<verse eid="PSA 27:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />vorem er bahalt mich in zain baidl,</para>
  <para style="q" vid="PSA 27:5">in dem tog fun beiz,</para>
  <para style="q" vid="PSA 27:5">er farborgt mich in der farborgenish fun zain getselt,</para>
  <para style="q" vid="PSA 27:5">oif a feldz tut er mich derheibn.<verse eid="PSA 27:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />un atsund vet zich heibn main kop</para>
  <para style="q" vid="PSA 27:6">iber maine faint rund arum mir,</para>
  <para style="q" vid="PSA 27:6">un ich vel shlachtn in zain getselt shlachtopfer mit geshal,</para>
  <para style="q" vid="PSA 27:6">ich vel zingen un shpiln tsu Hashem.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />her, Hashem, main kol – tu ich rufn –</para>
  <para style="q" vid="PSA 27:7">un laitzelik mich, un entfer mir.<verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />main harts zogt far dir: zucht main ponem!</para>
  <para style="q" vid="PSA 27:8">dain ponem, Hashem, tu ich zuchn.<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />zolst nisht farborgen dain ponem fun mir,</para>
  <para style="q" vid="PSA 27:9">zolst nisht opnaign in tsorn dain knecht;</para>
  <para style="q" vid="PSA 27:9">bist main hilf geven, zolst mich nisht avekvarfn,</para>
  <para style="q" vid="PSA 27:9">un zolst mich nisht farlozen, Elokim fun main yeshue.<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />afile main foter un main muter zoln mich farlozen,</para>
  <para style="q" vid="PSA 27:10">vet ober Hashem mich arainnemen.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />vaiz mir, Hashem, dain veg,</para>
  <para style="q" vid="PSA 27:11">un fir mich in glaichn shteg,</para>
  <para style="q" vid="PSA 27:11">fun vegen maine loierer.<verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />zolst mich nisht gebn oif dem barot fun maine faint;</para>
  <para style="q" vid="PSA 27:12">vorem falshe eides zainen oifgeshtanen kegen mir,</para>
  <para style="q" vid="PSA 27:12">un der vos otemt mit umrecht.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />ven ich volt nisht gegloibt tsu zen dos guts fun Hashem,</para>
  <para style="q" vid="PSA 27:13">in land fun di lebedike! –<verse eid="PSA 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />hof tsu Hashem, zai shtark,</para>
  <para style="q" vid="PSA 27:14">un zol fest zain dain harts;</para>
  <para style="q" vid="PSA 27:14">yo, hof tsu Hashem.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="PSA 28" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 28:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 28:1">
    <char style="va">1</char> tsu dir, Hashem, tu ich rufn; main feldz,</para>
  <para style="q" vid="PSA 28:1">zolst nisht toib zain tsu mir,</para>
  <para style="q" vid="PSA 28:1">vorem az du vest shvaign tsu mir,</para>
  <para style="q" vid="PSA 28:1">vel ich zain geglichn tsu di geniderte in grub.<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />her dem kol fun main gebet, az ich shrai tsu dir,</para>
  <para style="q" vid="PSA 28:2">az ich heib oif maine hent</para>
  <para style="q" vid="PSA 28:2">tsu dain heilikn heichl.<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />zolst mich nisht avektsien mit di reshoim,</para>
  <para style="q" vid="PSA 28:3">un mit di tuer fun umrecht,</para>
  <para style="q" vid="PSA 28:3">vos redn sholem mit zeyere chaverim,</para>
  <para style="q" vid="PSA 28:3">un beiz iz in zeyer hartsn.<verse eid="PSA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />gib zei loit zeyer verk,</para>
  <para style="q" vid="PSA 28:4">un loit der shlechtikeit fun zeyere meisim;</para>
  <para style="q" vid="PSA 28:4">loit der tuung fun zeyere hent gib zei,</para>
  <para style="q" vid="PSA 28:4">ker zei um zeyer fargeltung.<verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />vail zei achten nisht oif di verk fun Hashem,</para>
  <para style="q" vid="PSA 28:5">un oif der tuung fun zaine hent,</para>
  <para style="q" vid="PSA 28:5">vet er zei tseshtern un zei nisht oifboien.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />Baruch Hashem,</para>
  <para style="q" vid="PSA 28:6">vorn er hot gehert dem kol fun maine gebetn.<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />Hashem iz main shtarkeit un main shild,</para>
  <para style="q" vid="PSA 28:7">oif im hot zich farzichert main harts,</para>
  <para style="q" vid="PSA 28:7">un ich bin geholfn gevorn.</para>
  <para style="q" vid="PSA 28:7">derum iz lustik main harts,</para>
  <para style="q" vid="PSA 28:7">un mit main gezang tu ich im danken.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />Hashem iz zei a shtarkeit,</para>
  <para style="q" vid="PSA 28:8">un a festung fun hilf iz er zain gezalbtn.<verse eid="PSA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />helf dain folk, un bentsh dain arav,</para>
  <para style="q" vid="PSA 28:9">un fiter zei, un trog zei oif eibik.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="PSA 29" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 29:1" />a mizmor fun Dovidn.</para>
  <para style="q" vid="PSA 29:1">
    <char style="va">1</char> git tsu Hashem, ir machtike,</para>
  <para style="q" vid="PSA 29:1">git tsu Hashem koved un shtarkeit,<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />git tsu Hashem dem koved fun zain nomen,</para>
  <para style="q" vid="PSA 29:2">bukt zich tsu Hashem mit heilikn opshai.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />der kol fun Hashem iz oif di vasern,</para>
  <para style="q" vid="PSA 29:3">der El fun pracht tut dunern,</para>
  <para style="q" vid="PSA 29:3">Hashem – oif vasern groise.<verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />der kol fun Hashem iz mit macht,</para>
  <para style="q" vid="PSA 29:4">der kol fun Hashem iz mit sheinkeit,<verse eid="PSA 29:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />der kol fun Hashem tsebrecht tsedern,</para>
  <para style="q" vid="PSA 29:5">un Hashem tsebrecht di tsedern fun Levanon.<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />un er macht zei shpringen vi a kalb,</para>
  <para style="q" vid="PSA 29:6">Levanon un Siryon, vi a yung vizltir.<verse eid="PSA 29:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />der kol fun Hashem hakt ois flamen faier.<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />der kol fun Hashem macht tsiteren dem midber,</para>
  <para style="q" vid="PSA 29:8">Hashem macht tsiteren dem midber fun Kadesh.<verse eid="PSA 29:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />der kol fun Hashem macht hindins gebern</para>
  <para style="q" vid="PSA 29:9">un tut velder antbloizn;</para>
  <para style="q" vid="PSA 29:9">un in zain heichl zogt itlecher: prachtik!<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />Hashem hot baim mabl getront,</para>
  <para style="q" vid="PSA 29:10">un Hashem tront vi a melech oif eibik.<verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />Hashem vet zain folk gebn shtarkeit,</para>
  <para style="q" vid="PSA 29:11">Hashem vet bentshn zain folk mit sholem.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" pubnumber="ל" sid="PSA 30" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 30:1" />a mizmor; a gezang tsu der banaiung fun heichl fun Dovidn.<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 30:2" /> ich derheib dich, Hashem, vorem host mich oifgericht,</para>
  <para style="q" vid="PSA 30:2">un nisht derfreit maine faint iber mir.<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 30:3" /> Hashem main G-t, ich hob geshrien tsu dir,</para>
  <para style="q" vid="PSA 30:3">un host mich geheilt.<verse eid="PSA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 30:4" /> Hashem, host aroifgebracht fun Sheol main zel,</para>
  <para style="q" vid="PSA 30:4">host mich oifgelebt, ich zol nisht nidern in grub.<verse eid="PSA 30:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 30:5" /> zingt tsu Hashem, zaine frume,</para>
  <para style="q" vid="PSA 30:5">un dankt zain heiliker gedechenish.<verse eid="PSA 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 30:6" /> vorem a rege iz zain tsorn,</para>
  <para style="q" vid="PSA 30:6">a lebn zain gutvilikeit.</para>
  <para style="q" vid="PSA 30:6">iber nacht blaibt gevein,</para>
  <para style="q" vid="PSA 30:6">un frimorgns iz gezang.<verse eid="PSA 30:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 30:7" /> un ich hob gevest gezogt in main shalve:</para>
  <para style="q" vid="PSA 30:7">ich vel nisht umfaln kein mol.<verse eid="PSA 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 30:8" /> in dain gutvilikeit, Hashem,</para>
  <para style="q" vid="PSA 30:8">hostu gehat oifgeshtelt fest main barg –</para>
  <para style="q" vid="PSA 30:8">hostu farborgen dain ponem,</para>
  <para style="q" vid="PSA 30:8">un ich bin dershrokn gevorn.<verse eid="PSA 30:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 30:9" /> tsu dir, Hashem, fleg ich rufn,</para>
  <para style="q" vid="PSA 30:9">un tsu Adonoi fleg ich betn:<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 30:10" /> voser gevin iz in main blut,</para>
  <para style="q" vid="PSA 30:10">az ich vel nidern in grub?</para>
  <para style="q" vid="PSA 30:10">ken dich loibn der shtoib?</para>
  <para style="q" vid="PSA 30:10">ken er dertseiln dain emes?<verse eid="PSA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 30:11" /> her, Hashem, un laitzelik mich,</para>
  <para style="q" vid="PSA 30:11">Hashem, zai mir a helfer.<verse eid="PSA 30:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 30:12" /> hostu mir farkert main klog in tants,</para>
  <para style="q" vid="PSA 30:12">host opgebundn main zakkleid,</para>
  <para style="q" vid="PSA 30:12">un mich ongegurt mit freid;<verse eid="PSA 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 30:13" /> derum vet dich bazingen di zel, un nisht shvaign.</para>
  <para style="q" vid="PSA 30:13">Hashem main G-t, eibik vel ich dir danken.<verse eid="PSA 30:13" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" pubnumber="לא" sid="PSA 31" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 31:1" />far dem gezangmaister; a mizmor fun Dovidn.<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 31:2" /> in dir, Hashem, tu ich mich shitsn,</para>
  <para style="q" vid="PSA 31:2">lomich nisht farshemt vern kein mol;</para>
  <para style="q" vid="PSA 31:2">in dain gerechtikeit mach mich antrinen.<verse eid="PSA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 31:3" /> naig tsu dain oier tsu mir,</para>
  <para style="q" vid="PSA 31:3">zai mich matsl geshvint;</para>
  <para style="q" vid="PSA 31:3">zai mir far a feldz fun bashitsung,</para>
  <para style="q" vid="PSA 31:3">far a bafestikt hoiz mich tsu helfn.<verse eid="PSA 31:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 31:4" /> vorem du bist main feldz un main festung,</para>
  <para style="q" vid="PSA 31:4">un fun dain nomen vegen zolstu mich firn un mich baleitn.<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 31:5" /> zolst mich aroistsien fun der nets</para>
  <para style="q" vid="PSA 31:5">vos zei hobn mir untergeleigt,</para>
  <para style="q" vid="PSA 31:5">vorem du bist main bashitsung,<verse eid="PSA 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 31:6" /> in dain hant gib ich iber main gaist;</para>
  <para style="q" vid="PSA 31:6">vest mich oisleizen, Hashem, du El getraier.<verse eid="PSA 31:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 31:7" /> ich hob faint di vos haltn zich on falshe nishtikeitn,</para>
  <para style="q" vid="PSA 31:7">vorem ich hob mich oif Hashem farzichert.<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 31:8" /> ich frei zich un bin lustik mit dain chesed,</para>
  <para style="q" vid="PSA 31:8">vorem host gezen main pain,</para>
  <para style="q" vid="PSA 31:8">host gemerkt di tsores fun main zel.<verse eid="PSA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 31:9" /> un host mich nisht ibergeentfert</para>
  <para style="q" vid="PSA 31:9">in der hant funem faint;</para>
  <para style="q" vid="PSA 31:9">host geshtelt maine fis in derbreiternish.<verse eid="PSA 31:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 31:10" /> laitzelik mich, Hashem, vorem mir iz eng,</para>
  <para style="q" vid="PSA 31:10">mat gevorn fun ergernish iz main oig,</para>
  <para style="q" vid="PSA 31:10">main zel un main laib.<verse eid="PSA 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 31:11" /> vorem fargangen iz in kumer main lebn,</para>
  <para style="q" vid="PSA 31:11">un maine yorn in ziftsenish;</para>
  <para style="q" vid="PSA 31:11">opgefaln fun vegen maine zind iz main koiech,</para>
  <para style="q" vid="PSA 31:11">un maine beiner zainen mat gevorn.<verse eid="PSA 31:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 31:12" /> fun vegen ale maine faint bin ich gevorn tsu charpe,</para>
  <para style="q" vid="PSA 31:12">un bai maine shecheynim, biz gor,</para>
  <para style="q" vid="PSA 31:12">un a groil bai maine bakante;</para>
  <para style="q" vid="PSA 31:12">di vos zeen mich in gas, vaichn fun mir.<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 31:13" /> ich bin fargesen gevorn vi a toiter oisn hartsn,</para>
  <para style="q" vid="PSA 31:13">ich bin gevorn vi a fardorben gefes.<verse eid="PSA 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 31:14" /> vorem ich hob gehert dos gereid fun fil –</para>
  <para style="q" vid="PSA 31:14">a shrek rund arum;</para>
  <para style="q" vid="PSA 31:14">az zei eetshn zich mit anander oif mir,</para>
  <para style="q" vid="PSA 31:14">trachtn zei main lebn tsu nemen.<verse eid="PSA 31:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 31:15" /> ober ich farzicher mich oif dir, Hashem,</para>
  <para style="q" vid="PSA 31:15">ich zog: main G-t bist du.<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 31:16" /> in dain hant zainen maine tsaitn,</para>
  <para style="q" vid="PSA 31:16">zai mich matsl fun der hant fun maine faint,</para>
  <para style="q" vid="PSA 31:16">un fun maine nochyoger.<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 31:17" /> derlaicht dain ponem oif dain knecht,</para>
  <para style="q" vid="PSA 31:17">helf mich in dain genod.<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 31:18" /> Hashem, nisht lomich farshemt vern,</para>
  <para style="q" vid="PSA 31:18">vorem ich hob dich gerufn;</para>
  <para style="q" vid="PSA 31:18">zoln farshemt vern di reshoim,</para>
  <para style="q" vid="PSA 31:18">zoln zei antshvigen vern in Sheol.<verse eid="PSA 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 31:19" /> zoln shtum vern di lipn fun lign,</para>
  <para style="q" vid="PSA 31:19">vos redn oifn tsadik farshait,</para>
  <para style="q" vid="PSA 31:19">mit gaive un farachtenish.<verse eid="PSA 31:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 31:20" /> vi grois iz dain guts,</para>
  <para style="q" vid="PSA 31:20">vos du host bahaltn far di vos forchtn dich,</para>
  <para style="q" vid="PSA 31:20">gemacht far di vos shitsn zich in dir</para>
  <para style="q" vid="PSA 31:20">akegn di mentshnkinder!<verse eid="PSA 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 31:21" /> farborgst zei in der farborgenish fun dain ponem,</para>
  <para style="q" vid="PSA 31:21">fun di bandes mentshn;</para>
  <para style="q" vid="PSA 31:21">bahaltst zei in a baidl,</para>
  <para style="q" vid="PSA 31:21">fun dem krig fun di tsinger.<verse eid="PSA 31:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 31:22" /> Baruch Hashem, vos hot vunderlech bavizn</para>
  <para style="q" vid="PSA 31:22">zain chesed tsu mir in der balegerter shtot.<verse eid="PSA 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 31:23" /> un ich hob gevest gezogt in main hast:</para>
  <para style="q" vid="PSA 31:23">ich bin farshnitn fun kegen daine oign.</para>
  <para style="q" vid="PSA 31:23">ober host gehert dem kol fun maine gebetn,</para>
  <para style="q" vid="PSA 31:23">az ich hob geshrien tsu dir.<verse eid="PSA 31:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 31:24" /> hot lib Hashem, ir ale zaine frume;</para>
  <para style="q" vid="PSA 31:24">di getraie tut ophiten Hashem,</para>
  <para style="q" vid="PSA 31:24">un batsolt mit an ibermos dem vos tut hoferdik.<verse eid="PSA 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 31:25" /> zait shtark, un zol fest zain aier harts,</para>
  <para style="q" vid="PSA 31:25">ir ale vos hoft tsu Hashem.<verse eid="PSA 31:25" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" pubnumber="לב" sid="PSA 32" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 32:1" />fun Dovidn a batrachtung.</para>
  <para style="q" vid="PSA 32:1">
    <char style="va">1</char>voil tsu dem vos zain farbrech iz fargebn,</para>
  <para style="q" vid="PSA 32:1">vos zain chet vert fardekt.<verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />voil tsu dem mentshn vos Hashem rechnt im nisht kein zind,</para>
  <para style="q" vid="PSA 32:2">un in zain gaist iz nishto kein batrug.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />az ich hob geshvigen, hobn maine beiner gefoilt,</para>
  <para style="q" vid="PSA 32:3">fun main krechtsn a gantsn tog.<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />vorem tog un nacht flegt shver zain oif mir dain hant,</para>
  <para style="q" vid="PSA 32:4">main zaft iz farbaiten gevorn vi in fartriknte zumeroips.</para>
  <para style="q" vid="PSA 32:4">Selah.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />hob ich dich gelozt visen main chet,</para>
  <para style="q" vid="PSA 32:5">un main zind hob ich nisht fardekt.</para>
  <para style="q" vid="PSA 32:5">ich hob gezogt: ich vel zich moide zain oif maine</para>
  <para style="q" vid="PSA 32:5">farbrechn tsu Hashem;</para>
  <para style="q" vid="PSA 32:5">un du host fargebn di shuld fun main zind. Selah.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />oif dem zol itlecher frumer mispalel zain tsu dir,</para>
  <para style="q" vid="PSA 32:6">in der tsait vos me ken dich gefinen:</para>
  <para style="q" vid="PSA 32:6">az di groise vasern fleitsn iber,</para>
  <para style="q" vid="PSA 32:6">zoln zei tsu im ober nisht dergreichn.<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />du bist main farborgenish,</para>
  <para style="q" vid="PSA 32:7">fun dem faint bahitstu mich;</para>
  <para style="q" vid="PSA 32:7">mit gezangen fun antrinung</para>
  <para style="q" vid="PSA 32:7">ringlstu mich arum. Selah.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />ich vel dich klug machn</para>
  <para style="q" vid="PSA 32:8">un dir vaizn dem veg vos du zolst gein,</para>
  <para style="q" vid="PSA 32:8">ich vel haltn main oig oif dir.<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />ir zolt nisht zain vi a ferd, vi a moileizl, on farshtand,</para>
  <para style="q" vid="PSA 32:9">vos mit tsam un gebis muz men ainhaltn zain impet,</para>
  <para style="q" vid="PSA 32:9">az me zol nisht kenen genenen tsu dir.<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />fil veitogn hot der roshe,</para>
  <para style="q" vid="PSA 32:10">ober der vos farzichert zich oif Hashem,</para>
  <para style="q" vid="PSA 32:10">im vet arumringlen genod.<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />freit zich mit Hashem, un zait lustik, tsadikim,</para>
  <para style="q" vid="PSA 32:11">un zingt, ale rechtfartikn hertser.<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" pubnumber="לג" sid="PSA 33" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />freit zich tsadikim, mit Hashem,</para>
  <para style="q" vid="PSA 33:1">shein far di rechtfartikn iz loibung.<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />git a dank tsu Hashem oif a harf,</para>
  <para style="q" vid="PSA 33:2">oif a gitar fun tsen strunes shpilt tsu im.<verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />zingt tsu im a nai gezang,</para>
  <para style="q" vid="PSA 33:3">shpilt voil mit geshal.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />vorem rechtfartik iz dos vort fun Hashem</para>
  <para style="q" vid="PSA 33:4">un zain yetveder tuung iz mit traishaft.<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />er hot lib recht un gerechtikeit,</para>
  <para style="q" vid="PSA 33:5">mit dem chesed fun Hashem iz ful di erd.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />durch dem vort fun Hashem zainen di himlen gemacht gevorn,</para>
  <para style="q" vid="PSA 33:6">un durch dem ruach fun zain moil zeyer gantser cheil.<verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />er zamlt vi a stoig di vasern fun yam,</para>
  <para style="q" vid="PSA 33:7">er tut arain in shpaichlers di tehomen.<verse eid="PSA 33:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />moire far Hashem hot di gantse erd,</para>
  <para style="q" vid="PSA 33:8">far im forchtn ale bavoiner fun der velt.<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />vorem er zogt, un es geshet,</para>
  <para style="q" vid="PSA 33:9">er bafelt, un es bashteit.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />Hashem farshtert dem barot fun di felker,</para>
  <para style="q" vid="PSA 33:10">er farvert di machshoves fun di umes.<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />der barot fun Hashem vet oif eibik bashtein,</para>
  <para style="q" vid="PSA 33:11">di trachtungen fun zain hartsn oif dor-doires.<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />voil tsu dem folk vos Hashem iz zain G-t,</para>
  <para style="q" vid="PSA 33:12">tsu der ume vos er hot geveilt zich tsum arav.<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />fun himel lugt Hashem,</para>
  <para style="q" vid="PSA 33:13">er zet ale mentshnkinder;<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />fun dem ort fun zain voinung</para>
  <para style="q" vid="PSA 33:14">batracht er ale bavoiner fun der erd;<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />er vos furemt zeyer alemens harts,</para>
  <para style="q" vid="PSA 33:15">vos farshteit ale zeyere meisim.<verse eid="PSA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />a melech vert nisht geholfn durch fil cheil,</para>
  <para style="q" vid="PSA 33:16">a gibor vert nisht nitsl durch grois koiech;<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />an opnar iz der ferd far hilf,</para>
  <para style="q" vid="PSA 33:17">un mit zain grois koiech vet er nisht machn antrinen.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />ze, dos oig fun Hashem iz oif di vos forchtn im,</para>
  <para style="q" vid="PSA 33:18">oif di vos hofn tsu zain chesed,<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />matsl tsu zain fun toit zeyer zel,</para>
  <para style="q" vid="PSA 33:19">un zei tsu derhaltn in hunger.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />undzer zel hot gehart oif Hashem,</para>
  <para style="q" vid="PSA 33:20">undzer hilf un undzer shild iz er.<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />vorem mit im freit zich undzer harts,</para>
  <para style="q" vid="PSA 33:21">vorem oif zain heilikn nomen hobn mir zich farzichert.<verse eid="PSA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />zol dain chesed, Hashem, zain oif undz,</para>
  <para style="q" vid="PSA 33:22">azoi vi mir hobn gehoft tsu dir.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" pubnumber="לד" sid="PSA 34" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 34:1" />fun Dovidn; ven er hot gebitn zain seichel far Avimelechn, un er hot im aroisgetribn, un er iz avek.<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 34:2" /> ich bentsh Hashem in yetveder tsait,</para>
  <para style="q" vid="PSA 34:2">tmid iz zain loib in main moil.<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 34:3" /> mit Hashem rimt zich main zel;</para>
  <para style="q" vid="PSA 34:3">di gedrikte veln hern un zich freyen.<verse eid="PSA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 34:4" /> greist Hashem mit mir,</para>
  <para style="q" vid="PSA 34:4">un lomir derheibn zain nomen in einem.<verse eid="PSA 34:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 34:5" /> ich hob gezucht Hashem, un er hot mir geentfert,</para>
  <para style="q" vid="PSA 34:5">un fun ale maine shrekenishn hot er mich matsl geven.<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 34:6" /> zei hobn gekukt tsu im, un hobn oifgeluchtn,</para>
  <para style="q" vid="PSA 34:6">un zeyere penemer veln nisht farshemt vern.<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 34:7" /> ot hot an oreman gerufn, un Hashem hot tsugehert,</para>
  <para style="q" vid="PSA 34:7">un fun ale zaine tsores im geholfn.<verse eid="PSA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 34:8" /> der malach fun Hashem lagert arum zaine forchter,</para>
  <para style="q" vid="PSA 34:8">un er tut zei derleizn.<verse eid="PSA 34:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 34:9" /> batracht un zet az Hashem iz gut;</para>
  <para style="q" vid="PSA 34:9">voil tsu dem man vos shitst zich in im.<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 34:10" /> forcht Hashem, ir zaine heilike,</para>
  <para style="q" vid="PSA 34:10">vorem zaine forchter vet nisht feln.<verse eid="PSA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 34:11" /> yungleibn daren un hungern,</para>
  <para style="q" vid="PSA 34:11">ober di vos zuchn Hashem felt nisht kol-tov.<verse eid="PSA 34:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 34:12" /> kumt, kinder, hert mir tsu,</para>
  <para style="q" vid="PSA 34:12">moire far Hashem vel ich aich lernen.<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 34:13" /> ver nor a man vos vil lebn,</para>
  <para style="q" vid="PSA 34:13">vos gart teg tsu zen guts,<verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 34:14" /> hit dain tsung fun shlechts,</para>
  <para style="q" vid="PSA 34:14">un daine lipn fun redn batrug.<verse eid="PSA 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 34:15" /> ker zich op fun shlechts, un tu guts,</para>
  <para style="q" vid="PSA 34:15">zuch sholem un yog zich noch im.<verse eid="PSA 34:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 34:16" /> di oign fun Hashem zainen oif di tsadikim,</para>
  <para style="q" vid="PSA 34:16">un zaine oiern oif zeyer geshrei.<verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 34:17" /> der ponem fun Hashem iz kegen di shlechtstuer.</para>
  <para style="q" vid="PSA 34:17">tsu farshnaidn fun der erd zeyer gedechenish.<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 34:18" /> zei hobn geshrien, un Hashem hot zei tsugehert,</para>
  <para style="q" vid="PSA 34:18">un fun ale zeyere tsores zei matsl geven.<verse eid="PSA 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 34:19" /> Hashem iz nont tsu di tsebrochene hertser,</para>
  <para style="q" vid="PSA 34:19">un di dershlogene gemiter tut er helfn.<verse eid="PSA 34:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 34:20" /> fil zainen di umglikn fun tsadik,</para>
  <para style="q" vid="PSA 34:20">ober fun zei ale vet im matsl zain Hashem.<verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 34:21" /> er hit op ale zaine beiner,</para>
  <para style="q" vid="PSA 34:21">nisht an eintsiker fun zei vert tsebrochn.<verse eid="PSA 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 34:22" /> dem roshe vet teitn dos beiz,</para>
  <para style="q" vid="PSA 34:22">un di sonem fun tsadik veln farvist vern.<verse eid="PSA 34:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 34:23" /> Hashem leizt ois di zel fun zaine knecht,</para>
  <para style="q" vid="PSA 34:23">un nisht farvist vern veln ale vos shitsn zich in im.<verse eid="PSA 34:23" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" pubnumber="לה" sid="PSA 35" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 35:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 35:1">
    <char style="va">1</char>krig, Hashem, mit maine kriger,</para>
  <para style="q" vid="PSA 35:1">shtrait mit maine shtraiter.<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />nem on a shild un a klein shild,</para>
  <para style="q" vid="PSA 35:2">un shtei oif mir tsu hilf.<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />un tsi arois dem shpiz un di hak</para>
  <para style="q" vid="PSA 35:3">akegn maine nochyoger;</para>
  <para style="q" vid="PSA 35:3">zog tsu main zel:</para>
  <para style="q" vid="PSA 35:3">dain yeshue bin ich.<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />zoln farshemt un tsu shand vern</para>
  <para style="q" vid="PSA 35:4">di vos zuchn main lebn;</para>
  <para style="q" vid="PSA 35:4">zoln optretn ahinter un zich shemen</para>
  <para style="q" vid="PSA 35:4">di vos trachtn mir beiz.<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />zoln zei zain vi shprei faran vint,</para>
  <para style="q" vid="PSA 35:5">un der malach fun Hashem zol zei shtoisn.<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />zol zeyer veg zain choishech un glitshik,</para>
  <para style="q" vid="PSA 35:6">un der malach fun Hashem zol zei yogn.<verse eid="PSA 35:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />vorem far umzist hobn zei mir untergeleigt</para>
  <para style="q" vid="PSA 35:7">zeyer nets fun untergang,</para>
  <para style="q" vid="PSA 35:7">far umzist hobn zei gegrobn oif main zel.<verse eid="PSA 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />zol kumen oif im a broch umgericht,</para>
  <para style="q" vid="PSA 35:8">un zain nets vos er hot untergeleigt zol im batsvingen;</para>
  <para style="q" vid="PSA 35:8">mit shturem zol er faln derin.<verse eid="PSA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />un main zel vet zich freyen mit Hashem,</para>
  <para style="q" vid="PSA 35:9">zi vet lustik zain mit zain yeshue.<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />ale maine beiner veln zogn:</para>
  <para style="q" vid="PSA 35:10">ver azoi vi du, Hashem,</para>
  <para style="q" vid="PSA 35:10">iz matsl dem oreman fun dem shtarkern fun im,</para>
  <para style="q" vid="PSA 35:10">yo, dem oreman un dem evyon fun dem vos bagzlt im.<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />falshe eides shteyen oif,</para>
  <para style="q" vid="PSA 35:11">vos ich veis nisht fregn zei mich.<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />zei tsoln mir a roeh far a toive,</para>
  <para style="q" vid="PSA 35:12">faryosemt iz main zel.<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />un ich, az zei zainen krank geven,</para>
  <para style="q" vid="PSA 35:13">iz main onkleid geven zak,</para>
  <para style="q" vid="PSA 35:13">ich hob gepainikt mit fasten main laib;</para>
  <para style="q" vid="PSA 35:13">un main tfile – zol es onkumen in main buzem!<verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />vi bai a chever, vi bai a bruder mainem,</para>
  <para style="q" vid="PSA 35:14">bin ich arumgegangen,</para>
  <para style="q" vid="PSA 35:14">vi in troier noch a mamen,</para>
  <para style="q" vid="PSA 35:14">fintster geboign bin ich geven.<verse eid="PSA 35:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />ober az ich fal, freyen zei zich, un klaibn zich oif;</para>
  <para style="q" vid="PSA 35:15">es klaibn zich arum mir shleger vos ich ken nisht;</para>
  <para style="q" vid="PSA 35:15">zei raisn un hern nisht oif.<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />mit falshe rechiles-geshpetn</para>
  <para style="q" vid="PSA 35:16">kritsn zei oif mir zeyere tsein.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />Adonoi, vi lang vestu tsuzen?</para>
  <para style="q" vid="PSA 35:17">nem avek main zel fun zeyere farvistungen,</para>
  <para style="q" vid="PSA 35:17">fun di yungleibn main eineintsike.<verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />ich vel dir danken in a grois gezeml,</para>
  <para style="q" vid="PSA 35:18">in fil folk vel ich dich loibn.<verse eid="PSA 35:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />zoln zich nisht freyen iber mir</para>
  <para style="q" vid="PSA 35:19">di vos zainen mir faint far gornisht;</para>
  <para style="q" vid="PSA 35:19">maine umzistike sonem</para>
  <para style="q" vid="PSA 35:19">vos vinken mitn oig.<verse eid="PSA 35:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />vorem umsholum redn zei,</para>
  <para style="q" vid="PSA 35:20">un kegen di shtile fun der erd</para>
  <para style="q" vid="PSA 35:20">trachtn zei ois falshe shtik.<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />un zei efenen breit zeyer moil oif mir;</para>
  <para style="q" vid="PSA 35:21">zei zogn: aha! aha! undzer oig hot derlebt.<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />du host gezen, Hashem, zolstu nisht farshvaign;</para>
  <para style="q" vid="PSA 35:22">Adonoi, zolst zich nisht dervaitern fun mir.<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />dervek dich un vach oif tsu main mishpot,</para>
  <para style="q" vid="PSA 35:23">tsu main krig, main G-t un Adonoi.<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />mishpot mich loit dain gerechtikeit, Hashem main G-t,</para>
  <para style="q" vid="PSA 35:24">un zoln zei zich nisht freyen iber mir.<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />zoln zei nisht zogn in zeyer hartsn:</para>
  <para style="q" vid="PSA 35:25">aha! undzer bager!</para>
  <para style="q" vid="PSA 35:25">zoln zei nisht zogn:</para>
  <para style="q" vid="PSA 35:25">mir hobn im aingeshlungen!<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />zoln farshemt un tsu shand vern in einem</para>
  <para style="q" vid="PSA 35:26">di vos freyen zich oif main umglik;</para>
  <para style="q" vid="PSA 35:26">zoln bakleidt vern mit bushe un shmach</para>
  <para style="q" vid="PSA 35:26">di vos greisn zich iber mir.<verse eid="PSA 35:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />zoln zingen un zich freyen</para>
  <para style="q" vid="PSA 35:27">di vos bageren main gerechtikeit;</para>
  <para style="q" vid="PSA 35:27">un zoln zei tamid zogn: gegreist zol zain Hashem,</para>
  <para style="q" vid="PSA 35:27">vos bagert dem frid fun zain knecht.<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />un main tsung vet redn dain gerechtikeit,</para>
  <para style="q" vid="PSA 35:28">a gantsn tog dain loib.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" pubnumber="לו" sid="PSA 36" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 36:1" />far dem gezangmaister; fun dem knecht fun Hashem, fun Dovidn.<verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 36:2" /> di zind redt tsum roshe – kler ich in hartsn;</para>
  <para style="q" vid="PSA 36:2">nishto G-ts moire far zaine oign.<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 36:3" /> vorem tsu fil chanfet zi im in zaine oign,</para>
  <para style="q" vid="PSA 36:3">az er zol kenen faint hobn zain farbrech.<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 36:4" /> di verter fun zain moil zainen umrecht un batrug,</para>
  <para style="q" vid="PSA 36:4">er hot oifgehert farshtein tsu ton guts.<verse eid="PSA 36:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 36:5" /> umrecht tracht er oif zain geleger,</para>
  <para style="q" vid="PSA 36:5">er shteit oifn nisht gutn veg,</para>
  <para style="q" vid="PSA 36:5">dos beiz vert im nisht nems.<verse eid="PSA 36:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 36:6" /> Hashem, biz in di himlen iz dain chesed,</para>
  <para style="q" vid="PSA 36:6">dain traishaft biz di volken.<verse eid="PSA 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 36:7" /> dain gerechtikeit iz vi di machtike berg,</para>
  <para style="q" vid="PSA 36:7">daine mishpotim vi der groiser tehom;</para>
  <para style="q" vid="PSA 36:7">mentshn un beheimes tustu helfn, Hashem.<verse eid="PSA 36:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 36:8" /> vi taier iz dain chesed, Elokim,</para>
  <para style="q" vid="PSA 36:8">un di mentshnkinder shitsn zich</para>
  <para style="q" vid="PSA 36:8">in shotn fun daine fliglen.<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 36:9" /> zei zetn zich mit der fetkeit fun dain hoiz,</para>
  <para style="q" vid="PSA 36:9">un fun dem taich fun daine tenugim trinkstu zei on.<verse eid="PSA 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 36:10" /> vorem bai dir iz der kval fun lebn,</para>
  <para style="q" vid="PSA 36:10">in dain licht zeen mir lichtikeit.<verse eid="PSA 36:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 36:11" /> tsi ois dain chesed tsu di vos kenen dich,</para>
  <para style="q" vid="PSA 36:11">un dain gerechtikeit tsu di rechtfartikn hertser.<verse eid="PSA 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 36:12" /> zol nisht tsukumen tsu mir der fus fun gaive,</para>
  <para style="q" vid="PSA 36:12">un di hant fun reshoim zol mich nisht farvoglen.<verse eid="PSA 36:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 36:13" /> on zainen gefaln di tuer fun umrecht,</para>
  <para style="q" vid="PSA 36:13">zei zainen anidergeshtoisn, un kenen nisht oifshtein.<verse eid="PSA 36:13" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" pubnumber="לז" sid="PSA 37" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 37:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 37:1">
    <char style="va">1</char>zolst zich nisht ergern vegen di shlechtstuer,</para>
  <para style="q" vid="PSA 37:1">zolst nisht mekane zain di vos tuen umrecht.<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />vorem gich vi groz veln zei farshnitn vern,</para>
  <para style="q" vid="PSA 37:2">un vi grine kraitechts veln zei farvelkt vern.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />farzicher zich oif Hashem, un tu guts,</para>
  <para style="q" vid="PSA 37:3">zits ruik in land, un hit op vorhaftikeit,<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />un kvik zich mit Hashem,</para>
  <para style="q" vid="PSA 37:4">un er vet dir gebn di farlangen fun dain hartsn.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />farloz oif Hashem dain veg,</para>
  <para style="q" vid="PSA 37:5">un farzicher zich oif im, un er vet ton.<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />un er vet aroisbrengen vi dos licht dain gerechtikeit,</para>
  <para style="q" vid="PSA 37:6">un dain mishpot vi der mitn tog.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />har tsu Hashem, un hof tsu im,</para>
  <para style="q" vid="PSA 37:7">zolst zich nisht ergern vegen dem vos iz matsliech oif zain veg,</para>
  <para style="q" vid="PSA 37:7">vegen dem man vos tut listikeitn.<verse eid="PSA 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />loz op fun kaas, un farloz grimtsorn;</para>
  <para style="q" vid="PSA 37:8">zolst zich nisht ergern; dos firt bloiz tsum beizn.<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />vorem di shlechtstuer veln farshnitn vern,</para>
  <para style="q" vid="PSA 37:9">un di vos hofn tsu Hashem, zei veln arben dos land.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />un noch a klein vaile, un der roshe vet nisht zain,</para>
  <para style="q" vid="PSA 37:10">un vest zich umkukn oif zain ort, un er iz nishto.<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />ober di gedrikte veln arben dos land,</para>
  <para style="q" vid="PSA 37:11">un veln zich kvikn mit grois frid.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />der roshe tracht beiz kegen tsadik,</para>
  <para style="q" vid="PSA 37:12">un er kritst oif im zaine tsein.<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />Adonoi lacht fun im,</para>
  <para style="q" vid="PSA 37:13">vorem er zet az zain tog vet kumen.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />di reshoim tsien arois di shverd,</para>
  <para style="q" vid="PSA 37:14">un shpanen zeyer boign,</para>
  <para style="q" vid="PSA 37:14">tsu machn faln dem oreman un dem evyon,</para>
  <para style="q" vid="PSA 37:14">tsu shechtn di vos zeyer veg iz glaich.<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />vet zeyer shverd arain in zeyer hartsn,</para>
  <para style="q" vid="PSA 37:15">un zeyere boigns veln tsebrochn vern.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />beser dos bisel baim tsadik,</para>
  <para style="q" vid="PSA 37:16">eider di shefe fun fil reshoim.<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />vorem di orems fun di reshoim veln tsebrochn vern,</para>
  <para style="q" vid="PSA 37:17">ober di tsadikim lent unter Hashem.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />Hashem merkt di teg fun di umshuldike,</para>
  <para style="q" vid="PSA 37:18">un zeyer arav vet zain oif eibik.<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />zei veln nisht farshemt vern in tsait fun beiz,</para>
  <para style="q" vid="PSA 37:19">un in teg fun hunger veln zei zat zain.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />vorem di reshoim veln untergein,</para>
  <para style="q" vid="PSA 37:20">un di faint fun Hashem</para>
  <para style="q" vid="PSA 37:20">azoi vi kestleche fete shof;</para>
  <para style="q" vid="PSA 37:20">zei fargeyen, in roich fargeyen zei.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />der roshe lait un batsolt nisht,</para>
  <para style="q" vid="PSA 37:21">un der tsadik laitzelikt un git.<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />vorem zaine gebentshte arben dos land,</para>
  <para style="q" vid="PSA 37:22">un zaine farsholtene vern farshnitn.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />fun Hashem vern ongeshtelt di trit fun mentshn,</para>
  <para style="q" vid="PSA 37:23">un er bavilikt zain veg.<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />az er falt, blaibt er nisht lign,</para>
  <para style="q" vid="PSA 37:24">vorem Hashem lent unter zain hant.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />ich bin yung geven un bin alt gevorn,</para>
  <para style="q" vid="PSA 37:25">un ich hob nisht gezen a tsadik farlozen,</para>
  <para style="q" vid="PSA 37:25">un zain zomen betlendik broit.<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />a gantsn tog iz er laitzelik un antlait,</para>
  <para style="q" vid="PSA 37:26">un zain zomen iz a bentshung.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />ker zich op fun shlechts, un tu guts,</para>
  <para style="q" vid="PSA 37:27">un blaib ruen oif eibik.<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />vorem Hashem hot lib gerechtikeit,</para>
  <para style="q" vid="PSA 37:28">un farlozt nisht zaine frume;</para>
  <para style="q" vid="PSA 37:28">eibik vern zei opgehit,</para>
  <para style="q" vid="PSA 37:28">ober der zomen fun di reshoim vert farshnitn.<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />di tsadikim veln arben dos land,</para>
  <para style="q" vid="PSA 37:29">un veln voinen deroif shtendik.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />dos moil fun dem tsadik lozt arois chochme,</para>
  <para style="q" vid="PSA 37:30">un zain tsung redt gerechtikeit.<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />di toyre fun zain G-t iz in zain hartsn,</para>
  <para style="q" vid="PSA 37:31">zaine trit glitshn zich nisht ois.<verse eid="PSA 37:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />der roshe kukt ois oifn tsadik,</para>
  <para style="q" vid="PSA 37:32">un zucht im tsu teitn.<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />Hashem vet im nisht iberlozen in zain hant,</para>
  <para style="q" vid="PSA 37:33">un nisht lozn im shuldik machn, az er vert gemishpet.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />hof tsu Hashem, un hit zain veg,</para>
  <para style="q" vid="PSA 37:34">un er vet dich derheibn tsu arben dos land;</para>
  <para style="q" vid="PSA 37:34">vest tsuzen vi di reshoim vern farshnitn.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />ich hob gezen dem roshe machtik,</para>
  <para style="q" vid="PSA 37:35">un tseshpreit vi a tsvaighaftiker altgezesener boim;<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />ober me iz farbaigegangen,</para>
  <para style="q" vid="PSA 37:36">ersht er iz nishto,</para>
  <para style="q" vid="PSA 37:36">un ich hob im gezucht,</para>
  <para style="q" vid="PSA 37:36">un er iz nisht geven tsu gefinen.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />batracht dem umshuldikn, un ze dem rechtfartikn,</para>
  <para style="q" vid="PSA 37:37">az der sof fun itlechn iz a gliklecher.<verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />un di farbrecher vern fartilikt in einem,</para>
  <para style="q" vid="PSA 37:38">der sof fun di reshoim vert farshnitn.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />ober di hilf fun di tsadikim iz fun Hashem,</para>
  <para style="q" vid="PSA 37:39">zeyer festung in tsait fun noit.<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />un Hashem shteit zei bai, un macht zei antrinen,</para>
  <para style="q" vid="PSA 37:40">er macht zei antrinen fun di reshoim, un helft zei,</para>
  <para style="q" vid="PSA 37:40">vail zei hobn zich geshitst in im.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" pubnumber="לח" sid="PSA 38" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 38:1" />a mizmor fun Dovidn, oif a dermonung.<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 38:2" /> nisht in dain kaas, Hashem, zolstu mich musern,</para>
  <para style="q" vid="PSA 38:2">un in dain grimtsorn zolstu mich shtrofn.<verse eid="PSA 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 38:3" /> vorem daine failn hobn genidert in mir,</para>
  <para style="q" vid="PSA 38:3">un oif mir hot genidert dain hant.<verse eid="PSA 38:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 38:4" /> nishto kein gants glid in main laib</para>
  <para style="q" vid="PSA 38:4">fun vegen dain tsorn,</para>
  <para style="q" vid="PSA 38:4">nishto kein frid in maine beiner</para>
  <para style="q" vid="PSA 38:4">fun vegen main chet.<verse eid="PSA 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 38:5" /> vorem maine zind geyen iber main kop,</para>
  <para style="q" vid="PSA 38:5">vi a shvere mase zainen zei tsu shver far mir.<verse eid="PSA 38:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 38:6" /> es foiln, es aitern maine vundn</para>
  <para style="q" vid="PSA 38:6">fun vegen main narishkeit;<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 38:7" /> ich bin tsekrimt, ich bin geboign biz gor,</para>
  <para style="q" vid="PSA 38:7">a gantsn tog gei ich um fintster.<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 38:8" /> vorem maine lendn zainen ful mit brand,</para>
  <para style="q" vid="PSA 38:8">un nishto kein gants glid in main laib.<verse eid="PSA 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 38:9" /> ich bin banumen un dershlogn biz gor,</para>
  <para style="q" vid="PSA 38:9">ich shrai fun der brumung fun main hartsn.<verse eid="PSA 38:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 38:10" /> Adonoi, al main krechtsn iz far dir,</para>
  <para style="q" vid="PSA 38:10">un main ziftsn iz fun dir nisht farborgen.<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 38:11" /> main harts shvindlt,</para>
  <para style="q" vid="PSA 38:11">main koiech hot mich farlozt;</para>
  <para style="q" vid="PSA 38:11">un dos licht fun maine oign,</para>
  <para style="q" vid="PSA 38:11">dos oich iz bai mir mer nishto.<verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 38:12" /> maine gute fraint un maine chaverim</para>
  <para style="q" vid="PSA 38:12">shteyen avek fun main plog,</para>
  <para style="q" vid="PSA 38:12">un maine nonte shteyen fun der vaitn.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 38:13" /> un netsn leign di vos zuchn main lebn,</para>
  <para style="q" vid="PSA 38:13">un di vos zainen mir oisn beiz redn umglikn,</para>
  <para style="q" vid="PSA 38:13">un batrugn trachtn zei a gantsn tog.<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 38:14" /> un ich bin vi a toiber, ich her nisht,</para>
  <para style="q" vid="PSA 38:14">un vi a shtumer vos efent nisht zain moil.<verse eid="PSA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 38:15" /> yo, ich bin vi a mentsh vos hert nisht,</para>
  <para style="q" vid="PSA 38:15">un in zain moil zainen kein tainus nishto.<verse eid="PSA 38:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 38:16" /> vorem tsu dir, Hashem, tu ich hofn;</para>
  <para style="q" vid="PSA 38:16">du vest entfern, Adonoi main G-t.<verse eid="PSA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 38:17" /> vorem ich zog:</para>
  <para style="q" vid="PSA 38:17">zoln zei nisht derfreit vern iber mir;</para>
  <para style="q" vid="PSA 38:17">az main fus glitsht zich ois,</para>
  <para style="q" vid="PSA 38:17">greisn zei zich iber mir.<verse eid="PSA 38:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 38:18" /> vorem ich bin ongebreit tsum faln,</para>
  <para style="q" vid="PSA 38:18">un main veitog iz antkegen mir tamid.<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 38:19" /> vorem ich gib tsu main zind,</para>
  <para style="q" vid="PSA 38:19">ich bin bakumert vegen main chet.<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 38:20" /> un maine faint um lebn zainen shtark,</para>
  <para style="q" vid="PSA 38:20">un fil maine sonem far gornisht.<verse eid="PSA 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 38:21" /> un di vos batsoln a roeh far a toive,</para>
  <para style="q" vid="PSA 38:21">faintn mich far main nochyogn guts.<verse eid="PSA 38:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 38:22" /> nisht farlozen zolstu mich, Hashem,</para>
  <para style="q" vid="PSA 38:22">nisht dervaitern zolstu zich fun mir, main G-t.<verse eid="PSA 38:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 38:23" /> ail mir tsu hilf,</para>
  <para style="q" vid="PSA 38:23">Adonoi main yeshue.<verse eid="PSA 38:23" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" pubnumber="לט" sid="PSA 39" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 39:1" />far dem gezangmaister, far Yedutun; a mizmor fun Dovidn.<verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 39:2" /> ich hob gezogt: ich vel hitn maine vegen</para>
  <para style="q" vid="PSA 39:2">fun tsu zindikn mit main tsung;</para>
  <para style="q" vid="PSA 39:2">ich vel haltn a shlos oif main moil,</para>
  <para style="q" vid="PSA 39:2">beeis der roshe iz far mir.<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 39:3" /> ich bin shtil antshtumt geven,</para>
  <para style="q" vid="PSA 39:3">ich hob geshvigen, on guts,</para>
  <para style="q" vid="PSA 39:3">un main veitog iz geven aingehaltn.<verse eid="PSA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 39:4" /> iz main harts in mir heis gevorn,</para>
  <para style="q" vid="PSA 39:4">hot in main gemit zich a faier tsebrent;</para>
  <para style="q" vid="PSA 39:4">hob ich geredt mit main tsung:<verse eid="PSA 39:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 39:5" /> loz mich visen, Hashem, main sof,</para>
  <para style="q" vid="PSA 39:5">un di mos fun maine teg, vos zi iz,</para>
  <para style="q" vid="PSA 39:5">lomich visen vi fargEik ich bin.<verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 39:6" /> ze, vi a shpan hostu gemacht maine teg,</para>
  <para style="q" vid="PSA 39:6">un main gedoier iz vi gornisht kegen dir;</para>
  <para style="q" vid="PSA 39:6">far vor, a bloizer hoich vos bashteit iz itlecher mentsh.</para>
  <para style="q" vid="PSA 39:6">Selah.<verse eid="PSA 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 39:7" /> bloiz vi an opducht geit um der mentsh,</para>
  <para style="q" vid="PSA 39:7">bloiz umnisht tumlen zei;</para>
  <para style="q" vid="PSA 39:7">er klaibt, un er veis nisht ver dos vet ainzamlen.<verse eid="PSA 39:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 39:8" /> un atsund, vos zol ich hofn, o Adonoi?</para>
  <para style="q" vid="PSA 39:8">maine hofenung iz tsu dir.<verse eid="PSA 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 39:9" /> zai mich matsl fun ale maine farbrechn;</para>
  <para style="q" vid="PSA 39:9">zolst mich nisht machn tsum shpot fun dem nidertrechtikn.<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 39:10" /> ich bin shtum, ich efen nisht main moil,</para>
  <para style="q" vid="PSA 39:10">vorem du host es geton.<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 39:11" /> tu op fun mir dain plog,</para>
  <para style="q" vid="PSA 39:11">fun dem shtrait fun dain hant ver ich farlendt.<verse eid="PSA 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 39:12" /> volstu mit shtrofreid gemusert dem mentshn far zind!</para>
  <para style="q" vid="PSA 39:12">ober machst tsekrichn vi moil zain sheinkeit.</para>
  <para style="q" vid="PSA 39:12">bloiz a hoich iz itlecher mentsh.</para>
  <para style="q" vid="PSA 39:12">Selah.<verse eid="PSA 39:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 39:13" /> her tsu main tfile, Hashem, un main geshrei farnem;</para>
  <para style="q" vid="PSA 39:13">oif main trer zolstu nisht shvaign;</para>
  <para style="q" vid="PSA 39:13">vorem a fremder bin ich bai dir,</para>
  <para style="q" vid="PSA 39:13">an aingevanderter vi ale maine eltern.<verse eid="PSA 39:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 39:14" /> kuk avek fun mir, un lomich zich oifmuntern,</para>
  <para style="q" vid="PSA 39:14">eider ich vel avekgein un mer nisht zain.<verse eid="PSA 39:14" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" pubnumber="מ" sid="PSA 40" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 40:1" />far dem gezangmaister; fun Dovidn a mizmor.<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 40:2" /> hofn gehoft hob ich oif Hashem,</para>
  <para style="q" vid="PSA 40:2">un er hot zich geneigt tsu mir,</para>
  <para style="q" vid="PSA 40:2">un tsugehert main geshrei.<verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 40:3" /> un er hot mich aroifgebracht fun der vister grub,</para>
  <para style="q" vid="PSA 40:3">fun dem zumpikn leim,</para>
  <para style="q" vid="PSA 40:3">un er hot geshtelt oif a feldz maine fis,</para>
  <para style="q" vid="PSA 40:3">er hot bafestikt maine trit.<verse eid="PSA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 40:4" /> un er hot gegebn in main moil a nai gezang,</para>
  <para style="q" vid="PSA 40:4">a loib tsu Elokeinu.</para>
  <para style="q" vid="PSA 40:4">fil veln zen un veln forchtn,</para>
  <para style="q" vid="PSA 40:4">un veln zich farzichern oif Hashem.<verse eid="PSA 40:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 40:5" /> gebentsht iz der mentsh vos hot gemacht Hashem zain farzicherung,</para>
  <para style="q" vid="PSA 40:5">un zich nisht gevendt tsu di hoferdike,</para>
  <para style="q" vid="PSA 40:5">un tsu di vos kern zich op tsu falshkeit.<verse eid="PSA 40:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 40:6" /> fil hostu oifgeton, Hashem main G-t –</para>
  <para style="q" vid="PSA 40:6">daine vunder un daine trachtungen</para>
  <para style="q" vid="PSA 40:6">fun undzerent vegen;</para>
  <para style="q" vid="PSA 40:6">nishto kein glaichn tsu dir.</para>
  <para style="q" vid="PSA 40:6">zol ich dertseiln un zogn,</para>
  <para style="q" vid="PSA 40:6">zainen zei tsu fil oistsurechenen.<verse eid="PSA 40:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 40:7" /> shlachtopfer un shpaizopfer host du nisht farlangt,</para>
  <para style="q" vid="PSA 40:7">ober maine oiern hostu du oifgemacht –</para>
  <para style="q" vid="PSA 40:7">brandopfer un zindopfer farlangstu nisht.<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 40:8" /> derum hob ich gezogt: ze, ich bin gekumen,</para>
  <para style="q" vid="PSA 40:8">in di megale fun dem sefer iz vegen mir geshribn.<verse eid="PSA 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 40:9" /> tsu ton dain rotsn, main G-t, hob ich bagert,</para>
  <para style="q" vid="PSA 40:9">un dain toyre iz in maine ingeveid.<verse eid="PSA 40:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 40:10" /> ich hob mevaser zain gerechtikeit in a grois gezeml;</para>
  <para style="q" vid="PSA 40:10">ze, maine lipn tu ich nisht farmaidn;</para>
  <para style="q" vid="PSA 40:10">Hashem, du veist doch.<verse eid="PSA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 40:11" /> dain gerechtikeit hob ich nisht fardekt in main hartsn,</para>
  <para style="q" vid="PSA 40:11">dain traishaft un dain hilf hob ich dertseilt;</para>
  <para style="q" vid="PSA 40:11">ich hob nisht farhoiln dain genod</para>
  <para style="q" vid="PSA 40:11">un dain emes faran groisn gezeml.<verse eid="PSA 40:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 40:12" /> nisht farmaidn zolstu du, Hashem, dain derbaremung fun mir,</para>
  <para style="q" vid="PSA 40:12">dain genod un dain emes zoln mich tamid bahitn.<verse eid="PSA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 40:13" /> vorem arumgeringlt hobn mich beizn azh on tsol,</para>
  <para style="q" vid="PSA 40:13">dergreicht hobn mich maine zind,</para>
  <para style="q" vid="PSA 40:13">az ich ken nisht zen;</para>
  <para style="q" vid="PSA 40:13">zei zainen mer vi di hor fun main kop,</para>
  <para style="q" vid="PSA 40:13">un main harts hot mich farlozen.<verse eid="PSA 40:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 40:14" /> bavilik, Hashem, mich matsl tsu zain,</para>
  <para style="q" vid="PSA 40:14">Hashem, ail mir tsu hilf.<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 40:15" /> zol farshemt un tsu shand vern in einem</para>
  <para style="q" vid="PSA 40:15">di vos zuchn main lebn, es umtsubrengen;</para>
  <para style="q" vid="PSA 40:15">zoln optretn ahinter un zich shemen</para>
  <para style="q" vid="PSA 40:15">di vos vintshn mir beiz.<verse eid="PSA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 40:16" /> zoln banumen vern fun vegen zeyer shand</para>
  <para style="q" vid="PSA 40:16">di vos zogn oif mir: aha! aha!<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 40:17" /> zoln zain lustik un zich freyen mit dir</para>
  <para style="q" vid="PSA 40:17">ale vos zuchn dich;</para>
  <para style="q" vid="PSA 40:17">zoln tamid zogn: gegreist zol zain Hashem!</para>
  <para style="q" vid="PSA 40:17">di vos hobn lib dain yeshue.<verse eid="PSA 40:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 40:18" /> un ich orimer un baderftiker –</para>
  <para style="q" vid="PSA 40:18">zol Adonoi dos mir tsurechenen.</para>
  <para style="q" vid="PSA 40:18">du bist main hilf, un der vos macht mich antrinen;</para>
  <para style="q" vid="PSA 40:18">o main G-t, zolst zich nisht zamen.<verse eid="PSA 40:18" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" pubnumber="מא" sid="PSA 41" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 41:1" />far dem gezangmaister; a mizmor fun Dovidn.<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 41:2" /> voil tsu dem vos git acht oifn oreman!</para>
  <para style="q" vid="PSA 41:2">in tog fun beiz vet im Hashem machn antrinen.<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 41:3" /> Hashem vet im bahitn un im lozn lebn,</para>
  <para style="q" vid="PSA 41:3">un er vet zain baglikt in land;</para>
  <para style="q" vid="PSA 41:3">un vest im nisht ibergebn</para>
  <para style="q" vid="PSA 41:3">oif dem barot fun zaine faint.<verse eid="PSA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 41:4" /> Hashem vet im unterlenen oifn krankn bet;</para>
  <para style="q" vid="PSA 41:4">di gantse tsait fun zain lign farnemstu zich mit zain krankshaft.<verse eid="PSA 41:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 41:5" /> ich zog: Hashem, laitzelik mich,</para>
  <para style="q" vid="PSA 41:5">heil main zel, vorem ich hob gezindikt tsu dir.<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 41:6" /> maine faint redn shlechts vegen mir:</para>
  <para style="q" vid="PSA 41:6">ven vet er shtarbn, un zain nomen zol untergein!<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 41:7" /> un az emetser kumt zen, redt er falsh,</para>
  <para style="q" vid="PSA 41:7">zain harts zamlt on in zich beiz;</para>
  <para style="q" vid="PSA 41:7">geit er arois in gas, redt er derfun.<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 41:8" /> in einem soden zich oif mir ale maine sonem,</para>
  <para style="q" vid="PSA 41:8">zei trachtn vegen mir beiz kegen mir:<verse eid="PSA 41:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 41:9" /> a beize zach iz oisgegosen oif im,</para>
  <para style="q" vid="PSA 41:9">un vi er hot zich geleigt, vet er mer nisht oifshtein.<verse eid="PSA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 41:10" /> afile main guter fraint vos ich hob mich farzichert oif im,</para>
  <para style="q" vid="PSA 41:10">der vos est main broit, heibt oif a fus oif mir.<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 41:11" /> ober du Hashem laitzelik mich,</para>
  <para style="q" vid="PSA 41:11">un richt mich oif, un lomich zei optsolen.<verse eid="PSA 41:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 41:12" /> dermit vel ich visen az du bagerst mich,</para>
  <para style="q" vid="PSA 41:12">vos nisht shaln vet main faint iber mir.<verse eid="PSA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 41:13" /> un ich – in main erlechkeit vestu mich oifhaltn,</para>
  <para style="q" vid="PSA 41:13">un vestu mich lozn shtein far dir eibik.<verse eid="PSA 41:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 41:14" /> Baruch Hashem Elokei Yisroel</para>
  <para style="q" vid="PSA 41:14">fun eibik un biz eibik.</para>
  <para style="q" vid="PSA 41:14">Omein un Omein!<verse eid="PSA 41:14" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" pubnumber="מב" sid="PSA 42" />
  <para style="ms">tsveiter sefer</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 42:1" />far dem gezangmaister; a batrachtung fun di kinder fun Korach.<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 42:2" /> vi a hind lechtst noch bechn vaser,</para>
  <para style="q" vid="PSA 42:2">azoi lechtst main zel noch dir, Elokim.<verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 42:3" /> main zel tut dorshtn noch Elokim,</para>
  <para style="q" vid="PSA 42:3">noch dem lebedikn El:</para>
  <para style="q" vid="PSA 42:3">ven vel ich kumen, un zich vaizn far Elokim?<verse eid="PSA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 42:4" /> main trer iz gevorn main shpaiz tog un nacht,</para>
  <para style="q" vid="PSA 42:4">az me zogt mir a gantsn tog:</para>
  <para style="q" vid="PSA 42:4">vu iz dain G-t?<verse eid="PSA 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 42:5" /> dos tu ich dermonen,</para>
  <para style="q" vid="PSA 42:5">un gis ois main zel in mir:</para>
  <para style="q" vid="PSA 42:5">vi ich fleg durchgein mit an oilem,</para>
  <para style="q" vid="PSA 42:5">zei firn tsum hoiz fun Elokim</para>
  <para style="q" vid="PSA 42:5">mit a kol fun gezang un loib,</para>
  <para style="q" vid="PSA 42:5">a yom-tuvdik gezeml.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 42:6" /> vos bistu geboign main zel,</para>
  <para style="q" vid="PSA 42:6">un tust brumen in mir?</para>
  <para style="q" vid="PSA 42:6">hof tsu Elokim, vorem ich vel im noch loibn</para>
  <para style="q" vid="PSA 42:6">far der hilf fun zain ponem.<verse eid="PSA 42:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 42:7" /> main G-t, main zel iz geboign in mir,</para>
  <para style="q" vid="PSA 42:7">vorem ich tu dich dermonen,</para>
  <para style="q" vid="PSA 42:7">fun Yarden-land un di Chermons,</para>
  <para style="q" vid="PSA 42:7">fun dem barg Mitsar.<verse eid="PSA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 42:8" /> tehom tsu tehom tut rufn</para>
  <para style="q" vid="PSA 42:8">in dem kol fun daine vaserfaln;</para>
  <para style="q" vid="PSA 42:8">ale daine indn un daine veln</para>
  <para style="q" vid="PSA 42:8">zainen ariber oif mir.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 42:9" /> bai tog bafelt Hashem zain chesed,</para>
  <para style="q" vid="PSA 42:9">un bai nacht iz zain gezang mit mir,</para>
  <para style="q" vid="PSA 42:9">a tfile tsu dem El fun main lebn.<verse eid="PSA 42:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 42:10" /> ich zog tsu El main feldz:</para>
  <para style="q" vid="PSA 42:10">far vos hostu mich fargesen?</para>
  <para style="q" vid="PSA 42:10">far vos muz ich fintster umgein</para>
  <para style="q" vid="PSA 42:10">fun vegen der drikung fun soine?<verse eid="PSA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 42:11" /> mit retsiche azh in maine beiner</para>
  <para style="q" vid="PSA 42:11">lestern mich maine faint,</para>
  <para style="q" vid="PSA 42:11">az zei zogn tsu mir a gantsn tog:</para>
  <para style="q" vid="PSA 42:11">vu iz dain G-t?<verse eid="PSA 42:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 42:12" /> vos bistu geboign main zel,</para>
  <para style="q" vid="PSA 42:12">un vos tustu brumen in mir?</para>
  <para style="q" vid="PSA 42:12">hof tsu Elokim, vorem ich vel im noch loibn –</para>
  <para style="q" vid="PSA 42:12">di hilf fun main ponem, un main G-t.<verse eid="PSA 42:12" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" pubnumber="מג" sid="PSA 43" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />tu mir recht, Elokim,</para>
  <para style="q" vid="PSA 43:1">un krig main krig kegen folk umderbaremdik;</para>
  <para style="q" vid="PSA 43:1">fun dem man fun batrug un umrecht</para>
  <para style="q" vid="PSA 43:1">zolstu mich machn antrinen.<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />du bist doch der Elokim fun main shtarkeit,</para>
  <para style="q" vid="PSA 43:2">far vos hostu mich farlozen?</para>
  <para style="q" vid="PSA 43:2">far vos muz ich fintster umgein</para>
  <para style="q" vid="PSA 43:2">fun vegen der drikung fun soine?<verse eid="PSA 43:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />shik dain licht un dain emes,</para>
  <para style="q" vid="PSA 43:3">zei zoln mich firn;</para>
  <para style="q" vid="PSA 43:3">zei zoln mich brengen tsu dain heilikn barg,</para>
  <para style="q" vid="PSA 43:3">un tsu di voinungen daine.<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />un lomich kumen tsum mizbeyech fun Elokim,</para>
  <para style="q" vid="PSA 43:4">tsu El, der freid fun main lustikeit;</para>
  <para style="q" vid="PSA 43:4">un lomich dich loibn oif a harf,</para>
  <para style="q" vid="PSA 43:4">Elokim main G-t.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />vos bistu geboign main zel,</para>
  <para style="q" vid="PSA 43:5">un vos tustu brumen in mir?</para>
  <para style="q" vid="PSA 43:5">hof tsu Elokim, vorem ich vel im noch loibn –</para>
  <para style="q" vid="PSA 43:5">di hilf fun main ponem, un main G-t.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" pubnumber="מד" sid="PSA 44" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 44:1" />far dem gezangmaister; fun di kinder fun Korach a batrachtung.<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 44:2" /> Elokim, mit undzere oiern hobn mir gehert,</para>
  <para style="q" vid="PSA 44:2">undzere eltern hobn undz dertseilt,</para>
  <para style="q" vid="PSA 44:2">di tuung vos du host geton in zeyere teg,</para>
  <para style="q" vid="PSA 44:2">in di teg fun fartsaitn.<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 44:3" /> du mit dain hant host felker fartriben,</para>
  <para style="q" vid="PSA 44:3">un zei hostu aingeflantst,</para>
  <para style="q" vid="PSA 44:3">host tsebrochn umes,</para>
  <para style="q" vid="PSA 44:3">un zei host du avekgeshikt.<verse eid="PSA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 44:4" /> vorem nisht mit zeyer shverd hobn zei gearbt dos land,</para>
  <para style="q" vid="PSA 44:4">un nisht zeyer orem hot zei geholfn,</para>
  <para style="q" vid="PSA 44:4">nor dain rechte hant un dain orem,</para>
  <para style="q" vid="PSA 44:4">un dos licht fun dain ponem,</para>
  <para style="q" vid="PSA 44:4">vail du host zei bavilikt.<verse eid="PSA 44:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 44:5" /> du bist main kinig, Elokim;</para>
  <para style="q" vid="PSA 44:5">bafel di yeshue fun Yaakov.<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 44:6" /> mit dir shtoisn mir undzere faint,</para>
  <para style="q" vid="PSA 44:6">mit dain nomen tsetretn mir undzere kegnshteyer.<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 44:7" /> vorem nisht oif main boign farzicher ich mich,</para>
  <para style="q" vid="PSA 44:7">un main shverd ken mich nisht helfn.<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 44:8" /> naiert du host undz geholfn fun undzere faint,</para>
  <para style="q" vid="PSA 44:8">un undzere sonem tsu shand gemacht.<verse eid="PSA 44:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 44:9" /> mit Elokim hobn mir zich gerimt a gantsn tog,</para>
  <para style="q" vid="PSA 44:9">un dain nomen loibn mir eibik.</para>
  <para style="q" vid="PSA 44:9">Selah.<verse eid="PSA 44:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 44:10" /> ober host farlozen un farshemt undz,</para>
  <para style="q" vid="PSA 44:10">un gaist nisht arois mit undzere machnus.<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 44:11" /> machst undz tsurikgein faran faint,</para>
  <para style="q" vid="PSA 44:11">un undzere sonem roibn zich on.<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 44:12" /> host undz opgegebn vi shof tsum esen,</para>
  <para style="q" vid="PSA 44:12">un tsvishn di felker hostu undz tseshpreit.<verse eid="PSA 44:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 44:13" /> host farkoift dain ume far shpotgelt,</para>
  <para style="q" vid="PSA 44:13">un host nisht hoich geshtelt zeyer mekch.<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 44:14" /> machst undz tsu charpe bai undzere shecheynim,</para>
  <para style="q" vid="PSA 44:14">a gelechter un a shpot bai undzere arumike.<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 44:15" /> machst undz far a shprichvort tsvishn di felker,</para>
  <para style="q" vid="PSA 44:15">a kopshoklenish tsvishn di umes.<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 44:16" /> a gantsn tog iz main shand antkegen mir,</para>
  <para style="q" vid="PSA 44:16">un di bushe fun main ponem hot mich badekt,<verse eid="PSA 44:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 44:17" /> fun kol fun dem lesterer un shender,</para>
  <para style="q" vid="PSA 44:17">fun vegen dem faint un dem rachenemer.<verse eid="PSA 44:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 44:18" /> dos alts iz gekumen oif undz,</para>
  <para style="q" vid="PSA 44:18">ober mir hobn nisht fargesen on dir,</para>
  <para style="q" vid="PSA 44:18">un nisht geleiknt on dain bris.<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 44:19" /> nisht opgekert ahinter hot zich undzer harts,</para>
  <para style="q" vid="PSA 44:19">az undzere trit zoln zich opnaign fun dain shteg;<verse eid="PSA 44:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 44:20" /> hagam du host undz farshtoisen in an ort fun shakaln,</para>
  <para style="q" vid="PSA 44:20">un undz ibergedekt mit toitshotn.<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 44:21" /> oib mir voltn fargesen on dem nomen fun Elokeinu,</para>
  <para style="q" vid="PSA 44:21">un oisgeshpreit undzere hent tsu a fremdn G-t,<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 44:22" /> volt den Elokim dos nisht oisforshn?</para>
  <para style="q" vid="PSA 44:22">vorem er veis di farborgenishn fun hartsn.<verse eid="PSA 44:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 44:23" /> yo, iber dir vern mir geharget a gantsn tog,</para>
  <para style="q" vid="PSA 44:23">mir vern gerechnt vi shof tsu der shechite.<verse eid="PSA 44:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 44:24" /> dervek dich, far vos shlofstu, o Adonoi?</para>
  <para style="q" vid="PSA 44:24">vach oif, zolst undz nisht farlozen oif eibik.<verse eid="PSA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 44:25" /> far vos farborgstu dain ponem,</para>
  <para style="q" vid="PSA 44:25">fargest undzer pain un undzer klem?<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 44:26" /> vorem geboign tsum shtoib iz undzer zel,</para>
  <para style="q" vid="PSA 44:26">baheft tsu der erd iz undzer laib.<verse eid="PSA 44:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 44:27" /> shtei oif undz tsu hilf,</para>
  <para style="q" vid="PSA 44:27">un leiz undz ois fun vegen dain genod.<verse eid="PSA 44:27" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" pubnumber="מה" sid="PSA 45" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 45:1" />far dem gezangmaister; oif Sheshanim, fun di kinder fun Korach; a batrachtung, a gezang fun libshaft.<verse eid="PSA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 45:2" /> es yirt main harts mitn sheinem vort,</para>
  <para style="q" vid="PSA 45:2">ich vel firzogn maine lider tsum melech;</para>
  <para style="q" vid="PSA 45:2">main tsung iz di pen</para>
  <para style="q" vid="PSA 45:2">fun a shraiber a flinkn.<verse eid="PSA 45:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 45:3" /> bist shener fun ale mentshnkinder,</para>
  <para style="q" vid="PSA 45:3">chein iz oisgegosen oif daine lipn,</para>
  <para style="q" vid="PSA 45:3">vail Elokim hot dich gebentsht oif eibik.<verse eid="PSA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 45:4" /> gurt on dain shverd oifn lend, du gibor,</para>
  <para style="q" vid="PSA 45:4">dain glants un dain pracht.<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 45:5" /> un in dain pracht baglik, rait arois,</para>
  <para style="q" vid="PSA 45:5">fun vegen emes un mildkeit un gerechtikeit,</para>
  <para style="q" vid="PSA 45:5">un zol dir dain rechte hant forchtiks bavaizn.<verse eid="PSA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 45:6" /> daine failn gesharfte –</para>
  <para style="q" vid="PSA 45:6">felker zoln faln unter dir –</para>
  <para style="q" vid="PSA 45:6">in hartsn fun melechs faint!<verse eid="PSA 45:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 45:7" /> dain tron, o Elokim,</para>
  <para style="q" vid="PSA 45:7">iz oif eibik un shtendik,</para>
  <para style="q" vid="PSA 45:7">a tsepter fun yoisher</para>
  <para style="q" vid="PSA 45:7">iz der tsepter fun dain meluche.<verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 45:8" /> host lib gehat gerechtikeit, un faint gehat umrecht,</para>
  <para style="q" vid="PSA 45:8">derum hot dich Elokim, dain G-t, gezalbt</para>
  <para style="q" vid="PSA 45:8">mit eil fun freid, iber daine chaverim.<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 45:9" /> mire un lahen, kaneiln zainen ale daine kleider,</para>
  <para style="q" vid="PSA 45:9">fun helfandbein-palatsn derfreyen dich strunes.<verse eid="PSA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 45:10" /> techter fun mlochim zainen tsvishn daine gelibte,</para>
  <para style="q" vid="PSA 45:10">dir tsu rechts shteit</para>
  <para style="q" vid="PSA 45:10">di malke in gingold fun Ofir.<verse eid="PSA 45:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 45:11" /> her, tochter, un ze, un naig tsu dain oier,</para>
  <para style="q" vid="PSA 45:11">un farges dain folk, un dos hoiz fun dain foter,<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 45:12" /> un der melech vet glustn dain sheinkeit;</para>
  <para style="q" vid="PSA 45:12">vorem er iz dain har, derum buk zich tsu im.<verse eid="PSA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 45:13" /> un, tochter fun Tsor, di raichste fun folk</para>
  <para style="q" vid="PSA 45:13">veln betn dain laitzelikeit mit minche.<verse eid="PSA 45:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 45:14" /> loiter pracht iz di bt-malke ineveinik in palats,</para>
  <para style="q" vid="PSA 45:14">fun gekestltn goldveb ir malbesh.<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 45:15" /> oif geshtikte gevantn vert zi tsum melech gefirt;</para>
  <para style="q" vid="PSA 45:15">hinter ir yungfroin, chavertes ire, vern dir gebracht.<verse eid="PSA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 45:16" /> zei vern gefirt mit freidn un lustikeit,</para>
  <para style="q" vid="PSA 45:16">zei kumen in palats fun melech.<verse eid="PSA 45:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 45:17" /> anshtot daine foters veln zain daine zin;</para>
  <para style="q" vid="PSA 45:17">vest zei oifzetsn far harn in gantsn land.<verse eid="PSA 45:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 45:18" /> ich vel machn dermonen dain nomen oif ale dor-doires,</para>
  <para style="q" vid="PSA 45:18">derum veln felker dich loibn oif eibik un shtendik.<verse eid="PSA 45:18" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" pubnumber="מו" sid="PSA 46" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 46:1" />far dem gezangmaister; fun di kinder fun Korach; oif Alamot; a lid.<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 46:2" /> Elokim iz undz a bashitsung un a shtarkeit,</para>
  <para style="q" vid="PSA 46:2">a hilf in tsores, gring tsu gefinen.<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 46:3" /> derum veln mir nisht moire hobn,</para>
  <para style="q" vid="PSA 46:3">ven di erd zol zich baitn,</para>
  <para style="q" vid="PSA 46:3">un ven di berg zoln umfaln</para>
  <para style="q" vid="PSA 46:3">in hartsn fun yam.<verse eid="PSA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 46:4" /> megn brumen, megn shoimen zaine vasern,</para>
  <para style="q" vid="PSA 46:4">megn tsiteren di berg far zain hoichkeit.</para>
  <para style="q" vid="PSA 46:4">Selah.<verse eid="PSA 46:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 46:5" /> a taich iz do, vos zaine shtromen derfreyen di shtot fun Elokim,</para>
  <para style="q" vid="PSA 46:5">di heilikste voinung fun Elyon.<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 46:6" /> Elokim iz in ir mitn, zi vet nisht umfaln,</para>
  <para style="q" vid="PSA 46:6">Elokim vet zi helfn akegn frimorgn.<verse eid="PSA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 46:7" /> felker hobn getumlt, kinigraichn zainen umgefaln;</para>
  <para style="q" vid="PSA 46:7">er hot aroisgelozt zain kol, tut zich vaklen di erd.<verse eid="PSA 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 46:8" /> mit undz iz Hashem Tseva'ot,</para>
  <para style="q" vid="PSA 46:8">a festung iz undz der Elokei Yaakov.</para>
  <para style="q" vid="PSA 46:8">Selah.<verse eid="PSA 46:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 46:9" /> geit zet di oiftuen fun Hashem,</para>
  <para style="q" vid="PSA 46:9">vos hot gemacht farvistungen in land.<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 46:10" /> er macht oifhern milchomes bizn ek fun der erd,</para>
  <para style="q" vid="PSA 46:10">dem boign tsebrecht er, un tut tsehakn dem shpiz;</para>
  <para style="q" vid="PSA 46:10">raitvegn farbrent er in faier.<verse eid="PSA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 46:11" /> lozt op, un zait visen az ich bin Elokim,</para>
  <para style="q" vid="PSA 46:11">ich bin derhoibn tsvishn di felker,</para>
  <para style="q" vid="PSA 46:11">derhoibn oif der erd.<verse eid="PSA 46:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 46:12" /> Hashem Tseva'ot iz mit undz,</para>
  <para style="q" vid="PSA 46:12">a festung iz undz der Elokei Yaakov.</para>
  <para style="q" vid="PSA 46:12">Selah.<verse eid="PSA 46:12" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" pubnumber="מז" sid="PSA 47" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 47:1" />far dem gezangmaister; fun di kinder fun Korach a mizmor.<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 47:2" /> klapt di hent, ale felker,</para>
  <para style="q" vid="PSA 47:2">shalt tsu Elokim mit a kol fun gezang.<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 47:3" /> vorem Hashem der Elyon iz forchtik,</para>
  <para style="q" vid="PSA 47:3">a groiser melech iber der gantser erd.<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 47:4" /> er untertenikt felker unter undz,</para>
  <para style="q" vid="PSA 47:4">un umes unter undzere fis.<verse eid="PSA 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 47:5" /> er veilt undz ois undzer nachle,</para>
  <para style="q" vid="PSA 47:5">dem herlichkeit fun Yaakov vos er hot lib.</para>
  <para style="q" vid="PSA 47:5">Selah.<verse eid="PSA 47:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 47:6" /> Elokim iz oifgegangen mit shalung,</para>
  <para style="q" vid="PSA 47:6">Hashem mit kol fun shoifer.<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 47:7" /> zingt tsu Elokim, zingt,</para>
  <para style="q" vid="PSA 47:7">zingt tsu undzer melech, zingt.<verse eid="PSA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 47:8" /> vorem Elokim iz der melech fun der gantser erd;</para>
  <para style="q" vid="PSA 47:8">zingt mit batracht.<verse eid="PSA 47:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 47:9" /> Elokim kinigt iber di felker,</para>
  <para style="q" vid="PSA 47:9">Elokim zitst oif zain heilikn tron.<verse eid="PSA 47:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 47:10" /> di firshtn fun di umes hobn zich aingezamlt,</para>
  <para style="q" vid="PSA 47:10">dos folk fun dem Elokim fun Avraham;</para>
  <para style="q" vid="PSA 47:10">vorem tsu Elokim zainen di shildn fun der erd,</para>
  <para style="q" vid="PSA 47:10">er iz zeyer derhoibn.<verse eid="PSA 47:10" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" pubnumber="מח" sid="PSA 48" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 48:1" />a gezang; a mizmor fun di kinder fun Korach.<verse eid="PSA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 48:2" /> grois iz Hashem,</para>
  <para style="q" vid="PSA 48:2">un zeyer geloibt in der shtot fun Elokeinu,</para>
  <para style="q" vid="PSA 48:2">oif zain heilikn barg.<verse eid="PSA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 48:3" /> shein derheicht, di freid fun der gantser erd,</para>
  <para style="q" vid="PSA 48:3">iz der barg Tsiyon in di ekn fun tsofn,</para>
  <para style="q" vid="PSA 48:3">di shtot fun dem groisn melech.<verse eid="PSA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 48:4" /> Elokim in ire tsitadeln</para>
  <para style="q" vid="PSA 48:4">iz bakant far a festung.<verse eid="PSA 48:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 48:5" /> vorem ze, mlochim hobn zich aingezamlt,</para>
  <para style="q" vid="PSA 48:5">zei zainen aribergekumen in einem.<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 48:6" /> vi zei hobn gezen, azoi hobn zei gegaft,</para>
  <para style="q" vid="PSA 48:6">dershrokene hobn zei avekgeailt.<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 48:7" /> a tsiterenish hot zei ongenumen dortn,</para>
  <para style="q" vid="PSA 48:7">a veyenish vi a gevinerin.<verse eid="PSA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 48:8" /> mit a mizrech-vint hostu tsebrochn</para>
  <para style="q" vid="PSA 48:8">di shifn fun Tarshish.<verse eid="PSA 48:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 48:9" /> vi mir hobn gehert, azoi hobn mir gezen,</para>
  <para style="q" vid="PSA 48:9">in der shtot fun Hashem Tseva'ot,</para>
  <para style="q" vid="PSA 48:9">in der shtot fun Elokeinu;</para>
  <para style="q" vid="PSA 48:9">Elokim zol zi oifhaltn biz eibik.</para>
  <para style="q" vid="PSA 48:9">Selah.<verse eid="PSA 48:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 48:10" /> mir hobn getracht, Elokim, on dain chesed,</para>
  <para style="q" vid="PSA 48:10">in der mitn fun dain heichl.<verse eid="PSA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 48:11" /> azoi vi dain nomen, Elokim,</para>
  <para style="q" vid="PSA 48:11">azoi iz dain loib biz di ekn fun der erd;</para>
  <para style="q" vid="PSA 48:11">ful mit gerechtikeit iz dain rechte hant.<verse eid="PSA 48:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 48:12" /> zol zich freyen der barg Tsiyon,</para>
  <para style="q" vid="PSA 48:12">zoln lustik zain di techtershtet fun Yehudah,</para>
  <para style="q" vid="PSA 48:12">fun vegen daine mishpotim.<verse eid="PSA 48:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 48:13" /> geit arum Tsiyon, un ringlt zi arum,</para>
  <para style="q" vid="PSA 48:13">tseilt iber ire turems.<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 48:14" /> tut acht oif ire moier,</para>
  <para style="q" vid="PSA 48:14">geit durch ire palatsn;</para>
  <para style="q" vid="PSA 48:14">kedei ir zolt dertseiln dem shpeterdikn dor,<verse eid="PSA 48:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 48:15" /> az dos iz Elokim, Elokeinu, eibik un shtendik;</para>
  <para style="q" vid="PSA 48:15">er vet undz firn biz eibikeit.<verse eid="PSA 48:15" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" pubnumber="מט" sid="PSA 49" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 49:1" />far dem gezangmaister; fun di kinder fun Korach; a mizmor.<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 49:2" /> hert dos tsu, ale felker,</para>
  <para style="q" vid="PSA 49:2">farnemt, ale bavoiner fun der velt,<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 49:3" /> sai azoi mentshn, sai ongezeene lait,</para>
  <para style="q" vid="PSA 49:3">raich un orim in einem.<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 49:4" /> main moil vet redn chochme,</para>
  <para style="q" vid="PSA 49:4">un di trachtung fun main hartsn vet zain farshtandikeit.<verse eid="PSA 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 49:5" /> ich vel naign tsu a Mashal main oier,</para>
  <para style="q" vid="PSA 49:5">ich vel onheibn mit a harf main retenish.<verse eid="PSA 49:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 49:6" /> far vos zol ich moire hobn in di teg fun beiz,</para>
  <para style="q" vid="PSA 49:6">ven di zind fun maine treter ringlt mich arum?<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 49:7" /> di vos farzichern zich oif zeyer farmeg,</para>
  <para style="q" vid="PSA 49:7">un mit zeyer grois eshires rimen zei zich.<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 49:8" /> nisht oiskoifn a bruder ken a mentsh oiskoifn,</para>
  <para style="q" vid="PSA 49:8">nisht gebn Elokim an oisleiz far zich;<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 49:9" /> un vi verdik es zol zain der oiskoif far zeyer zel,</para>
  <para style="q" vid="PSA 49:9">iz oif eibik farmaidn,<verse eid="PSA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 49:10" /> vos er zol shtendik alts lebn,</para>
  <para style="q" vid="PSA 49:10">er zol nisht onzen di grub.<verse eid="PSA 49:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 49:11" /> vorem me zet az chachomim shtarbn,</para>
  <para style="q" vid="PSA 49:11">azoi vi der nor un der fargrebter geyen unter,</para>
  <para style="q" vid="PSA 49:11">un zei lozn iber tsu andere zeyer farmeg.<verse eid="PSA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 49:12" /> zei trachtn bai zich,</para>
  <para style="q" vid="PSA 49:12">zeyere haizer zainen oif eibik,</para>
  <para style="q" vid="PSA 49:12">zeyere voinungen oif dor-doires;</para>
  <para style="q" vid="PSA 49:12">zei rufn lender oif zeyere nemen.<verse eid="PSA 49:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 49:13" /> ober der mentsh blaibt nisht in gdulh,</para>
  <para style="q" vid="PSA 49:13">er iz geglichn tsu beheimes vos vern farshnitn.<verse eid="PSA 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 49:14" /> dos iz der veg fun di vos zainen batuach bai zich,</para>
  <para style="q" vid="PSA 49:14">un fun zeyere nochgeyer vos kveln fun zeyere reid.</para>
  <para style="q" vid="PSA 49:14">Selah.<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 49:15" /> me leigt zei vi shof in der Sheol,</para>
  <para style="q" vid="PSA 49:15">der toit tut zei fitern;</para>
  <para style="q" vid="PSA 49:15">un ein frimorgn – tretn di rechtfartikn iber zei;</para>
  <para style="q" vid="PSA 49:15">un zeyer geshtalt iz far der Sheol tsum farfoiln,</para>
  <para style="q" vid="PSA 49:15">nishto kein voinung far ir.<verse eid="PSA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 49:16" /> ober Elokim vet oisleizen main zel fun der macht fun Sheol,</para>
  <para style="q" vid="PSA 49:16">vorem er vet mich aroisnemen.</para>
  <para style="q" vid="PSA 49:16">Selah.<verse eid="PSA 49:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 49:17" /> zolst nisht moire hobn az emetser vert an oysher,</para>
  <para style="q" vid="PSA 49:17">az di raichkeit fun zain hoiz vert gemert,<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 49:18" /> vorem bai zain toit vet er gornisht mitnemen,</para>
  <para style="q" vid="PSA 49:18">zain raichkeit vet nisht nidern noch im.<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 49:19" /> hagam bai zain lebn flegt er ainredn zain zel:</para>
  <para style="q" vid="PSA 49:19">me vet dich noch loibn az du vest zich voilton.<verse eid="PSA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 49:20" /> zi vet onkumen tsu dem dor fun zaine eltern,</para>
  <para style="q" vid="PSA 49:20">vos veln oif eibik nisht onzen dem shain.<verse eid="PSA 49:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 49:21" /> a mentsh in gdulh vos farshteit nisht,</para>
  <para style="q" vid="PSA 49:21">iz geglichn tsu beheimes vos vern farshnitn.<verse eid="PSA 49:21" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" pubnumber="נ" sid="PSA 50" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 50:1" />a mizmor fun ASafn.</para>
  <para style="q" vid="PSA 50:1">der El fun g‑ter, Hashem, hot geredt un gerufn di erd,</para>
  <para style="q" vid="PSA 50:1">fun oifgang fun der zun biz ir untergang.<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />fun Tsiyon der kroin fun sheinkeit,</para>
  <para style="q" vid="PSA 50:2">hot aroisgeshaint Elokim.<verse eid="PSA 50:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />Elokeinu kumt, un er shvaigt nisht,</para>
  <para style="q" vid="PSA 50:3">im farois fartsert a faier,</para>
  <para style="q" vid="PSA 50:3">un arum im tut shturemen gevaltik.<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />er ruft tsu di himlen fun oiben,</para>
  <para style="q" vid="PSA 50:4">un tsu der erd, kedei tsu mishpetn zain folk:<verse eid="PSA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />zamlt mir ain maine frume,</para>
  <para style="q" vid="PSA 50:5">di vos shlisn main bris iber shlachtopfer.<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />un di himlen zogn on zain gerechtikeit,</para>
  <para style="q" vid="PSA 50:6">vorem Elokim, er iz a richter.</para>
  <para style="q" vid="PSA 50:6">Selah.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />her main folk, un ich vel redn,</para>
  <para style="q" vid="PSA 50:7">Yisroel, un ich vel dich vorenen:</para>
  <para style="q" vid="PSA 50:7">Elokim dain G-t bin ich.<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />nisht um daine shlachtopfer vel ich dich shtrofn;</para>
  <para style="q" vid="PSA 50:8">daine brandopfer zainen doch tamid far mir.<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />ich vil nisht nemen fun dain hoiz kein oks,</para>
  <para style="q" vid="PSA 50:9">fun daine shtaln kein bek.<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />vorem main iz yetveder chaye fun vald,</para>
  <para style="q" vid="PSA 50:10">di beheimes oif toiznt berg.<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />ich ken yetveder foigel fun di berg,</para>
  <para style="q" vid="PSA 50:11">un di vidmenung fun feld iz bai mir.<verse eid="PSA 50:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />az ich zol hungerik zain, vel ich dir nisht zogn,</para>
  <para style="q" vid="PSA 50:12">vorem main iz di velt un ir fulkeit.<verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />tsi es ich dos fleish fun oksen?</para>
  <para style="q" vid="PSA 50:13">oder dos blut fun bek tu ich trinken?<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />shlacht tsu Elokim a dankopfer,</para>
  <para style="q" vid="PSA 50:14">un batsol Elyon Oibershter daine nedrim.<verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />un ruf mich in tog fun noit,</para>
  <para style="q" vid="PSA 50:15">vel ich dich derleizn, un du vest mich erlechn.<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />un tsum roshe hot Elokim gezogt:</para>
  <para style="q" vid="PSA 50:16">vi kumstu tsu dertseiln maine gezetsn,</para>
  <para style="q" vid="PSA 50:16">un nemen main bris oif dain moil?<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />az du host faint musar,</para>
  <para style="q" vid="PSA 50:17">un host gevorfn maine verter hinter dir.<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />az du host gezen a ganev,</para>
  <para style="q" vid="PSA 50:18">hostu zich gefraintlt mit im,</para>
  <para style="q" vid="PSA 50:18">un mit nofim iz geven dain teil.<verse eid="PSA 50:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />dain moil hostu loiz gelozt tsum beizn,</para>
  <para style="q" vid="PSA 50:19">un dain tsung flecht batrug.<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />zitsstu, baredstu dain bruder,</para>
  <para style="q" vid="PSA 50:20">dem zun fun dain muter banavlstu.<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />dos hostu geton, un ich hob gezolt shvaign?</para>
  <para style="q" vid="PSA 50:21">hostu gedacht, zain vi du vel ich zain;</para>
  <para style="q" vid="PSA 50:21">vel ich dich shtrofn, un dir leign far daine oign.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />merkt dos akorsht, ir vos fargest on Eloah,</para>
  <para style="q" vid="PSA 50:22">kedei ich zol nisht fartsukn, un keiner vet nisht matsl zain.<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />der vos shlacht a dankopfer, erlecht mich,</para>
  <para style="q" vid="PSA 50:23">ober dem vos batracht dem veg,</para>
  <para style="q" vid="PSA 50:23">im vel ich vaizn di yeshue fun Elokim.<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" pubnumber="נא" sid="PSA 51" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 51:1" />far dem gezangmaister; a mizmor fun Dovidn, <verse eid="PSA 51:1" /><verse number="2" style="v" sid="PSA 51:2" />ven Natan der novi iz gekumen tsu im, noch dem vi er iz gekumen tsu Bat-Shevaen.<verse eid="PSA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="1" sid="PSA 51:3" /> laitzelik mich, Elokim, loit dain chesed,</para>
  <para style="q" vid="PSA 51:3">loit dain grois derbaremung mek op maine farbrechn.<verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="2" sid="PSA 51:4" /> vash mich op in gantsn fun main zind,</para>
  <para style="q" vid="PSA 51:4">un fun main chet tu mich reiniken.<verse eid="PSA 51:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="3" sid="PSA 51:5" /> vorem ich veis maine farbrechn,</para>
  <para style="q" vid="PSA 51:5">un main chet iz mir tamid antkegen.<verse eid="PSA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="4" sid="PSA 51:6" /> tsu dir alein hob ich gezindikt,</para>
  <para style="q" vid="PSA 51:6">un vos iz shlecht in daine oign hob ich geton;</para>
  <para style="q" vid="PSA 51:6">derum bistu rechtfartik in dain redn,</para>
  <para style="q" vid="PSA 51:6">bistu gerecht in dain mishpetn.<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="5" sid="PSA 51:7" /> ze, in zind bin ich geborn gevorn,</para>
  <para style="q" vid="PSA 51:7">un in chet hot mich maine muter farshvengern.<verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="6" sid="PSA 51:8" /> emes bagerstu doch in di nirn,</para>
  <para style="q" vid="PSA 51:8">to lern mich chochme vu es iz farhoiln.<verse eid="PSA 51:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="7" sid="PSA 51:9" /> zolst mich reiniken mit ezov-groz,</para>
  <para style="q" vid="PSA 51:9">az ich zol rein vern,</para>
  <para style="q" vid="PSA 51:9">zolst mich vashn,</para>
  <para style="q" vid="PSA 51:9">biz vaiser fun shnei zol ich vern.<verse eid="PSA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="8" sid="PSA 51:10" /> zolst mich machn hern freid un lustikeit;</para>
  <para style="q" vid="PSA 51:10">zoln derfreit vern di beiner vos du host tsedrikt.<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="9" sid="PSA 51:11" /> farborg dain ponem fun maine chatoim,</para>
  <para style="q" vid="PSA 51:11">un ale maine zind farmek.<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="10" sid="PSA 51:12" /> a rein harts bashaf in mir, o Elokim,</para>
  <para style="q" vid="PSA 51:12">un a fest gaist banai in mir.<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="11" sid="PSA 51:13" /> zolst mich nisht avekvarfn fun dir,</para>
  <para style="q" vid="PSA 51:13">un dain ruach hkdsh zolstu nisht aveknemen fun mir.<verse eid="PSA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="12" sid="PSA 51:14" /> ker mir um di freid fun dain hilf,</para>
  <para style="q" vid="PSA 51:14">un a frai gaist zolstu mir shenken.<verse eid="PSA 51:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="13" sid="PSA 51:15" /> ich vel lernen farbrecher daine vegen,</para>
  <para style="q" vid="PSA 51:15">un zindike veln zich umkeren tsu dir.<verse eid="PSA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="14" sid="PSA 51:16" /> zai mich matsl fun blutikeit,</para>
  <para style="q" vid="PSA 51:16">Elokim, du Elokim fun main hilf;</para>
  <para style="q" vid="PSA 51:16">zol main tsung zingen dain gerechtikeit.<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="15" sid="PSA 51:17" /> o Adonoi, maine lipn zolstu efenen,</para>
  <para style="q" vid="PSA 51:17">un zol main moil dertseiln dain loib.<verse eid="PSA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="16" sid="PSA 51:18" /> vorem bagerst nisht a shlachtopfer az ich zol gebn,</para>
  <para style="q" vid="PSA 51:18">a brandopfer vilstu nisht.<verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="17" sid="PSA 51:19" /> di shlachtopfer fun Elokim zainen a tsebrochn gaist,</para>
  <para style="q" vid="PSA 51:19">a tsebrochn un dershlogn harts, Elokim, farachtstu nisht.<verse eid="PSA 51:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="18" sid="PSA 51:20" /> bagitik in dain bavilikung Tsiyon,</para>
  <para style="q" vid="PSA 51:20">boien zolstu di moiern fun Yerushalayim.<verse eid="PSA 51:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="19" sid="PSA 51:21" /> dentsmol vestu bageren shlachtopfer fun gerechtikeit,</para>
  <para style="q" vid="PSA 51:21">brandopfer un gantsopfer;</para>
  <para style="q" vid="PSA 51:21">dentsmol vet men oifbrengen oksen oif dain mizbeyech.<verse eid="PSA 51:21" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" pubnumber="נב" sid="PSA 52" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 52:1" />far dem gezangmaister; a batrachtung fun Dovidn, <verse eid="PSA 52:1" /><verse number="2" style="v" sid="PSA 52:2" />ven Doeg der Adomi iz gekumen, un hot dertseilt Shauln, un im ongezogt: Dovid iz gekumen in Achimelechs hoiz.<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="1" sid="PSA 52:3" /> vos prolstu zich mit beiz, du machtiker?</para>
  <para style="q" vid="PSA 52:3">der chesed fun El iz ale tog.<verse eid="PSA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="2" sid="PSA 52:4" /> umglikn tracht dain tsung,</para>
  <para style="q" vid="PSA 52:4">vi a sharfer golmeser vos arbet falsh.<verse eid="PSA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="3" sid="PSA 52:5" /> host lib beiz mer vi guts,</para>
  <para style="q" vid="PSA 52:5">lign eider redn gerechtikeit.</para>
  <para style="q" vid="PSA 52:5">Selah.<verse eid="PSA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="4" sid="PSA 52:6" /> host lib ale gereid fun tseshterung,</para>
  <para style="q" vid="PSA 52:6">du tsung fun batrug.<verse eid="PSA 52:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="5" sid="PSA 52:7" /> vet oich El dich tsebrechn oif eibik,</para>
  <para style="q" vid="PSA 52:7">dich aroissharn un aroisraisn fun getselt,</para>
  <para style="q" vid="PSA 52:7">un dich oisvortselen fun land fun di lebedike.</para>
  <para style="q" vid="PSA 52:7">Selah.<verse eid="PSA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="6" sid="PSA 52:8" /> un di tsadikim veln zen un veln forchtn,</para>
  <para style="q" vid="PSA 52:8">un zei veln lachn iber im:<verse eid="PSA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="7" sid="PSA 52:9" /> on iz der man vos hot nisht gemacht Elokim far zain festung,</para>
  <para style="q" vid="PSA 52:9">un hot zich farzichert oif zain grois eshires;</para>
  <para style="q" vid="PSA 52:9">vos iz farshait geven in zain gerikeit.<verse eid="PSA 52:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="8" sid="PSA 52:10" /> ober ich bin vi a tsvaighaftiker eilbertboim</para>
  <para style="q" vid="PSA 52:10">in dem hoiz fun Elokim,</para>
  <para style="q" vid="PSA 52:10">ich farzicher mich oif G-ts chesed eibik un shtendik.<verse eid="PSA 52:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="9" sid="PSA 52:11" /> ich vel eibik dir danken, vos du host zich aingeshtelt,</para>
  <para style="q" vid="PSA 52:11">un ich vel hofn tsu dain nomen vail er iz gut,</para>
  <para style="q" vid="PSA 52:11">antkegen far daine frume.<verse eid="PSA 52:11" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" pubnumber="נג" sid="PSA 53" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 53:1" />far dem gezangmaister; oif Machalat; a batrachtung fun Dovidn.<verse eid="PSA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 53:2" /> der nor zogt in zain hartsn: nishto kein Elokim!</para>
  <para style="q" vid="PSA 53:2">fardorben zainen zei, un miuse umrecht tuen zei;</para>
  <para style="q" vid="PSA 53:2">keiner tut nisht kein guts.<verse eid="PSA 53:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 53:3" /> Elokim hot fun himel gelugt oif di mentshnkinder,</para>
  <para style="q" vid="PSA 53:3">tsu zen oib faran a farshtandiker vos zucht Elokim.<verse eid="PSA 53:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 53:4" /> itlecher iz opgefaln, ale zainen zei fardorben,</para>
  <para style="q" vid="PSA 53:4">keiner tut nisht kein guts, nisht tsu mol einer.<verse eid="PSA 53:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 53:5" /> far vor, hot den keiner nisht farshtanen fun di vos ton umrecht,</para>
  <para style="q" vid="PSA 53:5">velche esen main folk azoi vi zei esen broit, un rufn nisht tsu Elokim?<verse eid="PSA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 53:6" /> on angstn zei in angst, vu kein angst iz nisht geven,</para>
  <para style="q" vid="PSA 53:6">vorem Elokim hot tseshotn di beiner fun dain balegerer;</para>
  <para style="q" vid="PSA 53:6">host zei gemacht tsu shand, vail Elokim hot zei faracht.<verse eid="PSA 53:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 53:7" /> ven kumt fun Tsiyon di yeshue fun Yisroel?</para>
  <para style="q" vid="PSA 53:7">ven Elokim kert um di gefangenshaft fun zain folk,</para>
  <para style="q" vid="PSA 53:7">vet lustik zain Yaakov, vet zich freyen Yisroel.<verse eid="PSA 53:7" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" pubnumber="נד" sid="PSA 54" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 54:1" />far dem gezangmaister, mit struneshpil; a batrachtung fun Dovidn, <verse eid="PSA 54:1" /><verse number="2" style="v" sid="PSA 54:2" />ven di Zifer zainen gekumen, un hobn gezogt tsu Shauln: far vor, Dovid bahalt zich bai undz.<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="1" sid="PSA 54:3" /> Elokim, mit dain nomen tu mich helfn,</para>
  <para style="q" vid="PSA 54:3">un mit dain gevure zolstu zich onnemen far mir.<verse eid="PSA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="2" sid="PSA 54:4" /> Elokim, her tsu main tfile,</para>
  <para style="q" vid="PSA 54:4">farnem di verter fun main moil.<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="3" sid="PSA 54:5" /> vorem fremde zainen ongeshtanen oif mir,</para>
  <para style="q" vid="PSA 54:5">un gevalttuer zuchn main lebn;</para>
  <para style="q" vid="PSA 54:5">zei haltn nisht Elokim antkegen zich.</para>
  <para style="q" vid="PSA 54:5">Selah.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="4" sid="PSA 54:6" /> ze, Elokim iz mir a helfer,</para>
  <para style="q" vid="PSA 54:6">Adonoi iz der unterlener fun main nefesh.<verse eid="PSA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="5" sid="PSA 54:7" /> zol er umkeren dos beiz oif maine loierer;</para>
  <para style="q" vid="PSA 54:7">in dain traishaft farshnaid zei.<verse eid="PSA 54:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="6" sid="PSA 54:8" /> mit vilikeit vel ich shlachtn tsu dir,</para>
  <para style="q" vid="PSA 54:8">vel loibn dain nomen, Hashem, vorem er iz gut.<verse eid="PSA 54:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="7" sid="PSA 54:9" /> vorem fun yetveder tsore hot er mich matsl geven,</para>
  <para style="q" vid="PSA 54:9">un main oig hot zich ongezen oif maine faint.<verse eid="PSA 54:9" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" pubnumber="נה" sid="PSA 55" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 55:1" />far dem gezangmaister, mit struneshpil; a batrachtung fun Dovidn.<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 55:2" /> farnem, Elokim, main tfile,</para>
  <para style="q" vid="PSA 55:2">un zolst zich nisht farhoiln fun main gebet.<verse eid="PSA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 55:3" /> horch tsu mir, un entfer mir;</para>
  <para style="q" vid="PSA 55:3">ich loif um in main klog, un ich brum,<verse eid="PSA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 55:4" /> fun dem kol fun dem faint,</para>
  <para style="q" vid="PSA 55:4">fun vegen der drikung fun dem roshe;</para>
  <para style="q" vid="PSA 55:4">vorem zei brengen oif mir umglik,</para>
  <para style="q" vid="PSA 55:4">un mit tsorn tuen zei mich faintn.<verse eid="PSA 55:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 55:5" /> main harts tsaplt in mir,</para>
  <para style="q" vid="PSA 55:5">un toitshrekn zainen ongefaln oif mir.<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 55:6" /> a moire un a tsiterenish kumt oif mir,</para>
  <para style="q" vid="PSA 55:6">un a shoider hot mich badekt.<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 55:7" /> un ich zog: ver git mir fliglen vi a toib,</para>
  <para style="q" vid="PSA 55:7">ich volt avekgefloign un gerut.<verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 55:8" /> ot volt ich avekgevoglt vait,</para>
  <para style="q" vid="PSA 55:8">ich volt gevailt in der midber.</para>
  <para style="q" vid="PSA 55:8">Selah.<verse eid="PSA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 55:9" /> ich volt mir geailt tsu an antrinung</para>
  <para style="q" vid="PSA 55:9">fun raisikn vint, funem shturem.<verse eid="PSA 55:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 55:10" /> tsemish, Adonoi, tseteil zeyer shprach,</para>
  <para style="q" vid="PSA 55:10">vorem ich hob gezen roib un krig in shtot.<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 55:11" /> tog un nacht ringlen zei zi arum oif ire moiern,</para>
  <para style="q" vid="PSA 55:11">un umrecht un umglik iz in ir mitn.<verse eid="PSA 55:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 55:12" /> farbrechn zainen in ir mitn,</para>
  <para style="q" vid="PSA 55:12">un fun ir mark tut zich nisht op drikung un batrug.<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 55:13" /> vorem nisht a faint tut mich lestern –</para>
  <para style="q" vid="PSA 55:13">dos volt ich fartrogen;</para>
  <para style="q" vid="PSA 55:13">nisht main soine hot zich gegreist iber mir –</para>
  <para style="q" vid="PSA 55:13">fun im volt ich mich farborgen;<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 55:14" /> nor du, a mentsh main glaichn,</para>
  <para style="q" vid="PSA 55:14">main chever un main bakenter,<verse eid="PSA 55:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 55:15" /> vos bainand flegn mir zis zich soden,</para>
  <para style="q" vid="PSA 55:15">gein in dem hoiz fun Elokim mit gezeml.<verse eid="PSA 55:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 55:16" /> zol er onreitsn dem toit oif zei,</para>
  <para style="q" vid="PSA 55:16">zoln zei nidern lebedikerheit in Sheol!</para>
  <para style="q" vid="PSA 55:16">vorem beiz iz in zeyer voinung, tsvishn zei.<verse eid="PSA 55:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 55:17" /> ich vel rufn tsu Elokim,</para>
  <para style="q" vid="PSA 55:17">un Hashem vet mich helfn.<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 55:18" /> ovnt un frimorgn un mitn tog</para>
  <para style="q" vid="PSA 55:18">vel ich klogn un vel brumen,</para>
  <para style="q" vid="PSA 55:18">un er tut hern main kol.<verse eid="PSA 55:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 55:19" /> er tut oisleizen besholem main zel,</para>
  <para style="q" vid="PSA 55:19">me zol nisht genenen tsu mir,</para>
  <para style="q" vid="PSA 55:19">hagam zei zainen fil kegen mir.<verse eid="PSA 55:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 55:20" /> El vet hern un vet zei untertenik machn –</para>
  <para style="q" vid="PSA 55:20">der vos tront fun eibik on.</para>
  <para style="q" vid="PSA 55:20">Selah.</para>
  <para style="q" vid="PSA 55:20">vorem nishto kein opbait bai zei,</para>
  <para style="q" vid="PSA 55:20">un zei hobn nisht moire far Elokim.<verse eid="PSA 55:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 55:21" /> er shtrekt ois zaine hent</para>
  <para style="q" vid="PSA 55:21">oif di vos zainen in sholem mit im,</para>
  <para style="q" vid="PSA 55:21">er farshvecht zain bris.<verse eid="PSA 55:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 55:22" /> glat zainen di shmantike reid fun zain moil,</para>
  <para style="q" vid="PSA 55:22">un zain harts iz milchome;</para>
  <para style="q" vid="PSA 55:22">veicher fun boimel zainen zaine verter,</para>
  <para style="q" vid="PSA 55:22">ober zei zainen shverdn bloize.<verse eid="PSA 55:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 55:23" /> vorf oif Hashem dain last,</para>
  <para style="q" vid="PSA 55:23">un er vet dich farzorgen;</para>
  <para style="q" vid="PSA 55:23">er vet kein mol nisht lozn faln dem tsadik.<verse eid="PSA 55:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 55:24" /> ober du Elokim vest zei nidern in keyver-grub,</para>
  <para style="q" vid="PSA 55:24">di lait fun blut un batrug</para>
  <para style="q" vid="PSA 55:24">veln nisht oislebn halb zeyere teg;</para>
  <para style="q" vid="PSA 55:24">un ich vel mich farzichern oif dir.<verse eid="PSA 55:24" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" pubnumber="נו" sid="PSA 56" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 56:1" />far dem gezangmaister, oif Yonahs elem rechokim; fun Dovidn a miktam, ven di Pelishtim hobn im gechapt in Gat.<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 56:2" /> laitzelik mich, Elokim,</para>
  <para style="q" vid="PSA 56:2">vorem ainshlingen vil mich a mentsh;</para>
  <para style="q" vid="PSA 56:2">a gantsn tog drikt er mich shtraitndik.<verse eid="PSA 56:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 56:3" /> ainshlingen viln mich maine loierer a gantsn tog,</para>
  <para style="q" vid="PSA 56:3">yo fil, du hechster, shtraitn oif mir.<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 56:4" /> dem tog vos ich hob moire</para>
  <para style="q" vid="PSA 56:4">farzicher ich mich oif dir.<verse eid="PSA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 56:5" /> oif Elokim vos zain vort tu ich loibn,</para>
  <para style="q" vid="PSA 56:5">oif Elokim hob ich mich farzichert,</para>
  <para style="q" vid="PSA 56:5">ich hob nisht kein moire;</para>
  <para style="q" vid="PSA 56:5">vos ken a besor-vedam mir ton?<verse eid="PSA 56:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 56:6" /> a gantsn tog krivden zei maine tainus,</para>
  <para style="q" vid="PSA 56:6">ale zeyere machshoves zainen tsum beizn oif mir.<verse eid="PSA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 56:7" /> zei klaibn zich oif, zei bahaltn zich,</para>
  <para style="q" vid="PSA 56:7">zei hitn maine fustrit,</para>
  <para style="q" vid="PSA 56:7">azoi vi zei kukn ois oif main zel.<verse eid="PSA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 56:8" /> far dem umrecht shlaider zei arois,</para>
  <para style="q" vid="PSA 56:8">in tsorn di felker vorf anider, Elokim.<verse eid="PSA 56:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 56:9" /> host fartseichnt main voglenish,</para>
  <para style="q" vid="PSA 56:9">tu arain main trer in dain logl;</para>
  <para style="q" vid="PSA 56:9">far vor, zei zainen in dain buch.<verse eid="PSA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 56:10" /> dentsmol veln maine faint zich umkeren ahinter</para>
  <para style="q" vid="PSA 56:10">in dem tog vos ich vel rufn;</para>
  <para style="q" vid="PSA 56:10">dos veis ich az Elokim iz far mir.<verse eid="PSA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 56:11" /> oif Elokim vos zain vort tu ich loibn,</para>
  <para style="q" vid="PSA 56:11">oif Hashem vos zain vort tu ich loibn,<verse eid="PSA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 56:12" /> oif Elokim hob ich mich farzichert,</para>
  <para style="q" vid="PSA 56:12">ich hob nisht kein moire;</para>
  <para style="q" vid="PSA 56:12">vos ken a mentsh mir ton?<verse eid="PSA 56:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 56:13" /> ich nem oif mir, Elokim, nedrim tsu dir,</para>
  <para style="q" vid="PSA 56:13">ich vel optsolen dankopfer tsu dir;<verse eid="PSA 56:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 56:14" /> vorem host matsl geven main zel fun toit,</para>
  <para style="q" vid="PSA 56:14">far vor, maine fis fun shtroichlung,</para>
  <para style="q" vid="PSA 56:14">kedei arumtsugein far Elokim</para>
  <para style="q" vid="PSA 56:14">in dem licht fun lebn.<verse eid="PSA 56:14" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" pubnumber="נז" sid="PSA 57" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 57:1" />far dem gezangmaister; al-taּshchet; fun Dovidn a miktam, ven er iz antlofn fun Shauln in der heil.<verse eid="PSA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 57:2" /> laitzelik mich, Elokim, laitzelik mich,</para>
  <para style="q" vid="PSA 57:2">vorem in dir hot zich geshitst main zel,</para>
  <para style="q" vid="PSA 57:2">un in shotn fun daine fliglen vel ich mich shitsn</para>
  <para style="q" vid="PSA 57:2">biz di umglikn veln ariber.<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 57:3" /> ich vel rufn tsu Elokim Elyon Oibershter,</para>
  <para style="q" vid="PSA 57:3">tsu El vos firt ois far mir.<verse eid="PSA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 57:4" /> er vet shikn fun himel, un mich helfn,</para>
  <para style="q" vid="PSA 57:4">meg lestern der vos vil mich ainshlingen,</para>
  <para style="q" vid="PSA 57:4">Selah;</para>
  <para style="q" vid="PSA 57:4">Elokim vet shikn zain chesed un zain traishaft.<verse eid="PSA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 57:5" /> main zel iz tsvishn leibn,</para>
  <para style="q" vid="PSA 57:5">ich lig tsvishn mentshnkinder lohute;</para>
  <para style="q" vid="PSA 57:5">zeyere tsein zainen shpizn un failn,</para>
  <para style="q" vid="PSA 57:5">un zeyer tsung a shverd a sharfe.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 57:6" /> derheib dich iber di himlen, Elokim,</para>
  <para style="q" vid="PSA 57:6">iber der gantser erd zol zain dain koved.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 57:7" /> a nets hobn zei ongebreit far maine trit,</para>
  <para style="q" vid="PSA 57:7">me hot aingeboign main zel;</para>
  <para style="q" vid="PSA 57:7">zei hobn gegrobn far mir a grub,</para>
  <para style="q" vid="PSA 57:7">zainen zei alein araingefaln in ir.</para>
  <para style="q" vid="PSA 57:7">Selah.<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 57:8" /> fest iz main harts, Elokim, fest iz main harts,</para>
  <para style="q" vid="PSA 57:8">ich vel zingen un shpiln.<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 57:9" /> dervek dich, main zel,</para>
  <para style="q" vid="PSA 57:9">dervek dich, gitar un harf;</para>
  <para style="q" vid="PSA 57:9">lomich oifvekn dem baginen.<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 57:10" /> ich vel dich loibn tsvishn di felker, o Adonoi,</para>
  <para style="q" vid="PSA 57:10">ich vel dich bazingen tsvishn di umes.<verse eid="PSA 57:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 57:11" /> vorem grois biz di himlen iz dain chesed,</para>
  <para style="q" vid="PSA 57:11">un biz di volken dain traishaft.<verse eid="PSA 57:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 57:12" /> derheib dich iber di himlen, Elokim,</para>
  <para style="q" vid="PSA 57:12">iber der gantser erd zol zain dain koved.<verse eid="PSA 57:12" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" pubnumber="נח" sid="PSA 58" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 58:1" />far dem gezangmaister; al-taּshchet; fun Dovidn a miktam.<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 58:2" /> zent ir nit shtum dem ir zolt fun gerechtikeit redn?</para>
  <para style="q" vid="PSA 58:2">in emes mishpotim tut ir, mentshnkinder?<verse eid="PSA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 58:3" /> yo, in hartsn arbet ir ois farbrechn,</para>
  <para style="q" vid="PSA 58:3">oif der erd firt ir durch dos umrecht fun aiere hent.<verse eid="PSA 58:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 58:4" /> di reshoim zainen opgekert fun tracht on,</para>
  <para style="q" vid="PSA 58:4">fun muterlaib on blondzhen di lignzogers.<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 58:5" /> a gift iz bai zei glaich vi gift fun a shlang;</para>
  <para style="q" vid="PSA 58:5">vi der toiber noter vos farshtopt zain oier,<verse eid="PSA 58:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 58:6" /> vos hert nisht tsu dem kol fun bashverer,</para>
  <para style="q" vid="PSA 58:6">fun dem kligstn shprecher fun shpruchn.<verse eid="PSA 58:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 58:7" /> Elokim, tsebrech zeyere tsein in zeyer moil,</para>
  <para style="q" vid="PSA 58:7">di baktsein fun di yungleibn hak ois, Hashem.<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 58:8" /> zoln zei tsegein vi vaser vos tseloift zich;</para>
  <para style="q" vid="PSA 58:8">shpant er zaine failn, zoln zei vi opgeshnitn vern.<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 58:9" /> vi a tsekrochene shnek zol er fargein,</para>
  <para style="q" vid="PSA 58:9">vi a mapl, vi a krot, vos hobn di zun nisht gezen.<verse eid="PSA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 58:10" /> eider aiere tep veln dershpirn di derner,</para>
  <para style="q" vid="PSA 58:10">zol er es avekshturemen, dos roie vi dos tsugebrente.<verse eid="PSA 58:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 58:11" /> der tsadik vet zich freyen, az er zet nekome,</para>
  <para style="q" vid="PSA 58:11">zaine trit vet er vashn in blut fun dem roshe.<verse eid="PSA 58:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 58:12" /> un mentshn veln zogn: yo, es iz do a frucht faran tsadik;</para>
  <para style="q" vid="PSA 58:12">yo, faran a Elokim vos mishpot oif der erd.<verse eid="PSA 58:12" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" pubnumber="נט" sid="PSA 59" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 59:1" />far dem gezangmaister; al-taּshchet; fun Dovidn a miktam, ven Shaul hot geshikt, un me hot gehit dos hoiz, kedei im tsu teitn.<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 59:2" /> zai mich matsl fun maine faint, main G-t,</para>
  <para style="q" vid="PSA 59:2">fun di vos shteyen on oif mir zolstu mich bashitsn.<verse eid="PSA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 59:3" /> zai mich matsl fun di vos tuen umrecht,</para>
  <para style="q" vid="PSA 59:3">un fun blutike lait tu mich helfn.<verse eid="PSA 59:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 59:4" /> vorem ze, zei hobn geloyert oif main zel;</para>
  <para style="q" vid="PSA 59:4">es klaibn zich di farshaite oif mir;</para>
  <para style="q" vid="PSA 59:4">nisht far main farbrech un nisht far main chet, Hashem.<verse eid="PSA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 59:5" /> on a zind fun mir, loifn zei un breitn zich on;</para>
  <para style="q" vid="PSA 59:5">dervek zich mir antkegen, un ze.<verse eid="PSA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 59:6" /> du bist doch Hashem Elokim Tseva'ot,</para>
  <para style="q" vid="PSA 59:6">Elokei Yisroel,</para>
  <para style="q" vid="PSA 59:6">vach oif zich tsu rechenen mit ale felker;</para>
  <para style="q" vid="PSA 59:6">nisht laitzelikn zolstu ale umgerechte felsher.</para>
  <para style="q" vid="PSA 59:6">Selah.<verse eid="PSA 59:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 59:7" /> ale ovnt kumen zei vider,</para>
  <para style="q" vid="PSA 59:7">zei voien vi a hunt,</para>
  <para style="q" vid="PSA 59:7">un dreyen zich um in shtot.<verse eid="PSA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 59:8" /> ze, zei gaiveren mit zeyer moil;</para>
  <para style="q" vid="PSA 59:8">shverdn zainen in zeyere lipn;</para>
  <para style="q" vid="PSA 59:8">vorem: ver hert den?<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 59:9" /> ober du Hashem tust lachn fun zei,</para>
  <para style="q" vid="PSA 59:9">tust shpotn fun ale felker.<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 59:10" /> main shtarkeit, oif dir vel ich vartn;</para>
  <para style="q" vid="PSA 59:10">vorem Elokim iz main festung.<verse eid="PSA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 59:11" /> der G-t fun main genod vet mir antkegen kumen,</para>
  <para style="q" vid="PSA 59:11">Elokim vet mich lozn zen oif maine loierer.<verse eid="PSA 59:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 59:12" /> nisht hargen zolstu zei, kedei main folk zol nisht fargesen;</para>
  <para style="q" vid="PSA 59:12">tsetreisl zei mit dain macht, un vorf zei anider,</para>
  <para style="q" vid="PSA 59:12">o Adonoi undzer shild.<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 59:13" /> far der zind fun zeyer moil, dem gereid fun zeyere lipn,</para>
  <para style="q" vid="PSA 59:13">zoln zei batsvungen vern in zeyer gaive,</para>
  <para style="q" vid="PSA 59:13">un far di kloles un far di ligns vos zei redn.<verse eid="PSA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 59:14" /> farlend in grimtsorn,</para>
  <para style="q" vid="PSA 59:14">farlend az zei zoln mer nisht zain,</para>
  <para style="q" vid="PSA 59:14">un zol men visen az Elokim geveltikt in Yaakov,</para>
  <para style="q" vid="PSA 59:14">biz di ekn fun der erd.</para>
  <para style="q" vid="PSA 59:14">Selah.<verse eid="PSA 59:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 59:15" /> yo, ale ovnt kumen zei vider,</para>
  <para style="q" vid="PSA 59:15">zei voien vi a hunt,</para>
  <para style="q" vid="PSA 59:15">un dreyen zich um in shtot.<verse eid="PSA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 59:16" /> zei vandern arum tsu fartseren,</para>
  <para style="q" vid="PSA 59:16">un blaibn a gantse nacht biz zei vern nisht zat.<verse eid="PSA 59:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 59:17" /> ober ich vel bazingen dain shtarkeit,</para>
  <para style="q" vid="PSA 59:17">un vel shaln frimorgns dain chesed.</para>
  <para style="q" vid="PSA 59:17">vorem du bist mir geven a festung,</para>
  <para style="q" vid="PSA 59:17">un an antrinung in tog fun main noit.<verse eid="PSA 59:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 59:18" /> main shtarkeit, tsu dir vel ich zingen,</para>
  <para style="q" vid="PSA 59:18">vorem Elokim iz main festung, der Elokim fun main genod.<verse eid="PSA 59:18" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" pubnumber="ס" sid="PSA 60" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 60:1" />far dem gezangmaister; oif Shushan-eides; a miktam fun Dovidn far a lernung, <verse eid="PSA 60:1" /><verse number="2" style="v" sid="PSA 60:2" />ven er hot milchome gehaltn mit Aram-Naharayim un Aram fun Tsovah, un Yoav hot zich umgekert, un hot geshlogn fun Edom in tal fun zalts tsvelf toiznt.<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="1" sid="PSA 60:3" /> Elokim, host undz farlozt, host undz tsebrochn;</para>
  <para style="q" vid="PSA 60:3">host getsernt oif undz, zolstu undz vider oifrichtn.<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="2" sid="PSA 60:4" /> host oifgeshturemt di erd, host zi tseshpolten;</para>
  <para style="q" vid="PSA 60:4">heil ire brochn, vorem zi vaklt zich.<verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="3" sid="PSA 60:5" /> host gemacht zen dain folk shvere laidn,</para>
  <para style="q" vid="PSA 60:5">host undz ongetrunken mit vain fun fartumlenish.<verse eid="PSA 60:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="4" sid="PSA 60:6" /> gib daine forchter a fon,</para>
  <para style="q" vid="PSA 60:6">zich aintsuzamlen faran emes.</para>
  <para style="q" vid="PSA 60:6">Selah.<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="5" sid="PSA 60:7" /> kedei daine balibte zoln derleizt vern,</para>
  <para style="q" vid="PSA 60:7">helf mit dain rechter hant, un entfer mir.<verse eid="PSA 60:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="6" sid="PSA 60:8" /> Elokim hot geredt in zain heilikeit,</para>
  <para style="q" vid="PSA 60:8">az ich vel derfreit vern;</para>
  <para style="q" vid="PSA 60:8">ich vel tseteiln Shechem,</para>
  <para style="q" vid="PSA 60:8">un dem tal Sukkot vel ich oismestn.<verse eid="PSA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="7" sid="PSA 60:9" /> main iz Gilad, un main iz Menasheh,</para>
  <para style="q" vid="PSA 60:9">un Efrayim iz der kiver fun main kop;</para>
  <para style="q" vid="PSA 60:9">Yehudah iz main tsepter.<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="8" sid="PSA 60:10" /> Moav iz main vashtop;</para>
  <para style="q" vid="PSA 60:10">oif Edom vorf ich main shuch;</para>
  <para style="q" vid="PSA 60:10">iber mir, Peleshet, vestu shraien.<verse eid="PSA 60:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="9" sid="PSA 60:11" /> ver brengt mich tsu der bafestikter shtot?</para>
  <para style="q" vid="PSA 60:11">ver tut mich firn kein Edom?<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="10" sid="PSA 60:12" /> far vor, du Elokim host undz farlozt,</para>
  <para style="q" vid="PSA 60:12">un gaist nisht arois, Elokim, mit undzere machnus.<verse eid="PSA 60:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="11" sid="PSA 60:13" /> gib undz hilf kegen dem faint,</para>
  <para style="q" vid="PSA 60:13">vorem nishtik iz di yeshue fun a mentshn.<verse eid="PSA 60:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="12" sid="PSA 60:14" /> mit Elokim veln mir oifton gevuros,</para>
  <para style="q" vid="PSA 60:14">un er vet tsetretn undzere faint.<verse eid="PSA 60:14" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" pubnumber="סא" sid="PSA 61" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 61:1" />far dem gezangmaister, oif struneshpil; fun Dovidn.<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 61:2" /> her tsu, Elokim, main geshrei,</para>
  <para style="q" vid="PSA 61:2">farnem main tfile.<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 61:3" /> fun ek fun der erd ruf ich tsu dir,</para>
  <para style="q" vid="PSA 61:3">ven main harts fargeit;</para>
  <para style="q" vid="PSA 61:3">oif dem feldz vos iz tsu hoich far mir,</para>
  <para style="q" vid="PSA 61:3">zolstu mich aroiffirn.<verse eid="PSA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 61:4" /> vorem du bist mir geven a bashitsung,</para>
  <para style="q" vid="PSA 61:4">a turem fun shtarkeit akegn dem faint.<verse eid="PSA 61:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 61:5" /> ich vel eibik voinen in dain getselt.</para>
  <para style="q" vid="PSA 61:5">ich vel mich shitsn in der farborgenish fun daine fliglen.</para>
  <para style="q" vid="PSA 61:5">Selah.<verse eid="PSA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 61:6" /> vorem du, Elokim, host tsugehert tsu maine nedrim;</para>
  <para style="q" vid="PSA 61:6">host gegebn di arav</para>
  <para style="q" vid="PSA 61:6">fun di vos forchtn dain nomen.<verse eid="PSA 61:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 61:7" /> teg tsu di teg fun dem melech zolstu tsuleigen,</para>
  <para style="q" vid="PSA 61:7">zaine yorn zoln zain vi a dor oif a dor.<verse eid="PSA 61:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 61:8" /> tronen zol er eibik far Elokim;</para>
  <para style="q" vid="PSA 61:8">genod un traishaft basher, zei zoln im hitn.<verse eid="PSA 61:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 61:9" /> azoi vel ich bazingen dain nomen oif eibik,</para>
  <para style="q" vid="PSA 61:9">ven ich batsol maine nedrim togteglech.<verse eid="PSA 61:9" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" pubnumber="סב" sid="PSA 62" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 62:1" />far dem gezangmaister, far Yedutun; a mizmor fun Dovidn.<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 62:2" /> nor tsu Elokim tut harn main zel,</para>
  <para style="q" vid="PSA 62:2">fun im iz main hilf.<verse eid="PSA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 62:3" /> nor er iz main feldz un main hilf,</para>
  <para style="q" vid="PSA 62:3">main festung, ich zol zich nisht oisglitshn shtark.<verse eid="PSA 62:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 62:4" /> biz vanen vet ir onfaln oif a mentshn?</para>
  <para style="q" vid="PSA 62:4">ir ale tut hargen</para>
  <para style="q" vid="PSA 62:4">vi a vant an aingeboigene,</para>
  <para style="q" vid="PSA 62:4">vi a moier an umgefalene.<verse eid="PSA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 62:5" /> rak zei eetshn zich fun zain hoichkeit im aroptsushtoisn;</para>
  <para style="q" vid="PSA 62:5">zei hobn hanoe fun lign;</para>
  <para style="q" vid="PSA 62:5">mit zeyer moil bentshn zei,</para>
  <para style="q" vid="PSA 62:5">un in zich shiltn zei.</para>
  <para style="q" vid="PSA 62:5">Selah.<verse eid="PSA 62:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 62:6" /> nor tsu Elokim, tu harn, main zel,</para>
  <para style="q" vid="PSA 62:6">vorem fun im iz main hofung.<verse eid="PSA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 62:7" /> nor er iz main feldz un main hilf,</para>
  <para style="q" vid="PSA 62:7">main festung, ich zol zich nisht oisglitshn.<verse eid="PSA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 62:8" /> bai Elokim iz main hilf un main koved;</para>
  <para style="q" vid="PSA 62:8">der feldz fun main shtarkeit, main bashitsung iz in Elokim.<verse eid="PSA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 62:9" /> farzichert aich oif im in yetveder tsait, ir folk,</para>
  <para style="q" vid="PSA 62:9">gist ois far im aier harts;</para>
  <para style="q" vid="PSA 62:9">Elokim iz undz a bashitsung.</para>
  <para style="q" vid="PSA 62:9">Selah.<verse eid="PSA 62:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 62:10" /> bloiz a hoich zainen di mentshnkinder,</para>
  <para style="q" vid="PSA 62:10">an opnar di ongezeene lait;</para>
  <para style="q" vid="PSA 62:10">ven me zol oif a vogshol aroifleigen,</para>
  <para style="q" vid="PSA 62:10">zainen zei in einem a hoich.<verse eid="PSA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 62:11" /> ir zolt aich nisht farzichern oif roib,</para>
  <para style="q" vid="PSA 62:11">un nisht narn oif gzeile zolt ir aich.</para>
  <para style="q" vid="PSA 62:11">az der farmeg vakst,</para>
  <para style="q" vid="PSA 62:11">zolt ir nisht leign kein acht.<verse eid="PSA 62:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 62:12" /> ein mol hot Elokim geredt,</para>
  <para style="q" vid="PSA 62:12">tsvei mol hob ich dos gehert,</para>
  <para style="q" vid="PSA 62:12">az shtarkeit iz bai Elokim.<verse eid="PSA 62:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 62:13" /> un bai dir, o Adonoi, iz genod,</para>
  <para style="q" vid="PSA 62:13">vorem du batsolst itlechn loit zaine meisim.<verse eid="PSA 62:13" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" pubnumber="סג" sid="PSA 63" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 63:1" />a mizmor fun Dovidn, ven er iz geven in der midber fun Yehudah.<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 63:2" /> Elokim, du bist eli,</para>
  <para style="q" vid="PSA 63:2">dich tu ich zuchn;</para>
  <para style="q" vid="PSA 63:2">noch dir dorsht main zel,</para>
  <para style="q" vid="PSA 63:2">tsu dir gelust main laib,</para>
  <para style="q" vid="PSA 63:2">in a land fun trikenish,</para>
  <para style="q" vid="PSA 63:2">un a farshmachter on vaser.<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 63:3" /> azoi hob ich oisgekukt oif dir,</para>
  <para style="q" vid="PSA 63:3">in heiliktum tsu zen dain shtarkeit un dain koved.<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 63:4" /> vorem dain chesed iz beser fun lebn;</para>
  <para style="q" vid="PSA 63:4">maine lipn veln dich loibn.<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 63:5" /> azoi vel ich dich bentshn durch main lebn;</para>
  <para style="q" vid="PSA 63:5">in dain nomen vel ich oifheibn maine hent.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 63:6" /> vi mit fets un march iz zat main zel,</para>
  <para style="q" vid="PSA 63:6">un mit zingedike lipn tut loibn main moil,<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 63:7" /> az ich dermon dich oif main geleger,</para>
  <para style="q" vid="PSA 63:7">az ich tracht on dir in di vachn fun der nacht.<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 63:8" /> vorem bist mir a hilf geven,</para>
  <para style="q" vid="PSA 63:8">un in shotn fun daine fliglen tu ich zingen.<verse eid="PSA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 63:9" /> main zel iz baheft noch dir;</para>
  <para style="q" vid="PSA 63:9">dain rechte hant lent mich unter.<verse eid="PSA 63:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 63:10" /> un di vos zuchn main zel oif umtsubrengen,</para>
  <para style="q" vid="PSA 63:10">veln arain in di tifenishn fun der erd.<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 63:11" /> me vet zei shlaidern in macht fun der shverd;</para>
  <para style="q" vid="PSA 63:11">der chelek fun fiks veln zei zain.<verse eid="PSA 63:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 63:12" /> ober der melech vet zich freyen mit Elokim;</para>
  <para style="q" vid="PSA 63:12">rimen vet zich itlecher vos shvert bai im;</para>
  <para style="q" vid="PSA 63:12">vorem farshtopt vern vet dos moil fun di lignzoger.<verse eid="PSA 63:12" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" pubnumber="סד" sid="PSA 64" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 64:1" />far dem gezangmaister; a mizmor fun Dovidn.<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 64:2" /> her tsu, Elokim, main kol in main klog;</para>
  <para style="q" vid="PSA 64:2">fun der angst fun faint zolstu bahitn main lebn.<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 64:3" /> zolst mich farborgen fun dem barot fun di shlechtstuer,</para>
  <para style="q" vid="PSA 64:3">fun dem tuml fun di vos verkn umrecht;<verse eid="PSA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 64:4" /> vos hobn gesharft vi a shverd zeyer tsung,</para>
  <para style="q" vid="PSA 64:4">geshpant zeyer fail – a giftik vort,<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 64:5" /> tsu shisn in farborgenishn dem umshuldikn;</para>
  <para style="q" vid="PSA 64:5">plutsling shisn zei im, un hobn nisht moire.<verse eid="PSA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 64:6" /> zei shtarkn einander in der beizer zach;</para>
  <para style="q" vid="PSA 64:6">zei redn op untertsuleign netsn;</para>
  <para style="q" vid="PSA 64:6">zei zogn, ver ken zei zen.<verse eid="PSA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 64:7" /> zei zuchn ois farbrechn,</para>
  <para style="q" vid="PSA 64:7">zei hobn durchgemacht a gruntike zuchenish;</para>
  <para style="q" vid="PSA 64:7">un di ineveinikeit fun itlechn un dos harts iz tif.<verse eid="PSA 64:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 64:8" /> ober Elokim shist oif zei plutsling a fail;</para>
  <para style="q" vid="PSA 64:8">es gesheen zeyere shlek.<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 64:9" /> un me macht zeyer tsung a shtroichlung far zei alein;</para>
  <para style="q" vid="PSA 64:9">oifgetreislt vern ale vos kukn oif zei.<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 64:10" /> un ale mentshn hobn moire,</para>
  <para style="q" vid="PSA 64:10">un dertseiln dos verk fun Elokim,</para>
  <para style="q" vid="PSA 64:10">un zain tuung farshteyen zei.<verse eid="PSA 64:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 64:11" /> der tsadik freit zich mit Hashem, un tut zich shitsn in im,</para>
  <para style="q" vid="PSA 64:11">un es rimen zich ale rechtfartikn hertser.<verse eid="PSA 64:11" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" pubnumber="סה" sid="PSA 65" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 65:1" />far dem gezangmaister; a mizmor; fun Dovidn a gezang.<verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 65:2" /> oif dir, Elokim, hart loib in Tsiyon,</para>
  <para style="q" vid="PSA 65:2">un tsu dir vern nedrim getsolt.<verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 65:3" /> du vos herst tsu a tfile,</para>
  <para style="q" vid="PSA 65:3">tsu dir kumen ale laiber.<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 65:4" /> di zindike meisim zainen tsu shtark far mir;</para>
  <para style="q" vid="PSA 65:4">undzere farbrechn, zei zolst du mechaper zain.<verse eid="PSA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 65:5" /> voil tsu dem vos du veilst</para>
  <para style="q" vid="PSA 65:5">un dernenterst,</para>
  <para style="q" vid="PSA 65:5">er zol ruen in daine hoifn.</para>
  <para style="q" vid="PSA 65:5">lomir zich zetn mit dem guts fun dain hoiz,</para>
  <para style="q" vid="PSA 65:5">mit der heilikeit fun dain heichl.<verse eid="PSA 65:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 65:6" /> mit forchtike vunder entferstu undz in gerechtikeit,</para>
  <para style="q" vid="PSA 65:6">du Elokim fun undzer hilf,</para>
  <para style="q" vid="PSA 65:6">du farzicherung fun ale ekn erd,</para>
  <para style="q" vid="PSA 65:6">un fun yamen vaite;<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 65:7" /> der vos bafestikt di berg mit zain koiech,</para>
  <para style="q" vid="PSA 65:7">der vos iz bagurt mit gevure;<verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 65:8" /> der vos shtilt ain di brumung fun di yamen,</para>
  <para style="q" vid="PSA 65:8">di brumung fun zeyere indn, un dem tuml fun di felker,<verse eid="PSA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 65:9" /> biz di bavoiner fun vaite ekn hobn moire far daine tseichns;</para>
  <para style="q" vid="PSA 65:9">di aroisgeng fun frimorgn un ovnt machstu zingen.<verse eid="PSA 65:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 65:10" /> dermonst zich on der erd un bavaserst zi,</para>
  <para style="q" vid="PSA 65:10">machst zi shefedik raich,</para>
  <para style="q" vid="PSA 65:10">fun dem taich fun Elokim ful mit vaser;</para>
  <para style="q" vid="PSA 65:10">breitst on zeyer korn, vorem breitst zi tsu richtik;<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 65:11" /> trinkst on ire beitn,</para>
  <para style="q" vid="PSA 65:11">zetsst arop ire grudes,</para>
  <para style="q" vid="PSA 65:11">machst zi veich mit shpreiregn,</para>
  <para style="q" vid="PSA 65:11">bentshst ir shprotsung.<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 65:12" /> host gekreint dos yor mit dain guts,</para>
  <para style="q" vid="PSA 65:12">un daine shtegn trifn mit fetkeit.<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 65:13" /> es trifn di fiterpletser fun midber,</para>
  <para style="q" vid="PSA 65:13">un freid gurtn on di heichn.<verse eid="PSA 65:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 65:14" /> di lonkes bakleidn zich mit shof,</para>
  <para style="q" vid="PSA 65:14">un di toln viklen zich in tvue;</para>
  <para style="q" vid="PSA 65:14">zei shaln un zei zingen.<verse eid="PSA 65:14" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" pubnumber="סו" sid="PSA 66" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 66:1" />far dem gezangmaister; a gezang, a mizmor.</para>
  <para style="q" vid="PSA 66:1">
    <char style="va">1</char> shalt tsu Elokim, di gantse erd,<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />bazingt di pracht fun zain nomen,</para>
  <para style="q" vid="PSA 66:2">macht prachtik zain loib.<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />zogt tsu Elokim: vi forchtik iz dain verk!</para>
  <para style="q" vid="PSA 66:3">durch dain grois shtarkeit geyen ain far dir daine faint.<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />di gantse erd zol zich bukn tsu dir</para>
  <para style="q" vid="PSA 66:4">un zingen tsu dir;</para>
  <para style="q" vid="PSA 66:4">zei zoln bazingen dain nomen.</para>
  <para style="q" vid="PSA 66:4">Selah.<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />kumt un zet di meisim fun Elokim;</para>
  <para style="q" vid="PSA 66:5">er iz forchtik in tuung far di mentshnkinder.<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />er hot farkert dem yam in yaboshe,</para>
  <para style="q" vid="PSA 66:6">tsu fus zainen zei ariber dem taich;</para>
  <para style="q" vid="PSA 66:6">dentsmol hobn mir zich gefreit mit im.<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />er geveltikt mit zain gevure eibik,</para>
  <para style="q" vid="PSA 66:7">zaine oign kukn oif di felker;</para>
  <para style="q" vid="PSA 66:7">zoln di opkerer zich nisht derheibn.</para>
  <para style="q" vid="PSA 66:7">Selah.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />loibt, ir felker, Elokeinu,</para>
  <para style="q" vid="PSA 66:8">un lozt hern dem kol fun zain loib;<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />der vos derhalt undzer zel baim lebn,</para>
  <para style="q" vid="PSA 66:9">un hot nisht gelozt zich oisglitshn undzer fus.<verse eid="PSA 66:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />vorem host undz gepruvet, Elokim;</para>
  <para style="q" vid="PSA 66:10">host undz gelaitert vi me laitert zilber.<verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />host undz gebracht in a festung nets,</para>
  <para style="q" vid="PSA 66:11">host aroifgeton a drikung oif undzere lendn.<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />host gelozt raitn a mentshn oif undzer kop,</para>
  <para style="q" vid="PSA 66:12">mir zainen gekumen in faier un in vaser,</para>
  <para style="q" vid="PSA 66:12">ober du host undz aroisgetsoign in zetikeit.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />ich vel kumen in dain hoiz mit brandopfer,</para>
  <para style="q" vid="PSA 66:13">ich vel dir batsoln maine nedrim,<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />vos maine lipn hobn aroisgelozt,</para>
  <para style="q" vid="PSA 66:14">un main moil hot tsugezogt in main noit.<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />fete brandopfer vel ich dir oifbrengen,</para>
  <para style="q" vid="PSA 66:15">mit demfung fun viders;</para>
  <para style="q" vid="PSA 66:15">ich vel machn rinder mit bek.</para>
  <para style="q" vid="PSA 66:15">Selah.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />kumt hert, ale yirei Hashem,</para>
  <para style="q" vid="PSA 66:16">un ich vel dertseiln vos er hot geton tsu main zel.<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />ich hob gerufn tsu im mit main moil,</para>
  <para style="q" vid="PSA 66:17">un er iz geven derhoibn oif main tsung.<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />ven ich volt oisgeveilt umrecht in main hartsn,</para>
  <para style="q" vid="PSA 66:18">volt nisht tsugehert Adonoi.<verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />ober Elokim hot tsugehert,</para>
  <para style="q" vid="PSA 66:19">er hot farnumen dem kol fun main tfile.<verse eid="PSA 66:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />geloibt iz Elokim vos er hot nisht opgeton main tfile,</para>
  <para style="q" vid="PSA 66:20">un zain chesed fun mir.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" pubnumber="סז" sid="PSA 67" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 67:1" />far dem gezangmaister, mit struneshpil; a mizmor, a gezang.<verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 67:2" /> Elokim zol undz laitzelikn un undz bentshn,</para>
  <para style="q" vid="PSA 67:2">er zol derlaichtn zain ponem oif undz,</para>
  <para style="q" vid="PSA 67:2">Selah,<verse eid="PSA 67:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 67:3" /> kedei me zol visen oif der erd dain veg,</para>
  <para style="q" vid="PSA 67:3">tsvishn ale felker dain yeshue.<verse eid="PSA 67:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 67:4" /> loibn veln dich di felker, o Elokim,</para>
  <para style="q" vid="PSA 67:4">loibn veln dich di felker ale.<verse eid="PSA 67:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 67:5" /> zich freyen un zingen veln di umes,</para>
  <para style="q" vid="PSA 67:5">vorem du mishpetst di felker mit yoisher,</para>
  <para style="q" vid="PSA 67:5">un di umes, zei firstu oif der erd.</para>
  <para style="q" vid="PSA 67:5">Selah.<verse eid="PSA 67:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 67:6" /> loibn veln dich di felker, o Elokim,</para>
  <para style="q" vid="PSA 67:6">loibn veln dich di felker ale.<verse eid="PSA 67:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 67:7" /> di erd git ir frucht,</para>
  <para style="q" vid="PSA 67:7">bentshn vet undz Elokim Elokeinu,<verse eid="PSA 67:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 67:8" /> bentshn vet undz Elokim</para>
  <para style="q" vid="PSA 67:8">un im veln forchtn ale ekn fun der erd.<verse eid="PSA 67:8" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" pubnumber="סח" sid="PSA 68" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 68:1" />far dem gezangmaister; fun Dovidn a mizmor, a gezang.<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 68:2" /> Elokim vet oifshtein, veln tseshpreit vern zaine faint,</para>
  <para style="q" vid="PSA 68:2">un zaine sonem veln antloifn far im.<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 68:3" /> vi roich vert tsetribn, vestu zei tsetraibn;</para>
  <para style="q" vid="PSA 68:3">vi vaks tsegeit far faier,</para>
  <para style="q" vid="PSA 68:3">veln untergein di reshoim far Elokim.<verse eid="PSA 68:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 68:4" /> un di tsadikim veln zich freyen;</para>
  <para style="q" vid="PSA 68:4">zei veln zain lustik far Elokim,</para>
  <para style="q" vid="PSA 68:4">un kveln mit simche.<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 68:5" /> zingt tsu Elokim, bazingt zain nomen,</para>
  <para style="q" vid="PSA 68:5">derheibt dem vos rait durch di himlen –</para>
  <para style="q" vid="PSA 68:5">Hashem iz zain nomen –</para>
  <para style="q" vid="PSA 68:5">un freit zich far im.<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 68:6" /> der foter fun yesoimim, un der richter fun almones,</para>
  <para style="q" vid="PSA 68:6">iz Elokim in zain heiliker voinung.<verse eid="PSA 68:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 68:7" /> Elokim bazetst di elnde in a heim,</para>
  <para style="q" vid="PSA 68:7">er brengt arois di gefangene in glik;</para>
  <para style="q" vid="PSA 68:7">nor di opkerer blaibn in trikenish.<verse eid="PSA 68:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 68:8" /> Elokim, az du bist aroisgegangen farois far dain folk,</para>
  <para style="q" vid="PSA 68:8">az du host geshpraizt durch der vistenish,</para>
  <para style="q" vid="PSA 68:8">Selah,<verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 68:9" /> hot di erd getsitert, oich di himlen hobn getrift far Elokim;</para>
  <para style="q" vid="PSA 68:9">der doziker Sinai – far Elokim, Elokei Yisroel.<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 68:10" /> a regn fun shefe hostu aropgezipt, Elokim,</para>
  <para style="q" vid="PSA 68:10">az dain nachle iz farshmacht geven, hostu zi oifgericht.<verse eid="PSA 68:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 68:11" /> dain stade hot zich bazetst derin;</para>
  <para style="q" vid="PSA 68:11">hostu in dain gutskeit, Elokim, ongebreit far di orime.<verse eid="PSA 68:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 68:12" /> Adonoi hot gegebn dos vort –</para>
  <para style="q" vid="PSA 68:12">mevaserot a groise machne.<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 68:13" /> mlochim fun machnus loifn-antloifn,</para>
  <para style="q" vid="PSA 68:13">un di shtubzitserin teilt roib.<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 68:14" /> tsi vilt ir lign tsvishn di shofgeheftn?</para>
  <para style="q" vid="PSA 68:14">di fliglen fun der toib zainen mit zilber badekt,</para>
  <para style="q" vid="PSA 68:14">un ire fledern mit glentsendik gold.<verse eid="PSA 68:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 68:15" /> az Shaddai hot tseshpreit di mlochim in ir,</para>
  <para style="q" vid="PSA 68:15">hot es geshneit oif Tsalmon.<verse eid="PSA 68:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 68:16" /> a barg fun Elokim iz barg Bashan,</para>
  <para style="q" vid="PSA 68:16">a barg fun shpitsn iz barg Bashan.<verse eid="PSA 68:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 68:17" /> vos kukt ir krum, ir filshpitsike berg,</para>
  <para style="q" vid="PSA 68:17">oif dem barg vos Elokim hot far zain voinung geglust,</para>
  <para style="q" vid="PSA 68:17">vu Hashem vet oich ruen oif eibik?<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 68:18" /> di raitvegn fun Elokim zainen tsentoizntn,</para>
  <para style="q" vid="PSA 68:18">toizntn oif toizntn;</para>
  <para style="q" vid="PSA 68:18">Adonoi iz tsvishn zei vi oif Sinai in heilikeit.<verse eid="PSA 68:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 68:19" /> bist aroifgegangen in der heich,</para>
  <para style="q" vid="PSA 68:19">host gefangen a gefang,</para>
  <para style="q" vid="PSA 68:19">host genumen matonus in mentshn;</para>
  <para style="q" vid="PSA 68:19">az oich tsvishn di opkerer zol ruen Hashem Elokim.<verse eid="PSA 68:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 68:20" /> geloibt iz Adonoi,</para>
  <para style="q" vid="PSA 68:20">tog far tog tut er undz trogn;</para>
  <para style="q" vid="PSA 68:20">El iz undzer yeshue.</para>
  <para style="q" vid="PSA 68:20">Selah.<verse eid="PSA 68:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 68:21" /> HaEl iz undz an El fun yeshues,</para>
  <para style="q" vid="PSA 68:21">un bai Hashem Adonoi zainen di oisvegn fun toit.<verse eid="PSA 68:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 68:22" /> far vor, Elokim vet tselechern dem kop fun zaine faint,</para>
  <para style="q" vid="PSA 68:22">dem horikn sharbn fun dem vos geit in zaine zind.<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 68:23" /> Adonoi zogt: fun Bashan vel ich umkeren,</para>
  <para style="q" vid="PSA 68:23">ich vel umkeren fun di tifenishn fun yam;<verse eid="PSA 68:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 68:24" /> kedei zolst tunken in blut dain fus,</para>
  <para style="q" vid="PSA 68:24">di tsung fun daine hint zol hobn ir chelek fun di faint.<verse eid="PSA 68:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 68:25" /> me kukt-tsu daine geiungen, Elokim,</para>
  <para style="q" vid="PSA 68:25">di geiungen tsu main El, main kinig, in heiliktum.<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 68:26" /> farois geyen di zinger, noch dem di shpiler,</para>
  <para style="q" vid="PSA 68:26">in mitn fun yungfroin vos poiklen.<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 68:27" /> in gezemlen loibt Elokim,</para>
  <para style="q" vid="PSA 68:27">loibt dem har Hashem, ir fun kval fun Yisroel.<verse eid="PSA 68:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 68:28" /> on iz Binyamin der yingster, zeyer geveltiker,</para>
  <para style="q" vid="PSA 68:28">di harn fun Yehudah mit zeyer machne,</para>
  <para style="q" vid="PSA 68:28">di harn fun Zevulun, di harn fun Naftali.<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 68:29" /> dain G-t zol bafeln dain shtarkeit;</para>
  <para style="q" vid="PSA 68:29">shtark zich, Elokim, du vos host geton far undz.<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 68:30" /> fun dain heichl in Yerushalayim;</para>
  <para style="q" vid="PSA 68:30">zoln mlochim dir brengen matonus.<verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 68:31" /> shrai on oif der chaye funem vaserror,</para>
  <para style="q" vid="PSA 68:31">oifn gezeml oksen mit di kelber-felker,</para>
  <para style="q" vid="PSA 68:31">zei zoln zich tsu di fis vorfn mit zilbershtiker;</para>
  <para style="q" vid="PSA 68:31">er zol tseshpreitn di umes vos bageren milchomes.<verse eid="PSA 68:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 68:32" /> srores zoln kumen fun Mitsrayim,</para>
  <para style="q" vid="PSA 68:32">Kush zol oisshtrekn ire hent tsu Elokim.<verse eid="PSA 68:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" altnumber="32" sid="PSA 68:33" /> ir kinigraichn fun der erd, zingt tsu Elokim,</para>
  <para style="q" vid="PSA 68:33">shpilt tsu Adonoi,</para>
  <para style="q" vid="PSA 68:33">Selah;<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" altnumber="33" sid="PSA 68:34" /> tsu dem vos rait oif di uralte himlen fun di himlen;</para>
  <para style="q" vid="PSA 68:34">ze, er lozt arois zain kol, a machtikn kol.<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" altnumber="34" sid="PSA 68:35" /> git shtarkeit tsu Elokim;</para>
  <para style="q" vid="PSA 68:35">iber Yisroel iz zain groiskeit,</para>
  <para style="q" vid="PSA 68:35">un zain shtarkeit in di volkens.<verse eid="PSA 68:35" /></para>
  <para style="q">
    <verse number="36" style="v" altnumber="35" sid="PSA 68:36" /> Elokim iz forchtik fun daine heiliktumen;</para>
  <para style="q" vid="PSA 68:36">El fun Yisroel, er git shtarkeit un macht tsum folk;</para>
  <para style="q" vid="PSA 68:36">geloibt iz Elokim.<verse eid="PSA 68:36" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" pubnumber="סט" sid="PSA 69" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 69:1" />far dem gezangmaister, oif Sheshanim; fun Dovidn.<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 69:2" /> helf mich, Elokim,</para>
  <para style="q" vid="PSA 69:2">vorem dos vaser iz gekumen biz der haldz.<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 69:3" /> ich bin aingezunken in a tifn zump,</para>
  <para style="q" vid="PSA 69:3">un nishto kein bashtand;</para>
  <para style="q" vid="PSA 69:3">ich bin gekumen in tife vasern,</para>
  <para style="q" vid="PSA 69:3">un der shtrom hot mich farfleitst.<verse eid="PSA 69:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 69:4" /> ich bin mid fun main rufn,</para>
  <para style="q" vid="PSA 69:4">main kel iz fartriknt,</para>
  <para style="q" vid="PSA 69:4">di oign geyen mir ois harndik oif main G-t.<verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 69:5" /> mer vi di hor fun main kop</para>
  <para style="q" vid="PSA 69:5">zainen maine umzistike sonem;</para>
  <para style="q" vid="PSA 69:5">shtark zainen maine fartiliker, maine faint far gornisht;</para>
  <para style="q" vid="PSA 69:5">vos ich hob nisht gegzlt</para>
  <para style="q" vid="PSA 69:5">muz ich derum opgebn.<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 69:6" /> Elokim, du veist main narishkeit,</para>
  <para style="q" vid="PSA 69:6">un maine farshuldikungen zainen fun dir nisht farhoiln.<verse eid="PSA 69:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 69:7" /> zoln nisht in biesh blaibn durch mir daine hofer,</para>
  <para style="q" vid="PSA 69:7">du Adonoi Hashem Tseva'ot;</para>
  <para style="q" vid="PSA 69:7">zoln nisht farshemt vern durch mir daine zucher,</para>
  <para style="q" vid="PSA 69:7">Elokei Yisroel.<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 69:8" /> vorem fun dainet vegen hob ich gelitn charpe,</para>
  <para style="q" vid="PSA 69:8">a shand hot badekt main ponem.<verse eid="PSA 69:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 69:9" /> farfremdt bin ich gevorn tsu maine brider,</para>
  <para style="q" vid="PSA 69:9">un vildfremd tsu di zin fun main muter.<verse eid="PSA 69:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 69:10" /> vorem der tsorn far dain hoiz hot mich gegesn,</para>
  <para style="q" vid="PSA 69:10">un di lesterungen fun daine lesterer zainen gefaln oif mir.<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 69:11" /> un hob ich oisgeveint in fasten main zel,</para>
  <para style="q" vid="PSA 69:11">iz dos mir tsu lesterung gevorn.<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 69:12" /> un hob ich gemacht zak main kleid,</para>
  <para style="q" vid="PSA 69:12">bin ich bai zei tsum shprichvort gevorn.<verse eid="PSA 69:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 69:13" /> es redn fun mir di toierzitser,</para>
  <para style="q" vid="PSA 69:13">un ich bin dos gezang fun di vaintrinker.<verse eid="PSA 69:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 69:14" /> ober ich – main tfile tsu dir, Hashem, iz:</para>
  <para style="q" vid="PSA 69:14">a sheh fun bavilikung;</para>
  <para style="q" vid="PSA 69:14">Elokim, in dain grois genod</para>
  <para style="q" vid="PSA 69:14">entfer mir mit dain emeser yeshue.<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 69:15" /> zai mich matsl fun dem leim,</para>
  <para style="q" vid="PSA 69:15">az ich zol nisht aingezunken vern;</para>
  <para style="q" vid="PSA 69:15">lomich nitsl vern fun maine faint,</para>
  <para style="q" vid="PSA 69:15">un fun di tife vasern.<verse eid="PSA 69:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 69:16" /> loz mich nisht farfleitsn der shtrom vaser,</para>
  <para style="q" vid="PSA 69:16">un loz mich nisht ainshlingen di tifenish,</para>
  <para style="q" vid="PSA 69:16">un loz nisht tsumachn di grub ir moil iber mir.<verse eid="PSA 69:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 69:17" /> entfer mir, Hashem, vorem gut iz dain chesed;</para>
  <para style="q" vid="PSA 69:17">loit dain grois derbaremung ker zich tsu mir.<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 69:18" /> un zolst nisht farborgen dain ponem fun dain knecht,</para>
  <para style="q" vid="PSA 69:18">vorem mir iz eng; entfer mir gich.<verse eid="PSA 69:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 69:19" /> genen tsu main zel, leiz zi ois,</para>
  <para style="q" vid="PSA 69:19">koif mich ois fun vegen maine faint.<verse eid="PSA 69:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 69:20" /> du veist main charpe un main bushe un main shand,</para>
  <para style="q" vid="PSA 69:20">far dir zainen ale maine driker.<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 69:21" /> a charpe tsebrecht main harts, un ich bin chorev;</para>
  <para style="q" vid="PSA 69:21">un ich hob gehoft oif badoier, un nishto,</para>
  <para style="q" vid="PSA 69:21">un oif treister, un nisht gefunen.<verse eid="PSA 69:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 69:22" /> un zei hobn araingeton gift in main shpaiz,</para>
  <para style="q" vid="PSA 69:22">un far main dorsht gibn zei mir trinken esik.<verse eid="PSA 69:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 69:23" /> zol zeyer tish vos far zei, vern far a nets,</para>
  <para style="q" vid="PSA 69:23">un in mitn fun frid, far a pastke.<verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 69:24" /> zoln zeyere oign fintster vern nisht tsu zen,</para>
  <para style="q" vid="PSA 69:24">un zeyere lendn mach vaklen tamid.<verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 69:25" /> gis ois oif zei dain kaas,</para>
  <para style="q" vid="PSA 69:25">un dain grimtsorn zol zei dergreichn.<verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 69:26" /> zol zeyer Yashuv zain farvist,</para>
  <para style="q" vid="PSA 69:26">in zeyere getseltn zol nisht zain kein bavoiner.<verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 69:27" /> vorem dem vos du host geshlogn roidefn zei,</para>
  <para style="q" vid="PSA 69:27">un fun dem veitog fun daine farvundte dertseiln zei zich.<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 69:28" /> leig tsu zind oif zeyer zind,</para>
  <para style="q" vid="PSA 69:28">un zoln zei nisht tsukumen tsu dain gerechtikeit.<verse eid="PSA 69:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 69:29" /> zoln zei oisgemekt vern fun buch fun di lebedike,</para>
  <para style="q" vid="PSA 69:29">un mit di gerechte zoln zei nisht farshribn vern.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 69:30" /> ober ich bin orim un tseveitokt,</para>
  <para style="q" vid="PSA 69:30">zol dain hilf, Elokim, mich derheichn.<verse eid="PSA 69:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 69:31" /> ich vel rimen dem nomen fun Elokim mit gezang,</para>
  <para style="q" vid="PSA 69:31">un vel im greisn mit loib.<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 69:32" /> un dos vet zain beser bai Hashem</para>
  <para style="q" vid="PSA 69:32">vi an oks oder yunger oks bahornt, bakloit.<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" altnumber="32" sid="PSA 69:33" /> zoln zen di gedrikte, un zich freyen;</para>
  <para style="q" vid="PSA 69:33">ir vos zucht Elokim, zol oiflebn aier harts!<verse eid="PSA 69:33" /></para>
  <para style="q">
    <verse number="34" style="v" altnumber="33" sid="PSA 69:34" /> vorem Hashem hert tsu di baderftike,</para>
  <para style="q" vid="PSA 69:34">un zaine gefangene tut er nisht farachten.<verse eid="PSA 69:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" altnumber="34" sid="PSA 69:35" /> loibn veln im himel un erd,</para>
  <para style="q" vid="PSA 69:35">di yamen un alts vos vidment in zei.<verse eid="PSA 69:35" /></para>
  <para style="q">
    <verse number="36" style="v" altnumber="35" sid="PSA 69:36" /> vorem Elokim vet helfn Tsiyon,</para>
  <para style="q" vid="PSA 69:36">un vet boien di shtet fun Yehudah,</para>
  <para style="q" vid="PSA 69:36">un zei veln zich dortn bazetsn, un zi yarshen.<verse eid="PSA 69:36" /></para>
  <para style="q">
    <verse number="37" style="v" altnumber="36" sid="PSA 69:37" /> un der zomen fun zaine knecht vet zi arben,</para>
  <para style="q" vid="PSA 69:37">un di libhober fun zain nomen veln voinen in ir.<verse eid="PSA 69:37" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" pubnumber="ע" sid="PSA 70" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 70:1" />far dem gezangmaister; fun Dovidn, oif a dermonung.<verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 70:2" /> Elokim, mich matsl tsu zain,</para>
  <para style="q" vid="PSA 70:2">Hashem, tsu main hilf, tu ailn.<verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 70:3" /> zoln farshemt un tsu shand vern</para>
  <para style="q" vid="PSA 70:3">di vos zuchn main lebn;</para>
  <para style="q" vid="PSA 70:3">zoln optretn ahinter un zich shemen</para>
  <para style="q" vid="PSA 70:3">di vos vintshn mir beiz.<verse eid="PSA 70:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 70:4" /> zoln zich tsurikkern fun vegen zeyer shand</para>
  <para style="q" vid="PSA 70:4">di vos zogn: aha! aha!<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 70:5" /> zoln lustik zain un zich freyen mit dir</para>
  <para style="q" vid="PSA 70:5">ale vos zuchn dich.</para>
  <para style="q" vid="PSA 70:5">un zoln tamid zogn: gegreist zol zain G-t!</para>
  <para style="q" vid="PSA 70:5">di vos hobn lib dain yeshue.<verse eid="PSA 70:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 70:6" /> ober ich bin orim un baderftik,</para>
  <para style="q" vid="PSA 70:6">Elokim, tu ailn tsu mir;</para>
  <para style="q" vid="PSA 70:6">du bist main hilf, un der vos macht mich antrinen;</para>
  <para style="q" vid="PSA 70:6">Hashem, zolst zich nisht zamen.<verse eid="PSA 70:6" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" pubnumber="עא" sid="PSA 71" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1" />in dir, Hashem, tu ich mich shitsn,</para>
  <para style="q" vid="PSA 71:1">lomich kein mol nisht farshemt vern.<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />in dain gerechtikeit zolstu mich matsl zain,</para>
  <para style="q" vid="PSA 71:2">un mich machn antrinen;</para>
  <para style="q" vid="PSA 71:2">naig tsu dain oier tsu mir, un helf mich.<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />zai mir far a feldz fun bashitsung</para>
  <para style="q" vid="PSA 71:3">vuhin tamid tsu kumen;</para>
  <para style="q" vid="PSA 71:3">basher mir tsu helfn,</para>
  <para style="q" vid="PSA 71:3">vorem du bist main feldz un main festung.<verse eid="PSA 71:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />main G-t, mach mich antrinen fun der hant fun roshe,</para>
  <para style="q" vid="PSA 71:4">fun foist fun dem farbrecher un driker.<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />vorem du bist main hofenung, Hashem Adonoi,</para>
  <para style="q" vid="PSA 71:5">main farzicherung fun main yugnt on.<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />oif dir hob ich zich ongelent fun muterlaib,</para>
  <para style="q" vid="PSA 71:6">fun main muters ingeveid host du mich aroisgetsoign;</para>
  <para style="q" vid="PSA 71:6">main loib iz tamid fun dir.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />vi a beizvunder bin ich gevorn bai fil,</para>
  <para style="q" vid="PSA 71:7">ober du bist main shtarke bashitsung.<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />main moil iz ongefilt mit dain loib,</para>
  <para style="q" vid="PSA 71:8">a gantsn tog mit dain rimung.<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />zolst mich nisht avekvarfn in tsait fun ziknh,</para>
  <para style="q" vid="PSA 71:9">az maine koiches geyen ois, zolstu mich nisht farlozen.<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />vorem maine faint redn vegen mir,</para>
  <para style="q" vid="PSA 71:10">un di loierer oif main zel eetshn zich in einem,<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />azoi tsu zogn: Elokim hot im farlozen;</para>
  <para style="q" vid="PSA 71:11">yogt noch un chapt im,</para>
  <para style="q" vid="PSA 71:11">vorem nishto ver zol matsl zain.<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />Elokim, zolst zich nisht dervaitern fun mir;</para>
  <para style="q" vid="PSA 71:12">main G-t, ail mir tsu hilf.<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />zoln farshemt vern, zoln oisgein</para>
  <para style="q" vid="PSA 71:13">di sonem fun main lebn;</para>
  <para style="q" vid="PSA 71:13">zoln badekt vern mit charpe un shand</para>
  <para style="q" vid="PSA 71:13">di vos zuchn mir beiz.<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />ober ich vel tamid hofn,</para>
  <para style="q" vid="PSA 71:14">un vel noch tsuleigen tsu al dain loib.<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />main moil vet dertseiln dain gerechtikeit,</para>
  <para style="q" vid="PSA 71:15">a gantsn tog dain hilf;</para>
  <para style="q" vid="PSA 71:15">vorem ich ken nisht oisdertseilen.<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />ich vel kumen mit di gevuros fun Adonoi Hashem,</para>
  <para style="q" vid="PSA 71:16">ich vel dermonen dain gerechtikeit, daine alein.<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />Elokim, host mich gelernt fun main yugnt on,</para>
  <para style="q" vid="PSA 71:17">un biz aher dertseil ich daine vunder.<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />un oich biz ziknh un groer elter, Elokim,</para>
  <para style="q" vid="PSA 71:18">zolstu mich nisht farlozen,</para>
  <para style="q" vid="PSA 71:18">biz ich vel dertseiln dain macht tsum andern dor,</para>
  <para style="q" vid="PSA 71:18">tsu itlechn vos vet kumen, dain gevure.<verse eid="PSA 71:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />yo, dain gerechtikeit, Elokim, iz bizn himel,</para>
  <para style="q" vid="PSA 71:19">du vos host oifgeton grois.</para>
  <para style="q" vid="PSA 71:19">Elokim, ver iz dain glaichn?<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />du vos host mich gelozt zen fil tsores un beizn,</para>
  <para style="q" vid="PSA 71:20">vest vider mich oiflebn,</para>
  <para style="q" vid="PSA 71:20">un fun di tehomen fun der erd</para>
  <para style="q" vid="PSA 71:20">vestu vider mich oifbrengen.<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />vest mern main gdulh,</para>
  <para style="q" vid="PSA 71:21">un vest vider mich treistn.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />drumech vel ich dich loibn oif a gitar –</para>
  <para style="q" vid="PSA 71:22">dain getraishaft, main G-t;</para>
  <para style="q" vid="PSA 71:22">ich vel shpiln tsu dir oif a harf,</para>
  <para style="q" vid="PSA 71:22">du heiliker fun Yisroel.<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />maine lipn veln zingen,</para>
  <para style="q" vid="PSA 71:23">az ich vel shpiln tsu dir,</para>
  <para style="q" vid="PSA 71:23">un main zel vos du host oisgeleizt.<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />oich main tsung a gantsn tog</para>
  <para style="q" vid="PSA 71:24">vet redn dain gerechtikeit,</para>
  <para style="q" vid="PSA 71:24">vorem farshemt, vorem tsu shand vern</para>
  <para style="q" vid="PSA 71:24">di vos zuchn mir beiz.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" pubnumber="עב" sid="PSA 72" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 72:1" />fun Shlomoen.</para>
  <para style="q" vid="PSA 72:1">
    <char style="va">1</char> Elokim, gib daine mishpotim tsum melech,</para>
  <para style="q" vid="PSA 72:1">un dain gerechtikeit tsum melechs zun;<verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />er zol mishpetn dain folk mit rechtfartikeit,</para>
  <para style="q" vid="PSA 72:2">un daine orime loit recht.<verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />di berg zoln trogn sholem tsum folk,</para>
  <para style="q" vid="PSA 72:3">un di heichn – durch gerechtikeit.<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />er zol mishpetn di orime fun folk,</para>
  <para style="q" vid="PSA 72:4">er zol helfn di kinder fun evyon,</para>
  <para style="q" vid="PSA 72:4">un tsedrikn dem roiber.<verse eid="PSA 72:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />me zol dich forchtn vi lang di zun vet zain,</para>
  <para style="q" vid="PSA 72:5">un azoi vi di levone, oif dor-doires.<verse eid="PSA 72:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />er zol nidern vi regn oif geshnitn groz,</para>
  <para style="q" vid="PSA 72:6">vi shpreiregn vos bagist di erd.<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />blien in zaine teg zol der tsadik,</para>
  <para style="q" vid="PSA 72:7">un a shefe fun frid biz di levone vet mer nisht zain.<verse eid="PSA 72:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />un er zol geveltikn fun yam biz yam,</para>
  <para style="q" vid="PSA 72:8">un fun dem taich biz di ekn fun der erd.<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />far im zoln knien di midber-lait,</para>
  <para style="q" vid="PSA 72:9">un zaine faint zoln lekn dem shtoib.<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />di mlochim fun Tarshish un di indzelen zoln minche brengen,</para>
  <para style="q" vid="PSA 72:10">di mlochim fun Sheva un Seva zoln matonus brengen.<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />un bukn zoln zich far im ale mlochim,</para>
  <para style="q" vid="PSA 72:11">ale felker zoln im dinen.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />vorem er vet matsl zain dem evyon vos shrait,</para>
  <para style="q" vid="PSA 72:12">un dem oreman vos hot nisht kein helfer.<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />er vet zich derbaremen oifn oreman un evyon,</para>
  <para style="q" vid="PSA 72:13">un di nefoshes fun di evyonim vet er helfn.<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />fun drikung un fun roib vet er oisleizen zeyer zel,</para>
  <para style="q" vid="PSA 72:14">un taier vet zain zeyer blut in zaine oign.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />derum zol er lebn,</para>
  <para style="q" vid="PSA 72:15">un me zol im gebn fun dem gold fun Sheva;</para>
  <para style="q" vid="PSA 72:15">un me zol mispalel zain far im tamid,</para>
  <para style="q" vid="PSA 72:15">a gantsn tog zol men im bentshn.<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />er zol zain vi a geretenish fun tvue in land,</para>
  <para style="q" vid="PSA 72:16">oif di shpits berg zol roishn vi der Levanon zain frucht;</para>
  <para style="q" vid="PSA 72:16">un zei zoln shprotsn fun der shtot</para>
  <para style="q" vid="PSA 72:16">azoi vi groz fun der erd.<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />zain nomen zol zain eibik,</para>
  <para style="q" vid="PSA 72:17">azoi lang vi di zun zol blien zain nomen,</para>
  <para style="q" vid="PSA 72:17">un me zol zich bentshn mit im;</para>
  <para style="q" vid="PSA 72:17">ale felker zoln im rimen.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />Baruch Hashem Elokim, Elokei Yisroel,</para>
  <para style="q" vid="PSA 72:18">vos er alein tut vunder;<verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />un geloibt zain prachtiker nomen oif eibik;</para>
  <para style="q" vid="PSA 72:19">un di gantse erd zol ongefilt vern mit zain pracht.</para>
  <para style="q" vid="PSA 72:19">Omein un Omein!<verse eid="PSA 72:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />geendikt di tfilut fun Dovid dem zun fun Yishaien.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" pubnumber="עג" sid="PSA 73" />
  <para style="ms">driter sefer</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 73:1" />a mizmor fun ASafn.</para>
  <para style="q" vid="PSA 73:1">
    <char style="va">1</char> far vor, Elokim iz gut tsu Yisroel,</para>
  <para style="q" vid="PSA 73:1">tsu di vos hobn a rein harts.<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />un ich – maine fis hobn kemat zich gebeigt,</para>
  <para style="q" vid="PSA 73:2">shier zich nisht oisgeglitsht hobn maine trit.<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />vorem ich hob mekane geven di mutvilike,</para>
  <para style="q" vid="PSA 73:3">az dos glik fun di reshoim fleg ich zen.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />vorem zei hobn nisht kein yesurim,</para>
  <para style="q" vid="PSA 73:4">un zeyer laib iz gezunt.<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />di maternish fun laitn hobn zei nisht,</para>
  <para style="q" vid="PSA 73:5">un zei vern nisht geplogt azoi vi mentshn.<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />derum iz gaive zeyer haldzband,</para>
  <para style="q" vid="PSA 73:6">vi an ontuechts viklt zei ain umrecht.<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />fun fets krichn arois zeyere oign,</para>
  <para style="q" vid="PSA 73:7">di farvelenishn fun hartsn loifn iber.<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />zei shpetn un redn mit beizkeit roib,</para>
  <para style="q" vid="PSA 73:8">fun oiben arop redn zei.<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />zei shteln on kegen himel zeyer moil,</para>
  <para style="q" vid="PSA 73:9">un zeyer tsung geit um oif der erd.<verse eid="PSA 73:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />derum kert zich zain folk ahin tsu,</para>
  <para style="q" vid="PSA 73:10">vorem vaser fun shefe vert gezupt bai zei.<verse eid="PSA 73:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11" />un zei zogn: vi ken El visen?</para>
  <para style="q" vid="PSA 73:11">un: iz den do visen baim Elyon Oibershter?<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />ze, dos zainen di reshoim,</para>
  <para style="q" vid="PSA 73:12">un eibik beshalve, mern zei guts.<verse eid="PSA 73:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />bloiz umnisht hob ich gelaitert main harts,</para>
  <para style="q" vid="PSA 73:13">un gevashn in reinkeit maine hent;<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />vorem ich bin geven geplogt a gantsn tog,</para>
  <para style="q" vid="PSA 73:14">un ale frimorgn iz geven main shtrof.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />az ich volt gezogt: ich vel redn azoi,</para>
  <para style="q" vid="PSA 73:15">volt ich doch on dem dor fun daine kinder gefelsht.<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />ober az ich hob zich fartracht dos tsu farshtein,</para>
  <para style="q" vid="PSA 73:16">iz dos geven umrecht in maine oign.<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />biz ich bin gekumen in di heiliktumen fun El:</para>
  <para style="q" vid="PSA 73:17">hob ich farshtanen zeyer sof.<verse eid="PSA 73:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />far vor, oif a glitsh shtelstu zei,</para>
  <para style="q" vid="PSA 73:18">varfst zei arop tsum untergang.<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />vi vern zei tsu vist in a rege!</para>
  <para style="q" vid="PSA 73:19">zei ekn zich, zei vern farlendt fun shrekenishn.<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />vi a cholem az me chapt zich oif,</para>
  <para style="q" vid="PSA 73:20">azoi, Adonoi, vachndik, farachtstu zeyer bild.<verse eid="PSA 73:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />yo, main harts flegt zain farzoiert,</para>
  <para style="q" vid="PSA 73:21">un in di nirn flegt mir shtechn;<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />vail ich bin geven fargrebt, un fleg nisht visen;</para>
  <para style="q" vid="PSA 73:22">vi a beheime bin ich geven far dir.<verse eid="PSA 73:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />ober ich bin tamid bai dir,</para>
  <para style="q" vid="PSA 73:23">du haltst mich bai der rechter hant.<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />mit dain eitse vestu mich firn,</para>
  <para style="q" vid="PSA 73:24">un tsu koved vestu mich brengen.<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />vemen noch hob ich in himel?</para>
  <para style="q" vid="PSA 73:25">un tsu dir bager ich nisht keinem oif der erd.<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />main laib un main harts geit ois,</para>
  <para style="q" vid="PSA 73:26">der feldz fun main hartsn un main chelek iz eibik Elokim.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />vorem, ze, di vaite fun dir veln untergein,</para>
  <para style="q" vid="PSA 73:27">du farshnaidst itlechn vos kert zich op fun dir far hurdum.<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />ober ich – di nontkeit fun Elokim iz main guts,</para>
  <para style="q" vid="PSA 73:28">ich hob gemacht in Adonoi Hashem main bashitsung,</para>
  <para style="q" vid="PSA 73:28">kedei tsu dertseiln vegen ale daine verk.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" pubnumber="עד" sid="PSA 74" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 74:1" />a batrachtung fun ASafn.</para>
  <para style="q" vid="PSA 74:1">
    <char style="va">1</char> far vos, Elokim, hostu undz farlozen oif eibik?</para>
  <para style="q" vid="PSA 74:1">far vos brent dain tsorn oif di shof fun dain fiterung?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />dermon zich on dain eide vos du host oisgekoift a mol,</para>
  <para style="q" vid="PSA 74:2">vos du host oisgeleizt tsum sheyvet fun dain arav;</para>
  <para style="q" vid="PSA 74:2">on dem barg Tsiyon vos du host oif im gerut.<verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />heib oif daine trit tsu di eibike churves;</para>
  <para style="q" vid="PSA 74:3">alts hot tsebrochn der soine in heiliktum.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />daine faint hobn gebrilt in mitn fun dain zamlort,</para>
  <para style="q" vid="PSA 74:4">zeyere tseichns hobn zei oifgeshtelt far tseichns.<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />es hot zich gedacht, vi me volt oifheibn in der heich</para>
  <para style="q" vid="PSA 74:5">hek oifn getsvaig fun a boim.<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />un ot hobn zei ire geshnitsn mit anander,</para>
  <para style="q" vid="PSA 74:6">mit a brechaizn un hamers tsehakt.<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />zei hobn ongetsundn in faier dain mikdash,</para>
  <para style="q" vid="PSA 74:7">tsu der erd hobn zei farshvecht di voinung fun dain nomen.<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />zei hobn gezogt in zeyer hartsn:</para>
  <para style="q" vid="PSA 74:8">lomir zei fartiliken in einem;</para>
  <para style="q" vid="PSA 74:8">zei hobn farbrent ale zamlerter fun El in land.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />undzere tseichns zeen mir nisht,</para>
  <para style="q" vid="PSA 74:9">nishto mer kein novi,</para>
  <para style="q" vid="PSA 74:9">un nishto bai undz ver zol visen biz vanen.<verse eid="PSA 74:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />biz vanen, Elokim, vet lestern der faint?</para>
  <para style="q" vid="PSA 74:10">vet shendn der soine dain nomen nochanand?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />far vos haltstu tsurik dain hant, dain rechte?</para>
  <para style="q" vid="PSA 74:11">tsi zi arois fun dain buzem, farlend.<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />Elokim iz doch main kinig fun eibik on,</para>
  <para style="q" vid="PSA 74:12">er tut yeshues in land.<verse eid="PSA 74:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13" />du host tsebreklt mit dain shtarkeit dem yam,</para>
  <para style="q" vid="PSA 74:13">host tsebrochn di kep fun di shleng oifn vaser.<verse eid="PSA 74:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14" />du host tsehakt di kep fun lioiotn,</para>
  <para style="q" vid="PSA 74:14">im gegebn far shpaiz tsum folk, tsu midber-lait.<verse eid="PSA 74:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15" />du host geshpoltn kvaln un taichn,</para>
  <para style="q" vid="PSA 74:15">du host oisgetriknt machtike shtromen.<verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />dain iz der tog, dain oich di nacht,</para>
  <para style="q" vid="PSA 74:16">du host ongebreit levone un zun.<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />du host oifgeshtelt ale gemarkn fun der erd;</para>
  <para style="q" vid="PSA 74:17">zumer un vinter, zei host du bashafn.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />dermon zich on dem, vi der faint hot gelestert Hashem,</para>
  <para style="q" vid="PSA 74:18">un dos nidertrechtike folk hot geshendt dain nomen.<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />zolst nisht ibergebn tsu a chaye di zel fun dain turtltoib,</para>
  <para style="q" vid="PSA 74:19">zolst nisht fargesen oif eibik dos lebn fun daine orime.<verse eid="PSA 74:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />kuk zich um oif dem bris,</para>
  <para style="q" vid="PSA 74:20">vorem di fintstere vinklen fun der erd</para>
  <para style="q" vid="PSA 74:20">zainen ful mit voinungen fun roib.<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />zol der geshlogener zich nisht umkeren farshemt,</para>
  <para style="q" vid="PSA 74:21">zol der oreman un der evyon loibn dain nomen.<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />shtei oif, Elokim, krig dain krig,</para>
  <para style="q" vid="PSA 74:22">gedenk dain lesterung fun dem nidertrechtikn a gantsn tog.<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />zolst nisht fargesen dem liarem fun daine faint,</para>
  <para style="q" vid="PSA 74:23">dem tuml fun daine kegnshteyer vos geit oif nochanand.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" pubnumber="עה" sid="PSA 75" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 75:1" />far dem gezangmaister; al-taּshchet; a mizmor fun ASafn, a gezang.<verse eid="PSA 75:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 75:2" /> mir loibn dich, Elokim, mir loibn,</para>
  <para style="q" vid="PSA 75:2">un nont iz dain nomen;</para>
  <para style="q" vid="PSA 75:2">me dertseilt daine vunder.<verse eid="PSA 75:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 75:3" /> az ich nem a tsait,</para>
  <para style="q" vid="PSA 75:3">tu ich mishpetn mit yoisher.<verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 75:4" /> megn zich vaklen di erd un ale ire bavoiner,</para>
  <para style="q" vid="PSA 75:4">ich tu bafestikn ire zailn.</para>
  <para style="q" vid="PSA 75:4">Selah.<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 75:5" /> ich zog tsu di mutvilike: ir zolt nisht mutvilikn,</para>
  <para style="q" vid="PSA 75:5">un tsu di reshoim: ir zolt nisht oifheibn dem horn.<verse eid="PSA 75:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 75:6" /> ir zolt nisht oifheibn in der heich aier horn,</para>
  <para style="q" vid="PSA 75:6">nisht redn mit a farshaitn haldz.<verse eid="PSA 75:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 75:7" /> vorem nisht fun mizrech oder fun mayrev,</para>
  <para style="q" vid="PSA 75:7">un nisht fun midber, kumt derheichung.<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 75:8" /> nor Elokim iz der richter:</para>
  <para style="q" vid="PSA 75:8">dem dernidert er, un dem derheicht er.<verse eid="PSA 75:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 75:9" /> vorem a kos iz in der hant fun Hashem,</para>
  <para style="q" vid="PSA 75:9">mit vain vos shoimt, mit mishgetrank ful,</para>
  <para style="q" vid="PSA 75:9">un er gist on derfun;</para>
  <para style="q" vid="PSA 75:9">bloiz di heivn derfun zupn-trinken</para>
  <para style="q" vid="PSA 75:9">ale reshoim fun der erd.<verse eid="PSA 75:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 75:10" /> ober ich vel eibik dertseiln,</para>
  <para style="q" vid="PSA 75:10">ich vel zingen tsum Elokei Yaakov.<verse eid="PSA 75:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 75:11" /> un ale herner fun di reshoim vel ich ophakn;</para>
  <para style="q" vid="PSA 75:11">derheicht veln vern di herner fun di tsadikim.<verse eid="PSA 75:11" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" pubnumber="עו" sid="PSA 76" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 76:1" />far dem gezangmaister, mit struneshpil; a mizmor fun ASafn, a gezang.<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 76:2" /> bakant in Yehudah iz Elokim,</para>
  <para style="q" vid="PSA 76:2">grois iz zain nomen in Yisroel.<verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 76:3" /> un in Shalem iz zain baidl,</para>
  <para style="q" vid="PSA 76:3">un zain voinung in Tsiyon.<verse eid="PSA 76:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 76:4" /> dortn hot er tsebrochn di blitsike failn fun boign,</para>
  <para style="q" vid="PSA 76:4">dem shild un di shverd un milchome.</para>
  <para style="q" vid="PSA 76:4">Selah.<verse eid="PSA 76:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 76:5" /> lichtik bistu, machtiker,</para>
  <para style="q" vid="PSA 76:5">fun di berg fun fartsukung;<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 76:6" /> di shtark-hartsike zenen baroibt,</para>
  <para style="q" vid="PSA 76:6">zei hobn aingeshlofn in zeyer shlof;</para>
  <para style="q" vid="PSA 76:6">un ale heldn hobn nisht gekent gefinen zeyere hent.<verse eid="PSA 76:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 76:7" /> fun dain ongeshrei, Elokei Yaakov,</para>
  <para style="q" vid="PSA 76:7">iz antshlumert gevorn i raiter i ferd.<verse eid="PSA 76:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 76:8" /> du bist forchtik, du,</para>
  <para style="q" vid="PSA 76:8">un ver ken bashtein far dir,</para>
  <para style="q" vid="PSA 76:8">vi bald du bist in kaas?<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 76:9" /> fun himel hostu gelozt hern a din,</para>
  <para style="q" vid="PSA 76:9">di erd hot moire gekrign un iz shtil gevorn,<verse eid="PSA 76:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 76:10" /> az Elokim iz oifgeshtanen tsum mishpot,</para>
  <para style="q" vid="PSA 76:10">tsu helfn ale gedrikte fun der erd.</para>
  <para style="q" vid="PSA 76:10">Selah.<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 76:11" /> far vor, di grimtsorndike veln dich loibn,</para>
  <para style="q" vid="PSA 76:11">dem iberblaib fun grimtsorn vestu aintsamen.<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 76:12" /> tut a neyder un batsolt tsu Hashem Elokeichem;</para>
  <para style="q" vid="PSA 76:12">ale arum im zoln brengen matonus tsum geforchtn.<verse eid="PSA 76:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 76:13" /> er halt ain dos gemit fun firshtn,</para>
  <para style="q" vid="PSA 76:13">er iz forchtik far ale mlochim fun der erd.<verse eid="PSA 76:13" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" pubnumber="עז" sid="PSA 77" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 77:1" />far dem gezangmaister, far Yedutun; fun ASafn a mizmor.<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 77:2" /> main kol iz tsu Elokim, un ich shrai,</para>
  <para style="q" vid="PSA 77:2">main kol iz tsu Elokim, un farnem tsu mir.<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 77:3" /> in tog fun main noit zuch ich Adonoi,</para>
  <para style="q" vid="PSA 77:3">main hant iz oisgeshtrekt bai nacht on oifher,</para>
  <para style="q" vid="PSA 77:3">main zel vil zich nisht treistn.<verse eid="PSA 77:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 77:4" /> az ich dermon zich, Elokim, tu ich brumen,</para>
  <para style="q" vid="PSA 77:4">ich klog, un main gaist fargeit zich.</para>
  <para style="q" vid="PSA 77:4">Selah.<verse eid="PSA 77:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 77:5" /> du haltst tsu di bremen fun maine oign;</para>
  <para style="q" vid="PSA 77:5">ich bin tserudert un ken nisht redn.<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 77:6" /> ich tracht on di teg fun a mol,</para>
  <para style="q" vid="PSA 77:6">on di yorn fun fartsaitn.<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 77:7" /> ich dermon zich main gezang bai nacht,</para>
  <para style="q" vid="PSA 77:7">ich red mit main hartsn,</para>
  <para style="q" vid="PSA 77:7">un es forsht main gaist:<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 77:8" /> vet oif eibik Adonoi farlozen,</para>
  <para style="q" vid="PSA 77:8">un vet mer nisht bavilikn vider?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 77:9" /> iz oisgegangen oif eibik zain chesed?</para>
  <para style="q" vid="PSA 77:9">iz der tsuzog geendikt oif dor-doires?<verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 77:10" /> hot fargesen tsu laitzelikn El?</para>
  <para style="q" vid="PSA 77:10">tsi hot er in tsorn farshlosn zain rachmones?</para>
  <para style="q" vid="PSA 77:10">Selah.<verse eid="PSA 77:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 77:11" /> doch hob ich gezogt: dos iz main tsore,</para>
  <para style="q" vid="PSA 77:11">ober es kenen zich endern di yorn fun der rechter hant funem hechstn.<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 77:12" /> ich dermon di oiftuen fun Hashem,</para>
  <para style="q" vid="PSA 77:12">yo, ich dermon daine vunder fun fartsaitn.<verse eid="PSA 77:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 77:13" /> un ich tracht on al dain verk,</para>
  <para style="q" vid="PSA 77:13">un on daine tuungen tu ich klern.<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 77:14" /> Elokim, in heilikeit iz dain veg;</para>
  <para style="q" vid="PSA 77:14">ver iz a groiser El vi Elokim?<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 77:15" /> du bist HaEl vos tut vunder,</para>
  <para style="q" vid="PSA 77:15">host gelozt visen tsvishn di felker dain shtarkeit.<verse eid="PSA 77:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 77:16" /> host oisgeleizt mitn orem dain folk,</para>
  <para style="q" vid="PSA 77:16">di kinder fun Yaakov un Yosef.</para>
  <para style="q" vid="PSA 77:16">Selah.<verse eid="PSA 77:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 77:17" /> gezen hobn dich di vasern, Elokim,</para>
  <para style="q" vid="PSA 77:17">gezen hobn dich di vasern, hobn zei veyen gekrign,</para>
  <para style="q" vid="PSA 77:17">un getsitert hobn di tehomen.<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 77:18" /> gefleitst vaser hobn di volkens,</para>
  <para style="q" vid="PSA 77:18">a kol hobn aroisgelozt di himlen,</para>
  <para style="q" vid="PSA 77:18">un daine failn zainen umgelofn.<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 77:19" /> der kol fun dain duner iz geven in dem virbl-vint,</para>
  <para style="q" vid="PSA 77:19">blitsn hobn baluchtn di velt,</para>
  <para style="q" vid="PSA 77:19">getsitert un geshturemt hot di erd.<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 77:20" /> durchn yam iz geven dain veg,</para>
  <para style="q" vid="PSA 77:20">un dain shteg durch vasern groise,</para>
  <para style="q" vid="PSA 77:20">un daine trit zainen nisht gemerkt gevorn.<verse eid="PSA 77:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 77:21" /> host gefirt azoi vi shof dain folk,</para>
  <para style="q" vid="PSA 77:21">durch der hant fun Mosheen un Aharonen.<verse eid="PSA 77:21" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" pubnumber="עח" sid="PSA 78" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 78:1" />a batrachtung fun ASafn.</para>
  <para style="q" vid="PSA 78:1">
    <char style="va">1</char> farnem, main folk, main lernung,</para>
  <para style="q" vid="PSA 78:1">naigt aier oier tsu di verter fun main moil.<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />ich vel efenen mit a Mashal main moil,</para>
  <para style="q" vid="PSA 78:2">ich vel redn retenishn fun fartsaitn.<verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />vos mir hobn gehert un mir veisn,</para>
  <para style="q" vid="PSA 78:3">un undzere eltern hobn undz dertseilt,<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />veln mir nisht farhoiln fun zeyere kinder;</para>
  <para style="q" vid="PSA 78:4">dertseilndik dem shpeterdikn dor</para>
  <para style="q" vid="PSA 78:4">di loibn fun Hashem un zain shtarkeit,</para>
  <para style="q" vid="PSA 78:4">un zaine vunder vos er hot geton.<verse eid="PSA 78:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />vorem er hot oifgeshtelt a tseignim in Yaakov,</para>
  <para style="q" vid="PSA 78:5">un a toyre gemacht in Yisroel,</para>
  <para style="q" vid="PSA 78:5">vos er hot bafoiln undzere eltern,</para>
  <para style="q" vid="PSA 78:5">zei tsu machn visen zeyere kinder;<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />kedei visen zol der shpeterdiker dor,</para>
  <para style="q" vid="PSA 78:6">di kinder vos veln geborn vern;</para>
  <para style="q" vid="PSA 78:6">zei zoln oifshtein un dertseiln zeyere kinder.<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />un zei zoln leign oif Elokim zeyer bitochen,</para>
  <para style="q" vid="PSA 78:7">un nisht fargesen di oiftuen fun El,</para>
  <para style="q" vid="PSA 78:7">un zaine gebot zoln zei hitn;<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />un zei zoln nisht zain vi zeyere eltern,</para>
  <para style="q" vid="PSA 78:8">a dor opgekert un vidershpenik,</para>
  <para style="q" vid="PSA 78:8">a dor vos hot nisht gefestikt zain harts,</para>
  <para style="q" vid="PSA 78:8">un nisht getrai geven iz zain gaist tsu El.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />di kinder fun Efrayim, bavofnte boign-shiser,</para>
  <para style="q" vid="PSA 78:9">hobn zich umgekert in tog fun milchome.<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />zei hobn nisht gehit dem bris fun Elokim,</para>
  <para style="q" vid="PSA 78:10">un in zain toyre nisht gevolt gein.<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />un zei hobn fargesen zaine tuungen,</para>
  <para style="q" vid="PSA 78:11">un zaine vunder vos er hot zei bavizn.<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />antkegen far zeyere eltern hot er geton vunder,</para>
  <para style="q" vid="PSA 78:12">in land Mitsrayim, in feld fun Tsoan.<verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />er hot geshpoltn dem yam, un zei aribergefirt,</para>
  <para style="q" vid="PSA 78:13">un oifgeshtelt di vasern vi a stoig.<verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />un er hot zei gefirt mit a volken bai tog,</para>
  <para style="q" vid="PSA 78:14">un di gantse nacht mit a faierdikn licht.<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />er hot geshpoltn feldzn in midber,</para>
  <para style="q" vid="PSA 78:15">un zei ongetrunken zat vi fun tehomen.<verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />un er hot aroisgetsoign flusn fun feldz,</para>
  <para style="q" vid="PSA 78:16">un gemacht nidern vaser vi shtromen.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />ober zei hobn noch vaiter gezindikt tsu im,</para>
  <para style="q" vid="PSA 78:17">tsu vidershpenikn dem Elyon Oibershter in der viste.<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />un zei hobn gepruvet El in zeyer hartsn,</para>
  <para style="q" vid="PSA 78:18">tsu farlangen esen far zeyer gelust.<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />un zei hobn geredt kegen Elokim,</para>
  <para style="q" vid="PSA 78:19">gezogt: ken El greitn a tish in der midber?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />yo, er hot geshlogn dem feldz, un vaser iz geflosn,</para>
  <para style="q" vid="PSA 78:20">un taichn hobn gefleitst,</para>
  <para style="q" vid="PSA 78:20">vet er oich kenen broit gebn?</para>
  <para style="q" vid="PSA 78:20">tsi vet er onbreitn fleish far zain folk?<verse eid="PSA 78:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />derum hot Hashem gehert, un iz in kaas gevorn,</para>
  <para style="q" vid="PSA 78:21">un a faier hot zich ongetsundn in Yaakov,</para>
  <para style="q" vid="PSA 78:21">un far vor, a tsorn iz oifgegangen in Yisroel;<verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />vail zei hobn nisht gegloibt in Elokim,</para>
  <para style="q" vid="PSA 78:22">un zich nisht farzichert oif zain hilf.<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />un er hot bafoiln di volkens fun oiben,</para>
  <para style="q" vid="PSA 78:23">un di tirn fun himel geefent.<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />un er hot gemacht regenen oif zei man tsum esen,</para>
  <para style="q" vid="PSA 78:24">un himel-tvue zei gegebn.<verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />broit fun malachim hot itlecher gegesn,</para>
  <para style="q" vid="PSA 78:25">shpaiz tsu zat hot er zei aropgeshikt.<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />er hot gemacht tsien dem mizrech-vint in himel,</para>
  <para style="q" vid="PSA 78:26">un getribn mit zain shtarkeit dem dorem-vint.<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />un er hot gemacht regenen oif zei fleish vi shtoib,</para>
  <para style="q" vid="PSA 78:27">un vi zamd fun di yamen foiglen gefliglte.<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />un er hot es gelozt faln in mitn fun zeyer lager,</para>
  <para style="q" vid="PSA 78:28">rund arum zeyere voinungen.<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />un zei hobn gegesn, un zainen iberzat gevorn,</para>
  <para style="q" vid="PSA 78:29">un zeyer teive hot er zei gebracht.<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />noch hobn zei zich nisht gehat opgeeklt fun zeyer teive,</para>
  <para style="q" vid="PSA 78:30">zeyer shpaiz iz noch geven in zeyer moil,<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />un der tsorn fun Elokim iz oifgegangen kegen zei,</para>
  <para style="q" vid="PSA 78:31">un er hot geharget fun zeyere shtarkste,</para>
  <para style="q" vid="PSA 78:31">un di yungelait fun Yisroel anidergeleigt.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />bai alem dem hobn zei vider gezindikt,</para>
  <para style="q" vid="PSA 78:32">un nisht gegloibt in zaine vunder.<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />un er hot farlendt vi a hoich zeyere teg,</para>
  <para style="q" vid="PSA 78:33">un zeyere yorn in a behole.<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />az er hot zei geharget, flegn zei im zuchn,</para>
  <para style="q" vid="PSA 78:34">un flegn zich umkeren, un forshn El.<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />un zei hobn zich dermont az Elokim iz zeyer feldz,</para>
  <para style="q" vid="PSA 78:35">un El Elyon iz zeyer oisleizer.<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />un zei hobn im ibergebetn mit zeyer moil,</para>
  <para style="q" vid="PSA 78:36">un mit zeyer tsung flegn zei im lign zogn.<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />ober zeyer harts iz nisht geven fest mit im,</para>
  <para style="q" vid="PSA 78:37">un zei zainen nisht getrai geven in zain bris.<verse eid="PSA 78:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38" />nor er iz a derbaremer,</para>
  <para style="q" vid="PSA 78:38">er iz mechaper oif zind, un brengt nisht um,</para>
  <para style="q" vid="PSA 78:38">un er halt a sach op zain kaas,</para>
  <para style="q" vid="PSA 78:38">un dervekt nisht zain gantsn grimtsorn.<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />un er hot zich dermont az zei zainen fleish,</para>
  <para style="q" vid="PSA 78:39">a hoich vos fargeit, un kert nisht um.<verse eid="PSA 78:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />vifel mol hobn zei im vidershpenikt in midber,</para>
  <para style="q" vid="PSA 78:40">im gekrenkt in der viste!<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />un vider hobn zei gepruvet El,</para>
  <para style="q" vid="PSA 78:41">un dem heilikn fun Yisroel geergert.<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />zei hobn nisht gedacht on zain hant,</para>
  <para style="q" vid="PSA 78:42">on dem tog vos er hot zei oisgeleizt fun faint<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />vi er hot gemacht zaine tseichns in Mitsrayim,</para>
  <para style="q" vid="PSA 78:43">un zaine vunder in feld fun Tsoan;<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />un farkert in blut zeyere taichn,</para>
  <para style="q" vid="PSA 78:44">un zeyere flusn, zei zoln nisht kenen trinken.<verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />er hot ongeshikt oif zei a shvorem flign</para>
  <para style="q" vid="PSA 78:45">vos hot zei oifgegesn,</para>
  <para style="q" vid="PSA 78:45">un di frosh vos hot zei farvist.<verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />un er hot ibergegebn tsum gril zeyer geveks,</para>
  <para style="q" vid="PSA 78:46">un zeyer mi tsum heisherik.<verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />er hot geteit mit hogel zeyer vainshtok,</para>
  <para style="q" vid="PSA 78:47">un zeyere vilde faignbeimer mit frost.<verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />un er hot ibergeentfert tsum hogel zeyer fich,</para>
  <para style="q" vid="PSA 78:48">un zeyere stades tsu blitsn.<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />er hot ongeshikt oif zei dem brand fun zain tsorn,</para>
  <para style="q" vid="PSA 78:49">kaas un grimtsorn un laid,</para>
  <para style="q" vid="PSA 78:49">an onshikenish fun beize shluchim.<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />er hot gemacht a veg far zain tsorn,</para>
  <para style="q" vid="PSA 78:50">er hot nisht farmitn fun toit zeyer zel,</para>
  <para style="q" vid="PSA 78:50">un er hot ibergeentfert zeyer lebn tsu pest.<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />un er hot geshlogn yetveder bechor in Mitsrayim,</para>
  <para style="q" vid="PSA 78:51">di ershtlingen fun kraft, in di getseltn fun Cham.<verse eid="PSA 78:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />un er hot gemacht tsien vi shof zain folk,</para>
  <para style="q" vid="PSA 78:52">un zei gefirt vi a stade in midber.<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />un er hot zei baleit in zicherkeit, un zei hobn nisht geangst,</para>
  <para style="q" vid="PSA 78:53">un zeyere faint hot tsugedekt der yam.<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />un er hot zei gebracht tsu zain heilikn gemark,</para>
  <para style="q" vid="PSA 78:54">tsu dem barg vos zain rechte hant hot zich gekoift.<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />un er hot fartriben fun far zei felker,</para>
  <para style="q" vid="PSA 78:55">un zei oisgevorfn mit a mestshnur far a nachle;</para>
  <para style="q" vid="PSA 78:55">un gemacht ruen in zeyere getseltn</para>
  <para style="q" vid="PSA 78:55">di shvotim fun Yisroel.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />ober zei hobn gepruvet un vidershpenikt Elokim dem Elyon,</para>
  <para style="q" vid="PSA 78:56">un zaine tseignim hobn zei nisht gehit.<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />un zei hobn zich opgekert un gefelsht vi zeyere eltern,</para>
  <para style="q" vid="PSA 78:57">zei zainen farkert gevorn vi a falsher boign.<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />un zei hobn im dertsernt mit kine mit zeyere bamot,</para>
  <para style="q" vid="PSA 78:58">un mit zeyere getsn im derbeizert mit kineh.<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />hot Elokim gehert un iz in kaas gevorn,</para>
  <para style="q" vid="PSA 78:59">un er hot zeyer faracht Yisroel.<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />un er hot avekgevorfen dem mishkn fun Shiloh,</para>
  <para style="q" vid="PSA 78:60">dos getselt vos er hot gemacht ruen tsvishn mentshn.<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />un er hot gegebn in gefangenshaft zain shtarkeit,</para>
  <para style="q" vid="PSA 78:61">un zain pracht in der hant fun faint.<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />un er hot ibergeentfert tsum shverd zain folk,</para>
  <para style="q" vid="PSA 78:62">un hot oif zain nachle getsernt.<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />zeyere bochurim hot fartsert a faier,</para>
  <para style="q" vid="PSA 78:63">un zeyere yungfroin zainen geblibn on a chasuna-lid.<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />zeyere koyanim zainen gefaln durchn shverd,</para>
  <para style="q" vid="PSA 78:64">un zeyere almones flegn tsu mol nisht baveinen.<verse eid="PSA 78:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />ober Adonoi hot oifgevacht vi a shlofediker,</para>
  <para style="q" vid="PSA 78:65">azoi vi a gibor vos nichtert zich ois fun vain.<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />un er hot tsurikgeshlogn zaine faint;</para>
  <para style="q" vid="PSA 78:66">an eibike shand hot er zei gegebn.<verse eid="PSA 78:66" /></para>
  <para style="b" />
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />ober er hot faracht dos getselt fun Yosef,</para>
  <para style="q" vid="PSA 78:67">un dem sheyvet Efrayim nisht oisderveilt;<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />nor oisderveilt dem sheyvet Yehudah,</para>
  <para style="q" vid="PSA 78:68">dem barg Tsiyon vos er hot lib.<verse eid="PSA 78:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />un er hot geboit vi di himlen zain mikdash,</para>
  <para style="q" vid="PSA 78:69">vi di erd vos er hot gegruntfest oif eibik.<verse eid="PSA 78:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />un er hot oisderveilt Dovid zain knecht,</para>
  <para style="q" vid="PSA 78:70">un im genumen fun di shofgeheftn.<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />fun hinter di milchshepsn hot er im gebracht</para>
  <para style="q" vid="PSA 78:71">tsu fitern Yaakov zain folk,</para>
  <para style="q" vid="PSA 78:71">un Yisroel zain arav.<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />er hot zei gefitert loit der erlechkeit fun zain hartsn,</para>
  <para style="q" vid="PSA 78:72">un mit der farshtandikeit fun zaine hent zei gefirt.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" pubnumber="עט" sid="PSA 79" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 79:1" />a mizmor fun ASafn.</para>
  <para style="q" vid="PSA 79:1">
    <char style="va">1</char> Elokim, felker zainen gekumen in dain arav;</para>
  <para style="q" vid="PSA 79:1">zei hobn farumreinikt dain heilikn heichl,</para>
  <para style="q" vid="PSA 79:1">zei hobn gemacht Yerushalayim far hoifns.<verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />zei hobn gegebn di toite laiber fun daine knecht</para>
  <para style="q" vid="PSA 79:2">far shpaiz tsu dem foigel fun himel,</para>
  <para style="q" vid="PSA 79:2">dos fleish fun daine frume tsu der chaye fun der erd.<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />zei hobn fargosen zeyer blut azoi vi vaser, arum Yerushalayim,</para>
  <para style="q" vid="PSA 79:3">un nisht geven kein bagreber.<verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />mir zainen gevorn a charpe bai undzere shecheynim,</para>
  <para style="q" vid="PSA 79:4">a gelechter un a shpot bai undzere arumike.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />biz ven Hashem vestu tserenen oif eibik?</para>
  <para style="q" vid="PSA 79:5">vet brenen vi faier dain kine tsorn?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />gis ois dain grimtsorn oif di felker</para>
  <para style="q" vid="PSA 79:6">vos kenen dich nisht,</para>
  <para style="q" vid="PSA 79:6">un oif di kinigraichn</para>
  <para style="q" vid="PSA 79:6">vos rufn nisht dain nomen.<verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />vorem me hot oifgegesn Yaakov,</para>
  <para style="q" vid="PSA 79:7">un zain voinung hobn zei farvist.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />zolst undz nisht dermonen di zind fun di frierdike,</para>
  <para style="q" vid="PSA 79:8">gich zol undz antkeg? kumen dain derbaremung,</para>
  <para style="q" vid="PSA 79:8">vorem mir zainen gefaln zeyer.<verse eid="PSA 79:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />shtei undz bai, Elokim fun undzer hilf,</para>
  <para style="q" vid="PSA 79:9">tsulib dem koved fun dain nomen,</para>
  <para style="q" vid="PSA 79:9">un zai undz matsl, un zai mechaper oif undzere zind,</para>
  <para style="q" vid="PSA 79:9">fun vegen dain nomen.<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />noch vos zoln zogn di felker: vu iz zeyer G-t?</para>
  <para style="q" vid="PSA 79:10">zol bavust vern tsvishn di felker far undzere oign</para>
  <para style="q" vid="PSA 79:10">di nekome far dem fargosenem blut fun daine knecht.<verse eid="PSA 79:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />zol kumen far dir dos krechtsn fun gefangenem,</para>
  <para style="q" vid="PSA 79:11">loit der groiskeit fun dain orem</para>
  <para style="q" vid="PSA 79:11">loz lebn di ongebreite tsum toit,<verse eid="PSA 79:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />un ker um undzere shecheynim zibnfachik in zeyer buzem,</para>
  <para style="q" vid="PSA 79:12">zeyer lesterung vos zei hobn dich gelestert, Adonoi.<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />un mir, dain folk, un di shof fun dain fiterung,</para>
  <para style="q" vid="PSA 79:13">veln dir danken oif eibik,</para>
  <para style="q" vid="PSA 79:13">oif dor-doires veln mir dertseiln dain loib.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" pubnumber="פּ" sid="PSA 80" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 80:1" />far dem gezangmaister, oif Sheshanim-eides; fun ASafn a mizmor.<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 80:2" /> du pastuch fun Yisroel, farnem;</para>
  <para style="q" vid="PSA 80:2">du vos first azoi vi shof Yosef,</para>
  <para style="q" vid="PSA 80:2">du vos zitsst iber di kruvim, shain arois.<verse eid="PSA 80:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 80:3" /> farois far Efrayim un Binyamin un Menasheh</para>
  <para style="q" vid="PSA 80:3">dervek dain gevure, un kum undz tsu hilf.<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 80:4" /> Elokim, richt undz vider oif,</para>
  <para style="q" vid="PSA 80:4">un derlaicht dain ponem, az mir zoln geholfn vern.<verse eid="PSA 80:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 80:5" /> Hashem du Elokim Tseva'ot,</para>
  <para style="q" vid="PSA 80:5">biz vanen vestu tserenen oif der tfile fun dain folk?<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 80:6" /> host zei geshpaizt mit broit fun trern,</para>
  <para style="q" vid="PSA 80:6">un zei gemacht trinken emersvaiz trern.<verse eid="PSA 80:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 80:7" /> machst undz tsum shtrait bai undzere shecheynim,</para>
  <para style="q" vid="PSA 80:7">un undzere sonem lachn zich on.<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 80:8" /> Elokim fun Tseva'ot, richt undz vider oif,</para>
  <para style="q" vid="PSA 80:8">un derlaicht dain ponem, az mir zoln geholfn vern.<verse eid="PSA 80:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 80:9" /> a vainshtok hostu aroisgetsoign fun Mitsrayim,</para>
  <para style="q" vid="PSA 80:9">host fartriben felker, un im aingeflantst.<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 80:10" /> host opgeramt far im,</para>
  <para style="q" vid="PSA 80:10">un er hot aingevortslt zaine vortselen,</para>
  <para style="q" vid="PSA 80:10">un ongefilt dos land.<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 80:11" /> di berg zainen fardekt gevorn fun zain shotn,</para>
  <para style="q" vid="PSA 80:11">un zaine tsvaign zainen geven tsedern fun El.<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 80:12" /> er hot aroisgelozt zaine riter biz tsum yam,</para>
  <para style="q" vid="PSA 80:12">un biz tsum taich zaine shprotsn.<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 80:13" /> far vos hostu tsebrochn zaine tsamen,</para>
  <para style="q" vid="PSA 80:13">az ale veggeyer zoln im arumklaibn?<verse eid="PSA 80:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 80:14" /> der chezr fun vald prest im op,</para>
  <para style="q" vid="PSA 80:14">un di vidmenung fun feld fitert zich oif im.<verse eid="PSA 80:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 80:15" /> Elokim fun Tseva'ot, ker zich um, ich bet dich,</para>
  <para style="q" vid="PSA 80:15">lug fun himel un ze, un gib acht oifn dozikn vainshtok,<verse eid="PSA 80:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 80:16" /> un bafestik dos vos dain rechte hot aingeflantst,</para>
  <para style="q" vid="PSA 80:16">un derheib dem tsvaig vos du host dir shtark gemacht.<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 80:17" /> er iz fun faier farbrent, er iz opgeshnitn;</para>
  <para style="q" vid="PSA 80:17">fun dem beizer fun dain ponem geyen zei unter.<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 80:18" /> zol dain hant zain oif dem man fun dain rechter hant,</para>
  <para style="q" vid="PSA 80:18">oif dem mentshnkind vos du host dir shtark gemacht,<verse eid="PSA 80:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 80:19" /> az mir zoln zich nisht opkeren fun dir;</para>
  <para style="q" vid="PSA 80:19">zolst undz oiflebn, az mir rufn dain nomen.<verse eid="PSA 80:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 80:20" /> Hashem du Elokim fun Tseva'ot, richt undz vider oif,</para>
  <para style="q" vid="PSA 80:20">derlaicht dain ponem, az mir zoln geholfn vern.<verse eid="PSA 80:20" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" pubnumber="פּא" sid="PSA 81" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 81:1" />far dem gezangmaister, oif gitit; fun ASafn.<verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 81:2" /> zingt tsu Elokim undzer shtarkeit,</para>
  <para style="q" vid="PSA 81:2">shalt tsu dem Elokei Yaakov.<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 81:3" /> heibt oif a gezang, un shpilt oif a poik,</para>
  <para style="q" vid="PSA 81:3">oif a ziser harf mit a gitar.<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 81:4" /> blozt a shoifer um rosh-choidesh,</para>
  <para style="q" vid="PSA 81:4">in fuler levone tsu undzer yom-tov.<verse eid="PSA 81:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 81:5" /> vorem dos iz a chok far Yisroel,</para>
  <para style="q" vid="PSA 81:5">a gezets fun dem Elokei Yaakov.<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 81:6" /> an tseignim in Yosef hot er es gemacht,</para>
  <para style="q" vid="PSA 81:6">az ven er iz arois oif land Mitsrayim,</para>
  <para style="q" vid="PSA 81:6">hob ich a shprach mir umbakant gehert.<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 81:7" /> ich hob opgeton zain rukn fun last,</para>
  <para style="q" vid="PSA 81:7">zaine hent zoln avek fun dem trogkorb.<verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 81:8" /> host gerufn in noit, un ich hob dich aroisgetsoign,</para>
  <para style="q" vid="PSA 81:8">ich hob dir geentfert fun der farborgenish fun duner.</para>
  <para style="q" vid="PSA 81:8">ich hob dich gepruvet bai di vasern fun Merivah. Selah.<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 81:9" /> her, main folk, un ich vel dich vorenen,</para>
  <para style="q" vid="PSA 81:9">Yisroel, ven du zolst mir tsuhern!<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 81:10" /> kein El zar zol nisht zain bai dir,</para>
  <para style="q" vid="PSA 81:10">un zolst zich nisht bukn tsu kein fremdn G-t.<verse eid="PSA 81:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 81:11" /> ich bin Hashem dain G-t,</para>
  <para style="q" vid="PSA 81:11">vos hot dich oifgebracht fun land Mitsrayim;</para>
  <para style="q" vid="PSA 81:11">mach oif breit dain moil un ich vel es onfiln.<verse eid="PSA 81:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 81:12" /> ober main folk hot nisht tsugehert tsu main kol,</para>
  <para style="q" vid="PSA 81:12">un Yisroel hot nisht aingevilikt tsu mir.<verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 81:13" /> un ich hob im frai gelozt</para>
  <para style="q" vid="PSA 81:13">in der aingeshpartkeit fun zain hartsn,</para>
  <para style="q" vid="PSA 81:13">zei zoln gein loit zeyere barotn.<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 81:14" /> ven main folk volt tsuhern tsu mir,</para>
  <para style="q" vid="PSA 81:14">ven Yisroel volt in maine vegen gein!<verse eid="PSA 81:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 81:15" /> ich volt gich untertenikt zeyere faint,</para>
  <para style="q" vid="PSA 81:15">un oif zeyere driker gekert main hant.<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 81:16" /> di sonem fun Hashem voltn aingegangen far im,</para>
  <para style="q" vid="PSA 81:16">un zeyer shtrof volt geven eibik.<verse eid="PSA 81:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 81:17" /> un im volt men geshpaizt mit dem fets fun veits;</para>
  <para style="q" vid="PSA 81:17">un fun feldz dich volt ich mit honik gezetikt.<verse eid="PSA 81:17" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" pubnumber="פּב" sid="PSA 82" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 82:1" />a mizmor fun ASafn.</para>
  <para style="q" vid="PSA 82:1">
    <char style="va">1</char> Elokim shteit in der eide fun El,</para>
  <para style="q" vid="PSA 82:1">in der mitn fun di Elokim mishpot er.<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />biz vanen vet ir mishpetn umgerecht,</para>
  <para style="q" vid="PSA 82:2">un shoinen dem ponem fun di reshoim?</para>
  <para style="q" vid="PSA 82:2">Selah.<verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />tut recht dem oreman un dem yosem,</para>
  <para style="q" vid="PSA 82:3">dem gedriktn un dem baderftikn macht gerecht.<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />macht antrinen dem oreman un dem evyon,</para>
  <para style="q" vid="PSA 82:4">fun der hant fun di reshoim zait matsl.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />zei veisn nisht, un zei farshteyen nisht,</para>
  <para style="q" vid="PSA 82:5">in fintsternish geyen zei um;</para>
  <para style="q" vid="PSA 82:5">ale gruntfestn fun der erd faln um.<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />ich volt gezogt, Elokim zait ir,</para>
  <para style="q" vid="PSA 82:6">un zin fun dem Elyon zait ir ale.<verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />ober azoi vi a mentsh vet ir shtarbn,</para>
  <para style="q" vid="PSA 82:7">un vi einer fun di harn vet ir faln.<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />shtei oif, Elokim, mishpot di erd,</para>
  <para style="q" vid="PSA 82:8">vorem ale felker zainen dain arav.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" pubnumber="פּג" sid="PSA 83" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 83:1" />a gezang, a mizmor fun ASafn.<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 83:2" /> Elokim, nisht zai shtil,</para>
  <para style="q" vid="PSA 83:2">zolst nisht farshvaign un nisht ruen, El.<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 83:3" /> vorem ze, daine faint tumlen,</para>
  <para style="q" vid="PSA 83:3">un daine sonem heibn oif dem kop.<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 83:4" /> akegn dain folk soden zei zich listik,</para>
  <para style="q" vid="PSA 83:4">un zei eetshn zich akegn daine bashitste.<verse eid="PSA 83:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 83:5" /> zei hobn gezogt: kumt,</para>
  <para style="q" vid="PSA 83:5">un lomir zei fartiliken fun zain a folk,</para>
  <para style="q" vid="PSA 83:5">az mer zol nisht gedacht vern der nomen Yisroel.<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 83:6" /> vorem zei hobn gehaltn an eitse mit ein hartsn,</para>
  <para style="q" vid="PSA 83:6">kegen dir a bris tuen zei shlisn.<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 83:7" /> di getseltn fun Edom, un di Yishmaelim,</para>
  <para style="q" vid="PSA 83:7">Moav, un di Hagarim;<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 83:8" /> Geval, un Amon, un Amalek,</para>
  <para style="q" vid="PSA 83:8">Peleshet mit di bavoiner fun Tsor.<verse eid="PSA 83:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 83:9" /> oich Ashur hot zich baheft mit zei;</para>
  <para style="q" vid="PSA 83:9">zei zainen an orem tsu di kinder fun Lot.</para>
  <para style="q" vid="PSA 83:9">Selah.<verse eid="PSA 83:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 83:10" /> tu tsu zei azoi vi tsu Midyan,</para>
  <para style="q" vid="PSA 83:10">vi tsu Sisraen, vi tsu Yavinen baim taich Kishon,<verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 83:11" /> vos zainen fartilikt gevorn in Ein-Dor,</para>
  <para style="q" vid="PSA 83:11">gevorn vi mist oif der erd.<verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 83:12" /> mach zeyere adllait vi Orev un vi Zeev,</para>
  <para style="q" vid="PSA 83:12">un vi Zevach un vi teslmune, ale zeyere firshtn;<verse eid="PSA 83:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 83:13" /> di vos zogn: lomir yarshen far undz</para>
  <para style="q" vid="PSA 83:13">di voinungen fun Elokim.<verse eid="PSA 83:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 83:14" /> main G-t, mach zei vi virblshtoib,</para>
  <para style="q" vid="PSA 83:14">vi shprei faran vint.<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 83:15" /> vi a faier vos farbrent a vald,</para>
  <para style="q" vid="PSA 83:15">un vi a flam vos tseflakert di berg,<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 83:16" /> azoi zolstu zei nochyogn mit dain shturem,</para>
  <para style="q" vid="PSA 83:16">un mit dain geviter zei dershrekn.<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 83:17" /> fil zeyer ponem mit shand,</para>
  <para style="q" vid="PSA 83:17">az zei zoln zuchn dain nomen, Hashem.<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 83:18" /> zoln zei farshemt un dershrokn vern oif eibik,</para>
  <para style="q" vid="PSA 83:18">un zoln zei tsu shand vern un untergein.<verse eid="PSA 83:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 83:19" /> un zoln zei visen az du alein vos dain nomen iz Hashem,</para>
  <para style="q" vid="PSA 83:19">bist der Elyon iber der gantser erd.<verse eid="PSA 83:19" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" pubnumber="פּד" sid="PSA 84" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 84:1" />far dem gezangmaister, oif gitit; fun di kinder fun Korach a mizmor.<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 84:2" /> vi liblech zainen daine voinungen,</para>
  <para style="q" vid="PSA 84:2">Hashem Tseva'ot!<verse eid="PSA 84:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 84:3" /> main zel gart un geit ois</para>
  <para style="q" vid="PSA 84:3">noch di hoifn fun Hashem;</para>
  <para style="q" vid="PSA 84:3">main harts un main laib zingen</para>
  <para style="q" vid="PSA 84:3">tsum lebedikn El.<verse eid="PSA 84:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 84:4" /> afile a shperl gefint a heim,</para>
  <para style="q" vid="PSA 84:4">un a shvalb a nest far zich,</para>
  <para style="q" vid="PSA 84:4">vu zi tut ahin ire yunge,</para>
  <para style="q" vid="PSA 84:4">bai daine mizbeyches, Hashem Tseva'ot,</para>
  <para style="q" vid="PSA 84:4">main kinig un main G-t.<verse eid="PSA 84:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 84:5" /> voil tsu di vos zitsn in dain hoiz;</para>
  <para style="q" vid="PSA 84:5">tmid veln zei dich loibn.</para>
  <para style="q" vid="PSA 84:5">Selah.<verse eid="PSA 84:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 84:6" /> voil tsu di mentshn vos zeyer shtarkeit iz in dir,</para>
  <para style="q" vid="PSA 84:6">vos daine vegen zainen in zeyer hartsn.<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 84:7" /> durchgeyendik dem tal bocho,</para>
  <para style="q" vid="PSA 84:7">machn zei im far a kval;</para>
  <para style="q" vid="PSA 84:7">yo, a friregn bakleidt im mit broches.<verse eid="PSA 84:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 84:8" /> zei geyen fun shtarkeit tsu shtarkeit,</para>
  <para style="q" vid="PSA 84:8">zei vaizn zich far Elokim in Tsiyon.<verse eid="PSA 84:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 84:9" /> Hashem du Elokim fun Tseva'ot, her tsu main tfile,</para>
  <para style="q" vid="PSA 84:9">farnem, du Elokei Yaakov.</para>
  <para style="q" vid="PSA 84:9">Selah.<verse eid="PSA 84:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 84:10" /> Elokim undzer shild, ze,</para>
  <para style="q" vid="PSA 84:10">un kuk oif dem ponem fun dain gezalbtn.<verse eid="PSA 84:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 84:11" /> vorem beser a tog in daine hoifn</para>
  <para style="q" vid="PSA 84:11">eider toiznt;</para>
  <para style="q" vid="PSA 84:11">ich volt oisgeveilt shtein baim shvel in hoiz fun main G-t,</para>
  <para style="q" vid="PSA 84:11">eider voinen in getseltn fun umrecht.<verse eid="PSA 84:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 84:12" /> vorem a zun un a shild iz Hashem Elokim,</para>
  <para style="q" vid="PSA 84:12">chein un koved git Hashem;</para>
  <para style="q" vid="PSA 84:12">er farmaidt nisht kein guts</para>
  <para style="q" vid="PSA 84:12">fun di vos geyen in erlechkeit.<verse eid="PSA 84:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 84:13" /> Hashem Tseva'ot, voil tsu dem mentshn</para>
  <para style="q" vid="PSA 84:13">vos farzichert zich oif dir.<verse eid="PSA 84:13" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" pubnumber="פּה" sid="PSA 85" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 85:1" />far dem gezangmaister; fun di kinder fun Korach a mizmor.<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 85:2" /> host bavilikt, Hashem, dain land,</para>
  <para style="q" vid="PSA 85:2">host umgekert di gefangenshaft fun Yaakov.<verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 85:3" /> host fargebn di zind fun dain folk,</para>
  <para style="q" vid="PSA 85:3">host fardekt zeyere ale chatoim.</para>
  <para style="q" vid="PSA 85:3">Selah.<verse eid="PSA 85:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 85:4" /> host aingeton al dain roiges,</para>
  <para style="q" vid="PSA 85:4">host zich opgekert fun dain grimtsorn.<verse eid="PSA 85:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 85:5" /> richt undz vider oif, Elokim fun undzer hilf,</para>
  <para style="q" vid="PSA 85:5">un farshter dain kaas kegen undz.<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 85:6" /> tsi oif eibik vestu tserenen oif undz?</para>
  <para style="q" vid="PSA 85:6">vestu tsien dain kaas oif dor-doires?<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 85:7" /> tsi vestu undz nisht oiflebn vider,</para>
  <para style="q" vid="PSA 85:7">az dain folk zol zich freyen mit dir?<verse eid="PSA 85:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 85:8" /> vaiz undz, Hashem, dain chesed,</para>
  <para style="q" vid="PSA 85:8">un dain hilf zolstu undz gebn.<verse eid="PSA 85:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 85:9" /> ich her vos HaEl Hashem redt;</para>
  <para style="q" vid="PSA 85:9">far vor, er redt frid far zain folk un far zaine frume;</para>
  <para style="q" vid="PSA 85:9">nor zei zoln zich nisht umkeren tsu narishkeit.<verse eid="PSA 85:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 85:10" /> gor nont tsu zaine forchter iz zain yeshue,</para>
  <para style="q" vid="PSA 85:10">kedei koved zol ruen in undzer land.<verse eid="PSA 85:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 85:11" /> genod un emes hobn zich bagegent,</para>
  <para style="q" vid="PSA 85:11">gerechtikeit un sholem hobn zich tsekusht.<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 85:12" /> emes shprotst fun der erd,</para>
  <para style="q" vid="PSA 85:12">un gerechtikeit lugt fun himel.<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 85:13" /> yo, Hashem vet gebn guts,</para>
  <para style="q" vid="PSA 85:13">un undzer land vet gebn ir frucht.<verse eid="PSA 85:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 85:14" /> gerechtikeit vet gein im farois,</para>
  <para style="q" vid="PSA 85:14">un kireven in veg zaine trit.<verse eid="PSA 85:14" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" pubnumber="פּו" sid="PSA 86" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 86:1" />a tfile fun Dovidn.</para>
  <para style="q" vid="PSA 86:1">
    <char style="va">1</char> naig tsu, Hashem, dain oier, entfer mir,</para>
  <para style="q" vid="PSA 86:1">vorem orim un baderftik bin ich.<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />bahit main zel vorem ich bin frum,</para>
  <para style="q" vid="PSA 86:2">helf, du main G-t, dain knecht vos farzichert zich oif dir.<verse eid="PSA 86:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />laitzelik mich, Adonoi,</para>
  <para style="q" vid="PSA 86:3">vorem tsu dir ruf ich a gantsn tog.<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />derfrei di zel fun dain knecht,</para>
  <para style="q" vid="PSA 86:4">vorem tsu dir, Adonoi, heib ich oif main nefesh.<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />vorem du, Adonoi, bist gut un fargebik,</para>
  <para style="q" vid="PSA 86:5">un filgenodik tsu ale vos rufn dich.<verse eid="PSA 86:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />farnem, Hashem, main tfile,</para>
  <para style="q" vid="PSA 86:6">un horch tsu dem kol fun maine gebetn.<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />in tog fun noit ruf ich dich,</para>
  <para style="q" vid="PSA 86:7">vorem du vest mir entfern.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />nishto aza vi du, Adonoi, tsvishn di g‑ter,</para>
  <para style="q" vid="PSA 86:8">un nishto azoi vi daine meisim.<verse eid="PSA 86:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />ale felker vos du host gemacht,</para>
  <para style="q" vid="PSA 86:9">veln kumen un zich bukn far dir, Adonoi,</para>
  <para style="q" vid="PSA 86:9">un gebn koved tsu dain nomen.<verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />vorem grois bistu, un tust vunder,</para>
  <para style="q" vid="PSA 86:10">du Elokim alein.<verse eid="PSA 86:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />lern mich, Hashem, dain veg,</para>
  <para style="q" vid="PSA 86:11">ich zol gein in dain emes,</para>
  <para style="q" vid="PSA 86:11">eintsik main harts tsu forchtn dain nomen.<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />ich vel dich loibn, Adonoi main G-t, mit main gantsn hartsn,</para>
  <para style="q" vid="PSA 86:12">un erlechn dain nomen oif eibik.<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />vorem grois iz dain chesed tsu mir,</para>
  <para style="q" vid="PSA 86:13">un host matsl geven main zel fun der tifer Sheol.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />Elokim, mutvilike zainen ongeshtanen oif mir,</para>
  <para style="q" vid="PSA 86:14">un a bande gevalttuer zuchn main lebn,</para>
  <para style="q" vid="PSA 86:14">un zei halt dich nisht antkegen zich.<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />ober du, Adonoi, bist a derbaremdiker un laitzeliker El,</para>
  <para style="q" vid="PSA 86:15">aingehaltn in tsorn un raich in genod un traishaft.<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />ker zich tsu mir, un laitzelik mich,</para>
  <para style="q" vid="PSA 86:16">gib dain shtarkeit tsu dain knecht,</para>
  <para style="q" vid="PSA 86:16">un helf dem zun fun dain dinst.<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />mach mir a tseichn tsum gutn,</para>
  <para style="q" vid="PSA 86:17">un zoln zen maine sonem un farshemt vern,</para>
  <para style="q" vid="PSA 86:17">az du Hashem host mich geholfn un mich getreist.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" pubnumber="פּז" sid="PSA 87" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 87:1" />fun di kinder fun Korach a mizmor; a lid.</para>
  <para style="q" vid="PSA 87:1">
    <char style="va">1</char> zain gruntfest iz oif di heilike berg.<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />Hashem hot lib di toiern fun Tsiyon</para>
  <para style="q" vid="PSA 87:2">mer fun ale voinungen fun Yaakov.<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />prachtiks vert geredt fun dir,</para>
  <para style="q" vid="PSA 87:3">du shtot fun Elokim.</para>
  <para style="q" vid="PSA 87:3">Selah.<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />ich dermon rahav un Bavel far maine bakente;</para>
  <para style="q" vid="PSA 87:4">ot iz Peleshet, un Tsor mit Kush:</para>
  <para style="q" vid="PSA 87:4">der doziker iz in ir geborn gevorn.<verse eid="PSA 87:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />ober fun Tsiyon vert gezogt:</para>
  <para style="q" vid="PSA 87:5">der un yener iz dortn geborn gevorn,</para>
  <para style="q" vid="PSA 87:5">un der Elyon alein bafestikt zi.<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />Hashem tseilt baim farshraibn di felker:</para>
  <para style="q" vid="PSA 87:6">der doziker iz dortn geborn gevorn.</para>
  <para style="q" vid="PSA 87:6">Selah.<verse eid="PSA 87:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />yo, azoi vi di zinger vi azoi oich di tentser zogn;</para>
  <para style="q" vid="PSA 87:7">ale maine brunem zenen in dir Tsiyon.<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" pubnumber="פּח" sid="PSA 88" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 88:1" />a gezang; a mizmor fun di kinder fun Korach; far dem gezangmaister, oif Machalat Le'Anot; a batrachtung fun Heman dem Ezrachi.<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 88:2" /> Hashem du Elokim fun main hilf,</para>
  <para style="q" vid="PSA 88:2">beeis ich shrai bai nacht far dir,<verse eid="PSA 88:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 88:3" /> zol kumen main tfile far dir;</para>
  <para style="q" vid="PSA 88:3">naig dain oier tsu main ruf.<verse eid="PSA 88:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 88:4" /> vorem zat mit umglikn iz main zel,</para>
  <para style="q" vid="PSA 88:4">un main lebn hot tsu der Sheol dergreicht.<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 88:5" /> ich ver gerechnt mit geniderte in grub,</para>
  <para style="q" vid="PSA 88:5">ich bin gevorn vi a mentsh on koiech,<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 88:6" /> an opgezunderter tsvishn meisim;</para>
  <para style="q" vid="PSA 88:6">vi dershlogene vos lign in keyver,</para>
  <para style="q" vid="PSA 88:6">vos du dermonst zei nisht mer,</para>
  <para style="q" vid="PSA 88:6">un zei zainen fun dain hant opgeshnitn.<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 88:7" /> host mich araingeton in der untershter grub.</para>
  <para style="q" vid="PSA 88:7">in fintsternishn, in tifenishn.<verse eid="PSA 88:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 88:8" /> oif mir hot zich ongeleigt dain grimtsorn,</para>
  <para style="q" vid="PSA 88:8">un ale daine indn drikstu oif mir.</para>
  <para style="q" vid="PSA 88:8">Selah.<verse eid="PSA 88:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 88:9" /> host dervaitert maine bakente fun mir,</para>
  <para style="q" vid="PSA 88:9">host mich gemacht an umverdikeit bai zei;</para>
  <para style="q" vid="PSA 88:9">ich bin aingeshpart un ken nisht aroisgein.<verse eid="PSA 88:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 88:10" /> main oig shmacht fun pain;</para>
  <para style="q" vid="PSA 88:10">ich hob dich gerufn, Hashem, ale tog,</para>
  <para style="q" vid="PSA 88:10">ich hob oisgeshpreit tsu dir maine hent.<verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 88:11" /> vestu far meisim ton vunder?</para>
  <para style="q" vid="PSA 88:11">tsi di toite veln oifshtein dich loibn?</para>
  <para style="q" vid="PSA 88:11">Selah.<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 88:12" /> vet dertseilt vern in keyver dain chesed?</para>
  <para style="q" vid="PSA 88:12">dain traishaft in untergang?<verse eid="PSA 88:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 88:13" /> veln bakant vern in der fintsternish daine vunder?</para>
  <para style="q" vid="PSA 88:13">un dain gerechtikeit in land fun fargesung?<verse eid="PSA 88:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 88:14" /> ober ich, tsu dir, Hashem, shrai ich,</para>
  <para style="q" vid="PSA 88:14">un in frimorgn kumt far dir main tfile.<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 88:15" /> far vos farlozstu, Hashem, main zel?</para>
  <para style="q" vid="PSA 88:15">farborgstu dain ponem fun mir?<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 88:16" /> ich bin gedrikt un gei ain fun yugnt on,</para>
  <para style="q" vid="PSA 88:16">ich trog dain eime, ich bin tsedult.<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 88:17" /> iber mir iz dain grimtsorn ariber,</para>
  <para style="q" vid="PSA 88:17">daine shrekenishn hobn mich farshnitn.<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 88:18" /> zei hobn mich arumgeringlt vi a vaser a gantsn tog,</para>
  <para style="q" vid="PSA 88:18">zei hobn in einem mich arumgenumen.<verse eid="PSA 88:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 88:19" /> host dervaitert fun mir a gutn fraint un a chever,</para>
  <para style="q" vid="PSA 88:19">main bakentshaft iz di fintsternish.<verse eid="PSA 88:19" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" pubnumber="פּט" sid="PSA 89" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 89:1" />a batrachtung fun Eitan dem Ezrachi.<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 89:2" /> di chasadim fun Hashem vel ich eibik zingen,</para>
  <para style="q" vid="PSA 89:2">oif dor-doires vel ich bakant machn</para>
  <para style="q" vid="PSA 89:2">dain traishaft mit main moil.<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 89:3" /> vorem ich zog: oif eibik geboit iz di genod,</para>
  <para style="q" vid="PSA 89:3">di himlen, in zei hostu bafestikt dain traishaft:<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 89:4" /> ich hob geshlosn a bris tsu main oisderveiltn,</para>
  <para style="q" vid="PSA 89:4">ich hob geshvorn tsu Dovid main knecht:<verse eid="PSA 89:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 89:5" /> oif eibik vel ich oifshteln dain zomen,</para>
  <para style="q" vid="PSA 89:5">un oif dor-doires vel ich oifboien dain tron.</para>
  <para style="q" vid="PSA 89:5">Selah.<verse eid="PSA 89:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 89:6" /> un di himlen loibn daine vunder, Hashem,</para>
  <para style="q" vid="PSA 89:6">oich dain traishaft in der ainzamlung fun di heilike.<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 89:7" /> vorem ver in himel ken zich glaichn tsu Hashem?</para>
  <para style="q" vid="PSA 89:7">ver iz geglichn tsu Hashem tsvishn di machtike?<verse eid="PSA 89:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 89:8" /> El iz forchtik zeyer in dem barot fun di heilike,</para>
  <para style="q" vid="PSA 89:8">un moiredik far ale zaine arumike.<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 89:9" /> Hashem du Elokei Tseva'ot,</para>
  <para style="q" vid="PSA 89:9">ver iz azoi shtark vi du, G-t?</para>
  <para style="q" vid="PSA 89:9">un daine getraie zainen rund arum dir.<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 89:10" /> du geveltikst iber der shtoltsn yam,</para>
  <para style="q" vid="PSA 89:10">az zaine veln heibn zich, tust du zei ainshtiln.<verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 89:11" /> du host tsedrikt vi a dershlogenem, rahav,</para>
  <para style="q" vid="PSA 89:11">mit dain shtarkn orem hostu tseshpreit daine faint.<verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 89:12" /> dain iz der himel, dain oich di erd;</para>
  <para style="q" vid="PSA 89:12">di velt un ir fulkeit, zei host du gegruntfest.<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 89:13" /> tsofn un dorem – zei host du bashafn,</para>
  <para style="q" vid="PSA 89:13">Tavor un Chermon zingen fun dain nomen.<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 89:14" /> du host an orem mit gevure,</para>
  <para style="q" vid="PSA 89:14">dain hant iz shtark, dain rechte iz derhoibn.<verse eid="PSA 89:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 89:15" /> recht un gerechtikeit zainen dos geshtel fun dain tron,</para>
  <para style="q" vid="PSA 89:15">genod un emes zainen far dain ponem.<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 89:16" /> voil tsu dem folk vos veis dain laitzelikeit,</para>
  <para style="q" vid="PSA 89:16">vos geyen, Hashem, in licht fun dain ponem.<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 89:17" /> mit dain nomen freyen zei zich a gantsn tog,</para>
  <para style="q" vid="PSA 89:17">un durch dain gerechtikeit vern zei derhoibn.<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 89:18" /> vorem du bist di pracht fun zeyer shtarkeit,</para>
  <para style="q" vid="PSA 89:18">un durch dain gutvilikeit vert derhoibn undzer horn.<verse eid="PSA 89:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 89:19" /> vorem Hashem, er iz undzer shild,</para>
  <para style="q" vid="PSA 89:19">un der heiliker fun Yisroel, er iz undzer kinig.<verse eid="PSA 89:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 89:20" /> host a mol in a zeung geredt tsu daine frume,</para>
  <para style="q" vid="PSA 89:20">un host gezogt: ich hob aroifgeton hilf oif a gibor,</para>
  <para style="q" vid="PSA 89:20">ich hob derhoibn an oisderveiltn fun folk.<verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 89:21" /> ich hob gefunen Dovid main knecht,</para>
  <para style="q" vid="PSA 89:21">ich hob mit main heilikn eil im gezalbt;<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 89:22" /> az main hant zol zain fest mit im,</para>
  <para style="q" vid="PSA 89:22">un main orem zol im shtarkn.<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 89:23" /> kein faint zol nisht monen fun im,</para>
  <para style="q" vid="PSA 89:23">un kein baevler zol im nisht painiken.<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 89:24" /> un ich vel tseshtoisn zaine driker fun far im,</para>
  <para style="q" vid="PSA 89:24">un zaine sonem vel ich shlogn.<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 89:25" /> un main traishaft un main chesed veln zain mit im,</para>
  <para style="q" vid="PSA 89:25">un durch main nomen vet derhoibn vern zain horn.<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 89:26" /> un ich vel aroifton oifn yam zain hant,</para>
  <para style="q" vid="PSA 89:26">un oif di taichn zain rechte.<verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 89:27" /> er vet mich rufn: main foter bistu,</para>
  <para style="q" vid="PSA 89:27">main G-t, un der feldz fun main hilf;<verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 89:28" /> oich ich vel im machn faran bechor,</para>
  <para style="q" vid="PSA 89:28">faran Oibershter iber di mlochim fun der erd.<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 89:29" /> oif eibik vel ich im hitn main chesed,</para>
  <para style="q" vid="PSA 89:29">un main bris vet im blaibn getrai.<verse eid="PSA 89:29" /></para>
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 89:30" /> un ich vel onhaltn shtendik zain zomen,</para>
  <para style="q" vid="PSA 89:30">un zain tron vi di teg fun di himlen.<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 89:31" /> az zaine kinder veln farlozen main toyre,</para>
  <para style="q" vid="PSA 89:31">un in maine gezetsn veln zei nisht gein;<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 89:32" /> az maine chukkim veln zei farshvechn,</para>
  <para style="q" vid="PSA 89:32">un maine gebot veln zei nisht hitn;<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" altnumber="32" sid="PSA 89:33" /> vel ich shtrofn mit a rut zeyer farbrech,</para>
  <para style="q" vid="PSA 89:33">un mit plogn zeyer zind.<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" altnumber="33" sid="PSA 89:34" /> ober main chesed vel ich nisht farshtern fun im,</para>
  <para style="q" vid="PSA 89:34">un nisht felshn on main traishaft.<verse eid="PSA 89:34" /></para>
  <para style="q">
    <verse number="35" style="v" altnumber="34" sid="PSA 89:35" /> ich vel nisht farshvechn main bris,</para>
  <para style="q" vid="PSA 89:35">un dem aroisloz fun maine lipn vel ich nisht baitn.<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" altnumber="35" sid="PSA 89:36" /> ein mol hob ich geshvorn in main heilikeit:</para>
  <para style="q" vid="PSA 89:36">oib ich vel felshn on Dovidn!<verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" altnumber="36" sid="PSA 89:37" /> zain zomen zol zain eibik,</para>
  <para style="q" vid="PSA 89:37">un zain tron vi di zun far mir.<verse eid="PSA 89:37" /></para>
  <para style="q">
    <verse number="38" style="v" altnumber="37" sid="PSA 89:38" /> azoi vi di levone zol er eibik bashtein,</para>
  <para style="q" vid="PSA 89:38">un vi a getraier eides in himel.</para>
  <para style="q" vid="PSA 89:38">Selah.<verse eid="PSA 89:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" altnumber="38" sid="PSA 89:39" /> ober du host farlozen un faracht,</para>
  <para style="q" vid="PSA 89:39">host zich fartsornt oif dain gezalbtn.<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" altnumber="39" sid="PSA 89:40" /> host avekgevorfen dem bris fun dain knecht,</para>
  <para style="q" vid="PSA 89:40">host farshvecht tsu der erd zain kroin.<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" altnumber="40" sid="PSA 89:41" /> host tsebrochn ale zaine tsamen,</para>
  <para style="q" vid="PSA 89:41">host gemacht fun zaine festungen a tel.<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" altnumber="41" sid="PSA 89:42" /> tseroibt hobn im ale veggeyer,</para>
  <para style="q" vid="PSA 89:42">er iz gevorn a charpe bai zaine shecheynim.<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" altnumber="42" sid="PSA 89:43" /> host derhoibn di rechte hant fun zaine driker,</para>
  <para style="q" vid="PSA 89:43">host derfreit ale zaine faint.<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" altnumber="43" sid="PSA 89:44" /> oich haltstu tsurik dem sharf fun zain shverd</para>
  <para style="q" vid="PSA 89:44">un host im nisht gelozt oifshtein in milchome.<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" altnumber="44" sid="PSA 89:45" /> host farshtert zain loiterkeit,</para>
  <para style="q" vid="PSA 89:45">un geshlaidert zain tron tsu der erd.<verse eid="PSA 89:45" /></para>
  <para style="q">
    <verse number="46" style="v" altnumber="45" sid="PSA 89:46" /> host gekirtst di teg fun zain yugnt,</para>
  <para style="q" vid="PSA 89:46">host im mit bushe badekt.</para>
  <para style="q" vid="PSA 89:46">Selah.<verse eid="PSA 89:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" altnumber="46" sid="PSA 89:47" /> biz vanen, Hashem, vestu zich farborgen nochanand?</para>
  <para style="q" vid="PSA 89:47">vet brenen vi a faier dain grimtsorn?<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" altnumber="47" sid="PSA 89:48" /> gedenk, vos iz main gedoier;</para>
  <para style="q" vid="PSA 89:48">tsu vos far nishtikeit du host bashafn ale mentshnkinder.<verse eid="PSA 89:48" /></para>
  <para style="q">
    <verse number="49" style="v" altnumber="48" sid="PSA 89:49" /> voser mentsh ken lebn un nisht zen dem toit?</para>
  <para style="q" vid="PSA 89:49">machn antrinen zain zel fun der hant fun der Sheol?</para>
  <para style="q" vid="PSA 89:49">Selah.<verse eid="PSA 89:49" /></para>
  <para style="b" />
  <para style="q">
    <verse number="50" style="v" altnumber="49" sid="PSA 89:50" /> vu zainen daine frierdike chasadim, Adonoi,</para>
  <para style="q" vid="PSA 89:50">vos du host geshvorn Dovidn in dain traishaft?<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" altnumber="50" sid="PSA 89:51" /> gedenk, Adonoi, di lesterung fun daine knecht,</para>
  <para style="q" vid="PSA 89:51">vos ich trog in main buzem fun al di fil felker;<verse eid="PSA 89:51" /></para>
  <para style="q">
    <verse number="52" style="v" altnumber="51" sid="PSA 89:52" /> vos daine faint, Hashem, lestern,</para>
  <para style="q" vid="PSA 89:52">vos zei lestern di trit fun dain gezalbtn.<verse eid="PSA 89:52" /></para>
  <para style="b" />
  <para style="q">
    <verse number="53" style="v" altnumber="52" sid="PSA 89:53" /> Baruch Hashem eibik,</para>
  <para style="q" vid="PSA 89:53">Omein un Omein!<verse eid="PSA 89:53" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" pubnumber="צ" sid="PSA 90" />
  <para style="ms">firter sefer</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 90:1" />a tfile fun Moshe dem man fun G-t.</para>
  <para style="q" vid="PSA 90:1">
    <char style="va">1</char> Adonoi, du bist undz geven bashitsung in ale doires.<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />eider di berg zainen geborn gevorn,</para>
  <para style="q" vid="PSA 90:2">un du host bashafn di erd un di velt,</para>
  <para style="q" vid="PSA 90:2">un fun eibikeit biz eibikeit,</para>
  <para style="q" vid="PSA 90:2">bist du El.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />brengst dem mentshn biz dershlognkeit,</para>
  <para style="q" vid="PSA 90:3">un zogst: tut tshuvh, ir mentshnkinder.<verse eid="PSA 90:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />vorem toiznt yor iz in daine oign</para>
  <para style="q" vid="PSA 90:4">vi der nechtiker tog, ven er iz fargangen,</para>
  <para style="q" vid="PSA 90:4">un vi a vach in der nacht.<verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />shtromst zei avek,</para>
  <para style="q" vid="PSA 90:5">vi a dreml vern zei;</para>
  <para style="q" vid="PSA 90:5">in frimorgn vi groz gevaksn,<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />in frimorgn geblit un gevaksn –</para>
  <para style="q" vid="PSA 90:6">tsum ovnt opgeshnitn un fardart.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />vorem mir vern farlendt in dain kaas,</para>
  <para style="q" vid="PSA 90:7">un in dain grimtsorn vern mir farchapt.<verse eid="PSA 90:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />haltst undzere zind antkegen dir,</para>
  <para style="q" vid="PSA 90:8">undzere farborgenishn faran licht fun dain ponem.<verse eid="PSA 90:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />vorem ale undzere teg fargeyen in dain grimtsorn,</para>
  <para style="q" vid="PSA 90:9">mir endikn undzere yorn azoi vi a hoich.<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />di teg fun undzere yorn, zei zainen zibetsik yor,</para>
  <para style="q" vid="PSA 90:10">un az in gevure, iz achtsik yor;</para>
  <para style="q" vid="PSA 90:10">un zeyer shtolts iz maternish un umglik;</para>
  <para style="q" vid="PSA 90:10">vorem gich fargeit es, un mir flien avek.<verse eid="PSA 90:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />ver farshteit di macht fun dain kaas,</para>
  <para style="q" vid="PSA 90:11">az vi dain mordikeit azoi iz dain grimtsorn?<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />lern undz richtik tsu tseiln undzere teg,</para>
  <para style="q" vid="PSA 90:12">kedei mir zoln krign a harts fun chochme.<verse eid="PSA 90:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />ker zich um, Hashem – vi lang noch? –</para>
  <para style="q" vid="PSA 90:13">un derbarim zich oif daine knecht.<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />zetik undz in frimorgn mit dain chesed,</para>
  <para style="q" vid="PSA 90:14">kedei mir zoln zingen un zain freilech in ale undzere teg.<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />derfrei undz vi di teg vos du host undz gepainikt,</para>
  <para style="q" vid="PSA 90:15">di yorn vos mir hobn gezen beiz.<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />zol bavizn vern dain tuung tsu daine knecht,</para>
  <para style="q" vid="PSA 90:16">un dain pracht oif zeyere kinder.<verse eid="PSA 90:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />un zol di liblechkeit fun Adonoi Elokeinu zain oif undz;</para>
  <para style="q" vid="PSA 90:17">un bafestik far undz dos verk fun undzere hent,</para>
  <para style="q" vid="PSA 90:17">yo, dos verk fun undzere hent, bafestik es.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" pubnumber="צא" sid="PSA 91" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1" />du vos zitsst in der farborgenish fun Elyon,</para>
  <para style="q" vid="PSA 91:1">vos in shotn fun Shaddai vailstu,<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />ich zog oif Hashem, main bashitsung un main festung</para>
  <para style="q" vid="PSA 91:2">main G-t vos ich farzicher zich oif im,<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />az er vet dich matsl zain fun foiglfangers nets,</para>
  <para style="q" vid="PSA 91:3">fun der pest fun fartilikung.<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />mit zain fleder vet er dich bashiremen,</para>
  <para style="q" vid="PSA 91:4">un unter zaine fliglen vestu zich shitsn;</para>
  <para style="q" vid="PSA 91:4">a shild un a shild iz zain traishaft.<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />vest nisht moire hobn far a shrek fun der nacht,</para>
  <para style="q" vid="PSA 91:5">far a fail vos flit bai tog;<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />far a pest vos geit um in der fintster,</para>
  <para style="q" vid="PSA 91:6">far a mageyfe vos farvist in mitn tog.<verse eid="PSA 91:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />dir fun zait veln faln toiznt,</para>
  <para style="q" vid="PSA 91:7">un tsen toiznt fun dain rechter hant,</para>
  <para style="q" vid="PSA 91:7">tsu dir vet es nisht genenen.<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />bloiz mit daine oign vestu onkukn,</para>
  <para style="q" vid="PSA 91:8">un di batsolung fun di reshoim vestu zen.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />vail du host gezogt: Hashem iz main bashitsung,</para>
  <para style="q" vid="PSA 91:9">gemacht dem Elyon far dain bashiremung.<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />dich vet nisht trefn kein beiz,</para>
  <para style="q" vid="PSA 91:10">un kein plog vet nisht genenen tsu dain getselt.<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />vorem zaine malachim vet er bafeln vegen dir,</para>
  <para style="q" vid="PSA 91:11">dich tsu hitn in ale daine vegen.<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />oif di hent veln zei dich trogn,</para>
  <para style="q" vid="PSA 91:12">tomer vestu opshlogn on a shtein dain fus.<verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />oif leibn un pipernoters vestu shpraizn,</para>
  <para style="q" vid="PSA 91:13">vest tsetretn yungleibn un shlang.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />vail er hot geglust tsu mir, vel ich im machn antrinen;</para>
  <para style="q" vid="PSA 91:14">ich vel im derheichn, vail er ken main nomen.<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />er vet mich rufn, un ich vel im entfern,</para>
  <para style="q" vid="PSA 91:15">ich vel zain mit im in a tsore,</para>
  <para style="q" vid="PSA 91:15">ich vel im derleizn, un im brengen tsu koved.<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />mit lange yorn vel ich im zetn,</para>
  <para style="q" vid="PSA 91:16">un vel im vaizn main hilf.<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" pubnumber="צב" sid="PSA 92" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 92:1" />a mizmor; a gezang far dem tog fun Shabbos.<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 92:2" /> gut iz tsu loibn Hashem,</para>
  <para style="q" vid="PSA 92:2">un zingen tsu dain nomen, du Elyon;<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 92:3" /> tsu dertseiln in frimorgn dain chesed</para>
  <para style="q" vid="PSA 92:3">un dain traishaft in di necht,<verse eid="PSA 92:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 92:4" /> oif a tsenstrune un oif a gitar,</para>
  <para style="q" vid="PSA 92:4">mit fartrachtung oif der harf.<verse eid="PSA 92:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 92:5" /> vorem host mich derfreit, Hashem, mit dain verk,</para>
  <para style="q" vid="PSA 92:5">ich zing vegen di meisim fun daine hent.<verse eid="PSA 92:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 92:6" /> vi grois zainen daine meisim, Hashem!</para>
  <para style="q" vid="PSA 92:6">tif biz gor zainen daine trachtungen.<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 92:7" /> der beheimisher mentsh veis nisht,</para>
  <para style="q" vid="PSA 92:7">un der nor farshteit dos nisht.<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 92:8" /> az di reshoim shprotsn vi groz,</para>
  <para style="q" vid="PSA 92:8">un es blien ale tuer fun umrecht,</para>
  <para style="q" vid="PSA 92:8">iz dos kedi zei zoln fartilikt vern oif eibik.<verse eid="PSA 92:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 92:9" /> ober du bist derhoibn oif eibik, Hashem.<verse eid="PSA 92:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 92:10" /> vorem ot daine faint, Hashem,</para>
  <para style="q" vid="PSA 92:10">vorem ot daine faint veln untergein,</para>
  <para style="q" vid="PSA 92:10">tseshpreit veln vern ale tuer fun umrecht.<verse eid="PSA 92:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 92:11" /> un host derheicht vi bai a vizltir main horn;</para>
  <para style="q" vid="PSA 92:11">ich hob mich bazalbt mit frishn eil.<verse eid="PSA 92:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 92:12" /> un main oig hot zich ongezen oif maine loierer;</para>
  <para style="q" vid="PSA 92:12">oif di shlechtstuer vos shteyen on oif mir,</para>
  <para style="q" vid="PSA 92:12">hern maine oiern zich on.<verse eid="PSA 92:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 92:13" /> der tsadik vet blien vi a teitlboim,</para>
  <para style="q" vid="PSA 92:13">vi a tsederboim in Levanon vet er vaksn.<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 92:14" /> aingeflantst in hoiz fun Hashem,</para>
  <para style="q" vid="PSA 92:14">in di hoifn fun Elokeinu veln zei blien.<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 92:15" /> zei veln noch shprotsn in groer elter,</para>
  <para style="q" vid="PSA 92:15">fet un zaftik veln zei zain;<verse eid="PSA 92:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 92:16" /> tsu dertseiln az Hashem iz rechtfartik,</para>
  <para style="q" vid="PSA 92:16">main feldz vos kein umrecht iz in im nishto.<verse eid="PSA 92:16" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" pubnumber="צג" sid="PSA 93" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1" />Hashem tut kinign;</para>
  <para style="q" vid="PSA 93:1">er hot zich mit groiskeit bakleidt;</para>
  <para style="q" vid="PSA 93:1">Hashem hot zich ongekleidt,</para>
  <para style="q" vid="PSA 93:1">mit shtarkeit zich ongegurt;</para>
  <para style="q" vid="PSA 93:1">oich iz bafestikt di velt,</para>
  <para style="q" vid="PSA 93:1">zi zol zich nisht vaklen.<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />fest shteit dain tron fun a mol,</para>
  <para style="q" vid="PSA 93:2">fun eibik on bistu.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />di taichn, Hashem, hobn oifgehoibn,</para>
  <para style="q" vid="PSA 93:3">di taichn hobn oifgehoibn zeyer kol;</para>
  <para style="q" vid="PSA 93:3">di taichn heibn oif zeyer geroish.<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />mer fun di koiles fun vasern groise,</para>
  <para style="q" vid="PSA 93:4">fun machtike indn fun yam,</para>
  <para style="q" vid="PSA 93:4">iz machtik Hashem in der heich.<verse eid="PSA 93:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />daine tseignim zainen zicher biz gor;</para>
  <para style="q" vid="PSA 93:5">far dain hoiz past zich heilikeit, Hashem,</para>
  <para style="q" vid="PSA 93:5">oif eibike teg.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" pubnumber="צד" sid="PSA 94" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1" />Hashem du El fun nkmut,</para>
  <para style="q" vid="PSA 94:1">Hashem fun nkmut, shain arois!<verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />derheib zich, du richter fun der erd,</para>
  <para style="q" vid="PSA 94:2">ker um fargeltung tsu di shtoltse.<verse eid="PSA 94:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />biz vanen veln di reshoim, Hashem,</para>
  <para style="q" vid="PSA 94:3">biz vanen veln di reshoim zich freyen?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />zei gavern, zei redn farshait,</para>
  <para style="q" vid="PSA 94:4">zei rimen zich, ale tuer fun umrecht.<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />dain folk, Hashem, tsedrikn zei,</para>
  <para style="q" vid="PSA 94:5">un zei painiken dain arav.<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />di almone un dem fremdn hargen zei,</para>
  <para style="q" vid="PSA 94:6">un yesoimim teitn zei.<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />un zei zogn: Hashem vet nisht zen,</para>
  <para style="q" vid="PSA 94:7">un der Elokei Yaakov vet nisht merkn.<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />batracht, ir fargrebte in folk,</para>
  <para style="q" vid="PSA 94:8">un ir narn, ven vet ir klug vern?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />der vos flantst dos oier, tsi vet er nisht hern?</para>
  <para style="q" vid="PSA 94:9">der vos furemt dos oig, tsi vet er nisht zen?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />der vos vornt di felker, tsi vet er nisht shtrofn?</para>
  <para style="q" vid="PSA 94:10">er vos lernt dem mentshn visen.<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />Hashem veis di machshoves fun dem mentshn,</para>
  <para style="q" vid="PSA 94:11">az zei zainen nishtik.<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />voil iz dem man vos Hashem shtroft,</para>
  <para style="q" vid="PSA 94:12">un fun dain toyre tustu im lernen;<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />kedei im tsu baruyen in teg fun beiz,</para>
  <para style="q" vid="PSA 94:13">biz a grub vet gegrobn vern faran roshe.<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />vorem Hashem vet nisht avekvarfn zain folk,</para>
  <para style="q" vid="PSA 94:14">un zain arav nisht farlozen.<verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />vorem tsum gerechtn vet zich umkeren dos recht,</para>
  <para style="q" vid="PSA 94:15">un noch im veln gein ale rechtfartikn hertser.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />ver vet oifshtein far mir akegn di shlechtstuer?</para>
  <para style="q" vid="PSA 94:16">ver vet zich shteln far mir akegn di tuer fun umrecht?<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />ven nisht Hashem volt mir a hilf geven,</para>
  <para style="q" vid="PSA 94:17">volt shir gerut in shtiln keyver main zel.<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />ven ich zog: main fus glitsht zich ois,</para>
  <para style="q" vid="PSA 94:18">lent mich unter, Hashem, dain chesed.<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />bai maine fil zorgenishn in mir,</para>
  <para style="q" vid="PSA 94:19">kvikn daine treistungen main zel.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />ken zich Chevron tsu dir der tron fun farbrechn,</para>
  <para style="q" vid="PSA 94:20">vos furemt umglik durch gezets?<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />zei klaibn zich oif dem nefesh fun tsadik,</para>
  <para style="q" vid="PSA 94:21">un umshuldik blut farmishpeten zei.<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />ober Hashem iz mir geven far a festung,</para>
  <para style="q" vid="PSA 94:22">un main G-t tsum feldz fun main bashitsung.<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />un er hot umgekert oif zei zeyer umrecht,</para>
  <para style="q" vid="PSA 94:23">un durch zeyer beiz tut er zei farshnaidn;</para>
  <para style="q" vid="PSA 94:23">farshnaidn tut zei Hashem Elokeinu.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" pubnumber="צה" sid="PSA 95" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />kumt, lomir zingen tsu Hashem,</para>
  <para style="q" vid="PSA 95:1">lomir shaln tsum feldz fun undzer hilf.<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />lomir kumen far zain ponem mit dank,</para>
  <para style="q" vid="PSA 95:2">mit gezangen lomir shaln tsu im.<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />vorem a groiser El iz Hashem,</para>
  <para style="q" vid="PSA 95:3">un a groiser melech iber ale g‑ter,<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />vos in zain hant zainen di gruntn fun der erd,</para>
  <para style="q" vid="PSA 95:4">un di heichn fun di berg zainen zaine;<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />vos der yam iz zainer, un er hot im gemacht;</para>
  <para style="q" vid="PSA 95:5">un di yaboshe hobn gefuremt zaine hent.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />kumt, lomir zich bukn un beigen,</para>
  <para style="q" vid="PSA 95:6">lomir knien far Hashem undzer Bashefer.<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />vorem er iz Elokeinu,</para>
  <para style="q" vid="PSA 95:7">un mir dos folk fun zain fiterung,</para>
  <para style="q" vid="PSA 95:7">un di shof fun zain hant;</para>
  <para style="q" vid="PSA 95:7">ven ir volt haint tsuhern tsu zain kol!<verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />macht nisht hart aier harts vi bai Merivah,</para>
  <para style="q" vid="PSA 95:8">vi in tog fun Massah in der midber,<verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />beeis aiere eltern hobn mich gepruvet,</para>
  <para style="q" vid="PSA 95:9">mich probirt, hagam zei hobn gezen main verk.<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />fertsik yor hob ich mich geeklt mitn dor,</para>
  <para style="q" vid="PSA 95:10">un hob gezogt: a folk mit farfirte hertser zainen zei,</para>
  <para style="q" vid="PSA 95:10">un zei veisn nisht maine vegen;<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />vos derum hob ich geshvorn in main tsorn,</para>
  <para style="q" vid="PSA 95:11">oib zei veln kumen in main ruung!<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" pubnumber="צו" sid="PSA 96" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />zingt tsu Hashem a nai gezang,</para>
  <para style="q" vid="PSA 96:1">zingt tsu Hashem, di gantse erd.<verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />zingt tsu Hashem, bentsht zain nomen,</para>
  <para style="q" vid="PSA 96:2">zeit mevaser fun tog tsu tog zain yeshue.<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />dertseilt tsvishn di felker zain koved,</para>
  <para style="q" vid="PSA 96:3">tsvishn ale umes zaine vunder.<verse eid="PSA 96:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />vorem grois iz Hashem, un zeyer geloibt,</para>
  <para style="q" vid="PSA 96:4">er iz forchtik iber ale g‑ter;<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />vorem di g‑ter fun ale felker zainen nishtik,</para>
  <para style="q" vid="PSA 96:5">un Hashem hot di himlen gemacht.<verse eid="PSA 96:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />glants un sheinkeit zainen far zain ponem,</para>
  <para style="q" vid="PSA 96:6">shtarkeit un pracht in zain mikdash.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />git tsu Hashem, ir mishpoches fun di felker,</para>
  <para style="q" vid="PSA 96:7">git tsu Hashem koved un shtarkeit.<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />git tsu Hashem dem koved fun zain nomen,</para>
  <para style="q" vid="PSA 96:8">brengt a minche, un kumt in zaine hoifn.<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />bukt zich tsu Hashem mit heilikn opshai,</para>
  <para style="q" vid="PSA 96:9">tsitert far im, di gantse erd.<verse eid="PSA 96:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />zogt tsvishn di felker: Hashem tut kinign;</para>
  <para style="q" vid="PSA 96:10">oich iz bafestikt di velt, zi zol zich nisht vaklen,</para>
  <para style="q" vid="PSA 96:10">er vet mishpetn di felker mit yoisher.<verse eid="PSA 96:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />zoln zich freyen di himlen, un zol lustik zain di erd,</para>
  <para style="q" vid="PSA 96:11">zol dunern der yam mit zain fulkeit.<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />zol freilech zain dos feld un alts vos derin;</para>
  <para style="q" vid="PSA 96:12">dentsmol zoln zingen ale beimer fun vald;<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />far Hashem, vorem er kumt,</para>
  <para style="q" vid="PSA 96:13">vorem er kumt mishpetn di erd;</para>
  <para style="q" vid="PSA 96:13">er vet mishpetn di velt mit gerechtikeit,</para>
  <para style="q" vid="PSA 96:13">un di felker mit zain vorhaftikeit.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" pubnumber="צז" sid="PSA 97" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />Hashem tut kinign, zol lustik zain di erd,</para>
  <para style="q" vid="PSA 97:1">zoln zich freyen di fil indzelen.<verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />volken un nebl zainen arum im,</para>
  <para style="q" vid="PSA 97:2">recht un gerechtikeit dos geshtel fun zain tron.<verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />a faier geit im farois,</para>
  <para style="q" vid="PSA 97:3">un farbrent rund arum zaine faint.<verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />zaine blitsn balaichtn di velt;</para>
  <para style="q" vid="PSA 97:4">es zet di erd, un zi tsitert.<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />di berg tsegeyen vi vaks far Hashem,</para>
  <para style="q" vid="PSA 97:5">far dem har fun der gantser erd.<verse eid="PSA 97:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />di himlen dertseiln zain gerechtikeit,</para>
  <para style="q" vid="PSA 97:6">un ale felker zeen zain koved.<verse eid="PSA 97:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />tsu shand vern ale getsndiner,</para>
  <para style="q" vid="PSA 97:7">vos rimen zich mit nishtikeitn;</para>
  <para style="q" vid="PSA 97:7">es bukn zich tsu im ale g‑ter.<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />Tsiyon hert un zi freit zich,</para>
  <para style="q" vid="PSA 97:8">un lustik zainen di techtershtet fun Yehudah,</para>
  <para style="q" vid="PSA 97:8">fun vegen daine mishpotim, Hashem.<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />vorem du Hashem bist der Elyon iber der gantser erd,</para>
  <para style="q" vid="PSA 97:9">hoich derhoibn iber ale g‑ter.<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />ir libhober fun Hashem, hot faint shlechts!</para>
  <para style="q" vid="PSA 97:10">er hit di nefoshes fun zaine frume,</para>
  <para style="q" vid="PSA 97:10">fun der hant fun reshoim iz er zei matsl.<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />a licht iz farzeit faran tsadik,</para>
  <para style="q" vid="PSA 97:11">un far di rechtfartikn hertser a freid.<verse eid="PSA 97:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />freit zich, ir tsadikim, mit Hashem,</para>
  <para style="q" vid="PSA 97:12">un dankt zain heiliker gedechenish.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" pubnumber="צח" sid="PSA 98" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 98:1" />a mizmor.</para>
  <para style="q" vid="PSA 98:1">
    <char style="va">1</char> zingt tsu Hashem a nai gezang,</para>
  <para style="q" vid="PSA 98:1">vorem vunder hot er geton;</para>
  <para style="q" vid="PSA 98:1">zain rechte hant hot im geholfn,</para>
  <para style="q" vid="PSA 98:1">un zain heiliker orem.<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />Hashem hot gelozt visen zain yeshue,</para>
  <para style="q" vid="PSA 98:2">far di oign fun felker</para>
  <para style="q" vid="PSA 98:2">hot er antplekt zain gerechtikeit.<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />er hot gedacht on zain chesed</para>
  <para style="q" vid="PSA 98:3">un zain traishaft tsu dem hoiz fun Yisroel;</para>
  <para style="q" vid="PSA 98:3">ale ekn fun der erd hobn gezen</para>
  <para style="q" vid="PSA 98:3">di yeshue fun Elokeinu.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />shalt tsu Hashem, di gantse erd,</para>
  <para style="q" vid="PSA 98:4">brecht ois un zingt un shpilt.<verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />shpilt tsu Hashem oif a harf,</para>
  <para style="q" vid="PSA 98:5">oif a harf mit a kol fun gezang.<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />mit trumeitn un a kol fun shoifer</para>
  <para style="q" vid="PSA 98:6">shalt far Hashem dem melech.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />zol dunern der yam mit zain fulkeit,</para>
  <para style="q" vid="PSA 98:7">di velt un di voiner in ir.<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />di taichn zoln klapn di hent,</para>
  <para style="q" vid="PSA 98:8">di berg zoln zingen in einem;<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />far Hashem, vorem er kumt mishpetn di erd;</para>
  <para style="q" vid="PSA 98:9">er vet mishpetn di velt mit gerechtikeit,</para>
  <para style="q" vid="PSA 98:9">un di felker mit yoisher.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" pubnumber="צט" sid="PSA 99" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />Hashem tut kinign,</para>
  <para style="q" vid="PSA 99:1">zoln tsiteren di felker;</para>
  <para style="q" vid="PSA 99:1">er tront iber di kruvim,</para>
  <para style="q" vid="PSA 99:1">zol zich vaklen di erd.<verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />Hashem iz grois in Tsiyon,</para>
  <para style="q" vid="PSA 99:2">un er iz derhoibn iber ale felker.<verse eid="PSA 99:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />zoln zei loibn dain groisn un forchtikn nomen</para>
  <para style="q" vid="PSA 99:3">– heilik iz er! –<verse eid="PSA 99:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />un di shtarkeit fun dem melech vos hot lib gerechtikeit.</para>
  <para style="q" vid="PSA 99:4">du host oifgeshtelt yoisher,</para>
  <para style="q" vid="PSA 99:4">recht un gerechtikeit hostu in Yaakov geton.<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />derheibt Hashem Elokeinu,</para>
  <para style="q" vid="PSA 99:5">un bukt zich tsu zain fusbenkel – heilik iz er!<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />Moshe un Aharon zainen geven tsvishn zaine koyanim,</para>
  <para style="q" vid="PSA 99:6">un Shmuel tsvishn di vos rufn zain nomen;</para>
  <para style="q" vid="PSA 99:6">zei flegn rufn tsu Hashem,</para>
  <para style="q" vid="PSA 99:6">un er flegt zei entfern.<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />in a volknzail flegt er redn tsu zei;</para>
  <para style="q" vid="PSA 99:7">zei hobn gehit zaine tseignim,</para>
  <para style="q" vid="PSA 99:7">un dos gezets vos er hot zei gegebn.<verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />Hashem Elokeinu, du host zei geentfert:</para>
  <para style="q" vid="PSA 99:8">a fargebiker El bistu zei geven,</para>
  <para style="q" vid="PSA 99:8">un host zich noikem geven fun zeyere vegen.<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />derheibt Hashem Elokeinu,</para>
  <para style="q" vid="PSA 99:9">un bukt zich tsu zain heilikn barg,</para>
  <para style="q" vid="PSA 99:9">vorem heilik iz Hashem Elokeinu.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" pubnumber="ק" sid="PSA 100" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 100:1" />a mizmor fun dankgebung.</para>
  <para style="q" vid="PSA 100:1">
    <char style="va">1</char> shalt tsu Hashem, di gantse erd.<verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />dint Hashem mit simche,</para>
  <para style="q" vid="PSA 100:2">kumt far im mit gezang.<verse eid="PSA 100:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />veist az Hashem, er iz Elokim;</para>
  <para style="q" vid="PSA 100:3">er hot undz bashafn, un zaine zainen mir,</para>
  <para style="q" vid="PSA 100:3">zain folk, un di shof fun zain fiterung.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />kumt in zaine toiern mit dank,</para>
  <para style="q" vid="PSA 100:4">in zaine hoifn mit loib;</para>
  <para style="q" vid="PSA 100:4">git a dank tsu im, bentsht zain nomen.<verse eid="PSA 100:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />vorem Hashem iz gut,</para>
  <para style="q" vid="PSA 100:5">oif eibik iz zain chesed,</para>
  <para style="q" vid="PSA 100:5">un biz dor-doires zain traishaft.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" pubnumber="קא" sid="PSA 101" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 101:1" />a mizmor fun Dovidn.</para>
  <para style="q" vid="PSA 101:1">
    <char style="va">1</char> genod un gerechtikeit vel ich bazingen,</para>
  <para style="q" vid="PSA 101:1">tsu dir Hashem vel ich zingen.<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />ich acht oifn erlechn veg;</para>
  <para style="q" vid="PSA 101:2">ven vestu kumen tsu mir?</para>
  <para style="q" vid="PSA 101:2">ich gei um in main hoiz</para>
  <para style="q" vid="PSA 101:2">in der erlechkeit fun main hartsn.<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />ich halt nisht far maine oign</para>
  <para style="q" vid="PSA 101:3">a nidertrechtike zach;</para>
  <para style="q" vid="PSA 101:3">dos ton fun di opkerers hob ich faint,</para>
  <para style="q" vid="PSA 101:3">es tut zich nisht baheftn on mir.<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />a krum harts iz opgeton fun mir,</para>
  <para style="q" vid="PSA 101:4">fun shlechtikeit veis ich nisht.<verse eid="PSA 101:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />der vos baredt in farborgenish zain chever,</para>
  <para style="q" vid="PSA 101:5">im hak ich op;</para>
  <para style="q" vid="PSA 101:5">der vos hot hoferdike oign un a shtolts harts,</para>
  <para style="q" vid="PSA 101:5">im ken ich nisht laidn.<verse eid="PSA 101:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />maine oign zainen oif di getraie fun land,</para>
  <para style="q" vid="PSA 101:6">zei zoln zitsn mit mir;</para>
  <para style="q" vid="PSA 101:6">der vos geit oifn veg fun erlechkeit,</para>
  <para style="q" vid="PSA 101:6">er iz in main dinst.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />in main hoiz tor nisht zitsn</para>
  <para style="q" vid="PSA 101:7">der vos bageit batrug; der vos redt ligns</para>
  <para style="q" vid="PSA 101:7">der vos redt ligns</para>
  <para style="q" vid="PSA 101:7">ken nisht bashtein far maine oign.<verse eid="PSA 101:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />ale frimorgn farshnaid ich</para>
  <para style="q" vid="PSA 101:8">ale reshoim fun land,</para>
  <para style="q" vid="PSA 101:8">kedei tsu farshnaidn fun Hashems shtot</para>
  <para style="q" vid="PSA 101:8">ale tuer fun umrecht.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" pubnumber="קב" sid="PSA 102" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 102:1" />a tfile far dem gedriktn ven er fargeit zich, un er gist ois far Hashem zain klog.<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 102:2" /> Hashem, her tsu main tfile,</para>
  <para style="q" vid="PSA 102:2">un main geshrei zol kumen tsu dir.<verse eid="PSA 102:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 102:3" /> zolst nisht farborgen dain ponem fun mir,</para>
  <para style="q" vid="PSA 102:3">in tog fun main noit naig dain oier tsu mir,</para>
  <para style="q" vid="PSA 102:3">in tog vos ich ruf, entfer mir gich.<verse eid="PSA 102:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 102:4" /> vorem azoi vi roich fargeyen maine teg,</para>
  <para style="q" vid="PSA 102:4">un maine beiner zainen vi an oivn tsebrent.<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 102:5" /> tseklapt vi groz un fartriknt iz main harts,</para>
  <para style="q" vid="PSA 102:5">vorem ich farges tsu esen main broit.<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 102:6" /> fun vegen di koiles fun main krechtsn</para>
  <para style="q" vid="PSA 102:6">iz main gebein tsugeklept tsu main hoit.<verse eid="PSA 102:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 102:7" /> ich bin geglichn tsu a pelikan fun midber,</para>
  <para style="q" vid="PSA 102:7">ich bin gevorn vi an ail fun di churves.<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 102:8" /> ich bin vach nochanand un bin gevorn</para>
  <para style="q" vid="PSA 102:8">vi an elnder foigel oif a dach.<verse eid="PSA 102:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 102:9" /> a gantsn tog lestern mich maine faint,</para>
  <para style="q" vid="PSA 102:9">di vos vildeven kegen mir, shiltn zich mit mir.<verse eid="PSA 102:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 102:10" /> vorem ash hob ich azoi vi broit gegesn,</para>
  <para style="q" vid="PSA 102:10">un maine getranken hob ich mit gevein gemisht.<verse eid="PSA 102:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 102:11" /> fun vegen dain kaas un dain tsorn;</para>
  <para style="q" vid="PSA 102:11">vorem host mich oifgehoibn un mich avekgeshlaidert.<verse eid="PSA 102:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 102:12" /> maine teg zainen vi a shotn vos naigt zich,</para>
  <para style="q" vid="PSA 102:12">un azoi vi groz trikn ich ain.<verse eid="PSA 102:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 102:13" /> ober du Hashem tronst oif eibik,</para>
  <para style="q" vid="PSA 102:13">un dain gedechenish iz oif dor-doires.<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 102:14" /> du vest oifshtein un zich derbaremen oif Tsiyon,</para>
  <para style="q" vid="PSA 102:14">vorem es iz tsait zi tsu laitzelikn,</para>
  <para style="q" vid="PSA 102:14">vorem gekumen iz di sheh.<verse eid="PSA 102:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 102:15" /> vorem daine knecht gorn noch ire shteiner,</para>
  <para style="q" vid="PSA 102:15">un ir shtoib hobn zei lib.<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 102:16" /> un di felker veln forchtn dem nomen fun Hashem,</para>
  <para style="q" vid="PSA 102:16">un ale mlochim fun der erd dain pracht,<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 102:17" /> ven Hashem hot oifgeboit Tsiyon,</para>
  <para style="q" vid="PSA 102:17">zich bavizn in zain pracht;<verse eid="PSA 102:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 102:18" /> zich gekert tsu der tfile fun dem elndn,</para>
  <para style="q" vid="PSA 102:18">un nisht faracht zeyer tfile.<verse eid="PSA 102:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 102:19" /> dos vet farshribn vern faran shpeterdikn dor,</para>
  <para style="q" vid="PSA 102:19">un dos folk vos vet bashafn vern, vet loibn Hashem.<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 102:20" /> vorem er hot aropgekukt fun zain heiliker heich;</para>
  <para style="q" vid="PSA 102:20">Hashem hot fun himel gelugt oif der erd,<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 102:21" /> tsu hern dos krechtsn fun gefangenem,</para>
  <para style="q" vid="PSA 102:21">frai tsu machn di ongebreite tsum toit.<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 102:22" /> kedei me zol dertseiln in Tsiyon Hashems nomen,</para>
  <para style="q" vid="PSA 102:22">un zain loib in Yerushalayim,<verse eid="PSA 102:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 102:23" /> ven di felker zamlen zich ain in einem,</para>
  <para style="q" vid="PSA 102:23">un di kinigraichn tsu dinen Hashem.<verse eid="PSA 102:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 102:24" /> er hot opgeshlaft in veg main koiech,</para>
  <para style="q" vid="PSA 102:24">er hot gekirtst maine teg.<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 102:25" /> ich zog: main G-t,</para>
  <para style="q" vid="PSA 102:25">zolst mich nisht aveknemen in helft fun maine teg,</para>
  <para style="q" vid="PSA 102:25">du vos oif dor-doires zainen daine yorn.<verse eid="PSA 102:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 102:26" /> lang tsurik hostu di erd gegruntfest,</para>
  <para style="q" vid="PSA 102:26">un dos verk fun daine hent zainen di himlen.<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 102:27" /> zei veln untergein, un du vest bashtein,</para>
  <para style="q" vid="PSA 102:27">yo, zei ale veln vi a beged tsekrichn,</para>
  <para style="q" vid="PSA 102:27">vi a malbesh vestu zei baitn, un zei veln fargein;<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 102:28" /> ober du bist der eigener,</para>
  <para style="q" vid="PSA 102:28">un daine yorn veln zich nisht endikn.<verse eid="PSA 102:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 102:29" /> di kinder fun daine knecht veln blaibn,</para>
  <para style="q" vid="PSA 102:29">un zeyer zomen vet shtein fest far dir.<verse eid="PSA 102:29" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" pubnumber="קג" sid="PSA 103" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 103:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 103:1">
    <char style="va">1</char> loib, main zel, Hashem,</para>
  <para style="q" vid="PSA 103:1">un ale maine ingeveid, zain heilikn nomen.<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />loib Hashem, main zel,</para>
  <para style="q" vid="PSA 103:2">un zolst nisht fargesen ale zaine toivus;<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />der vos fargit al di zind daine,</para>
  <para style="q" vid="PSA 103:3">vos heilt ale krankshaftn daine;<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />vos leizt ois fun grub dain lebn,</para>
  <para style="q" vid="PSA 103:4">vos kreint dich mit genod un derbaremung;<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />vos zetikt mit guts dain elter,</para>
  <para style="q" vid="PSA 103:5">vi an odler banait zich di yugnt daine.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />Hashem tut gerechtikeitn,</para>
  <para style="q" vid="PSA 103:6">un recht tsu ale gedrikte.<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />er hot gelozt visen Mosheen zaine vegen,</para>
  <para style="q" vid="PSA 103:7">di kinder fun Yisroel zaine meisim.<verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />Hashem iz derbaremdik un laitzelik,</para>
  <para style="q" vid="PSA 103:8">aingehaltn in tsorn un raich in genod.<verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />nisht shtendik vet er krign,</para>
  <para style="q" vid="PSA 103:9">un nisht eibik vet er haltn a kaas.<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />nisht loit undzere chatoim hot er undz geton,</para>
  <para style="q" vid="PSA 103:10">un nisht loit undzere zind hot er undz fargoltn.<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />vorem vi der himel iz hoich iber der erd,</para>
  <para style="q" vid="PSA 103:11">azoi iz shtark zain chesed tsu di vos forchtn im.<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />vi mizrech iz vait fun mayrev,</para>
  <para style="q" vid="PSA 103:12">azoi hot er dervaitert fun undz undzere farbrechn.<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />vi a foter derbaremt zich oif zaine kinder,</para>
  <para style="q" vid="PSA 103:13">azoi derbaremt zich Hashem oif di vos forchtn im.<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />vorem er veis undzer bashafung,</para>
  <para style="q" vid="PSA 103:14">er gedenkt az mir zainen shtoib.<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />der mentsh – azoi vi groz zainen zaine teg,</para>
  <para style="q" vid="PSA 103:15">vi a shprotsung fun feld, azoi shprotst er.<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />vorem a vint geit ariber oif im, un er iz nishto,</para>
  <para style="q" vid="PSA 103:16">un zain ort derkent im nisht mer.<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />ober der chesed fun Hashem iz fun eibik biz eibik</para>
  <para style="q" vid="PSA 103:17">oif di vos forchtn im,</para>
  <para style="q" vid="PSA 103:17">un zain gerechtikeit tsu kinds-kinder;<verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />tsu di vos hitn zain bris</para>
  <para style="q" vid="PSA 103:18">un tsu di vos gedenken zaine bafeln zei tsu ton.<verse eid="PSA 103:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />Hashem hot in himel oifgeshtelt zain tron,</para>
  <para style="q" vid="PSA 103:19">un zain meluche geveltikt iber alts.<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />loibt Hashem, zaine malachim,</para>
  <para style="q" vid="PSA 103:20">ir shtarke giborim vos tut zain vort,</para>
  <para style="q" vid="PSA 103:20">baim hern dem kol fun zain vort.<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />loibt Hashem, ale zaine cheilut,</para>
  <para style="q" vid="PSA 103:21">zaine meshoresim vos tut zain rotsn.<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />loibt Hashem, ale zaine verk,</para>
  <para style="q" vid="PSA 103:22">in ale erter fun zain geveltikeit;</para>
  <para style="q" vid="PSA 103:22">loib Hashem, main zel.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" pubnumber="קד" sid="PSA 104" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />loib Hashem, main zel;</para>
  <para style="q" vid="PSA 104:1">Hashem main G-t, bist grois biz gor,</para>
  <para style="q" vid="PSA 104:1">in glants un sheinkeit bistu ongekleidt.<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />der vos viklt zich in licht vi in a mantl,</para>
  <para style="q" vid="PSA 104:2">vos shpreit ois di himlen vi a forhang.<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />vos balknt mit vaser zaine eibershtubn;</para>
  <para style="q" vid="PSA 104:3">vos macht volkens far zain raitvogn,</para>
  <para style="q" vid="PSA 104:3">vos geit oif di fliglen fun vint.<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />vos macht zaine shluchim di vintn,</para>
  <para style="q" vid="PSA 104:4">zaine meshoresim – flakerik faier.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />er hot gegruntfest di erd oif ire geshteln,</para>
  <para style="q" vid="PSA 104:5">zi zol zich nisht vaklen, eibik un shtendik.<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />dem tehom, im hostu vi a kleid ibergedekt;</para>
  <para style="q" vid="PSA 104:6">iber di berg zainen geshtanen di vasern.<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />fun dain ongeshrei zainen zei antlofn,</para>
  <para style="q" vid="PSA 104:7">fun kol fun dain duner hobn zei avekgeailt –<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />berg hobn zich oifgehoibn,</para>
  <para style="q" vid="PSA 104:8">toln hobn genidert –</para>
  <para style="q" vid="PSA 104:8">tsu dem ort vos du host gegruntfest far zei.<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />host gemacht a gvul vos zei zoln nisht aribergein,</para>
  <para style="q" vid="PSA 104:9">kedei zei zoln nisht vider badekn di erd.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />er iz der vos shikt kvaln in di toln,</para>
  <para style="q" vid="PSA 104:10">zei zoln gein tsvishn di berg.<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />zei trinken on ale chayes fun feld,</para>
  <para style="q" vid="PSA 104:11">di valdeizlen shtiln zeyer dorsht.<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />lebn zei ruen di foiglen fun himel,</para>
  <para style="q" vid="PSA 104:12">fun tsvishn di tsvaign gibn zei arois a kol.<verse eid="PSA 104:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />bist der vos trinkt on di berg fun zaine eibershtubn;</para>
  <para style="q" vid="PSA 104:13">fun der frucht fun daine tuungen vert gezetikt di erd.<verse eid="PSA 104:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />er macht shprotsn groz far der beheime,</para>
  <para style="q" vid="PSA 104:14">un hei far di arbetfi fun dem mentshn,</para>
  <para style="q" vid="PSA 104:14">kedei aroistsutsien broit fun der erd;<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />un vain vos derfreit dem mentshns harts,</para>
  <para style="q" vid="PSA 104:15">tsu machn glantsn dem ponem mer vi eil;</para>
  <para style="q" vid="PSA 104:15">un broit vos lent unter dem mentshns harts.<verse eid="PSA 104:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />di beimer fun Hashem zetn zich on,</para>
  <para style="q" vid="PSA 104:16">di tsedern fun Levanon vos er hot geflantst,<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />vos dortn nestn di foiglen;</para>
  <para style="q" vid="PSA 104:17">der shtorch, zain hoiz zainen tsipresn.<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />di hoiche berg zainen far di shteinbek,</para>
  <para style="q" vid="PSA 104:18">di feldzn a bashitsung far di kinigls.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />er hot gemacht di levone far di tsaitn;</para>
  <para style="q" vid="PSA 104:19">di zun veis ir untergang.<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />machst fintsternish, un es vert nacht,</para>
  <para style="q" vid="PSA 104:20">in ir vidmenen zich ale chayes fun feld.<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />di yungleibn briln noch roib,</para>
  <para style="q" vid="PSA 104:21">un betn fun El zeyer shpaiz.<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />geit oif di zun, vern zei aingeton,</para>
  <para style="q" vid="PSA 104:22">un zei hoiern in zeyere nores.<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />geit arois der mentsh tsu zain verk,</para>
  <para style="q" vid="PSA 104:23">un tsu zain arbet biz ovnt.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />vi fil zainen daine verk, Hashem!</para>
  <para style="q" vid="PSA 104:24">zei ale hostu mit chochme gemacht;</para>
  <para style="q" vid="PSA 104:24">di gantse erd iz ful mit dain eigens.<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />on iz der yam, grois un breit,</para>
  <para style="q" vid="PSA 104:25">dort iz a vidmenung on a tsol,</para>
  <para style="q" vid="PSA 104:25">chayes groise mit kleine.<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />dort geyen um shifn;</para>
  <para style="q" vid="PSA 104:26">der lioiotn vos du host bashafn zich tsu shpiln derin.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />zei ale kukn ois tsu dir,</para>
  <para style="q" vid="PSA 104:27">tsu gebn zeyer shpaiz in ir tsait.<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />gistu zei, klaibn zei oif,</para>
  <para style="q" vid="PSA 104:28">efnst dain hant, zetn zei zich mit guts.<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />farborgstu dain ponem, vern zei farchapt,</para>
  <para style="q" vid="PSA 104:29">tust ain zeyer otem, fargeyen zei,</para>
  <para style="q" vid="PSA 104:29">un kern zich um tsu zeyer shtoib.<verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />du shikst arois dain ruach, azoi vern zei bashafn,</para>
  <para style="q" vid="PSA 104:30">un du banaist dem ponem fun der erd.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />zol der koved fun Hashem zain oif eibik!</para>
  <para style="q" vid="PSA 104:31">zol Hashem zich freyen mit zaine verk!<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />der vos kukt on di erd, un zi tsitert,</para>
  <para style="q" vid="PSA 104:32">vos rirt on di berg, un zei reichern.<verse eid="PSA 104:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />ich vel zingen tsu Hashem kol-zman ich leb,</para>
  <para style="q" vid="PSA 104:33">ich vel shpiln tsu main G-t vi lang ich bin.<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />zol im gezist zain main redn;</para>
  <para style="q" vid="PSA 104:34">ich frei zich mit Hashem.<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />zoln di zindike farlendt vern fun der erd,</para>
  <para style="q" vid="PSA 104:35">un di reshoim zoln mer nisht zain.</para>
  <para style="q" vid="PSA 104:35">loib Hashem, main zel,</para>
  <para style="q" vid="PSA 104:35">halalu Hashem.<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" pubnumber="קה" sid="PSA 105" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />git a dank tsu Hashem, ruft zain nomen,</para>
  <para style="q" vid="PSA 105:1">lozt visen tsvishn di felker zaine tuungen.<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />zingt tsu im, shpilt tsu im,</para>
  <para style="q" vid="PSA 105:2">redt fun ale zaine vunder.<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />rimt aich mit zain heilikn nomen;</para>
  <para style="q" vid="PSA 105:3">zol zich freyen dos harts fun di vos zuchn Hashem.<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />forsht Hashem un zain shtarkeit,</para>
  <para style="q" vid="PSA 105:4">zucht zain ponem tamid.<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5" />dermont zaine vunder vos er hot geton,</para>
  <para style="q" vid="PSA 105:5">zaine tseichns, un di mishpotim fun zain moil,<verse eid="PSA 105:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6" />ir zomen fun Avraham zain knecht,</para>
  <para style="q" vid="PSA 105:6">ir kinder fun Yaakov, zaine oisderveilte.<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />er iz Hashem Elokeinu,</para>
  <para style="q" vid="PSA 105:7">iber der gantser erd zainen zaine mishpotim.<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />er gedenkt eibik zain bris,</para>
  <para style="q" vid="PSA 105:8">dos vort vos er hot bafoiln oif toiznt doires;<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />vos er hot geshlosn mit Avrahamen,</para>
  <para style="q" vid="PSA 105:9">un zain shvue tsu ytschkn.<verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />un er hot es oifgeshtelt far a chok tsu Yaakov,</para>
  <para style="q" vid="PSA 105:10">far an eibikn bris tsu Yisroel,<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />azoi tsu zogn: dir vel ich gebn dos land Kenaan,</para>
  <para style="q" vid="PSA 105:11">dem teil fun aier nachle.<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />az ir zait geven mentshn getseilte,</para>
  <para style="q" vid="PSA 105:12">vintsik un fremde derin,<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />un zei zainen umgegangen fun folk tsu folk,</para>
  <para style="q" vid="PSA 105:13">un fun ein kinigraich tsu an ander ume,<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />hot er nisht gelozn a mentshn zei drikn,</para>
  <para style="q" vid="PSA 105:14">un hot geshtroft mlochim vegen zei:<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />ir zolt nisht onrirn maine gezalbte,</para>
  <para style="q" vid="PSA 105:15">un maine neviim zolt ir nisht beiz ton.<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />un er hot gerufn a hunger oifn land,</para>
  <para style="q" vid="PSA 105:16">yetveder unterlen fun broit hot er tsebrochn.<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />er hot zei farois geshikt a man:</para>
  <para style="q" vid="PSA 105:17">far a knecht iz farkoift gevorn Yosef.<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />me hot gepainikt in keitn zain fus,</para>
  <para style="q" vid="PSA 105:18">in aizn iz araingeton gevorn zain neshome;<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />biz der tsait vos zain vort iz geshen,</para>
  <para style="q" vid="PSA 105:19">hot der bafel fun Hashem im gepruvet.<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />der melech hot geshikt un im loiz gelozt,</para>
  <para style="q" vid="PSA 105:20">der geveltiker fun felker – un im frai gemacht.<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />er hot im gemacht far a har iber zain hoiz,</para>
  <para style="q" vid="PSA 105:21">un far a geveltiker iber zain gantsn eigens,<verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />tsu bindn zaine harn loit zain barot,</para>
  <para style="q" vid="PSA 105:22">un zaine eltste zol er klign.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />un Yisroel iz gekumen kein Mitsrayim.</para>
  <para style="q" vid="PSA 105:23">un Yaakov hot zich oifgehaltn in land Cham.<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />un er hot zeyer gefruchpert zain folk,</para>
  <para style="q" vid="PSA 105:24">un zei gemacht shtarker fun zeyere driker.<verse eid="PSA 105:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />er hot farkert zeyer harts faint tsu hobn zain folk,</para>
  <para style="q" vid="PSA 105:25">zich tsu klign akegn zaine knecht.<verse eid="PSA 105:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />er hot geshikt Moshe zain knecht,</para>
  <para style="q" vid="PSA 105:26">Aharonen vemen er hot oisderveilt.<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />hobn zei gemacht tsvishn zei di zachn fun zaine tseichns,</para>
  <para style="q" vid="PSA 105:27">un vunder in land fun Cham.<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />er hot ongeshikt fintsternish un fintster gemacht;</para>
  <para style="q" vid="PSA 105:28">un zei hobn nisht vidershpenikt zain vort.<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />er hot farkert zeyere vasern in blut,</para>
  <para style="q" vid="PSA 105:29">un hot geteit zeyere fish.<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />zeyer land hot gevidmet fresh,</para>
  <para style="q" vid="PSA 105:30">biz in di kamern fun zeyere mlochim.<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />er hot geheisn, un a gemish flign iz gekumen,</para>
  <para style="q" vid="PSA 105:31">umgetsifer in zeyer gantsn gemark.<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />er hot gegebn anshtot zeyere regns hogel,</para>
  <para style="q" vid="PSA 105:32">a flamfaier in zeyer land.<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />un er hot aingeshlogn zeyer vainshtok un zeyer faignboim,</para>
  <para style="q" vid="PSA 105:33">un oisgebrachn di beimer fun zeyer gemark.<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />er hot geheisn, un a heisherik iz gekumen,</para>
  <para style="q" vid="PSA 105:34">un a grozfreser azh on a tsol;<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />un er hot oifgegesn yetveder kraitechts in zeyer land,</para>
  <para style="q" vid="PSA 105:35">un oifgegesn di frucht fun zeyer erd.<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />un er hot geshlogn yetveder bechor in zeyer land,</para>
  <para style="q" vid="PSA 105:36">di ershtlingen fun al zeyer kraft.<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />un hot zei aroisgetsoign mit zilber un gold;</para>
  <para style="q" vid="PSA 105:37">un nisht geven tsvishn zaine shvotim a shtroichler.<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />Mitsrayim hot zich gefreit mit zeyer aroisgein,</para>
  <para style="q" vid="PSA 105:38">vorem zeyer shrek iz gefaln oif zei.<verse eid="PSA 105:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />er hot farshpreit a volken tsum tsudek,</para>
  <para style="q" vid="PSA 105:39">un a faier tsu laichtn bai nacht.<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />me hot farlangt, un er hot gebracht vachtlfoiglen,</para>
  <para style="q" vid="PSA 105:40">un mit broit fun himel flegt er zei zetn.<verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />er hot geefent a Tsur, un vaser iz pliuchen,</para>
  <para style="q" vid="PSA 105:41">gegangen vi a taich durch di trikenishn.<verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />vorem er hot gedacht on zain heilikn tsuzog</para>
  <para style="q" vid="PSA 105:42">tsu Avraham zain knecht.<verse eid="PSA 105:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />un er hot aroisgetsoign zain folk mit freid,</para>
  <para style="q" vid="PSA 105:43">mit gezang zaine oisderveilte.<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />un er hot zei gegebn di lender fun di felker,</para>
  <para style="q" vid="PSA 105:44">un di mi fun di umes hobn zei geyarshet;<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />kedei zei zoln haltn zaine gezetsn,</para>
  <para style="q" vid="PSA 105:45">un zaine lernungen zoln zei hitn.</para>
  <para style="q" vid="PSA 105:45">halalu Hashem.<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" pubnumber="קו" sid="PSA 106" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 106:1">git a dank tsu Hashem, vorem er iz gut,</para>
  <para style="q" vid="PSA 106:1">vorem oif eibik iz zain chesed.<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />ver ken oisredn di gevuros fun Hashem?</para>
  <para style="q" vid="PSA 106:2">machn hern zain gantsn loib?<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />voil tsu di vos hitn gerechtikeit,</para>
  <para style="q" vid="PSA 106:3">tsu dem vos tut recht in yetveder tsait.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />gedenk mich, Hashem, ven du bavilikst dain folk,</para>
  <para style="q" vid="PSA 106:4">dermon mich in dain hilf;<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />kedei ich zol zen dos guts fun daine oisderveilte,</para>
  <para style="q" vid="PSA 106:5">zich freyen in der freid fun dain folk,</para>
  <para style="q" vid="PSA 106:5">zich rimen in einem mit dain arav.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />mir hobn gezindikt azoi vi undzere eltern,</para>
  <para style="q" vid="PSA 106:6">mir hobn farbrochn, mir hobn shlechts geton.<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />undzere eltern in Mitsrayim hobn nisht batracht daine vunder,</para>
  <para style="q" vid="PSA 106:7">zei hobn nisht gedacht on daine fil chasadim,</para>
  <para style="q" vid="PSA 106:7">un hobn vidershpenikt baim yam, baim Yam-Suf.<verse eid="PSA 106:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />ober er hot zei geholfn fun zain nomen vegen,</para>
  <para style="q" vid="PSA 106:8">kedei tsu lozn visen zain gevure.<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />un er hot ongeshrien oifn Yam-Suf, un er iz gevorn trukn,</para>
  <para style="q" vid="PSA 106:9">un er hot zei gefirt durch di tehomen vi durch a step.<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />un er hot zei geholfn fun dem soines hant,</para>
  <para style="q" vid="PSA 106:10">un zei oisgeleizt fun der hant fun faint.<verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />un di vasern hobn tsugedekt zeyere driker,</para>
  <para style="q" vid="PSA 106:11">nisht an eintsiker fun zei iz geblibn.<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />un zei hobn gegloibt in zaine verter,</para>
  <para style="q" vid="PSA 106:12">zei hobn gezungen zain loib.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />gich hobn zei fargesen zaine tuungen;</para>
  <para style="q" vid="PSA 106:13">zei hobn nisht gehart oif zain eitse.<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />un zei hobn geglust a glustung in der midber,</para>
  <para style="q" vid="PSA 106:14">un gepruvet El in der viste.<verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />un er hot zei gegebn zeyer farlang,</para>
  <para style="q" vid="PSA 106:15">ober er hot geshikt a mogerkeit in zeyer neshomes.<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />un zei hobn zich mekane geven on Mosheen in lager,</para>
  <para style="q" vid="PSA 106:16">un on Aharon dem heilikn fun Hashem.<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />hot di erd zich geefent, un aingeshlungen Dotanen,</para>
  <para style="q" vid="PSA 106:17">un tsugedekt dos gezeml fun Aviramen.<verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />un a faier hot zich ongetsundn in zeyer gezeml,</para>
  <para style="q" vid="PSA 106:18">a flam hot farbrent di reshoim.<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />zei hobn gemacht a kalb in Chorev,</para>
  <para style="q" vid="PSA 106:19">un zich gebukt tsu a gegosenem gets.<verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />un zei hobn farbaiten zeyer koved oif der geshtalt</para>
  <para style="q" vid="PSA 106:20">fun an oks vos est groz.<verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />zei hobn fargesen on El zeyer helfer,</para>
  <para style="q" vid="PSA 106:21">vos hot geton groise zachn in Mitsrayim,<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />vunder in land fun Cham,</para>
  <para style="q" vid="PSA 106:22">forchtike zachn baim Yam-Suf.<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />un er hot gevolt zei fartiliken,</para>
  <para style="q" vid="PSA 106:23">ven nisht Moshe zain oisderveilter</para>
  <para style="q" vid="PSA 106:23">volt zich geshtelt far im in dem broch,</para>
  <para style="q" vid="PSA 106:23">optsuhaltn zain grimtsorn fun umbrengen.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />un zei hobn faracht dos glustike land,</para>
  <para style="q" vid="PSA 106:24">nisht gegloibt in zain vort.<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />un zei hobn gemurmlt in zeyere getseltn,</para>
  <para style="q" vid="PSA 106:25">nisht tsugehert tsu dem kol fun Hashem.<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />un er hot oifgehoibn zain hant vegen zei,</para>
  <para style="q" vid="PSA 106:26">zei tsu machn faln in der midber,<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />un tsevarfn zeyer zomen tsvishn di felker,</para>
  <para style="q" vid="PSA 106:27">un zei tseshpreitn in di lender.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />un zei hobn zich baheft on dem Baal fun Peor,</para>
  <para style="q" vid="PSA 106:28">un gegesn shlachtopfer tsu toite.<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />un zei hobn derkaast mit zeyere meisim,</para>
  <para style="q" vid="PSA 106:29">un a mageyfe hot oisgebrachn tsvishn zei.<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />un Pinchas iz oifgeshtanen, un hot a mishpot geton,</para>
  <para style="q" vid="PSA 106:30">un di mageyfe iz farhaltn gevorn.<verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />un es iz im gerechnt gevorn tsu gerechtikeit,</para>
  <para style="q" vid="PSA 106:31">oif dor-doires biz eibik.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />un zei hobn dertsernt bai di vasern fun Merivah,</para>
  <para style="q" vid="PSA 106:32">un Mosheen iz geshen beiz fun vegen zei;<verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />vorem zei hobn farbitert zain ruach,</para>
  <para style="q" vid="PSA 106:33">un er hot zich aroisgeredt mit zaine lipn.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />zei hobn nisht fartilikt di felker,</para>
  <para style="q" vid="PSA 106:34">azoi vi Hashem hot zei ongezogt.<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />un zei hobn zich gemisht mit di felker,</para>
  <para style="q" vid="PSA 106:35">un zich opgelernt zeyere meisim.<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />un zei hobn gedint zeyere getsnbilder,</para>
  <para style="q" vid="PSA 106:36">vos zainen gevorn a shtroichlung far zei.<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />un zei hobn geshlacht zeyere zin</para>
  <para style="q" vid="PSA 106:37">un zeyere techter tsu di Shedim,<verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />un hobn fargosen umshuldik blut,</para>
  <para style="q" vid="PSA 106:38">dos blut fun zeyere zin un zeyere techter,</para>
  <para style="q" vid="PSA 106:38">vos zei hobn geshlacht tsu di getsnbilder fun Kenaan;</para>
  <para style="q" vid="PSA 106:38">un dos land iz zindik gevorn durch blut.<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />un zei zainen gevorn umrein durch zeyere meisim,</para>
  <para style="q" vid="PSA 106:39">un farfirt gevorn in zeyere tuungen.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />un der tsorn fun Hashem hot gegrimt oif zain folk,</para>
  <para style="q" vid="PSA 106:40">un er hot farumverdikt zain arav.<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />un er hot zei gegebn in der hant fun di felker,</para>
  <para style="q" vid="PSA 106:41">un zeyere sonem hobn geveltikt iber zei.<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />un zeyere faint hobn zei gedrikt,</para>
  <para style="q" vid="PSA 106:42">un zei zainen untertenik gevorn unter zeyer hant.<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />fil mol flegt er zei matsl zain,</para>
  <para style="q" vid="PSA 106:43">ober zei flegn vidershpenikn in zeyer barot,</para>
  <para style="q" vid="PSA 106:43">un zainen aropgekumen durch zeyer zind.<verse eid="PSA 106:43" /></para>
  <para style="b" />
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />un er hot tsugezen zeyer noit,</para>
  <para style="q" vid="PSA 106:44">az er hot gehert zeyer geshrei.<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />un er hot zei gedenkt zain bris,</para>
  <para style="q" vid="PSA 106:45">un zich badacht loit zain grois genod.<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />un er hot zei gegebn derbaremung</para>
  <para style="q" vid="PSA 106:46">bai ale zeyere fanger.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />helf undz, Hashem Elokeinu,</para>
  <para style="q" vid="PSA 106:47">un zaml undz ain fun di felker,</para>
  <para style="q" vid="PSA 106:47">tsu danken dain heilikn nomen,</para>
  <para style="q" vid="PSA 106:47">zich tsu rimen mit dain loib.<verse eid="PSA 106:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />Baruch Hashem Elokei Yisroel</para>
  <para style="q" vid="PSA 106:48">fun eibikeit un biz eibikeit,</para>
  <para style="q" vid="PSA 106:48">un zol dos gantse folk zogn: Omein!</para>
  <para style="q" vid="PSA 106:48">halalu Hashem.<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" pubnumber="קז" sid="PSA 107" />
  <para style="ms">finfter sefer</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />git a dank tsu Hashem, vorem er iz gut,</para>
  <para style="q" vid="PSA 107:1">vorem oif eibik iz zain chesed,<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />zoln zogn di oisgeleizte fun Hashem,</para>
  <para style="q" vid="PSA 107:2">vos er hot zei oisgeleizt fun der hant fun faint,<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />un fun di lender zei aingezamlt,</para>
  <para style="q" vid="PSA 107:3">fun mizrech un fun mayrev,</para>
  <para style="q" vid="PSA 107:3">fun tsofn un fun yam.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />zei hobn geblondzhet in midber oif a vistn veg,</para>
  <para style="q" vid="PSA 107:4">kein shtot fun Yishuv nisht gefunen.<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />hungerike un dorshtike,</para>
  <para style="q" vid="PSA 107:5">iz zeyer zel geven farchlsht in zei.<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />hobn zei geshrien tsu Hashem in zeyer noit,</para>
  <para style="q" vid="PSA 107:6">un er hot zei matsl geven fun zeyer klem.<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />un er hot zei gefirt oif a glaichn veg,</para>
  <para style="q" vid="PSA 107:7">tsu kumen tsu a shtot fun Yishuv.<verse eid="PSA 107:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />zei darfn danken Hashem far zain chesed,</para>
  <para style="q" vid="PSA 107:8">un far zaine vunder tsu di mentshnkinder.<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />vorem er hot gezetikt di farshmachte zel,</para>
  <para style="q" vid="PSA 107:9">un di hungerike zel hot er ongefilt mit guts.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />di vos zainen gezesn in fintsternish un toitshotn,</para>
  <para style="q" vid="PSA 107:10">gekeit in pain un aizn –<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />vail zei hobn vidershpenikt di verter fun El,</para>
  <para style="q" vid="PSA 107:11">un di eitse fun dem Elyon gelestert;<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />un er hot untertenikt mit laid zeyer harts;</para>
  <para style="q" vid="PSA 107:12">zei zainen geshtroichlt gevorn, un nisht geven kein helfer –<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />hobn zei geshrien tsu Hashem in zeyer noit,</para>
  <para style="q" vid="PSA 107:13">un er hot zei geholfn fun zeyer klem.<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />er hot zei aroisgetsoign fun fintsternish un toitshotn,</para>
  <para style="q" vid="PSA 107:14">un zeyere bindshtrik hot er tserisn.<verse eid="PSA 107:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />zei darfn danken Hashem far zain chesed,</para>
  <para style="q" vid="PSA 107:15">un far zaine vunder tsu di mentshnkinder.<verse eid="PSA 107:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />vorem er hot tsebrochn di kuperne tirn,</para>
  <para style="q" vid="PSA 107:16">un di aizerne riglen tsehakt.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />narn hobn far zeyer zindikn veg</para>
  <para style="q" vid="PSA 107:17">un far zeyere farbrechn gelitn;<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />zeyer zel hot zich geeklt mit itlecher shpaiz,</para>
  <para style="q" vid="PSA 107:18">un zei hobn dergreicht biz di toiern fun toit.<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />hobn zei geshrien tsu Hashem in zeyer noit,</para>
  <para style="q" vid="PSA 107:19">un er hot zei geholfn fun zeyer klem.<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />er hot geshikt zain vort un zei geheilt,</para>
  <para style="q" vid="PSA 107:20">un gemacht antrinen fun zeyere kvorim.<verse eid="PSA 107:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />zei darfn danken Hashem far zain chesed,</para>
  <para style="q" vid="PSA 107:21">un far zaine vunder tsu di mentshnkinder.<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />un zei darfn shlachtn dankopfer,</para>
  <para style="q" vid="PSA 107:22">un dertseiln zaine meisim mit gezang.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />di vos nidern in shifn oifn yam,</para>
  <para style="q" vid="PSA 107:23">di vos tuen mischar oif groise vasern,<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />zei hobn gezen di meisim fun Hashem,</para>
  <para style="q" vid="PSA 107:24">un zaine vunder oif der tifenish.<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />vorem er hot geheisn</para>
  <para style="q" vid="PSA 107:25">un gemacht oifshtein a shturemvint,</para>
  <para style="q" vid="PSA 107:25">vos hot oifgehoibn zaine indn.<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />zei zainen aroif bizn himel,</para>
  <para style="q" vid="PSA 107:26">genidert biz di tehomen,</para>
  <para style="q" vid="PSA 107:26">zeyer zel iz tsegangen fun angst.<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />zei hobn zich gedreit un gevorfn vi a shikurer,</para>
  <para style="q" vid="PSA 107:27">un zeyer gantse chochme iz tsemisht gevorn.<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />hobn zei geshrien tsu Hashem in zeyer noit,</para>
  <para style="q" vid="PSA 107:28">un er hot zei aroisgetsoign fun zeyer klem.<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />er hot aingeshtelt dem shturem in shtilkeit,</para>
  <para style="q" vid="PSA 107:29">un antshvigen gevorn zainen di indn.<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />un zei hobn zich gefreit vos zei zainen aingeshtilt,</para>
  <para style="q" vid="PSA 107:30">un er hot zei gefirt tsu dem bortn fun zeyer bager.<verse eid="PSA 107:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />zei darfn danken Hashem far zain chesed,</para>
  <para style="q" vid="PSA 107:31">un far zaine vunder tsu di mentshnkinder.<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />un zei darfn im derheibn in der ainzamlung fun folk,</para>
  <para style="q" vid="PSA 107:32">un in der zitsung fun di eltste im loibn.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />er macht shtromen far a midber,</para>
  <para style="q" vid="PSA 107:33">un oisgangen vaser far a dorshtenish;<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />a fruchtik land far a zaltsvistenish,</para>
  <para style="q" vid="PSA 107:34">fun vegen der shlechtikeit fun di voiner in ir.<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />er macht a midber far a taich vaser,</para>
  <para style="q" vid="PSA 107:35">un a trukn land far oisgangen vaser.<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />un er bazetst dortn di hungerike,</para>
  <para style="q" vid="PSA 107:36">un zei shteln oif a shtot fun Yishuv.<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />un zei farzeyen felder, un flantsn vaingertner,</para>
  <para style="q" vid="PSA 107:37">vos brengen frucht tsum ainkum.<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />un er bentsht zei, un zei mern zich zeyer,</para>
  <para style="q" vid="PSA 107:38">un er lozt nisht zeyere beheimes zain vintsik.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />un andere vern geminert un geboign,</para>
  <para style="q" vid="PSA 107:39">fun der drikenish fun umglik un kumer.<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />er gist ois farachtung oif firshtn,</para>
  <para style="q" vid="PSA 107:40">un macht zei blondzhen in a viste on a veg.<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />un er heibt oif dem evyon fun orimkeit,</para>
  <para style="q" vid="PSA 107:41">un macht vi shof zaine mishpoches.<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />di rechtfartikn zeen un freyen zich,</para>
  <para style="q" vid="PSA 107:42">un itlech umrecht macht tsu tsumachn zain moil.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />ver es iz klug, zol merkn dos dozike,</para>
  <para style="q" vid="PSA 107:43">un zoln zei batrachtn di chasadim fun Hashem.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" pubnumber="קח" sid="PSA 108" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 108:1" />a gezang, a mizmor fun Dovidn.<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 108:2" /> fest iz main harts, Elokim,</para>
  <para style="q" vid="PSA 108:2">ich vel zingen un shpiln,</para>
  <para style="q" vid="PSA 108:2">yo, mit main zel.<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 108:3" /> dervek dich, gitar un harf;</para>
  <para style="q" vid="PSA 108:3">lomich oifvekn dem baginen.<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 108:4" /> ich vel dich loibn, Hashem, tsvishn di felker,</para>
  <para style="q" vid="PSA 108:4">un dich bazingen tsvishn di umes.<verse eid="PSA 108:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 108:5" /> vorem grois iber di himlen iz dain chesed,</para>
  <para style="q" vid="PSA 108:5">un biz di volken dain traishaft.<verse eid="PSA 108:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 108:6" /> derheib dich iber di himlen, Elokim,</para>
  <para style="q" vid="PSA 108:6">un iber der gantser erd zol zain dain koved.<verse eid="PSA 108:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 108:7" /> kedei daine balibte zoln derleizt vern,</para>
  <para style="q" vid="PSA 108:7">helf mit dain rechter hant, un entfer mir.<verse eid="PSA 108:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 108:8" /> Elokim hot geredt in zain heilikeit,</para>
  <para style="q" vid="PSA 108:8">az ich vel derfreit vern;</para>
  <para style="q" vid="PSA 108:8">ich vel tseteiln Shechem,</para>
  <para style="q" vid="PSA 108:8">un dem tal Sukkot vel ich oismestn.<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 108:9" /> main iz Gilad, main iz Menasheh,</para>
  <para style="q" vid="PSA 108:9">un Efrayim iz der kiver fun main kop;</para>
  <para style="q" vid="PSA 108:9">Yehudah iz main tsepter.<verse eid="PSA 108:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 108:10" /> Moav iz main vashtop,</para>
  <para style="q" vid="PSA 108:10">oif Edom vorf ich main shuch,</para>
  <para style="q" vid="PSA 108:10">iber Peleshet tu ich shaln.<verse eid="PSA 108:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 108:11" /> ver brengt mich tsu der bafestikter shtot,</para>
  <para style="q" vid="PSA 108:11">ver firt mich kein Edom?<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 108:12" /> far vor, Elokim, host undz farlozt,</para>
  <para style="q" vid="PSA 108:12">un geist nisht arois, Elokim, mit undzere machnus.<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 108:13" /> gib undz hilf kegen dem faint,</para>
  <para style="q" vid="PSA 108:13">vorem nishtik iz di yeshue fun a mentshn.<verse eid="PSA 108:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 108:14" /> mit Elokim veln mir oifton gevuros,</para>
  <para style="q" vid="PSA 108:14">un er vet tsetretn undzere faint.<verse eid="PSA 108:14" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" pubnumber="קט" sid="PSA 109" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 109:1" />far dem gezangmaister; fun Dovidn a mizmor.</para>
  <para style="q" vid="PSA 109:1">
    <char style="va">1</char>Elokim fun main loib, zolst nisht shvaign.<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />vorem a beiz moil un a moil fun batrug</para>
  <para style="q" vid="PSA 109:2">hobn zei geefent oif mir;</para>
  <para style="q" vid="PSA 109:2">zei hobn geredt tsu mir mit a tsung fun lign.<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />un mit reid fun sine hobn zei mich arumgeringlt,</para>
  <para style="q" vid="PSA 109:3">un geshtritn kegen mir far umzist,<verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />far main libshaft faintn zei mich,</para>
  <para style="q" vid="PSA 109:4">beeis ich bin loiter gebet.<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />un zei hobn mir opgeton a roeh far a toive,</para>
  <para style="q" vid="PSA 109:5">un sine far main libshaft.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />zets on oif im a roshe,</para>
  <para style="q" vid="PSA 109:6">un an onkloger zol shtein bai zain rechter zait.<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />az er vert gemishpet, zol er aroisgein shuldik,</para>
  <para style="q" vid="PSA 109:7">un zain tfile zol vern tsu zind.<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />zaine teg zoln zain vintsik,</para>
  <para style="q" vid="PSA 109:8">zain opgeshports zol tsunemen an anderer.<verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />zaine kinder zoln vern yesoimim,</para>
  <para style="q" vid="PSA 109:9">un zain vaib an almone.<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />un voglen zoln voglen zaine kinder, un betlen,</para>
  <para style="q" vid="PSA 109:10">un zuchn broit fun zeyere churves arois.<verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />farnemen zol a baal-choiv alts vos er hot,</para>
  <para style="q" vid="PSA 109:11">un fremde zoln avekroiben zain mi.<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />keiner zol nisht naign tsu im genod,</para>
  <para style="q" vid="PSA 109:12">un keiner zol nisht laitzelikn zaine yesoimim.<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />zain nochkum zol farshnitn vern;</para>
  <para style="q" vid="PSA 109:13">in ander dor zol zeyer nomen zain oisgemekt.<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />zol di zind fun zaine foters dermont vern far Hashem,</para>
  <para style="q" vid="PSA 109:14">un der chet fun zain muter zol nisht farmekt vern;<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />zei zoln zain antkegen Hashem tamid,</para>
  <para style="q" vid="PSA 109:15">un er zol farshnaidn fun der erd zeyer gedechenish.<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />far vos er hot nisht gedacht tsu ton chesed,</para>
  <para style="q" vid="PSA 109:16">un er hot geroideft dem oreman un dem evyon,</para>
  <para style="q" vid="PSA 109:16">un dem vos zain harts iz batribt, tsu teitn.<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />yo, er hot lib gehat di klole,</para>
  <para style="q" vid="PSA 109:17">to zol zi im onkumen;</para>
  <para style="q" vid="PSA 109:17">un er hot nisht gevuntshn kein broche,</para>
  <para style="q" vid="PSA 109:17">to zol zi vait zain fun im.<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />un er hot ongeton di klole vi zain kleid,</para>
  <para style="q" vid="PSA 109:18">to zol zi arain vi vaser in zaine ingeveid,</para>
  <para style="q" vid="PSA 109:18">un vi eil in zaine beiner.<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />zol zi im zain vi a beged vos er tut on,</para>
  <para style="q" vid="PSA 109:19">un far a gartel zol er es ongurtn tamid.<verse eid="PSA 109:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />dos zol zain der loin fun Hashem tsu maine sonem,</para>
  <para style="q" vid="PSA 109:20">un tsu di vos redn beiz akegn main zel.<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />un du Hashem Adonoi, tu mit mir fun dain nomen vegen,</para>
  <para style="q" vid="PSA 109:21">vail dain chesed iz gut, zai mich matsl.<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />vorem orim un baderftik bin ich,</para>
  <para style="q" vid="PSA 109:22">un main harts iz tselechert in mir.<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />azoi vi a shotn ven er naigt zich, fargei ich,</para>
  <para style="q" vid="PSA 109:23">ich bin opgetreislt gevorn vi a heisherik.<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />maine kni shtroichlen fun fasten,</para>
  <para style="q" vid="PSA 109:24">un main laib iz opgetsert, on fetkeit.<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />un ich bin gevorn a charpe bai zei,</para>
  <para style="q" vid="PSA 109:25">az zei zeen mich, shoklen zei zeyer kop.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />shtei mir bai, Hashem main G-t,</para>
  <para style="q" vid="PSA 109:26">helf mich loit dain genod.<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />un zoln zei visen az dos iz dain hant,</para>
  <para style="q" vid="PSA 109:27">az du, Hashem, host dos geton.<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />zoln zei shiltn, un du zolst bentshn;</para>
  <para style="q" vid="PSA 109:28">az zei shteyen oif, zoln zei farshemt vern,</para>
  <para style="q" vid="PSA 109:28">un dain knecht zol zich freyen.<verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />zoln maine faint zich bakleidn mit shand,</para>
  <para style="q" vid="PSA 109:29">un onton vi a mantl zeyer bushe.<verse eid="PSA 109:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />ich vel gebn grois dank tsu Hashem mit main moil,</para>
  <para style="q" vid="PSA 109:30">un tsvishn fil mentshn vel ich im loibn.<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />vorem er shteit bai der rechter hant fun baderftikn,</para>
  <para style="q" vid="PSA 109:31">tsu helfn fun di vos farmishpeten zain zel.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" pubnumber="קי" sid="PSA 110" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 110:1" />fun Dovidn a mizmor.</para>
  <para style="q" vid="PSA 110:1">
    <char style="va">1</char>Hashem zogt tsu main har:</para>
  <para style="q" vid="PSA 110:1">zits bai main rechter hant,</para>
  <para style="q" vid="PSA 110:1">biz ich vel machn daine faint</para>
  <para style="q" vid="PSA 110:1">far a benkl tsu daine fis.<verse eid="PSA 110:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />dem tsepter fun dain macht</para>
  <para style="q" vid="PSA 110:2">vet Hashem oisshtrekn fun Tsiyon;</para>
  <para style="q" vid="PSA 110:2">geveltik tsvishn daine faint.<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />dain folk bot zich on in tog fun dain milchome;</para>
  <para style="q" vid="PSA 110:3">in heiliker sheinkeit,</para>
  <para style="q" vid="PSA 110:3">fun tracht fun baginen,</para>
  <para style="q" vid="PSA 110:3">kumt dir der toi fun dain yugnt.<verse eid="PSA 110:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />Hashem hot geshvorn, un vet nisht charote hobn:</para>
  <para style="q" vid="PSA 110:4">bist a koyen oif eibik,</para>
  <para style="q" vid="PSA 110:4">oifn shteiger fun Malki-Tsedek.<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />Adonoi bai dain rechter hant</para>
  <para style="q" vid="PSA 110:5">tsehakt mlochim in tog fun zain tsorn.<verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />er vet ton a mishpot tsvishn di felker;</para>
  <para style="q" vid="PSA 110:6">er filt on mit toite laiber;</para>
  <para style="q" vid="PSA 110:6">er tsehakt kep oif a breitn land.<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />fun bach oifn veg vet er trinken;</para>
  <para style="q" vid="PSA 110:7">derum vet er oifheibn dem kop.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" pubnumber="קיא" sid="PSA 111" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 111:1">ich vel loibn Hashem mitn gantsn hartsn,</para>
  <para style="q" vid="PSA 111:1">in a gezeml fun rechtfartikn un an eide.<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />di verk fun Hashem zainen grois,</para>
  <para style="q" vid="PSA 111:2">zei vern geforsht fun ale vos gorn zei.<verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />pracht un sheinkeit iz zain tuung,</para>
  <para style="q" vid="PSA 111:3">un zain gerechtikeit bashteit oif eibik.<verse eid="PSA 111:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />er hot gemacht an ondenk far zaine vunder;</para>
  <para style="q" vid="PSA 111:4">Hashem iz derbaremdik un laitzelik.<verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />er git shpaiz tsu di vos forchtn im,</para>
  <para style="q" vid="PSA 111:5">er gedenkt oif eibik zain bris.<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />di shtarkeit fun zaine verk hot er gevizn zain folk,</para>
  <para style="q" vid="PSA 111:6">kedei zei tsu gebn di arav fun di felker.<verse eid="PSA 111:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />di verk fun zaine hent zainen emes un gerechtikeit,</para>
  <para style="q" vid="PSA 111:7">zicher zainen ale zaine bafeln;<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />oifgehaltn oif eibik un shtendik,</para>
  <para style="q" vid="PSA 111:8">gemacht mit emes un yoisher.<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />an oisleizung hot er geshikt tsu zain folk;</para>
  <para style="q" vid="PSA 111:9">er hot bafoiln oif eibik zain bris;</para>
  <para style="q" vid="PSA 111:9">heilik un forchtik iz zain nomen.<verse eid="PSA 111:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />der onheib fun chochme iz moire far Hashem;</para>
  <para style="q" vid="PSA 111:10">voilfarshtandikeit iz bai ale vos tuen dos.</para>
  <para style="q" vid="PSA 111:10">zain loib bashteit eibik.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" pubnumber="קיב" sid="PSA 112" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 112:1">voil tsu dem man vos hot moire far Hashem,</para>
  <para style="q" vid="PSA 112:1">vos noch zaine gebot tut er gorn zeyer.<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />machtik in land vet zain zain kinder;</para>
  <para style="q" vid="PSA 112:2">der dor fun di rechtfartikn vet zain gebentsht.<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />guts un eshires iz bai im in hoiz,</para>
  <para style="q" vid="PSA 112:3">un zain gerechtikeit bashteit oif eibik.<verse eid="PSA 112:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />er shaint far di rechtfartikn vi a licht in der fintster,</para>
  <para style="q" vid="PSA 112:4">er iz laitzelik un derbaremdik un gerecht.<verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />gut iz der man vos iz laitzelik un lait,</para>
  <para style="q" vid="PSA 112:5">vos firt zaine zachn mit gerechtikeit.<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />vorem er vet kein mol nisht umfaln;</para>
  <para style="q" vid="PSA 112:6">tsu eibiker gedechenish vet zain der tsadik.<verse eid="PSA 112:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />far a beizer besoire hot er nisht moire,</para>
  <para style="q" vid="PSA 112:7">fest iz zain harts, er iz batuach oif Hashem.<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />zicher iz zain harts, er hot nisht kein moire,</para>
  <para style="q" vid="PSA 112:8">biz er zet zich on oif zaine faint.<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />er teilt funander, er git di baderftike,</para>
  <para style="q" vid="PSA 112:9">zain tsedoke bashteit oif eibik;</para>
  <para style="q" vid="PSA 112:9">zain horn vet derhoibn zain in koved.<verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />der roshe vet zen un zich ergern,</para>
  <para style="q" vid="PSA 112:10">zaine tsein vet er kritsn un vet tsegangen vern;</para>
  <para style="q" vid="PSA 112:10">der bager fun di reshoim vet untergein.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" pubnumber="קיג" sid="PSA 113" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 113:1">loibt, ir knecht fun Hashem,</para>
  <para style="q" vid="PSA 113:1">loibt dem nomen fun Hashem.<verse eid="PSA 113:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />zol gebentsht zain der nomen fun Hashem</para>
  <para style="q" vid="PSA 113:2">fun atsund un biz eibik.<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />fun oifgang fun der zun biz ir untergang</para>
  <para style="q" vid="PSA 113:3">vert geloibt der nomen fun Hashem.<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />Hashem iz derhoibn iber ale felker,</para>
  <para style="q" vid="PSA 113:4">iber di himlen iz zain pracht.<verse eid="PSA 113:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />ver iz vi Hashem Elokeinu,</para>
  <para style="q" vid="PSA 113:5">vos tront in der heich?<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />vos kukt arop tif</para>
  <para style="q" vid="PSA 113:6">oif di himlen un oif der erd.<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />er shtelt oif fun shtoib dem oreman,</para>
  <para style="q" vid="PSA 113:7">fun mistn derheibt er dem evyon,<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />tsu zetsn mit firshtn,</para>
  <para style="q" vid="PSA 113:8">mit di firshtn fun zain folk.<verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />er macht di akore zitsn in hoiz</para>
  <para style="q" vid="PSA 113:9">a freileche muter fun kinder.</para>
  <para style="q" vid="PSA 113:9">halalu Hashem.<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" pubnumber="קיד" sid="PSA 114" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />az Yisroel iz arois fun Mitsrayim,</para>
  <para style="q" vid="PSA 114:1">dos hoiz fun Yaakov fun a vildshprachikn folk,<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />iz Yehudah gevorn far zain heiliktum,</para>
  <para style="q" vid="PSA 114:2">Yisroel zain geveltikung.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />der yam hot derzen un iz antlofn,</para>
  <para style="q" vid="PSA 114:3">der Yarden hot opgetrotn ahinter.<verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />di berg zainen geshprungen vi viders,</para>
  <para style="q" vid="PSA 114:4">di heichn vi yunge shof.<verse eid="PSA 114:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />vos iz dir, yam, vos du loifst?</para>
  <para style="q" vid="PSA 114:5">du Yarden, vos du tretst op ahinter?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />ir berg, vos ir shpringt vi viders?</para>
  <para style="q" vid="PSA 114:6">ir heichn – vi yunge shof?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />far Adon, tu tsiteren, erd,</para>
  <para style="q" vid="PSA 114:7">far dem Eloah fun Yaakov,<verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />vos farkert dem feldz in a taich vaser,</para>
  <para style="q" vid="PSA 114:8">kizlshtein in a vaserkval.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" pubnumber="קטו" sid="PSA 115" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />nisht undz, Hashem, nisht undz,</para>
  <para style="q" vid="PSA 115:1">naiert dain nomen gib koved,</para>
  <para style="q" vid="PSA 115:1">fun vegen dain chesed,</para>
  <para style="q" vid="PSA 115:1">fun vegen dain traishaft.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />far vos zoln zogn di felker:</para>
  <para style="q" vid="PSA 115:2">vu akorsht iz zeyer G-t?<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />ober Elokeinu iz in himel,</para>
  <para style="q" vid="PSA 115:3">alts vos er bagert, tut er.<verse eid="PSA 115:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />zeyere getsnbilder zainen zilber un gold,</para>
  <para style="q" vid="PSA 115:4">dos verk fun a mentshns hent.<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />zei hobn a moil un redn nisht,</para>
  <para style="q" vid="PSA 115:5">zei hobn oign un zeen nisht;<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />zei hobn oiern un hern nisht,</para>
  <para style="q" vid="PSA 115:6">zei hobn a noz un shmekn nisht;<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />hent bai zei, ober zei kenen nisht ontapn,</para>
  <para style="q" vid="PSA 115:7">fis bai zei, ober zei geyen nisht;</para>
  <para style="q" vid="PSA 115:7">zei tuen nisht a hoich mit zeyer kel.<verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />zoln vern vi zei di vos machn zei,</para>
  <para style="q" vid="PSA 115:8">itlecher vos farzichert zich oif zei.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />Yisroel, farzicher zich oif Hashem.</para>
  <para style="q" vid="PSA 115:9">er iz zeyer hilf un zeyer shild.<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />hoiz fun Aharon, farzichert aich oif Hashem.</para>
  <para style="q" vid="PSA 115:10">er iz zeyer hilf un zeyer shild.<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />ir forchter fun Hashem, farzichert aich oif Hashem.</para>
  <para style="q" vid="PSA 115:11">er iz zeyer hilf un zeyer shild.<verse eid="PSA 115:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />Hashem hot gedacht on undz, er vet bentshn,</para>
  <para style="q" vid="PSA 115:12">er vet bentshn dos hoiz fun Yisroel,</para>
  <para style="q" vid="PSA 115:12">er vet bentshn dos hoiz fun Aharon.<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />er vet bentshn di vos forchtn Hashem,</para>
  <para style="q" vid="PSA 115:13">di kleine azoi vi di groise.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />Hashem vet aich mern,</para>
  <para style="q" vid="PSA 115:14">aich un aiere kinder.<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />gebentsht zolt ir zain fun Hashem,</para>
  <para style="q" vid="PSA 115:15">dem Bashefer fun himel un erd.<verse eid="PSA 115:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />di himlen zainen di himlen fun Hashem,</para>
  <para style="q" vid="PSA 115:16">ober di erd hot er gegebn tsu di mentshnkinder.<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />nisht di toite veln loibn Hashem,</para>
  <para style="q" vid="PSA 115:17">un nisht di ale vos nidern in shtiln keyver.<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />ober mir veln bentshn Hashem,</para>
  <para style="q" vid="PSA 115:18">fun atsund un biz eibik.</para>
  <para style="q" vid="PSA 115:18">halalu Hashem.<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" pubnumber="קטז" sid="PSA 116" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />ich lib Hashem</para>
  <para style="q" vid="PSA 116:1">vail er ht gehert main kol un maine gebetn.<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />vail er hot geneigt zain oier tsu mir,</para>
  <para style="q" vid="PSA 116:2">derum in maine teg vel ich im rufn.<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />arumgeringlt hobn mich di shtrik fun toit,</para>
  <para style="q" vid="PSA 116:3">un angstn fun Sheol hobn mich getrofn;</para>
  <para style="q" vid="PSA 116:3">laid un kumer hob ich getrofn.<verse eid="PSA 116:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />hob ich dem nomen fun Hashem gerufn:</para>
  <para style="q" vid="PSA 116:4">ich bet dich, Hashem, mach antrinen main zel.<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />laitzelik iz Hashem un gerecht,</para>
  <para style="q" vid="PSA 116:5">un Elokeinu iz derbaremdik.<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />Hashem farhit di umgenite;</para>
  <para style="q" vid="PSA 116:6">ich bin geven gefaln, un er hot mich geholfn.<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />ker zich um, main zel, tsu dain roikeit.</para>
  <para style="q" vid="PSA 116:7">vorem Hashem hot dir guts geton.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />vorem host aroisgetsoign main zel fun toit,</para>
  <para style="q" vid="PSA 116:8">fun trern main oig,</para>
  <para style="q" vid="PSA 116:8">main fus fun shtroichlung.<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />ich vel umgein far Hashem</para>
  <para style="q" vid="PSA 116:9">in di lender fun di lebedike.<verse eid="PSA 116:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />ich hob gegloibt, ven ich hob geredt:</para>
  <para style="q" vid="PSA 116:10">ich bin geplogn geven zeyer.<verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />ich hob gezogt in main angst:</para>
  <para style="q" vid="PSA 116:11">ale mentshn zainen falsh.<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />vi zol ich optsolen Hashem</para>
  <para style="q" vid="PSA 116:12">ale zaine toivus tsu mir?<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />dem kos fun yeshues vel ich oifheibn,</para>
  <para style="q" vid="PSA 116:13">un dem nomen fun Hashem vel ich rufn,<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />maine nedrim tsu Hashem vel ich batsoln</para>
  <para style="q" vid="PSA 116:14">antkegen far zain gantsn folk.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />shver in di oign fun Hashem</para>
  <para style="q" vid="PSA 116:15">iz der toit fun zaine frume.<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />ich bet dich, Hashem, vorem ich bin dain knecht,</para>
  <para style="q" vid="PSA 116:16">ich bin dain knecht, der zun fun dain dinst;</para>
  <para style="q" vid="PSA 116:16">host loizgemacht maine bindshtrik.<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />ich vel shlachtn tsu dir a dankopfer,</para>
  <para style="q" vid="PSA 116:17">un dem nomen fun Hashem vel ich rufn.<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18" />maine nedrim tsu Hashem vel ich batsoln</para>
  <para style="q" vid="PSA 116:18">ankegn far zain gantsn folk,<verse eid="PSA 116:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19" />in di hoifn fun Hashems hoiz,</para>
  <para style="q" vid="PSA 116:19">in mitn fun dir, Yerushalayim.</para>
  <para style="q" vid="PSA 116:19">halalu Hashem.<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" pubnumber="קיז" sid="PSA 117" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />loibt Hashem, ale felker,</para>
  <para style="q" vid="PSA 117:1">git a shevech tsu im, ale umes,<verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />vorem shtark iz zain chesed oif undz,</para>
  <para style="q" vid="PSA 117:2">un di traishaft fun Hashem iz oif eibik.</para>
  <para style="q" vid="PSA 117:2">halalu Hashem.<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" pubnumber="קיח" sid="PSA 118" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />git a dank tsu Hashem, vorem er iz gut,</para>
  <para style="q" vid="PSA 118:1">vorem oif eibik iz zain chesed.<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />zol Nun zogn Yisroel:</para>
  <para style="q" vid="PSA 118:2">vorem oif eibik iz zain chesed.<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />zol Nun zogn dos hoiz fun Aharon:</para>
  <para style="q" vid="PSA 118:3">vorem oif eibik iz zain chesed.<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />zoln Nun zogn di vos forchtn Hashem:</para>
  <para style="q" vid="PSA 118:4">vorem oif eibik iz zain chesed.<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />fun engenish hob ich gerufn Hashem,</para>
  <para style="q" vid="PSA 118:5">hot Hashem mir geentfert mit der breiternish.<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />Hashem iz mit mir, ich hob nisht kein moire,</para>
  <para style="q" vid="PSA 118:6">vos ken a mentsh mir ton?<verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />Hashem iz mir main helfer,</para>
  <para style="q" vid="PSA 118:7">un ich vel zen oif maine sonem.<verse eid="PSA 118:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />beser zich bashitsn in Hashem,</para>
  <para style="q" vid="PSA 118:8">eider zich farzichern oif a mentshn.<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />beser zich bashitsn in Hashem,</para>
  <para style="q" vid="PSA 118:9">eider zich farzichern oif firshtn.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />ale felker hobn mich arumgeringlt;</para>
  <para style="q" vid="PSA 118:10">mit dem nomen fun Hashem ober vel ich zei farshnaidn.<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />zei hobn mich arumgeringlt, yo arumgeringlt hobn zei mich;</para>
  <para style="q" vid="PSA 118:11">mit dem nomen fun Hashem ober vel ich zei farshnaidn.<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />zei hobn mich arumgeringlt vi binen;</para>
  <para style="q" vid="PSA 118:12">zei zainen farloshn gevorn vi faier fun derner;</para>
  <para style="q" vid="PSA 118:12">far vor, mit dem nomen fun Hashem vel ich zei farshnaidn.<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />shtoisn hostu mich geshtoisn tsum faln,</para>
  <para style="q" vid="PSA 118:13">ober Hashem hot mich geholfn.<verse eid="PSA 118:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />main shtarkeit un gezang iz Hashem,</para>
  <para style="q" vid="PSA 118:14">un er iz mir geven a yeshue.<verse eid="PSA 118:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />a kol fun gezang un yeshue</para>
  <para style="q" vid="PSA 118:15">iz in di getseltn fun di tsadikim;</para>
  <para style="q" vid="PSA 118:15">di rechte hant fun Hashem tut gevuros.<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />di rechte hant fun Hashem iz derhoibn,</para>
  <para style="q" vid="PSA 118:16">di rechte hant fun Hashem tut gevuros.<verse eid="PSA 118:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />ich vel nisht shtarbn nor lebn,</para>
  <para style="q" vid="PSA 118:17">un dertseiln di meisim fun Hashem.<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />shtrofn geshtroft hot mich Hashem,</para>
  <para style="q" vid="PSA 118:18">ober tsum toit hot er mich nisht gegebn.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />efent mir di toiern fun gerechtikeit,</para>
  <para style="q" vid="PSA 118:19">ich vel araingein in zei, ich vel danken Hashem.<verse eid="PSA 118:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />dos iz der toier fun Hashem,</para>
  <para style="q" vid="PSA 118:20">di gerechte zoln araingein in im.<verse eid="PSA 118:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />ich dank dir, vorem host mir geentfert,</para>
  <para style="q" vid="PSA 118:21">un bist mir geven a yeshue.<verse eid="PSA 118:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />der shtein vos di boimainsters hobn farvorfen,</para>
  <para style="q" vid="PSA 118:22">iz gevorn tsum hoipt funem vinkel.<verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />fun Hashem iz dos geshen,</para>
  <para style="q" vid="PSA 118:23">vunderlech iz es in undzere oign.<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />dos iz der tog vos Hashem hot gemacht,</para>
  <para style="q" vid="PSA 118:24">lomir lustik zain un zich freyen in im.<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />ich bet dich, Hashem, helf antkegenkumen!</para>
  <para style="q" vid="PSA 118:25">ich bet dich, Hashem, baglik Nun!<verse eid="PSA 118:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />gebentsht der vos kumt in nomen fun Hashem!</para>
  <para style="q" vid="PSA 118:26">mir bentshn aich fun Hashems hoiz.<verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />Hashem iz El, un er hot undz derluchtn;</para>
  <para style="q" vid="PSA 118:27">flecht a tants mit tsvaign</para>
  <para style="q" vid="PSA 118:27">biz di herner fun mizbeyech.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />main G-t bistu, un ich vel dir danken;</para>
  <para style="q" vid="PSA 118:28">main G-t – vel ich dich derheibn.<verse eid="PSA 118:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />git a dank tsu Hashem, vorem er iz gut,</para>
  <para style="q" vid="PSA 118:29">vorem oif eibik iz zain chesed.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" pubnumber="קיט" sid="PSA 119" />
  <para style="qa">a</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />voil tsu di vos zeyer veg iz erlech,</para>
  <para style="q" vid="PSA 119:1">vos geyen in der toyre fun Hashem.<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />voil tsu di vos hitn zaine tseignim,</para>
  <para style="q" vid="PSA 119:2">vos zuchn im mitn gantsn hartsn,<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />un zei tuen nisht kein umrecht,</para>
  <para style="q" vid="PSA 119:3">zei geyen in zaine vegen.<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />host gebotn daine bafeln,</para>
  <para style="q" vid="PSA 119:4">zei optsuhiten zeyer.<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />halevay zoln fest zain maine vegen,</para>
  <para style="q" vid="PSA 119:5">tsu hitn daine gezetsn!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />dentsmol vel ich zich nisht shemen.</para>
  <para style="q" vid="PSA 119:6">ven ich kuk oif ale daine gebot.<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />ich vel dich loibn mit rechtfartikeit fun hartsn,</para>
  <para style="q" vid="PSA 119:7">ven ich lern daine gerechte mishpotim.<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />daine gezetsn vel ich hitn;</para>
  <para style="q" vid="PSA 119:8">zolst mich nisht farlozen biz gor.<verse eid="PSA 119:8" /></para>
  <para style="qa">Bais</para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />mit vos ken a yunger mentsh haltn rein zain veg?</para>
  <para style="q" vid="PSA 119:9">tsu zain opgehit loit dain vort.<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />mit main gantsn hartsn hob ich dich gezucht;</para>
  <para style="q" vid="PSA 119:10">loz mich nisht avekblondzhen fun daine gebot.<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />in main hartsn hob ich bahaltn dain vort,</para>
  <para style="q" vid="PSA 119:11">kedei ich zol nisht zindikn tsu dir.<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />geloibt bistu, Hashem;</para>
  <para style="q" vid="PSA 119:12">lern mich daine gezetsn.<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />mit maine lipn hob ich dertseilt</para>
  <para style="q" vid="PSA 119:13">ale mishpotim fun dain moil.<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />mit dem veg fun daine tseignim hob ich mich gefreit</para>
  <para style="q" vid="PSA 119:14">vi mit ale eshires.<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />ich tracht on daine bafeln,</para>
  <para style="q" vid="PSA 119:15">un ich kuk oif daine vegen.<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />mit daine gezetsn kvik ich mich,</para>
  <para style="q" vid="PSA 119:16">ich farges nisht dain vort.<verse eid="PSA 119:16" /></para>
  <para style="qa">g</para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />basher dain knecht, ich zol lebn,</para>
  <para style="q" vid="PSA 119:17">un ich vel hitn dain vort.<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />antplek maine oign, ich zol zen</para>
  <para style="q" vid="PSA 119:18">di vunder fun dain toyre.<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />a fremder bin ich oif der erd;</para>
  <para style="q" vid="PSA 119:19">nisht farborg fun mir daine gebot.<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />tsebrochn iz main zel fun glustenish</para>
  <para style="q" vid="PSA 119:20">noch daine mishpotim in yetveder tsait.<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />shraist on oif di farsholtene mutvilike,</para>
  <para style="q" vid="PSA 119:21">vos blondzhen avek fun daine gebot.<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />kaikl arop fun mir shand un bizoyn,</para>
  <para style="q" vid="PSA 119:22">vorem daine tseignim hob ich gehit.<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />hagam harn zitsn un redn kegen mir,</para>
  <para style="q" vid="PSA 119:23">tracht dain knecht on daine gezetsn,<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />yo, daine tseignim zainen main kvikung,</para>
  <para style="q" vid="PSA 119:24">di eitse-geber maine.<verse eid="PSA 119:24" /></para>
  <para style="qa">d</para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />baheft tsum shtoib iz main zel;</para>
  <para style="q" vid="PSA 119:25">leb mich oif loit dain vort.<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />ich hob dertseilt maine vegen,</para>
  <para style="q" vid="PSA 119:26">un du host mir geentfert.</para>
  <para style="q" vid="PSA 119:26">lern mich daine gezetsn.<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />dem veg fun daine bafeln mach mich farshtein,</para>
  <para style="q" vid="PSA 119:27">un ich vel redn fun daine vunder.<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />main zel trert fun kumer;</para>
  <para style="q" vid="PSA 119:28">richt mich oif loit dain vort.<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />dem veg fun lign tu op fun mir,</para>
  <para style="q" vid="PSA 119:29">un mit dain toyre laitzelik mich.<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />dem derech emune hob ich oisgeveilt,</para>
  <para style="q" vid="PSA 119:30">daine mishpotim hob ich gehaltn far mir.<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />ich bin baheft on daine tseignim;</para>
  <para style="q" vid="PSA 119:31">Hashem, zolst mich nisht farshemen.<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />in dem veg fun daine gebot tu ich loifn,</para>
  <para style="q" vid="PSA 119:32">vorem du derbreiterst main harts.<verse eid="PSA 119:32" /></para>
  <para style="qa">h</para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />lern mich, Hashem, dem veg fun daine gezetsn,</para>
  <para style="q" vid="PSA 119:33">un ich vel im hitn biz letst.<verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />mach mich farshtein, kedei ich zol hitn dain toyre,</para>
  <para style="q" vid="PSA 119:34">un zi haltn mitn gantsn hartsn.<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />fir mich in dem shteg fun daine gebot,</para>
  <para style="q" vid="PSA 119:35">vorem noch im hob ich gegart.<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />naig main harts tsu daine tseignim,</para>
  <para style="q" vid="PSA 119:36">un nisht tsu gaitsikeit.<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />nem avek maine oign fun kukn oif nishtikeit;</para>
  <para style="q" vid="PSA 119:37">in daine vegen leb mich oif.<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />zai mekayem tsu dain knecht dain tsuzog</para>
  <para style="q" vid="PSA 119:38">vos tsu daine forchter.<verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />tu op main shand vos ich shrek mich derfar,</para>
  <para style="q" vid="PSA 119:39">vorem daine mishpotim zainen gut.<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />ze, ich hob geshmacht noch daine bafeln;</para>
  <para style="q" vid="PSA 119:40">in dain gerechtikeit leb mich oif.<verse eid="PSA 119:40" /></para>
  <para style="qa">u</para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />un zoln kumen daine chasadim oif mir, Hashem,</para>
  <para style="q" vid="PSA 119:41">dain hilf loit dain tsuzog,<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />az ich zol kenen entfern main lesterer a vort;</para>
  <para style="q" vid="PSA 119:42">vorem ich hob mich farzichert oif dain vort.<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />un zolst nisht opraisn in gantsn</para>
  <para style="q" vid="PSA 119:43">fun main moil dos vort fun emes,</para>
  <para style="q" vid="PSA 119:43">vorem oif daine mishpotim hob ich gehart.<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />un ich vel tamid hitn dain toyre,</para>
  <para style="q" vid="PSA 119:44">oif eibik un shtendik.<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />un lomich umgein in derbreiternish</para>
  <para style="q" vid="PSA 119:45">vorem daine bafeln hob ich gezucht.<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />un ich vel redn fun daine tseignim far mlochim,</para>
  <para style="q" vid="PSA 119:46">un ich vel mich nisht shemen.<verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />un ich vel mich kvikn mit daine gebot</para>
  <para style="q" vid="PSA 119:47">vos ich hob lib.<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />un ich vel oifheibn maine hent tsu daine gebot</para>
  <para style="q" vid="PSA 119:48">vos ich hob lib,</para>
  <para style="q" vid="PSA 119:48">un ich vel trachtn on daine gezetsn.<verse eid="PSA 119:48" /></para>
  <para style="qa">z</para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />gedenk dos vort tsu dain knecht,</para>
  <para style="q" vid="PSA 119:49">vedlik du host mich gemacht hofn.<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />dos iz main treist in main pain,</para>
  <para style="q" vid="PSA 119:50">vos dain tsuzog lebt mich oif.<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />di mutvilike hobn geshpet fun mir zeyer –</para>
  <para style="q" vid="PSA 119:51">fun dain toyre hob ich zich nisht opgeneigt.<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />ich hob gedacht, Hashem, on daine mishpotim fun eibik on,</para>
  <para style="q" vid="PSA 119:52">un ich hob mich getreist.<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />a brenediker tsorn hot mich ongenumen,</para>
  <para style="q" vid="PSA 119:53">fun vegen di reshoim vos farlozen dain toyre.<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />gezangen zainen mir geven daine gezetsn</para>
  <para style="q" vid="PSA 119:54">in hoiz fun main farfremdtkeit.<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />ich hob dermont bai nacht dain nomen, Hashem,</para>
  <para style="q" vid="PSA 119:55">un ich hob gehit dain toyre.<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />dos hob ich gehat:</para>
  <para style="q" vid="PSA 119:56">vos ich hob gehaltn daine bafeln.<verse eid="PSA 119:56" /></para>
  <para style="qa">ch</para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />main teil, Hashem, hob ich gezogt,</para>
  <para style="q" vid="PSA 119:57">iz tsu hitn daine verter.<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />ich hob gebetn bai dir mitn gantsn hartsn:</para>
  <para style="q" vid="PSA 119:58">laitzelik mich loit dain tsuzog.<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />ich hob barechnt maine vegen,</para>
  <para style="q" vid="PSA 119:59">un gekert maine fis tsu daine tseignim.<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />ich hob zich geailt un nisht gezamt</para>
  <para style="q" vid="PSA 119:60">tsu hitn daine gebot.<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />di shtrik fun di reshoim hobn mich arumgeknipt –</para>
  <para style="q" vid="PSA 119:61">dain toyre hob ich nisht fargesen.<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />halbe nacht shtei ich oif dir tsu danken</para>
  <para style="q" vid="PSA 119:62">far daine gerechte mishpotim.<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />a chever bin ich tsu ale vos forchtn dich,</para>
  <para style="q" vid="PSA 119:63">un tsu di vos hitn daine bafeln.<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />dain chesed, Hashem, iz ful di erd;</para>
  <para style="q" vid="PSA 119:64">lern mich daine gezetsn.<verse eid="PSA 119:64" /></para>
  <para style="qa">t</para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />host geton guts mit dain knecht, Hashem,</para>
  <para style="q" vid="PSA 119:65">loit dain vort.<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />voilfarshtandikeit un visen lern mich,</para>
  <para style="q" vid="PSA 119:66">vorem ich gloib in daine gebot.<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />eider ich hob gelitn fleg ich farzen,</para>
  <para style="q" vid="PSA 119:67">ober atsund tu ich hitn dain vort.<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />a guter bistu un a bagitiker;</para>
  <para style="q" vid="PSA 119:68">lern mich daine gezetsn.<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />di mutvilike hobn ongeshmirt oif mir lign;</para>
  <para style="q" vid="PSA 119:69">ich hit mitn gantsn hartsn daine bafeln.<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />farshtopt vi fets iz zeyer harts;</para>
  <para style="q" vid="PSA 119:70">ich hob mich gekvikt mit dain toyre.<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />voil iz tsu mir vos ich bin gepainikt gevorn,</para>
  <para style="q" vid="PSA 119:71">kedei ich zol lernen daine gezetsn.<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />mir iz beser di toyre fun dain moil</para>
  <para style="q" vid="PSA 119:72">eider toizntn gold un zilber.<verse eid="PSA 119:72" /></para>
  <para style="qa">i</para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />daine hent hobn mich geshafn un mich gefuremt;</para>
  <para style="q" vid="PSA 119:73">mach mich farshtein, kedei ich zol lernen daine gebot.<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />daine forchter veln mich zen un zich freyen,</para>
  <para style="q" vid="PSA 119:74">vorem oif dain vort hob ich gehart.<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />ich veis, Hashem, az gerecht zainen daine mishpotim,</para>
  <para style="q" vid="PSA 119:75">un ois traishaft hostu mich gepainikt.<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />zol zain, ich bet dich, dain chesed mich tsu treistn,</para>
  <para style="q" vid="PSA 119:76">azoi vi dain tsuzog tsu dain knecht.<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />zol kumen oif mir dain derbaremung, kedei ich zol lebn,</para>
  <para style="q" vid="PSA 119:77">vorem dain toyre iz main kvikung.<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />zoln farshemt vern di mutvilike,</para>
  <para style="q" vid="PSA 119:78">vail zei hobn mich gekrivdet umnisht;</para>
  <para style="q" vid="PSA 119:78">ich vel trachtn on daine bafeln.<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />zoln zich kern tsu mir di vos forchtn dich,</para>
  <para style="q" vid="PSA 119:79">un di vos veisn daine tseignim.<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />zol main harts zain gants in daine gezetsn,</para>
  <para style="q" vid="PSA 119:80">kedei ich zol nisht farshemt vern.<verse eid="PSA 119:80" /></para>
  <para style="qa">ch</para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />main zel geit ois noch dain hilf,</para>
  <para style="q" vid="PSA 119:81">oif dain vort tu ich harn.<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />maine oign geyen ois noch dain tsuzog,</para>
  <para style="q" vid="PSA 119:82">azoi tsu zogn: ven vestu mich treistn?<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />hagam ich bin gevorn vi a logl in roich,</para>
  <para style="q" vid="PSA 119:83">hob ich daine gezetsn nisht fargesen.<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />vi fil zainen di teg fun dain knecht?</para>
  <para style="q" vid="PSA 119:84">ven vestu a mishpot ton oif maine nochyoger?<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />di mutvilike hobn mir gegrobn griber,</para>
  <para style="q" vid="PSA 119:85">vos iz nisht loit dain toyre.<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />ale daine gebot zainen vorhaftik;</para>
  <para style="q" vid="PSA 119:86">umnisht hobn zei mich geroideft; helf mich.<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />zei hobn mich shir farlendt oif der erd,</para>
  <para style="q" vid="PSA 119:87">ober ich hob nisht farlozen daine bafeln.<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />leb mich oif loit dain chesed,</para>
  <para style="q" vid="PSA 119:88">un ich vel hitn dem tseignim fun dain moil.<verse eid="PSA 119:88" /></para>
  <para style="qa">l</para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89" />oif eibik, Hashem,</para>
  <para style="q" vid="PSA 119:89">bashteit dain vort in himel.<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />oif dor-doires iz dain traishaft;</para>
  <para style="q" vid="PSA 119:90">host bafestikt di erd, un zi shteit.<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />loit daine gezetsn shteyen zei haint,</para>
  <para style="q" vid="PSA 119:91">vorem ale zachn zainen daine knecht.<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />ven nisht dain toyre iz main kvikung,</para>
  <para style="q" vid="PSA 119:92">volt ich untergegangen in main pain.<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />ich vel eibik nisht fargesen daine bafeln,</para>
  <para style="q" vid="PSA 119:93">vorem mit zei hostu mich oifgelebt.<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />dainer bin ich, helf mich,</para>
  <para style="q" vid="PSA 119:94">vorem daine bafeln hob ich geforsht.<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />di reshoim hobn oisgekukt oif mir, mich untertsubrengen;</para>
  <para style="q" vid="PSA 119:95">ich klig mich in daine tseignim.<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />tsu yetveder shtrebung hob ich gezen an end –</para>
  <para style="q" vid="PSA 119:96">daine gebot zainen breit biz gor.<verse eid="PSA 119:96" /></para>
  <para style="qa">m</para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />vi lib ich hob dain toyre!</para>
  <para style="q" vid="PSA 119:97">a gantsn tog iz zi main trachtung.<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />kliger fun maine faint machn mich daine gebot,</para>
  <para style="q" vid="PSA 119:98">vorem zei zainen eibik bai mir.<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />fun ale maine lerer bin ich farshtandiker,</para>
  <para style="q" vid="PSA 119:99">vorem daine tseignim zainen main trachtung.<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />mer fun zkeinim farshtei ich,</para>
  <para style="q" vid="PSA 119:100">vail daine bafeln hob ich gehaltn.<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />fun yetveder beizn veg farmaid ich maine fis,</para>
  <para style="q" vid="PSA 119:101">kedei ich zol hitn dain vort.<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />fun daine gezetsn hob ich nisht opgekert,</para>
  <para style="q" vid="PSA 119:102">vorem du host mich gelernt.<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />vi zis zainen daine verter tsu main gumen,</para>
  <para style="q" vid="PSA 119:103">mer fun honik far main moil!<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />fun daine bafeln ver ich farshtandik,</para>
  <para style="q" vid="PSA 119:104">derum hob ich faint yetveder veg fun lign.<verse eid="PSA 119:104" /></para>
  <para style="qa">n</para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />a licht far main fus iz dain vort,</para>
  <para style="q" vid="PSA 119:105">un a lichtikeit far main shteg.<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />ich hob geshvorn, un hob mekayem geven,</para>
  <para style="q" vid="PSA 119:106">tsu hitn daine gerechte mishpotim.<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />ich bin gedrikt biz gor,</para>
  <para style="q" vid="PSA 119:107">Hashem, leb mich oif loit dain vort.<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />di fraigobn fun main moil bavilik, ich bet dich, Hashem,</para>
  <para style="q" vid="PSA 119:108">un daine mishpotim lern mich.<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />main nefesh iz tamid in main hant,</para>
  <para style="q" vid="PSA 119:109">ober dain toyre hob ich nisht fargesen.<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />di reshoim hobn mir a pastke geshtelt,</para>
  <para style="q" vid="PSA 119:110">ober fun daine bafeln hob ich nisht avekgeblondzhet.<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />ich hob gemacht daine tseignim far main eibiker arav,</para>
  <para style="q" vid="PSA 119:111">vorem zei zainen di freid fun main hartsn.<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />ich hob geneigt main harts tsu ton daine gezetsn</para>
  <para style="q" vid="PSA 119:112">tmid biz letst.<verse eid="PSA 119:112" /></para>
  <para style="qa">s</para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />tsveifler hob ich faint,</para>
  <para style="q" vid="PSA 119:113">nor dain toyre hob ich lib.<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />main farborgenish un main shild bistu,</para>
  <para style="q" vid="PSA 119:114">oif dain vort tu ich harn.<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />kert aich op fun mir, ir shlechtstuer,</para>
  <para style="q" vid="PSA 119:115">kedei ich zol hitn di gebot fun main G-t.<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />halt mich oif loit dain tsuzog, kedei ich zol lebn,</para>
  <para style="q" vid="PSA 119:116">un loz mich nisht farshemt vern in main hofenung.<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />len mich unter, un lomich geholfn vern,</para>
  <para style="q" vid="PSA 119:117">un ich vel mich tamid farnemen mit daine gezetsn.<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />farachtst ale vos blondzhen avek fun daine gezetsn,</para>
  <para style="q" vid="PSA 119:118">vorem umzist iz zeyer opnarenish.<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />vi psoles shafstu op ale reshoim fun der erd,</para>
  <para style="q" vid="PSA 119:119">derum hob ich lib daine tseignim.<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />main laib shoidert fun angst far dir,</para>
  <para style="q" vid="PSA 119:120">un far daine mishpotim hob ich moire.<verse eid="PSA 119:120" /></para>
  <para style="qa">e</para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />ich hob geton recht un gerechtikeit;</para>
  <para style="q" vid="PSA 119:121">zolst mich nisht iberlozen tsu maine driker.<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />shtel zich ain far dain knecht tsum gutn,</para>
  <para style="q" vid="PSA 119:122">az mich zoln nisht drikn di mutvilike.<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />maine oign geyen ois noch dain hilf,</para>
  <para style="q" vid="PSA 119:123">un noch dem vort fun dain gerechtikeit.<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />tu mit dain knecht loit dain chesed,</para>
  <para style="q" vid="PSA 119:124">un daine gezetsn lern mich.<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />dain knecht bin ich; mach mich farshtein,</para>
  <para style="q" vid="PSA 119:125">kedei ich zol visen daine tseignim.<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />es iz tsait far Hashem tsu ton;</para>
  <para style="q" vid="PSA 119:126">zei hobn farshtert dain toyre.<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />far vor, ich hob lib daine gebot,</para>
  <para style="q" vid="PSA 119:127">mer fun gold un fun gingold.<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />derum halt ich far richtik ale kolerlei bafeln;</para>
  <para style="q" vid="PSA 119:128">yetveder veg fun lign hob ich faint.<verse eid="PSA 119:128" /></para>
  <para style="qa">f</para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />vunderlech zainen daine tseignim,</para>
  <para style="q" vid="PSA 119:129">derum hit zei main zel.<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />di antplekung fun daine verter macht lichtik,</para>
  <para style="q" vid="PSA 119:130">zi macht farshtandik dem narn.<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />ich hob oifgeshpart main moil un gelechtst,</para>
  <para style="q" vid="PSA 119:131">vorem noch daine gebot hob ich gegart.<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />ker zich tsu mir, un laitzelik mich,</para>
  <para style="q" vid="PSA 119:132">vi es iz recht tsu di vos hobn lib dain nomen.<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />festik maine trit mit dain vort,</para>
  <para style="q" vid="PSA 119:133">un loz nisht geveltikn iber mir kein umrecht.<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />leiz mich ois fun der drikung fun mentshn,</para>
  <para style="q" vid="PSA 119:134">kedei ich zol hitn daine bafeln.<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />derlaicht dain ponem oif dain knecht,</para>
  <para style="q" vid="PSA 119:135">un lern mich daine gezetsn.<verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />bechn vaser hobn fargosen maine oign,</para>
  <para style="q" vid="PSA 119:136">iber di vos hobn nisht gehit dain toyre.<verse eid="PSA 119:136" /></para>
  <para style="qa">ts</para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />gerecht bistu, Hashem,</para>
  <para style="q" vid="PSA 119:137">un rechtfartik zainen daine mishpotim.<verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />host bafoiln mit gerechtikeit daine tseignim,</para>
  <para style="q" vid="PSA 119:138">un mit getraishaft biz gor.<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />mich hot umgebracht main ergernish</para>
  <para style="q" vid="PSA 119:139">vail maine faint hobn fargesen daine verter.<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />gelaitert iz dain vort biz gor,</para>
  <para style="q" vid="PSA 119:140">un dain knecht hot es lib.<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />klein bin ich un faracht –</para>
  <para style="q" vid="PSA 119:141">daine bafeln hob ich nisht fargesen.<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />dain gerechtikeit iz eibik gerecht,</para>
  <para style="q" vid="PSA 119:142">un dain toyre iz emes.<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />noit un angst hobn mich getrofn –</para>
  <para style="q" vid="PSA 119:143">daine gebot zainen maine kvikungen.<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />gerecht zainen daine tseignim oif eibik;</para>
  <para style="q" vid="PSA 119:144">mach mich farshtein, kedei ich zol lebn.<verse eid="PSA 119:144" /></para>
  <para style="qa">k</para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />ich hob gerufn mitn gantsn hartsn;</para>
  <para style="q" vid="PSA 119:145">entfer mir, Hashem; daine gezetsn vel ich haltn.<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />ich ruf dich, helf mich,</para>
  <para style="q" vid="PSA 119:146">un ich vel hitn daine tseignim.<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />ich hob mich gefedert baginen un geshrien;</para>
  <para style="q" vid="PSA 119:147">oif dain vort hob ich gehart.<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />maine oign zainen faroisgelofn di nachtvachn,</para>
  <para style="q" vid="PSA 119:148">tsu trachtn on dain vort.<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />her tsu main kol loit dain chesed,</para>
  <para style="q" vid="PSA 119:149">Hashem, leb mich oif azoi vi dain shteiger.<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />es genenen di vos yogn zich noch shendlechkeit;</para>
  <para style="q" vid="PSA 119:150">fun dain toyre zainen zei vait.<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />du bist nont, Hashem,</para>
  <para style="q" vid="PSA 119:151">un ale daine gebot zainen emes.<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />fun lang on hob ich gevust fun daine tseignim,</para>
  <para style="q" vid="PSA 119:152">az du host zei oif eibik gegruntfest.<verse eid="PSA 119:152" /></para>
  <para style="qa">r</para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />ze main pain, un derleiz mich,</para>
  <para style="q" vid="PSA 119:153">vorem dain toyre hob ich nisht fargesen.<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />krig main krig, un leiz mich ois,</para>
  <para style="q" vid="PSA 119:154">loit dain tsuzog leb mich oif.<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />vait iz fun reshoim hilf,</para>
  <para style="q" vid="PSA 119:155">vail daine gezetsn zuchn zei nisht.<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />dain derbaremung iz grois, Hashem;</para>
  <para style="q" vid="PSA 119:156">leb mich oif azoi vi dain gezetsn.<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />fil zainen maine nochyoger un maine driker –</para>
  <para style="q" vid="PSA 119:157">fun daine tseignim hob ich zich nisht opgeneigt.<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />ich hob gezen di felsher un ich hob gehat an ekl tsu zei,</para>
  <para style="q" vid="PSA 119:158">vos hobn dain vort nisht gehit.<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />ze az daine bafeln hob ich lib;</para>
  <para style="q" vid="PSA 119:159">Hashem, leb mich oif loit dain chesed.<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />der iker fun dain vort iz emes,</para>
  <para style="q" vid="PSA 119:160">un oif eibik iz al dain gerechter mishpot.<verse eid="PSA 119:160" /></para>
  <para style="qa">sh</para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />harn hobn mich geroideft far umzist,</para>
  <para style="q" vid="PSA 119:161">ober far daine verter hot geangst main harts.<verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />ich frei zich iber dain vort,</para>
  <para style="q" vid="PSA 119:162">vi einer vos gefint a sach roib.<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />lign hob ich faint un farumverdik,</para>
  <para style="q" vid="PSA 119:163">dain toyre hob ich lib.<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />zibn mol a tog loib ich dich</para>
  <para style="q" vid="PSA 119:164">far daine gerechte mishpotim.<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />grois frid iz far di libhober fun dain toyre,</para>
  <para style="q" vid="PSA 119:165">un nishto far zei kein shtroichlung.<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />ich hob oisgekukt oif dain hilf, Hashem,</para>
  <para style="q" vid="PSA 119:166">un daine gebot hob ich geton.<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />main zel hot gehit daine tseignim,</para>
  <para style="q" vid="PSA 119:167">un ich hob zei lib zeyer.<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />ich hob gehit daine bafeln un daine tseignim,</para>
  <para style="q" vid="PSA 119:168">vorem ale maine vegen zainen far dir.<verse eid="PSA 119:168" /></para>
  <para style="qa">t</para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />zol genenen main geshrei far dir, Hashem;</para>
  <para style="q" vid="PSA 119:169">mach mich farshtein, loit dain vort.<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />zol kumen main gebet far dir;</para>
  <para style="q" vid="PSA 119:170">zai mich matsl loit dain tsuzog.<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />maine lipn veln shtromen mit loib,</para>
  <para style="q" vid="PSA 119:171">az du vest mich lernen daine gezetsn.<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />main tsung vet zingen dain vort,</para>
  <para style="q" vid="PSA 119:172">vorem ale daine gebot zainen gerechtikeit.<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />zol dain hant zain mir tsu hilf,</para>
  <para style="q" vid="PSA 119:173">vorem daine bafeln hob ich oisderveilt.<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />ich hob geshmacht noch dain yeshue, Hashem,</para>
  <para style="q" vid="PSA 119:174">un dain toyre iz main kvikung.<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />zol lebn main zel, un dich loibn,</para>
  <para style="q" vid="PSA 119:175">un zoln daine mishpotim mich helfn.<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />ich hob geblondzhet vi a farlorene shof;</para>
  <para style="q" vid="PSA 119:176">zuch oif dain knecht, vorem daine gebot hob ich nisht fargesen.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" pubnumber="קכ" sid="PSA 120" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 120:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 120:1">
    <char style="va">1</char> in main noit hob ich gerufn tsu Hashem,</para>
  <para style="q" vid="PSA 120:1">un er hot mir geentfert.<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />Hashem, zai matsl main zel fun der lip fun lign,</para>
  <para style="q" vid="PSA 120:2">fun der tsung fun batrug.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />vos vet men dir gebn, un vos vet men dir tsuleigen,</para>
  <para style="q" vid="PSA 120:3">du tsung fun batrug?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />sharfe gibor-failn,</para>
  <para style="q" vid="PSA 120:4">mit koiln fun bezembeimlech.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />vei mir, vos ich halt zich oif in Meshech,</para>
  <para style="q" vid="PSA 120:5">vos ich voin bai di getseltn fun Kedar.<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />lang hot zich ongevoint main zel</para>
  <para style="q" vid="PSA 120:6">bai dem soine fun sholem.<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />ich bin loiter sholem,</para>
  <para style="q" vid="PSA 120:7">ober az ich red, zainen zei far milchome.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" pubnumber="קכא" sid="PSA 121" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 121:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 121:1">
    <char style="va">1</char> ich heib oif maine oign tsu di berg:</para>
  <para style="q" vid="PSA 121:1">fun vanen vet kumen main hilf?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />main hilf iz fun Hashem,</para>
  <para style="q" vid="PSA 121:2">dem Bashefer fun himel un erd.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />nisht lozn vet er zich oisglitshn dain fus;</para>
  <para style="q" vid="PSA 121:3">nisht shlumern vet dain hiter.<verse eid="PSA 121:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />ze, es shlumert nisht un shloft nisht</para>
  <para style="q" vid="PSA 121:4">der hiter fun Yisroel.<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />Hashem iz dain hiter,</para>
  <para style="q" vid="PSA 121:5">Hashem iz dain shotn bai dain rechter hant;<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />bai tog vet di zun dich nisht shlogn,</para>
  <para style="q" vid="PSA 121:6">un nisht bai nacht di levone.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />Hashem vet dich bahitn fun alem beiz,</para>
  <para style="q" vid="PSA 121:7">er vet bahitn dain zel.<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />Hashem vet hitn dain gein un dain kumen,</para>
  <para style="q" vid="PSA 121:8">fun atsund un biz eibik.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" pubnumber="קכב" sid="PSA 122" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 122:1" />a gezang fun di aroifgangen; fun Dovidn.</para>
  <para style="q" vid="PSA 122:1">
    <char style="va">1</char> ich frei zich az me zogt mir:</para>
  <para style="q" vid="PSA 122:1">lomir gein in hoiz fun Hashem.<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />undzere fis shteyen</para>
  <para style="q" vid="PSA 122:2">in daine toiern, Yerushalayim.<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />Yerushalayim vos iz oifgeboit vi a shtot</para>
  <para style="q" vid="PSA 122:3">vos iz zich baheft in einem;<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />vos ahin geyen aroif di shvotim,</para>
  <para style="q" vid="PSA 122:4">di shvotim fun Hashem,</para>
  <para style="q" vid="PSA 122:4">far an tseignim tsu Yisroel,</para>
  <para style="q" vid="PSA 122:4">tsu danken dem nomen fun Hashem.<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />vorem dortn shteyen tronen fun mishpot,</para>
  <para style="q" vid="PSA 122:5">di tronen fun Dovids hoiz.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />bet far dem sholem fun Yerushalayim;</para>
  <para style="q" vid="PSA 122:6">zoln in shalve zain ale daine libhober.<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />zol zain sholem in dain moier,</para>
  <para style="q" vid="PSA 122:7">shalve in daine palatsn.<verse eid="PSA 122:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />fun vegen maine brider un maine chaverim</para>
  <para style="q" vid="PSA 122:8">lomich zogn: sholem in dir!<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />fun vegen dem hoiz fun Hashem Elokeinu</para>
  <para style="q" vid="PSA 122:9">vintsh ich dir guts.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" pubnumber="קכג" sid="PSA 123" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 123:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 123:1">
    <char style="va">1</char> tsu dir heib ich oif maine oign,</para>
  <para style="q" vid="PSA 123:1">du vos tronst in di himlen.<verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />ze, vi di oign fun knecht tsu der hant fun zeyer har,</para>
  <para style="q" vid="PSA 123:2">vi di oign fun a dinst tsu der hant fun ir harinte,</para>
  <para style="q" vid="PSA 123:2">azoi zainen undzere oign tsu Hashem Elokeinu,</para>
  <para style="q" vid="PSA 123:2">biz er vet undz laitzelikn.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />laitzelik undz, Hashem, laitzelik undz,</para>
  <para style="q" vid="PSA 123:3">vorem iberzat zainen mir mit farachtung.<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />iberzat iz undzer zel</para>
  <para style="q" vid="PSA 123:4">mit dem geshpet fun di ruike,</para>
  <para style="q" vid="PSA 123:4">mit der farachtung fun di hoferdike driker.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" pubnumber="קכד" sid="PSA 124" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 124:1" />a gezang fun di aroifgangen; fun Dovidn.</para>
  <para style="q" vid="PSA 124:1">
    <char style="va">1</char> ven nisht Hashem vos iz geven mit undz –</para>
  <para style="q" vid="PSA 124:1">zol Nun zogn Yisroel –<verse eid="PSA 124:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />ven nisht Hashem vos iz geven mit undz,</para>
  <para style="q" vid="PSA 124:2">beeis mentshn zainen oifgeshtanen oif undz,<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />dentsmol voltn zei undz lebedikerheit aingeshlungen,</para>
  <para style="q" vid="PSA 124:3">ven zeyer tsorn hot gegrimt oif undz;<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />dentsmol voltn undz di vasern farfleitst,</para>
  <para style="q" vid="PSA 124:4">der taich volt aribergegangen iber undzer zel;<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />dentsmol voltn ariber iber undzer zel</para>
  <para style="q" vid="PSA 124:5">di mutvilike vasern.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />Baruch Hashem,</para>
  <para style="q" vid="PSA 124:6">vos er hot undz nisht gegebn</para>
  <para style="q" vid="PSA 124:6">far roib tsu zeyere tsein.<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />undzer zel iz antrunen gevorn vi a foigel</para>
  <para style="q" vid="PSA 124:7">fun di fangers pastke;</para>
  <para style="q" vid="PSA 124:7">di pastke iz tsebrochn gevorn,</para>
  <para style="q" vid="PSA 124:7">un mir zainen antrunen gevorn.<verse eid="PSA 124:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />undzer hilf iz in nomen fun Hashem,</para>
  <para style="q" vid="PSA 124:8">dem Bashefer fun himel un erd.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" pubnumber="קכה" sid="PSA 125" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 125:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 125:1">
    <char style="va">1</char> di vos farzichern zich oif Hashem</para>
  <para style="q" vid="PSA 125:1">zainen azoi vi barg Tsiyon, vos rirt zich nisht;</para>
  <para style="q" vid="PSA 125:1">eibik farblaibt er.<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />Yerushalayim – arum ir zainen berg,</para>
  <para style="q" vid="PSA 125:2">un Hashem iz arum zain folk,</para>
  <para style="q" vid="PSA 125:2">fun atsund un biz eibik.<verse eid="PSA 125:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />vorem der shtekn fun shlechtikeit vet nisht ruen</para>
  <para style="q" vid="PSA 125:3">oif dem goirl fun di gerechte,</para>
  <para style="q" vid="PSA 125:3">kedei di gerechte zoln nisht oisshtekn</para>
  <para style="q" vid="PSA 125:3">in umgerechtikeit zeyere hent.<verse eid="PSA 125:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />bagitik, Hashem, di gute,</para>
  <para style="q" vid="PSA 125:4">un di vos zainen rechtfartik in zeyere hertser.<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />ober di vos naign zich oif zeyere krume vegen,</para>
  <para style="q" vid="PSA 125:5">zei vet Hashem avekfiren mit di tuer fun umrecht.</para>
  <para style="q" vid="PSA 125:5">sholem oif Yisroel!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" pubnumber="קכו" sid="PSA 126" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 126:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 126:1">
    <char style="va">1</char> az Hashem hot umgekert di umkerung fun Tsiyon,</para>
  <para style="q" vid="PSA 126:1">zainen mir geven vi in cholem.<verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />dentsmol iz ful gevorn undzer moil mit gelechter,</para>
  <para style="q" vid="PSA 126:2">un undzer tsung mit gezang;</para>
  <para style="q" vid="PSA 126:2">dentsmol hot men gezogt tsvishn di felker:</para>
  <para style="q" vid="PSA 126:2">grois geton hot Hashem mit di dozike.<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />grois geton hot Hashem mit undz,</para>
  <para style="q" vid="PSA 126:3">mir zainen derfreit gevorn.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />breng tsurik, Hashem, undzer gefangenshaft,</para>
  <para style="q" vid="PSA 126:4">vi shtromen in trukenem land.<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />di vos zeyen mit trern,</para>
  <para style="q" vid="PSA 126:5">zoln shnaidn mit gezang.<verse eid="PSA 126:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />gein geit un veint</para>
  <para style="q" vid="PSA 126:6">der vos trogt dem oisshit fun zerie,</para>
  <para style="q" vid="PSA 126:6">ober kumen zol kumen mit gezang</para>
  <para style="q" vid="PSA 126:6">der vos trogt zaine garbn.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" pubnumber="קכז" sid="PSA 127" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 127:1" />a gezang fun di aroifgangen; fun Shlomoen.</para>
  <para style="q" vid="PSA 127:1">
    <char style="va">1</char> az Hashem boit nisht a hoiz,</para>
  <para style="q" vid="PSA 127:1">umzist mien zich zaine boiers oif im;</para>
  <para style="q" vid="PSA 127:1">az Hashem hit nisht a shtot,</para>
  <para style="q" vid="PSA 127:1">umzist vacht der shoimer.<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />umzist aich, ir vos federt aich oiftsushtein,</para>
  <para style="q" vid="PSA 127:2">vos zitst-oif shpet,</para>
  <para style="q" vid="PSA 127:2">vos est broit mit maternish;</para>
  <para style="q" vid="PSA 127:2">azoi vos git er zain balibtn in shlof.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />ze, di arav fun Hashem zainen kinder,</para>
  <para style="q" vid="PSA 127:3">der socher iz frucht fun laib.<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />vi failn in der hant fun gibor,</para>
  <para style="q" vid="PSA 127:4">azoi zainen kinder fun der yugnt.<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />voil tsu dem man</para>
  <para style="q" vid="PSA 127:5">vos hot ongefilt zain failbaitl mit zei!</para>
  <para style="q" vid="PSA 127:5">zei veln nisht farshemt vern,</para>
  <para style="q" vid="PSA 127:5">az zei veln redn mit di faint in toier.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" pubnumber="קכח" sid="PSA 128" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 128:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 128:1">
    <char style="va">1</char> voil tsu itlechn vos forcht Hashem,</para>
  <para style="q" vid="PSA 128:1">vos geit in zaine vegen.<verse eid="PSA 128:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />di mi fun daine hent az du est,</para>
  <para style="q" vid="PSA 128:2">voil iz tsu dir, un gut iz tsu dir.<verse eid="PSA 128:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />dain vaib vi a fruchtiker vainshtok,</para>
  <para style="q" vid="PSA 128:3">in di vinklen fun dain hoiz;</para>
  <para style="q" vid="PSA 128:3">daine kinder vi eilbertflantsn,</para>
  <para style="q" vid="PSA 128:3">rund arum dain tish.<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />yo, ot azoi vert gebentsht</para>
  <para style="q" vid="PSA 128:4">der man vos forcht Hashem.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />Hashem zol dich bentshn fun Tsiyon,</para>
  <para style="q" vid="PSA 128:5">un ze dos guts fun Yerushalayim</para>
  <para style="q" vid="PSA 128:5">ale teg fun dain lebn;<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />un ze kinder bai daine kinder.</para>
  <para style="q" vid="PSA 128:6">sholem oif Yisroel!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" pubnumber="קכט" sid="PSA 129" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 129:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 129:1">
    <char style="va">1</char> fil hobn zei mich gedrikt fun main yugnt –</para>
  <para style="q" vid="PSA 129:1">zol Nun zogn Yisroel –<verse eid="PSA 129:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />fil hobn zei mich gedrikt fun main yugnt,</para>
  <para style="q" vid="PSA 129:2">un hobn mich nisht baigekumen.<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />oif main rukn hobn akerer geakert,</para>
  <para style="q" vid="PSA 129:3">zei hobn lang gemacht zeyere beitn.<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />Hashem der gerechter</para>
  <para style="q" vid="PSA 129:4">hot durchgehakt di shtrik fun di reshoim.<verse eid="PSA 129:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />zich shemen un optretn ahinter</para>
  <para style="q" vid="PSA 129:5">veln ale sonem fun Tsiyon.<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />zei veln zain vi groz fun decher,</para>
  <para style="q" vid="PSA 129:6">vos eider es iz arois, iz es fartriknt;<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />vos der shniter filt nisht dermit zain hant,</para>
  <para style="q" vid="PSA 129:7">un der garbnbinder zain buzem;<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />un di farbaigeyer zogn nisht:</para>
  <para style="q" vid="PSA 129:8">G-ts broche oif aich!</para>
  <para style="q" vid="PSA 129:8">mir bentshn aich in nomen fun Hashem.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" pubnumber="קל" sid="PSA 130" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 130:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 130:1">
    <char style="va">1</char> fun di tifenishn ruf ich dich, Hashem.<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />Adonoi, her tsu main kol;</para>
  <para style="q" vid="PSA 130:2">zoln daine oiern zain farnemik</para>
  <para style="q" vid="PSA 130:2">tsu dem kol fun maine gebetn.<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />az du, Hashem, zolst achten oif zind,</para>
  <para style="q" vid="PSA 130:3">ver, Adonoi, ken bashtein?<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />vorem bai dir iz fargebung,</para>
  <para style="q" vid="PSA 130:4">derum verstu geforcht.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />ich hob gehoft oif Hashem,</para>
  <para style="q" vid="PSA 130:5">gehoft hot main zel,</para>
  <para style="q" vid="PSA 130:5">un oif zain vort hob ich gehart.<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />main nefesh kukt ois oif Adonoi</para>
  <para style="q" vid="PSA 130:6">mer vi vechter oif frimorgn,</para>
  <para style="q" vid="PSA 130:6">vechter oifn frimorgn.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />o ysrl hof oif Hashem,</para>
  <para style="q" vid="PSA 130:7">vorem bai Hashem iz genod,</para>
  <para style="q" vid="PSA 130:7">un bai im iz grois oisleizung.<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />un er vet oisleizen Yisroel</para>
  <para style="q" vid="PSA 130:8">fun ale zaine zind.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" pubnumber="קלא" sid="PSA 131" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 131:1" />a gezang fun di aroifgangen; fun Dovidn.</para>
  <para style="q" vid="PSA 131:1">
    <char style="va">1</char> Hashem, nisht hoferdik iz main harts,</para>
  <para style="q" vid="PSA 131:1">un nisht derhoibn zainen maine oign,</para>
  <para style="q" vid="PSA 131:1">un ich bin nisht umgegangen mit zachn</para>
  <para style="q" vid="PSA 131:1">tsu grois un farhoiln fun mir.<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />far vor, ich hob barut un aingeshtilt main zel</para>
  <para style="q" vid="PSA 131:2">azoi vi an antvointer bai zain muter;</para>
  <para style="q" vid="PSA 131:2">azoi vi an antvointer iz bai mir main zel.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />har, Yisroel, oif Hashem</para>
  <para style="q" vid="PSA 131:3">fun atsund un biz eibik.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" pubnumber="קלב" sid="PSA 132" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 132:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 132:1">
    <char style="va">1</char> gedenk, Hashem, Dovidn al zain plogn zich.<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />vi er hot geshvorn tsu Hashem,</para>
  <para style="q" vid="PSA 132:2">a neyder geton tsum machtikn fun Yaakov:<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />oib ich vel kumen in getselt fun main hoiz,</para>
  <para style="q" vid="PSA 132:3">oib ich vel aroif oif dem bet fun main geleger,<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />oib ich vel gebn shlof tsu maine oign,</para>
  <para style="q" vid="PSA 132:4">tsu maine bremen shlumer,<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />biz ich vel gefinen an ort far Hashem,</para>
  <para style="q" vid="PSA 132:5">a voinung far dem machtikn fun Yaakov!<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />ze, mir hobn gehert az es iz in Efratah,</para>
  <para style="q" vid="PSA 132:6">mir hobn es gefunen in feld fun Yaar.<verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />lomir kumen tsu zain voinung,</para>
  <para style="q" vid="PSA 132:7">lomir zich bukn tsu zain fusbenkel.<verse eid="PSA 132:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />shtei oif, Hashem, tsu dain ru,</para>
  <para style="q" vid="PSA 132:8">du un der orn fun dain shtarkeit.<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />daine koyanim zoln zich onkleidn in gerechtikeit,</para>
  <para style="q" vid="PSA 132:9">un daine frume zoln zingen.<verse eid="PSA 132:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />fun vegen Dovidn dain knecht,</para>
  <para style="q" vid="PSA 132:10">zolst nisht opshtoisn dem ponem fun dain gezalbtn.<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />Hashem hot emes geshvorn tsu Dovidn,</para>
  <para style="q" vid="PSA 132:11">er vet zich nisht opkeren derfun:</para>
  <para style="q" vid="PSA 132:11">fun der frucht fun dain laib</para>
  <para style="q" vid="PSA 132:11">vel ich zetsn oif dain tron.<verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />oib daine zin veln hitn main bris,</para>
  <para style="q" vid="PSA 132:12">un main tseignim vos ich vel zei lernen,</para>
  <para style="q" vid="PSA 132:12">veln oich zeyere zin biz eibik zitsn oif dain tron.<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />vorem Hashem hot oisderveilt Tsiyon,</para>
  <para style="q" vid="PSA 132:13">zi geglust far zain voinung:<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />dos iz main ruung biz eibik,</para>
  <para style="q" vid="PSA 132:14">do vel ich zitsn, vail ich glust zi.<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />bentshn vel ich bentshn ir shpaiz,</para>
  <para style="q" vid="PSA 132:15">ire baderftike vel ich zetn mit broit.<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />un ire koyanim vel ich onkleidn in hilf,</para>
  <para style="q" vid="PSA 132:16">un zingen veln zingen ire frume.<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />dortn vel ich machn shprotsn a horn far Dovidn,</para>
  <para style="q" vid="PSA 132:17">ich hob ongebreit a licht far main gezalbtn.<verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />zaine faint vel ich onkleidn in shand,</para>
  <para style="q" vid="PSA 132:18">un oif im vet shainen zain kroin.<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" pubnumber="קלג" sid="PSA 133" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 133:1" />a gezang fun di aroifgangen; fun Dovidn</para>
  <para style="q" vid="PSA 133:1">
    <char style="va">1</char> ze, vi gut un vi lib</para>
  <para style="q" vid="PSA 133:1">iz dos zitsn fun brider bainand.<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />azoi vi taier eil oifn kop,</para>
  <para style="q" vid="PSA 133:2">vos nidert arop oif der bord –</para>
  <para style="q" vid="PSA 133:2">oif der bord fun Aharonen,</para>
  <para style="q" vid="PSA 133:2">vos nidert oifn kolner fun zaine kleider;<verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />azoi vi der Chermon-toi vos nidert</para>
  <para style="q" vid="PSA 133:3">oif di berg fun Tsiyon;</para>
  <para style="q" vid="PSA 133:3">vorem dortn hot Hashem bafoiln a broche,</para>
  <para style="q" vid="PSA 133:3">lebn biz eibik.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" pubnumber="קלד" sid="PSA 134" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 134:1" />a gezang fun di aroifgangen.</para>
  <para style="q" vid="PSA 134:1">
    <char style="va">1</char> far vor, bentsht Hashem, ale knecht fun Hashem,</para>
  <para style="q" vid="PSA 134:1">vos shteit in Hashems hoiz in di necht.<verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />heibt oif aiere hent tsum heiliktum,</para>
  <para style="q" vid="PSA 134:2">un bentsht Hashem.<verse eid="PSA 134:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />bentshn zol dich fun Tsiyon Hashem,</para>
  <para style="q" vid="PSA 134:3">der Bashefer fun himel un erd.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" pubnumber="קלה" sid="PSA 135" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 135:1">
    <char style="va">1</char> loibt dem nomen fun Hashem,</para>
  <para style="q" vid="PSA 135:1">loibt, ir knecht fun Hashem,<verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />ir vos shteit in dem hoiz fun Hashem,</para>
  <para style="q" vid="PSA 135:2">in di hoifn fun dem beit hamikdosh fun Elokeinu.<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />loibt Hashem, vorem Hashem iz gut,</para>
  <para style="q" vid="PSA 135:3">zingt tsu zain nomen, vorem er iz lib.<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />vorem Hashem hot oisderveilt far zich Yaakov,</para>
  <para style="q" vid="PSA 135:4">Yisroel far zain bazunder eigens.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />vorem ich veis az Hashem iz grois,</para>
  <para style="q" vid="PSA 135:5">un undzer har iber ale g‑ter.<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />alts vos Hashem bagert, tut er,</para>
  <para style="q" vid="PSA 135:6">in himel un oif der erd,</para>
  <para style="q" vid="PSA 135:6">in di yamen un ale tehomen.<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />er brengt oif volkens fun ek erd,</para>
  <para style="q" vid="PSA 135:7">er macht blitsn tsum regn,</para>
  <para style="q" vid="PSA 135:7">er tsit arois fun zaine shpaichlers dem vint.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />er iz der vos hot geshlogn di bechorim fun Mitsrayim,</para>
  <para style="q" vid="PSA 135:8">fun a mentshn biz a beheime.<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />hot geshikt tseichns un vunder tsvishn dir, Mitsrayim,</para>
  <para style="q" vid="PSA 135:9">oif Pharaohn un oif ale zaine knecht.<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />er iz der vos hot geshlogn fil felker,</para>
  <para style="q" vid="PSA 135:10">un geharget machtike mlochim:<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />Sichon dem melech fun Emori,</para>
  <para style="q" vid="PSA 135:11">un Og dem melech fun Bashan,</para>
  <para style="q" vid="PSA 135:11">un ale kinigraichn fun Kenaan;<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />un gegebn zeyer land far a nachle,</para>
  <para style="q" vid="PSA 135:12">a nachle far Yisroel zain folk.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />Hashem, dain nomen iz oif eibik,</para>
  <para style="q" vid="PSA 135:13">Hashem, dain gedechenish iz oif dor-doires.<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />vorem Hashem vet zich onnemen far zain folk,</para>
  <para style="q" vid="PSA 135:14">un oif zaine knecht vet er zich derbaremen.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />di getsnbilder fun di felker zainen zilber un gold,</para>
  <para style="q" vid="PSA 135:15">dos verk fun a mentshns hent.<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />zei hobn a moil un redn nisht,</para>
  <para style="q" vid="PSA 135:16">zei hobn oign un zeen nisht;<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />zei hobn oiern un hern nisht;</para>
  <para style="q" vid="PSA 135:17">nishto tsu mol an otem in zeyer moil.<verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />zol vern vi zei di vos machn zei,</para>
  <para style="q" vid="PSA 135:18">itlecher vos farzichert zich oif zei.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />hoiz fun Yisroel, loibt Hashem;</para>
  <para style="q" vid="PSA 135:19">hoiz fun Aharon, loibt Hashem;<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />hoiz fun Levi, loibt Hashem;</para>
  <para style="q" vid="PSA 135:20">ir yirei Hashem, loibt Hashem.<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />Baruch Hashem fun Tsiyon,</para>
  <para style="q" vid="PSA 135:21">vos rut in Yerushalayim.</para>
  <para style="q" vid="PSA 135:21">halalu Hashem.<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" pubnumber="קלו" sid="PSA 136" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />git a dank tsu Hashem, vorem er iz gut,</para>
  <para style="qr" vid="PSA 136:1">vorem oif eibik iz zain chesed.<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />git a dank tsu Elokim fun di g‑ter,</para>
  <para style="qr" vid="PSA 136:2">vorem oif eibik iz zain chesed.<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />git a dank tsum har fun di harn,</para>
  <para style="qr" vid="PSA 136:3">vorem oif eibik iz zain chesed.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />tsu dem vos tut alein groise vunder,</para>
  <para style="qr" vid="PSA 136:4">vorem oif eibik iz zain chesed.<verse eid="PSA 136:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />tsu dem vos hot gemacht di himlen mit farshtandikeit,</para>
  <para style="qr" vid="PSA 136:5">vorem oif eibik iz zain chesed.<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />tsu dem vos hot oisgeshpreit di erd iber di vasern,</para>
  <para style="qr" vid="PSA 136:6">vorem oif eibik iz zain chesed.<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />tsu dem vos hot gemacht di groise lichter,</para>
  <para style="qr" vid="PSA 136:7">vorem oif eibik iz zain chesed;<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />di zun far geveltikung bai tog,</para>
  <para style="qr" vid="PSA 136:8">vorem oif eibik iz zain chesed;<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />di levone un shtern far geveltikungen bai nacht,</para>
  <para style="qr" vid="PSA 136:9">vorem oif eibik iz zain chesed.<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />tsu dem vos hot geshlogn Mitsrayim in zeyere bechorim,</para>
  <para style="qr" vid="PSA 136:10">vorem oif eibik iz zain chesed;<verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />un aroisgetsoign Yisroel fun tsvishn zei,</para>
  <para style="qr" vid="PSA 136:11">vorem oif eibik iz zain chesed;<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />mit a shtarker hant un mit an oisgeshtrektn orem,</para>
  <para style="qr" vid="PSA 136:12">vorem oif eibik iz zain chesed.<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />tsu dem vos hot tseshnitn dem Yam-Suf in shtiker,</para>
  <para style="qr" vid="PSA 136:13">vorem oif eibik iz zain chesed;<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />un durchgefirt Yisroel in mitn,</para>
  <para style="qr" vid="PSA 136:14">vorem oif eibik iz zain chesed.<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />un araingetreislt Pharaohn un zain cheil in Yam-Suf,</para>
  <para style="qr" vid="PSA 136:15">vorem oif eibik iz zain chesed.<verse eid="PSA 136:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />tsu dem vos hot gefirt zain folk in der midber,</para>
  <para style="qr" vid="PSA 136:16">vorem oif eibik iz zain chesed.<verse eid="PSA 136:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />tsu dem vos hot geshlogn groise mlochim,</para>
  <para style="qr" vid="PSA 136:17">vorem oif eibik iz zain chesed;<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />un geharget shtarke mlochim,</para>
  <para style="qr" vid="PSA 136:18">vorem oif eibik iz zain chesed;<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />Sichon der melech fun Emori,</para>
  <para style="qr" vid="PSA 136:19">vorem oif eibik iz zain chesed;<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />un Og dem melech fun Bashan,</para>
  <para style="qr" vid="PSA 136:20">vorem oif eibik iz zain chesed;<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />un gegebn zeyer land far a nachle,</para>
  <para style="qr" vid="PSA 136:21">vorem oif eibik iz zain chesed;<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />a nachle far Yisroel zain knecht,</para>
  <para style="qr" vid="PSA 136:22">vorem oif eibik iz zain chesed.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />tsu dem vos hot in undzer derniderung gedacht on undz,</para>
  <para style="qr" vid="PSA 136:23">vorem oif eibik iz zain chesed;<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />un undz oisgeleizt fun undzere driker,</para>
  <para style="qr" vid="PSA 136:24">vorem oif eibik iz zain chesed.<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />vos git broit tsu yetveder bashefenish,</para>
  <para style="qr" vid="PSA 136:25">vorem oif eibik iz zain chesed.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />git a dank tsum El fun di himlen,</para>
  <para style="qr" vid="PSA 136:26">vorem oif eibik iz zain chesed.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" pubnumber="קלז" sid="PSA 137" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />bai di taichn fun Bavel,</para>
  <para style="q" vid="PSA 137:1">dortn zainen mir gezesn un geveint,</para>
  <para style="q" vid="PSA 137:1">az mir hobn zich dermont on Tsiyon.<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />oif di verbes vos in ir</para>
  <para style="q" vid="PSA 137:2">hobn mir oifgehongen undzere harfn;<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />vorem dortn hobn undzere fanger</para>
  <para style="q" vid="PSA 137:3">farlangt fun undz verter fun gezang,</para>
  <para style="q" vid="PSA 137:3">un undzere painiker, freilechkeit:</para>
  <para style="q" vid="PSA 137:3">zingt undz fun dem gezang fun Tsiyon.<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />vi zoln mir zingen dos gezang fun Hashem</para>
  <para style="q" vid="PSA 137:4">oif fremder erd?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />oib ich vel dich fargesen, Yerushalayim,</para>
  <para style="q" vid="PSA 137:5">zol main rechte hant zich fargesen tsu rirn.<verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />zol tsugeklept vern main tsung tsu main gumen,</para>
  <para style="q" vid="PSA 137:6">oib ich vel dich nisht gedenken,</para>
  <para style="q" vid="PSA 137:6">oib ich vel nisht dermonen Yerushalayim</para>
  <para style="q" vid="PSA 137:6">oif main hechster simche.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />gedenk, Hashem, di kinder fun Edom</para>
  <para style="q" vid="PSA 137:7">dem tog fun Yerushalayim;</para>
  <para style="q" vid="PSA 137:7">di vos hobn gezogt: vorft ain,</para>
  <para style="q" vid="PSA 137:7">vorft ain biz tsum grunt in ir.<verse eid="PSA 137:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />tochter Bavel, du ongebreite tsu farvistung,</para>
  <para style="q" vid="PSA 137:8">voil tsu dem vos vet dir optsolen</para>
  <para style="q" vid="PSA 137:8">dain tuung vos du host undz geton;<verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />voil tsu dem vos vet onnemen un tsehakn</para>
  <para style="q" vid="PSA 137:9">daine kleine kinder on feldz.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" pubnumber="קלח" sid="PSA 138" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 138:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 138:1">
    <char style="va">1</char> ich vel dich loibn mit main gantsn hartsn,</para>
  <para style="q" vid="PSA 138:1">far di machtike vel ich dich bazingen.<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />ich vel zich bukn tsu dain heilikn heichl,</para>
  <para style="q" vid="PSA 138:2">un ich vel loibn dain nomen,</para>
  <para style="q" vid="PSA 138:2">far dain chesed un far dain traishaft;</para>
  <para style="q" vid="PSA 138:2">vorem iber al dain nomen</para>
  <para style="q" vid="PSA 138:2">hostu gegreist dain tsuzog.<verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />in tog vos ich hob gerufn hostu mir geentfert,</para>
  <para style="q" vid="PSA 138:3">host mir gemutikt mit shtarkeit main zel.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />loibn veln dich, Hashem, ale mlochim fun der erd,</para>
  <para style="q" vid="PSA 138:4">vorem zei hobn gehert di verter fun dain moil.<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />un zei veln zingen fun di vegen fun Hashem,</para>
  <para style="q" vid="PSA 138:5">vorem grois iz der koved fun Hashem.<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />chotsh Hashem iz derheicht, doch zet er on dem niderikn,</para>
  <para style="q" vid="PSA 138:6">ober dem shtoltsn ken er fun vaitn.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />az ich gei in der mit fun noit,</para>
  <para style="q" vid="PSA 138:7">lebstu mich oif;</para>
  <para style="q" vid="PSA 138:7">tsu lehaches maine faint shtrekstu ois dain hant,</para>
  <para style="q" vid="PSA 138:7">un dain rechte hant helft mich.<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />Hashem firt ois far mir;</para>
  <para style="q" vid="PSA 138:8">Hashem, dain chesed iz oif eibik;</para>
  <para style="q" vid="PSA 138:8">di verk fun daine hent zolstu nisht farlozen.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" pubnumber="קלט" sid="PSA 139" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 139:1" />far dem gezangmaister; fun Dovidn a mizmor.</para>
  <para style="q" vid="PSA 139:1">
    <char style="va">1</char> Hashem, du host mich oisgeforsht, un kenst mich.<verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />du veist main zitsn un main oifshtein,</para>
  <para style="q" vid="PSA 139:2">farshteist main trachtung fun der vaitn.<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />main gein un main lign zipstu durch,</para>
  <para style="q" vid="PSA 139:3">un in ale maine vegen bistu bahavnt.<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />vorem dos vort iz noch tsu mol nisht oif main tsung,</para>
  <para style="q" vid="PSA 139:4">veistu es doch, Hashem, shoin in gantsn.<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />hintn un forent hostu mich balegert,</para>
  <para style="q" vid="PSA 139:5">un aroifgeton oif mir dain hant.<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />tsu vunderlech iz dos far mir tsu farshtein,</para>
  <para style="q" vid="PSA 139:6">tsu hoich, ich ken es nisht banemen.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />vuhin zol ich avekgein fun dain gaist?</para>
  <para style="q" vid="PSA 139:7">un vuhin zol ich fun dain ponem antloifn?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />zol ich aroifgein in himel, bistu dortn,</para>
  <para style="q" vid="PSA 139:8">un zol ich mir oisbetn in Sheol, ersht bist do.<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />zol ich nemen di fliglen fun baginen,</para>
  <para style="q" vid="PSA 139:9">zol ich ruen in ek fun yam,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />vet oich dortn mich firn dain hant,</para>
  <para style="q" vid="PSA 139:10">un mich vet haltn dain rechte.<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />un zol ich zogn: loiter fintsternish zol mich badekn,</para>
  <para style="q" vid="PSA 139:11">un nacht zol dos licht far mir vern,<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />iz oich fintsternish nisht fintster far dir,</para>
  <para style="q" vid="PSA 139:12">un nacht tut azoi vi der tog laichtn;</para>
  <para style="q" vid="PSA 139:12">azoi fintsterkeit azoi lichtikeit.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />vorem du host gefarmogn maine nirn,</para>
  <para style="q" vid="PSA 139:13">host mich gevebt in laib fun main muter.<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />ich loib dich, vorem moiredik vunderlech bin ich gemacht;</para>
  <para style="q" vid="PSA 139:14">vunderlech zainen daine verk,</para>
  <para style="q" vid="PSA 139:14">un main zel veis dos voil.<verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />nisht farhoiln iz geven main gebein far dir,</para>
  <para style="q" vid="PSA 139:15">ven ich bin gemacht gevorn in farborgenish,</para>
  <para style="q" vid="PSA 139:15">geshtrikt gevorn in tifenishn fun der erd.<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />main umgefuremt laib hobn gezen daine oign;</para>
  <para style="q" vid="PSA 139:16">yo, in dain buch vern zei ale ongeshriben,</para>
  <para style="q" vid="PSA 139:16">di teg ven me zol bashafn vern,</para>
  <para style="q" vid="PSA 139:16">un einer tsvishn zei iz geven far im.<verse eid="PSA 139:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />un vi harb far mir zainen daine trachtungen, El,</para>
  <para style="q" vid="PSA 139:17">vi gevaltik iz zeyer misper!<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />zol ich zei tseiln, zainen zei mer fun zamd,</para>
  <para style="q" vid="PSA 139:18">zol ich dergein tsum sof, darf main doier zain vi dainer.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />ven du, Eloah, volst teitn dem roshe!</para>
  <para style="q" vid="PSA 139:19">un ir blutik lait, tut zich op fun mir!<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />di vos redn dich arois mit a beizer kavone,</para>
  <para style="q" vid="PSA 139:20">daine faint vos dermonen dich tsum falshn.<verse eid="PSA 139:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />far vor, daine faint, Hashem, hob ich faint,</para>
  <para style="q" vid="PSA 139:21">un mit daine kegnshteyer tu ich krign.<verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />faint biz gor hob ich zei faint,</para>
  <para style="q" vid="PSA 139:22">sonem zainen zei bai mir.<verse eid="PSA 139:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />forsh mich, El, un derken main harts,</para>
  <para style="q" vid="PSA 139:23">pruv mich, un veis maine gedanken;<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />un ze oib in mir iz do a fardrosiker veg,</para>
  <para style="q" vid="PSA 139:24">un fir mich in dem eibikn veg.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" pubnumber="קמ" sid="PSA 140" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 140:1" />far dem gezangmaister; a mizmor fun Dovidn.<verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 140:2" /> derleiz mich, Hashem, fun dem shlechtn mentshn,</para>
  <para style="q" vid="PSA 140:2">fun dem roibmentshn zolstu mich bahitn;<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 140:3" /> di vos trachtn beiz in hartsn,</para>
  <para style="q" vid="PSA 140:3">ale tog hetsn zei milchomes.<verse eid="PSA 140:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 140:4" /> zei sharfn zeyer tsung vi a shlang,</para>
  <para style="q" vid="PSA 140:4">gift fun an otershlang iz unter zeyere lipn.</para>
  <para style="q" vid="PSA 140:4">Selah.<verse eid="PSA 140:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 140:5" /> hit mich, Hashem, fun di hent fun dem roshe,</para>
  <para style="q" vid="PSA 140:5">fun dem roibmentshn zolstu mich bahitn;</para>
  <para style="q" vid="PSA 140:5">di vos trachtn umtsushtoisn maine trit.<verse eid="PSA 140:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 140:6" /> di hoferdike hobn mir a pastke untergeleigt, un shtrik,</para>
  <para style="q" vid="PSA 140:6">zei hobn oisgeshpreit a nets lebn shteg,</para>
  <para style="q" vid="PSA 140:6">shtroichlungen hobn zei mir geshtelt.</para>
  <para style="q" vid="PSA 140:6">Selah.<verse eid="PSA 140:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 140:7" /> ich zog tsu Hashem: main G-t bist du;</para>
  <para style="q" vid="PSA 140:7">farnem, Hashem, dem kol fun maine gebetn.<verse eid="PSA 140:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 140:8" /> Hashem du Adonoi, di shtarkeit fun main hilf,</para>
  <para style="q" vid="PSA 140:8">host bashiremt main kop in tog fun bavofenung;<verse eid="PSA 140:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 140:9" /> zolst nisht gebn, Hashem, di bageren fun dem roshe,</para>
  <para style="q" vid="PSA 140:9">zain kavone zolstu nisht lozn oisfirn,</para>
  <para style="q" vid="PSA 140:9">az zei zoln zich derheibn.</para>
  <para style="q" vid="PSA 140:9">Selah.<verse eid="PSA 140:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 140:10" /> dos gift fun maine arumringler,</para>
  <para style="q" vid="PSA 140:10">dos umglik fun zeyere lipn zol zei alein tsudekn.<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 140:11" /> zoln faln oif zei koiln,</para>
  <para style="q" vid="PSA 140:11">in faier zol er zei vorfn,</para>
  <para style="q" vid="PSA 140:11">in griber, az zei zoln nisht oifshtein.<verse eid="PSA 140:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 140:12" /> der tsungmentsh zol nisht bashtein oif der erd,</para>
  <para style="q" vid="PSA 140:12">dem beizn roibmentshn, im zol er yogn tsu farshtoisung.<verse eid="PSA 140:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 140:13" /> ich veis az Hashem vet ton dos recht fun dem oreman,</para>
  <para style="q" vid="PSA 140:13">di gerechtikeit fun di baderftike.<verse eid="PSA 140:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 140:14" /> far vor, di tsadikim veln danken dain nomen,</para>
  <para style="q" vid="PSA 140:14">di rechtfartikn veln zitsn far dain ponem.<verse eid="PSA 140:14" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" pubnumber="קמא" sid="PSA 141" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 141:1" />a mizmor fun Dovidn.</para>
  <para style="q" vid="PSA 141:1">
    <char style="va">1</char> Hashem, ich ruf dich, ail tsu mir,</para>
  <para style="q" vid="PSA 141:1">farnem main kol, az ich ruf tsu dir.<verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />zol bashtein main tfile vi vairech far dir,</para>
  <para style="q" vid="PSA 141:2">di oifheibung fun maine hent vi der ovnt-korben.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />mach, Hashem, a hitung oif main moil,</para>
  <para style="q" vid="PSA 141:3">gib acht oif der tir fun maine lipn.<verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />zolst nisht farneign main harts tsu a beizer zach,</para>
  <para style="q" vid="PSA 141:4">tsu ton tuungen in shlechtikeit</para>
  <para style="q" vid="PSA 141:4">mit lait vos verkn umrecht;</para>
  <para style="q" vid="PSA 141:4">un lomich nisht esen fun zeyere zise shpaizn;<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />zol mich shlogn der tsadik ois gintsikeit,</para>
  <para style="q" vid="PSA 141:5">un mich shtrofn;</para>
  <para style="q" vid="PSA 141:5">main kop vet nisht opshtoisn dos taiere eil –</para>
  <para style="q" vid="PSA 141:5">vorem tamid iz main tfile akegn zeyere beizn.<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />zoln geshlaidert vern on a feldz zeyere richter;</para>
  <para style="q" vid="PSA 141:6">un me zol hern maine verter az zei zainen liblech.<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />azoi vi ven me shpalt un brecht oif di erd,</para>
  <para style="q" vid="PSA 141:7">zainen tseshotn undzere beiner baim moil fun Sheol.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />vorem oif dir, Hashem du Adonoi, zainen maine oign;</para>
  <para style="q" vid="PSA 141:8">in dir shits ich mich, zolst nisht oisgisen main zel.<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />hit mich fun der pastke vos zei hobn mir geshtelt,</para>
  <para style="q" vid="PSA 141:9">un fun di shtroichlungen fun di umrechttuer.<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />zoln arainfaln in zeyere netsn di reshoim,</para>
  <para style="q" vid="PSA 141:10">beeis ich alein vel aribergein.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" pubnumber="קמב" sid="PSA 142" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 142:1" />a batrachtung fun Dovidn, ven er iz geven in der heil; a tfile.<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 142:2" /> mit main kol shrai ich tsu Hashem,</para>
  <para style="q" vid="PSA 142:2">mit main kol bet ich tsu Hashem.<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 142:3" /> ich gis ois far im main klog,</para>
  <para style="q" vid="PSA 142:3">main noit dertseil ich far im.<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 142:4" /> ven main gemit fargeit in mir,</para>
  <para style="q" vid="PSA 142:4">du veist doch main shteg –</para>
  <para style="q" vid="PSA 142:4">oif dem veg vos ich gei,</para>
  <para style="q" vid="PSA 142:4">hobn zei mir a pastke bahaltn.<verse eid="PSA 142:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 142:5" /> kuk rechts, un ze,</para>
  <para style="q" vid="PSA 142:5">az ich hob nisht kein bakentn;</para>
  <para style="q" vid="PSA 142:5">farlorn iz antrinung fun mir,</para>
  <para style="q" vid="PSA 142:5">keiner fregt nisht oif main zel.<verse eid="PSA 142:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 142:6" /> ich shrai tsu dir, Hashem,</para>
  <para style="q" vid="PSA 142:6">ich zog: bist main bashitsung,</para>
  <para style="q" vid="PSA 142:6">main teil in dem land fun di lebedike.<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 142:7" /> farnem main geshrei,</para>
  <para style="q" vid="PSA 142:7">vorem ich bin gefaln zeyer;</para>
  <para style="q" vid="PSA 142:7">zai mich matsl fun maine nochyoger,</para>
  <para style="q" vid="PSA 142:7">vorem zei zainen shtarker fun mir.<verse eid="PSA 142:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 142:8" /> tsi arois fun festung main zel, tsu loibn dain nomen;</para>
  <para style="q" vid="PSA 142:8">durch mir veln di tsadikim zich kreinen,</para>
  <para style="q" vid="PSA 142:8">az du vest mir guts ton.<verse eid="PSA 142:8" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" pubnumber="קמג" sid="PSA 143" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 143:1" />a mizmor fun Dovidn.</para>
  <para style="q" vid="PSA 143:1">
    <char style="va">1</char>Hashem, her main tfile, farnem maine gebetn,</para>
  <para style="q" vid="PSA 143:1">in dain traishaft entfer mir, in dain gerechtikeit.<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />un zolst nisht gein in mishpot mit dain knecht,</para>
  <para style="q" vid="PSA 143:2">vorem kein lebediker ken nisht gerecht zain far dir.<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />vorem der faint hot geroideft main zel,</para>
  <para style="q" vid="PSA 143:3">er hot tsugedrikt tsu der erd main lebn,</para>
  <para style="q" vid="PSA 143:3">er hot mich araingezetst in fintsternishn,</para>
  <para style="q" vid="PSA 143:3">vi geshtorbene fun lang on.<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />un main gemit fargeit in mir,</para>
  <para style="q" vid="PSA 143:4">main harts vert banumen in mir.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />ich hob zich dermont di teg fun a mol,</para>
  <para style="q" vid="PSA 143:5">ich hob getracht on al dain tuung;</para>
  <para style="q" vid="PSA 143:5">on dem verk fun daine hent tu ich klern.<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />ich hob oisgeshpreit maine hent tsu dir,</para>
  <para style="q" vid="PSA 143:6">main zel vi a farshmacht land tsu dir.</para>
  <para style="q" vid="PSA 143:6">Selah.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />entfer mir gich, Hashem, main gemit geit ois;</para>
  <para style="q" vid="PSA 143:7">zolst nisht farborgen dain ponem fun mir,</para>
  <para style="q" vid="PSA 143:7">azist vel ich geglichn zain tsu di geniderte in grub.<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />loz mich hern in frimorgn dain chesed,</para>
  <para style="q" vid="PSA 143:8">vorem oif dir hob ich mich farzichert.</para>
  <para style="q" vid="PSA 143:8">loz mich visen dem veg vos ich zol gein,</para>
  <para style="q" vid="PSA 143:8">vorem tsu dir hob ich oifgehoibn main zel.<verse eid="PSA 143:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />zai mich matsl, Hashem, fun maine faint;</para>
  <para style="q" vid="PSA 143:9">bai dir hob ich mich farborgen.<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />lern mich tsu ton dain rotsn,</para>
  <para style="q" vid="PSA 143:10">vorem du bist main G-t;</para>
  <para style="q" vid="PSA 143:10">dain guter gaist zol mich firn oif a glaichn land.<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />fun dain nomen vegen, Hashem, zolstu mich oiflebn,</para>
  <para style="q" vid="PSA 143:11">in dain gerechtikeit zolstu aroistsien fun noit main zel.<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />un in dain chesed zolstu farshnaidn maine faint,</para>
  <para style="q" vid="PSA 143:12">un unterbrengen ale vos drikn main zel,</para>
  <para style="q" vid="PSA 143:12">vorem ich bin dain knecht.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" pubnumber="קמד" sid="PSA 144" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 144:1" />fun Dovidn.</para>
  <para style="q" vid="PSA 144:1">
    <char style="va">1</char> Baruch Hashem main feldz,</para>
  <para style="q" vid="PSA 144:1">vos lernt maine hent tsu krig,</para>
  <para style="q" vid="PSA 144:1">maine finger tsu milchome.<verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />main genod un main festung,</para>
  <para style="q" vid="PSA 144:2">main turem un der vos macht mich antrinen:</para>
  <para style="q" vid="PSA 144:2">main shild un der vos ich shits mich in im,</para>
  <para style="q" vid="PSA 144:2">der vos untertenikt main folk unter mir.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />Hashem, vos iz der mentsh, az du zolst zich kimern um im?</para>
  <para style="q" vid="PSA 144:3">un a mentshnkind, az du zolst achten oif im?<verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />a mentsh iz geglichn tsu a hoich,</para>
  <para style="q" vid="PSA 144:4">zaine teg zainen vi a shotn vos fargeit.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />Hashem, naig daine himlen un zolst aropnideren,</para>
  <para style="q" vid="PSA 144:5">rir on di berg, un zei zoln reichern.<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />blits arois a blits, un zolst zei tseshpreitn,</para>
  <para style="q" vid="PSA 144:6">shik daine failn, un fartuml zei.<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />shtrek ois daine hent fun der heich,</para>
  <para style="q" vid="PSA 144:7">rais mich arois un zai mich matsl fun vasern groise,</para>
  <para style="q" vid="PSA 144:7">fun der hant fun fremdgeborene,<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />vos zeyer moil redt falshkeit,</para>
  <para style="q" vid="PSA 144:8">un zeyer rechte hant iz a rechte hant fun lign.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />Elokim, a nai gezang vel ich dir zingen,</para>
  <para style="q" vid="PSA 144:9">oif a gitar fun tsen strunes vel ich shpiln tsu dir,<verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10" />vos gist hilf tsu di mlochim,</para>
  <para style="q" vid="PSA 144:10">vos raist arois Dovid zain knecht fun der beizer shverd.<verse eid="PSA 144:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11" />rais mich arois un zai mich matsl</para>
  <para style="q" vid="PSA 144:11">fun der hant fun fremdgeborene,</para>
  <para style="q" vid="PSA 144:11">vos zeyer moil redt falshkeit,</para>
  <para style="q" vid="PSA 144:11">un zeyer rechte hant iz a rechte hant fun lign.<verse eid="PSA 144:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />vos undzere zin zainen vi oifgevaksene flantsn in zeyer yugnt;</para>
  <para style="q" vid="PSA 144:12">undzere techter vi vinklzailn</para>
  <para style="q" vid="PSA 144:12">geshnitst loit dem boi fun a heichl;<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />undzere shpaichlers ful,</para>
  <para style="q" vid="PSA 144:13">aroisgebndik alerlei minim;</para>
  <para style="q" vid="PSA 144:13">undzere shof in toizntn,</para>
  <para style="q" vid="PSA 144:13">in tsentoizntn, oif undzere felder;<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />undzere oksen balodn;</para>
  <para style="q" vid="PSA 144:14">kein broch, un kein minerung,</para>
  <para style="q" vid="PSA 144:14">un kein veigeshrei in undzere gasn –<verse eid="PSA 144:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />voil tsu dem folk vos bai im iz azoi,</para>
  <para style="q" vid="PSA 144:15">voil tsu dem folk vos Hashem iz zain G-t.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" pubnumber="קמה" sid="PSA 145" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 145:1" />a loibung fun Dovidn.</para>
  <para style="q" vid="PSA 145:1">
    <char style="va">1</char> ich vel dich derheibn, main G-t der kinig,</para>
  <para style="q" vid="PSA 145:1">un bentshn dain nomen eibik un shtendik.<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />ale tog vel ich dich bentshn,</para>
  <para style="q" vid="PSA 145:2">un rimen dain nomen eibik un shtendik.<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />grois iz Hashem un zeyer gerimt,</para>
  <para style="q" vid="PSA 145:3">un zain groiskeit iz nisht tsu derforshn.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />a dor tsu a dor vet loibn daine meisim,</para>
  <para style="q" vid="PSA 145:4">un daine gevuros veln zei onzogen.<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />di prachtike sheinkeit fun dain glants,</para>
  <para style="q" vid="PSA 145:5">un di mayseyus fun daine vunder vel ich dertseiln.<verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />un fun der shtarkeit fun daine forchtike oiftuen vet men redn,</para>
  <para style="q" vid="PSA 145:6">un dain groiskeit, zi vel ich fartseiln.<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />di dermonung fun dain grois gutskeit vet men aroiszogn,</para>
  <para style="q" vid="PSA 145:7">un dain gerechtikeit vet men bazingen.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />laitzelik un derbaremdik iz Hashem,</para>
  <para style="q" vid="PSA 145:8">aingehaltn in tsorn un grois in genod.<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />gut iz Hashem tsu alemen,</para>
  <para style="q" vid="PSA 145:9">un zain rachmones iz oif ale zaine verk.<verse eid="PSA 145:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />dich veln loibn, Hashem, ale daine verk,</para>
  <para style="q" vid="PSA 145:10">un daine frume veln dich bentshn.<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />di pracht fun dain meluche veln zei dertseiln,</para>
  <para style="q" vid="PSA 145:11">un fun dain gevure veln zei redn;<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />tsu lozn visen di mentshnkinder zaine gevuros,</para>
  <para style="q" vid="PSA 145:12">un di prachtike sheinkeit fun zain meluche.<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />dain meluche iz di meluche fun ale eibikeitn,</para>
  <para style="q" vid="PSA 145:13">un dain geveltikung iz in ale dor-doires.<verse eid="PSA 145:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />Hashem lent unter ale gefalene,</para>
  <para style="q" vid="PSA 145:14">un shtelt oif ale geboigene.<verse eid="PSA 145:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />di oign fun alemen kukn ois oif dir,</para>
  <para style="q" vid="PSA 145:15">un du gist zei zeyer esen in zain tsait.<verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />efnst dain hant,</para>
  <para style="q" vid="PSA 145:16">un zetikst yetveder lebedikn mit gutvilikeit.<verse eid="PSA 145:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />gerecht iz Hashem in ale zaine vegen,</para>
  <para style="q" vid="PSA 145:17">un genodik in ale zaine meisim.<verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />Hashem iz nont tsu ale vos rufn im,</para>
  <para style="q" vid="PSA 145:18">tsu ale vos rufn im mit emes.<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />er tut dem rotsn fun di vos forchtn im,</para>
  <para style="q" vid="PSA 145:19">un zeyer geshrei hert er tsu, un helft zei.<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />Hashem bahit ale vos hobn im lib,</para>
  <para style="q" vid="PSA 145:20">un ale reshoim vet er fartiliken.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />dem loib fun Hashem zol redn main moil,</para>
  <para style="q" vid="PSA 145:21">un yetveder laib zol bentshn zain heilikn nomen</para>
  <para style="q" vid="PSA 145:21">eibik un shtendik.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" pubnumber="קמו" sid="PSA 146" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 146:1">loib Hashem, main zel;<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />ich vel loibn Hashem kol-zman ich leb,</para>
  <para style="q" vid="PSA 146:2">ich vel zingen tsu Hashem vi lang ich bin.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />ir zolt aich nisht farzichern oif firshtn,</para>
  <para style="q" vid="PSA 146:3">oif a mentshnkind vos nishto bai im kein hilf.<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />geit ois zain otem, kert er zich um tsu zain shtoib;</para>
  <para style="q" vid="PSA 146:4">in yenem tog geyen unter zaine trachtungen.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />voil tsu dem vos der El fun Yaakov iz zain hilf,</para>
  <para style="q" vid="PSA 146:5">vos zain oiskuk iz oif Hashem zain G-t,<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />vos hot gemacht dem himel un di erd,</para>
  <para style="q" vid="PSA 146:6">dem yam, un alts vos in zei;</para>
  <para style="q" vid="PSA 146:6">der vos hit traishaft oif eibik;<verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />vos tut recht tsu di gedrikte,</para>
  <para style="q" vid="PSA 146:7">vos git broit tsu di hungerike.</para>
  <para style="q" vid="PSA 146:7">Hashem bindt op di gebundene,<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />Hashem macht zeedik di blinde,</para>
  <para style="q" vid="PSA 146:8">Hashem shtelt oif di geboigene,</para>
  <para style="q" vid="PSA 146:8">Hashem hot lib di gerechte.<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />Hashem bahit di fremde;</para>
  <para style="q" vid="PSA 146:9">dem yosem un di almone richt er oif,</para>
  <para style="q" vid="PSA 146:9">un dem veg fun di reshoim fardreit er.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />Hashem vet kinign oif eibik,</para>
  <para style="q" vid="PSA 146:10">dain G-t, Tsiyon, oif dor-doires.</para>
  <para style="q" vid="PSA 146:10">halalu Hashem.<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" pubnumber="קמז" sid="PSA 147" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />halalu Hashem;</para>
  <para style="q" vid="PSA 147:1">vorem gut iz zingen tsu Elokeinu,</para>
  <para style="q" vid="PSA 147:1">vorem es iz liblech;</para>
  <para style="q" vid="PSA 147:1">shein iz dos loibn.<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />Hashem boit Yerushalayim,</para>
  <para style="q" vid="PSA 147:2">di farshtoisene fun Yisroel vet er ainzamlen;<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />der vos heilt di tsebrochene hertser,</para>
  <para style="q" vid="PSA 147:3">un farbindt zeyere vundn.<verse eid="PSA 147:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />er tseilt dem misper fun di shtern,</para>
  <para style="q" vid="PSA 147:4">zei ale mit nemen ruft er on.<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />grois iz undzer har un machtik in koiech,</para>
  <para style="q" vid="PSA 147:5">nishto kein shieur tsu zain farshtandikeit.<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />Hashem richt oif di gedrikte,</para>
  <para style="q" vid="PSA 147:6">er dernidert di reshoim biz der erd.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />zingt tsu Hashem mit loib-gezang,</para>
  <para style="q" vid="PSA 147:7">shpilt tsu Elokeinu oif der harf.<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />der vos badekt dem himel mit volkens,</para>
  <para style="q" vid="PSA 147:8">vos breit on regn far der erd,</para>
  <para style="q" vid="PSA 147:8">vos bashprotst di berg mit groz.<verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />er git der beheime ir shpaiz,</para>
  <para style="q" vid="PSA 147:9">di kinder fun rob vos rufn.<verse eid="PSA 147:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />nisht di gevure fun dem ferd bagert er,</para>
  <para style="q" vid="PSA 147:10">nisht di shenklen fun dem man vil er.<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />Hashem vil di vos forchtn im,</para>
  <para style="q" vid="PSA 147:11">di vos harn oif zain chesed.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />gib a shevech tsu Hashem, Yerushalayim,</para>
  <para style="q" vid="PSA 147:12">loib dain G-t, Tsiyon.<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />vorem er hot geshtarkt di riglen fun daine toiern,</para>
  <para style="q" vid="PSA 147:13">er hot gebentsht daine kinder in dir;<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />der vos git dain gemark sholem,</para>
  <para style="q" vid="PSA 147:14">dich zetikt mit fets fun veits;<verse eid="PSA 147:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />der vos shikt zain onzog oif der erd –</para>
  <para style="q" vid="PSA 147:15">oif gich loift zain vort;<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />der vos git shnei azoi vi vol,</para>
  <para style="q" vid="PSA 147:16">frost vi ash tut er shpreitn.<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />er vorft zain aiz azoi vi breklech;</para>
  <para style="q" vid="PSA 147:17">far zain kelt, ver ken bashtein?<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />er shikt zain vort, un macht zei tsegein;</para>
  <para style="q" vid="PSA 147:18">er macht blozn zain vint, rinen vasern.<verse eid="PSA 147:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />er zogt zaine verter tsu Yaakov,</para>
  <para style="q" vid="PSA 147:19">zaine chukkim un zaine gezetsn tsu Yisroel.<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />er hot azoi nisht geton tsu kein folk,</para>
  <para style="q" vid="PSA 147:20">un gezetsn, derfun veisn zei nisht.</para>
  <para style="q" vid="PSA 147:20">halalu Hashem.<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" pubnumber="קמח" sid="PSA 148" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 148:1">loibt Hashem, fun di himlen,</para>
  <para style="q" vid="PSA 148:1">loibt im in di heichn.<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />loibt im, ale zaine malachim;</para>
  <para style="q" vid="PSA 148:2">loibt im, ale zaine chilut.<verse eid="PSA 148:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />loibt im, zun un levone;</para>
  <para style="q" vid="PSA 148:3">loibt im, ale lichtike shtern.<verse eid="PSA 148:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />loibt im, di himlen fun di himlen,</para>
  <para style="q" vid="PSA 148:4">un di vasern vos iber di himlen.<verse eid="PSA 148:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />zoln zei loibn dem nomen fun Hashem,</para>
  <para style="q" vid="PSA 148:5">vorem er hot bafoiln, un zei zainen bashafn gevorn.<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />un er hot zei oifgeshtelt oif shtendik, oif eibik;</para>
  <para style="q" vid="PSA 148:6">er hot geshtelt a gezets vos zol nisht fargein.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />loibt Hashem, fun der erd,</para>
  <para style="q" vid="PSA 148:7">ir yam-chayes un ale tehomen;<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />faier un hogel, shnei un nebl;</para>
  <para style="q" vid="PSA 148:8">der shturemvint vos tut zain vort;<verse eid="PSA 148:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />berg un ale heichn,</para>
  <para style="q" vid="PSA 148:9">fruchtbeimer un ale tsedern;<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />chayes un ale beheimes,</para>
  <para style="q" vid="PSA 148:10">shrotsim un gefliglte foiglen;<verse eid="PSA 148:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />mlochim fun der erd un ale felker,</para>
  <para style="q" vid="PSA 148:11">harn un ale richter fun der erd;<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />bochurim un oich yungfroin,</para>
  <para style="q" vid="PSA 148:12">zkeinim mit yinglech.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />zei zoln loibn dem nomen fun Hashem,</para>
  <para style="q" vid="PSA 148:13">vorem zain nomen alein iz derhoibn;</para>
  <para style="q" vid="PSA 148:13">zain glants iber erd un himel.<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />un er hot derheicht dem horn fun zain folk –</para>
  <para style="q" vid="PSA 148:14">a loib far ale zaine frume,</para>
  <para style="q" vid="PSA 148:14">far di kinder fun Yisroel,</para>
  <para style="q" vid="PSA 148:14">dem folk vos iz im nont.</para>
  <para style="q" vid="PSA 148:14">halalu Hashem.<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" pubnumber="קמט" sid="PSA 149" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 149:1">zingt tsu Hashem a nai gezang,</para>
  <para style="q" vid="PSA 149:1">zain loib in der ainzamlung fun di frume.<verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />zol zich freyen Yisroel mit zain Bashefer,</para>
  <para style="q" vid="PSA 149:2">di kinder fun Tsiyon zoln lustik zain mit zeyer melech.<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />zoln zei loibn zain nomen mit tants,</para>
  <para style="q" vid="PSA 149:3">mit poik un harf zoln zei shpiln tsu im.<verse eid="PSA 149:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />vorem Hashem bavilikt zain folk,</para>
  <para style="q" vid="PSA 149:4">er basheint di gedrikte mit hilf.<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />zoln di frume zich freyen in koved,</para>
  <para style="q" vid="PSA 149:5">zoln zei zingen oif zeyere gelegers.<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />der heibungen fun El in zeyer moil,</para>
  <para style="q" vid="PSA 149:6">un a tsveisharfike shverd in zeyer hant,<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />tsu ton a nekome on di felker,</para>
  <para style="q" vid="PSA 149:7">shtrofungen oif di umes;<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />tsu shmidn zeyere mlochim in keitn,</para>
  <para style="q" vid="PSA 149:8">un zeyere ongezeene in aizerne ringen;<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />tsu ton oif zei dem ongeshribenem mishpot.</para>
  <para style="q" vid="PSA 149:9">shein vet dos zain far ale zaine frume.</para>
  <para style="q" vid="PSA 149:9">halalu Hashem.<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" pubnumber="קנ" sid="PSA 150" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1" />halalu Hashem.</para>
  <para style="q" vid="PSA 150:1">loibt Hashem in zain heiliktum,</para>
  <para style="q" vid="PSA 150:1">loibt im in zain machtikn himel.<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />loibt im vegen zaine gevuros,</para>
  <para style="q" vid="PSA 150:2">loibt im loit zain fil groiskeit.<verse eid="PSA 150:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />loibt im mit blozung fun shoifer,</para>
  <para style="q" vid="PSA 150:3">loibt im mit gitar un harf.<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />loibt im mit poik un tants,</para>
  <para style="q" vid="PSA 150:4">loibt im mit strunes un fleit .<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />loibt im mit klingedike tsimblen,</para>
  <para style="q" vid="PSA 150:5">loibt im mit hilchike tsimblen.<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />alts vos otemt zol loibn G-t.</para>
  <para style="q" vid="PSA 150:6">halalu Hashem.<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>