<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Michah</para>
  <para style="toc2">Michah</para>
  <para style="toc1">Michah</para>
  <para style="mt1">Michah</para>
  <chapter number="1" style="c" pubnumber="א" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />dos vort fun Hashem vos iz geven tsu Michahn fun Moreshet, in di teg fun Yotam, Achaz, Yechizkiyah, di mlochim fun Yehudah, vos er hot gezen oif Shomron un Yerushalayim.<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="MIC 1:2" />hert ir felker ale,</para>
  <para style="q" vid="MIC 1:2">farnem du erd un ir fulkeit;</para>
  <para style="q" vid="MIC 1:2">un Adonoi Hashem vet zain tsum eides kegen aich,</para>
  <para style="q" vid="MIC 1:2">der har fun zain heilikn heichl.<verse eid="MIC 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 1:3" />vorem ze, Hashem geit arois fun zain ort,</para>
  <para style="q" vid="MIC 1:3">un vet nidern un tretn oif di heichn fun der erd.<verse eid="MIC 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 1:4" />un di berg veln tsegein unter im,</para>
  <para style="q" vid="MIC 1:4">un di toln veln zich shpaltn,</para>
  <para style="q" vid="MIC 1:4">vi vaks faran faier,</para>
  <para style="q" vid="MIC 1:4">vi vaser oisgegosen in a niderung.<verse eid="MIC 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 1:5" />iber dem farbrech fun Yaakov iz dos alts,</para>
  <para style="q" vid="MIC 1:5">un iber di zind fun dem hoiz fun Yisroel.</para>
  <para style="q" vid="MIC 1:5">ver iz der farbrech fun Yaakov</para>
  <para style="q" vid="MIC 1:5">oib nisht Shomron?</para>
  <para style="q" vid="MIC 1:5">un ver di bamot fun Yehudah</para>
  <para style="q" vid="MIC 1:5">oib nisht Yerushalayim?<verse eid="MIC 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 1:6" />derum vel ich machn Shomron far a feldhoifn,</para>
  <para style="q" vid="MIC 1:6">far flantsungen fun vaingertner.</para>
  <para style="q" vid="MIC 1:6">un ich vel shlaidern tsum tal ire shteiner,</para>
  <para style="q" vid="MIC 1:6">un ire gruntfestn vel ich antplekn.<verse eid="MIC 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 1:7" />un ale ire geshnitste getsn veln tsehakt vern,</para>
  <para style="q" vid="MIC 1:7">un ale ire zoine-loinen veln farbrent vern in faier,</para>
  <para style="q" vid="MIC 1:7">un ale ire getsnbilder vel ich machn tsu vist;</para>
  <para style="q" vid="MIC 1:7">vorem fun zoine-loin hot zi zei oifgeklibn,</para>
  <para style="q" vid="MIC 1:7">un tsu zoine-loin zoln zei vider vern.<verse eid="MIC 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="MIC 1:8" />deroif vel ich klogn un yomern,</para>
  <para style="q" vid="MIC 1:8">ich vel umgein borves un naket,</para>
  <para style="q" vid="MIC 1:8">ich vel machn a klog vi di shakaln,</para>
  <para style="q" vid="MIC 1:8">un a troier vi shtroisfoiglen.<verse eid="MIC 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 1:9" />vorem shver zainen ire shlek,</para>
  <para style="q" vid="MIC 1:9">vorem es iz gekumen biz Yehudah,</para>
  <para style="q" vid="MIC 1:9">es greicht bizn toier fun main folk,</para>
  <para style="q" vid="MIC 1:9">biz Yerushalayim.<verse eid="MIC 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="MIC 1:10" />nisht dertseiln zolt ir in Gat,</para>
  <para style="q" vid="MIC 1:10">veinen zolt ir nisht veinen;</para>
  <para style="q" vid="MIC 1:10">in Beis-Laphrah in shtoib tu zich kaiklen.<verse eid="MIC 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 1:11" />gei dir avek, bavoinerin fun Shaphir,</para>
  <para style="q" vid="MIC 1:11">naket tsu shand;</para>
  <para style="q" vid="MIC 1:11">nisht aroisgein dervegt zich di bavoinerin fun Tsaanan</para>
  <para style="q" vid="MIC 1:11">a klog iz in beit-etsel;</para>
  <para style="q" vid="MIC 1:11">me nemt fun aich op zain bashtand.<verse eid="MIC 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 1:12" />yo, geangst noch guts hot di bavoinerin fun Marot,</para>
  <para style="q" vid="MIC 1:12">ober genidert hot beiz fun Hashem tsum toier fun Yerushalayim.<verse eid="MIC 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 1:13" />shpan dem raitvogn tsu di loifferd,</para>
  <para style="q" vid="MIC 1:13">bavoinerin fun Lachish;</para>
  <para style="q" vid="MIC 1:13">zi iz der onheib zind geven far der tochter Tsiyon;</para>
  <para style="q" vid="MIC 1:13">vorem bai dir zainen gefunen gevorn</para>
  <para style="q" vid="MIC 1:13">di farbrechn fun Yisroel.<verse eid="MIC 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 1:14" />derum vestu gezeng-matonus gebn tsu Moreshet-Gat;</para>
  <para style="q" vid="MIC 1:14">di haizer fun Achziv veln vern tsum opnar</para>
  <para style="q" vid="MIC 1:14">far di mlochim fun Yisroel.<verse eid="MIC 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 1:15" />ich vel noch brengen a yoiresh oif dir,</para>
  <para style="q" vid="MIC 1:15">bavoinerin fun Mareshah,</para>
  <para style="q" vid="MIC 1:15">biz kein Adulam vet kumen der koved fun Yisroel.<verse eid="MIC 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 1:16" />mach dir a plich un sher dich op,</para>
  <para style="q" vid="MIC 1:16">iber daine getsertlte kinder,</para>
  <para style="q" vid="MIC 1:16">mach breit dain plich vi der geyerfoigl,</para>
  <para style="q" vid="MIC 1:16">vorem zei zainen in goles avek fun dir.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="MIC 2" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 2:1" />vei tsu di vos trachtn umrecht,</para>
  <para style="q" vid="MIC 2:1">un arbeten ois beiz oif zeyere gelegers!</para>
  <para style="q" vid="MIC 2:1">in licht fun frimorgn firn zei es ois,</para>
  <para style="q" vid="MIC 2:1">vail es iz in der macht fun zeyer hant.<verse eid="MIC 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 2:2" />un zei glustn felder un gazlen,</para>
  <para style="q" vid="MIC 2:2">un haizer un nemen tsu;</para>
  <para style="q" vid="MIC 2:2">un baroibn a man mit zain hoiz,</para>
  <para style="q" vid="MIC 2:2">un a mentshn mit zain nachle.<verse eid="MIC 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 2:3" />derum hot Hashem azoi gezogt:</para>
  <para style="q" vid="MIC 2:3">ze, ich tracht oif der doziker mishpoche a beiz</para>
  <para style="q" vid="MIC 2:3">vos ir vet nisht kenen opton derfun aiere heldzer,</para>
  <para style="q" vid="MIC 2:3">un ir vet nisht gein mit an oifgehoibenem kop,</para>
  <para style="q" vid="MIC 2:3">vorem a beize tsait vet dos zain.<verse eid="MIC 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 2:4" />in yenem tog vet men oifheibn oif aich a shpruch,</para>
  <para style="q" vid="MIC 2:4">un me vet klogn a klog fun baklogenish,</para>
  <para style="q" vid="MIC 2:4">me vet zogn: farvistn farvist zainen mir gevorn;</para>
  <para style="q" vid="MIC 2:4">dem teil fun main folk tut er baitn.</para>
  <para style="q" vid="MIC 2:4">vi tut er mich dervaitern!</para>
  <para style="q" vid="MIC 2:4">dem avekroiber tseteilt er undzere felder.<verse eid="MIC 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 2:5" />far vor, keiner fun dir vet nisht vorfn</para>
  <para style="q" vid="MIC 2:5">a shnur loit goirl in der eide fun Hashem.<verse eid="MIC 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MIC 2:6" />ir zolt nisht darshen! darshen zei;</para>
  <para style="q" vid="MIC 2:6">me darf nisht darshen tsu di dozike,</para>
  <para style="q" vid="MIC 2:6">vet men kein charpus nisht krign.<verse eid="MIC 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 2:7" />tu ich zich den baitn, hoiz fun Yaakov?</para>
  <para style="q" vid="MIC 2:7">tsi iz kurts gevorn dos ruach fun Hashem?</para>
  <para style="q" vid="MIC 2:7">zainen dos zaine tuungen?</para>
  <para style="q" vid="MIC 2:7">tuen nisht maine verter guts mit dem vos geit glaich?<verse eid="MIC 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 2:8" />ober main folk fun anustn shtelt zich oif far a faint;</para>
  <para style="q" vid="MIC 2:8">fun dem vos kumt antkegen tsit ir kleid un mantl arop,</para>
  <para style="q" vid="MIC 2:8">fun ruike durchgeyer, opgeneigte fun milchome.<verse eid="MIC 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 2:9" />di vaiber fun main folk fartraibt ir fun zeyer nechtdiker heim;</para>
  <para style="q" vid="MIC 2:9">fun zeyere eofelech nemt ir avek main tsirung oif eibik.<verse eid="MIC 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 2:10" />shteit oif un geit,</para>
  <para style="q" vid="MIC 2:10">vorem nishto do kein ruung,</para>
  <para style="q" vid="MIC 2:10">fun vegen der tume vos tseshtert, un a shtarke tseshterung.<verse eid="MIC 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 2:11" />az a man vos geit um mit vint un lign, zol felshn:</para>
  <para style="q" vid="MIC 2:11">ich vel dir darshen fun vain un fun trunk,</para>
  <para style="q" vid="MIC 2:11">volt er vern a darshan bai dem dozikn folk.<verse eid="MIC 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 2:12" />zamlen ainzamlen vel ich dich, Yaakov, in gantsn,</para>
  <para style="q" vid="MIC 2:12">klaibn oifklaibn vel ich dem iberblaib fun Yisroel.</para>
  <para style="q" vid="MIC 2:12">ich vel zei tsunoifton in einem vi shof in geheft,</para>
  <para style="q" vid="MIC 2:12">vi a stade in ir fiterplats;</para>
  <para style="q" vid="MIC 2:12">zei veln roishn mit mentshn.<verse eid="MIC 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 2:13" />der durchbrecher geit aroif zei farois,</para>
  <para style="q" vid="MIC 2:13">zei brechn durch un geyen vaiter,</para>
  <para style="q" vid="MIC 2:13">durch dem toier un arois durch im,</para>
  <para style="q" vid="MIC 2:13">un zeyer melech geit zei farois,</para>
  <para style="q" vid="MIC 2:13">un Hashem iz zeyer onfirer.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="MIC 3" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 3:1" />un ich hob gezogt:</para>
  <para style="q" vid="MIC 3:1">hert akorsht tsu, ir kep fun Yaakov,</para>
  <para style="q" vid="MIC 3:1">un harn fun hoiz fun Yisroel;</para>
  <para style="q" vid="MIC 3:1">ligt nisht oif aich tsu visen gerechtikeit?<verse eid="MIC 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 3:2" />ir vos hot faint guts un hot lib shlechts,</para>
  <para style="q" vid="MIC 3:2">vos gazlt zeyer hoit fun zei,</para>
  <para style="q" vid="MIC 3:2">un zeyer fleish fun zeyere beiner;<verse eid="MIC 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 3:3" />un vos hot gegesn dos fleish fun main folk,</para>
  <para style="q" vid="MIC 3:3">un zeyer hoit fun zei opgeshundn,</para>
  <para style="q" vid="MIC 3:3">un zeyere beiner tsebrochn,</para>
  <para style="q" vid="MIC 3:3">un tsehakt azoi vi in a top,</para>
  <para style="q" vid="MIC 3:3">un vi fleish in a kesl.<verse eid="MIC 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 3:4" />derum veln zei shraien tsu Hashem,</para>
  <para style="q" vid="MIC 3:4">un er vet zei nisht entfern;</para>
  <para style="q" vid="MIC 3:4">un er vet farborgen zain ponem fun zei in yener tsait,</para>
  <para style="q" vid="MIC 3:4">azoi vi zei hobn shlechts geton in zeyere meisim.<verse eid="MIC 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="MIC 3:5" />azoi hot Hashem gezogt oif di neviim vos farfiren main folk,</para>
  <para style="q" vid="MIC 3:5">vos shraien: sholem! ven zeyere tsein hobn tsu baisn,</para>
  <para style="q" vid="MIC 3:5">un der vos git zei nisht in moil</para>
  <para style="q" vid="MIC 3:5">breitn zei on oif im a milchome.<verse eid="MIC 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 3:6" />derum vet aich zain nacht, on a zeung,</para>
  <para style="q" vid="MIC 3:6">un aich vet zain fintster, on vorzogen,</para>
  <para style="q" vid="MIC 3:6">un untergein vet di zun oif di neviim,</para>
  <para style="q" vid="MIC 3:6">un shvarts vern vet der tog oif zei.<verse eid="MIC 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 3:7" />un di zeer veln zain tsu shand,</para>
  <para style="q" vid="MIC 3:7">un di vorzoger veln zich shemen,</para>
  <para style="q" vid="MIC 3:7">un zei veln ale fardekn zeyere oibershte lip,</para>
  <para style="q" vid="MIC 3:7">vail kein entfer fun Elokim vet nisht zain.<verse eid="MIC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 3:8" />ober far vor, ich bin ful</para>
  <para style="q" vid="MIC 3:8">mit koiech durch dem gaist fun Hashem,</para>
  <para style="q" vid="MIC 3:8">un mit gerechtikeit un gevure,</para>
  <para style="q" vid="MIC 3:8">tsu zogn Yaakovn zain farbrech,</para>
  <para style="q" vid="MIC 3:8">un Yisroeln zain zind.<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="MIC 3:9" />hert dos tsu akorsht, ir kep fun dem hoiz fun Yaakov,</para>
  <para style="q" vid="MIC 3:9">un harn fun hoiz fun Yisroel,</para>
  <para style="q" vid="MIC 3:9">vos farumverdikt gerechtikeit,</para>
  <para style="q" vid="MIC 3:9">un fardreit alts vos iz glaich;<verse eid="MIC 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 3:10" />me boit Tsiyon mit blut,</para>
  <para style="q" vid="MIC 3:10">un Yerushalayim mit umrecht.<verse eid="MIC 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 3:11" />ire kep mishpetn far shochad,</para>
  <para style="q" vid="MIC 3:11">un ire koyanim lernen far getsolt,</para>
  <para style="q" vid="MIC 3:11">un ire neviim vorzogen far gelt.</para>
  <para style="q" vid="MIC 3:11">un zei lenen zich oif Hashem, azoi tsu zogn:</para>
  <para style="q" vid="MIC 3:11">far vor, Hashem iz tsvishn undz,</para>
  <para style="q" vid="MIC 3:11">oif undz vet nisht kumen kein beiz.<verse eid="MIC 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 3:12" />derum vet iber aich Tsiyon vi a feld tseakert vern,</para>
  <para style="q" vid="MIC 3:12">un Yerushalayim vet vern hoifns,</para>
  <para style="q" vid="MIC 3:12">un der barg fun Hashems hoiz – valdike heichn.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="MIC 4" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 4:1" />un es vet zain in sof fun di teg,</para>
  <para style="q" vid="MIC 4:1">vet shtein fest der barg fun Hashems hoiz,</para>
  <para style="q" vid="MIC 4:1">oibnon fun di berg,</para>
  <para style="q" vid="MIC 4:1">un er vet zain derhoibn iber di heichn;</para>
  <para style="q" vid="MIC 4:1">un umes veln tsu im shtromen.<verse eid="MIC 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 4:2" />un fil felker veln gein un veln zogn:</para>
  <para style="q" vid="MIC 4:2">kumt un lomir aroifgein tsum barg fun Hashem,</para>
  <para style="q" vid="MIC 4:2">un tsum hoiz fun Elokei Yaakov,</para>
  <para style="q" vid="MIC 4:2">un er vet undz lernen fun zaine vegen,</para>
  <para style="q" vid="MIC 4:2">un mir veln gein in zaine shtegn;</para>
  <para style="q" vid="MIC 4:2">vorem fun Tsiyon vet aroisgein a toyre,</para>
  <para style="q" vid="MIC 4:2">un Hashems vort fun Yerushalayim.<verse eid="MIC 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 4:3" />un er vet mishpetn tsvishn fil umes,</para>
  <para style="q" vid="MIC 4:3">un antsheiden iber machtike felker biz in der vait;</para>
  <para style="q" vid="MIC 4:3">un zei veln ibershmidn zeyere shverdn oif akeraizns,</para>
  <para style="q" vid="MIC 4:3">un zeyere shpizn oif tsvaigmesers;</para>
  <para style="q" vid="MIC 4:3">a folk kegen a folk vet nisht heibn a shverd,</para>
  <para style="q" vid="MIC 4:3">un me vet nisht mer lernen milchome.<verse eid="MIC 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 4:4" />un zei veln zitsn itlecher</para>
  <para style="q" vid="MIC 4:4">unter zain vainshtok un unter zain faignboim,</para>
  <para style="q" vid="MIC 4:4">un keiner vet nisht shrekn;</para>
  <para style="q" vid="MIC 4:4">vorem dos moil fun Hashem Tseva'ot hot geredt.<verse eid="MIC 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 4:5" />vorem ale felker megn gein</para>
  <para style="q" vid="MIC 4:5">itlecher in nomen fun zain G-t,</para>
  <para style="q" vid="MIC 4:5">ober mir veln gein in nomen fun Hashem</para>
  <para style="q" vid="MIC 4:5">Elokeinu oif eibik un shtendik.<verse eid="MIC 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MIC 4:6" />in yenem tog, zogt Hashem,</para>
  <para style="q" vid="MIC 4:6">vel ich ainzamlen di vos hinkt,</para>
  <para style="q" vid="MIC 4:6">un tsunoifklaibn di vos iz farshtoisen,</para>
  <para style="q" vid="MIC 4:6">un di vemen ich hob shlechts geton.<verse eid="MIC 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 4:7" />un ich vel machn di hinkedike far an iberblaib,</para>
  <para style="q" vid="MIC 4:7">un di dervaiterte far a machtikn folk,</para>
  <para style="q" vid="MIC 4:7">un Hashem vet kinign iber zei oifn barg Tsiyon</para>
  <para style="q" vid="MIC 4:7">fun atsund un biz eibik.<verse eid="MIC 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="MIC 4:8" />un du Migdal-Eder, festungbarg fun tochter Tsiyon,</para>
  <para style="q" vid="MIC 4:8">tsu dir vet es onkumen;</para>
  <para style="q" vid="MIC 4:8">yo, kumen vet di frierdike memshole,</para>
  <para style="q" vid="MIC 4:8">di meluche fun tochter Yerushalayim.<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="MIC 4:9" />atsund noch vos shraistu mit geshreyen?</para>
  <para style="q" vid="MIC 4:9">iz kein melech nishto in dir,</para>
  <para style="q" vid="MIC 4:9">iz dain baal-yoets untergegangen,</para>
  <para style="q" vid="MIC 4:9">vos veyenish hot dich ongenumen vi a gevinerin?<verse eid="MIC 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 4:10" />drai zich un hob veyen, tochter Tsiyon,</para>
  <para style="q" vid="MIC 4:10">azoi vi a gevinerin,</para>
  <para style="q" vid="MIC 4:10">vorem atsund vestu aroisgein fun der shtot,</para>
  <para style="q" vid="MIC 4:10">un vest voinen in feld,</para>
  <para style="q" vid="MIC 4:10">un vest kumen kein Bavel;</para>
  <para style="q" vid="MIC 4:10">dortn vestu nitsl vern,</para>
  <para style="q" vid="MIC 4:10">dortn vet dich oisleizen Hashem</para>
  <para style="q" vid="MIC 4:10">fun der hant fun daine faint.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="MIC 4:11" />un atsund hobn zich aingezamlt oif dir fil felker,</para>
  <para style="q" vid="MIC 4:11">vos zogn: zol zi farshvecht vern,</para>
  <para style="q" vid="MIC 4:11">un zol undzer oig zich onkukn oif Tsiyon.<verse eid="MIC 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 4:12" />ober zei veisn nisht di trachtungen fun Hashem,</para>
  <para style="q" vid="MIC 4:12">un zei farshteyen nisht zain barot,</para>
  <para style="q" vid="MIC 4:12">az er hot zei aingezamlt vi a garb in dresh-shaier.<verse eid="MIC 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 4:13" />shtei oif un dresh, tochter Tsiyon,</para>
  <para style="q" vid="MIC 4:13">vorem dain horn vel ich machn aizn,</para>
  <para style="q" vid="MIC 4:13">un daine kloien vel ich machn kuper,</para>
  <para style="q" vid="MIC 4:13">un vest tseshtoisn fil felker,</para>
  <para style="q" vid="MIC 4:13">un machn cheirem tsu Hashem zeyer roib,</para>
  <para style="q" vid="MIC 4:13">un zeyer farmeg tsum har fun der gantser erd.<verse eid="MIC 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" pubnumber="5.1" sid="MIC 4:14" /> itst zamlt aich ain daine chilut, o du tochter fun chilut,</para>
  <para style="q" vid="MIC 4:14">men hot a balagerung iber undz gemacht,</para>
  <para style="q" vid="MIC 4:14">zei veln dem shoifet fun ysrl</para>
  <para style="q" vid="MIC 4:14">shlogn oif di bakn mit a rut.<verse eid="MIC 4:14" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="MIC 5" />
  <para style="q">
    <verse number="1" style="v" pubnumber="5.2" sid="MIC 5:1" /> un du, Beis-Lechem in Efratah,</para>
  <para style="q" vid="MIC 5:1">vos klein bistu tsvishn di toizntn fun Yehudah,</para>
  <para style="q" vid="MIC 5:1">fun dir vet mir aroisgein</para>
  <para style="q" vid="MIC 5:1">der vos vet zain a geveltiker iber Yisroel,</para>
  <para style="q" vid="MIC 5:1">un zain opshtam iz fun eibik,</para>
  <para style="q" vid="MIC 5:1">fun di teg fun eibikeit.<verse eid="MIC 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="5.3" sid="MIC 5:2" /> far vor, er vet zei ibergebn tsu zeyere faint</para>
  <para style="q" vid="MIC 5:2">biz der tsait in ir yoledah ven di froi geburt;</para>
  <para style="q" vid="MIC 5:2">ober der iberblaib fun zaine brider</para>
  <para style="q" vid="MIC 5:2">vet zich umkeren mit di kinder fun Yisroel.<verse eid="MIC 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="4" sid="MIC 5:3" /> un er vet oifshtein un fitern mit macht fun Hashem,</para>
  <para style="q" vid="MIC 5:3">mitn nomen fun maiestet fun Hashem zain G-t;</para>
  <para style="q" vid="MIC 5:3">un zei veln zitsn ruik,</para>
  <para style="q" vid="MIC 5:3">vorem er vet dentsmol zain grois biz di ekn fun der erd.<verse eid="MIC 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="5" sid="MIC 5:4" /> un aza vet zain der sholem:</para>
  <para style="q" vid="MIC 5:4">az Ashur vet kumen in undzer land,</para>
  <para style="q" vid="MIC 5:4">un az er vet tretn in undzere palatsn,</para>
  <para style="q" vid="MIC 5:4">veln mir oifshteln oif im zibn pastucher,</para>
  <para style="q" vid="MIC 5:4">un acht firshtleche lait.<verse eid="MIC 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="6" sid="MIC 5:5" /> un zei veln tsebrechn dos land Ashur mitn shverd,</para>
  <para style="q" vid="MIC 5:5">un land Nimrod mit ire eigene klingen.</para>
  <para style="q" vid="MIC 5:5">un me vet undz matsl zain fun Ashur,</para>
  <para style="q" vid="MIC 5:5">az er vet kumen in undzer land,</para>
  <para style="q" vid="MIC 5:5">un az er vet tretn in undzer gvul.<verse eid="MIC 5:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="7" sid="MIC 5:6" /> un der iberblaib fun Yaakov vet zain tsvishn di fil umes,</para>
  <para style="q" vid="MIC 5:6">vi toi fun Hashem, vi shpreiregn oif groz,</para>
  <para style="q" vid="MIC 5:6">vos hoft nisht oif a mentshn,</para>
  <para style="q" vid="MIC 5:6">un vort nisht oif mentshnkinder.<verse eid="MIC 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="8" sid="MIC 5:7" /> un der iberblaib fun Yaakov vet zain tsvishn di felker,</para>
  <para style="q" vid="MIC 5:7">in mitn fun di fil umes,</para>
  <para style="q" vid="MIC 5:7">vi a leib tsvishn di chayes fun vald,</para>
  <para style="q" vid="MIC 5:7">vi a yungleib tsvishn stades shof,</para>
  <para style="q" vid="MIC 5:7">vos az er geit durch tsetret er un fartsukt,</para>
  <para style="q" vid="MIC 5:7">un nishto ver zol matsl zain.<verse eid="MIC 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="9" sid="MIC 5:8" /> dain hant vet zain derhoibn iber daine driker,</para>
  <para style="q" vid="MIC 5:8">un ale daine faint veln farshnitn vern.<verse eid="MIC 5:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="10" sid="MIC 5:9" /> un es vet zain in yenem tog, zogt Hashem,</para>
  <para style="q" vid="MIC 5:9">vel ich farshnaidn daine ferd fun tsvishn dir,</para>
  <para style="q" vid="MIC 5:9">un ich vel unterbrengen daine raitvegn.<verse eid="MIC 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="11" sid="MIC 5:10" /> un ich vel farshnaidn di shtet fun dain land,</para>
  <para style="q" vid="MIC 5:10">un tseshtern ale daine festungen.<verse eid="MIC 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="12" sid="MIC 5:11" /> un ich vel farshnaidn di kishefn, fun dain hant,</para>
  <para style="q" vid="MIC 5:11">un bai dir veln nisht zain kein vorzogers.<verse eid="MIC 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="13" sid="MIC 5:12" /> un ich vel farshnaidn daine geshnitste getsn</para>
  <para style="q" vid="MIC 5:12">un daine zailshteiner fun tsvishn dir,</para>
  <para style="q" vid="MIC 5:12">un vest zich mer nisht bukn tsum verk fun daine hent.<verse eid="MIC 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="14" sid="MIC 5:13" /> un ich vel oisraisn daine getsnbeimer fun tsvishn dir;</para>
  <para style="q" vid="MIC 5:13">un ich vel fartiliken daine faint.<verse eid="MIC 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="15" sid="MIC 5:14" /> un ich vel nekome nemen</para>
  <para style="q" vid="MIC 5:14">mit kaas un mit grimtsorn</para>
  <para style="q" vid="MIC 5:14">fun di felker vos hobn nisht tsugehert.<verse eid="MIC 5:14" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="MIC 6" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 6:1" />hert akorsht tsu vos Hashem zogt:</para>
  <para style="q" vid="MIC 6:1">shtei oif, taine far di berg,</para>
  <para style="q" vid="MIC 6:1">un zoln hern di heichn dain kol.<verse eid="MIC 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 6:2" />hert tsu, ir berg, dem krig fun Hashem,</para>
  <para style="q" vid="MIC 6:2">un ir machtike, di gruntfestn fun der erd;</para>
  <para style="q" vid="MIC 6:2">vorem Hashem hot a krig mit zain folk,</para>
  <para style="q" vid="MIC 6:2">un mit Yisroel vet er a vikuech hobn.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="MIC 6:3" />main folk, vos hob ich dir geton?</para>
  <para style="q" vid="MIC 6:3">un mit vos hob ich dich mid gemacht?</para>
  <para style="q" vid="MIC 6:3">zog eides akegn mir.<verse eid="MIC 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 6:4" />vorem ich hob dich oifgebracht fun land Mitsrayim,</para>
  <para style="q" vid="MIC 6:4">un fun dem hoiz fun knechtshaft dich oisgeleizt,</para>
  <para style="q" vid="MIC 6:4">un dir farois geshikt Mosheen, Aharonen, un Miryamen.<verse eid="MIC 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 6:5" />main folk, dermon zich akorsht</para>
  <para style="q" vid="MIC 6:5">vos Balak der melech fun Moav hot barotn,</para>
  <para style="q" vid="MIC 6:5">un vos im hot geentfert Bilaam der zun fun Beoren;</para>
  <para style="q" vid="MIC 6:5">vos ich hob geton fun Shitim biz Gilgal,</para>
  <para style="q" vid="MIC 6:5">kedei me zol visen di gerechtikeit fun Hashem.<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MIC 6:6" />mit vos zol ich kumen far Hashem,</para>
  <para style="q" vid="MIC 6:6">un mich beigen far dem ale hechstn Elokim?</para>
  <para style="q" vid="MIC 6:6">zol ich kumen far im mit brandopfer,</para>
  <para style="q" vid="MIC 6:6">mit kelber einiorike?<verse eid="MIC 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 6:7" />vet Hashem bavilikn toizntn viders,</para>
  <para style="q" vid="MIC 6:7">tsen toizntn taichn mit eil?</para>
  <para style="q" vid="MIC 6:7">zol ich gebn main bechor far main farbrech,</para>
  <para style="q" vid="MIC 6:7">di frucht fun main laib far der zind fun main zel?<verse eid="MIC 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 6:8" />me hot dir ongezogt, mentsh, vos iz gut,</para>
  <para style="q" vid="MIC 6:8">un vos Hashem farlangt fun dir:</para>
  <para style="q" vid="MIC 6:8">nor bloiz ton gerechtikeit un lib hobn genod,</para>
  <para style="q" vid="MIC 6:8">un umgein shtil far dain G-t.<verse eid="MIC 6:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="MIC 6:9" />horch! Hashem ruft tsu der shtot –</para>
  <para style="q" vid="MIC 6:9">un der kluger vet achten oif dain nomen –</para>
  <para style="q" vid="MIC 6:9">hert dem shtekn, un ver dos hot bashert.<verse eid="MIC 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 6:10" />ken ich nochanand fargesen dos hoiz fun dem umgerechtn,</para>
  <para style="q" vid="MIC 6:10">di shatsn fun umrecht un di karge mos di farsholtene?<verse eid="MIC 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 6:11" />ken ich rein machn far umgerechte vogsholn,</para>
  <para style="q" vid="MIC 6:11">un far a baitl mit falshe vogshteiner?<verse eid="MIC 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 6:12" />vorem ire raiche lait zainen ful mit roib,</para>
  <para style="q" vid="MIC 6:12">un ire bavoiner redn falsh,</para>
  <para style="q" vid="MIC 6:12">un zeyer tsung iz batrug in zeyer moil.<verse eid="MIC 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 6:13" />derum hob ich oich dich geshlogn biz krank,</para>
  <para style="q" vid="MIC 6:13">dich farvist far daine zind.<verse eid="MIC 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 6:14" />du vest esen un nisht zat vern,</para>
  <para style="q" vid="MIC 6:14">un dain hunger vet zain in daine ingeveid;</para>
  <para style="q" vid="MIC 6:14">un vest trogedik vern, un nisht gevinen,</para>
  <para style="q" vid="MIC 6:14">un vos du vest gevinen vel ich tsum shverd ibergebn.<verse eid="MIC 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 6:15" />du vest zeyen, un nisht shnaidn,</para>
  <para style="q" vid="MIC 6:15">du vest tretn eilbertn, un zich nisht zalbn mit eil,</para>
  <para style="q" vid="MIC 6:15">un troibnzaft, un nisht trinken kein vain.<verse eid="MIC 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 6:16" />vail opgehit vern di minhogim fun Omrien,</para>
  <para style="q" vid="MIC 6:16">un al di tuenish fun Achavs hoiz,</para>
  <para style="q" vid="MIC 6:16">un ir zait gegangen in zeyere etsut;</para>
  <para style="q" vid="MIC 6:16">derum vel ich dich machn far a shrek,</para>
  <para style="q" vid="MIC 6:16">un ire bavoiner far a shmutserung;</para>
  <para style="q" vid="MIC 6:16">un di shand fun main folk vet ir trogn.<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="MIC 7" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 7:1" />vei mir, vos ich bin vi baim nochzaml fun zumer,</para>
  <para style="q" vid="MIC 7:1">vi baim nochklaib fun der lez!</para>
  <para style="q" vid="MIC 7:1">nishto a hengl tsum esen,</para>
  <para style="q" vid="MIC 7:1">an ershtfrucht vos main zel gelust.<verse eid="MIC 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 7:2" />untergegangen iz der frumer fun land,</para>
  <para style="q" vid="MIC 7:2">un kein rechtfartiker tsvishn mentshn iz nishto;</para>
  <para style="q" vid="MIC 7:2">ale loiern zei oif blut,</para>
  <para style="q" vid="MIC 7:2">einer dem andern fangen zei in nets.<verse eid="MIC 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 7:3" />oif shlechts ton zainen di hent vos darfn guts ton;</para>
  <para style="q" vid="MIC 7:3">der srorh farlangt, un der richter iz far batsolt,</para>
  <para style="q" vid="MIC 7:3">un der grusier man, er redt di gerikeit fun zain zel;</para>
  <para style="q" vid="MIC 7:3">azoi hobn zei es fardreit.<verse eid="MIC 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 7:4" />der bester fun zei iz vi a dorn,</para>
  <para style="q" vid="MIC 7:4">der rechtfartiker, erger fun a shtechiker tsam.</para>
  <para style="q" vid="MIC 7:4">der tog fun daine zeer, dain rechnshaft, iz gekumen;</para>
  <para style="q" vid="MIC 7:4">atsund vet geshen zeyer tsetumlenish.<verse eid="MIC 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 7:5" />zolt ir nisht gloibn in a chever,</para>
  <para style="q" vid="MIC 7:5">zolt ir aich nisht farzichern oif a gutn fraint;</para>
  <para style="q" vid="MIC 7:5">fun der vos ligt in dain buzem,</para>
  <para style="q" vid="MIC 7:5">hit di tirn fun dain moil.<verse eid="MIC 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 7:6" />vorem a zun banavlt a foter,</para>
  <para style="q" vid="MIC 7:6">a tochter shtelt zich kegen ir muter,</para>
  <para style="q" vid="MIC 7:6">a shnur kegen ir shviger,</para>
  <para style="q" vid="MIC 7:6">di sonem fun a mentshn zainen zaine hoizlait.<verse eid="MIC 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 7:7" />ober ich kuk ois oif Hashem,</para>
  <para style="q" vid="MIC 7:7">ich har tsum Hashem fun main hilf,</para>
  <para style="q" vid="MIC 7:7">main G-t vet mich tsuhern.<verse eid="MIC 7:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="MIC 7:8" />nisht freyen zolstu zich oif mir, main sonte,</para>
  <para style="q" vid="MIC 7:8">az ich bin gefaln, vel ich oifshtein,</para>
  <para style="q" vid="MIC 7:8">az ich zits in fintsternish, iz Hashem mir a licht.<verse eid="MIC 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 7:9" />dem tsorn fun Hashem vel ich trogn,</para>
  <para style="q" vid="MIC 7:9">vorem ich hob gezindikt tsu im;</para>
  <para style="q" vid="MIC 7:9">biz er vet krign main krig,</para>
  <para style="q" vid="MIC 7:9">un vet ton main recht;</para>
  <para style="q" vid="MIC 7:9">er vet mich aroisfirn in lichtikeit,</para>
  <para style="q" vid="MIC 7:9">ich vel zen zain gerechtikeit.<verse eid="MIC 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 7:10" />un main sonte vet zen, un a bushe vet zi badekn,</para>
  <para style="q" vid="MIC 7:10">di vos zogt tsu mir: vu iz er, Hashem dain G-t?</para>
  <para style="q" vid="MIC 7:10">maine oign veln zich onzen oif ir;</para>
  <para style="q" vid="MIC 7:10">atsund vet zi tsetrotn vern vi koit fun di gasn.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="MIC 7:11" />a tog vet zain tsu boien daine moiern,</para>
  <para style="q" vid="MIC 7:11">meg yener tog zain zeyer vait.<verse eid="MIC 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 7:12" />a tog vet dos zain ven me vet kumen tsu dir,</para>
  <para style="q" vid="MIC 7:12">fun Ashur un di shtet fun Mitsrayim,</para>
  <para style="q" vid="MIC 7:12">un fun Mitsrayim un bizn taich,</para>
  <para style="q" vid="MIC 7:12">un fun yam biz yam, un fun barg biz barg.<verse eid="MIC 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 7:13" />un di erd vet zain vist far ire bavoiner,</para>
  <para style="q" vid="MIC 7:13">fun vegen dem frucht fun zeyere meisim.<verse eid="MIC 7:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="MIC 7:14" />fiter dain folk mit dain rut,</para>
  <para style="q" vid="MIC 7:14">di shof fun dain arav,</para>
  <para style="q" vid="MIC 7:14">vos voinen bazunder a vald in mitn Karmel;</para>
  <para style="q" vid="MIC 7:14">lozn zei zich fitern in Bashan un Gilad,</para>
  <para style="q" vid="MIC 7:14">vi in di teg fun amol.<verse eid="MIC 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 7:15" />vi in di teg fun dain aroisgein fun land Mitsrayim,</para>
  <para style="q" vid="MIC 7:15">vel ich im vunder bavaizn.<verse eid="MIC 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 7:16" />felker veln zen un zich shemen mit al zeyer gevure,</para>
  <para style="q" vid="MIC 7:16">zei veln aroifton di hant oifn moil,</para>
  <para style="q" vid="MIC 7:16">zeyere oiern veln toib vern.<verse eid="MIC 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MIC 7:17" />zei veln lekn dem shtoib vi a shlang,</para>
  <para style="q" vid="MIC 7:17">vi di vos krichn oif der erd;</para>
  <para style="q" vid="MIC 7:17">zei veln tsiteren fun zeyere festungen,</para>
  <para style="q" vid="MIC 7:17">tsu Hashem Elokeinu veln zei angstn,</para>
  <para style="q" vid="MIC 7:17">un zei veln moire hobn far dir.<verse eid="MIC 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MIC 7:18" />ver iz an El vi du, vos fargit zind,</para>
  <para style="q" vid="MIC 7:18">un geit farbai dem farbrech fun dem iberblaib fun zain arav?</para>
  <para style="q" vid="MIC 7:18">er halt nisht oif eibik zain tsorn,</para>
  <para style="q" vid="MIC 7:18">vorem er hot lib genod.<verse eid="MIC 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MIC 7:19" />er vet undz vider derbaremen,</para>
  <para style="q" vid="MIC 7:19">er vet fardrikn undzere zind;</para>
  <para style="q" vid="MIC 7:19">un vest arainvarfen in di tifenishn fun yam</para>
  <para style="q" vid="MIC 7:19">ale zeyere chatoim.<verse eid="MIC 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MIC 7:20" />vest vaizn traishaft tsu Yaakovn,</para>
  <para style="q" vid="MIC 7:20">chesed tsu Avrahamen,</para>
  <para style="q" vid="MIC 7:20">vi du host geshvorn undzere eltern</para>
  <para style="q" vid="MIC 7:20">fun di teg fun fartsaitn.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>