<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JER" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Yirmeyah</para>
  <para style="toc2">Yirmeyah</para>
  <para style="toc1">Yirmeyah</para>
  <para style="mt1">Yirmeyah</para>
  <chapter number="1" style="c" pubnumber="א" sid="JER 1" />
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1" />di verter fun Yirmeyah dem zun fun Chilkiyahun, fun di koyanim vos in Anatot in land Binyamin, <verse eid="JER 1:1" /><verse number="2" style="v" sid="JER 1:2" />vos dos vort fun Hashem iz tsu im geven in di teg fun Yoshiyah, dem zun fun Amonen, dem melech fun Yehudah, in draitsntn yor fun zain meluche, <verse eid="JER 1:2" /><verse number="3" style="v" sid="JER 1:3" />un iz oich geven in di teg fun Yhoyakim dem zun fun Yoshiyahun, dem melech fun Yehudah, bizn sof fun elftn yor fun Tsidkiyah dem zun fun Yoshiyahun, dem melech fun Yehudah, biz dem goles fun Yerushalayim in finftn choidesh.<verse eid="JER 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4" />un dos vort fun Hashem iz geven tsu mir, azoi tsu zogn:<verse eid="JER 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JER 1:5" />eider ich hob dich in muterlaib gefuremt,</para>
  <para style="q" vid="JER 1:5">hob ich dir derkent,</para>
  <para style="q" vid="JER 1:5">un eider du bist fun tracht arois,</para>
  <para style="q" vid="JER 1:5">hob ich dich geheilikt;</para>
  <para style="q" vid="JER 1:5">a novi far di felker hob ich dich gemacht.<verse eid="JER 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="JER 1:6" />hob ich gezogt: vei, Hashem du Adonoi, ich ken doch nisht redn, vorem ich bin a yingel. <verse eid="JER 1:6" /><verse number="7" style="v" sid="JER 1:7" />hot Hashem tsu mir gezogt:</para>
  <para style="b" vid="JER 1:7" />
  <para style="q" vid="JER 1:7">zolst nisht zogn: ich bin a yingel,</para>
  <para style="q" vid="JER 1:7">naiert umetum vu ich vel dich shikn zolstu gein,</para>
  <para style="q" vid="JER 1:7">un alts vos ich vel dir bafeln zolstu redn.<verse eid="JER 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 1:8" />zolst nisht moire hobn far zei,</para>
  <para style="q" vid="JER 1:8">vorem ich bin mit dir, dich matsl tsu zain,</para>
  <para style="qr" vid="JER 1:8">zogt Hashem.<verse eid="JER 1:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9" />un Hashem hot oisgeshtrekt zain hant un tsugerirt, tsu main moil, un Hashem hot tsu mir gezogt:</para>
  <para style="b" vid="JER 1:9" />
  <para style="q" vid="JER 1:9">ot hob ich gegebn maine verter in dain moil;<verse eid="JER 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 1:10" />ze, ich, hob dich geshtelt haintikn tog</para>
  <para style="q" vid="JER 1:10">iber di felker un iber di kinigraichn,</para>
  <para style="q" vid="JER 1:10">oistsuraisn un aintsuvarfn,</para>
  <para style="q" vid="JER 1:10">un untertsubrengen un tsu tseshtern;</para>
  <para style="q" vid="JER 1:10">tsu boien un tsu flantsn.<verse eid="JER 1:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11" />un dos vort fun Hashem iz geven tsu mir, azoi tsu zogn: vos zestu, Yirmeyah? hob ich gezogt: a mandlshtok ze ich. <verse eid="JER 1:11" /><verse number="12" style="v" sid="JER 1:12" />hot Hashem tsu mir gezogt: host voil gezen, vorem ich pas-oif oif main vort es tsu ton.<verse eid="JER 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13" />un dos vort fun Hashem iz geven tsu mir a tsveit mol, azoi tsu zogn: vos zestu? hob ich gezogt: a zudikn top ze ich, un zain foderzait iz kegen tsofn. <verse eid="JER 1:13" /><verse number="14" style="v" sid="JER 1:14" />hot Hashem tsu mir gezogt: fun tsofn vet oisbrechn doch beiz oif ale bavoiner fun land. <verse eid="JER 1:14" /><verse number="15" style="v" sid="JER 1:15" />vorem ze, ich ruf tsu ale mishpoches fun di kinigraichn tsu tsofn, zogt Hashem, un zei veln kumen, un veln shteln itlecher zain tron baim aingang fun di toiern fun Yerushalayim, un kegen ale ire moiern rund arum, un kegen ale shtet fun Yehudah. <verse eid="JER 1:15" /><verse number="16" style="v" sid="JER 1:16" />un ich vel zei aroiszogn main mishpot far al zeyer shlechtikeit, vos zei hobn mich farlozen, un gereichert tsu fremde g‑ter, un zich gebukt tsu di verk fun zeyere hent. <verse eid="JER 1:16" /><verse number="17" style="v" sid="JER 1:17" />un du zolst ongurtn daine lendn, un zolst oifshtein un redn tsu zei alts vos ich vel dir bafeln; zolst zich nisht shrekn far zei, kedei ich zol dich nisht dershrekn far zei. <verse eid="JER 1:17" /><verse number="18" style="v" sid="JER 1:18" />vorem ze, ich hob dich haint gemacht far a bafestikter shtot, un far an aizernem zail, un far kuperne moiern akegn gantsn land, kegen di mlochim fun Yehudah, kegen ire harn, kegen ire koyanim, un kegen dem folk fun land. <verse eid="JER 1:18" /><verse number="19" style="v" sid="JER 1:19" />un zei veln milchome haltn akegn dir, un veln dich nisht baikumen, vorem ich bin mit dir, zogt Hashem, dich matsl tsu zain.<verse eid="JER 1:19" /></para>
  <chapter eid="JER 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="JER 2" />
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1" />un dos vort fun Hashem iz geven tsu mir, azoi tsu zogn:<verse eid="JER 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 2:2" />gei un zolst rufn in di oiern fun Yerushalayim, azoi tsu zogn: azoi hot Hashem gezogt:</para>
  <para style="b" vid="JER 2:2" />
  <para style="q" vid="JER 2:2">ich gedenk dir di gintsikeit fun dain yugnt,</para>
  <para style="q" vid="JER 2:2">di libshaft fun dain kale-tsait;</para>
  <para style="q" vid="JER 2:2">dain gein noch mir in der midber,</para>
  <para style="q" vid="JER 2:2">in a land nisht gezeit.<verse eid="JER 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 2:3" />heilik bai Hashem iz Yisroel,</para>
  <para style="q" vid="JER 2:3">dos ershte fun zain tvue;</para>
  <para style="q" vid="JER 2:3">ale zaine fartserer veln shuldik zain;</para>
  <para style="q" vid="JER 2:3">a beizenish vet kumen oif zei,</para>
  <para style="qr" vid="JER 2:3">zogt Hashem.<verse eid="JER 2:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="JER 2:4" />hert dos vort fun Hashem, ir hoiz fun Yaakov, un ale mishpoches fun hoiz fun Yisroel; <verse eid="JER 2:4" /><verse number="5" style="v" sid="JER 2:5" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="JER 2:5" />
  <para style="q" vid="JER 2:5">vos hobn aiere eltern in mir an avle gefunen,</para>
  <para style="q" vid="JER 2:5">vos zei hobn zich dervaitert fun mir,</para>
  <para style="q" vid="JER 2:5">un gegangen noch nisht un nishtik gevorn?<verse eid="JER 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 2:6" />un zei hobn nisht gezogt: vu iz Hashem</para>
  <para style="q" vid="JER 2:6">vos hot undz oifgebracht fun land Mitsrayim,</para>
  <para style="q" vid="JER 2:6">vos hot undz gefirt durchn midber,</para>
  <para style="q" vid="JER 2:6">durch a land fun vistenish un griber,</para>
  <para style="q" vid="JER 2:6">durch a land fun trikenish un toitshotn,</para>
  <para style="q" vid="JER 2:6">durch a land vos kein mentsh iz nisht durchgegangen derin,</para>
  <para style="q" vid="JER 2:6">un kein mutermentsh hot nisht gevoint dortn?<verse eid="JER 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 2:7" />un ich hob aich gebracht in a fruchtikn land,</para>
  <para style="q" vid="JER 2:7">tsu esen ir frucht un ir guts;</para>
  <para style="q" vid="JER 2:7">ober ir zait gekumen un hot farumreinikt main land,</para>
  <para style="q" vid="JER 2:7">un host gemacht main nachle far an umverdikeit.<verse eid="JER 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 2:8" />di koyanim hobn nisht gezogt: vu iz Hashem?</para>
  <para style="q" vid="JER 2:8">un di oifhalter fun der toyre hobn mich nisht gekent,</para>
  <para style="q" vid="JER 2:8">un di pastucher hobn gebrochn on mir,</para>
  <para style="q" vid="JER 2:8">un di neviim hobn nevies gezogt far Baal,</para>
  <para style="q" vid="JER 2:8">un noch di vos nutsn nisht, zainen zei gegangen.<verse eid="JER 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JER 2:9" />derum vel ich noch krign mit aich,</para>
  <para style="qr" vid="JER 2:9">zogt Hashem,</para>
  <para style="q" vid="JER 2:9">un mit aiere kinds-kinder vel krign.<verse eid="JER 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 2:10" />vorem fort durch di indzelen fun di Kittim, un zet,</para>
  <para style="q" vid="JER 2:10">un kein Kedar shikt, un kukt zich gut tsu,</para>
  <para style="q" vid="JER 2:10">un zet oib azoins iz geshen.<verse eid="JER 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 2:11" />hot den a folk farbaiten zaine g‑ter?</para>
  <para style="q" vid="JER 2:11">vos zei zainen kein g‑ter nisht;</para>
  <para style="q" vid="JER 2:11">un main folk hot farbaiten zain koved</para>
  <para style="q" vid="JER 2:11">oif vos nutst nisht.<verse eid="JER 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 2:12" />groilt ir himlen iber dem,</para>
  <para style="q" vid="JER 2:12">un shoidert, vert banumen biz gor,</para>
  <para style="qr" vid="JER 2:12">zogt Hashem.<verse eid="JER 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 2:13" />vorem a tsvaiedik beiz hot geton main folk:</para>
  <para style="q" vid="JER 2:13">zei hobn farlozen mich, dem kval fun lebedike vaser,</para>
  <para style="q" vid="JER 2:13">zich tsu hakn brunemer, tsebrochene brunemer,</para>
  <para style="q" vid="JER 2:13">vos kenen dos vaser nisht haltn.<verse eid="JER 2:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 2:14" />iz a knecht Yisroel?</para>
  <para style="q" vid="JER 2:14">tsi a hoizgeborener sheklaf iz er?</para>
  <para style="q" vid="JER 2:14">far vos iz er tsu roib gevorn?<verse eid="JER 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 2:15" />oif im briln di yungleibn, zei lozn arois zeyer kol,</para>
  <para style="q" vid="JER 2:15">un zei hobn gemacht zain land tsu vist;</para>
  <para style="q" vid="JER 2:15">zaine shtet zenen farvist gevorn, on a bavoiner.<verse eid="JER 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 2:16" />oich di zin fun Nof un Tachpanches</para>
  <para style="q" vid="JER 2:16">veln oif dain sharbn tsebrochn.<verse eid="JER 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 2:17" />far vor, dos hot dir ongemacht</para>
  <para style="q" vid="JER 2:17">vos du host farlozen Hashem dain G-t,</para>
  <para style="q" vid="JER 2:17">beeis er hot dich oifn veg gefirt.<verse eid="JER 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 2:18" />un atsundert vi kumstu oifn veg kein Mitsrayim,</para>
  <para style="q" vid="JER 2:18">tsu trinken dos vaser fun Shichor?</para>
  <para style="q" vid="JER 2:18">un vi kumstu oifn veg kein Ashur,</para>
  <para style="q" vid="JER 2:18">tsu trinken dos vaser fun taich?<verse eid="JER 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 2:19" />dain shlechtikeit vet dich onlernen,</para>
  <para style="q" vid="JER 2:19">un daine opkerungen veln dich shtrofn;</para>
  <para style="q" vid="JER 2:19">un veis un ze, az shlecht iz un biter</para>
  <para style="q" vid="JER 2:19">vos du host farlozen Hashem dain G-t,</para>
  <para style="q" vid="JER 2:19">un main moire iz nisht oif dir,</para>
  <para style="qr" vid="JER 2:19">zogt Adonoi Hashem Tseva'ot.<verse eid="JER 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JER 2:20" />vorem fun eibik on hob ich tsebrochn dain yoch,</para>
  <para style="q" vid="JER 2:20">tserisn daine bindshtrik,</para>
  <para style="q" vid="JER 2:20">un du host gezogt: ich vel nisht dinen;</para>
  <para style="q" vid="JER 2:20">ober oif yetveder hoichn bergel,</para>
  <para style="q" vid="JER 2:20">un unter yetveder tsvaighaftikn boim,</para>
  <para style="q" vid="JER 2:20">shtrekstu vi a zoine zich ois.<verse eid="JER 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 2:21" />un ich hob dich geflantst a voil vainritl,</para>
  <para style="q" vid="JER 2:21">loiter richtikn zomen;</para>
  <para style="q" vid="JER 2:21">un vi bistu mir farkert gevorn</para>
  <para style="q" vid="JER 2:21">in vil vuksn fun fremdn vainshtok!<verse eid="JER 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 2:22" />vorem, az du zolst zich vashn mit loig,</para>
  <para style="q" vid="JER 2:22">un zolst mern oif dir zeif,</para>
  <para style="q" vid="JER 2:22">iz geflekt dain zind far mir,</para>
  <para style="qr" vid="JER 2:22">zogt Adonoi Hashem.<verse eid="JER 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 2:23" />vi kenstu zogn: ich hob mich nisht farumreinikt,</para>
  <para style="q" vid="JER 2:23">noch di Baal-geter bin ich nisht gegangen?</para>
  <para style="q" vid="JER 2:23">ze dain firung in tal,</para>
  <para style="q" vid="JER 2:23">merk vos du host geton,</para>
  <para style="q" vid="JER 2:23">du flinke kemelin, vos fardreit ire vegen;<verse eid="JER 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 2:24" />a vilde eizelin tsum midber gevoint,</para>
  <para style="q" vid="JER 2:24">vos shlingt dem vint in der glustung fun ir zel;</para>
  <para style="q" vid="JER 2:24">fun ir porung ver ken zi ophaltn?</para>
  <para style="q" vid="JER 2:24">ale ire zucher darfn zich nisht ainmien,</para>
  <para style="q" vid="JER 2:24">in ir choidesh veln zei zi gefinen.<verse eid="JER 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 2:25" />farmaid dain fus fun borves zain,</para>
  <para style="q" vid="JER 2:25">un dain kel fun dorshtikeit;</para>
  <para style="q" vid="JER 2:25">ober du host gezogt: umzist, nein!</para>
  <para style="q" vid="JER 2:25">naiert fremde hob ich lib,</para>
  <para style="q" vid="JER 2:25">un noch zei vel ich gein.<verse eid="JER 2:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="JER 2:26" />vi di shand fun a ganev az er vert gefunen,</para>
  <para style="q" vid="JER 2:26">azoi iz tsu shand dos hoiz fun Yisroel,</para>
  <para style="q" vid="JER 2:26">zei, zeyere mlochim, zeyere harn,</para>
  <para style="q" vid="JER 2:26">un zeyere koyanim, un zeyere neviim.<verse eid="JER 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 2:27" />zei zogn tsu a holts: bist main foter!</para>
  <para style="q" vid="JER 2:27">un tsu a shtein: du host undz geborn!</para>
  <para style="q" vid="JER 2:27">vorem zei hobn gekert dem rukn tsu mir,</para>
  <para style="q" vid="JER 2:27">un nisht dem ponem;</para>
  <para style="q" vid="JER 2:27">nor in tsait fun zeyer umglik zogn zei:</para>
  <para style="q" vid="JER 2:27">shtei oif un helf undz.<verse eid="JER 2:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 2:28" />un vu zainen daine g‑ter</para>
  <para style="q" vid="JER 2:28">vos du host dir gemacht?</para>
  <para style="q" vid="JER 2:28">zoln zei oifshtein oib zei kenen dir helfn</para>
  <para style="q" vid="JER 2:28">in tsait fun dain umglik;</para>
  <para style="q" vid="JER 2:28">vorem azoi vi di tsol fun daine shtet,</para>
  <para style="q" vid="JER 2:28">zainen daine g‑ter, Yehudah.<verse eid="JER 2:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="JER 2:29" />far vos krigt ir oif mir?</para>
  <para style="q" vid="JER 2:29">ir ale hot vidergeshpenikn on mir,</para>
  <para style="qr" vid="JER 2:29">zogt Hashem.<verse eid="JER 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 2:30" />umzist hob ich geshlogn aiere kinder,</para>
  <para style="q" vid="JER 2:30">zei hobn kein musar nisht genumen;</para>
  <para style="q" vid="JER 2:30">aier shverd hot fartsert aiere neviim,</para>
  <para style="q" vid="JER 2:30">vi a merderisher leib.<verse eid="JER 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 2:31" />ir dor, zet dos vort fun Hashem:</para>
  <para style="q" vid="JER 2:31">bin ich den geven a midber tsu Yisroel?</para>
  <para style="q" vid="JER 2:31">tsi a land fun shtokfintsternish?</para>
  <para style="q" vid="JER 2:31">far vos zogt main folk: mir viln zich umtraibn,</para>
  <para style="q" vid="JER 2:31">mir veln mer nisht kumen tsu dir?<verse eid="JER 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 2:32" />ken a yungfroi fargesen ir tsirung,</para>
  <para style="q" vid="JER 2:32">a kale ire shleifn?</para>
  <para style="q" vid="JER 2:32">un main folk hot mich fargesen</para>
  <para style="q" vid="JER 2:32">teg on a tsol.<verse eid="JER 2:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="JER 2:33" />vi farbeserstu dain veg libshaft tsu zuchn!</para>
  <para style="q" vid="JER 2:33">far vor, afile di ergste</para>
  <para style="q" vid="JER 2:33">kenstu daine vegen lernen.<verse eid="JER 2:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 2:34" />in daine bregn gefint zich oich blut</para>
  <para style="q" vid="JER 2:34">fun nefoshes fun umshuldike orime –</para>
  <para style="q" vid="JER 2:34">nisht bai an ainbrechung hostu zei gefunen;</para>
  <para style="q" vid="JER 2:34">ober bai alem dem<verse eid="JER 2:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 2:35" />zogstu: far vor, ich bin umshuldik,</para>
  <para style="q" vid="JER 2:35">zain tsorn hot zich gevis opgekert fun mir.</para>
  <para style="q" vid="JER 2:35">ze, ich mishpot zich mit dir</para>
  <para style="q" vid="JER 2:35">far dain zogn: ich hob nisht gezindikt.<verse eid="JER 2:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 2:36" />vi zeyer volvl du machst zich</para>
  <para style="q" vid="JER 2:36">tsu baitn dain veg!</para>
  <para style="q" vid="JER 2:36">vest oich fun Mitsrayim farshemt vern,</para>
  <para style="q" vid="JER 2:36">vi du bist farshemt gevorn fun Ashur.<verse eid="JER 2:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 2:37" />oich fun dem dozikn vestu aroisgein</para>
  <para style="q" vid="JER 2:37">mit daine hent iber dain kop,</para>
  <para style="q" vid="JER 2:37">vorem Hashem faracht daine bitchoynes,</para>
  <para style="q" vid="JER 2:37">un vest mit zei nisht baglikn.<verse eid="JER 2:37" /></para>
  <chapter eid="JER 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="JER 3" />
  <para style="q">
    <verse number="1" style="v" sid="JER 3:1" />… azoi tsu zogn:</para>
  <para style="q" vid="JER 3:1">az a man shikt avek zain vaib,</para>
  <para style="q" vid="JER 3:1">un zi geit avek fun im,</para>
  <para style="q" vid="JER 3:1">un vert an ander mans,</para>
  <para style="q" vid="JER 3:1">vet er den zich vider umkeren tsu ir?</para>
  <para style="q" vid="JER 3:1">volt nisht zindik farzindikt vern yene land?</para>
  <para style="q" vid="JER 3:1">un du host mizane geven mit libhober a sach,</para>
  <para style="q" vid="JER 3:1">un vilst zich umkeren tsu mir,</para>
  <para style="qr" vid="JER 3:1">zogt Hashem.<verse eid="JER 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 3:2" />heib oif daine oign oif di hoiche erter, un ze,</para>
  <para style="q" vid="JER 3:2">vu bistu nisht geshendt gevorn?</para>
  <para style="q" vid="JER 3:2">oif di vegen hostu geloyert oif zei,</para>
  <para style="q" vid="JER 3:2">vi an araber in der midber;</para>
  <para style="q" vid="JER 3:2">un host zindik gemacht dos land</para>
  <para style="q" vid="JER 3:2">mit dain zoines un mit dain shlechtikeit.<verse eid="JER 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 3:3" />derum zainen di friregns farmitn gevorn,</para>
  <para style="q" vid="JER 3:3">un shpetregn iz nisht geven;</para>
  <para style="q" vid="JER 3:3">ober a shtern fun a zoine iz geven bai dir,</para>
  <para style="q" vid="JER 3:3">hostu zich nisht gevolt shemen.<verse eid="JER 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 3:4" />hostu nisht akorsht gerufn tsu mir: foter main,</para>
  <para style="q" vid="JER 3:4">du bist der har fun maine yugnd.<verse eid="JER 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 3:5" />vet er oif eibik a sine trogn?</para>
  <para style="q" vid="JER 3:5">vet er shtendik zi onhaltn?</para>
  <para style="q" vid="JER 3:5">ot hostu geredt, un doch geton dos beiz,</para>
  <para style="q" vid="JER 3:5">un gepoelt bai zich.<verse eid="JER 3:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6" />un Hashem hot tsu mir gezogt in di teg fun melech Yoshiyah: hostu gezen vos di opgekerte Yisroel hot geton? zi iz gegangen oif ale hoichn berg, un unter ale grine beimer, un hot dortn mizane geven. <verse eid="JER 3:6" /><verse number="7" style="v" sid="JER 3:7" />un ich hob gevest gezogt: nochdem az zi hot geton dos alts, vet zi zich umkeren tsu mir; ober zi hot zich nisht umgekert. un di felsherin ir shvester Yehudah hot dos gezen. <verse eid="JER 3:7" /><verse number="8" style="v" sid="JER 3:8" />ober ich hob gezen, az hagam derfar vos di opgekerte Yisroel hot umtraishaft bagangen, hob ich zi avekgeshikt, un ir gegebn ir sheidbriv, hot fun destvegn nisht moire gehat di felsherin Yehudah ir shvester, un zi oich iz gegangen un hot mizane geven. <verse eid="JER 3:8" /><verse number="9" style="v" sid="JER 3:9" />un es iz geven, fun vegen der laichtikeit fun ir zoines hot zi zindik gemacht dos land, un zi hot umtraishaft bagangen mit shtein un mit holts. <verse eid="JER 3:9" /><verse number="10" style="v" sid="JER 3:10" />ober afile noch alem dem hot di felsherin ir shvester Yehudah zich nisht umgekert tsu mir mit ir gantsn hartsn, nor bloiz mit lign, zogt Hashem.<verse eid="JER 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11" />un Hashem hot tsu mir gezogt: di opgekerte Yisroel hot zich aroisgevizn mer rechtfartik fun der felsherin Yehudah.<verse eid="JER 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 3:12" />gei un zolst rufn di dozike verter kegen tsofn, un zogn:</para>
  <para style="b" vid="JER 3:12" />
  <para style="q" vid="JER 3:12">ker zich um, du opgekerte Yisroel,</para>
  <para style="qr" vid="JER 3:12">zogt Hashem,</para>
  <para style="q" vid="JER 3:12">ich vel nisht vorfn a beiz ponem oif aich,</para>
  <para style="q" vid="JER 3:12">vorem ich bin genodik,</para>
  <para style="qr" vid="JER 3:12">zogt Hashem,</para>
  <para style="q" vid="JER 3:12">ich halt nisht a sine oif eibik.<verse eid="JER 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 3:13" />nor du zolst anerkenen daine zind,</para>
  <para style="q" vid="JER 3:13">az on Hashem dain G-t hostu du vidershpenikt,</para>
  <para style="q" vid="JER 3:13">un host tseshpreit daine vegen tsu fremde,</para>
  <para style="q" vid="JER 3:13">unter yetveder tsvaighaftikn boim;</para>
  <para style="q" vid="JER 3:13">un tsu main kol hot ir nisht tsugehert,</para>
  <para style="qr" vid="JER 3:13">zogt Hashem.<verse eid="JER 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 3:14" />kert aich um, kinder opkerer,</para>
  <para style="qr" vid="JER 3:14">zogt Hashem,</para>
  <para style="q" vid="JER 3:14">vorem ich hob chasuna gehat mit aich,</para>
  <para style="q" vid="JER 3:14">un ich vel aich nemen einem fun a shtot,</para>
  <para style="q" vid="JER 3:14">un tsvei fun a mishpoche,</para>
  <para style="q" vid="JER 3:14">un vel aich brengen kein Tsiyon.<verse eid="JER 3:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="JER 3:15" />un ich vel aich gebn pastucher noch main hartsn, un zei veln aich fitern mit kenshaft un mit farshtandikeit. <verse eid="JER 3:15" /><verse number="16" style="v" sid="JER 3:16" />un es vet zain, az ir vet zich mern un fruchpern in land, in yene teg, zogt Hashem, vet men mer nisht zogn: der orn fun Hashems bris; un er vet oifn zinen nisht aroif, un me vet im nisht dermonen un nisht dachtn; un er vet mer nisht gemacht vern. <verse eid="JER 3:16" /><verse number="17" style="v" sid="JER 3:17" />in yener tsait vet men rufn Yerushalayim der tron fun Hashem, un ainzamlen veln zich tsu ir ale felker, fun vegen Hashems nomen, kein Yerushalayim, un zei veln mer nisht gein noch der aingeshpartikeit fun zeyer beizn hartsn. <verse eid="JER 3:17" /><verse number="18" style="v" sid="JER 3:18" />in yene teg vet gein dos hoiz fun Yehudah mit dem hoiz fun Yisroel, un zei veln kumen in einem fun tsofn-land in dem land vos ich hob gemacht arben aiere eltern.<verse eid="JER 3:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JER 3:19" />un ich hob gevest gezogt:</para>
  <para style="q" vid="JER 3:19">vi vel ich dich oisrichtn tsvishn di kinder,</para>
  <para style="q" vid="JER 3:19">un dir gebn a glustik land,</para>
  <para style="q" vid="JER 3:19">di sheinshenste nachle fun di felker!</para>
  <para style="q" vid="JER 3:19">un ich hob gezogt: foter main vestu mich rufn,</para>
  <para style="q" vid="JER 3:19">un fun hinter mir vestu zich nisht opkeren.<verse eid="JER 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 3:20" />ober azoi vi a vaib vos felsht on ir man,</para>
  <para style="q" vid="JER 3:20">azoi hot ir gefelsht on mir, hoiz fun Yisroel,</para>
  <para style="qr" vid="JER 3:20">zogt Hashem.<verse eid="JER 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 3:21" />zol a kol vert oif di hoiche erter gehert,</para>
  <para style="q" vid="JER 3:21">a technunim-gevein fun di kinder fun Yisroel,</para>
  <para style="q" vid="JER 3:21">vorem zei hobn farkrimt zeyer veg,</para>
  <para style="q" vid="JER 3:21">fargesen on Hashem zeyer G-t.<verse eid="JER 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 3:22" />kert aich um, kinder opkerer,</para>
  <para style="q" vid="JER 3:22">ich vel heiln aiere opkerungen.</para>
  <para style="q" vid="JER 3:22">do zainen mir, gekumen tsu dir,</para>
  <para style="q" vid="JER 3:22">vorem du bist Hashem Elokeinu.<verse eid="JER 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 3:23" />far vor, falsh iz vos fun di heichn,</para>
  <para style="q" vid="JER 3:23">der tuml fun di berg;</para>
  <para style="q" vid="JER 3:23">far vor, in Hashem Elokeinu</para>
  <para style="q" vid="JER 3:23">iz di hilf fun Yisroel.<verse eid="JER 3:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="JER 3:24" />un di shandgeterai hot oifgegesn di mi fun undzere eltern, fun undzer yugnt on, zeyere shof un zeyere rinder, zeyere zin un zeyere techter. <verse eid="JER 3:24" /><verse number="25" style="v" sid="JER 3:25" />lomir lign in undzer shand, un zol undz badekn undzer shmach, vorem tsu Hashem Elokeinu hobn mir gezindikt, mir un undzere eltern, fun undzer yugnt un biz haintikn tog, un mir hobn nisht tsugehert tsu dem kol fun Hashem Elokeinu.<verse eid="JER 3:25" /></para>
  <chapter eid="JER 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="JER 4" />
  <para style="q">
    <verse number="1" style="v" sid="JER 4:1" />az du vest zich umkeren, Yisroel,</para>
  <para style="qr" vid="JER 4:1">zogt Hashem,</para>
  <para style="q" vid="JER 4:1">tsu mir zich umkeren,</para>
  <para style="q" vid="JER 4:1">un az du vest opton daine umverdikeitn fun main ponem,</para>
  <para style="q" vid="JER 4:1">un vest zich nisht vaklen,<verse eid="JER 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 4:2" />un vest shvern: azoi vi Hashem lebt,</para>
  <para style="q" vid="JER 4:2">mit emes, mit recht, un mit gerechtikeit,</para>
  <para style="q" vid="JER 4:2">veln zich bentshn mit im felker,</para>
  <para style="q" vid="JER 4:2">un mit im veln zei zich rimen.<verse eid="JER 4:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JER 4:3" />vorem azoi hot Hashem gezogt</para>
  <para style="q" vid="JER 4:3">tsu di mener fun Yehudah un tsu Yerushalayim:</para>
  <para style="q" vid="JER 4:3">akert aich an aker,</para>
  <para style="q" vid="JER 4:3">un ir zolt nisht zeyen oif derner.<verse eid="JER 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 4:4" />bashnaidt aich tsu Hashem,</para>
  <para style="q" vid="JER 4:4">un tut op di forhoitn fun aier harts,</para>
  <para style="q" vid="JER 4:4">ir mener fun Yehudah un bavoiner fun Yerushalayim,</para>
  <para style="q" vid="JER 4:4">kedei main grimtsorn zol nisht aroisgein vi a faier,</para>
  <para style="q" vid="JER 4:4">un brenen az kein lesher zol nisht zain,</para>
  <para style="q" vid="JER 4:4">fun vegen aiere shlechte meisim.<verse eid="JER 4:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="JER 4:5" />dertseilt in Yehudah, un macht hern in Yerushalayim, un zogt:</para>
  <para style="b" vid="JER 4:5" />
  <para style="q" vid="JER 4:5">blozt a shoifer in land;</para>
  <para style="q" vid="JER 4:5">ruft mit a fuler kel, un zogt:</para>
  <para style="q" vid="JER 4:5">zamlt aich ain, un lomir arain in di festungshtet.<verse eid="JER 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 4:6" />heibt oif a fon kein Tsiyon,</para>
  <para style="q" vid="JER 4:6">antrint, ir zolt aich nisht opshteln,</para>
  <para style="q" vid="JER 4:6">vorem ich breng an umglik fun tsofn,</para>
  <para style="q" vid="JER 4:6">un a broch a groisn.<verse eid="JER 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 4:7" />a leib iz oifgegangen fun zain getsvaig,</para>
  <para style="q" vid="JER 4:7">un a mashches fun felker hot getsoign,</para>
  <para style="q" vid="JER 4:7">iz arois fun zain ort, tsu machn dain land tsu vist,</para>
  <para style="q" vid="JER 4:7">daine shtet zoln chorb zain, on a bavoiner.<verse eid="JER 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 4:8" />iber dem gurt on zakkleider,</para>
  <para style="q" vid="JER 4:8">tut klogn un yomern;</para>
  <para style="q" vid="JER 4:8">vorem nisht opgekert hot zich</para>
  <para style="q" vid="JER 4:8">Hashems grimtsorn fun undz.<verse eid="JER 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="JER 4:9" />un es vet zain in yenem tog, zogt Hashem, vet fargein dos harts fun dem melech, un dos harts fun di harn; un di koyanim veln banumen vern, un di neviim veln gafn. <verse eid="JER 4:9" /><verse number="10" style="v" sid="JER 4:10" />hob ich gezogt: vei, Hashem du Adonoi, far vor, narn genart hostu dos dozike folk un Yerushalayim, azoi tsu zogn: sholem vet zain tsu aich, un di shverd dergreicht bizn nefesh.<verse eid="JER 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 4:11" />in yener tsait vet bafoiln vern oif dem dozikn folk un oif Yerushalayim a heiser vint fun di hoicher erter in midber, oifn veg tsu der tochter main folk; nisht tsu vintshuflen, un nisht tsu reiniken; <verse eid="JER 4:11" /><verse number="12" style="v" sid="JER 4:12" />a vint shtarker fun dem vet kumen fun mir; atsund vel ich oich aroiszogn a mishpot oif zei.<verse eid="JER 4:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 4:13" />ze, vi volkens geit er oif,</para>
  <para style="q" vid="JER 4:13">un vi der shturemvint zainen zaine raitvegn;</para>
  <para style="q" vid="JER 4:13">flinker fun odlers zainen zaine ferd:</para>
  <para style="q" vid="JER 4:13">vei undz, vorem mir zainen farvist.<verse eid="JER 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 4:14" />vash op fun beiz dain harts, Yerushalayim,</para>
  <para style="q" vid="JER 4:14">kedei zolst geholfn vern.</para>
  <para style="q" vid="JER 4:14">biz vanen veln ruen in dir</para>
  <para style="q" vid="JER 4:14">daine machshoves fun umrecht?<verse eid="JER 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 4:15" />vorem a kol zogt on fun Dan,</para>
  <para style="q" vid="JER 4:15">un macht hern umglik fun geberg fun Efrayim:<verse eid="JER 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 4:16" />dertseilt di felker: ot iz es!</para>
  <para style="q" vid="JER 4:16">macht hern in Yerushalayim:</para>
  <para style="q" vid="JER 4:16">balegerer kumen fun a vaitn land,</para>
  <para style="q" vid="JER 4:16">un lozn arois oif di shtet fun Yehudah zeyer kol.<verse eid="JER 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 4:17" />vi feldhiter zainen zei oif ir fun rund arum,</para>
  <para style="q" vid="JER 4:17">vail zi hot mir vidershpenikt,</para>
  <para style="qr" vid="JER 4:17">zogt Hashem.<verse eid="JER 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 4:18" />dain firung un daine meisim</para>
  <para style="q" vid="JER 4:18">hobn dir dos ongemacht –</para>
  <para style="q" vid="JER 4:18">di dozike shlechtikeit daine –</para>
  <para style="q" vid="JER 4:18">vos es iz biter,</para>
  <para style="q" vid="JER 4:18">vos es rirt on biz dain hartsn.<verse eid="JER 4:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JER 4:19" />maine ingeveid, maine ingeveid!</para>
  <para style="q" vid="JER 4:19">es tut mir vei in di vent fun main harts,</para>
  <para style="q" vid="JER 4:19">main harts tut brumen in mir,</para>
  <para style="q" vid="JER 4:19">ich ken nisht shvaign!</para>
  <para style="q" vid="JER 4:19">vorem a kol fun shoifer hostu gehert, main zel,</para>
  <para style="q" vid="JER 4:19">a shal fun milchome.<verse eid="JER 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 4:20" />a broch oif a broch gershet,</para>
  <para style="q" vid="JER 4:20">vorem farvist gevorn iz dos gantse land,</para>
  <para style="q" vid="JER 4:20">plutsem zainen farvist gevorn maine getseltn,</para>
  <para style="q" vid="JER 4:20">in a rege – maine forhangen.<verse eid="JER 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 4:21" />biz vanen vel ich zen di fon,</para>
  <para style="q" vid="JER 4:21">vel ich hern dem kol fun dem shoifer?<verse eid="JER 4:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JER 4:22" />vorem narish iz main folk,</para>
  <para style="q" vid="JER 4:22">mich kenen zei nisht;</para>
  <para style="q" vid="JER 4:22">kinder narn zainen zei,</para>
  <para style="q" vid="JER 4:22">un nisht farshtandik zainen zei;</para>
  <para style="q" vid="JER 4:22">zei zainen chachomim oif ton shlechts,</para>
  <para style="q" vid="JER 4:22">un fun guts ton veisn zei nisht.<verse eid="JER 4:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JER 4:23" />ich hob gezen di erd,</para>
  <para style="q" vid="JER 4:23">ersht zi iz vist un leidik</para>
  <para style="q" vid="JER 4:23">un di himlen – un zeyer licht iz nishto.<verse eid="JER 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 4:24" />ich hob gezen di berg, ersht zei tsiteren,</para>
  <para style="q" vid="JER 4:24">un ale heichn hobn zich getreislt.<verse eid="JER 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 4:25" />ich hob gezen, ersht kein mentshn iz nishto,</para>
  <para style="q" vid="JER 4:25">un ale foiglen fun himel zainen avek.<verse eid="JER 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 4:26" />ich hob gezen, ersht der Karmel iz a midber,</para>
  <para style="q" vid="JER 4:26">un ale zaine shtet zainen tseshtert,</para>
  <para style="q" vid="JER 4:26">far dem ongezicht fun Hashem,</para>
  <para style="q" vid="JER 4:26">far dem geirem fun zain tsorn.<verse eid="JER 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="JER 4:27" />vorem azoi hot Hashem gezogt: a vistenish vet vern dos gantse land, hagam kein farlendung vel ich nisht machn.<verse eid="JER 4:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="JER 4:28" />oif dem vet troiern di erd,</para>
  <para style="q" vid="JER 4:28">un fintster vern veln di himlen fun oiben,</para>
  <para style="q" vid="JER 4:28">vail ich hob geredt, ich hob getracht,</para>
  <para style="q" vid="JER 4:28">un ich hob nisht charote,</para>
  <para style="q" vid="JER 4:28">un vel zich nisht opkeren derfun.<verse eid="JER 4:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="JER 4:29" />far dem kol fun raiter un boign-shiser,</para>
  <para style="q" vid="JER 4:29">antloift di gantse shtot;</para>
  <para style="q" vid="JER 4:29">zei zainen arain in gedichte velder,</para>
  <para style="q" vid="JER 4:29">un oif feldzn zainen zei aroifgegangen;</para>
  <para style="q" vid="JER 4:29">yetveder shtot iz farlozen,</para>
  <para style="q" vid="JER 4:29">un in zei voint nisht kein mentsh.<verse eid="JER 4:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 4:30" />un du baroibte, vos tustu,</para>
  <para style="q" vid="JER 4:30">vos du kleidst dich in roit,</para>
  <para style="q" vid="JER 4:30">vos du tsirst dich mit tsirung fun gold,</para>
  <para style="q" vid="JER 4:30">vos du raist oif daine oign mit farb?</para>
  <para style="q" vid="JER 4:30">umzist machstu zich shein,</para>
  <para style="q" vid="JER 4:30">daine libhober farachten dich, zei zuchn dain lebn.<verse eid="JER 4:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 4:31" />vorem a kol vi fun a veyerin hob ich gehert,</para>
  <para style="q" vid="JER 4:31">angst vi fun an ershtgevinerin.</para>
  <para style="q" vid="JER 4:31">dem kol fun tochter Tsiyon vos farkaicht zich,</para>
  <para style="q" vid="JER 4:31">vos shpreit ire hent funander:</para>
  <para style="q" vid="JER 4:31">vei mir, vorem main zel</para>
  <para style="q" vid="JER 4:31">iz ummachtik far di teiter.<verse eid="JER 4:31" /></para>
  <chapter eid="JER 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="JER 5" />
  <para style="q">
    <verse number="1" style="v" sid="JER 5:1" />vander um in di gasn fun Yerushalayim,</para>
  <para style="q" vid="JER 5:1">un zet akorsht un hobn visikeit,</para>
  <para style="q" vid="JER 5:1">un zucht in ire merk,</para>
  <para style="q" vid="JER 5:1">oib ir vet gefinen a mentshn,</para>
  <para style="q" vid="JER 5:1">oib es iz do ver es tut gerechtikeit,</para>
  <para style="q" vid="JER 5:1">ver es zucht emes,</para>
  <para style="q" vid="JER 5:1">un ich vel ir fargebn.<verse eid="JER 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 5:2" />afile ven zei zogn: azoi vi Hashem lebt!</para>
  <para style="q" vid="JER 5:2">shvern zei fun destvegn falsh.<verse eid="JER 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 5:3" />Hashem, daine oign zainen doch oif emes;</para>
  <para style="q" vid="JER 5:3">host zei geshlogn, un zei hobn zich nisht gekimert,</para>
  <para style="q" vid="JER 5:3">host zei farlendt, un zei hobn kein musar nisht genumen;</para>
  <para style="q" vid="JER 5:3">zei hobn gemacht zeyer ponem harter fun feldz,</para>
  <para style="q" vid="JER 5:3">zei hobn zich nisht gevolt umkeren.<verse eid="JER 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="JER 5:4" />un ich hob gevest gezogt: dos zainen nor di orime,</para>
  <para style="q" vid="JER 5:4">zei zainen narish,</para>
  <para style="q" vid="JER 5:4">vail zei veisn nisht dem veg fun Hashem,</para>
  <para style="q" vid="JER 5:4">dos gezets fun zeyer G-t.<verse eid="JER 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 5:5" />ich vel mir gein tsu di groise,</para>
  <para style="q" vid="JER 5:5">un vel redn mit zei;</para>
  <para style="q" vid="JER 5:5">vorem zei veisn dem veg fun Hashem,</para>
  <para style="q" vid="JER 5:5">dos gezets fun zeyer G-t.</para>
  <para style="q" vid="JER 5:5">ober zei hobn des glaichn tsebrochn dem yoch,</para>
  <para style="q" vid="JER 5:5">tserisn di bindshtrik.<verse eid="JER 5:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 5:6" />derum dershlogt zei a leib fun vald,</para>
  <para style="q" vid="JER 5:6">a volf fun midboryes vet zei farvistn,</para>
  <para style="q" vid="JER 5:6">a lempert tut loiern oif zeyere shtet,</para>
  <para style="q" vid="JER 5:6">itlecher vos geit arois fun zei, vet fartsukt vern;</para>
  <para style="q" vid="JER 5:6">vorem fil zainen zeyere farbrechn,</para>
  <para style="q" vid="JER 5:6">shtark zainen zeyere opkerungen.<verse eid="JER 5:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 5:7" />vi zol ich var dem dir fargebn?</para>
  <para style="q" vid="JER 5:7">daine kinder hobn mich farlozen,</para>
  <para style="q" vid="JER 5:7">un geshvorn bai umgeter;</para>
  <para style="q" vid="JER 5:7">az ich hob zei ongezet,</para>
  <para style="q" vid="JER 5:7">hobn zei mizane geven,</para>
  <para style="q" vid="JER 5:7">un in haizer fun zoinus klaibn zei zich oif.<verse eid="JER 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 5:8" />ferd opgefiterte, ogers zainen zei,</para>
  <para style="q" vid="JER 5:8">itlecher tsu zain chavers vaib hirzhen zei;<verse eid="JER 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 5:9" />zol ich derfar zich nisht oprechenen?</para>
  <para style="qr" vid="JER 5:9">zogt Hashem;</para>
  <para style="q" vid="JER 5:9">un zol on a folk vi dos dozike</para>
  <para style="q" vid="JER 5:9">zich nisht noikem zain main zel?<verse eid="JER 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 5:10" />geit aroif in ire reyen, un tseshtert,</para>
  <para style="q" vid="JER 5:10">nor a farlendung zolt ir nisht machn;</para>
  <para style="q" vid="JER 5:10">tut op ire tsvaign,</para>
  <para style="q" vid="JER 5:10">vorem nisht Hashems zainen zei.<verse eid="JER 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 5:11" />vorem felshn gefelsht hobn on mir</para>
  <para style="q" vid="JER 5:11">dos hoiz fun Yisroel un dos hoiz fun Yehudah,</para>
  <para style="qr" vid="JER 5:11">zogt Hashem.<verse eid="JER 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 5:12" />zei hobn geleiknt on Hashem,</para>
  <para style="q" vid="JER 5:12">un gezogt: dos iz nisht er,</para>
  <para style="q" vid="JER 5:12">un beiz vet nisht kumen oif undz,</para>
  <para style="q" vid="JER 5:12">un shverd un hunger veln mir nisht onzen.<verse eid="JER 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 5:13" />un fun di neviim vet zich oislozen a vint,</para>
  <para style="q" vid="JER 5:13">vorem dos vort iz in zei nishto;</para>
  <para style="q" vid="JER 5:13">azoi zol zei alein geshen!<verse eid="JER 5:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 5:14" />derum hot Hashem Elokei Tseva'ot azoi gezogt:</para>
  <para style="q" vid="JER 5:14">vail ir redt dos dozike gereid,</para>
  <para style="q" vid="JER 5:14">ot mach ich maine verter in dain moil tsu faier,</para>
  <para style="q" vid="JER 5:14">un dos dozike folk holts,</para>
  <para style="q" vid="JER 5:14">un es vet zei fartseren.<verse eid="JER 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 5:15" />ze, ich breng oif aich a folk fun der vait,</para>
  <para style="q" vid="JER 5:15">ir hoiz fun Yisroel,</para>
  <para style="qr" vid="JER 5:15">zogt Hashem;</para>
  <para style="q" vid="JER 5:15">a machtik folk iz dos,</para>
  <para style="q" vid="JER 5:15">a folk fun fartsaitn iz dos,</para>
  <para style="q" vid="JER 5:15">a folk vos du veist nisht zain loshen,</para>
  <para style="q" vid="JER 5:15">un farshteist nisht vos er redt.<verse eid="JER 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 5:16" />zain failbaitl iz vi an ofener keyver;</para>
  <para style="q" vid="JER 5:16">zei zainen ale giborim.<verse eid="JER 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 5:17" />un er vet oifesn dain shnit, un dain broit;</para>
  <para style="q" vid="JER 5:17">zei veln oifesn daine zin un daine techter;</para>
  <para style="q" vid="JER 5:17">er vet oifesn daine shof un daine rinder,</para>
  <para style="q" vid="JER 5:17">er vet oifesn dain vainshtok un dain faignboim;</para>
  <para style="q" vid="JER 5:17">er vet tseklapn mitn shverd daine festungshtet</para>
  <para style="q" vid="JER 5:17">vos du farzicherst zich oif zei.<verse eid="JER 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="JER 5:18" />hagam oich in yene teg, zogt Hashem, vel ich nisht machn a farlendung fun aich. <verse eid="JER 5:18" /><verse number="19" style="v" sid="JER 5:19" />un es vet zain, az ir vet zogn: far vos hot Hashem Elokeinu undz geton dos alts? zolstu zogn tsu zei: azoi vi ir hot mich farlozen, un gedint fremde g‑ter in aier land, azoi zolt ir dinen fremde in a land nisht aiers.<verse eid="JER 5:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JER 5:20" />zogt dos on in hoiz fun Yaakov,</para>
  <para style="q" vid="JER 5:20">un macht es hern in Yehudah, azoi tsu zogn:<verse eid="JER 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 5:21" />hert dos tsu akorsht, ir narish folk on seichel,</para>
  <para style="q" vid="JER 5:21">vos hobn oign un zeen nisht,</para>
  <para style="q" vid="JER 5:21">vos hobn oiern un hern nisht;<verse eid="JER 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 5:22" />hot ir den nisht moire far mir?</para>
  <para style="qr" vid="JER 5:22">zogt Hashem,</para>
  <para style="q" vid="JER 5:22">tsi tsitert ir nisht far main ongezicht?</para>
  <para style="q" vid="JER 5:22">ich vos hob gemacht zamd a grenets tsum yam,</para>
  <para style="q" vid="JER 5:22">an eibik gezets vos er ken nisht aribergein;</para>
  <para style="q" vid="JER 5:22">un zaine indn vorfn zich,</para>
  <para style="q" vid="JER 5:22">un kenen nisht baikumen,</para>
  <para style="q" vid="JER 5:22">un zei brumen, un kenen es nisht aribergein.<verse eid="JER 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 5:23" />ober bai dem dozikn folk</para>
  <para style="q" vid="JER 5:23">iz an opgekert un vidershpenik harts,</para>
  <para style="q" vid="JER 5:23">zei hobn zich opgekert un zainen avek.<verse eid="JER 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 5:24" />un zei hobn nisht gezogt in zeyer hartsn:</para>
  <para style="q" vid="JER 5:24">lomir moire hobn far Hashem Elokeinu,</para>
  <para style="q" vid="JER 5:24">vos git regn, friregn,</para>
  <para style="q" vid="JER 5:24">un shpeteregn, in zain tsait,</para>
  <para style="q" vid="JER 5:24">vos hit far undz op di geshtelte vochn fun shnit.<verse eid="JER 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 5:25" />aiere zind hobn opgeneigt di dozike,</para>
  <para style="q" vid="JER 5:25">un aiere chatoim hobn farmitn dos guts fun aich.<verse eid="JER 5:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 5:26" />vorem tsvishn main folk gefinen zich reshoim;</para>
  <para style="q" vid="JER 5:26">zei kukn noch, azoi vi foiglfangen loiern,</para>
  <para style="q" vid="JER 5:26">zei shteln a pastke, mentshn fangen zei.<verse eid="JER 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 5:27" />vi a shtaig ful mit foiglen,</para>
  <para style="q" vid="JER 5:27">azoi zainen zeyere haizer ful mit batrug;</para>
  <para style="q" vid="JER 5:27">derum zainen zei grois un raich gevorn.<verse eid="JER 5:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 5:28" />fet, grob zainen zei gevorn;</para>
  <para style="q" vid="JER 5:28">yo, zei shtaig ariber in beize shtik.</para>
  <para style="q" vid="JER 5:28">far recht nemen zei zich nisht on, faran recht fun yosem,</para>
  <para style="q" vid="JER 5:28">az zei zoln es durchfirn;</para>
  <para style="q" vid="JER 5:28">un dem mishpot fun di evyonim mishpetn zei nisht.<verse eid="JER 5:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 5:29" />zol ich derfar zich nisht oprechenen?</para>
  <para style="qr" vid="JER 5:29">zogt Hashem;</para>
  <para style="q" vid="JER 5:29">zol on a folk vi dos dozike</para>
  <para style="q" vid="JER 5:29">zich nisht noikem zain main zel?<verse eid="JER 5:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="JER 5:30" />a shrek un shoider geshet in land:<verse eid="JER 5:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 5:31" />di neviim zogn nevies oif lign,</para>
  <para style="q" vid="JER 5:31">un di koyanim geveltikn zei tsu der hant,</para>
  <para style="q" vid="JER 5:31">un main folk hot es lib azoi;</para>
  <para style="q" vid="JER 5:31">ober vos vet ir ton tsum sof derfun?<verse eid="JER 5:31" /></para>
  <chapter eid="JER 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="JER 6" />
  <para style="q">
    <verse number="1" style="v" sid="JER 6:1" />antrint, ir kinder fun Binyamin,</para>
  <para style="q" vid="JER 6:1">arois fun Yerushalayim,</para>
  <para style="q" vid="JER 6:1">un in Tekoa blozt a shoifer,</para>
  <para style="q" vid="JER 6:1">un in Beis-Kerem heibt oif a tseichn,</para>
  <para style="q" vid="JER 6:1">vorem an umglik kukt arois fun tsofn,</para>
  <para style="q" vid="JER 6:1">un a broch a groiser.<verse eid="JER 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 6:2" />di sheine un fartsertlte,</para>
  <para style="q" vid="JER 6:2">di tochter Tsiyon to ich farshnaidn.<verse eid="JER 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 6:3" />tsu ir kumen pastucher mit zeyere stades,</para>
  <para style="q" vid="JER 6:3">zei shteln oif getseltn rund arum ir,</para>
  <para style="q" vid="JER 6:3">zei fitern itlecher zich tsu der hant.<verse eid="JER 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 6:4" />breit on a milchome oif ir!</para>
  <para style="q" vid="JER 6:4">shteit oif, un lomir aroifgein in mitn tog! –</para>
  <para style="q" vid="JER 6:4">vei undz! vorem der tog kert zich op,</para>
  <para style="q" vid="JER 6:4">vorem es shtrekn zich di shotns fun ovnt –<verse eid="JER 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 6:5" />shteit oif, un lomir aroifgein bai nacht,</para>
  <para style="q" vid="JER 6:5">un lomir tseshtern ire festungen!<verse eid="JER 6:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 6:6" />vorem azoi hot gezogt Hashem Tseva'ot:</para>
  <para style="q" vid="JER 6:6">shnaidt on gehilts,</para>
  <para style="q" vid="JER 6:6">un shit on arum Yerushalayim an erdval;</para>
  <para style="q" vid="JER 6:6">dos iz di shtot vos iz</para>
  <para style="q" vid="JER 6:6">in gantsn ongeleigt mit roib in ir.<verse eid="JER 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 6:7" />vi a brunem kvelt arois zaine vaser,</para>
  <para style="q" vid="JER 6:7">azoi kvelt zi arois ir beiz;</para>
  <para style="q" vid="JER 6:7">umrecht un roib hert zich in ir,</para>
  <para style="q" vid="JER 6:7">far main ponem iz tamid</para>
  <para style="q" vid="JER 6:7">krankshaft un shleg.<verse eid="JER 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 6:8" />nem a musar, Yerushalayim,</para>
  <para style="q" vid="JER 6:8">kedei main zel zol zich nisht opeklen fun dir,</para>
  <para style="q" vid="JER 6:8">a land nisht bavoint.<verse eid="JER 6:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JER 6:9" />azoi hot gezogt Hashem Tseva'ot:</para>
  <para style="q" vid="JER 6:9">arumklaibn vi a vainshtok vet men arumklaibn</para>
  <para style="q" vid="JER 6:9">dem iberblaib fun Yisroel;</para>
  <para style="q" vid="JER 6:9">ker vider un vider dain hant,</para>
  <para style="q" vid="JER 6:9">vi a harbster oif di tsvaiglech.<verse eid="JER 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 6:10" />tsu vemen zol ich redn un vorenen</para>
  <para style="q" vid="JER 6:10">az zei zoln hern?</para>
  <para style="q" vid="JER 6:10">ze, zeyer oier iz farshtopt,</para>
  <para style="q" vid="JER 6:10">un zei kenen nisht farnemen;</para>
  <para style="q" vid="JER 6:10">ze, Hashems vort iz bai zei tsum geshpet,</para>
  <para style="q" vid="JER 6:10">zei viln es nisht.<verse eid="JER 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 6:11" />derum bin ich ful mit dem grimtsorn fun Hashem,</para>
  <para style="q" vid="JER 6:11">ich ken mer nisht ainhaltn:</para>
  <para style="q" vid="JER 6:11">gis im oich oif di kinder in gas,</para>
  <para style="q" vid="JER 6:11">un oif dem gezeml fun yunge lait mit anander;</para>
  <para style="q" vid="JER 6:11">vorem i man i vaib veln batsvungen vern,</para>
  <para style="q" vid="JER 6:11">der zoken mitn fulbatogtn.<verse eid="JER 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 6:12" />un zeyere haizer veln ibergein tsu andere,</para>
  <para style="q" vid="JER 6:12">felder un vaiber mit anander;</para>
  <para style="q" vid="JER 6:12">vorem ich vel oisshtrekn main hant</para>
  <para style="q" vid="JER 6:12">oif di bavoiner fun land,</para>
  <para style="qr" vid="JER 6:12">zogt Hashem.<verse eid="JER 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 6:13" />vorem fun zeyer klenstn biz zeyer grestn</para>
  <para style="q" vid="JER 6:13">iz itlecher gaitsik noch gevin,</para>
  <para style="q" vid="JER 6:13">un fun novi bizn koyen</para>
  <para style="q" vid="JER 6:13">tut itlecher falshkeit.<verse eid="JER 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 6:14" />un zei heiln dem broch fun main folk oif gring,</para>
  <para style="q" vid="JER 6:14">azoi tsu zogn: sholem! sholem! ven kein sholem iz nishto.<verse eid="JER 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 6:15" />zei veln tsu shand vern,</para>
  <para style="q" vid="JER 6:15">vail umverdikeit hobn zei geton;</para>
  <para style="q" vid="JER 6:15">tsu mol shemen shemen zei zich nisht,</para>
  <para style="q" vid="JER 6:15">tsu mol fun kein bushe veisn zei nisht;</para>
  <para style="q" vid="JER 6:15">derum veln zei faln tsvishn di gefalene;</para>
  <para style="q" vid="JER 6:15">beeis ich rechn zich mit zei</para>
  <para style="q" vid="JER 6:15">veln zei geshtroichlt vern,</para>
  <para style="qr" vid="JER 6:15">zogt Hashem.<verse eid="JER 6:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="JER 6:16" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 6:16">shteit oif di vegen un zet,</para>
  <para style="q" vid="JER 6:16">un fregt oif di alte shtegn,</para>
  <para style="q" vid="JER 6:16">vu iz der veg tsum gutn, un geit oif im,</para>
  <para style="q" vid="JER 6:16">un gefint an opru far aier zel.</para>
  <para style="q" vid="JER 6:16">ober zei hobn gezogt: mir veln nisht gein.<verse eid="JER 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 6:17" />un ich felg oifshteln vechter iber aich:</para>
  <para style="q" vid="JER 6:17">farnemt dem kol fun shoifer!</para>
  <para style="q" vid="JER 6:17">ober zei hobn gezogt:</para>
  <para style="q" vid="JER 6:17">mir veln nisht farnemen.<verse eid="JER 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 6:18" />derum hert, ir felker,</para>
  <para style="q" vid="JER 6:18">un derkent, du ainzamlung,</para>
  <para style="q" vid="JER 6:18">vos oif zei kumt.<verse eid="JER 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 6:19" />her, du erd;</para>
  <para style="q" vid="JER 6:19">ze, ich breng an umglik oif dem dozikn folk,</para>
  <para style="q" vid="JER 6:19">di frucht fun zeyere trachtungen,</para>
  <para style="q" vid="JER 6:19">vail zei hobn maine verter nisht farnumen,</para>
  <para style="q" vid="JER 6:19">un main toyre – zi hobn zei faracht.<verse eid="JER 6:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 6:20" />tsu vos mir den vairech vos kumt fun Sheva,</para>
  <para style="q" vid="JER 6:20">un guter gevirtsror fun a vaitn land?</para>
  <para style="q" vid="JER 6:20">aiere brandopfer zainen nisht tsu bavilikung,</para>
  <para style="q" vid="JER 6:20">un aiere shlachtopfer zainen mir nisht ongeleigt.<verse eid="JER 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 6:21" />derum hot Hashem azoi gezogt:</para>
  <para style="q" vid="JER 6:21">ze, ich leig shtroichlungen far dem dozikn folk,</para>
  <para style="q" vid="JER 6:21">un shtroichlen veln durch zei</para>
  <para style="q" vid="JER 6:21">foters un zin in einem;</para>
  <para style="q" vid="JER 6:21">der shochn un zain chever,</para>
  <para style="q" vid="JER 6:21">un zei veln untergein.<verse eid="JER 6:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JER 6:22" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 6:22">ze, a folk kumt fun tsofn-land,</para>
  <para style="q" vid="JER 6:22">un a groise ume dervekt zich fun di ekn erd.<verse eid="JER 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 6:23" />boign un shpiz haltn zei,</para>
  <para style="q" vid="JER 6:23">achzorim zainen zei, un hobn kein rachmones nisht;</para>
  <para style="q" vid="JER 6:23">zeyer kol brumt vi der yam,</para>
  <para style="q" vid="JER 6:23">un oif ferd raitn zei;</para>
  <para style="q" vid="JER 6:23">oisgeshtelt vi ein man tsu milchome</para>
  <para style="q" vid="JER 6:23">oif dir, tochter Tsiyon.<verse eid="JER 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 6:24" />mir hobn gehert zain herung,</para>
  <para style="q" vid="JER 6:24">undzere hent zainen shlof gevorn,</para>
  <para style="q" vid="JER 6:24">an angst hot undz banumen,</para>
  <para style="q" vid="JER 6:24">a veitik vi a gevinerin.<verse eid="JER 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 6:25" />zolst nisht arois in feld,</para>
  <para style="q" vid="JER 6:25">un in veg zolstu nisht gein,</para>
  <para style="q" vid="JER 6:25">vorem di shverd fun dem faint</para>
  <para style="q" vid="JER 6:25">iz a shrek rund arum.<verse eid="JER 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 6:26" />tochter main folk, gurt on zak,</para>
  <para style="q" vid="JER 6:26">un kaikl zich in ash;</para>
  <para style="q" vid="JER 6:26">a troier vi noch an eineintsikn mach dir,</para>
  <para style="q" vid="JER 6:26">a bitere klog,</para>
  <para style="q" vid="JER 6:26">vorem plutsem vet kumen der farvister oif undz.<verse eid="JER 6:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="JER 6:27" />a pruver hob ich dich gemacht,</para>
  <para style="q" vid="JER 6:27">a goldtigl tsvishn main folk,</para>
  <para style="q" vid="JER 6:27">kedei zolst gevor vern un pruvn zeyer veg.<verse eid="JER 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 6:28" />opgekerte opkerer zainen zei ale,</para>
  <para style="q" vid="JER 6:28">rechiles-traiber;</para>
  <para style="q" vid="JER 6:28">kuper un aizn zainen zei,</para>
  <para style="q" vid="JER 6:28">ale fardorben zainen zei.<verse eid="JER 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 6:29" />gesopet hot der blozzak,</para>
  <para style="q" vid="JER 6:29">farlendt gevorn fun faier iz dos blai –</para>
  <para style="q" vid="JER 6:29">umzist hot men laitern gelaitert,</para>
  <para style="q" vid="JER 6:29">vorem di shlechte zainen nisht opgesheidt gevorn.<verse eid="JER 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 6:30" />farachte zilber ruft men zei,</para>
  <para style="q" vid="JER 6:30">vorem faracht hot zei Hashem.<verse eid="JER 6:30" /></para>
  <chapter eid="JER 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="JER 7" />
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem, azoi tsu zogn: <verse eid="JER 7:1" /><verse number="2" style="v" sid="JER 7:2" />shtel zich in toier fun Hashems hoiz, un zolst oisrufn dortn dos dozike vort, un zogn: hert dos vort fun Hashem, gants Yehudah, vos kumt in di dozike toiern zich tsu bukn tsu Hashem. <verse eid="JER 7:2" /><verse number="3" style="v" sid="JER 7:3" />azoi hot gezogt Hashem Tseva'ot Elokei Yisroel: besert aiere vegen un aiere meisim, un ich vel aich lozn ruen in dem dozikn ort. <verse eid="JER 7:3" /><verse number="4" style="v" sid="JER 7:4" />ir zolt aich nisht farzichern oif di verter fun lign, azoi tsu zogn: der heichl fun Hashem, der heichl fun Hashem, der heichl fun Hashem iz dos.<verse eid="JER 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 7:5" />naiert, oib besern vet ir besern aiere vegen un aiere meisim; oib ton vet ir ton gerechtikeit tsvishn itlechn un zain chever, <verse eid="JER 7:5" /><verse number="6" style="v" sid="JER 7:6" />dem fremdn, dem yosem, un di almone vet ir nisht drikn, un umshuldik blut vet ir nisht fargisen in dem dozikn ort, un noch fremde g‑ter vet ir nisht gein, tsu aier eigener roe, <verse eid="JER 7:6" /><verse number="7" style="v" sid="JER 7:7" />vel ich aich lozn ruen in dem dozikn ort, in dem land vos ich hob gegebn aiere eltern fun eibik un biz eibik.<verse eid="JER 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 7:8" />zet, ir farzichert aich oif verter fun lign on a nuts. <verse eid="JER 7:8" /><verse number="9" style="v" sid="JER 7:9" />vilt ir ganven, teitn, un noyefn, un shvern falsh, un reichern tsu Baal, un gein noch fremde g‑ter, vos ir kent nisht, <verse eid="JER 7:9" /><verse number="10" style="v" sid="JER 7:10" />un kumen un zich shteln far mir in dem dozikn hoiz, vos main nomen vert gerufn oif im, un zogn: mir zainen geratevet! kedei tsu ton ale di dozike umverdikeitn! <verse eid="JER 7:10" /><verse number="11" style="v" sid="JER 7:11" />iz a heil fun roiber gevorn in aiere oign dos dozike hoiz vos main nomen vert gerufn oif im? ober ich zet, hob tsugekukt, zogt Hashem. <verse eid="JER 7:11" /><verse number="12" style="v" sid="JER 7:12" />vorem geit akorsht tsu main ort vos in Shiloh, vos ich hob gemacht ruen main nomen dortn tsuersht, un zet vos ich hob geton tsu im, fun vegen der shlechtikeit fun main folk Yisroel. <verse eid="JER 7:12" /><verse number="13" style="v" sid="JER 7:13" />un atsund, vail ir tut ale di dozike meisim, zogt Hashem, un ich hob tsu aich geredt, nochanand un nochanand geredt, un ir hot nisht tsugehert, un ich hob aich gerufn, un ir hot nisht geentfert – <verse eid="JER 7:13" /><verse number="14" style="v" sid="JER 7:14" />derum vel ich ton tsu dem hoiz, vos main nomen vert gerufn oif im, vos ir farzichert aich oif im, vos ir farzichert aich oif im, un tsu dem ort vos ich hob gegebn aich un aiere eltern, azoi vi ich hob geton tsu Shiloh. <verse eid="JER 7:14" /><verse number="15" style="v" sid="JER 7:15" />un ich vel aich avekvarfn fun far main ponem, azoi vi ich hob avekgevorfen ale aiere brider, dem gantsn zomen fun Efrayim.<verse eid="JER 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16" />un du, zolst nisht mispalel zain far dem dozikn folk, un nisht oifheibn a geshrei un a tfile far zei, un zich nisht shtadlen bai mir, vorem ich her dich nisht tsu. <verse eid="JER 7:16" /><verse number="17" style="v" sid="JER 7:17" />zestu nisht vos zei tuen in di shtet fun Yehudah un in di gasn fun Yerushalayim? <verse eid="JER 7:17" /><verse number="18" style="v" sid="JER 7:18" />9di kinder klaibn holts, un di foters tsindn on dos faier, un di vaiber knetn teig tsu machn kuchns tsu der malke fun himel, un zei gisn gisopfer tsu fremde g‑ter, kedei mich tsu dertsernen. <verse eid="JER 7:18" /><verse number="19" style="v" sid="JER 7:19" />ober tuen zei den mir dertsernen, zogt Hashem, tsi nisht zich alein, tsu der shand fun zeyer ponem? <verse eid="JER 7:19" /><verse number="20" style="v" sid="JER 7:20" />derum hot Adonoi Hashem azoi gezogt: ze, main kaas un main grimtsorn gist zich ois oif dem dozikn ort, oif mentshn, un oif beheimes, un oif dem boim fun feld, un oif der frucht fun der erd, un er vet brenen un nisht farloshn vern.<verse eid="JER 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 7:21" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: leigt tsu aiere brandopfer tsu aiere shlachtopfer, un est zich on mit fleish. <verse eid="JER 7:21" /><verse number="22" style="v" sid="JER 7:22" />vorem ich hob nisht geredt mit aiere eltern, un hob zei nisht bafoiln, in dem tog vos ich hob zei aroisgetsoign fun land Mitsrayim, vegen a brandopfer oder a shlachtopfer. <verse eid="JER 7:22" /><verse number="23" style="v" sid="JER 7:23" />nor bloiz dos dozike vort hob ich zei bafoiln, azoi tsu zogn: hert tsu main kol, un ich vel aich zain tsum Elokim, un ir vet mir zain tsum folk; un ir zolt gein in al dem veg vos ich bafel aich, kedei aich zol gut zain. <verse eid="JER 7:23" /><verse number="24" style="v" sid="JER 7:24" />ober zei hobn nisht tsugehert, un nisht tsugenaigt zeyer oier, un zei zainen gegangen in di etsut, in der aingeshpartkeit fun zeyer beizn hartsn, un zainen geven ahinter un nisht farois, <verse eid="JER 7:24" /><verse number="25" style="v" sid="JER 7:25" />fun dem tog vos aiere eltern zainen arois fun land Mitsrayim biz oif haintikn tog; un ich hob geshikt tsu aich ale maine knecht di neviim, togteglech, nochanand geshikt, <verse eid="JER 7:25" /><verse number="26" style="v" sid="JER 7:26" />ober zei hobn nisht tsugehert tsu mir, un nisht tsugenaigt zeyer oier, un zei hobn hart gemacht zeyer nakn; zei hobn geton erger fun zeyere eltern.<verse eid="JER 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27" />un vest redn tsu zei di ale verter, ober zei veln nisht tsuhern tsu dir, un vest rufn tsu zei, ober zei veln dir nisht entfern. <verse eid="JER 7:27" /><verse number="28" style="v" sid="JER 7:28" />zolstu zogn tsu zei: dos iz dos folk vos hot nisht tsugehert tsu dem kol fun Hashem zeyer G-t, un nisht genumen kein musar; untergegangen iz der emes, un farshnitn fun zeyer moil.<verse eid="JER 7:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="JER 7:29" />shnaid op dain kroin hor un vorf avek,</para>
  <para style="q" vid="JER 7:29">un oif di hoiche erter heib oif a klog,</para>
  <para style="q" vid="JER 7:29">vorem faracht hot Hashem</para>
  <para style="q" vid="JER 7:29">un farlozen dem dor fun zain tsorn.<verse eid="JER 7:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30" />vorem di kinder fun Yehudah hobn geton vos iz shlecht in maine oign, zogt Hashem; zei hobn araingeton zeyere umverdikeitn in dem hoiz vos main nomen vert gerufn oif im, es tsu farumreinikn. <verse eid="JER 7:30" /><verse number="31" style="v" sid="JER 7:31" />un zei hobn geboit di bamot fun Tofes vos in tal fun Ben-Hinom, tsu farbrenen zeyere zin un zeyere techter in faier, vos nisht ich hob bafoiln, un nisht es iz oif main zinen aroifgekumen. <verse eid="JER 7:31" /><verse number="32" style="v" sid="JER 7:32" />derum ze, teg kumen, zogt Hashem, un es vet mer nisht gezogt vern Tofes un tal fun Ben-Hinom, naiert tal fun teitung, un me vet bagrobn in Tofes, vail mer kein ort vet nisht zain. <verse eid="JER 7:32" /><verse number="33" style="v" sid="JER 7:33" />un di toite laiber fun dem dozikn folk veln zain tsu shpaiz faran foigel fun himel, un far der chaye fun der erd, un keiner vet zei nisht opshrekn. <verse eid="JER 7:33" /><verse number="34" style="v" sid="JER 7:34" />un ich vel farshtern fun di shtet fun Yehudah, un fun di gasn fun Yerushalayim, dem kol fun lustikeit un dem kol fun freid, dem kol fun a chosen un dem kol fun a kale, vorem tsu vistenish vet vern dos land.<verse eid="JER 7:34" /></para>
  <chapter eid="JER 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="JER 8" />
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1" />in yener tsait, zogt Hashem, vet men aroistsien di beiner fun di mlochim fun Yehudah, un di beiner fun zaine harn, un di beiner fun di koyanim, un di beiner fun di neviim, un di beiner fun di bavoiner fun Yerushalayim, fun zeyere kvorim; <verse eid="JER 8:1" /><verse number="2" style="v" sid="JER 8:2" />un me vet zei oisshpreitn far der zun, un far der levone, un far dem gantsn cheil fun himel, vos zei hobn zei lib gehat, un vos zei hobn zei gedint, un vos zei zainen gegangen noch zei, un vos zei hobn zei gezucht, un vos zei hobn zich gebukt tsu zei; nisht aingezamlt un nisht bagrobn veln zei vern; vi mist oifn gezicht fun der erd veln zei zain. <verse eid="JER 8:2" /><verse number="3" style="v" sid="JER 8:3" />un toit vet zain liber fun lebn dem gantsn iberblaib vos vet blaibn fun der doziker beizer mishpoche, di vos veln iberblaiben in ale erter vos ich hob zei farshtoisen ahin, zogt Hashem Tseva'ot.<verse eid="JER 8:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="JER 8:4" />un zolst zogn tsu zei: azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 8:4">falt men un me shteit nisht oif?</para>
  <para style="q" vid="JER 8:4">tsi kert men zich op, un me kert nisht tsurik?<verse eid="JER 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 8:5" />far vos hot zich opgekert dos dozike folk, Yerushalayim,</para>
  <para style="q" vid="JER 8:5">an eibike opkerung?</para>
  <para style="q" vid="JER 8:5">zei haltn zich on batrug,</para>
  <para style="q" vid="JER 8:5">zei viln nisht tsurikkern.<verse eid="JER 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 8:6" />ich hob gehorcht un zich tsugehert,</para>
  <para style="q" vid="JER 8:6">nisht di richtikeit redn zei.</para>
  <para style="q" vid="JER 8:6">keiner hot nisht charote oif zain shlechtikeit,</para>
  <para style="q" vid="JER 8:6">tsu zogn: vos hob ich geton!</para>
  <para style="q" vid="JER 8:6">itlecher kert zich avek in zain gelaf,</para>
  <para style="q" vid="JER 8:6">vi a ferd vos yogt in milchome.<verse eid="JER 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 8:7" />afile der shtorch in himel veis ire geshtelte tsaitn,</para>
  <para style="q" vid="JER 8:7">un di turtltoib un di shvalb un der bushl</para>
  <para style="q" vid="JER 8:7">hitn di tsait fun zeyer kumen;</para>
  <para style="q" vid="JER 8:7">nor main folk veis nisht</para>
  <para style="q" vid="JER 8:7">dos gezets fun Hashem.<verse eid="JER 8:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JER 8:8" />vi kent ir zogn: chachomim zainen mir,</para>
  <para style="q" vid="JER 8:8">un di toyre fun Hashem iz bai undz?</para>
  <para style="q" vid="JER 8:8">far vor, ze, tsu falshkeit hot es</para>
  <para style="q" vid="JER 8:8">di falshe feder fun dem shraiber gemacht.<verse eid="JER 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 8:9" />farshemt zainen di chachomim,</para>
  <para style="q" vid="JER 8:9">dershrokn un batsvungen;</para>
  <para style="q" vid="JER 8:9">ze, dos vort fun Hashem hobn zei faracht,</para>
  <para style="q" vid="JER 8:9">un voser chochme iz bai zei?<verse eid="JER 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 8:10" />derum vel ich gebn zeyere vaiber tsu andere,</para>
  <para style="q" vid="JER 8:10">un zeyere felder tsu opyarsher;</para>
  <para style="q" vid="JER 8:10">vorem fun klenstn bizn grestn</para>
  <para style="q" vid="JER 8:10">iz itlecher gaitsik noch gevin;</para>
  <para style="q" vid="JER 8:10">fun novi bizn koyen tut itlecher falshkeit.<verse eid="JER 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 8:11" />un zei heiln dem broch fun der tochter main folk oif gring,</para>
  <para style="q" vid="JER 8:11">azoi tsu zogn: sholem! sholem! ven kein sholem iz nishto.<verse eid="JER 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 8:12" />hobn zei zich geshemt ven zei hobn geton toyeve?</para>
  <para style="q" vid="JER 8:12">vail umverdikeit hobn zei geton;</para>
  <para style="q" vid="JER 8:12">tsu mol sheme shemen zei zich nisht,</para>
  <para style="q" vid="JER 8:12">un fun kein bushe veisn zei nisht;</para>
  <para style="q" vid="JER 8:12">derum veln zei faln tsvishn di gefalene;</para>
  <para style="q" vid="JER 8:12">in der tsait fun zeyer rechnshaft</para>
  <para style="q" vid="JER 8:12">veln zei geshtroichlt vern,</para>
  <para style="qr" vid="JER 8:12">zogt Hashem.<verse eid="JER 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 8:13" />farlendn vel ich zei farlendn,</para>
  <para style="qr" vid="JER 8:13">zogt Hashem;</para>
  <para style="q" vid="JER 8:13">kein troibn oifn vainshtok,</para>
  <para style="q" vid="JER 8:13">un kein faign oifn faignboim,</para>
  <para style="q" vid="JER 8:13">un dos blat farvelkt!</para>
  <para style="q" vid="JER 8:13">un vos ich hob zei gegebn, vet avek fun zei.<verse eid="JER 8:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 8:14" />noch vos zitsn mir?</para>
  <para style="q" vid="JER 8:14">zamlt aich ain un lomir arain in di festungshtet,</para>
  <para style="q" vid="JER 8:14">un dortn farshnitn vern;</para>
  <para style="q" vid="JER 8:14">vorem Hashem Elokeinu hot undz farshnitn,</para>
  <para style="q" vid="JER 8:14">un undz ongetrunken mit geftvaser,</para>
  <para style="q" vid="JER 8:14">vail mir hobn gezindikt tsu Hashem.<verse eid="JER 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 8:15" />gehoft oif sholem, un kein guts iz nishto;</para>
  <para style="q" vid="JER 8:15">oif a tsait fun heilung, ersht a shrekenish.<verse eid="JER 8:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="JER 8:16" />fun Dan hert zich dos sopen fun zaine ferd,</para>
  <para style="q" vid="JER 8:16">fun dem kol fun di hirzhes fun zaine ogers</para>
  <para style="q" vid="JER 8:16">tsitert dos gantse land;</para>
  <para style="q" vid="JER 8:16">un zei kumen un fartseren dos land un ir fulkeit,</para>
  <para style="q" vid="JER 8:16">di shtot un di voiner in ir.<verse eid="JER 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 8:17" />vorem zet, ich shik on oif aich shleng, pipernoters,</para>
  <para style="q" vid="JER 8:17">vos far zei iz kein shpruch nishto,</para>
  <para style="q" vid="JER 8:17">un zei veln aich baisn,</para>
  <para style="qr" vid="JER 8:17">zogt Hashem.<verse eid="JER 8:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 8:18" />ich vil mich dermuntern in kumer,</para>
  <para style="q" vid="JER 8:18">iz main harts in mir krank.<verse eid="JER 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 8:19" />ze, a kol fun geshrei fun der tochter main folk,</para>
  <para style="q" vid="JER 8:19">fun a land a vaitn:</para>
  <para style="q" vid="JER 8:19">iz Hashem nishto in Tsiyon? iz ir kinig nishto in ir?</para>
  <para style="q" vid="JER 8:19">far vos hobn zei mich dertsernt mit zeyere getsn,</para>
  <para style="q" vid="JER 8:19">mit nishtikeitn fun der fremd?<verse eid="JER 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 8:20" />ariber der shnit, geendikt der zumer,</para>
  <para style="q" vid="JER 8:20">un mir zainen nisht geholfn gevorn.<verse eid="JER 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 8:21" />iber dem broch fun der tochter main folk bin ich tsebrochn,</para>
  <para style="q" vid="JER 8:21">fintster bin ich, a shrek hot mich ongenumen.<verse eid="JER 8:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JER 8:22" />iz kein balzam nishto in Gilad?</para>
  <para style="q" vid="JER 8:22">tsi iz kein roife nishto dort?</para>
  <para style="q" vid="JER 8:22">far vos den kumt nisht kein heilung</para>
  <para style="q" vid="JER 8:22">tsu der tochter main folk?<verse eid="JER 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" pubnumber="9.1" sid="JER 8:23" /> ver macht main kop vaser,</para>
  <para style="q" vid="JER 8:23">un main oig a kval trern,</para>
  <para style="q" vid="JER 8:23">ich volt baveint tog un nacht</para>
  <para style="q" vid="JER 8:23">di dershlogene fun der tochter main folk!<verse eid="JER 8:23" /></para>
  <chapter eid="JER 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="JER 9" />
  <para style="q">
    <verse number="1" style="v" pubnumber="9.2" sid="JER 9:1" /> ver git mir in midber</para>
  <para style="q" vid="JER 9:1">a harberik far vanderer,</para>
  <para style="q" vid="JER 9:1">ich volt farlozen main folk,</para>
  <para style="q" vid="JER 9:1">un avekgein fun zei!</para>
  <para style="q" vid="JER 9:1">vorem ale zainen zei noyefim,</para>
  <para style="q" vid="JER 9:1">a gezeml fun felsher.<verse eid="JER 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="9.3" sid="JER 9:2" /> un zei shpanen zeyer tsung – zeyer boign fun lign,</para>
  <para style="q" vid="JER 9:2">un nisht far emes zainen zei shtark in land;</para>
  <para style="q" vid="JER 9:2">vorem fun beiz tsu beiz geyen zei</para>
  <para style="q" vid="JER 9:2">un mich kenen zei nisht,</para>
  <para style="qr" vid="JER 9:2">zogt Hashem.<verse eid="JER 9:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" pubnumber="9.4" sid="JER 9:3" /> hit aich itlecher fun zain chever,</para>
  <para style="q" vid="JER 9:3">un oif kein bruder zolt ir aich nisht farzichern,</para>
  <para style="q" vid="JER 9:3">vorem narn nart itlecher bruder,</para>
  <para style="q" vid="JER 9:3">un itlecher chever traibt rechiles.<verse eid="JER 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" pubnumber="9.5" sid="JER 9:4" /> un einer dem andern genarn zei,</para>
  <para style="q" vid="JER 9:4">un emes zogn zei nisht;</para>
  <para style="q" vid="JER 9:4">zei hobn aingevoint zeyer tsung zogn lign,</para>
  <para style="q" vid="JER 9:4">zei matern zich tsu farbrechn.<verse eid="JER 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="9.6" sid="JER 9:5" /> dain zitsn iz tsvishn batrug;</para>
  <para style="q" vid="JER 9:5">fun vegen batrug viln zei mich nisht kenen,</para>
  <para style="qr" vid="JER 9:5">zogt Hashem.<verse eid="JER 9:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" pubnumber="9.7" sid="JER 9:6" /> derum hot Hashem Tseva'ot azoi gezogt:</para>
  <para style="q" vid="JER 9:6">ze, ich laiter zei, un vel zei pruvn,</para>
  <para style="q" vid="JER 9:6">vorem vi den zol ich ton</para>
  <para style="q" vid="JER 9:6">fun vegen der tochter main folk?<verse eid="JER 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" pubnumber="9.8" sid="JER 9:7" /> a farshpitste fail iz zeyer tsung,</para>
  <para style="q" vid="JER 9:7">zi redt batrug;</para>
  <para style="q" vid="JER 9:7">mitn moil redt men sholem mitn chever,</para>
  <para style="q" vid="JER 9:7">un in zich macht men a loyerung oif im.<verse eid="JER 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="9.9" sid="JER 9:8" /> zol ich derfar zich nisht oprechenen mit zei,</para>
  <para style="qr" vid="JER 9:8">zogt Hashem;</para>
  <para style="q" vid="JER 9:8">zol on a folk vi dos dozike</para>
  <para style="q" vid="JER 9:8">zich nisht noikem zain main zel?<verse eid="JER 9:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" pubnumber="9.10" sid="JER 9:9" /> vegen di berg vel ich oifheibn a gevein un yomer,</para>
  <para style="q" vid="JER 9:9">un vegen di fiterpletser fun midber a klog,</para>
  <para style="q" vid="JER 9:9">vorem zei zainen farvist,</para>
  <para style="q" vid="JER 9:9">az kein mentsh geit nisht durch,</para>
  <para style="q" vid="JER 9:9">un zei hern nisht kein kol fun fich;</para>
  <para style="q" vid="JER 9:9">fun a foigel fun himel biz a beheime</para>
  <para style="q" vid="JER 9:9">zainen antlofn, avek.<verse eid="JER 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="9.11" sid="JER 9:10" /> un ich vel machn Yerushalayim far hoifnt,</para>
  <para style="q" vid="JER 9:10">a voinung fun shakaln,</para>
  <para style="q" vid="JER 9:10">un di shtet fun Yehudah vel ich machn a vistenish,</para>
  <para style="q" vid="JER 9:10">on a bavoiner.<verse eid="JER 9:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" pubnumber="9.12" sid="JER 9:11" /> ver iz der kluger man, er zol dos farshtein? un der vos Hashems moil hot tsu im geredt, er zol dos zogn? far vos iz untergegangen dos land, farvist vi a midber, on a durchgeyer? <verse eid="JER 9:11" /><verse number="12" style="v" pubnumber="9.13" sid="JER 9:12" /> un Hashem hot gezogt: far vos zei hobn farlozen main toyre, vos ich hob geleigt far zei, un zei hobn nisht tsugehert tsu main kol, un nisht gegangen in ir; <verse eid="JER 9:12" /><verse number="13" style="v" pubnumber="9.14" sid="JER 9:13" /> naiert gegangen in der aingeshpartkeit fun zeyer hartsn, un noch di Baal-geter vos zeyere eltern hobn zei gelernt. <verse eid="JER 9:13" /><verse number="14" style="v" pubnumber="9.15" sid="JER 9:14" /> derum hot azoi gezogt Hashem Tseva'ot, Elokei Yisroel: ze, ich mach zei esen, dos dozike folk, vermut, un ich vel zei machn trinken giftvaser. <verse eid="JER 9:14" /><verse number="15" style="v" pubnumber="9.16" sid="JER 9:15" /> un ich vel zei tseshpreitn tsvishn di felker, vos nisht zei un nisht zeyere eltern hobn gekent, un ich vel nochshikn noch zei di shverd, biz ich tu zei farlendn.<verse eid="JER 9:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" pubnumber="9.17" sid="JER 9:16" /> azoi hot gezogt Hashem Tseva'ot:</para>
  <para style="q" vid="JER 9:16">kukt zich um, un ruft di klogerins, zei zoln kumen,</para>
  <para style="q" vid="JER 9:16">un noch di kluge vaiber shekt, zei zoln kumen;<verse eid="JER 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" pubnumber="9.18" sid="JER 9:17" /> un zoln zei ailn</para>
  <para style="q" vid="JER 9:17">un oifheibn oif undz a yomer,</para>
  <para style="q" vid="JER 9:17">az undzere oign zoln tsegein in trern,</para>
  <para style="q" vid="JER 9:17">un undzere bremen zoln flisn mit vaser.<verse eid="JER 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" pubnumber="9.19" sid="JER 9:18" /> vorem a yomer-kol hert zich fun Tsiyon:</para>
  <para style="q" vid="JER 9:18">vi zainen mir farvist gevorn!</para>
  <para style="q" vid="JER 9:18">mir zainen farshemt biz gor,</para>
  <para style="q" vid="JER 9:18">vail mir hobn farlozen dos land,</para>
  <para style="q" vid="JER 9:18">vail aroisgevorfn hobn undz undzere voinungen.<verse eid="JER 9:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" pubnumber="9.20" sid="JER 9:19" /> vorem hert, ir vaiber, dos vort fun Hashem,</para>
  <para style="q" vid="JER 9:19">un lernt aiere techter a yomer,</para>
  <para style="q" vid="JER 9:19">un eine di andere a klog.<verse eid="JER 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" pubnumber="9.21" sid="JER 9:20" /> vorem der toit iz aroifgegangen in undzere fentster,</para>
  <para style="q" vid="JER 9:20">gekumen in undzere palatsn,</para>
  <para style="q" vid="JER 9:20">tsu farshnaidn a kind fun der gas,</para>
  <para style="q" vid="JER 9:20">bechorim fun di merk. –<verse eid="JER 9:20" /></para>
  <para style="q">
    <verse number="21" style="v" pubnumber="9.22" sid="JER 9:21" /> red: azoi iz der shpruch fun Hashem –</para>
  <para style="q" vid="JER 9:21">un di toite laiber fun mentshn veln faln</para>
  <para style="q" vid="JER 9:21">vi mist oif fraien feld,</para>
  <para style="q" vid="JER 9:21">un vi a haifl hintern shniter,</para>
  <para style="q" vid="JER 9:21">vos keiner klaibt nisht oif.<verse eid="JER 9:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" pubnumber="9.23" sid="JER 9:22" /> azoi hot Hashem gezogt: zol zich nisht rimen der chochem mit zain chochme, un zol zich nisht rimen der gibor mit zain gevure; zol zich nisht rimen der oysher mit zain eshires; <verse eid="JER 9:22" /><verse number="23" style="v" pubnumber="9.24" sid="JER 9:23" /> nor dermit zol zich rimen der vos rimt zich, mit farshtein un kenen mich, az ich Hashem tu chesed, recht, un gerechtikeit, oif der erd; vail di dozike bager ich, zogt Hashem.<verse eid="JER 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="9.25" sid="JER 9:24" /> ze, teg kumen, zogt Hashem, un ich vel zich rechenen mit ale bashnitene un umbashnitene: <verse eid="JER 9:24" /><verse number="25" style="v" pubnumber="9.26" sid="JER 9:25" /> mit Mitsrayim, un mit Yehudah, un mit Edom, un mit di kinder fun Amon, un mit Moav, un mit ale vos mit opgehakte horekn, vos voinen in midber; vorem ale felker zainen umbashnitn, un dos gantse hoiz fun Yisroel zainen umbashnitn in hartsn.<verse eid="JER 9:25" /></para>
  <chapter eid="JER 9" />
  <chapter number="10" style="c" pubnumber="י" sid="JER 10" />
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1" />hert dos vort vos Hashem hot oif aich geredt, ir hoiz fun Yisroel: <verse eid="JER 10:1" /><verse number="2" style="v" sid="JER 10:2" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="JER 10:2" />
  <para style="q" vid="JER 10:2">dem veg fun di felker zolt ir zich nisht oplernen,</para>
  <para style="q" vid="JER 10:2">un far di tseichns fun himel zolt ir zich nisht shrekn,</para>
  <para style="q" vid="JER 10:2">vail di felker shrekn zich far zei.<verse eid="JER 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 10:3" />vorem di minhogim fun di umes, dos iz nishtikeit;</para>
  <para style="q" vid="JER 10:3">vorem es iz a holts vos me hot fun vald oisgehakt,</para>
  <para style="q" vid="JER 10:3">dos verk fun a mainsters hent mit der hubl.<verse eid="JER 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 10:4" />mit zilber un mit gold basheint men es,</para>
  <para style="q" vid="JER 10:4">mit negl un mit hamers bafestikt men es,</para>
  <para style="q" vid="JER 10:4">es zol zich nisht vaklen.<verse eid="JER 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 10:5" />vi a shrekfoigl in a plutserfeld zainen zei,</para>
  <para style="q" vid="JER 10:5">un zei kenen nisht redn;</para>
  <para style="q" vid="JER 10:5">trogn muzn zei getrogn vern,</para>
  <para style="q" vid="JER 10:5">vail zei kenen nisht shpraizn.</para>
  <para style="q" vid="JER 10:5">ir zolt nisht moire hobn far zei,</para>
  <para style="q" vid="JER 10:5">vorem zei kenen nisht beiz ton,</para>
  <para style="q" vid="JER 10:5">un oich guts ton iz nishto in zei.<verse eid="JER 10:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 10:6" />nishto dain glaichn, Hashem,</para>
  <para style="q" vid="JER 10:6">grois bistu, un grois iz dain nomen in gevure.<verse eid="JER 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 10:7" />ver zol dich nisht forchtn, kinig fun di felker?</para>
  <para style="q" vid="JER 10:7">far vor, dir kumt es,</para>
  <para style="q" vid="JER 10:7">vorem tsvishn ale kligste felker,</para>
  <para style="q" vid="JER 10:7">un in al zeyer meluche,</para>
  <para style="q" vid="JER 10:7">iz nishto dain glaichn.<verse eid="JER 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 10:8" />un ale in einem zainen zei fargrebt un narish;</para>
  <para style="q" vid="JER 10:8">a nishtike lernung, a holts iz dos.<verse eid="JER 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 10:9" />zilberblech fun Tarshish gebracht,</para>
  <para style="q" vid="JER 10:9">un gold fun Ufaz,</para>
  <para style="q" vid="JER 10:9">di arbet fun a mainster,</para>
  <para style="q" vid="JER 10:9">un a shmeltsers hent;</para>
  <para style="q" vid="JER 10:9">blo un purpl iz zeyer malbesh,</para>
  <para style="q" vid="JER 10:9">di arbet fun kintsler zainen zei ale.<verse eid="JER 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 10:10" />ober Hashem Elokim iz der emeser G-t,</para>
  <para style="q" vid="JER 10:10">er iz der Elokim cheim, un der eibiker kinig;</para>
  <para style="q" vid="JER 10:10">fun zain kaas tsitert di erd,</para>
  <para style="q" vid="JER 10:10">un felker kenen nisht oishaltn zain tsorn.<verse eid="JER 10:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JER 10:11" />azoi zolt ir zogn tsu zei: di g‑ter vos hobn di himlen un di erd nisht gemacht, veln untergein fun der erd un fun unter di dozike himlen.<verse eid="JER 10:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JER 10:12" />er hot gemacht di erd mit zain koiech,</para>
  <para style="q" vid="JER 10:12">bafestikt di velt mit zain chochme,</para>
  <para style="q" vid="JER 10:12">un mit zain farshtandikeit di himlen farshpreit.<verse eid="JER 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 10:13" />baim kol fun zain dunern</para>
  <para style="q" vid="JER 10:13">vert a filkeit fun vaser in himel;</para>
  <para style="q" vid="JER 10:13">un er brengt oif volken fun ek fun der erd;</para>
  <para style="q" vid="JER 10:13">er macht blitsn tsum regn,</para>
  <para style="q" vid="JER 10:13">un tsit arois fun zaine shpaichlers dem vint.<verse eid="JER 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 10:14" />itlecher mentsh iz fargrebt, on farshtand,</para>
  <para style="q" vid="JER 10:14">itlecher shmeltser vert tsu shand fun dem gets;</para>
  <para style="q" vid="JER 10:14">vorem falsh iz zain gegosener opgot,</para>
  <para style="q" vid="JER 10:14">un kein otem iz in zei nishto.<verse eid="JER 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 10:15" />nishtik zainen zei, a verk fun farfirenish;</para>
  <para style="q" vid="JER 10:15">in der tsait fun zeyer rechnshaft veln zei untergein.<verse eid="JER 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 10:16" />nisht vi di dozike iz der chelek fun Yaakov;</para>
  <para style="q" vid="JER 10:16">vorem er iz der Bashefer fun alts,</para>
  <para style="q" vid="JER 10:16">un Yisroel iz der sheyvet fun zain arav;</para>
  <para style="q" vid="JER 10:16">Hashem Tseva'ot iz zain nomen.<verse eid="JER 10:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JER 10:17" />klaib oif fun der erd dain bintel,</para>
  <para style="q" vid="JER 10:17">du vos zitsst in balegerung.<verse eid="JER 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 10:18" />vorem azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 10:18">ze, ich shlaider arois dos mol di bavoiner fun land,</para>
  <para style="q" vid="JER 10:18">un vel zei tsudrikn, kedei zei zoln dershpirn.<verse eid="JER 10:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JER 10:19" />vei mir oif main broch!</para>
  <para style="q" vid="JER 10:19">shver iz main vund!</para>
  <para style="q" vid="JER 10:19">un ich hob gevest gezogt: a krankshaft nor iz dos,</para>
  <para style="q" vid="JER 10:19">un ich vel zi aribertrogn.<verse eid="JER 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 10:20" />main getselt iz farvist,</para>
  <para style="q" vid="JER 10:20">un ale maine shtrik zainen tserisn,</para>
  <para style="q" vid="JER 10:20">maine kinder zainen arois fun ir un zainen nito.</para>
  <para style="q" vid="JER 10:20">nishto ver zol oisshpreitn vider main getselt,</para>
  <para style="q" vid="JER 10:20">un ver zol oiftsien maine forhangen.<verse eid="JER 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 10:21" />vorem fargrebt zainen di pastucher,</para>
  <para style="q" vid="JER 10:21">un Hashem hobn zei nisht gezucht;</para>
  <para style="q" vid="JER 10:21">derum hob zei nisht baglikt,</para>
  <para style="q" vid="JER 10:21">un zeyer gantse stade iz tseshpreit gevorn.<verse eid="JER 10:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JER 10:22" />horch! a herung ot kumt,</para>
  <para style="q" vid="JER 10:22">un a groiser raash fun tsofn-land,</para>
  <para style="q" vid="JER 10:22">tsu machn di shtet fun Yehudah a vistenish,</para>
  <para style="q" vid="JER 10:22">a voinung fun shakaln.<verse eid="JER 10:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JER 10:23" />ich veis, Hashem, az nisht baim mentshn iz zain veg,</para>
  <para style="q" vid="JER 10:23">nisht baim mentshn iz geyendik tsu lenken zain trit.<verse eid="JER 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 10:24" />shtrof mich, Hashem, ober mit gerechtikeit,</para>
  <para style="q" vid="JER 10:24">nisht in dain tsorn, kedei zolst mich nisht farminern.<verse eid="JER 10:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="JER 10:25" />gis oich dain grimtsorn oif di felker vos kenen dich nisht,</para>
  <para style="q" vid="JER 10:25">un oif di mishpoches vos rufn nisht dain nomen,</para>
  <para style="q" vid="JER 10:25">vorem fartsert hobn zei Yaakov,</para>
  <para style="q" vid="JER 10:25">yo, im fartsert un im farlendt,</para>
  <para style="q" vid="JER 10:25">un zain voinung farvist.<verse eid="JER 10:25" /></para>
  <chapter eid="JER 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="JER 11" />
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem, azoi tsu zogn: <verse eid="JER 11:1" /><verse number="2" style="v" sid="JER 11:2" />hert di verter fun dem dozikn bris, un ir zolt redn tsu di mener fun Yehudah, un tsu di bavoiner fun Yerushalayim, <verse eid="JER 11:2" /><verse number="3" style="v" sid="JER 11:3" />un zolst zogn tsu zei: azoi hot gezogt Hashem Elokei Yisroel: farsholten der man vos vet nisht tsuhern di verter fun dem dozikn bris, <verse eid="JER 11:3" /><verse number="4" style="v" sid="JER 11:4" />vos ich hob bafoiln aiere eltern in dem tog vos ich hob zei aroisgetsoign fun land Mitsrayim, fun dem aiznshmeltsoivn, azoi tsu zogn: hert tsu main kol; un ir zolt zei ton, azoi vi alts vos ich bafel aich: un ir vet mir zain tsum folk, un ich vel aich zain tsum Elokim; <verse eid="JER 11:4" /><verse number="5" style="v" sid="JER 11:5" />kedei mekayem tsu zain di shvue vos ich hob geshvorn aiere eltern, zei tsu gebn a land vos flist mit milch un honik, azoi vi haintikn tog. hob ich geentfert un gezogt: Omein, Hashem!<verse eid="JER 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6" />un Hashem hot tsu mir gezogt: ruf ois di ale verter in di shtet fun Yehudah, un in di gasn fun Yerushalayim, azoi tsu zogn: hert di verter fun dem dozikn bris, un ir zolt zei ton. <verse eid="JER 11:6" /><verse number="7" style="v" sid="JER 11:7" />vorem vorenen hob ich gevornt aiere eltern fun dem tog vos ich hob aich oifgebracht fun land Mitsrayim, biz oif haintikn tog, nochanand un nochanand gevornt, azoi tsu zogn: hert tsu main kol. <verse eid="JER 11:7" /><verse number="8" style="v" sid="JER 11:8" />ober zei hobn nisht tsugehert, un nisht tsugenaigt zeyer oiern, un zei zainen gegangen itlecher in der aingeshpartkeit fun zeyer beizn hartsn, un ich hob gebracht oif zei ale verter fun dem dozikn bris, vos ich hob zei bafoiln tsu ton, un zei hobn nisht geton.<verse eid="JER 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9" />un Hashem hot tsu mir gezogt: a bunt gefint zich bai di mener fun Yehudah, un bai di bavoiner fun Yerushalayim. <verse eid="JER 11:9" /><verse number="10" style="v" sid="JER 11:10" />zei hobn zich umgekert tsu di zind fun zeyere ureltern, vos hobn nisht gevolt tsuhern maine verter; un zei zainen gegangen noch fremde g‑ter zei tsu dinen; farshtert hobn dos hoiz fun Yisroel un dos hoiz fun Yehudah main bris vos ich hob geshlosn mit zeyere eltern. <verse eid="JER 11:10" /><verse number="11" style="v" sid="JER 11:11" />derum hot Hashem azoi gezogt: ze, ich breng oif zei an umglik vos zei veln fun im nisht kenen aroisgein, un zei veln shraien tsu mir, un ich vel nisht tsuhern tsu zei. <verse eid="JER 11:11" /><verse number="12" style="v" sid="JER 11:12" />un di shtet fun Yehudah un di bavoiner fun Yerushalayim veln gein un veln shraien tsu di g‑ter vos zei reichern tsu zei, ober helfn veln zei zei nisht helfn, in der tsait fun zeyer umglik. <verse eid="JER 11:12" /><verse number="13" style="v" sid="JER 11:13" />vorem azoi vi di tsol fun daine shtet zainen daine g‑ter, Yehudah, un azoi vi di tsol fun di gasn fun Yerushalayim hot ir gemacht mizbeyches tsu shandgetsn, mizbeyches far reichern tsu Baal.<verse eid="JER 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 11:14" />un du, zolst nisht mispalel zain far dem dozikn folk, un nisht oifheibn a geshrei un a tfile far zei. vorem ich her nisht tsu beeis zei rufn tsu mir fun vegen zeyer umglik. <verse eid="JER 11:14" /><verse number="15" style="v" sid="JER 11:15" />vos tut main libfraint in main hoiz, az zi bageit shendlechkeit mit fil? un zol durch heilik fleish dos opgeton vern fun dir? az bai dain shlechtikeit, dentsmol freistu zich. <verse eid="JER 11:15" /><verse number="16" style="v" sid="JER 11:16" />a tsvaighaftiker eilbertboim, shein mit frucht fainer, hot Hashem gerufn dain nomen; ober mit grois liaremgepilder hot er ongetsundn a faier deroif, un zaine tsvaign veln tseshter vern. <verse eid="JER 11:16" /><verse number="17" style="v" sid="JER 11:17" />vorem Hashem Tseva'ot, vos hot dich geflantst, hot ongezogt shlechts oif dir, fun vegen der shlechtikeit fun dem hoiz fun Yisroel un dem hoiz fun Yehudah, vos zei hobn bai zich geton, mich tsu dertserenen mit reichern tsu Baal.<verse eid="JER 11:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 11:18" />un Hashem hot mich gelozt visen, un ich veis;</para>
  <para style="q" vid="JER 11:18">dentsmol hostu mir bavizn zeyere meisim.<verse eid="JER 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 11:19" />un ich bin geven vi a shof a milde,</para>
  <para style="q" vid="JER 11:19">vos vert tsu der shechtn gefirt;</para>
  <para style="q" vid="JER 11:19">un ich hob nisht gevust</para>
  <para style="q" vid="JER 11:19">az zei trachtn oif mir trachtungen:</para>
  <para style="q" vid="JER 11:19">lomir umbrengen dem boim mit zain frucht,</para>
  <para style="q" vid="JER 11:19">un im farshnaidn fun land fun di lebedike,</para>
  <para style="q" vid="JER 11:19">az zain nomen zol mer nisht gedacht vern.<verse eid="JER 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 11:20" />un du Hashem Tseva'ot vos mishpetst gerecht,</para>
  <para style="q" vid="JER 11:20">vos pruvst di nirun un dos harts,</para>
  <para style="q" vid="JER 11:20">lomich zen dain nekome oif zei,</para>
  <para style="q" vid="JER 11:20">vorem tsu dir hob ich antplekt main krig.<verse eid="JER 11:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21" />derum hot Hashem azoi gezogt oif di lait fun Anatot vos zuchn dain lebn, azoi tsu zogn: zolst nisht nevies zogn in nomen fun Hashem, kedei zolst nisht shtarbn fun undzer hant; <verse eid="JER 11:21" /><verse number="22" style="v" sid="JER 11:22" />derum hot Hashem Tseva'ot azoi gezogt: ze, ich rechn zich op mit zei; di yungelait veln shtarbn fun shverd, zeyere zin un zeyere techter veln shtarbn fun hunger. <verse eid="JER 11:22" /><verse number="23" style="v" sid="JER 11:23" />un kein iberblaib zol tsu zei nisht zain, vorem ich breng an umglik oif di lait fun Anatot, dos yor fun zeyer rechnshaft.<verse eid="JER 11:23" /></para>
  <chapter eid="JER 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="JER 12" />
  <para style="q">
    <verse number="1" style="v" sid="JER 12:1" />gerecht vestu blaibn, Hashem,</para>
  <para style="q" vid="JER 12:1">ven ich zol zich krign mit dir;</para>
  <para style="q" vid="JER 12:1">ober gerechtikeit vil ich redn tsu dir:</para>
  <para style="q" vid="JER 12:1">far vos iz der veg fun reshoim metslich?</para>
  <para style="q" vid="JER 12:1">far vos lebn ruik ale felsher falshe?<verse eid="JER 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 12:2" />flantst zei, un zei vortselen zich ain,</para>
  <para style="q" vid="JER 12:2">zei geyen oif un trogn fruchtn;</para>
  <para style="q" vid="JER 12:2">nont bistu in zeyer moil,</para>
  <para style="q" vid="JER 12:2">un vait fun zeyere nirn.<verse eid="JER 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 12:3" />un du, Hashem, kenst mich,</para>
  <para style="q" vid="JER 12:3">zest mich, un host gepruvet main harts tsu dir;</para>
  <para style="q" vid="JER 12:3">shlep zei avek vi shof tsu der shechite,</para>
  <para style="q" vid="JER 12:3">un gib zei op tsum tog fun teitung.<verse eid="JER 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 12:4" />biz vanen vet troiern dos land,</para>
  <para style="q" vid="JER 12:4">un dos groz fun gantsn feld vet zain fartriknt?</para>
  <para style="q" vid="JER 12:4">fun vegen der shlechtikeit fun di voiner in ir.</para>
  <para style="q" vid="JER 12:4">zainen umgekumen beheimes un foiglen;</para>
  <para style="q" vid="JER 12:4">vail zei hobn gezogt: er zet nisht undzer sof.<verse eid="JER 12:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JER 12:5" />oib mit fusgeyer bistu gelofn,</para>
  <para style="q" vid="JER 12:5">un zei hobn dich mid gemacht,</para>
  <para style="q" vid="JER 12:5">hint vi vilstu zich mit ferd farmestn?</para>
  <para style="q" vid="JER 12:5">un bistu zicher in land fun frid,</para>
  <para style="q" vid="JER 12:5">vi vestu ober ton in dem geveld fun Yarden?<verse eid="JER 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 12:6" />vorem afile daine brider in dain foters hoiz,</para>
  <para style="q" vid="JER 12:6">afile zei hobn gefelsht on dir,</para>
  <para style="q" vid="JER 12:6">afile zei hobn dir nochgeshrien mit a fuler kel;</para>
  <para style="q" vid="JER 12:6">nisht gloib zei ven zei redn gut tsu dir.<verse eid="JER 12:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 12:7" />ich hob farlozen main hoiz,</para>
  <para style="q" vid="JER 12:7">ich hob avekgevorfen main arav;</para>
  <para style="q" vid="JER 12:7">ich hob ibergegebn di gelibte fun main zel</para>
  <para style="q" vid="JER 12:7">in der hant fun ire faint.<verse eid="JER 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 12:8" />main arav iz mir gevorn vi a leib in vald,</para>
  <para style="q" vid="JER 12:8">zi hot oifgehoibn ir kol oif mir,</para>
  <para style="q" vid="JER 12:8">derum hob ich zi faint gekrogn.<verse eid="JER 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 12:9" />iz a kloiiker roibfoigl main arav mir?</para>
  <para style="q" vid="JER 12:9">di roibfoiglen zainen rund arum ir?</para>
  <para style="q" vid="JER 12:9">geit zamlt ale chayes fun feld,</para>
  <para style="q" vid="JER 12:9">brengt zei aher tsu esen.<verse eid="JER 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 12:10" />fil pastucher hobn fardorben main vaingorten,</para>
  <para style="q" vid="JER 12:10">tsetretn main feld;</para>
  <para style="q" vid="JER 12:10">zei hobn gemacht main flustik feld</para>
  <para style="q" vid="JER 12:10">far a midber a vister.<verse eid="JER 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 12:11" />me hot es gemacht far a vistenish,</para>
  <para style="q" vid="JER 12:11">es troiert tsu mir visterheit;</para>
  <para style="q" vid="JER 12:11">farvist iz dos gantse land,</para>
  <para style="q" vid="JER 12:11">vorem kein mentsh nemt nisht tsum hartsn.<verse eid="JER 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 12:12" />oif ale hoiche erter in midber</para>
  <para style="q" vid="JER 12:12">zainen farvister gekumen,</para>
  <para style="q" vid="JER 12:12">vorem Hashems shverd fartsert fun ek land biz ek land,</para>
  <para style="q" vid="JER 12:12">nishto kein frid far kein laib.<verse eid="JER 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 12:13" />zei hobn gezeit veits, un derner geshnitn,</para>
  <para style="q" vid="JER 12:13">zich geplogt – kein nuts nisht gebracht;</para>
  <para style="q" vid="JER 12:13">derum shemt aich mit aiere tvues,</para>
  <para style="q" vid="JER 12:13">fun vegen dem grimtsorn fun Hashem.<verse eid="JER 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14" />azoi hot Hashem gezogt – oif ale maine beize shecheynim, vos rirn on di arav vos ich hob gemacht arben main folk Yisroel: ze, ich rais zei ois fun zeyer erd, un dos hoiz fun Yehudah vel ich oisraisn fun tsvishn zei. <verse eid="JER 12:14" /><verse number="15" style="v" sid="JER 12:15" />un es vet zain, nochdem vi ich rais zei ois vel ich zei vider derbaremen, un vel zei umkeren itlechn tsu zain nachle, un itlechn tsu zain land. <verse eid="JER 12:15" /><verse number="16" style="v" sid="JER 12:16" />un es vet zain, oib lernen veln zei lernen di vegen fun main folk, tsu shvern bai main nomen: azoi vi Hashem lebt! azoi vi zei hobn gelernt main folk tsu shvern bai Baal, azoi veln zei geboit vern tsvishn main folk. <verse eid="JER 12:16" /><verse number="17" style="v" sid="JER 12:17" />oib ober zei veln nisht tsuhern, vel ich oisraisn yene ume, oisraisn un unterbrengen, zogt Hashem.<verse eid="JER 12:17" /></para>
  <chapter eid="JER 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="JER 13" />
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1" />azoi hot Hashem tsu mir gezogt: gei un zolst dir koifn a flaksenem gartel, un im onton oif daine lendn, un in vaser zolstu im nisht lozn kumen. <verse eid="JER 13:1" /><verse number="2" style="v" sid="JER 13:2" />hob ich gekoift dem gartel azoi vi dos vort fun Hashem, un ongeton oif maine lendn. <verse eid="JER 13:2" /><verse number="3" style="v" sid="JER 13:3" />un dos vort fun Hashem iz geven tsu mir a tsveit mol, azoi tsu zogn: <verse eid="JER 13:3" /><verse number="4" style="v" sid="JER 13:4" />nem dem gartel vos du host gekoift, vos oif daine lendn, un shtei oif, gei dir kein Parat, un bahalt im dortn in a shpalt fun feldz. <verse eid="JER 13:4" /><verse number="5" style="v" sid="JER 13:5" />bin ich gegangen un hob im bahaltn in Parat azoi vi Hashem hot mir bafoiln. <verse eid="JER 13:5" /><verse number="6" style="v" sid="JER 13:6" />un es iz geven tsum sof fun fil teg, hot Hashem tsu mir gezogt: shtei oif, gei kein Parat, un nem arois fun dortn dem gartel, vos ich hob dir bafoiln im dortn tsu bahaltn. <verse eid="JER 13:6" /><verse number="7" style="v" sid="JER 13:7" />bin ich gegangen kein Parat, un hob oifgegorbn, un aroisgenumen dem gartel fun dem ort vos ich hob im dortn bahaltn; ersht der gartel iz geven fardorben, er hot nisht getoigt tsu kein zats.<verse eid="JER 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 13:8" />iz dos vort fun Hashem geven tsu mir, azoi tsu zogn: <verse eid="JER 13:8" /><verse number="9" style="v" sid="JER 13:9" />azoi hot Hashem gezogt: azoi vel ich fardorben dem shtolts fun Yehudah, un dem shtolts fun Yerushalayim, dem groisn. <verse eid="JER 13:9" /><verse number="10" style="v" sid="JER 13:10" />dos dozike beize folk vos viln nisht hern maine verter, vos geyen in der aingeshpartkeit fun zeyer hartsn, un zainen gegangen noch fremde g‑ter zei tsu dinen, un zich tsu bukn tsu zei, veln vern vi der doziker gartel vos toig nisht tsu kein zach. <verse eid="JER 13:10" /><verse number="11" style="v" sid="JER 13:11" />vorem azoi vi der gartel iz baheft tsu di lendn fun a man, azoi hob ich baheft tsu mir dos gantse hoiz fun Yisroel, un dos gantse hoiz fun Yehudah, zogt Hashem, mir tsu zain far a folk, un far a nomen, un far a loib, un far a sheinkeit; ober zei hobn nisht tsugehert.<verse eid="JER 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12" />un zolst zogn tsu zei dos dozike vort: azoi hot gezogt Hashem Elokei Yisroel: yetveder krug vert ongefilt mit vain. un az zei veln zogn tsu dir: veisn mir den nisht voil, az yetveder krug vert ongefilt mit vain? <verse eid="JER 13:12" /><verse number="13" style="v" sid="JER 13:13" />zolstu zogn tsu zei: azoi hot Hashem gezogt: ze, ich fil on ale bavoiner fun dem dozikn land, un di mlochim vos zitsn fun Dovidn oif zain tron, un di koyanim, un di neviim, un ale bavoiner fun Yerushalayim, mit shikrut. <verse eid="JER 13:13" /><verse number="14" style="v" sid="JER 13:14" />un ich vel zei tsehakn einem on andern, i di foters i di zin in einem, zogt Hashem; ich vel nisht shoinen, un nisht derbaremen, un nisht rachmones hobn, zei nisht umtsubrengen.<verse eid="JER 13:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JER 13:15" />hert un leigt tsu dos oier,</para>
  <para style="q" vid="JER 13:15">ir zolt aich nisht derheibn,</para>
  <para style="q" vid="JER 13:15">vorem Hashem hot geredt;<verse eid="JER 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 13:16" />git koved tsu Hashem Elokeichem,</para>
  <para style="q" vid="JER 13:16">eider es vet fintster vern,</para>
  <para style="q" vid="JER 13:16">un eider aiere fis veln zich opshlogn</para>
  <para style="q" vid="JER 13:16">oif di nachtike berg,</para>
  <para style="q" vid="JER 13:16">un ir vet hofn oif licht,</para>
  <para style="q" vid="JER 13:16">un er vet es machn tsu toitshotn,</para>
  <para style="q" vid="JER 13:16">un farkern in choishechnish.<verse eid="JER 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 13:17" />un az ir vet dos nisht tsuhern,</para>
  <para style="q" vid="JER 13:17">vet veinen in farborgenish main zel</para>
  <para style="q" vid="JER 13:17">fun vegen der hoferdikeit,</para>
  <para style="q" vid="JER 13:17">un trern vet trern,</para>
  <para style="q" vid="JER 13:17">un tsegein vet in trern, main oig,</para>
  <para style="q" vid="JER 13:17">vos di stade fun Hashem vert gefangen.<verse eid="JER 13:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 13:18" />zog tsu dem melech un tsu der muter-malke:</para>
  <para style="q" vid="JER 13:18">zetst aich arop niderik,</para>
  <para style="q" vid="JER 13:18">vorem es hot aropgenidert fun aier kop,</para>
  <para style="q" vid="JER 13:18">aiere herliche kroin.<verse eid="JER 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 13:19" />di shtet fun dorem zainen farshlosn,</para>
  <para style="q" vid="JER 13:19">un nito ver zol efenen;</para>
  <para style="q" vid="JER 13:19">gants Yehudah iz fartriben gevorn,</para>
  <para style="q" vid="JER 13:19">fartriben gevorn in gantsn.<verse eid="JER 13:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JER 13:20" />heibt oif aiere oign, un zet</para>
  <para style="q" vid="JER 13:20">di vos kumen fun tsofn;</para>
  <para style="q" vid="JER 13:20">vu iz di stade vos iz dir gegebn gevorn?</para>
  <para style="q" vid="JER 13:20">di sheine shof daine?<verse eid="JER 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 13:21" />vos vestu zogn ven er vet onzetsn oif dir,</para>
  <para style="q" vid="JER 13:21">di vos du host zei aingevoint far firshtn iber dir?</para>
  <para style="q" vid="JER 13:21">far vor, veyen veln dich onnemen,</para>
  <para style="q" vid="JER 13:21">vi a froi tsu kind.<verse eid="JER 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 13:22" />un oib du vest zogn in dain hartsn:</para>
  <para style="q" vid="JER 13:22">far vos hot dos mir getrofn?</para>
  <para style="q" vid="JER 13:22">far dain grois zind zainen oifgedekt gevorn daine bregn,</para>
  <para style="q" vid="JER 13:22">antbloizt gevorn daine trit.<verse eid="JER 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 13:23" />ken a Kushi baitn zain hoit,</para>
  <para style="q" vid="JER 13:23">un a lempert zaine flekn?</para>
  <para style="q" vid="JER 13:23">azoi kent ir guts ton,</para>
  <para style="q" vid="JER 13:23">ir tsugevointe beiz tsu ton.<verse eid="JER 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 13:24" />derum vel ich zei tseshpreitn vi shprei</para>
  <para style="q" vid="JER 13:24">vos fargeit faran vint fun midber.<verse eid="JER 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 13:25" />dos iz dain goirl,</para>
  <para style="q" vid="JER 13:25">dain tsugemostener teil fun mir,</para>
  <para style="qr" vid="JER 13:25">zogt Hashem,</para>
  <para style="q" vid="JER 13:25">vail du host fargesen on mir,</para>
  <para style="q" vid="JER 13:25">un zich farzichert oif lign.<verse eid="JER 13:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 13:26" />derum oifdek ich oich oif daine bregn iber dain ponem,</para>
  <para style="q" vid="JER 13:26">un gezen vern vet dain shand.<verse eid="JER 13:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 13:27" />dain niuf un daine hirzhes,</para>
  <para style="q" vid="JER 13:27">di shendlechkeit fun dain zoines –</para>
  <para style="q" vid="JER 13:27">oif di heichn in feld hob ich gezen daine umverdikeitn.</para>
  <para style="q" vid="JER 13:27">vei dir, Yerushalayim, vist nisht rein vern!</para>
  <para style="q" vid="JER 13:27">biz iber vanen noch?<verse eid="JER 13:27" /></para>
  <chapter eid="JER 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="JER 14" />
  <para style="p">
    <verse number="1" style="v" sid="JER 14:1" />vos dos vort fun Hashem iz geven tsu Yirmeyahun vegen di trikenishn.<verse eid="JER 14:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JER 14:2" />es troiert Yehudah,</para>
  <para style="q" vid="JER 14:2">un ire toiern zainen farshmacht,</para>
  <para style="q" vid="JER 14:2">zei zainen fintster tsu der erd;</para>
  <para style="q" vid="JER 14:2">un dos geshrei fun Yerushalayim geit oif.<verse eid="JER 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 14:3" />un zeyer pnei shikn zeyere yungen noch vaser;</para>
  <para style="q" vid="JER 14:3">zei kumen tsu di griber, gefinen zei nisht kein vaser,</para>
  <para style="q" vid="JER 14:3">zeyer keilim kern zich um leidik;</para>
  <para style="q" vid="JER 14:3">zei zainen in biesh un farshemt,</para>
  <para style="q" vid="JER 14:3">un fardekn zeyere kep.<verse eid="JER 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 14:4" />fun vegen der erd vos iz tseplatst,</para>
  <para style="q" vid="JER 14:4">vail kein regn iz nishto in land,</para>
  <para style="q" vid="JER 14:4">zainen di akerlait farshemt gevorn,</para>
  <para style="q" vid="JER 14:4">zei fardekn zeyere kep.<verse eid="JER 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 14:5" />vorem afile a hindin in veld gebert un farlozt,</para>
  <para style="q" vid="JER 14:5">vail kein groz iz nishto.<verse eid="JER 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 14:6" />un di vilde eizlen shteyen oif di hoiche erter,</para>
  <para style="q" vid="JER 14:6">zei shlingen dem vint vi shakaln;</para>
  <para style="q" vid="JER 14:6">zeyere oign geyen ois,</para>
  <para style="q" vid="JER 14:6">vail kein kraitechts iz nishto.<verse eid="JER 14:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 14:7" />oib undzere zind zogn eides kegen undz, Hashem,</para>
  <para style="q" vid="JER 14:7">tu fun dain nomen vegen;</para>
  <para style="q" vid="JER 14:7">vorem fil zainen undzere opkerungen,</para>
  <para style="q" vid="JER 14:7">mir hobn gezindikt tsu dir.<verse eid="JER 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 14:8" />du hofenung fun Yisroel,</para>
  <para style="q" vid="JER 14:8">zain helfer in tsait fun noit,</para>
  <para style="q" vid="JER 14:8">far vos zolstu zain vi a fremder in land,</para>
  <para style="q" vid="JER 14:8">un vi a vanderer vos farkert tsu nechtikn?<verse eid="JER 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 14:9" />far vos zolstu zain vi a tsetumler mentsh,</para>
  <para style="q" vid="JER 14:9">vi a gibor vos ken nisht helfn?</para>
  <para style="q" vid="JER 14:9">du bist doch tsvishn undz, Hashem,</para>
  <para style="q" vid="JER 14:9">un dain nomen vert gerufn oif undz;</para>
  <para style="q" vid="JER 14:9">nisht tu undz farlozen.<verse eid="JER 14:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 14:10" />azoi hot Hashem gezogt tsu dem dozikn folk:</para>
  <para style="q" vid="JER 14:10">azoi hobn zei lib umtsuvandern,</para>
  <para style="q" vid="JER 14:10">zei haltn nisht op zeyere fis;</para>
  <para style="q" vid="JER 14:10">ober Hashem hot zei nisht ongenumen,</para>
  <para style="q" vid="JER 14:10">atsund vet er zeyere zind gedenken</para>
  <para style="q" vid="JER 14:10">un zeyere zind vet er bashtrofn.<verse eid="JER 14:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JER 14:11" />un Hashem hot tsu mir gezogt: zolst nisht mispalel zain far dem dozikn folk tsum gutn. <verse eid="JER 14:11" /><verse number="12" style="v" sid="JER 14:12" />az zei fasten, her ich nisht tsu zeyer geshrei, un az zei brengen oif brandopfer un shpaizopfer, bavilik ich zei nisht – naiert mit shverd un mit hunger un mit pest tu ich zei farlendn.<verse eid="JER 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13" />hob ich gezogt: vei, Hashem du Adonoi, ze, di neviim zogn tsu zei: ir vet nisht onzen kein shverd, un kein hunger vet bai aich nisht zain, vorem a zichern sholem vel ich aich gebn in dem dozikn ort. <verse eid="JER 14:13" /><verse number="14" style="v" sid="JER 14:14" />hot Hashem tsu mir gezogt: lign zogn nevies di neviim in main nomen; nisht ich hob zei geshikt, un nisht ich hob zei bafoiln, un nisht ich hob tsu zei geredt; zeung fun lign, un vorzogechts un nishtikeit, un batrug fun zeyer hartsn, zogn zei aich nevies. <verse eid="JER 14:14" /><verse number="15" style="v" sid="JER 14:15" />derum hot Hashem azoi gezogt – oif di neviim vos zogn nevies in main nomen, ven ich hob zei nisht geshikt, un zei zogn: kein shverd un kein hunger vet nisht zain in dem dozikn land – fun shverd un fun hunger veln farlendt vern yene neviim. <verse eid="JER 14:15" /><verse number="16" style="v" sid="JER 14:16" />un dos folk vos zei zogn nevies tsu zei, veln lign avekgevorfen in di gasn fun Yerushalayim fun vegen dem hunger un der shverd, un zei veln kein bagreber nisht hobn; zei, zeyere vaiber, un zeyere zin, un zeyere techter; un ich vel oisgisen oif zei zeyer shlechtikeit.<verse eid="JER 14:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JER 14:17" />un zolst zogn tsu zei dos dozike vort:</para>
  <para style="q" vid="JER 14:17">tsegein zoln maine oign in trern</para>
  <para style="q" vid="JER 14:17">tog un nacht, un nisht oifhern,</para>
  <para style="q" vid="JER 14:17">vorem a grois broch iz tsebrochn gevorn</para>
  <para style="q" vid="JER 14:17">di yungfroi tochter main folk;</para>
  <para style="q" vid="JER 14:17">a shvern shlak biz gor.<verse eid="JER 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 14:18" />az ich gei arois in veld,</para>
  <para style="q" vid="JER 14:18">ersht, dershlogene fun shverd;</para>
  <para style="q" vid="JER 14:18">un az ich kum arain in shtot,</para>
  <para style="q" vid="JER 14:18">ersht, yesurim fun hunger.</para>
  <para style="q" vid="JER 14:18">vorem i der novi i der koyen</para>
  <para style="q" vid="JER 14:18">dreyen zich ibern land, un veisn gornisht.<verse eid="JER 14:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JER 14:19" />hostu farachten faracht Yehudah?</para>
  <para style="q" vid="JER 14:19">tsi hot zich fun Tsiyon fareklt dain zel?</para>
  <para style="q" vid="JER 14:19">far vos hostu undz geshlogn,</para>
  <para style="q" vid="JER 14:19">az far undz iz kein heilung nishto?</para>
  <para style="q" vid="JER 14:19">gehoft oif sholem, un kein guts iz nishto;</para>
  <para style="q" vid="JER 14:19">un oif a tsait fun heilung, ersht a shrekenish!<verse eid="JER 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 14:20" />mir veisn, Hashem, undzer shlechtikeit,</para>
  <para style="q" vid="JER 14:20">di zind fun undzere eltern;</para>
  <para style="q" vid="JER 14:20">vorem mir hobn gezindikt tsu dir.<verse eid="JER 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 14:21" />nisht faracht undz fun dain nomen vegen,</para>
  <para style="q" vid="JER 14:21">nisht shand dem tron fun dain koved;</para>
  <para style="q" vid="JER 14:21">dermon zich, zolst nisht farshtern dain bris mit undz.<verse eid="JER 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 14:22" />zainen do tsvishn di nishtike getsn fun di felker regn-geber?</para>
  <para style="q" vid="JER 14:22">oder gibn di himlen alein shpreiregn?</para>
  <para style="q" vid="JER 14:22">far vor, du bist Hashem Elokeinu,</para>
  <para style="q" vid="JER 14:22">un mir hofn tsu dir,</para>
  <para style="q" vid="JER 14:22">vorem du machst dos alts.<verse eid="JER 14:22" /></para>
  <chapter eid="JER 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="JER 15" />
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1" />un Hashem hot tsu mir gezogt: ven oifshtein zol Moshe un Shmuel far mir, iz main zel nisht mit dem dozikn folk; shik zei avek fun main ponem, un zoln zei avekgein. <verse eid="JER 15:1" /><verse number="2" style="v" sid="JER 15:2" />un es vet zain, az zei veln zogn tsu dir: vuhin zoln mir avekgein? zolstu zogn tsu zei: azoi hot Hashem gezogt:</para>
  <para style="b" vid="JER 15:2" />
  <para style="q" vid="JER 15:2">ver tsum toit, tsum toit,</para>
  <para style="q" vid="JER 15:2">un ver tsum shverd, tsum shverd,</para>
  <para style="q" vid="JER 15:2">un ver tsum hunger, tsum hunger,</para>
  <para style="q" vid="JER 15:2">un ver tsu gefangenshaft, tsu gefangenshaft.<verse eid="JER 15:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3" />un ich vel onzetsn oif zei fir mishpoches, zogt Hashem: di shverd tsu hargen, un di hint tsu shlepn, un dem foigel fun himel, un di chaye fun der erd, tsu esen un umtsubrengen. <verse eid="JER 15:3" /><verse number="4" style="v" sid="JER 15:4" />un ich vel zei machn tsu shoider bai ale kinigraichn fun der erd, fun vegen Menasheh dem zun fun Yechizkiyahun, i dem melech fun Yehudah, far vos er hot geton in Yerushalayim.<verse eid="JER 15:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JER 15:5" />vorem ver vet dich derbrimen, Yerushalayim?</para>
  <para style="q" vid="JER 15:5">un ver vet dich badoyern?</para>
  <para style="q" vid="JER 15:5">un ver vet zich opkeren dich tsu fregn oif frid?<verse eid="JER 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 15:6" />du host mich avekgevorfen,</para>
  <para style="qr" vid="JER 15:6">zogt Hashem,</para>
  <para style="q" vid="JER 15:6">ahinter tustu gein,</para>
  <para style="q" vid="JER 15:6">derum shtrek ich ois main hant oif dir un tseshter dich;</para>
  <para style="q" vid="JER 15:6">ich bin mid gevorn zich tsu derbaremen.<verse eid="JER 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 15:7" />un ich vintshufl zei mit a vintshufl</para>
  <para style="q" vid="JER 15:7">in di toiern fun land;</para>
  <para style="q" vid="JER 15:7">ich loz on kinder, ich breng unter main folk,</para>
  <para style="q" vid="JER 15:7">vail zei kern zich nisht um fun zeyere vegen.<verse eid="JER 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 15:8" />zeyere almones vern durch mir mer vi zamd fun di yamen;</para>
  <para style="q" vid="JER 15:8">ich breng oif zei – oif der muter fun yugnt,</para>
  <para style="q" vid="JER 15:8">a farvister in mitn tog.</para>
  <para style="q" vid="JER 15:8">ich vorf on oif ir plutsem yesurim un shrekenishn.<verse eid="JER 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 15:9" />farvelkt vert di gevinerin fun zibn,</para>
  <para style="q" vid="JER 15:9">zi hoicht ois ir neshome;</para>
  <para style="q" vid="JER 15:9">ir zun geit unter ven noch tog,</para>
  <para style="q" vid="JER 15:9">zi vert tsu shand un farshemt.</para>
  <para style="q" vid="JER 15:9">un zeyer iberblaib vel ich ibergebn</para>
  <para style="q" vid="JER 15:9">tsum shverd far zeyere faint,</para>
  <para style="qr" vid="JER 15:9">zogt Hashem.<verse eid="JER 15:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="JER 15:10" />vei mir, muter maine, vos du host mich geborn a mentsh fun krig, un a mentsh fun shtrait kegen gantsn land; nisht ich oisborgn, un nisht me mont bai mir, fun destvegn shiltn zei mich ale. <verse eid="JER 15:10" /><verse number="11" style="v" sid="JER 15:11" />hot Hashem gezogt: far vor, ich vel dich derleizn tsum gutn; far vor, ich vel machn dem faint zich betn bai dir in tsait fun umglik un in tsait fun noit. <verse eid="JER 15:11" /><verse number="12" style="v" sid="JER 15:12" />ken men aizn tsebrechn – aizn fun tsofn, un kuper?<verse eid="JER 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 15:13" />dain farmeg un daine oitseres vel ich gebn tsu roib on getsolt; yo, far ale daine zind azh in ale daine gemarkn. <verse eid="JER 15:13" /><verse number="14" style="v" sid="JER 15:14" />un ich vel dich ariberfirn bai daine faint, in a land vos du kenst nisht; vorem a faier iz ongetsundn in main noz, oif aich vet es brenen.<verse eid="JER 15:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JER 15:15" />du, Hashem veist doch,</para>
  <para style="q" vid="JER 15:15">gedenk mich, un dermon zich on mir,</para>
  <para style="q" vid="JER 15:15">un zei zich noikem on maine nochyoger;</para>
  <para style="q" vid="JER 15:15">fun vegen dain langgemit nisht nem mich avek;</para>
  <para style="q" vid="JER 15:15">merk main laidn fun daint vegen shand.<verse eid="JER 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 15:16" />vi daine verter zainen gefunen gevorn,</para>
  <para style="q" vid="JER 15:16">azoi hob ich zei aingeshlungen,</para>
  <para style="q" vid="JER 15:16">un dain vort iz mir geven far a freid,</para>
  <para style="q" vid="JER 15:16">un far a simche fun main hartsn,</para>
  <para style="q" vid="JER 15:16">vail dain nomen iz oif mir gerufn gevorn,</para>
  <para style="q" vid="JER 15:16">Hashem du Elokei Tseva'ot.<verse eid="JER 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 15:17" />ich bin nisht gezesn in gezeml fun freileche</para>
  <para style="q" vid="JER 15:17">un zich lustik gemacht;</para>
  <para style="q" vid="JER 15:17">fun vegen dain hant bin ich gezesn alein,</para>
  <para style="q" vid="JER 15:17">vorem mit tsorn hostu mich ongefilt.<verse eid="JER 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 15:18" />far vos iz eibik main veitik, un main vund iz mesukn,</para>
  <para style="q" vid="JER 15:18">zi vil zich nisht heiln?</para>
  <para style="q" vid="JER 15:18">vilstu mir zain vi a taich a falsher,</para>
  <para style="q" vid="JER 15:18">vi vasern umgetraie?<verse eid="JER 15:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JER 15:19" />derum hot Hashem azoi gezogt:</para>
  <para style="q" vid="JER 15:19">az du vest zich umkeren, un ich vel dich umkeren,</para>
  <para style="q" vid="JER 15:19">vestu shtein far mir;</para>
  <para style="q" vid="JER 15:19">un az du vest aroistsien taiers fun dem shlechtikeit,</para>
  <para style="q" vid="JER 15:19">vestu azoi vi main moil zain;</para>
  <para style="q" vid="JER 15:19">zei veln zich umkeren tsu dir,</para>
  <para style="q" vid="JER 15:19">un du vest zich genit umkeren tsu zei.<verse eid="JER 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 15:20" />un ich vel dich machn akegn dem dozikn folk</para>
  <para style="q" vid="JER 15:20">far a bafestikter moier fun kuper,</para>
  <para style="q" vid="JER 15:20">un zei veln milchome haltn kegen dir,</para>
  <para style="q" vid="JER 15:20">un veln dich nisht baikumen;</para>
  <para style="q" vid="JER 15:20">vorem ich bin mit dir, dich tsu helfn,</para>
  <para style="q" vid="JER 15:20">un dich matsl tsu zain,</para>
  <para style="qr" vid="JER 15:20">zogt Hashem.<verse eid="JER 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 15:21" />un ich vel dich matsl zain fun der hant fun di shlechte,</para>
  <para style="q" vid="JER 15:21">un vel dich oisleizen fun dem foist fun di machtike.<verse eid="JER 15:21" /></para>
  <chapter eid="JER 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="JER 16" />
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1" />un dos vort fun Hashem iz geven tsu mir, azoi tsu zogn: <verse eid="JER 16:1" /><verse number="2" style="v" sid="JER 16:2" />zolst dir nisht nemen kein vaib, un nisht hobn kein zin un kein techter in dem dozikn ort. <verse eid="JER 16:2" /><verse number="3" style="v" sid="JER 16:3" />vorem azoi hot Hashem gezogt oif di zin un oif di techter vos vern geborn in dem dozikn ort, un oif zeyere muters vos hobn zei gehat, un oif zeyere foters vos hobn zei geborn in dem dozikn land: <verse eid="JER 16:3" /><verse number="4" style="v" sid="JER 16:4" />toitn fun yesurim veln zei shtarbn; nisht baklogt un nisht bagrobn veln zei vern, tsu mist oifn gezicht fun der erd veln zei zain; un fun shverd un fun hunger veln zei farlendt vern; un zeyere toite laiber veln zain tsu shpaiz faran foigel fun himel, un far der chaye fun der erd.<verse eid="JER 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5" />vorem azoi hot Hashem gezogt: zolst nisht kumen in hoiz fun yomer, un zolst nisht gein baklogn, un zolst zei nisht badoyern, vorem ich hob avekgenumen main sholem fun dem dozikn folk, zogt Hashem, di genod, un di derbaremung. <verse eid="JER 16:5" /><verse number="6" style="v" sid="JER 16:6" />un grois un klein veln shtarbn in dem dozikn land; nisht zei veln bagrobn vern, un nisht me vet klogn noch zei, un nisht me vet zich ainshnaidn, un nisht me vet zich a plich machn noch zei; <verse eid="JER 16:6" /><verse number="7" style="v" sid="JER 16:7" />un nisht me vet brechn broit far zei in avlut, zei tsu treistn noch a toitn, un nisht me vet zei gebn trinken a becher fun treistung noch zeyer foter un noch zeyer muter. <verse eid="JER 16:7" /><verse number="8" style="v" sid="JER 16:8" />un in hoiz fun a sude zolstu nisht gein, tsu zitsn mit zei, tsu esen un tsu trinken. <verse eid="JER 16:8" /><verse number="9" style="v" sid="JER 16:9" />vorem azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: ze, ich farshter fun dem dozikn ort, far aiere oign un in aiere teg, dem kol fun lustikeit un dem kol fun freid, dem kol fun a chosen un dem kol fun a kale.<verse eid="JER 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10" />un es vet zain, az du vest zogn tsu dem dozikn folk di ale verter, un zei veln zogn tsu dir: far vos hot Hashem ongezogt oif undz al dos dozike groise beiz, un vos iz undzer farbrech, un vos iz undzer zind vos mir hobn gezindikt tsu Hashem Elokeinu? <verse eid="JER 16:10" /><verse number="11" style="v" sid="JER 16:11" />zolstu zogn tsu zei: far vos aiere eltern hobn mich farlozen, zogt Hashem, un zei zainen gegangen noch fremde g‑ter, un hobn zei gedint, un zich gebukt tsu zei, un mich hobn zei farlozen, un main toyre hobn zei nisht gehit. <verse eid="JER 16:11" /><verse number="12" style="v" sid="JER 16:12" />un ir hot noch erger geton fun aiere eltern, un ot geit ir itlecher noch der aingeshpartkeit fun zain beizn hartsn, mich nisht tsu hern. <verse eid="JER 16:12" /><verse number="13" style="v" sid="JER 16:13" />derum vel ich aich farvorfen fun dem dozikn land in a land vos nisht ir un nisht aiere eltern hobn gekent, un ir vet dortn dinen fremde g‑ter tog un nacht; vorem ich vel aich nisht gebn kein laitzelikeit.<verse eid="JER 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14" />far vor, ze teg kumen, zogt Hashem, un es vet mer nisht gezogt vern: azoi vi es lebt Hashem vos hot oifgebracht di kinder fun Yisroel fun land Mitsrayim! <verse eid="JER 16:14" /><verse number="15" style="v" sid="JER 16:15" />naiert: azoi vi es lebt Hashem vos hot oifgebracht di kinder fun Yisroel fun tsofn-land un fun ale lender vos er hot zei farshtoisen ahin! un ich vel zei umkeren oif zeyer erd vos ich hob gegebn zeyere eltern.<verse eid="JER 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16" />ze, ich shik noch fishers a sach, zogt Hashem, un zei veln zei aroisfishn; un dernoch vel ich shikn noch a sach yegers, un zei veln zei tsunoifyogn fun yetveder barg, un fun yetveder heich, un fun di shpaltn fun di feldzn. <verse eid="JER 16:16" /><verse number="17" style="v" sid="JER 16:17" />vorem maine oign zainen oif ale zeyere vegen, nisht farborgen zainen zei fun far mir, un nisht farhoiln iz zeyer farbrech fun akegn maine oign. <verse eid="JER 16:17" /><verse number="18" style="v" sid="JER 16:18" />un ich vel tsuersht batsoln topl zeyer farbrech un zeyer zind, far vos zei hobn farshvecht main land mit di neveilus fun zeyere miuse opgeter, un zeyere umverdikeitn hobn ongefilt main arav.<verse eid="JER 16:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JER 16:19" />Hashem, main festikeit un main festung,</para>
  <para style="q" vid="JER 16:19">un main antrinung in tog fun noit</para>
  <para style="q" vid="JER 16:19">tsu dir veln felker kumen fun di ekn erd,</para>
  <para style="q" vid="JER 16:19">un veln zogn: nor lign hobn geyarshent undzere eltern,</para>
  <para style="q" vid="JER 16:19">nishtikeitn vos in zei iz kein nuts nishto.<verse eid="JER 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 16:20" />ken a mentsh zich machn g‑ter,</para>
  <para style="q" vid="JER 16:20">az zei zainen kein g‑ter nisht?<verse eid="JER 16:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="JER 16:21" />far vor, ze, ich mach zei visen, dos mol vel ich zei machn visen main hant un main gevure, un zei veln visen az main nomen iz Hashem.<verse eid="JER 16:21" /></para>
  <chapter eid="JER 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="JER 17" />
  <para style="p">
    <verse number="1" style="v" sid="JER 17:1" />di zind fun Yehudah iz oifgeshribn mit an aizerner pen, mit a dimentenem shpits; oisgekritst oifn tovl fun zeyer hartsn, un oif di herner fun aiere mizbeyches. <verse eid="JER 17:1" /><verse number="2" style="v" sid="JER 17:2" />vi zei benken noch zeyere kinder – azoi noch zeyere mizbeyches, un zeyere getsnshtangen baim tsvaighaftikn boim, oif di bergelech di hoiche. <verse eid="JER 17:2" /><verse number="3" style="v" sid="JER 17:3" />main geberg in feld! dain farmeg, ale daine oitseres vel ich gebn tsu roib, daine hichn – far di zind in ale daine gemarkn. <verse eid="JER 17:3" /><verse number="4" style="v" sid="JER 17:4" />un vest zich opvarfn fun zich alein fun dain nachle, vos ich hob dir gegebn; un ich vel dich machn dinen daine faint, in a land vos du kenst nisht; vorem a faier hot ir ongetsundn in main noz, biz eibikn vet es brenen.<verse eid="JER 17:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JER 17:5" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 17:5">farsholten der man vos farzichert zich oif a mentshn,</para>
  <para style="q" vid="JER 17:5">un macht fleish zain onhalt,</para>
  <para style="q" vid="JER 17:5">un fun Hashem kert zich op zain harts!<verse eid="JER 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 17:6" />vorem er vet zain vi a tamarisk in der viste,</para>
  <para style="q" vid="JER 17:6">un vet nisht zen ven es kumt guts,</para>
  <para style="q" vid="JER 17:6">un vet voinen in trikenishn in der midber,</para>
  <para style="q" vid="JER 17:6">in a land a zaltsikn vos iz nisht bazetst.<verse eid="JER 17:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 17:7" />gebentsht der man vos farzichert zich oif Hashem,</para>
  <para style="q" vid="JER 17:7">un Hashem iz zain farzicherung!<verse eid="JER 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 17:8" />vorem er vet zain vi a boim geflantst bai vaser,</para>
  <para style="q" vid="JER 17:8">vos bai a bach lozt er arois zaine vortselen,</para>
  <para style="q" vid="JER 17:8">un er merkt nisht ven es kumt a hits,</para>
  <para style="q" vid="JER 17:8">un zain blat iz grin,</para>
  <para style="q" vid="JER 17:8">un in a yor fun trikenish dayget er nisht,</para>
  <para style="q" vid="JER 17:8">un er vet nisht oifhern tsu trogn frucht.<verse eid="JER 17:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JER 17:9" />fardreiter fun alts iz dos harts,</para>
  <para style="q" vid="JER 17:9">un umheilbar iz es – ver ken es konen?<verse eid="JER 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 17:10" />ich, Hashem, tu forshn dos harts,</para>
  <para style="q" vid="JER 17:10">tu pruvn di nirn,</para>
  <para style="q" vid="JER 17:10">kedei tsu gebn itlechn loit zaine vegen,</para>
  <para style="q" vid="JER 17:10">loit der frucht fun zaine meisim.<verse eid="JER 17:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JER 17:11" />a feldhon vos ainzamlen aier vos zi hot nisht geleigt,</para>
  <para style="q" vid="JER 17:11">azoi iz der vos macht an eshires, un nisht mit gerechtikeit;</para>
  <para style="q" vid="JER 17:11">in helft fun zaine teg vet er es farlozen,</para>
  <para style="q" vid="JER 17:11">un in zain sof vet er blaibn a nor.<verse eid="JER 17:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JER 17:12" />oi, tron fun prachtikeit, derhoibn fun onheib on,</para>
  <para style="q" vid="JER 17:12">du ort fun undzer mikdash,<verse eid="JER 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 17:13" />du hofenung fun Yisroel, Hashem,</para>
  <para style="q" vid="JER 17:13">ale vos farlozen dich, veln farshemt vern;</para>
  <para style="q" vid="JER 17:13">un di opgekerte fun mir</para>
  <para style="q" vid="JER 17:13">veln in der erd farshribn vern,</para>
  <para style="q" vid="JER 17:13">vail zei hobn farlozen Hashem,</para>
  <para style="q" vid="JER 17:13">dem kval fun lebedike vaser.<verse eid="JER 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 17:14" />heil mich, Hashem, ich zol geheilt vern,</para>
  <para style="q" vid="JER 17:14">helf mich, ich zol geholfn vern,</para>
  <para style="q" vid="JER 17:14">vorem du bist main loib.<verse eid="JER 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 17:15" />ze, zei zogn tsu mir:</para>
  <para style="q" vid="JER 17:15">vu iz dos vort fun Hashem?</para>
  <para style="q" vid="JER 17:15">zol es nor kumen.<verse eid="JER 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 17:16" />un ich, nisht ich bin antlofn</para>
  <para style="q" vid="JER 17:16">fun zain a pastuch hinter dir,</para>
  <para style="q" vid="JER 17:16">un nisht ich hob bagert dem umgliklechn tog;</para>
  <para style="q" vid="JER 17:16">du baist es, vos iz arois fun maine lipn,</para>
  <para style="q" vid="JER 17:16">iz far dain ponem geven.<verse eid="JER 17:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 17:17" />zol es mir nisht zain tsum broch;</para>
  <para style="q" vid="JER 17:17">du bist doch main bashitsung in tog fun umglik.<verse eid="JER 17:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 17:18" />zoln maine nochyoger farshemt vern,</para>
  <para style="q" vid="JER 17:18">un ich zol nisht farshemt vern;</para>
  <para style="q" vid="JER 17:18">zoln zei dershrokn vern,</para>
  <para style="q" vid="JER 17:18">un ich zol nisht dershrokn vern.</para>
  <para style="q" vid="JER 17:18">breng oif zei dem tog fun umglik,</para>
  <para style="q" vid="JER 17:18">un a tsveyikn broch tsebrech zei.<verse eid="JER 17:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19" />azoi hot tsu mir Hashem gezogt: gei un zolst zich shteln in toier fun di kinder fun folk, vos durch im kumen arain di mlochim fun Yehudah, un vos durch im geyen zei arois, un in ale toiern fun Yerushalayim; <verse eid="JER 17:19" /><verse number="20" style="v" sid="JER 17:20" />un zolst zogn tsu zei: hert dos vort fun Hashem, ir mlochim fun Yehudah, un gants Yehudah, un ale bavoiner fun Yerushalayim, vos kumen in di dozike toiern; <verse eid="JER 17:20" /><verse number="21" style="v" sid="JER 17:21" />azoi hot Hashem gezogt: hit aich um aier zel, un ir zolt nisht trogn kein mase in tog fun Shabbos un arainbrengen in di toiern fun Yerushalayim. <verse eid="JER 17:21" /><verse number="22" style="v" sid="JER 17:22" />un ir zolt nisht aroistrogn kein mase fun aiere haizer in tog fun Shabbos, un kein shum arbet zolt ir nisht ton, un ir zolt haltn heilik dem tog fun Shabbos, azoi vi ich hob bafoiln aiere eltern. <verse eid="JER 17:22" /><verse number="23" style="v" sid="JER 17:23" />ober zei hobn nisht gehert un nisht tsugenaigt zeyer oier, un zei hobn hart gemacht zeyer nakn nisht tsutsuhern, un nisht tsu nemen kein musar.<verse eid="JER 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 17:24" />derum vet zain: oib tsuhern vet ir tsuhern tsu mir, zogt Hashem, nisht araintsubrengen kein mase in di toiern fun der doziker shtot in tog fun Shabbos, naiert tsu haltn heilik dem tog fun Shabbos, nisht tsu ton in im kein shum arbet, <verse eid="JER 17:24" /><verse number="25" style="v" sid="JER 17:25" />veln kumen in di toiern fun der doziker shtot mlochim un harn vos zitsn oifn tron fun Dovid, vos raitn oif raitvegn un oif ferd, zei, un zeyere harn, di mener fun Yehudah, un di bavoiner fun Yerushalayim; un di dozike shtot vet zain bazetst oif eibik. <verse eid="JER 17:25" /><verse number="26" style="v" sid="JER 17:26" />un me vet kumen fun di shtet fun Yehudah, un fun rund arum Yerushalayim, un fun land Binyamin, un fun der niderung, un funem geberg, un funem dorem, brengendik brandopfer, un shlachtopfer, un shpaizopfer, un vairech, un brengendik dankopfer, in hoiz fun Hashem. <verse eid="JER 17:26" /><verse number="27" style="v" sid="JER 17:27" />oib ober ir vet nisht tsuhern tsu mir, tsu haltn heilik dem tog fun Shabbos, un nisht tsu trogn kein mase un arainkumen dermit in di toiern fun Yerushalayim in tog fun Shabbos, vel ich ontsindn a faier in ire toiern, un es vet fartseren di palatsn fun Yerushalayim, un vet nisht farloshn vern.<verse eid="JER 17:27" /></para>
  <chapter eid="JER 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="JER 18" />
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem, azoi tsu zogn: <verse eid="JER 18:1" /><verse number="2" style="v" sid="JER 18:2" />shtei oif, un zolst aropnideren tsum hoiz fun dem teper, un dortn vel ich dich machn hern maine verter. <verse eid="JER 18:2" /><verse number="3" style="v" sid="JER 18:3" />hob ich aropgenidert tsum hoiz fun dem teper, ersht er macht arbet oifn verkshtein. <verse eid="JER 18:3" /><verse number="4" style="v" sid="JER 18:4" />un az di keile vos er hot gemacht fun leim iz fardorben gevorn in der hant fun dem teper, hot er zi ibergemacht in an ander keile, azoi vi es iz voilgefeln in di oign fun dem teper tsu machn.<verse eid="JER 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 18:5" />iz dos vort fun Hashem geven tsu mir azoi tsu zogn: <verse eid="JER 18:5" /><verse number="6" style="v" sid="JER 18:6" />ken ich den nisht ton mit aich azoi vi der doziker teper, ir hoiz fun Yisroel? zogt Hashem. zet, vi leim in der hant fun dem teper, zait ir in main hant, hoiz fun Yisroel. <verse eid="JER 18:6" /><verse number="7" style="v" sid="JER 18:7" />ein rege red ich oif a folk un oif a kinigraich, oistsuraisn un aintsuvarfn un untertsubrengen; <verse eid="JER 18:7" /><verse number="8" style="v" sid="JER 18:8" />ober az dos folk vos ich hob oif im geredt, kert zich um fun zain shlechtikeit, hob ich charote oif dem beiz vos ich hob getracht im tsu ton. <verse eid="JER 18:8" /><verse number="9" style="v" sid="JER 18:9" />un ein rege red ich oif a folk un oif a kinigraich, tsu boien un tsu flantsn; <verse eid="JER 18:9" /><verse number="10" style="v" sid="JER 18:10" />ober az es tut vos iz shlecht in maine oign, nisht tsutsuhern main kol, hob ich charote oif dem guts vos ich hob gezogt im tsu bagitikn. <verse eid="JER 18:10" /><verse number="11" style="v" sid="JER 18:11" />un atsund zog akorsht tsu di mener fun Yehudah, un tsu di bavoiner fun Yerushalayim, azoi tsu zogn: azoi hot Hashem gezogt: zet, ich bashaf oif aich an umglik, un tracht oif aich a trachtung; kert aich um fort itlecher fun zain shlechtn veg, un besert aiere vegen un aiere meisim.<verse eid="JER 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 18:12" />ober zei zogn: umzist! naiert noch undzere gedanken veln mir gein, un itlecher loit der aingeshpartkeit fun zain beizn hartsn veln mir ton.<verse eid="JER 18:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 18:13" />derum hot Hashem azoi gezogt:</para>
  <para style="q" vid="JER 18:13">fregt akorsht bai di felker,</para>
  <para style="q" vid="JER 18:13">ver hot azoins gehert?</para>
  <para style="q" vid="JER 18:13">shoiderhaftiks biz gor hot bagangen di yungfroi Yisroel.<verse eid="JER 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 18:14" />vert fun dem shtein fun feld</para>
  <para style="q" vid="JER 18:14">der shnei dem Levanon farlozen?</para>
  <para style="q" vid="JER 18:14">oder vern fartriknt shturemdike,</para>
  <para style="q" vid="JER 18:14">kalte, flisndike vasern?<verse eid="JER 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 18:15" />vorem main folk hot fargesen on mir,</para>
  <para style="q" vid="JER 18:15">tsu nishtikeit reichern zei,</para>
  <para style="q" vid="JER 18:15">un me hot zei gemacht shtroichlen in zeyere vegen –</para>
  <para style="q" vid="JER 18:15">di eibike shtegn,</para>
  <para style="q" vid="JER 18:15">kedei tsu gein oif baishtegn,</para>
  <para style="q" vid="JER 18:15">oif a veg nisht oisgetretn.<verse eid="JER 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 18:16" />kedei tsu machn zeyer land far a shrek,</para>
  <para style="q" vid="JER 18:16">far an eibiker shmutserung a faifn,</para>
  <para style="q" vid="JER 18:16">itlecher vos vet far ir farbaigein vet dershtoinen,</para>
  <para style="q" vid="JER 18:16">un vet shoklen mit zain kop,<verse eid="JER 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 18:17" />vi mit a mizrech-vint</para>
  <para style="q" vid="JER 18:17">vel ich zei tseshpreitn far dem faint;</para>
  <para style="q" vid="JER 18:17">zeyer rukn un nisht zeyer ponem vel ich zen,</para>
  <para style="q" vid="JER 18:17">in tog fun zeyer broch.<verse eid="JER 18:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18" />yo, zei hobn gezogt: kumt lomir oistrachtn tchbulut kegen Yirmeyahun; vorem di toyre vet nisht untergein fun dem koyen, un di etsh fun dem chochem, un dos vort fun dem novi. kumt un lomir im shlogn mit der tsung, un nisht farnemen ale zaine reid.<verse eid="JER 18:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JER 18:19" />farnem tsu mir, Hashem,</para>
  <para style="q" vid="JER 18:19">un hern tsu dem kol fun maine kriger.<verse eid="JER 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 18:20" />zol far a toive a roe batsolt vern?</para>
  <para style="q" vid="JER 18:20">vorem zei hobn gegrobn a grub far main lebn.</para>
  <para style="q" vid="JER 18:20">gedenk main shtein far dir, tsu redn guts oif zei,</para>
  <para style="q" vid="JER 18:20">optsukeren dain grimtsorn fun zei.<verse eid="JER 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 18:21" />derum gib zeyere kinder tsum hunger,</para>
  <para style="q" vid="JER 18:21">un shlaider zei in der macht fun shverd;</para>
  <para style="q" vid="JER 18:21">un zoln zeyere vaiber blaibn on kinder, un almones,</para>
  <para style="q" vid="JER 18:21">un zeyere mener zoln zain herugim fun pest,</para>
  <para style="q" vid="JER 18:21">zeyere bechorim, dershlogn fun shverd in milchome.<verse eid="JER 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 18:22" />zol zich hern a geshrei fun zeyere haizer,</para>
  <para style="q" vid="JER 18:22">ven du vest brengen oif zei plutsem a machne;</para>
  <para style="q" vid="JER 18:22">vorem zei hobn gegrobn a grub mich tsu fangen,</para>
  <para style="q" vid="JER 18:22">un netsn bahaltn far maine fis.<verse eid="JER 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 18:23" />un du, Hashem, veist</para>
  <para style="q" vid="JER 18:23">zeyer gantsn barot mich tsu teitn;</para>
  <para style="q" vid="JER 18:23">nisht fargebn zolstu zeyer farbrech,</para>
  <para style="q" vid="JER 18:23">un nisht farmekn zolstu zeyer zind fun far dir,</para>
  <para style="q" vid="JER 18:23">un zoln zei geshtroichlt vern far dir;</para>
  <para style="q" vid="JER 18:23">in tsait fun dain tsorn rechn zich mit zei.<verse eid="JER 18:23" /></para>
  <chapter eid="JER 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="JER 19" />
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1" />azoi hot Hashem gezogt: gei un zolst dir koifn a teperkrug un nem mit fun di eltste fun folk, un fun di eltste fun di koyanim, <verse eid="JER 19:1" /><verse number="2" style="v" sid="JER 19:2" />un zolst aroisgein tsum tal fun Ben-Hinom, vos baim aingang fun toier Cheresit, un oisrufn dortn di verter vos ich vel redn tsu dir, <verse eid="JER 19:2" /><verse number="3" style="v" sid="JER 19:3" />un zolst zogn: hert dos vort fun Hashem, ir mlochim fun Yehudah, un bavoiner fun Yerushalayim: azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: ze, ich breng an umglik oif dem dozikn ort, az itlecher vos hert es, veln im di oiern klingen; <verse eid="JER 19:3" /><verse number="4" style="v" sid="JER 19:4" />far vos zei hobn mich farlozen, un hobn farfremdt dem dozikn ort, un gereidert in im tsu fremde g‑ter, vos nisht zei, un nisht zeyere eltern, un nisht di mlochim fun Yehudah, hobn zei gekent; un zei hobn ongefilt dem dozikn ort mit blut fun umshuldike. <verse eid="JER 19:4" /><verse number="5" style="v" sid="JER 19:5" />un zei hobn geboit di bamot tsu Baal, tsu farbrenen zeyere kinder in faier, brandopfer tsu Baal, vos nisht ich hob bafoiln, un nisht ich hob gezogt, un nisht es iz mir oifn zinen aroifgekumen. <verse eid="JER 19:5" /><verse number="6" style="v" sid="JER 19:6" />derum ze, teg kumen, zogt Hashem, un der doziker ort vet nisht mer gerufn vern Tofes, un der tal fun Ben-Hinom, naiert der tal fun teitung. <verse eid="JER 19:6" /><verse number="7" style="v" sid="JER 19:7" />un ich vel machn tsu nisht dem barot fun Yehudah un Yerushalayim in dem dozikn ort, un vel zei machn faln durchn shverd far zeyere faint, un durch der hant fun di vos zuchn zeyer lebn; un ich vel gebn zeyere toite laiber tsu shpaiz faran foigel fun himel, un far der chayes fun der erd. <verse eid="JER 19:7" /><verse number="8" style="v" sid="JER 19:8" />un ich vel machn di dozike shtot far a shrek un far a shmutserung; itlecher vos geit ir farbai vet zich dershtoinen, un shpetn oif ale ire plogn. <verse eid="JER 19:8" /><verse number="9" style="v" sid="JER 19:9" />un ich vel zei machn esen dos fleish fun zeyere zin, un dos fleish fun zeyere techter, un einer dem anderns fleish veln zei esen, in der balegerung un in der drikung, vos zeyere faint, un di vos zuchn zeyer lebn, veln zei drikn.<verse eid="JER 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10" />un zolst tsebrechn dem krug far di oign fun di mentshn vos geyen mit dir, <verse eid="JER 19:10" /><verse number="11" style="v" sid="JER 19:11" />un zolst zogn tsu zei: azoi hot gezogt Hashem Tseva'ot: azoi vel ich tsebrechn dos dozike folk un di dozike shtot, azoi vi me tsebrecht a keile fun a teper, az zi ken nisht mer farricht vern; un me vet bagrobn in Tofes, vail mer kein ort vet nisht zain oif tsu bagrobn. <verse eid="JER 19:11" /><verse number="12" style="v" sid="JER 19:12" />azoi vel ich ton tsu dem dozikn ort, zogt Hashem, un tsu zaine bavoiner, kedei tsu machn di dozike shtot azoi vi Tofes. <verse eid="JER 19:12" /><verse number="13" style="v" sid="JER 19:13" />un di haizer fun Yerushalayim, un di haizer fun di mlochim fun Yehudah, di umreine, veln zain azoi vi der ort fun Tofes – ale haizer vos me hot gereichert oif zeyere decher tsum gantsn cheil fun himel, un gegosn gisopfer tsu fremde g‑ter.<verse eid="JER 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14" />un Yirmeyah iz gekumen fun Tofes, vos Hashem hot im ahin geshikt nevies zogn, un er hot zich geshtelt in hoif fun Hashems hoiz, un hot gezogt tsum gantsn folk: <verse eid="JER 19:14" /><verse number="15" style="v" sid="JER 19:15" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: ze, ich breng oif dem dozikn krach, un oif ale zaine shtet, dos gantse beiz vos ich hob ongezogt oif im, vail zei hobn hart gemacht zeyer nakn, nisht tsutsuhern maine verter.<verse eid="JER 19:15" /></para>
  <chapter eid="JER 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="JER 20" />
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1" />un Pashchur der zun fun Immer dem koyen, vos iz geven der eiberoifzeer in hoiz fun Hashem hot gehert Yirmeyahun nevies zogn di dozike verter. <verse eid="JER 20:1" /><verse number="2" style="v" sid="JER 20:2" />un Pashchur hot geshlogn Yirmeyah henvin, un hot im araingeshtelt in dem tsvanglots vos in oibershtn toier fun Binyamin, vos in hoiz fun Hashem. <verse eid="JER 20:2" /><verse number="3" style="v" sid="JER 20:3" />un es iz geven oif morgn, az Pashchur hot aroisgenumen Yirmeyahun fun tsvangklots, hot Yirmeyah tsu im gezogt: nisht Pashchur hot Hashem gerufn dain nomen, naiert mogor-misoviv. <verse eid="JER 20:3" /><verse number="4" style="v" sid="JER 20:4" />vorem azoi hot Hashem gezogt: ze, ich mach dich far a shrek far dir alein, un far ale daine libhober; un zei veln faln durch der shverd fun zeyere faint, un daine oign veln es zetsuzen; un gants Yehudah vel ich gebn in der hant fun dem melech fun Bavel, un er vet zei fartraiben kein Bavel, un vet zei dershlogn mitn shverd. <verse eid="JER 20:4" /><verse number="5" style="v" sid="JER 20:5" />un ich vel gebn al dos raichtum fun der doziker shtot, un al ir mi, un al ir taierkeit, oich ale oitseres fun di mlochim fun Yehudah vel ich gebn, in der hant fun zeyere faint, un zei veln zei tseroibn, un veln zei nemen un zei brengen kein Bavel. <verse eid="JER 20:5" /><verse number="6" style="v" sid="JER 20:6" />un du, Pashchur, un ale bavoiner fun dain hoiz, vet gein in gefangenshaft, un kein Bavel vestu kumen, un dortn vestu shtarbn, un dortn vestu bagrobn vern, du un ale daine libhober vos du host zei nevies gezogt mit lign.<verse eid="JER 20:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 20:7" />host mich ibergeredt, Hashem,</para>
  <para style="q" vid="JER 20:7">un ich bin ibergeredt gevorn,</para>
  <para style="q" vid="JER 20:7">host mich ibergeshtarkt, un bist baigekumen;</para>
  <para style="q" vid="JER 20:7">ich bin gevorn tsum gelechter a gantsn tog,</para>
  <para style="q" vid="JER 20:7">itlecher tut shpetn fun mir.<verse eid="JER 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 20:8" />vorem ven noch ich red, tu ich shraien,</para>
  <para style="q" vid="JER 20:8">umrecht un roib! ruf ich ois.</para>
  <para style="q" vid="JER 20:8">far vor, dos vort fun Hashem iz tsu mir gevorn</para>
  <para style="q" vid="JER 20:8">tsu shand un tsu shpot dem gantsn tog.<verse eid="JER 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 20:9" />un ich hob gevest gezogt: ich vel im nisht dermonen,</para>
  <para style="q" vid="JER 20:9">un vel mer nisht redn in zain nomen;</para>
  <para style="q" vid="JER 20:9">ober es iz in main hartsn vi a brenedik faier,</para>
  <para style="q" vid="JER 20:9">aingeshlosn in maine beiner,</para>
  <para style="q" vid="JER 20:9">un ich mater zich es aintsuhaltn,</para>
  <para style="q" vid="JER 20:9">ober ich ken nisht.<verse eid="JER 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 20:10" />yo, ich hob gehert di beize reid fun fil,</para>
  <para style="q" vid="JER 20:10">a shrek rund arum:</para>
  <para style="q" vid="JER 20:10">masert, un lomir im farmasrn!</para>
  <para style="q" vid="JER 20:10">ale maine gute fraint loiern oif main broch:</para>
  <para style="q" vid="JER 20:10">efsher vet er farnart vern,</para>
  <para style="q" vid="JER 20:10">un mir veln im baikumen,</para>
  <para style="q" vid="JER 20:10">un nemen undzer nekome fun im.<verse eid="JER 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 20:11" />ober Hashem iz mit mir vi a gibor a machtiker,</para>
  <para style="q" vid="JER 20:11">derum veln maine nochyoger geshtroichlt vern,</para>
  <para style="q" vid="JER 20:11">un veln nisht oisfirn;</para>
  <para style="q" vid="JER 20:11">zei vern farshemt zeyer, vail zei hobn nisht baglikt,</para>
  <para style="q" vid="JER 20:11">an eibike shand vos vet nisht fargesen vern.<verse eid="JER 20:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 20:12" />un du Hashem Tseva'ot, vos pruvst dem gerechtn,</para>
  <para style="q" vid="JER 20:12">o vos zest di nirn un dos harts,</para>
  <para style="q" vid="JER 20:12">lomich zen dain nekome fun zei,</para>
  <para style="q" vid="JER 20:12">vorem tsu dir hob ich antplekt main krig.<verse eid="JER 20:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 20:13" />zingt tsu Hashem, tut loibn Hashem,</para>
  <para style="q" vid="JER 20:13">vorem er hot matsl geven di zel fun dem oreman</para>
  <para style="q" vid="JER 20:13">fun der hant fun di shlechtstuer.<verse eid="JER 20:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 20:14" />farsholten der tog</para>
  <para style="q" vid="JER 20:14">vos ich bin in im geborn gevorn!</para>
  <para style="q" vid="JER 20:14">der tog vos main muter hot mich geborn</para>
  <para style="q" vid="JER 20:14">zol zain nisht gebentsht!<verse eid="JER 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 20:15" />farsholten der mentsh vos hot main foter</para>
  <para style="q" vid="JER 20:15">di besoire gebracht, azoi tsu zogn:</para>
  <para style="q" vid="JER 20:15">a yingel iz dir geborn gevorn;</para>
  <para style="q" vid="JER 20:15">freyen derfreit hot er im!<verse eid="JER 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 20:16" />yener mentsh zol zain vi di shtet</para>
  <para style="q" vid="JER 20:16">vos Hashem hot ibergekert un nisht derbaremt;</para>
  <para style="q" vid="JER 20:16">un er zol hern a geshrei in der peire,</para>
  <para style="q" vid="JER 20:16">un a shalung in mitn tog;<verse eid="JER 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 20:17" />far vos er hot mich nisht geteit fun tracht,</para>
  <para style="q" vid="JER 20:17">az main muter zol main keyver zain,</para>
  <para style="q" vid="JER 20:17">un ir tracht eibik trogedik.<verse eid="JER 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 20:18" />noch vos gor bin ich fun tracht arois</para>
  <para style="q" vid="JER 20:18">tsu zen maternish un kumer,</para>
  <para style="q" vid="JER 20:18">un oisgein in shand zoln maine teg?<verse eid="JER 20:18" /></para>
  <chapter eid="JER 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="JER 21" />
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem, ven der melech Tsidkiyah hot tsu im geshikt Pashchur dem zun fun Malkiyahn, un Tsefanyah dem zun fun Maaseiyahn, dem koyen, azoi tsu zogn: <verse eid="JER 21:1" /><verse number="2" style="v" sid="JER 21:2" />freg, ich bet dich, far undz bai Hashem, vorem Nevuchadretsar der melech fun Bavel halt milchome oif undz; efsher vet Hashem ton mit undz azoi vi ale zaine vunder, un er vet optsien fun undz.<verse eid="JER 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 21:3" />hot Yirmeyah tsu zei gezogt: azoi zolt ir zogn tsu Tsidkiyahun: <verse eid="JER 21:3" /><verse number="4" style="v" sid="JER 21:4" />azoi hot gezogt Hashem Elokei Yisroel: ze, ich drai um di keile-milchome vos in aier hant, vos ir halt dermit milchome droisn fun der moier akegn dem melech fun Bavel, un akegn di Kasdim, vos legern oif aich, un ich vel zei ainzamlen in der doziker shtot. <verse eid="JER 21:4" /><verse number="5" style="v" sid="JER 21:5" />un ich gufe vel milchome haltn mit aich, mit an oisgeshtrekter hant un mit a shtarkn orem, un mit kaas, un mit geirem, un mit grois tsorn. <verse eid="JER 21:5" /><verse number="6" style="v" sid="JER 21:6" />un ich vel shlogn di bavoiner fun der doziker shtot, i mentsh i beheime; fun a groiser pest veln zei shtarbn. <verse eid="JER 21:6" /><verse number="7" style="v" sid="JER 21:7" />un dernoch, zogt Hashem, vel ich gebn Tsidkiyah dem melech fun Yehudah, un zaine knecht, un dos folk, di vos zainen ibergebliben in der doziker shtot fun der pest, fun der shverd, un fun dem hunger, in der hant fun Nevuchadretsar dem melech fun Bavel, un in der hant fun zeyere faint, un in der hant fun di vos zuchn zeyer lebn; un es vet zei dershlogn mitn sharf fun shverd; er vet zei nisht shoinen, un vet nisht derbaremen un nisht rachmones hobn.<verse eid="JER 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8" />un tsu dem dozikn folk zolstu zogn: azoi hot Hashem gezogt: ze, ich leig far aich dem veg fun lebn un dem veg fun toit. <verse eid="JER 21:8" /><verse number="9" style="v" sid="JER 21:9" />der vos blaibt zitsn in der doziker shtot, vet shtarbn fun shverd, un fun hunger, un fun pest, ober der vos geit arois un vet tsufaln tsu di Kasdim vos legern oif aich, vet blaibn lebn, un zain nefesh vet im zain tsum gevins. <verse eid="JER 21:9" /><verse number="10" style="v" sid="JER 21:10" />vorem ich hob geton main ponem kegen der doziker shtot tsum beizn un nisht tsum gutn, zogt Hashem; in der hant fun dem melech fun Bavel vet zi ibergegebn vern un er vet zi farbrenen in faier.<verse eid="JER 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 21:11" />un tsum hoiz fun dem melech fun Yehudah: hert dos vort fun Hashem. <verse eid="JER 21:11" /><verse number="12" style="v" sid="JER 21:12" />hoiz fun Dovid, azoi hot Hashem gezogt:</para>
  <para style="b" vid="JER 21:12" />
  <para style="q" vid="JER 21:12">halt a mishpot in der peire,</para>
  <para style="q" vid="JER 21:12">un zait matsl dem bagzltn</para>
  <para style="q" vid="JER 21:12">fun dem drikers hant,</para>
  <para style="q" vid="JER 21:12">kedei main grimtsorn zol nisht aroisgein vi a faier,</para>
  <para style="q" vid="JER 21:12">un brenen az kein lesher zol nisht zain,</para>
  <para style="q" vid="JER 21:12">fun vegen aiere beize meisim.<verse eid="JER 21:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 21:13" />ze, ich kum tsu dir, bavoinerin fun tal,</para>
  <para style="q" vid="JER 21:13">du feldz fun ploin,</para>
  <para style="qr" vid="JER 21:13">zogt Hashem;</para>
  <para style="q" vid="JER 21:13">ir vos zogt: ver vet nidern oif undz?</para>
  <para style="q" vid="JER 21:13">un ver vet kumen in undzere voinungen?<verse eid="JER 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 21:14" />un ich vel zich oprechenen mit aich</para>
  <para style="q" vid="JER 21:14">loit der frucht fun aiere meisim,</para>
  <para style="qr" vid="JER 21:14">zogt Hashem;</para>
  <para style="q" vid="JER 21:14">un ich vel ontsindn a faier in ir vald,</para>
  <para style="q" vid="JER 21:14">un es vet fartseren alts vos arum ir.<verse eid="JER 21:14" /></para>
  <chapter eid="JER 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="JER 22" />
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1" />azoi hot Hashem gezogt: nider arop tsum hoiz fun dem melech fun Yehudah, un zolst redn dortn dos dozike vort, <verse eid="JER 22:1" /><verse number="2" style="v" sid="JER 22:2" />un zogn: her dos vort fun Hashem, du melech fun Yehudah vos zitsst oifn tron fun Dovid, du, un daine knecht, un dain folk, vos kumen in di dozike toiern. <verse eid="JER 22:2" /><verse number="3" style="v" sid="JER 22:3" />azoi hot Hashem gezogt: tut recht un gerechtikeit, un zait matsl dem bagzltn fun dem drikers hant; un a fremdn, a yosem, un an almone, zolt ir nisht krivden, nisht baroibn, un umshuldik blut zolt ir nisht fargisen in dem dozikn ort. <verse eid="JER 22:3" /><verse number="4" style="v" sid="JER 22:4" />vorem oib ton vet ir ton di dozike zach, veln kumen in di toiern fun dem dozikn hoiz mlochim vos zitsn oifn tron fun Dovid, vos raitn oif raitvegn un oif ferd, er, un zaine knecht, un zain folk. <verse eid="JER 22:4" /><verse number="5" style="v" sid="JER 22:5" />oib ober ir et nisht tsuhern di dozike verter, shver ich bai mir, zogt Hashem, az tsu vist vet vern dos dozike hoiz. <verse eid="JER 22:5" /><verse number="6" style="v" sid="JER 22:6" />vorem azoi hot Hashem gezogt oif dem hoiz fun dem melech fun Yehudah:</para>
  <para style="b" vid="JER 22:6" />
  <para style="q" vid="JER 22:6">Gilad bistu mir geven,</para>
  <para style="q" vid="JER 22:6">der shpits fun Levanon;</para>
  <para style="q" vid="JER 22:6">oib ich vel dich nisht machn far a midber,</para>
  <para style="q" vid="JER 22:6">far shtet nisht bavointe!<verse eid="JER 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 22:7" />un ich vel onbreitn oif dir tseshterer,</para>
  <para style="q" vid="JER 22:7">itlechn mit zain getsaig,</para>
  <para style="q" vid="JER 22:7">un zei veln ophakn daine geklibene tsedern,</para>
  <para style="q" vid="JER 22:7">un arainvarfen in faier.<verse eid="JER 22:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8" />un fil felker veln farbaigein farbai der doziker shtot, un zei veln zogn einer tsum andern: far vos hot Hashem azoi geton tsu der doziker groiser shtot? <verse eid="JER 22:8" /><verse number="9" style="v" sid="JER 22:9" />un me vet zogn: far vos zei hobn farlozen dem bris fun Hashem zeyer G-t, un hobn zich gebukt tsu fremde g‑ter, un zei gedint.<verse eid="JER 22:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 22:10" />ir zol nisht veinen oifn toitn,</para>
  <para style="q" vid="JER 22:10">un ir badoyern oif im;</para>
  <para style="q" vid="JER 22:10">veinen veint oif dem vos geit avek,</para>
  <para style="q" vid="JER 22:10">vorem er vet zich mer nisht umkeren</para>
  <para style="q" vid="JER 22:10">un zen dos land fun zain geburt.<verse eid="JER 22:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JER 22:11" />vorem azoi hot Hashem gezogt oif Shallum dem zun fun Yoshiyah dem melech fun Yehudah, vos hot gekinigt oif dem ort fun zain foter Yoshiyahun, un vos iz avekgegangen fun dem dozikn ort: er vet zich mer nisht umkeren ahin. <verse eid="JER 22:11" /><verse number="12" style="v" sid="JER 22:12" />naiert in dem ort vuhin me hot im fartriben, dortn vet er shtarbn, un dos dozike land vet er mer nisht onzen.<verse eid="JER 22:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 22:13" />vei, der vos boit zain hoiz mit umerlechkeit,</para>
  <para style="q" vid="JER 22:13">un zaine eibershtubn mit umrecht;</para>
  <para style="q" vid="JER 22:13">vos arbet mit zain chever umzist,</para>
  <para style="q" vid="JER 22:13">un git im nisht zain loin;<verse eid="JER 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 22:14" />vos zogt: ich vel mir oifboien a grois hoiz,</para>
  <para style="q" vid="JER 22:14">un eibershtubn gerame;</para>
  <para style="q" vid="JER 22:14">un er shnaidt zich ois fentster;</para>
  <para style="q" vid="JER 22:14">un er badekt es mit tseder,</para>
  <para style="q" vid="JER 22:14">un bashmirt es mit farb!<verse eid="JER 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 22:15" />vilstu kinign, vail du machst zich grois mit tsederholts?</para>
  <para style="q" vid="JER 22:15">dain foter, far vor, hot gegesn un getrunken,</para>
  <para style="q" vid="JER 22:15">ober er hot geton recht un gerechtikeit,</para>
  <para style="q" vid="JER 22:15">derum iz im gut geven.<verse eid="JER 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 22:16" />er hot gemishpet dem mishpot fun oreman un evyon,</para>
  <para style="q" vid="JER 22:16">derum iz geven gut.</para>
  <para style="q" vid="JER 22:16">far vor, dos iz derkenen mich,</para>
  <para style="qr" vid="JER 22:16">zogt Hashem.<verse eid="JER 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 22:17" />ober daine oign un dain harts zainen nisht mer</para>
  <para style="q" vid="JER 22:17">vi nor oif dain gevin,</para>
  <para style="q" vid="JER 22:17">un oif umshuldik blut tsu fargisen,</para>
  <para style="q" vid="JER 22:17">un oif roib un oif drikung tsu bagein.<verse eid="JER 22:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="JER 22:18" />derum hot Hashem azoi gezogt oif Yhoyakim dem zun fun Yoshiyahun dem melech fun Yehudah:</para>
  <para style="b" vid="JER 22:18" />
  <para style="q" vid="JER 22:18">me vet nisht klogn oif im:</para>
  <para style="q" vid="JER 22:18">vei main bruder! un: vei shvester!</para>
  <para style="q" vid="JER 22:18">me vet nisht klogn oif im:</para>
  <para style="q" vid="JER 22:18">vei har! un: vei zain glants!<verse eid="JER 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 22:19" />di bagrebenish fun an eizl vet er bagrobn vern,</para>
  <para style="q" vid="JER 22:19">geshlept un avekgevorfen, avek fun di toiern fun Yerushalayim.<verse eid="JER 22:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JER 22:20" />gei aroif tsum Levanon un shrai,</para>
  <para style="q" vid="JER 22:20">un in Bashan loz arois dain kol,</para>
  <para style="q" vid="JER 22:20">un shrai fun Avarim,</para>
  <para style="q" vid="JER 22:20">vorem tsebrochn zainen ale daine libhober.<verse eid="JER 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 22:21" />ich hob geredt tsu dir in dain shalve,</para>
  <para style="q" vid="JER 22:21">hostu gezogt: ich vel nisht hern;</para>
  <para style="q" vid="JER 22:21">dos iz dain veg fun dain yugnt on,</para>
  <para style="q" vid="JER 22:21">az du herst nisht tsu main kol.<verse eid="JER 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 22:22" />der vint vet pastuchen ale daine pastucher,</para>
  <para style="q" vid="JER 22:22">un daine libhober veln in gefangenshaft gein;</para>
  <para style="q" vid="JER 22:22">ersht dentsmol vestu zich shemen un tsu shand vern</para>
  <para style="q" vid="JER 22:22">fun vegen al dain shlechtikeit.<verse eid="JER 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 22:23" />vos zitsst in Levanon,</para>
  <para style="q" vid="JER 22:23">un nestest in di tsedern,</para>
  <para style="q" vid="JER 22:23">vi vestu krechtsn ven es veln dir kumen veyen,</para>
  <para style="q" vid="JER 22:23">shmertsn vi a gevinerin!<verse eid="JER 22:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24" />azoi vi ich leb, zogt Hashem, ven Konyahu der zun fun Yhoyakimen, der melech fun Yehudah, zol zain der ziglring oif main rechter hant, vel ich dich fun dortn aropraisn! <verse eid="JER 22:24" /><verse number="25" style="v" sid="JER 22:25" />un ich vel dich gebn in der hant fun di vos zuchn dain lebn, un in der hant fun di vos du shrekst zich far zei, un in der hant fun Nevuchadretsar dem melech fun Bavel, un in er hant fun di Kasdim. <verse eid="JER 22:25" /><verse number="26" style="v" sid="JER 22:26" />un ich vel farvorfen dich, un dain muter vos hot dich geborn, in an ander land, vos ir zait dortn nisht geborn gevorn; un dortn vet ir shtarbn. <verse eid="JER 22:26" /><verse number="27" style="v" sid="JER 22:27" />un in dem land vos zeyer harts tsit zei zich umtsukeren ahin, ahin veln zei zich nisht umkeren.<verse eid="JER 22:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="JER 22:28" />iz a faracht gefes a tsebrochn</para>
  <para style="q" vid="JER 22:28">der doziker man Konyahu?</para>
  <para style="q" vid="JER 22:28">iz er a keile a nishtvertike?</para>
  <para style="q" vid="JER 22:28">far vos zainen zei farvorfen gevorn, er un zain zomen,</para>
  <para style="q" vid="JER 22:28">un farshlaidert in dem land vos zei kenen nisht?<verse eid="JER 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 22:29" />oi land, land, land,</para>
  <para style="q" vid="JER 22:29">her dos vort fun Hashem!<verse eid="JER 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 22:30" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 22:30">farshraibt dem dozikn mentshn on kinder,</para>
  <para style="q" vid="JER 22:30">a man vos baglikt nisht in zaine teg,</para>
  <para style="q" vid="JER 22:30">vorem keiner fun zain zomen vet nisht baglikn,</para>
  <para style="q" vid="JER 22:30">tsu zitsn oifn tron fun Dovid,</para>
  <para style="q" vid="JER 22:30">un vaiter geveltikn oif Yehudah.<verse eid="JER 22:30" /></para>
  <chapter eid="JER 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="JER 23" />
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1" />oi vei, di pastucher vos brengen um un tseshpreitn di shof fun main fiterung, zogt Hashem. <verse eid="JER 23:1" /><verse number="2" style="v" sid="JER 23:2" />derum hot Hashem Elokei Yisroel azoi gezogt oif di pastucher vos fitern main folk: ir hot tseshpreit maine shof, un zei farshtoisen, un hot nisht achtung gegebn oif zei; zet, ich rechn zich mit aich far aiere beize meisim, zogt Hashem. <verse eid="JER 23:2" /><verse number="3" style="v" sid="JER 23:3" />un ich vel ainzamlen dem iberblaib fun maine shof fun ale lender vos ich hob zei farshtoisen ahin, un ich vel zei umkeren tsu zeyer fiterplats, un zei veln zich fruchpern un mern. <verse eid="JER 23:3" /><verse number="4" style="v" sid="JER 23:4" />un ich vel oifshteln iber zei pastucher, un zei veln zei fitern; un zei veln mer nisht moire hobn un nisht angstn, un zei veln nisht geminert vern, zogt Hashem.<verse eid="JER 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 23:5" />ze, teg kumen, zogt Hashem, un ich vel oifshteln tsu Dovidn a gerechtn shprots, un kinign vet a kinig vos vet baglikn, un ton recht un gerechtikeit in land. <verse eid="JER 23:5" /><verse number="6" style="v" sid="JER 23:6" />in zaine teg vet geholfn vern Yehudah, un Yisroel vet ruen in zicherkeit; un dos iz zain nomen vos me vet im rufn: Hashem iz undzer gerechtikeit!<verse eid="JER 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 23:7" />far vor, ze, teg kumen, zogt Hashem, un me vet mer nisht zogn: azoi vi es lebt Hashem vos hot oifgebracht di kinder fun Yisroel fun land Mitsrayim! <verse eid="JER 23:7" /><verse number="8" style="v" sid="JER 23:8" />naiert: azoi vi es lebt Hashem vos hot oifgebracht un vos hot ahergefirt dem zomen fun dem hoiz fun Yisroel, fun tsofn-land un fun ale lender vos ich hob zei farshtoisen ahin! un zei veln zitsn oif zeyer erd.<verse eid="JER 23:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="JER 23:9" />fun vegen di neviim:</para>
  <para style="q" vid="JER 23:9">tsebrochn iz main harts in mir,</para>
  <para style="q" vid="JER 23:9">ale maine beiner tsiteren;</para>
  <para style="q" vid="JER 23:9">ich bin gevorn vi a mentsh a shikurer,</para>
  <para style="q" vid="JER 23:9">un vi a man vos vain hot im ibergeshtarkt;</para>
  <para style="q" vid="JER 23:9">fun vegen Hashem, un fun vegen zaine heilike verter.<verse eid="JER 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 23:10" />vorem ful iz mit nofim dos land,</para>
  <para style="q" vid="JER 23:10">vorem fun vegen a klole troiert dos land,</para>
  <para style="q" vid="JER 23:10">zainen fartriknt di fiterpletser fun midber;</para>
  <para style="q" vid="JER 23:10">un zeyer loifenish iz tsum beizn,</para>
  <para style="q" vid="JER 23:10">un zeyer gevure iz nisht erlech.<verse eid="JER 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 23:11" />vorem i der novi i der koyen zainen zindik,</para>
  <para style="q" vid="JER 23:11">afile in main hoiz hob ich gefunen zeyer beiz,</para>
  <para style="q" vid="JER 23:11">zogt Hashem.<verse eid="JER 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 23:12" />derum vet zeyer veg zei zain</para>
  <para style="q" vid="JER 23:12">vi a glitshiker ort in der fintster.</para>
  <para style="q" vid="JER 23:12">zei veln geshtoisn vern un faln oif im,</para>
  <para style="q" vid="JER 23:12">vorem ich vel brengen an umglik oif zei,</para>
  <para style="q" vid="JER 23:12">dos yor fun zeyer rechnshaft,</para>
  <para style="qr" vid="JER 23:12">zogt Hashem.<verse eid="JER 23:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 23:13" />oich bai di neviim fun Shomron hob ich gezen lesterung;</para>
  <para style="q" vid="JER 23:13">zei hobn nevies gezogt far Baal,</para>
  <para style="q" vid="JER 23:13">un hobn farfirt main folk Yisroel.<verse eid="JER 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 23:14" />ober bai di neviim fun Yerushalayim hob ich shoiderhaftiks gezen:</para>
  <para style="q" vid="JER 23:14">mizane zain, un umgein mit lign;</para>
  <para style="q" vid="JER 23:14">un zei shtarkn di hent fun di shlechtstuer,</para>
  <para style="q" vid="JER 23:14">az zei zoln zich nisht umkeren keiner fun zain beiz;</para>
  <para style="q" vid="JER 23:14">zei zainen mir ale vi Sodom gevorn,</para>
  <para style="q" vid="JER 23:14">un ire bavoiner azoi vi Amora.<verse eid="JER 23:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 23:15" />derum hot Hashem Tseva'ot azoi gezogt oif di neviim:</para>
  <para style="q" vid="JER 23:15">ze, ich mach zei esen vermut,</para>
  <para style="q" vid="JER 23:15">un vel zei machn trinken giftvaser,</para>
  <para style="q" vid="JER 23:15">vorem fun di neviim fun Yerushalayim</para>
  <para style="q" vid="JER 23:15">iz arois di zindikeit ibern gantsn land.<verse eid="JER 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 23:16" />azoi hot gezogt Hashem Tseva'ot:</para>
  <para style="q" vid="JER 23:16">ir zolt nisht hern tsu di verter fun di neviim vos zogn aich nevies;</para>
  <para style="q" vid="JER 23:16">zei farnarishn aich;</para>
  <para style="q" vid="JER 23:16">di zeung fun zeyer hartsn redn zei,</para>
  <para style="q" vid="JER 23:16">nisht oisn moil fun Hashem.<verse eid="JER 23:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 23:17" />zogn zei tsu di vos farachten mich:</para>
  <para style="q" vid="JER 23:17">Hashem hot geredt: ir et hobn sholem;</para>
  <para style="q" vid="JER 23:17">un itlechn vos geit in der aingeshpartikeit fun zain hartsn,</para>
  <para style="q" vid="JER 23:17">zogn zei: oif aich vet nisht kumen kein beiz.<verse eid="JER 23:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 23:18" />ober ver iz geshtanen in dem sod fun Hashem,</para>
  <para style="q" vid="JER 23:18">az er zol merken un hern zain vort?</para>
  <para style="q" vid="JER 23:18">ver hot farnumen zain vort un zich tsugehert?<verse eid="JER 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 23:19" />ze, a shturemvint fun Hashem,</para>
  <para style="q" vid="JER 23:19">a grimtsorn iz aroisgegangen,</para>
  <para style="q" vid="JER 23:19">un a heftiker shturemvint;</para>
  <para style="q" vid="JER 23:19">oif di kep fun di reshoim vet er faln.<verse eid="JER 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 23:20" />nisht opgein vet der tsorn fun Hashem,</para>
  <para style="q" vid="JER 23:20">biz er tut, un biz er iz mekayem,</para>
  <para style="q" vid="JER 23:20">di trachtungen fun zain hartsn;</para>
  <para style="q" vid="JER 23:20">in sof fun di teg vet ir dos gut farshtein.<verse eid="JER 23:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JER 23:21" />ich hob nisht geshikt di neviim,</para>
  <para style="q" vid="JER 23:21">un zei zainen gelofn,</para>
  <para style="q" vid="JER 23:21">ich hob nisht geredt tsu zei,</para>
  <para style="q" vid="JER 23:21">un zei hobn nevies gezogt.<verse eid="JER 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 23:22" />un oib zei zainen geshtanen in main sod,</para>
  <para style="q" vid="JER 23:22">zoln zei lozn hern main folk maine verter,</para>
  <para style="q" vid="JER 23:22">un zoln zei zei umkeren fun zeyer shlechtn veg,</para>
  <para style="q" vid="JER 23:22">un fun zeyere shlechte meisim.<verse eid="JER 23:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="JER 23:23" />bin ich den a G-t fun nontn, zogt Hashem, un nisht a G-t fun der vaitn? <verse eid="JER 23:23" /><verse number="24" style="v" sid="JER 23:24" />tsi ken zich farborgen a mentsh in farborgenishn, az ich zol im nisht zen? zogt Hashem. bin ich nisht fil di himlen un di erd? zogt Hashem. <verse eid="JER 23:24" /><verse number="25" style="v" sid="JER 23:25" />ich hob gehert vos di neviim zogn, di vos zogn nevies in main nomen lign, azoi tsu zogn: mir hot zich gecholemt, mir hot zich gecholemt! <verse eid="JER 23:25" /><verse number="26" style="v" sid="JER 23:26" />biz vanen noch? iz den in hartsn fun di neviim vos zogn nevies lign, un di neviim fun dem batrug fun zeyer hartsn – <verse eid="JER 23:26" /><verse number="27" style="v" sid="JER 23:27" />trachtn zei den tsu machn main folk fargesen main nomen mit zeyere chaloimes vos zei dertseiln einer dem andern, azoi vi zeyere eltern hobn fargesen main nomen durch Baal? <verse eid="JER 23:27" /><verse number="28" style="v" sid="JER 23:28" />der novi vos bai im iz a cholem, zol dertseiln a cholem, un der vos main vort iz bai im, zol redn main vort vorhaftik. vos hot shtroi tsu korn? zogt Hashem. <verse eid="JER 23:28" /><verse number="29" style="v" sid="JER 23:29" />far vor, main vort iz azoi vi faier, zogt Hashem, un vi a hamer vos tsehakt feldz. <verse eid="JER 23:29" /><verse number="30" style="v" sid="JER 23:30" />derum ze, ich kum oif di neviim, zogt Hashem, vos ganven maine verter einer fun andern. <verse eid="JER 23:30" /><verse number="31" style="v" sid="JER 23:31" />ze, ich kum oif di neviim, zogt Hashem, vos nemen zeyer tsung un zogt, er gezogt. <verse eid="JER 23:31" /><verse number="32" style="v" sid="JER 23:32" />ze, ich kum oif di vos zogn nevies falshe chaloimes, zogt Hashem, un dertseiln zei, un farfiren main folk mit zeyere shekorim un mit zeyer loizgeloztkeit, ven ich hob zei nisht geshikt un zei nisht bafoiln; un nutsn nutsn zei nisht dem dozikn folk, zogt Hashem.<verse eid="JER 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33" />un az dos dozike folk, oder der novi, oder a koyen, vet dich fregn, azoi tsu zogn: vos iz di mase fun Hashem? zolstu zogn tsu zei: vos iz di mase? – az ich vel aich farvorfen, zogt Hashem. <verse eid="JER 23:33" /><verse number="34" style="v" sid="JER 23:34" />un der novi, un der koyen, un dos folk, vos vet zogn di mase fun Hashem, vel ich zich oprechenen mit yenem mentshn un mit zain hoiz. <verse eid="JER 23:34" /><verse number="35" style="v" sid="JER 23:35" />azoi zolt ir zogn itlecher tsu zain chever, un itlecher tsu zain bruder: vos hot Hashem geentfert? un: vos hot Hashem geredt? <verse eid="JER 23:35" /><verse number="36" style="v" sid="JER 23:36" />ober mase fun Hashem zolt ir mer nisht dermonen vorem a mase vet vern far itlechn zain eigen vort, vail ir fardreit di verter fun dem lebedikn Elokim, Hashem Tseva'ot Elokeinu. <verse eid="JER 23:36" /><verse number="37" style="v" sid="JER 23:37" />azoi zolstu zogn tsum novi: vos hot dir Hashem geentfert? un: vos hot Hashem geredt? <verse eid="JER 23:37" /><verse number="38" style="v" sid="JER 23:38" />ober az ir zogt di mase fun Hashem – far vor, azoi hot Hashem gezogt: vail ir hot gezogt dos dozike vort di mase fun Hashem, ven ich hob geshikt tsu aich, azoi tsu zogn: ir zolt nisht zogn di mase fun Hashem, <verse eid="JER 23:38" /><verse number="39" style="v" sid="JER 23:39" />derum zet, ich vel aich raisndik oisraisn, un vel avekvarfn aich, un di shtot vos ich hob gegebn aich un aiere eltern, fun main ponem. <verse eid="JER 23:39" /><verse number="40" style="v" sid="JER 23:40" />un ich vel brengen oif aich an eibike charpe, un an eibike shand, vos vet nisht fargesen vern.<verse eid="JER 23:40" /></para>
  <chapter eid="JER 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="JER 24" />
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1" />Hashem hot mir gevizn, ersht tsvei kerb faign zainen avekgeshtelt far dem heichl fun Hashem; nochdem vi Nevuchadretsar der melech fun Bavel hot fartriben Yechanyah dem zun fun Yhoyakimen, dem melech fun Yehudah, un di harn fun Yehudah, un i mainsters un di shlesers, fun Yerushalayim, un zei gebracht kein Bavel. <verse eid="JER 24:1" /><verse number="2" style="v" sid="JER 24:2" />ein korb zeyer gute faign, azoi vi ershttsaitike faign, un ein korb zeyer shlechte faign, vos kenen nisht gegesn vern far shlechtikeit. <verse eid="JER 24:2" /><verse number="3" style="v" sid="JER 24:3" />un Hashem hot tsu mir gezogt: vos zestu Yirmeyah? hob ich gezogt: faign; di gute faign zainen zeyer gute, un di shlechte zainen zeyer shlechte, vos kenen nisht gegesn vern far shlechtikeit.<verse eid="JER 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4" />iz dos vort fun Hashem geven tsu mir, azoi tsu zogn: <verse eid="JER 24:4" /><verse number="5" style="v" sid="JER 24:5" />azoi hot gezogt Hashem Elokei Yisroel: azoi vi di dozike gute faign azoi vel ich derkenen tsum gutn di fartribene fun Yehudah. vos ich hob aroisgeshikt fun dem dozikn ort, in land fun di Kasdim. <verse eid="JER 24:5" /><verse number="6" style="v" sid="JER 24:6" />un ich vel ton main oig oif zei tsum gutn, un vel zei umkeren in dem dozikn land; un ich vel zei oifboien, un nisht tseshtern, un ich vel zei ainflantsn, un nisht oisraisn. <verse eid="JER 24:6" /><verse number="7" style="v" sid="JER 24:7" />un ich vel zei gebn a harts mich tsu kenen, az ich bin Hashem, un zei veln mir zain tsum folk, un ich vel zei zain tsum Elokim, vorem zei veln zich umkeren tsu mir mit zeyer gantsn hartsn.<verse eid="JER 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8" />un azoi vi di shlechte faign, vos kenen nisht gegesn vern far shlechtikeit – far vor, azoi hot Hashem gezogt – azoi vel ich machn Tsidkiyah dem melech fun Yehudah, un zaine harn, un dem iberblaib fun Yerushalayim, vos zainen ibergebliben in dem dozikn land, un di vos zitsn in land Mitsrayim. <verse eid="JER 24:8" /><verse number="9" style="v" sid="JER 24:9" />un ich vel zei machn far a shoider tsum beizn bai ale kinigraichn fun der erd; far a shand un far a shprichvort, far a shpot un far a klole, in ale erter vos ich vel zei farshtoisen ahin. <verse eid="JER 24:9" /><verse number="10" style="v" sid="JER 24:10" />un ich vel onshikn oif zei di shverd, dem hunger, un di pest, biz zei veln farlendt vern fun der erd vos ich hob gegebn zei un zeyere eltern.<verse eid="JER 24:10" /></para>
  <chapter eid="JER 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="JER 25" />
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1" />dos vort vos iz geven tsu Yirmeyahun oif dem gantsn folk fun Yehudah in firtn yor fun Yhoyakim dem zun fun Yoshiyahun, dem melech fun Yehudah – dos iz dos ershte yor fun Nevuchadretsar dem melech fun Bavel – <verse eid="JER 25:1" /><verse number="2" style="v" sid="JER 25:2" />vos Yirmeyah hanovi hot geredt tsu dem gantsn folk fun Yehudah, un tsu ale bavoiner fun Yerushalayim, azoi tsu zogn: <verse eid="JER 25:2" /><verse number="3" style="v" sid="JER 25:3" />fun draitsntn yor fun Yoshiyah dem zun fun Amonen, dem melech fun Yehudah, un biz oif haintikn tog, shoin drai un tsvantsik yor iz dos vort fun Hashem tsu mir, un ich hob geredt tsu aich, nochanand un nochanand geredt, un ir hot nisht tsugehert. <verse eid="JER 25:3" /><verse number="4" style="v" sid="JER 25:4" />un Hashem hot tsu aich geshikt ale zaine knecht di neviim, nochanand un nochanand geshikt – ober ir hot nisht tsugehert un nisht tsugenaigt aier oier tsu hern – <verse eid="JER 25:4" /><verse number="5" style="v" sid="JER 25:5" />azoi tsu zogn: kert aich um fort itlecher fun zain shlechtn veg, un fun aiere shlechte meisim, un blaibt zitsn oif der erd vos Hashem hot gegebn aich un aiere eltern fun eibik un biz eibik, <verse eid="JER 25:5" /><verse number="6" style="v" sid="JER 25:6" />un ir zolt nisht gein noch fremde g‑ter zei tsu dinen, un zich tsu bukn tsu zei, un ir zolt mich nisht dertserenen mit dem verk fun aiere hent, un ich vel aich nisht beiz ton. <verse eid="JER 25:6" /><verse number="7" style="v" sid="JER 25:7" />ober ir hot nisht tsugehert tsu mir, zogt Hashem, kedei mich tsu dertserenen mit dem verk fun aiere hent, tsu aier eigener roe.<verse eid="JER 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8" />derum hot Hashem Tseva'ot azoi gezogt: vail ir hot nisht tsugehert maine verter, <verse eid="JER 25:8" /><verse number="9" style="v" sid="JER 25:9" />ot shik ich un vel nemen ale mishpoches fun tsofn, zogt Hashem, un tsu Nevuchadretsar dem melech fun Bavel, main knecht; un ich vel zei brengen oif dem dozikn land, un oif ire bavoiner, un oif ale di dozike felker rund arum, un ich vel zei farvistn, un vel zei machn far a shrek un far a shmutserung, un far eibike churves. <verse eid="JER 25:9" /><verse number="10" style="v" sid="JER 25:10" />un ich vel fartiliken fun zei dem kol fun lustikeit un dem kol fun freid, dem kol fun a chosen un dem kol fun a kale, dos kol fun a hantmil, un dem licht fun a lomp. <verse eid="JER 25:10" /><verse number="11" style="v" sid="JER 25:11" />un dos dozike gantse land vet vern a farvistung un a vistenish, un di dozike felker veln dinen dem melech fun Bavel zibetsik yor. <verse eid="JER 25:11" /><verse number="12" style="v" sid="JER 25:12" />un es vet zain, az di zibetsik yor vern ful, vel ich zich rechenen mit dem melech fun Bavel, un mit yenem folk, zogt Hashem, far zeyer zind, un mit dem land fun di Kasdim; un ich vel es machn far eibike vistenishn. <verse eid="JER 25:12" /><verse number="13" style="v" sid="JER 25:13" />un ich vel brengen oif yenem land ale maine verter vos ich hob geredt deroif, alts vos shteit geshribn in dem dozikn buch, vos Yirmeyah hot nevies gezogt oif ale felker. <verse eid="JER 25:13" /><verse number="14" style="v" sid="JER 25:14" />vorem fil felker un groise mlochim veln oich zei farknechtn; un ich vel zei batsoln loit zeyer tuung un loit dem verk fun zeyere hent.<verse eid="JER 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15" />vorem azoi hot gezogt Hashem Elokei Yisroel tsu mir: nem dem dozikn kos mit vain fun grimtsorn, fun main hant, un zolst im gebn trinken ale felker vos ich shik dich tsu zei. <verse eid="JER 25:15" /><verse number="16" style="v" sid="JER 25:16" />un zei veln trinken, un zich vaklen, un meshuge vern, fun vegen der shverd vos ich shik tsvishn zei.<verse eid="JER 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 25:17" />un ich hob genumen dem kos fun G-ts hant, un hob gegebn trinken ale felker vos Hashem hot mich tsu zei geshikt: <verse eid="JER 25:17" /><verse number="18" style="v" sid="JER 25:18" />Yerushalayim, un di shtet fun Yehudah, un ire mlochim, ire harn, kedei zei tsu machn far a farvistung, far a shrek, far a shmutserung, un far a klole, azoi vi haintikn tog; <verse eid="JER 25:18" /><verse number="19" style="v" sid="JER 25:19" />Pharaoh dem melech fun Mitsrayim, un zaine knecht, un zaine harn, un zain gantsn folk; <verse eid="JER 25:19" /><verse number="20" style="v" sid="JER 25:20" />un ale gemishte felker, un ale mlochim fun land Uts, un ale mlochim fun land Pelishtim, un Ashkelon, un Azah, un Ekron, un dem iberblaib fun Ashdod; <verse eid="JER 25:20" /><verse number="21" style="v" sid="JER 25:21" />Edom, un Moav, un di kinder fun Amon; <verse eid="JER 25:21" /><verse number="22" style="v" sid="JER 25:22" />un ale mlochim fun Tsor, un ale mlochim fun Tsidon, un di mlochim fun dem indzel vos oif yener zait fun dem yam; <verse eid="JER 25:22" /><verse number="23" style="v" sid="JER 25:23" />Dedan, un Tema, un Buz, un ale mit opgehakte peyes; <verse eid="JER 25:23" /><verse number="24" style="v" sid="JER 25:24" />un ale Arabish mlochim, un ale mlochim fun di gemishte felker, vos voinen in midber; <verse eid="JER 25:24" /><verse number="25" style="v" sid="JER 25:25" />un ale mlochim fun Zimri, un ale mlochim fun Eilam, un ale mlochim fun Madai; <verse eid="JER 25:25" /><verse number="26" style="v" sid="JER 25:26" />un ale mlochim fun tsofn, di nonte un di vaite, einem nochn andern, un ale kinigraichn fun der velt vos oifn gezicht fun der erd. un der melech fun Sheshach zol trinken noch zei.<verse eid="JER 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27" />un zolst zogn tsu zei: azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: trinkt un vert shikur, un brecht, un falt un shteit nisht oif, fun vegen der shverd vos ich shik tsvishn aich.<verse eid="JER 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 25:28" />un es vet zain, az zei veln nisht veln nemen dem kos fun dain hant, tsu trinken, zolstu zogn tsu zei: azoi hot gezogt Hashem Tseva'ot: trinken muzt ir trinken! <verse eid="JER 25:28" /><verse number="29" style="v" sid="JER 25:29" />vorem zet, mit der shtot vos main nomen vert gerufn oif ir, heib ich on beiz tsu ton, un ir zolt shoinen farshoint vern? ir vet nisht farshoint vern, vorem ich ruf a shverd oif ale bavoiner fun der erd, zogt Hashem Tseva'ot.<verse eid="JER 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 25:30" />un du zolst nevies zogn oif zei ale di dozike verter, un zogn tsu zei:</para>
  <para style="b" vid="JER 25:30" />
  <para style="q" vid="JER 25:30">Hashem brilt fun der heich,</para>
  <para style="q" vid="JER 25:30">un fun zain heiliker voinung lozt er arois zain kol:</para>
  <para style="q" vid="JER 25:30">briln brilt er iber zain fiterplats,</para>
  <para style="q" vid="JER 25:30">heidad! vi vaintreter shrait er</para>
  <para style="q" vid="JER 25:30">oif ale bavoiner fun der erd.<verse eid="JER 25:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 25:31" />der liarem greicht biz ek erd,</para>
  <para style="q" vid="JER 25:31">vorem Hashem hot a krig mit di felker,</para>
  <para style="q" vid="JER 25:31">er mishpot zich mit ale laiber;</para>
  <para style="q" vid="JER 25:31">di reshoim, zei git er iber tsum shverd,</para>
  <para style="qr" vid="JER 25:31">zogt Hashem.<verse eid="JER 25:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 25:32" />azoi hot gezogt Hashem Tseva'ot:</para>
  <para style="q" vid="JER 25:32">ze, an umglik geit arois fun folk tsu folk,</para>
  <para style="q" vid="JER 25:32">un a groiser shturem vet zich dervekn</para>
  <para style="q" vid="JER 25:32">in di ekn fun der erd.<verse eid="JER 25:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="JER 25:33" />un di dershlogene fun Hashem veln zain in yenem tog fun ek erd biz ek erd; zei veln nisht baklogt, un nisht aingezamlt un nisht bagrobn vern; tsu mist oifn gezicht fun der erd veln zei zain.<verse eid="JER 25:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="JER 25:34" />iomert, ir pastucher, un shrait,</para>
  <para style="q" vid="JER 25:34">un kaiklt aich in shtoib, ir harn fun di shof,</para>
  <para style="q" vid="JER 25:34">vorem aiere teg zainen ful tsum shechtn</para>
  <para style="q" vid="JER 25:34">un aiere goles;</para>
  <para style="q" vid="JER 25:34">un ich vel aich tsebrechn,</para>
  <para style="q" vid="JER 25:34">un ir vet faln vi a keile a taiere.<verse eid="JER 25:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 25:35" />un kein antloifung vet nisht zain far di pastucher,</para>
  <para style="q" vid="JER 25:35">un kein antrinung far di harn fun di shof.<verse eid="JER 25:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 25:36" />a kol fun geshrei fun di pastucher,</para>
  <para style="q" vid="JER 25:36">un a yelole fun di harn fun di shof!</para>
  <para style="q" vid="JER 25:36">vorem Hashem farvist zeyer fiterung.<verse eid="JER 25:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 25:37" />un farshnitn veln vern di fridleche fiter peletser,</para>
  <para style="q" vid="JER 25:37">fun vegen dem grimtsorn fun Hashem.<verse eid="JER 25:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 25:38" />er hot farlozen vi a yungleib zain baheltenish;</para>
  <para style="q" vid="JER 25:38">zeyer land iz gevorfn tsu vist fun vegen dem geirem fun der fartilikerin,</para>
  <para style="q" vid="JER 25:38">un fun vegen dem geirem fun zain tsorn.<verse eid="JER 25:38" /></para>
  <chapter eid="JER 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="JER 26" />
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1" />in onheib fun der meluche fun Yhoyakim dem zun fun Yoshiyahun, dem melech fun Yehudah, iz geven dos dozike vort fun Hashem, azoi tsu zogn: <verse eid="JER 26:1" /><verse number="2" style="v" sid="JER 26:2" />azoi hot Hashem gezogt: shtel zich in hoif fun Hashems hoiz, un zolst redn tsu ale shtet fun Yehudah vos kumen zich bukn in hoiz fun Hashem, ale verter vos ich hob dir bafoiln tsu redn tsu zei; zolst nisht minern a vort. <verse eid="JER 26:2" /><verse number="3" style="v" sid="JER 26:3" />efsher veln zei hern, un zei veln zich umkeren itlecher fun zei shlechtn veg, un ich vel charote hobn oif dem beiz vos ich tracht zei tsu ton, fun vegen zeyere shlechte meisim. <verse eid="JER 26:3" /><verse number="4" style="v" sid="JER 26:4" />un zolst zogn tsu zei: azoi hot Hashem gezogt: oib ir vet nisht tsuhern tsu mir, tsu gein in main toyre vos ich hob geleigt far aich, <verse eid="JER 26:4" /><verse number="5" style="v" sid="JER 26:5" />tsutsuhern tsu di verter fun maine knecht di neviim, vos ich shik tsu aich, un shik nochanand un nochanand, un ir hot nisht tsugehert, <verse eid="JER 26:5" /><verse number="6" style="v" sid="JER 26:6" />vel ich machn dos dozike hoiz azoi vi Shiloh, un di dozike shtot vel ich machn far a klole bai ale felker fun der erd.<verse eid="JER 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7" />un di koyanim un di neviim un dos gantse folk hobn gehert Yirmeyahun redn di dozike verter in hoiz fun Hashem. <verse eid="JER 26:7" /><verse number="8" style="v" sid="JER 26:8" />un es iz geven, vi Yirmeyah hot geendikt redn alts vos Hashem hot im bafoiln tsu redn tsum gantsn folk, azoi hobn di koyanim un di neviim un dos gantse folk im ongechapt, azoi tsu zogn: shtarbn muztu shtarbn! <verse eid="JER 26:8" /><verse number="9" style="v" sid="JER 26:9" />lemai hostu nevies gezogt in nomen fun Hashem, azoi tsu zogn: azoi vi Shiloh vet vern dos dozike hoiz, un di dozike shtot vet zain vist on a bavoiner? un dos gantse folk hot zich aingezamlt kegen Yirmeyahun in hoiz fun Hashem.<verse eid="JER 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10" />un di harn fun Yehudah hobn gehert di dozike verter, un zei zainen aroifgekumen fun dem melechs hoiz in hoiz fun Hashem, un hobn zich gezetst in aingang fun dem naiem toier fun Hashem. <verse eid="JER 26:10" /><verse number="11" style="v" sid="JER 26:11" />un di koyanim un di neviim hobn gezogt tsu di harn un tsum gantsn folk, azoi tsu zogn: toitshtrof kumt dem dozikn man, vail er hot nevies gezogt oif der doziker shtot, azoi vi ir hot gehert mit aiere oiern.<verse eid="JER 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12" />hot Yirmeyah gezogt tsu ale harn un tsum gantsn folk, azoi tsu zogn: Hashem hot mich geshikt nevies tsu zogn oif dem dozikn hoiz un oif der doziker shtot ale verter vos ir hot gehert. <verse eid="JER 26:12" /><verse number="13" style="v" sid="JER 26:13" />un atsund besert aiere vegen un aiere meisim, un hert tsu dem kol fun Hashem Elokeichem, un Hashem vet charote hobn oif dem beiz vos er hot ongezogt oif aich. <verse eid="JER 26:13" /><verse number="14" style="v" sid="JER 26:14" />un ich, ot bin ich in aiere hent, tut mit mir azoi vi es iz voil un vi es iz rechtfartik in aiere oign. <verse eid="JER 26:14" /><verse number="15" style="v" sid="JER 26:15" />ober visen zolt ir visen zain, az oib ir teit mich, brengt ir umshuldik blut oif aich, un oif der doziker shtot, un oif ire bavoiner, vorem Hashem hot mich be'emes geshikt tsu aich, tsu redn in aiere oiern ale di dozike verter.<verse eid="JER 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16" />hobn di harn un dos gantse folk gezogt tsu di koyanim un tsu di neviim: dem dozikn man kumt nisht toitshtrof, vorem in nomen fun Hashem Elokeinu hot er geredt tsu undz. <verse eid="JER 26:16" /><verse number="17" style="v" sid="JER 26:17" />un mener fun di eltste fun land zainen oifgeshtanen, un hobn gezogt tsu der gantser ainzamlung fun folk, azoi tsu zogn: <verse eid="JER 26:17" /><verse number="18" style="v" sid="JER 26:18" />Michah fun Moreshet flegt nevies zogn in di teg fun Chizkiyah dem melech fun Yehudah, un hot gezogt tsum gantsn folk fun Yehudah azoi tsu zogn:</para>
  <para style="b" vid="JER 26:18" />
  <para style="q" vid="JER 26:18">azoi hot gezogt Hashem Tseva'ot:</para>
  <para style="q" vid="JER 26:18">Tsiyon vet vi a feld tseakert vern,</para>
  <para style="q" vid="JER 26:18">un Yerushalayim vet hoifns vern,</para>
  <para style="q" vid="JER 26:18">un der barg fun Hashems hoiz tsu valdike heichn.<verse eid="JER 26:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="JER 26:19" />hobn im den teitn geteit Chizkiyah der melech fun Yehudah un gants Yehudah? far vor, er hot moire gehat far Hashem, un er hot gebetn bai Hashem, un G-t hot charote gehat oif dem beiz vos er hot ongezogt oif zei; un mir tuen zich alein a grois beiz.<verse eid="JER 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20" />un noch a man flegt nevies zogn in nomen fun Hashem, Uriyah der zun fun Shemayahuen, fun Kiryat-Yearim; un er hot nevies gezogt oif der doziker shtot un oif dem dozikn land, azoi vi ale verter fun Yirmeyah. <verse eid="JER 26:20" /><verse number="21" style="v" sid="JER 26:21" />un der melech Yhoyakim, un ale zaine giborim, un ale harn, hobn gehert zaine verter, un der melech hot im gezucht tsu teitn; ober Uriyah hot gehert derfun, un er hot moire gekrign, un iz antlofn un gekumen kein Mitsrayim. <verse eid="JER 26:21" /><verse number="22" style="v" sid="JER 26:22" />hot der melech Yhoyakim geshikt mentshn kein Mitsrayim, Elnatan dem zun fun Achborn, un noch mentshn mit im, kein Mitsrayim. <verse eid="JER 26:22" /><verse number="23" style="v" sid="JER 26:23" />un zei hobn aroisgetsoign Uriyahun fun Mitsrayim, un hobn im gebracht tsum melech Yhoyakim, un er hot im dershlogn mitn shverd, un avekgevorfen zain toit laib tsvishn di kvorim fun di kinder fun folk.<verse eid="JER 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24" />ober di hant fun Achikam dem zun fun Shafanen iz geven mit Yirmeyahun, az me zol im nisht gebn in der hant fun folk im tsu teitn.<verse eid="JER 26:24" /></para>
  <chapter eid="JER 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="JER 27" />
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1" />in onheib fun der meluche fun Yhoyakim dem zun fun Yoshiyahun, dem melech fun Yehudah, iz geven dos dozike vort tsu Yirmeyahn fun Hashem, azoi tsu zogn: <verse eid="JER 27:1" /><verse number="2" style="v" sid="JER 27:2" />azoi hot gezogt Hashem tsu mir: mach dir bindshtrik un yochshtangen, un zolst zei onton oif dain haldz. <verse eid="JER 27:2" /><verse number="3" style="v" sid="JER 27:3" />un zolst zei shikn tsu dem melech fun Edom, un tsu dem melech fun Moav, un tsu dem melech fun di kinder fun Amon, un tsu dem melech fun Tsor, un tsu dem melech fun Tsidon, durch der hant fun di shluchim vos kumen kein Yerushalayim tsu Tsidkiyah dem melech fun Yehudah. <verse eid="JER 27:3" /><verse number="4" style="v" sid="JER 27:4" />un zolst zei bafeln far zeyere harn, azoi tsu zogn: azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: azoi zolt ir zogn tsu aiere harn: <verse eid="JER 27:4" /><verse number="5" style="v" sid="JER 27:5" />ich hob gemacht di erd, di mentshn un di beheimes vos oifn gezicht fun der erd, mit main grois shtarkeit, un mit main oisgeshtrektn orem; un ich gib es tsu dem vos iz voilgefeln in maine oign. <verse eid="JER 27:5" /><verse number="6" style="v" sid="JER 27:6" />un atsund hob ich gegebn ale di dozike lender in der hant fun Nevuchadnetsar dem melech fun Bavel, main knecht, un oich di chaye fun feld hob ich im gegebn im tsu dinen. <verse eid="JER 27:6" /><verse number="7" style="v" sid="JER 27:7" />un ale felker veln dinen im, un zain zun, un zain zuns zun, biz es kumt di tsait oich fun zain land, un fil felker un groise mlochim veln im farknechtn.<verse eid="JER 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8" />un es vet zain, dos folk un dos kinigraich vos vet im, Nevuchadnetsar dem melech fun Bavel, nisht dinen, un vos vet nisht arainton zain haldz in dem yoch fun dem melech fun Bavel, vel ich mit shverd un mit hunger un mit pest zich oprechenen mit yenem folk, zogt Hashem, biz ich tu zei farlendn durch zain hant. <verse eid="JER 27:8" /><verse number="9" style="v" sid="JER 27:9" />un ir zolt nisht tsuhern tsu aiere neviim, un tsu aiere vorzoger, un tsu aiere chaloimes, un tsu aiere tseichnzeer, un tsu aiere mechashfim, vos zogn aich, azoi tsu zogn: ir vet nisht dinen dem melech fun Bavel. <verse eid="JER 27:9" /><verse number="10" style="v" sid="JER 27:10" />vorem lign zogn zei aich nevies, kedei aich tsu dervaitern fun aier erd, un kedei ich zol aich farshtoisen, un ir zolt untergein. <verse eid="JER 27:10" /><verse number="11" style="v" sid="JER 27:11" />ober dos folk vos vet arainbrengen zain haldz in dem yoch fun dem melech fun Bavel, un vet im dinen, vel ich im lozn oif zain erd, zogt Hashem, un er et zi baarbetn, un zitsn oif ir.<verse eid="JER 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12" />oich tsu Tsidkiyah dem melech fun Yehudah hob ich geredt azoi vi ale di dozike verter, azoi tsu zogn: brengt aier haldz in dem yoch fun dem melech fun Bavel, un dint im un zain folk, un blaibt lebn. <verse eid="JER 27:12" /><verse number="13" style="v" sid="JER 27:13" />noch vos zolt ir shtarbn, du un dain folk, fun shverd, fun hunger, un fun pest, azoi vi Hashem hot ongezogt oif dem folk vos vet nisht dinen dem melech fun Bavel? <verse eid="JER 27:13" /><verse number="14" style="v" sid="JER 27:14" />un ir zolt nisht tsuhern tsu di verter fun di neviim vos zogn tsu aich, azoi tsu zogn: ir zolt nisht dinen dem melech fun Bavel; vorem lign zogn zei aich nevies. <verse eid="JER 27:14" /><verse number="15" style="v" sid="JER 27:15" />vorem ich hob zei nisht geshikt, zogt Hashem, un zei zogn nevies in main nomen oif lign, kedei ich zol aich farshtoisen, un i ir zolt untergein, i di neviim vos zogn aich nevies.<verse eid="JER 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16" />un tsu di koyanim un tsu dem dozikn gantsn folk hob ich geredt, azoi tsu zogn: azoi hot Hashem gezogt: ir zolt nisht tsuhern tsu di verter fun aiere neviim vos zogn aich nevies, azoi tsu zogn: ot veln di keilim fun Hashems hoiz atsund in gichn umgekert vern fun Bavel; vorem lign zogn zei aich nevies. <verse eid="JER 27:16" /><verse number="17" style="v" sid="JER 27:17" />ir zolt nisht tsuhern tsu zei; dint dem melech fun Bavel, un blaibt lebn; noch vos zol di dozike shtot vern a vistenish? <verse eid="JER 27:17" /><verse number="18" style="v" sid="JER 27:18" />un oib zei zainen neviim, un oib dos vort fun Hashem iz bai zei, zoln zei akorsht betn bai Hashem Tseva'ot, az di keilim vos zainen noch geblibn in hoiz fun Hashem, un in hoiz fun dem melech fun Yehudah, un in Yerushalayim, zoln nisht onkumen kein Bavel. <verse eid="JER 27:18" /><verse number="19" style="v" sid="JER 27:19" />vorem azoi hot gezogt Hashem Tseva'ot oif di zailn, un oif dem yam, un oif di geshteln, un oif dem resht keilim, vos zainen geblibn in der doziker shtot, <verse eid="JER 27:19" /><verse number="20" style="v" sid="JER 27:20" />di vos Nevuchadnetsar der melech fun Bavel hot zei nisht tsugenumen, ven er hot fartriben Yechanyah dem zun fun Yhoyakimen, dem melech fun Yehudah, fun Yerushalayim kein Bavel, mit ale adllait fun Yehudah un Yerushalayim; <verse eid="JER 27:20" /><verse number="21" style="v" sid="JER 27:21" />far vor, azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel, oif di keilim vos zainen geblibn in hoiz fun Hashem, un in hoiz fun dem melech fun Yehudah, un in Yerushalayim: <verse eid="JER 27:21" /><verse number="22" style="v" sid="JER 27:22" />kein Bavel veln zei gebracht vern, un dortn veln zei zain, biz dem tog vos ich tu zich dermonen on zei, zogt Hashem, un vel zei oifbrengen un zei umkeren tsu dem dozikn ort.<verse eid="JER 27:22" /></para>
  <chapter eid="JER 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="JER 28" />
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1" />un es iz geven in yenem yor, in onheib fun der meluche fun Tsidkiyah dem melech fun Yehudah, in firtn yor, in finftn choidesh, hot tsu mir gezogt Chananyah der zun fun eazur dem novi vos fun Givon, in hoiz fun Hashem far di oign fun di koyanim un fun gantsn folk, azoi tsu zogn: <verse eid="JER 28:1" /><verse number="2" style="v" sid="JER 28:2" />azoi hot geredt Hashem Tseva'ot, Elokei Yisroel, azoi tsu zogn: ich hob tsebrochn dem yoch fun dem melech fun Bavel. <verse eid="JER 28:2" /><verse number="3" style="v" sid="JER 28:3" />in noch tsvei yor tsait ker ich arum tsu dem dozikn ort ale keilim fun Hashems hoiz, vos Nevuchadnetsar der melech fun Bavel hot avekgenumen fun dem dozikn ort, un zei gebracht kein Bavel; <verse eid="JER 28:3" /><verse number="4" style="v" sid="JER 28:4" />un Yechanyah dem zun fun Yhoyakimen, dem melech fun Yehudah, un ale fartribene fun Yehudah, vos zainen gekumen kein Bavel, ker ich um tsu dem dozikn ort, zogt Hashem; vorem ich vel tsebrechn dem yoch fun dem melech fun Bavel.<verse eid="JER 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5" />hot Yirmeyah hanovi gezogt tsu Chananyah dem novi far di oign fun di koyanim, un far di oign fun dem gantsn folk, vos zainen geshtanen in hoiz fun Hashem – <verse eid="JER 28:5" /><verse number="6" style="v" sid="JER 28:6" />hot Yirmeyah hanovi gezogt: Omein! zol Hashem ton azoi! zol Hashem mekayem zain daine verter vos du host nevies gezogt, umtsukeren di keilim fun Hashems hoiz, un ale fartribene, fun Bavel tsu dem dozikn ort. <verse eid="JER 28:6" /><verse number="7" style="v" sid="JER 28:7" />ober her akorsht dos dozike vort, vos ich red in daine oiern, un in di oiern fun gantsn folk: <verse eid="JER 28:7" /><verse number="8" style="v" sid="JER 28:8" />di neviim vos zainen geven far mir un far dir fun eibik on, hobn nevies gezogt iber fil lender, un iber groise meluchut, oif milchome, un oif umglik, un oif pest. <verse eid="JER 28:8" /><verse number="9" style="v" sid="JER 28:9" />der novi vos zogt nevies oif sholem, iz, ersht az dos vort fun dem novi kumt on, vert der novi derkent, az Hashem hot im mit an emes geshikt.<verse eid="JER 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10" />hot Chananyah der novi aropgenumen dem yochshtang fun Yirmeyah henvis haldz, un hot im tsebrochn. <verse eid="JER 28:10" /><verse number="11" style="v" sid="JER 28:11" />un Chananyah hot gezogt far di oign fun gantsn folk, azoi tsu zogn: azoi hot Hashem gezogt: azoi vel ich tsebrechn dem yoch fun Nevuchadnetsar dem melech fun Bavel, in noch tsvei yor tsait, fun dem haldz fun ale felker. – un Yirmeyah hanovi iz gegangen oif zain veg.<verse eid="JER 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12" />un dos vort fun Hashem iz geven tsu Yirmeyahn, nochdem vi Chananyah der novi hot tsebrochn dem yochshtang fun Yirmeyah henvis haldz, azoi tsu zogn: <verse eid="JER 28:12" /><verse number="13" style="v" sid="JER 28:13" />gei, un zolst zogn tsu Chananyahn, azoi tsu zogn: azoi hot Hashem gezogt: hiltserne shtangen hostu tsebrochn, un vest machn anshtot zei aizerne shtangen. <verse eid="JER 28:13" /><verse number="14" style="v" sid="JER 28:14" />vorem azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: an aizernem yoch hob ich gegebn oifn haldz fun ale di dozike felker, tsu dinen Nevuchadnetsar dem melech fun Bavel, un zei veln im dinen; un afile di chaye fun feld hob ich im gegebn. <verse eid="JER 28:14" /><verse number="15" style="v" sid="JER 28:15" />un Yirmeyah hanovi hot gezogt tsu Chananyah dem novi: her akorsht, Chananyah, Hashem hot dich nisht geshikt, un du host gemacht farzichern dos dozike folk oif lign. <verse eid="JER 28:15" /><verse number="16" style="v" sid="JER 28:16" />derum hot Hashem azoi gezogt: ze, ich shik dich avek fun gezicht fun der erd; hayyor vestu shtarbn, vail opkerung hostu geredt kegen Hashem.<verse eid="JER 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17" />– un Chananyah der novi iz geshtorbn in yenem yor in zibetn choidesh.<verse eid="JER 28:17" /></para>
  <chapter eid="JER 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="JER 29" />
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1" />un dos zainen di verter fun dem briv vos Yirmeyah hanovi hot geshikt fun Yerushalayim tsu dem iberblaib fun di eltste fun di fartribene, un tsu di koyanim, un tsu di neviim, un tsu dem gantsn folk, vos Nevuchadnetsar hot fartriben fun Yerushalayim kein Bavel; <verse eid="JER 29:1" /><verse number="2" style="v" sid="JER 29:2" />nochdem vi Yechanyah der melech, un di muter-malke, un di hoifdiner, di harn fun Yehudah un Yerushalayim, un di mainsters un di shlesers, zainen aroisgegangen fun Yerushalayim; <verse eid="JER 29:2" /><verse number="3" style="v" sid="JER 29:3" />durch der hant fun Elasah dem zun fun Shafanen, un Gemaryah dem zun fun Chilkiyahn, vos Tsidkiyah der melech fun Yehudah hot geshikt tsu Nevuchadnetsar dem melech fun Bavel kein Bavel – azoi tsu zogn: <verse eid="JER 29:3" /><verse number="4" style="v" sid="JER 29:4" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel, tsu ale fartribene vos ich hob fartriben fun Yerushalayim kein Bavel: <verse eid="JER 29:4" /><verse number="5" style="v" sid="JER 29:5" />boit haizer un bavoint, un flantst gertner un est zeyer frucht; <verse eid="JER 29:5" /><verse number="6" style="v" sid="JER 29:6" />nemt vaiber, un gebert zin un techter, un nemt vaiber far aiere zin, un git ois aiere techter tsu manen, un zoln zei gebern zin un techter, un mert aich dortn, un minert aich nisht. <verse eid="JER 29:6" /><verse number="7" style="v" sid="JER 29:7" />un zucht dem frid fun der shtot vos ich hob aich fartriben ahin, un zait mispalel far ir tsu Hashem, vorem in ir frid vet zain frid tsu aich. <verse eid="JER 29:7" /><verse number="8" style="v" sid="JER 29:8" />vorem azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: zol aiere neviim vos tsvishn aich, un aiere vorzogers aich nisht narn, un ir zolt nisht tsuhern tsu aiere chaloimes vos ir lozt cholemen. <verse eid="JER 29:8" /><verse number="9" style="v" sid="JER 29:9" />vorem mit lign zogn zei aich nevies in main nomen; ich hob zei nisht geshikt, zogt Hashem.<verse eid="JER 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 29:10" />vorem azoi hot Hashem gezogt: ven es vet derfilt vern zibetsik yor fun oif Bavel, vel ich zich dermonen on aich, un vel mekayem zain main gutn tsuzog, aich umtsukeren tsu dem dozikn ort. <verse eid="JER 29:10" /><verse number="11" style="v" sid="JER 29:11" />vorem ich veis di trachtungen vos ich tracht vegen aich, zogt Hashem, trachtungen fun frid, un nisht tsum beizn, kedei aich tsu gebn a tsukunft un a hofenung. <verse eid="JER 29:11" /><verse number="12" style="v" sid="JER 29:12" />un ir vet mich rufn, un ir vet gein un vet mispalel zain tsu mir, un ich vel tsuhern tsu aich. <verse eid="JER 29:12" /><verse number="13" style="v" sid="JER 29:13" />un ir vet mich zuchn un gefinen, az ir vet mich forshn mit aier gantsn hartsn. <verse eid="JER 29:13" /><verse number="14" style="v" sid="JER 29:14" />un ich vel zich lozn gefinen fun aich, zogt Hashem, un ich vel umkeren aier gefangenshaft, un vel aich ainzamlen fun ale felker, un fun ale erter, vos ich hob aich farshtoisen ahin, zogt Hashem, un ich vel aich umkeren tsu dem ort, vos ich hob aich fartriben fun dortn.<verse eid="JER 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 29:15" />vail ir hot gezogt: Hashem hot undz oifgeshtelt neviim in Bavel. <verse eid="JER 29:15" /><verse number="16" style="v" sid="JER 29:16" />vorem azoi hot Hashem gezogt oif dem melech vos zitst oifn tron fun Dovid, un oif dem gantsn folk vos zitst in der doziker shtot – aiere brider vos zainen nisht arois mit aich in goles: <verse eid="JER 29:16" /><verse number="17" style="v" sid="JER 29:17" />azoi hot gezogt Hashem Tseva'ot: ze, ich shik on oif zei di shverd, dem hunger, un di pest, un ich vel zei machn azoi vi ekldike faign vos kenen nisht gegesn vern far shlechtikeit. <verse eid="JER 29:17" /><verse number="18" style="v" sid="JER 29:18" />un ich vel zei nochyogn mit der shverd, mitn hunger, un mit der pest, un ich vel zei machn far a shoider bai ale kinigraichn fun der erd, far a klole, un far a shrek, un far a shmutserung, un far a shand, tsvishn ale felker, vos ich hob zei farshtoisen ahin; <verse eid="JER 29:18" /><verse number="19" style="v" sid="JER 29:19" />far vos zei hobn nisht tsugehert tsu maine verter, zogt Hashem, ven ich hob geshikt tsu zei maine knecht di neviim, nochanand un nochanand geshikt; un ir hot nisht tsugehert, zogt Hashem. <verse eid="JER 29:19" /><verse number="20" style="v" sid="JER 29:20" />derum hert dos vort fun Hashem, ir ale fartribene, vos ich hob aroisgeshikt fun Yerushalayim kein Bavel: <verse eid="JER 29:20" /><verse number="21" style="v" sid="JER 29:21" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel, oif Achav dem zun fun Kolayahn, un oif Tsidkiyah dem zun fun Maaseiyahn, vos zogn aich nevies in main nomen lign: ze, ich gib zei in der hant fun Nevuchadretsar dem melech fun Bavel, un er vet zei dershlogn far aiere oign. <verse eid="JER 29:21" /><verse number="22" style="v" sid="JER 29:22" />un fun zei vet genumen vern a klole bai ale fartribene fun Yehudah vos in Bavel, azoi tsu zogn: zol dich Hashem machn azoi vi Tsidkiyah un azoi vi Achav, vos der melech fun Bavel hot zei farbrent in faier! <verse eid="JER 29:22" /><verse number="23" style="v" sid="JER 29:23" />vail zei hobn geton shalkhaftigkeit in Yisroel, un mizane geven mit di vaiber fun zeyere chaverim, un falsh geredt in main nomen verter vos ich hob zei nisht bafoiln; ober ich veis, un bin eides, zogt Hashem.<verse eid="JER 29:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24" />un oif Shemayahuen fun Nechelam zolstu zogn, azoi tsu zogn: <verse eid="JER 29:24" /><verse number="25" style="v" sid="JER 29:25" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel, azoi tsu zogn: vail du host geshikt in dain nomen briv tsum gantsn folk vos in Yerushalayim, un tsu Tsefanyah dem zun fun Maaseiyahn, dem koyen, un tsu ale koyanim, azoi tsu zogn: <verse eid="JER 29:25" /><verse number="26" style="v" sid="JER 29:26" />Hashem hot dich gemacht far a koyen oifn ort fun Yehoyada dem koyen, kedei es zoln zain oifzeer in hoiz fun Hashem iber itlechn meshugener un nevies-zoger, un du zolst im arainton in dem tsvangklots un in dem haldzring. <verse eid="JER 29:26" /><verse number="27" style="v" sid="JER 29:27" />un atsund, lemai hostu nisht ongeshrien oif Yirmeyahun fun Anatot, vos macht zich far a novi tsu aich? <verse eid="JER 29:27" /><verse number="28" style="v" sid="JER 29:28" />vorem er hot doch geshikt tsu undz kein Bavel: azoi tsu zogn: dos goles iz oif lang; boit haizer un bavoint, un flantst gertner un est zeyer frucht.<verse eid="JER 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29" />un Tsefanyah der koyen hot geleyent dem dozikn briv in di oiern fun Yirmeyah hanovi. <verse eid="JER 29:29" /><verse number="30" style="v" sid="JER 29:30" />un dos vort fun Hashem iz geven tsu Yirmeyahun, azoi tsu zogn: <verse eid="JER 29:30" /><verse number="31" style="v" sid="JER 29:31" />shik tsu ale fartribene, azoi tsu zogn: azoi hot Hashem gezogt oif Shemayahn fun Nechelam: vail Shemayah hot aich nevies gezogt, ven ich hob im nisht geshikt, un er hot aich gemacht farzichern oif lign, <verse eid="JER 29:31" /><verse number="32" style="v" sid="JER 29:32" />derum hot Hashem azoi gezogt: ze, ich rechn zich mit Shemayahn fun Nechelam, un mit zain zomen; fun im vet nisht blaibn a man tsu zitsn tsvishn dem dozikn folk, un er vet nisht zen dos guts vos ich tu main folk, zogt Hashem, vail opkerung hot er geredt kegen Hashem.<verse eid="JER 29:32" /></para>
  <chapter eid="JER 29" />
  <chapter number="30" style="c" pubnumber="ל" sid="JER 30" />
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem, azoi tsu zogn: <verse eid="JER 30:1" /><verse number="2" style="v" sid="JER 30:2" />azoi hot gezogt Hashem Elokei Yisroel, azoi tsu zogn: shraib dir ale verter vos ich hob geredt tsu dir, oif a buch. <verse eid="JER 30:2" /><verse number="3" style="v" sid="JER 30:3" />vorem ze, teg kumen, zogt Hashem, un ich vel umkeren di gefangenshaft fun main folk Yisroel un Yehudah, zogt Hashem, un vel zei viderkern tsu dem land, vos ich hob gegebn zeyere eltern, un zei veln es arben.<verse eid="JER 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4" />un dos zainen di verter vos Hashem hot geredt oif Yisroel un oif Yehudah:<verse eid="JER 30:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JER 30:5" />far vor, azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 30:5">a kol fun tsiterenish hobn mir gehert;</para>
  <para style="q" vid="JER 30:5">angst un nisht frid.<verse eid="JER 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 30:6" />fregt akorsht un zet,</para>
  <para style="q" vid="JER 30:6">oib a mansparshoin ken gevinen;</para>
  <para style="q" vid="JER 30:6">far vos ze ich yetveder man</para>
  <para style="q" vid="JER 30:6">mit zaine hent oif zaine lendn,</para>
  <para style="q" vid="JER 30:6">azoi vi a gevinerin,</para>
  <para style="q" vid="JER 30:6">un itlech ponem iz blas vern?<verse eid="JER 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 30:7" />oi vei, vorem grois iz yener tog,</para>
  <para style="q" vid="JER 30:7">on a glaichn tsu im;</para>
  <para style="q" vid="JER 30:7">un a tsait fun tsore iz dos far Yaakov,</para>
  <para style="q" vid="JER 30:7">ober fun ir vet er geholfn vern.<verse eid="JER 30:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="JER 30:8" />un es vet zain in yenem tog, zogt Hashem Tseva'ot, vel ich tsebrechn zain yoch fun dain haldz, un daine bindshtrik vel ich tseraisn; un mer veln nisht farknechtikn mit im fremde. <verse eid="JER 30:8" /><verse number="9" style="v" sid="JER 30:9" />naiert zei veln dinen Hashem zeyer G-t, un Dovid zeyer melech, vos ich vel zei oifshteln.<verse eid="JER 30:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 30:10" />un du zolst nisht moire hobn, main knecht, Yaakov,</para>
  <para style="qr" vid="JER 30:10">zogt Hashem,</para>
  <para style="q" vid="JER 30:10">un nisht angstn, Yisroel,</para>
  <para style="q" vid="JER 30:10">vorem ze, ich helf dich fun der vait,</para>
  <para style="q" vid="JER 30:10">un dain zomen fun land fun zeyer gefangenshaft;</para>
  <para style="q" vid="JER 30:10">un Yaakov vet vider zain fridlech un zicher,</para>
  <para style="q" vid="JER 30:10">un keiner vet nisht dershrekn.<verse eid="JER 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 30:11" />vorem ich bin mit dir, zogt Hashem, dich tsu helfn;</para>
  <para style="q" vid="JER 30:11">vorem ich vel machn a farlendung</para>
  <para style="q" vid="JER 30:11">fun ale felker vos ich hob dich ahin tseshpreit,</para>
  <para style="q" vid="JER 30:11">ober fun dir vel ich kein farlendung nisht machn,</para>
  <para style="q" vid="JER 30:11">un ich vel dich shtrofn loit gerechtikeit,</para>
  <para style="q" vid="JER 30:11">ober fartiliken vel ich dich nisht fartiliken.<verse eid="JER 30:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JER 30:12" />vorem azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 30:12">mesukn iz dain broch, shver iz dain vund.<verse eid="JER 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 30:13" />keiner halt nisht fun dain genezn vern,</para>
  <para style="q" vid="JER 30:13">nishto kein heilmitl far dain vund, nishto kein heilmitl far dir.<verse eid="JER 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 30:14" />ale daine libhober hobn fargesen on dir,</para>
  <para style="q" vid="JER 30:14">zei fregn nisht oif dir;</para>
  <para style="q" vid="JER 30:14">vorem a shlak fun a faint hob ich dich geshlogn,</para>
  <para style="q" vid="JER 30:14">a shtrof umderbaremdik,</para>
  <para style="q" vid="JER 30:14">far dain grois shuld, vail daine zind zainen fil.<verse eid="JER 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 30:15" />vos shraistu oif dain broch, vos umheilbar iz dain veitik?</para>
  <para style="q" vid="JER 30:15">far dain grois farbrech, vail daine zind zainen fil,</para>
  <para style="q" vid="JER 30:15">hob ich dos geton tsu dir.<verse eid="JER 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 30:16" />ober ale daine fartserer veln fartsert vern,</para>
  <para style="q" vid="JER 30:16">un ale daine faint veln ale in gefangenshaft gein,</para>
  <para style="q" vid="JER 30:16">un daine roiber veln tsu roib vern,</para>
  <para style="q" vid="JER 30:16">un ale daine oisroiber vel ich gebn tsu oisroibung.<verse eid="JER 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 30:17" />vorem ich vel brengen a refue tsu dir,</para>
  <para style="q" vid="JER 30:17">un fun daine vundn vel ich dich heiln,</para>
  <para style="qr" vid="JER 30:17">zogt Hashem;</para>
  <para style="q" vid="JER 30:17">vail men hot dich gerufn farshtoisene:</para>
  <para style="q" vid="JER 30:17">Tsiyon iz zi, keiner fregt nisht oif ir.<verse eid="JER 30:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 30:18" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 30:18">ze, ich ker um di gefangenshaft fun di getseltn fun Yaakov,</para>
  <para style="q" vid="JER 30:18">un zaine voinungen vel ich derbaremen;</para>
  <para style="q" vid="JER 30:18">un di shtot vet opgeboit vern oif ir hoifn,</para>
  <para style="q" vid="JER 30:18">un der palats vet oif zaine ordenung bavoint zain.<verse eid="JER 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 30:19" />un aroisgein vet fun zei a loib-gezang,</para>
  <para style="q" vid="JER 30:19">un a kol fun lustike;</para>
  <para style="q" vid="JER 30:19">un ich vel zei mern,</para>
  <para style="q" vid="JER 30:19">un zei veln nisht geminert vern,</para>
  <para style="q" vid="JER 30:19">un ich vel zei herlech machn,</para>
  <para style="q" vid="JER 30:19">un zei veln nisht als klein batracht vern.<verse eid="JER 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 30:20" />un zaine kinder veln zain vi frier,</para>
  <para style="q" vid="JER 30:20">un zain eide vet shtein fest far mir;</para>
  <para style="q" vid="JER 30:20">un ich vel zich rechenen mit ale zaine driker.<verse eid="JER 30:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 30:21" />un zain firsht vet zain fun im alein,</para>
  <para style="q" vid="JER 30:21">un zain geveltiker vet fun zain mit arois;</para>
  <para style="q" vid="JER 30:21">un ich vel im dernentern,</para>
  <para style="q" vid="JER 30:21">un er vet genen tsu mir;</para>
  <para style="q" vid="JER 30:21">vorem ver iz der vos ken ainshteln zain harts</para>
  <para style="q" vid="JER 30:21">tsu genenen tsu mir?</para>
  <para style="qr" vid="JER 30:21">zogt Hashem.<verse eid="JER 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 30:22" />un ir vet mir zain tsum folk,</para>
  <para style="q" vid="JER 30:22">un ich vel zain aier Elokim.<verse eid="JER 30:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JER 30:23" />ze, a shturem fun Hashem,</para>
  <para style="q" vid="JER 30:23">a grimtsorn iz arois,</para>
  <para style="q" vid="JER 30:23">a roishndiker shturemvint;</para>
  <para style="q" vid="JER 30:23">oif dem kop fun di reshoim vet er faln.<verse eid="JER 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 30:24" />nisht opgein vet der tsorn fun Hashem,</para>
  <para style="q" vid="JER 30:24">biz er tut, un biz er iz mekayem,</para>
  <para style="q" vid="JER 30:24">di trachtungen fun zain hartsn;</para>
  <para style="q" vid="JER 30:24">in sof fun di teg vet ir dos farshtein.<verse eid="JER 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" pubnumber="31.1" sid="JER 30:25" />in yener tsait,</para>
  <para style="qr" vid="JER 30:25">zogt Hashem,</para>
  <para style="q" vid="JER 30:25">vel ich zain tsum Elokim bai ale mishpoches fun Yisroel,</para>
  <para style="q" vid="JER 30:25">un zei veln zain main folk.<verse eid="JER 30:25" /></para>
  <chapter eid="JER 30" />
  <chapter number="31" style="c" pubnumber="לא" sid="JER 31" />
  <para style="q">
    <verse number="1" style="v" pubnumber="31.2" sid="JER 31:1" />azoi zogt Hashem:</para>
  <para style="q" vid="JER 31:1">gefunen hot chein un chesed in midber</para>
  <para style="q" vid="JER 31:1">dos folk fun shverd geblibn;</para>
  <para style="q" vid="JER 31:1">gei im baruyen, Yisroel.<verse eid="JER 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="31.3" sid="JER 31:2" />fun vaitn hot Hashem zich bavizn tsu mir:</para>
  <para style="q" vid="JER 31:2">yo, eibike libshaft hob ich dich lib,</para>
  <para style="q" vid="JER 31:2">derum tsi ich dich tsu mit genod.<verse eid="JER 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="31.4" sid="JER 31:3" />ich vel dich noch oifboien,</para>
  <para style="q" vid="JER 31:3">un vest oifgeboit vern, yungfroi Yisroel;</para>
  <para style="q" vid="JER 31:3">vest noch onton daine paiklech,</para>
  <para style="q" vid="JER 31:3">un aroisgein in lustikn tants.<verse eid="JER 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" pubnumber="31.5" sid="JER 31:4" />vest noch flantsn vaingertner oif di berg fun Shomron;</para>
  <para style="q" vid="JER 31:4">flantsn veln flantser un farnitsn alein.<verse eid="JER 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="31.6" sid="JER 31:5" />vorem zain vet a tog,</para>
  <para style="q" vid="JER 31:5">ven di vechter rufn oifn geberg fun Efrayim:</para>
  <para style="q" vid="JER 31:5">shteit oif, un lomir aroifgein kein Tsiyon,</para>
  <para style="q" vid="JER 31:5">tsu Hashem Elokeinu.<verse eid="JER 31:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" pubnumber="31.7" sid="JER 31:6" />vorem azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 31:6">zingt mit freid vegen Yaakov,</para>
  <para style="q" vid="JER 31:6">un shalt vegen dem kop fun di felker;</para>
  <para style="q" vid="JER 31:6">macht hern, loibt, un zogt:</para>
  <para style="q" vid="JER 31:6">helf, Hashem, dain folk,</para>
  <para style="q" vid="JER 31:6">dem iberblaib fun Yisroel.<verse eid="JER 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" pubnumber="31.8" sid="JER 31:7" />ze, ich breng zei fun tsofn-land,</para>
  <para style="q" vid="JER 31:7">un vel zei ainzamlen fun di ekn erd;</para>
  <para style="q" vid="JER 31:7">tsvishn zei dem blindn un dem hinkedikn,</para>
  <para style="q" vid="JER 31:7">di trogedike un di gevinerin in einem;</para>
  <para style="q" vid="JER 31:7">a grois gezeml veln zei zich umkeren aher.<verse eid="JER 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="31.9" sid="JER 31:8" />mit gevein veln zei kumen,</para>
  <para style="q" vid="JER 31:8">un mit chein vel ich zei brengen;</para>
  <para style="q" vid="JER 31:8">ich vel zei firn bai taichn vaser,</para>
  <para style="q" vid="JER 31:8">oif a veg a glaichn</para>
  <para style="q" vid="JER 31:8">vos zei veln derin nisht geshtroichlt vern;</para>
  <para style="q" vid="JER 31:8">vorem ich bin a foter tsu Yisroel,</para>
  <para style="q" vid="JER 31:8">un Efrayim, er iz main bechor.<verse eid="JER 31:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" pubnumber="31.10" sid="JER 31:9" />hert dos vort fun Hashem, ir felker,</para>
  <para style="q" vid="JER 31:9">un dertseilt in di indzelen fun der vait, un zogt:</para>
  <para style="q" vid="JER 31:9">der vos hot tseshpreit Yisroel, tut im ainzamlen,</para>
  <para style="q" vid="JER 31:9">un hit im vi a pastuch zain stade.<verse eid="JER 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="31.11" sid="JER 31:10" />vorem Hashem hot oisgekoift Yaakov,</para>
  <para style="q" vid="JER 31:10">un im oisgeleizt fun der hant fun dem shtarkern fun im.<verse eid="JER 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" pubnumber="31.12" sid="JER 31:11" /> un zei veln kumen un zingen oif der heich fun Tsiyon,</para>
  <para style="q" vid="JER 31:11">un zei veln shtromen tsu Hashems guts,</para>
  <para style="q" vid="JER 31:11">tsu tvue, un tsu vain, un tsu eil,</para>
  <para style="q" vid="JER 31:11">un tsu yunge shof un rinder;</para>
  <para style="q" vid="JER 31:11">un zeyer zel vet zain vi a bavaserter gortn,</para>
  <para style="q" vid="JER 31:11">un zei veln mer vider nisht shmachtn.<verse eid="JER 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" pubnumber="31.13" sid="JER 31:12" />dentsmol vet di yungfroi zich freyen in tants,</para>
  <para style="q" vid="JER 31:12">un bechorim un zkeinim in einem;</para>
  <para style="q" vid="JER 31:12">un ich vel farkern zeyer troier in freid,</para>
  <para style="q" vid="JER 31:12">un vel zei treistn un zei derfreyen in zeyer kumer.<verse eid="JER 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="31.14" sid="JER 31:13" />un ich vel zetn di zel fun di koyanim mit fetkeit,</para>
  <para style="q" vid="JER 31:13">un main folk vet zain zat mit main guts,</para>
  <para style="qr" vid="JER 31:13">zogt Hashem.<verse eid="JER 31:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" pubnumber="31.15" sid="JER 31:14" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 31:14">a kol vert in Ramah gehert,</para>
  <para style="q" vid="JER 31:14">a yomer, a biter gevein;</para>
  <para style="q" vid="JER 31:14">Rachel veint oif ire kinder,</para>
  <para style="q" vid="JER 31:14">zi vil zich nisht treistn noch ire kinder,</para>
  <para style="q" vid="JER 31:14">vos zei zainen mer nishto.<verse eid="JER 31:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" pubnumber="31.16" sid="JER 31:15" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 31:15">farmaid dain kol fun gevein,</para>
  <para style="q" vid="JER 31:15">un daine oign fun trern,</para>
  <para style="q" vid="JER 31:15">vorem faran a loin far dain mi, zogt Hashem;</para>
  <para style="q" vid="JER 31:15">un zei veln zich umkeren fun land fun dem faint.<verse eid="JER 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" pubnumber="31.17" sid="JER 31:16" />un faran a hofung far dain letst,</para>
  <para style="qr" vid="JER 31:16">zogt Hashem,</para>
  <para style="q" vid="JER 31:16">un di kinder veln zich umkeren tsu zeyer gemark.<verse eid="JER 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" pubnumber="31.18" sid="JER 31:17" />hern hob ich gehert Efrayim zich klogn:</para>
  <para style="q" vid="JER 31:17">host mich geshtroft, un ich bin geshtroft gevorn,</para>
  <para style="q" vid="JER 31:17">vi a kalb nisht gelernt;</para>
  <para style="q" vid="JER 31:17">loz mich umkeren, un ich vel zich umkeren,</para>
  <para style="q" vid="JER 31:17">vorem du bist Hashem main G-t.<verse eid="JER 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" pubnumber="31.19" sid="JER 31:18" />vorem noch main opkerung hob ich charote gehat,</para>
  <para style="q" vid="JER 31:18">un noch main anerkenen,</para>
  <para style="q" vid="JER 31:18">hob ich zich geshlogn oifn dich;</para>
  <para style="q" vid="JER 31:18">ich shem zich un bin in biesh,</para>
  <para style="q" vid="JER 31:18">vail ich trog di shand fun main yugnt.<verse eid="JER 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" pubnumber="31.20" sid="JER 31:19" />iz mir a taier zun Efrayim,</para>
  <para style="q" vid="JER 31:19">tsi a gelibtn kind?</para>
  <para style="q" vid="JER 31:19">vorem vi nor ich red fun im;</para>
  <para style="q" vid="JER 31:19">benken denk ich vider noch im:</para>
  <para style="q" vid="JER 31:19">derum brumen maine ingeveid tsu im;</para>
  <para style="q" vid="JER 31:19">derbaremen vel ich im derbaremen,</para>
  <para style="qr" vid="JER 31:19">zogt Hashem.<verse eid="JER 31:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" pubnumber="31.21" sid="JER 31:20" />shtel dir tseichns,</para>
  <para style="q" vid="JER 31:20">mach dir vegshtangen,</para>
  <para style="q" vid="JER 31:20">gib acht oif dem shteg,</para>
  <para style="q" vid="JER 31:20">dem veg vos du bist gegangen;</para>
  <para style="q" vid="JER 31:20">ker zich um, yungfroi Yisroel,</para>
  <para style="q" vid="JER 31:20">ker zich um tsu di dozike shtet daine.<verse eid="JER 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" pubnumber="31.22" sid="JER 31:21" />biz vanen vestu zich opdreyen,</para>
  <para style="q" vid="JER 31:21">tochter vidershpenike?</para>
  <para style="q" vid="JER 31:21">far vor, Hashem hot bashafn a nais oif der erd:</para>
  <para style="q" vid="JER 31:21">di froi zol zich arumringlen a man.<verse eid="JER 31:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" pubnumber="31.23" sid="JER 31:22" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel:</para>
  <para style="q" vid="JER 31:22">me vet noch zogn dos dozike vort</para>
  <para style="q" vid="JER 31:22">in land fun Yehudah, un in zaine shtet,</para>
  <para style="q" vid="JER 31:22">ven ich ker um zeyer gefangenshaft:</para>
  <para style="q" vid="JER 31:22">G-t zol dich bentshn, voinung fun gerechtikeit,</para>
  <para style="q" vid="JER 31:22">heiliker barg!<verse eid="JER 31:22" /></para>
  <para style="b" />
  <para style="m">
    <verse number="23" style="v" pubnumber="31.24" sid="JER 31:23" />un Yehudah un ale zaine shtet veln drinen zitsn in einem: akers lait, un di vos tsien mit stades. <verse eid="JER 31:23" /><verse number="24" style="v" pubnumber="31.25" sid="JER 31:24" />vorem ich derkvik di mide zel, un itlech zel vos shmacht, tu ich onfiln.<verse eid="JER 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="31.26" sid="JER 31:25" />deroif hob ich zich oifgechapt un mich umgekukt; un main shlof iz mir zis geven.<verse eid="JER 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="31.27" sid="JER 31:26" />ze, teg kumen, zogt Hashem, un ich vel farzeyen dos hoiz fun Yisroel un dos hoiz fun Yehudah, mit zomen fun mentshn, un mit zomen fun beheimes. <verse eid="JER 31:26" /><verse number="27" style="v" pubnumber="31.28" sid="JER 31:27" />un es vet zain, azoi vi ich hob oifgepast oif zei, oistsuraisn un aintsuvarfn, un tsu tseshtern un untertsubrengen, un beiz tsu ton, azoi vel ich oifpasn oif zei, tsu boien un tsu flantsn, zogt Hashem. <verse eid="JER 31:27" /><verse number="28" style="v" pubnumber="31.29" sid="JER 31:28" />in yene teg vet men mer nisht zogn:</para>
  <para style="b" vid="JER 31:28" />
  <para style="q" vid="JER 31:28">di foters hobn gegesn zoiere vaintroiben,</para>
  <para style="q" vid="JER 31:28">un di tsein fun di zin zainen hailik.<verse eid="JER 31:28" /></para>
  <para style="b" />
  <para style="m">
    <verse number="29" style="v" pubnumber="31.30" sid="JER 31:29" />naiert itlecher far zain zind vet shtarbn; yetveder mentsh vos est di zoiere vaintroiben, zaine tsein veln hailik vern.<verse eid="JER 31:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="31.31" sid="JER 31:30" />ze, teg kume, zogt Hashem, un ich vel shlisn mit dem hoiz fun Yisroel, un mit dem hoiz fun Yehudah, a naiem bris; <verse eid="JER 31:30" /><verse number="31" style="v" pubnumber="31.32" sid="JER 31:31" />nisht vi der bris vos ich hob geshlosn mit zeyere eltern in dem tog vos ich hob ongenumen zeyer hant zei aroistsutsien fun land Mitsrayim; vorem zei hobn farshtert main bris, hagam ich bin geven zeyer man, zogt Hashem. <verse eid="JER 31:31" /><verse number="32" style="v" pubnumber="31.33" sid="JER 31:32" />naiert dos vet zain der bris vos ich vel shlisn mit dem hoiz fun Yisroel noch yene tog, zogt Hashem: ich gib arain main toyre in zei, un oif zeyer hartsn vel ich zi oifshraibn; un ich vel zei zain tsum Elokim, un zei veln mir zain tsum folk. <verse eid="JER 31:32" /><verse number="33" style="v" pubnumber="31.34" sid="JER 31:33" />un zei veln mer nisht lernen itlecher zain chever, un itlecher zain bruder, azoi tsu zogn: kent G-t! vorem zei ale veln mich kenen, fun zeyer klenstn biz zeyer grestn, zogt Hashem; vorem ich vel fargebn zeyer zind, un zeyer chet vel ich mer nisht dermonen.<verse eid="JER 31:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" pubnumber="31.35" sid="JER 31:34" />azoi hot Hashem gezogt,</para>
  <para style="q" vid="JER 31:34">der vos git di zun far a licht bai tog,</para>
  <para style="q" vid="JER 31:34">un di gezetsn fun levone un shtern</para>
  <para style="q" vid="JER 31:34">far a licht bai nacht;</para>
  <para style="q" vid="JER 31:34">der vos shpreit ois dos yam un zaine chvalies shturemen –</para>
  <para style="q" vid="JER 31:34">Hashem Tseva'ot iz zain nomen:<verse eid="JER 31:34" /></para>
  <para style="q">
    <verse number="35" style="v" pubnumber="31.36" sid="JER 31:35" />oib di dozike gezetsn veln opgeton vern fun far mir,</para>
  <para style="qr" vid="JER 31:35">zogt Hashem,</para>
  <para style="q" vid="JER 31:35">vet oich der zomen fun Yisroel oifhern</para>
  <para style="q" vid="JER 31:35">tsu zain a folk far mir ale teg.<verse eid="JER 31:35" /></para>
  <para style="b" />
  <para style="q">
    <verse number="36" style="v" pubnumber="31.37" sid="JER 31:36" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 31:36">oib di himlen fun oiben veln oisgemostn vern,</para>
  <para style="q" vid="JER 31:36">un di gruntfestn fun der erd unten veln derforsht vern,</para>
  <para style="q" vid="JER 31:36">vel ich oich farachten al dem zomen fun Yisroel,</para>
  <para style="q" vid="JER 31:36">far alts vos zei hobn geton,</para>
  <para style="qr" vid="JER 31:36">zogt Hashem.<verse eid="JER 31:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" pubnumber="31.38" sid="JER 31:37" />ze, teg kumen, zogt Hashem, un di shtot vet oifgeboit vern tsu G-t, fun dem turem fun Chananel bizn vinkltoier. <verse eid="JER 31:37" /><verse number="38" style="v" pubnumber="31.39" sid="JER 31:38" />un di mestshnur vet aroisgein vaiter, glaich akegn, bizn bergel Garev, un vet zich fardreyen kein Goah. <verse eid="JER 31:38" /><verse number="39" style="v" pubnumber="31.40" sid="JER 31:39" />un der gantser tal fun pegorim un ash, un ale felder biz taich Kidron, bizn vinkel fun ferdtoier in mizrech, veln zain heilik tsu Hashem; es vet mer nisht oisgerisn vern, un nisht tseshtert vern, oif eibik.<verse eid="JER 31:39" /></para>
  <chapter eid="JER 31" />
  <chapter number="32" style="c" pubnumber="לב" sid="JER 32" />
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem, in tsentn yor fun Tsidkiyah dem melech fun Yehudah, dos iz dos achtsente yor fun Nevuchadretsar. <verse eid="JER 32:1" /><verse number="2" style="v" sid="JER 32:2" />un der cheil fun dem melech fun Bavel hot dentsmol gelegert oif Yerushalayim, un Yirmeyah hanovi iz geven aingeshpart in hoif fun der vach, vos in hoiz fun dem melech fun Yehudah. <verse eid="JER 32:2" /><verse number="3" style="v" sid="JER 32:3" />vorem Tsidkiyah der melech fun Yehudah hot im aingeshpart, azoi tsu zogn: lemai zogstu nevies, azoi tsu zogn: azoi hot Hashem gezogt: ze, ich gib di dozike shtot in der hant fun dem melech fun Bavel, un er vet zi batsvingen; <verse eid="JER 32:3" /><verse number="4" style="v" sid="JER 32:4" />un Tsidkiyah der melech fun Yehudah vet nisht antrunen vern fun der hant fun di Kasdim, naiert ibergegebn vet er ibergegebn vern in der hant fun dem melech fun Bavel, un er vet redn tsu im moil tsu moil, un oig in oig vet er im zen; <verse eid="JER 32:4" /><verse number="5" style="v" sid="JER 32:5" />un kein Bavel vet er avekfiren Tsidkiyahun, un dortn vet er zain biz ich dermon zich on im, zogt Hashem; az ir vet milchome haltn mit di Kasdim, vet ir nisht baglikn?<verse eid="JER 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6" />un Yirmeyah hot gezogt: dos vort fun Hashem iz geven tsu mir azoi tsu zogn: <verse eid="JER 32:6" /><verse number="7" style="v" sid="JER 32:7" />ze, Chanamel der zun fun Shallum dain feter kumt tsu dir, azoi tsu zogn: koif dir main feld vos in Anatot, vorem dir gehert dos oisleizrecht optsukoifn. <verse eid="JER 32:7" /><verse number="8" style="v" sid="JER 32:8" />un Chanamel main feters zun iz gekumen tsu mir in hoif fun der vach, azoi vi dos vort fun Hashem, un der hot tsu mir gezogt: koif op, ich bet dich, main feld vos in Anatot, vos in land Binyamin, vorem dir gehert dos recht fun yerushe, un dir gehert di oisleizung; koif es dir op. un azoi hob ich gevust az dos iz dos vort fun Hashem.<verse eid="JER 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 32:9" />un ich hob opgekoift dos feld fun Chanamel, main feters zun, vos in Anatot, un ich hob im opgevoign dos gelt, zibn shekl un tsen, zilber. <verse eid="JER 32:9" /><verse number="10" style="v" sid="JER 32:10" />un ich hob oifgeshribn oif a geshrifts, un farchasmet, un geshtelt eides, un opgevoign dos gelt oif a vogshol. <verse eid="JER 32:10" /><verse number="11" style="v" sid="JER 32:11" />un ich hob genumen dem shtar-mechire, dem farchasmetn mit di badingen un di opmachn, un dem ofenem. <verse eid="JER 32:11" /><verse number="12" style="v" sid="JER 32:12" />un ich hob gegebn dem shtar-mechire tsu Baruch dem zun fun Neriyah dem zun fun Machseiyahn, far di oign fun Chanamel dem zun fun main feter, un far di oign fun di eides vos hobn zich untergeshribn oif shtar-mechire, far di oign fun ale Yidn vos zainen gezesn in hoif fun der vach. <verse eid="JER 32:12" /><verse number="13" style="v" sid="JER 32:13" />un ich hob bafoiln Baruchn far zeyere oign, azoi tsu zogn: <verse eid="JER 32:13" /><verse number="14" style="v" sid="JER 32:14" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: nem di dozike geshriftsn, dem dozikn shtar-mechire, i dos farchtmete, i dos dozike ofene geshrifts, un zolst zei arainton in a leimener keile, kedei zei zoln haltn fil teg. <verse eid="JER 32:14" /><verse number="15" style="v" sid="JER 32:15" />vorem azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: es veln noch gekoift vern haizer un felder un vaingertner in dem dozikn land.<verse eid="JER 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16" />un ich hob mispalel geven tsu Hashem nochdem vi ich hob ibergegebn dem shtar-mechire tsu Baruch dem zun fun Neriyahn, azoi tsu zogn: <verse eid="JER 32:16" /><verse number="17" style="v" sid="JER 32:17" />oi vei, Hashem du Adonoi! ze, du host gemacht di himlen un di erd mit dain grois shtarkeit, un mit dain oisgeshtrektn orem; fun dir iz nisht farmitn kein zach tsu vunderbar. <verse eid="JER 32:17" /><verse number="18" style="v" sid="JER 32:18" />tust chesed mitn toizntstn glid, un batsolst di zind fun di eltern in dem buzem fun zeyere kinder noch zei; du groiser, machtiker El, vos Hashem Tseva'ot iz zain nomen, <verse eid="JER 32:18" /><verse number="19" style="v" sid="JER 32:19" />grois in barot, un shtark in tuung, vos daine oign zenen ofen oif ale vegen fun di mentshnkinder, tsu gebn itlechn loit zaine vegen un loit der frucht fun zaine meisim; <verse eid="JER 32:19" /><verse number="20" style="v" sid="JER 32:20" />du vos host geton tseichns un vunder in land Mitsrayim, un biz oif haintikn tog, i tsvishn Yisroel, i tsvishn andere mentshn, un host zich gemacht a nomen, azoi vi haintikn tog; <verse eid="JER 32:20" /><verse number="21" style="v" sid="JER 32:21" />un host aroisgetsoign dain folk Yisroel fun land Mitsrayim mit tseichns un mit vunder, un mit a shtarker hant, un mit an oisgeshtrektn orem, un mit grois forchtikeit; <verse eid="JER 32:21" /><verse number="22" style="v" sid="JER 32:22" />un host zei gegebn dos dozike land, vos du host geshvorn zeyere eltern zei tsu gebn, a land vos flist mit milch un honik; <verse eid="JER 32:22" /><verse number="23" style="v" sid="JER 32:23" />un zei zainen gekumen, un hobn es gearbt; ober zei hobn nisht tsugehert tsu dain kol, un in dain toyre zainen zei nisht gegangen; alts vos du host zei bafoiln tsu ton hobn zei nisht geton, un du host gemacht geshen tsu zei al dos dozike beiz. <verse eid="JER 32:23" /><verse number="24" style="v" sid="JER 32:24" />ze, di balegerung־verk zainen gekumen in der shtot, zi tsu batsvingen, un di shtot vert ibergegebn in der hant fun di Kasdim vos haltn milchome oif ir, fun vegen der shverd un dem hunger un der pest; un vos du host geredt iz geshen, un ot zestu es. <verse eid="JER 32:24" /><verse number="25" style="v" sid="JER 32:25" />fun destvegn hostu, Hashem du Adonoi, gezogt tsu mir: koif dir dos feld far gelt, un shtel eides; ven di shtot vert ibergegebn in der hant fun di Kasdim.<verse eid="JER 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26" />un dos vort fun Hashem iz geven tsu Yirmeyahun, azoi tsu zogn: <verse eid="JER 32:26" /><verse number="27" style="v" sid="JER 32:27" />ze, ich bin Hashem der G-t fun ale laiber; iz den farmitn fun mir a shum zach? <verse eid="JER 32:27" /><verse number="28" style="v" sid="JER 32:28" />derum hot Hashem azoi gezogt: ze, ich gib di dozike shtot in der hant fun di Kasdim, un in der hant fun Nevuchadretsar dem melech fun Bavel, un er vet zi batsvingen. <verse eid="JER 32:28" /><verse number="29" style="v" sid="JER 32:29" />un di Kasdim vos haltn milchome oif der doziker shtot, veln kumen un veln ontsindn di dozike shtot in faier, un veln zi farbrenen mit di haizer vos me hot gereichert oif zeyere decher tsu Baal, un gegosn gisopfer tsu fremde g‑ter, kedei mich tsu dertserenen. <verse eid="JER 32:29" /><verse number="30" style="v" sid="JER 32:30" />vorem di kinder fun Yisroel un di kinder fun Yehudah flegn fun zeyer yugnt on rak ton vos iz shlecht in maine oign; vorem di kinder fun Yisroel tuen mich rak dertserenen mit dem verk fun zeyere hent, zogt Hashem. <verse eid="JER 32:30" /><verse number="31" style="v" sid="JER 32:31" />vorem tsu main fardros un tsu main grimtsorn iz mir geven di dozike shtot fun dem tog vos men hot zi geboit. un biz oif haintikn tog, azoi az ich muz zi opton fun main ponem, <verse eid="JER 32:31" /><verse number="32" style="v" sid="JER 32:32" />iber al dem beiz fun di kinder fun Yisroel un di kinder fun Yehudah, vos zei hobn geton mich tsu dertserenen, zei, zeyere mlochim, zeyere harn, zeyere koyanim, un zeyere neviim, un di mener fun Yehudah un di bavoiner fun Yerushalayim. <verse eid="JER 32:32" /><verse number="33" style="v" sid="JER 32:33" />un zei hobn gekert tsu mir dem rukn un nisht dem ponem, un ich hob zei gelernt, nochanand un nochanand gelernt, ober zei hobn nisht tsugehert tsu nemen a musar. <verse eid="JER 32:33" /><verse number="34" style="v" sid="JER 32:34" />un zei hobn araingeton zeyere umverdikeitn in dem hoiz vos main nomen vert gerufn oif im, es tsu farumreinikn. <verse eid="JER 32:34" /><verse number="35" style="v" sid="JER 32:35" />un zei hobn geboit di bamot fun Baal vos in tal fun Ben-Hinom, oif makrev tsu zain zeyere zin un zeyere techter tsum Molech, vos nisht ich hob zei bafoiln, un nisht mir iz oifn zinen aroifgekumen, me zol ton di dozike umverdikeit, kedei tsu machn zindikn Yehudah.<verse eid="JER 32:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36" />ober atsund, far vor, hot azoi gezogt Hashem Elokei Yisroel oif der doziker shtot, vos ir zogt, zi iz ibergegebn in der hant fun dem melech fun Bavel durch der shverd, un durch dem hunger, un durch der pest: <verse eid="JER 32:36" /><verse number="37" style="v" sid="JER 32:37" />ze, ich zaml zei fun ale lender, vos ich hob zei farshtoisen ahin in main kaas, un in main geirem, un in grois tsorn, un ich vel zei umkeren tsu dem dozikn ort, un zei machn voinen in zicherkeit. <verse eid="JER 32:37" /><verse number="38" style="v" sid="JER 32:38" />un zei veln mir zain tsum folk, un ich vel zei zain tsum Elokim. <verse eid="JER 32:38" /><verse number="39" style="v" sid="JER 32:39" />un ich vel zei gebn ein harts, un ein veg moire tsu hobn far mir ale teg, kedei zei zol gut zain, un zeyere kinder noch zei. <verse eid="JER 32:39" /><verse number="40" style="v" sid="JER 32:40" />un ich vel zei shlisn an eibikn bris, az ich vel zich nisht opkeren fun hinter zei – kedei ich zol zei bagitikn; un main forcht vel ich araingebn in zeyer hartsn, nisht avektsugein fun mir. <verse eid="JER 32:40" /><verse number="41" style="v" sid="JER 32:41" />un ich vel mich freyen iber zei, zei tsu bagitikn, un vel zei ainflantsn in dem dozikn land mit an emes, mit main gantsn hartsn, un mit main gantser zel.<verse eid="JER 32:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42" />vorem azoi hot Hashem gezogt: azoi vi ich hob gebracht oif dem dozikn folk dos dozike groise beiz, azoi breng ich oif zei dos gantse guts vos ich hob iber zei geredt. <verse eid="JER 32:42" /><verse number="43" style="v" sid="JER 32:43" />un feld vet gekoift vern in dem dozikn land, vos ir zogt, es iz a vistenish, on a mentsh oder a beheime, es iz ibergegebn in der hant fun di Kasdim. <verse eid="JER 32:43" /><verse number="44" style="v" sid="JER 32:44" />me vet koifn felder far gelt, un me vet shraibn shtar-mechiras, un farchtmen, un shteln eides, in land Binyamin, un arum Yerushalayim, un in di shtet fun Yehudah, un in di shtet fun dem geberg, un in di shtet fun der niderung, un in di shtet fun dorem; vorem ich vel umkeren zeyer gefangenshaft, zogt Hashem.<verse eid="JER 32:44" /></para>
  <chapter eid="JER 32" />
  <chapter number="33" style="c" pubnumber="לג" sid="JER 33" />
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1" />un dos vort fun Hashem iz geven tsu Yirmeyahun a tsveit mol, ven er iz noch geven aingeshpart in hoif fun der vach, azoi tsu zogn: <verse eid="JER 33:1" /><verse number="2" style="v" sid="JER 33:2" />azoi hot gezogt Hashem vos hot es gemacht, Hashem vos hot dos gefuremt es ontsubraitn, der vos zain nomen iz Hashem: <verse eid="JER 33:2" /><verse number="3" style="v" sid="JER 33:3" />ruf mich, un ich vel dir entfern, un ich vel dir dertseiln groise zachn, un farborgene vos du veist nisht. <verse eid="JER 33:3" /><verse number="4" style="v" sid="JER 33:4" />vorem azoi hot gezogt Hashem Elokei Yisroel oif di haizer fun der doziker shtot, un oif di haizer fun di mlochim fun Yehudah, vos zainen aingevorfn gevorn far di erdvaln un far der shtreitmoier, <verse eid="JER 33:4" /><verse number="5" style="v" sid="JER 33:5" />vos zei kumen milchome haltn deroif mit di Kasdim, un zei ontsufiln mit di pegorim fun di mentshn vos ich hob geshlogn in main kaas un in main grimtsorn, un vos iber al zeyer beiz hob ich farborgen main ponem fun der doziker shtot: <verse eid="JER 33:5" /><verse number="6" style="v" sid="JER 33:6" />ze, ich breng oif ir a genezung un a heilung, un vel zi heiln; un ich vel zei antplekn a shefe fun sholem un zicherkeit. <verse eid="JER 33:6" /><verse number="7" style="v" sid="JER 33:7" />un ich vel umkeren di gefangenshaft fun Yehudah, un di gefangenshaft fun Yisroel, un vel zei oifboien azoi vi frier. <verse eid="JER 33:7" /><verse number="8" style="v" sid="JER 33:8" />un ich vel zei reiniken fun al zeyer chet vos zei hobn gezindikt tsu mir, un vel fargebn ale zeyere chatoim vos zei hobn gezindikt tsu mir, un vos zei hobn farbrochn akegn mir. <verse eid="JER 33:8" /><verse number="9" style="v" sid="JER 33:9" />un es vet mir zain far a nomen fun freid, far a loib, un far a sheinkeit, bai ale felker fun der erd, vos veln hern al dos guts vos ich tu mit zei, un veln angstn un tsiteren fun vegen al dem guts un fun vegen al dem glik vos ich basher ir.<verse eid="JER 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10" />azoi hot Hashem gezogt: es vet noch gehert vern in dem dozikn ort, vos ir zogt, er iz vist, on a mentshn un on a beheime, in di shtet fun Yehudah, un in di gasn fun Yerushalayim, vos zainen farvist, on a mentshn, un on a bavoiner, un on a beheime, <verse eid="JER 33:10" /><verse number="11" style="v" sid="JER 33:11" />der kol fun lustikeit un der kol fun freid, der kol fun a chosen un der kol fun a kale, der kol fun di vos zogn:</para>
  <para style="b" vid="JER 33:11" />
  <para style="q" vid="JER 33:11">loibt Hashem Tseva'ot,</para>
  <para style="q" vid="JER 33:11">vorem Hashem iz gut,</para>
  <para style="q" vid="JER 33:11">vorem eibik iz zain chesed!</para>
  <para style="b" vid="JER 33:11" />
  <para style="m" vid="JER 33:11">fun di vos brengen dankopfer in hoiz fun Hashem; vorem ich vel umkeren di gefangenshaft fun dem land azoi vi frier, zogt Hashem.<verse eid="JER 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12" />azoi hot gezogt Hashem Tseva'ot: es vet noch zain in dem dozikn ort vos iz vist, on a mentshn oder a beheime, un in ale zaine shtet, a fiterplats far pastucher vos machn hoiern shof. <verse eid="JER 33:12" /><verse number="13" style="v" sid="JER 33:13" />in di shtet fun dem geberg, in di shtet fun der niderung, un in di shtet fun dorem, un in land Binyamin, un arum Yerushalayim, un in di shtet fun Yehudah, veln vider durchgein shof durch dem tseilers hent, zogt Hashem.<verse eid="JER 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14" />ze, teg kumen, zogt Hashem, un ich vel mekayem zain dem gutn tsuzog vos ich hob tsugezogt oif dem hoiz fun Yisroel, un oif dem hoiz fun Yehudah. <verse eid="JER 33:14" /><verse number="15" style="v" sid="JER 33:15" />in yene teg, un in yene tsait, vel ich machn shprotsn fun Dovidn a tsemach fun gerechtikeit, un er vet ton recht un gerechtikeit in land. <verse eid="JER 33:15" /><verse number="16" style="v" sid="JER 33:16" />in yene teg vet geholfn vern Yehudah, un Yerushalayim vet ruen in zicherkeit; un dos iz vos me vet zi rufn: Hashem iz undzer gerechtikeit!<verse eid="JER 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 33:17" />vorem azoi hot Hashem gezogt: es vet nisht farshnitn vern fun Dovidn a man tsu zitsn oif tron fun dem hoiz fun Yisroel; <verse eid="JER 33:17" /><verse number="18" style="v" sid="JER 33:18" />un oich fun di koyanim fun sheyvet Levi vet nisht farshnitn vern a man fun far mir, oiftsubrengen brandopfer, un tsu demfn shpaizopfer, un tsu machn shlachtopfer, ale teg.<verse eid="JER 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 33:19" />un dos vort fun Hashem iz geven tsu Yirmeyahun, azoi tsu zogn: <verse eid="JER 33:19" /><verse number="20" style="v" sid="JER 33:20" />azoi hot Hashem gezogt: oib ir kent farshtern main bris mitn tog, un main bris mit der nacht, az tog un nacht zoln nisht zain in zeyer tsait, <verse eid="JER 33:20" /><verse number="21" style="v" sid="JER 33:21" />vet oich main bris farshtert vern mit Dovid main knecht, az fun im zol nisht zain a zun tsu kinign oif zain tron, un mit di koyanim fun sheyvet Levi maine diner. <verse eid="JER 33:21" /><verse number="22" style="v" sid="JER 33:22" />azoi vi der cheil fun himel ken nisht getseilt vern, un der zamd fun yam ken nisht gemestn vern, azoi vel ich mern dem zomen fun main knecht Dovid, un di Leviim vos dinen mir.<verse eid="JER 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23" />un dos vort fun Hashem iz geven tsu Yirmeyahun, azoi tsu zogn: <verse eid="JER 33:23" /><verse number="24" style="v" sid="JER 33:24" />hostu nisht gemerkt vos di dozike lait redn, azoi tsu zogn: di tsvei mishpoches vos Hashem hot zei gevest oisderveilt, zei hot er faracht? un main folk lestern zei, az es iz mer nisht kein ume bai zei. <verse eid="JER 33:24" /><verse number="25" style="v" sid="JER 33:25" />azoi hot Hashem gezogt: oib ich hob nisht main bris mit tog un nacht, di gezetsn fun erd un himel, nisht gemacht, <verse eid="JER 33:25" /><verse number="26" style="v" sid="JER 33:26" />vel ich oich farachten dem zomen fun Yaakov, un Dovid main knecht, nisht tsu nemen fun zain zomen hersher iber dem zomen fun Avraham, Yitschak, un Yaakov; vorem ich vel umkeren zeyer gefangenshaft, un vel zei derbaremen.<verse eid="JER 33:26" /></para>
  <chapter eid="JER 33" />
  <chapter number="34" style="c" pubnumber="לד" sid="JER 34" />
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem, beeis Nevuchadretsar der melech fun Bavel, un zain gantser cheil, un ale kinigraichn fun der erd unter der memshole fun zain hant, un ale felker, hobn milchome gehaltn oif Yerushalayim un oif ale ire shtet; azoi tsu zogn: <verse eid="JER 34:1" /><verse number="2" style="v" sid="JER 34:2" />azoi hot gezogt Hashem Elokei Yisroel: gei, un zolst redn tsu Tsidkiyah dem melech fun Yehudah, un zogn tsu im: azoi hot Hashem gezogt: ze, ich gib di dozike shtot in der hant fun dem melech fun Bavel, un er vet zi farbrenen in faier. <verse eid="JER 34:2" /><verse number="3" style="v" sid="JER 34:3" />un du vest nisht antrunen vern fun zain hant, nor chapn vestu gechapt vern, un in zain hant vestu ibergegebn vern, un oig in oig vestu zen dem melech fun Bavel, un moil tsu moil vet er mit dir redn, un kein Bavel vestu kumen. <verse eid="JER 34:3" /><verse number="4" style="v" sid="JER 34:4" />ober her dos vort fun Hashem, Tsidkiyah melech fun Yehudah: azoi hot Hashem gezogt oif dir: vest nisht shtarbn durchn shverd. <verse eid="JER 34:4" /><verse number="5" style="v" sid="JER 34:5" />besholem vestu shtarbn, un loit di farbrenungen fun daine eltern, di ershte mlochim vos zainen geven far dir, azoi vet men farbrenen noch dir; un vei har! vet men klogn oif dir, vorem ich hob a vort geredt, zogt Hashem.<verse eid="JER 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6" />un Yirmeyah hanovi hot geredt tsu Tsidkiyah dem melech fun Yehudah ale di dozike verter in Yerushalayim, <verse eid="JER 34:6" /><verse number="7" style="v" sid="JER 34:7" />beeis der cheil fun dem melech fun Bavel hot milchome gehaltn oif Yerushalayim, un oif ale geblibene shtet fun Yehudah, oif Lachish, un oif Azekah; vorem zei zainen geblibn tsvishn di shtet fun Yehudah bafestikte shtet.<verse eid="JER 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8" />dos vort vos iz geven tsu Yirmeyahun fun Hashem, nochdem az der melech Tsidkiyah hot geshlosn a bris mitn gantsn folk in Yerushalayim, oistsurufn bai zich a frailozung; <verse eid="JER 34:8" /><verse number="9" style="v" sid="JER 34:9" />aroistsulozn itlecher zain knecht, un itlecher zain dinst, dem Yehudi un di Yehudit, frai, az keiner zol nisht arbeten mit zei, mit zain yudishen bruder. <verse eid="JER 34:9" /><verse number="10" style="v" sid="JER 34:10" />hobn gevest tsugehert ale harn un dos gantse folk, vos zainen arain in dem bris aroistsulozn itlecher zain knecht, un itlecher zain dinst, frai, nisht tsu arbeten mit zei mer, un zei hobn gehorcht un hobn aroisgelozt. <verse eid="JER 34:10" /><verse number="11" style="v" sid="JER 34:11" />ober dernoch hobn zei charote gekrign, un hobn tsurikgenumen di knecht un di dinstn, vos zei hobn aroisgelozt frai, un zei hobn zei batsvungen far knecht un far dinstn. <verse eid="JER 34:11" /><verse number="12" style="v" sid="JER 34:12" />iz dos vort fun Hashem geven tsu Yirmeyahun, fun Hashem, azoi tsu zogn: <verse eid="JER 34:12" /><verse number="13" style="v" sid="JER 34:13" />azoi hot gezogt Hashem Elokei Yisroel: ich hob geshlosn a bris mit aiere eltern in dem tog vos ich hob zei aroisgetsoign fun land Mitsrayim, fun dem hoiz fun knechtshaft, azoi tsu zogn: <verse eid="JER 34:13" /><verse number="14" style="v" sid="JER 34:14" />tsum sof fun zibn yor zolt ir ar oislozen itlecher zain bruder dem Yehudi, vos hot zich farkoift tsu dir, un hot dir gedint zeks yor; zolst im aroislozn frai fun dir. ober aiere eltern hobn nisht tsugehert tsu mir, un nisht tsugenaigt zeyer oier. <verse eid="JER 34:14" /><verse number="15" style="v" sid="JER 34:15" />un ir hot haint tshuvh geton, un hot geton vos iz rechtfartik in maine oign, oistsurufn a frailozung itlecher tsu zain chever, un ir hot geshlosn a bris far mir in dem hoiz vos main nomen vert gerufn oif im. <verse eid="JER 34:15" /><verse number="16" style="v" sid="JER 34:16" />ober ir hot charote gekrign, un ir hot farshvecht main nomen, un hot tsurikgenumen itlecher zain knecht, un itlecher zain dinst, vos ir hot aroisgelozt frai far zich; un ir hot zei batsvungen tsu zain far knecht un far dinstn tsu aich.<verse eid="JER 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17" />derum hot Hashem azoi gezogt: ir hot nisht tsu gehert tsu mir, oistsurufn a frailozung itlecher tsu zain bruder, un itlecher tsu zain chever, ot ruf ich aich ois a frailozung zogt Hashem, far der shverd, far der pest, un far dem hunger, un ich vel aich machn far a shoider bai ale kinigraichn fun der erd. <verse eid="JER 34:17" /><verse number="18" style="v" sid="JER 34:18" />un ich vel gebn di mentshn vos hobn ibergetretn main bris, vos hobn nisht mekayem geven di verter fun dem bris vos zei hobn geshlosn far mir, bai dem kalb vos zei hobn tseshnitn in tsveyen, un zainen durchgegangen tsvishn zaine shtiker – <verse eid="JER 34:18" /><verse number="19" style="v" sid="JER 34:19" />di harn fun Yehudah, un di harn fun Yerushalayim, di hoifdiner, un di koyanim, un dos gantse folk fun land, vos zainen durchgegangen tsvishn di shtiker fun dem kalb – <verse eid="JER 34:19" /><verse number="20" style="v" sid="JER 34:20" />ich vel zei gebn in der hant fun zeyere faint, un in der hant fun di vos zuchn zeyer lebn, un zeyere toite laiber veln zain tsu shpaiz faran foigel fun himel, un far der chaye fun der erd. <verse eid="JER 34:20" /><verse number="21" style="v" sid="JER 34:21" />un Tsidkiyah dem melech fun Yehudah un zaine harn vel ich gebn in der hant fun zeyere faint, un in der hant fun di vos zuchn zeyer lebn, un in der hant fun dem cheil fun dem melech fun Bavel vos hot opgetsoign fun aich. <verse eid="JER 34:21" /><verse number="22" style="v" sid="JER 34:22" />ze, ich bafel, zogt Hashem, un vel zei umkeren tsu der doziker shtot, un zei veln milchome haltn oif ir, un veln zi batsvingen, un veln zi farbrenen in faier, un di shtet fun Yehudah vel ich machn a vistenish on a bavoiner.<verse eid="JER 34:22" /></para>
  <chapter eid="JER 34" />
  <chapter number="35" style="c" pubnumber="לה" sid="JER 35" />
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem in di teg fun Yhoyakim dem zun fun Yoshiyahun, dem melech fun Yehudah, azoi tsu zogn: <verse eid="JER 35:1" /><verse number="2" style="v" sid="JER 35:2" />gei tsu dem hoiz fun di Rechavim, un zolst redn tsu zei, un zei brengen in hoiz fun Hashem, in einer fun di kamern, un zei gebn trinken vain. <verse eid="JER 35:2" /><verse number="3" style="v" sid="JER 35:3" />hob ich genumen Yaazanyah dem zun fun Yirmeyah dem zun fun Chabatsinyahn, un zaine brider, un ale zaine zin, un dos gantse hoiz fun di Rechavim. <verse eid="JER 35:3" /><verse number="4" style="v" sid="JER 35:4" />un ich hob zei gebracht in hoiz fun Hashem, in der kamer fun di zin fun Chanan dem zun fun Yigdalyahu dem man fun G-t, vos lebn der kamer fun di harn, vos iber der kamer fun Maaseiyah dem zun fun Shallum dem shvelhiter. <verse eid="JER 35:4" /><verse number="5" style="v" sid="JER 35:5" />un ich hob derlangt far di kinder fun dem hoiz fun di Rechavim kriglech ful mit vain un bechers, un ich hob tsu zei gezogt: trinkt vain. <verse eid="JER 35:5" /><verse number="6" style="v" sid="JER 35:6" />hobn zei gezogt: mir trinken nisht kein vain, vorem Yehonadav der zun fun Rechavn, undzer foter, hot undz bafoiln, azoi tsu zogn: ir zolt nisht trinken kein vain, ir, un aiere kinder biz eibik; <verse eid="JER 35:6" /><verse number="7" style="v" sid="JER 35:7" />un kein hoiz zolt ir nisht boien, un kein zomen zolt ir nisht zeyen, un kein vaingorten zolt ir nisht flantsn, un nisht hobn; naiert in getseltn zolt ir zitsn ale aiere teg, kedei ir zolt lebn fil teg oifn gezicht fun der erd vos ir voint dortn. <verse eid="JER 35:7" /><verse number="8" style="v" sid="JER 35:8" />un mir hobn tsugehert tsu dem kol fun Yehonadav dem zun fun Rechavn, undzer foter, in alts vos er hot undz bafoiln, nisht tsu trinken kein vain ale undzere teg, mir, undzere vaiber, undzere zin, un undzere techter; <verse eid="JER 35:8" /><verse number="9" style="v" sid="JER 35:9" />un nisht tsu boien kein haizer far undz tsum voinen, un kein vaingorten, un kein feld, un kein zomen, zol bai undz nisht zain. <verse eid="JER 35:9" /><verse number="10" style="v" sid="JER 35:10" />un mir zainen gezesn in getseltn, un mir hobn gehorcht un geton azoi vi alts vos undzer foter Yehonadav hot undz bafoiln. <verse eid="JER 35:10" /><verse number="11" style="v" sid="JER 35:11" />un es iz geven, az Nevuchadretsar der melech fun Bavel iz aroifgekumen oifn land, hobn mir gezogt: kumt, un lomir araingein in Yerushalayim fun vegen dem cheil fun di Kasdim, un fun vegen dem cheil fun Aram; un mir hobn zich bazetst in Yerushalayim.<verse eid="JER 35:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12" />iz dos vort fun Hashem geven tsu Yirmeyahun, azoi tsu zogn: <verse eid="JER 35:12" /><verse number="13" style="v" sid="JER 35:13" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: gei, un zolst zogn tsu di mener fun Yehudah, un tsu di bavoiner fun Yerushalayim: vilt ir nisht a musar aropnemen tsutsuhern tsu maine verter? zogt Hashem. <verse eid="JER 35:13" /><verse number="14" style="v" sid="JER 35:14" />gehaltn vern di verter fun Yehonadav dem zun fun Rechavn, vos hot bafoiln zaine kinder nisht tsu trinken kein vain, un zei trinken nisht biz oif haintikn tog, vail zei gehorchn dem bafel fun zeyer foter, un ich hob geredt tsu aich, nochanand un nochanand geredt, un ir hot nisht tsugehert tsu mir. <verse eid="JER 35:14" /><verse number="15" style="v" sid="JER 35:15" />un ich hob geshikt tsu aich ale maine knecht di neviim, nochanand un nochanand geshikt, azoi tsu zogn: kert aich um itlecher fun zain shlechtn veg, un besert aiere meisim, un ir zolt nisht gein noch fremde g‑ter zei tsu dinen, un blaibt zitsn oif der erd vos ich hob gegebn aich un aiere eltern; ober ir hot nisht tsugenaigt aier oier, un nisht tsugehert tsu mir. <verse eid="JER 35:15" /><verse number="16" style="v" sid="JER 35:16" />iz, vail di kinder fun Yehonadav dem zun fun Rechavn hobn mekayem geven dem bafel fun zeyer foter, vos er hot zei bafoiln, un dos dozike folk hot nisht tsugehert tsu mir, <verse eid="JER 35:16" /><verse number="17" style="v" sid="JER 35:17" />derum hot azoi gezogt Hashem Elokei Tseva'ot, Elokei Yisroel: ze, ich breng oif Yehudah un oif ale bavoiner fun Yerushalayim dos gantse beiz vos ich hob ongezogt oif zei; vail ich hob geredt tsu zei, un zei hobn nisht tsugehert, un ich hob gerufn tsu zei un zei hobn zich nisht opgerufn.<verse eid="JER 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18" />un tsu dem hoiz fun di Rechavim hot Yirmeyah gezogt: azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: vail ir hot tsugehert tsu dem bafel fun Yehonadav aier foter, un ir hot opgehit ale zaine bafeln, un ir hot geton azoi vi alts vos er hot aich bafoiln, <verse eid="JER 35:18" /><verse number="19" style="v" sid="JER 35:19" />derum hot azoi gezogt Hashem Tseva'ot, Elokei Yisroel: es vet nisht farshnitn vern fun Yehonadav dem zun fun Rechavn a man tsu shtein far mir ale teg.<verse eid="JER 35:19" /></para>
  <chapter eid="JER 35" />
  <chapter number="36" style="c" pubnumber="לו" sid="JER 36" />
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1" />un es iz geven in firtn yor fun Yhoyakim dem zun fun Yoshiyahun, dem melech fun Yehudah, iz geven dos dozike vort tsu Yirmeyahun fun Hashem, azoi tsu zogn: <verse eid="JER 36:1" /><verse number="2" style="v" sid="JER 36:2" />nem dir a megile, un zolst onshraibn oif ir ale verter vos ich hob geredt tsu dir oif Yisroel, un oif Yehudah, un oif ale felker, fun dem tog vos ich red tsu dir, fun di teg fun Yoshiyahun un biz oif haintikn tog. <verse eid="JER 36:2" /><verse number="3" style="v" sid="JER 36:3" />efsher vet dos hoiz fun Yehudah hern dos gantse beiz vos ich tracht zei tsu ton; kedei zei zoln zich umkeren itlecher fun zain shlechtn veg, un ich zol fargebn zeyer farbrech un zeyer zind.<verse eid="JER 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4" />hot Yirmeyah gerufn Baruch dem zun fun Neriyahn, un Baruch hot oifgeshribn fun Yirmeyahs moil ale verter fun Hashem, vos er hot tsu im geredt, oif a megile. <verse eid="JER 36:4" /><verse number="5" style="v" sid="JER 36:5" />un Yirmeyah hot bafoiln Baruchn, azoi tsu zogn: ich bin farhaltn, ich ken nisht kumen in hoiz fun Hashem; <verse eid="JER 36:5" /><verse number="6" style="v" sid="JER 36:6" />derum zolst du gein, un leyenen fun der megile vos du host oifgeshribn fun main moil, di verter fun Hashem, in di oiern fun folk, in hoiz fun Hashem in a fasttog; un oich in di oiern fun gants Yehudah vos kumen fun zeyere shtet, zolstu zei leyenen. <verse eid="JER 36:6" /><verse number="7" style="v" sid="JER 36:7" />efsher vet faln zeyer gebet far Hashem, un zei veln zich umkeren itlecher fun zain shlechtn veg; vorem grois iz der kaas un der grimtsorn vos Hashem hot geredt oif dem dozikn folk.<verse eid="JER 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 36:8" />hot Baruch der zun fun Neriyahn geton azoi vi alts vos Yirmeyah hanovi hot im bafoiln – tsu leyenen fun dem buch di verter fun Hashem in Hashems hoiz.<verse eid="JER 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 36:9" />un es iz geven in finftn yor fun Yhoyakim dem zun fun Yoshiyahun dem melech fun Yehudah, in naintn choidesh, hobn oisgerufn a taanis far Hashem dos gantse folk in Yerushalayim, un dos gantse folk vos iz gekumen fun di shtet fun Yehudah in Yerushalayim. <verse eid="JER 36:9" /><verse number="10" style="v" sid="JER 36:10" />un Baruch hot geleyent fun dem buch di verter fun Yirmeyahun in hoiz fun Hashem, in der kamer fun Gemaryah dem zun fun Shafan dem shraiber, in dem oibershtn hoif, in aingang fun dem naiem toier fun Hashems hoiz, in di oiern fun gantsn folk.<verse eid="JER 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 36:11" />hot Michayah der zun fun Gemaryah dem zun fun Shafanen gehert fun buch ale verter fun Hashem, <verse eid="JER 36:11" /><verse number="12" style="v" sid="JER 36:12" />un er hot aropgenidert tsum hoiz fun melech, in dem shraibers kamer; ersht dortn zitsn ale harn, Elishama der shraiber, un Delayahu der zun fun Shemayahuen, un Elnatan der zun fun Achborn, un Gemaryah der zun fun Shafanen, un Tsidkiyah der zun fun Chananyahuen, un ale harn. <verse eid="JER 36:12" /><verse number="13" style="v" sid="JER 36:13" />hot zei Michayah dertseilt ale verter vos er hot gehert, ven Baruch hot geleyent fun buch in di oier fun folk. <verse eid="JER 36:13" /><verse number="14" style="v" sid="JER 36:14" />un ale harn hot geshikt tsu Baruchn Yehudi dem zun fun Netanyah dem zun fun Shelemyah dem zun fun Kushien, azoi tsu zogn: di megile vos du host fun ir geleyent in di oiern fun folk, nem zi in dain hant, un kum aher. hot Baruch der zun fun Neriyahun genumen di megile in zain hant, un iz gekumen tsu zei. <verse eid="JER 36:14" /><verse number="15" style="v" sid="JER 36:15" />hobn zei gezogt tsu im: zets akorsht, un leyen zi in undzere oiern; un Baruch hot geleyent in zeyere oiern. <verse eid="JER 36:15" /><verse number="16" style="v" sid="JER 36:16" />un es iz geven, vi zei hobn gehert ale verter, azoi hobn zei einer dem andern ongekukt in angst, un zei hobn gezogt tsu Baruchn: dertseilt muzn mir dertseiln dem melech ale di dozike verter. <verse eid="JER 36:16" /><verse number="17" style="v" sid="JER 36:17" />un Baruchn hobn zei gefregt, azoi tsu zogn: zog undz akorsht, vi azoi hostu oifgeshribn di ale verter fun zain moil? <verse eid="JER 36:17" /><verse number="18" style="v" sid="JER 36:18" />hot Baruch tsu zei gezogt: er flegt oisrufn tsu mir mit zain moil ale di dozike verter, un ich fleg oifshraibn oifn buch mit tint. <verse eid="JER 36:18" /><verse number="19" style="v" sid="JER 36:19" />hobn di harn gezogt tsu Baruchn: gei bahalt zich, du, un Yirmeyah, un keiner zol nisht visen vu ir zait.<verse eid="JER 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20" />un zei zainen gegangen tsum melech in hoif; un di megile hobn zei avekgeleigt in der kamer fun Elishama dem shraiber; un zei hobn dertseilt in di oiern fun melech ale verter. <verse eid="JER 36:20" /><verse number="21" style="v" sid="JER 36:21" />hot der melech geshikt Yehudin tsu brengen di megile, un er hot zi gebracht fun der kamer fun Elishama dem shraiber; un Yehudi hot zi geleyent in di oiern fun melech, un in di oiern fun di harn vos zainen geshtanen lebn melech. <verse eid="JER 36:21" /><verse number="22" style="v" sid="JER 36:22" />un der melech iz gezesn in dem vinterhoiz – dos iz geven in naintn choidesh – un der faiertop iz geven ongetsundn far im. <verse eid="JER 36:22" /><verse number="23" style="v" sid="JER 36:23" />iz vi Yehudi hot opgeleyent drai amudim oder fir, azoi hot er es opgeshnitn mitn shraibermeser, un aroifgevorfn oifn faier vos in faiertop, biz di gantse megile iz farlendt gevorn oif dem faier vos in faiertop. <verse eid="JER 36:23" /><verse number="24" style="v" sid="JER 36:24" />un zei hobn zich nisht dershrokn, un nisht tserisn zeyere kleider, der melech un ale zaine knecht vos hobn gehert ale di dozike verter. <verse eid="JER 36:24" /><verse number="25" style="v" sid="JER 36:25" />un hagam Elnatan un Delayahu un Gemaryah hobn zich gebetn baim melech nisht tsu farbrenen di megile, hot er doch nisht tsugehert tsu zei. <verse eid="JER 36:25" /><verse number="26" style="v" sid="JER 36:26" />un der melech hot bafoiln Yerachmeel dem zun fun melech, un Serayah dem zun fun Azrieln, un Shelemyah dem zun fun Avdeeln, tsu brengen Baruch dem shraiber un Yirmeyah hanovi, ober Hashem hot zei bahaltn.<verse eid="JER 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27" />un dos vort fun Hashem iz geven tsu Yirmeyahun, nochdem vi der melech hot farbrent di megile mit di verter vos Baruch hot oifgeshribn fun Yirmeyahs moil – azoi tsu zogn: <verse eid="JER 36:27" /><verse number="28" style="v" sid="JER 36:28" />nem dir vider an ander megile, un shraib on oif ir ale frierdike verter vos zainen geven oif der ershter megile, vos Yhoyakim der melech fun Yehudah hot farbrent. <verse eid="JER 36:28" /><verse number="29" style="v" sid="JER 36:29" />un oif Yhoyakim dem melech fun Yehudah zolstu zogn: azoi hot Hashem gezogt: du host farbrent di dozike megile, azoi tsu zogn: lemai hostu geshribn oif ir, azoi tsu zogn: kumen vet kumen der melech fun Bavel, un er vet tseshtern dos dozike land, un vet fartiliken fun ir mentshn un beheimes? <verse eid="JER 36:29" /><verse number="30" style="v" sid="JER 36:30" />derum hot Hashem azoi gezogt oif Yhoyakim dem melech fun Yehudah: keiner fun im vet nisht zitsn oifn tron fun Dovid, un zain toiter laib vet zich valgern oif der hits bai tog, un oif der kelt bai nacht. <verse eid="JER 36:30" /><verse number="31" style="v" sid="JER 36:31" />un ich vel zich oprechenen mit im, un mit zain zomen, un mit zaine knecht, far zeyere zind, un ich vel brengen oif zei, un oif di bavoiner fun Yerushalayim, un oif di mener fun Yehudah, dos gantse beiz vos ich hob ongezogt oif zei, un zei hobn nisht tsugehert.<verse eid="JER 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32" />un Yirmeyah hot genumen an ander megile, un hot zi gegebn tsu Baruch dem zun fun Neriyahun, dem shraiber un er hot oifgeshribn oif ir fun Yirmeyahs moil ale verter fun dem buch vos Yhoyakim der melech fun Yehudah hot farbrent in faier; un tsu zei zainen tsugeleigt gevorn noch fil verter azoi vi zei.<verse eid="JER 36:32" /></para>
  <chapter eid="JER 36" />
  <chapter number="37" style="c" pubnumber="לז" sid="JER 37" />
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1" />un Tsidkiyah der zun fun Yoshiyahun iz gevorn melech oif dem ort fun Konyahu dem zun fun Yhoyakimen, vos Nevuchadretsar der melech fun Bavel hot gemacht far a melech in land Yehudah. <verse eid="JER 37:1" /><verse number="2" style="v" sid="JER 37:2" />un er un zaine knecht un dos gantse folk fun land hobn nisht tsugehert tsu di verter fun Hashem, vos er hot geredt durch Yirmeyah hanovi.<verse eid="JER 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 37:3" />un der melech Tsidkiyah hot geshikt Yehukhal dem, zun fun Shelemyahn, un Tsefanyah dem zun fun Maaseiyahn, dem koyen, tsu Yirmeyah hanovi, azoi tsu zogn: zai, ich bet dich, mispalel far undz tsu Hashem Elokeinu. <verse eid="JER 37:3" /><verse number="4" style="v" sid="JER 37:4" />un Yirmeyah flegt kumen un gein tsvishn folk, vorem me hot im noch nisht gehat araingegebn in tefish. <verse eid="JER 37:4" /><verse number="5" style="v" sid="JER 37:5" />un der cheil fun Pharaohn iz aroisgegangen fun Mitsrayim; un di Kasdim vos hobn gelegert oif Yerushalayim, hobn gehert di herung vegen zei, un hobn opgetsoign fun Yerushalayim.<verse eid="JER 37:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 37:6" />iz dos vort fun Hashem geven tsu Yirmeyah hanovi, azoi tsu zogn: <verse eid="JER 37:6" /><verse number="7" style="v" sid="JER 37:7" />azoi hot gezogt Hashem Elokei Yisroel: azoi zolt ir zogn tsu dem melech fun Yehudah vos shikt aich tsu mir mich tsu fregn: ze, der cheil fun Pharaohn vos iz aroisgegangen aich tsu hilf, kert zich um tsu zain land, Mitsrayim. <verse eid="JER 37:7" /><verse number="8" style="v" sid="JER 37:8" />un di Kasdim veln zich umkeren, un veln milchome haltn oif der doziker shtot, un zei veln zi batsvingen, un veln zi farbrenen in faier. <verse eid="JER 37:8" /><verse number="9" style="v" sid="JER 37:9" />azoi hot Hashem gezogt: ir zolt aich nisht ainredn, azoi tsu zogn: avekgein veln avekgein fun undz di Kasdim; vorem zei veln nisht avekgein. <verse eid="JER 37:9" /><verse number="10" style="v" sid="JER 37:10" />vorem az ir zolt shlogn dem gantsn cheil fun di Kasdim vos haltn milchome oif aich, un etleche geshtochene zoln blaibn fun zei, veln zei oifshtein itlecher in zain getselt, un veln farbrenen di dozike shtot in faier.<verse eid="JER 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11" />un es iz geven, az der cheil fun di Kasdim hot opgetsoign fun Yerushalayim far dem cheil fun Pharaohn, <verse eid="JER 37:11" /><verse number="12" style="v" sid="JER 37:12" />iz Yirmeyah aroisgegangen fun Yerushalayim tsu gein kein land Binyamin, kedei tsu krign dortn zain chelek yerushe tsvishn dem folk. <verse eid="JER 37:12" /><verse number="13" style="v" sid="JER 37:13" />iz, vi er iz geven in toier fun Binyamin, iz dortn geven der hoiptman fun der vach, vos zain nomen iz geven Yiriyah der zun fun Shelemyah dem zun fun Chananyahn; hot er ongechapt Yirmeyah henvin, azoi tsu zogn: tsu di Kasdim vilstu tsufaln. <verse eid="JER 37:13" /><verse number="14" style="v" sid="JER 37:14" />hot Yirmeyah gezogt: a lign! ich vil nisht tsufaln tsu di Kasdim. ober er hot nisht tsugehert tsu im, un Yiriyah hot ongechapt Yirmeyahun, un hot im gebracht tsu di harn. <verse eid="JER 37:14" /><verse number="15" style="v" sid="JER 37:15" />un di harn hobn getsernt oif Yirmeyahun, un hobn im geshlogn, un im araingegebn in gefenkenish, in hoiz fun Yehonatan dem shraiber; vorem dos hot men gemacht far a tefish.<verse eid="JER 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 37:16" />az Yirmeyah iz gekumen in gefenkenish un in di gevelbn, un Yirmeyah iz dortn opgezesn fil teg, <verse eid="JER 37:16" /><verse number="17" style="v" sid="JER 37:17" />hot der melech Tsidkiyah geshikt, un hot im aroisgenumen; un der melech hot im gefregt bai zich in hoiz, in farborgenish, un hot gezogt: faran a vort fun Hashem? hot Yirmeyah gezogt: faran; un er hot gezogt: in der hant fun dem melech fun Bavel vestu ibergegebn vern. <verse eid="JER 37:17" /><verse number="18" style="v" sid="JER 37:18" />un Yirmeyah hot gezogt tsum melech Tsidkiyahun: vos hob ich gezindikt kegen dir, un kegen daine knecht, un kegen dem dozikn folk, vos ir hot mich araingegebn in tefish? <verse eid="JER 37:18" /><verse number="19" style="v" sid="JER 37:19" />un vu zainen aiere neviim vos hobn aich nevies gezogt, azoi tsu zogn: der melech fun Bavel vet nisht kumen oif aich un oif dem dozikn land? <verse eid="JER 37:19" /><verse number="20" style="v" sid="JER 37:20" />un atsund, her tsu, ich bet dich, main har kinig; zol, ich bet dich, faln main gebet far dir, un zolst mich nisht umkeren in hoiz fun Yehonatan dem shraiber, un lomich nisht shtarbn dortn. <verse eid="JER 37:20" /><verse number="21" style="v" sid="JER 37:21" />hot der melech Tsidkiyah bafoiln, un me hot araingezetst Yirmeyahun in hoif fun der vach, un me hot im gegebn a labn broit a tog fun der bekergas biz dos gantse broit iz oisgegangen fun der shtot. azoi iz Yirmeyah gezesn in hoif fun der vach.<verse eid="JER 37:21" /></para>
  <chapter eid="JER 37" />
  <chapter number="38" style="c" pubnumber="לח" sid="JER 38" />
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1" />un Shefatyah der zun fun Mattanen, un Gedalyahu der zun fun Pashchurn, un Yuchal der zun fun Shelemyahuen, un Pashchur der zun fun Malkiyahn, hobn gehert di verter vos Yirmeyah hot geredt tsum gantsn folk, azoi tsu zogn: <verse eid="JER 38:1" /><verse number="2" style="v" sid="JER 38:2" />azoi hot Hashem gezogt: der vos blaibt zitsn in der doziker shtot vet shtarbn fun der shverd, fun dem hunger, un fun der pest, un der vos geit arois tsu di Kasdim, vet blaibn lebn; zain nefesh vet im zain tsum gevins, un er vet blaibn lebn. <verse eid="JER 38:2" /><verse number="3" style="v" sid="JER 38:3" />azoi hot Hashem gezogt: ibergegebn vet ibergegebn vern di dozike shtot in der hant fun dem cheil fun dem melech fun Bavel, un er vet zi batsvingen. <verse eid="JER 38:3" /><verse number="4" style="v" sid="JER 38:4" />hobn di harn gezogt tsum melech: zol geteit vern, ich bet dich, der doziker man, vorem er shloft doch op di hent fun di hamilchomelait vos zainen ibergebliben in der doziker shtot, un di hent fun dem gantsn folk, az der redt tsu zei azoi vi di dozike reid; vorem der doziker man zucht nisht frid far dem dozikn folk nor bloiz a roe. <verse eid="JER 38:4" /><verse number="5" style="v" sid="JER 38:5" />hot der melech Tsidkiyah gezogt: ot iz er in aier hant; vorem der melech ken mit aich gornisht oisfirn. <verse eid="JER 38:5" /><verse number="6" style="v" sid="JER 38:6" />hobn zei genumen Yirmeyahun, un hobn im araingevorfn in der grub fun Malkiyah dem zun fun melech, vos in hoif fun der vach; un zei hobn aropgelozt Yirmeyahun mit shtrik. un in der grub iz kein vaser nisht geven, nor bloiz leim; un Yirmeyah iz araingezunken in dem leim.<verse eid="JER 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7" />hot gehert Eved-Melech der Kushi, a man a hoifdiner vos iz geven in hoiz fun melech, az me hot Yirmeyahun araingeton in der grub; un der melech iz gezesn in toier fun Binyamin. <verse eid="JER 38:7" /><verse number="8" style="v" sid="JER 38:8" />iz Eved-Melech aroisgegangen fun melechs hoiz, un hot geredt tsum melech, azoi tsu zogn: <verse eid="JER 38:8" /><verse number="9" style="v" sid="JER 38:9" />main har melech, shlecht bagangen hobn zich di dozike lait mit alts vos zei hobn geton tsu Yirmeyah hanovi, vos zei hobn im araingevorfn in grub; un er shtarbt oif zain ort far hunger; vorem nishto kein broit mer in shtot. <verse eid="JER 38:9" /><verse number="10" style="v" sid="JER 38:10" />hot der melech bafoiln Eved-Melech dem Kushi, azoi tsu zogn: nem mit dir fun danen draisik man, un zolst aroifbrengen Yirmeyah henvin fun der grub eider er vet shtarbn. <verse eid="JER 38:10" /><verse number="11" style="v" sid="JER 38:11" />hot Eved-Melech genumen di mentshn mit zich, un er iz gekumen in hoiz fun melech unter der shatskamer, un hot fun dortn genumen alte koders un alte shmates, un er hot zei aropgelozt tsu Yirmeyahun in grub mit shtrik. <verse eid="JER 38:11" /><verse number="12" style="v" sid="JER 38:12" />un Eved-Melech der Kushi hot gezogt tsu Yirmeyahun: tu, ich bet dich, di alte kodres un di shmates unter daine orems unter di shtrik. un Yirmeyah hot azoi geton. <verse eid="JER 38:12" /><verse number="13" style="v" sid="JER 38:13" />un zei hobn getsoign Yirmeyahun mit shtrik, un hobn im aroifgebracht fun der grub. un Yirmeyah iz gezesn in hoif fun der vach.<verse eid="JER 38:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14" />hot der melech Tsidkiyah geshikt un genumen Yirmeyah henvin tsu zich, tsum dritn aingang vos in hoiz fun Hashem; un der melech hot gezogt tsu Yirmeyahun: ich vel dich fregn a zach; zolst nisht farleikenen fun mir a vort. <verse eid="JER 38:14" /><verse number="15" style="v" sid="JER 38:15" />hot Yirmeyah gezogt tsu Tsidkiyahun: az ich vel dir zogn vestu doch teitn mich teitn, un az ich vel dir gebn an etsh, vestu nisht tsuhern tsu mir. <verse eid="JER 38:15" /><verse number="16" style="v" sid="JER 38:16" />hot der melech Tsidkiyah geshvorn Yirmeyahun in farborgenish, azoi tsu zogn: azoi vi es lebt Hashem vos hot undz bashafn di dozike zel, oib ich vel dich teitn, un oib ich vel dich ibergebn in der hant fun di dozike lait vos zuchn dain lebn!<verse eid="JER 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17" />hot Yirmeyah gezogt tsu Tsidkiyahun: azoi hot gezogt Hashem Elokei Tseva'ot, Elokei Yisroel: oib aroisgein vestu aroisgein tsu di harn fun dem melech fun Bavel, vet dain nefesh blaibn lebn, un di dozike shtot vet nisht farbrent vern in faier; i du vest blaibn lebn, i dain hoizgezint. <verse eid="JER 38:17" /><verse number="18" style="v" sid="JER 38:18" />oib ober vest nisht aroisgein tsu di harn fun dem melech fun Bavel, vet di dozike shtot ibergegebn vern in der hant fun di Kasdim, un zei veln zi farbrenen in faier, un du vest nisht antrunen vern fun zeyer hant. <verse eid="JER 38:18" /><verse number="19" style="v" sid="JER 38:19" />hot der melech Tsidkiyah gezogt tsu Yirmeyahun: ich hob moire far di Yidn vos zainen tsugefaln tsu di Kasdim, me zol mich nisht ibergebn in zeyer hant, un zei veln zich onton on mir. <verse eid="JER 38:19" /><verse number="20" style="v" sid="JER 38:20" />hot Yirmeyah gezogt: me vet dich nisht ibergebn. her tsu, ich bet dich, tsu dem kol fun Hashem in vos ich red tsu dir, un es vet zain gut far dir, un dain nefesh vet blaibn lebn. <verse eid="JER 38:20" /><verse number="21" style="v" sid="JER 38:21" />oib ober du vilst nisht aroisgein, iz dos dos vort vos Hashem hot mir gevizn: <verse eid="JER 38:21" /><verse number="22" style="v" sid="JER 38:22" />ersht ale vaiber vos zainen geblibn in hoiz fun dem melech fun Yehudah, vern aroisgefirt tsu di harn fun dem melech fun Bavel, un zei zogn:</para>
  <para style="b" vid="JER 38:22" />
  <para style="q" vid="JER 38:22">dich aingeredt un dich baigekumen</para>
  <para style="q" vid="JER 38:22">hobn di gute fraint daine;</para>
  <para style="q" vid="JER 38:22">aingezunken in a zump zainen daine fis –</para>
  <para style="q" vid="JER 38:22">zainen zei opgetretn ahinter.<verse eid="JER 38:22" /></para>
  <para style="b" />
  <para style="m">
    <verse number="23" style="v" sid="JER 38:23" />un ale daine vaiber un daine kinder firt men arois tsu di Kasdim, un du vest nisht antrunen vern fun zeyer hant, naiert in der hant fun dem melech fun Bavel vestu gechapt vern, un vest machn farbrenen di dozike shtot in faier.<verse eid="JER 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24" />hot Tsidkiyah gezogt tsu Yirmeyahun: zol kein mentsh nisht visen fun di dozike verter, un vest nisht shtarbn. <verse eid="JER 38:24" /><verse number="25" style="v" sid="JER 38:25" />un az di harn veln hern az ich hob geredt mit dir, un zei veln kumen tsu dir un zogn tsu dir: zog undz akorsht, vos hostu geredt tsum melech; zolst nisht farleikenen fun undz un mir veln dich nisht teitn; un vos hot geredt tsu dir der melech? <verse eid="JER 38:25" /><verse number="26" style="v" sid="JER 38:26" />zolstu zogn tsu zei: ich hob gelozt faln main gebet faran melech, mich nisht umtsukeren in Yehonatans hoiz, tsu shtarbn dortn. <verse eid="JER 38:26" /><verse number="27" style="v" sid="JER 38:27" />zainen gekumen ale harn tsu Yirmeyahun, un hobn im gefregt, un er hot zei gezogt azoi vi ale di dozike verter vos der melech hot bafoiln, un zei hobn im tsu ru gelozt, vorem dos gereid iz nisht gehert gevorn. <verse eid="JER 38:27" /><verse number="28" style="v" sid="JER 38:28" />un Yirmeyah iz gezesn in hoif fun der vach biz dem tog vos Yerushalayim iz batsvungen gevorn. un er iz dort geven ven Yerushalayim iz batsvungen gevorn.<verse eid="JER 38:28" /></para>
  <chapter eid="JER 38" />
  <chapter number="39" style="c" pubnumber="לט" sid="JER 39" />
  <para style="p">
    <verse number="1" style="v" sid="JER 39:1" />in naintn yor fun Tsidkiyah dem melech fun Yehudah, in tsentn choidesh, iz gekumen Nevuchadretsar der melech fun Bavel un zain gantser cheil oif Yerushalayim, un zei hobn gelegert oif ir; <verse eid="JER 39:1" /><verse number="2" style="v" sid="JER 39:2" />in elftn yor fun Tsidkiyahun, in firtn choidesh, in naintn tog fun choidesh, iz aingebrochn gevorn di shtot. – <verse eid="JER 39:2" /><verse number="3" style="v" sid="JER 39:3" />zainen gekumen ale harn fun dem melech fun Bavel, un hobn zich gezetst in mitlstn toier: Nergal Sar-Etser, Samgar-Nevo, Sar-Sechim rab-saris, Nergal Sar-Etser, Rav-Mag, un ale iberike harn fun dem melech fun Bavel. <verse eid="JER 39:3" /><verse number="4" style="v" sid="JER 39:4" />un es iz geven, vi Tsidkiyah der melech fun Yehudah un ale milchome-lait hobn zei derzen, azoi zainen zei antlofn, un zainen aroisgegangen bai nacht fun shtot durch dem melechs gortn, durch es, toier tsvishn di tsvei moiern; un er iz aroisgegangen oifn veg fun ploin. <verse eid="JER 39:4" /><verse number="5" style="v" sid="JER 39:5" />hot der cheil fun di Kasdim zei nochgeyogt, un zei hobn ongeyogt Tsidkiyahun in di ploinen fun Yericho; un zei hobn im genumen un im aroifgebracht tsu Nevuchadretsar dem melech fun Bavel kein Rivlah in land Chammat, un er hot aroisgezogt a mishpot oif im. <verse eid="JER 39:5" /><verse number="6" style="v" sid="JER 39:6" />un der melech fun Bavel hot geshochtn di zin fun Tsidkiyahun in Rivlah far zaine oign; oich ale adllait fun Yehudah hot der melech fun Bavel geshochtn. <verse eid="JER 39:6" /><verse number="7" style="v" sid="JER 39:7" />un di oign fun Tsidkiyahun hot er blind gemacht, un er hot im geshmidt in kuperne keitn, im tsu brengen kein Bavel. <verse eid="JER 39:7" /><verse number="8" style="v" sid="JER 39:8" />un dos hoiz fun dem melech, un dos hoiz fun folk, hobn di Kasdim farbrent in faier, un di moiern fun Yerushalayim hobn zei aingevorfn. <verse eid="JER 39:8" /><verse number="9" style="v" sid="JER 39:9" />un dem resht fun folk vos zainen geblibn in der shtot, un di tsugefalene vos zainen tsugefaln tsu im, un dem resht fun folk vos zainen geblibn, hot Nevuzaradan der hoipt fun dem laib-cheil fartriben kein Bavel. <verse eid="JER 39:9" /><verse number="10" style="v" sid="JER 39:10" />ober fun dem orimen folk vos hobn gornisht gehat, hot Nevuzaradan der hoipt fun dem laib-cheil ibergelozt in land Yehudah, un er hot zei gegebn vaingertner un felder in yenem tog.<verse eid="JER 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11" />un Nevuchadretsar der melech fun Bavel hot bafoiln durch Nevuzaradan dem hoipt fun dem laib-cheil vegen Yirmeyahun, azoi tsu zogn: <verse eid="JER 39:11" /><verse number="12" style="v" sid="JER 39:12" />nem im, un tu daine oign oif im, un zolst im nisht ton kein shum beiz; naiert azoi vi er vet dir zogn, azoi tu mit im. <verse eid="JER 39:12" /><verse number="13" style="v" sid="JER 39:13" />hot geshikt Nevuzaradan der hoipt fun dem laib-cheil, un Nevushazban rab-saris, un Nergal-saretser Rav-Mag, un ale groise lait fun dem melech fun Bavel – <verse eid="JER 39:13" /><verse number="14" style="v" sid="JER 39:14" />hobn zei geshikt, un hobn aroisgenumen Yirmeyahun fun hoif fun der vach, un hobn im ibergegebn tsu Gedalyahu dem zun fun Achikam dem zun fun Shafanen, im aroistsunemen aheim. un er iz gezesn tsvishn folk.<verse eid="JER 39:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15" />un dos vort fun Hashem iz geven tsu Yirmeyahun, ven er iz geven aingeshpart in hoif fun der vach, azoi tsu zogn: <verse eid="JER 39:15" /><verse number="16" style="v" sid="JER 39:16" />gei, un zolst zogn tsu Eved-Melech dem Kushi, azoi tsu zogn: azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: ze, ich breng maine verter oif der doziker shtot tsum beizn, un nisht tsum gutn; un zei veln geshen far dir in yenem tog. <verse eid="JER 39:16" /><verse number="17" style="v" sid="JER 39:17" />ober ich vel dich matsl zain in yenem tog, zogt Hashem, un vest nisht ibergegebn vern in der hant fun di mentshn vos du shrekst zich far zei. <verse eid="JER 39:17" /><verse number="18" style="v" sid="JER 39:18" />vorem antrinen vel ich dich machn antrinen, un durchn shverd vestu nisht faln, un dain nefesh vet dir zain tsum gevins, vail du host zich farzichert oif mir, zogt Hashem.<verse eid="JER 39:18" /></para>
  <chapter eid="JER 39" />
  <chapter number="40" style="c" pubnumber="מ" sid="JER 40" />
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1" />dos vort vos iz geven tsu Yirmeyahun fun Hashem nochdem az Nevuzaradan der hoipt fun dem laib-cheil hot im avekgelozt fun Ramah, ven er hot im gehat genumen a geshmidtn in keitn tsvishn ale fartribene fun Yerushalayim un Yehudah vos zainen fartriben gevorn kein Bavel. <verse eid="JER 40:1" /><verse number="2" style="v" sid="JER 40:2" />un der hoipt fun dem laib-cheil hot genumen Yirmeyahun, un hot tsu im gezogt: Hashem dain G-t hot ongezogt dos dozike beiz oif dem dozikn ort, <verse eid="JER 40:2" /><verse number="3" style="v" sid="JER 40:3" />un Hashem hot gebracht un geton azoi vi er hot geredt; vorem ir hot gezindikt tsu Hashem, un ir hot nisht tsugehert tsu zain kol, derum iz aich geshen di dozike zach. <verse eid="JER 40:3" /><verse number="4" style="v" sid="JER 40:4" />un atsund, ze, ich hob dich haint loiz gemacht fun di keitn vos oif dain hant. oib es iz gut in daine oign tsu kumen mit mir kein Bavel, kum, un ich vel ton main oig oif dir; oib ober es iz shlecht in daine oign tsu kumen mit mir kein Bavel, loz es. ze, dos gantse land ligt far dir; vu es iz gut un vu es iz recht in daine oign ahin tsu gein, gei. <verse eid="JER 40:4" /><verse number="5" style="v" sid="JER 40:5" />un az er hot alts zich nisht gevolt umkeren hot Nevuzaradan gezogt: to ker zich um tsu Gedalyah dem zun fun Achikam dem zun fun Shafanen, vos der melech fun Bavel hot oifgezetst iber di shtet fun Yehudah, un zits mit im tsvishn dem folk; oder vuhin nor es iz recht in daine oign tsu gein, gei. un der hoipt fun dem laib-cheil hot im gegebn tserung un a matone, un hot im avekgeshikt. <verse eid="JER 40:5" /><verse number="6" style="v" sid="JER 40:6" />un Yirmeyah iz gekumen tsu Gedalyah dem zun fun Achikamen kein Mitspah. un iz gezesn mit im tsvishn dem folk vos zainen geblibn in land.<verse eid="JER 40:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7" />un ale hoiptlait fun cheil vos in feld, zei mit zeyere mentshn, hobn gehert az der melech fun Bavel hot oifgezetst Gedalyahu dem zun fun Achikamen ibern land, un az er hot gelozt unter im mener un vaiber un kinder, un fun di orime fun land, fun di vos zainen nisht fartriben gevorn kein Bavel; <verse eid="JER 40:7" /><verse number="8" style="v" sid="JER 40:8" />un zei zainen gekumen tsu Gedalyahn kein Mitspah: Yishmael der zun fun Netanyahun, un Yochanan un Yonatan di zin fun Kareachn, un Serayah der zun fun Tanchumetn, un di zin fun Efain fun Netofah, un Yezanyah der zun fun dem Maachati, zei mit zeyere mentshn. <verse eid="JER 40:8" /><verse number="9" style="v" sid="JER 40:9" />un Gedalyahu der zun fun Achikam dem zun fun Shafanen hot geshvorn zei un zeyere mentshn, azoi tsu zogn: ir zolt nisht moire hobn tsu dinen di Kasdim. zitst in land, un dint dem melech fun Bavel, un aich vet zain gut. <verse eid="JER 40:9" /><verse number="10" style="v" sid="JER 40:10" />un ich, ot blaib ich in Mitspah tsu shtein far di Kasdim vos veln kumen tsu undz; un ir zamlt ain vain, un zumeroibs, un eil, un tut arain in aiere keilim, un zitst in aiere shtet vos ir hot farchapt. <verse eid="JER 40:10" /><verse number="11" style="v" sid="JER 40:11" />un oich ale Yidn vos in Moav, un tsvishn di kinder fun Amon, un in Edom, un di vos in ale lender, hobn gehert az der melech fun Bavel hot gelozt an iberblaib fun Yehudah, un az er hot oifgezetst iber zei Gedalyahu dem zun fun Achikam dem zun fun Shafanen. <verse eid="JER 40:11" /><verse number="12" style="v" sid="JER 40:12" />un ale Yidn hobn zich umgekert fun ale erter vos zei zainen farshtoisen gevorn ahin, un zei zainen gekumen kein land Yehudah tsu Gedalyahun kein Mitspah; un zei hobn aingezamlt vain un zumeroibs zeyer fil.<verse eid="JER 40:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13" />un Yochanan der zun fun Kareachn, un ale hoiptlait fun cheil vos oifn feld, zainen gekumen tsu Gedalyahun kein Mitspah, <verse eid="JER 40:13" /><verse number="14" style="v" sid="JER 40:14" />un zei hobn tsu im gezogt: tsi veisn veistu az Baalis der melech fun di kinder fun Amon hot geshikt Yishmael dem zun fun Netanyahn tsu nemen dain lebn? ober Gedalyahu der zun fun Achikamen hot zei nisht gegloibt. <verse eid="JER 40:14" /><verse number="15" style="v" sid="JER 40:15" />hot Yochanan der zun fun Kareachn gezogt tsu Gedalyahun in farborgenish in Mitspah, azoi tsu zogn: lomich gein, ich bet dich, un ich vel dershlogn Yishmael dem zun fun Netanyahn, un kein mentsh vet nisht visen. noch vos zol er dir nemen dos lebn, un gants Yehudah vos zainen aingezamlt arum dir, veln tseshpreit vern, un der iberblaib fun Yehudah vet untergein? <verse eid="JER 40:15" /><verse number="16" style="v" sid="JER 40:16" />ober Gedalyahu der zun fun Achikamen hot gezogt tsu Yochanan dem zun fun Kareachn: zolst nisht ton di dozike zach, vorem lign zogstu oif Yishmaeln.<verse eid="JER 40:16" /></para>
  <chapter eid="JER 40" />
  <chapter number="41" style="c" pubnumber="מא" sid="JER 41" />
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1" />un es iz geven in zibetn choidesh, iz gekumen Yishmael der zun fun Netanyah dem zun fun Elishamaen fun kiniglechn opshtam, un di groise lait fun dem melech, un tsen man mit im, tsu Gedalyahu dem zun fun Achikamen kein Mitspah, un zei hobn dortn gegesn broit in einem in Mitspah. <verse eid="JER 41:1" /><verse number="2" style="v" sid="JER 41:2" />iz oifgeshtanen Yishmael der zun fun Netanyahn, un di tsen man vos mit im, un zei hobn geshlogn Gedalyahu dem zun fun Achikam dem zun fun Shafanen mitn shverd; un er hot im geteit – dem vos der melech fun Bavel hot oifgezetst ibern land. <verse eid="JER 41:2" /><verse number="3" style="v" sid="JER 41:3" />oich ale Yidn vos zainen geven mit im, mit Gedalyahun, in Mitspah, un di Kasdim vos hobn zich dortn gefunen, di milchome-lait, hot Yishmael dershlogn.<verse eid="JER 41:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4" />un es iz geven oifn tsveitn tog nochn teitn Gedalyahun, ven kein mentsh hot noch nisht gevust, <verse eid="JER 41:4" /><verse number="5" style="v" sid="JER 41:5" />zainen ongekumen mentsh fun Shechem, fun Shiloh, un fun Shomron, achtsik man mit opgegolte Baiserd, un tserisene kleider un shnitn oifn laib; mit shpaizopfer un vairech in zeyer hant, oif tsu brengen in hoiz fun Hashem. <verse eid="JER 41:5" /><verse number="6" style="v" sid="JER 41:6" />iz aroisgegangen Yishmael der zun fun Netanyahn zei antkegen fun Mitspah, gegangen un geyendik geveint; un es iz geven, vi er hot zei bagegent, azoi hot er tsu zei gezogt: kumt tsu Gedalyahu dem zun fun Achikamen. <verse eid="JER 41:6" /><verse number="7" style="v" sid="JER 41:7" />iz, vi zei zainen araingekumen in mitn shtot, azoi hot Yishmael der zun fun Netanyahn zei geshochtn in der grub arain, er un di mentshn vos mit im. <verse eid="JER 41:7" /><verse number="8" style="v" sid="JER 41:8" />un tsen man hobn zich gefunen tsvishn zei, vos hobn gezogt tsu Yishmaeln: teit undz nisht vorem mir hobn, bahaltn in feld, veits un gershtn un eil un honik. hot er zich opgehaltn, un hot zei nisht geteit tsvishn zeyere brider.<verse eid="JER 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 41:9" />un di grub vos Yishmael hot ahin araingevorfn di toite laiber fun di mentshn vos er hot dershlogn tsulib Gedalyahun, dos iz geven di vos der melech Asa hot gemacht ois moire far Baasha dem melech fun Yisroel; zi hot Yishmael der zun fun Netanyahun ongefilt mit dershlogene. <verse eid="JER 41:9" /><verse number="10" style="v" sid="JER 41:10" />un Yishmael hot gefangen dem gantsn iberblaib fun folk vos in Mitspah, di techter fun melech, un dos gantse folk vos zainen geblibn in Mitspah, vos Nevuzaradan dem hoipt fun dem laib-cheil hot gelozn unter Gedalyahu dem zun fun Achikamen; hot zei Yishmael der zun fun Netanyahn gefangen, un er iz avek aribertsugein tsu di kinder fun Amon.<verse eid="JER 41:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11" />hot gehert Yochanan der zun fun Kareachn, un ale hoiptlait fun cheil vos mit im, dos gantse beiz vos Yishmael der zun fun Netanyahn hot opgeton. <verse eid="JER 41:11" /><verse number="12" style="v" sid="JER 41:12" />un zei hobn genumen ale mener, un zainen gegangen milchome haltn mit Yishmael dem zun fun Netanyahn, un hobn im gefunen baim groisn vaser vos in Givon. <verse eid="JER 41:12" /><verse number="13" style="v" sid="JER 41:13" />un es iz geven, vi dos gantse folk mit Yishmaeln hobn derzen Yochanan dem zun fun Kareachn, un ale hoiptlait fun cheil mit im, azoi hobn zei zich derfreit. <verse eid="JER 41:13" /><verse number="14" style="v" sid="JER 41:14" />un dos gantse folk vos Yishmael hot genumen gefangen fun Mitspah, hobn zich oisgedreit un zich umgekert, un zainen avekgegangen tsu Yochanan dem zun fun Kareachn. <verse eid="JER 41:14" /><verse number="15" style="v" sid="JER 41:15" />un Yishmael der zun fun Netanyahn iz antrunen gevorn fun Yochananen, mit acht man, un iz avek tsu di kinder fun Amon.<verse eid="JER 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16" />un Yochanan der zun fun Kareachn, un ale hoiptlait fun cheil vos mit im, hobn genumen dem gantsn iberblaib fun dem folk vos er hot umgekert fun Yishmael dem zun fun Netanyahn, fun Mitspah, nochdem vi yener hot dershlogn Gedalyah dem zun fun Achikamen – di mener di milchome-lait, un di vaiber, un di kinder, un di hoifdiner, vos er hot umgekert fun Givon; <verse eid="JER 41:16" /><verse number="17" style="v" sid="JER 41:17" />un zei zainen gegangen, un zainen gezesn in Grut-Kimham vos bai Beis-Lechem, kedei tsu gein kumen kein Mitsrayim. <verse eid="JER 41:17" /><verse number="18" style="v" sid="JER 41:18" />fun vegen di Kasdim: vorem zei hobn moire gehat far zei, vail Yishmael der zun fun Netanyahn hot dershlogn Gedalyahu dem zun fun Achikamen, vos der melech fun Bavel hot oifgezetst ibern land.<verse eid="JER 41:18" /></para>
  <chapter eid="JER 41" />
  <chapter number="42" style="c" pubnumber="מב" sid="JER 42" />
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1" />un ale hoiptlait fun cheil, un Yochanan der zun fun Kareachn, un Yezanyah der zun fun Hoshayahn, un dos gantse folk fun klein biz grois, hobn genent, <verse eid="JER 42:1" /><verse number="2" style="v" sid="JER 42:2" />un hobn gezogt tsu Yirmeyah hanovi: zol, ich bet dich, faln undzer gebet far dir, un zei mispalel tsu Hashem dain G-t far undz, far dem dozikn gantsn iberblaib, vorem mir zainen fun fil geblibn vintsik, azoi vi daine oign zeen undz. <verse eid="JER 42:2" /><verse number="3" style="v" sid="JER 42:3" />un zol Hashem dain Elokim undz zogn dem veg vos mir zoln oif im gein, un di zach vos mir zoln ton. <verse eid="JER 42:3" /><verse number="4" style="v" sid="JER 42:4" />hot Yirmeyah hanovi tsu zei gezogt: ich hob gehert; ot bin ich mispalel tsu Hashem Elokeichem, azoi vi aiere verter; un es vet zain, itlech vort vos Hashem vet aich entfern, vel ich aich dertseiln; ich vel nisht farmaidn fun aich a vort. <verse eid="JER 42:4" /><verse number="5" style="v" sid="JER 42:5" />hobn zei gezogt tsu Yirmeyahun: zol Hashem zain an emeser un bagloibter eides akegn undz, oib nisht azoi vi itlech vort mit vos Hashem dain G-t vet dich shikn tsu undz, azoi veln mir ton. <verse eid="JER 42:5" /><verse number="6" style="v" sid="JER 42:6" />sai gut un sai shlecht veln mir tsuhern tsu dem kol fun Hashem Elokeinu, vos mir shikn dich tsu im; kedei undz zol gut zain, az mir veln tsuhern tsu dem kol fun Hashem Elokeinu.<verse eid="JER 42:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7" />un es iz geven tsum sof fun tsen teg, iz dos vort fun Hashem geven tsu Yirmeyahun. <verse eid="JER 42:7" /><verse number="8" style="v" sid="JER 42:8" />un er hot gerufn Yochanan dem zun fun Kareachn, un ale hoiptlait fun cheil vos mit im, un dos gantse folk oifen klein biz grois. <verse eid="JER 42:8" /><verse number="9" style="v" sid="JER 42:9" />un er hot tsu zei gezogt: azoi hot gezogt Hashem Elokei Yisroel, vos ir hot mich tsu im geshikt, tsu machn faln aier gebet far im: <verse eid="JER 42:9" /><verse number="10" style="v" sid="JER 42:10" />oib blaibn vet ir blaibn in dem dozikn land vel ich aich oifboien un nisht tseshtern, un vel aich ainflantsn un nisht oisraisn, vorem ich hob charote oif dem beiz vos ich hob aich geton. <verse eid="JER 42:10" /><verse number="11" style="v" sid="JER 42:11" />ir zolt nisht moire hobn far dem melech fun Bavel, vos ir hot moire far im; ir zolt nisht moire hobn far im, zogt Hashem, vorem ich bin mit aich, aich tsu helfn, un aich matsl tsu zain fun zain hant. <verse eid="JER 42:11" /><verse number="12" style="v" sid="JER 42:12" />un ich vel aich gebn derbaremung, un er vet aich derbaremen, un vet aich umkeren oif aier erd. <verse eid="JER 42:12" /><verse number="13" style="v" sid="JER 42:13" />oib ober ir zogt: mior veln nisht blaibn in dem dozikn land – nisht tsutsuhern tsu dem kol fun Hashem Elokeichem, <verse eid="JER 42:13" /><verse number="14" style="v" sid="JER 42:14" />azoi tsu zogn: nein, naiert kein land Mitsrayim veln mir gein, vu mir veln nisht zen kein milchome, un nisht hern dem kol fun a shoifer, un mir veln nisht hungern noch broit; un dortn veln mir voinen – <verse eid="JER 42:14" /><verse number="15" style="v" sid="JER 42:15" />to atsund hert derum dos vort fun Hashem, ir iberblaib fun Yehudah: azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: oib kern vet ir kern aier ponem tsu kumen kein Mitsrayim, un ir vet kumen voinen dortn, <verse eid="JER 42:15" /><verse number="16" style="v" sid="JER 42:16" />iz, di shverd vos ir hot moire far ir, vet aich dortn dergreichn in land Mitsrayim, un der hunger far velchn ir zent bazorgt, vet aich onyogn dortn in Mitsrayim, un dortn vet ir shtarbn. <verse eid="JER 42:16" /><verse number="17" style="v" sid="JER 42:17" />un geshen vet mit ale mentshn vos hobn gekert zeyer ponem tsu kumen kein Mitsrayim, tsu voinen dortn, az zei veln shtarbn durch der shverd, durch hunger, un durch der pest, un fun zei vet nisht zain a geblibener oder antrunener, fun vegen dem beiz vos ich breng oif zei.<verse eid="JER 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 42:18" />vorem azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: azoi vi main kaas un main grimtsorn iz oisgegosen gevorn oif di bavoiner fun Yerushalayim, azoi vet oisgegosen vern main grimtsorn oif aich, ven ir kumt kein Mitsrayim, un ir vet zain far a fluch, un far a shrek, un far a klole, un far a shand; un ir vet mer nisht onzen dem dozikn ort. <verse eid="JER 42:18" /><verse number="19" style="v" sid="JER 42:19" />Hashem hot ongezogt vegen aich, ir iberblaib fun Yehudah: ir zolt nisht gein kein Mitsrayim; visen zolt ir visen zain az ich hob aich haint gevornt. <verse eid="JER 42:19" /><verse number="20" style="v" sid="JER 42:20" />vorem ir hot an opnar bagangen akegn aier zel, ven ir hot mich geshikt tsu Hashem Elokeichem, azoi tsu zogn: zai mispalel far undz tsu Hashem Elokeinu, un azoi vi alts vos Hashem Elokeinu vet heisn, azoi zog undz, un mir veln ton. <verse eid="JER 42:20" /><verse number="21" style="v" sid="JER 42:21" />un ich hob aich haint gezogt, ober ir hert nisht tsu dem kol fun Hashem Elokeichem, un tsu alts mit vos er hot mich geshikt tsu aich. <verse eid="JER 42:21" /><verse number="22" style="v" sid="JER 42:22" />un atsund visen zolt ir visen zain, az fun shverd, fun hunger, un fun pest vet ir shtarbn in dem ort vos ir vilt kumen voinen dortn.<verse eid="JER 42:22" /></para>
  <chapter eid="JER 42" />
  <chapter number="43" style="c" pubnumber="מג" sid="JER 43" />
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1" />un es iz geven, vi Yirmeyah hot geendikt redn tsum gantsn folk ale verter fun Hashem zeyer G-t, mit vos Hashem zeyer G-t hot im geshikt tsu zei, alts di doziker verter, <verse eid="JER 43:1" /><verse number="2" style="v" sid="JER 43:2" />azoi hot geredt Azaryah der zun fun Hoshayahn, un Yochanan der zun fun Kareachn, un ale mutvilike lait, zogndik tsu Yirmeyahun: lign zogstu! nisht Hashem Elokeinu hot dich geshikt azoi tsu zogn: ir zolt nisht kumen kein Mitsrayim tsu voinen dortn; <verse eid="JER 43:2" /><verse number="3" style="v" sid="JER 43:3" />naiert Baruch der zun fun Neriyahn redt dich on oif undz, kedei undz ibertsugebn in der hant fun di Kasdim undz tsu teitn, oder undz tsu fartraiben kein Bavel. <verse eid="JER 43:3" /><verse number="4" style="v" sid="JER 43:4" />un Yochanan der zun fun Kareachn, un ale hoiptlait fun cheil, un dos gantse folk, hobn nisht tsugehert tsu dem kol fun Hashem, tsu blaibn in land Yehudah. <verse eid="JER 43:4" /><verse number="5" style="v" sid="JER 43:5" />un Yochanan der zun fun Kareachn, un ale hoiptlait fun cheil, hobn genumen dem gantsn iberblaib fun Yehudah vos hobn zich umgekert fun ale felker vos zei zainen farshtoisen gevorn ahin, kedei tsu voinen in land Yehudah: <verse eid="JER 43:5" /><verse number="6" style="v" sid="JER 43:6" />di mener, un di vaiber, un di kinder, un dem melechs techter, un ale nefoshes vos Nevuzaradan der hoipt fun dem laib-kol hot gelozt mit Gedalyahu dem zun fun Achikam dem zun fun Shafanen, un Yirmeyah henvin, un Baruch dem zun fun Neriyahun; <verse eid="JER 43:6" /><verse number="7" style="v" sid="JER 43:7" />un zei zainen gekumen kein land Mitsrayim; vorem zei hobn nisht tsugehert tsu dem kol fun Hashem; un zei zainen gekumen biz Tachpanches.<verse eid="JER 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 43:8" />un dos vort fun Hashem iz geven tsu Yirmeyahun in Tachpanches, azoi tsu zogn: <verse eid="JER 43:8" /><verse number="9" style="v" sid="JER 43:9" />nem mit dain hant groise shteiner, un zolst zei bahaltn in vapne, in dem tsiglflaster vos baim aingang fun Pharaohs hoiz in Tachpanches, far di oign fun di mener fun Yehudah; <verse eid="JER 43:9" /><verse number="10" style="v" sid="JER 43:10" />un zolst zogn tsu zei: azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: ze, ich shik un vel nemen Nevuchadretsar dem melech fun Bavel, main knecht, un ich vel shteln zain tron iber di dozike shteiner vos ich hob bahaltn, un er vet oisshpreitn zain prachtgetselt iber zei. <verse eid="JER 43:10" /><verse number="11" style="v" sid="JER 43:11" />un er vet kumen, un vet shlogn dos land Mitsrayim; vemen tsum toit tsum toit, un vemen tsu gefangenshaft tsu gefangenshaft, un vemen tsum shverd tsum shverd. <verse eid="JER 43:11" /><verse number="12" style="v" sid="JER 43:12" />un ich vel ontsindn a faier in di haizer fun di g‑ter fun Mitsrayim; un er vet zei farbrenen, oder zei nemen gefangen; un er vet tsunoifviklen dos land Mitsrayim, vi a pastuch vikl tsunoif zain beged; un er vet arois fun dortn besholem. <verse eid="JER 43:12" /><verse number="13" style="v" sid="JER 43:13" />un er vet tsebrechn di zailshteiner fun Beis-Shemesh vos in land Mitsrayim; un di haizer fun di g‑ter fun Mitsrayim vet er farbrenen in faier.<verse eid="JER 43:13" /></para>
  <chapter eid="JER 43" />
  <chapter number="44" style="c" pubnumber="מד" sid="JER 44" />
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1" />dos vort fun Hashem vos iz geven tsu Yirmeyahun vegen ale Yidn vos zainen gezesn in land Mitsrayim, di vos zainen gezesn in Migdol, un in Tachpanches, un in Nof, un in land Patros, azoi tsu zogn: <verse eid="JER 44:1" /><verse number="2" style="v" sid="JER 44:2" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel: ir hot gezen dos gantse beiz vos ich hob gebracht oif Yerushalayim, un oif ale shtet fun Yehudah; un ot zainen zei a vistenish haintikn tog, un keiner voint nisht in zei; <verse eid="JER 44:2" /><verse number="3" style="v" sid="JER 44:3" />fun vegen zeyer beiz vos zei hobn geton, mich tsu dertserenen, tsu gein reichern un dinen tsu fremde g‑ter vos nisht zei hobn zei gekent, nisht ir, un nisht aiere eltern. <verse eid="JER 44:3" /><verse number="4" style="v" sid="JER 44:4" />un ich hob tsu aich geshikt ale maine knecht di neviim, nochanand un nochanand geshikt, azoi tsu zogn: ir zolt nisht ton di dozike umverdike zach vos ich hob faint. <verse eid="JER 44:4" /><verse number="5" style="v" sid="JER 44:5" />ober zei hobn nisht tsugehert un nisht tsugenaigt zeyer oier un zich umkeren fun zeyer shlechtikeit, nisht tsu reichern tsu fremde g‑ter. <verse eid="JER 44:5" /><verse number="6" style="v" sid="JER 44:6" />un main grimtsorn un main kaas iz oisgegosen gevorn, un hot gebrent in di shtet fun Yehudah, un in di gasn fun Yerushalayim, un zei zainen gevorn a churvn, a vistenish, azoi vi haintikn tog. <verse eid="JER 44:6" /><verse number="7" style="v" sid="JER 44:7" />un atsund hot azoi gezogt Hashem Elokei Tseva'ot, Elokei Yisroel: tsu vos tut ir aich alein a groise roe, me zol aich farshnaidn man un vaib, kind un brustkind, fun tsvishn Yehudah, un nisht tsu lozn an iberblaib? <verse eid="JER 44:7" /><verse number="8" style="v" sid="JER 44:8" />mich tsu dertserenen mit di verk fun aiere hent, tsu reichern tsu fremde g‑ter in land Mitsrayim, vu ir zait gekumen voinen, kedei me zol aich farshnaidn, un kedei ir zolt vern far a klole un far a shand tsvishn ale felker fun der erd. <verse eid="JER 44:8" /><verse number="9" style="v" sid="JER 44:9" />hot ir fargesen di shlechtikeit fun aiere eltern, un di shlechtikeit fun di mlochim fun Yehudah, un di shlechtikeit fun zeyere vaiber, un aiere shlechtikeit, un di shlechtikeit fun aiere vaiber, vos zei hobn geton in land Yehudah, un in di gasn fun Yerushalayim? <verse eid="JER 44:9" /><verse number="10" style="v" sid="JER 44:10" />zei zainen nisht untertenik gevorn biz oif haintikn tog, un zei hobn nisht moire gehat, un zainen nisht gegangen in main toyre un in maine gezetsn vos ich hob geleigt far aich un far aiere eltern.<verse eid="JER 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11" />derum hot azoi gezogt Hashem Tseva'ot, Elokei Yisroel: zet, ich ker main ponem oif aich tsum shlecht, un tsu farshnaidn gants Yehudah. <verse eid="JER 44:11" /><verse number="12" style="v" sid="JER 44:12" />un ich vel nemen dem iberblaib fun Yehudah vos hobn gekert zeyer ponem tsu kumen kein land Mitsrayim tsu voinen dortn, un ale veln farlendt vern; in land Mitsrayim veln zei faln; fun shverd, fun hunger, veln zei farlendt vern; fun klein biz grois, fun shverd un fun hunger veln zei shtarbn; un zei veln zain far a fluch, un far a shrek, un far a klole, un far a shand. <verse eid="JER 44:12" /><verse number="13" style="v" sid="JER 44:13" />un ich vel zich oprechenen mit di vos zitsn in land Mitsrayim, vi ich hob zich opgerechnt mit Yerushalayim, mit shverd, mit hunger, un mit pest. <verse eid="JER 44:13" /><verse number="14" style="v" sid="JER 44:14" />un fun dem resht fun Yehudah vos kumen kein land Mitsrayim tsu voinen dortn, vet nisht zain a geblibener oder antrunener zich umtsukeren kein land Yehudah, vos zeyer harts tsit zei zich vider tsu bazetsn dortn; vorem zei veln zich nisht umkeren, tsu mol vi antrunene.<verse eid="JER 44:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15" />hobn geentfert Yirmeyahun ale mener vos hobn gevust az zeyer vaiber reichern tsu fremde g‑ter, un ale vaiber vos zainen geshtanen arum, a grois gezeml, un dos gantse folk vos zainen gezesn in land Mitsrayim, in Patros, azoi tsu zogn: <verse eid="JER 44:15" /><verse number="16" style="v" sid="JER 44:16" />dos vort vos du host geredt tsu undz in nomen fun Hashem, hern mir dir nisht tsu. <verse eid="JER 44:16" /><verse number="17" style="v" sid="JER 44:17" />naiert ton veln mir ton itlech vort vos iz arois fun undzer moil, tsu reichern tsu der malke fun himel, un gisn tsu ir gisopfer, azoi vi mir hobn geton, mir un undzere eltern, undzere mlochim un undzere harn, in di shtet fun Yehudah, un in di gasn fun Yerushalayim; un mir hobn gehat broit tsu zat, un undz iz geven gut, un shlechts hobn mir nisht ongezen. <verse eid="JER 44:17" /><verse number="18" style="v" sid="JER 44:18" />un fun zint mir hobn oifgehert reichern tsu der malke fun himel, un gisn tsu ir gisopfer, zainen mir geminert fun alts, un fun shverd un fun hunger vern mir farlendt. <verse eid="JER 44:18" /><verse number="19" style="v" sid="JER 44:19" />un az mir hobn gereichert tsu der malke fun himel, un gegosn tsu ir gisopfer, hobn mir den on undzere manen ir gemacht kuchns in ir geshtalt, un gegosn tsu ir gisopfer?<verse eid="JER 44:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20" />hot Yirmeyah gezogt tsum gantsn folk – tsu di mener un tsu di vaiber tsu dem gantsn folk vos hobn im gegebn an entfer – azoi tsu zogn: <verse eid="JER 44:20" /><verse number="21" style="v" sid="JER 44:21" />far vor, di reicherung vos ir hot gereichert in di shtet fun Yehudah, un in di gasn fun Yerushalayim, ir un aiere eltern, aiere mlochim un aiere harn, un dos folk fun land, deron hot Hashem gedacht, un es iz im aroifgekumen oifn zinen; <verse eid="JER 44:21" /><verse number="22" style="v" sid="JER 44:22" />un Hashem hot mer nisht gekent fartrogen, fun vegen aiere beize meisim, fun vegen di umverdikeitn vos ir hot geton, un aier land iz gevorn far a vistenish, un far a shrek, un far a klole, on a bavoiner, azoi vi haintikn tog. <verse eid="JER 44:22" /><verse number="23" style="v" sid="JER 44:23" />vail ir hot gereichert, un vail ir hot gezindikt tsu Hashem, un hot nisht tsugehert tsu dem kol fun Hashem, un in zain toyre un in zaine gezetsn un in zaine tseignim zait ir nisht gegangen, derum hot aich getrofn dos dozike beiz, azoi vi haintikn tog.<verse eid="JER 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24" />un Yirmeyah hot gezogt tsum gantsn folk, un tsu ale vaiber: hert dos vort fun Hashem, ir gants Yehudah vos in land Mitsrayim. <verse eid="JER 44:24" /><verse number="25" style="v" sid="JER 44:25" />azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel, azoi tsu zogn: ir un aiere vaiber hot i geredt mit aier moil, i mit aiere hent derfilt, azoi tsu zogn: ton veln mir ton undzere nedrim vos mir hobn a neyder geton, tsu reichern tsu der malke fun himel, un tsu gisn tsu ir gisopfer; mekayem muzt ir mekayem zain aiere nedrim, un ton muzt ir ton aiere nedrim! <verse eid="JER 44:25" /><verse number="26" style="v" sid="JER 44:26" />derum hert dos vort fun Hashem, ir gants Yehudah vos zitst in land Mitsrayim, ot shver ich bai main groisn nomen, zogt Hashem, oib main nomen vet mer gerufn vern fun dem moil fun a shum mentshn fun Yehudah in gantsn land Mitsrayim, vos zol zogn: azoi vi Adonoi Hashem lebt! <verse eid="JER 44:26" /><verse number="27" style="v" sid="JER 44:27" />ze, ich pas-oif oif zei tsum beizn un nisht tsum gutn; un umkumen veln ale mener fun Yehudah vos in land Mitsrayim fun shverd un fun hunger, biz zei veln farlendt vern. <verse eid="JER 44:27" /><verse number="28" style="v" sid="JER 44:28" />un antrunene fun shverd veln zich umkeren fun land Mitsrayim kein land Yehudah, getseilte mentshn; un visen vet der gantser iberblaib fun Yehudah vos zainen gekumen kein land Mitsrayim tsu voinen dortn, vemes vort vet mekayem vern, mains oder zeyers. <verse eid="JER 44:28" /><verse number="29" style="v" sid="JER 44:29" />un dos iz aich a tseichn, zogt Hashem, az ich rechn zich op mit aich in dem dozikn ort, kedei ir zolt visen az mekayem veln mekayem vern maine verter oif aich tsum beizn; <verse eid="JER 44:29" /><verse number="30" style="v" sid="JER 44:30" />azoi hot Hashem gezogt: ze, ich gib iber Pharaoh Chofra dem melech fun Mitsrayim in der hant fun zaine faint, un in der hant fun di vos zuchn zain lebn, vi ich hob ibergegebn Tsidkiyah dem melech fun Yehudah in der hant fun Nevuchadretsar dem melech fun Bavel, zain faint un der vos hot gezucht zain lebn.<verse eid="JER 44:30" /></para>
  <chapter eid="JER 44" />
  <chapter number="45" style="c" pubnumber="מה" sid="JER 45" />
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1" />dos vort vos Yirmeyah hanovi hot geredt tsu Baruch dem zun fun Neriyahn, ven er hot oifgeshribn di dozike verter oif a buch fun Yirmeyahs moil, in firtn yor fun Yhoyakim dem zun fun Yoshiyahun, dem melech fun Yehudah, azoi tsu zogn: <verse eid="JER 45:1" /><verse number="2" style="v" sid="JER 45:2" />azoi hot gezogt Hashem Elokei Yisroel vegen dir, Baruch: <verse eid="JER 45:2" /><verse number="3" style="v" sid="JER 45:3" />host gezogt: o vei iz mir! vorem Hashem hot gemert kumer oif main veitik; ich bin mid fun main ziftsn, un gefin nisht kein ru.<verse eid="JER 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 45:4" />azoi zolst zogn tsu im: azoi hot Hashem gezogt: ze, vos ich hob geboit tseshter ich, un vos ich hob geflantst rais ich ois; un azoi iz dos in gantsn land. <verse eid="JER 45:4" /><verse number="5" style="v" sid="JER 45:5" />un du farlangt dir groise zachn? zolst nisht farlangen. vorem ze, ich breng an umglik oif ale laiber, zogt Hashem; ober dir vel ich gebn dain nefesh tsum gevins, in ale erter vos du vest gein ahin.<verse eid="JER 45:5" /></para>
  <chapter eid="JER 45" />
  <chapter number="46" style="c" pubnumber="מו" sid="JER 46" />
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1" />vos dos vort fun Hashem iz geven tsu Yirmeyah hanovi oif di felker.<verse eid="JER 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 46:2" />oif Mitsrayim: oif dem cheil fun Pharaoh-Necho dem melech fun Mitsrayim, vos iz geven baim taich Parat in Karkemish, vos Nevuchadretsar der melech fun Bavel hot geshlogn in firtn yor fun Yhoyakim dem zun fun Yoshiyahun, dem melech fun Yehudah.<verse eid="JER 46:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JER 46:3" />breit on shild un sheld,</para>
  <para style="q" vid="JER 46:3">un genent oif milchome!<verse eid="JER 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 46:4" />shpant di ferd,</para>
  <para style="q" vid="JER 46:4">un zetst zich aroif, ir raiter,</para>
  <para style="q" vid="JER 46:4">un shtelt zich ois in di kivers;</para>
  <para style="q" vid="JER 46:4">shlaift di shpizn,</para>
  <para style="q" vid="JER 46:4">tut on di vofnkleider!<verse eid="JER 46:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 46:5" />far vos ze ich zei dershrokene optretn ahinter?</para>
  <para style="q" vid="JER 46:5">un zeyere giborim vern tseklapt,</para>
  <para style="q" vid="JER 46:5">un loifn in gelaf, un kern zich nisht um;</para>
  <para style="q" vid="JER 46:5">a shrek rund arum,</para>
  <para style="qr" vid="JER 46:5">zogt Hashem.<verse eid="JER 46:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 46:6" />der flinker ken nisht antloifn,</para>
  <para style="q" vid="JER 46:6">un der gibor ken nisht antrunen vern;</para>
  <para style="q" vid="JER 46:6">in tsofn baim breg fun taich Parat</para>
  <para style="q" vid="JER 46:6">vern zei geshtroichlt un faln.<verse eid="JER 46:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 46:7" />ver iz der vos geit oif vi der Nilus,</para>
  <para style="q" vid="JER 46:7">vos vi shtromen shturemen zaine vaser?<verse eid="JER 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 46:8" />Mitsrayim geit oif vi der Nilus,</para>
  <para style="q" vid="JER 46:8">un vi shtromen shturemen di vasern;</para>
  <para style="q" vid="JER 46:8">un er zogt: ich vel oifgein,</para>
  <para style="q" vid="JER 46:8">ich vel badekn di erd,</para>
  <para style="q" vid="JER 46:8">ich vel unterbrengen di shtot un di voiner in ir.<verse eid="JER 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 46:9" />shpringt oif, ir ferd,</para>
  <para style="q" vid="JER 46:9">un vildevet, ir raitvegn,</para>
  <para style="q" vid="JER 46:9">un zoln aroisgein di giborim,</para>
  <para style="q" vid="JER 46:9">Kush un Put vos haltn a sheld,</para>
  <para style="q" vid="JER 46:9">un di Ludim vos haltn – shpanen a boign.<verse eid="JER 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 46:10" />un yener tog vet zain far Adonoi Hashem Tseva'ot</para>
  <para style="q" vid="JER 46:10">a tog fun nekome</para>
  <para style="q" vid="JER 46:10">zich noikem tsu zain on zaine faint;</para>
  <para style="q" vid="JER 46:10">un esen vet di shverd un zich zetn,</para>
  <para style="q" vid="JER 46:10">un zich ontrinken mit zeyer blut;</para>
  <para style="q" vid="JER 46:10">vorem a shlachtung iz bai Adonoi Hashem Tseva'ot</para>
  <para style="q" vid="JER 46:10">in tsofn-land baim taich Parat.<verse eid="JER 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 46:11" />gei aroif kein Gilad, un nem balzam,</para>
  <para style="q" vid="JER 46:11">yungfroi tochter Mitsrayim;</para>
  <para style="q" vid="JER 46:11">umzist hostu refuus gemert,</para>
  <para style="q" vid="JER 46:11">nishto kein genezung far dir.<verse eid="JER 46:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 46:12" />gehert hobn di felker dain shand,</para>
  <para style="q" vid="JER 46:12">un mit dain geshrei iz ful di erd;</para>
  <para style="q" vid="JER 46:12">vorem a gibor on a gibor hot geshtroichlt,</para>
  <para style="q" vid="JER 46:12">in einem gefaln zainen zei beide.<verse eid="JER 46:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13" />dos vort vos Hashem hot geredt tsu Yirmeyah hanovi vegen dem kumen fun Nevuchadretsar dem melech fun Bavel tsu shlogn Mitsrayim:<verse eid="JER 46:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 46:14" />zogt on in Mitsrayim, un macht hern in Migdol,</para>
  <para style="q" vid="JER 46:14">un macht hern in Nof un Tachpanches;</para>
  <para style="q" vid="JER 46:14">zogt: shtel zich un breit dich on,</para>
  <para style="q" vid="JER 46:14">vorem di shverd fartsert rund arum dir.<verse eid="JER 46:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 46:15" />far vos iz dain shtarker andergevorfn gevorn?</para>
  <para style="q" vid="JER 46:15">er iz nisht bashtanen,</para>
  <para style="q" vid="JER 46:15">vorem Hashem hot im geshtoisn.<verse eid="JER 46:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 46:16" />er hot gemert di geshtroichlte;</para>
  <para style="q" vid="JER 46:16">yo, einer oifn andern zainen zei gefaln,</para>
  <para style="q" vid="JER 46:16">un zei hobn gezogt: shteit oif,</para>
  <para style="q" vid="JER 46:16">un lomir zich umkeren tsu undzer folk,</para>
  <para style="q" vid="JER 46:16">un tsum land fun undzer geburt,</para>
  <para style="q" vid="JER 46:16">fun vegen der shverd vos fartilikt.<verse eid="JER 46:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 46:17" />zei hobn dortn gerufn:</para>
  <para style="q" vid="JER 46:17">Pharaoh der melech fun Mitsrayim iz bloiz tuml;</para>
  <para style="q" vid="JER 46:17">er hot gelozt di tsait aribergein.<verse eid="JER 46:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 46:18" />azoi vi ich leb, zogt der kinig –</para>
  <para style="q" vid="JER 46:18">Hashem Tseva'ot iz zain nomen,</para>
  <para style="q" vid="JER 46:18">az vi Tavor tsvishn di berg,</para>
  <para style="q" vid="JER 46:18">un vi Karmel baim yam, vet er kumen.<verse eid="JER 46:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 46:19" />mach dir vander-keilim,</para>
  <para style="q" vid="JER 46:19">tochter bavuminerin fun Mitsrayim;</para>
  <para style="q" vid="JER 46:19">vorem Nof vet tsu vist vern,</para>
  <para style="q" vid="JER 46:19">un chorev zain on a bavoiner.<verse eid="JER 46:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JER 46:20" />a vundershein kalb iz Mitsrayim,</para>
  <para style="q" vid="JER 46:20">ober di shtechflig gekumen,</para>
  <para style="q" vid="JER 46:20">fun tsofn iz gekumen.<verse eid="JER 46:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 46:21" />afile ire gedungene krigslait in ir</para>
  <para style="q" vid="JER 46:21">zainen vi kelber geshtopte,</para>
  <para style="q" vid="JER 46:21">vorem zei oich hobn zich umgekert,</para>
  <para style="q" vid="JER 46:21">zei zainen antlofn in einem,</para>
  <para style="q" vid="JER 46:21">zei zainen nisht bashtanen;</para>
  <para style="q" vid="JER 46:21">vorem der tog fun zeyer broch iz gekumen oif zei,</para>
  <para style="q" vid="JER 46:21">di tsait fun zeyer rechnshaft.<verse eid="JER 46:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JER 46:22" />ir kol geit vi fun a shlang,</para>
  <para style="q" vid="JER 46:22">vorem mit cheil geit men,</para>
  <para style="q" vid="JER 46:22">un mit hek kumt men oif ir,</para>
  <para style="q" vid="JER 46:22">azoi vi holtsheker.<verse eid="JER 46:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 46:23" />zei hakn ois ir vald,</para>
  <para style="qr" vid="JER 46:23">zogt Hashem,</para>
  <para style="q" vid="JER 46:23">vi er iz nisht tsu derforshn;</para>
  <para style="q" vid="JER 46:23">vorem mer vi heisherikn zainen zei,</para>
  <para style="q" vid="JER 46:23">un nishto kein tsol tsu zei.<verse eid="JER 46:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 46:24" />gevorn tsu shand iz di tochter Mitsrayim,</para>
  <para style="q" vid="JER 46:24">gegebn in der hant fun dem folk fun tsofn.<verse eid="JER 46:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25" />gezogt hot Hashem Tseva'ot, Elokei Yisroel: ze, ich rechn zich op mit Amon fun No, un mit Pharaohn, un mit Mitsrayim, un mit ire g‑ter, un mit ire mlochim; i mit Pharaoh un mit di vos farzichern zich oif im. <verse eid="JER 46:25" /><verse number="26" style="v" sid="JER 46:26" />un ich vel zei gebn in der hant fun di vos zuchn zeyer lebn, un in der hant fun Nevuchadretsar dem melech fun Bavel, un in der hant fun zaine knecht; un dernoch vet zi bavoint vern, azoi vi in di teg fun a mol, zogt Hashem.<verse eid="JER 46:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="JER 46:27" />ober du zolst nisht moire hobn, main knecht Yaakov,</para>
  <para style="q" vid="JER 46:27">un zolst nisht angstn, Yisroel,</para>
  <para style="q" vid="JER 46:27">vorem ze, ich helf dich fun der vait,</para>
  <para style="q" vid="JER 46:27">un dain zomen fun land fun zeyer gefangenshaft;</para>
  <para style="q" vid="JER 46:27">Yaakov vet zich umkeren un in ru,</para>
  <para style="q" vid="JER 46:27">un zich bavizn in gringkeit,</para>
  <para style="q" vid="JER 46:27">un keiner vet im nisht shrekn.<verse eid="JER 46:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 46:28" />du zolst nisht moire hobn, main knecht Yaakov,</para>
  <para style="qr" vid="JER 46:28">zogt Hashem,</para>
  <para style="q" vid="JER 46:28">vorem ich bin mit dir.</para>
  <para style="q" vid="JER 46:28">vorem ich vel machn a farlendung fun ale felker</para>
  <para style="q" vid="JER 46:28">vos ich hob dich farshtoisen ahin,</para>
  <para style="q" vid="JER 46:28">ober fun dir vel ich kein farlendung nisht machn;</para>
  <para style="q" vid="JER 46:28">un ich vel dich shtrofn loit gerechtikeit,</para>
  <para style="q" vid="JER 46:28">ober fartiliken vel ich dich nisht fartiliken.<verse eid="JER 46:28" /></para>
  <chapter eid="JER 46" />
  <chapter number="47" style="c" pubnumber="מז" sid="JER 47" />
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1" />vos dos vort fun Hashem iz geven tsu Yirmeyah hanovi oif di Pelishtim, eider Pharaoh hot geshlogn Azah.<verse eid="JER 47:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JER 47:2" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 47:2">ze, vasern geyen oif fun tsofn,</para>
  <para style="q" vid="JER 47:2">un veln vern a fleitsiker taich,</para>
  <para style="q" vid="JER 47:2">un farfleitsn dos land un ir fulkeit,</para>
  <para style="q" vid="JER 47:2">di shtot un di voiner in ir;</para>
  <para style="q" vid="JER 47:2">un shraien veln di mentshn,</para>
  <para style="q" vid="JER 47:2">un yomern veln ale voiner fun land.<verse eid="JER 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 47:3" />iber dem tritgeplider fun di kloien fun zaine ogers,</para>
  <para style="q" vid="JER 47:3">iber dem raash fun zaine raitvegn,</para>
  <para style="q" vid="JER 47:3">dem tuml fun zaine reder,</para>
  <para style="q" vid="JER 47:3">kern zich eltern nisht tsu kinder,</para>
  <para style="q" vid="JER 47:3">fun ophentikeit.<verse eid="JER 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 47:4" />fun vegen dem tog vos kumt</para>
  <para style="q" vid="JER 47:4">tsu farvistn ale Pelishtim,</para>
  <para style="q" vid="JER 47:4">tsu farshnaidn fun Tsor un fun Tsidon</para>
  <para style="q" vid="JER 47:4">itlech geblibenem helfer;</para>
  <para style="q" vid="JER 47:4">vorem Hashem tut farvistn di Pelishtim,</para>
  <para style="q" vid="JER 47:4">dem resht fun indzel Kaftor.<verse eid="JER 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 47:5" />gekumen iz a plichenish oif Azah</para>
  <para style="q" vid="JER 47:5">farshnitn gevorn iz Ashkelon,</para>
  <para style="q" vid="JER 47:5">der resht fun zeyer tal.</para>
  <para style="q" vid="JER 47:5">biz vanen vestu zich dem laib shnaidn?<verse eid="JER 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 47:6" />vei, du shverd fun Hashem,</para>
  <para style="q" vid="JER 47:6">biz vi lang noch vestu nisht ruen?</para>
  <para style="q" vid="JER 47:6">ver aingeton in dain sheid,</para>
  <para style="q" vid="JER 47:6">baru zich un ver shtil.<verse eid="JER 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 47:7" />vi kenstu zain ruik?</para>
  <para style="q" vid="JER 47:7">az Hashem hot ir bafoiln;</para>
  <para style="q" vid="JER 47:7">oif Ashkelon un oifn bortn fun im,</para>
  <para style="q" vid="JER 47:7">ahin hot er zi bashert.<verse eid="JER 47:7" /></para>
  <chapter eid="JER 47" />
  <chapter number="48" style="c" pubnumber="מח" sid="JER 48" />
  <para style="p">
    <verse number="1" style="v" sid="JER 48:1" />oif Moav.</para>
  <para style="p" vid="JER 48:1">azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel:</para>
  <para style="b" vid="JER 48:1" />
  <para style="q" vid="JER 48:1">vei tsu Nevo, vorem zi iz farvist;</para>
  <para style="q" vid="JER 48:1">tsu shand, batsvungen, iz Kiryatayim,</para>
  <para style="q" vid="JER 48:1">tsu shand un tsebrochn iz misgob.<verse eid="JER 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 48:2" />nishto mer der loib fun Moav,</para>
  <para style="q" vid="JER 48:2">in Cheshbon hot men baklert beiz oif ir:</para>
  <para style="q" vid="JER 48:2">kumt, un lomir zi farshnaidn fun tsu zain a folk!</para>
  <para style="q" vid="JER 48:2">du oich, Madmein, vest shtil vern,</para>
  <para style="q" vid="JER 48:2">nochgein dir vet gein di shverd.<verse eid="JER 48:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JER 48:3" />a kol fun geshrei fun Choronayim:</para>
  <para style="q" vid="JER 48:3">a farvistung un a broch a groiser.<verse eid="JER 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 48:4" />tsebrochn gevorn iz Moav,</para>
  <para style="q" vid="JER 48:4">ire yunge lozn hern a geshrei.<verse eid="JER 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 48:5" />vorem dem oifgang fun Luchit</para>
  <para style="q" vid="JER 48:5">geit men aroif mit gevein oif gevein;</para>
  <para style="q" vid="JER 48:5">vorem dem oifgang fun Luchit</para>
  <para style="q" vid="JER 48:5">geit men aroif mit gevein oif gevein;</para>
  <para style="q" vid="JER 48:5">vorem oif dem aropgang fun Choronayim</para>
  <para style="q" vid="JER 48:5">hert men an angstgeshrei fun broch.<verse eid="JER 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 48:6" />antloift, ratevet aier nefesh,</para>
  <para style="q" vid="JER 48:6">un zait vi a tamarisk in der midber.<verse eid="JER 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 48:7" />vorem vail du host zich farzichert</para>
  <para style="q" vid="JER 48:7">oif daine oiftuen un oif daine oitseres,</para>
  <para style="q" vid="JER 48:7">vest du oich batsvungen vern;</para>
  <para style="q" vid="JER 48:7">un Kemosh vet in goles avek,</para>
  <para style="q" vid="JER 48:7">zaine prister un zaine harn in einem.<verse eid="JER 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 48:8" />un a farvister vet kumen oif itlecher shtot,</para>
  <para style="q" vid="JER 48:8">un kein shtot vet nisht antrunen vern;</para>
  <para style="q" vid="JER 48:8">un untergein vet der tal,</para>
  <para style="q" vid="JER 48:8">un fartilikt vern vet der ploin,</para>
  <para style="q" vid="JER 48:8">azoi vi Hashem hot gezogt.<verse eid="JER 48:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JER 48:9" />git fliglen tsu Moav,</para>
  <para style="q" vid="JER 48:9">vorem flien avekflien vet zi;</para>
  <para style="q" vid="JER 48:9">un ire shtet veln tsu vist vern,</para>
  <para style="q" vid="JER 48:9">on a bavoiner in zei.<verse eid="JER 48:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="JER 48:10" />farsholten der vos tut opgelozt di arbet fun Hashem, un farsholten der vos farmaidt zain shverd fun blut!<verse eid="JER 48:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JER 48:11" />ruik geven iz Moav fun zain yugnt on,</para>
  <para style="q" vid="JER 48:11">un opgezetst iz er oif zaine heivn,</para>
  <para style="q" vid="JER 48:11">un nisht ibergeleidikt gevorn fun keile in keile,</para>
  <para style="q" vid="JER 48:11">un in goles iz er nisht gegangen;</para>
  <para style="q" vid="JER 48:11">derfar hot zich opgeshtelt zain tem bai im,</para>
  <para style="q" vid="JER 48:11">un zain reyech hot zich nisht gebitn.<verse eid="JER 48:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="JER 48:12" />ober ze, teg kumen, zogt Hashem, un ich vel shikn tsu im umbaigers, un zei veln im umbaign, un zaine keilim veln zei oisleidikn, un zeyere krig veln zei tsebrechn. <verse eid="JER 48:12" /><verse number="13" style="v" sid="JER 48:13" />un Moav vet zich shemn mit Kemosh, vi dos hoiz fun Yisroel hot zich geshemt mit Beis-El zeyer farzicherung.<verse eid="JER 48:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 48:14" />vi kent ir zogn: giborim zainen mir,</para>
  <para style="q" vid="JER 48:14">un heldishe lait far milchome?<verse eid="JER 48:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 48:15" />farvist gevorn iz Moav,</para>
  <para style="q" vid="JER 48:15">un oif ire shtet iz men aroifgegangen;</para>
  <para style="q" vid="JER 48:15">un zaine geklibene yungen hobn genidert tsu der shechite,</para>
  <para style="q" vid="JER 48:15">zogt der kinig – Hashem Tseva'ot iz zain nomen.<verse eid="JER 48:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 48:16" />nont iz der broch fun Moav tsu kumen,</para>
  <para style="q" vid="JER 48:16">un zain umglik ailt zeyer.<verse eid="JER 48:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 48:17" />badoyert im ale di vos zenen arum im,</para>
  <para style="q" vid="JER 48:17">un ale vos kent zain nomen zogt:</para>
  <para style="q" vid="JER 48:17">vi iz tsebrochn der machtiker shtekn,</para>
  <para style="q" vid="JER 48:17">der prachtiker shtekn!<verse eid="JER 48:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 48:18" />nider fun koved, un zits in dorshtikeit,</para>
  <para style="q" vid="JER 48:18">tochter bavoinerin fun Divon,</para>
  <para style="q" vid="JER 48:18">vorem der farvister fun Moav iz aroifgekumen oif dir,</para>
  <para style="q" vid="JER 48:18">er hot tseshtert daine festungen.<verse eid="JER 48:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 48:19" />baim veg shtei, un kuk ois,</para>
  <para style="q" vid="JER 48:19">bavoinerin fun Aroer;</para>
  <para style="q" vid="JER 48:19">freg dem antlofenem un di antrunene;</para>
  <para style="q" vid="JER 48:19">zog: vos iz geshen?<verse eid="JER 48:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 48:20" />tsu shand gevorn iz Moav, vorem zi iz tsebrochn gevorn;</para>
  <para style="q" vid="JER 48:20">iomert un shrait, zogt on in Arnon,</para>
  <para style="q" vid="JER 48:20">az farvist gevorn iz Moav.<verse eid="JER 48:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="JER 48:21" />un a mishpot iz gekumen oif dem land fun ploin; oif Cholon, un oif Yahtsah, un oif Mefaat; <verse eid="JER 48:21" /><verse number="22" style="v" sid="JER 48:22" />un oif Divon, un oif Noven, un oif Beis-Divlatayim; <verse eid="JER 48:22" /><verse number="23" style="v" sid="JER 48:23" />un oif Kiryatayim, un oif Beis-Gamul, un oif Beis-Meon; <verse eid="JER 48:23" /><verse number="24" style="v" sid="JER 48:24" />un oif Keriyot, un oif Botsrah, un oif ale shtet fun land Moav, di vaite un di nonte. <verse eid="JER 48:24" /><verse number="25" style="v" sid="JER 48:25" />opgehakt gevorn iz der horn fun Moav, un zain orem iz tsebrochn gevorn, zogt Hashem.<verse eid="JER 48:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 48:26" />farshikurt im, vorem kegen Hashem hot er zich gegreist; un Moav vet zich patshn in zain meikechts, un er oich vet tsum gelechter vern. <verse eid="JER 48:26" /><verse number="27" style="v" sid="JER 48:27" />vorem iz nisht a gelechter geven dir Yisroel? tsi iz er tsvishn ganovem gefunen gevorn, vos ven nor du host geredt fun im, flegstu zich geshokelt?<verse eid="JER 48:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="JER 48:28" />farlozt di shtet, un rut in feldz,</para>
  <para style="q" vid="JER 48:28">bavoiner fun Moav,</para>
  <para style="q" vid="JER 48:28">un zait vi a toib vos tut nestn</para>
  <para style="q" vid="JER 48:28">bai di zaitn fun dem moil fun a grub.<verse eid="JER 48:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 48:29" />mir hobn gehert di shtoltskeit fun Moav,</para>
  <para style="q" vid="JER 48:29">vi zeyer shtolts er iz;</para>
  <para style="q" vid="JER 48:29">zain groiskeit un zain shtoltskeit un zain gaive,</para>
  <para style="q" vid="JER 48:29">un di hoichkeit fun zain hartsn.<verse eid="JER 48:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 48:30" />ich veis, zogt Hashem, zain chutspe,</para>
  <para style="q" vid="JER 48:30">un zaine barimeraien on a haft,</para>
  <para style="q" vid="JER 48:30">zeyer ton on a haft.<verse eid="JER 48:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 48:31" />derum yomer ich oif Moav,</para>
  <para style="q" vid="JER 48:31">un oif gants Moav tu ich klogn;</para>
  <para style="q" vid="JER 48:31">oif di bavoiner fun Kir-Charesh muz men ziftsn.<verse eid="JER 48:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 48:32" />mer fun dem gevein oif Yazer veinen ich oif dir,</para>
  <para style="q" vid="JER 48:32">vainshtok fun Sivmah;</para>
  <para style="q" vid="JER 48:32">daine tsvaign zainen biz tsum yam ariber,</para>
  <para style="q" vid="JER 48:32">bizn yam fun Yazer hobn zei dergreicht;</para>
  <para style="q" vid="JER 48:32">oif dain zumerfrucht un oif dain vaintroibn־zamlung</para>
  <para style="q" vid="JER 48:32">iz a tseshterer ongefaln.<verse eid="JER 48:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 48:33" />un aingeton iz di freid un di lustikeit</para>
  <para style="q" vid="JER 48:33">fun dem fruchtgortn, un fun land Moav,</para>
  <para style="q" vid="JER 48:33">un vain fun di kelters hob ich farshtert;</para>
  <para style="q" vid="JER 48:33">me tret nisht mit heidad!</para>
  <para style="q" vid="JER 48:33">der heidad iz nisht heidad.<verse eid="JER 48:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="JER 48:34" />dos gesherai fun Cheshbon iz biz Elealeh, biz Yahats lozn zei arois zeyer kol, fun Tsoar biz Choronayim biz Eglat-Shelishiyah; vorem oich di vasern fun Nimrim veln tsu vist vern. <verse eid="JER 48:34" /><verse number="35" style="v" sid="JER 48:35" />un ich vel farshtern fun Moav, zogt Hashem, dem vos brengt-oif oif a bamah, un dem vos reichert tsu zaine g‑ter. <verse eid="JER 48:35" /><verse number="36" style="v" sid="JER 48:36" />derum main harts oif Moav tut vi fleitn brumen, un main harts oif di mener fun Kir-Charesh, tut vi fleitn brumen, far vos di shefe vos zei hobn ongeshaft iz untergangen.<verse eid="JER 48:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JER 48:37" />vorem yetveder kop iz a plits, un yetveder bord iz opgeshnitn, oif ale hent zainen shnitn, un oif di lendn iz zak. <verse eid="JER 48:37" /><verse number="38" style="v" sid="JER 48:38" />oif ale decher fun Moav, un in ire gasn, iz loiter klogerai; vorem ich hob tsebrochn Moav vi a nishtvertike keile, zogt Hashem. <verse eid="JER 48:38" /><verse number="39" style="v" sid="JER 48:39" />vi iz zi tsebrochn gevorn! – yomert – vi hot Moav in biosh dem rukn gekert! un Moav vet vern tsu gelechter un tsu shrek far ale zaine arumike.<verse eid="JER 48:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="JER 48:40" />vorem azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 48:40">ze, vi an odler vet er shvebn,</para>
  <para style="q" vid="JER 48:40">un shpreitn zaine fliglen tsu Moav.<verse eid="JER 48:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="JER 48:41" />batsvungen vern di shtet,</para>
  <para style="q" vid="JER 48:41">un di festungen vern aingenumen;</para>
  <para style="q" vid="JER 48:41">un dos harts fun di giborim fun Moav in yenem tog</para>
  <para style="q" vid="JER 48:41">vet zain vi dos harts fun a froi in veyen.<verse eid="JER 48:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 48:42" />un Moav vert fartilikt vern fun tsu zain a folk,</para>
  <para style="q" vid="JER 48:42">far vos er hot zich kegen Hashem gegreist.<verse eid="JER 48:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 48:43" />a groil un a grub un a nets</para>
  <para style="q" vid="JER 48:43">oif dir, bavoiner fun Moav,</para>
  <para style="qr" vid="JER 48:43">zogt Hashem.<verse eid="JER 48:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="JER 48:44" />der vos antloift fun dem groil,</para>
  <para style="q" vid="JER 48:44">vet arainfaln in grub,</para>
  <para style="q" vid="JER 48:44">un der vos kumt aroif fun grub,</para>
  <para style="q" vid="JER 48:44">vet gechapt vern in nets;</para>
  <para style="q" vid="JER 48:44">vorem ich vel brengen oif ir, oif Moav,</para>
  <para style="q" vid="JER 48:44">dos yor fun zeyer rechnshaft,</para>
  <para style="qr" vid="JER 48:44">zogt Hashem.<verse eid="JER 48:44" /></para>
  <para style="b" />
  <para style="q">
    <verse number="45" style="v" sid="JER 48:45" />in shotn fun Cheshbon hobn zich opgeshtelt</para>
  <para style="q" vid="JER 48:45">on koiech antrunene;</para>
  <para style="q" vid="JER 48:45">vorem a faier iz arois fun Cheshbon,</para>
  <para style="q" vid="JER 48:45">un a flam fun mitn Sichon,</para>
  <para style="q" vid="JER 48:45">un zi hot fartsert di shleif fun Moav,</para>
  <para style="q" vid="JER 48:45">un dem sharbn fun di liaremiungen.<verse eid="JER 48:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="JER 48:46" />vei dir, Moav!</para>
  <para style="q" vid="JER 48:46">untergegangen iz dos folk fun Kemosh;</para>
  <para style="q" vid="JER 48:46">vorem daine zin zainen genumen gevorn in gefang,</para>
  <para style="q" vid="JER 48:46">un daine techter in gefangenshaft.<verse eid="JER 48:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="JER 48:47" />ober ich vel umkeren di gefangenshaft fun Moav</para>
  <para style="q" vid="JER 48:47">in sof fun di teg,</para>
  <para style="qr" vid="JER 48:47">zogt Hashem.</para>
  <para style="q" vid="JER 48:47">biz danen iz der mishpot fun Moav.<verse eid="JER 48:47" /></para>
  <chapter eid="JER 48" />
  <chapter number="49" style="c" pubnumber="מיט" sid="JER 49" />
  <para style="p">
    <verse number="1" style="v" sid="JER 49:1" />oif di kinder fun Amon.</para>
  <para style="p" vid="JER 49:1">azoi hot Hashem gezogt:</para>
  <para style="b" vid="JER 49:1" />
  <para style="q" vid="JER 49:1">hot Yisroel kein kinder nisht?</para>
  <para style="q" vid="JER 49:1">tsi hot er kein yoiresh nisht?</para>
  <para style="q" vid="JER 49:1">far vos hot Malkam geyarshet Gad,</para>
  <para style="q" vid="JER 49:1">un zain folk hot zich bazetst in zaine shtet?<verse eid="JER 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 49:2" />derum ze, teg kumen,</para>
  <para style="qr" vid="JER 49:2">zogt Hashem,</para>
  <para style="q" vid="JER 49:2">un ich vel machn hern oif Rabbah fun di kinder fun Amon</para>
  <para style="q" vid="JER 49:2">a shalung fun milchome;</para>
  <para style="q" vid="JER 49:2">un zi vet vern a vister hoifn,</para>
  <para style="q" vid="JER 49:2">un ire techtershtet veln in faier ongetsundn vern;</para>
  <para style="q" vid="JER 49:2">un Yisroel vet yarshen zaine yersher,</para>
  <para style="qr" vid="JER 49:2">zogt Hashem.<verse eid="JER 49:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JER 49:3" />iomer, Cheshbon, vorem farvist gevorn iz Ai;</para>
  <para style="q" vid="JER 49:3">shrait, ir techter fun Rabbah,</para>
  <para style="q" vid="JER 49:3">gurt on zakkleider,</para>
  <para style="q" vid="JER 49:3">klogt un loift um tsvishn di shofgeheftn,</para>
  <para style="q" vid="JER 49:3">vorem Malkam vet in goles gein,</para>
  <para style="q" vid="JER 49:3">zaine prister un zaine harn in einem.<verse eid="JER 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 49:4" />vos rimstu zich mit di toln,</para>
  <para style="q" vid="JER 49:4">mit dain flusikn tal, du tochter vidershpenike,</para>
  <para style="q" vid="JER 49:4">vos farzichert zich oif ire oitseres, azoi tsu zogn:</para>
  <para style="q" vid="JER 49:4">ver ken kumen tsu mir?<verse eid="JER 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 49:5" />ze, ich breng oif dir a pachad,</para>
  <para style="q" vid="JER 49:5">zogt Adonoi Hashem Tseva'ot,</para>
  <para style="q" vid="JER 49:5">fun ale daine arumike,</para>
  <para style="q" vid="JER 49:5">un ir vet farshtoisen vern itlecher glaich akegn zich,</para>
  <para style="q" vid="JER 49:5">un keiner vet nisht ainzamlen dem farvogltn.<verse eid="JER 49:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="JER 49:6" />ober dernoch vel ich umkeren di gefangenshaft fun di kinder fun Amon, zogt Hashem.<verse eid="JER 49:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="JER 49:7" />oif Edom. azoi hot gezogt Hashem Tseva'ot:</para>
  <para style="b" vid="JER 49:7" />
  <para style="q" vid="JER 49:7">iz mer kein chochme nishto in Teman?</para>
  <para style="q" vid="JER 49:7">iz an etsh oisgegangen fun di farshtandike?</para>
  <para style="q" vid="JER 49:7">iz oisgevept gevorn zeyer chochme?<verse eid="JER 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 49:8" />antloift, farkert aich, bazetst aich tif,</para>
  <para style="q" vid="JER 49:8">bavoiner fun Dedan;</para>
  <para style="q" vid="JER 49:8">vorem der broch fun Esavn breng ich oif im,</para>
  <para style="q" vid="JER 49:8">beeis ich rechn zich mit im.<verse eid="JER 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 49:9" />oib harbster voltn gekumen tsu dir,</para>
  <para style="q" vid="JER 49:9">voltn zei doch a nochklaib gelozt?</para>
  <para style="q" vid="JER 49:9">oib ganovem bai der nacht,</para>
  <para style="q" vid="JER 49:9">voltn zei doch bloiz tseshtert genug far zich.<verse eid="JER 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 49:10" />ober ich hob antplekt Esavn,</para>
  <para style="q" vid="JER 49:10">ich hob oifgedekt zaine farborgenishn,</para>
  <para style="q" vid="JER 49:10">un bahaltn ken er zich nisht;</para>
  <para style="q" vid="JER 49:10">farvist gevorn iz zain zomen,</para>
  <para style="q" vid="JER 49:10">un zaine brider un zaine shecheynim,</para>
  <para style="q" vid="JER 49:10">un er iz mer nishto.<verse eid="JER 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 49:11" />loz iber daine yesoimim, ich zol zei dernern,</para>
  <para style="q" vid="JER 49:11">un daine almones zoln oif mir zich farzichern.<verse eid="JER 49:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12" />vorem azoi hot Hashem gezogt: ze, di vos zei hot nisht gekumt trinken dem kos, zei zoln yo trinken, un du zolst zain der vos zol shoinen farshoint vern? vest nisht farshoint vern, naiert trinken vestu trinken. <verse eid="JER 49:12" /><verse number="13" style="v" sid="JER 49:13" />vorem ich shver bai mir, zogt Hashem, az far a shrek, far a shand, far a vistenish, un far a klole, vet Botsrah vern, un ale ire shtet veln vern eibike churves.<verse eid="JER 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 49:14" />a herung hob ich gehert fun Hashem,</para>
  <para style="q" vid="JER 49:14">un a sheliech iz geshikt tsvishn di felker:</para>
  <para style="q" vid="JER 49:14">zamlt aich ain, un kumt oif ir,</para>
  <para style="q" vid="JER 49:14">un shteit oif tsu milchome.<verse eid="JER 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 49:15" />vorem ze, klein mach ich dich tsvishn di felker,</para>
  <para style="q" vid="JER 49:15">faracht tsvishn mentshn.<verse eid="JER 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 49:16" />dain mordikeit hot dich farfirt,</para>
  <para style="q" vid="JER 49:16">di mutvilikeit fun dain hartsn,</para>
  <para style="q" vid="JER 49:16">du vos voinst in di shpaltn fun feldz,</para>
  <para style="q" vid="JER 49:16">vos farnemt di heich fun barg.</para>
  <para style="q" vid="JER 49:16">ven zolst derheichn vi an odler dain nest,</para>
  <para style="q" vid="JER 49:16">vel ich fun dort dich aropnideren,</para>
  <para style="qr" vid="JER 49:16">zogt Hashem.<verse eid="JER 49:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="JER 49:17" />un Edom vet vern far a shrek, itlecher vos geit ir farbai vet zich dershrekn, un vet shmutsern oif ale ire plogn. <verse eid="JER 49:17" /><verse number="18" style="v" sid="JER 49:18" />azoi vi di iberkerenish fun Sodom un Amora un ire shecheynim, zogt Hashem, vet kein mentshn dort nisht voinen, un kein mentshnkind vet zich nisht oifhaltn in ir. <verse eid="JER 49:18" /><verse number="19" style="v" sid="JER 49:19" />ze, vi a leib fun dem geveld fun Yarden, vet er aroifgein oif der fiterpletser; vorem in a rege vel ich im machn antloifn fun danen, un ver der oisderveilter, dem vel ich oifzetsn iber ir. vorem ver iz main glaichn? un ver ken mich aroisrufn? un ver iz der pastuch vos ken bashtein far mir? <verse eid="JER 49:19" /><verse number="20" style="v" sid="JER 49:20" />derum hert dem barot fun Hashem vos er hot barotn oif Edom, un zaine trachtungen vos er tracht oif di bavoiner fun Teman: oib di mindste fun di shof veln zei nisht avekshlefen! oib me vet farvistn zeyer voinung iber zei! <verse eid="JER 49:20" /><verse number="21" style="v" sid="JER 49:21" />fun dem kol fun zeyer fal tsitert di erd; a geshrei vos zain hilch vert oifn Yam-Suf gehert. <verse eid="JER 49:21" /><verse number="22" style="v" sid="JER 49:22" />ze, vi an odler vet er zich oifheibn un shvebn, un shpreitn zaine fliglen kegen Botsrah; un dos harts fun di giborim fun Edom in yenem tog vet zain vi dos harts fun a froi in veyen.<verse eid="JER 49:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="JER 49:23" />oif Damesek:</para>
  <para style="b" vid="JER 49:23" />
  <para style="q" vid="JER 49:23">farshemt iz Chammat un Arpad,</para>
  <para style="q" vid="JER 49:23">vorem a shlechte herung hobn zei gehert;</para>
  <para style="q" vid="JER 49:23">tsegangen zainen zei gevorn;</para>
  <para style="q" vid="JER 49:23">oifn yam iz an umru,</para>
  <para style="q" vid="JER 49:23">er ken zich nisht ainshtiln.<verse eid="JER 49:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 49:24" />shlof gevorn iz Damesek, zi kert zich tsu antloifn,</para>
  <para style="q" vid="JER 49:24">un a tsiterenish hot zi ongenumen;</para>
  <para style="q" vid="JER 49:24">angst un veyen hobn zi ongechapt</para>
  <para style="q" vid="JER 49:24">vi a gevinerin.<verse eid="JER 49:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 49:25" />vi nisht ferlozt gevorn iz der gerimter krach,</para>
  <para style="q" vid="JER 49:25">di shtot fun main freid!<verse eid="JER 49:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 49:26" />far vor, ire yunge lait veln faln in ire gasn,</para>
  <para style="q" vid="JER 49:26">un ale milchome-lait veln farshnitn vern in yenem tog,</para>
  <para style="qr" vid="JER 49:26">zogt Hashem Tseva'ot.<verse eid="JER 49:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 49:27" />un ich vel ontsindn a faier in der moier fun Damesek,</para>
  <para style="q" vid="JER 49:27">un es vet fartseren di festungen fun Ben-Hadad.<verse eid="JER 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="JER 49:28" />oif Kedar, un oif di kinigraichn fun Chatsor vos Nevuchadretsar der melech fun Bavel hot geshlogn.</para>
  <para style="b" vid="JER 49:28" />
  <para style="q" vid="JER 49:28">azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 49:28">shteit oif, geit aroif oif Kedar,</para>
  <para style="q" vid="JER 49:28">un farvist di kinder fun mizrech.<verse eid="JER 49:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 49:29" />zeyere getseltn un zeyere shof vet men tsunemen;</para>
  <para style="q" vid="JER 49:29">zeyere forhangen, un ale zeyere keilim,</para>
  <para style="q" vid="JER 49:29">un zeyere kemlen vet men tsunemen far zich;</para>
  <para style="q" vid="JER 49:29">un men vet oisrufn oif zei: a shrek rund arum!<verse eid="JER 49:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 49:30" />antrint, antloift vait, bazetst aich tif,</para>
  <para style="q" vid="JER 49:30">bavoiner fun Chatsor,</para>
  <para style="qr" vid="JER 49:30">zogt Hashem;</para>
  <para style="q" vid="JER 49:30">vorem Nevuchadretsar der melech fun Bavel</para>
  <para style="q" vid="JER 49:30">hot getracht oif aich a plan</para>
  <para style="q" vid="JER 49:30">un tracht oif aich a trachtung.<verse eid="JER 49:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="JER 49:31" />shteit oif, geit aroif oif a roikn folk</para>
  <para style="q" vid="JER 49:31">vos zitst in zicherkeit,</para>
  <para style="qr" vid="JER 49:31">zogt Hashem;</para>
  <para style="q" vid="JER 49:31">kein tirn un rigl hot er nisht,</para>
  <para style="q" vid="JER 49:31">opgezundert voinen zei.<verse eid="JER 49:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 49:32" />un zeyere kemlen veln zain tsu roib,</para>
  <para style="q" vid="JER 49:32">un zeyer hamon fich tsu fang;</para>
  <para style="q" vid="JER 49:32">un ich vel zei tseshpreitn oif ale vintn –</para>
  <para style="q" vid="JER 49:32">di vos mit opgehakte peyes;</para>
  <para style="q" vid="JER 49:32">un fun ale zeyere zaitn</para>
  <para style="q" vid="JER 49:32">vel ich brengen zeyer broch,</para>
  <para style="qr" vid="JER 49:32">zogt Hashem.<verse eid="JER 49:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 49:33" />un Chatsor vet zain far a voinung fun shakaln,</para>
  <para style="q" vid="JER 49:33">a vistenish biz eibik;</para>
  <para style="q" vid="JER 49:33">kein mentsh vet nisht voinen dort,</para>
  <para style="q" vid="JER 49:33">un kein mentshnkind vet zich nisht oifhaltn in ir.<verse eid="JER 49:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="JER 49:34" />vos dos vort fun Hashem iz geven tsu Yirmeyah hanovi oif Eilam, in onheib fun der meluche fun Tsidkiyah dem melech fun Yehudah, azoi tsu zogn:<verse eid="JER 49:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JER 49:35" />azoi hot gezogt Hashem Tseva'ot: ze, ich tsebrech dem boign fun Eilam, di Peor fun zeyere giborim. <verse eid="JER 49:35" /><verse number="36" style="v" sid="JER 49:36" />un ich vel brengen oif Eilam di fir vintn fun di fir ekn himel, un ich vel zei tseshpreitn tsu ale di dozike vintn; un es vet nisht zain a folk, vos di farshtoisene fun Eilam veln nisht kumen ahin. <verse eid="JER 49:36" /><verse number="37" style="v" sid="JER 49:37" />un ich vel tsebrechn Eilam far zeyere faint, un far di vos zuchn zeyer lebn, un ich vel brengen oif zei an umglik – dem geirem fun main tsorn, zogt Hashem; <verse eid="JER 49:37" /><verse number="38" style="v" sid="JER 49:38" />un ich vel nochshikn noch zei di shverd, biz ich tu zei farlendn. un ich vel shteln main tron in Eilam, un vel unterbrengen fun dortn kinig un harn, zogt Hashem.<verse eid="JER 49:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JER 49:39" />ober es vet zain in sof fun di teg, vel ich umkeren di gefangenshaft fun Eilam, zogt Hashem.<verse eid="JER 49:39" /></para>
  <chapter eid="JER 49" />
  <chapter number="50" style="c" pubnumber="נ" sid="JER 50" />
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1" />dos vort vos Hashem hot geredt oif Bavel, oifn land fun di Kasdim, durch Yirmeyah hanovi:<verse eid="JER 50:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JER 50:2" />zogt on tsvishn di felker, un macht hern,</para>
  <para style="q" vid="JER 50:2">un heibt oif a fon;</para>
  <para style="q" vid="JER 50:2">macht hern, ir zolt nisht farhoiln;</para>
  <para style="q" vid="JER 50:2">zogt: batsvungen iz Bavel,</para>
  <para style="q" vid="JER 50:2">tsu shand iz Bel, tsebrochn iz Merodach,</para>
  <para style="q" vid="JER 50:2">tsu shand zainen ire getsnblikder,</para>
  <para style="q" vid="JER 50:2">tsebrochn ire opgeter.<verse eid="JER 50:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="JER 50:3" />vorem a folk fun tsofn iz aroifgegangen oif ir, er vet machn ir land tsu vist, un kein bavoiner vet in ir nisht zain; fun a mentsh biz a beheime zainen antlofn, avek.<verse eid="JER 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 50:4" />in yene teg un in yener tsait, zogt Hashem, veln kumen di kinder fun Yisroel, zei un di kinder fun Yehudah in einem; gein veinendik veln zei gein, un Hashem zeyer G-t veln zei zuchn. <verse eid="JER 50:4" /><verse number="5" style="v" sid="JER 50:5" />oif Tsiyon veln zei fregn, oifn veg aher zeyer ponem: kumt, un lamen zich baheftn on Hashem, in an eibikn bris vos zol nisht fargesen vern.<verse eid="JER 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 50:6" />bludne shof iz geven main folk; zeyere pastucher hobn zei gelozt blondzhen, oif di berg zei avekgelozt; fun barg tsu bergel zainen zei gegangen, fargesen zeyer hoierort. <verse eid="JER 50:6" /><verse number="7" style="v" sid="JER 50:7" />ale vos hobn zei gefunen hobn zei fartsert, un zeyere faint hobn gezogt: mir veln nisht shuldik zain, vail zei hobn gezindikt tsu Hashem, tsu der voinung fun gerechtikeit, un der hofung fun zeyere eltern, Hashem.<verse eid="JER 50:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 50:8" />antloift fun Bavel, un fun land Kasdim geit arois, un zait vi bek farois far di shof. <verse eid="JER 50:8" /><verse number="9" style="v" sid="JER 50:9" />vorem ze, ich dervek un breng aroif oif Bavel a gezeml groise felker fun tsofn-land, un zei veln zich oisshteln kegen ir; fun dortn vet zi batsvungen vern; zeyere failn zainen vi fun a bagliktn gibor, vos kert zich nisht um mit leidikn. <verse eid="JER 50:9" /><verse number="10" style="v" sid="JER 50:10" />un Kasdim vet zain tsu roib; ale di vos roiben ir veln zat vern, zogt Hashem.<verse eid="JER 50:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JER 50:11" />vail ir freit zich, vail ir zait lustik,</para>
  <para style="q" vid="JER 50:11">ir oisroiber fun main arav,</para>
  <para style="q" vid="JER 50:11">vail ir shpringt vi a kalb oif groz,</para>
  <para style="q" vid="JER 50:11">un hirzhet vi di ogers,<verse eid="JER 50:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 50:12" />vet zain in grois shand aier muter,</para>
  <para style="q" vid="JER 50:12">vet zich shemen aier gevinerin.</para>
  <para style="q" vid="JER 50:12">ze, dos letste fun di felker vet vern</para>
  <para style="q" vid="JER 50:12">a midber, a trikenish, un a vildernish.<verse eid="JER 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 50:13" />fun vegen dem tsorn fun Hashem vet zi zain nisht bavoint,</para>
  <para style="q" vid="JER 50:13">un zi vet zain a vistenish in gantsn;</para>
  <para style="q" vid="JER 50:13">itlecher vos geit farbai Bavel vet zich dershrekn,</para>
  <para style="q" vid="JER 50:13">un vet shmutsern oif ale ire plogn.<verse eid="JER 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 50:14" />shtelt zich ois kegen Bavel rund arum,</para>
  <para style="q" vid="JER 50:14">ale shpaner fun boign,</para>
  <para style="q" vid="JER 50:14">vorft oif ir, ir zolt nisht shporn kein failn,</para>
  <para style="q" vid="JER 50:14">vorem tsu Hashem hot zi gezindikt.<verse eid="JER 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 50:15" />shalt oif ir rund arum,</para>
  <para style="q" vid="JER 50:15">zi hot zich untergegebn;</para>
  <para style="q" vid="JER 50:15">gefaln zainen ire gruntfestn,</para>
  <para style="q" vid="JER 50:15">tseshtert gevorn ire moiern;</para>
  <para style="q" vid="JER 50:15">vorem dos iz di nekome fun Hashem,</para>
  <para style="q" vid="JER 50:15">zait zich noikem on ir;</para>
  <para style="q" vid="JER 50:15">vi zi hot geton, tu tsu ir.<verse eid="JER 50:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 50:16" />farshnaidt a zeyer fun Bavel,</para>
  <para style="q" vid="JER 50:16">un dem vos halt a shnaidmeser in shnittsait;</para>
  <para style="q" vid="JER 50:16">fun vegen der shverd vos fartilikt,</para>
  <para style="q" vid="JER 50:16">veln zei itlecher tsu zain folk zich kern,</para>
  <para style="q" vid="JER 50:16">un itlecher tsu zain land veln zei antloifn.<verse eid="JER 50:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="JER 50:17" />a tseshpreite shof iz Yisroel, leibn hobn im farshtoisen; der ershter hot im gegesn der melech fun Ashur, un der doziker letster hot im tsebainert – Nevuchadretsar dem melech fun Bavel. <verse eid="JER 50:17" /><verse number="18" style="v" sid="JER 50:18" />derum hot azoi gezogt Hashem Tseva'ot, Elokei Yisroel: ze, ich rechn zich mit dem melech fun Bavel un mit zain land, azoi vi ich hob zich opgerechnt mit dem melech fun Ashur. <verse eid="JER 50:18" /><verse number="19" style="v" sid="JER 50:19" />un ich vel umkeren Yisroel tsu zain fiterplats, un er vet zich fitern oifn Karmel un Bashan, un oifn geberg fun Efrayim un Gilad vet zich zetn zain zel. <verse eid="JER 50:19" /><verse number="20" style="v" sid="JER 50:20" />in yene teg un in yener tsait, zogt Hashem, vet gezucht vern di zind fun Yisroel, un zi vet nisht zain, un di chatoim fun Yehudah, un zei veln nisht gefunen vern, vorem ich vel fargebn di vos ich vel iberlozen.<verse eid="JER 50:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JER 50:21" />oif dem land Meratayim mach chorev</para>
  <para style="q" vid="JER 50:21">un bavoiner fun Pekod</para>
  <para style="q" vid="JER 50:21">cheirem zolst du hinter zei,</para>
  <para style="qr" vid="JER 50:21">zogt Hashem,</para>
  <para style="q" vid="JER 50:21">un tu azoi vi alts vos ich hob dir bafoiln.<verse eid="JER 50:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 50:22" />a kol fun milchome in land,</para>
  <para style="q" vid="JER 50:22">un a broch a groiser!<verse eid="JER 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 50:23" />vi iz tsehakt un tsebrochn gevorn</para>
  <para style="q" vid="JER 50:23">der hamer fun di gantser erd!</para>
  <para style="q" vid="JER 50:23">vi iz Bavel tsu vist gevorn tsvishn di felker!<verse eid="JER 50:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 50:24" />ich hob dir a nets geshtelt</para>
  <para style="q" vid="JER 50:24">un bist oif gefangen gevorn, Bavel,</para>
  <para style="q" vid="JER 50:24">un du host nisht gemerkt;</para>
  <para style="q" vid="JER 50:24">bist gefunen gevorn un oich gechapt gevorn,</para>
  <para style="q" vid="JER 50:24">vail du host zich mit Hashem tsereitsn.<verse eid="JER 50:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 50:25" />Hashem hot geefent zain shatskamer,</para>
  <para style="q" vid="JER 50:25">un aroisgetsoign di getsaig fun zain tsorn,</para>
  <para style="q" vid="JER 50:25">vorem an arbet far Adonoi Hashem Tseva'ot</para>
  <para style="q" vid="JER 50:25">iz do in land fun di Kasdim.<verse eid="JER 50:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 50:26" />kumt oif ir fun ale ekn,</para>
  <para style="q" vid="JER 50:26">efent ire shpaichlers,</para>
  <para style="q" vid="JER 50:26">vorft zi on azoi vi hoifns, un farvist zi;</para>
  <para style="q" vid="JER 50:26">zol nisht zain fun ir an iberblaib.<verse eid="JER 50:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 50:27" />koilet ale ire oksen,</para>
  <para style="q" vid="JER 50:27">zoln zei nidern tsu der shechite;</para>
  <para style="q" vid="JER 50:27">vei tsu zei! vorem gekumen iz zeyer tog,</para>
  <para style="q" vid="JER 50:27">di tsait fun zeyer rechnshaft.<verse eid="JER 50:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="JER 50:28" />a kol fun antlofene un antrunene fun land Bavel! ontsuzogn in Tsiyon di nekome fun Hashem Elokeinu, di nekome far zain heichl.<verse eid="JER 50:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 50:29" />ruft tsunoif di shisers oif Bavel, ale shpaner fun boign, legert oif ir rund arum, zol ir nisht zain kein antrinung; batsolt ir loit ir verk, azoi vi alts vos zi hot geton, tut tsu ir. vorem akegn Hashem hot zi gemutvilikt, akegn dem heilikn fun Yisroel. <verse eid="JER 50:29" /><verse number="30" style="v" sid="JER 50:30" />derum veln faln ire yungelait in ire gasn, un ale ire milchome-lait veln farshnitn vern in yenem tog, zogt Hashem.<verse eid="JER 50:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="JER 50:31" />ze, ich kum oif dir, mutviliker,</para>
  <para style="qr" vid="JER 50:31">zogt Adonoi Hashem Tseva'ot,</para>
  <para style="q" vid="JER 50:31">vorem gekumen iz dain tog,</para>
  <para style="q" vid="JER 50:31">di tsait vos ich rechn zich mit dir.<verse eid="JER 50:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 50:32" />un der mutviliker vet geshtroichlt vern un faln,</para>
  <para style="q" vid="JER 50:32">un nisht hobn ver zol im oifshteln;</para>
  <para style="q" vid="JER 50:32">un ich vel ontsindn a faier in zaine shtet,</para>
  <para style="q" vid="JER 50:32">un es vet fartseren alts vos arum im.<verse eid="JER 50:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="JER 50:33" />azoi hot gezogt Hashem Tseva'ot: gedrikt vern di kinder fun Yisroel un di kinder fun Yehudah in einem, un ale zeyere fangers haltn zei fest, zei viln zei nisht aveklozn. <verse eid="JER 50:33" /><verse number="34" style="v" sid="JER 50:34" />zeyer oisleizer iz shtark, Hashem Tseva'ot iz zain nomen; krign vet er krign zeyer krig, kedei tsu baruyen di erd, un machn tsiteren di bavoiner fun Bavel.<verse eid="JER 50:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="JER 50:35" />a shverd oif di Kasdim,</para>
  <para style="qr" vid="JER 50:35">zogt Hashem,</para>
  <para style="q" vid="JER 50:35">un oif di bavoiner fun Bavel,</para>
  <para style="q" vid="JER 50:35">un oif ire harn, un oif ire chachomim!<verse eid="JER 50:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 50:36" />a shverd oif di vorzogers,</para>
  <para style="q" vid="JER 50:36">un zei veln banarisht vern!</para>
  <para style="q" vid="JER 50:36">a shverd oif ire giborim,</para>
  <para style="q" vid="JER 50:36">un zei veln tsebrochn vern!<verse eid="JER 50:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 50:37" />a shverd oif zeyere ferd, un oif zeyer raitvegn,</para>
  <para style="q" vid="JER 50:37">un oif ale gemishte felker vos in ir,</para>
  <para style="q" vid="JER 50:37">un zei veln vern vi vaiber!</para>
  <para style="q" vid="JER 50:37">a shverd oif ire oitseres,</para>
  <para style="q" vid="JER 50:37">un zei veln tseroibt vern!<verse eid="JER 50:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 50:38" />a trikenish oif ire vasern,</para>
  <para style="q" vid="JER 50:38">un zei veln oisgetriknt vern!</para>
  <para style="q" vid="JER 50:38">vorem a land fun getsn iz dos,</para>
  <para style="q" vid="JER 50:38">un mit shrekbilder zainen zei meshuge.<verse eid="JER 50:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="JER 50:39" />derum veln dort voinen vilde kets mit shakaln, un voinen in ir veln shtroisfoiglen, un zi vet nisht bazetst vern oif eibik, un nisht bavoint vern oif dor-doires. <verse eid="JER 50:39" /><verse number="40" style="v" sid="JER 50:40" />azoi vi G-ts iberkerenish fun Sodom un Amora un ire shecheynim, zogt Hashem, vet kein mentsh dort nisht voinen, un kein mentshnkind vet zich nisht oifhaltn in ir.<verse eid="JER 50:40" /></para>
  <para style="b" />
  <para style="q">
    <verse number="41" style="v" sid="JER 50:41" />ze, a folk kumt fun tsofn,</para>
  <para style="q" vid="JER 50:41">un a groise ume un fil mlochim</para>
  <para style="q" vid="JER 50:41">dervekn zich fun di ekn erd.<verse eid="JER 50:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 50:42" />boign un shpiz haltn zei,</para>
  <para style="q" vid="JER 50:42">achzorim zainen zei, un hobn kein rachmones nisht;</para>
  <para style="q" vid="JER 50:42">zeyer kol brumt vi der yam,</para>
  <para style="q" vid="JER 50:42">un oif ferd raitn zei;</para>
  <para style="q" vid="JER 50:42">oisgeshtelt vi ein man oif milchome,</para>
  <para style="q" vid="JER 50:42">akegn dir, tochter Bavel.<verse eid="JER 50:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="JER 50:43" />der melech fun Bavel hot gehert zeyer herung,</para>
  <para style="q" vid="JER 50:43">un zaine hent zainen shlof gevorn,</para>
  <para style="q" vid="JER 50:43">an angst hot im ongenumen,</para>
  <para style="q" vid="JER 50:43">a veitik vi a gevinerin.<verse eid="JER 50:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="JER 50:44" />ze, vi a leib fun dem geveld fun Yarden, vet er aroifgein oif der shtarkn fiterung; vorem in a rege vel ich vei onyogn oif ir, un ver der oisderveilter, dem vel ich oifzetsn iber ir. vorem ver iz main glaichn? un ver ken mich aroisrufn? un ver iz der pastuch vos ken bashtein far mir? <verse eid="JER 50:44" /><verse number="45" style="v" sid="JER 50:45" />derum hert dem barot fun Hashem, vos er hot barotn oif Bavel, un zaine trachtungen vos er tracht oifn land fun di Kasdim: oib di mindste fun di shof veln zei nisht avekshlefen! oib er et nisht farvistn di fiterung iber zei! <verse eid="JER 50:45" /><verse number="46" style="v" sid="JER 50:46" />fun dem klang Bavel iz aingenumen! vert oifgetsitert di erd, un a geshrei tsvishn di felker vert gehert.<verse eid="JER 50:46" /></para>
  <chapter eid="JER 50" />
  <chapter number="51" style="c" pubnumber="נא" sid="JER 51" />
  <para style="q">
    <verse number="1" style="v" sid="JER 51:1" />azoi hot Hashem gezogt:</para>
  <para style="q" vid="JER 51:1">ze, ich dervek oif Bavel,</para>
  <para style="q" vid="JER 51:1">un oif di bavoiner fun leb-komai,</para>
  <para style="q" vid="JER 51:1">a vint an umbreng.<verse eid="JER 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 51:2" />un ich vel onshikn oif Bavel di vos vintshuflen,</para>
  <para style="q" vid="JER 51:2">un zei veln zei vintshuflen,</para>
  <para style="q" vid="JER 51:2">un veln oisleidikn ir land;</para>
  <para style="q" vid="JER 51:2">vorem fun rund arum veln zei zain oif ir,</para>
  <para style="q" vid="JER 51:2">in dem tog fun umglik.<verse eid="JER 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 51:3" />ahin zol shpanen der shpaner zain boign,</para>
  <para style="q" vid="JER 51:3">un ahin zol er zich oifheibn in zain shild;</para>
  <para style="q" vid="JER 51:3">un ir zolt nisht shoinen ire yungelait;</para>
  <para style="q" vid="JER 51:3">farvist ir gantsn cheil.<verse eid="JER 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 51:4" />un dershlogene veln faln in land fun di Kasdim,</para>
  <para style="q" vid="JER 51:4">un dershtochene in ire gasn.<verse eid="JER 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 51:5" />vorem nisht farlozen iz Yisroel un Yehudah</para>
  <para style="q" vid="JER 51:5">fun zain G-t, fun Hashem Tseva'ot;</para>
  <para style="q" vid="JER 51:5">vorem zeyer land iz ful mit shuld</para>
  <para style="q" vid="JER 51:5">akegn dem heilikn fun Yisroel.<verse eid="JER 51:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 51:6" />antloift fun Bavel, un ratevet itlecher zain nefesh,</para>
  <para style="q" vid="JER 51:6">ir zolt nisht farshnitn vern durch ir zind;</para>
  <para style="q" vid="JER 51:6">vorem a tsait fun nekome iz dos bai Hashem,</para>
  <para style="q" vid="JER 51:6">a fargeltung batsolt er ir.<verse eid="JER 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 51:7" />a gilderner kos iz Bavel geven in Hashems hant,</para>
  <para style="q" vid="JER 51:7">di gantse erd hot zi farshikurt;</para>
  <para style="q" vid="JER 51:7">fun ir vain hobn di felker getrunken,</para>
  <para style="q" vid="JER 51:7">derum zainen di felker narish gevorn.<verse eid="JER 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 51:8" />plutsling iz gefaln Bavel un tsebrochn gevorn;</para>
  <para style="q" vid="JER 51:8">tut yomern oif ir;</para>
  <para style="q" vid="JER 51:8">krigt a balzam far ir veitik,</para>
  <para style="q" vid="JER 51:8">efsher et zi geheilt vern.<verse eid="JER 51:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 51:9" />mir hobn gevolt geheilt Bavel,</para>
  <para style="q" vid="JER 51:9">ober zi iz nisht geheilt gevorn;</para>
  <para style="q" vid="JER 51:9">farlozt zi, un lomir gein itlecher tsu zain land;</para>
  <para style="q" vid="JER 51:9">vorem biz tsum himel greicht ir mishpot,</para>
  <para style="q" vid="JER 51:9">un er heibt zich oif biz di volkens.<verse eid="JER 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 51:10" />Hashem hot aroisgebracht undzer gerechtikeit;</para>
  <para style="q" vid="JER 51:10">kumt, un lomir dertseiln in Tsiyon</para>
  <para style="q" vid="JER 51:10">dem verk fun Hashem Elokeinu.<verse eid="JER 51:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JER 51:11" />macht sharf di failn,</para>
  <para style="q" vid="JER 51:11">heib oif di shildn.</para>
  <para style="b" vid="JER 51:11" />
  <para style="m" vid="JER 51:11">Hashem hot dervekt dem gaist fun di mlochim fun Madai; vorem oif Bavel iz zain trachtung, zi tsu tseshtern, vail di nekome fun Hashem iz dos, di nekome far zain heichl.<verse eid="JER 51:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JER 51:12" />kegen di moiern fun Bavel heibt oif a fon,</para>
  <para style="q" vid="JER 51:12">farshtarkt di vach,</para>
  <para style="q" vid="JER 51:12">shtelt oif vechter, breit on loierer,</para>
  <para style="q" vid="JER 51:12">vorem i getracht hot Hashem i geton</para>
  <para style="q" vid="JER 51:12">vos er hot geredt oif di bavoiner fun Bavel.<verse eid="JER 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 51:13" />du vos voinst bai groise vasern,</para>
  <para style="q" vid="JER 51:13">du raiche in oitseres,</para>
  <para style="q" vid="JER 51:13">gekumen iz dain sof,</para>
  <para style="q" vid="JER 51:13">di eil fun daine opshnaidung.<verse eid="JER 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 51:14" />Hashem Tseva'ot hot geshvorn bai zich:</para>
  <para style="q" vid="JER 51:14">far vor, ich fil dich on mit mentshn vi heisherikn,</para>
  <para style="q" vid="JER 51:14">un zei veln oisrufn kegen dir heidad!<verse eid="JER 51:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JER 51:15" />er hot gemacht di erd mit zain koiech,</para>
  <para style="q" vid="JER 51:15">er hot oifgeshtelt di velt mit zain chochme,</para>
  <para style="q" vid="JER 51:15">un mit zain farshtandikeit oisgeshpreit di himlen.<verse eid="JER 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 51:16" />baim kol fun zain dunern</para>
  <para style="q" vid="JER 51:16">vert a filkeit fun vaser in himel,</para>
  <para style="q" vid="JER 51:16">un er brengt oif volkens fun ek fun der erd;</para>
  <para style="q" vid="JER 51:16">er macht blitsn tsum regn,</para>
  <para style="q" vid="JER 51:16">un tsit arois fun zaine shpaichlers dem vint.<verse eid="JER 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 51:17" />itlecher mentsh iz fargrebt, on farshtand,</para>
  <para style="q" vid="JER 51:17">itlecher shmeltser vert tsu shand fun dem gets,</para>
  <para style="q" vid="JER 51:17">vorem falsh iz zain gegosener opgot,</para>
  <para style="q" vid="JER 51:17">un kein otem iz in zei nishto.<verse eid="JER 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 51:18" />nishtik zainen zei, a verk fun farfirenish;</para>
  <para style="q" vid="JER 51:18">in der tsait fun zeyer rechnshaft veln zei untergein.<verse eid="JER 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 51:19" />nisht azoi vi di dozike iz der teil fun Yaakov,</para>
  <para style="q" vid="JER 51:19">vorem er iz der Bashefer fun alts,</para>
  <para style="q" vid="JER 51:19">un Yisroel iz der sheyvet fun zain arbung;</para>
  <para style="q" vid="JER 51:19">Hashem Tseva'ot iz zain nomen.<verse eid="JER 51:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JER 51:20" />a hamer bistu mir, a getsaig fun milchome,</para>
  <para style="q" vid="JER 51:20">un ich vel tsebrechn mit dir felker,</para>
  <para style="q" vid="JER 51:20">un tseshtern mit dir kinigraichn.<verse eid="JER 51:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 51:21" />un ich vel tsebrechn mit dir dem ferd un zain raiter,</para>
  <para style="q" vid="JER 51:21">un ich vel tsebrechn mit dir dem raitvogn un zain raiter;<verse eid="JER 51:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 51:22" />un ich vel tsebrechn mit dir man un vaib,</para>
  <para style="q" vid="JER 51:22">un ich vel tsebrechn mit dir alt un yung,</para>
  <para style="q" vid="JER 51:22">un ich vel tsebrechn mit dir bechor un meidl;<verse eid="JER 51:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 51:23" />un ich vel tsebrechn mit dir dem pastuch un zain stade,</para>
  <para style="q" vid="JER 51:23">un ich vel tsebrechn mit dir dem akerman un zain geshpan,</para>
  <para style="q" vid="JER 51:23">un ich vel tsebrechn mit dir duksim un firshtn.<verse eid="JER 51:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="JER 51:24" />ober ich vel batsoln Bavel un ale bavoiner fun Kasdim al zeyer beiz vos zei hobn geton in Tsiyon far aiere oign, zogt Hashem.<verse eid="JER 51:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="JER 51:25" />ze, ich kum tsu dir,</para>
  <para style="q" vid="JER 51:25">du tseshteriker barg,</para>
  <para style="qr" vid="JER 51:25">zogt Hashem,</para>
  <para style="q" vid="JER 51:25">vos tseshtert di gantse erd;</para>
  <para style="q" vid="JER 51:25">un ich vel oisshtrekn main hant oif dir,</para>
  <para style="q" vid="JER 51:25">un vel dich aropkaiklen fun di velzn,</para>
  <para style="q" vid="JER 51:25">un dich machn far an oisgebrentn barg.<verse eid="JER 51:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 51:26" />un me vet nisht nemen fun dir a shtein far a vinkel,</para>
  <para style="q" vid="JER 51:26">un a shtein far gruntfestn;</para>
  <para style="q" vid="JER 51:26">naiert eibike vistenishn vestu zain,</para>
  <para style="qr" vid="JER 51:26">zogt Hashem.<verse eid="JER 51:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="JER 51:27" />heibt oif a fon in land,</para>
  <para style="q" vid="JER 51:27">blozt a shoifer tsvishn di felker,</para>
  <para style="q" vid="JER 51:27">breit on kegen ir di felker,</para>
  <para style="q" vid="JER 51:27">ruft tsunoif kegen ir di kinigraichn</para>
  <para style="q" vid="JER 51:27">Ararat, Minni, un Ashkenaz;</para>
  <para style="q" vid="JER 51:27">zetst oif kegen ir a cheil-komandir,</para>
  <para style="q" vid="JER 51:27">brengt aroif ferd vi shvorem heisherikn.<verse eid="JER 51:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 51:28" />breit on kegen ir di felker,</para>
  <para style="q" vid="JER 51:28">di mlochim fun Madai,</para>
  <para style="q" vid="JER 51:28">ire duksim un ale ire firshtn,</para>
  <para style="q" vid="JER 51:28">un dos gantse land fun zain memshole.<verse eid="JER 51:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 51:29" />un di erd shturemt un tsitert,</para>
  <para style="q" vid="JER 51:29">vorem mekayem gevorn zainen oif Bavel</para>
  <para style="q" vid="JER 51:29">di trachtungen fun Hashem,</para>
  <para style="q" vid="JER 51:29">tsu machn land Bavel tsu vist, on a voiner.<verse eid="JER 51:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 51:30" />di giborim fun Bavel hobn oifgehert milchome haltn,</para>
  <para style="q" vid="JER 51:30">zei zitsn in di festungen;</para>
  <para style="q" vid="JER 51:30">opgeton hot zich zeyer gevure,</para>
  <para style="q" vid="JER 51:30">zei zainen gevorn vi vaiber;</para>
  <para style="q" vid="JER 51:30">me hot ongetsundn ire voinungen,</para>
  <para style="q" vid="JER 51:30">tsebrochn gevorn zainen ire riglen.<verse eid="JER 51:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 51:31" />a loifer kegen a loifer loift,</para>
  <para style="q" vid="JER 51:31">un an onzoger kegen an onzoger,</para>
  <para style="q" vid="JER 51:31">ontsuzogn dem melech fun Bavel,</para>
  <para style="q" vid="JER 51:31">az zain shtot iz batsvungen fun ale ekn;<verse eid="JER 51:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 51:32" />un di iberforn zainen farchapt,</para>
  <para style="q" vid="JER 51:32">un di gemoizechts hot men farbrent in faier,</para>
  <para style="q" vid="JER 51:32">un di milchome-lait zainen tsetumlt.<verse eid="JER 51:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 51:33" />vorem azoi hot gezogt Hashem Tseva'ot, Elokei Yisroel:</para>
  <para style="q" vid="JER 51:33">tochter Bavel iz vi a dresh-shaier</para>
  <para style="q" vid="JER 51:33">in der tsait vos me tret im;</para>
  <para style="q" vid="JER 51:33">noch a klein vaile,</para>
  <para style="q" vid="JER 51:33">un kumen vet di shnittsait oif ir.<verse eid="JER 51:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="JER 51:34" />fartsert hot mich, tsedrikt hot mich,</para>
  <para style="q" vid="JER 51:34">Nevuchadretsar der melech fun Bavel;</para>
  <para style="q" vid="JER 51:34">vi a leidike keile hot er mich opgeshtelt,</para>
  <para style="q" vid="JER 51:34">vi a krokodil hot er mich aingeshlungen;</para>
  <para style="q" vid="JER 51:34">er hot ongefilt zain boich mit maine gerichtn;</para>
  <para style="q" vid="JER 51:34">avekgeshvenkt hot er mich.<verse eid="JER 51:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 51:35" />dos umrecht tsu mir un main fleish oif Bavel!</para>
  <para style="q" vid="JER 51:35">zogt di bavoinerin fun Tsiyon;</para>
  <para style="q" vid="JER 51:35">un: main blut oif di bavoiner fun Kasdim!</para>
  <para style="q" vid="JER 51:35">zogt Yerushalayim.<verse eid="JER 51:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 51:36" />derum hot Hashem azoi gezogt:</para>
  <para style="q" vid="JER 51:36">ze, ich krig dain grig,</para>
  <para style="q" vid="JER 51:36">un vel zich noikem zain dain nekome;</para>
  <para style="q" vid="JER 51:36">un ich vel oistrikenen ir yam,</para>
  <para style="q" vid="JER 51:36">un trukn machn ir kval.<verse eid="JER 51:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 51:37" />un Bavel vet vern tsu hoifns,</para>
  <para style="q" vid="JER 51:37">a voinung fun shakaln,</para>
  <para style="q" vid="JER 51:37">a shrek un a shmutserung,</para>
  <para style="q" vid="JER 51:37">on a bavoiner.<verse eid="JER 51:37" /></para>
  <para style="b" />
  <para style="q">
    <verse number="38" style="v" sid="JER 51:38" />in einem vi yungleibn veln zei briln,</para>
  <para style="q" vid="JER 51:38">vi kleine leibn veln zei shraien.<verse eid="JER 51:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 51:39" />mit gift vel ich tsurichtn zeyer trank,</para>
  <para style="q" vid="JER 51:39">un ich vel zei farshikurn, kedei zain zoln zich tsaplen,</para>
  <para style="q" vid="JER 51:39">un ainshlofn an eibikn shlof,</para>
  <para style="q" vid="JER 51:39">un zich nisht oifchapn,</para>
  <para style="qr" vid="JER 51:39">zogt Hashem.<verse eid="JER 51:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="JER 51:40" />ich vel zei machn nidern vi lemer tsu der shechite,</para>
  <para style="q" vid="JER 51:40">vi viders mit bek.<verse eid="JER 51:40" /></para>
  <para style="b" />
  <para style="q">
    <verse number="41" style="v" sid="JER 51:41" />vi iz batsvungen gevorn Sheshach,</para>
  <para style="q" vid="JER 51:41">un aingenumen gevorn der loib fun der gantser erd!</para>
  <para style="q" vid="JER 51:41">vi iz Bavel tsu vist gevorn tsvishn di felker!<verse eid="JER 51:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 51:42" />oifgegangen iz der yam oif Bavel;</para>
  <para style="q" vid="JER 51:42">fun zaine fil indn iz zi fardekt gevorn.<verse eid="JER 51:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 51:43" />ire shtet zainen gevorn a vistenish,</para>
  <para style="q" vid="JER 51:43">a trukn land un a midber,</para>
  <para style="q" vid="JER 51:43">a land vos kein shum mentsh voint nisht derin,</para>
  <para style="q" vid="JER 51:43">un kein mentshnkind geit nisht durch derin.<verse eid="JER 51:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="JER 51:44" />un ich vel zich oprechenen mit Bel in Bavel,</para>
  <para style="q" vid="JER 51:44">un ich vel aroistsien zain shlung fun zain moil,</para>
  <para style="q" vid="JER 51:44">un mer veln nisht shtromen tsu im felker;</para>
  <para style="q" vid="JER 51:44">oich di moier fun Bavel tut faln.<verse eid="JER 51:44" /></para>
  <para style="b" />
  <para style="q">
    <verse number="45" style="v" sid="JER 51:45" />geit arois fun ir, main folk,</para>
  <para style="q" vid="JER 51:45">un ratevet itlecher zain nefesh,</para>
  <para style="q" vid="JER 51:45">fun dem grimtsorn fun Hashem.<verse eid="JER 51:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="JER 51:46" />un zol nisht shlof vern aier harts,</para>
  <para style="q" vid="JER 51:46">az ir zolt moire hobn</para>
  <para style="q" vid="JER 51:46">far der herung vos vert gehert in land;</para>
  <para style="q" vid="JER 51:46">vorem a herung vet kumen ein yor,</para>
  <para style="q" vid="JER 51:46">un dos yor nochdem a herung,</para>
  <para style="q" vid="JER 51:46">un roib vet zain in land,</para>
  <para style="q" vid="JER 51:46">a geveltiker kegen a geveltiker.<verse eid="JER 51:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" sid="JER 51:47" />far vor, ze, teg kumen,</para>
  <para style="q" vid="JER 51:47">un ich vel zich oprechenen mit di getsn fun Bavel,</para>
  <para style="q" vid="JER 51:47">un ir gants land vet zich shemen,</para>
  <para style="q" vid="JER 51:47">un ale ire dershlogene veln faln in ir mit.<verse eid="JER 51:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="JER 51:48" />un zingen veln iber Bavel</para>
  <para style="q" vid="JER 51:48">himel un erd un alts vos in zei;</para>
  <para style="q" vid="JER 51:48">vorem fun tsofn veln kumen oif ir di farvisters,</para>
  <para style="qr" vid="JER 51:48">zogt Hashem.<verse eid="JER 51:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="JER 51:49" />oich Bavel iz tsum faln, far dem dershlogene fun Yisroel!</para>
  <para style="q" vid="JER 51:49">oich Bavel tut men faln, fun vegen dem dershlogene fun der gantser erd!<verse eid="JER 51:49" /></para>
  <para style="b" />
  <para style="q">
    <verse number="50" style="v" sid="JER 51:50" />ir antrunene fun shverd,</para>
  <para style="q" vid="JER 51:50">geit, ir zolt aich nisht opshteln;</para>
  <para style="q" vid="JER 51:50">dermont fun der vaitn Hashem,</para>
  <para style="q" vid="JER 51:50">un Yerushalayim zol oifgein oif aier hartsn.<verse eid="JER 51:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="JER 51:51" />mir shemen zich, vail charpus hobn mir zich ongehert,</para>
  <para style="q" vid="JER 51:51">a bushe badekt undzer ponem,</para>
  <para style="q" vid="JER 51:51">vail fremde zainen gekumen</para>
  <para style="q" vid="JER 51:51">oif di heiliktumen fun Hashems hoiz.<verse eid="JER 51:51" /></para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" sid="JER 51:52" />ober ze, teg kumen,</para>
  <para style="qr" vid="JER 51:52">zogt Hashem,</para>
  <para style="q" vid="JER 51:52">un ich vel zich oprechenen mit ir getsn,</para>
  <para style="q" vid="JER 51:52">un in ir gantsn land veln krechtsn dershlogene.<verse eid="JER 51:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="JER 51:53" />chotsh aroifgein in himel zol Bavel,</para>
  <para style="q" vid="JER 51:53">un ven zi zol bafestikn di heich fun ir macht,</para>
  <para style="q" vid="JER 51:53">veln fun mir kumen farvisters oif ir,</para>
  <para style="qr" vid="JER 51:53">zogt Hashem.<verse eid="JER 51:53" /></para>
  <para style="b" />
  <para style="q">
    <verse number="54" style="v" sid="JER 51:54" />a kol fun geshrei fun Bavel,</para>
  <para style="q" vid="JER 51:54">un a groiser broch fun land Kasdim!<verse eid="JER 51:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="JER 51:55" />vorem Hashem farvist Bavel,</para>
  <para style="q" vid="JER 51:55">un et unterbrengen fun ir dem groisn tuml;</para>
  <para style="q" vid="JER 51:55">un zeyere indn veln brumen vi groise vasern;</para>
  <para style="q" vid="JER 51:55">es hilcht der liarem fun zeyer kol.<verse eid="JER 51:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="JER 51:56" />vorem es kumt oif ir, oif Bavel, a farvister,</para>
  <para style="q" vid="JER 51:56">un ire giborim veln batsvungen vern,</para>
  <para style="q" vid="JER 51:56">zeyere boigns vern tsebrochn;</para>
  <para style="q" vid="JER 51:56">vorem an El fun fargeltung iz Hashem,</para>
  <para style="q" vid="JER 51:56">batsoln vet er batsoln.<verse eid="JER 51:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="JER 51:57" />un ich vel farshikurn ire harn un ire chachomim,</para>
  <para style="q" vid="JER 51:57">ire duksim un ire firshtn un ire giborim,</para>
  <para style="q" vid="JER 51:57">un zei veln ainshlofn an eibikn shlof,</para>
  <para style="q" vid="JER 51:57">un veln zich nisht oifchapn,</para>
  <para style="q" vid="JER 51:57">zogt der kinig –</para>
  <para style="q" vid="JER 51:57">Hashem Tseva'ot iz zain nomen.<verse eid="JER 51:57" /></para>
  <para style="b" />
  <para style="q">
    <verse number="58" style="v" sid="JER 51:58" />azoi hot gezogt Hashem Tseva'ot:</para>
  <para style="q" vid="JER 51:58">aingevorfn veln aingevorfn vern di breite moiern fun Bavel,</para>
  <para style="q" vid="JER 51:58">un ire hoiche toiern veln in faier ongetsundn vern;</para>
  <para style="q" vid="JER 51:58">un di felker veln zich mien umnisht,</para>
  <para style="q" vid="JER 51:58">un di umes faran faier;</para>
  <para style="q" vid="JER 51:58">un zei veln farmatert vern.<verse eid="JER 51:58" /></para>
  <para style="b" />
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59" />dos vort vos Yirmeyah hanovi hot bafoiln Serayah dem zun fun Neriyah dem zun fun Machseiyahn, ven er iz gegangen mit Tsidkiyah dem melech fun Yehudah kein Bavel, in firtn yor fun zain meluche; un Serayah iz geven der lagermaister. <verse eid="JER 51:59" /><verse number="60" style="v" sid="JER 51:60" />un Yirmeyah hot oifgeshribn dos gantse beiz vos vet kumen oif Bavel, in ein buch, ale di dozike verter vos zainen geshribn oif Bavel. <verse eid="JER 51:60" /><verse number="61" style="v" sid="JER 51:61" />un Yirmeyah hot gezogt tsu Serayahn: vi du kumst kein Bavel, azoi zolstu zen un iberliyenen ale di dozike verter, <verse eid="JER 51:61" /><verse number="62" style="v" sid="JER 51:62" />un zolst zogn: Hashem, du host geredt oif dem dozikn ort, im tsu farshnaidn, az kein voiner zol in im nisht zain, fun a mentsh biz a beheime, naiert eibike vistenishn zol es zain. <verse eid="JER 51:62" /><verse number="63" style="v" sid="JER 51:63" />un es vet zain, vi du endikst liyenen dos dozike buch, zolstu onbindn on im a shtein, un es arainvarfen in mitn Parat; <verse eid="JER 51:63" /><verse number="64" style="v" sid="JER 51:64" />un zolst zogn: azoi vet aingezunken vern Bavel, un nisht oifshtein, fun vegen dem beiz vos ich breng oif ir. un zei veln farmatert vern.</para>
  <para style="p" vid="JER 51:64">biz danen zainen di verter fun Yirmeyahun.<verse eid="JER 51:64" /></para>
  <chapter eid="JER 51" />
  <chapter number="52" style="c" pubnumber="נב" sid="JER 52" />
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1" />ein un tsvantsik yor iz Tsidkiyah alt geven, az er iz gevorn melech, un elf yor hot er gekinigt in Yerushalayim; un der nomen fun zain muter iz geven Chamutal di tochter fun Yirmeyahun fun Livnah. <verse eid="JER 52:1" /><verse number="2" style="v" sid="JER 52:2" />un er hot geton vos iz shlecht in di oign fun Hashem, azoi vi alts vos Yhoyakim hot geton. <verse eid="JER 52:2" /><verse number="3" style="v" sid="JER 52:3" />vorem fun vegen dem tsorn fun Hashem iz dos geshen in Yerushalayim un Yehudah, biz er hot zei avekgevorfen fun zain ponem.</para>
  <para style="p" vid="JER 52:3">un Tsidkiyah hot vidershpenikt on dem melech fun Bavel. <verse eid="JER 52:3" /><verse number="4" style="v" sid="JER 52:4" />un es iz geven in naintn yor fun zain meluche, in tsentn choidesh, in tsentn tog fun choidesh, iz gekumen Nevuchadretsar der melech fun Bavel, er mit zain gantsn cheil, oif Yerushalayim, un zei hobn gelegert oif ir, un geboit a balegerumoier rund arum ir. <verse eid="JER 52:4" /><verse number="5" style="v" sid="JER 52:5" />un di shtot iz geven in balegerung bizn elftn yor fun melech Tsidkiyahun. <verse eid="JER 52:5" /><verse number="6" style="v" sid="JER 52:6" />in firtn choidesh, in naintn tog fun choidesh, hot zich geshtarkt der hunger in shtot, un es iz nisht geven kein broit far dem folk fun land. <verse eid="JER 52:6" /><verse number="7" style="v" sid="JER 52:7" />iz aingebrochn gevorn di shtot; un ale milchome-lait zainen antlofn, un zainen arois fun shtot bai nacht durch dem toier tsvishn di tsvei moiern vos baim melechs gortn – un di Kasdim zainen geven bain shtot rund arum – un zei zainen avek mitn veg fun ploin. <verse eid="JER 52:7" /><verse number="8" style="v" sid="JER 52:8" />hot der cheil fun di Kasdim nochgeyogt dem melech, un zei hobn ongeyogt Tsidkiyahun in di ploinen fun Yericho; un zain gantser cheil iz zich tselofn fun im. <verse eid="JER 52:8" /><verse number="9" style="v" sid="JER 52:9" />un zei hobn gechapt dem melech, un hobn im aroifgebracht tsu dem melech fun Bavel kein Rivlah in land Chammat; un er hot aroisgezogt oif im a mishpot. <verse eid="JER 52:9" /><verse number="10" style="v" sid="JER 52:10" />un der melech fun Bavel hot geshochtn di zin fun Tsidkiyah far zaine oign; un oich ale harn fun Yehudah hot er geshochtn in Rivlah. <verse eid="JER 52:10" /><verse number="11" style="v" sid="JER 52:11" />un Tsidkiyahs oign hot er blind gemacht, un hot im geshmidt in kuperne keitn; un der melech fun Bavel hot im gebracht kein Bavel, un hot im araingezetst in vachhoiz biz dem tog fun zain toit.<verse eid="JER 52:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12" />un in finftn choidesh, in tsentn tog fun choidesh – dos iz dos naintsnte yor fun melech Nevuchadretsar, dem melech fun Bavel – iz gekumen Nevuzaradan der hoipt fun dem laib-cheil, vos iz geshtanen far dem melech fun Bavel in Yerushalayim. <verse eid="JER 52:12" /><verse number="13" style="v" sid="JER 52:13" />un er hot farbrent dos hoiz fun Hashem, un dem melechs hoiz; un ale haizer fun Yerushalayim, vu nor a hoiz fun a groisn man, hot er farbrent in faier. <verse eid="JER 52:13" /><verse number="14" style="v" sid="JER 52:14" />un ale moiern fun Yerushalayim rund arum hot der gantser cheil fun di Kasdim vos mit dem hoipt fun dem laib-cheil aingevorfn. <verse eid="JER 52:14" /><verse number="15" style="v" sid="JER 52:15" />un fun di orime fun folk un dem resht fun folk vos zainen geblibn in shtot, un di tsugefalene vos zainen tsugefaln tsu dem melech fun Bavel, un dem resht fun di mainster, hot Nevuzaradan der hoipt fun dem laib-cheil fartriben. <verse eid="JER 52:15" /><verse number="16" style="v" sid="JER 52:16" />ober fun di orime fun land hot Nevuzaradan der hoipt fun dem laib-cheil ibergelozt far vaingertnirer un far akerlait.<verse eid="JER 52:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17" />un di kuperne zailn vos in hoiz fun Hashem, un di geshteln, un dem kupernem yam vos in hoiz fun Hashem, hobn di Kasdim tsebrochn, un hobn avekgetrogen zeyer gantse kuper kein Bavel. <verse eid="JER 52:17" /><verse number="18" style="v" sid="JER 52:18" />oich di tep, un di shuflen, un di shnaitsmesers, un di shprengbekns, un di sholn, un ale kuperne keilim vos me flegt dinen mit zei, hobn zei tsugenumen. un di bekns, un di faierfanen, un di shprengbekns, un di tep, un di menoyrus, un di sholn, un di shislen, vos gold, gold, un vos zilber, zilber, hot der hoipt fun laib-cheil tsugenumen. <verse eid="JER 52:18" /><verse number="19" style="v" sid="JER 52:19" />un di bekns, un di faierfanen, un di shprengbekns, un di tep, un di menoyrus, un di sholn, un di shislen, vos gold, gold, un vos zilber, zilber, hot der hoipt fun laib-kol tsugenumen. <verse eid="JER 52:19" /><verse number="20" style="v" sid="JER 52:20" />di tsvei zailn, der ein yam, un di tsvelf kuperne rinder vos unter di geshteln, vos Shlomo hameilech hot gemacht faran hoiz fun Hashem – dos kuper fun ale di dozike keilim iz nisht geven optsuvegn. <verse eid="JER 52:20" /><verse number="21" style="v" sid="JER 52:21" />un di zailn: achtsen eiln iz geven di heich fun ein zail, un a fodem fun tsvelf ailn hot im arumgeringlt, un zain greb iz geven fir finger; hoil ineveinik. <verse eid="JER 52:21" /><verse number="22" style="v" sid="JER 52:22" />un a kroin iz geven oif im fun kuper; un di heich fun ein zail iz geven finf ailn, mit a netsverk un milgroimen oif der kroin rund arum, altsding fun kuper; un azoi vi di dozike oifn tsveitn zail, mit milgroimen. <verse eid="JER 52:22" /><verse number="23" style="v" sid="JER 52:23" />un di milgroimen zainen geven zeks un naintsik tsu deroisn tsu; ale milgroimen oifn netsverk rund arum zainen geven hundert.<verse eid="JER 52:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24" />un der hoipt fun dem laib-kol hot genumen Serayah dem eiber-koyen, un Tsefanyah dem tsveitn koyen, un di drai shvelhiter; <verse eid="JER 52:24" /><verse number="25" style="v" sid="JER 52:25" />un fun der shtot hot er genumen ein hoifdiner vos iz geven der oifzeer iber di milchome-lait, un zibn mener fun di vos flegn zen dem melechs ponem, vos hobn zich gefunen in shtot, un dem shraiber fun dem kol-lider, vos flegt oifnemen in cheil dos folk fun land, un zechtsik man fun dem folk fun land, vos hobn zich gefunen in shtot. <verse eid="JER 52:25" /><verse number="26" style="v" sid="JER 52:26" />un Nevuzaradan der hoipt fun dem laib-cheil hot zei genumen, un hot zei avekgefirt tsum melech fun Bavel kein Rivlah. <verse eid="JER 52:26" /><verse number="27" style="v" sid="JER 52:27" />un der melech fun Bavel hot zei geshlogn un zei geteit in Rivlah in land Chammat. azoi iz Yehudah in goles avek fun zain land.<verse eid="JER 52:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 52:28" />dos iz dos folk vos Nevuchadretsar hot fartriben: in zibetn yor, Yehudim drai toiznt un drai un tsvantsik; <verse eid="JER 52:28" /><verse number="29" style="v" sid="JER 52:29" />in achtsentn yor fun Nevuchadretsaren, fun Yerushalayim acht hundert un tsvei un draisik nefoshes; <verse eid="JER 52:29" /><verse number="30" style="v" sid="JER 52:30" />in drai un tsvantsikstn yor fun Nevuchadretsaren hot Nevuzaradan der hoipt fun dem laib-cheil fartriben Yehudim zibn hundert un finf un fertsik nefoshes; ale nefoshes, fir toiznt un zeks hundert.<verse eid="JER 52:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31" />un es iz geven in zibn un draisikstn yor fun dem goles fun Yhoyakhin dem melech fun Yehudah, in tsvelftn choidesh, in finf un tsvantsikstn tog fun choidesh, hot Evil-Merodach der melech fun Bavel, in dem yor vos er iz gevorn melech, oifgehoibn dem kop fun Yhoyakhin dem melech fun Yehudah, un hot im aroisgetsoign fun tefish. <verse eid="JER 52:31" /><verse number="32" style="v" sid="JER 52:32" />un er hot geredt tsu im fraindlech, un hot geshtelt zain shtul iber di shtuln fun di mlochim vos bai im in Bavel. <verse eid="JER 52:32" /><verse number="33" style="v" sid="JER 52:33" />un er hot umgebitn zaine tefish-kleider; un er hot gegesn bai im broit tamid, ale teg fun zain lebn. <verse eid="JER 52:33" /><verse number="34" style="v" sid="JER 52:34" />un zain oiskumenish, a shtendike oiskumenish, iz im gegebn gevorn fun dem melech fun Bavel togteglech biz tsum tog fun zain toit, ale teg fun zain lebn.<verse eid="JER 52:34" /></para>
  <chapter eid="JER 52" />
</usx>