<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Tsefanyah</para>
  <para style="toc2">Tsefanyah</para>
  <para style="toc1">Tsefanyah</para>
  <para style="mt1">Tsefanyah</para>
  <chapter number="1" style="c" pubnumber="א" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />dos vort fun Hashem vos iz geven tsu Tsefanyah dem zun fun Kushi, dem zun fun Gedalyah, dem zun fun Amaryah, dem zun fun Chizkiyahn, in di teg fun Yoshiyah dem zun fun Amonen, dem melech fun Yehudah.<verse eid="ZEP 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ZEP 1:2" />farlendn vel ich farlendn altsding</para>
  <para style="q" vid="ZEP 1:2">fun dem gezicht fun der erd,</para>
  <para style="q" vid="ZEP 1:2">zogt Hashem.<verse eid="ZEP 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 1:3" />ich vel farlendn mentshn un beheimes,</para>
  <para style="q" vid="ZEP 1:3">ich vel farlendn di foiglen fun himel,</para>
  <para style="q" vid="ZEP 1:3">un di fishn fun yam,</para>
  <para style="q" vid="ZEP 1:3">un di shtroichlungen in einem mit di reshoim;</para>
  <para style="q" vid="ZEP 1:3">un ich vel farshnaidn dem mentshn fun gezicht fun der erd,</para>
  <para style="q" vid="ZEP 1:3">zogt Hashem.<verse eid="ZEP 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 1:4" />un ich vel oisshtrekn main hant oif Yehudah,</para>
  <para style="q" vid="ZEP 1:4">un oif ale bavoiner fun Yerushalayim,</para>
  <para style="q" vid="ZEP 1:4">un ich vel farshnaidn fun dem dozikn ort</para>
  <para style="q" vid="ZEP 1:4">dem iberblaib fun Baal,</para>
  <para style="q" vid="ZEP 1:4">dem nomen fun di prister mit di koyanim;<verse eid="ZEP 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 1:5" />un di vos bukn zich oif di decher</para>
  <para style="q" vid="ZEP 1:5">tsu dem cheil fun himel,</para>
  <para style="q" vid="ZEP 1:5">un di vos i zei bukn zich un shvern tsu Hashem,</para>
  <para style="q" vid="ZEP 1:5">i zei shvern bai Malkam;<verse eid="ZEP 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 1:6" />un di vos tretn op fun hinter Hashem,</para>
  <para style="q" vid="ZEP 1:6">un vos zuchn nisht Hashem,</para>
  <para style="q" vid="ZEP 1:6">un fregn zich nisht oif im.<verse eid="ZEP 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ZEP 1:7" />shtil far Adonoi Hashem!</para>
  <para style="q" vid="ZEP 1:7">vorem nont iz der tog fun Hashem,</para>
  <para style="q" vid="ZEP 1:7">vorem G-t hot ongebreit a shlachtung,</para>
  <para style="q" vid="ZEP 1:7">farbeten zaine gerufene.<verse eid="ZEP 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 1:8" />un es vet zain in dem tog fun Hashems shlachtung,</para>
  <para style="q" vid="ZEP 1:8">vel ich zich rechenen mit di harn,</para>
  <para style="q" vid="ZEP 1:8">un mit dem melechs zin,</para>
  <para style="q" vid="ZEP 1:8">un mit ale vos kleidn zich in fremdlendishe kleider.<verse eid="ZEP 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 1:9" />un ich vel zich rechenen in yenem tog</para>
  <para style="q" vid="ZEP 1:9">mit ale vos shpringen ibern shvel,</para>
  <para style="q" vid="ZEP 1:9">vos filn on dos hoiz fun zeyer har</para>
  <para style="q" vid="ZEP 1:9">mit umrecht un batrug.<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ZEP 1:10" />un in yenem tog, zogt Hashem,</para>
  <para style="q" vid="ZEP 1:10">vet zain a kol fun geshrei fun dem fishtoier,</para>
  <para style="q" vid="ZEP 1:10">un a yelole fun tsveitn shtotfertl,</para>
  <para style="q" vid="ZEP 1:10">un a groiser broch fun di berg.<verse eid="ZEP 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 1:11" />iomert, ir bavoiner fun Machtesh,</para>
  <para style="q" vid="ZEP 1:11">vorem umgekumen iz dos gantse handlfolk,</para>
  <para style="q" vid="ZEP 1:11">farshnitn gevorn ale ongelodene mit zilber.<verse eid="ZEP 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 1:12" />un es vet zain in yener tsait,</para>
  <para style="q" vid="ZEP 1:12">vel ich durchzuchn Yerushalayim mit licht,</para>
  <para style="q" vid="ZEP 1:12">un ich vel zich rechenen mit di lait</para>
  <para style="q" vid="ZEP 1:12">vos glivern oif zeyere heivn,</para>
  <para style="q" vid="ZEP 1:12">vos zogn in zeyer hartsn:</para>
  <para style="q" vid="ZEP 1:12">nisht guts ton ken Hashem un nisht shlechts ton.<verse eid="ZEP 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ZEP 1:13" />un zeyer farmeg vet zain tsu roib,</para>
  <para style="q" vid="ZEP 1:13">un zeyere haizer tsu vist;</para>
  <para style="q" vid="ZEP 1:13">un zei veln boien haizer, un nisht bavoinen,</para>
  <para style="q" vid="ZEP 1:13">un flantsen vaingertner, un nisht trinken zeyer vain.<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ZEP 1:14" />nont iz der groiser tog fun Hashem,</para>
  <para style="q" vid="ZEP 1:14">nont un geshvint zeyer;</para>
  <para style="q" vid="ZEP 1:14">horch! der tog fun Hashem!</para>
  <para style="q" vid="ZEP 1:14">biter shrait dentsmol der gibor.<verse eid="ZEP 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 1:15" />a tog fun tsorn iz yener tog,</para>
  <para style="q" vid="ZEP 1:15">a tog fun noit un klem,</para>
  <para style="q" vid="ZEP 1:15">a tog fun vistkeit un farvistung,</para>
  <para style="q" vid="ZEP 1:15">a tog fun choishech un fintsternish,</para>
  <para style="q" vid="ZEP 1:15">a tog fun volken un nebl,<verse eid="ZEP 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 1:16" />a tog fun shoifer un shalung</para>
  <para style="q" vid="ZEP 1:16">akegn di bafestikte shtet,</para>
  <para style="q" vid="ZEP 1:16">un akegn di hoiche turems.<verse eid="ZEP 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ZEP 1:17" />un ich vel eng machn di mentshn,</para>
  <para style="q" vid="ZEP 1:17">un zei veln umgein vi blinde,</para>
  <para style="q" vid="ZEP 1:17">vail zei hobn tsu Hashem gezindikt;</para>
  <para style="q" vid="ZEP 1:17">un zeyer blut vet fargosen vern vi shtoib,</para>
  <para style="q" vid="ZEP 1:17">un zeyer fleish vi mist.<verse eid="ZEP 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 1:18" />afile zeyer zilber, afile zeyer gold,</para>
  <para style="q" vid="ZEP 1:18">vet zei nisht kenen matsl zain</para>
  <para style="q" vid="ZEP 1:18">in tog fun Hashems tsorn;</para>
  <para style="q" vid="ZEP 1:18">un in dem faier fun zain kine</para>
  <para style="q" vid="ZEP 1:18">vet fartsert vern di gantse erd,</para>
  <para style="q" vid="ZEP 1:18">vorem a farlendung azh a shrekleche,</para>
  <para style="q" vid="ZEP 1:18">vet er machn fun ale bavoiner fun der erd.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="ZEP 2" />
  <para style="q">
    <verse number="1" style="v" sid="ZEP 2:1" />zamlt aich ain un farzamlt aich,</para>
  <para style="q" vid="ZEP 2:1">ir umfarshemt folk,<verse eid="ZEP 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 2:2" />eider der gzar vert geborn</para>
  <para style="q" vid="ZEP 2:2">vi shprei fargeit der tog</para>
  <para style="q" vid="ZEP 2:2">eider es kumt oif aich der grimtsorn fun Hashem,</para>
  <para style="q" vid="ZEP 2:2">eider es kumt oif aich der tog fun Hashems kaas.<verse eid="ZEP 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 2:3" />zucht Hashem, ir ale farlitene fun land,</para>
  <para style="q" vid="ZEP 2:3">vos hot geton zain gezets;</para>
  <para style="q" vid="ZEP 2:3">zucht gerechtikeit, zucht anives,</para>
  <para style="q" vid="ZEP 2:3">efsher vet ir farborgen vern in tog fun Hashems kaas.<verse eid="ZEP 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 2:4" />vorem Azah vet a farlozene zain,</para>
  <para style="q" vid="ZEP 2:4">un Ashkelon a vistenish;</para>
  <para style="q" vid="ZEP 2:4">Ashdod, zi vet men in mitn tog aroistraibn,</para>
  <para style="q" vid="ZEP 2:4">un Ekron vet oisgerisn vern.<verse eid="ZEP 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ZEP 2:5" />vei, ir bavoiner fun der yam-gegent,</para>
  <para style="q" vid="ZEP 2:5">ir folk fun Keretim!</para>
  <para style="q" vid="ZEP 2:5">dos vort fun Hashem iz oif aich,</para>
  <para style="q" vid="ZEP 2:5">Kenaan, du land fun di Pelishtim;</para>
  <para style="q" vid="ZEP 2:5">un ich vel dich unterbrengen</para>
  <para style="q" vid="ZEP 2:5">az kein bavoiner zol nisht zain.<verse eid="ZEP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 2:6" />un di gegent fun yam vet zain fiterpletser,</para>
  <para style="q" vid="ZEP 2:6">lonkes far pastucher, un geheftn far shof,<verse eid="ZEP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 2:7" />un es vet zain a chelek</para>
  <para style="q" vid="ZEP 2:7">far dem iberblaib fun dem hoiz fun Yehudah;</para>
  <para style="q" vid="ZEP 2:7">zei veln zich deroif fitern;</para>
  <para style="q" vid="ZEP 2:7">in di haizer fun Ashkelon veln zei hoiern in ovnt;</para>
  <para style="q" vid="ZEP 2:7">vorem Hashem zeyer G-t vet zich dermonen on zei,</para>
  <para style="q" vid="ZEP 2:7">un vet umkeren zeyer gefangenshaft.<verse eid="ZEP 2:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ZEP 2:8" />ich hob gehert di lesterung fun Moav,</para>
  <para style="q" vid="ZEP 2:8">un di zidleraien fun di kinder fun Amon,</para>
  <para style="q" vid="ZEP 2:8">vos zei hobn gelestert main folk,</para>
  <para style="q" vid="ZEP 2:8">un zich gegreist akegn zeyer gemark.<verse eid="ZEP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 2:9" />derum azoi vi ich leb,</para>
  <para style="q" vid="ZEP 2:9">zogt Hashem Tseva'ot, Elokei Yisroel:</para>
  <para style="q" vid="ZEP 2:9">az Moav vet vi Sodom vern,</para>
  <para style="q" vid="ZEP 2:9">un di kinder fun Amon vi Amora,</para>
  <para style="q" vid="ZEP 2:9">a virtshaft fun derner, un an oisgrobung fun zalts,</para>
  <para style="q" vid="ZEP 2:9">un a vistenish oif eibik;</para>
  <para style="q" vid="ZEP 2:9">der iberblaib fun main ume vet zei tseroibn,</para>
  <para style="q" vid="ZEP 2:9">un der resht fun main folk vet zei arben.<verse eid="ZEP 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 2:10" />dos vet zei zain far zeyer shtolts,</para>
  <para style="q" vid="ZEP 2:10">vos zei hobn gelestert, un zich gegreist</para>
  <para style="q" vid="ZEP 2:10">kegen der ume fun Hashem Tseva'ot.<verse eid="ZEP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 2:11" />moiredik iz Hashem akegn zei,</para>
  <para style="q" vid="ZEP 2:11">vorem er macht aingein ale opgeter fun der erd,</para>
  <para style="q" vid="ZEP 2:11">un bukn veln zich tsu im, itlecher fun zain ort,</para>
  <para style="q" vid="ZEP 2:11">ale indzelen fun di felker.<verse eid="ZEP 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ZEP 2:12" />oich ir Kushim,</para>
  <para style="q" vid="ZEP 2:12">vet zain dershlogene fun main shverd.<verse eid="ZEP 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ZEP 2:13" />un er vet oisshtrekn zain hant akegn tsofn,</para>
  <para style="q" vid="ZEP 2:13">un vet unterbrengen Ashur,</para>
  <para style="q" vid="ZEP 2:13">un machn Nineveh far a vistenish,</para>
  <para style="q" vid="ZEP 2:13">a trikenish azoi vi a midber.<verse eid="ZEP 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 2:14" />un hoiern in ir veln stades,</para>
  <para style="q" vid="ZEP 2:14">chayes fun yetveder min;</para>
  <para style="q" vid="ZEP 2:14">i der pelikan i der zumpbushl</para>
  <para style="q" vid="ZEP 2:14">veln nechtikn oif ire zailnkep;</para>
  <para style="q" vid="ZEP 2:14">koiles veln zingen in fentster,</para>
  <para style="q" vid="ZEP 2:14">a churvn vet zain oif der shvel,</para>
  <para style="q" vid="ZEP 2:14">vorem ir tsederverk dekt men op.<verse eid="ZEP 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 2:15" />dos iz di lustike shtot vos iz gezesn in zicherkeit,</para>
  <para style="q" vid="ZEP 2:15">vos hot gezogt in ir hartsn:</para>
  <para style="q" vid="ZEP 2:15">ich, un achuts mir iz mer nishto.</para>
  <para style="q" vid="ZEP 2:15">vi iz zi gevorn tsu vist,</para>
  <para style="q" vid="ZEP 2:15">a hoierort far chayes!</para>
  <para style="q" vid="ZEP 2:15">itlecher vos geit ir farbai,</para>
  <para style="q" vid="ZEP 2:15">vet shmutsern, vet vign zain hant.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="ZEP 3" />
  <para style="q">
    <verse number="1" style="v" sid="ZEP 3:1" />vei, di koitike un umverdike,</para>
  <para style="q" vid="ZEP 3:1">di drikerishe shtot!<verse eid="ZEP 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 3:2" />zi hot nisht tsugehert dem kol,</para>
  <para style="q" vid="ZEP 3:2">zi hot nisht genumen kein musar,</para>
  <para style="q" vid="ZEP 3:2">zi hot zich nisht farzichert oif Hashem,</para>
  <para style="q" vid="ZEP 3:2">zi hot zich nisht dernentert tsu ir G-t.<verse eid="ZEP 3:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ZEP 3:3" />ire harn in ir zainen leibn brumike,</para>
  <para style="q" vid="ZEP 3:3">ire richter zainen ovntvelf,</para>
  <para style="q" vid="ZEP 3:3">zei lozn nisht a bein biz frimorgn.<verse eid="ZEP 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 3:4" />ire neviim zainen loizgelozt, mentshn umgetraie;</para>
  <para style="q" vid="ZEP 3:4">ire koyanim farshvechn di heilikeit,</para>
  <para style="q" vid="ZEP 3:4">farbrechn akegn der toyre.<verse eid="ZEP 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 3:5" />Hashem der gerechter iz in ir mit,</para>
  <para style="q" vid="ZEP 3:5">er tut nisht kein umrecht;</para>
  <para style="q" vid="ZEP 3:5">frimorgn in frimorgn lozt er arois</para>
  <para style="q" vid="ZEP 3:5">zain gerechtikeit in licht, nisht farfelt;</para>
  <para style="q" vid="ZEP 3:5">ober der farbrecher veis nisht fun kein bushe.<verse eid="ZEP 3:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ZEP 3:6" />ich hob farshnitn felker,</para>
  <para style="q" vid="ZEP 3:6">farvist gevorn zainen zeyere vinklen;</para>
  <para style="q" vid="ZEP 3:6">ich hob chorev gemacht zeyere gasn,</para>
  <para style="q" vid="ZEP 3:6">az keiner geit nisht durch;</para>
  <para style="q" vid="ZEP 3:6">tseshtert zainen zeyere shtet,</para>
  <para style="q" vid="ZEP 3:6">on a mentshn, on a bavoiner.<verse eid="ZEP 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 3:7" />hob ich getracht: vest gevis moire hobn far mir,</para>
  <para style="q" vid="ZEP 3:7">vest a musar nemen;</para>
  <para style="q" vid="ZEP 3:7">kedei ir voinung zol nisht farshnitn vern,</para>
  <para style="q" vid="ZEP 3:7">loit alts vos ich hob bafoiln vegen ir;</para>
  <para style="q" vid="ZEP 3:7">ober zei hobn zich gefedert</para>
  <para style="q" vid="ZEP 3:7">fardorben tsu zain in ale zeyere meisim.<verse eid="ZEP 3:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ZEP 3:8" />derum richt zich oif mir, zogt Hashem,</para>
  <para style="q" vid="ZEP 3:8">oif dem tog vos ich shtei oif tsum roib,</para>
  <para style="q" vid="ZEP 3:8">vorem main mishpot iz aintsuzamlen di felker</para>
  <para style="q" vid="ZEP 3:8">ich zol oifklaibn di kinigraichn,</para>
  <para style="q" vid="ZEP 3:8">oistsugisn oif zei main kaas,</para>
  <para style="q" vid="ZEP 3:8">main gantsn grimtsorn;</para>
  <para style="q" vid="ZEP 3:8">vorem in dem faier fun main kine</para>
  <para style="q" vid="ZEP 3:8">vet fartsert vern di gantse erd.<verse eid="ZEP 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ZEP 3:9" />vorem dentsmol vel ich ibermachn di felker</para>
  <para style="q" vid="ZEP 3:9">a lip a reine, az zei zoln ale rufn tsum nomen Hashem,</para>
  <para style="q" vid="ZEP 3:9">im tsu dinen azoi vi ein man.<verse eid="ZEP 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 3:10" />fun yener zait taichn fun Kush</para>
  <para style="q" vid="ZEP 3:10">veln zei brengen maine beter,</para>
  <para style="q" vid="ZEP 3:10">di tochter fun maine tseshpraite, a matone tsu mir.<verse eid="ZEP 3:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ZEP 3:11" />in yenem tog vestu zich mer nisht shemen</para>
  <para style="q" vid="ZEP 3:11">vegen ale daine meisim, vos du host farbrochn kegen mir,</para>
  <para style="q" vid="ZEP 3:11">vorem dentsmol vel ich opton</para>
  <para style="q" vid="ZEP 3:11">fun tsvishn dir daine shtoltslustike,</para>
  <para style="q" vid="ZEP 3:11">un vest zich mer vider nisht greisn,</para>
  <para style="q" vid="ZEP 3:11">oif main heilikn barg.<verse eid="ZEP 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 3:12" />un ich vel iberlozen in dir</para>
  <para style="q" vid="ZEP 3:12">dos gedrikte un orime folk,</para>
  <para style="q" vid="ZEP 3:12">un zei veln zich bashitsn in dem nomen Hashem.<verse eid="ZEP 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 3:13" />der iberblaib fun Yisroel vet nisht ton kein umrecht,</para>
  <para style="q" vid="ZEP 3:13">un nisht redn kein lign,</para>
  <para style="q" vid="ZEP 3:13">un in zeyer moil vet zich nisht gefinen</para>
  <para style="q" vid="ZEP 3:13">a tsung fun batrug;</para>
  <para style="q" vid="ZEP 3:13">yo, zei veln zich fitern un hoiern,</para>
  <para style="q" vid="ZEP 3:13">un keiner vet nisht shrekn.<verse eid="ZEP 3:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ZEP 3:14" />zing, tochter Tsiyon,</para>
  <para style="q" vid="ZEP 3:14">tut shaln, Yisroel;</para>
  <para style="q" vid="ZEP 3:14">frei zich un zai lustik fun gantsn hartsn,</para>
  <para style="q" vid="ZEP 3:14">tochter Yerushalayim.<verse eid="ZEP 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 3:15" />Hashem tut op daine mishpotim,</para>
  <para style="q" vid="ZEP 3:15">er ramt op daine faint;</para>
  <para style="q" vid="ZEP 3:15">der kinig fun Yisroel, Hashem, iz tsvishn dir,</para>
  <para style="q" vid="ZEP 3:15">zolst mer nisht moire hobn far beiz.<verse eid="ZEP 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 3:16" />in yenem tog vet gezogt vern tsu Yerushalayim:</para>
  <para style="q" vid="ZEP 3:16">zolst nisht moire hobn;</para>
  <para style="q" vid="ZEP 3:16">Tsiyon, nisht shlof vern zoln daine hent.<verse eid="ZEP 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 3:17" />Hashem dain G-t iz tsvishn dir,</para>
  <para style="q" vid="ZEP 3:17">a gibor vos helft;</para>
  <para style="q" vid="ZEP 3:17">er vet zich freyen mit simche oif dir,</para>
  <para style="q" vid="ZEP 3:17">er vet farshvaign in zain libshaft,</para>
  <para style="q" vid="ZEP 3:17">er vet zich freyen oif dir mit gezang.<verse eid="ZEP 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 3:18" />ich zaml ain di dervaiterte fun a yom-tov –</para>
  <para style="q" vid="ZEP 3:18">di vos zainen avek fun dir,</para>
  <para style="q" vid="ZEP 3:18">vos du host getrogn vegen dem shand.<verse eid="ZEP 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ZEP 3:19" />ze, ich rechn zich mit ale daine painiker, in yener tsait,</para>
  <para style="q" vid="ZEP 3:19">un ich vel helfn di vos iz hinkedik,</para>
  <para style="q" vid="ZEP 3:19">un di farshtoisene vel ich ainzamlen;</para>
  <para style="q" vid="ZEP 3:19">un ich vel zei machn far a loib un far a shem,</para>
  <para style="q" vid="ZEP 3:19">di vos iber der gantser erd iz geven zeyer shand.<verse eid="ZEP 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ZEP 3:20" />in yener tsait vel ich aich brengen,</para>
  <para style="q" vid="ZEP 3:20">un in yener tsait tu ich aich ainzamlen;</para>
  <para style="q" vid="ZEP 3:20">vorem ich vel aich machn far a shem un far a loib</para>
  <para style="q" vid="ZEP 3:20">tsvishn ale felker fun der erd,</para>
  <para style="q" vid="ZEP 3:20">ven ich ker um aier gefangenshaft</para>
  <para style="q" vid="ZEP 3:20">far aiere oign, zogt Hashem.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>