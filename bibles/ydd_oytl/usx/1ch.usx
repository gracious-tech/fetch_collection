<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Divrei Hayamim Alef</para>
  <para style="toc2">Divrei Hayamim Alef</para>
  <para style="toc1">Divrei Hayamim Alef</para>
  <para style="mt1">Divrei Hayamim Alef</para>
  <chapter number="1" style="c" pubnumber="א" sid="1CH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />Adam, Shet, Enosh; <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />Kenan, Mahalalel, Yered; <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Chanoch, Metushelach, Lemech; <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />Noach, Shem, Cham, un Yefet.<verse eid="1CH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />di zin fun Yefeten: Gomer, un Magog, un Madai, un Yavan, un Tuval, un Meshech, un Tiras. <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />un di zin fun Gomern: Ashkenaz, un Rifat, un Togarmah. <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />un di zin fun Yavanen: Elishah, un Tarshishah, di Kittim, un di Rodanim.<verse eid="1CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8" />di zin fun Chamen: Kush, un Mitsrayim, Put, un Kenaan. <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />un di zin fun Kushn: Seva, un Chavilah, un Savtah, un Raamah, un Savtecha. un di zin fun Raamahn: Sheva, un Dedan. <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />un Kush hot geborn Nimrodn. er iz geven der ershter machtiker oif der erd. <verse eid="1CH 1:10" /><verse number="11" style="v" sid="1CH 1:11" />un Mitsrayim hot geborn di Ludim, un di Anamim, un di Lehavim, un di Naftuchim, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />un di Patrusim, un di Kasluchim – fun vanen di Pelishtim zainen aroisgekumen – un di Kaftorim. <verse eid="1CH 1:12" /><verse number="13" style="v" sid="1CH 1:13" />un Kenaan hot geborn Tsidon zain bechor, un Chetn; <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />un dem Yevusi, un dem Emori, un dem Girgashi; <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />un dem Chivi, un dem Arki, un dem Sini; <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />un dem Arvadi, un dem Tsemari, un dem Chamati.<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />di zin fun Shemen: Eilam, un Ashur, un Arpachshad, un Lud, un Aram, un Uts, un Chul, un Geter, un Meshech. <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />un Arpachshad hot geborn Shelachn, un Shelach hot geborn Evern. <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />un bai Evern zainen geborn gevorn tsvei zin; der nomen fun einem iz geven Peleg, vail in zaine teg iz tseteilt gevorn di erd; un der nomen fun zain bruder iz geven Yoktan. <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />un Yoktan hot geborn Almodadn, un Shelefn, un Chatsarmavetn, un Yerachn; <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />un Hadoramen, un Uzaln, un Diklahn; <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />un Eivaln, un Avimaeln, un Shevaen; <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />un Ofirn, un Chavilahn, un Yovavn. di ale zainen geven Yoktans zin.<verse eid="1CH 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />Shem, Arpachshad, Shelach; <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />Ever, Peleg, Reu; <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />Serug, Nachor, Terach; <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />Avram, dos iz Avraham. <verse eid="1CH 1:27" /><verse number="28" style="v" sid="1CH 1:28" />di zin fun Avrahamen: Yitschak, un Yishmael.<verse eid="1CH 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 1:29" />dos zainen zeyere geburtn: der bechor fun Yishmaeln, Nevayot, un Kedar, un Adbeel, un Mivsam; <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Mishma, un Dumah, Massa, Chadad, un Tema; <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Itur, Nafish, un Kedmah. dos zainen di zin fun Yishmaeln.<verse eid="1CH 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />un di zin fun Keturah, Avrahams kepsvaib: zi hot geborn Zimranen, un Yokshanen, un Medanen, un Midyanem, un Yishbakn, un Shuachn. un di zin fun Yokshanen zainen geven: Sheva, un Dedan. <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />un di zin fun Midyanem: Eifah, un Efer, un Chanoch, un Avida, un Eldaah. di ale zainen geven di zin fun Keturahn.<verse eid="1CH 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />un Avraham hot geborn Yitschakn. di zin fun Yitschakn zainen geven: Esav, un Yisroel.<verse eid="1CH 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 1:35" />di zin fun Esavn: Elifaz, Reuel, un Yeush, un Yaalam, un Korach. <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />di zin fun Elifazn: Teman, un Omar Tsefi, un Gatam, Kenaz, un Timna, un Amalek. <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />di zin fun Reueln: Nachat, Zerach, Shammah, un Mizzah.<verse eid="1CH 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />un di zin fun Seirn: Lotan, un Shoval, un Tsiveon, un Anah, un Dishon, un Etser, un Dishon. <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />un di zin fun Lotanen: Churai, un Homam; un di shvester fun Lotanen: Timna. <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />di zin fun Shovaln: Alyan, un Manachat, un Eival, Shefi, un Onam. un di zin fun Tsiveonen: Ayah, un Anah. <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />di zin fun Anahn: Dishon. un di zin fun Dishonen: Chamran, un Eshban, un Yitran, un Keran. <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />di zin fun Etsern: Bilhan, un Zaavan, Yaakan. di zin fun Dishonen: Uts, un Aran.<verse eid="1CH 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />un dos zainen di mlochim vos hobn gekinigt in land Edom eider es hot gekinigt a kinig bai di kinder fun Yisroel: Bela der zun fun Beoren; un der nomen fun zain shtot iz geven Dinhavah.<verse eid="1CH 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 1:44" />iz Bela geshtorbn, un oif zain ort hot gekinigt Yovav der zun fun Zerachn, fun Botsrah. <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />iz Yovav geshtorbn, un oif zain ort hot gekinigt Chusham fun land fun dem Temani. <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />iz Chusham geshtorbn, un oif zain ort hot gekinigt Hadad der zun fun Bedadn, vos hot geshlogn Midyan in feld fun Moav; un der nomen fun zain shtot iz geven Avit. <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />iz Hadad geshtorbn, un oif zain ort hot gekinigt Samlah fun Masrekah. <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />iz Samlah geshtorbn, un oif zain ort hot gekinigt Shaul fun Rechovot baim taich. <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />iz Shaul geshtorbn, un oif zain ort hot gekinigt Baal-Chanan der zun fun Achborn; <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />iz Baal-Chanan geshtorbn, un oif zain ort hot gekinigt Hadad; un der nomen fun zain shtot iz geven Pai; un der nomen fun zain vaib iz geven Mehetaveel di tochter fun Matred der tochter fun Mei-Zahavn. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />un Hadad iz geshtorbn. un di firshtn fun Edom zainen geven: der firsht fun Timna, der firsht fun Alvah, der firsht fun Yetet; <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />der firsht fun Oholivamah, der firsht fun Elah, der firsht fun Pinon; <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />der firsht fun Kenaz, der firsht fun Teman, der firsht fun Mivtsar; <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />der firsht fun Magdiel, der firsht fun Iram. dos zainen di firshtn fun Edom.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="1CH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />dos zainen di zin fun Yisroeln: Reuven, Shimeon, Levi, un Yehudah, Yissachar, un Zevulun; <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Dan, Yosef, un Binyamin, Naftali, Gad, un Asher.<verse eid="1CH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />di zin fun Yehudahn: Er, un Onan, un Shelah; di drai zainen im geborn gevorn fun Bat-Shua der Kenaanit, un Er, Yehudahs bechor, iz geven shlecht in di oign fun Hashem, un er hot im geteit. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />un Tamar zain shnur hot im geborn Peretsn, un Zerachn. ale zin fun Yehudahn: finf.<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />di zin fun Peretsn: Chetsron, un Chamul. <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />un di zin fun Zerachn: Zimri, un Eitan, un Heman, un Kalkol, un Dara; in alemen finf. <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />un di zin fun Karmien: Achar, der farumgliker fun Yisroel vos hot gefelsht on cheirem. <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />un di zin fun Eitanen: Azaryah.<verse eid="1CH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9" />un di zin fun Chetsronen vos zainen im geborn gevorn: Yerachmeel, un Ram, un Keluvai. <verse eid="1CH 2:9" /><verse number="10" style="v" sid="1CH 2:10" />un Ram hot geborn Amminadavn, un Amminadav hot geborn Nachshon dem firsht fun di kinder fun Yehudah. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />un Nachshon hot geborn Salmaen, un Salma hot geborn Boazen. <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />un Boaz hot geborn Ovedn, un Oved hot geborn Yishaien. <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />un Yishai hot geborn zain bechor Eliavn, un Avinadav dem tsveitn, un Shimea dem dritn; <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />Netanel dem firtn, Raddai dem finftn; <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />Otsem dem zekstn, Dovid dem zibetn. <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />un zeyere shvester zainen geven Tseruyah, un Avigal. un di zin fun Tseruyahn: Avishai, un Yoav, un Asahel – drai. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />un Avigal hot geborn Amasaen, un Amasas foter iz geven Yeter der Yishmelim.<verse eid="1CH 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />un Kalev der zun fun Chetsronen hot gehat kinder mit der vaib Azuvahn – un mit Yerioten – un dos zainen ire zin: Yesher, un Shovav, un Ardon. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />iz Azuvah geshtorbn un Kalev hot zich genumen Efratahn, un zi hot im geborn Churen. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />un Chur hot geborn Urien, un Uri hot geborn Betsaleln.<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />un dernoch iz gekumen Chetsron tsu der tochter fun Machir dem foter fun Gilad, vos er hot genumen ven er iz geven zechtsik yor alt; un zi hot im geborn Seguvn. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />un Seguv hot geborn Yairn, vos hot gehat drai un tsvantsik shtet in land Gilad. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />un Geshur un Aram hobn avekgenumen fun zei Chavot-Yair, Kenat un ire techtershtet, zechtsik shtet. di ale zainen di zin fun Machir dem foter fun Gilad. <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />un noch Chetzrons toit in Kalev-Efratah, hot Aviyah, Chetzrons vaib, geborn fun im Ashchur dem foter fun Tekoa.<verse eid="1CH 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />un di zin fun Yerachmeel, Chetzrons bechor, zainen geven: der bechor Ram, un Bunah, un Oren, un Otsem, Achiyah. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />un Yerachmeel hot gehat noch an ander vaib, vos ir nomen iz geven Atarah; zi iz geven di muter fun Onamen.<verse eid="1CH 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 2:27" />un di zin fun Ram, Yerachmeels bechor, zainen geven: Maats, un Yamin, un Eker. <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />un di zin fun Onamen zainen geven: Shammai, un Yada. un di zin fun Shammaien: Nadav, un Avishur. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />un der nomen fun Avishurs vaib iz geven Avihayil; un zi hot im geborn Achbanen, un Molidn. <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />un di zin fun Nadavn: Seled, un Apayim. un Seled iz geshtorbn on kinder. <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />un di zin fun Apayimen: Yishi. un di zin fun Yishien: Sheshan. un di zin fun Sheshanen: Achlai. <verse eid="1CH 2:31" /><verse number="32" style="v" sid="1CH 2:32" />un di zin fun Yada, Shammais bruder: Yeter, un Yonatan. un Yeter iz geshtorbn on kinder.<verse eid="1CH 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 2:33" />un di zin fun Yonatanen: Pelet, un Zaza. dos zainen geven di kinder fun Yerachmeeln.<verse eid="1CH 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 2:34" />un Sheshan hot nisht gehat kein zin nor techter. un bai Sheshanen iz geven a knecht a mitsri, vos zain nomen iz geven Yarcha. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />hot Sheshan gegebn zain tochter tsu zain knecht Yarchen far a vaib; un zi hot im geborn Attaien. <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />un Attai hot geborn Natanen, un Natan hot geborn Zavadn. <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />un Zavad hot geborn Eflaln, un Eflal hot geborn Ovedn. <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />un Oved hot geborn Yehuen, un Yehu hot geborn Azaryahn. <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />un Azaryah hot geborn Cheletsen, un Chelets hot geborn Elasahn. <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />un Elasah hot geborn Sismaien, un Sismai hot geborn Shallumen. <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />un Shallum hot geborn Yekamyahn, un Yekamyah hot geborn Elishamaen.<verse eid="1CH 2:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />un di zin fun Kalev, Yerachmeels bruder: Mesha zain bechor, vos iz geven der foter fun Zifn, un di zin fun Mareshah dem foter fun Chevronen. <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />un di zin fun Chevronen zainen geven: Korach un Tapuach, un Rekem, un Shama. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />un Shama hot geborn Racham dem foter fun Yorkoamen, un Rekem hot geborn Shammaien. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />un der zun fun Shammaien iz geven Maon, un Maon iz geven der foter fun Beis-Tsur. <verse eid="1CH 2:45" /><verse number="46" style="v" sid="1CH 2:46" />un Eifah, Kalevs kepsvaib, hot geborn Charanen, un Motsaen, un Gazezn; un Charan hot geborn Gazezn. <verse eid="1CH 2:46" /><verse number="47" style="v" sid="1CH 2:47" />un di zin fun Yahdaien zainen geven: Regem, un Yotam, un Geshan, un Pelet, un Eifah, un Shaaf. <verse eid="1CH 2:47" /><verse number="48" style="v" sid="1CH 2:48" />Maachah, Kalevs kepsvaib, hot geborn Shevern, un Tirchanahn. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />un di vaib fun Shaaf dem foter fun Madmannah, hot geborn Sheva dem foter fun Machbeinah un dem foter fun Giva. un di tochter fun Kalevn iz geven Achsah. <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" />dos zainen geven di kinder fun Kalevn.</para>
  <para style="p" vid="1CH 2:50">di zin fun Chur, dem bechor fun Efratahn: Shoval der foter fun Kiryat-Yearim, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Salma der foter fun Beis-Lechem, Chareif der foter fun Beis-Gader. <verse eid="1CH 2:51" /><verse number="52" style="v" sid="1CH 2:52" />un di kinder fun Shoval dem foter fun Kiryat-Yearim zainen geven: Haroeh, un halb Menuchot. <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />un di mishpoches fun Kiryat-Yearim zainen geven: di Yeterim, un di Putim, un di shumotim, un di Mishraim. fun di dozike zainen aroisgekumen di Tsoratim, un di Eshtaolim.<verse eid="1CH 2:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 2:54" />di kinder fun Salmaen: Beis-Lechem, un di Netofatim, Atrot-Bais-Yoav, un a helft fun di Manachater, di Tsorim. <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />un di mishpoches fun di shraiber, di bavoiner fun Yabets, zainen geven: di Tiratim, di Shimeatim, di Suchatim. dos zainen di Kayinim vos kumen arois fun Chammat dem foter fun dem hoiz fun Rechav.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="1CH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />un dos zainen di zin fun Dovidn vos zainen im geborn gevorn in Chevron: der bechor, Amnon, fun Achinoamen fun Yizreel; der tsveiter, Daniel, fun Avigaln, fun Karmel; <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />der driter, Avshalom der zun fun Maachah der tochter fun Talmai dem melech fun Geshur; der firter, Adoniyah der zun fun Chagiten; <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />der finfter, Shefatyah, fun Avitaln; der zekster, Yitream, fun zain vaib Eglahn. <verse eid="1CH 3:3" /><verse number="4" style="v" sid="1CH 3:4" />di zeks zainen im geborn gevorn in Chevron; un er hot dortn gekinigt zibn yor un zeks chodeshim; un drai un draisik yor hot er gekinigt in Yerushalayim.<verse eid="1CH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 3:5" />un di dozike zainen im geborn gevorn in Yerushalayim: Shimea, un Shovav, un Natan, un Shlomo – fir, fun Bat-Shua der tochter fun Ammieln; <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />un Yivchar, un Elishama, un Elifelet; <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />un Nogah, un Nefeg, un Yafia; <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />un Elishama, un Elyada, un Elifelet – nain. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />dos zainen ale zin fun Dovidn, achuts di zin fun di kepsvaiber, un zeyer shvester Tamar.<verse eid="1CH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />un der zun fun Shlomoen iz geven Rechavam. zain zun iz geven Aviyah, zain zun Asa, zain zun Yehoshafat; <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />zain zun Yoram, zain zun Achazyahu, zain zun Yoash; <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />zain zun Amatsyahu, zain zun Azaryah, zain zun Yotam; <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />zain zun Achaz, zain zun Chizkiyah, zain zun Menasheh; <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />zain zun Amon, zain zun Yoshiyah. <verse eid="1CH 3:14" /><verse number="15" style="v" sid="1CH 3:15" />un di zin fun Yoshiyahun zainen geven: der bechor Yochanan, der tsveiter Yhoyakim der driter Tsidkiyah, der firter, Shallum. <verse eid="1CH 3:15" /><verse number="16" style="v" sid="1CH 3:16" />un di zin fun Yhoyakimen zainen geven: zain zun Yechanyah, zain zun Tsidkiyah.<verse eid="1CH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17" />un di zin fun Yechanyah dem gefangenem: zain zun Shaltiel, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />un Malkiram, un Pedayah, un Shenatsar, Yekamyah, Hoshama, un Nedavyah. <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />un di zin fun Pedayahn: Zerubavel, un Shimei. un di kinder fun Zerubaveln: Meshulam, un Chananyah, un zeyer shvester Shelomit; <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />un Chashuvah, un Ohel, un Berechyah, un Chasadyah, Yushav-Chesed – finf. <verse eid="1CH 3:20" /><verse number="21" style="v" sid="1CH 3:21" />un di zin fun Chananyahn: Pelatyah un Yeshayah. di zin fun Yeshayahn: Refayah. di zin fun Refayahn: Ornon. di zin fun Arnonen: Ovadyah. di zin fun Ovadyahn: Shechanyah. <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" />un di zin fun Shechanyahn: Shemayah. un di zin fun Shemayahn: Chattush, un Yigal, un Bariach, un Nearyah, un Shafat – zeks. <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />un di zin fun Nearyahn: Elyoeinai, un Chizkiyah, un Azrikam – drai. <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />un di zin fun Elyoeinain: Hodavyahu un Elyashiv, un Pelayah, un Akkuv, un Yochanan, un Delayah, un Anani – zibn.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="1CH 4" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />di zin fun Yehudahn: Perets, Chetsron, un Karmi, un Chur, un Shoval.<verse eid="1CH 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 4:2" />un Reayah der zun fun Shovaln hot geborn Yachaten, un Yachat hot geborn Achumain, un Lahadn. dos zainen di mishpoches fun di Tsoratim.<verse eid="1CH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 4:3" />un di dozike zainen fun dem foter fun Eitam: Yizreel, un Yishma, un Yidbash; un der nomen fun zeyer shvester iz geven Hatslelponi; <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />un Penuel der foter fun Gedor, un Ezer der foter fun Chushah. dos zainen di kinder fun Chur dem bechor fun Efratah dem foter fun Beis-Lechem.<verse eid="1CH 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 4:5" />un Ashchur der foter fun Tekoa hot gehat tsvei vaiber: Chelah, un Naarah. <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />un Naarah hot im geborn Achuzamen, un Cheferen, un Temanien, un dem Achashtari. dos zainen di zin fun Naarahn. <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />un di zin fun Chelahn: Tseret, un Tsochar, un Etnan. <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />un Kots hot geborn Anuvn, un Tsovevahn, un di mishpoches fun Acharchel dem zun fun Harumen. <verse eid="1CH 4:8" /><verse number="9" style="v" sid="1CH 4:9" />un Yabets iz geven der ongezeenster fun zaine brider; un zain muter hot gerufn zain nomen Yabets, azoi tsu zogn: vail ich hob im geborn mit pain. <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />un Yabets hot gerufn tsum Elokei Yisroel, azoi tsu zogn: oib bentshn vestu mich bentshn, un vest fargresern main gemark, un dain hant vet zain mit mir, un vest bahitn fun beiz, mich nisht vei tsu ton. un Hashem hot im bashert vos er hot gebetn.<verse eid="1CH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 4:11" />un Chelub der bruder fun Shuchahn hot geborn Mechiren, vos iz geven der foter fun Eshtonen. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />un Eshton hot geborn Beis-Rafan, un Paseachn, un Techinnah dem foter fun Ir-Nachash. dos zainen di mentshn fun Rechah.<verse eid="1CH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 4:13" />un di zin fun Kenazn zainen geven: Otniel, un Serayah. un di zin fun Otnieln: Chatat. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />un Meonotai hot geborn Ofrahn; un Serayah hot geborn Yoav dem foter fun Gey-Charashim; vorem zei zainen geven mainsters. <verse eid="1CH 4:14" /><verse number="15" style="v" sid="1CH 4:15" />un di zin fun Kalev dem zun fun Yefunehn zainen geven: Iru, Elah, un Naam. un di zin fun Elahn: Kenaz.<verse eid="1CH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 4:16" />un di zin fun Yehalleleln: Zif, un Zifah, Tirya, un Asareel. <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />un di zin fun Ezrahn: Yeter, un Mered, un Efer, un Yalon. un zi hot geborn Miryamen, un Shammaien, un Yishbach dem foter fun Eshtemoa.<verse eid="1CH 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 4:18" />un zain vaib di Yehudiyah hot geborn Yered dem foter fun Gedor, un Chever dem foter fun Socho, un Yekutiel dem foter fun Zanoach – un dos zainen di zin fun Bityah der tochter fun Pharaohn, vos Mered hot genumen.<verse eid="1CH 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 4:19" />un di zin fun Hodiyahs vaib, der shvester fun Nacham dem foter fun Keilah, zainen geven: der Garmi, un Eshtemoa der Maachati. <verse eid="1CH 4:19" /><verse number="20" style="v" sid="1CH 4:20" />un di zin fun Shimeonen: Amnon, un Rinnah, Ben-Chanan, un Tilon. un di zin fun Yishien: Zochet, un Ben-Zochet.<verse eid="1CH 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21" />di kinder fun Shelah dem zun fun Yehudahn: Er der foter fun Lechah, un Ladah der foter fun Mareshah, un di mishpoches fun dem hoiz fun di lainenarbeter fun dem hoiz fun Ashbea; <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />un Yokim, un di mentshn fun Kozeva, un Yoash, un Saraf, vos hobn gehersht iber Moav, un Yashuvi-Lechem. un di geshichte iz an alte. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />dos zainen geven di teper, un zei hobn gevoint in Netaim un Gederah; bai dem melech in zain virtshaft zainen zei dortn gezesn.<verse eid="1CH 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />di zin fun Shimeonen: Nemuel, un Yamin, Yariv, Zerach, Shaul. <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />zain zun iz geven Shallum, zain zun Mivsam, zain zun Mishma. <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />un di kinder fun Mishmaen zainen geven: zain zun Chamuel, zain zun Zakur, zain zun Shimei.<verse eid="1CH 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />un Shimei hot gehat zechtsn zin un zeks techter; ober zaine brider hobn nisht gehat fil kinder, un zeyer gantse mishpoche hot zich nisht gemert azoi vi di kinder fun Yehudah.<verse eid="1CH 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 4:28" />un zei zainen gezesn in Beer-Sheva, un Moladah, un Chatsar-Shual;<verse eid="1CH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 4:29" />un in Bilhah, un in Etsem, un in Tolad; <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />un in Betuel, un in Chormah, un in Tsiklag; <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />un in Beis-HaMarkavot, un in Chatsar-Susim, un in beit-bri, un in Shaarayim. dos zainen geven zeyere shtet biz Dovid iz gevorn melech. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />un zeyere derfer zainen geven: Eitam, un Ayin, Rimmon, un Tokhen, un Ashan – finf shtet; <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />un ale zeyere derfer vos arum di dozike shtet, biz Baal. dos zainen geven zeyere voinerter, un zeyer yiches-briv iz geven loit zei.<verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />un Meshovav, un Yamlech, un Yoshah, der zun fun Amatsyahn; <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />un Yoel, un Yehu der zun fun Yoshivyah dem zun fun Serayah dem zun fun Asieln; <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />un Elyoeinai, un Yaakovah, un Yeshochayah, un Asayah, un Adiel, un Yesimiel, un Benayah; <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />un Ziza der zun fun Shifi dem zun fun Alon, dem zun fun Yedayah, dem zun fun Shimri, dem zun fun Shemayahn – <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />di dozike vos kumen do mit di nemen, zainen geven firshtn in zeyere mishpoches; un zeyere foterhaizer hobn zich shtark farshpreit. <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />un zei zainen avek tsum aingang fun Gedor, biz tsum mizrech fun tal, tsu zuchn fiterung far zeyere shof. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />un zei hobn gefunen a fete un gute fiterung, un dos land iz geven geram, un ruik, un beshalve; vorem fun Cham zainen geven di vos zainen dortn gezesn frier. <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" />un di dozike vos zainen do farshribn mit di nemen, zainen gekumen in di teg fun Yechizkiyah dem melech fun Yehudah, un hobn geshlogn zeyere getseltn, un di MUnim vos hobn zich dortn gefunen, un zei hobn zei farvist biz oif haintikn tog, un hobn zich bazetst oif zeyer ort; vorem dortn iz geven fiterung far zeyere shof. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />un fun zei, fun di kinder fun Shimeon, zainen avek tsum barg Seir finf hundert man, un Pelatyah, un Nearyah, un Refayah, un Uziel, di zin fun Yishien, zei farois. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />un zei hobn geshlogn dem antrunenem iberblaib fun Amalek, un zainen dortn geblibn zitsn biz oif haintikn tog.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="1CH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />un di zin fun Reuven dem bechor fun Yisroeln – vorem er iz geven der bechor, ober az er hot farshvecht dos geleger fun zain foter, iz zain bechoire avekgegebn gevorn tsu di kinder fun Yosef dem zun fun Yisroeln, hagam nisht zich tsu rechenen in dem yiches-briv oif der bechoire; <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />vorem Yehudah hot aribergeshtign zaine brider, un fun im iz arois der firsht; ober di bechoire iz geven Yosefs – <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />di zin fun Reuven dem bechor fun Yisroeln zainen geven: Chanoch, un Pallu, Chetsron, un Karmi. <verse eid="1CH 5:3" /><verse number="4" style="v" sid="1CH 5:4" />di kinder fun Yoeln zainen geven: zain zun Shemayah, zain zun Gog, zain zun Shimei; <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />zain zun Michah, zain zun Reayah, zain zun Baal; <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />zain zun Beerah, vos Tilgat-Pilneser der melech fun Ashur hot fartriben; er iz geven der firsht fun di Reuvenim. <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" />un zaine brider loit zaine mishpoches, zich yechusndik loit zeyere geburtn, zainen geven: der hoipt Yeyel, un Zecharyahu; <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />un Bela der zun fun Azaz dem zun fun Shama, dem zun fun Yoeln, vos iz gezesn in Aroer, biz Nevo un Baal-Meon; <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />un tsu mizrech iz er gezesn biz me kumt tsum midber, fun taich Parat on; vorem zeyere fich hobn zich farmert in land Gilad. <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />un in di teg fun Shauln hobn zei gemacht a milchome mit di hagriim, un yene zainen gefaln durch zeyer hant; un zei hobn zich bazetst in zeyere getseltn iber der gantser gegent tsu mizrech fun Gilad.<verse eid="1CH 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />un di kinder fun Gad zainen gezesn akegn zei in land Bashan biz Salchah; <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />Yoel der hoipt, un Shafam der tsveiter, un Yanai, un Shafat, in Bashan; <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />un zeyere brider loit zeyere foterhaizer: Michael, un Meshulam, un Sheva, un Yorai, un Yakan, un Zia, un Ever – zibn. <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />dos zainen di zin fun Avihayil dem zun fun Churai, dem zun fun Yaroach, dem zun fun Gilad, dem zun fun Michael, dem zun fun Yeshishai, dem zun fun Yachdo, dem zun fun Buzen. <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />Achi der zun fun avdiel dem zun fun Gunin iz geven der hoipt fun zeyere foterhaizer. <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />un zei zainen gezesn in Gilad, in Bashan, un in ire techtershtet, un in ale ofene erter fun Sharon, bai zeyere toiern. <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />zei ale hobn zich fartseichnt in di teg fun Yotam dem melech fun Yehudah, un in di teg fun Yarovam dem melech fun Yisroel.<verse eid="1CH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />di kinder fun Reuven, un di Gadim, un der halber sheyvet Menasheh – fun heldishe yungen, mentshn vos trogn a shild un a shverd, un shpanen a boign, un zainen gelernt in milchome, zainen geven fir un fertsik toiznt un zibn hundert un zechtsik vos geyen arois in cheil. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />un zei hobn gemacht a milchome mit di hagriim, un Itur, un Nafish, un Nodav. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />un zei zainen geholfn gevorn akegn zei, un di hagriim un ale vos mit zei zainen gegebn gevorn in zeyer hant; vorem zei hobn geshrien tsu Elokim in der milchome, un er hot zich gelozt derbetn fun zei, vail zei hobn zich farzichert oif im. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />un zei hobn gefangen zeyere fich: zeyere kemlen fuftsik toiznt, un shof tsvei hundert un fuftsik toiznt, un eizlen tsvei toiznt, un nefoshes mentshn hundert toiznt. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />vorem es zainen gefaln fil dershlogene, vail di milchome iz geven fun HaElokim. un zei zainen gezesn oif dem ort fun zei biz tsum goles.<verse eid="1CH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />un di kinder fun dem halbn sheyvet Menasheh zainen gezesn in land, fun Bashan biz Baal-Chermon, un Senir, un dem barg Chermon. zei hobn zich gemert. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />un dos zainen di hoiptlait fun zeyere foterhaizer: Efer, un Yishi, un Eliel, un Azriel, un Yirmeyah, un Hodavyah, un Yachdiel, mentshn heldishe giborim, mentshn mit nemen, hoiptn fun zeyere foterhaizer.<verse eid="1CH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 5:25" />un zei hobn gefelsht on dem G-t fun zeyere eltern, un zainen geven farfirt noch di g‑ter fun di felker fun land, vos Hashem hot fartilikt fun far zei. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />un Elokei Yisroel hot dervekt dem gaist fun Pul dem melech fun Ashur, un dem gaist fun Tilgat-Pilneser dem melech fun Ashur, un er hot zei fartriben – di Reuvenim, un di Gadim, un dem halbn sheyvet Menasheh, un er hot zei gebracht kein Chalach, un Chavor, un Hara, un baim taich Gozan, biz oif haintikn tog.<verse eid="1CH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="6.1" sid="1CH 5:27" /> di zin fun Levin: Gershon, Kohat, un Merari. <verse eid="1CH 5:27" /><verse number="28" style="v" pubnumber="6.2" sid="1CH 5:28" /> un di zin fun Kohatn: Amram, Yitshar, un Chevron, un Uziel. <verse eid="1CH 5:28" /><verse number="29" style="v" pubnumber="6.3" sid="1CH 5:29" /> un di kinder fun Amramen: Aharon, un Moshe, un Miryam. un di zin fun Aharonen: Nadav, un Avihu, Elazar, un Itamar. <verse eid="1CH 5:29" /><verse number="30" style="v" pubnumber="6.4" sid="1CH 5:30" /> Elazar hot geborn Pinchasn; Pinchas hot geborn Avishuan. <verse eid="1CH 5:30" /><verse number="31" style="v" pubnumber="6.5" sid="1CH 5:31" /> un Avishua hot geborn bukin, un Buki hot geborn Uzzin. <verse eid="1CH 5:31" /><verse number="32" style="v" pubnumber="6.6" sid="1CH 5:32" /> un Uzzi hot geborn Zerachyahn, un Zerachyah hot geborn Merayoten.<verse eid="1CH 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="6.7" sid="1CH 5:33" /> Merayot hot geborn Amaryahn, un Amaryah hot geborn Achituvn. <verse eid="1CH 5:33" /><verse number="34" style="v" pubnumber="6.8" sid="1CH 5:34" /> un Achituv hot geborn Tsadokn, un Tsadok hot geborn Achimaatsn. <verse eid="1CH 5:34" /><verse number="35" style="v" pubnumber="6.9" sid="1CH 5:35" /> un Achimaats hot geborn Azaryahn, un Azaryah hot geborn Yochananen. <verse eid="1CH 5:35" /><verse number="36" style="v" pubnumber="6.10" sid="1CH 5:36" /> un Yochanan hot geborn Azaryahn; dos iz der vos iz geven a koyen in dem hoiz vos Shlomo hot geboit in Yerushalayim. <verse eid="1CH 5:36" /><verse number="37" style="v" pubnumber="6.11" sid="1CH 5:37" /> un Azaryah hot geborn Amaryahn, un Amaryah hot geborn Achituvn. <verse eid="1CH 5:37" /><verse number="38" style="v" pubnumber="6.12" sid="1CH 5:38" /> un Achituv hot geborn Tsadokn, un Tsadok hot geborn Shallumen. <verse eid="1CH 5:38" /><verse number="39" style="v" pubnumber="6.13" sid="1CH 5:39" /> un Shallum hot geborn Chilkiyahn, un Chilkiyah hot geborn Azaryahn.<verse eid="1CH 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" pubnumber="6.14" sid="1CH 5:40" /> un Azaryah hot geborn Serayahn, un Serayah hot geborn Yehotsadakn. <verse eid="1CH 5:40" /><verse number="41" style="v" pubnumber="6.15" sid="1CH 5:41" /> un Yehotsadak iz avek in goles, ven Hashem hot fartriben Yehudah un Yerushalayim durch der hant fun Nevuchadnetsarn.<verse eid="1CH 5:41" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="1CH 6" />
  <para style="p">
    <verse number="1" style="v" pubnumber="6.16" sid="1CH 6:1" /> di zin fun Levin: Gershom, Kohat, un Merari. <verse eid="1CH 6:1" /><verse number="2" style="v" pubnumber="6.17" sid="1CH 6:2" /> dos zainen di nemen fun Gershoms zin: Livni, un Shimei. <verse eid="1CH 6:2" /><verse number="3" style="v" pubnumber="6.18" sid="1CH 6:3" /> un di zin fun Kohatn zainen geven: Amram, un Yitshar, un Chevron, un Uziel. <verse eid="1CH 6:3" /><verse number="4" style="v" pubnumber="6.19" sid="1CH 6:4" /> di zin fun Merarien: Machli, un Mushi. un dos zainen di mishpoches fun Levi loit zeyere eltern. <verse eid="1CH 6:4" /><verse number="5" style="v" pubnumber="6.20" sid="1CH 6:5" /> fun Gershomen: zain zun Livni, zain zun Yachat, zain zun Zimmah; <verse eid="1CH 6:5" /><verse number="6" style="v" pubnumber="6.21" sid="1CH 6:6" /> zain zun Yoach zain zun Ido, zain zun Zerach, zain zun Yeaterai. <verse eid="1CH 6:6" /><verse number="7" style="v" pubnumber="6.22" sid="1CH 6:7" /> di kinder fun Kohatn: zain zun Amminadav, zain zun Korach zain zun Assir; <verse eid="1CH 6:7" /><verse number="8" style="v" pubnumber="6.23" sid="1CH 6:8" /> zain zun Elkanah, un zain zun EvyaSaf, un zain zun Assir; <verse eid="1CH 6:8" /><verse number="9" style="v" pubnumber="6.24" sid="1CH 6:9" /> zain zun Tachat, zain zun Uriel, zain zun Uziyah, un zain zun Shaul. <verse eid="1CH 6:9" /><verse number="10" style="v" pubnumber="6.25" sid="1CH 6:10" /> un di kinder fun Elkanahn: Amasai, un Achimot, <verse eid="1CH 6:10" /><verse number="11" style="v" pubnumber="6.26" sid="1CH 6:11" /> Elkanah. di kinder fun Elkanahn: zain zun Tsofai, un zain zun Nachat; <verse eid="1CH 6:11" /><verse number="12" style="v" pubnumber="6.27" sid="1CH 6:12" /> zain zun Eliav, zain zun Yerocham, zain zun Elkanah. <verse eid="1CH 6:12" /><verse number="13" style="v" pubnumber="6.28" sid="1CH 6:13" /> un di zin fun Shmueln: der bechor un shni, Aviyah. <verse eid="1CH 6:13" /><verse number="14" style="v" pubnumber="6.29" sid="1CH 6:14" /> di kinder fun Merarien: Machli; zain zun Livni, zain zun Shimei, zain zun Uzzah; <verse eid="1CH 6:14" /><verse number="15" style="v" pubnumber="6.30" sid="1CH 6:15" /> zain zun Shimea, zain zun Chagiyah, zain zun Asayah.<verse eid="1CH 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="6.31" sid="1CH 6:16" /> un dos zainen di vos Dovid hot geshtelt baim zingen in hoiz fun Hashem, noch dem vi der orn iz gekumen tsu zain ru. <verse eid="1CH 6:16" /><verse number="17" style="v" pubnumber="6.32" sid="1CH 6:17" /> un zei hobn gedint far dem mishkn fun ohel-moed mit gezang, biz Shlomo hot geboit dos hoiz fun Hashem in Yerushalayim, un zei hobn zich geshtelt loit zeyer ordenung bai zeyer dinst. <verse eid="1CH 6:17" /><verse number="18" style="v" pubnumber="6.33" sid="1CH 6:18" /> un dos zainen di vos zainen dortn geshtanen, mit zeyere zin: fun di zin fun di Kehatim: Heman der zinger, der zun fun Yoel dem zun fun Shmuel, <verse eid="1CH 6:18" /><verse number="19" style="v" pubnumber="6.34" sid="1CH 6:19" /> dem zun fun Elkanah, dem zun fun Yerocham, dem zun fun Eliel, dem zun fun Toach, <verse eid="1CH 6:19" /><verse number="20" style="v" pubnumber="6.35" sid="1CH 6:20" /> dem zun fun Tsuf, dem zun fun Elkanah, dem zun fun Machat, dem zun fun Amasai, <verse eid="1CH 6:20" /><verse number="21" style="v" pubnumber="6.36" sid="1CH 6:21" /> dem zun fun Elkanah, dem zun fun Yoel, dem zun fun Azaryah, dem zun fun Tsefanyah, <verse eid="1CH 6:21" /><verse number="22" style="v" pubnumber="6.37" sid="1CH 6:22" /> dem zun fun Tachat, dem zun fun Assir, dem zun fun EvyaSaf, dem zun fun Korach, <verse eid="1CH 6:22" /><verse number="23" style="v" pubnumber="6.38" sid="1CH 6:23" /> dem zun fun Yitshar, dem zun fun Kohat, dem zun fun Levi, dem zun fun Yisroeln. <verse eid="1CH 6:23" /><verse number="24" style="v" pubnumber="6.39" sid="1CH 6:24" /> un zain bruder ASaf iz geven der vos iz geshtanen tsu zain rechter hant: ASaf der zun fun Berechyah dem zun fun Shimea, <verse eid="1CH 6:24" /><verse number="25" style="v" pubnumber="6.40" sid="1CH 6:25" /> dem zun fun Michael, dem zun fun Baaseyah, dem zun fun Malkiyah, <verse eid="1CH 6:25" /><verse number="26" style="v" pubnumber="6.41" sid="1CH 6:26" /> dem zun fun Etni, dem zun fun Zerach, dem zun fun Adayah, <verse eid="1CH 6:26" /><verse number="27" style="v" pubnumber="6.42" sid="1CH 6:27" /> dem zun fun Eitan, dem zun fun Zimmah, dem zun fun Shimei, <verse eid="1CH 6:27" /><verse number="28" style="v" pubnumber="6.43" sid="1CH 6:28" /> dem zun fun Yachat, dem zun fun Gershom, dem zun fun Levin. <verse eid="1CH 6:28" /><verse number="29" style="v" pubnumber="6.44" sid="1CH 6:29" /> un zeyere brider di kinder fun Merari, oif der linker zait: Eitan der zun fun Kishi dem zun fun Avdi, dem zun fun Maluch, <verse eid="1CH 6:29" /><verse number="30" style="v" pubnumber="6.45" sid="1CH 6:30" /> dem zun fun Chashavyah, dem zun fun Amatsyah, dem zun fun Chilkiyah, <verse eid="1CH 6:30" /><verse number="31" style="v" pubnumber="6.46" sid="1CH 6:31" /> dem zun fun Amtsi, dem zun fun Bunni, dem zun fun Shemer, <verse eid="1CH 6:31" /><verse number="32" style="v" pubnumber="6.47" sid="1CH 6:32" /> dem zun fun Machli, dem zun fun Mushi, dem zun fun Merari, dem zun fun Levin. <verse eid="1CH 6:32" /><verse number="33" style="v" pubnumber="6.48" sid="1CH 6:33" /> un zeyere brider di Leviim zainen geven opgegebn tsu dem gantsn dinst fun dem mishkn fun dem hoiz fun Elokim.<verse eid="1CH 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="6.49" sid="1CH 6:34" /> un Aharon un zaine kinder hobn gedemft oif dem mizbeyech far brandopfer un oif dem mizbeyech far vairech; zei zainen geven far yetveder arbet fun dem kodshei-kodshim, un oif mechaper tsu zain oif Yisroel, loit alts vos Moshe der knecht fun HaElokim hot bafoiln. <verse eid="1CH 6:34" /><verse number="35" style="v" pubnumber="6.50" sid="1CH 6:35" /> un dos zainen di kinder fun Aharon: zain zun Elazar, zain zun Pinchas, zain zun Avishua; <verse eid="1CH 6:35" /><verse number="36" style="v" pubnumber="6.51" sid="1CH 6:36" /> zain zun Buki, zain zun Uzzi, zain zun Zerachyah; <verse eid="1CH 6:36" /><verse number="37" style="v" pubnumber="6.52" sid="1CH 6:37" /> zain zun Merayot, zain zun Amaryah, zain zun Achituv; <verse eid="1CH 6:37" /><verse number="38" style="v" pubnumber="6.53" sid="1CH 6:38" /> zain zun Tsadok, zain zun Achimaats.<verse eid="1CH 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" pubnumber="6.54" sid="1CH 6:39" /> un dos zainen geven zeyere voinerter loit zeyere lagerderfer in zeyer gemark: tsu di kinder fun Aharon fun der mishpoche fun di Kehatim vail zeyers iz geven goirl, <verse eid="1CH 6:39" /><verse number="40" style="v" pubnumber="6.55" sid="1CH 6:40" /> zei hot men gegebn Chevron in land Yehudah mit ire fraie peletser rund arum ir. <verse eid="1CH 6:40" /><verse number="41" style="v" pubnumber="6.56" sid="1CH 6:41" /> ober dos feld fun der shtot un ire derfer hot men gegebn tsu Kalev dem zun fun Yefunehn. <verse eid="1CH 6:41" /><verse number="42" style="v" pubnumber="6.57" sid="1CH 6:42" /> un tsu di kinder fun Aharon hot men gegebn di shtet fun antrinung, Chevron, un Livnah mit ire fraie peletser, un Yatir, un Eshtemoa mit ire fraie peletser; <verse eid="1CH 6:42" /><verse number="43" style="v" pubnumber="6.58" sid="1CH 6:43" /> un Chiln mit ire fraie peletser, Devir mit ire fraie peletser; <verse eid="1CH 6:43" /><verse number="44" style="v" pubnumber="6.59" sid="1CH 6:44" /> un Ashan mit ire fraie peletser, un Beis-Shemesh mit ire fraie peletser. <verse eid="1CH 6:44" /><verse number="45" style="v" pubnumber="6.60" sid="1CH 6:45" /> un fun sheyvet Binyamin: Geva mit ire fraie peletser, un Alemet mit ire fraie peletser, un Anatot mit ire fraie peletser. ale zeyere shtet, draitsn shtet, loit zeyere mishpoches.<verse eid="1CH 6:45" /></para>
  <para style="p">
    <verse number="46" style="v" pubnumber="6.61" sid="1CH 6:46" /> un far di iberike kinder fun Kohat, fun der mishpoche fun dem sheyvet, fun dem halbn sheyvet, fun halb Menasheh, loit goirl, tsen shtet. <verse eid="1CH 6:46" /><verse number="47" style="v" pubnumber="6.62" sid="1CH 6:47" /> un far di kinder fun Gershom loit zeyere mishpoches, fun sheyvet Yissachar, un fun sheyvet Asher, un fun sheyvet Naftali, un fun sheyvet Menasheh in Bashan, draitsn shtet. <verse eid="1CH 6:47" /><verse number="48" style="v" pubnumber="6.63" sid="1CH 6:48" /> far di kinder fun Merari loit zeyere mishpoches, fun sheyvet Reuven, un fun sheyvet Gad, un fun sheyvet Zevulun, loit goirl, tsvelf shtet. <verse eid="1CH 6:48" /><verse number="49" style="v" pubnumber="6.64" sid="1CH 6:49" /> un di kinder fun Yisroel hobn gegebn tsu di Leviim di shtet mit zeyere fraie peletser. <verse eid="1CH 6:49" /><verse number="50" style="v" pubnumber="6.65" sid="1CH 6:50" /> un zei hobn gegebn loit goirl, fun dem sheyvet fun di kinder fun Yehudah, un fun dem sheyvet fun di kinder fun Shimeon, un fun dem sheyvet fun di kinder fun Binyamin, di dozike shtet vos me ruft do on mit di nemen.<verse eid="1CH 6:50" /></para>
  <para style="p">
    <verse number="51" style="v" pubnumber="6.66" sid="1CH 6:51" /> un teil fun di mishpoches fun di kinder fun Kohat hobn gehat di shtet fun zeyer gemark fun sheyvet Efrayim. <verse eid="1CH 6:51" /><verse number="52" style="v" pubnumber="6.67" sid="1CH 6:52" /> un me hot zei gegebn di shtet fun antrinung, Shechem mit ire fraie peletser oifn barg Efrayim, un Gezer mit ire fraie peletser; <verse eid="1CH 6:52" /><verse number="53" style="v" pubnumber="6.68" sid="1CH 6:53" /> un Yokmeam mit ire fraie peletser, un Beis-Choron mit ire fraie peletser. <verse eid="1CH 6:53" /><verse number="54" style="v" pubnumber="6.69" sid="1CH 6:54" /> un Ayalon mit ire fraie peletser, un Gat-Rimmon, mit ire fraie peletser. <verse eid="1CH 6:54" /><verse number="55" style="v" pubnumber="6.70" sid="1CH 6:55" /> un fun dem halbn sheyvet Menasheh: Aner mit ire fraie peletser, un Bilaam mit ire fraie peletser, far der mishpoche fun di iberike kinder fun Kohat.<verse eid="1CH 6:55" /></para>
  <para style="p">
    <verse number="56" style="v" pubnumber="6.71" sid="1CH 6:56" /> far di kinder fun Gershom, fun der mishpoche fun dem halbn sheyvet Menasheh: Golan in Bashan mit ire fraie peletser, un Ashtarot mit ire fraie peletser. <verse eid="1CH 6:56" /><verse number="57" style="v" pubnumber="6.72" sid="1CH 6:57" /> un fun sheyvet Yissachar: Kedesh mit ire fraie peletser, Dovrat mit ire fraie peletser. <verse eid="1CH 6:57" /><verse number="58" style="v" pubnumber="6.73" sid="1CH 6:58" /> un Ramot mit ire fraie peletser, un Anem mit ire fraie peletser. <verse eid="1CH 6:58" /><verse number="59" style="v" pubnumber="6.74" sid="1CH 6:59" /> un fun sheyvet Asher: Mashal mit ire fraie peletser, un Avdon mit ire fraie peletser. <verse eid="1CH 6:59" /><verse number="60" style="v" pubnumber="6.75" sid="1CH 6:60" /> un Chukok mit ire fraie peletser, un Rechov mit ire fraie peletser. <verse eid="1CH 6:60" /><verse number="61" style="v" pubnumber="6.76" sid="1CH 6:61" /> un fun sheyvet Naftali: Kedesh in Galil mit ire fraie peletser, un Chammon mit ire fraie peletser, un Kiryatayim mit ire fraie peletser.<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" pubnumber="6.77" sid="1CH 6:62" /> far di iberike, di kinder fun Merari, fun sheyvet Zevulun: Rimmon mit ire fraie peletser, Tavor mit ire fraie peletser. <verse eid="1CH 6:62" /><verse number="63" style="v" pubnumber="6.78" sid="1CH 6:63" /> un fun yener zait Yarden bai Yericho, tsu mizrech fun Yarden, fun sheyvet Reuven: Betser in midber mit ire fraie peletser, un Yahtsah mit ire fraie peletser; <verse eid="1CH 6:63" /><verse number="64" style="v" pubnumber="6.79" sid="1CH 6:64" /> un Kedemot mit ire fraie peletser, un Mefaat mit ire fraie peletser. <verse eid="1CH 6:64" /><verse number="65" style="v" pubnumber="6.80" sid="1CH 6:65" /> un fun sheyvet Gad: Ramot in Gilad mit ire fraie peletser, un Machanayim mit ire fraie peletser; <verse eid="1CH 6:65" /><verse number="66" style="v" pubnumber="6.81" sid="1CH 6:66" /> un Cheshbon mit ire fraie peletser, un Yazeir mit ire fraie peletser.<verse eid="1CH 6:66" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="1CH 7" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />un fun di zin fun Yissachar zainen geven: Tola, un Puah, Yashuv, un Shimron – fir. <verse eid="1CH 7:1" /><verse number="2" style="v" sid="1CH 7:2" />un di zin fun Tolaen: Uzzi, un Refayah, un Yeriel, un Yachmai, un Yivsam, un Shmuel, hoiptn fun zeyere foterhaizer – fun Tola – loit zeyere geburtn, heldishe giborim. zeyer tsol in di teg fun Dovidn iz geven tsvei un tsvantsik toiznt un zeks hundert. <verse eid="1CH 7:2" /><verse number="3" style="v" sid="1CH 7:3" />un di zin fun Uzzin zainen geven: Yizrachyah; un di zin fun Yizrachyahn: Michael, un Ovadyah, un Yoel, Yishiyah – finf; ale hoiptn. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />un tsu zei hobn gehert, loit zeyere geburtn, loit zeyere foterhaizer, machnus krig-cheil, zeks un draisik toiznt; vorem zei hobn gehat fil vaiber un zin. <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />un zeyere brider fun ale mishpoches fun Yissachar, heldishe giborim – zeyer fartseichenish, in alemen: zibn un achtsik toiznt.<verse eid="1CH 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />fun Binyaminen: Bela, un Becher, un Yediael – drai. <verse eid="1CH 7:6" /><verse number="7" style="v" sid="1CH 7:7" />un di zin fun Belen: Etsbon, un Uzzi, un Uziel, un Yerimot, un Iri – finf, hoiptn fun foterhaizer, heldishe giborim; un zeyer fartseichenish: tsvei un tsvantsik toiznt un fir un draisik. <verse eid="1CH 7:7" /><verse number="8" style="v" sid="1CH 7:8" />un di zin fun Becheren: Zemirah, un Yoash, un Eliezer, un Elyoeinai, un Omri, un Yeremot, un Aviyah, un Anatot, un Alemet; di ale zainen geven di zin fun Becheren. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />un zeyer fartseichenish loit zeyere geburtn, loit di hoiptn fun zeyere foterhaizer, heldishe giborim: tsvantsik toiznt un tsvei hundert. <verse eid="1CH 7:9" /><verse number="10" style="v" sid="1CH 7:10" />un di zin fun Yediaeln: Bilhan; un di zin fun Bilhanen: Yeush un Binyamin, un Ehud, un Kenaanah, un Zeitan, un Tarshish un Achishachar.<verse eid="1CH 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 7:11" />di ale zainen geven di kinder fun Yediael loit di hoiptn fun di foterhaizer, heldishe giborim, zibetsn toiznt un tsvei hundert vos geyen arois in cheil oif milchome. <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />dertsu Shupim, un Chupim, di zin fun Irn; Chushim, der zun fun Achern.<verse eid="1CH 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />di zin fun Naftalien: Yachtsiel, un Guni, un Yetser, un Shallum, di kinder fun Bilhahn.<verse eid="1CH 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />di zin fun Menashehn: Asriel vos zain vaib hot geborn – zain Aramishe kepsvaib hot geborn Machir dem foter fun Gilad; <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />un Machir hot genumen a vaib fun Chupim un Shupim, un der nomen fun zeyer shvester iz geven Maachah – un der nomen fun tsveitn iz geven Tselofechad; un Tselofechad hot gehat techter. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />un Maachah di vaib fun Machiren hot geborn a zun, un zi hot gerufn zain nomen Peresh; un der nomen fun zain bruder iz geven Sheresh, un zaine zin zainen geven Ulam, un Rekem. <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />un di zin fun Ulamen: Bedan, dos zainen di kinder fun Gilad dem zun fun Machir, dem zun fun Menashehn. <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />un zain shvester Hammolechet hot geborn Ishhodn, un Aviezern, un Machlahn. <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />un di zin fun Shemidaen zainen geven: Achyan, un Shechem, un Likchi, un Aniam.<verse eid="1CH 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />un di zin fun Efrayimen: Shutelach – un zain zun iz geven Bered, un zain zun Tachat, un zain zun Eladah, un zain zun Tachat; <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />un zain zun Zavad, un zain zun Shutelach – un Ezer, un Elad. un di mentshn fun Gat, di aingeborene fun land hobn zei geharget, vail zei hobn aropgenidert avektsunemen zeyere fich. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />un zeyer foter Efrayim hot getroiert fil teg, un zaine brider zainen gekumen im treistn. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />un er iz gekumen tsu zain vaib, un zi iz trogedik gevorn, un hot geborn a zun, un er hot gerufn zain nomen Beriah vail an umglik iz geshen in zain hoiz. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />un zain tochter iz geven Sheerah, un zi hot geboit Beis-Choron, di untershte un di oibershte, un Uzein-Sheerah. <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />un zain zun iz geven Refach, un Reshef, un zain zun Telach, un zain zun Tachan; <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />zain zun Ladan, zain zun Ammihud, zain zun Elishama; <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />zain zun Nun, zain zun Yehoshua. <verse eid="1CH 7:27" /><verse number="28" style="v" sid="1CH 7:28" />un zeyer eigentum un zeyere voinerter iz geven Beis-El mit ire techtershtet, un tsu mizrech, Naaran, un tsu mayrev Gezer mit ire techtershtet, un Shechem mit ire techtershtet, biz Ayah mit ire techtershtet. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />un lebn di kinder fun Menasheh, Beis-Shean mit ire techtershtet, Tanakh mit ire techtershtet, Megiddo mit ire techtershtet, dor mit ire techtershtet. in di dozike zainen gezesn di kinder fun Yosef dem zun fun Yisroeln.<verse eid="1CH 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />di kinder fun Ashern: Yimnah, un Yishvah, un Yishvi, un Beriah, un zeyer shvester Serach. <verse eid="1CH 7:30" /><verse number="31" style="v" sid="1CH 7:31" />un di zin fun Beriahn: Chever, un Malkiel, dos iz der foter fun Birzayit. <verse eid="1CH 7:31" /><verse number="32" style="v" sid="1CH 7:32" />un Chever hot geborn Yafleten, un Shomeirn, un Chotamen, un zeyer shvester Shuaen. <verse eid="1CH 7:32" /><verse number="33" style="v" sid="1CH 7:33" />un di zin fun Yafleten zainen geven: Pasach, un Bimhal, un Ashvat. dos zainen di zin fun Yafleten. <verse eid="1CH 7:33" /><verse number="34" style="v" sid="1CH 7:34" />un di zin fun Shemern: Achi, un Rohgah, un Chubbah, un Aram. <verse eid="1CH 7:34" /><verse number="35" style="v" sid="1CH 7:35" />un di zin fun zain bruder Helemen: Tsofach un Yimna, un Shelesh, un Amal. <verse eid="1CH 7:35" /><verse number="36" style="v" sid="1CH 7:36" />di zin fun Tsofachn: Suach, un Charnefer, un Shual, un Beri, un Yimrah; <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Betser, un Hod, un Shamma, un Shilshah, un Yitran, un Beera. <verse eid="1CH 7:37" /><verse number="38" style="v" sid="1CH 7:38" />un di zin fun Yetern: Yefuneh, un Pispah, un Ara. <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />un di zin fun Ullan: Arach, un Channiel, un Ritsya. <verse eid="1CH 7:39" /><verse number="40" style="v" sid="1CH 7:40" />di ale zainen geven di kinder fun Asher, hoiptn fun di foterhaizer, geklibene heldishe giborim, uberfirshtn; un zeyer fartseichenish in cheil far milchome – zeyer tsol: zeks un tsvantsik toiznt man.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="1CH 8" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />un Binyamin hot geborn Bela zain bechor, Ashbel dem tsveitn, un Achrach dem dritn; <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />Nochah dem firtn, un Rafa dem finftn. <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />un Bela hot gehat zin: Addar, un Gera, un Avihud; <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />un Avishua, un Naaman, un achocha; <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />un Gera, un Shefufan, un Churam.<verse eid="1CH 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 8:6" />un dos zainen di zin fun Echudn: – di dozike zainen geven hoiptn fun foterhaizer fun di bavoiner fun Geva, un me hot zei fartriben kein Manachat; <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />un Naaman, un Achiyah, un Gera, zei hobn zei fartriben – er hot geborn Uzzan, un Achichudn. <verse eid="1CH 8:7" /><verse number="8" style="v" sid="1CH 8:8" />un Shacharayim hot gehat kinder in feld fun Moav, noch dem vi er hot zei avekgeshikt – zaine vaiber, Chushim, un Baara. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />un er hot gehat mit zain vaib Chodeshn: Yovavn, un Tsivyaen, un Meshaen, un Malkamen; <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />un Yeutsn, un Sochyahn, un Mirmahn. dos zainen geven zaine zin – hoiptn fun foterhaizer. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />un mit Chushimen hot er gehat Avituvn, un Elpaaln.<verse eid="1CH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 8:12" />un di zin fun Elpaaln: Ever, un Misham, un Shemed, vos hot geboit Ono, un Lud mit ire techtershtet; <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />un Beriah, un Shama, vos zainen geven hoiptn fun di foterhaizer fun di bavoiner fun Ayalon, di vos hobn faryogt di bavoiner fun Gat. <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />un Achyo, Shashak, un Yeremot, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />un Zevadyah, un Arad, un Eder, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />un Michael, un Yishpah, un Yocha, zainen geven di zin fun Beriahn. <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />un Zevadyah, un Meshulam, un Chizki, un Chever, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />un Yishmerai, un Yizliah, un Yovav, zainen geven di zin fun Elpaaln. <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />un Yakim, un Zichri, un Zavdi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />un Elyoeinai, un Tsilletai, un Eliel, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />un Adayah, un Berayah, un Shimrat, zainen geven di zin fun Shimeyen. <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />un Yishpan, un Ever, un Eliel, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />un Avdon, un Zichri, un Chanan, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />un Chananyah, un Eilam, un Antotiyah, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />un Yifdeyah, un Penuel, zainen geven di zin fun Shashakn. <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />un Shamsherai, un Shecharyah, un Atalyah, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />un Yaareshyah, un Eliyah, un Zichri, zainen geven di zin fun Yerochamen. <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />di dozike zainen geven hoiptn fun foterhaizer – loit zeyere geburtn, hoiptn. di dozike zainen gezesn in Yerushalayim.<verse eid="1CH 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29" />un in Givon zainen gezesn: der foter fun Givon, vos der nomen fun zain vaib iz geven Maachah; <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />un zain ershtgeborener zun Avdon, un Tsur, un Kish, un Baal, un Nadav; <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />un Gedor, un Achyo, un Zecher. <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />un Miklot hot geborn Shimeahn. un zei oich mit zeyere brider zainen gezesn in Yerushalayim, akegn zeyere brider.<verse eid="1CH 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 8:33" />un Ner hot geborn Kishon, un Kish hot geborn Shauln, un Shaul hot geborn Yonatanen, un Malki-Shuaen, un Avinadavn, un Eshbaaln. <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />un Yonatans zun iz geven Meriv-Baal; un Meriv-Baal hot geborn Michahn. <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />un di zin fun Michahn zainen geven: Piton, un Melech, un Tarea, un Achaz. <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />un Achaz hot geborn Yehoadahn; un Yehoadah hot geborn Alemeten, un Azmavetn, un Zimrien; un Zimri hot geborn Motsaen. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />un Motsa hot geborn Binan; zain zun iz geven Rafa, zain zun Elasah, zain zun Atsel. <verse eid="1CH 8:37" /><verse number="38" style="v" sid="1CH 8:38" />un Atsel hot gehat zeks zin, un dos zainen zeyere nemen: Azrikam, Bocheru, un Yishmael, un Shearyah, un Ovadyah, un Chanan. di ale zainen geven di zin fun Atseln. <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />un di zin fun zain bruder Eshekn: Ulam zain bechor, Yeush der tsveiter, un Elifelet der driter. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />un di zin fun Ulamen zainen geven mentshn heldishe giborim, boignshpaner; un zei hobn gehat fil kinder un kinds-kinder – hundert un fuftsik. di ale zainen geven fun di kinder fun Binyamin.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />un gants Yisroel hobn zich fartseichnt, un zei zainen farshribn in buch fun di mlochim fun Yisroel. un Yehudah iz fartriben gevorn kein Bavel far zeyer felshung. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />un di vos hobn zich di ershte bazetst oif zeyer eigentum in zeyere shtet, zainen geven, Yisroel, di koyanim, di Leviim, un di Netenim. <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />un in Yerushalayim zainen gezesn fun di kinder fun Yehudah, un fun di kinder fun Binyamin, un fun di kinder fun Efrayim un Menasheh: <verse eid="1CH 9:3" /><verse number="4" style="v" sid="1CH 9:4" />Utai der zun fun Ammihud dem zun fun Omri, dem zun fun Imrien, dem zun fun Bunnien, fun di zin fun Perets dem zun fun Yehudahn. <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />un fun di Shelanim: Asayah der bechor, un zaine zin. <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />un fun di kinder fun Zerach: Yeuel, un zeyere brider, zeks hundert un naintsik. <verse eid="1CH 9:6" /><verse number="7" style="v" sid="1CH 9:7" />un fun di kinder fun Binyamin: Salu der zun fun Meshulam dem zun fun Hodavyah, dem zun fun Hasnuahn; <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />un Yivniyah der zun fun Yerochamen, un Elah der zun fun Uzzi dem zun fun Michrien, un Meshulam der zun fun Shefatyah dem zun fun Reuel, dem zun fun Yivniyahn; <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />un zeyere brider loit zeyere geburtn, nain hundert un zeks un fuftsik. di ale mener zainen geven hoiptn fun foterhaizer loit zeyere foterhaizer.<verse eid="1CH 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />un fun di koyanim: Yedayah, un Yehoyariv, un Yachin; <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />un Azaryah der zun fun Chilkiyah dem zun fun Meshulam, dem zun fun Tsadok, dem zun fun Merayot, dem zun fun Achituv, der firsht fun hoiz fun Elokim; <verse eid="1CH 9:11" /><verse number="12" style="v" sid="1CH 9:12" />un Adayah der zun fun Yerocham dem zun fun Pashchur, dem zun fun Malkiyahn, un Maasai der zun fun Adiel dem zun fun Yachzerah, dem zun fun Meshulam, dem zun fun Meshilemit, dem zun fun Immern; <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />un zeyere brider, hoiptn fun zeyere foterhaizer, toiznt un zibn hundert un zechtsik toigleche lait far der dinstarbet fun hoiz fun Elokim.<verse eid="1CH 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14" />un fun di Leviim: Shemayah der zun fun Chashuv dem zun fun Azrikam, dem zun fun Chashavyahn, fun di kinder fun Merari; <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />un Bakbakkar, Cheresh, un Galal, un Matanyah der zun fun Micha dem zun fun Zichri, dem zun fun ASafn; <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />un Ovadyah der zun fun Shemayah dem zun fun Galal, dem zun fun Yedutunen, un Berechyah der zun fun Asa dem zun fun Elkanahn, vos iz gezesn in di derfer fun di Netofatim.<verse eid="1CH 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />un di toierlait zainen geven: Shallum, un Akkuv, un Talmon, un Achiman; un zeyer bruder Shallum iz geven der hoipt. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />un noch biz aher zainen zei in dem melechs toier tsu mizrech; zei zainen di toierlait far di lagern fun di kinder fun Levi. <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />un Shallum der zun fun Kore dem zun fun EvyaSaf, dem zun fun Korachn, un zaine brider fun zain foters hoiz, di Korachim, zainen geven iber der dinstarbet, di shvelhiter fun dem getselt, azoi vi zeyere eltern zainen geven iber dem lager fun Hashem, di hiter fun dem aingang. <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />un Pinchas der zun fun Elazarn iz geven der firsht iber zei a mol; Hashem iz mit im geven. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Zecharyah der zun fun Meshelemyahn iz geven der toierman baim aingang fun ohel-moed. <verse eid="1CH 9:21" /><verse number="22" style="v" sid="1CH 9:22" />zei ale, di oisgeklibene far toierlait bai di shveln, tsvei hundert un tsvelf. zei zainen geven fartseichnt loit zeyere derfer; zei hot Dovid un Shmuel der zeer geshtelt oif zeyer amt. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />un zei un zeyere kinder zainen geven iber di toiern fun dem hoiz fun Hashem, fun dem hoiz fun getselt, far vachn. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />in fir zaitn zainen geven di toierlait: in mizrech, in mayrev, in tsofn, un in dorem. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />un zeyere brider in zeyere derfer hobn gedarft kumen oif zibn teg, fun tsait tsu tsait, tsu zain mit di dozike; <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />vorem oif shtendik zainen geven nor di fir hoipttoierlait. dos zainen geven di Leviim. oich zainen zei geven iber di kamern, un iber di oitseres fun hoiz fun Elokim. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />un zei hobn genechtikt arum dem hoiz fun Elokim, vail oif zei iz geven di hitung, un zai hobn unter zich gehat dem shlisel , kedei es tsu efenen, morgn far morgn. <verse eid="1CH 9:27" /><verse number="28" style="v" sid="1CH 9:28" />un teil fun zei zainen geven iber di keilim fun dinst, vorem mit a tsol hot men zei araingebracht, un mit a tsol hot men zei aroisgenumen. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />un teil fun zei zainen geven geshtelt iber di zachn, un iber ale heilike keilim, un iber dem zemelmel, un dem vain, un dem eil, un dem vairech, un di b'somaim. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />un teil fun di zin fun di koyanim hobn tsubareit di tsubareitung fun di b'somaim. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />un Mattityah fun di Leviim, vos iz geven der bechor fun Shallum dem Korchi, hot gehat dem amt iber di fangebeksn. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />un teil fun di kinder fun di Kehatim, fun zeyere brider, zainen geven ibern oisgeleigtn broit, dos tsutsugreitn Shabbos in Shabbos.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />un dos zainen geven di zingers, hoiptn fun foterhaizer fun di Leviim, in di kamern, petur vail tog un nacht iz oif zei geven di arbet. <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />di dozike zainen geven hoiptn fun di foterhaizer fun di Leviim – loit zeyere geburtn, hoiptn. di dozike zainen gezesn in Yerushalayim.<verse eid="1CH 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />un in Givon zainen gezesn: der foter fun Givon, Yeyel, vos der nomen fun zain vaib iz geven Maachah; <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />un zain zun der bechor, Avdon, un Tsur, un Kish, un Baal, un Ner, un Nadav; <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />un Gedor, un Achyo, un Zecharyah, un Miklot. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />un Miklot hot geborn Shimamen. un zei oich zainen gezesn mit zeyere brider in Yerushalayim, akegn zeyere brider.<verse eid="1CH 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 9:39" />un Ner hot geborn Kishon; un Kish hot geborn Shauln; un Shaul hot geborn Yonatanen, un Malki-Shuaen, un Avinadavn, un Eshbaaln. <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />un Yonatans zun iz geven Meriv-Baal, un Meriv-Baal hot geborn Michahn. <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />un di zin fun Michahn zainen geven: Piton, un Melech, un Tachrea, un Achaz. <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />un Achaz hot geborn Yarahn; un Yarah hot geborn Alemeten, un Azmavetn, un Zimrien; un Zimri hot geborn Motsaen. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />un Motsa hot geborn Binan; un zain zun iz geven Refayah, zain zun Elasah, zain zun Atsel. <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />un Atsel hot gehat zeks zin, un dos zainen zeyere nemen: Azrikam, Bocheru, un Yishmael, un Shearyah, un Ovadyah, un Chanan. dos zainen di zin fun Atseln.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" pubnumber="י" sid="1CH 10" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />un di Pelishtim hobn milchome gehaltn mit Yisroel, un di mener fun Yisroel zainen antlofn far di Pelishtim, un zei zainen gefaln dershlogene oifn barg Gilboa. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />un di Pelishtim hobn nochgeyogt Shauln un zaine zin, un di Pelishtim hobn dershlogn Yonatan, un Avinadav, un Malki-Shua, di zin fun Shauln. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />un di milchome iz geven shver akegn Shauln, un di boignshisers hobn im gefunen, un er hot getsitert far di shisers. <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />un Shaul hot gezogt tsu zain vafntreger: tsi arois dain shverd, un dershtech mich mit ir, az di dozike umbashnitene zoln nisht kumen, un machn geshpet iber mir. ober zain vafntreger hot nisht gevolt, vorem er hot zeyer moire gehat. hot Shaul genumen di shverd, un iz aroifgefaln oif ir. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />un vi zain vafntreger hot gezen, az Shaul iz geshtorbn, iz er oich aroifgefaln oif zain shverd, un iz geshtorbn. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />azoi iz geshtorbn Shaul; un zaine drai zin un zain gants hoizgezint in einem zainen geshtorbn.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />un vi ale mener fun Yisroel vos in tal hobn gezen, az yene zainen antlofn, un az Shaul un zaine zin zainen toit, azoi hobn zei farlozen zeyere shtet, un zainen antlofn. un di Pelishtim zainen gekumen, un hobn zich in zei bazetst.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />un es iz geven oif morgn, zainen di Pelishtim gekumen oiston di dershlogene, un zei hobn gefunen Shauln un zaine drai zin, gefaln oifn barg Gilboa. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />hobn zei im oisgeton, un hobn genumen zain kop, un zaine vafn, un geshikt in land fun di Pelishtim rund arum, tsu brengen di besoire tsu zeyere getsnbilder un tsum folk. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />un zei hobn avekgeleigt zaine vafn in hoiz fun zeyere g‑ter, un zain sharbn hobn zei oifgeshtochn in hoiz fun Dagon.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />un gants Yavesh-Gilad hot gehert alts vos di Pelishtim hobn geton tsu Shauln, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />un ale heldishe lait zainen oifgeshtanen, un zei hobn genumen dem laib fun Shauln, un di laiber fun zaine zin, un zei gebracht kein Yaveish; un zei hobn bagrobn zeyere beiner unter dem eichnboim in Yaveish; un zei hobn gefast zibn teg.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />un Shaul iz geshtorbn far zain felshung vos er hot gefelsht on Hashem fun vegen dem vort fun Hashem vos er hot nisht gehit, un oich far vos Shaul hot gefregt bai a gaist tsu forshn bai im, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />un nisht gefregt bai Hashem; derum hot er im geteit, un hot opgekert di meluche tsu Dovid dem zun fun Yishaien.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="1CH 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />un gants Yisroel hobn zich aingezamlt tsu Dovidn kein Chevron, azoi tsu zogn: dain bein un dain fleish zainen mir doch.<verse eid="1CH 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 11:2" />noch fun nechtn un eyernechtn, noch ven Shaul iz geven a melech, bistu geven der vos hot aroisgefirt un araingefirt Yisroel. un Hashem dain G-t hot tsu dir gezogt: du zolst fitern main folk Yisroel, un du zolst zain a firsht iber main folk Yisroel.<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />un ale eltste fun Yisroel zainen gekumen tsum melech kein Chevron, un Dovid hot zei geshlosn a bris in Chevron far Hashem, un zei hobn gezalbt Dovidn far a melech iber Yisroel, azoi vi Hashems vort durch Shmueln.<verse eid="1CH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />un Dovid un gants Yisroel zainen gegangen kein Yerushalayim, dos iz Yevus; un dortn zainen geven di Yevusim, di bavoiner fun land. <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />hobn di bavoiner fun Yevus gezogt tsu Dovidn: vest aher nisht kumen. ober Dovid hot batsvungen di festung fun Tsiyon, dos iz Dovids-shtot. <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />un Dovid hot gezogt: ver nor es vet tsuersht shlogn dem Yevusi zol vern far a hoiptman un far a har. iz Yoav der zun fun Tseruyahn aroifgegangen tsum ershtn, un er iz gevorn far a hoiptman. <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />un Dovid hot zich bazetst in der festung, derum hot men zi gerufn Dovids-shtot. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />un er hot farboit di shtot rund arum, fun milo biz rund arum. un Yoav hot farricht dem resht fun der shtot. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />un Dovid iz gevorn alts greser, un Hashem Tseva'ot iz geven mit im.<verse eid="1CH 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />un dos zainen di hoipt-giborim vos Dovid hot gehat, di vos hobn fest gehaltn mit im in zain meluche, in einem mit gants Yisroel, im tsu machn far a melech, azoi vi dos vort fun Hashem tsu Yisroel. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />un dos iz di tsol fun di giborim vos Dovid hot gehat: Yashovam der zun fun Chachmonien, der hoiptman fun di eltste; er hot oifgehoibn zain shpiz oif drai hundert, un zei dershlogn oif ein mol. <verse eid="1CH 11:11" /><verse number="12" style="v" sid="1CH 11:12" />un noch im, Elazar der zun fun Dedan, fun Achoach; er iz geven fun di drai giborim. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />er iz geven mit Dovidn in Pas-Dammim, ven di Pelishtim hobn zich dortn aingezamlt oif milchome; un dortn iz geven a shtik feld ful mit gershtn; un dos folk iz antlofn far di Pelishtim. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />hobn zei zich geshtelt in mitn fun dem shtik land, un hobn es matsl geven; un zei hobn geshlogn di Pelishtim, un Hashem hot zei geholfn a grois hilf.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />un drai fun di draisik hoiptlait hobn aropgenidert tsum feldz tsu Dovidn in der heil fun Adulam; un di machne fun di Pelishtim hot gelagert in tal Refaim. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />un Dovid iz dentsmol geven in der festung, un di vach fun di Pelishtim iz dentsmol geven in Beis-Lechem. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />hot Dovid geglust, un er hot gezogt: ven emitser git mir trinken vaser fun dem brunem fun Beis-Lechem vos in toier! <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />hobn di drai durchgebrochn in lager fun di Pelishtim, un hobn ongeshept vaser fun dem brunem fun Beis-Lechem vos in toier, un genumen un gebracht tsu Dovidn. ober Dovid hot es nisht gevolt trinken, un hot es oisgegosen far Hashem.<verse eid="1CH 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 11:19" />un er hot gezogt: bahit mich main G-t fun dos tsu ton! dos blut fun di dozike mentshn mit zeyer lebn zol ich trinken? vorem mit der sekone fun zeyer lebn hobn zei es gebracht. un er hot es nisht gevolt trinken. dos hobn geton di drai giborim.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />un Avishai der bruder fun Yoavn, er iz geven der hoipt fun di drai; un er hot oifgehoibn zain shpiz oif drai hundert, un zei dershlogn; un er hot gehat a shem tsvishn di drai. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />fun di tsveite drai iz er geven der ongezeenster, un er iz geven zeyer eltster, ober tsu di ershte drai iz er nisht gekumen.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Benayah der zun fun Yehoyadaen, der zun fun a heldishn man fun fil oiftuen, fun Kavtseel, er hot geshlogn di tsvei leibe shtarke fun Moav, un er hot aropgenidert, un hot dershlogn a leib in a grub in a tog fun shnei. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />un er hot dershlogn a Mitsrishn man, a man fun a groisn vuks, finf eiln; un in dem Mitsris hant iz geven a shpiz azoi vi der shtang fun veber, un er hot aropgenidert tsu im mit a rut; hot er aroisgerisn dem shpiz fun dem Mitsris hant, un hot im geharget mit zain eigenem shpiz.<verse eid="1CH 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 11:24" />dos hot geton Benayahu der zun fun Yehoyadaen, un er hot gehat a shem tsvishn di drai giborim. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />er iz geven mer ongezen fun di draisik, ober tsu di drai iz er nisht gekumen. un Dovid hot im oifgezetst iber zain laibvach.<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />un di heldishe giborim zainen geven: Asahel der bruder fun Yoavn; Elchanan der zun fun Dedan fun Beis-Lechem; <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />Shammot fun Haror; Chelets fun Pelon; <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />Ira der zun fun Ikeshn fun Tekoa; Aviezer fun Anatot; <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />Sibbechai fun Chushah; Ilai fun Achoach; <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />Maharai fun Netofah; Cheled der zun fun Baanahn fun Netofah; <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />Ittai der zun fun Rivaien fun Givah fun di kinder fun Binyamin; Benayah fun Pirathon; <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />Churai fun nachalei-Gaash; Aviel fun Aravah; <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />Azmavet fun Bacharum; Elyachba fun Shaalvon; <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />di zin fun Yashein fun Gizon; Yonatan der zun fun Shogehn fun Harar; <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />Achiam der zun fun Shikkaron fun Harar; Elifal der zun fun Uren; <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />Chefer fun Mecherah; Achiyah fun Pelon; <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />Chetsro fun Karmel; Naarai der zun fun Ezbain; <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" />Yoel der bruder fun Natanen; Mivchar der zun fun Hagrien; <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />Tselek der Amoni; Nachrai fun Beerot, der vafntreger fun Yoav dem zun fun Tseruyahn; <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />Ira fun Yeter; Garev fun Yeter; <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />Uriyah der Chitti; Zavad der zun fun Achlain; <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />Adina der zun fun Shiza dem Reuveni, a hoiptman fun di Reuvenim, un draisik mit im; <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />Chanan der zun fun Maachahn, un Yoshafat fun Mattan; <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />Uzzia fun Ashtarot; Shama, un Yeyel, di zin fun Chotamen fun Aroer; <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />Yediael der zun fun Shimrien, un Yocha zain bruder fun Tits; <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />Eliel fun Machavim; un Yerivai, un Yoshavyah, di zin fun Elnaamen; un Yitmah der Moavi; <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />Eliel, un Oved, un Yaasiel fun Metsovayah.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="1CH 12" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />un dos zainen di vos zainen gekumen tsu Dovidn kein Tsiklag, beeis er iz noch geven farshpart fun vegen Shaul dem zun fun Kishon; un zei zainen geven tsvishn di giborim vos hobn geholfn in der milchome; <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />bavofnte mit boigns, vos hobn i mit der rechter hant i mit der linker gekent vorfn shteiner un failn fun boign; fun Shauls brider, fun Binyamin. <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />der hoipt Achiezer, un Yoash, di zin fun Shimeahn fun Givah; un Iziel, un Pelet, di zin fun Azmavetn; un Berachah, un Yehu fun Anatot; <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />un Yishmayah fun Givon, a gibor fun di draisik, un iber di draisik, <verse eid="1CH 12:4" /><verse number="5" style="v" altnumber="4b" sid="1CH 12:5" /> un Yirmeyah, un Yachaziel, un Yochanan, un Yozavad fun Gederah; <verse eid="1CH 12:5" /><verse number="6" style="v" altnumber="5" sid="1CH 12:6" /> Eluzai, un Yerimot, un Bealyah, un Shemaryahu, un Shefatyahu fun Charif; <verse eid="1CH 12:6" /><verse number="7" style="v" altnumber="6" sid="1CH 12:7" /> Elkanah, un Yishiyahu, un Azareel, un Yoezer, un Yashovam, di Korachim; un <verse eid="1CH 12:7" /><verse number="8" style="v" altnumber="7" sid="1CH 12:8" /> Yoelah, un Zevadyah di zin fun Yerochamen fun Gedor.<verse eid="1CH 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" altnumber="8" sid="1CH 12:9" /> un fun di Gadim hobn zich opgesheidt tsu Dovidn, tsu der festung in der midber, heldishe giborim, cheillait far milchome, vos hobn gekent haltn a shild un a shpiz, mit penemer vi penemer fun leibn, un azoi vi hirshn oif di berg in flinkeit. <verse eid="1CH 12:9" /><verse number="10" style="v" altnumber="9" sid="1CH 12:10" /> Ezer der hoipt, Ovadyah der tsveiter, Eliav der driter; <verse eid="1CH 12:10" /><verse number="11" style="v" altnumber="10" sid="1CH 12:11" /> Mishmannah der firter, Yirmeyah der finfter; <verse eid="1CH 12:11" /><verse number="12" style="v" altnumber="11" sid="1CH 12:12" /> Attai der zekster, Eliel der zibeter; <verse eid="1CH 12:12" /><verse number="13" style="v" altnumber="12" sid="1CH 12:13" /> Yochanan der achter, Elzavad der nainter; <verse eid="1CH 12:13" /><verse number="14" style="v" altnumber="13" sid="1CH 12:14" /> Yirmeyah der tsentner, Machbanai der elfter. <verse eid="1CH 12:14" /><verse number="15" style="v" altnumber="14" sid="1CH 12:15" /> di dozike fun di kinder fun Gad zainen geven hoiptlait fun cheil; der mindster iber hundert, un der grester iber toiznt. <verse eid="1CH 12:15" /><verse number="16" style="v" altnumber="15" sid="1CH 12:16" /> dos zainen di vos zainen ariber dem Yarden in ershtn choidesh ven er iz geven ful iber ale zaine bregn, un hobn faryogt ale fun di toln tsu mizrech un tsu mayrev.<verse eid="1CH 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" altnumber="16" sid="1CH 12:17" /> un fun di kinder fun Binyamin un Yehudah zainen gekumen tsu der festung tsu Dovidn. <verse eid="1CH 12:17" /><verse number="18" style="v" altnumber="17" sid="1CH 12:18" /> un Dovid iz zei arois antkegen, un er hot zich opgerufn un hot tsu zei gezogt: oib ir zait gekumen oif sholem tsu mir, mich tsu helfn, vet main harts zain eins mit aich; oib ober mich tsu farnarn tsu maine faint, on an umrecht in maine hent, zol der G-t fun undzere eltern tsuzen un mishpetn. <verse eid="1CH 12:18" /><verse number="19" style="v" altnumber="18" sid="1CH 12:19" /> hot der gaist ongekleidt Amasai dem hoiptman fun di eltste:</para>
  <para style="b" vid="1CH 12:19" />
  <para style="q" vid="1CH 12:19">far dir, Dovid,</para>
  <para style="q" vid="1CH 12:19">un mit dir, zun fun Yishaien!</para>
  <para style="q" vid="1CH 12:19">sholem, sholem tsu dir,</para>
  <para style="q" vid="1CH 12:19">un sholem tsu daine helfer;</para>
  <para style="q" vid="1CH 12:19">vorem dain G-t tut dich helfn.</para>
  <para style="b" vid="1CH 12:19" />
  <para style="m" vid="1CH 12:19">hot zei Dovid tsugenumen, un hot zei gemacht far hoiptlait fun der machne.<verse eid="1CH 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" altnumber="19" sid="1CH 12:20" /> oich fun Menasheh zainen tsugefaln tsu Dovidn ven er iz gekumen mit di Pelishtim akegn Shauln oif milchome, ober zei hobn zei nisht geholfn, vorem noch a barotung hobn di firshtn fun di Pelishtim im avekgeshikt, azoi tsu zogn: mit undzere kep vet er tsufaln tsu zain har Shauln. <verse eid="1CH 12:20" /><verse number="21" style="v" altnumber="20" sid="1CH 12:21" /> az er iz gegangen kein Tsiklag zainen tsugefaln tsu im fun Menasheh: Adnach, un Yozavad, un Yediael, un Michael, un Yozavad, un Elihu, un Tsilletai, hoiptlait fun toizntn vos fun Menasheh. <verse eid="1CH 12:21" /><verse number="22" style="v" altnumber="21" sid="1CH 12:22" /> un zei hobn geholfn Dovidn akegn der machne, vorem zei zainen ale geven heldishe giborim, un zei zainen gevorn eltste in cheil. <verse eid="1CH 12:22" /><verse number="23" style="v" altnumber="22" sid="1CH 12:23" /> yo, fun tog tsu tog iz men gekumen tsu Dovidn im tsu helfn, biz di machne iz geven grois, azoi vi di machne fun Elokim.<verse eid="1CH 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" altnumber="23" sid="1CH 12:24" /> un dos zainen di tsoln fun di kep fun di bavofnte far milchome, vos zainen gekumen tsu Dovidn kein Chevron, optsukeren di meluche fun Shauln tsu im, loit dem moil fun Hashem: <verse eid="1CH 12:24" /><verse number="25" style="v" altnumber="24" sid="1CH 12:25" /> di kinder fun Yehudah vos hobn getrogn a shild un a shpiz, zeks toiznt un acht hundert bavofnt far milchome. <verse eid="1CH 12:25" /><verse number="26" style="v" altnumber="25" sid="1CH 12:26" /> fun di kinder fun Shimeon, heldishe giborim far milchome, zibn toiznt un hundert. <verse eid="1CH 12:26" /><verse number="27" style="v" altnumber="26" sid="1CH 12:27" /> fun di kinder fun Levi, fir toiznt un zeks hundert. <verse eid="1CH 12:27" /><verse number="28" style="v" altnumber="27" sid="1CH 12:28" /> un Yehoyada der firsht fun Aharon, un mit im drai toiznt un zibn hundert. <verse eid="1CH 12:28" /><verse number="29" style="v" altnumber="28" sid="1CH 12:29" /> un Tsadok, a yunger heldisher gibor, un zain foterhoiz, tsvei un tsvantsik eltste. <verse eid="1CH 12:29" /><verse number="30" style="v" altnumber="29" sid="1CH 12:30" /> un fun di kinder fun Binyamin, di brider fun Shauln, drai toiznt, vorem biz dentsmol hot dos rov fun zei opgehit di getraishaft tsu Shauls hoiz. <verse eid="1CH 12:30" /><verse number="31" style="v" altnumber="30" sid="1CH 12:31" /> un fun di kinder fun Efrayim, tsvantsik toiznt un acht hundert heldishe giborim, mentshn mit nemen in zeyere foterhaizer. <verse eid="1CH 12:31" /><verse number="32" style="v" altnumber="31" sid="1CH 12:32" /> un fun dem halbn sheyvet Menasheh, achtsen toiznt vos zainen geven ongerufn mit nemen – tsu kumen machn Dovidn far a melech. <verse eid="1CH 12:32" /><verse number="33" style="v" altnumber="32" sid="1CH 12:33" /> un fun di kinder fun Yissachar, di vos hobn zich farshtanen oif di tsaitn, tsu visen vos Yisroel darf ton; zeyere hoiptlait zainen geven tsvei hundert, un ale zeyere brider zainen geven unter zeyer bafel. <verse eid="1CH 12:33" /><verse number="34" style="v" altnumber="33" sid="1CH 12:34" /> fun Zevulun, fuftsik toiznt vos kenen aroisgein in cheil, vos kenen onrichtn a milchome mit alerlei keile-milchome, un zich oisshteln nisht mit a halbn hartsn. <verse eid="1CH 12:34" /><verse number="35" style="v" altnumber="34" sid="1CH 12:35" /> un fun Naftali, toiznt eltste, un mit zei zibn un draisik toiznt mit pansters un shpizn. <verse eid="1CH 12:35" /><verse number="36" style="v" altnumber="35" sid="1CH 12:36" /> un fun di Danim, acht un tsvantsik toiznt un zeks hundert vos kenen onrichtn a milchome. <verse eid="1CH 12:36" /><verse number="37" style="v" altnumber="36" sid="1CH 12:37" /> un fun Asher, fertsik toiznt vos kenen aroisgein in cheil ontsurichtn a milchome. <verse eid="1CH 12:37" /><verse number="38" style="v" altnumber="37" sid="1CH 12:38" /> un fun yener zait Yarden, fun di Reuvenim, un di Gadim, un dem halbn sheyvet Menasheh, mit ale kriggetsaig far milchome, hundert un tsvantsik toiznt.<verse eid="1CH 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" altnumber="38" sid="1CH 12:39" /> di ale, milchome-lait vos hobn gekent zich onrichtn a milchome, zainen gekumen mit a gantsn hartsn kein Chevron, tsu machn Dovidn far a melech iber gants Yisroel. un oich ale iberike fun Yisroel zainen geven mit ein harts tsu machn Dovidn far a melech. <verse eid="1CH 12:39" /><verse number="40" style="v" altnumber="39" sid="1CH 12:40" /> un zei zainen dortn geven mit Dovidn drai teg, un zei hobn gegesn un getrunken, vorem zeyere brider hobn tsugegreit far zei. <verse eid="1CH 12:40" /><verse number="41" style="v" altnumber="40" sid="1CH 12:41" /> un oich hobn di vos zainen geven nont tsu zei, biz tsu Yissachar un Zevulun un Naftali, gebracht broit oif eizlen, un oif kemlen, un oif moileizlen, un oif rinder, melshpaizn, gepreste faign, un rozinkes, un vain, un eil, un rinder un shof lerov, vorem es iz geven a simche in Yisroel.<verse eid="1CH 12:41" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="1CH 13" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />un Dovid hot gehaltn an eitse mit di hoiptlait fun di toizntn un fun di hundertn, mit itlechn onfirer. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />un Dovid hot gezogt tsu der ainzamlung fun Yisroel: oib aich iz voilgefeln, un es iz fun Hashem Elokeinu, lomir breit funandershikn tsu undzere iberike brider in ale lender fun Yisroel, un tsuglaich mit zei tsu di koyanim un tsu di Leviim vos zainen in zeyere shtet mit di fraie peletser, az zei zoln zich oifklaibn tsu undz. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />un lomir ariberbrengen dem orn fun Elokeinu tsu undz, vorem mir hobn im nisht gezucht in di teg fun Shauln. <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />hot di gantse ainzamlung gezogt, me zol azoi ton, vorem di zach iz geven glaich in di oign fun dem gantsn folk. <verse eid="1CH 13:4" /><verse number="5" style="v" sid="1CH 13:5" />un Dovid hot aingezamlt gants Yisroel fun Shichor fun Mitsrayim un biz me kumt kein Chammat, kedei tsu brengen dem orn fun HaElokim fun Kiryat-Yearim.<verse eid="1CH 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 13:6" />un Dovid un gants Yisroel zainen aroifgegangen kein Baalah, kein Kiryat-Yearim vos gehert tsu Yehudah, kedei aroiftsubrengen fun dortn dem orn fun HaElokim Hashem vos zitst iber di kruvim, vos zain nomen vert gerufn deroif. <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />un zei hobn aroifgeleigt dem orn fun HaElokim oif a naiem vogn fun Avinadavs hoiz, un Uzza un Achyo hobn gefirt dem vogn. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />un Dovid un gants Yisroel, hobn zich freilech gemacht far Elokim mitn gantsn koiech, mit gezangen, un mit harfn, un mit gitarn, un mit poikn, un mit tsimblen, un mit trumeitn.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />un vi zei zainen gekumen biz tsum dresh-shaier fun Kidon, hot Uzza oisgeshtrekt zain hant ontsunemen dem orn, vorem di rinder hobn im aropgerukt. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />hot der tsorn fun Hashem gegrimt oif Uzzan, un er hot im geshlogn far vos er hot oisgeshtrekt zain hant tsum orn; un er iz dortn geshtorbn far Elokim.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />un Dovidn hot geergert vos Hashem hot gebracht a broch oif Uzzan. un me ruft yenem ort Perets-Uzza biz oif haintikn tog. <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />un Dovid hot moire gehat far Hashem in yenem tog, azoi tsu zogn: vi azoi zol ich brengen tsu mir dem orn fun HaElokim?<verse eid="1CH 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 13:13" />un Dovid hot nisht avekgenumen dem orn tsu zich in Dovids-shtot, nor er hot im opgefirt tsu dem hoiz fun Oved-Edomen fun Gat. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />un der orn fun HaElokim iz geblibn bai dem hoizgezint fun Oved-Edomen in zain hoiz drai chodeshim. un Hashem hot gebentsht dos hoiz fun Oved-Edomen, un alts vos er hot gehat.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="1CH 14" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />un Churam der melech fun Tsor hot geshikt shluchim tsu Dovidn mit tsederholts un moiermainsters un holtsmainsters, im tsu boien a hoiz. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />un Dovid hot gevust az Hashem hot im bafestikt far a melech iber Yisroel, vorem zain meluche iz geven hoich derhoibn, fun vegen zain folk Yisroel.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />un Dovid hot genumen noch vaiber in Yerushalayim, un Dovid hot geborn noch zin un techter. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />un dos zainen di nemen fun di kinder vos er hot gehat in Yerushalayim: Shammua, un Shovav, Natan, un Shlomo; <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />un Yivchar, un Elishua, un Elpelet; <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />un Nogah, un Nefeg, un Yafia; <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />un Elishama, un Beelyada, un Elifelet.<verse eid="1CH 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />un di Pelishtim hobn gehert az Dovid iz gezalbt gevorn far a melech iber gants Yisroel, un ale Pelishtim zainen aroifgegangen tsu zuchn Dovidn. hot Dovid gehert, un er iz arois zei antkegen.<verse eid="1CH 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 14:9" />un di Pelishtim zainen gekumen, un hobn zich farshpreit in tal Refaim.<verse eid="1CH 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 14:10" />hot Dovid gefregt bai Elokim, azoi tsu zogn: zol ich aroifgein oif di Pelishtim? un vestu zei gebn in main hant? hot Hashem tsu im gezogt: gei aroif, un ich vel zei gebn in dain hant.<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />un zei zainen aroifgegangen kein Baal-Peratsim, un Dovid hot zei dortn geshlogn; un Dovid hot gezogt: HaElokim hot durchgebrochn maine faint mit main hant, azoi vi a durchbroch fun vaser. derum hot men gerufn dem nomen fun yenem ort Baal-Peratsim.<verse eid="1CH 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 14:12" />un zei hobn dortn ibergelozt zeyere opgeter; hot Dovid geheisn, un zei zainen farbrent gevorn in faier.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />un di Pelishtim hobn zich vider a mol farshpreit in tal. <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />hot Dovid vider gefregt bai Elokim, un HaElokim hot tsu im gezogt: zolst nisht aroifgein noch zei; drai zich avek fun zei, un zolst kumen oif zei fun akegn di moilberboimer. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />un es vet zain, vi du vest hern a geroish fun trit in di shpitsn fun di moilberboimer, dentsmol zolstu aroisgein in milchome, vorem dos iz HaElokim aroisgegangen dir farois tsu shlogn dem cheil fun di Pelishtim.<verse eid="1CH 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 14:16" />un Dovid hot geton azoi vi HaElokim hot im bafoiln, un zei hobn geshlogn dem cheil fun di Pelishtim fun Givon un biz Gezer.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />un Dovids shem iz arois in ale lender, un Hashem hot gegebn zain moire oif ale felker.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="1CH 15" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />un er hot zich gemacht haizer in Dovids-shtot, un er hot tsugegreit an ort far dem orn fun HaElokim, un oifgeshtelt far im a getselt. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />dentsmol hot Dovid gezogt, az keiner zol nisht trogn dem orn fun HaElokim, nor di Leviim, vail zei hot Hashem oisderveilt tsu trogn dem orn fun Hashem, un im tsu badinen oif eibik. <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />un Dovid hot aingezamlt gants Yisroel kein Yerushalayim, kedei aroiftsubrengen dem orn fun Hashem oif zain ort, vos er hot tsugegreit far im. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />un Dovid hot tsunoifgeklibn di kinder fun Aharon, un di Leviim. <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />fun di kinder fun Kohat: Uriel dem hoiptman, un zaine brider, hundert un tsvantsik. <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />fun di kinder fun Merari: Asayah dem hoiptman, un zaine brider, tsvei hundert un tsvantsik. <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />fun di kinder fun Gershom: Yoel dem hoiptman, un zaine brider, hundert un draisik. <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />fun di kinder fun ElitSafan: Shemayah dem hoipt, un zaine brider, tsvei hundert. <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />fun di kinder fun Chevron: Eliel dem hoiptman, un zaine brider, achtsik. <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />fun di kinder fun Uziel: Amminadav dem hoiptman, un zaine brider, hundert un tsvelf.<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />un Dovid hot gerufn Tsadok un Evyatar di koyanim, un di Leviim, Urieln, Asayahn, un Yoeln, Shemayahn, un Elieln, un Amminadavn. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />un er hot tsu zei gezogt: ir zait di hoiptn fun di foterhaizer fun di Leviim; heilikt aich, ir un aiere brider, un ir vet aroifbrengen dem orn fun Hashem Elokei Yisroel ahin vu ich hob tsugegreit far im. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />vorem vail ir zait nisht geven dos ershte mol, hot Hashem Elokeinu gemacht a broch tsvishn undz; vorem mir hobn im nisht gezucht vi geherik.<verse eid="1CH 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 15:14" />hobn di koyanim un di Leviim zich geheilikt, kedei aroiftsubrengen dem orn fun Hashem Elokei Yisroel. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />un di kinder fun di Leviim hobn getrogn dem orn fun HaElokim, azoi vi Moshe hot bafoiln loit dem vort fun Hashem, oif zeyer aksl mit shtangen oif zich.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />un Dovid hot geheisn di hoiptlait fun di Leviim tsu shteln zeyere brider di zingers mit klei-zemer, harfn, un gitarn, un tsimblen, tsu shpiln oif a hoichn kol mit simche. <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />un di Leviim hobn geshtelt Heman dem zun fun Yoeln; un fun zaine brider, ASaf dem zun fun Berechyahun; un fun di kinder fun Merari, zeyere brider, Eitan dem zun fun Kushayahun. <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />un mit zei zainen geven zeyere brider fun tsveitn rang: Zecharyahu, un Yaaziel, un Shemiramot, un Yechiel, un Unni, Eliav, un Benayahu, un Maaseiyah, un Mattityahu, un Eliflehu, un Mikneyahu, un Oved-Edom, un Yeyel, di toierlait. <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />un di zingers, Heman, ASaf, un Eitan, oif tsu shpiln mit kuperne tsimblen. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />un Zecharyah, un Uzziel, un Shemiramot, un Yechiel, un Unni, un Eliav, un Maaseiyah, un Benayahu, mit harfn oif Alemet.<verse eid="1CH 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 15:21" />un Mattityahu, Eliflehu, un Mikneyahu, un Oved-Edom, un Yeyel, un Azazyahu, oif ontsufirn mit harfn oif shminit. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />un Konanyahu der hoiptman fun di Leviim iz geven iber dem gezang; er flegt zain der har baim gezang, vorem er iz geven a kener.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />un Berechyah un Elkanah zainen geven toierlait baim orn. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />un Shevanyahu, un Yoshafat, un Netanel, un Amasai, un Zecharyahu, un Benayahu, un Eliezer, di koyanim, hobn getrumeitert oif trumeitn far dem orn fun HaElokim; un Oved-Edom un Yechiyah, zainen geven toierlait baim orn.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />un Dovid, un di eltste fun Yisroel, un di hoiptlait fun di toizntn, zainen gegangen aroiftsubrengen dem orn fun Hashems bris, fun Oved-Edoms hoiz, mit simche. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />un es iz geven, az Hashem hot geholfn di Leviim vos hobn getrogn dem orn fun G-ts bris, hobn zei geshlacht zibn oksen un zibn viders. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />un Dovid iz geven aingeviklt in a mantl fun fainlainen, dest glaichn ale Leviim vos hobn getrogn dem orn, un di zingers, un Kenanyah der gezangmaister iber di zingers; un Dovid hot oif zich gehat a lainenem ephod. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />un gants Yisroel hobn aroifgebracht dem orn fun Hashems bris mit shalung, un mit a kol fun shoifer, un mit trumeitn, un mit tsimblen, shpilndik oif gitarn un harfn. <verse eid="1CH 15:28" /><verse number="29" style="v" sid="1CH 15:29" />un es iz geven, vi der orn fun Hashems bris iz gekumen biz Dovids-shtot, hot Michal di tochter fun Shauln aroisgekukt durchn fentster, un zi hot gezen dem melech Dovid tantsn un zich machn freilech, un zi hot im faracht in ir hartsn.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />un zei hobn gebracht dem orn fun HaElokim, un hobn im araingeshtelt in dem getselt vos Dovid hot far im oifgeshtelt, un zei hobn makrev geven brandopfer un fridopfer far Hashem. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />un az Dovid hot geendikt oifbrengen di brandopfer un di fridopfer, hot er gebentsht dos folk in nomen fun Hashem. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />un er hot oisgeteilt tsu yetveder einem fun Yisroel fun a man biz a froi, itlechn a labn broit, un a chelek fleish, un a rozinkekuchn.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />un er hot geshtelt far dem orn fun Hashem, fun di Leviim far badiner, un oif tsu dermonen un danken un loibn Hashem Elokei Yisroel: <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />ASaf dem hoipt, un dem tsveitn tsu im, Zecharyahn, Yeyeln, un Shemiramoten, un Yechieln, un Mattityahn, un Eliavn, un Benayahuen, un Oved-Edomen, un Yeyeln, mit gitarn un mit harfn; un ASaf hot geshpilt oif a tsimbl; <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />un Benayahu un Yachaziel di koyanim, mit trumeitn tamid far dem orn fun G-ts bris.<verse eid="1CH 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />dentsmol in yenem tog hot Dovid tsuersht gelozt gebn a dank tsu Hashem, durch ASafn un zaine brider.<verse eid="1CH 16:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="1CH 16:8" />git a dank tsu Hashem, ruft zain nomen,</para>
  <para style="q" vid="1CH 16:8">lozt visen tsvishn di felker zaine tuungen.<verse eid="1CH 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1CH 16:9" />23 zingt tsu im, shpilt tsu im,</para>
  <para style="q" vid="1CH 16:9">redt fun ale zaine vunder.<verse eid="1CH 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1CH 16:10" />rimt zich mit zain heilikn nomen;</para>
  <para style="q" vid="1CH 16:10">zol zich freyen dos harts fun di vos zuchn Hashem.<verse eid="1CH 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1CH 16:11" />forsht Hashem un zain shtarkeit,</para>
  <para style="q" vid="1CH 16:11">zucht zain ponem tamid.<verse eid="1CH 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1CH 16:12" />dermont zaine vunder vos er hot geton,</para>
  <para style="q" vid="1CH 16:12">zaine tseichns, un di mishpotim fun zain moil,<verse eid="1CH 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1CH 16:13" />ir zomen fun Yisroel zain knecht,</para>
  <para style="q" vid="1CH 16:13">ir kinder fun Yaakov, zaine oisderveilte.<verse eid="1CH 16:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="1CH 16:14" />er iz Hashem Elokeinu,</para>
  <para style="q" vid="1CH 16:14">iber der gantser erd zainen zaine mishpotim.<verse eid="1CH 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="1CH 16:15" />gedenkt eibik zain bris,</para>
  <para style="q" vid="1CH 16:15">dos vort vos er hot bafoiln oif toiznt doires.<verse eid="1CH 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CH 16:16" />vos er hot geshlosn mit Avrahamen,</para>
  <para style="q" vid="1CH 16:16">un zain shvue tsu Yitschakn.<verse eid="1CH 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="1CH 16:17" />un er hot es oifgeshtelt far a chok tsu Yaakov,</para>
  <para style="q" vid="1CH 16:17">far an eibikn bris tsu Yisroel,<verse eid="1CH 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1CH 16:18" />azoi tsu zogn: dir vel ich gebn dos land Kenaan,</para>
  <para style="q" vid="1CH 16:18">dem teil fun aier nachle.<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="1CH 16:19" />az ir zait geven getseilte mentshn,</para>
  <para style="q" vid="1CH 16:19">vintsik un fremde derin;<verse eid="1CH 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="1CH 16:20" />un zei zainen umgegangen fun folk tsu folk,</para>
  <para style="q" vid="1CH 16:20">un fun ein kinigraich tsu an ander ume,<verse eid="1CH 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="1CH 16:21" />hot er nisht gelozn a mentshn zei drikn,</para>
  <para style="q" vid="1CH 16:21">un hot geshtroft mlochim vegen zei:<verse eid="1CH 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1CH 16:22" />ir zolt nisht onrirn maine gezalbte,</para>
  <para style="q" vid="1CH 16:22">un maine neviim nisht beiz ton.<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="1CH 16:23" />zingt tsu Hashem, di gantse erd,</para>
  <para style="q" vid="1CH 16:23">zeit mevaser fun tog tsu tog zain yeshue.<verse eid="1CH 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="1CH 16:24" />dertseilt tsvishn di felker zain koved,</para>
  <para style="q" vid="1CH 16:24">tsvishn ale umes zaine vunder.<verse eid="1CH 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1CH 16:25" />vorem grois iz Hashem un zeyer gerimt,</para>
  <para style="q" vid="1CH 16:25">un er iz forchtik iber ale g‑ter.<verse eid="1CH 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="1CH 16:26" />vorem di g‑ter fun ale felker zainen nishtik,</para>
  <para style="q" vid="1CH 16:26">un Hashem hot di himlen gemacht.<verse eid="1CH 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="1CH 16:27" />glants un sheinkeit zainen far zain ponem,</para>
  <para style="q" vid="1CH 16:27">shtarkeit un freid zainen in zain ort.<verse eid="1CH 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="1CH 16:28" />git tsu Hashem, ir mishpoches fun di felker,</para>
  <para style="q" vid="1CH 16:28">git tsu Hashem koved un shtarkeit.<verse eid="1CH 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="1CH 16:29" />git tsu Hashem dem koved fun zain nomen,</para>
  <para style="q" vid="1CH 16:29">brengt a minche, un kumt far im,</para>
  <para style="q" vid="1CH 16:29">bukt zich tsu Hashem mit heilikn opshai.<verse eid="1CH 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="1CH 16:30" />tsitert far im, di gantse erd;</para>
  <para style="q" vid="1CH 16:30">oich iz bafestikt di velt, zi zol zich nisht vaklen,<verse eid="1CH 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="1CH 16:31" />zoln zich freyen di himlen, un lustik zain di erd,</para>
  <para style="q" vid="1CH 16:31">un zol men zogn tsvishn di felker: Hashem tut kinign.<verse eid="1CH 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="1CH 16:32" />zol dunern der yam mit zain fulkeit,</para>
  <para style="q" vid="1CH 16:32">zol freilech zain dos feld un alts vos derin.<verse eid="1CH 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="1CH 16:33" />dentsmol zoln zingen di beimer fun vald far Hashem,</para>
  <para style="q" vid="1CH 16:33">vorem er kumt mishpetn di erd.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="1CH 16:34" />git a dank tsu Hashem, vorem er iz gut,</para>
  <para style="q" vid="1CH 16:34">vorem oif eibik iz zain chesed.<verse eid="1CH 16:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="1CH 16:35" />un zogt: helf undz, Elokim fun undzer hilf,</para>
  <para style="q" vid="1CH 16:35">un zaml undz ain, un zai undz matsl fun di felker,</para>
  <para style="q" vid="1CH 16:35">tsu loibn dain heilikn nomen,</para>
  <para style="q" vid="1CH 16:35">zich tsu rimen mit dain loib.<verse eid="1CH 16:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="1CH 16:36" />Baruch Hashem Elokei Yisroel</para>
  <para style="q" vid="1CH 16:36">fun eibikeit un biz eibikeit.</para>
  <para style="b" vid="1CH 16:36" />
  <para style="m" vid="1CH 16:36">un dos gantse folk hot gezogt: Omein! un hot geloibt Hashem.<verse eid="1CH 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />un er hot dortn gelozn far dem orn fun Hashems bris ASafn un zaine brider tsu badinen faran orn tamid vi es iz neitik togteglech. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />un Oved-Edomen, un zeyere brider, acht un zechtsik, un Oved-Edom dem zun fun Yedutunen, un Chosahn, far toierlait. <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" />un Tsadok dem koyen, un zaine brider di koyanim, far dem mishkn fun Hashem oif der bamah vos in Givon, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />oiftsubrengen brandopfer tsu Hashem oif dem mizbeyech far brandopfer tamid, in der peire un in ovnt, azoi vi es shteit geshribn in der toyre fun Hashem vos er hot bafoiln Yisroel. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />un mit zei zainen geven Heman, un Yedutun, un di iberike oisgeklibene vos zainen geven ongerufn mit nemen, oif tsu loibn Hashem, vail oif eibik iz zain chesed. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />un mit zei, mit Hemanen un Yedutunen, zainen geven trumeitn un tsimblen tsum shpiln, un klei-zemer far dem gezang fun HaElokim; un di zin fun Yedutunen zainen geven baim toier.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />un dos gantse folk iz avek itlecher tsu zain hoiz, un Dovid hot zich umgekert tsu bentshn zain hoizgezint.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="1CH 17" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />un es iz geven, az Dovid hot zich bazetst in zain hoiz, hot Dovid gezogt tsu Natan dem novi: ze, ich zits in a hoiz fun tsedern, un der orn fun Hashems bris iz unter forhangen. <verse eid="1CH 17:1" /><verse number="2" style="v" sid="1CH 17:2" />hot Natan gezogt tsu Dovidn: alts vos in dain hartsn, tu, vorem HaElokim iz mit dir.<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />un es iz geven in yener nacht, iz dos vort fun Elokim geven tsu Natanen, azoi tsu zogn: <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />gei un zolst zogn tsu main knecht Dovidn: azoi hot Hashem gezogt: nisht du vest mir boien a hoiz tsum voinen; <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />vorem ich hob nisht gevoint in a hoiz fun dem tog vos ich hob oifgebracht Yisroel biz oif haintikn tog; neyert ich bin gegangen fun getselt tsu getselt, un fun ein mishkn tsum andern.<verse eid="1CH 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 17:6" />umetum vu ich bin umgegangen tsvishn gants Yisroel, hob ich ven a vort geredt mit einem fun di richter fun Yisroel, vos ich hob bafoiln tsu fitern main folk, azoi tsu zogn: far vos hot ir mir nisht geboit a hoiz fun tsedern? <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />un atsund, zolstu azoi zogn tsu main knecht, tsu Dovidn: azoi hot gezogt Hashem Tseva'ot: ich hob dich genumen fun dem fiterplats, fun hinter di shof, tsu zain a firsht iber main folk Yisroel. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />un ich bin geven mit dir umetum vu du bist gegangen, un ich hob farshnitn ale daine faint fun far dir; un ich vel dir machn a nomen, azoi vi der nomen fun di greste vos oif der erd. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />un ich vel machn an ort far main folk Yisroel, un vel im ainflantsn er zol ruen oif zain ort, un mer nisht tsiteren, un farbrecher zoln im mer nisht umbrengen azoi vi frier, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />fun di teg vos ich hob bafoiln richter iber main folk Yisroel. un ich vel machn untertenik ale daine faint. un ich zog dir on, az Hashem vet dir boien a hoiz. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />un es vet zain, az daine teg veln derfilt vern tsu gein tsu daine eltern, vel ich oifshteln dain zomen noch dir, vos vet zain fun daine kinder, un ich vel bafestikn zain meluche. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />er vet mir boien a hoiz, un ich vel bafestikn zain tron oif eibik. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />ich vel im zain far a foter, un er vet mir zain far a zun, un ich vel nisht opton main chesed fun im, azoi vi ich hob opgeton fun dem vos iz geven far dir. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />un ich vel im oifshteln in main hoiz un in main kinigraich biz oif eibik, un zain tron vet zain fest biz eibik.<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />azoi vi ale di dozike verter, un azoi vi di dozike gantse zeung, azoi hot Natan geredt tsu Dovidn.<verse eid="1CH 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />un der melech Dovid iz gekumen, un hot zich gezetst far Hashem, un hot gezogt: ver bin ich, o Hashem Elokim, un ver iz main hoiz, vos du host mich gebracht biz aher? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />un dos, Elokim, iz noch geven klein in daine oign, un du host geredt vegen dem hoiz fun dain knecht oif vaiter ahin, un host mich batracht in shteiger fun a gehoibenem man, o Hashem Elokim. <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />vos mer noch ken Dovid dir zogn vegen dem koved tsu dain knecht? du kenst doch dain knecht. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Hashem, fun vegen dain knecht, un loit dain hartsn hostu geton al di dozike groiskeit, tsu lozn visen di ale groise zachn. <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />Hashem, es iz nishto aza vi du, un nishto kein G-t achuts dir, loit alts vos mir hobn gehert mit undzere oiern.<verse eid="1CH 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 17:21" />un voser eintsike ume oif der erd iz azoi vi dain folk Yisroel, vos HaElokim iz gegangen oisleizen far zich tsum folk, dir tsu machn a nomen durch groise un forchtike zachn – tsu fartraiben umes fun far dain folk vos du host oisgeleizt fun Mitsrayim? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />vorem du host gemacht dain folk Yisroel dir tsum folk oif eibik, un du, Hashem, bist gevorn zei tsum Elokim. <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />un atsund, Hashem, zol dos vort vos du host geredt vegen dain knecht un vegen zain hoiz bevort vern oif eibik, un tu azoi vi du host geredt. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />yo, zol es bevort vern, un zol dain nomen gegreist vern oif eibik, azoi tsu zogn: Hashem Tseva'ot iz Elokei Yisroel – a G-t far Yisroel, un dos hoiz fun Dovid dain knecht zol zain fest far dir. <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />vorem du, main G-t, host antplekt dem oier fun dain knecht, im tsu boien a hoiz, derum hot dain knecht zich dervegt mispalel tsu zain far dir. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />un atsund, Hashem, du bist HaElokim, un du host tsugezogt dain knecht dos dozike guts, <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />un host atsund bavilikt tsu bentshn dos hoiz fun dain knecht, tsu zain oif eibik far dir; az du, Hashem, host gebentsht, zol es zain gebentsht oif eibik.<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="1CH 18" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />un es iz geven noch dem, hot Dovid geshlogn di Pelishtim, un hot zei gemacht untertenik, un hot tsugenumen Gat mit ire techtershtet fun der hant fun di Pelishtim.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />un er hot geshlogn Moav, un Moav iz gevorn tsu Dovidn knecht vos brengen minche.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />un Dovid hot geshlogn Hadadezer dem melech fun Tsovah in Chammat, beeis er iz gegangen oifshteln zain eiberhant baim taich Parat. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />un Dovid hot batsvungen fun im toiznt raitvegn, un zibn toiznt raiter, un tsvantsik toiznt man fusgeyer; un Dovid hot geleimt ale geshpanen, nor hundert geshpan hot er ibergelozt fun zei.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />iz Aram fun Darmesek gekumen helfn Hadadezer dem melech fun Tsovah, un Dovid hot geshlogn fun di Aramim tsvei un tsvantsik toiznt man. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />un Dovid hot geshtelt in Aram-Darmesek, un Aram iz gevorn tsu Dovidn knecht vos brengen minche. un Hashem hot geholfn Dovidn umetum vu er iz gegangen.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />un Dovid hot genumen di gilderne shildn vos zainen geven oif Hadadezers knecht, un hot zei gebracht kein Yerushalayim. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />un fun Tivchat, un fun Kun, Hadadezers shtet, hot Dovid tsugenumen zeyer fil kuper. derfun hot Shlomo gemacht dem kupernem yam, un di zailn, un di kuperne keilim.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />un Tou der melech fun Chammat hot gehert az Dovid hot geshlogn dem gantsn cheil fun Hadadezer dem melech fun Tsovah, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />un er hot geshikt zain zun Hadoramen tsum melech Dovid im tsu fregn oif frid un im ontsuvintshn, far vos er hot milchome gehaltn mit Hadadezern, un im geshlogn – vorem Hadadezer hot gehat milchomes mit Touen – mit alerlei gilderne un zilberne un kuperne keilim. <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />zei oich hot der melech Dovid geheilikt tsu Hashem, mit dem zilber un dem gold vos er hot avekgenumen fun ale felker: fun Edom, un fun Moav, un fun di kinder fun Amon, un fun di Pelishtim, un fun Amalek.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />un Avishai der zun fun Tseruyahn hot geshlogn fun Edom in dem tal fun zalts achtsen toiznt. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />un er hot geshtelt vachn in Edom, un gants Edom iz gevorn knecht tsu Dovidn. un Hashem hot geholfn Dovidn umetum vu er iz gegangen. <verse eid="1CH 18:13" /><verse number="14" style="v" sid="1CH 18:14" />un Dovid hot gekinigt iber gants Yisroel, un er hot geton recht un gerechtikeit tsu zain gantsn folk.<verse eid="1CH 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 18:15" />un Yoav der zun fun Tseruyahn iz geven ibern cheil; un Yehoshafat der zun fun Achiludn, der dermoner. <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />un Tsadok der zun fun Achituvn, un Avimelech der zun fun Evyatarn, koyanim; un Shavsha, der shraiber. <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />un Benayahu der zun fun Yehoyadaen, iber di Keretim un di Peletim; un di zin fun Dovidn, di ershte bai der hant fun melech.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="1CH 19" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />un es iz geven noch dem, iz geshtorbn Nachash der melech fun di kinder fun Amon, un zain zun iz gevorn melech oif zain ort. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />hot Dovid gezogt: lomich ton a fraindlechkeit mit Chanun dem zun fun Nachshon, vorem zain foter hot geton a fraindlechkeit mit mir. un Dovid hot geshikt shluchim im tsu treistn noch zain foter, un Dovids knecht zainen gekumen in land fun di kinder fun Amon tsu Chanunen, im tsu treistn.<verse eid="1CH 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 19:3" />hobn di harn fun di kinder fun Amon gezogt tsu Chanunen: meinstu az Dovid vil ton koved dain foter, vos er hot geshikt tsu dir treister? doch nor oistsuforshn un durchtsunishtern un oistsukukn dos land zainen zaine knecht gekumen tsu dir.<verse eid="1CH 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 19:4" />hot Chanun genumen Dovids knecht, un hot zei opgegolt, un opgeshnitn zeyere kleider in helft, bizn dich, un hot zei avekgeshikt.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />iz men gekumen un me hot ongezogt Dovidn vegen di mentshn, un er hot zei geshikt antkegen, vorem di mentshn hobn zich zeyer geshemt. un der melech hot gelozt zogn: zitst in Yericho biz aiere Baiserd veln opvaksn, un ir vet zich umkeren.<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />hobn di kinder fun Amon gezen az zei hobn zich farmiust bai Dovidn, un Chanun un di kinder fun Amon hobn geshikt toiznt tsentner zilber, kedei zich ontsudingen fun Aram-Naharayim, un fun Aram-Maacah, un fun Tsovah, raitvegn un raiter. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />un zei hobn zich ongedungen tsvei un draisik toiznt raitvegn, un dem melech fun Maachah, un zain folk, un zei zainen gekumen, un hobn gelagert far Medeva. un di kinder fun Amon hobn zich aingezamlt fun zeyere shtet, un zainen gekumen oif milchome.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />un Dovid hot gehert, un er hot geshikt Yoavn, un dem gantsn cheil fun di giborim.<verse eid="1CH 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 19:9" />un di kinder fun Amon zainen aroisgegangen, un hobn ongericht a milchome baim aingang fun shtot; un di mlochim vos zainen gekumen, zainen geven bazunder in feld. <verse eid="1CH 19:9" /><verse number="10" style="v" sid="1CH 19:10" />un Yoav hot gezen az der front fun der milchome iz kegen im fun forent un fun hintn; hot er oisgeklibn fun ale geklibene fun Yisroel, un oisgeshtelt akegn Aram. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />un dos iberike folk hot er gegebn oif der hant fun zain bruder Avishaien, un zei hobn zich oisgeshtelt akegn di kinder fun Amon. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />un er hot gezogt: oib Aram vet zain shtarker fun mir, vestu mir zain tsu hilf, un oib di kinder fun Amon veln zain shtarker fun dir, vel ich dich helfn. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />zai shtark, un lomir zich shtarkn, far undzer folk un far di shtet fun Elokeinu; un zol Hashem ton vos iz gut in zaine oign.<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />un Yoav un dos folk vos mit im hobn genent antkegen Aram oif milchome, un zei zainen antlofn far im. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />un vi di kinder fun Amon hobn gezen az Aram iz antlofn, azoi zainen zei oich antlofn far zain bruder Avishaien, un zainen arain in shtot. un Yoav iz avek kein Yerushalayim.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />un Aram hot gezen az zei zainen geshlogn far Yisroel, un zei hobn geshikt shluchim, un hobn aroisgebracht Aram vos fun yener zait taich, mit Shofach dem cheil-lider fun Hadadezern zei farois.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />iz ongezogt gevorn Dovidn, un er hot aingezamlt gants Yisroel, un iz ariber dem Yarden; un er iz gekumen tsu zei, un hot zich oisgeshtelt akegn zei; un Dovid hot ongericht akegn Aram a milchome, un zei hobn milchome gehaltn mit im. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />un Aram iz antlofn far Yisroel, un Dovid hot geharget fun Aram zibn toiznt oif raitvegn, un fertsik toiznt man fusgeyer; oich Shofach dem cheil-lider hot er geteit.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />un di knecht fun Hadadezern hobn gezen az zei zainen geshlogn far Yisroel, un zei hobn gemacht sholem mit Dovidn, un hobn im gedint. un Aram hot mer nisht gevolt helfn di kinder fun Amon.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="1CH 20" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />un es iz geven in der tsait fun dem umker fun yor, in der tsait vos di mlochim geyen arois oif milchome, hot Yoav aroisgefirt dem krig-cheil, un hot farvist dos land fun di kinder fun Amon; un er iz gekumen un hot gelegert oif Rabbah – un Dovid iz gezesn in Yerushalayim – un Yoav hot geshlogn Rabbah, un hot zi tseshtert.<verse eid="1CH 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 20:2" />un Dovid hot aropgenumen Malkams kroin fun zain kop; un er hot zi gefunen a tsentner gold oifn vog, mit taier geshtein in ir. un zi iz ongeton gevorn oif Dovids kop. un roib fun der shtot hot er aroisgefirt zeyer fil. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />un dos folk vos in ir hot er aroisgefirt, un hot zei geshnitn mit zegn un mit aizerne dreshshlitns, un mit hek. un azoi flegt Dovid ton tsu ale shtet fun di kinder fun Amon. un Dovid un dos gantse folk hobn zich umgekert kein Yerushalayim.<verse eid="1CH 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />un es iz geven noch dem, hot zich oifgehoibn a milchome in Gezer mit di Pelishtim. dentsmol hot Sibbechai fun Chushah dershlogn Sippaien fun di kinder fun di Refaim, un zei zainen gevorn untertenik.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />un es iz vider geven a milchome mit di Pelishtim, un Elchanan der zun fun Yairn hot dershlogn Lachmi dem bruder fun Golyatn fun Gat, vos der holts fun zain shpiz iz geven azoi vi der shtang fun veber.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />un es iz vider geven a milchome in Gat. iz dortn geven a man fun a groisn vuks, vos zaine finger zainen geven tsu zeks un zeks – fir un tsvantsik; un er oich iz geven geborn fun dem Rafa. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />un er hot gelestert Yisroel; hot im Yehonatan der zun fun Shimea, Dovids bruder, dershlogn.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />di dozike zainen geven geborn fun dem Rafa in Gat; un zei zainen gefaln durch der hant fun Dovidn, un durch der hant fun zaine knecht.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="1CH 21" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />un stn iz oifgeshtanen oif Yisroel, un er hot ongeredt Dovidn tsu tseiln Yisroel. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />un Dovid hot gezogt tsu Yoavn, un tsu di harn fun folk: geit tseilt Yisroel fun Beer-Sheva un biz Dan, un brengt es mir, kedei ich zol visen zeyer misper. <verse eid="1CH 21:2" /><verse number="3" style="v" sid="1CH 21:3" />hot Yoav gezogt: zol Hashem mern zain folk hundert mol azoi fil vi zei zainen! zainen zei nisht ale, main har melech, knecht tsu main har? tsu vos farlangt dos main har? noch vos zol es zain far a zind oif Yisroel?<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />ober dos vort fun melech iz geven shtark tsu Yoavn, un Yoav iz aroisgegangen, un iz arumgegangen in gants Yisroel, un iz tsurikgekumen kein Yerushalayim. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />un Yoav hot ibergegebn dem misper fun der tseilung fun dem folk tsu Dovidn. un gants Yisroel iz geven toiznt mol toiznt un hundert toiznt man vos tsien a shverd; un Yehudah, fir hundert un zibetsik toiznt vos tsien a shverd. <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />un Levi un Binyamin hot er nisht getseilt tsvishn zei; vorem der onzog fun dem melech iz geven Yoavn tsuvider.<verse eid="1CH 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7" />un es iz geven shlecht in di oign fun HaElokim vegen der doziker zach, un er hot geshlogn Yisroel. <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" />hot Dovid gezogt tsu HaElokim: ich hob zeyer gezindikt vos ich hob geton di dozike zach, un atsund, tu op, ich bet dich, dem farbrech fun dain knecht, vorem ich bin geven zeyer narish.<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />hot Hashem gezogt tsu Gad, Dovids zeer, azoi tsu zogn: <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />gei un zolst redn tsu Dovidn, azoi tsu zogn: azoi hot Hashem gezogt: draierlei zachn leig ich oif dir; klaib dir ois eins fun zei, vos ich zol dir ton.<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />iz Gad gekumen tsu Dovidn, un hot tsu im gezogt: azoi hot Hashem gezogt: nem oif dir, <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />entveder drai yor hunger, oder drai chodeshim farlendt vern far daine faint, un di shverd fun daine sonem zol dich dergreichn, oder drai teg di shverd fun Hashem un a mageyfe in land, un der malach fun Hashem zol umbrengen in gantsn gemark fun Yisroel. un atsund ze vos far a basheid ich zol brengen tsu dem vos shikt mich.<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />hot Dovid gezogt tsu Gadn: mir iz zeyer eng. lomich, ich bet dich, faln in der hant fun Hashem, vorem zain rachmones iz zeyer grois, un lomich nisht faln in der hant fun a mentshn.<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />hot Hashem geshikt a mageyfe oif Yisroel, un es zainen gefaln fun Yisroel zibetsik toiznt man.<verse eid="1CH 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 21:15" />un HaElokim hot geshikt a malach kein Yerushalayim, zi umtsubrengen; ober vi er hot gehaltn baim umbrengen, hot Hashem aropgekukt, un er hot charote gehat oif dem beiz, un er hot gezogt tsu dem malach dem umbrenger: genug! atsund loz op dain hant. un der malach fun Hashem iz geshtanen bai dem dresh-shaier fun Ornon dem Yevusi. <verse eid="1CH 21:15" /><verse number="16" style="v" sid="1CH 21:16" />hot Dovid oifgehoibn zaine oign, un hot derzen dem malach fun Hashem vi er shteit tsvishn erd un himel mit zain shverd aroisgetsoign in zain hant, oisgeshtrekt akegn Yerushalayim; un Dovid un di eltste, tsugedekt mit zak, zainen gefaln oif zeyer ponem. <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />un Dovid hot gezogt tsu Hashem: far vor, ich hob geheisn tseiln dos folk, un ich bin der vos hob gezindikt, un hob zeyer shlechts geton, ober di dozike shof, vos hobn zei geton? Hashem main G-t, zol, ich bet dich, dain hant zain oif mir un oif main foters hoiz, ober nisht oif dain folk mit a mageyfe.<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />hot der malach fun Hashem geheisn Gadn zogn Dovidn, az Dovid zol aroifgein oifshteln a mizbeyech tsu Hashem in dem dresh-shaier fun Ornon dem Yevusi.<verse eid="1CH 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 21:19" />iz Dovid aroifgegangen loit dem vort fun Gadn vos er hot geredt in nomen fun Hashem. <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />un Ornon hot zich umgekert un hot derzen dem malach; un zaine fir zin vos mit im hobn zich bahaltn. un Ornon hot gedroshn veits. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />un vi Dovid iz gekumen tsu Ornonen, hot Ornon a kuk geton, un hot derzen Dovidn, un er iz aroisgegangen fun dresh-shaier, un hot zich gebukt tsu Dovidn mitn ponem tsu der erd. <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />hot Dovid gezogt tsu Ornonen: gib mir dem ort fun dem dresh-shaier, un ich vel boien deroif a mizbeyech tsu Hashem; in fuln gelt gib es mir; kedei di mageyfe zol farhaltn vern fun folk. <verse eid="1CH 21:22" /><verse number="23" style="v" sid="1CH 21:23" />hot Ornon gezogt tsu Dovidn: nem dir, un zol main har der melech ton vos iz gut in zaine oign. ze, ich gib di rinder far brandopfer, un di dreshshlitns far holts, un di veits far a shpaizopfer; alts gib ich avek. <verse eid="1CH 21:23" /><verse number="24" style="v" sid="1CH 21:24" />hot der melech Dovid gezogt tsu Ornonen: nein, naiert koifn vel ich koifn, far fuln gelt, vorem ich vel nisht nemen vos iz dains far Hashem, un oifbrengen a brandopfer far umzist.<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />un Dovid hot gegebn Ornonen far dem ort zeks hundert shekl gold oifn vog. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />un Dovid hot dortn geboit a mizbeyech tsu Hashem, un hot dortn oifgebracht brandopfer un fridopfer, un er hot gerufn tsu Hashem, un er hot im geentfert mit faier fun himel oif dem mizbeyech far brandopfer.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />un Hashem hot geheisn dem malach, un er hot umgekert di shverd in ir sheid.<verse eid="1CH 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 21:28" />in yener tsait, vi Dovid hot gezen az Hashem hot im geentfert in dem dresh-shaier fun Ornon dem Yevusi, azoi hot er dortn geshlacht korbones. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />un der mishkn fun Hashem vos Moshe hot gemacht in der midber, un der mizbeyech far brandopfer, iz in yener tsait geven oif der bamah in Givon. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />ober Dovid hot nisht gekent gein tsu im tsu fregn bai Hashem, vorem er iz geven dershrokn far der shverd fun malach fun Hashem.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />un Dovid hot gezogt: dos iz dos hoiz fun Hashem HaElokim, un dos iz der mizbeyech far brandopfer far Yisroel.<verse eid="1CH 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />un Dovid hot geheisn ainzamlen ale fremde vos in land Yisroel, un er hot geshtelt shteinheker oistsuhakn geshnitene shteiner oif tsu boien dos hoiz fun Elokim. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />un aizn lerov oif negl far di tirn fun di toiern, un oif klamern, hot Dovid ongebreit; un kuper lerov gor on a vog; <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />un tsederholts on a tsol; vorem di Tsidonim un di Tsorim hobn gebracht Dovidn tsederholts lerov. <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" />un Dovid hot gezogt: main zun Shlomo iz yung un shvach, un dos hoiz vos me darf boien tsu Hashem, darf men machn grois biz gor, far a shem, un far a tsirung, antkegen ale lender; lomich akorsht tsugreiten far im. un Dovid hot tsugegreit a sach far zain toit.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />un er hot gerufn zain zun Shlomoen, un er hot im bafoiln tsu boien a hoiz tsu Hashem Elokei Yisroel. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />un Dovid hot gezogt tsu Shlomoen: main zun, bai mir alein iz geven in hartsn tsu boien a hoiz tsu dem nomen fun Hashem main G-t. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />ober dos vort fun Hashem iz geven tsu mir, azoi tsu zogn: a sach blut hostu fargosen, un groise milchomes hostu gemacht; kenst nisht boien a hoiz tsu main nomen, vail du host fil blut fargosen tsu der erd far main gezicht. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />ot vert dir geborn a zun; er vet zain a mentsh fun ru, un ich vel im baruyen fun ale zaine faint fun arum; vorem Shlomo vet zain zain nomen, un sholem un shtilkeit vel ich gebn Yisroel in zaine teg. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />er vet boien a hoiz tsu main nomen, un er vet mir zain far a zun, un ich im far a foter; un ich vel bafestikn dem tron fun zain meluche iber Yisroel oif eibik. <verse eid="1CH 22:10" /><verse number="11" style="v" sid="1CH 22:11" />atsund, main zun, zol Hashem zain mit dir, un zolst matsliech zain, un boien dos hoiz fun Hashem dain G-t, azoi vi er hot geredt vegen dir. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />zol nor Hashem dir gebn seichel un farshtandikeit, un dich bafeln iber Yisroel; un az du zolst hitn di toyre fun Hashem dain G-t. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />dentsmol vestu matsliech zain, az du vest hitn tsu ton di chukkim un di gezetsn vos Hashem hot bafoiln Mosheen far Yisroel. zai shtark un fest, zolst nisht moire hobn un nisht angstn. <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />un ot in main orimkeit hob ich tsugegreit far dem hoiz fun Hashem hundert toiznt tsentner gold, un toiznt mol toiznt tsentner zilber, un kuper un aizn on a vog, vorem es iz do lerov; oich holts un shteiner hob ich tsugegreit, un du kenst noch tsuleigen dertsu. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />un bai dir zainen do a sach baal-meloches, shteinheker, un mainsters in shtein un in holts, un alerlei kintsler in yetveder meloche. <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />tsum gold, tsum zilber, un tsum kuper, un tsum aizn, iz kein tsol nishto; shtei oif un tu, un zol Hashem zain mit dir.<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />un Dovid hot bafoiln ale harn fun Yisroel tsu helfn zain zun Shlomoen: <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />far vor, Hashem Elokeichem iz mit aich, un er hot aich barut fun rund arum, vorem er hot gegebn in main hant di bavoiner fun land, un dos land ligt batsvungen far Hashem un far zain folk. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />atsund, git aier harts un aier zel tsu zuchn Hashem Elokeichem, un shteit oif, un boit dos mikdash fun Hashem dem har, kedei tsu brengen dem orn fun G-ts bris, un di heilike keilim fun Hashem, in dem hoiz vos vert geboit tsu dem nomen fun Hashem.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="1CH 23" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />un Dovid iz gevorn alt un zat mit teg, un er hot gemacht zain zun Shlomoen far melech iber Yisroel. <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" />un er hot aingezamlt ale harn fun Yisroel, un di koyanim un di Leviim. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />un di Leviim zainen getseilt gevorn fun draisik yor alt un hecher, un zeyer tsol loit zeyere kep, fun di mener, iz geven acht un draisik toiznt. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />fun di dozike, oif oiftsupasn oif der arbet fun hoiz fun Hashem fir un tsvantsik toiznt, un oifzeer un richter, zeks toiznt. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />un fir toiznt toierlait; un fir toiznt vos zoln loibn Hashem mit di klei-zemer vos ich hob gemacht oif tsu loibn.<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />un Dovid hot zei aingeteilt in ainteilungen loit di zin fun Levin: Gershon, Kohat, un Merari.<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />fun di Gershonim: Ladan, un Shimei. <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />di zin fun Ladanen: der hoipt Yechiel, un Zetam, un Yoel – drai. <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />di zin fun Shimeyen: Shelomit, un Chaziel, un Haran – drai. di dozike zainen geven hoiptn fun di foterhaizer fun Ladan. <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />un di zin fun Shimeyen zainen geven: Yachat, Zina, un Yeush un Beriah. dos zainen geven di fir zin fun Shimeyen.<verse eid="1CH 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 23:11" />un Yachat iz geven der hoipt, un Zizah der tsveiter; un Yeush un Beriah hobn nisht gehat fil zin, derum zainen zei in der tseilung geven ein foterhoiz.<verse eid="1CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />di zin fun Kohat; Amram, Yitshar, Chevron, un Uziel – fir. <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />di zin fun Amramen: Aharon, un Moshe. un Aharon iz opgesheidt gevorn, kedei im tsu heilikn far gor heilik, im un zaine zin biz eibik, tsu demfn far Hashem, im tsu badinen, un tsu bentshn in zain nomen eibik. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />un Moshe der man fun G-t, zaine kinder vern gerufn oif sheyvet Levi. <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />di zin fun Mosheen zainen geven: Gershom, un Eliezer.<verse eid="1CH 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 23:16" />di zin fun Gershomen: Shevuel der hoipt. <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />un di zin fun Eliezern zainen geven: Rechavyah der hoipt. un Eliezer hot nisht gehat kein andere zin; ober di zin fun Rechavyahn zainen geven fil biz gor. <verse eid="1CH 23:17" /><verse number="18" style="v" sid="1CH 23:18" />di zin fun Yitsharn zainen geven: Shelomit der hoipt. <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />di zin fun Chevronen: Yeriyahu, der hoipt, Amaryah der tsveiter, Yachaziel der driter, un Yekameam der firter. <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />di zin fun Uzieln: Michah der hoipt, un Yishiyah der tsveiter.<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />di zin fun Merarien: Machli, un Mushi. di zin fun Machlien: Elazar, un Kish. <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />un Elazar iz geshtorbn, un hot nisht gehat kein zin, nor techter; un zeyere eigene, di zin fun Kishon, hobn zei genumen. <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />di zin fun Mushien zainen geven: Machli, un Eder, un Yeremot – drai.<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />di dozike zainen geven di zin fun Levin loit zeyere foterhaizer, hoiptn fun di foterhaizer loit zeyere getseilte, noch der tsol fun nemen loit zeyere kep, di vos hobn geton di arbet far dem dinst fun hoiz fun Hashem, fun tsvantsik yor alt un hecher. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />vorem Dovid hot gezogt: Hashem Elokei Yisroel hot barut zain folk, un er rut in Yerushalayim oif eibik; <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />un oich di Leviim darfn mer nisht trogn dem mishkn, un ale zaine keilim far zain dinst. <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />yo, loit di letste verter fun Dovidn iz di tseilung fun di kinder fun Levi geven fun tsvantsik yor alt un hecher. <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />vorem zei hobn gedarft shtein bai der hant fun di kinder fun Aharon far dem dinst fun hoiz fun Hashem, oif di hoifn, un oif di kamern, un oif der reinikung fun ale heilike zachn, un der arbet fun dem dinst fun hoiz fun Elokim; <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />un far dem oisgeleigtn broit, un far dem zemelmel far shpaizopfer, sai fun umgezaierte kuchns, sai in a bakfan, sai in a shmorfan; un far yetveder faichter un trukener mos; <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />un oif tsu shtein morgn far morgn tsu danken un tsu loibn Hashem, un dest glaichn in ovnt; <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />un far yetveder oifbrengen fun brandopfer tsu Hashem in di Shabbosim, um rosh-choidesh, un in di yom-tuvim, loit der tsol, azoi vi der din vegen zei, tamid, far Hashem; <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />un az zei zoln hitn di hitung fun dem ohel-moed, un di hitung fun dem heiliktum, un di hitung fun di kinder fun Aharon, zeyere brider, far dem dinst fun hoiz fun Hashem.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="1CH 24" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />un di ainteilungen fun di kinder fun Aharon zainen geven: di zin fun Aharonen: Nadav, un Avihu, Elazar, un Itamar. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />un Nadav un Avihu zainen geshtorbn eider zeyer foter, un kein kinder hobn zei nisht gehat, zainen Elazar un Itamar geven koyanim. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />un Dovid, un Tsadok fun di kinder fun Elazar, un Achimelech fun di kinder fun Itamar, hobn zei aingeteilt loit zeyer rei in zeyer dinst. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />un fun di kinder fun Elazar hobn zich gefunen mer hoiptmener vi fun di kinder fun Itamar; un me hot zei azoi aingeteilt: fun di kinder fun Elazar zechtsn hoiptn fun foterhaizer, un fun di kinder fun Itamar, loit zeyere foterhaizer, acht. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />un me hot zei aingeteilt loit goirl, di azoi vi yene, vorem es zainen geven firshtn fun heiliktum, un firshtn fun HaElokim, i fun di kinder fun Elazar, i fun di kinder fun Itamar. <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" />un Shemayah der zun fun Netaneln, der shraiber, fun Levi, hot zei farshribn far dem melech, un di harn, un Tsadok dem koyen, un Achimelech dem zun fun Evyatarn, un di hoiptn fun di foterhaizer fun di koyanim un fun di Leviim: ein foterhoiz genumen fun Elazar, un eins genumen fun Itamar.<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7" />un der ershter goirl iz aroisgegangen oif Yehoyarivn, der tsveiter oif Yedayahn; <verse eid="1CH 24:7" /><verse number="8" style="v" sid="1CH 24:8" />der driter oif Choremen, der firter oif Shaarayimen; <verse eid="1CH 24:8" /><verse number="9" style="v" sid="1CH 24:9" />der finfter oif Malkiyahn, der zekster oif Miyaminen; <verse eid="1CH 24:9" /><verse number="10" style="v" sid="1CH 24:10" />der zibeter oif hakotsn, der achter oif Aviyahn; <verse eid="1CH 24:10" /><verse number="11" style="v" sid="1CH 24:11" />der nainter oif Yeshuaen, der tsentner oif Shekanyahuen; <verse eid="1CH 24:11" /><verse number="12" style="v" sid="1CH 24:12" />der elfter oif Elyashivn, der tsvelfter oif Yakimen; <verse eid="1CH 24:12" /><verse number="13" style="v" sid="1CH 24:13" />der draitsnter oif Chuppahn, der fertsnter oif Yeshevavn; <verse eid="1CH 24:13" /><verse number="14" style="v" sid="1CH 24:14" />der futsnter oif Bilgahn, der zechtsnter oif Immern; <verse eid="1CH 24:14" /><verse number="15" style="v" sid="1CH 24:15" />der zibetsnter oif Cheziren, der achtsenter oif Hapitsetsn; <verse eid="1CH 24:15" /><verse number="16" style="v" sid="1CH 24:16" />der naintsnter oif Petachyahn, der tsvantsikster oif Yechezkeln; <verse eid="1CH 24:16" /><verse number="17" style="v" sid="1CH 24:17" />der ein un tsvantsikster oif Yachinen, der tsvei un tsvantsikster oif Gamuln; <verse eid="1CH 24:17" /><verse number="18" style="v" sid="1CH 24:18" />der drai un tsvantsikster oif Delayahuen, der fir un tsvantsikster oif Maazyahuen. <verse eid="1CH 24:18" /><verse number="19" style="v" sid="1CH 24:19" />dos iz geven zeyer rei in zeyer dinst, tsu kumen in hoiz fun Hashem loit dem gezets tsu zei durch der hant fun zeyer foter Aharonen, azoi vi Hashem Elokei Yisroel hot im bafoiln.<verse eid="1CH 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />un fun di iberike kinder fun Levi: fun di zin fun Amramen, Shuvael; fun di zin fun Shuvaeln, Yechdeyahu. <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" />fun Rechavyahun: fun di zin fun Rechavyahun, der hoipt Yishiyah. <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />fun di Yitsharim, Shelomot; fun di zin fun Shelomot, Yachat. <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" />un di zin fun Chevronen, Yeriyahu, Amaryahu der tsveiter, Yachaziel der driter, Yekameam der firter. <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" />di zin fun Uzieln, Michah; fun di zin fun Michahn, Shamir. <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />der bruder fun Michah, Yishiyah; fun di zin fun Yishiyahn, Zecharyahu. <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" />di zin fun Merarien, Machli, un Mushi; di zin fun zain zun Yaaziyahuen – <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />di kinder fun Merarien fun zain zun Yaaziyahuen, Shoham, un Zakur, un Ivri. <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" />fun Machlien, Elazar; un er hot nisht gehat kein zin. <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />fun Kishon, di zin fun Kishon, Yerachmeel. <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" />un di zin fun Mushien, Machli, un Eder, un Yerimot. dos zainen geven di kinder fun di Leviim loit zeyere foterhaizer. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />un zei oich hobn gevorfn goirl azoi vi zeyere brider, di kinder fun Aharon, far dem melech Dovid, un Tsadokn, un Achimelechn, un di hoiptn fun di foterhaizer fun di koyanim un fun di Leviim; di foterhaizer fun dem hoipt azoi vi zain yingster bruder.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="1CH 25" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />un Dovid un di harn fun cheil hobn opgesheidt far dem dinst fun di zin fun ASafn un Hemanen un Yedutunen, di vos hobn neviish geshpilt oif harfn, oif gitarn, un oif tsimblen; un zeyer tsol, fun di mentshn vos hobn geton di arbet loit zeyer dinst, iz geven: <verse eid="1CH 25:1" /><verse number="2" style="v" sid="1CH 25:2" />fun di zin fun ASafn, Zakur, un Yosef, un Netanyah, un Asarelah, di zin fun ASafn; unter der hant fun ASafn, vos hot neviish geshpitl loit dem ainshtel fun dem melech. <verse eid="1CH 25:2" /><verse number="3" style="v" sid="1CH 25:3" />fun Yedutunen, di zin fun Yedutunen: Gedalyahu, un Tsori, un Yeshayahu, Chashavyahn, un Mattityahu – zeks, unter der hant fun zeyer foter Yedutunen, vos hot neviish geshpilt oif a harf baim danken un loibn Hashem. <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />fun Hemanen, di zin fun Hemanen: Bukiyahu, Matanyahu, Uziel, Shevuel, un Yerimot, Chananyah, Chanani, Eliatah, Giddalti, un Romamti-Ezer, Yoshbekashah, Maloti, Hotir, Machaziot. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />di ale zainen geven zin fun Heman dem melechs zeer in zachn fun HaElokim – tsu derheibn horn, vorem HaElokim hot geshonken Hemanen fertsn zin un drai techter. <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />di ale zainen geven unter der hant fun zeyer foter, baim gezang in hoiz fun Hashem, mit tsimblen, gitarn, un harfn, far dem dinst fun hoiz fun Elokim, loit dem ainshtel fun melech – ASaf, Yedutun, un Heman.<verse eid="1CH 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 25:7" />un zeyer tsol mit zeyere brider, gelernte in gezang tsu Hashem, ale kener, iz geven tsvei hundert un acht un achtsik. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />un zei hobn gevorfn goirl, a vach kegen, azoi der klenster azoi der grester, der kener azoi vi der talmid.<verse eid="1CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 25:9" />un der ershter goirl iz aroisgegangen oif ASafn – oif Yosefn.</para>
  <para style="p" vid="1CH 25:9">der tsveiter Gedalyahu; er un zaine brider un zaine zin – tsvelf.<verse eid="1CH 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 25:10" />der driter Zakur, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 25:11" />der firter oif Yitsrien, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 25:12" />der finfter Netanyah, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 25:13" />der zekster Bukiyahu, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 25:14" />der zibeter Yesarelah, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 25:15" />der achter Yeshayahu, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 25:16" />der nainter Matanyahu, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 25:17" />der tsentner Shimei, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 25:18" />der elfter Azareel, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 25:19" />der tsvelfter Chashavyah, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 25:20" />tsum draitsntn Shuvael, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 25:21" />tsum fertsntn Mattityahu, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 25:22" />tsum fuftsntn oif yremotn, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 25:23" />tsum zechtsntn oif Chananyahuen, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 25:24" />tsum zibetsntn oif Yoshbekashahn, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 25:25" />tsum achtsentn oif Chananien, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 25:26" />tsum naintsntn oif Malotien, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 25:27" />tsum tsvantsikstn oif Eliyatahn, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 25:28" />tsum ein un tsvantsikstn oif Hotirn, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 25:29" />tsum tsvei un tsvantsikstn oif Giddaltin, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 25:30" />tsum drai un tsvantsikstn oif Machazioten, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 25:31" />tsum fir un tsvantsikstn oif Romamti-Ezern, zaine zin, un zaine brider – tsvelf.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="1CH 26" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />far di opteilungen fun di toierlait: fun di Korachim: Meshelemyahu der zun fun Koreen, fun di zin fun ASafn. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />un Meshelemyahu hot gehat zin: Zecharyahu der bechor, Yediael der tsveiter, Zevadyahu der driter, Yatniel der firter; <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />Eilam der finfter, Yehochanan der zekster, Elyehoeinai der zibeter. <verse eid="1CH 26:3" /><verse number="4" style="v" sid="1CH 26:4" />un Oved-Edom hot gehat zin: Shemayah der bechor, Yehozavad der tsveiter, Yoach der driter, un Sachar der firter, un Netanel der finfter; <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />Ammiel der zekster, Yissachar der zibeter, Peultai der achter; vorem Elokim hot im gebentsht. <verse eid="1CH 26:5" /><verse number="6" style="v" sid="1CH 26:6" />un bai zain zun Shemayahn zainen geborn gevorn zin vos hobn geveltikt iber dem hoiz fun zeyer foter, vorem zei zainen geven heldishe giborim. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />di zin fun Shemayahn zainen geven: Otni, un Refael, un Oved, Elzavad, zaine brider, heldishe yungen, un Elihu, un Semachyahu. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />di ale fun di kinder fun Oved-Edomen, zei un zeyere zin un zeyere brider, heldishe lait mit koiech tsum dinst; tsvei un zechtsik fun Oved-Edomen. <verse eid="1CH 26:8" /><verse number="9" style="v" sid="1CH 26:9" />un Meshelemyahu hot gehat zin un brider, heldishe yungen, achtsen. <verse eid="1CH 26:9" /><verse number="10" style="v" sid="1CH 26:10" />un Chosah fun di zin fun Merarien hot gehat zin: Shimri iz geven der hoipt; hagam er iz nisht geven der bechor, ober zain foter hot im gemacht faran hoipt; <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />Chilkiyah der tsveiter, Tevalyahu der driter, Zecharyahu der firter; ale zin un brider fun Chosahn – draitsn.<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />di dozike opteilungen fun di toierlait, di hoiptmener, hobn gehat vachn azoi vi zeyere brider, tsu badinen in hoiz fun Hashem. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />un zei hobn gevorfn goirl, azoi der klenster azoi der grester, loit zeyere foterhaizer, toier far toier. <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />un der goirl oif mizrech iz gefaln Shelemyahuen. un far zain zun Zecharyahuen, a klugn baal-yoets, hobn zei gevorfn goirl, un zain goirl iz gefaln oif tsofn. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Oved-Edomen tsu dorem, un zaine zin dos zamlhoiz. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />un shupimen un Chosahn, tsu mayrev, baim toier Shallechet, lebn dem veg vos geit aroif tsu, a vach kegen a vach. <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />tsu mizrech zeks Leviim, tsu tsofn fir a tog, tsu dorem fir a tog, un bai dem zamlhoiz tsu tsvei un tsvei. <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />far dem forhoif tsu mayrev, fir baim veg, tsvei baim forhoif. <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />dos zainen geven di opteilungen fun di toierlait fun di kinder fun di Korachim un fun di kinder fun Merari.<verse eid="1CH 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />un fun di Leviim, iz Achiyah geven iber di shatsn fun hoiz fun Elokim, un iber di shatsn fun di geheilikte zachn. <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />di kinder fun Ladan, di kinder fun di Gershonim fun Ladan, di hoiptn fun di foterhaizer fun Ladan dem gershuni, zainen geven di Yechielim. <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />di kinder fun di Yechielim, Zetam, un zain bruder Yoel, zainen geven iber di shatsn fun hoiz fun Hashem. <verse eid="1CH 26:22" /><verse number="23" style="v" sid="1CH 26:23" />fun di Amramim, fun di Yitsharim, fun di Chevronim, fun di Uzielim, <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />iz Shevuel der zun fun Gershom dem zun fun Mosheen, geven der firsht iber di shatsn. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />un zaine brider, fun Eliezern, zainen geven: zain zun Rechavyahu, un zain zun Yeshayahu, un zain zun Yoram, un zain zun Zichri, un zain zun Shelomit. <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />der doziker Shelomot un zaine brider zainen geven iber ale shatsn fun di geheilikte zachn vos Dovid hameilech, un di hoiptn fun di foterhaizer, di hoiptlait fun di toizntn un di hundertn, un di cheil-lider, hobn geheilikt. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />fun di milchomes un fun dem roib hobn zei es geheilikt oif tsu farrichtn dos hoiz fun Hashem. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />un alts vos Shmuel der zeer, un Shaul der zun fun Kishon, un Avner der zun fun Neren, un Yoav der zun fun Tseruyahn, hobn geheilikt, ver nor es hot geheilikt, iz dos geven unter der hant fun Shelomitn un zaine brider.<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />fun di Yitsharim, zainen Konanyahu un zaine zin geven faran oisenveinikstn dinst iber Yisroel, far oifzeer un far richter. <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" />fun di Chevronim zainen Chashavyahn un zaine brider, heldishe yungen, toiznt un zibn hundert, geven far der oifzeung iber Yisroel fun yener zait Yarden tsu mayrev, far yetveder arbet fun Hashem, un far dem dinst fun melech. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />fun di Chevronim, iz Yeriyah geven der hoipt – fun di Chevronim loit zeyere geburtn noch di foterhaizer. in fertsikstn yor fun Dovids meluche zainen zei nochgezucht gevorn, un es zainen gefunen gevorn tsvishn zei heldishe giborim in Yazeir-Gilad. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />un zaine brider, heldishe yungen, zainen geven tsvei toiznt un zibn hundert, hoiptn fun foterhaizer; un Dovid hameilech hot zei oifgezetst iber di Reuvenim, un di Gadim, un dem halbn sheyvet Menasheh, far ale zachn fun HaElokim un zachn fun melech.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="1CH 27" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />un di kinder fun Yisroel loit zeyer tsol, di hoiptn fun di foterhaizer un di hoiptlait fun di toizntn un hundertn, un zeyere oifzeer, vos hobn badint dem melech in ale zachn fun di opteilungen vos zainen araingekumen un aroisgegangen choidesh far choidesh durch ale chodeshim fun yor, zainen geven tsu fir un tsvantsik toiznt in itlecher opteilung.<verse eid="1CH 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2" />iber der ershter opteilung faran ershtn choidesh iz geven Yashovam der zun fun Zavdieln; un in zain opteilung zainen geven fir un tsvantsik toiznt. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />fun di kinder fun Perets iz er geven; der hoipt fun ale cheil-lider faran ershtn choidesh.<verse eid="1CH 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 27:4" />un iber der opteilung fun tsveitn choidesh iz geven Dodai der Achochi, un mit zain opteilung iz geven Miklot der firsht; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 27:5" />der driter cheil-lider faran dritn choidesh iz geven Benayahu der zun fun dem koyen Yehoyada, der hoipt; <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />un in zain opteilung zainen geven fir un tsvantsik toiznt. dos iz Benayahu der gibor fun di draisik un iber di draisik; mit zain opteilung iz geven zain zun Ammizavad.<verse eid="1CH 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 27:7" />der firter faran firtn choidesh iz geven Asahel, der bruder fun Yoavn, un Zevadyah zain zun noch im; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 27:8" />der finfter faran finftn choidesh iz geven der hoiptman Shamhut der Yizrachi; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 27:9" />der zekster faran zekstn choidesh iz geven Ira der zun fun Ikeshn fun Tekoa; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 27:10" />der zibeter faran zibetn choidesh iz geven Chelets fun Pelon, fun di kinder fun Efrayim; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 27:11" />der achter faran achten choidesh iz geven Sibbechai fun Chushah, fun di Zerachim; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 27:12" />der nainter faran naintn choidesh iz geven Aviezer fun Anatot, fun di Binyaminer; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 27:13" />der tsentner faran tsentn choidesh iz geven Maharai fun Netofah, fun di Zerachim; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 27:14" />der elfter faran elftn choidesh iz geven Benayah fun Pirathon, fun di kinder fun Efrayim; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 27:15" />der tsvelfter faran tsvelftn choidesh iz geven Cheldai fun Netofah, fun Otniel; un in zain opteilung zainen geven fir un tsvantsik toiznt.<verse eid="1CH 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />un iber di shvotim fun Yisroel; fun di Reuvenim iz geven der firsht, Eliezer der zun fun Zichrien; fun di Shimeonim, Shefatyahu der zun fun Maachahn; <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" />fun Levi, Chashavyah der zun fun Kemueln; fun Aharon Tsadok;<verse eid="1CH 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 27:18" />fun Yehudah, Elihu fun Dovids brider; fun Yissachar, Omri der zun fun Michaeln; <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />fun Zevulun, Yishmayahu der zun fun Ovadyahuen; fun Naftali, Yerimot der zun fun Azrieln; <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />fun di kinder fun Efrayim, Hoshea der zun fun Azazyahun; fun dem halbn sheyvet Menasheh, Yoel der zun fun Pedayahuen; <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />fun dem halbn sheyvet Menasheh in Gilad, Yiddo der zun fun Zecharyahuen; fun Binyamin, Yaasiel der zun fun Avnern; <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" />fun Dan, Azareel der zun fun Yerochamen. dos zainen geven di harn fun di shvotim fun Yisroel. <verse eid="1CH 27:22" /><verse number="23" style="v" sid="1CH 27:23" />un Dovid hot nisht oifgenumen zeyer tsol fun tsvantsik yor alt un arunter; vorem Hashem hot tsugezogt tsu mern Yisroel azoi vi di shtern fun himel. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Yoav der zun fun Tseruyahn hot ongehoibn tseiln un tsu mol nisht geendikt, fun dest vegen iz geven iber dem a tsorn oif Yisroel; un di tsol iz nisht arain in der dertseilung fun di tsaitgesheenishn fun melech Dovid.<verse eid="1CH 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />un iber di shatsn fun dem melech iz geven Azmavet der zun fun Adieln, un iber di shpaichlers in di felder, in di shtet, un in di derfer, un in di turems, Yehonatan der zun fun Uziyahun.<verse eid="1CH 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 27:26" />un iber di vos tuen feldarbet bai der baarbetung fun der erd, Ezri der zun fun chluvn. <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />un iber di vaingertner, Shimei fun Ramah; un iber vos in di vaingertner far di vainkelers, Zavdi fun Shafam. <verse eid="1CH 27:27" /><verse number="28" style="v" sid="1CH 27:28" />un iber di eilbertbeimer un di vilde faignbeimer vos in der niderung, Baal-Chanan fun Gedor; un iber di eilkelers, Yoash. <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />un iber di rinder vos hobn zich gefitert in Sharon, Shirtai fun Sharon; un iber di rinder in di toln, Shafat der zun fun Adlain. <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />un iber di kemlen, Ovil der Yishmelim; un iber di eizelins, Yechdeyahu fun Meronot. <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />un iber di shof, Yaziz der Hagri. di ale zainen geven di oifzeers iber dem farmeg vos der melech Dovid hot gehat.<verse eid="1CH 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />un Yehonatan, Dovids feter iz geven a baal-yoets, a farshtandiker man un a shraiber. un Yechiel der zun fun Chachmonien iz geven mit dem melechs zin. <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />un Achitofel iz geven dem melechs baal-yoets, un Chushai der Arki iz geven dem melechs guter fraint. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />un noch Achitofeln iz geven Yehoyada der zun fun Benayahuen, un Evyatar; un der cheil-lider fun dem melech iz geven Yoav.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="1CH 28" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />un Dovid hot aingezamlt ale harn fun Yisroel, di harn fun di shvotim, un di hoiptlait fun di opteilungen vos hobn badint dem melech, un di hoiptlait fun di toizntn un di hoiptlait fun di hundertn, un di oifzeers iber dem gantsn farmeg un fich fun melech un fun zaine zin, mit di hoifdiner un di giborim – itlechn heldishn gibor – kein Yerushalayim. <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" />un Dovid hameilech hot zich geshtelt oif zaine fis, un hot gezogt: hert mich tsu, maine brider un main folk; bai mir in main hartsn iz geven tsu boien a hoiz fun ru far dem orn fun Hashems bris, un far a fusbenkel far Elokeinu, un ich hob zich ongebreit tsu boien. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />ober HaElokim hot tsu mir gezogt: kenst nisht boien a hoiz tsu main nomen, vorem a mentsh fun milchomes bistu, un blut hostu fargosen. <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />ober Hashem Elokei Yisroel hot mich oisderveilt fun dem gantsn hoiz fun main foter tsu zain a melech iber Yisroel oif eibik; vorem Yehudahn hot Hashem oisderveilt far a firsht, un in dem hoiz fun Yehudah, dem hoiz fun main foter, un tsvishn di zin fun main foter, hot er mich bagert, oif tsu machn far a melech iber gants Yisroel. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />un fun ale maine zin – vorem fil zin hot mir Hashem geshonken – hot er oisderveilt main zun Shlomoen tsu zitsn oif dem tron fun G-ts meluche iber Yisroel. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />un er hot tsu mir gezogt: dain zun Shlomo, er vet boien main hoiz un maine hoifn, vorem ich hob im oisderveilt far a zun tsu mir, un ich vel im zain far a foter. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />un ich vel bafestikn zain meluche oif eibik, oib er vet zain shtark, tsu ton maine gebot un maine gezetsn azoi vi haintikn tog. <verse eid="1CH 28:7" /><verse number="8" style="v" sid="1CH 28:8" />un atsund, far di oign fun gants Yisroel, der eide fun Hashem, un in di oiern fun Elokeinu; hit op un zucht noch ale gebot fun Hashem Elokeichem, kedei ir zolt arben dos gute land, un lozn in yerushe tsu aiere kinder noch aich biz eibik.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />un du Shlomo main zun, veis dem G-t fun dain foter, un din im mit a gantsn hartsn, un mit a viliker zel, vorem ale hertser forsht Hashem, un yetveder trachtenish fun di gedanken ken er; az du vest im zuchn, vet er zich lozn gefinen fun dir, ober az du vest im farlozen, vet er dich avekvarfn oif eibik. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />kuk zich arum atsund, vorem Hashem hot dich oisderveilt tsu boien a hoiz far a mikdash; zei shtark, un tu.<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />un Dovid hot gegebn zain zun Shlomoen dos gemel fun dem foderhoiz, un zaine binyonim, un zaine shatskamern, un zaine eibershtubn, un zaine ineveinikste chadorem, un dos hoiz fun dem dek; <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />un dos gemel fun alts vos iz geven bai im in gedanken durch dem ruach Hakoidesh, far di hoifn fun hoiz fun Hashem, un far ale kamern rund arum, far di shatsn fun hoiz fun HaElokim, un far di shatsn fun di geheilikte zachn, <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />un far di opteilungen fun di koyanim un di Leviim, un far alerlei arbet fun dem dinst in hoiz fun Hashem, un far di keilim fun dem dinst in hoiz fun Elokim.<verse eid="1CH 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 28:14" />gold oifn vog, far dem gold fun alerlei keilim far yetveder dinst; far ale zilberne keilim, oifn vog, far alerlei keilim fun yetveder dinst. <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />un oifn vog far di gilderne menoyrus mit zeyere gilderne rerlech, loit der vog fun itlecher menoyre mit ire rerlech; un far di zilberne menoyrus loit der vog fun a menoyre mit ire rerlech, vi noch der arbet fun itlecher menoyre. <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />un gold oifn vog far di tishn fun der oisleigung, far itlechn tish; un zilber far di zilberne tishn. <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />un far di goplen, un di shprengbekns, un di kanen, reine gold; un far di gilderne bechers, oifn vog far itlechn becher; un far di zilberne bechers, oifn vog far itlechn becher. <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />un far dem mizbeyech fun vairech gelaiterte gold oifn vog; un gold far der geshtalt fun dem raitvogn, di kruvim vos shpreitn ois un shiremen iber dem orn fun Hashems bris. <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" />dos alts gib ich dir in geshrifts, fun der hant fun Hashem vos hot mich gekligt; ale arbeten fun dem gemel.<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />un Dovid hot gezogt tsu zain zun Shlomoen: zai shtark un fest, un tu; zolst nisht moire hobn un nisht angstn, vorem Hashem Elokim, main G-t, iz mit dir; er vet dich nisht oplozen un nisht farlozen, biz di gantse arbet far dem dinst fun hoiz fun Hashem vet zain geendikt. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />un ot zainen di opteilungen fun di koyanim un di Leviim far yetveder dinst fun hoiz fun Elokim; un du host mit zich far yetveder arbet itlechn vos iz gernvilik, mit klugshaft far alerlei arbet; un di harn un dos gantse folk zainen tsu ale daine bafeln.<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="1CH 29" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />un Dovid hameilech hot gezogt tsu der gantser ainzamlung: Shlomo main zun, vos im einem hot Hashem oisderveilt, iz yung un shvach, un di arbet iz grois, vorem nisht far a mentshn iz der palats, nor far Hashem Elokim. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />un mit ale maine koiches hob ich ongegreit far dem hoiz fun main G-t, gold far di gilderne zachn, un zilber far di zilberne, un kuper far di kuperne, aizn far di aizerne, un holts far di hiltserne; oniklshteiner un shteiner tsum ainfasn, glantsike un filfarbike shteiner, un alerlei taier geshtein, un mirmlshteiner lerov. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />un mer noch: vail ich bager dos hoiz fun main G-t, hob ich an Etser gold un zilber vos ich gib avek far dem hoiz fun main G-t, achuts alts vos ich hob ongegreit far dem heilikn hoiz: <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />drai toiznt tsentner gold, fun gold fun Ofir, un zibn toiznt tsentner gelaiterte zilber, oif tsu baleign di vent fun di haizer; <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />gold vu me darf gold, un zilber vu zilber; un far yetveder arbet durch der hant fun mainsters. un ver vil haint menadev zain mit zain fuler hant tsu Hashem?<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />un di harn fun di foterhaizer, un di harn fun di shvotim fun Yisroel, un di hoiptlait fun di toizntn un di hundertn, un di oifzeers iber dem melechs virtshaft, hobn menadev geven. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />un zei hobn geshonken far der arbet fun hoiz fun Elokim, gold finf toiznt tsentner, un adarkonim tsen toiznt, un zilber tsen toiznt tsentner, un kuper achtsen toiznt tsentner, un aizn hundert toiznt tsentner. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />un di vos bai zei hobn zich gefunen taiere shteiner, hobn es avekgegebn tsu dem shats fun hoiz fun Hashem, unter der hant fun Yechiel dem gershuni. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />un dos folk hot zich gefreit vos zei hobn menadev geven, vorem mitn gantsn hartsn hobn zei menadev geven tsu Hashem, un oich Dovid hameilech hot zich gefreit a grois freid.<verse eid="1CH 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />un Dovid hot geloibt Hashem far di oign fun der gantser ainzamlung, un Dovid hot gezogt: geloibt bistu Hashem Elokei Yisroel, undzer foter, fun eibik un biz eibik. <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />dain, Hashem, iz di groiskeit, un di shtarkeit, un di prachtikeit, un di eibikeit, un der glants, vorem alts vos oifn himel un oif der erd; dain, Hashem, iz di meluche, un du bist derhoibn tsum hoipt iber alem. <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />un oysher un koved zainen fun dir, un du geveltikst iber alts, un in dain hant iz koiech un gevure, un in dain hant iz tsu greisn un tsu shtarkn alemen. <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />un atsund, Elokeinu, danken mir dir, un loibn dain prachtikn nomen. <verse eid="1CH 29:13" /><verse number="14" style="v" sid="1CH 29:14" />vorem ver bin ich, un ver iz main folk, az mir zoln hobn bekoyech menadev tsu zain azoi-vos? nor fun dir iz alts, un fun dain hant hobn mir dir gegebn. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />vorem fremde zainen mir far dir, un aingevanderte, azoi vi ale undzere eltern; azoi vi a shotn zainen undzere teg oif der erd, un on a bashtand. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Hashem Elokeinu, dos dozike gantse raichtum vos mir hobn ongegreit oif dir tsu boien a hoiz far dain heilikn nomen, iz fun dain hant, un alts iz dain. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />un ich veis, main G-t, az du pruvst dos harts, un bagerst rechtfartikeit. ich hob mit rechtfartikeit fun main hartsn menadev geven dos alts; un atsund hob ich gezen mit simche vi dain folk vos gefint zich do hot menadev geven tsu dir. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Hashem Elokei Avraham, Yitschak, un Yisroel, undzere eltern, halt dos on oif eibik, di trachtung fun di gedanken fun dain folks hartsn, un ker zeyer harts tsu dir. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />un Shlomoen main zun gib a gants harts tsu hitn daine gebot, daine tseignim, un daine gezetsn, un tsu ton dos alts, un tsu boien dem palats vos ich hob tsugegreit.<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />un Dovid hot gezogt tsu der gantser ainzamlung: loibt Nun Hashem Elokeichem. un di gantse ainzamlung hot geloibt Hashem dem Elokei zeyere eltern, un zei hobn zich geneigt un zich gebukt tsu Hashem un tsum melech. <verse eid="1CH 29:20" /><verse number="21" style="v" sid="1CH 29:21" />un zei hobn geshlacht shlachtopfer tsu Hashem, un oifgebracht brandopfer tsu Hashem, oif morgn fun yenem tog, toiznt oksen, toiznt viders, toiznt shepsn, mit zeyere gisopfer, un shlachtopfer lerov far gants Yisroel. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />un zei hobn gegesn un getrunken far Hashem in yenem tog mit grois simche, un zei hobn a tsveit mol gemacht Shlomo dem zun fun Dovidn far a melech, un gezalbt far a firsht fun Hashem, un Tsadokn far a koyen.<verse eid="1CH 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 29:23" />un Shlomo hot zich gezetst oif dem tron fun Hashem far a melech oif dem ort fun zain foter Dovidn, un er hot baglikt. un gants Yisroel hobn zich tsugehert tsu im. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />un ale harn, un di giborim, un oich ale zin fun dem melech Dovid, hobn zich untervorfn unter Shlomo hameilech. <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />un Hashem hot Shlomoen hoich gegreist far di oign fun gants Yisroel, un er hot gegebn oif im a kiniglechn glants vos iz nisht geven oif kein melech iber Yisroel far im.<verse eid="1CH 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />un Dovid der zun fun Yishaien hot gekinigt iber gants Yisroel. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />un di teg vos er hot gekinigt iber Yisroel, zainen geven fertsik yor: in Chevron hot er gekinigt zibn yor, un in Yerushalayim hot er gekinigt drai un draisik. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />un er iz geshtorbn in a guter elter, zat mit teg, oysher, un koved; un zain zun Shlomo iz gevorn melech oif zain ort. <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />un di zachn vegen Dovidn, di ershte azoi vi letste, zei zainen bashribn in di verter fun Shmuel dem zeer, un in di verter fun Natan dem novi, un in di verter fun Gad dem zeer, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />mit zain gantser meluche, un zaine gevuros, un di tsaitn vos zainen ariber iber im un iber Yisroel, un iber ale kinigraichn fun di lender.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>