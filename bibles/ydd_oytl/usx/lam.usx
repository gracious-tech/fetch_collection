<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Echah</para>
  <para style="toc2">Echah</para>
  <para style="toc1">Echah</para>
  <para style="mt1">Echah</para>
  <chapter number="1" style="c" pubnumber="א" sid="LAM 1" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1" />vi iz geblibn zitsn alein</para>
  <para style="q" vid="LAM 1:1">di shtot fun fil folk;</para>
  <para style="q" vid="LAM 1:1">gevorn vi an almone</para>
  <para style="q" vid="LAM 1:1">di firshtn tsvishn di umes;</para>
  <para style="q" vid="LAM 1:1">di harinte tsvishn di medines</para>
  <para style="q" vid="LAM 1:1">gevorn tsu tsindz!<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2" />veinen tut zi veinen bai nacht,</para>
  <para style="q" vid="LAM 1:2">un ir trer iz oif ir bak;</para>
  <para style="q" vid="LAM 1:2">zi hot nisht kein treister fun ale ire libhober;</para>
  <para style="q" vid="LAM 1:2">ale ire gute fraint hobn gefelsht on ir,</para>
  <para style="q" vid="LAM 1:2">zei zainen ir sonem gevorn.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3" />Yehudah iz in goles avek</para>
  <para style="q" vid="LAM 1:3">in pain un in grois knechtshaft;</para>
  <para style="q" vid="LAM 1:3">zi zitst tsvishn di felker,</para>
  <para style="q" vid="LAM 1:3">zi gefint nisht kein ru;</para>
  <para style="q" vid="LAM 1:3">ale ire nochyogers</para>
  <para style="q" vid="LAM 1:3">hobn zi dergreicht tsvishn di engenishn.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4" />di vegen fun Tsiyon troiern,</para>
  <para style="q" vid="LAM 1:4">vail nishto di vos kumen oif yom-tov;</para>
  <para style="q" vid="LAM 1:4">ale ire toiern zainen vist,</para>
  <para style="q" vid="LAM 1:4">ire koyanim ziftsn,</para>
  <para style="q" vid="LAM 1:4">ire yungfroin zainen farumert,</para>
  <para style="q" vid="LAM 1:4">un zi, biter iz ir.<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5" />ire faint zainen gevorn di kep,</para>
  <para style="q" vid="LAM 1:5">ire sonem zainen in shalve;</para>
  <para style="q" vid="LAM 1:5">vorem Hashem hot zi farumert,</para>
  <para style="q" vid="LAM 1:5">far di fil farbrechn ire;</para>
  <para style="q" vid="LAM 1:5">ire kleine kinder zainen avek</para>
  <para style="q" vid="LAM 1:5">in gefangenshaft farois faran faint.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6" />un arois iz fun tochter Tsiyon</para>
  <para style="q" vid="LAM 1:6">der gantser glants irer;</para>
  <para style="q" vid="LAM 1:6">ire harn zainen gevorn vi di hindn,</para>
  <para style="q" vid="LAM 1:6">vos gefinen nisht kein fiterung,</para>
  <para style="q" vid="LAM 1:6">un zei zainen gegangen on koiech</para>
  <para style="q" vid="LAM 1:6">far dem nochyoger.<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7" />Yerushalayim dermont zich</para>
  <para style="q" vid="LAM 1:7">in di teg fun ir pain un ire voglenishn,</para>
  <para style="q" vid="LAM 1:7">ale glustikeitn vos zi hot gehat</para>
  <para style="q" vid="LAM 1:7">in di teg fun a mol.</para>
  <para style="q" vid="LAM 1:7">ven ir folk iz gefaln fun der hant fun faint,</para>
  <para style="q" vid="LAM 1:7">un zi hot nisht kein helfer gehat,</para>
  <para style="q" vid="LAM 1:7">hobn di faint gekukt oif ir,</para>
  <para style="q" vid="LAM 1:7">gelacht oif ir untergang.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8" />zind gezindikt hot Yerushalayim,</para>
  <para style="q" vid="LAM 1:8">derum iz zi far an umreiner gevorn;</para>
  <para style="q" vid="LAM 1:8">ale vos hobn zi geacht, farachten zi,</para>
  <para style="q" vid="LAM 1:8">vail zei hobn gezen ir shand;</para>
  <para style="q" vid="LAM 1:8">yo, zi alein tut ziftsn, un kert zich ahinter.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9" />ir umreinikeit iz geven in ire bregn,</para>
  <para style="q" vid="LAM 1:9">zi hot nisht gedacht on ir sof;</para>
  <para style="q" vid="LAM 1:9">derum hot zi vunderlech genidert,</para>
  <para style="q" vid="LAM 1:9">zi hot nisht kein treister.</para>
  <para style="q" vid="LAM 1:9">ze, Hashem, main pain,</para>
  <para style="q" vid="LAM 1:9">vorem der soine tut zich greisn.<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10" />der faint hot oisgeshpreit zain hant</para>
  <para style="q" vid="LAM 1:10">oif ale ire glustikeitn;</para>
  <para style="q" vid="LAM 1:10">vorem zi hot gezen vi di felker</para>
  <para style="q" vid="LAM 1:10">zainen gekumen in ir heiliktum,</para>
  <para style="q" vid="LAM 1:10">di vos du host bafoiln,</para>
  <para style="q" vid="LAM 1:10">zei zoln in dain eide nisht kumen.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11" />dos gantse folk irs ziftst, zei zuchn broit;</para>
  <para style="q" vid="LAM 1:11">zeyere glustikeitn hobn zei avekgegebn far shpaiz,</para>
  <para style="q" vid="LAM 1:11">dem nefesh tsu derkvikn.</para>
  <para style="q" vid="LAM 1:11">ze, Hashem, un kuk</para>
  <para style="q" vid="LAM 1:11">vi niderik ich bin gevorn.<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12" />nisht geshen zol es aich, ale veggeyer!</para>
  <para style="q" vid="LAM 1:12">tut a kuk, un zet,</para>
  <para style="q" vid="LAM 1:12">tsi iz do a veitog vi main veitog,</para>
  <para style="q" vid="LAM 1:12">vos iz mir ongeton gevorn,</para>
  <para style="q" vid="LAM 1:12">ven Hashem hot mich farumert,</para>
  <para style="q" vid="LAM 1:12">in tog fun zain grimtsorn.<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13" />fun der heich hot er aropgeshikt a faier</para>
  <para style="q" vid="LAM 1:13">in maine beiner, un zei baveltikt;</para>
  <para style="q" vid="LAM 1:13">er hot farshpreit a nets far maine fis,</para>
  <para style="q" vid="LAM 1:13">er hot mich ahinter gekert;</para>
  <para style="q" vid="LAM 1:13">vist hot er mich gemacht, krank a gantsn tog.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14" />farknipt mit zain hant iz der yoch fun maine zind;</para>
  <para style="q" vid="LAM 1:14">zei flechtn zich, zei leign zich aroif oif main haldz;</para>
  <para style="q" vid="LAM 1:14">er hot gemacht shtroichlen main koiech;</para>
  <para style="q" vid="LAM 1:14">Adonoi hot mich gegebn in hent,</para>
  <para style="q" vid="LAM 1:14">az ich ken nisht oifshtein.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15" />Adonoi hot gemacht tsunisht</para>
  <para style="q" vid="LAM 1:15">ale maine giborim in mir;</para>
  <para style="q" vid="LAM 1:15">er hot gerufn oif mir an ainzamlung,</para>
  <para style="q" vid="LAM 1:15">tsu tsebrechn maine yungelait;</para>
  <para style="q" vid="LAM 1:15">vi a kelter hot Adonoi getretn,</para>
  <para style="q" vid="LAM 1:15">di yungfroi tochter Yehudah.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16" />deroif tu ich veinen,</para>
  <para style="q" vid="LAM 1:16">main oig, main oig rint vaser;</para>
  <para style="q" vid="LAM 1:16">vorem vait iz a treister fun mir,</para>
  <para style="q" vid="LAM 1:16">vos zol derkvikn main zel;</para>
  <para style="q" vid="LAM 1:16">maine kinder zainen farvist,</para>
  <para style="q" vid="LAM 1:16">vorem der soine hot ibergeshtarkt.<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17" />Tsiyon tseshpreit ire hent,</para>
  <para style="q" vid="LAM 1:17">zi hot nisht kein treister;</para>
  <para style="q" vid="LAM 1:17">Hashem hot bafoiln akegn Yaakov</para>
  <para style="q" vid="LAM 1:17">rund arum im zaine faint;</para>
  <para style="q" vid="LAM 1:17">Yerushalayim iz gevorn far an umreiner tsvishn zei.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18" />Hashem iz gerecht,</para>
  <para style="q" vid="LAM 1:18">vorem ich hob vidershpenikt zain moil;</para>
  <para style="q" vid="LAM 1:18">hert, ale felker, ich bet aich,</para>
  <para style="q" vid="LAM 1:18">un zet tsu main veitog:</para>
  <para style="q" vid="LAM 1:18">maine bochurim un maine meidlech</para>
  <para style="q" vid="LAM 1:18">zainen avek in gefangenshaft.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19" />ich hob gerufn maine libhober,</para>
  <para style="q" vid="LAM 1:19">hobn zei mich opgenart;</para>
  <para style="q" vid="LAM 1:19">maine koyanim un maine eltste</para>
  <para style="q" vid="LAM 1:19">zainen oisgegangen in shtot,</para>
  <para style="q" vid="LAM 1:19">ven zei hobn shpaiz zich gezucht,</para>
  <para style="q" vid="LAM 1:19">zei zoln zeyer nefesh derkvikn.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20" />ze, Hashem, vi mir iz eng,</para>
  <para style="q" vid="LAM 1:20">maine ingeveid brenen,</para>
  <para style="q" vid="LAM 1:20">main harts kert zich iber in mir,</para>
  <para style="q" vid="LAM 1:20">vail vidershpenikn hob ich vidershpenikt;</para>
  <para style="q" vid="LAM 1:20">droisn nemt avek di shverd,</para>
  <para style="q" vid="LAM 1:20">in hoiz iz vi der toit.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21" />zei hobn gehert vi ich zifts,</para>
  <para style="q" vid="LAM 1:21">ober ich hob nisht kein treister;</para>
  <para style="q" vid="LAM 1:21">ale maine sonem hobn gehert main umglik,</para>
  <para style="q" vid="LAM 1:21">zei freyen zich vos du host dos geton,</para>
  <para style="q" vid="LAM 1:21">breng dem tog vos du host ongezogt,</para>
  <para style="q" vid="LAM 1:21">un zoln zei vern vi ich!<verse eid="LAM 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22" />zol kumen al zeyer beiz far dir,</para>
  <para style="q" vid="LAM 1:22">un tu tsu zei</para>
  <para style="q" vid="LAM 1:22">azoi vi du host tsu mir geton,</para>
  <para style="q" vid="LAM 1:22">far ale maine zind;</para>
  <para style="q" vid="LAM 1:22">vorem fil zainen maine ziftsn,</para>
  <para style="q" vid="LAM 1:22">un main harts iz krank.<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="LAM 2" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1" />vi hot Adonoi in zain kaas</para>
  <para style="q" vid="LAM 2:1">farvolknt di tochter Tsiyon!</para>
  <para style="q" vid="LAM 2:1">aropgevorfen fun himel tsu der erd</para>
  <para style="q" vid="LAM 2:1">di sheinkeit fun Yisroel,</para>
  <para style="q" vid="LAM 2:1">un nisht gedacht on zain fusbenkel</para>
  <para style="q" vid="LAM 2:1">in tog fun zain kaas!<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2" />Adonoi hot umgebracht on rachmones</para>
  <para style="q" vid="LAM 2:2">ale voinungen fun Yaakov;</para>
  <para style="q" vid="LAM 2:2">tseshtert in zain tsorn</para>
  <para style="q" vid="LAM 2:2">di festungen fun tochter Yehudah,</para>
  <para style="q" vid="LAM 2:2">zei gebracht tsu der erd;</para>
  <para style="q" vid="LAM 2:2">farshvecht dos kinigraich un zaine harn!<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3" />er hot opgehakt mit grimtsorn</para>
  <para style="q" vid="LAM 2:3">dem gantsn horn fun Yisroel;</para>
  <para style="q" vid="LAM 2:3">er hot tsurikgetsoign zain rechte hant</para>
  <para style="q" vid="LAM 2:3">fun faran soine,</para>
  <para style="q" vid="LAM 2:3">un gebrent in Yaakov vi a flamfaier</para>
  <para style="q" vid="LAM 2:3">vos fartsert rund arum.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4" />er hot geshpant zain boign vi a soine,</para>
  <para style="q" vid="LAM 2:4">zich geshtelt mit zain rechter hant vi a faint,</para>
  <para style="q" vid="LAM 2:4">un geharget ale glustike fun oig;</para>
  <para style="q" vid="LAM 2:4">in getselt fun tochter Tsiyon</para>
  <para style="q" vid="LAM 2:4">hot er oisgegosen vi a faier zain grimtsorn.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5" />Adonoi iz gevorn vi a soine,</para>
  <para style="q" vid="LAM 2:5">er hot umgebracht Yisroel;</para>
  <para style="q" vid="LAM 2:5">umgebracht ale ire palatsn,</para>
  <para style="q" vid="LAM 2:5">tseshtert zaine festungen,</para>
  <para style="q" vid="LAM 2:5">un gemert bai tochter Yehudah klogenish un klog.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6" />un er hot opgeflikt</para>
  <para style="q" vid="LAM 2:6">vi a gortn zain baidl,</para>
  <para style="q" vid="LAM 2:6">er hot tseshtert zain zamlort;</para>
  <para style="q" vid="LAM 2:6">Hashem hot gemacht fargesen in Tsiyon</para>
  <para style="q" vid="LAM 2:6">a yom-tov un a Shabbos,</para>
  <para style="q" vid="LAM 2:6">un faracht in zain grimtsorn</para>
  <para style="q" vid="LAM 2:6">dem melech un dem koyen.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7" />Adonoi hot farlozt zain mizbeyech,</para>
  <para style="q" vid="LAM 2:7">avekgevorfen zain mikdash;</para>
  <para style="q" vid="LAM 2:7">ibergeentfert in hant fun dem soine</para>
  <para style="q" vid="LAM 2:7">di moiern fun ire palatsn;</para>
  <para style="q" vid="LAM 2:7">zei hobn koiles gemacht in hoiz fun Hashem,</para>
  <para style="q" vid="LAM 2:7">azoi vi in a yom-tov.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8" />Hashem hot getracht tsu tseshtern</para>
  <para style="q" vid="LAM 2:8">di moier fun tochter Tsiyon;</para>
  <para style="q" vid="LAM 2:8">er hot getsoign a mestshnur,</para>
  <para style="q" vid="LAM 2:8">er hot nisht opgehaltn zain hant fun umtsubrengen,</para>
  <para style="q" vid="LAM 2:8">un gemacht troiern di festung un di moier;</para>
  <para style="q" vid="LAM 2:8">in einem zainen zei farshnitn gevorn.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9" />aingezunken in der erd zainen ire toiern,</para>
  <para style="q" vid="LAM 2:9">er hot tseshtert un tsebrochn ire riglen;</para>
  <para style="q" vid="LAM 2:9">ir melech un ire harn zainen tsvishn di felker,</para>
  <para style="q" vid="LAM 2:9">nishto mer kein toyre;</para>
  <para style="q" vid="LAM 2:9">afile ire neviim gefinen nisht a zeung fun Hashem.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10" />zei zitsn oif der erd un shvaign,</para>
  <para style="q" vid="LAM 2:10">di eltste fun tochter Tsiyon,</para>
  <para style="q" vid="LAM 2:10">zei hobn aroifgeton shtoib oif zeyer kop,</para>
  <para style="q" vid="LAM 2:10">zei hobn ongegurt zak;</para>
  <para style="q" vid="LAM 2:10">aropgelozt zeyere kep tsu der erd</para>
  <para style="q" vid="LAM 2:10">hobn di yungfroin fun Yerushalayim.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11" />maine oign geyen ois fun trern,</para>
  <para style="q" vid="LAM 2:11">maine ingeveid brenen,</para>
  <para style="q" vid="LAM 2:11">main leber iz oisgegosen oif der erd,</para>
  <para style="q" vid="LAM 2:11">oif dem broch fun der tochter main folk;</para>
  <para style="q" vid="LAM 2:11">vail kleine kinder un zoigedike</para>
  <para style="q" vid="LAM 2:11">chaleshn in di gasn fun shtot.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12" />zei zogn tsu zeyere muters:</para>
  <para style="q" vid="LAM 2:12">vu iz korn un vain?</para>
  <para style="q" vid="LAM 2:12">ven zei chaleshn vi dershlogene</para>
  <para style="q" vid="LAM 2:12">in di gasn fun shtot,</para>
  <para style="q" vid="LAM 2:12">ven zeyer zel gist zich ois</para>
  <para style="q" vid="LAM 2:12">oif der brust fun zeyere muters.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13" />vos zol ich dir edutn?</para>
  <para style="q" vid="LAM 2:13">vos zol ich tsu dir glaichn, tochter Yerushalayim?</para>
  <para style="q" vid="LAM 2:13">vos zol ich farglaichn tsu dir, un dich treistn,</para>
  <para style="q" vid="LAM 2:13">yungfroi tochter Tsiyon?</para>
  <para style="q" vid="LAM 2:13">az grois vi der yam iz dain broch –</para>
  <para style="q" vid="LAM 2:13">ver ken dich heiln?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14" />daine neviim hobn dir gezen</para>
  <para style="q" vid="LAM 2:14">falshkeit un opnarenish,</para>
  <para style="q" vid="LAM 2:14">un zei hobn nisht antplekt dain zind,</para>
  <para style="q" vid="LAM 2:14">umtsukeren dain gefangenshaft;</para>
  <para style="q" vid="LAM 2:14">un zei hobn dir gezen nevues</para>
  <para style="q" vid="LAM 2:14">fun falshkeit un farfirenishn.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15" />ale farbaigeyer patshn oif dir mit di hent,</para>
  <para style="q" vid="LAM 2:15">zei shmutsern, un shoklen zeyer kop oif tochter Yerushalayim:</para>
  <para style="q" vid="LAM 2:15">iz dos di shtot vos me hot gerufn</para>
  <para style="q" vid="LAM 2:15">di kroin fun sheinkeit,</para>
  <para style="q" vid="LAM 2:15">di freid fun der gantser erd?<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16" />geefent zeyer moil oif dir hobn ale daine sonem;</para>
  <para style="q" vid="LAM 2:16">zei shmutsern, un kritsn di tsein;</para>
  <para style="q" vid="LAM 2:16">zei zogn: mir hobn zi aingeshlungen;</para>
  <para style="q" vid="LAM 2:16">far vor, dos iz der tog vos mir hobn gehoft oif im,</para>
  <para style="q" vid="LAM 2:16">mir hobn dergreicht, mir hobn derlebt.<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17" />Hashem hot geton vos er hot getracht,</para>
  <para style="q" vid="LAM 2:17">er hot oisgefirt zain vort</para>
  <para style="q" vid="LAM 2:17">vos er hot ongezogt fun amolike teg;</para>
  <para style="q" vid="LAM 2:17">er hot tseshtert on rachmones,</para>
  <para style="q" vid="LAM 2:17">un derfreit dem soine iber dir,</para>
  <para style="q" vid="LAM 2:17">derheicht dem horn fun daine faint.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18" />zeyer harts hot geshrien tsu Adonoi:</para>
  <para style="q" vid="LAM 2:18">moier fun tochter Tsiyon,</para>
  <para style="q" vid="LAM 2:18">loz rinen trern vi a taich, tog un nacht;</para>
  <para style="q" vid="LAM 2:18">zolst zich nisht gebn kein opru,</para>
  <para style="q" vid="LAM 2:18">nisht shtiln zol zich dain oigapl.<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19" />shtei oif, shrai in der nacht,</para>
  <para style="q" vid="LAM 2:19">in onheib fun di nachtvachn;</para>
  <para style="q" vid="LAM 2:19">gis ois vi vaser dain harts,</para>
  <para style="q" vid="LAM 2:19">far dem ponem fun Adonoi;</para>
  <para style="q" vid="LAM 2:19">heib oif daine hent tsu im,</para>
  <para style="q" vid="LAM 2:19">far di nefoshes fun daine kleine kinder</para>
  <para style="q" vid="LAM 2:19">vos chaleshn fun hunger in ale ek gasn.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20" />ze, Hashem, un kuk</para>
  <para style="q" vid="LAM 2:20">vemen du host azoins geton!</para>
  <para style="q" vid="LAM 2:20">darfn vaiber esen zeyer frucht,</para>
  <para style="q" vid="LAM 2:20">kinder getsertlte?</para>
  <para style="q" vid="LAM 2:20">darf geteit vern in heiliktum fun Adonoi</para>
  <para style="q" vid="LAM 2:20">der koyen un der novi?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21" />oif der erd in di gasn</para>
  <para style="q" vid="LAM 2:21">lign alt un yung;</para>
  <para style="q" vid="LAM 2:21">maine meidlech un maine bochurim</para>
  <para style="q" vid="LAM 2:21">zainen gefaln fun shverd;</para>
  <para style="q" vid="LAM 2:21">host geharget in tog fun dain tsorn,</para>
  <para style="q" vid="LAM 2:21">geshochtn on rachmones.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22" />host gerufn vi oif a yom-tov</para>
  <para style="q" vid="LAM 2:22">maine shrekenishn fun arum;</para>
  <para style="q" vid="LAM 2:22">un nisht geven in tog fun Hashems tsorn</para>
  <para style="q" vid="LAM 2:22">kein antrunener un geblibener;</para>
  <para style="q" vid="LAM 2:22">di vos ich hob getsertlt un oifgebracht</para>
  <para style="q" vid="LAM 2:22">zei hot main soine farlendt.<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="LAM 3" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 3:1" />ich bin der man vos hot ongezen pain</para>
  <para style="q" vid="LAM 3:1">durch der rut fun zain tsorn.<verse eid="LAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2" />er hot mich gefirt un gemacht gein</para>
  <para style="q" vid="LAM 3:2">in fintsternish un nisht lichtikeit.<verse eid="LAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3" />far vor, kegen mir vider un vider</para>
  <para style="q" vid="LAM 3:3">kert er zain hant a gantsn tog.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4" />er hot opgetsert main fleish un main hoit,</para>
  <para style="q" vid="LAM 3:4">er hot tsebrochn maine beiner.<verse eid="LAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5" />er hot mich baboit, un arumgeringlt</para>
  <para style="q" vid="LAM 3:5">mit gift un mit maternish.<verse eid="LAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6" />er hot mich araingezetst in choishechnishn,</para>
  <para style="q" vid="LAM 3:6">vi meisim fun lang on.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7" />er hot mich fartsamt, az ich ken nisht aroisgein,</para>
  <para style="q" vid="LAM 3:7">er hot shver gemacht main keit.<verse eid="LAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8" />afile ven ich shrai un ruf,</para>
  <para style="q" vid="LAM 3:8">farshpart er main tfile.<verse eid="LAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9" />er hot fartsamt maine vegen mit shteiner,</para>
  <para style="q" vid="LAM 3:9">er hot maine shtegn farkrimt.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10" />a loierdiker Beor iz er mir,</para>
  <para style="q" vid="LAM 3:10">a leib in farborgenish.<verse eid="LAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11" />er hot opgekert maine vegen, un mich tserisn,</para>
  <para style="q" vid="LAM 3:11">vist hot er mich gemacht.<verse eid="LAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12" />er hot geshpant zain boign,</para>
  <para style="q" vid="LAM 3:12">un mich geshtelt far a tsil tsu der fail.<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13" />er hot araingelozt in maine nirn,</para>
  <para style="q" vid="LAM 3:13">di zin fun zain failbaitl.<verse eid="LAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14" />ich bin gevorn a gelechter bai main gantsn folk,</para>
  <para style="q" vid="LAM 3:14">zeyer shpotlid a gantsn tog.<verse eid="LAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15" />er hot mich ongezet mit biternishn,</para>
  <para style="q" vid="LAM 3:15">mich gezetikt mit vermut.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16" />un er hot tsebrochn mit shteindlech maine tsein,</para>
  <para style="q" vid="LAM 3:16">er hot mich gevelgert in ash.<verse eid="LAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17" />un main zel iz farshtoisen fun frid,</para>
  <para style="q" vid="LAM 3:17">ich hob fargesen on guts.<verse eid="LAM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18" />un ich zog: farlorn iz main shtarkeit,</para>
  <para style="q" vid="LAM 3:18">un main hofenung fun Hashem.<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19" />di dermonung fun main pain un main voglenish,</para>
  <para style="q" vid="LAM 3:19">iz vermut un biterkroit.<verse eid="LAM 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20" />dermonen dermont zich main zel,</para>
  <para style="q" vid="LAM 3:20">un zi beigt zich in mir.<verse eid="LAM 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21" />dos entfer ich tsu main hartsn,</para>
  <para style="q" vid="LAM 3:21">derum tu ich harn:<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22" />az di chasadim fun Hashem zainen nisht oisgegangen,</para>
  <para style="q" vid="LAM 3:22">az nisht geendikt hot zich zain rachmones;<verse eid="LAM 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23" />zei zainen nai ale frimorgn;</para>
  <para style="q" vid="LAM 3:23">grois iz dain traishaft.<verse eid="LAM 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24" />Hashem iz main chelek, zogt main zel,</para>
  <para style="q" vid="LAM 3:24">derum hof ich tsu im.<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25" />gut iz Hashem tsu di vos harn oif im,</para>
  <para style="q" vid="LAM 3:25">tsu der zel vos tut im zuchn.<verse eid="LAM 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26" />gut iz me zol harn a farshvigener</para>
  <para style="q" vid="LAM 3:26">oif der yeshue fun Hashem.<verse eid="LAM 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27" />gut iz far a mentshn,</para>
  <para style="q" vid="LAM 3:27">az er zol trogn dem yoch in zain yugnt;<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28" />er zol zitsn alein un shvaign,</para>
  <para style="q" vid="LAM 3:28">ven me hot aroifgeleigt oif im;<verse eid="LAM 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29" />er zol leign in ash zain moil,</para>
  <para style="q" vid="LAM 3:29">efsher iz a hofenung faran;<verse eid="LAM 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30" />er zol gebn di bak tsu zain shleger,</para>
  <para style="q" vid="LAM 3:30">er zol zich zetn mit shand.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31" />vorem nisht oif eibik farlozt Adonoi;<verse eid="LAM 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32" />vorem oib er hot farumert,</para>
  <para style="q" vid="LAM 3:32">derbaremt er ober loit zaine groise chasadim.<verse eid="LAM 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33" />vorem nisht fun zain hartsn painikt er,</para>
  <para style="q" vid="LAM 3:33">un farumert di mentshnkinder.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34" />tsu drikn unter zaine fis</para>
  <para style="q" vid="LAM 3:34">ale gefangene fun der erd,<verse eid="LAM 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35" />tsu farbeign dem mishpot fun a man,</para>
  <para style="q" vid="LAM 3:35">iz dervider dem ponem fun dem Elyon;<verse eid="LAM 3:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36" />tsu krivden a mentshn in zain krig,</para>
  <para style="q" vid="LAM 3:36">dos vil Adonoi nisht zen.<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37" />ver iz der vos ken heisn, un es zol geshen,</para>
  <para style="q" vid="LAM 3:37">az Adonoi hot nisht bafoiln?<verse eid="LAM 3:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38" />kumt nisht fun oibershters moil arois</para>
  <para style="q" vid="LAM 3:38">dos shlechts un dos guts?<verse eid="LAM 3:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39" />vos ken zich baklogn a lebediker mentsh?</para>
  <para style="q" vid="LAM 3:39">a man bai ale zaine zind?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40" />lomir nochzuchn un forshn undzere vegen,</para>
  <para style="q" vid="LAM 3:40">un lomir zich umkeren tsu Hashem.<verse eid="LAM 3:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41" />lomir oifheibn undzer harts oif di hent</para>
  <para style="q" vid="LAM 3:41">tsu El in himel.<verse eid="LAM 3:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42" />mir hobn farbrochn un vidershpenikt;</para>
  <para style="q" vid="LAM 3:42">vilst du nisht fargebn?<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43" />host zich badekt mit tsorn, un undz nochgeyogt,</para>
  <para style="q" vid="LAM 3:43">host geharget on rachmones;<verse eid="LAM 3:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44" />host zich badekt mit a volken,</para>
  <para style="q" vid="LAM 3:44">az kein tfile zol nisht durchgein.<verse eid="LAM 3:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45" />koit un mist hostu undz gemacht</para>
  <para style="q" vid="LAM 3:45">tsvishn di felker.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46" />geefent hobn zeyer moil oif undz</para>
  <para style="q" vid="LAM 3:46">ale undzere sonem.<verse eid="LAM 3:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47" />a groil un a grub iz gekumen oif undz,</para>
  <para style="q" vid="LAM 3:47">a farvistung un a broch.<verse eid="LAM 3:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48" />bechn vaser tut rinen main oig</para>
  <para style="q" vid="LAM 3:48">oif dem broch fun der tochter main folk.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49" />main oig gist, un vil zich nisht shtiln,</para>
  <para style="q" vid="LAM 3:49">on an oifher,<verse eid="LAM 3:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50" />biz Hashem fun himel vet lugn un zen.<verse eid="LAM 3:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51" />main oig tut vei main zel,</para>
  <para style="q" vid="LAM 3:51">um ale techter fun main shtot.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52" />yogn vi a foigel hobn mich geyogt</para>
  <para style="q" vid="LAM 3:52">maine umzistike sonem.<verse eid="LAM 3:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53" />zei hobn farshnitn in grub main lebn,</para>
  <para style="q" vid="LAM 3:53">un shteiner hobn zei gevorfn oif mir.<verse eid="LAM 3:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54" />vasern hobn gefleitst oif main kop,</para>
  <para style="q" vid="LAM 3:54">ich hob gezogt: ich bin opgeshnitn.<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55" />ich hob gerufn dain nomen, Hashem,</para>
  <para style="q" vid="LAM 3:55">fun der untershter grub.<verse eid="LAM 3:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56" />host gehert main kol,</para>
  <para style="q" vid="LAM 3:56">zolstu nisht farhoiln dain oier fun main zifts,</para>
  <para style="q" vid="LAM 3:56">fun main geshrei.<verse eid="LAM 3:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57" />host genent in tog vos ich fleg dich rufn,</para>
  <para style="q" vid="LAM 3:57">host gezogt: zolst nisht moire hobn.<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58" />host zich ongenumen, Adonoi, di krig fun main zel,</para>
  <para style="q" vid="LAM 3:58">host oisgeleizt main lebn.<verse eid="LAM 3:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59" />host gezen, Hashem, main krivde,</para>
  <para style="q" vid="LAM 3:59">mishpot main mishpot.<verse eid="LAM 3:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60" />host gezen zeyer gantse nekome,</para>
  <para style="q" vid="LAM 3:60">ale zeyere machshoves oif mir.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61" />host gehert zeyer lesterung, Hashem,</para>
  <para style="q" vid="LAM 3:61">ale zeyere machshoves akegn mir;<verse eid="LAM 3:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62" />di lipn fun maine faint</para>
  <para style="q" vid="LAM 3:62">un zeyer trachtn akegn mir a gantsn tog.<verse eid="LAM 3:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63" />ze zeyer zitsn un zeyer shtein –</para>
  <para style="q" vid="LAM 3:63">ich bin zeyer shpotlid.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64" />zolst zei umkeren, Hashem, a fargeltung</para>
  <para style="q" vid="LAM 3:64">loit di meisim fun zeyere hent.<verse eid="LAM 3:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65" />zolst zei gebn hartsdulenish, dain klole oif zei!<verse eid="LAM 3:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66" />zolst zei yogn mit tsorn,</para>
  <para style="q" vid="LAM 3:66">un zei fartiliken fun unter di himlen fun Hashem.<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="LAM 4" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1" />vi iz fartunklt dos gold,</para>
  <para style="q" vid="LAM 4:1">farbaiten dos taiere faingold;</para>
  <para style="q" vid="LAM 4:1">di heilike shteiner tseshotn in ale ek gasn!<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2" />di taiere kinder fun Tsiyon,</para>
  <para style="q" vid="LAM 4:2">mit gingold gevoign –</para>
  <para style="q" vid="LAM 4:2">vi zainen zei gerechnt far leimene krig,</para>
  <para style="q" vid="LAM 4:2">gemacht fun a tepers hent!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3" />afile shakaln tsien ois di brust,</para>
  <para style="q" vid="LAM 4:3">gibn zoign zeyere yunge,</para>
  <para style="q" vid="LAM 4:3">di tochter main folk iz an achzer gevorn,</para>
  <para style="q" vid="LAM 4:3">azoi vi shtroisfoiglen in der midber.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4" />di tsung fun dem zoigedikn iz tsugeklept</para>
  <para style="q" vid="LAM 4:4">tsu zain gumen fun dorshtikeit;</para>
  <para style="q" vid="LAM 4:4">kleine kinder betn broit,</para>
  <para style="q" vid="LAM 4:4">un keiner brecht zei nisht op.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5" />di vos flegn esen taiere shpaizn,</para>
  <para style="q" vid="LAM 4:5">zainen vist in di gasn;</para>
  <para style="q" vid="LAM 4:5">di dertsoigene in vermilroit</para>
  <para style="q" vid="LAM 4:5">tulien zich tsu misthoifns.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6" />vorem di zind fun der tochter main folk</para>
  <para style="q" vid="LAM 4:6">iz greser vi der chet fun Sodom,</para>
  <para style="q" vid="LAM 4:6">vos iz ibergekert gevorn vi in a rege,</para>
  <para style="q" vid="LAM 4:6">un kein hent zenen nisht gefaln oif ir.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7" />ire firshtn zainen geven loiterer fun shnei,</para>
  <para style="q" vid="LAM 4:7">vaiser fun milch,</para>
  <para style="q" vid="LAM 4:7">geroitlter oifn laib fun kareln;</para>
  <para style="q" vid="LAM 4:7">sapirshtein zeyer geshtalt.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8" />fintsterer fun koil iz zeyer oiszen,</para>
  <para style="q" vid="LAM 4:8">zei zainen nisht tsu derkenen oif der gas;</para>
  <para style="q" vid="LAM 4:8">zeyer hoit iz tsugeklept tsu zeyere beiner,</para>
  <para style="q" vid="LAM 4:8">aingedart vi holts iz zi gevorn.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9" />beser iz di dershlogene fun shverd,</para>
  <para style="q" vid="LAM 4:9">vi di dershlogene fun hunger,</para>
  <para style="q" vid="LAM 4:9">vos zei geyen ois durchgenumene,</para>
  <para style="q" vid="LAM 4:9">on a frucht fun feld.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10" />di hent fun derbaremdike muters</para>
  <para style="q" vid="LAM 4:10">hobn gekocht zeyere kinder;</para>
  <para style="q" vid="LAM 4:10">zei zainen zei tsum shpaiz geven,</para>
  <para style="q" vid="LAM 4:10">in dem broch fun der tochter main folk.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11" />Hashem hot oisgelozt zain kaas,</para>
  <para style="q" vid="LAM 4:11">oisgegosen zain grimtsorn;</para>
  <para style="q" vid="LAM 4:11">un er hot ongetsundn a faier in Tsiyon,</para>
  <para style="q" vid="LAM 4:11">un es hot fartsert ire gruntfestn.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12" />nisht gegloibt hobn di mlochim fun der erd,</para>
  <para style="q" vid="LAM 4:12">un ale bavoiner fun der velt,</para>
  <para style="q" vid="LAM 4:12">az a driker un a soine vet kumen</para>
  <para style="q" vid="LAM 4:12">in di toiern fun Yerushalayim;<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13" />fun vegen di zind fun ire neviim,</para>
  <para style="q" vid="LAM 4:13">di farbrechn fun ire koyanim,</para>
  <para style="q" vid="LAM 4:13">vos hobn blut fun gerechte</para>
  <para style="q" vid="LAM 4:13">fargosen in ir.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14" />zei voglen vi blinde in di gasn,</para>
  <para style="q" vid="LAM 4:14">zei zainen aingericht in blut,</para>
  <para style="q" vid="LAM 4:14">biz me ken zich nisht onrirn on di kleider zeyere.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15" />kert aich op! tome!</para>
  <para style="q" vid="LAM 4:15">ruft men tsu zei,</para>
  <para style="q" vid="LAM 4:15">kert aich op! kert aich op! ir zolt zich nisht onrirn!</para>
  <para style="q" vid="LAM 4:15">beeis zei flien un voglen; me zogt tsvishn di felker:</para>
  <para style="q" vid="LAM 4:15">zei torn zich mer nisht oifhaltn.<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16" />der tsorn fun Hashem hot zei tseteilt,</para>
  <para style="q" vid="LAM 4:16">er vil zei mer nisht onkukn;</para>
  <para style="q" vid="LAM 4:16">koyanim hot men nisht geshoint,</para>
  <para style="q" vid="LAM 4:16">zkeinim hot men nisht gelaitzelikt.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17" />undzere oign geyen noch alts ois</para>
  <para style="q" vid="LAM 4:17">noch undzer nishtiker hilf;</para>
  <para style="q" vid="LAM 4:17">in undzer oiskuk hobn mir oisgekukt</para>
  <para style="q" vid="LAM 4:17">oif a folk vos ken nisht helfn.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18" />me shpirt noch undzere trit,</para>
  <para style="q" vid="LAM 4:18">az mir kenen nisht gein oif undzere gasn;</para>
  <para style="q" vid="LAM 4:18">nont iz undzer sof, ful zainen undzere teg;</para>
  <para style="q" vid="LAM 4:18">yo, gekumen iz undzer sof.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19" />flinker zainen undzere nochyoger</para>
  <para style="q" vid="LAM 4:19">vi di odlers fun himel;</para>
  <para style="q" vid="LAM 4:19">oif di berg hobn zei undz geyogt,</para>
  <para style="q" vid="LAM 4:19">in midber hobn zei geloyert oif undz.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20" />der otem fun undzer noz, der gezalbter fun Hashem,</para>
  <para style="q" vid="LAM 4:20">iz gefangen gevorn in zeyere griber;</para>
  <para style="q" vid="LAM 4:20">der, vos mir hobn gezogt: in zain shotn</para>
  <para style="q" vid="LAM 4:20">veln mir lebn tsvishn di felker.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21" />kvel on un frei zich, tochter Edom,</para>
  <para style="q" vid="LAM 4:21">du vos voinst in land Uts;</para>
  <para style="q" vid="LAM 4:21">tsu dir oich vet ariber der kos,</para>
  <para style="q" vid="LAM 4:21">vest shikur vern, un zich opdekn.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22" />geendikt iz dain zind, tochter Tsiyon,</para>
  <para style="q" vid="LAM 4:22">er vet dich mer nisht fartraiben;</para>
  <para style="q" vid="LAM 4:22">er vet dermonen dain farbrech, tochter Edom,</para>
  <para style="q" vid="LAM 4:22">er vet antplekn daine zind.<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="LAM 5" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1" />gedenk, Hashem, vos iz geshen tsu undz,</para>
  <para style="q" vid="LAM 5:1">kuk un ze undzer shand.<verse eid="LAM 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2" />undzer nachle iz ibergegangen tsu fremde,</para>
  <para style="q" vid="LAM 5:2">undzere haizer tsu andere.<verse eid="LAM 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3" />mir zainen yesoimim gevorn on a foter,</para>
  <para style="q" vid="LAM 5:3">undzere muters vi almones.<verse eid="LAM 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4" />undzer vaser trinken mir far gelt,</para>
  <para style="q" vid="LAM 5:4">undzer holts kumt undz on far getsolt.<verse eid="LAM 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5" />oif undzer nakn vern mir geyogt,</para>
  <para style="q" vid="LAM 5:5">mir zainen mid, un undz vert nisht barut.<verse eid="LAM 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6" />tsu Mitsrayim hobn mir a hant oisgeshtrekt,</para>
  <para style="q" vid="LAM 5:6">tsu Ashur – zich mit broit tsu zetn.<verse eid="LAM 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7" />undzere eltern hobn gezindikt, un zainen mer nishto,</para>
  <para style="q" vid="LAM 5:7">un mir trogn zeyere farbrechn.<verse eid="LAM 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8" />knecht geveltikn iber undz,</para>
  <para style="q" vid="LAM 5:8">nishto kein oisleizer fun zeyer hant.<verse eid="LAM 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9" />mit undzer lebn krign mir undzer broit,</para>
  <para style="q" vid="LAM 5:9">fun vegen der shverd fun midber.<verse eid="LAM 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10" />undzer hoit glit vi an oivn,</para>
  <para style="q" vid="LAM 5:10">fun vegen di brenungen fun hunger.<verse eid="LAM 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11" />vaiber hot men gepainikt in Tsiyon,</para>
  <para style="q" vid="LAM 5:11">yungfroin in di shtet fun Yehudah.<verse eid="LAM 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12" />harn zainen gehongen gevorn fun zeyer hant;</para>
  <para style="q" vid="LAM 5:12">penemer fun zkeinim zainen nisht geshoint gevorn.<verse eid="LAM 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13" />yungelait hobn milshteiner getrogn,</para>
  <para style="q" vid="LAM 5:13">un yinglech hobn unter holts geshtroichlt.<verse eid="LAM 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14" />zkeinim hobn fun toier oifgehert,</para>
  <para style="q" vid="LAM 5:14">yungelait fun zeyer gezang.<verse eid="LAM 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15" />oifgehert hot di freid fun undzer hartsn,</para>
  <para style="q" vid="LAM 5:15">farkert iz in troier undzer tants.<verse eid="LAM 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16" />gefaln iz di kroin fun undzer kop;</para>
  <para style="q" vid="LAM 5:16">vei undz! vorem mir hobn gezindikt.<verse eid="LAM 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17" />derfar iz krank undzer harts,</para>
  <para style="q" vid="LAM 5:17">iber dem zainen fintster undzere oign:<verse eid="LAM 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18" />iber dem barg Tsiyon vos iz vist –</para>
  <para style="q" vid="LAM 5:18">fiks geyen um oif im.<verse eid="LAM 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19" />du, Hashem, tronst eibik,</para>
  <para style="q" vid="LAM 5:19">dain tron iz oif dor-doires,<verse eid="LAM 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20" />far vos fargestu undz oif shtendik,</para>
  <para style="q" vid="LAM 5:20">farlozt undz oif lange teg?<verse eid="LAM 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21" />ker undz um tsu dir, Hashem,</para>
  <para style="q" vid="LAM 5:21">un lomir zich umkeren;</para>
  <para style="q" vid="LAM 5:21">banai undzere teg vi amol;<verse eid="LAM 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22" />vorem oib farachten hostu undz faracht,</para>
  <para style="q" vid="LAM 5:22">hostu ober getsernt oif undz biz gor.<verse eid="LAM 5:22" /></para>
  <para style="b" />
  <chapter eid="LAM 5" />
</usx>