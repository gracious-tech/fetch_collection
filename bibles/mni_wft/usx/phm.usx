<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">Meitei: Roman Script 1st Translation</book>
  <para style="ide">Unicode (UTF8)</para>
  <para style="h">Philemon</para>
  <para style="toc1">PHILEMON-DA I-ba Paul-gi Chithi</para>
  <para style="toc2">Philemon</para>
  <para style="toc3">Phile</para>
  <para style="mt1">PHILEMON-DA</para>
  <para style="mt2">I-ba Paul-gi Chithi</para>
  <para style="imt1">Wahoudok</para>
  <para style="ip">Philemon hairiba atenba lairik asi Pakhonchatpa Paul-na ibani (1:1). Paul-na keisumsangda leiringeida chithi asi i-bani, masina chithi asi mahakna Rome-dagi iramba yai haiba tak-i. Mahakna Rome-da leiramba tarabadi chithi asi Christtana poklaba matung chahi 61 mukki aduwaida oigani aduga matam adumaktada Colossiya-su i-ba oigani.</para>
  <para style="ip">Mahakna chithi asi Philemon kouba nupa amada i-bani. Philemon asi Colossae singlupki mi amani aduga mahak minai thamduna minaigi mapu oiba mi amasuni. Philemon-dagi chenthokluraba mahakki minai Onesimus-pu cheirak pibidanaba Paul-na Philemon-da i-ba chithini. Matam adugi Rome-gi wayel pathapki matung innadi Philemon-na Onesimus-pu sibagi cheirak piba yai. Paul-na phajaba maram kaya piduna Onesimus-pu Christian machin manao ama oina lousinnaba pukning thougatli aduga Onesimus-pu Paul-ga loina thougal touminnanaba ayaba pinabagi wa phaoba houdok-i (1:13-14).</para>
  <para style="iot">Yaopham Takpa</para>
  <para style="io1">1. Paul-na Philemon-bu khurumbagi warol haiba <char style="ior">(<ref loc="PHM 1:1-3">1:1-3</ref>)</char></para>
  <para style="io1">2. Onesimus-pu Philemon-na Christian machin manao ama oina lousinbinaba Paul-na haiba <char style="ior">(<ref loc="PHM 1:4-21">1:4-21</ref>)</char></para>
  <para style="io1">3. Paul-na unaba lakningbagi apamba adu khanghanba amadi khurumbagi wahei hairaga chithi adu loisilli <char style="ior">(<ref loc="PHM 1:22-25">1:22-25</ref>)</char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>Jisu Christtagi maramgidamak phadok oiriba Paul amadi eikhoigi ichil inao Timothy-na,</para>
  <para style="p" vid="PHM 1:1">eikhoigi achanba marup oiriba amasung eikhoiga thougal touminnariba philemon <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/><note caller="-" style="x"><char style="xo" closed="false">2 </char><char style="xt" closed="false"><ref loc="COL 4:17">Col 4:17</ref></char></note>amadi nahakki yumda tinnaba singlupki mising amasung eikhoigi ichan Apphia aduga eikhoiga lanmi oiminnaba Archippus-ki maphamda:<verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>Eikhoigi Ipa Ibungo Tengban Mapu amasung Mapu Ibungo Jisu Christtana nakhoida thoujal amadi ingthaba pibiba oirasanu.<verse eid="PHM 1:3"/></para>
  <para style="s1">Philemon-gi nungsiba amadi thajaba</para>
  <para style="p">
    <verse number="4-5" style="v" sid="PHM 1:4-5"/>Nahakna Tengban Mapugi mi pumnamakpu nungsijaba amadi Mapu Ibungo Jisugi maphamda leijaba nahakki thajaba adugi wa adu eina tabada eigi haijaba khudingmakta nahakpu ningsingduna eigi Tengban Mapubu tattana thagatchei. <verse eid="PHM 1:4-5"/><verse number="6" style="v" sid="PHM 1:6"/>Thajaba ama oina eikhoina nahakka tinnajaba asina Christta-ga loinajabana eikhoigi punsida phangba yaiphaba khudingmak adu henna ningthijana khangba adu pubiraknaba eina Tengban Mapugi maphamda haijei. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>Nahakki nungsibana eingonda yamna haraoba amadi yamna thougatpiba pubirak-i! Aduga Tengban Mapugi mi pumnamakki thamoida nahakna haraoba pubirakle.<verse eid="PHM 1:7"/></para>
  <para style="s1">Onesimus-kidamak Paul-na nolukna haijaba</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>Maram asina Christtada ichil inao ama oina eina thouna phana nangonda nahakna tougadaba adu tounanaba yathang pirambasu yabani, <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>adubu ahal oiraba aduga houjikna Christta Jisugidamak phadok amasu oiriba Paul eihakna nungsibagi maramna nangonda nonjabani. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/><note caller="-" style="x"><char style="xo" closed="false">10 </char><char style="xt" closed="false"><ref loc="COL 4:9">Col 4:9</ref></char></note>Christtada ichanupa oiraba Onesimus-kidamak eina nangonda nolukna haijari: keisumsangda leina leina eihak mahakki thawaigi mapa oirakpani. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>Matam amadadi mahak asi nangonda karisu kanadaba ama oirambani, adubu houjikti nahakkidamak amadi eigidamaksu kanaba oire.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>Eigi thawaigumna khanjariba mahak asibu nangonda amuk halhankhibani. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>Aphaba paogi maramgidamak eina phadok oiringei manung asida nahakki mahut sinduna eibu mateng pangbinaba mahakpu mapham asida eiga loinana thamba pambani. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>Adubu eina nahakki ayaba yaodana kari amata touba pamde, nahakki pangbiba adu tangaiphadana toubagum nattaduna, touningna touba adu eina pamjei.<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>Matam khara mahak nangondagi khainaramba asi nahakna mahakpu matam pumbagi oina phangjaba yananaba oiramba yai. <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>Houjikti mahak a-reiba minaigumna nattaduna, madudagi yamna henba haibadi Christtada achanba ichil inao oire. Mahak asi eigidamak achanba ama oire adubu nahakkidamakti mioiba masel ama oina amadi Mapu Ibungogi maphamda ichil inao ama oina henna achanba ama oire!<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>Maram aduna eibu nahakki napang ama oina singthabirabadi, eihak isamak lousinbagumna mahakpu lousinbiyu. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>Mahakna nahakki maphamda lankhiba nattraga karigumba tonkhiba leirabadi eina singnanaba eigi ithakta thambiyu. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>Masi Paul eihakna ikhutmakna ijabani: madu eina nangonda han-gani; adubu nahak nasamak eingonda laman oina tolli haibasi eina nangonda haidrabani. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>Maram aduna, ichil inao, Mapu Ibungogi maramgidamak chanbiba thabak asi eigidamak toubiyu; Christtada ichil inao ama oina eigi pukning nungaihanbiyu.<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>Eina haiba nahakna in-gani haiba thajaduna nangonda chithi asi i-bani, eina haiba asidagi henna nahakna tougani haiba eina khang-i <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>Aduga amakhaksu haijari madudi nakhoigi haijabasing adugi paokhum phangduna eibu nakhoigi naphamda halhanbigani haibagi asa eingonda leibagi maramna eina thungnanaba ka ama thourang toubirammu.<verse eid="PHM 1:22"/></para>
  <para style="s1">Aroiba khurumjabagi warol</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">23 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">Col 1:7</ref>; <ref loc="COL 4:12">4:12</ref></char>
    </note>Epaphras, Christta Jisugi maramgidamak eiga phadok taminnariba mahakna nakhoibu khurumjabagi warol haijarakli. <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/><note caller="-" style="x"><char style="xo" closed="false">24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">Pakhon 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">Col 4:10</ref>; <ref loc="ACT 19:29">Pakhon 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">Col 4:10</ref>; <ref loc="COL 4:14">Col 4:14</ref>; <ref loc="2TI 4:10">2 Tim 4:10</ref>; <ref loc="COL 4:14">Col 4:14</ref>; <ref loc="2TI 4:11">2 Tim 4:11</ref></char></note>Aduga eiga thougal touminnariba Mark, Aristarchus, Demas amasung Luke-nasu nakhoibu khurumjabagi warol hajarakli.<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>Mapu Ibungo Jisu Christtagi thoujal nakhoi pumnamakki maphamda leiba oirasanu.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
