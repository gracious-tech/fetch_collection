  <para style="m">
    <verse number="10" style="v" sid="EZR 2:10" />Banis söner: 642<verse eid="EZR 2:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="EZR 2:11" />Bevajs söner: 623<verse eid="EZR 2:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="EZR 2:12" />Azeggads söner: 1 222<verse eid="EZR 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="EZR 2:13" />Adonikams söner: 666<verse eid="EZR 2:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="EZR 2:14" />Bigvajs söner: 2 056<verse eid="EZR 2:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="EZR 2:15" />Adins söner: 454<verse eid="EZR 2:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="EZR 2:16" />Aters söner från Hiskia <char style="add">(hebr. Jechizqijah)</char>: 98<verse eid="EZR 2:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="EZR 2:17" />Betsajs söner: 323<verse eid="EZR 2:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="EZR 2:18" />Joras söner: 112<verse eid="EZR 2:18" /></para>
  <para style="m">
