  <para style="m">
    <verse number="20" style="v" sid="EZR 2:20" />Gibbars söner: 95<verse eid="EZR 2:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="EZR 2:21" />
    <char style="add">[Från geografiska platser:]</char></para>
  <para style="b" vid="EZR 2:21" />
  <para style="m" vid="EZR 2:21">Betlehems söner: 123<verse eid="EZR 2:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="EZR 2:22" />Netofas folk: 56<verse eid="EZR 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="EZR 2:23" />Anatots folk: 128<verse eid="EZR 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="EZR 2:24" />Azmavets söner: 42<verse eid="EZR 2:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="EZR 2:25" />Kirjat Arims, Kefiras och Beerots söner: 743<verse eid="EZR 2:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="EZR 2:26" />Ramas och Gevas söner: 621<verse eid="EZR 2:26" /></para>
  <para style="m">
