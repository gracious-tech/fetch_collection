\v 1 \w Cuando|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w vivía|strong="H3427"\w* \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w casa|strong="H1004"\w*, \w y|strong="H3588"\w* Yahvé le \w había|strong="H1961"\w* dado descanso \w de|strong="H3588"\w* \w todos|strong="H3605"\w* sus enemigos \w alrededor|strong="H5439"\w*,  
