\id SNG
\ide  UTF-8
\h CANTARES 
\toc3 Cantares 
\toc1 CANTAR DE LOS CANTARES DE SALOMÓN 
\toc2 CANTARES 
\mt1 Cantar de los cantares  
\mt2 de Salomón  
\c 1
\p
\v 1 El Cantar de los Cantares, que es de \w Salomón|strong="H8010"\w*.   
\sp Amado  
\q1
\v 2 \w Que|strong="H3588"\w* \w me|strong="H3588"\w* bese \w con|strong="H3588"\w* \w los|strong="H3588"\w* besos \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w boca|strong="H6310"\w*;  
\q2 \w porque|strong="H3588"\w* tu amor \w es|strong="H3588"\w* \w mejor|strong="H2896"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w vino|strong="H3196"\w*.   
\q1
\v 3 Sus aceites tienen una fragancia agradable.  
\q2 Tu \w nombre|strong="H8034"\w* es \w aceite|strong="H8081"\w* \w derramado|strong="H7324"\w*,  
\q2 \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w las|strong="H5921"\w* vírgenes \w te|strong="H5921"\w* aman.   
\q1
\v 4 \w Llévame|strong="H4900"\w* contigo.  
\q2 Démonos prisa.  
\q2 El \w rey|strong="H4428"\w* me ha llevado \w a|strong="H3068"\w* sus habitaciones.  
\sp Amigos  
\q1 Nos \w alegraremos|strong="H8055"\w* y nos regocijaremos en ti.  
\q2 ¡Alabaremos tu amor más que el \w vino|strong="H3196"\w*!  
\sp Amado  
\q1 Hacen \w bien|strong="H2142"\w* en quererte.   
\q1
\v 5 Soy oscura, pero encantadora,  
\q2 vosotras, \w hijas|strong="H1323"\w* \w de|strong="H3407"\w* Jerusalén,  
\q2 como las tiendas \w de|strong="H3407"\w* Kedar,  
\q2 como las \w cortinas|strong="H3407"\w* \w de|strong="H3407"\w* \w Salomón|strong="H8010"\w*.   
\q1
\v 6 \w No|strong="H3808"\w* me \w mires|strong="H7200"\w* fijamente \w porque|strong="H3808"\w* soy oscuro,  
\q2 \w porque|strong="H3808"\w* \w el|strong="H1121"\w* \w sol|strong="H8121"\w* me \w ha|strong="H3808"\w* quemado.  
\q1 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* mi madre estaban enfadados conmigo.  
\q2 Me \w hicieron|strong="H7760"\w* guardián \w de|strong="H1121"\w* \w los|strong="H1121"\w* viñedos.  
\q2 \w No|strong="H3808"\w* he mantenido mi propio viñedo.   
\q1
\v 7 Dime, tú \w a|strong="H3068"\w* \w quien|strong="H4100"\w* ama \w mi|strong="H5921"\w* \w alma|strong="H5315"\w*,  
\q2 \w donde|strong="H5921"\w* \w apacienta|strong="H7462"\w* su rebaño,  
\q2 \w donde|strong="H5921"\w* \w se|strong="H1961"\w* descansa \w al|strong="H5921"\w* mediodía;  
\q2 \w pues|strong="H1961"\w* \w por|strong="H5921"\w* \w qué|strong="H4100"\w* he \w de|strong="H5921"\w* \w ser|strong="H5315"\w* \w como|strong="H4100"\w* \w quien|strong="H4100"\w* \w está|strong="H1961"\w* velado  
\q2 \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w rebaños|strong="H5739"\w* \w de|strong="H5921"\w* tus compañeros?   
\sp Amante  
\q1
\v 8 \w Si|strong="H3808"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w sabes|strong="H3045"\w*, \w la|strong="H5921"\w* \w más|strong="H5921"\w* bella \w entre|strong="H5921"\w* \w las|strong="H5921"\w* mujeres,  
\q2 seguir \w las|strong="H5921"\w* huellas \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w*.  
\q2 Haz pastar \w a|strong="H3068"\w* tus cabritos \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w tiendas|strong="H4908"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w pastores|strong="H7462"\w*.   
\b  
\q1
\v 9 Te he comparado, mi amor,  
\q2 \w a|strong="H3068"\w* un corcel en los \w carros|strong="H7393"\w* del \w Faraón|strong="H6547"\w*.   
\q1
\v 10 Tus mejillas son \w hermosas|strong="H4998"\w* con los pendientes,  
\q2 su \w cuello|strong="H6677"\w* con cadenas de joyas.   
\sp Amigos  
\q1
\v 11 \w Te|strong="H5973"\w* \w haremos|strong="H6213"\w* pendientes \w de|strong="H5973"\w* \w oro|strong="H2091"\w*,  
\q2 \w con|strong="H5973"\w* tachuelas \w de|strong="H5973"\w* \w plata|strong="H3701"\w*.   
\sp Amado  
\q1
\v 12 \w Mientras|strong="H5704"\w* el \w rey|strong="H4428"\w* se sentaba \w a|strong="H3068"\w* su mesa,  
\q2 mi perfume extendió su fragancia.   
\q1
\v 13 Mi \w amado|strong="H1730"\w* es para mí un saquito de \w mirra|strong="H4753"\w*,  
\q2 que se encuentra entre mis \w pechos|strong="H7699"\w*.   
\q1
\v 14 Mi \w amado|strong="H1730"\w* es para mí un racimo de flores de henna  
\q2 de los viñedos de En Gedi.   
\sp Amante  
\q1
\v 15 He \w aquí|strong="H2005"\w*,\f + \fr 1:15 \ft “He aquí”, de “הִנֵּה”, significa mirar, fijarse, observar, ver o contemplar. Se utiliza a menudo como interjección.\f* que eres \w hermosa|strong="H3303"\w*, mi amor.  
\q2 Contempla, eres \w hermosa|strong="H3303"\w*.  
\q2 Tus \w ojos|strong="H5869"\w* son como palomas.   
\sp Amado  
\q1
\v 16 He \w aquí|strong="H2005"\w* que eres \w hermosa|strong="H3303"\w*, amada mía, \w sí|strong="H2005"\w*, agradable;  
\q2 y nuestro sofá es \w verde|strong="H7488"\w*.   
\sp Amante  
\q1
\v 17 Las vigas de nuestra \w casa|strong="H1004"\w* son cedros.  
\q2 Nuestras vigas son abetos.   
\c 2
\sp Amado  
\q1
\v 1 Soy una rosa de \w Sarón|strong="H8289"\w*,  
\q2 un lirio de los \w valles|strong="H6010"\w*.   
\sp Amante  
\q1
\v 2 \w Como|strong="H3651"\w* un lirio entre \w espinas|strong="H2336"\w*,  
\q2 \w así|strong="H3651"\w* es mi amor entre las \w hijas|strong="H1323"\w*.   
\sp Amado  
\q1
\v 3 \w Como|strong="H3651"\w* \w el|strong="H3427"\w* manzano entre \w los|strong="H3427"\w* \w árboles|strong="H6086"\w* del \w bosque|strong="H3293"\w*,  
\q2 \w así|strong="H3651"\w* es mi \w amado|strong="H1730"\w* entre \w los|strong="H3427"\w* \w hijos|strong="H1121"\w*.  
\q1 Me senté bajo su \w sombra|strong="H6738"\w* con gran placer,  
\q2 su \w fruta|strong="H6529"\w* \w era|strong="H1121"\w* \w dulce|strong="H4966"\w* para mi gusto.   
\q1
\v 4 \w Me|strong="H5921"\w* llevó \w a|strong="H3068"\w* \w la|strong="H5921"\w* sala \w de|strong="H5921"\w* banquetes.  
\q2 Su estandarte \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w* es \w el|strong="H5921"\w* amor.   
\q1
\v 5 Fortaléceme \w con|strong="H3588"\w* las pasas,  
\q2 refrescarme \w con|strong="H3588"\w* manzanas;  
\q2 ya \w que|strong="H3588"\w* \w me|strong="H3588"\w* siento débil \w de|strong="H3588"\w* amor.   
\q1
\v 6 Su mano \w izquierda|strong="H8040"\w* está \w bajo|strong="H8478"\w* mi \w cabeza|strong="H7218"\w*.  
\q2 Su mano \w derecha|strong="H3225"\w* me abraza.   
\q1
\v 7 \w Os|strong="H5704"\w* \w conjuro|strong="H7650"\w*, \w hijas|strong="H1323"\w* \w de|strong="H5704"\w* Jerusalén,  
\q2 \w por|strong="H5704"\w* las corzas, \w o|strong="H3068"\w* \w por|strong="H5704"\w* las ciervas del \w campo|strong="H7704"\w*,  
\q2 \w para|strong="H5704"\w* \w que|strong="H5704"\w* no te agites, \w ni|strong="H5704"\w* despiertes el amor,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w lo|strong="H5704"\w* desee.   
\b  
\q1
\v 8 ¡\w La|strong="H5921"\w* \w voz|strong="H6963"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w amado|strong="H1730"\w*!  
\q2 He \w aquí|strong="H2009"\w* \w que|strong="H5921"\w* viene,  
\q2 \w saltando|strong="H1801"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* montañas,  
\q2 \w saltando|strong="H1801"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* colinas.   
\q1
\v 9 \w Mi|strong="H2009"\w* \w amado|strong="H1730"\w* \w es|strong="H2088"\w* como un corzo \w o|strong="H3068"\w* un ciervo joven.  
\q2 ¡Contempla, \w está|strong="H2088"\w* detrás \w de|strong="H4480"\w* nuestro muro!  
\q1 \w Mira|strong="H2009"\w* \w hacia|strong="H4480"\w* las \w ventanas|strong="H2474"\w*.  
\q2 \w Mira|strong="H2009"\w* \w a|strong="H3068"\w* través \w de|strong="H4480"\w* la celosía.   
\b  
\q1
\v 10 \w Mi|strong="H6030"\w* \w amado|strong="H1730"\w* \w habló|strong="H6030"\w* y me dijo,  
\q2 “\w Levántate|strong="H6965"\w*, \w mi|strong="H6030"\w* amor, \w mi|strong="H6030"\w* bella, y \w ven|strong="H3212"\w*.   
\q1
\v 11 \w Porque|strong="H3588"\w* he \w aquí|strong="H2009"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* invierno ha \w pasado|strong="H5674"\w*.  
\q2 \w La|strong="H3588"\w* \w lluvia|strong="H1653"\w* ha terminado \w y|strong="H3588"\w* se ha ido.   
\q1
\v 12 Las flores \w aparecen|strong="H7200"\w* en la tierra.  
\q2 Ha \w llegado|strong="H5060"\w* el momento del canto,  
\q2 y la \w voz|strong="H6963"\w* \w de|strong="H6256"\w* la tórtola se \w oye|strong="H8085"\w* en nuestra tierra.   
\q1
\v 13 La higuera madura sus \w higos|strong="H8384"\w* verdes.  
\q2 Las \w vides|strong="H1612"\w* están \w en|strong="H3212"\w* flor.  
\q2 Desprenden su fragancia.  
\q1 \w Levántate|strong="H6965"\w*, mi amor, mi bella,  
\q2 y váyase”.   
\sp Amante  
\q1
\v 14 Mi \w paloma|strong="H3123"\w* \w en|strong="H3588"\w* las hendiduras \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w roca|strong="H5553"\w*,  
\q2 \w en|strong="H3588"\w* \w los|strong="H3588"\w* escondites \w de|strong="H3588"\w* \w la|strong="H3588"\w* ladera \w de|strong="H3588"\w* \w la|strong="H3588"\w* montaña,  
\q2 déjame \w ver|strong="H7200"\w* tu cara.  
\q2 Déjame \w escuchar|strong="H8085"\w* tu \w voz|strong="H6963"\w*;  
\q2 \w porque|strong="H3588"\w* tu \w voz|strong="H6963"\w* \w es|strong="H3588"\w* \w dulce|strong="H6156"\w* \w y|strong="H3588"\w* tu \w rostro|strong="H4758"\w* \w es|strong="H3588"\w* hermoso.   
\q1
\v 15 Atrapa para nosotros los zorros,  
\q2 los \w pequeños|strong="H6996"\w* zorros que saquean los viñedos;  
\q2 porque nuestros viñedos están en flor.   
\sp Amado  
\q1
\v 16 Mi \w amado|strong="H1730"\w* es mío, y yo soy suya.  
\q2 Navega entre los \w lirios|strong="H7799"\w*.   
\q1
\v 17 \w Hasta|strong="H5704"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w se|strong="H5921"\w* enfríe \w y|strong="H5921"\w* \w las|strong="H5921"\w* sombras huyan,  
\q2 \w vuelta|strong="H5437"\w*, \w mi|strong="H5921"\w* \w amado|strong="H1730"\w*,  
\q2 \w y|strong="H5921"\w* ser \w como|strong="H5921"\w* un corzo \w o|strong="H3068"\w* un joven ciervo \w en|strong="H5921"\w* \w las|strong="H5921"\w* montañas \w de|strong="H5921"\w* Bether.   
\c 3
\p
\v 1 \w Por|strong="H5921"\w* \w la|strong="H5921"\w* \w noche|strong="H3915"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w cama|strong="H4904"\w*,  
\q2 \w Busqué|strong="H1245"\w* \w a|strong="H3068"\w* quien \w mi|strong="H5921"\w* \w alma|strong="H5315"\w* ama.  
\q2 \w Lo|strong="H3808"\w* \w busqué|strong="H1245"\w*, pero \w no|strong="H3808"\w* \w lo|strong="H3808"\w* encontré.   
\q1
\v 2 Me \w levantaré|strong="H6965"\w* \w ahora|strong="H4994"\w* y recorreré la \w ciudad|strong="H5892"\w*;  
\q2 en las \w calles|strong="H7339"\w* y en las \w plazas|strong="H7339"\w* \w buscaré|strong="H1245"\w* al \w que|strong="H3808"\w* ama \w mi|strong="H4994"\w* \w alma|strong="H5315"\w*.  
\q2 \w Lo|strong="H3808"\w* \w busqué|strong="H1245"\w*, pero \w no|strong="H3808"\w* \w lo|strong="H3808"\w* encontré.   
\q1
\v 3 Los vigilantes que recorren \w la|strong="H8104"\w* \w ciudad|strong="H5892"\w* me encontraron;  
\q2 “¿Has \w visto|strong="H7200"\w* al que ama \w mi|strong="H5315"\w* \w alma|strong="H5315"\w*?”   
\q1
\v 4 Apenas \w había|strong="H4672"\w* \w pasado|strong="H5674"\w* \w de|strong="H5704"\w* \w ellos|strong="H1992"\w*,  
\q2 \w cuando|strong="H5704"\w* encontré \w al|strong="H5704"\w* \w que|strong="H3808"\w* ama \w mi|strong="H5315"\w* \w alma|strong="H5315"\w*.  
\q1 \w Lo|strong="H3808"\w* abracé \w y|strong="H5704"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* dejé ir,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* \w lo|strong="H3808"\w* llevé \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H5704"\w* \w mi|strong="H5315"\w* madre,  
\q2 \w en|strong="H5704"\w* la habitación \w de|strong="H5704"\w* la \w que|strong="H3808"\w* me \w concibió|strong="H2029"\w*.   
\b  
\q1
\v 5 \w Os|strong="H5704"\w* \w conjuro|strong="H7650"\w*, \w hijas|strong="H1323"\w* \w de|strong="H5704"\w* Jerusalén,  
\q2 \w por|strong="H5704"\w* las corzas, \w o|strong="H3068"\w* \w por|strong="H5704"\w* las ciervas del \w campo|strong="H7704"\w*,  
\q2 \w para|strong="H5704"\w* \w que|strong="H5704"\w* no despiertes \w ni|strong="H5704"\w* despiertes el amor,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w lo|strong="H5704"\w* desee.   
\b  
\q1
\v 6 ¿\w Quién|strong="H4310"\w* \w es|strong="H2063"\w* ese \w que|strong="H4480"\w* \w sube|strong="H5927"\w* \w del|strong="H4480"\w* \w desierto|strong="H4057"\w* como columnas \w de|strong="H4480"\w* \w humo|strong="H6227"\w*?  
\q2 perfumado \w con|strong="H4480"\w* \w mirra|strong="H4753"\w* \w e|strong="H3068"\w* \w incienso|strong="H3828"\w*,  
\q2 \w con|strong="H4480"\w* \w todas|strong="H3605"\w* las especias \w del|strong="H4480"\w* comerciante?   
\q1
\v 7 ¡\w Mira|strong="H2009"\w*, es el carruaje de \w Salomón|strong="H8010"\w*!  
\q2 \w Sesenta|strong="H8346"\w* \w hombres|strong="H1368"\w* \w poderosos|strong="H1368"\w* \w están|strong="H2009"\w* \w a|strong="H3068"\w* su \w alrededor|strong="H5439"\w*,  
\q2 de los \w hombres|strong="H1368"\w* \w poderosos|strong="H1368"\w* de \w Israel|strong="H3478"\w*.   
\q1
\v 8 \w Todos|strong="H3605"\w* \w ellos|strong="H5921"\w* manejan \w la|strong="H5921"\w* \w espada|strong="H2719"\w* \w y|strong="H5921"\w* son expertos \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*.  
\q2 \w Todo|strong="H3605"\w* hombre tiene su \w espada|strong="H2719"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w muslo|strong="H3409"\w*,  
\q2 \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w miedo|strong="H6343"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w noche|strong="H3915"\w*.   
\b  
\q1
\v 9 \w El|strong="H6213"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* se \w hizo|strong="H6213"\w* un carruaje  
\q2 del bosque del \w Líbano|strong="H3844"\w*.   
\q1
\v 10 \w Hizo|strong="H6213"\w* sus pilares de \w plata|strong="H3701"\w*,  
\q2 su fondo de \w oro|strong="H2091"\w*, su asiento de púrpura,  
\q2 \w el|strong="H6213"\w* centro de la misma está pavimentado con amor,  
\q2 de las \w hijas|strong="H1323"\w* de Jerusalén.   
\q1
\v 11 \w Salid|strong="H3318"\w*, \w hijas|strong="H1323"\w* de \w Sión|strong="H6726"\w*, y \w ved|strong="H7200"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*,  
\q2 con la \w corona|strong="H5850"\w* con la \w que|strong="H3117"\w* su madre le ha coronado,  
\q2 \w en|strong="H3318"\w* el \w día|strong="H3117"\w* de sus bodas,  
\q2 \w en|strong="H3318"\w* el \w día|strong="H3117"\w* de la \w alegría|strong="H8057"\w* de su \w corazón|strong="H3820"\w*.   
\c 4
\sp Amante  
\p
\v 1 He \w aquí|strong="H2005"\w* \w que|strong="H1157"\w* eres \w hermosa|strong="H3303"\w*, amor mío.  
\q2 Contempla, eres \w hermosa|strong="H3303"\w*.  
\q1 Tus \w ojos|strong="H5869"\w* son como palomas detrás \w de|strong="H5869"\w* tu velo.  
\q2 Tu \w pelo|strong="H8181"\w* es como un rebaño \w de|strong="H5869"\w* \w cabras|strong="H5795"\w*,  
\q2 \w que|strong="H1157"\w* descienden del \w monte|strong="H2022"\w* \w Galaad|strong="H1568"\w*.   
\q1
\v 2 Tus \w dientes|strong="H8127"\w* son como un rebaño recién esquilado,  
\q2 \w que|strong="H4480"\w* han surgido \w del|strong="H4480"\w* lavado,  
\q2 donde \w cada|strong="H3605"\w* uno \w de|strong="H4480"\w* \w ellos|strong="H4480"\w* tiene gemelos.  
\q2 \w Ninguno|strong="H3605"\w* \w de|strong="H4480"\w* \w ellos|strong="H4480"\w* está afligido.   
\q1
\v 3 Tus \w labios|strong="H8193"\w* son como un hilo escarlata.  
\q2 Tu \w boca|strong="H8193"\w* es encantadora.  
\q2 Tus sienes son como un trozo de granada detrás de tu velo.   
\q1
\v 4 Tu \w cuello|strong="H6677"\w* es \w como|strong="H5921"\w* \w la|strong="H5921"\w* \w torre|strong="H4026"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* construida \w para|strong="H5921"\w* una armería,  
\q2 \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* cuelgan mil \w escudos|strong="H4043"\w*,  
\q2 \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w escudos|strong="H4043"\w* \w de|strong="H5921"\w* \w los|strong="H3605"\w* \w hombres|strong="H1368"\w* \w poderosos|strong="H1368"\w*.   
\q1
\v 5 Tus \w dos|strong="H8147"\w* \w pechos|strong="H7699"\w* son como \w dos|strong="H8147"\w* cervatillos  
\q2 que son gemelos de una corza,  
\q2 que se alimentan entre los \w lirios|strong="H7799"\w*.   
\b  
\q1
\v 6 \w Hasta|strong="H5704"\w* \w que|strong="H5704"\w* el \w día|strong="H3117"\w* se enfríe \w y|strong="H5704"\w* las sombras huyan,  
\q2 \w Iré|strong="H3212"\w* \w a|strong="H3068"\w* la montaña \w de|strong="H5704"\w* la \w mirra|strong="H4753"\w*,  
\q2 \w a|strong="H3068"\w* la colina del \w incienso|strong="H3828"\w*.   
\b  
\q1
\v 7 \w Todos|strong="H3605"\w* ustedes son \w hermosos|strong="H3303"\w*, mi amor.  
\q2 No hay \w ninguna|strong="H3605"\w* \w mancha|strong="H3971"\w* en ti.   
\q1
\v 8 Ven conmigo desde el \w Líbano|strong="H3844"\w*, mi novia,  
\q2 conmigo desde el \w Líbano|strong="H3844"\w*.  
\q2 Mira desde la cima de Amana,  
\q2 desde la cima de \w Senir|strong="H8149"\w* y \w Hermón|strong="H2768"\w*,  
\q2 de las guaridas de los leones,  
\q2 de las montañas de los leopardos.   
\b  
\q1
\v 9 Has embelesado mi corazón, hermana mía, mi novia.  
\q2 Has embelesado mi corazón con uno \w de|strong="H5869"\w* tus \w ojos|strong="H5869"\w*,  
\q2 con una cadena \w de|strong="H5869"\w* su \w cuello|strong="H6677"\w*.   
\q1
\v 10 ¡\w Qué|strong="H4100"\w* \w hermoso|strong="H3302"\w* es tu amor, hermana mía, novia mía!  
\q2 \w Cuánto|strong="H4100"\w* \w mejor|strong="H2895"\w* es tu amor \w que|strong="H4100"\w* \w el|strong="H3605"\w* \w vino|strong="H3196"\w*,  
\q2 ¡\w la|strong="H3605"\w* fragancia de sus perfumes \w que|strong="H4100"\w* \w todo|strong="H3605"\w* tipo de \w especias|strong="H1314"\w*!   
\q1
\v 11 Tus \w labios|strong="H8193"\w*, novia mía, gotean \w como|strong="H8008"\w* el \w panal|strong="H5317"\w* \w de|strong="H8478"\w* \w miel|strong="H1706"\w*.  
\q2 La \w miel|strong="H1706"\w* \w y|strong="H5317"\w* la \w leche|strong="H2461"\w* están \w bajo|strong="H8478"\w* tu \w lengua|strong="H3956"\w*.  
\q2 El \w olor|strong="H7381"\w* \w de|strong="H8478"\w* tus prendas es \w como|strong="H8008"\w* el \w olor|strong="H7381"\w* del \w Líbano|strong="H3844"\w*.   
\q1
\v 12 Mi hermana, mi novia, es un jardín \w cerrado|strong="H5274"\w*;  
\q2 un resorte bloqueado,  
\q2 una \w fuente|strong="H4599"\w* \w sellada|strong="H2856"\w*.   
\q1
\v 13 Tus brotes son un huerto \w de|strong="H5973"\w* \w granadas|strong="H7416"\w*, \w con|strong="H5973"\w* \w frutos|strong="H6529"\w* preciosos,  
\q2 henna \w con|strong="H5973"\w* plantas \w de|strong="H5973"\w* \w nardo|strong="H5373"\w*,   
\q2
\v 14 \w nardo|strong="H5373"\w* y azafrán,  
\q2 cálamo y canela, \w con|strong="H5973"\w* \w todo|strong="H3605"\w* tipo \w de|strong="H5973"\w* \w árbol|strong="H6086"\w* \w de|strong="H5973"\w* \w incienso|strong="H3828"\w*;  
\q2 \w mirra|strong="H4753"\w* y \w áloes|strong="H4753"\w*, \w con|strong="H5973"\w* \w todas|strong="H3605"\w* las mejores \w especias|strong="H1314"\w*,   
\q2
\v 15 una \w fuente|strong="H4599"\w* \w de|strong="H4480"\w* jardines,  
\q2 un pozo \w de|strong="H4480"\w* \w aguas|strong="H4325"\w* \w vivas|strong="H2416"\w*,  
\q2 \w corrientes|strong="H5140"\w* \w que|strong="H4480"\w* fluyen \w desde|strong="H4480"\w* el \w Líbano|strong="H3844"\w*.   
\sp Amado  
\q1
\v 16 ¡\w Despierta|strong="H5782"\w*, viento del \w norte|strong="H6828"\w*, y ven, sur!  
\q2 Sopla en mi jardín, para que sus \w especias|strong="H1314"\w* fluyan.  
\q1 Deja que mi \w amado|strong="H1730"\w* entre en su jardín,  
\q2 y probar sus preciosos \w frutos|strong="H6529"\w*.   
\c 5
\sp Amante  
\q1
\v 1 He entrado \w en|strong="H5973"\w* mi jardín, mi hermana, mi novia.  
\q2 He reunido mi \w mirra|strong="H4753"\w* \w con|strong="H5973"\w* mi especia;  
\q2 He comido mi panal \w con|strong="H5973"\w* mi \w miel|strong="H1706"\w*;  
\q2 He \w bebido|strong="H8354"\w* mi \w vino|strong="H3196"\w* \w con|strong="H5973"\w* mi \w leche|strong="H2461"\w*.  
\sp Amigos  
\q1 ¡Comed, \w amigos|strong="H7453"\w*!  
\q2 \w Bebe|strong="H8354"\w*, sí, \w bebe|strong="H8354"\w* \w en|strong="H5973"\w* abundancia, \w amado|strong="H1730"\w*.   
\sp Amado  
\q1
\v 2 Yo estaba dormido, pero mi \w corazón|strong="H3820"\w* estaba despierto.  
\q2 Es la \w voz|strong="H6963"\w* de mi amada la que llama:  
\q2 “\w Ábreme|strong="H6605"\w*, hermana \w mía|strong="H3123"\w*, mi amor, mi \w paloma|strong="H3123"\w*, mi inmaculada;  
\q2 porque mi \w cabeza|strong="H7218"\w* está \w llena|strong="H4390"\w* de \w rocío|strong="H2919"\w*,  
\q2 y mi pelo con la humedad de la \w noche|strong="H3915"\w*”.   
\q1
\v 3 Me he quitado la túnica. ¿Debo ponérmela?  
\q2 Me he lavado los \w pies|strong="H7272"\w*. \w De|strong="H3847"\w* hecho, ¿debo ensuciarlos?   
\q1
\v 4 \w Mi|strong="H5921"\w* \w amado|strong="H1730"\w* \w metió|strong="H7971"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* abertura \w del|strong="H4480"\w* pestillo.  
\q2 \w Mi|strong="H5921"\w* corazón latía \w por|strong="H5921"\w* \w él|strong="H5921"\w*.   
\q1
\v 5 \w Me|strong="H5921"\w* levanté \w para|strong="H5921"\w* abrir \w para|strong="H5921"\w* \w mi|strong="H5921"\w* amada.  
\q2 Mis \w manos|strong="H3027"\w* goteaban \w mirra|strong="H4753"\w*,  
\q2 mis dedos \w con|strong="H5921"\w* \w mirra|strong="H4753"\w* líquida,  
\q2 \w en|strong="H5921"\w* \w las|strong="H5921"\w* asas \w de|strong="H5921"\w* \w la|strong="H5921"\w* cerradura.   
\q1
\v 6 Le \w abrí|strong="H6605"\w* \w a|strong="H3068"\w* \w mi|strong="H6030"\w* amada;  
\q2 pero \w mi|strong="H6030"\w* \w amado|strong="H1730"\w* \w se|strong="H3808"\w* \w fue|strong="H3808"\w*, y \w se|strong="H3808"\w* \w fue|strong="H3808"\w*.  
\q1 \w Mi|strong="H6030"\w* \w corazón|strong="H5315"\w* \w se|strong="H3808"\w* apagó cuando \w habló|strong="H1696"\w*.  
\q2 \w Lo|strong="H3808"\w* \w busqué|strong="H1245"\w*, pero \w no|strong="H3808"\w* \w lo|strong="H3808"\w* encontré.  
\q2 Le \w llamé|strong="H7121"\w*, pero \w no|strong="H3808"\w* contestó.   
\q1
\v 7 \w Los|strong="H5921"\w* vigilantes \w que|strong="H5921"\w* recorren \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w me|strong="H5921"\w* encontraron.  
\q2 \w Me|strong="H5921"\w* ganaron.  
\q2 \w Me|strong="H5921"\w* han magullado.  
\q2 \w Los|strong="H5921"\w* guardianes \w de|strong="H5921"\w* \w las|strong="H5921"\w* murallas \w me|strong="H5921"\w* quitaron \w la|strong="H5921"\w* capa.   
\b  
\q1
\v 8 Os \w conjuro|strong="H7650"\w*, \w hijas|strong="H1323"\w* de Jerusalén,  
\q2 Si encuentras \w a|strong="H3068"\w* \w mi|strong="H3389"\w* amada,  
\q2 \w que|strong="H4100"\w* le digas \w que|strong="H4100"\w* me desmayo de amor.   
\sp Amigos  
\q1
\v 9 ¿\w Cómo|strong="H4100"\w* es tu \w amado|strong="H1730"\w* mejor \w que|strong="H4100"\w* otro \w amado|strong="H1730"\w*,  
\q2 ¿eres la más bella entre las mujeres?  
\q1 \w Cómo|strong="H4100"\w* es \w que|strong="H4100"\w* tu \w amado|strong="H1730"\w* es mejor \w que|strong="H4100"\w* otro \w amado|strong="H1730"\w*,  
\q1 ¿\w que|strong="H4100"\w* \w nos|strong="H4100"\w* adjuntan?   
\sp Amado  
\q1
\v 10 Mi \w amado|strong="H1730"\w* es blanco y rubicundo.  
\q2 El mejor entre diez \w mil|strong="H7233"\w*.   
\q1
\v 11 Su \w cabeza|strong="H7218"\w* es como el \w oro|strong="H6337"\w* más puro.  
\q2 Su pelo es tupido, \w negro|strong="H7838"\w* como un \w cuervo|strong="H6158"\w*.   
\q1
\v 12 Sus \w ojos|strong="H5869"\w* son \w como|strong="H5921"\w* palomas \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* arroyos \w de|strong="H5921"\w* \w agua|strong="H4325"\w*,  
\q2 lavados \w con|strong="H5921"\w* \w leche|strong="H2461"\w*, montados \w como|strong="H5921"\w* joyas.   
\q1
\v 13 Sus mejillas son como un lecho de \w especias|strong="H1314"\w* con \w torres|strong="H4026"\w* de perfumes.  
\q2 Sus \w labios|strong="H8193"\w* son como \w lirios|strong="H7799"\w*, que dejan caer \w mirra|strong="H4753"\w* líquida.   
\q1
\v 14 Sus \w manos|strong="H3027"\w* son como \w anillos|strong="H1550"\w* de \w oro|strong="H2091"\w* \w engastados|strong="H4390"\w* con berilo.  
\q2 Su cuerpo \w es|strong="H3027"\w* como una obra de \w marfil|strong="H8127"\w* recubierta de zafiros.   
\q1
\v 15 Sus piernas son \w como|strong="H5921"\w* \w columnas|strong="H5982"\w* \w de|strong="H5921"\w* mármol asentadas \w sobre|strong="H5921"\w* bases \w de|strong="H5921"\w* \w oro|strong="H6337"\w* \w fino|strong="H6337"\w*.  
\q2 Su \w aspecto|strong="H4758"\w* es \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w Líbano|strong="H3844"\w*, excelente \w como|strong="H5921"\w* \w los|strong="H5921"\w* cedros.   
\q1
\v 16 Su boca \w es|strong="H2088"\w* \w la|strong="H3605"\w* dulzura;  
\q2 Sí, \w es|strong="H2088"\w* totalmente encantador.  
\q1 \w Este|strong="H2088"\w* \w es|strong="H2088"\w* \w mi|strong="H3389"\w* \w amado|strong="H1730"\w*, y \w este|strong="H2088"\w* \w es|strong="H2088"\w* \w mi|strong="H3389"\w* \w amigo|strong="H7453"\w*,  
\q2 \w hijas|strong="H1323"\w* de Jerusalén.   
\c 6
\sp Amigos  
\q1
\v 1 ¿Dónde ha ido tu \w amado|strong="H1730"\w*, la \w más|strong="H1245"\w* bella \w de|strong="H5973"\w* las mujeres?  
\q2 ¿Dónde se ha vuelto tu \w amado|strong="H1730"\w*, \w para|strong="H5973"\w* que lo busquemos \w contigo|strong="H5973"\w*?   
\sp Amado  
\q1
\v 2 Mi \w amado|strong="H1730"\w* ha bajado \w a|strong="H3068"\w* su jardín,  
\q2 \w a|strong="H3068"\w* los lechos de \w especias|strong="H1314"\w*,  
\q2 para apacentar su rebaño en los jardines, y para recoger \w lirios|strong="H7799"\w*.   
\q1
\v 3 Yo soy de mi \w amado|strong="H1730"\w*, y mi \w amado|strong="H1730"\w* es mío.  
\q2 Navega entre los \w lirios|strong="H7799"\w*.   
\b  
\sp Amante  
\q1
\v 4 Eres \w hermosa|strong="H3303"\w*, \w mi|strong="H3389"\w* amor, como Tirzah,  
\q2 encantadora como Jerusalén,  
\q2 impresionante como un ejército con estandartes.   
\q1
\v 5 \w Aparta|strong="H5437"\w* tus \w ojos|strong="H5869"\w* \w de|strong="H4480"\w* mí,  
\q2 porque \w me|strong="H4480"\w* han vencido.  
\q1 Tu \w pelo|strong="H8181"\w* es como un rebaño \w de|strong="H4480"\w* \w cabras|strong="H5795"\w*,  
\q2 \w que|strong="H4480"\w* \w se|strong="H1992"\w* encuentran \w a|strong="H3068"\w* \w lo|strong="H1992"\w* largo \w del|strong="H4480"\w* lado \w de|strong="H4480"\w* \w Galaad|strong="H1568"\w*.   
\q1
\v 6 Tus \w dientes|strong="H8127"\w* son como un rebaño \w de|strong="H4480"\w* \w ovejas|strong="H7353"\w*,  
\q2 \w que|strong="H4480"\w* han surgido \w del|strong="H4480"\w* lavado,  
\q2 \w de|strong="H4480"\w* \w los|strong="H3605"\w* cuales \w cada|strong="H3605"\w* uno tiene gemelos;  
\q2 ni uno solo está afligido \w entre|strong="H4480"\w* \w ellos|strong="H4480"\w*.   
\q1
\v 7 Tus sienes son como un trozo de granada detrás de tu velo.   
\b  
\q1
\v 8 Hay \w sesenta|strong="H8346"\w* reinas, \w ochenta|strong="H8084"\w* \w concubinas|strong="H6370"\w*,  
\q2 y vírgenes sin \w número|strong="H4557"\w*.   
\q1
\v 9 Mi \w paloma|strong="H3123"\w*, mi \w perfecta|strong="H8535"\w*, \w es|strong="H1931"\w* única.  
\q2 \w Es|strong="H1931"\w* \w la|strong="H1931"\w* única \w hija|strong="H1323"\w* de \w su|strong="H1931"\w* madre.  
\q2 \w Es|strong="H1931"\w* \w la|strong="H1931"\w* favorita de \w quien|strong="H1931"\w* \w la|strong="H1931"\w* \w parió|strong="H3205"\w*.  
\q1 Las \w hijas|strong="H1323"\w* \w la|strong="H1931"\w* \w vieron|strong="H7200"\w* y \w la|strong="H1931"\w* llamaron bendita.  
\q2 Las reinas y las \w concubinas|strong="H6370"\w* \w la|strong="H1931"\w* \w vieron|strong="H7200"\w* y \w la|strong="H1931"\w* alabaron.   
\b  
\q1
\v 10 ¿\w Quién|strong="H4310"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* \w que|strong="H4310"\w* \w mira|strong="H8259"\w* hacia fuera \w como|strong="H3644"\w* \w la|strong="H2063"\w* \w mañana|strong="H7837"\w*,  
\q2 \w hermosa|strong="H3303"\w* \w como|strong="H3644"\w* \w la|strong="H2063"\w* luna,  
\q2 claro \w como|strong="H3644"\w* \w el|strong="H4310"\w* sol,  
\q2 \w e|strong="H3068"\w* impresionante \w como|strong="H3644"\w* un ejército con estandartes?   
\b  
\q1
\v 11 Bajé al bosquecillo de nogales,  
\q2 para \w ver|strong="H7200"\w* las plantas verdes del valle,  
\q2 para \w ver|strong="H7200"\w* si la \w vid|strong="H1612"\w* brotó,  
\q2 y las \w granadas|strong="H7416"\w* estaban en flor.   
\q1
\v 12 \w Sin|strong="H3808"\w* darse cuenta,  
\q2 \w mi|strong="H5315"\w* deseo me \w puso|strong="H7760"\w* con los \w carros|strong="H4818"\w* \w de|strong="H5971"\w* \w mi|strong="H5315"\w* \w pueblo|strong="H5971"\w* real.   
\sp Amigos  
\q1
\v 13 ¡Vuelve, vuelve, Sulamita!  
\q2 Vuelve, vuelve, para que te contemplemos.  
\sp Amante  
\q1 ¿Por qué deseas mirar \w a|strong="H3068"\w* la Sulamita?  
\q2 como en el baile de Mahanaim?   
\c 7
\p
\v 1 ¡\w Qué|strong="H4100"\w* hermosos son tus pies en sandalias, hija del príncipe!  
\q2 Tus muslos redondeados son \w como|strong="H4100"\w* joyas,  
\q2 \w el|strong="H4264"\w* trabajo de las manos de un hábil obrero.   
\q1
\v 2 Tu cuerpo \w es|strong="H3027"\w* \w como|strong="H4100"\w* \w una|strong="H6471"\w* copa redonda,  
\q2 \w no|strong="H4100"\w* falta ningún \w vino|strong="H4100"\w* mezclado.  
\q1 Tu cintura \w es|strong="H3027"\w* \w como|strong="H4100"\w* un montón de trigo,  
\q2 con lirios.   
\q1
\v 3 Tus dos pechos son como dos cervatillos,  
\q2 que son gemelos de una corza.   
\q1
\v 4 Tu cuello es como una torre de marfil.  
\q2 Tus ojos son como los estanques de Hesbón, junto \w a|strong="H3068"\w* la puerta de Bathrabbim.  
\q2 Tu nariz es como la torre del Líbano que mira hacia Damasco.   
\q1
\v 5 Tu cabeza \w en|strong="H5921"\w* \w ti|strong="H5921"\w* es \w como|strong="H5921"\w* \w el|strong="H5921"\w* Carmelo.  
\q2 \w El|strong="H5921"\w* pelo \w de|strong="H5921"\w* tu cabeza \w como|strong="H5921"\w* \w la|strong="H5921"\w* púrpura.  
\q2 \w El|strong="H5921"\w* rey \w está|strong="H5921"\w* cautivo \w en|strong="H5921"\w* sus mechones.   
\q1
\v 6 \w Qué|strong="H5921"\w* hermosa \w y|strong="H5921"\w* \w qué|strong="H5921"\w* agradable eres,  
\q2 ¡\w el|strong="H5921"\w* amor, \w por|strong="H5921"\w* \w las|strong="H5921"\w* delicias!   
\q1
\v 7 Esta, tu estatura, es \w como|strong="H4100"\w* una palmera,  
\q2 tus pechos \w como|strong="H4100"\w* su fruto.   
\q1
\v 8 Dije: “Me subiré \w a|strong="H3068"\w* \w la|strong="H2063"\w* palmera.  
\q2 Me apoderaré de su fruto”.  
\q1 Que tus \w pechos|strong="H7699"\w* sean como racimos de vid,  
\q2 el olor de tu aliento como el de las manzanas.   
\q1
\v 9 Tu boca \w es|strong="H1961"\w* \w como|strong="H1961"\w* el mejor \w vino|strong="H1961"\w*,  
\q2 \w que|strong="H4994"\w* \w se|strong="H1961"\w* le \w va|strong="H3068"\w* de las manos \w a|strong="H3068"\w* \w mi|strong="H4994"\w* amada,  
\q2 deslizándose por \w los|strong="H1961"\w* labios de \w los|strong="H1961"\w* \w que|strong="H4994"\w* duermen.   
\sp Amado  
\q1
\v 10 Yo soy de mi amada.  
\q2 Su deseo es hacia mí.   
\q1
\v 11 ¡Ven, \w amado|strong="H1730"\w* \w mío|strong="H5921"\w*! Salgamos \w al|strong="H5921"\w* campo.  
\q2 Alojémonos \w en|strong="H5921"\w* \w los|strong="H5921"\w* pueblos.   
\q1
\v 12 \w Vayamos|strong="H3212"\w* temprano \w a|strong="H3068"\w* los viñedos.  
\q2 Veamos si la vid ha brotado,  
\q2 su flor está abierta,  
\q2 y las granadas están \w en|strong="H3318"\w* flor.  
\q2 Allí te daré mi amor.   
\q1
\v 13 Las mandrágoras producen fragancia.  
\q2 \w A|strong="H3068"\w* nuestras puertas hay todo tipo \w de|strong="H5414"\w* frutos preciosos, nuevos y viejos,  
\q2 que he guardado \w para|strong="H5414"\w* ti, mi amada.   
\c 8
\p
\v 1 \w Oh|strong="H4310"\w*, \w que|strong="H4310"\w* seas \w como|strong="H1571"\w* mi hermano,  
\q2 ¡\w que|strong="H4310"\w* amamantó \w de|strong="H5414"\w* los \w pechos|strong="H7699"\w* \w de|strong="H5414"\w* mi madre!  
\q1 \w Si|strong="H1571"\w* te encontrara \w fuera|strong="H2351"\w*, te besaría;  
\q2 \w sí|strong="H1571"\w*, \w y|strong="H1571"\w* \w nadie|strong="H3808"\w* \w me|strong="H4310"\w* despreciaría.   
\q1
\v 2 Te llevaría, llevándote \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de mi madre,  
\q2 que me instruya.  
\q1 Te haría \w beber|strong="H8248"\w* \w vino|strong="H3196"\w* especiado,  
\q2 del jugo de mi granada.   
\q1
\v 3 Su mano \w izquierda|strong="H8040"\w* estaría \w bajo|strong="H8478"\w* mi \w cabeza|strong="H7218"\w*.  
\q2 Su mano \w derecha|strong="H3225"\w* me abrazaba.   
\b  
\q1
\v 4 \w Os|strong="H5704"\w* \w conjuro|strong="H7650"\w*, \w hijas|strong="H1323"\w* \w de|strong="H5704"\w* Jerusalén,  
\q2 \w para|strong="H5704"\w* \w que|strong="H4100"\w* \w no|strong="H4100"\w* te agites, \w ni|strong="H5704"\w* despiertes el amor,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H4100"\w* \w lo|strong="H4100"\w* desee.   
\sp Amigos  
