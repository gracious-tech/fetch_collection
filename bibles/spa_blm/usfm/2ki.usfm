\v 9 \w Los|strong="H3605"\w* \w capitanes|strong="H8269"\w* \w de|strong="H5973"\w* centenas \w hicieron|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w ordenó|strong="H6680"\w* \w el|strong="H5973"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w*, y \w cada|strong="H3605"\w* uno \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* sus hombres, \w los|strong="H3605"\w* \w que|strong="H3605"\w* debían entrar \w en|strong="H5973"\w* \w sábado|strong="H7676"\w* \w con|strong="H5973"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* debían \w salir|strong="H3318"\w* \w en|strong="H5973"\w* \w sábado|strong="H7676"\w*, y vinieron al \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w*.  
