\v 17 ‘He \w aquí|strong="H2009"\w* \w que|strong="H3808"\w* vienen \w días|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H3808"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* hay \w en|strong="H5704"\w* tu \w casa|strong="H1004"\w*, \w y|strong="H5704"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* tus padres han almacenado \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*, \w será|strong="H3808"\w* \w llevado|strong="H5375"\w* \w a|strong="H3068"\w* Babilonia. \w No|strong="H3808"\w* \w quedará|strong="H3498"\w* \w nada|strong="H3808"\w*’, \w dice|strong="H1697"\w* \w el|strong="H3605"\w* \w Señor|strong="H3068"\w*.  
