\h NEHEMÍAS 
\toc3 Nehemías 
\toc1 NEHEMÍAS 
\toc2 NEHEMÍAS 
\mt1 Nehemías  
\c 1
\p
\v 1 Las \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* \w Nehemías|strong="H5166"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1697"\w* Hacalías.  
\p En \w el|strong="H1121"\w* \w mes|strong="H2320"\w* \w de|strong="H1697"\w* Chislev, en \w el|strong="H1121"\w* \w año|strong="H8141"\w* \w veinte|strong="H6242"\w*, \w estando|strong="H1961"\w* yo en \w el|strong="H1121"\w* palacio \w de|strong="H1697"\w* Susa,  
\v 2 vinieron \w Hanani|strong="H2607"\w*, uno \w de|strong="H4480"\w* mis hermanos, \w él|strong="H1931"\w* \w y|strong="H5921"\w* algunos hombres \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w pregunté|strong="H7592"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w que|strong="H4480"\w* habían escapado, \w que|strong="H4480"\w* habían quedado \w del|strong="H4480"\w* \w cautiverio|strong="H7628"\w*, \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* Jerusalén.  
\v 3 \w Ellos|strong="H4480"\w* \w me|strong="H4480"\w* dijeron: “El remanente \w que|strong="H4480"\w* \w queda|strong="H7604"\w* \w del|strong="H4480"\w* \w cautiverio|strong="H7628"\w* \w allí|strong="H8033"\w* \w en|strong="H4480"\w* la \w provincia|strong="H4082"\w* \w está|strong="H8033"\w* \w en|strong="H4480"\w* \w gran|strong="H1419"\w* aflicción y reproche. También el \w muro|strong="H2346"\w* \w de|strong="H4480"\w* Jerusalén \w está|strong="H8033"\w* derrumbado, y sus \w puertas|strong="H8179"\w* están \w quemadas|strong="H3341"\w* \w por|strong="H4480"\w* el fuego”.   
\p
\v 4 \w Cuando|strong="H3117"\w* \w oí|strong="H8085"\w* estas \w palabras|strong="H1697"\w*, me senté y \w lloré|strong="H1058"\w*, y me lamenté durante varios \w días|strong="H3117"\w* y ayuné y \w oré|strong="H6419"\w* \w ante|strong="H6440"\w* \w el|strong="H3427"\w* Dios del \w cielo|strong="H8064"\w*,  
\v 5 y dije: “Te ruego, Yahvé, el \w Dios|strong="H3068"\w* del \w cielo|strong="H8064"\w*, el \w Dios|strong="H3068"\w* \w grande|strong="H1419"\w* y temible que \w guarda|strong="H8104"\w* el \w pacto|strong="H1285"\w* y \w la|strong="H8104"\w* bondad amorosa con los que lo aman y \w guardan|strong="H8104"\w* sus \w mandamientos|strong="H4687"\w*,  
\v 6 \w que|strong="H4994"\w* tu \w oído|strong="H8085"\w* \w esté|strong="H1961"\w* \w ahora|strong="H4994"\w* \w atento|strong="H7183"\w* \w y|strong="H5921"\w* tus \w ojos|strong="H5869"\w* \w abiertos|strong="H6605"\w*, \w para|strong="H5921"\w* \w que|strong="H4994"\w* escuches \w la|strong="H5921"\w* \w oración|strong="H8605"\w* \w de|strong="H5921"\w* tu \w siervo|strong="H5650"\w* \w que|strong="H4994"\w* \w hago|strong="H6419"\w* \w ante|strong="H6440"\w* \w ti|strong="H5921"\w* \w en|strong="H5921"\w* \w este|strong="H1961"\w* momento, \w de|strong="H5921"\w* \w día|strong="H3117"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w noche|strong="H3915"\w*, \w por|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* tus \w siervos|strong="H5650"\w*, mientras \w confieso|strong="H3034"\w* \w los|strong="H1121"\w* \w pecados|strong="H2403"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w que|strong="H4994"\w* hemos cometido \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*. \w Sí|strong="H4994"\w*, \w yo|strong="H4994"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* padre hemos \w pecado|strong="H2403"\w*.  
\v 7 Hemos actuado muy corruptamente contra ti, y \w no|strong="H3808"\w* hemos \w guardado|strong="H8104"\w* los \w mandamientos|strong="H4687"\w*, \w ni|strong="H3808"\w* los \w estatutos|strong="H2706"\w*, \w ni|strong="H3808"\w* las \w ordenanzas|strong="H2706"\w*, \w que|strong="H3808"\w* \w ordenaste|strong="H6680"\w* \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w Moisés|strong="H4872"\w*.   
\p
\v 8 “\w Acuérdate|strong="H2142"\w*, te \w lo|strong="H1697"\w* \w ruego|strong="H4994"\w*, \w de|strong="H1697"\w* la \w palabra|strong="H1697"\w* \w que|strong="H4994"\w* \w ordenaste|strong="H6680"\w* \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w Moisés|strong="H4872"\w*, diciendo: ‘\w Si|strong="H4994"\w* os desviáis, os dispersaré entre los \w pueblos|strong="H5971"\w*;  
\v 9 pero \w si|strong="H1961"\w* os \w volvéis|strong="H7725"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*, y guardáis mis \w mandamientos|strong="H4687"\w* y \w los|strong="H1961"\w* ponéis en práctica, \w aunque|strong="H8033"\w* vuestros desterrados \w estén|strong="H1961"\w* en \w el|strong="H6213"\w* \w extremo|strong="H7097"\w* de \w los|strong="H1961"\w* \w cielos|strong="H8064"\w*, \w yo|strong="H6213"\w* \w los|strong="H1961"\w* \w recogeré|strong="H6908"\w* de \w allí|strong="H8033"\w* y \w los|strong="H1961"\w* traeré al \w lugar|strong="H4725"\w* \w que|strong="H1961"\w* he elegido, \w para|strong="H1961"\w* \w hacer|strong="H6213"\w* habitar \w allí|strong="H8033"\w* \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w*’.   
\p
\v 10 “Ahora bien, \w estos|strong="H1992"\w* son tus \w siervos|strong="H5650"\w* y tu \w pueblo|strong="H5971"\w*, \w a|strong="H3068"\w* quienes has redimido con tu \w gran|strong="H1419"\w* \w poder|strong="H3027"\w* y con tu \w mano|strong="H3027"\w* \w fuerte|strong="H2389"\w*.  
\v 11 Señor, te \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* tu oído \w esté|strong="H2088"\w* \w atento|strong="H7183"\w* \w ahora|strong="H4994"\w* \w a|strong="H3068"\w* la \w oración|strong="H8605"\w* \w de|strong="H6440"\w* tu \w siervo|strong="H5650"\w*, y \w a|strong="H3068"\w* la \w oración|strong="H8605"\w* \w de|strong="H6440"\w* tus \w siervos|strong="H5650"\w* \w que|strong="H4994"\w* \w se|strong="H1961"\w* deleitan en temer tu \w nombre|strong="H8034"\w*; y \w por|strong="H6440"\w* favor, prospera \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w hoy|strong="H3117"\w*, y concédele misericordia \w ante|strong="H6440"\w* \w este|strong="H2088"\w* hombre.”  
\p \w Ahora|strong="H4994"\w* \w yo|strong="H4994"\w* \w era|strong="H1961"\w* portador \w de|strong="H6440"\w* la copa del \w rey|strong="H4428"\w*.   
\c 2
\p
\v 1 En el \w mes|strong="H2320"\w* \w de|strong="H6440"\w* Nisán, en el vigésimo \w año|strong="H8141"\w* del \w rey|strong="H4428"\w* Artajerjes, \w cuando|strong="H1961"\w* el \w vino|strong="H3196"\w* \w estaba|strong="H1961"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* él, recogí el \w vino|strong="H3196"\w* y \w se|strong="H1961"\w* \w lo|strong="H3808"\w* \w di|strong="H5414"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*. \w Nunca|strong="H3808"\w* \w antes|strong="H6440"\w* \w había|strong="H1961"\w* \w estado|strong="H1961"\w* \w triste|strong="H7451"\w* en su \w presencia|strong="H6440"\w*.  
\v 2 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w me|strong="H3588"\w* dijo: “¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* tienes \w el|strong="H3588"\w* \w rostro|strong="H6440"\w* \w triste|strong="H7451"\w*, \w ya|strong="H2088"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w estás|strong="H2088"\w* \w enfermo|strong="H2470"\w*? \w Esto|strong="H2088"\w* \w no|strong="H3588"\w* \w es|strong="H2088"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* tristeza \w de|strong="H3588"\w* \w corazón|strong="H3820"\w*”.  
\p \w Entonces|strong="H3588"\w* tuve \w mucho|strong="H3966"\w* \w miedo|strong="H3372"\w*.  
\v 3 Le dije \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: “¡\w Que|strong="H3808"\w* el \w rey|strong="H4428"\w* \w viva|strong="H2421"\w* para \w siempre|strong="H5769"\w*! ¿\w Por|strong="H4069"\w* \w qué|strong="H3808"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* \w de|strong="H6440"\w* estar triste mi \w rostro|strong="H6440"\w*, cuando la \w ciudad|strong="H5892"\w*, el lugar \w de|strong="H6440"\w* las tumbas \w de|strong="H6440"\w* mis padres, yace desolada, y sus \w puertas|strong="H8179"\w* han sido consumidas \w por|strong="H4069"\w* el fuego?”   
\p
\v 4 Entonces \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w me|strong="H5921"\w* dijo: “¿\w Cuál|strong="H4100"\w* \w es|strong="H2088"\w* tu petición?”  
\p Entonces \w oré|strong="H6419"\w* \w al|strong="H5921"\w* Dios \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*.  
\v 5 Dije \w al|strong="H5921"\w* \w rey|strong="H4428"\w*: “\w Si|strong="H6440"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H3190"\w*, \w y|strong="H5921"\w* \w si|strong="H6440"\w* tu \w siervo|strong="H5650"\w* ha hallado gracia \w ante|strong="H6440"\w* tus ojos, \w te|strong="H5921"\w* pido \w que|strong="H5921"\w* \w me|strong="H5921"\w* envíes \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* tumbas \w de|strong="H5921"\w* mis padres, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* construya.”   
\p
\v 6 \w El|strong="H3427"\w* \w rey|strong="H4428"\w* me dijo (la \w reina|strong="H4428"\w* también \w estaba|strong="H1961"\w* sentada junto \w a|strong="H3068"\w* \w él|strong="H3427"\w*): “¿Cuánto durará tu viaje? ¿\w Cuándo|strong="H4970"\w* \w volverás|strong="H7725"\w*?”  
\p Así \w pues|strong="H1961"\w*, \w el|strong="H3427"\w* \w rey|strong="H4428"\w* \w tuvo|strong="H1961"\w* \w a|strong="H3068"\w* \w bien|strong="H3190"\w* \w enviarme|strong="H7971"\w*, \w y|strong="H5704"\w* yo le fijé un plazo.  
\v 7 \w Además|strong="H5921"\w*, dije \w al|strong="H5921"\w* \w rey|strong="H4428"\w*: “\w Si|strong="H5921"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2895"\w*, \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w me|strong="H5921"\w* den cartas \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w gobernadores|strong="H6346"\w* \w del|strong="H5921"\w* otro \w lado|strong="H5676"\w* \w del|strong="H5921"\w* \w río|strong="H5104"\w*, \w para|strong="H5704"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* dejen \w pasar|strong="H5674"\w* \w hasta|strong="H5704"\w* \w que|strong="H5921"\w* llegue \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*;  
\v 8 \w y|strong="H5921"\w* una carta \w a|strong="H3068"\w* Asaf, guardián \w del|strong="H5921"\w* bosque \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* \w dé|strong="H5921"\w* \w madera|strong="H6086"\w* \w para|strong="H5921"\w* hacer vigas \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* ciudadela \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w templo|strong="H1004"\w*, \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w muro|strong="H2346"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w que|strong="H5921"\w* voy \w a|strong="H3068"\w* ocupar.”  
\p \w El|strong="H5921"\w* \w rey|strong="H4428"\w* accedió \w a|strong="H3068"\w* \w mis|strong="H5414"\w* peticiones, \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w buena|strong="H2896"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* Dios \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 9 Entonces llegué \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w gobernadores|strong="H6346"\w* \w del|strong="H5973"\w* otro \w lado|strong="H5676"\w* \w del|strong="H5973"\w* \w río|strong="H5104"\w* y \w les|strong="H5973"\w* \w entregué|strong="H5414"\w* las cartas \w del|strong="H5973"\w* \w rey|strong="H4428"\w*. \w El|strong="H5973"\w* \w rey|strong="H4428"\w* había \w enviado|strong="H7971"\w* \w conmigo|strong="H5973"\w* \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w capitanes|strong="H8269"\w* \w del|strong="H5973"\w* \w ejército|strong="H2428"\w* y \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w jinetes|strong="H6571"\w*.  
\v 10 \w Cuando|strong="H5650"\w* Sanbalat, \w el|strong="H1121"\w* \w horonita|strong="H2772"\w*, y \w Tobías|strong="H2900"\w*, \w el|strong="H1121"\w* \w siervo|strong="H5650"\w* amonita, \w se|strong="H1992"\w* enteraron \w de|strong="H1121"\w* esto, \w se|strong="H1992"\w* entristecieron \w mucho|strong="H1419"\w*, porque un \w hombre|strong="H1121"\w* había venido \w a|strong="H3068"\w* buscar \w el|strong="H1121"\w* bienestar \w de|strong="H1121"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.   
\p
\v 11 Llegué, \w pues|strong="H1961"\w*, \w a|strong="H3068"\w* Jerusalén y \w estuve|strong="H1961"\w* \w allí|strong="H8033"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*.  
\v 12 \w Me|strong="H3588"\w* levanté \w de|strong="H3588"\w* \w noche|strong="H3915"\w*, \w yo|strong="H3588"\w* \w y|strong="H3588"\w* algunos hombres \w conmigo|strong="H5973"\w*. \w No|strong="H3808"\w* dije \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w mi|strong="H3389"\w* Dios \w puso|strong="H5414"\w* \w en|strong="H5973"\w* \w mi|strong="H3389"\w* \w corazón|strong="H3820"\w* \w para|strong="H3588"\w* \w hacer|strong="H6213"\w* \w por|strong="H3588"\w* Jerusalén. \w No|strong="H3808"\w* \w me|strong="H3588"\w* acompañaba \w ningún|strong="H3808"\w* animal, excepto \w el|strong="H5973"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* montaba.  
\v 13 \w Salí|strong="H3318"\w* \w de|strong="H6440"\w* \w noche|strong="H3915"\w* \w por|strong="H6440"\w* la \w puerta|strong="H8179"\w* del \w valle|strong="H1516"\w* \w hacia|strong="H6440"\w* el pozo del chacal, y \w luego|strong="H3318"\w* \w hacia|strong="H6440"\w* la \w puerta|strong="H8179"\w* del estiércol; \w e|strong="H3068"\w* inspeccioné \w los|strong="H1961"\w* \w muros|strong="H2346"\w* \w de|strong="H6440"\w* Jerusalén, \w que|strong="H1961"\w* \w estaban|strong="H1961"\w* derrumbados, y sus \w puertas|strong="H8179"\w* consumidas \w por|strong="H6440"\w* el fuego.  
\v 14 \w Luego|strong="H5674"\w* seguí hasta la \w puerta|strong="H8179"\w* del manantial y hasta \w el|strong="H5674"\w* \w estanque|strong="H1295"\w* del \w rey|strong="H4428"\w*, pero no había \w lugar|strong="H4725"\w* para que \w pasara|strong="H5674"\w* \w el|strong="H5674"\w* animal que estaba \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* mí.  
\v 15 \w Luego|strong="H5927"\w* subí de \w noche|strong="H3915"\w* por el \w arroyo|strong="H5158"\w* \w e|strong="H3068"\w* inspeccioné la muralla; me \w volví|strong="H7725"\w* y entré por la \w puerta|strong="H8179"\w* del \w valle|strong="H1516"\w*, y así regresé.  
\v 16 Los jefes \w no|strong="H3808"\w* \w sabían|strong="H3045"\w* \w adónde|strong="H5704"\w* \w había|strong="H6213"\w* ido \w ni|strong="H3808"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w*. Todavía \w no|strong="H3808"\w* \w lo|strong="H4100"\w* \w había|strong="H6213"\w* contado \w a|strong="H3068"\w* los \w judíos|strong="H3064"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* los nobles, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* los gobernantes, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* los demás \w que|strong="H4100"\w* \w hacían|strong="H6213"\w* la \w obra|strong="H4399"\w*.   
\p
\v 17 Entonces les dije: “Vosotros \w veis|strong="H7200"\w* la \w mala|strong="H7451"\w* situación \w en|strong="H5750"\w* \w que|strong="H3808"\w* nos encontramos, \w cómo|strong="H1961"\w* Jerusalén yace desolada y sus \w puertas|strong="H8179"\w* \w están|strong="H1961"\w* \w quemadas|strong="H3341"\w* \w por|strong="H5750"\w* el fuego. Vengan, construyamos el \w muro|strong="H2346"\w* \w de|strong="H5750"\w* Jerusalén, \w para|strong="H1961"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w seamos|strong="H1961"\w* deshonrados”.  
\v 18 \w Les|strong="H5921"\w* \w hablé|strong="H1697"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* Dios, \w que|strong="H1931"\w* \w era|strong="H1931"\w* \w buena|strong="H2896"\w* conmigo, \w y|strong="H5921"\w* también \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w que|strong="H1931"\w* \w me|strong="H5921"\w* había \w dicho|strong="H1697"\w*.  
\p \w Dijeron|strong="H1697"\w*: “\w Levantémonos|strong="H6965"\w* \w y|strong="H5921"\w* construyamos”. \w Así|strong="H1931"\w* \w que|strong="H1931"\w* fortalecieron \w sus|strong="H1931"\w* \w manos|strong="H3027"\w* \w para|strong="H5921"\w* \w la|strong="H1931"\w* \w buena|strong="H2896"\w* \w obra|strong="H1931"\w*.   
\p
\v 19 Pero \w cuando|strong="H4100"\w* \w lo|strong="H1697"\w* \w oyeron|strong="H8085"\w* Sanbalat \w el|strong="H5921"\w* \w horonita|strong="H2772"\w*, \w Tobías|strong="H2900"\w* \w el|strong="H5921"\w* \w siervo|strong="H5650"\w* amonita \w y|strong="H5921"\w* Gesem \w el|strong="H5921"\w* árabe, \w se|strong="H5921"\w* burlaron \w de|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w y|strong="H5921"\w* \w nos|strong="H5921"\w* despreciaron, \w y|strong="H5921"\w* \w dijeron|strong="H1697"\w*: “¿\w Qué|strong="H4100"\w* \w es|strong="H2088"\w* \w esto|strong="H2088"\w* \w que|strong="H4100"\w* estáis \w haciendo|strong="H6213"\w*? ¿\w Os|strong="H5921"\w* vais \w a|strong="H3068"\w* rebelar \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*?”   
\p
\v 20 \w Entonces|strong="H7725"\w* les respondí y les dije: “\w El|strong="H1931"\w* Dios del \w cielo|strong="H8064"\w* nos \w prosperará|strong="H6743"\w*. \w Por|strong="H1697"\w* \w eso|strong="H1931"\w* \w nosotros|strong="H1931"\w*, \w sus|strong="H1931"\w* \w siervos|strong="H5650"\w*, nos levantaremos y construiremos; pero vosotros no tenéis \w parte|strong="H2506"\w*, ni \w derecho|strong="H6666"\w*, ni \w memoria|strong="H2146"\w* en Jerusalén.”   
\c 3
\p
\v 1 Entonces \w el|strong="H1992"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* Eliasib \w se|strong="H1992"\w* \w levantó|strong="H6965"\w* \w con|strong="H5704"\w* \w sus|strong="H1992"\w* hermanos \w sacerdotes|strong="H3548"\w*, \w y|strong="H5704"\w* construyeron la \w puerta|strong="H1817"\w* \w de|strong="H5704"\w* \w las|strong="H1992"\w* \w ovejas|strong="H6629"\w*. La santificaron \w y|strong="H5704"\w* \w levantaron|strong="H6965"\w* \w sus|strong="H1992"\w* \w puertas|strong="H1817"\w*. La santificaron \w hasta|strong="H5704"\w* la \w torre|strong="H4026"\w* \w de|strong="H5704"\w* Hammeah, \w hasta|strong="H5704"\w* la \w torre|strong="H4026"\w* \w de|strong="H5704"\w* Hananel.  
\v 2 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w* \w edificaron|strong="H1129"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H5921"\w* \w Jericó|strong="H3405"\w*. \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w* \w edificó|strong="H1129"\w* Zaccur, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Imri.   
\p
\v 3 \w Los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Hassenaah construyeron la \w puerta|strong="H1817"\w* del \w pescado|strong="H1709"\w*. Colocaron \w sus|strong="H1992"\w* vigas, y colocaron \w sus|strong="H1992"\w* \w puertas|strong="H1817"\w*, \w sus|strong="H1992"\w* \w cerrojos|strong="H1280"\w* y \w sus|strong="H1992"\w* \w barras|strong="H1280"\w*.  
\v 4 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w*, Meremot, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Urías, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Hakkoz, hizo \w las|strong="H5921"\w* reparaciones. \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w*, Mesulam \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Berequías, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Meshezabel, hizo reparaciones. \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w*, \w Sadoc|strong="H6659"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Baana hizo reparaciones.  
\v 5 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w*, \w los|strong="H5921"\w* tecoítas hacían reparaciones; pero sus nobles \w no|strong="H3808"\w* ponían \w el|strong="H5921"\w* \w cuello|strong="H6677"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* obra \w del|strong="H5921"\w* Señor.   
\p
\v 6 Joiada, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Paseah, y Meshullam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Besodeiah, \w repararon|strong="H2388"\w* la \w vieja|strong="H3465"\w* \w puerta|strong="H1817"\w*. Colocaron \w sus|strong="H1992"\w* vigas y levantaron \w sus|strong="H1992"\w* \w puertas|strong="H1817"\w*, \w sus|strong="H1992"\w* \w cerrojos|strong="H1280"\w* y \w sus|strong="H1992"\w* \w barras|strong="H1280"\w*.  
\v 7 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w*, Melatiá \w el|strong="H5921"\w* \w gabaonita|strong="H1393"\w* \w y|strong="H5921"\w* Jadón \w el|strong="H5921"\w* meronita, hombres \w de|strong="H5921"\w* \w Gabaón|strong="H1391"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Mizpa|strong="H4709"\w*, \w repararon|strong="H2388"\w* \w la|strong="H5921"\w* residencia \w del|strong="H5921"\w* \w gobernador|strong="H6346"\w* \w al|strong="H5921"\w* otro \w lado|strong="H5676"\w* \w del|strong="H5921"\w* \w río|strong="H5104"\w*.  
\v 8 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w*, Uziel \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Harhaiah, orfebres, hizo reparaciones. \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w*, \w Hananías|strong="H2608"\w*, uno \w de|strong="H5921"\w* \w los|strong="H1121"\w* perfumistas, hizo reparaciones, \w y|strong="H5921"\w* fortificaron Jerusalén \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w ancho|strong="H7342"\w* \w muro|strong="H2346"\w*.  
\v 9 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w*, Refaías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Hur|strong="H2354"\w*, \w jefe|strong="H8269"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* mitad \w del|strong="H5921"\w* distrito \w de|strong="H5921"\w* Jerusalén, hizo reparaciones.  
\v 10 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w*, \w Jedaías|strong="H3042"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Harumaf hizo reparaciones \w frente|strong="H5048"\w* \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*. \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w*, Hattush \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Hasabneías hizo reparaciones.  
\v 11 Malquías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Harim|strong="H2766"\w* y Hasub \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Pahatmoab \w repararon|strong="H2388"\w* \w otra|strong="H8145"\w* parte y la \w torre|strong="H4026"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* hornos.  
\v 12 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H1931"\w*, Salum \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Hallohesh, \w jefe|strong="H8269"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* mitad \w del|strong="H5921"\w* distrito \w de|strong="H5921"\w* Jerusalén, \w él|strong="H1931"\w* \w y|strong="H5921"\w* \w sus|strong="H1931"\w* \w hijas|strong="H1323"\w* hicieron reparaciones.   
\p
\v 13 \w Hanun|strong="H2586"\w* \w y|strong="H5704"\w* \w los|strong="H1992"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5704"\w* Zanoa \w repararon|strong="H2388"\w* la \w puerta|strong="H1817"\w* del \w valle|strong="H1516"\w*. La construyeron \w y|strong="H5704"\w* colocaron \w sus|strong="H1992"\w* \w puertas|strong="H1817"\w*, \w sus|strong="H1992"\w* \w cerrojos|strong="H1280"\w* \w y|strong="H5704"\w* \w sus|strong="H1992"\w* \w barras|strong="H1280"\w*, \w y|strong="H5704"\w* mil codos \w de|strong="H5704"\w* la muralla \w hasta|strong="H5704"\w* la \w puerta|strong="H1817"\w* del estiércol.   
\p
\v 14 Malquías, \w hijo|strong="H1121"\w* \w de|strong="H8269"\w* Recab, \w jefe|strong="H8269"\w* del distrito \w de|strong="H8269"\w* Bet Haccherem, \w reparó|strong="H1129"\w* \w la|strong="H1931"\w* \w puerta|strong="H1817"\w* del estiércol. \w La|strong="H1931"\w* construyó y colocó \w sus|strong="H1931"\w* \w puertas|strong="H1817"\w*, \w sus|strong="H1931"\w* \w cerrojos|strong="H1280"\w* y \w sus|strong="H1931"\w* \w barras|strong="H1280"\w*.   
\p
\v 15 Salún \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* Colhoze, \w jefe|strong="H8269"\w* del distrito \w de|strong="H5704"\w* \w Mizpa|strong="H4709"\w*, \w reparó|strong="H1129"\w* \w la|strong="H1931"\w* \w puerta|strong="H1817"\w* del manantial. \w La|strong="H1931"\w* \w edificó|strong="H1129"\w*, \w la|strong="H1931"\w* \w cubrió|strong="H1129"\w* \w y|strong="H5704"\w* levantó \w sus|strong="H1931"\w* \w puertas|strong="H1817"\w*, \w sus|strong="H1931"\w* \w cerrojos|strong="H1280"\w* \w y|strong="H5704"\w* \w sus|strong="H1931"\w* rejas; \w y|strong="H5704"\w* \w reparó|strong="H1129"\w* \w el|strong="H1931"\w* \w muro|strong="H2346"\w* del \w estanque|strong="H1295"\w* \w de|strong="H5704"\w* Sala, junto \w al|strong="H5704"\w* jardín del \w rey|strong="H4428"\w*, \w hasta|strong="H5704"\w* \w la|strong="H1931"\w* escalera \w que|strong="H1931"\w* \w baja|strong="H3381"\w* \w de|strong="H5704"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w de|strong="H5704"\w* \w David|strong="H1732"\w*.  
\v 16 \w Después|strong="H5704"\w* \w de|strong="H5048"\w* \w él|strong="H6213"\w*, \w Nehemías|strong="H5166"\w* \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Azbuk, \w jefe|strong="H8269"\w* \w de|strong="H5048"\w* la mitad \w del|strong="H2677"\w* distrito \w de|strong="H5048"\w* Bet Zur, \w hizo|strong="H6213"\w* reparaciones \w en|strong="H5704"\w* \w el|strong="H6213"\w* lugar \w frente|strong="H5048"\w* \w a|strong="H3068"\w* las tumbas \w de|strong="H5048"\w* \w David|strong="H1732"\w*, \w en|strong="H5704"\w* \w el|strong="H6213"\w* \w estanque|strong="H1295"\w* \w que|strong="H5704"\w* se \w hizo|strong="H6213"\w* \w y|strong="H5704"\w* \w en|strong="H5704"\w* la \w casa|strong="H1004"\w* \w de|strong="H5048"\w* \w los|strong="H1121"\w* \w valientes|strong="H1368"\w*.  
\v 17 \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*, \w los|strong="H1121"\w* levitas-Rehum, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Bani|strong="H1137"\w*, hicieron reparaciones. \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*, \w Hasabías|strong="H2811"\w*, \w jefe|strong="H8269"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* mitad \w del|strong="H5921"\w* distrito \w de|strong="H5921"\w* \w Keila|strong="H7084"\w*, hizo reparaciones \w en|strong="H5921"\w* su distrito.  
\v 18 Después \w de|strong="H8269"\w* \w él|strong="H1121"\w*, sus hermanos, Bavvai \w hijo|strong="H1121"\w* \w de|strong="H8269"\w* Henadad, gobernante \w de|strong="H8269"\w* la mitad \w del|strong="H2677"\w* distrito \w de|strong="H8269"\w* \w Keila|strong="H7084"\w*, hizo reparaciones.  
\v 19 \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*, \w Ezer|strong="H5829"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Jesúa|strong="H3442"\w*, gobernante \w de|strong="H5921"\w* \w Mizpa|strong="H4709"\w*, reparó \w otra|strong="H8145"\w* porción \w al|strong="H5921"\w* \w otro|strong="H8145"\w* \w lado|strong="H8145"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* subida \w a|strong="H3068"\w* \w la|strong="H5921"\w* armería, \w en|strong="H5921"\w* \w el|strong="H5921"\w* recodo \w de|strong="H5921"\w* \w la|strong="H5921"\w* muralla.  
\v 20 \w Después|strong="H5704"\w* \w de|strong="H4480"\w* \w él|strong="H1121"\w*, Baruc \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Zabbai reparó \w con|strong="H4480"\w* empeño \w otra|strong="H8145"\w* parte, \w desde|strong="H4480"\w* la vuelta \w de|strong="H4480"\w* la muralla \w hasta|strong="H5704"\w* la \w puerta|strong="H6607"\w* \w de|strong="H4480"\w* la \w casa|strong="H1004"\w* \w del|strong="H4480"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* Eliasib.  
\v 21 \w Después|strong="H5704"\w* \w de|strong="H5704"\w* \w él|strong="H1121"\w*, Meremot, \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* Urías, \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* Hakkoz, reparó \w otra|strong="H8145"\w* parte, \w desde|strong="H5704"\w* la \w puerta|strong="H6607"\w* \w de|strong="H5704"\w* la \w casa|strong="H1004"\w* \w de|strong="H5704"\w* Eliasib \w hasta|strong="H5704"\w* \w el|strong="H1121"\w* final \w de|strong="H5704"\w* la \w casa|strong="H1004"\w* \w de|strong="H5704"\w* Eliashib.  
\v 22 Después de él, los \w sacerdotes|strong="H3548"\w*, los hombres de los alrededores hicieron las reparaciones.  
\v 23 Después \w de|strong="H5048"\w* ellos, \w Benjamín|strong="H1144"\w* y Jasub hicieron reparaciones al otro lado \w de|strong="H5048"\w* su \w casa|strong="H1004"\w*. Después \w de|strong="H5048"\w* ellos, \w Azarías|strong="H5838"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* \w Maasías|strong="H4641"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Ananías, hizo reparaciones junto \w a|strong="H3068"\w* su propia \w casa|strong="H1004"\w*.  
\v 24 \w Después|strong="H5704"\w* \w de|strong="H5704"\w* \w él|strong="H1121"\w*, \w Binnui|strong="H1131"\w* \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* Henadad reparó \w otra|strong="H8145"\w* parte, \w desde|strong="H5704"\w* la \w casa|strong="H1004"\w* \w de|strong="H5704"\w* \w Azarías|strong="H5838"\w* \w hasta|strong="H5704"\w* la vuelta del muro \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* la esquina.  
\v 25 Palal \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Uzai reparó \w frente|strong="H5048"\w* \w a|strong="H3068"\w* la curva del muro y la \w torre|strong="H4026"\w* \w que|strong="H2691"\w* sobresale \w de|strong="H5048"\w* la \w casa|strong="H1004"\w* superior del \w rey|strong="H4428"\w*, \w que|strong="H2691"\w* está junto \w al|strong="H4428"\w* \w patio|strong="H2691"\w* \w de|strong="H5048"\w* la guardia. Después \w de|strong="H5048"\w* \w él|strong="H1121"\w*, Pedaías, \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Paros, hizo las reparaciones.  
\v 26 (\w Los|strong="H3427"\w* servidores del templo \w vivían|strong="H3427"\w* \w en|strong="H5704"\w* Ofel, \w en|strong="H5704"\w* \w el|strong="H3427"\w* lugar \w que|strong="H5704"\w* \w está|strong="H1961"\w* \w frente|strong="H5048"\w* \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* \w de|strong="H5048"\w* las \w aguas|strong="H4325"\w*, hacia \w el|strong="H3427"\w* \w oriente|strong="H4217"\w*, \w y|strong="H5704"\w* \w en|strong="H5704"\w* la \w torre|strong="H4026"\w* \w que|strong="H5704"\w* sobresale).  
\v 27 \w Después|strong="H5704"\w* \w de|strong="H5048"\w* él, los tecoítas \w repararon|strong="H2388"\w* \w otra|strong="H8145"\w* parte, \w frente|strong="H5048"\w* \w a|strong="H3068"\w* la \w gran|strong="H1419"\w* \w torre|strong="H4026"\w* \w que|strong="H5704"\w* sobresale, \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* el \w muro|strong="H2346"\w* \w de|strong="H5048"\w* Ofel.   
\p
\v 28 \w Encima|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w caballos|strong="H5483"\w*, \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* hacían reparaciones, cada uno \w frente|strong="H5048"\w* \w a|strong="H3068"\w* su propia \w casa|strong="H1004"\w*.  
\v 29 Después \w de|strong="H5048"\w* ellos, \w Sadoc|strong="H6659"\w* \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Immer hacía las reparaciones \w frente|strong="H5048"\w* \w a|strong="H3068"\w* su propia \w casa|strong="H1004"\w*. Después \w de|strong="H5048"\w* \w él|strong="H1121"\w*, \w Semaías|strong="H8098"\w* \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Secanías, guardián \w de|strong="H5048"\w* \w la|strong="H8104"\w* \w puerta|strong="H8179"\w* \w oriental|strong="H4217"\w*, hizo reparaciones.  
\v 30 \w Después|strong="H8145"\w* \w de|strong="H5048"\w* \w él|strong="H1121"\w*, \w Hananías|strong="H2608"\w* \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Selemías y \w Hanún|strong="H2586"\w*, \w sexto|strong="H8345"\w* \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Zalaf, \w repararon|strong="H2388"\w* \w otra|strong="H8145"\w* \w parte|strong="H8345"\w*. \w Después|strong="H8145"\w* \w de|strong="H5048"\w* \w él|strong="H1121"\w*, Mesulam \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Berequías hizo reparaciones \w frente|strong="H5048"\w* \w a|strong="H3068"\w* su habitación.  
\v 31 \w Después|strong="H5704"\w* \w de|strong="H5048"\w* \w él|strong="H1121"\w*, Malquías, uno \w de|strong="H5048"\w* \w los|strong="H1121"\w* orfebres \w de|strong="H5048"\w* la \w casa|strong="H1004"\w* \w de|strong="H5048"\w* \w los|strong="H1121"\w* servidores del \w templo|strong="H1004"\w*, \w y|strong="H5704"\w* \w de|strong="H5048"\w* \w los|strong="H1121"\w* mercaderes, hizo reparaciones \w frente|strong="H5048"\w* \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* \w de|strong="H5048"\w* Hamifcad \w y|strong="H5704"\w* \w a|strong="H3068"\w* la subida \w de|strong="H5048"\w* la esquina.  
\v 32 Entre la subida de la esquina y la \w puerta|strong="H8179"\w* de las \w ovejas|strong="H6629"\w*, los orfebres y los mercaderes hicieron reparaciones.   
\c 4
\p
\v 1 \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* Sanbalat \w se|strong="H1961"\w* enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* estábamos construyendo \w el|strong="H3588"\w* \w muro|strong="H2346"\w*, \w se|strong="H1961"\w* enojó \w y|strong="H3588"\w* \w se|strong="H1961"\w* indignó \w mucho|strong="H3966"\w*, \w y|strong="H3588"\w* \w se|strong="H1961"\w* burló \w de|strong="H3588"\w* \w los|strong="H3588"\w* judíos.  
\v 2 Habló ante sus hermanos y \w el|strong="H3605"\w* ejército \w de|strong="H3898"\w* Samaria y dijo: “¿\w Qué|strong="H3605"\w* \w hacen|strong="H6213"\w* \w estos|strong="H3605"\w* débiles judíos? ¿Se van \w a|strong="H3068"\w* fortificar? ¿\w Sacrificarán|strong="H6213"\w*? ¿Acabarán en \w un|strong="H3162"\w* día? ¿Revivirán las piedras \w de|strong="H3898"\w* \w los|strong="H3605"\w* montones \w de|strong="H3898"\w* basura, ya \w que|strong="H3605"\w* están quemadas?”   
\p
\v 3 \w Junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w* \w estaba|strong="H5975"\w* Tobías, \w el|strong="H5921"\w* amonita, quien dijo: “\w Lo|strong="H5921"\w* \w que|strong="H5921"\w* están construyendo, \w si|strong="H6440"\w* una zorra trepara \w por|strong="H5921"\w* \w él|strong="H5921"\w*, derribaría su muro \w de|strong="H5921"\w* piedra.”   
\p
\v 4 “Escucha, Dios nuestro, \w porque|strong="H3808"\w* somos despreciados. Vuelve su reproche sobre su propia cabeza. Entrégalos como botín en \w tierra|strong="H6083"\w* de cautiverio.  
\v 5 \w No|strong="H3808"\w* cubras su iniquidad. \w No|strong="H3808"\w* permitas \w que|strong="H3808"\w* su pecado sea borrado ante ti; \w porque|strong="H3808"\w* han insultado \w a|strong="H3068"\w* los constructores.”   
\p
\v 6 Construimos, \w pues|strong="H1961"\w*, \w el|strong="H5921"\w* muro, \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* muralla \w se|strong="H1961"\w* unió \w hasta|strong="H5921"\w* \w la|strong="H5921"\w* mitad \w de|strong="H5921"\w* su altura, \w porque|strong="H5921"\w* \w el|strong="H5921"\w* pueblo \w tenía|strong="H1961"\w* ganas \w de|strong="H5921"\w* trabajar.   
\p
\v 7 Pero cuando Sanbalat, Tobías, \w los|strong="H5973"\w* árabes, \w los|strong="H5973"\w* amonitas y \w los|strong="H5973"\w* asdoditas \w se|strong="H5971"\w* enteraron \w de|strong="H5973"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* \w había|strong="H5975"\w* avanzado \w en|strong="H5973"\w* la reparación \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w muros|strong="H2346"\w* \w de|strong="H5973"\w* Jerusalén y \w de|strong="H5973"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* empezaban \w a|strong="H3068"\w* rellenar las brechas, \w se|strong="H5971"\w* enfurecieron mucho;  
\v 8 \w y|strong="H5921"\w* todos \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* conjuraron \w para|strong="H5921"\w* venir \w a|strong="H3068"\w* pelear \w contra|strong="H5921"\w* Jerusalén \w y|strong="H5921"\w* causar confusión \w entre|strong="H5921"\w* \w nosotros|strong="H5921"\w*.  
\v 9 \w Pero|strong="H3588"\w* \w nosotros|strong="H3605"\w* hicimos nuestra oración \w a|strong="H3068"\w* nuestro Dios, \w y|strong="H3588"\w* pusimos guardia \w contra|strong="H1961"\w* \w ellos|strong="H3605"\w* día \w y|strong="H3588"\w* noche \w a|strong="H3068"\w* causa \w de|strong="H3588"\w* \w ellos|strong="H3605"\w*.   
\p
\v 10 \w Judá|strong="H3063"\w* dijo: “\w La|strong="H1931"\w* fuerza \w de|strong="H4480"\w* \w los|strong="H3605"\w* portadores \w de|strong="H4480"\w* cargas \w se|strong="H1961"\w* desvanece y \w hay|strong="H1961"\w* muchos escombros, \w de|strong="H4480"\w* modo \w que|strong="H4480"\w* \w no|strong="H6213"\w* podemos construir \w el|strong="H1931"\w* muro”.  
\v 11 Nuestros adversarios dijeron: “\w No|strong="H6213"\w* \w lo|strong="H6213"\w* sabrán ni \w lo|strong="H6213"\w* verán, hasta \w que|strong="H3027"\w* entremos en \w medio|strong="H3027"\w* de \w ellos|strong="H3027"\w* y los matemos, y \w hagamos|strong="H6213"\w* cesar la \w obra|strong="H4399"\w*.”   
\p
\v 12 Cuando llegaron \w los|strong="H5921"\w* judíos \w que|strong="H5921"\w* vivían \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H5921"\w*, \w nos|strong="H5921"\w* dijeron diez veces \w desde|strong="H5921"\w* todos \w los|strong="H5921"\w* lugares: “Dondequiera \w que|strong="H5921"\w* \w os|strong="H5921"\w* volváis, \w nos|strong="H5921"\w* atacarán”.   
\p
\v 13 \w Por|strong="H5921"\w* eso puse guardias \w en|strong="H5921"\w* \w las|strong="H5921"\w* partes \w más|strong="H7235"\w* bajas \w del|strong="H5921"\w* espacio detrás \w de|strong="H5921"\w* \w la|strong="H5921"\w* muralla, \w en|strong="H5921"\w* \w los|strong="H5921"\w* lugares abiertos. Puse \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w por|strong="H5921"\w* grupos familiares \w con|strong="H5921"\w* sus espadas, sus lanzas \w y|strong="H5921"\w* sus arcos.  
\v 14 Miré, me levanté y dije \w a|strong="H3068"\w* los nobles, \w a|strong="H3068"\w* los gobernantes y al resto del pueblo: “¡No tengan miedo \w de|strong="H3898"\w* ellos! Acuérdense del Señor, que es grande y temible, y luchen por sus hermanos, sus hijos, sus hijas, sus esposas y sus casas”.   
\p
\v 15 \w Cuando|strong="H5704"\w* nuestros enemigos se enteraron \w de|strong="H5704"\w* \w que|strong="H5704"\w* habíamos sido informados, \w y|strong="H5704"\w* \w de|strong="H5704"\w* \w que|strong="H5704"\w* Dios \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* fracasar su consejo, todos nosotros volvimos \w al|strong="H5704"\w* muro, cada uno \w a|strong="H3068"\w* su trabajo.  
\v 16 Desde \w entonces|strong="H3117"\w*, \w la|strong="H1931"\w* \w mitad|strong="H8432"\w* \w de|strong="H5971"\w* mis siervos hacía \w el|strong="H1931"\w* trabajo, \w y|strong="H1571"\w* \w la|strong="H1931"\w* otra \w mitad|strong="H8432"\w* \w tenía|strong="H1961"\w* las lanzas, \w los|strong="H1961"\w* escudos, \w los|strong="H1961"\w* arcos \w y|strong="H1571"\w* las cotas \w de|strong="H5971"\w* malla; \w y|strong="H1571"\w* \w los|strong="H1961"\w* jefes \w estaban|strong="H1961"\w* detrás \w de|strong="H5971"\w* toda \w la|strong="H1931"\w* casa \w de|strong="H5971"\w* Judá.  
\v 17 Los \w que|strong="H4325"\w* construían el muro y los \w que|strong="H4325"\w* llevaban cargas se cargaban; cada uno con una \w de|strong="H4325"\w* sus manos hacía el trabajo y con la otra sostenía su arma.  
\v 18 Entre los constructores, todos llevaban su espada al costado, y así construían. El que tocaba la trompeta estaba junto \w a|strong="H3068"\w* mí.  
\v 19 Dije \w a|strong="H3068"\w* los nobles, \w a|strong="H3068"\w* los jefes y al resto del pueblo: “La obra es grande y está muy extendida, y nosotros estamos separados en el muro, lejos unos de otros.  
\v 20 Dondequiera que oigáis el sonido de la trompeta, reuníos allí con nosotros. Nuestro Dios luchará por nosotros”.   
\p
\v 21 Así hicimos el trabajo. La mitad del pueblo sostuvo las lanzas desde el amanecer hasta que aparecieron las estrellas.  
\v 22 Asimismo, al mismo tiempo dije al pueblo: “Que cada uno con su siervo se aloje dentro de Jerusalén, para que durante la noche nos sirvan de guardia y para que trabajen durante el día.”  
\v 23 Así que ni yo, ni mis hermanos, ni mis siervos, ni los hombres de la guardia que me seguían nos quitamos la ropa. Cada uno llevó su arma al agua.   
\c 5
\p
\v 1 Entonces \w se|strong="H1961"\w* levantó un \w gran|strong="H1419"\w* \w clamor|strong="H6818"\w* del \w pueblo|strong="H5971"\w* y \w de|strong="H5971"\w* sus mujeres \w contra|strong="H1961"\w* sus hermanos \w los|strong="H1961"\w* \w judíos|strong="H3064"\w*.  
\v 2 Porque \w había|strong="H3426"\w* algunos \w que|strong="H1121"\w* decían: “Nosotros, nuestros \w hijos|strong="H1121"\w* y nuestras \w hijas|strong="H1323"\w*, somos \w muchos|strong="H7227"\w*. Consigamos \w grano|strong="H1715"\w*, para comer y \w vivir|strong="H2421"\w*”.  
\v 3 También \w había|strong="H3426"\w* algunos que decían: “Estamos hipotecando nuestros \w campos|strong="H7704"\w*, nuestras \w viñas|strong="H3754"\w* y nuestras \w casas|strong="H1004"\w*. Consigamos \w grano|strong="H1715"\w*, \w a|strong="H3068"\w* causa del \w hambre|strong="H7458"\w*”.  
\v 4 Hubo también algunos que dijeron: “Hemos pedido \w dinero|strong="H3701"\w* prestado para el tributo del \w rey|strong="H4428"\w* usando nuestros \w campos|strong="H7704"\w* y nuestras \w viñas|strong="H3754"\w* como garantía.  
\v 5 Pero \w ahora|strong="H6258"\w* nuestra \w carne|strong="H1320"\w* \w es|strong="H3426"\w* como la \w carne|strong="H1320"\w* \w de|strong="H1121"\w* nuestros hermanos, nuestros \w hijos|strong="H1121"\w* como sus \w hijos|strong="H1121"\w*. He \w aquí|strong="H2009"\w*, traemos \w a|strong="H3068"\w* nuestros \w hijos|strong="H1121"\w* y \w a|strong="H3068"\w* nuestras \w hijas|strong="H1323"\w* \w a|strong="H3068"\w* la esclavitud \w para|strong="H6258"\w* ser \w siervos|strong="H5650"\w*, y algunas \w de|strong="H1121"\w* nuestras \w hijas|strong="H1323"\w* han sido traídas \w a|strong="H3068"\w* la esclavitud. Tampoco \w está|strong="H3426"\w* en nuestro \w poder|strong="H3027"\w* evitarlo, \w porque|strong="H2009"\w* otros \w hombres|strong="H1121"\w* \w tienen|strong="H3426"\w* nuestros \w campos|strong="H7704"\w* y nuestras \w viñas|strong="H3754"\w*.”   
\p
\v 6 Me enojé \w mucho|strong="H3966"\w* al \w oír|strong="H8085"\w* su \w clamor|strong="H2201"\w* y estas \w palabras|strong="H1697"\w*.  
\v 7 Entonces consulté conmigo mismo \w y|strong="H5921"\w* discutí \w con|strong="H5921"\w* \w los|strong="H5921"\w* nobles \w y|strong="H5921"\w* \w los|strong="H5921"\w* gobernantes, \w y|strong="H5921"\w* \w les|strong="H5921"\w* dije: “Ustedes exigen usura, cada uno \w a|strong="H3068"\w* su hermano”. Celebré una \w gran|strong="H1419"\w* asamblea \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 8 Les dije: “Nosotros, \w según|strong="H1767"\w* nuestra capacidad, hemos redimido \w a|strong="H3068"\w* nuestros hermanos los \w judíos|strong="H3064"\w* \w que|strong="H3808"\w* fueron \w vendidos|strong="H4376"\w* \w a|strong="H3068"\w* las \w naciones|strong="H1471"\w*; ¿\w y|strong="H1571"\w* vosotros queréis incluso vender \w a|strong="H3068"\w* vuestros hermanos, \w y|strong="H1571"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* nos vendan \w a|strong="H3068"\w* nosotros?” \w Entonces|strong="H1571"\w* callaron, \w y|strong="H1571"\w* \w no|strong="H3808"\w* \w hallaron|strong="H4672"\w* \w palabra|strong="H1697"\w* \w que|strong="H3808"\w* decir.  
\v 9 También dije: “\w Lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hacéis|strong="H6213"\w* \w no|strong="H3808"\w* \w es|strong="H1697"\w* \w bueno|strong="H2896"\w*. ¿\w No|strong="H3808"\w* debéis \w andar|strong="H3212"\w* \w en|strong="H3212"\w* \w el|strong="H6213"\w* \w temor|strong="H3374"\w* \w de|strong="H1697"\w* nuestro Dios \w a|strong="H3068"\w* \w causa|strong="H1697"\w* del \w oprobio|strong="H2781"\w* \w de|strong="H1697"\w* las \w naciones|strong="H1471"\w*, nuestros enemigos?  
\v 10 \w Asimismo|strong="H1571"\w*, mis hermanos \w y|strong="H1571"\w* mis siervos les prestan \w dinero|strong="H3701"\w* \w y|strong="H1571"\w* \w grano|strong="H1715"\w*. \w Por|strong="H2088"\w* favor, detengamos \w esta|strong="H2088"\w* usura.  
\v 11 Por favor, devuélveles \w hoy|strong="H3117"\w* mismo sus \w campos|strong="H7704"\w*, sus viñedos, sus \w olivares|strong="H2132"\w* y sus \w casas|strong="H1004"\w*, también la centésima parte del \w dinero|strong="H3701"\w* y del \w grano|strong="H1715"\w*, del \w vino|strong="H8492"\w* nuevo y del \w aceite|strong="H3323"\w* \w que|strong="H4994"\w* les estás cobrando.”   
\p
\v 12 \w Entonces|strong="H3651"\w* \w dijeron|strong="H1697"\w*: “\w Los|strong="H1992"\w* restauraremos y \w no|strong="H3808"\w* \w les|strong="H1992"\w* exigiremos \w nada|strong="H3808"\w*. \w Lo|strong="H1697"\w* \w haremos|strong="H6213"\w* \w así|strong="H3651"\w*, \w como|strong="H3651"\w* \w tú|strong="H6213"\w* \w dices|strong="H1697"\w*”.  
\p \w Entonces|strong="H3651"\w* \w llamé|strong="H7121"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w* y \w les|strong="H1992"\w* tomé juramento \w de|strong="H1697"\w* \w que|strong="H3808"\w* cumplirían \w esta|strong="H2088"\w* promesa.  
\v 13 \w También|strong="H1571"\w* \w sacudí|strong="H5287"\w* \w mi|strong="H1961"\w* regazo, \w y|strong="H1571"\w* dije: “\w Así|strong="H3602"\w* \w sacuda|strong="H5287"\w* \w Dios|strong="H3068"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* hombre \w de|strong="H1697"\w* su \w casa|strong="H1004"\w* \w y|strong="H1571"\w* \w de|strong="H1697"\w* su \w trabajo|strong="H3018"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w cumpla|strong="H6965"\w* \w esta|strong="H2088"\w* promesa; incluso \w que|strong="H3808"\w* \w sea|strong="H1961"\w* \w sacudido|strong="H5287"\w* \w y|strong="H1571"\w* vaciado \w así|strong="H3602"\w*.”  
\p \w Toda|strong="H3605"\w* \w la|strong="H1571"\w* asamblea dijo: “Amén”, \w y|strong="H1571"\w* alabó \w a|strong="H3068"\w* Yahvé. \w El|strong="H3605"\w* \w pueblo|strong="H5971"\w* cumplió \w esta|strong="H2088"\w* promesa.   
\p
\v 14 \w Además|strong="H1571"\w*, \w desde|strong="H5704"\w* \w que|strong="H3808"\w* \w fui|strong="H1961"\w* designado \w para|strong="H5704"\w* ser su \w gobernador|strong="H6346"\w* \w en|strong="H5704"\w* \w la|strong="H1571"\w* tierra \w de|strong="H5704"\w* \w Judá|strong="H3063"\w*, \w desde|strong="H5704"\w* \w el|strong="H1571"\w* \w año|strong="H8141"\w* \w veinte|strong="H6242"\w* \w hasta|strong="H5704"\w* \w el|strong="H1571"\w* \w año|strong="H8141"\w* \w treinta|strong="H7970"\w* \w y|strong="H1571"\w* \w dos|strong="H8147"\w* del \w rey|strong="H4428"\w* Artajerjes, \w es|strong="H1961"\w* decir, \w doce|strong="H8147"\w* \w años|strong="H8141"\w*, \w ni|strong="H3808"\w* \w yo|strong="H6680"\w* \w ni|strong="H3808"\w* mis hermanos hemos comido \w el|strong="H1571"\w* \w pan|strong="H3899"\w* del \w gobernador|strong="H6346"\w*.  
\v 15 Pero \w los|strong="H1992"\w* anteriores \w gobernadores|strong="H6346"\w* \w que|strong="H3808"\w* \w me|strong="H5921"\w* precedieron \w eran|strong="H3808"\w* mantenidos \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w y|strong="H1571"\w* tomaban \w de|strong="H5921"\w* \w ellos|strong="H1992"\w* \w pan|strong="H3899"\w* \w y|strong="H1571"\w* \w vino|strong="H3196"\w*, \w más|strong="H1571"\w* cuarenta \w siclos|strong="H8255"\w* \w de|strong="H5921"\w* \w plata|strong="H3701"\w*; \w sí|strong="H1571"\w*, incluso \w sus|strong="H1992"\w* siervos \w gobernaban|strong="H5921"\w* \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w*, pero \w yo|strong="H6213"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w hice|strong="H6213"\w*, \w por|strong="H5921"\w* \w temor|strong="H3374"\w* \w a|strong="H3068"\w* Dios.  
\v 16 \w Sí|strong="H1571"\w*, yo \w también|strong="H1571"\w* continué \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w obra|strong="H4399"\w* \w de|strong="H5921"\w* \w este|strong="H2063"\w* \w muro|strong="H2346"\w*. \w No|strong="H3808"\w* \w compramos|strong="H7069"\w* \w ninguna|strong="H3605"\w* tierra. \w Todos|strong="H3605"\w* mis siervos \w se|strong="H3808"\w* reunieron \w allí|strong="H8033"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w obra|strong="H4399"\w*.  
\v 17 \w Además|strong="H5921"\w*, había \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w mesa|strong="H7979"\w*, \w de|strong="H4480"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w y|strong="H5921"\w* \w de|strong="H4480"\w* \w los|strong="H5921"\w* gobernantes, \w ciento|strong="H3967"\w* \w cincuenta|strong="H2572"\w* hombres, \w además|strong="H5921"\w* \w de|strong="H4480"\w* \w los|strong="H5921"\w* \w que|strong="H4480"\w* vinieron \w a|strong="H3068"\w* \w nosotros|strong="H5921"\w* \w de|strong="H4480"\w* \w entre|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w que|strong="H4480"\w* estaban \w alrededor|strong="H5439"\w*.  
\v 18 \w Lo|strong="H3808"\w* \w que|strong="H3588"\w* \w se|strong="H1961"\w* preparó \w para|strong="H5921"\w* un \w día|strong="H3117"\w* \w fue|strong="H1961"\w* un \w buey|strong="H7794"\w* \w y|strong="H3588"\w* \w seis|strong="H8337"\w* \w ovejas|strong="H6629"\w* selectas. \w También|strong="H2088"\w* \w se|strong="H1961"\w* \w me|strong="H5921"\w* prepararon aves \w de|strong="H5921"\w* corral, \w y|strong="H3588"\w* una vez \w cada|strong="H3605"\w* \w diez|strong="H6235"\w* \w días|strong="H3117"\w* una reserva \w de|strong="H5921"\w* \w toda|strong="H3605"\w* clase \w de|strong="H5921"\w* \w vino|strong="H3196"\w*. \w Pero|strong="H3588"\w* \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w esto|strong="H2088"\w* \w no|strong="H3808"\w* exigí \w la|strong="H5921"\w* paga \w del|strong="H5921"\w* \w gobernador|strong="H6346"\w*, \w porque|strong="H3588"\w* \w la|strong="H5921"\w* esclavitud \w era|strong="H1961"\w* pesada \w para|strong="H5921"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*.  
\v 19 \w Acuérdate|strong="H2142"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*, Dios \w mío|strong="H5921"\w*, \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w bien|strong="H2896"\w* \w que|strong="H5921"\w* he \w hecho|strong="H6213"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*.   
\c 6
\p
\v 1 \w Cuando|strong="H3588"\w* \w se|strong="H1961"\w* informó \w a|strong="H3068"\w* Sanbalat, \w a|strong="H3068"\w* \w Tobías|strong="H2900"\w*, \w a|strong="H3068"\w* Gesem \w el|strong="H1931"\w* árabe \w y|strong="H1571"\w* \w al|strong="H5704"\w* \w resto|strong="H3499"\w* \w de|strong="H3588"\w* nuestros enemigos \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w había|strong="H1961"\w* construido \w el|strong="H1931"\w* \w muro|strong="H2346"\w* \w y|strong="H1571"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w quedaba|strong="H3498"\w* \w ninguna|strong="H3808"\w* brecha \w en|strong="H5704"\w* \w él|strong="H1931"\w* (\w aunque|strong="H3588"\w* \w hasta|strong="H5704"\w* \w ese|strong="H1931"\w* momento \w no|strong="H3808"\w* \w había|strong="H1961"\w* colocado las \w puertas|strong="H1817"\w* \w en|strong="H5704"\w* \w los|strong="H3588"\w* portones),  
\v 2 Sanbalat y Gesem me \w enviaron|strong="H7971"\w* \w a|strong="H3068"\w* decir: “¡\w Ven|strong="H3212"\w*! Reunámonos \w en|strong="H3259"\w* \w las|strong="H1992"\w* aldeas \w de|strong="H7451"\w* la llanura \w de|strong="H7451"\w* Ono”. Pero \w ellos|strong="H1992"\w* pretendían \w hacerme|strong="H6213"\w* daño.   
\p
\v 3 \w Les|strong="H5921"\w* \w envié|strong="H7971"\w* \w mensajeros|strong="H4397"\w* diciendo: “Estoy \w haciendo|strong="H6213"\w* una \w gran|strong="H1419"\w* \w obra|strong="H4399"\w*, \w de|strong="H5921"\w* modo \w que|strong="H4100"\w* \w no|strong="H3808"\w* \w puedo|strong="H3201"\w* bajar. ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* \w ha|strong="H3808"\w* \w de|strong="H5921"\w* cesar \w la|strong="H5921"\w* \w obra|strong="H4399"\w* mientras \w yo|strong="H6213"\w* \w la|strong="H5921"\w* \w dejo|strong="H7971"\w* \w y|strong="H5921"\w* bajo \w a|strong="H3068"\w* vosotros?”   
\p
\v 4 Me \w enviaron|strong="H7971"\w* cuatro \w veces|strong="H6471"\w* \w de|strong="H1697"\w* \w esta|strong="H2088"\w* \w manera|strong="H1697"\w*, y yo les respondí \w de|strong="H1697"\w* la misma \w manera|strong="H1697"\w*.  
\v 5 Entonces Sanbalat me \w envió|strong="H7971"\w* \w a|strong="H3068"\w* su \w siervo|strong="H5288"\w* \w de|strong="H1697"\w* la misma \w manera|strong="H1697"\w* la quinta \w vez|strong="H6471"\w*, con \w una|strong="H6471"\w* carta \w abierta|strong="H6605"\w* en la \w mano|strong="H3027"\w*,  
\v 6 \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* estaba \w escrito|strong="H3789"\w*: “\w Se|strong="H5921"\w* ha informado \w entre|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*, \w y|strong="H5921"\w* \w lo|strong="H1697"\w* \w dice|strong="H1697"\w* Gashmu, \w que|strong="H5921"\w* tú \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* tienen \w la|strong="H5921"\w* intención \w de|strong="H5921"\w* rebelarse. \w Por|strong="H5921"\w* ello, estáis construyendo \w el|strong="H5921"\w* \w muro|strong="H2346"\w*. Tú serías \w su|strong="H1933"\w* \w rey|strong="H4428"\w*, \w según|strong="H5921"\w* estas \w palabras|strong="H1697"\w*.  
\v 7 \w También|strong="H1571"\w* has nombrado \w profetas|strong="H5030"\w* \w para|strong="H5921"\w* \w que|strong="H6258"\w* proclamen \w de|strong="H5921"\w* \w ti|strong="H5921"\w* \w en|strong="H5921"\w* Jerusalén, diciendo: “¡Hay \w un|strong="H3162"\w* \w rey|strong="H4428"\w* \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*! \w Ahora|strong="H6258"\w* \w se|strong="H5921"\w* informará \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w según|strong="H5921"\w* \w estas|strong="H5975"\w* \w palabras|strong="H1697"\w*. \w Ven|strong="H3212"\w*, \w pues|strong="H6258"\w*, \w ahora|strong="H6258"\w*, \w y|strong="H1571"\w* tomemos \w consejo|strong="H3289"\w* \w juntos|strong="H3162"\w*”.   
\p
\v 8 \w Entonces|strong="H3588"\w* le \w envié|strong="H7971"\w* \w a|strong="H3068"\w* decir: “\w No|strong="H3808"\w* \w se|strong="H1961"\w* hacen tales \w cosas|strong="H1697"\w* \w como|strong="H3588"\w* tú \w dices|strong="H1697"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* las imaginas \w de|strong="H3588"\w* tu propio \w corazón|strong="H3820"\w*”.  
\v 9 \w Porque|strong="H3588"\w* \w todos|strong="H3605"\w* \w nos|strong="H4480"\w* habrían \w hecho|strong="H6213"\w* temer, diciendo: “Sus \w manos|strong="H3027"\w* \w se|strong="H3808"\w* debilitarán \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w obra|strong="H4399"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w haga|strong="H6213"\w*”. \w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w*, fortalece mis \w manos|strong="H3027"\w*.   
\p
\v 10 Fui \w a|strong="H3068"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Semaías|strong="H8098"\w*, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Delaías, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Mehetabel, \w que|strong="H3588"\w* \w estaba|strong="H1004"\w* \w encerrado|strong="H6113"\w* \w en|strong="H8432"\w* \w su|strong="H1931"\w* \w casa|strong="H1004"\w*, \w y|strong="H3588"\w* \w me|strong="H3588"\w* dijo: “Reunámonos \w en|strong="H8432"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* Dios, \w dentro|strong="H8432"\w* del \w templo|strong="H1964"\w*, \w y|strong="H3588"\w* cerremos las \w puertas|strong="H1817"\w* del \w templo|strong="H1964"\w*, \w porque|strong="H3588"\w* vendrán \w a|strong="H3068"\w* matarte. \w Sí|strong="H3588"\w*, \w en|strong="H8432"\w* \w la|strong="H1931"\w* \w noche|strong="H3915"\w* vendrán \w a|strong="H3068"\w* matarte”.   
\p
\v 11 Dije: “¿Debe huir un hombre \w como|strong="H3644"\w* yo? ¿\w Quién|strong="H4310"\w* \w hay|strong="H4310"\w* \w que|strong="H4310"\w*, siendo \w como|strong="H3644"\w* yo, quiera entrar en \w el|strong="H4310"\w* \w templo|strong="H1964"\w* para salvar su vida? \w No|strong="H3808"\w* entraré”.  
\v 12 Discerní, \w y|strong="H3588"\w* he \w aquí|strong="H2009"\w* \w que|strong="H3588"\w* Dios \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w había|strong="H3588"\w* \w enviado|strong="H7971"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w él|strong="H5921"\w* \w pronunció|strong="H1696"\w* \w esta|strong="H5921"\w* profecía \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*. \w Tobías|strong="H2900"\w* \w y|strong="H3588"\w* Sanbalat \w lo|strong="H3808"\w* habían contratado.  
\v 13 \w Lo|strong="H1931"\w* contrataron \w para|strong="H4616"\w* \w que|strong="H1931"\w* \w yo|strong="H6213"\w* tuviera \w miedo|strong="H3372"\w*, \w lo|strong="H1931"\w* hiciera y pecara, y \w para|strong="H4616"\w* \w que|strong="H1931"\w* \w ellos|strong="H1992"\w* tuvieran material \w para|strong="H4616"\w* un informe \w malo|strong="H7451"\w*, \w para|strong="H4616"\w* \w que|strong="H1931"\w* me reprocharan.  
\v 14 “\w Acuérdate|strong="H2142"\w*, Dios mío, \w de|strong="H3372"\w* \w Tobías|strong="H2900"\w* \w y|strong="H1571"\w* \w de|strong="H3372"\w* Sanbalat según estas sus \w obras|strong="H4639"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w de|strong="H3372"\w* \w la|strong="H1571"\w* \w profetisa|strong="H5031"\w* Noadías \w y|strong="H1571"\w* del \w resto|strong="H3499"\w* \w de|strong="H3372"\w* \w los|strong="H1961"\w* \w profetas|strong="H5030"\w* \w que|strong="H1571"\w* me habrían \w hecho|strong="H1961"\w* temer”.   
\p
\v 15 Así \w que|strong="H3117"\w* el \w muro|strong="H2346"\w* fue terminado el \w día|strong="H3117"\w* \w veinticinco|strong="H6242"\w* \w de|strong="H2568"\w* Elul, en \w cincuenta|strong="H2572"\w* y \w dos|strong="H8147"\w* \w días|strong="H3117"\w*.  
\v 16 \w Cuando|strong="H3588"\w* \w todos|strong="H3605"\w* nuestros enemigos \w se|strong="H3045"\w* enteraron \w de|strong="H3588"\w* \w ello|strong="H2063"\w*, \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* nos rodeaban \w tuvieron|strong="H1961"\w* miedo \w y|strong="H3588"\w* perdieron \w su|strong="H3588"\w* confianza, \w porque|strong="H3588"\w* \w se|strong="H3045"\w* dieron cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w esta|strong="H2063"\w* \w obra|strong="H4399"\w* \w era|strong="H1961"\w* hecha \w por|strong="H3588"\w* nuestro Dios.  
\v 17 \w Además|strong="H5921"\w*, \w en|strong="H5921"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w* \w los|strong="H1992"\w* nobles \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* enviaron \w muchas|strong="H7235"\w* cartas \w a|strong="H3068"\w* \w Tobías|strong="H2900"\w*, \w y|strong="H1571"\w* \w las|strong="H1992"\w* cartas \w de|strong="H5921"\w* \w Tobías|strong="H2900"\w* llegaron \w a|strong="H3068"\w* \w ellos|strong="H1992"\w*.  
\v 18 \w Porque|strong="H3588"\w* \w había|strong="H3588"\w* \w muchos|strong="H7227"\w* \w en|strong="H3588"\w* \w Judá|strong="H3063"\w* \w que|strong="H3588"\w* \w le|strong="H1931"\w* habían jurado \w por|strong="H3588"\w* ser \w yerno|strong="H2860"\w* \w de|strong="H3588"\w* Secanías, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Ara; \w y|strong="H3588"\w* \w su|strong="H1931"\w* \w hijo|strong="H1121"\w* \w Johanán|strong="H3076"\w* \w había|strong="H3588"\w* \w tomado|strong="H3947"\w* \w por|strong="H3588"\w* mujer \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* Mesulam, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Berequías.  
\v 19 \w También|strong="H1571"\w* \w hablaron|strong="H1697"\w* \w de|strong="H6440"\w* sus \w buenas|strong="H2896"\w* acciones \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w mí|strong="H1961"\w*, \w y|strong="H1571"\w* le informaron \w de|strong="H6440"\w* mis \w palabras|strong="H1697"\w*. \w Tobías|strong="H2900"\w* \w envió|strong="H7971"\w* cartas \w para|strong="H1961"\w* atemorizarme.   
\c 7
\p
\v 1 \w Cuando|strong="H1961"\w* la muralla \w estaba|strong="H1961"\w* construida y yo \w había|strong="H1961"\w* levantado las \w puertas|strong="H1817"\w*, y \w los|strong="H1961"\w* guardias de las \w puertas|strong="H1817"\w* y \w los|strong="H1961"\w* \w cantores|strong="H7891"\w* y \w los|strong="H1961"\w* \w levitas|strong="H3881"\w* \w estaban|strong="H1961"\w* designados,  
\v 2 \w puse|strong="H6680"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* hermano \w Hanani|strong="H2607"\w*, \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w Hananías|strong="H2608"\w*, \w el|strong="H1931"\w* \w gobernador|strong="H8269"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* fortaleza, \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* Jerusalén, \w porque|strong="H3588"\w* \w era|strong="H1931"\w* un hombre fiel \w y|strong="H3588"\w* \w temía|strong="H3372"\w* \w a|strong="H3068"\w* Dios \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w muchos|strong="H7227"\w*.  
\v 3 \w Les|strong="H1992"\w* dije: “\w No|strong="H3808"\w* dejen \w que|strong="H3808"\w* \w se|strong="H1992"\w* abran \w las|strong="H1992"\w* \w puertas|strong="H1817"\w* \w de|strong="H5048"\w* Jerusalén \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* \w el|strong="H3427"\w* \w sol|strong="H8121"\w* \w esté|strong="H5975"\w* caliente; \w y|strong="H5704"\w* \w mientras|strong="H5704"\w* hacen guardia, \w que|strong="H3808"\w* cierren \w las|strong="H1992"\w* \w puertas|strong="H1817"\w* \w y|strong="H5704"\w* ustedes \w las|strong="H1992"\w* atranquen; \w y|strong="H5704"\w* designen guardias \w de|strong="H5048"\w* \w los|strong="H1992"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5048"\w* Jerusalén, cada uno \w en|strong="H5704"\w* \w su|strong="H1992"\w* guardia, \w con|strong="H5704"\w* cada uno cerca \w de|strong="H5048"\w* \w su|strong="H1992"\w* \w casa|strong="H1004"\w*.”   
\p
\v 4 La \w ciudad|strong="H5892"\w* era amplia y \w grande|strong="H1419"\w*, pero la \w gente|strong="H5971"\w* era \w poca|strong="H4592"\w* y las \w casas|strong="H1004"\w* no \w estaban|strong="H5971"\w* construidas.   
\p
\v 5 Mi Dios \w puso|strong="H5414"\w* en mi \w corazón|strong="H3820"\w* reunir \w a|strong="H3068"\w* los nobles, \w a|strong="H3068"\w* los gobernantes y al \w pueblo|strong="H5971"\w*, \w para|strong="H5414"\w* \w que|strong="H5971"\w* fueran listados \w por|strong="H3789"\w* genealogía. Encontré el \w libro|strong="H5612"\w* \w de|strong="H5414"\w* la genealogía \w de|strong="H5414"\w* los \w que|strong="H5971"\w* \w subieron|strong="H5927"\w* al \w principio|strong="H5414"\w*, y encontré esto \w escrito|strong="H3789"\w* en él:   
\p
\v 6 Estos son \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* la \w provincia|strong="H4082"\w* \w que|strong="H1121"\w* \w subieron|strong="H5927"\w* del \w cautiverio|strong="H1473"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* deportados, \w que|strong="H1121"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Babilonia, había llevado, y \w que|strong="H1121"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* Jerusalén y \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, cada uno \w a|strong="H3068"\w* su \w ciudad|strong="H5892"\w*,  
\v 7 \w que|strong="H5971"\w* vinieron \w con|strong="H5973"\w* \w Zorobabel|strong="H2216"\w*, \w Jesúa|strong="H3442"\w*, \w Nehemías|strong="H5166"\w*, \w Azarías|strong="H5838"\w*, \w Raamías|strong="H7485"\w*, \w Nahamani|strong="H5167"\w*, Mardoqueo, \w Bilsán|strong="H1114"\w*, \w Misperet|strong="H4559"\w*, Bigvai, \w Nehum|strong="H5149"\w* y \w Baana|strong="H1196"\w*.  
\p \w El|strong="H5973"\w* \w número|strong="H4557"\w* \w de|strong="H5973"\w* \w los|strong="H5973"\w* hombres \w del|strong="H5973"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*:   
\m
