\v 17 \w Toda|strong="H3605"\w* \w la|strong="H1931"\w* asamblea \w de|strong="H4480"\w* \w los|strong="H3427"\w* \w que|strong="H3588"\w* \w habían|strong="H1961"\w* regresado \w del|strong="H4480"\w* \w cautiverio|strong="H7628"\w* \w hizo|strong="H6213"\w* refugios temporales \w y|strong="H3588"\w* \w vivió|strong="H3117"\w* \w en|strong="H4480"\w* \w los|strong="H3427"\w* refugios temporales, \w pues|strong="H3588"\w* \w desde|strong="H4480"\w* \w los|strong="H3427"\w* \w días|strong="H3117"\w* \w de|strong="H4480"\w* \w Josué|strong="H3442"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Nun|strong="H5126"\w* \w hasta|strong="H5704"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* \w lo|strong="H1931"\w* \w habían|strong="H1961"\w* \w hecho|strong="H6213"\w*. \w Hubo|strong="H1961"\w* una \w alegría|strong="H8057"\w* \w muy|strong="H3966"\w* \w grande|strong="H1419"\w*.  
\v 18 \w Además|strong="H4480"\w*, \w cada|strong="H3117"\w* \w día|strong="H3117"\w*, \w desde|strong="H4480"\w* \w el|strong="H6213"\w* \w primero|strong="H7223"\w* \w hasta|strong="H5704"\w* \w el|strong="H6213"\w* último, \w se|strong="H4480"\w* leía \w en|strong="H4480"\w* \w el|strong="H6213"\w* \w libro|strong="H5612"\w* \w de|strong="H4480"\w* la \w ley|strong="H8451"\w* \w de|strong="H4480"\w* Dios. Celebraron la \w fiesta|strong="H2282"\w* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*; \w y|strong="H5704"\w* \w el|strong="H6213"\w* \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* hubo una asamblea solemne, según la \w ordenanza|strong="H4941"\w*.   
\c 9
\p
\v 1 \w El|strong="H5921"\w* \w día|strong="H3117"\w* \w veinticuatro|strong="H6242"\w* \w de|strong="H5921"\w* \w este|strong="H2088"\w* \w mes|strong="H2320"\w* \w se|strong="H5921"\w* reunieron \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w con|strong="H5921"\w* \w ayuno|strong="H6685"\w*, \w con|strong="H5921"\w* cilicio \w y|strong="H5921"\w* \w con|strong="H5921"\w* tierra \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
