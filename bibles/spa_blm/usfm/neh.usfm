\v 3 \w Se|strong="H5921"\w* \w pusieron|strong="H3034"\w* \w de|strong="H5921"\w* pie \w en|strong="H5921"\w* su lugar \w y|strong="H5921"\w* \w leyeron|strong="H7121"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* Yahvé su \w Dios|strong="H3068"\w* \w la|strong="H5921"\w* cuarta parte \w del|strong="H5921"\w* \w día|strong="H3117"\w*; \w y|strong="H5921"\w* \w la|strong="H5921"\w* cuarta parte \w la|strong="H5921"\w* \w confesaron|strong="H3034"\w* \w y|strong="H5921"\w* \w adoraron|strong="H7812"\w* \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*.  
\v 4 Entonces \w Jesúa|strong="H3442"\w*, \w Baní|strong="H1137"\w*, \w Cadmiel|strong="H6934"\w*, \w Sebanías|strong="H7645"\w*, \w Buní|strong="H1138"\w*, \w Serebías|strong="H8274"\w*, \w Baní|strong="H1137"\w* \w y|strong="H5921"\w* Quenaní, \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w*, \w se|strong="H5921"\w* pusieron \w de|strong="H5921"\w* pie \w en|strong="H5921"\w* \w la|strong="H5921"\w* escalera \w y|strong="H5921"\w* \w clamaron|strong="H2199"\w* \w en|strong="H5921"\w* \w voz|strong="H6963"\w* \w alta|strong="H1419"\w* \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*.   
\p
\v 5 Entonces \w los|strong="H3605"\w* \w levitas|strong="H3881"\w*, \w Jesúa|strong="H3442"\w* \w y|strong="H5921"\w* \w Cadmiel|strong="H6934"\w*, \w Baní|strong="H1137"\w*, Hasabneías, \w Serebías|strong="H8274"\w*, Hodías, \w Sebanías|strong="H7645"\w* \w y|strong="H5921"\w* Petaías, dijeron: “¡Ponte \w de|strong="H4480"\w* pie \w y|strong="H5921"\w* \w bendice|strong="H1288"\w* \w a|strong="H3068"\w* Yahvé, tu \w Dios|strong="H3068"\w*, \w desde|strong="H4480"\w* \w la|strong="H5921"\w* \w eternidad|strong="H5769"\w* \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* \w eternidad|strong="H5769"\w*! ¡\w Bendito|strong="H1288"\w* sea tu \w nombre|strong="H8034"\w* \w glorioso|strong="H3519"\w*, \w que|strong="H4480"\w* es exaltado \w sobre|strong="H5921"\w* \w toda|strong="H3605"\w* \w bendición|strong="H1293"\w* \w y|strong="H5921"\w* \w alabanza|strong="H8416"\w*!  
\v 6 \w Tú|strong="H6213"\w* \w eres|strong="H1931"\w* Yahvé, \w tú|strong="H6213"\w* \w solo|strong="H1931"\w*. \w Tú|strong="H6213"\w* has \w hecho|strong="H6213"\w* \w el|strong="H1931"\w* \w cielo|strong="H8064"\w*, \w el|strong="H1931"\w* \w cielo|strong="H8064"\w* \w de|strong="H5921"\w* \w los|strong="H3605"\w* \w cielos|strong="H8064"\w*, \w con|strong="H5921"\w* \w todo|strong="H3605"\w* \w su|strong="H1931"\w* \w ejército|strong="H6635"\w*, \w la|strong="H1931"\w* tierra \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* hay \w en|strong="H5921"\w* \w ella|strong="H1931"\w*, \w los|strong="H3605"\w* \w mares|strong="H3220"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* hay \w en|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w y|strong="H5921"\w* \w tú|strong="H6213"\w* \w lo|strong="H1931"\w* conservas \w todo|strong="H3605"\w*. \w El|strong="H1931"\w* \w ejército|strong="H6635"\w* \w de|strong="H5921"\w* \w los|strong="H3605"\w* \w cielos|strong="H8064"\w* \w te|strong="H5921"\w* adora.  
\v 7 Tú \w eres|strong="H1931"\w* Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w que|strong="H1931"\w* eligió \w a|strong="H3068"\w* Abram, \w lo|strong="H1931"\w* \w sacó|strong="H3318"\w* de Ur de \w los|strong="H1931"\w* \w Caldeos|strong="H3778"\w*, \w le|strong="H1931"\w* \w dio|strong="H7760"\w* \w el|strong="H1931"\w* \w nombre|strong="H8034"\w* de Abraham,  
\v 8 encontró \w su|strong="H3588"\w* \w corazón|strong="H3824"\w* fiel \w ante|strong="H6440"\w* \w ti|strong="H5973"\w*, \w e|strong="H3068"\w* \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w* \w para|strong="H3588"\w* \w darle|strong="H5414"\w* \w la|strong="H3588"\w* tierra \w del|strong="H5973"\w* \w cananeo|strong="H3669"\w*, \w del|strong="H5973"\w* hitita, \w del|strong="H5973"\w* amorreo, \w del|strong="H5973"\w* ferezeo, \w del|strong="H5973"\w* \w jebuseo|strong="H2983"\w* \w y|strong="H3588"\w* \w del|strong="H5973"\w* gergeseo, \w para|strong="H3588"\w* \w dársela|strong="H5414"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w descendencia|strong="H2233"\w*, \w y|strong="H3588"\w* \w has|strong="H5414"\w* cumplido tus \w palabras|strong="H1697"\w*, \w porque|strong="H3588"\w* eres \w justo|strong="H6662"\w*.   
\p
\v 9 “\w Viste|strong="H7200"\w* \w la|strong="H5921"\w* \w aflicción|strong="H6040"\w* \w de|strong="H5921"\w* nuestros padres \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w y|strong="H5921"\w* \w oíste|strong="H8085"\w* su \w clamor|strong="H2201"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w Mar|strong="H3220"\w* Rojo,  
\v 10 \w y|strong="H3588"\w* mostraste señales \w y|strong="H3588"\w* \w prodigios|strong="H4159"\w* \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w Faraón|strong="H6547"\w*, \w contra|strong="H5921"\w* \w todos|strong="H3605"\w* sus \w siervos|strong="H5650"\w* \w y|strong="H3588"\w* \w contra|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* tierra, \w porque|strong="H3588"\w* \w sabías|strong="H3045"\w* \w que|strong="H3588"\w* \w se|strong="H3045"\w* burlaban \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w y|strong="H3588"\w* \w te|strong="H5921"\w* \w hiciste|strong="H6213"\w* un \w nombre|strong="H8034"\w*, \w como|strong="H3588"\w* \w lo|strong="H5921"\w* \w es|strong="H2088"\w* \w hoy|strong="H3117"\w*.  
\v 11 Dividiste \w el|strong="H5674"\w* \w mar|strong="H3220"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos, \w de|strong="H6440"\w* modo \w que|strong="H4325"\w* \w pasaron|strong="H5674"\w* \w por|strong="H6440"\w* \w el|strong="H5674"\w* \w medio|strong="H8432"\w* del \w mar|strong="H3220"\w* \w en|strong="H8432"\w* seco; y arrojaste \w a|strong="H3068"\w* sus \w perseguidores|strong="H7291"\w* \w a|strong="H3068"\w* las profundidades, \w como|strong="H3644"\w* una piedra \w a|strong="H3068"\w* las \w aguas|strong="H4325"\w* \w impetuosas|strong="H5794"\w*.  
\v 12 Además, \w en|strong="H3212"\w* una \w columna|strong="H5982"\w* de \w nube|strong="H6051"\w* \w los|strong="H1992"\w* \w guiaste|strong="H5148"\w* de \w día|strong="H3119"\w*, y \w en|strong="H3212"\w* una \w columna|strong="H5982"\w* de fuego de \w noche|strong="H3915"\w*, para alumbrarles \w el|strong="H1992"\w* \w camino|strong="H1870"\w* \w que|strong="H1992"\w* debían seguir.   
\p
\v 13 “También bajaste \w al|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w*, \w y|strong="H5921"\w* \w hablaste|strong="H1696"\w* \w con|strong="H5973"\w* \w ellos|strong="H5921"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w diste|strong="H5414"\w* \w ordenanzas|strong="H2706"\w* rectas \w y|strong="H5921"\w* \w leyes|strong="H8451"\w* verdaderas, \w buenos|strong="H2896"\w* \w estatutos|strong="H2706"\w* \w y|strong="H5921"\w* \w mandamientos|strong="H4687"\w*,  
\v 14  y \w les|strong="H6680"\w* diste \w a|strong="H3068"\w* conocer tu \w santo|strong="H6944"\w* \w sábado|strong="H7676"\w*, y \w les|strong="H6680"\w* \w ordenaste|strong="H6680"\w* \w mandamientos|strong="H4687"\w*, \w estatutos|strong="H2706"\w* y una \w ley|strong="H8451"\w*, \w por|strong="H3027"\w* \w medio|strong="H3027"\w* de \w Moisés|strong="H4872"\w*, tu \w siervo|strong="H5650"\w*,  
\v 15 y les \w diste|strong="H5414"\w* \w pan|strong="H3899"\w* del \w cielo|strong="H8064"\w* \w para|strong="H5414"\w* su \w hambre|strong="H7458"\w*, y les \w sacaste|strong="H3318"\w* \w agua|strong="H4325"\w* \w de|strong="H4325"\w* la \w roca|strong="H5553"\w* \w para|strong="H5414"\w* su \w sed|strong="H6772"\w*, y les ordenaste \w que|strong="H4325"\w* entraran \w a|strong="H3068"\w* poseer la tierra \w que|strong="H4325"\w* habías jurado darles.   
\p
\v 16 “Pero \w ellos|strong="H1992"\w* y nuestros padres \w se|strong="H1992"\w* comportaron con soberbia, endurecieron \w su|strong="H1992"\w* \w cerviz|strong="H6203"\w*, \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* tus \w mandamientos|strong="H4687"\w*,  
\v 17 y \w se|strong="H3808"\w* negaron \w a|strong="H3068"\w* \w obedecer|strong="H8085"\w*. \w No|strong="H3808"\w* tuvieron \w en|strong="H5973"\w* cuenta tus \w maravillas|strong="H6381"\w* \w que|strong="H3808"\w* \w hiciste|strong="H6213"\w* \w entre|strong="H5973"\w* ellos, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* endurecieron su \w cerviz|strong="H6203"\w*, y \w en|strong="H5973"\w* su rebeldía nombraron un \w capitán|strong="H7227"\w* \w para|strong="H5414"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* su esclavitud. Pero \w tú|strong="H6213"\w* eres un Dios dispuesto \w a|strong="H3068"\w* perdonar, \w clemente|strong="H2587"\w* y \w misericordioso|strong="H7349"\w*, lento \w para|strong="H5414"\w* la ira y abundante \w en|strong="H5973"\w* bondades, y \w no|strong="H3808"\w* \w los|strong="H5973"\w* abandonaste.  
\v 18 \w Sí|strong="H3588"\w*, \w cuando|strong="H3588"\w* se \w hicieron|strong="H6213"\w* un \w becerro|strong="H5695"\w* moldeado \w y|strong="H3588"\w* dijeron: “\w Este|strong="H2088"\w* \w es|strong="H2088"\w* vuestro Dios, \w que|strong="H3588"\w* os \w hizo|strong="H6213"\w* \w subir|strong="H5927"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*”, \w y|strong="H3588"\w* \w cometieron|strong="H6213"\w* horribles blasfemias,  
\v 19 pero tú, \w en|strong="H5921"\w* tus múltiples \w misericordias|strong="H7356"\w*, \w no|strong="H3808"\w* \w los|strong="H5921"\w* abandonaste \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*. \w La|strong="H5921"\w* \w columna|strong="H5982"\w* \w de|strong="H5921"\w* \w nube|strong="H6051"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w apartó|strong="H5800"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* durante \w el|strong="H5921"\w* \w día|strong="H3119"\w* \w para|strong="H5921"\w* guiarlos \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w*, \w ni|strong="H3808"\w* \w la|strong="H5921"\w* \w columna|strong="H5982"\w* \w de|strong="H5921"\w* fuego durante \w la|strong="H5921"\w* \w noche|strong="H3915"\w* \w para|strong="H5921"\w* mostrarles \w la|strong="H5921"\w* luz \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w que|strong="H3808"\w* debían seguir.  
\v 20 También \w diste|strong="H5414"\w* tu \w buen|strong="H2896"\w* \w Espíritu|strong="H7307"\w* \w para|strong="H5414"\w* instruirlos, y \w no|strong="H3808"\w* retuviste tu \w maná|strong="H4478"\w* \w de|strong="H4325"\w* su \w boca|strong="H6310"\w*, y les \w diste|strong="H5414"\w* \w agua|strong="H4325"\w* \w para|strong="H5414"\w* su \w sed|strong="H6772"\w*.   
\p
\v 21 “\w Sí|strong="H3808"\w*, cuarenta \w años|strong="H8141"\w* los sostuviste en el \w desierto|strong="H4057"\w*. \w Nada|strong="H3808"\w* les faltó. Sus \w vestidos|strong="H8008"\w* \w no|strong="H3808"\w* envejecieron y sus \w pies|strong="H7272"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* hincharon.  
\v 22 Además, les \w diste|strong="H5414"\w* \w reinos|strong="H4467"\w* y \w pueblos|strong="H5971"\w*, \w que|strong="H5971"\w* asignaste según sus porciones. Así \w poseyeron|strong="H3423"\w* la tierra \w de|strong="H5414"\w* \w Sehón|strong="H5511"\w*, la tierra del \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Hesbón|strong="H2809"\w* y la tierra \w de|strong="H5414"\w* \w Og|strong="H5747"\w*, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Basán|strong="H1316"\w*.  
\v 23 También \w multiplicaste|strong="H7235"\w* sus \w hijos|strong="H1121"\w* como las \w estrellas|strong="H3556"\w* del \w cielo|strong="H8064"\w*, y \w los|strong="H1121"\w* introdujiste en la tierra sobre la \w que|strong="H1121"\w* habías dicho \w a|strong="H3068"\w* sus padres \w que|strong="H1121"\w* entrarían \w a|strong="H3068"\w* poseerla.   
\p
\v 24 “Así \w que|strong="H5971"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* entraron y \w poseyeron|strong="H3423"\w* la tierra; y \w tú|strong="H6213"\w* sometiste \w ante|strong="H6440"\w* \w ellos|strong="H3027"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H6440"\w* la tierra, \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w*, y \w los|strong="H3427"\w* \w entregaste|strong="H5414"\w* en sus \w manos|strong="H3027"\w*, con sus \w reyes|strong="H4428"\w* y \w los|strong="H3427"\w* \w pueblos|strong="H5971"\w* \w de|strong="H6440"\w* la tierra, \w para|strong="H5414"\w* \w que|strong="H5971"\w* hicieran con \w ellos|strong="H3027"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* quisieran.  
\v 25 \w Tomaron|strong="H3920"\w* \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* y una tierra rica, y \w poseyeron|strong="H3423"\w* \w casas|strong="H1004"\w* \w llenas|strong="H4392"\w* \w de|strong="H7646"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* bienes, cisternas excavadas, \w viñas|strong="H3754"\w*, \w olivares|strong="H2132"\w* y \w árboles|strong="H6086"\w* frutales en \w abundancia|strong="H7230"\w*. Así comieron, se saciaron, \w engordaron|strong="H8080"\w* y se deleitaron en tu \w gran|strong="H1419"\w* \w bondad|strong="H2898"\w*.   
\p
\v 26 “Sin embargo, fueron desobedientes y se rebelaron contra ti, echaron \w tu|strong="H6213"\w* \w ley|strong="H8451"\w* \w a|strong="H3068"\w* sus \w espaldas|strong="H1458"\w*, \w mataron|strong="H2026"\w* \w a|strong="H3068"\w* tus \w profetas|strong="H5030"\w* que testificaban contra ellos para que se volvieran \w a|strong="H3068"\w* ti, y \w cometieron|strong="H6213"\w* horribles blasfemias.  
\v 27 \w Por|strong="H3027"\w* eso los \w entregaste|strong="H5414"\w* en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* sus \w adversarios|strong="H6862"\w*, \w que|strong="H6256"\w* los angustiaron. En el \w tiempo|strong="H6256"\w* \w de|strong="H5414"\w* su \w angustia|strong="H6869"\w*, \w cuando|strong="H6256"\w* \w clamaron|strong="H6817"\w* \w a|strong="H3068"\w* ti, tú \w oíste|strong="H8085"\w* desde el \w cielo|strong="H8064"\w*; y según tus múltiples \w misericordias|strong="H7356"\w* les \w diste|strong="H5414"\w* \w salvadores|strong="H3467"\w* \w que|strong="H6256"\w* los salvaron \w de|strong="H5414"\w* las \w manos|strong="H3027"\w* \w de|strong="H5414"\w* sus \w adversarios|strong="H6862"\w*.  
\v 28 Pero después \w de|strong="H6440"\w* haber descansado, \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w el|strong="H6213"\w* \w mal|strong="H7451"\w* \w ante|strong="H6440"\w* ti; \w por|strong="H6440"\w* eso los dejaste en \w manos|strong="H3027"\w* \w de|strong="H6440"\w* sus enemigos, para \w que|strong="H6256"\w* se enseñorearan \w de|strong="H6440"\w* \w ellos|strong="H3027"\w*; sin embargo, \w cuando|strong="H6256"\w* \w volvieron|strong="H7725"\w* y \w clamaron|strong="H2199"\w* \w a|strong="H3068"\w* ti, \w tú|strong="H6213"\w* \w oíste|strong="H8085"\w* \w desde|strong="H6440"\w* \w el|strong="H6213"\w* \w cielo|strong="H8064"\w*; y \w muchas|strong="H7227"\w* \w veces|strong="H3027"\w* los \w libraste|strong="H5337"\w* según tus \w misericordias|strong="H7356"\w*,  
\v 29 y \w diste|strong="H5414"\w* testimonio contra \w ellos|strong="H1992"\w*, \w para|strong="H5414"\w* \w que|strong="H3808"\w* volvieran \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w ley|strong="H8451"\w*. \w Sin|strong="H3808"\w* embargo, fueron arrogantes y \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* tus \w mandamientos|strong="H4687"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w pecaron|strong="H2398"\w* contra tus \w ordenanzas|strong="H4941"\w* (\w que|strong="H3808"\w* \w si|strong="H3808"\w* \w el|strong="H6213"\w* hombre \w hace|strong="H6213"\w*, \w vivirá|strong="H2421"\w* en \w ellas|strong="H1992"\w*), \w volvieron|strong="H7725"\w* la espalda, endurecieron \w su|strong="H1992"\w* \w cerviz|strong="H6203"\w* y \w no|strong="H3808"\w* quisieron \w escuchar|strong="H8085"\w*.  
\v 30 \w Sin|strong="H3808"\w* embargo, durante \w muchos|strong="H7227"\w* \w años|strong="H8141"\w* \w los|strong="H5921"\w* aguantaste \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w diste|strong="H5414"\w* testimonio \w con|strong="H5921"\w* tu \w Espíritu|strong="H7307"\w* \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* tus \w profetas|strong="H5030"\w*. \w Sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* quisieron escuchar. \w Por|strong="H5921"\w* eso \w los|strong="H5921"\w* \w entregaste|strong="H5414"\w* \w en|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w pueblos|strong="H5971"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* tierras.   
\p
\v 31 “\w Sin|strong="H3808"\w* embargo, \w en|strong="H3588"\w* tus múltiples \w misericordias|strong="H7356"\w*, \w no|strong="H3808"\w* les pusiste fin \w ni|strong="H3808"\w* \w los|strong="H3588"\w* abandonaste, \w porque|strong="H3588"\w* eres un Dios \w clemente|strong="H2587"\w* \w y|strong="H3588"\w* \w misericordioso|strong="H7349"\w*.   
\p
\v 32 \w Ahora|strong="H6258"\w*, \w pues|strong="H6258"\w*, Dios nuestro, \w el|strong="H3605"\w* \w grande|strong="H1419"\w*, \w el|strong="H3605"\w* \w poderoso|strong="H1368"\w* \w y|strong="H5704"\w* \w el|strong="H3605"\w* imponente, \w que|strong="H6258"\w* \w guarda|strong="H8104"\w* \w el|strong="H3605"\w* \w pacto|strong="H1285"\w* \w y|strong="H5704"\w* \w la|strong="H8104"\w* bondad amorosa, \w no|strong="H6440"\w* dejes \w que|strong="H6258"\w* te parezcan pequeños \w todos|strong="H3605"\w* \w los|strong="H3605"\w* trabajos \w que|strong="H6258"\w* nos han sobrevenido, \w a|strong="H3068"\w* nuestros \w reyes|strong="H4428"\w*, \w a|strong="H3068"\w* nuestros \w príncipes|strong="H8269"\w*, \w a|strong="H3068"\w* nuestros \w sacerdotes|strong="H3548"\w*, \w a|strong="H3068"\w* nuestros \w profetas|strong="H5030"\w*, \w a|strong="H3068"\w* nuestros padres \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* tu \w pueblo|strong="H5971"\w*, \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w tiempo|strong="H3117"\w* \w de|strong="H6440"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* \w de|strong="H6440"\w* Asiria \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 33 Sin embargo, \w tú|strong="H6213"\w* eres \w justo|strong="H6662"\w* \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* ha recaído \w sobre|strong="H5921"\w* \w nosotros|strong="H3605"\w*; \w porque|strong="H3588"\w* \w tú|strong="H6213"\w* has actuado \w con|strong="H5921"\w* verdad, \w pero|strong="H3588"\w* \w nosotros|strong="H3605"\w* hemos \w hecho|strong="H6213"\w* maldad.  
\v 34 También nuestros \w reyes|strong="H4428"\w*, nuestros \w príncipes|strong="H8269"\w*, nuestros \w sacerdotes|strong="H3548"\w* y nuestros padres \w no|strong="H3808"\w* han guardado \w tu|strong="H6213"\w* \w ley|strong="H8451"\w*, \w ni|strong="H3808"\w* han escuchado tus \w mandamientos|strong="H4687"\w* y tus testimonios con los \w que|strong="H3808"\w* testificaste contra ellos.  
\v 35 \w Porque|strong="H3808"\w* \w no|strong="H3808"\w* te han servido en \w su|strong="H1992"\w* \w reino|strong="H4438"\w* y en tu \w gran|strong="H7227"\w* \w bondad|strong="H2898"\w* \w que|strong="H3808"\w* \w les|strong="H1992"\w* \w diste|strong="H5414"\w*, y en la tierra \w grande|strong="H7227"\w* y \w rica|strong="H7227"\w* \w que|strong="H3808"\w* \w les|strong="H1992"\w* \w diste|strong="H5414"\w*. \w No|strong="H3808"\w* \w se|strong="H1992"\w* convirtieron \w de|strong="H6440"\w* \w sus|strong="H1992"\w* \w obras|strong="H4611"\w* malvadas.   
\p
\v 36 “He \w aquí|strong="H2009"\w* \w que|strong="H5921"\w* \w hoy|strong="H3117"\w* somos \w siervos|strong="H5650"\w*, \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w que|strong="H5921"\w* \w diste|strong="H5414"\w* \w a|strong="H3068"\w* nuestros padres \w para|strong="H5921"\w* comer su \w fruto|strong="H6529"\w* \w y|strong="H5921"\w* su \w bien|strong="H2898"\w*, he \w aquí|strong="H2009"\w* \w que|strong="H5921"\w* somos \w siervos|strong="H5650"\w* \w en|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 37 \w La|strong="H5921"\w* tierra \w da|strong="H5414"\w* \w muchos|strong="H7235"\w* \w frutos|strong="H8393"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w que|strong="H5921"\w* \w has|strong="H5414"\w* \w puesto|strong="H5414"\w* \w sobre|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w a|strong="H3068"\w* causa \w de|strong="H5921"\w* nuestros \w pecados|strong="H2403"\w*. También tienen poder \w sobre|strong="H5921"\w* nuestros \w cuerpos|strong="H1472"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* nuestro ganado, \w a|strong="H3068"\w* su antojo, \w y|strong="H5921"\w* estamos \w en|strong="H5921"\w* \w gran|strong="H1419"\w* \w aflicción|strong="H6869"\w*.  
\v 38 Sin embargo, por todo esto, hacemos un pacto seguro y lo escribimos; y nuestros príncipes, nuestros levitas y nuestros sacerdotes lo sellan.”   
\c 10
\p
\v 1 \w Los|strong="H3605"\w* \w que|strong="H5921"\w* sellaron fueron: Nehemías, \w el|strong="H5921"\w* \w gobernador|strong="H8269"\w*, hijo \w de|strong="H5921"\w* Hacalías, \w y|strong="H5921"\w* Sedequías,  
\v 2 Seraías, Azarías, Jeremías,  
\v 3 Pashur, Amarías, Malquías,  
\v 4 Hattush, Sebanías, Malluch,  
\v 5 Harim, Meremot, Abdías,  
\v 6 Daniel, Ginetón, Baruc,  
\v 7 Mesulam, Abías, Mijamín,  
\v 8 Maazías, Bilgai y Semaías. Estos eran los sacerdotes.  
\v 9 Los levitas: Jesúa hijo de Azanías, Binúi de los hijos de Henadad, Cadmiel;  
\v 10 y sus hermanos, Sebanías, Hodías, Kelita, Pelaías, Hanán,  
\v 11 Mica, Rehob, Hasabías,  
\v 12 Zaccur, Serebías, Sebanías,  
\v 13 Hodías, Baní y Beninú.  
\v 14 Los jefes del pueblo: Parosh, Pahathmoab, Elam, Zattu, \w Bani|strong="H1137"\w*,  
\v 15 Bunni, Azgad, Bebai,  
\v 16 Adonías, Bigvai, Adin,  
\v 17 Ater, Ezequías, Azzur,  
\v 18 Hodías, Hashum, Bezai,  
\v 19 Hariph, Anathoth, Nobai,  
\v 20 Magpiash, Meshullam, Hezir,  
\v 21 Meshezabel, Zadok, Jaddua,  
\v 22 Pelatiah, Hanan, Anaiah,  
\v 23 Hoshea, Hananiah, Hasshub,  
\v 24 Hallohesh, Pilha, Shobek,  
\v 25 Rehum, Hashabnah, Maaseiah,  
\v 26 Ahiah, Hanan, Anan,  
\v 27 Malluch, Harim y Baanah.   
\p
\v 28 El resto del pueblo, los sacerdotes, los levitas, los porteros, los cantores, los servidores del templo, y todos los que se habían apartado de los pueblos de las tierras \w a|strong="H3068"\w* la ley de Dios, sus esposas, sus hijos y sus hijas — todos los que tenían conocimiento y entendimiento —  
\v 29 \w se|strong="H3045"\w* unieron \w a|strong="H3068"\w* sus hermanos sus nobles, y entraron en una maldición y en un juramento, \w para|strong="H5971"\w* andar en \w la|strong="H3605"\w* \w ley|strong="H8451"\w* \w de|strong="H5971"\w* Dios, \w que|strong="H5971"\w* fue dada \w por|strong="H3881"\w* Moisés \w el|strong="H3605"\w* siervo \w de|strong="H5971"\w* Dios, y \w para|strong="H5971"\w* observar y hacer \w todos|strong="H3605"\w* \w los|strong="H1121"\w* mandamientos \w de|strong="H5971"\w* Yahvé nuestro Señor, y sus ordenanzas y sus estatutos;  
\v 30 \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w no|strong="H6213"\w* \w daríamos|strong="H5414"\w* nuestras hijas \w a|strong="H3068"\w* \w los|strong="H3605"\w* pueblos \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra, ni tomaríamos sus hijas \w para|strong="H5921"\w* nuestros hijos;  
\v 31 y \w que|strong="H3808"\w* \w si|strong="H3808"\w* \w los|strong="H1121"\w* \w pueblos|strong="H5971"\w* \w de|strong="H5414"\w* la tierra trajeran mercancías \w o|strong="H3068"\w* algún grano en \w el|strong="H1121"\w* \w día|strong="H1121"\w* \w de|strong="H5414"\w* reposo \w para|strong="H5414"\w* vender, \w no|strong="H3808"\w* les compraríamos en \w el|strong="H1121"\w* \w día|strong="H1121"\w* \w de|strong="H5414"\w* reposo, \w ni|strong="H3808"\w* en un \w día|strong="H1121"\w* santo; y \w que|strong="H3808"\w* renunciaríamos \w a|strong="H3068"\w* las cosechas del séptimo año y \w a|strong="H3068"\w* la exacción \w de|strong="H5414"\w* toda deuda.   
\p
\v 32 Además, nos hemos impuesto \w la|strong="H3605"\w* obligación \w de|strong="H5971"\w* cobrar anualmente \w la|strong="H3605"\w* tercera parte \w de|strong="H5971"\w* un siclo \w para|strong="H5971"\w* \w el|strong="H3605"\w* servicio \w de|strong="H5971"\w* \w la|strong="H3605"\w* casa \w de|strong="H5971"\w* nuestro Dios:  
\v 33 \w para|strong="H5921"\w* \w el|strong="H5921"\w* pan \w de|strong="H5921"\w* \w la|strong="H5921"\w* proposición, \w para|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda continua, \w para|strong="H5921"\w* \w el|strong="H5921"\w* holocausto continuo, \w para|strong="H5921"\w* \w los|strong="H5921"\w* sábados, \w para|strong="H5921"\w* \w las|strong="H5921"\w* lunas nuevas, \w para|strong="H5921"\w* \w las|strong="H5921"\w* fiestas, \w para|strong="H5921"\w* \w las|strong="H5921"\w* cosas santas, \w para|strong="H5921"\w* \w las|strong="H5921"\w* ofrendas \w por|strong="H5921"\w* \w el|strong="H5921"\w* pecado \w para|strong="H5921"\w* hacer expiación \w por|strong="H5921"\w* Israel, \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w toda|strong="H5921"\w* \w la|strong="H5921"\w* obra \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* nuestro Dios.  
\v 34 \w Nosotros|strong="H3605"\w*, \w los|strong="H3605"\w* sacerdotes, \w los|strong="H3605"\w* levitas \w y|strong="H5921"\w* \w el|strong="H5921"\w* pueblo, echamos suertes \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* leña, \w para|strong="H5921"\w* traerla \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* nuestro Dios, \w según|strong="H5921"\w* \w las|strong="H5921"\w* \w casas|strong="H1004"\w* \w de|strong="H5921"\w* nuestros padres, \w en|strong="H5921"\w* \w los|strong="H3605"\w* \w tiempos|strong="H4150"\w* señalados \w de|strong="H5921"\w* año \w en|strong="H5921"\w* año, \w para|strong="H5921"\w* quemarla \w en|strong="H5921"\w* \w el|strong="H5921"\w* altar \w de|strong="H5921"\w* Yahvé nuestro Dios, \w como|strong="H5921"\w* \w está|strong="H5921"\w* escrito \w en|strong="H5921"\w* \w la|strong="H5921"\w* ley;  
\v 35 \w y|strong="H5921"\w* \w para|strong="H5921"\w* traer \w las|strong="H5921"\w* primicias \w de|strong="H5921"\w* nuestra tierra \w y|strong="H5921"\w* \w las|strong="H5921"\w* primicias \w de|strong="H5921"\w* \w todos|strong="H8141"\w* \w los|strong="H5921"\w* frutos \w de|strong="H5921"\w* \w toda|strong="H5921"\w* clase \w de|strong="H5921"\w* \w árboles|strong="H6086"\w*, \w de|strong="H5921"\w* \w año|strong="H8141"\w* \w en|strong="H5921"\w* \w año|strong="H8141"\w*, \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé;  
\v 36 también \w los|strong="H3605"\w* primogénitos de nuestros hijos y de nuestros ganados, como está escrito en \w la|strong="H3605"\w* ley, y \w los|strong="H3605"\w* primogénitos de nuestras vacas y de nuestros rebaños, para llevarlos \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* de nuestro \w Dios|strong="H3068"\w*, \w a|strong="H3068"\w* \w los|strong="H3605"\w* sacerdotes \w que|strong="H3605"\w* sirven en \w la|strong="H3605"\w* \w casa|strong="H1004"\w* de nuestro \w Dios|strong="H3068"\w*  
\v 37 \w y|strong="H1241"\w* \w que|strong="H1121"\w* traigamos las primicias \w de|strong="H1121"\w* nuestra masa, nuestras ofrendas \w de|strong="H1121"\w* ondas, \w el|strong="H1121"\w* fruto \w de|strong="H1121"\w* toda clase \w de|strong="H1121"\w* árboles, \w el|strong="H1121"\w* vino nuevo \w y|strong="H1241"\w* \w el|strong="H1121"\w* aceite, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, \w a|strong="H3068"\w* las salas \w de|strong="H1121"\w* la \w casa|strong="H1004"\w* \w de|strong="H1121"\w* nuestro Dios; \w y|strong="H1241"\w* \w los|strong="H1121"\w* diezmos \w de|strong="H1121"\w* nuestra tierra \w a|strong="H3068"\w* \w los|strong="H1121"\w* levitas; porque ellos, \w los|strong="H1121"\w* levitas, toman \w los|strong="H1121"\w* diezmos en todas nuestras aldeas agrícolas.  
\v 38 \w El|strong="H3605"\w* \w sacerdote|strong="H3548"\w*, descendiente de Aarón, \w estará|strong="H3605"\w* con \w los|strong="H1992"\w* \w levitas|strong="H3881"\w* cuando \w éstos|strong="H1992"\w* tomen \w los|strong="H1992"\w* diezmos. \w Los|strong="H1992"\w* \w levitas|strong="H3881"\w* llevarán \w el|strong="H3605"\w* diezmo de \w los|strong="H1992"\w* diezmos \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* de nuestro Dios, \w a|strong="H3068"\w* \w las|strong="H1992"\w* habitaciones, \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* del tesoro.  
\v 39 Porque \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5973"\w* Israel y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5973"\w* \w Leví|strong="H3881"\w* llevarán la ofrenda mecida \w del|strong="H5973"\w* grano, \w del|strong="H5973"\w* \w vino|strong="H1961"\w* nuevo y \w del|strong="H5973"\w* aceite, \w a|strong="H3068"\w* las habitaciones donde \w están|strong="H1961"\w* \w los|strong="H1121"\w* utensilios \w del|strong="H5973"\w* santuario y \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H1121"\w* ministran, \w con|strong="H5973"\w* \w los|strong="H1121"\w* porteros y \w los|strong="H1121"\w* cantores. \w No|strong="H1961"\w* abandonaremos la \w casa|strong="H1004"\w* \w de|strong="H5973"\w* nuestro Dios.   
\c 11
\p
\v 1 \w Los|strong="H3427"\w* \w príncipes|strong="H8269"\w* \w del|strong="H4480"\w* \w pueblo|strong="H5971"\w* \w vivían|strong="H3427"\w* \w en|strong="H4480"\w* Jerusalén. \w El|strong="H5307"\w* resto \w del|strong="H4480"\w* \w pueblo|strong="H5971"\w* también \w echó|strong="H5307"\w* \w suertes|strong="H1486"\w* \w para|strong="H4480"\w* \w que|strong="H4480"\w* uno \w de|strong="H4480"\w* \w los|strong="H3427"\w* \w diez|strong="H6235"\w* \w habitara|strong="H3427"\w* \w en|strong="H4480"\w* Jerusalén, la \w ciudad|strong="H5892"\w* \w santa|strong="H6944"\w*, y \w nueve|strong="H8672"\w* \w partes|strong="H3027"\w* \w en|strong="H4480"\w* las demás \w ciudades|strong="H5892"\w*.  
\v 2 \w El|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w bendijo|strong="H1288"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* hombres \w que|strong="H5971"\w* \w se|strong="H5971"\w* ofrecieron \w voluntariamente|strong="H5068"\w* \w para|strong="H5971"\w* \w habitar|strong="H3427"\w* en Jerusalén.   
\p
\v 3 Estos son \w los|strong="H3427"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* la \w provincia|strong="H4082"\w* \w que|strong="H1121"\w* \w vivían|strong="H3427"\w* en Jerusalén; pero en las \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, cada uno \w vivía|strong="H3427"\w* en su posesión en sus \w ciudades|strong="H5892"\w*: \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3427"\w* \w levitas|strong="H3881"\w*, \w los|strong="H3427"\w* servidores del templo y \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w los|strong="H3427"\w* servidores \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w*.  
\v 4 Algunos \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* y \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w* \w vivían|strong="H3427"\w* en Jerusalén. \w De|strong="H1121"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* Ataías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Uzías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Zacarías|strong="H2148"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amarías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sefatías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mahalalel, \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Fares;  
\v 5 y \w Maasías|strong="H4641"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Baruc, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Colhoze, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Hazaías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Adaías|strong="H5718"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Joiarib|strong="H3114"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Zacarías|strong="H2148"\w*, \w hijo|strong="H1121"\w* del silonita.  
\v 6 \w Todos|strong="H3605"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Fares \w que|strong="H1121"\w* \w vivían|strong="H3427"\w* en Jerusalén eran cuatrocientos \w sesenta|strong="H8346"\w* y \w ocho|strong="H8083"\w* \w hombres|strong="H1121"\w* \w valientes|strong="H2428"\w*.   
\p
\v 7 Estos son \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w*: \w Salú|strong="H5543"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mesulam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joed, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Pedaías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Colaías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Maasías|strong="H4641"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Itiel, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jesaías|strong="H3470"\w*.  
\v 8 Después de él, \w Gabbai|strong="H1373"\w* y \w Sallai|strong="H1373"\w*, \w novecientos|strong="H8672"\w* \w veintiocho|strong="H6242"\w*.  
\v 9 \w Joel|strong="H3100"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Zicri \w era|strong="H1121"\w* su supervisor; \w y|strong="H5921"\w* \w Judá|strong="H3063"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Hasenúa \w era|strong="H1121"\w* \w el|strong="H5921"\w* \w segundo|strong="H4932"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*.   
\p
\v 10 \w De|strong="H4480"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*: \w Jedaías|strong="H3048"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Joiarib|strong="H3114"\w*, Jacín,  
\v 11 \w Seraías|strong="H8304"\w* \w hijo|strong="H1121"\w* \w de|strong="H5057"\w* \w Hilcías|strong="H2518"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5057"\w* Mesulam, \w hijo|strong="H1121"\w* \w de|strong="H5057"\w* \w Sadoc|strong="H6659"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5057"\w* Meraiot, \w hijo|strong="H1121"\w* \w de|strong="H5057"\w* Ahitub, jefe \w de|strong="H5057"\w* la \w casa|strong="H1004"\w* \w de|strong="H5057"\w* Dios,  
\v 12 y sus hermanos \w que|strong="H1121"\w* \w hacían|strong="H6213"\w* la \w obra|strong="H4399"\w* \w de|strong="H1121"\w* la \w casa|strong="H1004"\w*, \w ochocientos|strong="H8083"\w* \w veintidós|strong="H6242"\w*; y \w Adaías|strong="H5718"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jeroham|strong="H3395"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Pelalías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amzi, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Zacarías|strong="H2148"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Pashur|strong="H6583"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Malquías,  
\v 13 y sus hermanos, \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las casas paternas, \w doscientos|strong="H3967"\w* cuarenta y \w dos|strong="H8147"\w* y Amashsai \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Azarel, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahzai, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Meshillemoth, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Immer,  
\v 14 \w y|strong="H5921"\w* sus hermanos, \w hombres|strong="H1368"\w* \w valientes|strong="H1368"\w*, \w ciento|strong="H3967"\w* \w veintiocho|strong="H6242"\w*; \w y|strong="H5921"\w* su \w jefe|strong="H6496"\w* \w era|strong="H1121"\w* Zabdiel, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Haggedolim.   
\p
\v 15 \w De|strong="H4480"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w Semaías|strong="H8098"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Hasub, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Azricam|strong="H5840"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Hasabías|strong="H2811"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Bunni|strong="H1138"\w*;  
\v 16 \w y|strong="H5921"\w* Sabetai \w y|strong="H5921"\w* \w Jozabad|strong="H3107"\w*, \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w jefes|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w*, \w que|strong="H5921"\w* tenían \w a|strong="H3068"\w* su cargo \w los|strong="H5921"\w* asuntos externos \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Dios;  
\v 17 y Matanías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mica, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Zabdi|strong="H2067"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Asaf, \w que|strong="H1121"\w* \w era|strong="H1121"\w* \w el|strong="H1121"\w* \w jefe|strong="H7218"\w* \w que|strong="H1121"\w* iniciaba la acción \w de|strong="H1121"\w* gracias \w en|strong="H8462"\w* la \w oración|strong="H8605"\w*, y Bacbuquías, \w el|strong="H1121"\w* \w segundo|strong="H4932"\w* entre sus hermanos; y Abda \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Sammúa|strong="H8051"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Galal, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jedutún.  
\v 18 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* de \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w santa|strong="H6944"\w* eran \w doscientos|strong="H3967"\w* \w ochenta|strong="H8084"\w* y cuatro.   
\p
\v 19 Además, los guardianes de las \w puertas|strong="H8179"\w*, Acub, \w Talmón|strong="H2929"\w* y sus hermanos, que vigilaban las \w puertas|strong="H8179"\w*, eran \w ciento|strong="H3967"\w* \w setenta|strong="H7657"\w* y \w dos|strong="H8147"\w*.  
\v 20 \w El|strong="H3605"\w* resto de \w Israel|strong="H3478"\w*, de \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y de \w los|strong="H3605"\w* \w levitas|strong="H3881"\w*, estaban en \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w*, \w cada|strong="H3605"\w* uno en su \w heredad|strong="H5159"\w*.  
\v 21 Pero \w los|strong="H3427"\w* servidores \w del|strong="H5921"\w* templo \w vivían|strong="H3427"\w* \w en|strong="H5921"\w* Ofel, \w y|strong="H5921"\w* Ziha \w y|strong="H5921"\w* Gishpa \w estaban|strong="H3427"\w* \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w los|strong="H3427"\w* servidores \w del|strong="H5921"\w* templo.   
\p
\v 22 \w El|strong="H1121"\w* supervisor \w de|strong="H5048"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* en Jerusalén \w era|strong="H1121"\w* Uzi \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* \w Bani|strong="H1137"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* \w Hasabías|strong="H2811"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Matanías, \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* Mica, \w de|strong="H5048"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5048"\w* Asaf, \w los|strong="H1121"\w* \w cantores|strong="H7891"\w*, \w estaba|strong="H1004"\w* \w a|strong="H3068"\w* cargo \w de|strong="H5048"\w* \w los|strong="H1121"\w* asuntos \w de|strong="H5048"\w* la \w casa|strong="H1004"\w* \w de|strong="H5048"\w* Dios.  
\v 23 \w Porque|strong="H3588"\w* \w había|strong="H3588"\w* un \w mandamiento|strong="H4687"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w y|strong="H3588"\w* una provisión establecida \w para|strong="H5921"\w* \w los|strong="H5921"\w* \w cantores|strong="H7891"\w*, \w como|strong="H3588"\w* \w cada|strong="H1697"\w* \w día|strong="H3117"\w* \w lo|strong="H1697"\w* requería.  
\v 24 Petaías, \w hijo|strong="H1121"\w* \w de|strong="H1697"\w* Meshezabel, \w de|strong="H1697"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1697"\w* \w Zera|strong="H2226"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w*, estaba \w al|strong="H4428"\w* \w lado|strong="H3027"\w* del \w rey|strong="H4428"\w* en \w todos|strong="H3605"\w* \w los|strong="H1121"\w* asuntos del \w pueblo|strong="H5971"\w*.   
\p
\v 25 En cuanto \w a|strong="H3068"\w* las \w aldeas|strong="H1323"\w* con sus \w campos|strong="H7704"\w*, algunos \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* \w vivían|strong="H3427"\w* en Quiriat Arba y sus pueblos, en \w Dibón|strong="H1769"\w* y sus pueblos, en Jekabzeel y sus \w aldeas|strong="H1323"\w*,  
\v 26 en \w Jesúa|strong="H3442"\w*, en \w Moladah|strong="H4137"\w*, Bet Pelet,  
\v 27 en Hazar Shual en Beersheba y sus \w aldeas|strong="H1323"\w*,  
\v 28 en Ziklag, en Meconah y sus \w aldeas|strong="H1323"\w*,  
\v 29 en En Rimmon, en Zorah, en Jarmuth,  
\v 30 \w Zanoah|strong="H2182"\w*, \w Adullam|strong="H5725"\w* \w y|strong="H5704"\w* sus \w aldeas|strong="H1323"\w*, Lachish \w y|strong="H5704"\w* sus \w campos|strong="H7704"\w*, \w y|strong="H5704"\w* Azekah \w y|strong="H5704"\w* sus \w aldeas|strong="H1323"\w*. \w Y|strong="H3068"\w* acamparon \w desde|strong="H5704"\w* Beerseba \w hasta|strong="H5704"\w* el \w valle|strong="H1516"\w* \w de|strong="H5704"\w* Hinom.  
\v 31 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w* también vivían desde Geba, en Micmas y Aija, y en Betel y sus pueblos,  
\v 32 en Anatot, \w Nob|strong="H5011"\w*, Ananías,  
\v 33 Hazor, \w Ramá|strong="H7414"\w*, Gittaim,  
\v 34 \w Hadid|strong="H2307"\w*, Zeboim, Neballat,  
\v 35 \w Lod|strong="H3850"\w* y Ono, el \w valle|strong="H1516"\w* de los artesanos.  
\v 36 \w De|strong="H4480"\w* los \w levitas|strong="H3881"\w*, ciertas divisiones \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* \w se|strong="H4480"\w* establecieron \w en|strong="H4480"\w* el territorio \w de|strong="H4480"\w* \w Benjamín|strong="H1144"\w*.   
\c 12
\p
\v 1 Estos son \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* y \w levitas|strong="H3881"\w* \w que|strong="H1121"\w* \w subieron|strong="H5927"\w* \w con|strong="H5973"\w* \w Zorobabel|strong="H2216"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Salatiel, y \w con|strong="H5973"\w* \w Jesúa|strong="H3442"\w*: \w Seraías|strong="H8304"\w*, \w Jeremías|strong="H3414"\w*, \w Esdras|strong="H5830"\w*,  
\v 2 Amarías, \w Malluch|strong="H4409"\w*, Hattush,  
\v 3 Secanías, \w Rehum|strong="H7348"\w*, Meremot,  
\v 4 \w Iddo|strong="H5714"\w*, Ginnethoi, Abías,  
\v 5 Mijamín, Maadia, Bilgah,  
\v 6 \w Semaías|strong="H8098"\w*, \w Joiarib|strong="H3114"\w*, \w Jedaías|strong="H3048"\w*,  
\v 7 Sallu, Amok, Hilkiah y \w Jedaías|strong="H3048"\w*. Estos eran los \w jefes|strong="H7218"\w* de los \w sacerdotes|strong="H3548"\w* y de sus hermanos en los \w días|strong="H3117"\w* de \w Jesúa|strong="H3442"\w*.   
\p
\v 8 \w Además|strong="H5921"\w*, \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* eran \w Jesúa|strong="H3442"\w*, Binúi, \w Cadmiel|strong="H6934"\w*, \w Serebías|strong="H8274"\w*, \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* Matanías, \w que|strong="H1931"\w* estaba \w a|strong="H3068"\w* cargo \w de|strong="H5921"\w* \w los|strong="H5921"\w* cantos \w de|strong="H5921"\w* acción \w de|strong="H5921"\w* gracias, \w él|strong="H1931"\w* \w y|strong="H5921"\w* \w sus|strong="H1931"\w* hermanos.  
\v 9 También Bakbucías y Unno, sus hermanos, estaban cerca \w de|strong="H5048"\w* ellos según sus cargos.  
\v 10 \w Jesúa|strong="H3442"\w* fue padre de Joiaquim, y Joiaquim fue padre de Eliasib, y Eliasib fue padre de Joiada,  
\v 11 y Joiada fue padre de Jonatán, y Jonatán fue padre de Jaddua.   
\p
\v 12 En \w los|strong="H1961"\w* \w días|strong="H3117"\w* de Joiakim \w había|strong="H1961"\w* \w sacerdotes|strong="H3548"\w*, \w jefes|strong="H7218"\w* de familia de \w los|strong="H1961"\w* padres: de \w Seraías|strong="H8304"\w*, \w Meraías|strong="H4811"\w*; de \w Jeremías|strong="H3414"\w*, \w Hananías|strong="H2608"\w*;  
\v 13 de \w Esdras|strong="H5830"\w*, Mesulam; de Amarías, \w Johanán|strong="H3076"\w*;  
\v 14  de Malluchi, Jonatán; de \w Sebanías|strong="H7645"\w*, \w José|strong="H3130"\w*;  
\v 15 de \w Harim|strong="H2766"\w*, \w Adna|strong="H5733"\w*; de Meraiot, Helkai;  
\v 16 de \w Iddo|strong="H5714"\w*, \w Zacarías|strong="H2148"\w*; de Ginetón, Mesulam;  
\v 17 de Abías, Zicri; de \w Miniamin|strong="H4509"\w*, de Moadías, \w Piltai|strong="H6408"\w*;  
\v 18 de Bilgah, \w Sammua|strong="H8051"\w*; de \w Semaías|strong="H8098"\w*, Jonatán;  
\v 19 de \w Joiarib|strong="H3114"\w*, Mattenai; de \w Jedaías|strong="H3048"\w*, \w Uzzi|strong="H5813"\w*;  
\v 20 de Sallai, Kallai; de Amok, \w Heber|strong="H5677"\w*;  
\v 21 de \w Hilcías|strong="H2518"\w*, \w Hasabías|strong="H2811"\w*; de \w Jedaías|strong="H3048"\w*, Netanel.   
\p
\v 22 \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w*, \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* Eliasib, Joiada, \w Johanán|strong="H3110"\w* \w y|strong="H5921"\w* Jaddua, \w se|strong="H5921"\w* registraron \w los|strong="H5921"\w* \w jefes|strong="H7218"\w* \w de|strong="H5921"\w* familia; también \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w*, \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w reinado|strong="H4438"\w* \w de|strong="H5921"\w* \w Darío|strong="H1867"\w* \w el|strong="H5921"\w* Persa.  
\v 23 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Leví|strong="H3878"\w*, \w jefes|strong="H7218"\w* \w de|strong="H5921"\w* familia, fueron inscritos \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* crónicas, \w hasta|strong="H5704"\w* \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Eliasib.  
\v 24 \w Los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H5048"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*: \w Hasabías|strong="H2811"\w*, \w Serebías|strong="H8274"\w* y \w Jesúa|strong="H3442"\w* \w hijo|strong="H1121"\w* \w de|strong="H5048"\w* \w Cadmiel|strong="H6934"\w*, con sus hermanos cerca \w de|strong="H5048"\w* ellos, para \w alabar|strong="H1984"\w* y dar gracias según \w el|strong="H1121"\w* mandato \w de|strong="H5048"\w* \w David|strong="H1732"\w*, \w el|strong="H1121"\w* \w hombre|strong="H1121"\w* \w de|strong="H5048"\w* Dios, sección \w tras|strong="H5980"\w* sección.  
\v 25 Matanías, Bacbuquías, \w Abdías|strong="H5662"\w*, Mesulam, \w Talmón|strong="H2929"\w* y Acub eran guardianes de las \w puertas|strong="H8179"\w*, que vigilaban los almacenes de las \w puertas|strong="H8179"\w*.  
\v 26 Estos eran en \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H1121"\w* Joiaquim \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jesúa|strong="H3442"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Josadac, y en \w los|strong="H1121"\w* \w días|strong="H3117"\w* del \w gobernador|strong="H6346"\w* \w Nehemías|strong="H5166"\w* y del \w sacerdote|strong="H3548"\w* y \w escriba|strong="H5608"\w* \w Esdras|strong="H5830"\w*.   
\p
\v 27 En \w la|strong="H3605"\w* dedicación del \w muro|strong="H2346"\w* \w de|strong="H5035"\w* Jerusalén, \w buscaron|strong="H1245"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w de|strong="H5035"\w* \w todos|strong="H3605"\w* sus \w lugares|strong="H4725"\w* para traerlos \w a|strong="H3068"\w* Jerusalén \w a|strong="H3068"\w* \w celebrar|strong="H6213"\w* \w la|strong="H3605"\w* dedicación con \w alegría|strong="H8057"\w*, dando gracias y cantando, con \w címbalos|strong="H4700"\w*, instrumentos \w de|strong="H5035"\w* cuerda y \w arpas|strong="H3658"\w*.  
\v 28 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w cantores|strong="H7891"\w* \w se|strong="H4480"\w* reunieron, tanto \w de|strong="H4480"\w* la llanura \w que|strong="H4480"\w* rodea \w a|strong="H3068"\w* Jerusalén como \w de|strong="H4480"\w* las \w aldeas|strong="H2691"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* netofatitas;  
\v 29 también \w de|strong="H3588"\w* Bet \w Gilgal|strong="H1537"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w campos|strong="H7704"\w* \w de|strong="H3588"\w* Geba \w y|strong="H3588"\w* Azmavet, \w porque|strong="H3588"\w* \w los|strong="H1992"\w* \w cantores|strong="H7891"\w* \w se|strong="H1992"\w* habían construido \w aldeas|strong="H2691"\w* \w alrededor|strong="H5439"\w* \w de|strong="H3588"\w* Jerusalén.  
\v 30 Los \w sacerdotes|strong="H3548"\w* y los \w levitas|strong="H3881"\w* \w se|strong="H5971"\w* purificaron, y purificaron el \w pueblo|strong="H5971"\w*, las \w puertas|strong="H8179"\w* y el \w muro|strong="H2346"\w*.   
\p
\v 31 Entonces hice \w subir|strong="H5927"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w príncipes|strong="H8269"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w al|strong="H5921"\w* \w muro|strong="H2346"\w*, \w y|strong="H5921"\w* designé \w dos|strong="H8147"\w* \w grandes|strong="H1419"\w* compañías \w que|strong="H5921"\w* dieron gracias \w y|strong="H5921"\w* \w fueron|strong="H5927"\w* \w en|strong="H5921"\w* procesión. Una iba \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w muro|strong="H2346"\w*, \w hacia|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w del|strong="H5921"\w* estiércol;  
\v 32 y tras ellos \w iban|strong="H3212"\w* Oseas, con la mitad \w de|strong="H8269"\w* los \w príncipes|strong="H8269"\w* \w de|strong="H8269"\w* \w Judá|strong="H3063"\w*,  
\v 33 y \w Azarías|strong="H5838"\w*, \w Esdras|strong="H5830"\w* y Mesulam,  
\v 34 \w Judá|strong="H3063"\w*, \w Benjamín|strong="H1144"\w*, \w Semaías|strong="H8098"\w*, \w Jeremías|strong="H3414"\w*,  
\v 35 y algunos \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* con \w trompetas|strong="H2689"\w*: \w Zacarías|strong="H2148"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jonatán, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Semaías|strong="H8098"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Matanías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Micaías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zacur, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Asaf;  
\v 36 y sus hermanos, \w Semaías|strong="H8098"\w*, Azarel, \w Milalai|strong="H4450"\w*, \w Gilalai|strong="H1562"\w*, \w Maai|strong="H4597"\w*, Netanel, \w Judá|strong="H3063"\w* y \w Hanani|strong="H2607"\w*, con los \w instrumentos|strong="H3627"\w* musicales \w de|strong="H6440"\w* \w David|strong="H1732"\w*, el hombre \w de|strong="H6440"\w* Dios; y el \w escriba|strong="H5608"\w* \w Esdras|strong="H5830"\w* estaba \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos.  
\v 37 \w Por|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w del|strong="H5921"\w* manantial, \w y|strong="H5921"\w* \w en|strong="H5921"\w* línea recta \w delante|strong="H5048"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w subieron|strong="H5927"\w* \w por|strong="H5921"\w* \w las|strong="H5921"\w* escaleras \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*, \w en|strong="H5921"\w* \w la|strong="H5921"\w* subida \w del|strong="H5921"\w* \w muro|strong="H2346"\w*, \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*, \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w*, \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w este|strong="H4217"\w*.   
\p
\v 38 \w La|strong="H5921"\w* \w otra|strong="H8145"\w* compañía \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* daban gracias salió \w a|strong="H3068"\w* su encuentro, \w y|strong="H5921"\w* yo tras \w ellos|strong="H5921"\w*, \w con|strong="H5921"\w* \w la|strong="H5921"\w* mitad \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w muro|strong="H2346"\w*, \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w torre|strong="H4026"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* hornos, \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w muro|strong="H2346"\w* \w ancho|strong="H7342"\w*,  
\v 39 \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* Efraín, \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* vieja, \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w del|strong="H5921"\w* \w pescado|strong="H1709"\w*, \w la|strong="H5921"\w* \w torre|strong="H4026"\w* \w de|strong="H5921"\w* Hananel, \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w torre|strong="H4026"\w* \w de|strong="H5921"\w* Hammea, \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w*; \w y|strong="H5921"\w* \w se|strong="H5921"\w* detuvieron \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia.  
\v 40 Las \w dos|strong="H8147"\w* compañías \w de|strong="H5973"\w* \w los|strong="H5973"\w* que daban gracias \w en|strong="H5973"\w* la \w casa|strong="H1004"\w* \w de|strong="H5973"\w* Dios \w estaban|strong="H5975"\w* \w en|strong="H5973"\w* \w pie|strong="H5975"\w*, y yo y la mitad \w de|strong="H5973"\w* \w los|strong="H5973"\w* jefes \w conmigo|strong="H5973"\w*;  
\v 41 y los \w sacerdotes|strong="H3548"\w*, Eliaquim, \w Maasías|strong="H4641"\w*, \w Miniamin|strong="H4509"\w*, Micaías, Elioenai, \w Zacarías|strong="H2148"\w* y \w Hananías|strong="H2608"\w*, con \w trompetas|strong="H2689"\w*;  
\v 42 y \w Maasías|strong="H4641"\w*, \w Semaías|strong="H8098"\w*, Eleazar, Uzi, \w Johanán|strong="H3076"\w*, Malquías, \w Elam|strong="H5867"\w* y \w Ezer|strong="H5829"\w*. Los \w cantores|strong="H7891"\w* \w cantaban|strong="H7891"\w* en voz alta, con Jezrahías, su supervisor.  
\v 43 \w Aquel|strong="H1931"\w* \w día|strong="H3117"\w* ofrecieron \w grandes|strong="H1419"\w* \w sacrificios|strong="H2077"\w* \w y|strong="H1571"\w* \w se|strong="H1931"\w* regocijaron, \w porque|strong="H3588"\w* Dios \w los|strong="H3588"\w* \w había|strong="H3588"\w* hecho gozar \w con|strong="H3588"\w* \w gran|strong="H1419"\w* \w alegría|strong="H8057"\w*; \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w se|strong="H1931"\w* regocijaron las mujeres \w y|strong="H1571"\w* \w los|strong="H3588"\w* \w niños|strong="H3206"\w*, \w de|strong="H3588"\w* modo \w que|strong="H3588"\w* \w la|strong="H1931"\w* \w alegría|strong="H8057"\w* \w de|strong="H3588"\w* Jerusalén \w se|strong="H1931"\w* \w oyó|strong="H8085"\w* \w hasta|strong="H1931"\w* muy \w lejos|strong="H7350"\w*.   
\p
\v 44 \w Aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w se|strong="H1931"\w* designaron hombres \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* salas \w para|strong="H5921"\w* \w los|strong="H5921"\w* tesoros, \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w ofrendas|strong="H8641"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* olas, \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w primicias|strong="H7225"\w* \w y|strong="H3588"\w* \w para|strong="H5921"\w* \w los|strong="H5921"\w* diezmos, \w a|strong="H3068"\w* fin \w de|strong="H5921"\w* recoger \w en|strong="H5921"\w* \w ellas|strong="H5921"\w*, \w según|strong="H5921"\w* \w los|strong="H5921"\w* \w campos|strong="H7704"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w*, \w las|strong="H5921"\w* porciones señaladas \w por|strong="H5921"\w* \w la|strong="H1931"\w* \w ley|strong="H8451"\w* \w para|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w*; \w porque|strong="H3588"\w* \w Judá|strong="H3063"\w* \w se|strong="H1931"\w* alegró \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w que|strong="H3588"\w* servían.  
\v 45 Ellos cumplían \w el|strong="H1121"\w* deber \w de|strong="H1121"\w* su Dios y \w el|strong="H1121"\w* deber \w de|strong="H1121"\w* \w la|strong="H8104"\w* purificación, y lo mismo hacían \w los|strong="H1121"\w* \w cantores|strong="H7891"\w* y \w los|strong="H1121"\w* \w porteros|strong="H7778"\w*, según \w el|strong="H1121"\w* mandato \w de|strong="H1121"\w* \w David|strong="H1732"\w* y \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w* su \w hijo|strong="H1121"\w*.  
\v 46 \w Porque|strong="H3588"\w* \w en|strong="H3588"\w* \w los|strong="H3588"\w* \w días|strong="H3117"\w* \w de|strong="H3588"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* Asaf \w de|strong="H3588"\w* antaño \w había|strong="H3588"\w* un \w jefe|strong="H7218"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w cantores|strong="H7891"\w*, \w y|strong="H3588"\w* cantos \w de|strong="H3588"\w* \w alabanza|strong="H8416"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* acción \w de|strong="H3588"\w* gracias \w a|strong="H3068"\w* Dios.  
\v 47 \w Todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, en \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5414"\w* \w Zorobabel|strong="H2216"\w* y en \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5414"\w* \w Nehemías|strong="H5166"\w*, \w dio|strong="H5414"\w* las porciones \w de|strong="H5414"\w* \w los|strong="H1121"\w* \w cantores|strong="H7891"\w* y \w de|strong="H5414"\w* \w los|strong="H1121"\w* \w porteros|strong="H7778"\w*, según \w cada|strong="H3605"\w* \w día|strong="H3117"\w*; y apartaron \w lo|strong="H1697"\w* \w que|strong="H3117"\w* \w era|strong="H1121"\w* \w para|strong="H5414"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*; y \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* apartaron \w lo|strong="H1697"\w* \w que|strong="H3117"\w* \w era|strong="H1121"\w* \w para|strong="H5414"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5414"\w* Aarón.   
\c 13
\p
\v 1 \w Aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w leyeron|strong="H7121"\w* \w en|strong="H5704"\w* \w el|strong="H1931"\w* \w libro|strong="H5612"\w* \w de|strong="H5704"\w* \w Moisés|strong="H4872"\w* \w a|strong="H3068"\w* oídos del \w pueblo|strong="H5971"\w*, \w y|strong="H5704"\w* \w se|strong="H1931"\w* encontró \w escrito|strong="H3789"\w* \w en|strong="H5704"\w* \w él|strong="H1931"\w* \w que|strong="H1931"\w* un amonita \w y|strong="H5704"\w* un \w moabita|strong="H4125"\w* \w no|strong="H3808"\w* debían entrar \w en|strong="H5704"\w* \w la|strong="H1931"\w* asamblea \w de|strong="H5704"\w* Dios \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*,  
\v 2 \w porque|strong="H3588"\w* \w no|strong="H3808"\w* salieron \w al|strong="H5921"\w* encuentro \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w con|strong="H5921"\w* \w pan|strong="H3899"\w* \w y|strong="H3588"\w* \w agua|strong="H4325"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* contrataron \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w* \w para|strong="H5921"\w* maldecirlos; \w sin|strong="H3808"\w* embargo, nuestro Dios convirtió \w la|strong="H5921"\w* \w maldición|strong="H7045"\w* \w en|strong="H5921"\w* \w bendición|strong="H1293"\w*.  
\v 3 \w Sucedió|strong="H1961"\w* \w que|strong="H1961"\w* \w cuando|strong="H1961"\w* \w escucharon|strong="H8085"\w* \w la|strong="H3605"\w* \w ley|strong="H8451"\w*, separaron de \w Israel|strong="H3478"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* multitud mixta.   
\p
\v 4 \w Antes|strong="H6440"\w* \w de|strong="H6440"\w* \w esto|strong="H2088"\w*, el \w sacerdote|strong="H3548"\w* Eliasib, \w que|strong="H2088"\w* había sido designado como encargado \w de|strong="H6440"\w* las habitaciones \w de|strong="H6440"\w* la \w casa|strong="H1004"\w* \w de|strong="H6440"\w* nuestro Dios, siendo aliado \w de|strong="H6440"\w* \w Tobías|strong="H2900"\w*,  
\v 5 \w había|strong="H1961"\w* preparado \w para|strong="H5414"\w* \w él|strong="H6213"\w* una \w gran|strong="H1419"\w* sala, en la \w que|strong="H1961"\w* \w antes|strong="H6440"\w* \w se|strong="H1961"\w* depositaban las \w ofrendas|strong="H8641"\w* \w de|strong="H6440"\w* comida, \w el|strong="H6213"\w* \w incienso|strong="H3828"\w*, \w los|strong="H1961"\w* \w vasos|strong="H3627"\w* y \w los|strong="H1961"\w* diezmos del \w grano|strong="H1715"\w*, \w el|strong="H6213"\w* \w vino|strong="H1961"\w* nuevo y \w el|strong="H6213"\w* \w aceite|strong="H3323"\w*, \w que|strong="H1961"\w* \w se|strong="H1961"\w* \w daban|strong="H5414"\w* \w por|strong="H6440"\w* mandato \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w levitas|strong="H3881"\w*, \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w cantores|strong="H7891"\w* y \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w porteros|strong="H7778"\w*; y las \w ofrendas|strong="H8641"\w* onduladas \w para|strong="H5414"\w* \w los|strong="H1961"\w* \w sacerdotes|strong="H3548"\w*.  
\v 6 \w Pero|strong="H3588"\w* \w en|strong="H4480"\w* \w todo|strong="H3605"\w* \w esto|strong="H2088"\w* \w no|strong="H3808"\w* \w estuve|strong="H1961"\w* \w en|strong="H4480"\w* Jerusalén, \w porque|strong="H3588"\w* \w en|strong="H4480"\w* \w el|strong="H3588"\w* \w año|strong="H8141"\w* \w treinta|strong="H7970"\w* \w y|strong="H3588"\w* \w dos|strong="H8147"\w* \w de|strong="H4480"\w* Artajerjes, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Babilonia, \w fui|strong="H1961"\w* \w al|strong="H4480"\w* \w rey|strong="H4428"\w*; \w y|strong="H3588"\w* \w después|strong="H1961"\w* \w de|strong="H4480"\w* algunos \w días|strong="H3117"\w* \w pedí|strong="H7592"\w* permiso \w al|strong="H4480"\w* \w rey|strong="H4428"\w*,  
\v 7  y llegué \w a|strong="H3068"\w* Jerusalén, y comprendí \w el|strong="H6213"\w* \w mal|strong="H7451"\w* \w que|strong="H2691"\w* Eliasib \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w a|strong="H3068"\w* \w Tobías|strong="H2900"\w*, al prepararle una habitación en los \w atrios|strong="H2691"\w* \w de|strong="H7451"\w* la \w casa|strong="H1004"\w* \w de|strong="H7451"\w* Dios.  
\v 8 Esto \w me|strong="H4480"\w* afligió \w mucho|strong="H3966"\w*. \w Por|strong="H4480"\w* eso \w eché|strong="H7993"\w* \w de|strong="H4480"\w* \w la|strong="H3605"\w* habitación \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w enseres|strong="H3627"\w* \w de|strong="H4480"\w* \w Tobías|strong="H2900"\w*.  
\v 9 \w Luego|strong="H7725"\w* ordené, y ellos limpiaron las habitaciones. Llevé \w a|strong="H3068"\w* ellas los utensilios de la \w casa|strong="H1004"\w* de Dios, con las ofrendas de comida y el \w incienso|strong="H3828"\w* de nuevo.   
\p
\v 10 \w Me|strong="H3588"\w* \w di|strong="H5414"\w* cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* las porciones \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w levitas|strong="H3881"\w* \w no|strong="H3808"\w* \w se|strong="H3045"\w* les habían \w dado|strong="H5414"\w*, \w de|strong="H3588"\w* modo \w que|strong="H3588"\w* \w los|strong="H3588"\w* \w levitas|strong="H3881"\w* \w y|strong="H3588"\w* \w los|strong="H3588"\w* \w cantores|strong="H7891"\w*, \w que|strong="H3588"\w* \w hacían|strong="H6213"\w* \w el|strong="H3588"\w* trabajo, habían huido cada uno \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w campo|strong="H7704"\w*.  
\v 11 Entonces discutí \w con|strong="H5921"\w* \w los|strong="H5921"\w* jefes \w y|strong="H5921"\w* dije: “¿\w Por|strong="H5921"\w* \w qué|strong="H5921"\w* \w está|strong="H5975"\w* \w abandonada|strong="H5800"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Dios?” \w Los|strong="H5921"\w* reuní \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w puse|strong="H5975"\w* \w en|strong="H5921"\w* su lugar.  
\v 12 Entonces \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w* trajo \w el|strong="H3605"\w* diezmo del \w grano|strong="H1715"\w*, del \w vino|strong="H8492"\w* nuevo y del \w aceite|strong="H3323"\w* \w a|strong="H3068"\w* las arcas.  
\v 13 Puse \w como|strong="H3588"\w* tesoreros \w sobre|strong="H5921"\w* \w los|strong="H1121"\w* tesoros \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* Selemías \w y|strong="H3588"\w* \w al|strong="H5921"\w* \w escriba|strong="H5608"\w* \w Sadoc|strong="H6659"\w*, \w y|strong="H3588"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w a|strong="H3068"\w* Pedaías; \w y|strong="H3588"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w* \w a|strong="H3068"\w* \w Hanán|strong="H2605"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Zaccur, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Matanías; \w porque|strong="H3588"\w* eran \w tenidos|strong="H2803"\w* \w por|strong="H5921"\w* fieles, \w y|strong="H3588"\w* \w su|strong="H3588"\w* oficio \w era|strong="H1121"\w* repartir \w a|strong="H3068"\w* sus hermanos.   
\p
\v 14 \w Acuérdate|strong="H2142"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*, Dios \w mío|strong="H5921"\w*, \w en|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w a|strong="H3068"\w* \w esto|strong="H2063"\w*, \w y|strong="H5921"\w* \w no|strong="H6213"\w* \w borres|strong="H4229"\w* mis buenas obras \w que|strong="H5921"\w* he \w hecho|strong="H6213"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* Dios \w y|strong="H5921"\w* \w por|strong="H5921"\w* sus celebraciones.   
\p
\v 15 \w En|strong="H5921"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w* \w vi|strong="H7200"\w* \w a|strong="H3068"\w* algunos hombres \w que|strong="H5921"\w* pisaban lagares \w en|strong="H5921"\w* \w sábado|strong="H7676"\w* \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w que|strong="H5921"\w* \w traían|strong="H5921"\w* gavillas \w y|strong="H5921"\w* cargaban \w asnos|strong="H2543"\w* \w con|strong="H5921"\w* \w vino|strong="H3196"\w*, \w uvas|strong="H6025"\w*, \w higos|strong="H8384"\w* \w y|strong="H5921"\w* \w toda|strong="H3605"\w* clase \w de|strong="H5921"\w* cargas \w que|strong="H5921"\w* llevaban \w a|strong="H3068"\w* Jerusalén \w en|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* reposo; \w y|strong="H5921"\w* testifiqué \w contra|strong="H5921"\w* \w ellos|strong="H1992"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H5921"\w* vendían alimentos.  
\v 16 También \w vivían|strong="H3427"\w* allí algunos \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* Tiro, \w que|strong="H1121"\w* traían \w pescado|strong="H1709"\w* y \w toda|strong="H3605"\w* clase \w de|strong="H1121"\w* mercancías, y vendían en \w sábado|strong="H7676"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* y en Jerusalén.  
\v 17 \w Entonces|strong="H3117"\w* discutí con los nobles \w de|strong="H1697"\w* \w Judá|strong="H3063"\w* y les dije: “¿\w Qué|strong="H4100"\w* \w maldad|strong="H7451"\w* \w es|strong="H2088"\w* \w ésta|strong="H2088"\w* \w que|strong="H4100"\w* \w hacéis|strong="H6213"\w*, \w profanando|strong="H2490"\w* \w el|strong="H6213"\w* \w día|strong="H3117"\w* \w de|strong="H1697"\w* reposo?  
\v 18 ¿\w No|strong="H3808"\w* \w hicieron|strong="H6213"\w* \w esto|strong="H2063"\w* vuestros padres, \w y|strong="H5921"\w* \w no|strong="H3808"\w* trajo nuestro Dios \w todo|strong="H3605"\w* \w este|strong="H2063"\w* \w mal|strong="H7451"\w* \w sobre|strong="H5921"\w* \w nosotros|strong="H3605"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*? \w Sin|strong="H3808"\w* embargo, vosotros traéis \w más|strong="H5921"\w* \w ira|strong="H2740"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* \w al|strong="H5921"\w* profanar \w el|strong="H5921"\w* \w sábado|strong="H7676"\w*”.   
\p
\v 19 \w Sucedió|strong="H1961"\w* \w que|strong="H3808"\w* \w cuando|strong="H3117"\w* \w las|strong="H5921"\w* \w puertas|strong="H1817"\w* \w de|strong="H5921"\w* Jerusalén comenzaron \w a|strong="H3068"\w* oscurecerse \w antes|strong="H6440"\w* \w del|strong="H5921"\w* \w sábado|strong="H7676"\w*, mandé cerrar \w las|strong="H5921"\w* \w puertas|strong="H1817"\w* \w y|strong="H5921"\w* ordené \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* abrieran \w hasta|strong="H5704"\w* \w después|strong="H1961"\w* \w del|strong="H5921"\w* \w sábado|strong="H7676"\w*. \w Puse|strong="H5975"\w* \w a|strong="H3068"\w* algunos \w de|strong="H5921"\w* mis siervos \w a|strong="H3068"\w* cargo \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H1817"\w*, \w para|strong="H5704"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* introdujera \w ninguna|strong="H3808"\w* \w carga|strong="H4853"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* reposo.  
\v 20 Entonces \w los|strong="H3605"\w* mercaderes y vendedores de \w toda|strong="H3605"\w* clase de mercancías acamparon \w fuera|strong="H2351"\w* de Jerusalén \w una|strong="H6471"\w* \w o|strong="H3068"\w* \w dos|strong="H8147"\w* \w veces|strong="H6471"\w*.  
\v 21 \w Entonces|strong="H6256"\w* \w yo|strong="H4480"\w* testifiqué \w contra|strong="H5048"\w* \w ellos|strong="H3027"\w* y les dije: “¿\w Por|strong="H4069"\w* \w qué|strong="H4480"\w* \w os|strong="H4480"\w* quedáis \w alrededor|strong="H4480"\w* \w del|strong="H4480"\w* \w muro|strong="H2346"\w*? \w Si|strong="H3808"\w* volvéis \w a|strong="H3068"\w* hacerlo, \w os|strong="H4480"\w* \w echaré|strong="H7971"\w* \w mano|strong="H3027"\w*”. \w Desde|strong="H4480"\w* \w entonces|strong="H6256"\w*, \w no|strong="H3808"\w* vinieron \w en|strong="H4480"\w* \w sábado|strong="H7676"\w*.  
\v 22 Mandé \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* purificaran, \w y|strong="H1571"\w* \w que|strong="H5921"\w* vinieran \w a|strong="H3068"\w* \w guardar|strong="H8104"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w*, \w para|strong="H5921"\w* santificar \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* reposo. \w Acuérdate|strong="H2142"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w también|strong="H1571"\w* \w por|strong="H5921"\w* \w esto|strong="H2063"\w*, Dios \w mío|strong="H5921"\w*, \w y|strong="H1571"\w* perdóname \w según|strong="H5921"\w* \w la|strong="H5921"\w* grandeza \w de|strong="H5921"\w* tu amorosa bondad.   
\p
\v 23 En \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w* \w vi|strong="H7200"\w* \w también|strong="H1571"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w judíos|strong="H3064"\w* \w que|strong="H1571"\w* \w se|strong="H1992"\w* habían casado \w con|strong="H1571"\w* mujeres de Asdod, de Amón \w y|strong="H1571"\w* de Moab;  
\v 24 y sus \w hijos|strong="H1121"\w* \w hablaban|strong="H1696"\w* la mitad en \w el|strong="H1121"\w* idioma \w de|strong="H5971"\w* Asdod, y no podían \w hablar|strong="H1696"\w* en la \w lengua|strong="H3956"\w* \w de|strong="H5971"\w* \w los|strong="H1121"\w* judíos, sino según la \w lengua|strong="H3956"\w* \w de|strong="H5971"\w* cada \w pueblo|strong="H5971"\w*.  
\v 25 Yo discutí \w con|strong="H5973"\w* \w ellos|strong="H1992"\w*, \w los|strong="H1992"\w* maldije, golpeé \w a|strong="H3068"\w* algunos \w de|strong="H5973"\w* \w ellos|strong="H1992"\w*, \w les|strong="H1992"\w* arranqué \w el|strong="H5973"\w* cabello y \w les|strong="H1992"\w* \w hice|strong="H7650"\w* jurar \w por|strong="H5414"\w* Dios: “No \w daréis|strong="H5414"\w* vuestras \w hijas|strong="H1323"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w*, \w ni|strong="H5973"\w* \w tomaréis|strong="H5375"\w* \w sus|strong="H1992"\w* \w hijas|strong="H1323"\w* \w para|strong="H5414"\w* vuestros \w hijos|strong="H1121"\w*, \w ni|strong="H5973"\w* \w para|strong="H5414"\w* \w vosotros|strong="H5973"\w*.  
\v 26 ¿\w No|strong="H3808"\w* \w pecó|strong="H2398"\w* \w Salomón|strong="H8010"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w con|strong="H5921"\w* estas \w cosas|strong="H7227"\w*? \w Sin|strong="H3808"\w* embargo, \w entre|strong="H5921"\w* \w muchas|strong="H7227"\w* \w naciones|strong="H1471"\w* \w no|strong="H3808"\w* \w hubo|strong="H1961"\w* un \w rey|strong="H4428"\w* \w como|strong="H1571"\w* \w él|strong="H5921"\w*, \w y|strong="H1571"\w* \w fue|strong="H1961"\w* amado \w por|strong="H5921"\w* su Dios, \w y|strong="H1571"\w* Dios \w lo|strong="H3808"\w* \w hizo|strong="H5414"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*. \w Sin|strong="H3808"\w* embargo, \w las|strong="H5921"\w* mujeres \w extranjeras|strong="H5237"\w* \w lo|strong="H3808"\w* \w hicieron|strong="H5414"\w* \w pecar|strong="H2398"\w*.  
\v 27 ¿Debemos, pues, escucharte para \w hacer|strong="H6213"\w* \w todo|strong="H3605"\w* \w este|strong="H2063"\w* \w gran|strong="H1419"\w* \w mal|strong="H7451"\w*, para transgredir \w a|strong="H3068"\w* nuestro Dios casándonos con mujeres \w extranjeras|strong="H5237"\w*?”   
\p
\v 28 Uno \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Joiada, \w hijo|strong="H1121"\w* \w del|strong="H5921"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* Eliasib, \w era|strong="H1121"\w* \w yerno|strong="H2860"\w* \w de|strong="H5921"\w* Sanbalat \w el|strong="H5921"\w* \w horonita|strong="H2772"\w*; \w por|strong="H5921"\w* eso \w lo|strong="H5921"\w* eché \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 29 \w Acuérdate|strong="H2142"\w* \w de|strong="H5921"\w* \w ellos|strong="H1992"\w*, Dios \w mío|strong="H5921"\w*, \w porque|strong="H5921"\w* han profanado \w el|strong="H5921"\w* \w sacerdocio|strong="H3550"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w alianza|strong="H1285"\w* \w del|strong="H5921"\w* \w sacerdocio|strong="H3550"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w levitas|strong="H3881"\w*.   
\p
\v 30 Así \w los|strong="H3605"\w* \w limpié|strong="H2891"\w* de \w todos|strong="H3605"\w* \w los|strong="H3605"\w* extranjeros y señalé \w los|strong="H3605"\w* deberes para \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y para \w los|strong="H3605"\w* \w levitas|strong="H3881"\w*, \w cada|strong="H3605"\w* uno \w en|strong="H5975"\w* su trabajo;  
\v 31 y para la \w ofrenda|strong="H7133"\w* \w de|strong="H6256"\w* \w leña|strong="H6086"\w*, en los \w tiempos|strong="H6256"\w* \w señalados|strong="H2163"\w*, y para las primicias. \w Acuérdate|strong="H2142"\w* \w de|strong="H6256"\w* mí, Dios mío, para \w bien|strong="H2896"\w*.   