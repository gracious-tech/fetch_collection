\p
\v 1 \w En|strong="H5704"\w* \w los|strong="H1961"\w* \w días|strong="H3117"\w* \w de|strong="H5704"\w* Asuero (\w éste|strong="H1931"\w* \w es|strong="H1961"\w* Asuero, \w que|strong="H1931"\w* \w reinó|strong="H4427"\w* \w desde|strong="H5704"\w* \w la|strong="H1931"\w* India \w hasta|strong="H5704"\w* \w Etiopía|strong="H3568"\w*, \w sobre|strong="H1961"\w* \w ciento|strong="H3967"\w* \w veintisiete|strong="H6242"\w* \w provincias|strong="H4082"\w*),  
\v 2 \w en|strong="H5921"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w*, \w cuando|strong="H3117"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero \w se|strong="H1992"\w* sentó \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w su|strong="H1992"\w* \w reino|strong="H4438"\w*, \w que|strong="H5921"\w* estaba \w en|strong="H5921"\w* \w el|strong="H5921"\w* palacio \w de|strong="H5921"\w* Susa,  
\v 3 en \w el|strong="H3605"\w* tercer \w año|strong="H8141"\w* \w de|strong="H6440"\w* su \w reinado|strong="H4427"\w*, \w hizo|strong="H6213"\w* una fiesta para \w todos|strong="H3605"\w* sus \w príncipes|strong="H8269"\w* y sus servidores; \w el|strong="H3605"\w* \w ejército|strong="H2426"\w* \w de|strong="H6440"\w* \w Persia|strong="H6539"\w* y \w de|strong="H6440"\w* \w Media|strong="H4074"\w*, \w los|strong="H3605"\w* nobles y \w los|strong="H3605"\w* \w príncipes|strong="H8269"\w* \w de|strong="H6440"\w* las \w provincias|strong="H4082"\w* estaban \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w él|strong="H3605"\w*.  
\v 4 Exhibió las \w riquezas|strong="H6239"\w* de su \w glorioso|strong="H3519"\w* \w reino|strong="H4438"\w* \w y|strong="H3519"\w* el honor de su excelente majestad \w muchos|strong="H7227"\w* \w días|strong="H3117"\w*, \w hasta|strong="H3117"\w* \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* \w días|strong="H3117"\w*.   
\p
\v 5 \w Cuando|strong="H3117"\w* \w se|strong="H5971"\w* cumplieron \w estos|strong="H3605"\w* \w días|strong="H3117"\w*, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w hizo|strong="H6213"\w* \w una|strong="H4672"\w* fiesta \w de|strong="H5704"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w para|strong="H5704"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* presente \w en|strong="H5704"\w* \w el|strong="H3605"\w* palacio \w de|strong="H5704"\w* Susa, tanto \w el|strong="H3605"\w* \w grande|strong="H1419"\w* \w como|strong="H5704"\w* \w el|strong="H3605"\w* \w pequeño|strong="H6996"\w*, \w en|strong="H5704"\w* \w el|strong="H3605"\w* \w patio|strong="H2691"\w* del jardín del palacio \w real|strong="H4428"\w*.  
\v 6 Había colgaduras \w de|strong="H5921"\w* material \w blanco|strong="H2353"\w* \w y|strong="H5921"\w* azul, sujetas \w con|strong="H5921"\w* cordones \w de|strong="H5921"\w* lino fino \w y|strong="H5921"\w* púrpura \w a|strong="H3068"\w* \w anillos|strong="H1550"\w* \w de|strong="H5921"\w* \w plata|strong="H3701"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w columnas|strong="H5982"\w* \w de|strong="H5921"\w* mármol. \w Los|strong="H5921"\w* divanes eran \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w plata|strong="H3701"\w*, \w sobre|strong="H5921"\w* un pavimento \w de|strong="H5921"\w* mármol rojo, \w blanco|strong="H2353"\w*, amarillo \w y|strong="H5921"\w* negro.  
\v 7 Les daban \w de|strong="H8138"\w* \w beber|strong="H8248"\w* en \w vasos|strong="H3627"\w* \w de|strong="H8138"\w* \w oro|strong="H2091"\w* \w de|strong="H8138"\w* diversas clases, incluso \w vino|strong="H3196"\w* \w real|strong="H4428"\w* en abundancia, según la generosidad del \w rey|strong="H4428"\w*.  
\v 8 \w De|strong="H5921"\w* acuerdo \w con|strong="H5921"\w* \w la|strong="H5921"\w* ley, \w la|strong="H5921"\w* bebida \w no|strong="H6213"\w* era obligatoria, \w pues|strong="H3588"\w* \w así|strong="H3651"\w* \w lo|strong="H5921"\w* \w había|strong="H3588"\w* ordenado \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* funcionarios \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w casa|strong="H1004"\w*, \w para|strong="H5921"\w* \w que|strong="H3588"\w* hicieran \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w cada|strong="H3605"\w* uno quisiera.   
\p
\v 9 \w También|strong="H1571"\w* \w la|strong="H1571"\w* \w reina|strong="H4436"\w* Vasti \w hizo|strong="H6213"\w* un \w banquete|strong="H4960"\w* para las mujeres de \w la|strong="H1571"\w* \w casa|strong="H1004"\w* \w real|strong="H4428"\w* \w que|strong="H1571"\w* pertenecía \w al|strong="H4428"\w* \w rey|strong="H4428"\w* Asuero.   
\p
\v 10 El \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, \w cuando|strong="H3117"\w* el \w corazón|strong="H3820"\w* del \w rey|strong="H4428"\w* estaba \w alegre|strong="H2896"\w* \w por|strong="H6440"\w* el \w vino|strong="H3196"\w*, ordenó \w a|strong="H3068"\w* Mehumán, Biztha, \w Harbona|strong="H2726"\w*, Bigtha y Abagtha, Zethar y Carcass, los \w siete|strong="H7651"\w* \w eunucos|strong="H5631"\w* \w que|strong="H3117"\w* servían en \w presencia|strong="H6440"\w* del \w rey|strong="H4428"\w* Asuero,  
\v 11 \w que|strong="H3588"\w* trajeran \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w reina|strong="H4436"\w* Vasti \w ante|strong="H6440"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w con|strong="H3588"\w* \w la|strong="H1931"\w* corona \w real|strong="H4428"\w*, \w para|strong="H3588"\w* mostrar \w al|strong="H4428"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w príncipes|strong="H8269"\w* \w su|strong="H1931"\w* belleza, \w pues|strong="H3588"\w* \w era|strong="H1931"\w* \w hermosa|strong="H2896"\w*.  
\v 12 Pero \w la|strong="H1197"\w* \w reina|strong="H4436"\w* Vasti se negó \w a|strong="H3068"\w* presentarse \w a|strong="H3068"\w* \w la|strong="H1197"\w* orden del \w rey|strong="H4428"\w* \w por|strong="H1697"\w* \w medio|strong="H3027"\w* \w de|strong="H1697"\w* los \w eunucos|strong="H5631"\w*. \w Por|strong="H1697"\w* eso el \w rey|strong="H4428"\w* se \w enojó|strong="H2534"\w* \w mucho|strong="H3966"\w*, \w y|strong="H1197"\w* su \w ira|strong="H2534"\w* \w ardía|strong="H1197"\w* en él.   
\p
\v 13 \w Entonces|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* dijo \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sabios|strong="H2450"\w*, \w que|strong="H3588"\w* \w conocían|strong="H3045"\w* \w los|strong="H3605"\w* \w tiempos|strong="H6256"\w* (\w pues|strong="H3588"\w* \w era|strong="H6256"\w* costumbre del \w rey|strong="H4428"\w* consultar \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* \w conocían|strong="H3045"\w* \w la|strong="H3588"\w* ley \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w juicio|strong="H1779"\w*;  
\v 14 y junto \w a|strong="H3068"\w* \w él|strong="H3427"\w* \w estaban|strong="H3427"\w* Carshena, Shethar, Admatha, Tarshish, Meres, Marsena y \w Memucan|strong="H4462"\w*, \w los|strong="H3427"\w* \w siete|strong="H7651"\w* \w príncipes|strong="H8269"\w* \w de|strong="H6440"\w* \w Persia|strong="H6539"\w* y \w de|strong="H6440"\w* \w Media|strong="H4074"\w*, \w que|strong="H7651"\w* \w veían|strong="H7200"\w* la \w cara|strong="H6440"\w* del \w rey|strong="H4428"\w* y se sentaban \w los|strong="H3427"\w* \w primeros|strong="H7223"\w* en \w el|strong="H3427"\w* \w reino|strong="H4438"\w*),  
\v 15 “¿\w Qué|strong="H4100"\w* \w haremos|strong="H6213"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* Vasti \w según|strong="H5921"\w* \w la|strong="H5921"\w* ley, \w porque|strong="H5921"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* \w cumplido|strong="H6213"\w* \w la|strong="H5921"\w* orden \w del|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w eunucos|strong="H5631"\w*?”   
\p
\v 16 \w Memucán|strong="H4462"\w* respondió \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* \w los|strong="H3605"\w* \w príncipes|strong="H8269"\w*: “\w La|strong="H5921"\w* \w reina|strong="H4436"\w* Vasti \w no|strong="H3808"\w* \w ha|strong="H3808"\w* hecho mal sólo \w al|strong="H5921"\w* \w rey|strong="H4428"\w*, \w sino|strong="H3588"\w* también \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w príncipes|strong="H8269"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w que|strong="H3588"\w* \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w provincias|strong="H4082"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero.  
\v 17 \w Porque|strong="H3588"\w* \w esta|strong="H5921"\w* acción \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* \w será|strong="H3808"\w* conocida \w por|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* mujeres, haciéndolas despreciar \w a|strong="H3068"\w* sus maridos \w cuando|strong="H3588"\w* \w se|strong="H3808"\w* diga: ‘\w El|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero mandó traer \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* Vasti \w ante|strong="H6440"\w* \w él|strong="H5921"\w*, \w pero|strong="H3588"\w* \w ella|strong="H3605"\w* \w no|strong="H3808"\w* vino’.  
\v 18 \w Hoy|strong="H3117"\w*, las princesas \w de|strong="H8269"\w* \w Persia|strong="H6539"\w* y \w de|strong="H8269"\w* \w Media|strong="H4074"\w* \w que|strong="H3117"\w* se han enterado \w de|strong="H8269"\w* \w la|strong="H3605"\w* acción \w de|strong="H8269"\w* \w la|strong="H3605"\w* \w reina|strong="H4436"\w* \w lo|strong="H1697"\w* contarán \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w príncipes|strong="H8269"\w* del \w rey|strong="H4428"\w*. \w Esto|strong="H2088"\w* causará \w mucho|strong="H1767"\w* desprecio \w e|strong="H3068"\w* \w ira|strong="H7110"\w*.   
\p
\v 19 “\w Si|strong="H3808"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2896"\w*, \w que|strong="H4480"\w* \w salga|strong="H3318"\w* \w de|strong="H4480"\w* \w él|strong="H5921"\w* un \w mandamiento|strong="H1697"\w* \w real|strong="H4428"\w* \w y|strong="H5921"\w* \w que|strong="H4480"\w* \w se|strong="H3808"\w* escriba \w entre|strong="H5921"\w* \w las|strong="H5921"\w* leyes \w de|strong="H4480"\w* \w los|strong="H5921"\w* \w persas|strong="H6539"\w* \w y|strong="H5921"\w* \w de|strong="H4480"\w* \w los|strong="H5921"\w* medos, \w para|strong="H5921"\w* \w que|strong="H4480"\w* \w no|strong="H3808"\w* pueda ser alterado, \w a|strong="H3068"\w* fin \w de|strong="H4480"\w* \w que|strong="H4480"\w* Vasti \w no|strong="H3808"\w* vuelva \w a|strong="H3068"\w* presentarse \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero; \w y|strong="H5921"\w* \w que|strong="H4480"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w dé|strong="H4480"\w* su patrimonio \w real|strong="H4428"\w* \w a|strong="H3068"\w* otra \w que|strong="H4480"\w* sea \w mejor|strong="H2896"\w* \w que|strong="H4480"\w* \w ella|strong="H5921"\w*.  
\v 20 \w Cuando|strong="H3588"\w* \w se|strong="H1931"\w* publique \w en|strong="H5704"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w reino|strong="H4438"\w* \w el|strong="H1931"\w* decreto del \w rey|strong="H4428"\w* \w que|strong="H3588"\w* \w él|strong="H1931"\w* \w hará|strong="H6213"\w* (\w porque|strong="H3588"\w* \w es|strong="H1931"\w* \w grande|strong="H1419"\w*), \w todas|strong="H3605"\w* las \w mujeres|strong="H5704"\w* \w darán|strong="H5414"\w* honor \w a|strong="H3068"\w* \w sus|strong="H1931"\w* maridos, tanto \w a|strong="H3068"\w* \w los|strong="H1167"\w* \w grandes|strong="H1419"\w* \w como|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H1167"\w* \w pequeños|strong="H6996"\w*.”   
\p
\v 21 Este \w consejo|strong="H1697"\w* \w agradó|strong="H3190"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* y \w a|strong="H3068"\w* los \w príncipes|strong="H8269"\w*, y \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w hizo|strong="H6213"\w* conforme \w a|strong="H3068"\w* la \w palabra|strong="H1697"\w* \w de|strong="H8269"\w* \w Memucán|strong="H4462"\w*:  
\v 22 \w pues|strong="H1961"\w* \w envió|strong="H7971"\w* \w cartas|strong="H5612"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* del \w rey|strong="H4428"\w*, \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w* según su escritura, y \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w pueblo|strong="H5971"\w* en su \w lengua|strong="H3956"\w*, \w para|strong="H5971"\w* \w que|strong="H5971"\w* \w cada|strong="H3605"\w* uno gobernara su \w casa|strong="H1004"\w*, \w hablando|strong="H1696"\w* en \w la|strong="H3605"\w* \w lengua|strong="H3956"\w* \w de|strong="H5971"\w* su \w pueblo|strong="H5971"\w*.   
\c 2
\p
\v 1 \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w estas|strong="H6213"\w* \w cosas|strong="H1697"\w*, cuando \w la|strong="H5921"\w* \w ira|strong="H2534"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero \w se|strong="H5921"\w* apaciguó, \w se|strong="H5921"\w* acordó \w de|strong="H5921"\w* Vasti, \w de|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w había|strong="H6213"\w* decretado \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 2 Entonces los servidores del \w rey|strong="H4428"\w* que le servían dijeron: “Que se \w busquen|strong="H1245"\w* jóvenes \w vírgenes|strong="H1330"\w* \w hermosas|strong="H2896"\w* para el \w rey|strong="H4428"\w*.  
\v 3 \w Que|strong="H4082"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* designe oficiales en \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* \w de|strong="H5414"\w* su \w reino|strong="H4438"\w*, \w para|strong="H5414"\w* \w que|strong="H4082"\w* reúnan \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las jóvenes \w vírgenes|strong="H1330"\w* \w hermosas|strong="H2896"\w* en \w la|strong="H8104"\w* ciudadela \w de|strong="H5414"\w* Susa, en \w la|strong="H8104"\w* \w casa|strong="H1004"\w* \w de|strong="H5414"\w* las mujeres, bajo \w la|strong="H8104"\w* custodia \w de|strong="H5414"\w* \w Hegai|strong="H1896"\w*, \w el|strong="H3605"\w* \w eunuco|strong="H5631"\w* del \w rey|strong="H4428"\w*, guardián \w de|strong="H5414"\w* las mujeres. \w Que|strong="H4082"\w* se les den cosméticos;  
\v 4 y \w que|strong="H1697"\w* la doncella \w que|strong="H1697"\w* agrade \w al|strong="H4428"\w* \w rey|strong="H4428"\w* sea \w reina|strong="H4427"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* Vasti”. \w El|strong="H6213"\w* \w asunto|strong="H1697"\w* \w agradó|strong="H3190"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*, y \w así|strong="H3651"\w* \w lo|strong="H1697"\w* \w hizo|strong="H6213"\w*.   
\p
\v 5 \w Había|strong="H1961"\w* en la ciudadela \w de|strong="H1121"\w* Susa un \w judío|strong="H3064"\w* \w que|strong="H1121"\w* \w se|strong="H1961"\w* \w llamaba|strong="H8034"\w* Mardoqueo, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jair|strong="H2971"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Simei, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Cis|strong="H7027"\w*, \w benjamita|strong="H1121"\w*,  
\v 6 que había sido llevado \w de|strong="H5973"\w* Jerusalén \w con|strong="H5973"\w* \w los|strong="H5973"\w* \w cautivos|strong="H1473"\w* que habían sido llevados \w con|strong="H5973"\w* Jeconías, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* quienes \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* Babilonia, había llevado.  
\v 7 Crió \w a|strong="H3068"\w* Hadasa, \w es|strong="H1961"\w* decir, \w a|strong="H3068"\w* Ester, \w la|strong="H1931"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w tío|strong="H1730"\w*, \w pues|strong="H3588"\w* \w no|strong="H3588"\w* \w tenía|strong="H1961"\w* padre ni madre. \w La|strong="H1931"\w* doncella \w era|strong="H1961"\w* \w hermosa|strong="H3303"\w* \w y|strong="H3588"\w* bella; \w y|strong="H3588"\w* \w cuando|strong="H3588"\w* \w su|strong="H1931"\w* padre \w y|strong="H3588"\w* \w su|strong="H1931"\w* madre murieron, Mardoqueo \w la|strong="H1931"\w* \w tomó|strong="H3947"\w* \w como|strong="H3588"\w* \w hija|strong="H1323"\w* propia.   
\p
