\p
\v 26 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* \w estos|strong="H2063"\w* \w días|strong="H3117"\w* “\w Purim|strong="H6332"\w*”, \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* “\w Pur|strong="H6332"\w*”. \w Por|strong="H5921"\w* \w lo|strong="H1697"\w* \w tanto|strong="H3651"\w*, \w a|strong="H3068"\w* \w causa|strong="H1697"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w de|strong="H5921"\w* \w esta|strong="H2063"\w* carta, \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* habían \w visto|strong="H7200"\w* \w sobre|strong="H5921"\w* \w este|strong="H2063"\w* \w asunto|strong="H1697"\w*, \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w les|strong="H5921"\w* había \w llegado|strong="H5060"\w*,  
\v 27 \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w establecieron|strong="H6965"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* impusieron \w a|strong="H3068"\w* \w sí|strong="H3808"\w* mismos, \w a|strong="H3068"\w* sus descendientes \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3808"\w* \w se|strong="H1961"\w* unieron \w a|strong="H3068"\w* \w ellos|strong="H5921"\w*, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* dejasen \w de|strong="H5921"\w* guardar \w estos|strong="H3605"\w* \w dos|strong="H8147"\w* \w días|strong="H3117"\w* \w según|strong="H5921"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w estaba|strong="H1961"\w* escrito \w y|strong="H5921"\w* \w según|strong="H5921"\w* su \w tiempo|strong="H3117"\w* señalado \w cada|strong="H3605"\w* \w año|strong="H8141"\w*;  
\v 28 y \w que|strong="H3808"\w* \w estos|strong="H3605"\w* \w días|strong="H3117"\w* fueran recordados y guardados \w a|strong="H3068"\w* través de \w cada|strong="H3605"\w* \w generación|strong="H1755"\w*, \w cada|strong="H3605"\w* \w familia|strong="H4940"\w*, \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w* y \w cada|strong="H3605"\w* \w ciudad|strong="H5892"\w*; y \w que|strong="H3808"\w* \w estos|strong="H3605"\w* \w días|strong="H3117"\w* de \w Purim|strong="H6332"\w* \w no|strong="H3808"\w* desaparecieran de \w entre|strong="H8432"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w*, \w ni|strong="H3808"\w* su \w memoria|strong="H2142"\w* pereciera de su \w descendencia|strong="H2233"\w*.   
\p
\v 29 Entonces \w la|strong="H2063"\w* \w reina|strong="H4436"\w* Ester, \w hija|strong="H1323"\w* de Abihail, y \w el|strong="H3605"\w* \w judío|strong="H3064"\w* Mardoqueo \w escribieron|strong="H3789"\w* con \w toda|strong="H3605"\w* autoridad para confirmar \w esta|strong="H2063"\w* \w segunda|strong="H8145"\w* carta de \w Purim|strong="H6332"\w*.  
\v 30 \w Envió|strong="H7971"\w* \w cartas|strong="H5612"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w de|strong="H1697"\w* las \w ciento|strong="H3967"\w* \w veintisiete|strong="H6242"\w* \w provincias|strong="H4082"\w* del \w reino|strong="H4438"\w* \w de|strong="H1697"\w* Asuero con \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* \w paz|strong="H7965"\w* y \w de|strong="H1697"\w* verdad,  
\v 31 \w para|strong="H5921"\w* confirmar estos \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w Purim|strong="H6332"\w* \w en|strong="H5921"\w* sus \w tiempos|strong="H3117"\w* señalados, \w como|strong="H5921"\w* habían decretado Mardoqueo \w el|strong="H5921"\w* \w judío|strong="H3064"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* Ester, \w y|strong="H5921"\w* \w como|strong="H5921"\w* \w se|strong="H5921"\w* habían impuesto \w a|strong="H3068"\w* \w sí|strong="H5315"\w* mismos \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus descendientes \w en|strong="H5921"\w* materia \w de|strong="H5921"\w* ayunos \w y|strong="H5921"\w* \w de|strong="H5921"\w* luto.  
\v 32 El \w mandamiento|strong="H1697"\w* \w de|strong="H1697"\w* Ester \w confirmó|strong="H6965"\w* estos asuntos \w de|strong="H1697"\w* \w Purim|strong="H6332"\w*; y fue \w escrito|strong="H3789"\w* en el \w libro|strong="H5612"\w*.   
\c 10
\p
\v 1 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero \w impuso|strong="H7760"\w* un \w tributo|strong="H4522"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* islas \w del|strong="H5921"\w* \w mar|strong="H3220"\w*.  
\v 2 ¿\w No|strong="H3808"\w* están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Media|strong="H4074"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Persia|strong="H6539"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* actos \w de|strong="H5921"\w* \w su|strong="H1992"\w* poder \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w su|strong="H1992"\w* fuerza, \w y|strong="H5921"\w* \w la|strong="H5921"\w* relación completa \w de|strong="H5921"\w* \w la|strong="H5921"\w* grandeza \w de|strong="H5921"\w* Mardoqueo, \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w que|strong="H3808"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* hizo avanzar?  
\v 3 \w Porque|strong="H3588"\w* Mardoqueo, \w el|strong="H3588"\w* \w judío|strong="H3064"\w*, estaba \w junto|strong="H5971"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* Asuero, \w y|strong="H3588"\w* era \w grande|strong="H1419"\w* \w entre|strong="H3588"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w y|strong="H3588"\w* aceptado \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w multitud|strong="H7230"\w* \w de|strong="H3588"\w* sus hermanos, \w buscando|strong="H1875"\w* \w el|strong="H3588"\w* \w bien|strong="H2896"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w hablando|strong="H1696"\w* \w de|strong="H3588"\w* \w paz|strong="H7965"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus descendientes.   