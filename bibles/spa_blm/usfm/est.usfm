\v 9 \w Si|strong="H5921"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2895"\w*, \w que|strong="H5921"\w* \w se|strong="H5921"\w* escriba \w que|strong="H5921"\w* sean destruidos; \w y|strong="H5921"\w* \w yo|strong="H6213"\w* pagaré \w diez|strong="H6235"\w* \w mil|strong="H6235"\w* \w talentos|strong="H3603"\w* \w de|strong="H5921"\w* \w plata|strong="H3701"\w* \w en|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* encargados \w de|strong="H5921"\w* \w los|strong="H5921"\w* negocios \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* ingresen \w en|strong="H5921"\w* \w las|strong="H5921"\w* arcas \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.”   
\p
\v 10 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* \w quitó|strong="H5493"\w* \w el|strong="H5921"\w* anillo \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w Amán|strong="H2001"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Hamedata \w el|strong="H5921"\w* Agagita, \w enemigo|strong="H6887"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w judíos|strong="H3064"\w*.  
\v 11 \w El|strong="H6213"\w* \w rey|strong="H4428"\w* dijo \w a|strong="H3068"\w* \w Amán|strong="H2001"\w*: “La \w plata|strong="H3701"\w* \w se|strong="H5971"\w* \w te|strong="H5869"\w* \w da|strong="H5414"\w* \w a|strong="H3068"\w* ti, también \w el|strong="H6213"\w* \w pueblo|strong="H5971"\w*, \w para|strong="H5414"\w* \w que|strong="H5971"\w* \w hagas|strong="H6213"\w* con \w él|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* \w te|strong="H5869"\w* parezca”.   
\p
\v 12 \w Entonces|strong="H3117"\w* \w los|strong="H3605"\w* \w escribas|strong="H5608"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* fueron convocados \w el|strong="H5921"\w* \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*, \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w trece|strong="H7969"\w* \w días|strong="H3117"\w* \w del|strong="H5921"\w* \w mes|strong="H2320"\w*; \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w Amán|strong="H2001"\w* \w mandó|strong="H6680"\w* fue \w escrito|strong="H3789"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w gobernadores|strong="H6346"\w* locales \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w gobernadores|strong="H6346"\w* \w que|strong="H5921"\w* \w estaban|strong="H5971"\w* \w sobre|strong="H5921"\w* \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w príncipes|strong="H8269"\w* \w de|strong="H5921"\w* \w cada|strong="H3605"\w* \w pueblo|strong="H5971"\w*, \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w* \w según|strong="H5921"\w* su \w escritura|strong="H3789"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w en|strong="H5921"\w* su idioma. Estaba \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w nombre|strong="H8034"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero, \w y|strong="H5921"\w* estaba \w sellado|strong="H2856"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* anillo \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 13 \w Se|strong="H1931"\w* \w enviaron|strong="H7971"\w* \w cartas|strong="H5612"\w* \w por|strong="H5704"\w* \w medio|strong="H3027"\w* \w de|strong="H5704"\w* \w correos|strong="H7323"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* del \w rey|strong="H4428"\w*, \w para|strong="H5704"\w* \w destruir|strong="H8045"\w*, matar \w y|strong="H5704"\w* hacer perecer \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w*, jóvenes \w y|strong="H5704"\w* \w ancianos|strong="H2205"\w*, \w niños|strong="H2945"\w* \w y|strong="H5704"\w* \w mujeres|strong="H5704"\w*, \w en|strong="H5704"\w* un \w solo|strong="H1931"\w* \w día|strong="H3117"\w*, \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w trece|strong="H7969"\w* del \w mes|strong="H2320"\w* \w duodécimo|strong="H8147"\w*, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w mes|strong="H2320"\w* \w de|strong="H5704"\w* Adar, \w y|strong="H5704"\w* \w para|strong="H5704"\w* saquear \w sus|strong="H1931"\w* bienes.  
\v 14 \w Se|strong="H1961"\w* publicó una copia \w de|strong="H5414"\w* \w la|strong="H3605"\w* carta \w para|strong="H5414"\w* \w que|strong="H5971"\w* \w el|strong="H3605"\w* decreto \w se|strong="H1961"\w* distribuyera en \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w*, \w a|strong="H3068"\w* fin \w de|strong="H5414"\w* \w que|strong="H5971"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w* estuvieran preparados \w para|strong="H5414"\w* \w ese|strong="H2088"\w* \w día|strong="H3117"\w*.  
\v 15 \w Los|strong="H3427"\w* mensajeros \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* toda prisa \w por|strong="H1697"\w* orden \w del|strong="H8354"\w* \w rey|strong="H4428"\w*, y \w el|strong="H3427"\w* decreto se repartió \w en|strong="H3318"\w* la ciudadela \w de|strong="H5414"\w* Susa. \w El|strong="H3427"\w* \w rey|strong="H4428"\w* y \w Amán|strong="H2001"\w* se \w sentaron|strong="H3427"\w* \w a|strong="H3068"\w* \w beber|strong="H8354"\w*; pero la \w ciudad|strong="H5892"\w* \w de|strong="H5414"\w* Susa \w estaba|strong="H3427"\w* perpleja.   
\c 4
\p
\v 1 Cuando Mardoqueo \w se|strong="H3045"\w* enteró \w de|strong="H3847"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3045"\w* \w se|strong="H3045"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w*, \w rasgó|strong="H7167"\w* sus ropas y \w se|strong="H3045"\w* \w vistió|strong="H3847"\w* \w de|strong="H3847"\w* \w saco|strong="H3318"\w* con cenizas, y \w salió|strong="H3318"\w* al centro \w de|strong="H3847"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*, y \w se|strong="H3045"\w* lamentó fuerte y \w amargamente|strong="H4751"\w*.  
\v 2 \w Llegó|strong="H5704"\w* \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* \w puerta|strong="H8179"\w* del \w rey|strong="H4428"\w*, \w pues|strong="H3588"\w* \w a|strong="H3068"\w* nadie se le permite entrar \w en|strong="H5704"\w* \w la|strong="H3588"\w* \w puerta|strong="H8179"\w* del \w rey|strong="H4428"\w* \w vestido|strong="H3830"\w* \w de|strong="H3588"\w* cilicio.  
\v 3 En \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w*, dondequiera \w que|strong="H1697"\w* \w llegaba|strong="H5060"\w* \w la|strong="H3605"\w* orden del \w rey|strong="H4428"\w* y su decreto, había \w gran|strong="H1419"\w* luto entre \w los|strong="H3605"\w* \w judíos|strong="H3064"\w*, y \w ayuno|strong="H6685"\w*, \w llanto|strong="H1065"\w* y \w lamentos|strong="H1065"\w*; y \w muchos|strong="H7227"\w* se acostaban en cilicio y ceniza.   
\p
\v 4 \w Vinieron|strong="H5046"\w* \w las|strong="H5921"\w* \w doncellas|strong="H5291"\w* \w de|strong="H5921"\w* Ester \w y|strong="H5921"\w* sus \w eunucos|strong="H5631"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w contaron|strong="H5046"\w* esto, \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* \w se|strong="H3808"\w* entristeció \w mucho|strong="H3966"\w*. \w Envió|strong="H7971"\w* ropa \w a|strong="H3068"\w* Mardoqueo, \w para|strong="H5921"\w* reemplazar su cilicio, pero \w él|strong="H5921"\w* \w no|strong="H3808"\w* \w la|strong="H5921"\w* recibió.  
\v 5 Entonces Ester \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* Hatac, uno \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w eunucos|strong="H5631"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w a|strong="H3068"\w* \w quien|strong="H4100"\w* \w había|strong="H5975"\w* designado \w para|strong="H5921"\w* \w que|strong="H4100"\w* \w la|strong="H5921"\w* atendiera, \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w ordenó|strong="H6680"\w* \w que|strong="H4100"\w* fuera \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* Mardoqueo, \w para|strong="H5921"\w* averiguar \w qué|strong="H4100"\w* \w era|strong="H2088"\w* \w esto|strong="H2088"\w* \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w qué|strong="H4100"\w* \w era|strong="H2088"\w*.  
\v 6 \w Salió|strong="H3318"\w*, pues, Hatac \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* Mardoqueo, \w a|strong="H3068"\w* la plaza \w de|strong="H6440"\w* la \w ciudad|strong="H5892"\w* que estaba \w delante|strong="H6440"\w* \w de|strong="H6440"\w* la \w puerta|strong="H8179"\w* del \w rey|strong="H4428"\w*.  
\v 7 Mardoqueo \w le|strong="H5921"\w* \w contó|strong="H5046"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* había sucedido \w y|strong="H5921"\w* \w la|strong="H5921"\w* suma exacta \w del|strong="H5921"\w* \w dinero|strong="H3701"\w* \w que|strong="H5921"\w* \w Amán|strong="H2001"\w* había prometido pagar \w a|strong="H3068"\w* \w las|strong="H5921"\w* arcas \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* destrucción \w de|strong="H5921"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w*.  
\v 8 También \w le|strong="H5921"\w* \w dio|strong="H5414"\w* \w la|strong="H5921"\w* copia \w del|strong="H5921"\w* escrito \w del|strong="H5921"\w* decreto \w que|strong="H5921"\w* \w se|strong="H5921"\w* había \w dado|strong="H5414"\w* \w en|strong="H5921"\w* Susa \w para|strong="H5921"\w* \w destruirlos|strong="H8045"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w mostrara|strong="H7200"\w* \w a|strong="H3068"\w* Ester \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* declarara, \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* instara \w a|strong="H3068"\w* entrar \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w para|strong="H5921"\w* suplicarle \w y|strong="H5921"\w* pedirle \w por|strong="H5921"\w* su \w pueblo|strong="H5971"\w*.   
\p
\v 9 Hathach vino y le \w contó|strong="H5046"\w* \w a|strong="H3068"\w* Ester las \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* Mardoqueo.  
\v 10 Entonces Ester habló con Hatac y le dio un mensaje para Mardoqueo  
\v 11 “\w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w siervos|strong="H5650"\w* del \w rey|strong="H4428"\w* y \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* las \w provincias|strong="H4082"\w* del \w rey|strong="H4428"\w* \w saben|strong="H3045"\w* \w que|strong="H3808"\w* \w cualquiera|strong="H3605"\w*, sea hombre \w o|strong="H3068"\w* mujer, \w que|strong="H3808"\w* \w se|strong="H3045"\w* presente \w al|strong="H4428"\w* \w rey|strong="H4428"\w* en \w el|strong="H3605"\w* \w patio|strong="H2691"\w* \w interior|strong="H6442"\w* \w sin|strong="H3808"\w* ser \w llamado|strong="H7121"\w*, hay una ley \w para|strong="H5971"\w* \w él|strong="H3605"\w*: \w que|strong="H3808"\w* sea condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*, excepto \w aquellos|strong="H3605"\w* \w a|strong="H3068"\w* quienes \w el|strong="H3605"\w* \w rey|strong="H4428"\w* les extienda \w el|strong="H3605"\w* cetro \w de|strong="H5971"\w* \w oro|strong="H2091"\w*, \w para|strong="H5971"\w* \w que|strong="H3808"\w* vivan. \w No|strong="H3808"\w* he sido \w llamado|strong="H7121"\w* \w a|strong="H3068"\w* entrar \w al|strong="H4428"\w* \w rey|strong="H4428"\w* en \w estos|strong="H2088"\w* \w treinta|strong="H7970"\w* \w días|strong="H3117"\w*”.   
\p
\v 12 Le \w contaron|strong="H1697"\w* \w a|strong="H3068"\w* Mardoqueo las \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* Ester.  
\v 13 \w Entonces|strong="H7725"\w* Mardoqueo les pidió \w que|strong="H3605"\w* le devolvieran \w a|strong="H3068"\w* Ester esta respuesta “No \w pienses|strong="H1819"\w* para ti \w que|strong="H3605"\w* vas \w a|strong="H3068"\w* \w escapar|strong="H4422"\w* en \w la|strong="H3605"\w* \w casa|strong="H1004"\w* del \w rey|strong="H4428"\w* más \w que|strong="H3605"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w*.  
\v 14 \w Porque|strong="H3588"\w* \w si|strong="H3588"\w* ahora callas, \w el|strong="H3588"\w* alivio \w y|strong="H3588"\w* \w la|strong="H3588"\w* liberación vendrán \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w judíos|strong="H3064"\w* desde otro \w lugar|strong="H4725"\w*, \w pero|strong="H3588"\w* tú \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* tu padre pereceréis. ¿\w Quién|strong="H4310"\w* \w sabe|strong="H3045"\w* \w si|strong="H3588"\w* \w no|strong="H3588"\w* has venido \w al|strong="H6256"\w* \w reino|strong="H4438"\w* \w para|strong="H3588"\w* un momento \w como|strong="H3588"\w* \w éste|strong="H2063"\w*?”   
\p
\v 15 \w Entonces|strong="H7725"\w* Ester les pidió que respondieran \w a|strong="H3068"\w* Mardoqueo,  
\v 16 “\w Ve|strong="H3212"\w*, reúne \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w que|strong="H3808"\w* están presentes \w en|strong="H5921"\w* Susa, \w y|strong="H1571"\w* ayunen \w por|strong="H5921"\w* \w mí|strong="H5921"\w*, \w y|strong="H1571"\w* \w no|strong="H3808"\w* coman \w ni|strong="H3808"\w* \w beban|strong="H8354"\w* durante \w tres|strong="H7969"\w* \w días|strong="H3117"\w*, \w ni|strong="H3808"\w* \w de|strong="H5921"\w* \w noche|strong="H3915"\w* \w ni|strong="H3808"\w* \w de|strong="H5921"\w* \w día|strong="H3117"\w*. Yo \w y|strong="H1571"\w* mis \w doncellas|strong="H5291"\w* \w también|strong="H1571"\w* ayunaremos \w de|strong="H5921"\w* \w la|strong="H5921"\w* misma manera. \w Entonces|strong="H3117"\w* entraré \w a|strong="H3068"\w* ver \w al|strong="H5921"\w* \w rey|strong="H4428"\w*, \w lo|strong="H3808"\w* cual es contrario \w a|strong="H3068"\w* \w la|strong="H5921"\w* ley; \w y|strong="H1571"\w* \w si|strong="H1571"\w* perezco, perezco”.  
\v 17 Así pues, Mardoqueo \w se|strong="H5921"\w* puso \w en|strong="H5921"\w* camino \w e|strong="H3068"\w* \w hizo|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* Ester \w le|strong="H5921"\w* \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w*.   
\c 5
\p
\v 1 \w Al|strong="H5921"\w* tercer \w día|strong="H3117"\w*, Ester \w se|strong="H1961"\w* \w vistió|strong="H3847"\w* \w con|strong="H5921"\w* sus ropas \w reales|strong="H4428"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* \w puso|strong="H5975"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w patio|strong="H2691"\w* \w interior|strong="H6442"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w real|strong="H4428"\w*, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*. \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w estaba|strong="H1961"\w* \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* su \w trono|strong="H3678"\w* \w real|strong="H4428"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w real|strong="H4428"\w*, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w*.  
\v 2 \w Cuando|strong="H1961"\w* el \w rey|strong="H4428"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* la \w reina|strong="H4436"\w* Ester \w de|strong="H5869"\w* \w pie|strong="H5975"\w* \w en|strong="H5975"\w* el \w patio|strong="H2691"\w*, ella obtuvo el favor \w de|strong="H5869"\w* sus \w ojos|strong="H5869"\w*; y el \w rey|strong="H4428"\w* \w le|strong="H5869"\w* tendió \w a|strong="H3068"\w* Ester el cetro \w de|strong="H5869"\w* \w oro|strong="H2091"\w* \w que|strong="H2691"\w* \w tenía|strong="H1961"\w* \w en|strong="H5975"\w* la \w mano|strong="H3027"\w*. Entonces Ester \w se|strong="H1961"\w* acercó y \w tocó|strong="H5060"\w* la punta del cetro.   
\p
\v 3 Entonces el \w rey|strong="H4428"\w* le preguntó: “¿\w Qué|strong="H4100"\w* quieres, \w reina|strong="H4436"\w* Ester? ¿\w Cuál|strong="H4100"\w* es tu petición? \w Se|strong="H4100"\w* te \w dará|strong="H5414"\w* \w hasta|strong="H5704"\w* la mitad \w del|strong="H2677"\w* \w reino|strong="H4438"\w*”.   
\p
\v 4 Ester dijo: “\w Si|strong="H5921"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2895"\w*, \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w Amán|strong="H2001"\w* vengan \w hoy|strong="H3117"\w* \w al|strong="H5921"\w* \w banquete|strong="H4960"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* he preparado”.   
\p
\v 5 Entonces \w el|strong="H6213"\w* \w rey|strong="H4428"\w* dijo: “Trae \w pronto|strong="H4116"\w* \w a|strong="H3068"\w* \w Amán|strong="H2001"\w*, para \w que|strong="H1697"\w* se \w haga|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* ha \w dicho|strong="H1697"\w* Ester”. Así \w que|strong="H1697"\w* \w el|strong="H6213"\w* \w rey|strong="H4428"\w* y \w Amán|strong="H2001"\w* llegaron \w al|strong="H4428"\w* \w banquete|strong="H4960"\w* \w que|strong="H1697"\w* Ester \w había|strong="H6213"\w* preparado.   
\p
\v 6 \w El|strong="H6213"\w* \w rey|strong="H4428"\w* dijo \w a|strong="H3068"\w* Ester \w en|strong="H5704"\w* \w el|strong="H6213"\w* \w banquete|strong="H4960"\w* \w del|strong="H2677"\w* \w vino|strong="H3196"\w*: “¿\w Cuál|strong="H4100"\w* es \w tu|strong="H6213"\w* \w petición|strong="H7596"\w*? \w Se|strong="H4100"\w* te concederá. ¿\w Cuál|strong="H4100"\w* es \w tu|strong="H6213"\w* \w petición|strong="H7596"\w*? \w Hasta|strong="H5704"\w* la mitad \w del|strong="H2677"\w* \w reino|strong="H4438"\w* \w se|strong="H4100"\w* \w cumplirá|strong="H6213"\w*”.   
\p
\v 7 Entonces Ester \w respondió|strong="H6030"\w* y dijo: “\w Mi|strong="H6030"\w* \w petición|strong="H7596"\w* y \w mi|strong="H6030"\w* solicitud es ésta.  
\v 8 \w Si|strong="H5921"\w* he \w hallado|strong="H4672"\w* \w gracia|strong="H2580"\w* ante \w los|strong="H5921"\w* \w ojos|strong="H5869"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w y|strong="H5921"\w* \w si|strong="H5921"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* agrada conceder \w mi|strong="H5921"\w* \w petición|strong="H7596"\w* \w y|strong="H5921"\w* cumplir \w mi|strong="H5921"\w* solicitud, \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w Amán|strong="H2001"\w* vengan \w al|strong="H5921"\w* \w banquete|strong="H4960"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* prepararé, \w y|strong="H5921"\w* \w yo|strong="H6213"\w* \w haré|strong="H6213"\w* \w mañana|strong="H4279"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* ha \w dicho|strong="H1697"\w*.”   
\p
\v 9 \w Entonces|strong="H3117"\w* \w Amán|strong="H2001"\w* \w salió|strong="H3318"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w alegre|strong="H8056"\w* \w y|strong="H5921"\w* \w contento|strong="H8056"\w* \w de|strong="H4480"\w* \w corazón|strong="H3820"\w*, pero \w cuando|strong="H3117"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* Mardoqueo \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w puerta|strong="H8179"\w* \w del|strong="H4480"\w* \w rey|strong="H4428"\w*, \w que|strong="H4480"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* levantaba \w ni|strong="H3808"\w* \w se|strong="H1931"\w* movía \w por|strong="H5921"\w* \w él|strong="H1931"\w*, \w se|strong="H1931"\w* \w llenó|strong="H4390"\w* \w de|strong="H4480"\w* \w ira|strong="H2534"\w* \w contra|strong="H5921"\w* Mardoqueo.  
\v 10 Sin embargo, \w Amán|strong="H2001"\w* se contuvo y se fue \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*. Allí \w mandó|strong="H7971"\w* llamar \w a|strong="H3068"\w* sus amigos y \w a|strong="H3068"\w* Zeresh, su esposa.  
\v 11 \w Amán|strong="H2001"\w* \w les|strong="H1992"\w* \w contó|strong="H5608"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* \w sus|strong="H1992"\w* \w riquezas|strong="H6239"\w*, \w la|strong="H5921"\w* \w multitud|strong="H7230"\w* \w de|strong="H5921"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w*, \w todas|strong="H3605"\w* \w las|strong="H1992"\w* \w cosas|strong="H1992"\w* \w en|strong="H5921"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w lo|strong="H5921"\w* había promovido, \w y|strong="H5921"\w* \w cómo|strong="H5921"\w* \w lo|strong="H5921"\w* había aventajado \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w príncipes|strong="H8269"\w* \w y|strong="H5921"\w* servidores \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.   
\p
\v 12 \w También|strong="H1571"\w* dijo \w Amán|strong="H2001"\w*: “\w Sí|strong="H3588"\w*, \w la|strong="H1571"\w* \w reina|strong="H4436"\w* Ester \w no|strong="H3808"\w* dejó entrar \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w* \w al|strong="H4428"\w* \w banquete|strong="H4960"\w* \w que|strong="H3588"\w* ella \w había|strong="H3588"\w* preparado, \w sino|strong="H3588"\w* \w a|strong="H3068"\w* mí; \w y|strong="H1571"\w* \w mañana|strong="H4279"\w* \w también|strong="H1571"\w* estoy invitado \w por|strong="H3588"\w* ella \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w*.  
\v 13 Pero \w todo|strong="H3605"\w* \w esto|strong="H2088"\w* no me sirve \w de|strong="H6256"\w* \w nada|strong="H3605"\w*, \w mientras|strong="H3605"\w* \w vea|strong="H7200"\w* \w al|strong="H6256"\w* \w judío|strong="H3064"\w* Mardoqueo \w sentado|strong="H3427"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* del \w rey|strong="H4428"\w*.”   
\p
\v 14 Entonces Zeresh, su mujer, \w y|strong="H5921"\w* \w todos|strong="H3605"\w* sus amigos \w le|strong="H5921"\w* \w dijeron|strong="H1697"\w*: “\w Que|strong="H5921"\w* \w se|strong="H5921"\w* \w haga|strong="H6213"\w* una horca \w de|strong="H5921"\w* \w cincuenta|strong="H2572"\w* codos \w de|strong="H5921"\w* altura, \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* \w habla|strong="H1697"\w* \w con|strong="H5973"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* colgar \w a|strong="H3068"\w* Mardoqueo \w en|strong="H5921"\w* \w ella|strong="H3605"\w*. Entonces entra alegremente \w con|strong="H5973"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w al|strong="H5921"\w* \w banquete|strong="H4960"\w*”. \w Esto|strong="H1697"\w* \w le|strong="H5921"\w* gustó \w a|strong="H3068"\w* \w Amán|strong="H2001"\w*, \w así|strong="H5973"\w* \w que|strong="H5921"\w* mandó \w hacer|strong="H6213"\w* \w la|strong="H5921"\w* horca.   
\c 6
\p
\v 1 \w Aquella|strong="H1931"\w* \w noche|strong="H3915"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w no|strong="H1961"\w* podía dormir. Mandó traer \w el|strong="H1931"\w* \w libro|strong="H5612"\w* \w de|strong="H6440"\w* \w los|strong="H1961"\w* registros \w de|strong="H6440"\w* las crónicas, y \w se|strong="H1961"\w* \w los|strong="H1961"\w* \w leyeron|strong="H7121"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.  
\v 2 \w Se|strong="H5921"\w* encontró \w escrito|strong="H3789"\w* \w que|strong="H5921"\w* Mardoqueo \w había|strong="H4672"\w* hablado \w de|strong="H5921"\w* Bigtana \w y|strong="H5921"\w* Teresh, \w dos|strong="H8147"\w* \w eunucos|strong="H5631"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w que|strong="H5921"\w* eran porteros, \w y|strong="H5921"\w* \w que|strong="H5921"\w* habían tratado \w de|strong="H5921"\w* ponerle \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w encima|strong="H5921"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero.  
\v 3 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* dijo: “¿\w Qué|strong="H4100"\w* honor \w y|strong="H5921"\w* dignidad \w se|strong="H3808"\w* \w le|strong="H5921"\w* \w ha|strong="H3808"\w* dado \w a|strong="H3068"\w* Mardoqueo \w por|strong="H5921"\w* \w esto|strong="H2088"\w*?”  
\p Entonces \w los|strong="H5921"\w* sirvientes \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w que|strong="H4100"\w* \w lo|strong="H1697"\w* atendían \w dijeron|strong="H1697"\w*: “\w No|strong="H3808"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* \w hecho|strong="H6213"\w* \w nada|strong="H3808"\w* \w por|strong="H5921"\w* \w él|strong="H5921"\w*”.   
\p
\v 4 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* dijo: “¿\w Quién|strong="H4310"\w* \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w patio|strong="H2691"\w*?” Ahora bien, \w Amán|strong="H2001"\w* había entrado \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w atrio|strong="H2691"\w* \w exterior|strong="H2435"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w real|strong="H4428"\w*, \w para|strong="H5921"\w* hablar \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* colgar \w a|strong="H3068"\w* Mardoqueo \w en|strong="H5921"\w* \w la|strong="H5921"\w* horca \w que|strong="H4310"\w* había preparado \w para|strong="H5921"\w* \w él|strong="H5921"\w*.   
\p
\v 5 Los servidores del \w rey|strong="H4428"\w* le dijeron: “\w Mira|strong="H2009"\w*, \w Amán|strong="H2001"\w* \w está|strong="H5975"\w* \w en|strong="H5975"\w* el \w patio|strong="H2691"\w*”.  
\p El \w rey|strong="H4428"\w* dijo: “\w Que|strong="H2691"\w* entre”.  
\v 6 Así \w que|strong="H4100"\w* \w Amán|strong="H2001"\w* entró. \w El|strong="H4310"\w* \w rey|strong="H4428"\w* \w le|strong="H4310"\w* dijo: “¿\w Qué|strong="H4100"\w* \w se|strong="H4480"\w* \w hará|strong="H6213"\w* \w con|strong="H4480"\w* \w el|strong="H4310"\w* hombre \w a|strong="H3068"\w* \w quien|strong="H4310"\w* \w el|strong="H4310"\w* \w rey|strong="H4428"\w* \w se|strong="H4480"\w* complace \w en|strong="H4480"\w* honrar?”  
\p \w Y|strong="H3068"\w* dijo \w Amán|strong="H2001"\w* \w en|strong="H4480"\w* su \w corazón|strong="H3820"\w*: “¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* \w se|strong="H4480"\w* deleita \w el|strong="H4310"\w* \w rey|strong="H4428"\w* \w en|strong="H4480"\w* honrar \w más|strong="H4480"\w* \w que|strong="H4100"\w* \w a|strong="H3068"\w* mí mismo?”  
\v 7 \w Amán|strong="H2001"\w* dijo \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: “Para el hombre \w a|strong="H3068"\w* quien el \w rey|strong="H4428"\w* se deleita en honrar,  
\v 8 \w que|strong="H5921"\w* \w se|strong="H5921"\w* traigan \w las|strong="H5921"\w* ropas \w reales|strong="H4428"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* acostumbra \w a|strong="H3068"\w* usar, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w caballo|strong="H5483"\w* \w en|strong="H5921"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w monta|strong="H7392"\w*, \w y|strong="H5921"\w* \w en|strong="H5921"\w* cuya \w cabeza|strong="H7218"\w* \w está|strong="H5921"\w* puesta una corona \w real|strong="H4428"\w*.  
\v 9 \w Que|strong="H5921"\w* \w la|strong="H5921"\w* ropa \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w caballo|strong="H5483"\w* sean entregados \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* uno \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w príncipes|strong="H8269"\w* \w más|strong="H5921"\w* nobles \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* vista \w con|strong="H5921"\w* \w ellos|strong="H3027"\w* \w al|strong="H5921"\w* hombre \w a|strong="H3068"\w* \w quien|strong="H6213"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* complace \w en|strong="H5921"\w* honrar, \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* \w haga|strong="H6213"\w* cabalgar \w por|strong="H5921"\w* \w la|strong="H5921"\w* plaza \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w y|strong="H5921"\w* \w se|strong="H5921"\w* proclame \w ante|strong="H6440"\w* \w él|strong="H5921"\w*: “¡\w Así|strong="H3602"\w* \w se|strong="H5921"\w* \w hará|strong="H6213"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* hombre \w a|strong="H3068"\w* \w quien|strong="H6213"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* complace \w en|strong="H5921"\w* honrar!”   
\p
\v 10 \w Entonces|strong="H3651"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Amán|strong="H2001"\w*: “Apresúrate \w a|strong="H3068"\w* \w tomar|strong="H3947"\w* \w la|strong="H3605"\w* ropa y \w el|strong="H3605"\w* \w caballo|strong="H5483"\w*, \w como|strong="H3651"\w* has \w dicho|strong="H1696"\w*, y \w hazlo|strong="H6213"\w* \w por|strong="H1697"\w* \w el|strong="H3605"\w* \w judío|strong="H3064"\w* Mardoqueo, \w que|strong="H1697"\w* \w se|strong="H3651"\w* sienta \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* del \w rey|strong="H4428"\w*. \w Que|strong="H1697"\w* \w no|strong="H6213"\w* falte \w nada|strong="H1697"\w* \w de|strong="H1697"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* has \w dicho|strong="H1696"\w*”.   
\p
\v 11 Entonces \w Amán|strong="H2001"\w* \w tomó|strong="H3947"\w* la ropa y \w el|strong="H6213"\w* \w caballo|strong="H5483"\w* y \w vistió|strong="H3847"\w* \w a|strong="H3068"\w* Mardoqueo, \w lo|strong="H6213"\w* \w hizo|strong="H6213"\w* cabalgar \w por|strong="H6440"\w* la plaza \w de|strong="H6440"\w* la \w ciudad|strong="H5892"\w* y \w proclamó|strong="H7121"\w* \w ante|strong="H6440"\w* \w él|strong="H6213"\w*: “¡\w Así|strong="H3602"\w* se \w hará|strong="H6213"\w* con \w el|strong="H6213"\w* hombre \w al|strong="H4428"\w* que \w el|strong="H6213"\w* \w rey|strong="H4428"\w* se complace en honrar!”   
\p
\v 12 Mardoqueo regresó \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* del \w rey|strong="H4428"\w*, pero \w Amán|strong="H2001"\w* se apresuró \w a|strong="H3068"\w* ir \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*, de luto y con la \w cabeza|strong="H7218"\w* \w cubierta|strong="H2645"\w*.  
\v 13 \w Amán|strong="H2001"\w* \w contó|strong="H5608"\w* \w a|strong="H3068"\w* \w Zeres|strong="H2238"\w* \w su|strong="H3588"\w* mujer \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus amigos \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* le \w había|strong="H3588"\w* sucedido. \w Entonces|strong="H3588"\w* sus \w sabios|strong="H2450"\w* \w y|strong="H3588"\w* Zeresh \w su|strong="H3588"\w* mujer le dijeron: “\w Si|strong="H3588"\w* Mardoqueo, \w ante|strong="H6440"\w* \w quien|strong="H3605"\w* has empezado \w a|strong="H3068"\w* \w caer|strong="H5307"\w*, \w es|strong="H3588"\w* \w de|strong="H3588"\w* ascendencia judía, \w no|strong="H3808"\w* prevalecerás \w contra|strong="H6440"\w* \w él|strong="H3588"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* seguramente \w caerás|strong="H5307"\w* \w ante|strong="H6440"\w* \w él|strong="H3588"\w*.”  
\v 14 \w Mientras|strong="H5750"\w* \w aún|strong="H5750"\w* \w hablaban|strong="H1696"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*, \w llegaron|strong="H5060"\w* \w los|strong="H5973"\w* \w eunucos|strong="H5631"\w* \w del|strong="H5973"\w* \w rey|strong="H4428"\w* y se apresuraron \w a|strong="H3068"\w* llevar \w a|strong="H3068"\w* \w Amán|strong="H2001"\w* \w al|strong="H4428"\w* \w banquete|strong="H4960"\w* que \w había|strong="H6213"\w* preparado Ester.   
\c 7
\p
\v 1 \w El|strong="H5973"\w* \w rey|strong="H4428"\w* y \w Amán|strong="H2001"\w* vinieron \w a|strong="H3068"\w* banquete \w con|strong="H5973"\w* la \w reina|strong="H4436"\w* Ester.  
\v 2 \w El|strong="H6213"\w* \w rey|strong="H4428"\w* \w volvió|strong="H5414"\w* \w a|strong="H3068"\w* decir \w a|strong="H3068"\w* Ester \w el|strong="H6213"\w* \w segundo|strong="H8145"\w* \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w el|strong="H6213"\w* \w banquete|strong="H4960"\w* \w de|strong="H5704"\w* \w vino|strong="H3196"\w*: “¿\w Cuál|strong="H4100"\w* es \w tu|strong="H6213"\w* \w petición|strong="H7596"\w*, \w reina|strong="H4436"\w* Ester? \w Se|strong="H4100"\w* te concederá. ¿\w Cuál|strong="H4100"\w* es \w tu|strong="H6213"\w* \w petición|strong="H7596"\w*? \w Hasta|strong="H5704"\w* \w la|strong="H1571"\w* mitad \w del|strong="H2677"\w* \w reino|strong="H4438"\w* \w se|strong="H4100"\w* \w cumplirá|strong="H6213"\w*”.   
\p
