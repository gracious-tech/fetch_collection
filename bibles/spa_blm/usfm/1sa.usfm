\v 19 \w No|strong="H3808"\w* les \w faltó|strong="H5737"\w* \w nada|strong="H3808"\w*, \w ni|strong="H3808"\w* \w pequeño|strong="H6996"\w* \w ni|strong="H3808"\w* \w grande|strong="H1419"\w*, \w ni|strong="H3808"\w* \w hijos|strong="H1121"\w* \w ni|strong="H3808"\w* \w hijas|strong="H1323"\w*, \w ni|strong="H3808"\w* botín, \w ni|strong="H3808"\w* \w nada|strong="H3808"\w* \w de|strong="H4480"\w* \w lo|strong="H3808"\w* \w que|strong="H4480"\w* habían \w tomado|strong="H3947"\w*. \w David|strong="H1732"\w* \w los|strong="H1121"\w* devolvió \w a|strong="H3068"\w* \w todos|strong="H3605"\w*.  
