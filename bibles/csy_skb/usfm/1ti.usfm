\id 1TI 1TIM- SYN- Siyin Bible 
\ide 65001 - Unicode (UTF-8)
\h 1 TIMOTHY 
\toc1 1 TIMOTHY 
\toc2 1 Timothy 
\toc3 1Tim 
\mt1 TIMOTHY  
\mt3 Laithak Khatna  
\mt2 First Timothy  
\c 1  
\s1 Paupuina  
\p
\v 1 \x - \xo 1:1 \xt Sawl 16:1\x*I lametna Topa Jesus Christ le eite hong tan Pathian i thupiakna tungtawn in Jesus Christ i sawltak Paul in;   
\p
\v 2 Upna sung ah ka tapa tatak Timothy tung ah: i Pa Pathian le i Topa Jesus Christ tung pan in thuthiamna, hesuakna le thinnopna hong om tahen.   
\s1 Hilna Man Ngawl Ki Dawm Tu  
\p
\v 3 Mi pawlkhat te hilna dang hil ngawl tu in, na vaithak thei na tu, Macedonia ka pai lai in, Ephesus ah om nginge tu in nangma kong thum zo hi,   
\p
\v 4 Phuatawm tangthu te le tawp hun nei ngawl khang thu te thupisak ngawl tu in vaitha in, tabang te in ki nialna piangsak a, Pathian mi hi na lamsang khangtosak ngawl hi.   
\p
\v 5 Tu in thupiakna a tawpna sia a thiangtho thinsung, khentel thei na pha le upna tatak sung pan in a piang itna a hihi:   
\p
\v 6 Tua thu pan in pawlkhat te lampial uh a mannung ngawl kammal sang ah kihei uh hi;   
\p
\v 7 Amate i son te le amate in kipsak a hi hunlam zong he ngawl in, thukhamhil sya te hi nuam lai uh hi.   
\p
\v 8 Ahihang mi khat in thukham bang in a zang ahile thukham sia pha hi, ci i he hi;   
\p
\v 9 Hi thu ciamte in, thukham sia mi thutang te atu in a ki vawt hi ngawl hi, ahihang thukham nei ngawl te le thu ni ngawl te, Pathian nei ngawl te le mawnei te, a thiangtho ngawl te le Pathian a thusimngawl te, pa te a that te le nu te a that te,   
\p
\v 10 Pumpi ki zuak pa te, pa le pa paktat te, mihing ngu te, leilot thu son te, leilot kamciam vawt te, hil na man langpan te atu a hihi;   
\p
\v 11 Tabang hilna man sia thupha Pathian i lungdamna thupha vanglian taw ki phu ngawl a, keima tung ah hong ap hi.   
\s1 Pathian Hesuakna Hang in Lungdamna  
\p
\v 12 Taciang hong thahatsak i Topa Christ Jesus lungdam ka ko hi, banghangziam cile Ama in thuman in hong ngaisun a, Pathian nasepna sung ah hong koi hi;   
\p
\v 13 \x - \xo 1:13 \xt Sawl 8:3; 9:4, 5\x*Keima sia nidang in ngual sonsia, ngual a vawtsia le ngual supna tu a vawt ka hihang: hesuakna ka sang hi, banghangziam cile up ngawl na sung ah he ngawl in ka vawt hang hi.   
\p
\v 14 Taciang i Topa i thuthiamna sia Christ Jesus sung ah upna le itna taw dim in let hi.   
\p
\v 15 Christ Jesus sia mawnei te ngum tu in hileitung ah hongpai hi, a ci sia a thuman kammal hi a, a vekpi in san tak hi; tua mawnei te sung ah keima sia a mawbel ka hihi.   
\p
\v 16 Ahihang nidang ciang in tawntung nuntakna atu a um lai tu te atu ettte tu in, keima mawneibel tung ah Jesus Christ in a thinsauna theampo hong kilangsak a, a hesuakna ka sang hi.   
\p
\v 17 Tu in tawntung Kumpi, a thi thei ngawl, ki mu thei ngawl, a cialcing Pathian khatbek omsun tung ah zatakna le minthanna a tawntung in om tahen. Amen.   
\p
\v 18 Ka ta Timothy awng, nangma huvau a hun bo sa sung ah mailam thu pualakna a om bangin hi thupiakna sia na khut sung ah muangin kong ap hi. Phatak in ngal na do thei natu in hi kammalte ngalhiam in zang in a,   
\p
\v 19 Na upna kholet in, thinsung thiangtho na nei tan. Mihing pawlkhat a thinsung uh pan, a piang thu te um ngawlin upna lalsak uh hi.   
\p
\v 20 Tuate sung ah, Haimenias le Alexander zong kihel a; amate sia mindaisak ngawl tu in a sin thei na tu Satan tung ah ka ap zo hi.   
\c 2  
\s1 Thunget Dan Hilna  
\p
\v 1 Tua ahikom amasabel in, thungetna a tatuam, eima atu thungetna te, ngualdang atu thungetna te le lungdamko thungetna te sia mi theampo atu vawt tu in kong thum hi;   
\p
\v 2 Pathianmi hina le thumanna taw om hithiat le kilemtak in i nuntak thei natu in kumpi theampo le ulian te theampo atu in thungetsak in.   
\p
\v 3 Banghangziam cile hi thu sia eite hong ngum Pathian mu na ah a pha le a san thamman a hihi;   
\p
\v 4 Pathian in mi theampo ngupna nga tu le thuman thutak a heak atu a dei hi.   
\p
\v 5 Banghangziam cile Pathian khat bek om a, Pathian le mihing te kikal ah palai khat om hi, tua in mihing a hi Christ Jesus a hihi;   
\p
\v 6 Jesus in mi theampo tan tu in Ama le Ama kipia hi, tua thu sia a hun a cin ciang in tettipang hi.   
\p
\v 7 \x - \xo 2:7 \xt 2 Tim 1:11\x*Keima sia thuhil le sawltak dinmun taw, upna le thuman sia Gentile te a hil tu in, nasep piak ka hihi, Christ sung ah thuman kong hil hi, leilot thu ka son bua hi.   
\p
\v 8 Tua ahikom pasal te mun tatuam ah a thiangtho khut te lamto a, thin-ukna le uplakna om ngawl in thu na nget tu uh kong deisak hi.   
\s1 Numei te Hilna  
\p
\v 9 \x - \xo 2:9 \xt 1 Pet 3:3\x*Tasia bangma in, numei te zong nik le puan a pha bek, zatak upat na le ngaisutna pha taw kipua tahen; sam pheak, kham, pale te le puansil nikten manham te taw hi heak tahen;   
\p
\v 10 Ahihang Pathianmi hi na a pualak numei te in nasep pha te taw kipua tu in kong deisak hi.   
\p
\v 11 Numei te zong na theampo ah thu nitna taw thim khipkhep in sin ta uh hen.   
\p
\v 12 Numei i thuhil tu le pasal tung ah thunei tu sia ka oai bua hi, ahihang om khipkhep tahen.   
\p
\v 13 \x - \xo 2:13 \xt Pian 2:7; \xt Pian2:21,22.\x* Banghangziam cile amasabel in Adam vawt a, tua zawkciang in Eve vawt hi.   
\p
\v 14 \x - \xo 2:14 \xt Pian 3:1-6\x*Taciang Adam theamna thuak ngawl a, numei sia theam in thukham palsatna sung ah theng hi.   
\p
\v 15 Ahihang numei sia upna, itna, thianthona le ngaisutna man taw a om pai suak le, nau a nei ciang in ki ngum tu hi.   
\c 3  
\s1 Pastor  
\p
\v 1 Mi khat in bishop nasep a seam nuam le, nasep pha seam nuam a hihi, ci sia thuman a hihi.   
\p
\v 2 \x - \xo 3:2 \xt Tit 1:6-9\x*Bishop sia paubang ngawl, zi khat nei, a kidawm, pilvang, nuntakzia pha, leangna do thiam, ngual hil thei hi tu a;   
\p
\v 3 Sapittui dawn nuam mama, ngual vua thei, a thiangtho ngawl sum duhop mi hi ngawl tu hi; thuak zo tu, ngual taw thu ki nial in buai ngawl tu, duhop ngawl tu ahizong;   
\p
\v 4 A innkuan phatak in a ukzo, a tate in a thu ni tu a, a zatak huai hi tu hi;   
\p
\v 5 Banghangziam cile ama innkuan zong bangbang in uk tu ci a he bua le, Pathian i pawlpi sia bangbang in keam thei tu ziam?   
\p
\v 6 Thu um thak hi ngawl tu hi, tabang hi bale ki phatsakna taw ki suangtak tu a, doaimangpa sia ki phatsakna taw a pu bang in puk tu hi.   
\p
\v 7 Tua bek domngawl in a puasang mihing te mai ah minpha a nga mi hi hamtang tahen; tabang hi bale zawnsakna le doaimangpa i thang sung ah awk tu hi.   
\s1 Upa  
\p
\v 8 Tasia bangma in upa te zong a zatak huai, leii ka ngawl, sapittui tampi dawn ngawl, a thiangtho ngawl sum a duhop ngawl te;   
\p
\v 9 Upna thuthuk sia a thiangtho khentel theina taw a len hi tahen.   
\p
\v 10 Hi te sia ki ze-et masa tu a; paubang ngawl ci a ki heak thiang zawkciang in, upa nasep seam tahen.   
\p
\v 11 Tasia bangma in amate i zite zong a zatak huai, a man ngawl ngual a mawsiat thei te hi ngawl in, pilvang le na theampo ah a muanhuai te a hi hamtang kul hi.   
\p
\v 12 Upa te sia zi khat nei, a tate le a innsung phatak in a uk zo te hi tahen.   
\p
\v 13 Banghangziam cile upa nasep phatak in a seam te sia amate atu in dinmun pha a nga hi a, Christ upna sung ah hangsanna lianpi zong nga tu hi.   
\s1 Thuthuk Lianpi  
\p
\v 14 Note kung ah a manlangtak in paitu lametna taw hi te at in kong thak hi:   
\p
\v 15 Ahihang ngei kong om tha le, Pathian innkuanpui sung ah bangbang in om tu ci na heak thei natu uh in kong at hi, tua Pathian innkuanpui sia a nungta Pathian i pawlpi hi a, thuman khuam le zungpi a hihi.   
\p
\v 16 Taciang Pathianmi hina thuthuk sia thu ki nial na om ngawl in thupi hi: Pathian sia cilesa in kilang zo a, Thaa sung ah thutang suaksak zo hi, vantungmi te in mu zo uh a, Gentile te kung ah ki pualak zo hi, leitung ah zong um zo uh a, minthanna sung ah tumsak zo hi.   
\c 4  
\s1 A Man Ngawl Kihilna  
\p
\v 1 Hun khakbel sung ah mi pawlkhat te upna pan in tai tu uh a, paikhialna thaa le doai te kihilna te zui zawk tu thupisak tu uh hi, ci in Thaa in thiangtak in son hi.   
\p
\v 2 Kihisakna taw leilot thu te son uh a, amate khentel theina te sia thiksa taw kaangsak in a hikcip bang a hihi;   
\p
\v 3 Kitenna te khaam uh a, a um te le thuman a he te in lungdamko in a san tu uh Pathian i piansak an te zong pial tu in thupia uh hi.   
\p
\v 4 Banghangziam cile Pathian i piansak theampo sia a pha hi a, lungdamko in i sang ahile nial tu khat zong om ngawl hi:   
\p
\v 5 Banghangziam cile Pathian kammal le thungetna tungtawn in thiangthosak zo hi.   
\s1 Jesus Christ i Naseam Pha  
\p
\v 6 Upna kammal le hilna pha taw a kivak le na zuisa thu te sia suapui te na phawksak kik le, nangma sia Jesus Christ i naseam pha na hi tu hi.   
\p
\v 7 Ahihang Pathian thusimngawl le nupi huai te phuatawm tangthu te nial in, taciang Pathianmi hina lam ah nangma le nangma ki hil in.   
\p
\v 8 Banghangziam cile damna tu in cilesa lam hilna sia tawm bekma phatuam hi: ahihang Pathianmi hi na in tu hun le hongpai pheang tu hun atu in kamciam nei a, na theampo sung ah phatuam hi.   
\p
\v 9 Hi thu sia a thuman kammal hi a, a vekpi in san thamman hi.   
\p
\v 10 Tua ahikom kote na seam in zawnsakna zong ka thuak uh hi, banghangziam cile a nungta Pathian ka muang uh hi, Ama sia mi theampo a ngum pa hi a, a tuan in a umte a ngum pa a hihi.   
\p
\v 11 Hi thupiak te pia in a, hil in.   
\p
\v 12 Khangno na hi hu in kuama in hong zawngsak heak hen; ahihang na kammal, na nuntakzia, itna, na thaa, upna le thianthona lam ah thu um te ette tak in om in.   
\p
\v 13 Na kung kongpai dong, laithiangtho sim na, hanthotna le hilna sung ah hanciam in hun zang in.   
\p
\v 14 Na sung ah letsong sia ngaingon heak in, tua letsong sia elder te i khutsuan in le maisang thu pualakna tungtawn in na tung ah hong kipia a hihi.   
\p
\v 15 Na khantona sia mi theampo tung ah a kilang thei natu in, hi thu te ngaisun tawntung in a; nangma le nangma amate tung ah ki pumpiak in.   
\p
\v 16 Nangma le na hilna kidawm in; tua sung ah tatsat ngawl in om in: banghangziam cile tabang na vawt hu in nangma le na thuhilna a zate na tankhia zo tu hi.   
\c 5  
\s1 Pawlpi Mite Kepcingna  
\p
\v 1 Khangham pasal te tei heak in, pa bang in na thum in; taciang a khangmoi zaw te sia suapui te bang ahizong;   
\p
\v 2 Khangham nupi te sia nu te bang ahizong; khangmoi zaw te sia a thiangtho thinsung taw suapui numei bang in nei in.   
\p
\v 3 Meingong tatak te zatak vawt in.   
\p
\v 4 Ahihang numei khatpo in tate a hibale tute a nei le, amate innkuan sia phatna a masabel in kilangsak tahen, taciang amate in nu le pa te vak in en kik ta uh hen: banghangziam cile tua thu sia Pathian mai ah a pha le a santak a hihi.   
\p
\v 5 Tu in amate bek om a, Pathian muang in ama kisapna ngetna te le thungetna te sun le zan in a nei tawntung sia meingong tatak a hihi.   
\p
\v 6 Ahihang ama lungkim natu in a nungta sia nungta ahihang a thi a hihi.   
\p
\v 7 Amate sia paubang ngawl ahi thei natu in hi thu te vaitha in.   
\p
\v 8 Ahihang mi khatpo in ama mite, a tuan in ama innkuan vak ngawl, a hibale ama sia upna nial hi a, thu um ngawl te sang in pha ngawl zawlai hi.   
\p
\v 9 Kum sawm luk a cing ngawl peuma meingong sung ah sim heak in, pasal khat bek a nei,   
\p
\v 10 Nasep pha atu in minpha a nga; patang te keamcing in a khangtosak, leangna a do, mithiangtho te peang a silsak, haksatna thuak te a hu, na pha peuma hanciam in a zui sia meingong sazian ah sim in.   
\p
\v 11 Ahihang khangmoi meingong te sia meingong sazian sung ah hel heak in: banghangziam cile amate cilesa deina a tam ciang in pasal nei kik nuam a, Christ nung ngat kik lel uh hi;   
\p
\v 12 Amate in a masabel upa a nusiat uh hu in mawsiatna thuak uh hi.   
\p
\v 13 Taciang amate datham sin uh a, inn khat zawk inn khat pai kakoai in vak uh hi; taciang datham bek dom ngawl ngualdang te thu ah kihel uh a, pau ngawl tu teng zong pau tawntung uh hi.   
\p
\v 14 Tua ahikom khangmoi meingong te sia pasal nei in, tate nei hen a, innkuan makai tahen, tabang hile i ngalpa ze-et na hunpha a piak ngawl tu ka dei hi.   
\p
\v 15 Banghangziam cile pawlkhat te Satan nungzui in lampial siat zo hi.   
\p
\v 16 Thu um mi pasal a hibale numei khatpo in meingong a nei uh le, ama in en tahen, pawlpi in meingong tatak te a hu thei natu in pawlpi vanngit suan heak tahen.   
\p
\v 17 Phatak in a lampui upa\f + \fr 5:17 \fq upa \ft elder\f* te, a tuan in Pathian thu le hilna sung ah na a seam te sia, a za ni in upat tu kilawm hi, ci ngaisun ta uh hen.   
\p
\v 18 \x - \xo 5:18 \xt Thuhlkk 25:4; \xt Matt 10:10; Lk 10:7.\x*Banghangziam cile laithiangtho in, tang a cil khuital sia a muk tuamsak heak hen. Naseam peuma a sep thaman nga tu kilawm hi, ci hi.   
\p
\v 19 \x - \xo 5:19 \xt Thuhlkk17:6; 19:5\x*Tetti ni le thum a om bale elder te mawsiatna sang heak in.   
\p
\v 20 Mawna vawt te sia mipi mai ah tei in, ngualdang te zong lau tu hi.   
\p
\v 21 Hi thu te na zui ciang in, mi khat sang in a dang khat it zaw a, doidan na taw bangma vawt heak in, ci in Pathian, Topa Jesus Christ le a tealsa vantungmi te mai ah kong vaitha hi.   
\p
\v 22 Kuama tung ah na khut nga mameang heak in, ngualdang mawna te pawlpui heak in: nangma le nangma a thiangtho in ki keam in.   
\p
\v 23 Na sungsang atu ahizong, tu le tu na thaneamna atu ahizong, tui bek hi nawn ngawl in, sapittui tatawm na zang in.   
\p
\v 24 Mi pawlkhat te mawna te sia mi theampo mai ah kilang a, thukhenna mai ah pai uh hi; taciang mi pawlkhat te sia a nung pan zui uh hi.   
\p
\v 25 Tasia bangma in mi phawlkhat te nasep pha te zong mi theampo mai ah kilang hi; taciang a kilang ngawl lai te zong phualseal thei tuan ngawl hi.   
\c 6  
\p
\v 1 Pathian min le Ama hilna sia sonsiat a hi thei ngawl natu in, sila te in amate i to te sia upat na theampo nga tak hi, ci in ngaisun ta hen.   
\p
\v 2 Amate i to te sia thu um ahile, amate sia suapui ahi ciang in zawngsak heak hen; ahihang a phattuamna sanpui te sia a thuman te le a deihuai te ahi uhkom in, nasia zaw in seam tahen. Hi thu te hil in a hanthawn in.   
\s1 Hilna Man Ngawl  
\p
\v 3 Mi khatpo in hilna tumdang hil a, i Topa Jesus Christ i thu le Pathianmi hina taw kisai hilna te a lungkimpui bua ahile;   
\p
\v 4 Ama sia a kiphasak, bangma he ngawl, ahihang, thudok nate le kam ki nial nate sia ama i nopsak pawl a hihi, tua thu pan in hazatna, ki el na, ngualdang maizumsak nate, a pha ngawl uplakna te piangsak hi,   
\p
\v 5 Thinsung lal a thu ki nial thei lampi mihing te, thuman nei ngawl te, sum le pai lam phattuamna sia Pathianmi hina bang in a ngaisun te taw ki thawl heak in.   
\s1 Lungkimna  
\p
\v 6 Ahihang Pathianmi hina taw lungkimna sia phattuamna lianpi a hihi.   
\p
\v 7 Banghangziam cile hi leitung ah bangma i keng bua hi, taciang hi leitung pan in bangma i keng thei bua hi, ci sia thiang mama hi.   
\p
\v 8 Tua ahikom in an le niklepuan i nei na za ah lungkim tawng.   
\p
\v 9 Ahihang a hau nuam te sia ze-etna le thang sung ah, mawmawtna tampi le a tuakhial thei cilesa deina te sung ah taksuk uh a, tua thu in mihing te sia susia le lalcip na sung ah khum hi.   
\p
\v 10 Banghangziam cile sum deina sia phat ngawlna theampo i zungpi a hihi: tua thu sia mi pawlkhat te in eang uh a, upna pan in paikhial uh hi, taciang thinnatna tampi taw amate le amate kisun hi.   
\s1 A Khakbel Vaithakna  
\p
\v 11 Ahihang nang, Pathian mihing awng, hite nusia in; taciang thutang suana, Pathianmi hina, upna, thianthona, itna, thuakzawkna le cikna te del in.   
\p
\v 12 Upna sung ah phatak in do in, tawntung nuntakna lenkip in, tua atu in nangma zong sap sa na hihi, taciang tetti tampi mai ah na pualak zo hi.   
\p
\v 13 \x - \xo 6:13 \xt Jn 18:37\x*Na theampo a nungtasak Pathian le Pontius Pilate te mai ah pualak na pha tettipang Christ Jesus mai ah kong vaitha hi;   
\p
\v 14 Hi thupiak sia a niin ki hel ngawl le tei kul ngawl in i Topa Jesus Christ hong kilang ni dong keamcing in:   
\p
\v 15 Tasia sia Ama hun ciang in hong lak tu hi a, Ama sia Thuphatoai le Vangletna kicing a omsun, kumpi theampo te i kumpi, to theampo te i To;   
\p
\v 16 Ama bek in thi thei ngawl na nei hi, kuama in a nai a neak thei ngawl khuavak sung ah om hi; kuama in mu ngei ngawl a, mu zong mu thei ngawl hi: Ama tung ah zatakna le vangletna a tawntung in om tawntung tahen. Amen.   
\p
\v 17 Hi leitung i mihau te sia amate le amate a sang mama in a ki ngaisut ngawl natu le, a kip ngawl hauna te muang ngawl in, na theampo nuamtak in i zat tu a tam mama in hong pia a nungta Pathian sia muan in a nei zawk natu uh vaitha in;   
\p
\v 18 Tabang in amate sia na pha vawt a, nasep pha sung ah a hau tu ahizong, hawm tu in kingingkhol tu ahizong, a neisa te a hawmsem ngam hi tu a;   
\p
\v 19 Amate atu in hongpai pheang tu hun sung ah doppha kip khol khol a, tawntung nuntakna sia kho let tu hi.   
\p
\v 20 Timothy awng, na tung ah hong ki ap te keamcing in, Pathian thusimngawl le mannung ngawl kammal te, a man ngawl in heakna langpan nate pial in;   
\p
\v 21 Pawlkhat in upna taw kisai in hil khial uh hi. Na tung ah thuthiamna hong om tahen. Amen.   