<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Bayso New Testament</book>
  <para style="h">1 ቆሮንቶሳ</para>
  <para style="toc1">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ ካሆሬ ካቆሮንቶሳ እባዶ ቶስ</para>
  <para style="toc2">1 ቆሮንቶሳ</para>
  <para style="toc3">1 ቆሮ.</para>
  <para style="mt2">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ ካሆሬ</para>
  <para style="mt1">ካቆሮንቶሳ እባዶ ቶስ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ጳዉሎሳ ካቆሮንቶሳ እባዶን ካጻፈሮ ካሆራርጄ ሀንዳኬሳ ካኮንጻፈራ ታቆሮንቶሳ ካታማይ ካአሊሰሮ ምን ካዋይ ኦሮ ግር ካአማኒና አማኖኮክ ጋራይ ታግቴ ራኮዉን ማላ ሄልን ቆፔረያ። ኡሱ ጎራታ ቆሮንቶሳ ካአላም ጎሳ ካሞጋን ታኮግረ ታግሪክ ካታማ ላኖኮ ካሮረ አካያ ካአማማረ ቃላዳ ካሮምዉን መተት ካታማተ። ህት ካታማ ካአቲ ካሌሮ ዳዳላይ ባራኖኮኒዕ ፈሎይ፥ ዎጋኮክ ጂናን፥ ኣሎ ባልአታ ካግረ ያዳሊ ታሜላንና አማኖልኮክ ሞጋን ታአዴሳንተተ።</para>
  <para style="ip">ካፋራመሮክና ካካለኮና ክንትቢ ኡሱ ካአባተረ ምን ካዋይ ኦሮ ካግረ ካለካለ ብያኖኮክ ጋራ፥ ታሜላን ያዳሊኮክ ግር፥ ሻርሙጡማኮክና እስአታታኖኮክ ጋራ፥ ምን ካዋክ ሴራልኮክ ጋራ፥ አያና ቁሉክ እላቦልኮክና ጎይኮ ክያኖኮክ ጋራነየ፤ ኡሱማለና ካፋራመሮክ ካገጌሎ ሃፉራ ሂናኣ ሆሲን ክንትቢ አባተረ እስኦረ ሰጋራ።</para>
  <para style="ip">“ጌላንጀ” ዋ ጎሳን ካስሰሮ እላቦልኮ ካሮረ ላኖ ካኮቱሰራ ታቶሞንኮሴድ ፎልሲ ሂካ ማጻፋይ ኣሎ ታአዴሳንተ ባንኤ ላኖ ሄዳማታ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="1CO 1:1-9">1፡1-9</ref> </char></para>
  <para style="io1">አማኒል ኦሮ ካግረ ካለካለ ብያኖ <char style="ior"><ref loc="1CO 1:10-4:21">1፡10—4፡21</ref> </char></para>
  <para style="io1">ያዳሊ ታሜላና ምን ኮክ እባዶኮክ ግር <char style="ior"><ref loc="1CO 5:1-7:40">5፡1—7፡40</ref> </char></para>
  <para style="io1">አማኒልና ካክርስታና አማኖ ሀአታኖን ኦግራን <char style="ior"><ref loc="1CO 8:1-11:1">8፡1—11፡1</ref> </char></para>
  <para style="io1">ምን ካዋኮክ ግርና ሄዶይሳታኖኮክ ዎጋ <char style="ior"><ref loc="1CO 11:2-14:40">11፡2—14፡40</ref> </char></para>
  <para style="io1">ካክርስቶሳና ካአማኒል ጎይኮ ከያኖ <char style="ior"><ref loc="1CO 15:1-58">15፡1-58</ref> </char></para>
  <para style="io1">ኡል ካይሁዳ ራካተ ካግሮ አማኒሉን ካስሳምናሮ ጋርጋርሳ <char style="ior"><ref loc="1CO 16:1-4">16፡1-4</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="1CO 16:5-24">16፡5-24</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />ፈኢ ታዋይ የሱሳ ክርስቶሳን ካሀንዳሮ ጎጎሌሮን ካኡማመሮ ጳዉሎሳኮና፥ አብካን ሶስንተንስኮ፥<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />ታቆሮንቶሳ ካታማይ ካግራ ካዋ ምን ካኤብ ክርስቶሳ የሱሳይ ኦቁሎየራዉና ካክሶና ካካን ጎታ ካሌሮ ጎታካን የሱሳኮክ መገይ ባንኤ ባንኤይ ሌጉረ ካኡማሮ ዱባነ ዎታ ቁሎለ ሊን ኦኡማመራዉን፥<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />ዋ ኣቦካንኮና፥ ጎታካን፥ የሱሳ ክርስቶሳኮ ስኖና ኖጎዳ እስኑን ሀሌቶ።<verse eid="1CO 1:3" /></para>
  <para style="s1">ጋላታ ዋዉን</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />የሱሳ ክርስቶሳይ ታስሳንተቶ ስኖ አርጌቶ እስን ማራን አን ዋ ጋላታራ። <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />ኣላንቲና ማምስክ አየስ ህክና ካአዬሳማሮ ዱባን ቃሩማ ዱባ ኡሱይ ዱሩማቴታን። <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />ክርስቶሳ ማራን ካአቶቲነኔና እስን ዶሌ ባተራ፤ <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />ሃኑን ጎታካን የሱሳ ክርስቶሳ ሙታኖ ሀልቻይ እስን ኦራታ ግራን ማምስክና ካአያና እላቦ እስንኮ ላኮሀንቃሮ። <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />ጎታካን የሱሳ ክርስቶሳኮት ኤመቶ ቱፍ ካላይ ጎጎሙታኑን ኡሱ ታ ጋቾ ጌሮ እስን አታይሰ ኦራራ። <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />ኤረኬሳ ጎታካን የሱሳ ክርስቶሳኮክ ራቶ ላኖ ቶስ እስን ካኡመራ ዋ ካአብዳመያ።<verse eid="1CO 1:9" /></para>
  <para style="s1">ቆሮንቶሳኮክ ምን ካኤብ ኦሮ ካግሮ ካለካለ ብያኖ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />አቢላልቴ! እስን ጠኤ ካለካለ ብያኖ ጎጎግኖንኮ ዎዳና ቶ፥ ያዳ ኮ እስኑን ጎጎግሮዉን እስእሲ ኦሮና እስኣት ህኢ ቶ ጎጎሌታዉን ጎታካን የሱሳ ክርስቶሳኮክ መገይ አን እስን ኤባታራ። <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />አቢላልቴ! እስን ኦሮ ዶጋማ ግራኖ ካቀሎኤ ካምነ እባዶኮ አን ማለራ። <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />አዬስና ሃያ፥ እስንኮ ኮ “አን ካጳዉሎሳያ” ጎአምሮ፥ ካካለ “አን ካአጲሎሳያ” አማራ፥ አደና ኮ “አን ካከፋያ” አማራ፥ ካካለ አደ “አን ካክርስቶሳያ” አማታን።<note caller="-" style="x"><char style="xo" closed="false">1፡12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">ኦፋ. ፈ. 18፡24</ref>።</char></note> <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />ሀያ ክርስቶሳ ኤካ በልኤራ? ጳዉሎሳ እስኑን ሱዋመራ? ጎርቱን ካጳዉሎሳ መገይ ጣማቃንቴታን? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />ቀርስጶሳና ጋዮሳ ኳሬ እስንኮ አን ማዮና ማንኮጣማቂኖ ግሮ ማራን አን ዋ ጋላታራ።<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">ኦፋ. ፈ. 18፡8</ref>፤ <ref loc="ACT 19:29">19፡29</ref>፤ <ref loc="ROM 16:23">ሮመ 16፡23</ref>።</char></note> <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />ሃኑን መገኬ ካጳዉሎሳይ ጣማቃመራ አመ ካአዬሳራ ማዮና ላግሮ። <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />ኦግራን ካእስጢፋኖሳ ካምነ እባዶ አን ጣማቄራ፥ ህናኣኮ ካካለ ጎአመን ጣማቃኖኬ አን ላኮሻዳሮ።<note caller="-" style="x"><char style="xo" closed="false">1፡16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 ቆሮ. 16፡15</ref>።</char></note> <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />ክርስቶሳ እን ካኮንፋረራ ዎንጋላ ጎጎላላብሮን ኳሬ ጎጎጣማቅሮን ላኮዮ፥ ታክርስቶሳ ማስቃሊ ታማድኖን ጎጎሌኖንኮ እባዶኮ ታሄላንተቶ አዬስኮት ቃሩማ አን ላኮላላባሮ።<verse eid="1CO 1:17" /></para>
  <para style="s1">ክርስቶሳ ካዋ ሁናና ቃሩማ ላኖ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />ካማስቃሊ ሃፉራ ካባሮዉን ጎዉማታ፥ ኖ ኦፋይናኖን ጎአመን ሁና ካዋያ።<verse eid="1CO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CO 1:19" />“ቃሮሌኮት ቃሩማ ባስናራ፥</para>
  <para style="q2" vid="1CO 1:19">ኦካሳንኮክ ማላባኖ ላኦ ካላይክ የልናራ” አማመ ጻፋመራ።<note caller="-" style="x"><char style="xo" closed="false">1፡19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">ኢሳ. 29፡14</ref>።</char></note><verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />ቃሮክ ሀጌ ግራ? ካካሳ ሀጌ ግራ? ሴራ ካካሳ ሀጌ ግራ? ሂካ አላም ካቆቆራራ ሀጌ ግራ? ዋ ታአላም ቃሩማ ጎዉማ ላኮየለያ?<note caller="-" style="x"><char style="xo" closed="false">1፡20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">ኢዮ. 12፡17</ref>፤ <ref loc="ISA 19:12">ኢሳ. 19፡12</ref>፤ <ref loc="ISA 33:18">33፡18</ref>፤ <ref loc="ISA 44:25">44፡25</ref>።</char></note><verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />ቃሩማ ታዋኮ ካከይ አላም እስኦቴሳኮት ቃሩማይ ዋ ማላባና ማንኮዋተ ማራን፤ ላላባኮት ጎዉማይ ዋ ኡሱ ኦአማናራን ፋይስን ታኢዳን ፈኢ ታዋ ሌተ። <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />ማጎሬና አይሁድ ባሳክ ማላታ ዶታራን፥ ካግርክ እባዶና ቃሩማ ዶታራን። <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />ኖ ጎአመን ካሱዋመሮ ክርስቶሳ ላላቢናና። ህክና አይሁድን ሀንዱዱፎ፥ አይዛብን አደ ጎዉማታ። <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />ዋ ካኡማተሮን አደ አይሁድና ሌረ ግርክጆሉን ክርስቶሳ ካዋ ሁናና ታዋ ቃሩማያ። <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />ኣላንቲና ታእባዶ ቃሩማኮ ሱረ ታዋ ጎዉማ ጂናታ፥ አታን ካእባዶኮ ሱረ ሀራኖ ካዋያ ካአታታራ።<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />አቢላልቴ! ካኮኡማንቴተን ጎራታ እስን ምስክ እባዶተን አላ ሻዳ፥ ሄዶ ኦእባዶት እስንኮ ኦሞጋን ኦካሳን ላኮቴን፥ ኦሞጋን እስና ኦአቲ ላኮቴን፥ ኦሞጋን እስና ምን ካአቲኮ ላኮኡሙላንተቴን፥ <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />አየሱን ጎአመን ዋ ቃሮሌ ሙሊስን አመጉረ ካአላም ጎዋክ አየስ አሳባራ፥ ዋ ኦአቲ ሙሊስን አመረ ካአላም ላፋክ አየስ አሳባተ፥ <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />ዋ ሂካ አላም ካካባጃመሮ አየስ ካካባጃሞን ግሮ ኣን የልን ሂካ አላምን ሁስ ካአመሮና ካቱፋመሮ ባንኤና ካኮስሳሞን አየስ አሳባተ፥ <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />ህክና ማምስክ እባዶና ኡሱ ሆረ ጎጎዳኖንኮያ። <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />ካክርስቶሳ የሱሳ ላኖ ኡሱኮ ካኬይያ። ኡሱ ዋ ዶለኮ ቃሩማታን፥ ቁሉማታን፥ ቃጄላካን ዎዶካን ሌራ። <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />ጎርታኑ ማጻፋይ ሃ አማመ ጎጎጻፋመሮይ “ካዳታራ ዱባ ዋይ ሀዳቶ።”<note caller="-" style="x"><char style="xo" closed="false">1፡31 </char><char style="xt" closed="false"><ref loc="JER 9:24">ኤር. 9፡24</ref>።</char></note><verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s1">ካሱዋመሮ ክርስቶሳኮክ ጋራ አጋልስሳኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />አቢላልቴ! አን እስን ቶስ ታኮኤመየሬ ሆል ታዋ አየስ ኦኖሞይስ አዬሳኖና ካሳኖ ጎርቱን ታሮርተ ቃሩማይ ላላብን ላኮኤሜየሮ።<note caller="+" style="f"><char style="fr" closed="false">2፡1 </char><char style="fqa" closed="false">ካዋ ጋራ አቶታኖ፤ </char><char style="ft" closed="false">ቶቶ ታጋልባ ጹፍል፥ “ሆል ታዋኮክ ጋራ አጋልስሳኖ” አማራ። </char></note> <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />እስን ኦሮ ግራን የሱሳ ክርስቶሳ ሀሱና ካሱዋመሮ ኡሱ ካላል ኳሬ አን ጎጎአዴሶንኮ አን ሙርቴሳየ ግረ። <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />እስን ቶስ ካኮንኤሜየራ ሀራኖይና አብሲ፥ ኡሱማለና ካአቲ ሀርኣኖይየ። <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />ሃፉራክና ላላባኖክ ካአያና ሁናይ ቱሳኖይ ኳሬ ካሶሶብሮ ካቃሩማ ሃፉራ ላኮየ። <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />ህክና አማኖክስኒ ሁና ካዋይ ኳሬ ታእባዶ ቃሩማ ጉት ጎጎጣባኖንኮያ።<verse eid="1CO 2:5" /></para>
  <para style="s1">አያናኮ ታሄላንተቶ ቃሩማ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />አያናይ ካዱባመ እባዶ ኦሮ ጎአመን ቃሩማ አዬስናና፥ ሀሌዎ ኳሬ ሂካ አላምኮት ቃሩማ ጎርቱን ታባይናቶ ሂካ ካአላም ሞትጆልኮት ቃሩማ ላኮዮ። <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />አየሱን ጎአመን ስያንተ ታግቴ ሆል ታዋ ቃሩማታ። ህት ቃሩማ ካሞጋን ጌስጆልኮ ሆረነ ካባጃታንዉን ጣይተ ታሙርተሳንተቶተ። <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />ሂካ አላም ካግሮ ሞትጆል ኦሮኮ ኮና ህታ ቃሩማ ላኮማላቤራን፥ ማላብ ግሬንዋ ካካባጃ ጎታ ላኮሱዋሬን። <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />ሀሌዎ ኳሬ ማጻፋይ፥</para>
  <para style="q1" vid="1CO 2:9">“እል ካዴኖን ግቶ፥</para>
  <para style="q2" vid="1CO 2:9">ነበ ታእባዶ ካማሎን ግቶ፥</para>
  <para style="q2" vid="1CO 2:9">ዎዳና ታእባዶ ካሻዶን፥</para>
  <para style="q2" vid="1CO 2:9">ዋ ኦጌላታሮን ኤካሰራ” አማመ ጻፋመራ።<note caller="-" style="x"><char style="xo" closed="false">2፡9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">ኢሳ. 64፡4</ref>።</char></note><verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />ዋ አደ ሂካ አያናኬሳክ ጋራነ ኖን ሙትሰራ፥ አያና ካዋ ስያንተ ታግቶ ሆል ታዋ አሃሶን ዱባ ቆቆራራ። <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />እባዶ ኦሮ ካግሮ ካአዴሳራ አያና ካእባዶ ኳሬ ያዳ ካእባዶ ካማላብራ አዮያ ካግራ? ኡሱማለና አያና ካዋ ኳሬ ታዋ ካአዴስራ ኮና ላኮግሮ። <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />ዋኮ ካሌሮ አያና ኳሬ ካአላም አያና ላኮአታነኖ። ህክና ዋ ኖን ዳናባ ካስሰሮ ጎጎማላብኖንያ።<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />ኖ ካአዬስናና ሂካያ፥ እባዶኮ ካአጋልሳነኖ ቃሩማኮክ ሃፉራይ ሀሌኖን አያናኮ ካአጋልሳነኖ ሃፉራ አዬስናና፥ ታአያና ሩም ካኮአዴስስናና ካአያና ሃፉራኮያ። <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />ካአያና ካሌኖን እባዶት አያና ካዋኮ ላኮሌሮ አዬስጆል አታይን ላኮዳንዳሮ፤ ኣላንቲና ሂካማሌክ አየስ ኡሱን ጎዉማታ፥ አያናይ ካቆቆራማሮ ማንኮሌሮ ማራን አዴስን ላኮዳንዳሮ። <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />ካአያና እባዶ አደ አየስ ዱባና ማራማራራ፥ ኡሱ አደ ማዮይና ላኮቆቆራማሮ።<verse eid="1CO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CO 2:16" />“ጎጎአጋልስስሮን፥ ታጎታ ዎዳና አዮያ ካአዴስራ፥</para>
  <para style="q2" vid="1CO 2:16">ኡሱ ጎርሲን ካዳንዴራ አዮያ?” አማመ ጎጎጻፋመሮያ።</para>
  <para style="m" vid="1CO 2:16">ኖ አንዴ ታክርስቶሳ ዎዳና አብና።<note caller="-" style="x"><char style="xo" closed="false">2፡16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ. 40፡13</ref>።</char></note><verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s1">ምን ካዋይ ኦሮ ካመጣመሮ ካለካለ ብያኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />አቢላልቴ! ክርስቶሳይ ጋና ይስ ጎጎሌተታን ፈኢ ታሶየክ ማለ ኳሬ ፈኢ ታአያና ማለ አዬስን አን ላኮዳንዴሮ። <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />ጋና ሀአታኖን ማንኮግታን ማራን ኤኖ ኳሬ ካአቲ ባቦ አን እስን ላኮኣምስናሮ፥ ግዳና ጎአመን ጋናታን።<note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">እብ. 5፡12-13</ref>።</char></note> <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />ግዳና ኦሶየታን፥ እስን ጠኤ ምጌና ዶጋማ ግታ፥ ሀያ ኦሶየ ላኖክስን ላኮዮያ? እስን ኦፈላታን ፈሎ ማዮና ኦፈላሮ ፈሎ ኣን ላኮያንያ? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />ኣላንቲና ኮ “አን ካጳዉሎሳያ” ካካለ አደ፥ “አን ካአጲሎሳያ” ጎአምሮ መጣ ታእባዶ ታላል ኣን ላኮዮያ?<note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 ቆሮ. 1፡12</ref>።</char></note><verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />ጎሌና አጲሎሳ መያ? ጳዉሎሳና መያ? ጎታ እሶን መተመቴ ኦስሰሮ ፈሎኮክ ጅልባ ማለ ኦሀንዳራንያን፥ እስና አማኖ ቶስ ካኮኤሜተታን ጋራክሶነያ። <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />አን አባረራ፥ አጲሎሳ በከ ጣምሰራ፥ ካጂናሰራ አደ ዋያ።<note caller="-" style="x"><char style="xo" closed="false">3፡6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">ኦፋ. ፈ. 18፡4-11</ref>።</char></note> <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />ሃንሱን ካጂናሳራ ዋ ኳሬ ካአባረሮና ሌረ በከ ካጣምሰራ ኮና ላኮዮ። <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />ካአባረሮና ሌረ በከ ካጣምሰራና ኮያን፥ መተመቴይና ፈሎኦቴሳክ ጅልባ ማለ ባራኣራክሶ አታይናራን። <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />ኖ ራቶ ዋዉን ኦፈላኖ ኦዋና፥ እስና ካዋ ኢራታን፤ ምን ካዋክ ግንበታን። <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />ዋኮ ታስሳንተቶ ስኖኮት ጅልባይ ምን ካግንባሮ ቃሮክ እባዶት አን ኡኩም ጣቢሰ። ካካለና ጉት ማዳረራ፥ አየሱን ጎአመን መተመተይ ምስምሲ ማዳራይናሮ እስኦራታኖ ዶትሳራ። <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />ኣላንቲና ኮይክ ካጣቢሳመሮ ኡኩም ኳሬ ካካለ ኡኩምን ካዳንዳራ ማዮና ላኮግሮ፥ ሂክ ኡኩምና የሱሳ ክርስቶሳያ። <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />ማዮና ሂካ ኡኩሚ ጉት ዎርቂኮ ጎርቱን ብርኮ ካካባጃመ ኤኤሞኮ፥ ጎርቱን ጋ፥ ኤስኮ ጎርቱን አጋዳኮ፥ ጎቢሰ፥ <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />ፈሎ ኦእባዶ መተመተይ ታኮአዴሳምራን አሪ ኤመይናታ ኤሰ አሪ ቱስናታ፥ ኣላንቲና ኤሰ አሪ እባዶኮኒዕ ፈሎ ምስኒዕያን ኤለኒ ማንኮጫፋምናራን ማራን ኤለን ቱስናታ። <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />ማዮና ኦፈላተሮ ፈሎይ ጎአታተ ባርኣራ አታታራ። <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />ፈሎ ኤለኒ ካኮጉባተራን ጎአመን ባርኣራ ሄሳራ፤ ኡሱ ኡሱን አደ ፋይናራ፥ ሀሌዎ ኳሬ ካኮፋይናራ ኤለን ኦሮ ማረ ጫፋመረ ካሮራሮ አንያ።<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />እስን መተክስኑን ቁሉክ ምን ካዋ ላኖክስና አያና ካዋ እስኒ ኦሮ ግራኖ ላኮካሳንያ?<note caller="-" style="x"><char style="xo" closed="false">3፡16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1 ቆሮ. 6፡19</ref>፤ <ref loc="2CO 6:16">2 ቆሮ. 6፡16</ref>።</char></note> <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />ሃንሱን ማዮና ቁሉክ ምን ካዋ ጎዲገ ዋና ኡሱ ዲግናራ፥ ምን ካዋ ቁሉክያ፥ ሀሱና ቁሉክ ምን ካዋ እስንታን።<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />ማዮና እስኦቴሳ አሮሶባኖ፥ እስንኮ ማዮና ሂካ አላም ቃሮ ኣን ጎሌ ቃሮ ሊን እስኦቴሳ ጎዋ ኣን ሀቶታቶ። <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />ሂካ አላምኮት ቃሩማ ዋይ ሆረ ጎዉማታ፥ ህክና “ዋ ቃሮሌል ምጌትሶኔ ዎታ አብናራ” አማመ ጎጎጻፋመሮይያ።<note caller="-" style="x"><char style="xo" closed="false">3፡19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">ኢዮ. 5፡13</ref>።</char></note> <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />ባንኤ ታካለይ አደ “ጎታ ቃሮሌልኮት ቆፋ ላኦ ካላይክ ላኖ ካሶዋ” አማመ ጻፋመራ።<note caller="-" style="x"><char style="xo" closed="false">3፡20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">ማዛ. 94፡11</ref>።</char></note><verse eid="1CO 3:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="1CO 3:21" />ጎርታኑ ማዮና እባዶይ አሮዳኖ። ካመን ዱባ ካክስንያ። <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />ጳዉሎሳና ሌረ አጲሎሳ ጎርቱን ከፋ፥ አላምና ሌረ ግር ጎርቱን ጎይ፥ ግዳ ካግሮና ሌረ ሆረንባን ካኤሜይናራ ዱባ ካክስንያ። <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />እስን ኦክርስቶሳታን ክርስቶሳና ኤረ ካዋያ።<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s1">ክርስቶሳ ኦፋራመራን</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />ጎርታኑ እባዶ ዱባ ኖ ክርስቶሳን ኦሀንዳኖ አንና ሆል ታዋ ቱሳኖኮት ሀዳራ ኦአታነኖ ኣን ኖ ሀቶቴን። <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />ሃ ጎሌ ሀዳራ ኦአታቴራና ኦአብዳሜራን ሊ ግራኖ ዶትሳራ። <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />እስኑና ሌረ እባዶይ ታፍርዳ ሾንጎይ ጎጎፍርድቶን አን ጋራኬነ ራኮ ላኮአቦ፥ አን ሱረ እስኦቴይ ጉት ላኮፍርዳይናሮ። <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />ሳሙት ቁሉታ፥ ሂክ ጎአመን ባስ ካላይክ ላኖኬ ላኮአዴስሳሮ፥ እን ጉት ካፍርዳራ ጎታያ። <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />ሃኑን ጎራታ ሀጌኖን ማምስክ አየስ ጉት አሮፍርድቴን። ጎታ ታኤሜሮይ ኦራ፥ ኡሱ ሙጉድ ኦሮ ካስያመሮ ኢፋ ቶስ ቤስናራ፥ ዎዳና ታእባዶይ ኦሮ ስያመ ካግሮ ያዳ ሙትስናራ፥ ሀሱ ጎራታ እባዶ መተመተኬሳይ ካዶትሳሮ ጋላታ ዋ ዶለኮ አታይናራ።<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />ጎርታኑ አባላልቴ! ላኦትስኑን አመጉረ ህታ ሃጃይ እስኦቴና አጲሎሳ ማሱሴ ኬነራ፥ ሂካና ካኮንየለራ “ካጻፋመሮኮ አሮሮርተ” ካአማመሮ ኖኮ ጎጎአጋልሳታዉንያ፥ ሃኑን እባዶት ኮይ ዳታ ካካለ አሮቱፋቴን። <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />ጎሌና አት ካካለኮ ጎጎሮርቶ ካየለራ አዮያ? ካካ ካሌሮ አየስኮ አት ሀአታኖን ካግታ መያ ካግራ? ሀያ አታተ ግራን ሀአታኖን ካግሮ ኣን ሙን ዳታ?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />ግዳ ካዶትሳሮ ዱባ ሄላቴታን? ዱሬሳና ሌቴታን? ኖኮና ካለቤተዴን ሬዴታን? ኦግራን እስን ሬድ ግቴንዋ ኖና እስኔ ዎታ ሬድ ግራነ። <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />ኣላንቲና ዋ ኖ ኦፋራምነኖ ጎይን ካፍርዳመሮ እባዶ ታኮላጋድራን ባንኤ ቶስ ጌስን እባዶ ዱባኮ ሀርጫ ካኣልሰራን እባዶ ኣን ኢን ላራ። አላም ዱባ ኤርግቻና እባዶን ድራማ ኣን ደያምናና። <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />ኖ ክርስቶሳ ማራን ጎዎሌና፤ እስን ጎአመን ክርስቶሳይ ቃሮሌታን፥ ኖ ላፋና፥ እስን ጎአመን ኦአቲታን፥ እስን ኦካባጃንተታን፥ ኖ ጎአመን ኦየራነና። <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />ታ ህታ ሳቲ ጌኖን ኡአና፤ ሱጉባታና፤ ሀዉአይ ላና፥ ቦጫምናና፥ ምን ዋነኔ ካፋፋና፥ <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />ገነታን ፈላታ ሀራና፥ ጎቃንግናን ሶማሳታና፥ ጎሆሮራን ኦብሳና፤<note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">ኦፋ. ፈ. 18፡3</ref>።</char></note> <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />መገካን ጎባስራን ታኢዳን አባባና፥ ታ ግዳ ጌኖ ካአላም ቡቡልና ካኡሌ ሻካር ሌነና።<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />ሂካ ካኮንጻፈራ ኦጌላንቴታን ይስኬ የላየ ማካርሳዪን ኳሬ ሙሊስን አመ ላኮዮ። <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />ኮና ሱረ ኩማ ቶሞኑን ካቶታምሮ ኦጂናሴራን ክርስቶሳይ እስኑን ጎግሬና ካሞጋን ኦዶላል አደን ላኮአብታን፥ ጋራ ካዎንጋላነ ክርስቶሳ የሱሳይ እስን ኡሙለራ። <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />ሃኑን እስን እን ኣን ጎጎሌታዉን ኤባታራ። <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />ጎርታኑ ካጌላታመራና ካአብዳመራ ጎታይ ኤረኬ ካሌሮ ጢሞቶሳ ካኮፋረራ ሂካኮት ኣላንቲያ፥ ኡሱና ባንኤ ባንኤይ ካሞጋን ምን ካኤብ ዱባይ አን ጎጎአጋልስሳሮ ክርስቶሳ የሱሳ ኮ ላኖይ ካሄላየሮ ካኡሱብ ግርኮክ ራ እስን ሻድሳራ።<note caller="-" style="x"><char style="xo" closed="false">4፡17 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 ቆሮ. 11፡1</ref>፤ <ref loc="PHP 3:17">ፍል. 3፡17</ref>።</char></note><verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />እስንኮ ኮኮ አን እስን ቶስ ካኤሜኖን ኣን ሌረ ኮራሜሳ ለራን። <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />ሀሌዎ ኳሬ ፈኢ ታጎታ ጎሌተ አን እስን ቶስ ሳሜ. ኤሜሮዋ፥ ኤሰኮና ሂኒዕ ኮራሜሳል ካአዬሳራን ካላሊ አሌኖን ግራን ኤግታክ ሁና አባን ድን ዶታራ፥ <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />ኣላንቲና ዎኖናት ካዋ አዬሲ አሌኖን ግራን ሁና ካዋይያ። <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />ጎሌና እስን ካዶታታን ኤክያ? ዳማ አባይ ኤሜዉ? ሙ ጌላንጄይና ካኢዳነ አያናይ ጎጎኤሜሮ ዶታታን?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s1">ባቲኒዕ ፈሎ ዋ ካአማንሮ እባዶ ኦሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />እስን ኦሮ ኦሙልስራን ኦሻርሙጡማ ፈሎ ግራኖ ኦግራን አዬሳማራ፤ ሂካማሌኒዕ ባቲኒዕ ፈሎ ዋ ካአማኖን እባዶ ዶሌ ዱዶ ሙት ካካሶንያ፤ ኦራቦቴሳ ኦር ካየላተራ እባዶ ግራ።<note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">አዳ. 22፡30</ref>።</char></note> <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />አደነ እስን ኮርቴታን፥ ሀሱኮ ሂካ አዬሲ ጋድጉዴን ሂካ ኣንክክ እባዶ እስን ኦሮኮ ቤስን ላኮዶትሳረያ? <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />ማምሲና ሱረ አን ሶይ እስኔ ዎታ ጎግራናዋየና አያናይ አደ እስኔ ዎታ ግራ፤ እስኔ ዎታ ካግሮ ኣን ሌረ ሂካ ካፈለሮ እባዶት ጉት ግዳዋ አን ፍርዴራ። <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />እስን ካኮኩኩአማታን ጎራታ አንና አያናይ እስኔ ዎታ ማንኮግሮ ማራን ጎታካን ካየሱሳ መገይና እስን ጠኤ ካሙታሮ ጎታካን የሱሳኮክ ሁናይ፥ <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />ሶ ባይጉረን አያና ታጎታ አሪ ጎጎፋይሮ፥ ሂካ ኣንክክ ጻላዬን ሀስሳሞ።<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />ዳታኖክስን ካእዳን ላኮዮ፥ ሁጫር ኢርሾ ካሙላመሮ ካም ካንጂን ካኬሳሮ ላኮካሳንያ?<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">ጋላ. 5፡9</ref>።</char></note> <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />ግዳ ሜላነ ካላይ ጎጎግታን ካኡሱብ ካሙላመሮ ካም ጎጎሌታዉን ታዶአን ኢርሾ ባሳ። ካፋስካ ኢዳዶካን ካሌራ ክርስቶሳ ኤናኣመራ። <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />ሃኑን ምጌና ሜላነ ታኮአማጋንተቶ ታዶአን ኢርሾይ ሀሌኖን ግራን፥ ኢርሾ ካልክ ካባቦ ባላካን ኢዳነና ሩሚ ካባጅኖ።<note caller="-" style="x"><char style="xo" closed="false">5፡8 </char><char style="xt" closed="false"><ref loc="EXO 13:3">ብያ. 13፡3</ref>፤ <ref loc="DEU 16:3">አዳ. 16፡3</ref>።</char></note><verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />ካሻርሙጡማ አራዳ ኦአባነ ዎታ እስን ጎጎሌኖንኮ ሀንዳኬ አን እስኑን ጻፈረ። <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />ሂካ ሃ እስኑን አን ጎአምሮ ዋ ኦአማኖን ኦግራን ኦሻርሙጣራነ ጎርቱን ኦጋጲጋጳራነና ኦሳማራነ፥ ጎርቱን ምን ካሞሩ ሴተሬን ኦኤባታራነ ዎታ አሮሌተን አማኖ ላኮዮ፥ ሃ ጎሌ ሂካ አላምኮ ዱዶ ካለ ብያኖ ካዶትሳሮ ሊ ግራረ። <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />አየሱን ጎአመን ግዳ አን ካኮንጻፈራ “አማኒልና” አማ ኦሻርሙጣራን፥ ጎርቱን ኦጋጲጋጳራን፥ ጎርቱን ምን ካሞሩ ሴተ ኦሳጋዳራን፥ ጎርቱን ኦሰታራን፥ ጎርቱን ኦሳማራነ ዎታ ጎጎለለዳሞንኮያ። ሂካ ኣንክክ እባዶነ ዎታ ባቦ ሱረ አሮኣንቴን።<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />ምን ካዋኮ ሳሬ ካግሮ እባዶ ጉት ፍርድን እን መያ ካታብሰ? ምን ካዋይ ኦሮ ካግሮ እባዶ ጉት እስን ላኮፍርዳታንያ? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />ምን ካዋኮ ሳሬ ኦግራን ጉት ካፍርዳራ አደ ዋያ፥ ጎርታኑ ቁሉክ ማጻፋ ጎጎአማሮ፥ “ካሜላን እባዶ እስን ኦሮኮ ቤሳ።”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s1">እስሮ እስ ሞታኖ እባዶ ካዋይ ኦሮ ሙታኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />እስን ኦሮኮ እባዶት ኮ ካካለ ዋ ካአማንሮነ ዎታ ዶጋማ ጎግርተ፥ ሃጃተሳ ቁሎለ ሆረ ፍርዳምን ዶትሳ ግራን ዋ ካአማኖን እባዶ ሆረ ምሲ ፍርዳ ሰጋዪን ጃባታራ? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />ቁሎሌል አላም ጉት ካፍርድናራን እስን ላኮካሳንያ? አላም ጉት ካፍርዳታን ጎሌተን ጎርታ አየስ ክጫር ጉት ፍርድን ላኮዳንዳታንያ? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />ግር ካኡሌኮት ሃጃ ኢሳጋዴን ሱረ ኖ ኤርግቻል ጉት ካፍርድናኖ ላኮካሳንያ? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />ጎርታኑ እስን እስእስ ኦሮ ኢንሰ ጎኢንጋቴን ዋ ካአማናሮ ማባራኮ ሳሬ ካግሮና ካቱፋመሮ እባዶን ሃጃትስን ሙን ሰጋታን? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />ሂካና አን ካኮንአመራ እስን ሙሊስንያ። ጎሌና እስን ኦሮ ዋ ካአማናሮ ጃርሳ ሊ ዎጋርሲን ካሻዳራ እባዶ ላኮግሮያ? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />አየሱን ጎአመን ዋ ካአማናራ ካአማናሮ ሞትን ምን ካፍርዲ ሴታራ፤ ህክና ዋ ካአማኖን እባዶ ሆረ!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />ጎርታኑ እስሮ እስ ሞታኖ ኢያኖክስን ቱሳራ፥ ጎሚራንተን ላ ኢዳሮላ? ጎሶብቴን ላ ኢዳሮላ? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />እስን አዴን እስኦትስን ሚራኣታን፥ ሶባታን፥ ሀኑኡና ኦአማናራን። <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />ኦሜላን ዎኖናት ካዋ ኤላናዋት ላኮካሳንያ? ሂካ አዬሲ አሮሶባንቴን፥ ኦላይማራን፥ ቶልቻ ኦሄዶይሳታራን፥ ኦሻርሙጣራን፥ ባባሩማ ኦዋተራን፥ ባባር ባባርነ ዎታ ኦሁዱራራን፥ <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ሄቶጆል፥ ማራጋደ ኦጌላታራን፥ ኦሰታራን፥ ኦኢንጋማራና ኦሳማራን ዎኖናት ካዋ ላኮኤላራን። <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />እስንኮና ኮኮ ሂካማሌ ግቴን፥ ግዳ ጎአመን ጎታ የሱሳ ክርስቶሳኮክ መገይና ሄዶካንኮክ አያናይ ጩቦኮ አልሳንተታን፥ ሙጭአንተታን፥ ቁሎይቴታን።<verse eid="1CO 6:11" /></para>
  <para style="s1">ካሻርሙጡማ ጩቦ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />“ካአመን ዱባን ኢን ፈኢ ስሳንተታ” ሀሌዎ ኳሬ አየስ ዱባና ላኦ ላኮአቦ፥ “አየስ ዱባን ኢን ፈኢ ስሳንተታ” ሀሌዎ ኳሬ ማመሱና ላኮኢምናምናሮ።<note caller="-" style="x"><char style="xo" closed="false">6፡12 </char><char style="xt" closed="false"><ref loc="1CO 10:23">1 ቆሮ. 10፡23</ref>።</char></note> <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />አደና “ባቦ ቦጉንያ፥ ቦግና ባቦንያ” ዋ ጎአመን ላማ ዱባና ባሳራ። ማር ጎታዉንያ ኳሬ ሻርሙጣኖን ላኮዮ፥ ጎታና ማሩንያ፥ <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />ዋ ጎታ ጎይኮ ጎጎኬሰሮይ ኖና አደ ሁናኬሳይ ጎይኮ ኬስናራ። <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />ማርክስን ካክርስቶሳ ምክታል ካሌሮ ላኮካሳንያ? ሀያ ካክርስቶሳ ምክታል ኣተጉረ ሻርሙጣኖይ ካባሬሮ ምክታልነ ዎታ ኮ የሉ? ሱረ ላኮዶትሳሮ። <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />ጎርቱን ሻርሙጡማ ካባሬሮነ ዎታ ካላራ እባዶት ኤሰ ዎታ ማር ኮ ላኖ ላኮካሳንያ? “እሶ ላማ ማር ኮ ላራን አማመ ጻፋመራ።”<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መጣ 2፡24</ref>።</char></note> <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />አየሱን ጎአመን ጎታነ ዎታ ካላራ ኡሱነ ዎታ አያናይ ኮ ላራ።<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />ሻርሙጡማኮ ባቃዬን፥ እባዶ ካፈላራ ጩቦ ዱባ ማርኬሳኮ ሳረያ፥ ሻርሙጡማ ካፈላራ ጎአመን ማርኬሳ ጉት ጩቦ ፈላራ። <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />ጎሌና ማርክስን እስን ዋኮ ካአታቴታና እስኒ ኦሮ ካግሮ አያና ቁሉክኮክ ምን ካዋ ላኖ ላኮካሳንያ? ሂክ አያናና ዋኮ ካአታቴታንያ፥ እስና ኦዋታን ኳሬ ኦትስን ላኮታን።<note caller="-" style="x"><char style="xo" closed="false">6፡19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 ቆሮ. 3፡16</ref>፤ <ref loc="2CO 6:16">2 ቆሮ. 6፡16</ref>።</char></note> <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />እስን ማራጋዴይ ኢምናንቴታን፥ ሃኑን ማርክስን ዋ ካባጃ።<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s1">ጋራ ካሃስኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />እስን እን ታጻፍተታንኮት ሃጃዉን እባዶ ሄለልኔ ዎታ ሁዱራናዋተዋ ካእዳንክያ። <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />አየሱን ጎአመን ሻርሙጡማኮ እስኦራዪን መተመቴ ባባሩን ኦር ሀግርተ፥ ሄሌልትቲዉና መተመቴ ኤንተር ሀግረ። <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />ኤንተር ኦርቴሳን ካዶትሳሮ ታኦርና ታኤንተሬ ኤሴላ አሮትራኖ፤ ኦርና ኡሱማሌ ኤንተርክሴዉን ታዶትሳቶ ኤሴላ አሮትራኖ። <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />ማር ካኦሪ ካክሴ ካላል ላኮዮ፥ ካኤንተሬነያ። ኡሱማሌ ማር ካኤንተሬና ካኬሳ ካላል ላኮዮ ካኦርነያ። <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />ኤቢ አታይን እስአታጉዴን ጎራታ ክጫሩን ጎሌ ኳሬ ኢንሰ ኤሴላ አሮዲዴን፥ እስ አዎዳታናዋትኮ ካከይ ጻላየ ጎጎጫፎንኮ ግዳና ዎታ ላ።<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />ሂካ አን ካኮንአመራ አጃጃ ስሳኖ አንሌኖን ግራን እስኑን ማርካ ስሳኖያ። <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />እባዶ ዱባ እን ኣን ሌዋ ካእዳንየ፥ አየሱን ጎአመን እባዶ መተመተይ ዋኮ ካአታተሮ ካኬሳ ካሌ እላቦ አባ። ኮዉን ምዲ ኮክ እላቦ ጎግሮ፥ ካካለቱን አደ ምዲ ታካለክ ካስኖ እላቦ አባ።<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />ኦኬሳሞን ግራዉንና ኤንተርክሶ ኦኮንጎየሮ ሄለሉን አን ሃ አማራ፥ ኤንተሪ ሀኬሳሞና ኦር ሀአታኖን እን ኣን ግሬንዋ እሶን ካእዳንያ። <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />አየሱን ጎአመን እስኦትሶ አዎዳታና ጎዋቴን ሀአታተን፥ ሀልቻይ ጉባታናኮ አታታኖና ኬሳማኖ ካእዳንክያ።<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />ኦአታቴራዉና ኦኬሳሜራዉን አን ሂካ አጃጃ ስሳራ፥ ሂክ አጃጃና ካጎታያ ኳሬ ካኬ ላኮየ፥ ኦር ኤንተርክሴኮ አሮቤኖ። <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />ኤንተርኮ ጎቤተና አደ ሀኬሳሞን ሀግርተ፥ ጎርቱን ኤንተርክሰነ ዎታ ሀዎጋርተ፥ ኤንተርና ኦርቴሳ ኬልክም አሮቤሶ።<note caller="-" style="x"><char style="xo" closed="false">7፡11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5፡32</ref>፤ <ref loc="MAT 19:9">19፡9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፡11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፡18</ref>።</char></note><verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />ኦካለቱን አደ ሃ አማራ፥ ሂካና አንያ ካአማራ ኳሬ ላኮጎታዮ፥ ዋ ሀአማኖን ታግቶ ኦር ካአባ ዋ ካአማናራ እባዶት ኮ ግረ፥ ኦርቴሳ ኡሱነ ዎታ ግርን ታዶታቶ ጎሌተ፥ ከልክ አም ቤስን ላኮዶትሳሮ። <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />ዋ ሀአማኖን ካግሮ ኤንተር ታአብታ ዋ ታአማናታ ሄለልትቲ ጎግቴ ኡሱና ኤሰነ ዎታ ግርን ካዶታታሮ ጎሌ ኤንተርክሴ ጋፋር ብን ላኮዶትሳሮ። <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />ዋ ሀአማኖን ካግራ ኤንተር ዋ ታአማንተቶ ኦርቴሳኮክ ኣላንቲ ኡና ታዋ ላራ፥ ዋ ሀአማኖን ታግታ ኦርና ካአማኔሮ ኤንተርክሴይ ኡና ታዋ ላታ፥ ጎርቱን ይስክሶ ባቶሌ ልናራን፤ ግዳ ጎአመን ኡና ታዋ ሌራን፤ <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />አየሱን ጎአመን ዋ ሀአማኖን ታግታ ኡና ካለ ብን ጎዶታተ ሀቤቶ፥ ዋ ካአማነራ እባዶት ኮና ሄለልትቲ ቶ ጎርቱን ሂካ ጋራይ ኦሻሜራን ላኮያን፥ ዋ ኖ ኮኮንኡመራ ኖጎዳ ጎጎግርኖንያ። <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />አት ዋ ታአማንተታ ሄለልትቲ ኤንተርካ ካፋይሳይናቶ ላኖ መ ካሳ? ጎርቱን አት ዋ ካአማንተታ ባባርትት ኦርታ ካፋይሳይናቶ ላኖ ካሶ?<verse eid="1CO 7:16" /></para>
  <para style="s1">ዋ ጎጎኡመሮ አታይ ግራኖ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />ጎርታኑን ጎታ እባዶን ካስሰሮ እላቦና መተመቴ ዋ ጎጎኡመሮ ኤሰ ሀግሮ፤ ካሞጋን ምን ካኤብ ዱባይና አን ካስሰራ ዎጋ ሂካያ። <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />እባዶት ኮ ሀማጽሳመ ግራን ካኡማመ ጎሌ፥ ሀሃማጽሳሞን ካግሮ እባዶት ኣን አሮቆፒኖ፥ ሀሃማጽሳሞን ግራን ካኡማመ ጎሌ አሮሀማጽሳሞ። <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />ሀማጽሳማኖና ሌረ ሀማጽሳናዋት ላኦ ላኮአቦ፥ መተክ አየስ አጃጃ ካዋ ኦራታኖያ። <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />እባዶ መተመተይ ጎጎኡማመሮክ ማለ አታይ ሀግረ። <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />ዋ ኩ ካኮኡመረ ጎራታ አት ድይተ? ሀሱ አሮያደ፥ ባልቹማታ ሄላታኖ ጎዳንደተ አደ ባልቹማታ አታ። <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />ኣላንቲና ድይ ሌ ግራን ጎታይ ካኡማመራ ካጎታ ባልቻክ እባዶትያ፥ ኡሱማለና ባልቻክ ሌ ካኡማመራ እባዶት ካክርስቶሳ ድይያ። <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />ዋ እስን ኤረኬሳክ ኢግ እምናተራ፥ ሃኑን ካእባዶ ድይ አሮሌተን። <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />ኣላንቲና አቢላልቴ! እባዶ መተመተይ ካኮኡማመሮ ዋኔ ዎታ አታይ ሀግረ።<verse eid="1CO 7:24" /></para>
  <para style="s1">ሀኬሳሞን ኦግራና ኤንተር ካኮጎዬሮ ሄለል</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />ሀአታኖንና ሀኬሳሞን ካግሮ እባዶኮክ ጋራ አን ጎታኮ ካአታዬራ አጃጃ ላግሮ፥ ሀሌዎ ኳሬ ካጎታ ሻጋኮ ካከይ ካአብዳመ እባዶ ኣን ማርካቴ ስሳራ።<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />ግዳ ታግቶ ራኮኮ ካከይ ታኮግታን ግቴንዋ ካእዳን ኣን ላራ፥ <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />ኦር ካአታተቶ ጎሌተ ኬልክምን አሮዶተ፥ ሀአታኖን ካግቶ ጎሌተና ኦር አታይን አሮዶተ። <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />አት ባባርትትና ኦር ጎአታተ አደ ጩቦ ላኮፈልተቶ፥ ዴሌልትትና ጎኬሳንተ ጩቦ ላኮፈልተቶ፥ አየሱን ጎአመን ካአታተሮና ካኬሳመሮ እባዶን ሂካ አላም ጉት ራኮ ታሞጋን ግያታ፥ አንና ሂክ እስን ጎጎጌኖንኮ ዶታራ።<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />አቢላልቴ! ያዳክ ሃያ፥ ጌስ ካጋባባንያ፥ ጎርታ ኦር ኦአታቴራና ኦር ካላይክ ኣን ሀግሬን። <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />ኦኦታራና ኦኦኖን አን፥ ኦገገላታራና ኦገገላኖን ኣን ሀሌን፥ ሁ ኦኢምናቴራና ካእምናተራን ሁ ካክሶ ካሌኖን አን ሀቶታቴን። <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />ሂካ አላም ላኦ ካስሳራ ኮኮ ላኦ ቶና ካስሶን ኣን ሀሌዎ፥ ሂካ አላምኮት ምዲ ታሮርቶታ።<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />አንና እስን ሀያዶን ጎጎግርታኑን ዶታራ፥ ኦር ሀአታኖን ካግራ እባዶ ጎታ ገጌላይስን ማንኮዶታሮ ማራን ካጎታ አየስ ሻዳራ፥ <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />ኦር ካአታተራ እባዶ ጎአመን ኦርቴሳ ገጌላይስን ሂካ አላምኮክ አየስ ሻዳራ። <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />ሂካኒ ዎዳናቴሳና ቆፋ ላማ ሌተ ሀኬሳሞን ታግታ ሄለልትቲ ጎርቱን ዴለልትቲ ጋራ ካጎታክ አየስ ሻዳታ። ፈሎኦትሰና ሶይና አያናክሴይ ጎታዉን ቁሎዋኖያ። ታኬሳንተታ ሄለልትቲ አደ ኤንተርክሴ ገጌላይስን ማንኮዶታቶ ማራን ሂካ አላምኮክ አየስ ሻዳታ።<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />አን ሂካ ካኮንአማራ እስኑን ካኤካሮ አየስ ሻዳኖይያ ኳሬ እስን ያድስን ላኮዮ፥ ፈሎኦት ዎዳናትስን ላማ ሀበልኤኖን ጎታይ አታይ ማራጌ ጎጎግርታኑያ።<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />እባዶት ኮ ታኤራተሮ ዴለልትቲ ማራጌይ ጎአባኖን ጌስክሰ ጂናታ ጎሴተ፥ አታይን ጎዶታተ ታጌላተ ሀየለ፥ ጩቦ ላኮአቦ ሀአታተ። <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />አየሱን ጎአመን ህታ ሃጃይ ዎዳናቴሳ አዳቦይሳይረ ሀሻላጋሞን እስ አዎዳይረ ዴለልትቲ አታታኖኮ እስኦቴሳ ካሙርቴሳተራ እባዶት ታኢዳን ፈለራ። <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />ሃኑን ዴለልትቲ ካአታተራ ታኢዳን ፈለራ፥ ሀአታኖን ካግራና ታሮርተ ታኢዳን ፈለራ።<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />ሄለልትቲ ቶ ኤንተርክሰ ኔፎነ ግራን ኡሱነ ዎታ ታሻንተታ፥ ኤንተርክሰ ጎጎየ አደ ካጌላተ እባዶትን ኬሳሚን ባልቹማ አብታ፥ እባዶት ጎአመን ጎታይ ካአማኔሮ ላኖ ዶትሳራ። <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />ቆፋተይ ጎሌ አደ ሀኬሳሞን ሂካማሌ ግቴና ሮር ካገገላተ ልናተ፥ አንና አደ አያና ካዋ እን ጉት ካግሮ ኣን ላራ።<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s1">ቶልቻን ኦኤናኣመራን ሶኮክ ጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />ቶልቻን ኦኤናኣመራን ሶኮክ ጋራ አን ሃ አማራ፥ “ኖ ዱባና ማላባኖ” ማላባኖ ኮራሜሳ የላራ፥ ጌላንጀ አደ ቁሎይሳታ። <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />አን ካሶዋ ካአማራ እባዶ ማላቢን ካዶትሳሮ ግታክ ጋና ላኮማላበሮ። <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />ዋ ካጌላታራ እባዶ አደ ዋይ ዶሌ ካአዴሳመያ።<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />ጎርታኑን ቶልቻን ኦኤናኣመራን ሶ አማኖኮክ ጋራ አን ሃ አማራ፤ ሂካ አላም ቶልቻ ካማድኖን ላኖና ዋ ኮ ኳሬ ካካለ ሄዶ ግርዋት ካንሶዋ። <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />ማጎሬና ካሞጋን ሄዶል ሀሌኖን ግራን ዋልና ካሞጋን ጎታጆል ሀሌኖን ግራን፥ ጎታጆል አማሜን ኦኡማማራን ግራን፤ ዳሩርና ኡሊና ሀሱስ ኣንክክ ሄዶል ጎግረና፥ <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />ኖን አደ ካመን ዱባ ኡሱኮ ኦኮንሌራ፥ ኖና ኦቴሳ ኦሌነና ዋ ኦዶ ኮ አብና፤ አደና ካመን ዱባ ጋራኬሳነ ካኮሌራ፥ ኖና ጋራኬሳነ ኦሌነና ጎታ ኮ የሱሳ ክርስቶሳ አብና።<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />አየሱን ጎአመን ሂካ እባዶ ዱባ ላኮካሶ፤ እባዶ ኮኮ ህታር ጊን ቶልቻ ሄዶይሳታ ማንኮግሮ ማራን ሂካማሌኒዕ ሶ ጎአምራን ኦግራን ቶልቻን ኦኤናኣመራን ኣን ቆፓራን፥ ሳሙትሶና ላፋ ማንኮሌተቶ ማራን ባቶዋራን። <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />አየሱን ጎአመን ባቦ ዋ ቶስ ኖ ላኮጋባላሮ፥ ጎኣማናዋኔና ካሀንቃታራ አየስ ኮና ላግሮ፥ ጎአምነና ዎረኤ ካሄላታና አየስ ኮና ላግሮ።<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />አየሱን ጎአመን ባልቹማትስንኮ ካከይ እስን ካፈላታን አማኖ አታኖን ኦግራዉን ሀንዱዱፎ ጎጎሌኖንኮ እስኦትስን ኦራዬን። <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />አት ሂካ ኣንክክ ማላባኖ አባ ግራን፥ ላፋት ሳሙ ካአባተራ እባዶት ምን ካቶልቻይ አማ ግራን ኩ ጎዴ ቶልቻን ኦኤናኣመራን ሶ ጎጎአምሮ ሳሙቴሳ ኡሱ ላኮከኬሳቶያ? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />ሃኑን ክርስቶሳ ካኮንጎየራ ሂካ አማኖ ካላፈሮ ዋ ካአማኔሮ አቢካ ማላባኖካኮት ኣላንቲ ባየራ አማኖያ። <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />ሂካ ራድ አቢላልትስን ሚራኣና ላፋት ሳሙትሶ ሜጋይሳ ክርስቶሳ ጉት ጩቦ ፈላታን። <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />ሃኑን አን ኦኣማራ ሶ አቢኬ ኦሀንዱዱፍሳራን ጎሌን አቢኬ ሀንዱዱፍሳናኮ አመረ ዱዶ ሶ ላኮአምናሮ።<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s1">ኦፋራሜራንኮት ፈኢና ፈልን ካዶትሳሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />አን ባልቻክ እባዶት ላኮዮያ? አደ ካፋራመሮ ላኮዮያ? ጎታካን የሱሳ አን ላኮዴሮያ? እስን አዴን ጎታይ ፈሎኦተኮኒዕ ኢል ላኮታንያ? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />ካካለቱን ካፋራመሮ ጎላናዋየና ዱዶ እስኑን አደ ኦግራን ካፋራመሮያ፥ ኣላንቲና ጎታኮ ፋራማኖኬዉን ማታማ እስንታን።<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />አት ካፋራንተቶ ላኮቶ አመን እን ኦቆቆራራዉን አን ካስሳራ አባብ ሂካያ፤ <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />ኖ አማኖኮትና ጣማኖኮት ፈኢ ላኮአብኖያ? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />ኦካለ ኦፋራመራን ኣን፥ ታጎታ አቢላል ኣንና፥ ከፋ ኣን፥ ዱባ ታአማናቶ ኦር አባይ ሰሴይን ፈኢ ላኮአብኖያ? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />ሙ ዳፉር ፎጎሎይ ፈላይ ግርን ኦኮንዶትሳራ አንና ባርናባስ ኦላልና? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />ጎሌና ማራጋደ ካከሳይዋ ዎታዳራ ሌ ካሃንዳራ አዮያ? ካዎይኒ ጋ አባራተጉረ ታዱባንተቶ ኢል ካአሞን አዮያ? ግድኬሳ ፎፋታ ግራን ግድኮ ኤኖ ካጣሞን አዮያ?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />ሂካ አን ካኮንአዬሰራ ቆፋ ታእባዶ ማሌያ? ሴራ ካሙሴ ሂካ ላ አማ ግሮላ? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />ሴራ ካሙሴይ፥ “እራ ካኦታሮ ኣር ፉና አሮሺቴን” አማመ ጻፋመራ። ሀያ ዋ ታአዬስሰታ ታአራሬ ሃጃታ?<note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">አዳ. 25፡4</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5፡18</ref>።</char></note> <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />ዋ ሂካ ካኮንአዬሰራ ኦግራን ጋራ ካካን ላኮዮያ? ካኮንጻፋመራና ኦግራን ኖ ማራንያ። እራ ኦታተ ካባራረና ካኦታራ አርና ካኦታተሮ ዉጣኮ ሄዴዶ ካአቦ ላኖ አብድ የላታራ። <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />ኖ እስን ኦሮ ካአያና ዉጣ ካዉጣኖን ጎሌ፥ ሶዉን ካሌሮ ኮኮ ጎአታነ ካአቲ አዬስያ?<note caller="-" style="x"><char style="xo" closed="false">9፡11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">ሮመ 15፡27</ref>።</char></note> <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />ኦካለ ህታ ፈኢ እስንኮ ሄላታኖ ጎዳንዴን፥ ኖ ሮርሳይ ሄላይን ላኮዳንዳኖያ? ኖ ጎአመን ህታ ፈኢ ላኦ ላኮሀይሳነኖ። ሀሱኮና ካክርስቶሳ ዎንጋላን ሀንዱዱፎ ጎጎሌኖንኮ ካመን ዱባና ኦብሳና። <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />ቁሉክ ምን ካዋይ ኦሀንዳራን ባቦክሶ ቁሉክ ምን ካዋኮ ኦሄላታራን፥ ባንኤ ታፋላ ጉት ኦሀንዳራን ጃርሶኮ ሄዴዳመን ካአማራን ላኮካሳንያ?<note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="DEU 18:1">አዳ. 18፡1</ref>።</char></note> <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />ሂካማሌና ዎንጋላ ኦላላባራን ግርክሶዉን ካዶትሳሮ ዎንጋላኮ ጎጎአታናዉን ጎታ አጃጄራ።<note caller="-" style="x"><char style="xo" closed="false">9፡14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">ማቶ. 10፡10</ref>፤ <ref loc="LUK 10:7">ሉቃ. 10፡7</ref>።</char></note><verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />አን ጎአመን ህታ ፈኢኮ ቶይና ሱረ ላኦ ላኮአታየሮ፤ ግዳና ሂካ ካኮንጻፈራ ሂካ ኣንክክ አየስ ፈልታንዋ ታአምሮ አብዲ ላኮዮ፥ ማዮና ዳታኖክኬ ላኦ ካላይክ ካየላሮኮ ኢን ጎይ ሆረክ። <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />ዎንጋላ ላላባኖክ ላኮጣድሳሮ፥ ካኮንላላባራ ካሄሶን ማንኮሌዉንያ። ዎንጋላ ጎላላባናዋየ ኣኔ ኢን! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />ፈኢቴኮ ኪጉረ ዎንጋላ ጎላላበ ዳሞዛ አባ፥ ፈኢቴኮ ጎሌኖን አደ ኦፈላራ ፈሎ ታስሳንተቶ ሀዳራ ጉድሳኖ ካላል ላራ። <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />ሀያ ዳሞዛክ መያ? ዳሞዛ አደ ዎንጋላ ጎላላብሮ ፈኢቴኮት ላኦ ሀአታኖን ዎንጋላ ዳሞዛ ካላይ ላላባኖያ።<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />አን ባልቻክ እባዶትያ፥ ማዮና ድይ ላኮዮ፥ አየሱን ጎአመን ካሞጋን ዋ ቶስ አባብን እስኦተ እባዶ ዱባን ድይ ሌራ። <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />አይሁድ አባብን አመረ አይሁድነ ዎታ ካአይሁድ እባዶ ኣን ሌ። አን መተኬዉን ሴራኮ ሄገሌ ሀሌኖን ሴራኮ ሄገሌ ኦግራን አባብን አመረ ሴራኮ ሄገሌ ካግሮ ኣን ሌ። <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />አን መተኬዉን ሴራ ካዋኮ ባልቹማ ካሌኖና ሴራ ካክርስቶሳይ ካኢምናማሮ ጎሌና ሴራ ካላይክ እባዶ አባብን ሴራ ካላይክ እባዶት ኣን ሌ። <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />ላፋኒዕ ፋይስን አመረ ላፋኒዕነ ዎታ ላፋክ አን ሌ፤ ኢን ካዳንዳመ ግታክ ጅልባ ኮኮ ፋይስን አመረ ዱባነ ዎታ አየስ ዱባ ፈለራ።<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />ሂካ ዱባ ካኮንፈላራ ዎንጋላኮ ሶማ አታይን አመረ ዎንጋላ ማራንያ። <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />ትያኖኮክ ለላማኖይ ካትያራ ካሞጋን ጎሌሮ እላቦ ካአታታራ አደ ኮ ካላል ላኖ ላኮካሳንያ? ሃኑን እላቦ ካአታይናሮ እባዶት ኣን ትያ። <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />ለላሚን እስ ካኤካሳታራ እባዶት አየስ ዱባ እስኦቴሳ ኤካሳታራ፥ እሶ ሂካማሌ ካኮሀራናን ካሮራሮንና ካባሮ ካላቻ ሄላይን ሀራራን፥ ኖ ጎአመን ጅሩ ጅሮማክ ካባኖን ካላቻ ሄላይን ሀራና። <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />ሃኑን አን ላኦ ካላይክ እባዶት ኣን አዳ. ላኮቲናሮ፥ አደና አምባል ቶንቶሞ ካባሳሮ እባዶ ኣን አዳ. ላኮሞአባይናሮ። <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />አየሱን ጎአመን ካካለዉን ላላብ አባባይረ አን መተከዉን ካኢየ ሊ ጎጎሄሶንኮ እስኦቴ ሀድሳታራ።<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s1">እስራኤል ታጌተታ ራኮ ኖ ጎጎጌኖንኮ እስኦራና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />አቢላልቴ! ኦዶላልታን ዱባ ዱማንቻኮ ሄገሌ ግራኖና በከ ኦሮማሬን ካናቀራን ጎጎአዴሳኑን ዶታራ።<note caller="-" style="x"><char style="xo" closed="false">10፡1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ብያ. 13፡21-22</ref>፤ <ref loc="EXO 14:22-29">14፡22-29</ref>።</char></note> <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />እሶ ዱባ ሙሴነ ዎታ ሌንጉረን ዱማንቻይና በከይ ጣማቃመን። <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />ዱባና ካአያና ባቦ ኮ አመን፥<note caller="-" style="x"><char style="xo" closed="false">10፡3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">ብያ. 16፡35</ref>።</char></note> <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />ዱባና ካአያና ጣሞ ኮ ጣሜን። እሶ ዴበ ሰሴታ ካኮግረ ካአያና ኤኤሞኮ ጣሜራን፥ ሀሱ ኤኤሞና ክርስቶሳየ።<note caller="-" style="x"><char style="xo" closed="false">10፡4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">ብያ. 17፡6</ref>፤ <ref loc="NUM 25:1-18">ቶቶ 25፡1-18</ref>።</char></note> <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />ሀሌዎ ኳሬ ዋ ካሞጋኒ ማንኮገጌላታናዋተ ማራን ቃሉላቶክ ኡሊ እዬን ሄሴን።<note caller="-" style="x"><char style="xo" closed="false">10፡5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">ቶቶ 14፡29-30</ref>።</char></note><verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />እሶ ካሜላን ጎጎሀልቼረን ኖና አድ ጎጎሀልችኖንኮ ሂክ አየስ ኖን ማሱሳ ሌራ።<note caller="-" style="x"><char style="xo" closed="false">10፡6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">ቶቶ 11፡4</ref>።</char></note> <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />“ጎሳና አምና ጣምን ሀማጼ፤ ዱዱሪና ኬ” አማመ ጎጎጻፋመሮይ፥ እሶኮ ኮኮ ጎጎየለራን ቶልቻ ጎጎሄዶይሳታራን እስና አሮሄዶይሳቴን።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">ብያ. 32፡6</ref>።</char></note> <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />እሶኮ ኮኮ ሻርሙጠንጉረን አሪ ቶይ ኩማ ላማታንኮ ሴዶ እባዶ ጎጎ ጎየሮይ ኖና ላኮሻርሙጢኖ።<note caller="-" style="x"><char style="xo" closed="false">10፡8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">ቶቶ 25፡1-18</ref>።</char></note> <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />እሶኮ ኮኮ ጎታ ጎጎጫፈራንና ሀበሳይ ኢዳሜን ጎጎባየራንክ ማለ ኖና ጎታ ላኮጫፍኖ።<note caller="+" style="f"><char style="fr" closed="false">10፡9 </char><char style="fqa" closed="false">ጎታ፦ </char><char style="ft" closed="false">ኮኮ ካሆርኮ ማጻፋጆል “ክርስቶሳ” አማራ። </char></note><note caller="-" style="x"><char style="xo" closed="false">10፡9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">ቶቶ 21፡5-6</ref>።</char></note> <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />እሶኮ ኮኮ ጉምጉመጉረ ካባሳሮ ኤርግቻይ ጎጎባየራን አን እስና አሮጉንጉምተን።<note caller="-" style="x"><char style="xo" closed="false">10፡10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">ቶቶ 16፡41-49</ref>።</char></note><verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />ሂክ ዱባ ማሱሳ ጎጎሌሮ እሶ ጉት ጌ፥ ጌስጆልኮክ ጉዳታኖይ ካጌሮ ኖ ሀድስን ጻፋመ።<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />ሃኑን አታየ አሌራ ካአማራ ጎግረ ጎጎኢኖንኮ እስኦቴሳ ሀኦራተ። <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />እባዶ ዱባ ጉት ታገያቶኮ ታካለ ጫፍት እስን ላኮጌተቶ፥ ዋ ካአብዳመያ፥ ሃኑን እስን ካዳንዳታንኮ ካሮረ ጎጎጫፋንታኑን ኡሱ እስን ላኮእስሮ፥ አየሱን ጎአመን ካኮጫፋማታን ጎራታ ካኮኦብስታን ሁና ስስረ ጫፍትኮ ካኮቤታን ራ ኡሱ እስኑን ኤካስሮዋ።<verse eid="1CO 10:13" /></para>
  <para style="s1">ቶልቻነ ዎታ አሮሌተን</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />ሃኑን አን ኦጌላታሮኦቴ! ቶልቻ ሄዶይሳታናኮ ባቃዬን። <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />አን ሂካ ካኮንአዬሰራ ካሻዳሮ እባዶንያ። ሂካ አን ካአዬሰሮ አዬስኮክ ጋራ እስንዋ እሲ ፍርዳ። <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />ኖ ካኮሶማሳምናና ታሶማ ጡጋ ካክርስቶሳ ኢግኔ ዎታ ራቶናት ካአቦ ላኮዮያ? ኖ ካአማና ባቦ ካዋ ሶ ኦክርስቶሳነ ዎታ ኤሴላ ካአቦ ላኮዮያ?<note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቶ. 26፡26-28</ref>፤ <ref loc="MRK 14:22-24">ማር. 14፡22-24</ref>፤ <ref loc="LUK 22:19-20">ሉቃ. 22፡19-20</ref>።</char></note> <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />ባቦ ካዋ ኮ ጎጎሌሮክ ማለ ኖና ኦሞጋን ሌነ ግራን ማር ኮና፥ ኖ ዱባ ባቦ ኮ ሄዴዳምናና።<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />አላ ካእስራኤል ጎሳ ቆፓ፥ ካስሳማሮ ጃርሶ ኦአማራን ባንኤ ታፋላነ ዎታ ራቶ ኮ ላኮያንያ?<note caller="-" style="x"><char style="xo" closed="false">10፡18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">ዎዩ. 7፡6</ref>።</char></note> <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />ሀያ ቶልቻን ካኤናኣመሮ ኮኮና ሌረ ቶልቻ መተኬሳዉን ላኦ ካአቦያ አማኖያ? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />ላኮዮ! አይዛብ ካኮፋላታራ ዋዉን ሀሌኖን ዱርሳዉንያ፥ ዱርሳነ ዎታ ኮ ጎጎሌታዉን አን ላኮዶታሮ።<note caller="-" style="x"><char style="xo" closed="false">10፡20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">አዳ. 32፡17</ref>።</char></note> <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />ታጎታ ጡጋና ታዱርሳል ጡጋና ራቶ ጣምን ላኮዳንዳታን፤ ታጎታ ዱጉድኮ ባቦ አምጉደን ታዱርሳ ዱጉድኮ ኣምን ላኮዳንዳታን። <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />ኖ ሂካ ፈላኖይ ጎታ ሀልችንሶ? አታንካን ጎታኮ ሮራና?<note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">አዳ. 32፡21</ref>።</char></note><verse eid="1CO 10:22" /></para>
  <para style="s1">ዋ ኦአማናራንኮት ባልቹማ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />“ካመን ዱባን ፈኢ ስሳንተታ” አየሱን ጎአመን ካመን ዱባ ላኦ ላኮአቦ፥ “ካመን ዱባን ፈኢ ስሳንተታ” አየሱን ጎአመን ካመን ዱባ ላኮቢሳሮ።<note caller="-" style="x"><char style="xo" closed="false">10፡23 </char><char style="xt" closed="false"><ref loc="1CO 6:12">1 ቆሮ. 6፡12</ref>።</char></note> <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />እባዶ መተመተይ ኦላቴሳት ላኦ ኳሬ ላኦቴሳ ታላል አሮዶታኖ።<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />ሳሙትስን አሄዳኖኒ ግያይ ኦዳዳላማራን ሶ ዱባ አማ፤ <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />“ኡልና ኡሊ ጉት ካአማጋመራ ዱባ ካጎታያ።”<note caller="-" style="x"><char style="xo" closed="false">10፡26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">ማዛ. 24፡1</ref>።</char></note><verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />ዋ ካአማኖን እባዶት ኮ ኩ ማርትና አምስን ጎኡማተ አሞን ሆረ ካሮረሮ ባቦ ዱባ ሳሙትስኒ አሄዳኖን አማ። <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />አየሱን ጎአመን እባዶት ኮ “ሂኒዕ ሶ ቶልቻን ኦኤናኣመራንያን” አም ጎሰጌ፥ ሂካ ካሰገሮ እባዶት ማራና ሳሙትስኑን አምጉዴን አሮኣንቴን። <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />ሂካ ካኮንአማራ ሂካ እባዶትኮት ሳሙ ማራን ኳሬ ሳሙታ ማራን ላኮዮ፥ ባልቹማት ካካለኮት ሳሙይ ሙን ሄሬጋማታ? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />አን ዋ ጋላቴረ ባቦ ካአማሮ ጎሌ፥ ዋ ካኮሶማሳየሮ አየሱን ሙን ሀባራማራ?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />ጎርታኑ አማና ሌረ ጣማ ጎርቱን ማምስክ አየስ ፈላ ግራን ካመን ዱባ ካባጃ ታዋዉን ፈላ። <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />አይሁድና ሌረ አይዛብን ጎርቱን ምን ካዋዉን ሀንዱዱፎ አሮሌተን። <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />አን እባዶ ዱባ ማምስክ አየስ ገገላይስና ጎጎእጻማሮይ እስና ሂካማሌ የላ፥ ካሞጋና ጎጎፋይሮ ኳሬ ኢን ላኦ ካስስሮ አሌኖን ግራን እሶን ላኦ ካስስሮ ዶታራ።<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />አን ክርስቶሳ ኣን ጎጎላሮ እስና እን ኣን ላ።<note caller="-" style="x"><char style="xo" closed="false">11፡1 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1 ቆሮ. 4፡16</ref>፤ <ref loc="PHP 3:17">ፍል. 3፡17</ref>።</char></note><verse eid="1CO 11:1" /></para>
  <para style="s1">ዋ ሄዶይሳታኖኮክ ዎጋ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />አርጌቶ እን ማንኮሻዳታን ማራና እንኮ ካአታቴታን ዎጋ አታይሳቴን ማንኮአባቴታን ማራን አን እስን ጋላታራ። <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />አየሱን ጎአመን ሂካ ጎጎአዴሳኑን ዶታራ፥ ባባር ዱባዉን መተ ክርስቶሳያ፥ ሄሌሉና መተ ባባርያ፥ ክርስቶሳዉና መተ ዋያ። <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />እስኦቴሳ ሆጎጋተረ ካኤባታራ ጎርቱን ሄገሮ ካአዬሳራ ማምስክ ባባርትት እስኦቴሳ የራሳታራ። <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />እስኦትሴ ሀሆጎጋኖን ታኤባታ ጎርቱን ሄገሮ ታአዬሳታ ማምስት ሄለልትቲና መተክሴ የራሳታ፤ መተክሴ ካሆላተቶ ኣን ቶታማታ። <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />ሄለልትቲ መተክሴ ታጎልሳኖን ጎሌተ፥ መተክሴ ሀጎሳተ፥ መተክሴ ጎሳታኖ ጎርቱን ሆላታኖ ካሙልሳሮ ኣን ሊ ኤሰን ጎሙተ አድ እስኦትሴ ሀጎልሳተ። <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />ባባርትት ምዲ ታዋና ካባጃ ታዋ ካኮንሙታቶ ማንኮሌተ ማራን እስኦቴሳ ሆጎግሳዪን ላኮዶትሳሮ፥ ሄለልትቲ ጎአመን ታባባርትቲ ካባጃታ። <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />ኣላንቲና ሄለልትቲ ባባርትትኮ ሄላንተታ ኳሬ ባባርትት ሄለልትቲኮ ላኮሄላመሮ። <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />አደና ሄለልትቲ ባባርትትዉን መጣንተታ ኳሬ ባባርትት ሄሌልትቲን ላኮመጣመሮ። <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />ህታ ኣላንቲና ኤርግቻኮት ኣላንቲ፥ ሄለልትቲ ኦዶናትኮ ሄገሌ ግራኖ ካቱስሮ ማላታ ካሌሮ ሆጎግ መተክሴ ጉት ሀካተ። <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />ጎታ ዶሌ ካአብኖ ግርዉን ሄለልትቲ ባባርትት ካሊ ላኮግራቶ፤ ባባርትትና ሄለልትቲ ካሊ ላኮግራሮ። <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />ሄለልትቲ ባባርትትኮ ጎጎሄላንተቶ፥ ባባርትትና ሄለልትቲኮ ኡሙላማራ፤ አየሱን ጎአመን ዱባዉን ሄላማኖ ዋያ።<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />አላ እስንዋ ፍርዳ፥ ሄለልትቲ እስኦትሴ ሀጎልሳኖን ዋ ቶስ ኤባታኖ ዶትሳራ? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />ባባርትት መተኬሳ ጎኤራሳተ ህሎ ካላሮ መጣ ጡማ ላኮአጋልስሳቶያ? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />ሄለልትቲ መተክሴ ጎኤራሳተ ላ ካባጃትሴቶላ? መተ ካኤር ካኮንስሳመራ ካባጃትሴዉን ሆጎግ ጎጎሌሮንያ። <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />ጎርታ ማዮና ህታ ሃጃ ጉት ዶጋምን ጎዶታተ፥ ኖና ሌነኔ ካሞጋን ምን ካዋ ሂካኮ ካለክ ዎጋ ላኮአብኖ።<verse eid="1CO 11:16" /></para>
  <para style="s1">ባቦ ካዋኮክ ጋራ</para>
  <para style="r">(<ref loc="MAT 26:26-29">ማቶ. 26፡26-29</ref>፤ <ref loc="MRK 14:22-25">ማር. 14፡22-25</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22፡14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />አየሱን ጎአመን ካኮኩኩንታን ጎራታ ካፈላታን ሜላነ ኳሬ ካእዳንክ አየስ ማንኮላናዋተ ማራን ሂካ ግዳ አን እስኑን ካስስናሮ አጃጃዉን አን እስን ላኮሶማሳይናሮ። <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />ዱባንኮ ጣየ ምን ካዋይ ካኮኩኩንታን ጎራታ እስን ኦሮ ካለካለ ብያኖ ካግሮ ማለራ፤ ሂክ አን ካማለሮኮ ጋምሳ ሩም ላኖ አማናራ። [<verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />እስን ኦሮኮ ካሩም ካለ ብረ ጎጎአዴሳምሮ፥ ሂክ ካለካለ ብ ግራኖ እስን ኦሮ ካሄሶንያ።] <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />ራቶ ካኮኩኩንታን ጎራታ እስን ካአማታን ባቦ ካዋ ላኮዮ። <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />አማ ግራን ኮ ካካለ ሀኦሮን ካከሳካኬሳ አማራ፤ ሂካኮክ ጋራይ ኮ ጎኡኢሮ ካካለ አደ ባራሪ ሰታራ። <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />አፎ ካኮአንታና ካኮጣንታን ምን ላኮአብታን? ሙ ምን ካዋ ቱፋታን? ሙ ኮና ካልክ ራካታ ሙልሳታን? ጎርታ አን እስኔ መ አምራ? ሂካ አየሱን እስን ሶማሳዉ? ዱዶ ላኮሶማሳይናሮ!<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />አን ጎታኮ ካአታዬራ እስኑን ሮርሰ ካስሰራ ዎጋ ሂካያ፥ ጎታ የሱሳ ሮር ታኮስሳምናሮ ሄመኒ፥ ባቦ ኬሰጉረ፥ <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />ሶማሳተረ ኤካኤብሰረ፥ “ሂኒዕ እስን ማራን ኦልናራን ሶኦቴያን፤ እን ካኮሻዳን የላየነ” አመ። <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />ኡሱማለና ክታኮ አባባተረ ጡጋ ኬሰጉረ፥ “ህት ጡጋ ኢግኬይ ኦሌራን አማቶ ኦኡሱብያን፤ ሃንሱን ጡጋኮ ካኮጣንቴን ጎራታ ሂካ እን ካኮሻዳን የላዬነ” አመ።<verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />ሂካ ባቦ ካዋ ካኮአንቴን ጎራታና፥ ህታ ጡጋኮ ካኮጣንቴን ጎራታ ጎታ ታ ኤሜሮ ጊን ጎይኬሳ አዬስናታን። <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />ጎርታ ማዮና ካዶትሶን ራድ፥ ሂካ ካጎታ ባቦ ጎኣመ ጎርቱን ጡጋኮ ጎጣመ፥ ሶ ኦጎታዉና ኢግ ካጎታዉን አንዛ አባ። <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />እባዶ ማዮና ሂካ ባቦ አማናኮና ህታ ጡጋ ጣማናኮ ሆረነ፥ እስኦቴሳ ሀቆቆራተ። <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />ኣላንቲና ማዮና ኦጎታ ሶ መያን አአዴሶኒ ጎኣመና ጡጋኮ ጎጣመ ፍድ መተኬሳዉን ካኬንስሳሮ አማራ፤ ጣማራ። <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />እስን ኦሮኮ ኦሞጋን ካኮንሀረናን፥ ካኮንሀዉአመራና ካኮንጎየራን ህታ ኣላንቲያ። <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />እስኦታን ደያነዋ አድ ላኮፍርዳማነ። <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />አየሱን ጎአመን ጎታ ኖ ጉት ካኮፍርድሮ ጎራታ ሙርሳምናና፤ ህክና አላም ዎታ ራቶ ጎጎባኖንኮያ።<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />ሃንሱን አቢላልቴ፥ ካጎታ ባቦ ኣምን ካኮኩኩንታን ጎራታ ዱባ ታኤሜሮ ኦራዬን። <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />ካኮኩኩንታን ጎራታ ፍርዳ እስኑን ጎጎሌኖንኮ ማዮና ካኡኤራ ጎግረ ምንኬሳይ ሀኣሞ። ካሄሰሮ አየስ አድ አን ካኮኤሜየ ጎራታ አዴስስናራ።<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s1">ካአያና እላቦል</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />አቢላልቴ፥ ግዳ አዴነ ጋራ ካአያናኮክ እላቦል ጎጎአዴሳኑን ዶታራ። <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />አማኖ ካልኒዕ ሌተን ታኮግቴን ሀሴራና ህታራና ዎዳማ ህኢ ካዱደ ካአዬሶን ቶልቻል አን ጎጎአታንቴታን ካሶዋ። <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />ሃንሱን ማዮና አያና ካዋይ ካአዬሳራ፥ “የሱሳ ካቃንጋመያ” ካአማራ ላኮግሮ፤ ኡሱማለና አያና ቁሉክ ጎሌኖን ማዮና “የሱሳ ጎታያ” ካአማራ ግራናዋት አን ሰጋራ።<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />እላቦል ካለካለክ ጎሌሮ፥ አያና ጎአመን ኮያ፥ <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />ሀንዳኖና ካለካለክ ካሌሮ ጎታ ጎአመን ኮያ፤ <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />ፈሎና ካለካለኒዕ ጎሌን፥ ዱባና ዱባይ ካፈላራ አደ ኡሱ ኮ ዋያ። <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />አየሱን ጎአመን አያና ቁሉክኮት ሙተን መተመቴ ካኮንስሳማራ ራቶት ላኦንያ። <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />አያና ቁሉክ ኮዉን ቃሩማ አዬሳኖ ስሳራ፤ ካካለቱን ሀሱ አያና ማላብ አዬሳኖ ስሳራ። <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />ኮዉን ሀሱ አያናዋ አማኖ ስስናራ፥ ካካለዉን አደ ኤሰነዋ ካፋይሳሮ አያናኮክ እላቦጆል ስስናራ። <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />ኮዉን ባሳ ፈላኖ፥ ካካለቱን ሄገሮ አዬሳኖ፥ ካካለቱን አደ አያናጆል አሳባኖ፥ ኮዉን ካለካለት ታኡሱብት ሄኢ አዬሳኖ፥ ካካለቱን አደ ካለካለት ታኡሱብት ሄኢ ካአዬሳመሮ ፉራኖኮክ እላቦ ስሳራ። <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />ሂኒዕ ዱባ ሀሱ አያና ኮ ኮኒዕ እላቦጆል ጎሌራን፥ መተመቴ እባዶን ኡሱ እሲ ጎጎፈኤ ስሳራ።<verse eid="1CO 12:11" /></para>
  <para style="s1">ማር ኮይ ምክታ ካሞጋን</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />ማሪ ምክታ ካሞጋን ጎግረና ማር ኮያ፤ አየሱን ጎአመን ምክታጆል ካሞጋን ጎሌና ማር ኮያ። ክርስቶሳና ኡሱማሌዋያ። <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />አይሁድ ጎርቱን ካግርክ እባዶ ጎሌነ፥ ድይ ጎርቱን ባልቻክ እባዶ ጎሌነ፥ ኖ ዱባ ማር ኮ ጎጎሌኖ አያና ኮይ ጣማቃምነና፥ ኖ ዱባና አያና ኮኮ ጎጎጣምኖ ስሳመራ።<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />ማር ኮ ካኮመጣመራ ምክታ ካሞጋንኮ ኳሬ ምክታ ኮኮ ላኮዮ። <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />ሉክ “አን ገነ ማንኮሌኖን ማራን ካማሬ ምክታ ላኮዮ” አየሱን ጎአመን ሂካ አማኖይ ካማሬ ምክታ ላኖ ሄሳራ? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />ነበና፥ “አን ኢል ማንኮሌኖ ማራን ካማሬ ምክታ ላኮዮ” ጎአንተ ሃ አማኖይ ካማሬ ምክታ ላኖ ሄሳራ? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />ማር ዱባ ኢል ሊ ግረዋ፥ ማላኖ ሀየኮ ሄላምናረ? ማር ዱባ ነበ ሊ ግረዋ፥ ኡርሳታኖ ሀየኮ ሄላምናረ? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />አየሱን ጎአመን ዋ ጎጎጌላታሮ መተመተይ ባንኤ ዱባ ካየራ። <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />ምክታ ዱባና ኮ ሊ ግረዋ ማር ሀየኮ ሄላምናረ? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />ጎርታ ምክታል ካሞጋንያ፥ ማር ጎአመን ኮያ።<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />እል ገነኔ፥ “አት እን ላኮዶትሳቶ” አሚና ላኮዳንዳቶ፥ መተና ሉክነ፥ “አት ኢን ላኮዶትሳቶ” አምን ላኮዳንዳሮ። <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />ዱዶዋ ላፋክ ኣን ካላራ ካሞጋን ካማሬ ምክታጆል ኣሎ ኦዶትሳራንያን። <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />ካቱፋመ ኣን ካላሮ ምክታሉን ኣሎ ካባጃ ስሳና፥ አንደና ኦኮንሙላኖ ምክታል ኣሎ ኮኮባታና፤ <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />ካኮንሙሊኖን ምክታልካን አደ ሂክ ላኮዶትሳሮ። ዋ ጎአመን ካማሬ ምክታል ራቶ ኢንሰ ኤሰልሰ ካባጃ ኦኮንሀንቃተቶ ታሮርተ ካባጃ ስሰራ። <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />ሂካና ካኮንየለራ ካማሬ ምክታል ኦሮኮ ካለካለ ላኖ አግኖን፥ እስእስ ኦሮ ኮኮዉን ጎጎሻድናዉንያ። <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />ምክታ ኮ ጎአቦሳምሮ ምክታጆል ዱባ ራቶ አቦሳማራ፥ ምክታ ኮ ጎካባጃምሮ ካካለ ምክታልና ራቶ ገጌላታራ።<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />ጎርታ እስና ካክርስቶሳ ማርታን፥ መተመተክስኒ ማርኬሳክ ምክታልታን። <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />ሃንሱን ዋ መተመቴ እባዶን ምን ካኤብ ኦሮ ካለካለክ ሀንዳ ጎጎግሮ የለራ፥ ሂካ ጋራይ ሆራርጀ ኦፋራመራን፥ ካላም ኦሄገሮል፥ ካሴድ ኦአጋልስሳራን ሹመራ። ደቤና ባሳ ኦፈላራን፥ ደቤና አዳ. አዳክ ፋይሳኖኮክ እላቦ ኦአባን፥ እባዶ ጋርጋራኖኮክ እላቦ ኦአባን፥ ኦዶናቲ ካባሪሳሮና ካለካለት ሄኢ ካአዬሳሮ እባዶ ካየራ። <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />ዱባና ኦፋራሜራንያን? ዱባና አደን ኦሄገሮያን? ዱባና አደን ኦአጋልስሳራንያን? ዱባና አደን ባሳ ፈላራን? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />ዱባና አደን ካኮፋይሳራን እላቦል አባኔ? ዱባና አደን ካለካለት ሄኢ አዬሳራን? ዱባና አደን ፉራናን? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />አየሱን ጎአመን ዱባኮ ካሮራሮ እላቦ አታኒ ዶታዬን።</para>
  <para style="p" vid="1CO 12:31">ግዳ አድ ዱባኮ ካሮራሮ ራ አን እስኑን ቱስናራ።<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s1">ጌላንጀ ታሩም</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />እባዶይና ታኤርግቻ ሄኢ ጎአዬሰ፥ ጌላንጀ አድ ጎዋታንቴ ታኢያቶ ማርጮ ኣን ጎርቱን ቅልጩቅልጩ ካአማሮ ብልቢላያ። <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />ሄገሮኮክ እላቦ ግረዋ፥ ሆል ማላባኖ ዱባና አን አዴሰዋ፥ ዎዳም ባንኤኮ ካታክራ አማኖ ኢን ጎግረ፥ ጌላንጀ አድ ጎዋታንተ ላኦ ካሊክያ። <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />አን ካአቦ ዱባ ህየሳን ጎስሰ፥ ማርኬ ኤለኒ ጎጉባየና<note caller="+" style="f"><char style="fr" closed="false">13፡3 </char><char style="ft" closed="false">ካሆርኮ ማጻፋይ ዳይን ማርኬ ሮርሳይ ጎስሳየ አማራ። </char></note>፥ ጌላንጀ አድ ጎዋታንተ ኮና ላኦ ላኮአቦ።<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />ጌላንጀ ታኦብሳቶታ፥ አደና ፋያንካትታ፥ ጌላንጀ ላኮጋባቶ፥ እስኦትሴይ ላኮዳቶ፥ ላኮኮራቶ። <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />ካዶትሶን አየስ ላኮፈላቶ፥ እስ ታጌላታቶ ላኮቶ፥ ላኮህፋቶ፥ ባስ ላኮቶታቶ። <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />ጌላንጀ ሩምነ ዎታ ኳሬ ሜላነነ ዎታ ላኮገጌላቶ። <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />ጌላንጀ ካአመን ዱባ ኦብሳታ፥ ካአመን ዱባ አብዳታ፥ ካአመን ዱባ አብድ የላታ፥ ካመን ዱባ አታቴ አላታ።<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />ጌላንጀ ዱዶ ላኮኢያቶ፥ አየሱን ጎአመን ሄገሮ ጎሌና ኢግልሳማናን፥ ሄኢ ታኡሱብ ጎሌተና ሄስናታ፥ ማላባኖ ጎሌና ኢግልሳምናራ። <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />ኣላንቲና ካማላባናና ጋምሳያ፤ ሄገሮ ካአዬሳናና ጋምሳያ። <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />አየሱን ጎአመን ልክ ካሌራ ጎኤመተ ልክ አሌኖን ካግረ ሄሰራ።<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />ይሱማ ግራን ይስ ኣን አዬሳረ፤ ይስ ኣን ሻዳረ፤ ይስ ኣንና ሄሬጋረ። ዎዳላ ካኮላረ ጎራታ ካይሱማ አየስ ሉጉደ ኢሰራ። <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />ግዳ ካደያና ዳዉኢቲ ኦሮ ካሙታሮ ኣን ድም ካአመያ፤ ሀሱ ጎራታ አደ ኢልታን ዲዳ ቤስ ድናና። ግዳ አን ካካሳ ጋምሳያ፤ ሀሱ ጎራታ አደ ዋ እን ካካሶ ግታክ ማላባኖ ዱባ ኢን ግርናራ።<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />ጎርታ አማኖነ፥ አብድነ፥ ጌላንጀነ፥ ሂኒዕ ሴዶ አታቴን ግራናን፤ ህናኣኮና ታሮራታ ጌላንጀታ።<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s1">ካለካለት ሄኢ አዬሳኖና ሄገሮ አዬሳኖኮክ እላቦል</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />ጌላንጀ ዴበ ሰሴዬነ፤ አያናኮክ እላቦል፥ ካካለኮና ሄገሮ አዬሳኖኮክ እላቦ አታኒ ዶታዬን። <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />ካለካለት ሄኢ ካአዬሳራና ዋዉን ኳሬ እባዶን ላኮአዬሳሮ፤ ሆል ካሌሮ አየስ አያናይ ማንኮአዬሳሮ ማራን ካአዴሳራ ላግሮ። <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />ሄገሮ ካአዬሳራ አደ ቢስን፥ አታይሲና ጎጎእስን እባዶን አዬሳራ። <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />ሄኢ ካለካለት ካአዬሳራ እስኦቴሳ ኦላል ቢሳራ፥ ሄገሮ ካአዬሳራ አደ ምን ካዋ ቢሳራ።<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />እስን ዱባና ካለካለት ሄኢ አየሴንዋ ጌላታረንዋ፥ ሂካኮ አድ ሮር ሄገሮ አየሴንዋ ጌላታረንዋ፥ ምን ካዋ ጎጎቢስሮ ካለካለት ሄኢ ካአዬሰሮ እባዶ ጎፉሮን፥ ካለካለት ሄኢ ካአዬሳሮኮ ሄገር ካአዬሳራ ሮራራ። <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />ጎርታ አቢላልቴ! እስን ቶስ ካኮኤሜየ ጎራታ፥ ሆል ታዋ ቱሳኖይ ማላባኖ ጎርቱን ሄገር አዬሳኖይ ጎርቱን አጋልስሲ እስኑን ጎሰግኖን ካለካለት ሄኢ ጎአዬሰ መ እስኑን ላኦ አባ?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />ሱሱሌ ኣንና ክራን ኣን ኦግራን ኔፎ ካላይኒዕና አደን ያየትሶ አዴሳማና ጎዋተ ማዳርክሶ ምሲ አዴስን ዳንዳራን? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />አደ ማላካታ ልክ ታሌኖን ታኡምት ያየ ጎማልስሰ፥ ጀሬኑን አዮያ ካኤካሳታራ? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />እስና ኡሱማሌዋታን፥ ህኢትስንኮ ፉሬን ካአባ ሃፉራ ጎቤኖን፥ ካአዬሰታና አዮያ ሻዲን ካዳንዳራ? አምባሉን ካአዬሳታን ኣን ሌታን። <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />አላም ጉት ካሞጋን ሄኢጆል ግራ፥ ፉሬን ካሊት ሄኢና ላግቶ። <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />ጎርታ እባዶት ኮ ታአዬሰሮ ሄኢ ፉሬን አን ካአዴሶን ጎሌ፥ ካአዬሰሮ እባዶትን አን ማርት ላራ፥ ኡሱና እዬን ማርት ላራ። <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />እስና ኡሱማሌታን፥ አያናኮክ እላቦል ሄላይን ኦዶታታን ማንኮሌቴን ማራን፥ ምን ካዋ ካኮባሮ እላቦል ሄላይን ኣሎ ዶታዬን።<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />ሃንሱን ካለካለት ሄኢ ካአዬሳራ እባዶ ካአዬሰሮ ፉርን ጎጎዳንዴሮ ሀኤባተ። <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />ካለካለት ሄኢ ጎኤባየ አያናክ ኤባታራ፥ ሳሙት አደ ኢል ካላይትታ። <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />ሀያ መ የልን ዶትሳራ? አያናይ ኤባይናራ፥ ሳሙቴይና ኤባታራ፥ አያናይና ዛማራራ፥ ሳሙቴይና አደ ዛማራራ። <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />ሃ ጎሌኖን አያናይ ዋ ካኮሶማሳቶ ጎራታ፥ አየሱን ማርት ካሌ እባዶት አት ካአዬሳቶ ጎአዴሶን፥ ምሲ ካሶማ ኤብካዉን፥ “ሀሚኒዕ” አምን ዳንዳራ? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />አት ጎጎዶታቶ ካሶማሳቶ ለታ፥ ካካለ እባዶ ጎአመን ላኮቢሳሮ።<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />አን እስን ዱባንኮ ታሮርተ ካለካለት ሄኢ ማንኮአዬሳሮ ማራን ዋ ጋላታራ። <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />አየሱን ጎአመን ምን ካዋይ ኦሮ ካካለ አጋልስስን፥ ኩማ ቶሞን ሃፉራ ካለካለት ሄኢ ካአዬሳሮኮ ሱረ ሃፉራ ከን ሳሙቴኮ ጎአዬሰ ኢድራ።<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />አቢላልቴ፥ አየስ ካሜላኑን ይስ ላ ኳሬ ቆፋትስኒ ይስ አሮሌተን፤ ቆፋትስኒ ኦዱባንቴን ላ።<verse eid="1CO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CO 14:21" />“ሄኢ ካለካለት ካአዬሳሮ እባዶና</para>
  <para style="q2" vid="1CO 14:21">ካአላጋ እባዶኮት ሄኢ ሂካ ጎሳዉን አዬስናራ፥</para>
  <para style="q2" vid="1CO 14:21">ህክና ሌ ግራን እን ላኮማላራን” ሃ አማራ ዋ።</para>
  <para style="m" vid="1CO 14:21">አማመ ሴራ ጻፋመራ።<verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />ሃንሱን ካለካለት ሄኢ አዬሳኖ ዋ ካአማኖቱን ማላታ ጎጎሌሮን ኳሬ ካአማነሮን ላኮዮ።<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />ጎርታ ምን ካዋክ እባዶ ራቶ ኩኩ ታኮአማሮ፥ ዱባና ካለካለት ሄኢ አዬሳ ግራን፥ ማርት ጎርቱን ካአማኖን እባዶ ጎሳ ቶስ ጎታብሮ፥ ሂክ እባዶ ቆላመራ ላኮአማሮያ? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />አየሱን ጎአመን ዱባና ሄገሮ አዬሳኖ ጉት ግራን፥ ማርት ጎርቱን ካአማኖን ጎርቱን ካካሶን እባዶት ጎታበ፥ ካማላሮ ሃፉራ ዱባ ዎቃሳማራ፥ ጩባለሳ ላኖኬሳ ኦማላራን ዱባ ዶሌ ፍርዳማራ። <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />ዎዳናቴሳይ ካስያመራ አየስ ሙትናራ፥ ኡሱማለና “ዋ ኦግራን እስን ኦሮ ግራ” አማ በቤዲ ሆረሆረ ኢየረ ዋዉን ሳጋዳራ።<verse eid="1CO 14:25" /></para>
  <para style="s1">ምን ካዋክ ዎጋ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />አቢላልቴ፥ ጎርታ መ አምና? ካኮኩኩንታን ጎራታ እስንኮ ኮ ካማዛሙር እላቦ አባ፥ ካካለ አጋልስሳኖኮክ እላቦ አባ፥ ኮ ካጎላተሮ አየስ ቱሳኖኮክ እላቦ አባ፥ ኮ ካለካለት ሄኢ አዬሳኖኮክ እላቦ አባ፥ ካካለ ፉራኖኮክ እላቦ አባ፥ ሀያ፥ ሂክ ዱባ እላቦ ዋ ካአማናሮ እባዶ ካቢሳሮ ላኖ ዶትሳራ። <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />ካለካለት ሄኢ ኦአዬሳራን ጎግሬን ላማ ጎርቱን ጎጂናተ ሴድ ሊጉሬነ ጅግ ጅጊ ሀአየሰን፥ እሶ ካአዬሳራና ካካለ እባዶ ሀፉረ። <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />ካፉራ እባዶ ጎዋታመ አድ ካለካለት ሄኢ ካአዬሳራ ሀጋና ኦሮ ጫልኢ አምረ እስኦቴሳዉና ዋዉን ሀአዬሶ። <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />ሄገር ኦአዬሳራን ላማ ጎርቱን ሴድ ሊጉሬነ ሀአየሰን፥ ኦካለ አድ ካአዬሳመሮ ጫቃስጉሬነ እስኦራይሬን ሀቆቆሬን። <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />ኦሀማጼራን ኦሮኮ እባዶት ኮ ራጋ ኡሱን ጎሙተ ሆራርጀ ካአዬሳረ ጫልኢ ሀአመ። <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />እስን መተ መተክስኑን ጎጎአጋልሳታኑና ጎጎአታታኑን፥ ዱባና ጅግ ጅጊ ሄገር አዬስን ዳንዳታን። <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />ካሄገሮልኮክ አያናል ካሄገሮሉን ኢምናማራ። <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />ዋ ካኖጎዳ ሄዶ ኳሬ ካኢያ ሄዶ ላኮዮ። ቁሎለኮክ ምን ካኤብ ዱባና ኡሱማሌዋያ። <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />ሄለል ምን ካዋ ኦሮ ጫልኢ ሀኣሞ፤ ሴራ ጎጎአማሮ ጎጎአጃጃምሮን ኳሬ ጎጎአዬስሮ ፈኢ ላኮስሳንተቶ። <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />ሄለል አዴስን ካዶትሳራ ኮኮ አየስ ጎግረ፥ ኤንተርጆልክሶ ምኒ ሀሆሳተ፥ ኣላንቲና ሄለልትቲ ምን ካዋ ኦሮ ጎአዬሰ ካሙልስሮያ።<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />ሃፉራ ካዋ ካኮቤራ እስንኮያ? ሙ ካጌራ እስን ቶስ ካላልያ? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />ማዮና አን ካሄገሮያ ካአማራ ጎግረ፥ ሂካ ካኮንጻፈራ ካጎታ አጃጃ ላኖ ሀማላቦ። <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />ሂካ ካአዴሶን ጎግረ አድ ኡሱና ላኮአዴሳማሮ።<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />ሃንሱን አቢላልቴ፥ ሄገር አዬስን አታኒ ዶታዬን፥ ካለካለት ሄኢ አዬሳኖና አሮትርቴን። <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />አየሱን ጎአመን ዱባና ጎጎዶትሳሮ ሴራና ዎጋ ሀሌዎ።<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s1">ካክርስቶሳ ጎይኮ ክያኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />ግዳና አቢላልቴ፥ አን እስን ካላላበሮና ካአታቴታና አታቴን ካኮአልቴታን ካዎንጋላ ሃፉራ ሻድሲን ዶታራ። <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />አን ካላላበሮ ሃፉራ አታይሳይ ጎአባቴን፥ ሂካ ዎንጋላይ ፋይናታን፥ ጎርቱን ካአማንቴታን አዳያ።<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />አን ካአታዬሮና ዱባንኮ ካጉተ ካሌሮ እስኑን ሮርሰራ፥ ቁሉክ ማጻፋል ጎጎአማሮ ክርስቶሳ ጩቦካን ማራን ጎየ፤ <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />ቃማላመ፥ ቁሉክ ማጻፋሊ ጎጎጻፋመሮ ታሴድ አሪ ጎይኮ ኬ። <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />ኤሰኮ ካፋን ሙተ፥ ደቤና ኦፋራመራን ቶሞንኮ ላማን ሙተ። <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />ኤሰኮ አባባተረ ከን ቦሌኮ ጉንተ ኦሌራን አቢላሉን ዱባዉን ኮክ ሙተ፥ እሶኮና ኦሞጋን ኔፎነ ግራን፤ ኮኮና አደን ጎዬራን። <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />ኤሰኮና ያይቆባን ሙተ፥ አባባተረና ኦፋራመራን ዱባን ሙተ፥<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />ዳንበኔ አደ ሳልኤሳ ኣን ካቶታማሮ እና አደ ሙተ። <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />አን ኦፋራመራን ዱባኮ ካየራታሮያ፤ ካፋራመሮ አማም ኡማምን ዱዶ ኢን ካዶትሶን አጣፋታ ካሌኖንያ፥ ኣላንቲና ምን ካዋ ሆሮረራ። <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />አየሱን ጎአመን አን ግዳ ታሌሮ ሌረ ካኮግራ ስኖ ታዋይያ፥ እዬን ታስሳንቴታ ስኖ ኢል ካሊ ላኮሄሰቶ፥ ሱረዋ ዱባኮና ሮረ ፈሎ ሀርጋጨራ፥ አየሱን ጎአመን ሂካና ታየልተታ ኢነታ ታግቶ ስኖ ታዋታ ኳሬ ላኮአንዮ። <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />ጎርታ አንና ሌረ እሶና ካአጋልስሳና ሂካያ፥ እስና ካአማንቴታን ሂካዋያ።<verse eid="1CO 15:11" /></para>
  <para style="s1">ጎይኮ ክያኖኮክ ጋራ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />አየሱን ጎአመን ክርስቶሳ ጎይኮ ጎጎኬሮ ካአጋልስሳኖ ጎሌነ እስንኮ ኮኮ ጎይኮ ከያኖ ላግሮ ምሲ አማራ? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />ካጎየራ ጎይኮ ካኬኖን ጎሌ፥ ክርስቶሳ ጎይኮ ላኮኬሮ አማኖያ፥ <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />ክርስቶሳ ጎይኮ ጎኬኖን ላላባኖካን ላኦ ካላይክያ፥ አማኖክስና ካማድኖንያ። <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />አደ ዋ ክርስቶሳ ጎይኮ ኬሰራ አምነ አጋልስሳኖካን ዋ ጉት ካጣራ አቶጆል ሌነና አማኖያ፥ ጎርታ ካጎየራ እባዶ ጎይኮ ጎኬኖን ዋ ክርስቶሳና ጎይኮ ላኮኬሰሮ አማኖያ። <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />ካጎየራ እባዶ ጎይኮ ካኬኖን ጎሌ ክርስቶሳና ጎይኮ ላኮኬሮ አማኖያ። <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />ክርስቶሳ ጎይኮ ካኬኖንግሮ ጎሌ አማኖክስን ካማድኖንያ፥ ግዳ ጊን ጩቦክስነ ዎታ ግታን አማኖያ። <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />ክርስቶሳ አማኔንጉሬነ ኦጎየራና ባየራን አማኖያ። <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />ክርስቶሳ አብድ ካኮንየላታና ሂካ አላምኮክ ግር ካላሉን ጎሌ እባዶ ዱባኮ ሮርነ እባዶ ዱባ ኦኮነኔኤይሳታሮና።<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />አየሱን ጎአመን ክርስቶሳ ካጎየሮ እባዶ ዱባን ባርክ ሌ ኦግራን ጎይኮ ኬራ። <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />ጎይ ካኮኤመተራ እባዶት ኮ አዳመኮት ኣላንቲ ጎጎሌሮ ጎይኮ ከያኖና ኮኮኤመተራ እባዶት ኮ ክርስቶሳኮት ኣላንቲያ። <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />አዳመኮት ኣላንቲ እባዶ ዱባ ጎጎ ጎዋሮ ኡሱማለና ክርስቶሳኮት ኣላንቲ እባዶ ዱባ ኔፎ ሄላታራ። <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />ህክና ካኮልናራ መተ መተ ጅግ ጅግኬሳያ፤ ክርስቶሳ ጎይኮ ከያኖ ካሆራርጄ ማሱሳያ፤ አባባይረ ክርስቶሳ ታኮኤመታሮ ኦቴሳ ኦሌራን ጎይኮ ክናራን። <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />ደቤና ኡሱ ቃላዳና ኦዶናት ሁና ዱባ ባስረ ዎኖናት ዋ ኦዶዉን ካኮሼጣሮ ጎራታ አላምኮክ ጉዳታኖ ልናራ። <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />ዋ ዲናጆል ዱባ ኦዶናትኬሳኮ ሄገሌ ኡሱን ታካይሮ ክርስቶሳ ሬዲን ዶትሳራ። <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />አዎዳምረ ካባይናራ ካጋቾ ዲና ጎይያ። <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />“ዋ ካአመን ዱባ ኦዶናትኬሳ ሄገሊ ካየራ” ካአማራ ጻፋመራ፤ አየሱን ጎአመን “ካአመን ዱባ ኦዶናትኬሳ ሄገሊ ካየራ” ጎአምሮ ካአመን ዱባ ክርስቶሳ ኦዶናትኬሳ ሄገሊ ካካየሮ ዋ ኦዶ ላኮአዳሮ። <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />ካአመን ዱባ ኦዶናት ካክርስቶሳ ሄገሊ ካኮሌ ጎራታ፥ ዋ ኦዶ ዱባና ዱባ ጎጎሌሮ ኤረ መተኬሳ ካአመን ዱባ ኦዶናትኬሳኮ ሄገሌ ኡሱን ካካየሮ ዋ ኦዶኮክ ኦዶናት ሄገሊ ግርናራ።<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />ጎርታ፥ ካጎየራ እባዶ ጎይኮ ካኬኖን ጎሌ፥ ካጎየሮ እባዶን አመረ ካጣማቃመሮ እባዶን ዎረኤ መያ? ካጎየራ እባዶ ዱዶ ጎይኮ ካኬኖን ጎሌ፥ እባዶ ባንኤትሶይ ሙን ጣማቃማራ? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />ኖና አንዴ ሳት ሳቲ ባይን እስኦታን ሮርሳነ ስሳታ ካኮንግራና መዉንያ? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />አቢላልቴ! አርጌቶ ጎይ ኢን ኤሰላራ፤ ሂካና እስኑን ካኮንሰጋራ ጎታካን የሱሳ ክርስቶሳኮክ ምናነ እስን ጉት አን ካአባ ዳታኖ ካአዴሳመ ማንኮሌ ማራንያ። <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />ያዳ ካእባዶ ማለ አን ታኤፈሶን ካታማይ ሱላለነ ዎታ ሞአባታኖኮት ላኦት መታ? ካጎየራ ጎይኮ ካኬኖን ጎሌ፥ “ጌባር ማንኮጎይናኖ ማራን ኮዬን አምና፥ ጣምና” ጎጎአማመሮ ላኖያ።<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />አሮሶባንቴን፤ “ሳትንቴ ታሜላን ታኢዳንት ያዳሊ ባሳታ።” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />ታአዳቦቴ ዎዳናትስን ቶስ አባባዬን፤ ጩቦና አሮፈልቴን፤ እስን ኦሮ ኮኮ ዋ ካካሶን እባዶ ግራ። ሂካና አን ካኮንአማራ ጎጎሙልታኑን አመረያ።<verse eid="1CO 15:34" /></para>
  <para style="s1">ጎይኮ ካኬሮ ማር</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />አየሱን ጎአመን፥ እባዶት ኮ፥ “ካጎየራ እባዶ ጎይኮ ካኮክያራ ምሲያ? ጎይኮ ከያ ግራን ካግርናራ ማር ምስክያ?” አም ካሆሳሮ ሌራ፤ <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />አት ጎዋ! አት ካዉጣታ ዉጣ ጎጎኖን አላይ ብን ላኮዳንዳሮ። <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />አት ዉጣታ ግራን ታዳርጋማ ኢል ጎርቱን ካካለ ካምኮት ትጫርት ኢል ቶ ታላል ዉጣታ ኳሬ ዳንበኔ ካአላተሮ አካክልተ ላኮዮ። <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />አየሱን ጎአመን ዋ አደ ዉጣን ጎጎዶቴ ማር ስሳራ፤ መተመቴ ዉጣን ካለካለክ ማር ስሳራ።<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />ሶ ዱባ አማለ ኮ ላኮያን፤ ሶ ኦእባዶ ኮያን፤ ሶ ኦሱላለና ኦግድና ካለካለያን፤ ሶ ኦክምብር ካለያን፤ ሶ ኦኩኑኡቤ ካለያን።<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />ኡሱማለና ካዳሩረ ማር ግራ፤ ካኡሌ ማር ግራ፤ አየሱን ጎአመን ታዳሩረ ማርኮት ካባጃ አማለ ኮታ፤ ካኡሌ ማርኮት ካባጃ ምዲ ካለታ። <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />ካአሪቲ ኢፋ ምዲ ቶታ፤ ካድግኒ ኢፋ ምዲ ካለታ፤ ታባራጃና አደ ካለታ፤ ባራጃ ኮ ባራጃ ካካለኮ ኢፋ ካለክ አባ።<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />ጎይኮ ካከያራ እባዶ ሂካ ኣን ላራ፤ ካሻማሮ ማር ሌ ካዉጣመራ ካሻሞን አርዶክ ማር ሌ ከያራ። <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />የራን ካዉጣመራ ካባጃ ክናራ፤ ሀርጋጫ ዉጣማራ፤ ሁናይ ክናራ። <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />ካሶየ ማር ሌ ካዉጣመራ ካአያና ማር ሌ ክናራ፤ ካሶየ ማር ጎግረ ካአያና ማር ግራ። <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />ሃንሱን፥ “ካሆራርጄ አዳመ አርዶክ መጣ ሌ” አማመ ጻፋመራ፤ ካዳንቤ አዳመ ክርስቶሳ አደ ግር ካስሳሮ አያና ሌ። <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />አየሱን ጎአመን ሆራርጀ ካኤመተረ አዳመ ካሶየየ ኳሬ ካአያና ላኮየ፤ ካአያና ሌ ካኤመተረ ካሶየኮ ዳንበኔየ። <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />ካሆራርጄ እባዶት አዳመ ካኮመጣመረ ኤሬኮ ማንኮሌ ማራን ካኤሬየ፤ ካላም እባዶት ካኤመተራ ዳሩርኮያ። <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />ኤሬኮ ካሌራ ኤሬኮ ካመጣሮ አዳመ አንያን፤ ዳሩርኮ ካሌራ አደ ዳሩርኮ ካኤመተሮ ክርስቶሳ አንያን። <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />ሀሱ ታኡሌ ምዲ ኣን ጎጎሌነኖ ታዳሩረ እባዶትኮት ምዲ ኣን ላና።<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />አየሱን ጎአመን አቢላልቴ፤ አን ካሰጋራ ሂካያ፤ “ሶና ኢግና ዎኖናት ካዋ ላኮኤላራን፤ ኡሱማለና ካባራ ማር ካንባኖን አርዶክ ማር ላኮኤላሮ።”<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />ሂክማ፥ ሆል ቶ አን እስኑን ሰግናራ። ኖ ዱባና ላኮጎይናኖ፤ አየሱን ጎአመን ኖ ዱባና ኢግልሳምናና። <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />ካኮኢግልሳምናና ካጋቾ ማላካታ ካኮኡፉፋሮ ጎራታ ጉምባር ጢጲመረ ጎጎባናማሮ ኣን ኮይክያ። ማላካታ ኡፉፋምናራ፤ ካጎየራ እባዶና ካሻሞን ሊ ክናራ፤ ኖና ኢግልሳምናና። <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />ሂክ ካሻማራ ካሻሞን ካጎዋራና ካጎኖን ሳርሳይን ዶትሳራ። <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />ሂክ ካሻማራ ካሻሞን ካጎዋራና ካጎኖን ካኮሳርሳሮ ጎራታ፥ “ጎይ አዎዳመ” አማመ ካጻፋመራ ሃፉራ ጉዳይናራ። <verse eid="1CO 15:54" /><verse number="55" style="v" sid="1CO 15:55" />ኡሱማለና፥</para>
  <para style="q1" vid="1CO 15:55">“ዎ ጎይ! አዎድ ክያኖካ ሀጌ ግራ?</para>
  <para style="q2" vid="1CO 15:55">ዎ ጎይ! አት እባዶ ካኮሚራታ ሁና ሀጌ ግራ?” አማመራ።<verse eid="1CO 15:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />ጎይ ካኮኤጋራን ሁና ጩቦያ፤ ካጩቦ ሁናና ሴራያ። <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />አየሱን ጎአመን ጎታካን የሱሳ ክርስቶሳኮክ ጋራነ አዎዳኖ ኖን ካስሳሮ ዋዉን ጋላታ ሀጌዎ።<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />ሃንሱን ካጌላንቴታን አቢላልቴ፥ አታዬን አላ፥ ማምስክ አየሱና አሮሻላጋንተን፤ ፈሎ ኦዋዉን አርጌቶ ኦአታቴን ላ፤ ኣላንትና ጎታዉን ካኮንዳፉራታን ካማድኖን ላናዋት ካሳንዋ።<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s1">ቁሎሌዉን ካቤሮ ማራጋደ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />ጎርታ ዋ ካአማናሮ እባዶን ካበያሮ ማራጋደ ታጋላትያ አዉራጃይ ካሞጋን ምን ካኤቢን አን ካስሰሮ አጃጃክ ማለ እስና ኡሱማሌ ፈላ። <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />አን ካኮኤሜየ ጎራታ ማራጋደ ቤሳኖ ጎጎግኖንኮ አልማ አልማ አሪ ታዎጋ እስንኮ መተ መተ ካሄላታሮኮ ጅልባከሳክ ማለ ቤሳታ ካለ ቤስ ሀካየ። <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />አን እስን ቶስ ካኮኤሜታሮ ጎራታ እስን ኦአሳብቴታን እባዶጃ እስን ካቤሰታን ማራጋደ ኣትረ ኢየሩሳለም ጎጎሴራዉን ታሱሱካኖ ዳብዳቤነታ አን እሶ ፋርናራ። <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />ሴቶት ታዶትሳቶ ጎሌተ፥ እሶ ኢነ ዎታ ሴይናራን።<verse eid="1CO 16:4" /></para>
  <para style="s1">ሀልቻ ካጳዉሎሳ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />መቀዶንያ ቶንሴ ሴይን ማንኮሄደሮ ማራን ኤሰነ ታኮሮራሮ ሉኪ እስን ቶስ ኤመይናራ። <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />ማንኮሴታሮ ማኤት ባንኤና ሰሴታንቴዉን ካሌሮ ጋርጋርሳ እን ጎጎየልታኑን ዎዳሳ እስን ዶሌ ካአዳላሮ ሌራ፥ ዎዳሳ ባጤሳ እስኔ ዎታ ካሮርሳሮ ሌራ። <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />ግዳ ታኮሮራሮ ሉክ ሮራ ግራን ድን ላኮዶታሮ፥ ፈኢ ታጎታ ጎሌተ ጎራታ ካኤር እስን ዶሌ አዳላይን አብድ የላታራ።<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />አየሱን ጎአመን ካጴንጠቆስጠ ባላ ታ ጌሮ ታኤፈሶን ካታማይ አዳላይናራ። <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />ፈሎ ኦሞጋን ካአባ ካባላኣን ኡፋ ኢን ባናመራ፥ ኦኔባታራን አደ ኦሞጋንያን።<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />ጢሞቶሳ እስን ቶስ ካኮኤሜተ ጎራታ አብስ ካሊ እስነታ ጎጎሀማጽሮን የላ፤ ኡሱና እን አን ፈሎ ኦዋ ፈላራ። <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />ሃንሱን ማዮና ኡሱ አሮቱፋኖ፤ ኡሱ አቢላልነ ዎታ እን ቶስ ጎጎኤሜሮ አን ማንኮሆሳየሮ ማራን እን ቶስ ኖጎዳ አባባይ ጎጎኤሜሮ ሰሴታንቴሳዉን ካዶትሳሮ ጋርጋራ።<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />አብካን አጲሎሳ አቢላል ታካለነ ዎታ እስን ጎጎዴሮ አታይሰ ኤባየረ፤ ኡሱ ጎአመን ግዳ እስን ቶስ ኤመይን ላኮዶታሮ፥ ኡሱን ጎኤካተ አድ ኤሜሮዋ።<verse eid="1CO 16:12" /></para>
  <para style="s1">ካጉድስ ጎርሳና ኖጎዳ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />ናባዳ፥ አማኖ አታዬን አላ፥ ካአቲ እባዶ ላ፥ ጃባየን። <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />ካፈላታን ዱባ ጌላንጄ ፈላዬን።<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />አቢላልቴ! ካእስጢፋኖሳ ካምነ እባዶ ኡል ካአካያይ ሆራርጀ ዋ ካአማነሮና አማኒሉን ሀንዳይን እስኦትሶ ሮርሳተን ጎጎስሳተራን ካሳንዋ። <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />ሂካማለክ እባዶና እሶነ ዎታ ፈሎይ ኦዳፉራራን ዱባን ጎጎአጃጃንታኑን አታይሰ ሻድሳራ።<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />እስጢፋኖስኔ ፈርዶናጢስኔ አካይቆስነ ኤሜቶትሶ ኢን ገገላይሰታ፥ እስን ኢን ጎግርዋተና እሶ አደን ባንኤትስኒ ኢን ካሀንቃተሮ አማገራን። <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />እሶ አያና ካኬና አያና ካክስና ፎልሲሴራን፥ ሃንሱን ሂካ ኣንክክ እባዶ አዴስን ዶትሳራ።<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />ኡል ካእስያይ ካግራ ካሞጋን ምን ካኤብ ኖጎዳ እስኑን ፋራሜራን። አቅላና ጲርስቂላ፥ ምንክሶይ ካኩኩማራ ዋ ካአማናራ እባዶ ዱባ ዎዳናኮ መገ ካጎታይ ኖጎዳ ፋራማራን። <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />ህታኒ ኦግራን ዋ ኦአማናራን ዱባ ኖጎዳ ፋራማራን፥ ቁሉክ እስአንጋታኖይ ኖጎዳ አታ።<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />አን ጳዉሎሳ ህታ ኖጎዳ እሲ ገነቴይ ጻፈራ።<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />ጎታ ካጌላኖን ጎግረ ካቃንጋመ ሀሌዎ! ጎታካን፥ ኮያ!<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />ጎታ የሱሳ ክርስቶሳኮት ስኖ እስኔ ዎታ ሀሌቶ።<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />ጌላንጀት የሱሳ ክርስቶሳይ እስን ዱባነ ዎታ ሀሌቶ፤ ሀሚኒዕ።<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>