<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Bayso New Testament</book>
  <para style="h">እብራዊ</para>
  <para style="toc1">ካኢብራዊ እባዶ ቶስ ካፋራመሮ ሀንዳ</para>
  <para style="toc2">እብራዊ</para>
  <para style="toc3">እብ.</para>
  <para style="mt1">ካኢብራዊ እባዶ ቶስ ካፋራመሮ ሀንዳ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ሂክ ሀንዳ ካኮንጻፋመራ እባዶ እሶ ጎዲደ አማኖክሶ እስን ካጋባላመሮ አማኒሉዉንየ፤ ጻፊት እብራዊጆሉን ካአዴስሰራ የሱሳ ክርስቶሳ ካሩሚና ካጋቾ ሙታኖ ካዋ ላኖ ቱስንያ። ሂክ አማኒል አማኖክሶይ ጎጎኣራራዉን አታይሳራ፤ ሂካ ካኮፈለ ጎራታ ሩም ሴድ አዴስሰ ቱሳራ፥</para>
  <para style="ili1">1. ታአታተሮ ራኮ ኮት ጋራነ ካሩም ኦዶን ካአጃጃማሮ ካሌራ የሱሳ ጅሩ ጅሮማክ ኤረ ካዋያ፤ ኤረ ካዋ ላኖይ አማቶ ኦሆርኮክ ካሄገሮልኮ፥ ሙሴኮና ኤርግቻልኮ ኣሎ ካሮረያ።</para>
  <para style="ili1">2. የሱሳ አማቶ ኦሆርኮ ኮክ ቱቃሞልኮ ኣሎ ካሮረ ጅሩ ጅሮማክ ቱቃሞ ላኖ ዋ እሲ አዬሰራ።</para>
  <para style="ili1">3. ጋራ ካየሱሳነ አማኒል ጩቦኮ፥ አብስኮና ጎይኮ ፋይናራ፤ የሱሳ ቱቃሞልኮክ ዎይቻ ላኖይ ካኢብራዊ እባዶኮክ አማኖ ሴራና ካግድ ጃርሶ ሆስ ኣን ሙታ ካግረ ፋይና ሩም ጎጎሌሮን የለራ።</para>
  <para style="ip">ጻፍት ታእስራኤል ጅርት ካአዴሳመ እባዶኮክ አማኖ ማሱሳ የላተረያ፥ (ፎልሲ። 11) ኦናባባራን አማኖክሶይ ጎጎአታራዉን አዴስሳራ፤ ኡሱማለና (ፎልሲ። 12) አማና እልኦ ኦትሶ የሱሳ ጉት ካኖይ አማኖክሶይ ጎጎአታራዉና ማምስት ራኮና አቦሳ ጎጌና ጎጎኦብስራዉን ጎርሳራ፥ ጉድሳና ካጎርሳ ሃፉራ ስሳ ጉድሳራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ፥ ዋ ክርስቶሳይ ሙታኖ <char style="ior"><ref loc="HEB 1:1-3">1፡1-3</ref> </char></para>
  <para style="io1">ክርስቶሳ ኤርግቻኮ ካሮራን ላኖ <char style="ior"><ref loc="HEB 1:4-2:18">1፡4—2፡18</ref> </char></para>
  <para style="io1">ክርስቶሳ ሙሴኮና ኢያሱኮ ካሮረ ላኖ <char style="ior"><ref loc="HEB 3:1-4:13">3፡1—4፡13</ref> </char></para>
  <para style="io1">ቱቃሞ ላኖ ካክርስቶሳ ዱባንኮ ካሮራሮ ላኖ <char style="ior"><ref loc="HEB 4:14-7:28">4፡14—7፡28</ref> </char></para>
  <para style="io1">ካክርስቶሳ ሃፉራ አማቶኮ ካሮራሮ ላኖ <char style="ior"><ref loc="HEB 8:1-9:22">8፡1—9፡22</ref> </char></para>
  <para style="io1">ካክርስቶሳ ጃርሳማኖኮክ ጂናን <char style="ior"><ref loc="HEB 9:23-10:39">9፡23—10፡39</ref> </char></para>
  <para style="io1">አማኖኮክ ጂናን <char style="ior"><ref loc="HEB 11:1-12:29">11፡1—12፡29</ref> </char></para>
  <para style="io1">ዋ ገጌላይሳኖ <char style="ior"><ref loc="HEB 13:1-19">13፡1-19</ref> </char></para>
  <para style="io1">ካጩፋኖ ኤብ <char style="ior"><ref loc="HEB 13:20-21">13፡20-21</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="HEB 13:22-25">13፡22-25</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ዋ ኤረኬሳኮክ ጋራነ አዬሳኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ሆርኮስኮ ካየረ ዋ ራ ካሞጋንና ጎራታ ካሞጋኒ ጋራ ካሄገሮልነ ኦዶጆልካኑን አዬሰረ፤ <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>ግዳ ጎአመን ካጋቾ ጌሲ ካመን ዱባ ጎጎኤሎን ካየለሮ ኤረኬሳኮክ ጋራነ ኖን አዬሰራ፤ አላም ዱባ ካኮመጠራ ኡሱያ። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ኡሱ ካባጃ ታዋ ሀንቃይሰ ካቱሳሮያ፤ ያዳሊቴሳና ዋኔ ዎታ ታኤካቶታ፥ ሃፉራኮክ ሁናይ አላም ዱባ እስክሰ አበራ፥ እባዶ ጩቦኮ ቁሎይሰ አባባተረ ዳሩሪ ካአቲ ዋኮት መርጌ ሀማጼ።<verse eid="HEB 1:3"/></para>
  <para style="s1">ኤረ ካዋ ኤርግቻልኮ ካሮራሮ ላኖ</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>ኡሱን ካቤራ መገ ካኤርግቻ መገኮ ካሮራሮ ማንኮሌ ማራን፥ ኤረ ካዋ ኤርግቻኮ ኣሎ ካሮራሮያ።<verse eid="HEB 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 1:5"/>ዋ ዱዶ ኤርግቻል ኦሮ፥</para>
  <para style="q1" vid="HEB 1:5">“አት ኤረኬታ፥ አን ኩ ህታር ኡሙለራ”</para>
  <para style="q2" vid="HEB 1:5">ጎርቱን</para>
  <para style="q1" vid="HEB 1:5">“አን ኦዶ ሌሮዋ፥ ኡሱና ኤረኬ ልናራ”</para>
  <para style="q2" vid="HEB 1:5">ካኮንአመረ ማዮና ላግረ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዛ. 2፡7</ref>፤ <ref loc="2SA 7:14">2 ሳሜ. 7፡14</ref>፤ <ref loc="1CH 17:13">1 ኦዱ 17፡13</ref>።</char></note><verse eid="HEB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 1:6"/>ዋ ባርክ ኤረኬሳ አላም ቶስ ካኮፋራረ ጎራታ፥</para>
  <para style="q1" vid="HEB 1:6">“ኤርግቻ ካዋ ዱባ ኡሱን ሀሳጋደ” አመራ።<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">አዳ. 32፡43</ref>።</char></note><verse eid="HEB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 1:7"/>ኤርግቻኮክ ጋራ፥</para>
  <para style="q1" vid="HEB 1:7">“ኤርግቻልና አምባል ኣን፥</para>
  <para style="q2" vid="HEB 1:7">ኦሀንዳራና ላጫ ካኤሌኔ ኣን የልናራ” አማራ።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">ማዛ. 104፡4</ref>።</char></note><verse eid="HEB 1:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8"/>ኤረኬሳኮክ ጋራ አደ፤</para>
  <para style="q1" vid="HEB 1:8">“ሄዶ! ኮርፍንጀካ ጅሩ ጅሮማኮ ታ ጅሩጅሮማ ጌሮን ግርናራ፤</para>
  <para style="q2" vid="HEB 1:8">ዎኖናትካና ሩሚ ባሪሳታ፤<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>አት ቁሉማ ጌላታ፤ ሜላነና ዲዳታ፤</para>
  <para style="q2" vid="HEB 1:9">ሂካኮት ኣላንቲ ዋ ሄዶካ ኩ አሳባተ፤</para>
  <para style="q2" vid="HEB 1:9">ሳትላልታኮ ሮርሰ ገጌሎ ታስሳቶ ዛይት ኩን ሽግደ” አማራ።<note caller="-" style="x"><char style="xo" closed="false">1፡9 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">ማዛ. 45፡6-7</ref>።</char></note><verse eid="HEB 1:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10"/>ኡሱማለና፥</para>
  <para style="q2" vid="HEB 1:10">ጎታኬ! “አት ሆራርጀ ኡል መጢተ፤</para>
  <para style="q1" vid="HEB 1:10">ዳሩርጆልና ገነታይ መጢተ፤<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>እሶ ዱባ ባይናራን፤</para>
  <para style="q1" vid="HEB 1:11">አት አደ ግርናታ፤</para>
  <para style="q2" vid="HEB 1:11">እሶ ዱባ ሳርስ ኣን ዶአይናራን።<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>ጋሸ አንና አት ዱብናታ፤</para>
  <para style="q2" vid="HEB 1:12">እሶና ሳርስ ካዶአን ሳርስ ካኡሱቢ ጎጎኢግልሳማሮ ማለ ኢግልሳምናራን።</para>
  <para style="q1" vid="HEB 1:12">አት አርጌቶ አትታ፥</para>
  <para style="q2" vid="HEB 1:12">ጌስካዉን ጋቾ ላግቶ” አማራ።<note caller="-" style="x"><char style="xo" closed="false">1፡12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">ማዛ. 102፡25-27</ref>።</char></note><verse eid="HEB 1:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13"/>ዋ ኤርግቻል ኦሮ፤</para>
  <para style="q2" vid="HEB 1:13">“ዲናካ ኦዶናትካ ሄገሊ ታ የሎይ</para>
  <para style="q1" vid="HEB 1:13">መርገቴይ ሀማጺ” ካኮንአመራ ማዮና ላግሮ።<note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዛ. 110፡1</ref>።</char></note><verse eid="HEB 1:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14"/>ኤርግቻል ዱባ ዋ አማን ካፋይናሮ እባዶን ሀንዳይን ኦፋራማራን ዋዉን ኦሀንዳራን አያናልያን።<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">ካአቲ ፋይና</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>ሃኑን ካማልነኖ አየስኮ ፋላዳይነ ጎጎኢኖንኮ ካማልነኖ አየሱን ኣሎ እስኦራታኖ ዶትሳራ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ኤርግቻልኮክ ጋራነ ካሰጋመራ ሃፉራ ሩም ሌራ፤ ሂካ ሃፉራኮ ካሽርማራና ሂካ ሃፉራን ካአጃጃሞን ታዶትሳቶ ሙሮ አታታራ። <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ሀያ ኖ ሂካ ካአቲ ፋይናን ዶና ኦላኖ ጎሌነ፥ ምሲ ሄሲን ዳንዳና? ሂካ ፋይና ኖን ካስሰራ ጎታ እሲያ፤ ኡሱኮና ካማለራ እባዶ ሂካዋ አዴስሰራ። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ዋ እሶን አደ ማላታል፥ ካሳድስሮ አየስ፥ ካሞጋን ባሳ ፈላኖዪና ፈኢቴሳክ ማለ ኦዳናባመራን አያና ቁሉክ እላቦልኮክ ጋራነ አቶታኖክሶ አታይሰራ።<verse eid="HEB 2:4"/></para>
  <para style="s1">የሱሳ ካፋይና ሶረሳ ላኖ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ዋ ሆረንባን ካኤሜይናሮን፥ ሂካ ግዳ ኖ ካኮአዬሳኖ አላም ኤርግቻ ኦዶናት ጎጎባርስሮ ላኮየለሮ። <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ኡሱማለና ቁሉክ ማጻፋጆል ባንኤ ቶይ ሃ አማራ፤</para>
  <para style="q1" vid="HEB 2:6">“አት ጎጎቆፍቶን እባዶ መያ?</para>
  <para style="q2" vid="HEB 2:6">አት ኡሱን ጎጎማራርቶ ኤረ ካእባዶ መያ?<verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>አባራን ኤርግቻልኮ የራሰ፥</para>
  <para style="q2" vid="HEB 2:7">ካካባጃና ካሶማ ካላቻ ኡሱ ጉት ካይተ፤</para>
  <para style="q2" vid="HEB 2:7">ገነታ ኦፈልተቶ ፈሎ ጉት ሹሚተ፤<note caller="+" style="f"><char style="fr" closed="false">2፡7 </char><char style="ft" closed="false">ፉሬን ቶቶይ “ገነታኮኒዕ ፈሎይ ሹምተ” ካአማሮ ላኮአዳራን። </char></note><verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>ዱባና ኦዶናትኬሳ ሄገሊ ካይተ።”<note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">ማዛ. 8፡4-6</ref>።</char></note></para>
  <para style="m" vid="HEB 2:8">ካመን ዱባ ኦዶናትኬሳኮ ሄገሌ ካኮካይተ ጎራታ፥ ኦዶናትኬሳኮ ሄገሊ አንካይኖን አት ካሃሴታ አየስ ኮና ላግሮ። አየሱን ጎአመን ግዳ ጎጎግሮይ ካመን ዱባ ኦዶናትኬሳ ሄገሊ ካግሮ ጋና ላኮዴነኔ። <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ግዳ አዴ ኤርግቻልኮ ጎራታ ክጫሩን ሁስንተ ታግቴ፥ ታጎይ ራኮ አታታኖኮት ኣላንቲ ካካባጃና ካሶማ ካላቻ ካካተሮ የሱሳ ድናና፤ ኡሱና ስኖ ታዋይ ኖ ማራን ጎየራ። <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>ካመን ዱባ ኡሱይና ኡሱን ካመጣመራ ዋ ይስ ካሞጋን ካባጃ ቶስ ኬኒን ፋይናክሶክ ሶረሳ ካሌሮ የሱሳ ራኮ ኦሮማርሰ ሮርሳኖይ ዱዶክ ጎጎሌሮን ሂክ አየስ ካዶትሳሮ ማንኮሌ ማራን ዋ ፈለራ።<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>እባዶ ዋዉን ካቁሎይሳራና ጋራኬሳነ የሱሳ ኦቁሎዋራን ኦዶ ኮክ ይስያን፤ ሂካኮት ኣላንቲ ኡሱ እሶ፥ “አቢላልቴ” አም ኡምን ላኮሙላሮ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>ሃኑን ቁሉክ ማጻፋጆል</para>
  <para style="q1" vid="HEB 2:12">“መገካ አብላልቴዉን ሰጊናራ፥</para>
  <para style="q2" vid="HEB 2:12">ጎሳ ካዋ ኦሮ ህኢቴይ ጋላትናራ” አማራ፥<note caller="-" style="x"><char style="xo" closed="false">2፡12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">ማዛ. 22፡22</ref>።</char></note><verse eid="HEB 2:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13"/>ኡሱማለና፥ “አብድቴና ኡሱ ጉት ካይናራ” አማራ፥</para>
  <para style="m" vid="HEB 2:13">አደና፥ “ሂክማ አንና ዋ ኢን ካስሰራ ይንሳ ህታኒ ግና” አማራ።<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ሃንሱን ይስኬሳ ሶና ኢግ ካአቦ እባዶ ማንኮሌራን ማራን የሱሳና እሶ ኣን እባዶ ሌ፥ ሂካ ካኮንየለራ ጎይኮክ ጋራነ ጎይ ጉት ኦዶናት ካአቦ ዱርሳ ባስንያ፤ <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ኡሱማለና ጎይ አብሳታኖኮት ኣላንቲ ኡሊ ካኮግራን ጌስ ዱባይ ድዩማ ኢምናሜን ኦግሬኑን ዎዶ ሊንያ። <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>ኦግራን የሱሳ ካኮንኤመተራ ኤርግቻ ጋርጋርን አንሌኖን ግራን ታአብራመ ሳኒ ጋርጋርንያ፤ <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>ሃኑን ካመን ዱባይ አቢላል ኣን ላኖ ማንኮዶትሳሮ ማራን አቢላል ኣን ሌ፤ ሂካ ካኮንየለራ ጩቦ ካእባዶ ሀሄሶ አምን አመረ ዋዉን ሀንዳይን ካአብዳመና ካነኔኤይሳታሮ ቱቃሞልኮክ ዎይቻ ሌ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>ኡሱ እሲ ጫፋመረ ራኮ ማንኮአታተሮ ማራን ኦጫፋማራን ጋርጋርን ዳንዳራ።<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">የሱሳ ሙሴኮ ካሮራሮ ላኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ሃኑን እስና አዴን ኡምት ታዋይ ኦኡማንተታን ቁሉኒዕ አማኒል! አማኖካኑን ካፋራመሮና ቱቃሞልኮክ ዎይቻ የሱሳ ሻዳ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ሙሴ ምን ካዋ ዱባን ካአብዳመ ጎጎሌረክ ማለ የሱሳና ኡሱ ካሹመሮ ዋዉን ካአብዳመየ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ምን ካማዳራራ ምንኮ ታሮርቴ ካባጃ ጎጎአቦ ማለ የሱሳና ሙሴኮ ታሮርተ ታአቲ ካባጃ ማንኮዶትሳሮ ማራን ካባጃመ።<note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="NUM 12:7">ቶቶ 12፡7</ref>።</char></note> <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>ኦግራን ምን ዱባ መተመተይ ካማዳራሮ እባዶ አባ፤ ካመን ዱባ ካፈለራ አደ ዋያ። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ሆረንባዉን አማሚን ካዶትሳሮ አየስ ዱባን አቶታ ሙሴ ምን ካዋ ዱባይ ካሀንዳሮ ኣን ካአብዳመየ። <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>ክርስቶሳ አደ ምን ካዋይ ካአብዳመ ካኮሌራ ኤረ ኣን ሌጉረየ። ምንኬሳና ኖና፤ ምንኬሳ ካኮንሊናና ካኮአብዳታኖ አዬስና ታኮዳታኖ አብድ አታይሳይ ጎአባነያ።<verse eid="HEB 3:6"/></para>
  <para style="s1">አብዳታናዋትኮክ ጋራ ካስሳመሮ ሴርሳኖ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ሃኑን አያና ቁሉክ ጎጎአማሮ፥</para>
  <para style="q1" vid="HEB 3:7">“ህታር ያየቴሳ ጎማልቴን፥<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">ማዛ. 95፡7-11</ref>።</char></note><verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8-9" style="v" sid="HEB 3:8-9"/>ቃሉላቶክ ኡሊ ኦዶላልክስን እን ጎጎጫፈራንክ ማሌና ሜላነ እን ጉት ጎጎኬራንክ ማለ</para>
  <para style="q2" vid="HEB 3:8-9">እስና ዎዳናትስን ታአጃጃሞን አሮየላቴን፤</para>
  <para style="q1" vid="HEB 3:8-9">ኤሰ እሶ እን ጫፌን፤ ኢነ ዎታ ታማጋተን፤</para>
  <para style="q2" vid="HEB 3:8-9">ጌስ አፋርታሙን አን ካፈለሮና ዴን” አማራ ዋ።<verse eid="HEB 3:8-9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>ሃኑን አን ሀሴ አላታኒ አማራየጉረ፥</para>
  <para style="q2" vid="HEB 3:10">“ዎዳናትሶ አርጌቶ ሽርማታ፤</para>
  <para style="q2" vid="HEB 3:10">ራኬና ላኮአዴሴራን አመ።”<verse eid="HEB 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 3:11"/>አደና</para>
  <para style="q1" vid="HEB 3:11">“ ‘አን ታስስናሮ ታፎልሲ ባንኤቴ ቶስ ላኮታብናራን!’ አመ</para>
  <para style="q2" vid="HEB 3:11">አማራንቴይ አን አማተራ።”<verse eid="HEB 3:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="HEB 3:12"/>አቢላልቴ! እስን ኦሮኮ ማዮና አርዶክ ዋኮ ታፋክሶ ታሜላና ታአማኖን ዎዳና እስኑን ጎጎግኖንኮ እስኦራዬን። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>አየሱን ጎአመን እስንኮ ጩቦይ ሶባምረ ዎዳናቴሳ ታአጃጃሞን ጎጎየላኖንኮ፥ “ህታር” አማመ ካኡማማራ ጎራታ ግራን አርጌቶ እስእስአታይሳየን። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ሆራርጀ ካአባነኖ አማኖካን ታጋቾ አሪ ታ ጌኖን አታይሳይ ጎአባነ ክርስቶሳነ ዎታ ኦኤልናኖ ልናና።<verse eid="HEB 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15"/>ህክና፥ “ህታር ያየቴሳ ካኮማልታን ጎራታ</para>
  <para style="q2" vid="HEB 3:15">አብጆላልክስን ሜላነ ካኮከኬሰረን ጎራታ ጎጎየለራን ማለ ዎዳናትስን ታአጃጃሞን አሮየላቴን” አማመ ጎጎጻፋመሮያ።<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ጎሌና ሀኑኡ ያየቴሳ ማለን አባባተረን ኦሜልለረን አዮስዬን? እሶ ላ ሙሴ ሆረ ሀየ ቃጄልሳ ኡል ካግብጽኮ ኦቤሬንየና? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ጌስ አፋርታም ዱባ ዋ አማራይሳ ኦግረን አዮስዬን? ላሀኑኡ ጩቦ ኦፈለራና እሶ ጎየሬን ሬስክሶ ቃሉላቶክ ኡል እዬ ኦኮንሄሰሮየና? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>አደና ሀኑኡ አጃጃማኖ ኦዲዴረን ኳሬ፥ “እስን ታፎልሲ ባንኤቴ ቶስ ላኮታብናታን” አመ ኡሱ ካኮንማተራ አዮስዬን? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ጎርታኑን እሶ ታብን ካኮዋተራን አማናናዋትኮት ኣላንቲ ላኖ አዴሳና።<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ሃንሱን ዋ ታስስናሮ ታፎልሲ ባንኤ ቶስ ታብን ኖ ታአታነኖ አብድ ጋና ታጣባተቶ ማንኮሌተ ማራን እስንኮ ማዮና ህታ ታፎልሲ ባንኤ ቶስ ታኮታብሮ ኢድሊ አንሄላኖን ጎጎሄሶንኮ ኖ ዱባና እስኦራና። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ዎንጋላ እሶን ጎጎላላባመሮ ኖና ላላባመራ፤ አየሱን ጎአመን እሶን ካላላባመሮ ሃፉራ አማኖይ አታታና ማንኮዋቴን ማራን እሶን ላኦ ላኮስሰ። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ፈሎኦቴሳ አላም ታኮመጣመሮኮ ሀጋአበረ ኦጉዳቴራን ጎሌና፥ “አን ታስሳሮ ታፎልሲ ባንኤ ቶስ ላኮታብራን አመ አማራየረ አማተራ” ጎጎአመሮ ግዳና ኖ ካአማናና ኤሰራ ዋ ኖን ታስሰሮ ታፎልሲ ባንኤ ቶስ ታብናና፤<note caller="-" style="x"><char style="xo" closed="false">4፡3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ማዛ. 95፡11</ref>።</char></note> <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ታቶዶብ አርኮት ጋራ ማጻፋ ቁሉክ ባንኤ ቶይ፥ “ዋ ፈሎኦቴሳኮ ታቶዶብ አሪ ፎልሳተ” አማመ ጻፋመራ።<note caller="-" style="x"><char style="xo" closed="false">4፡4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">መጣ 2፡2</ref>።</char></note> <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ኡሱማለና ህታ ባንኤ አደ</para>
  <para style="q1" vid="HEB 4:5">“አን እሶን ታስስናሮ ታፎልሲ ባንኤ ቶስ ሱረ እሶ ላኮታብናራን” አማራ።<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ማዛ. 95፡11</ref>።</char></note><verse eid="HEB 4:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 4:6"/>ሂካ ዎንጋላ ሆራርጀ ኦማሌራን አጃጃማና ዋትኮ ካከይ ዋ ታስስናሮ ታፎልሲ ባንኤ ቶስ ላኮታቤራን፤ ጎሌና ኤሰራ ጎጎታብራዉን ፈኢ ካኮንስሳንተታ እባዶ ኮኮ ግሮዋ። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ህክና ጣየ ጎጎአማመሮ</para>
  <para style="q1" vid="HEB 4:7">“ህታር ያየቴሳ ጎማልቴን፥</para>
  <para style="q2" vid="HEB 4:7">ዎዳናትስኒ ታአጃጃሞን አሮየላቴን።”</para>
  <para style="m" vid="HEB 4:7">አማ ዋ ጌስ ካሞጋንኮ አባባተረ ጋራ ካዳዉተነ ካአዬሰሮ ሃፉራ አሪ “ህታር” አማም ጎጎኡማንቶ አዴስሰራ።<note caller="-" style="x"><char style="xo" closed="false">4፡7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">ማዛ. 95፡7-8</ref>።</char></note><verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>እያሱ ጎሳን ፎልሲ እሶን ካስሰ ሊ ግረዋ ዋ አድ፥ “ህታር” አማ አሪ ታካለኮክ ጋራ ላኮአዬሳረ።<note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">አዳ. 31፡7</ref>፤ <ref loc="JOS 22:4">ኢያ. 22፡4</ref>።</char></note> <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ጎርታኑን ጎሳ ካዋዉን ታአይሁድ ታፎልሲ አሪ ኣንትት ፎልሲ ጋና ግታ። <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ዋ ፈሎኮ ጎጎፎልሳተሮ ኡሱማሌ ዋ ታስስናሮ ፎልሲ ቶስ ካታባራ ፈሎኮ ፎልሳታራ።<note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">መጣ 2፡2</ref>።</char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ሃኑን ሀሱ እባዶ አጃጃማና ዋትኮ ካከይ ጎጎኢየራንክ ማለ ማዮና ዴበ ሴይረ ጎጎኢኖንኮ ታዋ ታፎልሲ ባንኤ ቶስ ታብን አታና።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ሃፉራ ካዋ አርዶክና ካፈላሮያ፤ ምና ላማነ ኤነናን ካአቦ ማምስክ ሺፋኮና ሮረ ካኤነናተያ፥ ኔፎና አያና፥ ምክታልና ለፋል ካለካለ ታ ቤስሮ ካጎጎሳሮያ፤ ዎዳና ኦሮ ታግቶ ቆፋና ሀልቻ ቆቆረ ካፍርዳሮያ። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ሆረ ታዋኮ ታጎላተታ መጣ ቶና ላግቶ፤ ኢልቴሳ ሆረ ካመን ዱባ ዲዳ ቤ ሀዉአይ ሌ ካሙታሮያ፤ ኖና አባብ ስስን ካኮዳንዳና ኡሱ ሆሬያ።<verse eid="HEB 4:13"/></para>
  <para style="s1">የሱሳ ካአቲ ቱቃሞልኮክ ዎይቻያ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ጎርታ ዳሩርጆል ኦሮማረ ኤልዴ ካቤሮ ካአቲ ካቱቃሞል ዎይቻ ማንኮአብኖ ማራን ህኢታኒ ካአቶቲነኖ አማኖካን አታይሳይ አባና፤ ካቱቃሞል ዎይቻና ኤረ ካዋ የሱሳያ። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>ኖ ካአብና ካቱቃሞል ዎይቻ ሀራኖካን ነኔኤይሳይን ካዳንዴኖን ላኮዮ፤ የሱሳ ጩቦ ላኮፈለሮ ኳሬ ካመን ዱባይ ኖ ኣን ጫፋመራ። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ጎርታ ኖ ሻጋ ሄላይና ጋርጋርሳ ኖን ካኮዶትሰ ጎራታ ስኖ ጎጎሄላኖን ስኖ ካኮሄላኖ ካዋ ኮርፍንጀ ሆረ አብስ ካላይ ጋባላሚና።<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ካቱቃሞል ዎይቻ ዱባ እባዶ ኦሮኮ አሳባመረ ዋኔ ዎታ ታኤሰልሳቶ ሃጃይ ባንኤ ታእባዶይ ሜባና ጃርሶ ዋዉን ስስን ሹማማራን። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ሀሱ ቱቃሞ ዎይቻት መተኬሳዉን ሀራኖ ካአቦ ማንኮሌሮ ማራን ኮና ኦካሶና ኦሽርአማራን ነኔኤይሳይ እሶ ድን ዳንዳራ። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>ኡሱ መተኬሳዉን ሀራኖኮክ ኣላንቲ ጩቦኮ ሀሄሶ አማማኖ ካሄላምስሳሮ ጃርሶ ስስን ካዶትሳራ ጎሳ ካላሉን አንሌኖን ግራን እስኦቴሳነ አደረያ።<note caller="-" style="x"><char style="xo" closed="false">5፡3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ዎዩ. 9፡7</ref>።</char></note> <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>አሮን ኣን ዋይ ካኡማመሮ እባዶ ጎሌ ኳሬ ማዮና ህታ ካባጃ እሲ መተኬሳይ ላኮሄላታሮ።<note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">ብያ. 28፡1</ref>።</char></note><verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>ኡሱማለና ክርስቶሳ ካቱቃሞል ዎይቻ ላኖኮት ካባጃ እሲ መተኬሳይ ላኮአታተሮ፤ አየሱን ጎአመን ካቱቃሞል ዎይቻ ላኖኮት ካባጃ ካኮሄላተራ፥</para>
  <para style="q1" vid="HEB 5:5">“አት ኤረኬታ፤</para>
  <para style="q2" vid="HEB 5:5">አን ኩ ህታር ኡሙለራ” ካአመሮ ዋኮያ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዛ. 2፡7</ref>።</char></note><verse eid="HEB 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6"/>ቁሉክ ማጻፋ ባንኤ ታካለቲ ዋ፤</para>
  <para style="q1" vid="HEB 5:6">“ካመልከጸደቅ ቱቃሞልኮክ ሹማታ ኣን</para>
  <para style="q2" vid="HEB 5:6">አት ጅሩ ጅሮማን ዎይቻታ” አማራ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዛ. 110፡4</ref>።</char></note><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>የሱሳ እባዶ ሌ ሂካ ኡሊ ካኮግረ ጎራታ ጎይኮ ሃስን ካዳንዳሮ ዋ ቶስ ካአቲ ኢያኖይና ታንጂን ኢልሚ ኡባ ኤብ ኤባተ፤ እስ የራሳታኖይና ካአጃጃመ ማንኮሌ ማራን ዋ ኤብኬሳ ማለ።<note caller="-" style="x"><char style="xo" closed="false">5፡7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">ማቶ. 26፡36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14፡32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፡39-46</ref>።</char></note> <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>ኡሱ ማምሲ ኤረ ካዋ ጎሌና ታአታተሮ ራኮይ አጃጃማኖ አጋልሳተ። <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ዱዶክ ሌ ካኮሙታረ ጎራታ ኡሱን ካአጃጃማሮ ዱባን ጅሩ ጅሮማኮክ ፋይናን እሶን ኣላንቲ ሌ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ኡሱና ዋ ካመልከጸደቅ ሹማታ ኣን ቱቃሞልኮክ ዎይቻ የለ ሹመ።<verse eid="HEB 5:10"/></para>
  <para style="s1">አማኖክሶ ጎጎኢሶንኮ ካስሳመሮ ሴርሳኖ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ህታ ሃጃኮክ ጋራ ኖ ካአዬስናና ካሞጋን አየስ ግራ፤ አየሱን ጎአመን ቦግ ማላባ ግራን ዉደታማና ማንኮዋተ ማራን እስን አጋልስሳኖ ጥባራ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ግዳ ጊን ካኮግቴን ጎራታይ እስን ካአጋልስሳሮ ሊ ግራቴን፤ ግዳ ጎአመን ሃፉራ ካዋ ካሆራርጄ አጋልስስ እባዶ ካካለ እስን ካላም ጎጎአጋልስስሮን ዶትሳራ፤ ህታ ኣላንቲ እስኑን ኦዶትሳራን ኤኖያን ኳሬ ካአቲ ባቦ ላኮዮ። <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ኤኖ ኦላል ካጣማራ ዱባ ይስ ማንኮሌ ማራን ቁሉማኮክ ጋራ ጋና ላኮአጋልሳተሮ።<note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 ቆሮ. 3፡2</ref>።</char></note> <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ካአቲ ባቦ ካኮንዶትሳራ አደ ካኢዳና ካሜላና ካለ ቤስ አዴስን ካእጻማሮ ካጂንጂን እባዶያ።<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ጎርታ ክርስቶሳ ማራን ካስሳመሮ ካሆራርጄ አጋልስስ አባብ አባብ ኬሳኖ እስጉነ አጋልስስ ዱባማኖ፤ ጎይ ቶስ ኦጌሳራን ፈሎ፥ ጩቦኮ ጉላ ጋላኖኮክና ዋ አማናኖኮክ ጋራ አባብ አባብ አጋልስሳ ካሆራርጄ ኡኩም ላኮጣቢንሶ። <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ኡሱማለና ጥንቃታ፥ ገነ ጉት ካኖ፥ ጎይኮ ክያኖ፥ ካጅሩ ጅሮማ ፍርዳኮክ አጋልስስ አድ ላኮጣቢንሶ። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ዋ ኖን ፈኢ ጎስሰ ሆረንባን አጋልስሲ ዱባማኖ ቶስ ጂናይናና።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>አማኖክሶ ካካተሮ እባዶ ጩቦኮ ጉላ ጋላኖ ቶስ አባብን ላኮዳንዳማሮ። ሂካ እባዶን ሂታኮ ሆረነ ኢፋ እሶን ሀንቃየ ግረ፥ ካዳሩረ እላቦና ቃማሰሬን፤ አያና ቁሉክኮ ቆባ ኦአታቴረን፥ <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ካእዳንክ ሃፉራ ካዋና ኤመይን ካግሮ ጅሩ ጅሮማክ ቃላዳ ካዋኮክ ሁና ኦቃማሰሬን፥ <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ሂካ ዱባኮ አባባይ አማኖክሶ ጎካካቴን እሶ መተክሶዉን ኤረ ካዋ አባበን ማንኮሱዋራን ማራና ዲዳ ቤሰን ማንኮየራሳናን ማራን እሶ ጩቦኮ ጉላ ጋልስን ላኮዳንዳማሮ።<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>አርጌቶ ኡሱ ጉት ካኡባታሮ ኢዳሞ ካጣማራ አካክልተ ካአባራተሮ እባዶትን ላኦ ታስሳታ ኤረ ዋኮ ኡሶ ሄላታ፤ <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>ኤኤንና ቂንጮና ጎአልሰ አደ ላኦ ካላይት ላታ፤ ኤነ ቃንጋምናታ፤ ኤሰኮ ኤለኒ ጉባምናታ።<note caller="-" style="x"><char style="xo" closed="false">6፡8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">መጣ 3፡17-18</ref>።</char></note><verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>አን ኦጌላታሮ ኦቴ! ኖ እስኑን ሂካ ጎአዬንሰና ሱረ ፋይናክስኑን ካሌሮ ካእዳንክ አየስ ጉት ግራኖክስን ኖ አብዳታና። <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ዋ ታኢዳን ካፍርዳሮያ፤ ሃኑን ፈሎኦትስን ጣየና ሌረ ግዳና መገኬሳ ማራን አማኒል ጋርጋርን እስን ታቱሴታን ጌላንጀ ላኮኢሎሮ። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>እስን ዱባ አብዲ ካኦራታን አየስ ታ ገነ ጌግሳታኒ አታንክስን ታ ጋቾ ጌታኒ ጎጎቱሳዉን ኖ ሀልቻና። <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ኖ ካኮንሀልቻናና አማኖይና ኦብሲ አታይጉነ ዋ አብዲ ካስሰሮ አየስ ካኤልናሮ እባዶ ኣን ጎጎሌታኑን ኳሬ ላፋኒዕ ጎጎሌታኑን ላኮዮ።<verse eid="HEB 6:12"/></para>
  <para style="s1">አብድ ታዋ ታአብዳንተ ላኖ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ዋ አብራመን አብድ ካኮስሳረ ጎራታ ኡሱ ካኮአማትራ ኡሱኮ ካሮራራ ካካለ ማዮና ማንኮግኖን ማራን ሃ አማ ኡሱ እሲ አማተ። <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>“ኦግራን አን ኩ ሶማሳይናራ፥ ሳኒታና ሞጋስናራ አመ ዋ አዬሰ።”<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">መጣ 22፡16-17</ref>።</char></note> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>አብራመ ኦብሴ ኦራተጉረ ዋ አብዲ ኡሱን ካታበሮ አየስ ሄላተ። <verse eid="HEB 6:15"/><verse number="16" style="v" sid="HEB 6:16"/>እባዶ አማቶ ጎታብሮ መተኬሳኮ ካሮረ መገይ አማታራ፤ አዬስክሶና አማቶይ አታይሳ እሶ ጠኤ ታግቶ ዶጋማ ዱባ ባሳራን። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ሂካማሌ ሙርት ታዋ ታኢግልሳሞን ላኖ ኣሎ አዴስስን ዶተጉረ አብዲ ኤልን አብድ አማቶይ እሶን አታይሰራ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ሂካማሌና ዋ ኦኢግልሳሞና ካጣራ ካሌኖን አየስ ላማ፥ ህክና አብድና አማቶ ኖን ስሰራ፤ ሂካ አየስ ላማኮክ ጋራነ ኖ ሆረ ታግቶ አብድ አታይሳይ አባይን ጎጎዳንዴኖን ካኮእስካኖ ሄላይን ኡሱ ቶስ ኦኤሜነና ኖ ካአቲ ጎጎኢና ሄላነና፤ <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>ህት አብድ ግርካንዉን ካአኢኖን ካአብዳመ ማርካፋ ባዲ ታአሊሳቶ ማርጮ ኣንትትታ፤ የሱሳ ታአብና አብድ ጎጎሎኮ ሮርተ ቁሉክ ምን ቶስ ታባታ።<note caller="-" style="x"><char style="xo" closed="false">6፡19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">ዎዩ. 16፡2</ref>።</char></note> <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>ሂካ ቁሉክ ምን ቶስ የሱሳ ካመልከጸደቅ ቱቃሞኮክ ሹማታ ኣን ጅሩ ጅሮማን ካቱቃሞል ዎይቻ ሌ ኖ ማራን ጣየ ታበ።<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ቱቃሞት መልከጸደቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>መልከጸደቅ ካሳለም ካታማኮክ ዎኖና ዱባንኮ ጦቂ ካአመ ቱቃሞ ካዋየ፤ ሂክ መልከጸደቅና፥ አብራመ ዎኖላል አዎደ አባባታ ግራን ራድ ኤሰለረ ሶማሳተ። <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>አብራመ ካአቦ ዱባኮ ኡሱን ሆራ ስሰ፤ መልከጸደቅኮት ፉሬን ታሆሬ፥ “ካቁሉማ ዎኖ” ካካለ አደ፥ “ታሳለም ካታማኮክ ዎኖ” ሃ አማኖ “ካኖጎዳ ዎኖ” አማኖያ። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>መልከጸደቅ ካአዴሳመ ኦዶና ኣና ጎርቱን አላታንኮክ ህዲድ ላኮአቦ፤ ጌስኬሳዉን ሆራርጀ፥ ግርኬሳዉና ጋቾ ላኮአቦ፤ ሂክ መልከጸደቅ ኤረ ካዋ ኣን ማሱሳ ልጉረ ጅሩ ጅሮማን ቱቃሞ ሊ ግርናራ።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ሂክ እባዶት ምስክ ካአቲዮ ዲያ፤ ኣኒ ታእስራኤልን ኦዶ ካሌራ አብራመ ቦጄ ካኣተሮኮ ሆራ ቤሰ ኡሱን ስሰ። <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ኣኒዕ ቱቃሞልኮኒዕ ፈሎ ኦሮ ኦካሜራን ታዎዮለ ሳኒ ጎሳኮና ታአብራመ ሳኒኮ ህክና አብላልትሶኮ ሆራ ጎጎአትራዉን ሴራይ አጃጄራ።<note caller="-" style="x"><char style="xo" closed="false">7፡5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ቶቶ 18፡21</ref>።</char></note> <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ሀሱ መልከጸደቅ ታዎዮለ ሳኒ ላና ጎዋተና አደ አብራመኮ ሆራ ኣተ፤ ካአብዲ ሃፉራ ካኮንስሳመረ አብራመ ሶማሳተ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ክጫርክ ካንጂንክኮ ሶማ ካአታይናሮ ላኖ ሄዳታኖ ላግሮ። <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>ምና ቶነ ሆራ ኦአታራን ኦጎይናራንያን፤ ምና ታካለነ አደ ሆራ ካአታራ አርዶክ ሊ ግርናራ አማመ ካኮአቶታመራ መልከጸደቅያ። <verse eid="HEB 7:8"/><verse number="9-10" style="v" sid="HEB 7:9-10"/>ጎርታኑ መልከጸደቅ አብራመነ ዎታ ካኮኤሰላረ ጎራታ ዎዩት ኣቦኬሳ አብራመኮ ጋና ሀኣላኖን ማንኮግረ ማራን ሆራ ኣትን ካዶትሳራ ዎዩት መተኬሳዉን አብራመኮክ ጋራነ ሆራ ሙረራ አማኖያ።<verse eid="HEB 7:9-10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>ጎርታኑን ጎሳን ሴራ ካኮስሳመራ ካዎዩ ቱቃሞ ላኖክ ማሌያ፤ ሂካ ካዎዩል ቱቃሞ ልክ ላኖ ካሄላማሮ ሌና ካአሮን ቱቃሞ ላኖኮክ ሹማታ አሌኖን መልከጸደቅ ቱቃሞ ላኖኮክ ሹማታ ኣንክክ ካአቦ ካካለ ቱቃሞ ኤመታኖ ካዶትሶን ሊ ግራረ። <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ፈሎ ኦቱቃሞል ጎኢግልሳምራን ሴራና ዎታ ኢግልሳማኖ ዶትሳራ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>ሂክ ዱባ ካኮንሰጋመራ ቱቃሞት ኣኒ ታካለኮያ። ህታ ኣኒኮ ማዮና ሁ ካፋላ ቶስ ጋባላመ ካሀንዳየራ ላግሮ። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ጎታካን ታይሁዳ ኣኒኮ ላኖ ካአዴሳመያ፤ ጎሌና ሙሴ ቱቃሞልኮክ ጋራ አዬሳ ግራን ታይሁዳ ኣኒኮክ ጋራ ካአዬሰራ አየስ ኮና ላግሮ።<verse eid="HEB 7:14"/></para>
  <para style="s1">ክርስቶሳ መልከጸደቅ ኣን ቱቃሞ ላኖ</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>ሂክ አየስ ኣሎ ሙት ካኮአዴሳምናራ መልከጸደቅ ኣንክክ ካካለ ቱቃሞ ካኮኬ ጎራታያ፤ <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>ክርስቶሳ ቱቃሞ ላኖኮክ ሹማታ ካኮአታተራ ግርኬሳ ሜሳ ካላይክ ማንኮሌ ማራንያ ኳሬ ሳኒ ታእባዶኮ ካኤመተሮ ዎጋና ሴራይ ላኮዮ። <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>“አት ካመልከጸደቅ ቱቃሞ ላኖኮክ ሹማታ ኣን ጅሩ ጅሮማን ቱቃሞታ” አማመ ቁሉክ ማጻፋል አቶታመራ።<note caller="-" style="x"><char style="xo" closed="false">7፡17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዛ. 110፡4</ref>።</char></note> <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ኡሱማለና ካጣዎ አጃጃ ላፋና ላኦ ካላይክ ማንኮሌ ማራን ሄሰራ፤ <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ሴራ ካሙሴይ ኮና ልክኪ ሊን ላኮዳንዴ፤ ግዳ ጎአመን ኖ ዋ ቶስ ታኮጋባላምና ታካለኮ ታሮርተ አብድ ኖን ስሳንተታ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20-21" style="v" sid="HEB 7:20-21"/>ሂታኮ ሆረነ ቱቃሞ ኦሌረን አማቶ ካላይ ቱቃሞ ሌራን፤</para>
  <para style="q1" vid="HEB 7:20-21">“ዋ አደ የሱሳነ አት ካመልከጸደቅ ሹማታ</para>
  <para style="q2" vid="HEB 7:20-21">‘አት ጅሩ ጅሮማን ቱቃሞታ፥’ አመ አማተ፤ ላኮጋቢሮ፤ አማመ ኡሱን ኦሰጋመራን አማቶነ ዎታ ቱቃሞ ሌራ፤”<note caller="-" style="x"><char style="xo" closed="false">7፡20-21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዛ. 110፡4</ref>።</char></note><verse eid="HEB 7:20-21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22"/>ሂናኣ አማቶኮት ኣላንቲ የሱሳ ኦኢዳን ኦሃፉራ አማቶዉን ኖን ዋቢ ሌራ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ቱቃሞል ማንኮጎዋሮ ማራን ቱቃሞ ኮ ሀኢግልሳሞን ፈሎ ጉት ጅሩ ጅሮማን ግርን ማንኮዳንዴኖን ማራን ኦሆሬ ቱቃሞልኮኒዕ ቶቶኦትሶ ኦንጂየን፤ <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>የሱሳ አደ ጅሩ ጅሮማን ካግራሮ ማንኮሌ ማራን ቱቃሞ ላኖኬሳ ካኢግልሳሞንያ። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ሃኑን ኦቴሳ ኦሌራዉን ካካለ ማራን ሆረ ሀይ አዬሳኖ ጅሩ ጅሮማን አርዶክ ሌ ማንኮግራሮ ማራን ጋራኬሳነ ዋ ቶስ ካኤሜታሮ እባዶ ዱባ ዱዶ ፋይስን ዳንዳራ። <verse eid="HEB 7:25"/><verse number="26" style="v" sid="HEB 7:26"/>ሂካ ኣንክክ ቁሉ፥ ካቱፋሞን፥ ካሙጭመ፥ ጩባለሳልኮ ዎዩ ካሌ፥ ዳሩርኮ ጦቂ ካአመ ካቱቃሞል ዎይቻ ኖን ዶትሳራ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>ኡሱ ካካለ ካቱቃሞል ዎይቻል ኣን ሆራርጀ ጩቦኬሳ ማራን፥ አባባይ ጩቦ ካጎሳ ማራን አርጌቶ ጃርሶ ስስን ላኮዶትሳሮ፤ እስኦቴሳ ጃርሶ የላተ ካኮስሳተረ ጎራታ ሂክ አየስ ካላም ታኮአዳሞት የለ ጉድሰራ።<note caller="-" style="x"><char style="xo" closed="false">7፡27 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ዎዩ. 9፡7</ref>።</char></note> <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ሴራ ካቱቃሞል ዎይቻ የለ ካሹማራ ቱፋማኖ ካአቦ እባዶያ፤ ሴራኮ አባባተረ ካኤመታራ ካአማቶ ሃፉራ አደ ጅሩ ጅሮማን ቱፍ ካላይክ ካሌሮ ኤረ ካዋ ሹመራ።<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">የሱሳ አማቶ ኦኡሱብኮክ ካቱቃሞል ዎይቻ ላኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ጎርታ ኖ ካአዬስናኖ አየስኮ ካሆሬ አየስ ሂካያ፤ ዳሩሪ ካአቲ ካዋኮክ ኮርፍንጄይ ምና ታመርጌ ካሀማጼሮ ሂካ ኣንክክ ካቱቃሞል ዎይቻ ኖ አብና።<note caller="-" style="x"><char style="xo" closed="false">8፡1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዛ. 110፡1</ref>።</char></note> <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>ኡሱ ካኮሀንዳራ ታሩም ዱንካኒ ታሌተቶ ቁሉክ ምን ካዋይያ፤ ሂካ ምንኮክ ማዳራማኖ ገነ ታእባዶይ አሌኖን ግራን ጎታይያ። <verse eid="HEB 8:2"/><verse number="3" style="v" sid="HEB 8:3"/>መተመተይ ቱቃሞልኮክ ዎይቻ ካኮሹማማራ መባና ጃርሶ ዋዉን ስሲንያ፤ ሃኑን ሂክ ቱቃሞ ካስስናራ ኮኮ ኮ ግርን ዶትሳራ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ሴራኮክ ማለ ሜባ ካስሳራ ቱቃሞል ማንኮግሮ ማራን ኡሱ ኡሊ ካግሮ ሊ ግረዋ ቱቃሞ ሊ ላኮግራረ፤ <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>ሂክ ቱቃሞል ታኮሀንዳራን ዱንካኒ ዳሩሪ ታግቶዉን ማሱሳና ሆስ ታላልታ፤ ህክና ካኮንሌራ ዋ ሙሴነ አት ምን ካኮማዳራቶ ጎራታ፥ “ዎዳሚ ጉት አን ኩን ጎጎቱሰሮክ ማለ ካመን ዱባ እስኦራ ፈል” አመ ጎጎአጃጄሮክ ማሌያ። <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>ግዳ አደ የሱሳ ዋይና እባዶና ጠኤ ታበ ህኢ ቶ ካየለሮ ካአማቶ ሃፉራ ኦዶአን አማቶኮ ታሮርተቶና ታኢዳንት አብድ ጉት ካጣባተሮ ማንኮሌሮ ማራን ኡሱማለና ኡሱን ኦስሳሜራን ፈሎ ዱባንኮ ኦሮራራንያን።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ኦሆሬ አማቶ ኦሃፉራ ኦቱፋሞን ሊ ግሬንዋ ካላም ካአማቶ ሃፉራ ላኮዶትሳረ። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>ዋ ጎሳ ጉት ኦቱፋምራን ፈሎ ግራኖ ቱስን አመረ ሃ አማራ፥</para>
  <para style="q1" vid="HEB 8:8">“አን ካእስራኤል ጎሳነና ካይሁዳ ጎሳነ ዎታ</para>
  <para style="q2" vid="HEB 8:8">አማቶ ኦኡሱብኮክ ሃፉራ ካኮታብናራ ጎራታ ኤመይናራ አማራ ጎታ።”<verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>ሂኒዕ አማቶ አን እሶ ካግብጽ ኡልኮ ገነትሶ አበረ ካኮቤሳረ ጎራታ ኦዶጆላልክሶነ ዎታ ኦታበረ አማቶ ኣኒዕ ላኮያን፤ እሶና ሂናኣ አማቶ ኦሃፉራይ አታታና ማንኮዋቴን ማራን አንና እሶኮ ባጋጎለ፥ አማራ ጎታ።<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>“ጎርታ አን ሂታኮ አባባይረ ካእስራኤል ጎሳነ ዎታ</para>
  <para style="q2" vid="HEB 8:10">አን ኦታብናራ ኦሃፉራ አማቶ ህናኣያን አማራ ጎታ፤</para>
  <para style="q1" vid="HEB 8:10">አን ሴራኬ ሳሙትስን ካይናራ፤</para>
  <para style="q2" vid="HEB 8:10">ዎዳናትሶይና ጻፍናራ፤</para>
  <para style="q1" vid="HEB 8:10">ዋክሶና ልናራ፥</para>
  <para style="q2" vid="HEB 8:10">እሶና ጎሳኬ ልናራን አመ።<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>‘ጎታ አዴስ’ አም ኦላቴሳና ሌረ</para>
  <para style="q2" vid="HEB 8:11">አቢኬሳ ማዮና ካአጋልስስሮ ላኮዶትሳሮ።</para>
  <para style="q1" vid="HEB 8:11">ክጫርኮ ሀጋአበረ ታ እባዶ ካጂንጂን ጌሮ ዱባና</para>
  <para style="q2" vid="HEB 8:11">እን አዴስሮዋ፤<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>ባስክሶና ሀሄሶ አምናራ፤</para>
  <para style="q2" vid="HEB 8:12">ጩቦክሶና ሂታኮ ሆረንባን ላኮሻድናሮ።”<note caller="-" style="x"><char style="xo" closed="false">8፡12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">ኤር. 31፡31-34</ref>።</char></note><verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ጎርታኑን “ኡሱብኒዕ አማቶ ኦሃፉራ” ጎአምሮ ኦሃፉራ አማቶ ኦሆሬ ላኦ ኦስሶን የለራ አማኖያ፤ ሃኑን ፈላ ካግረና ካዶአን ኮኮ ዱባ ካኮባይናራ ጎራታ ጋባላመራ።<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ካኡሌ ቁሉክ ምን ካኤብኮክ ሀንዳኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ኦሆሬ አማቶ ኦሃፉራ ዋ ሄዶይሳታኖኮክ ሴራና ካኡሌ ቁሉክ ምን ካዋ አባናየ፤ <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ክፍሊ ላማ ካአባ ምን ግረ። ቦላንሶና ጣራጴዛ፥ ዋዉን ካስሳማራ ባቦ ታኮግረ ታሆራርጄ ክፍሊ “ቁልቲ” አማማተ። <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ካላም ጎጎሎኮ ኦሮሀይተ ታግታ ታኦሮ ክፍሊ “ኣሎ ቁልቻት”<note caller="+" style="f"><char style="fr" closed="false">9፡3 </char><char style="ft" closed="false">ኣሎ ቁሉት ባንኤ ታአማማታ፥ ቁሉክ ምን ካዋይ ኦሮ ታሴድ ክፍሊታ። ብያ. 26፡31-36። </char></note> አማማተ። <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>ህታ ክፍሊ ኦሮ ዎርቂኮ ካፈላመሮ ኢጣና ካኮኢዮሳራን ኤሰ ባንኤ ግረ፤ ዎርቂ ካኮሳርስሳመራ አማቶ ኦሃፉራኮክ ሳጢነ ኤሰ ኦሮ ግረ፤ ሂካ አማቶ ኦሃፉራኮክ ሳጢነ ኦሮ ማና ታኮግረ ታዎርቂ ኡላ፥ ሁርሰ ታግቴ ታአሮን ዳማ፥ አጃጃ ቶሞኖ ካኮጻፋመረ ጣልጳክ ኤኤሞ ግረ።<note caller="-" style="x"><char style="xo" closed="false">9፡4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">ብያ. 30፡1-6</ref>፤ <ref loc="EXO 25:10-16">25፡10-16</ref>፤ <ref loc="EXO 16:33">16፡33</ref>፤ <ref loc="NUM 17:8-10">ቶቶ 17፡8-10</ref>፤ <ref loc="EXO 25:16">ብያ. 25፡16</ref>፤ <ref loc="DEU 10:3-5">አዳ. 10፡3-5</ref>።</char></note> <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ሃፉራ ካአማቶኮክ ካታቦታ ሳጢነ ጉት ካግሮ ጩቦ ሀሄሶ ካኮአማማሮ ኑብ ባላሎኦትሶይ ጎልሴን ኦአባራን ኦካባጃሜን ክሩቤል ኦአማማራን መጣጆልየን፤ አየሱን ጎአመን ሂካ አየስ ዱባኮክ ጋራ ግዳ ባላኣስ አዬስን ላኮዳንዳኖ።<note caller="-" style="x"><char style="xo" closed="false">9፡5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">ብያ. 25፡18-22</ref>።</char></note><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ካመን ዱባ ሂካማሌ ካኮኤካሮ ጎራታ ቱቃሞል ዋዉን ሀንዳይን አርጌቶ ምንኮ ታሆራርጄ ክፍሊ ቶስ ታባራን።<note caller="-" style="x"><char style="xo" closed="false">9፡6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-8">ቶቶ 18፡2-8</ref>።</char></note> <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ታላም ታኦሮ ክፍሊ ቶስ ካታባራ አደ ቱቃሞልኮክ ዎይቻ ካላልያ፤ ካታባራና ጌስኮ አሪ ቶ ታላልያ፤ ኡሱና ጩቦኬሳዉና ጎሳ ሀአዴሶን ካፈለሮ ጩቦን ካስሳማሮ ኢግ ሀአቦን ላኮታባሮ።<note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">ዎዩ. 16፡2-34</ref>።</char></note> <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ዱንካኒ ታሆሬ ካኮግቶ ግታክ ቁሉ ኣሎ ቁሉት ታአማማቶ ቶስ ካታብሳራ ራ ጋና ሀሙቶን ካግሮ ላኖ አያና ቁሉክ ሂካማሌ ቱሳራ። <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>ህክና ሂካ ጎራታዉን ማሱሳያ፤ ሂካማሌ ካስሳማራ ሜባና ጃርሶ ካስሳሮ እባዶትኮት ሳሙይ ካማልሳማሮ ባስኮ ሱረ ቁሎይስን ላኮዳንዳሮ። <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>ሂክ ካሞጋን አየስ ካኮኡሱባይናራ ጎራታ ታ ኤሜሮ ፈሎይ ጉት ካግራ ካሳረ ካሙታሮ ዎጋልያ፤ እሶና አማኖና ጣማኖኮክ ጋራና ካለካለክ ካሙጭሳሮ ዎጋኮክ ጋራ ካላሉን ካፈላመሮያ።<verse eid="HEB 9:10"/></para>
  <para style="s1">ካክርስቶሳ ኢግ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>አየሱን ጎአመን ክርስቶሳ ኤመታ ካግሮ ካእዳን አየሱን ካቱቃሞል ዎይቻ ሌ ሙተራ፤ ኡሱ ታኮታበራ ዱንካኒ ታጅንትና ዱዶትታ፤ ህት ዱንካኒ ገነ ታእባዶይ ታፈላሞንግቶና ሂካ አላም ኮት መጣ ላኮቶ።<note caller="+" style="f"><char style="fr" closed="false">9፡11 </char><char style="ft" closed="false">ኤመታ ኦግራን ጉት ካአማሮ ኮኮ ማጻፋጆል፥ “ግዳ ኦግራዉን” አማራ። </char></note> <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ኡሱ ኣሎ ቁሉት ታአማማቶ ባንኤ ቶስ ኮይክ ካላም ታኮአዳሞይ ኢግኬሳ አበረ ታበራ ኳሬ ካኦሬነና ካኮርጆሌ ኢግ አበ ላኮታበሮ፤ ሂካማሌ ጅሩ ጅሮማን ኖን ዎዶ ሌ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ካኦሬነና ካኮርጆሌ ኢግ ጃርሶን ታጉባንተቶ ዳባሎኮክ ቡሉሎ ካባቶየሮ እባዶ ጉት ጎአራጭራን ባትናት ካሶየኮ ሙጭሜን ኦቁሎዋራን ጎሌ፥<note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="LEV 15:16">ዎዩ. 15፡16</ref>፤ <ref loc="NUM 19:9">ቶቶ 19፡9</ref>፥<ref loc="NUM 19:17-19">17-19</ref>።</char></note> <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>ጅሩ ጅሮማክ አያናኮክ ጋራነ እስኦቴሳ ሙላ ካላይክ ጃርሶ የላተ ዋዉን ካስሳተራ ካክርስቶሳ ኢግ አርዶክ ዋዉን ኖ ጎጎሀንዳይኖን ሳሙታን ጎይ ቶስ ኦጌሳራን ፈሎኮ ኣሎ ኖ ሙጭስን ላኮዳንዳሮያ?<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>ኦኡማሜራን ሀኑኡ ዋ ታስሰሮ አብድ ጅሩ ጅሮማን ርቲ ጎጎአታናዉን ክርስቶሳ አማቶ ኦኡሱብኮክ ኢግ ኖ ህኢ ቶ ካየሎ ሌ፤ ህክና ካኮንሌራ ኡሱ ሆራርጀ አማቶ ኦሃፉራኮ ሄገሌ ሌረ እባዶ ህዲድኮ ኬስ ጩቦኮ ፋይስን ማንኮጎየ ማራንያ።<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>ባዛ ጎግረ ካባዛተሮኮክ ጎይ አዴሳኖ ዶትሳራ፤ <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ካባዛ አየስ ፈሎ ካኮሃራ ካባዛተራ ካኮጎየ ጎራታያ፤ ካባዛተራ ኔፎነ ግራን ካባዛ አየስ ላኦ ላኮአቦ። <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>ሂካኮት ኣላንቲ ኦሆራርጄ አማቶ ኦሃፉራ ሱረ ኢግ ካላይ ኦአታቴራን ላኮያን። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ሆራርጀ ሙሴ ካሴራ አጃጃ ዱባ ጎሳ ዱባን ሰገ፤ ሂካኮ አባባተረ ኢግ ካኦሬነና ካኮርጆሌ በከነ ዎታ ለደረ ካሴራ ማጻፋና ጎሳ ዱባ ህሶጲ ኦአማማራን ባላሎይና ኦጎሮ ኦእዳድኮ ካፈላመሮ ክሪ አራጨ፤ <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ካኮንአራጨራና፥ “ዋ እስኑን ካአጃጄራ አማቶ ኦሃፉራኮክ ኢግ ሂካያ” አመረያ።<note caller="-" style="x"><char style="xo" closed="false">9፡20 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ብያ. 24፡6-8</ref>።</char></note> <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ኡሱማለና ዱንካኒ ኦሮና ካኮፈላታራን ሁ ዱባ ጉት ኢግ አራጨ።<note caller="-" style="x"><char style="xo" closed="false">9፡21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">ዎዩ. 8፡15</ref>።</char></note> <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ኦግራን ሴራ ካሙሴ ማለ አየስ ክጫር ኳሬ ካመን ዱባ ኢግ ሙጭማራ፤ ኢግ ጎኡባኖን ጩቦ ሀሄሶ አማማኖ ላኮሄላማሮ።<note caller="-" style="x"><char style="xo" closed="false">9፡22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">ዎዩ. 17፡11</ref>።</char></note><verse eid="HEB 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ጎርታኑን ሂክ ካዳሩረ አየስ ማሱሳ ካኮንሌራ ሂካ ኣንክክ ዎጋ ሙጭማኖ ዶትሳረ፤ ዳሩርኮ ካሌራ አየስ አደ ሂካኮ ካሮረ ጃርሶይ ሙጭማኖ ዶትሳራ። <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>ክርስቶሳ ካሩም ቁሉክ ምን ካዋዉን ማሱሳ ታሌተቶና ገነ ታእባዶይ ታፈላንተቶ ኣሎ ቁሉት ባንኤ ቶስ ላኮታበሮ፤ ግዳ ኡሱ ኖ ማራን ዋይ ሆረ ሙትን ዳሩር ቶስ ቤ ታበ። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>ካአይሁድ ቱቃሞልኮክ ዎይቻ ካኬሳ ካሌኖን ኢግ አበረ ጌስ ጌሲ ኣሎ ቁሉት ባንኤ ቶስ ታበ ግረ፤ ክርስቶሳ አደ እስኦቴሳ ጃርሶ የላይ ስሳይን ጎራታ ካሞጋን ላኮታበሮ። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ሃ ካሌሮ ሊ ግረዋ አላም ታኮመጣመሮኮ ሀጋአብረ ጎራታ ካሞጋን ራኮ አታይን ካዶትሳሮ ሊ ግራረ፤ ግዳ ጎአመን ጌስጆልኮት ጋቾይ ጩቦ ኖኮ ባስን እስኦቴሳ ጃርሶ የላተ ኮክ ካላም ታኮአዳሞይ ሙተራ። <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>እባዶን ጎይ ኮያ፤ ጎይኮ አባባተረና ፍርዳ ግራ። <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>ኡሱማለና ክርስቶሳ ካሞጋንኮክ ጩቦ ባስን ጎይ ኮ ጎየራ፤ አደና ጩቦ ስዳይን አሌኖን ግራን ኡሱ ኦኦራታራን ፋይስን ካላም አድ ኤመይናራ።<verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="s1">ጃርሶ ላኖ ካክርስቶሳ ካላም ታኮአዳሞት</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ሴራ ካሙሴ ሆረንባን ካኤሜይናሮ ካእዳን አየሱን ማሱሳ ጎርቱን ሆስያ ኳሬ ታሩም ምዲ ላኮአባናየ፤ ሃኑን ጌስ ጌሲ አርጌቶ ካስሳማሮ ጃርሶጆል አባቴረን ዋ ቶስ ካኤሜታሮ እባዶ ዱዶክ የልን ሱረ ላኮዳንዳሮ። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ሴራ ካሙሴ እሶ ዱዶኒዕ የልን ካዳንዴሮ ሌዋ ዋ ሄዶይሳይን ካኤሜታሮ እባዶ ካላም ታኮአዳሞን ጩቦኮ ማንኮሙጭመራዉና ጩቦ ካላይኒዕ ኣን ሳሙትሶይ ባስ ማንኮማላሳማሮ ማራን ጃርሶ ስሳኖ እስ ግራኔን። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ሀሱ ጃርሶጆል አደ ጌስ ጌሲ እሶ ጩቦ ካሻድሳሮያ። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>ኣላንቲና ካኮርጆልና ካኦሬን ኢግ ጩቦ ባስን ላኮዳንዳሮ።<verse eid="HEB 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 10:5"/>ሃኑን ክርስቶሳ አላም ቶስ ታኮኤመተሬ ሃ አመ፤</para>
  <para style="q1" vid="HEB 10:5">“ጃርሶና ሜባ አት እንኮ ላኮዶተቶ፤</para>
  <para style="q2" vid="HEB 10:5">ማርካ ጎአመን እን ኤካሰታ፤<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>ካጉባታሮ ጃርሶና</para>
  <para style="q1" vid="HEB 10:6">ካጩቦ ሀሄሶ አማኖኮኪን ካኤናኣማሮ ጃርሶይ</para>
  <para style="q2" vid="HEB 10:6">አት ላኮገጌላተቶ፤<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>ሀሱ ጎራታ አን</para>
  <para style="q1" vid="HEB 10:7">‘ሄዶኬ! ማጻፋ ቁሉክ ጋራኬ ጎጎጻፋመሮ</para>
  <para style="q2" vid="HEB 10:7">ፈኢታ ጉድስን አን ኤመየራ’ ” አመ።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">ማዛ. 40፡6-8</ref>።</char></note><verse eid="HEB 10:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8"/>ሀኑኡ ሴራ ካአጃጃሮ ጎሌና፥ “ጃርሶና ሜባ፥ ካጉባታሮ ጃርሶና ጩቦኮ ሀሄሶ አማማኖ ካኤናኣማሮ ጃርሶ አት እንኮ ላኮዶተቶ፤ እሶና አደ አት ላኮገጌላተቶ” አመ፤ <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ደቤና፥ “ሂክማ፥ አን ፈኢታ ፌልን ኤመየራ” አመ፤ ሂካማሌና ካላምክ ጃርሶኮት ባንኤ ጣቢስን ካሆሬ ጃርሶ ኢግልሰራ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ሂካኒና “ፈኢ” ካአማሮ ሃፉራኮክ ማለ የሱሳ ክርስቶሳ ሶይ ኮኪ ካላም ታኮአዳሞት ጃርሶ ሌ እስ ስሳታኖኮት ኣላንቲ ኖ ቁሎይነና።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ቱቃሞ መተመተይ ጩቦ ባስን ካዳንዴኖን ኣኒዕ ጃርሶጆል አርጌቶ ስሳ አሪ አሪ አሌ ሀንዳራን።<note caller="-" style="x"><char style="xo" closed="false">10፡11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">ብያ. 29፡38</ref>።</char></note> <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ክርስቶሳ አደ አርጌቶ ካሌሮ ጃርሶ ኮ ስሰ አባባተረ ዋ ኦዶኮት መርጌይ ሀማጼራ። <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ሂታኮ ሆረንባን ዲናኬሳ ኦዶናትኬሳ ሄገሊ ታ ባርናኒ ኦራራ፤ <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>ህክና ካኮንሌራ ሀኑኡ ኦቁሎየራን ጃርሶ ኮኮክ ጋራነ ጅሩ ጅሮማን ዱዶኒዕ ማንኮየለሮ ማራንያ።<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>አያና ቁሉክ አደ ሂካ አየስ ኖን አቶታራ፤ ሆራርጀ፥<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>“ሀኑኡ አርጆልኮ አባባይረ</para>
  <para style="q1" vid="HEB 10:16">እሶነ ዎታ አን ኦታብናራ አማቶ ኦሃፉራ ህናኣያን አማራ ጎታ፤</para>
  <para style="q1" vid="HEB 10:16">ሴራኬ ዎዳናትሶይ ካይናራ፤</para>
  <para style="q2" vid="HEB 10:16">ሳሙትሶይና ጻፍናራ።”<verse eid="HEB 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HEB 10:17"/>አደና “ጩቦክሶና ኦሜላን ፈሎኦትሶ</para>
  <para style="q2" vid="HEB 10:17">ሂታኮ ሆረንባን አን ላኮሻድናሮ” አማራ።<note caller="-" style="x"><char style="xo" closed="false">10፡17 </char><char style="xt" closed="false"><ref loc="JER 31:34">ኤር. 31፡34</ref>።</char></note><verse eid="HEB 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18"/>ሃኑን ጩቦ ዱባ ሀሄሶ ካኮአማመ ጎራታ ጩቦ ሀሄሶ አማኖኮክ ጋራን ካስሳማራ ጃርሶ ሂታኮ ሆረንባን ላግሮ።<verse eid="HEB 10:18"/></para>
  <para style="s1">ዋ ቶስ ጋባላማኖ ካዶትሳሮ ላኖ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ጎርታኑ አቢላልቴ! ኢግ ካየሱሳኮክ ጋራነ ኣሎ ቁሉት ባንኤ ቶስ ታብን ካኮዳንደኖ ካአብድስሮ ሄላነና። <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ኖ ካኮታብናና ጎጎሎኬሳይያ፤ ሃ አማኖና ሶኦቴሳኮክ ጋራነ ኖን ካባነሮ ካኡሱብኪና አርዶክ ካሌሮ ራዲያ። <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ዳሩሪ ካግሮ ምን ካዋይ ጉት ኦዶናት ካአቦ ካንጂንክ ቱቃሞ አብና። <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ሃኑን ሳሙ ኦሮ ካማልሳማሮ ባስ ካሜላንኮ ጎጎሙጭምኖን ዎዳናታን ሙጭሳይነ፥ ማርካን በከ ኦሙጭሜኒ አልጉነ፥ ቱኩልት ዎዳናና ካሩም አማኖ አባይጉነ ዋ ቶስ ጋባላምኖ።<note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">ዎዩ. 8፡30</ref>፤ <ref loc="EZK 36:25">ሕዝ. 36፡25</ref>።</char></note> <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>ካአብዲ ሃፉራ ኖን ካስሰራ ካአብዳመ ማንኮሌ ማራን ግዳ አማንኔ ካአቶቲናኖ አብዲ ሀጋቶላ አንሌኖኒ አታይሳይ አባና። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ጌላንጄይና ፈሎ ኦኢዳኒ አታይጉነ ጎጎግርኖን ኮ ካካለ ሀአታይሶ፤ <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>አርጌቶ ራቶ ኢንሰ ኤሴላ እስእስኦሮ እስእስ አታይሳና ኳሬ ኮኮ ኩኩአማኖ ጎጎኢሰራን ማለ ኖ አድ ኩኩአማኖካን ላኮኢንሶ፤ ሃ ላናኮ ጎታ ካኮኤሜይናራ አሪ ጋባላማኖ ሻዳ ሂካ አየስ ኣሎ ፈላ።<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ሩም አዴንሰ ግራን አባባይነ ቦግ ማላባ ግራን ጩቦ ጎፈልነ ሂታኮ ሆረንባን ጩቦ ማራን ካስሳማራ ጃርሶ ኮና ላግሮ። <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ጎርታ ኖ ካኦታራ አደ ሆረንባን ካሊናራ ካአብስሳሮ ፍርዳና፥ ካኔባታራ ታጉባቶ ታአብስሶ ኤሌንታ።<note caller="-" style="x"><char style="xo" closed="false">10፡27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">ኢሳ. 26፡11</ref>።</char></note> <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ሴራ ካሙሴ ካባሰ ጉት እባዶ ላማ ጎርቱን ሴዶ ጎአቶቴ ሻጋ ካላይ ጎይን ሙርተሳማራ።<note caller="-" style="x"><char style="xo" closed="false">10፡28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">አዳ. 17፡6</ref>፤ <ref loc="DEU 1:15">1፡15</ref>።</char></note> <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ሀያ፥ ኤረ ካዋ ካቱፋተ፥ ካኮቁሎየሮ ካአማቶ ሃፉራኮክ ኢግ ካፋንቾይሳራና፥ ካስኖ አያና ካሀባራራ፥ ምስት ሂታኮ ታሮርተ ሙሮ አታይን ካዶትሳሮ ኣን ላራ!<note caller="-" style="x"><char style="xo" closed="false">10፡29 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ብያ. 24፡8</ref>።</char></note> <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>“ሀሎ ብያኖ ካኬያ፤ አን ታዶትሳቶ ሙራ ሙርናራ” ካአመራ ማዮዮ ኖ ካንሶዋ፤ ኡሱማለና፥ “ዋ ጎሳኬሳ ጉት ፍርድናራ” አማራ ጎታ።<note caller="-" style="x"><char style="xo" closed="false">10፡30 </char><char style="xt" closed="false"><ref loc="DEU 32:35-36">አዳ. 32፡35-36</ref>።</char></note> <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ሃኑን አርዶክ ዋኮት ገነ ኢያኖ ኣሎ ካአብስሳሮያ።<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>እፋ እስኑን ካኮሀንቃረ ጎራታ ራኮ ታሞጋን አታቴንዴን ታኮኦብስተቴን ሀሴ ታጣዎ አሪ ሻዳ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>አሪ ቶቶ እባዶ ሆረ ሀባራንቴታን፤ አቦሳንቴታን፤ ቶቶ ጎአንታን እስን ሂካ ኣንክክ አቦሳ ካኮጌሮ እባዶነ ዎታ ሳትላል ማንኮሌተታን ማራን ራኮ አታቴታን። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>እስን ታኢዳንትና ታጉዳኖን ዱሩማ ዳሩሪ ግራኖ ማንኮካሳን ማራን ኦሻሜራዉን ኮኮ ስሳ፤ ኡራዎኦትስና እስንኮ ካኮአታመሬን ጎራታ ኦብሲተዴን ገጌሎይ አታቴን። <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>ጎርታ፥ ካአቲ ባርኣራ ካኮሄላይናታን ካኮአብዳታን አሮሻፋቴን። <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>ፈኢ ታዋ ጉድሳዴን ዋ እስኑን ስስን ካአማቶ ሃፉራይ ካታበሮ ኮኮ አታይን ኦብሲ ኦራታኖ ዶትሳራ። <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>ኣላንትና ሃ አማመ ጻፋመራ፥፤</para>
  <para style="q1" vid="HEB 10:37">“ኤመይን ካግራ ኡሱ ጎራታ ክጫርኮ አባባይረ ኤመይናራ፤</para>
  <para style="q2" vid="HEB 10:37">ላኮአዳላይናሮ፤<verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>ካኬ ካሌራ ቁሉክ እባዶት አደ አማኖይ ግር ሄላይናራ፤</para>
  <para style="q2" vid="HEB 10:38">ሃር ጎጋለ አን ኡሱ</para>
  <para style="q2" vid="HEB 10:38">ላኮገጌላይናሮ።”<note caller="-" style="x"><char style="xo" closed="false">10፡38 </char><char style="xt" closed="false"><ref loc="HAB 2:3-4">እንባ. 2፡3-4</ref>።</char></note><verse eid="HEB 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39"/>ኖ ጎአመን አማኔረ ካፋያሮነ ዎታ ኡናና ኳሬ ሃር ጋለጉረ ካባሮ እባዶኮት ኡና ላኮኖ።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">አማኖኮክ ጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>አማኖ አማኖ አብዲ ካኦራማሮ ኮኮ፥ “እ ሩምና ሌሮዋ” አም አታታኖያ፤ ኢልኦ ካሙቶን ኮኮ ካሙታሮ ኣን የል አታታኖያ። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>ዋ ካሆርኮ እባዶን ካኮአቶቴራ አማኖኮክ ኣላንቲያ።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>አላም ሃፉራ ካዋይ መጣማኖ ካኮአዴሳና አማኖያ። ሃኑን ካሙታራ ኮኮ ዱባ ካሙቶንኮ ካፈላመሮ ላኖ ካንሶዋ።<note caller="-" style="x"><char style="xo" closed="false">11፡3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">መጣ 1፡1</ref>፤ <ref loc="PSA 33:9">ማዛ. 33፡9</ref>፤ <ref loc="JHN 1:3">ያን. 1፡3</ref>።</char></note><verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>ኣቤላ ካቃዬል ጃርሶኮ ካሮረ ጃርሶ ዋዉን ካስሰራ አማኖያ፤ ዋ ካኣቤል ጃርሶ ገጌሎይ ካኮአታታረ ጎራታ ኣቤላ አማኖኬሳ ቁሉክ ላኖ አቶታመ። ኣቤላ ጎጎየና አማኖኬሳኮክ ጋራነ ግዳና አዬሳማራ።<note caller="-" style="x"><char style="xo" closed="false">11፡4 </char><char style="xt" closed="false"><ref loc="GEN 4:10">መጣ 4፡10</ref>።</char></note><verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ሄኖካ ጎይ ኡሱ ጎጎጌኖንኮ ዳሩር ቶስ ካኮአታመራ አማኖይያ፤ ዋ ማንኮአታተሮ ማራን ላኮሙተ፤ አታማኖኮ ጣየ አደ ዋ ገገላይሳኖኬሳ አቶታመራ።<note caller="-" style="x"><char style="xo" closed="false">11፡5 </char><char style="xt" closed="false"><ref loc="GEN 5:24">መጣ 5፡24</ref>።</char></note> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>አማኖ ካላይ ዋ ገጌላይስን ላኮዳንዳማሮ፤ ዋ ቶስ ካጋባላማራ እባዶ ዋ ግራኖና ኡሱ ኦዶታታራዉን እላቦ ካስሳሮ ላኖ አማናታኖ ዶትሳራ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ኖሄ ጋና ኢልኦ ካሙቶን አየሱን ዋ ካኮሰርሰረ ጎራታ ኖሄ ዋ አብሳታ ካምነ እባዶኬሳ ሃሳይን ማርካፋ ካኮፈለራ አማኖየ፤ ኖሄና አማኖይ አላም ዱባ ጩባለሳ ላኖ ቱሰ፤ ኖሄና አማናኖይ ታሄላማቶ ቁሉማ ኤለ።<note caller="-" style="x"><char style="xo" closed="false">11፡7 </char><char style="xt" closed="false"><ref loc="GEN 6:22">መጣ 6፡22</ref>።</char></note><verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>አብራመ ብጉረ ርቲ የላይ ታአታይናሮ ባንኤ ጎጎሴሮን ካኮኡማመረ ጎራታ ኤትራ ሴይናሮ ኮና ሱረ ጎአዴስዋተና ሴይን ካኮአጃጃመራ አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">11፡8 </char><char style="xt" closed="false"><ref loc="GEN 12:5">መጣ 12፡5</ref>።</char></note> <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>ኡሱነ ዎታ ካአብዲ ሃፉራ ኦኤሌራን ይሳቃነና ያይቆባነ ዎታ ካአብዲ ኡል ማርት ሌ ዱንካኒ ካኮሀማጼረ አማኖይየ። <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>ሂካና ኡሱ ካኮየለራ ካጣባመ ኡኩም ታአብቶ፥ ዋ ታኤካሰሮና ታማዳረሮ ካታማ ኦራታ ማንኮግረ ማራንያ።<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>ሳራና ኤሰን አብድ ካስሰራ ዋ ካአብዳመ ላኖ ማንኮአዴሰተ ማራን ጃሮማኖኮ ካከይ ሱረ ኡሙልን ታዳንዴኖን ጎሌተና ፋቶ ካኮቶታቶ ሁና ካኮሄላቴታ አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">11፡11 </char><char style="xt" closed="false"><ref loc="GEN 18:14">መጣ 18፡14</ref>፤ <ref loc="GEN 21:2">21፡2</ref>።</char></note> <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ሃኑን ካጎየሮ እባዶ ኣን ካቶታመረ አብራመ ኮኮ ካዳሩረ ባራጃ ኣን ካሞጋተረና ታላቡ ግርዴ ጨካለ ኣን ታቶታሞን ሳኒ ሄላንቴ።<note caller="-" style="x"><char style="xo" closed="false">11፡12 </char><char style="xt" closed="false"><ref loc="GEN 15:5">መጣ 15፡5</ref>፤ <ref loc="GEN 22:17">22፡17</ref>፤ <ref loc="GEN 32:12">32፡12</ref>።</char></note><verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>ሂኒዕ ዱባ አማኖይ ጎጎግሬን ጎዬን፤ ዋ እሶን ስስን አማቶ ካታበረ አየስ ላኮአታቴን፤ አየሱን ጎአመን ኤባ ዴንጉሬን ካአታቴራን ኣን የላቴን ገጌሎይ አታቴን። ኡሊ ጉት ማርትና ኡሱ ኡልክ እባዶ ላናዋትክሶ ማላባቴን።<note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="GEN 33:4">መጣ 33፡4</ref>፤ <ref loc="1CH 29:15">1 ኦዱ 29፡15</ref>፤ <ref loc="PSA 39:12">ማዛ. 39፡12</ref>።</char></note> <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>ሂካማሌ ካአዬሳራ እባዶ ካክሶ ካሌሮ ኡል ካኦራታናን ላኖ አዴስሰ ቱሳራ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ሀሱ እሶ ኢሰን ካቤራን ኡል ካሻደራን ሌና ኤሰራ አባባይን ዳንዳረንዋ። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>ግዳ ጎአመን ሂካኮ ካሮረ ዳሩሪ ካግሮ ኡል ሀልቻራን፤ ሃኑን ዋ እሶን ካታማ ማንኮኤካሰሮ ማራን፥ “ሄዶክሶ” አማም ኡማምን እሶ ላኮሙላሮ።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>አብራመ ካኮጫፋመረ ጎራታ ይሳቃ ጃርሶ የለ ዋዉን ካኮስሰራ አማኖያ፤ ሀሱ ካአብዲ ሃፉራ ካአታተራ አብራመ ኤረኬሳ ኮ ጃርሶ የልንየ።<note caller="-" style="x"><char style="xo" closed="false">11፡17 </char><char style="xt" closed="false"><ref loc="GEN 22:14">መጣ 22፡14</ref>።</char></note> <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>ሀያ ዋ፥ “ሳኒታ ይሳቃይ ኡማምናታ” አመ ኡሱን ሰገረ።<note caller="-" style="x"><char style="xo" closed="false">11፡18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">መጣ 21፡12</ref>።</char></note><verse eid="HEB 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19"/>ዋ ጎይኮ ኬስን ካዳንዳሮ ላኖ አብራመ አማናኖይ ጎይኮ ካኬሮ ኣን ይሳቃ ካላም ሄላተ። <verse eid="HEB 11:19"/><verse number="20" style="v" sid="HEB 11:20"/>ይሳቃ ሆረንባን ካሊናሮ አየስ ሄደጉረ ያይቆባና ኤሳዉ ካኮሶማሳተራ አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">11፡20 </char><char style="xt" closed="false"><ref loc="GEN 27:29">መጣ 27፡29</ref>፥<ref loc="GEN 27:40">40</ref>።</char></note><verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያይቆባ ካኮጎይናራ ጎራታ ካኮጋባላማረ ጎራታ ካዮሰፍ ይስ መተመተይ እሶ ካኮሶማሳተራና ዳማኮት ብርጠ እስካተረ ካኮሳጋደረ አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">11፡21 </char><char style="xt" closed="false"><ref loc="GEN 47:31-48:20">መጣ 47፡31—48፡20</ref>።</char></note><verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ዮሴፋ ካኮጎይናራ ጎራታ ጋባላማ ካኮኤሜታረ ጎራታ ካእስራኤል እባዶ ግብጽኮ ጎጎብናራን ኡሱ ካአዬሰረ እሶ ለፋል ምስ የልን ዶትሳራን አጃጃ ካኮስሰራ አማኖይያ።<note caller="-" style="x"><char style="xo" closed="false">11፡22 </char><char style="xt" closed="false"><ref loc="GEN 50:5">መጣ 50፡5</ref>፤ <ref loc="EXO 13:1">ብያ. 13፡1</ref>።</char></note><verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ሙሴ ኦኡሙለራን ሙሴ ካኮአላታረ ጎራታ ምዲ ካእዳን ላኖ ማንኮአዴሰረን ማራን አጃጃ ካዎኖ ሀአብሳኖን ድግኒ ሴድ ካኮስያምሴረን አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">11፡23 </char><char style="xt" closed="false"><ref loc="EXO 2:2">ብያ. 2፡2</ref>፤ <ref loc="EXO 1:22">1፡22</ref>።</char></note><verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙሴና ካኮጂናታረ ጎራታ፥ “ኤረ ታፈርኦንኮክ ኤረ” አማም ኡማምን ፈኢ ስሳና ካኮዋተራ አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">11፡24 </char><char style="xt" closed="false"><ref loc="EXO 2:2">ብያ. 2፡2</ref>።</char></note> <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>ሃኑን ኡሱ ጩቦይ ኦሄላማራን ኦግዳኔ ገገሎኮ ሱረ ጎሳ ካዋኔ ዎታ ራኮ አታይን ዶታተ። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>ኡሱ ሆረንባን ታአታይናሮ ሙራ ማንኮዴሮ ማራን ኡራዎ ኦግብጽኮ ሱረ ክርስቶሳ ማራን የራታኖ ካሮራሮ ላኖ ኣሎ ቆፔ።<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>ኡሱና ኤንገ ታዎኖ ሀአብሳኖን ግብጽኮ ካኮቤራ አማኖያ፤ ኢልኦ ካሙቶን ሄዶና ካዴሮ ኣን ሌ ሀልቻኬሳይ ጣባተ።<note caller="-" style="x"><char style="xo" closed="false">11፡27 </char><char style="xt" closed="false"><ref loc="EXO 2:15">ብያ. 2፡15</ref>።</char></note> <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>ይስ ባርክ ላጋዲን ካአጃጃመረ ኤርግቻ ካእስራኤል ይስ ባርክ ጎጎ ጎኖንኮ አማ ሙሴ ካፋስካ ባላና ኢግ አራጫማኖኮክ ዎጋ ካኮፈለራ አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">11፡28 </char><char style="xt" closed="false"><ref loc="EXO 12:30">ብያ. 12፡30</ref>።</char></note><verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>ካእስራኤል እባዶ ኡል ካአንጋጌ ካሰሴተራን ኣን ሄላኒዕ በከኮ ጋማ ካኮናቄራን አማኖያ፤ ካግብጽ እባዶ አደ ሂካማሌ ሊን ካኮዶታረን ጎራታ እሶ ዱባ በከይ ኤነጋሜን።<note caller="-" style="x"><char style="xo" closed="false">11፡29 </char><char style="xt" closed="false"><ref loc="EXO 14:31">ብያ. 14፡31</ref>።</char></note><verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>ካእስራኤል እባዶ ታኢያርኮ ኣል ታግምበ አሪ ቶዶባ ማራሙረንጉሬን ካኢያርኮ ግምበ ካኮኤኤብሴራን አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">11፡30 </char><char style="xt" closed="false"><ref loc="JOS 6:21">ኢያ. 6፡21</ref>።</char></note> <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>ታሻርሙጣተ ረአብ ካሳላላሮ እባዶ ኖጎዳ ማንኮቆጳተቶ ማራን ኦአጃጃሞነ ዎታ ጎዋኖኮ ካኮሄሰታ አማኖይያ።<note caller="-" style="x"><char style="xo" closed="false">11፡31 </char><char style="xt" closed="false"><ref loc="JOS 2:21">ኢያ. 2፡21</ref>፤ <ref loc="JOS 6:25">6፡25</ref>።</char></note><verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ጎርታ ካካለ አን መ አምራ? ጌዶናኮት፥ ባራቅኮት፥ ሳምሶናኮት፥ ዮፍታሄኮት፥ ዳዉተኮት፥ ሳሜላኮትና ካሄገሮልኮት ማማኪን ጎራታ እን የራታራ።<note caller="-" style="x"><char style="xo" closed="false">11፡32 </char><char style="xt" closed="false"><ref loc="PRO 6:11-8:32">ማሱ. 6፡11—8፡32</ref>፤ <ref loc="PRO 4:6-5:21">4፡6—5፡21</ref>፤ <ref loc="PRO 13:2-16:31">13፡2—16፡31</ref>፤ <ref loc="PRO 11:1-12:7">11፡1—12፡7</ref>፤ <ref loc="1SA 1:1">1 ሳሜ. 1፡1</ref>፤ <ref loc="1KI 2:11">1 ዎኖ. 2፡11</ref>።</char></note> <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>እሶ አማኖ ዎኖላል አዎዴራን፤ ፍርዳ ካሩምቲ ጎሳ ባሪሴን፤ እሶን ታስሳንተቴ አብድ ሄላቴን፤ ታሉባን ህኢ ጩፌን፤<note caller="-" style="x"><char style="xo" closed="false">11፡33 </char><char style="xt" closed="false"><ref loc="DAN 6:27">ዳኔ. 6፡27</ref>።</char></note> <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>ካኤሌኔ ሁና ባሰን፤ ካኤነናን ሺፋኮ ሄሴን፤ ላፉማትሶኮ አታን ቶስ ኢግልሳሜን፤ ጀሬን ሻፋይን ኦአቲ ሌራን፤ እሶነ ዎታ ጀሬን ካሻፋታረ ዲናኮክ ዎታዳራል ሆሮረናን፤<note caller="-" style="x"><char style="xo" closed="false">11፡34 </char><char style="xt" closed="false"><ref loc="DAN 3:30">ዳኔ. 3፡30</ref>።</char></note> <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ሄሌልጆል ካጎየሮ ፋልክሶ ጎይኮ ኬ ግራን ዴ። ኩክና ሂካኮ ካሮረ ጎይኮ ክያኖ ሄላይን ሄዴንጉሬን ራኮ ታሞጋንክ አቦሳ አታቴን፤ ሂካ ኣንክክ ሻኖኮ ባልቹማ ብን ላኮዶታቴን።<note caller="-" style="x"><char style="xo" closed="false">11፡35 </char><char style="xt" closed="false"><ref loc="1KI 17:4">1 ዎኖ. 17፡4</ref>፤ <ref loc="2KI 2:4">2 ዎኖ. 2፡4</ref>።</char></note> <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>ኮኮ ካካለቱን ቃጭፋማኖ ሌን ቦጫሜን፥ ኩኒዕ አደን ታሉኬ ማርጮ ሽሻሜን ጉሬን ምን ካሻኖ ታቤን።<note caller="-" style="x"><char style="xo" closed="false">11፡36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1 ዎኖ. 22፡26-27</ref>፤ <ref loc="2CH 18:25-26">2 ኦዱ 18፡25-26</ref>፤ <ref loc="JER 20:2">ኤር. 20፡2</ref>፤ <ref loc="JER 37:15">37፡15</ref>።</char></note> <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ኤኤሞ ኤጋሜን፥ ማጋዚና ኤካ በልኤን፥ ሺፋይ ጎዬን፥ ታእዳድና ታኦሬን ጫላ ሳርሳቴንጉረን ካፋፌን፤ ህየሳልና ኡል ካእባዶ እባዶ ሌን አቦሳሜን፤<note caller="-" style="x"><char style="xo" closed="false">11፡37 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2 ኦዱ 24፡21</ref>።</char></note> <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ጋዲ፥ ዎዳሚ፥ ኡሊ ካግሮ ላጋጆልና ማዳል ማራሙረን። ሂካ ጋራይ አላም እሶን ካዶትሳሮ ላኮየ።<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ሂክ ዱባ አማኖክሶኮክ ጋራ ዋ ካአቶቴሮ ጎሌና እሶን ታስሳንቴቶ አብድ ጋና ላኮሄላቴራን። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ዋ ኖን ካእዳን ኮኮ ሀልቼራ፥ ሃኑን እሶ ኖኔ ዎታ ኳሬ ካለ ዱዶኒዕ ሊን ላኮዳንዳራን።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">ዋ ይስኬሳ ሙርሳራ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ዱማንቻ ኣን ኖ ማራሙረ ካአበሮ ሂካ ዱባ አቶጆል ኖ ማንኮአብኖ ማራን ስዳነ ኣን ኖን ካሌሮ አየስ ዱባ ኖ ጉት ካቁራናመሮ ጩቦ ባስጉነ ኖኮ ሆረነ ካግሮ ትያኖኮክ ለላማኖ ኦብሲ ቲኖ። <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ኖ ካኮንትያናና አማኖካን ካሀጋአበሮና ካጉድሰሮ የሱሳ ድያኖይያ፤ ኡሱ ሆረቴሳ ኦግራን ገገሎኮት ኣላንቲ ማስቃሊ ጉት ጎዋኖኮክ የራን ኮና አን ሀቶትኖኒ ታማስቃሊ ራኮና ጎይ ኦብሴ፤ መርጌ ታዋይና ኮርፍንጀ ሀማጼ።<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>ጎርታኑ አህፋኖንና አብድ አንጎሳኖን ሂካ ዱባ ኡሱ ኦኔባታሬን ጩባለሳል ኡሱ ኔባታ ግራን እሶ ካኦብሴሮ የሱሳ ዲያ። <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>እስን ጩቦ ዲዳኖይ እባዶ እስን ታላጋድሮ ጊን ላኮኔባቴተን። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ዋ እስን ይስኬሳ አን ሃ አማ ካጎርሳተረ ኢሎቴታን፤</para>
  <para style="q1" vid="HEB 12:5">“ኤረኬ! ሀድሳኖ ካጎታ አሮየራሰ፤</para>
  <para style="q2" vid="HEB 12:5">ኡሱ ኩ ካኮሙርሰ ጎራታና አብድ አሮጎሳተ፤<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>ጎታ ካጌላታሮኬሳ ሀድሳታራ፤</para>
  <para style="q2" vid="HEB 12:6">ኤረኬሳ ኣን የላተ ካድያታሮ ሙርሳታራ።”<note caller="-" style="x"><char style="xo" closed="false">12፡6 </char><char style="xt" closed="false"><ref loc="PRO 3:11-12">ማሱ. 3፡11-12</ref>።</char></note><verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>ዋ እስን ይስኬሳ ኣን ማንኮቶታታሮ ማራን ሙሮኦቴሳ ኦብሳ፤ ኦዶ ካሙርሳኖን ኤረ አዮያ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ይስ ካሌራ ዱባ ታአታታሮ ሙሮ እስና ጎአታኖን ኮስቻታን<note caller="+" style="f"><char style="fr" closed="false">12፡8 </char><char style="ft" closed="false">ኮስቻ አማኖ ኦዶ ካአዴሳሞን ኤረ አማኖያ። </char></note> ኳሬ ይስኬ ላኮታን። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ሂካኮ ካካለ ኖ ዱባ ካሙርሳሮ ካኡሙለሮ ኦዶላል አብና፥ ኖና እሶ ካባጃ ግኔ፤ ሀያ፥ ኔፎ ግርን ካአያና ኦዶካኑን ምሲ ኣሎ አጃጃማና ዋታና! <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>እሶ ኢዳነ ኣን ሌን እስኦትሶዉን ጎጎሙቴ ጎራታ ክጫሩን ኖ ሙርሰራን፥ ዋ አደ ቁሉማቴሳ ኦሄዴዳማኖ ጎጎሌኖን ላኦታኑን ኖ ሙርሳራ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ሙሮ ዱባ ካኮሙርሳማኖ አልማ ኦጋድስራንያን ኳሬ ኦገገላይሳራን ኣን ላኮላራን፤ ሃር አባባተረ አደ ሙሮ ካአጋልስሰራን እባዶን ኖጎዳ ታኮአማጋንተቶ ታቁሉማ ኢል ሄላምስሳራን።<verse eid="HEB 12:11"/></para>
  <para style="s1">ጎርሳና ሴርሳኖ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ሃኑን ኦሀርጋጨራን ገነኖኦትስና ኦሀረራን ግልቦኦትስን አታይሳዬን።<note caller="-" style="x"><char style="xo" closed="false">12፡12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">ኢሳ. 35፡3</ref>።</char></note> <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ካኤሳራ ጎጎፋይሮን ኳሬ ምክታኮ ጎጎሽርሞንኮ ሉቃኦትስኑን ራ ካእዳን ኤካሳየን።<note caller="-" style="x"><char style="xo" closed="false">12፡13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">ማሱ. 4፡26</ref>።</char></note><verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>ቁሉማ ካላይ ማዮና ጎታ ድን ማንኮዳንዴኖን ማራን እባዶ ዱባነ ዎታ ኖጎዳ ግርን ካዳንደተን ዱባ ፈላ፤ ቁሉማቴሳና ግርን አታዬን፤ <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>እስንኮ ማዮና ስኖ ታዋ ጎጎሀንቃኖንኮ እስኦራዬን፤ ኡሱማለና ኮና ታኦኮካቶ ኢል ካዱባምስራ አካክልተ እስን ኦሮ ጎጎአላኖንኮና እስን ጎጎጢቦንኮ ካሞጋና እስን ጎጎባቶይሶንኮ እስኦራዬን።<note caller="-" style="x"><char style="xo" closed="false">12፡15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">አዳ. 29፡18</ref>።</char></note> <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ካሻርሙጣሮ ጎርቱን ኮይክ ካአምናሮ ባቦን አመረ ባርክንተቴሳ ካዳዳለሮ ኤሳዉ ኣን ዋ ካአብሳኖን እባዶ እስን ኦርሮ ጎጎግኖንኮ እስኦራዬን።<note caller="-" style="x"><char style="xo" closed="false">12፡16 </char><char style="xt" closed="false"><ref loc="GEN 25:9-34">መጣ 25፡9-34</ref>።</char></note> <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ሃር አባባተረ ኤሳዉ ሶማ አታይን ካኮዶታሮ ጎራታ ሂኒዕ ሶማ ኡሱኮ ኦትራሜራን ካሳንዋ፤ ኦታ ሀኑኡ ሶማ አታይ ጎዶታተና ሱረ አታይን ላኮዳንዴ። ጩቦኮ ጉላ ጋልን ኢድሊ ሱረ ላኮሄላተ።<note caller="+" style="f"><char style="fr" closed="false">12፡17 </char><char style="fqa" closed="false">ሄልን ላኮዳንዴ፦ </char><char style="ft" closed="false">አማኖ ጩቦኮ ጉላ ጋልን ኢድሊ ላኮሄላተ አማኖያ። </char></note><note caller="-" style="x"><char style="xo" closed="false">12፡17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">መጣ 27፡30-40</ref>።</char></note><verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>እስን ገነ ካድናማሮ ጎርቱን ኤለኒ ታጉባቶ ታሲና ዎዳም ቶስ ላኮጌተታን፤ ኢዮቴ ቶስ፥ ሙጉድ ቶስ፥ ሁፎ ቶስና፥ <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ታጡሩንባ ያየ ጎርቱን ካሰጋማራ ሃፉራ ታኮማልሳማሮ ቶስ ላኮጌተታን፤ ሀሱ ሃፉራ ካማለራ እባዶ፥ “ሂታኮ ሆረንባን ካካለ ሃፉራ ኖን አሮሰጋሞ” አማ ታ ኤባራኒ ጌራን።<note caller="-" style="x"><char style="xo" closed="false">12፡19 </char><char style="xt" closed="false"><ref loc="EXO 19:16-22">ብያ. 19፡16-22</ref>፤ <ref loc="EXO 20:18-21">20፡18-21</ref>፤ <ref loc="DEU 4:11-12">አዳ. 4፡11-12</ref>፤ <ref loc="DEU 5:22-27">5፡22-27</ref>።</char></note><verse eid="HEB 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HEB 12:20"/>ኣላንቲና “ግድና ሱረ ዎዳም ጎዳዳረ</para>
  <para style="q2" vid="HEB 12:20">ኤኤሞይ ኤጋምረ ሀጎየ”</para>
  <para style="m" vid="HEB 12:20">ካአማራ አጃጃ እሶን ማንኮእስላተ ማራን ኦራይን ላኮዳንዴን።<note caller="-" style="x"><char style="xo" closed="false">12፡20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">ብያ. 19፡12-13</ref>።</char></note><verse eid="HEB 12:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="HEB 12:21"/>ኤሰ ካዴሮ አየስኮ ካከይ ሙሴ ሱረ</para>
  <para style="q1" vid="HEB 12:21">“አን አብሳየራ፥ ሀረኤዋ” አመ።<note caller="-" style="x"><char style="xo" closed="false">12፡21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">አዳ. 9፡19</ref>።</char></note><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>እስን ጎአመን ታጽዮን ዎዳም ቶስ ጋባላንቴታን። ኤሰና አርዶት ታዋ ካታማ ታሌተቶ ታዳሩረ ኢየሩሳለምታ፤ ገጌሎይ ካኩኩመሮ ካሞጋን ኩማይ ካቶታምሮ ኤርግቻል ቶስ ጋባላንቴታን። <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>መገክሶ ዳሩሪ ካኮንጻፋመሮ፥ ምን ካዋዉን ባርክ ኦሌራን አማኒልኮት ሀጋና፥ ዱባ ጉት ካፍርዳሮ ሄዶና ዱዶኒዕ ኦሌራን ቁሎሌኮት ኔፎል ቶስ ጋባላንቴታን። <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>አማቶ ኦኡሱቡን ጠኤ አሌ ካዎጋርሳሮ ካሌሮ የሱሳ ቶስ፥ ካኣቤላ ኢግኮ ካሮረ ካአዬሳሮና ካአራጫመሮ ኢግ ቶስ ጋባላንቴታን።<note caller="-" style="x"><char style="xo" closed="false">12፡24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">መጣ 4፡10</ref>።</char></note><verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>ሀሱ ካአዬሳሮ ኖ ላኮአታይናኖ ጎጎአሞንኮ እስኦትስን ኦራዬን፤ ሀኑኡ ዋ ጋራ እባዶነ ኡሉን ጎአዬስሮ ላኮማልናኖ ኦአመራን እሶ ጎሄሳናዋቴን፥ ሀያ ኖ ዳሩርኮ ካአዬሳሮ ጎአታታናዋኔ ምሲ ሄሲን ዳንዳና?<note caller="-" style="x"><char style="xo" closed="false">12፡25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">ብያ. 20፡22</ref>።</char></note> <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>ሀሱ ጎራታ ያየቴሳ ኡል አእሰቴ፤ ግዳ ጎአመን፥ “ኡል ካላል አሌኖን ግራን ኮይክ ዳሩርና አድረ አእስናራ” አመ አብድ ስሰራ።<note caller="-" style="x"><char style="xo" closed="false">12፡26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">ሃጌ 2፡6</ref>።</char></note> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>ሂክ፥ “ኮይክ አድረ” ካአማራ ሃፉራ ካቱሳራ ካአኢኖን ኮኮ ጣባይ ጎጎግሮን ካአአራ ጎርቱን ካመጣመራ ኮኮ ባኖያ።<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>ጎርታ ኖ ካአኢኖን ዎኖናት ማንኮኤልናኖ ማራን ዋ ጋላቲና፤ ኡሱ ታኮገገላይሶ ካባጃይና አብሲ ሀንዳይና። <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>ኣላንቲና ሄዶካን ታጉባቶ ኤለን አንያ።<note caller="-" style="x"><char style="xo" closed="false">12፡29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">አዳ. 4፡24</ref>።</char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ዋ ካገጌላይስሮ ሀንዳኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>አርጌቶ እስእስኦሮ ታአብላል ጌላንጀ እስኑን ሀግቴ፤ <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>ማርት ቆጳይዴን ማርትሳኖ አሮኢሎቴን፤ ሂካማሌ ማርት ቆጳታ እባዶ ኮኮ ሀአዴሶኒ ኤርግቻ ቆጳቴንጉሬን ማርትሴራን።<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">መጣ 18፡1-8</ref>፤ <ref loc="GEN 19:1-3">19፡1-3</ref>።</char></note> <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>እሶነ ዎታ ካሻንተታን ኣን ላዴን ምን ካሻኖይ ኦሻሜራን ሻዳ፤ እስና እሶ ኣን ራኮ ካአታታን ኣን ላዴን ራኮ ኦአታታራን ሻዳ።<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>እስአታታኖ እባዶ ዱባ ዶሌ ካካባጃመ ሀሌዎ፤ ኦላይማራና ኦሻርሙጣራን ዋ ማንኮፍርድናሮ ማራን ኦርና ኤንተርና እስእሲ አብዳታና ዋትኮ ካከይ እስአታታኖክስን አሮባቶይሳቴን።<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>ታማራጋደ ጌላንጀኮ ፋክማ፤ እስን ካአብታንዋ እስኑን ሀሌዎ፤ ዋ “አን ኩ ሱረ ላኮሻፍሮ፥ ዱዶ ኩ ላኮእስሮ” አመራ።<note caller="-" style="x"><char style="xo" closed="false">13፡5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">አዳ. 31፡6</ref>፥<ref loc="DEU 31:8">8</ref>፤ <ref loc="JOS 1:5">ኢያ. 1፡5</ref>።</char></note> <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>ሃኑን አብዲ፥</para>
  <para style="q1" vid="HEB 13:6">“ጎታ ካጋርጋራሮያ አን ላኮአብሳታሮ፤</para>
  <para style="q1" vid="HEB 13:6">እባዶ እን መ የልን ዳንዳራ?” አማና።<note caller="-" style="x"><char style="xo" closed="false">13፡6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">ማዛ. 118፡6</ref>።</char></note><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ሃፉራ ካዋ ሆራርጀ እስኑን ኦሰጌራን ምን ካዋይ ሆረሃዬን ኦገጌሳራን አሮኢሎቴን፤ ግርክሶና ፈሎኦትሶኮት ላኦ ሻዳ አማኖክሶ አባዬን። <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>የሱሳ ክርስቶሳ ከለና ህታር ጅሩ ጅሮማን ኡሱ ኡሱያ፤ ላኮኢግልሳማሮ። <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>ካአዴሳሞን ካሞጋን ማርት ካላሮ አጋልስስ አሮቦጃንተን፤ ዎዳናታን ካአሞ ዎጋ ኦራታኖ ሀሌኖን ግራን ስኖይ አታታኖ ካእዳንክያ፤ ሂካ ካባቦ ዎጋይ ዴበ ካሰሴታራ እባዶ ላኦ ቶና ላኮአታተሮ።<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>ኖ ባንኤ ታፋላ አብና፤ ጎሌና ዱንካኒ ኦሮ ኦሀንዳራን ቱቃሞል ህታ ባንኤ ታፋላ ካግሮ ባቦ ኣት ኣምን እሶን ፈኢ ላኮስሳማቶ። <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>አይሁድኮክ ካቱቃሞል ዎይቻ ጩቦኮ ሀሄሶ አማማኖ ካሄላምሳሮ ካግድ ኢግ አቤንጉረን ኣሎ ቁሉት ባንኤ ቶስ ታባራ፤ ኡሱ ግድኮኒዕ ሶ አደን ዱንካኒ ታታንኮ ሳር ቤሰረን ኤለኒ ጉባራን፤<note caller="-" style="x"><char style="xo" closed="false">13፡11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">ዎዩ. 16፡27</ref>።</char></note> <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ኡሱማለና የሱሳ ኢግኬሳይ ጎሳ ቁሎይሲን ካካታማ ካራኮ ሳሬ ራኮ አታተ ጎየ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ኖና ዱንካኒ ታታንኮ ሳር ብጉነ ኡሱ ቶስ ሴኖ፤ የራንኬሳና ኦአታታኖ ሌና። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ኖ ጋና ታኤሜይናቶ ካታማ ኦራታና ኳሬ አታይ ታግርናታ ካታማ ሂካ ኡሊ ኖን ላኮግቶ። <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>ጎርታኑ የሱሳ ክርስቶሳኮክ ጋራነ ካሶማ ጃርሶ አርጌቶ ዋዉን ስንሶ፤ ህክና መገኬሳ ማራን ኡሱን ታአቶታቶ ህኢ ካስሳማሮ ካሶማ ጃርሶያ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>አየስ ካእዳን ፈላኖና ካአብታንኮ ካካለቱን ስሳኖ አሮኢሎቴን፤ ዋ ካገጌላይሳራ ሂካ ኣንክክ ጃርሶያ።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>እስኑን ሆረሃዬን ኦፈላራዉን አጃጃማ፤ ኦዶናትክሶይ ሄገሊ ግራ፤ እሶ ካኮሆሳማራን ኦዶናት ማንኮአባን ማራን ግርክስን ማራን አታታራን፤ እስን እሶን ጎአጃጃንቴን እሶና ፈሎኦትሶ ገጌሎይ ፈልናራን፤ ጎርቱን እሶ ፈሎኦትሶ ቁቃማ ፈላራን፤ ህክና እስኑን ላኦ ካስስሮ ላኮዮ።<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>ኖን ኤባየን፤ ታሙጭንተ ባስ ታኮማልሳሞን ሳሙ ኖን ግራኖ አዴሳታና፤ ራ ዱባይ ታኢዳንት ያዳሊይ ግርን ሀልቻና፤ <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ሀሱኮና እስን አታይ ጎጎኤባታኑን አን እስን አታይሰ ካኤባታራ አን እስን ቶስ ሳም ጎጎአባባሮንያ።<verse eid="HEB 13:19"/></para>
  <para style="s1">ካጋቾ ኤብ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ካአቲ እዳድ ካፎፋሮ ጎታካን የሱሳ ጅሩ ጅሮማኮክ ካአማቶ ሃፉራኮክ ኢጊ ጎይኮ ካኬሰራ ካኖጎዳ ሄዶ፥ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>ፈኢቴሳ ፈሎ ሀይሲን ጎጎዳንዴታዉን አየስ ካእዳንክ ዱባ ኡሱ እስን ሀሙይሶ፤ ኖ ካገጌላይስሮ ጋራ ካየሱሳ ክርስቶሳነ ኖ ጉት ሀፈሎ፤ የሱሳ ክርስቶሳን ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮን ካባጃ ሀሌቶ፤ ሀሚኒዕ።<verse eid="HEB 13:21"/></para>
  <para style="s1">ጉድሳኖ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>አቢላልቴ! ሂክ አን እስኑን ካጻፈራ ሀንዳ ካጋባባን ማንኮሌሮ ማራን ሂካ ካጎርሳ ሃፉራ ኦብሲ ጎጎአታታዉን አታይሰ ኤባታራ። <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>አብካን ጢሞቶሳ ምን ካሻኖኮ ብያኖ እስን ጎጎአዴሳዉን ዶታራ፤ ኡሱ ሳም ሂታራ ካኮኤሜተ ጎራታ አን ኡሱነ ዎታ ኤመይረ እስን ድናራ።<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>ሆረሃዬን እስን ኦባሪሳራዉና ቁሎለ ዱባን ኖጎዳ ሰጋ፤ ካኢጣልያ ኡልኮ ኤመተን ህታኒ ኦግራን አማኒል ኖጎዳ እስኑን ፋራማራን።<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>ስኖ እስን ዱባነ ዎታ ሀሌቶ፤ ሀሚኒዕ።<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
