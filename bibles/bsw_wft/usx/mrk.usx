<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Bayso New Testament</book>
  <para style="h">ማርቆሳ</para>
  <para style="toc1">ማርቆሳ ካጻፈሮ ጎታካንክ ካየሱሳ ክርስቶሳ ዎንጋላ</para>
  <para style="toc2">ማርቆሳ</para>
  <para style="toc3">ማር.</para>
  <para style="mt1">ማርቆሳ ካጻፈሮ</para>
  <para style="mt2">ጎታካንክ ካየሱሳ ክርስቶሳ ዎንጋላ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ካማርቆሳ ዎንጋላ፥ “ሂክ ኤረ ካዋ የሱሳ ክርስቶሳኮክ ካገጌሎ ሃፉራ ካሆራርጄያ” አመ ሀጋአባራ፥ ሂካ ዎንጋላ ኦሮ የሱሳ ካፈሎና ኦዶናት ካአቦ እባዶት ሌ ኤመተራ፤ ኦዶናትኬሳና አጋልስስኬሳ፥ ዱርሳ ጉት ኡሱ ካአቦ ሁናና ጩቦ ካእባዶ ሀሄሶ አማኖይ አዴሳመራ። የሱሳ፥ “አን እባዶ ታጩቦ ድዩማኮ ባልቹማ ቤሳኖይ ኔፎቴ ዎዶ የላይ ስሳይን ካኤመየሮ ኤረ ካእባዶያ” አማ ኡሱ እሲ አዬሰራ።</para>
  <para style="ip">ማርቆሳ ጅርት ታየሱሳ ካኮአዬሰራ፥ ቱኩልና ሁና ካኮአማጋመሮ ራድ ጎሌሮ ኡሱ ኢል ካኮካየራ ካየሱሳ ሃፉራይና አጋልስስ ጉት አንሌኖን ግራን ኡሱ ኦፈለሮ ኦሳዳምራን ፈሎይ ጉቲየ። ካጣማቃሮ ጋራ ካያንሳኮት ጅርት፥ ካየሱሳ ጣማቃማኖኮክ ጋራና ጫፋማኖ ጋባቢና ታባኖ ስሰ አባባተረ ጻፍት ካየሱሳ አጋልስሳኖና ፋይሳኖኮክ ጋራ ሀንዳኖ ሰሰጋራ። ጎራታ ክጫርኮ አባባተረ የሱሳ ዴበ ኦሰሴታራን የሱሳ ኣሎ አዴሳ ታኮሴቴን የሱሳ ኦኔባታራና ኣሎ ኡሱ ዲዳ ሴተን። ካጋቾ ፎልሲጆል ግር ካየሱሳ ካጋቾ አልማይ ኦሮ ኦፈላመራን ፈሎይ፥ ካካለኮና ሱዋማኖኬሳና ጎይኮ ክያኖኬሳኮክ ጋራ ኦማማካራንያን።</para>
  <para style="ip">ካጋቾ ዎንጋላኬሳ ጉት ሆጎግ ታኮካመራ ባንኤ ላማ ኮኮ ካሆርኮ ማጻፋጆል ካላሊ ኦግራንያን።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ዎንጋላኮክ ሀጋአባማኖ <char style="ior"><ref loc="MRK 1:1-13">1፡1-13</ref> </char></para>
  <para style="io1">የሱሳ ካጋሊላ ኡሊ ሀንዳኖ ሀጋአባኖ <char style="ior"><ref loc="MRK 1:14-9:50">1፡14—9፡50</ref> </char></para>
  <para style="io1">ኢየሩሳለም ካታማይ ሀንዳኖ <char style="ior"><ref loc="MRK 10:1-52">10፡1-52</ref> </char></para>
  <para style="io1">ኢየሩሳለምና ጎቦብክሴይ ካጋቾ አልማይ <char style="ior"><ref loc="MRK 11:1-15:47">11፡1—15፡47</ref> </char></para>
  <para style="io1">ካጎታ ጎይኮ ክያኖ <char style="ior"><ref loc="MRK 16:1-8">16፡1-8</ref> </char></para>
  <para style="io1">ጎታኮክ ጎይኮ ክያኖና ኡሱኮ ኦአጋልሳታራዉን አድአድ ሙታኖና ዳሩር ቶስ ብያኖ <char style="ior"><ref loc="MRK 16:9-20">16፡9-20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">ካጣማቃሮ ያንሳኮክ ላላባኖ</para>
  <para style="r">(<ref loc="MRK 1:2-8">ማር. 1፡2-8</ref>፤ <ref loc="MAT 3:1-11">ማቶ. 3፡1-11</ref>፤ <ref loc="LUK 3:2-16">ሉቃ. 3፡2-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />ሂክ ኤረ ካዋ ካየሱሳ ክርስቶሳኮክ ዎንጋላ ካሆሬያ።<note caller="+" style="f"><char style="fr" closed="false">1፡1 </char><char style="ft" closed="false">ኮኮ ማጻፋጆል “ኤረ ካዋ” ካአማሮ ሃፉራ ላኮአዳሮ። </char></note> <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />ካሄገሮ እስያሳ፥ “ራ ካኤካስሮ ካሀንዳሮካኬ ኩኮ ጣይ አን ፋሮዋ አማመ ጻፋመራ።<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />“ህክና፤</para>
  <para style="q1" vid="MRK 1:3">‘ራ ካጎታ ኤካሳ፥</para>
  <para style="q2" vid="MRK 1:3">ሻካራ ኢድሳ አማ ጋድ ታኢያተ ያየ።’ ”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />ሃንሱን ካጣማቃረ ያንሳ ቃሉላቶክ ኡል ጣማቃና ጩቦኮ ሀሄሶ አማማኖን ጉላ ጋላኖኮክ ጥንቃታ ላላባ ኤመተ። <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />ይሁዳኮና ካኢየሩሳለም ማማን ዱባኮ እባዶ ራቶ ኡሱ ቶስ ሴተረ ጩቦክሶኮ ጉላ ጋላ ላጋ ዮርዳኖስ ገነ ታያንሳ ጣማቃመን።<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />ሳርስ ካያንሳ ኦጎሮ ኦጋላኮ ካፌላሜሮዬ፤ ሞኢና ጊ ሙዋታረ፥ ባቦከሳና ከንተፋሮና ማላብ ካጋዶየ። <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />ላላባኖኬሳና፥ “አን ሁስም ከፈሮኦቴሳኮክ ሻኖ ፉርን ካኮዳንደኖን እንኮ ካሮራራ እንኮ ሃሬ ኤመታራ። <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />አን እስን በከ ጣማቅናራ፥ ኡሱ ጎአመን አያና ቁሉክ ጣማቅናራ ካአማረያ።”<verse eid="MRK 1:8" /></para>
  <para style="s1">ካየሱሳ ጣማቃማኖና ጫፋማኖ</para>
  <para style="r">(<ref loc="MRK 1:9-13">ማር. 1፡9-13</ref>፤ <ref loc="MAT 3:13-17">ማቶ. 3፡13-17</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3፡21-22</ref>፤ <ref loc="LUK 4:1-13">4፡1-13</ref>፤ <ref loc="MAT 4:1-11">ማቶ. 4፡1-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />ኡሱ ጎራታ የሱሳ ታጋሊላ ካታማ ታሌተቶ ናዝረትኮ ኤመተረ ላጋ ካዮርዳኖስ ገነ ታያንሳ ጣማቃመ። <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />በከኮ ካኮብያረ ጎራታ ዳሩር ባናንተደ አያና ቁሉክ አራበ አን ኡሱ ጉት ዳጋ ግራን ዴ። <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />አን ካጌላታራ “ኤረክ አትታ ኩዬ ገጌላታራ ታአማተ ያየ ዳሩርኮ ማልሳንተ።”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />ጎርሰዋ አያና ቁሉክ ጋ ቶስ ኡሱ ቃጄልሰ። <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />ጻላዬና ጫፋማ አሪ አፋርታም ጋድ አዳላተ ሱላለነ ዎታ ግረ፥ ኤርግቻልና ኡሱን ሀንዳዬን።<verse eid="MRK 1:13" /></para>
  <para style="s1">ኦሆራርጄ የሱሳኮ ኦአጋልሳታሬንኮክ አሳባማኖ</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ. 4፡18-22</ref>፤ <ref loc="LUK 5:2-11">ሉቃ. 5፡2-11</ref>፤ <ref loc="JHN 1:35-42">ያን. 1፡35-42</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />ያንሳ ምን ካሻኖ ካኮታባረ ጎራታ የሱሳ ዎንጋላ ካዋ ላላባ ኡል ካጋሊላ ቶስ ሴተረ፥ <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />“ጎራታ ጌራ፤ ዎኖናት ካዋ ጋባላመራ፤ ጩቦኮ ጉላ ጋላ፤ ዎንጋላ አማና!” አማ ላላባ ግረ። <verse eid="MRK 1:15" /><verse number="16" style="v" sid="MRK 1:16" />የሱሳ ላቡ ታጋሊላ ኤነ ማረ ሮራ ስሞናና አቢኬሳ እንድራሳ ኩኑኡብ ኦአባታሬን ማንኮሌን ማራን፤ ማራብ በከ ሉጉዳታ ግራን ዴ። <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />የሱሳና “እን ዴበ ሰሴዬን፤ እባዶ ኦአብታን የልናራ” አመ። <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />እሶና ባኔዋ ማራብ ታትሶ ኢሰን ኡሱ ዴበ ሰሴተን።<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />ኤሰኮ አባራን ሽጲ ጎጎአመ፤ ካዛብዶሳ ኤረ ያይቆባና አቢኬሳ ያንሳ ዎላቦ ሀማጼሬን ማራብትሶ ኤካሳታ ግራን ዴጉረ፥ <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />ባኔዋ እሶ ኡመ፥ እሶና ኣቦክሶ ዛብዶሳና ማራጋደዉን ኦፈላሬነ ዎታ ዎላቦ ጉት ሉጉደን ኢሰን ኡሱ ዴበ ሰሴተን።<verse eid="MRK 1:20" /></para>
  <para style="s1">የሱሳ ባቲክ አያና ቤሰ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃ. 4፡31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />ኤሰኮና ካቅፍረናሆም ማማን ቶስ ሴተን፥ የሱሳ ባኔዋ አይሁድን ታፎልሲ አሪ አይሁድኮክ ምን ካኤብ ታበረ አጋልስሳኖ ሀጋአበ። <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />ሴራ ካሙሴ ኦአጋልስሳራን ኣን ሀሌኖን ግራን ኦዶናት ካአቦ ኣን አጋልስሳኖይ ጎሳና አጋልስሳኖኬሳ ሳደ።<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />ኡሱ ጎራታ አይሁድኮክ ምን ካኤብ ኦሮ ካግረ ባቲክ አያና ካኮግረ እባዶት ኮ ሃ አማ ኦኬ። <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“ካናዝረት የሱሳ፥ አት ኖኮ መ ዶታታ? ኖ ባስን ኤሜተታ? አት አዮቶ አን ኩ ካሶዋ፥ አት ካዋ ቁሉክታ።”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />የሱሳና፥ “ጫልኢ አምና፥ ኡሱኮና ቤና!” አመ ሀድሰ።<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />ባቲክ አያና እባዶት ኣሎ ኡለ ቦጬ አባባተረ ኤሰኮ እያ ቤ። <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />ጎሳ ዱባ ሳዳኖይ፥ “ሂክ አየስ መያ? ኦዶናት ካአቦ ካኡሱብ አጋልስሳኖ ላኖያ! ባቲክ አያናጆል ኡሱ ጎአጃጅሮ እሶና ብያራን!” አማ እስኦሮ እስእስ ሆሳተን።<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />ባኔዋ አታንኬሳ ጋሊላ ጎቦቢ ካግሮ ባንኤጆል ዱባ አዴሳመ።<verse eid="MRK 1:28" /></para>
  <para style="s1">የሱሳ ኦሞጋን ፋይሰ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8፡14-17</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4፡38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />ባኔዋ ምን ካኤብ ካአይሁድ ጎጎቤኒ፤ ያይቆባነ ያንሳነ ዎታ ምን ካስሞና ካእንድራሳ ታቤን። <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />ታስሞና ሶዶ ማር ካጉባሮ ሀዉኣም ሀዉኣማ ሁዱርተ ግቴ፤ ጋራክሴና የሱሳን ሰገን። <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />ሃንሱን ኡሱና ኤሰ ማንኮሁዱርተተ ቶስ ሴተረ ገነትሴ አበ ኬሰ፤ ማር ካጉባረና ኢሰ፤ ኬተጉደ ሀንዳኖ ሀጋአብተ።<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />አርት ካኮኢያተ ጎራታ፥ ሄመንክ ኡሊ እባዶ ማማንጆልኮ ካሀዉአማረና ጻላዬ ካአባመረ እባዶ ዱባ ኡሱ ቶስ ኬነ። <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />ካታማኮ ጎሳ ዱባ ምን ጎጫ ሆረ ኩኩ አመን ግረን <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />የሱሳ ካለካለክ ሀዉኣም ካሀዉአማረ ካሞጋን እባዶ ፋይሰ ዱርሳና ቤሰ፥ አየሱን ጎአመን ዱርሳና ካየሱሳ አዮናት ማንኮካሳናየ ማራን የሱሳ እሶ ጎጎአዬስራዉን ፈኢ ላኮስሰረ።<verse eid="MRK 1:34" /></para>
  <para style="s1">የሱሳ ካጋሊላ ማማንጆሊ ዎንጋላ ላላባኖ</para>
  <para style="r">(<ref loc="MRK 1:35-39">1፡35-39</ref>፤ <ref loc="LUK 4:42-44">ሉቃ. 4፡42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ባባርስ ቡላነ፥ የሱሳ ኬረ ምንኮ ቤ ባንኤ ካለት ቶስ ሴተረ ኤብ ሀጋአበ። <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />ስሞናና ኡናቴሳና ኡሱ ዶታ ዴበ ቤን። <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />ካኮሄላሬን ጎራታ፥ “እባዶ ዱባ ኩ ዶታራ” አመን።<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />የሱሳ፥ “ሂታኮ ኪጉነ ዶሌ ካግሮ ካካለ ማማንጆል ሴና ኤሴና ላላብና፥ አን ካኮንኤሜየራ ሂካኑንያ” አመ።<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />ሃንሱን አይሁድኮክ ምን ካኤብ ቶስ ታበረ ላላባና ዱርሳ ቤሳ ጋሊላ ዱባ ማራሙራኖ ሀጋአበ።<verse eid="MRK 1:39" /></para>
  <para style="s1">የሱሳ ባር ካአቦ እባዶት ፋይሰ</para>
  <para style="r">(<ref loc="MRK 1:40-45">ማር. 1፡40-45</ref>፤ <ref loc="MAT 8:2-4">ማቶ. 8፡2-4</ref>፤ <ref loc="LUK 5:12-14">ሉቃ. 5፡12-14</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />ማሪ ባር ካአባናየ እባዶት ኮ የሱሳ ቶስ ኤመተረ ሉክ ሄገሊ ግልቢሰረ፤ “ፈኢታ ጎሌተ እን ሙጭስን ዳንዳታ” አመ ኤባተ።<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />የሱሳና እባዶትን ነኔኤይሳተረ ገነ ድሪርሳተ አበረ “ፈኢ ስሰራ ሙጭምና” አመ። <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />እባዶት ባኔዋ ባርኮ ሙጭመ፥ ፋዬ። <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />የሱሳና እባዶትን አታይሰ ሰገረ ሃ አመ ጋልሰ። <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“ሂካ አየስ ማዮና ጎጎሰግኖንኮ እስ ኦራ፥ አየሱን ጎአመን ጎሳን አቶ ጎጎሌሮን ሴዴ እስኦታ ቱቃሞን ቱሳ፤ ሙጭ አማኖካዉን ሙሴ ጎጎአጃጄሮክ ማለ ጃርሶ ስስ” አመ።<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />እባዶት ጎአመን ማንኮሴተ ዱባ ካሌሮ አየስ ሰሰጋ ሰሴተ፥ ኦዱና ዳረኤ። ህታ ኣላንቲ የሱሳ ማምስት ካታማ አዴሳም ታብን ላኮዳንዴ፤ ሂካኮ ካከይ ካታማኮ ሳሬ እባዶ ታኮግኖን ባንኤ ግራኖ ሀጋአበ፤ እባዶ ጎአመን ባንኤ ባንኤኮ ኡሱ ማንኮግሮ ኤመታ ግረን።<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">የሱሳ ናፋለሳ ፋይሰ</para>
  <para style="r">(<ref loc="MRK 2:3-12">ማር. 2፡3-12</ref>፤ <ref loc="MAT 9:2-8">ማቶ. 9፡2-8</ref>፤ <ref loc="LUK 5:18-26">ሉቃ. 5፡18-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />የሱሳ አሪ ኡጫርኮ አባባተረ ታቅፍረናሆም ካታማ ቶስ ኤመተ፤ ኤሰነዋ ኡሱ ምን ታባኖ ጎሳ ማለ፤ <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />ሃንሱን ምን ላናዋተረ አዉንዳ ታኡኒዕሮ ጌግን እባዶ ካሞጋን ኩኩመ፥ ኡሱና ሃፉራ ካዋ እሶ አጋልስሳ ግረ። <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />ሀሱ ጎራታ እባዶ አፋሮ ናፋለሳክ እባዶት ስዴንጉሬን ኡሱ ቶስ ከነን <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />ጎሳ ሞጋንኮ ካከይ የሱሳ ቶስ ጋባሊን ምንኮ ዋተን ማራን ታምኔ ሄልንቾ የሱሳ ማንኮግሮነ ቡቶ ቤሰንጉሬን ናፋለሳት ታኮሁዱረረ አልጋነ ዎታ ዳግሰን። <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />የሱሳና አማኖክሶ ዴጉረ ናፋለሳትነ “አት ሂክ ኡኑ ጩቦ ካካ ሻጋ ሌራ!” አመ።<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />ኤሴና ሀማጼን ኦግረን ኮኮ ሴራ ካሙሴ ኦአጋልስሳረን ዎዳናትሶይ ሃ አመን ሄደን። <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“ሂክ እባዶት ምሲ ሃ አማራ? ሄዶ ጉት ሃፉራ ካሀባር ካሀባራራ! ዋ ኮ ኳሬ ጩቦ ሻጋ የልን ካዳንዳራ አዮያ?” አመን ቆፔን።<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />የሱሳና ባኔዋ ዎዳናትሶይ ካሄዳራን አያናኬሳይ አዴሰረ፤ “ምሲ ሃ ቆፓታን? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />ናፋለሳክ እባዶትነ ‘ጩቦካካ ሻጋ ሌራ’ አማኖኮና፥ ክንጉዴ አልጋታ ስዳዴ ጋል፥ አማኖኮ ኤክያ ኤነክ? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />አየሱን ጎአመን ኤረ ካእባዶ ኡል ጉት ጩቦ ሻጋ የልን ኦዶናት ካአቦ ላኖ ጎጎአዴሳዉን” አመረ ናፋለሳትነ፥ <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“ክንጉዴ አልጋታ ስዳዴ ምንካ ጋል” አመ።<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />ናፋለሳትና ጎርሰዋ ኬጉረ አልጋ ስዳተረ እባዶ ዱባ ዲያ ግራን ቤ። ሃንሱን እባዶ ሳደረ ሂካማለክ አየስ “ኖ ዱዶ ዴነ ላካንሶ አማ ዋ ጋላተን።”<verse eid="MRK 2:12" /></para>
  <para style="s1">ዎዩትኮክ ኡማማኖ</para>
  <para style="r">(<ref loc="MRK 2:14-17">ማር. 2፡14-17</ref>፤ <ref loc="MAT 9:9-13">ማቶ. 9፡9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5፡27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />የሱሳ ካላም ላቡ ታጋሊላ ቶስ ሴተ፥ ጎሳ ካሞጋን ኡሱ ቶስ ኤመተ፥ ኡሱና እሶ አጋልስሰ። <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />ኤሰነ ሮራ ግራን ካኢልፎሳ ኤረ ዎዩትና ቃራጣ ታኮአታራን ባንኤ ሀማጼ ግራን ዴረ፤ “እን ዴበ ሰሴ” አመ።<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />ካዎዩት ምኒ ባቦ ኣምን ሀማጼ ግራን፥ ኦሞጋን ቃራጣ ኦኩኩይሳሬነና፥ ጩባለሳልነ፥ ኡሱ ዴበ ሰሴታ ማንኮግሬን ማራን፥ የሱሳና ኡሱኮ ኦአጋልሳታረነ ዎታ ባቦ ኣማ ግረ። <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />ታፋራሳው ኡናኮ ኦሌረን ሴራ ካሙሴ ኦአጋልስሳረን የሱሳ ጩባሌሳልነና ቃራጣ ኦኩኩይሳራነ ዎታ ኣማ ግራን ካኮደያረን ጎራታ፤ ኡሱኮ ኦአጋልሳታራነ፥ “ቃራጣ ኦኩኩይሳራነና ጩባለሳጆልነ ዎታ ሙን ኣማራ?” አማ ሆሳተን።<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />የሱሳና እሶ ካአዬሰረን ማሌረ አኪም ካኮንዶትሳራ “ካሀዉአማሮን ኳሬ ፋያሌሳን ላኮዮ፤ አን ጩባለሳጆል ኳሬ ቁሎለ ኡምን ላኮኤሜየሮ” አመ።<verse eid="MRK 2:17" /></para>
  <para style="s1">አጋቡ ማራን ታሆሳንተቶ ሆሲን</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር. 2፡18-22</ref>፤ <ref loc="MAT 9:14-17">ማቶ. 9፡14-17</ref>፤ <ref loc="LUK 5:33-38">ሉቃ. 5፡33-38</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />ያንሳኮ ኦአጋልሳታራና እባዶ ካፋራሳዊ አጋቡዋ ግረን። እባዶ ኮኮ ኤመተጉረ የሱሳነ፤ “ያንሳኮ ኦአጋልሳታራና ፋራሳውልኮ ኦአጋልሳታራን ጎአጎቦይራን ኩኮ ኦአጋልሳታራን አጋቡዋና ካኮንዋታራን መዉንያ?” አመን።<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />የሱሳና፤ “ካማሻሸ ዎታ ግራንቲ ሳትላል አጋቡይን ዳንዳታ? ካማሻሸ እሶነ ዎታ ግራን አጋቡይን ላኮዳንዳራን አመ። <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />አየሱን ጎአመን ካማሻሸ እሶኮ ካኮአታምራ ጎራታ ኤመታራ፥ ኡሱ ጎራታ አጋቡይናዋ።<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“ካዶአን ሳርስ ጉት ታኡሱብት ኤርበ ካካታራ ማዮና ላግሮ፥ ሂክ ጎሌ አድ፤ ታኡሱብት ኤርበ ታዶአን ታታርሻታ፥ ፊላማኖና ኣሎ ባላኣይናራ። <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />አድ ካኡሱብ ካዎይኒ ጣሞ ካዶአን ድንቢቶ ካክባታራ ላግሮ፥ ሂካማሌ ጎሌ ካዎይኒ ጣሞ ድንቢቶ በረሳራ፥ ጣሞ ካዎይኒና ኡባታራ ድንቢቶና ላኦኮ ሳሪ ብያራ። ሃንሱን ካኡሱብክ ጣሞ ካዎይንዉን ካኡሱብክ ድንቢቶ ዶትሳራ።”<verse eid="MRK 2:22" /></para>
  <para style="s1">የሱሳ ታፎልሲ አርዉን ጎታያ</para>
  <para style="r">(<ref loc="MRK 2:23-28">ማር. 2፡23-28</ref>፤ <ref loc="MAT 12:1-8">ማቶ. 12፡1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6፡1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />ታፎልሲ አሪ የሱሳ እራ ኦሮማረ ሮራ ግረ፥ ኡሱኮ ኦአጋልሳታረን ሻዉዬ ኤብሳታኖ ሀጋአበን። <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />ፋራሳዊልና ታፎልሲ አርዉን ፈኢ ካስሳሞን ግቶ አየስ ኩኮ ኦአጋልሳታራን “ሙን ፈላራን?” አማ ሆሳተን።<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />የሱሳና አባበረ፥ “ዳዉተ ኡሱ ዴበ ኦሰሰታራነ ዎታ ካኮኡኤረና ካኮራካተረ ጎራታ መ የለሮ ላኮናባብቴታንያ? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />አብያታር ቱቃሞሉን ዎይቻ ሌ ካኮግረ ጌሲ ዳዉተ ምን ካዋ ታበረ ቱቃሞሉን ኳሬ ኦካለ ኣምን ፈኢ ካኮንስሳሞን ግሮ፥ ካቁሎየ ባቦ ካዋ ኣመ፥ ኡሱ ዎታ ካግረ እባዶና ስሰ።”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />አደና የሱሳ፥ “ታፎልሲ አሪ ኤረ ካእባዶቱን መጣንተታ ኳሬ እባዶ አሪ ታፎልሲዉን ላኮመጣመሮ አመ። <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />ሃንሱን ኤረ ካእባዶ ታፎልሲ አርዉን ጎታያ።”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">የሱሳ ገነ ካኮናፋተቴ እባዶት ፋይሰ</para>
  <para style="r">(<ref loc="MRK 3:1-6">ማር. 3፡1-6</ref>፤ <ref loc="MAT 12:9-14">ማቶ. 12፡9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6፡6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />የሱሳ ካላም አባባተ አይሁድኮክ ምን ካኤብ ቶስ ታበ፥ ኤሴና ገነ ካናፋተረ እባዶት ኮ ግረ። <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />ኣላንቲና የሱሳ ሞትን ካዶታረ እባዶ ታፎልሲ አሪ ጎፋይሳሮ ዴና፥ አመረን ኦራ ግረን። <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />የሱሳና ገነ ካናፋተረ እባዶትነ “ክንጉዴ እሶ ጠኤ አሊና” አመ። <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />ኤሰኮ አባባተረ “አፎ ታፎልሲ አርዉን ፈኢ ካኮስሳንተታ ታኢዳን ፈሊንያ ሙ ታሜላን ፈሊንያ? ኔፎ ፋይሳኖያ ሙ ባሳኖያ?” አመ እሶ ሆሳተ፥ እሶና አደነ ጫልኢ አመን። <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />የሱሳ ዎዳናትሶ ዱዳኖን ጋዴጉረ ኡሱ ማራሙረነ ኦአሌራን ኢኦነ ዴጉረ እባዶትነ፥ “ገነታ ድሪርሳ!” አመ፥ እባዶትና ገነ ድሪርሳተ ገነተሳና ዱዶ ፋይተ። <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />ጎርሰዋ እባዶ ካፋራሳው ቤጉረ ምስ የል የሱሳ ባስናራን ኡና ታሄሮዶሳነ ዎታ ማካረን።<verse eid="MRK 3:6" /></para>
  <para style="s1">እባዶ ካሞጋን የሱሳ ዴበ ሰሴተ</para>
  <para style="r">(<ref loc="MRK 3:7-12">ማር. 3፡7-12</ref>፤ <ref loc="MAT 12:15-16">ማቶ. 12፡15-16</ref>፤ <ref loc="LUK 6:17-19">ሉቃ. 6፡17-19</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />የሱሳ ኡሱኮ ኦአጋልሳታራነ ዎታ ታጋሊላ ላቡ ቶስ ዳገ፥ ጋሊላኮ ካኤመተራ ኣሎ ካሞጋን ጎሳ ዴበ ሰሴተ፥ <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />ኡሱ ካፈላሮ አየስ ካማለራ እባዶ ጋሊላኮ፥ ይሁዳኮ፥ ኢየሩሳለምኮ፥ ኤዶምያስኮ፥ ዮርዳኖስኮ ጋማ ካግሮ ማማንኮ፥ ኡሱማለና ታጢሮሳኮና ታስዶና ካታማልኮ ኡሱ ቶስ ኤመተን። <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />ኩኩካአመረ ጎሳ ጎጎኡኒዕኖንኮ ትጫርት ዎላቦ ኦይሬን ኡሱን ጎጎኤካስራኑን የሱሳ ኡሱኮ ኦአጋልሳታራኑን አጃጄ። <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />ካሞጋን እባዶ ፋይሰ ማንኮ ግረ ማራን፥ ኩባ ካራካታረ ዱባ ገነትሶይ ኡሱ ድንን ዶታታ ግረን። <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />ባቲክ አያናጆልና የሱሳ ካኮድያረን ጎራታ ሆረ እያ “አት ኤረ ካዋታ፥” አማ እያ ግረን።<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />የሱሳ ጎአመን አዮናትኬሳ እሶ በስ ጎጎአየሶንኮ አታይሰ ሀድሰ።<verse eid="MRK 3:12" /></para>
  <para style="s1">ኦፋራመራን ቶሞንኮ ላማኮክ አሳባማኖ</para>
  <para style="r">(<ref loc="MRK 3:16-19">ማር. 3፡16-19</ref>፤ <ref loc="MAT 10:2-4">ማቶ. 10፡2-4</ref>፤ <ref loc="LUK 6:14-16">ሉቃ. 6፡14-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />የሱሳ ዎዳም ቶስ ቤጉረ ኡሱ ኦዶተራ ኡሱ ቶስ ጎጎኤሜራዉን ኡመ፥ እሶና እሶነ ዎታ ኦግረን ኢሴንጉሬን ኡሱ ቶስ ኤመተን። <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />ኡሱነ ዎታ ጎጎግራዉና፥ ጎጎላላብናዉን ፋርን አመረ ቶሞንኮ ላማ ሹመ፥ ኦፋራመራን አመ እሶ ኡመ። <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />ዱርሳ ጎጎቤስናዉና ኦዶናት ስሰ።<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />ኦሹማሜራን ቶሞንኮ ላማና ህናኣያን፥ እሶና ጴጢሮሳ አመ ካኡመሮ ስሞና፥ <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />ቦአነረገስ ጎርቱን፥ ካድድዴና ይስ አመ መገ ካቤሰሮ ካዛብዶሳ ይስ ያይቆባ አቢኬሳ ያንሳ፥ <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />እንድራሳነ፥ ፍልጶሳነ፥ በርተሎሜዎሳነ፥ ማቶሳ፥ ቶማሳ፥ ካኢልፎሳ ኤረ፥ ያይቆባ፥ ታድዎሳ፥ ኡልኬሳ ካሀኡሳታሮ ስሞና፥ <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />ኡሱማለና የሱሳ ሮርሰ ካስሰሮ ካአስቆሮቱ ኡልኮክ ይሁዳ።<verse eid="MRK 3:19" /></para>
  <para style="s1">የሱሳና ዱርሳ ኮክ ዎይቻ</para>
  <para style="r">(<ref loc="MRK 3:20-27">ማር. 3፡20-27</ref>፤ <ref loc="MAT 12:25-29">ማቶ. 12፡25-29</ref>፤ <ref loc="LUK 11:17-22">ሉቃ. 11፡17-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />ኤሰኮና የሱሳ አባባተ ኡሱ ምን ቶስ ታበ፥ የሱሳና ኡሱኮ ኦአጋልሳታረነ ባቦ ኣምን ታዋናኒ ጎሳ አደ ሞጋተ ኩኩመ። <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />“የሱሳ ዎዳና ቆላመራ” አማማኖ ካማለራ ፋልኬሳ ኡሱ አታይሴዪን ኡሱ ማንኮግሮ ኤመተ።<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />ኢየሩሳለምኮ ኦኤሜተሬን ሴራ ካሙሴ ኦአጋልስሳረን፥ “ኡሱ ዱርሳኮክ ዎይቻ አባ! ዱርሳ ካኮቤሳራና ካዱርሳ ዎይቻያ” አመን።<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />የሱሳ ጎሳ እስ ቶስ ኡመጉረ ማሱሳ ሃ አመ፥ ጻላየ ጻላየ ምሲ ቤስን ዳንዳታ? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />ዎኖ ኮ እስእስ ኦሮ ካለካለ ጎቤ ሀሱ ዎኖናት አታይን ላኮዳንዳሮ። <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />ኡሱማለና ምንኮክ እባዶ እስእስኦሮ ካለካለ ጎቤ አራኣይ አልን ላኮዳንዳሮ። <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />ኡሱማሌ ጻላየ እስእስ ኦሮ እስካዲዳቶና ካለካለ ካበያቶ ጎሌተ ባታ ኳሬ አታይ አልን ላኮዳንዳቶ።<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />ሀሱኮ ካከይ እባዶት ኮ ጣይ ሁናሜሳክ እባዶት ሀንሺኖን ግራን ሁናሜሳ እባዶትኮክ ምን ታብረ ኡራዎ ሳሚን ላኮዳንዳሮ፥ ምንኬሳ ሳሚን ካኮዳንዳራ ሁናሜሳክ እባዶት ጎሺየ ካላልያ።<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“አን ሩምና አማራ፥ እባዶ ካፈላራ ጩቦና ካሀባራራ ሀባር ዱባ ሻጋ ሌሮዋ፥ <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />አየሱን ጎአመን አያና ቁሉክ ካሀባራራ ዱባ ጅሩ ጅሮማት አንዛ አባ ኳሬ ኡሱን ሀሄሶ ላኮአማምናሮ።” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />የሱሳ ሂካ ካኮን አዬሰራ “ባቲክ አያና አባ” ማንኮአሜን ማራንያ።<verse eid="MRK 3:30" /></para>
  <para style="s1">አዬ ታየሱሳና አቢላልቴሳ</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር. 3፡31-35</ref>፤ <ref loc="MAT 12:46-50">ማቶ. 12፡46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8፡19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />ኤሰኮ አባባተረ ኣየ ታየሱሳና አቢላልቴሳ ኡሱ ቶስ ኤመተን፥ ሳሬ አሌረነ እባዶ ኡሱ ቶስ ፋረን ኡምስሴን። <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />ኡሱ ማረአበ ካሀማጼሬ ካሞጋን እባዶና፥ “ህኒዕማ ኣየታና አብላልታና ሳሬ አሌነን ኩ ዶታራን አመን ኡሱን ሰገን።”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />ኡሱና፥ “ኣየትና አቢላልት አዮስያን?” አመ አባበ። <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />ኡሱ ማረአበ ካሃማጼረ እባዶ ቶስ ዲያ ሃ አመ “ኣየትና አቢላልት ህናኣያን! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />ፈኢ ታዋ ካፈላራ ዱባ ኡሱ አቢኬ፥ አባቴና፥ ኣየቴያን” አመ።<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">ካዉጣ ማሱሳኮት ፉሬን</para>
  <para style="r">(<ref loc="MRK 4:1-12">ማር. 4፡1-12</ref>፤ <ref loc="MAT 13:1-15">ማቶ. 13፡1-15</ref>፤ <ref loc="LUK 8:4-10">ሉቃ. 8፡4-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />የሱሳ ካካለ ጎራታ አደ ላቡ ግርድ አጋልስሳኖ ሀጋአበ። ኡሱ ካኮግረ ጎቦቢ ኣሎ ካሞጋን ጎሳ ማንኮኩኩአመሬ ማራን፥ በከ ኦሮ ታግቴ ዎላቦ ታበረ ሀማጼ፥ ጎሳ ዱባና ላቡ ግርድ ኩኩመ ግረ። <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />ኡሱና ካሞጋን አየስ ማሱሳ አጋልስሰ፥ አጋልስሳና ሃ አመ፥ <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“ማላ! ጎርታ፥ እባዶት ኮ ዉጣ ዉጣዪን ቤ። <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />ዉጣ ካኮዉጣታረ ጎራታ ኮኮ ራድ እዬ፥ ክምብር ኤመተረ አባባተ አመ። <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />ካካለ አደ ታኢዳን ኤሬ ማንኮግኖት ሻቁሞልት ባንኤ እዬ፥ ኤሬ ሻቁሞልት ማንኮሌተ ማራን ባኔዋ አላተ። <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />አርት ካኮብያተ ጎራታ አደ ቆረ፥ ህዲድ ሄገልድ ዳጋና ማንኮዋተ ማራን አንጋገ። <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />ካካለ ዉጣ አደ ኤኤን ጠኤ እዬ፥ ኤኤንና ዎታ ጂናተደ ካአላተረ ዉጣ ሁርተ ማንኮአብተተ ማራን ኢል ላኮየላተ። <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />ካካለ ዉጣ አደ ታኢዳንት ኤሬ ጉት ማንኮኢየ ማራን አላተ፥ ጂናተ፥ ኢልና ስሰ፥ ኮ ሶንዶም፥ ኮ ሎታም፥ ካካለና ኢል ቦል ዱባመ።” <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />አደና የሱሳ “ካማላራ ነበ ካአባ ሀማሎ!” አመ።<verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />ካለ ካኮሄሳረ ጎራታ፥ ዴበ ሰሴታ ካግረ እባዶና ቶሞንኮ ላማ ኦካለ ዎታ ኦግረን ማሱሳጆል ማራን ፉሬን ሆሳተን። <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />ኡሱና፥ “እስኑን ዎኖናት ካዋኮት ሆል ማላባኖ እስኑን፥ ስሳመራ፥ ሳሬ ኦግራዉን ጎአመን አየስ ዱባ ማሱሳ እሶን ሰጋምናራ። <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />ህክና ካኮንልናራ፥</para>
  <para style="q1" vid="MRK 4:12">“ ‘እሶና ዋ ቶስ አባባይኔነ</para>
  <para style="q2" vid="MRK 4:12">ጩቦክሶ ሀሄሶ ጎጎአማሞንኮ፤</para>
  <para style="q1" vid="MRK 4:12">ድያኖ ድያግራን ዎዳና ጎጎኮካኖንኮ፤</para>
  <para style="q2" vid="MRK 4:12">ማላኖ ማላ ግራን ላኮሻዳራን፥ ሂካኮ ካከይ ጩቦክሶ ሀሄሶ ላኮአማማሮ አመ።’ ”<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />ኤሰኮ የሱሳ ሃ አመ “እስን ህታ ማሱሳ ላኮአዴሰታንያ? ሀያ ካጋርማን ማሱሳጆል ምሲ አዴስን ዳንድናታን? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />ካዉጣራ ሃፉራ ካዋ ዉጣራ። <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />እባዶ ኮኮ ራድ ጉት ካኢየሮ ዉጣ ኣን ላራ፥ ሃፉራ ካኮማላን ጎራታ ጻላየ ባኔዋ ኤመተ ጉደ እሶ ኦሮ ካዉጣመሮ ሃፉራ አታታ። <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />አደና ካካለ ሻቁሞልት ባንኤ ካዉጣመሮ ዉጣ ኣን ላራን፥ ሃፉራ ካኮማላን ጎራታ ባኔዋ ገጌሎይ አታታራን። <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />አየሱን ጎአመን ህዲድ ሀዳግሶን ማንኮግረ ማራን ካአዳላታራና ጎራታ ክጫር ካላልያ፥ ሃፉራኮክ ኣላንቲ ራኮ ጎርቱን ሆሮራማኖ ካኮኤሜተ ጎራታ ባኔዋ ሀንዱዱፋታራን። <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />ካካለ አደ ኤኤን ኦሮ ካዉጣመሮ ዉጣ ኣን ላራን፥ ሃፉራ ማላኖ ማላራን፥ <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ሀሌዎ ኳሬ ሂካ አላም ኮክ ያዳ፥ ዱሩማኮት ጌላንጀና ካካለ አዳክ ሀልቻ ዎዳናትሶ ኦሮ ታበረ ሃፉራ ማንኮሁራሮ ማራንያ። <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />ካካለና ኤሬ ታኢዳኒ ጉት ካዉጣመሮ ዉጣ ኣን ላራን፥ እሶና ሃፉራ ማሌረን ኦኦራታራን ኮ ሶንዶም፤ ኮ ሎታም፤ ኮ እል ቦል፤ ኦዱባማራንያን።”<verse eid="MRK 4:20" /></para>
  <para style="s1">ካቦላንሶ ኢፋኮክ ማሱሳ</para>
  <para style="r">(<ref loc="MRK 4:21-25">ማር. 4፡21-25</ref>፤ <ref loc="LUK 8:16-18">ሉቃ. 8፡16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />የሱሳ “እስን ኢፋ ሀንቃይሳተደን ዳቾ ሄገሊ ጎርቱን አልጋኮ ሄገልሀይሳቴን ካታታን? ካኮካታን ቦላንሶ ጉት ላኮዮያ? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />ሃንሱን ካስያመ፥ ካንሙቶን፥ ካጎላተራ ኢፋ ቶስ ካንቤኖን ላግሮ። <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />ካማላራ ነበ ካአባ ሀማሎ!” አመ።<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />አደና የሱሳ ሃ አመ፤ “ካማላታን አየስ ማራን ኢስ ኦራዬን፥” ካኮኤካሳታን ሁይ አባባይ ኤካሳምናራ ኡሱማሌ ኡሱኮና ካሮረ እስኑን አዳምናራ። <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />ካአቦን አዳምናራ ካላይክኮ አድ ሀሱ ካግራ ክጫርክዋ አድ ኡሱኮ አታምናራ አመ።<verse eid="MRK 4:25" /></para>
  <para style="s1">ካዉጣ ጂናንኮክ ማሱሳ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />ኤሰኮና የሱሳ፥ “ዎኖናት ካዋ ሂካ ኣን ላራ፥ እባዶት ኮ ኤሬ ዉጣ ዉጣታራ። <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />እባዶትና ሄመን ሁዱራራ፥ አሪና ናባዳራ አየሱን ጎአመን ኡሱ ሀአዴሶን ግራን ኡሱ ዉጣ አላተ ጂናታራ፥ <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />ኤሬና እስኦትሴይ ሆራርጀ ቡል፥ ደቤና ጋቦ፥ ኤሰኮ ጋቦ ጉቲና ካጎሞራ ኢል የላታ። <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />ዉጣና ካኮዱባማሮ ጎራታ ካም ካኮኩኩአማሮ ጎራታ ማንኮሌ ማራን እባዶት ታጋዪን ባጫ ሳመ ኤካሳታራ” አመ።<verse eid="MRK 4:29" /></para>
  <para style="s1">ካስናፍጭ ዉጣኮት ማሱሳ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር. 4፡30-32</ref>፤ <ref loc="MAT 13:31-32">ማቶ. 13፡31-32</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13፡18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />አደና የሱሳ፥ “ዎኖናት ካዋ መነ ዎታ ሄረግንሳ? ምስክ ማሱሳ አዴስንሳ? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />ስናፍጭ ካአማማሮ ጋኮት ኢል ኣን ላታ፥ ኤሰ ኢል ዉጣማ ግራንቲ ኡል ጉት ካግሮ ዉጣኮ ትጫርትታ። <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />አላይደ ካኮጂናተ ጎራታ ታአካክልተ ባንኤ ካሙታሮ አላት ዱባኮ ሮራታ፥ ክምብርጆልና ካጂንጂን ባላልኮት ሆስ ሄገሊ ፎልሳታራ” አመ።<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />የሱሳ እባዶ አዴስን ካዳንዴሮ ጅልባክ ማለ ሂካማሌኒዕ ኦሞጋን ማሱሳጆል እሶን ሰገ። <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />አየስ ኮና ማሱሳ ካላይ ላኮአዬሳረ ኡሱና ኡሱኮ ኦአጋልሳታራን ኦላል ካኮለራን ጎራታ አደ አየስ ዱባና ካለካለ ቤሰ እሶን አዴስሰ ሰጋ ግረ።<verse eid="MRK 4:34" /></para>
  <para style="s1">የሱሳ ጋሽማሎ ጫልኢሰ</para>
  <para style="r">(<ref loc="MRK 4:35-41">ማር. 4፡35-41</ref>፤ <ref loc="MAT 8:18">ማቶ. 8፡18</ref>፥<ref loc="MAT 8:23-27">23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8፡22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />ኤሰ አሪ ኡል ሄመን ሌ ግራን የሱሳ ኡሱኮ ኦአጋልሳታራነ “በከኮ ጋማ ናቅና” አመ። <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />እሶና ጎሳ ኢሰረነ ዎላቦ ኦሮ ጎጎግሬን ኤሰነዋ የሱሳ ኣተን ሴተን፥ ካካለ ዎላቦልና ዎታ ግረ። <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />ኡሱ ጎራታ ካአቲ ኢርጋዶ ኬ፥ ጋሽማሎና በከ ዎላቦይ ታ አማጋምራን ሻላጋ ግረ። <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />የሱሳ አደ ቦርካኖ ቦርካተረ ዎላቦ ኦሮ ሁዱረ ግረ። እሶና ናባድሴረን፥ “ካአጋልስሳቶ! ኖ ጎጉዳኖ ኩ ላኮጢባሮያ?” አመን።<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />ኡሱና ናባደ ኬጉረ ኢርጋዶ ሀድሰ፥ በከና፥ “ጫልኢ አመን!” አንባልና ጫልኢንተ፥ ዱዶ ጫልኤት ሌተ። <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />የሱሳና፥ ኡሱኮ ኦአጋልሳታራነ፥ “መዉን ሃ አብሳተን? ምሲ አማኖ ዋታን?” አመ።<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />እሶና ኣሎ አብሳተን ጉረን እስእስ ኦሮ፥ “አፎ፥ ኢርጋዶና ጋሽማሎ ጫል ካኮንአማራን ሂክ አዮያ?” አመን።<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">ዱርሳ ካአባመረ እባዶትኮክ ፋያኖ</para>
  <para style="r">(<ref loc="MRK 5:1-17">ማር. 5፡1-17</ref>፤ <ref loc="MAT 8:28-34">ማቶ. 8፡28-34</ref>፤ <ref loc="LUK 8:26-37">ሉቃ. 8፡26-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />በከ ኦጋሊላኮ ጋማ ናቀረነ ገርገስኖን ካአማማረ ማማን ጌን። <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />የሱሳ ዎላቦኮ ጎጎዳጌ፥ ባቲክ አያና ካኮግረ እባዶት ታህዬል ባንኤኮ ቤረ ኡሱ ቶስ ኤመተ ኤሰለ። <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />ሂክ እባዶት ታህዬል ባንኤ ግረ፥ ማዮና ኡሱ ሳንሳላታይ ሺ ካይን ላኮዳንዴረ። <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />ጎራታ ካሞጋን ታሉኬ ማርጮና ሳንሳላታ ካገኔይ ሻማ ግረ። አየሱን ጎአመን ካገኔ ሳንሳላታ ጎጎሳና ታሉኬ ማርጮ ኤኤብሳ ግረ። ማዮና ኡሱ አብ አዳላይስን ካዳንዴራ ላኮግረ። <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />አርጌቶ አሪነ ሄመኔ ህየልና ዎዳም ጉት ማራሙራራ እያ ማርኬሳ ኤኤሞ ጎጎሳታ ግረ።<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />ሂክ እባዶት የሱሳ ኤባ ካኮደያረ ጎራታ ኡሱ ቶስ ትያ ኤመተ ሆረ ግልቢሰረ ሳጋደ። <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />ያየ ጦቂሰረ እያ፥ “አት ዱባንኮ ካአቲ ኤረ ካዋ የሱሳ፥ ኢነ ዎታ መ አብታ? ጎጎአቦስሶንኮ መገ ካዋይ አን ኩ ኤባታራ!” አመ። <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />እባዶትና ሂካ ካኮንአመረ፥ “አት ባቲክ አያና ሂካ እባዶትኮ ቤና!” አመ አጃጃ ስሰ ማንኮግረ ማራንያ።<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ኤሰኮና የሱሳ፥ “መገካ አዮያ?” አመ ኡሱ ሆሳተ። “ኦሞጋን ማንኮሌረን ማራን መገክና ሌጎንያ” አመ። <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />ኡልኮ እሶ ጎጎሆሮሮንኮ አታይሰ ኤባተ።<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />ኤሰ ባንኤ ዎዳም ላዩይ ታሞጋን ቦዬ ቦባይተ ግቴ። <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />ባቲክ አያናጆል የሱሳነ፥ “ቦዬል ቶስ ጎጎታብኖ ኖን ፈኢ ስስ” አመን ኤባተን። <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />የሱሳና ፈኢ ስሰ፥ ባቲክ አያናጆል ሀሱ እባዶትኮ ቤረን ቦዬል ታቤን፥ ኩማ ላማ ካሌራ ቦዬል ላጋ ህኢ መተጋማቶ ሄገልዴን ዳጌን በከ ኦሮ ልች አመን።<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />ቦዬል ኦፎፋሬና ባቃተን ሴተን፥ ማማንና ማማንኮ ቃማነ ካግሮ ኡል ኦዱ አዬሴን፥ ጎሳና ካሌሮ አየስ ድን ታኮግሮ ባንኤኮ ቤ። <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />ጎሳና የሱሳ ቶስ ኤመተጉረ ሀሱ ባቲክ አያና አባመረ ካግረ እባዶትኮ ሳሙ አባባተደ፥ ሳርስ ሳርሳተ ካሀማጼሮ ካኮድያረን ጎራታ ኔን። <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />ሂካ ጣየ ካዴራ እባዶ ባቲክ አያና ካኮባሬሮ እባዶትና ቦዬል ጉት ካሌሮ አየስ ዱባ ጎሳን ሰገን። <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />ሀሱ ጎራታ ጎሳ የሱሳ ኡልክሶኮ ጋፋር ጎጎቤሮ ኤባተን።<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />ኤሰኮና የሱሳ ዎላቦይ ካኮታባረ ጎራታ፥ ዱርሳ ካኮግረ እባዶት ዎታ ሴይን ኤባተ። <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />የሱሳ ኡሱን ፈኢ ላኮስሰ፥ አየሱን ጎአመን “ምንካ ሴዴ ጎታ ኤግታክ ካአት አየስ ኩን ፈለሮና ምሲ ሻጋ የለሮ ጎሳካዉን ሰጋ” አመ። <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />እባዶት ሴተረ፥ የሱሳ ካፈለሮ አየስ ዱባ ማማን ቶሞን ካአማማሮ ኡል ሰጋኖ ሀጋአበ፥ ካማለ ዱባ ሳደ።<verse eid="MRK 5:20" /></para>
  <para style="s1">ታጎተቴ ኡኑትና ኢግ ታኮኡባታረ ሄለልትቲ</para>
  <para style="r">(<ref loc="MRK 5:22-43">ማር. 5፡22-43</ref>፤ <ref loc="MAT 9:18-26">ማቶ. 9፡18-26</ref>፤ <ref loc="LUK 8:41-56">ሉቃ. 8፡41-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />የሱሳ አደ ካላም በከኮ ጋማ ዎላቦይ ካኮናቃረ ጎራታ ካሞጋን ጎሳ ኡሱ ቶስ ኩኩመ፥ ሀሱ ጎራታ ኡሱ ላቡ ግርዲ ግረ። <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />አይሁድኮክ ምን ካኤብዉን ዎይቻ ካለሮኮ ኮ እያኢሮስ ካአማማረ ኤሰራ ኤመተረ የሱሳ ካኮደያረ ጎራታ ሉቃ. ጉት ኢየረ፥ <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />“ትጫርት ኡኑት ጎይ ህኢ ግታ ፋይደ ኔፎነ ጎጎግርቶ ኤሜደ ገነታ ኤሰ ጉት ካይ” አማ አታይሰ ኤባተ።<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />የሱሳና ዎታ ሴተ ካሞጋን ጎሳና ኡሱ ማራሙረ ኡንኤ ዴበ ሰሴተን።<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />ጌስ ቶሞንኮ ላማ ኢግ ኡባታ ታኮግረ ሄለልትቲ ቶ ኤሰ ግቴ። <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />ኦሞጋን ኦዶ ዶብጆሉን ዶሌ ራካታ ታግቴ ካአብቶ ዱባ ጎጉሳተና፥ ኩባ ሀጋአታተ ኳሬ ላኮኢሰረ። <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />ኤሰና ጋራ ካየሱሳ ካኮማላተ ጎራታ ሃሬ እባዶ ኦሮማርተ ኤመተዴ ሳርስኬሳ ድንተ፥ <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />ኣላንቲና “ማምስ ልጉረ ሱረ ሳርስኬሳ ካላል ጎድነ ፋይናራ” ካአማሮ አማኖ አባናይተ።<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />ካኡባታረ ኢግ ባኔዋ አሌ፥ አቦሳኮ ሄሳኖ ማርክሰይ አዴሳመ። <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />የሱሳ ባኔዋ ሁና ኡሱኮ ብያኖ አዴሰረ፥ ጎሳ ቶስ ካምባል አመረ፥ “ሳርስኬ ካድነ አዮያ?” አመ።<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />ኡሱኮ ኦአጋልሳታረን፥ “ጎሳ ኡናኣመረ ካሻሻፋሮ ድያግራን፥ ‘አዮያ እን ካድነራ?’ ምሲአማታ?” አመን።<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />የሱሳ አደ ሂካ ካፈለራ አዮዮ ድን ሃር አባባተ ማራሙርሰ ዎቼ። <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />ሄለልትቲና ኤሰን መ ፈላመሮ ካኮአዴሳተ ጎራታ አብሳታና ሀርኣ ኤመተዴ ኡሱ ሆረ ኢተ ሩም ዱባና ሰጊተ። <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />የሱሳና፥ “ኡኑቴ አማኖካ ኩ ፋይሰራ ኖጎዳ ጋል፥ አቦሳካኮ ፎልሳ” አመ።<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />የሱሳ ሂካ አዬሳ ግራን፥ አይሁድኮክ ምን ካኤብዉን ዎይቻ ካሌሮ ካኢያኢሮስ ምንኮ ካኤመተረ እባዶ እያኢሮስነ “ኡኑታ ጎተታ፥ ጎራታ ካአጋልስሳሮ ሙን ሀርሳታ?” አመን።<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />የሱሳ አደ ሂካ ማለጉረ ዎይቻትነ አማና ኳሬ “አሮአብሳተ!” አመ። <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />የሱሳ ጴጢሮሳነ ያይቆባነ አደ ካያይቆባ አቢ ያንሳነ ኳሬ ማዮና ዴበ ጎጎሴሮ ፈኢ ላኮስሰ። <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />ምን ካዎይቻት ካኮግያረን ጎራታ የሱሳ እባዶ ዎ ዎ አማ ዩሩሩ አመ ኦታ ግራን ዴ። <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />ምን ቶስ ታበረ፥ “ሂክ ዱባ ኢያና ኦታን መታ? ኡኑና ሁዱርተታ ኳሬ ላኮጎተቶ” አመ።<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />እባዶ አደ ቃጭፋታ ኡሱን ኦሶለ። የሱሳ አደ እባዶ ዱባ ምንኮ ቤሰረ ኡኑኮክ ኦዶና ኣና ኡሱማሌ ኡሱ ዎታ ኦኤሜተሬን ኡሱኮ ኦአጋልሳታረን ዎታ ኡኑ ማንኮግቶ ቶስ ታበ። <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />ኤሰኮና ታኡኑ ገነ አበረ “ጣልታ ክ አሊ!” አመ። “ፉረንና፥ ተኡኑ ክ አማራ” አማኖያ።<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />ኡኑትና ባኔዋ ኬተ አልተ ሀሴራ ሂታራ ሰሴተ። ጌስክሰና ቶሞንኮ ላማየ። እባዶና ካሌሮ አዬሲ ኣሎ ሳደ። <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />የሱሳ አደ ሂካ አየስ ማዮና ጎጎአዴሶንኮ አታይሰ ሰጌጉረ፥ ኤሰ ካአንቶ ኮኮ ጎጎስስራዉን ሰገ።<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">ካሄገሮ ኡልኬሳ ላኮካባጃማሮ</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር. 6፡1-6</ref>፤ <ref loc="MAT 13:54-58">ማቶ. 13፡54-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4፡16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />የሱሳ ኤሰኮ ቤረ ኡልኬሳ ቶስ ኤመተ፥ ኡሱኮ ኦአጋልሳታረና ዴበ ሰሴተን። <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />ታፎልሲ አሪ አይሁድኮክ ምን ካኤብ አጋልስሳኖ ሀጋአበ፥ ካማለ እባዶ ካሞጋን ሳደ። እሶና ሃ አመን፥ “ሂክ እባዶት ሂካ አየስ ሀየኮ ሄለራ? ምስት ቃሩማታ ኡሱን ታስሳንተታ? ሂክ ባሳጆል ገነቴሳ ካኮፈላማራ ምሲያ?” አማ ሳዳ ግረን። <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />ደቤና “ሂክ አናጠት ካማይራመ ኤረ ላኮዮያ? ካያይቆባ፥ ካዮሳ፥ ካይሁዳና ካስሞና አቢ ላኮዮያ? አባላልቴሳና ህታኒ ኖኔ ዎታ ግራና?” ሂካኮ ካከይ ኡሱ ሀንዱዱፋተን።<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />የሱሳ አደ “ካሄገሮ ካኮካባጃሞን ኡልኬሳ፥ ፋልኬሳ ኦሮና ካምነ እባዶኬሳ ዶሌ ኳሬ” ሀካባጃሞን ላኮሄሳሮ አመ። <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />ኤሴና ኦሀዉአማሬን ኡጫሪ ጉት ገነ ካየረ ፋይሳኖ ኳሬ ማምስክ ባሳ ፈልን ላኮዳንዴ፥ <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />አማናታና ዋት ትሶይ ሳደ። ኤሰኮና የሱሳ ማማን ኦሮ ማራሙራ አጋልስሳ ግረ።<verse eid="MRK 6:6" /></para>
  <para style="s1">የሱሳ ኦፋራመራን ቶሞንኮ ላማ ፋረ</para>
  <para style="r">(<ref loc="MRK 6:7-11">ማር. 6፡7-11</ref>፤ <ref loc="MAT 10:5-15">ማቶ. 10፡5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9፡1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />ቶሞንኮ ላማ እስ ቶስ ኡመረ፥ ላማ ላማ የለ ፋረ፥ ባቲክ አያናጆል ጉት ኦዶናትና ስሰ። <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />“ራክስኑን ዳማ ኳሬ፥ ባቦ ጎርቱን ቃራጢት ጎርቱን አድ ማራጋደ ኪስይ አሮአባቴን፥ <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />ከፈሮ ታብሳዬን፥ አየሱን ጎአመን ቆሎ ላማ አሮአባቴን።” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />“ምን ኮ ቶስ ካኮታብቴን ጎራታ ኡሱ ማማንኮ ታበታን ኤሰ አዳላየን። <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />እባዶ እስን ታኮቆጳኖይና ታኮማሎን ባንኤ ዱባ ሉቃኦትስንክ ጎራ ሁርጉፋየንዴን ኤሰኮ ብያደን ሴዬን፥ ሂክ እሶን ሴርሳኖኮክ አቶ ልናራ” አመ ሂካ አጃጃ ስሰ።<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />እሶና ኤሰኮ ቤረን፥ እባዶ ጩቦኮ ጉላ ጎጎጋሎን ላላበን። <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />ካሞጋን ዱርሳ ቤሰን፥ ኦሞጋን ኦሀዉአማራን ጉት ዛይት ሽግዳ ፋይሰን።<verse eid="MRK 6:13" /></para>
  <para style="s1">ካጣማቃረ ያንሳኮክ ጎዋኖ</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር. 6፡14-29</ref>፤ <ref loc="MAT 14:1-12">ማቶ. 14፡1-12</ref>፤ <ref loc="MAT 6:14-16">6፡14-16</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9፡7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />ካየሱሳ መገ አዴሳማ ኤመታኖ ዎኖ ሄሮዶሳ ማለ። እባዶ ኮኮና “ሂካ ኣንክክ ባሳ ኡሱ ካፈላራ ካጣማቃረ ያንሳ ጎይኮ ኬራ” አማ ግረ። <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />ካካለና “ኤላሳያ” አመን። ኩኒዕ አደን፥ “ካጣዎ ካሄገሮልኮ ኮ ካሄገሮ አንያ” አማ ግረን።<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />ሄሮዶሳ አየስ ካኮማላረ ጎራታ አደ፥ “አን መተ ካኮጎስሰራ ያንሳ ጎይኮ ኬራ” አመ። <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />ሂክ ሄሮዶሳ ኡሱንዋ አቢኬሳት ታፍልጶሳ ኦር ሄሮድያዳ አታታኖኮት ኣላንቲ አባም ጎጎሻምሮን አጃጄረ ያንሳ ምን ካሻኖ ታብሰ። <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />ያንሳ ሄሮዶሳነ፥ “አቢካት ኦር ጎጎአታኖንኮ ሴራ ካሙሴ ትራራ” አመ ግረ።<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />ሄሮድያዳና ኤሰ ቁጠ አባተጉደ ያንሳ ላጋድስን ዶታ ግቴ፥ አየሱን ጎአመን ኤሰን ላኮኤካተ። <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />ሄሮዶሳ ሆራርጀ ያንሳ ቁሉክና ዋዉን ካአሳባመ እባዶት ላኖ ማንኮካሳናየ ማራን አብሳታና ኦራታ ግረ። ሄሮዶሳ ያንሳ ካአዬሳሮ ታኮማለ ቶቶይ አብሳታ ግረ፥ ሀሌዎ ኳሬ ገጌሎይ ማላ ግረ።<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />ሄሮዶሳ ታኮኡሙላመሮ አሪ ካባጃይን ምን ካዎኖይ ኦዶናት ኦአባን፥ ካጀረነ ሹምጆልና፥ ኮኮ ጋሊላይ አዴሳመ ካግሮ እባዶን ኣሞ ካአቲ ኤካሰ። <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />ታሄሮድያዳ ኤረ ባንኤ ታኣሞ ታብተደ ካኮማዳራተ ጎራታ ሄሮዶሳና ካኡማመሮ እባዶ ገጌላይሰ፥ ዎኖና ኡኑትነ፥ “አት ካዶታቶ ዱባ እን ሆሳ፤ አን ኩን ስስሮዋ” አመ። <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />አደና “ዎኖናትኬኮት ምና ጎሌተና፥ አት ካሆሳተ ዱባ ስስሮዋ!” አማ አማቶ ታበ።<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />ኤሰና ኣየትሰ ቶስ ሴተደ “መ ሆሳራ?” አንተ፥ ኣዎና “ካጣማቃሮ ካያንሳ መተ ስስ” አም ሆሳ አንተ።<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />ኡኑትና ጎርሰዋ ሳንተ ዎኖ ቶስ አባባተደ፥ “ካጣማቃሮ ካያንሳ መተ ግዳ ያላኣይ ካይደ ጎጎስሶ ዶታታራ” አንተ።<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />ዎኖና ሂካ አዬሲ ኣሎ ያደ፥ ሀሌዎ ኳሬ ታኡማንተቶ ማርት ሆረ ካታበሮ ካአማቶ ሃፉራ ኢሳግን ላኮዶተ። <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />ሃንሱን ዎታዳራ ኮ ሳመ ፋረረ፥ ካያንሳ መተ ጎስ ጎጎኬኖ ፋረ፥ ኡሱና ሴተረ ምን ካሻኖ ኦሮ ታበ መተ ካያንሳ ጎሰ፥ <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />ካጎሳመሮ መተ ያላኣይ ካየረ ኡኑቲን ስሰ፤ ኡኑትና ኣየትሴዉን ስሰ። <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />ያንሳኮ ኦአጋልሳታረን ሂካ ካኮማላረን ጎራታ ኤሜተነን፥ ሬስ ኣተን ቃማሌን።<verse eid="MRK 6:29" /></para>
  <para style="s1">የሱሳ ጎሳ ካሞጋን ኣምሰ</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር. 6፡30-44</ref>፤ <ref loc="MAT 14:13-21">ማቶ. 14፡13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፡10-17</ref>፤ <ref loc="JHN 6:1-14">ያን. 6፡1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />ኦፋራሜረና ማንኮሴተረንኮ የሱሳ ቶስ ኩኩሜረን ካፈለራና ካአጋልስሰራን ዱባ ኡሱን ሰገን። <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />ካሞጋን እባዶ ኤሜታና ሰታ ማንኮግረ ማራን ባቦና ኣምን ጎራታ ላኮግረ፥ “አላ እስን ካለት ባንኤ ቶ ቶስ ሴይዴነ አባራን ፎልሳዬን” አመ። <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />ሃንሱን ካለት ባንኤ ቶ ዎላቦይ ሴተን። <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />እሶና ሰታ ግራን እባዶ ካሞጋን ዴጉረ ማላበ፥ ማማንጆል ዱባኮ ትያ ኡሱኮ ሆረ ጌን።<verse eid="MRK 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 6:34" />የሱሳ ዎላቦኮ ካኮዳጋረ ጎራታ ጎሳ ካሞጋን ካኩኩመሮ ዴ፥ ካፎፍሮ ካላይክ እዳድ አን ማንኮግረ ማራን ያደ፥ ካሞጋን አየስ አጋልስሳኖ ሀጋአበ። <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />ኡሱ ጎራታ ኡል ሄመንላ ካኮሰታረ ጎራታ ኡሱኮ ኦአጋልሳታረን ኡሱ ቶስ ጋባላሜረን፥ “ህት ባንኤ ቃሉላቶታ፥ ኡል ሄመን ሌራ። <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />እባዶ ካኮግሮ ማማን ቶስ ሴይጉረ ካአምራን ኮኮ ኢምናይ ጎጎእምናራዉን ጎሳ ጋፋርና” አመን።<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />የሱሳ አደ “ካአምራን እስንዋ ስሳ” አመ አባበ። እሶና፥ “ሴይነ እሶ ካአምራን ላማ ቦሌ ጣጋራይ ባቦ እምንኔ እሶን ስንሱ?” አመን።<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ኡሱና፥ “ባቦ ምያ አብታን? አላ ሰዬንዴነ ዲያ” አመ። ዴንጉሬን፥ ባቦ ከና ኩኑኡብ ላማና ግሮዋ አመን።<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />ኤሰኮና ጎሳ ኤስ ጫሬ ጉት ኡና ኡና ጎጎሀማጽሮን አጃጄ። <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />ጎሳና ቦል ቦል ኮንቶም ኮንቶም ኡና ኡና ሀማጼ። <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />የሱሳ ባቦ ከና ኩኑኡብ ላማና አበረ ዳሩሪ ቶስ ዲያ ሶማሳተ፥ ባቦና ኤካኤብሰ ኡሱኮ ኦአጋልሳታራዉን ስሰ፤ ኡሱማለና ኩኑኡብ ላማና ዱባዉን ሄደደ። <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />ዱባና ባቦ አመን ባራረን። <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ኡሱኮ ኦአጋልሳታረና ካአማመሮ ባቦኮና ኩኑኡብኮ ታሄሰቶ ሀንባ ዱጉድ ቶሞንኮ ላማ ምግ ኬሴን። <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />ባቦ ካኣመረ ባባር ኩማ ከንየ።<verse eid="MRK 6:44" /></para>
  <para style="s1">የሱሳ በከ ጉት ሰሴተ</para>
  <para style="r">(<ref loc="MRK 6:45-51">ማር. 6፡45-51</ref>፤ <ref loc="MAT 14:22-32">ማቶ. 14፡22-32</ref>፤ <ref loc="JHN 6:15-21">ያን. 6፡15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />ባኔዋ የሱሳ ጎሳ ጋፋራ ግራን ኡሱኮ ኦአጋልሳታረን ቤተሳይዳ ቶስ ሆረ ጣይ ዎላቦ ጎጎናቅራኑ አጃጄ፥ <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />ኤሰኮ አባባተረን እሶኮ ካለቤረ ኤባይን ዎዳም ቶስ ቤ። <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />ኡል ሄመን ካኮላረ ጎራታ ዎላቦ ባድ ጠኤ ግቴ፥ የሱሳ ካለ ባጋ ግረ። <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />አንባልና አታተ ፎፎል ክያ ማንኮግቴ ማራን፥ ኡሱኮ ኦአጋልሳታረን ዱዳታ ፈርፈራትሶነ ዎታ ሞአባታ ግራን ዴ፥ ሄመንኮ ሳቲ ሳጋልኮ ታ ቶሞንኮ ላማ ሳቲ ጌሮ ካግሮ ጎራታ ኦሮ በከ ጉት ሰሴታ እሶ ቶስ ኤመተ እሶ ዶልማር እስ ሮርን ዶተረ፥ <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />አየሱን ጎአመን በከ ጉት ሰሴታ ግራን ካኮደያረን ጎራታ ጋር ኣን ሌ ካኮሙታረ ጎራታ እዬን። <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />ዱባና ኡሱ ካኮድያረን ጎራታ ኔን።</para>
  <para style="p" vid="MRK 6:50">የሱሳ አደ ባኔዋ፥ “አላማንደ! አንዋያ አሮአብሳቴን!” አመ።<verse eid="MRK 6:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 6:51" />ኡሱና ዎላቦ ጉት ኮራተረ እሶነ ዎታ ሀማጼ፥ አንባልና ኢሰ፥ ኡሱኮ ኦአጋልሳታረና ኣሎ ሳደን። <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ባቦ ጉት ካፈላመሮ ባሳና ላኮሻደረን ዎዳናትሶ አታኒ ዱደ ግቴ።<verse eid="MRK 6:52" /></para>
  <para style="s1">የሱሳ ታገንሳረጢ ካታማይ ካሀዉአማረ እባዶ ጎጎፋይሰሮ</para>
  <para style="r">(<ref loc="MRK 6:53-56">ማር. 6፡53-56</ref>፤ <ref loc="MAT 14:34-36">ማቶ. 14፡34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />በከኮ ጋማ ካኮናቃሬን ጎራታ ታገንሳረጢ ካታማ ቶስ ገገን ዎላቦና ባጋ ቶስ ጋባሌነ ሺዬን። <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />ባኔዋ ዎላቦኮ ጎጎዳገኒ ጎሳ የሱሳ ማላበ። <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />እሶና ኡሱ ጎቦቢ ዱባ ትትዬንጉሬን ኩባሌሳል አልጋይ ስዴን ኡሱ ማንኮግሮ ባንኤ ዱባ ቶስ ኬና ግረን። <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />ኡሱ ካኮጌ ማማን ጎርቱን ካታማ፥ ካታማኮ ቃማ ዱባ ካሀዉአማሮ ራራዲ ካና ሳርስኮት ሻርፍ ድኒን ኤባታ ግረን፤ ኡሱ ካድነ ዱባና ፋያ ግረ።<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">የሱሳ ካሳረ አይሁድኮክ ሴራ ዲደ</para>
  <para style="r">(<ref loc="MRK 7:1-23">ማር. 7፡1-23</ref>፤ <ref loc="MAT 15:1-9">ማቶ. 15፡1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />ፋራሳዊልና ኢየሩሳለምኮ ካኤመተረ ኮኮ ሴራ ካሙሴ ካአጋልስሳረ የሱሳ ቶስ ኤሜተንጉረን ማራሙረን ኩኩመን። <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />ኡሱኮ ኦአጋልሳታረን ኮኮ ታኣሎን ግራን ገነ ጎርቱን ታባቶይቴ ገነ ባቦ አማ ግራን ዴን።<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />ፋራሳዊልና አይሁድ ዱባ ኦዶላልክሶክ ዎጋ ኦራይን አማ፥ ሴራ ማለ ገነኖ ኢድሳይ ሀኣሎን ላኮአማሬን። <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />ግያኮ ጎጋማራን ኣል እስኦትሶ ጎሙጭሳተን ኳሬ ላኮአማሬን። ኡሱማሌ ቁልዱቦ፥ ኡላ፥ ፍልኤና፥ አልጋ አልሳኖ አን ካካለ ሴራ ኦራታ ግረን።<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />ፋራሳዊልና ሴራ ካሙሴ ኦአጋልስሳራን የሱሳነ፥ “ኩኮ ኦአጋልሳታራን ኦታ ሰራ ካኦዶላል ካግራን ኢሴንጉሬን ታኣሎን ግራን ገነ ሙን ባቦ አማራን?” አመን ሆሳቴን።<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />የሱሳና፥ “ካሄገሮ እስያሳ እስን ኢፍሳዶሌኮክ ጋራ ‘ልክ ሄገሮ አዬሰራ፤ ጋራክሶና ሃ አማመ ጻፋመራ፤</para>
  <para style="q1" vid="MRK 7:6">“ ‘ሂክ ጎሳ ህኢ እን ካባጃራ ዎዳናትሶ አደ እንኮ ታፋክንተታ!<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />አዳ. ሳጋዳራን፥ አጋልስሳኖክሶና እባዶ ካፈላሮ ሴራ ካላልኮያ።’<verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />አጃጃ ካዋ ኢሰዴነ ዎጋ ካእባዶ አታይሳታን።”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />አደ ሃ አመ “ዎጋካክስን ኦራይን አንተዴነ አጃጃ ካዋ ካኮኢሳታን ማላ አብታን። <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />ሙሴ ‘ኣቦካና ኣየታ ካባጂና፥ ኣቦኬሳ ጎርቱን ኣየቴሳ ካሀባራራ ዱዶ ሀጎዎ’ አመ ግረ። <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />እስን አዴን እባዶት ኮ ኣቦኬሳ ጎርቱን ኣየቴሳ ጋርጋራኖ እስረ ሂክ ‘ቁርባን አማኖና አን ዋዉን ካስሰሮ እላቦያ’ ጎአመ፥ <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />እስን ሂክ እባዶት ኣቦኬሳ ሌረ ኣየቴሳ ጎጎጋርጋርኖንኮ የላታን። <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />ሃንሱን አላታኑን ካሮርሳታን ዎጋን ሃፉራ ካዋ ኢግልሳታን፥ ሂካ ኣንክክ ካሞጋን አየንሳ ፈላታን።”<verse eid="MRK 7:13" /></para>
  <para style="s1">እባዶ ካባቶይሳሮ አየስ</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር. 7፡14-23</ref>፤ <ref loc="MAT 15:10-20">ማቶ. 15፡10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />አደና የሱሳ ጎሳ እስ ቶስ ኡመረ ሃ አመ፥ “ዱባና እን ማላ፥ ሻዳ፥ <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />ሳርኮ ኦርዴ ታበረ እባዶ ካባቶይሳራ አየስ ኮና ላግሮ፥ ሂካኮ እባዶ ካባቶይሳራ እስኦቴሳኮ ሳርዴ ካብያሮ አዬስያ። <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />ጎርታ ካማላራ ነበ ካአባ ሀማሎ!” አመ።<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />የሱሳ ጎሳ ኢሰረ ምን ካኮታባረ ጎራታ ኡሱኮ ኦአጋልሳታረን ማሱሳኮክ ጋራ ሆሳተን። <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />ኡሱና፥ “እስኑን አየስ ላኮታባሮያ?” ሳርኮ እባዶ ቶስ ታበረ ባቶይስን ካዳንዳራ አየስ ኮና ላግሮ፥ <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />ዎዳና ቶስ ሀሌኖን ቦግ ቶስ ታባራ፥ ኤሰኮና ማርኮ ብያራ፥ የሱሳ ሂካ አመ አባባተረ ባቦ ዱባ ካእዳንክ ላኖ አዴስሰ።<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />ደቤና ሃ አመ፥ “እባዶኮ ካብያራ ሀሱ እባዶ ባቶይሳራ። <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />ዎዳና ታእባዶ ኦሮኮ ካብያራ ካሜላን ያዳ፥ ሄታኖ፥ እባዶ ላጋዳኖ፥ ሻርሙጣኖ፥ <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ላይማኖ፥ ጋጲጋጳኖ ሜላነ፥ ሶባኖ፥ ራራጋታኖ፥ ቃናታኖ፥ መገ ባሳኖ፥ ኮራ፥ ላፉማያን። <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />ሂክ ካሜላን አየስ ዱባ እባዶኮ ብያራ እባዶና ባቶይሳራ።”<verse eid="MRK 7:23" /></para>
  <para style="s1">ታስሮፍንቃ ሄለልትቲኮክ አማኖ</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር. 7፡24-30</ref>፤ <ref loc="MAT 15:21-28">ማቶ. 15፡21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />የሱሳ ኤሰኮ ኬረ ታጢሮሳ ካታማ ዶሌ ካግሮ ማማን ሴተ፥ ምን ኮ ቶስ ታበረ ኡሱ ኤሰ ግራኖ ማዮና ጎጎአዴሶንኮ ዶተ፥ ጎሌና ኤሴና ስያም ግርን ላኮዳንዴ። <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />ጎርሰዋ አደ ኡኑ ትጫርት ባቲክ አያና ታኮን አባንተተ ሄለልትቲ ቶ ጋራ ካየሱሳ ማልተ ኤመተዴ ሉክ ጉት ኢተ። <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />ሄለልትቲና ኡል ካግሪክትተ፥ አላታንትሰና ኡል ካስሮፍንቃኮትተ፥ ኤሰና የሱሳ ዱርሳ ኡኑኮ ጎጎቤስሮን ኤባተ። <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />ኡሱ አደ፥ “ካይስ ባቦ ኣትጉረን ከሮሩን ስስን ላኮዶትሳሮ፥ ሆራርጀ ይሳስ ባራር ሀኣሞ” አመ።<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />ኤሰና አባብቴዴ “እ ጎታኬ ከሮርና ዱጉድ ታይስኮ ታኢያቶ ሀንባ አማራ አንተ።”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />የሱሳና፥ “ሃንሱን ሂካ ማንኮአንተ ማራን ሴ!” ባቲክ አያና ኡኑታኮ ቤራ አመ።<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />ኤሰና ምንክሴ ካኮአባባተ ጎራታ ኡኑና አልጋይ ጉት ታሁዱርተቶና፥ ባቲክ አያና ታጋፋረሮ ድያተ።<verse eid="MRK 7:30" /></para>
  <para style="s1">የሱሳ ነበ ካዱደና ህኢ ኦአዬሶን እባዶጃ ፋይሰ</para>
  <para style="r">(<ref loc="MRK 7:31-37">ማር. 7፡31-37</ref>፤ <ref loc="MAT 15:29-31">ማቶ. 15፡29-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />የሱሳ ታጢሮሳ ካታማኮ ኬጉረ፥ ምና ታስዶና ቶንሴ ካታማ ቶሞን ታአማማተ ምናነ ሮረ ታጋሊላ ላቡ ቶስ ኤመተ። <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />ኤሴና እባዶ ነቤ ካማሎና ህኢ ካአዬሶን እባዶት ኮ ኡሱ ቶስ ከነን፤ ገነና ጉት ጎጎካይሮ ኤባተን። <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />የሱሳና እባዶት ጎሳኮ ካለ ቤሰጉረ፥ ፈረሮኦቴሳ ነበቦ ኦእባዶቲ ኦርዴሰ ታብሰ፥ ኤሰኮና ሀንጩፈ ፈሪ ቱፈጉረ እባዶትኮክ ኤሬብ ድነ። <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />ዳሩሪ ቶስ ጦቂአመ ዲያ ኤርና ኔፍሳተጉረ፥ “ኤፍታህ” አመ፥ ህክና “ባናም” አማኖያ።<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />ባኔዋ ነበቦ ባናሜን፥ ኤሬብና ፉራመጉረ ቁሌስ አዬሳኖ ሀጋአበ። <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />የሱሳና ሂካ አየስ ማዮና እሶ ጎጎአዬሶንኮ አጃጄ፤ ሀሌዎ ኳሬ ኡሱ እባዶን ጎጎአዬሶንኮ አታይሰ አጃጃ ካኮስሳረ ጎራታ እሶ አደን ባላኣይሴን አዬሴን። <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />ጎሳና ኣሎ ሳዳ “ኡሱ ካፈለራ ዱባ ካእዳንያ፥ ነበቦ ኦማሎና ጎጎማላዉን፥ ህኢ ኦአዬሶና ጎጎአየስራዉን የላራ” አመ።<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">የሱሳ እባዶ ኩማ አፋር አምሰ</para>
  <para style="r">(<ref loc="MRK 8:1-9">ማር. 8፡1-9</ref>፤ <ref loc="MAT 15:32-39">ማቶ. 15፡32-39</ref>፤ <ref loc="MRK 6:32-44">ማር. 6፡32-44</ref>፤ <ref loc="MAT 16:1-12">ማቶ. 16፡1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />ሀሱ ጎራታ አባባተ ጎሳ ካሞጋን ኩኩመ፥ እሶ ካኣምራን ባቦ ኮና ማንኮግኖን ማራን የሱሳ ኡሱኮ ኦአጋልሳታራን እስ ቶስ ኡመጉረ፥ ሃ አመ። <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“ሂክ እባዶ ኢነ ዎታ አሪ ሴድ ማንኮአዳላተራን ማራና እሶ ካኣምራን ባቦ ማንኮዋታመሮ ማራን እን ነኔኤይሳራን፥ <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />ሂካማሌ እሶ ኡኤን ግራን ምንክሶ ጎጋፋረ ኮኮ እባዶ ኡል ካኤርኮ ካኤመተሮ ማንኮሌ ማራን ራድ ሀርጉሬን ኢራንዋ አመ።”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />ኡሱኮ ኦአጋልሳታረን አባበን፥ “ሂካ ቃሉላቶክ ኡሊ ሂካ እባዶ ዱባ ኣምስን ካሌሮ ባቦ ሀገኮ ሄላምናራ?” አመን። <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />የሱሳና፥ “ባቦ ምያ አብታን?” አመ እሶ ሆሳተ።</para>
  <para style="p" vid="MRK 8:5">እሶና “ባቦ ቶዶባ አብና” አመን።<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />ኡሱና ጎሳ ኡሊ ጎጎሀማጽሮን አጃጄ፥ ባቦ ቶዶባ አበረ ሶማሳተ አባባተረ ባቦኮ ኤካኤብሰረ እባዶን ጎጎሄዴድናዉን ኡሱኮ ኦአጋልሳታራዉን ስሰ፥ እሶና ጎሳን ሄደደን። <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ኡሱማለና ኡጫር ክዲጫር ኩኑኡብ አባናዬን፥ ኡሱና ሂካ ኩኑኡቤሉን ዋ ጋላቴረ ጎሳን ጎጎሄዴድራዉን አጃጄ። <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />ጎሳና ኣመ ባራረ፥ ኤሰኮና ኡሱኮ ኦአጋልሳታረና ታሄሰቶ ሀንባ ዱጉድ ቶዶባ ምግ አማጌን ኬሴን። <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />ካኣመረና ኩማ አፋር ካሌሮ እባዶያ፥ እሶና ጋልሰ፥ <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />ባኔዋ ኡሱኮ ኦአጋልሳታራነ ዎታ ዎላቦይ ታበረ ዳልማኑታ ታአማማቶ ባንኤ ቶስ ሴተን።<verse eid="MRK 8:10" /></para>
  <para style="s1">ማላታ ድን ታሆሳንተቶ ሆስን</para>
  <para style="r">(<ref loc="MRK 8:11-13">ማር. 8፡11-13</ref>፤ <ref loc="MAT 16:1-4">ማቶ. 16፡1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />ፋራሳዊል የሱሳ ቶስ ኤመተጉረ ኡሱነ ዎታ ዶጋማኖ ሀጋአበን፥ ኡሱ ጫፍን ዶተረን የሱሳ ዳሩርኮ ማላታ ጎጎቱስሮን ሆሳተን። <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />የሱሳ ኣሎ ዎዳና ማራረረ፥ “ህት አላታን ማላታ ካኮንዶታታ መዉንያ? አን ሩምና አማራ፥ ህታ አላታኑን ማምስክ ማላታና ላኮስሳምሮ!” አመ። <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />ኤሰኮና እሶ ኢሰረ ዎላቦ ታበረ በከኮ ጋማ ናቀ።<verse eid="MRK 8:13" /></para>
  <para style="s1">ታፋራሳዊልና ታሄሮዶሳ መላነኮ እስ ኦራዬን</para>
  <para style="r">(<ref loc="MRK 8:14-21">ማር. 8፡14-21</ref>፤ <ref loc="MAT 16:5-12">ማቶ. 16፡5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />ኡሱኮ ኦአጋልሳታረን ባቦ አባታኖ ማንኮኢሎቴረን ማራን፥ ዎላቦ ኦሮ ባቦ ኮ ኳሬ ኮና ላኮአባናየን። <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />የሱሳና፥ “ታፋሳዊልኮና ታሄሮዶሳ መላነኮ እስኦራየን” አመ አጃጄ።<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />እሶና እስእስ ኦሮ፥ “ኡሱ ሃ ካኮን አማራ ኖ ባቦ ማንኮዋኔኖ ማራንያ” አመን።<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />የሱሳና ቆፋትሶ አዴሰረ፥ “ባቦ ማንኮዋኔኖ ማራንያ አማ ሙን ቆፓታን? ግዳና ላኮሻዳታንያ? ዎዳናትስኒ ላኮአዴሳታንያ? ጎርቱን ዎዳናትስን ዱደታ? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />እልኦ ግራንቲ ላኮድያታንያ? ነበ ግራንቲ ላኮማላታንያ? ላኮሻዳታንያ? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />ባቦ ከን እባዶ ኩማ ከኑን ኢብሰ ካኮስሰረ ጎራታ ሀንባ ዱጉድ ምያ ምግ ኬሰን?”</para>
  <para style="p" vid="MRK 8:19">እሶና፥ “ቶሞንኮ ላማ ምግያ አመን።”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“ኡሱማለና ባቦ ቶዶባ እባዶ ኩማ አፋሩን ኢብሰ ካኮስሰረ ጎራታ ዱጉድ ምያ ምግ ሀንባ ኬሰን?” አመ።</para>
  <para style="p" vid="MRK 8:20">እሶና “ዱጉድ ቶዶባ ምግ” አመን።<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />የሱሳና፥ “እስን ግዳ ጊን ላኮሻደታን አማኖያ” አመ።<verse eid="MRK 8:21" /></para>
  <para style="s1">የሱሳ ታቤተሳይዳ ካታማይ ኢልኦ ካባየረ እባዶት ኮ ፋይሰ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />ኤሰኮና ቤተሳይዳ ቶስ ካኮገያረን ጎራታ እባዶ ኢልኦ ካድያኖን እባዶት ኮ የሱሳ ቶስ ከነን፥ ጎጎድንድኖን ኤባተን። <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />የሱሳና ኢልኦ ካባየሮ እባዶትኮት ገነ አበረ ማማንኮ ሳር ቤሰ፥ ኢልኦ ኦቴሳ ጉት ሀንጩፈ ቱፈረ ገነቴሳ ጉት ካየረ፥ “ኩን ካሙታራ መያ?” አመ ሆሳተ።<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />እባዶትና ጦቂ አመ ዴረ፥ “እባዶ ጋ ኣን ሌ ካሰሴታሮ ድያራ” አመ።<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />የሱሳና አደና ገነኖኦቴሳ ኢልኦ ኦእባዶት ጉት ካየ፥ ሀሱ ጎራታ ኢልኦ ትችሰ ዴ፥ ፋዬጉረ ካአመን ዱባ ማዳረ ድያኖ ሀጋአበ። <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />ኤሰኮና የሱሳ፥ “ማማን ቶስ አሮታብተ!” “ሀሱ ማማኒ ማዮና አሮሰግተ” አመረ ምንኬሳ ጋልሰ።<verse eid="MRK 8:26" /></para>
  <para style="s1">ጴጢሮሳ የሱሳ ማራን አቶቴ</para>
  <para style="r">(<ref loc="MRK 8:27-30">ማር. 8፡27-30</ref>፤ <ref loc="MAT 16:13-20">ማቶ. 16፡13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9፡18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />የሱሳ ኡሱኮ ኦአጋልሳታረነ ዎታ ፍልጶሳ ቅሳርያ ካአማማሮ ማማን ቶስ ሴታ፥ ራድ ግራን የሱሳ ኡሱኮ ኦአጋልሳታረነ፥ “እባዶ እን አዮ አማራ?” አመ ሆሳተ።<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />እሶና፥ “ካጣማቃሮ ያንሳ ኦአማራን ግራን፥ ኦካለና ኤላሳያ አማራን፥ ኦካለና አደነ ካሄገሮልኮ ኮያ አማራን” አመን ሰገን።<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />ደቤና፥ “እስን አዴን እን አዮ አማታን?” አመ ሆሳተ። ጴጢሮሳና፥ “አት ክርስቶሳታ” አመ አባበ።<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />የሱሳና፥ “እስኦቴሳ ማዮና እሶ ጎጎሰግኖኮ” አመ አታይሰ እሶ ሴርሰ።<verse eid="MRK 8:30" /></para>
  <para style="s1">የሱሳ ጎይኬሳኮክ ጋራ ጣየ ሰጋተ</para>
  <para style="r">(<ref loc="MRK 8:31-33">ማር. 8፡31-33</ref>፤ <ref loc="MAT 16:21-28">ማቶ. 16፡21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9፡22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />ኤሰኮና “ኤረ ካእባዶ ራኮ ታሞጋን አታታኖና፥ ጃርሶለይ፥ ካቱቃሞልኮክዎይቻልና ሴራ ካሙሴ ኦአጋልስሳራን ሆረ ካቱፋምናሮ፤ ካጎይናሮ፤ ታሴድ አርኮ አባባይረ ካክናሮ አጋልስሳኖ ሀጋአበ።” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />ኡሱና ሂካ አዴስሰ እሶን ሰገ፥ ሀሱ ጎራታ ጴጢሮሳ የሱሳ ካለ ቤሰረ ሀድሳኖ ሀጋአበ። <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />የሱሳ አደ ካምባል አመረ ኡሱኮ ኦአጋልሳታረን ቶስ ዲያ ጴጢሮሳነ፥ “አት ጻላየ፥ እንኮ ፋክም! አት ካእባዶ ኳሬ አየስ ካዋ ላኮቆፓቶ” አመ ሀድሰ።<verse eid="MRK 8:33" /></para>
  <para style="s1">ክርስቶሳ ደቤሰሴታኖ ታሙርስሳሮ ሙራ</para>
  <para style="r">(<ref loc="MRK 8:34-38">ማር. 8፡34-38</ref>፤ <ref loc="MAT 10:38-39">ማቶ. 10፡38-39</ref>፤ <ref loc="MAT 16:24-28">16፡24-28</ref>፤ <ref loc="LUK 9:23-27">ሉቃ. 9፡23-27</ref>፤ <ref loc="LUK 14:25-27">14፡25-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />ኤሰኮ አባባተረ የሱሳ ጎሳ ኡሱኮ ኦአጋልሳታራነ ዎታ እስ ቶስ ኡመረ “እንደቤ ሰሴይን፥ ካጌላታራ ጎግረ እስኦቴሳ ሀካካተ፥ ማስቃሊታቴሳ ስዳይረ እንደቤ ሀሰሴቶ። <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />ኔፎቴሳ ሃሳይን ካዶታታራ ዱባ ባሳታራ፥ እን ማራና ዎንጋላ ማራን ኔፎቴሳ ሮርሳተ ካስሳታራ ዱባ አደ እስኦቴሳ ፋይሳታራ። <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />እባዶን አላም ዱባ ካኬሳ ጎሌ ኔፎ ጎዋተ መይ ላኦ አባ? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />ሃ ጎሌ እባዶ ኔፎቴሳን መ ዎዶ አባ? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />ህታ ታላይማቶና ጩባለሳት አላታን ሆረ እዬና ሃፉራኬይ ካሙላራ ዱባ፥ ኤረ ካእባዶ ኣቦኬሳት ካባጃ፥ ቁሉክ ኤርግቻልነ ዎታ ካኮኤሜተ ጎራታ ኡሱ አን ሙልናራ” አመ።<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="s1">ምዲ ታየሱሳኮክ ኢግልሳማኖ</para>
  <para style="r">(<ref loc="MRK 9:2-13">ማር. 9፡2-13</ref>፤ <ref loc="MAT 17:1-13">ማቶ. 17፡1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9፡28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />አደና የሱሳ፥ “አን ሩምና አማራ ህታኒ ኦአሌራን ኦሮኮ ዎኖናት ካዋ ሁና ኤመታ ግራን ታ ዴራኒ ኦጎኖን ግራን” አመ።<verse eid="MRK 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />አሪ ታሌይኮ አባባተረ ጴጢሮሳ፥ ያይቆባና ያንሳ አበጉረ ታኤርት ዎዳም ቶ ቶስ ኣተ ቤ፥ ካለና ግረን፥ እሶ ሆረና ምዲተሳ ኢግልሳንተ። <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />ሳርስኬሳና ሂካ ኡል ጉት ማዮና ሳርስ ካአልሳራ ሙጭስን ካዳንዴኖን ግታክ ኣሎ ጉማራ ሌ። <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />ኤላሳና ሙሴና የሱሳ ዎታ አዬሳ ግራን ሙተን። <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />ጴጢሮሳና የሱሳነ፤ “ካአጋልስሳቶ! ህታኒ ግርነዋ ኖዬን ካእዳንክየ፤ ቶ ኩዬን፥ ቶ ሙሴን፥ ቶ ኤላሳን ታሌቶ ዳሰ ሴድ ማዳርኖ” አመ። <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />ኣሎ ማንኮአብሳተራዉን ጴጢሮሳ ካአዬሳሮና ላኮአዴሳረ።<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />ኤሰኮና ዱማንቻ ኤመተጉረ ሆጎግሰ፤ ዱማንቻ ኦሮኮ፥ “ሂክ አን ካጌላታሮ ኤረኬያ፤ ኡሱ ማላ!” ታአማታ ያየ ማልሳንተ። <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />ጎርሰዋ ካምባል አም ጎዴራን የሱሳ ኳሬ ካካለ ማዮና እሶነ ዎታ ላኮግረ።<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />ዎዳም ጉኮ ካኮዳጋረ ጎራታ ኤረ ካእባዶ ጎይኮ ታኬሮ ጊን ካዴራን ማዮና ጎጎሰግኖንኮ አጃጄ።<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />እሶና ካአዬሳመሮ ሃፉራ ዎዳናትሶይ አባተን፤ አየሱን ጎአመን፥ “ጎይኮ ክያኖ” መ አማኖዮ እስእስኦሮ አዬሳ ግረን። <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />ኤሰኮና፥ “ሴራ ካሙሴ ኦአጋልስሳራን ጣይ ኤመይን ካዶትሳራ ኤላሳያ ሙን አማራን? አማ ሆሳተን።”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />የሱሳና፥ “ኦግራን ኤላሳ ኤሜይጉረ አየስ ዱባ ኤካስናራ፤ ሀያ ኤረ ካእባዶ ታሞጋን ራኮ አታዪና ቱፋምን ዶትሳራ አማመ ካኮንጻፋመራ መዉንያ? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />አየሱን ጎአመን፥ ኤላሳ ጣየ ኤመተ ግረ፤ እባዶ ጋራኬሳ ጎጎጻፋመሮ ማለ ካዶታቴራን ዱባ ፈለን” አማራ።<verse eid="MRK 9:13" /></para>
  <para style="s1">ባቲክ አያናይ ካአባመረ ኡኑትኮክ ፋያኖ</para>
  <para style="r">(<ref loc="MRK 9:14-28">ማር. 9፡14-28</ref>፤ <ref loc="MAT 17:14-21">ማቶ. 17፡14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9፡37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />የሱሳና ሴዶ ኡሱኮ ኦአጋልሳታረን ኦሄሴራን ኡሱኮ ኦአጋልሳታራን ቶስ አባባተን ካኮኤሜታሬን ጎራታ ጎሳ ካሞጋን እሶ ማራሙረ ኩኩመ ግራን ዴ፥ ሴራ ካሙሴ ኦአጋልስሳራን እሶነ ዎታ ዶጋማ ግረን። <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />ጎሳ ዱባ የሱሳ ዴጉረ ጎርሰዋ ማመረ ኡሱ ቶስ ቲየ ሴተጉረ ኖጎዳ ኣተ።<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />የሱሳና፥ “እሶነ ዎታ ካኮንዶጋማታን ኤት ሃጃይያ?” አማ ሆሳተ።<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />ጎሳ ኦሮኮ እባዶት ኮ ሃ አመ፦ “ካአጋልስሳቶ፤ ህኢ ካዱድሳሮ ባቲክ አያናይ ካአባመሮ ኡኑኬ ኩ ቶስ ኬናየራ፤ <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />ካኮኬሮ ጎራታ ባንኤ ዱባ ሉጉዳራ፥ ሳንባና ጉድሳራ፥ ኢልኮና ፎጫራ፥ ማርና ዞርዶይሳራ፤ ባቲክ አያና ኡሱኮ ጎጎቤስናዉን ኩኮ ኦአጋልሳታራዉን ሰጋየ፤ እሶና ቤስን ላኮዳንዴን።”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />የሱሳና አባበረ፤ “እስን ታአብዳኖን አላታን፤” “ሀጌ ታ ጌሮን እስኔ ዎታ ግርናራ? ሀጌ ታ ጌሮን ኦብስናራ? ኡኑ እን ቶስ ኬና!”<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />እባዶና ኡኑ የሱሳ ቶስ ኬነ፤ ባቲክ አያናና የሱሳ ካኮድያረ ጎራታ ኡኑ ጎርሰዋ ሀርኢሳኖ፥ ኡል ሉጉዳኖ፥ ኡለ ቦጫኖና ሳንባ ጉድሳኖ ሀጋአበ።<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />የሱሳና ካኡኑት ኦዶ ኡመረ፥ “ሂክ አሮአበኮ ጌስ ምያየ?” አመ ሆሳተ። ኡሱና ሃ አመ አባበ፤ “ይሱማኮ ሀጋአበረያ።”<verse eid="MRK 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 9:22" />“ላጋዲን ዶተጉረ አርጌቶ ኤለን ኦሮና በከ ኦሮዴሰ ሉጉዳራ፤ ካዳንዴቶ ጎሌተ ነኔኤይሳና፤ ጋርጋርና።”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />የሱሳና፥ “ ‘ካዳንዴቶ ጎሌ’ ” አንተ? “ካአማናሮ እባዶን አየስ ዱባ ዳንዳማራ” አመ።<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />ጎርሰዋ ካኡኑት ኦዶ፥ “አብዳታራ፤ አየሱን ጎአመን አብድ ታኮዋታሮ እን ጋርጋርና!” አማ ኦኬ።<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />የሱሳና፥ ጎሳ ኤሰራ ቲታ ካኤሜታሮ ካኮድያረ ጎራታ፥ “አት ህኢ ካአዬሶንና ነቤ ካማሎን አያና ኡሱኮ ቤና! ካላም አባባይ ኡሱ ቶስ ጎጎታቦንኮ አጃጃራ!” አመ ባቲክ አያና ሀድሰ።<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />ባቲክ አያናና ኦኬ፥ ኡኑ ኣሎ ኡለ ቦጬ አባባተረ ጋፋረ ቤ፤ ኦሞጋና፥ “ጎየራ” ታአምራኒ ሬስ አን ሌ። <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />የሱሳ አደ ታኡኑ ገነ አበ ኬሰ፤ ኡኑትና ኬ አሌ።<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />የሱሳ ምን ኦሮዴ ካኮታባረ ጎራታ ኡሱኮ ኦአጋልሳታረን ካለ ቤኔን፥ “ኖ ቤስን ካኮዋኔና ሙንያ?” አመን ሆሳተን።<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />ኡሱና “ሂካ ኣንክክ ካኮቢን ዳንዳራ ኤብና አጋቡይ” ካላሊ ኳሬ ማመስና ብን ላኮዳንዳሮ አመ።<verse eid="MRK 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />ኤሰኮ ኬጉረ ማማን ካጋሊላነ ሮረ፤ የሱሳና፥ ማዮና ኡሱ ታኮግሮ ባንኤ ጎጎአዴስሮ ላኮዶተሮ፤ <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ኡሱኮ ኦአጋልሳታራዉን፥ “ኤረ ካእባዶ ገነ ታእባዶይ ሮርሳም ስሳምናራ፤ እሶና ላጋድናራን፥ አሪ ሰድኮ ዳንቤባን ጎይኮ ኪናራ” አማ አጋልስሳ ግረ።<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />እሶን አደ ኡሱ ካአማራ ላኮታበረ፥ ሆሳይና አብሳተን።<verse eid="MRK 9:32" /></para>
  <para style="s1">ዱባንኮ ካሮራራ አዮያ?</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር. 9፡33-37</ref>፤ <ref loc="MAT 18:1-5">ማቶ. 18፡1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9፡46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ኤሰኮ አባባተረ የሱሳና ኡሱኮ ኦአጋልሳታራን ታቅፍረናሆም ካታማ ቶስ ኤመተን። ምን ኦሮዴ ታበጉረ “ራድ ግራን ካኮንዶጋማቴን ጋራ ካሜያ?” አመ ሆሳተ።<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />እሶ አደን ራድ ግራን ካኮዶጋማሬን ዱባንኮ ካጂናታራ አዮያ? ካአማሮ ማንኮሌ ማራን ጫልኢ አመን። <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />የሱሳ ሀማጼጉረ እሶ ኦሮኮ ቶሞንኮ ላማ ኡመጉረ፥ “ዱባንኮ ካሆረ ሊን ካዶታታራ፥ ዱባንኮ ሀርጫና ዱባዉን ካሀንዳሮ ሀሌዎ” አመ። <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />ክጫርክ ይትት ኬነጉረ እሶ ጠኤ ኣልሰ፤ ካባላተረ፥ <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“ሂካ ይሳስኮ ኮ መገኬይ ካቆጳታራ ዱባ እን ቆጳታራ፤ እና ካቆጳታራ እን ሃሌኖን እን ካፋረሮ ቆጳታራ” አመ።<verse eid="MRK 9:37" /></para>
  <para style="s1">ኖ ካዲዶን ዱባ ኖኔ ዎታ ግራ</para>
  <para style="r">(<ref loc="MRK 9:38-40">ማር. 9፡38-40</ref>፤ <ref loc="LUK 9:49-50">ሉቃ. 9፡49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />“ያንሳና፥ ካአጋልስሳቶ እባዶት ኮ መገካይ ዱርሳ ቤሳ ግራን ዴነ፥ ኖ ዎታ ማንኮሰሰኖዉን ማራን ትርነና” አመ።<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />የሱሳ አደ ሃ አመ፤ “አሮትርቴን፤ ማዮና መገኬይ ባሳ ፈልጉረ ጎርሰዋ እን ጉት ታሜላን አዬስን ላኮዳንዳሮ፤ <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />ኖ ካዲዶን ዱባ ኖኔ ዎታ ግራ፤ <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />አን ሩምና አማራ ኦክርስቶሳ ማንኮሌቴን ማራን መገኬይ ቁልዱቦ ቶ በከ እስን ካጣምሳራ ዱባ ላኦ ላኮዋሮ” አመ።<verse eid="MRK 9:41" /></para>
  <para style="s1">ካካለቱን ሀንዱዱፎ ላኖ</para>
  <para style="r">(<ref loc="MRK 9:42-50">ማር. 9፡42-50</ref>፤ <ref loc="MAT 18:6-9">ማቶ. 18፡6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17፡1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />ማዮና እን ኦአማናራን ሂናኣ ኦትዲጫርኮ ኮ ካሀንዱዱፍሳራ ዱባ ካአቲ ኤኤሞ ካሪመ ማርጊ ሽያምጉረ በከ ኦሮድ ሻፋመዋ ኢዳንክያ። <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />ሃንሱን ገነታ ኩ ጎሀንዱዱፍሰ ጎስና፤ ገነ ላማ ኩን ግርጉደ ጋሃናመ ታባኖን ኤለኒ ቶስ ታባኖኮ፥ ገነ ሙዱናኔ ዎታ ጅሩ ጅሮማክ ግር ቶስ ታባኖ ካእዳንክያ፤ <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />ጋሃናመ ኤለን ታባኖን፤ ህስክትሶና ላኮጎቶ ኤሌና ላኮባቶ። <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />ሉቃኦታ ኩ ጎሀንዱዱፍሰን ጎስና፤ ሉቃ. ላማ ኩን ግርጉረን ታባኖን ኤለን ኦሮድ ሻፋማናኮ፥ ካኤሳቶ ሊጉደ ጅሩ ጅሮማክ ግር ቶስ ታባኖ ካእዳንክያ፤ <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />ታባኖን ኤለኒ ህስክና ላኮጎቶ ኤሌና ላኮባቶ <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />እልታ ኩ ጎሀንዱዱፍሰ ታግ ቤስ፤ ኢልኦ ላማ ግርጉረን ጋሃናመ ኤለን ታባኖን ኦሮድ ታባኖኮ፥ ኢል ቶ ግርጉደ ዎኖናት ካዋ ቶስ ታባኖ ካእዳንክያ፤ <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />ታባኖን ኤለኒ ህስክና ላኮጎቶ፥ ኤሌና ላኮባቶ።<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“ጃርሶ ኤሰቦ ጎጎሙጭአማሮ እባዶ ዱባና ኤለኒ ሙጭአማኖ ዶትሳራ።<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“ኤሰቦ ታኢዳንትታ፤ አየሱን ጎአመን ኤሰቦ ኦኖሞንጀትሴ ጎዋተ መይ አባብ ኦኖሞንጀትሰ ጎጎግርቶን የልናታን? ኤሰቦ እስን ኦሮ ሀግርተ፤ እስ እስኦሮና ኤካየን ኖጎዳ ግራ።”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">ካኦርና ካኤንተሬ ከልክ አማማኖ</para>
  <para style="r">(<ref loc="MRK 10:1-12">ማር. 10፡1-12</ref>፤ <ref loc="MAT 19:1-12">ማቶ. 19፡1-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፡18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />የሱሳ ኤሰኮ ኬጉረ፥ ኡል ካይሁዳ ቶስና ዮርዳኖስኮ ጋማነ ካግሮ ጎቦብ ቶስ ሴተ፤ ኣሎ ካሞጋን ጎሳ አደ ኡሱ ቶስ ኩኩአማ ግረ፤ ሂታኮ ሆረነ ጎጎየላ ግሬይ እሶ አጋልስሰ።<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />ካፋራሳው እባዶኮ ኮኮ የሱሳ ቶስ ኤመተጉረ፤ ኡሱ ጫፍን ዶተጉሬ፥ “እባዶ ኦርቴሳ ከልክ አም ጋፋርን ዶትሳራ?” አመን ሆሳተን።<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />ኡሱና አባበረ፥ “ሙሴ መ አመ እስን አጃጄራ?” አመ።<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />እሶና፥ “ሙሴ ጎአመን ከልክ ካኮአማመሮ ዎራቃታ ጻፍረ ጎጎጋፋሮ አመ ፈኢ ስሰራ” አመን።<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />የሱሳና አባበረ፤ “ሙሴ ሂካ አጃጃ ካኮንጻፈራ ዎዳናትስን ታዱደ ማንኮሌተ ማራንያ።” <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />“አየሱን ጎአመን ዋ ጣየ እባዶ መጣ ‘ባባርትትና ሄለልትቲ የለ መጠ።’ <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />‘ሃንሱን እባዶ ኣቦኬሳና ኣየቴሳ ኢሳጋራ፤ ኦርቴሳነ ዎታ ቁራናማራ፤ <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />እሶ ላማና ማር ኮ ላራን፤’ ጎርታኑን ማር ኮ ላራን ኳሬ ላማ ላኮያን፤ <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />ሃንሱን ዋ ካቁራኔሮ ማዮና ፉርን ላኮዳንዴሮ” አመ።<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />አደና ምን ካኮታባሬን ጎራታ፥ ኡሱኮ ኦአጋልሳታረን ህታ ሃጃ ኬሴን ሆሳተን። <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />የሱሳና “ማዮና ኦርቴሳ ከልክ አመረ ታካለ ካአታታራ ኦርቴሳ ጉት ሻርሙጣራ፤ <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />ኤሰና ኤንተርክሴኮ ከልክ አማምደ ካካለቱን ጎኬሳንተ ሻርሙጢተታ” አመ።<verse eid="MRK 10:12" /></para>
  <para style="s1">የሱሳ ይሳስ ሶማሳተ</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር. 10፡13-16</ref>፤ <ref loc="MAT 19:13-15">ማቶ. 19፡13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18፡15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />የሱሳ ጎጎድንድኖን፤ እባዶ ይሳስ ኡሱ ቶስ ኬናታ ግረ፤ የሱሳኮ ኦአጋልሳታረን አደን ሀድሴን። <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />የሱሳና ሂካ ዴጉረ አማራተረ፤ “ይሳስ እን ቶስ ሀኤመተ፥ አሮትርቴን፤ ዎኖናት ካዋ ሂናኣ ኣኒዕኒዕያን አመ። <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />አን ሩምና አማራ፤ ዎኖናት ካዋ ይሳስ ኣን ካቆጳኖን ዱባ ሱረ ላኮታብሮ” አመ። <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />ይሳስና ካባላተ አባተረ፤ ገነቴሳ እሶ ጉት ካየጉረ ሶማሳተ።<verse eid="MRK 10:16" /></para>
  <para style="s1">ዱረሳክ እባዶት</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር. 10፡17-31</ref>፤ <ref loc="MAT 19:16-30">ማቶ. 19፡16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18፡18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />የሱሳ ኤሰኮ ቤጉረ ራድ ቤ ሰሴታ ግራን፥ እባዶት ኮ ኡሱ ቶስ ትያ ኤመተ፤ ኡሱ ሆረ ግልቢሰጉረ “ካእዳንክ ካአጋልስሳቶ፤ ጅሩ ጅሮማክ ግር ኤልን መ የልን ዶትሳራ?” አመ። <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />የሱሳና፤ “ሙን እን ካእዳንክ አማታ? ዋ ኮ ኳሬ ካእዳንክ ላኮግሮ፤ <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />አጃጃ ካሴራ ካሶዋ፤ አሮላጋደ፥ አሮሻርሙጢተ፥ አሮሄቴ፥ ጣራ አሮአቶቲተ፥ አሮሶብተ፥ ኣቦካና ኣየታ ካባጂና” አመ አባበ።<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />እባዶትና፥ “ካአጋልስሳቶ፤ ሂናኣ ዱባ ይሱማኮ ሀጋአበረ ኦራዬራ” አመ።<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />የሱሳና ዴጉረ ጌላተ፤ “ጎርታኑ አየስ ኮያ ኩን ካሀንቃተራ፤ ሴጉዴ ካአብቶ ዱባ ዳዳልጉደ፤ ህየሳሉን ስስ፤ ዳሩርና ኦኩኩአመራን ኡራዎ ሄላይናታ፤ ኤሰኮ ዳንቤባን ኮይ እን ዴበ ሰሴ” አመ። <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />እባዶትና ሂካ ካኮማላረ ጎራታ ጎሜላን ያደ፤ ኡራዎ ኦሞጋን ኡሱን ማንኮግሬን ማራን ያዳ ሴተ።<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />የሱሳ ካምባል አመ ዴጉረ ኡሱኮ ኦአጋልሳታራነ፥ “ዱሬሳጆል ዎኖናት ካዳሩረ ታባኖ ምስክ ካእስላሮ አዬስያ!” አመ።<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />ኡሱኮ ኦአጋልሳታራን አዬስከሳይ ማሜን፤ የሱሳ አደ አባባተ ሃ አመ፤ “ይስኬ፤ ዎኖናት ካዋ ታባኖ ምስክ ካእስላሮ አዬስያ! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />ዱሬሳን ዎኖናት ካዋ ቶስ ታባኖኮ ሱረ ጋላ ቡቶ ካማርፍነ ኦሮማር ሮራኖ ኤነ ሌራ” አመ።<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />ኡሱኮ ኦአጋልሳታራና ኣሎ ማማኖይ፥ እስእስ ኦሮ “ሀያ አዮያ ፋይን ካዳንዳራ?” አመን።<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />የሱሳና እሶ ቶስ ዲያ፥ “ሂክ እባዶ ዶሌ ላኮዳንዳማሮ፤ ዋይ ዶሌ ጎአመን ዳንዳማራ፤ ዋይ ዶሌ ካመን ዱባና ዳንዳማራ” አመ።<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />ጴጢሮሳና፥ “ሂክማ ኖና ካመን ዱባ ኢንሰ ኩ ዴበ ሰሴነና” አመ። <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />የሱሳና አባበ፤ “አን ሩምና አማራ፤ እን ማራንና ዎንጋላ ማራን አመረ ምንኬሳ ጎርቱን አቢላልቴሳ ጎርቱን አባላልቴሳ ጎርቱን ኣየቴሳ ጎርቱን ኣቦኬሳ ጎርቱን ይስኬሳ ጎርቱን ኢራኬሳ ካኢሰ ዱባ፥ <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ግዳ ሂካ ጌሲ ባቃታኖነ ዎታ ምንጆል፥ አቢላል፥ አባላል፥ ኣጮላል፥ ይሳስ፥ ኢራና ቦልኮክ አምባ አታይናራ፥ ካኤሜታሮ አላም ጅሩ ጅሮማክ ግር ካኤሎን ላኮግሮ። <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />አየሱን ጎአመን ኦሆሬ ኦሌራን ኦሞጋን ኦዳንቤ ልናራን፥ ኦዳንቤ ኦሌራና ኦሆሬ ሊናራን” አመ።<verse eid="MRK 10:31" /></para>
  <para style="s1">የሱሳ ጎይኬሳኮክ ጋራ ጎራታ ካሴድ አዬሰ</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር. 10፡32-34</ref>፤ <ref loc="MAT 20:17-19">ማቶ. 20፡17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18፡31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />ኢየሩሳለም ቶስ ብያ ራድ ግራን፥ የሱሳ ሆረሃየረ ሰሴታ ግረ፤ ኡሱኮ ኦአጋልሳታረን ማሜን፥ ኦካለ ዴበ ኦሰሴታሬን አደን አብሳተን ግኔን አደና ቶሞንኮ ላማ ጎሳኮ አሳበረ መ ኡሱ ግናሮ ሰገ፤ <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“ጎርታ ኖ ኢየሩሳለም ቶስ ብናና፥ ኤረ ካእባዶ ቱቃሞኮክ ዎይቻሉኒና ሴራ ካሙሴ ኦአጋልስሳራዉን ሮርሳም ስሳምናራ፤ እሶና ጎይኮክ ፍርዳ ፍርዲናራን፤ አይዛብን ሮርስ ስስናራን፤ <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />አይዛብልና ቃጭፋይናራን፤ ሀንጩፈና ቱፍናራን፥ ቦጭናራን፥ ኤሰኮና ላጋድናራን፤ ኡሱ አድ አሪ ሰድኮ ዳንቤባን ኪናራ።”<verse eid="MRK 10:34" /></para>
  <para style="s1">ታያይቆባና ታያንሳ ሆስን</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር. 10፡35-45</ref>፤ <ref loc="MAT 20:20-28">ማቶ. 20፡20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />ኤሰኮና ይስ ካዛብዶሳ ያይቆባና ያንሳ የሱሳ ቶስ ጋባላመንጉረን፥ “ካአጋልስሳቶ፤ ኖ ኩኮ ካኤባታኖ ዱባ ኖን ጎጎስሶ ዶታና” አመን።<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />የሱሳና፥ “መ አን እስኑን ጎጎየሎ ዶታታን?” አመ።<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />እሶና፥ “ካባጃታክ ጎራታይ ኖኮ ኮ መርገታይ ኮ በተታይ ጎጎሀማጺኖን ኖን ፈኢ ስስ” አመን።<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />የሱሳና፥ “እስን ካኤባታታን ላኮካሳን፤ አን ታጣማሮ ታራኮ ጡጋ ጣምን፥ አን ካጣማቃማሮ ጥንቃታ ጣማቃምን ዳንዳታን?” አመ።<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />እሶና፤ “እ ዳንዳና” አመን። የሱሳና፤ “አን ታጣማሮ ጡጋ ጣንታንዋ፤ አን ካጣማቃማሮ ጥንቃታና ጣማቃንታንዋ፤ <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />አየሱን ጎአመን መርገቴይ ጎርቱን በተቴይ ሀማጻኖ ዋ ካኮንኤካሰሮን ኳሬ አን ካስስናሮ አየስ ላኮዮ” አመ።<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />ኦሄሰረን ቶሞኖ ሂካ ማለንጉረን ያይቆባና ያንሳ ኢንጋማኖ ሀጋአበን። <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />የሱሳና እሶ ራቶ ኩኩይሰረ ሃ አመ፤ “ካአይዛብ ዎይቻል አማሜን ኦሄዳማራን ኦዶናት ኦባሪስናራን፥ ሹሞሌትሶና እሶ ጉት ኦዶናት ኦቱሳይናራን እስን ካሳንዋ፤ <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />እስኒ ዶሌ አደ ሂካማሌ ሊን ላኮዶትሳሮ፤ እስን ኦሮኮ ካንጅንክ ሊን ካዶታታራ ዱባ እስኑን ካሀንዳሮ ሀሌዎ፤ <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />ካሆሬ ሊን ካዶታታራ ዱባ ካዱባ ድይ ሀሌዎ፤ <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />ኤረ ካእባዶ ሀንዳይና ኔፎቴሳ ካሞጋኑን ዎዶ የል ስሳይን ኤመተራ ኳሬ ጎጎሀንዳይናዉን ላኮኤሜተሮ።”<verse eid="MRK 10:45" /></para>
  <para style="s1">የሱሳ ኢልኦ ካባየሮ በርጠሎሜዎሳ ፋይሰ</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር. 10፡46-52</ref>፤ <ref loc="MAT 20:29-34">ማቶ. 20፡29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18፡35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ኤሰኮ አባባቴረን ታኢያርኮ ካታማ ቶስ ኤመተን። የሱሳና ኡሱኮ ኦአጋልሳታረን ጎሳ ካሞጋነ ዎታ እያርኮኮ ብያግራን ኢልኦ ካድያኖን ካጠመዎሳ ኤረ በርጠሎሜዎሳ ራ ግርዲ ሀማጼረ ኤባታ ግረ። <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />ኡሱና ኤሰነ ካሮራራ ካናዝረት የሱሳ ላኖ ካኮማላረ ጎራታ፥ “ኤረ ካዳዉተ፥ የሱሳ፤ እን ማር!” አማ ኦካኖ ሀጋአበ። <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />ካሞጋና ኡሱ ጫልኢ ጎጎአምሮ ሀድሴን፤ ኡሱ ጎአመን፥ “ኤረ ካዳዉተ፤ እን ማር!” አማ ኣሎ ጂናሰ እዬ። <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />የሱሳና አሌጉረ፤ “ኡማ!” አመ። እሶና ኢልኦ ካባየሮነ፤ “አላማንደ! ክ! የሱሳ ኡማራ!” አመን። <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />ኡሱና ሳርስኬሳ ሻፈጉረ ፍጣ አመ ኬ አሌ የሱሳ ቶስ ኤመተ። <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />የሱሳና “መ ጎጎየሎ ዶታታ?” አመ። ኢልኦ ካድያኖና “ካአጋልስሳቶ፤ ድን ዶታራ” አመ። <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />የሱሳና፤ “ሴ አማኖካ ኩ ፋይሰራ” አመ፤ ጎርሰዋ ኢልኦ ዴንዴን፤ ኡሱ ራነዋ የሱሳ ዴበ ሰሴተ።<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">የሱሳ ታአቲ ካባጃይ ኢየሩሳለም ቶስ ታበ</para>
  <para style="r">(<ref loc="MRK 11:1-11">ማር. 11፡1-11</ref>፤ <ref loc="MAT 21:1-11">ማቶ. 21፡1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፡28-40</ref>፤ <ref loc="JHN 12:12-19">ያን. 12፡12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />የሱሳና ኡሱኮ ኦአጋልሳታረን ኢየሩሳለም ካኮጋባላመሬን ጎራታ ዛይት ካብያራ ጋ ታኮአላታሮ ዎዳሚ ቶንሴ ዶሌ ካግሮ ካቤተፋገና ካብታንያ ማማን ቶስ ገገን፥ የሱሳ ኡሱኮ ኦአጋልሳታረንኮ ላማ ሃ አማ ፋረ፤ <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />እስን ሆረ ካግሮ “ማማን ቶስ ሴዬን፤ እባዶ ሀማጽ ታኮካሶን ዳርሜ ታደሜር ኤሰ ታሻንተቶ ሄልናታን፤ ፉራዴነ ኬና፤ <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />ማዮና፥ እስኔ ‘ምስ የላታን?’ ጎአመ፤ ‘ጎታዉን ዶትሳራ፤ ባኔዋ አባብ ፋርናራ አማዴን ሰጋ።’ ”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />እሶና ሴተን፤ ምን ኮይ ሳሬ ታሻንተቶ ዳርሜ ታደሜር ሄሌን፤ ፉሬን። <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />ኤሰ ኣሌ ካግረ እባዶኮ ኮኮ፥ “ዳርሜ ካኮንፉራታን መዉንያ?” አመ ሆሳተ። <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />እሶና፥ የሱሳ ካአመሮ እባዶን ካኮሰጋረን ጎራታ እሶና ፈኢ ስሰን። <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />ዳርሜና የሱሳ ቶስ ኬነንጉረን ሳርስክሶ ካዳርመ ባጋድ ጉት ያዬን፤ ኡሱና ጉት ሀማጼ። <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />ካሞጋን እባዶና ሳርስክሶ ራድ ያዬን፤ ኦካለና አደን ካባርዛፈ ጋኮ ባላል ታርሼ ኣተን ኡል ያ ግረን። <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />የሱሳኮ ሆረነ ኦሰሴታረና ሃሬ ዴበ ኦሰሴታረን ካአቲ ሃፉራይ ሃ አማ ግረን፤ “ሆሳኢና!” መገ ካጎታይ ካኤመታራ ካሶማሳመያ!<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />“ካኤመታራ ኣቦካን ካዳዉተክ ዎኖናት ካሶማሳመያ፤”</para>
  <para style="q1" vid="MRK 11:10">“ሆሳኢና አርያም!” (ዱባንኮ ጦቅ ካአንተ ዳሩሪ ሶማ ዋዉን ሀሌን!) አማ ኢያረን።<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />የሱሳና ኢየሩሳለም ጌጌ፤ ኤሰኮና ቁሉክ ምን ካዋ ቶስ ታበ፤ ኡሱ ማራሙረ ካግሮ ዱባ ዴ፤ ኡል ሄመን ካኮላረ ጎራታ ቶሞንኮ ላማነ ዎታ ብታንያ ቶስ ሴተ።<verse eid="MRK 11:11" /></para>
  <para style="s1">የሱሳ ካቃንጌሮ ካባላስ ጋ</para>
  <para style="r">(<ref loc="MRK 11:12-14">ማር. 11፡12-14</ref>፤ <ref loc="MAT 21:18-19">ማቶ. 21፡18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />ታላም አሪ የሱሳ ብታንያኮ ብያግራን ኡኤ። <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />ኡሱና ባላሎ ካአቦ ካባለስ ጋ ኤባ ዴ፤ ዎዳሳ ኢል ዱባም ግርቶ አማ ኡሱ ጋ ቶስ ሰተ፤ አየሱን ጎአመን ኡሱ ጋ ታኮዱባማረ ድግኒ ላኮተ ባላሎ ኳሬ ኮና ላኮሄላተ። <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />ኤሰኮና የሱሳ ካባላስ ጋነ፤ “ግዳኮ ሀጋአብረ ጅሩ ጅሮማን ማዮና ኩኮ ኢል አሮኣሞ” አመ። ኡሱኮ ኦአጋልሳታረን ኡሱ ሂካ አዬሳ ግራን ማለን።<verse eid="MRK 11:14" /></para>
  <para style="s1">የሱሳ ቁሉክ ምን ካዋ ኦሮ</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር. 11፡15-19</ref>፤ <ref loc="MAT 12:12-17">ማቶ. 12፡12-17</ref>፤ <ref loc="LUK 19:48">ሉቃ. 19፡48</ref>፤ <ref loc="JHN 2:13-22">ያን. 2፡13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />ኢየሩሳለም ቶስና ሴተን፤ ኤሰኮና የሱሳ ቁሉክ ምን ካዋ ኦሮዴ ታበጉረ፥ ኦኢምናታራና ኦዳዳላታራን ኦሮኮ ቤሳኖ ሀጋአበ፥ ማራጋደ ኦኢግልሳታራንኮን ጣራጴዛልና አራበ ኦዳዳላታራንኮክ አርጃታል ምናምናአባበ፤ <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />ማዮና ሁ ስዳይረ ቁሉክ ምንኮት ኣል ኦሮ ማር ጎጎሮሮንኮ ትረ። <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />አጋልስሳና ሃ አመ፤ “ምንክ ጎሳ ዱባን ምን ካኤብያ አማማራ አማመ ላኮጻፋመሮያ? እስን አዴን ካሽታ ላጋ የልቴን!” አመ።<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />ካቱቃሞል ዎይቻልና ሴራ ካሙሴ ኦአጋልስሳራን ሂካ ማለንጉረን ኡሱ ታየል ላጋድናን ራ ዶታኖ ሀጋአበን፤ ሀሌዎ ኳሬ ጎሳ ዱባ አጋልስስኬሳ ማማ ማንኮግረ ማራን ኡሱ አብሳተናን። <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />ኡል ሄመን ካኮላረ ጎራታ የሱሳና ኡሱኮ ኦአጋልሳታራን ኤሰ ካታማኮ ቤንጉሬን ሴተን።<verse eid="MRK 11:19" /></para>
  <para style="s1">ጋ ካባላስ አንጋገ</para>
  <para style="r">(<ref loc="MRK 11:20-26">ማር. 11፡20-26</ref>፤ <ref loc="MAT 21:20-22">ማቶ. 21፡20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />ታላም አሪ ባር ራኔ ሮራ ግራን፥ ጋ ካባላስ ህዲድኔ ካአንጋገሮ ዴን። <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />ጴጢሮሳ አየስ ቃል ካኮአማረ ጎራታ የሱሳነ፥ “ካአጋልስሳቶ፤ ሂክማ አት ካቃንግተታ ካባላስ ጋ አንጋገራ” አመ።<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />የሱሳና አባበረ፤ “ዋይ አማና።” <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />“አን ሩምና አማራ፤ ማዮና ህታ ዎዳምነ፥ ‘ታጋምደ በከ ኦሮዴ እ’ ጎአመ ሂካና ዎዳናቴሳይ አሄዳኖኒ ጎኤባተ ሌሮዋ። <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />ሃንሱን ኤቢ ካኤባታታን ዱባ ካአታቴታን ኣን የል ጎአማናቴን ሌሮዋ። <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />አደና ኤባይን ካኮአልቴን ጎራታ፤ ካዳሩረ ኣቦክስን ጩቦክስን ሀሄሶ ጎጎአምሮ፤ እስና እባዶ ጉት ታአብታን ካጁ ዱባ ሀሄሶ አማ። <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />እስን ካካለኮክ ባስ ሀሄሶ ጎአሞን አደ ካዳሩረ ኣቦክስን ጩቦክስን ሀሄሶ ላኮአምሮ።”<verse eid="MRK 11:26" /></para>
  <para style="s1">ኦዶናት ካየሱሳ ጉት ሆሲን ኬተ</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር. 11፡27-33</ref>፤ <ref loc="MAT 21:23-27">ማቶ. 21፡23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20፡1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />አደን ኢየሩሳለም ቶስ ሴተን፤ የሱሳ ቁሉክ ምን ካዋ አዉዲ ኦሮ ሰሴታ ግራን ካቱቃሞል ዎይቻል፤ ሴራ ካሙሴ ኦአጋልስሳራና ጃርሶለ ኡሱ ቶስ ጋባላመንጉረን፥ <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />“ሂካ አዬስጆል ካኮፈላታ ኦዶናት ካዮያ? ሂካ ጎጎፈልቶን ኩን ኦዶናት ካስሰራ አዮያ?” አመን።<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />የሱሳና አባበረ፤ “አላ አን ሆሲን ቶ እስን ሆሳሮ፤ አባባ፤ አንና ሂካ አዬስጆል ኤክ ኦዶናት አን ፈላሮ ጋቾሰጊራ። <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />ካያንሳ ጥንቃታ ዋኮያ ሙ እባዶኮያ? አባባ” አመ።<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />እሶና እስ እሲሮ ሃ አመን፤ “ዋኮያ ጎአምኔ፥ ‘ሀያ ሙን አማናና ዋተታን?’ አምናራ፤ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />ሀያ እባዶኮያ አምኖ?” ጎሳ ዱባ ያንሳ ኦግራን ካሄገሮ ላኖ አብዳተን ማንኮግሬን ማራን አብሳተን። <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />ሃንሱን የሱሳን “ኖ ላኮካንሶ” አመን አባበን። የሱሳና፥ “ጎርታኑን አንና ሂካ አዬስጆል ኤክ ኦዶናት አን ፈላሮ ላኮሰግናሮ” አመ።<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">ካዎይኒ አካክልተ ኦፈላራንኮክ ማሱሳ</para>
  <para style="r">(<ref loc="MRK 12:1-12">ማር. 12፡1-12</ref>፤ <ref loc="MAT 21:33-46">ማቶ. 21፡33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20፡9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />ኤሰኮና የሱሳ ሃ አማ ማሱሳይ እሶን ሰጋኖ ሀጋአበ፤ “እባዶት ኮ ካዎይኒ አካክልተ አባራተ፤ ማራሙርሰ ኦት ካተ፤ ዎይኒ ካኮሙላሮ ጉምቢና ኦሻተ፤ ታኦራሮ ታቀና ማዳራተ፤ ኤሰኮ ኦታተን ኦባራራዉን ክራይ ስሰጉረ ኡል ካካለ ሴተ። <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />ካም ታኮኩኩአማሮ ድግኒ ታዱባንተቶ ታዎይኒ ኢልኮ ጎጎኬናዉን ኡሱን ካሀንዳረኬሳ ኦታተን ኦባራራን ቶስ ፋረ። <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />እሶ ጎአመን አበን ቦጨን ገነ ታላልና ጋፋሬን። <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />አደና ካካለ ካሀንዳሮ ፋረ፤ እሶና መተኬሳ በረኤሰን የራሴን አባበን። <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />ግዳና አደ ካካለ ፋረ፤ ሂካና ላጋዴን፤ ኦካለ ኦሞጋን ኦሮኮ ኮኮ ቦጨራን፤ ኮኮና ላጋዴን።<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />“ግዳና ካፋራምናራ ካካለ ኡሱን ግረ፤ ኡሱና ኡሱ ካጌላታሮ ኤረኬሳየ፤ ‘ኤረኬ ካባጂናዋ’ አማ ዱባንኮ ዳንበኔ ፋረ።<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />“ኦታተን ኦባራራን ጎአመን እስኦሮ፤ ‘ሂክ ዋና ካኤላሮያ፤ ኮዬን ላጋንዶ፤ ኤሬቴሳ ታታን ለታ’ አመን። <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />ኤሰኮና አበን ላጋዴን፤ ታዎይኒ ባንኤኮ ሳር ቤሰን ሻፌን።<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />“ጎርታኑ ጋ ካዎይኒኮክ ኦዶ መ ካየልናሮ ኣን ላራ? ኤመይናራ፤ ኦታተን ኦባራራን ላጋድናራ፤ ካዎይኒ አካክልተ ኦካለቱን ስስናራ። <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />ጎርቱን፥</para>
  <para style="q1" vid="MRK 12:10">“ ‘ግምበ ኦግንባራን ካቱፋተን ኤኤሞ፥</para>
  <para style="q2" vid="MRK 12:10">ኡሱ ምና አፋሩን መተ ሌ፤ አማመ ካጻፋመሮ ሃፉራ ላኮናባብቴታንያ? <verse eid="MRK 12:10" /><verse number="11" style="v" sid="MRK 12:11" />ሂካ ካፈለራ ጎታያ፤ ህክና ኢልኦ ኦታኒ ካሳድስሮያ።’ ”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />አይሁድኮክ ዎይቻል የሱሳ ማሱሳይ ካኮአየሰራ ጋራክሶ ላኖ ካኮአዴሳረ ጎራታ ኡሱ አብን ዶተ፤ አየሱን ጎአመን ጎሳ ማንኮአብሳታረ ማራን ኢሰ ሴተ።<verse eid="MRK 12:12" /></para>
  <para style="s1">ቄሳርን ጊራ ሙራኖኮክ ጋራ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር. 12፡13-17</ref>፤ <ref loc="MAT 22:15-22">ማቶ. 22፡15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20፡20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />ኤሰኮና አየስ ሄገልኮ ኣት አብን ካፋራሳው እባዶኮና ታሄሮዶሳ ኡናኮ እባዶ የሱሳ ቶስ ፋረን። <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />እሶና ኤመተንጉረን፤ “ካአጋልስሳቶ፤ አት ካሩም እባዶት ላኖካ ካንሶዋ፤ በቤድ ታእባዶ ዴተ ኮ ቶስ ሀኡሉልሶን ካዋ ራ ካላል ሩም አጋልስሳታ፤ ጎሌና ቄሳርን ጊራ ሙርን ዶትሳራ ሙ ላኮዶትሳሮያ? ኖ ሙርኖ ሙ ላኮሙርኖያ? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />የሱሳ ጎአመን ኢፍሳዳ ላኖክሶ ማላበረ፤ ሙን እንኮ አየስ ሄገልኮ ኣትን ዶታታን?” አላ ድናር ኮ ኬና አን ዴሮ አመ። <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />እሶና ከኔን፥ “ህት ምዲ ታዮታ? ጻፋኖ ካዮያ?” አመ እሶ ሆሳተ፥</para>
  <para style="p" vid="MRK 12:16">“እሶና ታቄሳርታ” አመን።<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />የሱሳና፤ “ካቄሳር ካሌሮ ቄሳርዉን ስሳ ካዋ ካሌሮ ዋዉን ስሳ” አመ።</para>
  <para style="p" vid="MRK 12:17">እሶና ኡሱይ ማሜን።<verse eid="MRK 12:17" /></para>
  <para style="s1">ጎይኮ ክያኖኮክ ጋራ</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር. 12፡18-27</ref>፤ <ref loc="MAT 22:23-33">ማቶ. 22፡23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20፡27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />ሂታኮ ሆረንባን ጎይኮ ክያኖ ላኮግሮ ኦአማራን ካሶደቃውል እባዶ የሱሳ ቶስ ኤመተጉረ ሃ አማ ሆሳተ፤ <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“ካአጋልስሳቶ፤” እባዶት ኮኮክ አቢ ኦር አታይጉረ ይስ ሀኡሙሎን ጎጎየ፥ “ሂክ እባዶት ህታ ሄለልትቲ አታይጉረ አቢኬሳት ሳኒ ጎጎካይሮ አመ ሙሴ ጻፈራ። <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />ሀያ አቢላል ቶዶባ ግቴ፤ ካሆሬ አታተረ ሳኒ ሀካኖን ጎየ፤ <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />ካላምክና ህታ ሄለልትቲ አታተ፤ ኡሱና ሳኒ ሀካኖን ጎየ፤ ካሴድና ሂካማሌ፤ <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />ቶዶባ ዱባና አታተን ሳኒ ጎአመን ላኮካተን፤ ዳንበኔ አደ ሄለልትቲ ጎተ። <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />ጎርታኑ ቶዶባ ዱባና አታተራን ጎይኮ ታክያኖ አሪ ህናኣኮ ኤሰ አዮን ኦር ልናታ?” አመን።<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />የሱሳና እሶን ሃ አመ አባበራ፤ “ካኮሽርአማታን ቁሎለ ማጻፋልና ሁና ካዋ ማንኮካሳናዋተን ማራንያ። <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />ኦጎየራን ጎይኮ ካኮኬራን ጎራታ ካዳሩረ ኤርግቻል ኣን ልናራን ኳሬ ላኮአታታራን ላኮናኬሳማራን። <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />ጎይኮ ከያኖኮክ ጋራ ጎአመን ካሙሴ ማጻፋይ ህክና ጋራ ካሁርስ ታአዬሰሮ ክፍል ዋ ‘አን ካአብራመ ሄዶ፥ ካይሳቃ ሄዶ፥ ካያይቆባ ሄዶያ ካአመሮ ላኮናባብቴታንያ?’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />ዋ አርዶኒዕኮክ ሄዶያ ኳሬ ካጎይ ሄዶ ላኮዮ፤ ሃንሱን ኣሎ ሽርንተታን።”<verse eid="MRK 12:27" /></para>
  <para style="s1">ዱባንኮ ካሮራሮ አጃጃ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር. 12፡28-34</ref>፤ <ref loc="MAT 22:34-40">ማቶ. 22፡34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10፡25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />ሴራ ካሙሴ ኦአጋልስሳራንኮ ኮ ኤመተጉረ ዶጋማግራን ማለ፤ የሱሳና ኡሱ ቶስ ታኤሜተተ ሆሲኑን አባብ ካእዳን እሶን አባባኖ ሻደረ፥ “አሚና፤ ኣጃጃ ዱባኮ ካሮራራ ኤክያ?” አመ ሆሳተ።<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />የሱሳና ሃ አመ ኡሱን አባበ፤ “ዱባንኮ ካጂናታራ አጃጃ ሂካያ ‘እስራኤል ማል፤ ጎታ ሄዶካን ጎታ ኮያ፤ <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />አትና ጎታ ሄዶካ ዱዶት ዎዳናታይ፥ ዱዶት ኔፎታይ፥ ዱዶክ ያዳካይና ዱዶክ ሁናካይ ጌላ።’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />ካላምክ አጃጃና ሂካ ኣን ካላሮያ፤ ‘ኦላታ እስኦታ ኣን ጌላ’ ካአማሮያ። ሂናኣ አጃጃ ላማኮ ካሮራራ ካካለ አጃጃ ላግሮ።”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />ሴራ ካሙሴ ካአጋልስሳራና የሱሳነ ሃ አመ፤ “ካአጋልስሳቶ!” “ታኢዳን አንተታ፤ ዋ ኮያ፤ ኡሱኮና ካካለ ግራናዋት አዬሳኖካ ሩምያ፤ <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />ሃንሱን እባዶ ዱዶት ዎዳናታይ፥ ዱዶት ሳሙታይ፥ ዱዶት ኔፎታይ፥ ዱዶክ ሁናካይ ጌላታኖ፥ ኡሱማለና ኦላታ እስኦታ ኣን ጌላታኖ፥ ካጉባማሮ ጃርሶ ዱባኮና ካካለ ጃርሶጆልኮ ሮራራ።”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />የሱሳ ሴራ ካአጋልስሳረክ ቃሩማና ሻድኮ አባባኖ ዴጉረ፥ “አት ዎኖናት ዋኮ ፋክ ካአንተ ላኮቶ” አመ። ሀሴኮ አባባተረ ሆሳይን ካጃባተ ኮና ላኮግሮ።<verse eid="MRK 12:34" /></para>
  <para style="s1">ክርስቶሳ ኤረ ካዮያ</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር. 12፡35-37</ref>፤ <ref loc="MAT 22:41-46">ማቶ. 22፡41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃ. 20፡41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />የሱሳ ቁሉክ ምን ካዋኮክ አዉዲ ካኮአጋልስሳረ ጎራታ ሃ አማ ሆሲን ሆሳተን፤ “ሴራ ካሙሴ ኦአጋልስሳራን ክርስቶሳ ኤረ ካዳዉተያ ምሲ አማራን? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />ዳዉተና መተኬሳዉን ቁሉክ አያናይ ከኬጉረ፥</para>
  <para style="q1" vid="MRK 12:36">“ ‘ጎታ ጎታክ፥ ዲናካ ሉቃኦታ ሄገሊ አን ኩን</para>
  <para style="q2" vid="MRK 12:36">“ታ የሎ ጌግን መርገቴይ ሀማጺ አመ አማራ።” ’<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />ሀያ ዳዉተ መተኬሳን ‘ጎታ’ ጎአምሮ፤ ምሲ አባባተ ኤረ ላራ?”</para>
  <para style="p" vid="MRK 12:37">ጎሳ ካሞጋንና ገጌሎይ ማላ ግረ።<verse eid="MRK 12:37" /></para>
  <para style="s1">ሴራ ካሙሴ ኦአጋልስሳራንኮኒዕ ፈሎኮ እስኦራታኖ</para>
  <para style="r">(<ref loc="MRK 12:38-40">ማር. 12፡38-40</ref>፤ <ref loc="MAT 23:1-36">ማቶ. 23፡1-36</ref>፤ <ref loc="LUK 20:45-47">ሉቃ. 20፡45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />የሱሳ ካኮአጋልስሳረ ጎራታ ሃ አመ፤ “ሴራ ኦአጋልስሳራንኮ እስኦትስን ኦራዬን፤ ካኤር ቆሎ ሳርሳቴንጉረን ማራሙር ሰሴይን ጌላታራን፤ ግያ ኦሮና ታካባጃንተ ኖጎዳ አታይን ዶታራን። <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />አይሁድኮክ ምን ካኤብና ካካባጃመ ባርጩማ፥ ባንኤ ታአሞይና ታካባጃንተ ባንኤ ዶታታራን፤ <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />ኤራስ ኤባታኖክሶ ኣላንቲ የላ ጋልታንተጆልኮክ ምን ሀዉአይ የላራን፤ ሂኒዕ ካአቲ ፊርዳ አታይናራን።”<verse eid="MRK 12:40" /></para>
  <para style="s1">ካጋልታንተ ሙጹዋታ</para>
  <para style="r">(<ref loc="MRK 12:41-44">ማር. 12፡41-44</ref>፤ <ref loc="LUK 21:1-4">ሉቃ. 21፡1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />የሱሳ ሙጹዋታ ካኮአባባራን ሳጢነ ዶሌ ሀማጼጉረ ካሞጋን እባዶ እላቦጆልኬሳ ቁሉክ ምን ማራጋደ ካኮካማሮ ሳጢነ ኦሮ ሉጉዳ ግራን ዲያ ግረ። ካሞጋን ዱሬሳልና ካሞጋን ማራጋደ ሉጉደን፤ <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />ህየት ጋልታንተት ቶ አደ ማላቃ ላማ ታናስ ማራጋደ ሉጉደ። <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />የሱሳ ኡሱኮ ኦአጋልሳታራን “ኡመጉረ፥ ሃ አመራ፤ አን ሩምና አማራ፤ ህት ህየት ጋልታንተት ሳጢነ ኦሮዴሴን ኦሉጉዴራን ኦካለኮ ካጂናሮ ሉጉደታ። <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />ሂኒዕ ዱባ ካሄላቴራን ዎረኤኮ ስሴራን፤ ኤሰ ጎአመን ህዩማትሴኮክ ሁናኮ ዱባ ባሪሳኖዉን ኤሰን ካሌሮ ሀሃሳኖን ጎጎግሮ ስሰታ” አመ።<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">ካጌስጆል ጉዳታኖኮክ ማላታ</para>
  <para style="r">(<ref loc="MRK 13:1-13">ማር. 13፡1-13</ref>፤ <ref loc="MAT 24:1-2">ማቶ. 24፡1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21፡5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />የሱሳ ቁሉክ ምን ካዋኮ ብያ ግራን ኡሱኮ ኦአጋልሳታረንኮ ኮ፥ “ካአጋልስሳቶ፤ ኤኤሞጆል ምሲ ግሮ፥ ካግንበ ምን ምሲ ካኢዳሮዮ ዴና” አመ። <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />የሱሳና አባበረ፥ “ሂክ ካጂንጂን ግምቤጆል ድያታ? ኤኤሞ ኮ ካካለይ ጉት ጎጎግሮ ላኮሄስናሮ፤ ዱባና ካዲጋምሮያ” አመ።<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />የሱሳ ቁሉክ ምን ካዋ ሆረ ዛይት ካብያራ ጋ ታኮአላታሮ ዎዳም ጉት ሀማጼ ግራን ጴጢሮሳ፥ ያይቆባ፥ ያንሳነ እንድራሳነ ካለ ኡሱ ቶስ ጋባላመን ሃ አማ ሆሳተን፤ <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“ሂክ ጎረ ልናሮ ኖን ሰጊ፤ ሂክ ዱባ ጉዳይን ካኮ ጋባላመ ጎራታ ካቱስናራ ማላታ መያ?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />የሱሳና ሃ አማኖ ሀጋአበ፤ “ማዮና እስን ጎጎሶቦንኮ እስኦትስን ኦራዬን፤ <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />ኦሞጋንና ‘አን ክርስቶሳያ’ አማ መገኬይ ኤሜይናራን፤ ካሞጋን እባዶና ሶብናራን። <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />እስን ዶሌ ጀሬን ክያኖና ኤባ ጀሬንኮት ኦዱ ካኮማልቴን ጎራታ አሮነይቴን፤ ሂክ ሊን ዶትሳራ ጋቾ አደ ጋናታ። <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />ጎሳ ጎሳይ ጉት፥ ዎኖ ዎኖይ ጉት፥ ኪናራ፤ ባንኤ ታሞጋን ኡልኮክ አአኖና ኡኢ ልናራ፤ ሂክ ዱባ ካኡሙላ ሙዳማ ካሆራርጄያ።<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“እስን ጎአመን እስኦትስን ኦራዬን፤ እስን ሾንጎዉን ሮርስ ስስናራን፤ ካአይሁድኮክ ምን ካኤብና ቦጭናራን፤ አቶ ጎጎሌታኑን ኣላንቲቴይ ሞትጆልና ዎኖላል ሆረ አልናታን። <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />ዱባንኮ ጣይ አደ ዎንጋላ ጎሳ ዱባን ላላባማኖ ዶትሳራ። <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />አባምዴን ፍርዳን ካኮስሳንታን ጎራታ፥ ኤሰ ሳቲ እስኑን ካስሳማሮ ካላል አዬሳ ኳሬ መ አዬንሳ አማ ጣይ አሮጫናቃንቴን፤ ካአዬሳራ አያና ቁሉክ ኳሬ ላኮእስንታን። <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />አቢ አቢኬሳ፥ ኦዶና ኤረኬሳ ጎይን ሮርስ ስስናራ፤ ይሳስ ኦኡሙለራን ጉት ዲና ልናራ፤ ላጋድናራ። <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />ኣላንቲቴይ እባዶ ዱባ ዶሌ ኦዲዳንቴን ልናታን፤ አየሱን ጎአመን ታ ጋቾ ጌሮ ካአታተ ሀሱ ፋያራ።”<verse eid="MRK 13:13" /></para>
  <para style="s1">ታጫናቅሳቶ ራኮ</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር. 13፡14-23</ref>፤ <ref loc="MAT 24:15-28">ማቶ. 24፡15-28</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21፡20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“ባስኮክ ባትናት ሙትን ታኮዶትሶን ባንኤ አሌ ግራን ካኮዴተን ጎራታ ካናባበራ ሀሻዶ፤ ኡል ካይሁዳይ ኦግራና ዎዳም ቶስ ሀባቃተን፤ <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />ምንኬሳት ሄልንቾ ጉት ካግራ አሮዳጎ፤ ሁኬሳና ቤሳይን ምን ኦሮድ አሮታቦ፤ <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />እራ ካግራና ሳርስኬሳ አታይን ሃር አሮአባባኖ። <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />ኤሰ አሪ ሄለል ካፋቶዉና ካኢልሳሮዉን ራኮ ታአቲ ለታ! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />ህክና ባጠሳይ ጎጎሌኖንኮ ኤባየን፤ <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />ኣላንቲና ሆራርጀ ዋ መጣ ታኮመጠሮ አርኮ ኬሰጉረ ታ ህታር ጌሮን፥ ታልካሶን ራኮ እባዶን ኤመይናታ፥ ሆረንባዉን ታሌኖን ራኮ ታአቲ እባዶ ጉት ኤመይናታ። <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />ጎታ ሀኑኡ አርጆል ጋባቢስ ዋተዋ ማዮና ላኮፋይናረ፤ ዋ ኦአሳባሜራን ማራን አመጉረ አደ አርጆል ጋባቢሰራ። <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />ሀሱ ጎራታ ማዮና፤ ‘ሂክማ፤ ክርስቶሳ ሀሴ ግራ፥’ ሃ ጎአመና ጎርቱን፥ ‘ሂክማ፤ ህታኒ ግራ’ ጎአመን አሮአብዳቴን። <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />ኦጣራ ክርስቶሳጆልና ኦጣራ ኦሄገሮል ኪናራን፤ ባሳና ካሳዳምሮ ፈላ እሶን ጎዳንዳመ ኦአሳባሜራን ዱዶ ሽርሳራን። <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />አየሱን ጎአመን ጎራታ ሀንጌኖን አን እስኑን ሰገራ፥ ሃንሱን እስን እስኦራዬን።<verse eid="MRK 13:23" /></para>
  <para style="s1">ኤረ ካእባዶኮት ኤመቶ</para>
  <para style="r">(<ref loc="MRK 13:24-27">ማር. 13፡24-27</ref>፤ <ref loc="MAT 24:29-31">ማቶ. 24፡29-31</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21፡25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“ሀሱ ጎራታ፥ ራኮኮ ዳንበኔ</para>
  <para style="q1" vid="MRK 13:24">“ ‘አርት ሙጉድ ልናታ፥</para>
  <para style="q2" vid="MRK 13:24">ድግንና ኢፋክሴ ላኮስስናቶ፤<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />ባራጃና ዳሩርኮ ኡባይናራ፤</para>
  <para style="q2" vid="MRK 13:25">ዳሩር ካግራ ሁናና ሻላጋምናራ።’<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />“ሀሱ ጎራታ ኤረ ካእባዶ ካአቲ ሁናይና ካባጃ ዱማንቻይ ኤመታ ግራን ኡሱ ድናራን። <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />ኡሱና ኤርግቻ ፋርጉረ ምና አፋርኮ፤ ኡልኮት ጋቾኮ ታ ዳሩርኮት ጋቾ ጌሮ ዋይ ኦአሳባሜራን ኩኩይስናራ።<verse eid="MRK 13:27" /></para>
  <para style="s1">ጋ ካባላስኮክ ማሱሳ</para>
  <para style="r">(<ref loc="MAT 24:34-35">ማቶ. 24፡34-35</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21፡29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“ጋ ካባላስኮክ ማሱሳ አጋልሳዬን፤ ባላል ጎሁርስሮ ባላሎና ጎጫሪድናን ባጤሳ ጋባላማኖ አዴሳታን፤ <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />ኡሱማለና አደ ሂካ አዬስጆልኮክ ጉዳታኖ ጎዴተን ኤረ ካእባዶኮት ኤመቶ ጎጫይ ጋባላማኖ አዴሳ። <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />አን ሩምና አማራ፥ ሂክ አዬስጆል ታጉዳሮ ጌግን ህት አላታን ዱዶ ላኮሮርቶ፤ <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />ዳሩርና ኡልና ሮራንዋ ሃፉራክ ጎአመን ላኮሮሮ።<verse eid="MRK 13:31" /></para>
  <para style="s1">አርና ሳትና ላኮአዴሳማቶ</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር. 13፡32-37</ref>፤ <ref loc="MAT 24:36-44">ማቶ. 24፡36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“አየሱን ጎአመን ኤሰ አርና ኤሰ ሳቲ ኦዶ ኳሬ፥ ካካለ ጎሄሰና ካዳሩረ ኤርግቻልና ሌረን፥ ኤረኬሳ ጎሌና፥ ማዮና ላኮካሶ። <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />ሃንሱን ጎራታ ማጎሬ ልናሮ ላኮካሳን እስኦራዬን፤ አታዬን። <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />ህክና ምንኬሳ ኦኦራናዉን ስሰጉረ፥ ኦሀንዳራዉን መተመተይ ፈሎ ሄደደ ስሰጉረ፥ ካኦራራ አታይ ጎጎኦሮን አጃጄረ ካሴተሮ እባዶት ኣን ላራ።<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />“ጎርታኑን ኦዶ ምኔ እብቶ ጎርቱን ሄመን ጠኤ፥ ሉካለ ኦዋ ጎርቱን ኡል ቡላ ኦዋ ኤሜይናሮ ጎራታ ላኮካሳን፤ ሃንሱን አታዬን ኦራዬን። <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />ኦዶምኔ እስን ደራኣ ግራን ጎኤመተ ሁዱርቴን ኦግታን አሮዴኖ! <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />አን እስኑን ካሰገሮ እባዶ ዱባን ሰግናራ፤ አታዬነ፥ አመ።”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">የሱሳ ላጋዲን ካፈላመሮ ዳባ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26፡1-5</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፡1-2</ref>፤ <ref loc="JHN 11:45-53">ያን. 11፡45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />ካፋስካና ካባቦ ባላ ካባጃምን አሪ ላማ ሄሰ ግራን ካቱቃሞል ዎይቻልና ሴራ ካሙሴ ኦአጋልስሳራን የሱሳ ሚጌይ ካኮአብራና ካኮላጋድራን ራ ዶታ ግረን። <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />አየሱን ጎአመን፤ “ጎሳ ኦኮ ጎጎኬሶንኮ ካባላ አልማይ ላኖ ላኮዶትሳሮ” አማ ግረን።<verse eid="MRK 14:2" /></para>
  <para style="s1">የሱሳን ሽቶ ታክብተቶ ሄለልትቲ</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር. 14፡3-9</ref>፤ <ref loc="MAT 26:6-13">ማቶ. 26፡6-13</ref>፤ <ref loc="JHN 12:1-8">ያን. 12፡1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />የሱሳ ካብታንያ ማማኒ ማሪ ባር ካአቦኮክ ካስሞና ምኒ ባቦ ኣምን ሀማጼ ግራን፥ ሄለልትቲ ቶ ዶክ ኣሎ አዉኣሎ ታሌተቶ ሙጭ ታአንተ ናርዶሳ ካአማማሮ ጋኮ ታፈላንተቶ ሽቶይ ካአማጋመሮ ካአልባስጢሮስ ብልቃደ አብቴ ኤመቴ፥ ብልቃደና ኤብሰጉዴ ሽቶ የሱሳ ጉት ክክብቴ። <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />ኤሰ ኦግሬንኮ ኮኮ ፈሎኦትሴይ አማራተንጉሬን እስኦሮ ሃ አማ ግረን፤ “ህት ሽቶ ሙን አዳ. ዳርአማታ? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />ህት ሽቶ ሴድ ቦሌ ድናርኮ ጉንተ ዳዳላምጉደ፥ ሂካ ማራጋደ ህየሳን ስሰንዋ ካእዳንክየ” ሄለልትቲና ቱፋተን።<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />የሱሳ ጎአመን ሃ አመ፤ “ኢሳ፥ ኤሰ ሙን ራክሳታን? ኤሰ ፈሎ ኦኢዳን ኢን ፈልተታ። <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />ህየሳል ማጎሬና እስን ዎታ ግራን፥ ካኮዶተን ጎራታ እሶን ታኢዳን ፈልን ዳንዳታን፤ አን ጎአመን አርጌቶ እስኔ ዎታ ላኮግርናሮ፤ <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />ኤሰ ፈልን ካዳንዴተቶ ግታክ ፈልተታ፤ ቃማላማኖኬዉን ጎጎሌሮን ጣይተ ማርኬይ ሽግደ። <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />አን ሩምና አማራ፤ ሂክ ዎንጋላ ማንኮሰጋማሮ አላም ዱባ ማምስት ባንኤይና ሂክ ኤሰ ካፈልተታ ሻዳኖ ሊ ሰጋምራ” አመ።<verse eid="MRK 14:9" /></para>
  <para style="s1">ይሁዳ የሱሳ ሮርስ ስስን ኤካታኖ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ. 26፡14-16</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22፡3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />ሂታኮ አባባተረ ቶሞንኮ ላማኮ ኮ ካሌራ ካአስቆሮቱ ይሁዳ የሱሳ ሮርስ ስስን ካቱቃሞል ዎይቻል ቶስ ኤመተ። <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />እሶና ሂካ ካኮማላረን ጎራታ ገጌላተን፤ ማራጋደ ስስን ኤካተን፤ ሃንሱን የሱሳ ሮርስ ስስን ካኤካሮ ጎራታ ዎቻታ ግረ።<verse eid="MRK 14:11" /></para>
  <para style="s1">ካፋስካ ክታ ካሄመነ</para>
  <para style="r">(<ref loc="MRK 14:12-21">ማር. 14፡12-21</ref>፤ <ref loc="MAT 26:17-25">ማቶ. 26፡17-25</ref>፤ <ref loc="LUK 22:7-23">ሉቃ. 22፡7-23</ref>፤ <ref loc="JHN 13:21-30">ያን. 13፡21-30</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፡23-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />ካፋስካ ኢዳዶ ካኮኤናኣማሮ ካባቦ ባላዉን ታሆሬ አሪ፥ የሱሳኮ ኦአጋልሳታረን ኡሱ ቶስ ጋባላመንጉረን፥ “ካፋስካ ክታ ካሄመነ ሀጌ ኖ ኩን ጎጎኤካንሶ ዶታታ?” አመን። <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />የሱሳ ኡሱኮ ኦአጋልሳታራንኮ ላማ ሃ አመ ፋረ፤ “ካታማ ቶስ ሴዬን፤ ኡላ ታበከ ካስዳተራ እባዶ ራድ ኤሰሎዋ፤ <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />ኡሱ ካኮታባሮ ምን ዴበ ሰዬን፤ ኦዶ ምነኔ፥ ካአጋልስሳራ፤ ‘እንኮ ኦአጋልሳታራነ ዎታ ካፋስካ ክታ ካሄመነ ካኮአምራ ካማርት ምን ኤክያ?’ አመራ አማ። <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />ኡሱና እስግቶ ካግሮ ምንኮ ካጉተ ምን ያመና ኤካተ ካግሮ ምን ካባላኣን ቱስናራ፤ ኤሴና ኤካሳ።”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />ኡሱኮ ኦአጋልሳታረና ኤሰ ካታማ ቶስ ቤን፤ ካመን ዱባ የሱሳ ጎጎአመሮ ካሌሮ ዴን፤ ፋስካ ክታ ካሄመና ኤካሰን። <verse eid="MRK 14:16" /><verse number="17" style="v" sid="MRK 14:17" />ኡል ሄመን ካኮላረ ጎራታ የሱሳ ቶሞንኮ ላማነ ዎታ ኤመተ። <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />ኣሞ ጉት ግራን፥ “አን ሩምና አማራ፥ እስን ኦሮኮ ኮ፥ ኢነ ዎታ ካአማራ ኡሱ እን ሮርስ ስስናራ” አመ።<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />እሶና ያደነን፤ እሶና መተመተይ፥ “አን ሌዉና?” አማኖ ሀጋአበን። <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />የሱሳና፤ እስን ቶሞንኮ ላማ ኦሮኮ ኮ፥ ኢነ ዎታ ገነ ያላኣይ ካዳግሳሮያ። <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />ኤረ ካእባዶ ጋራኬሳ ጎጎጻፋመሮይ ጎይናራ፤ ኤረ ካእባዶ ሮርሰ ካስሳሮን ሀሱ እባዶትን ጎአመን ኣኔ! ሀሱ እባዶት ሀኡሙላሞን ሄስ ግረዋ ኢዳረ።<verse eid="MRK 14:21" /></para>
  <para style="s1">ቁሉክ ካዋ ባቦኮክ ሴራ</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር. 14፡22-26</ref>፤ <ref loc="MAT 26:26-30">ማቶ. 26፡26-30</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22፡14-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፡23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />አማ ግራን የሱሳ ባቦ ኬሰጉረ ሶማሳተ፤ ኤካኤብሰጉረ ኡሱኮ ኦአጋልሳታራዉን ስሳ፥ “አህአይ፤ ሂኒዕ ሶኦቴያን” አመራ። <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />ጡጋና ኬሰጉረ ሶማሳተ እሶን ስሰ፤ ዱባና ኤሰኮ ጣሜን። <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />አደና ሃ አመ፤ “ሂክ ኦሞጋን ማራን ካኡባታሮ ካአማቶ ኢግኬያ፤ <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />አን ሩምና አማራ፤ ዎኖናት ካዋይ ካኡሱብ ካዎይኒ ጣሞ ታኮጣምሮ ኤሰ አሪ ታጌጊሮን ዱዶ ላኮጣምናሮ።” <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />ማዛሙር ዛማሬን አባባቴንጉረን ደብረዘይት<note caller="+" style="f"><char style="fr" closed="false">14፡26 </char><char style="ft" closed="false">ደብረዘይት አማኖ ዛይቲ ካኮብያታ ጋ ታኮአላታሮ ዎዳም አማኖያ። </char></note> ዎዳም ቶስ ቤን።<verse eid="MRK 14:26" /></para>
  <para style="s1">ጴጢሮሳኮክ ካካታኖ የሱሳ ጣይሰ አዬሰ</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር. 14፡27-31</ref>፤ <ref loc="MAT 26:31-35">ማቶ. 26፡31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፡31-34</ref>፤ <ref loc="JHN 13:36-38">ያን. 13፡36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />የሱሳ ኡሱኮ ኦአጋልሳታራነ፤ “ካፎፌ ባስናራ፤ እዳድና ዳርአምናራ አማመ ጎጎጻፋመሮ እስን ዱባ እን ካካይናታን። <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />አየሱን ጎአመን አን ካኮኬ ጎራታ አድ፥ እስንኮ ጣይ ጋሊላ ቶስ ሴይናራ።” <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />ጴጢሮሳና፤ “ዱባ ጎሀንዱዱፋተና አን ሱረ ኩ ላኮሀንዱዱፋይናሮ” አመ። <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />የሱሳና፤ “አን ሩምና አማራ፤ ህታ ሄመን ሉካለ ላማ ጋል ሀኦይኖን ግራን፥ አት እን ሴድ ጋል ካካይናታ” አመ። <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />ጴጢሮሳና አደ፤ “ኩኔ ዎታ ካጎይሮ ጎሌና ሱረ ላኮካካይናሮ” አማ ኣሎ አታይሰ አዬሰ። ዱባና ኡሱማሌዋ አመን።<verse eid="MRK 14:31" /></para>
  <para style="s1">የሱሳ ጌተሰማን ታአማማቶ ባንኤ ካኤባተሮ ኤብ</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር. 14፡32-42</ref>፤ <ref loc="MAT 26:36-46">ማቶ. 26፡36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፡39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />ኤሰኮ አባባተረን ጌተሰማን ታአማማቶ ባንኤ ቶስ ሴተን፤ የሱሳና ኡሱኮ ኦአጋልሳታራነ፥ “አን ኣንቴ ሴይ ኤባሮ እስን ህታኒ ሀማጻ” አመ። <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />ጴጢሮሳነ፥ ያይቆባነ፥ ያንሳነ ዎታ ኣተ ሴተ፤ ኣሎ ያዳኖና ጫናቃማኖ ሀጋአበ። <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />አዴ፤ “ኔፎትና ታ ጎይን ጌቶ ኣሎ ያደ። ህታኒ ሄሳዴን አታዬን ኦራዬን” አመ።<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />እሶኮ አባራን ሽጲ አመረ ሆረሆረ በቤዲ ኡል ኦየረ ካዳንዳመ ጎሌ ሀሴ ሳቲ ጎጎሮርቶ ኤባታ፥ <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />“ኣቦኬ! ካመን ዱባ ኩዬን ዳንዳማራ፤ ህታ ታራኮ ጡጋ እንኮ ኬስ፤ አየሱን ጎአመን ፈኢቴ ሀሌኖን ግራን ፈኢታክ ማለ ሀሌዎ” አመ።<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />አባባይ ኡሱ ጎኤሜሮ ኡሱኮ ኦአጋልሳታረን ሁዱረን ኦግራን ሄለ፤ ጴጢሮሳነ ሃ አመ፥ “ስሞና፥ ሁዱርተታ? ሳቲ ቶና ሱረ አታይ ናባድ ኦራይን ዋተ? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />ጫፍቲ ኦርድ ጎጎታቦንኮ አታዬን ኤባየን፤ አያና ኤካተ ግራ፥ ሶ ጎአመን ኦሀራራንያን።”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />አደና ሴተጉረ ሆራርጀ ካኤባተሮዋ አደ ኤባተ። <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />ካላም ጎአባባሮ ኢልኦ ኦትሶይ ሁዱሮ እስላተደ ኦሁዱሬራን ዴ፤ ኡሱን ታአም አባብራና ላኮካሳናየን።<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />ካሴድ ጎራታና ኤመተረ ሃ አመ፤ “ግዳ ሁዱርቴን ፎልሳዬን ግታን? ጎርታ ሌራ! ሳትና ጌተታ፤ ሂክማ፤ ኤረ ካእባዶ ጩባለሳልኮት ገነ ሮርሳም ስሳምናራ። <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />ክያ፤ ሴኖ፤ እን ሮርስ ካስስናራ ጋባላመራ!”<verse eid="MRK 14:42" /></para>
  <para style="s1">የሱሳ አባመ</para>
  <para style="r">(<ref loc="MRK 14:43-52">ማር. 14፡43-52</ref>፤ <ref loc="MAT 26:47-56">ማቶ. 26፡47-56</ref>፤ <ref loc="LUK 22:7-53">ሉቃ. 22፡7-53</ref>፤ <ref loc="JHN 18:3-13">ያን. 18፡3-13</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ጎርሰዋ ኡሱ አዬሳ ግራን ቶሞንኮ ላማኮ ኮ ይሁዳ ኤመተ፤ ኡሱነ ዎታ ሺፋና ዱላ ኦአባተረን፥ ካቱቃሞል ዎይቻልኮ፥ ሴራ ካሙሴ ኦአጋልስሳራንኮና ጃርሶለኮ ካፋራመረ እባዶ ግረ። <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />ሮርስ ካስስናራ ይሁዳ፥ “አን ካአንጋታራ ኡሱያ አባ፤ ኦራ ጌሳ” አማ ጣየ ማላታ እሶን ስሰ ግረ።<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />ጎጎጌይ ጎርሰዋ የሱሳ ቶስ ጋባላመጉረ፥ “ካአጋልስሳቶ!” አመ አንጋተ፤ <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />እባዶና የሱሳ አበን ሽዬን። <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />ዶሌ አሌን ኦግሬንኮ ኮ ካቱቃሞል ዎይቻቲን ካሀንዳረኮት ነበ ጎሰ። <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />የሱሳና ሃ አመ፥ “ሽታ አን እን አብን ሺፋና ዱላ አብቴን ኤሜቴን? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />አርጌቶ ቁሉክ ምን ኦሮ እስን አጋልስሳ እስኔ ዎታ ታኮግሬይ ላኮአብተቴን፥ አየሱን ጎአመን፤ ማጻፋ ጉዳይን ሂክ ሌ።”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />ሀሱ ጎራታ ዱባና ኢሰን ባቃተን።<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />ሀዉአይቴሳ ጋሼይ ካጎልሰረ ዎዳላት ኮ የሱሳ ዴበ ሰሴታ ግረ። እባዶና ሂካ ዎዳላት ካኮአባረ ጎራታ፥ <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ኡሱ አደ ጋሸቴሳ ሻፈጉረ ሀዉአይ ባቃተ።<verse eid="MRK 14:52" /></para>
  <para style="s1">የሱሳ ታፍርዳ ሾንጎ ቶስ ጌሳኖ</para>
  <para style="r">(<ref loc="MRK 14:52-65">ማር. 14፡52-65</ref>፤ <ref loc="MAT 26:57-68">ማቶ. 26፡57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22፡54-55</ref>፥<ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ያን. 18፡13-14</ref>፥<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />የሱሳና ቱቃሞን ኦዶናት ካአቦኮክ አዉድ ቶስ ጌሰን፤ ኤሴና ካቱቃሞል ዎይቻል፥ ጃርሶለና ሴራ ካሙሴ ኦአጋልስሳራነ ዱባ ኩኩአመን። <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />ጴጢሮሳና ፋክመረ ዴበ ሰሴታ ቱቃሞሉን ኦዶናት ካአቦኮክ አዉድ ታ ጌሮ ሴተ፥ ኤሴና ኦሀንዳሬነ ዎታ ኤለን ጣንጣማ ግረ። <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />ካቱቃሞል ዎይቻልና ታሾንጎ ኡና ዱባ የሱሳ ላጋዲን ካአቶቲሮ ዶተን፤ አየሱን ጎአመን ሄልን ላኮዳንዴን። <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />ኦሞጋና ጣራ ጎአቶተና፥ አዬስክሶ ኮ ሊን ላኮዳንዴ።<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />ኮኮና ኬጉረን ሃ አማ ጣራ አቶተን፥ <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“ሂክ፥ ገነ ታእባዶ ካማዳርተቶ ቁሉክ ምን ባስጉረ ታሴድ አሪ ካካለ ገነ ታእባዶ ካንማዳሮን ግቶ አን ማዳርናራ፥ አማ ኖ ማልነና።” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />ህክና ሌ ግራን አቶናትክሶ ሱረ ኮ ላኮሌ።<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />ካቱቃሞል ዎይቻትና እሶ ሆረ ኬ አሌጉረ፥ “ሂኒዕ ኩዬ ጉት ካአቶታራን መያ? ሙን አባባናዋታ?” አማ የሱሳ ሆሳተ።<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />የሱሳ ጎአመን ጫልኢ አመ፤ ኮና ኡሱ ላኮአባበ፥ ቱቃሞሉን ኦዶናት ካአባ ግዳ አደ፥ ካሶማሳሳንቴ ኤረ ካዋ አትታ? አማ ሆሳተ።<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />የሱሳና፥ “እ አንያ፤ ኤረ ካእባዶ መርጌ ታዋይ ሀማጼ ግራን፥ ካዳሩረ ዱማንቻል ኤመታ ድናታን” አመ። <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />ካቱቃሞል ዎይቻትና ሳርስኬሳ ፊላ፥ ሃ አመ፤ “ካካለ ኤክ አቶ ዶትሳራ?” <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />“ሀባርኬሳ ማልቴታን፤ ሀያ መ ኣን ላራ?” እሶና ጎይን ዶትሳራ አማ ዱባና ህኢ ቶ ሌን ፍርዴን።<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />ሀሱ ጎራታ ኮኮ ሀንጩፈ ቱፋኖ ሀጋአበን፤ በቤዲ ሆጎግሰንጉረን ቶንቶሞይ ባሳ፥ “አላ ሄገሮ አየስ፤” አማ ግረን። ኦካለና ባላባንጆ ባሳ ጌሰን።<verse eid="MRK 14:65" /></para>
  <para style="s1">ጴጢሮሳ የሱሳ ካካታኖ</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር. 14፡66-72</ref>፤ <ref loc="MAT 26:69-75">ማቶ. 26፡69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22፡56-62</ref>፤ <ref loc="JHN 18:15-18">ያን. 18፡15-18</ref>፥<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />ጴጢሮሳ ቱቃሞሉን ኦዶናት ካአቦኮክ አዉዲ ኦሮ ምና ታሄገሌነ ግራን እሶን ኦሀንዳሬንኮ ቶ ኤመተዴ፤ <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />ጴጢሮሳ ኤለን ጣንጣማ ካሀማጼሮ ትችሰ ዴተጉዴ፥ “አት ካናዝረት የሱሳነ ዎታ ግቴ” አንተ።<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />ጴጢሮሳ አደ፤ “አት ካአማቶ አን ላኮካሶ፤ ጎርቱን ላኮሻዳሮ” አማ ካካተ። ኤሰኮ ካኮታባራን ጎጫ ቶስ ሳርዴ ቤ፤ ሀሱ ጎራታ ሉካለ ኦየ።<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />ድይትና ጴጢሮሳ ካኮድያተ ጎራታ ኤሰ ኦአሌረኑን፤ “ሂክ እባዶት ኡናትሶኮ ኮያ” አንቴ አዴ አዬሰ። <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />ኡሱ ጎአመን አደ ግዳና ካካተ። አባራን ጋጭመ ግራን ኤሰ ካአሌራ እባዶ ጴጢሮሳነ፥ “አት ካጋሊላ እባዶ ላኖካ አዴስሳራ፤ ኦግራን አት እሶኮ ኮታ” አመን።<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />ኡሱ ጎአመን፥ “እስን ካአማታን እባዶት አን ላኮካሶ” አማ ቃንጋኖና አማታኖ ሀጋአበ።<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />ጎርሰዋ ሉካለ ካላም ኦየ። ጴጢሮሳና፥ “ሉካለ ላማ ጋል ኦዋናኮ ሆረነ ሴድ ጋል እን ካካይናታ” ካአመረ ካየሱሳ ሃፉራ ቃል አመ። ኤሰኮና ዩሩሩ አመ ኦተ።<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">የሱሳ ጲላጦሳ ቶስ ጌሰን</para>
  <para style="r">(<ref loc="MRK 15:1-5">ማር. 15፡1-5</ref>፤ <ref loc="MAT 27:1-2">ማቶ. 27፡1-2</ref>፥<ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23፡1-5</ref>፤ <ref loc="JHN 18:28-38">ያን. 18፡28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />ባር ባሪኖ ካቱቃሞል ዎይቻል ጃርሶለ፥ ሴራ ካሙሴ ኦአጋልስሳራና ታሾንጎ ኡናነ ዎታ ጎርሰዋ ጦዬን አባባቴንጉረን የሱሳ ሽሼንጉሬን ጲላጦሳን ሮርሰን ስሰን። <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />ጲላጦሳና፥ “አት ካአይሁድ ዎኖታ?” አማ ሆሳተ፤</para>
  <para style="p" vid="MRK 15:2">የሱሳና “አት ጎጎአንተቶያ።”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />ካቱቃሞል ዎይቻልና የሱሳ ካሞጋን አየስ ሞቴን። <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />ጲላጦሳና፤ “ሙን አባብ ስሳናዋታ? ሂክማ ካሞጋን አየስ ኩ ሞተራን” አማ አደ ግዳና ሆሳተ።<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />የሱሳ አደ ኮና ላኮአባበ፤ ጲላጦሳና ማመ።<verse eid="MRK 15:5" /></para>
  <para style="s1">የሱሳ ጎይኮክ ፍርዳ ፍርዳመ</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር. 15፡6-15</ref>፤ <ref loc="MAT 27:15-26">ማቶ. 27፡15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፡13-25</ref>፤ <ref loc="JHN 18:39-40">ያን. 18፡39-40</ref>፤ <ref loc="JHN 19:1-16">19፡1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />ታባላ አሪ ካሽያመሮ እባዶ ኦሮኮ ኮ ጎሳ ካሆሳተራ እባዶ ጎጎፉራምሮን ካኮሆሳታረ ሴራ ግረ። <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />ሀሱ ጎራታ ሜላነ ከኬሳኖና ኔፎ ላጋዳኖይ ኦሽያሜራንኮ ኮ ካሌራ ባርባነ ካአማማራ እባዶት ኮ ግረ። <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />ጎሳና ጲላጦሳ ቶስ ኤመተጉረ ሴራክሶክ ማለ ሻጋ ጎጎየሎን ኤባተን። <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />ጲላጦሳና፥ “አይሁድኮክ ዎኖ ጎጎፉራምሮን ዶታታን?” አመ ሆሳተ። <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />ኣላንቲና ካቱቃሞል ዎይቻል የሱሳ ሚጌይ ሮርስ ስሳኖ አዴሳ ግረ።<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />ካቱቃሞል ዎይቻል ጎአመን ባንኤ ታየሱሳይ ባርባነ ጎጎፉራምሮ ጎሳ ጎጎሆሳሮይ ጎሳ ከኬሴን። <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />ጲላጦሳና አደ ግዳና፥ “ጎርታ ሂካ ካአይሁድ ዎኖ ካአማታን ምስ ጎጎየሎን ዶታታን?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />እሶና ግዳና አደን “ሱይና” አማ ኦኬን።<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />ጲላጦሳና፥ “ሙን? መያ ባስ ኡሱ ካፈለራ?” አመ። እሶ አደን፥ “ሱይና!” አማ ካሆሬኮ አታይሰን ኦኬን። <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />ጲላጦሳና ጎሳ ገጌላይስን ዶተረ ባርባነ ፉረ፤ የሱሳ አደ ቦጪሰጉረ ጎጎሱዋምሮን ሮርሰ ስሰ።<verse eid="MRK 15:15" /></para>
  <para style="s1">ዎታዳራል የሱሳ ጉት ቃጭፋተ</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር. 15፡16-20</ref>፤ <ref loc="MRK 15:16-20">ማር. 15፡16-20</ref>፤ <ref loc="MAT 27:27-31">ማቶ. 27፡27-31</ref>፤ <ref loc="JHN 19:2-3">ያን. 19፡2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />ዎታዳራልና ፕራይቶርዮን ካአማመሮ ዎኖኮክ ምን ቶስ የሱሳ ጌሰን፤ ካሄሰሮ ዎታዳራል ዱባ ራቶ ኩኩይሴን። <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ሄላክ ሳርስና ሳርስሴን፥ ካላቻ ካኤኤኔ ማማረንጉረን መተኬሳ ጉት ካዬን። <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />ኤሰኮና “ካአይሁድ ዎኖ፤ ሬድና!” አማ ቃጭፋታ ሳጋደን፤ <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />መተኬሳና ዳማይ ባሰን፤ ሀንጩፈና ኡሱ ጉት ቱፌን፤ ግልቢሴን ሳጋደን። <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />ቃጭፋተን አባባተንጉረን ሄላክ ሳርስ ቃረንጉሬን ካኬሳ ሳርስ ሳርስሴን፤ ሱይና ጌሰን።<verse eid="MRK 15:20" /></para>
  <para style="s1">የሱሳኮክ ሱዋማኖ</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር. 15፡21-32</ref>፤ <ref loc="MAT 27:32-44">ማቶ. 27፡32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፡26-43</ref>፤ <ref loc="JHN 19:17-27">ያን. 19፡17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />ካአለክሳንድሮስና ካሩፎስ ኣቦ ስሞና ካቀሬና እባዶት ኮ ካታማኮ ቃማነ ካግሮ ማማንኮ ኤመታ ግራን ኡሱ ማስቃሊ ስድስን ሁኖመን። <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />ኤሰኮና የሱሳ፥ ጎልጎታ ታአማማቶ ባንኤ ጌሰን፤ ፉረንና፥ “ቡቀ ታመተ” አማኖያ። <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />ፉልፉልሶነ ዎታ ካለዳመሮ ካዎይኒ ጣሞ ስሰን፤ የሱሳ አደ ዲደ። <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />ኤሰኮና ሱዬን፤ ሳርስኬሳና እሶ መተመተይ መ ግናሮ ማላባይን ኢጣ ሉጉዳተን ሳርስ ሄዴዳመን። <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />የሱሳ ካኮሱዋረን ጎራታ ባርኮ ሳቲ ሴድ ሌተ ግቴ። <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />ታሞቶ ጹፍና፥ “ካአይሁድ ዎኖ” ታአማቶተ። <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />የሱሳኔ ዎታ ሽታ ላማ ኬነንጉረነ ኮ መርገነ፥ ኮ በተነ ሱዬን። <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />“ኦሜላነ ዎታ ቶታመ” አማመ ማጻፋ ቁሉክ ካጻፋመራ ሃፉራ ጉዳተ።<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />ኡሱ ራኔ ካሮራራ ዱባና መተ አኢሳ ጭሎሻክ ሀባር ሀባራ ሃ አማ ግረ፤ “ቱ፥ ዴተነ! ቁሉክ ምን ባስዴ ታሴድ አሪ ማዳርናራ ካአማተ፤ <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />አላ ማስቃሊኮ ዳግጉደ እስኦታ ሃሳ!” አመን።<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />ኡሱማለና ካቱቃሞል ዎይቻልና ሴራ ካሙሴ ኦአጋልስሳረን ቃጭፋታ እስእስኦሮ ሃ አመን፤ “ኦካለ ፋይሰ፥ እስኦቴሳ ፋይሳይን ላኮዳንዴ፤ <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />ዲጉነ ጎጎአማኖን ኡሱ ክርስቶሳ ካእስራኤል ዎኖ ጎሌ አላ ማስቃሊኮ ሀንዳገ።” ኡሱነ ዎታ ኦሱዋሜሬና ሂካማሌዋ ጭሎሻክ ሀባር ሀባራሬን።<verse eid="MRK 15:32" /></para>
  <para style="s1">ጎይ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 15:33-39">ማር. 15፡33-39</ref>፤ <ref loc="MAT 27:45-56">ማቶ. 27፡45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፡44-49</ref>፤ <ref loc="JHN 19:28-30">ያን. 19፡28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />ሳቲ ሌኮ ሀጋአበረ ታ ሳቲ ሳጋሊ ጌቶ ኡል ዱባ ጉት ሙጉድ ሌ። <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />ሳቲ ሳጋሊ የሱሳ፥ “ኤሎሄ፥ ኤሎሄ ላማ ሰበቅታን?” አመ እዬ፤ ፉረንና “ሄዶኬ፥ ሄዶኬ እን ሙን ኢሴ?” አማኖያ።<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />ኤሰ ኦግሬንኮ ኮኮ ሂካ ማለንጉረን፥ “ኤላሳ ኡማራ” አመን። <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />ኤሰኮ እባዶት ኮ ቲየ ሴተረ ካኦኮኮታሮ ካዎይኒ ጣሞ እስፎንጂ ጩጰጉረ፤ ፊቀ ካየጉረ ጎጎጣምሮ የሱሳን ስሰረ፥ ኦራዬን፤ “አላ ኤላሳ ኤሜይጉረ ኡሱ ጎዳግስሮና አላ ዴኖ” አመ።<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />ኤሰኮና የሱሳና እዬረ፤ ኔፎ ቤተ። <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />ቁሉክ ምንኮኮክ ጎጎሎ ኤለኮ ታ ሄገል ጌሮን ፊላመ ባንኤ ላማ ቤ። <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />የሱሳ ሆረ አሌ ካግረ ካቦሎ ዎይቻት ኡሱ ሂካማሌ እዬረ ኔፎቴሳ ብያኖ ካኮድያረ ጎራታ፤ “ሂክ እባዶት ሩምና ኤረ ካዋየ” አመ።<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />ሀሱ ጎራታ ኤባ አሌጉረ ዲያ ካግረ ኮኮ ሄለል፤ እሶ ኦሮኮ ታመግደላ ኡልኮት ማይራመ፥ ክጫርክ ታያይቆባና ታዮሳ ኣዬ ማይራመ፥ ኡሱማለና ሰሎመነ ግረን፤ <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />ሂክ ሄለል የሱሳ ጋሊላይ ታኮግረ ኡሱ ዴበ ሰሴታና ሀንዳ ካግረያ፤ አደና እሶነ ዎታ ኢየሩሳለም ቶስ ካኤመተረ ካሞጋን ሄለል ካካለና ግረ።<verse eid="MRK 15:41" /></para>
  <para style="s1">ቃማላማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር. 15፡42-47</ref>፤ <ref loc="MAT 27:57-61">ማቶ. 27፡57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፡50-56</ref>፤ <ref loc="JHN 19:38-42">ያን. 19፡38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />ጎራታና ሄመን ላ ካኮሴታረ ጎራታ አይሁድን ታፎልሲ አሪን ታኮባራናን ሄመን ህክና ታኮኤካሳታራን አሪ ሌተ፤ <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />ካካባጃመ ታሾንጎ ኡና ካሌረና ዎኖናት ካዋ ኦራታ ካግረ ካአርማትያስ ዮሴፋ ጃቡይ ጲላጦሳ ቶስ ሴተጉረ ካየሱሳ ሬስ ኤባተ። <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />ጲላጦሳና ሂካማሌ ኡሱ ሳሜ. ጎዋኖኬሳ ማለጉረ ማመ፤ ካቦሎ ዎይቻና ኡመጉረ፥ ጎጎየኮ አዳላተራ? አመ ሆሳተ፤ <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />ጎዋኖኬሳና ካቦሎ ዎይቻኮ ቁሌሴጉረ ሬስ ዮሴፋን ስሰ። <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />ዮሴፋና ጋሸ እምነጉረ ሬስ ዳግሰረ ጋሼይ ኤካሰ አባባተረ ኤኤሞኮ ካኦሻመሮ ጉምቢ ኦሮ ቃማለ፥ ታጉምቢ ህኢና ኤኤሞ ካየ ዱድሰ። <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />ካመግደላ ኡልኮት ማይራመና ታዮሳ ኣዬ ማይራመነ የሱሳ ኤቲ ቃማልናራን ዲያ ግረን።<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">ጎይኮ ክያኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 16:1-8">ማር. 16፡1-8</ref>፤ <ref loc="MAT 28:1-8">ማቶ. 28፡1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፡1-12</ref>፤ <ref loc="JHN 20:1-10">ያን. 20፡1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />አይሁድኮት ታፎልሲ አሪ ሮርተ ግራን ታመግደላ ማይራመነ፥ ታያይቆባ አዬ ማይራመነ፥ ሰሎመነ ሰተንጉረን ሬስ ካየሱሳ ሽቶ ክቢን እምናተን። <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />አልማኮ ታሆራርጄ ታዎጋ አሪ ባር ባሪኖ ጋና አርት ካኮአላቶ ጎራታ ቃማል ቶስ ሴታ ግራን፥ <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />“ቃማል ጉኮ ኤኤሞ ኖን አዮያ ካኦቶቶልስራ?” አማ እስኦሮ አዬሳ ግረን። <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />ጦቂ አም ጎዴራን ቃማል ጉት ካግረ ካንጂንክ ኤኤሞ ቃማል ጉኮ ኦቶቶሌ ካግሮ ዴን። <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />ቃማል ቶስ ጎጎጌኒ ካሀንቃሮ ሳርስ ካሳርሳተሮ ዎዳላት ምና ታመርገነ ካሀማጼሮ ዴንጉረን ኣሎ አብሳተን።<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />ኡሱ አደ፤ “አላማንደ አሮአብሳቴን፤ እስን ካዶታታን ካሱዋመሮ ካናዝረት የሱሳያ፤ ህታኒ ላግሮ፤ ኡሱ ታኮቃማላመረ ባንኤ ህትማ። <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />አየሱን ጎአመን ሴየንጉዴን ኡሱኮ ኦአጋልሳታራዉና ጴጢሮሳን፤ ‘እስንኮ ጣይ ጋሊላ ቶስ ሴይናራ፤ እስኑን ጎጎሰጌሮይ ኤሰ ሄልናታን አማዴን እሶን ሰጋ።’ ”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />ሄለልና ሀርኣና ገጌላታ ቃማልኮ ቤን ባቃተን። አብሳተን ማንኮግሬን ማራን ማዮና ኮና ላኮአዬሴረን።<note caller="+" style="f"><char style="fr" closed="false">16፡8 </char><char style="ft" closed="false">ቶቶ ሳጋልኮ ታ ቶቶ ላማታን ጌሮ ካግራ ካሆርኮ ማጻፋጆል ላኮግሮ። (9-20)</char></note><verse eid="MRK 16:8" /></para>
  <para style="s1">የሱሳ ታመግደላ ማይራመን ሙታኖ</para>
  <para style="r">(<ref loc="MRK 16:9-11">ማር. 16፡9-11</ref>፤ <ref loc="MAT 28:9-10">ማቶ. 28፡9-10</ref>፤ <ref loc="JHN 20:11-18">ያን. 20፡11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />አልማኮ ታሆራርጄ አሪ ታዎጋ ባር ጎይኮ ኬ አባባተረ ዱርሳ ቶዶባ ታኮቤሰረ ካመግደላ ኡልኮት ማይራመን ሆራርጀ ሙተ። <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />ኤሰና ሴቴጉዴ፥ ኡሱነ ዎታ ኦግረን ኦታና ጋዳይ ኦግረን ዴተጉዴ ኡሱ ኔፎ ግራኖና ኤሰን ሙታኖ እሶን ሰጊተ። <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />ኤሰ የሱሳ ጎይኮ ኬራ ኔፎነ ግራ ጎአንተና እሶ አደን ላኮአብዳተነን።<verse eid="MRK 16:11" /></para>
  <para style="s1">የሱሳ ላማ ኡሱኮ ኦአጋልሳታረን ኦካለቱን ሙታኖ</para>
  <para style="r">(<ref loc="MRK 16:12-13">ማር. 16፡12-13</ref>፤ <ref loc="LUK 24:13-35">ሉቃ. 24፡13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />ሂካኮ አባባተረ ኡሱኮ ኦአጋልሳታረን ላማ ጋጣረ ቶስ ብያ ግራን ምዲ ታካለቲ እሶን ሙተ። <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />እሶና አባባተንጉረን ሂካዋ ኦሄሴራዉን ሰገን፤ ሀሌዎ ኳሬ እሶና ላኮአብዳተን።<verse eid="MRK 16:13" /></para>
  <para style="s1">የሱሳ ቶሞንኮ ኮ ኦፋራሜራዉን ሙተ</para>
  <para style="r">(<ref loc="MRK 16:14-18">ማር. 16፡14-18</ref>፤ <ref loc="MAT 28:16-20">ማቶ. 28፡16-20</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፡36-49</ref>፤ <ref loc="JHN 20:19-23">ያን. 20፡19-23</ref>፤ <ref loc="ACT 1:6-8">ኦፋ. ፈ. 1፡6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />ኤሰኮና ቶሞንኮ ኮ ባቦ አማ ሀማጼን ግራን የሱሳ እሶን ሙተ፤ ጎይኮ ኬ አባባተ ግራን ካዴራ እባዶ ካሰገሮ አማናና ማንኮዋተራን ማራን አብድዋትትሶይና ዎዳናትሶክ ዱዳኖ ቱፋተ። <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />አደና፥ “አላም ዱባ ቶስ ሴይን፤ ዎንጋላና መጣ ዱባን ላላባ፥ አመ። <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />ካአማነራና ካጣማቃመራ ፋይናራ፤ ካአማኖን አደ ፍርዳምናራ። <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />ኦአማናራና ሂካ ማላታል ፈልናራን፤ መገኬይ ዱርሳ ቤስናራን፥ ታኡሱብ ሄኢና አዬስናራን፥ <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />ሀበሳል ገነትሶይ አብናራን፥ ታላጋዶ ማርዚ ጎጣሜና ዱዶ እሶ ላኮሚሮ፥ ገነትሶና ኩባሌሳል ጉት ካይናራን እሶና ፋይናራን።”<verse eid="MRK 16:18" /></para>
  <para style="s1">የሱሳ ዳሩር ቶስ ቤ</para>
  <para style="r">(<ref loc="LUK 24:50-53">ሉቃ. 24፡50-53</ref>፤ <ref loc="ACT 1:9-11">ኦፋ. ፈ. 1፡9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />ጎታ የሱሳ ሂካ ዱባ አዬሰ አባባተረ ዳሩር ቶስ ቤ፥ መርጌ ታዋይ ሀማጼ። <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />ኤሰኮ ኡሱኮ ኦአጋልሳታረን ኤመተንጉረን፥ ማማን ዱባ ሃፉራኬሳ ላላበን፥ ጎታና እሶነ ዎታ ፈላ ግረ፤ አጋልስስክሶና ባሳክ ማላታይ ሃፉራኬሳ አታይሳ ግረ።<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>