<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Bayso New Testament</book>
  <para style="h">Mark'oosa</para>
  <para style="toc1">Mark'oosa kas'aafero Goottaakkaanki kayesuusa Kiristoosa Wongala</para>
  <para style="toc2">Mark'oosa</para>
  <para style="toc3">Mar.</para>
  <para style="mt1">Mark'oosa Kas'aafero</para>
  <para style="mt2">Goottaakkaanki Kayesuusa Kiristoosa Wongala</para>
  <para style="imt">Tabano</para>
  <para style="ip">Kamark'oosa wongala, «Hikki ere kawaa Yesuusa Kiristoosakokki kageggeloo haafura kahoraarjjeeya» ame haggaɂabara, hikka wongalaa orroo Yesuusa kafeloonna odonnati kaɂabo ibaaddoti lee emeetera; odonnatikkeessaanna agaalssisikkeessaa, durrisaa gutii usu kaɂabo hunnana c'ubbo kaɂibaaddo haheso amanoyi addeesamera. Yesuusa, «Ani ibaaddo tac'ubbo diyyummakko balchchumma beesanoyi neefottee wodoo yelayi sisayin kaɂemeeyero ere kaɂibaaddoya» amaa usu issii ayeesera.</para>
  <para style="ip">Mark'oosa jirtti tayesuusa kakkoɂayyeesera, tukkulnna hunna kakkoɂammagamero raadii golleero usu il kakkokayeraa kayesuusa haafuraayinna agaalssis gutii anlleennon giraan usu ofelero osaadamiraan felooyi gutiiyye. Kat'ammak'aaro gara kayaannisakotti jirtti, kayesuusa t'ammak'amanokokki garana c'aafamano gabaabbinnaa tabano sise abbaabatere s'aafiti kayesuusa agaalssisanona fayyiisanokokki gara handdaano sessegaara. Goorata kic'c'arkko abbaabatere Yesuusaa debee osesseetaran Yesuusa aaloo addeesaa takkoseeteeni Yesuusa oneebaataraanna aaloo usu diidaa seeteen. Kagachchoo foolssijjool giri kayesuusa kagachchoo almmaayi orroo ofelameraan felooyi, kakkaleekkona suwaamanokkeessana goyikko kiyaanokkeessakokki gara omammakaaraanyaan.</para>
  <para style="ip">Kagachchoo wongalakkeessaa gutii hogoogi takkokaamera banɂe lama kookkoo kahorkkoo mas'aafajjol kaalaalii ogiraanyan.</para>
  <para style="iot">Raattoo Hikki Mas'aafa Kaɂabera</para>
  <para style="io1">Wongalakokki haggaɂabamano <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">Yesuusa kagaliila ulii handdaano haggaɂabano <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">Iyyerusaalemi katamaayi handdaano <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref> </char></para>
  <para style="io1">Iyyerusaalemiinna gobobkkiseeyi kagachchoo almmaayi <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref> </char></para>
  <para style="io1">Kagootta goyikko kiyaano <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Goottakokki goyikko kiyaanona usukko oɂagaalssatarawun adiɂadi mutanonna daruur tos biyaano <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">Kat'ammak'aaro Yaannisakokki lallabaano</para>
  <para style="r">(<ref loc="MRK 1:2-8">Mar. 1:2-8</ref>; <ref loc="MAT 3:1-11">Mat. 3:1-11</ref>; <ref loc="LUK 3:2-16">Luk'. 3:2-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Hikki ere kawaa kayesuusa Kiristoosakokki wongala kahoreeya.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Kookkoo mas'aafajjol «Ere kawaa» kaɂamaro haafura lakkoɂadaro. </char></note> <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>Kahegeroo Isiyaasaa, «Raa kaɂekkaasiro kahandaarokakkee kukko t'ayi ani farrowa amame s'aafamera.<verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>«Hikkina;</para>
  <para style="q1" vid="MRK 1:3">‹Raa kagootta ekkaasa,</para>
  <para style="q2" vid="MRK 1:3">shakaara iidisa amaa gaadi taɂiyyaatte yaaye.› »<verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Haanssun kat'ammak'aare Yaannisa k'alullattokki ulii t'ammak'aanna c'ubbokko haheso amamanoon gula galanokkokki t'ink'ata lallabaa emeete. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Yihuudakona kaɂiyyerusaalemi maaman dubbakko ibaaddo raattoo usu tos seetere c'ubbokkisookko gula galaa laga kayorddaanosi gene tayaannisa t'ammak'ameen.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>Sarssi kayaannisa ogorro ogaalakko kafelameroye; mooɂiina gii muwaatare, babokkeesana kenttefarrona malab kagaadoye. <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Lallabaanokkeessana, «Ani hussimi keferroɂoottessakokki shaano furin kakkodaanddenoon inkko karoorara inkko haarre emeetara. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Ani isin bekee t'ammak'inara, usu goɂameen Ayyaana K'ulluukkii t'ammak'inara kaɂamareya.»<verse eid="MRK 1:8"/></para>
  <para style="s1">Kayesuusa t'ammak'amanona c'aafamano</para>
  <para style="r">(<ref loc="MRK 1:9-13">Mar. 1:9-13</ref>; <ref loc="MAT 3:13-17">Mat. 3:13-17</ref>; <ref loc="LUK 3:21-22">Luk'. 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>; <ref loc="MAT 4:1-11">Mat. 4:1-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Usu goorata Yesuusa tagaliila katamaa talleetetto Naaziretikko emetere laga kayooriddanosi gene tayaannisa t'ammak'ame. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Bekekko kakkobiyaare goorata daruur bananttedde Ayyaana K'ulluukki arabe aani usu gutii dagaa giraan dee. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Ani kageelaatara «Erekki atitta kuyee geggelaatara taɂamatte yaaye daruurkko maalssantte.»<verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Goorsewa Ayyaana K'ulluukki gaa tos usu k'ajeelise. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>S'alayeenna c'aafamaa arri afarttam gaadi adallaate sulaalene wota gire, erggichchaalnna usuun handdayeen.<verse eid="MRK 1:13"/></para>
  <para style="s1">Ohoraarjjee Yesuusakko Oɂagaalssatareenkokki assaabamano</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat. 4:18-22</ref>; <ref loc="LUK 5:2-11">Luk'. 5:2-11</ref>; <ref loc="JHN 1:35-42">Yan. 1:35-42</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Yaannisa minkashaano kakkotabare goorata Yesuusa wongala kawaa lallabaa ul kagaliila tos seetere, <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>«Goorata geera; wononnati kawaa gabbalamera; c'ubbokko gula gala; wongalaa ammana!» amaa lallabaa gire. <verse eid="MRK 1:15"/><verse number="16" style="v" sid="MRK 1:16"/>Yesuusa labu tagaliila ene mare rooraa Simoonanna abbikkeessa Indiraasa kunɂub oɂabatareen mankkoleen maraan; maarrabi beke lugudataa giraan dee. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Yesuusana «Indebee sesseeyeen; ibaaddo oɂabttaan yelnara» ame. <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Isona banneewa maarrabi tattisoo iiseen usu debee sesseeteen.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>Esekko abaraan ship'p'i goggoɂamee; kazabddoosa ere Yayik'oobana abbikkeessa Yaannisa wolabo hamas's'eereen maarrabitisoo ekkaasataa giraan deegure, <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>Banneewa iso uume, isona Aabbokkisoo Zabddoosana maragadewun ofelareene wota wolabo gutii lugudeen iiseen usu debee sesseeteen.<verse eid="MRK 1:20"/></para>
  <para style="s1">Yesuusa battiikki ayyaana beese</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk'. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Esekkona kak'ifirenaahoomi maaman tos seeteen, Yesuusa banneewa Ayihuudin tafoolissi arri Ayihuudikokki min kaɂebi tabere agaalssisano haggaɂabe. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Seera kamuse oɂagaalssisaran aani halleenon giraan odonnati kaɂabo aani agaalssisanoyi gosana agaalssisanokkeessa saade.<verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>Usu goorata Ayihuudikokki min kaɂebi orroo kagire battiikki ayyaana kakkogire ibaaddoti koo haa amaa okkee. <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>«Kanaazireti Yesuusa, ati nookko me dootatta? No baasin emeetetta? Ati ayyotto ani ku kasowa, ati kawaa k'ulluukkitta.»<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>Yesuusana, «C'alɂi amina, usukkona beena!» ame hadise.<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>Battiikki ayyaana ibaaddoti aaloo ulle boc'ee abbaabatere esekko iyyaa bee. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Gosa dubba saadanoyi, «Hikki ayees meya? Odonnati kaɂabo kaɂusub agaalssisano laanoya! Battiikki ayyaanajjol usu goɂajajiro isona biyaaran!» amaa isiɂorroo isiɂisi hoosaten.<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>Banneewa ataankkeessa kagaliila gobobii kagiro ul dubbaa addeesame.<verse eid="MRK 1:28"/></para>
  <para style="s1">Yesuusa omooggan fayyiise</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat. 8:14-17</ref>; <ref loc="LUK 4:38-41">Luk'. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Banneewa min kaɂebi kaɂayihuudi goggobeenii; Yayik'oobane Yaannisane wota min kasimoona kaɂindiraasa tabeen. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Tasimoona soddo maar kagubaro hawɂaami hawɂaamaa huddurtte gitte; garakkiseenna Yesuusaan segeen. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>Haanssun usuna ese mankkohuddurtette tos seetere genettisee abe keese; maar kagubarena iise; keetegudde handdaano haggaɂabtte.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Arriti kakkoɂiyaatte goorata, hemeenkki ulii ibaaddo maamanjjoolkko kahawɂamarena s'alayee kaɂabamere ibaaddo dubba usu tos keene. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Katamaakko gosa dubba min gooc'a horee kukku ameen gireen <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Yesuusa kalekaleekki hawɂaami kahawɂamare kamooggan ibaaddo fayyiise durrisana beese, ayesuun goɂameen durrisana kayesuusa ayyonati mankkokasanaaye maraan Yesuusa iso goggoɂayeesirawun feɂi lakkosisere.<verse eid="MRK 1:34"/></para>
  <para style="s1">Yesuusa kagaliila maamanjolii wongala lallabaano</para>
  <para style="r">(<ref loc="MRK 1:35-39">Mar. 1:35-39</ref>; <ref loc="LUK 4:42-43">Luk'. 4:42-43</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Babbaris bullane, Yesuusa keere minkko bee banɂe kaletti tos seetere ebi haggaɂabe. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Simoonana unatteessana usu dootaa debee been. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Kakkohelareen goorata, «Ibaaddo dubba ku dootara» ameen.<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>Yesuusa, «Hittakko kiigunne dollee kagiro kakkalee maamanjool seenna eseenna lallabinna, ani kakkoonɂemeeyera hikkanunya» ame.<verse eid="MRK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39"/>Haanssun Ayihuudikokki min kaɂebi tos tabere lallabaanna durrisa beesa Galiilaa dubba maraamurano haggaɂabe.<verse eid="MRK 1:39"/></para>
  <para style="s1">Yesuusa bar kaɂabo ibaaddoti fayyiise</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mar. 1:40-45</ref>; <ref loc="MAT 8:2-4">Mat. 8:2-4</ref>; <ref loc="LUK 5:12-14">Luk'. 5:12-14</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Maarii bar kaɂabanaaye ibaaddoti koo Yesuusa tos emetere luki hegelii gilbbisere; «Feɂittaa golleete in muc'c'isin daanddaatta» ame ebaate.<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Yesuusana ibaaddotin nenɂeyisatere gene diriirssate abere «Feɂi sisera muc'c'imina» ame. <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Ibaaddoti banneewa barkko muc'c'ime, fayyee. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Yesuusana ibaaddotin ataayise segeere haa ame galise. <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>«Hikka ayees Maayyonna goggoseginnonkko isi oora, ayesuun goɂameen gosaan ato goggolleeroon seedde isiɂoottaa tuuk'aamon tusa; muc'c'i amanokkaawun Muse goggoɂajajeerokki malee jaarsso sisi» ame.<verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>Ibaaddoti goɂameen mankkoseete dubbaa kalleeroo ayees sessegaa sesseete, oduna darɂee. Hitta aalantti Yesuusa maamisitti katamaa addeesami tabin lakkodaanddee; hikkakko kakkeey katamaakko sarre ibaaddo takkoginnon banɂe girano haggaɂabe; ibaaddo goɂameen banɂe banɂekko usu mankkogiro emeetaa gireen.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">Yesuusa naafaleessa fayyiise</para>
  <para style="r">(<ref loc="MRK 2:3-12">Mar. 2:3-12</ref>; <ref loc="MAT 9:2-8">Mat. 9:2-8</ref>; <ref loc="LUK 5:18-26">Luk'. 5:18-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Yesuusa arri uc'c'arkko abbaabatere tak'ifirenaahoomi katamaa tos emeete; esenewa usu min tabano gosa maale; <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Haanssun min laanawaatere awundda taaɂunɂiroo geegin ibaaddo kamooggan kukkume, usuna haafura kawaa iso agaalssisaa gire. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Hassu goorata ibaaddo afarro naafaleessakki ibaaddoti sideengureen usu tos keenen <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Gosa mooggankko kakkeey Yesuusa tos gabbaliin minkko waateen maraan taminee heelinchcho Yesuusa mankkogirone butto beesengureen naafaleessati takkohuddurere alggaanne wota dagiseen. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Yesuusana ammanokkisoo deegure naafaleessatine «Ati hikki unnu c'ubbo kakka shaaga leera!» ame.<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Eseenna hamas's'een ogireen kookkoo seera kamuse oɂagaalssisareen wodanattisooyi haa ameen hedeen. <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>«Hikki ibaaddoti misii haa amara? Hedo gutii haafura kahabaari kahabaarara! Waa koo kuwaarre c'ubbo shaaga yelin kadaanddaara ayyoya?» ameen k'oppeen.<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>Yesuusana banneewa wodanattisooyi kahedaran ayyaanakkeessayi addeesere; «Misii haa k'oppaattan? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Naafaleessakki ibaaddotine ‹C'ubbokkakkaa shaaga leera› amanokkona, kingudde alggaattaa sidadde gali, amanokko eekiya enekki? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Ayesuun goɂameen ere kaɂibaaddo ul gutii c'ubbo shaaga yelin odonnati kaɂabo laano goggoɂaddeessawun» amere naafaleessatine, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>«Kingudde alggaattaa sidadde minkaa gali» ame.<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>Naafaleesatina goorsewa keegure alggaa sidatere ibaaddo dubba diyaagiraan bee. Haanssun ibaaddo saadere hikkamalekki ayees «Noo duuddo deenne laakkansso amaa Waa galateen.»<verse eid="MRK 2:12"/></para>
  <para style="s1">Woyyutikokki uumamano</para>
  <para style="r">(<ref loc="MRK 2:14-17">Mar. 2:14-17</ref>; <ref loc="MAT 9:9-13">Mat. 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk'. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Yesuusa kallami labu tagaliila tos seete, gosa kamooggan usu tos emeete, usuna iso agaalssise. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>Esene rooraa giraan kaɂilfoosa ere woyyutina k'arat'a takkoɂataraan banɂee hamas's'ee giraan deere; «Indebee sessee» ame.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Kawoyyuti minii babo aamin hamas's'ee giraan, omooggan k'arat'a okukkuyisareenena, c'ubbaalessaalnne, usu debee sesseetaa mankkogireen maraan, Yesuusana usukko oɂagaalssatareene wota babo aamaa gire. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Tafarasaawi unakko olleeren seera kamuse oɂagaalssisareen Yesuusa c'ubbaaleessalnnena k'arat'a okukkuyisaraanne wota aama giraan kakkodeyaaren goorata; usukko oɂagaalssataranne, «K'arat'a okukkuyisaraanena c'ubbaalessajjoolnne wota muun aamara?» amaa hoosaten.<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>Yesuusana iso kaɂayyeeseren maaleere akimii kakkoondootisara «Kahawɂamaron kuwaarre fayyaaleessan lakkoyo; ani c'ubbaalessajjool kuwaarre k'ulloolee uumin lakkoɂemeeyero» ame.<verse eid="MRK 2:17"/></para>
  <para style="s1">Agabuu maraan tahoosantteto hoosiin</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mar. 2:18-22</ref>; <ref loc="MAT 9:14-17">Mat. 9:14-17</ref>; <ref loc="LUK 5:33-38">Luk'. 5:33-38</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Yaannisakko oɂagaalssataranna ibaaddo kafarasaawi agabuwɂa gireen. Ibaaddo kookkoo emeetegure Yesuusane; «Yaannisakko oɂagaalssataranna farasaawilkko oɂagaalssataran goɂagoboyiraan kukko oɂagaalssataran agabuwaana kakkoonwaataraan mewuunya?» ameen.<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>Yesuusana; «Kamashaashee wota giranttii saatilaal agabuyin daanddaatta? Kamashaashee isone wota giraan agabuyin lakkodaanddanan ame. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Ayesuun goɂameen kamashaashee isokko kakkoɂatamira goorata emeetara, usu goorata agabuyinawa.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>«Kaddoɂan sarssi gutii taɂusubtti erbbe kakkaatara maayyonna laagiro, hikki gollee adi; taɂusubtti erbbe taddoɂan tatarshaatta, fiilamanona aaloo balɂaayinara. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Adi kaɂusub kawoyinii t'amo kaddoɂan dinbbito kakkibatara laagiro, hikkamalee gollee kawoyinii t'amo dinbbito bereɂsara, t'amo kawoyiniinna ubatara dinbbitona laɂokko sarii biyaara. Haanssun kaɂusubikki t'amo kawoyiniwuun kaɂusubikki dinbbito dootisara.»<verse eid="MRK 2:22"/></para>
  <para style="s1">Yesuusa tafoolssi arriwuun Goottaya</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mar. 2:23-28</ref>; <ref loc="MAT 12:1-8">Mat. 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk'. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Tafoolissi arri Yesuusa ira orromare rooraa gire, usukko oɂagaalssatareen shawuyee ebisatano haggaɂabeen. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Farasaawiilnna tafoolssi arriwuun feɂi kasisamoon gitto ayees kukku oɂagaalsataran «Muun felaraan?» amaa hoosaten.<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>Yesuusana abbaabere, «Daawute usuu debee osessetaraane wota kakkoɂuɂeerena kakkorakkatere goorata me yelero lakkonabbabtteettanya? <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>Abiyataari tuuk'aamolun woyichcha lee kakkogire geesii Daawute min kawaa tabere tuuk'aamolun kuwaarre okkalee aamin feɂi kakkonsisamoon giro, kak'ullooye babo kawaa aame, usu wota kagire ibaaddonna sise.»<verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Adena Yesuusa, «Tafoolssi arri ere kaɂibaaddotun met't'aanttetta kuwaarre ibaaddo arri tafoolsiwun lakkomet't'aamero ame. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Haanssun Ere kaɂibaaddo tafoolssi arriwuun Goottaya.»<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">Yesuusa gene kakkonaafatette ibaaddoti fayyiise</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mar. 3:1-6</ref>; <ref loc="MAT 12:9-14">Mat. 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk'. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Yesuusa kallami abbaabate Ayihuudikokki min kaɂebi tos tabe, eseenna gene kanaafatere ibaaddoti koo gire. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Aalanttina Yesuusa mootin kaddootare ibaaddo tafoolssi arri gofayyisaro deenna, ameeren oora gireen. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Yesuusana gene kanaafatere ibaaddotine «Kingudde iso t'eɂee aalliina» ame. <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Esekko abbaabatere «Afo tafoolssi arriwuun feɂi kakkosisanttetta taɂidan feliinya muu tameellan feliinya? Neefo fayyisanoya muu baasanoya?» Ame iso hoosate, isona adene c'alɂi ameen. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Yesuusa wodanattiso duudaanon gaddeegure usu maraamurene oɂalleeraan iɂone deegure ibaaddotine, «Genettaa diriirssa!» ame, ibaaddotina gene diriirssate genettesana duuddo fayyiite. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Goorsewa ibaaddo kafarasaawi beegure misi yeli Yesuusa baasinaraan una taherodoosane wota makkareen.<verse eid="MRK 3:6"/></para>
  <para style="s1">Ibaaddo kamooggan Yesuusa debee sesseete</para>
  <para style="r">(<ref loc="MRK 3:7-12">Mar. 3:7-12</ref>; <ref loc="MAT 12:15-16">Mat. 12:15-16</ref>; <ref loc="LUK 6:17-19">Luk'. 6:17-19</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Yesuusa usukko oɂagaalssataranne wota tagaliila labu tos dage, Galiilakko kaɂemeetera aaloo kamooggan gosa debee sesseete, <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Usu kafelaro ayees kamaalera ibaaddo Galiilakko, Yihuudakko, Iyyerusaalemikko, Edomiyasikko, Yorddaanoskko gamaa kagiro maamankko, usumaleenna tat'iroosakkona tasidoona katamaalkko usu tos emeeten. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Kukkukaɂamere gosa goggoɂunɂinonkko tic'c'artti wolabo oyireen usuun goggoɂekkaasiranun Yesuusa usukko oɂagaalssataranun ajajee. <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Kamooggan ibaaddo fayyiise mankkogire maraan, dhukkubaa karrakkatare dubba genettisooyi usu dinin dootataa gireen. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Battiikki ayyaanajjolna Yesuusa kakkodiyaaren goorata horee iyaa «Ati ere kawaatta,» amaa iyyaa gireen.<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>Yesuusa goɂameen ayyonnatikkeessa iso beesi goggoɂayeesonkko ataayise hadise.<verse eid="MRK 3:12"/></para>
  <para style="s1">Ofarameeraan tomonkko lamakokki assaabamano</para>
  <para style="r">(<ref loc="MRK 3:16-19">Mar. 3:16-19</ref>; <ref loc="MAT 10:2-4">Mat. 10:2-4</ref>; <ref loc="LUK 6:14-16">Luk'. 6:14-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Yesuusa wodami tos beegure usu odootera usu tos goggoɂemeerawun uume, isona isone wota ogireen iiseengureen usu tos emeeten. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Usune wota goggogirrawunna, goggolallabnawun farin amere tomonkko lama shuume, ofarameeraan ame iso uume. <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>Durrisa goggobeesinawunna odonnati sise.<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>Oshumameeran tomonkko lamana hinɂayaan, isona P'et'iroosa ame kaɂuumero Simoona, <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Boɂanereges goorttun, kadiddideenna yiis ame mege kabeesero kazabddoosa yiis Yayik'ooba abbikkeessa Yaannisa, <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Indiraasane, Filp'oosane, Berttelomeewosane, Matoosa, Toomaasa, kaɂilfoosa ere, Yayik'ooba, Taadiwosa, ulkkeessa kahaɂusataro Simoona, <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>usumaleenna Yesuusa roorise kasisero kaɂask'orotu ulkokki Yihuuda.<verse eid="MRK 3:19"/></para>
  <para style="s1">Yesuusanna durrisakokki woyichcha</para>
  <para style="r">(<ref loc="MRK 3:20-27">Mar. 3:20-27</ref>; <ref loc="MAT 12:25-29">Mat. 12:25-29</ref>; <ref loc="LUK 11:17-22">Luk'. 11:17-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Esekkona Yesuusa abbaabate usu min tos tabe, Yesuusana usukko oɂagaalssatareene babo aamin taawaananii gosa ade mooggaate kukkume. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>«Yesuusa wodana k'olamera» amamano kamaalera fallikkeessa usu atayiseeyin usu mankkogiro emeete.<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>Iyyerusaalemikko oɂemeetereen seera kamuse oɂagaalssisareen, «Usu durrisakokki woyichcha aba! Durrisa kakkobeesarana kaddurrisa woyichchaaya» ameen.<verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>Yesuusa gosa isi tos uumegure masuussa haa ame, s'alaye s'alaye misii beesin daanddaatta? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Wono koo isiɂisi orroo kalekalee gobbee hassu wononnati ataayin lakkodaanddaaro. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Usumaleenna min kookki ibaaddo isiɂisirroo kalekalee gobbee arɂayi aallin lakkodaanddaaro. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Usumalee s'alaye isiɂisi orroo isikadiidattona kalekalee kabeyaatto golleete baatta kuwaarre ataayi aallin lakkodaanddaatto.<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>Hassukko kakkeeyi ibaaddoti koo t'ayi hunnameessakki ibaaddoti hanshiinoni giraan hunnameessa ibaaddotikokki min tabire urrawo saamiin lakkodaanddaaro, minkkeessa saamiin kakkodaanddaara hunnameessakki ibaaddoti goshiiyye kaalaalya.<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>«Ani rumminaa amara, ibaaddo kafelara c'ubbona kahabaarara habaar dubba shaaga leerowa, <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>Ayesuun goɂameen Ayyaana K'ulluukki kahabaarara dubba jiruu jiroommatti anza aba kuwaarre usuun haheso lakkoɂamaminnaro.» <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>Yesuusa hikka kakkoon ayeesera «Battiikki ayyaana aba» mankkoɂameen maraanya.<verse eid="MRK 3:30"/></para>
  <para style="s1">Aaye taɂyesuusana abbilaaltteessa</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mar. 3:31-35</ref>; <ref loc="MAT 12:46-50">Mat. 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk'. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Esekko abbaabatere Aye tayesuusana abbilaaltteessa usu tos emeeten, sarre aalleerene ibaaddo usu tos fareen uumsiseen. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Usu mareɂabe kahamas'eere kamooggan ibaaddona, «Hinɂima Aayettana abbilaalttana sarre aalleenen ku dootaraan ameen segeen.»<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>Usuna, «Aayettina abbilaaltti ayyoosyyaan?» ame abbaabe. <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>Usu mareɂabe kahamas's'eere ibaaddo tos diyaa haa ame «Aayettina abbilaaltti hinɂayaan! <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Feɂi tawaa kafelara dubba usu abbikee, abbatteenna, Aayetteeyyan» ame.<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">Kawut'a masuussakotti fureen</para>
  <para style="r">(<ref loc="MRK 4:1-12">Mar. 4:1-12</ref>; <ref loc="MAT 13:1-15">Mat. 13:1-15</ref>; <ref loc="LUK 8:4-10">Luk'. 8:4-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Yesuusa kakkalee goorata ade labu girddi agaalsisano haggaɂabe. Usu kakkogire gobobii aaloo kamooggan gosa mankkokukkuɂamere maraan, beke orroo tagitte wolaboo tabere hamas's'ee, gosa dubbana labu girdi kukkume gire. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>Usuna kamooggan ayees masuussaa agaalsise, agaalsisaanna haa ame, <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/>«Maala! Goortta, ibaaddoti koo wut'a wut'ayiin bee. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>Wut'a kakkowut'atare goorata kookkoo raadii iyye, kimbir emetere abaabate aame. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Kakkalee ade taɂidan erre mankkoginnooti shak'umooltti banɂee iyye, erre shak'umooltti mankkolleete maraan banneewa alate. <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>Arriti kakkobiyaatte goorata ade k'oore, hididi hegelddi dagana mankkowaate maraan angage. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Kakkalee wut'a ade eɂeen t'eɂee iyye, eɂeenna wota jiinattedde kaɂalatere wut'a hurɂite mankkoɂabttette maraan il lakkoyelate. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Kakkalee wut'a ade taɂidantti erre gutii mankkoɂiyye maraan alate, jiinaate, ilnna sise, koo sonddom, koo lootam, kakkaleenna il bool dubame.» <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>Adena Yesuusa «kamaalara nebe kaɂaba hamaalo!» ame.<verse eid="MRK 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Kale kakkohesare goorata, debee sesseetaa kagire ibaaddona tomonkko lama okkalee wota ogireen masuussajjool maraan fureen hoosaten. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Usuna, «Isinuun wononnati kawaakkotti hool malabano isinuun, sisamera, sarre ogiraawun goɂameen ayees dubba masuussaa isoon segaaminara. <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>Hikkina kakkoonlinnara,</para>
  <para style="q1" vid="MRK 4:12">« ‹Isona Waa tos abbaabayineene</para>
  <para style="q2" vid="MRK 4:12">C'ubbokkiso haheso goggoɂamamoonko;</para>
  <para style="q1" vid="MRK 4:12">Diyaano diyaagiraan wodanaa goggokokannonkko;</para>
  <para style="q2" vid="MRK 4:12">maalano maalaa giraan lakkoshaadaran, hikkakko kakkeeyi c'ubbokkiso haheso lakkoɂamamaro ame.› »<verse eid="MRK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Esekko Yesuusa haa ame «Isin hitta masuussa lakkoɂaddessetanya? Hayya kaggarmman masuussajjool misii addeesin daanddinnattan? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Kawut'ara haafura kawaa wut'ara. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Ibaaddo kookkoo raadii gutii kaɂiyyero wut'a aani laara, haafura kakkomaallaan goorata s'alaye banneewa emeettegudde iso orroo kawut'amero haafura aatatta. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Adena kakkalee shak'umooltti banɂe kawut'amero wut'a aani laaran, haafura kakkomaallaan goorata banneewa geggelooyi atataraan. <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>Ayesuun goɂameen hidiid hadagisoon mankkogire maraan kaɂadallatarana goorata kic'c'aar kaalaalya, haafurakokki aalanttii rakkoo goorttun horooramano kakkoɂemeete goorata banneewa handudufataran. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Kakkalee ade eɂeen orroo kawut'amero wut'a aani laaran, haafura maalano maalaraan, <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>halleewo kuwaarre hikka alamkokki yaada, durumakkotti geelanjjena kakkalee addakki halchcha wodanattiso orroo tabere haafura mankkohurɂaro maraanya. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Kakkaleenna erre taɂidanii gutii kawut'amero wut'a aani laaran, isona haafura maaleeren oɂoorataran koo sonddom, koo lootam, koo il bool, odubamaraaniyan.»<verse eid="MRK 4:20"/></para>
  <para style="s1">Kabollansso ifakokki masuussa</para>
  <para style="r">(<ref loc="MRK 4:21-25">Mar. 4:21-25</ref>; <ref loc="LUK 8:16-18">Luk'. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Yesuusa «Isin ifa hank'k'ayisattedden daachcho hegelii goorttun alggaakko hegelihayisatteen kaatattan? Kakkokaattaan bollanssoo gutii lakkoyoya? <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Haanssun kasiyyame, kanmutoon, kagolatera, ifa tos kanbeenoon laagiro. <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Kamaalara nebe kaɂaba hamaalo!» ame.<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>Adena Yesuusa haa ame; «Kamaalattan ayeesi maraan isiiɂoorayeen,» kakkoɂekkaasattan huuyi abbaabayi ekkaasaminara usumalee usukkona karoore isinuun adaminara. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Kaɂaboon adaminara kallayikkikko adi hassu kagira kic'c'arkkiwa adi usukko ataminara ame.<verse eid="MRK 4:25"/></para>
  <para style="s1">Kawut'a jiinankokki masuussa</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Esekkona Yesuusa, «Wononnati kawaa hikka aani laara, ibaaddoti koo erree wut'a wut'atara. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>Ibaaddotina hemeen huddurara, arriinna nabbaadara ayesuun goɂameen usu haɂaddeeson giraan usu wut'a alate jiinatara, <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Errena isiɂoottiseeyi horaarjje buul, debeenna gabo, esekko gabo gutiinna kagomoraa il yelaata. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Wut'ana kakkodubame goorata kaami kakkokukkuɂamaro goorata mankkollee maraan ibaaddoti tagayiin baac'aa saame ekkaasatara» ame.<verse eid="MRK 4:29"/></para>
  <para style="s1">Kasinafic'c'i wut'akotti masuussa</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mar. 4:30-32</ref>; <ref loc="MAT 13:31-32">Mat. 13:31-32</ref>; <ref loc="LUK 13:18-19">Luk'. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Adena Yesuusa, «Wononnati kawaa menne wota herreginssa? Misikki masuussa addeesinssaa? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Sinafic'c'i kaɂamamaro gaakotti il aani laatta, ese il wut'amaa giranttii ul gutii kagiro wut'akko tic'c'arttitta. <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Alayidde kakkojiinatte goorata taɂakaakiltte banɂe kamutaro alat dubbakko rooratta, kimbirjoolnna kajiinjjiin ballaalkkotti hoos hegelii foolssatara» ame.<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Yesuusa ibaaddo addeesin kadanddeero jilbbakki malee hikkamaleenɂi omooggan masuussajjool isoon segee. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Ayees koonna masuussa kallayi lakkoɂayeesare usuna usukko oɂagaalssataran olaal kakkolleraan goorata ade ayees dubbana kalekalee beese isoon addeesise segaa gire.<verse eid="MRK 4:34"/></para>
  <para style="s1">Yesuusa gaashimallo c'alɂise</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mar. 4:35-41</ref>; <ref loc="MAT 8:18">Mat. 8:18</ref>,<ref loc="MAT 8:23-27">23-27</ref>; <ref loc="LUK 8:22-25">Luk'. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Ese arri ul hemeen lee giraan Yesuusa usukko oɂagaalssataranne «Bekekko gama nak'inna» ame. <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Isona gosa iiserene wolabo orroo goggogireeni esennewa Yesuusa aateen seeteen, kakkalee wolaboolna wota gire. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Usu goorata kaɂatii irggado kee, gaashimallonna beke wolabooyi taa ammagamiraani shalagaa gire. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Yesuusa ade borkkaano borkatere wolabo orroo huddure gire. Isona nabbaadiseeren, «Kaɂagaalssisatto! Noo gogudanno ku lakkot'ibaroya?» ameen.<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>Usuna nabbaade keegure irggado hadise, bekena, «c'alɂi ameen!» anbbalnna c'aliɂantte, duuddo c'alɂeetti leete. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Yesuusana, usukko oɂagaalssataranne, «Mewuun haa abssatteen? Misii ammano waattaan?» ame.<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>Isona aaloo abisateen guuren isiɂisi orroo, «Afo, iriggadona gaashimallo c'alɂi kakkoonɂamaraan hikki ayyoya?» ameen.<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">Durrisaa kaɂabamere ibaaddotikokki fayyaano</para>
  <para style="r">(<ref loc="MRK 5:1-17">Mar. 5:1-17</ref>; <ref loc="MAT 8:28-34">Mat. 8:28-34</ref>; <ref loc="LUK 8:26-37">Luk'. 8:26-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Beke ogaliilakko gama nak'erene Gerggesinoon kaɂamamare maaman geen. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Yesuusa wolabokko goggodagee, battiikki ayyaana kakkogire ibaaddoti tahiyyeel banɂekko beere usu tos emeete esele. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Hikki ibaaddoti tahiyyeel banɂe gire, maayyona usu sanssalataayi shii kayin lakkodaanddeere. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>Gooratta kamooggan talukee marc'c'ona sanssalataa kageneeyi shaamaa gire. Ayesuun goɂameen kagenee sanssalata goggosaanna talukee marc'c'o eɂebisaa gire. Maayyona usu abi adallaayisin kadanddeera lakkogire. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Arggetto arriinne hemeenne hiyeelinna wodami gutii maraamurara iyyaa maarkkeessa eɂemo gogosataa gire.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Hikki ibaaddoti Yesuusa ebbaa kakkodeyaare goorata usu tos tiyaa emeete horee gilbbisere sagade. <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>Yaaye t'ok'k'isere iyyaa, «Ati dubbaankko kaɂatii ere kawaa Yesuusa, inne wota me abitta? Goggoɂabboosisonkko mege kawaayi ani ku ebaatara!» ame. <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>Ibaaddotina hikka kakkonɂamere, «Ati battiikki ayyaana hikka ibaaddotikko beena!» ame ajaja sise mankkogire maaranya.<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Esekkona Yesuusa, «Megeka ayyoyya?» ame usu hoosate. «Omooggan mankkolleeren maraan megekkina Leegooniya» ame. <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Ulkko iso goggohororoonkko ataayise ebaate.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Ese banɂe wodami laayuyi tammooggan booyyee bobbayite gitte. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Battiikki ayyaanajjol Yesuusane, «Booyyeel tos goggotabinnoo noon feɂi sisi» ameen ebaaten. <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Yesuusana feɂi sise, battiikki ayyaanaajjol hassu ibaaddotikko beeren booyyeeli tabeen, kuma lama kalleera booyyeel laga hiɂii metegamatto hegelddeen dageen beke orroo lichchi ameen.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Booyyeel ofofareenna bak'ateen seeteen, maamanina maamankko k'amane kagiro uli odu ayeeseen, gosana kalleero ayees din takkogiro banɂekko bee. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Gosana Yesuusa tos emeetegure hassu battiikki ayyaana abamere kagire ibaaddotikko sammuu abbaabattedde, sarssi sarssate kahamas'eero kakkodiyaaren goorata neen. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Hikka t'aye kaddeera ibaaddo battiikki ayyaana kakkobareero ibaaddotina booyyeel gutii kalleero ayeesi dubba gosaan segeen. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Hassu goorata gosa Yesuusa ulkkisookko gafari goggobeero ebaaten.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Esekkona Yesuusa wolabooyi kakkotabare goorata, durrisa kakkogire ibaaddoti wota seeyin ebaate. <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>Yesuusa usuun feɂi lakkosise, ayesuun goɂameen «Minkkaa seedde Goottaa eeggitakki kaɂatii ayees kuun felerona misii shaaga yelero gosakkaawun segaa» ame. <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Ibaaddoti seetere, Yesuusa kafelero ayeesi dubba maaman tomon kaɂamamaro ul segaano haggaɂabe, kamaale dubba saade.<verse eid="MRK 5:20"/></para>
  <para style="s1">Tagootette unnutina iigi takkoɂubatare heleelttiti</para>
  <para style="r">(<ref loc="MRK 5:22-43">Mar. 5:22-43</ref>; <ref loc="MAT 9:18-26">Mat. 9:18-26</ref>; <ref loc="LUK 8:41-56">Luk'. 8:41-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Yesuusa ade kallami bekekko gama wolabooyi kakkonak'are goorata kamooggan gosa usu tos kukkume, hassu goorata usu labu giridii gire. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Ayihuudikokki min kaɂebiwuun woyichcha kallerokko koo Iyaaɂirosi kaɂamamare eserraa emetere Yesuusa kakkodeyaare goorata luk'k'aa gutii iyyere, <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>«Tic'c'artti unnutti goyi hiɂi gitta fayyidde neefone goggogirttoo emeedde genettaa ese gutii kayi» amaa ataayise ebaate.<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>Yesuusana wota seete kamooggan gosana usu maraamure unɂee debee sesseeteen.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Gees tomonkko lama iigi ubataa takkogire heleelttiti too esee gitte. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Omooggan odo doobjjoolun dollee rakkataa tagitte kaɂabtto dubba goggussattena, dhukkuba haggaaɂataate kuwaarre lakkoɂiisere. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Esena gara kayesuusa kakkomaalatte goorata haarre ibaaddo orromartte emeetedde sarssikkeessa dintte, <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>Aalanttina «Mamisi ligure suure sarssikkeessa kaalaal godine fayyinnara» kaɂamaro ammano abanaayite.<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>Kaɂubatare iigi banneewa aallee, abboosakko hesano maarkkiseyi addeesame. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Yesuusa banneewa hunna usukko biyaano addeesere, gosa tos kambbal amere, «Sarssikkee kadine ayyoyya?» ame.<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>Usukko oɂagaalssatareen, «Gosa unɂaamere kashashafaro diyaagiraan, ‹Ayoyya in kadinera?› misiiɂamatta?» ameen.<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Yesuusa ade hikka kafelera ayyoyo din haar abbaabate maraamurise wochchee. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Heleelttitina eseen me felamero kakkoɂaddesatte goorata abssataanna harɂaa emeetedde usu horee iite rummi dubbana segiite. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Yesuusana, «Unnuttee ammanokka ku fayyiisera nogoddaa gali, abboosakkaakko foolssa» ame.<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Yesuusa hikka ayeesa giraan, Ayihuudikokki min kaɂebiwuun woyichcha kalleero kaɂiyaaɂirosi minkko kaɂemeetere ibaaddo Iyaaɂirosine «unnutta gootetta, goorata kaɂagaalssisaro muun harisatta?» ameen.<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>Yesuusa ade hikka maalegure woyichchatine ammana kuwaarre «Arooɂabssatte!» ame. <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Yesuusa P'et'iroosane Yayik'oobane ade kayayik'ooba abbi Yaannisane kuwaarre maayyona debee goggoseero feɂi lakkosise. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Min kawoyichchaati kakkogiyaaren goorata Yesuusa ibaaddo woo woo amaa yururu ame ootaa giraan dee. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Min tos tabere, «Hikki dubba iyyana oottan metta? Unnuna huddurttetta kuwaarre lakkogootetto» ame.<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>Ibaaddo ade k'ac'c'ifataa usuun osolee. Yesuusa ade ibaaddo dubba minkko beesere unnukokki Odona Aanna usumalee usu wota oɂemeetereen usukko oɂagaalssatareen wota unnu mankkogitto tos tabe. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Esekkona taɂunnu gene abere «T'aalta ki aallii!» ame. «Fureenna, teɂunnu ki amara» amanoya.<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>Unnutina banneewa keete aallite hasserraa hittarraa sesseete. Geeskkisena tomonkko lamaye. Ibaaddona kalleero ayeesii aaloo saade. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Yesuusa ade hikka ayees maayyonna goggoɂaddeesonkko ataayise segeegure, ese kaɂaantto kooko goggosisirawun segee.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">Kahegeroo ulkkeessaa lakkokabajaamaro</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mar. 6:1-6</ref>; <ref loc="MAT 13:54-58">Mat. 13:54-58</ref>; <ref loc="LUK 4:16-30">Luk'. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Yesuusa esekko beere ulkkeessa tos emeete, usukko oɂagaalssatareenna debee sesseeteen. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Tafoolssi arri Ayihuudikokki min kaɂebi agaalssisano haggaɂabe, kamaale ibaaddo kamooggan saade. Isona haa ameen, «Hikki ibaaddoti hikka ayees hayekko helera? Misitti k'arummatta usuun tasisanttetta? Hikki baasajjol genetteessa kakkofelamara misiiya?» amaa saadaa gireen. <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Debeenna «Hikki anaat'eti kamayiraame ere lakkoyoya? Kayayik'ooba, kayoosa, kayihuudana kasimoona abbi lakkoyoya? Abbalaaltteessana hittanii noonne wota giraanna?» hikkakko kakkeeyi usuu handudufaten.<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>Yesuusa ade «Kahegeroo kakkokabajaamon ulkkeessaa, fallikkeessa orroonna kaminee ibaaddokkeessa dollee kuwaarre» hakabajaamooni lakkohesaro ame. <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>Eseenna ohawɂaamareen uc'c'arri gutii gene kayere fayyiisano kuwaarre maamisikki baasa felin lakkodaanddee, <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Ammanatana waattitisoyi saade. Esekkona Yesuusa maaman orroo maraamuraa agaalssisaa gire.<verse eid="MRK 6:6"/></para>
  <para style="s1">Yesuusa ofarameeran tomonkko lama fare</para>
  <para style="r">(<ref loc="MRK 6:7-11">Mar. 6:7-11</ref>; <ref loc="MAT 10:5-15">Mat. 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk'. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>Tomonkko lama isi tos uumere, lama lama yele fare, battiikki ayyaanajjol gutii odonnatina sise. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>«Raakkisinun dama kuwaarre, babo goorttun k'arat'iti goorttun adi maragade kiisiyi arooɂabatteen, <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Keferro tabssayeen, ayesuun goɂameen k'olo lama arooɂabatteen.» <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>«Min koo tos kakkotabitteen goorata usu maamankko taabettani esee adallaayen. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Ibaaddo isin takkok'op'anoyinna takkomaaloni banɂe dubbaa luk'k'aɂoottisinkki gorra hurgufayendden esekko biyaaden seeyeen, hikki isoon seerisanokokki ato linnara» ame hikka ajaja sise.<verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>Isona esekko beeren, ibaaddo c'ubbokko gula goggogalloon lallabeen. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Kamooggan durrisa beesen, omooggan ohawɂaamaran gutii zayitii shigidaa fayyiisen.<verse eid="MRK 6:13"/></para>
  <para style="s1">Kat'ammak'aare Yaannisakokki gowaano</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mar. 6:14-29</ref>; <ref loc="MAT 14:1-12">Mat. 14:1-12</ref>; <ref loc="MAT 6:14-16">6:14-16</ref>; <ref loc="LUK 9:7-9">Luk'. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Kayesuusa mege addeesamaa emeetano wono Herodoosa maale. Ibaaddo kookkoonna «Hikka aankkikki baasa usu kafelara kat'ammak'aare Yaannisa goyikko keera» amaa gire. <verse eid="MRK 6:14"/><verse number="15" style="v" sid="MRK 6:15"/>Kakkaleenna «Eelaasaya» ameen. Kuunɂi adeen, «Kat'awoo kahegeroolkko koo kahegeroo aaniya» amaa gireen.<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Herodoosa ayees kakkomaalare goorata ade, «Ani mete kakkogoosisera Yaannisa goyikko keera» ame. <verse eid="MRK 6:16"/><verse number="17" style="v" sid="MRK 6:17"/>Hikki Herodoosa ussunwa abbikkesatti tafilp'oosa oori Herodiyaada atatanokotti aalanttii abami goggoshamiron ajajeere Yaannisa minkashaano tabise. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Yaannisa Herodoosane, «Abbikkaatti oori goggoɂatannoonkko seera kamuse tirara» ame gire.<verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>Herodiyaadana ese k'uut't'e abattegude Yaannisa lagadisin dootaa gitte, ayesuun goɂameen eseen lakkoɂekkaate. <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Herodoosa horaarjje Yaannisa k'ulluukkina Waawun kaɂassaabame ibaaddoti laano mankkokasanaaye maraan abssataanna oorataa gire. Herodoosa Yaannisa kaɂayeesaro takkomaale tootooyi abssataa gire, halleewo kuwaarre geggelooyi maalaa gire.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Herodoosa takkoɂumulamero arri kabajjayiin min kawonooyi odonnati oɂabaan, kajereene shuumjjolna, kookkoo Galiilaayi addeesame kagiro ibaaddon aamo kaɂatii ekkaase. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Taherodiyaada ere banɂe taɂaamo tabttedde kakkomadaaratte goorata Herodoosana kaɂuumamero ibaaddo geggelaayisse, wononna unnutine, «Ati kadootaatto dubba in hoosa; ani kuun sisirowa» ame. <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Adena «Wononnatikkeekotti mina golleetenna, ati kahoosatte dubba sisirowa!» amaa ammatto tabe.<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Esena Aayettisee tos seettedde «Me hoosara?» antte, Aawona «Kat'ammak'aaro kayaannisa mete sisi» ami hoosa antte.<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Unnutina goorsewa saantte wono tos abbaabattedde, «Kat'ammak'aaro kayaannisa mete gidda yaalɂaayi kayidde goggosissoo dootatara» antte.<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Wonona hikka ayeesii aaloo yaade, halleewo kuwaarre taɂuumanttetto martti horee katabero kaɂammatoo haafura isaagin lakkodoote. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Haanssun wotaadara koo saame farere, kayaannisa mete goosi goggokeennoo fare, usuna seetere minkashaano orroo tabe mete kayaannisa goose, <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>kagoosamero mete yaalɂaayi kayere unnutiin sise; unnutina Aayettiseewun sise. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Yaannisakko oɂagaalssatareen hikka kakkomaalareen goorata emeetenen, rees aateen k'amaleen.<verse eid="MRK 6:29"/></para>
  <para style="s1">Yesuusa gosa kamooggan aamise</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mar. 6:30-44</ref>; <ref loc="MAT 14:13-21">Mat. 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk'. 9:10-17</ref>; <ref loc="JHN 6:1-14">Yan. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Ofarameerenna mankkoseeterenkko Yesuusa tos kukkumeeren kafeleranna kaɂagaalssiseraan dubba usuun segeen. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Kamooggan ibaaddo emeettaanna setaa mankkogire maraan babona aamin goorata lakkogire, «Alla isin kaleti banɂe too tos seeyiddeene abaraan foolssayeen» ame. <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Haanssun kaletti banɂe too wolabooyi seeteen. <verse eid="MRK 6:32"/><verse number="33" style="v" sid="MRK 6:33"/>Isona setaa giraan ibaaddo kamooggan deegure malabe, maamanjool dubbakko tiyaa usukko hore geen.<verse eid="MRK 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 6:34"/>Yesuusa wolabokko kakkodagare goorata gosa kamooggan kakukkumero dee, kafoofiro kallayikki idaad aani mankkogire maraan yaade, kamooggan ayees agaalssisano haggaɂabe. <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>Usu goorata ul hemeenllaa kakkosetare goorata usukko oɂagaalssatareen usu tos gabbalameeren, «Hitti banɂe k'alullattotta, ul hemeen leera. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Ibaaddo kakkogiro maaman tos seeyigure kaɂaamiraan kooko iminayi goggoɂaminarawun gosa gafarina» ameen.<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Yesuusa ade «Kaɂaamiraan isinwa sisa» ame abbaabe. Isona, «Seeyinne iso kaɂaamiraan lama boolee t'agaraayi babo imininne isoon sinissu?» ameen.<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>Usuna, «Babo miyyaa abittaan? Alla seyeenddeene diyaa» ame. Deengureen, babo kenna kunɂub lamana girowa ameen.<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Esekkona gosa eesii c'aree gutii una unaa goggohamas'iroon ajajee. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Gosana bool booli konttom konttomi una unaa hamas's'ee. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Yesuusa babo kenna kunɂub lamana abere daruurii tos diyaa sommaasate, babona ekkaɂebise usukko oɂagaalssatarawun sise; usumaleenna kunɂub lamana dubbaawun hedeede. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Dubbana babo aameen barareen. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Usukko oɂagaalssatareenna kaɂaamamero babokkona kunɂubkko tahessetto hanbba dugud tomonkko lama mig keeseen. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Babo kaɂaamere babbaar kuma kenye.<verse eid="MRK 6:44"/></para>
  <para style="s1">Yesuusa bekee gutii sesseete</para>
  <para style="r">(<ref loc="MRK 6:45-51">Mar. 6:45-51</ref>; <ref loc="MAT 14:22-32">Mat. 14:22-32</ref>; <ref loc="JHN 6:15-21">Yan. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Banneewa Yesuusa gosa gafara giraan usukko oɂagaalssatareen Beetesayida tos hore t'ayi wolaboo goggonak'iranu ajajee, <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Esekko abbaabateren isokko kalebeere ebaayin wodami tos bee. <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>Ul hemeen kakkolaare goorata wolabo badi t'eɂe gitte, Yesuusa kale bagaa gire. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Anbbalnna ataatte foffol kiyaa mankkogitte maraan, usukko oɂagaalssatareen duudaataa feriferattisone wota moɂabataa giraan dee, hemeenkko saatii saagaalkko taa tomonkko lama saatii geeroo kagiro goorata orroo bekee gutii sesseetaa iso tos emeete iso doolmari iisi roorin dootere, <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>Ayesuun goɂameen beke gutii sesseetaa giraan kakkodeyaaren goorata gaari aani lee kakkomutare goorata iyyeen. <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Dubbana usu kakkodiyaaren goorata neen.</para>
  <para style="p" vid="MRK 6:50">Yesuusa ade banneewa, «Allamandde! Aniwayya arooɂabssatteen!» ame.<verse eid="MRK 6:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 6:51"/>Usuna wolabo gutii koratere isone wota hamas's'ee, anbbalnna iise, usukko oɂagaalssatareenna aaloo saadeen. <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>Babo gutii kafelamero baasana lakkoshaaderen wodanattiso ataanii duudde gitte.<verse eid="MRK 6:52"/></para>
  <para style="s1">Yesuusa tagenssaaret'i katamaayi kahawɂamare ibaaddo goggofayyisero</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mar. 6:53-56</ref>; <ref loc="MAT 14:34-36">Mat. 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Bekekko gama kakkonak'areen goorata tagenssaaret'i katamaa tos geegeen wolabona baga tos gabbaleene shiiyeen. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Banneewa wolabokko goggodagenii gosa Yesuusa malabe. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>Isona usu gobobi dubbaa tittiyeengureen dhukkubaaleessaal alggaayi sideen usu mankkogiro banɂe dubba tos keenaa gireen. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Usu kakkogee maaman goorttun katamaa, katamaakko k'ama dubbaa kahawɂamaro raaraadii kaanna sarssikotti sharffi diniin ebaataa gireen; usu kadine dubbana fayyaa gire.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">Yesuusa kasaree Ayihuudikokki seera diide</para>
  <para style="r">(<ref loc="MRK 7:1-23">Mar. 7:1-23</ref>; <ref loc="MAT 15:1-9">Mat. 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Farasaawiilnna Iyyerusaalemikko kaɂemeetere kookkoo seera kamuse kaɂagaalssisare Yesuusa tos emeetenguren maraamuren kukkumen. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Usukko oɂagaalssatareen kookkoo taɂaaloon giraan genee goorttun tabattoyitee genee babo aamaa giraan deen.<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>Farasaawiilnna Ayihuudi dubba odolaalkkisookki woga oorayin amaa, seera malee genenno iidisayi haɂaalooni lakkoɂaamareen. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Giyyakko gogamaraan aali isiɂoottisoo gomuc'c'isaten kuwaarre lakkoɂaamareen. Usumalee k'uldubbo, uulla, filɂena, alggaa aalisano aani kakkalee seera oorataa gireen.<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Farasaawiilnna seera kamuse oɂagaalssisaran Yesuusane, «kukko oɂagaalssataran ootta seera kaɂodolaali kagirraan iiseengureen taɂaaloon giraan genee muun babo aamaran?» ameen hoosateen.<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>Yesuusana, «Kahegeroo Isiyaasaa isin ifissaaddoleekokki gara ‹likkii hegeroo ayeesera; garakkisoonna haa amame s'aafamera;</para>
  <para style="q1" vid="MRK 7:6">« ‹Hikki gosa hiɂii in kabajjara</para>
  <para style="q2" vid="MRK 7:6">wodanattiso adde inkko taffakkinttetta!<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Adda sagadaraan, agaalsisanokkisonna ibaaddo kafelaro seera kaalaalkoya.›<verse eid="MRK 7:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8"/>Ajaja kawaa iisseddeene woga kaɂibaaddo ataayisattaan.»<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Ade haa ame «Wogakakkisin oorayin antteddeene ajaja kawaa kakkoɂissattaan mala abttaan. <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Muse ‹Aabbokkaanna Aayettaa kabajiina, Aabbokkeessa goorttun Aayetteessa kahabaarara duuddo hagowo› ame gire. <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Isin addeen ibaaddoti koo Aabbokkeessa goorttun Aayetteessa gargaarano iisire hikki ‹K'urbbani amanona ani Waawun kasisero ilaboya› goɂame, <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>Isinna hikki ibaaddoti Aabbokkeessa leere Aayetteessa goggogarggarinonkko yelattaan. <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Haanssun alattanun karorissattan wogaan haafura kawaa iggilisattan, hikka aankikki kamooggan ayeenssa felattaan.»<verse eid="MRK 7:13"/></para>
  <para style="s1">Ibaaddo kabbattooyisaro ayees</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mar. 7:14-23</ref>; <ref loc="MAT 15:10-20">Mat. 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Adena Yesuusa gosa isi tos uumere haa ame, «Dubbana in maala, shaada, <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>Sarkko orddee tabere ibaaddo kabbattoyisara ayees koonna laagiro, hikkakko ibaaddo kabbattoyisara isiɂoottessakko sarddee kabiyaaro ayeesiya. <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>Goortta kamaalara nebe kaɂaba hamaalo!» ame.<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Yesuusa gosa iisere min kakkotabare goorata usukko oɂagaalssatareen masuussakokki gara hoosaten. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>Usuna, «Isinuun ayees lakkotabaroya?» Sarkko ibaaddo tos tabere battoyisin kadaanddaara ayees koonna laagiro, <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>Wodana tos halleennoni bogi tos tabara, esekkona maarkko biyaara, Yesuusa hikka ame abbaabattere babo dubba kaɂidankki laano addeesise.<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Debeenna haa ame, «Ibaaddokko kabiyaara hassu ibaaddo battooyisara. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>Wodana taɂibaaddo orrokko kabiyaara kameellan yaada, hetano, ibaaddo lagadano, sharmmut'aano, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>layimano, gap'igap'aano meellane, sobano, rarragatano, k'anaatano, mege baasano, koora, lafuummayyaan. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Hikki kameellan ayees dubba ibaaddokko biyaara ibaaddona battoyisara.»<verse eid="MRK 7:23"/></para>
  <para style="s1">Tasiroofink'a heleelttitikkokki ammano</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mar. 7:24-30</ref>; <ref loc="MAT 15:21-28">Mat. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Yesuusa esekko keere tat'iroosa katamaa dollee kagiro maaman seete, min koo tos tabere usu esee girano maayyona goggoɂaddeesonkko doote, golleenna eseenna siyami girin lakkodaanddee. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Goorsewa ade unnu tic'c'artti battiikki ayyaana takkoon abantette heleelttiti too gara kaɂyesuusa maaltte emeettedde lukki gutii iite. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Heleelttitina ul kagiriikkittitte, alattanttisenna ul kasirofinik'akotitte, esena Yesuusa durrisa unnukko goggobeesiron ebaatte. <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>Usu ade, «Kayiis babo aatiguren keroorun sisin lakkodootisaro, horaarjje yiisaas barari haɂaamo» ame.<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Esena abbaabtede «Ii Goottakkee keroornna dugud tayiiskko taɂiyaatto hanbba aamara antte.»<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>Yesuusana, «Haanssun hikka mankkoɂantte maraan see!» battiikki ayyaana unnuttaakko beera ame.<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>Esena minkkisee kakkoɂabbaabatte goorata unnuna alggaayi gutii tahuddurttettona, battiikki ayyaana tagafarero diyaatte.<verse eid="MRK 7:30"/></para>
  <para style="s1">Yesuusa nebe kaduudena hiɂi oɂayyeesoon ibaaddojja fayyiise</para>
  <para style="r">(<ref loc="MRK 7:31-37">Mar. 7:31-37</ref>; <ref loc="MAT 15:29-31">Mat. 15:29-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Yesuusa tat'iroosa katamaakko keegure, mina tasidoona tonsse katamaa tomon taɂamamatte minane roore tagaliila labu tos emeete. <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Eseenna ibaaddo nebee kamaalonna hiɂi kaɂayeeson ibaaddoti koo usu tos keenen; genenna gutii goggokayiroo ebaaten. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Yesuusana ibaaddoti gosakko kale beesegure, fererroɂoottessa nebebbo oɂibaaddotii orddeese tabise, esekkona hanc'c'ufe ferii tufegure ibaaddotikokki erreb dine. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Daruuri tos t'ok'k'iɂame diyaa eerinnaa neefssategure, «Efittahi» ame, hikkina «Banami» amanoya.<verse eid="MRK 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35"/>Banneewa nebebbo banameen, errebnna furamegure k'ulleessi ayeesano haggaɂabe. <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>Yesuusana hikka ayees maayyoonna iso goggoɂayeesonkko ajajee, halleewo kuwaarre usu ibaaddon goggoɂayeesonkko ataayise ajaja kakkosisare goorata iso adeen balɂayiseen ayeeseen. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Gosana aaloo saadaa «Usu kafelera dubba kaɂidanyya, nebebboo omaaloonna goggomaallawun, hiɂi oɂayyeesoonna goggoɂayeesirawun yelara» ame.<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">Yesuusa ibaaddo kuma afar aamise</para>
  <para style="r">(<ref loc="MRK 8:1-9">Mar. 8:1-9</ref>; <ref loc="MAT 15:32-39">Mat. 15:32-39</ref>; <ref loc="MRK 6:32-44">Mar. 6:32-44</ref>; <ref loc="MAT 16:1-12">Mat. 16:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Hassu goorata abbaabate gosa kamooggan kukkume, iso kaɂaamiraan babo koonna mankkoginnoon maraan Yesuusa usukko oɂagaalssataran isi tos uumegure, haa ame. <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>«Hikki ibaaddo iinne wota arri seed mankkoɂadallaateran maraanna iso kaɂaamiraan babo mankkowattamero maraan in nenɂyisaraan, <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>hikkamalee iso uuɂeen giraan minkkiso gogafare kookkoo ibaaddo ul kaɂeerkko kaɂemeetero mankkollee maraan raadii harigureen iiraanwa ame.»<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Usukko oɂagaalssataren abbaabeen, «Hikka k'alullattokki ulii hikka ibaaddo dubba aamisin kalleero babo haggekko helaminnara?» ameen. <verse eid="MRK 8:4"/><verse number="5" style="v" sid="MRK 8:5"/>Yesuusana, «Babo miyyaa abttaan?» ame iso hoosatte.</para>
  <para style="p" vid="MRK 8:5">Isona «Babo todoba abnna» ameen.<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>Usuna gosa ulii goggohamas'iroon ajajee, babo todoba abere sommaasate abbaabatere babokko ekkaɂebisere ibaaddon goggohedeedinawun usukko oɂagaalssatarawun sise, isona gosaan hedeeden. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Usumaleenna uc'c'ar kidiic'c'ar kunɂub abbanayeen, usuna hikka kunɂubbeelun Waa galateere gosaan goggohedeedirawun ajajee. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Gosana aame barare, esekkona usukko oɂagaalssatareenna tahessetto hanbba dugud todoba mig ammageen keeseen. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Kaɂaamerena kuma afar kalleero ibaaddoya, isona galise, <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>Banneewa usukko oɂagaalssataranne wota wolabooyi tabere Dalmmanuta taɂamamatto banɂe tos seeteen.<verse eid="MRK 8:10"/></para>
  <para style="s1">Malaata din tahoosantetto hoosin</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mar. 8:11-13</ref>; <ref loc="MAT 16:1-4">Mat. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Farasaawiil Yesuusa tos emeetegure usune wota dogamano haggaɂabeen, usu c'aafin dootereen Yesuusa daruurkko malaata goggotusiroon hoosaten. <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>Yesuusa aaloo wodana mararere, «Hitti alattaan malaata kakkondootatta mewuunya? Ani rumminaa amara, hitta alattaanun maamisikki malaatanna lakkosisamiro!» ame. <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>Esekkona iso iisere wolabo tabere bekekko gama nak'e.<verse eid="MRK 8:13"/></para>
  <para style="s1">Tafarasaawilnna taherodoosa meellanekko isi oorayeen</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mar. 8:14-21</ref>; <ref loc="MAT 16:5-12">Mat. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Usukko oɂagaalssatareen babo abatano mankkoɂillooteeren maraan, wolabo orroo babo koo kuwaarre koonna lakkoɂabanaayen. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Yesuusana, «Tafarasaawilkkona taherodoosa meellanekko isiɂooraayen» ame ajajee.<verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>Isona isiɂisi orroo, «Usu haa kakkoon amara noo babo mankkowaannenno maraanya» ameen.<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>Yesuusana k'ofattisoo addeesere, «Babo mankkowaanenno maraanya amaa muun k'oppaattan? Giddanna lakkoshaadattanya? Wodanatisinii lakkoɂaddeesattaanya? Goorttun wodanattisin duuddetta? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Iilɂo giranttii lakkodiyaattanya? Nebe giranttii lakkomaalattanya? Lakkoshaadattaanya? <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>Babo ken ibaaddo kuma kennun ibise kakkosisere goorata hanbba dugud miyyaa mig keessen?»</para>
  <para style="p" vid="MRK 8:19">Isona, «Tomonkko lama migya ameen.»<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>«Usumaleenna babo todoba ibaaddo kuma afarruun ibise kakkosisere goorata dugud miyyaa mig hanbba keessen?» ame.</para>
  <para style="p" vid="MRK 8:20">Isona «dugud todoba mig» ameen.<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>Yesuusana, «Isin gidda gin lakkoshaaddettaan amanoya» ame.<verse eid="MRK 8:21"/></para>
  <para style="s1">Yesuusa tabeetesayida katamaayi ilɂo kabayere ibaaddoti koo fayyiise</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Esekkona Beetesayida tos kakkogeyaaren goorata ibaaddo iilɂo kadiyaannon ibaaddoti koo Yesuusa tos keenen, goggodinddinnoon ebaaten. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Yesuusana iilɂo kabayero ibaaddotikotti gene abere maamankko sar beese, iilɂo ootteessa gutii hanc'c'ufe tufere genetteessa gutii kayere, «Kuun kamutara meyya?» ame hoosate.<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>Ibaaddotina t'ok'k'i ame deere, «Ibaaddo gaa aani lee kasesseetaro diyaara» ame.<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>Yesuusana adena genennoɂootteessa iilɂo oɂibaaddoti gutii kaye, hassu goorata iilɂo tichchise dee, fayyeegure kaɂameen dubba madaare diyaano haggaɂabe. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Esekkona Yesuusa, «Maaman tos arootabtte!» «Hassu maamanii maayyoonna aroosegite» amere minkkeessa galise.<verse eid="MRK 8:26"/></para>
  <para style="s1">P'et'iroosa Yesuusa maraan atotee</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mar. 8:27-30</ref>; <ref loc="MAT 16:13-20">Mat. 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk'. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Yesuusa usukko oɂagaalssatareene wota Filp'oosa K'isaariya kaɂamamaro maaman tos seetaa, raadii giraan Yesuusa usukko oɂagaalssatareene, «Ibaaddo in ayyo amara?» ame hoosate.<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>Isona, «Kat'ammak'aaro Yaannisa oɂamaraan giraan, okkaleenna Eelaasaya amaraan, okkaleenna adene kahegeroolkko kooyya amaraan» ameen segeen.<verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>Debeenna, «Isin adeen in ayyo amattaan?» ame hoosate. P'et'iroosana, «Ati Kiristoosatta» ame abbaabe.<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>Yesuusana, «Isiɂoottessa maayyoona iso goggoseginokko» ame ataayise iso seerise.<verse eid="MRK 8:30"/></para>
  <para style="s1">Yesuusa goyikkeessakokki gara t'aye segaate</para>
  <para style="r">(<ref loc="MRK 8:31-33">Mar. 8:31-33</ref>; <ref loc="MAT 16:21-28">Mat. 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk'. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Esekkona «Ere kaɂibaaddo rakkoo tamooggan atatanona, jaarsoleeyi, katuuk'aamol woyichchaalna seera kamuse oɂagaalssisaran horee kattuffaminaro, kagoyinaro, taseedi arrikko abbaabayire kakkinaro agaalssisano haggaɂabe.» <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>Usuna hikka addeesise isoon segee, hassu goorata P'et'iroosa Yesuusa kale beesere hadisano haggaɂabe. <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>Yesuusa ade kambbal amere usukko oɂagaalssatareen tos diyaa P'et'iroosane, «Ati S'alaye, inkko fakkimi! Ati kaɂibaaddo kuwaarre ayees kawaa lakkok'oppaatto» ame hadise.<verse eid="MRK 8:33"/></para>
  <para style="s1">Kiristoosa debeesesseetano tamursisaro muraa</para>
  <para style="r">(<ref loc="MRK 8:34-38">Mar. 8:34-38</ref>; <ref loc="MAT 10:38-39">Mat. 10:38-39</ref>; <ref loc="MAT 16:24-28">16:24-28</ref>; <ref loc="LUK 9:23-27">Luk'. 9:23-27</ref>; <ref loc="LUK 14:25-27">14:25-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Esekko abbaabatere Yesuusa gosa usukko oɂagaalssataranne wota isi tos uumere «Indebee sesseeyin, kageelaatara gogire isiɂootteessa hakakkate, mask'aliitatteessa sidayire indebee hasesseto. <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Neefotteessa haasayin kadootatara dubba baasatara, in maraanna wongala maraan neefotteessa roorisate kasisatara dubba ade isiɂootteessa fayyisatara. <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Ibaaddoon alami dubba kakkeessa golee neefo gowaate meyii laɂo aba? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Haa gollee ibaaddo neefotteessan me wodoo aba? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Hitta talayimaattona c'ubbaalessatti alattaan horee iyyeenna haafurakkeeyi kamullaara dubba, ere kaɂibaaddo Aabbokkeessatti kabajaa, k'ulluukki erggichchaalnne wota kakkoɂemeete goorata usuu ani mullinara» ame.<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="s1">Middi tayesuusakokki iggilissamano</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mar. 9:2-13</ref>; <ref loc="MAT 17:1-13">Mat. 17:1-13</ref>; <ref loc="LUK 9:28-36">Luk'. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Adena Yesuusa, «Ani rumminaa amara hittanii oɂaalleeran orrokko wononnati kawaa hunnaa emeetaa giraan taa deerani ogoonooni giraan» ame.<verse eid="MRK 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Arri talleyikko abbaabatere P'et'iroosa, Yayik'oobana Yaannisa abegure taɂeertti wodami too tos aate bee, kalenna gireen, isoo horeenna middittessa iggilissantte. <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>Sarssikkeessana hikka ul gutii maayyona sarssi kaɂaalisara muc'c'isin kadanddeenoon gitakki aaloo gumaara lee. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Eelaasanna Musena Yesuusa wota ayeesaa giraan muteen. <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>P'et'iroosana Yesuusane; «Kaɂagaalssisatto! Hittanii girnnewa noyyeen kaɂidankkiye; too kuyeen, too Museen, too Eelaasan talleeto daase seed madaarnno» ame. <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Aaloo mankkoɂabssateraawun P'et'iroosa kaɂayeesarona lakkoɂaddeesare.<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>Esekkona duumanchcha emeetegure hogoogise; duumanchcha orrokko, «Hikki ani kageelaataro erekkeeya; usu maala!» taɂamatta yaaye maalssantte. <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Goorsewa kambbal ami godeeran Yesuusa kuwaarre kakkalee maayyonna isone wota lakkogire.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Wodami guukko kakkodagare goorata ere kaɂibaaddo goyikko taakeeroo gin kaddeeraan maayyoonna goggoseginonkko ajajee.<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>Isona kaɂayeesamero haafura wodanattisooyi abbateen; ayesuun goɂameen, «Goyikko kiyaano» me amanoyo isiɂisirroo ayeesaa gireen. <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>Esekkona, «Seera kamuse oɂagaalssisaran t'ayi emeeyin kaddootisara Eelaasaya muun amaraan? Amaa hoosaten.»<verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>Yesuusana, «Ogiraan Eelaasa emeeyigure ayees dubba ekkaasinara; hayya ere kaɂibaaddo tamooggan rakkoo atayiinna tuffamin dootisara amame kakkons'aafamera mewuunya? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Ayesuun goɂameen, Eelaasa t'aye emeete gire; ibaaddo garakkeessa goggos'aafamero malee kaddootateeraan dubba feleen» amara.<verse eid="MRK 9:13"/></para>
  <para style="s1">Battiikki Ayyaanayi kaɂabamere unnuttikokki fayyaano</para>
  <para style="r">(<ref loc="MRK 9:14-28">Mar. 9:14-28</ref>; <ref loc="MAT 17:14-21">Mat. 17:14-21</ref>; <ref loc="LUK 9:37-43">Luk'. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Yesuusana seeddo usukko oɂagaalssatareen oheseeran usukko oɂagaalssataran tos abbaabateen kakkoɂemeetareen goorata gosa kamooggan iso maraamure kukkume giraan dee, seera kamuse oɂagaalssisaran isone wota dogamaa gireen. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Gosa dubba Yesuusa deegure goorsewa mamere usu tos tiiyye seetegure nogodda aate.<verse eid="MRK 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16"/>Yesuusana, «Isone wota kakkondogamattaan eeti haajaayiya?» amaa hoosate.<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>Gosa orrokko ibaaddoti koo haa ame: «Kaɂagaalssisatto; hiɂi kaduudisaro battiikki ayyaanayi kaɂabamero unnukkee ku tos keenayera; <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>kakkokeero goorata banɂe dubbaa lugudara, saanbbana gudisara, ilkkona fooc'ara, maarnna zorddoyisara; battiikki ayyaana usukko goggobeesinawun kukko oɂagaalssatarawun segaaye; isona beesin lakkodaanddeen.»<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Yesuusana abbaabere; «Isin taɂabddannon alattaan;» «hagge taageeroon isinne wota girnnara? Hagge taageeroon obssinara? Unnu in tos keena!»<verse eid="MRK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20"/>Ibaaddona unnu Yesuusa tos keene; battiikki ayyaanana Yesuusa kakkodiyaare goorata unnu goorsewa harɂiisano, ul lugudano, ulle boc'c'aanona saanbba gudisano haggaɂabe.<verse eid="MRK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21"/>Yesuusana kaɂunnuti odo uumere, «Hikki arooɂabekko gees miyyaaye?» ame hoosate. Usuna haa ame abbaabe; «Yiisummakko haggaɂabereya.»<verse eid="MRK 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 9:22"/>«Lagadin dootegure arggetto eleen orronna beke orroddeese lugudara; kadanddeeto golleete nenɂeyisana; gargaarina.»<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>Yesuusana, « ‹Kadanddeeto gollee› » antte? «Kaɂammanaro ibaaddon ayees dubba daanddaamara» ame.<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>Goorsewa kaɂunnuti odo, «Abddatara; ayesuun goɂameen abddi takkowaataroo in gargaarina!» amaa okkee.<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Yesuusana, gosa eserraa tiittaa kaɂemeetaro kakkodiyaare goorata, «Ati hiɂi kaɂayeesoninna nebee kamaaloon ayyaana usukko beena! Kallami abbaabayi usu tos goggotaboonkko ajajaara!» ame battiikki ayyaana hadise.<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Battiikki ayyaanana okkee, unnu aaloo ulle boc'ee abbaabatere gafare bee; omoogganna, «Goyera» taaɂamiranii rees aani lee. <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Yesuusa ade taɂunnu gene abe keese; unnutina kee aallee.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Yesuusa min orroddee kakkotabare goorata usukko oɂagaalssatareen kale beeneen, «Noo beesin kakkowannenna muunya?» ameen hoosaten.<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>Usuna «Hikka aankkikki kakkobiin daanddaara ebiinna agabuuyi» kaalaalii kuwaarre maamesinna bin lakkodaanddaaro ame.<verse eid="MRK 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Esekko keegure maaman kagaliilane roore; Yesuusana, maayyona usu takkogiro banɂe goggoɂaddeesiro lakkodootero; <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>Usukko oɂagaalssatarawun, «Ere kaɂibaaddo gene taɂibaaddoyi roorssami sisaminara; isona lagadinaran, arri seedkko danbbeebaan goyikko kinnara» amaa agaalssisaa gire.<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>Isoon ade usu kaɂamara lakkotabere, hoosayinna abssateen.<verse eid="MRK 9:32"/></para>
  <para style="s1">Dubbaankko karoorara ayyoyya?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mar. 9:33-37</ref>; <ref loc="MAT 18:1-5">Mat. 18:1-5</ref>; <ref loc="LUK 9:46-48">Luk'. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Esekko abbaabatere Yesuusana usukko oɂagaalssataran tak'ifirenaahoomi katamaa tos emeeten. Min orroddee tabegure «Raadii giraan kakkondogamatteen gara kammeeya?» ame hoosate.<verse eid="MRK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34"/>Iso adeen raadii giraan kakkodogamareen dubbaankko kajiinaatara ayyoyya? Kaɂamaro mankkolee maraan c'alɂi ameen. <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>Yesuusa hamas's'eegure iso orrokko tomonkko lama uumegure, «dubbaankko kahoree liin kaddootatara, dubbaankko harc'c'ana dubbaawun kahandaaro halleewo» ame. <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>Kic'c'arkki yiittiti keenegure iso t'eɂee aallise; kabalatere, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>«Hikka yiisaaskko koo megekkeeyi kak'op'atara dubba in k'op'atara; inna kak'op'atara in haalleenooni in kafarero k'op'atara» ame.<verse eid="MRK 9:37"/></para>
  <para style="s1">No kadiidoon dubba noonne wota gira</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mar. 9:38-40</ref>; <ref loc="LUK 9:49-50">Luk'. 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>«Yaannisana, kaɂagaalssisatto ibaaddoti koo megekkaayi durrisa beesaa giraan deenne, no wota mankkosessennowun maraan tirnnenna» ame.<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Yesuusa ade haa ame; «Arootirtteen; maayyonna megekkeeyi baasa feligure goorsewa in gutii tameellan ayeesin lakkodaanddaaro; <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Noo kadiidoon dubba noonne wota gira; <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Ani rumminaa amara okiristoosa mankkoleeteen maraan megekkeeyi k'uldubbo too beke isin kat'amisara dubba laɂo lakkowaaro» ame.<verse eid="MRK 9:41"/></para>
  <para style="s1">Kakkaleetun handuddufo laano</para>
  <para style="r">(<ref loc="MRK 9:42-50">Mar. 9:42-50</ref>; <ref loc="MAT 18:6-9">Mat. 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk'. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>Maayyona iin oɂammanaraan hinɂa otitiic'c'arkko koo kahanduddufisara dubba kaɂatii eɂemo karriime marggii shiyaamigure beke orroddi shafamewa idankkiyya. <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>Haanssun genetta ku gohanduddufise goosina; gene lama kuun girigudde gahaanname tabbaanon eleenii tos tabanokko, gene muddunane wota jiruu jiroommakki giri tos tabano kaɂidankkiya; <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>Gahaanname eleen tabaanoon; hiskkittisona lakkogooto eleenna lakkobaato. <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>Luk'k'aɂootta ku gohanduddufisen goosina; luk'a lama kuun girigureen tabaanon eleen orroddi shafamanakko, kaɂeesatto liigudde jiruu jiroommakki giri tos tabano kaɂidankkiya; <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>Tabaanon eleenii hiskkina lakkogooto eleenna lakkobbaato <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>Iltta ku gohanduddufise tagi beesi; iilɂo lama girigureen gahaanname eleen tabbaanon orroddi tabanokko, il too girigudde wononnati kawaa tos tabano kaɂidankkiya; <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>Tabbaanon eleenii hiskkinna lakkogooto, eleenna lakkobbaato.<verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>«Jaarsso esseboo goggomuc'c'iɂamaroo ibaaddo dubbana eleenii muc'c'iɂamano dootisara.<verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>«Essebo taɂidanttitta; ayesuun goɂameen essebo onɂomoonjettisee gowaatte meyii abbaabi onɂomoonjetise goggogirttoon yelnnattaan? Essebo isin orroo haggirtte; isi isiɂorroonna ekkaayen nogoddaa gira.»<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">Kaɂoorinna kaɂentteree keelkki amamano</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mar. 10:1-12</ref>; <ref loc="MAT 19:1-12">Mat. 19:1-12</ref>; <ref loc="LUK 16:18">Luk'. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Yesuusa esekko keegure, ul kayihuuda tosna Yorddaanoskko gamanne kagiro gobob tos seete; aaloo kammooggan gosa ade usu tos kukkuɂamaa gire; hittakko horeene goggoyelaa gireeyi iso agaalssise.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Kafarasaawi ibaaddokko kookkoo Yesuusa tos emeetegure; usu c'aafin dootegure, «Ibaaddo ooritteessa keelkki ami gafarin dootisara?» ameen hoosaten.<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>Usuna abbaabere, «Muse me ame isin ajajeera?» ame.<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>Isona, «Muse goɂameen keelkki kakkoɂamamero worak'ata s'aafire goggogafarroo ame feɂi sisera» ameen.<verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Yesuusana abbaabere; «Muse hikka ajaja kakkoons'aafera wodanattisin taduudde mankkolleete maaranya.» <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>«Ayesuun goɂameen Waa t'aye ibaaddo met't'aa ‹Babbaartitina heleelttiti yele met't'ee.› <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>‹Haanssun ibaaddo Aabbokkeesana Aayetteessa iisaagara; ooritteessane wota k'urannaamara; <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>Iso lamana maar koo laaran;› goorttanun maar koo laaran kuwaarre lama lakkoyaan; <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Haanssun Waa kak'uranneero maayyona furin lakkodaanddeero» ame.<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Adena min kakkotabareen goorata, usukko oɂagaalssatareen hitta haajaa keeseen hoosaten. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Yesuusana «Maayyonna ooritteessa keelkki amere takkalee kaɂatatara ooritteessa gutii sharmmut'aara; <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Esena entterkkiseekko keelkki amamidde kakkaleetun gokkeesantte sharmmut'itetta» ame.<verse eid="MRK 10:12"/></para>
  <para style="s1">Yesuusa yiisaas sommaasate</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mar. 10:13-16</ref>; <ref loc="MAT 19:13-15">Mat. 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk'. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Yesuusa goggodindinnon; ibaaddo yiisaas usu tos keenataa gire; Yesuusakko oɂagaalssatareen adeen hadiseen. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Yesuusana hikka deegure amaraatere; «Yiisaas in tos haɂemeete, aroottirtteen; wononnati kawaa hinɂa aanɂinɂiiya ame. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Ani rumminaa amara; wononnati kawaa yiisaas aani kak'op'annon dubba suure lakkotabiro» ame. <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Yiisasnna kabalate abatere; genetteessa iso gutii kayegure sommaasate.<verse eid="MRK 10:16"/></para>
  <para style="s1">Dureessakki ibaaddoti</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mar. 10:17-31</ref>; <ref loc="MAT 19:16-30">Mat. 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk'. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Yesuusa esekko beegure raadii bee sesseetaa giraan, ibaaddoti koo usu tos tiyaa emeete; usu horee gilbbisegure «kaɂidankki kaɂagaalssisatto; jiruu jiroommakki giri eelin me yelin dootisara?» ame. <verse eid="MRK 10:17"/><verse number="18" style="v" sid="MRK 10:18"/>Yesuusana; «Muun in kaɂidankki amatta? Waa koo kuwaarre kaɂidankki lakkogiro; <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Ajaja kaseera kassowa; aroolagadde, aroosharmuut'ite, aroohette, t'ara arooɂatotiite, aroosobtte, Aabbokkaanna Aayettaa kabajjiina» ame abbaabe.<verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>Ibaaddotina, «Kaɂagaalssisatto; hinɂa dubba yiisummakko haggaɂabere oorayeera» ame.<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Yesuusana deegure geelate; «Goorttanu ayees kooyya kuun kahank'atera; seegudde kaɂabtto dubba daddaligudde; hiyyeessalun sisi; daruurnna okukkuɂameraan urrawo helayinnatta; esekko danbbeebaan koyi iin debee sessee» ame. <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Ibaaddotina hikka kakkomaalare goorata gomeellan yaade; usuun urrawo omooggan mankkoggireen maraan yaadaa seete.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Yesuusa kambbal ame deegure usukko oɂagaalssataranne, «Dureessajjol wononnati kadaruure tabano misikki kaɂisilaaro ayeesya!» ame.<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>Usukko oɂagaalssataran ayeeskkessayi mameen; Yesuusa ade abbaabate haa ame; «Yiiskkee; wononnati kawaa tabano misikki kaɂisilaaro ayeesya! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Dureessan wononnati kawaa tos tabanokko suure gaala butto kamarffine orromari roorano ene leera» ame.<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>Usukko oɂagaalssataranna aaloo mamanoyi, isiɂisi orroo «Hayya ayyoyya fayyiin kadaanddaara?» ameen.<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>Yesuusana iso tos diyaa, «Hikki ibaaddo dollee lakkodaanddaamaro; Waayi dollee goɂameen daanddaamara; waayi dollee kameen dubbana daanddaamara» ame.<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>P'et'iroosana, «Hikkima noonna kameen dubba iinsse ku debee sesseennenna» ame. <verse eid="MRK 10:28"/><verse number="29" style="v" sid="MRK 10:29"/>Yesuusana abbaabe; «Ani rumminaa amara; in maraaninna wongala maraan amere minkkeessa goorttun abbilaaltteessa goorttun abbalaaltteessa goorttun Aayetteessa goorttun Aabbokkeessa goorttun yiiskkeessa goorttun irakkeessa kaɂiise dubba, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>Gidda hikka geesii bak'atanone wota minjjool, abbilaal, abbalaal, Aac'c'olaal, yiisaas, irana boolkokki ambbaa atayinara, kaɂemeetaro alamii jiruu jiroommakki giri kaɂeeloon lakkogiro. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Ayesuun goɂameen ohoree olleeraan omooggan oddanbbee linnaraan, oddanbbee olleeraanna ohoree liinaraan» ame.<verse eid="MRK 10:31"/></para>
  <para style="s1">Yesuusa goyikkeessakokki gara goorata kaseedi ayeese</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mar. 10:32-34</ref>; <ref loc="MAT 20:17-19">Mat. 20:17-19</ref>; <ref loc="LUK 18:31-34">Luk'. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Iyyerusaalemi tos biyaa raadii giraan, Yesuusa horehayere sesseetaa gire; usukko oɂagaalssatareen mameen, okkalee debee osesseetareen adeen abssateen gineen adena tomonkko lama gosakko assaabere me usu ginnaro segee; <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>«Goortta noo Iyyerusaalemi tos binnanna, ere kaɂibaaddo tuuk'aamokokki woyichchaaluniinna seera kamuse oɂagaalssisaraawun roorissami sisaminara; isona goyikokki firdda firddinaraan; Ayizaabn roorisi sisinaran; <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>Ayizaablna k'ac'c'ifayinara; hanc'c'ufena tufinaraan, boc'c'innaraan, esekkona lagadinaran; usu adi arri seedkko danbbeebaan kiinnara.»<verse eid="MRK 10:34"/></para>
  <para style="s1">Tayayik'oobana tayaannisa hoosin</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mar. 10:35-45</ref>; <ref loc="MAT 20:20-28">Mat. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Esekkona yiis kazabddoosa Yayik'oobana Yaannisa Yesuusa tos gabbalameengureen, «Kaɂagaalssisatto; noo kukko kaɂebaatanno dubba noon goggosissoo dootanna» ameen.<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>Yesuusana, «Me ani isinuun goggoyelloon dootaattan?» ame.<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>Isona, «Kabajattaakki goorataayi nookko koo merggettaayi koo betettaayi goggohamas'iinnon noon feɂi sisi» ameen.<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>Yesuusana, «Isin kaɂebaatattaan lakkokassaan; ani tat'amaro tarrakkoo t'ugga t'amin, ani kat't'ammak'aamaro t'ink'ata t'ammak'amin daanddaattan?» ame.<verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>Isona; «Ii daanddaanna» ameen. Yesuusana; «ani tat'amaro t'ugga t'anttaanwa; ani kat'ammak'aamaro t'ink'atanna t'ammak'anttanwa; <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>Ayesuun goɂameen merggetteeyi goorttun betetteeyi hamas's'aano Waa kakkoonɂekkaaseron kuwaarre ani kasisinaro ayees lakkoyo» ame.<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Oheseeren tomonno hikka maaleengureen Yayik'oobana Yaannisa inggaamano haggaɂabeen. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Yesuusana iso raattoo kukkuyisere haa ame; «Kaɂayizaab woyichchaal amameen ohedamaraan odonnati obariisinnaraan, shuumooleettisona iso gutii odonnati otusayinnaran isin kassanwa; <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Isinii dollee ade hikkamalee liin lakkodootisaro; isin orrokko kanjjinkki liin kaddootatara dubba isinuun kahandaaro halleewo; <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>kahoree liin kaddootatara dubba kadubbaa diyyii halleewo; <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Ere kaɂibaaddo handdayinna neefotteessa kamoogganun wodoo yeli sisayin emeetera kuwaarre goggohanddayinawun lakkoɂemeetero.»<verse eid="MRK 10:45"/></para>
  <para style="s1">Yesuusa Iilɂo kabayero Bert'elomeewosa fayyiise</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mar. 10:46-52</ref>; <ref loc="MAT 20:29-34">Mat. 20:29-34</ref>; <ref loc="LUK 18:35-43">Luk'. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Esekko abbaabateeren taɂiyyaarkko katamaa tos emeeten. Yesuusana usukko oɂagaalssatareen gosa kamoogganne wota Iyaarkokko biyaa giraan iilɂo kadiyaannon kat't'emewosa ere Bert'elomeewosa raa giridii hamas's'eere ebaataa gire. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Usuna esene karoorara kanaazireti Yesuusa laano kakkomaalare goorata, «Ere kadaawute, Yesuusa; in maari!» amaa okkaano haggaɂabe. <verse eid="MRK 10:47"/><verse number="48" style="v" sid="MRK 10:48"/>Kamoogganna usu c'alɂi goggoɂamiroo hadiseen; usu goɂameen, «Ere kadaawute; in maari!» amaa aaloo jiinase iyyee. <verse eid="MRK 10:48"/><verse number="49" style="v" sid="MRK 10:49"/>Yesuusana aalleegure; «Uuma!» ame. Isona Iilɂo kabayerone; «Allamandde! Ki! Yesuusa uumara!» ameen. <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>Usuna sarssikkeessa shafegure fit'a ame kee aallee Yesuusa tos emeete. <verse eid="MRK 10:50"/><verse number="51" style="v" sid="MRK 10:51"/>Yesuusana «Me goggoyelloo dootatta?» ame. Iilɂo kadiyaannonna «Kaɂagaalssisatto; din dootara» ame. <verse eid="MRK 10:51"/><verse number="52" style="v" sid="MRK 10:52"/>Yesuusana; «See ammanokka ku fayyiisera» ame; goorsewa iilɂo deenddeen; usu raannewa Yesuusa debee sesseete.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">Yesuusa taɂatii kabajaayi Iyyerusaalemi tos tabe</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mar. 11:1-11</ref>; <ref loc="MAT 21:1-11">Mat. 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk'. 19:28-40</ref>; <ref loc="JHN 12:12-19">Yan. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Yesuusana usukko oɂagaalssatareen Iyyerusaalemi kakkogabbalamereen goorata zayitii kabiyaara gaa takkoɂalataro wodami tonsse dollee kagiro kabeetefaagena kabitaanya maaman tos geegeen, Yesuusa usukko oɂagaalssatareenkko lama haa amaa fare; <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>Isin horee kagiro «Maaman tos seeyeen; ibaaddo hamas's'i takkokasoon darmmee tademeer esee tashaanttetto helnattaan; furaddeene keena; <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Maayyona, isinne ‹Misi yelattaan?› goɂame; ‹Goottawun dootisara; banneewa abbaabi farnnara amaddeen segaa.› »<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Isona seeteen; min kooyi sarre tashaanttetto darmmee tademeer heleen; fureen. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>Esee aallee kagire ibaaddokko kookkoo, «darmmee kakkonfurattaan mewuunya?» ame hoosate. <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>Isona, Yesuusa kaɂamero ibaaddon kakkosegaaren goorata isona feɂi siseen. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Darmmeenna Yesuusa tos keenenguren sarssikisoo kadarmme bagadi gutii yayeen; usuna gutii hamas's'ee. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Kamooggan ibaaddona sarssikisoo raadii yayeen; okkaleenna adeen kabarzafe gaakko ballaal tarshee aateen ul yaa gireen. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Yesuusakko horeene osesseetarenna haarre debee osesseetaren kaɂatii haafuraayi haa amaa gireen; «Hoosaɂina!» Mege kagoottayi kaɂemeetara kasommaasameya!<verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>«Kaɂemeetara Aabbokkaani kadaawutekki wononnati kasommaasameya;»</para>
  <para style="q1" vid="MRK 11:10">«Hoosaɂina aariyaami!» (dubbaankko t'ok'k' kaɂantte daruurii somma waawuun halleen!) amaa iyyaaren.<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Yesuusana Iyyerusaalemi geegee; esekkona k'ulluukki min kawaa tos tabe; usu maraamure kagiro dubba dee; ul hemeen kakkolaare goorata tomonkko lamane wota Bitaanya tos seete.<verse eid="MRK 11:11"/></para>
  <para style="s1">Yesuusa kak'anggeero kabalasi gaa</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mar. 11:12-14</ref>; <ref loc="MAT 21:18-19">Mat. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Tallami arri Yesuusa Bitaanyakko biyaa giraan uɂee. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Usuna baalallo kaɂabo kabalesi gaa ebbaa dee; woddaasa il dubami girtto amaa usu gaa tos seete; ayesuun goɂameen usu gaa takkodubaamaro diginni lakkotte baalallo kuwaarre koonna lakkohelate. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Esekkona Yesuusa kabalasi gaanne; «Giddakko haggaɂabire jiruu jiroomman maayyonna kukko il arooɂaamo» ame. Usukko oɂagaalssatareen usu hikka ayeesaa giraan maaleen.<verse eid="MRK 11:14"/></para>
  <para style="s1">Yesuusa k'ulluukki min kawaa orroo</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mar. 11:15-19</ref>; <ref loc="MAT 12:12-17">Mat. 12:12-17</ref>; <ref loc="LUK 19:48">Luk'. 19:48</ref>; <ref loc="JHN 2:13-22">Yan. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Iyyerusaalemi tosna seeteen; esekkona Yesuusa k'ulluukki min kawaa orroddee tabegure, oɂiminataraanna odaddalataran orrokko beesano haggaɂabe, maragade oɂiggilssataraankonɂi t'arap'eezzalnna arabe odaddalatarankokki arjaataal minaminaɂabbaabe; <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Maayyonna huu sidaayire k'ulluukki minkkotti ali orroo mari goggororoonkko tire. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Agaalssisaanna haa ame; «Minkki gosa dubbaan min kaɂebiya amamara amame lakkos'aafameroya? Isin addeen kashittaa laga yeltteen!» ame.<verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Katuuk'aamol woyichchaalnna seera kamuse oɂagaalssisaran hikka maaleengureen usu tayeli lagadinaan raa dootano haggaɂabeen; halleewo kuwaarre gosa dubba agaalssiskkeessaa mamaa mankkogire maraan usu abssatenan. <verse eid="MRK 11:18"/><verse number="19" style="v" sid="MRK 11:19"/>Ul hemeen kakkolaare goorata Yesuusana usukko oɂagaalssataran ese katamaakko beengureen seeteen.<verse eid="MRK 11:19"/></para>
  <para style="s1">Gaa kabalasi angage</para>
  <para style="r">(<ref loc="MRK 11:20-26">Mar. 11:20-26</ref>; <ref loc="MAT 21:20-22">Mat. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Tallami arri bari raane rooraa giraan, gaa kabalasi hididinnee kaɂangagero deen. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>P'et'iroosa ayees k'alli kakkoɂamare goorata Yesuusane, «Kaɂagaalssisatto; hikkima ati kak'anggitetta kabalasi gaa angagera» ame.<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Yesuusana abbaabere; «Waayi ammana.» <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>«Ani rumminaa amara; maayyonna hitta wodamine, ‹Tagamidde beke orroddee ii› goɂame hikkana wodanatteessayi ahedannoonii goɂebaate leerowa. <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Haanssun ebii kaɂebaatattaan dubba kaɂatatteettaan aani yeli goɂammanatteen leerowa. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Adena ebaayin kakkoɂaalliteen goorata; kadaruure Aabbokkisin c'ubbokkisin haheso goggoɂamiroo; isinna ibaaddo gutii taɂabttaan kajju dubba haheso ama. <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>Isin kakkaleekokki baas haheso goɂamoon ade kadaruure Aabbokkisin c'ubbokkisin haheso lakkoɂamiro.»<verse eid="MRK 11:26"/></para>
  <para style="s1">Odonnati kayesuusa gutii hoosiin keete</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mar. 11:27-33</ref>; <ref loc="MAT 21:23-27">Mat. 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk'. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Adeen Iyyerusaalemi tos seeteen; Yesuusa k'ulluukki min kawaa awudii orroo sesseetaa giraan katuuk'aamol woyichchaal, seera kamuse oɂagaalssisaranna jaarsolee usu tos gabbalameengureen, <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>«Hikka ayeesjjool kakkofelatta odonnati kaayyoya? Hikka goggofeltton kuun odonnati kasisera ayyoyya?» ameen.<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Yesuusana abbaabere; «Alla ani hoosiin too isin hoosaro; abbaaba; aninna hikka ayeesijjool eeki odonnati ani felaro gachchoosegiira. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Kayaannisa t'ink'ata Waakkoya muu ibaaddokkoya? Abbaaba» ame.<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>Isona isi isiiroo haa ameen; «Waakkoya goɂaminne, ‹Hayya muun ammanana waattettaan?› aminara; <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Hayya ibaaddokkoya aminno?» gosa dubba Yaannisa ogiraan kahegeroo laano abddateen mankkogireen maraan abssateen. <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Haanssun Yesuusaan «Noo lakkokansso» ameen abbaabeen. Yesuusana, «Goorttanun aninna hikka ayeesijjool eeki odonnati ani felaro lakkoseginaro» ame.<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">Kawoyinii akaakiltte ofelaraankokki masuussa</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mar. 12:1-12</ref>; <ref loc="MAT 21:33-46">Mat. 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk'. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>Esekkona Yesuusa haa amaa masuussayi isoon segaano haggaɂabe; «Ibaaddoti koo kawoyinii akaakiltte abbarate; maraamurise ooti kaate; woyinii kakkomuulaaro gumbbina oshate; taɂoraroo tak'ena madaarate; esekko otateen obaraarawun kirayii sisegure ul kakkalee seete. <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Kaami takkokukkuɂamaro diginni tadubanttetto tawoyinii ilkko goggokeennawun usuun kahandaarekeessa otateen obaraaran tos fare. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Iso goɂameen abeen boc'c'een gene taalaalnna gafareen. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Adena kakkalee kahandaaro fare; isona metekkeessa berɂeesen yeraaseen abbaabeen. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Giddanna ade kakkalee fare; hikkana lagadeen; okkalee omooggan orrokko kookkoo boc'c'eeran; kookkoonna lagadeen.<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>«Giddanna kafaraminara kakkalee usuun gire; usuna usu kageelaataro erekkeessaye; ‹Erekkee kabajiinawa› amaa dubbaankko danbbenne fare.<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>«Otateen obaraaran goɂameen isiɂorroo; ‹Hikki waannaa kaɂeelaroya; koyeen laganddo; erretteessa tattaani leeta› ameen. <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Esekkona abeen lagadeen; tawoyinii banɂekko sar beesen shafeen.<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>«Goorttanu gaa kawoyiniikokki odo me kayelnnaro aani laara? Emeeyinara; otateen obaraaran lagadinara; kawoyinii akaakiltte okkaleetun sisinara. <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>Goorttun,</para>
  <para style="q1" vid="MRK 12:10">« ‹Gimbbe oginbbaaraan kattuffateen eɂemo,</para>
  <para style="q2" vid="MRK 12:10">usu mina afarruun mete lee; amame kas'aafamero haafura lakonabbabtteettaaniya? <verse eid="MRK 12:10"/><verse number="11" style="v" sid="MRK 12:11"/>Hikka kafelera Gottaaya; hikkina Iilɂoɂoottanii kasaadisiroyya.› »<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Ayihuudikokki woyichchaal Yesuusa masuussayi kakkoɂayyesera garakisoo laano kakkoɂaddeesare goorata usu abin doote; ayesuun goɂameen gosa mankkoɂabssatare maraan iise seete.<verse eid="MRK 12:12"/></para>
  <para style="s1">K'eesarin giira muranokokki gara</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mar. 12:13-17</ref>; <ref loc="MAT 22:15-22">Mat. 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk'. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Esekkona ayees hegelkko aati abin kafarasaawi ibaaddokkona taherodoosa unakko ibaaddo Yesuusa tos fareen. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Isona emetengureen; «Kaɂagaalssisatto; ati karrummii ibaaddoti laanokkaa kanssowa; bebbeed taɂibaaddo deete koo tos haɂululisooni kawaa raa kaalaal rummi agaalssisatta; golleenna k'eesarin giira murin dootisara muu lakkodootisaroya? Noo murnno muu lakkomurnoya? <verse eid="MRK 12:14"/><verse number="15" style="v" sid="MRK 12:15"/>Yesuusa goɂameen ifissaaddaa laanokkisoo malabere; muun inkko ayees hegelkko aatin dootaattan?» Alla dinnaari koo keena ani deero ame. <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>Isona keneen, «Hitti middi taayyotta? S'aafano kaayyoya?» ame iso hoosate,</para>
  <para style="p" vid="MRK 12:16">«Isona tak'k'eesaritta» ameen.<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>Yesuusana; «Kak'eesari kalleero K'eesaariwun sisa kawaa kalleero Waawun sisa» ame.</para>
  <para style="p" vid="MRK 12:17">Isona usuu mameen.<verse eid="MRK 12:17"/></para>
  <para style="s1">Goyikko kiyaanokokki gara</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mar. 12:18-27</ref>; <ref loc="MAT 22:23-33">Mat. 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk'. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Hittakko horenbbaan goyikko kiyaano lakkogiro oɂamaraan kasodek'awil ibaaddo Yesuusa tos emeetegure haa amaa hoosate; <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>«Kaɂagaalssisatto;» ibaaddoti kookokki abbi oori atayigure yiis haɂumuloon goggoye, «Hikki ibaaddoti hitta heleelttiti atayigure abbikkeessatti sannii goggokayiroo ame Muse s'aafera. <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Hayya abbilaal todoba gitte; kahoree atatere sannii hakkaannooni goye; <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Kallamikkina hitta heleelttiti atate; usuna sannii hakkaannooni goye; kaseedina hikkamalee; <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Todoba dubbana atateen sannii goɂameen lakkokaateen; danbbene ade heleelttiti goote. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Goorttanu todoba dubbana atateeran goyikko takkiyaano arri hinɂakko ese ayyoon oori linnatta?» ameen.<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>Yesuusana isoon haa ame abbaabera; «kakkoshiriɂamattaan k'ulloolee mas'aafaalnna hunna kawaa mankkokasanawaatten maaranya. <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Ogoyeraan goyikko kakkokeeran goorata kadaruuree erggichchaal aani linnaraan kuwaarre lakkoɂatataraan lakkonakeesamaraan. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Goyikko keyaanokokki gara goɂameen kamuse mas'aafayi hikkina gara kahuris taɂayeesero kifili Waa ‹Ani kaɂabraame Hedo, kayissaak'a Hedo, kayayik'ooba Hedoya kaɂamero lakkonabbabtteettanya?› <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>Waa arddonɂikkokki Hedoya kuwaarre kagoyi Hedo lakkoyo; haanssun aaloo shirnttettan.»<verse eid="MRK 12:27"/></para>
  <para style="s1">Dubbaankko karooraro ajaja</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mar. 12:28-34</ref>; <ref loc="MAT 22:34-40">Mat. 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk'. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Seera kamuse oɂagaalssisaraankko koo emeetegure dogamaagiraan maale; Yesuusana usu tos taɂemeettette hoosiinun abbaab kaɂidan isoon abbaabano shaadere, «Amiinna; ajaja dubbakko karoorara eekiyya?» ame hoosate.<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>Yesuusana haa ame usuun abbaabe; «Dubbaankko kajiinaatara ajaja hikkaya ‹Isiraɂeel maali; Gootta Hedookkaani Goottaa kooyya; <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Atina Goottaa Hedokkaa duuddotti wodanattaayi, duuddotti neefottaayi, duuddokki yaadakkaayinna duuddokki hunnakkaayi geelaa.› <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Kallamikki ajajana hikka aani kallaaroya; ‹Ollaattaa isiɂoottaa aani geelaa› kaɂamaroya. Hinɂa ajaja lamakko karoorara kakkalee ajaja laagiro.»<verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Seera kamuse kaɂagaalssisaranna Yesuusana haa ame; «Kaɂagaalssisatto!» «Taɂidan anttetta; Waa kooyya; usukkona kakkalee giranawaatti ayeesanokka rummiya; <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Haanssun ibaaddo duuddotti wodanattaayi, duuddotti sammuuttaayi, duuddotti neefottaayi, duuddokki hunnakkaayi geelatano, usumaleenna ollaattaa isiɂoottaa aani geelatano, kagubamaro jaarsso dubbakkona kakkalee jaarsojjoolkko roorara.»<verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Yesuusa seera kaɂagaalssisarekki k'arummaanna shaadkko abbaabano deegure, «Ati wononnati Waakko fakki kaɂantte lakkotto» ame. Hassekko abbaabatere hoosayin kajjabaate koonna lakkogiro.<verse eid="MRK 12:34"/></para>
  <para style="s1">Kiristoosa Ere kaayyoya</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mar. 12:35-37</ref>; <ref loc="MAT 22:41-46">Mat. 22:41-46</ref>; <ref loc="LUK 20:41-46">Luk'. 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Yesuusa k'ulluukki min kawaakkokki awudii kakkoɂagaalssisare goorata haa amaa hoosiin hoosaten; «Seera kamuse oɂagaalssisaran Kiristoosa ere kadaawuteyya misii amaraan? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>Daawutena metekkeessawun k'ulluukki ayyaanayi kekkeegure,</para>
  <para style="q1" vid="MRK 12:36">« ‹Goottaa Goottakki, diinakkaa luk'k'aɂoottaa hegelii ani kuun</para>
  <para style="q2" vid="MRK 12:36">«taa yelloo geegin merggetteeyi hamas's'ii ame amara.» ›<verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>Hayya Daawute metekkeessan ‹Gootta› goɂamiro; misii abbaabate ere laara?»</para>
  <para style="p" vid="MRK 12:37">Gosa kamoogganinna geggelooyi maalaa gire.<verse eid="MRK 12:37"/></para>
  <para style="s1">Seera kamuse oɂagaalssisaraankkonɂi felokko isiɂooratano</para>
  <para style="r">(<ref loc="MRK 12:38-40">Mar. 12:38-40</ref>; <ref loc="MAT 23:1-36">Mat. 23:1-36</ref>; <ref loc="LUK 20:45-47">Luk'. 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>Yesuusa kakkoɂagaalssisare goorata haa ame; «Seera oɂagaalssisaraankko isiɂoottisin oorayeen; kaɂeer k'olo sarssateenguren maraamuri sesseeyin geelataran; giyaa orroonna takabajaantte nogodda atayin dootaraan. <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>Ayihuudikokki min kaɂebinna kakkabajaame barc'uma, banɂe taɂaamoyinna takabajaantte banɂe dootataraan; <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>Eeraasi ebaatanokkiso aalantti yelaa galttaanttejjolkokki min hawɂayi yelaraan; hinɂi kaɂatii firdda atayinaraan.»<verse eid="MRK 12:40"/></para>
  <para style="s1">Kagalttantte mus'uwaata</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mar. 12:41-44</ref>; <ref loc="LUK 21:1-4">Luk'. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Yesuusa mus'uwaata kakkoɂabaabaraan saat'ine dollee hamas's'eegure kamooggan ibaaddo ilabojoolkkeessa k'ulluukki min maragade kakkokaamaro saat'ine orroo lugudaa giraan diyaa gire. Kamooggan dureessalnna kamooggan maragade lugudeen; <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>hiyyeetti galttaantteti too adde maallak'a lama tanaasi maragade lugudde. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>Yesuusa usukko oɂagaalssataran «Uumegure, haa amera; ani rumminaa amara; hitti hiyyeetti galttaantteti saat'ine orroddeeseen olugudeeraan okkaleekko kajiinaaro luguddetta. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Hinɂi dubba kahelateeran worɂekko siseeraan; ese goɂameen hiyyummattiseekokki hunnakko dubba bariisanoowun eseen kalleero hahaasannooni goggogiroo sissetta» ame.<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">Kageesjool gudatanokokki malaata</para>
  <para style="r">(<ref loc="MRK 13:1-13">Mar. 13:1-13</ref>; <ref loc="MAT 24:1-2">Mat. 24:1-2</ref>; <ref loc="LUK 21:5-6">Luk'. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Yesuusa k'ulluukki min kawaakko biyaa giraan usukko oɂagaalssatareenkko koo, «Kaɂagaalssisatto; eɂemojjol misii giro, kaginbbe min misii kaɂiidaroyo deena» ame. <verse eid="MRK 13:1"/><verse number="2" style="v" sid="MRK 13:2"/>Yesuusana abbaabere, «Hikki kajiinjjiin gimbbeejjool diyaatta? Eɂemo koo kakkaleeyi gutii goggogiroo lakkohesnaro; dubbana kadiigamiroyya» ame.<verse eid="MRK 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Yesuusa k'ulluukki min kawaa horee zayitii kabiyaara gaa takkoɂalataro wodami gutii hamas's'ee giraan P'et'iroosa, Yayik'ooba, Yaannisane Indiraasane kale usu tos gabbalameen haa amaa hoosaten; <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>«Hikki goree linnaro noon segii; hikki dubba gudayin kakko gabbalame goorata katusinara malaata meyya?»<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Yesuusana haa amano haggaɂabe; «maayona isin goggosoboonkko isiɂoottisin oorayeen; <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Omoogganinna ‹Ani Kiristoosayya› amaa megekkeeyi emeeyinaran; kamooggan ibaaddona sobinaraan. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Isin dollee jereen kiyaanona ebbaa jereenkkotti odu kakkomaaltteen goorata arooneyiteen; hikki liin dootisara gachcho adde ganaatta. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Gosa gosaayi gutii, wono wonooyi gutii, kiinnara; banɂe tammooggani ulkokki aɂaanonna uɂi linnara; hikki dubba kaɂummullaa muddama kahoraarijeeya.<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>«Isin goɂameen isiɂoottisin oorayeen; isin shonggoowun roorisi sisinaran; kaɂayihuudikokki min kaɂebinna boc'c'innaraan; ato goggolleetanun aalantti teeyi mootijjolnna wonolaal horee aallinnattaan. <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Dubbaankko t'ayi ade wongala gosa dubbaan lallabaamano dootisara. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Abamiddeen firddaan kakkosisanttaan goorata, ese saatii isinuun kasisamaro kaalaal ayeesa kuwaarre me ayeenssa amaa t'ayi arooc'annak'antteen; kaɂayeesara Ayyaana K'ulluukki kuwaarre lakkoɂisinttaan. <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/>Abbi abbikkeessa, odona erekkeessa goyin roorisi sisinara; yiisaas oɂummuleeraan gutii diina linnara; lagadinara. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Aalantti teeyi ibaaddo dubbaa dollee odiidantteen linnattaan; ayesuun goɂameen taagachcho geeroo kaɂataate hassu fayyaara.»<verse eid="MRK 13:13"/></para>
  <para style="s1">Tac'c'annak'isatto rakkoo</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mar. 13:14-23</ref>; <ref loc="MAT 24:15-28">Mat. 24:15-28</ref>; <ref loc="LUK 21:20-24">Luk'. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>«Baaskkokki battinnati mutin takkodootisoon banɂee aallee giraan kakkodeeteen goorata kanabbabera hashaado; ul kayihuudaayi ogiraanna wodami tos habak'ateen; <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>Minkkeessatti heelinchchoo gutii kagira arooddago; huukkeessana beesayin min orroddi arootabo; <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Iraa kagirana sarssikkeessa atayin haar arooɂabbaabanno. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Ese arrii heleel kafatoowunna kaɂiilisarowun rakkoo taɂatii leeta! <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Hikkina bat't'eesayi goggolleenoonkko ebaayen; <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Aalanttina horaarjje Waa met't'a takkomet'ero arrikko keesegure taa hittaari geeron, tallikkasoon rakkoo ibaaddon emeeyinatta, horenbbaawun talleennoon rakkoo taɂatii ibaaddo gutii emeeyinatta. <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Goottaa hanɂu arrijjool gabaabbisi waatewa maayyona lakkofayyinare; Waa oɂassaabameeraan maraan amegure ade arrijjool gabaabbisera. <verse eid="MRK 13:20"/><verse number="21" style="v" sid="MRK 13:21"/>Hassu goorata maayyona; ‹Hikkima; Kiristoosa hassee gira,› Haa goɂameenna goorttun, ‹Hikkima; hittanii gira› goɂameen arooɂabddatteen. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Ot'araa Kiristoosajolnna ot'araa ohegerool kiinnaraan; baasana kasaadamiro felaa isoon godaanddaame oɂassaabameeraan duuddo shirsaraan. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Ayesuun goɂameen goorata hangeenooni ani isinuun segeera, haanssun isin isiɂoorayeen.<verse eid="MRK 13:23"/></para>
  <para style="s1">Ere kaɂibaaddokkotti emeeto</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mar. 13:24-27</ref>; <ref loc="MAT 24:29-31">Mat. 24:29-31</ref>; <ref loc="LUK 21:25-28">Luk'. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>«Hassu goorata, rakkookko danbbenne</para>
  <para style="q1" vid="MRK 13:24">« ‹Arriti mugud linnatta,</para>
  <para style="q2" vid="MRK 13:24">diginnina ifakkisee lakkosisinnatto;<verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>Barraajjana daruurkko ubayinara;</para>
  <para style="q2" vid="MRK 13:25">daruuri kagira hunnana shalagaaminara.›<verse eid="MRK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26"/>«Hassu goorata ere kaɂibaaddo kaɂatii hunnaayinna kabajaa duumanchchaayi emeetaa giraan usu dinnaraan. <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Usuna erggichcha farigure mina afarkko; ulkotti gachchokko taa daruurkkotti gachcho geeroo Waayi oɂassaabameeran kukkuyisinara.<verse eid="MRK 13:27"/></para>
  <para style="s1">Gaa kabalasikkokki masuussa</para>
  <para style="r">(<ref loc="MAT 24:34-35">Mat. 24:34-35</ref>; <ref loc="LUK 21:29-33">Luk'. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>«Gaa kabalasikokki masuusa agaalssayeen; ballaal gohurisiro baalallona gooc'ariidinan bat't'eessa gabbalamano addeesattaan; <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Usumaleenna ade hikka ayeesjjolkkokki gudatano goddeeten ere kaɂibaaddokotti emeeto gooc'ayi gabbalamano addeesa. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Ani rumminaa amara, hikki ayeesjjool taagudaroo geegin hitti alattaan duuddo lakkoroortto; <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Daruurnna ulnna roorraanwa haafurakki goɂameen lakkoroorro.<verse eid="MRK 13:31"/></para>
  <para style="s1">Arrina saatinna lakkoɂaddeesamatto</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mar. 13:32-37</ref>; <ref loc="MAT 24:36-44">Mat. 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>«Ayesuun goɂameen ese arrina ese saatii odo kuwaarre, kakkalee gohesena kadaruure erggichchaalnna leereen, erekkeessa golleenna, maayyona lakkokaso. <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Haanssun goorata maaggoree linnaro lakkokassaan isiɂoorayeen; ataayeen. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Hikkina minkkeessa oɂooraanawun sisegure, ohandaaraawun metemeteeyi feloo hedeede sisegure, kaɂoorara ataayi goggoɂoorroon ajajeere kaseetero ibaaddoti aani laara.<verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>«Goorttanun odo minee ibitto goorttun hemeen t'eɂe, lukkale oɂwaa goorttun ul bulla oɂwaa emeeyinaro goorata lakkokassaan; haanssun ataayeen oorayeen. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Odo minee isin derɂa giraan goɂemeete huddurtteen ogittan arooddeenno! <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Ani isinuun kasegeero ibaaddo dubbaan seginnara; atayeene, ame.»<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">Yesuusa lagadin kafelamero daba</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat. 26:1-5</ref>; <ref loc="LUK 22:1-2">Luk'. 22:1-2</ref>; <ref loc="JHN 11:45-53">Yan. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Kafaasikkaanna kababoo baala kabajaamin arri lama hesse giraan katuuk'aamol woyichchaalnna seera kamuse oɂagaalssisaran Yesuusa miiggeeyi kakkoɂabraanna kakkolagadiraan raa dootaa gireen. <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>Ayesuun goɂameen; «Gosa okko goggokeesonkko kabbaala almmaayi laano lakkodootisaro» amaa gireen.<verse eid="MRK 14:2"/></para>
  <para style="s1">Yesuusaan shittoo takibttetto heleelttiti</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mar. 14:3-9</ref>; <ref loc="MAT 26:6-13">Mat. 26:6-13</ref>; <ref loc="JHN 12:1-8">Yan. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Yesuusa kabitaaniya maamanii maarii bar kaɂabokokki kasimoona minii babo aamin hamas's'ee giraan, heleelttiti too dookki aaloo awɂallo talleetetto muc'c'i taɂantte narddoosa kaɂamamaro gaakko tafelanttetto shittooyi kaɂammagaamero kaɂalbbast'iroosi bilk'aadee abtte emeette, bilk'aadena ebissegude shittoo Yesuusaa gutii kikkibtte. <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Esee ogireenkko kookkoo feloɂoottiseeyi amaraatengureen isiɂorroo haa amaa gireen; «Hitti shittoo muun adda darɂaamatta? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Hitti shittoo seed boolee dinnaarikko guuntte daddalamigudde, hikka maragade hiyyeessan siseenwa kaɂidankkiyye» heleelttitina tuffateen.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Yesuusa goɂameen haa ame; «Iisa, ese muun rakkisattan? Ese felo oɂidan iin felttetta. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Hiyyeessal maagoreenna isin wota giraan, kakkoddootten goorata isoon taɂidan felin daanddaattan; ani goɂameen arggetto isinne wota lakkogirnnaro; <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Ese felin kadandeetetto gitakki felttetta; k'amalamanokkeewun goggolleeroon t'ayite maarkkeeyi shigidde. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Ani rumminaa amara; hikki wongala mankkosegaamaro alami dubbaa maamisitti banɂeeyinna hikki ese kafelttetta shaadano lii segaamira» ame.<verse eid="MRK 14:9"/></para>
  <para style="s1">Yihuuda Yesuusa roorisi sisin ekkaatano</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat. 26:14-16</ref>; <ref loc="LUK 22:3-6">Luk'. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Hittakko abbaabatere tomonkko lamakko koo kalleera kaɂask'orotu Yihuuda Yesuusa roorisi sisin katuuk'aamol woyichchaal tos emeete. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>Isona hikka kakkomaalaren goorata geggelaaten; maragade sisin ekkaaten; haanssun Yesuusa roorisi sisin kaɂekkaaro goorata wochchaataa gire.<verse eid="MRK 14:11"/></para>
  <para style="s1">Kafaasikkaa kita kahemeene</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mar. 14:12-21</ref>; <ref loc="MAT 26:17-25">Mat. 26:17-25</ref>; <ref loc="LUK 22:7-23">Luk'. 22:7-23</ref>; <ref loc="JHN 13:21-30">Yan. 13:21-30</ref>; <ref loc="1CO 11:23-25">1 K'or. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Kafaasikkaa idaado kakkoɂenɂaamaro kababoo baalawun tahoree arri, Yesuusakko oɂagaalssatareen usu tos gabbalameengureen, «Kafaasikkaa kita kahemeene haggee noo kuun goggoɂekkaanssoo dootatta?» ameen. <verse eid="MRK 14:12"/><verse number="13" style="v" sid="MRK 14:13"/>Yesuusa usukko oɂagaalssatarankko lama haa ame fare; «Katamaa tos seeyeen; uulla tabekee kasidatera ibaaddo raadii esellowa; <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>Usu kakkotabaro min debee seyeen; odo mineenne, kaɂagaalssisara; ‹Inkko oɂagaalssataranne wota kafaasikkaa kita kahemeene kakkoɂaamira kamartti min eekiya?› amera ama. <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Usuna isigitto kagiro minkko kaguutee min yaamenna ekkaate kagiro min kabbalɂaan tusinara; eseenna ekkaasa.»<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Usukko oɂagaalssatareenna ese katamaa tos been; kameen dubba Yesuusa goggoɂameroo kalleero deen; faasikkaa kita kahemeenna ekkaasen. <verse eid="MRK 14:16"/><verse number="17" style="v" sid="MRK 14:17"/>Ul hemeen kakkolaare goorata Yesuusa tomonkko lamanne wota emeete. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Aamo gutii giraan, «Ani rumminaa amara, isin orrokko koo, iine wota kaɂaamara usu in roorisi sisinnara» ame.<verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>Isona yaadeenen; isona metemeteeyi, «Ani leewuna?» amano haggaɂabeen. <verse eid="MRK 14:19"/><verse number="20" style="v" sid="MRK 14:20"/>Yesuusana; isin tomonkko lama orrokko koo, iine wota gene yaalɂaayi kadagisaroyya. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>Ere kaɂibaaddo garakkeessa goggos'aafameroyi goyinara; ere kaɂibaaddo roorise kasisaroon hassu ibaaddotin goɂameen aanne! Hassu ibaaddoti haɂumulamoon hesi girewa iidare.<verse eid="MRK 14:21"/></para>
  <para style="s1">K'ulluukki kawaa babokkokki seera</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mar. 14:22-26</ref>; <ref loc="MAT 26:26-30">Mat. 26:26-30</ref>; <ref loc="LUK 22:14-20">Luk'. 22:14-20</ref>; <ref loc="1CO 11:23-25">1 K'or. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Aamaa giraan Yesuusa babo keesegure sommaasate; ekkaɂebisegure usukko oɂagaalssatarawun sisaa, «Ahɂaay; hinɂi sooɂootteeyan» amera. <verse eid="MRK 14:22"/><verse number="23" style="v" sid="MRK 14:23"/>T'uggana keesegure sommaasate isoon sise; dubbana esekko t'ameen. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>Adena haa ame; «Hikki omooggan maraan kaɂubataro kaɂammatoo iigikkeeyya; <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Ani rumminaa amara; wononnati kawaayi kaɂusub kawoyinii t'amo takkot't'amiro ese arri taageegiiron duuddo lakkot'aminaro.» <verse eid="MRK 14:25"/><verse number="26" style="v" sid="MRK 14:26"/>Mazamuri zammareen abbaabateenguren debrezeyiti<note caller="+" style="f"><char style="fr" closed="false">14:26 </char><char style="ft" closed="false">Debrezeyiti amano zayitii kakkobiyaatta gaa takkoɂalataro wodami amanoya. </char></note> wodami tos been.<verse eid="MRK 14:26"/></para>
  <para style="s1">P'et'iroosakokki kakatano Yesuusa t'ayise ayeese</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mar. 14:27-31</ref>; <ref loc="MAT 26:31-35">Mat. 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk'. 22:31-34</ref>; <ref loc="JHN 13:36-38">Yan. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Yesuusa usukko oɂagaalssataranne; «Kafoofee basinnara; idaadnna darɂaaminnara amame goggos'aafameroo isin dubba in kakayinnattaan. <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>Ayesuun goɂameen ani kakkokkee goorata adi, isinkko t'ayi Galiila tos seeyinnara.» <verse eid="MRK 14:28"/><verse number="29" style="v" sid="MRK 14:29"/>P'et'iroosana; «Dubba gohanduddufatena ani suure kuu lakkohanduddufayinaro» ame. <verse eid="MRK 14:29"/><verse number="30" style="v" sid="MRK 14:30"/>Yesuusana; «Ani rumminaa amara; hitta hemeen lukkale lama gali haɂoyinon giraan, ati ini seed gali kakayinnatta» ame. <verse eid="MRK 14:30"/><verse number="31" style="v" sid="MRK 14:31"/>P'et'iroosana ade; «Kuunne wota kagooyiro golleenna suure lakkokakayinaro» amaa aaloo ataayise ayeese. Dubbana usumaleewwa ameen.<verse eid="MRK 14:31"/></para>
  <para style="s1">Yesuusa Geetesemmani taɂamamatto banɂee kaɂebaatero ebi</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mar. 14:32-42</ref>; <ref loc="MAT 26:36-46">Mat. 26:36-46</ref>; <ref loc="LUK 22:39-46">Luk'. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Esekko abbaabateren Geetesemmani taɂamamatto banɂe tos seeteen; Yesuusana usukko oɂagaalssataranne, «Ani aantte seeyi ebaaro isin hittanii hamas's'aa» ame. <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>P'et'iroosane, Yayik'oobanee, Yaannisane wota aate seete; aaloo yaadanona c'annak'aamano haggaɂabe. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Adde; «Neefottina taa goyin geeto aaloo yaadde. Hittanii hesadden ataayeen oorayeen» ame.<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>Isokko abaraan ship'p'i amere hore hore bebbeedii ul oyere kadaandame gollee hasse saatii goggoroortto ebaataa, <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>«Aabbokkee! Kameen dubba kuyeen daanddaamara; hitta tarrakkoo t'ugga inkko keesi; ayesuun goɂameen feɂitte halleennoni giraan feɂittaakki malee halleewo» ame.<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Abbaabayi usu goɂemeero usukko oɂagaalssatareen huddureen ogiraan hele; P'et'iroosane haa ame, «Simoona, huddurttetta? Saatii toonna suure ataayi nabbaadi oorayin waatte? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>C'aafitii orddi goggotaboonkko ataayeen ebaayen; ayyaana ekkaate gira, soo goɂameen ohararaanyan.»<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>Adena seetegure horaarjje kaɂebaaterowa ade ebaate. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Kallami goɂabbaabaro ilɂoɂoottisooyi hudduro isilaattedde ohuddureeraan dee; usuun taɂami abbaabranna lakkokasanaayen.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Kaseedi gooratana emetere haa ame; «Gidda huddurtteen foolssayeen gittaan? Goortta leera! Saatinna geetetta; hikkima; ere kaɂibaaddo c'ubbaalessaalkotti genee roorssami sisaaminnara. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Kiyaa; seenno; in roorisi kasisinara gabbalamera!»<verse eid="MRK 14:42"/></para>
  <para style="s1">Yesuusa abame</para>
  <para style="r">(<ref loc="MRK 14:43-52">Mar. 14:43-52</ref>; <ref loc="MAT 26:47-56">Mat. 26:47-56</ref>; <ref loc="LUK 22:7-53">Luk'. 22:7-53</ref>; <ref loc="JHN 18:3-13">Yan. 18:3-13</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Goorsewa usu ayeesaa giraan tomonkko lamakko koo Yihuuda emeete; usune wota shiifana duullaa oɂabateeren, katuuk'aamol woyichchaalkko, seera kamuse oɂagaalssisaraankkona jaarsoleekko kafaramere ibaaddo gire. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>Roorisi kasisinara Yihuuda, «Ani kaɂangatara usuya aba; oora geesa» amaa t'aye malaata isoon sise gire.<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>Goggogeeyi goorsewa Yesuusa tos gabbalamegure, «Kaɂagaalssisatto!» ame anggate; <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Ibaaddona Yesuusa abeen shiyeen. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Dollee aalleen ogireenkko koo katuuk'aamol woyichchatiin kahandaarekkotti nebe goose. <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>Yesuusana haa ame, «Shittaa aani in abin shiifana duullaa abtteen emeetteen? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Arggetto k'ulluukki min orro isin agaalssisaa isinne wota takkogireeyi lakkoɂabtetteen, ayesuun goɂameen; mas'aafa gudayin hikki lee.»<verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>Hassu goorata dubbana iiseen bak'ateen.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Hawɂayitteessa gasheeyi kagolisere wodallaati koo Yesuusa debee sesseetaa gire. Ibaaddona hikka wodallaati kakkoɂabare goorata, <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>Usu ade gashetteessa shafegure hawɂayi bak'ate.<verse eid="MRK 14:52"/></para>
  <para style="s1">Yesuusa tafirdda shonggoo tos geesano</para>
  <para style="r">(<ref loc="MRK 14:52-65">Mar. 14:52-65</ref>; <ref loc="MAT 26:57-68">Mat. 26:57-68</ref>; <ref loc="LUK 22:54-55">Luk'. 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yan. 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Yesuusana tuuk'aamon odonnati kaɂabokokki awud tos geesen; eseenna katuuk'aamol woyichchaal, jaarsoleenna seera kamuse oɂagaalssisaraanne dubba kukkuɂameen. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>P'et'iroosana fakkimere debee sesseetaa tuuk'aamolun odonnati kaɂabokkokki awud taageeroo seete, eseenna ohandaareenne wota eleen t'ant'amaa gire. <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>Katuuk'aamol woyichchaalnna tashonggoo una dubba Yesuusa lagadin kaɂatotiiro dooteen; ayesuun goɂameen helin lakkodaanddeen. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Omoogganna t'ara goɂatoteenna, ayeeskkiso koo liin lakkodaanddee.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>Kookkoonna keegureen haa amaa t'ara atoteen, <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>«Hikki, gene taɂibaaddo kamadaarttetto k'ulluukki min basigure taseedi arri kakkalee gene taɂibaaddo kanmaddaaroon gitto ani madaarnnara, amaa noo maalnnenna.» <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Hikkina lee giraan atonnatikkiso suure koo lakkollee.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Katuuk'aamol woyichchatina iso horee kee aalleegure, «Hinɂi kuyee gutii kaɂatotaaran meyya? Muun abbaabanawaatta?» amaa Yesuusa hoosate.<verse eid="MRK 14:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61"/>Yesuusa goɂameen c'alɂi ame; koonna usu lakkoɂabbaabe, tuuk'aamolun odonnati kaɂaba gidda ade, kasommaasantte ere kawaa atitta? Amaa hoosate.<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>Yesuusana, «Ii aniyya; ere kaɂibaaddo mergge tawaayi hamas's'ee giraan, kadaruure duumanchchal emeetaa dinnattaan» ame. <verse eid="MRK 14:62"/><verse number="63" style="v" sid="MRK 14:63"/>Katuuk'aamol woyichchatina sarssikkeessa fiilaa, haa ame; «Kakkalee eeki ato dootisara?» <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>«Habaarkkessa maaltteettan; hayya me aani laara?» Isona goyin dootisara amaa dubbana hiɂi too leen firddeen.<verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>Hassu goorata kookkoo hanc'c'ufe tufano haggaɂabeen; bebbeedii hogoogisenguren tonttomooyi basaa, «Alla hegeroo ayeesi;» amaa gireen. Okkaleenna balabaanjjoo basaa geesen.<verse eid="MRK 14:65"/></para>
  <para style="s1">P'et'iroosa Yesuusa kakatano</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mar. 14:66-72</ref>; <ref loc="MAT 26:69-75">Mat. 26:69-75</ref>; <ref loc="LUK 22:56-62">Luk'. 22:56-62</ref>; <ref loc="JHN 18:15-18">Yan. 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>P'et'iroosa tuuk'aamolun odonnati kaɂabokkokki awudii orro mina tahegeleenne giraan isoon ohandaareenkko too emeettedde; <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>P'et'iroosa eleen t'ant'amaa kahamas'eero tichchisse deetegudde, «Ati kanaazireti Yesuusane wota gitte» antte.<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>P'et'iroosa ade; «Ati kaɂamatto ani lakkokaso; goorttun lakkoshaadaro» amaa kakate. Esekko kakkotabaraan gooc'a tos sarddee bee; hassu goorata lukkale oye.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>Diyyitina P'et'iroosa kakkodiyaatte goorata esee oɂalleerenuun; «Hikki ibaaddoti unatisookko kooyya» antte adde ayeesse. <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Usu goɂameen ade giddanna kakate. Abaraan gac'c'ime giraan esee kaɂalleera ibaaddo P'et'iroosane, «Ati kagaliila ibaaddo laanokkaa addeesisara; ogiraan ati isokko kootta» ameen.<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Usu goɂameen, «Isin kaɂamattan ibaaddoti ani lakkokaso» amaa k'angaanona ammatano haggaɂabe.<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Goorsewa lukkale kallami oye. P'et'iroosana, «Lukkale lama gali owaanakko horene seed gali in kakayinnatta» kaɂamere kayesuusa haafura k'alli ame. Esekkona yururu ame oote.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">Yesuusa P'ilaat'oosa tos geesen</para>
  <para style="r">(<ref loc="MRK 15:1-5">Mar. 15:1-5</ref>; <ref loc="MAT 27:1-2">Mat. 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luk'. 23:1-5</ref>; <ref loc="JHN 18:28-38">Yan. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Bari bariinoo katuuk'aamol woyichchaal jaarsolee, seera kamuse oɂagaalssisaranna tashongoo unanne wota goorsewa t'oyeen abbaabateenguren Yesuusa shisheengureen P'ilaat'oosaan rooriseen siseen. <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>P'ilaat'oosana, «Ati kaɂayihuudi wonotta?» amaa hoosate;</para>
  <para style="p" vid="MRK 15:2">Yesuusana «Ati goggoɂanttettooya.»<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Katuuk'aamol woyichchaalnna Yesuusa kamooggan ayeesi mooteen. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>P'ilaat'oosana; «Muun abbaab sisanawaatta? Hikkima kamooggan ayeesii ku mooteran» amaa ade giddanna hoosate.<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Yesuusa ade koonna lakkoɂabbaabe; P'ilaat'oosana mame.<verse eid="MRK 15:5"/></para>
  <para style="s1">Yesuusa goyikkokki firdda firddaame</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mar. 15:6-15</ref>; <ref loc="MAT 27:15-26">Mat. 27:15-26</ref>; <ref loc="LUK 23:13-25">Luk'. 23:13-25</ref>; <ref loc="JHN 18:39-40">Yan. 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Tabaala arri kashaamero ibaaddo orrokko koo gosa kahoosatera ibaaddo goggofuramiroon kakkohoosatare seera gire. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Hassu goorata meellane kekkeesanoonna neefo lagadanooyi oshaameeraankko koo kalleera Barbaane kaɂamamara ibaaddoti koo gire. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Gosana P'ilaat'oosa tos emeetegure seerakisookki malee shaaga goggoyelloon ebaaten. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>P'ilaat'oosana, «Ayihuudikokki wono goggofuramiroon dootaattan?» ame hoosate. <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Aalanttina katuuk'aamol woyichchaal Yesuusa miiggeeyi roorisi sisano addeesaa gire.<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>Katuuk'aamol woyichchaal goɂameen banɂe tayesuusayi Barbaane goggofuramiroo gosa goggohoosaroyi gosa kekkeeseen. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>P'ilaat'oosana ade giddana, «Goortta hikka kaɂayihuudi wono kaɂamattan misi goggoyelloon dootaattan?»<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>Isona giddanna adeen «Suuyina» amaa okkeen.<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>P'ilaat'oosana, «Muun? Meya baas usu kafelera?» ame. Iso adeen, «Suuyina!» amaa kahoreekko ataayiseen okkeen. <verse eid="MRK 15:14"/><verse number="15" style="v" sid="MRK 15:15"/>P'ilaat'oosana gosa geggelaayisin dootere Barbaane fure; Yesuusa ade boc'c'iisegure goggosuwaamiron roorise sise.<verse eid="MRK 15:15"/></para>
  <para style="s1">Wotaadaral Yesuusaa gutii k'ac'c'ifate</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mar. 15:16-20</ref>; <ref loc="MRK 15:16-20">Mar. 15:16-20</ref>; <ref loc="MAT 27:27-31">Mat. 27:27-31</ref>; <ref loc="JHN 19:2-3">Yan. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Wotaadaralnna Piraayitooryon kaɂamamero wonokokki min tos Yesuusa geesen; kahesero wotaadaral dubba raattoo kukkuyiseen. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Heelakki sarssina sarssiseen, kallachcha kaɂeɂeenee mammarenguren metekkeessaa gutii kayeen. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Esekkona «Kaɂayihuudi wono; reedina!» amaa k'ac'c'ifataa sagadeen; <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>Metekkeessana damaayi baseen; hanc'c'ufena usu gutii tufeen; gilbbiseen sagadeen. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>K'ac'c'ifateen abbaabateenguren heelakki sarssi k'aarengureen kakkeessa sarssi sarssiseen; suyiinna geesen.<verse eid="MRK 15:20"/></para>
  <para style="s1">Yesuusakokki suwaamano</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mar. 15:21-32</ref>; <ref loc="MAT 27:32-44">Mat. 27:32-44</ref>; <ref loc="LUK 23:26-43">Luk'. 23:26-43</ref>; <ref loc="JHN 19:17-27">Yan. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Kaɂalekisaandiroosina karrufoosi Aabbo Simoona kak'ereena ibaaddoti koo katamaakko k'amanne kagiro maamankko emeetaa giraan masik'alii sidisin usu hunnoomen. <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Esekkona Yesuusa, golggottaa taɂamamatto banɂe geesen; fureenna, «Buk'k'e tamete» amanoya. <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Fulfulisone wota kaledamero kawoyinii t'amo siseen; Yesuusa ade diide. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Esekkona suyeen; sarssikkeessana iso metemeteeyi me ginnaro malabayin it'aa lugudateen sarssi hedeedameen. <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>Yesuusa kakkosuwaaren goorata barikko saatii seed leete gitte. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Tamooto s'uuffinna, «Kaɂayihuudi wono» taɂamattotte. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Yesuusane wota shittaa lama keenengurene koo merggene, koo betene suyeen. <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>«Omeellanne wota tootaame» amame mas'aafa kas'aafamera haafura gudate.<verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>Usu raanne karoorara dubbana mete aaɂisaa c'ilooshakki habaar habaaraa haa amaa gire; «Tu, deetene! K'ulluukki min basidde taseedi arri madaarinnara kaɂamatte; <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>Alla mask'aliikko dagigudde isiɂoottaa haasa!» ameen.<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Usumaleenna katuuk'aamol woyichchaalnna seera kamuse oɂagaalssisareen k'ac'c'ifataa isiɂisirroo haa ameen; «Okkalee fayyiise, isiɂoottessa fayyiisayin lakkodaanddee; <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>Diigunne goggoɂammannoon usu Kiristoosa kaɂisiraɂeel wono gollee alla mask'aliikko handdage.» Usune wota osuwaameereenna hikkamaleewa c'ilooshakki habaar habaarareen.<verse eid="MRK 15:32"/></para>
  <para style="s1">Goyi kayesuusa</para>
  <para style="r">(<ref loc="MRK 15:33-39">Mar. 15:33-39</ref>; <ref loc="MAT 27:45-56">Mat. 27:45-56</ref>; <ref loc="LUK 23:44-49">Luk'. 23:44-49</ref>; <ref loc="JHN 19:28-30">Yan. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Saatii lekko haggaɂabere taa saatii saagaal geetoo ul dubbaa gutii mugud lee. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Saatii saagaallii Yesuusa, «Elohe, Elohe lama sebek'itaani?» ame iyyee; fureenna «Hedokkee, Hedokkee in muun iisse?» amanoyya.<verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Esee ogireenkko kookkoo hikka maaleengureen, «Eelaasa uumara» ameen. <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>Esekko ibaaddoti koo tiiyye seetere kaɂokokootaro kawoyinii t'amo isfoonjii c'uup'egure; fiik'e kayegure goggot'amiro Yesuusaan sisere, oorayeen; «Alla Eelaasa emeeyigure usu godagisirona alla deenno» ame.<verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>Esekkona Yesuusana iyyeere; neefo beete. <verse eid="MRK 15:37"/><verse number="38" style="v" sid="MRK 15:38"/>K'ulluukki minkkokki goggolo elekko taa hegel geeron fiilame banɂe lama bee. <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Yesuusa horee aallee kagire kaboolo woyichchati usu hikkamalee iyyeere neefoteessa biyaano kakkodiyaare goorata; «Hikki ibaaddoti rumminaa ere kawaayye» ame.<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>Hassu goorata ebbaa aalleegure diyaa kagire kookkoo heleel; iso orrokko tamegidella ulkotti Mayiraame, kic'c'arkki tayayik'oobana tayoosa Aaye Mayiraame, usumaleenna Seloomenne gireen; <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Hikki heleel Yesuusa Galiilaayi takkogiree usu debee sesseetanna handdaa kagireya; adena isone wota Iyyerusaalemi tos kaɂemeetere kamooggan heleel kakkaleenna gire.<verse eid="MRK 15:41"/></para>
  <para style="s1">K'amalamano kayesuusa</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mar. 15:42-47</ref>; <ref loc="MAT 27:57-61">Mat. 27:57-61</ref>; <ref loc="LUK 23:50-56">Luk'. 23:50-56</ref>; <ref loc="JHN 19:38-42">Yan. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>Gooratana hemeen laa kakkoseetare goorata Ayihuudin tafoolssi arriin takkobaranaan hemeen hikkina takkoɂekkaasataraan arri leete; <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>Kakkabajaame tashonggoo una kalleerena wononnati kawaa oorataa kagire kaɂarmaatiyaas Yoosefa jabuuyi P'ilaat'oosa tos seetegure kayesuusa rees ebaate. <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>P'ilaat'oosana hikkamalee usu saami gowaanokkeessa maalegure mame; kabooloo woyichchana uumegure, goggoyekko adallaatera? Ame hoosate; <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Gowaanokkeessanna kabooloo woyichchakko k'ulleesseegure rees Yoosefaan sise. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Yoosefana gashe iminegure rees dagisere gasheeyi ekkaase abbaabatere eɂemokko kaɂoshamero gumbbi orroo k'amale, tagumbbi hiɂinna eɂemo kaye duudise. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Kamegidella ulkotti Mayiraamena tayoosa Aaye Mayiraamene Yesuusa eetii k'amalinnaraan diyaa gireen.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">Goyikko kiyaano kayesuusa</para>
  <para style="r">(<ref loc="MRK 16:1-8">Mar. 16:1-8</ref>; <ref loc="MAT 28:1-8">Mat. 28:1-8</ref>; <ref loc="LUK 24:1-12">Luk'. 24:1-12</ref>; <ref loc="JHN 20:1-10">Yan. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Ayihuudikkotti tafoolssi arri roortte giraan tamegidella Mayiraamene, tayayik'ooba Aaye Mayiraamene, Seloomene seetengureen rees kayesuusa shittoo kibiin iminateen. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Almmakko tahoraarjjee tawoggaa arri bari bariinoo ganaa arriti kakkoɂalaatto goorata k'amal tos seetaa giraan, <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>«K'amal guukko eɂemo noon ayyoyya kaɂotottoolisira?» amaa isiɂorroo ayeesaa gireen. <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>T'ok'k'i ami godeeran k'amal gutii kagire kanjiinkki eɂemo k'amal guukko otottoolee kagiro deen. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>K'amal tos goggogeenii kahank'k'aaro sarssi kasarsatero wodallaati mina tamerggene kahamas'eero deengureen aaloo abissateen.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Usu ade; «Allamandde arooɂabssatteen; isin kadootattaan kasuwamero kanaazireti Yesuusaya; hittanii laagiro; usu takkok'amalamere banɂe hittima. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Ayesuun goɂameen seeyenguddeen usukko oɂagaalssataraawunna P'et'iroosaan; ‹Isinkko t'ayi Galiila tos seeyinara; isinuun goggosegeeroyi esee helinnattan amaddeen isoon segaa.› »<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Heleelnna harɂaanna geggelaataa k'amalkko been bak'ateen. Abssateen mankkogireen maraan maayyonna koonna lakkoɂayeeseeren.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Tooto saagalkko taa tooto lamaattan geeroo kagira kahorkkoo mas'aafajjool lakkogiro. (9-20)</char></note><verse eid="MRK 16:8"/></para>
  <para style="s1">Yesuusa tamegidella Mayiraamen mutano</para>
  <para style="r">(<ref loc="MRK 16:9-11">Mar. 16:9-11</ref>; <ref loc="MAT 28:9-10">Mat. 28:9-10</ref>; <ref loc="JHN 20:11-18">Yan. 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>Almmakko tahoraarjjee arri tawoggaa bari goyikko kee abbaabatere durrisa todoba takkobeesere kamegidella ulkotti Mayiraamen horaarjje mute. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Esena seettegudde, usune wota ogireen ootaanna gaddaayi ogireen deetegudde usu neefo giranona eseen mutano isoon segiite. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Ese Yesuusa goyikko keera neefone gira goɂanttena iso adeen lakkoɂabddatenen.<verse eid="MRK 16:11"/></para>
  <para style="s1">Yesuusa lama usukko oɂagaalssatareen okkaleetun mutano</para>
  <para style="r">(<ref loc="MRK 16:12-13">Mar. 16:12-13</ref>; <ref loc="LUK 24:13-35">Luk'. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Hikkakko abbaabatere usukko oɂagaalssatareen lama gat'are tos biyaa giraan middi takkaleetii isoon mute. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Isona abbaabateengureen hikkawa oheseeraawun segeen; halleewo kuwaarre isona lakkoɂabddateen.<verse eid="MRK 16:13"/></para>
  <para style="s1">Yesuusa tomonkko koo ofarameeraawun mute</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mar. 16:14-18</ref>; <ref loc="MAT 28:16-20">Mat. 28:16-20</ref>; <ref loc="LUK 24:36-49">Luk'. 24:36-49</ref>; <ref loc="JHN 20:19-23">Yan. 20:19-23</ref>; <ref loc="ACT 1:6-8">Ofa. Fe. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Esekkona tomonkko koo babo aamaa hamas's'een giraan Yesuusa isoon mute; kee abbaabate giraan kaddeera ibaaddo kasegeero ammanana mankkowaateran maraan abddiwaattittisoyinna wodanattisookki duudaano tuffate. <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/>Adena, «Alami dubba tos seeyin; wongalanna met't'a dubbaan lallabaa, ame. <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Kaɂammanerana kat'ammak'aamera fayyinnara; kaɂammanon ade firddaaminara. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Oɂammanaraanna hikka malaataal felinnaraan; megekkeeyi durrisa beesinnaran, taɂusub heɂiinna ayeesinaran, <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>Habeessal genetisooyi abnnaraan, talagado marzzii got'ameenna duuddo iso lakkomiirɂto, genetisonna dhukkubaaleessaal gutii kayinnaraan isona fayyinaraan.»<verse eid="MRK 16:18"/></para>
  <para style="s1">Yesuusa daruur tos bee</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luk'. 24:50-53</ref>; <ref loc="ACT 1:9-11">Ofa. Fe. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Goottaa Yesuusa hikka dubba ayeese abbaabatere daruur tos bee, mergge tawaayi hamas's'ee. <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Esekko usukko oɂagaalssatareen emetengureen, maaman dubbaa haafurakkeessa lallabeen, Goottanna isone wota felaa gire; agaalssiskkisoonna baasakki malaataayi haafurakkeessa ataayisaa gire.<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
