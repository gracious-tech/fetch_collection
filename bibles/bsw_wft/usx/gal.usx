<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Bayso New Testament</book>
  <para style="h">ጋላትያ</para>
  <para style="toc1">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ ካጋላትያ እባዶ ቶስ</para>
  <para style="toc2">ጋላትያ</para>
  <para style="toc3">ጋላ.</para>
  <para style="mt2">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ</para>
  <para style="mt1">ካጋላትያ እባዶ ቶስ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ፋይሳኖ ካየሱሳኮክ ጋራ ካአዬሳራ ካዎንጋላ ሃፉራ ባንኤ ባንኤ ላላባማ አይሁድ ካለኖን ግራ እባዶ አታታ ካኮሴተንኮክ ጅልባ “ክርስታና ሊን ካኦርት ሴራ ፈሎ ሀይሲን ዶትሳራ ሙ ላኮዶትሳሮያ?” ታአማታ ሆሲን ዎታ ኬተ፥ ትጫርት እስያይ ቃላዳ ካሮም ታሌተቴ ጋላትያይ ካግሮ ካሞጋን ምን ካዋ ኦሮ “እባዶ ዋይ ሆረ ጎጎቁሎይሮ የሱሳ አማናኖክሶ ካላል አንሌኖን ግራን ጋራ ካሙሴነ ካስሳመሮ ሴራ ፈሎ ሀይሲን ዶትሳራ” አማ ጳዉሎሳ ካቁቃማረ እባዶ ግረ።</para>
  <para style="ip">ጳዉሎሳ ሂካ ካጋላትያ ሀንዳ ካኮንጻፈራ ሂካ አጋልስስ ካብታቶየሮ እባዶ ልክኪ አማኖ ቶንሳ ካክርስታና ግር ቶስ አባብንያ፥ ጳዉሎሳ የሱሳ ክርስቶሳን ካፋርመሮ ላኖ አዴስሳ ሀጋአባራ፥ ፋራማኖዉን ካኡመራ ዋያ ኳሬ እባዶ ላናዋትና ፋሬንቴሳ አይሁድ ካሌኖን ግሮ እባዶ ቶስ ላኖ ካለካለ ቤሰ አጋልስሳራ፥ ካጋቾ ፎልሲጆል ኦሮ ካክርስታና ግር የሱሳ አማናኖ ታሄላማቶ ጌላንጀኮ ካበያሮ ላኖ አጋልስሳራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="GAL 1:1-10">1፡1-10</ref> </char></para>
  <para style="io1">ካጳዉሎሳ ፋራማኖኮክ ኦዶናት <char style="ior"><ref loc="GAL 1:11-2:21">1፡11—2፡21</ref> </char></para>
  <para style="io1">ስኖ ታዋክ ዎንጋላ <char style="ior"><ref loc="GAL 3:1-4:31">3፡1—4፡31</ref> </char></para>
  <para style="io1">ባልቹማ ታክርስታናና አማኖ <char style="ior"><ref loc="GAL 5:1-6:10">5፡1—6፡10</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="GAL 6:11-18">6፡11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>እባዶኮ ጎርቱን ጋራ ካእባዶነ ካፋራመሮ አንሌኖን ግራን የሱሳ ክርስቶሳና ጎይኮ ካኬሰሮ ዋ ኦዶይ ካፋራመሮ እን ጳዉሎሳኮ። <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>እን ዎታ ታግቶ አባላል ዱባኮ ጋላትያ ካግሮ ዋ ታአማናቶ አቢላል ዱባን።<verse eid="GAL 1:2"/></para>
  <para style="s1">ጋላትያይ ካግሮ ቁሉክ ምን ካሞጋኑን</para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>ኣቦካን ዋኮ፥ ጎታ የሱሳ ክርስቶሳኮ ስኖና ኖጎዳ እስኑን ሀሌተ።<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>ዋ ሄዶ ካንና ኣቦካንት ፈኢ፥ ሂካ ካሜላን አላምኮ ኖ ሃስን ጩቦካን ማራን እስኦቴሳ ስሳተ። <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮን ዋዉን ካባጃ ሀሌቶ! ሀሚኒዕ።<verse eid="GAL 1:5"/></para>
  <para style="s1">ዎንጋላ ኮያ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>ታክርስቶሳ ስኖ እስን ካኡመሮ ዋ ሄዶ ኢሰዴነ፥ ካካለ ዎንጋላ ቶስ ሂካማሌ ጄርቴን አባባታኖክስን እን ሳድሳራ። <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>ሩም ማለ ጎሌ ካካለ ዎንጋላ ላግሮ። እስን ካሶሶይሳራና ካክርስቶሳ ዎንጋላ ዎጫጪን ካዶታራ ኮኮ እባዶ ግራ። <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>አየሱን ጎአመን ኖ ጎሌነና ጎርቱን ካዳሩረ ኤርግቻ ኖ ካላላብነኖ ዎንጋላኮ ካካለ ዎንጋላ እስኑን ካላላበ ኡሱ ጅሩ ጅሮማን ካቃንጋመ ሀሌዎ። <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>ጣይነ ኖ ጎጎአምነኖ ግዳና አደ አን አማራ፥ ማዮና ካአታቴታንኮ ካካለ ካለክ ዎንጋላ ካላላበ ኡሱ ጅሩ ጅሮማን ካቃንጋመ ሀሌዎ።<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>ግዳ አን ካእዳንክ አማሚን ካዶትሳራ እባዶ ዶሌያ ሙ ዋ ዶሌያ? ሙ እባዶ ገጌላይስን ዶታታራ? እባዶ ገጌላይስን ካዶታታሮ ሌዋ ክርስቶሳን ካሀንዳሮ ላኮላረ።<verse eid="GAL 1:10"/></para>
  <para style="s1">ጳዉሎሳ ዋይ ኡማማኖ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>አቢላልቴ፥ አን እስኑን ካላላበራ ዎንጋላ እባዶ ካመጠሮ ልዋት ጎጎአዴሳዉን ዶታራ። <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>ማምስክ እባዶኮና ላኮአታየሮ፤ ማዮኮና ላኮአጋልሳየሮ፤ ሂካና የሱሳ ክርስቶሳኮ አታየራ ካቱሰራና ኡሱያ።<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>አን ጣየ ካአይሁድ አማኖይ ምስምሲ ግረ፥ ዋ ካአማናሮ እባዶ ምሲ ኣሎ ሆሮራረ ባስን ምስምሲ ዶተረ ማልቴታን።<note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ኦፋ. ፈ. 8፡3</ref>፤ <ref loc="ACT 22:4-5">22፡4-5</ref>፤ <ref loc="ACT 26:9-11">26፡9-11</ref>።</char></note> <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>ካአይሁድ አማኖ ኦራታኖይ ጌስኬይ ሀርያቴ ሌ ካግረ ካሞጋን አይሁድ ዱባኮ ሮራረ፤ ዎጋ ካኦዶላልና ኣሎ ሀዉኢሳታ ግረ።<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">ኦፋ. ፈ. 22፡3</ref>።</char></note><verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>አየሱን ጎአመን፤ ኣየቴት ገዴምኮ ሀጋአበረ ካአሳበራ ስኖቴሳ ካኡመራ ዋ፥ <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>አይዛብ ጠኤ ጋራኬሳ ጎጎላላብሮን ዋ ኤረኬሳ ኢን ቱስን ካኮዶተረ ጎራታ፤ ማምስክ እባዶነ ዎታና ላኮማካረሮ።<note caller="-" style="x"><char style="xo" closed="false">1፡16 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ኦፋ. ፈ. 9፡3-6</ref>፤ <ref loc="ACT 22:6-10">22፡6-10</ref>፤ <ref loc="ACT 26:13-18">26፡13-18</ref>።</char></note> <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>እንኮ ሆረነ ኦፋራመራን ኦሌረን ቶስ ታኢየሩሳለም ካታማይ ኦግራነ ዎታ ኤሰልን ላኮቤረ፤ አየሱን ጎአመን ጎርሰዋ ኡል ካአራብ ቶስ ሴየ፤ አደና ደማስቆ ቶስ አባባየ። <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>ኤሰኮና ጌስ ሰድኮ አባባተረ ጴጢሮሳነ ዎታ ኤሰል አዬስን ታኢየሩሳለም ካታማ ቶስ ሴየ፤ ኡሱ ዎታና አሪ ቶሞንኮ ኬን አዳላየ።<note caller="-" style="x"><char style="xo" closed="false">1፡18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">ኦፋ. ፈ. 9፡26-30</ref>።</char></note> <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>አየሱን ጎአመን ካጎታ የሱሳ አቢ ያይቆባ ኳሬ፤ ኦፋራሜራንኮ ማዮና ላኮዴሮ።<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>እስኑን አን ካጻፋሮ አየስ ዋ ሆረ ጣራ አዬስዋት አዴስሰ ሰጋራ።<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>ኤሰኮ አባባየረ፤ ኡል ካሶርያ ቶንሳ ካክልቅያ ቶስ ሴየ። <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>ክርስቶሳይ ካአማናረ አይሁድኮክ ምን ካኤብ እባዶ ካሞጋን እን ዴ ላኮካሶ።<verse eid="GAL 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 1:23"/>እሶ ጎአመን፤ “ጣየ ኖ ሆሮራ ካግረ እባዶት፥ ሂታኮ ሆረነ ባስን ዶታ ካግረ አማኖ ግዳ ላላባ ግራ” ታአማቶ ኦዱ ታላል ማለን ግረን፤ <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>ኣላንቲቴይ ዋ ጋላታረ።<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s1">ኦፋራመራን ጳዉሎሳ አታቴን</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>ጌስ ቶሞንኮ አፋርኮ አባባየረ፥ አን ካላም ኢየሩሳለም ካታማ ቶስ ቤ፥ ኡሱ ጎራታ ባርናባስ እን ዎታ ግረ፥ ቲቶና እን ዎታ ኣተ ሴዬረ።<note caller="-" style="x"><char style="xo" closed="false">2፡1 </char><char style="xt" closed="false"><ref loc="ACT 11:30">ኦፋ. ፈ. 11፡30</ref>፤ <ref loc="ACT 15:2">15፡2</ref>።</char></note> <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>አን ካኮሴየራ ዋ ጎጎቱሰክ ማሌያ፤ ሂታኮ ሆረነ ካፈለሮና ሌረ ግዳ ካፈላራ አዳክ ሊ ጎጎሄሶንኮ አመረ አይዛብን ካላላባሮ ዎንጋላ ኦጂንጂን ኦሌራን ሆረሃዬን ኦፈላራዉን አን መተኬዉን እሶ አዴስሰራ። <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>እነታ ካግረ ቲቶ ካግርክ እባዶ ጎሌና ጎጎሀማጽሳምሮን አን ኡሱ ጉት ላኮሁኖመ። <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>ሂክ አየስ ካኮንኬራ ቶቶ ታጣራ አቢላል ክርስቶሳ የሱሳ ኖ ታሄላነኖ ባልቹማ ባስ አት ድዩማ ቶስ አባብን ሁሉቄን ታቤን። <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>ሂካ እባዶን ኮኪና ዱዶ ላኮኢምናምነኖ፤ ሃንሱን ህክና ታዎንጋላ ሩም እስኔ ዎታ አታይ ጎጎግርቶንያ።<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>ሆረሃየ ካገጌሳሮ ኣን ሌ ካሙታሮ እባዶኮክ አዮናቲን እን ላኮጢባሮ፤ ዋ በቤድ ታእባዶ ዴጉረ ላኮፍርዳሮ፤ ሂክ እባዶና ሀንዳኬዉን ካአደራ አየስ ላግሮ።<note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">አዳ. 10፡17</ref>።</char></note> <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>አየሱን ጎአመን ጴጢሮሳ አይሁድን ዎንጋላ ጎጎላላብሮን ሀዳራ ኡሱን ጎጎስሳንተቶክ ማሌና አይዛብን ዎንጋላ ጎጎላላብሮን ሀዳራ ስሳማኖ አዴሰን፤ <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>ጴጢሮሳ አይሁድን ካፋራመሮ ሊ ጎጎሀንዳይሮን ካየለራ ዋ ሄዶ፥ እና አይዛብን ካፋራመሮ ሊ ጎጎሀንዳይሮ እን የለራ። <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>መተ ሌን ኦሙታራን ያይቆባ፥ ጴጢሮሳና ያንሳ ኢን ታስሳንተቶ ስኖ ካኮአዴሳሬን ጎራታ፥ እና ባርናባስ ጋርጋርን ህኢ ቶ ሌን ኬን፤ ኤሰኮና ኖ አይዛብ ቶስ፥ እሶ አደን አይሁድ ቶስ ሴይን ህኢ ቶ ሌነ። <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>አታይሰን ሀዳራ ካአመራን ህየሳ ጋርጋራኖ ጎጎኢሶንኮ ካላልያ፤ አንና ሂካዋ ፈልን ሀልቻ አባናየ።<verse eid="GAL 2:10"/></para>
  <para style="s1">ጳዉሎሳ ጴጢሮሳ ሀድሰ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>ጴጢሮሳ አንጾክያ ቶስ ካኮኤሜተረ ጎራታ፥ አዴሳመ ሽርመ ማንኮግረ ማራን ኡሱ ሆረ ሀድሰ።<verse eid="GAL 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 2:12"/>ኮኮ እባዶ ያይቆባ ካፋረራ ኡል ካአንጾክያኮ ኤሜታኖኮ ሆረነ፥ አይዛብነ ዎታ አማ ግረ፤ እሶ ካኮኤመቴን ጎራታ አደ ታሀማጽሳንተቶ ኡና አብሳተረ አይዛብኮ እስኦቴሳ ካለ የላተረ ሃርጋላኖ ሀጋአበ፤ <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>ኮኮ ታአይሁድ ኡና ካሌረ ዋ ካአማናራ እባዶና ካጰትሮሳ ኢፍሳዳናት ኡሱነ ዎታ ሌ፥ ባርናባስና ሀሄሶን ኢፍሳዳናትክሶይ ታበ ግረ።<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>ሀንዳኖክሶ ታዎንጋላ ሩም ኣን ልዋት ካኮአዴሰ ጎራታ፥ አን አንጾክያይ ዋ ካአማናሮ እባዶ ዱባ ሆረ ጴጢሮሳነ ሃ አመ፤ “አት አይሁድ ላ ግራን፥ ሴራ ካአይዛብ ኳሬ ሴራ ካአይሁድ ላኮግራቶ፤ ሀያ አይዛብ ሴራ ካአይሁዲ ጎጎሰሴራዉን ምሲ እሶ ሁኖማታ?<verse eid="GAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>“ኖ አላታኑን አይሁድ ኳሬ፥ ‘ጩባለይ ኦሌራን አይዛብ ኣን ላኮኖ።’ <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>እባዶ የሱሳ ክርስቶሳ አማናኖይ ቁሎዋራ ኳሬ፥ ሴራ ካሙሴ ኦራታኖይ ቁሎይዋት ካንሶዋ። ሃንሱን ሴራ ካሙሴ ኦራታኖይ ሀሌኖን፥ ክርስቶሳ አማናኖይ ጎጎቁሎይኖ ኖና አንዴ የሱሳ ክርስቶሳ አማነና፤ ሴራ ካሙሴ ኦራታኖይ ማዮና ዋ ሆረ ላኮቁሎዋሮ።<note caller="-" style="x"><char style="xo" closed="false">2፡16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">ማዛ. 143፡2</ref>፤ <ref loc="ROM 3:20">ሮመ 3፡20</ref>፥<ref loc="ROM 3:22">22</ref>።</char></note><verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>“ክርስቶሳ አማኒልነ ቁሎዪን ጎዶታኖን፥ ኖ እስኦታኒ ጩባለሳ ሌነ ሙታና፤ ሀያ ክርስቶሳ ጩቦ ጎጎባልአሮን የላራ? እጂ ላኮየላሮ! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>አን ካዲገሮ ካሴራ ዎጋ አባበ ካፈላሮ ጎሌ፥ አን መተኬዉንዋ ሴራ ካባሳሮ ላኖ አዴስሳራ። <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>ዋዉን ግርን፥ ጋራ ካሴራነ ጎየ ካአሳባመሮ አን ሴራኮ ካለቤራ። <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>አን ክርስቶሳነ ዎታ ካሱዋመሮክ ማለ ጎየራ፥ ጎርታ አን እስኦቴዉን ላኮግርናሮ፤ አየሱን ጎአመን ክርስቶሳ እን ኦሮ ግርናራ። ግዳና ሶይ ካግርናራ ግር እን ካጌላተሮና እን ማራን እስኦቴሳ ሮርሳተ ካስሳተሮ ኤረ ካዋ ጉት ካአቦ አማኖያ። <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>አን ስኖ ታዋ ላኮየራስናሮ፤ ቁሉማ ጋራ ካሴራነ ታሄላማቶ ጎሌተ፥ ክርስቶሳ አዳ. ካማድኖቱን ጎየ አማኖያ!”<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s1">አማኖ ሙ ሴራ ኦራታኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>እስን ኦሻዶን ኡል ካጋላትያ እባዶ! አየሱን ጎአመን አዮያ እስን ካጎያተ? የሱሳ ክርስቶሳ ካሶዋመ ማለ ሆረትስን አዴሳመ ምስሊ ኣን ሙታ ግረ። <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>አን እስን ዶለኮ አየስ ኮ ካላል አዴስን ዶታራ፤ አያና ካአታቴታን ሴራ ካሙሴ ኦራታኖያ ሙ ዎንጋላ ካላላባመሮ አማናኖይያ? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>ሂካማሌ እስን ኦሻዶንታን? አያና ሀጋአብተዴን ቆፋ ታእባዶይ ጉድስን ዶታታን? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>ዎንጋላ ማራን ታአታቴታን ራኮ ኦግራን ታማድኖን ጎሌተ፥ ህታ ግታት ራኮ ካአታታታን አዳያ? <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>ዋ አያናኬሳ ካኮስሰራ፥ እስን ኦሮ ባሳ ካፈላራ ሴራ ካሙሴ ማንኮኦራተዉንያ ሙ ካማልተን ማንኮአማናቴዉንያ?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>አላ አብራመ ሄዳ፤ “ኡሱ ዋ አማነ፤ ቁሉክ ሌ ቶታመ።”<note caller="-" style="x"><char style="xo" closed="false">3፡6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መጣ 15፡6</ref>፤ <ref loc="ROM 4:3">ሮመ 4፡3</ref>።</char></note> <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ጎርታ ሂኒዕ ኦአማናራን ይስ ካአብራሀመ ላኖ አዴሳ።<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">ሮመ 4፡16</ref>።</char></note> <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>ዋ አይዛብ የሱሳ አማናኖ ካቁሎይስናሮ ቁሉክ ማጻፋ ጣየ ዴጉረ፥ “አይዛብ ዱባ ኩዬ ሶማሳምናራ” አማ ዎንጋላ ጣየ አብራመን አዴስሰ።<note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">መጣ 12፡3</ref>።</char></note> <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>ሃንሱን ዋ ካአማናራ እባዶ ዱባ ዋ ካአማኔሮ አብራመነ ዎታ ካሶማሳመያ።<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>ሴራ ካሙሴ ኦራታኖ ኦአብዳታራን ዱባ ቃንጎ ኦሮ ግራን፤ ኣላንቲና “ካሴራ ማጻፋ ካሙሴ ካጻፋመሮ ዱባ ካፈሎን ካቃንጋመያ” አማመ ጻፋመራ።<note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="DEU 27:26">አዳ. 27፡26</ref>።</char></note> <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>“ቁሉክ አማኖ ኔፎ ግራራ” ማንኮአማመሮን፥ ማዮና ዋ ሆረ ሴራ ቁሎይዋት ካአዴሳመያ።<note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="HAB 2:4">እንባ. 2፡4</ref>።</char></note> <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>ሴራ አማኖ ጉት ካኡኩማመሮ ላኮዮ፤ አየሱን ጎአመን፥ “እባዶ ሴራ ግርን ካዳንዳራ አጃጃ ካሴራ ዱባ ጎጉድስሮያ” አማመ ጻፋመራ።<note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ዎዩ. 18፡5</ref>።</char></note><verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>“ጋ ጉት ካሱዋማራ ዱባ ካቃንጋመያ” አማመ ማንኮጻፋመሮ ማራን፥ ክርስቶሳ ኖ ማራን ካቃንጋመ ሌረ ካሴራ ቃንጎኮና ዎዶ ሌ ቤሰራ።<note caller="-" style="x"><char style="xo" closed="false">3፡13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">አዳ. 21፡23</ref>።</char></note> <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>አብራመን ኦስሳሜራን ሶማ፥ ጋራ የሱሳ ክርስቶሳነ አይዛብን ጎጎጌራዉና ዎዶ ሌ ቤሰራ፤ ህክና ዋ ስሳናራ ካአመሮ አያና ቁሉክ አማኖ ጎጎአታኖንያ።<verse eid="GAL 3:14"/></para>
  <para style="s1">ካኦርት ሴራና ካአብዲ ሃፉራ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>አቢላልቴ፤ ካአር አሪ ካእባዶ ግሪ ካአዴሳመሮ ማሱሳ የል አን እስኑን ሰጊሮ፥ ኦእባዶ አማቶ ኮይክ ጎአባቴን አባባይ ማዮና ኢግልስን ጎርቱን ኡሱ ጉት አድን ካዳንዳሞንክ ማለ፥ ህታ ሃጃይ ጎሌና ኡሱማሌዋያ። <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>ካአብዲ ሃፉራ ካሰጋመራ አብራመና ሳኒቴሳዉንየ፥ ቁሉክ ማጻፋ፥ እባዶ ካሞጋኑን ጎጎሰጋማሮን፥ “ሳኒቴሳን” ላኮአማሮ፤ አየሱን ጎአመን እባዶ ኮዉን ጎጎሰጋማሮ፥ “ሳንታዉን” አማራ፤ ኡሱና ክርስቶሳያ።<note caller="-" style="x"><char style="xo" closed="false">3፡16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">መጣ 12፡7</ref>።</char></note> <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>ጎርታ አን ካአመራ ሂካያ፤ ጌስ አፋር ቦለና ሶንዶምኮ ሃር አባባተረ ካስሳመራ ሴራ፥ ጣየ ዋይ ኦአታቴራን አማቶ ባስረ ካአብዲ ሃፉራ ላኮኢግልሳሮ። <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>ርቲ ኤላኖ ሴራይ ሊግረዋ፥ ካአብዲ ሃፉራ ላኮሄላማረ፤ ዋ አደ ስኖቴሳ ካአብዲ ሃፉራነ ዎታ አብራመን ስሰራ።<note caller="-" style="x"><char style="xo" closed="false">3፡18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">ሮመ 4፡14</ref>።</char></note><verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>ሀያ ሴራ ካኮንስሳመራ ኣላንቲ መታ? ሴራ ካኮአዳመራ አብራመን አብዲ ታስሳንተታ ሳኒ ታኤሜቶ ጊንያ፤ ፈሎ ኦሜላን ቱስንያ፥ ሴራና ካኮኤሜተራ ዋይና እባዶ ጠኤ ካግሮ እባዶትን ጋራ ካኤርግቻነ ሰጋመረያ። <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>ሀሌዎ ኳሬ ጣየ ካዎጋርሳራ ኡና ቶ ታላል ላኮዮ፤ ዋ አደ ኮያ።<verse eid="GAL 3:20"/></para>
  <para style="s1">ሴራ ካኮንስሳመሮ ኣላንቲ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ሀያ ሴራ ካዋ ካአብዲ ሃፉራ ካዲዳሮያ? እጂ ላኮዮ፤ ሴራ ካኮንስሳመራ ኔፎ ሄላምስሲን ሊግረዋ፥ ኦግራን ቁሉማ ጋራ ካሴራነ ሄላም ግራተዋ። <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>ቁሉክ ማጻፋ አደ አላም ዱባ ጩቦ ካሽያመ ላኖ አዋጃራ፤ ህክና የሱሳ ክርስቶሳ ታሄላማታ አብድ ኦአማናራን ዱባን ጎጎስሳንቶያ።<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>ሂክ አማኖ ኤሜታኖኮ ሆረነ ሴራ ቶንሴ ኦሽያምነኖ ሌነ፥ አማኖ ታ አዴሳምሮን ጊን ኖን ጩፋመ ግረ። <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>ሃንሱን አማኖ ጎጎቁሎይኖ ሴራ ክርስቶሳ ቶስ ካጌግሳሮ ራ ሌ። <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>ግዳ አደ ሀሱ አማኖ ማንኮኤሜተ ማራን ጎርታኑን ታሴራ ራኮ ሄገሊ ላኮኖ።<verse eid="GAL 3:25"/></para>
  <para style="s1">ይስ ካዋ</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>ዱባና የሱሳ ክርስቶሳ አማናኖይ ይስ ካዋታን፤ <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>ክርስቶሳነ ዎታ ኮ ጎጎሌታኑን ኦጣማቃንተታን ዱባና ክርስቶሳ ሳርሳቴታን። <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>አይሁድና ግሪክ፥ ድይና ባልቻክ እባዶ፥ ባባርና ሄለልትቲ ጠኤ አሳብንጀ ላግቶ፤ ዱባና ክርስቶሳ የሱሳ ኮታን። <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>ካክርስቶሳ ጎሌተን፥ እስን ታአብራመ ሳንታን፤ ካአብዲ ሃፉራክ ማለ ኦኤልናታንታን።<note caller="-" style="x"><char style="xo" closed="false">3፡29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">ሮመ 4፡13</ref>።</char></note><verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="s1">ይስ ካዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>ግዳና አን ካአማራ ሂካያ፤ ካኤልናራ ይትት ታሌርት፥ ዱርማ ዱባ ታቴሳ ጎሌተና፥ ድይኮ ካለካለ ላኮዮ። <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>ኣቦኬሳ ካሙርቴሰራ ጎራታ ታ ጌሮን ኦኦራራና ኦጂናሳራን ሄገሊያ። <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>ኖና ኡሱማሌ አያናይ ጋና ይስ ሌነ ታኮግኔ አላምኮክ አጋልስስ ሄገሊ ሌነኔ ድይናት ኢምናምነ ግኔ። <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>አየሱን ጎአመን ዋ ካሙርቴሰራ ጌስ ካኮጌ ጎራታ፥ ዋ ሄለልትቲኮ ካኡሙላመሮና፥ ሴራ ካሙሴን ካአጃጃመሮ ኤረኬሳ ፋረ። <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>ህክና ካሌራ ሴራ ካሙሴ አጃጃማ ኦግራን ዎዶ ሊና ኖና ይስ ካዋ ጎጎሌኖን የልንያ።<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">ሮመ 8፡15-17</ref>።</char></note><verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>ኣላንቲና ይስኬሳ ማንኮሌዉን ዋ፥ “ኣቦ ኣቦኬ” አም ካኮኢይኖ ኤረኬሳክ አያና ዎዳናታን ቶስ ፋረ። <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>ሃንሱን ሂታኮ ሆረንባን ኤረታ ኳሬ ድይ ላኮቶ፤ ኤረ ማንኮሌተ ማራን፥ ዋ ኩ ካኤልናቶ የለራ።<verse eid="GAL 4:7"/></para>
  <para style="s1">ጳዉሎሳ ኡል ካጋላትያክ እባዶን ሻዳኖ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>ዋ አዴሳኖኮ ሆረነ፥ ያዳሊ ትሶይ ሄዶል ኦሌኖቱን ድይጆል ሌተን ግቴን። <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>ግዳ ጎአመን ዋ አዮዮ አዴሰታን፤ ሱረዋ አደ ዋይ አዴሳንተታን። ሀያ ካላም ላፋክና ካማድኖን ሄዶል ቶስ ምሲ አባባታን? አባባይና ኡሱን ድይ ሊን ዶታታን?<verse eid="GAL 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 4:10"/>ካለኒዕ ኦሌራን አርጆል፥ ድግንጆል፥ አልማጆልና ጌስጆል ካባጃታን። <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>እስን ማራን ፈሎይ አዳ. ካሀረሮ ኣን ሌረ አን አብሳታራ።<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>አቢላልት፤ አን እስን ኤባታራ፤ አን እስን ኣን ጎጎሌሮ እስና እን ኣን ላ። እስን ኮና እን ላኮሚርቴታን። <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>እስን ጎጎካሳኒ ሆራርጀ እስኑን ዎንጋላ ካላላበራ፥ ሀዉኣምኮክ ኣላንቲየ። <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>ሀዉኣምክ እስኑን ጫፍቲ ሌ ግራንቱና ዱዶ ላኮህፋቴታን፤ ጎርቱን ላኮጢቃተታን፤ አየሱን ጎአመን ኤርግቻ ካዋ ኣን፥ ሱረና ኡሱ የሱሳ ክርስቶሳ ኣን የላቴን ቆጳቴታን። <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>አየሱን ጎአመን ሀኑኡ ገጌሎኦትስን ሀጌ ሴተን? ዳንዳመዋ ኢልኦ ኦትስን ጎሌና ሱረ ቤስ ኦስሳን አን ሊ ግራኖክስን አን መተኬይዋ አቶትናራ። <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>አን ሩም እስኑን ማንኮሰጌሮ ማራን ዲናክስን ኣን ሌ ሙተ?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>ኣክ እባዶ እስን እስኦትሶ ቶስ ኣትን እጻማራን፤ ላኮኢዳነንዮ፤ እስን ካኮንዶታራን ኖኮ ካለ ጎጎቤታኑና እሶን አታይ ጎጎያዳዉንያ። <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>እዳኔን ታሌርት ካዉድታማሮ ላኖ ካእዳንክያ፤ ህክና ሊን ካዶትሳራ አርጌቶ ኳሬ አን እስኔ ዎታ ግራንቱን ካላል ላኮዮ። <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>አን ካጌላታሮ ይስኬ፤ ክርስቶሳ እስን ኦሮ ታሙትሮን ጊን እስን ማራን አደና ታኡሙላ ጭንቂ ኦሮ ግራ፤ <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>እስን ማራን ግርድ አመረ ጫናቃመራ፤ ግዳ እስኒ ኦሮ ሙትረ ካለት ሄኢ አዬስን ምሲ ጌላየረ!<verse eid="GAL 4:20"/></para>
  <para style="s1">ታአጋርና ታሳራ ማሱሳ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>እስን ካኦርት ሴራኮ ሄገሌ ግርን ካሀልቻታን አላ ሰጋ፤ ሴራ መ አማሮ ላኮማልተታንያ? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>አብራመ ይስ ላማ አባናየ፤ ኮ ድይትኮ ካካለ አደ ባልቻት ሄለልትቲኮ ኡሙላማኖ ማጻፋ ቁሉክ ጻፋመራ። <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>ኡሱን ታሀንዳቶ ታሌተቴ ሄለልትቲኮ ካኡሙላመረ ኤረ ባባርትት፥ ፈኢ ታእባዶ ማሌየ፤ ባልቻት ሄለልትቲኮ ካኡሙላመራ አደ አብድ ታዋክ ሃፉራ ማሌየ። <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>ሂኒዕ ሄለልጃ አማቶ ላማ ማንኮቱሳናን ማራን፥ ሂክ አየስ ማሱሳ ኣን ካድያማሮያ። አማቶ ኦሆራርጄ ታሲና ዎዳምኮ ጎሌና፥ ድዩማን ካሌሮ ይስ ታኡሙላቶታ፤ ኤሰና አጋርታ።<note caller="-" style="x"><char style="xo" closed="false">4፡24 </char><char style="xt" closed="false"><ref loc="GEN 16:15">መጣ 16፡15</ref>፤ <ref loc="GEN 21:2">21፡2</ref>።</char></note> <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>ጎራታ አጋር ካአራብ ኡሊ ታግቶ ታሲና ዎዳሚ ማሱሳማታ፥ ግዳ ታግቶ ኢየሩሳለም ኣን ላታ፤ ይስክሴነታ ድዩማ ግታ። <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>ኤለኮ ታሌተታ ኢየሩሳለም አደ ባልቹማ ግራታ፤ ኤሰና ኣየታንታ።<verse eid="GAL 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="GAL 4:27"/>“አት ይስ ታኡሙሎን ማሴና፤ ገጌላ!</para>
  <para style="q2" vid="GAL 4:27">አት ኡሙላ አባም ታካሶን፥ ‘እልሊ’ አም ኢዪ፥</para>
  <para style="q1" vid="GAL 4:27">ኤንተር ታአብቶ ሄለልትቲኮ ሮርተ፥</para>
  <para style="q2" vid="GAL 4:27">ኤንተርካሊት ሄለልትቲ ይስ ካሞጋን አብታ” አማመ ጻፋመራ።<note caller="-" style="x"><char style="xo" closed="false">4፡27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">ኢሳ. 54፡1</ref>።</char></note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>ጎራታ አቢላልት፤ እስና ይሳቃ ኣን ካአብዲ ሃፉራኮክ ይስታን። <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>ኡሱ ጎራታ ፈኢ ታእባዶ ማለ ካኡሙላመራ ኤረ ባባርትት፥ ሁና ካዋኮክ አያና ካኡሙላመሮ ሆሮረ፤ ግዳና ኡሱማሌዋያ።<note caller="-" style="x"><char style="xo" closed="false">4፡29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">መጣ 21፡9</ref>።</char></note> <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>አየሱን ጎአመን ቁሉክ ማጻፋ መማራ? “ድይት ኤረክሴ ዎታ ቤስና፤ ኤረ ካድይቲ ካባልቻት ኤሬነ ዎታ ላኮኤላሮ” አማራ።<note caller="-" style="x"><char style="xo" closed="false">4፡30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">መጣ 21፡10</ref>።</char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>ሃንሱን አቢላልት፤ ኖ ባልቻኒዕ ኳሬ ካድይት ይስ ላኮኖ።<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s1">ክርስቶሳ ታሄላማቶ ባልቹማ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>ክርስቶሳ ኖ ባልቹማ ካቤሰራ ባልቹማ ጎጎግርኖንያ። ሃንሱን ታሄላቴታን ባልቹማ አታዬን ግራ፤ ካላም ካድዩማ ሀርቆታ አሮአባንቴን።<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>አን ጳዉሎሳ እስኑን ካአማራ ሂካያ፤ እስን “ሀማጽሳምን ዶትሳራ” አምዴን ጎሀማጺሳንተን ክርስቶሳ እስኑን ኢጂ እስኑን ላኦ ላኮአቦ። <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>“ሀማጽሳማኖ ኢን ዶትሳራ” አመረ ካሀማጺሳማራ ዱባ “ሴራ ካሙሴ ዱባ ጉድሳኖ ካሄሶን ላኖ” አደና ካላም አዴስሰ አን ሰጋራ። <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>እስን ሴራ ካሙሴይ ቁሎዪን ኦዶታታን፥ ክርስቶሳኮ ካለቤተታን፥ ስኖ ታዋኮና ፋክንቴታን። <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>ኖ ጎአመን ካዋ አያና ታቁሉማ አብድ አማኖይ ኦራይናና። <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>ክርስቶሳ የሱሳ አብዳይ ጎግርነ፥ ሀማጽሳማኖ ጎርቱን ሀማጽሳማኖ ዋት ላኦ ላኮአቦ፤ ላኦ ካአባ ጌላንጄ ካቱሳማሮ አማኖ ካላልያ።<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>ሂታኮ ሆረነ ክርስቶሳ ዎታ ካግቴን ግርክስን ካእዳንክየ፤ ሀያ ግዳ እስን ካሀንዱዱፍሰ፥ ሩምዉና ጎጎሀንዳይኖንኮ ካትረ አዮያ? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>ሂካ ኣንክክ ሶሶባኖ እስን ካኡመሮ ዋኮ ካኤመተሮ ላኮዮ፤ <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>“እርሾ ኡጫር ካሙላመሮ ካም ዱባ ኬሳታ።”<note caller="-" style="x"><char style="xo" closed="false">5፡9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1 ቆሮ. 5፡6</ref>።</char></note> <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ጎታይ ካአብታን ኮናትኮ ካካለ ያዳ እስኑን ግርዋት አን አብዳታራ። እስን ግርድ ካኢሳራ ማዮና ጎሌ፥ ማዮ ፍርዳ አታይናራ።<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>አቢላልት፤ ህታር ጊን ጋራ ካሀማጺሳማኖ ካላላባሮ ጎሌ፥ ሀያ ግዳ ጊን አይሁድ እን መዉን ሆሮራናን? ኡሱማሌ ሊ ግረዋ፥ ታክርስቶሳ ማስቃሊ ሀንዱዱፎ ላኖ ሄስ ግራተዋ። <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>እስን ካግርድሳራ እባዶ ካክሶ ሀማጽሳማኖ ካላ ሀሌኖን ግራን እስኦትሶ ሀሳንጎምሳቴን!<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>አቢላልት፤ ባልቻኒዕ ጎጎሌታዉን ኡማንቴታን፤ ባልቹማትስን አደ ካሶየ ሀልቻክስን ካኮብያታን አሮየላቴን፤ ኡሱኮ ኮ ካካለቱን ጌላንጄ ሀሃንዳዎ። <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>ሴራ ካሙሴ ዱባ ሃፉራ ኮይ ራቶ አባመራ፤ ህክና፥ “እባዶ ዱባ እስኦታ ኣን ጌላ” ካአማሮያ።<note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዎዩ. 19፡18</ref>።</char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>አየሱን ጎአመን እስ እስሮ እስ ኦድሻታና እስኦሮ እስእስ ኦሚራኣታን ጎሌተን፥ ጎጎባኖንኮ እስኦራዬን።<verse eid="GAL 5:15"/></para>
  <para style="s1">አያና ሰሴታኖ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ጎርታ አያና ቁሉክ ግራ አማራ፤ ሀልቻ ካሶየና አሮፈልቴን። <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>ኣላንቲና፥ ሀልቻ ካእባዶ አያና ቁሉክ ካዶታኖን፥ አያና ቁሉክና ሀልቻ ካእባዶ ካዶታኖን ሀልቻራ፤ ሂኒዕ እስእስኦሮ ማንኮዲዳራን ማራን፥ ካዶታታን ፈልን ላኮዳንዳታን።<note caller="-" style="x"><char style="xo" closed="false">5፡17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">ሮመ 7፡15-23</ref>።</char></note> <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>አያና ጎሰሴተን አደ፥ ሴራ ካሙሴኮ ሄገሌ ላኮታን።<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>ሀልቻ ካእባዶ ካአዴሳመያ፤ እሶና ሻርሙጡማ፥ ባትናት፥ ራራጋታኖ፥ <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>ቶልቻ ሄዶይሳታኖ፥ ሞሩ፥ እስዲዳኖ፥ ኤንገ፥ ጢቤ፥ አማራንጀ፥ እስ ጌላታኖ፥ ካለካለቤያኖ፥ አዱማ፤ <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>ጋቢ፥ ሰታኖ፥ ጩቦ ቶስ ኦጌሳራን ዱዱራኖ፥ አደና ሂካ ኣንክክ ካሌያ። ጣየ አን ጎጎሰጌሮ፥ ግዳና አደ ሴርሳራ፤ ሂካ ኦፈላራን ዱባ ዎኖናት ካዋ ላኮኤልናራን።<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>አያና ቁሉክኮት ኢል አደ ጌላንጀ፥ ገጌሎ፥ ኖጎዳ፥ ኦብስ፥ አንጅረ፥ ኢዳነ፥ አብድ፥ <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>እባዶን ነያኖ፥ እስኦራታኖያ። ሂካ ኣንክክ ካትራ ሴራ ላግሮ። <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>ክርስቶሳ የሱሳ ኦግራን ሀልቻ ካእባዶ ካሜላን ሀልቻና ዶትኬሳ ዎታ ሱዋተራን። <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>አያና ቁሉክ ኦግራኖ ጎሌነ፥ አያና ቁሉክ ጎጎገጌሳሮ ሰሴና። <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>እስእስሮ ናናታታና ጋባ አዳ. ካማድኖን ላኮዳኖ።<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s1">እባዶ ዱባን ታኢዳን ፈላኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>አቢላልት፤ እባዶት ኮ ጩቦ ኦሮ ታብ ጎሙተ፥ አያና ቁሉክ ኦሰሰያታን እስን አንጅሬ አባብን ዶትሳራ። አየሱን ጎአመን አትና ጎጎጫፋሞንኮ እስኦታ ኦራ። <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>ኮ ካካለኮት ስዳነ ሀስደ፤ ሂካኒና ካክርስቶሳ ሴራ ፈሎይ ሀይሳታን።<note caller="+" style="f"><char style="fr" closed="false">6፡2 </char><char style="ft" closed="false">ፈሎ ሀይሳታን፦ ኮኮ ካሆርኮ ማጻፋል ፈሎ ሀይሳ አማራ።</char></note> <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>እባዶት ኮ ኮና ካላይ “አን ካካለኮ ሮራ” አም ጎሄደ፥ እስኦቴሳ ሶባታራ። <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>እባዶ መተመቴ ፈሎኦቴሳ ሀቆቆራቶ፤ ኤሰኮ ሆረንባን፥ እባዶ ካካለ ዎታ እስኦቴሳ ሀሄረጋኖን፥ እስኦቴሳን ካጣዳሮ ሄላታራ። <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>ኣላንቲና መተመቴ እባዶ ስዳነቴሳ ስዳይን ዶትሳራ።<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>ማዮና ሃፉራ ካዋ ካአጋልሳታራ፥ ካእዳንክ ካሌሮ አየስ ዱባ ካአጋልስሳሮነ ዎታ ሀሄዴዳመ።<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>እስኦትስን አሮሶባቴን፤ ዋ ላኮቃጭፋማሮ። እባዶ ካዉጣተሮ ኡሱዋ ታጋታራ። <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>ሀልቻ ካእባዶይ ካዉጣታራ፥ ሀልቻ ካእባዶኮክ ጎይ ግናራ፤ አያና ቁሉክ ገጌላይስን ካዉጣታራ አደ አያና ቁሉክኮ ጅሩ ጅሮማክ ግር ሄላይናራ። <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>ሃንሱን ካእዳንክ ኮኮ ፈላናኮ ላኮሀራኖ፤ አብድ ጎጎሳኖን ልክኪ ጎራታ ጎጌ ዉጣ ኩኩይሳይናና። <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>ሃንሱን ኢድሊ ጎሄላነ እባዶ ዱባን አደና ዋ ካአማናሮ እባዶን ምን ኦሌራዉን ኮኮ ካእዳን ፈልና።<verse eid="GAL 6:10"/></para>
  <para style="s1">ጎርሳና ኖጎዳና</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>ካጂንጂን ፍዳሌል አን ምስምሲ ገነቴይ ጎጎጻፈሮ ዲያ። <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>ካሳረ ካሌሮ አየስ ሙትን ካዶታታራ እባዶ ጎጎሀማጽሳንታኑን ሁኖምን ዶታራን፤ ሂካና ካኮንየላራን ማስቃሊ ጉት ካጎየሮ ክርስቶሳ ማራን ጎጎሆሮራሞንኮያ። <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>እሶ ሶኦትስኒ ሀማጽሳኖይ ዳይን አማ ጎጎሀማጽሳንታኑን ዶታራን ኳሬ፥ ኦሀማጺሳሜራን እሶና ዱዶ ሴራ ኦኦራታራን ላኮያን። <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>አየሱን ጎአመን አን ካካለ ካኮዳታሮ ላኮአቦ፤ ጎታካን ታየሱሳ ክርስቶሳ ማስቃሊ ኳሬ ካካለት ዳታኖ እንኮ ሀፋክመ፤ ህታ ማስቃሊ አላም ካጎየ አን እንኮ ካለቤራ አንና ካሜላን አላምኮ ካለቤራ። <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>ሀማጽሳማኖና ሌረ ሀማጽሳማናዋት ላኦ ላኮአቦ፥ ላኦ ካአባ የሱሳ ክርስቶሳ መጣ ታኡሱብ ላኖያ። <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>ህታ ፋረን ዴበ ካሰሰታሮ ዱባ፥ ጎሳ ካዋ ካሌሮ እስራኤል ጉት ኖጎዳና ሻጋ ሀሌዎ።<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>አየስ ጉድሳና፥ አን የሱሳ ክርስቶሳ ማራን ካአታዬሮ ካራኮ ማታማ ሶኦቴይ ስዳየራ፥ ሂታኮ ሆረንባን ማዮና እን ላኮራክስሮ።<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>አቢላልቴ፤ ጎታካንት ታየሱሳ ክርስቶሳ ስኖ እስን ዎታ ሀሌቶ፤ ሀሚኒዕ።<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
