<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Bayso New Testament</book>
  <para style="h">Yayik'ooba</para>
  <para style="toc1">Handdaa Kayayik'ooba</para>
  <para style="toc2">Yayik'ooba</para>
  <para style="toc3">Yay.</para>
  <para style="mt1">Handdaa Kayayik'ooba</para>
  <para style="imt">Tabano</para>
  <para style="ip">Hikki kayayik'ooba handdaa barsano ohittariteewun seera talleeto k'ofa kaɂabero golleero kakkoons'aafamerana alami dubbaayi darɂaantte tagitto tomonkko lama aaniiwunye; s'aafitina k'arumma felooyi noo kakkohayisinnanno malakokki gara, amaniilkokki k'op'atanonna yadaliikokki seera kalleero ayees addeesise misilii kaɂabo ayees roorisara. Hiyyummakokki garana durummakokki gara, c'aafitiikokki gara, amala kaɂidankokki gara, haɂusatanokokki gara, ammanokokkina taɂidan yadaliikokki gara, hiɂikotti idanena meellanekkokki gara, k'arummakokki gara, isiɂisirroo isidiidanokokki gara, koorakokkina anjjirekkokki gara, kakkalee gutii firddaanokokki gara, dhaadatanokkokki gara obssikokkina ebikokki gara, amaniil felin kadootisaro dubba kalekalee beese s'aafera.</para>
  <para style="ip">Hikki handdaa amaniilkokki girii ammano felooyi tusanokokki gara aaloo addeesise tusara.</para>
  <para style="iot">Raattoo Hikki Mas'aafa Kaɂabera</para>
  <para style="io1">Tabano <char style="ior"><ref loc="JAS 1:1">1:1</ref> </char></para>
  <para style="io1">Ammanona k'arumma <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">Hiyyummana durumma <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">C'aafiti <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref> </char></para>
  <para style="io1">Haafura kawaa maalanonna felooyi hayisano <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref> </char></para>
  <para style="io1">Ululisi goggoɂayeesonkko kasisamero seera <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">Ammanona feloo <char style="ior"><ref loc="JAS 2:14-16">2:14-16</ref> </char></para>
  <para style="io1">Amaniilnna hiɂittisoo <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref> </char></para>
  <para style="io1">Amaniilnna hikka alami <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">Kalekaleekki ayeeskkokki garaan kasisamero gorssa <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>Waawunna Goottaa Yesuusa Kiristoosan kahandaara, Yayik'ooba, alamii darɂaantteen ogittan aanii tomonkko lamaawun:</para>
  <para style="p" vid="JAS 1:1">Nogodda isinuun halleeto.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">Mat. 13:55</ref>; <ref loc="MRK 6:3">Mar. 6:3</ref>; <ref loc="ACT 15:13">Ofa. Fe. 15:13</ref>; <ref loc="GAL 1:19">Gel. 1:19</ref>.</char></note><verse eid="JAS 1:1"/></para>
  <para style="s1">Rakkoo orroo kadootisaro ammanona k'arumma</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>Abbilaalttee, kalekaleetti rakkoo isin gogeete oɂatii geggeloo aani tootaa; <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>aalanttina ammanokkisinkokki c'aafamano obssi sisano kassaanwa. <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>Koonna kakkoonhank'k'annon k'ulluunɂina kameen dubba likkiinɂina oɂammagantteen goggolleetanun obssi feloɂoottisee hafeltto. <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>Isinkko maayona k'arumma gohank'katte, hattuffannon dubbaan adda kasisaro Waa haɂebaato; usuna sisamirowa. <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>Ayesuun goɂameen hahedannooni ammanoo haɂebaato; aalanttina kahedatara ibaaddo anbbal kaɂaaɂisattona kakkeyaaro gaashimallo kabekee aaniya. <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>Hassu aankkikki ibaaddoti, Goottakko kooko koo helayinnara ami aroohedanno. <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>Usu k'ofa lamaa kaɂabamena raakkessa dubbaa haggattola kalaalɂaamaroya.<verse eid="JAS 1:8"/></para>
  <para style="s1">Hiyyeessakki ibaaddotina dureessakki ibaaddoti</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>Bariisanoyi kakkonyeraateraan abbi Waa t'ok'k'i mankkoɂisaro maraan hageggelaato. <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>Durumma taɂibaaddo daraara taɂeese aani mankkoɂubaatto maraan bariisanoyi t'ok'k'i kaɂame abbi Waa bariisanoyi goyeraasena hageggelaate. <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>Arriti gubanokko kakkeeyi fuurssaayi eesii angagisatta; daraarana ubaatta; middina baatta; usumaleenna dureessakki ibaaddoti feloɂootteessaa haggattola raankkaa baara.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">Isa. 40:6-7</ref>.</char></note><verse eid="JAS 1:11"/></para>
  <para style="s1">Ibaaddo gutii taggiyatto c'aafitii</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>C'aafitii orroo kaɂataatara ibaaddoti kasommaasameya; aalanttina c'aafitii kakkodaanddee goorata Waa ogeelataroon tasisero abddii, kagiri kallachcha helayinara.<verse eid="JAS 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13"/>Maayyona goc'aafame, «Waa in c'aafee» arooɂamo; aalanttina Waa meellaneeyi lakkoc'aafamaro; usu ade maayyona lakkoc'aafaro. <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>Ayesuun goɂameen metemeteeyi ibaaddo kakkoc'aafamara kameellanee halchchakkeessa gobboojaamirona gosobamiroya. <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>Halchchana kakkojiinaro goorata c'ubbo umulara, c'ubbona kakkojiinate goorata goyi umulara.<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>Ogeelaantteen abbilaalttee, aroosobantteen. <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>Kaɂidan ilabona duuddonɂi somma dubba Waakkoyyaan; hikkina kaɂemeetara hoosindde aani maraamuraa goorttun iggilissama kakkoginnon kaɂifa odo Waakkoya. <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>Waa no met't'a dubbakko ohoree goggolleennon feɂitteessaa karrummii haafuraa no umule.<verse eid="JAS 1:18"/></para>
  <para style="s1">Kamaaleen felo gutii hayisano</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>Ogeelaantteen abbilaalttee! Hikka shaada; ibaaddo dubba maalin kajejjeree, ayeesin kaɂisilaate, iɂokkona kaɂobssee halleewo. <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>Iɂo oɂibaaddo k'ullumma tawaa lakkokeenaran. <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>Haanssun battowanona meellanekkokki jiinaan tirayenddeene neefottisin fayyiisin kadanddaro, wodanatattisini kadhaabbatero haafura idanee atayeen.<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>Haafurakkeessa kaɂamaro fela kuwaarre kamaalaro kaalaa liddeene isiɂoottisin aroosobatteen. <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>Haafurakkeessa kamaalara, ayesuun goɂameen kaɂamaro kaɂoorannon ibaaddoti bebbeedtteessa daawɂitii kadiyaataro ibaaddo aaniya. <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>Isiɂootteessana diyaate seetara, goorsewa me aani laaro illootara. <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>Ayesuun goɂameen balchchumma kabeesaro likkiikki seera deere kaɂataatara, kamaalero kafelarana kaɂilloonno ibaaddo feloɂootteessaa kasommaasame laara.<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>Hiɂitteessa haɂoorannoni, wodanatteessa shirsataa ammano aba kaɂamara ibaaddoti, isiɂoottessa sobatara, ammanokkeessakonɂi felona laɂo kallayinɂiyan. <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>Waa Odooyi horee kamuc'c'imena meellane kallayikki ammano hikkaya; odona Aanna okkoongoyeraan yiinssa entterjjol kakkongoyero heleel rakkoottisooyi gargaaranona alamikokki battinatikko isi ooratanoya.<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">Hiyyeessa tuffatano kadootisoon laano</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>Abbilaalttee, kabaja kalleero Goottakkaani Yesuusa Kiristoosa oɂammanattaan mankkoleeten maraan arooɂululisse. <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>Tawork'k'ii firaantta kakkaaterena kaɂidankki sarssi kasarsatere ibaaddoti taɂamaniil haganaa tos kakkottabe goorata usumaleenna t'ork'k'e kaɂaate sarssi kasarsatera hiyyeessakki ibaaddo gottabe, <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>Kaɂidankki sarssi kasarsateen kaletti kabaja tusaa, «Kuyeen kadootisara kaɂidankki barc'uma hikkima» goɂantteen hiyyeessatine adi, «Ati hassee aallii» goorttun lukittee hegelii «Hamas's'ii» goɂantteen, <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>isin orroo ululisano lakkoyoya? Adena k'ofa tameellani oɂabantteettanna ofirddaattaan laano lakkoyoya?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>Ogeelaantteettan abbilaalttee, maala, Waa ammanoo dureessa goggolleenawunna usu ogeelaataraawun abddii kasisamero wononnati goggoɂeellawun hikka alamikki hiyyeessal lakkoɂassaaberoya? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>Isin adeen hiyyeessal yeraasseen; isin oc'annak'isaran dureessaal lakkoyeenya? Min kafirddii tos isin ogeesaraan la isoyaanna? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>Isinii kaɂuumamero kabaja kalleero mege oɂinggaamaraan lakkoɂisoyaniya?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>Mas'aafayi k'ulluukkii, «Ollaattaa isiɂoottaa malee yela geelaa» amame kas'aafamero seera kawaa goɂooratteen taɂidan felaagittaan.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Woy. 19:18</ref>.</char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>Goɂululisseen adi c'ubbo felaagittaan, seera horeenna seera kabaasaro aani tootaamattaan.<verse eid="JAS 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 2:10"/>Aalanttina seera dubba kaɂooratara ayesuun goɂameen seera kooyi kahanduddufatara gogire, dubbana baasano aani tootaamara. <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>«Aroosharmmut'ite» kaɂamera Goottaa usumaleenna «Aroolagadena» amera. Gosharmut'anawatte, ayesuun goɂameen gollagadde, seera kabaasatto leetetta.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">Biy. 20:13-14</ref>; <ref loc="DEU 5:17-18">Ada. 5:17-18</ref>.</char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>Ayeesaanna leere felataa gogitteen balchchumma kasisaro seeraa horee kafirddaaro ibaaddo aani leen. <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>Aalanttina shaaga kayeloon dubba shaaga kallayi firddaaminara, shaaga firdda gutii ataayinara.<verse eid="JAS 2:13"/></para>
  <para style="s1">Ammanona felo</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>Abbilaalttee, ibaaddoti koo ani ammano aba goɂame felo adi gowaate me laɂo aba? Hikka aankkikki ammano fayyiisin daanddaara? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>Abbi koo goorttun abba too kasarssataraan sarssina leere kaɂaamiraan babo waayigogireen, <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>Isin orrokko koo, «Nogoddaa seeyeen, arooɂambbollotteen, barara» goɂame, maarkkisowun ade kadootisaro gosisoon, me laɂo aba? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>Usumalee felo kallayikki ammano metekkeessawun kagoyeya.<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>Ayesuun goɂameen Ibaaddoti koo «Ati ammano abitta, ani felo aba» amara. Ammanokka felokko kaleyelidde tusi, aninna ammanokkee felooyi tusinara. <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>Ati «Waa koo girano» abddaatta; kaɂidankkiya, durisaalnna hikka abddatanan, abisiinna harɂanan.<verse eid="JAS 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20"/>Ati gowwakki ibaaddoti! Ammano felo kallayi laɂo kallayikki laano addeesin ato dootatta?<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">Laɂo kallayikki: kookkoo kahorkkoo mas'aafal «kagoye» mara.</char></note> <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>Aabbokkaani Abraame erekkeessa Yissaak'a banɂe tajaarsso gutii kakkokayere goorata kakkok'ullooyere felooyi lakkoyeya?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Met'. 22:1-14</ref>.</char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>Hikkaniinna ammano felonne wota felaa girano diyaatta, ammanona felooyi kaɂammagame lee. <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>«Abraame Waayi ammane, k'ulluukkina lee tootaame» kaɂamara mas'aafa k'ulluukkikokki haafura gudate, usuna Waa kageelaataro amame.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Met'. 15:6</ref>; <ref loc="2CH 20:7">2 Od. 20:7</ref>; <ref loc="ISA 41:8">Isa. 41:8</ref>.</char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>Goortta ammano kaalaalii halleenon feloɂoottessaayi goggok'ullooyero diyaattaan.<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>Usumaleenna tasharmut'aatte Raɂaabi ohandaareen k'op'attedde raa kakkaleenne goggoseerawun kakkoyeltte goorata feloɂoottiseeyi lakkok'ullooyitetteya?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">Iya. 2:1-21</ref>.</char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>Maar neefo kalli kagoyeya; usumaleenna ammano felo kallii kagoyeya.<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">Erreb ooratano</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>Abbilaalttee, isinkko kamooggan kaɂagaalssisaro aroolleenno, aalanttina oɂagaalssisanno olleenenna noo dubbakko taroortte firddii kaɂatayinanno kassaanwa. <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>Dubbana ayees kamoogganii handuddufatanna; ayeesii kahanduddufannon maayyona gogire usu maarkkeessa dubba oorayin kadanddaro likkiikki ibaaddotiya. <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>Faraddeel goggoɂajajaamiroon bit'aala munjetisooyi gotuyinsse, mankkogeelanne dubba geggeesin daanddaanna. <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>Goorttun markkafajjool diyaa, maamisii aaloo kanjjinkkina anbbal taɂatiiti kashafamaro golleenna markkafa kaduudara kic'c'arkki motooree mankkodootate geesara. <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>Usumaleenna erreb kic'c'arkki kamaaree mikita laa giraan kajinjjiin ayeesii koorara, gaa taɂatii eleen tic'c'artti misii gubitte baasatto shaada. <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>Erreb eleenya, kamaaree kifiliittaani orroo kagiro kameellan alamiya, maar dubba battoyisara, adena gahaanamekko tabeyaatto eleenii aani alattaankokki tiyaano gubara, metekkeesawunna tanbaanno eleenii gubayinnara. <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>Maamisikki giddi, kimbirjol usumaleenna ul gutii kaggitamaranna, beke orroo taggitta met't'a dubba ajajin daanddeera, ibaaddoyinna ajajaamera. <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>Ayesuun goɂameen erreb oorayin kadaanddaara maayyona laagiro, tallagadda marzzii kakkoɂammaganttetto foolssi kallayikki kameellan ayeesiya. <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>Errebkkaani Waa odokkaani galataanna, usu errebiinna middi tawaayi kamet't'aamero ibaaddo k'angaanna.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Met'. 1:26</ref>.</char></note> <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>Hiɂi tookko sommana k'anggona biyaaran; abbilaalttee, haa laano lakkodootisaro. <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>Fultto kookkoo beke omuc'c'imeenna ogorra biyaaran? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>Abbilaalttee, balasi ejjerssa, woyinniinna balasi dubamin daanddaara? Usumaleenna ogorra bekekko oɂonɂomootaraan bin lakkodaanddaaran.<verse eid="JAS 3:12"/></para>
  <para style="s1">Taɂuleenna tadaruuree k'arumma</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>Isin orrokko k'arookkina kashaadaro kalleera ibaaddoti ayyoyya? K'arummaanna idaneeyi ofelero feloɂootteessa girikkeessaa hattuse. <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>Ayesuun goɂameen taɂokokaatta gaabbina isi geelanjje wodanattisinii goggitte arookkooriten, rummi gutii t'ara arooɂayeesseen. <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>Hitta aanttitti k'arumma elekko lakkotto, ayesuun goɂameen alamikko, sookkona durrisakkotta. <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>Gaabbina isi geelatano takkogiraan ese banɂe shalagaamanona felo omeellan dubba giraan. <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>Daruurkko talleetetta k'arumma ade horaarjje tamuc'c'inttetta, esekkona nogodda tageelatto, taɂobssaatto, taɂidantti, shaagana il taɂidan takkoɂamaganttetto, ululisanona ifissaaddanati takkoginnontta. <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>Nogodda kageelaatara nogodda wut'atere tak'ullummaa il kukkuyisatara.<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">Alamikotti meellane aroogeelatten</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>Isin orroo kagira jereenna engge eetikko taɂemeetettotta? Isin orroo kaɂolamara halchchakkisinkko lakkoyoya? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>Kooko helayiin halchchaattan, ayesuun goɂameen lakkohelayinattaan; lagadattaan; aaloo halchchaattan, helayiinna lakkodaanddaattan. Iinsse inggaamattaan, jereen shafatattan, lakkoɂebaattan kadootattaan kooko lakkohelayinattaan. <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>Ebaayinnattan; ayesuun goɂameen lakkoɂatayinattan, kaɂebaattanna metekkisinuun geggeloo osooyeti k'oppaa kameellannee halchchaa mankkollee maraanya. <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>Osharmut'attan, alamine wota geelanjje kaatano Waanne wota diina laano lakkokassaanya? Haanssun alamine wota geelanjje kaayin kadootatara dubba diina kawaa laara. <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>Goorttun noo orroo Waa kabariisera ayyaana «Aaloo haɂusatara» amaa mas'aafa k'ulluukki kaɂayeesera adda kahesiro aani laara? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>Ayesuun goɂameen sino jiinase sisara, mas'aafa k'ulluukkinna, «Waa koorameessajjool diidara, fayyankkanɂi goɂameen sino sisara» kakkoonɂamera hikkanunya.<verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>Goortta isiɂoottisin Waawuun sisayeen, durrisana diidaa, isinkkona fakkimirowa. <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>Waa tos gabbalama, usuna isin tos gabbalamirowa. Isin c'ubbaalessaal genennoɂoottisin muc'c'isayeen, isin k'ofa lamaa haggattola ollaattan wodanattisin muc'c'isayeen. <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>C'annak'ama; gaddaa; ooyeen; osolkkisin oottan tos, geggeloɂoottisinna gadda tos haɂiggilssameen. <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>Goottaa horee isiɂoottisin yerasayeen, usuna isin t'ok'k'i t'ok'k'i isirowa.<verse eid="JAS 4:10"/></para>
  <para style="s1">Ibaaddo gutii aroofirdditeen</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>Abbilaalttee, isiɂisirroo aroohimatteen, abbikkeessa kahimataranna abbikkeessa gutiinna kafirddaara seera gutii tameellan ayeesara, seera gutiinna firddaara. Seera gutii gofirddite kafirddatto kuwaarre seera kaɂooratto lakkotto. <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>Seera kasisarana kafirddara Waa koo kaalaalya, usuna haasinna baasin kadanddaroya, ayesuun goɂameen ollaattaa gutii kafiddatta ati ayyotta?<verse eid="JAS 4:12"/></para>
  <para style="s1">Koora maraan kasisamero seerisano</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>Isin «Hittaari goorttun geebbari hitta goorttun aantti katamaa tos seeyinanna, eseenna gees koo adallaayinanna, daddalayinanna, worɂe helayinanna» oɂamattaan goortta maala. <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>Geebbari kalinnaro laakkasaan. Giriikkiin meya? Goorata kic'c'aruun mutere abbaabate kabaaro iyyootte aanittaan.<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">Mas. 27:1</ref>.</char></note> <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>Suurewa, «Tagootta feɂi golleete girinanna, hikka goorttun aankki felinanna» amano isinuun dootisara. <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>Gidda ade koorakkisinii dhaadaattan, hikka aankkikki koora dubba kameellanya.<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>Goorata kaɂidankki ayees felin addeesaa giraan kafeloon ibaaddo felanawaatti usuun c'ubbo laara.<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">Dureessajjolun kasisamero seerisano</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>Goortta isin dureessajjol maala, isin tagginnatto rakkoowun ooyeen, woo woo ama. <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>Durummattisin buuk'ittetta, sarssikkisinna k'ook'anna aamera. <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>Work'k'iikisinna maragadekkisin ododootera, ododootanonna isin gutii atotaara, sooɂoottisinna eleen aani aaminnara, kagachchoo geesun durumma kukkuyisattettaan.<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">Mat. 6:19</ref>.</char></note> <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>Wodanaa abayeen, irakkisini tagataa ohayeeran ofelataraawun hamuroon kagittan daamooza isin gutii iyyaara; otagataraankokki iyya dubba kadaanddaaro kalleero Goottakotti nebe tos geera.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">Ada. 24:14-15</ref>.</char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>Ul gutiinna taɂumanii burraak'aa gitteen, taɂenɂo arriin wodanattisin uɂurayisatteen. <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>Isin kaneebaannon k'ulluukki ibaaddoti gutii murtteesiteettan; lagaddeettan.<verse eid="JAS 5:6"/></para>
  <para style="s1">Rakkoo orroo obssaano</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>Goorata abbilaalttee, Goottaa taaɂemeeroo obssaa. Otate kabaraare erre il taɂidantti taasissoon misii obssaaro, kahoreenna kahaare idaamo misii oorataro shaada. <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>Isinna hikkamaleewa obssaa, wodanattisinna ataayissayeen, aalanttii tagootta emeeto gabbalanttetta.<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>Abbilaalttee; isiɂisirroo aroogunggumiten, goorttun isin gutii firddaamirowa, hikkima kafirddaara gooc'aa aalleera. <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>Abbilaalttee; mege kagoottayi kaɂayeesera hegerool rakkoo obssii atatanooyi masuussa laanokkisoo addeesa. <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>Adena obssii oɂataateeraan osommaasameen yelinne no katootanno kassanwa, Iyoobi misii obsseere ataatero maaltteettan; Goottana gudisanooyi kayelero deetettan. Goottaa aaloo kanenɂeeyisataronna shaaga kayelaroya.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">Iyo. 1:21-22</ref>; <ref loc="JOB 2:10">2:10</ref>; <ref loc="PSA 103:8">Mez. 103:8</ref>.</char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>Abbilaalttee; dubbaankko roore daruurii goorttun ul goorttun maamisikki ayeesinna gollee arooɂammatteen, «Ii» gollee ii halleewo, «Laa» gollee laa halleewo, goorttun murttesaminara.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Mat. 5:34-37</ref>.</char></note><verse eid="JAS 5:12"/></para>
  <para style="s1">Ammanokko kallee ebi</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>Isin orrokko rakkoo orroo kagira giro? Usu haɂebaate, kageggelaatera giro? Kagalata mazamuri hazammaro. <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>Isin orrokko kahawɂamera ibaaddoti gogiro? Min kawaakki jaarsolee haɂuumate, isona mege kagoottayi zayitii shigidi haɂebaateen.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">Mar. 6:13</ref>.</char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>Ammanokko kallee ebi kahawɂamero ibaaddoti fayyisara; Goottana keesara, c'ubbo feli gogirenna, haheso amamara. <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>Haanssun c'ubbokkisin isiɂisirroo beesayen; goggofayyitawunna koo kakkaleewun haɂebaate; k'ulluukki ibaaddotikokki ebi hunna aba, kaɂatii ayeesinna felara. <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>Eelaasa noo aankkikki ibaaddotiye; idaamo goggoɂubannonkko ataayise ebaate; ul gutiinna gees seendda minana idaamo lakkoɂubatero.<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Won. 17:1</ref>; <ref loc="1KI 18:1">18:1</ref>.</char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>Adena ebaate, idaamona daruurkko ubate; errenna il sissee.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 Won. 18:42-45</ref>.</char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>Abbilaalttee, isinkko koo rummikko goshirme kakkalee goɂabbaabe, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>hikka shaada; c'ubbaaleessa kakkoshirmero raakko kaɂabbaabara ibaaddo neefotteessa goyikko haasara, c'ubbo kamoogganna haheso amsisara.<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">Mas. 10:12</ref>; <ref loc="1PE 4:8">1 P'et. 4:8</ref>.</char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
