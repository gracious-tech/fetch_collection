<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Bayso New Testament</book>
  <para style="h">ያይቆባ</para>
  <para style="toc1">ሀንዳ ካያይቆባ</para>
  <para style="toc2">ያይቆባ</para>
  <para style="toc3">ያይ.</para>
  <para style="mt1">ሀንዳ ካያይቆባ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ሂክ ካያይቆባ ሀንዳ ባርሳኖ ኦህታርቴዉን ሴራ ታሌቶ ቆፋ ካአበሮ ጎሌሮ ካኮንጻፋመራና አላም ዱባይ ዳርኣንተ ታግቶ ቶሞንኮ ላማ ኣኒዉንየ፤ ጻፍትና ቃሩማ ፈሎይ ኖ ካኮሀይስናኖ ማላኮክ ጋራ፥ አማኒልኮክ ቆጳታኖና ያዳሊኮክ ሴራ ካሌሮ አየስ አዴስሰ ምስሊ ካአቦ አየስ ሮርሳራ። ህዩማኮክ ጋራና ዱሩማኮክ ጋራ፥ ጫፍቲኮክ ጋራ፥ አማላ ካእዳንኮክ ጋራ፥ ሀኡሳታኖኮክ ጋራ፥ አማኖኮክና ታኢዳን ያዳሊኮክ ጋራ፥ ህኢኮት ኢዳነና ሜላነኮክ ጋራ፥ ቃሩማኮክ ጋራ፥ እስእስኦሮ እስዲዳኖኮክ ጋራ፥ ኮራኮክና አንጅረኮክ ጋራ፥ ካካለ ጉት ፍርዳኖኮክ ጋራ፥ ዳታኖኮክ ጋራ ኦብስኮክና ኤብኮክ ጋራ፥ አማኒል ፈልን ካዶትሳሮ ዱባ ካለካለ ቤሰ ጻፈራ።</para>
  <para style="ip">ሂክ ሀንዳ አማኒልኮክ ግሪ አማኖ ፈሎይ ቱሳኖኮክ ጋራ ኣሎ አዴስሰ ቱሳራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="JAS 1:1">1፡1</ref> </char></para>
  <para style="io1">አማኖና ቃሩማ <char style="ior"><ref loc="JAS 1:2-8">1፡2-8</ref> </char></para>
  <para style="io1">ህዩማና ዱሩማ <char style="ior"><ref loc="JAS 1:9-11">1፡9-11</ref> </char></para>
  <para style="io1">ጫፍት <char style="ior"><ref loc="JAS 1:12-18">1፡12-18</ref> </char></para>
  <para style="io1">ሃፉራ ካዋ ማላኖና ፈሎይ ሀይሳኖ <char style="ior"><ref loc="JAS 1:19-27">1፡19-27</ref> </char></para>
  <para style="io1">ኡሉልስ ጎጎአዬሶንኮ ካስሳመሮ ሴራ <char style="ior"><ref loc="JAS 2:1-13">2፡1-13</ref> </char></para>
  <para style="io1">አማኖና ፈሎ <char style="ior"><ref loc="JAS 2:14-16">2፡14-16</ref> </char></para>
  <para style="io1">አማኒልና ህኢትሶ <char style="ior"><ref loc="JAS 3:1-18">3፡1-18</ref> </char></para>
  <para style="io1">አማኒልና ሂካ አላም <char style="ior"><ref loc="JAS 4:1-5:6">4፡1—5፡6</ref> </char></para>
  <para style="io1">ካለካለክ አዬስኮክ ጋራን ካስሳመሮ ጎርሳ <char style="ior"><ref loc="JAS 5:7-20">5፡7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ዋዉና ጎታ የሱሳ ክርስቶሳን ካሃንዳራ፥ ያይቆባ፥ አላም ዳርኣንቴን ኦግታን ኣኒ ቶሞንኮ ላማዉን፦</para>
  <para style="p" vid="JAS 1:1">ኖጎዳ እስኑን ሀሌቶ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13፡55</ref>፤ <ref loc="MRK 6:3">ማር. 6፡3</ref>፤ <ref loc="ACT 15:13">ኦፋ. ፈ. 15፡13</ref>፤ <ref loc="GAL 1:19">ጋላ. 1፡19</ref>።</char></note><verse eid="JAS 1:1"/></para>
  <para style="s1">ራኮ ኦሮ ካዶትሳሮ አማኖና ቃሩማ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>አቢላልቴ፥ ካለካለት ራኮ እስን ጎጌተ ኦአቲ ገጌሎ ኣን ቶታ፤ <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>ኣላንቲና አማኖክስንኮክ ጫፋማኖ ኦብስ ስሳኖ ካሳንዋ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ኮና ካኮንሀንቃኖን ቁሉኒዕና ካመን ዱባ ልኪኒዕና ኦአማጋንቴን ጎጎሌታኑን ኦብስ ፈሎኦትሴ ሀፈልቶ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>እስንኮ ማዮና ቃሩማ ጎሀንቅካተ፥ ሀቱፋኖን ዱባን አዳ. ካስሳሮ ዋ ሀኤባቶ፤ ኡሱና ስሳምሮዋ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>አየሱን ጎአመን ሀሄዳኖን አማኖ ሀኤባቶ፤ ኣላንቲና ካሄዳታራ እባዶ አንባል ካአኢሳቶና ካከያሮ ጋሽማሎ ካበከ አንያ። <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ሀሱ ኣንክክ እባዶት፥ ጎታኮ ኮኮ ኮ ሄላይናራ አም አሮሄዳኖ። <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>ኡሱ ቆፋ ላማ ካአባመና ራከሳ ዱባ ሀጋቶላ ካላልአማሮያ።<verse eid="JAS 1:8"/></para>
  <para style="s1">ህየሳክ እባዶትና ዱረሳክ እባዶት</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ባሪሳኖይ ካኮንየራተራን አቢ ዋ ጦቂ ማንኮኢሳሮ ማራን ሀገጌላቶ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ዱሩማ ታእባዶ ዳራራ ታኤሰ ኣን ማንኮኡባቶ ማራን ባሪሳኖይ ጦቂ ካአመ አቢ ዋ ባሪሳኖይ ጎየራሰና ሀገጌላተ። <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>አርት ጉባኖኮ ካከይ ፉርሳይ ኤስ አንጋግሳታ፤ ዳራራና ኡባታ፤ ምዲና ባታ፤ ኡሱማለና ዱረሳክ እባዶት ፈሎኦቴሳ ሀጋቶላ ራንካ ባራ።<note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">ኢሳ. 40፡6-7</ref>።</char></note><verse eid="JAS 1:11"/></para>
  <para style="s1">እባዶ ጉት ታግያቶ ጫፍቲ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ጫፍቲ ኦሮ ካአታታራ እባዶት ካሶማሳመያ፤ ኣላንትና ጫፍቲ ካኮዳንዴ ጎራታ ዋ ኦጌላታሮን ታስሰሮ አብዲ፥ ካግር ካላቻ ሄላይናራ።<verse eid="JAS 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13"/>ማዮና ጎጫፋመ፥ “ዋ እን ጫፌ” አሮኣሞ፤ ኣላንትና ዋ ሜላነይ ላኮጫፋማሮ፤ ኡሱ አደ ማዮና ላኮጫፋሮ። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>አየሱን ጎአመን መተመተይ እባዶ ካኮጫፋማራ ካሜላነ ሀልቻኬሳ ጎቦጃምሮና ጎሶባምሮያ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ሀልቻና ካኮጂናሮ ጎራታ ጩቦ ኡሙላራ፥ ጩቦና ካኮጂናተ ጎራታ ጎይ ኡሙላራ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ኦጌላንቴን አቢላልቴ፥ አሮሶባንቴን። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ካእዳን እላቦና ዱዶኒዕ ሶማ ዱባ ዋኮያን፤ ህክና ካኤመታራ ሆስንደ ኣን ማራሙራ ጎርቱን ኢግልሳማ ካኮግኖን ካኢፋ ኦዶ ዋኮያ። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ዋ ኖ መጣ ዱባኮ ኦሆሬ ጎጎሌኖን ፈኢቴሳ ካሩም ሃፉራ ኖ ኡሙለ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ካማሌን ፈሎ ጉት ሀይሳኖ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ኦጌላንቴን አቢላልቴ! ሂካ ሻዳ፤ እባዶ ዱባ ማልን ካጀጀሬ፥ አዬስን ካእስላተ፥ ኢኦኮና ካኦብሴ ሀሌዎ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>እኦ ኦእባዶ ቁሉማ ታዋ ላኮኬናራን። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ሃንሱን ባቶዋኖና ሜላነኮክ ጂናን ትራየንዴነ ኔፎትስን ፋይስን ካዳንዳሮ፥ ዎዳናታትስን ካባተሮ ሃፉራ ኢዳነ አታዬን።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ሃፉራኬሳ ካአማሮ ፈላ ኳሬ ካማላሮ ካላ ልዴነ እስኦትስን አሮሶባቴን። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ሃፉራኬሳ ካማላራ፥ አየሱን ጎአመን ካአማሮ ካኦራኖን እባዶት በቤድቴሳ ዳዉኢቲ ካድያታሮ እባዶ አንያ። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>እስኦቴሳና ድያተ ሴታራ፥ ጎርሰዋ መ ኣን ላሮ ኢሎታራ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>አየሱን ጎአመን ባልቹማ ካቤሳሮ ልክኪ ሴራ ዴረ ካአታታራ፥ ካማለሮ ካፈላራና ካኢሎኖ እባዶ ፈሎኦቴሳ ካሶማሳመ ላራ።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ህኢቴሳ ሀኦራኖን፥ ዎዳናቴሳ ሽርሳታ አማኖ አባ ካአማራ እባዶት፥ እስኦቴሳ ሶባታራ፥ አማኖኬሳኮኒዕ ፈሎና ላኦ ካላይኒዕያን። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ዋ ኦዶይ ሆረ ካሙጭመና ሜላነ ካላይክ አማኖ ሂካያ፤ ኦዶና ኣና ኦኮንጎየራን ይንሳ ኤንተርጆል ካኮንጎየሮ ሄለል ራኮትሶይ ጋርጋራኖና አላምኮክ ባትናትኮ እስ ኦራታኖያ።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">ህየሳ ቱፋታኖ ካዶትሶን ላኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>አቢላልቴ፥ ካባጃ ካሌሮ ጎታካን የሱሳ ክርስቶሳ ኦአማናታን ማንኮሌተን ማራን አሮኡሉልሰ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ታዎርቂ ፍራንታ ካካተረና ካእዳንክ ሳርስ ካሳርሳተረ እባዶት ታአማኒል ሀጋና ቶስ ካኮታበ ጎራታ ኡሱማለና ጦርቀ ካኣተ ሳርስ ካሳርሳተራ ህየሳክ እባዶ ጎታበ፥ <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ካእዳንክ ሳርስ ካሳርሳቴን ካለት ካባጃ ቱሳ፥ “ኩዬን ካዶትሳራ ካእዳንክ ባርጩማ ሂክማ” ጎአንቴን ህየሳትነ አድ፥ “አት ሀሴ አሊ” ጎርቱን ሉክቴ ሄገሊ “ሀማጺ” ጎአንቴን፥ <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>እስን ኦሮ ኡሉልሳኖ ላኮዮያ? አደና ቆፋ ታሜላን ኦአባንቴታና ኦፍርዳታን ላኖ ላኮዮያ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ኦጌላንቴታን አቢላልቴ፥ ማላ፥ ዋ አማኖ ዱረሳ ጎጎሌናዉና ኡሱ ኦጌላታራዉን አብዲ ካስሳመሮ ዎኖናት ጎጎኤላዉን ሂካ አላምክ ህየሳል ላኮአሳበሮያ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>እስን አዴን ህየሳል የራሴን፤ እስን ኦጫናቅሳራን ዱሬሳል ላኮዬንያ? ምን ካፍርዲ ቶስ እስን ኦጌሳራን ላ እሶያና? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>እስኒ ካኡማመሮ ካባጃ ካሌሮ መገ ኦኢንጋማራን ላኮኢሶያንያ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>ማጻፋይ ቁሉክ፥ “ኦላታ እስኦታ ማለ የላ ጌላ” አማመ ካጻፋመሮ ሴራ ካዋ ጎኦራቴን ታኢዳን ፈላግታን።<note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዎዩ. 19፡18</ref>።</char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ጎኡሉልሴን አድ ጩቦ ፈላግታን፥ ሴራ ሆረና ሴራ ካባሳሮ ኣን ቶታማታን።<verse eid="JAS 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 2:10"/>ኣላንቲና ሴራ ዱባ ካኦራታራ አየሱን ጎአመን ሴራ ኮይ ካሀንዱዱፋታራ ጎግረ፥ ዱባና ባሳኖ አን ቶታማራ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>“አሮሻርሙጢተ” ካአመራ ጎታ ኡሱማለና “አሮላጋደና” አመራ። ጎሻርሙጣናዋተ፥ አየሱን ጎአመን ጎላጋደ፥ ሴራ ካባሳቶ ሌተታ።<note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ብያ. 20፡13-14</ref>፤ <ref loc="DEU 5:17-18">አዳ. 5፡17-18</ref>።</char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>አዬሳና ሌረ ፈላታ ጎግቴን ባልቹማ ካስሳሮ ሴራ ሆረ ካፍርዳሮ እባዶ ኣን ሌን። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>ኣላንቲና ሻጋ ካየሎን ዱባ ሻጋ ካላይ ፍርዳምናራ፥ ሻጋ ፍርዳ ጉት አታይናራ።<verse eid="JAS 2:13"/></para>
  <para style="s1">አማኖና ፈሎ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>አቢላልቴ፥ እባዶት ኮ አን አማኖ አባ ጎአመ ፈሎ አድ ጎዋተ መ ላኦ አባ? ሂካ ኣንክክ አማኖ ፋይስን ዳንዳራ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>አቢ ኮ ጎርቱን አባ ቶ ካሳርሳታራን ሳርስና ሌረ ካአምራን ባቦ ዋይጎግሬን፥ <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>እስን ኦሮኮ ኮ፥ “ኖጎዳ ሴዬን፥ አሮአምቦሎቴን፥ ባራራ” ጎአመ፥ ማርክሶዉን አደ ካዶትሳሮ ጎስሶን፥ መ ላኦ አባ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ኡሱማሌ ፈሎ ካላይክ አማኖ መተኬሳዉን ካጎየያ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>አየሱን ጎአመን እባዶት ኮ “አት አማኖ አብታ፥ አን ፈሎ አባ” አማራ። አማኖካ ፈሎኮ ካለየልደ ቱስ፥ አንና አማኖኬ ፈሎይ ቱስናራ። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>አት “ዋ ኮ ግራኖ” አብዳታ፤ ካእዳንክያ፥ ዱርሳልና ሂካ አብዳታናን፥ አብሲና ሀራኣናን።<verse eid="JAS 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20"/>አት ጎዋክ እባዶት! አማኖ ፈሎ ካላይ ላኦ ካላይክ ላኖ አዴስን አቶ ዶታታ?<note caller="+" style="f"><char style="fr" closed="false">2፡20 </char><char style="ft" closed="false">ላኦ ካላይክ፦ ኮኮ ካሆርኮ ማጻፋል ካጎየ ማራ።</char></note> <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ኣቦካን አብራመ ኤረኬሳ ይሳቃ ባንኤ ታጃርሶ ጉት ካኮካየረ ጎራታ ካኮቁሎየረ ፈሎይ ላኮየያ?<note caller="-" style="x"><char style="xo" closed="false">2፡21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">መጣ 22፡1-14</ref>።</char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ሂካኒና አማኖ ፈሎኔ ዎታ ፈላ ግራኖ ድያታ፥ አማኖና ፈሎይ ካአማጋመ ሌ። <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>“አብራመ ዋይ አማነ፥ ቁሉክና ሌ ቶታመ” ካአማራ ማጻፋ ቁሉክኮክ ሃፉራ ጉዳተ፥ ኡሱና ዋ ካጌላታሮ አማመ።<note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መጣ 15፡6</ref>፤ <ref loc="2CH 20:7">2 ኦዱ 20፡7</ref>፤ <ref loc="ISA 41:8">ኢሳ. 41፡8</ref>።</char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ጎርታ አማኖ ካላሊ ሀሌኖን ፈሎኦቴሳይ ጎጎቁሎየሮ ድያታን።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ኡሱማለና ታሻርሙጣተ ራአብ ኦሀንዳረን ቆጳተደ ራ ካካለኔ ጎጎሴራዉን ካኮየልተ ጎራታ ፈሎኦትሴይ ላኮቁሎይተቴያ?<note caller="-" style="x"><char style="xo" closed="false">2፡25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያ. 2፡1-21</ref>።</char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>ማር ኔፎ ካሊ ካጎየያ፤ ኡሱማለና አማኖ ፈሎ ካሊ ካጎየያ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">ኤሬብ ኦራታኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>አቢላልቴ፥ እስንኮ ካሞጋን ካአጋልስሳሮ አሮሌኖ፥ ኣላንቲና ኦአጋልስሳኖ ኦሌነና ኖ ዱባኮ ታሮርተ ፍርዲ ካአታይናኖ ካሳንዋ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ዱባና አየስ ካሞጋኒ ሀንዱዱፋታና፤ አዬሲ ካሀንዱዱፋኖን ማዮና ጎግረ ኡሱ ማርኬሳ ዱባ ኦራይን ካዳንዳሮ ልክኪ እባዶትያ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፋራዴል ጎጎአጃጃምሮን ብጣላ ሙንጀትሶይ ጎቱይንሰ፥ ማንኮጌላነ ዱባ ገጌስን ዳንዳና። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ጎርቱን ማርካፋጆል ዲያ፥ ማምሲ ኣሎ ካንጅንክና አንባል ታአቲት ካሻፋማሮ ጎሌና ማርካፋ ካዱዳራ ክጫርክ ሞቶሬ ማንኮዶታተ ጌሳራ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ኡሱማለና ኤሬብ ክጫርክ ካማሬ ምክታ ላ ግራን ካጅንጂን አዬሲ ኮራራ፥ ጋ ታአቲ ኤለን ትጫርት ምሲ ጉብተ ባሳቶ ሻዳ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>ኤሬብ ኤሌንያ፥ ካማሬ ክፍሊታን ኦሮ ካግሮ ካሜላን አላምያ፥ ማር ዱባ ባቶይሳራ፥ አደና ጋሃናመኮ ታበያቶ ኤለኒ አን አላታንኮክ ትያኖ ጉባራ፥ መተኬሳዉና ታንባኖ ኤለኒ ጉባይናራ። <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>ማምስክ ግድ፥ ክምብርጆል ኡሱማለና ኡል ጉት ካግታማራና፥ በከ ኦሮ ታግታ መጣ ዱባ አጃጅን ዳንዴራ፥ እባዶይና አጃጃመራ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>አየሱን ጎአመን ኤሬብ ኦራይን ካዳንዳራ ማዮና ላግሮ፥ ታላጋዳ ማርዚ ካኮአማጋንተቶ ፎልሲ ካላይክ ካሜላን አዬስያ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ኤሬብካን ዋ ኦዶካን ጋላታና፥ ኡሱ ኤሬብና ምዲ ታዋይ ካመጣመሮ እባዶ ቃንጋና።<note caller="-" style="x"><char style="xo" closed="false">3፡9 </char><char style="xt" closed="false"><ref loc="GEN 1:26">መጣ 1፡26</ref>።</char></note> <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ህኢ ቶኮ ሶማና ቃንጎና ብያራን፤ አቢላልቴ፥ ሃ ላኖ ላኮዶትሳሮ። <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ፉልቶ ኮኮ በከ ኦሙጭሜና ኦጎራ ብያራን? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>አቢላልቴ፥ ባላስ ኤጀርሳ፥ ዎይኒና ባላስ ዱባምን ዳንዳራ? ኡሱማለና ኦጎራ በከኮ ኦኦኖሞታራን ብን ላኮዳንዳራን።<verse eid="JAS 3:12"/></para>
  <para style="s1">ታኡሌና ታዳሩረ ቃሩማ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>እስን ኦሮኮ ቃሮክና ካሻዳሮ ካሌራ እባዶት አዮያ? ቃሩማና ኢዳነይ ኦፈለሮ ፈሎኦቴሳ ግርኬሳ ሀቱሰ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>አየሱን ጎአመን ታኦኮካታ ጋቢና እስ ጌላንጀ ዎዳናትስኒ ጎግቴ አሮኮርተን፥ ሩም ጉት ጣራ አሮአዬሴን። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ህታ ኣንትት ቃሩማ ኤለኮ ላኮቶ፥ አየሱን ጎአመን አላምኮ፥ ሶኮና ዱርሳኮታ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ጋቢና እስ ጌላታኖ ታኮግራን ኤሰ ባንኤ ሻላጋማኖና ፈሎ ኦሜላን ዱባ ግራን። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>ዳሩርኮ ታሌተታ ቃሩማ አደ ሆራርጀ ታሙጭንተታ፥ ኤሰኮና ኖጎዳ ታጌላቶ፥ ታኦብሳቶ፥ ታኢዳንት፥ ሻጋና ኢል ታኢዳን ታኮአማጋንተቶ፥ ኡሉልሳኖና ኢፍሳዳናት ታኮግኖንታ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ኖጎዳ ካጌላታራ ኖጎዳ ዉጣተረ ታቁሉማ ኢል ኩኩይሳታራ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">አላምኮት ሜላነ አሮጌላተን</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>እስን ኦሮ ካግራ ጀሬና ኤንገ ኤትኮ ታኤሜተቶታ? እስን ኦሮ ካኦላማራ ሀልቻክስንኮ ላኮዮያ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ኮኮ ሄላይን ሀልቻታን፥ አየሱን ጎአመን ላኮሄላይናታን፤ ላጋዳታን፤ ኣሎ ሀልቻታን፥ ሄላይና ላኮዳንዳታን። ኢንሰ ኢንጋማታን፥ ጀሬን ሻፋታታን፥ ላኮኤባታን ካዶታታን ኮኮ ላኮሄላይናታን። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ኤባይናታን፤ አየሱን ጎአመን ላኮአታይናታን፥ ካኤባታና መተክስኑን ገጌሎ ኦሶየት ቆፓ ካሜላነ ሀልቻ ማንኮሌ ማራንያ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>ኦሻርሙጣታን፥ አላምነ ዎታ ጌላንጀ ካታኖ ዋኔ ዎታ ዲና ላኖ ላኮካሳንያ? ሃንሱን አላምነ ዎታ ጌላንጀ ካይን ካዶታታራ ዱባ ዲና ካዋ ላራ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ጎርቱን ኖ ኦሮ ዋ ካባሪሰራ አያና “ኣሎ ሀኡሳታራ” አማ ማጻፋ ቁሉክ ካአዬሰራ አዳ. ካሄስሮ ኣን ላራ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>አየሱን ጎአመን ስኖ ጂናሰ ስሳራ፥ ማጻፋ ቁሉክና፥ “ዋ ኮራሜሳጆል ዲዳራ፥ ፋያንካኒዕ ጎአመን ስኖ ስሳራ” ካኮንአመራ ሂካኑንያ።<verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ጎርታ እስኦትስን ዋዉን ስሳዬን፥ ዱርሳና ዲዳ፥ እስንኮና ፋክምሮዋ። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ዋ ቶስ ጋባላማ፥ ኡሱና እስን ቶስ ጋባላምሮዋ። እስን ጩባለሳል ገነኖኦትስን ሙጭሳዬን፥ እስን ቆፋ ላማ ሀጋቶላ ኦላታን ዎዳናትስን ሙጭሳዬን። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ጫናቃማ፤ ጋዳ፤ ኦዬን፤ ኦሶልክስን ኦታን ቶስ፥ ገጌሎኦትስና ጋዳ ቶስ ሀኢግልሳሜን። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ጎታ ሆረ እስኦትስን የራሳዬን፥ ኡሱና እስን ጦቂ ጦቂ እስሮዋ።<verse eid="JAS 4:10"/></para>
  <para style="s1">እባዶ ጉት አሮፍርድቴን</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>አቢላልቴ፥ እስእስኦሮ አሮህማቴን፥ አቢኬሳ ካህማታራና አቢኬሳ ጉቲና ካፍርዳራ ሴራ ጉት ታሜላን አዬሳራ፥ ሴራ ጉቲና ፍርዳራ። ሴራ ጉት ጎፍርድተ ካፍርዳቶ ኳሬ ሴራ ካኦራቶ ላኮቶ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ሴራ ካስሳራና ካፍርዳራ ዋ ኮ ካላልያ፥ ኡሱና ሃስና ባስን ካዳንዳሮያ፥ አየሱን ጎአመን ኦላታ ጉት ካፍዳታ አት አዮታ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ኮራ ማራን ካስሳመሮ ሴርሳኖ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>እስን “ህታር ጎርቱን ጌባር ህታ ጎርቱን አንት ካታማ ቶስ ሴይናና፥ ኤሴና ጌስ ኮ አዳላይናና፥ ዳዳላይናና፥ ዎረኤ ሄላይናና” ኦአማታን ጎርታ ማላ። <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ጌባር ካልናሮ ላካሳን። ግሪኪን መያ? ጎራታ ክጫሩን ሙተረ አባባተ ካባሮ ኢዮተ አንታን።<note caller="-" style="x"><char style="xo" closed="false">4፡14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">ማሱ. 27፡1</ref>።</char></note> <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ሱረዋ፥ “ታጎታ ፈኢ ጎሌተ ግርናና፥ ሂካ ጎርቱን ኣንክ ፈልናና” አማኖ እስኑን ዶትሳራ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ግዳ አደ ኮራክስኒ ዳታን፥ ሂካ ኣንክክ ኮራ ዱባ ካሜላንያ።<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>ጎራታ ካእዳንክ አየስ ፈልን አዴሳ ግራን ካፈሎን እባዶ ፈላናዋት ኡሱን ጩቦ ላራ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ዱሬሳጆሉን ካስሳመሮ ሴርሳኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ጎርታ እስን ዱሬሳጆል ማላ፥ እስን ታግናቶ ራኮዉን ኦዬን፥ ዎ ዎ አማ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ዱሩማትስን ቡቅተታ፥ ሳርስክስና ቆቃና ኣመራ። <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ዎርቂክስና ማራጋደክስን ኦዶዶተራ፥ ኦዶዶታኖና እስን ጉት አቶታራ፥ ሶኦትስና ኤለን ኣን ኣምናራ፥ ካጋቾ ጌሱን ዱሩማ ኩኩይሳተታን።<note caller="-" style="x"><char style="xo" closed="false">5፡3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">ማቶ. 6፡19</ref>።</char></note> <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ዎዳና አባዬን፥ ኢራክስን ታጋታ ኦሀዬራን ኦፈላታራዉን ሀሙሮን ካግታን ዳሞዛ እስን ጉት ኢያራ፤ ኦታጋታራንኮክ እያ ዱባ ካዳንዳሮ ካሌሮ ጎታኮት ነበ ቶስ ጌራ።<note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">አዳ. 24፡14-15</ref>።</char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>ኡል ጉቲና ታኡማኒ ቡራቃ ግቴን፥ ታኤኖኦ አሪን ዎዳናትስን ኡኡራይሳቴን። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>እስን ካኔባኖን ቁሉክ እባዶት ጉት ሙርቴስቴታን፤ ላጋዴታን።<verse eid="JAS 5:6"/></para>
  <para style="s1">ራኮ ኦሮ ኦብሳኖ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ጎራታ አቢላልቴ፥ ጎታ ታኤሜሮ ኦብሳ። ኦታተ ካባራረ ኤሬ ኢል ታኢዳንት ታስሶን ምሲ ኦብሳሮ፥ ካሆሬና ካሃረ ኢዳሞ ምሲ ኦራታሮ ሻዳ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>እስና ሂካማሌዋ ኦብሳ፥ ዎዳናትስና አታይሳዬን፥ ኣላንቲ ታጎታ ኤመቶ ጋባላንተታ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>አቢላልቴ፤ እስእስኦሮ አሮጉንጉምተን፥ ጎርቱን እስን ጉት ፍርዳምሮዋ፥ ሂክማ ካፍርዳራ ጎጫ አሌራ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>አቢላልቴ፤ መገ ካጎታይ ካአዬሰራ ሄገሮል ራኮ ኦብሲ አታታኖይ ማሱሳ ላኖክሶ አዴሳ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>አደና ኦብሲ ኦአታቴራን ኦሶማሳሜን የልነ ኖ ካቶታኖ ካሳንዋ፥ ኢዮብ ምሲ ኦብሴረ አታተሮ ማልቴታን፤ ጎታና ጉድሳኖይ ካየለሮ ዴተታን። ጎታ ኣሎ ካነኔኤይሳታሮና ሻጋ ካየላሮያ።<note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">ኢዮ. 1፡21-22</ref>፤ <ref loc="JOB 2:10">2፡10</ref>፤ <ref loc="PSA 103:8">ማዛ. 103፡8</ref>።</char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>አቢላልቴ፤ ዱባንኮ ሮረ ዳሩሪ ጎርቱን ኡል ጎርቱን ማምስክ አዬስና ጎሌ አሮአማቴን፥ “እ” ጎሌ እ ሀሌዎ፥ “ላ” ጎሌ ላ ሀሌዎ፥ ጎርቱን ሙርተሳምናራ።<note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ. 5፡34-37</ref>።</char></note><verse eid="JAS 5:12"/></para>
  <para style="s1">አማኖኮ ካሌ ኤብ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>እስን ኦሮኮ ራኮ ኦሮ ካግራ ግሮ? ኡሱ ሀኤባተ፥ ካገገላተራ ግሮ? ካጋላታ ማዛሙር ሀዛማሮ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>እስን ኦሮኮ ካሀዉአመራ እባዶት ጎግሮ? ምን ካዋክ ጃርሶለ ሀኡማተ፥ እሶና መገ ካጎታይ ዛይቲ ሽግድ ሀኤባተን።<note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">ማር. 6፡13</ref>።</char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>አማኖኮ ካሌ ኤብ ካሀዉአመሮ እባዶት ፋይሳራ፤ ጎታና ኬሳራ፥ ጩቦ ፈል ጎግረና፥ ሀሄሶ አማማራ። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ሃንሱን ጩቦክስን እስእስኦሮ ቤሳየን፤ ጎጎፋይታዉና ኮ ካካለዉን ሀኤባተ፤ ቁሉክ እባዶትኮክ ኤብ ሁና አባ፥ ካአቲ አዬስና ፈላራ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኤላሳ ኖ ኣንክክ እባዶትየ፤ ኢዳሞ ጎጎኡባኖንኮ አታይሰ ኤባተ፤ ኡል ጉቲና ጌስ ሴንዳ ምናና ኢዳሞ ላኮኡባተሮ።<note caller="-" style="x"><char style="xo" closed="false">5፡17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ዎኖ. 17፡1</ref>፤ <ref loc="1KI 18:1">18፡1</ref>።</char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>አደና ኤባተ፥ ኢዳሞና ዳሩርኮ ኡባተ፤ ኤሬና ኢል ስሴ።<note caller="-" style="x"><char style="xo" closed="false">5፡18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 ዎኖ. 18፡42-45</ref>።</char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>አቢላልቴ፥ እስንኮ ኮ ሩምኮ ጎሽርመ ካካለ ጎአባበ፥ <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ሂካ ሻዳ፤ ጩባለሳ ካኮሽርመሮ ራኮ ካአባባራ እባዶ ኔፎቴሳ ጎይኮ ሃሳራ፥ ጩቦ ካሞጋና ሀሄሶ አምስሳራ።<note caller="-" style="x"><char style="xo" closed="false">5፡20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ማሱ. 10፡12</ref>፤ <ref loc="1PE 4:8">1 ጴጢ. 4፡8</ref>።</char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
