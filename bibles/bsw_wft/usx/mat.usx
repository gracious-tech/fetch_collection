<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Bayso New Testament</book>
  <para style="h">ማቶሳ</para>
  <para style="toc1">ማቶሳ ካጻፈሮ ጎታካንክ ካየሱሳ ክርስቶሳ ዎንጋላ</para>
  <para style="toc2">ማቶሳ</para>
  <para style="toc3">ማቶ.</para>
  <para style="mt1">ማቶሳ ካጻፈሮ</para>
  <para style="mt2">ጎታካንክ ካየሱሳ ክርስቶሳ ዎንጋላ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ካማቶሳ ዎንጋላ፥ ታየሱሳ ኤሜቶኮት አብድ ጣየ ካሰጋመራ ኡሱ ካፋይሳሮ ላኖና ዋ አማቶ ኦጣዎይ ጎሳኬሳን ካስሰሮ ካአብዲ ሃፉራ ካኮፈለራ ጋራኬሳነ ላኖ ካሰጋሮ ካገጌሎ ሃፉራያ። ሂክ ካገጌሎ ሃፉራና የሱሳ እሶ ኦሮ አላተረ ካኮጂናተሮ አይሁድ ካላሉን አንሌኖን ግራን አላም ዱባዉና አደረያ።</para>
  <para style="ip">ካማቶሳ ዎንጋላ ኢደ ድያመ ካኤካተሮ ማጻፋያ፤ ታየሱሳ አላታንኮ ሀጋአበረ ጣማቃማኖኬሳኮክ ጋራና ጫፋማኖኬሳኮክ ጋራ ሰሰጌ አባባተረ ጋሊላይ ኡሱ ካላላበሮ ላላባኖ፥ አጋልስሳኖና ፋይሳኖኮክ ሀንዳኖ ሰሰጋራ። ሀሱኮ አባባተረ አደ የሱሳ ካጋሊላ ኡልኮ ኢየሩሳለምኮት ካታማ ቶስ ታሰሴተሮ ሰሴታና ሂካ አላም ካኮአዳላተሮ ጌስኮክ ካጋቾ አልማይ ካሌሮ አየስ ሰሰጋራ፤ ሂክ አዬንሳ ሱዋማኖኬሳ፥ ጎይኬሳና ጎይኮ ከያኖኬሳ ዎታ ራቶ አባራ።</para>
  <para style="ip">ሂክ ዎንጋላ የሱሳ ሴራ ካዋ ፉሬን ስስን ኦዶናት ካአቦ ላኖና ዎኖናት ካዋኮክ ጋራ ካአጋልስሳሮ ካንጅንክ የለ ቱሳራ። አጋልስስኬሳኮ ጋማ ካሆር ራ ካሞጋኒ ካኤካተራ ባንኤ ከኒ ቶታማራ፤</para>
  <para style="ip">1. ዎኖናት ካዋክ እባዶኮት ያዳሊ፥ ፈሎ፥ ፈኢ፥ ሁኖምና ታጋቾ ኢጣ ካአጋልስሳሮ ካዎዳሚ ላላባኖ፥ (ፎልሲ 5-7)</para>
  <para style="ip">2. ቶሞንኮ ላማ የሱሳኮ ኦአጋልሳታረን ካዎንጋላ ላላባኖን ካኮፋራማሬን ጎራታ እሶን ካስሳመረ ሴራል፥ (ፎልሲ 10)</para>
  <para style="ip">3. ዎኖናት ካዋኮክ ጋራን ካሰጋመሮ ካለካለክ ማሱሳጆል፤ (ፎልሲ 13)</para>
  <para style="ip">4. የሱሳኮ ኦአጋልሳታራን ላኖኮት ፉሬን ካሰጋራ አጋልስስ፥ (ፎልሲ 18)</para>
  <para style="ip">5. ጌስ ካግዳኔኮት ጋቾና ዎኖናት ካዋ ኤሜቶኮክ ጋራን ካስሳመሮ አጋልስስ፤ (ፎልሲ 24-25)</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ካየሱሳ ክርስቶሳኮክ ካሳን ህዲድና አላታን <char style="ior"><ref loc="MAT 1:1-2:23">1፡1—2፡23</ref> </char></para>
  <para style="io1">ካጣማቃሮ ያንሳኮክ ሀንዳኖ <char style="ior"><ref loc="MAT 3:1-12">3፡1-12</ref> </char></para>
  <para style="io1">ካየሱሳ ጣማቃማኖና ጫፋማኖ <char style="ior"><ref loc="MAT 3:13-4:11">3፡13—4፡11</ref> </char></para>
  <para style="io1">የሱሳ ፈሎኦቴሳ ጋሊላይ ሀጋአባኖ <char style="ior"><ref loc="MAT 4:12-18:35">4፡12—18፡35</ref> </char></para>
  <para style="io1">ጋሊላኮ ኢየሩሳለም ቶስ <char style="ior"><ref loc="MAT 19:1-20:34">19፡1—20፡34</ref> </char></para>
  <para style="io1">ካጋቾ አልማይ ኢየሩሳለምና ጎቦቢ <char style="ior"><ref loc="MAT 21:1-27:66">21፡1—27፡66</ref> </char></para>
  <para style="io1">ጎታካንክ ጎይኮ ክያኖና ኡሱኮ ኦአጋልሳታራዉን ሙታኖ <char style="ior"><ref loc="MAT 28:1-20">28፡1-20</ref> </char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">ካየሱሳ ክርስቶሳ አላታንኮክ ህዲድ</para>
  <para style="r">(<ref loc="MAT 1:1-17">ማቶ. 1፡1-17</ref>፤ <ref loc="LUK 3:23-38">ሉቃ. 3፡23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />ታዳዉተና ካአብራመ ሳኒ ካሌሮ ካየሱሳ ክርስቶሳ አላታንኮክ ህዲድ ሃያ፤ <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />አብራመ ይሳቃ ኡሙለ፥ ይሳቃ ያይቆባ ኡሙለ፥ ያይቆባ ይሁዳና አቢላል ኡሙለ፥ <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />ይሁዳና ትኢማርኮ ፋረስና ዛራ ኡሙለ፥ ፋረስ ኤስሮም ኡሙለ፥ ኤስሮምና አራም ኡሙለ፥ <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />አራምና አምናዳብ ኡሙለ፥ አምናዳብና ነአሶን ኡሙለ፥ ነአሶንና ሰለሞን ኡሙለ፥ <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />ሰልሞንና ረአብኮ ቦኤዝ ኡሙለ፥ ቦኤዝና ሩትኮ ኢዮበድ ኡሙለ፥ ኢዮብድና እሰይ ኡሙለ፥ <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />እሰይ ዎኖ ዳዉተ ኡሙለ፥<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="RUT 4:18-22">ሩት 4፡18-22</ref>፤ <ref loc="1CH 2:13-15">1 ኦዱ 2፡13-15</ref>።</char></note> ዳዉተና ታኦርዮ ኦርኮ ሶሎሞን ኡሙለ፥ <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />ሶሎሞንና ሮብአም ኡሙለ፥ ሮብአምና አብያ ኡሙለ፥ አብያና አሳፍ ኡሙለ፥ <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />አሳፍና ኢዮሳፍጢ ኡሙለ፥ ኢዮሳፍጢና ኢዮሆራም ኡሙለ፥ ኢዮሆራምና ኦዝያን ኡሙለ፥ <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />ኦዝያንና ኢዮአታም ኡሙለ፥ ኢዮአታምና አካዝ ኡሙለ፥ አካዝ ሕዝቅያሳ ኡሙለ፥ <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />ሕዝቅያሳ ምናሰ ኡሙለ፥ ምናሰ አሞጽ ኡሙለ፥ አሞጽና እዮስያስ ኡሙለ፥ <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />እዮስያስ ጎሳ ካእስራኤል ባብሎን ቶስ ካኮቦጃመረ ጎራታ እኮንያንና አቢላል ኡሙለ።<note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 ዎኖ. 24፡14-15</ref>፤ <ref loc="2CH 36:10">2 ኦዱ 36፡10</ref>፤ <ref loc="JER 27:20">ኤር. 27፡20</ref>።</char></note><verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />ካባብሎን ቦጃማኖኮ አባባተረ እኮንያን ሰላትያል ኡሙለ፥ ሰላትያንና ዙርባቤላ ኡሙለ፥ <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />ዙርባቤላ አብዩድ ኡሙለ፥ አብዩድና ኤልያቀም ኡሙለ፥ ኤልያቀምና አዛር ኡሙለ፥ <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />አዛር ሳዶቅ ኡሙለ፥ ሳዶቅ አኪም ኡሙለ፥ አኪምና ኤልዩድ ኡሙለ፥ <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />ኤልዩድ አላዛር ኡሙለ፥ አላዛር ማታን ኡሙለ፥ ማታን ያይቆባ ኡሙለ፥ <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />ያይቆባ ዮሴፋ ኡሙለ፥ ዮሴፋና ካፋይሳሮ ክርስቶሳ የሱሳኮት አዬ ማይራመ ካኤራተሮየ።<note caller="+" style="f"><char style="fr" closed="false">1፡16 </char><char style="fqa" closed="false">መስህ፦ </char><char style="ft" closed="false">ክርስቶሳ አማኖ መስህ ጎርቱን ካሽግዳመ አማኖያ። </char></note><verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />ጎርታ አብራመኮ ታ ዳዉተ ጌሮን አላታን ቶሞንኮ አፋርታ፥ ዳዉተኮ ታ ካባብሎን ቦጃማኖ ጌሮን አላታን ቶሞንኮ አፋርታ፤ ካባብሎን ቦጃኖኮ ታ ታክርስቶሳ አላታን ጌግን ቶሞንኮ አፋር አላታንታ።<verse eid="MAT 1:17" /></para>
  <para style="s1">አላታን ታየሱሳ ክርስቶሳ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶ. 1፡18-25</ref>፤ <ref loc="LUK 2:1-7">ሉቃ. 2፡1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />ታየሱሳ ክርስቶሳ አላታንኮት ጅርት ሂካማሌታ፥ ኣየቴሳ ማይራመ ዮሴፋን ኤራንተጉደ ሀኤሰሎን አያና ቁሉክ ፋቶ ቶታተ ሙተ።<note caller="-" style="x"><char style="xo" closed="false">1፡18 </char><char style="xt" closed="false"><ref loc="LUK 2:1-7">ሉቃ. 2፡1-7</ref>።</char></note> <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />ኤሰ ካኤራተራ ዮሴፋ ቃጄላክ እባዶት ማንኮሌሮ ማራን ማይራመ እባዶ ሆረ ፋንቾይሲን ማንኮዶቶን ማራን ሀአዴስሶን እስን ሙርቴሰ።<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />ኡሱ ጎአመን ሂካ ቆፓ ግራን ካጎታ ኤርግቻ ህስሎይ ኡሱን ሙተ፥ ሃና አመ፥ “ሳኒ ታዳዉተ ካሌተታ ዮሴፋ፥ ታኤራተቶ ማይራመ አታይ ኦር የላዪን አሮአብሳተ ኣላንቲና ኤሰ ካኮቶታተታ ቁሉክ አያናኮያ። <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />ባባርትትና ኡሙልናታ፥ መገኬሳና የሱሳ<note caller="+" style="f"><char style="fr" closed="false">1፡21 </char><char style="ft" closed="false">ሄኢ ታኢብራይስጢ “የሱሳ” አማኖ ካፋይሳሮ ጎታ አማኖያ። </char></note> አም ኡምናታ፤ ኣላንቲና ኡሱ ጎሳኬሳ ጩቦክሶኮ ማንኮሃስናሮ ማራንያ።”<note caller="-" style="x"><char style="xo" closed="false">1፡21 </char><char style="xt" closed="false"><ref loc="LUK 1:3">ሉቃ. 1፡3</ref>።</char></note><verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />ጎታ ጋራ ካሄገሮነ ሃ አመ ካአዬሰራ ፈሎይ ጎጎሀይሮን አመጉረ ሂክ ዱባ ሌ። <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“ህክና፥ ዴለልትቲ ፋቶ ቶታይናታ ባባርትትና ኡሙልናታ መገኬሳና አማኑኤል አማምናራ፥” ፉረንና “ዋ ኖኔ ዎታ ግራ አማኖያ።”<note caller="-" style="x"><char style="xo" closed="false">1፡23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">ኢሳ. 7፡14</ref>።</char></note><verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />ዮሴፋና ሁዱሮኮ ናባደ፥ ኤሰኮና ካጎታ ኤርግቻ ጎጎሰጌሮይ ማይራመ ኦር የላዪን ምንኬሳ ቶስ አታተ ሴተ። <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />ሀሌዎ ኳሬ ኤረክሴ ታኡሙልቶይ ኤሰነ ዎታ ላኮሁዱረሮ ካአላተሮ ይትትና የሱሳ አመ ኡመ።<note caller="-" style="x"><char style="xo" closed="false">1፡25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">ሉቃ. 2፡21</ref>።</char></note><verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">ምና ታብያንኮ ኦኤሜተራን ባራጃ ኦቆቆራራን</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />ዎኖ ሄሮዶሳ ሬደ ካኮግሬ ገስ የሱሳ ታቤተሌም ካታማይ ካይሁዳ ኡሊ ካኮአላታረ ጎራታ ባራጃ ኦቆቆራሬን ምና ታብያንኮ ኢየሩሳለም ቶስ ኤመተንጉረን፥ <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />ካይሁዳ ዎኖ ሊን ካአላተራ ይትት ሀጌ ግራ? ምና ታብያንነ ባካላ ዴነጉነ ኡሱን ሳጋድን ኤሜነና አመን ሆሳተን።<note caller="-" style="x"><char style="xo" closed="false">2፡2 </char><char style="xt" closed="false"><ref loc="JER 23:5">ኤር. 23፡5</ref>፤ <ref loc="ZEC 9:9">ዛኪ. 9፡9</ref>፤ <ref loc="NUM 24:17">ቶቶ 24፡17</ref>።</char></note><verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />ዎኖ ሄሮዶሳ ሂካ አየስ ካኮማላረ ጎራታ ኔ። ኡሱማለና ካኢየሩሳለም እባዶ ዱባ ኔ። <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />ኡሱ ካቱቃሞል ዎይቻልና ሴራ ካአይሁድ ኦአጋልስሳራን ዱባ ኩኩይሰረ ክርስቶሳ ሀጌ አላይናሮ ሆሳተ።<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />እሶና፥ “ካይሁዳ ኡሊ ታግቶ ታቤተሌም ካታማይያ፤” ካሄገሮይ ሃ አማመ ጻፋመራ፤<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“ ‘ኡል ካይሁዳይ ታግታ አት ቤተሌም!</para>
  <para style="q2" vid="MAT 2:6">ካካለ ታይሁዳ ካታማልኮ ዱዶ ላኮየራታቶ፥</para>
  <para style="q2" vid="MAT 2:6">ጎሳኬ እስራኤል ካፎፍናራ ሞቲ ኩኮ ብናራ አመን።’ ”<note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ሚኪ. 5፡2</ref>።</char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />ኤሰኮና ሄሮዶሳ ባራጃ ኦቆቆራሬን ጎልሰ ኡምሰጉረ አዬስሳ ባካላ ካኮሙተሮ ልክኪ ጎራታ ሆሳተ ማለ። <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />ባራጃ ኦቆቆራሬና ቤተሌም ቶስ ፋረጉረ “ሴየንጉዴን ይትት ማላ ዶታ፥ አንና አድ ሴይጉረ ኡሱን ጎጎሳጋድሮን ኡሱ ጎጎሄልቴን እን ቶስ አባባይዴን ኤቲ ግሮ እን ሰጋ” አመ።<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />ባራጃ ኦቆቆራሬና ዎኖ ካአመሮ ማለን አባባቴንጉረን ሰሴታን ሆረዴን። ህክና ምና ታብያንነ ካዴራን ባካላ ራ ቃጄልሳ ይትት ማንኮግሮ ባንኤ ጌረ አሌ። <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />ባካላና ካኮድያረን ጎራታ ኣሎ ገጌላተን። <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />ምን ኦሮ ካኮታባሬን ጎራታ ይትትና ኣየቴሳ ማይራመነ ዎታ ካግሮ ዴን፥ ግልቢሰንጉሬን ሳጋደን። ሳጢነክሶና ባናተንጉረን ዎርቂ፥ ኢጣናነ፥ ኡርት ታኢዳን ካአቦ ቅባት ስሰን።<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />እሶና ሄሮዶሳ ቶስ ጎጎአባባኖንኮ ዋ ህስሎይ አታይሰ እሶን ማንኮሰጌሮ ማራን ራ ኢግልሳቴን ኡልክሶ ቶስ አባባተን።<verse eid="MAT 2:12" /></para>
  <para style="s1">ግብጽ ቶስ ባቃታኖ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />ባራጃ ኦቆቆራሬን ሴተን ካኮቡዋረን ጎራታ ኤርግቻ ካዋ ዮሴፋን ሙተጉረ ክ አት ታኮአባባቶ አሪ አን ኩን ታ ሰግሮን ይትት ኣየቴሳነ ዎታ ኣት ግብጽ ቶስ ባቃጉደ ኤሰ ግር። “ሄሮዶሳ ይትት ላጋዲን ዶታራ” አመ። <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />ሃንሱን ኡሱና ኬጉረ ይትትና ኣየቴሳና ኣተጉረ ሄመን ግብጽ ቶስ ሴተ። <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ኤሴና ሄሮዶሳ ታጎሮ አዳላተ። ሂካኒና “ኤረኬና ኡል ካግብጽኮ ኡማየ” አማ ጎታ ካሄገሮኮት ህኢ ካአዬሰራ ሃፉራ ፈሎ ሀየ።<note caller="-" style="x"><char style="xo" closed="false">2፡15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">ሆሴ 11፡1</ref>።</char></note><verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />ሄሮዶሳ ባራጃ ኦቆቆራሬን ኡሱ ሶባኖ አዴሰጉረ ኣሎ አማራተ፥ ባራጃ ኦቆቆራሬን ባራጃ ካኮሙተሮ ጎራታ ጎጎሰጌራንክ ማለ ጌስ ላማና ኤሰኮ ሄገልባን ካሌሮ ቤተሌምና ኡሱ ጎቦቢ ካግሮ ማማንጆልኮክ ባባር ይስ ዱባ ኩኩይሰረ ፋረ ላጋዲስሰ። <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />ሀሱ ጎራታ ካሄገሮ ኤርማሳ ሃ አማመ ካሰጋመራ ፈሎ ሀየ።<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />ካኦታኔና ካአቲ ኢያኮት ያየ ራማይ ማልሳንተ።</para>
  <para style="q2" vid="MAT 2:18">“ራሄልና ይስክሴ ማራን ኦተ፥</para>
  <para style="q2" vid="MAT 2:18">ጎጎኢና የላዪን ላኮዳንዴተ፥ ኣላንቲና ይስክሴ ማንኮጎየ ማራንያ።”<note caller="-" style="x"><char style="xo" closed="false">2፡18 </char><char style="xt" closed="false"><ref loc="JER 31:15">ኤር. 31፡15</ref>።</char></note><verse eid="MAT 2:18" /></para>
  <para style="s1">ግብጽኮ ናዝረት ቶስ አባባታኖ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />ጎይ ካሄሮዶሳኮ አባባተረ ካጎታ ኤርግቻ ዮሴፋን ህስሎይ ሙተጉረ፥ <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />“ክንጉዴ ይትትና ኣየቴሳ ኣትጉደ ኡል ካእስራኤል አባባ፥ ይትት ላጋዲን ኦዶታሬን ጎዬራን” አመ። <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />ዮሴፋና ኬጉረ ይትትና ኣየቴሳ ኣተጉረ ኡል ካእስራኤል ቶስ አባባተ። <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />አየሱን ጎአመን አርክሎሳ ኣቦኬሳ ሄሮዶሳኮት ባንኤ ኡል ካይሁዳ ዎኖ ሌ ሬዳኖ ካኮማላረ ጎራታ ዮሴፋ ኤሰራ ሴይን አብሳተ። ህስሎይ ኡሱን ካኮሰጋማረ ጎራታ ታጋሊላ አዉራጃ ቶስ ሴተ። <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />ናዝረት ታአማማቶ ካታማ ቶስ ሴተጉረ ሀማጼ። ሂካኒና ካሄገሮል፥ “ካናዝረት አማምናራ” አማሜን ኦሰጋመራን ሄገሮ ፈሎይ ሀዬን።<note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="ISA 11:1">ኢሳ. 11፡1</ref>፤ <ref loc="MRK 1:24">ማር. 1፡24</ref>፤ <ref loc="LUK 2:39">ሉቃ. 2፡39</ref>፤ <ref loc="JHN 1:45">ያን. 1፡45</ref>።</char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">ካጣማቃሮ ያንሳኮክ ላላባኖ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3፡1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1፡1-8</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፡1-18</ref>፤ <ref loc="JHN 1:19-28">ያን. 1፡19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />ኡሱ ጎራታ ካጣማቃራ ያንሳ ካይሁዳ ቃሉላቶክ ኡሊ ላላባ ኤመተ። <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />ላላባኖኬሳና፥ “ዎኖናት ካዳሩረ ጋባላመራ ጩቦኮ ጉላ ጋላ” ካአማሮያ።<note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">ማቶ. 4፡17</ref>፤ <ref loc="MRK 1:15">ማር. 1፡15</ref>።</char></note><verse eid="MAT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3" />ካሄገሮ እስያሳይ ሃ አማመ ካሰጋመራ ኡሱያ፥</para>
  <para style="q2" vid="MAT 3:3">“ቃሉላቶክ ኡሊ ‘ራ ካዋና ኤካሳ ቦባና ቱኩል ኡምሳ’ አማ ታኦካቶ ያየ።”<note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፡3</ref>።</char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />ካያንሳ ሳርስና ኦጎሮ ኦጋላኮ ካፈላመሮ ጎሌሮ ሞኦቴሳይና ጊ ሞዋታረ። ባቦኬሳና ከንተፋሮና ካጋዶ ማላብየ።<note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ዎኖ. 1፡8</ref>፤ <ref loc="ZEC 13:4">ዛኪ. 13፡4</ref>፤ <ref loc="LEV 11:22">ዎዩ. 11፡22</ref>።</char></note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />ኢየሩሳለምኮ፥ ካይሁዳ ኡል ዱባኮና ላጋ ካዮርዳኖስ ጎቦቢ ካግሮ ኡልኮ እባዶ ዱባ ያንሳ ቶስ ጉራማረ። <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />ጩቦክሶኮና ጉላ ጋላ ላጋ ካዮርዳኖሲ ገነቴሳይ ጣማቃማ ግረን።<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />ፋራሳውልኮና ሶዶቃውልኮ ካሞጋን እባዶ ኡሱ ታኮጣማቃረ ባንኤ ካኤሜታሮ ካኮድያረ ጎራታ ሃ አመ፥ “እስን ይስ ካሀበሳ ታኤማቶ ኤንገ ታዋኮ ጎጎሄሳኑን አዮያ እስን ካጎርሴ?<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12፡34</ref>፤ <ref loc="MAT 23:33">23፡33</ref>።</char></note> <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />ጎርታኑን ጩቦኮ ጉላ ጋላኖክስን ኦቱሳራን ፈሎ ፈላ. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />‘አብራመ ኣቦካንያ’ ታአማታን ቆፋይ እስኦትስን አሮሶባቴን፤ ዋ ሂካ ኤኤሞልኮ አብራመን ይስ ኬስን ዳንዳራ።<note caller="-" style="x"><char style="xo" closed="false">3፡9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ያን. 8፡33</ref>።</char></note> <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />ጎርታ ማሳር ካጋዶል ህዲድ ጎስን ኤካተታ፥ ኢል ታኢዳን ካዱባሞን ጋ ዱባ ጎሳምናራ፤ ኤለን ኦሮና ሻፋምናራ።<note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ. 7፡19</ref>።</char></note><verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“አን እስን ጩቦኮ ማንኮ ጉላ ጋልቴታን ማራን በከይ ጣማቅናራ፥ አየሱን ጎአመን ከፈሮ ኦቴሳና ስድን አን ካዶትሶን፥ እንኮ ካሮራሮ ሁና ካአባ እንኮ ሃሬ ኤመታራ። ኡሱና ቁሉክ አያናይና ኤለኒ እሲን ጣማቅናራ። <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />ካኮባንጳራና ገነቴሳይ ግራ፥ አዱማ ባሳምጉደ ባንጳምናታ፥ ዳርጋማና ጎታራይ ክባምናታ፥ ጋላባ አደ ታባኖን ኤለኒ ጉባምናታ።”<verse eid="MAT 3:12" /></para>
  <para style="s1">ጣማቃማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 1:9-11">ማር. 1፡9-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3፡21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />ሀሱ ጎራታ የሱሳ ገነ ታያንሳ ጣማቃምን ጋሊላኮ ላጋ ካዮርዳኖስ ቶስ ኤመተ። <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />ያንሳ ጎአመን፥ “ሂክ ሃ ሊን ላኮዳንዳሮ፥ አን ገነታይ ጣማቃምን ዶትሳ ግራን አት ምሲ እን ቶስ ኤማታ?” አመ እስ ትራተ።<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />የሱሳና፥ “ኮና ላኮግሮ አት እ አም፥ ሂካ ፈላኖይ ኦቁሉማ ፈሎ ዱባ ፈላኖ ኖን ዶትሳራ” አመ። ያንሳና አየሱን እ አመ።<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />የሱሳና ጎርሰዋ ጣማቃመ በከኮ ጎጎቤይ ዳሩርና ባናንተጉደ አያና ካዋ አራበ አን ኡሱ ጉት ዳጋ ግራን ዴ። <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />ኡሱ ጎራታ፥ “አን ካኮገገላይናራ፥ አን ካጌላታራ ኤረክ ሂካያ” ታአማታ ያየ ዳሩርኮ ማልሳንተ።<note caller="-" style="x"><char style="xo" closed="false">3፡17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መጣ 22፡2</ref>፤ <ref loc="PSA 2:7">ማዛ. 2፡7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፡1</ref>፤ <ref loc="MAT 12:18">ማቶ. 12፡18</ref>፤ <ref loc="MAT 17:5">17፡5</ref>፤ <ref loc="MRK 1:11">ማር. 1፡11</ref>፤ <ref loc="LUK 9:35">ሉቃ. 9፡35</ref>።</char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">ጫፋማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 1:12-13">ማር. 1፡12-13</ref>፤ <ref loc="LUK 4:1-13">ሉቃ. 4፡1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />ሂካኮ አባባተረ አያና ቁሉክ የሱሳ ዱርሳይ ጎጎጫፋምሮ ቃሉላቶክ ኡል ቶስ ኣተ ቤ።<note caller="-" style="x"><char style="xo" closed="false">4፡1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">እብ. 2፡18</ref>፤ <ref loc="HEB 4:15">4፡15</ref>።</char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />ሄመን አፋርታምና አሪ አፋርታም አጋቡኮ አባባተረ ኡኤ።<note caller="-" style="x"><char style="xo" closed="false">4፡2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">ብያ. 34፡28</ref>፤ <ref loc="1KI 19:8">1 ዎኖ. 19፡8</ref>።</char></note> <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />ካጫፋረክና የሱሳ ቶስ ጋባላመረ “አት ኤረ ካዋ ጎሌተ ሂካ ኤኤሞል ባቦ ጎጎሌሮ አጃጂ” አመ።<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />የሱሳና፥ “እባዶ ህኢ ታዋኮ ካብያሮ ሃፉራ ዱባ ኳሬ ባቦ ካላሊ ላኮግራሮ አማመ ማጻፋ ቁሉክ ጻፋመራ” አመ አባበ።<note caller="-" style="x"><char style="xo" closed="false">4፡4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">አዳ. 8፡3</ref>።</char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />አደና ዱርሳ የሱሳ ቁሉት ካታማ ኢየሩሳለም ቶስ ኣተ ሴተጉረ ቁሉክ ምን ካዋይ ብርጠ ኣተ ቤጉረ፥<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="NEH 11:1">ነህ. 11፡1</ref>፤ <ref loc="DAN 9:24">ዳኔ. 9፡24</ref>።</char></note><verse eid="MAT 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 4:6" />“አት ኤረ ካዋ ጎሌተ” “ሄገልዴ እሲ ፍርም፥</para>
  <para style="q2" vid="MAT 4:6">ሉቃኦታ ኤኤሞይ ጎጎሀንዱዱፋኖንኮ እሶ ገነትሶይ ጎጎኬስናዉን ኤርግቻል ኩ ማራን አጃጅናራ አማመ ማጻፋ ቁሉክ ጻፋመራ አመ።”<note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">ማዛ. 91፡11-12</ref>።</char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />የሱሳና፥ አባበረ፥ “ጎታ ሄዶካ አሮጫፍተ አማመ አደ ማጻፋ ቁሉክ ጻፋመራ” አመ አባበ።<note caller="-" style="x"><char style="xo" closed="false">4፡7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">አዳ. 6፡16</ref>።</char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />አደና፥ ዱርሳ የሱሳ ኣሎ ጦቂ ታአንተ ዎዳሚ ኮርሰጉረ አላምኮክ ዎኖላል ካባጃትሶነ ዎታ ኡሱን ቱሰጉረ፥ <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />“አት እን ሆረ ኢጉደ ግልቢስ ጎሳጋደ ሂካ ዱባ አን ኩን ስስናራ አመ።”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />የሱሳና፥ “አት ጻላየ እን ሆረኮ ፋክአም! ‘ዋ ሄዶካዉን ሳጋድ፤ ኡሱ ካላልና ሄዶይሳ’ አማመ ማጻፋ ቁሉክ ጻፋመራ” አመ።<note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">አዳ. 6፡13</ref>።</char></note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />ኤሰኮና ዱርሳ ኢሰ ሴተ፤ ኤርግቻልና ኤመተጉረ ኡሱን ሀንዳየ።<verse eid="MAT 4:11" /></para>
  <para style="s1">የሱሳ ሀንዳኖ ጋሊላ ሀጋአበ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />የሱሳ ሻማኖ ካያንሳ ማለረ ኡል ካጋሊላ ቶስ አባባተ ሴተ።<note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ. 14፡3</ref>፤ <ref loc="MRK 6:17">ማር. 6፡17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3፡19-20</ref>።</char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />ታናዝረት ካታማ ኢሰጉረ፤ ዛብሎንና ንፍታሌምኮት አዉራጃይ ታጋሊላ ላቡ ግርዲ ታግቶ ታቅፍረናሆም ካታማይ ግራኖ ሀጋአበ።<note caller="-" style="x"><char style="xo" closed="false">4፡13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">ያን. 2፡12</ref>።</char></note><verse eid="MAT 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 4:14" />ሂካኒና ካሄገሮ እስያሳይ ሃ አማሜን ኦሰጋመራን ሄገሮ ፈሎ ሀዬን።<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“ኡል ካዛብሎንና ኡል ካንፍታሌም፥ ዮርዳኖስኮ ጋማ</para>
  <para style="q2" vid="MAT 4:15">ላቡ ግሪ ካግሮ ራ ዶሌ ካጋሊላ አይዛብ፥<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />ሙጉዲ ካግረ ጎሳ</para>
  <para style="q2" vid="MAT 4:16">ካአቲ ኢፋ ዴ፤</para>
  <para style="q1" vid="MAT 4:16">ሆስ ታጎይ ካግረ እባዶና</para>
  <para style="q2" vid="MAT 4:16">ኢፋ ቤ።”<note caller="-" style="x"><char style="xo" closed="false">4፡16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">ኢሳ. 9፡1-2</ref>።</char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />ሀሱ ጎራታኮ ሀጋአበረ የሱሳ፥ “ዎኖናት ካዳሩረ ጋባላመራ ጩቦኮ ጉላ ጋላ” አመ ላላባኖ ሀጋአበ።<note caller="-" style="x"><char style="xo" closed="false">4፡17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ. 3፡2</ref>።</char></note><verse eid="MAT 4:17" /></para>
  <para style="s1">የሱሳ ኩኑኡብ ካአባታረ እባዶ አፋር ኡማኖ</para>
  <para style="r">(<ref loc="MRK 1:16-20">ማር. 1፡16-20</ref>፤ <ref loc="LUK 5:1-11">ሉቃ. 5፡1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />የሱሳ ታጋሊላ ላቡ ግርንደ ሮራ ግራን አቢላል ላማ ጴጢሮሳ ካአማማሮ ስሞናነ አቢኬሳ እንድራሳነ ዴ። ኩኑኡብ ኦአባታሬን ማንኮሌን ማራን ማራብትሶ በከሮ ሉጉዳታ ግረን። <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />የሱሳና “ኮዬን እን ዴበ ሰሴዬን” እባዶ ዎኖናት ካዋ ቶስ ጎጎኬንታኑን አን እስን የልናራ አመ። <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />ጎርሰዋ ማራብትሶ ኢሴንጉሬን ኡሱ ዴበ ሰሴተን።<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />ኤሰኮ ጎጎሮረይ ታካለ አቢላል ላማ ኤረ ካዛብዶሳ ያይቆባና አቢኬሳ ያንሳነ ዴ። ኣቦክሶ ዛብዶሳነ ዎታ ዎላቦ ኦሮ ማራብትሶ ኤካሳታ ግረን፤ የሱሳና እሶ ኡመ፤ <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />ጎርሰዋ እሶ ዎላቦትሶና ኣቦክሶ ኢሰን የሱሳ ዴበ ሰሴተን።<verse eid="MAT 4:22" /></para>
  <para style="s1">የሱሳ እባዶ ካሞጋን አጋልስሳኖና ፋይሳኖ</para>
  <para style="r">(<ref loc="LUK 6:17-19">ሉቃ. 6፡17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />የሱሳና አይሁድኮክ ምን ካኤብ ዎኖናት ካዋኮክ ካገጌሎ ሃፉራ አጋልስሳና ላላባ፤ ጎሳ ኦሮ ካግሮ ማምስክ ሀዉኣምኮና ማሪ ጉት ታግቶ ራኮ ታሞጋንኮ ፋይሳ ካጋሊላ ኡል ዱባ ማራሙራ ግረ።<note caller="-" style="x"><char style="xo" closed="false">4፡23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">ማቶ. 9፡35</ref>፤ <ref loc="MRK 1:39">ማር. 1፡39</ref>።</char></note><note caller="+" style="f"><char style="fr" closed="false">4፡23 </char><char style="fqa" closed="false">ምኩራቦች፦ </char><char style="ft" closed="false">አማኖ እባዶ ታኮኩኩማሮ ባንኤ ጎሌቶ፥ አይሁድኮክ ምን ካኤብ ምኩራብ አማማራ። </char></note> <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />ሂካኮ ካከይ አታንኬሳ ካሶርያ ኡል ዱባ ማልሳመ፤ ጎሳና ካለካለክ ሀዉኣም ሀዉኣማ ካግረና፤ ማር ኦሮክ ሀዉኣም ካሜላኒ አቦሳማረን፤ ዱርሳ ጉት ካኮግረና ካጋጋዱ ሀዉኣም ኦአባናየን፤ ናፋለሳል ዱባ ኡሱ ቶስ ከነን፤ ኡሱና እሶ ፋይሰ። <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />ሂካኮ ካከይ፤ ጋሊላኮና፥ ካታማ ቶሞንኮ ኢየሩሳለምኮ፥ ይሁዳኮና፥ ላጋ ካዮርዳኖስ ጋማኮ ካኤመተራ ካሞጋን እባዶ የሱሳ ዴበ ሰሴተ።<note caller="+" style="f"><char style="fr" closed="false">4፡25 </char><char style="fqa" closed="false">ካታማል ቶሞን፦ </char><char style="ft" closed="false">ሄኢ ታግርኪ ኦአዬሳራና አይሁድ ካሌኖን ጎሳ ራቶ ታኮግሮ ባንኤ ካታማል ቶሞን አማማታ። ሂክ ካታማል ጋማካሆር ካኮግራን ኦጋሊላ በከኮ ምና ታብያነና ታኢያን ብያነያ። </char></note><verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">የሱሳ ዎዳሚ ጉት ላላባኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />የሱሳ ጎሳ ካኮድያረ ጎራታ ዎዳም ቶስ ቤጉረ ሀማጼ፤ ኡሱኮ ኦአጋልሳታረን ኡሱ ቶስ ኤመተን። <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />ሃ አማ አጋልስሳኖ ሀጋአበ።<verse eid="MAT 5:2" /></para>
  <para style="s1">ካሶማሳመ እባዶ</para>
  <para style="r">(<ref loc="LUK 6:20-23">ሉቃ. 6፡20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“አያናክሶይ ዋ ኦዶታታራን ኦሶማሳመንያን፤</para>
  <para style="q2" vid="MAT 5:3">ዎኖናት ካዳሩረ ካክሶያ።<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />ኦጋዳራን ኦሶማሳመንያን፤</para>
  <para style="q2" vid="MAT 5:4">ዋኮ ጎጎኢና ሄላይናራን።<note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">ማዛ. 24፡3-4</ref>።</char></note><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />ፋያንካኒዕ ኦሶማሳመንያን፤ ኡልና ኤልናራን።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">ማዛ. 37፡11</ref>።</char></note><verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />ቁሉማ ኦኡኣራና ኦሱጉባታራን</para>
  <para style="q2" vid="MAT 5:6">ኦሶማሳመንያን ባራራንዋ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">ኢሳ. 55፡1-2</ref>።</char></note><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />ሻጋ ኦየላራን ኦሶማሳመንያን፤ ዋኮ ሻጋ ሄላይናራን።<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />ዎዳና ቁሉ ኦኮንሌተታ ኦሶማሳመንያን፤ ዋ ድናራን።<note caller="-" style="x"><char style="xo" closed="false">5፡8 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">ማዛ. 24፡3-4</ref>።</char></note><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />ኦዎጋርሳራን ኦሶማሳመንያን ይስ ካዋ አማም ኡማምናራን።<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />ቁሉማ ማራን አመረነ ኦሆሮራማራን ኦሶማሳመንያን፤</para>
  <para style="q2" vid="MAT 5:10">ዎኖናት ካዳሩረ ካክሶያ።<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 ጴጢ. 3፡14</ref>።</char></note><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“እባዶ ኣላንቲቴይ እስን ጎሀባረ ጎሆሮረና፤ ሜላነ ዱባ እስን ጉት ጎአዬሰ ኦሶማሳንቴታን።<note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 ጴጢ. 4፡14</ref>።</char></note> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />ዳሩሪ እስን ታአታይናታን ሙራ ታአቲ ማንኮሌተ ማራን ገጌላየን፤ ገጌሎ ቱሳ። እስንኮ ሆረነ ኦግረን ኦሄገሮል ሂካማሌ ሆሮረራን።”<note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 ኦዱ 36፡16</ref>፤ <ref loc="ACT 7:52">ኦፋ. ፈ. 7፡52</ref>።</char></note><verse eid="MAT 5:12" /></para>
  <para style="s1">ኢፋና ኤሰቦ</para>
  <para style="r">(<ref loc="MRK 9:50">ማር. 9፡50</ref>፤ <ref loc="LUK 14:34-35">ሉቃ. 14፡34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“እስን ታኡሌ ኤሰቦታን። ኤሰቦ ታኤሰቦ ኦኖሞንጀ ጎዋተ አባባይ ኦኖሞንጀ የላዪን ዳንዳታ? ሳር ሻፋምደ ሉክ ታእባዶይ ዳዳራምን ኳሬ ላኦ ላኮአብቶ።<note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="LUK 14:34-35">ሉቃ. 14፡34-35</ref>።</char></note><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“እስን ካአላም ኢፋታን። ዎዳም ጉት ታግታ ካታማ ስያምን ላኮዳንዴቶ።<note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">ያን. 8፡12</ref>፤ <ref loc="JHN 9:5">9፡5</ref>።</char></note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />ዳብ ሀንቃይሳተረ ዳቾ ሄገሊ ጎልሳተ ካካታራ እባዶ ላኮግሮ። ምን ኦሮ ካግሮ ዱባን ጎጎሀንቃይሮ ቦላንሶ ጉት ካይን ኳሬ።<note caller="-" style="x"><char style="xo" closed="false">5፡15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">ማር. 4፡21</ref>፤ <ref loc="LUK 8:16">ሉቃ. 8፡16</ref>፤ <ref loc="LUK 11:33">11፡33</ref>።</char></note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />ሂካማሌና እባዶ ኦኢዳን ፈሎኦትስን ዲጉረ ዳሩሪ ካግሮ ኣቦክስን ጎጎካባጅሮን ኢፋክስን እባዶ ሆረ ሀሃንቃዎ።”<note caller="-" style="x"><char style="xo" closed="false">5፡16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 ጴጢ. 2፡12</ref>።</char></note><verse eid="MAT 5:16" /></para>
  <para style="s1">ሴራ ካኦርት ፈሎ ሃኖ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“አን ሴራ ካሙሴና ካሄገሮ ኢግልስን ካኤመየሮ አን እስኑን አሮሌኖ፤ ፈሎ ሀይስን ኳሬ ኢግልስን ላኮኤሜየሮ። <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />አን ሩምና እስኑን አማራ፥ ኡልና ዳሩርና ታ ሮራኒ ሴራ ዱባ ፈሎ ሀይናራ ኳሬ ሴራኮ ፍዳለ ቶ ጎርቱን ኤጋኖ ኮ ዱዶ ላኮኢግልሳምሮ።<note caller="-" style="x"><char style="xo" closed="false">5፡18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">ሉቃ. 16፡17</ref>።</char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />ሃንሱን ማዮና ሂካ አጃጃ ዱባኮ ክጫርክ ጎባሰ ካካለና ጎጎባስሮ ጎአጋልስሰ ዎኖናት ካዳሩረይ ዱባንኮ ክጫርክ አማም ኡማምናራ። አየሱን ጎአመን ሂካ አጃጃል ፈሎ ሀይሳ ኦካለና ፈሎይ ጎጎሀይስናዉን ካአጋልስሳራ ሀሱ ዎኖናት ካዳሩሬት ካንጂንክ አማምናራ። <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />ቁሉማትስን ታፋራሳውልኮና ሴራ ካሙሴ ኦአጋልስሳራንኮት ቁሉማኮ ሮር ጎሙቶን ዎኖናት ካዳሩረ ቶስ ኢጂ ታብን ላኮዳንዳታን አን አማራ።”<verse eid="MAT 5:20" /></para>
  <para style="s1">የሱሳኮ ኤንገ ማራን ካስሳመሮ አጋልስስ</para>
  <para style="r">(<ref loc="LUK 12:58-59">ሉቃ. 12፡58-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“ካሆሬ እባዶነ ‘እባዶ አሮላጋዴን ካአማመሮ እስን ማልቴታን፤ እባዶ ካላጋዳራ ፍርዳምናራ ካአማመሮ ማልቴታን።’<note caller="-" style="x"><char style="xo" closed="false">5፡21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ብያ. 20፡13</ref>፤ <ref loc="DEU 5:17">አዳ. 5፡17</ref>፤ <ref loc="DEU 16:18">16፡18</ref>።</char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />አን ጎአመን ሃ አማራ፤ አቢኬሳ ራካሊ ካኢንጋማራ ዱባ ፍርዳምናራ፤ ጎርቱን አቢኬሳ ‘ካማድኖን’ ካአማራ ታአይሁድ ሾንጎይ ሆሳምናራ፤ ‘ታቶዋ’ ካአማራ አደ ታጋነም ኤሌንኮክ ፍርዳ ኡሱ ኦራታራ።<note caller="+" style="f"><char style="fr" closed="false">5፡22 </char><char style="fqa" closed="false">አቢኬሳ ካሀባራራ</char><char style="ft" closed="false">ኮኮ ካሆርኮ ማጻፋል፥ “አዳ” ካአማሮ ሃፉራ አዳራ። </char></note><verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />“ሃንሱን ጃርሶካ ባንኤ ታፋላ ጉት ካይተደ ዋዉን ካኮስሳቶ ጎራታ አቢካ ኩ ካኮቁቃመራ አየስ ኩን ቃል ጎአመ፥ <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ጃርሶካ ኤሰ ባንኤ ታፋላ ሆረ ኢሳግጉደ ሆራርጀ ሴጉዴ አቢካነ ዎታ ዎጋር፤ ኤሰኮ አባባደ ጃርሶካ ዋዉን ስስ።<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“ኩ ካሞታራ ባራጋራካ ኩ ጎጎፍርድሶንኮ፥ ዳናና ካሻሮን ሮርስ ኩ ጎጎስሶንኮና ምን ካሻኖ ጎጎታብሶንኮ ራድ ግራን ሳም ባራጋራካነ ዎታ ዎጋር። <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />አን ኩን ሩምና አማራ፥ ኡሱ ኩ ጎፍርድሰ አድ ማራጋደ ዱባ አት ሙር ታጉድሶ ኤሰኮና ላኮብናቶ።”<verse eid="MAT 5:26" /></para>
  <para style="s1">ሻርሙጡማኮክ ጋራ ካስሳመሮ አጋልስስ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“አሮሻርሙጢቴን ካአማመሮ ማልቴታን።<note caller="-" style="x"><char style="xo" closed="false">5፡27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ብያ. 20፡14</ref>፤ <ref loc="DEU 5:18">አዳ. 5፡18</ref>።</char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />አን ጎአመን እስኔ ሃ አማራ፤ ሄለል ታሀልቻ እሊ ካድያራ ዱባ ዎዳናቴሳይ ኤሰነ ዎታ ሻርሙጠራ አማኖያ። <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />ታመርገ እልታታ ጩቦን ኣላንቲ ጎሌተ ጎርሰዋ ቤስ ሻፍ፥ ማርካ ዱባ ታጋነም ኤለን ቶስ ሻፋማናኮ ማርካኮ ባንኤ ቶ ዋታኖያ ሆረክ።<note caller="-" style="x"><char style="xo" closed="false">5፡29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">ማቶ. 18፡9</ref>፤ <ref loc="MRK 9:47">ማር. 9፡47</ref>።</char></note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />ገነ ታመርገታታ ጩቦን ኣላንቲ ጎሌተ ጎስጉደ ሻፍ! ማርካ ዱባ ጋነም ቶስ ሻፋማናኮ፤ ማርካኮ ባንኤ ቶ ዋታኖ ሆረክ።”<note caller="-" style="x"><char style="xo" closed="false">5፡30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">ማቶ. 18፡8</ref>፤ <ref loc="MRK 9:43">ማር. 9፡43</ref>።</char></note><verse eid="MAT 5:30" /></para>
  <para style="s1">ከልክ አማማኖኮክ ጋራ</para>
  <para style="r">(<ref loc="MAT 19:9">ማቶ. 19፡9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፡11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፡18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“ ‘ኦርቴሳ ከልክ አመ ካቤሳራ ዱባ ከልክ ካኮአመሮ ዎራቃታ ኤሰን ስሳኖ ዶትሳራ አማመራ።’<note caller="-" style="x"><char style="xo" closed="false">5፡31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">አዳ. 24፡1-4</ref>፤ <ref loc="MAT 19:7">ማቶ. 19፡7</ref>፤ <ref loc="MRK 10:4">ማር. 10፡4</ref>።</char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />አን ጎአመን እስኔ ሃ አማራ፤ ኤሰ ካካለኔ ዎታ ሻርሙጣ ግራን ጉት ጎአበ ኳሬ፤ ኦርቴሳ ከልክ አመ ካቤሳራ ዱባ ኤሰ ካካለኔ ዎታ ጎጎሻርሙጢቶ ካየላሮያ። ሂካ ጋራይ ከልክ አማንተ ታቤተቶ ሄለልትቲ ካአታታራና ካሻርሙጣሮ ኣን ቶታማራ።”<note caller="-" style="x"><char style="xo" closed="false">5፡32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">ማቶ. 19፡9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፡11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፡18</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፡10-11</ref>።</char></note><verse eid="MAT 5:32" /></para>
  <para style="s1">ጋራ ካአማቶ</para>
  <para style="r">(<ref loc="MAT 5:32-38">ማቶ. 5፡32-38</ref>፤ <ref loc="LEV 19:12">ዎዩ. 19፡12</ref>፤ <ref loc="JAS 5:12">ያይ. 5፡12</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />ካሆሬ እባዶን፥ “ጣራ አሮአማቴን፤ አየሱን ጎአመን ዋይ ሆረ ካአማተቶ ኦራ” ካአማመሮ ማልቴታን።<note caller="-" style="x"><char style="xo" closed="false">5፡33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ዎዩ. 19፡12</ref>፤ <ref loc="NUM 30:2">ቶቶ 30፡2</ref>፤ <ref loc="DEU 23:21">አዳ. 23፡21</ref>።</char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />አን ጎአመን እስኔ፤ “ሱረ አሮአማቴን” አማራ። ዳሩሪ ጎሌና አሮአማቴን፥ ኮርፍንጀ ካዋታ።<note caller="-" style="x"><char style="xo" closed="false">5፡34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">ያይ. 5፡12</ref>፤ <ref loc="ISA 66:1">ኢሳ. 66፡1</ref>፤ <ref loc="MAT 23:22">ማቶ. 23፡22</ref>።</char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ኡሊ ጎሌና አሮአማቴን፤ ሉክ ታዋ ታኮፎልሳቶያ፤ ኢየሩሳለምና አሮአማቴን ታንጂንት ታዎኖ ካታማታ።<note caller="-" style="x"><char style="xo" closed="false">5፡35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66፡1</ref>፤ <ref loc="PSA 48:2">ማዛ. 48፡2</ref>።</char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />እስኦታይ ጎሌና አሮአማተ፤ መተካክ ፊጣ ኮ ጉማራ ጎርቱን ጋምባላ የልን ላኮዳንዳቶ። <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />ሃንሱን አዬሳ ግራን አዬስክስን ጎኢማና “እ” አደ ጎላአማና “ላ” ሀሌዎ። ሂካኮ ካካለ ዱባ ካሜላንኮ ካኤሜታሮያ።<note caller="-" style="x"><char style="xo" closed="false">5፡37 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ዎዩ. 19፡12</ref>፤ <ref loc="NUM 30:2">ቶቶ 30፡2</ref>፤ <ref loc="DEU 23:21">አዳ. 23፡21</ref>።</char></note><verse eid="MAT 5:37" /></para>
  <para style="s1">ሀሎ ብን ላኮዶትሳሮ</para>
  <para style="r">(<ref loc="MAT 5:38-42">ማቶ. 5፡38-42</ref>፤ <ref loc="LUK 6:29-30">ሉቃ. 6፡29-30</ref>፤ <ref loc="LEV 19:13-18">ዎዩ. 19፡13-18</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“እል ማራን ኢል፥ ኢልኮ ማራን ኢልኮ፥” ካአማመሮ እስን ማልቴታን።<note caller="-" style="x"><char style="xo" closed="false">5፡38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">ብያ. 21፡24</ref>፤ <ref loc="LEV 24:20">ዎዩ. 24፡20</ref>፤ <ref loc="DEU 19:21">አዳ. 19፡21</ref>።</char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />አን ጎአመን እስኔ ሃ አማራ፤ ታሜላን ካፈላሮ እባዶት አሮኔባቴን፤ አየሱን ጎአመን ሀንጎሮጫካ ካመርጌ ካባሳሮን ካካለ ሀንጎሮጫ ካበተ አድ ቱሳ። <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />እባዶት ኮ ቆሎካ አታይን ኩ ጎሞቴ ሳርስ ካባነ አድጉደ ኡሱን ስስ። <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />እባዶት ኮ ኩኔ ባንኤ ቶ ሴና አም ኩ ጉት ጎሁኖመ ኡሱ ራኮክ አምባ ኡሱነ ዎታ ሴ። <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />ኩኮ ካኤባታሮን ስስ፤ አምአይን ካዶታታሮኮና አሮትራተ።<note caller="-" style="x"><char style="xo" closed="false">5፡42 </char><char style="xt" closed="false"><ref loc="DEU 15:8">አዳ. 15፡8</ref>፤ <ref loc="PRO 24:29">ማሱ. 24፡29</ref>።</char></note><verse eid="MAT 5:42" /></para>
  <para style="s1">ዲና ጌላታኖ</para>
  <para style="r">(<ref loc="LUK 6:27-36">ሉቃ. 6፡27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“ኦላታ ጌላ ዲናካ ዲድ ካአማመሮ ማልቴታን።”<note caller="-" style="x"><char style="xo" closed="false">5፡43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዎዩ. 19፡18</ref>።</char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />አን ጎአመን ዲናጆልክስና ጌላየን፥ እስን ኦሆሮራራዉና ኤባየን አማራ።<note caller="-" style="x"><char style="xo" closed="false">5፡44 </char><char style="xt" closed="false"><ref loc="PRO 25:21-22">ማሱ. 25፡21-22</ref>።</char></note> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ሂካ ማለ ማንኮ የላታን ማራንትኑን ዳሩሪ ካግሮ ኣቦክስኑን ይሳስ ልናታን። ኡሱ ካኢዳኑና ካሜላኑን ዱባን አርት ቤሳራ፤ ኢዳሞና ጩባለሳሉና ቁሎሌዉን ኡብስሳራ። <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />ካጌላታሮ ካላል ኦጌላታታን ጎሌተን መ ሙራ ሄላይናታን? ቃራጣ ኦኩኩይሳራና ላ ኡሱማሌ የላ ግራና? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />አቢላልትስን ታላልነ ኖጎዳ ኦአታታን ጎሌተን ኦካለኮ መይ ኢዳታን? አይዛብልና ላ ሂካ የላ ግራና? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />ሃንሱን ካዳሩረ ኣቦክስን ቁሉክ ጎጎሌሮይ እስና ቁሉኒዕ ላ።<note caller="-" style="x"><char style="xo" closed="false">5፡48 </char><char style="xt" closed="false"><ref loc="LEV 19:2-18">ዎዩ. 19፡2-18</ref>፤ <ref loc="DEU 18:13">አዳ. 18፡13</ref>።</char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">ህየሳን ስሳኖኮክ ጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“እባዶ እስን ጎጎዴሮ አምዴን ‘ኦኢዳን ፈሎ ኦትስን’ እባዶ ሆረ ፈላታናኮ እስ ኦትስን ኦራዬን፤ ኡሱማሌ ጎፈልተን ካዳሩረ ኣቦክስንኮ ሙራ ላኮሄላታን።<note caller="-" style="x"><char style="xo" closed="false">6፡1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">ማቶ. 23፡5</ref>።</char></note><verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“ኢፍሳዶሌል እባዶ ሆረ ካባጃሚን አመንጉረን ራዲና ባንኤ ታኤቢ ጎጎስሳናንክ ማለ አት ህየሳን ኮኮ ካኮስሶ ጎራታ ሀሙቶ አምደ አሮአዋጅተ፤ አን ሩምና አማራ፤ ሂካማሌ ኦላራን ሙራትሶ ዱባ አታቴራን። <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />እስን ጎአመን ህየሳን ስሳግራን ገነ ታመርገትስን ካስሳቶ ገነ ታበተ አሮአዴሶ። <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />ህየሳን ስሳግራን ጎላታ ሀሌዎ፤ ጎላታ ካፈላመሮ ካድያራ ኣቦክስን ሙራትስና ሙሮዋ።”<verse eid="MAT 6:4" /></para>
  <para style="s1">ጋራ ካኤብ</para>
  <para style="r">(<ref loc="LUK 11:2-4">ሉቃ. 11፡2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“ኤባታ ግራን ኢፍሳዶለ ኣን አሮሌተን፤ እሶ እባዶን ሙትን አመንጉረን ባንኤ ታኤቢና ራድ ቃርቃራይ ኣል ኤባታኖ ጌላታናን። አን ሩምና አማራ፤ ሙራትሶ ዱባና አታቴራን።<note caller="-" style="x"><char style="xo" closed="false">6፡5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">ሉቃ. 18፡10-14</ref>።</char></note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />አት ጎአመን ኤባይን ጎአንተ፤ ክፍሊ ቶስ ታብ፥ ኡፋና ጩፋጉደ ጎላታ ካግሮ ኣቦካ ቶስ ኤባ፥ ጎላታ ካፈላመሮ ካድያራ ኣቦካ ሙራታ ጋቾሙራ። <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />እስን ኤባታ ግራን ካማድኖን ሃፉራይ አባብ አባብ ኤባታኖይ ኤብ ካማልሳማሮ ኣን ካላሮ አይዛብ ኣን አየስ ጂናሳታ አሮኤራሳተን።<note caller="-" style="x"><char style="xo" closed="false">6፡7 </char><char style="xt" closed="false"><ref loc="1KI 18:25-29">1 ዎኖ. 18፡25-29</ref>።</char></note> <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />እሶ ኣን አሮሌተን፥ ኣቦክስን እስን ሀኤባኖን ግራን ሆረነዋ እስኑን መ ዶትሳሮ ካሶዋ።<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />“እስን ጎአመን ሃ አማ ኤባየን፤</para>
  <para style="q1" vid="MAT 6:9">“ዳሩሪ ካግታ ኣቦካን!</para>
  <para style="q2" vid="MAT 6:9">ቁሉክ መገካ ሀካባጃመ፤<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />ዎኖናትካ ሀኤመቶ፤</para>
  <para style="q2" vid="MAT 6:10">ፈኢታ ዳሩሪ ጎጎሌተቶይ</para>
  <para style="q2" vid="MAT 6:10">ኡሱማሌ ኡሊና ሀሌቶ፤<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />ካህታርቴ ባቦካን ህታር ኖን ስስ።<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />ኖና ኖ ካሚረኤሮ ሀሄሶ ጎጎአማኖ፤</para>
  <para style="q2" vid="MAT 6:12">ባስካን ሀሄሶ አምና፤<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />ካሜላንኮ ሃስ ኳሬ፤ ጫፍት ኦሮ ኖ አሮታብሰ፤</para>
  <para style="q1" vid="MAT 6:13">[ዎኖናት ካካያ፥ ሁናና ካባጃና</para>
  <para style="q2" vid="MAT 6:13">ጅሩ ጅሮማን ካካያ፤</para>
  <para style="q2" vid="MAT 6:13">ሀሚኒዕ።]<note caller="+" style="f"><char style="fr" closed="false">6፡13 </char><char style="ft" closed="false">ካጣዎ ማጻፋሊ ህታ ባንኤ ላኮአዳሮ። </char></note><verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />እስን ባስ ካእባዶ ሀሄሶ ጎአንቴን ካዳሩረ ኣቦክስን አደ እስኑን ሀሄሶ አምሮዋ። <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />አየሱን ጎአመን እስን ጩቦ ካእባዶ ሀሄሶ ካአሞን ጎሌተን ኣቦክስና ጩቦክስን ሀሄሶ ላኮአምሮ።”<note caller="-" style="x"><char style="xo" closed="false">6፡15 </char><char style="xt" closed="false"><ref loc="MAT 11:25-26">ማቶ. 11፡25-26</ref>።</char></note><verse eid="MAT 6:15" /></para>
  <para style="s1">ጋራ ካአጋቡ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“ኤብ ካአጋቡይ ኢፍሳዶለ እባዶ ኣን አሮህንግግዴን፤ እሶና ኤብ ካአጋቡይ ጎጎአዴሳምሮዉን አመን ጉሬን በቤድትሶይ ጉት ጋዳኮክ ማላታ ቱሳታራን። አን ሩምና አማራ፥ ሂካማሌ ኦላራን ሙራትሶ ዱባ አታቴራን።<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="ISA 58:5">ኢሳ. 58፡5</ref>።</char></note> <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />አት ጎአመን ካኮአጋቡይተ ጎራታ፤ በቤድታ ኣል፥ መተካና ሽግዳ። <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ሂካኒና አጋቡዋኖካ ጎላታ ካግሮ ኣቦካ ካላልያ ካካሳ፥ እባዶኮ ጎአመን ካጎላተ ላራ፤ ጎላታ ካፈላመሮ ካድያራ ኣቦካ ሙራታ ኩን ሙሮዋ።”<verse eid="MAT 6:18" /></para>
  <para style="s1">ዱሩማ ታዳሩረ</para>
  <para style="r">(<ref loc="LUK 12:33-34">ሉቃ. 12፡33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“ቆቃና ካአማሮን፤ ማርጮ ታኡዱዶተ አን ካባሮን፤ ሄቶና ኦሽ ሄትን ካዳንዴቶ፥ ሂካ ኡሊ ጉት እስ ኦትስኑን ዱሩማ አሮኩኩይሳቴን።<note caller="-" style="x"><char style="xo" closed="false">6፡19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">ያይ. 5፡2-3</ref>።</char></note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />አየሱን ጎአመን ቆቃና ካአሞን፥ ማርጮ ታኡዱዶተ አን ካባኖን፥ ሄቶና ኦሽ ሄትን ካዳንዴኖን፥ ኤለ ዳሩሪ እስ ኦትስኑን ዱሩማ ኩኩኢሳዬን። <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />ዱሩማታ ማንኮግቶ ዎዳናታና ኤሰ ግታ።”<verse eid="MAT 6:21" /></para>
  <para style="s1">እፋ ካማሬ</para>
  <para style="r">(<ref loc="LUK 11:34-36">ሉቃ. 11፡34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“ኢልኦ ማሩን ኢፋያን፤ ሃንሱን ኢልኦ ፋያሌሳ ጎሌን ማርካ ዱባና ኢፋይ ካአማጋመ ላራ። <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />እልኦ ኦታ ኦሀዉአራን ጎሌን አደ ማርካ ዱባና ሙጉድ ላራ። ጎርታኑን ኩ ኦሮ ካግራ ኢፋ ሙጉድ ጎሌ፤ ሙጉድ አደ ምስምሲ ጢልንጋክ ሙጉድ ላራ!”<verse eid="MAT 6:23" /></para>
  <para style="s1">ዋዉና ማራጋደና</para>
  <para style="s1">ሉቃ። 16፡13፤ 12፡22-31</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“እባዶት ኮ ጎታ ላማን ሀንዳይን ላኮዳንዳሮ፥ ኮ ዲደጉረ ካካለ ጌላታራ፥ ጎርቱን ኮ ካባጄጉረ ካካለ ቱፋታራ፥ ዋዉና ማራጋዴን ራቶ ሀንዳይን ላኮዳንዳማሮ።<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“ሃንሱን አን እስኔ ሃ አማራ፤ ባርሳኖ ኦትስን ማራን መ አምና? መ ጣምና? መ ሳርሳይናና? አማ አሮጫናቃንቴን፤ ኔፎ ባቦኮ፥ ማር አደ ሳርስኮ ላኮሮራሮያ? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />አላ ክምብር ዲያ፤ ላኮዉጣታናን፥ ላኮኩኩይሳታራን፥ ጎታራይና ላኮክባታራን፥ አየሱን ጎአመን ካዳሩረ ኣቦክስና እሶ አምሳራ። እስን እሶኮ ኣሎ ላኮሮራታንያ? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />ጎሌና እስን ኦሮኮ ጫናቃመጉረ ገስኬሳ ጉት አሪ ቶ አድን ካዳንዳራ ግሮ?<note caller="+" style="f"><char style="fr" closed="false">6፡27 </char><char style="fqa" closed="false">ገስኬሳ ጉት አሪ ቶ፦ </char><char style="ft" closed="false">ባንኤ ባንኤይ ፋረን፥ “ጅፉተሳ ጉት ህስል ኮ” ካአማራ ግራ። </char></note><note caller="-" style="x"><char style="xo" closed="false">6፡27 </char><char style="xt" closed="false"><ref loc="PSA 39:5-7">ማዛ. 39፡5-7</ref>።</char></note><verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“አደና ሳርስ ማራን ሙን ጫናቃማታን? አላ ታዲዳ ዳራራ ምስ ምሲ ጂናቶ ዲያ፤ ላኮዳፉራናን፥ ጎርቱን ላኮሱቃታራን፤ <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />አየሱን ጎአመን አን እስኔ ሃ አማራ፤ ሀሴ ግታት ካባጃ ካአባናየ ዎኖ ሶሎሞን ጎሌና ህታ ዳራራልኮ ቶ ኣን ላኮሳርሳተሮ።<note caller="-" style="x"><char style="xo" closed="false">6፡29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ዎኖ. 10፡4-7</ref>፤ <ref loc="2CH 9:3-6">2 ኦዱ 9፡3-6</ref>።</char></note> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />እስን አማኖ ኦኮንሀንቃተራ ዋ ህታር ሙተጉረ ጌባር ኤለን ኦሮ ካሻፋማሮ ኤስ ካዲዳ ሂካማሌ ጎሳርስስሮ እስን አደ ምሲ ሮርስ ሳርስሳና ዋታራ? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />ሃንሱን ‘መ ኣምና?’ ‘መ ጣምና?’ ‘መ ሳርሳና?’ አም አሮጫናቃንቴን። <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />አይዛብ ሂካ አየስ ዱባ ሄላይን ጫናቃማራ፤ ካዳሩረ ኣቦክስና ሂክ ዱባ እስኑን ካዶትሳሮ ላኖ ካሶዋ። <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />ካመን ዱባኮ ጣ ዎኖናት ካዋና ቁሉማቴሳ ዶታዬን፤ ካሄሰ ዱባና ጋቾ አዳምራ። <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />ሃንሱን ጌባርቱን አሮጫናቃንተን፤ ጌባርቱን ጫናቃማኖ ጌባርቱን ሀባሮ፤ አሪ መተመተይ ታትሴ ታሌተ ራኮ አብታ።”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">ካካለ ጉት ፍርዳናዋት</para>
  <para style="r">(<ref loc="LUK 6:37-42">ሉቃ. 6፡37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“እስን ጉት ጎጎፍርዳሞንኮ ማዮ ጉቲና አሮፍርድቴን፥ <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />እስን ጎጎፍርዳታንክ ማለ ፍርዳምናራ፤ ካኮኤካሳታን ሁይ እስኑን ኤካሳምናራ።<note caller="-" style="x"><char style="xo" closed="false">7፡2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">ማር. 4፡24</ref>።</char></note><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />“እልታይ ኦሮ ካግሮ ጋ ሀድያኖን አቢካ ኮት ኢል ኦሮ ካግሮ ሁራ ሙን ድያታ? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />እልታይ ጋ ግራን አቢካኮት ኢል ኦሮ ካግሮ ሁራ ኩን አን ቤስሮ አምን ምሲ ዳንዳታ? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />አት ኢፍሳዳ ጣይ ኢልታይ ኦሮ ካግሮ ጋ ቤሳ፥ ኤሰኮ አቢካኮት እሊ ኦሮ ካግሮ ሁራ ቤስን ማዳር ድን ዳንዳታ።<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“ሉቃ ኦትሶይ ጎጎዳዳሮንኮ አባባይ ኢልኮ አባይ ጎጎታታርሽኖንኮ ካሶማሳመ ኮኮ ከሮሩን አሮስሴን፤ አዉኣሎክ ኮኮ ቦዬ ሆረ አሮሉጉዴን።”<verse eid="MAT 7:6" /></para>
  <para style="s1">ኤባየን፥ ዶታዬን፥ ባባሳየን</para>
  <para style="r">(<ref loc="LUK 11:9-13">ሉቃ. 11፡9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“ኤባየን ስሳምሮዋ፥ ዶታዬን ሄላታንዋ፥ ባባሳየን ኡፋና ባናምሮዋ፤ <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />ካኤባታራ ዱባ አታታራ፥ ካዶታታራና ሄላታራ፥ ካባባሳታሮና ኡፋ ባናምሮዋ።<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />“እስን ኦሮኮ ኤረኬሳ ባቦ ጎኤባተ ኤኤሞ ካስስራ ኦዶ ግሮ? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />ጎርቱን ኩኑኡብ ጎኤባተ ሀበሳ ካስሳራ ግሮ? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />ሀያ እስን ኦሜላን ሌተን ግራን ይስ ካክስኑን ካእዳን ኮኮ ስሳኖ ጎማላብቴን ካዳሩረ ኣቦክስን እስን ካኤባታታን ኮኮ ካእዳን ምሲ ሮርስ እስኑን ስሳናዋታራ? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />ካካለ እባዶ እስኑን ጎጎፈሎን ካዶታታን ኮኮ እስና ፈላ፤ ሴራና ካሄገሮል ኮክ አጋልስስ ሂካዋያ።”<verse eid="MAT 7:12" /></para>
  <para style="s1">ጎጫ ካኡባና ካባላኣን</para>
  <para style="r">(<ref loc="LUK 13:24">ሉቃ. 13፡24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“ጎጫ ካኡባንክነ ታባ፤ ባስ ቶስ ካጌሳራ ራ ካንጂንክና ጎጫና ካባላኣንያ፥ ኡሱ ኦታበራና ኦሞጋንያን። <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />ግር ካኔፎ ቶስ ካጌሳራ ራ ጎአመን ካጭሚንክ ጎጫና ካኡባንያ፤ ኦታባራና ኡጫር ኦላልያን።”<note caller="-" style="x"><char style="xo" closed="false">7፡14 </char><char style="xt" closed="false"><ref loc="JER 21:8">ኤር. 21፡8</ref>፤ <ref loc="DEU 30:19">አዳ. 30፡19</ref>።</char></note><verse eid="MAT 7:14" /></para>
  <para style="s1">ካጣራ ካሄገሮል</para>
  <para style="r">(<ref loc="LUK 6:43-44">ሉቃ. 6፡43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“ጫላ ታእዳድ ሳርሳተ ካኤሜታሮ፤ ኦሮኦትሶ ጎአመን ህዬይ ኣን ባስ ኣትን ካኤሜታሮ ካጣራ ካሄገሮልኮ እስ ኦራዬን።<note caller="-" style="x"><char style="xo" closed="false">7፡15 </char><char style="xt" closed="false"><ref loc="EZK 22:27">ሕዝ. 22፡27</ref>።</char></note> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />ፈሎ ኦትሶኮ እሶ አዴስን ዳንዳታን። እላንጅኮ ዎይኒ፥ ቂንጮኮ በለስ ታአማማቶ ኢል አባባናን? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />ኡሱማለና ጋ ካእዳን ዱባ ኢል ታኢዳን፥ ጋ ካሜላን አደ ኢል ታሜላን ዱባማራ። <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />ጋ ካእዳን ኢል ታሜላን፥ ጋ ካሜላና ኢል ታኢዳን ዱባምን ላኮዳንዳሮ። <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />እል ታኢዳን ካዱባሞን ጋ ዱባና ጎሳማራ፥ ኤለን ኦሮዴና ሻፋማራ።<note caller="-" style="x"><char style="xo" closed="false">7፡19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">ማቶ. 3፡10</ref>፤ <ref loc="LUK 3:9">ሉቃ. 3፡9</ref>፤ <ref loc="MAT 12:33">ማቶ. 12፡33</ref>።</char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />ሃንሱን ካጣራ ካሄገሮል ፈሎ ኦትሶይ አዴስናታን።<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“ዳሩሪ ካግሮ ኣቦኬ ኮት ፈኢ አንፈሎን ግራን ‘ጎታ፥ ጎታ’ እን ካአማራ ዱባ ዎኖናት ካዳሩረ ላኮታባሮ። <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />ካጋቾ ፍርዳኮት አሪ ኦሞጋን ‘ጎታ፥ ጎታ፥ መገካይ ሄገሮ ላ አዬንሰላ?’ መገካይ ዱርሳ ላቤንሰላ? መገካይ ካሞጋን ባሳ ኖ ላፈልነላ? አምናራን። <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />ሀሱ ጎራታ ‘አን ዱዶ እስን ላካሶ፥ እስን ታሜላን ኦፈላታን እንኮ ፋክ አማ’ አም አዴስስ ሰግናራ።<note caller="-" style="x"><char style="xo" closed="false">7፡23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዛ. 6፡8</ref>።</char></note><verse eid="MAT 7:23" /></para>
  <para style="s1">ቃሮክና ጎዋኮክ ምን ማዳራታኖ</para>
  <para style="r">(<ref loc="LUK 6:47-49">ሉቃ. 6፡47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“ጎርታኑን ሂካ ሃፉራኬ ማለጉረ ፈሎ ካሀይሳራ ዱባ፤ ምን ኤኤሞ ጉት ካማዳራተሮ ቃሮክ እባዶት ኣን ላራ። <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />ኢዳሞ ካአትና ኡባተ፥ ዳድና ዳገ፥ አምባልና ኬተጉደ ኡሱ ምን ሻፍተ፥ ኤኤሞ ጉት ማንኮ ማዳራመሮ ማራንትኑ ላኮኢየሮ። <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />ሂካ ሃፉራኬ ማለጉረ ፈሎ ካሀይሶን አደ፤ ጬካሌ ጉት ምን ካማዳራተሮ ጎዋክ እባዶት ኣን ላራ። <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />ኢዳሞ ካአት ኡባተ፥ ዳድና ዳገ፥ አምባልና ኬተጉደ ኡሱ ምን ሻፍተ፥ ምና እዬ፥ ኢያኖና ጎሜላን ሌ።”<verse eid="MAT 7:27" /></para>
  <para style="s1">ኦዶናት ካየሱሳ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />የሱሳ ሂካ አየስ አዬሰ ካኮጉድሳረ ጎራታ ጎሳና አጋልስስኬሳ ሳደ። <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />ኣላንቲና አይሁድኮክ ሴራ ካአጋልስሳሮ አን ሀሌኖን ግራን ኦዶናት ካአቦ ኣን አጋልስሳ ማንኮግሬ ማራንያ።<note caller="-" style="x"><char style="xo" closed="false">7፡29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">ማር. 1፡22</ref>፤ <ref loc="LUK 4:32">ሉቃ. 4፡32</ref>።</char></note><verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">የሱሳና ማሪ ባር ካአባናየ እባዶት</para>
  <para style="r">(<ref loc="MRK 1:40-45">ማር. 1፡40-45</ref>፤ <ref loc="LUK 5:12-16">ሉቃ. 5፡12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />የሱሳ ዎዳምኮ ካኮዳጋረ ጎራታ ጎሳ ካሞጋን ኡሱ ዴበ ሰሴተ። <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />ሀሱ ጎራታ ማሪ ባር ካአባናየ እባዶት ኮ የሱሳ ቶስ ኤመተጉረ ሆረ ግልቢሰ ሳጋዳ፥ “ጎታ! ፈኢታ ጎሌተ እን ሙጭስን ዳንዳታ” አመ።<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />የሱሳና ገነቴሳ ድሪርሳተጉረ ድንድና፥ “አን ኩን ፈኢ ስሰራ! ሙጭም!” አመ። እባዶትና ጎርሰዋ ባርኮ ሙጭመ። <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />ኤሰኮና የሱሳ፥ “ፋያኖካ ማዮና አሮሰግተ፤ አየሱን ጎአመን ሴጉዴ እስኦታ ቱቃሞን ቱሳ፥ ሙሴ ኩን ካአጃጄሮ ሜባ ስስ ህክና እሶን አቶ ሌራ” አመ።<verse eid="MAT 8:4" /></para>
  <para style="s1">ካቦሎ ዎይቻትኮክ አማኖ</para>
  <para style="r">(<ref loc="LUK 7:1-10">ሉቃ. 7፡1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />የሱሳ ቅፍረናሆም ቶስ ጎጎታቤ፥ ካቦሎ ዎይቻት ካሌረ ኮ ኡሱ ቶስ ጋባላመረ፤ ሃ አመ ኤባተ። <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“ጎታ፥ ኢን ካሀንዳረክ ናፋለሳ ሌጉረ ኣሎ አቦሳ ዲያ ምንኬይ ሁዱረ ግራ” አመ።<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />የሱሳና፥ “አን ኤሜይጉረ ኡሱ ፋይስናራ” አመ።<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />ካቦሎ ዎይቻትና አባበረ፥ “ጎታ፥ አት ምንኬ ቶስ ታብን አን ላኮካዶትሳሮዮ፤ አየሱን ጎአመን ህታኒ ግራን ሃፉራ ኮ ካላል አዬስና፤ እዬን ካሀንዳረክና ፋይሮዋ። <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />አን መተኬዉን ካካለቱን ካሀንዳሮ ዎይቻያ፥ አንና እንኮ ሄገሌ እዬን ኦሀንዳራን አባ፤ እሶኮ ኮኔ ሴ አን ጎአምሮ ሴታራ፥ ካካለና ኮያ ጎአምሮ ኤመታራ፥ ኢን ካሀንዳሮነ ሂካ ፈል ጎአምሮ ፈላራ።”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />የሱሳና አባብኬሳ ሳደጉረ፥ ዴበ ሰሴታ ኦግሬነ ሃ አመ፥ “አን ሩምና አማራ፥ ኡል ካእስራኤል ኦሮኮ ሂካ ኣንክክ አማኖ ካአቦ እባዶ ኮና አን ላኮሄለሮ። <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />ኦሞጋና ምና ታብያንኮና ምና ታኢያንኮ ኤሜይናራን ዎኖናት ካዳሩረይ ባቦ ኣምን አብራመነ፥ ይሳቃነ፥ ያይቆባነ ራቶ ሀማጽናራን።<note caller="-" style="x"><char style="xo" closed="false">8፡11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">ሉቃ. 13፡29</ref>።</char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />ዎኖናት ካዳሩረ ኤካተ ኦኮንግረ አደ ሳርድ ጢልንጋክ ሙጉድ ቶስ ሻፋምናራን፥ ኤሰ እሶን ኦታና ኢልኮ ፎጫኖ ሌራ።”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />የሱሳና ካቦሎ ዎይቻትነ፥ “ሴ አማኖካ ማለ ኩን ሀሌዎ” አመ። ካሀንዳረኬሳና ጎርሰዋ ፋዬ።<verse eid="MAT 8:13" /></para>
  <para style="s1">የሱሳ እባዶ ካሞጋን ሀዉኣምኮ ፋይሳኖ</para>
  <para style="r">(<ref loc="MRK 1:29-34">ማር. 1፡29-34</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4፡38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />የሱሳ ምንካ ጴጢሮሳ ቶስ ካኮታባረ ጎራታ ሶዶ ታጴጢሮሳ ማር ጉበ ሀዉኣማ ታሁዱርተቶ ዴ። <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ኡሱና ገነትሴ ካኮድንድናረ ጎራታ፥ ማር ካጉባረና ጋፋረ፤ ኬተጉደ ኡሱን ሀንዳይተ።<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />ሄመን ላ ካኮሴታረ ጎራታ ዱርሳ ካአባመሮ ካሞጋን እባዶ የሱሳ ቶስ ከነን፥ ኡሱና ባቲክ አያናጆል ሃፉራኬሳ ቤሰ፤ ኩባሌሳል ዱባና ፋይሰ። <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />ሂካኒና ካሄገሮ እስያሳ ሃ አመ ኦአዬሰረ ሄገሮ፥ “ኡሱ ማር ኦሮክ ኩባ ካን አታተ ሀራኖካንና ስዳተ” ኦአማሜረን ሄገሮ ፈሎ ሀዬን።<verse eid="MAT 8:17" /></para>
  <para style="s1">የሱሳ ዴበ ካሰሴታሮ ልን ሙርት ዶትሳራ</para>
  <para style="r">(<ref loc="LUK 9:57-62">ሉቃ. 9፡57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />የሱሳ፥ ካሞጋን እባዶ ኡሱ ማራሙረ ኩኩ ካአመሮ ካኮ ድያረ ጎራታ በከኮ ጋማ ጎጎናቅናዉን አጃጄ። <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />ሀሱ ጎራታ ሴራ ካሙሴ ካአጋልስሳራ ኡሱ ቶስ ኤመተጉረ፤ “ካአጋልስሳቶ! አት ማንኮ ስያቶ ዱባ አን ኩ ዴበ ሰሴይናራ” አመ።<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />የሱሳና፥ “ጌዳላጆል ጉምቢ አባ፥ ካቡባራ ክምቢርና ምን አባ፥ ኤረ ካእባዶ አደ እስኦቴሳ ታኮፎልሲሳሮ ባንኤ ላኮአቦ” አመ አባበ።<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />የሱሳኮ ካአጋልሳታሮ ካሌራ ካካለ እባዶት ኮ አደ፥ “ጎታ! ጣይ ሴይረ አን ኣቦኬ ጎጎቃማላሮን ኢን ፈኢ ስስ” አመ።<note caller="+" style="f"><char style="fr" closed="false">8፡21</char><char style="fqa" closed="false">ጎጎቃማሎ፦ </char><char style="ft" closed="false">ኣቦኬሳ ታ ጎሮ ኦራይ ቃማላይን ታአቦ ፈኢ ካቱሳሮ ኣን ላራ። </char></note><verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />የሱሳ አደ፥ ኦጎይናራን ሬስክሶ ሀቃማሌን፤ “አት ጎአመን እን ዴበ ሰሴ” አመ።<verse eid="MAT 8:22" /></para>
  <para style="s1">የሱሳ ጋሽማሎ ጫልኢሰ</para>
  <para style="r">(<ref loc="MRK 4:35-41">ማር. 4፡35-41</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8፡22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />ኤሰኮ የሱሳ ዎላቦ ኦሮ ታበ፥ ኡሱኮ ኦአጋልሳታረና ኡሱ ዴበ ታቤን ሴተን። <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />ደራኣ ካአቲ ኢርጋዶ ኬጉረ ጋሽማሎ ዎላቦ ታ ልችስሮ ሻላጋመ፥ ሀሱ ጎራታ የሱሳ አደ ሁዱረ ግረ። <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />ኡሱኮ ኦአጋልሳታረና ጋባላመን ኡሱ ናባድሰን ጉሬን፥ “ጎታ! ባነዋ፥ ኖ ሃስ” አመን።<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />የሱሳና፥ “እስን አማኖ ኦኮንሀንቃተራ! ሙን ሂካማሌ አብሳታን?” አመ። ኤሰኮ ኬጉረ ኢርጋዶና ጋሽማሎ ሀድሰ፥ ጎርሰዋ በከ ቆደን።<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />እባዶና፥ “ሂክ ኢርጋዶና ጋሽማሎና ካኮን አጃጃማራን ምስክ እባዶትያ?” አማ ሳደን።<verse eid="MAT 8:27" /></para>
  <para style="s1">የሱሳ ባቲክ አያናይ ኦአባሜረን እባዶጃ ላማ ፋይሳኖ</para>
  <para style="r">(<ref loc="MRK 5:1-20">ማር. 5፡1-20</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8፡26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />የሱሳ በከኮ ጋማ ናቀጉረ፥ ገርገስኖ ካአማራን ኡል ጎጎጌይ ባቲክ አያናይ ኦአባሜረን እባዶጃ ላማ ታኮግሬን ባንኤ ታህዬልኮ ቤንጉሬን ኡሱነ ዎታ ኤሰሌን፤ እባዶና ኡሱ ራኔ ሮርን ታዋሮ ጊን ኣሎ ኦሜላንየን። <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />እሶና፥ “አት ኤረ ካዋ! ኖኔ ዎታ ሃጃ ታሜ አብታ? ጎራታ ሀጌኖን ግራን ኖ አቦስስን ኤመተ?” አመን ኦኬን።<note caller="-" style="x"><char style="xo" closed="false">8፡29 </char><char style="xt" closed="false"><ref loc="JDG 11:12">ዳኖ. 11፡12</ref>፤ <ref loc="2SA 16:10">2 ሳሜ. 16፡10</ref>።</char></note><verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />እሶኮ አባራን ፋክንተ ታሞጋን ቦዬ ቦባይተ ግቴ። <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />ዱርሳና የሱሳነ፤ “ኖ ካቤስናቶ ጎሌተ ታሞጋን ቦዬ ኦሮድ ጎጎታብኖ ኖ ጋፋርና” አመን ኤባተን።<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />የሱሳና “ሰዬን!” አመ። ዱርሳና እባዶጃኮ በጉረ ቦዬ ኦሮዴ ታበ፥ ቦዬል ዱባና ላጋ ቃርቃራኮ ሄገልዴተ ጋንጋላተ በከ ኦሮዴተ ኡባተደ ኤነጋንተ ጎተ። <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />ቦዬል ኦፎፋሬና ባቃተን ካታማ ቶስ ሴተን ጉሬን ካሌሮ አዬንሳ ዱርሳይ አባሜን ኦግረን እባዶጃ ጉት ካፈላመሮ አየስ ዱባ ሰሴጌን። <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />ሂካ ጋራይና ካካታማ እባዶ ዱባ የሱሳነ ዎታ ኤሰልን ቤ፥ ኡሱ ካኮድያረን ጎራታ ኡልክሶ ጋፋር ጎጎቤሮን ኤባተን።<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">ናፋለሳት እባዶትኮክ ፋያኖ</para>
  <para style="r">(<ref loc="MRK 2:1-12">ማር. 2፡1-12</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5፡17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />ኤሰኮ አባባተረ የሱሳ ዎላቦይ ታበ በከኮ ጋማ ናቀ ካታማቴሳ ቶስ ኤመተ። <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />ኤሰኮ እባዶ ናፋለሳት ኮ አልጋይ ስዴንጉሬን ኡሱ ቶስ ኣተን ኤመተን። የሱሳና አማኖክሶ ዴጉረ ናፋለሳትነ “ኮ አላማንደ! ጩቦካ ሀሄሶ አማመራ” አመ። <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />ሀሱ ጎራታ ሴራ ካሙሴ ካአጋልስሳራ፥ “ሂክ ዋ ሀባራኖያ” አማ ዎዳናትሶይ ጉምጉመን።<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />የሱሳ ቆፋትሶ አዴሰጉረ ሃ አመ፤ “ካሜላን አየስ ዎዳናትስኒ ሙን ቆፓታን? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />አፎ፥ ‘ጩቦካ ሀሄሶ አማመራ አማኖኮና’ ‘ክንጉዴ ሰሴ አማኖኮ ኤክያ ኤነ ካላራ’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />አየሱን ጎአመን ኤረ ካእባዶ ኡል ጉት ጩቦ ሀሄሶ ካኮአምሮ ኦዶናት ካአቦ ላኖ ጎጎአዴሳኑንያ” አመጉረ፤ ናፋለሳትነ “ክ አልጋታ ስዳዴ ምን ጋል” አመ። <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />ናፋለሳትና ኬጉረ ምንኬሳ ጋለ። <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />ጎሳና ሂካ ካኮድያረ ጎራታ ሳደ፥ አብሲና አማጋሜንጉሬን ሂካ ኣንክክ ኦዶናት እባዶን ካስሰሮ ዋ ጋላተን።<verse eid="MAT 9:8" /></para>
  <para style="s1">ኡማማኖ ካማቶሳ</para>
  <para style="r">(<ref loc="MRK 2:13-17">ማር. 2፡13-17</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5፡27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />የሱሳ ኤሰኮ ኬጉረ ሴታ ግራን ማቶሳ ካአማማረ እባዶት ኮ ቃራጣ ታኮሙራኔን ባንኤ ካሀማጼሮ ዴጉረ “እን ዴበ ሰሴ” አመ፤ ኡሱና ኬጉረ የሱሳ ዴበ ሰሴተ።<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />የሱሳ ምን ካማቶሳ ኣሞ ጉት ግራን ኦሞጋን ቃራጣ ኦኩኩይሳሬና ጩባሌይል ኤመተንጉረን ኡሱነ ዎታና ኡሱኮ ኦአጋልሳታራነ ዎታ ባቦ ኣምን ሀማጼን። <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />ካፋራሳው እባዶና ሂካ ካኮድያረን ጎራታ የሱሳኮ ኦአጋልሳታረነ፥ “እስን ካአጋልስሳራ ቃራጣ ኦኩኩይሳራነና ጩባለይልነ ዎታ ምሲ አማራ?” አመን ሆሳተን።<note caller="-" style="x"><char style="xo" closed="false">9፡11 </char><char style="xt" closed="false"><ref loc="MAT 15:1-2">ማቶ. 15፡1-2</ref>።</char></note><verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />የሱሳና እሶ ካአዬሳራን ማለጉረ ሃ አመ፥ አኪም ካኮንዶትሳራ ኩባሌሳሉንያ ኳሬ ፋያሌሳን ላኮዮ። <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />ሴየንጉዴን፥ “አን ጃርሶኮ ሮርሰ ሻጋ ጌላታራ ካአማመሮ ሃፉራኮክ ፉሬን አጋልሳዬን። አን ካኮንኤሜየራ ጩባለሳሉን ኳሬ ቁሉክ ኡምን ላኮኤሜየሮ” አማመ ማጻፋ ቁሉክ ማንኮጻፋመሮ ማራንያ አመ።<note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሆሴ 6፡6</ref>፤ <ref loc="MAT 12:7">ማቶ. 12፡7</ref>።</char></note><verse eid="MAT 9:13" /></para>
  <para style="s1">የሱሳኮ ኦአጋልሳታራን አጋቡዋና ዋትኮት ኣላንቲ</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር. 2፡18-22</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5፡33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />ሀሱ ጎራታ ካጣማቃሮ ያንሳኮ ኦአጋልሳታራን የሱሳ ቶስ ኤመተንጉረን “ኖና ፋራሳዊልና አርጌቶ ጎአጋቡይኖ ኩኮ ኦአጋልሳታራን አደን ሙን አጋቡዋና ዋታራን?” አመን የሱሳ ሆሳተን።<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />የሱሳና፥ “ካማሻሸ እሶነ ዎታ ግራን ሃስኖን ታኤመተታ ማርት ምሲ ጋድን ዳንዳታ? ካማሻሸ እሶኮ ካኮአታምናራ ጎራታ ኤመታራ፤ ሀሱ ጎራታ አጋቡይናራን አመ።<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“ሳርስ ካዶአን ጉት ታኡሱብት ኤርበ ካካታራ እባዶ ላኮግሮ፥ ካካተ ጎሌ አድ ታኡሱብት ኤርበ ካዶአን ሳርስ ጉኮ ታታርሽተጉደ ቡቶ ኢቱ ባላኣታራ። <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />ካዶአን ድንቢቶ ካኡሱብ ጣሞ ካዎይኒ ማዮና ላኮክባታሮ፥ ጎክባተ አደ ድንቢቶ ኤባራ፥ ጣሞ ካዎይኒና ኡባታራ፥ ድንቢቶና ላኦ ላኮአቦ፥ አየሱን ጎአመን ካኡሱብ ጣሞ ካዎይኒ ካኡሱብ ድንቢቶ የላማራ፥ ሂካ ጋራይ ጣሞ ካዎይኒና ድንቢቶና ጎኢዳን እስኦረ አዳላታራ።”<verse eid="MAT 9:17" /></para>
  <para style="s1">ጎይኮ ታኬተቶ ኡኑትና ኢግ ታኮኡባታረ ሄለልትቲኮክ ፋያኖ</para>
  <para style="r">(<ref loc="MRK 5:21-43">ማር. 5፡21-43</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8፡40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />የሱሳ እባዶ አዬስሳ ግራን፥ አይሁድኮክ ዎይቻት ኮ ኡሱ ሆረ ግልቢሰጉረ፥ “ኡኑት ግዳ ጎተታ ኔፎነ ጎጎሄሶ ኤሜደ ገነታ ኤሰ ጉት ካይ” አመ። <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />የሱሳና ኬጉረ ዎይቻትነ ዎታ ሴተ፥ የሱሳኮ ኦአጋልሳታረና ኡሱ ዴበ ኬን።<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />ኤሰኮ ጌስ ቶሞንኮ ላማ ዱባ ኢግ ኡባታ አቦሳ ዲያ ታግቴ ሄለልትቲ ቶ ሃሬ ኤሜተጉደ ሳርስኬሳ ድንተ።<note caller="-" style="x"><char style="xo" closed="false">9፡20 </char><char style="xt" closed="false"><ref loc="NUM 15:38">ቶቶ 15፡38</ref>፤ <ref loc="DEU 22:12">አዳ. 22፡12</ref>።</char></note> <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />ኤሰና ዎዳናትሴይ፥ “ሳርስኬሳ ጎድነ ሱረ ፋይናራ” አማ ግቴ።<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />የሱሳና ሃር አባባተ ሄለልትቲ ዴጉረ፥ “አላማንደ ኡኑት! አማኖካ ኩ ፋይሰራ” አመ። ሄለልትቲና ጎርሰዋ ፋይተ።<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />የሱሳና ምን ዎይቻት ቶስ ጎጎጌይ ማላካታ ኡፉፋ፥ ኦታና ኦይሳ ካግረ ጎሳ ዴጉረ፥ <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />“ዱባና ሂታኮ ብያ ኡኑ ሁዱርተታ ኳሬ ላኮጎተቶ” አመ። እሶ ጎአመን ቃጭፋታ ኦሶሌን። <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />እባዶ ምን ኦሮኮ ካኮብያረ ጎራታ ምን ኦሮዴ ታበጉረ ገነትሴ አበ፥ ኡኑና ኬተ። <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />ኦዱና ኡሱ ኡል ዱባ ዳርኣንተ።<verse eid="MAT 9:26" /></para>
  <para style="s1">የሱሳ ኢልኦ ካድያኖን እባዶ ላማ ፋይሰ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />የሱሳና ኤሰኮ ቤ ሴታ ግራን ኢልኦ ካድያኖን እባዶ ላማ፥ “ኤረ ካዳዉተ! ማር” አማ እያ ኡሱ ዴበ ሰሴተን።<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />ኢልኦ ኦደያኖና የሱሳ ካታበሮ ምን ቶስ ዴበ ታቤን፤ የሱሳና፥ “አን ኢልኦ ኦትስን ደንዴሲን ካዳንዳሮ ላኖ አማናታን?” አመ እሶ ሆሳተ። እሶና “እእ ጎታ” አመን አባበን።<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />ኤሰኮና የሱሳ እልኦ ኦትሶ ድንድነጉረ፥ “አማኖክስንክ ማለ ሀሌዎ” አመ። <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />ኢልኦ ኦትሶና ዴንዴን፤ የሱሳና፥ “ሂካ ማዮና አሮአዴሶ” አመ አታይሰ ሰገ። <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />እሶ ጎአመን ኤሰኮ ቤንጉሬን ኡሱ ኡሊ ካግሮ እባዶ ዱባን ጋራ ካየሱሳ አዬሴን።<verse eid="MAT 9:31" /></para>
  <para style="s1">የሱሳ ህኢ ካአዬሶን እባዶት ፋይሰ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />እልኦ ኦኮንባናሜራን እባዶጃ ኤሰኮ ብያግራን ባቲክ አያና ካአባመረ ህኢ ካአዬሶን እባዶት ኮ የሱሳ ቶስ ከነን። <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />ባቲክ አያናና ካኮብያረ ጎራታ ህኢ ካአዬሶን አዬሳኖ ሀጋአበ፤ ጎሳና ሳደጉረ፥ “ሂካ ኣንክክ አየስ ኡል ካእስራኤል ሙተ ላካሶ” አመ።<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />ካፋራሳውል እባዶ አደ፥ “ኡሱ ዱርሳ ካኮቤሳራ ካዱርሳ ዎይቻይያ” አመን።<note caller="-" style="x"><char style="xo" closed="false">9፡34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">ማቶ. 10፡25</ref>፤ <ref loc="MAT 12:34">12፡34</ref>፤ <ref loc="MRK 3:22">ማር. 3፡22</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11፡15</ref>።</char></note><verse eid="MAT 9:34" /></para>
  <para style="s1">ነኔኤይሳታኖ ካየሱሳ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />የሱሳ ካአይሁድ ምን ካኤብ አጋልስሳ ግራን፥ ዎኖናት ካዋኮክ ገጌሎ ላላባ ግራን፥ አደና ማር ኦሮክ ኩባ ካሀዉአማሮ ዱባ ፋይሳ፥ ካታማሊና ማማንጆሊ ማራሙረ።<note caller="-" style="x"><char style="xo" closed="false">9፡35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ. 4፡23</ref>፤ <ref loc="MRK 1:39">ማር. 1፡39</ref>፤ <ref loc="LUK 4:44">ሉቃ. 4፡44</ref>።</char></note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />ጎሳና ካፎፍሮ ካዋተ እዳድ ኣን ያዳና ካዴሮ ካሊክ ሌን ኦግራን ካኮድያረ ጎራታ ነኔኤይሳተ።<note caller="-" style="x"><char style="xo" closed="false">9፡36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ቶቶ 27፡17</ref>፤ <ref loc="1KI 22:17">1 ዎኖ. 22፡17</ref>፤ <ref loc="2CH 18:16">2 ኦዱ 18፡16</ref>፤ <ref loc="EZK 34:5">ሕዝ. 34፡5</ref>፤ <ref loc="ZEC 10:2">ዛኪ. 10፡2</ref>፤ <ref loc="MRK 6:34">ማር. 6፡34</ref>።</char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />የሱሳና ኡሱኮ ኦአጋልሳታራነ ሃ አመ፥ “ካኩኩአምናራ ካም ካሞጋንያ፥ ኦፈልናራን ጎአመን ኡጫርያን፥ <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />ሃንሱን ካኩኩምናሮ ካምኮክ ጎታ ኦፈላራን ካኩኩአማሮ ካም ቶስ ጎጎፋሮን ኤባየን” አመ።<note caller="-" style="x"><char style="xo" closed="false">9፡38 </char><char style="xt" closed="false"><ref loc="LUK 10:2">ሉቃ. 10፡2</ref>።</char></note><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">ቶሞንኮ ላማ የሱሳኮ ኦአጋልሳታራን</para>
  <para style="r">(<ref loc="MRK 3:13-19">ማር. 3፡13-19</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6፡12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />የሱሳ ኡሱኮ ኦአጋልሳታራን እስ ቶስ ኡመጉረ ባቲክ አያናጆል ጎጎቤስናዉና ማር ኦሮክ ኩባና ሀዉኣም ዱባ ጎጎፋይስናዉን እሶን ኦዶናት ስሰ።<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />ቶሞንኮ ላማ ኦፋራሜራንኮኒዕ መገክሶ ሂካያ፤ እሶና [ጴጢሮሳ ካአማመሮ] ስሞናና አቢኬሳ እንድራሳ፥ ይስ ካዛብዶሳ ያይቆባና አቢኬሳ ያንሳ፥ <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />ፍልጶሳና በርተሎሜዎሳ፥ ቶማሳና ቃራጣ ካኩኩይሳረ ማቶሳ፥ ይስ ካኢልፎሳ፥ ያይቆባና ታድዮሳ ካአማማሮ ልብድዮሳ፥ <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />ኡልኬሳን ካዉድታማሮ ስሞና፥<note caller="+" style="f"><char style="fr" closed="false">10፡4</char><char style="fqa" closed="false">ቀናኢ ስሞና፦ </char><char style="ft" closed="false">ሂካ ስሞናን ካላም ካስሳመራ መገ፥ ባንኤ ባንኤይ ፉሬን ምን ካዋዉን ካዉድታማሮያ ጎአምሮ፥ ካካለ አደ ባልቹማ ታቤሳቶ ኡናኮ ኮያ አማራን። </char></note> ሃሬ የሱሳ ሮርሰ ካስሰሮ ካአስቆሮቱ ይሁዳ።<verse eid="MAT 10:4" /></para>
  <para style="s1">ኦፋራመራን ቶሞንኮ ላማ አጋልስስን ፋራማኖ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />የሱሳ ሂናኣ ኦፋራመራን ቶሞንኮ ላማ ሃ ካአማሮ ሀንዳነ ዎታ እሶ ፋረ፥ “አይዛብ ቶስ አሮሴቴን፤ ማኤት ታሳማርያ ካታማ ቶንሳ አሮታብቴን፤ <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />ሴቶ ጎሄሶን እዳድ ኣን ምን ካእስራኤልኮ ካባየሮ ጎሳ ቶስ ሴዬን። <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />ሴየንጉዴን ‘ዎኖናት ካዳሩረ ጋባላመራ’ አማ ላላባ።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">ሉቃ. 10፡4-12</ref>።</char></note> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />ኩባሌሳልና ፋይሳ፥ ካጎየሮ እባዶና ኬሳ፥ ማሪ ባር ካአቦና ባርኮ ሙጭሳ፥ ዱርሳና ቤሳ፥ አዳ. ካአታቴታና አዳ. ስሳ። <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />ኪሲትስን ዎርቂ ሌረ ብር ታአማማቶ ማርጮኮ ጎርቱን መዳብኮ ካፈላመሮ ማራጋደ አሮአባቴን። <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />ራክስኑና ሽለ፥ ቆሎ ላማ፥ ጎርቱን ከፈሮ ጎርቱን ዳማ አሮአባቴን፤ ኣላንቲና ካፈላሮን ባቦ ስሳምን ዶትሳራ።<note caller="-" style="x"><char style="xo" closed="false">10፡10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9፡14</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5፡18</ref>።</char></note><verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“ካታማ ጎርቱን ማማን ኮ ቶስ ጎታብቴን እስን ቆጳይን ፈኢ ካአቦ እባዶት ዶታጉዴን ኡሱ ምኒ ፎልሳዬን፤ ታቤታን ኤሰ አዳላየን። <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />ምን ካማካዮና ጎታብቴን ኖጎዳ አታ። <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />እስን ካቆጳታራን ጎሌ፥ ኖጎዳትስን ኡሱ ምን ሀሌቶ፥ እስን ካቆጳኖን ጎሌ አድ፥ ኖጎዳትስን እስኑን ሀአባባቶ። <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />ማምስክ እባዶትና እስን ቆጳታና ጎዋተ ጎርቱን እስን ካአዬሳታን ማላና ጎዋተ ሀሱ ምንኮ ጎርቱን ሀሴ ካታማኮ ብያግራን እሶን ሴርሳኖ ጎጎሌሮን ሉቃኦትስንኮ ጎራ ሁርጉፋየንዴን ብያ።<note caller="-" style="x"><char style="xo" closed="false">10፡14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ኦፋ. ፈ. 13፡51</ref>።</char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />አን ሩምና አማራ፥ ታፍርዳ አሪ ሀሴ ካታማይ ታግናቶ ሙሮኮ ሶዶምና ጎሞራይ ታግናታ ሙሮ ታፉፉዳተ ለታ።”<note caller="-" style="x"><char style="xo" closed="false">10፡15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">ማቶ. 11፡24</ref>፤ <ref loc="GEN 19:24-28">መጣ 19፡24-28</ref>።</char></note><verse eid="MAT 10:15" /></para>
  <para style="s1">ኤመይን ታግቶ ራኮ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13፡3-13</ref>፤ <ref loc="LUK 21:12-17">ሉቃ. 21፡12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“እዳድ ኣን ህዬይ ኦሮ አን እስን ፋርናራ፥ ሃንሱን ሀበሳ ኣን ቃሮሌ፥ አራበ ኣን ፋያንካኒዕ ላ።”<note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">ሉቃ. 10፡3</ref>።</char></note><verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />“እባዶና እስን አብጉረ ፍርዳዉን ሾንጎ ቶስ ጌስናራን፤ አይሁድኮክ ምን ካኤብና እስን ቦጭናራን፥ ሃንሱን እሶኮ እስኦራዬን።<note caller="-" style="x"><char style="xo" closed="false">10፡17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">ማር. 13፡9-11</ref>፤ <ref loc="LUK 12:11-12">ሉቃ. 12፡11-12</ref>፤ <ref loc="LUK 21:12-15">21፡12-15</ref>።</char></note> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />ኣላንቲቴይ ሞትጆል ቶንሳ ዎኖላል ቶስ ፍርዳን እስን ጌስናራን፤ እሶ ሆረና አይዛብ ሆረ እን አቶ ልናታን። <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />ፍርዳን ሾንጎ ቶስ እስን ካኮጌሴን ጎራታ መም አዬንሳ? መ አም አባብና? አም አሮያዴን፥ ሀሱ ጎራታ ታአም አዬሳን እስኑን ስሳንቶዋ። <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />እስኒ ካአዬስናራ ካዳሩረ ኣቦክስንክ አያና ካዋያ ኳሬ ላኮእስንታን።”<note caller="-" style="x"><char style="xo" closed="false">10፡20 </char><char style="xt" closed="false"><ref loc="MRK 13:12">ማር. 13፡12</ref>፤ <ref loc="LUK 21:16">ሉቃ. 21፡16</ref>።</char></note><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“አቢ አቢኬሳ ጎይን ሮርስ ስስናራ፥ ኦዶና ኤረኬሳ፥ ይንሳ እሶ ኦኡሙለራን ጉት ኪናራን፥ ላጋድስናራን። <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />ኣላንቲቴይ እባዶ ዱባ እስን ዲድናራ፤ አየሱን ጎአመን ታጋቾ ጌሮ ካአታተ ኡሱ ፋይናራ።<note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">ማቶ. 24፡9</ref>፥<ref loc="MAT 24:13">13</ref>፤ <ref loc="MRK 13:13">ማር. 13፡13</ref>፤ <ref loc="LUK 21:17">ሉቃ. 21፡17</ref>።</char></note> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />ባንኤ ቶኮ ጎሆሮሬን ባንኤ ታካለ ቶስ ባቃዬን፤ አን ሩምና አማራ፥ እስን ታእስራኤል ካታማል ፈሎኦትስን ፈል አንጉሳኖን ግራን ኤረ ካእባዶ ኤመይናራ።”<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“ካአጋልሳታራ፥ ካአጋልስሳሮኮ ካሃንዳራ ጎታኬሳኮ ላኮሮራሮ።<note caller="-" style="x"><char style="xo" closed="false">10፡24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">ሉቃ. 6፡40</ref>፤ <ref loc="JHN 13:16">ያን. 13፡16</ref>፤ <ref loc="JHN 15:20">15፡20</ref>።</char></note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />ካአጋልሳታራ ካአጋልስሳሮ ኣን፥ ካሃንዳራና ጎታኬሳ ኣን ጎሌ ሌራ። ኦዶምኔክሶ ‘ብኤልዘቡል’ አም ጎኡመ፥ ካምነ እባዶ ሂካኮ ካሮረ ካሜላን መገ ምሲ ኡምን ዋታራን?”<note caller="-" style="x"><char style="xo" closed="false">10፡25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9፡34</ref>፤ <ref loc="MAT 12:24">12፡24</ref>፤ <ref loc="MRK 3:2">ማር. 3፡2</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11፡15</ref>።</char></note><verse eid="MAT 10:25" /></para>
  <para style="s1">አዮ አብሳይን ዶትሳሮ</para>
  <para style="r">(<ref loc="LUK 12:4-7">ሉቃ. 12፡4-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“ሃንሱን እባዶ አሮአብሳቴን፥ ጎላተ ካግራ ዲዳ ሀቤኖን፥ ስያመ ካግራ ሀሙቶን ላኮሄስሮ።<note caller="-" style="x"><char style="xo" closed="false">10፡26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4፡22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8፡17</ref>።</char></note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />ሃንሱን አን እስኑን ሙጉዲ ካሰገሮ ኢፋይ አዬሳ፥ ነበትስኒ ካማልቴታን ዲዳ ቤሳ አዋጃ። <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />ሶ ላጋዲን ኳሬ ኔፎ ላጋዲን ካዳንዴኖን እባዶኮ አሮአብሳቴን፤ ሀሱኮ ኔፎና ሶና ታባኖን ኤለኒ ባስን ካዳንዳሮ ዋ አብሳዬን። <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />ዶልቺ ቶይ ካዳዳላማሮ ክምብር ላማኮ ቶና ካዳሩረ ኣቦክስንኮት ፈኢ ካላይ ኡሊ እ ላኮሄሶ። <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />መተክስንክ ብናናኮ ዱዶ ኮና ሀሄሶን ዱባ ካቶታመያ። <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />ሃንሱን አሮአብሳቴን፥ ካሞጋን ክምብርጆልኮ ሙራትስን ታካባጃንተታ።”<verse eid="MAT 10:31" /></para>
  <para style="s1">እባዶ ሆረ ክርስቶሳ አቶታኖ</para>
  <para style="r">(<ref loc="LUK 12:8-9">ሉቃ. 12፡8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“አን ካክርስቶሳያ አመ ጋራኬ እባዶ ሆረ ካአቶታሮን አንና ዳሩሪ ካግሮ ኣቦኬ ሆረ አቶትናራ። <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />አየሱን ጎአመን እባዶይ ሆረ እን ካካካታሮን አንና ዳሩሪ ካግሮ ኣቦኬይ ሆረ ኡሱ ካካይናራ።”<note caller="-" style="x"><char style="xo" closed="false">10፡33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 ጢሞ. 2፡12</ref>።</char></note><verse eid="MAT 10:33" /></para>
  <para style="s1">ኖጎዳ አንሌኖን ግራን ካለካለ ብያኖ</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“አን ካኮንኤሜየራ ኡሉን ኖጎዳ ኬኒን ላኮዮ፤ ካለካለ ቤስን ኳሬ ኖጎዳ ኬኒን ካኤመየሮ ኣን እስኑን አሮሌኖ። <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />አን ካኮንኤሜየራ፥ ኤረ ኦዶኬሳኮ፥ ዴለልትቲ ኣየትሴኮ፥ ኦርኤረና ሶዶትሰኮ እስኮ ዳርኢንያ። <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />እባዶን ዲና ካላራ ካኬሳ ካምነ እባዶዋያ።”<note caller="-" style="x"><char style="xo" closed="false">10፡36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚኪ. 7፡6</ref>።</char></note><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“እንኮ ሮርሰ ኣቦኬሳ ጎርቱን ኣየቴሳ ካጌላታራ ካኬ ሊን ላኮዶትሳሮ፥ እንኮ ሮርሰ ባባርትት ጎርቱን ዴለልትቲ ካጌላታራ ካኬ ሊን ላኮዶትሳሮ። <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />ማስቃልተሳ ስዳይረ ታጎሮን እን ዴበ ካሰሰኖን ካኬ ሊን ላኮዶትሳሮ።<note caller="-" style="x"><char style="xo" closed="false">10፡38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">ማቶ. 16፡24</ref>፤ <ref loc="MRK 8:34">ማር. 8፡34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9፡23</ref>።</char></note> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />እስኦቴሳ ፋይሳይን ካዶታታራ ባሳታራ፥ እስኦቴሳ እን ማራን ሮርሳይ ስሳይን ካዶታታራ አደ ፋይሳታራ።<note caller="-" style="x"><char style="xo" closed="false">10፡39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">ማቶ. 16፡25</ref>፤ <ref loc="MRK 8:35">ማር. 8፡35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9፡24</ref>፤ <ref loc="LUK 17:33">17፡33</ref>፤ <ref loc="JHN 12:25">ያን. 12፡25</ref>።</char></note><verse eid="MAT 10:39" /></para>
  <para style="s1">ጋራ ካባርአራ</para>
  <para style="r">(<ref loc="MRK 9:41">ማር. 9፡41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“እስን ካአታታራ እን አታታራ፥ እና ካአታታራ አደ እን ካፋረሮ ኦዶ አታታራ።<note caller="-" style="x"><char style="xo" closed="false">10፡40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">ማር. 9፡37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9፡48</ref>፤ <ref loc="LUK 10:16">10፡16</ref>፤ <ref loc="JHN 13:20">ያን. 13፡20</ref>።</char></note> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />ካሄገሮና ካሄገሮኮክ መገይ ካአታታራ ካሄገሮኮት ሙራ ሄላታራ፥ ቁሉክና ቁሉማኮክ መገ ካቆጳታራ ቁሉማኮት ሙራ ሄላታራ። <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />ሃንሱን አን ሩምና አማራ፤ ማምስክ እባዶና ሂናኣ ኦትዲጫርኮ ኮ እንኮ ካአጋልሳታሮን ቁልዱቦ ቶ በከ አምባልኒዕ ካስሰ ኡሱ ሙራ ላኮዋሮ።”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">ካጣማቃራ ያንሳ የሱሳ ቶስ ታፋረሮ ሆሲን</para>
  <para style="r">(<ref loc="LUK 7:18-35">ሉቃ. 7፡18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />የሱሳ ኡሱኮ ኦአጋልሳታራን ቶሞንኮ ላማን አጃጃ ስሰ አባባተረ፥ አጋልስስና ላላብን ካታማልትሶ ቶስ ሴተ።<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />ካጣማቃረ ያንሳ ምን ካሻኖ ግራን ክርስቶሳ ፈላ ኦግሮ ፈሎ ካኮማላረ ጎራታ ኡሱኮ ኦአጋልሳታራን ኡሱ ቶስ ፋረጉረ፥ <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“ኤመታራ አማማተ ካኦራማተ ክርስቶሳ አትታ? ሙ ካካለ ኦራና?” አመን ሆሳተን።<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />የሱሳና አባበረ፤ “ሴየንጉዴን ካማላታና ካድያታን ያንሳን ሰጋ። <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />እልኦ ኦድያኖና ድናራን፥ ናፋለሳልና ሰሴይናራ፥ ማሪ ባር ኦአባና ሙጭአምናራን፥ ነቤ ኦማሎና ማልናራን፥ ኦጎየራና ኪናራን፥ ህየሳሉና ካገጌሎ ዎንጋላ ላላባምናራ፤<note caller="-" style="x"><char style="xo" closed="false">11፡5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ. 35፡5-6</ref>፤ <ref loc="ISA 61:1">61፡1</ref>።</char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />እን ካሄዳኖን ካሶማሳመያ” አመ።<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />ያንሳኮ ኦአጋልሳታራን ሴተን ካኮቡዋሬን ጎራታ፤ የሱሳ ጋራ ካያንሳ ጎሳን ሃ አመ አዬሰ፥ “ቃሉላቶክ ኡል ቶስ መ ድን ቤተን? አምባል ካአኢሳቶ ፊቀ ዲንያ? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />ሀያ መ ድን ቤተን? ሳርስ ካኢዳሮ ካሳርሳተሮ እባዶያ? ሳርስ ካእዳን ሳርሳቴን ኦኢዳራን ምን ካዎኖላል ግራንዋ። <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />ሀያ መ ድን ቤተን? ካሄገሮ ዲንያ? እ ዱዶዋ ካሄገሮኮና ካሮረያ። <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />ሃ አማመ ማጻፋ ቁሉክ ካኮንጻፋመራ ኡሱያ፥ ‘ራካ ጎጎኤካስሮን ኤርግቻ ኩኮ ሆረነ ፋርናራ።’<note caller="-" style="x"><char style="xo" closed="false">11፡10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3፡1</ref>።</char></note><verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />“አን ሩምና አማራ ሄለልኮ ካአላተሮ ኦሮኮ ካጣማቃሮ ያንሳ ኣንክክ ላኮግሮ። አየሱን ጎአመ ዎኖናት ካዳሩረይ ዱባንኮ ካየራታራ ኡሱ ጂናታራ። <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />ያንሳ ካኮጣማቃረ ጌስኮ ሀጋአበረ ህታር ታ ጌሮ ዎኖናት ካዳሩረ ካሞጋን ዲዳምናራ፥ ኣሎ አታቴን ኦዶታታራን ሄላይናራን፥ <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />አጋልስስ ካሄገሮል ዱባና ሴራ ካሙሴ ታ ካጣማቃረ ያንሳ ገራኒ ሄገሮ አዬሰራን።<note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">ሉቃ. 16፡16</ref>።</char></note> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ጎርታ እሶ ካአዬሰናን አታይን ጎዶታቴን ኡሱና ኤመይናራ ካአማመረ ኤላሳ ሂካ ያንሳያ።<note caller="-" style="x"><char style="xo" closed="false">11፡14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፡5</ref>፤ <ref loc="MAT 17:10-13">ማቶ. 17፡10-13</ref>፤ <ref loc="MRK 9:11-13">ማር. 9፡11-13</ref>።</char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />ነበ ካአባ ሀማሎ!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“ህታ አላታን መነ ዎታ ሄሬግስራ? ግያይ ሀማጼንጉሬን ሃ አማ እስ እስ ካኡማታሮ ይስ ኣን ላራን።” <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />“ ‘ሱሱሌ ኡፉፍነ ላኮዱዱርተታን፥ ቦቾ ቦችነዋ ላኮኦቴን’<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />ያንሳ አሞኮና ጣሞኮ እስኦራተ ማንኮኤሜተ ማራን ‘ኡሱ ባቲክ አያናጆል አባ!’ አመን። <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />ኤረ ካእባዶ አማና ጣማ ኤመተ፥ እሶና ኡሱ ‘ካአማሮና ካጣማሮያ! ኡሱማሌ፥ ቃራጣ ኦኩኩይሳራና “ጩባለይጆል” ’ ካጌላታሮያ አመን። ቃሩማ ጎአመን ፈሎኦትሴይ አዴሳንተ።”<verse eid="MAT 11:19" /></para>
  <para style="s1">ጩቦኮ ጉላ ጋላናዋቲ ካዎቃሳመሮ ካታማል</para>
  <para style="r">(<ref loc="MAT 11:20-24">ማቶ. 11፡20-24</ref>፤ <ref loc="LUK 10:13-15">ሉቃ. 10፡13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />ኤሰኮና የሱሳ ካሞጋን ባሳ ታኮፈለሮ ካታማል ጩቦኮ ማንኮ ጉላ ጋላናዋተን ማራን ሃ አመ ዎቃሴ፥ <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“ኣኔ ኮራዝ! ኣኔ ቤተሳይዳ! እስኒ ካፈላመራ ባሳ ጢሮሲና ስዶናይ ካፈላመሮ ሊ ግረዋ፥ ሆርኮዋ ሳርስ ጋምባላክ ሳርሳይ ቡሉሎ ማሪ ክክባይ ጩቦኮ ጉላ ጋል ግራሬንዋ።<note caller="-" style="x"><char style="xo" closed="false">11፡21 </char><char style="xt" closed="false"><ref loc="ISA 23:18">ኢሳ. 23፡18</ref>፤ <ref loc="EZK 26:1">ሕዝ. 26፡1</ref>፤ <ref loc="EZK 28:26">28፡26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3፡4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ. 1፡9-10</ref>፤ <ref loc="ZEC 9:2-4">ዛኪ. 9፡2-4</ref>።</char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />ሃንሱን አን እስኔ ሃ አማራ፥ ታፍርዳ አሪ እስንኮ ሮር ጢሮስዉና ስዶናዉን ሙሮ ሱረ ፉፉዳይናራን። <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />አት ቅፍረናሆም ዳሩር ቶስ ጦቂ ጦቂ አምን ዶታተ? አየሱን ጎአመን ቦዋ ኦሮድ ኢናታ! ኩዬ ካፈላመራ ባሳ ሶዶሚና ፈላም ግረዋ ህታር ጊን ኤሰ ካታማ ግራተዋ።<note caller="-" style="x"><char style="xo" closed="false">11፡23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14፡13-15</ref>፤ <ref loc="GEN 19:24-28">መጣ 19፡24-28</ref>።</char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />ሃንሱን አን ሩምና ኩን ሃ አማራ፥ ታፍርዳ አሪ ታግናታ ሙሮ ታታኮ ሮር ሶዶሚን ፉፉዳይናታ!”<note caller="-" style="x"><char style="xo" closed="false">11፡24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">ማቶ. 10፡15</ref>፤ <ref loc="LUK 10:12">ሉቃ. 10፡12</ref>።</char></note><verse eid="MAT 11:24" /></para>
  <para style="s1">ክርስቶሳ ታስሳሮ ፎልሲ</para>
  <para style="r">(<ref loc="LUK 10:21-22">ሉቃ. 10፡21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />ሀሱ ጎራታ የሱሳ፥ “ካዳሩረና ካኡሌ ጎታ ኣቦ! ሂካ ቃሮሌልኮና ኦካሳንኮ ጎሊሰደ ይሱን ማንኮቱሰ ማራን አን ኩ ጋላታራ፥ አመ። <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />እ ኣቦክ! ሂክ ኩ ሆረ ፈኢ ታኢዳን ሌተ ኩን ሙተ።<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“ኣቦክ ካመን ዱባ ኢን ስሰራ፥ ኦዶኮ ካካለ ኤረ ካካሳ ማዮና ላኮግሮ። ኡሱማለና ኤረኮ ካካለ ኦዶ ካማላብራ ላኮግሮ፥ ኤረ ኦጌላተሮን ጎቱሰ ኳሬ ኦዶ አዴስን ካዳንዳራ ማዮና ላግሮ።<note caller="-" style="x"><char style="xo" closed="false">11፡27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ያን. 3፡35</ref>፤ <ref loc="JHN 1:18">1፡18</ref>፤ <ref loc="JHN 10:5">10፡5</ref>።</char></note><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“እስን ስዳነ ካኮንኢስላተታ! ኦሀርቴታን ዱባ እን ቶስ ኮዬን! አንና ፎልሲ ስስናራ። <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />ሀርቆታኬና ስዳዬን፥ ኢንኮና አጋልሳዬን፥ አን ዎዳናቴይ ፋያንካና ካኦብሳሮያ፥ ኔፎትስኑና ፎልሲ ሄላይናታን።<note caller="-" style="x"><char style="xo" closed="false">11፡29 </char><char style="xt" closed="false"><ref loc="JER 6:16">ኤር. 6፡16</ref>።</char></note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />ሀርቆታክ ካእስላኖን ስዳነትና ታፉፉድታ።”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">ታፎልሲ አሪ ካባጃኖኮክ ጋራ</para>
  <para style="r">(<ref loc="MAT 12:1-14">ማቶ. 12፡1-14</ref>፤ <ref loc="MRK 2:23-28">ማር. 2፡23-28</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6፡1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />ኤሰኮ አባባተረ የሱሳ ታፎልሲ አሪ ዉጣ ኦሮ ማረ ሮረ፥ ኡሱኮ ኦአጋልሳታራና ማንኮኡኤሬን ማራንትኑ ሻዉዬኮ ኤብሳቴን ኣተን ኣማኖ ሀጋአበን።<note caller="-" style="x"><char style="xo" closed="false">12፡1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">አዳ. 23፡25</ref>።</char></note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />ፋራሳዊልና ሂካ ዴንጉሬን፤ “ሂካ ዴ! ኩኮ ኦአጋልሳታራን ታፎልሲ አሪ ፈላሚን ኦዶትሶን ፈሎ ፈላ ግራን” አመን።<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />የሱሳና፥ “ዳዉተና ኡሱነ ዎታ ካግረ እባዶ ካኮኡኤረ ጎራታ ዳዉተ ካየለሮ ላኮናባብቴታንያ?<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሜ. 21፡1-6</ref>።</char></note> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />ምን ካዋ ታበ፥ ቱቃሞሉን ኳሬ ኡሱና ሌረ ዎታ ኦግሬቱን ኣምን ፈኢ ካስሳሞን ግሮ ካሶማሳመ ባቦ ኣመ።<note caller="-" style="x"><char style="xo" closed="false">12፡4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ዎዩ. 24፡9</ref>።</char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />አደና ቱቃሞሉን ታፎልሲ አሪ ኢግልሰንጉረን ቁሉክ ምን ካዋ ኦሮ ፈሎ ጎፈሌን ጩቦ ላናዋት ሴራ ካሙሴ ላኮናባብቴታንያ?<note caller="-" style="x"><char style="xo" closed="false">12፡5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">ቶቶ 28፡9-10</ref>።</char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />አየሱን ጎአመን አን ሃ አማራ፤ ቁሉክ ምን ካዋኮ ካሮራራ ህታኒ ግራ። <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />አን ‘ጃርሶኮ ሱረ ሻጋ ጌላታራ’ ካአማማሮ ሃፉራ መ አማኖዮ ኦአዴሳታን ሌቴንዋ ቁሉኒዕ ጉት ላኮፍርዳቴን።<note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">ማቶ. 9፡13</ref>፤ <ref loc="HOS 6:6">ሆሴ 6፡6</ref>።</char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />ኤረ ካእባዶ ታፎልሲ አርዉን ጎታያ።”<verse eid="MAT 12:8" /></para>
  <para style="s1">የሱሳ ገነ ካኮናፋተቶ እባዶት ፋይሰ</para>
  <para style="r">(<ref loc="MRK 3:1-6">ማር. 3፡1-6</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6፡6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />የሱሳ ኤሰ ባንኤኮ ሮረ ሴተጉረ፥ አይሁድኮክ ምን ካኤብ ታበ፥ <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />ኤሴና ገነ ካኮናፋተተ እባዶት ኮ ግረ፤ የሱሳ ሞትን ዶተንጉሬን፥ “አይሁድን ታፎልሲ አሪ እባዶ ፋይስን ፈኢ ስሳንተታ?” አመን ሆሳተን።<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />የሱሳና፥ “እስን ኦሮኮ እባዶት ኮኮት ኢዳዶ አይሁድን ታፎልሲ አሪ ጉምቢ ኦሮድ ጎኢተ፥ ኢዳዶ ካኮኢተቶ ጉምቢ ኦሮኮ ናት እስን ላኮቤሳንያ?<note caller="-" style="x"><char style="xo" closed="false">12፡11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">ሉቃ. 14፡5</ref>።</char></note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />ሀያ፥ እባዶ ኢዳዶኮ ላኮሮራሮያ? ሃንሱን ታፎልሲ አሪ ታኢዳን ፈልን ፈኢ ስሳንተታ” አመ።<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />ኤሰኮና የሱሳ እባዶትነ፥ “ገነታ ድሪርሳ” አመ፥ እባዶትና ገነቴሳ ድሪርሳተ፥ አንት ገነ ታኢዳንት ኣን ሌተ። <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />ፋራሳዊል ጎአመን ኤሰኮ ቤንጉሬን የሱሳ ምስ ምሲ ላጋድናን ማላኦዬን።<verse eid="MAT 12:14" /></para>
  <para style="s1">ዋዉን ሀንዳይን ካአሳባመ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />የሱሳ ቆፋትሶ አዴሰረ ኤሰኮ ፋክ አመ። ጎሳ ካሞጋና ኡሱ ዴበ ሰሴተ፥ ካሀዉአማረ ዱባ ፋይሰ። <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />እስኦቴሳ ማዮና ጎጎሰግኖንኮ አታይሰ እሶን ሰገ፤ <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />ሂክ ካኮንሌራ ካሄገሮ እስያሳይ ሃ አማሜን ኦሴጋመራን ሄገሮ ፈሎ ጎጎሀይራዉንያ።<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“ሂክማ! አን ካአሳባዬራና አን ካጌላታራ ኡሱያ፥</para>
  <para style="q2" vid="MAT 12:18">ኡሱ አን ካጌላታሮና ካኮገገላታሮያ፥</para>
  <para style="q2" vid="MAT 12:18">አያናኬ ኡሱ ጉት ካይናራ።</para>
  <para style="q2" vid="MAT 12:18">ኡሱና ጎሳን ካሩም ፍርዳ አዋጅናራ።<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />ኡሱ ላኮዶጋምናሮ ላኮናኦክናሮ፤</para>
  <para style="q2" vid="MAT 12:19">ራድና ያየቴሳ ካማላ ላኮግሮ።<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />ካሩም ፍርዳ ታአዎዶን ጌግን፤</para>
  <para style="q2" vid="MAT 12:20">ካጫንጫናመ ፊቀና ላኮኤብስሮ።</para>
  <para style="q2" vid="MAT 12:20">ካኢዮታሮ ካሙቃደ ሻሎና ላኮባስሮ።<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />አይዛብና መገኬሳይ አብድ የላሮዋ።”<note caller="-" style="x"><char style="xo" closed="false">12፡21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">ኢሳ. 42፡1-4</ref>።</char></note><verse eid="MAT 12:21" /></para>
  <para style="s1">የሱሳና ዱርሳኮክ ዎይቻ</para>
  <para style="r">(<ref loc="MRK 3:20-30">ማር. 3፡20-30</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11፡14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />ኤሰኮ አባባተረ ባቲክ አያናይ አባማኖይ ኢልኦ ድያይና ህኢ አዬስን ካዋተሮ እባዶት ኮ የሱሳ ቶስ ኣተን ኤመተን፥ የሱሳና ኡሱ ፋይሰ፥ እባዶትና ዲና አዬስን ዳንዴ። <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ጎሳ ዱባ ሳደጉረ፥ “ሂክ እባዶት ኤረ ካዳዉተ ሌዉና?” አመ።<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />አየሱን ጎአመን ፋራሳዊል ሂካ ካኮማላረ ጎራታ “ሂክ እባዶት ዱርሳ ካኮቤሳራ ካዱርሳ ዎይቻ ካሌሮ ብኤልዘቡልኮክ ሁናያ” አመን።<note caller="-" style="x"><char style="xo" closed="false">12፡24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9፡34</ref>፤ <ref loc="MAT 10:25">10፡25</ref>።</char></note><verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />የሱሳና ቆፋትሶ አዴሰጉረ “እስ ኦሮ ካለካለ ካብያራ ዎኖናት ዱባ ኢናራ። እስ ኦሮ ካለካለ ታቤተ ካታማ ጎርቱን ምን አታይ ግርን ላኮዳንዴሮ አመ። <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />ጻላዬና ጻላየ ካቤሳቶ ጎሌተ፤ እስስኦሮ ካለካለ ቤራን አማኖያ፤ ሃ ጎሌ አደ ዎኖናት ምስ ምሲ አታይ አልን ዳንዳራ? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />አን ዱርሳ ካኮቤሳራ ዱርሳኮክ ዎይቻ ጎሌ፤ እስን ዴበ ኦሰሰታራን አደ መይ ቤስናራን? ሃንሱን ይስክስንዋ እስን ጉት ፍርድናራ። <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />አን ጎአመን ዱርሳ ካኮቤሳራ አያና ካዋይ ጎሌ ጎርታ ዎኖናት ካዋ እስን ቶስ ኤመተራ አማኖያ።<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“ጎርቱን እባዶት ኮ ካአቲ እባዶትኮክ ምን ታብጉረ ኡራዎኦቴሳ ሳሚን ጎዶተ፥ ጣይ ሀሱ ካአቲ እባዶት አንሺኖን ግራን ምሲ ኡሱን ኤካታ? ኡሱ ሺ ጎአባባተ ኡራዎኦቴሳ ሳሚን ዳንዳራ።<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“ኢነ ዎታ ካሌኖን ዱባ እን ካኔባታሮያ፥ ኢነ ዎታ ካኩኩይሳኖን ዱባ ዳርአታራ። <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />ሃንሱን አን ሃ አማራ፥ ጩቦ ፈላኖና እባዶ ሀባራኖ ዱባ እባዶን ሀሄሶ አማምናራ፥ አየሱን ጎአመን አያና ቁሉክ ካሀባራሮን አደ ጩቦ ሀሄሶ ላኮአማማሮ። <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />ማዮና ኤረ ካእባዶ ጉት አየስ ካሜላን ካአዬሳሮ ዱባን ሀሄሶ አማማራ፥ አያና ቁሉክ ጉት አየስ ካሜላን ካአዬሳሮን አደ ሂካ አላምና ሌረ ካኤሜታሮ አላም ጩቦ ሱረ ሀሄሶ ላኮአማምሮ።<note caller="-" style="x"><char style="xo" closed="false">12፡32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12፡10</ref>።</char></note><verse eid="MAT 12:32" /></para>
  <para style="s1">ጋ ካእዳን ኢልቴሳ አዴሳማራ</para>
  <para style="r">(<ref loc="LUK 6:43-45">ሉቃ. 6፡43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“ጋ ዱባ ኢልቴሳ ማንኮአዴሳማሮ ማራን ኢል ታኢዳን ጎጎሄላታኑን ጋ ካእዳን እስኑን ሀንግረ፤ ጋ ካሜላን እስኑን ጎግረ አደ ኢል ታሜላን ሄላይናታን።<note caller="-" style="x"><char style="xo" closed="false">12፡33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">ማቶ. 7፡20</ref>፤ <ref loc="LUK 6:44">ሉቃ. 6፡44</ref>።</char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />እስን ይስ ካሀበሳ፥ እስን ኦሜላን ጎሌታን ካእዳን አየስ አዬስን ምሲ ዳንዳታን? እባዶ ዎዳናቴሳ ኦሮ ካአማጋመሮ ህኢ አዬሳራ።<note caller="-" style="x"><char style="xo" closed="false">12፡34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3፡7</ref>፤ <ref loc="MAT 23:33">23፡33</ref>፤ <ref loc="MAT 15:18">15፡18</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3፡7</ref>፤ <ref loc="LUK 6:45">6፡45</ref>።</char></note> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />ካእዳንክ እባዶ ዎዳናቴሳይ ካአማጋመሮ ካእዳን አዬስኬሳኮ ታኢዳን ቤሳታራ፥ ካሜላንክ እባዶና ዎዳናቴሳይ ካአማጋመሮ ካሜላን አየስኮ ታሜላን ቤሳታራ። <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />አየሱን ጎአመን አን ሃ አማራ፤ እባዶ ካአዬሳሮ ካማድኖን አየስ ዱባ ማራንትኑ ታፍርዳ አሪ ሆሳምናራ። <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />ኣላንቲና አዬስካኮ ካከይ ቁሎይናታ፥ አዬስካኮ ካከይ አት ፍርዳምናታ።”<verse eid="MAT 12:37" /></para>
  <para style="s1">ባሳክ ማላታ ድን ዶታኖ</para>
  <para style="r">(<ref loc="MRK 8:11-12">ማር. 8፡11-12</ref>፤ <ref loc="LUK 11:29-32">ሉቃ. 11፡29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />ኤሰኮና ሴራ ካሙሴ ኦአጋልስሳራንኮና ፋራሳውልኮ ኮኮ የሱሳነ፥ “ካአጋልስሳቶ! ኖ ኩኮ ባሳክ ማላታ ድን ዶታና” አመን።<note caller="-" style="x"><char style="xo" closed="false">12፡38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">ማቶ. 16፡1</ref>፤ <ref loc="MRK 8:11">ማር. 8፡11</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፡16</ref>።</char></note><verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />ኡሱ አደ አባበጉረ እሶነ፥ “ታሜላና ታአማኖን አላታን ማላታ ድን ዶታታ፤ አየሱን ጎአመን ካሄገሮ ካዮናሳ ማላታ ኳሬ ካካለ ማላታ ላኮስሳምናሮ።<note caller="-" style="x"><char style="xo" closed="false">12፡39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶ. 16፡4</ref>፤ <ref loc="MRK 8:12">ማር. 8፡12</ref>።</char></note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />ዮናሳ አሪ ሴንዳ ሄመን ሴድ ካንጂንክ ኩኑኡብኮክ ቦግ ኦሮ ጎጎአዳላተሮይ፥ ኤረ ካእባዶ ኡሱማሌ አሪ ሴንዳ ሄመን ሴድ ኤሬ ኦሮ ቃማላም አዳላይናራ።<note caller="-" style="x"><char style="xo" closed="false">12፡40 </char><char style="xt" closed="false"><ref loc="JON 1:17">ዮና. 1፡17</ref>።</char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />ካነኔዌ እባዶ ታሙርት አሪ ህታ አላታነ ዎታ ኪጉሬን ኡሱ ጉት ፍርድናራ፥ ካነኔዌ እባዶ ካዮናሳ ላላባኖ ማለንጉረን ጩቦኮ ኦጉላ ጋሌራን፥ ግዳ ጎአመን ዮናሳኮ ካሮራራ ህታኒ ግራ።<note caller="-" style="x"><char style="xo" closed="false">12፡41 </char><char style="xt" closed="false"><ref loc="JON 3:5">ዮና. 3፡5</ref>።</char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />ታፍርዳ አሪ ኦር ዎኖ ሳባ ህታ አላታነ ዎታ ኪጉደ ኡሱ ጉት ፍርድናታ፥ ታሶሎሞን ቃሩማ ማልን ኡልኮት ጋቾኮ ኤሜተታ፥ ግዳ ጎአመን ሶሎሞንኮ ካሮራራ ህታኒ ግራ” አመ።<note caller="-" style="x"><char style="xo" closed="false">12፡42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ዎኖ. 10፡1-10</ref>፤ <ref loc="2CH 9:1-12">2 ኦዱ 9፡1-12</ref>።</char></note><verse eid="MAT 12:42" /></para>
  <para style="s1">ባቲክ አያና እባዶ ኦሮ አባባይ ታባኖ</para>
  <para style="r">(<ref loc="LUK 11:24-26">ሉቃ. 11፡24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“ባቲክ አያና እባዶትኮ ካኮብያረ ጎራታ ታኮፎልሳሮ ካላይ ታአንጋይደ ባንኤ በከ ዶታታ ካፋፋረ፥ ታዶታታረ ፎልሲ አደ ላኮሄላተ። <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />ኤሰኮና ‘ካኮግረ ምን ቶስ አባባይ ሴዉ’ አማራ፥ አባባይ ካኮሴሮ ጎራታ ምን ሀላል ሌ፥ ሻካራመ ካሙጭመሮና ካኤካተሮ ሄላይናራ። <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />ኤሰኮ ሴተጉረ ኡሱኮ ካሮረ ካካለ ቶዶባ ባቲክ አያናጆል ካሜላን አታይረ ኤመይናራ። እሶና እባዶት ኦሮ ታብጉሬን ግርናራን። ሀሱ እባዶትዉና ግር ካሆሬኮ ግር ካሃረ ካሜላን ልናራ። ህታ ታሜላን አላታን ጉት ሂካማሌ ልናራ።”<verse eid="MAT 12:45" /></para>
  <para style="s1">አዬ ታየሱሳና አቢላል</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር. 3፡31-35</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8፡19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />የሱሳ ጎሳን አዬሳ ግራን፤ ኣየቴሳና አቢላልቴሳ ኡሱነ ኤሰልን ዶተንጉሬን ሳሬ አሌን ግረን። <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />እባዶት ኮ የሱሳነ፥ “ኣየታና አብላልታ ኩኔ ዎታ አዬስን ዶተንጉሬን ሳሬ አሌናን” አመ።<note caller="+" style="f"><char style="fr" closed="false">12፡47 </char><char style="ft" closed="false">ኮኮ ካብራና ማጻፋል ቶቶ 47 ላኮአዳሮ። </char></note><verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />የሱሳና፥ “ኣየት አዮታ? አቢላልትና አዮስያን?” አመ አባበ። <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />ገነተሳና ኡሱኮ ኦአጋልሳታራን ቶስ ቱሳ “ኣየትና አቢላልት ህናኣያን፤ <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />ዳሩሪ ካግሮ ኣቦኬኮት ፈኢ ካፈላራ ዱባ፥ አቢላልቴ አባላልቴና ኣጮላልቴኔያን።”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">ካዉጣታሮኮት ማሱሳ</para>
  <para style="r">(<ref loc="MRK 4:1-9">ማር. 4፡1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8፡4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />ኤሰ አሪዋ የሱሳ ምንኮ ቤጉረ ላቡ ግርዲ ሀማጼ። <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />ካሞጋን ጎሳና ኩኩአማኖኮ ካከይ ኡሱ ማረ ማንኮአበረ ማራን እሶ ባጋ ኢሰጉረ ዎላቦይ ታበ ሀማጼ።<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">ሉቃ. 5፡1-3</ref>።</char></note> <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />ካሞጋን አዬንሳ ማሱሳይ ሃ አመ ሰገራ፥ “ኦታተ ካባራረ እባዶት ኮ ዉጣ ዉጣዪን ቤ። <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />ዉጣታ ግራና ዉጣ ጋምሳ ራ ግርዲ እዬ፥ ክምብርና ኤመተጉረ አባባተ አመ። <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />ጋምሳ ዉጣ ታፉፉድ ሻቁሞልት ኤሬ እዬ፥ ኤሬና ታፉፉድ ማንኮሌተተ ማራን ዉጣ ሳመ አላተ። <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />አየሱን ጎአመን አርት ካኮብያተ ጎራታ ቆረ ህዲድ ኣሎ ዳግሳናዋትኮ ካከይ አንጋገ። <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />ጋምሳ ዉጣና ኤኤን ካአቦ ሁራ ኦሮ እዬ፥ ኤኤንና ጂናተጉደ ካአላተሮ ዉጣ ማርግሰ ኦሮ ሃሰ። <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />ካካለ ዉጣ አደ ታኢዳን ኤሬ ጉት እዬ፥ አላተጉረ ኢል የላተ፥ ኮ ቦል፥ ኮ ሎታም፥ ኮና ሶንዶም ኢል ስሰ። <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />ነበ ካአባ ሀማሎ!”<verse eid="MAT 13:9" /></para>
  <para style="s1">የሱሳ ማሱሳ ካኮንአዬሰሮ ኣላንቲ</para>
  <para style="r">(<ref loc="MRK 4:10-12">ማር. 4፡10-12</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8፡9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />ኤሰኮ የሱሳኮ ኦአጋልሳታራና ኡሱ ቶስ ጋባላመንጉረን፥ “መዉን ጎሳን ማሱሳ አዬሳታ?” አመን።<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />የሱሳ አባበረ፥ “እስኑን ዎኖናት ካዳሩረኮት ሆል ማላባኖ ስሳመራ፥ እሶን ጎአመን ላኮስሳመሮ። <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />ካኮግሮን አዳማራ፥ ሞጋታራ፥ ካላይክኮ ጎአመን ሀሱ ካግራዋ ሱረ ኡሱኮ አታማራ” አመ።<note caller="-" style="x"><char style="xo" closed="false">13፡12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ. 25፡29</ref>፤ <ref loc="MRK 4:25">ማር. 4፡25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፡18</ref>፤ <ref loc="LUK 19:26">19፡26</ref>።</char></note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />ሃንሱን ሃ አማ አን ማሱሳይ ካኮን ሰገራ ሂካኑንያ፥ ዲያ ግራን ኦዴኖን ማንኮሌን ማራን፥ ማላ ግራን ኦማሎን ማንኮሌን ማራን፥ ጎርቱን ሻዳና ማንኮዋቴን ማራንያ። <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />ካሄገሮ እስያሳይ ካሰጋመራ፥</para>
  <para style="q1" vid="MAT 13:14">“ማላኖ ማልናታን፥ አየሱን ጎአመን ላኮሻድናታን፥</para>
  <para style="q2" vid="MAT 13:14">ድያኖና ድናታን፥ አየሱን ጎአመን ዎዳና ላኮአባታን፥ ሃ አማመ ካጻፋመራ እሶ ጉት ፈሎ ሀይናራ፥<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />ሂካ ጎሳኮት ዎዳናና ዱደታ፤</para>
  <para style="q2" vid="MAT 13:15">ነበትሶና ላኮማላቶ፥ ጎጎዴኖንኮ እልኦ ኦትሶ ጢጲሜራን፥</para>
  <para style="q2" vid="MAT 13:15">ሃ ሊ ዋተዋ ኢልኦ ኦትሶይ ዲጉረን፥</para>
  <para style="q2" vid="MAT 13:15">ነበትሶይ ማልጉሬን፥</para>
  <para style="q2" vid="MAT 13:15">ዎዳናትሶይና ሻድጉሬን፥</para>
  <para style="q2" vid="MAT 13:15">እን ቶስ አባባተንዋ አን እሶ ፋይሳረዋ።”<note caller="-" style="x"><char style="xo" closed="false">13፡15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6፡9-10</ref>።</char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />እልኦ ኦትስን ማንኮድያራን ማራን፥ ነበትስና ማንኮማላቶ ማራን አደ ኦሶማሳንቴታን። <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />አን ሩምና አማራ፥ ኦሄገሮልና ካሞጋን ቁሉክ እባዶ፥ እስን ካድያታን ድን፥ እስን ካማልቴታን ማልን ሀልቻሬን፥ አየሱን ጎአመን እሶን ላኮኤካተ።<verse eid="MAT 13:17" /></para>
  <para style="s1">ካዉጣታሮ ማሱሳኮት ፉሬን</para>
  <para style="r">(<ref loc="MRK 4:13-20">ማር. 4፡13-20</ref>፤ <ref loc="LUK 8:11-15">ሉቃ. 8፡11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“ጎርታኑን እስን ዉጣ ካዉጣታሮ እባዶትኮት ማሱሳ ማላ፥ <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />ዎኖናት ካዋኮክ ሃፉራ ማለጉረ ካሻዶን ማታዮት ዎዳና ኦሮኮ ካሜላን ኤሜይጉረ ካዉጣመሮ ዉጣ ኣትናራ። ጎርታ ሂክ ራ ግርዲ ካኢየሮ ዉጣያ። <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />ሻቁሞልት ኤሬ ጉት ካኢየራ አደ፤ ሃፉራ ማለጉረ ጎርሰዋ ገጌሎይ ካአታታሮ እባዶ ኣን ላራ። <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />አየሱን ጎአመን ህዲድ ኣሎ ዳግስን ማንኮዋ ታንጂን ላኮአዳላታሮ፤ ሃፉራኮክ ኣላንቲ ራኮ ጎርቱን ባቃታኖ ጎኤሜሮ ጎርሰዋ ሳመ ሀንዱዱፋታራ። <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />ኤኤን ሁራ ኦሮ ካኢየራ ዉጣ ሃፉራ ማለጉረ ሂካ አላም ያዳኖይና ዱሩማኮት ቆፋይ ሶባማ ማርጋተ ኢል ካስሶን ዉጣ ኣን ላራ። <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />ኤሬ ታኢዳን ጉት ካዉጣመራ ዉጣ ጎአመን ሃፉራ ካዋ ማለጉረ ካሻዳሮ እባዶ ኣን ላራ፥ ሀሱና ኢል የላታራ፥ ኮ ቦል፥ ኮ ሎታም፥ ኮና ሶንዶም ስስናራ።”<verse eid="MAT 13:23" /></para>
  <para style="s1">ሻራፋኮት ማሱሳ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />የሱሳ ካካለ ማሱሳ ሃ አመ ሰገ፥ “ዎኖናት ካዳሩረ ኢራይ ዉጣ ካእዳን ካዉጣተሮ እባዶት ኣን ላራ። <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />አየሱን ጎአመን እባዶ ዱባ ሁዱረ ግራን ዲናኬሳ ኤመተጉረ ዳርጋማቴሳ ኦሮ ሻራፋ ዉጠ ሴተ። <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />ዳርጋማና አላተዴ ኢል የላታኖ ካኮሀጋአባተ ጎራታ ሻራፋና ዎታ ሙተ።<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />“ኦዶ ኢራን ኦፈላራን ኡሱ ቶስ ኤመተንጉረን ‘ጎታ! እራ ኦሮ ላ ዉጣ ካእዳን ዉንጠነላ? ሀያ ሻራፋ ሀገኮ ኤመተ?’ አመን።<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />“ ‘ኡሱና፥ ሂኒዕ ፈሎ ኦዲናያን’ አመ።</para>
  <para style="p" vid="MAT 13:28">“ኦሀንዳሬና ‘ሴይጉነ ሻራፋ ጎጎታታግኖን ዶታታ?’ አመን ሆሳተን።<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />“ ‘ኡሱ ጎአመን ላ’ አመ፥ ‘ኣላንቲና እስን ሻራፋ ታታጋና አማ ዳርጋማ ዎታ ታታይዳንዋ፤ <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />እሳጋ፥ ካም ኩኩ ታኮአማሮ አሪ ታ ጌሮን ራቶ ሀጂናተ፥ ኤሰሪ ኦማጣራናኔ ጣ ሻራፋ ታታጋ፥ ኤለኒ ጎጎጉባምሮ ካባል ካባሊ ሻ፥ ዳርጋማ ጎአመን ኩኩይሳጉዴን ጎታራቴይ ክባ አን አምናራ አመ።’ ”<verse eid="MAT 13:30" /></para>
  <para style="s1">ታስናፍጭ ኢልና ኢርሾኮት ማሱሳ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር. 4፡30-32</ref>፤ <ref loc="LUK 13:20-21">ሉቃ. 13፡20-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />የሱሳ ካካለ ማሱሳ፥ “ዎኖናት ካዳሩረ እባዶት ኮ ኣተረ ኢራኬሳይ ታዉጣተሮ ትጫርት ታስናፍጭ ኢል ኣን ላታ። <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />ስናፍጭኮት ኢል ካካለ ዉጣጆል ዱባኮ ታየራታቶ ኢል ጎሌተና፥ አላይደ ጎጂናቶ አደ ጋጆል ዱባኮ ሙይተጉደ፥ ጉንተ ካቡባራ ክምብርጆል ኤመተጉረ ባላል ጉት ምን ካኮማዳራሮ ጋ ኣን ላራ” አመ።<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />ግዳና የሱሳ ካካለ ማሱሳ፥ “ዎኖናት ካዳሩረ ሄለልትቲ ቶ ጣመ ሴድ ጋልተ ኤካሰ ኣተዴ ርግደ ታለሌደቶ ኢርሾ ኣን ላታ” አመ።<verse eid="MAT 13:33" /></para>
  <para style="s1">የሱሳ ሙን ጎሳ አጋልስሰሮ</para>
  <para style="r">(<ref loc="MRK 4:33-34">ማር. 4፡33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />የሱሳ ጎአመን ሂካ ዱባ ጎሳን ማሱሳይ አዬሰ፥ ማሱሳ ካላይ ካአዬሳመራ አየስ ኮና ላኮግረ። <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />ህክና ካሄገሮይ ሃ አማመ ካአዬሳመረ ፈሎ ሀየ።</para>
  <para style="q1" vid="MAT 13:35">ህክና፥ “ህኢቴ ማሱሳይ ባናይናራ፤</para>
  <para style="q2" vid="MAT 13:35">አላም ታኮመጣመሮኮ ሀጋአበረ ስያመ ካግሮ አዬስናራ።”<note caller="-" style="x"><char style="xo" closed="false">13፡35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">ማዛ. 78፡2</ref>።</char></note><verse eid="MAT 13:35" /></para>
  <para style="s1">ታሻራፋ ማሱሳኮት ፉሬን</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />ኤሰኮ የሱሳ ጎሳ ኢሰጉረ ምን ታበ፤ ኡሱኮ ኦአጋልሳታረና ኡሱ ቶስ ጋባላመንጉረን “እራ ኦሮ ካግሮ ሻራፋ ማራን ካአዬሰቶ ማሱሳኮት ፉሬን ኖን ሰጊና” አመን።<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />የሱሳና፥ “ካእዳን ዉጣ ካዉጣተራ ኤረ ካእባዶያ፤ <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />እራና ሂካ አላምያ፥ ካእዳንክ ዉጣና ዎኖናት ካዳሩረኮክ እባዶ ቱሳራ፥ ሻራፋና ካጻላየ እባዶኮክ ጋራ ቱሳራ፤ <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />ዉጠጉደ ታሴተታ ዲና ጻላዬታ፤ ዉጣ ታኮኩኩአምናራና አላምኮክ ጋቾ ጎሌሮ ኦማጣርናራና አደን ኤርግቻልያን።<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />“ሻራፋና ታታጋመጉረ ኤለኒ ጎጎጉባማሮ አላምኮት ጋቾ ሂካማሌ ልናታ። <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />ኤረ ካእባዶ ኤርግቻኬሳ ፋርናራ፥ እሶና ጩቦን ኣላንቲ ኦሌራና ታሜላን ኦፈላራን ዱባ አባብጉረ ዎኖናትኬሳኮ ቤስናራ። <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />ኦታና ኢልኮ ፎጫኖ ማንኮግሮ ታቤባቶ ኤለኒ ኦሮዴስ እሶ ሉጉድናራ። <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />ሀሱ ጎራታ ቁሎለ ኣቦክሶክ ዎኖናት አርት ኣን ሀንቃይናራን። ነበ ካአባ ሀማሎ።<verse eid="MAT 13:43" /></para>
  <para style="s1">ስያሜን ኦግራን ኡራዎና ኢንቁኮት ማሱሳ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“ዎኖናት ካዳሩረ እራ ኦሮ ኦስያሜራን ኡራዎ ኣን ላራ። እባዶት ኮ ኦሄላተሮ ሂናኣ ኡራዎ አባበ ስያንሳተ፥ ገጌላታኖኮ ካከይ ካአቦ ዱባ ዳዳላተጉረ ኤሰ ታኢራ ባንኤ እምናተ።<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“ኡሱማለና ዎኖናት ካዳሩረ ካእዳንክ ኢንቁ ኢምናይን ካዶታታሮ ናጋደት ኣን ላራ። <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />ኣሎ አዉኣሎክ ኢንቁ ካኮሄላታረ ጎራታ ሴተጉረ ካአቦ ዱባ ዳዳላተጉረ ኡሱ ኢንቁ እምናተ።<verse eid="MAT 13:46" /></para>
  <para style="s1">ማራብኮት ማሱሳ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“አደና ዎኖናት ካዳሩረ በከ ኦሮ ጎሉጉድራን ሳኒ ካሞጋን ኩኑኡብ ታአባቶ ማራብ ኣን ላራ። <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />ኩኑኡብ ኦአባታራና ኩኑኡብ ማራብ ካኮአማጋማረ ጎራታ ጊቴን ባጋ ቶስ ቤሰን፥ ኤሰኮ ሀማጼንጉሬን ካእዳን ካእዳን አሳቤን ዳቾል ኦሮዴሴን ክቤን፤ ካሜላን ካሜላና ጎአመን ቤሰን ሻፌን። <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />ካጋቾ ጌስና ሂካማሌ ልናራ፥ ኢርግቻና ኤሜይጉረ ጩባለይ ቁሎሌኮ አሳብጉረ፤ <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />ኦታንና ኢልኮ ፎጫኖ ማንኮግሮ ታባኖን ኤለን ቶስ ሉጉዳምናራ።”<verse eid="MAT 13:50" /></para>
  <para style="s1">ካኡሱብክና ካዶአንክ ማዝጋባኮክ ጋራ</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />የሱሳና፥ “ሂክ ዱባ እስኑን ታበራ?” አመ። እሶና “እ” አመን።<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />የሱሳ ሃ አመ አባበ፥ “ሂክ ሃ አማኖ መተመቴ ሴራ ካሙሴ ካአጋልስሳራ ኡሱና ዎኖናት ካዳሩረ ኡሱኮ ካአጋልሳታሮ ካሌራ ካኡሱብክና ካዶአንክ ጎታራኮ ካቤሳሮ ኦዶ ኣን ላራ” አመ።<verse eid="MAT 13:52" /></para>
  <para style="s1">የሱሳ ታናዝሬት ካታማይ ዲዳማኖ</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር. 6፡1-6</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4፡16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />የሱሳ ሂናኣ ማሱሳጆል አዬሰ ጎጎጉድሴይ ኤሰ ባንኤኮ ኬጉረ ሴተ። <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ኡልኬሳ ቶስ ኤመተጉረ አይሁድኮክ ምን ካኤብ ኦሮ ጎሳ አጋልስሳኖ ሀጋአበ፥ እሶና ማማ ሃ አመን፥ “ሂክ እባዶት ህታ ቃሩማና ሂካ ባሳ ካኮፈሎ ሁና ሀየኮ ሄላተራ?” <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />“ሂክ ላኤረ ካአናጢትዮላ? ኣየቴሳክ መገ ላ ማይራመ አማራና? አቢላልቴሳ አደ ያይቆባ፥ ዮሴፋ፥ ስሞናነ ይሁዳኔያና? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />አባላልተሳና ዱባ ላ ኖኔ ዎታ ግራና? ሀያ ሂክ እባዶት ሂካ ዱባ ሀየኮ ሄላተ?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />ሃንሱን ኡሱ ሀአታኖን ሄሴን። የሱሳ ጎአመን “ካሄገሮ ካኮካባጃሞን ኡልኬሳይና ምንኬሳ ካላልያ” አመ።<note caller="-" style="x"><char style="xo" closed="false">13፡57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ያን. 4፡44</ref>።</char></note><verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />እሶ አማናናዋትኮት ኣላንቲ ካሞጋን ባሳ ኤሰ ላኮፈለ።<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">ካጣማቃሮ ያንሳኮክ ጎይ</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር. 6፡14-29</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9፡7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />ኡሱ ጎራታ ካጋሊላ ኡል ቃላዳኬሳ ካባሪሳረ ሞት ሄሮዶሳ፥ አታን ካየሱሳኮክ ጋራ ማለ፥ <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />ኡሱን ኦሀንዳሬነ፤ “ሂክ ሃ ጎሌ ካጣማቃራ ያንሳ ጎይኮ ኬጉረ ኤመተራ አማኖያ፥ ሂክ ካሳዳማራ ባሳ ዱባ ካኮፈላመራ ኡሱያ” አመ።<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />ጣየ ሄሮዶሳ አቢኬሳ ፍልጶሳኮት ኦር ሄሮድያዳኮት ኣላንቲ ያንሳ አብስሰጉረ ምን ካሻኖ ታብሰረ።<note caller="-" style="x"><char style="xo" closed="false">14፡3 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ. 3፡19-20</ref>።</char></note> <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />ኣላንቲና ያንሳ ሄሮዶሳነ፤ “አቢካት ኦር ጎጎአታቶ ሴራ ፈኢ ላኮስሳሮ አማ ግረ።”<note caller="-" style="x"><char style="xo" closed="false">14፡4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">ዎዩ. 18፡16</ref>፤ <ref loc="LEV 20:21">20፡21</ref>።</char></note> <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />ሃንሱን ሄሮዶሳ ያንሳ ላጋዲን ዶተጉረ ጎሳና ኡሱ ካሄገሮ አን ማንኮድያሮ ማራንትኑ አብሳተ።<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />ሄሮዶሳ ኡሱ ታኮአላተሮ አሪ ካባጃታ ግራን ታሄሮድያዳ ኤረ ኤመተዴ ማርት ሆረ ማዳር ካዱዱሮይ ማንኮገጌላይሰ ማራን፥ <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />ኤሰ ካሆሳተ ዱባ ኤሰን ስስን አማቶ ታበ። <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />ኡኑትና ኣየትሴት ማርካ አታተደ፥ “ካጣማቃሮ ያንሳኮክ መተ ታላኣይ ጉት ካይጉደ ኢን ስስ” አንተ። <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />ሀሱ ጎራታ ዎኖና ጋዴ፥ ሀሌዎ ኳሬ አማቶኦቴሳ ማራና ኡሱነ ዎታ ታግቴ ማርት ማራን ሆስንትሴ ጎጎአባባቶ አጃጄ። <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ምን ካሻኖ ቶስ እባዶ ፋረጉረ ካያንሳ መተ ማርግኮ ጎስሰ። <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />ካጎሳመሮ መተና ታላኣይ ካየጉረ ኡኑቲን ስሰ፥ ኡኑትና ኣተጉዴ ኣየትሴዉን ስሰ። <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />ያንሳኮ ኦአጋልሳታረና ሬስ አታቴንጉሬን ቃማሌን፤ ኤሰኮና ሰተንጉረን ካሌሮና የሱሳን ሰገን።<verse eid="MAT 14:12" /></para>
  <para style="s1">የሱሳ እባዶ ኩማ ከን አምሰ</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር. 6፡30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፡10-17</ref>፤ <ref loc="JHN 6:1-14">ያን. 6፡1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />የሱሳና ካሌሮ አየስ ካኮማላረ ጎራታ ታኮግረኮ ኬጉረ ካለት ባንኤ ቶ ቶስ ዎላቦይ ታበ ሴተ። ጎሳና ሂካ ማለጉረ ካታማልኮ ሉኪ ኡሱ ዴበ ሰሴተን። <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />የሱሳና ዎላቦኮ ዳጋግራን ካሞጋን ጎሳ ዴጉረ ነኔኤይሳተ፤ ኩባልክሶኮና ፋይሰ።<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />ኡል ሄመን ላ ካኮሴታረ ጎራታ የሱሳኮ ኦአጋልሳታረና ኡሱ ቶስ ጋባላመንጉረን “ህት ባንኤ ኮና ታኮግኖን ቃሉላቶክ ኡልያ፤ ጎራታና ሄመን ማንኮላሮ ማራን፤ ማማንጆልኮ ሴይጉሬን ካአምራን ባቦ ጎጎኢምናራዉን ጎሳ ጋፋርና” አመን።<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />የሱሳ ጎአመን “እሶ ሴይን ላኮዶትሳሮ፥ እሶ ካአምራን እስንዋ ስሳ” አመ።<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />እሶና፥ “ኖ ህታኒ ካአብና ባቦ ብጠ ከና ኩኑኡብ ላማ ካላል አብና” አመን።<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />የሱሳና፥ “አላ ካአብታን እን ቶስ ኬና” አመ። <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />ኤሰኮና ጎሳ ኤስ ጉት ጎጎሀማጽሮን አጃጃ ስሰ፤ ባቦ ብጠ ከና ኩኑኡብ ላማና ኣተጉረ ኤልዴ ዳሩሪ ቶስ ዲያ ጋላቴረ ባቦኮ ኢብሰ ኣተጉረ ኡሱኮ ኦአጋልሳታሬኑን ስሰ፥ እሶና ጎሳን ስሰን። <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />ዱባና አመን ባራረን፥ ኤሰኮና ኡሱኮ ኦአጋልሳታረና ታሄሰቶ ሀንባ ዱጉድ ቶሞንኮ ላማ ምግ ኬሴን። <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />ካኣመረ እባዶ ሄለልና ይስ ካላይ ኩማ ከን ካሌሮ ባባርየ።<verse eid="MAT 14:21" /></para>
  <para style="s1">የሱሳ በከ ጉት ሰሴታኖ</para>
  <para style="r">(<ref loc="MRK 6:45-52">ማር. 6፡45-52</ref>፤ <ref loc="JHN 6:15-21">ያን. 6፡15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />ጎርሰዋ ኡሱኮ ኦአጋልሳታረን ዎላቦይ ኮራይጉሬን ኡሱኮ ጣይ በከኮ ጋማ ጎጎናቅናዉን አጃጄጉረ፥ ኡሱን አደ ጎሳ ጋልስን ሃር ሄሰ። <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />የሱሳ ጎሳ ጋልሰ አባባተረ ኤባይን ኬ ዎዳም ቶስ ቤ። ኡል ታሙጉድ ሌሮን ካለካለ ኤሰ ግረ። <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ሀሱ ጎራታ ዎላቦና ባጋኮ ፋክ አንተ ጎሰ ሴታ ግራን አምባል ኬተጉደ ጋሽማሎና ሆረ ሃር ሻፋኖ ሀጋአበ።<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />ሄመንኮ ሳቲ ሳጋልኮ አባባተረ የሱሳ በከ ጉት ሰሴታ ኡሱኮ ኦአጋልሳታረን ቶስ ኤመተ። <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />ኡሱኮ ኦአጋልሳታረና ኡሱ በከ ጉት ሰሴታ ካኤሜታሮ ካኮድያረን ጎራታ አብሳተንጉረን፥ “ህት ጋርታ” አማ ኦኬን።<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />ጎርሰዋ የሱሳ እሶነ፥ “አላማንደ! አንያ። አሮአብሳቴን” አመ።<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />ጴጢሮሳና፥ “ጎታ! ጎአትቶ አን በከ ጉት ሰሴታ ኩ ቶስ ጎጎኤሜሮን እን አጃጂ” አመ።<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />ኡሱና፥ “ኮያ” አመ። ጴጢሮሳና ዎላቦኮ ዳገጉረ በከ ጉት ሰሴታ የሱሳ ቶስ ኤመታኖ ሀጋአበ።<verse eid="MAT 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 14:30" />አየሱን ጎአመን አምባልኮክ ሁና ካኮድያረ ጎራታ አብሳተ፤ በከይ ኤነጋማኖ ካኮሀጋአባረ ጎራታ “ጎታ! እን ሃስ” አመ ኦኬ።<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />የሱሳ ሳመ ገነቴሳ ድሪርሳተ ኡሱ አበጉረ፥ “አት አማኖ ካኮንሀንቃተራ! ሙን ሄዳተ?” አመ።<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />የሱሳና ጴጢሮሳ ዎላቦ ጉት ኮራታዋ አምባል ጫልኢ አንተ። <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />ዎላቦይ ኦሮ ኦግረን፥ “ሩምና አት ኤረ ካዋታ” አመንጉረን ግልቢሴን ኡሱን ሳጋደን።<verse eid="MAT 14:33" /></para>
  <para style="s1">የሱሳ ካገንሳረጢ ኡሊ ካሀዉአማረ እባዶ ፋይሰ</para>
  <para style="r">(<ref loc="MRK 6:53-56">ማር. 6፡53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />የሱሳና ኡሱኮ ኦአጋልሳታረን በከኮ ጋማ ናቄንጉሬን ገንሳረጢ ታአማማቶ ባንኤ ቶስ ጌን። <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />ኡሱ ኡልክ እባዶ የሱሳ ላኖ ካኮአዴሳረ ጎራታ ጎቦቢ ካግሮ ማማንጆል ዱባን ሀንዳ ፋረን፤ ካሀዉአማሮ እባዶ ዱባ ኡሱ ቶስ ኬንስሴን። <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />ኦሀዉአማሬና ሳርስኬሳኮት ሻርፍ ታላል ድንኒን ፈኢ ጎጎስስሮን ኤባተን። ኡሱ ኦድኔን ዱባ ዱዶ ፋዬን።<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">ዎጋ ካፋራሳው</para>
  <para style="r">(<ref loc="MRK 7:1-13">ማር. 7፡1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />ኤሰኮና ኢየሩሳለምኮ ኦኤሜተራን ፋራሳዊልና ሴራ ካሙሴ ኦአጋልስሳራን የሱሳ ቶስ ጋባላመንጉረን፥ <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“ኩኮ ኦአጋልሳታራን ዎጋ ካኦዶላል ካኮኢግልሳራን መዉንያ? ባቦ ኣምን ገነትሶ ላኮኣላራን” አመ።<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />የሱሳና ሃ አመ አባበ፤ “እስና ዎጋክስኑን አንቴንጉደን አጃጃ ካዋ ሙን ኢግልሳታን? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />ዋ፥ ‘ኣቦካና ኣየታ ካባጂ፥’ ‘ማዮና ኣቦኬሳ ጎርቱን ኣየቴሳ ጉት ካሜላን ሃፉራ ካኤንጌ ካአዬሳራ ሀጎየ አም አጃጃ ጎስስሮ፥’<note caller="-" style="x"><char style="xo" closed="false">15፡4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ብያ. 20፡12</ref>፤ <ref loc="EXO 21:17">21፡17</ref>፤ <ref loc="DEU 5:16">አዳ. 5፡16</ref>፤ <ref loc="LEV 20:9">ዎዩ. 20፡9</ref>።</char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />እስን ጎአመን ኣቦኬሳ ጎርቱን ኣየቴሳ፥ ‘አን እስኑን ስስን ካዶትሳሮ ጋርጋርሳ ዋዉን ጃርሶ የለ አን ስሰራ’ ጎአመ፥ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ሀሱ እባዶት ‘ኣቦኬሳ ጎርቱን ኣየቴሳ ካባጅን ላኮዶትሳሮ’ አማታን፤ ሃንሱን ዎጋክስኑን አንቴንጉደን ሃፉራ ካዋ ኢግልሳታን።<note caller="+" style="f"><char style="fr" closed="false">15፡6 </char><char style="fqa" closed="false">ኣቦኬሳ፤ </char><char style="ft" closed="false">ኮኮ ካጋልባ ማጻፋጆል፥ “ኣቦኬሳ ጎርቱን ኣየቴሳ” አማራ። </char></note> <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />እስን ኢፍሳዶለ እስያሳ እስን ማራን ሄገሮ ካአዬሰራ ሩምያ።<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“ ‘ሂክ ጎሳ እን ህኢ ካባጃራ፤</para>
  <para style="q2" vid="MAT 15:8">ዎዳናትሶ ጎአመን እንኮ ፋክ ታአንተታ፤<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />እሶ እን አዳ. ሄዶይሳታራን፤</para>
  <para style="q2" vid="MAT 15:9">አጋልስስክሶና ዎጋ ካእባዶ ማሌያ።’ ”<note caller="-" style="x"><char style="xo" closed="false">15፡9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29፡13</ref>።</char></note><verse eid="MAT 15:9" /></para>
  <para style="s1">እባዶ ካባቶይሳሮ ኮኮ</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር. 7፡14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />የሱሳ ጎሳ እስ ቶስ ኡመጉረ ሃ አመ፥ “ማላ! ሻዳ! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />እባዶ ካባቶይሳራ ህኢኮ ካበያሮ ኳሬ ህኢ ኦሮዴ ካታባሮ ላኮዮ!”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />ኤሰኮና ኡሱኮ ኦአጋልሳታረን ኡሱ ቶስ ጋባላመንጉረን “ፋራሳዊል አት ካአንተቶ ማለንጉሬን ጎጎአማራቴራን ዴተ?” አመን።<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />የሱሳ ጎአመን፥ “ካዳሩረ ኣቦክ ካአባሮን አላት ዱባ ታጋምናራ። <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />እሳጋ፥ ኢልኦ ኦድያኖን ኦቃጄልሳራን እሶ ኡሱን ኢልኦ ኦደያኖንያን። እልኦ ካድያኖን ኢልኦ ካድያኖን ጎገጌስሮ እሶ ላማ ራቶ እስ አባተን ላጋ ኦሮዴን ኢያራን።”<note caller="-" style="x"><char style="xo" closed="false">15፡14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">ሉቃ. 6፡39</ref>።</char></note><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />ጴጢሮሳና የሱሳነ፥ “ማሱሳኮት ፉሬን ኖን አዴስስ” አመ።<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />የሱሳና ሃ አመ፥ “እስን ግዳግን ላኮሻዴታን አማኖያ?” <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />“ህኢነ ካታባራ ዱባና ቦግ ኦሮዴ ታበጉረ ኤሰኮና ሳርዴ ካበያሮ ላኮካሳንያ? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />ህኢኮ ካበያራ ጎአመን ዎዳናኮ ካበያሮያ፥ እባዶና ‘ካባቶይሳራ’ ኡሱያ።<note caller="-" style="x"><char style="xo" closed="false">15፡18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12፡34</ref>።</char></note> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />ታሜላን ቆፋ፥ ኔፎ ላጋዳኖ፥ ላይማኖ፥ ሻርሙጣኖ፥ ሄታኖ፥ ጣራ አቶታኖና መገ ባሳኖ ሂክ ዱባ ዎዳናኮ ክያራ። <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />እባዶ ‘ካባቶይሳራ’ ሂካያ ኳሬ ገነኖ ሀኣሎን ባቦ ኣማኖ እባዶ ላኮ ባቶይሳሮ።”<verse eid="MAT 15:20" /></para>
  <para style="s1">ታካናአን ሄለልትቲኮክ አማኖ</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር. 7፡24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />የሱሳና ኤሰኮ ቤጉረ ጢሮስ ቶንሳ ስዶና ካአማማሮ ካካታማ ጎቦብ ቶስ ሴተ። <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />ካካናአን ኡልኮት ሄለልትቲ ቶ ኡሱ ማማንኮ ቤተጉደ የሱሳ ቶስ ኤመተዴ “ጎታ! ኤረ ካዳዉተ ኢን ነኔኤይሳና፥ ኤረት ባቲክ አያናይ አባንተጉደ ኣሎ አቦሳታ አንተ ኦኪተ።”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />የሱሳ ጎአመን ሃፉራ ኮና ላኮአባበ፥ ሀሱ ጎራታ የሱሳኮ ኦአጋልሳታረን ኡሱ ቶስ ኤመተንጉረን “ህት ሄለልትቲ ኖ ዴበ ሰሴታ ኢያታ ኤሰ ጋልሰዋኢስ?” አመን ሆሳተን።<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />የሱሳና አባበረ፥ “አን ካኮንፋራመራ ምን ካእስራኤልኮ ካባየሮ እዳድጆል ካላሉንያ” አመ።<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />ሄለልትቲና ሉክቴሳ ጉት ኢተጉደ “ጎታ ኢን ጋርጋርና!” አንተ።<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />የሱሳና አባበረ፥ “ባቦ ካይስ ኣትጉረን ከሮሩን ሻፋኖ ላኮ ዶትሳሮ” አመ።<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />ኤሰና፥ “እ ጎታ!” “ከሮርና ኦዶኬሳት ዱጉድኮ ታኢተቶ ኦሮንት አማራ” አንተ።<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />ሀሱ ጎራታ የሱሳ፥ “አት ሄለልትቲ አማኖካ ካአቲያ! ሀልቻካክ ማለ ኩን ሀሌዎ” አመ። ኡኑትና ሀሱ ጎራታኮ ሀጋአብተደ ፋይተ።<verse eid="MAT 15:28" /></para>
  <para style="s1">የሱሳ ባሳይ ኩባሌሳል ፋይሰ</para>
  <para style="r">(<ref loc="MRK 7:31-37">ማር. 7፡31-37</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />የሱሳ ኤሰኮ ኬጉረ ታጋሊላ ላቡ ግሪ ታግቶ ባንኤ ሴተጉረ ዎዳም ቶስ ቤ ኤሰ ሀማጼ። <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />ቶቶይ ካሞጋን ካሌ ጎሳና ካኤሳረ፥ ኢልኦ ካድያኖን፥ ናፋለሳል፥ ህኢ ኦአዬሶን፥ ኡሱማለና ካካለክ ካሞጋን ኩባሌሳል አበን ኡሱ ቶስ ኬነንጉረን ሉቃኦቴሳ ሄገሊ ሀማጽሴን፤ ኡሱና ፋይሰ። <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />ጎሳና ህኢ ካአዬሶና አዬሳኖ፥ ናፋለሳልና ኢዳኖ፥ ካኤሳረና ቱኩል ኣል ሰሴታኖ፥ ኢልኦ ካድያኖና ድያኖ፥ ካኮደያረን ጎራታ፥ ካእስራኤል ሄዶ ጋላተን።<verse eid="MAT 15:31" /></para>
  <para style="s1">የሱሳ እባዶ ኩማ አፋር ባቦ አምሳኖ</para>
  <para style="r">(<ref loc="MRK 8:1-10">ማር. 8፡1-10</ref>፤ <ref loc="MAT 14:13-21">ማቶ. 14፡13-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />የሱሳ ኡሱኮ ኦአጋልሳታራን ኡመጉረ “ጎሳ ኢነ ዎታ አሪ ሴድ ማንኮሀየሮ ማራን ካአምራን ማንኮዋተናን ማራን አን እሶን ነኔኤይሳታራ፥ ራድ ኡኢጉሬን ኡል ጎጎኢኖንኮ ኡኢነ ጋፋርን አን ፈኢ ላኮስስናሮ” አመ።<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />ኡሱኮ ኦአጋልሳታረና “ሂካ ኮና ካላይክ ቃሉላቶክ ኡል፥ ሂካ ጎሳ ዱባን ካሌሮ ባቦ አምስን ኖ ሀየኮ ሄልናና?” አመን።<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />የሱሳና፥ “ጎሌና እስን ባቦ ብጠ ምያ አብታን?” አመ ሆሳተ። እሶና፤ ባቦ ብጠ ትትጫር “ቶዶባና” “ኩኑኡብጃ ኦትትጫር አብና” አመን።<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />ኡሱና ጎሳ ኡል ጎጎሀማጽሮን ፈኢ ስሰ፤ <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />ባቦ ብጠ ቶዶባና ኩኑኡብጃ አበጉረ ዋ ሶማሳተ አባባተጉረ ባቦ ኤኤብሰ ኡሱኮ ኦአጋልሳታሬኑን ስሰ፥ እሶና ጎሳን ሄደደን። <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />ዱባና አመን ባራረን፥ ኡሱኮ ኦአጋልሳታረና ታሄሰቶ ሀንባ ዱጉድ ቶዶባ ምግ ኬሴን። <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />ካኣመረ እባዶና ሄለልና ይንሳ አንቶታሞኒ ኩማ አፋር ባባርየ። <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />የሱሳ ጎሳ ጋልሰ አባባተረ ዎላቦይ ታበረ ካመገዶል ኡል ቶስ ሴተ።<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">ዋኮ ማላታ ድን ታሆሳንተቶ ሆስን</para>
  <para style="r">(<ref loc="MRK 8:11-13">ማር. 8፡11-13</ref>፤ <ref loc="LUK 12:54-56">ሉቃ. 12፡54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />ፋራሳዊልና ሶዶቃውል የሱሳ ቶስ ጋባላመንጉረን ጫፍን ዶተንጉሬን፥ “ዋኮ ማላታ ኖን ቱስ” አመን ሆሳተን።<note caller="-" style="x"><char style="xo" closed="false">16፡1 </char><char style="xt" closed="false"><ref loc="MAT 12:8">ማቶ. 12፡8</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፡16</ref>።</char></note><verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />ኡሱና አባበረ፥ “ሄመን ‘ዳሩር ሄላ ጎሌቶ ጫምናራ’ አማታን። <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />ባባርንሳ ‘ዳሩር ጋምባላ ሌተ እስላተታ፥ ሃንሱን ኢዳሞ ኡባይናራ’ አማታን፥ ታዳሩረ ምዲ ማላቢን ዳንዳታን፥ አየሱን ጎአመን ጌስኮክ ማላታ አዴስን ላኮዳንዳታን።<note caller="+" style="f"><char style="fr" closed="false">16፡3</char><char style="ft" closed="false">ኮኮ ታጋልባ ጹፍል ቶቶ 2ና 3 ካግሮ ካየሱሳ አየስ ላኮአዳራን። </char></note> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />ታሜላና ታሻርሙጣታ አላታን ማላታ ዶታታ፥ አየሱን ጎአመን ካዮናሳ ማላታ ኳሬ ካካለ ማላታ ላኮስሳማሮ” ኤሰኮ የሱሳ እሶ ኢሰ ሴተ።<note caller="-" style="x"><char style="xo" closed="false">16፡4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ. 12፡39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11፡29</ref>።</char></note><verse eid="MAT 16:4" /></para>
  <para style="s1">ካፋራሳውልና ካሶዶቃውል አጋልስስ ካሜላን</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማቶ. 16፡5-12</ref>፤ <ref loc="MRK 8:14-21">ማር. 8፡14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />የሱሳኮ ኦአጋልሳታረን በከኮ ጋማ ካኮናቃሬን ጎራታ ባቦ አባታኖ ኢሎተሬን። <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />የሱሳና፥ “እስኦራዬን” “ታፋራሳውልና ታሶዶቃውልኮት ሜላነኮ እስኦትስን ኦራዬን” አመ።<note caller="-" style="x"><char style="xo" closed="false">16፡6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12፡1</ref>።</char></note><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />እሶና እስእስኦሮ፥ “ኖ ባቦ ሀአባኖኒ ማንኮግኖ ማራን ሌራ” አመን።<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />የሱሳና ቆፋትሶ አዴሰረ፥ “እስን አማኖ ኦኮንሀንቃተራ! እስን እስእስኦሮ ባቦ አባታናዋት ሙን አዬሳታን? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />ባቦ ብጠ ከኖ ኩማ ከን እባዶን ሌጉረ ዱጉድ ምያ ፋላይተ ካኬሰታን ላኮሻዳታንያ?<note caller="-" style="x"><char style="xo" closed="false">16፡9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">ማቶ. 14፡17-21</ref>።</char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />ኡሱማለና ባቦ ብጠ ቶዶባ ኩማ አፋር እባዶን ሌጉረ ካፋላየሮ ዱጉድ ምያ ሆረኮ ኬሰታን ዎዳናይ ላኮአባተታን አማኖያ?<note caller="-" style="x"><char style="xo" closed="false">16፡10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">ማቶ. 15፡34-38</ref>።</char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />ሀያ አን እስኑን ካሰጌራ ጋራ ካባቦ ላናዋት ምሲ ሻዳናዋታን? ግዳና ታፋራሳውልኮና ታሶዶቃውል መላነኮ እስኦራዬን።” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />ኡሱ እሶነ እስኦራዬን ካኮንአመራ ካሚ ታክባማቶ ኢርሾ አንሌኖን ግራን፤ ፋራሳውልኮክና ሶዶቃውልኮክ አጋልስስኮ እስኦራዬን ካአማሮ ላኖ እሶን አዴሳመ።<verse eid="MAT 16:12" /></para>
  <para style="s1">ጴጢሮሳ ጋራ ካየሱሳ ክርስቶሳ አዬሳኖ</para>
  <para style="r">(<ref loc="MRK 8:27-30">ማር. 8፡27-30</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9፡18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />የሱሳ ኡል ካፍልጲስዮሳ ቅሳርያ ካአማማሮ ኡል ካኮግያረ ጎራታ ኡሱኮ ኦአጋልሳታረነ፥ “እባዶ ኤረ ካእባዶ አዮያ አማራን?” አመ ሆሳተ።<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />እሶና፥ “ኮኮ ካጣማቃሮ ያንሳያ፥ ካካለ አደ ኤላሳያ፥ ኩክና አደ ኤርማሳያ፥ ጎርቱን ካሄገሮልኮ ኮያ” አማራን አመን።<note caller="-" style="x"><char style="xo" closed="false">16፡14 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">ማቶ. 14፡1-2</ref>፤ <ref loc="MRK 6:14-15">ማር. 6፡14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9፡7-8</ref>።</char></note><verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />የሱሳና፥ “እስን አዴን እን አዮያ አማታን?” አመ።<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />ስሞና ካአማማራ ጴጢሮሳና፥ “አት አርዶክ ኤረ ካዋ ክርስቶሳታ” አመ አባበ።<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />የሱሳና ሃ አመ “ኤረ ካዮና ስሞና! አት ካሶማሳንተታ፥ ሂካ ኩን ካቱሰራ ዳሩሪ ካግሮ ኣቦኬ ኳሬ እባዶ ላኮዮ። <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />አት ጰጢሮሳታ፥ ሂካ ኤኤሞ ጉት አማኒል ካኮኩኩአምሮ ምን አን ማዳርናራ፥ ታባኖን ኤሌንኮክ ሁናና ኡሱ ምን ላኮአዎድሮ። <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />ዎኖናት ካዳሩረ ካኮባናራን ቁልፍ አን ኩን ስስናራ፤ አት ኡል ካሺተ ዳሩሪ ካሽያመ ልናራ፤ አት ኡሊ ካፉርተና ዳሩሪ ካፉራመ ልናራ።”<note caller="-" style="x"><char style="xo" closed="false">16፡19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">ማቶ. 18፡18</ref>፤ <ref loc="JHN 20:23">ያን. 20፡23</ref>።</char></note> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />ኤሰኮ አባባተረ ኡሱ ክርስቶሳ ላኖኬሳ ማዮና ጎጎአዬሶንኮ ኡሱኮ ኦአጋልሳታሬኑን አታይሰ ሰገ።<verse eid="MAT 16:20" /></para>
  <para style="s1">የሱሳ ጎዋኖና ጎይኮ ክያኖኮክ ጋራ አዬሰ</para>
  <para style="r">(<ref loc="MRK 8:31-33">ማር. 8፡31-33</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9፡22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />የሱሳ ሀሱ ጎራታኮ ሀጋአበጉረ “ኢየሩሳለም ቶስ ሴይጉረ ኤሴና ገነ ታጃርሶለይ፥ ቱቃሞልኮክ ዎይቻልና ሴራ ካሙሴ ኦአጋልስሳራንኮት ገነይ ራኮ አታይረ ካጎይናሮና አሪ ታሴድ ጎይኮ ክያኖ” ካዶትሳሮ ላኖ ኡሱኮ ኦአጋልሳታሬኑን ሰጋኖ ሀጋአበ።<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />ጴጢሮሳና የሱሳ ካለ ኣተ ቤጉረ፤ “ጎታ! ሂካ ኣንክክ አየስ ኢጂ ኩ አሮጌኖ” አማ ሀዲሳኖ ሀጋአበ።<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />የሱሳና ጴጢሮሳ ቶስ ካምባል አመረ፥ “አት ጻላየ ሂታኮ ቡይ! ቆፋ ታእባዶ ኳሬ ቆፋ ታዋ አዴስን ማንኮዳንዴኖን ማራን አት ኢን ሀንዱዱፎ ላታ አመ።”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />ኤሰኮና የሱሳ ኡሱኮ ኦአጋልሳታረነ፥ “እን ዴበ ሰሰዪን ካጌላታራ እስኦቴሳ ሀካካቶ፥ ራኮዉና ጎይን እስኦቴሳ ሮርሳይ ስሳይረ እን ዴበ ሀሰሴቶ አመ።<note caller="-" style="x"><char style="xo" closed="false">16፡24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10፡38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14፡27</ref>።</char></note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />ኔፎቴሳ ሃሳይን ካዶታታራ ዱባ ባሳታራ፥ አየሱን ጎአመን ኔፎቴሳ እን ማራን ካባሳታራ ዱባ ሄላታራ።<note caller="-" style="x"><char style="xo" closed="false">16፡25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፡39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፡33</ref>፤ <ref loc="JHN 12:25">ያን. 12፡25</ref>።</char></note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />እባዶ አላም ዱባኮ ዎረኤ ጎሄላተ፥ ኔፎ ጎአመን ጎዋተ መ ላኦ ሄላታራ? ጎርቱን ኔፎኮት ባንኤ መ ሙራ ሄላይናራ? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />ኤረ ካእባዶ ኣቦኬሳኮት ካባጃይ ኤርግቻነ ዎታ ኤመይናራ፤ እባዶን መተመተይ ፈሎኦቴሳክ ማለ ሙራ ሙርናራ።<note caller="-" style="x"><char style="xo" closed="false">16፡27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25፡31</ref>፤ <ref loc="PSA 62:12">ማዛ. 62፡12</ref>፤ <ref loc="ROM 2:6">ሮመ 2፡6</ref>።</char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />አን ሩምና አማራ፤ ህታኒ ካግሮ እባዶኮ ኤረ ካእባዶ ዎኖ ሌ ኤመታ ግራን ታ ዴሮን ካጎኖን እባዶ ግራ።” አመ።<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">የሱሳኮት ምዲ ኢግልሳማኖ</para>
  <para style="r">(<ref loc="MRK 9:2-13">ማር. 9፡2-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9፡28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />አሪ ሌኮ አባባተረ የሱሳ ጰጢሮሳኔ፥ ያይቆባነ፥ ኡሱማሌ ካያይቆባ አቢ ያንሳኔ ዎዳም ቶ ታንጂንት ጦቂ ታአንተ ቶስ ካለ ኣተ ቤ።<note caller="-" style="x"><char style="xo" closed="false">17፡1 </char><char style="xt" closed="false"><ref loc="2PE 1:17">2 ጴጢ. 1፡17</ref>።</char></note> <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />ኤሰ እሶ ሆረ ምዲቴሳና ኢግልሳንተ፥ ሆረቴሳ አርት ኣን ሀንቃይተ፥ ሳርስኬሳና ኢፋ ኣን ዎላ አመ ሀንቃየ። <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />ኤሰኮና ሙሴና ኤላሳና የሱሳነ ዎታ አዬሳ ግራን ሙተን።<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />ጴጢሮሳና የሱሳነ፥ “ጎታ! ኖ ህታኒ ግርነዋ ኖዬን ካእዳንያ፤ ፈኢታ ጎሌተ ዳሰ ቶ ኩዬን፥ ቶ ሙሴን፥ ቶ ኤላሳን ዳሰ ሴድ አን ማዳሮ” አመ።<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />ኡሱና አዬሳ ግራን ካሀንቃራ ዱማንቻ ካጉማር እሶ ሆጎግሰረ ዱማንቻይ ኦሮ፥ “አን ኡሱይ ካኮገገላይናራና አን ካጌላታራ ኤረክ ሂካያ፥ ኡሱና ማላ” ታአማታ ያየ ማልሳንተ።<note caller="-" style="x"><char style="xo" closed="false">17፡5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መጣ 22፡2</ref>፤ <ref loc="DEU 18:15">አዳ. 18፡15</ref>፤ <ref loc="PSA 2:7">ማዛ. 2፡7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፡1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3፡17</ref>፤ <ref loc="MAT 12:8">12፡8</ref>፤ <ref loc="MRK 1:11">ማር. 1፡11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፡22</ref>።</char></note><verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />ኡሱኮ ኦአጋልሳታረና ሂካ ካኮማላረን ጎራታ ኔንጉረን ሆረሆረ ኡል እዬን። <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />የሱሳና እሶ ቶስ ጋባላመረ ድንድነጉረ፥ “ክያ፥ አሮአብሳቴን” አመ። <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />እሶ ጦቂ አም ጎዴራን የሱሳ ኳሬ ካካለ ማዮና ላኮዴራን።<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />ዎዳም ጉኮ ዳጋግራን የሱሳ፥ “ኤረ ካእባዶ ጎይኮ ታኬሮ ጊን ካዴተታን ማዮና አሮአዬሴን” አመ አጃጄ።<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />ኡሱኮ ኦአጋልሳታረና፥ “ሀያ ሴራ ካሙሴ ኦአጋልስሳራን ኤላሳ ጣይ ኤመታኖ ዶትሳራ ካኮአማራን ሙንያ?” አመን የሱሳ ሆሳተን።<note caller="-" style="x"><char style="xo" closed="false">17፡10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፡5</ref>።</char></note><verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />ኡሱና እሶን አባበረ፥ “ኦግራን ኤላሳ ኤሜይጉረ ካአመን ዱባና ጋቾኤካስራ፤ <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />አየሱን ጎአመን አን ሃ አማራ፥ ኤላሳ ጣየ ኤመተራ፥ ጎሌና ካዶታተራን አየስ ፈላቴራን ኳሬ ላኮአዴሴራን፤ ኡሱማለና ኤረ ካእባዶ ገነትሶይ ራኮ አታይናራ።”<note caller="-" style="x"><char style="xo" closed="false">17፡12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">ማቶ. 11፡14</ref>።</char></note> <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />ሀሱ ጎራታ የሱሳኮ ኦአጋልሳታረን ኡሱ ካአዬሰራ አየስ ካጣማቃሮ ያንሳኮክ ጋራ ላኖ አዴሰን።<verse eid="MAT 17:13" /></para>
  <para style="s1">የሱሳ ካጋጋዱ ሀዉኣም ካሀዉአማረ ኡኑ ፋይሰ</para>
  <para style="r">(<ref loc="MAT 17:14-23">ማቶ. 17፡14-23</ref>፤ <ref loc="MRK 9:14-29">ማር. 9፡14-29</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9፡37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />የሱሳና ሴዶ ኡሱኮ ኦአጋልሳታረን ጎሳ ቶስ ካኮአባባቴረን ጎራታ እባዶት ኮ የሱሳ ቶስ ጋባላመ ሆረ ግልቢሰረ ሃ አመ፤ <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“ጎታ! ማጋኔ ኡኑኬዉን ነኔኤይሳ፥” ኡሱ “ካጋጋዱ ሀዉኣሚ አቦሳራ፥ ጋማ ካሆር ኤለን ኦሮዴ ኢያና በከ ኦሮዴ ታባራ። <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />ኩኮ ኦአጋልሳታራን ቶንሳ አን ኬነራ አየሱን ጎአመን እሶ ፋይስን ላኮዳንዴራን።”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />የሱሳና፥ “እስን ኦአማኖና ታዎጫጫንተ አላታን አን ሀጌ ታጌሮን እስኔ ዎታ ግርናራ? ሀጌ ታ ጌሮን ኦብስናራ? ኡኑ ሂታራ እን ቶስ ኬና” አመ። <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />ኤሰኮና የሱሳ ባቲክ አያና ሀድሰጉረ ቤሰ። ኡኑና ሀሱ ጎራታኮ ሀጋአበረ ፋዬ።<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />ኡሱኮ ኦአጋልሳታረን ካለ ቤን የሱሳ ቶስ ጋባላመንጉረን፥ “ኖ ባቲክ አያና ኡኑኮ ቤስን ካኮዋኔና መዉንያ?” አመን ሆሳተን።<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />የሱሳና፥ “አማኖክስን ማንኮሀንቃተሮ ማራንያ። አን ሩምና አማራ፥ ታስናፍጭ ኢል ግታክ አማኖ እስኑን ግረዋ፥ ህታ ዎዳም፥ ‘ሂታኮ ክንጉዴ ቶላዴ ሴ!’ ጎአንቴን ሴታተዋ፥ እስኑን ካሌኖን ኮኮ ላኮግሮ።<note caller="-" style="x"><char style="xo" closed="false">17፡20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">ማቶ. 21፡21</ref>፤ <ref loc="MAT 11:23">ማቶ. 11፡23</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፡2</ref>።</char></note> [<verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />ሂካ ኣንክክ ጎአመን ኤብና ካአጋቡይ ጎሌ ኳሬ ላኮቤሮ] አመ።”<note caller="+" style="f"><char style="fr" closed="false">17፡21 </char><char style="ft" closed="false">ኮኮ ታጋልባ ጹፊል ቶቶ 21 አዳራን፤ ሃፉራና ማር። 9፡28 ካግሮ ኣን ላራ። </char></note><verse eid="MAT 17:21" /></para>
  <para style="s1">የሱሳ ጎይኬሳና ጎይኮ ክያኖኬሳኮክ ጋራ ካላም አዬሰ</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />ኡል ካጋሊላይ ኡሱኮ ኦአጋልሳታራን ኩኩሜን ግራን የሱሳ እሶነ ሃ አመ፥ “ኤረ ካእባዶ ገነ ታእባዶይ ሮር ስሳምናራ፤ <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />ላጋድናራን፥ ኡሱና ታሴድ አሪ ጎይኮ ኪናራ” ኡሱኮ ኦአጋልሳታረና ኣሎ ጋዴን።<verse eid="MAT 17:23" /></para>
  <para style="s1">ቁሉክ ምን ዋ ማራን ጊራ ሙራኖ</para>
  <para style="r">(<ref loc="EXO 30:13">ብያ. 30፡13</ref>፤ <ref loc="MAT 22:17-21">ማቶ. 22፡17-21</ref>፤ <ref loc="ROM 13:7">ሮመ 13፡7</ref>፤ <ref loc="JHN 6:61">ያን. 6፡61</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />የሱሳና ኡሱኮ ኦአጋልሳታረን ቅፍረናሆም ቶስ ካኮግያረን ጎራታ ቁሉክ ምን ካዋኮክ ጊራ ኦአባባሬን ጴጢሮሳ ቶስ ጋባላመንጉረን፥ “ካአጋልስሳራክስን ቁሉክ ምን ካዋኮክ ጊራ ላኮሙራሮያ?” አመን።<note caller="-" style="x"><char style="xo" closed="false">17፡24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">ብያ. 30፡13</ref>፤ <ref loc="EXO 38:26">38፡26</ref>።</char></note><verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />ጴጢሮሳና፥ “እ ሙራራ” አመ። ጴጢሮሳ ምን ኦሮዴ ጎጎታቤይ፥ የሱሳ ሆራርጀ፥ “ስሞና! ካኡሌ ዎኖጆልኮክ ጊራ ጎርቱን ቃራጣ ካኮአትናራን ካኡሌ እባዶኮያ ሙ ካካለኮ ኣን ላራ?” አመ።<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />ጴጢሮሳና፥ “ካካለኮያ ካኮአታማራ” አመ። የሱሳና፥ “ጎርታኑን ይሳስክስን ታጊራ ሙራኮ ሄሰራ።<verse eid="MAT 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 17:27" />“ጎሌና ኖ እሶን ሀንዱዱፎ ጎጎሌኖንኮ ላቡ ቶስ ዳግጉደ ማንጣቆ ሉጉዳ፥ ሆራርጀ ካአባቶ ኩኑኡብ ኣትጉደ ህኢ ጎጎባንተይ ማራጋደ ሄልናታ፥ ሀሱ ኣትጉደ እን ማራንትኑና መገካ ማራን ሙር” አመ።<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">ዎኖናት ካዳሩረይ ዱባንኮ ካሮራራ አዮያ?</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር. 9፡33-37</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9፡46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />ሀሱ ጎራታ የሱሳኮ ኦአጋልሳታረን የሱሳ ቶስ ጋባላመንጉረን፥ “ዎኖናት ካዳሩረይ ዱባንኮ ካሮራራ አዮያ?” አመን ሆሳተን።<note caller="-" style="x"><char style="xo" closed="false">18፡1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፡24</ref>።</char></note><verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />የሱሳና ይትት ኮ ኡመጉረ እሶ ጠኤ ኣልሰረ፥ <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />“አን ሩምና አማራ፤ ጎኢግልሳሞና ይሳስ አን ጎሌኖን ዎኖናት ካዳሩረ ቶስ ሱረ ላኮታብታን።<note caller="-" style="x"><char style="xo" closed="false">18፡3 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፡24</ref>።</char></note> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />ሃንሱን ዎኖናት ካዳሩረይ ዱባንኮ ካሮራራ ሂካ ይትት ኣን እስኦቴሳ ካሁስሳታሮያ።<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />“ሂካማሌክ ይትት መገኬይ ካአታታራ እና አታተራ።”<verse eid="MAT 18:5" /></para>
  <para style="s1">እባዶን ሀንዱዱፎ ላናኮ እስኦራታኖ</para>
  <para style="r">(<ref loc="MRK 9:42-48">ማር. 9፡42-48</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17፡1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />አየሱን ጎአመን እዬ ኦአማናራን ሂናኣ ኦትድጫርኮ ኮ ጩቦ ኦርዴሰ ካታብሳራ ካንጂንክ ኤኤሞ ካሪሜ ማርግቴሳ ሽያምጉረ በከ ባድ ጠኤ ሻፋም ልች ጎአመ ኢዳረ።<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />“ሂክ አላም ጩቦን ኣላንቲ ማንኮሌሮ ማራን ኣኔ ኡሱን! ጩቦ ኦርዴሰ ካታብሳራ ኤመታኖ ላኮሄስሮ፤ አየሱን ጎአመን ጩቦን ኣላንቲ ካላሮ እባዶን ኣኔ! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />ገነታ ጎርቱን ሉክታ ኩን ጩቦን ኣላንቲ ጎሌተ ጎስ ሻፍ። ገነ ላማ ጎርቱን ሉቃ. ላማ ኩን ግርጉረን ጅሩ ጅሮማን ታባኖን ታጋነም ኤለን ቶስ ሻፋማናኮ ካኤሳቶ ጎርቱን ናፋለሳ ሊጉደ ጅሩ ጅሮማክ ግር ቶስ ታባኖ ካእዳንክያ።<note caller="-" style="x"><char style="xo" closed="false">18፡8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5፡30</ref>።</char></note> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />ኡሱማሌ ኢልታ ጩቦን ኣላንቲ ጎሌተ ቤስ ሻፍ፥ ኢልኦ ላማ ኩን ግርጉረን ታጋነም ኤለን ቶስ ካሻፋማቶኮ ኢል ቶ ኩን ግርደ ጅሩ ጅሮማክ ግር ቶስ ታባኖ ካእዳንክያ።”<note caller="-" style="x"><char style="xo" closed="false">18፡9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5፡29</ref>።</char></note><verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />ዳሩሪ ካግራ ኤርግቻልክሶ አርጌቶ ዳሩሪ ካግሮ ኣቦኬ ሆረ ማንኮግራን ሂናኣ ክጪጫኮ ኮና ጎጎቱፋኖንኮ እስኦራዬን። [<verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />ኤረ ካእባዶ ኦባዬራን ሃስን ኤመተራ።]<note caller="+" style="f"><char style="fr" closed="false">18፡11 </char><char style="ft" closed="false">ቶቶ ታጋልባ ጹፍል ቶቶ 11 አዳራን፤ ሃፉራና ሉቃ. 10 ካግሮ ኣን ላራ። </char></note><note caller="-" style="x"><char style="xo" closed="false">18፡11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">ሉቃ. 19፡10</ref>።</char></note><verse eid="MAT 18:11" /></para>
  <para style="s1">ካባየሮ ኢዳዶኮክ ማሱሳ</para>
  <para style="r">(<ref loc="LUK 15:3-7">ሉቃ. 15፡3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />የሱሳና አደ፥ “አላ ኢን ሰጋ፤ እባዶት ኮ እዳድ ቦል ካአቦ ጎሌ፥ እሶ ኦሮኮ ኮ ጎባየ ሳጋልታምኮ ሳጋሊ ዎዳሚ ጉት ኢሰጉረ ካባየሮ ኮ ዶታዪን ላኮሴታሮያ? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />አን ሩምና አማራ፥ ካባየሮ ኢዳዶ ጎሄላሮ ኦግራን ሳጋልታምኮ ሳጋሊ እዳድኮ ሱረ ሀሱ ካሄላመሮን ገጌላታራ። <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />ኡሱማለና ሂካ ክጪጫር ኦሮኮ ኮ ጎጎባሮን ዳሩሪ ካግሮ ኣቦክስንት ፈኢ ላኮቶ።<verse eid="MAT 18:14" /></para>
  <para style="s1">እስኦሮ ቁቃማኖኮክ ጋራ</para>
  <para style="r">(<ref loc="LUK 17:3">ሉቃ. 17፡3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“አቢካ ኩ ሚርኢ ጎግረ ሴጉዴ ኡሱነ ዎታ ላማ ላዴን ባስኬሳ ሰጊ፥ ኩ ጎማለ አባባተደ አቢካ የላታ።<note caller="-" style="x"><char style="xo" closed="false">18፡15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">ሉቃ. 17፡3</ref>።</char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />ማላና ጎዋተ አደ እባዶ ላማ ጎርቱን ሴድ ካአቶቴራ አየስ ዱባ ማንኮአታታሮ ማራን እባዶ ኮ ጎርቱን ላማ አት ሴጉዴ ጋፋችስ።<note caller="-" style="x"><char style="xo" closed="false">18፡16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">አዳ. 19፡15</ref>።</char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />እሶና ማላና ጎዋተ ምን ካዋክ እባዶን ሰጊ፥ ምን ካዋክ እባዶ ካማሎን ጎሌ አይዛብ አንና ቃራጣ ካኩኩይሳሮ ኣን ቶቲ።<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“አን ሩምና አማራ፥ እስን ኡል ካሺተን ዱባ ዳሩሪ ካሽያመ ላራ፥ እስን ኡል ካፉርቴን ዱባ ዳሩርና ካፉራመ ላራ።<note caller="-" style="x"><char style="xo" closed="false">18፡18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ. 16፡19</ref>፤ <ref loc="JHN 20:23">ያን. 20፡23</ref>።</char></note><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“አደና አን ሩምና አማራ፥ ኡል ጉት ላማ ሊዴን ማምስክ አዬንሳ ዎታ እስኣት ዋ ጎኤባቴን ዳሩሪ ካግራ ኣቦክ ማልረ እሶን ፈሎዋ። <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />ላማ ጎርቱን ሴድ ሊጉሬን መገኬይ ታኮኩኩአማራን ባንኤይ አን እሶ ኦሮ ሙትናራ።”<verse eid="MAT 18:20" /></para>
  <para style="s1">ሀሄሶ አማኖኮክ ጋራ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />ሀሱ ጎራታ ጴጢሮሳ የሱሳ ቶስ ጋባላመረ “ጎታ! አቢክ እን ጎሚረኤ ምያ ጋል ኡሱን ሀሄሶ አምራ? ታ ቶዶባ ጌሮይያ?” አመ ሆሳተ።<note caller="-" style="x"><char style="xo" closed="false">18፡21 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">ሉቃ. 17፡3-4</ref>።</char></note><verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />የሱሳና፥ “ቶዶባታም ጋል ቶዶባ ኳሬ ቶዶባ ጋል ካላል አን ላኮአማሮ” አመ።<note caller="-" style="x"><char style="xo" closed="false">18፡22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">መጣ 4፡24</ref>።</char></note><verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />“ሃንሱን ዎኖናት ካዳሩረ ኡሱን ኦሀንዳራንኮት ገነ ካግሮ ማራጋደ ቶት ድን ካዶታታሮ ዎኖ ኣን ላራ። <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />ዎኖና ማራጋደኬሳ ቶታይን ካኮሀጋአባረ ጎራታ ኩማ ካሞጋኒ ካቶታምሮ ማራጋደ አንዛ ካአቦ እባዶት ኮ ኡሱ ቶስ ኣተን ኤመተን። <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />ሂክ ካሀንዳረክና አንዛ ሙርን ማንኮዋተሮ ማራን ኡሱኔ፥ ኦርቴሳነ፥ ይስኬሳነ፥ ኡራዎኦቴሳነ ዱባ ዳዳላም አንዛ ጎጎሙራንቶ ጎታ አጃጄ።<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />“ሀሱ ጎራታ ካሀንዳረክና ጎታከሳኮት ሉኪ ኢየጉረ ኦብሲ፤ ታአቦ አንዛ ዱባ ጋቾ ኩን አን ሙራ አመ ኤባተ። <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />ጎታኬሳና ነኔኤይሳተጉረ ኡሱ ጋፋረ፥ አንዛተሳና ኢሳገ።<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“ሀሱ ካሀንዳረክና ጎታ ሆረኮ ጎጎቤይ ማራጋደኬሳ ጣጋራ ካአቦ አንዛ ካአባናየ ኡሱነ ዎታ ካፈላረ ኡናቴሳ ካሌራ እባዶት ኮ ሄለጉረ ጩልኤ አበረ ታአብቶ አንዛ ህታኒ ኢን ሙር!” አመ።<note caller="+" style="f"><char style="fr" closed="false">18፡28 </char><char style="fqa" closed="false">ዲናር፤ </char><char style="ft" closed="false">ፈሎ ካፈላሮ እባዶት ኮኮክ አሪ ቶዉን ካሙራማሮ ዳሞዛያ። </char></note><verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />“ሀሱ ሳትኬሳና ኡሱ ሆረ ኢየጉረ፥ ‘ማጋኔ ኦብስ አን ኩን ሙሮዋ’ አመ ኤባተ።<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />“አየሱን ጎአመን ታአቦ አንዛ ኡሱ ሙር ታጉድስሮይ ኦብሳና ዋተረ ምን ካሻኖ ኡሱ ታብሰ። <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />ካሌሮ አየስ ካዴራ ካካለ ካፈሎ እባዶና ነኔኤይሳተ፥ ካሌሮ ዱባና ሰተንጉረን ጎታክሶዉን ሰገን።<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />“ኡሱ ጎራታ ጎታና ሀሱ ካሀንዳሮ ኡምስሰጉረ ሃ አመ፥ ‘አት ካሜላን ካሀንዳታ!’ ‘አት እን ማንኮኤባተተ ማራን ሀሴ አንዛ ዱባ አን ኩን ኢሰረ፤ <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />አን ኩን ጎጎኢሰሮ አትና ካጌላታቶካዉን ነኔኤይሳይን ላኮዶትሳረየ?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />እኦተረ ታአቦ አንዛ ዱባ ሙር ታጉድስሮን ካሻሮና ካሙርሳሮን ሮርሰ ኡሱ ስሰ።<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“ሃንሱን እስን መተመቴ አቢላልትስኑን ዎዳናኮ ሀሄሶ ጎአሞን ካዳሩረ ኣቦክስን እስና ሂካማሌ የልናራ።”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">ከልክ አም ቤሳኖኮት ሆስን</para>
  <para style="r">(<ref loc="MRK 10:1-12">ማር. 10፡1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />የሱሳ ሂካ አዬሰ ጉድሰጉረ ኡል ካጋሊላኮ ኬጉረ ላጋ ካዮርዳኖስኮ ጋማ ካግሮ ኡል ካይሁዳ ሴተ። <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />ጎሳ ካሞጋና ኡሱ ዴበ ሰሴተ፥ ኤሴና እሶ ፋይሰ።<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />ፋራሳዊልና የሱሳ ጫፍን ዶተን ኡሱ ቶስ ጋባላመንረን፥ “እባዶት ኮ ማምስት ኣላንቲና ኦርቴሳ ከልክ አም ቤስን ፈኢ ስሳንተታ?” አመን ሆሳተን።<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />የሱሳና እሶን አባበረ፥ “እሶ ካመጠራ ዋ ሆራርጀ ባባርና ሄለል የለ ካመጠሮ ላኮናባብቴታንያ?<note caller="-" style="x"><char style="xo" closed="false">19፡4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">መጣ 1፡27</ref>፤ <ref loc="GEN 5:2">5፡2</ref>።</char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />ሃንሱን፥ ‘እባዶ ኣቦኬሳና ኣየቴሳ ኢሰጉረ ኦርቴሳነ ዎታ ቁራናማራ፥ እሶ ላማና ማር ኮ ላራን ካአማመራ ላ ሂካኮት ኣላንቲዮላ’?<note caller="-" style="x"><char style="xo" closed="false">19፡5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መጣ 2፡24</ref>።</char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />ጎርታኑ ማር ኮያን ኳሬ ላኮላማያን። ሃንሱን ዋ ካቁራኔሮ እባዶ ላኮፉሮ።”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />ፋራሳዊልና፥ “ሀያ ሙሴ ባባርትት ኮ ኦርቴሳ ከልክ አማኖን ካሌሮ ዎራቃታ ስስ ኦርቴሳ ጎጎጋፋሮን ‘ሙን አጃጄ?’ አመን።”<note caller="-" style="x"><char style="xo" closed="false">19፡7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">አዳ. 24፡1-4</ref>፤ <ref loc="MAT 5:31">ማቶ. 5፡31</ref>።</char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />የሱሳና፥ “ሙሴ ዎዳናትስንኮክ አታን ዴጉረ ኦርጆልክስን ከልክ ጎጎአንታኑን ፈኢ ስሰራ ኳሬ ጣየ ላኮሃየ። <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />አን ጎአመን ሃ አማራ፥ ኤንተርክሰ ግራን ካካለኔ ዎታ ሻርሙጣ ጎሙተ ኳሬ ኦርቴሳ ከልክ አመ ጋፋረጉረ ታካለ ሄለልትቲ ኦር ካየላታራ ዱባ ካሻርሙጣሮያ” አመ።<note caller="-" style="x"><char style="xo" closed="false">19፡9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5፡32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፡10-11</ref>።</char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />የሱሳኮ ኦአጋልሳታረና፤ “ታኤንተሬና ታኦሪ ሃጃ ሂካማሌ ጎሌተ ኦር አታታኖ ኢሳጋኖ ሆረክ” አመን።<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />የሱሳ ጎአመን፥ “ሂክ ዋኮ ካስሳመ ጎሌ ኳሬ ሂካ አየስ ማዮና አታይን ላኮዳንዳሮ። <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />ኣላንቲና ኮኮ አላታ ሳንጎመ ካአላታራ ግራ፥ ካካለ ገነ ታእባዶቲ ጎሳመ ካሳንግሳማራ ግራ፥ አደና ዎኖናት ካዳሩረዉን አመንጉረን ኦር ሀአታኖን ኦግራን ግራን፥ ሂካ አታይን ካዶታታራ ሀአታቶ” አመ።<verse eid="MAT 19:12" /></para>
  <para style="s1">የሱሳ ይሳስ ሶማሳተ</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር. 10፡13-16</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18፡15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />ኤሰኮና ገነቴሳ እሶ ጉት ካይጉረ ጎጎኤባሮን እባዶ ይሳስ የሱሳ ቶስ ኬን፤ ኡሱኮ ኦአጋልሳታረና አደን ይሳስ ካኬናሮ እባዶ ሀድሴን።<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />የሱሳና፥ “ኢሳ ይስ እን ቶስ ሀኤመቶ አሮትርቴን፥ ዎኖናት ካዳሩረ እሶ ኣንክክንያ።” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />ገነተሳና እሶ ጉት ካየ አባባተረ ኤሰ ባንኤኮ ኬጉረ ሴተ።<verse eid="MAT 19:15" /></para>
  <para style="s1">ዱረሳክ እባዶትኮት ሆስን</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር. 10፡17-31</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18፡18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />ኤሰኮና እባዶት ኮ የሱሳ ቶስ ኤመተጉረ፥ “ካአጋልስሳቶ! ጅሩ ጅሮማክ ግር ሄላይን መ ካእዳንክ አየስ ፈላ?” አመ ሆሳተ።<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />የሱሳና፥ “ካእዳን አዬስኮክ ጋራ እን ሙን ሆሳታ? ካእዳንክ ካሌራ አየስ ኮ ካላልያ፥ ጅሩ ጅሮማክ ግር ቶስ ታብን ጎዶታተ አድ አጃጃኬ ኦራ፥” አመ።<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />ዎዳላትና፥ “ኤክ አጃጃ?” ሃ አመ ሆሳተ። የሱሳና፥ “አሮላጋደ፥ አሮሻርሙጢተ፥ አሮሄቴ፥ ጣራ አሮአቶቲተ፥ አመ።<note caller="-" style="x"><char style="xo" closed="false">19፡18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ብያ. 20፡13-16</ref>።</char></note> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />ኣቦካና ኣየታ ካባጂና፥ ኦላታና እስኦታ ኣን ጌላ” አመ።<note caller="-" style="x"><char style="xo" closed="false">19፡19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ብያ. 20፡12</ref>፤ <ref loc="DEU 5:16">አዳ. 5፡16</ref>፤ <ref loc="LEV 19:18">ዎዩ. 19፡18</ref>።</char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />ዎዳላትና፥ “ሂካ ዱባ ኦራዬራ፥” ሂካኮ ካካለ “ካሀንቃተራ መያ ካግራ?” አመ።<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />የሱሳና፥ “ቁሉ ሊን ጎዶታተ ሴጉዴ ኦአብቶ ኡራዎኦታ ዱባ ዳዳልደ ማራጋደ ህየሳን ስስ፤ ዳሩሪ ኡራዎ ሄላይናታ። ኤሰኮና ኤሜጉደ እን ዴበ ሰሴ” አመ።<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />ሂክ ዎዳላት ሂካ ካኮማላረ ጎራታ ኡራዎ ኦሞጋን ማንኮአቦ ማራን ያዳ ኢሰ ሴተ።<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />የሱሳና ኡሱኮ ኦአጋልሳታረነ፥ “አን ሩምና አማራ፤ ዱረሳ ዎኖናት ካዳሩረ ቶስ ታባኖ ኣሎ ቃራያ። <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />አደና አን አማራ፥ ዱረሳ ዎኖናት ካዳሩረ ታባኖኮ ጋላ ቡቶ ካማርፍ ታባኖያ ኤነ ካሌራ” አመ።<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />የሱሳኮ ኦአጋልሳታረን ሂካ ማለንጉረን ኣሎ ማማ፥ “ሀያ አዮያ ፋይን ካዳንዴራ?” አመን ሆሳተን።<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />የሱሳና እሶ ቶስ ዲያ፥ “ሂክ እባዶ ዶሌ ላኮዳንዳምሮ፥ ዋይ ዶሌ ጎአመን አየስ ዱባ ዳንዳማራ አመ።”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />ጴጢሮሳና አባበረ፥ “ኖ ካመን ዱባ ኢንሰጉነ ኩ ዴበ ሰሴታና፥ ሀያ ኖ መ ሄላይናና?” አመ።<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />የሱሳና፥ “አን ሩምና አማራ፤ ካኤሜይናሮ ካኡሱብ አላም ኤረ ካእባዶ ካካባጃ ኮርፍንጄ ጉት ካኮሀማጼ ጎራታ እን ዴበ ኦሰሰያታን እስና ቶሞንኮ ላማ ኮርፍንጄ ጉት ሀማጺጉዴን ቶሞንኮ ላማ ታእስራኤል ኣኒ ጉት ፍርድናታን።<note caller="-" style="x"><char style="xo" closed="false">19፡28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25፡31</ref>፤ <ref loc="LUK 22:30">ሉቃ. 22፡30</ref>።</char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />መገኬ ማራን አምረ ምንጆል፥ ጎርቱን አቢላል፥ ጎርቱን አባላል፥ ጎርቱን ኣቦ፥ ጎርቱን ኣዬ፥ ጎርቱን ይስ፥ ጎርቱን እራ ካኢሳራ ዱባ ቦልኮክ አምባ አታይናራ፥ ጅሩ ጅሮማክ ግርና ኤልናራን። <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />አየሱን ጎአመን ካሞጋን ካሆሬ ካሃረ ልናራን፤ ካሞጋን ካሃረና ካሆሬ ልናራን” አመ።<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">ካዎይኒ እራ ኦፈላራንኮክ ማሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“ዎኖናት ካዳሩረ ዎይንኮት ባንኤ ካፈላሮ ካፈሎ እባዶን ፈሎ ስስን ባር ቡላነ ኬ ካቤሮ ካዎይኒ አካክልተኮክ ኦዶ ኣን ላራ። <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />ኡሱና ኦፈላራዉን አሪ ቶይ ጣጋራ ቶ ቶ ሙርን ኤካተጉረ ካፈሎ እባዶ ታዎይኒ ባንኤ ቶስ ታብሰ።<note caller="+" style="f"><char style="fr" closed="false">20፡2 </char><char style="fqa" closed="false">ጣጋራ፦ </char><char style="ft" closed="false">ፈሎ ካፈላሮ እባዶትን አሪ ቶዉን ካሙራማሮ ዳሞዛያ። </char></note><verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />“ባርኮ ሳቲ ሴድና ቤጉረ ፈሎ ዋተን ታግያ ባንኤ ካአሌሮ ካካለ እባዶ ሄለጉረ፤ <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />እስና ‘ሰዬንጉዴን ካዎይኒ ኢራኬይ ፈሎ ፈላ፥ ታዶትሳቶ ሙራ እስኑን አን ጋቾሙራ’ አመ። <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />እሶና ሴተን፥</para>
  <para style="p" vid="MAT 20:5">“አሪኮ ሳቲ ሌይና ሳቲ ሳጋሊ ኤመተረ ካካለ ፈላተ ካባራሮ እባዶን አማለኮኒዕ ፈሎ ስሰ። <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />ሜርት ሳቲ ቶሞንኮ ኮክ ጎራታ ቤጉረ አሌ ካግሮ ካካለ እባዶ ሄለጉረ ‘አሪ ዱዶ ፈሎ ካላይ ህታኒ ሙን አልቴታን?’ አመ ሆሳተ።<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />“ ‘እሶና፥ ኖን ፈሎ ካስስሮ እባዶ ማንኮዋኔኖ ማራንያ’ አመን።</para>
  <para style="p" vid="MAT 20:7">“ኡሱና ‘እስና ሰዬንጉዴን ካዎይኒ ኢራኬይ ፈላ’ አመ።<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“ኡል ሄመን ካኮላረ ጎራታ ካዎይኒ አካክልተኮክ ኦዶ ኡሱን ኦፈላራን ኦዶናቲ ካዴሮ እባዶትን ስሰጉረ፥ ‘ዳንበኔ ካኤሜተሮኮ ሀጋአብደ ሆራርጀ ካኤመተሮ ታ ጌሮ ካግሮ ካፈሎ እባዶ ዱባ ኡምጉደ ዳሞዛክሶ ሙር’ አመ።<note caller="-" style="x"><char style="xo" closed="false">20፡8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">ዎዩ. 19፡13</ref>፤ <ref loc="DEU 24:15">አዳ. 24፡15</ref>።</char></note><verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />“ሳቲ ቶሞንኮ ኮይ ፈሎን ኦታቤራን ኤመተንጉረን መተመቴ ጣጋራ ቶቶ አታቴን። <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />ሆራርጀ ፈሎን ኦታቤሬን ኤመተንጉረን ጣጋራ ኦንጂ ሙራ ኦሄላይናራን አን እሶን ሌረ፤ አየሱን ጎአመን እሶና መተመቴ ጣጋራ ቶቶ ሙራንተ። <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />ሙራ አታታግራን ካዎይኒ አካክልተኮክ ኦዶ ጉት ጉምጉመን። <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />ሂኒዕ ዳንበኔ ፈሎን ኦታቤረን ሳቲ ቶ ታላል ጎፈላን፤ አሪ ዱዶ ፈሎይ ሀራና አርቲ ጉባታ ኦሀይነኖ ኖኔ ዎታ ምሲ አማለኮይ ሙራታ? አመን ሆሳተን።<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />“ኡሱና ፈላተ ካባራሮ ኮኔ ሃ አመ፥ ‘ካጌላታሮኬ! አን ኩን ሚራኣ ላኮጌግሰሮ፤ ጣጋራ ቶይ ፈልን አት ኢነ ዎታ ላኮኤካተያ? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />ኩ ካገያሮ አታጉደ ሴ፥ ኩን ካስሰሮ ግታክ ዳንበኔ ካኤመተሮ እባዶትና ስስን ዶትሳራ። <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />ሀያ ማራጋደኬይ ካጌላየ ፈላይን አን ላኮዳንዳሮያ? ጎርቱን አን ካእዳን ማንኮፈለሮ ማራን ምጌ ታሜላን ኩ አብተ?’<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />“ሃንሱን የሱሳ፥ ካሃረ ካሌራ ካሆሬ፥ ካሆሬና ካሃረ ልናራ አመ።”<note caller="-" style="x"><char style="xo" closed="false">20፡16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ. 19፡30</ref>፤ <ref loc="MRK 10:31">ማር. 10፡31</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13፡30</ref>።</char></note><verse eid="MAT 20:16" /></para>
  <para style="s1">የሱሳ ጎይኬሳና ጎይኮ ከያኖኬሳ ካሴድ አዬሳኖ</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር. 10፡32-34</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18፡31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />የሱሳ ኢየሩሳለም ቶስ ሴታ ግራን፥ ቶሞንኮ ላማ ኡሱኮ ኦአጋልሳታረን ካለ ኣተ ቤጉረ፥ <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“ጎርታኑ ኖን ኢየሩሳለም ቶስ ብያኖያ፥ ኤረ ካእባዶ ቱቃሞልኮክ ዎይቻሉና ሴራ ካሙሴ ኦአጋልስሳራኑን ሮር ስሳምናራ፥ እሶና ኡሱ ጎጎ ጎሮን ፍርድናራን። <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />ጎጎቃጭፋራዉን፥ ጎጎቦጭራዉና ጎጎሱይራዉን አይዛብዉን ሮርስ ስስናራን፥ ኡሱና ታሴድ አሪ ጎይኮ ኪናራ” አመ።<verse eid="MAT 20:19" /></para>
  <para style="s1">ካጎታ ዎኖናት ኦሮ ጦቂ ታአንተ ባንኤ ሄላታኖኮክ ሆሲን</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር. 10፡35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />ኤሰኮና ይስ ካዛብዶሳኮት ኣዎ ይስክሴነ ዎታ የሱሳ ቶስ ኤመተዴ ሆረ ግልቢሰ ሳጋዳ አየስ ኮ ኡሱ ኤሰን ጎጎፈሎ ኤባተ።<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />የሱሳና ኤሰነ፥ “መ ዶታታ?” አመ። ኤሰና፤ “ሂካ ይስኬ ላማ ዎኖናትካይ ኮ መርገታይ፥ ኮ በተታይ ጎጎሀማጺራዉን ፈኢ ስስ” አንተ።<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />የሱሳና፥ “እስን ካኤባታን ላኮካሳን፥” “አን ታጣምናሮ ታራኮ ጡጋ እስን ጣምን ዳንዴታነ?” አመ ሆሳተ። እሶና “እእ ዳንዴኖዋ!” አመን።<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />ኡሱና፥ “ታራኮ ጡጋቴኮ ጎሌና ጣንታንዋ፥ አየሱን ጎአመን መርገቴይና በተቴይ ሀማጻኖ ጎአመን ኣቦክ ካኮንኤካሰሮንያ ኳሬ አን ፈኢ ካስሳሮ አየስ ላኮዮ” አመ።<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />የሱሳኮ ኦአጋልሳታረን ቶሞኖና ሂካ ካኮማላረን ጎራታ አቢላል ላማ ጉት አማራቴን። <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />የሱሳና እሶ ዱባ ኡመጉረ፥ “አይዛብኮክ ሞትጆል ጎሳክሶ ጉት ሞት ጎጎሌራዉን ኦዶናት ኦባሪሳራና ሁናይ ካባርሳራን ላኖ ካሳንዋ። <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />እስን ኦሮ አደ ሂካማሌ ላኖ ላኮዶትሳሮ። አየሱን ጎአመን እስኒ ኦሮ ካንጂንክ ሊን ካዶታታራ እስኑን ካሀንዳሮ ሀሌዎ።<note caller="-" style="x"><char style="xo" closed="false">20፡26 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ. 22፡25-26</ref>።</char></note> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />እስንኮ መተ ሊን ካዶታታራና እስኑን ድይ ሀሌዎ።<note caller="-" style="x"><char style="xo" closed="false">20፡27 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23፡11</ref>፤ <ref loc="MRK 9:35">ማር. 9፡35</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፡26</ref>።</char></note> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />ኤረ ካእባዶ ካኮንኤመተራ ኖ ኡሱን ጎጎሀንዳይኖን አንሌኖን ግራን ሀንዳይና ኔፎቴሳ ካሞጋኑን ዎዶ የላይ ስሳይን ኤመተራ” አመ።<verse eid="MAT 20:28" /></para>
  <para style="s1">የሱሳ ኢልኦ ኦደያኖን እባዶጃ ላማ ፋይሳኖ</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር. 10፡46-52</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18፡35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />የሱሳና ኡሱኮ ኦአጋልሳታረን እያርኮኮ ቤን ሴታ ግራን ጎሳ ካሞጋን ኡሱ ዴበ ሰሴተ። <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />ኤሴና ኢልኦ ኦደያኖን እባዶጃ ላማ ራድ ሀማጼን ግረን፥ የሱሳ ኤሰነ ሮራኖ ካኮማላረን ጎራታ፤ “ጎታ! ኤረ ካዳዉተ፤ ኖን ነኔኤይሳና” አማ እዬን።<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />ጎሳና እሶ ጫልኢ ጎጎአምራዉን ሀድሰ፥ እሶ ጎአመን፥ “ጎታ ኤረ ካዳዉተ ማጋኔ ኖን ነኔኤይሳና” አማ ኣሎ እዬን።<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />የሱሳና ታክ አመ አሌ እሶ ኡመ “አን እስኑን መ ጎጎየሎ ዶታታን?” አመ።<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />እሶና “ጎታ!” “ኖ ኢልኦኦታን ጎጎዴራዉን ዶታታና አመን።”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />የሱሳና እሶን ነኔኤይሳተጉረ እልኦ ኦትሶ ድንድነጉረ ጎርሰዋ እልኦ ኦትሶ ዴንዴን፥ እሶና ኡሱ ዴበ ሰሴተን።<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">የሱሳ ካባጃ ታአቲይ ኢየሩሳለም ቶስ ታባኖ</para>
  <para style="r">(<ref loc="MRK 11:1-11">ማር. 11፡1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፡28-40</ref>፤ <ref loc="JHN 12:12-19">ያን. 12፡12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />ኢየሩሳለም ቶስ ጋባላማ ዛይቲ ካበያራ ጋ ታኮአላታሮ ዎዳም ጉት ካግሮ ማማን ካፋገ ታአማማቶ ባንኤ ጎጎጌይ የሱሳ ኡሱኮ ኦአጋልሳታረንኮ ላማ ፋረ። <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />ሃና አመ፥ “እስን ሆረ ካግሮ ማማን ቶስ ሴዬን፥ ጎጎጌቴን ደሜርትት ቶ ዳርሜነ ዎታ ታሻንተቶ እስን ሄልናታን፥ ፉራዴነ እን ቶስ አታ ኮዬን። <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />ማዮና እስኔ ሃ ሙን የላታን ጎአመ፥ ‘ጎታ ዶታታራ’ አማ። ጎርሰዋ ጋፋራንዋ።”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />ሂክ ካኮንሌራ ካሄገሮይ ሃ አማመ ካሰጋመራ ጎጎጉዳሮንያ።<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“ጽዮን ታአማማቶ ታኢየሩሳለም ካታማዉን ሃ አም፥</para>
  <para style="q2" vid="MAT 21:5">‘ሂክማ ዎኖካ ፋያንካ ሌጉረ፥</para>
  <para style="q2" vid="MAT 21:5">ደሜርትትና ዳርሜት ጉት ሀማጼጉረ ኩ ቶስ ኤመታራ’ አማዴን ኤሰን ሰጋ።”<note caller="-" style="x"><char style="xo" closed="false">21፡5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዛኪ. 9፡9</ref>።</char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />ኡሱኮ ኦአጋልሳታረና ሰተንጉረን የሱሳ አጃጃ እሶን ጎጎስሰሮክ ማለ የሌን። <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />ደሜርትትና ዳርሜት ኬነንጉረን ሳርስክሶ ካደሜሬ ባጋድ ጉት ካዬን፤ የሱሳና ኤሰ ጉት ሀማጼ። <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />ጎሳኮና ጋምሳ ሳርስክሶ ራድ ያዬን፤ ካካለና አደ ባላል ታታርሼን ኣተን ራድ ሉሉጉዴን። <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />ሆረሃየ ካሰሰታረና ሃሬ ኡሱ ዴበ ሰሴታ ካግረ ጎሳና፥</para>
  <para style="q1" vid="MAT 21:9">“ሆሳኢና ኤረ ካዳዉተ!”</para>
  <para style="q1" vid="MAT 21:9">“መገ ካዋይ ካኤመታራ ኡሱ ካሶማሳመያ፥”</para>
  <para style="q1" vid="MAT 21:9">“ሆሳኢና ኤለ ዳሩሪ ሃ አማ ኢያረን።”<note caller="+" style="f"><char style="fr" closed="false">21፡9 </char><char style="fqa" closed="false">ሆሳኢና </char><char style="ft" closed="false">አማኖ ታኢብራይስጢ ህኢ ፋይና፥ ዋየ ኖ ፋይስና አማኖያ። </char></note><note caller="-" style="x"><char style="xo" closed="false">21፡9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">ማዛ. 118፡25-26</ref>።</char></note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />ኢየሩሳለም ቶንሳ ካኮታባረ ጎራታ ካካታማ እባዶ ዱባ፥ “ሂክ አዮያ?” አማ ሻላጋመ። <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />ጎሳና፥ “ሂክ ጋሊላይ ታግቶ ታናዝሬት ካታማኮ ካኤመተሮ ካሄገሮ የሱሳያ” አመን።<verse eid="MAT 21:11" /></para>
  <para style="s1">የሱሳ ቁሉክ ምን ካዋይ ኦሮ ኦዳዳላታሬን ዴጉረ ሆሮረ</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር. 11፡15-19</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19፡45-48</ref>፤ <ref loc="JHN 2:13-22">ያን. 2፡13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />ኤሰኮ የሱሳ ቁሉክ ምን ካዋ ታበጉረ ቁሉክ ምን ካዋይ ኦሮ ኢምናታና ዳዳላታ ኦግረን ቤሰ ሆሮረ፥ ማራጋደ ኦኢግልሳታረንኮክ ጣራጴዛልና አራበ ኦዳዳላታረን ካኮሀማጼራን ቦርቦኖ ምና ምና አባበ ሉጉደረ።<verse eid="MAT 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 21:13" />“ምን ካክ ካኤብ ምን አማማራ አማመ ማጻፋ ቁሉክ ጻፋመራ፥ እስን አዴን ካኮሳማራን ላጋ ካሽታ የልተታን” አመ።<note caller="-" style="x"><char style="xo" closed="false">21፡13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56፡7</ref>፤ <ref loc="JER 7:11">ኤር. 7፡11</ref>።</char></note> <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />ቁሉክ ምን ካዋይ ኦሮ ኢልኦ ኦድያኖና ናፋለሳል ኡሱ ቶስ ኤመተን፥ ኡሱና ፋይሰ። <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />አየሱን ጎአመን ቱቃሞልኮክ ዎይቻልና ሴራ ኦአጋልስሳራን የሱሳ ካፈላመሮ ባሳና፥ “ሆሳኢና ኤረ ካዳዉቴን” አማ ቁሉክ ምን ካዋ ኦሮ ካኢያረ ይስ ካኮደያረን ጎራታ ኣሎ አማራቴን።<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />እሶና የሱሳነ “ሂክ ይስ ታአማሮ ማላታ?” አመን። የሱሳና፦</para>
  <para style="p" vid="MAT 21:16">“እ” ማላራ አመ፥</para>
  <para style="q1" vid="MAT 21:16">“ ‘ይስኮና ናስ ካኢላታሮ ይስኮት ህኢኮ</para>
  <para style="q2" vid="MAT 21:16">ጋላታ ኤካሰ ካአማሮ ሱረ ላኮናባብቴታንያ’?” አመ።<note caller="-" style="x"><char style="xo" closed="false">21፡16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">ማዛ. 8፡2</ref>።</char></note><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />ካታማኮ ኢሰ ቤጉረ ብታንያ ካአማራን ማማኒ ሴተ ኤሰ ባሬ።<verse eid="MAT 21:17" /></para>
  <para style="s1">እል ካላይክ ጋ ካባላስ</para>
  <para style="r">(<ref loc="MRK 11:12-14">ማር. 11፡12-14</ref>፥<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />የሱሳ ባር ቡላነ ካታማ ቶስ አባባተ ሰታ ግራን ኡኤ፤ <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />ራድ ግርዲ ካግረ ጋ ካባላስ ኮ ዴጉረ ካኮሴሮ ጎራታ ባላሎ ኳሬ ኢል ቶና ሄላይን ዋተጉረ፤ “ጎርታ ጅሮማን ኩን ኢል አሮግኖ!” አመ። ጋ ካባላስና ጎርሰዋ አንጋገ።<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />ኡሱኮ ኦአጋልሳታረና ካሌሮ ዴጉረን ሳደን፥ “ጋ ካባላስ ምሲ ኮይክ አንጋግን ዳንዴ?” አመን።<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />የሱሳና፥ “አን ሩምና አማራ፤ አማኖ እስኑን ግረዋ ላኮሄዳታቴን፤ ጋ ካባላስ ጉት ካሌሮ ኣን ፈላኖ ካላል አንሌኖን ግራን ህታ ዎዳም ሂታኮ፥ ‘ታጋምጉደ በከ ኦሮዴ ታብ’ ጎአንቴን እስኑን ላረዋ።<note caller="-" style="x"><char style="xo" closed="false">21፡21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17፡20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፡2</ref>።</char></note> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />አማናቴዴን ኤቢ ካኤባታን ዱባ አታይናታን።”<verse eid="MAT 21:22" /></para>
  <para style="s1">ኦዶናት ካየሱሳ ጉት ታኤመተቶ ሆሲን</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር. 11፡27-33</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20፡1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />የሱሳ ቁሉክ ምን ካኤብ ቶስ ታበጉረ አጋልስሳ ግራን ቱቃሞልኮክ ዎይቻልና ካጎሳ ጃርሶለ ኤመተንጉረን፥ “ሂካ አየስ ዱባ ካኮፈላታ ኤክ ኦዶናትያ? ኦዶናትና ኩዬን ካስሰራ አዮያ?” አመን ሆሳተን።<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />የሱሳና፥ “አንና ሆሲን ቶ እስን ሆሳይናራ፥ አባብ ኢን ጎሰጊቴን አንና ሂካ አየስ ኤክ ኦዶናት አን ፈላሮ እስኑን ሰግናራ። <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />ካያንሳ ጥንቃታ ሀገኮ ኤመተራ? ዳሩርኮያ ሙ እባዶኮያ?” አመ ሆሳተ።</para>
  <para style="p" vid="MAT 21:25">እሶና እስ እስ ኦሮ አዬሳ፥ “ኖ ‘ዳሩርኮያ’ ጎአምኔ ሀያ ‘ሙን አማናና ዋተታን?’ አምናራ። <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />‘እባዶኮያ’ ጎአምኔ አደ ጎሳና ያንሳ ካሄገሮ አመ ማንኮአማናሮ ማራን ኖ ጎሳ አብሳታና” አመን።<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />ሃንሱን “ኖ ላኮካንሶ” አመን የሱሳን አባበን።</para>
  <para style="p" vid="MAT 21:27">ኡሱና፥ አንና ሂካ አየስ ኤክ ኦዶናት አን ፈላሮ ላኮሰግናሮ አመ።<verse eid="MAT 21:27" /></para>
  <para style="s1">ይስ ላማኮክ ማሱሳ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />የሱሳና፥ “መ ኣን ላራ? ባባር ላማ ካአባ እባዶት ኮ ግረ፤ ካሆሬ ኤረ ቶስ ሴተጉረ፥ ‘ኡኑኬ! ህታር ታዎይኒ ታአካክልተ ባንኤ ቶስ ሴጉዴ ፈሎ ፈልና አመ።’<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />“ ‘ኡኑና፥ ላኮዳግናሮ’ አመ። ባስኬሳ ማላባተረ አባባተ ሴተ።<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />“አደ ካላምክ ኤረ ቶስ ሴተጉረ ሂካማሌዋ አመ፥ ኡኑኬሳና፥ ‘እ ኣቦክ! ሴሮዋ’ አመ። አየሱን ጎአመን ሀሴኖን ሄሰ።<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />“እሶ ላማ ኦሮኮ ታኦዶ ፈኢ ካአማገራ ኤክያ?”</para>
  <para style="p" vid="MAT 21:31">እሶና “ካሆሬ ኡኑያ” አመን። የሱሳና፥ “አን ሩምና አማራ ቃራጣ ኦኩኩይሳራና ኦሻርሙጣራን ዎኖናት ካዋ ቶስ ታብን እስንኮ ጣይናራን። <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />ካጣማቃራ ያንሳ ቁሉክ ራ ቱስን እስን ቶስ ኤመተራ። እስን አዴን ላኮአማንቴታን፥ ቃራጣ ኦኩኩይሳሬና ኦሻርሙጣራን ጎአመን አማነራን። እስን ሂካ ዴተን ግራን ዱዶ ጩቦኮ ጉላ ጋልቴን ላኮአማንቴታን አመ።<verse eid="MAT 21:32" /></para>
  <para style="s1">ካዎይኒ እራ ኦታተን ኦባራራንኮት ማሱሳ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ. 21፡33-46</ref>፤ <ref loc="MRK 12:1-12">ማር. 12፡1-12</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20፡9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“ካካለ ማሱሳ ማላ፤ ካዎይኒ ኢራኮክ ኦዶ ኮ ግረ፥ እራ ማራሙርሰ ኦት ካተ፥ ዎይኒ ካኮሚጭራን ጉምቢና ኦሻተ፥ ዎይኒ ኦኦራራዉን ዴር ማዳረ፥ ኤሰኮ ኢራኬሳ ኦታተን ኦባራራዉን ክራይ ስሰጉረ ኡል ካካለ ኢሰ ሴተ።<note caller="-" style="x"><char style="xo" closed="false">21፡33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">ኢሳ. 5፡1-2</ref>።</char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />ካም ታኮኩኩይሳታራን ድግኒ ካኮግያተ ጎራታ ታዱባንተቶ ኢልኮ ቆባኬሳ አታይን ኡሱን ኦሀንዳረን ኦታተን ኦባራራን ቶስ ፋረ።<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />“ኦታተን ኦባራራና ኡሱን ኦሀንዳራን አቤንጉረን ኮ ቦጨን፥ ኮ ላጋዴን፥ ኮ አደን ኤኤሞይ ኤጌን። <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />ኡሱና ኦሆሬኮ ቶቶይ ኦሮራራን ኦካለ ኦሀንዳራን ፋረ፥ ኦታተን ኦባራራና ግዳና ኡሱማሌዋ የሌን። <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />ጎርታኑ ‘እሶ አድ ኡኑኬ ላካባጂራና፥’ አመረ ዳንበኔ ኡኑኬሳ ፋረ።<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />“አየሱን ጎአመን ኦታተን ኦባራራና ኡሱ ኡኑኬሳ ካኮድያረን ጎራታ ሂክ ካኤልናሮያ፥ ኮዬን ላጋድጉኔ ርቲቴሳ ኤልና” አመን እስኦሮ አዬሴን። <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />አቤንጉረን ካዎይኒ ኢራኮ ሳር ቤሰንጉሬን ኡሱ ላጋዴን።<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“ሀያ ካዎይኒ ኢራኮክ ኦዶ ካኮኤሜተ ጎራታ ሀኑኡ ኦታተን ኦባራራን ኡሱ ምስ ካየልናሮ ኣን እስኑን ላራ?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />እሶና “ሀኑኡ ኦሜላን አካማሌ ላጋድጉረ ካዎይኒ ኢራኮ ታዶትሳቶ ኢልኮ ቆባ ጎራታይ ኦአባባራዉን ኦካለ ኦታተን ኦባራራዉን ክራይ ስስናራ” አመን።<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />የሱሳና፥</para>
  <para style="q1" vid="MAT 21:42">“ኦግንባራን ካቱፋተን ኤኤሞ፥</para>
  <para style="q2" vid="MAT 21:42">ምኑን ምና አፋሩን ካዶትሳሮ ሌ፥</para>
  <para style="q1" vid="MAT 21:42">ሂካና ካየለራ ዋያ፥</para>
  <para style="q2" vid="MAT 21:42">ኢልኦኦታኑን ባሳያ፤</para>
  <para style="m" vid="MAT 21:42">አማመ ቁሉክ ማጻፋል ካጻፋመሮ ላኮናባብቴታንያ?” አመ።<note caller="-" style="x"><char style="xo" closed="false">21፡42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">ማዛ. 118፡22-23</ref>።</char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“ሃንሱን አን ሃ አማራ፤ ዎኖናት ካዋ እስንኮ አታምጉረ ኢል ካየላታሮ ጎሳን ስሳምናራ። <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />ሂካ ኤኤሞ ጉት ካኢያራ ኤኤባራ፤ ኤኤሞና እሶ ጉት ካኮኢያራ እባዶ አደ ቡቱትናራ።”<note caller="+" style="f"><char style="fr" closed="false">21፡44 </char><char style="ft" closed="false">ቶቶ ታጋልባ ጹፍል ቶቶ 44 አዳራን፤ ኡሱ ሃፉራና ሉቃ። 20፡18 ካግሮ ኣን ላራ። </char></note><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />ቱኡቃሞልኮክ ዎይቻልና ፋራሳዊል፥ ሂካ ማሱሳጆል ካኮማላረን ጎራታ የሱሳ ካአዬሳራ ጋራክሶ ላኖ አዴሰን። <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />አየሱን ጎአመን አብ ሺን ጎዶቴና ጎሳ አደ የሱሳ ካሄገሮ አን ማንኮድያረ ማራን አብሳተን።<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">ካሃስኖ አሞኮክ ማሱሳ</para>
  <para style="r">(<ref loc="LUK 14:15-24">ሉቃ. 14፡15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />የሱሳ አደ ማሱሳይ እባዶን ሰጋኖ ሀጋአበ፥ <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />ዎኖናት ካዳሩረ ኤረኬሳት ሃስኖን ኣሞ ካኤካሳተሮ ዎኖ ኣን ላራ፥ <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />ዎኖና ሃስኖን ካኮንሰጋተሮ እባዶ ከኬሲን ኦሀንዳረን ሀንዳ ፋራተ፥ እባዶ ጎአመን ላኮኤሜይናኖ አመ።<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />“አደና ኦካለ ኦሀንዳራን ፋረጉረ ኦኡማመራነ ጎርታ አራርና ካቃባን ‘ግድኬ ኤናኣየጉረ ኤካሳየራ ካመን ዱባ ማንኮኤካተሮ ማራን ሃስኖን ኮዬን፥ አማራ አማ ሰጋ።’<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />“ኦኡማሜራን ጎአመን ኡምት ዲደንጉሬን፤ ኮ እራ ቶስ፥ ካካለ ዶክ ዳዳላይን ሴተ፥ <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />ኦሄሴራን አደን ኦሀንዳራን አቤንጉረን አቦስሴን ላጋዴን። <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />ዎኖና አማራተጉረ ዎታዳራ ፋረጉረ ሀኑኡ ኦላጋዴራን ላጋዲስሰ፤ ካታማትሶና ኤለኒ ጉበ።<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />“ኤሰኮና ኦሀንዳሬነ ሃ አመ፥ ‘ካሃስኖ ኣሞ ኤካተራ፥ አየሱን ጎአመን ኦኡማሜራና አሞን ኦዶትሳራን ሌን ማንኮሙታናዋተራን ማራን፤ <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />ካኮሰሴታራን ራድ ብያጉደን ካሄልቴን እባዶ ዱባ ካጅላ ኣሞ ቶስ ኡማ’ አመ። <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />ኦሀንዳራና ራድ ቤንጉሬን ካሄሌን እባዶ ካኢዳና ካሜላን ዱባ ኩኩይሰንጉረን ካሃስኖ ምን ማርት አማጌን።<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“ዎኖና ታኡማንተቶ ማርት ድን ምን ኦርድ ጎታብሮ እባዶት ኮ ካሃስኖ ሳርስ ሀሳርሳኖን ካግሮ ዴ። <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />ሃና አመ፤ ‘አን ካጌላታሮ!’ ካሃስኖ ሳርስ ሀሳርሳኖን ምሲ ሂታራ ታብን ዳንዴተ? እባዶትና ጎአመን ታአምአባብሮ ዋተ።<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />“ዎኖና ኦሀንዳራነ፤ ‘ገነና ሉቃና ሽያጉደን ሳሬ ካግሮ ጢልንጋክ ሙጉድ ቶስ ቤሳዴን ኡሱ ሻፋ፥ ኤሴና ኦታና ኢልኮ ፎጫኖ ልናራ’ አመ።<note caller="-" style="x"><char style="xo" closed="false">22፡13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8፡12</ref>፤ <ref loc="MAT 25:30">25፡30</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13፡28</ref>።</char></note><verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />ኤሰኮ የሱሳ፥ “ኦኡማሜራና ኦሞጋንያን፥ ኦአሳባሜራን ጎአመን ሁጫርያን” አመ።<verse eid="MAT 22:14" /></para>
  <para style="s1">ጊራ ሙራኖኮክ ጋራ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር. 12፡13-17</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20፡20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />ኤሰኮ ፋራሳዊል ቤን ሴታ ግራን ምስምሲ የሱሳ አዬስከሳይ ጦይ ታአም አብናራን ማካረን። <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />እሶኮ ኦአጋልሳታረና ታሄሮዶሳ ኡናነ ዎታ የሱሳ ቶስ ፋሬንጉሬን፥ “ካአጋልስሳቶ!” “አት ካሩም ላኖና ራ ካዋ ሩሚ ካአጋልስሳቶ ላኖ፥ እባዶ አብሳታ ካኡሉልሶን ዱባና ኢል ቶይ ካድያቶ ላኖ ኖ ካንሶዋ። <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />ካሮም ዎኖላልኮክ ዎኖዉን ጊራ ሙራኖ ዶትሳራ ሙ ላኮዶትሳሮያ አላ ኖን ሰጊ? አመን ሆሳተን።”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />የሱሳና ምጌትሶ አዴሰረ፥ “እስን ኢፍሳዶለ መዉን አዬሲ እን ጫፍን ዶታታን? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />ጊራ ታሙራታን ማራጋደ አላ ኢን ቱሳ?” እሶና ጣጋራ ቶ ከኔን። <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ኡሱና፥ “ህታ ማራጋዴይ ጉት ታሙታታ ምዲ ታዮታ? ጹፍና አደ ታዮታ?” አመ።<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />እሶና አባበን “ካሮም ዎኖያ” አመን። ኡሱና አባበረ “ካሮም ዎኖኮክ ካሮም ዎኖን፥ ካዋና ዋዉን ስሳ” አመ።<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />እሶና ሂካ ማለንጉሬን አዬስኬሳ ሳዳ ኢሰን ሴተን።<verse eid="MAT 22:22" /></para>
  <para style="s1">ጎይኮ ክያኖኮክ ጋራ ታሆሳንተቶ ሆሲን</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር. 12፡18-27</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20፡27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />ኤሰ አሪ ጎይኮ ክያኖ ላግሮ አመ ካአማናራ ካሶዶቃውል እባዶ የሱሳ ቶስ ኤሜተንጉረ ሃ አመ ሆሳተ፤<note caller="-" style="x"><char style="xo" closed="false">22፡23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ኦፋ. ፈ. 23፡8</ref>።</char></note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“ካአጋልስሳቶ!” ሙሴ፤ “እባዶት ኮ ኦርቴሳኮ ይስ ሀኡሙሎን ጎጎየ፥ ካጎየሮ አቢኬሳኮት ኦር አቢኬሳ አታይጉረ ኡሱን ሳኒ ሀካየ አመራ።<note caller="-" style="x"><char style="xo" closed="false">22፡24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">አዳ. 25፡5</ref>።</char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />አቢላል ቶዶባ ኖ ዶሌ ግታ፥ ካሆሬ ኦር አታተጉረ ይስ ሀኡሙሎን ካኮጎዋረ ጎራታ አቢኬሳና ኦር የላተ፤ <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />ሂካማሌ አደ ካሴድኮ ታ ቶዶባ ጌሮ ሂካማሌ ጎዬን። <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />ዱባንኮ ሃሬ ሄለልትቲና ጎተ። <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />ሃንሱን ኤሰ ዱባን ማንኮኬሳንተቶ ማራን ጎይኮ ታክያኖ አሪ እሶ አቢላል ቶዶባ ኦሮኮ ኤኪን ኦር ልናታ?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />የሱሳና እሶን አባበረ፥ “እስን ቁሉክ ማጻፋጆልና ሁና ካዋ ማንኮአዴሳናዋተታን ማራን ሽር አማታን። <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />ኦጎየራን ጎይኮ ኪ ጎአባባቴን ዳሩሪ ካግሮ ኤርግቻል ኣን ልናራን ኳሬ ላኮአታይናራን፤ ላኮናኬሳምናራን። <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />ኦጎየራን ጎይኮ ክያኖኮክ ጋራ ዋ እስኑን ካአዬሰሮ ላኮናባብቴታንያ? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘አን ካአብራመ ሄዶ፥ ካይሳቃ ሄዶ፥ ካያይቆባ ሄዶያ፥’ ሃንሱን ዋ አርዶክ ሄዶያ ኳሬ ላኮካጎይ ሄዶዮ።”<note caller="-" style="x"><char style="xo" closed="false">22፡32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ብያ. 3፡6</ref>።</char></note><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />ጎሳና ሂካ ካኮማላረ ጎራታ አጋልስስኬሳ ሳደን።<verse eid="MAT 22:33" /></para>
  <para style="s1">ዱባንኮ ካሮራሮ አጃጃ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር. 12፡28-34</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10፡25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />የሱሳ ሶዶቃውል አባብ ትር ጫልኢሳኖ ካኮማላረን ጎራታ ፋራሳዊል ራቶ ኩኩአመን። <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />እሶኮ ኮ ሴራ ካሙሴ ካአጋልስሳረ የሱሳ ጫፍን ዶተጉረ ሃ አመ፦<note caller="-" style="x"><char style="xo" closed="false">22፡35 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10፡25-28</ref>።</char></note><verse eid="MAT 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36" />“ካአጋልስሳቶ! ሴራል ካሙሴ ዱባኮ ካሮራራ ኤክ አጃጃያ?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />የሱሳና እሶን አባበረ፥ “ ‘ጎታ ሄዶካ ምግት ዎዳናይ፥ ምግት ኔፎይ፥ ምግት ቆፋይ ጌላ’።<note caller="-" style="x"><char style="xo" closed="false">22፡37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">አዳ. 6፡5</ref>።</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />ሂክ አጃጃ ካሆራርጄና ዱባንኮ ካሮራሮ አጃጃያ። <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />ካላም አጃጃና ሂካ ኣን ላራ፤ ህክና ‘ኦላታ እስኦታ ኣን ጌላ’ ካአማሮያ።<note caller="-" style="x"><char style="xo" closed="false">22፡39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዎዩ. 19፡18</ref>።</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />ሴራ ካሙሴና ካሄገሮልኮክ አጋልስስ ዱባ ሂካ አጃጃ ላማ ጉት ባቴን ግራን አመ።”<verse eid="MAT 22:40" /></para>
  <para style="s1">ክርስቶሳ ሳኒ ታዮያ?</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር. 12፡35-37</ref>፤ <ref loc="LUK 20:41-44">ሉቃ. 20፡41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />ፋራሳዊል ኩኩአመንጉረን የሱሳ ሃ አመ እሶ ሆሳተ፥ <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“ጋራ ካክርስቶሳ መ ኣን ላራ? ሳኒ ታዮያ?” አመ እሶ ሆሳተ።</para>
  <para style="p" vid="MAT 22:42">“እሶና ሳኒ ታዳዉተያ” አመን።<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />የሱሳና፥ “ሀያ ዳዉተ አያና ቁሉክና ሁናይ ሙን ኡሱ፥ ‘ጎታ!’ አማራ? አመ።<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />“ ‘ጎታ ጎታኬዉን!</para>
  <para style="q2" vid="MAT 22:44">ዲናካ ሉክታ ሄገሊ ታዳዳራምሮ፤</para>
  <para style="q2" vid="MAT 22:44">“መርገቴይ ሀማጺ አመራ።” ’<note caller="-" style="x"><char style="xo" closed="false">22፡44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዛ. 110፡1</ref>።</char></note><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />ሃኑን ዳዉተ፥ ‘ጎታ!’ አም ጎኡምሮ ሀያ ክርስቶሳ ምሲ ሳኒቴሳ ሊን ዳንዳራ?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />ሃፉራ ኮና አባብን ካዳንዴራ ጎርቱን ኤሰ አርኮ ሀጋአበረ ሆሳይን ካጃባተ ማዮና ላግሮ።<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">የሱሳ ፋራሳዊልና ሴራ ካሙሴ ኦአጋልስሳራን ቱፋታኖ</para>
  <para style="r">(<ref loc="MRK 12:38-39">ማር. 12፡38-39</ref>፤ <ref loc="LUK 11:43-46">ሉቃ. 11፡43-46</ref>፤ <ref loc="LUK 20:45-46">20፡45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />ኤሰኮ የሱሳ ጎሳነና ኡሱኮ ኦአጋልሳታረነ ሃ አመ አዬሰ፥ <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“ሴራ ካሙሴ ኦአጋልስሳራና ፋራሳዊል ሙሴ ኣን ሴራ ጎጎአጋልስስራዉን ኦዶናት እሶን ስሳመራ። <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />ሃኑን እሶ እስኑን ካሰጋራን ዱባ ፈላ፥ ኦራዬን፥ አየሱን ጎአመን ጎጎአዬሳራንክ ማለ ላኮፈላራን፥ እሶ ኦፈላራን ፈሎ አሮፈልቴን። <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />አደና ስዳሚን ታዳንዳሞን ስዳነ ታአቲ ሽዬንጉረን ሃን ካእባዶ ጉት ካራን፤ እሶ ጎአመን ፈሪና ዱዶ ድኒን ላኮዶታራን።<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />“እባዶን ሙትን አመንጉረን ፈሎኦትሶ እባዶ ሆረ ቱሳይን አመረነ፥ ሻሺ ኣን በቤድትሶይ ሻታራን፥ ማልድያ ኣን ገነትሶይ ሻታራን፥<note caller="+" style="f"><char style="fr" closed="false">23፡5 </char><char style="fqa" closed="false">አሸንክታ አማኖ፦ </char><char style="ft" closed="false">ካላቻ ኣን በቤዲና ህስሊ ካሻማሮያ። </char></note> ጋሸኮት ሻርፍና ኤራሳታራን፤<note caller="-" style="x"><char style="xo" closed="false">23፡5 </char><char style="xt" closed="false"><ref loc="NUM 15:38">ቶቶ 15፡38</ref>፤ <ref loc="DEU 6:8">አዳ. 6፡8</ref>።</char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />ታአሞ ባንኤ፥ ታካባጃንተ ባንኤ፥ አይሁድኮክ ምን ካኤብ ካሆራርጄ ባርጩማ ሀማጺን ጌላታራን። <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />ኡሱማለና ግያ ኦሮ ኖጎዳ አታኖና ህኢ ታእባዶኮ ‘ካአጋልስሳቶ!’ አማም ኡማምን ዶታታራን።<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />“እስን ጎአመን ‘ካአጋልስሳቶ!’ አማም ላኮኡማምናታን፥ እስን ካአጋልስሳራ ኮ ካላልያ፥ እስን ዱባና አቢላልታን። <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />ዳሩሪ ካግሮ ኣቦ ኮ ማንኮአብታን ማራን ኡሊ ማዮና ‘ኣቦ’ አም አሮኡንቴን። <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />እስኑን ባሊክስን ክርስቶሳ ማንኮሌሮ ማራን ‘ባሊ’ አማም አሮኡማንቴን። <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />እስን ኦሮኮ ዱባንኮ ካንጅንክ ካሌራ እስኑን ካሀንዳሮ ልናራ።<note caller="-" style="x"><char style="xo" closed="false">23፡11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">ማቶ. 20፡26-27</ref>፤ <ref loc="MRK 9:35">ማር. 9፡35</ref>፤ <ref loc="MRK 10:43-44">10፡43-44</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፡26</ref>።</char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />እስኦቴሳ ጦቂ ጦቂሳታራ የራታራ እስኦቴሳ ካየራሳታራ አደ ካባጃማራ።<note caller="-" style="x"><char style="xo" closed="false">23፡12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">ሉቃ. 14፡11</ref>፤ <ref loc="LUK 18:14">18፡14</ref>።</char></note><verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“እስን ኢፍሳዶለ ሴራ ኦአጋልስሳታና ፋራሳዊል ዎኖናት ካዳሩረ ቶስ እባዶ ጎጎታቦንኮ ኡፋ ማንኮጩፋታን ማራን ኣኔ እስኑን! እስን መተክስኑን ላኮታብታን፤ ታብን ካዶታታሮና ላኮታብሳታን። [<verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />እስን ኢፍሳዶለ ሴራ ኦአጋልስሳታና ፋራሳዊል ኣኔ እስኑን! ምን ካጋልታንተል ሀዉአይ የላ፥ እባዶን ሙትን ኤብ ኤራሰን ማንኮኤባታን ማራን ካሜላን ፍርዳ እስን አታይናታን።]<note caller="+" style="f"><char style="fr" closed="false">23፡14 </char><char style="ft" closed="false">ቶቶ ታጋልባ ጹፍል ቶቶ 14 አዳራን፤ ኡሱ ሃፉራና ማር። 12፡40 ካግሮ ኣን ላራ። </char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“እስን ኢፍሳዶለ ሴራ ካሙሴ ኦአጋልስሳታና ፋራሳዊል፥ እስን እባዶት ኮ እስንኮ ካአጋልሳታሮ የልን በከይና ኡል ጉት ማንኮማራሙራታን ማራን እሶ ካኮታብሰን ጎራታ እስንኮ አምባ ካሮረ ታጋነም ኤለኒ ጎጎኢሮን ማንኮየላታን ማራን ኣኔ እስኑን!።<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“እስን ጃማስ ጃማስ ሆረ ሀይቴን ኦገጌሳታን፤ ኣኔ እስኑን! ‘ማዮና ቁሉክ ምን ካዋይ ጎአማተ ኮና ላኮዮ፤ አየሱን ጎአመን ቁሉክ ምን ካዋ ኦሮ ካግሮ ዎርቂ ጉት ጎአማተ አደ አማቶ ግያራን’ አማታን። <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />እስን ጃማሲልና ጎዎሌ ዎርቂኮና ዎርቂ ካቁሎይሳሮ ቁሉክ ምንኮና ኤክያ ካሮራራ? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />ኡሱማለና ታፋላ ባንኤ ካአማታሮ እባዶን ኮና ላኮግሮ፥ አየሱን ጎአመን ታፋላ ባንኤ ካግሮ ጃርሶይ ጉት ጎአማትራን አማቶ ሀኑኡ ግያራን አማታን። <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />እስን ጃማሌሳ ፋላኮና ታቁሎይሳቶ ታፋላ ባንኤኮ ኤክያ ካሮራራ? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />ሃኑን ታፋላ ባንኤይ ካአማተራ ካኮፋላታራን ጉት ካግሮ ዱባይ አማታራ።<note caller="+" style="f"><char style="fr" closed="false">23፡20 </char><char style="fqa" closed="false">ሜባ </char><char style="ft" closed="false">እባዶ ሄዶኬሳዉን ካስሳራ ካአመን ዱባ ሜባ አማማራ። </char></note> <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />ኡሱማለና ቁሉክ ምን ካዋይ ካአማተ ቁሉክ ምን ካዋይ ኦሮ ካግሮና አማታራ። <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />ዳሩሪ ካአማተ ኮርፍንጀ ካዋይ ጉት ካሀማጼሮይና አማታራ።<note caller="-" style="x"><char style="xo" closed="false">23፡22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66፡1</ref>፤ <ref loc="MAT 5:34">ማቶ. 5፡34</ref>።</char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“እስን ኢፍሳዶለ ሴራ ካሙሴ ኦአጋልስሳታና ፋራሳዊል ኣኔ እስኑን! አኑጋኮ፥ ዴቦኮና ኦካሸኮ ካሆራርጄ ሆራ ዋዉን ስሳታን፥ ሴራ ኦሮ ካግሮ መተክ አየስ ካሌሮ፤ ፍርዳ ካሩም፥ ሻጋና፥ አብዳማኖ አደን ቱፋተታን። ኣኒዕ ሀኢሶን ህናኣና ፈልቴንዋ ካእዳንየ።<note caller="-" style="x"><char style="xo" closed="false">23፡23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ዎዩ. 27፡30</ref>።</char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />እስን ጃማሌሳ ጃማሌሳ ሆረ ሀይቴን ኦገጌሳታን! ቢንኢ ኣን ካላሮ አየስ አሳብቴን ሻፋታን፤ ጋላ ኣን ካለያሮ አየስ አዴን ኤኔጋታን።<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“እስን ኢፍሳዶለ ሴራ ኦአጋልስሳታና ፋራሳዊል፤ ኣኔ እስኑን! ካፋላ ያላኣና ካጡጋ ሁ ምና ታሳሬ ታላል ሻሻካራታን፤ ኦሮኦትሶ ጎአመን ሳማኖይና እስአዎዳይዋቲ አማጋመራ። <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />አት ጃማክ ፋራሳውት ጣይ ሁ ካፋላ ያላኣና ካጡጋ ሁ ኦሮ ሙጭስ፤ ኤሰኮ ጉትክሶና ካሙጭመ ሌራ።<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“እስን ኢፍሳዶለ ሴራ ኦአጋልስሳታና ፋራሳዊል ጉትክሶ ባርሳ ጣላላመ ካኢዳሮ፥ ኦሮኦትሶ ጎአመን ካጎየ እባዶኮክ ለፋልና ባቲክ አየስ ዱባ ካአማጋመ ሂዬል ኣን ማንኮላታን ማራን ኣኔ እስኑን።<note caller="-" style="x"><char style="xo" closed="false">23፡27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">ኦፋ. ፈ. 23፡3</ref>።</char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />እስና ሳሬ እባዶን ቁሉክ ኣን ላታን፥ ኦሮኦትስን ጎአመን ኢፍሳዳይና ሜላነይ ኦአማጋሜንያን።<verse eid="MAT 23:28" /></para>
  <para style="s1">ሴራ ካሙሴ ኦአጋልስሳራና ካፋራሳውል ሙርሳማኖ</para>
  <para style="r">(<ref loc="LUK 11:47-51">ሉቃ. 11፡47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“እስን ኢፍሳዶለ፥ ሴራ ካሙሴ ኦአጋልስሳታና ፋራሳዊል ኣኔ እስኑን! ካሄገሮል ኮክ ቃማል ግምባ ካቁሎሌ ቃማል ኢሳድሳ፥ <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />‘ካጣዎ ኦዶላልካንክ ጌሲ ካግነ ሌነዋ፥ ካሄገሮል ኮክ ኢግ ኡባኖይ እሶነ ዎታ ላኮላኔ’ አማታን። <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />ሂካኒና ካሄገሮል ላጋዴን ኦግረን ኦዶላልካንዉን ሳኒ ላኖክስን እስ ኦትስን ጉት አቶትናታን። <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />ጎርታኑን ኦዶላልክስን ፈልን ኦሀጋአቤረን ፈሎ ጉድሳ።<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />“እስን ሀበሳል! ይስ ካጃራ ታባኖን ታጋነም ኤሌንኮት ሙርትኮ ምሲ ሄሲን ዳንዴታን?<note caller="-" style="x"><char style="xo" closed="false">23፡33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3፡7</ref>፤ <ref loc="MAT 12:34">12፡34</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3፡7</ref>።</char></note> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />ሃኑን ካሄገሮ፥ ቃሮሌልና ሴራ ኦአጋልስሳራን ፋርናራ፥ ህናኣኮ ኮኮ ላጋድናታን፥ ኮኮና ሱይናታን፥ ካካለና አይሁድኮክ ምን ካኤብ ኦሮ ቦጭናታን። ካታማ ቶኮ ካታማ ታካለ ቶስ እስን እሶ ሆሮርናታን። <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />ሃኑን ቁሉክ ካኣቤላ ኢግኮ ሀጋአበረ ቁሉክ ምኒና ፋላ ማንኮፈላታራን ጠኤ ካላጋዴታን ኤረ ካበራክዩኮ ታ ካዛክራሳ ኢግ ጌሮ ኡሊ ጉት ካኡባተሮ ቁሉክ ኢግ ዱባን እስን ኦሆሳማታንታን።<note caller="-" style="x"><char style="xo" closed="false">23፡35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መጣ 4፡8</ref>፤ <ref loc="2CH 24:20-21">2 ኦዱ 24፡20-21</ref>።</char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />አን ሩምና አማራ ካሮረሮ አየስ ዱባን ህት አላታን ሆሳማታ።<verse eid="MAT 23:36" /></para>
  <para style="s1">የሱሳ ኢየሩሳለም ማራን ኦታኖ</para>
  <para style="r">(<ref loc="LUK 13:34-35">ሉቃ. 13፡34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“አት ኢየሩሳለም፥ ካሄገሮ ታላጋዳታ፥ ኩ ቶስ ኦፋራመራና ኤኤሞይ ታኤጋታ አት ኢየሩሳለም ሉካለ ጩጩተክሴ ባልክሰ ሄገሊ ጎጎኩኩይሳቶይ፥ እባዶካ ኩኩይስን ምያ ጋለ አን ዶተ፥ እስን ጎአመን እ ላኮአንተታን። <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />ጎርታ ቁሉክ ምን ካኤብካክስን ኦና ሊ ሄስናራ።<note caller="-" style="x"><char style="xo" closed="false">23፡38 </char><char style="xt" closed="false"><ref loc="JER 22:5">ኤር. 22፡5</ref>።</char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />ሃንሱን፥ ‘ካጎታ መገ ካኤመታራ ካሶማሳመያ’ ታ አንታኒ ጊን ሂካ ጎራታኮ ሀጋአብረ እስን ካላም እን ላኮዴታን።”<note caller="-" style="x"><char style="xo" closed="false">23፡39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዛ. 118፡26</ref>።</char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">ካጋቾ አላምኮክ ማላታል</para>
  <para style="r">(<ref loc="MRK 13:1-2">ማር. 13፡1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21፡5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />የሱሳ ቁሉክ ምን ካዋኮ ቤጉረ ሴታ ግራን ኡሱኮ ኦአጋልሳታረን ቁሉክ ምንኮክ ግምበ ቱስን ኡሱ ቶስ ኤመተን። <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />ኡሱ ጎአመን፥ “ሂካ ዱባ ድያታን?” “አን ሩምና አማራ ኤኤሞ ኤኤሞ ጉት ካግንባመራ ጎጎድያታኒ ሀዳርኣሞን ሂካማሌ ጎጎግሮይ ካሄስራ ኤኤሞ ኮና ላግሮ” አመ።<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />የሱሳ ዛይቲ ካበያራ ጋ ታኮአላታሮ ዎዳም ጉት ሀማጼ ግራን፤ ኡሱኮ ኦአጋልሳታረን ካለ ቤን ኡሱ ቶስ ሰተንጉረን “አላ ኖን ሰጊላ” “ሂክ አት ካአማታ ዱባ ጎረ ልናራ? ኤሜቶታና አላምኮት ጋቾን ማላታ መያ?” አመን። <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />የሱሳና አባበረ ሃ አመ፤ “ማዮና እስን ጎጎሶቦንኮ እስኦራዬን።” <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />ካሞጋና አን ክርስቶሳያ አማ መገኬይ ኤመይናራ ካሞጋና ሽርስናራን። <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />ጀሬና ጋራ ካጀረነ ታአዬሳማቶ ኦዱ እስን ማልናታን፤ ሂክ አየስ ላኖ ካሄሶንያ፥ ሀሌዎ ኳሬ ጋቾ ጋና ማንኮሌተ ማራን ሂካኒ እስን ጎጎነይኖኮ እስኦራዬን። <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />ጎሳ ጎሳይ ጉት፥ ዎኖና ዎኖ ጉት ኪናራ፥ ባንኤ ባንኤይ ኡኢና ኡልኮክ አኣኖ ልናራ። <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />ሂክ ዱባ ጎአመን ቃኒን ካኡሙላኮት ራኮኮ ታሆራርጄታ።<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“ሀሱ ጎራታ እባዶ እስን ራኮዉን ሮርስ ስስናራ፥ ላጋድናራን፤ መገኬኮት ኣላንቲ ጎሳ ዱባ ዶሌ ኦዲዳንቴን ልናታን።<note caller="-" style="x"><char style="xo" closed="false">24፡9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10፡22</ref>።</char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />ሀሱ ጎራታ ካሞጋን አማኖክሶ እስናራ፥ ኮ ካካለ ሮርስ ስስናራ፤ እስ እስኦሮና ኮኮ ዲድናራን። <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />ካሞጋን ካጣራ ካሄገሮል ኪናራ፥ ካሞጋና ሶሶይስናራን። <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />ታሞጋን ሜላነኮ ካከይ ካሞጋን እባዶኮት ጌላንጀ አምባል ልናታ። <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />ታጋቾ አሪ ታ ጌሮን ካአታተ ሀሱ ፋይናራ። <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />ጎሳ ዱባን አቶ ጎጎሌሮን ሂክ ዎኖናት ካዋኮክ ዎንጋላ አላም ዱባይ ላላባምናራ፥ ኤሰኮና ታጋቾ አሪ ኤመይናታ።<verse eid="MAT 24:14" /></para>
  <para style="s1">ባይ ካኬናሮ ባቲክ ኮኮ</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር. 13፡14-23</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21፡20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“ጎርታኑን ካሄገሮ ዳነላን ጎጎሰጋመሮክ ማለ፥ ‘ካባቶይስራ ካሜላን አየስ ታቁሎይተቶ ባንኤ ካአሌሮ ካኮዴተን ጎራታ ካናባባራ ሀሻዶ!’<note caller="-" style="x"><char style="xo" closed="false">24፡15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳኔ. 9፡27</ref>፤ <ref loc="DAN 11:31">11፡31</ref>፤ <ref loc="DAN 12:11">12፡11</ref>።</char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ሀሱ ጎራታ ኡል ካይሁዳይ ካግራና ዎዳም ቶስ ሀባቃቶ፥ <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />ምኒ ፎቂ ጉት ካግራ ማምስክ እባዶና ሁ ምንኮ አታይን አሮዳጎ፥<note caller="-" style="x"><char style="xo" closed="false">24፡17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17፡31</ref>።</char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />እራ ካግራ እባዶትና ሳርስኬሳ አታይን አሮአባባኖ። <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />ኤሰ አሪ ሄለል ካፋቶዉና ካኢልሳሮን ራኮ ታአቲ ለታ። <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />ጎርታኑ ባቃታኖክስን ባጠሳይ ጎርቱን አይሁድን ታፎልሲ አሪ ጎጎሌኖንኮ ኤባየን። <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />ሀሱ ጎራታ አላም ታኮመጣመሮ አርኮ ሀጋአበረ ታ ህታር ጌሮ ሊ ካካሶን ኤሰኮና ሆረንባን ኤሰ ራኮነ ዎታ ካኮኤካሮ ካላይት ራኮ ታአቲ ልናታ። <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />ሀሱ አሪል ጋባባይ ዋተና እባዶ ዱባ ላኮሄሳረ። ካአሳባመሮ ማራን ጎአመን ሀኑኡ አርጃ ጋባባቴን። <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />ሀሱ ጎራታ ማዮና ሂክማ ክርስቶሳ ህታኒ ግራ ጎርቱን ሀሴ ግራ ጎአመና አሮአብዳቴን። <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />ካጣራ ክርስቶሳልና ካጣራ ሄገሮል ኪናራን፥ እሶን ጎኤካተ ካአሳባመሮና ሽርሲን አምሬነ ካአቲ ባሳክ ማላታልና ቱስናራን።<note caller="-" style="x"><char style="xo" closed="false">24፡24 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳኔ. 12፡1</ref>፤ <ref loc="REV 7:14">ራጋ 7፡14</ref>።</char></note> <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />ጎርታ አን እስኑን ጣየ ሰጋራ፦<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“ሃንሱን ‘ኣንክማ ጋ ኦሮ ግራ፥’ ጎአመና ኤሰራ አሮቤተን፥ ሂክማ ምን ኦሮ ግርዲ ግራ ጎአመን አሮአብዳቴን።<note caller="-" style="x"><char style="xo" closed="false">24፡26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">ሉቃ. 17፡23-24</ref>።</char></note> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />ሀንቃ ምና ታብያንኮ ቤጉረ ምና ታኢያን ቶስ ታጌሮ ጎጎሀንቃሮ ኤረ ካእባዶኮት ኤመቶ ሂካማሌ ልናታ። <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />ራቃ ታኮግሮ ባንኤ ዱባ አላትል ኩኩአማራ።<note caller="-" style="x"><char style="xo" closed="false">24፡28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">ሉቃ. 17፡37</ref>።</char></note><verse eid="MAT 24:28" /></para>
  <para style="s1">ኤረ ካእባዶኮት ታላም ኤመቶ</para>
  <para style="r">(<ref loc="MRK 13:24-27">ማር. 13፡24-27</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21፡25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“ሀኑኡ ታራኮ አርጃኮ አባባይረ ጎርሰዋ</para>
  <para style="q1" vid="MAT 24:29">“ ‘አርት ሙጉድ ልናታ፥</para>
  <para style="q2" vid="MAT 24:29">ድግንና ኢፋክሴ ትራይናታ፥</para>
  <para style="q1" vid="MAT 24:29">ባራጃና ዳሩርኮ ኡባይናራ፥</para>
  <para style="q2" vid="MAT 24:29">ካዳሩረ ሁናና ሻላጋምናራ።’<note caller="-" style="x"><char style="xo" closed="false">24፡29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፡10</ref>፤ <ref loc="ISA 34:4">34፡4</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፡7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፡10</ref>፥<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፡15</ref>፤ <ref loc="REV 6:12-13">ራጋ 6፡12-13</ref>፤ <ref loc="DAN 7:13">ዳኔ. 7፡13</ref>፤ <ref loc="ZEC 12:10-14">ዛኪ. 12፡10-14</ref>፤ <ref loc="REV 1:7">ራጋ 1፡7</ref>።</char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />“ሀሱ ጎራታ ኤረ ካእባዶ ማላታ ዳሩሪ ጉት ሙትናራ፥ ሀሱ ጎራታ ኡሊ ታግታ ኣኒ ዱባና ዎ ዎ አም ኦይናራ። ኤረ ካእባዶና ካዳሩረ ዱማንቻይ ኦሮ ሁናይና ታአቲ ካባጃይ ኤመታ ግራን ድናራን። <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />ኤርግቻልና ታአቲ ታማላካታ ያየነ ዎታ ፋራምናራ፥ እሶና ኦአሳባመራን አላም ምና አፋርኮ ዳሩርኮት ጋቾኮ ታ ዳሩርኮት ጋቾ ጌሮ እባዶ ኩኩይስናራን።<verse eid="MAT 24:31" /></para>
  <para style="s1">ካባላስ ጋኮክ ማሱሳ</para>
  <para style="r">(<ref loc="MRK 13:28-31">ማር. 13፡28-31</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21፡29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“ካባላስ ጋኮ ሂካ አጋልስስ አጋልሳዬን፥ ባላል ጎሁርስሮ ባላሎ ጎጫሪድራን ሀሱ ጎራታ ባጤሳ ጋባላማኖ አዴሳታን።<note caller="+" style="f"><char style="fr" closed="false">24፡32 </char><char style="fqa" closed="false">ጊላል </char><char style="ft" closed="false">ሂክ ሰጋኖ ካቱሳራ ኡልክሶይ ጋ ካኮሁርሳራና ባላሎ ካኮጫሪዳራን ጊላል ጎጋባላምሮ ማንኮሌ ማራንያ። </char></note> <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />ሂካማሌና ሂካ ዱባ ጎዴተን ኤሰ አሪ ጎጫቲ ጋባላማኖ አዴሳ። <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />አን ሩምና አማራ ሂክ ዱባ ታጉዳሮ ህት አላታን ላኮሮርቶ። <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />ኡልና ዳሩርና ሮራንዋ ሃፉራክ ጎአመን ሱረ ላኮሮሮ።<verse eid="MAT 24:35" /></para>
  <para style="s1">ጎታ ታኮኤሜይናራ አሪ አዴሳማና ዋት</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር. 13፡32-37</ref>፤ <ref loc="LUK 17:26-30">ሉቃ. 17፡26-30</ref>፥<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“ሀሴ አርና ሀሴ ሳቲ ጎአመን ኦዶ ኳሬ ካዳሩረ ኤርግቻል ጎሌና፥ ኤረ ጎሌና ኮና ላካሶ። <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />ካኖሄ ጌሲ ጎጎሌሮይ ኤረ ካእባዶኮት ኤመቶ ኡሱማሌ ልናታ።<note caller="-" style="x"><char style="xo" closed="false">24፡37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">መጣ 6፡5-8</ref>።</char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />ኡሱ ጌሲ በከ ሚራኣ ጌግሳናኮ ሆረነ ኖሄ ማርካፋ ቶስ ታኮታብናሮ አሪ ታ ጌሮን እባዶ አማና ጣማና፥ ኦር አታታና ኬሳታ ጎጎግሬንክ ማለ፥ <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />ሀሴ አሪ ታጌቶ መ ኤሜይናሮ ሀአዴሶን ሚራኣ ታበከይ ጎጎኤነጋመራን ኤረ ካእባዶኮት ኤመቶ ኡሱማሌ ልናታ። <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />ኡሱ ጎራታ እባዶጃ ላማ እራ ሀይናራን፥ ኮ አታምናራ ኮ ሄስናራ፥ <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />ሄለል ላማ ሪም ኮይ ሪታይናራን ቶ አታምናታ፥ ታካለ ሄሲናታ።<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />“ጎርታኑ ጎታክስን ታኮኤሜይናሮ አሪ እስን ማንኮካሶን ማራን ናባዳ ኦራዬን፥ <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />ሂካ ዎዳና አባዬን፥ ኦዶ ምኔ ሄቶ ሄመን ማጎራታ ኤሜይናቶ አዴስ ግረዋ ናባድ ምን ጎጎሳማሞንኮ ኦራታረዋ። <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />ኤረ ካእባዶና እስን ካኮሻዶን ጎራታ ማንኮኤሜይናሮ ማራን፥ እስና እስኤካሳዬን ኦራ።<note caller="-" style="x"><char style="xo" closed="false">24፡44 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">ሉቃ. 12፡39-40</ref>።</char></note><verse eid="MAT 24:44" /></para>
  <para style="s1">ካአብዳመና ካአብዳሞን ካሀንዳሮኮክ ማሱሳ</para>
  <para style="r">(<ref loc="LUK 12:41-48">ሉቃ. 12፡41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“ባቦክሶ እሶን ካኮዶትሳሮ ጎራታ ጎጎስስሮ ጎታ ምንኬሳክ እባዶ ጉት ካሹማተራ ካአብዳመና ቃሮክ ካሃንዳራ አዮያ? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />ጎታኬሳ አባባይ ካኮኤሜሮ ጎራታ ታስሳንተቶ ሀዳራ ፈለ ጉድሰ ግራን ካሄልናራ ሀሱ ካሃንዳራ ካሶማሳመያ። <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />አን ሩምና አማራ ኦግራን ኡራዎ ዱባይ ጉት ኡሱ ሾሚናራ። <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />አየሱን ጎአመን ካሃንዳራ ሀሱ እባዶት ካሜላን ጎሌና ኡሱ መተኬሳን፥ ‘ጎታ አዳላይናራ’ አማ፥ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />ኪጉረ ካካለ ካሀንዳሮ ጃሌተሳ ቦጫኖ ጎሀጋአበ ጣሜን ኦሰታራነ ዎታ ጎኣመና ጎጣመ፥ <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />ሀሱ ካሀንዳሮኮክ ጎታ ኡሱ ታኦራኖን አሪና ታኮሻዶን ሳቲ ኤሜይጉረ፥ <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />ሀሱ ካሀንዳሮክ ጎታኬሳ ሙርስናራ፥ ኢጣተሳና ኢፍሳዶሌነ ዎታ የልናራ፥ ኤሰ ባንኤ ኦታና ኢልኮ ፎጫኖ ልናራ።<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">ዴለልጃ ቶሞንኮክ ማሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“ሀሱ ጎራታ ዎኖናት ካዳሩረ ዳብ አባተንጉረን ማሻሸ ቆጳይን ኦቤራን ዴለልጃ ቶሞን ኣን ላራ።<note caller="-" style="x"><char style="xo" closed="false">25፡1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">ሉቃ. 12፡35</ref>።</char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />እሶ ኦሮኮ ዴለልጃ ከኖ ጎዋ፥ ዴለልጃ ከኖ አደን ቃሮሌየን። <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />ጎዎሌ ዳብ አባተንጉረን ላንባ ምንጃ ላኮአባቴረን፥ <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />ቃሮሌ ጎአመን ዳብክሶነ ዎታ ላንባ ምንጃ ጣርሙስይ አባተን ግረን። <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />ካማሻሸ ካኮአዳላተረ ጎራታ ዱባና ሁዱሮ ካኮዱትሳተ ጎራታ ሁዱረን።<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“ኡል ሄመን ጠኤ ካኮላረ ጎራታ ‘ካማሻሸ ኤመታራ ብያ ቆጳዬን ታአማታ ኡምት ማልሳንተ።’<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />“ሀሱ ጎራታ ዴለልጃ ዱባ ኬንጉረን ዳብክሶ ሀንቃይሳተን ኤካሳቴን። <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />ጎዎሌ ቃሮሌነ ‘ዳብካን ባይናራ ላንባትስንኮ ኖን ስሳ፥’ አመን።<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />“ቃሮሌኒዕ ዴለልጃ ጎአመን አባበንጉረን ኖ ታአብና ላንባ ‘ኖዬና እስኑና ላናዋይን ዳንዳታ፥ ሰዬንዴነ ላንባ ካዳዳላታሮኮ ኡሱን ኢምናዬን’ አመን።<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />“ላንባ ኢምናይን ካኮብያረን ጎራታ ካማሻሸ ኤመተ፥ ኤካሳቴን ኦግረን ዴሌልጃና ካሃስኖ ኣሞ ታኮኤካተሮ ባንኤ ኡሱነ ዎታ ታቤን፥ ኡፋና ጩፋመ።<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“አዳላተን ኦኤሜተራን ኦካለ ዴለልጃ፥ ‘ጎታ! ጎታ!’ ማጋኔ ‘ኖን ኡፋ ባንና’ አመን።<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />“ኡሱ ጎአመን፥ ‘አን ሩምና አማራ አን እስን ላካሶ’ አመ እሶን አባበ።<note caller="-" style="x"><char style="xo" closed="false">25፡12 </char><char style="xt" closed="false"><ref loc="LUK 13:25">ሉቃ. 13፡25</ref>።</char></note><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />“ጎርታኑ እስን አሪ ጎርቱን ሳቲ ማንኮካሶን ማራን እስኤካሳዬን ኦራ።<verse eid="MAT 25:13" /></para>
  <para style="s1">ኦሀንዳራን ሴድኮክ ማሱሳ</para>
  <para style="r">(<ref loc="LUK 19:11-27">ሉቃ. 19፡11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“ዎኖናት ካዳሩረ እባዶት ኮ ኡሱን ኦሀንዳረን እስ ቶስ ኡመጉረ ኦአቦ ኡራዎኦቴሳ ሀዳራ ስሰጉረ ኡል ካካለ ሴይን ካኬሮ እባዶት ኣን ላራ።<note caller="-" style="x"><char style="xo" closed="false">25፡14 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">ሉቃ. 19፡11-27</ref>።</char></note> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />ኦዶ ኦዶ ፈሎኦትሶክ ማለ ኮዉን ጣጋራ ከን፥ ኮዉን ላማ፥ ኮዉን አደ ጣጋራ ቶ ስሰጉረ ጎርሰዋ ኡል ካካለ ኢሰ ሴተ። <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />ጣጋራ ከን ካአታተራ እባዶት ጎርሰዋ ዳዳላታኖ ሀጋአበረ ታካለ ጣጋራ ከን ዎረኤ ሄላተ። <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />ኡሱማለና ጣጋራ ላማ ካአታተረና ጣጋራ ላማ ዎረኤ ሄላተ። <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />ጣጋራ ቶ ካአታተራ ጎአመን ኡል ኦሸጉረ ማራጋደ ካጎታ ቃማለ።<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“ኦሀንዳራንኮክ ጎታ ማንኮሴተሮ ታንጂን አዳላተ ኤመተረ ታስሰሮ ጣጋራ ቶታይ ድን ሀጋአበ። <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />ጣጋራ ከን ካአታተረ ታካለ ጣጋራ ከን ዎረኤ ሄላተ ኣተ ኤመተጉረ፥ ‘ጎታ!’ አት ኢን ጣጋራ ከን ስሰተ፥ ሂክማ ታካለ ጣጋራ ከን ዎረኤ ሄለራ አመ።<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />“ጎታኬሳና ‘ጎኢዳን ፈልተታ፥ አት ካእዳንክ ካአብዳንተ፥ ክጫርክ አዬሲ ካአብዳንተ ማንኮሌተ ማራን ካሞጋን አዬሲ አን ኩ ሹምናራ፥ ጎታካኒዕ ገጌሎ ቶስ ታብ’ አመ።<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />“ኡሱማለና ጣጋራ ላማ ካአታተራ ካሃንዳራ ኤመተጉረ ‘ጎታ!’ አት ኢን ጣጋራ ላማ ስሰተ፥ ሂክማ ጣጋራ ላማ ዳዳለጉረ ታካለ ጣጋራ ላማ ዎረኤ ሄለራ አመ።<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />“ጎታኬሳና ‘ጎኢዳን ፈልተታ፥ አት ካእዳንክና ካአብዳንተ ካሀንዳታ ክጫርኪን ካአብዳንተ ማንኮሌተ ማራን ካሞጋን አየስ ጉት አን ኩ ሹምናራ፥ ጎታካኒዕ ገጌሎ ቶስ ታብ’ አመ።<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“ጣጋራ ቶ ካአታተረ ካሀንዳሮክና ኤመተጉረ ‘ጎታ!’ አት ካዉጣኖን ግቶ ካማጣራቶ፥ ካዳርኖን ግቶ ካኩኩይሳቶ ቦግካአቲ እባዶት ላኖ ካሶዋ፥ <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />ሃኑን አብሳየረ፥ ‘ጣጋራታ ኤሬ ቃማለራ፥ ሂክማ ማራጋደካ’ አመ።<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“ጎታኬሳና አባበረ፥ ‘አት ካሜላንክና ቦዛክ ካሀንዳታ፥ ካዉጣኖን ግሮ ካማጣራታሮና፥ ካዳርኖን ግሮ ካኩኩይሳታሮ ላኖኬ ካሶ? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />ሀያ አን ካኮአባባታሮ ጎራታ ጣጋራቴ ዎረኤነ ዎታ ጎጎአታሮ ኦዳዳላታራዉን ስሳኖ ዶትሳረ።<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />“ ‘ጎርታኑ ጣጋራ አታጉደን ጣጋራ ቶሞን ካአቦን ስሳ፥ <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />ካአቦን አዳማራ፥ ሞጋታራ፥ ካላይክኮ ጎአመን ሀሱ ካግራዋ አታማራ።<note caller="-" style="x"><char style="xo" closed="false">25፡29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13፡12</ref>፤ <ref loc="MRK 4:25">ማር. 4፡25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፡18</ref>።</char></note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />ሂካ ላኦ ካላይክ ካሀንዳሮ ኦታና ኢልኮ ፎጫኖ ማንኮግሮ ሳሬ ካግሮ ጢልንጋክ ሙጉድ ቶስ ቤሳ ሻፋ’ አመ።<note caller="-" style="x"><char style="xo" closed="false">25፡30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8፡12</ref>፤ <ref loc="MAT 22:13">22፡13</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13፡28</ref>።</char></note><verse eid="MAT 25:30" /></para>
  <para style="s1">አላምኮክ ካጋቾ ፍርዳ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“ኤረ ካእባዶ ኤርግቻልኬሳ ዱባነ ዎታ ካባጃ ጎኤመተ ካካባጃ ኮርፍንጄይ ጉት ሀማጺናራ።<note caller="-" style="x"><char style="xo" closed="false">25፡31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">ማቶ. 16፡27</ref>፤ <ref loc="MAT 19:28">19፡28</ref>።</char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />ጎሳ ዱባ ኡሱ ሆረ ኩኩምናራ፥ ኡሱና፥ ካፎፌ እዳድ ኦሬንኮ ጎጎአሳባሮይ፥ ጎሳ ኮ ካካለኮ አሳብናራ። <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />እዳድ ምና ታመርገነ ኦሬን ምና ታበተነ አሊስናራ።<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />“ሀሱ ጎራታ ዎኖ ምና ታመርገነ ኦግራነ ሃ አምናራ፥ ‘እስን ኣቦክ ኦሶማሳተራ ኮዬን አላም ታኮመጣመሮኮ ሀጋአበረ እስኑን ካኤካተሮ ዎኖናት ኤላ። <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />ኣላንቲና አን ኡኤ አምሴታን፥ ሱጉባየ ጣምሰታን፥ አን ማርት ሌ ጎኤሜየ ቆጳቴታን፥ <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />አን ሀዉአይ ጎሌ ሳርስሴታን፥ አን ሀዉኣመ ዴተታን፥ ሻመ ጎሌ እን ቶስ ኤሜቴን ሆሳተታን።’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“ቁሎለና አባበን ሃ አመን፥ ‘ጎታ! አት ኡኢተ ዴነ ጎረ ኖ ኩ ኣምንሰ? ጎርቱን ሱጉባተ ዴነ ጎረ ኖ ኩ ጣምንሰ? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />ማርት ሌተ ዴነ ጎረ ኖ ኩ ቆጳነ? ጎርቱን ሀዉአይ ሌተ ዴነ ጎረ ሳርስንሰ? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />ኡሱማለና ሀዉኣንተ ጎርቱን ሻንተ ጎረ ሴነ ኖ ኩ ሆሳኔ?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />“ዎኖና አባበረ፥ ‘አን ሩምና አማራ ሂናኣ ሁጫር ኦሌራን አቢላልቴኮ ኮዉን ካየልቴታን ኢን ካፈልቴታን አንያ’ አመ አባበ።<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“ኤሰኮና ምና ታበተነ ኦግራነ አደ ሃ አምናራ፥ ‘እስን ኦቃንጋንተታን፥ ዱርሳና ኤርግቻኬሳዉን ታኤካተቶ ጅሩ ጅሮማን ኤለን ቶስ እንኮ ካለ ብያደን ሴዬን። <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />ኣላንቲና አን ኡኤ ላኮኣምሴታን፥ አን ሱጉባየ ላኮጣምሰታን፥ <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />አን ማርት ሌ ጎኤሜየ ላኮቆጳተታን ሀዉአይ ሌ ላኮሳርስሰታን፥ አን ሀዉኣመና ሻመ ጎሌ እን ቶስ ኤሜቴን ላኮሆሳቴታን።’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“እሶና አባበሬን፥ ‘ጎታ! አት ኡኢተ ጎርቱን ሱጉባተ፥ አት ማርት ሌተ ጎርቱን ሀዉአይ ሌተ፥ ሀዉኣንተ ጎርቱን ሻንተ ዴነኔ ጎረ ጋርጋራና ዋኔ?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />“ሀሱ ጎራታ ዎኖ አባበረ፥ ‘አን ሩምና አማራ ሂናኣ ሁጫር ኦሌራንኮ ኮዉን ፈላና ዋቲ እና ላኮፈልተታን’ አምናራ።<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />“ሂናኣ ጅሩ ጅሮማት ሙሮ ቶስ፥ ቁሎለ አደን ጅሩ ጅሮማክ ግር ቶስ ሴይናራን።”<note caller="-" style="x"><char style="xo" closed="false">25፡46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳኔ. 12፡2</ref>።</char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">አይሁድል የሱሳ ላጋዲን ጦዬን</para>
  <para style="r">(<ref loc="MRK 14:1-2">ማር. 14፡1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፡1-2</ref>፤ <ref loc="JHN 11:45-53">ያን. 11፡45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />የሱሳ ሂካ አየስ ዱባ አዬሰ ካኮጉድሳረ ጎራታ፥ ኡሱኮ ኦአጋልሳታረነ፥ <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“አሪ ላማኮ አባባይረ ካፋስካ ባላ ካካባጃምናሮ ላኖ ካሳንዋ፥ ኤረ ካእባዶና ሱዋሚን ሮር ስሳምናራ” አመ።<note caller="-" style="x"><char style="xo" closed="false">26፡2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ብያ. 12፡1-27</ref>።</char></note><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />ኤሰኮ አባባተረ ካቱቃሞል ዎይቻልና ጃርሳ ካኡሌ ቀያፋ ካአማማሮ ቱቃሞሉን ኦዶናት ካአቦኮክ አዉዲ ኦሮ ኩኩአመንጉረን፥ <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />ሚጌይ የሱሳ አቢና ላጋድስስን ማካረን። <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />“አየሱን ጎአመን ጎሳ ኦሮ ሻላጎ ጎጎኬኖንኮ ታባላ አሪ አሮሌኖ” አመን ህኢ ቶ ሌን።<verse eid="MAT 26:5" /></para>
  <para style="s1">የሱሳ ጉት ሽቶ ታክብተቶ ሄለልትቲ</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር. 14፡3-9</ref>፤ <ref loc="JHN 12:1-8">ያን. 12፡1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />የሱሳ ብታንያይ ማሪ ባር ካአቦ ስሞናኮክ ምኒ ግራን፥ <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />ሄለልትቲ ቶ ዶክ ኣሎ አዉኣሎ ታሌተቶ ሽቶ ካአልባስጢሮስ ብልቃደ ኮይ ኣተ የሱሳ ቶስ ጋባላንተ፥ ባቦ አማ ሀማጼ ግራን መተኬሳ ጉት ሽቶ ክክብተ።<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />ኡሱኮ ኦአጋልሳታረን ሂካ ካኮድያረን ጎራታ አማራቴን ሃ አመን፥ “ሂክ ዱባ ዳርአኖ ሙንያ?” <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />“ህት ሽቶ ካሞጋን ማራጋዴይ ዳዳላምጉደ ህየሳን ስሳምን ዶትሳተ” አመን።<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />የሱሳና እሶ ካአመራን አዴሰረ፥ “ህታ ሄለልትቲ ሙን ራክሳታን? ኤሰ ኢን ፈሎ ኦኢዳን ፈልተታ አመ። <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />ህየሳል ማጎሬና እስኔ ዎታ ግራን፥ አን ጎአመን አርጌቶ እስኔ ዎታ ላኮግርናሮ፥ <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />ኤሰ ህታ ሽቶ ማርኬይ ጉት ክክባኖ እን ቃማልኬዉን ኤካሳኖያ። <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />አን ሩምና አማራ ሂክ ዎንጋላ ማንኮላላባማሮ አላም ዱባ፥ ማራሙር ማኤት ባንኤና ኤሰ ኢን ካፈልተታ ኤሰ ሻዳኖ ሊ ሰጋምናራ” አመ።<verse eid="MAT 26:13" /></para>
  <para style="s1">ይሁዳ የሱሳ ሮርስ ስስን ኤካተ</para>
  <para style="r">(<ref loc="MRK 14:10-11">ማር. 14፡10-11</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22፡3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />ሀሱ ጎራታ ቶሞንኮ ላማኮ ኮ ካሌራ ካአስቆሮቱ ይሁዳ ካአማማራ ካቱቃሞል ዎይቻል ቶስ ሴተጉረ፥ <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />“አን የሱሳ እስኑን ሮርስ ጎስሰ እስን አዴን ኢን መ ስስናታን?” አመ፥ እሶና ብር ሶንዶም ኡሱን ቶቴን ስሰን። <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />ሀሱ ጎራታኮ ሀጋአበረ ይሁዳ የሱሳ ሮርስ ካኮስስሮ ካኤካሮ ጎራታ ዶታ ግረ።<verse eid="MAT 26:16" /></para>
  <para style="s1">የሱሳ ካፋስካ ክታ ኦፋራሜራነ ዎታ ኣማኖ</para>
  <para style="r">(<ref loc="MRK 14:12-21">ማር. 14፡12-21</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22፡7-14</ref>፥<ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ያን. 13፡21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />ካባቦ ባላን ታሆራርጄ አሪ የሱሳኮ ኦአጋልሳታረን ኡሱ ቶስ ኤመተንጉረን “አት ካፋስካ ክታ ካሄመነ ጎጎአንቶን ኤቲ ኖ ጎጎኤካንሶን ዶታታ?” አመን።<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />ኡሱና፥ “ካታማ ቶስ ሴየንጉዴን እስኔ ካኤሰለ እባዶት ኮኔ፥ ‘ካአጋልስሳራ ጎራታክ ጋባላመራ እንኮ ኦአጋልሳታራነ ዎታ ካፋስካ ባላ ምንካይ ካባጃይናራ አማራ አማ አመ።’ ” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />የሱሳኮ ኦአጋልሳታራና ኡሱ ጎጎአጃጄሮክ ማለ ካፋስካ ባላኮክ ክታ ኤካሰን።<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />ኡል ሄመን ካኮላረ ጎራታ የሱሳ ቶሞንኮ ላማ ኦፋራሜራነ ዎታ ባቦ ኣምን ሀማጼ። <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />የሱሳ ኣሞ ጉት ግራን፥ “አን ሩምና አማራ እስን ኦሮኮ ኮ እን ሮርስ ስስናራ” አመ።<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />እሶና ኣሎ ያደንጉሬን ቶቶል “ጎታ! አን ሌዉና?” አመን።<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />የሱሳና አባበረ፥ “እን ሮርስ ካስስናራ ኢነ ዎታ ያላኣይ ገነ ካዳግሳተሮያ። <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />ኤረ ካእባዶ ኡሱ ማራን ጎጎጻፋመሮይ ጎይናራ፥ አየሱን ጎአመን ኤረ ካእባዶ ሮርሰ ካስሳሮን ሀሱ እባዶትን ኣኔ! ኡሱ እባዶት ሀኣላኖን ሄስ ግረዋ ካእዳንየ” አመ።<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />ሮርስ ካስስናራ ይሁዳና፥ “ካአጋልስሳቶ! አን ሌዉና?” አመ፥ የሱሳና፥ “አት ካአማታ” አመ።<verse eid="MAT 26:25" /></para>
  <para style="s1">ቁሉክ ባቦ ካዋክ ዎጋ</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር. 14፡22-26</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22፡14-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፡23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />እሶ አማ ግራና የሱሳ ባቦ ኬሰጉረ ሶማሳተ ኢብሰ ኣተጉረ ኡሱኮ ኦአጋልሳታራዉን ስሳ፥ “አህአይ አታዬን አማ፥ ሂኒዕ ሶኦተያን” አመ።<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />ኤሰኮ ጡጋ ኬሰ ዋ ጋላተጉረ፥ ኡሱኮ ኦአጋልሳታሬዉን ስሳ ሃ አመ፥ “እስን ዱባና ህታ ጡጋኮ ጣማ፥ <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />ካሞጋንኮክ ጩቦን ሻጋ ማራን ካኡባይናራ አማቶ ኦኡሱብ ካአዴስሳራ ኢግክ ሂካያ። <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />አን ጎአመን ሃ አማራ ኣቦኬክ ዎኖናቲ እስኔ ዎታ ሂካ ካኡሱብ ካዎይኒ ጣሞ ታኮጣምናሮ አሪ ታ ጌሮ ህታ ጡጋኮ ሆረንባን ካዎይኒ ጣሞ ላኮጣምናሮ።”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />ማዛሙር ዛማሬን አባባቴንጉረን ዛይቲ ካበያራ ጋ ታኮአላታሮ ዎዳም ቶስ ቤን።<verse eid="MAT 26:30" /></para>
  <para style="s1">የሱሳ ጴጢሮሳኮክ ካካታኖ ጣየ አዬሰ</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር. 14፡27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፡31-34</ref>፤ <ref loc="JHN 13:36-38">ያን. 13፡36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />የሱሳ አደ፥ “ህታ ሄመን እስን ዱባ እን ካካይናታን፥ ‘አን ካፎፌ ባስናራ ካፎፋማራ ኢዳንዳ ዳርአምናራ አማመ ቁሉክ ማጻፋ ጻፋመራ።’<verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />“አየሱን ጎአመን አን ጎይኮ ካኮኬ ጎራታ እስንኮ ጣይ ጋሊላ ቶስ ሴይናራ።”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />ጴጢሮሳና አባበረ፥ “ካካለ ዱባ ኣላንቲታይ ኩ እስ ጎሴተና አን ጎአመን ዱዶ ኩ እስ ላኮሴሮ” አመ። <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />የሱሳና ጴጢሮሳነ፥ “አን ሩምና አማራ ህታሜን ሉካለ ሀኦይኖን ግራን አት እን ሴድ ጋል ካካይናታ” አመ። <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />ጴጢሮሳ ጎአመን “አን ኩኔ ዎታ ጎይን ካዶትሳሮ ጎሌና ሱረ አን ኩ ላኮካካይናሮ” አመ። ኩኒዕ ኡሱኮ ኦአጋልሳታረን ዱባና ኡሱማሌዋ አመን።<verse eid="MAT 26:35" /></para>
  <para style="s1">የሱሳ ጌተሰማኒ ኤባታኖ</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር. 14፡32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፡39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />ኤሰኮ አባባተረ የሱሳ ኡሱኮ ኦአጋልሳታረነ ዎታ ጌተሰማኒ ታአማማቶ ባንኤ ቶ ሴተ፥ እሶነ “አን ኣራ ሴይጉረ ታ ኤባሮይ እስን ህታኒ ግራ” አመ። <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />ሴታ ግራን ጴጢሮሳና ይስ ካዛብዶሳ ላማ ዎታ ኣተ ሴተ፥ ጋዳና ጫናቃማኖ ሀጋአበ። <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />ኤሰኮና “አን ታጎሮ ኣሎ ጫናቃመራ፥ ኢነ ዎታ ናባዳ ህታኒ ግራ” አመ።<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />አባራንቲ ሽጲመጉረ ሆረሆረ በቤዲ ኡል ኦየረ “ኣቦኬ! ህት ታራኮ ጡጋ እንኮ ሀቡይቶ፥ አየሱን ጎአመን ፈኢቴ ማለ ሀሌኖን ግራን ፈኢታ ማለ ሀሌዎ” አመ ኤባተ።<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />ኤሰኮ አባባተጉረ ኡሱኮ ኦአጋልሳታራን ቶስ ጎኤሜሮ ኦሁዱሬራን ዴጉረ ጴጢሮሳነ፥ “ዱዶ ኢነ ዎታ ሳቲ ቶና ናባድ ግራና ዋተን?” <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />“ጫፍት ኦሮድ ጎጎታቦንኮ ናባዳ ኤባየን፥ አያና ኤካተ ግራ፥ ሶ ጎአመን ሀራራን” አመ።<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />አደ ካላም ሴተጉረ “ኣቦኬ! ህት ታራኮ ጡጋ አን ሀጣሞን ግራን ታሮሮን ጎሌተ ፈኢታክ ማለ ሀሌቶ” አመ ኤባተ።<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />ካላም አባባይ ካኮኤሜሮ ጎራታ ሁዱሮ ማንኮጌተተ ማራን ሁዱረን ኦግራን ዴ። <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />ግዳና እሶ ኢሰጉረ አደ ካሴድ ሴተጉረ ሆረ ካኤባተረ ኤብ አደ ኤባተ።<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />ኤሰኮና ኡሱኮ ኦአጋልሳታረን ቶስ አባባተ ኤመተረ፥ “ግዳና ሀራፍንቴን ሁዱርቴታን? ህትማ ሳቲ ጋባላንተታ፥ ኤረ ካእባዶ ጩባለይኮት ገነይ ሮር ስሳምናራ። <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />ክያ ሴኖ፥ ሮርስ ካስስናራ ኤመታ ግራ!” አመ።<verse eid="MAT 26:46" /></para>
  <para style="s1">አባማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 14:43-50">ማር. 14፡43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፡47-53</ref>፤ <ref loc="JHN 18:3-12">ያን. 18፡3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />የሱሳ አዬሳ ግራን ቶሞንኮ ላማኮ ኮ ካሌራ ይሁዳ ካቱቃሞል ዎይቻልና ታኡሌ ጃርሶለኮ ኦፋራመራን ሺፋና ዱላ ካአበራ እባዶ ካሞጋና ዎታ ግረ። <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />የሱሳ ሮርሰ ካስሰራ ይሁዳና፥ “አን ካአንጋታራ ኡሱያ አባ” አመ ማላታ ስሰ ማንኮግረ ማራን፥ <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />ጎርሰዋ የሱሳ ቶስ ሴተጉረ፥ “ካአጋልስሳቶ! ኖጎዳ ኢደግቶ” አመ ኡሱ አንጋተ።<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />የሱሳና፥ “አን ካጌላታሮ! ታኮንኤመተቶ ሃጃ ጉሳ” አመ፥ ሀሱ ጎራታ እባዶ ጋባላመጉረ የሱሳ አበ ሽየ።<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />የሱሳነ ዎታ ካግረኮ ኮ ገነ ኬሰጉረ ሺፋይ ቱቃሞልኮክ ዎይቻቲን ካሀንዳረኮት ነበ ጎሰ።<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />የሱሳና፥ “ሺፋካ ኮፎ ኦሮ ታብስ፥” “ሺፋ ካምአታራ ሺፋይ ጎዋራ፥ <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />ጎዶትሰ አን ኣቦኬ ጎኤባየ ኩማ ካሞጋን ካቶታምሮ ኤርግቻል እን ካፋሮን ኣን ላራ? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />ሂክ ሃ ጎሌ አደ ቁሉክ ማጻፋ ልናራ አማመ ካጻፋመራ ምሲ ጉዳታራ?” አመ።<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />ሀሱ ጎራታ የሱሳ ጎሳነ፥ “ሽታ አብን ካኤሜታሮ እባዶ ኣን ሺፋልና ዱላል አብቴንደን እን አብን ኤሜቴን? አርጌቶ ቁሉክ ምን ካኤብ ሀማጼ አን እስን ጎአጋልስሳረ ላኮአብተቴን። <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />አየሱን ጎአመን ሂክ ዱባ ካኮንሌራ ቁሉክ ካሄገሮልኮክ ማጻፋይ ካጻፋመራ ጎጎጉዳሮንያ” ሀሱ ጎራታ ኡሱኮ ኦአጋልሳታረን ዱባ ኡሱ ኢሰን ባቃተን።<verse eid="MAT 26:56" /></para>
  <para style="s1">የሱሳ አይሁድኮት ሾንጎይ ሆረ ኣላኖ</para>
  <para style="r">(<ref loc="MRK 14:53-65">ማር. 14፡53-65</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22፡54-55</ref>፥<ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ያን. 18፡13-14</ref>፥<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />ሀሱ ጎራታ የሱሳ ካአበራ እባዶ ሴራ ካሙሴ ኦአጋልስሳራና ጃርሳ ካኡሌ ኩኩመ ታኮግረ ቱቃሞልኮክ ዎይቻት ቀያፋ ቶስ ኡሱ ጌሰን። <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />አየሱን ጎአመን ጴጢሮሳ ፋክመጉረ ካቱቃሞል ዎይቻትኮክ አዉድ ታ ጌሮ ኡሱ ዴበ ሰሴታ ግረ፥ ኦሮዴ ታበጉረ አየስ ታልናሮ ድን ኦኦራኔነ ዎታ ሀማጼ።<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />ሀሱ ጎራታ ቱቃሞልኮክ ዎይቻትና ካአይሁድ ሾንጎ ዱባ የሱሳ ላጋድስስን ካጣራ አቶ ዶታ ግረን፥ <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />ካሞጋን ካጣራ አቶጆል ጎኤሜተና አቶ ካሌሮ ላኮሄላቴራን፥ ዳንበኔ ጎአመን እባዶ ላማ ጋባላመረ፥ <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />“ሂክ እባዶት ቁሉክ ‘ምን ካኤብ ባስጉረ አሪ ሴድ ኦሮ አባብ ማዳርን ዳንዳራ’ አመራ” አማ አዬሴን።<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />ሀሱ ጎራታ ቱቃሞልኮክ ዎይቻት ኬ አሌጉረ፥ “ሂክ እባዶ ካአቶቴሮ ዱባን ኮና አባብ ላኮአባባቶያ?” አመ። <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />የሱሳና ጎአመን ጫልኢ አመ። ቱኡቃሞልኮክ ዎይቻት የሱሳነ፥ “አን ኩ አርዶክ መገ ካዋይ አበራ፥ አት ክርስቶሳ ኤረ ካዋ ጎሌተ ኖን ሰጊ?” አመ።<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />የሱሳና፥ “አትዋ እሲ አንተታ፥ አየሱን ጎአመን እስን ዱባና ሰጊሮ ሂታኮ ሆረንባን ኤረ ካእባዶ ሁና ካዋኮት መርጌ ሀማጺረ ካዳሩረ ዱማንቻይ ኦሮ ኤመታ ግራን ድናታን” አመ።<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />ሀሱ ጎራታ ቱቃሞልኮክ ዎይቻት ሳርስኬሳ ፊለጉረ፥ “ሂክ ዋ ሀባረራ፤ ሂካኮ ካካለ ምስክ አቶ ዶትሳራ? ኡሱ ዋ ሀባራ አዬሳኖ እስንዋ ማልቴታን አመ። <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />መ አን እስኑን ላራ?” አመ።</para>
  <para style="p" vid="MAT 26:66">“እሶና ጎይን ዶትሳራ” አመን አባበን።<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />ሀሱ ጎራታ በቤድቴሳ ሀንጩፈ ቱፋ ባላባንጆ ባሳ፥ <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />“ክርስቶሳ! አዮያ ኩ ካባሰ? አላ ሄገሮ አየስ” አመን።<verse eid="MAT 26:68" /></para>
  <para style="s1">ጴጢሮሳ የሱሳ ካካተ</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር. 14፡66-72</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22፡56-62</ref>፤ <ref loc="JHN 18:15-18">ያን. 18፡15-18</ref>፥<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />ኤሰኮ አባባተረ ጴጢሮሳ ካቱቃሞል ዎይቻትኮክ አዉዲ ኦሮ ሀማጼ ግራን ድይት ቶ ኡሱ ቶስ ጋባላንተጉደ “አት ካጋሊላ የሱሳነ ዎታ ግቴዋ” አንተ።<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />ኡሱ ጎአመን፥ “አት ማመ አማቶ አን ላካሶ አማ ዱባይ ሆረ ካካተ።”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />አዉድኮ ካኮበያራን ካራነ ብን ሴታ ግራን ታካለ ድይት ጴጢሮሳ ዴተጉዴ ኤሰ ካግረ እባዶዉን “ሂክ እባዶት ካናዝረት የሱሳነ ዎታ ግረ” አንተ።<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />ጴጢሮሳን ካአማቶ ሃፉራይ “ሂካ እባዶት አን ላካሶ” አማ ካላም ካካተ።<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />አባራን ጋጭመጉረ ኤሰ አሌ ካግረ እባዶ ጴጢሮሳ ቶስ ጋባላመንጉረን፥ “አዬስካዋ አዴስሳራ፥ ኦግራን አትና እሶኮ ኮታ” አመን።<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />ኡሱና አማታና ቃንጋ “አን ኡሱ እባዶት ላኮካሶ” አመ። ሀሱ ጎራታ ሉካለና ኦየ።<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />ጎርሰዋ፥ ጴጢሮሳ “ሉካለ ሀኦይኖን ግራን ሴድ ጋል አት እን ካካዪናታ” አመ። የሱሳ ካአዬሰራ ሃፉራ ኡሱን ቃል አመ። ጴጢሮሳና ሳርዴ ቤጉረ ዩሩሩ አመ ኦተ።<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">የሱሳ ጲላጦሳ ቶስ ጌሳኖ</para>
  <para style="r">(<ref loc="MRK 15:1">ማር. 15፡1</ref>፤ <ref loc="LUK 23:1-2">ሉቃ. 23፡1-2</ref>፤ <ref loc="JHN 18:28-32">ያን. 18፡28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />ባር ባባርስ ካቱቃሞል ዎይቻልና ጃርሳ ካኡሌ ዱባ የሱሳ ታየል ላጋድራን ማካረን። <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />የሱሳ ሽዬን ጌሰንጉረን ካሮም ሞት ጲላጦሳን ሮርሰን ስሰን።<verse eid="MAT 27:2" /></para>
  <para style="s1">ይሁዳ እስኦቴሳ ሱዋተ</para>
  <para style="r">(<ref loc="ACT 1:18-19">ኦፋ. ፈ. 1፡18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />ሮርሰ ካስሰራ ይሁዳና የሱሳ ጎይን ፍርዳማኖ ካኮድያረ ጎራታ ጋቤ። ብር ሶንዶም ካቱቃሞል ዎይቻሉና ታኡሌ ጃርሶለዉን አባበ ስሰጉረ፥ <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />“አን ቁሉክ እባዶት ጎይን ሮርሰ ማንኮስሰሮ ማራን ባሰራ” አመ።</para>
  <para style="p" vid="MAT 27:4">እሶና “ሀያ ኖ መ ካታብሳራ፥ ሀሱ ያዳካያ” አመን።<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />ሃኑን ይሁዳ ብር ቁሉክ ምን ካኤብ ኦሮ ሻፈ ኢሰ ቤጉረ እስ ሱላተ ጎየ።<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />ካቱቃሞል ዎይቻልና ኤሰ ብር አቴንጉረን፥ “ህት ብር ዶክ ካኢጌኮት ማንኮሌተቶ ማራን ምን ካዋዉን ሉጉድን ሴራካን ፈኢ ላኮስሳሮ” አመን። <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />ማካረንጉረን ማርት ታኮቃማላን ታቃማል ባንኤ ጎጎሌቶን ኡሱ ማራጋዴ ኤሬኮ ሁ ካመጣሮኮት ባንኤ ኢምኔን። <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />ሃኑን ሀሴ ባንኤ ህታር ታጌቶይ፥ “ኡል ካኢጌ” አማማተ ኡማማታ።<note caller="-" style="x"><char style="xo" closed="false">27፡8 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">ኦፋ. ፈ. 1፡18-19</ref>።</char></note> <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />ሂካ ጋራይ ካሄገሮ ኤርማሳይ፥ ይሁዳን ሙራ ጎጎሌቶ፥</para>
  <para style="p" vid="MAT 27:9">ጎሳ ካእስራኤል ታሄረገሮ “ብር ሶንዶም አታቴን። <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />ጎታና እን ጎጎአጃጄሮክ ማለ ኤሬኮ ሁ ካመጣሮኮት ባንኤን ሙሬን” አማመ ካሰጋመራ ጉዳተ።<note caller="-" style="x"><char style="xo" closed="false">27፡10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">ዛኪ. 11፡12-13</ref>።</char></note><verse eid="MAT 27:10" /></para>
  <para style="s1">የሱሳ ጲላጦሳ ሆረ</para>
  <para style="r">(<ref loc="MRK 15:2-5">ማር. 15፡2-5</ref>፤ <ref loc="LUK 23:3-5">ሉቃ. 23፡3-5</ref>፤ <ref loc="JHN 18:33-38">ያን. 18፡33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />ሀሱ ጎራታ የሱሳ ካሮም ሞት ጲላጦሳ ሆረ አሌ፥ ካሮም ሞትና “አት ካአይሁድ ዎኖታ?” አመ ሆሳተ፥ የሱሳና “አት ጎጎአማቶያ” አመ አባበ።<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />ካቱቃሞል ዎይቻልና ጃርሶለ ጎሞተና ኡሱ አደ ኮና አባብ ላኮስሰ። <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />ሀሱ ጎራታ ጲላጦሳ “ምያ አቶ ከነን አቶቴራን ላኮማላቶያ?” አመ። <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />የሱሳ ጎአመን ካሮም ሞትና ኣሎ ታ ማምሮን ካሞታመሮ ሞቶን ሃፉራ ኮና ሱረ ላኮአባበ።<verse eid="MAT 27:14" /></para>
  <para style="s1">የሱሳ ካጎይ ፍርዳ ፍርዳማኖ</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር. 15፡6-15</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፡13-25</ref>፤ <ref loc="JHN 18:39">ያን. 18፡39</ref>፤ <ref loc="JHN 19:16">19፡16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />ካሮም ሞትና ጎሳ ካፋስካ ታባላ አሪ ጎጎፉራምሮን ካዶታታሮ ኦዶ ኮ ሻኖኮ ካኮፉራሮ ዎጋ አባናየ። <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />ሀሱ ጎራታ ባስ ፈላኖይ ካአዴሳመረ ባርባነ ካአማማራ ካሽያመረ ኮ ግረ። <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />ጎሳ ኩኩ ካኮአማረ ጎራታ ጲላጦሳ፥ “ባርባነኮና፥ ክርስቶሳ ካአማማሮ የሱሳኮ፥ አዮ አን ጎጎፉሮን ዶታታን?” አመ። <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />ጲላጦሳና ሂካ ካኮንአመራ እሶ ቃናቴን ሮርሰን ካስሰራን ማንኮአዴሳረ ማራንያ።<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />ጲላጦሳ ካፍርዳ አርጃታ ጉት ሀማጼ ግራን ኦርቴሳ፥ “ኣላንቲ ቴሳ ሄመንካ ህስሎይ ራኮ ታሜላን አን ማንኮዴሮ ማራን ሀሱ ቁሉክ እባዶት ጉት ኮና አየስ ጎጎየሎንኮ ካአማሮ ሀንዳ ኡሱን ፋርተ።”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />አየሱን ጎአመን ካቱቃሞል ዎይቻልና ታኡሌ ጃርሶለል ባርባነ ጎጎፉራምሮ የሱሳ አድ ጎጎ ጎሮን ጎሳ ጲላጦሳ ጎጎሆሳሮን ከኬሳ ግረን።<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />ካሮም ሞትና፥ “እሶ ላማኮ አዮ አን ጎጎፉሮ ዶታታን?” አመ ካላም ሆሳተ።</para>
  <para style="p" vid="MAT 27:21">እሶና፥ “ባርባነ” አመን አባበን።<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />ጲላጦሳና፥ “ሀያ ክርስቶሳ ካአማማሮ የሱሳ ምስ የላ?” አመ።</para>
  <para style="p" vid="MAT 27:22">እሶ ዱባና “ሀሱዋሞ” አመን።<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />ጲላጦሳና፥ “ሙን? መ ታሜላን ፈለራ?” አመ ሆሳተ።</para>
  <para style="p" vid="MAT 27:23">እሶና አደን ኣሎ ኦካ፥ “ሀሱዋሞ” አመን።<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />ጲላጦሳና ኦኮ አዳማኖ ኳሬ ኮና አየስ ካጋርጋሮን ላኖ ዴጉረ “አን ሂካ እባዶትኮክ ኢግኮ ባልቻያ፥” እስን እስኦትስን ኦራዬን፥ “ጎርታኑ ኦዶናት ካክስንያ” አመጉረ በከ ኬንስሰጉረ ጎሳ ሆረ ገነኖኦቴሳ ኣለ።<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />ጎሳ ዱባና፥ “ኢግኬሳ ኖየና ይስካን ጉት ሀሌዎ” አመ አባበ።<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />ሀሱ ጎራታ ባርባነ ፉረ ጋፋረረ፥ የሱሳ አደ ቦጪሰረ ጎጎሱዋምሮ ሮርሰ ስሰ።<verse eid="MAT 27:26" /></para>
  <para style="s1">ካሮም ዎታዳራል የሱሳ ጉት ቃጭፋታኖ</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር. 15፡16-20</ref>፤ <ref loc="JHN 19:2-3">ያን. 19፡2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />ኤሰኮ ካሮም ሞቲኮክ ዎታዳራ የሱሳ ካሞትት አዉድ ቶስ ጌሰን፥ ዎታዳራል ዱባ የሱሳ ማራሙር ጎጎአልሮን ኩኩይሰ። <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />ሳርስኬሳና ቃረንጉሬን ሄላት ካባ ሳርስሴን፥ <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />ኤኤን ማማረን ካላቻ ፈሌንጉሬን መተኬሳይ ጉት ካዬን፥ ታሌማ ዳማ ገነ ታመርጌይ አብስሴን ሆረ ግልቢሰንጉሬን “አይሁድኮክ ዎኖ! ኖጎዳ ኩን ሀሌቶ” አማ ቃጭፋታረን። <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />ሀንጩፈ ኡሱ ጉት ቱፋ ታሌማ ዳማ ገነኮ ኣተንጉረን ታሌማ ዳማይ መተኬሳ አባበን አባበን ባሰን፥ <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />ቃጭፋቴን አባባቴንጉረን ሄላት ካባ ቃረንጉሬን ካሆሬ ሳርስኬሳ ኣተን ሳርስሴን፥ ሱይና አበን ሴተን።<verse eid="MAT 27:31" /></para>
  <para style="s1">ሱዋማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር. 15፡21-32</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፡26-43</ref>፤ <ref loc="JHN 19:17-27">ያን. 19፡17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />አበን ሴታ ግራን ስሞና ካአማማረ ካቀሬና ኡልኮክ እባዶት ሄሌንጉሬን፥ ማስቃሊ ጎጎስድሮ ሁኖመን። <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />ፉረንና፥ [ቡቀ ታመተ] ታሌተቶ ጎልጎታ ታአማንተቶ ባንኤ ካኮግያረን ጎራታ፥ <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />ካኦኮኮታሮ ኮኮነ ዎታ ካለዳመሮ ካዎይኒ ጣሞ ኡሱ ጎጎጣምሮ ስሰን፥ ኡሱ ጎአመን ህኢ አበ ዴረ ጣምን ላኮዶተ።<note caller="-" style="x"><char style="xo" closed="false">27፡34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዛ. 69፡21</ref>።</char></note> <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />የሱሳ ሱዬን አባባቴንጉረን ኢጣ ቤሳተን ሳርስልኬሳና ሄዴዳመን፥<note caller="-" style="x"><char style="xo" closed="false">27፡35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዛ. 22፡18</ref>።</char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />ኤሴና ሀማጼን ኦራ ግረን። <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />“ሂክ ካአይሁድ ዎኖ የሱሳያ” ታአማቶ ታሞቶ ጹፊ መተኬሳኮ ጉንቴ ካዬን። <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />ሽቶሌ ላማ ኮ ምና ታመርገነ፥ ኮ ምና ታበተነ ኡሱነ ዎታ ሱዬን። <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />ራኔ ካሮራራ እባዶ ኣሎ ኡሱ ሀባራ ቃጭፋታ፥<note caller="-" style="x"><char style="xo" closed="false">27፡39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዛ. 22፡7</ref>፤ <ref loc="PSA 109:25">109፡25</ref>።</char></note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />“ቁሉክ ምን ካኤብ ባስጉደ አሪ ሴድ ኦሮ ካማዳርናታ፥ አላ እስኦታ ሃሳ? ኤረ ካዋ ጎሌተ አላ ማስቃሊ ጉኮ ዳግ” አማ ግረን።<note caller="-" style="x"><char style="xo" closed="false">27፡40 </char><char style="xt" closed="false"><ref loc="MAT 26:6">ማቶ. 26፡6</ref>፤ <ref loc="JHN 2:19">ያን. 2፡19</ref>።</char></note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />ኡሱማለና ቱቃሞልኮክ ዎይቻል፥ ሴራ ኦአጋልስሳራና ጃርሶለነ ዎታ ሌንጉረን ቃጭፋታ ሃ አማ ግረን፥ <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“ካካለ ፋይሳራ” እስኦቴሳ አደ ፋይሳይን ላኮዳንዳሮ፥ ኡሱ ካእስራኤል ዎኖ ጎሌ ግዳ ማስቃሊኮ ሀዳገ፥ ኖና አማንናና። <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />ኡሱ ዋይ አማናታራ አን ኤረ ካዋያ አማ ማንኮግረ ማራን፥ አላ ዋ ኡሱ ካጌላታሮ ጎሌ ግዳ ሀሃሶ።<note caller="-" style="x"><char style="xo" closed="false">27፡43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">ማዛ. 22፡8</ref>።</char></note> <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />ኡሱነ ዎታ ኦሱዋሜሬን ሽቶሌና ኡሱማሌዋ ሀባር ካሞጋን ሀባራረን።<verse eid="MAT 27:44" /></para>
  <para style="s1">ጎይ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 15:33-41">ማር. 15፡33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፡44-49</ref>፤ <ref loc="JHN 19:28-30">ያን. 19፡28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />ሳቲ ሌኮ ሀጋአበረ ታ ሳቲ ሳጋሊ ጌሮ ኡል ዱባ ጉት ሙጉድ ሌ። <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />ሳቲ ሳጋሊ የሱሳ ያየቴሳ ጦቂሰረ “ኤሎሄ ኤሎሄ ላማሰበቀታኒ?” አማ ኦኬ። ፉረንና “ሄዶኬ! ሄዶኬ! እን ሙን ኢሰ?” አማኖያ።<note caller="-" style="x"><char style="xo" closed="false">27፡46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዛ. 22፡1</ref>።</char></note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />ኤሰ አሌን ኦግራንኮ ኮኮ ማለንጉሬን “ኤላሳ ኡማራ” አመን።<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />ጎርሰዋ እሶ ኦሮኮ ኮ ትያ ኤመተጉረ እስፎንጅ ኣተጉረ ካኦኮኮታሮ ጣሞ ካዎይኒ ኦሮዴሰ ናካረጉረ እስፎንጅ ሌማ ብርጠ ካየጉረ የሱሳ ጎጎጣምሮ ስሰ።<note caller="-" style="x"><char style="xo" closed="false">27፡48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዛ. 69፡21</ref>።</char></note> <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />ኦካለና አደን “እሳጋ አላ ኤላሳ ኤሜይጉረ ኡሱ ጎሃስናሮ ድናና” አመን።<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />የሱሳ አደ ካላም ያየ ጦቂሰ ኦኬጉረ ኔፎ ቤተ።<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />ሀሱ ጎራታ ቁሉክ ምን ካዋኮት ጎጎሎ ኤለኮ ታ ሄገል ጌሮ ባንኤ ላማ ቤ ፊላመ፥ ኡልና ሻላጋመ፥ ኤኤሞልና በበልኤ፥<note caller="-" style="x"><char style="xo" closed="false">27፡51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ብያ. 26፡31-33</ref>።</char></note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />ህየልና ባናመ፥ ጎየ ካግረ ካሞጋን ቁሎለና ኬን፥ <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />ህየልኮ ቤጉረን ጎይኮ ክያኖ ካየሱሳኮ አባባተረ ቁሉት ካታማ ኢየሩሳለም ቶስ ታቤንጉረን ካሞጋን እባዶን ሙተን።<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />ካቦሎ ዎይቻልና ኡሱነ ዎታ የሱሳ ኦራ ካግረ ዎታዳራል ኡል ሻላጋማኖና ካሌሮ አየስ ዱባ ካኮድያረን ጎራታ ኣሎ አብሳቴንጉረን፥ “ሂክ ኦግራን ኤረ ካዋየ” አመን።<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />ጋሊላኮ ኦኤሜተራና የሱሳን ካዶትሳሮ አየስ ሀንዳይን ዴበ ካሰሰታረ ሄለል ካሞጋን አየስ ታልናሮ ዲያ ፋክሜን ኡሱ ጎቦቢ ግረን። <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />እሶ ኦሮኮ ካመግደላ ኡልኮት ማይራመነ ታያይቆባና ታዮሴፋ አዬ ማይራመኔ ግረን። ኡሱማለና ኦር ታዛብዶሳነዬን።<note caller="-" style="x"><char style="xo" closed="false">27፡56 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8፡2-3</ref>።</char></note><verse eid="MAT 27:56" /></para>
  <para style="s1">ቃማላማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር. 15፡42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፡50-56</ref>፤ <ref loc="JHN 19:38-42">ያን. 19፡38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />ኡል ሄመን ካኮላረ ጎራታ ዮሴፋ ካአማማራ ዱሬሳት አርማትያስ ታአማና ካታማኮ ኤመተ፥ ኡሱና አደ የሱሳኮ ካአጋልሳታረየ፥ <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ኡሱና ጲላጦሳ ቶስ ሴተጉረ ሬስ ካየሱሳ ኤባተ፥ ጲላጦሳና ኡሱን ጎጎስስራዉን አጃጄ። <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />ዮሴፋና ሬስ ኣተጉረ ጋሸ ታኡሱቢ ማረ ኢድሰ። <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />ኤኤሞኮ ቆራመ ካኦሻመረ ጉምቢ ኦሮ ቃማለ፥ ኤሰኮና ኤኤሞ ካንጂንክ ኦቶቶልሰጉረ ካቃማል ጉምቢኮት ህኢ ዱድሰ ሴተ። <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />ሀሱ ጎራታ ካመግደላ ኡልኮት ማይራመና ታካለ ማይራመ ቃማል ሆረ ሀማጼን ግረን።<verse eid="MAT 27:61" /></para>
  <para style="s1">ቃማል ካየሱሳኮክ ኦራማኖ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />ታላም አሪ ታያሱማ ማንኮሌተ ማራን ካቱቃሞል ዎይቻልና ፋራሳውልነ ራቶ ጲላጦሳ ቶስ ሰተንጉረን ሃ አመን፥ <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />“ጎታ! ሀሱ ካሶሶይሳራ ጣየ ኔፎነ ግራን ‘ታሴድ አሪ ጎይኮ ኪናራ’ ካአማራ ኖን ቃል አመራ።<note caller="-" style="x"><char style="xo" closed="false">27፡63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ. 16፡21</ref>፤ <ref loc="MAT 17:23">17፡23</ref>፤ <ref loc="MAT 20:19">20፡19</ref>፤ <ref loc="MRK 8:31">ማር. 8፡31</ref>፤ <ref loc="MRK 9:31">9፡31</ref>፤ <ref loc="MRK 10:33-34">10፡33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ. 9፡22</ref>፤ <ref loc="LUK 8:31">8፡31</ref>፤ <ref loc="LUK 18:31-33">18፡31-33</ref>።</char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />ሃኑን የሱሳኮ ኦአጋልሳታረን ሬስ ሄት ኣትጉረን ጎሳነ፥ ጎይኮ ኬራ አም ጎጎአዬሶንኮ ቃማልኬሳ ታ አሪ ሴድ ጌሮ ጎጎኦራምሮ አጃጂ፥ ጎርቱን ካሃረ ሶሶዋኖ ካሆሬኮ ካሮረ ሌራ።”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />ጲላጦሳና፥ “ካኦሮ እስን አብታንዋ ሴየንጉዴን ካካሳን ራድ ኦርስሳዬን” አመ። <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />እሶና ሰተንጉረን ቃማል ጉት ማታማ ካዬንጉሬን ካኦሮ ኣልሴን።<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">ጎይኮ ክያኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MAT 28:1-10">ማቶ. 28፡1-10</ref>፤ <ref loc="MRK 16:1-10">ማር. 16፡1-10</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፡1-12</ref>፤ <ref loc="JHN 20:1-10">ያን. 20፡1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />አይሁድን ታፎልሲ አርኮ አባባተረ ታዎጋ አሪ ባር ቡላነ ካመግደላ ኡልኮት ማይራመና ታካለ ማይራመ ቃማል ድን ሴተን።<note caller="+" style="f"><char style="fr" closed="false">28፡1 </char><char style="ft" closed="false">አይሁድን ታፎልሲ አሪ ካአማራ፦ ታቄራ አሪ አማኖያ። ማጻፋ ኦሮ ሰንበት አማራ። ፉረንና ታፎልሲ አሪ አማኖያ </char></note><verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />ደራኣ ካአቲ ኡልኮክ አኣኖ ሌ፥ ካጎታ ኤርግቻትና ዳሩርኮ ዳገጉረ ቃማል ቶስ ሴተ ኤኤሞ ኦቶቶልሰጉረ ጉት ሀማጼ። <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />ታኤርግቻ በቤድቴሳና ሀንቃ ኣን ታሀንቃቶ፥ ሳርስኬሳና በለት አን ጉማራክየ። <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />ኦኦራኔና ኤርግቻት አብሳታናኮ ካከይ ሀረኤን ካጎየሮ እባዶ ኣን ሌን።<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />ኤርግቻትና ሄሌልጃነ ሃ አመ፥ “እስን አሮአብሳቴን እስን ካሱዋመረ የሱሳ ካዶታታን አን ካሶዋ፥ <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />ሃኑን ህታኒ ላኮግሮ፥ ጎጎአዬሰሮይ ኬራ፥ ኮዬን ኡሱ ታኮቃማላመረ ባንኤ ዲያ። <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />ግዳ ሳማ ሴየንጉዴን ኡሱኮ ኦአጋልሳታሬዉን የሱሳ ጎይኮ ኬራ፥ እስንኮ ጣይ ጋሊላ ቶስ ሴይናራ ጎርታኑን አን ሰገራ።”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />ሄለልጃና አብሲና ገጌሎይ አማጋሜንጉሬን የሱሳኮ ኦአጋልሳታራዉን ሰግን ኣሎ ትያ ታቃማል ባንኤኮ ኢሰን ሴተን። <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />ጎርሰዋ የሱሳ እሶ ሄለጉረ፥ “ኖጎዳ ግታነ” አመ። እሶና የሱሳ ቶስ ጋባላመንጉረን ሉክቴሳ አባተን ሳጋደን። <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />የሱሳና “አሮአብሳቴን ሴየንጉዴን ጋሊላ ቶስ ጎጎሴራዉን አብላልቴዉን ሰጋ፥ ኤሰ እን ድናታን” አመ።<verse eid="MAT 28:10" /></para>
  <para style="s1">ኦኦራናንኮክ አቶታኖ</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />ሄለልጃና ራድ ሴቶ ጉት ግራን ኦኦራኔንኮ ኮኮ ካታማ ቶስ ቤንጉሬን ካሌሮ ዱባ ካቱቃሞል ዎይቻሉን ሰገን። <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />ካቱቃሞል ዎይቻልና ጃርሶለነ ዎታ ኩኩአመን ማካረንጉረን ዎታዳራን ማራጋደ ካሞጋን እሶ ስሳ ሃ አመን፤ <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“ኖ ሁዱርነ ግራን ‘ኡሱኮ ኦአጋልሳታረን ሄመን ኤመተንጉረን ኖኮ ሄቴን አማ አመን።’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />ህት ኦዱ ሞቲ ዶሌ ጎማልሳንተና ሱረ ኖ ጋቾ አዴስንሳ፥ ኮና ካሜላን አየስ እስን ጎጎጌኖንኮ የልኖዋ” አመን። <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />ዎታዳራልና ማራጋደ አታቴንጉሬን ጎጎአጃጃመራን ማለ የሌን፥ ህት ጅርት ህታር ጊን አይሁድ ዶሌ ጋምባንተ ዳርኣንተ።<verse eid="MAT 28:15" /></para>
  <para style="s1">የሱሳ ኡሱኮ ኦአጋልሳታራዉን ሙታኖ</para>
  <para style="r">(<ref loc="MRK 16:14-18">ማር. 16፡14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፡36-49</ref>፤ <ref loc="JHN 20:19-23">ያን. 20፡19-23</ref>፤ <ref loc="ACT 1:6-8">ኦፋ. ፈ. 1፡6-8</ref>፤ <ref loc="1CO 15:3-8">1 ቆሮ. 15፡3-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />ኤሰኮና ቶሞንኮ ኮ የሱሳኮ ኦአጋልሳታረን ጋሊላይ ታግቶ የሱሳ እሶን ታቱሰሮ ዎዳም ቶስ ሴተን። <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />ኡሱ ካኮድያረን ጎራታ ሳጋደን፥ ኮኮ አደን ሄዳቴን።<verse eid="MAT 28:17" /></para>
  <para style="s1">ካንጂንክ አጃጃ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />የሱሳና ኡሱኮ ኦአጋልሳታረን ማንኮግሬን ቶስ ኤመተጉረ፥ “ኦዶናት ዱባ ዳሩርና ኡሊ ኢን ስሳመራ፥ <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />ሃኑን ሴዬንዴን ጎሳ ዱባ ኦዶይ፥ ኤረይና አያና ቁሉኮክ መገይ ጣማቃ እንኮ ኦአጋልሳታራን የላ።<note caller="-" style="x"><char style="xo" closed="false">28፡19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ኦፋ. ፈ. 1፡8</ref>።</char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />አን እስኑን ካስሰሮ አጃጃ ዱባ ጎጎኦራናዉን አጋልስሳ፥ አንና አላምኮት ጋቾ ታ ጌሮ አርጌቶ እስኔ ዎታ ግራ” አመ።<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>