<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Bayso New Testament</book>
  <para style="h">ያንሳ</para>
  <para style="toc1">ያንሳ ካጻፈሮ ጎታካንክ ካየሱሳ ክርስቶሳ ዎንጋላ</para>
  <para style="toc2">ያንሳ</para>
  <para style="toc3">ያን.</para>
  <para style="mt1">ያንሳ ካጻፈሮ</para>
  <para style="mt2">ጎታካንክ ካየሱሳ ክርስቶሳ ዎንጋላ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ካያንሳ ዎንጋላ የሱሳ ካኮቱሳራ እባዶ ሌ እባዶ ኦሮ ካሙተሮ አርዶክ ሃፉራ ካዋ ላኖ ቱስንያ፥ ማጻአፋ መተኬሳይ ጎጎቱሳሮ ሂክ ዎንጋላ ካኮንጻፋመራ ኦናባባራን የሱሳ ካፋይሳሮ ል ኤመይናራ ካአማመረ ኤረ ካዋ ላኖ እሶ ጎጎአማናዉና ኡሱ አማናኖኮት ኣላንቲ ጅሩ ጅሮማክ ግር እሶን ካግሮ ላኖ ጎጎአዴስራዉንያ (20፡31)።</para>
  <para style="ip">ዎንጋላ ታሆራርጄ ባንኤ ጅሩ ጅሮማክ ሃፉራ ካዋና የሱሳ ራቶ እሶ ኮ ላኖ ታባኖ ኣን ቱሰ አባባተረ የሱሳ ካፋይሳሮ ል ኤመይናራ ካአማመረ ኤረ ካዋ ላኖ ካቱሳሮ ካለካለክ ባሳክ ማላታል ቱሳራ፥ ኤሰኮ ሂካ ባሳክ ማላታልኮ ምስት ላኦ ሄላንተቶ ታቱሳቶ ጅርት ማለ ግራናን፥ ህት ባንኤ ታማማካታ እባዶ ኮኮ የሱሳይ አማኔረ ኡሱ ዴበ ኦሰሰታራን ላኖኮክ ጋራ፥ ኦካለ አደን ኡሱ ምሲ ኔባተራና እሶ ኡሱ ላኮአማናኖ ጎጎአሜራን ማሌያ፥ ፎልሲ 13-17 የሱሳ ታኮአባመረ ሄመኒ ኡሱኮ ኦአጋልሳታራነ ዎታ ኤክ ግታት ታአቲ ኤሴላ ኡሱ አባናየና ሱዋማኖኮ ሆረነ ካእስኤካሳታኖና ካጎጎኢና ሃፉራ ኡሱ እሶን ማልስሳኖ እሶ አዬሳራን። ካጋቾ ፎልሲጆል አባማኖ ካየሱሳኮክ ጋራና ፍርዳዉን ሆረ ኣላኖ፥ ሱዋማኖኬሳና ጎይኮ ክያኖኬሳኮክ ጋራ፥ ኡሱማለና ጎይኮ ክያኖኬሳኮ አባባተረ ኡሱኮ ኦአጋልሳታራዉን ሙታኖኮክ ጋራ ኦቱሳራንያን።</para>
  <para style="ip">ያንሳ ጋራ ካየሱሳ ክርስቶሳነ ካሄላማሮ ጅሩ ጅሮማክ ግር አዴስሰ ካኮንቱሳራ ህት ስኖ ሂታኮ ሆረንባን የሱሳ ራ ኣን፥ ሩም ኣን፥ ግር ኣን የላቴረን ኦአታታራዉንያ። ዎንጋላ ካያንሳ ካለክ ካየላራ ሩምጆል ካአያና አጋልስስን ኦጌሮመራና ባርሳኖ ኦህታርቴቱን ላኦ ኦአታታኖ፥ ሂካ አማኖና በከ፥ ባቦ፥ ኢፋ፥ ካፎፌ፥ እዳድ፥ አካክልተ ካዎይኒና ኢል ታዎይኒ ሂካ ኣንክክ ኮኮጆል ማሱሳ የል አታኖያ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ቆፋ ታሆሬ <char style="ior"><ref loc="JHN 1:1-18">1፡1-18</ref> </char></para>
  <para style="io1">ካጣማቃሮ ያንሳና ኦሆራርጄ የሱሳኮ ኦአጋልሳታረን <char style="ior"><ref loc="JHN 1:19-51">1፡19-51</ref> </char></para>
  <para style="io1">የሱሳ ሀንዳኖኬሳ ሀጋአባኖ <char style="ior"><ref loc="JHN 2:1-12:50">2፡1—12፡50</ref> </char></para>
  <para style="io1">ኢየሩሳለምና ጎቦብክሴይ ካጋቾ ሀንዳኖኬሳኮክ አርጆል <char style="ior"><ref loc="JHN 13:1-19:42">13፡1—19፡42</ref> </char></para>
  <para style="io1">ካጎታ ጎይኮ ከያኖና ኡሱ ኦአጋልሳታራዉን ሙታኖኬሳ <char style="ior"><ref loc="JHN 20:1-31">20፡1-31</ref> </char></para>
  <para style="io1">ጉድሳኖይ፥ ጋሊላይ አድአድ ኡሱኮ ኦአጋልሳታራኑን ሙታኖ <char style="ior"><ref loc="JHN 21:1-25">21፡1-25</ref> </char></para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s1">ሃፉራ ካግር</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />ሆራርጀ ሃፉራ ግረ፥ ሃፉራና ዋ ዶሌ ግረ፥ ሃፉራና ዋየ። <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />ኡሱና ሆራርጀ ዋኔታ ግረ። <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />ካመን ዱባና ኡሱ ቶንሴ መጣመ፥ ካመጣመሮ ዱባኮና ኡሱ ካላይ ካመጥታመራ ኮና ላግሮ። <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />ኔፎ ኡሱ ግቴ፥ ህት ኔፎና እባዶን ኢፋቴ። <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />እፋና ሙጉዲ ሀንቃራ፥ ሙጉድና ላኮአዎዳሮ።<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />ዋኮ ካፋራመራ ያንሳ ካአማማረ እባዶት ኮ ግረ።<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="MAT 3:1">ማቶ. 3፡1</ref>፤ <ref loc="MRK 1:4">ማር. 1፡4</ref>፤ <ref loc="LUK 3:1-2">ሉቃ. 3፡1-2</ref>።</char></note> <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />እባዶ ዱባ አቶናትኬሳ ማልረ ጋራኬሳነ ጎጎአማንሮን፥ ኢፋ ማራን አቶ ሊን ኤመተ። <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />እፋ ማራን አቶ ሊን ኤመተራ ኳሬ ኡሱ ኡሱን ኢፋ ላኮየ። <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />እባዶ ዱባን ኢፋ ካስሳሮ ካሌራ ካሩም ኢፋ አላም ቶስ ኤመታ ግረ።<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />ኡሱ አላም ኦሮ ግረ፥ አላም ካኮመጣመራ ኡሱ ጎሌና፥ አላም አደ ኡሱ ላኮአዴሰረ። <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />ካኬሳ ካሌሮ ቶስ ኤመተ። ፋልኬሳና አደ ኡሱ ላኮአታተሮ። <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />ሀሌዎ ኳሬ ኦአታቴራዉና መገኬሳ ኦአማናራን ዱባዉን አደ ኤረ ካዋ ታኮሌራን ፈኢ ስሰራ። <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />እሶና ዋኮ ኡሙላሜናን ኳሬ፥ ታኢገ ጎርቱን ታሶየ ፈኢ ጎርቱን ታባባር ፈኢኮ ላኮኡሙላመራን።<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />ሃፉራና እባዶ ሌ፥ ስኖና ሩም አማጋመ ኖ ኦሮ ባሬ። ኣቦኬሳ ዶለኮ ካኤመተሮ፥ ኤረ ኮኮት ካባጃ ኖ ዴነ።<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />ያንሳና፥ “እንኮ ሃሬ ካኤመታራ እንኮ ሆረነ ማንኮ ግረ ማራን እንኮ ሮራራ አመ አን ካኮንአቶታረ ሂካኑንያ” አማ እዬ ኡሱ ማራን አቶቴ።<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />ስኖተሳ አማጋማኖኮ ካከይ ኖ ዱባና ስኖ ጉት ስኖ አታኔና። <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />ዋ ሴራ ጋራ ካሙሴነ ስሰረ፥ ስኖና ሩምና አደ ጋራ ካየሱሳ ክርስቶሳነ ኤመተ። <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />ሱረዋና ዋ ካዴራ ማዮና ላግሮ፥ አየሱን ጎአመን ዋ ኦዶ ዶሌ ካግረ ኤረ ኮ ካሌራ ሄዶ ኡሱ ኖን አዴስሰ።<verse eid="JHN 1:18" /></para>
  <para style="s1">ካጣማቃረ ያንሳኮክ አቶናት</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3፡1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1፡1-8</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፡1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />አይሁድና፥ “አት አዮታ?” አም ጎጎሆሳራዉን ቱቃሞልና ዎዩል ኢየሩሳለምኮ ኡሱ ቶስ ካኮፋራነን፥ ጎራታ ያንሳ ካስሰራ አቶናት ሂካየ።<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />አቶታኖኮና ሃር ላኮጋለ፤ “አን ክርስቶሳ ላኮዮ” አመ አዴስሰ አቶተ።<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />እሶና፥ “ሀያ አት አዮታ? ኤላሳታ?” አመን ሆሳተን።<note caller="-" style="x"><char style="xo" closed="false">1፡21 </char><char style="xt" closed="false"><ref loc="DEU 18:15">አዳ. 18፡15</ref>፤ <ref loc="DEU 18">18</ref>፤ <ref loc="MAL 4:5">ሚል. 4፡5</ref>።</char></note></para>
  <para style="p" vid="JHN 1:21">ኡሱና፥ “ላኮዮ” አመ።</para>
  <para style="p" vid="JHN 1:21">እሶና፥ “ሀያ ካሄገሮታ?” አመን። ኡሱና፥ “ላኮዮ” አመ አባበ።<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />እሶና፤ “ሀያ አት አዮታ? አት ካፋርተተ እባዶን አባብ ኖ ጎጎስንሶ እስ ኦታዉን መማታ?” አመን። <verse eid="JHN 1:22" /><verse number="23" style="v" sid="JHN 1:23" />ያንሳና ካሄገሮ እስያሳ ጎጎሰጋመሮ፥</para>
  <para style="q1" vid="JHN 1:23">“ጎታዉን ራ ‘ኤካሳ አማ</para>
  <para style="q2" vid="JHN 1:23">ቃሉላቶክ ኡሊ ታእያተ ያየ አንያ’ ” አመ አባበ።<note caller="-" style="x"><char style="xo" closed="false">1፡23 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፡3</ref>።</char></note><verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />ፋራሳውልኮ ኦፋራመራና፥ <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />ሃና አመን፤ “ሀያ ክርስቶሳ ጎርቱን ኤላሳ ጎርቱን ካሄገሮ ጎሌኖን ሙን ጣማቃታ?” አመን ሆሳተን።<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />ያንሳና፥ “አን በከ ጣማቃራ፥ እስን ካካሶና አደ እስን ኦሮ አሌራ አመ አባበ። <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />እንኮ ዳንበኔ ካኤመታራ፥ አን ከፈሮ ኦቴሳኮክ ሻኖ ፉርን ካኮዳዴኖን ኡሱያ።”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />ሂክ ዱባ ካሌራ ያንሳ ጣማቃ ታኮግረ ዮርዳኖስኮ፥ ጋማ ታብታንያ ካታማይየ።<verse eid="JHN 1:28" /></para>
  <para style="s1">እዳዶ ካዋ</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />ያንሳ ታላም አሪ፥ የሱሳ ኡሱ ቶስ ካኤሜታሮ ዴረ ሃ አመ፥ “ሂክማ! አላምኮክ ጩቦ ካባሳራ ኢዳዶ ካዋ፥ <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />‘እንኮ ሃሬ ካኤመታራ እንኮ ሆረነ ማንኮ ግረ ማራን እንኮ ሮራራ’ አን እስኑን ካአማረ ኡሱያ። <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />አን መተኬዉን ላኮማላበረ፥ በከ ጣማቃ ካኤሜየራና ኡሱ እስራኤል ኦሮ ጎጎሙትሮንያ” አመ።<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />ኤሰኮና ያንሳ፥ “አያና አራበ ኣን ዳሩርኮ ዳገረ ኡሱ ጉት ሀማጻ ግራን ዴ። <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />አን መተኬዉን ላኮማላበረ አየሱን ጎአመን በከ ጎጎጣማቅሮ ካፋረራና፥ ‘አያና ቁሉክ ካጣማቃራ፥ አያና ዳጋና ኡሱ ጉት ሀማጻ ካሙታራ ኡሱያ’ አመ። <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />አንና ሂካ ዴራ፥ ኡሱ ኤረ ካዋ ላኖ አቶትናራ” አመ አቶናት ስሰ።<verse eid="JHN 1:34" /></para>
  <para style="s1">ኦሆራርጄ የሱሳኮ ኦአጋልሳታረን</para>
  <para style="r">(<ref loc="JHN 1:40-42">ያን. 1፡40-42</ref>፤ <ref loc="MAT 4:18-22">ማቶ. 4፡18-22</ref>፤ <ref loc="MRK 1:16-20">ማር. 1፡16-20</ref>፤ <ref loc="LUK 5:2-11">ሉቃ. 5፡2-11</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />ታላም አሪ ያንሳ የሱሳኮ ኦአጋልሳታረን ላማነ ዎታ ኤሰ ባንኤ አሌ ግረ፥ <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />ያንሳ የሱሳ ኤሰነ ሮራ ግራን ዴረ፥ “ሂክማ ኢዳዶ ካዋ!” አመ።<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />ላማ ያንሳኮ ኦአጋልሳታረና ያንሳ ሂካ አዬሳ ግራን ማሌረን የሱሳ ዴበ ሰሴተን። <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />የሱሳና ካማባል አመረ ኡሱ ዴበ ኦሰሴታራን ዴረ፥ “መ ዶታታን?” አመ ሆሳተ።</para>
  <para style="p" vid="JHN 1:38">እሶና፥ “ራቢ፥ ሀጌ ግታ?” አመን፥ [“ራቢ” አማኖ ካአጋልስሳሮ አማኖያ።]<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />ኡሱና፥ “ኮዬን ዲያ” አመ። “ሃንሱን ሴተረነ ኡሱ ማንኮግሮ ዴን፥” ኤሰርና ኡሱ ዎታ ሀዬን፥ አሪኮና ሳቲ ቶሞንክ ጎራታ ሌ ግረ።<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />ያንሳ ካአዬሰሮ ማለን፥ የሱሳ ዴበ ኦሰሴታረን ላማኮ ኮ ካስሞና ጴጢሮሳኮክ አቢ እንድራሳ ግረ። <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />እንድራሳ ሆራርጀ አቢኬሳ ስሞና ሄለረ፥ “ኖ መስህ ሄላነና” አመ፥ [“መስህ” አማኖ ክርስቶሳ አማኖያ።] <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />የሱሳ ቶንሳ ኬነ። የሱሳና ዴጉረ፥ “አት ካዮና ኤረ ስሞናታ፥ ከፋ አማም ኡማምናታ” አመ፥ “ከፋ” አማኖና ጴጢሮሳ ጎርቱን “ኤኤሞ” አማኖያ።<verse eid="JHN 1:42" /></para>
  <para style="s1">የሱሳ ፍልጶሳና ናትናኤል ጎጎኡመሮ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />ታላም አሪ፥ የሱሳ ጋሊላ ቶስ ሴይን ጎሳተ፥ ፍልጶሳና ሄለረ፥ “እን ዴበ ሰሴና” አመ። <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />ፍልጶሳና እንድራሳ ጴጢሮሳ ኣን ካቤተሳይዳ ካታማኮክ እባዶትየ። <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />ፍልጶሳ ናትናኤል ሄለረ፥ “ሙሴና ካሴራ ማጻፋይ፥ ካሄገሮልና ኡሱ ማራን ካኮንጻፌረን ካዮሴፋ ኤረ ካናዝረት የሱሳ ሄላኔና” አመ።<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />ናትናኤልና፥ “ናዝረትኮ ካእዳንክ አየስ ሄላምን ዳንዳራ?” አመ። ፍልጶሳና፥ “ኤሜዴ ዴና” አመ።<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />የሱሳና ናትናኤል ኡሱ ቶስ ካኤሜታሮ ዴረ፥ “ሂክማ፥ ሜላነ ካላይክ ካሩም እስራኤልት” አማ ጋራ ኬሳ አዬሰ።<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />ናትናኤልና “አት እን ምሲ አዴሰ?” አመ የሱሳ ሆሳተ። የሱሳና፥ “አት ጋ ካባላስ ሄገሊ ግራን፥ ጋና ፍልጶሳ ኩ ሀኡሞን ግራን አን ኩ ዴራ” አመ አባበ።<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />ናትናኤልና አባበረ፥ “ካአጋልስሳቶ! አት ኤረ ካዋታ፥ አት ካእስራኤል ዎኖታ” አመ።<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />የሱሳና፥ “አት ካአማንተታ፥ ካባላስ ጋ ሄገሊ አን ኩ ዴራ ማንኮ አመሮ ማራንያ? ጋና ሂካኮ ካሮረ አየስ አት ዴታ” አመ።<verse eid="JHN 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 1:51" />አደና፥ “አን ሩምና ሩምና አማራ፥ ዳሩር ባናንተደ፥ ኤርግቻ ካዋ ኤረ ካእባዶ ጉት ኮራታና ዳጋ ግራን ድናታን” አመ።<note caller="-" style="x"><char style="xo" closed="false">1፡51 </char><char style="xt" closed="false"><ref loc="GEN 28:12">መጣ 28፡12</ref>።</char></note><verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s1">የሱሳ በከ ጣሞ ካዎይኒ ቶስ ኢግልሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />ታሴድ አሪ ታጋሊላ አዉራጃ፥ ታቃና ካታማይ ሃስኖ ግቴ፥ አዬ ታየሱሳና ኤሰ ግቴ፥ <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />የሱሳና ኡሱኮ ኦአጋልሳታረና ባንኤ ታሃስኖ ኡማሜን ግረን። <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />ጣሞ ካዎይኒ ካኮጉዳታረ ጎራታ አዬ ታየሱሳ፥ “ጣሞ ካዎይኒ ጉዳተለ አንተ።”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />የሱሳና፥ “አት ሄለልትቲ አን መ ጎጎየሎ ዶታታ? ጎራታክ ጋና ላኮጌሮ” አመ።<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />ኣየቴሳና ኤሰ ኦግረን ኦሀንዳራዉን፥ “ኡሱ ካአማሮ ዱባ ፈላ” አንተ።<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />ካአይሁድ ካሁሩፋ ሴራ ማለ፥ ቶዶባታምኮ ከንኮ ታ ቦልኔ ቶሞንኮ ከን ሊትሮ ካአባራ ቶሳ ሌዎ ኤሰ ግረ። <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />የሱሳ ኦሀንዳራነ “ቶሳሊ በከ አማጋ” አመ። እሶና ቶሳሊ ህኢ ገግሰን አማጌን። <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />ኡሱና፥ “ጉኮ ሁሙሳደነ ምን ካሃስኖክ አሞና ጣሞን ኦዶናት ካአቦን ስሳ” አመ። እሶና ኡሱ ጎጎሰጌሮክ ማለ የሌን። <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />ኦዶናት ካአባናየክና ጣሞ ካዎይኒ ቶስ ኦኢግልሳመራን በከ ሁሙገ ዴ። ጎሌና ኤትኮ ኤመቴራን ላኮአዴሰሮ፥ በከ ኦሁሙሰራን ኦሀንዳረን አደን ካሳናየንዋ፤ ኡሱና ካማሻሸ ካለ ኡመረ፥ <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“እባዶ ዱባ ሆራርጀ ካሮርሳራ ካእዳንክ ጣሞ ካዎይኒያ፥ እባዶና ኣሎ ጣመ አባባተረ ካዳንቤ ጣሞ ካዎይኒ ሮርሳራ አት አደ ካእዳንክ ጣሞ ካዎይኒ ግዳ ጊን ካይተታ” አመ።<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />የሱሳና ሂካ ባሳክ ማላታልኮ ካሆሬ ታጋሊላ አዉራጃ ቃና ካታማይ ፈለ፥ ካባጃና ቱሰ፥ ኡሱኮ ኦአጋልሳታረና ኡሱ አማኔን።<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />ኤሰኮ አባባተረ የሱሳ ኣየቴሳነ፥ አቢላል ቴሳኔ ኡሱኮ ኦአጋልሳታረነ ዎታ ካቅፍረናሆም ማማን ቶስ ዳገ፥ ኤሴና አሪ ትጫር ሀማጼን።<note caller="-" style="x"><char style="xo" closed="false">2፡12 </char><char style="xt" closed="false"><ref loc="MAT 4:13">ማቶ. 4፡13</ref>።</char></note><verse eid="JHN 2:12" /></para>
  <para style="s1">የሱሳ ቁሉክ ምን ካኤብ ኤካሰ</para>
  <para style="r">(<ref loc="MAT 21:12-13">ማቶ. 21፡12-13</ref>፤ <ref loc="MRK 11:15-17">ማር. 11፡15-17</ref>፤ <ref loc="LUK 19:45-46">ሉቃ. 19፡45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />ካአይሁድ ባላ ካፋስካ ጎጎጋባላሜ፥ የሱሳ ኢየሩሳለም ቶስ ቤ።<note caller="-" style="x"><char style="xo" closed="false">2፡13 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ብያ. 12፡1-27</ref>።</char></note> <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />ቁሉክ ምን ካዋኮት ኣል ኦሮ ግድጆል፥ እዳድጆልና አራበጆል ኦዳዳላታሬን ኡሱማለና ሀማጼን ማራጋደ ኢግልሳታ ካዳዳላታረ እባዶ ሄለ። <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />ሀሱ ጎራታ ጦርቃየ ሀረ ኤካሰረ እዳድጆልና ግድጆል ዱባ ምን ካኤብኮት ኣል ኦሮኮ ሆሮረ፥ ማራጋደ ኦኢግልሳታነና ማራጋደክሶ ዳረኤ፥ ጣራጴዛልና ኬሰ ሉጉደ።<verse eid="JHN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 2:16" />አራበ ኦዳዳላታሬነና፥ “ሂታኮ ቤሳ፥ ኣቦኬክ ምን ካዶክ ምን አሮየልቴን!” አመ። <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />የሱሳኮ ኦአጋልሳታረና፥ “ምን ካዉን ታግታ ኢዳነ ጉባታ” አማመ ካጻፋመራ እሶን ሻዳመ።<note caller="-" style="x"><char style="xo" closed="false">2፡17 </char><char style="xt" closed="false"><ref loc="PSA 69:9">ማዛ. 69፡9</ref>።</char></note><verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />አይሁድና፥ “ሂካ ዱባ ፌላኖካዉን መ ማላታ ኖን ቱስናታ?” አመን።<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />የሱሳና “ሂካ ምን ካኤብ ባሳ፥ አንና አሪ ሴድ ኦሮ አባብ ኬስናራ” አመ አባበ።<note caller="-" style="x"><char style="xo" closed="false">2፡19 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶ. 26፡61</ref>፤ <ref loc="MAT 27:40">27፡40</ref>፤ <ref loc="MRK 14:58">ማር. 14፡58</ref>፤ <ref loc="MRK 15:29">15፡29</ref>።</char></note><verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />አይሁድ፥ “ሂካ ቁሉክ ምን ካኤብ ማዳርን ጌስ አፋርታምኮ ሌ ጉድሰራ፥ ሀያ አት ምሲ አሪ ሴድ ኦሮ አባብ ማዳርናታ?” አመን።<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />የሱሳ ቁሉክ ምን ካዋ ጎአምሮ አደ እስ ኦቴሳክ ማር አዬሳኖየ። <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />የሱሳ ጎይኮ ካኮ ኬ ጎራታ፥ ኡሱኮ ኦአጋልሳታረን ኡሱ መ አዬሰሮ ሻደን፥ ቁሉክ ማጻፋና የሱሳ ካአመሮ ሃፉራ አማኔን።<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />የሱሳ ካፋስካ ባላ ኢየሩሳለም ካታማይ ግራን፥ እባዶ ካሞጋን ኡሱ ካፈለሮ ማላታል ዴረ መገኬሳ አማነ። <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />የሱሳ አደ እባዶ ዱባ ማንኮካሶ ማራን እሶ ላኮአብዳተረ፥ <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />ኡሱ ዎዳና ታእባዶ ኦሮ ካግሮ ማንኮካሶ ማራን፥ ማዮና ጋራ ካእባዶ ኡሱን ጎጎአቶትሮን ላኮዶትሰሮ።<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s1">የሱሳና ንቆድሞሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />ታፋራሳውል ኡናና፥ ካአይሁድ ዎይቻልኮ ኮ ካሌራ ንቆድሞሳ ካአማማረ እባዶት ግረ። <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />ኡሱ እባዶትና ሄመን የሱሳ ቶስ ኤመተረ፥ “ካአጋልስሳቶ! ዋ ኡሱነ ዎታ ካሌ እባዶት ኳሬ አት ካፈላቶ ባሳክ ማላታ ማዮና ፈልን ማንኮዳንዴኖን ማራን፥ ዋ ዶለኮ ካኤመተቶና ካአጋልስሳቶ ላኖ ኖ ካንሶዋ” አመ።<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />የሱሳና አባበረ፥ “አን ሩምና ሩምና አማራ፥ ማዮና ካላም ጎኡሙላመ ኳሬ ዎኖናት ካዋ ድን ላኮዳንዳሮ” አመ።<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />“ንቆድሞሳና እባዶ ዶኣይረ አባባይ ምሲ ኡሙላምን ዳንዳራ? ካላም ኡሙላምን አባባይ ገዴም ታኣዎ ቶስ ታብን ዳንዳራ?” አመ ሆሳተ።<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />የሱሳና ሃ አመ አባበ፤ “አን ሩምና ሩምና አማራ፥ ማዮና በከኮና አያናኮ ጎኡሙላመ ኳሬ ዎኖናት ካዋ ቶስ ታብን ላኮዳንዳሮ። <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />እባዶኮ ካኡሙላመ እባዶያ፥ አያናኮ ካኡሙላመና አያናያ። <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />‘ካላም ኡሙላማኖ ዶትሳራ አን ማንኮ አመ ማራን አሮሳደ።’ <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />አምባል ማንኮጌላተ ክያታ፥ ያየና ማላታ፥ አየሱን ጎአመን ኤትኮ ኤማቶ፥ ኤትራ ሰያቶና ላካሶ፥ አያናኮ ካኡሙላመ ዱባና ሂካማሌያ” አመ አባበ።<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />ንቆድሞሳና “ሂክ ምሲ ሊን ዳንዳራ?” አመ ሆሳተ።<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />የሱሳና “አት እስራኤል ካአጋልስሳቶ” ሌተ ግራን ሂካ አየስ ላካሶያ? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />አን ሩምና ሩምና አማራ፥ ካካንሶ አዬስናና፥ ካዴነኖ አቶትናና፥ እስን አዴን አቶታኖካንና ላኮአታታን። <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />ጋራ ካኡሌክ አየስ አን እስኑን ጎሰግሮ አማናታና ካዋተታን፥ ካዳሩረ አየስ ጎሰጌ ምሲ አማናይናታን? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />ዳሩርኮ ካዳገሮ ኤረ ካእባዶ ኳሬ፥ ዳሩር ቶስ ካቤራ ማዮና ላግሮ አመ አባበ።<note caller="+" style="f"><char style="fr" closed="false">3፡13 </char><char style="ft" closed="false">ዳሩርኮ ካዳገሮ ኤረ ካእባዶ ኳሬ ዳሩር ቶስ ካቤራ ኮና ላግሮ “ኮኮ ካሆርኮ ማጻፋል” ዳሩር ካግሮ ኤረ ካእባዶ ኳሬ አማራ። </char></note><verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />ሙሴ ቃሉላቶክ ኡሊ ሀበሳ ጎጎሱየረ ማለ፥ ኤረ ካእባዶና ኡሱማሌ ሱዋምን ዶትሳራ። <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ህክና ኡሱ ካአማነ ዱባ ጅሩ ጅሮማክ ግር ጎጎግሮንያ።<note caller="-" style="x"><char style="xo" closed="false">3፡15 </char><char style="xt" closed="false"><ref loc="NUM 21:9">ቶቶ 21፡9</ref>። </char></note><verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />“ኡሱ ካአማነ ዱባ ጅሩ ጅሮማክ ግር ጎጎግሮን ኳሬ ጎጎባኖንኮ ዋ ኤረ ኮ ታስስሮ አላም አዳ. ጌላተራ። <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />ዋ ኤረኬሳ አላም ቶስ ካኮን ፋረራ አላም ጉት ፍርድን ሀሌኖን ግራን፥ አላም ኡሱይ ጎጎፋይሮንያ። <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />ኡሱ ካአማናራ ዱባ ላኮፍርዳማሮ፥ ኡሱ ካአማኖን አደ ኮ ኤረ ካዋክ መገ ማንኮ አማኖን ግሮ ማራን፥ ጣየዋ ፍርዳመራ። <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />ፍርዳና ሂካያ፥ ኢፋ አላም ቶስ ኤመተ፥ እባዶ አደ ፈሎኦትሶ ኦሜላን ማንኮሌን ማራን፥ ኢፋኮ ሮርሳቴ ሙጉድ ጌላተ። <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />ታሜላን ካፈላራ ዱባ ኢፋ ዲዳራ፥ ፈሎ ኦሜላን ኦቴሳ ጎጎሙቶንኮ ኢፋ ቶስ ላኮኤሜታሮ። <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />ሩሚ ካሰሴታራ አደ ፈሎ ዋይ ኦፈላመራን ላኖ አዴሳም ሙትን ኢፋ ቶስ ኤመታራ።”<verse eid="JHN 3:21" /></para>
  <para style="s1">ካጣማቃረ ያንሳ ጋራ ካየሱሳ አቶቴ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />ኤሰኮ አባባተረ የሱሳና ኡሱኮ ኦአጋልሳታረና ኡል ካይሁዳ ሴተን፥ ኤሴና እሶ ጣማቃ አባራን አዳላተ። <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />ሀሱ ጎራታ ያንሳ ሳለም ዶሌ ሄኖን ታአማማቶ ባንኤ በከ ኦንጂን ማንኮግሬን ማራን፥ ጣማቃ ግረ፥ እባዶና ጣማቃምን ኤመታ ግረ። <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />ህክና ካሌራ ያንሳ ሀሻሞን ግራንየ።<note caller="-" style="x"><char style="xo" closed="false">3፡24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ. 14፡3</ref>፤ <ref loc="MRK 6:17">ማር. 6፡17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3፡19-20</ref>። </char></note><verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />ኮኮ ያንሳኮ ኦአጋልሳታረና አይሁድ ኦሮ ሁሩፋማኖኮክ ሴራ ዶጋማ ኬተ።<note caller="+" style="f"><char style="fr" closed="false">3፡25 </char><char style="fqa" closed="false">አይሁድ፦ </char><char style="ft" closed="false">ኮኮ ካሆርኮ ማጻፋል አይሁድ ዉጫሪይ አማራ።</char></note> <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />ያንሳኮ ኦአጋልሳታረን ያንሳ ቶንሳ ኤሜተነን፥ “ካአጋልስሳቶ፥ ዮርዳኖስኮ ጋማ ኩኔ ዎታ ካግረ፥ ጋራኬሳና አት ካኮንአቶቲተታ እባዶት፥ ሂክማ ጣማቃራ፥ እባዶ ዱባ ኡሱ ቶስ ሴታ ግራ” አመን።<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />ያንሳና፥ “ዋኮ ጎስሳመ ኳሬ ማዮና ኮና አታይን ላኮዳንዳሮ አመ አባበ። <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />‘አን ላኮክርስቶሳዮ፥ አየሱን ጎአመን ኡሱኮ ሆረነ ፋራመራ’ ካአመሮ እስን መተክስኒዋ አቶትናታን።<note caller="-" style="x"><char style="xo" closed="false">3፡28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">ያን. 1፡20</ref>።</char></note> <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />ማሻሸ ካኮን ግታ ኡሱ ካማሻሼያ፥ ያየ ማልን ዶሌ ካአላራ ሳት አደ፥ ያየ ታማሻሼ ጎማሎ ኣሎ ገጌላታራ፥ ሃንሱን ሀሴ ገገላንጀት፥ ግዳ ጉዳተታ። <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />ኡሱ ጦቂ ጦቂ አምን፥ አን አደ የራይን ዶትሳራ አመ አባበ።<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />“ኤለኮ ካኤመታራ ዱባንኮ ካንጂንክያ፥ ኡልኮ ካሌራ ካኡሌያ፥ ታኡሌና አዬሳራ፥ ዳሩርኮ ካኤመተራ ዱባንኮ ካንጂንክያ። <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />ኡሱ ካዴሮና ካማለሮ አቶታራ፥ አየሱን ጎአመን አቶናትኬሳ ማዮና ላኮአታታሮ። <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />አቶናትኬሳና ካአታተረ እባዶ፥ ዋ ካሩም ላኖ አዴሰ። <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />ዋ አያናኬሳ ጂናሰ ማንኮስሳሮ ማራን፥ ዋ ካፋረራ ኡሱ ሃፉራ ካዋ አዬሳራ። <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />ኦዶ ኤረኬሳ ጌላታራ፥ ካመን ዱባና ገነቴሳ ስሰራ።<note caller="-" style="x"><char style="xo" closed="false">3፡35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">ማቶ. 11፡27</ref>፤ <ref loc="LUK 10:22">ሉቃ. 10፡22</ref>።</char></note> <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />ኤረኬሳይ ካአማናራ ዱባ ጅሩ ጅሮማክ ግር አባ፥ ኤረኬሳ ካአማኖን አደ ኤንገ ታዋ ኡሱ ጉት ላታ ኳሬ ግር ላኮሄላታሮ።”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s1">የሱሳ ታሳማራውት ሄለልትቲ ቶ ዎታ አዬሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />ካፋራሳው እባዶ ያንሳኮ ሮረ የሱሳ ኦሞጋን ኡሱኮ ኦአጋልሳታራን ኤካሳኖና ጣማቃኖ ማለን።<verse eid="JHN 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 4:2" />አየሱን ጎአመን ካጣማቄራ የሱሳ ሀሌኖን ግራን ኡሱኮ ኦአጋልሳታረንያን። <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />የሱሳና ሂካ ጎጎአዴሰ ኡል ካይሁዳ ኢሰረ ጋሊላ ቶስ አባባተ ሴተ። <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />ኤሰራ ሴታ ግራን ሳማርያ ኦሮነ ሮራኖ ዶትሳረ።<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />ሃንሱን ሳማርያነ፥ ያይቆባ ኤረ ኬሳ ዮሴፋን ታኮስሰሮ ባንኤ ዶሌ ታግቶ ስካር ታአማማቶ ካታማ ቶስ ኤመተ።<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="GEN 33:19">መጣ 33፡19</ref>፤ <ref loc="JOS 24:32">ኢያ. 24፡32</ref>።</char></note> <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />ኤሴና ካያይቆባ ጉምቢ ካበከ ግረ፥ የሱሳና ሰሴታንኮ ካከይ ሀረ ማንኮ ግረ ማራን ጉምቢ ካበከ ዶሌ ሀማጼ፥ ጎራታና አርኮ ሳቲ ሌክ ጎራታየ።<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />ሄለልትቲ ቶ ታሳማራውት በከ ሁሙሳይን ካኮኤማተ ጎራታ የሱሳ፥ “እን በከ ጣምስና” አመ። <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />የሱሳኮ ኦአጋልሳታረን ባቦ ኢምናይን ካታማ ቶስ ሴተን ግረን። <verse eid="JHN 4:8" /><verse number="9" style="v" sid="JHN 4:9" />ኤሰ ሳማራውትና፥ “አት አይሁድት ሌተ ግራን፥ እን ሳማራው ሄለልትቲነ ምሲ በከ ጣምስን አማታ?” አንተ፥ ሂካ አማኖና አይሁድን ሳማራውጆልነ ዎታ ኤሴላ ማንኮግኖን ማራንየ።<note caller="-" style="x"><char style="xo" closed="false">4፡9 </char><char style="xt" closed="false"><ref loc="EZR 4:1-5">እዝ. 4፡1-5</ref>፤ <ref loc="NEH 4:12">ነህ. 4፡12</ref>።</char></note><verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />የሱሳና አባበረ፥ “እላቦ ካዋ አዴሰዋ እን በከ ጣምስ ካአማራ አዮዮ አዴስ ግቴዋ አትዋ ኡሱኮ ሆሳተዋ፥ ኡሱና በከ ኦግር ኩን ስሳረዋ” አመ።<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />ሄለልትቲና ሃ አንተ፥ “ጎታክ፥ አት ካኮሁሙስና ላኮአብቶ፥ ጉምቢና ኬልዶክያ፥ ሀያ ሂናኣ በከ ኦግር ኤትኮ ሄልናታ? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />አየሱን ጎአመን፥ አት ሂካ ጉምቢ ኖን ካስሰሮ ኣቦካን ያይቆባኮ ሮራታ? ኡሱና ይስኬሳ፥ ግድኬሳና ሂካ ጉምቢኮ ጣሜናን፥” አንተ።<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />የሱሳና “ሂናኣ በከኮ ካጣማራ ዳንበ ሱጉባይናራ፥ <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />አን ኦስሳሮ በከኮ ካጣማራ አደ ሱረዋ ላኮሱጉባሮ፥ አን ኦስሳሮ በከ ካጣማራ እባዶ ጅሩ ጅሮማን ካፉልታሮ ካግር በከኮክ ፉልቶ ላራ” አመ አባበ።<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />ሄለልትቲና፥ “ጎታክ፥ አን ጎጎሱጉባኖንኮና በከ ሁሙሳይን ጎጎሰሴኖንኮ፥ ማጋኔ ሂናኣ በከ ኢን ስስ” አንተ።<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />የሱሳና፥ “ሴዴ ኤንተርካ ኡም ኮይ አመ።”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />ሄለልትቲና፥ “አን ኤንተር ላኮአቦ” አንተ አባብቴ።</para>
  <para style="p" vid="JHN 4:17">የሱሳና፥ “ኤንተር ላኮአቦ አማኖ ጋራያ። <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />ኦግራን ኤንተር ከን ኩን ካግረ፥ ግዳ ኩኔ ዎታ ካግራና ኤንተርካ ማንኮሌኖን ማራን፥ ካአዬሰታ ሩምያ” አመ አባበ።<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />ሄለልትቲና፥ “ጎታክ፥ አት ካሄገሮ ላኖ ግዳ አን አዴሰ። <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />ኦዶላልካን ህታ ዎዳም ጉት ሳጋደን፥ እስን አይሁድ አደን እባዶ ሳጋድን ካኮንዶትሳራ ኢየሩሳለምያ አማታን” አንተ።<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />የሱሳና፥ “አት ሄለልትቲ፥ ህታ ዎዳሚ ሌረ ኢየሩሳለምና ኦዶን ካኮሳጋዶን ጎራታ ኤመታ ግራኖ አማን። <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />እስን እባዶ ካሳማርያ ካካሶቱን ሳጋዳታን፥ ኖ አንዴ ፋይና አይሁድኮ ማንኮሌሮ ማራን ኖ ካካንሶን ሳጋዳና። <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />ሩሚ ኦሳጋዳራን፤ ኦዶን አያናና ሩሚ ካኮሳጋድራን ጎራታ ኤመታራ፥ ግዳና ኤመተራ፥ ኦዶና ሂካማሌ ሩሚ ኦሳጋዳራን ዶታራ። <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />ዋ አያናያ፤ ኦሳጋዳራና አያናና ሩሚ ሳጋዳኖ ዶትሳራ” አመ።<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />ሄለልትቲና፥ “ክርስቶሳ ካአማማራ ካሽግዳመ ኤመይን ግራኖ ካሶዋ፥ ኡሱ ጎኤመተ አየስ ዱባ ኖን ሰግናራ” አንተ።<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />የሱሳና፥ “ካአዬስሳራ ሀያ አን ኡሱዮ” አመ አዴስሰ ጋራኬሳ ኤሰን ሰገ።<verse eid="JHN 4:26" /></para>
  <para style="s1">ሳማራውትኮክ አቶናት</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />ኡሱ ጎራታ የሱሳኮ ኦአጋልሳታረን አባባተን ኤመተን፥ ኡሱ ሄለልትቲነ ዎታ አዬሳ ግራን ዴንጉሬን ሳደን፥ ጎሌና አደ፥ “መ ዶታታ?” ጎርቱን፥ “ኤሰ ዎታ ካኮንአዬሳታ መዉንያ?” አመ ኡሱ ካሆሳተራ ማዮና ላግረ።<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />ሄለልትቲና ኡላ ኢሰደ ካታማ ቶስ አባባተ፥ ጎሳና፥ ሃ አንተ። <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“አን ካፈለሮ ዱባ እን ካሰገሮ እባዶት ኮዬን ዲያ፥ ኡሱ ክርስቶሳ ሌዉና?” አንተ። <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />እሶና ካታማኮ ቤሬነ ኡሱ ማንኮግሮ ቶስ ሴተን።<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />ኡሱ ጎራታ የሱሳኮ ኦአጋልሳታረን፥ “ካአጋልስሳቶ፥ ባቦ አም” አመን።<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />ኡሱ አደ፥ “እስን ካካሶን አን ካአማሮ ባቦ አባ” አመ።<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />ኡሱኮ ኦአጋልሳታረና፥ “እባዶ ኡሱን ባቦ ኬን ግሮ?” አማ እስሮ አዬሴን። <verse eid="JHN 4:33" /><verse number="34" style="v" sid="JHN 4:34" />የሱሳና፥ “ባቦ ካክ እን ካፋረሮኮት ፈኢ ፈላኖና ፈሎ ኦቴሳ ጉድሳኖያ። <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />እስን፥ ‘ድግኒ አፋርኮ ሃሬ ዉጣ ግያራ’ ላ አማታና? ሂክማ፥ ዉጣ ኩኩምን ጋባላማኖ ‘ጦቂ ማዴነ እራ ዲያ’ አመ። <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />ካታጋታራ ግዳና ጎሌ ዳሞዛ ካአታተያ፥ ጅሩ ጅሮማክ ግርን ታሌቶ ኢል ኩኩይሳታራ፥ ህክና ካዉጣተራና ካታካታራ ዎታ ጎጎገገላናዉንያ። <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />ሃንሱን፥ ‘ኮ ዉጣታራ፥ ካካለ አደ ታጋታራ’ ካአማመራ ማሱሳ ሩምያ። <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />ካንዳፉሮን ግታን ጎጎታጋታዉን ፋረራ፥ ካካለ ፈሎይ ሀረ፥ እስን አዴን ዳፉርክሶት ኢል ኩኩይሳቴን” አመ።<verse eid="JHN 4:38" /></para>
  <para style="s1">ካሞጋን ካሳማራው እባዶ ዋይ አማነ</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />ሄለልትቲ፥ “አን ካፈለሮ ዱባ ኢን ሰገ” አንተ ማንኮ አቶቲተ ማራን ኤሰ ካታማኮ ካሞጋን ካሳማራው እባዶ ኡሱ አማነ። <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />ሃንሱን፥ ካሳማራው እባዶ የሱሳ ቶስ ታኮኤመተሬ የሱሳና እሶ ዎታ ጎጎአዳላሮን አታይሰን ኡሱ ኤባተን፥ ኡሱና አሪ ላማ ኤሰ አዳላተ።<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />ሃፉራኬሳኮና ካከይ ካካለ ካሞጋን እባዶ አማነ።<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />ሄሌልትቲነና፥ “ጎርታ ኖ ኡሱ ካኮን አማናና አት ኖን ማንኮ ሰግተ ካላዉን ላኮዮ፥ ኖ እሲዋ ማልነና፥ ሂክ እባዶት ሩምና አላም ካፋይሳሮ ላኖ ካንሶዋ” አመን።<verse eid="JHN 4:42" /></para>
  <para style="s1">የሱሳ ኤረ ካሹም ፋይሰ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />የሱሳ አሪ ላማኮ አባባተረ ጋሊላ ቶስ ሴተ። <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />“ካሄገሮ ኡልኬሳ ላኮካባጃማሮ” አመ የሱሳ እሲዋ አዬሰ ግረ።<note caller="-" style="x"><char style="xo" closed="false">4፡44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">ማቶ. 13፡57</ref>፤ <ref loc="MRK 6:4">ማር. 6፡4</ref>፤ <ref loc="LUK 4:24">ሉቃ. 4፡24</ref>።</char></note> <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />ጋሊላ ጎጎጌይና ካጋሊላ እባዶ ገጌላንጄ ኡሱ አታተ፥ ኣላንቲና፥ እሶ ካፋስካ ባላ ኢየሩሳለም ማንኮ ግረ ማራና ኤሰ ካፈለሮ ዱባ ማንኮ ዴራን ማራንያ።<note caller="-" style="x"><char style="xo" closed="false">4፡45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">ያን. 2፡23</ref>።</char></note><verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />የሱሳና በከ ጣሞ ካዎይኒ ቶስ ታኮኢግልሰሮ፥ ጋሊላ ታግቶ ቃና ካታማ ቶስ ካላም ኤመተ፥ ቅፍረናሆምና ኤረ ካኮንሀዉኣመረ ኮ ምን ካዎኖኮክ ሹሚ ግረ።<note caller="-" style="x"><char style="xo" closed="false">4፡46 </char><char style="xt" closed="false"><ref loc="JHN 2:1-11">ያን. 2፡1-11</ref>።</char></note> <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />ሂክ እባዶትና የሱሳ ይሁዳኮ ጋሊላ ቶስ ኤመታኖ ካኮማላረ ጎራታ፥ ኡሱ ቶስ ሴተረ ሀዉኣመረ ጎይ ህኢ ካግሮ ኤረኬሳ ኤሜይ ጎጎፋይስሮ ኤባተ። <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />የሱሳና፥ “ማጎሬና እስን ማላታና ባሳክ አየስ ጎዴኖን ላኮአማናታን” አመ።<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />ሹምትና፥ “ጎታክ፥ ኤረክ ጎዋኖኮ ሆረነ ማጋኔ ጌና” አመ።<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />የሱሳና፥ “ኤረካ ኔፎ ግራ ሴ” አመ፥</para>
  <para style="p" vid="JHN 4:50">እባዶትና የሱሳ ካአዬሰሮ ሃፉራ አማነ ሴተ። <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />ራድ ግራንቱና ኦሀንዳረን ኡሱ ሄሌረን፥ “ኤረካ ፋዬራ” አመን ኡሱን ሰገን።<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />ኡሱና ኤረኬሳ ሳቲ ምያይ ኢደሮ ጎሆሳሮ፥ “ማር ጉባኖና ኡሱ ካኮጋፋረራ ከለ ሳቲ ቶዶባይያ” አመን። <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />ካኡኑት ኦዶና የሱሳ፥ “ኤረካ ኔፎነ ግራ” ታኮአመሮ ሳቲ ላኖ አዴሰ፥ ኡሱና ካምነ እባዶ ኬሳ ዱባ የሱሳ አማኔን።<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />ህክና፥ የሱሳ ይሁዳኮ ጋሊላ ቶስ ኤመተ ካፈለሮ ካላምክ ባሳክ ማላታየ።<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s1">ቤተሳይዳ ካፈላመሮ ፋይና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />ኤሰኮ አባባተረ ካአይሁድ ባላ ማንኮ ግረ ማራን፥ የሱሳ ኢየሩሳለም ቶስ ቤ። <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />ኢየሩሳለምና፥ ካእዳድ ኡፋ ዶሌ፥ ካራ ከን ጉንተ ካሳራመ ካኮሰሴታራን ታአብታ፥ ሄኢ ታአራማይኪ ቤተሳይዳ ታአማማተ ባንኤ ካኮጣማቃራን ካፉልቶ ኤላ ኮ ግረ።<note caller="+" style="f"><char style="fr" closed="false">5፡2 </char><char style="ft" closed="false">ቤተሳይዳ፦ ኮኮ ካሆርኮ ማጻፋል ቤተዛታ ካካለ አደ ቤተሄስዳ አማራ፤ ፉረንና ምን ካሻጋ አማኖያ።</char></note> <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />ሂካ ካኮሰሴታራን ራጆሊ ካሞጋን ናፋለሳል፥ ኢልኦ ካድያኖን፥ ኦኤሳራና ናፋለሳል ሁዱረን ግረን። [በከኮክ አአኖና ኦራታ፥ <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />ሮረ ሮረ ኤርግቻ ካዋ ዳገ በከ ካኮአኢሳሮ ጎራታ፥ ጣየ ኤላ ቶስ ካታበ ካአቦ ኩባ ማምስክኮና ፋያ ግረ።]<note caller="+" style="f"><char style="fr" closed="false">5፡4 </char><char style="ft" closed="false">ካሆርኮ ማጻፋል ቶቶ 3 ጋቾኮ ሀጋአበረ ታ ቶቶ 4 ጋቾ ጌሮን ካግሮ ላኮአዳሮ።</char></note> <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />ኤሴና ጌስ ሶንዶምኮ ስዴዱን ኩባሌሳ ሌ ካግረ እባዶት ኮ ግረ። <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />የሱሳና ሂካ እባዶት ኤሰ ካሁዱረሮ ዴጉረ፥ ጎራታ ካሞጋኑን ሂካ ማለ ግራኖ አዴሰረ “ፋይን ዶታታ?” አመ።<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />ኩባሌሳትና አባበረ፥ “ጎታ! በከ ካኮአኢራን ጎራታ ኤላ ቶስ እን ካዳግስሮ እባዶ ላኮአቦ፥ አን ታብን ጎሄድሮ ካካለ ሆረሃራ” አመ።<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />የሱሳና፥ “ክ! ታኮሁዱርተቶ አልጋታ ስዳዴ ጋል” አመ። <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />እባዶትና ጎርሰዋ ፋዬ፥ ታኮሁዱረረ አልጋና ስዳተ ጋለ።</para>
  <para style="p" vid="JHN 5:9">ህክና ካሌራ አይሁድን ታፎልሲ አሪየ፥ <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />አይሁድን ኦዶናት ኦአባና ካፋዬሮ እባዶትነ፥ “ታፎልሲ አሪ ማንኮሌተ ማራን ታኮሁዱርተቶ አልጋታ ጎጎስዳቶን ሴራ ኩን ፈኢ ላኮስሳሮ አመን።<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="NEH 13:19">ነህ. 13፡19</ref>፤ <ref loc="JER 17:21">ኤር. 17፡21</ref>። </char></note>”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />ኡሱ አደ፥ “ኣንክ እን ካፋይሰራ እባዶት፥ ‘ታኮሁዱርተቶ አልጋታ ስዳዴ ጋል’ አመራ” አመ አባበ።<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />እሶና፥ “ታኮሁዱርተቶ አልጋታ ስዳዴ ጋል ካአመራ ኡሱ አዮያ?” አመን ሆሳተን።<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />የሱሳና ፋክመ ሴተ ጎሳ ኦሮ ታበ ማንኮግረ ማራን፥ እባዶትና ማዮ ኡሱ ፋይሰሮ ላኮአዴሰሮ።<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />ኤሰኮ አባባተረ የሱሳ ኡሱ እባዶት ምን ካኤብ ኦሮ ሄለረ፥ “ሂክማ፥ ፋይተታ፥ ሂካኮ ካሮረ አየስ ኩ ጎጎጌኖንኮ ሂታኮ ዳንቤባን አድ ጩቦ አሮፈልተ” አመ። <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />እባዶትና ኡሱ ካፋይሰራ የሱሳ ላኖ ሴተ አይሁድን ሰገ።<verse eid="JHN 5:15" /></para>
  <para style="s1">ኤረ ካዋ ኔፎ ስሳራ</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />አይሁድን ኦዶናት ኦአባን፥ ታፎልሲ አርትሶይ ሂኒዕ ፈሎ ፈላማኖይ፥ የሱሳ ሆሮራኖ ሀጋአበን። <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />የሱሳና፥ “ኦዶክ ግዳግን ፈላ ግራ፥ አንና አድ ፈልናራ” አመ።<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />ጎርታ አይሁድን ኦዶናት ኦአባን፥ የሱሳ ታፎልሲ አርትሶ ማንኮኢግልሰ ካላዉን ሀሌኖን ግራን ዋ ኦዶ የላተ፥ እስኦቴሳ ዋኔታ ኤካ የላታኖይ፥ ላጋዲን አታይሰን ዶታ ግረን።<verse eid="JHN 5:18" /></para>
  <para style="s1">ኤረ ካዋኮክ ኦዶናት</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />የሱሳና፤ “አን ሩምና ሩምና አማራ፥ ኦዶ ፈላ ግራን ካዴሮ ካላል ኳሬ ኤረ ካለ እስኮ ኮና ፈልን ላኮዳንዳሮ፥ ኦዶ ካፈላሮ ዱባ ኤረ ካዋ አደ ፈላራ። <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />ኦዶ ኤረ ማንኮጌላታሮ ማራን ኡሱ እሲ ካፈላሮ ዱባ ቱሳራ፥ ጎጎሳዳዉና ሂካኮ ካሮረ አየስ ቱስሮዋ። <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />ኣላንቲና ኦዶ ካጎየ ጎጎኬሳሮ ማለ፥ ኔፎና ጎጎስሳሮ ማለ፥ ኤረ ካዋና አደ ካዶታተ ዱባን ግር ስሳራ። <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />ኦዶ ማዮ ጉቲና ላኮፍርዳሮ፥ አየሱን ጎአመን ፍርዳ ዱባ ኤረኬሳን ሮርሰ ስሰራ። <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />ህክና፥ ኦዶ ጎጎካባጃና ማለ ዱባ ኤረኬሳና ጎጎካባጂናዉንያ፥ ኤረ ካዋ ካካባጂኖን፥ ካፋረሮ ኦዶና ላኮካባጃሮ።<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />“አን ሩምና ሩምና አማራ፥ ሃፉራኬ ካማላራ፥ እን ካፋረሮና ካአማናራ ጅሩ ጅሮማክ ግር አባ፥ ጎይኮ ግር ቶስ ናቀራ ኳሬ ፍርዳ ቶስ ላኮኤሜታሮ። <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />አን ሩምና ሩምና አማራ፥ ካጎየራ እባዶ ኤረ ካዋኮት ያየ ካኮማላን ጎራታ ኤመታራ፥ ጎራታና ግዳያ፥ ኦማላራና ኔፎ ግርናና። <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />ኦዶ እሲዋ ካግር ፉልቶ ጎጎሌሮ ኡሱማሌ፥ ኤረኬሳና መተኬሳዉን ካግር ፉልቶ ጎጎሌሮን የለራ። <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />ኡሱና ኤረ ካእባዶ ማንኮሌ ማራን ፍርዳ ጎጎፍርዲሮን ኦዶናት ስሰራ።<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28" />“ሂካኒ አሮሳዴን፥ ቃማላሜን ኦግራን ዱባ ያየቴሳ ካኮማላን ጎራታ ኤመታራ። <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />ታኢዳን ኦፈሌራን ግርኮክ ክያኖን፥ ታሜላን ኦፈሌራን አደን ኪረነ ፍርዳ አታይናራን አመ።<note caller="-" style="x"><char style="xo" closed="false">5፡29 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳኔ. 12፡2</ref>።</char></note>”<verse eid="JHN 5:29" /></para>
  <para style="s1">ጋራ ካየሱሳ ካስሳመሮ አቶናት</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“አን ካለ እስኮ ኮና ፈልን ላኮዳንዳሮ፥ አን ካፍርዳራ ካማላሮ ካላያ፥ እን ካፋረሮኮት ፈኢ ኳሬ ፈኢቴ ማንኮ ዶታኖን ማራን ፍርዳክ ጋራያ።<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“አን እስኦቴዉን ጎአቶቴ፥ አቶናትክ አታማኖ ላኮአቦ። <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />እን ማራን ካአቶታራ ካካለ ግራ፥ ኡሱ እን ማራን ካስስናራ አቶናት ሩም ላኖ አን ካሶዋ።<verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />“እስን ያንሳ ቶስ ፋርቴተን፥ ኡሱና ጋራ ካሩም አቶቴራ።<note caller="-" style="x"><char style="xo" closed="false">5፡33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">ያን. 1፡19-27</ref>፤ <ref loc="JHN 3:27-30">3፡27-30</ref>።</char></note> <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />አን አቶታኖ ካእባዶ ካአታታሮ ላኮዮ፥ አን ሂካ ካኮንዬሳራ አደ እስን ጎጎፋይታዉንያ። <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />ያንሳ ቤባ ኢፋ ካስሳሮ ኮሮንታ አንየ፥ እስና ጎራታ ክጫሩን ኢፋኬሳይ ገጌላይን ዶታቴን።<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />“አን አደ ካያንሳ አቶናትኮ ካሮረ አቶናት አባ፥ ጎጎጉድስሮን ኦዶ ኦስሰራ፥ አንና ኦፈላራ ፈሎ ኦዶ እን ፋራኖ አቶታራን። <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />እን ካፋረራ ኦዶ ኡሱዋ ጋራኬ አቶቴራ፤ እስን አዴን ያየቴሳ ሱረ ላኮማልተታን፥ ምዲቴሳና ሱረ ላኮዴቴታን።<note caller="-" style="x"><char style="xo" closed="false">5፡37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ. 3፡17</ref>፤ <ref loc="MRK 1:11">ማር. 1፡11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፡22</ref>።</char></note> <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />እን ካፋረሮና ማንኮአማናና ዋተን ማራን ሃፉራኬሳ እስኒ ላኮግሮ። <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />እስን ማጻፋ ቁሉኪና ጅሩ ጅሮማክ ግር ኦሄላይናታን ኣን ማንኮላሮ ማራን ማጻፋል ቆቆራታን፥ ሂክ ማጻፋና ጋራኬ ካአቶታሮያ፤ <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />እስን አዴን፥ ኔፎ ግርን እን ቶስ ኤመይን ላኮዶታታን።<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“አን እባዶኮ ካባጃ ላኮዶታታሮ፤ <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />አየሱን ጎአመን አን እስን ካሶዋ፤ ጌላንጀ ታዋና ዎዳናትስኒ ኦሮ ግርዋት አን ካሶዋ። <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />አን ኣቦኬክ መገ ኤሜየ እስን ጎአመን እን ላኮአታቴታን፤ ካካለ መገኬሳ ኤመተዋ አታታቴንዋ። <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />እስን እስእስ ኦሮ ካባጃ ኦስሳታን፥ አየሱን ጎአመን ዋ ኮኮ ታኤማቶ ካባጃ ኦዶታኖን ጎሌተን፥ ምሲ አማንን ዳንዳታን?<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />“ካሞታራክስን አብድ ካኮንሉጉዳቴታን ሙሴ ኳሬ፥ አን ኦዶ ሆረ እስን ካሞታሮ አን አሮሌኖ፤ <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />ሙሴ ካአማናታን ሌቴንዋ፥ እን አማናቴንዋ፤ ኣላንቲና ኡሱ ካጻፈራ ጋራኬያ። <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />ኡሱ ካጻፈሮ ጎአማናኖን፥ አን ካአዬሳሮ ሃፉራኬ ምሲ አማንናታን?” አመ።<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s1">የሱሳ እባዶ ኩማ ከን ኣምሰ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14፡13-21</ref>፤ <ref loc="MRK 6:32-44">ማር. 6፡32-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፡10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />ሂታኮ ዳንበኔ የሱሳ ጥብራዶስ ታአማማተ ታጋሊላ ላቡኮ ጋማ ናቀረ ላቡ ግርነ ሴተ። <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />እባዶ ካሞጋና ኩባሌሳል ፋይሳ ካፈለሮ ባሳክ ማላታጆል ማንኮዴራን ማራን ዴበ ሰሴተን። <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />ኤሰኮና የሱሳ ዎዳም ቶስ ቤረ ኡሱኮ ኦአጋልስሳራነ ዎታ ሀማጼ። <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />ካአይሁድ ፋስካ ባላና ጋባላመ ግረ። <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />የሱሳና ጦቂመ ጎሳ ካሞጋን ኡሱ ቶስ ኤመታ ካግሮ ዴረ፤ ፍልጶሳነ፥ “ሂክ እባዶ ጎጎአምሮን ባቦ ኤትኮ ኢምና?” አመ። <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />ሂካ ካኮንሆሳተራ ኡሱ ጫፍንያ ኳሬ ኡሱ ኡሱን ፈልን ካሄደረ ካሳናየዋ።<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />ፍልጶሳና፥ “መተመቴ እባዶ ክጫር ክጫር ጎጎቃማስሮን የልን፥ ዲናራ ላማ ቦሌክ ቡዴና ላኮሌሮ” አመ አባበ።<note caller="+" style="f"><char style="fr" closed="false">6፡7</char><char style="fqa" closed="false">ዲናራ፦ </char><char style="ft" closed="false">ፈላተ ካባራሮን አሪ ቶት ሙራታ </char></note><verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />የሱሳኮ ኦአጋልሳታረንኮ ኮ፥ ካስሞና ጴጢሮሳኮክ አቢ እንድራሳና ሃ አመ፤ <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“ካሀኡሬ ባቦ ከና ኩኑኡብ ላማ ካአበራ ኡኑ ኮ ህታኒ ግራ፥ ሂክ አደ ሂካ ጎሳ ዱባን ምሲ ጌግናራ?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />የሱሳና፥ “እባዶ ጎጎሀማጽሮን የላ” አመ፥ ኤሰ ባንኤ ኤስ ካሞጋን ግረ፥ እባዶና ሀማጼ ቶቶኦትሶና ኩማ ከን ካሌሮየ። <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />የሱሳ ባቦ ከን ኬሰ ጋላቴ ካኮ አባባታረ ጎራታ፥ ካሀማጼሮ ጎሳን ሄደደን፥ ኩኑኡብና ኡሱማሌዋ ሄደደን ዱባና ካዶትሳሮ ግታክ ሄላቴን። <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />ዱባ ኣመ ካኮባራራረ ጎራታ፥ የሱሳ ኡሱኮ ኦአጋልሳታረነ፥ “ታሄሰቶ ሀንባኮ ቶና ጎጎዳርአሞንኮ ኩኩይሳ” አመ። <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />እሶና፥ ካኣማመሮ ካሀኡሬ ባቦ ከንኮ ታሄሰቶ ሀንባ ዱጉድ ቶሞንኮ ላማ ኩኩይሴን አማጌን።<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />እባዶ የሱሳ ካፈለሮ ባሳክ ማላታ ካኮድያረን ጎራታ፥ “አላም ቶስ ካኤመታራ ካሄገሮ ኦግራን ሂካያ” አመን። <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />የሱሳና እባዶ ኤመይረ ሁና ኡሱ ዎኖ የላይን ቆፓኖክሶ አዴሰረ አደና ካለካለ ዎዳም ቶስ ሴተ።<verse eid="JHN 6:15" /></para>
  <para style="s1">የሱሳ በከ ጉት ሰሴታ ሴተ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ. 14፡22-33</ref>፤ <ref loc="MRK 6:45-52">ማር. 6፡45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />ኡል ሄመን ካኮላረ ጎራታ ኡሱኮ ኦአጋልሳታረን ላቡ ዳጌን። <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />ዎላቦና ኮራተኔ ቅፍረናሆም ቶስ ናቅን ኬን። ጎራታና ሄመን ሌረ፥ የሱሳና ጋና እሶ ቶስ ላኮኤመተረ። <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />አምባል ታአቲ ማንኮ ክያ ግቴ ማራን በከ ኬን። <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />ክሎ መትራ ከን ጎርቱን ሌ ዱዴን ግራን፥ የሱሳ በከ ጉት ሰሴታ ዎላቦ ቶስ ካኤሜታሮ ዴኔ አብሳተን። <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />የሱሳ አደ፥ “አንያ፥ አሮአብሳቴን” አመ። <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />እሶና ኡሱ ጎጎኮራሮ ዶታቴን፥ ዎላቦና ጎርሰዋ ማንኮ ሴታራን ጌተ ባጋ አባተ።<verse eid="JHN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />ታላም አሪ በከኮ ጋማነ ካሄሰራ እባዶ ኤሰ ዎላቦ ቶ ታላል ግራኖ አዴሰ፥ የሱሳ አደ ዎላቦይ ኮራታናዋትና ኡሱኮ ኦአጋልሳታረን ካለ ናቃኖና አዴሰ። <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />ኤሰኮ አባባተረ፥ ካካለ ዎላቦል ጥብራዶስኮ፥ ጎታ ካሶማሳተሮ ባቦ ጎሳ ማንኮ ኣመሮ ባንኤ ቶስ ኤመተ። <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />እባዶና፥ የሱሳ ጎርቱን ኡሱኮ ኦአጋልሳታረን ኤሰ ግራናዋት ጎጎአዴሴኒ፥ የሱሳ ዶታ ዎላቦሊ ታቤን ቅፍረናሆም ቶስ ሴተን።<verse eid="JHN 6:24" /></para>
  <para style="s1">የሱሳ ካግር ባቦያ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />በከኮ ጋማነ ኡሱ ካኮሄላሬን ጎራታ፥ “ካአጋልስሳቶ፥ አት ሂታራ ጎረ ኤሜተታ?” አመን።<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />የሱሳና፥ “አን ሩምና ሩምና አማራ እን ካኮንዶታታን ባቦ ማንኮአንቴን ማራና ማንኮባራርቴን ኳሬ፥ ማላታ ማንኮዴተን ማራን ላኮዮ። <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />ካባሮ ባቦን አሮፈልቴን፥ አየሱን ጎአመን ኤረ ካእባዶ ካስሳሮ ጅሩ ጅሮማክ ግር ካሌሮ ባቦን ፈላ፥ ህክና ዋ ኦዶ ካአዴስሳሮ ማታማ ኡሱ ጉት ካየራ።”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />እሶና፥ “ሀያ ፈሎ ኦዋ ፈልን መ የላኖ ዶትሳራ?” አመን።<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />የሱሳና፥ “ኡሱ ካፋረሮዪ ጎጎአማንታዉን፥ ሂኒዕ ፈሎ ኦዋያን” አመ አባበ።<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />እሶና፥ “ኖ ዲጉነ ኩ ጎጎአማኖን መ ማላታ ፈልናታ? መና የልናታ? አመን ሆሳተን። <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />ጎጎአምናዉን ዳሩርኮ ባቦ ስሰራ አማመ ጎጎጻፋመሮ፥ ኦዶላልካን ቃሉላቶክ ኡሊ ባቦ ካዳሩረ አመን።<note caller="-" style="x"><char style="xo" closed="false">6፡31 </char><char style="xt" closed="false"><ref loc="EXO 16:4">ብያ. 16፡4</ref>፤ <ref loc="EXO 15">15</ref>፤ <ref loc="PSA 78:24">ማዛ. 78፡24</ref>።</char></note>”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />ሃንሱን የሱሳና፥ “አን ሩምና ሩምና አማራ፥ ዳሩርኮ ባቦ ካስሳራ ላኮሙሴዮ፥ ካሩም ባቦ ዳሩርኮ ካስሳራ አደ ኦዶኬያ። <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />ባቦ ካዋ ኡሱ ዳሩርኮ ካዳጋሮና አላምን ግር ካስሳሮያ” አመ። <verse eid="JHN 6:33" /><verse number="34" style="v" sid="JHN 6:34" />እሶና፥ “ጎታ፥ ጎርታኑን ሂካ ባቦ አሪ ዱባ ኖን ስስ” አመን።<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />የሱሳና ሃ አመ፤ “ካግር ባቦ አንያ፥ እን ቶስ ካኤመታራ ዱዶ ላኮኡኢሮ፥ እዬና ካአማነ ሱረ ላኮሱጉባሮ። <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />አየሱን ጎአመን አን እስኑን ጎጎሰጌሮ፥ ዴተታን ግዳና ሱረ ላኮአማናታን። <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />ኦዶ ካስሳራ ዱባ እን ቶስ ኤመታራ፤ እን ቶስ ካኤሜታሮና ሱረ ሳርደሰ ላኮሆሮራሮ። <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />ዳሩርኮ አን ካኮንዳገራ ፈኢቴ ፈላይን አንሌኖን ግራን፥ ካፋረሮኮት ፈኢ ፈል ጉድስንያ። <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />እን ካፋረሮኮት ፈኢ፥ ካስሰሮ ዱባኮ ኮና ሀባኖን ግራን ታጋቾ አሪ ጎይኮ ጎጎኬስሮንያ። <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />ኣቦኬት ፈኢ ኤረ ደረ ኡሱይ ካአማናራ ዱባ ጅሩ ጅሮማክ ግር ጎጎግሮንያ፥ አንና ታጋቾ አሪ ጎይኮ ኬስናራ።”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />አይሁድና “ዳሩርኮ ካዳገራ ባቦ አንያ” አማኖኬሳን ጉምጉማኖ ሀጋአበን። <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />ሃና አመን፥ “ሂክ ካዮሴፋ ኤረ ላ የሱሳዮላ? ኣቦኬሳና ኣየቴሳ ላ ኖ ኦካንሶያና? ሀያ ግዳ ኡሱ ምሲ ‘አን ዳሩርኮ ዳገራ’ አማራ” አመን።<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />የሱሳና አባበ ሃ አመ፥ “እስ እስሮ አሮ ጉምጉምቴን። <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />እን ካፋረራ ኦዶ እስ ቶስ ጎአባበ ኳሬ ማዮና እን ቶስ ኤመይን ላኮዳንዳሮ እን ቶስ ካኤሜታሮ አንና ታጋቾ አሪ ጎይኮ ኬስናራ። <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />ካሄገሮልና፥ ‘ዱባ ዋኮ ኦአጋልሳቴን ሌራን’ አማመ ጻፋመራ፥ ኦዶ ካማላራና ኡሱኮና ካአጋልሳተራ ዱባ እን ቶስ ኤመታራ።<note caller="-" style="x"><char style="xo" closed="false">6፡45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">ኢሳ. 54፡13</ref>።</char></note> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />ዋ ዶለኮ ካኤመተሮ ኳሬ ኦዶ ካዴራ ኮና ላግሮ፥ ኦዶ ካዴራ ኡሱ ካላልያ። <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />አን ሩምና ሩምና አማራ፥ ካአማናራ ዱባ ጅሩ ጅሮማክ ግር አባ። <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />ካግር ባቦ አንያ። <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />ኦዶጆላልክስን ቃሉላቶክ ኡሊ ባቦ ካዳሩረ አመን ሀሌዎ ኳሬ ጎዬን። <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />አየሱን ጎአመን እባዶ ጎጎ ጎኖንኮ ጎጎአምሮን ዳሩርኮ ካዳገራ ባቦ ሂካያ። <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />ዳሩርኮ ካዳገራ አርዶክ ባቦ አንያ፤ ሂካ ባቦኮ ካአማራ ዱባ ጅሩ ጅሮማን ግራራ፤ አላምን ግር ጎጎሌሮን አን ካስሳራ ባቦ ሶኦተያን አመ።”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />አይሁድና፥ “ጎጎአምኖን ሂክ እባዶት ሶ ኦቴሳ ምሲ ስስን ዳንዳራ?” አማ እስ እስሮ አታይሰን ዶጋማኖ ሀጋአበን።<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />የሱሳና፥ አን “ሩምና ሩምና አማራ፥ ኤረ ካእባዶንኢ ሶ ጎአማናዋተን ኢግና ጎጣማናዋተን እስ ኦትስኑን ግር ላኮአብታን። <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />ሶኦቴ ካአማራ፥ ኢግኬና ካጣማራ ጅሩ ጅሮማክ ግር አባ፥ አንና ታጋቾ አሪ ኡሱ ጎይኮ ኬስናራ። <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />ሶኦት ካሩም ባቦ ኢግክና ካሩም ጣሞያ። <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />ሶኦቴ ካአማራ፥ ኢግኬና ካጣማራ እዬ ግራራ፥ አንና ኡሱ ግርናራ። <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />አርዶክ ኦዶ እን ጎጎፋረሮ፥ አንና ኡሱኮ ካከይ ግር ጎጎግሮ ማለ፥ ካአማራና ሂካማሌ እንኮ ካከይ ግር ግራራ። <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />ዳሩርኮ ካዳገራ ባቦ ሂካያ ኦዶላልክስን ካኣመራን ባቦ ኣንክክ ላኮዮ፥ ሀሱ ባቦ ኦአማራን አደን ጎዬራን፥ ሂካ ባቦ ካአማራ አደ ጅሩ ጅሮማን ግራራ።”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />ሂካ ካኮን አዬሰራ ካቅፍረናሆም ማማኒ አይሁድኮክ ምን ካኤብ አጋልስሳ ግራንየ።<verse eid="JHN 6:59" /></para>
  <para style="s1">ጅሩ ጅሮማክ ካግር ሃፉራ</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />ኡሱኮ ኦአጋልሳታረንኮ ኦሞጋን ሂካ ማለን፥ “ሂክ ካጫናቅስሮ ሃፉራያ፥ አዮያ አታይን ካዳንዳራ?” አመን።<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />ኡሱኮ ኦአጋልሳታረና ሂካ አዬሲ ጉምጉማኖ የሱሳ እሲዋ አዴሰረ፥ “ሂክ እስኑን ሀንዱዱፎ ሌሮ ማና? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />ሀያ፥ ኤረ ካእባዶ ጣየ ታኮግረ ቶስ ብያ ግራን ጎዴተን መ አምንየ? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />አያና ካዋ ግር ስሳራ፥ ሶ አደን ላኦ ቶና ላኮአባን፥ አን እስኑን ካሰጌራ ሃፉራ አያናና ግርናያ። <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />ሀሌዎ ኳሬ እስንኮ ካአማኖን ኮኮ ግራ” አመ። ህክና፥ የሱሳ አዮስ አማኖን ግራና አዮ ኡሱ ሮርስ ስስናሮ ጣየዋ ማንኮካሳናየ ማራንያ። <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />ሆረዴና፥ “ኦዶኮ ጎስሳመ ኳሬ፥ ማዮና እን ቶስ ኤመይን ላኮዳንዳሮ አን ካኮን አመራ ሂካኑንያ” አመ።<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />ሂካኮ ካከይ የሱሳኮ ኦአጋልሳታረን ኦሞጋን ሃራርቲ አባባተን፥ ኤሰኮ አባባተነ ዴበ ላኮሰሴተን። <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />የሱሳና ቶሞንኮ ላማነ፥ “እስና አደን ሴይን ዶታታን?” አመ። <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />ስሞና ጴጢሮሳና፥ “ጎታክ፥ አዮ ቶስ ሴይናና? አት ጅሩ ጅሮማክ ካግር ሃፉራ አብታ። <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />አት ኮ ካዋ ቁሉክ ላኖ ግዳ አማነና፥ አዴንሰና” አመ አባበ።<note caller="-" style="x"><char style="xo" closed="false">6፡69 </char><char style="xt" closed="false"><ref loc="MAT 16:16">ማቶ. 16፡16</ref>፤ <ref loc="MRK 8:29">ማር. 8፡29</ref>፤ <ref loc="LUK 9:20">ሉቃ. 9፡20</ref>።</char></note> <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />የሱሳና አባበረ፥ “እስን ቶሞንኮ ላማና ካአሳበራ ላ አንዮላ? አየሱን ጎአመን እስንኮ ኮ ዱርሳያ” አመ። <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />ካአስቆሮቱ ስሞና ኤረ ካይሁዳ፥ ቶሞንኮ ላማኮ ኮ ጎሌና፥ ዳንበኔ ሮርስ ማንኮስስናሮ ማራን ጋራኬሳ አዬሳኖያ።<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s1">የሱሳ ባላ ካዳሴ ታኮካባጃማሮ ባንኤ ሴተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />ኤሰኮ አባባተረ የሱሳ፥ ኤሰ ካግረ አይሁድል የሱሳ ላጋዲን ማንኮዶታረ ማራን፥ ይሁዳኮክ አዉራጃይ ማራሙራኖ ኢሳገረ ጋሊላ ማራሙረ። <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />ካአይሁድ ካዳሴ ባላ ካኮጋባላማረ ጎራታ አደ፥<note caller="-" style="x"><char style="xo" closed="false">7፡2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">ዎዩ. 23፡34</ref>፤ <ref loc="DEU 16:13">አዳ. 16፡13</ref>።</char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />አቢላል ታየሱሳ፥ “ኩኮ ኦአጋልሳታረና አደን አት ኦፈላቶ ፈሎ ጎጎዴናዉን፥ ሂታኮ ይሁዳ ቶስ ሴ አመን። <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />እስ ቱሳይን ዶታታ ግራን ስያመ ካፈላራ ማዮና ላግሮ። አትና ሂካ አየስ ካፈላቶ ጎሌተ፥ እስኦታ አላምን አዴስሳ” አመን። <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />አቢላልቴሳ ሱረ ላኮአማንተተ።<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />የሱሳና፥ “እየን ልክኪ ጎራታ ጋና ላኮጌሮ፥ እስኑን አደ ማጎሬና ጎራታና ካኤካተያ። <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />አላም እስን ዲድን ላኮዳንዳሮ፥ አን አደ፥ ፈሎኦቴሳ ኦሜላን ላኖ ማንኮአቶታሮ ማራን እን ዲዳራ። <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />እስን ባላ ቶስ ሰዬን፥ እዬን ልክኪ ጎራታ ማንኮጌኖን ግሮ ማራን ባላ ቶስ ላኮሴይናሮ አመ።” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />ሂካ እሶን አመረ ጋሊላ አዳላተ።<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />ሀሌዎ ኳሬ፥ አቢላል ባላ ቶስ ካኮሴታተ ጎራታ ኡሱና ሙታ ሀሌኖን ግራን ስያመ ባላ ቶስ ሴተ። <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />ባላ ጉቲና አይሁድ፥ “ኡሱ እባዶት ሀጌ ግራ?” አማ ዶታ ግረን። <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />ጋራኬሳ ጎሳ ኦሮ ታንጂን ጉምጉማኖ ግረ። ኮኮና፥ “ኡሱ ካእዳንክ እባዶትያ” አመን። ኦካለ አደን፥ “ላ፥ ጎሳ ካሽርሳሮያ” አመን። <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />ሀሌዎ ኳሬ አይሁድ አብሳታኖኮ ካከይ ጋራኬሳ ፉትሰ ካአዬሰ ማዮና ላግረ።<verse eid="JHN 7:13" /></para>
  <para style="s1">የሱሳ ታባላ ባንኤ ሴተ አጋልስሰ</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />ባላና ታኮጠኤላ ሴቴ የሱሳ ቁሉክ ምን ካዋ ቶስ ቤረ አጋልስሳኖ ሀጋአበ። <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />አይሁድና ሳዳ ሂክ እባዶት ሀአጋልሳኖኒ ሂካ አጋልስስ ምሲ አዴስን ዳንዴ? አመን።<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />የሱሳና፥ “አን ካአጋልስሳራ አጋልስሳኖ እንኮ ሀሌኖን ግራን እን ካፋረሮኮ ካኤሜተሮያ። <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />ማዮና ፈኢ ታዋ ፈልን ጎዶተ፥ ሂክ አጋልስስ ዋኮ ጎርቱን እንኮ ካኤመተሮ ላኖ ካለቤሰ ካሳ። <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />እስኮ ካአዬሳራ፥ ሀሱ ካኮንፈላራ ኡሱን ካባጃ ማንኮዶታታሮ ማራንያ፥ ካፋረሮኮት ካባጃን ካፈላራ አደ ኡሱ ካሩሚያ፥ ጣራና ላኮሄላማቶ። <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />ሙሴ ሴራ ላኮስሰሮያ? አየሱን ጎአመን ኮና ሴራ ላኮኦራቴን። እስን መዉን እን ላጋዲን ዶታታን?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />ጎሳና፥ “አት ዱርሳ ካአብታ!” “ኩ አደ አዮያ ላጋዲን ካዶታራ?” አመን።<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />የሱሳ አባበረ እሶነ ሃ አመ፥ “አን ባሳ ኮ ፈለ፥ እስን ዱባና ሳደን። <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />ሀማጽሳማኖ ካኮኤመተራ ኦዶላልኮ ኳሬ ሙሴኮ ላኮዮ፥ ጎሌና ሙሴ ሀማጽሳማኖ ማንኮስሰ ማራን አይሁድን ታፎልሲ አርና ሀኢሶን ይስ ሀማጽሳታን።<note caller="-" style="x"><char style="xo" closed="false">7፡22 </char><char style="xt" closed="false"><ref loc="GEN 17:10">መጣ 17፡10</ref>፤ <ref loc="LEV 12:3">ዎዩ. 12፡3</ref>።</char></note> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />ሴራ ካሙሴ ጎጎኢግልሳሞንኮ ይስ አይሁድን ታፎልሲ አሪ ካሀማጺሳታን ጎሌተን፥ ታእባዶ ኔፎ ታፎልሲ አሪ ጎፋይሰ መዉን እን ጉት አማራታን?<note caller="-" style="x"><char style="xo" closed="false">7፡23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">ያን. 5፡9</ref>።</char></note> <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />በቤድ ታእባዶ ዲያ ፍርዳኖ ኢሳጋዴን ፍርዳ ካሩም ፍርዳ” አመ።<verse eid="JHN 7:24" /></para>
  <para style="s1">የሱሳ፥ ኡሱ ክርስቶሳ ላኖ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />ኡሱ ጎራታ ኢየሩሳለም ካግረ ኮኮ እባዶ፤ “ላጋዲን ካዶታራን እባዶት ላ ሂካዮላ? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />ሂክማ ኡሱ ዲዳ ቤሰ አዬሳራ፥ እሶ አየስ ኮና ላኮአዬሳራን፥ ሂክ እባዶት ክርስቶሳ ላኖ ኦዶናት ኦአባን አዴስ ግራነ? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />ሂክ እባዶት አደ ኤትኮ ኤሜተሮ ኖ ካንሶዋ፥ ክርስቶሳ ኤመታ ግራን ኤትኮ ኤሜይናሮ ማዮና ላካሶ” አመን።<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />የሱሳ ቁሉክ ምን ካዋ ኦሮ አጋልስሳ ያየ ጦቂሰረ፥ “እ፥ እን ካሳንዋ፥ ኤትኮ ኤሜየሮና ካሳንዋ፥ አን ህታኒ ካኮንግራ እስኦቴይ ላኮዮ፥ አየሱን ጎአመን እን ካፋረራ ኡሱ ካሩምያ፥ እስን አዴን ላኮካሳን፥ <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />አን አደ ኡሱ ዶለኮ ማንኮኤሜየሮ ማራና ኡሱና እን ማንኮፋረሮ ማራን አን ኡሱ ካሶዋ” አመ።<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />ሃንሱን አብን ዶተን፥ አየሱን ጎአመን ጎራታ ጋና ማንኮጌኖን ግሮ ማራን ማዮና ገነ ጉት ላኮካየ። <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />ጎሌና ጎሳኮ ካሞጋን ኡሱ አማኔረ፥ “ሀያ፥ ክርስቶሳ ኤመታ ሂክ እባዶት ካፈላሮ ማላታኮ ካሮረ ፈሎ?” አመን።<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />ፋራሳዊልና፥ ጎሳ ጋራኬሳ ጉምጉማ ካአዬሳሮ አየስ ማለ፥ ካቱቃሞል ዎይቻልና ፋራሳዊል ጎጎአብናዉን እሶን ቁሉክ ምን ካዋ ኦኦራራን ፋረን። <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />የሱሳና፥ “አን እስን ዎታ ካኮአዳላይናራ ጎራታ ክጫሩንያ፥ ኤሰኮ እን ካፋረሮ ቶስ ሴይናራ፥ <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />እስን እን ዶትናታን፥ አየሱን ጎአመን ላኮሄልናታን፥ አን ማንኮግሮ ቶስ ኤመይን ላኮዳንዴታን” አመ።<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />አይሁድን ኦዶናት ኦአባን እስ እስሮ፥ “ሂካ እባዶት፥ ሄልን ኖ ካኮዋይናና ኤትራ ሴይን ጎሄድሮያ? ግሪክጆል ኦሮ ዳርኣመን ኦግራን ኡናታን ቶስ ሴይረ ግሪክጆል አጋልስስን ዶተረያ? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />‘እን ዶትናታን፥ አደን ላኮሄልናታን አድና፥ አን ማንኮግሮ ቶስ ኤመይን ላኮዳንዴታን’ ጎአምሮ መ አማኖያ?” አመን አዬሴን።<verse eid="JHN 7:36" /></para>
  <para style="s1">ኦግር በከኮክ ፉልቶ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />ባላን ጉዳታኖ ታላቶ ታንጂንት አሪ፥ የሱሳ አሌረ ያየ ጦቂሰረ፥ “ማዮና ካሱጉባተራ ጎግረ እን ቶስ ኤመይረ ሀጣመ አመ።<note caller="-" style="x"><char style="xo" closed="false">7፡37 </char><char style="xt" closed="false"><ref loc="LEV 23:36">ዎዩ. 23፡36</ref>።</char></note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />እየ ካአማናራ፥ ማጻፋ ቁሉክ ጎጎአማሮ ኦግር በከኮክ ፉልቶ ኦሮኮ ብያራ” አመ እዬ።<note caller="-" style="x"><char style="xo" closed="false">7፡38 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሕዝ. 47፡1</ref>፤ <ref loc="ZEC 14:8">ዛኪ. 14፡8</ref>።</char></note> <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />ሂካ ኡሱ ካኮንአመራ ኡሱ ኦአማናራን ካአታይናራን አያናኮክ ጋራየ፥ ኣላንቲና የሱሳ ጋና ማንኮካባጃሞን ግረ ማራን አያና ቁሉክ ላኮስሳመረ።<verse eid="JHN 7:39" /></para>
  <para style="s1">ጎሳ ኦሮ ካለካለ ብያኖ ሌ</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />ጎሳኮና ኮኮ ሂካ ሃፉራ ካኮማላረ ጎራታ፥ “ሂክ እባዶት ኦግራን ካሄገሮያ” አመ። <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />ኦካለ፥ “ኡሱ ክርስቶሳያ” አመን። ኩክና አደ ሃ አመ፥ ክርስቶሳ ጋሊላኮ “ምሲ ኤመይን ዳንዳራ? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />ማጻፋ ቁሉክ፥ ክርስቶሳ ካዳዉተ ህዲድኮ፥ ዳዉተና ታኮግረ ቤተሌምኮ ኤመታኖ ላ አዬሳሮላ?” አመን።<note caller="-" style="x"><char style="xo" closed="false">7፡42 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 ሳሜ. 7፡12</ref>፤ <ref loc="MIC 5:2">ሚኪ. 5፡2</ref>።</char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />ሃኑና የሱሳኮት ኣላንቲ ጎሳ ኦሮ ካለካለ ብያኖ ሌ፥ <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />ኮኮና ኡሱ አብን ዶቴ፥ አየሱን ጎአመን ማዮና ገነ ጉት ላኮካየ።<verse eid="JHN 7:44" /></para>
  <para style="s1">አይሁድን ሆረሃዬን ኦፈላረንኮኒዕ አማናታናዋት</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />ኤሰኮ አባባተረ ቁሉክ ምን ካዋ ኦኦራሬን ቱቃሞኮክ ዎይቻል ቶስ አባባተን ኤመተን፥ እሶና “ሙን አት ኤሜኖን ኢሳይዴታን?” አመን።<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />“ኦሀንዳረና፥ ሂካ እባዶት ኣን፥ ማዮና ሱረ አዬሰ ላካሶ” አመን አባበን።<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />“ፋራሳዊል አደ፥ እስና ሶባንቴታን አማኖያ? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />ጎሌና ኦዶናት ኦአባንኮና ፋራሳውልኮ ኡሱ ካአማነራ ግሮ? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />ሴራ ካካሶን ሂክ ጎሳ አደ ካቃንጋመያ” አመን አባበን።<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />ሂታኮ ሆረነ የሱሳ ቶስ ሴተ ካግረና እሶኮ ኮ ካሌራ ንቆድሞሳ፥<note caller="-" style="x"><char style="xo" closed="false">7፡50 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">ያን. 3፡1-2</ref>።</char></note> <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“ሴራካን፥ ሆራርጀ እባዶት ኮ መ ፈለሮ ሀማሎንና ሀአዴሶን ፍርዳራ?” አመ።<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />እሶና፥ “አትና አደ ጋሊላኮታ? ካሄገሮ ጋሊላኮ ክዋት ቆቆርና፥ ጋቾጌታ” አመን አባበን። <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />[ኤሰኮ ዳንበኔ ዱባ ምን ምን ሴተን።<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s1">ሻርሙጡማ ታአባንተቶ ሄለልትቲ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />የሱሳ አደ ዛይቲ ካብያራ ጋ ታኮአላታሮ ዎዳም ቶስ ቤ። <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />ታላም አሪ ባርባሪኖ ቁሉክ ምን ካዋ ኦሮ አደ ሙተ፥ ጎሳና ማራሙረ ኩኩ አመ፤ አጋልስስና ሀማጼ። <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />ሴራ ካሙሴ ኦአጋልስሳራና ፋራሳዊል ሻርሙጡማ ታአባንተቶ ሄለልትቲ ከኔን ጎሳ ኦሮና ኣልሴን፥ <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />የሱሳነ፥ “ካአጋልስሳቶ፥ ህት ሄለልትቲ ሻርሙጣ አባንተታ፥ <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />ሙሴና፥ ህታ ሄለልትቲ ኣንክክ ኤኤሞ ጎጎኤጋምሮ ሴራ አጃጄራ፥ አት አደ መ አማታ?” አመን።<note caller="-" style="x"><char style="xo" closed="false">8፡5 </char><char style="xt" closed="false"><ref loc="LEV 20:10">ዎዩ. 20፡10</ref>፤ <ref loc="DEU 22:22-24">አዳ. 22፡22-24</ref>።</char></note> <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />ህታ ሆስን ኡሱ ካኮንሆሳተራን፥ ኡሱ ታኮሞትራን ኣላንቲ ዶታ ጫፍትንየ፥ የሱሳ አደ ሁስ አመረ ፈሪ ኡል ጉት ጻፋኖ ሀጋአበ።<verse eid="JHN 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7" />ሆሲኒ ካኮጄርሳረን ጎራታ ጦቂ አመረ፥ “እስን ኦሮኮ ጩቦ ካላይክ ኡሱ ጣይ ኤኤሞ ሀኤገ” አመ። <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />አደና ሁስመረ ኡል ጉት ጻፈ። <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />እሶ ሂካና ካኮማላረን ጎራታ፥ ጃርሶለኮ ሀጋአበረ ቶቶል ኤሰኮ ኢሰን ሴተን፥ ኤሰ ኡሱ ሆረ አሊተ ታግቴ ሄለልትቲነ ዎታ የሱሳ ካለ ሄሰ። <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />የሱሳና ጦቂ አመረ፥ “ተ ሄለልትቲ፤ እባዶ ሀገራ ሴተ? ኩ ጉት ካፍርዴረ ላግሮያ?” አመ።<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />ኤሰና፥ “ጎታክ! ኮና ላግሮ” አንተ፥ የሱሳና፥ “አንና ላኮፍርድናሮ፥ ሴ፥ ጎርታ ሂታኮ ዳንቤባን አድ ጩቦ አሮፈልተ” አመ።]<note caller="+" style="f"><char style="fr" closed="false">8፡11 </char><char style="ft" closed="false">ካሆርኮ ካጋልባ ማጻፋጆልና ካሆርኮ ማጻፋል 7፡53-8፡11 ጌሮን ካግሮ ላኮአዳራን፤ ኮኮ ያን. 21፡24ኮ ሃሬ ጻፈራን፤ ካካለ አደ ሉቃ. 21፡38ኮ ሃሬ ጻፈራን፤ ኮ ካሆርኮ ካጋልባ ማጻፋ አደ ያን. 7፡36ኮ ሃሬ ጻፈራን </char></note><verse eid="JHN 8:11" /></para>
  <para style="s1">አቶናት ካየሱሳ ሩም ላኖ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />አደና የሱሳ እባዶን፥ “አን ካአላም ኢፋያ፥ እን ዴበ ካሰሴታራና ካግር ኢፋ ላራ ኳሬ ሱረ ሙጉዲ ላኮሰሴታሮ” አመ።<note caller="-" style="x"><char style="xo" closed="false">8፡12 </char><char style="xt" closed="false"><ref loc="MAT 5:14">ማቶ. 5፡14</ref>፤ <ref loc="JHN 9:5">ያን. 9፡5</ref>።</char></note><verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />ፋራሳዊልና፥ “አት እስኦታዉን ማንኮአቶታቶ ማራን አቶናትካ ላኮአታማሮ” አመን።<note caller="-" style="x"><char style="xo" closed="false">8፡13 </char><char style="xt" closed="false"><ref loc="JHN 5:31">ያን. 5፡31</ref>።</char></note><verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />የሱሳ፥ “አን ጋራኬ ጎአቶታየና አን ኤትኮ ኤሜየሮና ኤትራ ሴይናሮ ማንኮካሶ ማራን አቶናትክ ሩምያ፥ እስን አዴን ኤትኮ ኤሜየሮ ጎርቱን ኤትራ ሴይናሮ ካካሳን አየስ ላግሮ። <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />እስን ያዳ ካእባዶ አን ፍርዳታን፥ አን ማዮ ጉቲና ላኮፍርድናሮ። <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />ጎፍርዴና፥ ካፋረሮ ኦዶ ዎታ ኳሬ አን ካለ ማንኮግኖን ማራን ፍርዳክ ጋራያ። <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />እባዶ ላማክ አቶታኖ አታማኖ ጎጎአቦ ማለ ሴራክስኒ ጻፋመራ። <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />ጋራኬ ካአቶታታሮኮ ኮ አንያ፤ ካካለና ኢን ካአቶታራ እን ካፋረሮ ኦዶኬያ አመ።” <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />ኤሰኮና፥ “ኣቦካ ኤቲ ግራ?” አመን። የሱሳና፥ “ኣቦኬና ሌረ እና ላካሳን፥ እን ካካሳን ሌቴንዋ፥ ኣቦኬና ካሳቴንዋ” አመ አባበ።<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />የሱሳ ሂካ ካኮንአዬሰራ ቁሉክ ምን ካዋ ኦሮ፥ ሁ ካኮካማሮ ምን ዶሌ አጋልስሳ ግራንየ፥ ሀሌዎ ኳሬ ጎራታኬሳ ጋና ማንኮጌኖን ግሮ ማራን ማዮና ኡሱ ላኮአበሮ።<verse eid="JHN 8:20" /></para>
  <para style="s1">አማኖ ዋትኮክ ጋራ ካስሳመሮ ሴርሳኖ</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />የሱሳ አደና፥ “አን ሴይናራ፥ እስና እን ዶትናታን፥ ጩቦክስኒና ጎይናታን፥ አን ማንኮሴታሮ ቶስ አድ ኤመይን ላኮዳንዴታን” አመ።<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />አይሁድን ኦዶናት ኦአባናየና፥ “አን ማንኮሴታሮ እስን ኤመይን ላኮዳንዴታን ኡሱ ካኮንአመራ እስኦቴሳ ላጋዳይንያ?” አመን።<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />የሱሳ አደ፥ “እስን ሄገልኮታን፥ አን ኤለኮያ፥ እስን ሂካ አላምኮታን፥ አን ላኮህካ አላምኮዮ። <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />ጩቦክስኒ ጎዋኖ ሰገራ፥ አን ኡሱያ ጎአምሮ አን ኡሱ ላኖ ጎአማናታና ዋተን፥ ጩቦክስኒ ጎይናታን” አመ።<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />እሶና “አት አዮታ?” አመን።</para>
  <para style="p" vid="JHN 8:25">የሱሳና “ሆራርጀዋ፥ ካአዬሳረ ኡሱ አንየ። <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />አን እስን ጉት ካአዬስሮና ካፍርድናሮ ካሞጋን አየስ አባ፥ አየሱን ጎአመን እን ካፋረራ ካአብዳመያ፥ ኡሱኮና ካማለሮ አላምን አዬስናራ።”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />እሶና ጋራ ካኦዶ ሰጋ ግራኖ ላኮአዴሴራን። <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />ሃንሱን የሱሳ፥ “ኤረ ካእባዶ ጦቂስ ካኮሱይቴን ጎራታ፥ ኣንክ ካአመራ ኡሱ አን ላኖ ኦዶ ካአጋልስሰሮ አዬሳኖ፥ ፈኢቴይ ኮና ፈልዋት ካሳንዋ። <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />እን ካፋረራ ኡሱ ኢነታ ግራ፥ ማኤክ ጎራታና ካገጌላይስሮ ፈልን ካለ እን ላኮኢሳገሮ አመ።”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />የሱሳና ሂካ ጎጎአዬሰ ኦሞጋን ኡሱ አማኔን።<verse eid="JHN 8:30" /></para>
  <para style="s1">ይስ ካአብራመ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />የሱሳና ኡሱይ ካአማናሮ አይሁድነ፥ “እስን አጋልስሳኖኬይ ጎአታቴን ሩምና እንኮ ኦአጋልሳታንታን አመ። <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />ሩምና ካሳንዋ፥ ሩምና እስን ባልቹማ ቤስናታ አመ።”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />እሶና አባበን፥ “ኖ ይስ ካአብራመና፥ ማዮና ድይ ሌነ ላካንሶ፥ ሀያ ኖኔ ባልቹማ ብናታን ምሲ አማታ?” አመን።<note caller="-" style="x"><char style="xo" closed="false">8፡33 </char><char style="xt" closed="false"><ref loc="MAT 3:9">ማቶ. 3፡9</ref>፤ <ref loc="LUK 3:8">ሉቃ. 3፡8</ref>።</char></note><verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />የሱሳና “አን ሩምና ሩምና አማራ ጩቦ ካፈላራ ካጩቦ ድይያ፥ <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />ድይ ኤርናዉና እባዶ ካምነ ኦሮ ላኮግራሮ ኤረ አደ ማጎሬና ምኒ ግራራ። <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />ጎርታ ኤረ ካዋ ባልቹማ ጎቤሰ፥ ሩምና ባልቹማ ብናታን። <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />እስን ይስ ካአብራመ ላኖ አን ካሶዋ አየሱን ጎአመን ሃፉራኬ አታታና ማንኮዋታን ማራን እን ላጋዲን ጎሳቴን ኬቴታን። <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />አን ኣቦኬ፥ ዶሌ ካዴሮ አዬሳራ፥ እስና ኣቦክስንኮ ካማልቴታን ፈላታን አመ።”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />እሶና፥ “ኣቦካን አብራመያ” አመን አባበን። የሱሳና “እስን ይስ ካአብራመ ሌቴንዋ፥” አብራመ “ካፈለሮ ፈላቴንዋ። <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />ዋኮ ማለረ ሩም ካሰገሮ እን ላጋዲን ዶታታን አብራመ አደ ሂካማሌ ላኮፈለሮ። <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />እስን ካፈላታን ኣቦክስን ካፈላሮያ።” እሶና፥ “ኖ ሻርሙጡማ ኦኡሙላምነኖ ላኮኖ፥” “ኣቦካንና ኮ ዋ ካላያ” አመን አባበን።<verse eid="JHN 8:41" /></para>
  <para style="s1">ይስ ካዱርሳ</para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />የሱሳና፥ “ዋ ኣቦክስን ሊ ግረዋ፥ አን ዋ ዶለኮ ማንኮኤሜየሮ ማራን ጌላታተንዋ ኡሱ እን ፋረራ ኳሬ አን እስኦቴይ ላኮኤሜየሮ። <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />አን ካአዬሳሮ መዉን ሻዳናዋታን? ኣላንቲና ሃፉራኬ ማልን ማንኮዶታኖን ማራንያ። <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />እስን ኣቦክስንክ ካዱርሳ ይስታን። ኣቦክስንክ ሀልቻ ፈልን ዶታታን። ኡሱ ሆራርጀዋ ኔፎ ካላጋዳሮየ፥ ኡሱ ዶሌ ሩም ማንኮግኖን ማራን ሩሚ ላኮአታተሮ፤ ኡሱ ጣራና ካጣራ ኦዶ ማንኮሌዉን ጣራ አዬሳራ ካአዬሳራና እስኮ መጠረያ። <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />አን አደ ሩም ማንኮ አዬሳሮ ማራን ላኮአማናታን። <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />እስንኮ አት ጩባለሳታ አም ሞትን ካዳንዳራ አዮያ? ሩም ካአዬሳሮ ጎሌ፥ መዉን አማናና ዋታን? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />ካዋ ካሌ ሃፉራ ካዋ ማላራ፥ እስን አዴን ዋኮ ማንኮሌኖን ማራን ላኮማላታን አመ።”<verse eid="JHN 8:47" /></para>
  <para style="s1">የሱሳ ጋራ ኬሳ ካአዬሰሮ</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />አይሁድና አባበረ፥ “አት ሳማራውታ፥ አደና ዱርሳ ኩ ጉት ግራ አማኖካን ላ ጋራዮላ?” አመን።<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />የሱሳና፥ “አን ኣቦኬ ካባጃራ ኳሬ ዱርሳ ላኮአቦ፥” “እስን አዴን እን የራሳታን። <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />አን ካባጃቴ ላኮዶታታሮ፥ ካባጃቴ ካዶታራ አደ ግሮዋ፤ ካፍርዳራና ኡሱያ። <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />አን ሩምና ሩምና አማራ፥ ማዮና ሃፉራኬ ጎኦራተ፥ ጎይ ሱረ ላኮዴሮ” አመ አባበ።<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />አይሁድና፥ “ዱርሳ ግራኖ ግዳ አዴንሰ፥ አብራመ ጎየራ፥ ካሄገሮልና ሂካማሌዋ፥ አት አደ ማዮና ሃፉራካ ጎኦራተ ሱረ ላኮጎሮ አማታ። <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />አት ኣቦካን አብራመኮ ሮራታ? ኡሱ ጎየ፥ ኦሄገሮልና ኡሱማሌዋ ጎዬን፥ ሀያ አት አዮያ አምን ላታ አመን?” <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />የሱሳና “አን እስኦቴ ጎካባጃየ ካባጃት ላኦ ካሊትታ፥ ካካባጅናራና አደ እስኔ ዎታ፥ እስን ሄዶካን ካአማታን ኣቦኬያ። <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />እስን ጎካሳናዋተና አን ካሶዋ ላካሶ ጎአመ፥ አን አደ እስን አን ካጣራ ላራ፥ አን አደ ካሶዋ ሃፉራና ኦራይናራ። <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />ኣቦክስን አብራመኮክ ሀልቻ አርቴ ዲ ገጌላይን ዶተረ፥ ዴጉረና ገጌላተ፥ ካገገላተና ሌ አመ አባበ።”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />አይሁድና፥ “ጋና ጌስ ኮንቶም ካኮሌኖ፥” “አት አብራመ ዴተታ!” አመን። <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />የሱሳና፥ “አን ሩምና ሩምና አማራ” “አብራመ ኡሙላማናኮ ሆረነ አን አንያ” አመ።<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />ኡሱ ጎራታ ኡሱ ኤጊን ኤኤሞ ኣተን፥ የሱሳ አደ ጎላተ፥ ቁሉክ ምን ካዋኮና ቤ ሴተ።<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s1">የሱሳ ኢልኦ ባየ ካኡሙላመሮ እባዶት ፋይሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />የሱሳ ራኔ ሮራ ግራን ታኮኡሙላመኮ ሀጋአበረ ኢልኦ ካባየረ እባዶት ዴ። <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />ኡሱኮ ኦአጋልሳታረና የሱሳነ፥ “ካአጋልስሳቶ! ሂክ እባዶት ኢልኦ ባይ ጎጎኡሙላምሮን ጩቦ ካፈለራ አዮያ? ኡሱያ ሙ ኦኡሙለራንያን?” አመን ሆሳተን።<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />የሱሳና፥ “ኡሱ ጎርቱን ኦኡሙለራን ጩቦ ላኮፈሌራን፥” “ሂክ ካኮንሌራ አደ ፈሎ ኦዋ ኡሱ ጎጎሙትናዉንያ። <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />አሪ ግራን እን ካፋረሮኮኒዕ ፈሎ ፈላኖ ዶትሳራ፥ ማዮና ፈልን ታኮዳንደኖን ሄመን ኤማታ፥ <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />ሂካ አላም ግራን አላምኮክ ኢፋ አንያ አመ።<note caller="-" style="x"><char style="xo" closed="false">9፡5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">ማቶ. 5፡14</ref>፤ <ref loc="JHN 8:12">ያን. 8፡12</ref>።</char></note>”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />ሂካ አመ አባባተረ ኡሊ ሀንጩፈ ቱፈረ ሀንጩፌ ኤረ ጫዉድሰረ ኢልኦ ኦእባዶቲ ሽግደረ፥ <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />“ሴዴ ሰልሆም ካአማማሮ ኤላ አልና” አመ። (ሰልሆም አማኖ “ካፋራመ” አማኖያ።) እባዶትና ሴተ ኣለ። ዴንዳና አባባተ ኤመተ።<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />ኦላቴሳና ሂታኮ ሆረነ ኡሱ ኤባታ ግራን ካዴራ እባዶ፥ “ሂክ እባዶት ላ ሀማጼ ካኤባታረዮላ?” አመን። <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />ኮኮና፥ “ኦግራን ኡሱያ” አመን፥ ኩክና ኡሱ ኣን ላራ ኳሬ ላኮኡሱዮ አመን፥ ኡሱ አደ፥ “አንዋያ” አማ ግረ። <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />እባዶና፥ “ሀያ ኢልኦ ኦታ ምሲ ባናሜን?” አመን ሆሳተን። <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />ኡሱና፥ “የሱሳ ካአማራን እባዶት ኤሬ ጫዉድሰረ እልኦ ኦቴይ ሽግደ፥ ሰልሆም ቶስ ሴይረ ጎጎኣሎን ሰገ፥ ሴዬረና ኣለ፥ ድያኖና ዳንዴ” አመ አባበ። <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />እሶና፥ “ሀያ፥ ኡሱ እባዶት ኤቲ ግራ?” አመን። ኡሱና፥ “አን ላካሶ” አመ።<verse eid="JHN 9:12" /></para>
  <para style="s1">ፋራሳዊል እባዶት ምሲ ፋዬሮ ቁሌሳኖ ሆረዴን</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />እሶና ኢልኦ ባየ ካግረ እባዶት ፋራሳዊል ቶስ ጌሰን። <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />የሱሳ ጫዉዶ ሽግደረ ኢልኦ ኦእባዶት ካኮባነራ አይሁድን ታፎልሲ አርተ። <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />ሃንሱን ፋራሳዊል ምሲ ድያኖ ዳንዴሮ ሆሳተን። እባዶትና፥ “ኡሱ ኢልኦኦቴይ ጫዉዶ ሽግደ” አንና “ኣለ ሂክማ ዲያ ግራ አመ።”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />ፋራሳውልኮ ኮኮ፥ “ሂክ እባዶት ታፎልሲ አሪ ማንኮካባጂኖን ማራን፥ ዋኮ ላኮዮ” አመን። ኩክና አደን፥ “ጩባለሳ፥ ሂካ ኣንክክ ማላታ ምሲ ፈልን ዳንዳራ?” አመን። እስኦሮና እስአትዋት መጣንተ።<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />ሃንሱን፥ ኢልኦ ባየ ካግረ እባዶት ቶስ አባባተሬን፥ “ኢልኦ ኦታ ካባነሮ እባዶትኮክ ጋራ አት መ አማታ?” አመን። እባዶትና፥ “ኡሱ ካሄገሮያ” አመ። <verse eid="JHN 9:17" /><verse number="18" style="v" sid="JHN 9:18" />አይሁድና ኡሱ ኦኡሙለራን ቶስ ፋርጉሬን ታኡምስስራኒ እባዶት ኢልኦ ባየ ካግረ ላኖና አደና ድያኖኬሳና ላኮአማናተሬን። <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />እሶና፥ “ኢልኦ ባየ ኡሙላመራ ካአማታን ኤረክስን ሂካያ? ሀያ ግዳ ምሲ ድን ዳንዴ?” አመን።<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />ኦኡሙለራና፥ “ኤረካን ላኖና ኢልኦ ባይ ኡሙላማኖ ካንሶዋ።”<verse eid="JHN 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 9:21" />ግዳ አደ ምሲ ድያኖ ዳንዴሮ ኢልኦ ኦቴሳ ማዮ ባነሮ ኖ ላካንሶ እስ ካዳንዴ እባዶት ማንኮሌ ማራን፥ እስኦቴሳዉን አዬስን ዳንዳራ ኡሱ ሆሳየን አመን አባበን። <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />የሱሳ፥ ክርስቶሳያ አም ካአቶቴ ዱባ ምን ካኤብ ካአይሁድኮ ጎጎሆሮራምሮ አይሁድ ጣዬን ሙርተሴን ማንኮግሬን ማራን፥ ኦኡሙለራን ሂካ ካኮንአሜረን አይሁድ አብሳቴረንያ። <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />ሃንሱን ኦኡሙለራን ኡሱ እስ ካዳንዴ እባዶት ማንኮሌሮ ማራን ኡሱ ሆሳየን አመን።<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />ኢልኦ ካባየረ እባዶትና ካላም ኡሜነ፥ “አት እባዶት፥ ዋ ካባጂና፥” “ሂክ እባዶት ጩባለሳ ላኖ ኖ ካንሶዋ” አመን።<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />ኡሱና “ጩባለሳ ላኖ አን ላካሶ አየሱን ጎአመን አን እልኦ ባየ ካግረ ላኖና ግዳ አደ ድያኖኬ ሂካ አየስ ኮ ካሳ” አመ። <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />እሶና፥ “ኡሱ ኩን መ ፈለራ? ኢልኦኦታና ምሲ ባነራ?” አመን ሆሳቴን። <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />ኡሱና፥ “ሆራ አን እስኑን ሰገራ፥ ላኮጫቃሰታን፥ መዉን አድ ማልን ዶታታን? እስና አዴን ኡሱኮ ካአጋልሳታሮ ሊን ዶታታን?” አመ። <verse eid="JHN 9:27" /><verse number="28" style="v" sid="JHN 9:28" />እሶና፥ “አት ሂካ እባዶትኮ ካአጋልሳቶታ፥ ኖ ሙሴኮ ኦአጋልሳታኖና! <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />ዋ ሙሴነ ዎታ አዬሳኖ ኖ ካንሶዋ፥ ሂክ እባዶት አደ ኤትኮ ኤሜተሮ ሱረ ላካንሶ” አመን አዬሴን።<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />እባዶትና፥ “እስን ኡሱ ኤትኮ ኤሜተሮ አዴስዋት ካሳድስሮያ፥ ሀሌዎ ኳሬ ኡሱ ኢልኦ ኦቴ ባነራ። <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />ዋ ካማላራ፥ ኡሱ ካአብሳታሮና ፈኢቴሳ ካፈላሮ ኳሬ፥ ጩባለሳል ማልዋት ኖ ካንሶዋ። <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />ኢልኦ ባየ ካኡሙላመሮ እባዶት ኢልኦ ካባነራ ግሮዋ ጎአመን፥ አላም አሮ መጣመኮ ሀጋአበረ ማዮና ማለ ላካሶ። <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />ሂክ እባዶት ዋኮ ሊ ዋተዋ ሂካ ፈልን ላኮዳንዳረ አመ አባበ።”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />እሶና፥ “ማር ዱባ ጩቦ ባተ ካኡሙላንተታ፥ አት ኖ አጋልስስን ምሲ ጃቡ ቱሳታ?” አመን አባበን፥ ሆሮረን።<verse eid="JHN 9:34" /></para>
  <para style="s1">አያናኮክ ጃማናት</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />የሱሳና እባዶት ሆሮራማኖ ማለ፥ ኡሱ ካኮሄላረ ጎራታና፥ “አት ኤረ ካእባዶይ አማናታ?” አመ። <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />እባዶትና፥ “ጎታክ አን ኡሱ ጎጎአማኖን ኡሱ አዮያ?” አመ ሆሳተ። <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />የሱሳና፥ “ዴተታ፥ ግዳና ኩኔ ዎታ ካአዬሳራ ኡሱያ” አመ። <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />እባዶትና፥ “ጎታክ አን አማንናራ” አመ ሳጋደ። <verse eid="JHN 9:38" /><verse number="39" style="v" sid="JHN 9:39" />የሱሳና፥ “ኦድያኖን ጎጎዴራዉን፥ ኦድያራና ጎጎድያኖንኮ፥ ፍርድን ሂካ አላም ቶስ ኤመየራ” አመ። <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />የሱሳ ዎታ ኦግረን ፋራሳውልኮ ኮኮ ሂካ አየስ ማሌንጉረን፥ “መ አማኖያ? ሀያ ኖና ኢልኦ ኦድያኖና አማኖያ?” አመን። <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />የሱሳና፥ “ኦድያኖን ሊ ግቴንዋ እስኑን ጩቦ ላኮላረ፥ ግዳ አደ ድያና ማንኮአማታን ማራን፥ ጩቦክስን ጎጎግሮ ግርናራ” አመ።<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s1">ካፎፋሮና እዳድጆላል</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />ኤሰኮና የሱሳ “አን ሩምና ሩምና አማራ፥ አዉድ ካእዳድ ቶስ ኡፋነ አንሌኖን ግራን ባንኤ ታካለነ ፍርመ ካታባራ ካሄታሮና ካሳማሮያ። <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />ካራነ ካታባራ አደ ኡሱ እዳድ ካፎፋሮያ። <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />ካራ ካኦራራ ካራ ባናራ፥ እዳድኬሳና ያየቴሳ ማላራ። እዳድኬሳና መገክሶይ ኡማ ቤስናራ። <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />ኦቴሳ ኦሌራን ዱባ ካኮቤሰ ጎራታ ሆረ ሀየ ሰሴታራ ኢዳንዳ ያየቴሳ ማንኮካሶ ማራን ዴበ ሰሴታራ። <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />ማርት ካሌሮ ጎአመን እሶ ያየቴሳ ማንኮካሶን ማራን ኡሱኮ ባቃታራን ኳሬ ሱረ ኡሱ ዴበ ላኮሰሴታራን” አመ።<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />የሱሳ ሂካ ማሱሳ ሰገ፤ እሶ አደን ኡሱ መ ሰጌሮ ላኮሻደራን።<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />ሃንሱን የሱሳ ካላም፥ “አን ሩምና ሩምና አማራ፥ ካእዳድጆል ካራ አንያ። <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />እንኮ ሆረነ ኦኤመቴረን ዱባ ሄቶና ኦሳማራንያን፥ እዳድጆልና አደን እሶ ላኮማሌን። <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />ካራ አንያ፥ እን ቶስነ ካታባራ ዱባ ፋያራ፥ ታባራ፥ ብያራ፥ ቦባና ሄላታራ። <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />ሄቶ ሄትን፥ ላጋዲን ባስን ካላዉን ኤማታ፥ አን አደ ካኮን ኤመየራ ዱዶት ኔፎ ጎጎግርቶንያ አመ።”<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />አደና “ካእዳንክ ካፎፌ አንያ፥ ካእዳንክ ካፎፌ ኔፎቴሳ እዳድጆል ማራን ሮርሰ ስሳራ። <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />ማራጋዴን ካፎፋራ አደ እዳድጆል ካኬሳ ማንኮሌኖን ማራን፥ ህዬይ ጎኤሜቶ እዳድ ኢሰረ ባቃታራ፥ ህዬይና እዳድ አባታ፥ ዳርአታ። <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />ካኮንባቃታራና ማራጋዴን ካፎፋሮ ማንኮሌ ማራን ኢዳዱን ካነኔኤይሳኖንያ። <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />ካእዳንክ ካፎፌ አንያ፥ ካኬ ካሌሮ እዳድ አን ካሶዋ፥ እሶና እን ካሳንዋ። <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />ህክና ኦዶ እን ጎጎካሶ ማለ አንና ኦዶ ጎጎካሶ ማሌያ፥ ኔፎቴና እዳድኬ ማራን ሮርስ ስስናራ። <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />ሂካ አዉድኮ ካሌኖን ካካለ እዳድ ግራ፥ እሶና ኬናኖ ዶትሳራ፥ እሶና ያየቴ ማላራን፥ ማተ ቶና ሌራን፥ ካፎፈና ኮያ።<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />“አን አባብ አታይን ኔፎቴ ሮርሳይ ማንኮስስናሮ ማራን ኣቦክ እን ጌላታራ። <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />ኔፎቴ ፈኢቴይ ሮርስ ስስናራ ኳሬ እንኮ ማዮና ላኮአትሮ፥ ሮርስ ስስንና ሌረ ኬስን ኦዶናት አባ፥ ሂካ አጃጃ ካኮአታየራ ኣቦኬኮያ” አመ።<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />ሂካ ሃፉራኮ ካከይ አይሁድ ኦሮ አደና እስአታናዋት መጣመ። <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />እሶኮ ኦሞጋና፥ “ኡሱ ዱርሳ አባ፥ ቆላመራ፥ ሙን ማላታን?” አመን።<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />ካካለ አደ፥ “ሂክ አየስ ዱርሳ ካኮግሮ እባዶትኮክ አየስ ላኮዮ፥ ዱርሳ ኢልኦ ካባየ ባንን ዳንዳራ?” አመን።<verse eid="JHN 10:21" /></para>
  <para style="s1">አማኖዋት ካአይሁድ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />ኢየሩሳለምና ቁሉክ ምን ካዋክ ኡሱባታኖኮክ ባላ ሌ፥ ጎራታና ባጠሳየ፥ <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />የሱሳና ቁሉክ ምን ካኤብ ሶሎሞን ካኮሰሴታሮነ ሮራ ግረ። <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />አይሁድና ማራሙሬነ፥ “ሀጌ ታ ጌቶን ዎዳናታን ረሬስ ካይናታ? አት ጎክርስቶሳቶ አዴስስ ኖን ሰጊ” አመን።<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />የሱሳና፥ “አን እስኑን ሰገረ፥ እስን አዴን ላኮአማናታን፥ ኣቦኬክ መገ አን ኦፈላራ ፈሎ ጋራኬ አቶታራን። <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />እስን አዴን እዳድኬ ማንኮ ላናዋቴዉን ላኮአማናታን። <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />እዳድክ ያየቴ ማላራ፥ አንና ካሶዋ፥ እሶና እን ዴበ ሰሴታናን። <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />አን እስኑን ጅሩ ጅሮማክ ግር ስስናራ፥ ዱዶ ላኮባታን፥ ገነቴኮና እስን ባስ ኣትን ካዳንዴራ ማዮና ላግሮ። <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />እሶ ኢን ካስሰራ ኣቦክ ዱባንኮ ሮራራ፥ ኣቦኬት ገነኮ ማዮና ባስ ኣትን ላኮዳንዴሮ። <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />አንና ኦዶክና ኮና አመ።”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />አይሁድ የሱሳ አደን ኤጊን ኤኤሞ ኬሴን። <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />የሱሳ አደ፥ “ኦዶ ዶለኮ ኦሞጋን ኦጅንጂን ፈሎ ኦኢዳን ቱሰዋ፥ ሀያ ሂካስኮ ኤኩን ኤግናታን?” አመ።<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />አይሁድና፥ “ኖ ኩ ካኮንኤግናና፥ ጋዴክ እባዶት ሌተ ግራን፥ እስኦታ ሄዶ የላተደ ዋ ማንኮሀባርተ ማራንያ ኳሬ ኦኢዳኒዕ ፈሎኦታዉን ላኮዮ” አመን አባበን።<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />የሱሳና፥ “ሴራክስኒ፥ ‘እስን ዋልታን አመ አማመ ላኮጻፋመሮያ’?<note caller="-" style="x"><char style="xo" closed="false">10፡34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">ማዛ. 82፡6</ref>።</char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />ሃፉራ ካዋ ኦኮንኤሜተሮ ‘ዋልታን’ ጎአመ ማጻፋ ቁሉክና ኢግልሳምን ካዳንዳሞን ጎሌ። <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />ሀያ፥ ‘አን ኤረ ካዋያ’ ማንኮአመሮ ማራን፥ ኦዶ ኡሱን ካለ የላተረ አላም ቶስ ካፋረሮ፥ አት ዋ ኢንጋማታ መዉን አማታን? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />አን ኣቦኬኒዕ ፈሎ ካፈላሮ ጎሌኖን አሮአማናቴን። <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />ካፈላሮ ጎሌ አደ እን ጎአማናታና ዋቴና፥ ኦዶ ኢን ግራኖ አንና ኦዶን ግራኖ አዴስና ሻድ ጎጎሌታዉን ፈሎኦቴሳ አማና አመ አባበ።” <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />አደና አብን ዶተን፥ ኡሱ አደ ገነኮ ቤሳተ።<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />ኤሰኮ የሱሳ ጣየ ያንሳ ታኮጣማቃረ፥ ዮርዳኖስ ጋማ ቶስ አባባተ፥ ኤሴና አዳላተ።<note caller="-" style="x"><char style="xo" closed="false">10፡40 </char><char style="xt" closed="false"><ref loc="JHN 1:28">ያን. 1፡28</ref>።</char></note> <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />እባዶ ካሞጋና ኡሱ ቶስ ኤመተ፥ እሶና፥ “ያንሳ ኮና ማላታ ላኮፈለሮ፥ አየሱን ጎአመን ሂካ እባዶትክ ጋራ ካአዬሰራ ዱባ ሩምያ” አመን። <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />ኤሰ ባንኤ ኦሞጋን የሱሳ አማኔን።<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s1">ጎይ ካአላዛር</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />ካማይራመና አባትሴክ ካማርታ ማማን ብታንያይ ካግረ አላዛር ሀዉኣማ ግረ። <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />ህት አቢክሰ አላዛር ታኮን ሀዉኣማረ ማይራመ፥ ጎታ ጉት ሽቶ ክብተደ ሉክቴሳ መተክሴይ ታሻካራተታ። <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />አባላል ላማ፥ “ጎታ፤ አት ካጌላታ እባዶት ሀዉኣማራ” አመን ሀንዳ ፋረን።<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />የሱሳ ሂካ ካኮማላረ ጎራታ፥ “ሂክ ሀዉኣም ኤረ ካዋ ኡሱ ጎጎካባጃምሮና ካባጃ ታዋዉንያ ኳሬ ጎይን ካጌግስሮ ላኮዮ” አመ።<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />የሱሳና ማርታና፥ አባትሴ ማይራመና አብክሶ አላዛር ጌላታ ግረ። <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />ጎሌና ካአላዛር ሀዉኣማኖ ማለ ግራን ታኮግረ ባንኤ አርት ላማ ሀየ። <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />ኤሰኮ አባባተረ ኡሱኮ ኦአጋልሳታራነ “ኡል ካይሁዳ ቶስ አባባና” አመ።<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />ኡሱኮ ኦአጋልሳታራና፥ “ካአጋልስሳቶ፥ አሪ ትጫርኮ ሆረነ አይሁድ ኩ ኤኤሞ ኤጊን ዶታ ግረ፥ አደና ኤሰራ ሴይናታ?” አመን።<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />የሱሳና “አሪ ቶ ላ ሳቲ ቶሞንኮ ላማቶላ? ሂካ አላምኮክ ኢፋኮ ካከይ ማንኮድያሮ ማራን አሪ ካሰሰታራ ላኮሀንዱዱፋታሮ። <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />ካሀንዱዱፋታራና አደ ሄመን ካሰሴታሮያ፥ ኣላንቲና ኢፋ ላኮአቦ አመ አባበ።” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />ሂካ ሰገ አባባተረ፥ “ኖ ካጌላታና አላዛር ሁዱረራ፥ አንና ሁዱሮኮ ኡሱ ኬስን ሴይናራ” አመ።<note caller="+" style="f"><char style="fr" closed="false">11፡11 </char><char style="ft" closed="false">ድሞሳ፦ ላኩ አማኖያ።</char></note> <verse eid="JHN 11:11" /><verse number="12" style="v" sid="JHN 11:12" />የሱሳኮ ኦአጋልሳታረን “ጎታ! ጎሁዱረሮ ፋይሮዋ” አመን። <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />የሱሳ ሂካ ካኮሴገራ ካአላዛር ጎይኮክ ጋራየ፥ ኡሱኮ ኦአጋልሳታረን አደን ሁዱራኖኮክ ጋራ ካአዬሰሮ ኣን ሌራ። <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />ሃንሱን የሱሳ አዴስሰ፥ “አላዛር ጎየራ። <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />እስን ጎጎአማንታኑን፥ ኤሰ ግርዋትክ እስን ማራን ገጌላይሳራ፥ ግዳ አድ ኡሱ ቶስ ሴና።”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />ኤሰኮና ዲዲሞሳ ካአማማረ ቶማሳ ኦካለ የሱሳኮ ኦአጋልሳታረን፥ “ኖና ሴይነ ኡሱነ ዎታ ጎና” አመን።<verse eid="JHN 11:16" /></para>
  <para style="s1">የሱሳ አባላል ታአላዛር ጎጎኢሳኖ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />የሱሳ ኤሰራ ካኮግያረ ጎራታ አላዛር ጎቃማላመስኮ አሪ አፋር ሌተቴ። <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />ብታንያ ኢየሩሳለምኮ ክሎ መትራ ሴድ ግታክ ፋክንተ ግቴ። <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />ካሞጋን አይሁድና ማርታና ማይራመና አቢክሶክ ጎይ ጎጎእስን ኤመተን ግረን።<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />ማርታ የሱሳኮክ ኤመታኖ ማልተደ ቆጳይን ቤተ፥ ማይራመ አደ ምን ሄሰ ግቴ። <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />ማርታና የሱሳነ፥ “ጎታ! አት ህታኒ ግቴዋ፥ አቢክ ላኮጎዋረ። <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />ግዳ ጎሌ ካኤባቶ ዱባ ዋ ስሳኖ ካሶዋ አንተ።”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />የሱሳና፥ “አቢካ ጎይኮ ክናራ” አመ። <verse eid="JHN 11:23" /><verse number="24" style="v" sid="JHN 11:24" />ማርታና፥ “ታጋቾ አሪ ጎይኮ ካክናራ አን ካሶዋ” አንተ። <verse eid="JHN 11:24" /><verse number="25" style="v" sid="JHN 11:25" />የሱሳና፤ “ጎይኮ ክያኖና ኔፎና አንያ፥ እዬ ካአማናራ ጎጎየና ኔፎ ግራራ። <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />እዬ ካግራ፥ ካአማናራና ሱረ ላኮጎሮ፥ ሂካ አማናታ?” አመ።<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />ኤሰና፥ “እ ጎታክ፥ አት አላም ቶስ ካኤማቶ ክርስቶሳ ኤረ ካዋ ላኖ አማናራ” አንተ።<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />ማርታ ሂካ አንተ አባባተደ፥ አባትሴ ማይራመ ካለ ኡንተደ፥ “ካአጋልስሳራ ኤመተራ፥ ኩ ኡማራ” አንተ። <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />ማይራመና ሂካ ጎጎማልቴ ሳንተ ኬተደ የሱሳ ቶስ ሴተ። <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />ኡሱ ጎራታ የሱሳ፥ ማርታ ኡሱ ታኮቆጳተቶ ባንኤ ግረ ኳሬ፥ ጋና ማማን ቶስ ላኮታበረ። <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />ማይራመ ጎጎኢሳ ምን ኦሮ ኦግረን አይሁድና፥ ፍርም ብያኖ ዴኔ፥ ቃማል ቶስ ሴተ ካኦዋቶ ኣን ሌረ ዴበ ቤን።<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />ማይራመና የሱሳ ማንኮግሮ ባንኤ ቶስ ጌተ ጎጎዴቴና፥ ሉኪ ሄገሊ ኢተደ፥ “ጎታክ፥ አት ህታኒ ካግቴ ሌተዋ፥ አቢክ ላኮጎዋረ” አንተ።<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />የሱሳና ኤሰ ኦታ ግራን፥ ዴበ ካኤመተራ አይሁድና ኦታ ግራን ዴጉረ አያና ጋዳ ሻላጋመረ፥ <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />“ሀጌ ቃማልቴታን?” አመ ሆሳተ፥ እሶና፥ “ጎታክ፥ ኮይ ዴና” አመን።<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />የሱሳና ኢልም ቤሳተ። <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />አይሁድና፥ “ምሲ ኡሱ ጌላታ ግረ ዴተነ!” አመ።<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />እሶኮ ኮኮ አደ፥ “እልኦ ካባየረ ኢልኦ ካባናራ፥ ሂክ እባዶት ጎጎ ጎኖንኮ ኡሱ የልን ላኮዳንዳረያ?” አመን።<verse eid="JHN 11:37" /></para>
  <para style="s1">የሱሳ አላዛር ጎይኮ ኬሳኖ</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />የሱሳ ዎዳናቴሳ ካላም ጋዳ ድናንተደ ቃማል ቶስ ሴተ፥ ቃማልኬሳና ኤኤሞ ካጩፋመሮ ላጋየ። <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />ኡሱና፥ “ኤኤሞ ኬሳ” አመ። ካጎየረኮት አባ ማርታ፥ “ጎታ! ኡሱ ጎየረ አሪ አፋር ማንኮአዳላተሮ ማራን ግዳ ኡርማታራ” አንተ። <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />የሱሳና፥ “አት ጎአማናተ ካባጃ ታዋ ጋቾ ዴታ አመ አን ኩን ላኮሰጌረያ?” አመ። <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />ሃንሱን እባዶ ኤኤሞ ኬሰ፥ የሱሳና ኤልዴ ዴረ፥ “ኣቦክ፥ ማንኮማልተ ማራን አን ኩ ጋላታራ፥ <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />አሪ ዱባ አት እን ማላኖ አን ካሶዋ ሂካ አዬሳኖ አደ ህታኒ ካአሌራ እባዶና አት እን ፋራኖ ጎጎአማናዉን አመረያ” አመ። <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />የሱሳ ሂካ አመ አባባተረ ያየ ጦቂኢሰረ፥ “አላዛር፥ ኮይ ቤን!” አመ ኡመ። <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />ካጎየረ አላዛርና ገነና ሉኪና ታማማራንተ ጋሸነ ዎታ፥ በቤዲና ሆጮ ጎጎማማራንቴ ቤ። የሱሳና “ጋሸ ታቃማል ፉራዴን ኢሳጋ ሀሴተ” አመ።<verse eid="JHN 11:44" /></para>
  <para style="s1">የሱሳ ላጋዲን ኦፈላመራን ፈሎ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26፡1-5</ref>፤ <ref loc="MRK 14:1-2">ማር. 14፡1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፡1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />ሃንሱን ማይራመ ቶስ ካኤመተረ አይሁድኮ ካሞጋን እባዶ፥ የሱሳ ኦፈለሮ ፈሎ ዴጉረ ኡሱ አማነ። <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />ኮኮና አደ ሴቴረነ የሱሳ ካፈለሮ ፋራሳውሉን ሴጌን። <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />ኤሰኮ ካቱቃሞል ዎይቻልና ፋራሳዊል ታአይሁድ ሶንጎኒ ኩኩይሰንጉረን ሃ አመን፥ “ሂክ እባዶት ካሞጋን ማላታ ፈላ ማንኮግሮ ማራን ኖ መ ጎየልነ ኢድራ? <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />አዳ. ኖ ጎኢንሰ እባዶ ዱባ ኡሱ አማንናራ፥ ካሮም እባዶና ኤመይረ ኡልካንና ጎሳካን ባስናራ አመን።”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />እሶኮና ኮ ኡሱ ጌሲ ቱቃሞን ዎይቻ ካሌራ ቀያፋ፥ “እስን ኮና ላካሳን! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />ጎሳ ዱባ ካባሮኮ ጎሳ ማራን ኦዶ ኮ ጎጎየ እስኑን ካእዳን ላኖ ላኮሻዳታን? አመ።” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />ሂካ ካአመራ እስኮ ላኮየ፥ አየሱን ጎአመን ኡሱ ጌሲ ኡሱ ቱቃሞን ዎይቻ ማንኮሌረ ማራን፥ የሱሳ ጎሳን ካጎይናሮ ላኖ ሂናኣ ሄገሮ አዬሳኖያ። <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />ኡሱ ካኮንጎዋራ ጎሳ ካላዉን ሀሌኖን ግራን ካዳራመሮ ይስ ካዋ ራቶ ኩኩይስንያ።<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />ኤሰ አርኮ ሀጋአበሬን የሱሳ ላጋዲን ማካረን። <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />ሃንሱን የሱሳ ኤሰኮ አባባተረ አይሁድ ኦሮ ዲዳ ቤ ላኮሰሴተሮ፥ አየሱን ጎአመን ኡል ቃሉላቶክ ዶሌ ታግቶ ኤፍሬም ካአማማሮ ማማን ቶስ ሴተረ ኤሴና ኡሱኮ ኦአጋልሳታረነ ዎታ አዳላተ።<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />ካአይሁድ ፋስካ ጎጎጋባላሜ፥ ባላ ግያኖኮ ሆረነ ካሙጭማኖ ሴራ ፈልን ኦሞጋን ኡል ኡልኮ ኢየሩሳለም ቶስ ቤን። <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />የሱሳና ዶታ ግረን፥ ቁሉክ ምን ካዋይ አሌነ፥ “መአን ላራ? ባላን ሱረ ላኮኤሜሮያ?” አማ እስእስ ሆሳተን። <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />ካቱቃሞ ዎይቻልና ፋራሳዊል አደ የሱሳ አብን ኤቲ ግሮ ካካሳ እባዶ ጎጎቱስሮና ጎጎአብሮን አጃጄን ግረን።<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s1">የሱሳ ብታንያይ ሽቶ ሽግዳማኖ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶ. 26፡6-13</ref>፤ <ref loc="MRK 14:3-9">ማር. 14፡3-9</ref>፤ <ref loc="LUK 7:37-39">ሉቃ. 7፡37-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />ካፋስካ ባላዉን አሪ ሌዎ ሄሳ የሱሳ፥ ጎይኮ ካኬሰራ አላዛር ማንኮግሮ ብታንያ ቶስ ሴተ። <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />ኤሴና የሱሳን ክታ ካሄመነ ኤካሰን፥ ማርታ ጎሀንዳይቶ፥ አላዛር ኡሱነ ዎታ ባቦ ኣምን ካሀማጼሮኮ ኮየ። <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />ማይራመና ዶክ አዉኣሎ ታሌተ ሊትሮ ምና ታሙጭንተ ታናርዶሳ ሽቶ ኬንተዴ ሉክ ታየሱሳ ጉት ክብተ፥ ሉክቴሳና መተክሴይ ሻካርተ፥ ምና ሽቶኮት ኡርቲ አማጋመ።<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፡37-38</ref>።</char></note> <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />የሱሳኮ ኦአጋልሳታራንኮ ኮ ዳንበኔ ሮርሰ ካስሰራ ካአስቆሮቱ ይሁዳ አደ ኔባታ፥ <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“ህት ሽቶ ሴድ ቦሌ ጣጋራዉን ዳዳላምደ ማራጋደና ህየሳን ሙን ስስዋተ?” አመ።<note caller="+" style="f"><char style="fr" closed="false">12፡5 </char><char style="ft" closed="false">ዲናራ፦ ፈላተ ካባራሮን አሪ ቶክ ዳሞዛያ</char></note> <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />ሂካ ካኮንአዬሰራ ካማራጋደ ሽለ ካአባረ ማንኮሌ ማራን ካካማሮ ማራጋደኮ ኡሱን አታተ ካሃረ ሄቶ ማንኮሌዉን ኳሬ ህየሳን ማራረረ ላኮየ።<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />የሱሳን፥ “ህት ሽቶ ታቃማል አርዉን ካየልተቶ ኤካሳኖ ማንኮሌ ማራን ኢሳጋ። <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />ህየሳል ማጎሬና እስን ዎታ ግራን፥ እን አዴን አሪ ዱባ ላኮሄልናታን፥” አመ።<note caller="-" style="x"><char style="xo" closed="false">12፡8 </char><char style="xt" closed="false"><ref loc="DEU 15:11">አዳ. 15፡11</ref>።</char></note><verse eid="JHN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />ኡሱ ጎራታ ካሞጋን ካአይሁድ እባዶ የሱሳ ኤሰ ግራኖ አዴሰረን ኡሱ ቶስ ኤመተን፥ ኦኤሜተራና የሱሳ ካላ አመን ሀሌኖን ግራን፥ ኡሱ ጎይኮ ካኬሰሮ አላዛርና ዲንያ። <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />ሃንሱን ቱቃሞኮክ ዎይቻል አደን አላዛር ላጋዲን ማካረን። <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />ህክና ኣላንቲቴሳ ካሞጋን ካአይሁድ እባዶ የሱሳ ቶስ ሴቴረ አማና ማንኮግረ ማራንያ።<verse eid="JHN 12:11" /></para>
  <para style="s1">የሱሳ ካባጃ ኢየሩሳለም ቶስ ታባኖ</para>
  <para style="r">(<ref loc="MAT 21:4-9">ማቶ. 21፡4-9</ref>፤ <ref loc="MRK 11:7-10">ማር. 11፡7-10</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፡28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />ባባርንሳ ባላን ካኤመታራ ጎሳ ካሞጋን የሱሳ ኢየሩሳለም ቶስ ኤመታ ግራኖ ማለን፥ <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />ባላሎ ኦዛንባባ አበን ቆጳይን ቤን፥ ያየትሶና ጦቂሴነ፥ “ሆሳኢና!” “መገ ካጎታይ ካኤመታራ ካሶማሳመያ!” “ዎኖ ካእስራኤል ካሶማሳመያ!” አመን።<note caller="-" style="x"><char style="xo" closed="false">12፡13 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">ማዛ. 118፡25-26</ref>።</char></note><verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />የሱሳና ዳርሜ ታደሜር ሄላተረ ሀማጼ፥ ሃ አማመና ጎጎጻፋመሮ፥<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“ኤረ ካጽዮን አሮአብሳተ!</para>
  <para style="q1" vid="JHN 12:15">ሂክማ ዎኖካ ዳርሜ ታደሜር ሀማጼረ ኤመታራ”</para>
  <para style="q1" vid="JHN 12:15">አማሜን ኦጻፋመራን ሄገሮ ጎጎጉዳራዉንያ።<note caller="-" style="x"><char style="xo" closed="false">12፡15 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዛኪ. 9፡9</ref>።</char></note><verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />የሱሳኮ ኦአጋልሳታራና ሂካ ዱባ ሆራርጀ ላኮሻደረን፥ ኡሱ ማራን ካጻፋመራና ኡሱና ኦፈላመሬን ፈሎ ካኮአዴሰራን የሱሳ ካባጃመ ካኮአባባታረ ጎራታያ።<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />የሱሳ አላዛር ጉምቢኮ ኡመጉረ ጎይኮ ካኮኬሰረ ጎራታ፥ ኡሱነ ዎታ ካግረ እባዶ ዱባ ጎይኮ ክያኖኬሳ አቶታ ግረ። <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />እባዶ ካሞጋን ኡሱ ሂካ ባሳክ ማላታ ፈላኖ ማንኮማለረ ማራን ቆጳይን ቤ። <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />ሃንሱና ካፋራሳውል እባዶ እስእስኦሮ፥ “ጎርታ መ የላኖ ዶትሳራ? ዴተነ! አላም ዱባ ምና አባባተ ኡሱ ዴበ ሰሴተራ” እስኦሮ አመን።<verse eid="JHN 12:19" /></para>
  <para style="s1">የሱሳ ጎይኬሳ ጣየ አዬሰ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />ሄዶይሳዪን ባላ ቶስ ኦቤራን ኦሮኮ ካግርክ እባዶና ግረ። <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />እሶና ጋሊላ ታግቶ ቤተሳይዳኮ ካሌሮ እባዶት፥ ፍልጶሳ ቶስ ኤሜተነ፥ “ጎታ፥” ማጋኔ፥ “ኖ የሱሳ ድን ዶታና” አመን።<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />ፍልጶሳና፥ እንድራሳን ሰግን ሴተ፥ እንድራሳና ፍልጶሳና ሴተረነ የሱሳን ሰገን።<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />የሱሳና፥ “ኤረ ካእባዶ ታኮካባጃምናራ ሳቲ ጌተታ። <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />አን ሩምና ሩምና አማራ፥ ኢል ታዳርጋማ ኤሬ ጉት ኢደ ጎጎኖን ካለ ሄሳታ፥ ጎጎተ አደ ኢል ታሞጋን ስሳታ።<note caller="-" style="x"><char style="xo" closed="false">12፡24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፡39</ref>፤ <ref loc="MAT 16:25">16፡25</ref>፤ <ref loc="MRK 8:35">ማር. 8፡35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9፡24</ref>፤ <ref loc="LUK 17:33">17፡33</ref>።</char></note> <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />ኔፎቴሳ ካጌላታራ ዋታራ ሂካ አላምን ኔፎቴሳ ካዲዳራ አደ ጅሩ ጅሮማክ ግር ኡሱ ኦራታራ። <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />እዬን ሀንዳይን ካዶታራ ጎግረ እን ዴበ ሀሰሴተ፥ አንና ማንኮግሮ ኢን ካሃንዳራና ኤሰ ግርናራ ኢን ካሀንዳሮና ኣቦክ ካባጅሮዋ።<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“ግዳ ኔፎት ጫናቃንተታ መ አምራ? ‘ኣቦክ ህታ ሳትኮ እን ሃስ አሙ’? ሀሌዎ ካኮንኤሜየራ ህታ ሳቲዉንያ። <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />ኣቦክ! መገካ ካባጂ” አመ።</para>
  <para style="p" vid="JHN 12:28">ኤሰኮ አባባተረ፥ “መገኬና ካባጃየራ፥ አድና ካባጅናራ” ታአማታ ያየ ዳሩርኮ ኤመተ። <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />ኤሰ አሌ ካግረ ካሞጋን እባዶ ያየ ካኮማላረ ጎራታ፥ “ሁሩንታ” አመ፤ ካካለ አደ፥ “ኤርግቻያ ካአዬሳራ” አመ።<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />የሱሳ፥ “ህት ያየ ካኮንኤሜተታ እን ማራን ሀሌኖን ግራን እስን ማራንያ፥ <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />ሂክ አላም ካኮፍርዳምናራ ጎራታ ግዳያ፥ ሂካ አላም ኮክ ሞቲ ግዳ ሳርድ ሻፋምናራ። <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />አን አደ ኡልኮ ጦቂ ጦቂ ካኮአመ ጎራታ እባዶ ዱባ እን ቶስ ኩኩይስናራ።” አመ። <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />ሂካ ካኮንአዬሰራ ምስክ ጎይ ጎይናሮ ቱስንየ።<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />ጎሳና፥ “ኖ ክርስቶሳ ጅሩ ጅሮማን ግራኖ ሴራኮ ማልነና፥ ሀያ፥ ‘ኤረ ካእባዶ ጦቂ ጦቂ አማኖ ዶትሳራ ምሲ አማታ’? ሂክ ‘ኤረ ካእባዶ አዮያ’?” አመን።<note caller="-" style="x"><char style="xo" closed="false">12፡34 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዛ. 110፡4</ref>፤ <ref loc="ISA 9:7">ኢሳ. 9፡7</ref>፤ <ref loc="EZK 37:25">ሕዝ. 37፡25</ref>፤ <ref loc="DAN 7:14">ዳኔ. 7፡14</ref>።</char></note><verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />የሱሳና፥ “ጎርታኑ ጎራታ ክጫሩን ኢፋ አብታን፥ ሙጉድ ሀኤመኖን ግራን፥ ኢፋ ግራን ሰሴየን፥ ሙጉድ ካሰሴታራ ኤትራ ሴታሮ ላካሶ። <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />ይስ ካኢፋ ጎጎሌታዉን ኢፋ ግራንቱን ሂካ ኢፋ አማና።” አመ። የሱሳ ሂካ አዬሰ ጎጎጉድሴ ካለ ቤ ጎላተ።<verse eid="JHN 12:36" /></para>
  <para style="s1">አይሁድ አማኖዋቲ አታታኖ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />የሱሳ ሂካ ማላታ ዱባ እሶ ሆረ ጎፈለና ሱረ ግዳና ላኮአማናተራን። <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />ህክና ካሄገሮ እስያሳ፥</para>
  <para style="q1" vid="JHN 12:38">“ጎታክ አቶናትካን አዮያ ካአማነ?</para>
  <para style="q2" vid="JHN 12:38">ካጎታ ሁናና አዮን ሙተ?”</para>
  <para style="m" vid="JHN 12:38">ካአማመራ ሃፉራ ጎጎጉዳሮንያ።<note caller="-" style="x"><char style="xo" closed="false">12፡38 </char><char style="xt" closed="false"><ref loc="ISA 53:1">ኢሳ. 53፡1</ref>።</char></note> <verse eid="JHN 12:38" /><verse number="39" style="v" sid="JHN 12:39" />ሃንሱን አማንን ላኮዳንዴራን፥ ህክና እስያሳ ባንኤ ታካለይ ሃ አመ ጎጎአዬሰሮያ።<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“እልኦ ኦትሶይ ጎጎድያኖንኮ</para>
  <para style="q2" vid="JHN 12:40">ዎዳናትሶይና ጎጎሻዶንኮ</para>
  <para style="q2" vid="JHN 12:40">አባባይና ጎጎፋይኖንኮ</para>
  <para style="q1" vid="JHN 12:40">ዋ እልኦ ኦትሶ ባሰራ፥</para>
  <para style="q2" vid="JHN 12:40">ዎዳናትሶና ዱድሰራ።<note caller="-" style="x"><char style="xo" closed="false">12፡40 </char><char style="xt" closed="false"><ref loc="ISA 6:10">ኢሳ. 6፡10</ref>።</char></note>”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />እስያሳ ሂካ ካኮንአመራ ካባጃቴሳ ማንኮዴሮ ማራንያ፥ ጋራኬሳና አዬሰ።<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />ጎሌና፥ ካአይሁድ ዎይቻልኮና ካሞጋን ኡሱ አማነ፥ ሀሌዎ ኳሬ ፋራሳዊል አይሁድኮክ ምን ካኤብኮ እሶ ጎጎቤሶንኮ አብሳቴረን አማናኖክሶ ቤሴን ላኮሰጋተረን። <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />ህክና ካኮንሌራ ዋኮ ታኤማቶ ካባጃኮ ሮርሳተን እባዶ ዶለኮ ታኤማቶ ካባጃ ማንኮጌላተን ማራንያ።<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />ኤሰኮና የሱሳ ያየ ጦቂሰረ፥ “ማዮና እዬ ጎአማነ እን ካላሊ ሀሌኖን ግራን እን ካፋረሮና አማናራ። <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />እን ካድያራ እን ካፋረሮ ድያራ። <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />እዬ ካአማነ ሙጉዲ ጎጎግሮንኮ ኢፋሌ አላም ቶስ ኤመየራ።<verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />“ሃፉራኬ ማልረ ካኦራኖ ጉት ካፍርድናራ ላኮአንዮ፥ አን አላም ፋይስን ኳሬ አላም ጉት ፍርድን ላኮኤሜየሮ። <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />እን ካአታኖና ሃፉራኬ ካየራሳሮ ጉት አን ካኮፍርድናሮ አባ፥ አን ካአዬሰራ ሃፉራ ኡሱዋ ታጋቾ አሪ ፍርድናራ፥ ኣላንቲና <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />አን እስኮ ላኮአዬሳሮ አየሱን ጎአመን እን ካፋረራ ኦዶ መ አዬስናሮና ምሲ አዬስናሮ አጃጄራ። <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />አጃጃከሳ ጅሩ ጅሮማክ ግር ላኖ ካሶዋ፥ ሃንሱን አን ካአዬሳራ ዱባ ኦዶ ካሰገሮ ካላያ አመ አባበ።”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s1">የሱሳ ኡሱኮ ኦአጋልሳታረን ሉቃ. ኣልሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />ጎራታና ካፋስካ ባላኮ ሆረነ ግረ፥ የሱሳና ሂካ አላም ኢሰረ ኦዶ ቶስ ካኮሴይናራ ጎራታ ግያኖ አዴሰረ፥ አላም ኦግረን ኦቴሳ ኦሌራን ጌላተራ፥ ታ ጋቾ ጌሮና ጌላተ።<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />ክታ ካሄመነ ሆረ ሮረ ግራን፥ የሱሳ ሮርስ ጎጎስስሮን ዳብሎሳ ኤረ ካስሞና ካአስቆሮቱ ይሁዳ ዎዳና ከኬሰ ግረ። <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />የሱሳና፥ ኦዶ አየስ ዱባ ኦዶናትኬሳ ሄገሊ ጎጎየለሮ፥ ዋኮ ፋራማኖና ዋ ቶስ አባባታኖኬሳ አዴሰረ፥ <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />ክታ ካሄመነኮ ኬ፥ ሳርስ ካየጉረ ሞኢና ሆጮ ሞዋተ። <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />ኤሰኮና ካኮአልሳራን ሁይ በከ ክበረ ኡሱኮ ኦአጋልሳታሬንኮኒዕ ሉቃ. አልሳ ታሙዋተሮ ሆጮ ሻካራኖ ሀጋአበ። <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />ስሞና ጴጢሮሳ ቶስ ኤመተ፥ ጴጢሮሳና፥ “ጎታክ፥ አት ሎቃቆኦተ አልስናታ?” አመ። <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />የሱሳና አባበረ፥ “አን ካፈላሮ አት ግዳ ላካሶ፥ ሃሬ አድ ሻዶዋ” አመ። <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />ጴጢሮሳና፥ “ላ አት ሎቃኦተ እንኮ ሱረ ላኮአልሶ አመ። የሱሳና አን ኩ ጎአልሳናዋየ አት ኢነ ዎታ ኤሴላ ላኮአብቶ” አመ። <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />ስሞና ጴጢሮሳና፥ “ጎታክ” ጎርታኑን “ሎቃቆኦተ ኦላል አንሌኖን ግራን ገነቴና መተኬና አልስና አመ።” <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />የሱሳና፥ “ማር ካአለሮ እባዶቲን ካዶትሳራ ሎቃቆ ኦላል አላኖያ፤ ካሄሰራ ማር አደ ካሙጭመያ። ዱባና ጎላናዋቴና እስን ኦሙጭንቴንታን” አመ። <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />እስን ዱባና ኦሙጭንቴን ላኮታን ኡሱ ካኮንአመራ ኡሱ ሮርስ ካስስናራ አዮዮ ማንኮካሶ ማራንየ።<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />ሎቃቆኦትሶ ኣልሰ አባባተረ፥ ሁ ሳርሳተ አባባተረ ባንኤ ሀማጼረ፥ ሃና አመ፥ “አን እስኑን ካፈለሮ ሻዳታን<note caller="-" style="x"><char style="xo" closed="false">13፡12 </char><char style="xt" closed="false"><ref loc="LUK 22:27">ሉቃ. 22፡27</ref>።</char></note>?” <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />“እስን፥ እን ‘ካአጋልስሳሮና’ ‘ጎታ’ አማታን፥ ጋራያ፥ ጎጎአማታን ኡሱማሌዋያ። <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />ጎርታ አን ጎታክስና ካአጋልስሳሮ ሌ ግራን ሎቃቆኦትስን ጎአልሰ፥ እስና ሂካማሌ እስእስኦሮ ሎቃቆኦትስን አልሳዪን ዶትሳራ። <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />አን ጎጎፈለሮክ ማለ እስና ሂካማሌዋ ጎጎፈልታኑን ማሱሳ ሰገራ። <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />አን ሩምና ሩምና አማራ፥ ካሃንዳራ ጎታኮ፥ ካፋራመራና ካፋረሮኮ ላኮሮራሮ።<note caller="-" style="x"><char style="xo" closed="false">13፡16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">ማቶ. 10፡24</ref>፤ <ref loc="LUK 6:40">ሉቃ. 6፡40</ref>፤ <ref loc="JHN 15:20">ያን. 15፡20</ref>።</char></note> <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />ጎርታ ሂካ አየስ አዴስዴነ ፈሎይ ጎሀይሴን ኦሶማሳንቴንታን።<verse eid="JHN 13:17" /></para>
  <para style="s1">የሱሳ ሮር ስሳማኖ አዬሰ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“እስን ዱባን አዬሳኖ ላኮዮ፥ ኦአሳበሮ ካሶዋ፥ አየሱን ጎአመን፥ ‘ባቦኬ ኢነ ዎታ ካኤብሳተራ ዲና ሌ ኬ ካአማራ ማጻፋ ቁሉክኮክ ሃፉራ ጎጎጉዳሮንያ።<note caller="-" style="x"><char style="xo" closed="false">13፡18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዛ. 41፡9</ref>።</char></note>’<verse eid="JHN 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19" />“ካኮጉዳተ ጎራታ አን ላኖ ጎጎአማንታኑን፥ ሂክ ላኖኮ ሆረነ ግዳ ሰገራ። <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />አን ሩምና ሩምና አማራ፥ አን ካፋረሮ ካአታታራ እን አታታራ፥ እን ካአታተና ካፋረሮ አታታራ።<note caller="-" style="x"><char style="xo" closed="false">13፡20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10፡40</ref>፤ <ref loc="MRK 9:37">ማር. 9፡37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9፡48</ref>፤ <ref loc="LUK 10:16">10፡16</ref>።</char></note>”<verse eid="JHN 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />ሂካ አመ አባባተረ የሱሳ አያና ሻላጋመረ፥ “አን ሩምና ሩምና አማራ፥ እስን ኦሮኮ ኮ እን ሮርስ ስስናራ” አመ አዴስሰ ሰገ።<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />የሱሳኮ ኦአጋልሳታረን ኡሱ አዮ አመሮ ግርድ አመረን እስእስኦሮ እስእሲ ድያተን። <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />እሶኮ ኮ፥ የሱሳ ካጌላታረ ኡሱኮ ካአጋልሳታረ የሱሳ ዶሌ ጋባላመ ሀማጼ ግረ። <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />ስሞና ጴጢሮሳና ሂካ ኡሱኮ ካአጋልሳታረን ማላታ ቱሰረ “ማዮ አማሮ ሆሳ” አመ።<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />ኡሱና ጌግዮ ታየሱሳ ጋባላመረ፥ “ጎታክ፥ ኩ ሮርስ ካስስናራ አዮያ?” አመ ሆሳተ።<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />የሱሳና “ሂካ ባቦ ቱዋኖ ኮ ካነአምራነታ ኤገረ ካኮንስሳራ ኡሱያ” አመ። ኤሰኮና ባቦ ካነአምራነታ ኤገረ ኤረ ካስሞና ካአስቆሮቱ ይሁዳ ቱይሰ። <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />ይሁዳና ባቦ ቱዋኖ ኮ ጎጎቱዋቴ ጎርሰዋ ጻላየ ታብተ። የሱሳና፥</para>
  <para style="p" vid="JHN 13:27">“ካፈልናቶ ሳሜ. ፈል” አመ። <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />ሀሌዎ ኳሬ የሱሳ መዉን ሃ አመሮ ኣምን ኦሀማጼራንኮ ማዮና ላኮአዴሰሮ። <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />ይሁዳ ማራጋደ ካአባረ ማንኮሌ ማራን ባላን ካዶትሳሮ ኮኮ ጎጎኢምኖን ጎርቱን ህየሳን ጎጎስስሮ የሱሳ ካአዬሰሮ ኣን ሌራ።<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />ይሁዳና ኡሱ ባቦ ቱዋኖ ኮ ጎጎቱዋቴ ቤ ሴተ ጎራታና ሄመንየ።<verse eid="JHN 13:30" /></para>
  <para style="s1">ጴጢሮሳኮክ ካካታኖ የሱሳ አዬሰ</para>
  <para style="r">(<ref loc="MAT 26:33-35">ማቶ. 26፡33-35</ref>፤ <ref loc="MRK 14:29-31">ማር. 14፡29-31</ref>፤ <ref loc="LUK 22:33-34">ሉቃ. 22፡33-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />ይሁዳ ካኮቤቦዋረ ጎራታ፥ የሱሳ ሃ አመ “ግዳ ኤረ ካእባዶ ካባጃመዋ ኡሱይና ዋ ካባጃመዋ። <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />ጎርታ ዋ ኡሱይ ጎካባጃመ፥ ዋ ኤረኬሳ እሲ ካባጃታራ፥ ጎርሰዋ ካባጅናራ።<verse eid="JHN 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33" />“ይስኬ፥ እስን ዎታ ካኮአዳላይናራ ጎራታ ክጫሩንያ፥ እስና እን ዶትናታን፥ አይሁድነ፥ አን ማንኮሴታሮ ኤመይን ላኮዳንዴታን እሶን ጎጎአመሮ፥ ግዳና እስኑን ሂካዋ አማራ።<note caller="-" style="x"><char style="xo" closed="false">13፡33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">ያን. 7፡34</ref>።</char></note><verse eid="JHN 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34" />“አጃጃ ካኡሱብ ስስናራ፥ ህክና እስእስኦሮ ጎጎጌላታዉንያ፥ ጎርታ አን ጎጎጌላየሮ ማለ እስና እስእስኦሮ ጌላየነ።<note caller="-" style="x"><char style="xo" closed="false">13፡34 </char><char style="xt" closed="false"><ref loc="JHN 15:12">ያን. 15፡12</ref>፤ <ref loc="JHN 17">17</ref>፤ <ref loc="1JN 3:23">1 ያን. 3፡23</ref>፤ <ref loc="2JN 1:5">2 ያን. 5</ref>።</char></note> <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />እስን እስእስኦሮ እስእሲ ጎጌላቴን፥ እባዶ ዱባ እስን ኦተ እንኮ ኦአጋልሳታን ላኖ ሂካኒ አዴስናራ።”<verse eid="JHN 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />ስሞና ጴጢሮሳ፥ “ጎታክ ሀገራ ሴይናታ?” አመ። የሱሳና፥ “አን ማንኮሴታሮ ግዳ ዴበ ሴይን ላኮዳንዴቶ፤ ሃሬ አድ እን ዴበ ሰሴቶዋ አመ አባበ።”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />ጴጢሮሳና፥ “ጎታክ፥ ግዳ አን ኩ ዴበ ሰሴታና ካኮንዋታራ መዉንያ? ኩ ማራን ኔፎቴ ጎሌተና ሮርሳይ ስሳይናራ” አመ።<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />የሱሳና፥ “ኦግራን ኔፎታ እዬን ሮርስ ስስናታ? አን ሩምና ሩምና አማራ፥ ሉካለ ሀኦይኖን ግራን ሴድ ጋል እን ካካይናታ።” አመ አባበ።<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s1">የሱሳ ኡሱኮ ኦአጋልሳታረን አታይሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“ዎዳናትስን አሮጫናቃሞ፥ ዋይ አማና፥ እና አዳ. አማና። <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />ኣቦኬክ ምኒ ምንጆል ካሞጋን ካግራ፥ ሂክ ልዋተዋ አን ሰጋረዋ፥ ካኮንሴይናራ ባንኤ ኤካስንያ። <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />አን ሴይረና ባንኤ ካኮኤካሰ ጎራታ፥ አን ማንኮግሮ እስና ኢነ ዎታ ጎጎግርታዉን እስን ኣትን ካላም ኤመይናራ። <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />አን ካኮሴታራ ራ ማኤክዮ እስን ካሳንዋ።”<verse eid="JHN 14:4" /></para>
  <para style="s1">ኦዶ ቶስ ካጌሳሮ ራ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />ቶማሳና፥ “ጎታክ፥ ኤትራ ስያቶ ላካንሶ፥ ሀያ፥ ራ ምሲ አዴስን ዳንዳና?” አመ። <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />የሱሳና፥ “ራ አንያ፥ ሩምና ግርና አንዋያ፥ ጋራኬነ ጎሌ ኳሬ ኦዶ ቶስ ካኤመታራ ላግሮ። <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />እን ካካሳን ሌቴንዋ ኣቦኬና አዴሳተንዋ፥ ግዳኮ ሀጋአብዴነ አድ አዴሳንዋ፥ ዴተታን።” አመ።<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />ፍልጶሳና፥ “ጎታክ፥ ኦዶ ቱስና ኖን ሌራ” አመ። <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />የሱሳና፥ “ፍልጶሳ! ግዳ ጊን አን እስኔ ዎታ ጎግሮ እን ላካሶያ? እን ካዴ ኦዶ ዴራ፥ ምሲ ኖን ‘ኦዶ ቱስ አማታ’? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />አን ኦዶ ጎጎግሮ ማለ፥ ኦዶና እዬ ግራኖ ላኮአማናቶያ? አን እስኑን ካሰጌራ ሃፉራ እስኮ ላኮዮ፥ አየሱን ጎአመን ፈሎ ካፈላራ እዬ ካግሮ ኦዶያ። <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />አን ኦዶ ጎጎግሮ ማለ ኦዶና እዬ ጎጎግሮ ማለ አን እስኑን ካሰጋሮ አማና፥ ካካለ ጎሄሰና ፈሎ ኦቴሳ አማና። <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />አን ሩምና ሩምና አማራ፥ እዬ ካአማናራ አን ኦፈላሮ ፈሎ ፈላራ፥ ህክና አደ አን ኦዶ ቶስ ማንኮሴይናሮ ማራን፥ ሂካኮ ካሮረ ፈልናታን። <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />ኦዶ ኤረ ጎጎካባጃምሮ፥ መገኬይ ካኤባታን ዱባ ፈልናራ። <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />ማምስክ አዬስና መገኬይ ጎኤባቴን፥ አን ፈልናራ።<verse eid="JHN 14:14" /></para>
  <para style="s1">አያና ቁሉክ ማራን ታስሳንተቶ አብድ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“ጎጌላቴን አጃጃኬ ኦራይናታን። <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />አን ኦዶ ኤባይናራ፥ ኡሱና እስን ዎታ ጅሩ ጅሮማን ካግሮ ካካለ ካጎጎእስሮ ስስናራ። <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />ኡሱና አያና ቁሉክያ፥ አላም ማንኮዴኖን ማራንና ማንኮካሶን ማራን አታይን ላኮዳንዳሮ፥ እስን አዴን፥ እስን ዎታ ማንኮግርናሮ ማራና እስን ኦሮ ማንኮልናሮ ማራን ካሳንዋ። <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />ኦዶ ካላይክ ይስ ኣን አን እስን ላኮእስናሮ፥ እስን ቶስ ኤመይናራ። <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />ጎራታ ክጫርኮ አባባይ፥ አላም ሱረ እን ላኮድናሮ፥ እስን አዴን ድናታን፥ አን አርዶክ ማንኮሌ ማራን እስና አርዶኒዕ ልናታን። <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />አን ኣቦኬይ ጎጎግሮ ማለ፥ እስና እዬ ጎጎግታን ማለ፥ አንና አደ እስኒ ጎጎግሮ ማለ ኤሰ አሪ አዴስናታን። <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />እን ካጌላታራ አጃጃኬ ካኦራታሮያ፥ ካጌላታሮና ኣቦክ ጌላታራ፥ አንና ጌላታራ፥ እስኦቴና ቱስናራ።”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />ኤሰኮና ካአስቆሮቱ ካሌኖን ይሁዳ፥ “ጎታክ፥ ሀያ፥ አላምን ሀሌኖን ግራን እስኦታ ኖዬን ካኮቱስናታ ምሲያ?” አመ።<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />የሱሳና፥ “ካጌላታራ ጎግረ ሃፉራኬ ኦራታራ፥ ኣቦክና ጌላታራ፥ ኡሱ ቶስ ኤሜይናና፥ ኡሱ ዎታና ግርናና። <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ካጌላኖን ሃፉራኬ ላኮኦራታሮ፥ ሂክ ካማላታን ሃፉራ እን ካፋረሮ ካኦዶያ ኳሬ ካኬ ላኮዮ።<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“ግዳ እስኔ ዎታ ግራን ሂካ ዱባ ሰገራ። <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />ኦዶ መገኬይ ካፋራራ ካጎጎኢሳራ አያና ቁሉክ አደ አየስ ዱባ አጋልስስናራ፥ አን ካሰጌሮና ዱባ ሻድስናራ። <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" />ኖጎዳ እስኑን ካይናራ፥ ኖጎዳቴና ስስናራ፥ አን ታስሳራ አላም ታስሳሮ ኣንትት ላኮቶ፥ ዎዳናትስን አሮጫናቃሞ፥ አሮናአብሳኖ። <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />‘አን ሴይናራ፥ አባባይና እስን ቶስ ኤመይናራ’ አማኖኬ ማልቴታን፥ ኣቦክ እንኮ ማንኮሮራሮ ማራን እን ካጌላታን ሌቴንዋ ኦዶ ቶስ ብያኖኬይ ገገላተንዋ። <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />አን ካሰጌራ ጎጉዳተ ጎጎአማንታኑን፥ ሂክ ላኖኮ ሆረ ጣየ ሰገራ። <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />ሂካ አላምኮት ሞት ጻላየ ማንኮኤመታቶ ማራን ሂታኮ ዳንቤባን እስን ዎታ ታንጂን ላኮአዬስናሮ፥ ኡሱና እን ጉት ኦዶናት ላኮአቦ፥ <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />አየሱን ጎአመን አን ኦዶ ጎጎጌላታሮ፥ ማለ ኣቦክ ካስሰሮ አጃጃ ጎጎፈላሮ፥ አላም ጎጎአዴስሮንያ። ክያ፥ ሂታኮ ሴኖ” አመ።<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s1">ጋ ካዎይኒና ባላል</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“ካሩም ጋ ካዎይኒ አንያ፥ ካአባራተራና ኣቦኬያ። <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />ኡሱና እን ጉት ታግቶ ኢል ካዱባሞን ባላል ዱባ ኣቦክ ጎስ ሉጉድናራ፥ ኢል ካስሳሮ ባላል ዱባ አድ ኣሎ ኢል ጎጎዱባንቶን ኢድስ ቃጭስናራ። <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />ካሰገሮ ሃፉራኮ ካከይ እስን ግዳ ኦሙጭንቴንታን። <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />እዬ ግራ፥ አንና እስኒ ግርናራ፥ ባላል ጋ ካዎይኒ ጉት ጎሌኖን ካለ ኢል ስስን ላኮዳንዳሮ፥ እስና እዬ ጎግኖን ኢል ስስን ላኮዳንዳታን።<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“አን ጋ ካዎይኒያ፥ እስና ባላልታን፥ ማዮና እዬ ጎግረ አንና ኡሱ ጎግረ ኡሱ ኢል ታሞጋን ስሳራ እን ካላይ ኮና ፈልን ላኮዳንዴታን። <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />እዬ ካግኖን ባላል ሻፋመ ካአንጋጋሮ ባላል ኣንክክያ፥ ሂካ ኣንክክ ባላል አባባም ኤለን ቶስ ሻፋምናረ፥ ጉባምናራ። <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />እዬ ጎግቴን ሃፉራክና እስኒ ጎግረ፥ ካዶታታን ማምስክ ኮኮና ኤባየን ስሳምሮዋ። <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />እል ታሞጋን ዱባማኖ እንኮ ኦአጋልሳታን ኦተ ላኖ ጎቱሴን፥ ሂካኒ ኣቦክ ካባጃማራ።<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />“ኦዶ እን ጎጎጌላተሮ አንና እስን ጌላየራ፥ ጌላንጀቴይ ግራ። <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />አን ኣቦኬክ አጃጃ ኦራዬረ ጌላንጀቴሳይ ጎጎግሮ ማለ እስና አጃጃኬ ጎኦራቴን ጌላንጀቴይ ግርናታን። <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />ገጌሎኦት እስኒ ጎጎሌራዉን ገጌሎኦትስን ኦአማጋሜን ጎጎሌራዉን ሂካ አን እስኑን ሰገራ። <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />አጃጃክ ሂካያ፥ አን ጎጎጌላየሮ ማለ እስና እስእስ ኦሮ ጌላየነ።<note caller="-" style="x"><char style="xo" closed="false">15፡12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ያን. 13፡34</ref>፤ <ref loc="JHN 15:17">15፡17</ref>፤ <ref loc="1JN 3:23">1 ያን. 3፡23</ref>፤ <ref loc="2JN 1:5">2 ያን. 5</ref>።</char></note> <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />ኦጌላታሮ ማራን ኔፎ ሮርሳይ ስሳታናኮ ታሮርቶ ጌላንጀ ማዮና ላኮአቦ። <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />አን እስን ካአጃጃሮ ፈሎይ ጎሀይሴን አን ኦጌላታሮታን። <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />ጎርታኑ ድይጆልኬ ላኮአምናሮ፥ ድይጆልና ጎታ ካፈላሮ ላካሶ፥ አየሱን ጎአመን ኣቦኬኮ ካማለሮ ዱባ ማንኮአዴስሰሮ ማራን ኦጌላታሮ አመራ። <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />አንያ እስን ካአሳባየራ ኳሬ እስን እን ላኮአሳብተታን፥ ሴይዴነ ኢል ጎጎየላታኑን ኢልትስና ጎጎግርቶን አን እስን ሹመራ፥ ሃንሱን ኦዶ መገኬይ ካኤባታን ዱባ ስሳራ። <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />እስእስ ኦሮ ጎጎጌላታዉን፥ አጃጃክ ሂካያ።<verse eid="JHN 15:17" /></para>
  <para style="s1">አላም የሱሳኮ ኦአጋልሳታራን ዲዳኖ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“አላም እስን ጎዲደ፥ እስንኮ ሆረነ እን ዲዳኖ አዴሳ። <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />እስን ኦአላም ሊ ግቴንዋ፥ አላም ኦቴሳ ላኖ አዴስረ እስን ጌላታረዋ፥ አን አላምኮ እስን ካለ የለ ማንኮአሳበሮ ማራን ኦአላም ላኮታን፥ አላምና ካኮንዲዳራ ሃንሱንያ። <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />ካሃንዳራ ጎታኬሳኮ ላኮሮራሮ አመ አን ካሰገሮ ሃፉራ ሻዳ። እን ሆሮራ ጎግሬን፥ እስና አድ ሆሮርናራን፥ ሃፉራኬ ካኦራተራን ጎሌን ሃፉራክስና ኦራይናራን።<note caller="-" style="x"><char style="xo" closed="false">15፡20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">ማቶ. 10፡24</ref>፤ <ref loc="LUK 6:40">ሉቃ. 6፡40</ref>፤ <ref loc="JHN 13:16">ያን. 13፡16</ref>።</char></note> <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />እን ካፋረሮ ማንኮካሶን ማራን፥ መገኬኮት ኣላንቲ ሂካ ፈልናራን። <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />ኤሜይ ሰግዋየዋ ጩቦ ላኮላረ፥ ግዳ አደ ጩቦክሶዉን አደ ኣላንቲ ላኮአባን። <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />እን ካዲዳራ፥ ኣቦኬና ዲዳራ። <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />ካካለ እባዶ ካፈሎንግሮ እሶ ኦሮ ፈልዋየዋ፥ ጩቦ ላኮላረ፥ ግዳ አደ እና ኣቦኬና ዴናን፥ ግዳ አደ እና ኣቦኬና ዲደራን። <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />ህክና፥ ‘ኣላንቲካላይ ዲዴን’ አማመ ሴራክሶይ ካጻፋመራ ሃፉራ ጎጎጉዳሮንያ።<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“አን ኦዶ ዶለኮ እስኑን ካፋርናራ፥ ኦዶኮ ካብያሮ ካጎጎእስሮ ካሩም አያና ካኮኤሜተ ጎራታ፥ ኡሱ ጋራኬ አቶትናራ። <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />እስና አዴን፥ ሆራርጀዋ ኢነ ዎታ ማንኮግቴን፥ ማራን አቶትናታን።<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“ሂካ ዱባ ካሰጌራ አማኖክስንኮ ጎጎሽርአሞንኮያ። <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />አይሁድ ካኮኩኩአማረኮና፥ ቤስናራን ሱረዋ ካላጋድናራ ዱባ ዋዉን ጎጎሀንዳየ ማለ ካኮቶታምራ ጎራታ ኤመታራ። <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />ሂካ ዱባ ካኮንየልናና፥ ኦዶ ጎርቱን እን ማንኮካሶን ማራንያ። <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />ሆረነ ሂካ አን እስኑን ካኮንሰጌራ ጎራታ ጎጌ ጎጎሻዳኑንያ፥ እስን ዎታ ማንኮግረ ማራን፥ ጣየ ሂካ ላኮሰጌሮ።<verse eid="JHN 16:4" /></para>
  <para style="s1">አያና ቁሉክኮኒዕ ፈሎ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />“ጎርታ እን ካፋረሮ ቶስ ሴይናራ፥ ሀሌዎ ኳሬ እስንኮ፥ ‘ሀገራ ሴይናታ?’ አም እን ካሆሳይናራ ላግሮ። <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />ሂካ አዬሳኖና ዎዳናትስን ጋዳ አማጋንተታ። <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />አየሱን ጎአመን አን ሩምና ሩምና አማራ ሴታኖክ እስኑን ላኦ ስስሮዋ፥ አን ጎሴታናዋየ ካጎጎኢሳራ እስን ቶስ ላኮኤሜታሮ፥ አን ጎሴየ አድ አያና ቁሉክ እስን ቶስ ፋርናራ። <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />ካኮኤሜተ ጎራታና አላም ጩቦ ማራን፥ ጋራ ካቁሉማና ጋራ ካፍርዳ አዴስስ ቱስናራ። <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />ጩቦክሶ አዴስሰ ካኮንቱሳራ፥ እባዶ እዬ ማንኮ አማኖን ማራንያ። <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />ጋራ ካቁሉማ አዴስሰ ካኮንቱሳራ፥ ኦዶ ቶስ ማንኮሴይናሮና ሂታኮ ዳንቤባን እን እስን ማንኮዴኖን ማራንያ። <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />ጋራ ካፍርዳ አዴስሰ ካቱሳራ ሂካ አላምኮክ ሞት ታሌተታ ጻላየ ማንኮፍርዳንተቶ ማራንያ።<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“ጋና ካሞጋን አን እስኑን ካሰግናራ ግራ፥ ግዳ አድ አታይን ላኮዳንዴታን። <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />ካሩም አያና ካኮኤሜተ ጎራታ ሩም ዱባ ቶስ ጌጌስሮዋ፥ ኡሱ እስኮ ላኮአዬሳሮ፥ ካማለሮ ካላል አዬሳራ፥ ኡሱማለና ሆረንባን ካልናሮ ሰግናራ። <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />ካኬ ካሌሮኮ ኣተረ ጎጎአዴሳዉን የላ እን ካባጅናራ። <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />ካኦዶ ካሌራ ዱባ ካኬያ፥ ጎርታ ‘ካከ ካለሮኮ ኣትረ ጎጎአዴሳዉን ሰግናራ’ ካኮን አመራ ሃንሱንያ።<verse eid="JHN 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“አሪ ኡጫርኮ አባባይ ላኮድናታን፥ ሀሌዎ ኳሬ አሪ ኡጫርኮ አባባይ አድ ድናታን።”<verse eid="JHN 16:16" /></para>
  <para style="s1">ያዳ ገጌሎ ቶስ ኢግልሳማኖ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />የሱሳኮ ኦአጋልሳታረንኮ ኮኮ፥ “ ‘ጎራታ ክጫርኮ አባባይ እን ላኮድናታን፥ ሀሌዎ ኳሬ ጎራታ ክጫርኮ ዳንበኔ አድ ድናታን ኡሱማለና፥ ኦዶ ቶስ ማንኮሴይናሮ’ ማራን ጎአምሮ መአማኖያ?” እስእስ ኦሮ አመን። <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />“ ‘ጎራታ ክጫር አማኖ መ አማኖያ?’ ኡሱ ካአዬሳራ አየስ ላኮታበሮ” አማ እስእስ ኦሮ ሆሳታ ግረን።<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />የሱሳና ኡሱ ሆሳይን ዶታኖ ካኮአዴሰ ጎራታ፥ “አን፥ ጎራታ ክጫርኮ ዳንበኔ እን ላኮድናታን፥ ‘ሀሌዎ ኳሬ ጎራታ ክጫርኮ ዳንበኔና አድ ድናታን ማንኮአመሮን፥ መ አማኖዮ እስእስ ኦሮ እስእስ ሆሳታን’? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />አን ሩምና ሩምና አማራ፥ እስን ኦይናታን፥ ጋድናታን፥ አላም አድ ገገላይናራ፥ ሀሌዎ ኳሬ ጋዳክስን ገጌሎ ቶስ ኢግልሳምናራ። <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />ሄለልትቲ አሪ ጊደ ኡሙላግራን ጫናቃማታ፥ ካኮኡሙልተ ጎራታ አደ እባዶ አላም ቶስ ማንኮኤሜተሮ ማራን ካጫናቃማተ ኢሎዋታ። <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />እስኑና ሂካማሌ ግዳ ካጋዳ ጎራታያ፥ ጎሌና አድ አን እስን ማንኮድናሮ ማራን እን ገጌላይሳራ፥ ገጌሎኦትስና እስንኮ ካኣትራ ላግሮ። <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />ኤሰርት እንኮ ኮና ላኮኤባይናታን፥ አን ሩምና ሩምና አማራ ኦዶ መገኬይ ካኤባታን ዱባ ስስናራ። <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />ግዳግን መገኬይ ኮና ላኮኤባቴታን፥ ኤባየን አታታንዋ፥ ገጌሎኦትስና ኦአማጋሜን ጎጎሌራዉን ኤባየን።<verse eid="JHN 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“ግዳግን ካሰጌራ ማሱሳይ ጎሌና ሂታኮ ሆረንባን ጋራ ካኦዶ ማሱሳይ ሀሌኖን ግራን ዲዳቤስ ካኮአዬስራ ጎራታ ኤመታራ። <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />ኤሰሪ መገኬይ ኤባይናታን፥ አንና ኦዶ እስን ማራን ላኮኤባይናሮ። <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />ኣላንቲና ኦዶ መተኬሳዋ እስን ማንኮጌላተሮ ማራና ዋ ዶለኮ ኤሜታኖኬ ማንኮአማንቴታን ማራንያ። <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />ኦዶኮ ቤረ አላም ቶስ ኤመየራ፥ ግዳ አደ አላም ኢሰረ ኦዶ ቶስ ሴይናራ” አመ።<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />ኤሰኮና የሱሳኮ ኦአጋልሳታራን ሃ አመን፥ “ጎርታ ግዳ አት ማሱሳ ካላይ አዴስሰ አዬሳ ግታ። <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />ግዳ አየስ ዱባ ጎጎአዴሳቶና ማዮና ኩ ሆሳይን ዶትስ ዋት አዴሴራን፥ ህክና ዋ ዶለኮ ኤመታኖ ጎጎአማኖን የለራ” አመን።<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />የሱሳና፥ “ግዳ አማንቴታን አማኖያ?” <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />“ሂክማ እስን ዱባና ራራነ ካኮዳርአምናታን ጎራታ ኤመተራ፥ ኡሱ ጎራታና ግዳያ፥ እና ካለ ኢሳግናታን፥ ሀሌዎ ኳሬ ኣቦክ ኢነታ ማንኮግሮ ማራን አን ላኮካለ ግሮ።<verse eid="JHN 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33" />“እዬ ግርዴነ ኖጎዳ ጎጎግርታኑን፥ ሂካ ሰገራ፥ አላም ግራንቱን ራኮ አብታን፥ አየሱን ጎአመን አላማንደ፥ አን አላም አዎደራ” አመ አባበ።<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s1">የሱሳ እስኦቴሳን ኤባታኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />የሱሳ ሂካ ሃፉራ አዬሰ አባባተረ፥ ዳሩር ቶስ ጦቂመረ ሃ አመ ኤባተ፥</para>
  <para style="pi" vid="JHN 17:1">“ኣቦክ፥ ጎራታ ጌራ፥ ኤረካ ኩ ጎጎካባጅሮ ኤረካ ካባጂና። <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />ካኮንካባጃታና አት ካስሰቶ ዱባን ኤርካ ጅሩ ጅሮማክ ግር ጎጎስስሮን እባዶ ዱባ ጉት ኦዶናት ማንኮስሰቶ ማራንያ። <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />ጅሩ ጅሮማክ ግርና አት ካላ ካሩም ዋ ሄዶና ካፋርተቶ የሱሳ ክርስቶሳ አዴሳኖያ። <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />አት ኢን ኦስሰተ ፈሎ ጉድሰጉረ ኩ ኡሊ ጉት ካባጄ። <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />ጎርታ ኣቦኬ! አላም ሀመጣሞን ኩኔ ዎታ ታግቴ ካባጃ ኩ ዶሌ እን ካባጂ።”<verse eid="JHN 17:5" /></para>
  <para style="s1">የሱሳ ኡሱኮ ኦአጋልሳታሬዉን ኤባተ</para>
  <para style="pi">
    <verse number="6" style="v" sid="JHN 17:6" />“ሂናኣ አት አላምኮ አሳብተደ እን ኦስሰቶ እባዶጃን መገካ አዴስሰራ። ኦታዬን፥ እዬን ስሰ፥ እሶና ሃፉራካ ኦራቴን። <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />አት ካስሰታ ዱባ ኩኮ ላኖ እሶ ግዳ አዴሴራን። <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />ኣላንቲና አት እን ካስሰቶ ሃፉራካ አን እሶን ስሰ ጎሌ አታቴራን፥ አንና ኩ ዶለኮ ብ ኤመታኖ ኦግራን እሶ አዴሴራን፥ አት እን ፋራኖና እሶ አማነራን። <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />እሶ ኦታ ማንኮሌራን ማራን እሶን ኤባይናራ፥ አት ኢን ኦስሰቶና ኦታ ኦሌራዉን ኳሬ አላምን ላኮኤባይናሮ። <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />ካኬ ካሌራ ዱባ ካካያ፥ ካካ ካሌራና ዱባ ካኬያ፥ እሶና ካባጃመራ። <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />ጎርታ አን አላም ኦሮ ላኮአዳላይናሮ፥ እሶ አደን አላም ኦሮ ግናን፥ አን ኩ ቶስ ኤሜታኖያ፥ ቁሉክ ኣቦክ፥ ኖ ኮ ጎጎሌነኖ፥ እሶና ኮ ጎጎሌናዉን ካስሰቶ መገ ኦር። <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />አን እሶነ ዎታ ታኮግረ፥ አት ካስሰቶ መገካይ እሶ ጎልሰራ፥ አንና ኦረራ፥ ካማጻፋ ሃፉራ ጎጎጉዳሮ ኮ ካባይ ኤረ ኳሬ እሶኮ ማዮና ላኮባየሮ።”<note caller="+" style="f"><char style="fr" closed="false">17፡12 </char><char style="ft" closed="false">አት ኢን ካስሰቶ መገ አን እሶ ኦረራ፦ ኮኮ ካሆርኮ ማጻፋል አት ኢን ካስሰቶ ዱባ መገካይ ኦረራ አማራ፥ </char></note><note caller="-" style="x"><char style="xo" closed="false">17፡12 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዛ. 41፡9</ref>፤ <ref loc="JHN 13:18">ያን. 13፡18</ref>።</char></note><verse eid="JHN 17:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="JHN 17:13" />“ግዳ እን ኩ ቶስ ኤሜታኖያ፥ አየሱን ጎአመን ገጌሎኦት እሶ ዶሌ ኦአማጋሜን ጎጎሌራዉን፥ ግዳ አላም ግራን ሂካ አን አዬሳራ። <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />አን ሃፉራካ እሶን ስሰራ፥ አን አላምኮ ላኮዮ፥ እሶና አላምኮ ላኮያን፤ ሃንሱን አላም እሶ ዲደራ። <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />ካኮን ኤባታራና ካሜላንኮ ጎጎኦርቶን ኳሬ፥ አላምኮ ጎጎቤሶን ላኮዮ። <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />አን አላምኮ ጎጎሌኖን ግሮ ማለ፥ እሶና አላምኮ ላኮያን። <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />ሃፉራካ ሩምያ፥ ሩምታይ ቁሎይስና። <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />አት አላም ቶስ እን ጎጎፋርተቶ አንና አላም ቶስ እሶ ፋረራ። <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />እሶ ሩምና ጎጎቁሎይናዉን፥ እስኦተ እሶ ማራን ቁሎይሳየራ።”<verse eid="JHN 17:19" /></para>
  <para style="s1">የሱሳ ኡሱ ካአማናሮ ዱባን ኤባተ</para>
  <para style="pi">
    <verse number="20" style="v" sid="JHN 17:20" />“አጋልስስክሶ አታቴረን እዬ ኦአማናራዉን አደረያ ኳሬ ሂናኣ ኦላሉን አን ላኮኤባይናሮ። <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />ህክና፥ ኣቦ! አት እዬ ጎጎግቶ፥ አንና ኩዬ ጎጎግሮ፥ ዱባና ኮ ጎጎሌናዉን፥ ኡሱማለና አት እን ፋራኖ አላም ጎጎአማኖን፥ እሶና ኖዬ ጎጎግራዉንያ። <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />ኖ ኮ ጎጎሌነኖ እሶና ኮ ጎጎሌናዉን፥ ታስሰቶ ካባጃ ስሰራ። <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />ህክና አን እሶ፥ አትና እዬ ላኖያ፥ አት እን ጎጎፋርተቶና እን ጎጎጌላተቶ ግታክ እሶና ጎጎጌላተቶ አላም ጎጎአዴስሮን፥ ኮናትክሶ ካአዴሳመ ሀሌዎ።”<verse eid="JHN 17:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="JHN 17:24" />“ኣቦኬ! ሂኒዕ አት ኢን ኦስሰታ፥ አን ማንኮግሮ ጎጎግራዉን አላም ሀመጣሞን እን ማንኮጌላተቶ ማራን አት ኢን ታስሰቶ ካባጃቴ እሶ ጎጎዴራዉን ዶታራ።”<verse eid="JHN 17:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="JHN 17:25" />“ቁሉክ ኣቦኬ! አላም ጎካሳናዋተና፥ አን ካሶዋ፥ ህኒዕና አት እን ፋራኖ ካሳንዋ። <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />እዬን ታግታ ጌላንጀታ እሶን ጎጎግርቶ፥ አንና እሶ ጎጎግሮ፥ መገካ ጎጎአዴስናዉን የለራ፥ ጎጎአዴስናዉና የልናራ።”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s1">የሱሳ ኡሱ ኦዲዳሬን አባመ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26፡47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14፡43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፡47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />የሱሳ ሂካ ኤብ ጉድሰ አባባተረ ኡሱኮ ኦአጋልሳታረነ ዎታ ካቀድሮን ላጋ ናቄነ፥ ጣዬን ታኮግሬን ታአካክልተ ባንኤ ቶስ ታቤን። <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />ጎራታ ካሞጋን የሱሳ ኡሱኮ ኦአጋልሳታረነ ዎታ ኤሰ ማንኮኤሰላሮ ማራን፥ ሮርሰ ካስሰራ ይሁዳና ባንኤ ካሳናየዋ። <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />ይሁዳና ዎታዳራል ኡሱማለና ካቱቃሞል ዎይቻልኮና ፋራሳውልኮ ኦፋራመራን ቁሉክ ምን ካዋ ኦኦራኔነ ዎታ ቃጄልሳ ባንኤ ታአካክልተ ቶስ ኤመተ፥ እሶና ዳብ፥ ፋኖስና ሁ ካጀረነ አባተን ግረን። <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />የሱሳና ኡሱ ካግናሮ ዱባ አዴሰረ እሶ ቶስ ቤረ፥ “እስን ካዶታታን አዮያ?” አመ። <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />እሶና፥ “ካናዝረት የሱሳያ” አመን። የሱሳና፥ “ኡሱ አንያ” አመ። ሮርሰ ካስሰራና ይሁዳ እሶ ዎታ አሌ ግረ። <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />የሱሳና፥ “ኡሱ አንያ” ካኮአማረ ጎራታ ሃራርቲ ጋጋቤንጉረን ኡል እዬን።<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />አደና “እስን ካዶታታን አዮያ?” አመ ሆሳተ።</para>
  <para style="p" vid="JHN 18:7">እሶና “ካናዝረት የሱሳያ አመን።”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />የሱሳና አባበረ፥ “ኡሱ አንያ” አመራ ሀያ፥ “እን ካዶታታን ጎሌ ሂኒዕ ሀሴተን ኢሳጋ አመ።” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />ሂክ ካኮሌራ፥ “አት ኢን ኦስሰቶ ህናኣኮ ኮና ላኮባየሮ” አመ ካአዬሰራ ሃፉራ ጎጎጉዳሮንያ።<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />ሺፋ አባተ ካግረ ስሞና ጴጢሮሳ ሺፋ ምአተ ቱቃሞኮክ ዎይቻን ካሀንዳረ ባሰረ ነበ ታመርገ ጎሰ “ካሀንዳረኮክ መገና ማልኮሳ አማማረ”።<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />የሱሳና ጴጢሮሳነ፥ “ሺፋ ኮፎ ታብስና! ኦዶ ኢን ታስሰሮ ታራኮ ጡጋ ካጣሞን ኣን ላራ?” አመ።<note caller="-" style="x"><char style="xo" closed="false">18፡11 </char><char style="xt" closed="false"><ref loc="MAT 26:39">ማቶ. 26፡39</ref>፤ <ref loc="MRK 14:36">ማር. 14፡36</ref>፤ <ref loc="LUK 22:42">ሉቃ. 22፡42</ref>።</char></note><verse eid="JHN 18:11" /></para>
  <para style="s1">የሱሳ ቱቃሞን ኦዶናት ካአቦ ሃና ሆረ አሌ</para>
  <para style="r">(<ref loc="MAT 26:57">ማቶ. 26፡57</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />ዎታዳራና ካአጃጃሮ ካክሶነ ዎታ አይሁድን ኦሀንዳሬና ራቶ ሌነ የሱሳ አበን፥ ሽዬን፥ <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />ሆራርጀ፥ ካቀያፋ ሶዶ ካሌሮ ሃና ቶስ ጌሰን፥ ቀያፋ ኡሱ ጌሲ ቱቃሞን ኦዶናት ካአቦየ። <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />ቀያፋ፥ ጎሳ ማራንቱን ኦዶ ኮ ጎጎየ ካእዳንክያ አማ አይሁድን ማርካስሳ ካግረ እባዶትየ።<note caller="-" style="x"><char style="xo" closed="false">18፡14 </char><char style="xt" closed="false"><ref loc="JHN 11:49-50">ያን. 11፡49-50</ref>።</char></note><verse eid="JHN 18:14" /></para>
  <para style="s1">ካካታኖ ካጰጢሮሳ</para>
  <para style="r">(<ref loc="MAT 26:69-70">ማቶ. 26፡69-70</ref>፤ <ref loc="MRK 14:66-68">ማር. 14፡66-68</ref>፤ <ref loc="LUK 22:55-57">ሉቃ. 22፡55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />ስሞና ካአማማረ ጴጢሮሳና ካካለ ኮ የሱሳኮ ካአጋልሳታረ የሱሳ ዴበ ሴተን፥ ቱቃሞን ኦዶናት ካአቦን ማንኮአዴሳማረ ማራን፥ የሱሳ ዎታ ቱቃሞን ኦዶናት ካአቦኮክ አዉድ ቶስ ታበ። <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />ጴጢሮሳ አደ ካራኮ ሳሬ ሄሰ። ቱቃሞኮክ ዎይቻነታ ካአዴሳማረ ካካለ የሱሳኮ ካአጋልሳታረ አባባተረ ካራ ታኦራተ አዬስሰረ ጴጢሮሳ ኣተ ታበ። <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />ካራ ታኦራተና ጴጢሮሳነ፥ “አት ሂካ እባዶትኮ ካአጋልሳታሮኮ ኮ ላኮቶያ?” አንተ።</para>
  <para style="p" vid="JHN 18:17">ኡሱና “ላኮአንዮ” አመ።<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />ጎራታና ካአንቦሎልሳረ ማንኮሌ ማራን ኦሀንዳሬና ኤለን ቤበሳቴን ማራሙረን ማር ኮልኮልሳይን አሌን ግኔን፥ ጴጢሮሳና እሶ ዎታ አሌረ ኤለን ጣንጣማ ግረ።<verse eid="JHN 18:18" /></para>
  <para style="s1">የሱሳ ቱቃሞኮክ ዎይቻ ሆረ አሌ</para>
  <para style="r">(<ref loc="MAT 26:59-68">ማቶ. 26፡59-68</ref>፤ <ref loc="MRK 14:55-65">ማር. 14፡55-65</ref>፤ <ref loc="LUK 22:63-71">ሉቃ. 22፡63-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />ኡሱ ጎራታ ቱቃሞኮክ ዎይቻ የሱሳ ኡሱኮ ኦአጋልሳታሬንኮክ ጋራና አጋልስሳኖኬሳኮክ ጋራ ሆሳተን።<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />የሱሳና፥ “አን አላምን አዴስሰ አዬሰራ አይሁድ ታኮኩኩአማረና፥ ቁሉክ ምን ካኤብ አሪ ዱባ አጋልስሰራ፥ ስያመ ካአዬሰራ ላግሮ። <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />መዉን እን ሆሳታ? አን እሶን ካሰገሮ ኦማሌራን ሆሳ፥ ሂክማ፥ ሂኒዕ አን ካአዬሰሮ ካሳንዋ።”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />የሱሳ ሂካ ካኮአዬሳረ ጎራታ ዶሌ አሌን ኦግረን ቁሉክ ምን ካዋ ኦኦራሬንኮ ኮ፥ “ቱቃሞኮክ ዎይቻን ሃ አባባታ?” አመረ ባላባንጆ ኡሱ ባሰ።<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />የሱሳና፥ “ታሜላን ካአዬሰ ጎሌ” “ታሜላን አዬሳኖኬ አቶቲን፥ ሩም ጎአዬሰ አደ መዉን ባሳታ?” አመ።<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />ኤሰኮ ሃና የሱሳ ሻመ ጎጎግሬ ቱቃሞኮክ ዎይቻ ቀያፋ ቶስ ፋረ።<verse eid="JHN 18:24" /></para>
  <para style="s1">ካጰጢሮሳ ካላምና ካሴድ ካካታኖ</para>
  <para style="r">(<ref loc="MAT 26:71-75">ማቶ. 26፡71-75</ref>፤ <ref loc="MRK 14:69-72">ማር. 14፡69-72</ref>፤ <ref loc="LUK 22:58-62">ሉቃ. 22፡58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />ስሞና ካአማመረ ጴጢሮሳ አሌረ ኤለን ጣንጣማ ግራን፤ ካካለ እባዶና “ኡሱኮ ኦአጋልሳታራንኮ ኮ ላ አትቶላ?” አመ።</para>
  <para style="p" vid="JHN 18:25">ኡሱና፥ “ላኮአንዮ” አመ ካካተ።<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />ቱቃሞኮክ ዎይቻን ኦሀንዳሬንኮ ኮ ጴጢሮሳ ነበ ካጎሰሮ እባዶትን ፋል ካሌረ፥ “ታአካክልተ ባንኤ አን ኩ የሱሳነ ዎታ ላኮዴያ?” አመ ሆሳተ። <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />ጴጢሮሳና አደ ካካተ፥ ጎርሰዋ ሉካለ ኦየ።<verse eid="JHN 18:27" /></para>
  <para style="s1">የሱሳ ጲላጦሳ ሆረ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27፡1-2</ref>፥<ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር. 15፡1-5</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23፡1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />አይሁድ የሱሳ ምን ካቀያፋኮ ካሮም ሞት ጲላጦሳኮት ቃየ ኣተን ሴተን፥ ጎራታና ባርየ፥ አይሁድና ካፋስካ ባላ ማንኮአምናረ ማራን ባቶዋናኮ አመረን አዉድ ካሞትት ቶስ ላኮታቤራን። <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />ሃንሱን ጲላጦሳ እሶ ቶስ ቤረ፥ “ሂካ እባዶት ጉት ካሞታታን ሞቶ መያ?” አመ እሶ ሆሳተ።<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />እሶና አባበን፥ “ሂክ እባዶት ፈሎ ኦሜላን ፈልዋተዋ ኖ ኩን ሮርስ ላኮስስናኔ” አመን።<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />ጲላጦሳና፥ “እስን እሲዋ ጌሳዴን ሴራክስን ማለ ፍርዳ” አመ።</para>
  <para style="p" vid="JHN 18:31">አይሁድና፥ “ኖ ማዮና ጎጎላጋንዶን ፈኢ ላኮአብኖ” አመን። <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />ህክና ካኮንሌራ የሱሳ ምስክ ጎይ ጎይናሮ ቱስን አመረ ካአዬሰራ ሃፉራ ጎጎጉዳሮንያ።<note caller="-" style="x"><char style="xo" closed="false">18፡32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">ያን. 3፡14</ref>፤ <ref loc="JHN 12:32">12፡32</ref>።</char></note><verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />ጲላጦሳና አዉድ ቶስ አባባተረ የሱሳ ኡምስሰረ፥ “አት ካአይሁድ ዎኖታ?” አመ ሆሳተ።<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />የሱሳና፥ “ሂክ ያዳ ካካያ?” “ጎርቱን ካካለ ጋራኬ ካሰገናንያ?” አመ አባበ።<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />ጲላጦሳና አባበረ፥ “አን አይሁድያ?” “ኩ እን ቶስ ካፋረራ ጎሳካና ካቱቃሞል ዎይቻልያ፤ አየሱን አት መ የልተደያ?” አመ አባበ።<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />የሱሳና፥ “ዎኖናትክ ሂካ አላምኮ ላኮዮ፥ ሊግረዋ አይሁድ ጎጎአቦንኮ ኦሀንዳረን ጀሬን ሻፋታኔዋ፥ ግዳ አደ ዎኖናትክ ሂካ አላምኮ ላኮዮ” አመ።<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />ጲላጦሳና፥ “ሀያ አት ዎኖታ አማኖዮላ!” አመ።</para>
  <para style="p" vid="JHN 18:37">የሱሳና፥ “አን ዎኖ ላኖ ጋራ አንተታ፥ አን ካኮንኡሙላመራና ሂካ አላም ቶንሳ ካኮን ኤመየራ ጋራ ካሩም አቶቲንያ፥ ሩምኮ ካሌ ዱባ ሃፉራኬ ማላራ” አመ።<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />ጲላጦሳና፥ “ሩም መታ?” አመ። ሂካ አዬሰ አባባተረ አደና አይሁድ ቶስ ቤረ ሃ አመ፤ “አን ሂካ እባዶት ጉት ካሞትስሮ ባስ ኮና ላኮሄለሮ፥ <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />አየሱን ጎአመን ፋስካይ ካሽያመሮኮ ኦዶ ኮ ፉራኖኮክ ዎጋ አብታን፥ ‘ሃንሱን ካአይሁድ ዎኖ ጎጎፉሮን ዶታታን’?” አመ።<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />እሶና አደን እያ፥ “ላ ላኮኡሱዮ! ባርባነ ፉር!” አመን። ባርባነ አደ ሽታየ።<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s1">የሱሳ ጎጎሱዋምሮን ሙርተሳመ</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማቶ. 27፡27-31</ref>፤ <ref loc="MRK 15:16-20">ማር. 15፡16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />ጲላጦሳ የሱሳ ሀጋኣተረ ቦጪሰ። <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />ዎታዳራልና ኤኤን ማማረን ካላቻ ኣን መተ ካየሱሳ ጉት ካዬን፥ ሄላ ቡራቡረክ ሳርስ ሳርስሴን። <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />ማራሙረን “ካአይሁድ ዎኖ ገጌላና” አማ ባላባንጆ ባሳ ግኔን።<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />ጲላጦሳና አደ አዉድ ቶስ ቤረ፥ ኮና ሞቶን ኦጌግስራን ፈሎ ኦሜላን ሄልዋት ጎጎአዴሳኑን፥ “ጎርታ አን ኡሱ እስን ቶስ ቤስናራ” አመ። <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />የሱሳ ካላቻ ካኤኤኔ ካተረ ሄላ ቡራቡረክ ሳርስ ሳርሳተ ቤ፥ ጲላጦሳና፥ “ሂክማ፥ እባዶት!” አመ።<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />ካቱቃሞል ዎይቻልና ቁሉክ ምን ካዋ ኦኦራኔን የሱሳ ካኮድያሬን ጎራታ፥ “ሱይና! ሱይና!” አማ ኦኬን።</para>
  <para style="p" vid="JHN 19:6">ጲላጦሳና አደ፥ “እስን ጌሳየንደን ሱዋየን፥ እን ቶንሴ ሞቶን ኦጌግስራን ፈሎ ኦሜላን አን ላኮሄለሮ” አመ።<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />አይሁድና፥ “ኖ ሴራ አብና፥ እስኦቴሳ ኤረ ካዋ ማንኮየለ ማራን ሴራካን ማለ ጎይን ዶትሳራ” አመን። <verse eid="JHN 19:7" /><verse number="8" style="v" sid="JHN 19:8" />ጲላጦሳ ሂካ ካኮማላረ ጎራታ ኣሎ አብሳተ፥ <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />አዉድ ቶስ አባባተረ የሱሳ፥ “አት ሀየኮ ኤሜተታ?” አመ ሆሳተ፥</para>
  <para style="p" vid="JHN 19:9">የሱሳ አደ ኮና ላኮአባበሮ። <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />ጲላጦሳና፥ “ላኮሰጋቶያ? አን ኩ ፉርን ጎርቱን ሱይን ኦዶናት አባኖ ላካሶያ?” አመ።<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />የሱሳና፥ “ዋኮ ስሳምዋተዋ እን ጉት ኦዶናት ላኮግራረ፥ ሃንሱን ኩዬን ሮርሰ ካስሰራ እባዶት ጩቦኮ ካሮረ ጩቦ አባ” አመ።<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />ኤሰኮ አባባተረ ጲላጦሳ የሱሳ ፉርን ዶተ፥ አይሁድ አደ፥ “ሂካ እባዶት ጎፉርተ ቄሳር ካጌላቶ ላኮቶ፥ እስኦቴሳ ዎኖ ካየላታራ ቄሳር ካዲዳሮያ” አማ ኦካኖ ሆረዴን።<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />ጲላጦሳ ሂካ ማለረ የሱሳ ሳርደሰ ቤሰ፥ ኤኤሞኮክ ያማኖ ታአማማተ ባንኤ ካፍርዳ ባርጩማ ሀማጼ፥ ህት ባንኤና ታአራማይክ ሄኢ ገበታ አማንተ ኡማማተ። <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />አሪ ካፋስካ ባላ ታኮኤካሳናተ ጎራታና አርኮ ሳቲ ሌክ ሌ ግረ። ጲላጦሳና አይሁድነ፥ “ሂክማ ዎኖክስን” አመ። <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />እሶ አደን፥ “ባስና! ባስና! ሱይና!” አማ እዬን። ጲላጦሳና፥ “ዎኖክስን ሱዩ?” አመ።</para>
  <para style="p" vid="JHN 19:15">ካቱቃሞ ዎይቻልና፥ “ካሮም ዎኖ ቄሳር ኳሬ ካካለ ዎኖ ኖ ላኮአብኖ” አመን አባበን።<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />ጉድሳኖና ጲላጦሳ የሱሳ ጎጎሱይራዉን ሮርሰ ስሰ። ዎታዳራልና የሱሳ አበን ጌሰን።<verse eid="JHN 19:16" /></para>
  <para style="s1">የሱሳኮክ ሱዋማኖ</para>
  <para style="r">(<ref loc="MAT 27:33-44">ማቶ. 27፡33-44</ref>፤ <ref loc="MRK 15:22-32">ማር. 15፡22-32</ref>፤ <ref loc="LUK 23:33-43">ሉቃ. 23፡33-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />ኡሱና ማስቃሊቴሳ ስዳተረ ታአራማይክ ሄኢ “ጎልጎታ” አማንተ ታኡማማቶ “ቡቀ ታመተ” ታአማማተ ባንኤ ቤ። <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />ኤሴና ሱዬን፥ ኡሱ ዎታና እባዶ ላማ፥ ኮ ምና ታበተነ፥ ኮና ምና ታመርጌነ፥ የሱሳ ጠኤ የሌነ ሱዬን። <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />ጲላጦሳና ጹፍ ጻፈረ ማስቃሊ ጉት ሬረሰ፤ ጹፍና፥ ካናዝረት የሱሳ፥ ካአይሁድ ዎኖ ታአማቶተ። <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />የሱሳ ታኮሱዋመረ ባንኤ ካታማ ዶሌ ማንኮግቴ ማራን ኦሞጋን አይሁድ ጹፍ ናባቤን፥ ጹፍና፥ ሄኢ ታኢብራይስጢ ታላትንና፥ ታግሪክተ። <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />ካአይሁድ ቱቃሞልኮክ ዎይቻልና ጲላጦሳ ዲዳ፥ “ኡሱ፥ ‘ካአይሁድ ዎኖያ’ አመራ አም ጻፍ ኳሬ ካአይሁድ ዎኖ አም አሮጻፍተ” አመን።<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />ጲላጦሳና፥ “አን ካጻፈሮ ጻፈራ” አመ አባበ።<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />ዎታዳራል የሱሳ ሱዬን አባባተን፥ ቆሎኬሳ ሄሳ፥ ሁኬሳ አቴረን መተመተዉን ኮ ኮ ጎጎገገሮን በንኤ አፋር ሄዴዳመን፥ ኤለኮ ታ ሄገል ጌቶን አማለኮ ሌተ ሀኢሪራሞን ታፈላንተታ። <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />ሃንሱን፥ “እጣ ቤሳይነ ካኮንቤተ ሀጌተ” ኳሬ “ላኮፊልኖ” አመን። ህክና ካኮንሌራ</para>
  <para style="q1" vid="JHN 19:24">“ሁኬ ሄዴዳመን፥</para>
  <para style="q2" vid="JHN 19:24">ቆሎና ኢጣ ቤሳተን”</para>
  <para style="m" vid="JHN 19:24">ካአማመራ ካማጻፋ ሃፉራ ጎጎጉዳሮንያ። ዎታዳራልና ካፌለራን ሂካዋያ።<note caller="-" style="x"><char style="xo" closed="false">19፡24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዛ. 22፡18</ref>።</char></note><verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />ታየሱሳ ማስቃሊ ዶሌ ኣየቴሳና ኣየቴሳኮት አባ፥ ታቀልዮጳ ኦር ማይራመና ኡል ካመግደላኮት ማይራመ ኤሰ አሌን ግረን። <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />ኤሴና የሱሳ ኣየቴሳና ካጌላታረ ኡሱኮ ካአጋልሳታረ ዶሌ አሌን ግራን ካኮድያረ ጎራታ ኣየቴሳነ፥ “አት ሄለልትቲ፥ ኤረካ ሂክማ” አመ።<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />ኡሱኮ ካአጋልሳታረነ፥ “ኣየታ ህትማ” አመ። ኡሱ ጎራታኮ ሀጋአበረ ሂክ ኡሱኮ ካአጋልሳታረ ምንኬሳ ቶስ አታተ።<verse eid="JHN 19:27" /></para>
  <para style="s1">ጎይ ካየሱሳ</para>
  <para style="r">(<ref loc="MAT 27:48-50">ማቶ. 27፡48-50</ref>፤ <ref loc="MRK 15:36-37">ማር. 15፡36-37</ref>፤ <ref loc="LUK 23:36">ሉቃ. 23፡36</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />ኤሰኮ የሱሳ አየስ ዱባ ጉዳታኖ አዴሰረ፥ ካማጻፋ ሃፉራ ጎጎጉዳሮ፥ “አን ሱጉባየዋ!” አመ።<note caller="-" style="x"><char style="xo" closed="false">19፡28 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዛ. 69፡21</ref>፤ <ref loc="PSA 22:15">22፡15</ref>።</char></note><verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />ኤሴና ታኦኮካታ ዎይኒ ሁቡቾ ምግ ሌተ ግቴ፥ እሶና እስፎንጅ ጣሞ ካዎይኒቲ ጡቅሴነ፥ ኦጎሮ ካአቦ ባሊ ህኢ ቶስ ጋባሌን። <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />የሱሳና ካኦኮኮታሮ ካኮቃማሳረ ጎራታ “ጉዳተዋ” አመ።</para>
  <para style="p" vid="JHN 19:30">መተኬሳ ሁስሳተረ፥ ኔፎቴሳ ሮርሰ ስሰ።<verse eid="JHN 19:30" /></para>
  <para style="s1">አራንጃ ታየሱሳ ጀሬን ኤጋማኖ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />ኤሰኮ አባባተረ አሪ አይሁድን ታፎልሲ አርዉን ታኮኤካሳታራንተ። አይሁድ፥ ካሱዋመሮ እባዶኮክ ሬስ ታፎልሲ አሪ ማስቃሊ ጉት ጎጎሀይኖንኮ ማንኮዶታቴን ማራንና ካለት ታፎልሲ አሪ ማንኮሌተ ማራን፥ ኦሱዋሜራን እባዶጃ ግልብ ኤብሰሬን ሬስ ጎጎዳግሮን ጲላጦሳ ኤባተን። <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />ሃንሱን ዎታዳራል ኤመተረ ክርስቶሳነ ዎታ ሱዋመ ካግረ ካሆራርጄ እባዶትኮክ ግልብ ኤብሴን፥ አደን ካካለኮክ ግልብ ኡሱማሌ ኤብሴን። <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />የሱሳ ቶስ ካኮኤሜተረን ጎራታ ካጎየሮ ማንኮዴረን ማራን ግልብ ላኮኤብሴረን። <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />አየሱን ጎአመን ዎታዳራልኮ ኮ አራንጃ ታየሱሳ ጀሬን ኤገ፥ ጎርሰዋ ኢግና በከና ኡባተ። <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />ሂካ ካዴራ እባዶት አቶናት ስሰራ፥ አቶናትና ሩምያ፥ ሩም አዬሳኖና ካሶዋ፥ እስና ጎጎአማንታኑን አቶታራ። <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />ህክና ካሌራ፥ ማጻፋ፥ “ለፋልኮ ኮና ላኮኤብሮ” ካአማመራ ጎጎጉዳሮንያ፥<note caller="-" style="x"><char style="xo" closed="false">19፡36 </char><char style="xt" closed="false"><ref loc="NUM 9:12">ቶቶ 9፡12</ref>፤ <ref loc="PSA 34:20">ማዛ. 34፡20</ref>፤ <ref loc="ZEC 12:10">ዛኪ. 12፡10</ref>፤ <ref loc="REV 1:7">ራጋ 1፡7</ref>።</char></note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />ካካለ ቁሉክ ማጻፋና፥ “ሀሱ ካኤገራን እሶ ድናራን” አማራ።<verse eid="JHN 19:37" /></para>
  <para style="s1">ቃማላማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27፡57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15፡42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፡50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />ሂታኮ አባባተረ ካአርማትያስ ዮሴፋ ካየሱሳ ሬስ አታይን ጲላጦሳ ኤባተ፥ ዮሴፋና አይሁድ ማንኮአብሳተሮ ማራን ሄቶ የሱሳኮ ካአጋልሳታሮየ። ኡሱና ጲላጦሳ ፈኢ ካኮስሳረ ጎራታ ኤመተ ሬስ አታተ። <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />ኤሰኮ ሆረነ ሄመን የሱሳ ቶስ ኤመተ ካግረ ንቆድሞሳ ኮፍቻ ሶንዶም ታሌቶ ኣሎ አዉኣሎ ፑልፑልሶና ካኦኮኮታሮ ባጩ ኣተ ኤመተ።<note caller="-" style="x"><char style="xo" closed="false">19፡39 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">ያን. 3፡1-2</ref>።</char></note> <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />እሶና ሬስ ካየሱሳ አቴረን ካአይሁድ ሬስ ኤካሳኖኮክ ሴራ ሽቶነ ዎታ ቃማሉን ጋሼ ማማሬን። <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />የሱሳ ታኮሱዋመራ ባንኤና ታአካክልተ በንኤተ፥ ታአካክልተ ባንኤ ማዮና ታኮቃማላሞን ግሮ ካኡሱብ ቃማልየ። <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />አይሁድን ታፎልሲ አርዉን ታኮኤካሳታራን አሪ ማንኮሌተዉን ታቃማል ባንኤ ኤነ ማንኮሌዉን የሱሳ ኤሰ ቃማሌን።<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s1">የሱሳ ጎይኮ ኬ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ. 28፡1-8</ref>፤ <ref loc="MRK 16:1-8">ማር. 16፡1-8</ref>፤ <ref loc="LUK 24:1-10">ሉቃ. 24፡1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />ታዎጋ አሪ፥ ባሪኖ ጋና ኡል ድምምሳነ ግራን፥ ታመግደላ ማይራመ ቃማል ቶስ ሴተ፥ ኤኤሞና ቃማልኮ ካኦቶቶለሮ ዴተ። <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />ሃንሱን ስሞና ጴጢሮሳ ቶስ የሱሳ ጌላታ ካግረ ካካለ ኡሱኮ ካአጋልሳታረ ቶስ ትያ ኤመተዴ፥ “ጎታ ቃማልኮ ቤሰን አቴና፥ ኤቲ ካዬራን ላካንሶ” አንተ።<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />ኤሰኮና ጴጢሮሳና ካካለ የሱሳኮ ካአጋልሳታረና ቤኔ ቃማል ቶስ ሴተን። <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />ላማ ትያ ግራን፥ ካካለ የሱሳኮ ካአጋልሳታራና ጰጢሮሳኮ ጣየ ታቃማል ባንኤ ጌ። <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />ሁስመረ ታኮቃማላመሮ ባንኤ ጎዴሮ ጋሸ ታላል ግራኖ ዴ፥ ቃማል ቶስ አደ ላኮታበረ። <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />ደቤሰሴታ ካግረ ስሞና ካአማመረ ጴጢሮሳ ጌረ ቃማል ቶስ ታበ፥ ኡሱና ታነቃማለሬን ጋሸ ታላል ዴ። <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />ኡሱማለና መተ ካየሱሳ ጉት ታማማራንተ ግቴ ሆጮ ዴ፥ ህት ሆጮና ታቃማል ጋሸኮ ካለ ቤተ ማማራንተ ግቴ። <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />ኤሰኮና ጣየ ቃማል ቶስ ካጌራ ካካለ የሱሳኮ ካአጋልሳታረ ቃማል ኦሮዴ ታበ፥ ዴረና አማነ። <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />ህክና የሱሳ ጎይኮ ክያኖ ግራኖ ጋና ማጻፋኮ ላኮአዴሰረን።<verse eid="JHN 20:9" /></para>
  <para style="s1">የሱሳ ካመግደላ ኡልኮት ማይራሜን ሙተ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶ. 28፡9-10</ref>፤ <ref loc="MRK 16:9-11">ማር. 16፡9-11</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 20:10" />ኤሰኮ አባባተሬን የሱሳኮ ኦአጋልሳታረን ላማና ምን ምንክሶ ጋለን። <verse eid="JHN 20:10" /><verse number="11" style="v" sid="JHN 20:11" />ኡል ታመግደላኮት ማይራመ አደ ቃማልኮ ሳሬ አሊተደ ኦታ ግቴ፥ ኦታና ቃማል ድን ሁስ አንተ። <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />ሬስ ካየሱሳ ማንኮግረ ባንኤ፥ ሁ ጉማራ ጉማራክ ኦሳርሳቴራን ኤርግቻ ላማ ኮ መተነ ኮ ሉቃነ ኦሀማጼራን ዴተ። <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />እሶና ማይራምነ፥ “አት ሄለልትቲ፥ መዉን ኦዋታ?” አመን ሆሳተን።</para>
  <para style="p" vid="JHN 20:13">ኤሰና፥ “ጎታኬ አቴና፥ ኤቲ ካዬራን ላካሶ” አንተ።<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />ሂካ አንተደ ሃራርቲ ጎዎቺቶ የሱሳ ኤሰ ካአሌሮ ዴተ፥ የሱሳ ላኖ ኤሰ አደ ላኮአዴሰቶ። <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />የሱሳና፥ “አት ሄለልትቲ፥ መዉን ኦዋታ? አዮና ዶታታ?” አመ።</para>
  <para style="p" vid="JHN 20:15">ኤሰና ታአካክልተ ባንኤ ካኦራሮ ኣን ሌረ፥ “ጎታክ፥ አት ጎአተቶ፥ ማጋኔ ማጌ ካይተቶ ሰጊ አን አታሮ” አንተ።<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />የሱሳና፥ “ማይራመ!” አመ። ኤሰና፥ ኡሱ ቶስ አባባተደ ታኢብራይስጢ ሄኢ፥ “ረቡን!” አንተ፥ ፉረንና “ካአጋልስሳቶ!” አማኖያ።<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />የሱሳና፥ “ጋና ኦዶ ቶስ ማንኮቤኖን ግሮ ማራን፥ አሮድንተ፥ ሀሌዎ ኳሬ አቢላልቴ ቶስ ሴዴ፥ ‘ኣቦኬ ቶስና ኣቦክስን ቶስ፥ ሄዶኬ ቶንሳ ሄዶክስን ቶስ ብናራ አመራ’ አምደ ሰጊ” አመ።<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />ካመግደላ ኡልኮት ማይራመና የሱሳኮ ኦአጋልሳታረን ቶስ ሴተደ፥ “ጎታ ዴለ!” አንተ ኡሱ ካአመሮና ሰግተ።<verse eid="JHN 20:18" /></para>
  <para style="s1">የሱሳ ኡሱኮ ኦአጋልሳታሬዉን ሙተ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28፡16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16፡14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፡36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />ኡሱ አልማዋ፥ ታሆራርጄ አሪ ታዎጋ ሄመን፥ የሱሳኮ ኦአጋልሳታረን አይሁድ አብሳተኔን ኡፋ ጩፋቴን ኩኩአመን ግራን፥ የሱሳ ኤመተረ እሶ ጠኤ አሌረ፥ “ኖጎዳ እስኑን ሀሌቶ!” አመ። <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />ሂካና አመረ ገነኖና አራንጃና ቱሳተ፥ የሱሳኮ ኦአጋልሳታረና ጎታ ካኮድያረን ጎራታ ኣሎ ገጌላተን። <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />የሱሳ አደና፥ “ኖጎዳ እስኑን ሀሌቶ፥ ኦዶ እን ጎጎፋረሮ፥ አንና እስን ፋርናራ” አመ። <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />ሂካ አመ አባባተረ፥ ኡፉ አመረ፥ “አያና ቁሉክ አታዬን። <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />እስን ጩቦ ካእባዶ ሀሄሶ ጎአንቴን፥ ጩቦክስን ሀሄሶ አማምሮዋ፥ እስን ጩቦክሶ ሀሄሶ ጎአሞን፥ አደ ጩቦክሶ እሶን ሀሄሶ ላኮአማምሮ” አመ።<note caller="-" style="x"><char style="xo" closed="false">20፡23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ. 16፡19</ref>፤ <ref loc="MAT 18:18">18፡18</ref>።</char></note><verse eid="JHN 20:23" /></para>
  <para style="s1">የሱሳ ቶማሳን ሙተ</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />ሀሱ ጎራታ ቶሞንኮ ላማኮ ኮ ካሌራ፥ ዲዲሞሳ ካአማማረ ቶማሳ የሱሳ ካኮኤሜታረ ጎራታ ኡሱኮ ኦአጋልሳታረነ ዎታ ላኮግረ። <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />ኦካለ የሱሳኮ ኦአጋልሳታረን ቶማሳነ፥ “ኖ ጎታ ዴነለ!” አመን። ኡሱ አደ፥ “ምስማረ ኦኤጋሜራን ገነኖኦቴሳክ ማላታ ጎዴኖን፥ ምስማሬል ታኮኤጋመሮ ባንኤ ፈር ታብስ ጎዴኖን፥ አራንጃቴሳና ገነቴ ጎታብሶን ላኮአማንናሮ” አመ።<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />አሪ ስዴድኮ አባባተረ፥ የሱሳኮ ኦአጋልሳታረን ምን ኦሮ ግኔን፥ ቶማሳና እሶ ዎታ ግረ፥ ኡፋልና ጩፋመ ግረ፥ የሱሳ አደ ኤመተረ እሶኦሮ አሌረ፥ “ኖጎዳ እስኑን ሀሌቶ!” አመ። <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />ኤሰኮና ቶማሳነ፥ “ፈርታ ሂታራ ኬን፥ ገነኖኦቴና ዴና፥ ገነ ድሪርሳደ አራንጃተይ ታብስ፥ አሮሄዳተ አማና” አመ።<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />ቶማሳና፥ “ጎታ! ሄዶኬ!” አመ አባበ።<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />የሱሳና፥ “አት እን ማንኮዴተ ማራን አማንተታ እን ሀዴኖን ኦአማናታራን አደን ኦሶማሳመንያን” አመ።<verse eid="JHN 20:29" /></para>
  <para style="s1">ሂካ ማጻፋኮክ ሀልቻ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />የሱሳ ሂካ ማጻፋ ካጻፋሞን ካካለ ካሞጋን ማላታ ኡሱኮ ኦአጋልሳታራን ሆረ ፈለራ፥ <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />አየሱን ጎአመን የሱሳ ኡሱ ክርስቶሳ ኤረ ካዋ ላኖ ጎጎአማንታኑና፥ አማንዴን መገኬሳ ግር ጎጎሄላታኑን ሂክ ጻፋመራ።<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s1">የሱሳኮ ኦአጋልሳታረን ባሳ ኩኑኡብ አባታኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />ኤሰኮና ዳንበኔ የሱሳ ታጢብራዶስ ላቡ አደና ኡሱኮ ኦአጋልሳታሬዉን ሙተ፥ ሂካማሌና አደ ሙተ። <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />ስሞና ካአማማረ ጴጢሮሳ፥ ዲዲሞሳ ካአማማረ ቶማሳ፥ ካቃና ዘጋሊላ ናትናኤል፥ ይስ ካዛብዶሳና የሱሳኮ ኦአጋልሳታረን ኦካለ ላማ ራቶ ግኔን። <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />ስሞና ካአማማረ ጴጢሮሳና፥ “ኩኑኡብ አባይን ዳጋኖያ” አመ።<note caller="-" style="x"><char style="xo" closed="false">21፡3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">ሉቃ. 5፡5</ref>።</char></note></para>
  <para style="p" vid="JHN 21:3">እሶና፥ “ኖ ኩኔ ዎታ ዳግናና” አመን። ኤሜተነ ዎላቦ ኦርዴን ታቤን፥ ኤሰ ሄመን አደን ኮና ላኮአባተን። <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />ባሪኖ፥ የሱሳ ላቡ ግሪ አሌ ግረ፥ ኡሱኮ ኦአጋልሳታረን አደን የሱሳ ላኖ ላኮአዴሰን። <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />የሱሳና፥ “ይሶ፥ ኩኑኡብ አብታነ?” አመ።</para>
  <para style="p" vid="JHN 21:5">እሶና፥ ኮና “ላኮአብኖ” አመን።<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />ኡሱና፥ “ማራብትስን ዎላቦኮ ምና ታመርገነ ሉጉዳዬን፥ ኩኑኡብ ሄላታንዋ” አመ። እሶና ካኮሉጉዳታሬን ጎራታ ኩኑኡብ ሞጋንኮ ካከይ ማራብ ናትን ዋተን።<note caller="-" style="x"><char style="xo" closed="false">21፡6 </char><char style="xt" closed="false"><ref loc="LUK 5:6">ሉቃ. 5፡6</ref>።</char></note><verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />ሀሱ ጎራታ የሱሳ ካጌላታረ ኡሱኮ ካአጋልሳታረ፥ ጴጢሮሳነ፥ “ጎታዮ!” አመ። ስሞና ጴጢሮሳና፥ “ጎታዮላ!” ካአማሮ ሃፉራ ካኮማላረ ጎራታ፥ ቤሳተ ካግረ ሳርስ ታብሳተረ ፍርመ በከሮ ታበ። <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />ኦካለ የሱሳኮ ኦአጋልሳታረን አደን ባጋኮ ባድ ቶስ ፋክካሜራን ህስል ላማ ቦሌ ካሌሮ ኳሬ ኣሎ ላኮፋክሜናን፥ ኩኑኡብ ታኮአማጋመረ ማራብ ናታ ባጋ ኤመተን። <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />ባጋና ካኮግያኔ ጎራታ፥ ቦላል ካኤሌኔ ጉት ካግሮ ኩንኡብና ባቦ ዴን። <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />የሱሳና፥ “ግዳ ካአብቴታን ኩኑኡብኮ አላ ኬና” አመ።<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />ሃንሱን ስሞና ካአማመረ ጴጢሮሳ ዎላቦ ታበረ ማራብ ባጋ ቶስ ናቴ፥ 153 ካጅንጂን ኩኑኡብ አማጋመ ግረ፥ ሂካ ግታክ ኩኑኡብ ጎአብተና ማራብ ላኮፊላንተቶ። <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />የሱሳና “ኮዬን አማ” አመ። እሶና ኡሱ ጎታ ላኖ አዴሰን ማንኮግሬን ማራን ኡሱኮ ኦአጋልሳታረንኮ ኮና “አት አዮታ?” አም ሆሳይን ካጃባተ ላግረ። <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />የሱሳና ኤመተረ ባቦና ኩንኡብና ኣተ ስሰ።<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />የሱሳ ጎይኮ ጎኬኮ አባባተረ ኡሱኮ ኦአጋልሳታራዉን ሙታኖ ሂክ ካሴድየ።<verse eid="JHN 21:14" /></para>
  <para style="s1">የሱሳና ጴጢሮሳና</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />ዎዳና ኦዋተን ካኮአባባታሬን ጎራታ፥ የሱሳ ስሞና ካአማመረ ጴጢሮሳነ፥ “ኤረ ካዮና ስሞና!፥ ህናኣኮ ሮርሰ እን ጌላታ?” አመ። ኡሱና “እ ጎታክ!፥ ጌላታኖኬ አትታ ካሳ” አመ። የሱሳና “ጭባርኬ ፎፍ” አመ። <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />የሱሳና ካላም፥ “ኤረ ካዮና፥ ስሞና፥ ሩምና እን ጌላታ?” አመ። ኡሱና፥ “እ፥ ጎታክ፥ አን ኩ ጌላታኖ አትታ ካሳ” አመ። የሱሳና፥ “ጮዴልኬ ኦር” አመ። <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />ጎራታ ካሴድና፥ “ኤረ ካዮና፥ ስሞና፤ እን ጌላታ?” አመ። ጴጢሮሳና ጎራታ ካሴድ የሱሳ፥ “እን ጌላታ?” አመ ማንኮሆሳተዉን ጋዳ ታበረ “ጎታ አት ዱባ ካሶዋ ጎጎጌላታሮና ካሶዋ” አመ። የሱሳና፥ “እዳድኬ ፎፍ አመ። <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />አን ሩምና ሩምና አማራ፥ አት ዎዳሉማ ግራን ሳርስካ እሲ ታብሳተደ ማንኮጌላተ ሴታ ግቴ፥ ጎጃሮንተ አድ ገነ ድሪርሳይናታ፥ እባዶ ካካለና ሁካ ታብስረ ሴይን ማንኮጌላኖን ጌስናራ።” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />የሱሳ ሂካ ካኮን አመራ ጴጢሮሳ ምስክ ጎይ ዋ ካባጅን ዶትሳሮ ቱስንያ። ሂታኮ ዳንቤባን ጴጢሮሳነ፥ “እን ዴበ ሰሴና” አመ።<verse eid="JHN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />ጴጢሮሳ ሃራርቲ ጎዎችሮ፥ የሱሳ ጌላታ ካግረ ኡሱኮ ካአጋልሳታረ እሶ ዴበ ካሰሰታሮ ዴ፥ ሂክ ኡሱኮ ካአጋልሳታረ ኡሱ ጎራታ ክታ ካሄመነ አማ ግራን ጌግዮ ታየሱሳ ጋባላመረ፥ “ጎታ፥ ኩ ሮርስ ካስስናራ አዮያ?” አማ ካግረያ። <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />ጴጢሮሳና ኡሱ ካኮድያረ ጎራታ፥ “ጎታ! ሂክ እባዶት ምስ ልናራ?” አመ ሆሳተ።<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />የሱሳና፥ “አን ታአባባሮቲ ኔፎ ጎጎግሮ ጎዶታተ ዱዶ ኩ መካጢበ? አት መተካዉን እን ዴበ ሰሴና” አመ።<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />ሂካኮት ኣላንቲ ሂክ የሱሳኮ ካአጋልሳታረ ላኮጎሮ ታአማታ ኦዱ አማኒል ኦሮ ዳርኣንተ። የሱሳ አደ፥ አን “ታአባባሮ ጌግን ኔፎ ጎጎግሮ ጎዶታተ ኩ መካጢበ?” አመ ኳሬ ላኮጎይናሮ አመ ላኮሰጌሮ። <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />ሂካኮክ ጋራ ካአቶታራና ሂካ ካጻፈራ ሂካ የሱሳኮ ካአጋልሳታሮያ፥ አቶናትና ሩም ላኖ ኖ ካንሶዋ።<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />የሱሳ ካፈለራ ካካለ ካሞጋን አዬስጆል ካግራ፥ አየስ ዱባ ጎጻፋመ፥ ካጻፋመሮ ማጻፋ ዱባን አላም ታሌቶ ባንኤ ካአቦ ኣን ላኮላሮ።<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>