<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Bayso New Testament</book>
  <para style="h">ራጋ</para>
  <para style="toc1">ራጋ ካያንሳ</para>
  <para style="toc2">ራጋ ካያንሳ</para>
  <para style="toc3">ራጋ</para>
  <para style="mt1">ራጋ ካያንሳ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ራጋ ካያንሳ ካኮጻፋመራ አማኒል የሱሳ ክርስቶሳ ጎታክሶ ላኖ አማናኖክሶኮት ኣላንቲ ባቃታኖና ራኮ እሶ ግያ ካኮግቴ ጎራታይየ። ጻፍት ክንትቢ ካአባተረ አየስ ኦናባባራንኮት አብድ ላኦ ታአብቶ ጎጎሌቶን አታይሲና እሶ ካጌሮ ባቃታኖና ራኮ ኦሮ አማኖክሶይ ጎጎአታናዉን ጃጀቤሲንያ።</para>
  <para style="ip">ማጻፋ ጋማ ካሆር ሞጋሰ ካአበራ እስደቤክ ራጋጆል ካአበሮያ፤ ሀሱ ራጋጆል ኡሱ ጌሲ ካግረ አማኒል አዴስን ካዳንዴሮ፤ ካካለ አደ ሆል ልጉረ ካአዳላይናሮ ምስሊኮክ አዬሲ ካሰጋመሮያ። ካማዛሙር ማዳር ማሮ ማሮ ጎጎአባባታሮክ ማለ ሂካ ማጻፋኮክ መተ መተክ ካሞጋን ራጋጆልኮክ ጋራነ ምዲ ታሞጋኒ እስደቤ ሰጋመራ። ጋራ ካማጻፋኮት ፉሬን ቆፋ ታሞጋን ታአብቶ ጎሌተና መተት ቆፋ ታሙታቶታ፤ ህክና ዋ፥ ጎታ ክርስቶሳኮት ምናነ ካላም ታኮሶሶይሶቲ ኮይክ ዱርሳና አደረ ዲናኬሳ ዱባ አዎደ፤ አዎዳኖኬሳና ካኮጉዳታረ ጎራታ ታአብዳንተ ኡናቴሳ ታኡሱብ ዳሩርና ካኡሱብ ኡልኮክ ኡሶ እሶ ኤልስናራ ካአማሮያ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="REV 1:1-8">1፡1-8</ref> </char></para>
  <para style="io1">ራጋኮት ፉረንና ቶዶባ ምን ካዋቱን ካፋራመረ ሀንዳ <char style="ior"><ref loc="REV 1:9-3:22">1፡9—3፡22</ref> </char></para>
  <para style="io1">ማጻፋጆልና ማታማል ቶዶባኮክ ፍርዳ <char style="ior"><ref loc="REV 4:1-8:1">4፡1—8፡1</ref> </char></para>
  <para style="io1">ማላካታ ቶዶባኮክ ፍርዳ <char style="ior"><ref loc="REV 8:2-11:19">8፡2—11፡19</ref> </char></para>
  <para style="io1">ዶቦንሳ ሱላለ ላማ <char style="ior"><ref loc="REV 12:1-13:18">12፡1—13፡18</ref> </char></para>
  <para style="io1">ራጋ ካሞጋን <char style="ior"><ref loc="REV 14:1-15:8">14፡1—15፡8</ref> </char></para>
  <para style="io1">ቶዶባ ሙሮ ኦዋና ጡጋል <char style="ior"><ref loc="REV 16:1-21">16፡1-21</ref> </char></para>
  <para style="io1">ባስ ካባብሎን፥ ካሱላለ፥ ካጣራ ካሄገሮልና ካዱርሳ አዎዳማኖ <char style="ior"><ref loc="REV 17:1-20:10">17፡1—20፡10</ref> </char></para>
  <para style="io1">ካጋቾ ፍርዳ <char style="ior"><ref loc="REV 20:11-15">20፡11-15</ref> </char></para>
  <para style="io1">ታኡሱብ ዳሩር፥ ካኡሱብክ ኡል፥ ታኡሱብ ኢየሩሳለም <char style="ior"><ref loc="REV 21:1-22:5">21፡1—22፡5</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="REV 22:6-21">22፡6-21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />ሂክ ራጋ ኤነ ካልናሮ ኮኮ ኡሱን ኦሀንዳራዉን ጎጎቱስሮ ዋ የሱሳ ክርስቶሳን ካስሰሮያ፤ የሱሳ ክርስቶሳና ኤርግቻኬሳ ፋረጉረ ኡሱን ካሀንዳሮ ያንሳን ሂካ ራጋ ቱሰ። <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />ያንሳና ሃፉራ ካዋኮክ ጋራና የሱሳ ክርስቶሳ ታአጋልስሰሮ ሩምኮክ ጋራ፥ ኡሱማለና ኡሱ ካቱሰሮ አየስ ዱባኮክ አቶቴ። <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />ሂክ ዱባ ካኮልናራ ጎራታ ኤነ ማንኮሌ ማራን ሂካ ካሄገሮልኮክ ሃፉራ ካናባባራ ካሶማሳመያ! ኡሱማለና ካሄገሮልኮክ ሃፉራ ኦማላራና ሄገሮ ኦሮ ካጻፋመሮ ኦፈላራን ኦሶማሳመንያን።<verse eid="REV 1:3" /></para>
  <para style="s1">እስያይ ኦሮ ባንኤ ቶዶባ ካግሮ አማኒል ዱባን ታፋራንተቶ ኖጎዳ</para>
  <para style="p">
    <verse number="4-5" style="v" sid="REV 1:4-5" />ያንሳኮ እስያይ ኦሮ ባንኤ ቶዶባ ካግሮ አማኒሉን፤ ካግራ፥ ካግረና ካኤሜይናራ ኮርፍንጀኬሳ ሆረ ካግሮ አያናጆል ቶዶባኮ፤ ኡሱማለና ጎይኮ ከያኖይ ባርክ ካሌሮ ካኡሌ ዎኖላልኮክ ሞቲኮ፥ ካአብዳመ አቶ ካሌሮኮ፥ ኖ ካጌላታሮኮና ኢግካኬሳይ ኖ ጩቦካንኮ ባልቹማ ካቤሰሮ የሱሳ ክርስቶሳኮ ስኖና ኖጎዳ እስኑን ሀሌቶ።<note caller="-" style="x"><char style="xo" closed="false">1፡4-5 </char><char style="xt" closed="false"><ref loc="EXO 3:14">ብያ. 3፡14</ref>፤ <ref loc="REV 4:5">ራጋ 4፡5</ref>፤ <ref loc="ISA 55:4">ኢሳ. 55፡4</ref>፤ <ref loc="PSA 89:27">ማዛ. 89፡27</ref>።</char></note><verse eid="REV 1:4-5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 1:6" />ካየሱሳ ክርስቶሳ ኦዶ ዋዉን ጎጎሀንዳይኖን ኖ ዎኖና ቱቃሞል ካየለሮ፥ የሱሳ ክርስቶሳን ካባጃና ሁናና ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮ ኡሱን ሀሌዎ! ሀሚኒዕ።<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ብያ. 19፡6</ref>፤ <ref loc="REV 5:10">ራጋ 5፡10</ref>።</char></note><verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />ሂክማ ኡሱ ዱማንቻይ ኤመይናራ፤ ኡሱ ካኤገራ እባዶና ሱረ አንሄሶኒ ዱባ ኡሱ ድናራ፤ ካኡሌ ጎሳ ዱባ ኣላንቲቴሳ ኦይናራ፤ እ ሂክ አየስ ሩምያ፤ ሀሚኒዕ።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔ. 7፡13</ref>፤ <ref loc="MAT 24:30">ማቶ. 24፡30</ref>፤ <ref loc="MRK 13:26">ማር. 13፡26</ref>፤ <ref loc="LUK 21:27">ሉቃ. 21፡27</ref>፤ <ref loc="1TH 4:17">1 ተስ. 4፡17</ref>፤ <ref loc="ZEC 12:10">ዛኪ. 12፡10</ref>፤ <ref loc="JHN 19:34">ያን. 19፡34</ref>፥<ref loc="JHN 19:37">37</ref>።</char></note><verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />ካግራ፥ ካግረ፥ ካኤሜይናራና ዱባ ካዳንዳራ ጎታ ዋ፥ “ካሆሬና ካሃረ አንያ!” አማራ።<note caller="-" style="x"><char style="xo" closed="false">1፡8 </char><char style="xt" closed="false"><ref loc="REV 22:13">ራጋ 22፡13</ref>፤ <ref loc="EXO 3:14">ብያ. 3፡14</ref>።</char></note><verse eid="REV 1:8" /></para>
  <para style="s1">ክርስቶሳ ራጋይ ሙታኖ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />የሱሳ ክርስቶሳ ራኮና ዎኖናትኬሳ ኡሱማሌ ኦብስ እስኔ ዎታ ካአታየራ አን አቢክስን ያንሳ ሃፉራ ካዋይና የሱሳ አቶታኖኮት ኣላንቲ ፈጢሞ ታአማማቶ ኦዶላይ አን ሽያመ ግረ፤ <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />ታጎታ አሪ አን ቆፋ ታአያና አማጋመ ግራን ታጡሩንባ ያየ ኣን ታላታ ታአቲ ያየ እንኮ ባጋንደ ሃ አማ ግራን፤ <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />“ኡሱማለና ካሙታሮ ማጻፋይ ጻፍዴ እስያይ ኦሮ ባንኤ ቶዶባ ካግሮ አማኒሉን፥ ኤፈሶን ቶስ፥ ሰምርነስ ቶስ፥ ጴርጋሞን ቶስ፥ ትያጢሮን ቶስ፥ ሰርዴስ ቶስ፥ ፍላደልፍያና ሎዶቅያ ቶስ ፋር” አማ ግራን አን ማለ።<verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />ኢነ ካአዬሰረ ማዮዮ አዴስን ሃር ካምባል አመ፤ ሃር ካምባል ካኮአምሮ ጎራታ ቶዶባ ካዎርቂ ቦላንሶል አን ዴ። <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />ቦላንሶል ጠኤ ካሰሴታሮ ኤረ ካእባዶ ኣን ካላሮ አን ዴ፤ ኡሱ ሉቃ. ሄገል ካገያሮ ሳርስ ካሳርሳተ፤ ጌግዮቴሳይ ካዎርቂ ሞዋኖ ካሞዋተሮየ።<note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔ. 7፡13</ref>፤ <ref loc="DAN 10:5">10፡5</ref>።</char></note> <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />መተኬሳና መተኬሳኮክ ብናና በለት ኣን ታላቶ ሱፊ ኣን ጉማራክየ፤ ኢልኦኦቴሳና ላጫ ካኤሌኔ አንዬን፤<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳኔ. 7፡9</ref>፤ <ref loc="DAN 10:6">10፡6</ref>።</char></note> <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />ሉቃኦቴሳና ካኤሌኔ ቦላል ኦሮ ካግሮ ካማርጮ ናስ አንዬን፤ ያየቴሳና ላጋይ ኦዳጋራን በከ ኦንጂንኮት ያየ አንተ፤<note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሕዝ. 1፡24</ref>፤ <ref loc="EZK 43:2">43፡2</ref>።</char></note> <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />ታመርገ ገነቴሳ ባራጃ ቶዶባ አበ ግረ፤ ምና ላማነ ካኤነናን ብቢር ህኢቴሳኮ ብያ ግረ፤ በቤድቴሳና ዋኣንተ ታሀንቃቶ አርት ኣንተ። <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" />ሂካ አን ካኮደያረ ጎራታ ካጎየ እባዶ ኣን ሌጉረ ሉቃኦቴሳ ሄገሊ እዬ፤ ኡሱ አደ ታመርገ ገነቴሳ እን ጉት ካየጉረ ሃ አመ፤ “አሮአብሳተ፤ ካሆሬና ካሃረ አንያ፤<note caller="-" style="x"><char style="xo" closed="false">1፡17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44፡6</ref>፤ <ref loc="ISA 48:12">48፡12</ref>፤ <ref loc="REV 2:8">ራጋ 2፡8</ref>፤ <ref loc="REV 22:13">22፡13</ref>።</char></note> <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />አን አርዶክያ፤ ጎየ ግረ፤ አየሱን ጎአመን ሂክማ፤ ጅሩ ጅሮማን አርዶክያ፤ አን ጎይ ጉቲና ቦዋ ጉት ኦዶናት አባ፤ <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />ጎርታ አት ካዴተቶ፥ ግዳ ካግሮና ሃሬ ካኤሜይናሮ ጻፍ። <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />ታመርገ ገነቴይ ካዴተቶ ባራጃል ቶዶባና ካዎርቂ ቦላንሶል ቶዶባ ሆልኮት ፉሬን ህታታ፤ ባራጃል ቶዶባ፥ ባንኤ ቶዶባ ካግሮ አማኒልኮክ ኤርግቻልያ፥ ቦላንሶል ቶዶባና፥ ባንኤ ቶዶባ ካግሮ አማኒልያ።”<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s1">ካኤፈሶን አማኒሉን</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />“ካኤፈሶን አማኒልኮክ ኤርግቻትን ሃ አም ጻፍ፤</para>
  <para style="pi" vid="REV 2:1">ሂክ አየስ ባራጃል ቶዶባ ገነ ታመርጌይ ካአባተራና ካዎርቂ ቦላንሶል ቶዶባ ጠኤ ካሰሴታራ ሃ አማራ፤ <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />ፈሎኦታ፥ ዉደታማኖካና ኦብስታ አን ካሶዋ፤ ኦሜላን አደ ኦብሲን ዳንዳና ካዋተቶ፥ ኦፋራመራን አንሌኖን ግራን ኖ ኦፋራምነኖና ኦአማራን ቆቆርተዴ ኦጣራ ኦሌራን ሄላኖካ አን ካሶዋ። <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />ኦብሲ አታታኖካና መገኬ ማራን አህፋኖን ራኮ አታታኖካ አን ካሶዋ።<verse eid="REV 2:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="REV 2:4" />አየሱን ጎአመን አን ኩ ካኮቱፋየሮ አየስ አባ፤ ህክና አት ታጣዎ ጌላንጀ ኢሰታ። <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />ጎርታ አት ኤራ አባባተ ኢተቶ ሻድ፤ ጩቦኮ ጉላ ጋል! ጣይተ ኦፈላተ ፈሎኦታ ፈላ፤ ሂካ ዱባ ፈላና ጎዋተ አን ኩ ቶስ ኤመይናራ፤ ጩቦኮ ጉላ ጋላናጎዋተ ቦላንሶካ ባንኤኮ ኬስናራ። <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />አየሱን ጎአመን አን ኩ ካኮጋላታራ አየስ ኮ ግራ፤ ህክና አን ኦኔባታሮ ካንቆላ እባዶኮኒዕ ፈሎ ዲደታ።<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />“አያና አማኒል ዱባን ካአማሮ ነበ ካአባ ሀማሎ! ‘ካአዎድናሮን ጋናተ ካዋይ ኦሮ ካግሮ ካግር ጋኮት ኢል ጎጎአምሮን አን ኡሱ የልናራ።’<note caller="-" style="x"><char style="xo" closed="false">2፡7 </char><char style="xt" closed="false"><ref loc="GEN 2:9">መጣ 2፡9</ref>፤ <ref loc="REV 22:2">ራጋ 22፡2</ref>፤ <ref loc="EZK 28:13">ሕዝ. 28፡13</ref>፤ <ref loc="EZK 31:8">31፡8</ref>።</char></note><verse eid="REV 2:7" /></para>
  <para style="s1">ካሰመርነስ አማኒሉን ካፋራመሮ ሀንዳ</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />“ካሰመርነስ አማኒልኮክ ኤርግቻትን ሃ አም ጻፍ፤<note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44፡6</ref>፤ <ref loc="ISA 48:12">48፡12</ref>፤ <ref loc="REV 1:17">ራጋ 1፡17</ref>፤ <ref loc="REV 22:13">22፡13</ref>።</char></note></para>
  <para style="pi" vid="REV 2:8">ሂክ ካሆሬና ካሃረ ካሌሮ፤ ካጎየረና አርዶክ ካሌራ ሃ አማራ። <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />ራኮታና ህዩማታ አን ካሶዋ፤ ሀሌዎ ኳሬ አት ዱሬሳታ፤ አይሁድ አንሌኖን ግራን ኖ አይሁድና ኦአማራን ታጻላዬ ኡና ኦሌራን፥ መገካ ካባሰራን አን ካሶዋ፤ <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />ሆረንባን ኩ ታግናቶ ራኮዉን አሮአብሳተ፤ ግዳ እስን ጎጎጫፋንታኑን ዱርሳ እስንኮ ኮኮ ምን ካሻኖ ታብስናራ፤ አሪ ቶሞኑን ራኮ አታይናታን፤ ታጎቶን ካአብዳንተ ሌ፤ ካግር ካላቻ አን ኩን ስስናራ።<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />“አያና አማኒል ዱባን ካአማሮ ነበ ካአባ ሀማሎ!</para>
  <para style="p" vid="REV 2:11">“ካአዎዳይናሮ ጎይ ካላም ላኮሚሮ።”<note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="REV 2:14">ራጋ 2፡14</ref>፤ <ref loc="REV 21:8">21፡8</ref>።</char></note><verse eid="REV 2:11" /></para>
  <para style="s1">ካጴርጋሞን አማኒሉን ካፋራመሮ ሀንዳ</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />“ካጴርጋሞ አማኒልኮክ ኤርግቻትን ሃ አም ጻፍ፤ ህክና ምና ላማነ ካኤነናተሮ ሺፋ ካአበራ ሃ አማራ፤ <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />አት ካጻላየ ኮርፍንጀ ታኮግሮ ባንኤ ግራኖካ አን ካሶዋ፤ ሀሌዎ ኳሬ አት መገኬ አታይሳተ አባተታ፤ አት እዬ ካአብቶ አማኖ ላኮካካተቶ፤ ካአብዳመ አቶኬ ካሌረ አንትጳስ ጻላየ ታኮግቴ ካታማትስኒ ካኮላጋዴረን ጎራታ አት እዬ አማናኖካ ሱረ ላኮኢሰተ።<verse eid="REV 2:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="REV 2:14" />አየሱን ጎአመን አን ኩ ካኮቱፋታሮ አየስ ኮኮ አባ፤ ህክና ካባላአም አጋልስስ ካአባተራ እባዶ ኮኮ እስን ኦሮ ግራ፤ ሂክ ባላም ካእስራኤል ጎሳ ቶልቻን ካጃርሳመሮ ባቦ ጎጎአምሮና ሻርሙጣኖይ ጎጎሀንዱዱፋራዉን ባላቂን ማርካ ካስሰሮያ።<note caller="-" style="x"><char style="xo" closed="false">2፡14 </char><char style="xt" closed="false"><ref loc="NUM 22:5">ቶቶ 22፡5</ref>፥<ref loc="NUM 22:7">7</ref>፤ <ref loc="NUM 31:16">31፡16</ref>፤ <ref loc="DEU 23:4">አዳ. 23፡4</ref>፤ <ref loc="NUM 25:1-3">ቶቶ 25፡1-3</ref>።</char></note> <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />ኡሱማለና ካንቆላ እባዶኮክ አጋልስስ ካአባ እባዶ እስን ኦሮ ግራ፤ <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />ሃንሱን ጩቦኮ ጉላ ጋል፤ ጎርቱን አን ሳም ኩ ቶስ ኤሜይጉረ ህኢቴኮ ካበያሮ ሺፋይ አን እሶ ኤግናራ።<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />“አያና አማኒል ዱባን ካአማሮ ነበ ካአባ ሀማሎ! ካአዎዳይናሮን ስያመ ካግሮ ማናኮ አን ኡሱን ስስናራ፤ ካኡሱብክ መገ ካኮጻፋመሮ ጉማራክ ኤኤሞ ስስናራ፤ ካአታይናሮ ኳሬ ሂካ ካካለ ማዮና ላካሶ።”<note caller="-" style="x"><char style="xo" closed="false">2፡17 </char><char style="xt" closed="false"><ref loc="EXO 16:14-15">ብያ. 16፡14-15</ref>፤ <ref loc="EXO 16:33-34">16፡33-34</ref>፤ <ref loc="JHN 6:48-50">ያን. 6፡48-50</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62፡2</ref>፤ <ref loc="ISA 65:15">65፡15</ref>።</char></note><verse eid="REV 2:17" /></para>
  <para style="s1">ካትያጢሮን አማኒሉን</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />“ካትያጢሮን አማኒልኮክ ኤርግቻትን ሃ አምደ ጻፍ፤</para>
  <para style="pi" vid="REV 2:18">ህክና ላጫ ካኤሌኔ ኣን ኦላራን ኢልኦ ካአቦኮና ቦላል ካኤሌኔይ ካዱባመሮ ታናስ ማርጮ ኣን ኦላራን ሉቃ. ካአቦ፤ ኤረ ካዋኮ ካሰጋመሮያ፤ <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />ፈሎ ኦታና ጌላንጀታ፥ አማኖካና ሀንዳኖካ ኦብሲ አታታኖካ አን ካሶዋ፤ ኦሃሬ ፈሎኦታ ኦሆሬኮ ሮራኖ አን ካሶዋ።<verse eid="REV 2:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="REV 2:20" />አየሱን ጎአመን አን ኩ ካኮቱፋታሮ አየስ ኮ አባ፤ ህክና ‘አን ካሄገሮያ’ ታአማተ ሄለልትቲ ኤልዛበል አት ዶና ሌተ ኦብሲተታ፤ ኤሰና ኢን ኦሀንዳራን ጎጎሻርሙጢራዉና ቶልቻን ካኤካተሮ ባቦ ጎጎአምራዉን አጋልስሳኖይ እሶ ሶሶይሳታ።<note caller="-" style="x"><char style="xo" closed="false">2፡20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1 ዎኖ. 16፡31</ref>፤ <ref loc="2KI 9:22">2 ዎኖ. 9፡22</ref>፥<ref loc="2KI 9:30">30</ref>።</char></note> <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />ኤሰ ጩቦኮ ጉላ ጎጎጋልቶን አን ኤሰን አሪ ስሰረ፤ ኤሰ ጎአመን ሻርሙጣኖ እስደ ጩቦኮ ጉላ ጋልን ላኮዶታተቶ። <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />ሃንሱን አልጋይ ጉት ሁዱርስረ ሀዉኣሚ ኤሰ አቦስስናራ፤ ኤሰነ ዎታ ፈሎ ኦሜላን ኦፈላራን ኦሜላን ፈሎ ኦትሶኮ ጉላ ጎጋሌን ኳሬ ኤሰነ ዎታ ኦሻርሙጠራን ዱባን ካአቲ አቦሳ አን እሶን ኬንናራ፤ <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />ይስክሴ ጎይ ሙርስናራ፤ አማኒል ዱባና ታእባዶ ቆፋና ሀልቻ ካቆቆራራ አን ላኖ እሶ ካሳንዋ፤ መተመተክሶዉን ፈሎኦትሶክ ማለ አን እሶን ስስናራ። <verse eid="REV 2:23" /><verse number="24" style="v" sid="REV 2:24" />ትያጢሮኒ ኦግታኑና ሂካ ካሜላን አጋልስስ ኦአታታናዋቴታን እስን ዱባን፥ ኡሱማለና ኮኮ ‘ታጻላዬ ታኦሮ ሆልታ’ ኦአማራነ ዎታ ዴበ ኦሰሰኖን እስኑን ካካለ አጃጃ አን ላኮስስናሮ፤ <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />አየሱን ጎአመን አን ታ ኤሜሮን ካአብታን አማኖ አታይሳዬን አባዬን።<verse eid="REV 2:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="REV 2:26" />ካአዎዳይናሮና ፈሎኦቴይ ታ ጋቾ ጌሮ ካአታታሮን አን አይዛብ ጉት ኦዶናት ስስናራ፤<verse eid="REV 2:26" /></para>
  <para style="pi">
    <verse number="27" style="v" sid="REV 2:27" />‘ዳማ ታማርጮይ ኡሱ እስን ባሪስናራ ኤሬኮ ካፈላመሮ ሁ ኣን ጫንጫን ኡሱ እሶ ቡቱትስናራ’ ሂክ ኦዶናትና አን ኣቦኬኮ ካአታየሮ ኦዶናት አንያ፤ <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />አዎዳኖኮክ ማላታ ካሌሮ ካባባርሴ ባካላ አን ኡሱን ስስናራ፤ <verse eid="REV 2:28" /><verse number="29" style="v" sid="REV 2:29" />አያና ቁሉክ አማኒል ዱባን ካአዬሳሮ ነበ ካአባ ሀማሎ!”<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s1">ካሰርዴስ አማኒሉን</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />“ካሰርዴስ አማኒልኮክ ኤርግቻትን ሃ አም ጻፍ፤</para>
  <para style="pi" vid="REV 3:1">ሂክ፥ አያናጆል ካዋ ቶዶባና ባራጃል ቶዶባ ካአበራ ሃ አማራ፤ አን ፈሎኦታ ካሶዋ፤ መጌን አርዶክታ፤ አየሱን ጎአመን አት ጎተታ። <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />ናባድ፤ ጎይን ካጋባላመሮና ኩን ካሄሰሮ ክጫርክ ኮኮ አታይሳ፤ ሄዶኬ ሆረ ሙጭ ኦአመን ፈሎኦታ አን ላኮዴሮ። <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />ጎርታ አት ምስክ አጋልስስ አታተቶና ማልተቶ ሻድ፤ ኦራ፤ ጩቦኮ ጉላ ጋል፤ ጎናባዳናዋተ አድ አን ሄቶ ኣን ደራኣ ኩ ቶስ ኤመይናራ፤ አን ኤቲ ሳቲ ኩ ቶስ ኤሜይናሮ አት ላካሶ።<note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ. 24፡43-44</ref>፤ <ref loc="LUK 12:39-40">ሉቃ. 12፡39-40</ref>፤ <ref loc="REV 16:15">ራጋ 16፡15</ref>።</char></note><verse eid="REV 3:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="REV 3:4" />አየሱን ጎአመን ሳርስክሶ ጦርቀ ሀኣትሳኖን ኦግራን እባዶጃ ኡጫር ኩኔ ዎታ ሰርዴስ ግራን፤ እሶና ጉማራክ ሳርስ ሳርሳይን ኦኮንዶትሳሮ ማንኮሌን ማራን ጉማራክ ሳርስ ሳርሳይጉሬን ኢነ ዎታ ሴይናራን። <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />ካአዎዳይናራ ሂካማሌ ጉማራክ ሳርስ ሳርሳይናራ፤ መገኬሳና ኣቦኬይና ኤርግቻልኬሳይ ሆረ አን ኡሱ አዴስስናራ፤ አርዶክ መገኬሳና ካኮማዛጋባመሮ ካግር ማዝጋባኮ ላኮሻካርናሮ። <verse eid="REV 3:5" /><verse number="6" style="v" sid="REV 3:6" />አያና ቁሉክ አማኒል ዱባን ካአዬሳሮ ነበ ካአባ ሀማሎ!”<verse eid="REV 3:6" /></para>
  <para style="s1">ካፍላደልፍያ አማኒሉን</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />“ካፍላደልፍያ አማኒልኮክ ኤርግቻትን ሃ አም ጻፍ፤</para>
  <para style="pi" vid="REV 3:7">ሂክ፥ ቁሉክና ካሩም ካሌሮ፥ ካዳዉተ ምንኮክ ቁልፍ ካአበራ ሃ አማራ፤ ኡሱ ካባናሮ ማዮና ላኮጩፍሮ፤ ኡሱ ካጩፋሮ አደ ማዮና ላኮባኖ።<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="ISA 22:22">ኢሳ. 22፡22</ref>፤ <ref loc="JOB 12:14">ኢዮ. 12፡14</ref>።</char></note> <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />አን ፈሎኦታ ካሶዋ፤ ሂክማ ማዮና ጩፍን ካዳንዴኖን ካባናመሮ ኡፋ አን ኩ ሆረ ካየራ፤ ሁናካ ክጫርክ ላኖ አን ካሶዋ፤ ሀሌዎ ኳሬ ሃፉራኬ ኦራተታ፤ መገኬና አት ላኮካካቴቶ።<note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="ISA 49:23">ኢሳ. 49፡23</ref>፤ <ref loc="ISA 60:14">60፡14</ref>፤ <ref loc="ISA 43:4">43፡4</ref>።</char></note> <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />ጎርታ አይሁድ አንሌኖን ግራን አይሁድና ኦአማራን ሀኑኡ ታጻላዬ ኡና ኦሌራን ኦጣራ ኤሜይጉሬን ሉቃኦታ ሄገሊ ጎጎኢራኑን የልናራ፤ አን ኩ ጌላታኖና እሶ ጎጎአዴስራኑን የልናራ። <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />አት ካኦብሳቶ ሌን አን ኩኔ ካአመሮ ሃፉራኬ ማንኮኦራተቶ ማራን አን ሂካ ኡሊ ኦግራን ጫፍን አላም ዱባ ጉት ታኤማቶ ታራኮ አርኮ አን ኩ ኦሮዋ።<verse eid="REV 3:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="REV 3:11" />አን ሳም ኤመይናራ፤ ካላቻካ ኩኮ ማዮና ጎጎአቶንኮ ካአብቶ አታይሳ አባ። <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />ካአዎዳይናሮ ሄዶኬክ ቁሉክ ምን ካዋይ አን ኡሱ ልበ የልናራ፤ ኤሰኮና ሱረ ኡሱ ላኮብናሮ፤ ሄዶኬክ መገና ሄዶኬት ካታማኮክ መገ ኡሱ ጉት አን ጻፍናራ፤ ህት ካታማ ዳሩርኮ ሄዶኬ ዶለኮ ታዳግናታ ታኡሱብት ኢየሩሳለምታ፤ ካኡሱብክ መገኬ ኡሱ ጉት አን ጻፍናራ።<note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="REV 21:2">ራጋ 21፡2</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62፡2</ref>፤ <ref loc="ISA 65:15">65፡15</ref>።</char></note> <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" />አያና ቁሉክ አማኒል ዱባን ካአዬሳሮ ነበ ካአባ ሀማሎ!”<verse eid="REV 3:13" /></para>
  <para style="s1">ካሎዶቅያ አማኒል</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />“ካሎዶቅያ አማኒልኮክ ኤርግቻትን ሃ አም ጻፍ፤</para>
  <para style="pi" vid="REV 3:14">ሂክ ሀሚኒዕ ካሌሮ፥ ካአብዳመና ካሩም አቶ ካሌሮ፤ መጣ ታዋ ዱባ ካኮሄላማቶ ካሌራ ሃ አማራ፤<note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="DAN 8:22">ዳኔ. 8፡22</ref>።</char></note> <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />አን ፈሎኦታ ካሶዋ፤ አት አምባልክ ጎርቱን ካጉባቶ ላኮቶ፤ አምባልክ ጎርቱን ካጉባቶ ሊ ግቴዋ ኩን ካእዳንክየ! <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />አት አምባልክ ጎርቱን ካጉባቶ አንሌኖኒ ኮልኮል ካአንተ ማንኮሌተ ማራን አን ህኢቴኮ ኩ ቤስ ቱፍናራ፤ <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />‘አን ዱሬሳያ፤ ኡራዎ ኦሞጋን አባ፤ ኢን ካሀንቃተራ ኮና ላግሮ አማታ፤ አየሱን ጎአመን አት ካዋተ፥ አጎየ፥ ህየሳ፥ ጃማስና ሀዉአይ ካግቶ ላኖካ ላካሶ፤ <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />ሃንሱን ዱረሳ ሊን ኤለኒ ካጉባመሮ ዎርቂ እንኮ ጎጎኢምናቶና፥ ሀዉአይ ላኖካኮክ ሙላ ጎልሳዪን ጉማራክ ሳርስ ሳርሳይን እንኮ ጎጎኢምናቶና ድን ካኮዳንደቶ ዶብ ካኢልኦ እንኮ ኢምናይደ ጎጎሽግዳቶን አን ኩ ጎርሳራ።<verse eid="REV 3:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="REV 3:19" />አን ካጌላታሮ ዱባ ጎርስናራ፤ ሙርስናራ፤ ሃንሱን አታ፤ ጩቦኮና ጉላ ጋል፤<note caller="-" style="x"><char style="xo" closed="false">3፡19 </char><char style="xt" closed="false"><ref loc="GEN 3:12">መጣ 3፡12</ref>፤ <ref loc="HEB 12:6">እብ. 12፡6</ref>።</char></note> <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />ሂክማ አን ጎጫ አልረ ኡፋ ባባስናራ፤ ማዮና ያየቴ ማልረ ኡፋ ኢን ጎባነ ኡሱ ቶስ ታብረ ኡሱነ ዎታ ባቦ አን ኣምናራ፤ ኡሱና ኢነ ዎታ አምናራ፤<verse eid="REV 3:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="REV 3:21" />አንና አዎደጉረ ኣቦኬነ ዎታ ኮርፍንጀ ጉት ጎጎሀማጼሮይ ኡሱማሌ ካአዎዳይናራና ኢነ ዎታ ኮርፍንጄ ጉት ጎጎሀማጽሮን የልናራ። <verse eid="REV 3:21" /><verse number="22" style="v" sid="REV 3:22" />“አያና ቁሉክ አማኒል ዱባን ካአዬሳሮ ነበ ካአባ ሀማሎ!”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s1">ዳሩሪ ካግሮ ኮርፍንጅ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />“ሂካኮ አባባየረና አን ዴ፤ ዳሩሪ ካባናመረ ኡፋ ግረ፤ አን ሆራርጀ ማለ ታግረ ታጡሩንባ ያየ ኣን ታላታ ያየ ሃ አንተ፤ ‘ኮይ ሂታራ ኤልዴ ቤ፤ ሆረንባን ሊን ካዶትሳሮ አየስ አን ኩን ቱስናራ፤’ <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />ባኔዋ አን አያና ቁሉክ አማጋመ፤ ሂክማ አን ዳሩሪ ኮርፍንጀ ዴ፤ ኮርፍንጄይ ካሀማጼራ እባዶት ኮ ግረ። <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />ኮርፍንጄይ ጉት ሀማጼ ካግረኮት ምዲ ካኢያሰጲድና ካሰርድኖ አዉኣሎክ ኤኤሞ ኣን ካላሮየ፤ ኮርፍንጄይ ማራሙረ ካመረግድ አዉኣሎክ ኤኤሞ ኣንክክ ጀሬን ካኢዳሞ ግረ።<note caller="-" style="x"><char style="xo" closed="false">4፡3 </char><char style="xt" closed="false"><ref loc="EZK 1:26-28">ሕዝ. 1፡26-28</ref>፤ <ref loc="EZK 10:1">10፡1</ref>።</char></note> <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />ኡሱማለና ኮርፍንጄይ ማራሙረ ላማታንኮ አፋር ኮርፍንጄል ግረ፤ ኮርፍንጄል ጉት ጉማራክ ሳርስ ካሳርሳተራና መተክሶ ጉት ካዎርቂ ካላቻ ካካተራ ላማታንኮ አፋሮ ጃርሳ ሀማጼ ግረ። <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />ኮርፍንጀኮ ሀንቃና ያየና ድድዴናነ ዎታ ብያ ግቴ፤ ኮርፍንጄ ሆረ ካቤባራ ዳብ ቶዶባ ግረ፤ እሶና ቶዶባ አያናጆል ካዋያን።<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="EXO 19:16">ብያ. 19፡16</ref>፤ <ref loc="REV 8:5">ራጋ 8፡5</ref>፤ <ref loc="REV 11:19">11፡19</ref>፤ <ref loc="REV 16:18">16፡18</ref>፤ <ref loc="EZK 1:13">ሕዝ. 1፡13</ref>፤ <ref loc="REV 1:4">ራጋ 1፡4</ref>፤ <ref loc="ZEC 4:2">ዛኪ. 4፡2</ref>።</char></note> <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />ኮርፍንጀ ሆረ ታሙጭንተ ማስቶቲ ኣን ዎላ ዎላ አንተ ታሀንቃታ ላቡ ግቴ፤</para>
  <para style="p" vid="REV 4:6">“ኮርፍንጀ ጠኤይና ማራሙረ ሆረነና ሃሬ ኢልኦ ኦሞጋን ታአብታ ኔፎ ታአብታ መጣ አፋሮ ግቴ፤ <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />ታሆሬ ኔፎ ታአብታ መጣ ሉባን ኣን ላቴ፥ ታላም አሪ ኣን ላቴ፥ ታሴድ ኔፎ ታአብታ መጣና በቤድ ታእባዶ ኣን ላቴ፥ ታአፋር ኔፎ ታአብታ መጣና ካቡባሮ ላቦባ ኣን ላቴ። <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />ኔፎ ታአብታ መጣ አፋሮ መተመተይ ባላሎ ሌ አባናይተ፤ ኡሱ ማራሙረና ኦሮኦትሶይ ኢልኦ አማጋመሬን፤ አሪና ሄመን፤</para>
  <para style="q1" vid="REV 4:8">“ቁሉክ፥ ቁሉክ፥ ቁሉክ</para>
  <para style="q2" vid="REV 4:8">ዱባ ካዳንዳራ ጎታ ሄዶ፥</para>
  <para style="q2" vid="REV 4:8">ካግረ፤ ካግራና ካኤሜይናራ” አማኖ ላኮኢሳሬን።<note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="EZK 1:18">ሕዝ. 1፡18</ref>፤ <ref loc="EZK 10:12">10፡12</ref>፤ <ref loc="ISA 6:2-3">ኢሳ. 6፡2-3</ref>።</char></note><verse eid="REV 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="REV 4:9" />ህት ኔፎ ታአብታ መጣ ኮርፍንጀ ጉት ካሀማጼሮና ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮን ካግርናሮን ጂናን፥ ካባጃና ጋላታ ካኮስሳራን ጎራታ ዱባ፥ <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />ላማታንኮ አፋሮ ጃርሳ ጅሩ ጅሮማን ካግርናሮን፥ ኮርፍንጄይ ጉት ካሀማጼሮ ሆረ ሆረ በቤዲ ኡል ኦዬረን ሳጋዳራን፤ ካላቻክሶና ኮርፍንጄይ ሆረ ካዬንጉሬን፥ ሃ አመን፤<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />“ጎታካንና ዋ ሄዶካን!</para>
  <para style="q1" vid="REV 4:11">አት ካመን ዱባ ማንኮመጢተቶ ማራን፥</para>
  <para style="q1" vid="REV 4:11">ካመን ዱባ ካኮመጣመራና</para>
  <para style="q2" vid="REV 4:11">ካኮግርናራ (ግር ካሄላተራ) ፈኢታይ ማንኮሌ ማራን፥</para>
  <para style="q2" vid="REV 4:11">ጂንና፥ ካባጃና ሁናና ኩን ዶትሳራ አማ ግረን።”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s1">ማጻፋና ኢዳዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />ኮርፍንጄ ጉት ካሀማጼራ ምና ታሳሬነና ታኦሮነ ካጻፋመሮ ማታማል ቶዶባይ ካባሳመሮ ካዱባመ ካጋልባ ማጻፋ ገነ ታመርጌይ አበ ግራን አን ዴ።<note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="EZK 2:9-10">ሕዝ. 2፡9-10</ref>፤ <ref loc="ISA 29:11">ኢሳ. 29፡11</ref>።</char></note> <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />ካአቲ ኤርግቻት ኮ ታአቲ ያዬይ፥ “ማታማል ፉርንና ካዱባመሮ ካጋልባ ማጻፋ ባንን ካዶትሳራ አዮያ?” አመ አዬሳ ግራን አን ዴ። <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />አየሱን ጎአመን ዳሩርና ሌረ ኡሊ ጎርቱን ኡልኮ ሄገሌ ካዱባመሮ ካጋልባ ማጻፋ ኦሮ ባን ድን ካዳንዴ ማዮና ላኮግረ። <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />ካዱባመሮ ካጋልባ ማጻፋ ኦሮ ባን ድን ካኮንዶትሳረ ማንኮዋታመ ማራን አን ኣሎ ኦየ። <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />ሀሱ ጎራታ ጃርሶለኮ ኮ ኢነ፥ “አት አሮኦተ፤ ሂክማ ታይሁዳ ኣኒ ካሌራ ሉባን ታዳዉተ አላታንኮክ ህዲድኮ ካኬራ ኡሱ አዎደራ፤ ኡሱ ካዱባመሮ ካጋልባ ማጻፋና ማታማል ቶዶባ ባንን ዳንዳራ” አመ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="GEN 49:9">መጣ 49፡9</ref>፤ <ref loc="ISA 11:1">ኢሳ. 11፡1</ref>፥<ref loc="ISA 11:10">10</ref>።</char></note><verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />ሂካኮ አባባተረ ኔፎ ታአብቶ መጣ አፋር ጠኤ፥ ኮከ ካጎሳመሮ ኣን ካላሮ ጃርሶለ ጠኤ ካአሌሮ ኢዳዶ አን ዴ፤ ሂክ ኢዳዶትና ማሻ ቶዶባና ኢልኦ ቶዶባ አባናየ፤ እሶና ሂካ አላም ቶስ ኦፋራመራን ካዋ አያናልያን።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ. 53፡7</ref>፤ <ref loc="ZEC 4:10">ዛኪ. 4፡10</ref>።</char></note> <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />ሂክ ኢዳዶ ኤመተጉረ ኮርፍንጀ ጉት ካሀማጼሮኮት ገነ ታመርገኮ ካዱባመሮ ካጋልባ ማጻፋ ኣተ። <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />ካዱባመሮ ካጋልባ ማጻፋ ካኮአታረ ጎራታ ኔፎ ታአብታ መጣ አፋሮና ጃርሶለ ላማታንኮ አፋሮ ኡሱ ኢዳዶ ሆረ ግልቢሴን በቤዲ ኡል ኦዬን፤ እሶ መተመተይ በገና አባተን ግረን፤ ኡሱማለና ቁሎሌኮክ ኤብ ካሌራ ኢጣና ካኮአማጋመረ ካዎርቂ ሁይ ጃርሶ አባተን ግረን።<note caller="-" style="x"><char style="xo" closed="false">5፡8 </char><char style="xt" closed="false"><ref loc="PSA 141:2">ማዛ. 141፡2</ref>።</char></note> <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />ካኡሱብ ማዛሙር ሃ አማ ዛማሬን፤</para>
  <para style="q1" vid="REV 5:9">“ኢግካይ ኣኒ ኣኒኮ፥ ሄኢ ህኢኮ፥</para>
  <para style="q2" vid="REV 5:9">ኡናኡናኮ፥ ጎሳጎሳኮ</para>
  <para style="q1" vid="REV 5:9">እባዶ ዋዉን ዎዶ ሊ ኤካስን፥</para>
  <para style="q2" vid="REV 5:9">አት ማንኮኤናንተቶ ማራን</para>
  <para style="q2" vid="REV 5:9">ካዱባመሮ ካጋልባ ማጻፋ ኣትን</para>
  <para style="q2" vid="REV 5:9">ማታማልኬሳና ባንን ካዶትሳቶ ሌተታ፤<note caller="-" style="x"><char style="xo" closed="false">5፡9 </char><char style="xt" closed="false"><ref loc="PSA 33:3">ማዛ. 33፡3</ref>፤ <ref loc="PSA 98:1">98፡1</ref>፤ <ref loc="ISA 42:10">ኢሳ. 42፡10</ref>።</char></note><verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />ሄዶኬዉን ዎኖና ቱቃሞል</para>
  <para style="q2" vid="REV 5:10">ጎጎሌራኑን አት እሶ የልተታ፤</para>
  <para style="q2" vid="REV 5:10">ኡሊ ጉቲና ሬድናራን።”<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ብያ. 19፡6</ref>፤ <ref loc="REV 1:6">ራጋ 1፡6</ref>።</char></note><verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />አን ኤሰራ ጎዴሮ ኮርፍንጄሊ፥ ኔፎ ካአባ መጣጆልና ጃርሶለይ ማራሙረ ካሞጋን ኤርግቻልኮት ያየ አን ማለ፤ ሞጋንክሶና ቶታም ካሄሌላሞንየ፤<note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="DAN 7:10">ዳኔ. 7፡10</ref>።</char></note> <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />ታአቲ ያዬይና፥</para>
  <para style="q1" vid="REV 5:12">“ኮከ ካጎሳመሮ ኢዳዶ ሁና፥ ዱሩማ፥</para>
  <para style="q2" vid="REV 5:12">ቃሩማ፥ አታን፥ ጂናን፥ ካባጃና</para>
  <para style="q2" vid="REV 5:12">ጋላታ አታይን ካዶትሳሮያ” አመን።<verse eid="REV 5:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="REV 5:13" />ዳሩርና ኡሊ፥ ኡልኮ ሄገለና በከ፥ እሶ ኦሮ ታግታ መጣ ዱባ፥</para>
  <para style="q1" vid="REV 5:13">“ኮርፍንጀ ጉት ካሀማጼሮና ኢዳዶን</para>
  <para style="q2" vid="REV 5:13">ጋላታ፥ ጂናን፥ ካባጃና ሁና</para>
  <para style="q2" vid="REV 5:13">ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮ ሀሌዎ!” እሶ አማ ግራን አን ማለ።<verse eid="REV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />ኔፎ ታአብታ መጣ አፋሮና፥ “ሀሚኒዕ!” አንተ፤ ላማታንኮ አፋሮ ጃርሶለና ግልቢሰንጉሬን በቤዲ ኡል ኦዬን ሳጋደን።<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s1">ማታማልኮክ ባናማኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />ሂካኮ አባባተረ ኢዳዶ ማታማል ቶዶባኮ ካሆራርጄ ባና ግራን አን ዴ። ኔፎ ካአቦ መጣጆል አፋርኮ ኮ ባንቃኖ ኣን ህዲድ ታአማቶ ያዬይ፥ “ኮያ!” አማ ግራን አን ማለ። <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />አን ፋራድ ጉማራክ ዴ፤ ፋራድ ጉት ካሀማጼራ ዳዌ አባተ ግራን አን ዴ፤ ካላቻና ኡሱን ስሳመ፤ ኡሱና ካአዎደሮ ሌጉረ አዎዳኖኮ አዎዳኖ ቶስ ሴይን ቤ።<note caller="-" style="x"><char style="xo" closed="false">6፡2 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">ዛኪ. 1፡8</ref>፤ <ref loc="ZEC 6:3">6፡3</ref>።</char></note><verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />እዳዶ ካላምክ ማታማ ካኮባናረ ጎራታ፥ ታላምት ኔፎ ታአብታ መጣ፥ “ኮያ!” አማ ግራን አን ማለ። <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />ካካለ ሄላክ ፋራድ ቤ፤ ፋራድ ጉት ካሀማጼሮን ኖጎዳ ኡልኮ ጎጎባስሮና እባዶ እስእስኦሮ ጎጎጉዳሮን የልን ኦዶናት ኡሱን ስሳመ፤ ካአቲ ሺፋና ኡሱን ስሳመ።<note caller="-" style="x"><char style="xo" closed="false">6፡4 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">ዛኪ. 1፡8</ref>፤ <ref loc="ZEC 6:2">6፡2</ref>።</char></note><verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />እዳዶ ካሴድ ማታማ ካኮባናረ ጎራታ ታሴድ ኔፎ ታአብታ መጣ፥ “ኮያ!” አማ ግራን አን ማለ፤ አንና ጋምባላክ ፋራድ ዴ፤ ፋራድ ጉት ካሀማጼራ ካኮሄረግሳራን ገነቴሳይ አባተ ግረ፤<note caller="-" style="x"><char style="xo" closed="false">6፡5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">ዛኪ. 6፡2</ref>፥<ref loc="ZEC 6:6">6</ref>።</char></note> <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />ኔፎ ካአቦ መጣጆል አፋርኮ ታበያቶ ያየ ኣን ታላቶ አን ማለ፤ ህት ያየና፥ ኪሎ ቶኮት ምና ግታት ዳርጋማ አሪ ቶክ ዳሞዛ፥ ኪሎ ቶና ምናና ካሌሮ “ሀኡር አሪ ቶክ ዳሞዛ ሀሌዎ፤ ዛይቲና ዎይኒ አሮምርተ!” አማ ግራን አን ማለ።<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />እዳዶ ካአፋር ማታማ ካኮባናረ ጎራታ ታአፋር ኔፎ ታአብቶ መጣኮት ያየ፥ “ኮያ!” አማ ግራን አን ማለ፤ <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />አን ሽርንዶክ ፋራድ ዴ፤ ኡሱ ፋራዲ ጉት ካሀማጼሮኮክ መገ ጎይ አማማረ፤ ቦዋና ኡሱ ዴበ ሰሴታ ግረ፤ ጎይና ቦዋና ታኡሌ ገነ አፋርኮ ቶ ጀሬኒ፥ ኡኢ፥ ኩባ ኡሊ ጉት ኔፎ ታአብቶ መጣ ጎጎላጋድራኑን እሶን ኦዶናት ስሳመ።<note caller="-" style="x"><char style="xo" closed="false">6፡8 </char><char style="xt" closed="false"><ref loc="EZK 14:21">ሕዝ. 14፡21</ref>።</char></note><verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />ካከን ማታማ ካኮባናማረ ጎራታ፥ ሃፉራ ካዋ ማራና እሶ ካስሰራን አቶ ማራን ካጎየሮ እባዶኮት ኔፎ ታጃርሶ ባንኤ ሄገሊ አን ዴ፤ <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />እሶና ታአቲ ያዬይ፥ “ዱባንኮ ጦቂ ካአንተ፥ ቁሉክና ካሩም ዋ! ኡሊ ካግሮ እባዶ ጉት ካኮንፍርድኖና ኢግካን ማራን ሀሎ ካኮብያናዋታ አት ሀጌ ታ ጌቶንያ? አማ ኦኬን።” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />እሶን መተመቴ ጉማራክ ሳርስ ስሳመ፤ እሶ ኣን ጋና ኦጎይናራዉን፥ እሶ አን ኦሀንዳራን ሳትላልትሶና አቢላልትሶኮት ቶቶ ታ አማጋምራን ጎራታ ክጫር ጎጎኦብስራዉን እሶን ሰጋመ።<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />ኤሰኮ አባባተረ ኢዳዶ፥ ማታማ ካሌይ ካኮባናረ ጎራታ አን እሶ ቶስ ዴ፤ ሀሱ ጎራታ ኡልኮክ ሻላጋማኖ ሌ፤ አርቲ ጋምባላክ ሳርስ ካሬስሴ ኣን ጋምባላ ሌተ፤ ድግንና ኢግ ኣን ሄላ ሌተ።<note caller="-" style="x"><char style="xo" closed="false">6፡12 </char><char style="xt" closed="false"><ref loc="REV 11:13">ራጋ 11፡13</ref>፤ <ref loc="REV 16:18">16፡18</ref>፤ <ref loc="ISA 13:10">ኢሳ. 13፡10</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፡10</ref>፥<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፡15</ref>፤ <ref loc="MAT 24:29">ማቶ. 24፡29</ref>፤ <ref loc="MRK 13:24-25">ማር. 13፡24-25</ref>፤ <ref loc="LUK 21:25">ሉቃ. 21፡25</ref>።</char></note> <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />ታአቲ አምባል ኬተጉደ ካባላስ ጋ ጎአኢሶ ታዱባንተታ ኢል ጋኮ ጎጎኡባቶ ማለ ዳሩርኮ ባራጃልና ኡባተ።<note caller="-" style="x"><char style="xo" closed="false">6፡13 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34፡4</ref>።</char></note> <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />ዳሩርና ካዱባመሮ ማጻፋ ኣን ዱባንተ ባተ፤ ዎዳሚል ዱባና ኦዶላል ዱባ ባንኤትሶኮ ባዬን።<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="REV 16:20">ራጋ 16፡20</ref>።</char></note> <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />ካኡሌ ዎኖላል፥ ሞትጆል፥ ካጀረነ ዎይቻል፥ ዱሬሳል፥ ኦአቲ፥ ድይል ባልቻል ዱባ ላጋልና ዎዳሚል ኤኤሞል ኦሮ ስያሜን፤<note caller="-" style="x"><char style="xo" closed="false">6፡15 </char><char style="xt" closed="false"><ref loc="ISA 2:19-21">ኢሳ. 2፡19-21</ref>።</char></note> <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />ዎዳሚልና ኤኤሞል፥ “ኖ ጉት እያ! ኮርፍንጀ ጉት ካሀማጼሮ ሆረ፥ ታኢዳዶ ኤንገኮ ኖ ጎልሳ!<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሴ 10፡8</ref>፤ <ref loc="LUK 23:30">ሉቃ. 23፡30</ref>።</char></note> አመን። <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />ታአቲ ታኤንጌ አሪ ኤሜተታ፤ አዮያ አራኣይ አልን ካዳንዴራ?” አመን።<note caller="-" style="x"><char style="xo" closed="false">6፡17 </char><char style="xt" closed="false"><ref loc="JOL 2:11">ኢዩ. 2፡11</ref>፤ <ref loc="MAL 3:2">ሚል. 3፡2</ref>።</char></note><verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s1">144,000 ካእስራኤል እባዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />ኤሰኮ አባባየረ ኤርግቻል አፋሮ ኡሊ ጉት ምና አፋርነ አሌ ካግሮ አን ዴ፤ እሶና ኡሊና ሌረ በከ ኦሮ ጎርቱን ጋ ጉት አምባል ሱረ ጎጎኬኖንኮ ኡሊ ጉት ምና አፋርኮ ታኤማቶ አምባል ኣልሴን።<note caller="-" style="x"><char style="xo" closed="false">7፡1 </char><char style="xt" closed="false"><ref loc="JER 49:36">ኤር. 49፡36</ref>፤ <ref loc="DAN 7:2">ዳኔ. 7፡2</ref>፤ <ref loc="ZEC 6:5">ዛኪ. 6፡5</ref>።</char></note> <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />አርዶክ ሄዶኮክ ማታማ ካአበራ ካካለ ኤርግቻ ምና ታብያንኮ ኤመታ ግራን አን ዴ፤ ኡልና በከና ጎጎሚራዉን ኦዶናት ካኮስሰሮ ኤርግቻ አፋሩን ያየ ጦቂሰረ፤ <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“ሄዶካኒን ኦሀንዳራንኮት በቤድ ጉት ኖ ማታማ ታ ካይኖን፥ ኡልና ሌረ በከ ጎርቱን ጋዶል አሮምርቴን” አመ።<note caller="-" style="x"><char style="xo" closed="false">7፡3 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፡4</ref>፥<ref loc="EZK 9:6">6</ref>።</char></note> <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />ማታማ ካኮካመሮ እባዶኮኒዕ ቶቶና ማለ፤ ታእስራኤል ኣኒኮ ማታማ ካኮካመሮ እባዶኮኒዕ ቶቶ 144,000። <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />ታይሁዳ ኣኒኮ ማታማ ካኮካመራ 12,000፥ ታሮቤል ኣኒኮ 12,000፥ ታጋድ ኣኒኮ 12,000፥ <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />ታአሴር ኣኒኮ 12,000፥ ታንፍታሌም ኣኒኮ 12,000፥ ታሚናሰ ኣኒኮ 12,000፥ <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />ታስሞና ኣኒኮ 12,000፥ ታዎዮሌ ኣኒኮ 12,000፥ ታይሳኮር ኣኒኮ 12,000፥ <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />ታዛብሎን ኣኒኮ 12,000፥ ታዮሴፋ ኣኒኮ 12,000፥ ታብንያመ ኣኒኮ 12,000ዬን።<verse eid="REV 7:8" /></para>
  <para style="s1">ጉማራክ ሳርስ ካሳርሳተሮ ካሞጋን ጎሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />ሂካኮ አባባየረ፤ ማዮና ቶት ካሄሌሎን እባዶ ዴ፤ እሶ ጎሳ ዱባኮና ኣኒ ዱባኮ፥ ኡና ዱባኮና ካለካለት ሄኢ ካአዬሳሮ ዱባኮ ካበቤሮየ፤ ሂኒዕ ጉማራክ ሳርስ ሳርሳቴረን፤ ባላሎ ኦዛንባባ ገነትሶይ አባተንጉረን ኮርፍንጄይና ኢዳዶይ ሆረ አሌን ግረን፤ <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />ታአቲ ያዬ ኦካ፥</para>
  <para style="q1" vid="REV 7:10">“ፋይና ካኮሄላማራ ኮርፍንጄ ጉት ካሀማጼሮ</para>
  <para style="q2" vid="REV 7:10">ሄዶካንኮና ኢዳዶኮያ!” አማ ግረን።<verse eid="REV 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11" />ኤርግቻል ዱባ ኮርፍንጄይና ጃርሶለይ ኔፎ ታአብቶ መጣ አፋሪ ማራሙረ አሌ ግረ፤ ኮርፍንጄይ ሆረ ግልቢሴን በቤዲ ኡል ኦዬረን ዋዉን ሳጋደን፤ <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />ሃና አመን፤</para>
  <para style="q1" vid="REV 7:12">“ሀሚኒዕ! ሳድሳማኖ፥ ጂናን፥ ቃሩማ፥</para>
  <para style="q2" vid="REV 7:12">ጋላታ፥ ካባጃ፥ ሁና፥ አታን</para>
  <para style="q2" vid="REV 7:12">ሄዶካንዉን ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮ ሀሌዎ! ሀሚኒዕ።”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />ጃርሶለኮ ኮ እን ቶስ ካምባል አመረ፥ “ሂኒዕ ጉማራክ ሳርስ ኦሳርሳቴራን አዮስያን? ሀጌኮ ኤመቴራን?” አመ።<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />አንና “ጎታ! አት ካሶዋ” አመ። ኡሱና ኢነ ሃ አመ፤ “ሂኒዕ ታአቲ ራኮ ኦሮማሬን ሮረን ኦኤሜተራንያን፤ ሳርስክሶና ካኢዳዶ ኢግ አልሳቴን ጉማራ የላተራን፤<note caller="-" style="x"><char style="xo" closed="false">7፡14 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳኔ. 12፡1</ref>፤ <ref loc="MAT 24:21">ማቶ. 24፡21</ref>፤ <ref loc="MRK 13:19">ማር. 13፡19</ref>።</char></note> <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />ሃንሱን ኮርፍንጀ ካዋይ ሆረ አሌረን አሪና ሄመን ቁሉክ ምን ካዋይ ኡሱን ሀንዳራን፤ ኮርፍንጄይ ጉት ካሀማጼራና እሶን ምን ልናራ። <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />ሂታኮ ሆረንባን እሶ ላኮኡኢናራን፥ ላኮሱጉባይናራን፥ አሪትና እሶ ላኮባሶ፤ ፉርሳና እሶ ላኮሄልቶ።<note caller="-" style="x"><char style="xo" closed="false">7፡16 </char><char style="xt" closed="false"><ref loc="ISA 49:10">ኢሳ. 49፡10</ref>።</char></note> <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />ኮርፍንጄይ ጠኤ ካግራ ኢዳዶ እሶ ካፎፋሮ ልናራ፤ ኦግር በከኮክ ፉልቶ ቶስ እሶ ቃጄልስናራ፤ ዋ ኢልም ዱባ ኢልኦ ኦትሶኮ ሻካርናራ።”<note caller="-" style="x"><char style="xo" closed="false">7፡17 </char><char style="xt" closed="false"><ref loc="PSA 23:1-2">ማዛ. 23፡1-2</ref>፤ <ref loc="EZK 34:23">ሕዝ. 34፡23</ref>፤ <ref loc="ISA 49:10">ኢሳ. 49፡10</ref>፤ <ref loc="ISA 25:8">25፡8</ref>።</char></note><verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s1">ካቶዶብ ማታማ ባናማኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />እዳዶ ማታማ ካቶዶብ ካኮባናረ ጎራታ ሳቲ ቶኮት ምና ዳሩር ጫልአንተ፤ <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />ዋይ ሆረ ካአልናሮ ኤርግቻል ቶዶባ ዴ፤ እሶና ማላካታ ቶዶባ ስሳመ።<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />እጣና ካኮኢዮሳራን ካዎርቂ ሁ ካአባተራ ካካለ ኤርግቻት ኤመተጉረ ታጃርሶ ባንኤ ዶሌ አሌ፤ ኮርፍንጄይ ሆረ ካግሮ ካጃርሶ ካዎርቂ ሁይ ጉት ካቁሎሌ ኤብነ ዎታ ካስሳምሮ ካሞጋን ኢጣና ኡሱን ስሳመ።<note caller="-" style="x"><char style="xo" closed="false">8፡3 </char><char style="xt" closed="false"><ref loc="AMO 9:1">አሞ. 9፡1</ref>፤ <ref loc="EXO 30:1-3">ብያ. 30፡1-3</ref>።</char></note> <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />ካኢጣና ኢይ ካቁሎሌ ኤብነ ዎታ ገነ ታኤርግቻትኮ ዋ ቶስ ቤ። <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />ሂታኮ አባባተረ ኤርግቻት ኢጣና ካኮኢዮሳራን አበጉረ ታጃርሶ ባንኤኮ ኤለን ክበ አማገጉረ ኡል ቶስ ሻፈ፤ ድዲዴና፥ ታአቲ ያዬ፥ ባንቃኖ፥ ኡልኮክ ሻላጋማኖና ሌ።<note caller="-" style="x"><char style="xo" closed="false">8፡5 </char><char style="xt" closed="false"><ref loc="LEV 16:12">ዎዩ. 16፡12</ref>፤ <ref loc="EZK 10:2">ሕዝ. 10፡2</ref>፤ <ref loc="EXO 19:16">ብያ. 19፡16</ref>፤ <ref loc="REV 11:19">ራጋ 11፡19</ref>፤ <ref loc="REV 16:18">16፡18</ref>።</char></note><verse eid="REV 8:5" /></para>
  <para style="s1">ማላካታኮክ ኡፉፋማኖ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />ማላካታ ቶዶባ ካአባተራ ኤርግቻል ቶዶባ ማላካታክሶ ኡፉፋይን እስ ኤካሳቴን።<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />ካሆራርጄ ኤርግቻት ማላካታኬሳ ኡፉፈ፤ ኢግ ታኮለለዳመሮ በሌትና ኤለን ሌ፤ ኡል ቶንሳ ሻፋመ፥ ኡልኮና ገነ ታሴድ ጉባተ፤ ጋኮና ገነ ታሴድ ጉባተ፤ ካጫሪደራ ኤስ ዱባና ጉባተ።<note caller="-" style="x"><char style="xo" closed="false">8፡7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">ብያ. 9፡23-25</ref>፤ <ref loc="EZK 3:22">ሕዝ. 3፡22</ref>።</char></note><verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />ካላም ኤርግቻትና ማላካታኬሳ ኡፉፈ፥ ታንጂንት ዎዳም ኣን ካላራ ማመ ቤባ በከ ኦሮ እዬ፤ በከና ገነ ታሴድ ኢግ ሌን፤ <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />በከ ኦሮ ታግቶ ኔፎ ታአብቶ መጣኮ ገነ ታሴድ ጎተ፤ ማርካፋልኮና ገነ ታሴድ ኤኤብተ።<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />ካሴድ ኤርግቻትና ማላካታኬሳ ኡፉፈ፤ ዳብ ኣን ካቤባራ ካንጂንክ ባራጃ ዳሩርኮ እዬ፤ ካኢየራና ካዳጋሮ ማዳ ገነ ታሴድና ካበከ ፉልቶል ጉቲያ።<note caller="-" style="x"><char style="xo" closed="false">8፡10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">ኢሳ. 14፡12</ref>።</char></note> <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />ባራጃኮክ መገና እሬቶ አማማራ፤ ታበከ ገነ ታሴድኮ ገነ ቶ ኦኦኮኮታራን ሌን፤ ኦኦኮኮታራን በከኮት ኣላንቲ ካሞጋን እባዶ ጎየ።<note caller="-" style="x"><char style="xo" closed="false">8፡11 </char><char style="xt" closed="false"><ref loc="JER 9:15">ኤር. 9፡15</ref>።</char></note><verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />ካአፋር ኤርግቻት ማላካታኬሳ ኡፉፈ፤ አርት ገነ ሰድኮ ገነ ቶ፥ ድግኒ ገነ ሰድኮ ገነ ቶ፥ ባራጃል ገነ ሰድኮ ገነ ቶ ባሳመ፤ ሃንሱን እሶ ዱባኮ ገነ ሰድኮ ገነ ቶ ሙጉድ ሌተ፤ ኡሱማሌ አሪ ገነ ሰድኮ ገነ ቶና ሄመን ገነ ሰድኮ ገነ ቶ ኢፋ ካላይት ሌተ።<note caller="-" style="x"><char style="xo" closed="false">8፡12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፡10</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፡7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፡10</ref>፥<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፡15</ref>።</char></note><verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />ሂካኮ አባባይረ አን ካኮዴሮ ጎራታ ላቦባ ቶ ዳሩርኮ ቡባ ታአቲ ያዬይ፥ “ኦሄሴራን ኤርግቻጃ ሴዶ ማላካታክሶት ያየ ካኮማልስሳሬን ጎራታ ኡሊ ካግሮ እባዶን ኣኔ! ኣኔ! ኣኔ!” አማ ኦካ ግራን አን ማለ።<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />ካከን ኤርግቻት ማላካታኬሳ ኡፉፈ፤ ዳሩርኮ ሄገልዴ ኡሊ ካኢየሮ ባራጃ ኮ ዴ፤ ቦላክ ጉምቢ ካኮባናራን ቁልፍ ኡሱን ስሳመ። <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />ኡሱና ቦላክ ጉምቢ ባነ፤ ኢይና ካአቲ አባርኮ ካበያሮ ኢይ ኣን ሌ ቦላክ ጉምቢኮ ቤ፤ ጉምቢኮ ካበያሮ ኢይኮት ኣላንቲ አሪትና ዳሩሪ ሙጉድ ሌተ።<note caller="-" style="x"><char style="xo" closed="false">9፡2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">መጣ 19፡28</ref>።</char></note> <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />እይ ኦሮኮ ከንተፋሮል ቤጉረ ኡል ጉት ዳገ፤ ኡሊ ጉት ጫጫቦን ካስሳመሮ ሁና ኣንክክ ሁና እሶን ስሳመ።<note caller="-" style="x"><char style="xo" closed="false">9፡3 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ብያ. 10፡12-15</ref>።</char></note> <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />ኡሊ ካግሮ ኤንሳ ሌረ ማመና ጫሪዶክ ኮኮ ጎርቱን ማምስክ ጋ ጎጎሚሮንኮ እሶን ሰጋመ፤ ሚራኣምን ካዶትሳራ ጎአመን በቤዲ ጉት ማታማ ካዋ ካኮዋታመሮ እባዶ ካላልየ።<note caller="-" style="x"><char style="xo" closed="false">9፡4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፡4</ref>።</char></note> <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />እሶና ጎሌና ድግኒ ከኑን አቦስስንያ ኳሬ ላጋዲን ፈኢ ላኮስሳንተቶ፤ ከንተፋሮልና ካጌግሳራ አቦሳ ጫጫቦ እባዶ ጎአባሮ ጎጎሀዉኢሳሮክ ማሌያ።<note caller="-" style="x"><char style="xo" closed="false">9፡5 </char><char style="xt" closed="false"><ref loc="JOB 3:21">ኢዮ. 3፡21</ref>፤ <ref loc="JER 8:3">ኤር. 8፡3</ref>።</char></note> <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />ኤሰ አሪ እባዶ ጎይ ሀልችናራ፤ አየሱን ጎአመን ጎይ እሶ ላኮሄልናሮ፤ ጎይን ሀልቺናራን፤ አየሱን ጎአመን ጎይ እሶኮ ባቃይናራ።<note caller="-" style="x"><char style="xo" closed="false">9፡6 </char><char style="xt" closed="false"><ref loc="JOB 3:21">ኢዮ. 3፡21</ref>፤ <ref loc="JER 8:3">ኤር. 8፡3</ref>።</char></note><verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />ከንተፋሮልና ጀሬኑን ካኤካተሮ ፋራድ ኣን ላረ፤ መተክሶ ጉት ካዎርቂ ካላቻ ኣን ካላራ ኮኮ ግረ፤ በቤድትሶና ታእባዶ በቤድ ኣን ላቴ፤<note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="JOL 2:4">ኢዩ. 2፡4</ref>።</char></note> <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />መተ ካሄለለ ኣን ካላሮ መተ አባናየን፤ ኢልኮኦትሶና ኦሉባን ኢልኮ ኣን ላረን፤<note caller="-" style="x"><char style="xo" closed="false">9፡8 </char><char style="xt" closed="false"><ref loc="JOL 1:16">ኢዩ. 1፡16</ref>።</char></note> <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />እሶ ካማርጮ ላላ<note caller="+" style="f"><char style="fr" closed="false">9፡9 </char><char style="fqa" closed="false">ላላ (ጥሩር) </char><char style="ft" closed="false">አማኖ ማርጮኮ ካፈላማሮ ጌግዮ ካሙዋታራን ሁ ካጀሬኔያ። </char></note> ኣን ካላሮ ሁ ካጀሬን ላላ አባናየን፤ ባላሎኦትሶኮክ ሃፉራ ጀሬን ሻፋይን ካትያራ ፋራንዳ ኦሶርጋን ታማልስሳራን ያየ ኣን ላቴ።<note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="JOL 2:5">ኢዩ. 2፡5</ref>።</char></note> <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />ጫጫቦ ኣን ደቤና ካኤጋሮ ሌማ አባናየን፤ ደበትሶይ ኦሮ ድግኒ ከኑን እባዶ ካኮሚርአን ሁና አባናየን። <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />እሶ ዎኖ አባናየን፤ ኡሱና ቦላክ ጉምቢኮክ ኤርግቻትያ፤ መገኬሳና ታኢብራይስጢ ሄኢ አባዶን፥ ታግሪክ ሄኢ አጶልዮን አማማረ።<note caller="+" style="f"><char style="fr" closed="false">9፡11</char><char style="fqa" closed="false">አባዶን ጎርቱን አጶልዮን </char><char style="ft" closed="false">አማኖ ካባሳሮ ጎርቱን ኢግ ካአባባሮ አማኖያ። </char></note><verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />ታሆሬ ኣኔ ሮርተታ፤ ሂታኮ አባባይደ ታካለ ኣኔ ላማ ጋና ኤመይናታ።<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />ካሌይ ኤርግቻት ማላካታ ኡፉፈ፤ ዋይ ሆረ ካግሮ ዎርቂኮ ካፈላመሮ ካጃርሶ ማሻኮ ያየ ብያ ግራን አን ማለ።<note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="EXO 30:1-3">ብያ. 30፡1-3</ref>።</char></note> <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />ኤሰ ያየና ማላካታ ካአበሮ ካሌይ ኤርግቻትነ፥ “ካንጂንክ ላጋ ካኤፍራጢሲ ኦሽያሜሬን ኤርግቻል አፋር ፉር!” አንተ። <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />ህታ ሳቲዉና ህታ አርዉን፥ ህታ ድግንዉና ሂካ ጌሱን ኦኤካተራን ኤርግቻል አፋሮ ሳኒ ታእባዶ ገነ ሰድኮ ገነ ቶ ጎጎላጋድራኑን ፉራሜን። <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />ካፋራዴል ዎታዳራልኮክ ሞጋን ላማ ቦሌ ሚሎን ላኖ አን ማለ። <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />ፋራዴልና ፋራዲ ጉት ካሀማጼሮ እባዶ ራጋይ ካኮዴራ ሂካማሌየ፤ ጌግዮትሶይ ካግረ ካጀረነ ላላ ካኤሌኔ ቦላል ኣን ሄላክ፥ ካካባጃመ ኤኤሞ ጋምባላክ ዳሩር ኣን ካላሮ፥ ላጫ አንና ሄኣክየ፤ ኡሱ ፋራዴልኮክ መተ ካሉባን መተ ኣን ላረ፤ ህኢትሶኮ ኤለን ኢይና ላጫ ብያረ፤ <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />እሶ ህኢትሶኮ ታቤሰራን ኤለን፥ ኢይና ላጫ ህታ ኤንገ ሴዲ ሳኒ ታእባዶኮ ገነ ታሴድ ጎተ። <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />ኡሱ ፋራዴልኮክ ሁና ህኢትሶይና ደበትሶይ ግረ፤ ደበትሶና ሀበሳ ኣን ላቴ፤ ካሀበሳ መተ አባናየን፤ እባዶና ካኮሚራራን ኡሱያ፤<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />ህታ ኤንጌ ጎይኮ ታሄሰታ ሳኒ ታእባዶ ገነትሶኮኒዕ ፈሎኮ አባባቴንጉረን ጩቦኮ ጉላ ላኮጋሌን፤ ዱርሳና ዎርቂኮ፥ ብርኮ፥ ናስኮ፥ ኤኤሞኮና ጋኮ ካፈላመሮ ድያኖ ጎርቱን ማላኖ ጎርቱን ሰሴይን ካዳንዴኖን ቶልቻ ሄዶይሳታኖ ላኮኢሴን።<note caller="-" style="x"><char style="xo" closed="false">9፡20 </char><char style="xt" closed="false"><ref loc="PSA 115:4-7">ማዛ. 115፡4-7</ref>፤ <ref loc="PSA 135:15-17">135፡15-17</ref>፤ <ref loc="DAN 5:23">ዳኔ. 5፡23</ref>።</char></note> <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />ኡሱማለና እሶ ኔፎ ላጋዳናኮ፥ ሞራኖክሶኮ፥ ሻርሙጣኖኮ፥ ሄታታኖኮ፥ ሂካ ጩቦኮ ጉላ ላኮጋሌን።<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s1">ኤርግቻትና ክጫርክ ካዱባመ ካጋልባ ማጻፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />ሂካኮ አባባተረ ዱማንቻ ካሳርሳተራ ካካለ ካአቲ ኤርግቻት ዳሩርኮ ዳጋ ግራን አን ዴ፤ መተኬሳኮ ጉንተ ጀሬን ካኢዳሞ ግረ፤ በቤድቴሳ አርት ኣን፥ ሉቃኦቴሳ ቱኩል አልተ ታቤባቶ ኤለን አንዬን፤ <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />ካባናመሮ ክጫርክ ካጋልባ ማጻፋ ገነቴሳይ አባተ ግረ፤ ሉክ ታመርገ በከ ጉት፥ ሉክ ታበተ ባጋ ካተ፤ <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />ካሀርቃሮ ሉባንኮት ያየ ኣንትት ታአቲ ያዬ ኦኬ፤ ካኮኦካረ ጎራታ ድዲዴና ቶዶባ ያየትሶ ማልስሰ። <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />ህታ ቶዶባ ታድድዴና ያየትሶ ካኮማልስሳሬን ጎራታ አን ጻፊን ቆፓየ፤ አየሱን ጎአመን “ድድዴናል ቶዶባ ካአዬሰራን ጎልሳ ዎዳና አባ ኳሬ አሮጻፍተ!” ታአማቶ ያየ ዳሩርኮ አን ማለ።<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />ሂካኮ አባባተረ በከ ኦሮና ባጋ አሌ ግራን አን ካዴረ ኤርግቻት ገነ ታመርገ ኤለዴሰ ዳሩር ቶስ ኬሳተጉረ፥ <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮን ካግርናሮ፥ ዳሩርና ዳሩሪ ካግሮ፥ ኡልና ኡሊ ጉት ካግሮ፥ በከና በከ ኦሮ ካግሮ ካመጠሮኮክ መገይ አማተረ ኡሱ ሃ አመ፥ “ሂታኮ ሆረንባን ላኮአዳላይናሮ! <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />አየሱን ጎአመን ካቶዶብ ኤርግቻት ማላካታ ኡፉፈ ካኮማልስሳሮ አርጆሊ ኡሱን ኦሀንዳራን ኦሄገሮሉን ጎጎሰጌሮክ ማለ ሆል ታዋ ፈሎ ሀይስናራ።”<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ብያ. 20፡11</ref>፤ <ref loc="DEU 32:40">አዳ. 32፡40</ref>፤ <ref loc="DAN 12:7">ዳኔ. 12፡7</ref>፤ <ref loc="AMO 3:7">አሞ. 3፡7</ref>።</char></note> <verse eid="REV 10:7" /><verse number="8" style="v" sid="REV 10:8" />ኤሰኮ አባባየረ ሀሴ ዳሩርኮ አን ታማለራ ያየ፥ “በከና ባጋ ካአሌሮ ኤርግቻት ቶስ ሴጉዴ ገነቴሳይ ካግሮና ካባናመሮ ካጋልባ ማጻፋ አት” አማ አደ ኢን አዬሰ።<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />አን ኤርግቻት ቶስ ሴየጉረ፥ “ክጫርክ ካዱባመ ካጋልባ ማጻፋ ኢን ስስ” አመ፤ ኡሱና “ኣትጉደ አም፤ ቦግካይ ካኦኮኮተ ልናራ፤ ህኢታዉን አደ ማላብ ኣን ኦኖሞይናራ” አመ።<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />አንና ክጫርክ ካዱባመሮ ካጋልባ ማጻፋ ታኤርግቻት ገነኮ አታየረ አመ፤ ህኢቴይ ማላብ ኣን ኦኖሞተ፤ አመ ካኮአባባታረ ጎራታ ቦግክ ካኦኮኮተ ሌ።<note caller="-" style="x"><char style="xo" closed="false">10፡10 </char><char style="xt" closed="false"><ref loc="EZR 2:8-33">እዝ. 2፡8-33</ref>።</char></note> <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />ኤሰኮ አደ፥ “ታሞጋን ኡና ማራን፥ ጎሳ ማራን፥ ሄኢ ታሞጋን ካአዬሳሮ እባዶ ማራና ዎኖላል ማራን አድ አት ሄገሮ አዬስን ዶትሳራ” አማመ ኢን ሰጋመ።<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s1">አቶ ላማ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />ሂካኮ አባባተረ ኮኮ ኤካስን ታማዳቶ ዳማ ኣንክክ ፊቀ ኮ ኢን ስሳመ፤ ኢነና ሃ አመ፥ “ክንጉዴ ቁሉክ ምን ካዋና ጃርሶ ታኮስሳራን ባንኤ ህስል ኦይ፤ ኤሴና ዋ ኦሄዶይሳታራን ቶቲ፤<note caller="-" style="x"><char style="xo" closed="false">11፡1 </char><char style="xt" closed="false"><ref loc="ZEC 2:1-2">ዛኪ. 2፡1-2</ref>።</char></note> <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />ቁሉክ ምን ካዋኮ ሳሬ ታግቶ ሀላልት ባንኤ ጎአመን እስ፤ ሀሴ አይዛብን ታስሳንተቶ ማንኮሌተ ማራን ህስሊ አሮኦይተ፤ አይዛብና ህታ ቁሉት ካታማ ድግኒ አፋርታምኮ ላማን ዳዳር ባሪስናራን፤<note caller="-" style="x"><char style="xo" closed="false">11፡2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">ሉቃ. 21፡24</ref>።</char></note> <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />አቶጃ ላማ ኦት ካሬስሴ ሳርስ ሳርሳይጉሬን ኩማ ኮኔ ላማ ቦለኔ ሎታም አርጆል ሄገሮ ጎጎአየስራዉን አን እሶን ሁና ስስናራ።”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />እሶ ካኡሌ ጎታይ ሆረ ኦአላራን ካኤጀርሳ ጋ ላማና ቦላንሶ ላማያን፤<note caller="-" style="x"><char style="xo" closed="false">11፡4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">ዛኪ. 4፡3</ref>፥<ref loc="ZEC 4:11-14">11-14</ref>።</char></note> <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />ማዮና እሶ ሚሪዕን ጎዶተ ኤለን ህኢትሶኮ ብጉደ ዲናክሶ ጉብናታ፤ እሶ ሚሪዕን ካዶታራ ዱባ ካኮጎይናራ ሂካማሌያ። <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />እሶ ሄገሮ ታኮአዬሳራን ሀኑኡ አርጆሊ ኢዳሞ ጎጎኡባኖንኮ ዳሩር ጩፍን እሶ ኦዶናት አባን፤ ኡሱማሌ በከና ኢግ ቶስ ኢግልሲና ካኮዶታቴን ጎራታ ዱባይ ማምስት ኤንገና ኡሊ ጉት ኬኒን ኦዶናት አባን።<note caller="-" style="x"><char style="xo" closed="false">11፡6 </char><char style="xt" closed="false"><ref loc="EXO 7:17-19">ብያ. 7፡17-19</ref>፤ <ref loc="1SA 4:8">1 ሳሜ. 4፡8</ref>።</char></note><verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />አቶታኖክሶ ጉድሴን ካኮአባባታሬን ጎራታ ቦላክ ጉምቢኮ ካበያራ ሱላለት እሶነ ዎታ ጀሬን ሻፋይጉረ እሶ አዎድናራ፤ ላጋድናራ፤<note caller="-" style="x"><char style="xo" closed="false">11፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔ. 7፡7</ref>፥<ref loc="DAN 7:21">21</ref>፤ <ref loc="REV 13:5-7">ራጋ 13፡5-7</ref>፤ <ref loc="REV 17:8">17፡8</ref>።</char></note> <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />ሬስክሶ ማሱሳኮት ኡምቱን ሶዶም ጎርቱን ግብጽ ታአማማቶ ታአቲ ካታማኮት አጋሪይ ሁዱርናራ፤ ህት ካታማ ጎታክሶ ታኮሱዋመረታ።<note caller="-" style="x"><char style="xo" closed="false">11፡8 </char><char style="xt" closed="false"><ref loc="ISA 1:9-10">ኢሳ. 1፡9-10</ref>።</char></note> <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />ካለካለት ኡናና ኣኒ ካለካለት ሄኢ ካአዬሳራ እባዶና ጎሳ አሪ ሴንዳ ምናና ሬስክሶ ድናራን፤ ሬስክሶና ጎጎቃማላሞንኮ ትርናራን። <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />ሂኒዕ ኦሄገሮል ላማ ኡሊ ካግሮ እባዶ ዱባ ማንኮጫናቅሰረን ማራን ኡሊ ካግራ እባዶ ሂካ ሄገሮልኮክ ጎይን ገጌላይናራን፤ ካገጌሎ ባላና ካባጃይናራን፤ እላቦና እስእስኦሮ ስሳይናራን። <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />አየሱን ጎአመን ህት አሪ ሴንዳ ምናና ካኮሮራተ ጎራታ ግር ታስሳታ ኔፎ ዋኮ ኤመተዴ ሬስጆሊ ታብተ፤ ሉቃኦትሶይ አሌን፤ እሶ ካዴራ እባዶና ኣሎ አብሳተ።<note caller="-" style="x"><char style="xo" closed="false">11፡11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">ሕዝ. 37፡10</ref>።</char></note> <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />ሂታኮ አባባቴንጉረን ኦሄገሮል ላማ፥ “ሂታራ ኤልዳ ኮዬን!” ታአማቶ ታአቲ ያየ ዳሩርኮ እሶ ማለን፤ ዲናክሶ እሶ ድያግራን ዱማንቻይ ዳሩር ቶስ ቤን።<note caller="-" style="x"><char style="xo" closed="false">11፡12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 ዎኖ. 2፡11</ref>።</char></note> <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />ጎርሰዋ ሀሴ ሳቲ ኡል ኣኤ፤ ኤሰ ካታማይ ገነ ቶሞንኮ ገነ ቶ ባተ፤ ካአቲ ኡል አአኖኮት ኣላንቲ ኩማ ቶዶባ እባዶ ጎየ፤ ጎይኮ ኦሄሴራን ኣሎ አብሳተን፤ ካዳሩረ ሄዶ ጋላተን።<note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="REV 6:12">ራጋ 6፡12</ref>፤ <ref loc="REV 16:18">16፡18</ref>።</char></note><verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />ታላም ራኮ ሮርተታ፤ አደ ታሴድ ራኮ ሳም ኤመይናታ።<verse eid="REV 11:14" /></para>
  <para style="s1">ማላካታ ካቶዶብ</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />ካቶዶብ ኤርግቻት ማላካታ ኡፉፈ፤ ዳሩርና፥ “ካአላም ዎኖናት ጎታ ሄዶካንክና ካክርስቶሳ ሌራ፤ ኡሱ ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮ ሬድናራ፤” ታአማታ ታአቲ ያየ ማልሳንተ።<note caller="-" style="x"><char style="xo" closed="false">11፡15 </char><char style="xt" closed="false"><ref loc="JHN 15:18">ያን. 15፡18</ref>፤ <ref loc="DAN 2:44">ዳኔ. 2፡44</ref>፤ <ref loc="DAN 7:14">7፡14</ref>፥<ref loc="DAN 7:27">27</ref>።</char></note> <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />ዋይ ሆረ ኮርፍንጀክሶይ ጉት ታሀማጽተታ ጃርሶለ ላማታንኮ አፋሮና በቤዲ ኡል ኦይተደ ዋዉን ሳጋደ፤ <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />ሃና አንተ፥</para>
  <para style="p" vid="REV 11:17">ካግታና ካግቴ፤</para>
  <para style="q2" vid="REV 11:17">“ዱባ ካዳንዳታ ጎታ!</para>
  <para style="q2" vid="REV 11:17">ካንጂንክ ኦዶናትካ ገነታይ ማንኮአባተቶ ማራና፤</para>
  <para style="q2" vid="REV 11:17">ማንኮሬደቶ ማራን ኖ ኩ ጋላታና።<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />አይዛብ ኢኦተራ፤</para>
  <para style="q2" vid="REV 11:18">ኤንገታና ኤሜተታ፤</para>
  <para style="q2" vid="REV 11:18">ካጎየራ ፍርዳ ካኮአታይናራ ጎራታ ጌራ፤</para>
  <para style="q1" vid="REV 11:18">ኩን ካሀንዳሮ ካሄገሮልካዉና</para>
  <para style="q2" vid="REV 11:18">ቁሎሌዉን መገካ ኦካባጃራኑን፤</para>
  <para style="q2" vid="REV 11:18">ክጪጫሩና ካጂንጂኑን፤</para>
  <para style="q1" vid="REV 11:18">ሙራትሶ እሶን ካኮስስናታ ጎራታ ጌራ፤</para>
  <para style="q2" vid="REV 11:18">ኡል ኦባሳራን አት ካኮባስናታ ጎራታ ጌራ።”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />ዳሩሪ ካግራ ቁሉክ ምን ካዋና ባናመ፤ ካአማቶ ታቦታኬሳ ቁሉክ ምን ካዋይ ኦሮ ሙተ። ባንቃኖ፥ ያየ፥ ድዲዴና፥ ኡልኮክ ኣአኖና ታአቲ በለት ሌተ።<note caller="-" style="x"><char style="xo" closed="false">11፡19 </char><char style="xt" closed="false"><ref loc="REV 8:5">ራጋ 8፡5</ref>፤ <ref loc="REV 16:18">16፡18</ref>፥<ref loc="REV 16:21">21</ref>።</char></note><verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s1">ሄለልትቲና ዶቦንሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />ሂካኮ አባባተረ ካጂንክና ካሳድስራ ማላታ ዳሩሪ ሙተ፤ አርት ታሳርሳተታ፥ ድግኒ ሉቃኦትሴኮ ሄገሌ ታካተታ፥ ቶሞንኮ ላማ ባራጃል መተክሴይ ጉት ካላቻ ኣን ታካተታ ሄለልትቲ ቶ ሙተ። <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />ኤሰና ፋቶነ ግቴ፤ ኡሙልን ኡሙላይ አባንተደ ጫናቃማ እያ ግቴ፤<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />ኡሱማለና ካካለ ማላታ ዳሩሪ ሙተ፤ መተ ቶዶባና ማሻ ቶሞን ካአባናየ ካንጂንክ ሄላክ ዶቦስ ሙተ፤ መተኬሳ ጉት ካላቻ ቶዶባ ካመ ግረ።<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔ. 7፡7</ref>።</char></note> <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />ደበቴሳይ ባራጃ ገነ ሰድኮ ገነ ቶ ዳሩርኮ ናቴ ኡል ሉጉደ፤ ዶቦንሳ ሄለልትቲ ካኮኡሙልተ ጎራታ ዪትትክሴ ኤነግን ሄደረ ኡሙልን ታጋባላንተቶ ሄለልትቲ ሆረ አሌ።<note caller="-" style="x"><char style="xo" closed="false">12፡4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">ዳኔ. 8፡10</ref>።</char></note> <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />ሄለልትቲና ጎሳ ዱባ ሁና ካባሪስሮ ባባርትት ኡሙልተ፤ ኡኑክሰ ጎአመን ዋ ቶንሳ ኮርፍንጀ ቶስ አታመ፤<note caller="-" style="x"><char style="xo" closed="false">12፡5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">ኢሳ. 66፡7</ref>፤ <ref loc="PSA 2:9">ማዛ. 2፡9</ref>።</char></note> <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />ሄለልትቲና ባቃተ ቃሉላቶክ ኡል ቤተ፤ ኤሰ ኩማ ኮኔ ላማ ቦለኔ ሎታም አሪ ኮኮባም አባምደ ታኮሀማጺቶ ባንኤ ዋ ኤሰን ኤካሰረ።<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />ዳሩሪ ጀሬን ኬ፤ ምካኤልና ኤርግቻልኬሳ ዶቦንሰ ዎታ ጀሬን ሻፋቴን፤ ዶቦንሳ ኤርግቻልና ዎታ አባባተን ጀሬን ሻፋቴን። ኤርግቻልኬሳነ ዎታ ጀሬን ሻፋቴን፤<note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳኔ. 10፡13</ref>፥<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፡1</ref>፤ <ref loc="JUD 1:9">ይሁ. 9</ref>።</char></note> <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />አየሱን ጎአመን ዶቦንሳ ኤርግቻልኬሳ አዎዳሜን፤ ኤሰኮ አባባቴረን ዳሩሪ እሶን ባንኤ ላኮሄላንተ። <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />ካንጂንክ ዶቦንሳ ሄገልዴ ኡል ሻፋመ፤ ኡሱ አላም ዱባ ካሶሶይሳሮ ዱርሳ ጎርቱን ጻላየ አማመ ካኡማማሮ ካጣዎ ሀበሳያ። ኡሱ ሄገልዴ ኡል ቶስ ሻፋመ፤ ኤርግቻልኬሳና ኡሱነ ዎታ ሻፋመን።<note caller="-" style="x"><char style="xo" closed="false">12፡9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">መጣ 3፡1</ref>፤ <ref loc="LUK 10:18">ሉቃ. 10፡18</ref>።</char></note><verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />ሂካኮ አባባየረ ታአቲ ያየ ቶ ዳሩሪ ሃ አማ ግራን አን ማለ፥ “ሂክማ ፋይና፥ ሁናና፥ ዎኖናት ሄዶካንዉን ሌራ! ኦዶናትና ካክርስቶሳ ሌራ! ኣላንቲና አቢላልታን አሪና ሄመን ሄዶካን ሆረ ሞታ ካግረ ሻፋመራ፤<note caller="-" style="x"><char style="xo" closed="false">12፡10 </char><char style="xt" closed="false"><ref loc="JOB 1:9-11">ኢዮ. 1፡9-11</ref>፤ <ref loc="ZEC 3:1">ዛኪ. 3፡1</ref>።</char></note> <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />እሶና ካኢዳዶ ኢግና ካአቶቴራን ካአቶ ሃፉራ አዎዴራን፤ ኔፎትሶዉና ሀማራሮን እስኦትሶ ጎይን ሮርሳይ ስሳይን ኤካሳቴን፤ <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />ሃንሱን ዳሩርጆልና ኤሰ ኦሮ ኦግታን ዱባ ገጌላየን! አሪ ኡጫር ታላል ሄሳኖ ዱርሳ ማንኮካሶ ማራን ታአቲ ኤንጌ እስን ቶስ ዳገራ፤ ኡልና በከና ኣኔ እስኑን!”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />ዶቦስ ሄገልዴ ኡሊ ሻፋማኖ ካኮአዴሳታረ ጎራታ ባባርትት ታኡሙልተቶ ሄለልትቲ ዴጉረ ሆሮረ፤ <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />ሄለልትቲ ቃሉላቶክ ኡሊ ታኤካተቶ ባንኤ ቶስ ቡባ ጎጎሴቶ ኦአቲ ኦላቦባ ባላሎ ኣን ኦላራን ባላሎ ላማ ኤሰን ስሳሜን፤ ኤሰ ሀበሳኮ ፋክ አንተጉደ ጌስ ሴንዳ ምናና ኮኮባም ጎጎኦራንቶንያ።<note caller="-" style="x"><char style="xo" closed="false">12፡14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">ዳኔ. 7፡25</ref>፤ <ref loc="DAN 12:7">12፡7</ref>።</char></note> <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />በከ ኦላጋ ሄለልትቲ አት ጎጎዳግራዉን አመረ ሀበሳ በከ ኦላጋ ግታኒዕ በከ ህኢቴሳኮ ሄለልትቲኮ ሃር ሀይሰረ ኡበ። <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />አየሱን ጎአመን ኤሬ ሄለልትቲ ጋርጋርተ፤ ኤሬና ባናንተጉደ ዶቦስ ህኢቴሳኮ ኦኡበረ በከ ጣንተ <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />ዶቦንሳ ሄለልትቲ ጉት አማራተጉረ ታሄሰቶ ሳኒትሴነ ዎታ ጀሬን ሻፋይን ሴተ፤ እሶና አጃጃ ካዋ ኦኦራታሬና የሱሳን አብዳሜን ኦአቶታራንያን። <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />ዶቦንሳ ላቡ ግርዲ ጬካሌ ጉት አሌ።<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s1">ሱላለጃ ላማ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />ሂካኮ አባባየረ አን ሱላለት ኮ በከ ኦሮኮ ብያ ግራን ዴ፤ ማሻ ቶሞና መተ ቶዶባ አባናየ፤ ማሻ ጉት ካላቻ ቶሞኖ ግረ፤ መተ ቶዶባ ጉት ካሀባር መገ ግረ።<note caller="-" style="x"><char style="xo" closed="false">13፡1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">ዳኔ. 7፡3</ref>።</char></note> <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />አን ካዴራ ሱላለት ኬቤል ኣን ካላረየ፤ ሉቃኦቴሳ ድብ ካአማማሮ ሱላለት አኒዕዬን፥ ህኢቴሳና ታሉባን ህኢ ኣን ላቴ። ዶቦንሳ ሁናኬሳና ኮርፍንጀኬሳ ካንጂንክ ኦዶናትኬሳ ሱላለቲን ስሰ።<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="DAN 7:4-6">ዳኔ. 7፡4-6</ref>።</char></note> <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />ኡሱ ሱላለትኮክ መተኮ ኮ ጎይን ታጌግሳቶ ሜጋ ካአቦ ኣን ካሌሮ ዴ፤ አየሱን ጎአመን ጎይን ታጌግሳታ ሜጋ ፋይተታ፤ አላም ካግራ እባዶ ዱባ ሳዳ ኡሱ ሱላለት ዴበ ሰሴተ። <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />ሱላለቲን ኦዶናት ማንኮስሳመ ማራን እባዶ ዱባ ዶቦሱን ሳጋደ፤ “ሱላለት ኣን ካላራ አዮያ? ኡሱነ ዎታ ጀሬን ሻፋይን ካዳንዴራ አዮያ?” አማ ሱላለቲን ሳጋደን።<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />ጮራ ታኮአዬስራና ታኮሀባራ ህኢ ሱላለቲን ስሳንተ፤ ድግኒ አፋርታምኮ ላማ ኦዶናትኬሳይ ጎጎፈሎን ፈኢ ኡሱን ስሳንተ። <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />ዋና መገ ካዋ፥ ምንኬሳና ዳሩሪ ኦግራን ሀባራኖ ሀጋአበን።<note caller="-" style="x"><char style="xo" closed="false">13፡6 </char><char style="xt" closed="false"><ref loc="DAN 7:8">ዳኔ. 7፡8</ref>፥<ref loc="DAN 7:25">25</ref>፤ <ref loc="DAN 11:36">11፡36</ref>።</char></note> <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />ቁሎሌነ ዎታ ጀሬን ጎጎሻፋሮና እሶ ጎጎአዎድሮን ኦዶናት ኡሱን ስሳመ። ኣኒና ኡናይ፥ ካለካለት ሄኢ ካአዬሳሮና ጎሳ ዱባ ጉት ኦዶናት ስሳመ።<note caller="-" style="x"><char style="xo" closed="false">13፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">ዳኔ. 7፡21</ref>።</char></note> <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />አላም ታኮመጣመሮኮ ሀጋአበረ መገክሶ ኮከ ካጎሳመሮ ኢዳዶኮክ ካግር ማጻፋይ አንጻፋሞን ካግራ ካአላም እባዶ ዱባ ሱላለቲን ሳጋደ።<note caller="-" style="x"><char style="xo" closed="false">13፡8 </char><char style="xt" closed="false"><ref loc="PSA 69:28">ማዛ. 69፡28</ref>።</char></note><verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />ነበ ካአባ ጎግረ ሀማሎ! <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />“ቦጃሚን ካኤካተራ ቦጃምናራ፤ ሺፋይ ጎይን ካኤካተራ ሺፋይ ጎይናራ፤” ጎርታ ታቁሎሌ ኦብሲና አማኖ ካኮዶትሳራ ጎራታ ሂካያ።<note caller="-" style="x"><char style="xo" closed="false">13፡10 </char><char style="xt" closed="false"><ref loc="JER 15:2">ኤር. 15፡2</ref>፤ <ref loc="JER 43:11">43፡11</ref>።</char></note><verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />ካካለ ሱላለት አደ ኡልኮ ብያ ግራን አን ዴ፤ እዳድ ኣን ማሻ ላማ አባናየ፤ አዬስኬሳና ካዶቦስ አየስ አንየ፤ <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />ካሆሬ ሱላለትኮክ ኦዶናት ዱባ አታተረ ኡሱ ሆረ ኦዶናት ፈላ ግረ፤ ኡልና ኡሊ ጉት ካግራ ዱባ ካሆሬ ሱላለቲን ጎጎሳጋድሮ የልስሰ፤ ሂክ ሱላለትና ሀሴ ጎይ ታጌግሳታ ሜጋ ካኮፋይተቶ ካሆሬ ሱላለትያ። <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />ሂክ ካላም ሱላለት እባዶ ሆረ ኤለን ዳሩርኮ ታዳግስሮ ጊን ካጂንጂን ባሳ ፈላ ግረ። <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />ካሆራርጄ ሱላለት ሆረ ባሳ ጎጎፈሎን ፈኢ ታኮስሳንተቶ ኣላንቲ ኡል ካግሮ እባዶ ሶሶይሳ ግረ፤ ሺፋይ ሜጋተረ ካፋዬሮ ታሱላለትኮት ካባጃን ምስሊ ጎጎፈላዉን ኡሊ ጉት ካግሮ እባዶ አጃጃራ። <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />ካላምክ ሱላለት ካሆሬ ሱላለትኮት ምስሊ ኔፎ ስስን ኦዶናት ስሳመ፤ ኔፎ ስስን ኦዶናት ካኮስሳመራና ህት ምስሊ አዬስን ጎጎዳንዴቶና ካሆሬ ሱላለትኮት ምስሊዉን ካሳጋዶን ዱባ ጎጎ ጎሮን የልንያ። <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />ካላምክ ሱላለት ክጭጫርና ሌረ ካጅንጂን፥ ዱሬሳልና ሌረ ህየሳል፥ ጎቶሌና ሌረ ድይል፥ ዱባ ታመርገ ገነትሶይ ጎርቱን በቤድትሶ ጉት ማላታ ጎጎካናዉን ሁኖመ። <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />ሂካማሌ ካሱላለቲ መገ ካቱሳራ ማላታ ጎርቱን መገኬሳኮኒዕ ቶቶ ካላይክ ማምስክ እባዶትና ኮኮ ኢምናዪና ሌረ ዳዳላይን ላኮዳንዳሮ።<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />ጎርታ ቃሩማ ካኮን ዶታማታ ሂካኒ ጉቲያ፤ ሳሙ ካአባ ቶቶ ኦሱላለቲ ሀቶቴ፤ ሂኒዕ ቶቶና ካቱሳራን እባዶያ፤ ቶቶና 666።<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s1">እዳዶና እባዶ 144,000</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />ሂካኮ አባባተረ አን ታጽዮን ዎዳሚ ጉት ካአሌሮ ኢዳዶ ዴ፤ ኡሱነ ዎታ መገኬሳና ኣቦኬሳኮክ መገ በቤድትሶይ ጉት ካጻፋመራ እባዶ 144,000የ።<note caller="-" style="x"><char style="xo" closed="false">14፡1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፡4</ref>፤ <ref loc="REV 7:3">ራጋ 7፡3</ref>።</char></note> <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />ዳሩርኮና ታአቲ ያዬ ካዳጋሮ ማዳኮት ያየና ካአቲ ድዲዴና ኣንትት ታአቲ ያየ አን ማለ፤ አን ታማለራ ያየና ክራን ካባሳራ ክራን ባሳ ታማልስሳሮ ያየ ኣን ላቴ። <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />ኮርፍንጄይና ኔፎ ታአብታ መጣ አፋሮ፥ ጃርሶለይ ሆረ እባዶ 144,000 ካኡሱብ ማዛሙር ዛማሬን፤ ሂካ ማዛሙር ኡልኮ ኦዎዶዋመራን እባዶ 144,000 ኳሬ ማዮና አጋልሳይን ላኮዳንዴ። <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />እሶ ሙመኒዕ ማንኮሌራን ማራን ሄለልኔ ዎታ ሁዱራኖይ ላኮባቶየራን፤ ኢዳዶት ማንኮሴታሮ ዱባ ዴበ ሰሴታራን። እሶ ዋዉና ኢዳዶን እባዶ ዱባ ኦሮኮ ሆራ ኣን ሌን ኦስሳሜራንያን። <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />እሶ ጣራ አዬሴን ላኮካሳን፤ ቱፍ ካላይኒዕያን።<verse eid="REV 14:5" /></para>
  <para style="s1">ኤርግቻል ሴዶ ካአዬሰሮ አየስ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />ሂካኮ አባባተረ ኡሊ ካግሮ ጎሳን፥ ኣኒዉን፥ ካለካለት ሄኢ ካአዬሳሮና ኡና ዱባን ላላብን ጅሩ ጅሮማክ ዎንጋላ ካአበራ ካካለ ኤርግቻት ዳሩሪ ቡባ ግራን አን ዴ፤ <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />ታአቲ ያዬ “ዋ አብሳዬን! ኡሱ ካባጃ! ታፍርዳ ሳቲቴሳ ጌተታ፤ ኡልና ዳሩርና፥ በከና በከኮክ ፉልቶ ካመጠሮ ሄዶን ሳጋዳ!” አመ።<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />ካካለ ካላም ኤርግቻት “ካሻርሙጡማ ኤንገኮክ ካዎይኒ ጣሞክሴ ጎሳ ዱባ ታጣምሰታ ታንጂንት ባብሎን ኢተታ! ኢተታ” አማ ካሆሬ ኤርግቻት ዴበ ሰሴተ።<note caller="-" style="x"><char style="xo" closed="false">14፡8 </char><char style="xt" closed="false"><ref loc="ISA 21:9">ኢሳ. 21፡9</ref>፤ <ref loc="JER 51:8">ኤር. 51፡8</ref>፤ <ref loc="REV 18:2">ራጋ 18፡2</ref>።</char></note><verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />ካካለ ካሴድ ኤርግቻት ያየ ጦቂሰረ ሃ አማ እሶ ዴበ ሰሴተ፤ “ሱላለይና ምስሊ ኦሳጋዳራን፥ ማላታ በቤድትሶይ ጎርቱን ገነትሶይ ኦካታራን ዱባ፥ <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />ኤንገ ታዋኮክ ካዎይኒ ጣሞ ጣማራን፤ ሂክ ካዎይኒ ጣሞ አንለለዳሞን ግራን ታኤንጌ ጡጋይ ካሁሙሳመሮያ፤ ኡሱማለና ቁሉክ ኤርግቻ ሆረና ኢዳዶ ሆረ ኤሌኒና ቦላል አቦሳምናራን።<note caller="-" style="x"><char style="xo" closed="false">14፡10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51፡17</ref>፤ <ref loc="GEN 19:24">መጣ 19፡24</ref>፤ <ref loc="EZK 38:22">ሕዝ. 38፡22</ref>።</char></note> <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />እሶ ታአቦስሳቶ ኤሌንኮ ካበያራ ኢይ ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮ ኤልዴ ብያራ፤ ሱላለቲና ምስሊቴሳዉን ኦሳጋዳራን መገኬሳኮክ ማላታ ኦካተራን ዱባ አሪና ሄመን ፎልሲ ላኮአባን።”<note caller="-" style="x"><char style="xo" closed="false">14፡11 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ. 34፡10</ref>።</char></note><verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />አጃጃ ካዋ ኦኦራታራንኮና የሱሳ አማናኖይ ኦአታታራን ቁሎሌኮ ታኦራማታ ኦብስ ሂካኒያ።<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />ዳሩርና ሃ ታአማቶ ያየ አን ማለ፤ ሂካ ጻፍ፤ “ሂታኮ ሆረንባን ኦጎታ ሌን ኦጎዋራን ኦሶማሳመንያን!” አያና ቁሉክና “እ! እሶ ዳፉርክሶኮ ጎጎፎልሳራዉን ፈሎኦትሶ እሶ ዴበ ሰሴታራን” አማራ።<verse eid="REV 14:13" /></para>
  <para style="s1">ኤንገ ታዋ ኡል ጉት</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />ሂካኮ አባባየረ አን ዱማንቻ ጉማራክ ዴ፤ ዱማንቻ ጉት ኤረ ካእባዶ ኣን ካላራ ሀማጼራ፤ መተኬሳ ጉት ካዎርቂ ካላቻ ካተራ፤ ገነቴሳይ ታኤነናን ባጫ አባተራ፤<note caller="-" style="x"><char style="xo" closed="false">14፡14 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔ. 7፡13</ref>።</char></note> <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />ካካለ ኤርግቻት ቁሉክ ምን ካዋኮ ቤጉረ ዱማንቻ ጉት ካሀማጼሮነ ያየ ጦቂሰረ፥ “ካም ካኮኩኩይሳናን ጎራታ ማንኮጌሮ ማራን ባጫታይ ታካ፤ ካም አንጋገራ አመ ኦኬ።”<note caller="-" style="x"><char style="xo" closed="false">14፡15 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3፡13</ref>።</char></note> <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />ዱማንቻ ጉት ካሀማጼረክና ባጫ ሄገልዴሰ ኡል ቶስ ሉጉደ፤ ኡሊ ካግራ ካምና ታጋመ።<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />ካካለ ኤርግቻትና ዳሩሪ ካግሮ ቁሉክ ምን ካዋኮ ቤ፤ ኡሱና ታኤነናን ባጫ አባተ ግረ።<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />ኤለኒ ጉት ኦዶናት ካአባ ካካለ ኤርግቻት ታጃርሶ ባንኤኮ ቤጉረ ታኤነናን ባጫ ካአበሮ ኤርግቻትን፥ “ታዎይኒ ኢል ዱፉር ማንኮዱባንተቶ ማራን ታኤነናን ባጫታ ፋር፤ ታዎይኒ ኢል ዱባ ኡልኮ ጎስደ ኩኩይስ!” አማ ያየ ጦቂሰረ ኦኬ። <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />ኤርግቻትና ባጫ ሄገልዴሰ ኡል ሉጉደ፤ ታኡሌ ዎይንኮት ኢል ጎሰ፤ ታአቲ ኤንገ ታዋኮት ዎይኒ ታኮሚጫማቶ ባንኤ ቶስ ኦሮዴሰ ሉጉደ። <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />ካታማኮ ሳሬ ታግታ ዎይኒ ታኮሚጫራን ባንኤ ሚጫንተ፤ ዎይኒ ታኮሚጫራንኮ ብጣላ ካፋራዴ ታ ጌሮ ኤለ ጦቂ ካአመና ኤርና ሴድ ቦሌ ክሎ መትራ ካጌራ ኢግ ቤ ኡባተ።<note caller="-" style="x"><char style="xo" closed="false">14፡20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">ኢሳ. 63፡3</ref>፤ <ref loc="LAM 1:15">ራክ. 1፡15</ref>፤ <ref loc="REV 19:15">ራጋ 19፡15</ref>።</char></note><verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s1">ታጋቾ ኤንገ ካአበሮ ኤርግቻ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />ካካለ ካአቲና ካሳዳምሮ ማላታ ዳሩሪ አን ዴ፤ ኤንገ ታዋ ፈሎይ ካኮሃታ ታጋቾ ታሌተቶ ኤንገ ቶዶባ ካአበሮ ኤርግቻል ቶዶባ አን ዴ።<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />ሂካኮ አባባየረ ኤለን ታኮለለዳንተቶ ማስቶቲ ኣን ኦላራን በከ ኣንክክ ማመ አን ዴ፤ ኡሱማለና ሱላለትና ሱላለትኮት ምስሊ፥ መገኬሳኮኒዕ ቶቶና ማላታ ካአዎዴሮ እባዶ ኣን ዴ፤ እሶና ዋ ካስሰሮ ክራን አቤንጉረን ማስቶቲ ኣን ኦላራን በከ ዶሌ አሌን ግረን። <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />ዋዉን ካሀንዳረ ካሙሴ ማዛሙርና ካኢዳዶ ማዛሙር ሃ አማ ዛማራ ግረን፥</para>
  <para style="q1" vid="REV 15:3">“ዱባ ካዳንዳታ ጎታ ሄዶ!</para>
  <para style="q2" vid="REV 15:3">ፈሎኦታ ኦአቲና ኦሳዳምራንያን፤</para>
  <para style="q1" vid="REV 15:3">ካጎሳ ዎኖ!</para>
  <para style="q2" vid="REV 15:3">ራካና ቱኩልክና ካሩምያ፤<note caller="+" style="f"><char style="fr" closed="false">15፡3 </char><char style="fqa" closed="false">ካጎሳ ዎኖ </char><char style="ft" closed="false">ኮኮ ማጻፋጆል “ካጌስጆል ዎኖ” አማራ። </char></note><note caller="-" style="x"><char style="xo" closed="false">15፡3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">ብያ. 15፡1</ref>።</char></note><verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />ጎታ! ኩ ካአብሳኖና</para>
  <para style="q2" vid="REV 15:4">መገካ ካካባጂኖን አዮያ?</para>
  <para style="q2" vid="REV 15:4">አት ካላል ቁሉክታ፤</para>
  <para style="q1" vid="REV 15:4">ካሩም ፍርዳካ ማንኮሙተሮ ማራን</para>
  <para style="q2" vid="REV 15:4">ጎሳ ዱባ ኤመይረ ኩ ሆረ ሳጋድናራ።”<note caller="-" style="x"><char style="xo" closed="false">15፡4 </char><char style="xt" closed="false"><ref loc="JER 10:7">ኤር. 10፡7</ref>፤ <ref loc="PSA 86:9">ማዛ. 86፡9</ref>።</char></note><verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />ሂካኮ አባባየረ ታአቶ ዳሰ ካኮግቶ ቁሉክ ምን ካዋ ዳሩሪ ባናመ ግራን አን ዴ፤<note caller="-" style="x"><char style="xo" closed="false">15፡5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">ብያ. 38፡21</ref>።</char></note> <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />ኤንገ ቶዶባ ካአበራ ኤርግቻል ቶዶባ ቁሉክ ምን ካዋኮ ቤን፤ ሙጭ ካአመ ካሀንቃሮ ጉማራክ ሳርስ ሳርሳቴን ግረን፤ ጌግዮትሶይና ካዎርቂ ሞዋኖ ሞዋቴን ግረን። <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />ኔፎ ታአብቶ መጣ አፋርኮ ኮ ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮን ካግርናሮ ዋኮት ኤንገ ካኮአማጋንተቶ ቶዶባ ታዎርቂ ጡጋል እሶን ስሰ። <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />ቁሉክ ምን ካዋና ካባጃ ታዋኮና ሁናኮ ካከይ ኢዪ አማጋመ፤ ኤርግቻል ቶዶባ ታአበራ ኤንገ ቶዶባ ታጉዳቶ ማዮና ቁሉክ ምን ካዋ ኦሮድ ታብን ላኮዳንዴ።<note caller="-" style="x"><char style="xo" closed="false">15፡8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">ብያ. 40፡34</ref>፤ <ref loc="1KI 8:10-11">1 ዎኖ. 8፡10-11</ref>፤ <ref loc="2KI 5:13-14">2 ዎኖ. 5፡13-14</ref>፤ <ref loc="ISA 6:4">ኢሳ. 6፡4</ref>።</char></note><verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s1">ኤንገ ታዋ ካአበሮ ጡጋል ቶዶባ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />ሂካኮ አባባየረ ኤርግቻል ቶዶባነ፥ “ሴዬን! ኤንገ ታዋ ካአበሮ ጡጋል ቶዶባ ኡሊ ኡባ!” ታአማታ ጦቂ ታአንተ ያየ ቁሉክ ምን ካዋኮ ብያ ግራን አን ማለ።<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />ካሆሬ ኤርግቻት ሴተጉረ ጡጋ ኡሊ ኡበ፤ ካሱላለቲ ማላታ ካአቦዉና ታሱላለት ምስሊ ካሳጋዳሮ እባዶ ጉት ታሜላና ታአቦስሳ ሜጋ ቤተ።<note caller="-" style="x"><char style="xo" closed="false">16፡2 </char><char style="xt" closed="false"><ref loc="EXO 9:10">ብያ. 9፡10</ref>።</char></note><verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />ካላምክ ኤርግቻት ጡጋ በከ ኦሮ ኡበ፤ በከና ካጎየ እባዶኮክ ኢግ ኣን ሌን፤ በከ ኦሮ ካግራ ኔፎ ካአባ ዱባ ጎየ።<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />ካሴድ ኤርግቻት ጡጋ ላጋይና ፉልቶል ጉት ኡበ፤ እሶና ኢግ ሌን፤ <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />በከ ጉት ኦዶናት ካአባ ኤርግቻት ሃ አማ ግራን አን ማለ፤ “ካግቴና ካግታ ቁሉክ ጎታ! ሂካማሌ አት ማንኮፍርዲተቶ ማራን አት ጋራታ፤ <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />እባዶ ቁሎሌኮክና ካሄገሮልኮክ ኢግ ማንኮኡበሮ ማራን አት እሶ ኢግ ጣምሰ፤ ህክና እሶን ካዶትሳሮያ፤” <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />ታጃርሶ ባንኤይ፥ “እ! ዱባ ካዳንዳታ አት ጎታ ሄዶ! ፍርዳካ ሩምና ልክኪያ” ታአማቶ ያየ አን ማለ።<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />ካአፋር ኤርግቻት ጡጋ አርት ጉት ኡበ፤ አሪትና እባዶ ጎጎጉብቶን ሁና ኤሰን ስሳመ። <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />እባዶና ካአቲ ዎባና ካአሪቲ ጉባተ፤ ህታ ኤንገ ጉት ኦዶናት ካአባ መገ ካዋ ሀባራመ፤ ጩቦኮ ጉላ ላኮጋሌን፤ ዋና ላኮካባጄን።<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />ካከን ኤርግቻት ጡጋ ኮርፍንጀ ካሱላለቲ ጉት ኡበ፤ ዎኖናት ካሱላለትና ሙጉድ ሌ፤ እባዶ አቦሳኮ ካከይ ሙንጀ ፎጫ ግረ። <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />ሀዉኣም ክሶኮና ሜጋትሶኮ ካከይ ካዳሩረ ሄዶ ቃንጌን፤ ፈሎ ኦትሶኮና ጉላ ላኮጋሌን።<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />ካሌይ ኤርግቻት ጡጋ ካኤፍራጢስ ካአቲ ላጋ ኦሮ ኡበ፤ ምና ታብያንኮ ካኤሜታሮ ዎኖላሉን ራ ኤካስን በከ ኦላጋ አንጋጌን። <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />ታሱላለት ህኢኮና ታዶቦሴ ህኢኮ፥ ካጣራ ካሄገሮኮት ህኢኮ ጎጎ ኣን ካላራ ባቲክ አያና ሴዶ ብያግራን አን ዴ፤ <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />እሶ ባሳ ኦፈላራን ካዱርሳ ባቲክ አያናያን፤ ሂክ ባቲክ አያና ዱባ ካዳንዳሮ ሄዶኮት ታአቲ አሪ ካክናሮ ጀሬኑን እባዶ ኩኩይስን አላምኮክ ዎኖላል ዱባ ቶስ ሴይናራን።<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />“አን ሄቶ ኣን ደራኣ ኤመይናራ! ሀዉአይ ጎጎሌኖንኮና ሙላኬሳ እባዶ ጎጎዴኖንኮ አዴሰረ ሳርስ ካኦራታራ እባዶ ካሶማሳመያ!”<note caller="-" style="x"><char style="xo" closed="false">16፡15 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ. 24፡43-44</ref>፤ <ref loc="LUK 12:30-40">ሉቃ. 12፡30-40</ref>፤ <ref loc="REV 3:3">ራጋ 3፡3</ref>።</char></note><verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />ባቲክ አያናና ዎኖላል ሄኢ ታኢብራይስጢ አርማገዶን ታአማማቶ ባንኤ ኩኩይሰ።<note caller="-" style="x"><char style="xo" closed="false">16፡16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2 ዎኖ. 23፡29</ref>፤ <ref loc="ZEC 12:11">ዛኪ. 12፡11</ref>።</char></note><verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />ካቶዶብ ኤርግቻት ጡጋ አምባል ጉት ዳረኤ፤ ቁሉክ ምን ካዋ ኦሮ ካግሮ ኮርፍንጀኮ “ጉዳተዋ!” ታአማታ ታአቲ ያየ ቤተ። <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />ባንቃኖ፥ ያየ፥ ድዲዴና ካአቲ ኡልኮክ አኣኖ ሌ፤ ሂካ ኣንክክ ካአቲ ኡልኮክ አኣኖ እባዶ ሂካ ኡል ጉት አሮመጣመኮ ሀጋአበረ ሂካማሌ ሌ ላካሶ።<note caller="-" style="x"><char style="xo" closed="false">16፡18 </char><char style="xt" closed="false"><ref loc="REV 8:5">ራጋ 8፡5</ref>፤ <ref loc="REV 11:13">11፡13</ref>፥<ref loc="REV 11:19">19</ref>።</char></note> <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />ታአቲ ካታማ ባንኤ ሴድ ቤተ፤ ካአይዛብ ካታማልና ዲጋመ፤ ዋ ታንጂንት ባብሎን ሻደ፤ ታአቲ ኤንጌ ካዎይኒ ጣሞ ታኮአማጋንተቶ ጡጋ ጎጎጣምራዉን የለ።<note caller="-" style="x"><char style="xo" closed="false">16፡19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51፡17</ref>።</char></note> <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />ኦዶላል ዱባ ቶላዴን ባቃተን፤ ዎዳሚልና ላኮሙተ።<note caller="-" style="x"><char style="xo" closed="false">16፡20 </char><char style="xt" closed="false"><ref loc="REV 6:14">ራጋ 6፡14</ref>።</char></note> <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />መተመተይ አፋርታምኮ ከን ኪሎ ግራም ግታት በለት ዳሩርኮ እባዶ ጉት ኢተ፤ ኤንገ ኣሎ ታአቦስሳቶ ማንኮሌተተ ማራን እባዶ ታበለቲ ኤንገኮት ኣላንቲ ዋ ሀባረ።<note caller="-" style="x"><char style="xo" closed="false">16፡21 </char><char style="xt" closed="false"><ref loc="EXO 9:23">ብያ. 9፡23</ref>፤ <ref loc="REV 11:19">ራጋ 11፡19</ref>።</char></note><verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s1">ሻርሙጡማ ታአዴሳንተቶ ሄለልትቲና ሱላለት</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />ጡጋ ቶዶባ ካአበረ ኤርግቻል ቶዶባኮ ኮ እን ቶስ ኤመተረ ኢነ ሃ አመ፥ “ኮይ! በከ ኦንጂ ጉት ታሀማጺተቶ ሻርሙጡማ ታአዴሳንተቶ ሄለልትቲ ጉት ካግናሮ ፍርዳ አን ኩን ቱስናራ።<note caller="-" style="x"><char style="xo" closed="false">17፡1 </char><char style="xt" closed="false"><ref loc="JER 51:13">ኤር. 51፡13</ref>።</char></note> <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />ካኡሌ ዎኖላል ኤሰነ ዎታ ሻርሙጠራ፤ ካኡሌ እባዶና ሻርሙጣኖኮክ ካዎይኒ ጣሞይ ሰቴራን።”<note caller="-" style="x"><char style="xo" closed="false">17፡2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23፡17</ref>፤ <ref loc="JER 51:7">ኤር. 51፡7</ref>።</char></note><verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />ሂካኮ አባባተረ ኤርግቻት አያናይ እን ቃሉላቶክ ኡል ቶስ ቤሰ፤ ኡሱ ጉት ካሀባር መገ ካኮጻፋመረ መቴል ቶዶባና ማሻ ቶሞን ካአቦ ሄላክ ሱላለት ጉት ታሀማጺተቶ ሄለልትቲ ቶ አን ዴ።<note caller="-" style="x"><char style="xo" closed="false">17፡3 </char><char style="xt" closed="false"><ref loc="REV 13:1">ራጋ 13፡1</ref>።</char></note> <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />ህት ሄለልትቲና ዳማክና ሄላክ ሳርስ ሳርሳተ ግቴ፤ ዎርቂይ፥ ካካባጃመ ኤኤሞና ኢንቁ ካአማማሮ ኢደ ግቴ፤ ገነትሴይ ካሙሊስሮ ኮኮና ሻርሙጣኖኮክ ባትናት ካኮአማጋመሮ ታዎርቂ ጡጋ አባተ ግቴ።<note caller="-" style="x"><char style="xo" closed="false">17፡4 </char><char style="xt" closed="false"><ref loc="JER 51:7">ኤር. 51፡7</ref>።</char></note> <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />በቤድትሴይ ጉት “ሻርሙጣና ካኡሌ ባትጆልኮት አዬ፥ ታንጂንት ባብሎን” ካአማራ ካሆል መገ ጻፋመ ግረ። <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />ሀሴ ሄለልትቲ ቁሎሌኮክ ኢግና የሱሳ ማራን ኦጎየራንኮክ ኢግ ታሰቲተቶ አን ዴ፤ ኤሰ ካኮድያረ ጎራታ አን ኣሎ ሳደ። <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />ኤርግቻት አደ ኢነ ሃ አመ፤ “አት ሙን ሳዳታ?” ታሄሌልትቲ ሆልና ኤሰ ካኮሀማጺተቶ፥ መተ ቶዶባና ማሻ ቶሞን ካአቦ ሱላለትኮት ሆል አን ኩን ሰግናራ። <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />አት ካዴተታ ሱላለት ጣየ ግረዋ፤ ግዳ ላግሮ፤ ሃሬ አድ ቦዋክ ጉምቢኮ ብናራ፤ ባይ ቶንሳ ሴይናራ፤ አላም ታኮመጣመኮ ሀጋአበረ መገክሶ ካኮግረ ማዝጋባይ አንጻፋሞን ካግራ ካኡሌ እባዶ፥ ሱላለትና ጣየ ካግረ፥ ግዳ ካግኖን፥ ሃሬ አድ ካኤሜይናሮ ላኖ ጎዴን ሳድናራን።<note caller="-" style="x"><char style="xo" closed="false">17፡8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔ. 7፡7</ref>፤ <ref loc="REV 11:7">ራጋ 11፡7</ref>፤ <ref loc="PSA 69:28">ማዛ. 69፡28</ref>።</char></note><verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />“ቃሩማ ታአብታ ሳሙ ካኮዶታማታ ሂካኑንያ፤ መቴል ቶዶባ ሄለልትቲ ካኮሀማጺተተ ዎዳሚል ቶዶባዬን፤ <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />ኡሱማለና ዎኖላል ቶዶባዬን፤ ከኖ እዬራን፤ ኮ ግዳ ግሮዋ፤ ካካለ ጋና ኤመይናራ፤ ኡሱ ካኮኤሜተ ጎራታ ክጫር ካላል አዳላይን ዶትሳራ። <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />ካስዴድ ዎኖ ጣየ ካግረና ግዳ ካዋታመሮ ሱላለትየ፤ ኡሱ ሱላለል ቶዶባኮ ኮየ፤ ባይ ቶስ ሴይናራ።<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />“አት ካዴተታ ማሻል ቶሞኖ ጋና አንሬዶኒ ካግሮ ዎኖላል ቶሞንያ፤ አየሱን ጎአመን ሳቲ ቶ ታላል ሱላለትነ ዎታ ጎጎሬድናዉን ሬዳኖኮክ ኦዶናት ሄላይናራን።<note caller="-" style="x"><char style="xo" closed="false">17፡12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">ዳኔ. 7፡24</ref>።</char></note> <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />ሂኒዕ ዎኖላል ቶሞኖ ቆፋ ቶ አባናየን፤ እሶ ሁናክሶና ኦዶናትክሶ ሱላለቲን ስስናራን፤ <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />እሶ ኢዳዶ ጉት ጀሬን ሻፋይናራን፤ አየሱን ጎአመን ኢዳዶ ካጎቶሌ ጎታና ካዎኖላል ዎኖ ማንኮሌ ማራን ኡሱ እሶ አዎድናራ፤ ኡሱነ ዎታ ኦግራን ኦኡማሜራን፥ ኦአሳባሜራና ኦአብዳመንያን።”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />ኤርግቻትና ኢነ ሃ አመ፤ “ሻርሙጣት ካኮሀማጺተተ አት ኦዴተተ በከጆል፥ ጎሳጆል፥ እባዶ፥ ኡናጆልና ካለካለት ሄኢ ኦአዬሳራንየን፤ <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />ሱላለትና አት ካዴተታ ማሻል ቶሞኖ ሻርሙጣት ዲዳራን፤ ሀላል ሀዉአይ ሀሲናራን፤ ሶኦትሴና አምናራን፤ ኤሰ ኤሌኒና ጉብናራን፤ <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />እሶ ሀልቻክሶ ጎጎፈላናዉን ህታ ቆፋ ዎዳናትሶይ ካካየራ ዋያ፤ ሃንሱን ሃፉራ ካዋ ታ ፈሎ ሀይሮ እሶ ቆፋ ቶይ እስአትናራን፤ ሬዳኖኮክ ኦዶናትክሶ ሱላለቲን ስስናራን።<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />“አት ታዴተታ ሄለልትቲ ካኡሌ ዎኖላል ጉት ታሬድናቶ ታንጂንት ካታማታ።”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s1">እያኖ ካባብሎን</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />ሂካኮ አባባየረ ካአቲ ሁና ካአባናየ ካካለ ኤርግቻት ዳሩርኮ ዳጋ ግራን አን ዴ፤ ካባጃተሳኮክ ሀንቃኮ ካከይ ኡል ዱባ ሀንቃየ፤ <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />ጦቂ ታአንተ ያዬ ሃ አማ ኦኬ፤ “ታንጂንት ባብሎን ኢተታ! ኢተታ! ዱርሳኮክ ምን ሌተታ፤ ባቲክ አያና ካኮባራሮ ምን ሌተታ! ባቲክና እሊ ድን ካሜልላሮ ክምብር ካኮባራሮ ምን ሌተ!<note caller="-" style="x"><char style="xo" closed="false">18፡2 </char><char style="xt" closed="false"><ref loc="ISA 13:21">ኢሳ. 13፡21</ref>፤ <ref loc="ISA 21:9">21፡9</ref>፤ <ref loc="JER 50:39">ኤር. 50፡39</ref>፤ <ref loc="JER 51:8">51፡8</ref>፤ <ref loc="REV 14:8">ራጋ 14፡8</ref>።</char></note> <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />ካሴቲሳሮ ሻርሙጣኖክሴኮክ ካዎይኒ ጣሞ ጎሳ ዱባ ጣመራ፤ ካኡሌ ዎኖላልና ኤሰነ ዎታ ሻርሙጠራ፤ ዳዳላተ ካባራረ ካኡሌ እባዶ ባሪሳኖኦትሴ ኣሎ ኤካታኖኮ ካከይ ዱረሳ ሌራ።”<note caller="-" style="x"><char style="xo" closed="false">18፡3 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23፡17</ref>፤ <ref loc="JER 51:7">ኤር. 51፡7</ref>።</char></note><verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />ታካለ ያየ ዳሩሪ ሃ አማ ግራን አን ማለ፤</para>
  <para style="q1" vid="REV 18:4">“ጎሳኬ! ጩቦክሴነ ዎታ ኡና አሮሌተን፤</para>
  <para style="q2" vid="REV 18:4">ኤሰ ታግናቶ ኤንገ ኦሄዴዳማታን አሮሌተን፤</para>
  <para style="q2" vid="REV 18:4">ኤሰ ኦሮኮ ብያ!<note caller="-" style="x"><char style="xo" closed="false">18፡4 </char><char style="xt" closed="false"><ref loc="ISA 48:20">ኢሳ. 48፡20</ref>፤ <ref loc="JER 50:8">ኤር. 50፡8</ref>፤ <ref loc="JER 51:6">51፡6</ref>፥<ref loc="JER 51:45">45</ref>።</char></note><verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />ጩቦክሴክ ቱላ ዳሩር ጌራ፤</para>
  <para style="q2" vid="REV 18:5">ዋ ባስክሴ ሻደራ፤<note caller="-" style="x"><char style="xo" closed="false">18፡5 </char><char style="xt" closed="false"><ref loc="GEN 18:20-21">መጣ 18፡20-21</ref>፤ <ref loc="JER 51:9">ኤር. 51፡9</ref>።</char></note><verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />ኤሰ ካስሰቶኮክ ጅልባ ማለ ኤሰን ስሳ፤</para>
  <para style="q2" vid="REV 18:6">ኤሰ ኦፈልተቶ ፈሎን አምባ ሙራ፤</para>
  <para style="q1" vid="REV 18:6">ኤሰ ጣሞ ካሞጋን ታኮለለደቶ ጡጋ ኦሮ</para>
  <para style="q2" vid="REV 18:6">አምባ ካአቲ የላዴን ለሌዳ፤<note caller="-" style="x"><char style="xo" closed="false">18፡6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">ማዛ. 137፡8</ref>፤ <ref loc="JER 50:29">ኤር. 50፡29</ref>።</char></note><verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />ኤሰ ካባጃትሴዉና ባሪሳኖኦትሴ ኢድሳይን እስኦትሴዉን ካስሰቶ ግታክ</para>
  <para style="q2" vid="REV 18:7">አቦሳና ጋዳ ኤሰን ስሳ፤</para>
  <para style="q1" vid="REV 18:7">ኤሰ ዎዳናትሴይ</para>
  <para style="q2" vid="REV 18:7">‘አን ኦር ዎኖ ኣን ሀማጼራ</para>
  <para style="q2" vid="REV 18:7">ጋልታንቴ ላኮዮ፤</para>
  <para style="q2" vid="REV 18:7">ጋዳና ኢን ሱረ ላኮጌሮ’ አማ ጣዳተ።<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />ሃንሱን ኤሰ ታግናታ ኤንገ ዱባ አሪ ቶይ ኤሰ ግናታ</para>
  <para style="q1" vid="REV 18:8">ጎይና ጋዳ ኡኢና ኤሰ ግናራ፤</para>
  <para style="q2" vid="REV 18:8">ኤሌኒና ጉባይናታ፤</para>
  <para style="q1" vid="REV 18:8">ኤሰ ጉት ካፍርዳራ</para>
  <para style="q2" vid="REV 18:8">ጎታ ሄዶ ካአቲያ።”<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />ኤሰነ ዎታ ካሻርሙጠራና ግር ካኢዳኒ ካግረ ዎኖላል ኤሰ ጉባታ ግራን ኢይ ካብያሮ ካኮድያረን ጎራታ ኤሰን ኦካ ኦታራን፤ <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />አቦሳክሴ አብሳታናኮ ካከይ ኤባ አሌንጉረን “ተ አት ታንጂንት ካታማት፥ ተ አት ታአቲ ካታማ ባብሎን! ፍርዳ ሳቲ ቶይ ኦሮ ኩ ቶስ ማንኮኤመተሮ ማራን ተ ኣኔ ኩን! ኣኔ ኩን!” አማራን።<note caller="-" style="x"><char style="xo" closed="false">18፡10 </char><char style="xt" closed="false"><ref loc="EZK 26:16-17">ሕዝ. 26፡16-17</ref>።</char></note><verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />ማርካፋክሶት ስዳነ ሆረንባን ካኢምናራ ማንኮዋታመሮ ማራን ኡሊ ጉት ዳዳላተን ኦባራራን ኦታራን፤ ኤሰን ጋዳራን፤<note caller="-" style="x"><char style="xo" closed="false">18፡11 </char><char style="xt" closed="false"><ref loc="EZK 27:31-36">ሕዝ. 27፡31-36</ref>።</char></note> <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />ማርካፋክሶ ካስደሮ ዎርቂ፥ ብር ታአማማቶ ማርጮ፥ ካካባጃመ ኤኤሞ፥ ኢንቁ፥ ካጭምን ሳርስ፥ ዳማክ ሳርስ፥ ካሀር ሳርስ፥ ሄላክ ሳርስና ታኢዳን ኡርት ካአቦ ጋ ዱባ፥ ታዳኖ ኢልክ፥ አዉኣሎክ ጋ፥ ነሃስ ታአማማቶ ማርጮ፥ ማርጮኮና ጫቢቾኮ ካፈላመሮ ሁ ዱባ፥ <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />ያጋንዶ፥ ሳዎ፥ ካኡራሮ ጋ፥ ፉልፉሊሶ፥ ኢጣና፥ ካዎይኒ ጣሞ፥ ታኤጀርሳ ዛይቲ፥ ጣመ፥ ዳርጋማ፥ ሳዬ፥ እዳድ፥ ፋራዴል፥ ካኮጉሉፋራን ፋራድ፥ ድይና ካካለ እባዶነያ።<note caller="-" style="x"><char style="xo" closed="false">18፡13 </char><char style="xt" closed="false"><ref loc="EZK 27:12">ሕዝ. 27፡12</ref>፤ <ref loc="EZK 13:22">13፡22</ref>።</char></note> <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />ዳዳላተን ኦባራራና “ተ አት ካሀልቻታ ካእዳን ኮኮ ዱባ ኩኮ ፋክመራ፤ ዱሩማታና ኩ ታኢድሳተ ካባጃታ ዱባ ባተታ፤ ጎርታ ሂታኮ ሆረንባን ሂካ ዱባ ሱረ ላኮሄላይናቶ!” አምናራን። <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />ሂካ ኮኮ ዱባ ኩኮ ኢምናታ ዱረሳ ኦሌረን ዳዳላተን ኦባራራን አቦሳክሴ አብሳታናኮ ካከይ ፋክም አልናራን፤ ኦታና ጋዳ፥<note caller="-" style="x"><char style="xo" closed="false">18፡15 </char><char style="xt" closed="false"><ref loc="EZK 27:31-36">ሕዝ. 27፡31-36</ref>።</char></note> <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />“ካጭምን ሳርስ፥ ዳማክ ሳርስና ሄላክ ሳርስ ሳርሳታ ታግቴ፥ ዎርቂና ካካባጃመ ኤኤሞ ኢንቁይና ታኢዳተ፤ ታንጂንት ካታማ ኣኔ ኤሰን! ኣኔ ኤሰን! <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />ሀኑኡ ግታኒዕ ኡራዎ ሳቲ ቶይ ባዬን፤” አማራን።</para>
  <para style="p" vid="REV 18:17">ማርካፋ ኦአጃጃሬን ዱባ፥ ማርካፋይ ካሰሰታረ እባዶ ዱባ፥ ማርካፋይ ኦፈላታረን ዱባ፥ በከይ ሰሴተን ኦዳዳላታረን ዱባ ኤባ ፋክም አልናራን፤<note caller="-" style="x"><char style="xo" closed="false">18፡17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">ኢሳ. 23፡14</ref>፤ <ref loc="EZK 27:26-30">ሕዝ. 27፡26-30</ref>።</char></note><verse eid="REV 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 18:18" />ኤሰ ጉባታ ግራን ካበያሮ ኢይ ካኮድያረን ጎራታ “ህታ ታንጂንት ካታማ ኣን ታላታ ታካለ ካታማ ሱረ ግቶ?” አማ ኦኬን።<note caller="-" style="x"><char style="xo" closed="false">18፡18 </char><char style="xt" closed="false"><ref loc="EZK 27:32">ሕዝ. 27፡32</ref>።</char></note> <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />እስኦትሶ ጉት ጎራ ክክባቴን፤ ኦታና ጋዳ ሃ አማ ኢይናራን፤ “በከ ጉት ካሰሴታሮ ማርካፋ ኦአባን ዱባ ኡራዎኦትሰይ ዱረሳ ኦሌራን፥ ሀሴ ታንጂንት ካታማ ሳቲ ቶይ ኦሮ ማንኮኢተቶ ማራን ኣኔ ኤሰን! ኣኔ ኤሰን!”<note caller="-" style="x"><char style="xo" closed="false">18፡19 </char><char style="xt" closed="false"><ref loc="EZK 27:30-34">ሕዝ. 27፡30-34</ref>።</char></note><verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />ተ አት ዳሩሪ! ኤሰ ገጌላ! ዋ እስን ማራን ኤሰ ጉት ማንኮፍርዴሮ ማራን እስን ቁሎለ፥ ኦፋራንቴታና ሄገሮል ገጌላየን!<note caller="-" style="x"><char style="xo" closed="false">18፡20 </char><char style="xt" closed="false"><ref loc="DEU 32:43">አዳ. 32፡43</ref>፤ <ref loc="JER 51:48">ኤር. 51፡48</ref>።</char></note><verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />ሂካኮ አባባተረ ካአቲ ኤርግቻት ካንጂንክ ሪም ግታክ ኤኤሞ ኮ ኬሰጉረ ሃ አማ በከ ኦሮ ሉጉደ፤ “ታንጂንት ካታማ ባብሎን ሃ ሁናይ ሻፋም ኢናታ፤ ሂታኮ ሆረንባን ሱረ ላኮሄላንቶ፤<note caller="-" style="x"><char style="xo" closed="false">18፡21 </char><char style="xt" closed="false"><ref loc="JER 51:63-64">ኤር. 51፡63-64</ref>፤ <ref loc="EZK 26:21">ሕዝ. 26፡21</ref>።</char></note> <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />ክራን ኦባሳራና ታዱዱሮ ያየ፥ ሱሱሌ ኦኡፉፋራና ማላካታ ኦኡፉፋራንኮት ያየ ካላም ኩዬ ኦሮ ላኮማልሳንቶ፤ ማዮና ፈሎ ኦገኔ ንፍርተ ሌ ካፈላራ ሎማስ እባዶ ሂታኮ ሆረንባን ኩ ኦሮ ላኮሄላምሮ፤ ካሪመ ኤኤሞኮት ያየ ኩ ኦሮ ላኮማልሳንቶ።<note caller="-" style="x"><char style="xo" closed="false">18፡22 </char><char style="xt" closed="false"><ref loc="EZK 26:13">ሕዝ. 26፡13</ref>፤ <ref loc="ISA 24:8">ኢሳ. 24፡8</ref>።</char></note> <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />ካኮሮንታ ኢፋ ሂታኮ ሆረንባን ኩ ኦሮ ላኮሀንቃይሮ፤ ካማሻሼኮትና ታማሻሼት ያየ ሂታኮ ሆረንባን ኩ ኦሮ ላኮማልሳንቶ፤ ዳዳላተ ካባራረ እባዶካ ካአላም እባዶ ካጂንጂንየ፤ ሙሩናካይ ጎሳ ዱባ ሽርሰታ።<note caller="-" style="x"><char style="xo" closed="false">18፡23 </char><char style="xt" closed="false"><ref loc="JER 7:34">ኤር. 7፡34</ref>፤ <ref loc="JER 25:10">25፡10</ref>።</char></note><verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />“ኤሰ ኦሮ ካሄገሮልኮክና ካቁሎሌ እባዶኮክ ኢግና፥ ኡሊ ካላጋዴራን እባዶ ዱባኮክ ኢግ ሄላመራ።”<note caller="-" style="x"><char style="xo" closed="false">18፡24 </char><char style="xt" closed="false"><ref loc="JER 51:49">ኤር. 51፡49</ref>።</char></note><verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />ሂካኮ አባባየረ ሃ ታአማቶ እባዶ ካሞጋንኮት ያየ ኣን ታላቶ ታአቲ ያየ ዳሩሪ አን ማለ፤ “ሀለ ሉያ! ፋይና ካባጃና ሁናና ሄዶካንክያ፤<note caller="+" style="f"><char style="fr" closed="false">19፡1 </char><char style="fqa" closed="false">“ሀለ ሉያ” </char><char style="ft" closed="false">አማኖ ታኢብራይስጢ ህኢ “ዋ ሀጋላታሞ” አማኖያ። </char></note> <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />ፍርዳኬሳ ካሩሚና ልክኪያ፤ ኡል ሻርሙጡማ ታባቶይሳቶ ታንጂንት ሻርሙጣት ፍርዳይ ኡሱ ኤሰ ሙርሰራ፤ ኤሰ ሙርሳኖይ ኡሱን ኦሀንዳራንኮክ ኢጉን ሀሎ ቤራ።”<note caller="-" style="x"><char style="xo" closed="false">19፡2 </char><char style="xt" closed="false"><ref loc="DEU 32:43">አዳ. 32፡43</ref>፤ <ref loc="2KI 9:7">2 ዎኖ. 9፡7</ref>።</char></note> <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />አደና፥ “ሀለ ሉያ! ኤሰኮ ካበያራ ኢይ ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮ ኤልድ ብናራ!” አማ ኦኬን።<note caller="-" style="x"><char style="xo" closed="false">19፡3 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ. 34፡10</ref>።</char></note> <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />ላማታንኮ አፋሮ ጃርሶለና ኔፎ ታአብታ መጣ አፋሮ ኮርፍንጄ ጉት ካሀማጼሮ ሄዶዉን በቤዲ ኡል ኦዬንጉረን “ሀሚኒዕ፥ ሀለ ሉያ!” አማ ሳጋደን።<verse eid="REV 19:4" /></para>
  <para style="s1">ካኢዳዶ ካሃስኖ ጅላ</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />ሂታኮ ሆረንባን፥ “ኡሱ ኦአብሳታና ኡሱን ኦሀንዳታን ዱባ፥ ክጪጫርና ካጂንጂን ሄዶካን ጋላታ!” ታአማታ ያየ ኮርፍንጀኬሳኮ ቤተ።<note caller="-" style="x"><char style="xo" closed="false">19፡5 </char><char style="xt" closed="false"><ref loc="PSA 115:13">ማዛ. 115፡13</ref>።</char></note> <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />እባዶ ካሞጋንኮት ያዬ፥ በከ ኦዳጋራንኮት ያየና ካአቲ ድድዴናኮት ያየ፥ ኣን ታላታ ያየ ሃ አማ ግራን አን ማለ፤ “ሀለ ሉያ! ዱባ ካዳንዳራ ጎታ ሄዶካን ሬደራ!<note caller="-" style="x"><char style="xo" closed="false">19፡6 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሕዝ. 1፡24</ref>፤ <ref loc="PSA 93:1">ማዛ. 93፡1</ref>፤ <ref loc="PSA 97:1">97፡1</ref>፤ <ref loc="PSA 99:1">99፡1</ref>።</char></note> <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />ታኢዳዶ ሃስኖ ማንኮጌተቶ ማራና ማሻሸቴሳ ማንኮእስኤካሳተቶ ማራን ገገላኖ! ገጌሎና የላኖ! ኡሱ ካባጅኖ! <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />ካሀንቃሮና ሙጭ ካአመ ካኢዳሮ ሳርስ ጎጎሳርሳቶን ኤሰን ስሳመ፤ ካጭሚንክ ሳርስ ኦቁሎሌ ቁሉኒዕ ፈሎያን።”<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />ሂካኮ አባባተረ ኤርግቻት ኢነ፥ “ታኢዳዶ ሃስኖኮክ ጅላን ኦኡማሜራን ኦሶማሳመንያን” አምደ “ጻፍ” አመ፤ አደና “ሂክ ካሩም ሃፉራ ካዋያ” አመ።<note caller="-" style="x"><char style="xo" closed="false">19፡9 </char><char style="xt" closed="false"><ref loc="MAT 22:2-3">ማቶ. 22፡2-3</ref>።</char></note><verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />አንና ኤርግቻትን ሳጋድን ሉቃኦቴሳ ሄገሊ በቤድቴይ ኡል ኦየ፤ ኡሱ አደ “እሳግ! ሂካ አሮፈልተ! አን ኩኔ ዎታና ካየሱሳ አቶ ኦአባን አብላልታነ ዎታ ካሀንዳሮያ፤ ዋዉን ሳጋድ! ካየሱሳ አቶ ሄገርኮክ አያናያ” አመ።<verse eid="REV 19:10" /></para>
  <para style="s1">ጉማራክ ፋራድ ጉት ካሀማጼሮ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />ሂካኮ አባባየረ ታባናንተቶ ዳሩር አን ዴ፤ ፋራድ ጉማራክ ዴ፤ ፋራድ ጉት ካሀማጼረ ካአማናመና ካሩም ካአማማሮየ፤ ኡሱ ሩሚ ፍርድናራ፤ ጀሬና ሻፋታራ።<note caller="-" style="x"><char style="xo" closed="false">19፡11 </char><char style="xt" closed="false"><ref loc="EZK 1:1">ሕዝ. 1፡1</ref>፤ <ref loc="PSA 96:13">ማዛ. 96፡13</ref>፤ <ref loc="ISA 11:4">ኢሳ. 11፡4</ref>።</char></note> <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />እልኦ ኦቴሳና ካኤሌኔ ላጫ ኣን ላራን፤ መተኬሳ ጉት ካሞጋን ካላቻ ግራ፤ ኡሱ ኳሬ ካካለ ማዮና ካካሶን ኡሱ ጉት ካጻፋመረ መገ ግረ፤<note caller="-" style="x"><char style="xo" closed="false">19፡12 </char><char style="xt" closed="false"><ref loc="DAN 10:6">ዳኔ. 10፡6</ref>።</char></note> <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />ኡሱ ኢግ ካጩጳመሮ ሳርስ ሳርሳተ ግረ፤ መገኬሳና፥ “ሃፉራ ካዋ” ካአማማሮየ። <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />ጉማራክ ፋራዴሊ ጉት ኦሀማጼራን፥ ጉማራክና ሙጭ ካአመ ካኢዳሮ ሳርስ ኦሳርሳቴራን ካዳሩረ ዎታዳራል ኡሱ ዴበ ሰሴታራ፤ <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />ካኬሳ ካሌኖን ጎሳጆል ካኮባስራ ካኤነናን ሺፋ ህኢቴሳኮ ብያራ፤ ሁና ባሪስናራ፤ ኡሱ ዱባ ካዳንዳሮኮት ታአብስሳቶ ታዋ ሙሮ ካቱሳሮ ካዎይኒ ጣሞ ካኮሙላራን ኡሱ ዳዳርናራ።<note caller="-" style="x"><char style="xo" closed="false">19፡15 </char><char style="xt" closed="false"><ref loc="PSA 2:9">ማዛ. 2፡9</ref>፤ <ref loc="ISA 63:3">ኢሳ. 63፡3</ref>፤ <ref loc="JOB 3:13">ኢዮ. 3፡13</ref>፤ <ref loc="REV 14:20">ራጋ 14፡20</ref>።</char></note> <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />ሳርስኬሳይና ሬራቴሳ ጉት “ካዎኖላል ዎኖ፥ ካጎቶሌ ጎታ” ካአማራ መገ ጻፋመራ።<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />ሂካኮ አባባተረ አርት ጉት ካአሌሮ ኤርግቻት ኮ አን ዴ፤ ኡሱ ዳሩሪ ካቡባሮ ክምብርጆሉን ሃ አማ ታአቲ ያዬ ኦኬ፤ “ካአቲ ኣሞ ካዋ ቶስ ኮዬን! ኩኩማ! <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />ሶ ኦዎኖላል፥ ጀሬኑን ኦአጃጃራንኮኒዕ ሶ፥ ካአቲ ካጅሬኔ እባዶኮኒዕ ሶ፥ ኦፋራዴልና ፋራዲ ኦጉሉፋራንኮኒዕ ሶ፥ ኦጎቶሌልና ኦሀንዳራንኮኒዕ ሶ፥ ካጪጫርኮኒዕና ካጂንጂኮኒዕ ሶ፥ ማምስክ እባዶኮኒዕ ሶ ኮዬን አማ!”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />ኡሱማለና ሱላለትና ካኡሌ ዎኖላል፥ ዎታዳራልክሶና ጉማራክ ፋራዲ ጉት ካሀማጼሮነና ዎታዳራልኔ ዎታ ጀሬን ሻፋይን ኦኩኩሜራን አን ዴ፤ <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />አየሱን ጎአመን ሱላለት አባመ፤ ኡሱነ ዎታ ኡሱ ሆረ ባሳ ፈላ ካግረ ካጣራ ካሄገሮት አባመ፤ ኡሱ ካሱላለቲ ማላታ ካኮንግረና ታሱላለት ምስሊዉን ሳጋዳ ካግረ እባዶን ባሳ ፈላ እሶ ሶሶይሳ ግረ፤ ሂኒዕ ላማ ላጫ ካኤሌነኮት ባዲ ኔፎነ ግራን ሻፋመን።<note caller="-" style="x"><char style="xo" closed="false">19፡20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">ራጋ 13፡1-18</ref>።</char></note> <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />ኦሄሴራን አደን ጉማራክ ፋራድ ጉት ካሀማጼሮኮት ህኢኮ ካበያሮ ሺፋይ ጎዬን፤ ክምብርጆል ዱባ ሶኦትሶ ኣመ ባራረ።<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s1">ጌስ ኩማኮክ ዎኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />ሂካኮ አባባተረ ቦላክ ጉምቢ ካኮባናራና ሳንሳላታ ገነቴሳይ ካአባተራ ኤርግቻት ዳሩርኮ ዳጋ ግራን አን ዴ፤ <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />ዶቦስ አበጉረ ጌስ ኩማ ሽየ፤ ሂክ ዶቦንሳ ዱርሳ ጎርቱን ጻላየ ታአማማቶ ካሆሬ ሀበሳያ፤<note caller="-" style="x"><char style="xo" closed="false">20፡2 </char><char style="xt" closed="false"><ref loc="GEN 3:1">መጣ 3፡1</ref>።</char></note> <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />ሂክ ዶቦስ እባዶ ጎጎሶቦንኮ ጌስ ኩማ ታ አማጋምሮን ኤርግቻት ሂካ ዶቦስ ቦዋክ ጉምቢ ኦሮዴሰ ሉጉደ፤ ጩፈጉረ ካካለ ማዮና ጎጎባኖንኮ ማታማ ካየ፤ ኤሰኮ አባባይረ ጎራታ ክጫሩን ኡሱ ፉራሚን ዶትሳራ።<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />ኤሰኮ አባባየረ አን ኮርፍንጄል ዴ፤ ኡሱ ኮርፍንጄል ጉት ካኮፍርዲሮ ኦዶናት ካአቦ ካሀማጼሮ ዴ፤ ጋራ ካየሱሳ ማንኮአቶቴራን ማራና ሃፉራ ካዋ ማራን መተክሶ ካኮጎሳመሮ እባዶኮት ኔፎ አን ዴ፤ እሶ ሱላለዉና ምዲ ታሱላለን ሳጋዶን ኦግራን ማላታኬሳ በቤድትሶይና ሌረ ገነትሶይ ጉት አንካኖን ኦግራንያን፤ እሶ ጎይኮ ኬንጉረን ክርስቶሳነ ዎታ ጌስ ኩማ ሬደን።<note caller="-" style="x"><char style="xo" closed="false">20፡4 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳኔ. 7፡9</ref>፥<ref loc="DAN 7:22">22</ref>።</char></note> <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />ካሄሰረ ካጎየራ እባዶ አደ ጌስ ኩማ ታአማጋምሮ ጎይኮ ላኮኬራን፤ ህክና ካሆራርጄ ጎይኮ ከያኖያ፤ <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />ካሆራርጄ ጎይኮ ከያኖ ኦሄላቴራን ኦሶማሳሜና ቁሎሌያን፤ ካላም ጎይ እሶ ጉት ኦዶናት ላኮአቦ፤ እሶ ኦዋና ኦክርስቶሳ ቱቃሞል ልናራን፤ ክርስቶሳነ ዎታ ጌስ ኩማ ሬድናራን።<verse eid="REV 20:6" /></para>
  <para style="s1">ጻላየኮክ አዎዳማኖ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />ጌስ ኩማ ካኮጉዳተ ጎራታ ጻላየ ሻኖኮ ፉራምናታ፤ <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />አላም ዱባ ጉት ካግሮ ጎሳ ጎግና ማጎግ ሶቢና ጀሬን ቶስ ታብስን ኤመይናራ፤ ሞጋንክሶና ላቡ ታግቶ ጨካለ አንያ።<note caller="-" style="x"><char style="xo" closed="false">20፡8 </char><char style="xt" closed="false"><ref loc="EZK 7:2">ሕዝ. 7፡2</ref>፤ <ref loc="EZK 38:2">38፡2</ref>።</char></note> <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />እሶ ኡል ዱባ ጋምባሜን ካቁሎሌ ማማና ታጌላታንተቶ ካታማ ማራሙረን አበን፤ አየሱን ጎአመን ኤለን ዳሩርኮ ዳይደ እሶ ጉብተ ባሰ። <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />እሶ ካሶበረ ዱርሳ፥ ሱላለትና ካጣራ ካሄገሮ ማንኮግሮ ሬስ ታኮጉባታሮ ባድ ታኤሌነቲ ኦሮዴ ሻፋመን፤ ኤሰ አሪና ሄመን ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮን አቦሳምናራን።<verse eid="REV 20:10" /></para>
  <para style="s1">ካጋቾ ፍርዳ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />ሂታኮ አባባየረ አን ካንጂንክ ጉማራክ ኮርፍንጀና ኮርፍንጄ ጉት ካሀማጼሮ ዴ፤ ኡልና ዳሩርና ሆረቴሳኮ ባቃተን፤ ባንኤና እሶን ላኮሄላንተ፤ <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />ካጎየሮ እባዶ ካጪጫርና ካጂንጂ ኮርፍንጄ ሆረ ካአሌሮ አን ዴ፤ ማጻፋልና ባናመ፤ ካግር ማጻፋ ካሌራ ካካለ ማጻፋና ባናመ፤ ኦጎየራና ማጻፋ ፈሎኦትሶ ጻፋሜን ጎጎግራንክ ማለ ፍርዳ አታቴን፤<note caller="-" style="x"><char style="xo" closed="false">20፡12 </char><char style="xt" closed="false"><ref loc="DAN 7:9-10">ዳኔ. 7፡9-10</ref>።</char></note> <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />በከና እሶ ኦሮ ካግሮ ካጎየሮ ስሰን፤ ጎይና ቦዋና እሶ ኦሮ ካግረ ካጎየሮ እባዶ ስሰን፤ እባዶ መተመቴ ፈሎኦቴሳክ ማለ ፍርዳ አታተ፤ <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />ጎይና ቦዋና ባድ ቶስ ሻፋመን፤ ህት ታኤሌነ ባድ ካላምክ ጎይያ፤ <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />መገኬሳ ካግር ማዝጋባይ ጻፋም ካግኖን ዱባ ባድ ታኤሌኔ ቶስ ሻፋመ።<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s1">ታኡሱብ ዳሩርና ኡል ካኡሱብ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />ሂታኮ አባባየረ አን ታኡሱብ ዳሩርና ኡል ካኡሱብ ዴ፤ ታሆራርጄ ዳሩርና ካሆራርጄ ኡል ሮረኔን፤ በከና ሂታኮ ሆረንባን ላኮግራን፤<note caller="-" style="x"><char style="xo" closed="false">21፡1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ. 65፡17</ref>፤ <ref loc="ISA 66:22">66፡22</ref>፤ <ref loc="2PE 3:13">2 ጴጢ. 3፡13</ref>።</char></note> <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />ቁሉት ካታማ፥ ታኡሱብት ኢየሩሳለም፥ ኤንተሪ ኬሳምን ታሳርሳተቶ ማሻሸ አን እስ ኤካሳተደ ዳሩርኮ ዋ ዶለኮ ዳጋ ግራን አን ዴ፤<note caller="-" style="x"><char style="xo" closed="false">21፡2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52፡1</ref>፤ <ref loc="ISA 61:10">61፡10</ref>፤ <ref loc="REV 3:12">ራጋ 3፡12</ref>።</char></note> <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />ሃ ታአማታ ታአቲ ያየ ኮርፍንጀኮ ብያግራን አን ማለ፤ “ሂክማ! ዋ ካኮባራራ ምን እባዶነ ዎታ ግራ፤ እሶነ ዎታና ግርናራ፤ እሶና ጎሳኬሳያን፤ ዋ ኡሱን እሶነ ዎታ ሄዶክሶና ልናራ፤<note caller="-" style="x"><char style="xo" closed="false">21፡3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">ሕዝ. 37፡27</ref>፤ <ref loc="LEV 26:11-12">ዎዩ. 26፡11-12</ref>።</char></note> <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />እልም ዱባ ኢልኦ ኦትሶኮ ሻካራራ፤ ካጣዎ ሴራ ማንኮሮረሮ ማራን ጎይ ጎርቱን ጋዳ ጎርቱን ኦታን ጎርቱን አቦሳ ሂታኮ ሆረንባን ላኮግሮ።”<note caller="-" style="x"><char style="xo" closed="false">21፡4 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25፡8</ref>፤ <ref loc="ISA 35:10">35፡10</ref>፤ <ref loc="ISA 65:19">65፡19</ref>።</char></note><verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />ኮርፍንጄ ጉት ካሀማጼረና፥ “ግዳ አን ካመን ዱባ ኡሱባይስናራ!” አመ፤ ደቤና፥ “ሂክ ሃፉራ ካአብዳመና ሩም ማንኮሌ ማራን ኢነ ጻፍ” አመ። <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />ኤሰኮ አባባተረ ኢነ ሃ አመ፥ “ጉዳተዋ! ካሆሬና ካሃረ፥ አንያ፤ ካሱጉባተሮን ኦግር በከኮክ ፉልቶኮ ሙራ ካላይ ዳናባ ኣን ስስናራ።<note caller="-" style="x"><char style="xo" closed="false">21፡6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55፡1</ref>።</char></note> <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />ካአዎዳራ ሂካ ኤልናራ፤ አንና ኡሱን ሄዶ ልናራ፤ ኡሱና ኤረኬ ልናራ።<note caller="-" style="x"><char style="xo" closed="false">21፡7 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 ሳሜ. 7፡14</ref>፤ <ref loc="PSA 89:26-27">ማዛ. 89፡26-27</ref>።</char></note> <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />አየሱን ጎአመን ኦአብሳታራን፥ አማኖ ካላይኒዕ፥ ባቶሌ፥ ኔፎ ኦላጋዳራን፥ ኦሻርሙጣራን፥ ጎዮ ኦአባን፥ ቶልቻ ኦሄዶይሳታራን፥ ጣራ ካአዬሳራ ዱባ ኢድሊትሶ ሙራምደ ሬስ ታኮጉባታሮ ታኤሌነ ባዲ ኦሮ ግርናራ፤ ህክና ካላም ጎይያ።”<verse eid="REV 21:8" /></para>
  <para style="s1">ታኡሱብት ኢየሩሳለም</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />ቶዶባ ታአቲ ሙሮ ካኮአማጋንተቶ ጡጋል ቶዶባ ካአበሮ ኤርግቻል ቶዶባኮ ኮ ኤመተረ፥ “ኮያ! ታኢዳዶ ኦር ታሌተቶ ማሻሸ አን ኩን ቱስናራ” አመ። <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />አያናይ ታንጂንትና ታኤርት ዎዳም ቶስ እን ቤሰጉረ ቁሉት ካታማ ኢየሩሳለም ዳሩርኮ ዋ ዶለኮ ዳጋ ግራ ኢን ቱሰ።<note caller="-" style="x"><char style="xo" closed="false">21፡10 </char><char style="xt" closed="false"><ref loc="EZK 40:2">ሕዝ. 40፡2</ref>።</char></note> <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />ካባጃ ታዋይ ሀንቃይሳ ግቴ፤ ኢፋኮክ ሀንቃ ኣሎ ካካባጃመ ኤኤሞ አንና፥ ዳዉኢቲ ኣን ሙጭ ካአመ አዉኣሎክየ፤ <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />ጎጫ ቶሞንኮ ላማ ታአብቶ ታአቲና ታኤርት ታግምበ ኣል አባናይተ፤ ጎጫ ቶሞንኮ ላማይ ኤርግቻ ቶሞንኮ ላማ አሌ ኦራረ፤ ጎጫ ቶሞንኮ ላማይ ጉት ታእስራኤል ኣኒኮክ መገ ጻፋመ ግረ። <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />ምና ታብያንነ ጎጫ ሴድ፥ ምና ታኤሌነ ጎጫ ሴድ፥ ምና ታሄገሌነ ጎጫ ሴድ፥ ምና ታኢያነ ጎጫ ሴድ አባናይተ።<note caller="-" style="x"><char style="xo" closed="false">21፡13 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">ሕዝ. 48፡30-35</ref>።</char></note> <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />ታካታማ አልኮክ ግምበ ኡኩም ቶሞንኮ ላማ አባናናየ፤ ኡሱ ኡኩም ጉት ቶሞንኮ ላማ ኢዳዶን ኦፋራሜራንኮክ መገ ጻፋመ ግረ፤ <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />ኢነ ካአዬሰራ ኤርግቻት ካታማልና ጎጫልክሴ፥ ታግምበ ኣል ህስል ካኮኦይራን ታዎርቂ ዳማ አባናየ።<note caller="-" style="x"><char style="xo" closed="false">21፡15 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ሕዝ. 40፡3</ref>።</char></note> <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />ካካታማ ኤርናና ባላኣንክሰ ኤካ ካሌ ምና አፋር ኤካክ ቁንቡብ አባናይተ፤ ኤርግቻትና ካታማ ታኮኤካሳራን ዳማይ ኤካሰ ቶቴረ ኤርናክሰ ኩማ ላማነ አፋር ቦሌ ክሎ ሜትራ ግታት ሌተ፤ ባላኣንክሰና ጅፉትሰ ህታ ግታትዋ ሌተ፤ <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />ኤርግቻትና ታግምበ ኣል ህስል ኦየ፤ ኤርግቻትና ህስሊ ካኮኦዋረ ጎራታ ህስል ቦልኔ አፋርታምኮ አፋር ሌ፤ <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />ግምበና ካኮፈላመራ እያሰጲድ ካአማማሮ ኤኤሞኮየ፤ ኤሰ ካታማና ማስቶቲ ኣን ሙጭ ካአመ ዎርቂኮ ታፈላንተቶተ፤<note caller="-" style="x"><char style="xo" closed="false">21፡18 </char><char style="xt" closed="false"><ref loc="ISA 54:11-12">ኢሳ. 54፡11-12</ref>።</char></note> <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />ታካታማት ግምበኮት ኡኩምጆል ምዲ ታሞጋንክ ካካባጃመ ኤኤሞይ ኢሳድሳ ግረን፤ ካሆራርጄ ኡኩም ታኢያሰጲድተ፥ ካላም ሰንፔር፥ ካሴድ ከልቀዶን፥ ካአፋር መረግድ፥ <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />ካከን ሰርዶንክስ፥ ካሌይ ሰርድዮን፥ ካቶዶብ ክርስትሎበ፥ ካስዴድ ብሬለ፥ ካሳጋሊ ዌራዉረ፥ ካቶሞኒ ክርስጲራስስ፥ ካቶሞኮ ኮይ ያክንት፥ ካቶሞንኮ ላም አመተስጢኖስዬን። <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />ጎጫል ቶሞንኮ ላማ ካካባጃመ ኤኤሞ ቶሞንኮ ላማ አባናየ፤ ጎጫል መተመተይ ካካባጃመ ኤኤሞ ኮኮ ፈላመረ፤ ካካታማ ራ ዳዉኢቲ ኣን ኢፋ ካሮርሳሮ ሙጭ ካአመ ዎርቂኮ ካፈላመሮየ።<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />ዱባ ካዳንዳራ ጎታ ሄዶና ኢዳዶ ቁሉክ ምን ካዋክሴ ማንኮሌራን ማራን ካታማይ ኦሮ ቁሉክ ምን ካዋ አን ላኮዴሮ፤ <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />ካባጃ ታዋ ማንኮሀንቃቶ ማራና ኢዳዶ ኢፋክሴ ማንኮሌ ማራን ካታማ አርት ጎርቱን ድግኒ ኤሰን ጎጎሀንቃይራኑን ላኮዶትሳሮ።<note caller="-" style="x"><char style="xo" closed="false">21፡23 </char><char style="xt" closed="false"><ref loc="ISA 60:19-20">ኢሳ. 60፡19-20</ref>።</char></note> <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />ጎሳ ኢፋክሴይ ሰሴታራ፤ ካኡሌ ዎኖላል ታአባን ዱሩማትሶ ኤሰ ቶስ ኬናራን፤<note caller="-" style="x"><char style="xo" closed="false">21፡24 </char><char style="xt" closed="false"><ref loc="ISA 60:3">ኢሳ. 60፡3</ref>።</char></note> <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />ኤሰ ካታማይ ሄመን ማንኮግኖን ማራን ማጎሬና ኡፋል ላኮጩፋማሮ። <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />ካካለ ጎሳና ታአባን ዱሩማን ኡራዎኦትሶ ኤሰ ቶስ ኬንናራን፤<note caller="-" style="x"><char style="xo" closed="false">21፡26 </char><char style="xt" closed="false"><ref loc="ISA 60:11">ኢሳ. 60፡11</ref>።</char></note> <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />ካጢቃችስራ ኮኮ ኤሰ ቶስ ሱረ ላኮታባሮ፤ ፈሎ ኦባቶዬን ካፈላራና ጣራ ካአዬሳራ ኤሰ ቶስ ሱረ ላኮታባሮ፤ ኤሰ ቶስ ኦታባራን መገክሶ ካግር ማዝጋባይ ካኮንጻፋመሮ ኦላልያን።<note caller="-" style="x"><char style="xo" closed="false">21፡27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52፡1</ref>፤ <ref loc="EZK 44:9">ሕዝ. 44፡9</ref>።</char></note><verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s1">ካግር ላጋና ካግር ጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />ሂታኮ አባባተረ ኤርግቻት ዋኮና ካኢዳዶ ኮርፍንጀኮ ኦብያራን ዳዉኢቲ ኣን ኦላራን ኦግር በከ ኦላጋ ኢን ቱሰ፤<note caller="-" style="x"><char style="xo" closed="false">22፡1 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሕዝ. 47፡1</ref>፤ <ref loc="ZEC 14:8">ዛኪ. 14፡8</ref>።</char></note> <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />ሂክ ላጋ ካካታማ ካባላኣንክ ራ ጠኤ በልኤሰረ ሮራራ፤ ላጋይ በተነና መርገነ ድግኒ ድግኒ ዱባማ ጌስ ኮይ ቶሞንኮ ላማ ጋለ ኢል ካዱባማረ ካግር ጋ ግረ፤ ኡሱ ጋኮኒዕ ባላሎ ጎሳ ፋይሳሬን።<note caller="-" style="x"><char style="xo" closed="false">22፡2 </char><char style="xt" closed="false"><ref loc="GEN 2:9">መጣ 2፡9</ref>፤ <ref loc="EZK 47:12">ሕዝ. 47፡12</ref>።</char></note> <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />ሂታኮ ሆረንባን ማምስክ ቃንጎ ሱረ ላኮግሮ፤ ካዋና ካኢዳዶ ኮርፍንጀ ካታማይ ኦሮ ግርናራ፤ ኦሀንዳራና ኡሱ ሄዶይሳይናራን።<note caller="-" style="x"><char style="xo" closed="false">22፡3 </char><char style="xt" closed="false"><ref loc="ZEC 14:11">ዛኪ. 14፡11</ref>።</char></note> <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />ሆረቴሳ ድናራን፤ መገኬሳና በቤድትሶይ ጉት ግርናራ፤ <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />ሂታኮ ሆረንባን ሄመን ላኮግርናቶ፤ ጎታ ሄዶክሶ እሶን ማንኮሀንቃይሳሮ ማራን ኮሮንታ ጎርቱን ካአሪቲ ኢፋ ላኮዶትሳሮ፤ ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ገራኒ እሶ ሬድናራን።<note caller="-" style="x"><char style="xo" closed="false">22፡5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">ኢሳ. 60፡19</ref>፤ <ref loc="DAN 7:18">ዳኔ. 7፡18</ref>።</char></note><verse eid="REV 22:5" /></para>
  <para style="s1">የሱሳኮክ አባባይ ኤመታኖ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />ሂታኮ አባባተረ ኤርግቻት ኢነ ሃ አመ፤ “ሂክ ሃፉራ ካአብዳመና ካሩምያ፤ ካሄገሮል ካአዬስሳራ ሄዶ ኤነ ካሊናሮ ኮኮ ኦሀንዳራዉን ቱስን ኤርግቻት ፋረ።”<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />የሱሳና “ሂክማ! አን ሳም ኤመይናራ! ሂካ ማጻፋኮክ ካሄገሮ ሃፉራ ካኦራታራ ካሶማሳመያ!” አመ።<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />ሂካ አየስ ካማለራና ካዴራ አን ያንሳያ፤ ሂካ አየስ ካኮማላረና ካኮደያረ ጎራታ ሂካ አየስ ኢን ካቱሰሮ ኤርግቻትን ሳጋድን ሉክቴሳ ሄገሊ እዬ። <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />ኤርግቻት ጎአመን “እሳግ ሂካ አሮፈልተ! አን ኩኔ ዎታና አብላልታነ ካሄገሮልነ ዎታ ሂካ ማጻፋኮክ ሃፉራ ካፈላሮ እባዶነ ዎታ ካሀንዳሮያ፤ ዋዉን ሳጋድ!” አመ። <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />አደና ኢነ ሃ አመ፤ “ጎራታ ማንኮጌሮ ማራን ሂካ ማጻፋኮክ ካሄገሮ ሃፉራ ማታማይ አሮጩፍተ፤ <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />ሂታኮ ሆረንባን ካሜላን ሜልላኖ ሆረድናራ፤ ባቲክና ሀባቶየ፤ ካሙጭመና ሙጭ ሀአመ፤ ቁሉክና ሀቁሎየ።”<note caller="-" style="x"><char style="xo" closed="false">22፡11 </char><char style="xt" closed="false"><ref loc="DAN 12:10">ዳኔ. 12፡10</ref>።</char></note><verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />“ሂክማ! አን ሳም ኤመይናራ፤ እባዶን መተመቴ ፈሎኦቴሳክ ማለ ሙርን ሙራ አን አበራ፤<note caller="-" style="x"><char style="xo" closed="false">22፡12 </char><char style="xt" closed="false"><ref loc="ISA 40:10">ኢሳ. 40፡10</ref>፤ <ref loc="ISA 62:11">62፡11</ref>፤ <ref loc="PSA 28:4">ማዛ. 28፡4</ref>፤ <ref loc="JER 17:10">ኤር. 17፡10</ref>።</char></note> <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />ካሆሬና ካሃረ፥ ካሆራርጄና ካጋቾ አንያ።”<note caller="-" style="x"><char style="xo" closed="false">22፡13 </char><char style="xt" closed="false"><ref loc="REV 1:8">ራጋ 1፡8</ref>፥<ref loc="REV 1:17">17</ref>፤ <ref loc="REV 2:8">2፡8</ref>፤ <ref loc="ISA 44:6">ኢሳ. 44፡6</ref>፤ <ref loc="ISA 48:12">48፡12</ref>።</char></note><verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />ካግር ጋኮት ኢል አምና ጎጫክሰነ ታብን ፈኢ እሶን ጎጎግርቶን ሳርስክሶ ኦአልሳተራን ኦሶማሳመንያን።<note caller="-" style="x"><char style="xo" closed="false">22፡14 </char><char style="xt" closed="false"><ref loc="GEN 2:9">መጣ 2፡9</ref>፤ <ref loc="GEN 3:22">3፡22</ref>።</char></note> <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />ከሮር ኣን እስኦትሶ ኦባቶይሳታራና ኦሞራራን፥ ኦሻርሙጣራን፥ ኔፎ ኦላጋዳራን፥ ቶልቻ ኦሄዶይሳታራን፥ ጣራ ኦጌላታራና ካጣራ ራድ ኦሰሴታራን ዱባ ካታማኮ ሳሬ ግርናራን።<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“አን የሱሳ ሂካ አቶ እስኑን ጎጎስስሮን ኤርግቻኬ ምን ካኤብ ዱባን ፋረራ፤ አን አላታኑን ካዳዉተ ህዲንዳ ሳኒያ፤ ካሀንቃሮ ባካላ ካባባርሰያ።”<note caller="-" style="x"><char style="xo" closed="false">22፡16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">ኢሳ. 11፡1</ref>፥<ref loc="ISA 11:10">10</ref>።</char></note><verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />ቁሉክ አያናና ማሻሸ “ኮያ!” አምናራን፤ ካማላራ “ኮያ!” ሀአመ፤ ካሱጉባተራ ሀኤመተ፤ ካዶታታራና በከ ኦግር ሙራ ቶና ካላይ ዳናባ ሀጣመ።<note caller="-" style="x"><char style="xo" closed="false">22፡17 </char><char style="xt" closed="false"><ref loc="ISA 5:1">ኢሳ. 5፡1</ref>።</char></note><verse eid="REV 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />አን፤ ሂካ ማጻፋይ ካጻፋመሮ ካሄገሮ ሃፉራ ካማላሮ ዱባ ሴራራ፤ ማዮና ሂካ ሃፉራ ጉት ኮኮ ኮ ጎአደ፥ ሂካ ማጻፋይ ኦጻፋመራን ሙሮ ዋ ኡሱን አድናራ። <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />ማዮና ሂካ ካሄገሮ ማጻፋ ካጻፋመሮ ሃፉራኮ ኮ ጎሀንቂሰ፥ ሂካ ማጻፋይ ካሰጋመሮ ካግር ጋኮት ኢልና ቁሉት ካታማኮት ቆባኮ ዋ ኡሱ ሀንቂሲናራ።<note caller="-" style="x"><char style="xo" closed="false">22፡19 </char><char style="xt" closed="false"><ref loc="DEU 4:2">አዳ. 4፡2</ref>፤ <ref loc="DEU 12:32">12፡32</ref>።</char></note><verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />ሂካ አየሱን አቶ ካሌራ፥ “ኦግራን፥ አን ሳም ኤመይናራ!” አማራ።</para>
  <para style="p" vid="REV 22:20">ሀሚኒዕ፥ ጎታ የሱሳ ኮያ!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />ጎታ የሱሳኮት ስኖ እስን ዱባነ ዎታ ሀሌቶ ሀሚኒዕ።<note caller="+" style="f"><char style="fr" closed="false">22፡21 </char><char style="fqa" closed="false">እስን ዱባ </char><char style="ft" closed="false">ቶቶ ታጋልባ ጹፍል “ዱባ” ጎአንቶ ካካለ አደ “ካዋ ጎሳ” አማታ፤ “ካዋ ጎሳ ዱባ” ታአማታና ግታ። </char></note><verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>