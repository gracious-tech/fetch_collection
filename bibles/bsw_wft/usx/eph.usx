<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Bayso New Testament</book>
  <para style="h">ኤፈሶን</para>
  <para style="toc1">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ ካኤፈሶን እባዶ ቶስ</para>
  <para style="toc2">ኤፈሶን</para>
  <para style="toc3">ኤፈ.</para>
  <para style="mt2">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ</para>
  <para style="mt1">ካኤፈሶን እባዶ ቶስ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ጳዉሎሳ ካኤፈሶን እባዶን ካጻፈራ ሀንዳ ዱባንኮና ሆረ ክንትብ ካኮስሳራ “ሀልቻ ካዋ ጎጎሌሮ ዳሩርና ኡሊና ካግራ መጣጆል ዱባ እስኣትረ ኮ ካክርስቶሳ ኦዶናት ሄገሊ ታግራን አሪ ካኮጌተ ጎራታያ” (1፡10) ታአማቶ ቆፋይያ። አደና የሱሳ ክርስቶሳነ ዎታ ኮ ሊጉሬን ሳኒ ታእባዶ ዱባ ቶ ጎጎሌቶ ሂካ ካአቲ ሀልቻ ፈሎይ ጎጎሀይስራኑን ጎሳ ካሻድሳሮያ።</para>
  <para style="ip">ሀንዳ ካኤፈሶኒ ታሆራርጄ ባንኤ ጻፍት ራቶናትኮክ ጋራ ታሀጋበሮ መተት ቆፋ ባላኣሳ፥ ዋ ኦዶ ጎሳኬሳ ምሲ አሳባተሮ፥ ኤረኬሳ የሱሳ ክርስቶሳ ጩቦክሶዉን ሀሄሶ አማማኖ ሄላቴረን ምሲ እሶ ባልቻኒዕ ሌራን፥ ካአቲ ካአብዲ ሃፉራ ካዋ አያና ቁሉኮክ ጋራነ ምሲ አዴሳመሮ ቱሳራ፥ ታላም ባንኤ አደ ጻፍት ኦናባባራን ራቶክ ግርክሶይ ክርስቶሳይ ካአባን ራቶናት ካሩም ጎጎሌሮ እሶ ምሲ ግርን ዶትሳሮ ሻድሳራ።</para>
  <para style="ip">እባዶ ክርስቶሳነ ዎታ ታአቦ ኤሴላ ምሲ ራቶናት አቦ ካለካለክ ለፍኮ ቤ ካአዬሳማሮ አዬሲ ሙተራ፥ ምን ካዋ ማር ማለ ጎሌሮ ክርስቶሳ አደ ማርኮክ መተ ማሌያ፥ ምን ካዋ ግምበ ኣን ጎሌሮ ክርስቶሳ አደ ምኑን ምና አፋሩን መተክ ኤኤሞያ፥ ምን ካዋ ኦር ማለ ጎሌሮ ክርስቶሳ አደ ኤንተርያ፥ ጻፍት ጋራ ካክርስቶሳነ ታሙተቶ ስኖ ታዋ ኣሎ ሳድሳ ካኮአዬስሮ ጎራታ ጎላተ ካግሮ አየስ ቱሳራ፥ አየስ ዱባ ኡሱ ካኮደያራ ታክርስቶሳ ጌላንጄ፥ ጃርሶ ላኖኬሳ፥ ሀሄሶ አማኖ፥ ስኖና ኖጎዳኮክ ጋራነያ</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="EPH 1:1-2">1፡1-2</ref> </char></para>
  <para style="io1">ክርስቶሳና ምን ካዋና <char style="ior"><ref loc="EPH 1:3-3:21">1፡3—3፡21</ref> </char></para>
  <para style="io1">ክርስቶሳ ካሄላማሮ ግር ካኡሱብ <char style="ior"><ref loc="EPH 4:1-6:20">4፡1—6፡20</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="EPH 6:21-24">6፡21-24</ref> </char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />ፈኢ ታዋይ የሱሳ ክርስቶሳይ ካፋራመሮ ጳዉሎሳኮ፥ የሱሳ ክርስቶሳ ኦአብዳሜራን፥<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="ACT 18:19-21">ኦፋ. ፈ. 18፡19-21</ref>።</char></note></para>
  <para style="p" vid="EPH 1:1">ታኤፈሶን ካታማይ ኦግራን ቁሎሌዉን፥<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />ዋ ኣቦካን ጎታ የሱሳ ክርስቶሳኮት ስኖና ኖጎዳ እስኑን ሀሌቶ።<verse eid="EPH 1:2" /></para>
  <para style="s1">ክርስቶሳ ኦሄላማራን ሶማ ኦአያና</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />ዳሩሪ ኦግራን ሶማ ኦአያና ዱባ ክርስቶሳ ኖ ካሶማሳተራ ጎታካንክ የሱሳ ክርስቶሳኮክ ሄዶና ኦዶ ካሌራ ዋ ሀጋላታሞ። <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />ቁሉኒዕና ቱፍ ካላይኒዕ ልኔ ጌላንጄ ኡሱ ሆረ ጎጎሙንቶ አላም ሀመጣሞን ግራን ሆራርጀ ክርስቶሳ ኖ አሳበ። <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />ፈኢ ታዋ ታኢዳን ሌተደ የሱሳ ክርስቶሳን ይስ ጎጎሌኖን ጣየ ሙርተሴ። <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />ህክና ካጌላመሮ ኤረኬሳክ ጋራነ ዳናባ ኖን ታስሰሮ ታካባጃንተቶ ስኖ ጎጎሶማሳንቶያ። <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />ስኖ ታዋኮክ አማጋማኖኮ ካከይ ኤረኬሳክ ኢግ ዎዶ ሌነኔ ጩቦካንኮና ሀሄሶ አማማኖ ሄላነ።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="COL 1:14">ቆላ. 1፡14</ref>።</char></note> <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />ስኖቴሳ ቃሩማና ማላባኖ ዱባ ጂናሰ ኖን ስሰ። <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />ዋ አንጅረተሳ ክርስቶሳኮክ ጋራነ ጣየ ጎጎሀልቼሮክ ማለ ፈኢቴሳት ሆል ጎጎአዴንሶ የለ። <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />ጎራታ ጎጌ ዋ ፈሎ ጉት ካሃይስናራ ሀልቻ ዳሩርና ኡሊ ታግታ መጣ ዱባ ራቶ ኮ ካክርስቶሳ ኦዶናት ሄገሊ ጎጎግርቶንያ።<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />አየስ ዱባና ፈኢቴሳ ካፈላራ ዋ ጣየ ጎጎሄደሮ ማለ ካክርስቶሳኮክ ጋራነ ኡናቴሳ ጎጎሌኖን ኖ አሳበራ። <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />ህክና ካኮንሌራ ክርስቶሳ አብድ የላታ ኦሆሬ ኦሌነና ካባጃ ታዋ ጋላታኖይ ጎጎቱንሶንያ።<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />እስና ፋይናክስንኮት ኦዱ ታኢዳን ካሌሮ ሃፉራ ካሩም ካኮማልቴን ጎራታ ክርስቶሳ አማንቴታን፥ አደና፥ ኡሱ እስኑን ስስን አብድ ጎጎስሰሮ አያና ቁሉክ አታማንቴታን። <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />ህክና አያና ካባጃተሳዉን ጋላታ ጎጎጌሮን ዋ ኦቴሳ ኦሌራን ዱባን ታ ዎዶ ሌሮ ሄላይን ታግኖ ርትታንዉን ቃብዶታንያ።<verse eid="EPH 1:14" /></para>
  <para style="s1">ጳዉሎሳ እባዶ ካኤፈሶንን ኤባተ</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />ሃንሱን ጎታ የሱሳ እስን ካአብታን አማኖና ቁሎለ ዱባዉና ታአብታን ጌለንጀ ታኮማለ አርኮ ሀጋአበረ፥ <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />አን እስን ኤቢ ሻዳ እስን ማራን ዋዉን ጋላታ ስሳኖ ላኮኢሰሮ። <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />ካባጃ ካኮንዶትሳሮ ጎታካን ካየሱሳ ክርስቶሳኮክ ሄዶ ካሌሮ ዋ ኣሎ ጎጎአዴሳኑን አያና ካዋኮ ታሌተቶ ቃሩማና ሙተን እስኑን ጎጎስስሮ አን ኤባታራ። <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />እስን ምስት አብዲ ኡማንቴታና ቁሎሌል ታኤልናራ ታካባጃ ርቲ ኤግታት ታሞጋንቶ እስን ጎጎአዴሳኑን ዎዳናትስንኮኒዕ ኢልኦ ጎጎዴንደናዉን አን ኤባታራ። <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />ኖ ዋ ኦአማናኖን ዱባንኮ ካአቲ ካሌሮ ሁናከሳ ጎጎማላብታኑን አን ኤባታራ፥ ሂክ ሁናና ኡሱ አን ካአቲ አታንኬሳክ ፈሎይ፥<note caller="-" style="x"><char style="xo" closed="false">1፡19 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዛ. 110፡1</ref>።</char></note> <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />ክርስቶሳ ጎይኮ ኬሰረ ታዳሩረ ባንኤ ምና ታመርጌ ሀማጽሳ ሙተራ። <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />ዋ ኦዶ ክርስቶሳ ዳሩሪ መርገቴሳይ ካሀማጺሰራ ማምስክ ቃላዳኮና ኦዶናት ሁናኮና ጎታናትኮ ኡሱማለና ሂካ ካግዳኔ ጌስ ካላል አንሌኖን ካኤሜይናሮ ጌሲ ጎሌና መገ ዱባኮ ካሮራሮ ካካባጃመ መገ ስሳኖይያ። <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />ዋ አየስ ዱባ ኦዶናትኬሳ ሄገሊ ባሪሰ፥ ምን ካኤብና ዱባንኮ ካሮራሮ ጎጎሌሮ መተ የለ ሹመ።<note caller="-" style="x"><char style="xo" closed="false">1፡22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">ማዛ. 8፡6</ref>።</char></note> <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />ምን ካኤብ ካክርስቶሳ ማርያ፥ ክርስቶሳና ምን ካኤቢና ባንኤ ዱባ ካመን ዱባ ካአማጋሮ አማጋማኖኬሳያ።<note caller="-" style="x"><char style="xo" closed="false">1፡23 </char><char style="xt" closed="false"><ref loc="COL 1:18">ቆላ. 1፡18</ref>።</char></note><verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s1">ክርስቶሳይ አርዶኒዕ ላኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />እስን ባስክስንና ጩቦክስንኮት ኣላንቲ ጎቴን ግቴን። <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />ኡሱ ጎራታ ሂካ አላምኮክ ራ ካሜላን ሰሴታ ግቴን፥ ኡሱማለና አምባል ጉት ኦግራን አያናጆል ካሜላንኮክ ሁናጆል ካባሪሳሮን አጃጃማ ግቴን፥ ኡሱና ካአጃጃሞን እባዶ ጉት ካፈላሮ ባቲክ አያናያ። <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />ኖ ዱባና ሂታኮ ሆረነ እሶ ጠኤ ፈኢ ታሶየትና ሳሙታንኮክ ያዳ ዴበ ሰሴታ ሀልቻካን ካሶየት ግኔ፥ ኖና ካካለ ኣን መጣታኒ ኤንገ ታዋ ሄገሊ ግኔ።<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />አየሱን ጎአመን ሻጋከሳ ዱረሳ ካሌራ ዋ ኖን ታአቦ ታአቲ ጌላንጀኮ ካከይ፥ <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />ባስካኒ ኦጎነ ሌነ ግራን፥ ዋ ክርስቶሳ አርዶኒዕ የለ፤ እስን ካኮፋይቴታን ስኖቴሳይያ።<note caller="-" style="x"><char style="xo" closed="false">2፡5 </char><char style="xt" closed="false"><ref loc="COL 2:14">ቆላ. 2፡14</ref>።</char></note> <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />ዋ ክርስቶሳነ ዎታ ኖ ጎይኮ ኬሰራ፤ ክርስቶሳ የሱሳ ባንኤ ታዳሩረት ኖ ኡሱነታ ሀማጺሰራ። <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />ህክና ካኤሜታሮ ጌሲ ክርስቶሳ የሱሳ ኖን ታቱሰሮ ሜሳ ካላይት ስኖኮት ዱሩማ ቱስንያ። <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />እስን ካኮፋይቴታን ካአማኖ ጋራነ ስኖይያ፥ ህክና እላቦ ካዋያ ኳሬ እስንኮ ላኮዮ። <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />ማዮና ጎጎጣዳኖንኮ ታፋይና ስኖ ካኮሄላንተታ ፈሎይ ላኮዮ፤ <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />ኣላንቲና፥ ዋ ጣየ ኖን ኦኤካሰሮ ፈሎ ኦኢዳን ጎጎፈልኖ ክርስቶሳ የሱሳ ኦመጣምነኖ መጣ ታዋና።<verse eid="EPH 2:10" /></para>
  <para style="s1">ክርስቶሳ ኮ ላኖ</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />ሃንሱን እስን ጣይተን አላታኒ አይዛብ ኦሌቴታን፥ አይሁድ ገነ ታእባዶይ ሀማጺሳማኖ ዳታ እስን ኦሀማጺሳሞንግታን አማ እስን ሀባራ ካግሬን ሻዳ። <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />ኡሱ ጌሲ ክርስቶሳኮ ካለቤተዴን፥ እስራኤልነ ዎታ ኡናላናኮ ፋክንቴዴን ታአማቶ አብዲን አላግጋቴን፤ አላም ጉት አብድ ካላይና ዋ ካላይ ጎጎግቴን ሻዳ። <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />ግዳ ጎአመን እስን ሂታኮ ሆረነ ፋክንቴን ኦግቴን የሱሳ ክርስቶሳ ሌተዴን ኢግኬሳ ጋባላንቴታን።<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />አይሁድና አይዛብና ኮ ካየላራ፥ ካለካለ የልተ ታግቴ ታኤንጌ ግሞ<note caller="+" style="f"><char style="fr" closed="false">2፡14 </char><char style="ft" closed="false">ታኤንጌ ግሞ ካአማራ ሃፉራ ካቱሳራ አይሁድና አይዛብ ጠኤ ካግረ አማኖኮክ ካሌና ቱሳራ። </char></note> ካዲገራ ኖጎዳካን ኡሱያ። <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />አጃጃ ካሴራ ዎጋነ ዎታ ሶኦቴሳ ትረ። ያዳኬሳና ጎሳ ላማኮ ኮ ካኡሱብክ እባዶት እሲ መጣረ ኖጎዳ ካዪንያ። <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />ማስቃሊ ጉት ጎዋኖይና ዲናናት ትረ፥ ላማ ዱባና ማር ኮ የለረ ዋኔታ ዎጋርሰ።<note caller="-" style="x"><char style="xo" closed="false">2፡16 </char><char style="xt" closed="false"><ref loc="COL 1:20">ቆላ. 1፡20</ref>።</char></note> <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />ኤመተጉረ ፋክንቴን ኦግቴን እስኑና፥ ጋባላመ ካግረ አይሁድን ካኖጎዳ ዎንጋላ ላላበ።<note caller="-" style="x"><char style="xo" closed="false">2፡17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">ኢሳ. 57፡19</ref>።</char></note> <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />ኖ ዱባና ጋራኬስነ አያናኮይ ኦዶ ቶስ ጋባላሚን ዳንዴነና።<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />ሂካኮ ካከይ እስን ቁሎለ ዎታ ኡል ኮክ እባዶታን፥ ዋዉን ካምነ እባዶታን ኳሬ፥ ጎርታ ሂታኮ ዳንቤባን ኡል ካእባዶኮክ እባዶና ማርት ላኮታን። <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />ኦፋራሜራኒና ካሄገሮልኮክ ኡኩሚ ባተታን። ምና አፋሩን ልበ ካሌራ ክርስቶሳ የሱሳያ። <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />ልበና ምን ዱባ ራቶ ኢንሰአባይረ ካጎታ ቁሉክ ምን ካዋ ሊን ጂናታራ። <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />እስን አዴን ዋ አያናኬሳይ ካኮባራሮ ምን ሊን ራቶ ክርስቶሳ ግምባማታን።<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s1">አይዛብን ካፋራመ ጳዉሎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />ህታ ኣላንቲ አን ጳዉሎሳ የሱሳ ክርስቶሳን ካሽያመ ካኮንሌራ እስን አይዛብን ማራንያ። <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />ላኦ ታትስን ማራን ኢን ታስሳንተቶ ስኖ ታዋ ሀንዳኖኬ ኦግራን ማልቴታን። <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />ጣየ ጋባቢና አን ጎጎጻፈሮ፤ ዋ ሆልቴሳ አዴስሰ ራጋይ ኢን ቱሰራ። <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />ጎርታ እስን ሂካ ናባባ ግራን፥ ታክርስቶሳ ሆል አን ምስምሲ ሻዳሮ አዴስን ዳንዳታን። <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />ህት ሆል ቁሎለ ኦፋራሜራዉና ካሄገሮሉን ግዳ ካሙተሮ ግታክ ካሆርኮ እባዶን ላኮሙተረ። <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />ህት ሆል፥ አይዛብ ጋራ ካዎንጋላነ እስራኤልነ ዎታ ራቶ ኦኤልናራን፥ ማር ኮክ ምክታል ሊሬን ኡሱማለና የሱሳ ክርስቶሳ ታሌተቶ አብዲ ራቶ ኦሄዴዳማራን ላኖይያ።<note caller="-" style="x"><char style="xo" closed="false">3፡6 </char><char style="xt" closed="false"><ref loc="COL 1:26-27">ቆላ. 1፡26-27</ref>።</char></note><verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />ዋ ሁናኬሳኒዕ ፈሎይ ኢን ካስሰሮ ካስኖ እላቦ አንና ሂካ ዎንጋላን ካሀንዳሮ ሌራ። <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />ማምሲና አን አደ ቁሎሌል ዱባኮ ካየራታሮ ጎሌና፥ ታቆቆራሞን ዱሩማ ታክርስቶሳ አይዛብን ጎጎላላብሮን ህት ስኖ ኢን ስሳንተ። <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />ኡሱማለና ዱባ ካመጠሮ ዋይ ካሮረሮ ጌስጆል ስያሜን ኦግራን ሂናኣ ፈሎ ኮኒዕ ሆል ዱባን ጎጎቱስሮ ኢን ስሳመ። <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />ያዳኬሳና ጌስ ካአርካኔቲ ምን ካዋኮክ ጋራነ ምዲ ታሞጋን ታአብቶ ቃሩማ ታዋ ባንኤ ታዳሩረት ኦግራን ዎይቻሉና ኦዶናት ኦአባዉን ጎጎአዴሳንቶንያ። <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />ህክና የሱሳ ክርስቶሳ ጎታካን ካፈለሮ ጅሩ ጅሮማክ ሀልቻ ማሌያ። <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />ኡሱና ኡሱ ጉት ካግሮ አማኖኮክ ጋራነ፥ ባልቹማና ጃቡ ታአብቶ ዎዳና ዋ ቶስ ጋባላሚን ዳንዳና። <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />ሃንሱን ካባጃትስን ካሌሮ እስን ማራን እን ታጌተቶ ራኮይ አብድ ጎጎ ጎሳኖንኮ ሀዳራ አማራ።<verse eid="EPH 3:13" /></para>
  <para style="s1">ኡል ካኤፈሶንክ አማኒሉን ካኤባመሮ ኤብ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />ጎርታ አን ዋ ኦዶ ሆረ ግልብኬይ ግልቢሰረ ካኮንኤባታራ ህታ ኣላንቲንያ። <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />ዳሩርና ኡሊ ካግራ ምን ኮክ እባዶ መተመቴ ዋኮ መገ ሄላይናራ። <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />ማር ካኦሮ ካክስኒ ጎጎአታታኑን፥ አያናኬሳኮክ ጋራነ ካባጃቴሳት ዱሩማና ሁና እስኑን ጎጎስስሮ ኤባታራ። <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />ህክና አማኖ ክርስቶሳ ዎዳናትስኒ ጎጎባርሮያ። አደና ህዲድ ዳግስዴነ ጌላንጄ ባይዴነ፥ <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />ታክርስቶሳ ጌላንጀ ባላኣና፥ ኤራና፥ ጦቂማኖና ቦላና ኤግታክዮ ቁሎለ ዱባነ ዎታ ካኮአዴሳንኮክ ሁና ጎጎሄላታዉንያ። <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />ሂካ ማላባኖ ካእባዶኮ ታሮርተቶ ጌላንጀ ታክርስቶሳ ጎጎአዴሳዉን አማጋማኖ ካዋይ አማጋሚን ጎጎኤካታዉን አን ኤባታራ።<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />ጎርታ ኖ ኦሮ ጎጎፈላሮ ሁናኬሳኮክ ጅልባ ማለ ካኤባታኖኮ ጎርቱን ካሄዳታኖ ዱባኮ ኣሎ ሮርስ ፈልን ካዳንዳሮ፥ <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />ምን ካዋ ኦሮ ኡሱማለና የሱሳ ክርስቶሳይ፥ ጌስጆል ዱባ ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮን ካባጃ ኡሱን ሀሌቶ ሀሚኒዕ።<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s1">ክርስቶሳይ ማር ኮ ላኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />ጎርታ ጎታዉን ሀንዳኖይ ካሽያመ ካሌራ አን፥ እስን ታኮኡማንቴታን ኡምቲ ካዶትሳሮ ግር ጎጎግርታኑን አን እስን ኤባታራ። <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />ጌላንጄ እስእስኦሮ ኦብሳ አርጌቶ ፋያንካኒዕና ኦኢዳን ላ፤ ጌላንጄ እስእስኦሮ ዳንዳኖ ግራ።<note caller="-" style="x"><char style="xo" closed="false">4፡2 </char><char style="xt" closed="false"><ref loc="COL 3:12-13">ቆላ. 3፡12-13</ref>።</char></note> <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />ካኖጎዳ ሽያማኖ አያናኮክ ራቶናት ኦራይን አታዬን። <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />ካኮኡማንቴተን ጎራታ አብድ ቶዉን ጎጎኡማንተታን ማለ ማር ኮና አያና ኮያ ካግራ። <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />ኡሱማሌ ጎታ ኮ፥ አማኖ ኮና ጥንቃታ ኮያ ካግራ። <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />አደና ዱባንኮ ካሮራራ፥ ዱባ ጉት ካፈላራ፥ ዱባ ጉት ካግራ፥ ዱባን ኦዶ ካሌራ፥ ሄዶ ኮያ ካግራ።<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />አየሱን ጎአመን ክርስቶሳ ስስን ጎጎሙርተሰሮኮክ ጅልባ መተመቴ ስኖ ኖን ስሳንተታ። <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />ሃንሱን፥</para>
  <para style="q1" vid="EPH 4:8">“ኤለዴ ካኮቤረ ጎራታ፥ ኦቦጃሜራን ቦጄ፥</para>
  <para style="q2" vid="EPH 4:8">እባዶዉና እላቦ ስሰ” ጎጎአማመሮያ።<note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">ማዛ. 68፡18</ref>።</char></note><verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />ሀያ ሂክ፥ “ኤለዴ ቤራ” አማኖ አደ ኡል ቶስ ሄገልዴ ዳገራ አማኖ ጎሌ ኳሬ ካካለ መ አማኖያ? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />ሄገልዴ ካዳገራ፥ መጣ ዱባ አላም ጎጎአማጋንቶ ኤለ ዳሩርኮ ካኤመተራ ኡሱ ኡሱዋያ። <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />ኡሱና ኮኮ ኦፋራመራን፥ ኮኮ ሄገሮል፥ ኮኮና ዎንጋላ ኦላላባራን፥ ካካለ አደ እባዶ ካዋ ኦፎፋራና ኦአጋልስሳራን ጎጎሌራዉን እላቦል ካስሰራ ኡሱያ። <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />ህክና ካክርስቶሳ ኡና ካሌረ ምን ካዋ ጎጎባሮ፥ እባዶ ካዋ ሀንዳ ካዋቱን ኤካስንያ። <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />ህክና ካኮንልናራ፥ ኖ ዱባና ኤረ ካዋ አማናኖና ማላባኖን ካሄላማሮ ራቶናት ቶስ ኤሜታኖና ካንጅንክ እባዶ ላኖ፥ ክርስቶሳ ካሄላማሮ አማጋማኖ ቶስ ታጌኖንያ። <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />ጎርታ ታእባዶ ሚጌይ ሽርሳኖና ሶባንጄ ካኤካተሮ ካሽርሳሮ አጋልስሲ አምባል ኢርጋዶይ ሀሴራ ሂታራ ሻፋመረ ካኢያሮ ይስ ኣን ላኮሌኖ። <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />ሃ ካላሮኮ ሩም ጌላንጄይ አዬሳ ካአመን ዱባን መተ ካሌሮ ክርስቶሳ ቶስ ጂናይናና። <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />ካለካለክ ካማሬ ምክታጆል ካኮኤሰላራ ክርስቶሳያ፤ ማር ዱባ ካኮአባመራ ምክታልኬሳይያ፤ ሃንሱን መተመቴ ካማሬ ምክታ ኡሱን ኦስሳሜራን ፈሎ ጎፈሎ ማር ዱባ ጂናታራ፤ ጌላንጄና ባታራ።<note caller="-" style="x"><char style="xo" closed="false">4፡16 </char><char style="xt" closed="false"><ref loc="COL 2:19">ቆላ. 2፡19</ref>።</char></note><verse eid="EPH 4:16" /></para>
  <para style="s1">ክርስቶሳ ካሄላማሮ ካኡሱብክ ግር</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />ጎርታ ያዳክሶ አዳክ ካሌሮ አይዛብ ኣን አሮግርተን አመ መገ ካጎታይ ሴራራ፤ <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />ሳሙትሶ ዱደታ፤ ማላባኖዋትና ጢበትሶኮት ኣላንቲ ዋ ካስሳሮ ግርኮ ፋክመራን። <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />እሶ ሙላ ማንኮዋተን ማራን ባቲክ አየስ ዱባ ፈልን እስኦትሶ ሀልቻ ካሶየቱን ሮርሳተን ስሳቴን።<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />እስን ጎአመን ክርስቶሳ ካኮአዴሴታን ሂካ ኣንክክ ራድ ላኮዮ። <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />ኦግራን ጋራኬሳ ማልቴታን፤ የሱሳ ታግቶ ሩምና ኡሱኮ አጋልሳተታን። <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />ሃንሱን ሶበረ ጩቦ ቶስ ካጌሳሮ ሀልቻ ካሜላን ጣይተን ካኮግቴን፥ ታዶአንት መጣኮት ያዳሊ ትራ።<note caller="-" style="x"><char style="xo" closed="false">4፡22 </char><char style="xt" closed="false"><ref loc="COL 3:9">ቆላ. 3፡9</ref>።</char></note> <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />ሳሙትስና ዎዳናትስን ሀኡሱባቶ። <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />ካሩም ሙጭአማኖና ቁሉማ ማሱሳ ካዋይ ካመጣመሮ ካኡሱብክ ማር ሳርሳዬነ።<note caller="-" style="x"><char style="xo" closed="false">4፡24 </char><char style="xt" closed="false"><ref loc="GEN 1:26">መጣ 1፡26</ref>፤ <ref loc="COL 3:10">ቆላ. 3፡10</ref>።</char></note><verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />ሃንሱን ጣራ አሮአዬሴን፤ ኖ ዱባና ማርኮክ ምክታል ማንኮሌረን ማራን እስእስኦሮ ሩም አዬንሳ።<note caller="-" style="x"><char style="xo" closed="false">4፡25 </char><char style="xt" closed="false"><ref loc="ZEC 8:16">ዛኪ. 8፡16</ref>።</char></note> <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />ሀድሳ! አየሱን ጎአመን፥ “ጩቦ አሮፈልቴን” ጎጎአማመሮ፥ እስን ኢኦቴን ግራን አርት አሮኢኖ።<note caller="-" style="x"><char style="xo" closed="false">4፡26 </char><char style="xt" closed="false"><ref loc="PSA 4:4">ማዛ. 4፡4</ref>።</char></note> <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />ዱርሳ ካኮታብሮ ባንኤ አሮስሴን። <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />ሄታ ካግረ ሂታኮ ሆረንባን አሮሄቶ፤ ሃ ካላሮኮ ካራካተዉን ስስን ማራጋደ ጎጎዋታሞንኮ ገነቴሳ ካእዳንክ አየስ ሀፈለ። <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />ህኢትስንኮ ካሜላን አየስ ዱዶ አሮቤኖ፤ አየሱን ጎአመን ኦማላራዉን ካገገላይስሮና ሙጭስን ካጋርጋሮ እባዶዉና ካዶትሳሮ ሃፉራ አዬሳ። <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />ዎዶ ታኮበያታን አሪ አቶ እስኑን ጎጎሌሮ ካኮአታማንቴታን አያና ካዋ አሮቁቃምሴን። <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />ኦኮኮንጄ፥ አማራን፥ ኢኦ፥ እያ፥ ሀባርና፥ ማምስት ሜላነና ዱባ እስንኮ ፋክ ሀአንቶ። <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />ሃ ካላሮኮ እስን እስስኦሮ ኦኢዳኒዕና ሹጎኒዕ ኦነኔኤይሳታን ላ፤ ዋ ክርስቶሳ ሀሄሶ እስን ጎጎአምሮ እስና እስእስኦሮ ሀሄሶ አማ።<note caller="-" style="x"><char style="xo" closed="false">4፡32 </char><char style="xt" closed="false"><ref loc="COL 3:13">ቆላ. 3፡13</ref>።</char></note><verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s1">እፋ ኦሮ ግራኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />ጎርታ ካጌላመሮ ይስ ኣን እስና ማሱሳ ካዋይ ሰሴን። <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />ክርስቶሳ ኖ ጎጎጌላተሮ ዋ ካጌገላይስሮ ታኢዳንት ኡርት ካአቦ ሜባና ጃርሶ የለ ግርኬሳ ኖ ማራን ሮርሳተ ጎጎስሳተሮ እስና ጌላንጄ ግራ።<note caller="-" style="x"><char style="xo" closed="false">5፡2 </char><char style="xt" closed="false"><ref loc="EXO 29:18">ብያ. 29፡18</ref>፤ <ref loc="PSA 40:6">ማዛ. 40፡6</ref>።</char></note><verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />ሂካ ኣንክክ አየስ ቁሎሌዉን ማንኮዶትሶን ማራን ሻርሙጡማ ጎርቱን ማምስክ ካባቶየ ኮኮና ጎርቱን ጋጲጋጳኖ ዱዶ እስን ዶሌ አሮማልሳሞ። <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />ሃ ካላታንኮ ዋዉን ጋላታ ስሳ ኳሬ ካቁቃምስሮና ካጎዉማ አየስ፥ ጎርቱን ካቆስ አየስ አዬሳኖ ላኮዶትሳሮ፤ ሂካ ኣንክክ አየስ እስኑን ላኮዶትሳሮ። <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />ሻርሙጡማ ጎሌተና፥ ማምስክ ባቲክ አየስ ካፈለሮ ጎሌ፥ ጎርቱን ቶልቻ ሄዶይሳታኖና ጋጲጋጳኖ ጎሌ፥ ክርስቶሳና ዎኖናት ካዋይ ርቲ ካሄላኖን ላኖ አዴሳ።<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />ሂካ አዬስኮት ኣላንቲ ካአጃጃሞን እባዶ ጉት ኤንገ ታዋ ማንኮኤሜይናቶ ማራን ማዮና ካማድኖን አዬሲ እስን አሮሶቦ። <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />ሃንሱን ሂካ ካአጃጃሞን እባዶነ ዎታ አሮ ሌተን። <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />ጣይተን እስን ሙጉዲ ግቴን፤ ግዳ ጎአመን ኦጎታ ማንኮሌተን ማራን ኢፋታን፤ ሃንሱን ኢፋ ካግሮ እባዶ ኣን ሰሴየነ። <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />ታኢፋ ኢል ኢዳነ፥ ቁሉማና ሩሚ ዱባ ዶሌ ግታ። <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />ሃንሱን ጎታ ካገገላይስራ አየስ መዮ ቆቆራ። <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />እፋ ቶስ ቤሳዴን ቱሳ ኳሬ ኢል ካላይኒዕ ኦሙጉድ ፈሎኔ ዎታ ማምስት ኤሰላና አሮግኖ። <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />ሙጉዲ ካግራ እባዶ ስያመ ካፈላሮ አየስ አዬስን ሙላራ። <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />ካአመን ዱባ ኢፋ ቶስ ጎቤሮ ታሩም ምዲ ዲዳ ቤ ሙታታ። <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />ኣላንትና አየስ ዱባ ጎጎሙትሮ ካየላራ ኢፋያ፤ ሃንሱን፥</para>
  <para style="q1" vid="EPH 5:14">“አት ካሁዱራታ ናባድና!</para>
  <para style="q2" vid="EPH 5:14">ጎይኮ ክ ክርስቶሳ ኩን ሃንቃይስናራ” አማመራ።<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />ጎርታ ምሲ ግርናታን እስኦራዬን ሻዳ፤ ቃሩማ ካአቦ ኣን ኳሬ ጎዎሌ ኣን አሮግርተን። <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />ሂክ ጌስ ካሜላንክ ማንኮሌ ማራን ማጎሬና ታኤሰላቶ ኤሴላ ላኦ ብያ።<note caller="-" style="x"><char style="xo" closed="false">5፡16 </char><char style="xt" closed="false"><ref loc="COL 4:5">ቆላ. 4፡5</ref>።</char></note> <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />ሃንሱን ፈኢ ታዋ መቶ ሻዳ ኳሬ ጎዎሌ አሮሌተን።<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />አያና አማጋማ ኳሬ ጣሞ ካዎይኒት አሮሰትቴን፥ ህክና ዳርአታኖያ። <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />ማዛሙርና ሄዶይሳታኖ፥ ካአያና ያየ እስ እስኦሮ አዬሳ፤ ዎዳናትስኒ ጎታ ጋላታ። <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />ጎታካን የሱሳ ክርስቶሳኮክ መገ ካአመን ዱባዉን ዋ ኦዶ አርጌቶ ሶማሳዬን።<note caller="-" style="x"><char style="xo" closed="false">5፡20 </char><char style="xt" closed="false"><ref loc="COL 3:16-17">ቆላ. 3፡16-17</ref>።</char></note><verse eid="EPH 5:20" /></para>
  <para style="s1">ካኦርና ካኤንተሬኮክ ጋራ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />ታክርስቶሳ ካባጃን አማዴነ እስእስ ኦሮ ኮ ካካለቱን አጃጃማ።<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />እስን ኦርጆል! ጎታ የሱሳን ጎጎአጃጃማታን ማለ ኤንተርጆልክስኑና አጃጃማ።<note caller="-" style="x"><char style="xo" closed="false">5፡22 </char><char style="xt" closed="false"><ref loc="COL 3:18">ቆላ. 3፡18</ref>፤ <ref loc="1PE 3:1">1 ጴጢ. 3፡1</ref>።</char></note> <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />ክርስቶሳ ምን ካዋ መተ ጎጎሌሮ ኤንተርና ኦርዉን መተያ፤ አደና ክርስቶሳን ማር ካኮሌሮን ምን ካዋኮክ ፋይናያ። <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />ምን ካዋ ክርስቶሳን ጎጎአጃጃማሮ ኡሱማሌ ኦርጆል ካአመን ዱባ ኤንተርጆሉን ሀአጃጃመ።<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />እስን ኤንተርጆልና! ክርስቶሳ ምን ካዋ ጎጎጌላተሮና እስኦቴሳ ሮርሳተ ጎጎስሳተሮ እስና ኦርጆልክስን ጌላየነ።<note caller="-" style="x"><char style="xo" closed="false">5፡25 </char><char style="xt" closed="false"><ref loc="COL 3:19">ቆላ. 3፡19</ref>፤ <ref loc="1PE 3:7">1 ጴጢ. 3፡7</ref>።</char></note> <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />ክርስቶሳ ሂካ ካኮንየለራ ምን ካዋ ሙጭስን ዶተረያ፤ ካኮሙጭሰራና ጋራ ካሃፉራነ በከይ ኣልሰረያ። <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />ሂካ ጋራይ ምን ካዋ ጦርቀ ጎርቱን ሆረ ሜልልሳኖ ጎርቱን ሂካ ኣንክክ ካካለ ካሜላን አየስ ሀሙቶን ቁሉት፥ ኮና አየስ ካላይትና ታኢዳንት የላተ እስ ቶስ ጋባላታራ። <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />ኡሱማለና ኤንተርጆል እስኦትሶ ጎጎጌላታራንክ ማለ ኦርጆልክሶ ጌላታኖ ዶትሳራ፤ ኦርቴሳ ካጌላታራ እስኦቴሳ ጌላታራ። <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />ማርኬሳ ካዲዳራ ማዮና ላግሮ፤ ዱዶዋ ክርስቶሳ ምን ካዋቱን ጎጎየላሮክ ማለ እስኦቴሳ አምሳታራ፤ ካርካራታራ። <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />ኖና ካክርስቶሳ ማርኮክ ምክታጆልና። <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />ሃንሱን እባዶ ኣቦኬሳና ኣየቴሳና ኢሰረ፥ ኦርነ ዎታ ቁራናማራን፤ ላማ ዱባና ማር ኮ ላራን።<note caller="-" style="x"><char style="xo" closed="false">5፡31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መጣ 2፡24</ref>።</char></note> <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />ህት ሆል ታአቲ ሆልታ፤ ሂካና ካአማራ ክርስቶሳ ማራና ምን ካኤብ ማራን ማሱሳ የለረያ። <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />አየሱን ጎአመን ሂክ አየስ እስና ፋካታራ፤ ሃንሱን ኤንተር ኦር እስኦቴሳ ኣን የላይረ ሀጌላቶ፤ ኦርና ኤንተርክሴ ሀካባጂቶ።<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s1">ኦኡሙለራና ይስኮክ ጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />ይሶ! እስን ኦኡሙለራዉን ጎታይ አጃጃማ፤ ሂክ ካዶትሳሮያ።<note caller="-" style="x"><char style="xo" closed="false">6፡1 </char><char style="xt" closed="false"><ref loc="COL 3:20">ቆላ. 3፡20</ref>።</char></note> <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“ኣቦካና ኣየታና ካባጂና” ካአማራ አጃጃ ካአብዲ ሃፉራ ካኮግራ ካሆራርጄ አጃጃያ። <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />ሂካ ካአብዲ ሃፉራና፥ “ካአመን ዱባ ኤካሮዋ፤ ሂካ ኡሊና ጌስካካ ኤራሮዋ” ካአማሮያ።<note caller="-" style="x"><char style="xo" closed="false">6፡3 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ብያ. 20፡12</ref>፤ <ref loc="DEU 5:16">አዳ. 5፡16</ref>።</char></note><verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />ኦኡሙልቴታና! እስና ጎታ የሱሳ ዎጋ አጋልስሳኖይ፥ ቱኩል ኡምሳና ሀድሳ ጂናሳ ኳሬ ይስክስን ኢኦይ አሮማራርሴን።<note caller="-" style="x"><char style="xo" closed="false">6፡4 </char><char style="xt" closed="false"><ref loc="COL 3:22-25">ቆላ. 3፡22-25</ref>።</char></note><verse eid="EPH 6:4" /></para>
  <para style="s1">ጎታጆልና ድይጆልኮክ ጋራ</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />እስን ድይጆል! ክርስቶሳን ጎጎአጃጃማታን ኡሊ ጎቶሌ ኦሌራኑን ካባጃይና አብሲ፥ ዎዳና ቱኩልቲ አጃጃማ። <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />እስቱሳይና እሶ ዶሌ ሳዳሚን አሌኖን ግራን ካክርስቶሳ ድይጆል አን ፈኢ ታዋ ዎዳናኮ ፈልን አጃጃማ። <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />እባዶ አንሌኖን ግራን ጎታዉን ካሀንዳታን ላኖ አዴሳዴን ፈኢትስኒ ዎዳናኮ ሀንዳ፤ <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />ኣላንትና፥ ድይና ሌረ ባልቻክ እባዶ ካፈላሮ ካእዳንክ አየስ ዱባ ባርኣራ ጎታኮ ካአታይናሮ ላኖ ካሳንዋ።<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />እስን ጎቶሌ! እባዶ ሆረ ካኡሉልሶን ካክስና ካክሶ ጎታ ዳሩሪ ካግሮ ሻዳ፤ አብሲሳኖ ኢሳዴነ ድይልክስኑን ኢዳነ ፈላ።<note caller="-" style="x"><char style="xo" closed="false">6፡9 </char><char style="xt" closed="false"><ref loc="DEU 10:17">አዳ. 10፡17</ref>፤ <ref loc="COL 3:25">ቆላ. 3፡25</ref>፤ <ref loc="COL 4:1">4፡1</ref>።</char></note><verse eid="EPH 6:9" /></para>
  <para style="s1">ካዋ ሁ ካጀረነ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />ጎርታ ካጎታ ካአቲ ሁና አታዬን። <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />ኦዱርሳ ፈሎ ኦሚጌ ኔባይን ጎጎዳንዴታዉን ካዋ ሁ ካጀረነ ዱባ ሳርሳዬነ። <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />ኖ ጀሬን ካነሻፋይናና እባዶነ ዎታ አንሌኖን ግራን ሂካ ካሙጉድ ጌሲ ኦፈላራን ሞትጆልኔ፥ ኦዶናት ኦአባነና ሂካ አላምኮክ ሁናጆልነ ጎርቱን ሂካ አማኖ ዳሩሪ ኦግራን ባቲክ አያናጆልነ ዎታያ። <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />ሃንሱን ታሜላን አሪ ሁና ካዲና አዎዳዪን ጎጎዳንዴታኑና ካአመን ዱባና ጉድስዴነ አታይ አልን ጎጎዳንዴታኑን ካዋ ሁ ካጀረነ ዱባ አባዬን።<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />ጎርታ ሩም ዝናራ ኣን ሞኦትስን ሞዋዬዴነ፥ ቁሉማ ላላ አን ሳርሳየንዴነ፥<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="ISA 11:5">ኢሳ. 11፡5</ref>፤ <ref loc="ISA 59:17">59፡17</ref>።</char></note> <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />ካኖጎዳ ዎንጋላ ከፈሮ አን ሉቃኦትስኒ ታብሳዬንዴን ኤካሳየን አላ።<note caller="-" style="x"><char style="xo" closed="false">6፡15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">ኢሳ. 52፡7</ref>።</char></note> <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />ሂካ ዱባኮና ኤለን ኣን ባልዳባልዳ ታአማቶ ታዱርሳ ዱኩቶ ዱባ ባስን ካኮዳንደታን አማኖ ዎንተ አን ቄንፋዬን። <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />ፋይና ታመተ ጉሌ ኣን መተክስኒ ካየን፤ ኡሱማለና አያና ቁሉክኮ ካሄላማሮ ሺፋ ኡሱና ሃፉራ ካዋ አባዬን።<note caller="-" style="x"><char style="xo" closed="false">6፡17 </char><char style="xt" closed="false"><ref loc="ISA 59:17">ኢሳ. 59፡17</ref>።</char></note> <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />አርጌቶ አያና ቁሉክ ቃጄላ ኤብና ጋላታ ስሳ። ሂካ ጋራይና ዋ ካቁሎይሰሮ እባዶ ማራን ናባዳዴና አታዬንዴን ኤባየን። <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />ሆል ታዎንጋላ አብስ ካላይ ጎጎፉሮ፥ ካኮአዬሳሮ ጎራታና ካዶታማራ ሃፉራ ጎጎስሳምሮ እና ኤባየን። <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />ግዳና ሳንሳላታ ሽያመረ አን ሂካ ካዎንጋላ ሀንዳ ካገገይሳሮያ። ሃንሱን ኢን ጎጎዶትሳሮ አብስ ካላይ ጎጎአዬስሮ ኢን ኤባየን።<verse eid="EPH 6:20" /></para>
  <para style="s1">ጉድስኮት ኖጎዳ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />መይ ኦሮ ግሮና መ ኣን ፈላሮ ጎጎአዴሳዉን ካጌላመራ አብካንና ጎታይ ካአብዳመራ ካሀንዳሮ ካሌራ ትክቆሳ ካአመን ዱባ እስኑን ሰግሮዋ።<note caller="-" style="x"><char style="xo" closed="false">6፡21 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ኦፋ. ፈ. 20፡4</ref>፤ <ref loc="2TI 4:12">2 ጢሞ. 4፡12</ref>።</char></note> <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />ሃንሱን ኖ ምሲ ግኖ ጎጎማላብታኑና እስና ጎጎአታይስሮን አመረ ኡሱ እስን ቶስ አን ፋረራ።<note caller="-" style="x"><char style="xo" closed="false">6፡22 </char><char style="xt" closed="false"><ref loc="COL 4:7-8">ቆላ. 4፡7-8</ref>።</char></note><verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />ዋ ኦዶኮና ጎታ የሱሳ ክርስቶሳኮ ኖጎዳና፥ ጌላንጀ፥ አማኖነ ዎታ አቢላሉን ሀሌቶ። <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />ታንባኖን ጌላንጄ ጎታካን የሱሳ ክርስቶሳ ኦጌላታራዉን ዱባን ስኖ እሶን ሀሌቶ።<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>