<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Bayso New Testament</book>
  <para style="h">1 ያንሳ</para>
  <para style="toc1">ካፋራመሮ ያንሳኮክ ሀንዳ ካሆሬ</para>
  <para style="toc2">1 ያንሳ</para>
  <para style="toc3">1 ያን.</para>
  <para style="mt1">ካፋራመሮ ያንሳኮክ ሀንዳ ካሆሬ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ካፋራመሮ ያንሳኮክ ሀንዳ ካሆሬ ላማ መተመተት ቆፋ አባ። እሶና ካናባባራ እባዶ ዋኔ ዎታና ኤረኬሳ የሱሳ ክርስቶሳነ ዎታ ራቶ ኮ ላኖ ጎጎግሮ አታይሲና ሂካ ራቶ ኮ ላኖክሶ ባስን ካዳንዳሮ ካጣራ አጋልስስኮ ጎጎፋክምራዉን ሴሪስንያ። ኡሱ ጎራታ ካግረ ካጣራ ካሜላን አጋልስስኮ ካበያረ ካሙታሮ ሂካ አላምነ ዎታ ታግቶ ኤሴላ ማንኮሌሮ ማራን ኤረ ካዋ የሱሳ ሱረ እባዶ ሊን ጎርቱን ታእባዶ ያዳሊ ኡሱ ግርን ላኮዳንዳቶ ካአማሮየ። ሀኑኡ ጣራ ኦአጋልስሳራን፥ “ፋይና አማኖ ሂካ አላምኮኒዕ ባሪሳኖዉን ጫናቃማኖኮ ባልቹማ ብያኖያ” አማ ግረን፤ ሂካኔ ዎታ “ራቶት ኤሰላኮት አታኒ ሌረ ካካለ እባዶን ጌላንጀ ቱሳኖ ፋይናነ ዎታ ሱረ ኤሴላ ላኮአቦ” አማ ግረን።</para>
  <para style="ip">ጻፍት ሂካ አጋልስስ ኔባታ የሱሳ ክርስቶሳ ዱዶክ እባዶትያ፤ የሱሳ ካአማናራና ዋ ካጌላታራ ዱባ እስኦሮ እስሲ ጌላታኖ ዶትሳራ አማ አጋልስሳራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="1JN 1:1-4">1፡1-4</ref> </char></para>
  <para style="io1">እፋና ሙጉድ <char style="ior"><ref loc="1JN 1:5-2:29">1፡5—2፡29</ref> </char></para>
  <para style="io1">ይስ ካዋና ይስ ካዱርሳ <char style="ior"><ref loc="1JN 3:1-24">3፡1-24</ref> </char></para>
  <para style="io1">ሩምና ሽሬና <char style="ior"><ref loc="1JN 4:1-6">4፡1-6</ref> </char></para>
  <para style="io1">ሁና ካጌላንጄ <char style="ior"><ref loc="1JN 4:7-21">4፡7-21</ref> </char></para>
  <para style="io1">ካአዎዳሮ አማኖ <char style="ior"><ref loc="1JN 5:1-21">5፡1-21</ref> </char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s1">ሃፉራ ካግር</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />ሃፉራ ካግርኮክ ጋራ ሆራርጀዋ ካግረ፥ ካማልነኖ፥ ኢልኦ ኦታኒ ካዴነኖ አንዴ ትችንሰ ካዴነኖ ገነኖኦታንና ካድኔራን አዬስናና። <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />ሂክ ግር ሙተራ፤ ኖና ዴነና፤ እስኑን አቶትናና። ኦዶ ዶሌ ካግረና፥ ኖና ካሙተሮ ጅሩ ጅሮማክ ግር እስኑን ሰግናና። <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />እስና ኖኔ ዎታ ራቶናት ጎጎግሮ ካዴነኖና ካማልነኖ እስኑን ሰግናና። ራቶናትካን ኦዶነና፥ ኤረ የሱሳ ክርስቶሳነ ዎታያ። <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />ገጌሎኦታን ልክኒዕ ጎጎሌራኑን ሂካ አን እስኑን ጻፍናራ።<verse eid="1JN 1:4" /></para>
  <para style="s1">ዋ ኢፋያ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />ኡሱኮ ካማልነኖ እስኑና ካሰጋና ሀንዳ “ዋ ኢፋያ፤ ሙጉድና ኡሱ ዶሌ ዱዶ ላኮግሮ” ካአማሮያ። <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />ሙጉዲ ሰሴታ ኡሱነ ዎታ ራቶናት አብና ጎአምኔ ጣራ አዬሳና፤ ሩምና ላግቶ። <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />አየሱን ጎአመን ዋ መተኬሳ ኢፋይ ጎጎግሮ፥ ኖና ኢፋ ጎሰሴነ እስ እስኦሮ ኖ ኮ ላኖ አብና፤ ኡሱማለና ኤረኬሳክ ካየሱሳ ክርስቶሳ ኢግ ጩቦ ዱባኮ ኖ ሙጭእስናራ።<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />ጩቦ ላኮአብኖ ጎአምኔ እስኦታን ሶባታና፥ ሩምና ኖ ኦሮ ላኮግቶ። <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />ጩቦካን ኡሱን ጎሰጋነ ጩቦካን ሀሄሶ አምን፥ ሜላነ ዱባኮ ሙጭስን ኡሱ ካአብዳመና ቁሉክያ። <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />ጩቦ ላኮፈልነኖ ጎአምኔ፥ ኡሱ ካጣራ የላና፤ ሃፉራና ኖ ኦሮ ላኮግሮ።<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s1">ክርስቶሳ ዋቢካን ላኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />ይስኬ! ሂካ ካኮንጻፈራ እስን ጩቦ ጎጎፈሎንኮ አመረያ፤ አየሱን ጎአመን ማምስክ እባዶትና ጩቦ ጎፈለ ኦዶ ዶሌ ኖ ዋቢ አብና፤ ኡሱና ካሩም የሱሳ ክርስቶሳያ።<note caller="-" style="x"><char style="xo" closed="false">2፡1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">ያን. 1፡12</ref>።</char></note> <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />ኡሱ ጩቦካን ሻጋ የላራ፤ ጩቦካን ካላል አንሌኖን ግራን አላም ዱባክ ጩቦ ካኮባራ ኡሱያ።<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />አጃጃ ካዋ ካኦራታኖ ጎሌነ ኡሱ ካካንሶ ላኖ ሂካኒ አዴሳና። <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />“አን ዋ ካሶዋ” አማ አጃጃኬሳ ካኦራኖን እባዶ ጎግረ ካጣራያ፤ ሩምና ኡሱ ኦሮ ላኮግቶ። <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />አየሱን ጎአመን ሃፉራ ካዋዉን ካአጃጃማራ ዱባ ዋዉን ታአባ ጌላንጀ ታአዴሳንተታ፤ ሩምና ኖ ኡሱን ግራኖ ካኮአዴሳማራ ሂካንያ። <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />ዋይ ግርናራ ካአማራ እባዶ ክርስቶሳ ጎጎግሬ ግራኖ ዶትሳራ።<verse eid="1JN 2:6" /></para>
  <para style="s1">ካኡሱብ አጃጃ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />ኦጌላንቴታን! ሂክ እስኑን አን ካጻፋራ አጃጃ ሆራርጀዋ ካግረና ካሆርኮ አጃጃያ ኳሬ ካኡሱብክ ላኮዮ፤ ኡሱና ካሆርኮ አጃጃ እስን ካማልቴታን ሃፉራያ። <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />ሀሌዎ ኳሬ ክርስቶሳና ካክስን ግሪ ዶሌ ሩም ሌ ካሙተሮ ካኡሱብክ አጃጃ አን ጻፍናራ፤ ሙጉድ ባየረ ካሩም ኢፋ ሀንቃ ግራ።<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />“አን እፋ ኦሮ ግራ” አማ አቢኬሳ ካዲዳራ ጋና ሙጉድ ኦሮ ግራ። <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />አቢኬሳ ካጌላታራ ዱባ ኢፋ ግራራ፤ ኡሱ ጉት እባዶ ካሀንዱዱፍስራ አየስ ላኮግሮ። <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />አየሱን ጎአመን አቢኬሳ ካዲዳራ ሙጉዲ ግራራ፤ ሙጉዲና ሰሴታራ፤ ሙጉድና ኢልኦ ኦቴሳ ማንኮባሴሮ ማራን ማንኮሴታሮ ላኮካሶ።<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />ይሶ፥ ጩቦክስን መገ ካየሱሳ እስኑን ሀሄሶ ማንኮአማመሮ ማራን አን እስኑን ጻፍናራ። <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />እስን ኦዶላል፥ ሆራርጀ ካግረ ማንኮማላብቴን ማራን አን እስኑን ጻፍናራ። እስን ዴሌልና ዎዳላል፥ ጻላየ ማንኮአዎዴን ማራን አን እስኑን ጻፈራ። <verse eid="1JN 2:13" /><verse number="14" style="v" sid="1JN 2:14" />እስን ይስ፥ ኦዶ ማንኮአዴሴን ማራን አን እስኑን ጻፈራ። እስን ኦዶላል፥ ባርዋ ካግረ ማንኮአዴሴን ማራን አን እስኑን ጻፍናራ። እስን ዴሌልና ዎዳላል፥ ኦአቲ ማንኮሌተን ማራን ሃፉራ ካዋ ዎዳናትስኒ ማንኮግሮ ማራን፥ ጻላየ ማንኮአዎዴን ማራን አን እስኑን ጻፈራ።<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />አላም ጎርቱን ካአላም አየስ ዱባ አሮጌላተን፤ ማዮና አላም ካጌላታራ ጎግረ፥ ዋ ኦዶኮት ጌላንጀ ኡሱን ላግቶ። <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />ኣላንቲና አላም ካግራ ሀልቻ ካሶየ፥ ሀልቻ ካኢሎኦ፥ ባሪሳኖኮክ ዳታኖ፥ አላምኮያ ኳሬ ዋ ኦዶኮ ላኮዮ። <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />አላምና ሀልቻና ሮራንዋ። ፈኢ ታዋ ካፈላራ አደ ጅሩ ጅሮማን ግራራ።<verse eid="1JN 2:17" /></para>
  <para style="s1">ክርስቶሳ ካኔባታሮኮ እስኦራታኖ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />ይሶ! ህት ታጋቾ ሳቲታ፤ “ክርስቶሳ ካኔባታራ ኤመታራ” አማማ ግራን ማልቴታን፤ ሂክማ ግዳዋ ካሞጋን ክርስቶሳ ካኔባታራ ኬራ፤ ህታ ኣላንቲ ታጉዳተቶ ሳቲ ላኖ አዴሳና። <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />እሶ ካኮቤራን ኖ ኦሮኮያ። ሀሌዎ ኳሬ ባርዋ ኡናታን ላኮዬን። ኡናታን ሊ ግሬንዋ ኖኔ ዎታ አታይ ኣል ግራኔን። አየሱን ጎአመን ዱባና ታታን ኡናኮ ላናዋት ጎጎአዴሳምሮ ኖ ኦሮኮ ካለ ቤራን።<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />እስን አደ ክርስቶሳ አያና ቁሉክ ሽግደራ። ሃንሱን እስን ዱባና አየስ ዱባ ካሳንዋ። <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />አን ካኮንጻፈራ እስን ሩም ማንኮካሳናዋተን ማራን ላኮዮ፤ እስን ጎአመን ሩም ካሳንዋ፤ ሩምኮ ጣራ ሄላማናዋቲ ካሳንዋ።<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />ክርስቶሳ ላኮዮ አመረ የሱሳ ካካካታሮ ኳሬ ካጣራ አዮያ? ሂክ ኦዶና ኤረና ካካካታራ ክርስቶሳ ካኔባታሮያ። <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />ኤረ ካኔባታራ ዱባ ኦዶ ላኮአቦ፤ ኤረ ካአማናራ ዱባ ኦዶ አባ።<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />እስን ሆራርጀ ካማልቴታን ዎዳናትስኒ አታይ ሀግሮ፤ እስን ሆራርጀ ካማልቴታን ሃፉራ ዎዳናትስኒ አታይ ጎግረ ኤረና ኦዶነ ዎታ ኮ ላኖ እስኑን ግሮዋ። <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />ህክና ክርስቶሳ ኖን ታስሰሮ አብዲ ጅሩ ጅሮማክ ግርያ።<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />እስን ካሶባሮ እባዶ ማራን አን ሂካ እስኑን ጻፈራ። <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />እስን ክርስቶሳኮ ካአታቴታን አያና እስን ኦሮ ማንኮግሮ ማራን ካካለ ካአጋልስስሮ እስኑን ላኮዶትሳሮ፤ ኡሱ ካአመን ዱባ እስን አጋልስስሮዋ፤ ካአጋልስስናራና ሩምታ ኳሬ ጣራ ላኮቶ። ሃንሱን አያና ቁሉክ እስን ጎጎአጋልስስሮን ክርስቶሳ ግራ።<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />ጎርታ ይሶ! የሱሳ እስኑን ካኮሙተ ጎራታ ሀአብሳኖን ጃቡይ ኡሱ ጎጎደኖና ታኮኤሜታሮ አሪ ኡሱ ሆረ ኖ ጎጎሙልኖንኮ ኡሱ ግራ፤ <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />ኡሱ ቁሉክ ላኖ ጎአዴሴን ቁሉማ ካፈላራ ዱባ ዋኮ ካኡሙላመሮ ላኖ አዴሳ።<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s1">ይስ ካዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />ይስ ካዋ አማም ጎጎኡማምኖን ኦዶ ምስት ጌላንጀ ኖን ስሰሮ ዲያ! ኦግራን ይስ ካዋና፤ አላም ዋ ካሳና ማንኮዋቴ ኖና አደ ላኮካሶ። <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />አን ኦጌላታሮኦቴ! ግዳ ይስ ካዋና፤ ሆረንባቱን ኖ ምስ ልናኖ ጋና ላኮአዴሳመሮ፤ አየሱን ጎአመን ክርስቶሳ ካኮኤሜተ ጎራታ ታሩም ምዲተሳ ማንኮድናኖ ማራን ኡሱ ኣን ካልናኖ ኖ ካንሶዋ። <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />ሂክ ካልናሮ ክርስቶሳ አብድ ካየላታራ ዱባ ክርስቶሳ ሙጭ ካአመ ጎጎሌሮ ኡሱና እስኦቴሳ ሙጭሳታራ።<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />ጩቦ አማኖ ሴራ ካዋ ባሳኖ ማንኮሌ ማራን ጩቦ ካፈላራ ዱባ ሴራ ካዋ ባሳራ። <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />ክርስቶሳ ጩቦ ካእባዶ ባስን ኤሜታኖና ኡሱ ጩቦ ካሊክ ላኖ ካሳንዋ። <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />ሃንሱን ክርስቶሳይ ካግራ እባዶ ዱባ ጩቦ ፈላ ላኮግራሮ። ጩቦ ካፈላራ እባዶ ዱባ ኡሱ ላኮዴሮ ጎርቱን ላኮማላበሮ።<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />ይሶ! ማዮና እስን አሮሶቦ፤ ክርስቶሳ ቁሉክ ጎጎሌሮ ቁሉማ ካፈላራ ዱባ ቁሉክያ። <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />ጩቦ ካፈላራ ዱርሳኮያ። ኣላንቲና ዱርሳ ባርዋ ጩቦ ካፈላሮየ። ኤረ ካዋ ካኮኤመተራና ፈሎ ኦዱርሳ ባስንያ።<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />ዋኮ ካኡሙላመራ ዱባ ጩቦ ፈላ ላኮግራሮ፤ ያዳሊቴሳ ኡሱ ኦሮ ማንኮግቶ ማራና ዋኮ ካኡሙላመሮ ማንኮሌ ማራን ጩቦ ፈልን ላኮዳንዳሮ። <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />ይስ ካዋና ይስ ካዱርሳ ካለ ቤን ካኮአዴሳማራን ሂካንያ፤ ቁሉማ ካፈሎን፥ አቢኬሳ ካጌላኖን ዱባ ኤረ ካዋ ላኮዮ።<verse eid="1JN 3:10" /></para>
  <para style="s1">እስእስ ጌላታኖኮክ ጋራ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />እስን ሆራርጀ ካማልቴታን ሀንዳ፥ “እስኦሮ እስእስጌላና” ካአማሮያ። <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />ታጻላየ ኡና ካሌረና አቢኬሳ ካላጋዳተሮ ቃየል ኣን ላኖ ላኮዶትሳሮ፤ ኡሱ አቢኬሳ ሙን ላጋደ? ፈሎኦቴሳ ኦሜላን ማንኮሌረና አቢኬሳኒዕ ፈሎ ጎአመን ልክኒዕ ማንኮሌሬን ማራንየ።<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />አቢላልቴ! አላም እስን ጎዲደ አሮሳዴን። <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />ኖ አቢላልታን ማንኮጌላታኖ ማራን ጎይኮ ግር ቶስ ካናቅነኖ ካንሶዋ። ጌላንጀ ካላይክ እባዶ ጎይ ኦሮ ግራ። <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />አቢኬሳ ካዲዳራ ዱባ ኔፎ ካላጋደያ፤ ኔፎ ካላጋዳራና ጅሩ ጅሮማክ ግር ካላይክ ላኖ ካሳንዋ። <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />ጌላንጀ ሜቶ ካኮአዴሳና የሱሳ ክርስቶሳ ግርኬሳ ኖን ሮርሳተ ማንኮስሳተ ማራንያ፤ ኖና ግርካን አቢላልታን ማራን ሮርሳይ ስሳይን ዶትሳራ። <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />እባዶ ሂካ አላም ዱሩማ አባ ግራን ካራካተሮ ዲጉረ ጎነኔኤይሳኖን አን ዋ ጌላታራ አምን ምሲ ዳንዳራ? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />ይሶ! ጌላንጀታን ሩምና ፈሎይ ታሙታቶ ኳሬ ሃፉራና አየስ ካላሊ አሮሌኖ።<verse eid="1JN 3:18" /></para>
  <para style="s1">ዋይ ሆረ ካአብኖ አብዳማኖ</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />ሂካኒና ኖ ኦሩሚ ላኖና ዋይ ሆረ አብስ ካላይ አብዳም ጋባላሚን ካዳንዳኖ ላኖ ካንሶዋ። <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />ሂካ ጋራነ ዎዳናታን ኖ ጎዎቃስተና ዋ ዎዳናታንኮ ካሮረያ፤ ኡሱና ካመን ዱባ ካሳ። <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />ኦጌላታሮ ኦተ፥ ዎዳናታን ኖ ካዎቃስኖን ጎሌተ ዋይ ሆረ አብዳማኖ ዱባ ኖን ግሮዋ። <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />አጃጃ ካዋ ካኦራታኖና ኡሱ ካገጌላይስሮ ማንኮፈላኖ ማራን ካኤባታኖ ዱባ ኡሱኮ ሄላይናና። <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />አጃጃ ካዋ ኤረኬሳክ ካየሱሳ ክርስቶሳ መገ ኖ ጎአማኖና ክርስቶሳ ኖ ካአጃጄሮክ ማለ እስኦሮ እስእስ ጎጎጌላኖንያ። <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />አጃጃ ካዋ ካኦራታራ ዱባ ዋይ ግራራ፤ ዋና እሶ ግራራ። ዋ ኖ ኦሮ ግራኖ ካኮአዴሳና ኡሱ ኖን ካስሰሮ አያናይያ።<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s1">አያና ካሩሚና ካጣራ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />አን ኦጌላታሮኦቴ! አያና ዱባ አሮአማንቴን፤ አየሱን ጎአመን አያናጆል ዋኮ ላኖ ቆቆራ፤ ኣላንቲና ካሞጋን ካጣራ ካሄገሮል አላም ቶስ ኤመተራ። <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />አያና ካዋ ሂካኒ ማላብናታን፥ የሱሳ ክርስቶሳ እባዶ ል ኤሜታኖኬሳ ካአታታራ አያና ዱባ ዋኮያ። <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />የሱሳ ካአታኖን አያና አደ ዋኮ ላኮዮ፤ ኤመይናራ አማማ እስን ካማልተቴን ክርስቶሳ ካኔባታራ አያና ሂካያ። ግዳና አላም ኦሮ ግራ።<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />ይሶ! እስን ዋኮታን፥ ካጣራ ሄገሮልና አዎዴታን፤ ኣላንትና እስን ኦሮ ካግራ አላም ካግሮኮ ሮራራ። <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />እሶ አላምኮያን፤ ሃንሱን እሶ አላም ኣን አዬሳራን፤ አላምና እሶ ማላራ። <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />ኖ ዋኮና፥ ዋ ካማላባራ ኖ ማላራ፥ ዋኮ ካሌኖን አደ ኖ ላኮማላሮ፥ ሂካኒና ካሩም አያናና ካጣራ አያና ማላብናና።<verse eid="1JN 4:6" /></para>
  <para style="s1">ዋ ጌላንጀያ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />ኦጌላታሮ ኦቴ! ጌላንጀ ዋኮ ማንኮሌተ ማራን እስእስኦሮ ኖ እስእሲ ጌላኖ፥ ካጌላታራ ዱባ ዋኮ ካኡሙላመሮያ፤ ዋና ካሶዋ። <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />እባዶ ካጌላኖን አደ ዋ ላካሶ፥ ኣላንቲና ዋ ጌላንጀያ። <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />ዋ ጌላንጀ ኖ ኦሮ ካቱሰራ ሂካማሌያ፥ ኖ ጋራኬሳነ ኔፎነ ጎጎግርኖን ዋ ኤረኬሳ ኮ ሂካ አላም ቶስ ፋረ። <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />ጌላንጀ ህታታ፤ ኖ ዋ ጌላነኔ አንሌኖን ግራን ኡሱ ኖ ጎጎጌላተሮና ጩቦካን ጎጎባስሮን ኤረኬሳ ፋረ።<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />ኦጌላንተታን! ዋ ሃ ኖ ጎጌላተ፥ ኖና እስ እስኦሮ እስእስ ጌላይን ዶትሳራ። <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />ዋ ካዴራ ማዮና ዱዶ ላግሮ፤ እስ እስኦሮ እስእስ ጎጌላነ አድ ዋ ኖ ኦሮ ግራራ፤ ጌላንጀቴሳና ኖዬን ታአማጋንተ ልናታ።<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />ዋ አያናኬሳ ኖን ማንኮስሰ ማራን፥ ኖና ኡሱ ግራኖ ኡሱና ኖዬን ካግሮ ላኖ ካንሶዋ። <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />ኦዶ ኤረኬሳ አላም ካፋይሳሮ ጎጎሌሮ ካፋረሮ ኖ ዴነና፤ አቶትናና። <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />የሱሳ ኤረ ካዋ ላኖ አማኔረ ካአቶታሮ ዱባ፥ ዋና ኡሱይ ግራራ፤ ኡሱና ዋይ ግራራ። <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />ሃንሱን ዋ ኖን ታአቦ ጌላንጀ ካንሶዋ፤ ጌላንጀቴሳና ኖ አማናና።</para>
  <para style="p" vid="1JN 4:16">ዋ ጌላንጀያ፤ ጌላንጀ ካግራ ዋይ ግራራ፤ ዋና ኡሱ ግራራ። <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />ሂካ አላምና ክርስቶሳ ኣን ላና። ታፍርዳ አሪ ጃቡ ኖን ጎጎግርቶ፥ ጌላንጀ ኖ ኦሮ ታአማጋንተ ሌተታ። <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />ጌላንጄ አብስ ላግቶ፤ ታአማጋንተ ጌላንጀ አደ አብስ ባሳታ፤ አብስ ሙሮነ ዎታ ኢንሰ ታአባተቶ ማንኮሌተ ማራን ካአብሳታሮ እባዶኮት ጌላንጀ ታአማጋንተ ላኮቶ።<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />ዋ ጣየ ኖ ጌላተራ፤ ኖና ኡሱ ጌላታና። <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />ማዮና፥ “አን ዋ ጌላታራ” አማ አቢኬሳ ጎዲደ፥ ኡሱ ካጣራያ፤ ካደያሮ አቢኬሳ ካጌላኖን ካዴኖን ግሮ ዋ ጌላይን ላኮዳንዳሮ። <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />ኡሱና፥ “ዋ ካጌላታራ ዱባ አቢኬሳ ጌላይን ዶትሳራ” ካአማሮ ሂካ አጃጃ ኖን ስሰራ።<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s1">ኤረ ካዋይ አማናኖኮክ ጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />የሱሳ ኡሱ ክርስቶሳ ላኖ ካአማናራ ዱባ ዋኮ ኡሙላመራ፤ ኦዶና ካጌላታራ ዱባ ኤረኬሳና ኡሱማሌዋ ጌላታራ። <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />ዋ ጎጌላነና አጃጃኬሳ ጎኦራነ ይስ ካዋ ካጌላታኖ ላኖ ሂካኒ አዴሳና። <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />ዋ ጌላታኖ አጃጃኬሳ ኦራታኖ ማንኮሌ ማራንያ፤ አጃጃኬሳና ካእስል ላኮዮ። <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />ኣላንትና ዋኮ ካኡሙላመራ ዱባ አላም አዎዳራ። ኖ አላም ካኮአዎድናናና አማኖካንያ። <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />የሱሳ ኤረ ካዋ ላኖ ካአማናሮ ኳሬ አላም ካአዎድራ አዮያ?<verse eid="1JN 5:5" /></para>
  <para style="s1">ጋራ ካክርስቶሳ ካስሳመሮ አቶናት</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />በከና ኢግ ካኤመተራ ሂክ፥ የሱሳ ክርስቶሳያ። ኡሱ በከና ኢግ ኳሬ በከ ኦላል ላኮኤሜተሮ። ካአቶታራና አያናያ፤ አያናና ሩምያ። <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />ሃንሱን አቶ ሴዶ ግራ። <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />እሶና አያናኬሳ፥ በከና ኢግናያን፤ እሶ ሴዶ እስአታራን። <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />አቶ ካእባዶ ጎአታነ፥ አቶ ላኖ ካዋ አደ ሂካኮና ሮራራ፤ ሂክ ኤረኬሳ ማራን ካስሰሮ አቶናት ካዋያ። <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />ኤረ ካዋይ ካአማናራ ዱባ ዎዳናቴሳይ አቶ አባ፤ ዋ ካአማኖን ዱባ ዋ ኤረኬሳ ማራን ካስሰሮ አቶናት ማንኮአማኖን ግሮ ማራን ዋ ኡሱ ካጣራ የለራ። <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />አቶናትኬሳና ሂካያ፤ ዋ ጅሩ ጅሮማክ ግር ኖን ስሰ፤ ሂክ ግርና ካኮግራ ኤረኬሳያ። <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />ኤረ ካዋ ካአባ ግር አባ፤ ኤረ ካዋ ካላይክ አደ ግር ላኮአቦ።<verse eid="1JN 5:12" /></para>
  <para style="s1">ጅሩ ጅሮማክ ግር አዴሳኖ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />ኤረ ካዋኮክ መገ ኦአማናታን እስን፥ ጅሩ ጅሮማክ ግር ካአብታን ላኖ ጎጎማላብታኑን ሂካ አን እስኑን ጻፋራ፤ <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />ዋ ቶስ ጋባላሚን ኖ ታአብና ጃቡ ህታታ፤ ማምስክ አዬንሳ ፈኢቴሳ ማለ ጎኤባነ ኡሱ ማሎዋ፤ <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />ኖ ካኤባታኖ ዱባ ኡሱ ማላኖ ጎአዴንሰ፥ ካኤባነኖ አየስ ካአታነኖ ላኖ አዴሳና።<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />ማዮና አቢኬሳ ጎይን ካጌግሶን ጩቦ ፈላ ግራን ጎዴ ሀኤባቶ፤ ዋና ጎይን ካጌግሶን ጩቦ ካፈለሮን ግር ስሳራ። ጎይን ካጌግሳራ ጩቦ ግራ፤ ሂካኮክ ጋራ አደ ሀኤባቶ ላኮአምናሮ። <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />ሜላነ ዱባ ጩቦታ፤ ጎይን ካጌግሶን ጩቦ ግራ።<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />ዋኮ ካኡሙላመራ ዱባ ጩቦ ካፈሎን፥ አየሱን ጎአመን ኤረ ካዋ ማንኮኦራታሮ ማራን፥ ካሜላና ኡሱ ካድኖን ላኖ ካንሶዋ።<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />ኖ ኦዋ ጎጎሌነኖ፥ አላም ዱባና ሜላነ ሄገሊ ካግሮ ካንሶዋ።<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />ኤረ ካዋ ኤሜታኖና፥ ካሩም ካሌሮ ኡሱ ጎጎአዴንሶን ሻዳኖ ኖን ካስሰሮ ላኖ ካንሶዋ፤ ኖና ካሩም ካሌሮ ኤረኬሳ የሱሳ ክርስቶሳ አብና። ኡሱ ካሩም ሄዶና ጅሩ ጅሮማክ ግርያ።<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />ይሶ፤ ቶልቻልኮ እስኦትስን ኦራዬን።<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>