<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Bayso New Testament</book>
  <para style="h">ካሮም ቶስ</para>
  <para style="toc1">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ እባዶ ካሮም ቶስ</para>
  <para style="toc2">ካሮም ቶስ</para>
  <para style="toc3">ሮመ</para>
  <para style="mt2">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ</para>
  <para style="mt1">ካሮም እባዶ ቶስ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ካፋራመራ ጳዉሎሳ ሀንዳ ካሮም እባዶ ቶስ ካጻፈራ ጳዉሎሳ ሮም ካግሮ ምን ካዋ ድን ሀልቻ ማንኮአባናየ ማራን እስኤካሳይ ጎጎኦራናዉን የልንያ። ካጳዉሎሳ ሀልቻ ሮም ካግሮ አማኒል ዎታ ጎራታ ክጫር ፈልጉረ ጋርጋርሳክሶይ ካስፌን ኡል ቶስ ሴዪንየ፤ አማኖ ካክርስታናኮክ ጋራ አዴሳና ክርስታናጆል ግርክሶይ ኦፈላራን ፈሎ ካክርስታና አጋልስስኮክ ጋራ ካለካለ ቤሰ ሰሰጋ ጻፈራ፥ ካጳዉሎሳ ሀንዳ ጋማ ካንጂን ካኮግራ ሂካ ሀንዳይያ።</para>
  <para style="ip">ጳዉሎሳ ሮም ካግሮ ምን ካዋክ አማኒሉን ኖጎዳቴሳ ፋራመ አባባተረ እሶን ካኤባይናሮና አብድ ስሰ አባባተረ ሀንዳኬሳዉን መተ ታላቶ ቆፋ (1፡17) “ዋኮ ታሄላማቶ ቁሉማ አማኖይ፥ አማኖን ላኖ ዎንጋላይ ሙተራ” ካአማራ ሃፉራ ላኖ ቱሳራ።</para>
  <para style="ip">ኤሰኮ ሆረንባን ጳዉሎሳ ህታ ቆፋዋ ባላኣሳ ጻፋራ፥ አይሁድና ሌረ አይዛብ ዱባ ጩቦ ሄገሊ ካባራሮ ማንኮሌ ማራን ዋኔ ዎታ ዎጋርን ዶትሳራ፥ እባዶ ዋኔ ዎታ ዎጋርን ካኮዳንዳራ የሱሳ ክርስቶሳ አማናኖይያ፥ ሂክ ዋኔታ ካጣባታራ ካኡሱብክ ራቶናትኮት ላኦ ግር ካኡሱብ ላኖ ጳዉሎሳ ባላኣሰ አጋልስሳራ። አማኒሉን ዋኔ ዎታ ኖጎዳ ግርቶዋ፥ አያና ካዋኮክ ጋራነ ጩቦኮና ጎይኮክ ሁናኮ ባልቹማ ቤሳራ፥ ፎልሲ 5 ታ 8 ጌሮ ጳዉሎሳ ሴራ ካዋና አማኒልኮክ ግሪ ካፈላራ አያና ካዋኮክ ሁና ሀልቻ መዮ ቱሳራ፥ ሂካ ዴበ ጳዉሎሳ ዋ ሳኒ ታእባዶቱን ካአቦ ሀልቻ ኦሮ አይሁድና አይዛብ ምሲ ኢንሴ ቁራናምን ዳንዳራን? ታአማማቶ ሆሲኑን አባብ ስስን እጻማራ።</para>
  <para style="ip">አባበ ጳዉሎሳ ጎጎቱሰሮ፥ አይሁድ የሱሳ ሀአታኖን ሄሳኖ ሀልቻ ካዋያ፥ ሂክ ካሌራ የሱሳ ክርስቶሳኮክ ጋራነ ዋ ታቱሰሮ ስኖ ታፋይና ሳኒ ታእባዶ ዱባ ዎታ አቢንያ። ሀሌዎ ኳሬ አይሁድ የሱሳ ታኮአታራን አሪ ታኤሜይናቶ ላኖ ጳዉሎሳ አብዳታራ፥ ጉድሳ ጳዉሎሳ ካክርስታና ግር ምሲ ግርን ዶትሳሮ ካካለኮና ዋ ካአማናራ እባዶ እስእሲ ኦሮ ታግቶ ኤሴላ ራ ካጌላንጄ ሰሰዪን እሶን ካዶትሳሮ ላኖ አጋልስሳራ፥ ዋዉን ሀንዳኖኮክ ጋራ፥ ክርስታናጆል ኡልክሶዉና እስእስ ኦሮ ካአባን ኦዶናትና ታሳሙ ኣላንቲ ታከያቶ ሆሲኑን ካለካለ ቤሰ አጋልስሳራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ሂካ ማጻፋ መተ ታላቶ ቆፋ ቶስ ታባኖ <char style="ior"><ref loc="ROM 1:1-17">1፡1-17</ref> </char></para>
  <para style="io1">ፋይና ኤረ ካእባዶዉን ካዶትሳሮ ላኖ <char style="ior"><ref loc="ROM 1:18-3:20">1፡18—3፡20</ref> </char></para>
  <para style="io1">ካፋይና ራ ካዋ <char style="ior"><ref loc="ROM 3:21-4:25">3፡21—4፡25</ref> </char></para>
  <para style="io1">ክርስቶሳ ካሄላማሮ ካኡሱብክ ግር <char style="ior"><ref loc="ROM 5:1-8:39">5፡1—8፡39</ref> </char></para>
  <para style="io1">እስራኤል ሀልቻ ካዋት <char style="ior"><ref loc="ROM 9:1-11:36">9፡1—11፡36</ref> </char></para>
  <para style="io1">ታክርስታና ያዳሊ <char style="ior"><ref loc="ROM 12:1-15:13">12፡1—15፡13</ref> </char></para>
  <para style="io1">ጉድሳኖና ኖጎዳ <char style="ior"><ref loc="ROM 15:14-16:27">15፡14—16፡27</ref> </char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />ካየሱሳ ክርስቶሳ ድይና ካፋራመሮ ሊን ካኡማመሮኮና ዎንጋላ ካዋቱን ዎዩ ካሌሮ ጳዉሎሳኮ ካፋራመሮ ሀንዳያ። <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />ሃንሱን ዎንጋላ ካሄገሮ ቶንሴ ቁሉክ ማጻፋይ ጣይተ ዋኮ አብድ ስሳንተታ። <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />ሂክ ዎንጋላና ኤረ ማራን ሶይ ሳኒ ታዳዉተኮ ማንኮሌዉን፥ <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />ቁሉክ አያናኬሳይ አደ ጎይኮ ክያኖኮክ ካአቲ ሁናይ ኤረ ካዋ ሌ ማንኮሙተ ማራን ጎታካን የሱሳ ክርስቶሳ ማራንያ። <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />ኡሱ ካክርስቶሳ መገይ አይዛብ ዱባ ጎጎአማኖና ጎጎአጃጃምሮን የልን ኡሱኮክ ጋራነ ካፋራመሮ ታየልስሶ ስኖ ኖ አታኔና። <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />እስን መተክስኑን ኦየሱሳ ክርስቶሳ ጎጎሌታዉን ዋ ኦኡመሮ ኦሮኮታን።<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />ዋይ ኦጌላንቴታና ቁሎለ ሊን ኦኡማንተታን ሮም ኦግታን ዱባን፥</para>
  <para style="p" vid="ROM 1:7">ዋ ኣቦካን፥ ጎታ የሱሳ ክርስቶሳ ስኖና ኖጎዳ እስኑን ሀሌቶ።<verse eid="ROM 1:7" /></para>
  <para style="s1">ጳዉሎሳ ሮም ድን ካአባናየ ሀልቻ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />ዱባንኮ ጣየ፥ አማኖክስን አላም ዱባ ማንኮማልሳመሮ ማራን እስን ዱባን አን ዋ ሄዶኬ ካየሱሳ ክርስቶሳ ጋራነ ጋላታራ። <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />አርጌቶ ኤብኬይ አን እስን ጎጎሻዳሮ፥ ካኤረ ዎንጋላ ላላባኖ ዎዳናኮ አን ካኮንሀንዳራ ዋ ኡሱ አቶኬያ። <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />አርጌቶ ኤብኬይ አን እስን ሻዳራ፥ ግዳ አደ ፈኢ ታዋይ አን እስን ቶስ ጎጎኤሜሮን ራ ኢን ጎጎባናምሮ ኤባታራ።<verse eid="ROM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11" />ጎጎአታታኑን እስን ካየሎ አያናኮክ እላቦ በለኤስ ስስንና ድን ሃልቻራ። <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />ህክና እስና አንና መተመተካን አማኖ እስእስኦሮ ጎጎአታኖንያ። <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />አቢላልቴ!<note caller="+" style="f"><char style="fr" closed="false">1፡13 </char><char style="ft" closed="false">አቢላልቴ ካአማራ ሃፉራ አባላልነ አደረያ። </char></note> አይዛብ ኦሮ ዋ ካአማናሮ እባዶ ጎጎሄላየሮ፥ እስን ኦሮ ኡሱማሌ ዋ ካአማናሮ እባዶ ሄላይን ዶተረ፥ አየሱን ጎአመን ካሞጋን ጎራታ እስን ቶስ ኤመይን ቆፔ ግራን፥ ግዳግን ገጋናዋትኬ ጎጎአዴሳኑን ዶታራ።<verse eid="ROM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14" />ካግርክ እባዶዉና ሌረ ኮና ካካሶቱን፥ ቃሮሌዉና ሌረ ኦሻዶቱን ዎንጋላ አጋልስስን አን አንዛ አባ። <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />ሮም ኦግታን እስኑና ዎንጋላ ላላብን አን ካኮንሀልቻራ ሃንሱንያ።<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />አን ዎንጋላይ ላኮሙላሮ፤ ህክና ሆራርጀ አይሁድን ደቤና አይዛብን ካአማናሮ ዱባን ሁና ካዋያ።<note caller="-" style="x"><char style="xo" closed="false">1፡16 </char><char style="xt" closed="false"><ref loc="MRK 8:38">ማር. 8፡38</ref>።</char></note> <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />ዎንጋላይ ቁሉማ ታዋ ሙተታ፤ ቁሉክ አማኖ ግራራ አማመ ጎጎጻፋመሮያ፤ “ቁሉማና ሆራርጀኮ ታ ጋቾ ጌቶ ካኮሄላማታ አማኖ ካላልያ።”<verse eid="ROM 1:17" /></para>
  <para style="s1">ኤንገ ታዋ እባዶ ጉት</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />ሜላነይ ሩም ቡቄን ኦአበራን፥ ዋ አብስዋትትሶይና ሜላነትሶ ዱባ ጉት ኤንገ ታዋ ዳሩርኮ ኤመይናታ። <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />ጋራ ካዋ አዴሳኖ ካዳንዳማራ እሶ ዶሌ ካአዴሳመያ፤ ኣላንቲና ዋ እሶን አዴስሰራ። <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />አላም አሮመጣመኮ ሀጋአበጉረ ታሙቶን ያዳሊ ታዋ ህክና ጅሩ ጅሮማክ ሁናና ሄዶ ላኖኬሳ ኡሱ ታመጠሮ መጣ ዱባ ጉት ሙታራ፤ ሃንሱን እባዶ ካባሳሮ ባሱን ካኮኣላሮ ላኮአቦ።<verse eid="ROM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21" />እሶ ዋ ጎማላቤና ዱዶ ሄዶ ላኖኬሳ ላኮካባጄን፤ ጋላታና ላኮስሴን፤ አየሱን ጎአመን ያዳክሶ ኢል ካላይክና ታሻዶን ዎዳናትሶ ታዱደ ሌተ። <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />ቃሮና ጎአመና ጎዎሌ ሌን፤ <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />አርዶክ ዋኮት ካባጃ ካጎዋሮ እባዶና ክምብርጆል፥ ሱላለና ኡሊ ታግታማቶ መጣኮት ምዲ ኣን ካመጣመሮን ካባጃ ስሰን።<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />ሃንሱን ዋ ጩቦ ታአማጋንተቶ ዎዳናትሶኮክ ሀልቻ እስ እስሮ ማርክሶ ጎጎባቶይሳራዉን ቁሉማ ካላይት ኤሴላ ታሶየቱን ሮርሰ ስሰ። <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />ህክና ካኮንሌራ ሩም ታዋ ጣራ ማንኮኢግልሴን ማራን፥ ካመጠሮኮት ባንኤ ካመጣመሮ ማንኮሄዶይሳተን ማራና ማንኮሀንዳዬን ማራን፥ ካመጠራ ጅሩ ጅሮማን ካሶማሳመያ፤ ሀሚኒዕ። <verse eid="ROM 1:25" /><verse number="26" style="v" sid="ROM 1:26" />ህታ ኣላንቲ ዋ እሶ ካሙሊስሮ ሀልቻክሶዉን ሮርሰ ስሰ፥ ሄሌልክሶና አደ ያዳሊትሶዉን ታዶትሳቶ ኤሴላ ያዳሊትሶ ታሌኖን ኤሴላን ኢግልሰን። <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />ኡሱማለና ባባር ያዳሊትሶዉን ካዶትሳሮ ሄለልኔ ዎታ ኤሰላኖ ኢሴንጉሬን እስ እስሮ ሀልቻ ካሶየቲ ጉባተን፤ ባባር ባባርነ ዎታ ሁዱረ፤ ኦሜላን ፈሎኦትሶዉን ታዶትሳቶ ሙሮ መተክሶይ ጉት ኬናተን።<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />ሂካኮና ካሮረ ያዳክሶይ ዋ ማላባኖ ላኦ ላኮአቦ አማኖኮ ካከይ፥ ፈልን ካንዶትሶን ጎጎፈላዉን ዋ ላኦ ካላይት ሳሙዉን ሮርሰ እሶ ስሰ። <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />ሃንሱን ባስ፥ ሜላነ፥ ጋጲጋጳኖ፥ ምጌ፥ ጢበ፥ ኔፎ ላጋዳኖ፥ ኤንጌ፥ ሶባኖ፥ ካሜላነ ሀልቻ ዱባ ኦአማጋሜራን፥ ኡሱማለና ኦሀማታራንያን፤ <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />እባዶ መገ ኦባሳራን፥ ዋ ኦዲዳራን፥ ኦሀባራራን፥ ኮራሜሳና ኢፍሳዶለያን፤ ሜላነ ካኮፈላራን ራ ኦዶታራን፥ ኦኡሙለራዉን ኦአጃጃሞን፥ <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />ኦሻዶን፥ ታአመን ኦፉራራን፥ ጌላንጀ ካላይኒዕና ሻጋ ካላይኒዕያን፤ <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />ሂካ ኦፈላራን ዱባን ጎይ ዶትሳራ፤ ካአማሮ ልክኪ ካሌሮ ሴራ ካዋ አዴሳ ግራን ሂካ አየስ ፈላኖ ካላል አንሌኖን ግራን ሂናኣ ኣኒዕኒዕ ፈሎ ካፈላሮ እባዶና አታይሳራን።<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s1">ፍርዳ ካዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />ሃንሱን ካካለ እባዶ ጉት ካፍርዳታ አት፥ ካኮአላቶ ላኮአብቶ፤ ካካለ እባዶ ጉት ፍርዳ እስኦታ ጉት ፍርዳታ፤ ሀሱ አት ካፍርዲተታ እባዶት ካፈለሮ አትና ማንኮፈላቶ ማራንያ። <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />ሂካማሌ ኦፈላራን ጉት ፍርዳ ካዋ ልክ ላኖ ካንሶዋ። <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />ጎርታ አት እባዶት ካካለ ጉት ፍርዳ፥ ኡሱዋ ካፈላቶ ጎሌተ ፍርዳ ካዋኮ ካሄሶ ኣን ላራ? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />ሙ አንጅረ ታዋ ጩቦኮ ጉላ ጋላኖ ቶስ ታገጌሳቶ ላኖ አንዴሶን ኢዳነና ዳንዳኖና፥ ኦብስኮት ዱሩማ ቱፋታ? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />አየሱን ጎአመን ታዱዴና ጩቦኮ ጉላ ታሎን ዎዳናታኮት ኣላንቲ ልክኪ ፍርዳ ታኮኤመታሮ ታኤንጌ አሪ ታዋይ እስኦታይ ጉት ኤንገ ጎጎጂናቶ የላታ። <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />ዋ እባዶን መተመተ ፈሎኦቴሳክ ማለ ስስናራ። <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />ካእዳን ካሌሮ አታይ ፈላኖ ካባጃና፥ ጋሻና ኦዶታታራዉን ጅሩ ጅሮማክ ግር ዋ ስስናራ። <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />አየሱን ጎአመን እስ ኦጌላታራን ሩም ኢሰን ሜላነ ፈላ ኦሰሴታራን ጉት ፍርዳ ካዋና ኤንገ ግናታ። <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />ሜላነ ካፈለሮ እባዶ ዱባ ጉት ጣይ አይሁድን ኤሰኮ አይዛብ ጉት ራኮና ጭንቂ ለታ። <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />አየሱን ጎአመን ታኢዳን ካፈላሮ እባዶ ዱባ ጉት ጣይ አይሁድን ኤሰኮ አይዛብን ጋላታ፥ ካባጃና ኖጎዳ ለታ። <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />ዋ ማዮና ላኮኡሉልሳሮ።<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />ሴራ ካሙሴ ካላይ ጩቦ ካፈለ ዱባ ሴራ ካላይ ባይናራ፥ ሴራ እሶን ግራን ጩቦ ኦፈላራን ሴራይ ፍርዳምናራን። <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />ኣላንቲና ዋይ ሆረ ቁሎለ ኦአማማራን ሴራን ኦአጃጃማራን ኳሬ ሴራ ኦማላራን ላኮያን። <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />ሴራ ካሙሴ ካላይክ አይዛብል ጎጎካሳናየኒ ሴራ ካሰጋሮ አየስ ፈላራን ህታ ኣላንቲ ሴራ ጎዋታመና ካክሶ ካካሳናየን ሴራ ማንኮአባን ማራን ፈልን ካዶትሳሮ ካሳንዋ። <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />ህክና ያዳሊትሶይ ሴራ ካሙሴ ካሰጋሮ አየስ ዱባ ዎዳናትሶይ ካጻፋመሮ ላኖ ቱሳራ፤ አደና ሳሙትሶ እሶን አቶ ላታ፤ ሳሙትሶ አሪ ቶቶ ዎቃሳታ፤ አርቶቶና ጋርጋራታ። <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />ህክና ካኮልናራ አን ካአጋልስሰሮ ካዎንጋላ ሃፉራ ማለ ዋ የሱሳ ክርስቶሳ ቶንሴ እባዶ ካፈለሮ ስያመ ካግሮ አየስ ጉት ታኮፍርድናሮ አሪ ካአዴሳመ ሌራ።<verse eid="ROM 2:16" /></para>
  <para style="s1">አይሁድና ሴራክሶ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />አት አን አይሁድያ ጎአንተ፥ ሴራ ካሙሴ ካአማናቶና ዋኔ ዎታ ታግቶ ኤሴላ ካኮራታ፥ <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />አት ፈኢ ታዋ አዴሳታ፤ ሴራ ማንኮአጋልሳቴቶ ማራን ታኢዳን ፈላኖ ካሶዋ። <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />አት ኢልኦ ኦደያኖቱን ሆረሃይተ ካገጌሳቶ ጎሌተ፥ ሙጉድ ኦግራኑና ኢፋ ላኖካ እስኦታይ ካአማናቶ ጎሌተ፤ <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />ሴራይ ታሄላቴቶ ቃሩማኮና ሩምኮ ካከይ ካካሶቱን ጎርሳ ስሳ፥ ይስ ካአጋልስሳቶ ጎሌተ። <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />ጎርታ አት ካካለ ካአጋልስሳታ እስኦታ ላኮአጋልስሳቶያ? አሮሄቴ አንተ ካሰጋታ አት መተካዉን ሄታታ። <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />አት እባዶነ ሻርሙጣኖ ላኮዶትሳሮ ካአማታ አትዋ ሻርሙጣታ፤ አት ቶልቻ ካዲዳታ ምን ካኤብ ሳማታ። <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />አት ሴራይ ካኮራታ ሴራ ባሳ ዋ የራሳታ። <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />ህክና፥ “ኣላንቲታትስኒ መገ ካዋ አይዛብ ዶሌ ሀባራምናራ” አማመ ጎጎጻፋመሮያ።<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />አት ሴራ ካሙሴ ካኦራቶ ጎሌተ ሀማጽሳማኖ ላኦ አቦዋ፥ ሴራ ካሙሴ ካባሳቶ ጎሌተ አት አደ ካሀማጺሳሞን ግሮ ኣን ላታ። <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />አንሀማጺሳሞን ኦግራን ሴራ ካሙሴ ካአጃጃሮ ካኦራታራን ጎሌን፥ ካሀማጺሳመሮ ኣን ላኮቶታማራንያ? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />አት፥ ካጻፋመራ ሴራ ካሙሴ ግራና ካሀማጺሳንቴቶ ሌተ ግራን ሴራ ጎባሴ ሶይ ካሀማጺሳሞን ግሮ ሌተ ሴራ ታኦራታ ታአይዛብ ኡና ኩ ጉት ፍርድናታ። <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />እባዶት ኮ ኦጉተ ኦላል አን አይሁድ ሌራ ጎአመ አይሁድ ላኮላሮ፥ ካሩም ሀማጽሳማኖ ካሳረ ካሶየ ሴራ ላኮዮ። <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />አየሱን ጎአመን እባዶት ኮ አይሁድ ካኮላራ ካኦሮ አዮናት አይሁድ ሊ ጎሙተያ፤ ሀማጽሳማኖ ካሩም ሀማጽሳማኖ ካኮላራ ካጻፋመሮ ሴራ ካሙሴይ አንሌኖኒ ግራን አያናይ ዎዳናኮ ሀማጽሳማኖ ጎሌያ፥ ሂካ ኣንክክ እባዶኮ ጋላታ ካኮሄላታራ ዋኮያ ኳሬ እባዶኮ ላኮዮ።<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s1">አይሁድኮክ አብድዋት</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />ሀያ አይሁድ ላኖኮት ላኦ መታ? ሀማጽሳማኖ መ ላኦ አባ? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />ማምስክ ራዲና አይሁድ ላኖ ላኦ ታሞጋንታ፥ ዱባንኮ ጣየ ሃፉራ ካዋ ሀዳራ ካኮንስሳመራ እሶንያ። <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />አይሁድኮ ኮኮና አማኖ ጎዋይግሬን አማኖ ዋትክሶ አብዳማኖ ካዋ ላኦ ካላይክ የላራ? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />ዱዶ ላኮየሎ! እባዶ ዱባ ጣራሜሳ ጎሌና፥ ዋ ጎአመን ካሩምያ፤</para>
  <para style="q1" vid="ROM 3:4">“ሃፉራካኮ ካከይ ካሩም ላታ፤</para>
  <para style="q2" vid="ROM 3:4">ዲናካና ፍርዳ አዎድናታ” አማመ ጎጎጻፋመሮያ።<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />ሜላነታን ቁሉማ ታዋ ኣሎ ታቱሳቶ ጎሌተ መ አምን ዳንዳና? ዋ ኖ ጉት ኤንገታቴሳ ኬናኖ ሩም ካፍርዳሮ ላኮዮ አማኖያ? ያዳ ካእባዶ አን አዬሳራ አማኖያ። <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />ኦግራን ሃ ሊን ላኮዳንዳሮ፤ ሂካማሌ ሊ ግረዋ ዋ አላም ጉት ምሲ ፍርድን ዳንዳራ?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />“አን ጣራሜሳ ላኖ ዋኮት ሩም ካቱሳሮና፥ ካባጃ ካአዳሮ ጎሌ፥ ጩባለሳ አማመ ግዳ ጊን ምስ ፍርዳማራ?” <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />“እዳነ ጎጎኤሜቶን ሜላነ ፈልና አማራን አማ እባዶ ኮኮ ጎጎአዬሳሬያ፤” ሂናኣ እባዶጃ ጉት ካግናራ ፍርዳ ልክያ።<verse eid="ROM 3:8" /></para>
  <para style="s1">ማዮና ቁሉክ ላኮግሮ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />ጎርታ መ አምናና ኖ እሶኮ ሮራና? ዱዶ ላኮሮራኖ፤ አይሁድና ሌረን አይዛብ፥ ጩቦ ኦሮ ግራኖ ጣይነ አዴስንሰ ሰግነና። <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />ሃ አማመ ጎጎጻፋመሮ፥</para>
  <para style="q2" vid="ROM 3:10">“ኮና ዱዶ ቁሉክ ላኮግሮ፤<verse eid="ROM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11" />ካሻዳራ ላግሮ፥</para>
  <para style="q2" vid="ROM 3:11">ዋ ካዶታራ ኮና ላግሮ።<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />ዱባና ሽርመራን</para>
  <para style="q2" vid="ROM 3:12">ራቶ ላኦ ካላይኒዕ ሌራን፥</para>
  <para style="q2" vid="ROM 3:12">ታኢዳን ካፈላራ ማዮና ዱዶ ላግሮ።”<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />ህኢትሶና ካሜላን አየስ አዬስን ካባናመ ጉምቢ ካቃማል ኣንትትታ፤</para>
  <para style="q2" vid="ROM 3:13">ኤሬብክሶና ሶባንጄ ጂናታራ፥</para>
  <para style="q2" vid="ROM 3:13">ህኢትሶኮ ካበያራ አየስ ማርዚ ታሀበሳ ኣንክክያ፤<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />ህኢትሶ ቃንጎና ካኦኮኮታሮ አየሲ ታአማጋንተታ፤<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />ሉቃኦትሶ እባዶ ላጋዲን ኦጄራራንያን፤<verse eid="ROM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16" />ካኮሴታራን ራክሶ ዱባ ባኖዉና ራኮዉን ኣላንቲያን።<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />ካኖጎዳ ራና ላኮካሳን።<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />“ዋ አብሳታኖ ሱረ እሶ ዶሌ ላኮሙታሮ።”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />ካሴራ አጃጃ ካኮንዶትሳራ ሴራ ሄገሊ ኦባራራዉን ላኖ ካንሶዋ፤ ህታ ኣላንቲ እባዶ ካኣላሮ ዋተረ ጫልኢ አማራ፤ አላም ዱባ ፍርዳ ካዋይ ካባሰሮ ልናራ። <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />ሃንሱን ሴራ ካሙሴ ኦራታኖይ ማዮና ዋይ ሆረ ቁሉክያ አማሚን ላኮዳንዳሮ፤ ሴራ እባዶ ዱባ ጩባለሳ ላኖ ቱሳራ።<verse eid="ROM 3:20" /></para>
  <para style="s1">አማኖ ታሄላማቶ ቁሉማ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />ግዳ ጎአመን ዋ እባዶ ካኮቁሎይሳራ ሴራ ካሙሴኮ ካለክ ራይ ላኖ ቱሳራ፤ ሂክ ሙሴይና ካሄገሮይ አቶታመራ። <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />ህት ታዋ ቁሉማ አሳብንጀ ካላይ የሱሳ ክርስቶሳ አማናኖይ ታሄላማቶ ቁሉማታ። <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />ኣላንቲና እባዶ ዱባ ጩቦ ፈለራ፥ እሶና ካባጃ ታዋ ዋተራን። <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />የሱሳ ክርስቶሳ ታሌተ ዎዶይ አዳ. ስኖቴሳይ ቁሎዬራን፥ <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />ዋ የሱሳ ክርስቶሳ ጃርሶ የለ ካኮንኬነራ ኡሱ ካአማናራ ዱባ፥ ኢግኬሳ ጩቦኮ ሀሄሶ አማማኖ ጎጎሄላሮንያ፤ ዋ ሂካ የላኖ ኦብስቴሳይ ካጣዎ ጩቦክሶ ካግኖን ኣን የለረ ካኬሳ ፍርዳ ቱስንያ። <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />ሂካ ጌሲ ዋ መተኬሳዉን ቁሉክ ላኖ ካቱሳራ የሱሳይ ካአማናሮ ዱባ ቁሎይሳኖይያ።<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />ሀያ ኖ ካኮዳና መያ ካግራ? ማመስና ላኮዳታኖ! ጎጎዳኖን ኣላንቲ መታ ታግታ? ሴራ ካሙሴ ማንኮኦራታኖ ማራንያ? ላኮዮ፤ አየሱን ጎአመን ኖና ካኮዳታና አማኖይያ። <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />ሃንሱን ዋ እባዶ ካኮቁሎይሳራ፥ እባዶ ሴራ ኦራታኖ አንሌኖን ግራን አማኖ ላኖ ካንሶዋ። <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />ዋ ካአይሁድ ሄዶ ካላልያ? ላ ካአይዛብ ሄዶኔዮላ? እ አይዛብዉና ሄዶያ። <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />ኣላንቲና ካሀማጺሳመና ካሀማጺሳሞን ግሮ አማኖ ካቁሎይሳራ ዋ ኮ ካላልያ። <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />ሀያ ሃ ጎሌ አማኖኮ ካከይ ሴራ ላኦ ካላይክ የልን ዳንዳና? እጂ ላኮዳንዳኖ፥ ሱረዋ ሴራ አታይሲን ኳሬ።<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s1">አብራመ አማኖ ቁሎየ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />ጎርታ ሶይ ካሆሬ ኦዶካን ካሌረ አብራመ ሂካ ጋራነ መ ሄላተ? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />አብራመ ፈሎይ ካቁሎየ ሊ ግረዋ፥ ካኮዳራ ግረዋ፤ አየሱን ጎአመን ዋይ ሆረ ዳይን ላኮዳንዴሮ። <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />ማጻፋ ቁሉክ መ አማራ? “አብራመ ዋይ አማነ፥ ቁሉክ ሌ ቶታመ” አማራ። <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />እባዶት ኮ ፈሎ ጎፈላተ ካፈሎ ዳሞዛ እላቦ ኣን አንሌኖን ግራን ፈሎኦቴሳን ካዶትሳሮ ኣን ቶታማራ። <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />እባዶ ፈሎ ኦኢዳን ፈልን ጎዋተና ዱዶ፥ ጩባልዬል ካቁሎይሳሮ ዋ ጎአማነ አማኖኬሳ ቁሉክ ሌ ቶታማራ። <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />ዳዉተና ቁሉማ ፈሎ ካላይ ካኮንቶታማታ እባዶት ካሶማሳመ ላኖ ቱስን፥<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“ባስክሶ ሀሄሶ ካኮንአማመራና</para>
  <para style="q2" vid="ROM 4:7">ጩቦክሶና ሀሄሶ ካኮንአማመራ እባዶ ካሶማሳመያ።<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />ጎታ ጩቦ፥ ዱዶ ካኮን ቶትኖን እባዶ</para>
  <para style="q2" vid="ROM 4:8">ካሶማሳመያ!” አመ አዬሰራ።<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />ሂኒዕ ሶማ ኦሀማጺሳሜራን ኦላሉንያ ሙ ኦሀማጺሳሞቱኔያ? ካአብራመ አማኖ ቁሉክ ሌ ቶታመ አምነና።<verse eid="ROM 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 4:10" />ሀያ ምሲ ቶታመ? ሀማጽሳማናኮ ዳንበኔያ ሙ ሀማጽሳማናኮ ሆረነያ? ኡሱን ካኮቶታመራ ሀማጽሳማናኮ ዳንበኔ አንሌኖን ግራን ሀማጽሳማናኮ ሆረነያ። <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />አብራመ ጋና ሀማጽሳማኖኮ ሆረነ አማኖኬሳ ቁሉክ ሌ ጎጎቶታመሮ ማላታ ኡሱን ጎጎሌሮን ሀማጽሳመ፤ ሃንሱን አብራመ፥ ሀሃማጽሳሞን ኦአማኔራኑና አማኖክሶ ቁሉክ ሌ ካኮንቶታማሮ ዱባን ኦዶያ። <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />ኡሱ ኦሀማጺሳመራኑና ኦዶያ፤ ኦዶ ካኮንሌራና ሀማጽሳማኖ ካላል አንሌኖን፥ ኣቦካን አብራመ ሀማጽሳማኖኮ ጣየ ካግረ አማኖኮክ ራድ ኦሰሴታራዉኔ አደረ ኦዶያ።<verse eid="ROM 4:12" /></para>
  <para style="s1">ጋራ ካአማኖ ታስሳንተቶ አብድ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />አብራመና ሳኒቴሳ አላም ጎጎኤልቶን ዋ አብድ ካኮስሰራ አማኖ ታሄላማቶ ቁሉማያ ኳሬ ሴራ ኦራታኖይ ላኮየ። <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />ሴራ ካሙሴ ኦግራን አብድ ኦኤላራን ጎሌን፥ አማኖ ላኦ ካላይክ፥ አብድና አዳት ሊ ግራተ። <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />ሴራ ካሙሴ ኤንገ ታዋ ኬናራ፤ ሴራ ካሙሴ ግር ዋተዋ አድ ባስ ላኮግራረ፤<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />ሃንሱን አብድ ካኮባተታ አማኖ ጉቲየ፤ ህት አብድ ታአብራመ ሳኒ ታሌተቶ ዱባን ዋኮ ስኖይ ታስሳንተቶ ላኖ ሂካኒ አዴሳመራ። ሂክ ሴራ ካሙሴ ካሰሴታሮ እባዶ ዱባን አንሌኖን ግራን አብራመ ኣን ካአማኔሮ ዱባንያ፤ ሂካኒና አብራመ ካዱባ ኦዶያ። <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />ጋራ ካአብራመ፥ “ካሞጋን ጎሳን አን ኩ ኦዶ የለራ” አማመ ጎጎጻፋመሮያ፤ ኡሱና ካጎየሮ ጎይኮ ካኬሳሮ፥ ካግኖና ካግሮ ኣን ካየላሮ፥ ካአማኔሮ ዋይ ሆረ ኡሱ ኦዶካንያ። <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />“ሳኒታና ሂካማሌ ልናታ” አማመ ኡሱን ካሰጋመሮክ ማለ፥ ኮና አብድ ማንኮግኖት፥ አብራመ አማኔረ ካሞጋን ጎሳን ኦዶ ሌ። <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />አብራመ ጌስ ቦልክ ጃርሳ፥ ማርኬሳ ካዋተና፥ ታሳራ ገዴም ታኡሙሎን ላኖ አዴሳ ግራን አማኖኬሳ ላኮሀረ። <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />ጎሌና አማኖ አታተረ ዋዉን ካባጃ ስሰ ኳሬ ታዋ አብድ ላኮሄዳተረ። <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />ዋ ኡሱን ታስሰሮ አብድ ካፈልናሮ ላኖ ዎዳና ታአማጋንቴ አብዳታ ግረ። <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />ሃንሱን አማኖኬሳ ቁሉክ ሌ ቶታመ። <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />“ቁሉክ ሌ ቶታመ” ካአማመራ ሃፉራ ካኮጻፋመረ ኡሱ ካላሉን ላኮዮ። <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />አየሱን ጎአመን ዋ ቁሉክ የለ ኖ ካቶታሮን፥ ጎታካን የሱሳ ጎይኮ ካኬሰሮይ ኡሱ ኦአማናኖ ኖዬነያ። <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />ኡሱ ጩቦካን ማራን ጎይን ሮረ ካስሳመሮና ኖና ቁሉኒዕ የልን ጎይኮ ኬ።<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s1">አማኖ ታሄላማቶ ኖጎዳና ዎጋርስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />ጎርታ ኖ አማኖ ማንኮቁሎይነ ማራን ጎታካን የሱሳ ክርስቶሳ ቶንሴ ዋኔ ዎታ ኖጎዳ አብና። <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />ኡሱ ቶንሴ ግዳ ታኮአልነኖ ህታ ስኖ አማኖ ቶስ ታብን ዳንዴነና፤ ካባጃ ታዋና አብድ የላታ ገጌላታና። <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />ሂካ ካላሊ አንሌኖን ግራን ራኮ ኦብስ ሄላምሳኖ ማንኮካንሶ ማራን ራኮታን ኦሮ ግራና ዳታና። <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />ኦብስኮና ጫፍቲ አታታኖ፥ አታንኮና አብድ ሄላማታ። <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />ካስሳመሮ አያና ቁሉክኮክ ጋራነ ጌላንጀ ታዋ ዎዳናታን ማንኮአማጋንተ ማራን አብድቴሳ ላኮሙልሳቶ።<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />ጋና ላፋኒዕ ሌነ ግራን ክርስቶሳ ገስኬሳ ካኮገያረ ጎራታ ጩባልየሉን ጎየራ። <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />ቁሉክ እባዶትኮት ባንኤ ካጎሮ ሄላኖ ኣሎ ካጢብሮያ፤ ኡሱማለና ካእዳንክ እባዶት ማራን ጎይን ካዶታራ ዎዳሳ ካሄላምሮ ሌራ። <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />አየሱን ጎአመን ኖ ጋና ጩባለይ ሌነ ግራን ክርስቶሳ ኖ ማራን ጎየራ፤ ህክና ዋ ኖን ታአቦ ጌላንጀቴሳ ቱሰራ። <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />ጎርታ ኖ ካኮቁሎይነና ካየሱሳ ክርስቶሳ ኢግ ጎሌ ዱዶና ኖ ኤንገ ታዋኮ ካኮሄስናና ኡሱ ቶንሴያ! <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />ኖ ዋዉን ዲና ሌነ ግራን ኤረኬሳኮክ ጎይ ዋኔ ዎታ ዎጋርነና፤ ግዳ ዋኔታ ዎጋር ጎአባባነ ኤረኬሳክ ግር ቶንሴ ሱረ ፋይናና። <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />ሂካ ካላል ላኮዮ፤ ዋኔ ዎታ ዎጋርስ ካኮሄላነኖ ጎታካን የሱሳ ክርስቶሳኮት ምናነ ዋ ኖን ካፈለሮን ገጌላታና።<verse eid="ROM 5:11" /></para>
  <para style="s1">ጎይ ጋራ ካአዳመነ ግር ጋራ ካክርስቶሳነ</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />ሃንሱን ጩቦ እባዶት ኮኮት ኣላንቲ አላም ቶስ ታበ፤ ጩቦኮት ኣላንቲ ጎይ ኤመተ፤ ኡሱማለና እባዶ ዱባ ጩቦ ማንኮፈለሮ ማራን ጎይ እባዶ ዱባ ጉት ኤመተ። <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />ሴራ ካሙሴ ስሳማኖኮ ሆረነ ጩቦ አላም ግረ፤ ሀሌዎ ኳሬ ሴራ ማንኮግኖት ጩቦ እሲ ጩቦ ኣን ላኮቶታማረ። <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />ሀሌዎ ኳሬ አዳመ ኣን ሴራ ካዋ ባስ ጩቦ አንፈሎን ኦግራን ጉት አደ ጎይ አዳመኮ ሀጋአበረ ታ ሙሴ ጌሮ እባዶ ዱባ ጉት ሬደ።</para>
  <para style="p" vid="ROM 5:14">ሂክ አዳመ ሆረንባን ካኤሜይናሮ ክርስቶሳን ማሱሳየ። <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />አየሱን ጎአመን ስኖ ታዋኮክ እላቦ ጩቦ ካእባዶትኮክ ጅልባ ኣን ላኮየ፤ እባዶት ኮ ካፈለሮ ጩቦኮት ኣላንቲ ካሞጋን እባዶ ጎየ፤ ኡሱማሌ ስኖ ታዋይና እባዶት ኮ የሱሳ ክርስቶሳኮት ኣላንቲ ካሄላመራ ካስኖ እላቦ ካሞጋኑን አማጋመ ሮረ ስሳመራ። <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />ኡሱማለና ዳናባክ እላቦ ካዋ ታኬነራ ስኖኮት ላኦ፥ እባዶት ኮኮክ ጩቦ ታኬናሮ ላኦ ኣን ላኮዮ። እባዶት ኮ ካፈለሮ ጩቦኮት ኣላንቲ ካስሳመራ ፍርዳ ሙሮ ኬነ፤ ካሞጋን ጩቦኮክ ኣላንቲ ዳናባ ካስሳመራ እላቦ ቁሉማ ኬነ። <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />እባዶት ኮ ካፈለሮ ጩቦኮት ኣላንቲ ጎይ እባዶ ዱባ ጉት ጎሬደ ታአማጋንተ ስኖ ታዋና ዳናባክ እላቦ አታተረ ካቁሎየ ዱባ እባዶት ኮ የሱሳ ክርስቶሳኮክ ጋራነ ካአመን ዱባ አዎደ ኔፎነ ግራራ።<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />ጎርታ አዳመ ኮክ ጩቦ፥ ካሙሮ ፍርዳ እባዶ ዱባ ጉት ጎጎኬነሮ፥ ኡሱማሌ ክርስቶሳ ኮ ኮኒዕ ቁሉኒዕ ፈሎ ካሞጋን እባዶ ሙሮኮ ባልቹማ ቤሰረን ግር ስሳራን። <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />አዳመ አጃጃ ዲዳኖኮክ ኣላንቲ ካሞጋን እባዶ ጩባለሳ ጎጎሌሮ ኡሱማለና ክርስቶሳ አጃጃማኖኮት ኣላንቲ ካሞጋን ቁሎዋራ። <verse eid="ROM 5:19" /><verse number="20" style="v" sid="ROM 5:20" />ሴራ ካሙሴ ኤሜታኖኮ ካከይ ባስ ሞጋተ፤ አየሱን ጎአመን ጩቦ ታኮጂናቴ፥ ስኖ ታዋ ኖን ጂናተ። <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />ህክና ካኮንሌራ ጩቦኮት ኣላንቲ ጎይ ጎጎሬደሮ ማለ፥ የሱሳ ክርስቶሳኮክ ጋራነ ጅሩ ጅሮማክ ግር ጎጎሄላምሮ ስኖ ታዋ ቁሎይሳኖይ ሬድናታ።<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s1">ጩቦኮ ፋክም ክርስቶሳነ ዎታ ግራኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />ጎርታ መ አምና? ስኖ ታዋ ጎጎሞጋቶን ጩቦ ፈላ ግርኖ? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />ላኮሃዮ! ኖ ጎነኔ ካለ ቤኔ ኦዎዩይነኖ ኣን ሌነ ግራን፥ ምሲ ጩቦይ አታይ ግርናና? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />ክርስቶሳነ ዎታ ኮ ጎጎሌኖን ኦጣማቃምነኖና፥ ጎይኬሳነ ዎታ ኮ ሊን ካጣማቃምነኖ ላኮካሳንያ? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />ሃንሱን ክርስቶሳ ታኦዶ ካባጃ ጎይኮ ጎጎኬሮ ኖና ኡሱማሌ ካኡሱብክ ግር ጎጎግርኖንያ፤ ጎነኔ ኡሱነ ዎታ ቃማላምነና።<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />ጎይኬሳ ኡሱነ ዎታ ኮ ጎሌነ ክያኖኬሳና አድ ኦግራን ኡሱነ ዎታ ኮ ልናና። <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />ጩባለሳክ ማርካን ጎጎባሮና ጩቦኮክ ድይል ላኖካን ጎጎሄስሮን ታዶአን ያዳሊታን ክርስቶሳነ ዎታ ሱዋማኖ ካንሶዋ። <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />ኣላንቲና ካጎየ እባዶ ጩቦኮ ባልቹማ ቤራ። <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />ኖ ክርስቶሳነ ዎታ ጎጎነ ኡሱነ ዎታ ካግርናኖ አማናታና። <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />ክርስቶሳ ጎይኮ ኬራ፤ ካላም ጎዋናዋት ጎይ ጎርታ ኡሱ ጉት ኦዶናት ዋታኖ ካንሶዋ። <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />ኡሱ ካኮጎዋረ ጎራታ፥ ጎይ ኮ ካላል ጩቦን ጎየራ፤ አየሱን ጎአመን ኔፎነ ጎግሮ ዋዉን ግራራ። <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />ጎርታ እስን ካጎተታን አን ጩቦኮ ፋክ ጎጎአንተታና ካየሱሳ ክርስቶሳ ጋራነ አደ ዋዉን ኔፎነ ጎጎግታን ሄዳ።<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />ሃንሱን ሀልቻ ካሜላን ፈልጉዴን ካጎዋሮ ማርክስን ጉት ጩቦ ጎጎሬድሮን አሮየልቴን። <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />ማርክስን ካሜላን ሁ የላይ ጩቦን አሮስሴን፤ ሀሱኮና ጎይኮ ግር ቶስ ካናቀሮ እባዶ የላየንዴን እስኦትስን ዋዉን ስሳ፤ ማርክስና ቁሉክ ሁ የላዴን ዋዉን ስሳ። <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />ግዳ እስን ካኮግታን ስኖኮ ሄገሌ ኳሬ ሴራኮ ሄገሌ ማንኮሌኖን ማራን ጩቦ እስን እምንን ላኮዶትሳሮ።<verse eid="ROM 6:14" /></para>
  <para style="s1">ካቁሉማ ድይል</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />ጎርታ መ አምና? ሴራ ካሙሴኮ ሄገሊ አንሌኖን ግራን ስኖኮ ሄገሌ ማንኮግኖ ማራን ጩቦ ፈልኖ? ዱዶ ላኮዶትሳሮ። <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />እባዶት ኮዉን ካሀንዳሮ ሊ አጃጃምን እስኦትስን ጎስሳታን ሀሱ ካኮአጃጃማታን እባዶትን ድይ ላኖክስን ካሳንዋ፤ ኡሱማሌ ጩቦን ጎአጃጃንቴን ጎይ ካኬናሮ ጩቦን ድይል ላታን፤ ዋዉን ጎአጃጃንቴን አድ ቁሉማ ሄላይናታን። <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />እስን ጣይተን ካጩቦ ድይቴን፤ ግዳ አደ ካአታቴታን አጋልስሲ ዎዳናኮ አጃጃማኖይ ዋዉን ጋላታ ሀጌዎ። <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />ጩቦኮ ባልቹማ ቤተደን ካቁሉማ ድይል ሌቴታን። <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />አን ሂካማሌ እባዶን ታታባቶ ሄኢ ካኮንአየሳራ ያዳክሶክ ላፉማኮ ካኬይያ። ጣየ ካማሬ ምክታጆልክስን ካባቲና ካሜላነ ድይጆል የልቴዴን ጎጎኬንቴቴን ማለ ኡሱማሌ ግዳ ካማሬ ምክታጆልክስን ጎጎቁሎይሮ ቁሉክ ካሀንዳሮ የላዴን ስሳ።<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />ጩቦን ድይ ሌተን አሮግቴን ቁሉማኮ ሳሬ ግቴን። <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />ግዳ እስን ካኮሙልተታን አየስኮ ኤሰ አሪ መ ላኦ ሄላቴተን? ሀሱ አዬስኮክ ዎረኤ ጎይያ። <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />ግዳ ጎአመን ጩቦኮ ባልቻ ቤተን ድይል ካዋ ሌቴታን፤ ሂካ ሀንዳኖይ ቁሉማ ሄላይናታን፤ ቁሉማኮት ጋቾ ጅሩ ጅሮማክ ግርያ። <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />ካጩቦ ዳሞዛ ጎይያ፤ ካዋ እላቦ አደ ጎታካን የሱሳ ክርስቶሳ ካሄላማሮ ጅሩ ጅሮማክ ግርያ።<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s1">ካሴራ ሻኖኮ ባልቹማ ብያኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />አቢላልቴ! ሴራ ካካሶ እባዶን አዬስናራ፤ ሴራ እባዶት ኮይ ጉት ኦዶናት ካኮአባ እባዶት ኔፎነ ግራን ካላል ላኖ ላኮካሳንያ? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />ታኬሳንቴታ ሄለልትቲ ቶ ኤንተርነ ዎታ ሴራ ታሽያንተ ካኮላታ ኡሱ ኔፎነ ግራን ካላልያ፤ ኤንተር ጎጎየ አደ ካኬሱኔ ሴራኮ ሳሪ ብያታ። <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />አየሱን ጎአመን ኤንተር ኔፎነ ግራን ካካለ እባዶን ጎኬሳንተ ሻርሙጢተታ አማማታ ኤንተር ጎጎየ አደ ካካለ እባዶን ጎኬሳንተ ሀሱ ሴራኮ ታፉራንተ ላታ፤ ካካለ ባባሩን ጎኬሳንተ ሻርሙጣ ላኮአማማቶ። <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />ሃንሱን አቢላልቴ! እስና ኦክርስቶሳ ማንኮሌተን ማራን ጎየረ ካለካቤ ኣን ሴራኮ ፋክንቴታን፤ ህክና ካካለቱን ጎይኮ ካኬሮ ኡሱ ሊዴን ዋዉን ኢል ጎጎየላኖንያ። <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />ሀልቻ ካሶየት ታኮሰሰታኔ ሴራይ ካከኬሳረ ካሜላን ሀልቻ ታጎይ ኢል ጎጎየላኖ ማርካንኮክ ምክታል ኦሮ ፈላ ግረ። <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />ግዳ ጎአመን ጣየ ቅቂሰ ሽየ ካግሬን ጎነኔ ሴራኮ ባልቻ ቤነና። ህክና ካኮንሌራ ካዶአንክ ካሌሮ ካጻፋመሮ ሴራ ካሙሴን አንሌኖን ግራን ካኡሱብክ ካአያና ራድ ጎጎሀንዳይኖንያ።<verse eid="ROM 7:6" /></para>
  <para style="s1">ሴራ ካሙሴና ጩቦ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />ጎርታ መ አምና? ሴራ መተኬሳን ጩቦያ? ዱዶ ላኮጩቦዮ! አየሱን ጎአመን ሴራ ቶንሴ ልዋተዋ፥ ጩቦ መዮ ላኮአዴሳረ፤ ሴራ “አሮሀልቺተ” አምዋተዋ፥ ሀልቻ መዮ ኦግራን አን ላኮማላበረ። <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />ጩቦ ሴራኮ ካኤመተሮ አጃጃ ህጣ ሄላተረ ሀልቻ ዱባ እዬ ኦሮ ጎጎከኬሮን የለ። ሴራ ጎዋታመ አደ ጩቦ ካጎየ አዬስያ። <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />ሴራ አንግኖን አን ኔፎነ ግረ፤ አጃጃ ጎኤመተኮ አባባተረ አደ ጩቦ አርዶክ ሌ፤ አን አደ ጎየ። <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />ግር ስስሮዋ አማመረ ካስሳመረ ካሴራ አጃጃ እዬ ጉት ጎይ ኬነራ። <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />ጩቦ ካሴራ አጃጃ ኣላንቲ የላተረ እን ሶበራ፤ አጃጃኮክ ጋራነና እን ላጋደ።<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />ሃንሱን ሴራ መተኬሳን ቁሉያ፤ አጃጃና ቁሉክ ካሩሚና ካእዳንክያ። <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />ሀያ ሂክ ካእዳንክ ካሌረ አየስ ኢን ጎይ ኬነራ አማኖያ? ዱዶ ላኮሃዮ፤ አየሱን ጎአመን ጩቦ ጩቦ ሊ ጎጎአዴሳምሮን ካእዳን ካሌሮ አዬስኮክ ጋራነ ጎይ ኬነ፤ ህክና ጩቦ አጃጃኮክ ጋራነ ኣሎ ጩባለሳ ሌ።<verse eid="ROM 7:13" /></para>
  <para style="s1">ግር ካእባዶት ኦሮ ካግሮ ካጩቦ ሞአባታኖ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />ሴራ ካአያና ላኖ ካንሶዋ፤ አን ጎአመን ጩቦን ድይ ኣን ካዳዳላመሮና ሶ ካሳርሳየሮያ። <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />አን መተኬዉን ካፈላሮ ላኮካሶ፤ አን ካዶታማሮ አየስ ፈላኖ ኢሰጉረ ካትራማሮ አየስ ፈላራ። <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />አን ፈልን ካዶቶን ካፈላሮ ጎሌ ሴራ ካእዳንክ ላኖ አቶታራ። <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />ሃ ጎሌ ሂካ ካየላራ አን ኡሱን መተኬይ አንሌኖን ግራን እዬ ኦሮ ካግሮ ጩቦያ። <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />እዬ ጎርቱን ጩባለሳ ታሌተቶ መጣ ኦሮ ኮና ካእዳንክ አየስ ግራናዋት አን ካሶዋ፤ ካእዳን ካሌሮ ፈልን ሀልቻ አባ፤ አየሱን ጎአመን ፈልን ላኮዳንዳሮ። <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />አን ግዳ ፈላ ካግራ ፈልን ካዶትሳሮ ካእዳንክ አየስ ላኮዮ፤ አየሱን ጎአመን አን ፈልን ካዶትሶን ካሜላን ፈላራ። <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />አን ፈልን ካዶትሶን አየስ ካሜላን ካፈላሮ ጎሌ ሀሱ ካፈላራ አን መተኬይ አንሌኖን ግራን እዬ ኦሮ ካግሮ ጩቦያ።<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />ሃንሱን አን ሂካ ሴራ ፈላ ካግሮ ላኖ አዴሳየራ፤ ህክና አን ካእዳን አየስ ፈልን ዶታ ግራን ሜላነ እዬ ኦሮ ግታ። <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />ኦሮኦተይ ሴራ ካዋይ ገጌላታራ። <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />አየሱን ጎአመን ማርኬይ ኦሮ ካፈላራ ካጩቦ ሴራ እን ካሽያመ የልስሰ፥ ሳሙቴክ ሴራነ ዎታ ጄረን ካሻፋታራ ካካለ ሴራ ማርኬይ ኦሮ ፈላ ግራን ድያራ። <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />አን ምስክ ላፋክ እባዶትያ! ሂካ ጎይን ካስሳመሮ ማርኬኮ አዮያ እን ሃስን ካዳንዳራ? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />ጎታካን የሱሳ ክርስቶሳኮት ምናነ ጋላታ ዋዉን ሀጌዎ!</para>
  <para style="p" vid="ROM 7:25">ጎርታ አን ሳሙቴይ ሴራ ካዋዉን ድይ ጎሌሮ ታሶየ ያዳሊቴይ ሴራ ካጩቦን ድይ ሌራ።<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s1">ግር ካአያናና ካሶየ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />ሃንሱን የሱሳ ክርስቶሳ ኦግራን ግዳ ቃንጎ ላኮአባን። <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />ኣላንቲና ግር ካስሳሮ አያና ቁሉኮክ ሴራይ የሱሳ ክርስቶሳ ጩቦኮና ካጎይ ሴራኮ ባልቹማ ቤሰራ። <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />ታእባዶ ጩባለሳት ያዳሊኮ ካከይ ሴራ ካሙሴ ፈልን ካዋተረ ዋ ፈለራ፤ ኤረኬሳ ጩባለሳ እባዶኮክ ማሱሳይ ጩቦኮት ኣላንቲ ፋረረ ሶኦቴሳ ጩቦ ፍርዴረ ባሰ። <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />ሂካና ካኮንየለራ ፈኢ ታሶየ አንሌኖን ግራን አያና ቁሉክ ኦሰሴታኖ ኖዬን ሴራ ካሙሴኮክ አጃጃ ፈሎ ጎጎሀይሮያ። <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />ሶ ካሳርሳተሮ እባዶ ኦሮ ታግቶ ፈኢ ታሜላን ማለ ኦግራን ዎዳናትሶ ሶኮክ ሀልቻ ጉት ካታራን፤ አደን አያና ቁሉክ ማለ ኦግራን ዎዳናትሶ አያና ቁሉክ ሀልቻ ጉት ካታራን። <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />ካሜላን ካሶየ ሀልቻ ቆፓኖ ጎይ ኬናራ፤ ካአያና አየስ ቆፓኖ አደ ግርና ኖጎዳ ስሳራ። <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />ጩቦ ታኢምናማታ ሳሙ ዋኔ ዎታ ዲናታ፥ ሴራ ካዋቱና ላኮኢምናቶ ኢምናሚና ላኮዳንዳቶ። <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />ካሜላን ሀልቻ ካሶየቲ ካኢምናማራ ዋ ገጌላይስን ላኮዳንዳሮ።<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />እስን አዴን አያና ካዋ እስን ኦሮ ካግሮ ጎሌ፥ ካሜላን ሀልቻ ካሶየቱን አንሌኖን ግራን አያና ግታን። ማዮና ካክርስቶሳ አያና ጎግኖን ኡሱ ካክርስቶሳ ላኮዮ። <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />አየሱን ጎአመን ክርስቶሳ እስን ኦሮ ጎግረ፥ ማርክስን ጩቦኮ ካከይ ካጎየ ጎሌና፥ አያናክስን እስን ዋይ ቁሉክ ላኖኮ ካከይ አርዶክያ። <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />የሱሳ ጎይኮ ካኬሰራ አያናኬሳ እስኒ ካግሮ ጎሌ፥ ክርስቶሳ ጎይኮ ከኬሰረ እስን ኦሮ ካግራ አያናኬሳ ካጎዋሮ ማርክስኑና ግር ስስናራ።<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />ሃንሱን አቢላልቴ! ኖ አንዛ አብና፤ ህት አንዛ ካሜላን ካሶየ ሀልቻኮት ፈኢ ማለ ግርን ላኮዮ። <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />ካሜላን ሀልቻ ካሶየኮት ፈኢ ካግታን ጎሌተን ጎይን ግታን፤ ኦሜላን ፈሎ ኦሶየ አያናይ ጎላጋዴን አድ ኔፎነ ግርናታን። <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />አያና ካዋይ ኦሰሴታራን ዱባ ይስ ካዋያን። <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />ሃንሱን፥ “ኣቦ! ኣቦካን” አም ካኮኡማኖ ካይሱማ አያና አታቴታን ኳሬ አብሲ ግርን አደን ካላም ካድይ አያና ላኮአታቴታን። <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />አያና ካዋ አያናካንነ ዎታ ሌረ ይስ ካዋ ላኖካን ኖን አቶታራ። <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />ጎርታ ኖ ይስ ካዋ ጎሌነ አንዴ ኡሱ ኖን ካኤካሰሮ አታይናና፤ ክርስቶሳነ ዎታና አታይናና፤ ግዳ ክርስቶሳነ ዎታ ራኮ ኦአታታኖ ጎሌነ አባባይነ ካባጃቴሳኮ ኦአታታኖ ልናና።<verse eid="ROM 8:17" /></para>
  <para style="s1">ኤመይን ታግቶ ካባጃ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />ታግዳኔ ራኮ ሆረንባን ኖዬን ታሙትናቶ ካባጃነ ዎታ ጎሄረግንሶ ማመንሰ ዎታና ቤላምሲን ካዳንዳሞን የለ ቶታራ። <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />መጣ ዱባ ይስ ካዋኮት ሙታኖ ካአቲ ሀልቻኖይ ኦራታታ። <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />መጣ ዱባ አዳት ጎጎሌቶን ፍርዳመራ፤ ህክና ፈኢቴሳ አንሌኖን ግራን፥ አብዲ ጎጎኦራኖን ካየለራ ፈኢ ታዋይያ። <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />አብድቴሳና መጣ እሲ ካባይ ድይናትኮ ባልቹማ ብደ ይስ ካዋኔ ዎታ ባልቹማና ካባጃ ታሄዴዳማቶ ጎጎሌቶንያ። <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />ግዳ ጊን መጣ ዱባ ካኡሙላ ጎራታይ ካግሮ አቦሳ አን ሙዳማ ጉት ግራኖ ካንሶዋ። <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />አየሱን ጎአመን ሙዳማ ጉት ታግታ መጣ ታላል ላኮቶ፤ ካሆራርጄ፥ አያና ቁሉክኮክ እላቦ ኦአታኔና ኖና ማርካንክ ዎዶ ካሌሮን ይስ ካዋ ላኖኮት አብድ ኦራታ ካኦሮ ማርካን ሙዳም ጉት ግና። <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />ኖ ካፋይነና ህታ አብዲያ። አየሱን ጎአመን ኖ አብድ ካየላታና ካሙታሮ አየስ ጎሌ አብድ ላኮቶ፤ ካሙታሮና አብድ ካየላታራ አዮያ? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />አየሱን ጎአመን ጋና አንዴኖን ግራን አብድ ጎየላነ አንዴ ኦብሲ ኦራታና።<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />ኡሱማለና ኖ ምሲ ኤባይን ዶትሳሮ ማንኮካሶን ማራን አያና ቁሉክ ሀራኖካን ጋርጋራራ፤ ሃፉራይ ሙትን ካዳንዳሞን ሙዳማ ኖን ሆረሃየ ጋርጋራራ። <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />ዎዳና ታእባዶ ካቆቆራራ ዋ ካአያና ያዳ ካሶዋ፤ ኣላንቲና አያና ዋኮት ፈኢ ማለ ቁሎሌዉን ሆረሃየ ጋርጋራራ።<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />ዋ ኦጌላታራዉና ያዳኬሳክ ማለ ኦኡማመራኑን፥ አየስ ዱባ ኢዳነን ካፈላመሮ ላኖ ካንሶዋ። <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />ዋ ጣየ ኦአዴሰሮ ኤረኬሳት ምዲ ኣን ጎጎሌራዉን ጣየ ሙርቴሰራ፤ ህክና አቢላል ታሞጋን ኦሮ ኡኑ ባርክ ጎጎሌሮንያ። <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />ኡሱ ጣየ ኦሙርቴሴሮ ኡመራ፤ ኦኡመሮና ቢሰራ፤ ኦቢሰሮና ካባጄራ።<verse eid="ROM 8:30" /></para>
  <para style="s1">ክርስቶሳ ታሙተቶ ጌላንጀ ታዋ</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />ጎርታ ሂካ መአምና? ዋ ኖኔ ዎታ ጎግረ፥ አዮያ ካኔባታራ? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />ዋ ኮ ኤረኬሳን ሀነኔኤይሳኖን፥ ኖ ዱባን ሮርሰ ካስሰራ ምሲ ኤረኬሳነ ዎታ ካመን ዱባ ኖን አዳ. ስሳናዋታራ? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />ዋ ኦአሳባተሮ ካሞታራ አዮያ? ካቁሎይሳራ ዋያ። <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />ሀያ ካፍርዳራ አዮያ? ካጎየራ፥ ኡሱማሌ ጎይኮ ካኬራ፥ መርጌ ታዋይ ካሀማጼራ ክርስቶሳ የሱሳ ኖ ማራን ሆረሃየ ጋርጋራራ። <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />ታክርስቶሳ ጌላንጀኮ ኖ ትርን ካዳንደራ አዮያ? ራኮታ ሙ አቦሳ? ሆሮራማኖያ ሙ ኡኢያ? ሃዉአይታ ሙ ዳኖታ? ሙ ጀሬንያ? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />ህክና፥</para>
  <para style="q1" vid="ROM 8:36">“ኩ ማራን፥ አሪ ዱባ ጎይነ ዎታ ሞአባታና፤</para>
  <para style="q2" vid="ROM 8:36">ካኤናኣምናሮ እዳድ ኣን ቶታመ።”</para>
  <para style="m" vid="ROM 8:36">አማመ ጎጎጻፋመሮያ። <verse eid="ROM 8:36" /><verse number="37" style="v" sid="ROM 8:37" />ጎርታ ኖ ካጌላተሮ ክርስቶሳ ኦአዎዳታራንኮ ኖ ሮራና። <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />አን ሂካ አዴሰራ፥ ጎይ ጎሌና፥ ግር ጎሌና፥ ኤርግቻ ጎሌና፥ ኦዶናት ኦአባን ጎሌና፥ ኔፎነ ካግሮ ጎሌና፥ ካኤሜታሮ ጎሌና፥ ሁናጆል ጎሌና፥ <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />ጦቂ ካአመ ጎሌና፥ ር ካአመ ጎሌና፥ ማምስት መጣና ጎሌተ፥ ጎታካን የሱሳ ክርስቶሳ ታሄላነኖ ጌላንጀ ታዋኮ ኖ ትርን ካዳደራ አየስ ኮና ግርዋት አን አዴሰራ።<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s1">ዋ ካእስራኤል ጎሳ አሳባኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />አን ክርስቶሳ ሌረ ሩም አዬሳራ፤ ጣራ ላኮአዬስናሮ፤ አያና ቁሉክ ታሰሴያታ ሳሙት አን ጣራ ካአዬሶን ላኖ አቶታታ። <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />ካንጂን ጋዳና ካኢሶን ያዳ ዎዳናቴይ ግራ፤ <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />ሶይ ፋልኬ ኦሌራን ማራና ኡናቴዉን አመረ አን ክርስቶሳኮ ካለ ብረ ቃንጎ ካዋ እን ጌዋ ጌላታረንዋ። <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />እሶና ጎሳ ካእስራኤልያ፤ ዋ እሶ ይስኬሳ የላተራ፤ ካባጃቴሳ ቱሰ፤ ካአማቶ ሃፉራ ታበ፤ ሴራና እሶን ስሰ፤ ቁሉክ ምን ካዋኮክ ሴራ እሶን ቱሰ፤ ካአብዲ ሃፉራ እሶን ስሰ። <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />እሶና አላታንትሶይ ካጎሳ ኦዶላኮ ኦኤሜተራንያን፤ ክርስቶሳና ሶ ሳርሳተ ካኤመተራ ሳኒታትሶኮያ፤ ኡሱ ዱባንኮ ካጉተያ፤ ጅሩ ጅሮማን ካሶማሳመ ዋ ሄዶያ! ሀሚኒዕ።<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />አየሱን ጎአመን ሃፉራ ካዋ ኢግልሳመራ አማኖ ላኮዮ፤ ታእስራኤል ሳኒ ዱባ ካሩም እስራኤል ላኮያን። <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />ኡሱማለና ታአብራመ ሳኒ ዱባ ይስ ካአብራመያ አማኖ ላኮዮ። ዋ አብራመነ፥ “ሳኒ ኩን ካኮብናታ ይሳቃያ” ማንኮአመ ማራንያ። <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />ሃንሱን ሶ ሳርሳተ ካአላተራ ዱባ ይስ ካዋ ላኮዮ፤ አየሱን ጎአመን ሳኒ ሌረ ካቶታማራ ካአብዲ ሃፉራ ካኮንታበሮ ይስ ካላሉንያ። <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />ሂክ ዋ ካስሰራ ካአብዲ ሃፉራ፥ “ካኤሜታሮ ጌሲ ሂካ ጎራታ አን ኤመይናራ፤ ሳራና ባባርትት ኡሙልናታ” ካአማሮየ።<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />ሂካ ካላል አንሌኖን ግራን፥ እርብቃ፥ ካጎሳ ኣቦካን ካሌሮ ይሳቃኮ ላኩ ይስ ካኮቶተተ ጎራታ፥ <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />አሳባኖ ካዋ ፈሎይ አንሌኖን ግራን ኡምቲ ላኖ ቱስን ይስ ላማ ኡሙላማኖኮ ሆረነና ሜላነ ሌተቴ ኢዳነ ፈላኖኮ ሆረነ፥ <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />ዋ እርብቃኔ “ካንጂን ክጫሩን ካአጃጃምናሮ ሌራ” አመ። <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />ህክና “ያይቆባ ጌላየ፤ ኤሳዉ አደ ዲደ” አማመ ጎጎጻፋመሮያ።<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />ጎርታ መ አምና? ዋ ኡሉልሳራ አምን ዳንዳና? ዋ ኢጂ ላኮኡሉልሳሮ። <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />ዋ ሙሴነ “አን ሻጋ የልን ካኮዶታሮን ሻጋ የልናራ፤ አን ነኔኤይሳይን ካዶታሮን ነኔኤይሳይናራ” አመራ። <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />ሃንሱን አሳባኖ ካዋ ካኮሄላማራ ፈኢ ታእባዶይና ፈሎ ኦእባዶይ አንሌኖን ግራን ሻጋ ካዋይያ። <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />ህታ ኣላንቲ ቁሉክ ማጻፋ ካግብጽ ዎኖኮክ ጋራ “ኩዬ ሁናኬ ቱሲና መገክና አላም ዱባ ጉት ጎጎአዴሳምሮ የልን ኩ ሬድሰራ” ካአማራ ሃፉራ ጻፋመራ። <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />ሃንሱን ዋ ሻጋ የልን ካዶተን ሻጋ የላራ፤ ሀሎ አባይን ካዶቴና አደ ካሀሎ የላራ።<verse eid="ROM 9:18" /></para>
  <para style="s1">ኤንገ ታዋና ሻጋ</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />ሃንሱን፥ “ፈኢ ታዋ ኔባዪን ማዮና ላኮዳንዳሮ፤ ሀያ ዋ እባዶ ኦሜላን ፈሎኦትሶዉን ሙን እሶ ዎቃሳራ?” አም እን ካሆሳቶ ለታ። <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />አት እባዶት! ዋኔ ዎታ ዶጋምን መ ፈኢ አብታ? ኤሬኮ ካፈላመራ ሁ ካፈሎሮነ፥ “መዉን ሃ የልተ እን ፈልተታ?” አምን ዳንዳራ? <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />ኤሬኮ ሁ ካፈላራ ምዲ ቶት ካኤሬ ጫዉዶኮ ሁ ኮ ካባጃን፥ ካካለ ላፋኒዕ ፈሎን የል ፈልን ኦዶናት ላኮአቦያ?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />ዋ ኤንገቴሳ ቱሲና፥ ሁናና አዴስሳይን ዶተረ ባይን ኦኤካተራዉን ታንጂን ካኦብሴሮ ላኖ መ ካሳ? <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />ሂካና ካኮንየለራ ጣየ ካባጃን ኦኤካሰሮ፥ ሻጋ ኦኮንየልናሮ ካባጃኮክ ጂናን ቱስንያ። <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />ኖ ካሻጋ ሁ አይሁድ ካላልኮ አንሌኖን ግራን አይዛብኮና ኖ ኡመራ። <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />ህክና ካሄገሮት ሆሴ፥</para>
  <para style="q1" vid="ROM 9:25">“ጎሳኬ ካሌኖን፥ ‘ጎሳኬ!’ አም ኡምናራ፤</para>
  <para style="q2" vid="ROM 9:25">ካዶታሞን ግሮ ጎሳና፥ ‘ካዶታማሮ!’ አም ኡምናራ፤<verse eid="ROM 9:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26" />እሶ፥ ‘ጎሳኬ ላኮታን’ ታኮአማሜን ባንኤ ‘አርዶክ ይስ ካዋ’ አማም ኡማምናራን” አማመራ።<verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />እስያሳና ጋራ ካእስራኤል አዬሳ፥ “ይስ ካእስራኤልኮኒዕ ቶቶ ታላቡ ግርዴ ጨካለ ኣን ጎሞጋተና እሶኮ ኦፋይናራን ኡጫርያን። <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />ጎታ አአዳላኖኒ ሳም አላም ጉት ፍርድናራ” አማ ያየ ጦቂሰ አዬሰራ።<note caller="-" style="x"><char style="xo" closed="false">9፡28 </char><char style="xt" closed="false"><ref loc="ISA 10:22-23">ኢሳ. 10፡22-23</ref>።</char></note> <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />አደና እስያሳ፥ “ካዱባ ሞት ጎታ ኖን ሳኒ ሃስ ዋተዋ ታሶዶምና ታጎሞራ ካታማል ጎጎባየራን ኖና ባይ ግራነ” አማ ጣየ አዬሰራ።<note caller="-" style="x"><char style="xo" closed="false">9፡29 </char><char style="xt" closed="false"><ref loc="ISA 1:9">ኢሳ. 1፡9</ref>።</char></note><verse eid="ROM 9:29" /></para>
  <para style="s1">እስራኤልኮክ አማናና ዋት</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />ጎርታ መ አምናና? ቁሉማ ሄላይን ካዶታኖን አይዛብ ቁሉማ ሄላተ፤ ህት ቁሉማና አማኖኮ ታሄላማቶታ። <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />አየሱን ጎአመን ሴራኮ ታሄላማቶ ቁሉማ ሄላይን ኦዳፉረራን እስራኤልጆል ሴራ ካሙሴ ኦራይን ዳንዳና ማንኮዋተን ማራን ቁሉማ ቶስ ላኮጌራን። <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />“መዉን እሶ ቁሉማ ቶስ ግያናዋቴን?” ጎአማመ እሶ ቁሉማ ሄላይን ካዶታተራን አማኖይ አንሌኖን ግራን ፈሎይ ማንኮሌ ማራንየ፤ ሃንሱን ካሀንዱዱፎ ኤኤሞይ ሀንዱዱፋተን፤ <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />ህክና፤</para>
  <para style="q1" vid="ROM 9:33">“ጎርታ፤ እባዶ ካሀንዱዱፍሳሮ ኤኤሞ ጽዮኒ አን ካይናራ፤</para>
  <para style="q2" vid="ROM 9:33">ሂክ ኤኤሞና እባዶ ሀንዱዱፍሰ ካሉጉዳሮ ኤኤሞያ፤</para>
  <para style="q1" vid="ROM 9:33">ኡሱ ካአማናራ አደ ላኮሙልሮ” አማመ ጎጎጻፋመሮያ።<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />አቢላልቴ! ዎዳናቴይ ካግራ ካንጂንክ ሀልቻና ዋ ቶስ አን ካኤባታራ እስራኤልጆል ጎጎፋይራኑንያ። <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />ልክኪ ማላባኖኮ ላናዋት ኳሬ እሶ ዋዉን ታአባን ካኢዳነ ያዳ እሶን ግራኖ አን መተኬይ አቶታራ፤ <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />ዋ እባዶ ካኮቁሎይሳሮ ራ እሶ ማላባናዋቲ ቁሉማትሶክ ራ ሰሴተን ኳሬ ቁሉማ ታዋይ ላኮሰሴተን። <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />እባዶ ዱባ አማኖ ጎጎቁሎይሮ ሴራ ካሙሴ ክርስቶሳ ጉዳተራ።<verse eid="ROM 10:4" /></para>
  <para style="s1">ፋይና ዱባን ላኖ</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />ሴራ ካሙሴ ኦራታኖይ ታሄላማቶ ቁሉማ ሙሴ ካጻፈራ፥ “ሴራ ካኦራታራ ዱባ ኔፎነ ግራራ” ካአማሮያ። <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />ዋ እባዶ አማኖ ቁሎይሳኖኮክ ጋራ፥ ሃ አማመ ጻፋመራ፥ “ዎዳናታይ ዳሩር ቶስ አዮያ ካብናራ?” አሮአንተ፤ ህክና ክርስቶሳ ዳግስንያ፤ <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />“ጎርቱን ዎዳናታይ ‘ቦዋ ቶስ አዮያ ካዳግናራ?’ ” አሮአንተ፤ ህክና ክርስቶሳ ጎይኮ ኬስንያ።<verse eid="ROM 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 10:8" />አደና፥ “ሃፉራ ካዋ ኩ ዶሌ ግራ፤ ሱረዋ ህኢታይና ዎዳናታይ ግራ፤” ሂክ ሃፉራና ኖ ካላላባኖ ካአማኖ ሃፉራያ፤ አማመ ጻፋመራ። <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />“የሱሳ ጎታ ላኖ” ህኢታይ ጎአቶትተ ዋ ጎይኮ ኬሳኖና ዎዳናታይ ጎአማንተ ፋይቶዋ። <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />እባዶ ዎዳናቴሳይ ጎአማኖ ቁሎዋራ፤ ህኢቴሳይ ጎአቶትሮ ፋያራ። <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />ቁሉክ ማጻፋ ጎጎአማሮ፥ “ኡሱ ካአማናራ ዱባ ላኮሙላሮ።” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />ጎርታ ኮ ጎታ ካዱባ ጎታ ማንኮሌይ አይሁድና አይዛብ ኦሮ አሳብንጀ ቶና ላኮግቶ፤ ኡሱና ኡሱ ኦአማናራዉን ዱባን ኡሶኬሳ ጂናሰ ስሳራ። <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />“ካጎታ መገ ካኡማታራ ዱባ ፋያራ” አማመ ጻፋመራ።<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />አየሱን ጎአመን ሀአማኖን ግራን ምሲ ኡማምን ዳንዳራን? ጋራኬሳ አንማሎን ምሲ አማናራን? ካላላባራ አንግኖን ምሲ ማልን ዳንዳራን? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />ካአጋልስስራ ጎፋራሞን ምሲ ሃፉራ አጋልስስን ዳንዳራን? ሂካ “ዎንጋላ ካገጌሎ ኦኬናራንኮት ኤመቶ ምሲ ኢዳታ!” አማመ ጎጎጻፋመሮያ። <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />አየሱን ጎአመን እስያሳ፥ “ጎታ! ኖ ካአዬንሰኖ ሃፉራ አዮያ ካአታተ?” አመ ጎጎአዬሰሮ፥ ዱባና ካገጌሎ ሃፉራ ላኮአታቴራን። <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />ጎርታ አማኖ ካኮሄላማራ ካገጌሎ ሃፉራ ማላኖኮ ካኬይያ፤ ካገጌሎ ሃፉራና ካኮሄላማራ ጋራ ካክርስቶሳ ካአዬሳሮ ሃፉራ ካዋኮያ። <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />አላ ኩ ሆሳሮ፤ ሀያ ሃፉራ ላኮማላራን አማኖያ? ቁሉክ ማጻፋ፥ “ያየትሶ አላም ዱባ ማልሳንተ፤ ሃፉራክሶና ኡልኮት ጋቾ ጌ፤” ኦግራን ማሌራን አማመ ጎጎጻፋመሮያ። <verse eid="ROM 10:18" /><verse number="19" style="v" sid="ROM 10:19" />አደና ሆሳታራ፥ እስራኤልጆል አንሻዶን ግራን አማኖያ? ጣየ ሙሴ ሃ አመራ፥ “ጎሳኬ ካሌኖን ጎሳኬ የልረ ጮልስናራ፥ ካሻዶን ጎሳ ጎጎሻድሮን የልረ አማራይስናራ” አመራ። <verse eid="ROM 10:19" /><verse number="20" style="v" sid="ROM 10:20" />እስያሳና፥ “እን ኦዶታኖቱን ሙተ፤ ኦሆሳኖቱን እስኦቴ ቱሳየ” አመ ጃቡይ አዬሰራ። <verse eid="ROM 10:20" /><verse number="21" style="v" sid="ROM 10:21" />እስራኤልጆል ማራን ጎአመን “ካአጃጃሞና ካሜላን ጎሳ እን ቶስ ጎጎኤሜሮን አሪ ዱባ ገነኖኦቴ ፋየ” አማራ።<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s1">ዋ እስራኤል እስ ዋት</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />ጎርታ ዋ ጎሳኬሳ ኢሰራ? እጂ ላኮኢሰሮ! አን መተኬዉን ካእስራኤልያ፤ ታአብራመ ሳኒ ካሌራ አን ታቢንያመ ኣኒኮያ። <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />ዋ ጣየ ካማላበሮ ጎሳ ላኮሻፈሮ። ኤላሳ እስራኤል ጉት ሞቶ ዋ ቶስ ምሲ ጌግሰሮ፥ ማጻፋ ጋራኬሳ መ አማሮ ላኮካሳንያ? <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />ሀሱ ጎራታ፥ ኤላሳ፥ “ጎታ! ካሄገሮልካ ላጋዴራን፤ ባንኤ ታጃርሶና ዲጌን፤ አን ካላል ሄሰ፤ እና ላጋዲን ዶታራን” አመረ። <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />አየሱን ጎአመን ዋ ካስሰረ አባብ መየ? “ባኣል ካአማማሮ ቶልቻን ካሳጋዶን ኩማ ቶዶባ እባዶ ኡሱን ሃሳየራ” አመራ። <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />ጌስ ካአርካኔቲ ሂካማሌ ስኖ ታዋይ አሳባሜረን ኦሄሴራን ኡጫር እስራኤልጃ ግራንዋ። <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />ጎርታ አሳባማኖ ስኖ ታዋይ ጎሌ፥ ፈሎይ ላኮዮ፤ ፈሎይ ሊ ግረዋ ስኖ ታዋ ላኦ ካላይት ሊ ግራተ።<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />ጎርታ ላኦ መታ? እስራኤልጆል ካዶታቴራን ላኮሄላቴራን፤ ኦአሳባሜረን አደን ካዶታተሬን ሄላቴንዋ፤ ኦሄሴራዉና ዎዳናትሶ ዱድሰ። <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />ህክና “ዋ ዎዳናትሶ ዱድሰ፤ ሃንሱን ህታር ታ ጌሮን እልኦ ኦትሶ ላኮድያራን ነበቦኦትሶ ላኮማላራን አማመ ጎጎጻፋመሮያ።” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />ዳዉተና፥</para>
  <para style="q1" vid="ROM 11:9">“ዱጉድትሶ ካአባሮ ዎጣማደ፥</para>
  <para style="q2" vid="ROM 11:9">ካሉጉዳሮ ጉምቢ ሊ ሀአቦስሰ!</para>
  <para style="q2" vid="ROM 11:9">እሶ ታፈለራን ሜላነ እሶ ጉት ሀሃይቶ!<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />እልኦ ኦትሶ ጎጎዴኖንኮ ሙጉድ ሀሌዎ፤</para>
  <para style="q2" vid="ROM 11:10">ሞኦትሶ አርጌቶ ራኮይ ዙኡሮ ሀቤሴን” አመ።<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />አላ፥ ካላም ሆሳሮ፤ አይሁድኮክ ኢያኖ ካላም ታኮኬኖኒያ? ላኮዮ! ባስ ካአይሁድኮት ኣላንቲ አይዛብ ፋይና ሄላተ፤ ሂክ ካኮሌራ አይሁድ አይዛቢ ጉት ጎጎጋቢሮን የልንያ። <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />ካአይሁድ ባስ አላምን ካሞጋን ኡሶ ሄላምስሰራ፤ ኢያኖክሶና አይዛብዉን ኡሶ ሌራ፤ አይሁድ ፋይ ግረዋ ኡሶ ምስ ምሲ ጂናይ ግርናረ።<verse eid="ROM 11:12" /></para>
  <para style="s1">ፋይና ካአይዛብ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />ግዳ አን እስን አይዛብን አዬሳራ፤ አይዛብን ካፋራመ ላኖኬ ማለ ሀንዳኖኬ ካባጃታራ። <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />ህክና ኡናት ጎጎሀልችቶን ከኬሰጉረ እሶኮ ኮኮ ፋይስን አብድ የላታያ። <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />ዋ አይሁድ ካኮሻፈረ ጎራታ ካካለ ካአላም ጎሳ ኡሱነ ዎታ ጎዎጋሮ እሶ ካኮቆጳታሮ ጎራታ ምስ ካልናሮ ኣን ላራ? ሂክ ጎይኮ ካከያሮ አንያ!<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />ካም ካአባመራ ምናቶ ታቁሎይተ ጎሌተ ካም ዱባ ካቁሎየ ላራ፤ ኡሱማለና ጋኮክ ህዲድ ቁሉክ ጎሌ ባላል ዱባ ካቁሎየ<note caller="+" style="f"><char style="fr" closed="false">11፡16 </char><char style="ft" closed="false">ካቁሎየ አማኖ ህታ ባንኤ ካለካለ ጎርቱን ዎዩክ አማኖያ። </char></note> ላራ። <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />ምራር ካግሮ ካኤጀርሳ ጋዉን ባላል ካሌራ አይሁድጆል ጎሳም ጎእዬን እስን አዴን ካጋዶ ኤጀርሳኮክ ባላል ኦሌቴታን አይዛብ ባንኤትሶይ ሀማጽዴን ኡራዎ ኦትሶና ኡሶክሶ ካሄዴዳማታን ጎሌተን፥ <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />ሀሱ ህዲድ ጉት አሮኮርተን፤ ጎኮርተን አድ ሂካ አዴሳ፤ ህዲድ እስን ስዳራ ኳሬ እስን ህዲድ ላኮስዳታን።<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />አየሱን ጎአመን “ባላል ኤኤበ ታኮእዬሮ ባንኤትሶይ አን ጎጎካሚሮያ” ካአንታን ሌታን። <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />ጋራያ፤ እሶ ካኮንበራን አማናናዋትኮ ካከይ ጎሌሮ እስን አታቴን ካኮአልቴታን አማንቴደንያ፤ አብሳዬን ኳሬ ኮራሜሳ አሮሌተን። <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />ዋ መጣ ባላል ኦሌራን አይሁድን ጎነኔኤይሳኖን እስኑን ላኮነኔኤይሳሮ። <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />ጎርታ ታዋ ኢዳነና ቦግ አታንኬሳ ዲያ፤ ቦግ አታንኬሳ ኦእዬራን ጉት ጎሌሮ ኢዳነ ካኮቱሳራ አደ እስኑንያ፤ ህክና ካልናራ ኡሱ አማናኖይ አታይ ጎግርቴንያ፤ ጎአታኖን አደ ጎሳምዴን ኢናታን። <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />አይሁድ አማናታናዋት ታትሶ ጎኢሴን ታጣዎ ባንኤትሶ አባባይናራን፥ ዋ እሶ አባብ ታብስን ዳንዳራ። <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />እስን አይዛብ አደን መጣይ ካጋዶ ኤጀርሳኮክ ባላል ሌተን ግራን ባንኤ ካላይ ካምራረ ካኤጀርሳ ጋ ጉት አባራንቴታን። ሃ ጎሌ ሂኒዕ መጣይ ኤጀርሳ ካምራረኮክ ባላል ኦሌራን አይሁድ ታባር ባንኤትሶ ቶስ አባባይ አባራምን ምሲ ዳንዳናዋታራን!<verse eid="ROM 11:24" /></para>
  <para style="s1">ሻጋ ካዋ ዱባን ላኖ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />አቢላልቴ! “ኖ ኦካንሶና” አምዴን አሮኮርተን፤ አን ታሰግናሮ ሆል ቶ ግታ፤ ህክና እስራኤልጆልኮክ ዲዳኖ ኤርናን አሌኖን ግራን አይዛብ ዱባ ራቶ ዋ ቶስ ታ ኤሜራኑንያ። <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />ጎርታ ሃያ፤ እስራኤልጆል ዱባ ፋይናራ። ሃንሱን</para>
  <para style="q1" vid="ROM 11:26">“ካፋይሳራ ጽዮንኮ ኤመይናራ፤</para>
  <para style="q2" vid="ROM 11:26">ታያይቆባ ሳኒ ዱባኮ ሜላነ ባስናራ፤<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />ጩቦክሶና ካኮባሰ ጎራታ እሶነ ዎታ አን ኦታብናራ አማቶ ኦኡሱብኮክ ሃፉራ ሂካያ” አማመ ጎጎጻፋመሮያ።<verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />እስራኤልጆል ካዎንጋላ ሃፉራ አታታናዋቲ ላኦትስን ታአይዛብ ማራን ዋኮክ ዲና ሌራን፤ አየሱን ጎአመን አሳባማኖኮክ ጋራነ አን ታኦዶላልኮት ኣላንቲ ዋ ኦጌላታራንያን። <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />ዋ አሳብ ስኖቴሳ ካኮስሰ ጎራታ ኦፈለሮ ፈሎኦቴሳ ያዳኬሳ ላኮኢግልሳሮ። <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />እስን አይዛብ ጣይቴን ዋዉን ኦአጃጃሞንቴን፤ ግዳ አደን አይሁድ አጃጃምዋትኮት ኣላንቲ እስን ሻጋ ካዋ ሄላቴታን። <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />እስን ሻጋ ጎጎሄላተታንክ ማለ እሶና ሻጋ ጎጎሄላራኑን እሶ ግዳ ዋዉን ኦአጃጃሞን ሌራን። <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />ዋ ሻጋኬሳ እባዶ ዱባን ቱስን አመረ እባዶ ዱባ ዲዳኖይ ካሽያመሮ ጎጎሌሮን የለ።<verse eid="ROM 11:32" /></para>
  <para style="s1">ዋዉን ታስሳንተቶ ካባጃ</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />ዋኮት ዱሩማ፥ ቃሩማና ማላባኖ ምሲ ኬልዶያ! ፍርዳኬሳ ካቆቆራሞንያ፤ ራኬሳና ካአዴሳሞንያ።<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />“ታጎታ ቆፋ ታዎዳና ካካሳ አዮያ?</para>
  <para style="q2" vid="ROM 11:34">ኡሱን ጎርሳ ካስሳራ አዮያ?”<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />“ዋ አባብ ጎጎስስሮን ዋዉን</para>
  <para style="q2" vid="ROM 11:35">ካአምአይሳራና ካአምአይሰሮ ካአታታራና አዮያ?”<verse eid="ROM 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36" />አየስ ዱባ ካኮሄላመራ ኡሱኮያ፤ ኡሱና ኡሱንያ፤ ጅሩ ጅሮማን ካባጃ ኡሱን ሀሌቶ! ሀሚኒዕ።<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s1">አርዶክ ጃርሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />ጎርታ አቢላልቴ! ማርክስን ቁሉክና ዋ ካገጌላይስሮ አርዶክ ጃርሶ የላይዴን ጎጎስሳኑን ነኔኤይሳታኖ ካዋይ አን እስን ኤባታራ፤ ህክና ዋዉን እስን ካስሳታን ቱኩልክ ሄዶይሳታኖክስንያ። <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />ካኢዳና ካገጌላይስሮ ዱዶት ታሌተቶ ፈኢ ታዋ መቶ ጎጎማላብታኑን ሳሙትስኒ ኡሱባታኖ ኢግልሳማ ኳሬ ሂካ አላምኮት ሜላነ ኣን አሮሌተን።<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />አደና ዋ እስኑን መተመቴ ካስሰሮ አማኖ ማለ ኢዳነ ሻዳ ኳሬ ካዶትሳሮኮ ሮር እስኦትስኑን ኮራይ አሮዴተን አመረ ኢን ታስሳንተቶ ስኖይ ሰጋራ። <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />ማርካን ካሞጋን ምክታጆል ግራ፤ መተመቴና ማርኮክ ምክታ ካለካለኒዕ ፈሎ አባ። <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />ኡሱማሌ ኖ ኦሞጋን ሌነ ግራን ክርስቶሳ ምክታ ኮና፤ ማር ኮ ኮኒዕ ምክታጆል ጎጎሌነኖ ማለ እስ እስኦሮ ቁራናምነና። <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />ሃንሱን ዋ ስኖቴሳ ኖን ካስሰሮ ካለካለክ እላቦ ፈሎይ ሀይንሶ፤ እላቦልካን ሄገሮ ኦዋ ሰጋኖ ጎሌ አማኖካንክ ጅልባ ሄገሮ ኦዋ ሰግና። <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />እላቦካን ካካለቱን ሀንዳኖ ጎሌ አታይ ሀንዳይና፤ እላቦልካን አጋልስሳኖ ጎሌ ጎጎዶትሳሮ አጋልስንሳ፤ <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />እላቦልካን ጎርሳኖ ጎሌ ጎርሳ ስንሳ፤ እላቦልካን ስሳኖ ጎሌ ዎዳናኮ ታሌተ ኢዳነ ስንሳ፤ እላቦልካን ኦዶናቲ ባሪሳኖ ጎሌ አታይ ኦዶናቲ ባሪንሳ፤ እላቦልካን ነኔኤይሳታኖ ጎሌ ሂካዋ ገጌሎይ ፈልና።<verse eid="ROM 12:8" /></para>
  <para style="s1">እስ ሳድሳታኖ ካላይት ጌላንጀ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />እስሳድሳታኖ ካላይት ታሩም ጌላንጀ እስኑን ሀግርተ፤ አየስ ካሜላን ዲዳ፤ አየስ ካእዳን ጌላየን። <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />እስ እስሲኦሮ አቢላልኮት ጌላንጀ ጌላየን፤ እስእስኦሮ እስእስ ካባጅን ዶታዬን፤ <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />አሀሮን ዎዳናኮ ካሌ አያናክስንክ ከከያኖይ ጎታዉን ሀንዳ። <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />አብዲ ገጌላየን፤ ካራኮ ጎራታ ኦብሳ፤ አርጌቶ ኤባየን። <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />ዋይ ኦአማናራኑን ራኮትሶይ ካአብታንኮ ስሳ ጋርጋራ፤ ማርትናይ ኦኤሜተራን ቆጳዬን።<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />እስን ኦሆሮራራን ሶማሳየነ፤ ኳሬ አሮቃንግቴን። <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />ኦገጌላታራነ ዎታ ገጌላየን፤ ካኦታሮነ ዎታና ኦዬነ። <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />እስእስኦሮ ያዳ ኮይ እስአታ ግራ፤ እስኦትስን ጦቂሳታኖና ኮራኖ ኢሳጋዴን እስካየራሳታሮ እባዶነ ዎታ ራቶ ግራ፤ እስኦትስኒ ኖ ኦካንሶና አምዴን አሮኮርተን።<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />እባዶ ዱባ ሆረ ካእዳን ካሌሮ አየስ ፈላ ኳሬ፥ እባዶ አየስ ካሜላን እስን ጉት ጎጌግሰ፥ እስና አባብዴን አየስ ካሜላን አሮጌግሰን። <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />እስኑን ጎዳንዳመ እባዶ ዱባነ ዎታ ኖጎዳ ግርን ምናትስነ ካዶትሳሮ ዱባ ፈላ። <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />አቢላልቴ! ሀሎ ዋዉን ኢሳ ኳሬ እሲ ሀሎ አሮቤተን፤ “ሀሎ ካበያራና ሀሎኮት አማኣ ካሙርናራ አንያ አማራ ዋ ጎታ” አማመ ጻፋመራ። <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />ሃንሱን ሀሎ ብያኖኮ ሱረ ዲናካ ጎኡኤ አምስ ጎሱጉባተና ጣምስ፤ ሂካ ጎፈልተ ሙል ህኢ ጎጎአባሮ የላታ። <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />ሃንሱን አየስ ካሜላን ኢዳነ አዎድን ኳሬ አየስ ካሜላን አሮአዎዳንተ።<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s1">ኦዶናት ኦአባዉን አጃጃማኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />ማምስክ ኦዶናት ካኮሄላማራ ፈኢ ታዋኮ ማንኮሌ ማራን ግዳ ኦግራን ኦዶናት ኦአባን ካኮሹማሜራን ዋይ ማንኮሌ ማራን፥ እባዶ ዱባ ኦዶናት ካአቦን አጃጃማኖ ዶትሳራ። <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />ሃንሱን ኦዶናት ኦአባን ካኔባታራ ዱባ አጃጃ ካዋ ኔባታራ፤ ካአጃጃሞን ዱባ እስኦቴሳ ጉት ካሙሮ ፍርዳ ኬናታራ። <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />ሞትጆል አብስሲን ካኮዳንዳራን ፈሎ ኦሜላነ ኦፈላራን ኳሬ ኢዳነ ኦፈላራን ላኮዮ፤ ኦዶናት ኦአባን አብሳታናዋት ዶታታ? ጎርታኑን አየስ ካእዳን ፈል፤ ፈሎ ኦኢዳንኮ ጋላታ ሄላቶዋ። <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />ኦዶናት ካአባ ኩን ታኢዳን ጎጎፈሎን ካሹማመራ ዋዉን ካሀንዳሮያ፤ ኦዶናት ካአባ ሺፋ ካኮንሞዋተራ አዳ. ማንኮሌኖን ማራን አት ካሜላን ካፈላቶ ጎሌተ ኦዶናት ካአቦ አብሳ፤ ኡሱ ሜላነ ኦፈላራን ሙርሳኖና ሀሎ ታዋ ቱሳ ዋዉን ሀንዳራ። <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />ሃንሱን ምን ካዎኖይ ኦዶናት ኦአባዉን አጃጃማኖ ዶትሳራ፤ ካኮንአጃጃማታና ሙሮ ኦዋ አብሳታኖ ካላል አንሌኖን ግራን፥ ሳሙትስን ማንኮዎቃሳቶ ማራን ላኖ ዶትሳራ።<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />ጊራ ካኮሙራታና ሃንሱንያ፤ ኦዶናት ኦአባን ሂናኣ ፈሎ ፈላ ኦግራና ዋዉን ሀንዳይንያ። <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />ጎርታ ኦዶናት ኦአባዉን ፈልን ካዶትሳሮ ዱባ ፈላ፤ ጊራ ካኮዶትሳሮን ጊራ ሙራ፤ ቃራጣ ካኮንዶትሳሮን ቃራጣ ሙራ፤ አብሳይን ካዶትሳሮ አብሳታኖ፥ ካባጃ ካኮዶትሳሮና ካባጃ ስሳ።<verse eid="ROM 13:7" /></para>
  <para style="s1">እስእስሮ እስእሲ ጌላታኖኮክ ጋራ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />ታማዮ አንዛና እስኑን አሮግኖ፤ ግርን ታዶትሳታ አንዛ እስእሲ ጌላታኖ ካላል ሀሌዎ፤ እባዶ ካጌላታራ ሴራ ኦራታራ። <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />“አሮ ሻርሙጢተ፥ አሮላጋደ፥ አሮሄቴ፥ እባዶ ካካለክ ካሌሮ ኮኮ አሮሀልችተ” ካአማራ አጃጃልና ካካለና አጃጃል ዱባ “እባዶ እስኦታ ኣን የላ ጌላ” ካአማሮ አጃጃ ኮይ ኦሮ ግራ። <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />እባዶ ካጌላታራ ዱባ ካጌላታሮ እባዶ ጉት አየስ ካሜላና ላኮፈላሮ፤ ሃንሱን እባዶ ካጌላታራ ሴራ ዱባ ኦራታራ አማኖያ።<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />ጎርታ ሁዱሮኮ ካኮናባዳን ጎራታ ግዳ ግያኖ አዴሳ፤ ሆረ ካኮአማነኖ ጎራታኮ ሱረ ግዳ ኖ ካኮፋይና ጎራታ ኣሎ ኖ ቶስ ጋባላመራ። <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />ሄመን ሮራ ግታ፤ አርና ጋባላንተታ፤ ሃንሱን ሙጉዲ ኦፈላማራን ፈሎ ኢንሳ፤ ካኢፋ ሁ ካጀረነ ሳርሳና። <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />አሪ ጎጎሰሴታኖ ማራጌ ግርና፤ ዱዱሮይና ሰቲና፥ ሻርሙጣኖ፥ ራራጋታኖይ፥ ዶጋማኖይና፥ ጋባኖይ አሮሌኖ። <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />አየሱን ጎአመን ጎታ የሱሳ ግራ ኳሬ ሶኦትስንኮክ ሀልቻ ብን አሮሄዴን።<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s1">እባዶ ጉት አሮሙርቴስተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />እስኒ ኦሮ አማኖ ላፋክ ካሌሮ እባዶ ካዶጋምስሮ ያዳኬሳ ጉት ሀቱፋኖና ሀፍርድኖን አታዬን። <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />ማሱሳን እባዶት ኮ አማኖ ካአመን ዱባ አምን ካዳንደይስሮ አማኖ ግሮዋ፤ አማኖ ካአታኖን ግራ ካካለ እባዶ ጎአመን አካክልተ ካላል አማራ። <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />ሃንሱን ማመና ካአማራ እባዶ ካአሞን አሮቱፋኖ፤ ካአሞና ካአማሮ እባዶ ጉት አሮፍርድኖ፤ ዋ አማኖኬሳ አታተራ። <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />ሀያ፥ ካካለ ካሀንዳሮ ጉት ካፍርዳታ አት አዮታ? ኡሱ ጎአሌና ጎርቱን ጎኢየና ታጎታ ሃጃታ። ሱረዋ ዋ አሊስን ማንኮዳንዳሮ ማራን አታተ ኣላራ።<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />ኡሱማለና አሪ ቶ ታካለ አርኮ ኣሎ ታካባጃንተታ አመ ካሄዳራ ግሮዋ፤ ካካለ አደ አሪ ዱባ አማለኮት ካባጃ አብታ ኳሬ አሪል ኦሮኮ ካሌና ላኮግቶ አመ ሄዳራ። ጎርታ ሂካ ኣንክክ አየስ መተመቴ እባዶ ዎዳናቴሳ ካአማኔሮ ሀፈሎ። <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />አሪ ቶ ታካለኮ ካለ የለ ካሄዳራ እባዶት፥ ሃ ካኮንየላራ ጎታዉን አመረያ፥ ሶ ካአማራና ጎታዉን አመረ አማራ ዋዉና ጋላታ ስሳራ፥ ካአሞና ጎታዉን አማ ላኮአማሮ ዋዉን ጋላታ ስሳራ። <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />ኖኮ ማዮና እስኦቴሳን ካግራራ፥ እስኦቴሳና ካጎዋራ ማዮና ላኮግሮ። <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />ጎግርነና ጎታዉን ግርናና፤ ጎጎነና ጎታዉን ጎዋና፤ ሃንሱን ጎግርነና ጎጎነና ኦጎታና። <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />ሃንሱን ክርስቶሳ ጎየረ ጎይኮ ካኮኬራ ኔፎነ ኦግራዉና ኦጎየራኑን ጎታ ሊንያ። <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />ሀያ፥ አት አቢካይ ጉት ሙን ፍርዳታ? ጎርቱን አቢካ ሙን ቱፋታ? ኖ ዱባና ካፍርዳ አርጃታ ካዋ ሆረ አልናና። <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />ኣላንቲና፥ “አን አርዶክያ፤ አማራ ዋ፤ እባዶ ዱባ ግልብኬሳይ እን ሆረ ግልቢስናራ፤ ህኢቴሳና አን ዋ ላኖ እን አቶትናራ” አማመ ጻፋራ።<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />ሃንሱን ኖ መተመተካን ፈሎኦታንኮክ ጋራ ዋይ ሆረ አልነ አባብ ስስናና።<verse eid="ROM 14:12" /></para>
  <para style="s1">እባዶን ሀንዱዱፎ ላናኮ እስ ኦራታኖ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />ሃንሱን ኮ ካካለ ጉት አሮፍርድኖ፤ አየሱን ጎአመን ማምስክ እባዶና አቢኬሳኮክ ራድ ሀንዱዱፎ ጎርቱን ካሀንዱዱፍስሮ ላናኮ እስኦቴሳ ሀኦራተ። <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />አየስ ኮ ባቲክያ አመ ካሄዳሮ እባዶን ሀሱ አየስ ኡሱን ባቲክ ላራ ኳሬ ማምስክ አዬስና መተኬሳይ ባቲክ ልዋት አን ጎታ የሱሳይ ማላበረ አዴስሳራ። <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />አት ካአማቶ ባቦኮክ ኣላንቲ አቢካዉን ሀንዱዱፎ ጎሌተ ጌላንጄይ ካግቶ ላኮቶ፤ ሃንሱን ክርስቶሳ ካኮንጎየሮ እባዶ፥ ካአማቶ ባቦኮክ ኣላንቲ ጎጎባሮን አሮየልተ። <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />ጎርታ እስን ዶሌ ካእዳንክ ካሌሮ አየስ ካካለ ጎጎጢቃሮን አሮየልቴን። <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />ዎኖናት ካዋ አያና ቁሉክ ታሄላማቶ ቁሉማ፥ ኖጎዳና ገገሎያን ኳሬ ታአሞና ታጣሞ ሃጃ ላኮቶ። <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />ሂካኮክ ጋራ ክርስቶሳን ካሃንዳራ እባዶ ዋ ገጌላይሳራ፤ እባዶ ዶሌና ካጋላታመያ።<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />ሃንሱን ኖጎዳ ካኮሄላማቶና እስኦሮ እስ እስ ካኮቢሳኖ አየስ ፈልና። <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />ባቦኮክ ኣላንቲ ፈሎ ኦዋ ላኮዲግኖ። ባቦ ዱባ ካሙጭመያ፤ አየሱን ጎአመን ካካለ እባዶ ካሀንዱዱፍስሮ ባቦ ኣማኖ ላኮጋራዮ። <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />ሃንሱን አቢካ ጎጎሀንዱዱፍሶንኮ ሶ አማናዋት፥ ጣሞ ካዎይኒ ጣማናዋት፥ ጎርቱን ማምስክና ካሀንዱዱፍስሮ ኮኮ ፈላናዋት ካእዳንክያ። <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />ጎርታ ሂክ አማኖ ኩዬና ዋይ ጠኤ ሀሌዎ፤ ቱኩልክያ አመ ካአማናሮ አየስ ጎፈለ ሳሙቴሳ ካዎቃስኖን እባዶት ካጋላታመያ። <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />ሄዳታ ካአማራ እባዶት አደ ፈሎኦቴሳ አማኖይ ጉት ባኖን ካግሮ ማንኮሌ ማራን ኡሱን ፍርዳምናራ፤ አማኖይ ካፈላሞን አየስ ዱባ ጩቦያ።<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s1">እስ ገጌላይሳታናኮ ካካለ እባዶ ገጌላይሳኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />ኖ አማኖ ኦአቲ ኦሌነና፥ አማኖይ ኦሀራራንኮክ ሀራኖ ስዳኖ ዶትሳራ ኳሬ እስኦታን ኦላል ኦገጌላይሳታኖ ላኖ ላኮዶትሳሮ። <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />ኖ መተመተይ ካካለ እባዶ አማኖ ጎጎአታሮን ኡሱ ካጋርጋሮና ካገጌላይስሮ አየስ ፈልና። <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />ክርስቶሳ እስኦቴሳ ላኮገጌላይሳተረ፤ ሱረዋ፥ “እባዶ ኩ ካሀባረራ ሀባር እን ጉት ጌ” ካአማራ ቁሉክ ማጻፋኮክ ሃፉራ ኡሱ ጌ። <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />ቁሉክ ማጻፋኮ ኖ ታሄላታኖ ኦብሲና ጎጎኢናይ አብድ ጎጎግርቶን ጣየ ካጻፋመራ ዱባ ኖን አጋልስስ ጎጎሌሮን ጻፋመራ። <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />ኦብሲና ጎጎኢና ካስሳራ ዋ ሄዶ እስን እስእስኦሮ ታየሱሳ ክርስቶሳ ማሱሳ ዴበ ሰሴታ ኡሱነ ዎታ ራቶ ካኮግታን ግር እስኑን ሀስሶ። <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />ኡሱማለና ጎታካን ካየሱሳ ክርስቶሳ ኦዶ ካሌሮ ዋ<note caller="+" style="f"><char style="fr" closed="false">15፡6 </char><char style="ft" closed="false">ካሆርኮ ካ ግሪክ ማጻፋይ ካ የሱሳ ክርስቶሳ ኦዶና ሄዶና አማራ። </char></note>፥ ዎዳና ቶይና ሃፉራ ኮይ እስን ኡሱ ጎጎካባጂታን ሀየሎ።<verse eid="ROM 15:6" /></para>
  <para style="s1">ካዎንጋላ ሃፉራ አይዛብን ላላባማኖ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />ክርስቶሳ ታዋ ካባጃዉን እስን ጎጎቆጳተሮ እስን ዱባና ኮኮ እስኦሮ ገጌሎይ ቆጳዬን። <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />ሂካ አዬሳ ግራን ዋ ካጣዎ ኦዶላሉን ታስሰራ አብድ ፈሎይ ጎጎሀይቶና ሩም ታዋ ጎጎአዴሳንቶን ክርስቶሳ አይሁድን ካሀንዳሮ ሌ አማኖያ። <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />ክርስቶሳ አይሁድን ካሀንዳሮ ካኮሌሬ ታካለ ኣላንቲ አይዛብ ጋራ ካሻጋ ዋ ጎጎጋላትሮንያ፤ ህክና፥</para>
  <para style="q1" vid="ROM 15:9">“ሃንሱን አን ኩ አይዛብ ኦሮ ጋላቲናራ፤</para>
  <para style="q2" vid="ROM 15:9">መገካዉን ማዛሙሪ ጋላታ ስስናራ”</para>
  <para style="m" vid="ROM 15:9">አማመ ጎጎጻፋመሮያ።<note caller="-" style="x"><char style="xo" closed="false">15፡9 </char><char style="xt" closed="false"><ref loc="2SA 22:50">2 ሳሜ. 22፡50</ref>፤ <ref loc="PSA 18:49">ማዛ. 18፡49</ref>።</char></note> <verse eid="ROM 15:9" /><verse number="10" style="v" sid="ROM 15:10" />አደና፥</para>
  <para style="q1" vid="ROM 15:10">“እስን አይዛብ፥</para>
  <para style="q2" vid="ROM 15:10">ጎሳ ካዋኔ ዎታ ገጌላየን!” አማመ ጻፋመራ።<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />አደና፥</para>
  <para style="q1" vid="ROM 15:11">“አይዛብ ዱባ! ጎታ ጋላታ፤</para>
  <para style="q2" vid="ROM 15:11">ጎሳ ዱባ ዋ ጋላታ!” አማመ ጻፋመራ።<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />ኡሱማለና እስያሳ</para>
  <para style="q1" vid="ROM 15:12">“ታኢሴይ ሳኒኮ ካኡሙላምናራ ኤመይናራ፤</para>
  <para style="q2" vid="ROM 15:12">አይዛብ ሆረሃይ ገጌስን ክናራ፤</para>
  <para style="q2" vid="ROM 15:12">እሶና አብድትሶ ኡሱ ጉት ካታራን” አማራ።<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />አብድትስን አያና ቁሉክ ሁና ጂናታ ጎጎሴቶን አብድ ካስሳራ ሄዶ እስን ኡሱ ማንኮአብዳቴን ማራን ገጌሎና ኖጎዳና ኣሎ እስኑን ሀስሶ።<verse eid="ROM 15:13" /></para>
  <para style="s1">ጳዉሎሳ ጃቡይ ካኮጻፈሮ ኣላንቲ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />አቢላልቴ! እዳኔ ኦአማጋንቴታን፥ ማላባኖ ኦዱሩማቴታና እስን መተመቴ ካካለ ጎርሲን ካዳንዴታን ላኖክስን አን አዴሰራ። <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />አየስ ኮኮ አን እስን ሻድሲን ዶተረ ሂካ ሀንዳ ዋ ኢን ታስሰሮ ስኖክ ማለ ጃቡይ እስኑን ጻፈራ። <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />ህት ስኖና ኢን ካኮንስሳንተታ ካገጌሎ ሃፉራ ካዋ አይዛብን ላላባ ቱቃሞ ኣን ሌረ የሱሳ ክርስቶሳን ሀንዳይንያ፤ ሃንሱን አይዛብ አያና ቁሉክ ካቁሎየና ዋ ካገጌላይሳሮ ጃርሶ ሊ ጎጎጋባላምራዉን ሀንዳራ። <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />ህታ ኣላንቲ የሱሳ ክርስቶሳይ ዋዉን ሀንዳይን ዳንዳኖከይ አን ጣዳታራ። <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />አይዛብ ካአጃጃማሮ ጎጎሌሮን የልን ክርስቶሳ ሃፉራኬይና ፈሎኦቴኮክ ጋራነ ካፈለሮ አየስ ጎሌ ኳሬ አየስ ኮና አዬስን ላኮጃባይናሮ። <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />ኡሱማለና ካጅንጂን ባሳና ኦማምስራን ፈሎይ፥ አያና ቁሉክኮክ ሁናና ኢየሩሳለምኮና ኡሱ ጎቦብኮ ሀጋአበረ ካኢልዋርቆን ኡል ታ ጌሮን ካክርስቶሳ ዎንጋላ አጋልስሰራ።<verse eid="ROM 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 15:20" />አርጌቶ ሀልቻክ እባዶ ካካለ ካቢሰሮ ሀጋአባኖ አንሌኖን ካክርስቶሳ መገ ታኮማልሳሞን ግሮ ባንኤ ዱባ ካእዳንክ ዎንጋላ ላላባኖያ። <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />ህክና፥</para>
  <para style="q1" vid="ROM 15:21">“ሂታኮ ሆረነ ጋራኬሳ ኮና ካኮንሰጋሞን ግራ እባዶ ድናራ፤</para>
  <para style="q2" vid="ROM 15:21">ጋራኬሳ አማሎን ካግራና ሻድናራ”</para>
  <para style="m" vid="ROM 15:21">አማመ ጎጎጻፋመሮያ።<verse eid="ROM 15:21" /></para>
  <para style="s1">ጳዉሎሳ ኡል ካሮም ቶስ ሴይን ቆፓኖ</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />ግዳ ጊን አን እስን ቶስ ኤመይን ካኮዋያራ ጣየ እስኑን ካአዬሰረ አዬስኮክ ኣላንቲያ። <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />ግዳ አደ ሂካ ጎቦቢ ካግሮ ኡሊ ታኮፈላን ባንኤ ማንኮግኖን ማራን፥ ኡሱማለና ጌስ ካሞጋንኮ ሀጋአበረ እስን ድን ሀልቻ ካአቲ ማንኮአቦ ማራን፥ <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />ኡል ካእስፌን ቶስ ኮኮሴየ ጎራታ ኡሱ ራኔ እስን ድን ሄደራ። ጎራታ ክጫሩን እስኔ ዎታ ገጌሎይ ካኮአዳላየ ጎራታ ሰሴታንቴ ሆረድ ሴይን ካዳንዴይስሮ እስን እን ካጋርጋርናታን አን አብድ የላታራ። <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />ግዳ አደ ዋ ኦአማናራኑን ካስሳምናሮ ማራጋደ አብረ ኡል ካኢየሩሳለም ቶስ ሴይናራ። <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />ህክና ኡል ካመቀዶንያይና ኡል ካአካያይ ካግራ እባዶ ካዋ ኢየሩሳለም ካግሮ ሂዬሳሉን ማራጋደ ካጋርጋርሳ ፈኢትሶይ ፋርን ማንኮዶታቴን ማራንያ። <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />ሂክ ጋርጋርሳና ፈኢትሶይ ካኮንስሴራን ካዶትሳሮ ማንኮሌ ማራንያ፤ አይዛብ አይሁድነ ዎታ ሶማ ኦአያና ኦሄዴዳማራን ጎሌ እሶና ሶማ ኦሶየት አይሁድ ጋርጋርን ማንኮዶትሳሮ ማራንያ። <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />ሃንሱን ሂካ ካኩኩአመሮ ማራጋደ ኢየሩሳለም ቶስ ጌስ ስስጉረ ፈሎኦቴ ካኮጉሳየ ጎራታ ኡልክስነ ኤመይረ እስን ዲረ ኡል ካእስፌን ሴይናራ። <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />እስን ቶስ ካኮኤሜየ ጎራታ ኡሶ ካክርስቶሳ ምግ የል አት ኤሜታኖኬ አዴሳራ።<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />አቢላልቴ! ጋራኬ ዋ ቶስ ኤባታ፥ ፈሎኔ ዎታ ሞአባታኖኬይ እን ጎጎጋርጋርታኑን ጎታካን የሱሳ ክርስቶሳና አያና ቁሉክኮት ጌላንጄ ኤባታራ። <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />እስን እን ካኮንኤባይናታን ኡል ካይሁዳ ካግሮ ዋ ካአማኖን እባዶኮት ገነኮ አን ጎጎሄስሮና ኢየሩሳለም ኦግራን ፈሎኦት ዋ ኦአማናራን ዶሌ አታማኖ ጎጎግራዉንያ። <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />ህክና ካኮሌ ጎራታ ፈኢ ታዋ ጎሌተ ገጌሎይ እስን ቶስ ሴይጉረ እስኔ ዎታ ጎራታ ክጫሩን አዳላይን ዶታራ። <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />ካኖጎዳ ዋ ሄዶ እስን ዱባነ ዎታ ሀሌቶ! ሀሚኒዕ።<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s1">ታጳዉሎሳ ኖጎዳ ኡል ካሮም ካግሮ አማኒሉን</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />ፌቤን ታክንክራ ካታማይ ምን ካኤብ ታሀንዳቶ ታአብዳንተ አባታን ላኖ ጎጎአዴሳኑን ዶታራ። <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />ኤሰ እና ካካለ ካሞጋን እባዶ ታጋርጋርተቶ ማንኮሌተ ማራን አማኒሉን ማርት ቆጳታኖ ካዶትሳሮክ ማለ መገ ካጎታይ ቆጳይዴን ኤሰን ካዶትሳሮ ኮኮ ዱባ ጎጎጋርጋርታኑን አን ሀዳራ አማራ።<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />ፈሎ ኦየሱሳ ክርስቶሳ ኢነ ዎታ ኦፈላራን ጲርስቂላና ኤንተርክሴ አቅላን ኖጎዳ ገጊሳ <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />እሶና እን ማራን ጎይና ዱዶ ኦኤካሳቴረንያን፤ ሂካኑና አርጌቶ እሶ ጋላታራ፤ አን ካላል አንሌኖን ግራን አይዛብኮ አብድትሶ ቶስ ካአባባተሮ አማኒልና ካሞጋን ምን ካኤብኔ ሌረ ራቶ ጋላታራን። <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />ምንክሶይ ኤቢን ካኩኩማሮ አማኒሉን ኖጎዳ ገጊሳ።</para>
  <para style="p" vid="ROM 16:5">ካእስያ ኡል ሆራርጀ ዋይ ካአማኔሮ አን ካጌላታሮ ኤጰነጦሲን ኖጎዳ ገጊሳ። <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />እስኑን ታንጂን ታዳፉርተቶ ማርያሜን ኖጎዳ ገጊሳ። <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />ኢነ ዎታ ሻሜን ኦግሬዉና ኦፋራመራን ኦሮ አዴሳመን ኦግረን አይሁድ ኦሌረን ፋልኬዉን፥ አንድሮቆሳና ዩልያን ኖጎዳ ገጊሳ፤ እሶና ክርስቶሳ አማናኖ እንኮ ጣናን።<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />መገ ካጎታይ አን ካጌላታሮ አንጲልያጦስን ኖጎዳ ገጊሳ። <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />ፈሎ ኦክርስቶሳ ኖኔ ዎታ ካፈላሮ ካሌሮ ኡርባኖሳና አን ካጌላታሮ እስጣቁሳን ኖጎዳ ገጊሳ። <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />ክርስቶሳ ግራኖ ጫፋመረ ካኮአቶታመሮ አጲልሲና፥ ኡሱማሌ አርስጦቡሎሳኮክ ካምነ እባዶን ኖጎዳ ገጊሳ። <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />አይሁድት ፋልኬዉን ሄሮድዮንና ካናርስስ ካምነ እባዶኮ ጎታ ካአማነሮን ኖጎዳ ገጊሳ።<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />ካጎታ ሀንዳዉን ኦዳፉራራን አባጆላልካን ትሩፋይናዉና ትሩፎሳን፥ ኡሱማለና አደ ካጎታ ሀንዳዉን ኣሎ ታዳፉርተቶና መገ ካክርስቶሳ አን ታጌላታሮ ፐርስስን ኖጎዳ ገጊሳ። <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />ጎታዉን ሀንዳኖይ ኣሎ ካአዴሳመሮ ሩፎሲና አደ እን ኤረክሴ ኣን ጌላታ ታግቴ ኣየቴሳና ኖጎዳ ገጊሳ። <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />አስንክርቶሳና ፈለንጎን፥ ሄርመሲን፥ ፓትሮባሲና፥ ሄርማሲን፥ እሶነ ዎታ ታግቶ አቢላሉን ኖጎዳ ገጊሳ። <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />ፍለጎሳን፥ ዩልያ፥ ነርያና አባቴሳን ኡሱማለና ኦሉምፓስና እሶነ ዎታ ኦግራን ዋ ኦአማናራን ዱባን ኖጎዳ ገጊሳ። <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />ቁሉክ እስአንጋታኖይ ኖጎዳ አታ። ካክርስቶሳ ካሞጋን ምን ካኤብ ዱባ ኖጎዳ እስኑን ፋራመራ።<verse eid="ROM 16:16" /></para>
  <para style="s1">ካጋቾ ጎርሳ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />አቢላልቴ! እስን ካአጋልሳቴታን አጋልስስ ኔባታ እስን ኦሮ ካለካለ ቤያኖና ራኮ ካኬናሮ እባዶኮ እስኦራዬን፤ እሶኮና ፋክማ! <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />ሂካ ኣንክክ እባዶ እስኦትሶ ኳሬ ጎታካን ክርስቶሳን ላኮሀንዳራን። አየስ ኦኖሞይሳ ፋያንካክ እባዶኮት ዎዳና ሶባራን።<verse eid="ROM 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 16:19" />ሀንዳኖክስን ዱባ ማሌራን ሂካኒና አን ኣሎ ገጌላየራ፤ ጎሌና ካእዳን ካሌ አየሱን ቃሮሌ፥ ካሜላን ካሌዉን ፋያንካኒዕ ጎጎሌታኑን ዶታራ። <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />ሂካ ጎፈልቴን ኖጎዳ ካስሳራ ሄዶ ሳሜ. ጻላየ ሉቃኦትስን ሄገሊ ጫንጫናራ፥</para>
  <para style="p" vid="ROM 16:20">ታጎታ የሱሳኮት ስኖ እስኔ ዎታ ሀሌቶ።<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />እኔ ዎታ ካፈላራ ጢሞቶሳ ኡሱማለና አደ አይሁድ ፋልኬ ኦሌራን ሉቅዮሳ፥ ኢዮሶንና ሶስጳጢሮሳ ኖጎዳ ፋራሜራን።<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />ሂካ ሀንዳ ካጻፈራ አን ጠርጢዮስና መገ ካጎታይ ኖጎዳ ፋራማራ።<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />እና ህታኒ ካግሮ ምን ካኤብ ዱባ ካማርቲሳራ ጋዮሳ፥ ኡሱማለና፥ አደ ካታማኮክ ኦዶናት ካአባናየ ኤራስጦስ፥ አብካን ቁዋርጦስ ኖጎዳ ፋራማራን። <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />[ጎታካን የሱሳ ክርስቶሳኮት ስኖ እስን ዱባነ ዎታ ሀሌቶ! ሀሚኒዕ።]<verse eid="ROM 16:24" /></para>
  <para style="s1">ካሶማ ኤብ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />አን ካላላባሮ ካገጌሎ ሃፉራ ጋራ ካየሱሳ ክርስቶሳ ካሰጋማሮ ሀንዳይና ጌስ ካጣዎኮ ሀጋአበረ ስያመ ካአዳላተሮ፥ ግዳ አደ ካሙተሮ ታሩም ሆልኮት ጋራነ ዋ አማኖክስኒ ጎጎአልታኑን እስን የልን ዳንዳራ። <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />ግዳ አደ ህት ሩም ሙተታ፤ ጅሩ ጅሮማክ ሄዶኮክ አጃጃ ዱባ አማንረ ጎጎአጃጃምሮን ካሄገሮል ማጻፋኮክ ጋራነ ጎሳ ዱባ ጎጎአዴስሮን ሌራ።<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />ኡሱ ካላል ቃሩማ ካአቦ ሄዶ ኮ፥ የሱሳ ክርስቶሳኮክ ጋራነ ጅሩ ጅሮማን ጋላታ ሀጌዎ! ሀሚኒዕ።<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>