<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Bayso New Testament</book>
  <para style="h">ሉቃሳ</para>
  <para style="toc1">ሉቃሳ ካጻፈሮ ጎታካንክ ካየሱሳ ክርስቶሳ ዎንጋላ</para>
  <para style="toc2">ሉቃሳ</para>
  <para style="toc3">ሉቃ.</para>
  <para style="mt1">ሉቃሳ ካጻፈሮ</para>
  <para style="mt2">ጎታካንክ ካየሱሳ ክርስቶሳ ዎንጋላ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ዎንጋላ ካሉቃሳ ጋራ ካየሱሳ ጣየ ኤመይናራ አማመ ካሄገሮል ካሰጋመረ ጌስ ካሞጋን ካአብዲ ኦዶ ካሌረ ካእስራኤል ጎሳ ኦራታ ካግረ፥ “ክርስቶሳ” ኡሱማለና ሳኒ ታእባዶ ዱባ፥ “ካሃሳሮ” ላኖ ቱሳኖይያ። ሉቃሳ፥ የሱሳ “ህየሳሉን ዎንጋላ ጎጎላላበሮ” ኣቦኬሳኮ ካፋራመሮ ላኖና ሂክ ዎንጋላ እባዶ ታአቦ ካለካለክ ቃራሉን ማላ ካአቦ ላኖ ማማካራ። ዎንጋላ ካሉቃሳ ኦሮ ካካለኮና የሱሳኮት ኤመቶ ኦሰጋራን ኦሆራርጄ ፎልሲጆልና አባባይ የሱሳኮክ ዳሩር ቶስ ብያኖ ኦአዬሳራን ኦጋቾ ፎልሲጆል ኣሎ አዴሳመ ካሰጋመረ ገገሎኮክ ጋራየ። ካየሱሳ ዳሩር ቶስ ብያኖኮ አባባተረ አማኖ ካክርስታና ምሲ ጂናተሮና ምሲ ባላኣተሮ ታአዴስሳታ ጅርት ኦፋራሜራኮክ ማጻፋይ ኦሮ ሂካ ማጻፋ ካጻፈሮ እባዶትዋ ሰጋመራ።</para>
  <para style="ip">ማዛሙር ካኤርግቻኮክ ጋራ፥ የሱሳ ታኮአላተሬ ኦፎፌ ኤሜይ ደያኖኮክ ታአዬሳታ ጅርት፥ የሱሳ ይሱማይ ቁሉክ ምን ካኤብ ሴታኖኮክ ጋራ፥ ካነኔኤይሳታረ ሳማራውትና ባየ ካሄላመሮ ኡኑኮት ጅርት ዎንጋላ ካሉቃሳ ካላሊ ኦግራንያን። ዎንጋላኬሳይ ቃማኮ ቃማ ታጌሮ ታንጂን ክንትብ ካኮንስሳመራ ኤብኮክ ጋራና አያና ቁሉክኮክ ጋራ ሄለል ካየሱሳ ሀንዳይ ኦሮ ታአቦ ባንኤና ዋ ጩቦ ሀሄሶ አማማኖኮክያ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="LUK 1:1-4">1፡1-4</ref> </char></para>
  <para style="io1">ካጣማቃሮ ያንሳኮክና ካየሱሳ ክርስቶሳኮክ አላታን <char style="ior"><ref loc="LUK 1:5-2:52">1፡5—2፡52</ref> </char></para>
  <para style="io1">ካጣማቃሮ ያንሳኮክ ሀንዳኖ <char style="ior"><ref loc="LUK 3:1-20">3፡1-20</ref> </char></para>
  <para style="io1">የሱሳኮክ ጣማቃማኖና ጫፋማኖ <char style="ior"><ref loc="LUK 3:21-4:13">3፡21—4፡13</ref> </char></para>
  <para style="io1">የሱሳ ሀንዳኖ ካጋሊላ ኡሊ <char style="ior"><ref loc="LUK 4:14-9:50">4፡14—9፡50</ref> </char></para>
  <para style="io1">ኡል ካጋሊላኮ ኢየሩሳለም ቶስ ብያኖ <char style="ior"><ref loc="LUK 9:51-19:27">9፡51—19፡27</ref> </char></para>
  <para style="io1">ካጋቾ አልማ ኢየሩሳለምና ጎቦብክሴይ <char style="ior"><ref loc="LUK 19:28-23:56">19፡28—23፡56</ref> </char></para>
  <para style="io1">ጎይኮ ክያኖ ካየሱሳና ኡሱኮ ኦአጋልሳታራዉን አድአድ ሙታኖና ዳሩር ቶስ ብያኖ <char style="ior"><ref loc="LUK 24:1-53">24፡1-53</ref> </char></para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>ካካባጃንተ ተዎፍሎሳ! ኖ ኦሮ ኦፈላመራን ፈሎ ታቱሳቶ ጅርት ኦሞጋን እሶን ካዳንዳመሮ ግታክ ኖን ጻፈን ካዬራን። <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>ህታ ጅርት ኖን ኦሮርሰራን ሆርኮስኮ ካዬረነ እሊ ካዴራን ኦአቶታረና ሃፉራኬሳ ኦሀንዳሬንያን። <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>ኡሱማሌ አንና አደ ታቴኮ ሆራርጀኮ ኬሰረ ካአመን ዱባ ላላን ካኮቆቆሮ ጎራታ፥ ጅርትና እስደቤ አን ኩን ጎጎጻፍሮን ታኢዳንት ሌተ ኢን ሙተ። <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>ሂካና አን ካኮንየላራ አት ካአጋልሳተታ አየስ ካሩም ላኖ ጎአዴሶንያ።<verse eid="LUK 1:4"/></para>
  <para style="s1">ካጣማቃሮ ያንሳኮክ ኡሙላማኖ ጣየ ሰጋመ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>ሄሮዶሳ ኡል ካይሁዳይ ዎኖ ካኮሌረ ጌሲ፥ ታአብያ ኡና ካሌረ ዛክራሳ ካአማማራ ቱቃሞት ኮ ግረ። ኦርቴሳ ኤልሳቤጢና ጎሳ ካአሮንኮትተ። <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>ላማ ዱባና አጃጃ ካጎታና ሴራ ዱባ ኦራተሬን ቱፍ ካላይ ዋይ ሆረ ኦግረን ቁሉኒዕዬን። <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>ሀሌዎ ኳሬ ኤልሳቤጥ ማሴንተደ የሎ ላአባናየን፤ ላማ ዱባና ኦጃሮመረንየን። <verse eid="LUK 1:7"/><verse number="8" style="v" sid="LUK 1:8"/>አሪ ቶ ዛክራሳ ጅግኬሳይ፥ ዋይ ሆረ ቱቃሞ ሌ ታኮፈላሬ፥ <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>ዎጋ ካቱቃሞልኮክ ማለ፥ ካጎታ ቁሉክ ምን ካዋ ታብረ ኢጣና ኢዮሲን ህጣይ አሳባመ። <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>እጣና ካኮኢዮሮ ጎራታ ጎሳ ዱባ ሳሬ ኤባታረ። <verse eid="LUK 1:10"/><verse number="11" style="v" sid="LUK 1:11"/>ካጎታ ኤርግቻ ታኢጣና ባንኤ ምና ታመርጌነ አሌ ኡሱን ሙተ። <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>ዛክራሳና ኮኮድያረ ጎራታ ኔ፤ ኣሎና አብሳተ፤ <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>ኤርግቻና ጎአመን ኡሱነ፥ “ዛክራሳ! አሮአብሳተ! ኤብካ ማልሳመራ፥ ኦርታ ኤልሳቤጥ ባባርትት ኡሙልናታ፥ መገኬሳና አት ያንሳ አምናታ። <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>አት ኡሱ ኤካታኖና ገጌላንጄ ሄላይናታ፥ ካሞጋና ኡሙላማኖኬሳይ ገጌላይናራን። <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>ጎታ ሆረና ኡሱ ካንጅንክ ልናራ። ጣሞ ካዎይኒና ሌረ ካካለ ካሴቲስሮ ጣሞ ላኮጣምናሮ፤ ኣየቴሳት ገዴም ኦሮ ግራንቲ አያና ቁሉክ አማጋምናራ። <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>ካእስራኤል ይስኮ ካሞጋን ጎታ ሄዶክሶ ቶስ አባብናራ። <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>ዎዳና ታኦዶላልና ታይስ ቶስ፥ ካአጃጃሞን እባዶኮት ዎዳና ቁሉት ቃሩማ ቶስ አባብናራ። ካኤሜታሮ ጎታዉን ጎሳ ጎጎኤካስሮ ኤላሳ ጉት ካፈለሮ አያና ቁሉኪና ሁናይ ጎታ ሆረ ሰሴይናራ” አመ። <verse eid="LUK 1:17"/><verse number="18" style="v" sid="LUK 1:18"/>ዛክራሳና ኤርግቻነ፥ “አን ሂካ ሜይ ማላብናራ? አን ጃርሳያ፥ ኦርትና ጃርትታ” አመ። <verse eid="LUK 1:18"/><verse number="19" style="v" sid="LUK 1:19"/>ኤርግቻትና አባበረ፥ “አን ዋይ ሆረ ካኣላሮ ጋብሬለያ፥ ሂካ ካገጌላይሳሮ ሃፉራ ኩን ሰግን አን ዋኮ ፋራመራ። <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>ሂክማ ጎራታኬሳ ኦራተረ ካፈላምናሮ ሃፉራኬ አት አማናታና ማንኮዋተ ማራን፥ ሂክ አን ካሰጌራ ዱባ ታጉዳሮ አት ህኢ ዱድናታ፥ አዬስና ላኮዳንድናቶ” አመ።<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>ሀሱ ጎራታ ጎሳ ዛክራሳ ቁሉክ ምን ካዋኮ አንቤኖን መዉን አዳላተሮ ማሜን ኦራታ ግረን። <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>ካኮበያረ ጎራታና ኡሱ እሶነ ዎታ አዬስን ላኮዳንዴረ። ማላታ ቱሳኖ ኳሬ አዬስን ዳንዳናዋትኮ ካከይ ቁሉክ ምን ካዋ ኦሮ ራጋ ኡሱ ድያኖ አዴሰን።<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>ዛክራሳና ካኮሀንዳረ አልማ ካኮጉዳታረ ጎራታ ምንኬሳ አባባተ ሴተ። <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>ኤሰኮ አባባተረ ኦርቴሳ ኤልሳቤጥ ፋቶ ቶታተ፤ ድግኒ ከኑን ምንክሴይ እስኦትሴ ስያምሳተ። <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>“ኤሰና፥ ጎታ ሻጋኬሳይ ቱፋማኖካኬ እባዶ ኦሮኮ ትርን አመረ ሂካ ባር ሂካ አየስ ኢን ፈለራ” አንተ።<verse eid="LUK 1:25"/></para>
  <para style="s1">የሱሳኮክ ኡሙላማኖ ጣየ ሰጋመ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>ኤልሳቤጥ ፋቶ ቶታተደ ድግኒ ታለይ፥ ዋ ኤርግቻት ጋብሬለ ጋሊላ ታግቴ ናዝረት ካታማ ቶስ ፋረ። <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>ካኮንፋራመረና ሳኒ ታዳዉተኮክ ዮሴፋ ካአማራን እባዶትን ታኤራንተተ ሙመት ዴለልትት ቶስየ፤ ሙመት ዴሌልትትኮክ መገና ማይራመየ። <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>ኤርግቻትና ኤሰ ታግቶ ባንኤ ቶስ ታበረ፥ “አት ስኖ ታኮአማጋንተታ፥ ኖጎዳ ኩን ሀሌቶ! ጎታ ኩኔ ዎታ ግራ፥ አትና ኣሎ ታሶማሳንተታ” አመ። <verse eid="LUK 1:28"/><verse number="29" style="v" sid="LUK 1:29"/>ማይራመና አዬስኬሳ ኣሎ ነይተደ፥ ህት ምስት ኖጎዳታ? አማ ቆፓኖ ሀጋአብተ። <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>ኤርግቻትና ኤሰነ ሃ አመ፥ “ማይራመ! አት ዋይ ዶሌ ጋሻና ሄላተታ አሮአብሳተ። <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>ሂክማ፥ ቶታይናታ፤ ኤረ ባባርትትና ኡሙልናታ፤ መገና የሱሳ አምናታ። <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>ኡሱና ካንጂንክ ልናራ፥ ዱባንኮ ጦክቅ ካአመ ኤረ ካዋና አማምናራ፤ ጎታ ሄዶና ኣቦኬሳክ ካዳዉተ ኮርፍንጀ ኡሱን ስስናራ። <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>ሳኒ ታያይቆባ ጉት ጅሩ ጅሮማን ሬድናራ፤ ዎኖናትኬሳ ጋቾ ላኮአቦ።”<note caller="-" style="x"><char style="xo" closed="false">1፡33 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">2 ሳሜ. 7፡12-13</ref>፤ <ref loc="2SA 16">16</ref>፤ <ref loc="ISA 9:7">ኢሳ. 9፡7</ref>።</char></note> <verse eid="LUK 1:33"/><verse number="34" style="v" sid="LUK 1:34"/>ማይራመና ኤርግቻትነ፥ “አን ሙመት ዴለልትትያ ሂክ ምሲ ሊን ዳንዳራ?” አንተ። <verse eid="LUK 1:34"/><verse number="35" style="v" sid="LUK 1:35"/>ኤርግቻትና አባበ ኤሰነ ሃ አመ፤ “አያና ቁሉክ ኩ ጉት ዳግናራ፥ ዱባንኮ ጦክቅ ካአመ ሁና ካዋና ኩ ጉት ግርናራ፤ ሃንሱን ካኡሙላምናራ ይትት ቁሉክ ኤረ ካዋ አማምናራ። <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>ሂክማ፥ ፋልታታ ኤልሳቤጢና ዶኡማኦሮይ ኤረ ባባርትት ቶታተታ። ማሴና ታአማንተቴና ድግኒ ታለይ አብተታ፤ <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>ዋዉን ካሌኖን ላግሮ።” <verse eid="LUK 1:37"/><verse number="38" style="v" sid="LUK 1:38"/>ማይራመና፥ “አን ታጎታ ድይያ፤” “ሃፉራካክ ማለ ሀሌዎ” አንተ። ኤሰኮና ኤርግቻትና ኤሰኮ ካለቤ ሴተ።<verse eid="LUK 1:38"/></para>
  <para style="s1">ማይራመ ኤልሳቤጥ ሆሳይን ሴታኖ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>ማይራመና ሀሱ ጎራታ ሳንተ ኬተደ ዎዳሚልክ ኡል ታይሁዳ ካታማ ቶ ቶስ ሴተ። <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>ምን ካዛክራሳ ቶስ ታብተደ ኤልሳቤጢነ ኖጎዳ ኣተ። <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>ኤልሳቤጢና ታማይራመ ኖጎዳ ካኮማላተ ጎራታ፥ ይትትና ገዴም ኦሮ ኣኤ፤ ኤልሳቤጢና አያና ቁሉክ አማጋንተ። <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>ያየትሴና ጦቂሰጉደ ሃ አንተ፤ “አት ሄለል ኦሮኮ ታሶማሳንተታ፤ ገዴምታኮ ካኡሙላምናራ ይትትና ካሶማሳመያ። <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>አፎ ጎታኬት አዬ እን ቶስ ኤሜይና አን አዮያ? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>ሂክማ፥ ኖጎዳታት ያየ ነበቴይ ጎጎታብቴ ገዴምቴይ ኦሮ ካግረ ይትት ገጌሎይ ኣኤ። <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>ጎታ ዶለኮ ካፋራመራ ሃፉራ ጉዳይናራ አንተ ታአማናተ ኤሰ ታሶማሳንተታ!”<verse eid="LUK 1:45"/></para>
  <para style="s1">ማዛሙር ካማይራመ</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>ማይራመና ሃ አንተ፤</para>
  <para style="q1" vid="LUK 1:46">“ኔፎት ጎታና ጦቂ ጦቂኢሳታ።<verse eid="LUK 1:46"/></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47"/>አያናክና ካፋይሳሮ ዋኬይ ገጌላታራ።<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>ኡሱ ድይ ቴሳክ የራን ዴራ፤</para>
  <para style="q1" vid="LUK 1:48">ህታ አርኮ ሀጋአበረ አላታን ዱባ እን ታሶማሳንተ አምናታ።<verse eid="LUK 1:48"/></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49"/>ካአቲ ካሌራ ኡሱ ካንጅንክ አየስ ኢን ፈለራ</para>
  <para style="q2" vid="LUK 1:49">መገኬሳና ቁሉክያ።<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>ነኔኤይሳታኖኬሳ ኡሱ ኦአብሳታራኑን፥</para>
  <para style="q2" vid="LUK 1:50">አላታንኮ ታ አላታን ጌሮ ግርናራ።<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>ሁናካከሳይ ፈሎ ኦአቲ ፈለራ፤</para>
  <para style="q2" vid="LUK 1:51">ዎዳናታትሶኮት ቆፋ ኦኮራራና ዳረኤራ፤<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>ሞትጆል ኮርፍንጄልኮ ዳግሰራ፤</para>
  <para style="q2" vid="LUK 1:52">እስ ኦየራሳታራና አደ ጦቂኢሰራ፤<verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>ኦኡኤራና ካኢዳነ አየስ ባራርሰራ፤</para>
  <para style="q2" vid="LUK 1:53">ዱሬሳል ጎአመን ሀላል ጋፋረራ፤<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54-55" style="v" sid="LUK 1:54-55"/>ነኔኤይሳታኖካከሳ ሻዳ፥</para>
  <para style="q2" vid="LUK 1:54-55">ድይልኬሳ እስራኤል ጋርጋረራ፤ ህክና ኦዶላልካን ጎጎአዬሰሮ አብራመና ሳኒታተሳን ካአመሮ ጅሩ ጅሮማን ኦርንያ።”<verse eid="LUK 1:54-55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>ማይራመና ድግኒ ሴድ ታሌቶ ኤልሳቤጥ ዶሌ አዳላተጉደ ምንካክሴ አባባተ።<verse eid="LUK 1:56"/></para>
  <para style="s1">ካጣማቃሮ ያንሳኮክ ኡሙላማኖ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>ኤልሳቤጢና ታኡሙላ አሪ ጌተ፤ ኤረ ባባርትት ኡሙልተ። <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>ኦላትሰና ፋልክሰ ጎታ ኤሰን ካአቲ ነኔኤይሳታኖ ካየለሮ ማለንጉሬን፥ ገገሎኦትሰና ኤሰ ዎታ ገጌላተን። <verse eid="LUK 1:58"/><verse number="59" style="v" sid="LUK 1:59"/>ይትት ታኮኡሙላመረ አሪ ታስዴድ ይትት ሀማጽሲን ኤመተን፤ ኣቦኬሳክ መገ ዛክራሳ አምን ዶተን፤ <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>ኣዎተሳ አደ “ላኮሃዮ ያንሳ አማሚን ዶትሳራ” አንተ። <verse eid="LUK 1:60"/><verse number="61" style="v" sid="LUK 1:61"/>እሶና “ፋልካካኮ ሂካ መገ ካኡማማራ ማዮና ላኮግሮ” አመን። <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>ኣቦኬሳ መገ አዮ አም ቤስን ዶታሮ ማላታይ ሆሳተን። <verse eid="LUK 1:62"/><verse number="63" style="v" sid="LUK 1:63"/>ኡሱና ካኮጻፍራን ሳሌዳ ጎጎስስናዉን ኤባተረ፥ “መገኬሳ ያንሳያ” አመ ጻፈ፤ ዱባና ሂካ አዬንሳ ሳደ። <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>ጎርሰዋ ህኢቴሳ ባናንተ፤ ኤሬብኬሳና ፉራመ፤ ዋና ጋላታ አዬሳኖ ሀጋአበ። <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>ኦላትሰ ዱባና አብሲ አማጋንተ፤ ሂክ አየስ ዱባ ዎዳሚልክ ኡል ካይሁዳ ዱባ አዬሳመ። <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>ሂካ ካማለ ዱባና፥ “ሂክ ይትት ምስ ሊን ሌራ?” አማ አየስ ዎዳናታትሶይ አባተን። ገነ ታጎታ ኦግራን ኡሱ ዎታ ግቴ።<verse eid="LUK 1:66"/></para>
  <para style="s1">ሄገሮ ኦዛክራሳ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ካያንሳ ኦዶ ዛክራሳ አያና ቁሉክ አማጋመረ ሃ አማ ሄገሮ አዬሰ፤ <verse eid="LUK 1:67"/><verse number="68" style="v" sid="LUK 1:68"/>“ካእስራኤል ሄዶ፥ ጎታ ሀሶማሳመ፤ ኡሱ ካኮንኤመተራ ጎሳ ጋርጋርና ፋይሲንያ። <verse eid="LUK 1:68"/><verse number="69" style="v" sid="LUK 1:69"/>ድይኬሳክ ታዳዉተ ሳኒኮ፥ ካፋይሳሮ ካአቲ ኬሰራ፤ <verse eid="LUK 1:69"/><verse number="70" style="v" sid="LUK 1:70"/>ህክና ሆርኮ ቁሉኒዕ ኦሄገሮልኮት ህኢ ኡሱ ጎጎአዬሰሮ፥ <verse eid="LUK 1:70"/><verse number="71" style="v" sid="LUK 1:71"/>ፋይናና ዲናጆልካንኮና፥ ኖ ካድዳሮኮት ገነኮ ጎጎሄንሶንያ፤ <verse eid="LUK 1:71"/><verse number="72" style="v" sid="LUK 1:72"/>ኡሱ ሂካና ካኮንየለራ ኦዶላልካኑን አብዲ ካታበሮ ሻጋ ቱሲና፥ ቁሉኒዕ አማቶ ሻድሲን፥ <verse eid="LUK 1:72"/><verse number="73" style="v" sid="LUK 1:73"/>ኣቦካን አብራመና ኦታበሮ አማቶ ሻዲን፥ <verse eid="LUK 1:73"/><verse number="74" style="v" sid="LUK 1:74"/>ዲናጆልካንኮት ገነኮ ቤስረ አብስ ካላይ ኡሱን ጎጎሀንዳይኖን፥ <verse eid="LUK 1:74"/><verse number="75" style="v" sid="LUK 1:75"/>ጌስካካን ዱባ ቁሉማና ሩሚ ኡሱ ሆረ አሊስንያ። <verse eid="LUK 1:75"/><verse number="76" style="v" sid="LUK 1:76"/>አደ አት ይትት፥ ዱባንኮ ጦቂ ካአመ ሄገሮት ካዋ አማምናታ፤ ካጎታ ራ ኤካስን ኡሱ ሆረ ሴይናታ፤ <verse eid="LUK 1:76"/><verse number="77" style="v" sid="LUK 1:77"/>ጩቦክሶኮ ሀሄሶ አማማኖ ሄላታናኮ ካከይ፥ ጎሳን ካፋይና ማላባኖ ጎጎስሳምሮ፥ <verse eid="LUK 1:77"/><verse number="78" style="v" sid="LUK 1:78"/>ሄዶካንክ ካኢዳነ ነኔኤይሳታናኮ ካከይ፥ ታባባርሴ ታፋይና አሪ ዳሩርኮ ኖየን ቤተ፤ <verse eid="LUK 1:78"/><verse number="79" style="v" sid="LUK 1:79"/>ህክና ሙጉዲ ኦሮ ኦግራዉና ሆስ ታጎይ ኦሮ ኦግራዉን ጎጎሀንቃይስሮና፥ ሉቃኦታንና ራ ካኖጎዳ ቶስ ጎጎቃጄልስሮንያ።” <verse eid="LUK 1:79"/><verse number="80" style="v" sid="LUK 1:80"/>ይትትና ጂናተ፤ አያና ቁሉክና አታተ፤ ጎሳ ካእስራኤሊን ዲዳ ቤ ታሙተረ አርኮ አባባተረ ጋድ ግረ።<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">ኡሙላማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶ. 1፡18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>ሀሱ ጌሲ፥ ቃላዳኬሳክ ጎሳ ዱባ ጎጎቶታምሮና መገክሶ ጎጎማዛጋባምሮ ካሮም ዎኖ አዉግስጦስኮ አጃጃ ቤ። <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>ህክና ቀረነዮስ ካሶርያ ኡልኮክ ሞት ሌ ታኮግረ ካሆራርጄ ጎሳኮክ ቶታማኖ ግረ። <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>ሃንሱን እባዶ ዱባ ማዝጋባሚን ካታማ ታቴሳታቴሳ ሴተ። <verse eid="LUK 2:3"/><verse number="4" style="v" sid="LUK 2:4"/>ዮሴፋ ዳዉተን ኤነክ ፋል ማንኮሌረ ማራን፥ ጋሊላ አዉራጃይ ታግቶ ናዝረት ካታማኮ ኬጉረ ዳዉተ ታኮኡሙላመረ ካታማ ቤተሌም ታአማራን ታይሁዳ ካታማ ቶስ ቤ። <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>ማዝጋባሚን ኤሰራ ሴተን፤ ፋቶ ቶታተ ታግቴ ማይራመና ኤሰ ካኤራተረነ ዎታ ሴተ። <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>ኤሰ ታቤተለም ካታማይ ግራንቲና ታኡሙላ አሪ ጌተ፤ <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>ኤረ ባርክ ካሌሮ ባባርትትና ኡሙልተ፤ ሆጮይና ማማርተደ፥ ማርት ታኮፎልሳቶ ባንኤ ሄላይን ማንኮዋተነ ማራንቱን አዉድ ካሳየት ኦሮ ሁዱርሰ።<verse eid="LUK 2:7"/></para>
  <para style="s1">ኦፎፌና ኤርግቻና</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>ኡሱ ኡሊ ሄመን ግድ ኦራታ ዲዳ ካባራረ ካፎፈል ግረ። <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>ካጎታ ኤርግቻና ደራኣ ኤመተረ እሶ ዶሌ አሌ፤ ታጎታ ካባጃ እሶን ማራሙረ ሀንቃይሰ፤ አብስ ታአቲ እሶ አብተ። <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>ኤርግቻ አደ እሶን ሃ አመ፤ “አሮአብሳቴን! ጎሳ ዱባን ገጌሎ ኦአቲ ታሌቶ ኦዱ ታኢዳን አን ኣተ ኤመየራ። <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>ህታር ታዳዉተ ካታማይ ካፋይስራ እስኑን ኡሙላመራ፤ ኡሱና ጎታ ክርስቶሳያ። <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>ሂክ እስኑን ማላታ ሀሌዎ፤ ክጫርክ ይትት ሆጮይ ማማራመረ አዉድ ካሳዬ ኦሮ ሁዱረ ካግሮ ሄልናታ።”<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>ደራኣ ኤርግቻትነታ ካሞጋን ካዳሩረ ኤርግቻልና ዎታ ሙተ፤ ዋና ጋላታ ሃ አመን፤ <verse eid="LUK 2:13"/><verse number="14" style="v" sid="LUK 2:14"/>“ካባጃ ኤለ ዳሩሪ ካግሮ ዋዉን ኖጎዳና ኡሱ ካጌላታሮ እባዶን ኡሊ ሀሌቶ!” <verse eid="LUK 2:14"/><verse number="15" style="v" sid="LUK 2:15"/>ኤርግቻት እሶኮ አሳባመ ዳሩር ቶስ ካኮበያረ ጎራታ ኦፎፌ፥ “ጎታ ኖን ካቱሰሮ ሂካ ሃ ካሌሮ አየስ ድን ቤተሌም ቶስ ሴና” እስእስኦሮ ሃ አመን። <verse eid="LUK 2:15"/><verse number="16" style="v" sid="LUK 2:16"/>እሶና ሳመን ሴተን፤ ማይራመና ዮሴፋ፥ ይትትና አዉድ ካሳየት ሁዱረ ካግሮ ሄሌን። <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>ካኮደያሬን ጎራታና፥ ኤርግቻ ጋራ ካይትትኮክ እሶን ካሰገሮ አዴስሰን ሰገን። <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>ሂካና ካፎፌ ካሰገሮ አየስ ካማለ ዱባ ሳደ። <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>ማይራመ ጎአመን ሂካ ዱባ ዎዳናትሴይ አባተደ ቆፋ ገጌሳታና ኦራታ ግቴ። <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>ኦፎፌ አየስ ዱባና ኤርግቻት ጎጎሰጌሮክ ማለ ሌ ሄላኖይና፥ ካማለራና ካዴራን ዱባ ማራንቱን ዋ ካባጃና ጋላታ አባባተን።<verse eid="LUK 2:20"/></para>
  <para style="s1">ይትት የሱሳ ቁሉክ ምን ካኤብ ጌሰን</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>አሪ ስዴድ ሌተደ ካኮሀማጽሳምራ ጎራታ ጎጎጌይ ፋቶ ቶታማናኮ ሆረነ ኤርግቻ ካቤሰሮ መገ “የሱሳ” አማመ ኡማመ። <verse eid="LUK 2:21"/><verse number="22" style="v" sid="LUK 2:22"/>ሴራ ካሙሴ ማለ ካኮሙጭአማራን አልማ ካኮጉዳታረ ጎራታ፥ ዮሴፋና ማይራመ ይትት ጎታዉን ስስን ኢየሩሳለም ቶስ ኣተን ቤን፤ <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>ህክና ሴራ ካጎታይ፥ “ባባር ካሌራ ባርክ ኤረ ዱባ ጎታዉን ካቁሎየ ልናራ” አማመ ጎጎጻፋመሮ ፈሎሀይሲና፥ <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>አደና ሴራ ካጎታይ፥ “ዋኖስ ላማ ጎርቱን ላማ ካአራቤ ጩጩተል ጃርሶ የል ስሲንየ።”<verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>ሀሱ ጎራታ ዋ ካአብሳታረና ዋይ ሆረ ሩሚ ካግረ ስሞና ካአማማረ እባዶት ኮ ኢየሩሳለም ግረ፤ ኡሱና ካእስራኤል ፋይና ካኦራታረና አያና ቁሉክ ኡሱ ጉት ካኮባሬረ እባዶትየ። <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>አደና ካፋይሳሮ ክርስቶሳ ጎታይ ካሽግዳመሮ አንዴኖን ካጎኖን ላኖ አያና ቁሉክ ኡሱን ሙተ ግረ። <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>ኡሱና ሀሱ ጎራታ አያና ቁሉክኮክ ገጌሳኖይ ቁሉክ ምን ካኤብ ቶስ ታበ፤ ዮሴፋና ማይራመና ሴራክ ማለ ጎጎካሳናየኒ ኡሱን ካዶትሳሮ ፈልን ይትት የሱሳ አበን ካኮታቤረን ጎራታ፥ <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>ስሞና ይትት ቆጳተረ ጌግዮተሳ አባተ፤ ዋና ጋላታ ሃ አመ፤ <verse eid="LUK 2:28"/><verse number="29" style="v" sid="LUK 2:29"/>“ጎታኬ፤ አማቶ ጎጎጉድሰቶክ ማለ ግዳ ድይካ ኖጎዳ ጋልስ፤ <verse eid="LUK 2:29"/><verse number="30" style="v" sid="LUK 2:30"/>ፋይናካ እልኦ ኦተይ ዴራ፤ <verse eid="LUK 2:30"/><verse number="31" style="v" sid="LUK 2:31"/>ኡሱና እባዶ ዱባ ሆረ አት ካኤካሰቶያ፤ <verse eid="LUK 2:31"/><verse number="32" style="v" sid="LUK 2:32"/>አይሁድ ካሌኖቱን ሩም ካቱሳሮያ፤ ጎሳ ካእስራኤልና ካባጃያ።” <verse eid="LUK 2:32"/><verse number="33" style="v" sid="LUK 2:33"/>ኣቦኬሳና ኣየቴሳና ኡሱ ማራን ካሰጋመሮ አየስ ማሜን። <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>ስሞናና እሶ ሶማሳተ፤ ኣየቴሳ ማይራምኔ ሃ አመ፤ “ሂክ ይትት እስራኤሊ ካሞጋኑን ባኖዉና ፋያኖዉን ኣላንቲ ጎጎሌሮ፥ ኡሱ ኦድዳራዉን ማላታ ጎጎሌሮ ሹማመራ፤ <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>ካሞጋንኮት ቆፋ ታዎዳና ጎጎቱስሮንያ፤ ጋዳ ሺፋ ኣን ኔፎታ ኤግናራ።”<verse eid="LUK 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>ኡሱማለና ኡና ታአሴርኮ ታሌተቴ ታፋኑኤል ኤረ፥ ሃና ታአማማተ ሄገሮት ኤሰ ግቴ፤ ኤሰና ኣሎ ጃሮንተ ግቴ፤ ዴለሉማነ ካኬሳንተተ ኤንተር ዎታ ጌስ ቶዶባ ታሀማጽተተታ። <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>ጌስክሰና ስዶታምኮ አፋር ታ ሌሮን ጋልታንቴ ሌተ አሪነ ሄመኔ ቁሉክ ምን ካኤብኮ ሀሄሶን አጋቡይና ኤቢ ዋዉን ሀንዳ ጋልታንቴ ሌተ አዳላተ። <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>ሀሱ ጎራታና ጋባላንተደ ዋ ጋላቲተ፤ ኢየሩሳለምኮክ ዎዶ ኦኦራታሬን ዱባን ዪትትኮክ አዬሰ። <verse eid="LUK 2:38"/><verse number="39" style="v" sid="LUK 2:39"/>ዮሴፋና ማይራመና ካጎታ ሴራይ አጃጃ ካስሳመሮ ዱባ ካኮጉድሳሬን ጎራታ፥ ጋሊላ አዉራጃይ ታግቶ ናዝረት ካታማ ቶስ አባባተን። <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>ይትትና ጂናታና አታታ ሴተ፤ ቃሩማ አማጋመ፤ ስኖ ታዋ ኡሱ ጉት ግቴ።<verse eid="LUK 2:40"/></para>
  <para style="s1">ይትት የሱሳ ቁሉክ ምን ካኤብ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>የሱሳ ኦኡሙለራና ጌስ ጌስ ፋስካ ባላዉን ኢየሩሳለም ቶስ ብያነን። <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>ኡኑና ጌስ ቶሞንኮ ላማ ካኮላረ ጎራታ፥ ጎጎካሳኒ ባላ ካባጅን ቤን። <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>ባላ ጉድሴን አባባተረነ፥ ምንክሶ አባባታ ግራን፥ ይትት የሱሳ ኢየሩሳለም ሄሰ፤ ኦኡሙለራና ሄሳኖኬሳ አደን ላኮአዴሰረን። <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>እሶነ ዎታ ካግሮ ኣን ሌረ፥ አሪ ቶክ ራ ሰሴተን አባባተረን አደን ፋልክሶኮና እሶ ኦጌላታሬን ዶለኮና ዶታኖ ሀጋአበን፤ <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>ዶተን ካኮዋታሬን ጎራታ ዶታና ኢየሩሳለም ቶስ አባባተን ሴተን። <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>አሪ ሴድኮና አባባተረነ ኦአጋልስሳረን ጠኤ ሀማጼረ እሶ ማላና ሆስን ሆሳታ ግራን ቁሉክ ምን ካኤብ ኦሮ ኡሱ ሄሌን፤ <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>ኦማሌራን ዱባ ሻዳኖኬሳይና አባብኬሳይ ሳዳ ግረን። <verse eid="LUK 2:47"/><verse number="48" style="v" sid="LUK 2:48"/>ኦኡሙለራና ካኮደያረን ጎራታ ማሜን፤ ኣየቴሳና፥ “ኡኑኬ፤ መዉን ኖ ሃ የልተ? ኣቦካና አንና ያንዴ ኖ ኩ ዶታ ግኔ” ሃ አንተ። <verse eid="LUK 2:48"/><verse number="49" style="v" sid="LUK 2:49"/>“ኡሱና እን ሙን ዶታቴን?” “ኣቦኬክ ምኒ ግርን ካዶትሳሮ ላኖ ላኮካሳንያ?” አመ። <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>እሶና ኡሱ ካአዬሰረ አየስ ላኮሻደረን። <verse eid="LUK 2:50"/><verse number="51" style="v" sid="LUK 2:51"/>ኤሰኮና ራቶ ናዝረት ቶስ ዳጌን፤ እሶና አጃጃማ ግረ። ኣየቴሳና ሂካ አየስ ዱባ ዎዳናትሴይ አባተ ግቴ። <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>የሱሳና ቃሩማና ጅፉ ጂናታ ግረ፤ ዋይና እባዶ ሆረ ኡሱ ጋሻና አባናየ።<verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">ካጣማቃሮ ያንሳኮክ ሀንዳኖ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3፡1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1፡1-8</ref>፤ <ref loc="JHN 1:19-28">ያን. 1፡19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>ካሮም ዎኖ ጥባርዮሳ ካኮሬደረ ጌስ ካቶሞንኮ ከን፥ ካጰንጢዮሳ ጲላጦሳ ካይሁዳ ሞት ሄሮዶሳ ካጌልላ ሞት ሌ ታኮግረ፥ ኡሱማሌ አቢኬሳ ፍልጶሳ ካኢጡርያስና ካጢራኮንዶስ ሞቲ፥ ልሳንዮስና ካአብላንሳ ሞቲ ሌ ግራን፥ <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>ሃናና ቀያፋ ቱቃሞኮክ ዎይቻ ሌን ግራንቲ፥ ኤረ ካዛክራሳ ያንሳን ዋ ቃሉላቶክ ኡሊ አዬሰ። <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>ኡሱና ጩቦክስን ሀሄሶ ጎጎአማምሮን ጩቦኮ ካኮጉላ ጋላን ጥንቃታ ጣማቃ ዮርዳኖሲ ላጋ ማማኒ ካግሮ ጎሳ ዱባን ኤመተ። <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>ህክና ካሄገሮ እስያሳኮክ ማጻፋይ ሃ አመ ካጻፋመሮ ማሌየ፤ “ጋድ ሃ አማ ካኢያሮ እባዶትኮት ያየ፤ ‘ካጎታ ራ ኤካሳ ሰሴታንና ቱኩል የላ፤ <verse eid="LUK 3:4"/><verse number="5" style="v" sid="LUK 3:5"/>ላጋ ዱባ አማጋምናራ፤ ዎዳምና ጋጋጆል ዱባ ሁስ አምናራ፤ ካዎጫጫመራ ራ ቱኩል ኡምናራ፥ ካርሻሽ ካአመራ ሙጭ አምናራ፤ <verse eid="LUK 3:5"/><verse number="6" style="v" sid="LUK 3:6"/>ሳኒ ታእባዶ ዱባ ፋይና ካዋ ድናታ።’ ”<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>ያንሳና ገነቴሳይ ጣማቃምን ካቤሮ እባዶነ ሃ አማ ግረ፤ “እስን ይስ ካሀበሳ ታኤማቶ ኤንገ ታዋኮ ጎጎባቃታኑን አዮያ እስኑን ራ ካቱሰ? <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>ጎርታ ጩቦኮ ጉላ ጋላ፥ ጩቦኮ ጉላ ጋላኖክስን ኦቱሳራን ፈሎ ፈላ፤ አደና ዎዳናትስኒ ‘አብራመ ኣቦካን ግሮዋ’ አማኖና አሮሀጋአብተን፤ ዋ ሂካ ኤኤሞልኮ አብራመን ሳኒ ኬስን ካዳንደሮ ላኖ አን እስኑን ሰጋራ። <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>ግዳ ማሳር ጋ ሄገልኮ ጎስ ሉጉድን ኤካተታ፤ ታኢዳንት ኢል ካዱባሞን ጋ ዱባ ጎሳምረ ኤለኒ ሻፋምናራ።” <verse eid="LUK 3:9"/><verse number="10" style="v" sid="LUK 3:10"/>ጎሳና፥ “ሀያ ኖ መ የልና?” አመን ያንሳ ሆሳተን። <verse eid="LUK 3:10"/><verse number="11" style="v" sid="LUK 3:11"/>ያንሳና “ሳርስ ላማ ካአባ ኮና ካልክን ሀስሶ፤ ባቦ ካአባና ኡሱማሌ ሀየለ” አመ እሶን አባበ። <verse eid="LUK 3:11"/><verse number="12" style="v" sid="LUK 3:12"/>ቃራጣ ኦኩኩይሳሬና ጣማቃምን ኡሱ ቶስ ኤሜተረን፥ “ካአጋልስሳቶ! ኖ አድ መ የልና?” አመን።<verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>“ኡሱና ካአጃጃንቴታንኮ ሮርስ ቃራጣ አሮኩኩይሴን” አመ። <verse eid="LUK 3:13"/><verse number="14" style="v" sid="LUK 3:14"/>ዎታዳራልና “ኖ አድ መ የልና?” አመን ሆሳተን፤ ኡሱና፥ “ማካዮክ ማራጋደና ሁና አሮሳንቴን፤ እባዶና ጣራይ አሮሞትቴን፤ ዳሞዛክስን እስኑን ሀሌዎ አመ።” <verse eid="LUK 3:14"/><verse number="15" style="v" sid="LUK 3:15"/>ሀሱ ጎራታ ጎሳ ክርስቶሳ አብዲ ኦራታ ግረ፤ ሃንሱን ያንሳ “ሂክ እባዶት ክርስቶሳ ሌዉና?” አማ ዱባ ዎዳናትሶይ ቆፓ ግረን። <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>ያንሳ ዱባዉን ሃ አመ አባበ፤ “አን እስን በከይ ጣማቃራ፤ አየሱን ጎአመን እንኮ ካአቲ ኤመይናራ፤ አንና ከፈሮኦቴሳኮክ ሻኖ ፉርን ካዳንደሮ ላኮዮ፤ ኡሱ አያና ቁሉክና ኤለኒ እስን ጣማቅናራ፤ <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>አዱማል ባስን ዳርጋማ ጎታራይ ኦሮ ክቢን ታኮሀርቂሳራን ዱጉድ ገነቴሳ ግታ፤ ጋላባ አደ ታባኖን ኤለኒ ጉብናራ።” <verse eid="LUK 3:17"/><verse number="18" style="v" sid="LUK 3:18"/>ኡሱማለና ያንሳ ራ ካሞጋነ ጎሳ ጎርሳ ኦዱ ታኢዳን ሰገ። <verse eid="LUK 3:18"/><verse number="19" style="v" sid="LUK 3:19"/>አየሱን ጎአመን ያንሳ፥ ካይሁዳ ሞት ካሌረ ሄሮዶሳ አደ አቢኬሳት ታፍልጶሳ ኦር ሄሮድያዳ አታታኖና ካካለ ካሜላን ካሞጋን አየስ ፈላኖይ ኡሱ ሀድሰ። <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>ሄሮዶሳ ሂካ ዱባ ጉት አደረ፥ ያንሳ ምን ካሻኖ ታብሰ።<verse eid="LUK 3:20"/></para>
  <para style="s1">የሱሳኮክ ጣማቃማኖ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶ. 3፡13-17</ref>፤ <ref loc="MRK 1:9-11">ማር. 1፡9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>ጎሳ ዱባ ካኮጣማቃማረ ጎራታ የሱሳና ጣማቃመ፤ ኤባታ ግራንቲና ዳሩር ባናንተደ፥ <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>አያና ቁሉክና አራበ ኣን ኡሱ ጉት ዳገ፤ ዳሩርኮና፥ “አን ካጌላታራ ኤረክ አትታ፤ ኩዬ ገጌላታራ” ታአማታ ያየ ኤመተ። <verse eid="LUK 3:22"/><verse number="23" style="v" sid="LUK 3:23"/>የሱሳ ሀንዳኖ ጎሀጋአባረ ጌስ ሶንዶምየ፤ ጎሳን የሱሳ ኤረ ካዮሴፋ ኣን ሌረ፤ ኡሱ ዮሴፋና ካኤል ኤረ፥ <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>ካማት ኤረ፥ ካለው ኤረ፥ ካምልክ ኤረ፥ ካዮና ኤረ፥ ካዮሰፍ ኤረ፥ <verse eid="LUK 3:24"/><verse number="25" style="v" sid="LUK 3:25"/>ካማታትዩ ኤረ፥ ካአሞጽ ኤረ፥ ካናሆም ኤረ፥ ካኤስልም ኤረ፥ ካናገ ኤረ፥ <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>ካማአት ኤረ፥ ካማታትዩ ኤረ፥ ካሰመይ ኤረ፥ ካዮሴፋ ኤረ፥ ካዮዳ ኤረ፥ <verse eid="LUK 3:26"/><verse number="27" style="v" sid="LUK 3:27"/>ካዮናን ኤረ፥ ካሬስ ኤረ፥ ካዘሩባበል ኤረ፥ ካሴላትያል ኤረ፥ ካነር ኤረ፥ <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>ካምልክ ኤረ፥ ካሃድ ኤረ፥ ካዮሳስ ኤረ፥ ካቆሳም ኤረ፥ ካኤልሞዳም ኤረ፥ ካኤር ኤረ፥ <verse eid="LUK 3:28"/><verse number="29" style="v" sid="LUK 3:29"/>ካዮሰኢ ኤረ፥ ካኤልአዘር ኤረ፥ ካዮራም ኤረ፥ ካማጣት ኤረ፥ ካለው ኤረ፥ <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>ካስሞን ኤረ፥ ካይሁዳ ኤረ፥ ካዮሰፍ ኤረ፥ ካዮናም ኤረ፥ ካኤልያቀም ኤረ፥ <verse eid="LUK 3:30"/><verse number="31" style="v" sid="LUK 3:31"/>ካሜልያ ኤረ፥ ካማይናን ኤረ፥ ካማጣት ኤረ፥ ካናታን ኤረ፥ ካዳዉተ ኤረ፥ <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>ካኢሰይ ኤረ፥ ካኢዮበድ ኤረ፥ ካቦኤዝ ኤረ፥ ካሰልሞን ኤረ፥ ካነአሶን ኤረ፥ <verse eid="LUK 3:32"/><verse number="33" style="v" sid="LUK 3:33"/>ካአምናዳብ ኤረ ካአራም ኤረ፥ ካአሮን ኤረ፥ ካኤሰሮም ኤረ፥ ካፋሬስ ኤረ፥ ካይሁዳ ኤረ፥ <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>ካያይቆባ ኤረ፥ ካይሳቃ ኤረ፥ ካአብራሀመ ኤረ፥ ካታራ ኤረ፥ ካናኮር ኤረ፥ <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>ካሰሮግ ኤረ፥ ካራጋዉ ኤረ፥ ካፋልቅ ኤረ፥ ካአበር ኤረ፥ ካሳላ ኤረ፥ <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>ካቃይንም ኤረ፥ ካአርፋክስድ ኤረ፥ ካሰም ኤረ፥ ካኖሄ ኤረ፥ ካላመህ ኤረ፥ <verse eid="LUK 3:36"/><verse number="37" style="v" sid="LUK 3:37"/>ካማቶሳላ ኤረ፥ ካሄኖክ ኤረ፥ ካያረድ ኤረ፥ ካመላልኤል ኤረ፥ ካቃይናን ኤረ፥ <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>ካሄኖክ ኤረ፥ ካሰት ኤረ፥ ካአዳመ ኤረ፥ ካዋ ኤረ።<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">ጫፋማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MAT 4:1-11">ማቶ. 4፡1-11</ref>፤ <ref loc="MRK 1:12-13">ማር. 1፡12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>የሱሳ አያና ቁሉክ አማጋመረ ካዮርዳኖስ ላጋኮ ጎጎአባባቴ አያና ቁሉክ ጋ ቶስ ኡሱ ቃጄልሰ፤ <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>ኤሰኮና አሪ አፋርታም ዱርሳ ጫፋመ፤ ሂናኣ አርጆል ኦሮ ኮና ሀኣሞን አዳላተረ ታጋቾ አሪ ኡኤ።<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>ዱርሳና አላ “ኤረ ካዋ ጎሌተ ሂካ ኤኤሞ ባቦ ጎጎሌሮ አጃጂ” አመ።<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>የሱሳና፥ “እባዶ ባቦ ካላሊ ላኮግራሮ፤ አማመ ጻፋመራ” አመ ኡሱን አባበ።<verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>ኤሰኮና ዱርሳ ቶ ጦቂ ታአንተ ዎዳሚ የሱሳ ኮርሰጉረ ካአላም ዎኖላል ዱባና ኮይክ ቱሰ፤ <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>ኤሰኮ አባባተረ “ሂካ ዎኖላልኮክ ኦዶናትና ካባጃ ዱባ እዬን ስሳንተታ፤ አንና ካጌላታሮን ማንኮስስናሮ ማራን ኩዬን ስስናራ፤ <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>ሃንሱን አት እዬን ጎሳጋደ ሂክ ዱባ ካካ ሌሮዋ” አመ።<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>የሱሳና አባበረ፥ “ጎታ ሄዶ ካዉን ሳጋድ! ኡሱ ካላል ሄዶይሳ” አማመ ማጻፋ ቁሉክ ጻፋመራ አመ።<verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>ኤሰኮና ዱርሳ የሱሳ ኢየሩሳለም ቶስ ገሰረ ቁሉክ ምን ካዋ ጉት ብርጠ ኣልሰረ፥ አላ ኤረ ካዋ ጎሌተ እሲ ሄገልዴ ፍር አም እ አመ። <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>ኣላንቲና ሃ አማመ ማጻፋ ቁሉክ ጻፋመራ፤ ኩ ጎጎኦራዉን አደ፥ “ ‘ዋ ኤርግቻል ኩ ማራንቱን አጃጃራ፤ <verse eid="LUK 4:10"/><verse number="11" style="v" sid="LUK 4:11"/>ሉቃኦታና ኤኤሞይ ጎጎሀንዱዱፋኖንኮ ገነትሶይ ኩ አብ ኬስራንዋ’ ” አመ።<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>የሱሳና አባበረ፥ “ጎታ ሄዶካ አሮጫፍተ አማመ ማጻፋ ቁሉክ ጻፋመራ” አመ።<verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>ዱርሳ የሱሳ ጫፌ ጉድሰ አባባተረ ካካለ ካኤካሮ ጎራታ ታሄላሮ ኡሱኮ ካለቤ።<verse eid="LUK 4:13"/></para>
  <para style="s1">የሱሳ አጋልስሳኖኮኒዕ ፈሎ ጋሊላይ ሀጋአባኖ</para>
  <para style="r">(<ref loc="MAT 4:12-17">ማቶ. 4፡12-17</ref>፤ <ref loc="MRK 1:14-15">ማር. 1፡14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>የሱሳና አያና ቁሉክኮክ ሁናይ ጋሊላ ቶስ አባባተ፤ አታንኬሳና ጎቦቢ ካግሮ ኡል ዱባ ማልሳመ። <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>ኡሱና አይሁድኮክ ምን ካኤብ አጋልስሳ ግረ፤ እባዶ ዱባና ኡሱ ጋላታ ግረ።<verse eid="LUK 4:15"/></para>
  <para style="s1">ኡል ካናዝረትክ እባዶ የሱሳ ኔባታኖ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶ. 13፡53-58</ref>፤ <ref loc="MRK 6:1-6">ማር. 6፡1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>ኤሰኮና ታኮጅናተሮ ካታማ ናዝረት ቶስ ኤመተ፤ ዎጋክሶክ ማለ አይሁድን ታፎልሲ አሪ ምን ካኤብካክሶ ቶስ ታበ፤ ቁሉክ ማጻፋ ናባብን ኬ አሌ። <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>ካሄገሮ እስያሳኮክ ካዱባመሮ ማጻፋ ኡሱን ስሰን፤ ካዱባመሮ ማጻፋና ካኮፉፉሮ ጎራታ ሃ አማምተ ታጻፋንተቶ ባንኤ ሄለ፤<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>“ካጎታ አያና እዬ ጉት ግራ</para>
  <para style="q2" vid="LUK 4:18">ህየሳሉን ዎንጋላ ጎጎላላብሮን፥</para>
  <para style="q2" vid="LUK 4:18">ኡሱ እን ሽግደራ ኦሻሜራዉን ፉራማኖ፥ ኢልኦ ኦደያኖቱን ደያኖ ጎጎአዋጅሮን፥ ኦያዳራኑን ባልቹማ ጎጎቤስሮን፥<verse eid="LUK 4:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19"/>ኡሱማለና ጎታ ጎሳ ካኮሃስሮ</para>
  <para style="q2" vid="LUK 4:19">ካስኖ ጌስ ጎጎአዴስስሮ እን ፋረራ።”<verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>ኤሰኮና ማጻፋ ዱበረ ካአይሁድ ምን ካኤብኮክ ዎይቻትን አባበ ስሰጉረ ሀማጼ፤ አይሁድኮክ ምን ካኤብ ካግረ እባዶ ዱባና ትችሰ ዲያ ግረ። <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>ኡሱና፥ “ሂክ ነበታትስኒ ካማላታን ካማጻፋ ሃፉራ ህታር ጉዳተ” አማኖ ሀጋአበ። <verse eid="LUK 4:21"/><verse number="22" style="v" sid="LUK 4:22"/>ዱባና ጋራኬሳ ታኢዳነት አዬሳ ግረን፤ አደና ህኢተሳኮ ካብያሮ ካእዳን አዬሲ ማማ፥ “ሂክ ላ ኤረ ካዮሴፋዮላ?” አማ ግረን። <verse eid="LUK 4:22"/><verse number="23" style="v" sid="LUK 4:23"/>የሱሳና፥ “ኦዶ ዶበ፤ አላ አት እስኦታ ፋይሳ፤ ኡል ካቅፍረናሆም ካፈላተ ኖ ካማልነኖ አየስ ህታ ካታማታይና አድ ፈል ታአማቶ ማሱሳ እስን ኢን ፈር ካማላታታን ሄዳታኖ ላኮአቦ” አመ።<verse eid="LUK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24"/>አደና ኡሱ ሃ አመ፤ “አን ሩምና እስኑን ሃ አማራ፤” ካሄገሮ ኡልኬሳይ ላኮካባጃማሮ። <verse eid="LUK 4:24"/><verse number="25" style="v" sid="LUK 4:25"/>“አየሱን ጎአመን አን ሩምና እስኑን ሃ አማራ፤” ዳሩር ጌስ ሴንዳ ምናና ኢዳሞ ዋታመረ ካእስራኤል ኡል ዱባ ጉት ካአቲ ኡኢ ካኮግረ ካኤላሳ ጌሲ፥ ካሞጋን ጋልታንተጆል ኡል ካእስራኤሊ ግረ። <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>ኤላሳ ሂናኣ ጋልታንተጃ ኦሮኮ ቶ ቶንሳ ላኮፋራመረ፤ አየሱን ጎአመን ካስዶና ኡሊ ሰራጲታ ካአማማሮ ማማኒ ታግቴ ጋልታንቴ ቶስ ፋራመ። <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>ኡሱማሌ ካሄገሮ ካኤልሳይ ጌሲና እስራኤሊ ካሞጋን ማሪ ባር ካአባናየ እባዶ ግረ፤ አየሱን ጎአመን ካሶርያ ንኢማን ኳሬ ሂናኣ ኦሮኮ ኮና ላኮፋዬረ።<verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>አይሁድኮክ ምን ካኤብ ካግረ እባዶ ዱባ ሂካ ካኮማላረን ጎራታ አማራተ። <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>ታኮሀማጼረንኮና ኬንጉረን የሱሳ ካታማኮ ሳሪ ቤሰን፤ ካታማትሶይ ሄገልዴድስ ጉምቢ ሉጉድን ታፈላንተቶ ዎዳም ቃርቃራ ጌሰን፤ <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>ኡሱ ጎአመን እሶ ኦሮ ማረ ሴተ።<verse eid="LUK 4:30"/></para>
  <para style="s1">የሱሳ ባቲክ አያና ቤሰ</para>
  <para style="r">(<ref loc="MRK 1:21-28">ማር. 1፡21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>ኤሰኮና የሱሳ ታጋሊላ አዉራጃይ ታግቶ ካታማ ቶስ ቅፍረናሆም ዳገ፤ ኤሴና አይሁድን ታፎልሲ አሪ ጎሳ አጋልስሳኖ ሀጋአበ። <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>ኦዶናት ሃፉራ አዬሳ ማንኮግረ ማራን ዱባና አጋልስሳኖኬሳ ሳደ።<verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>አይሁድኮክ ምን ካኤብና ባቲክ አያና ካአባመረ እባዶት ኮ ካግረ፤ ኡሱና ጦቂ ታአንተ ያዬ እዬረ፥ <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>“ዎ! ካናዝረት የሱሳ፤ መ ታኤሰልሳቶ ሃጃ ኖኔ አብታ? ካኮንኤመተታ ኖ ባስንያ? አት አዮቶ አን ካሶዋ፤ አት ካዋ ቁሉክታ!” አመ።<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>የሱሳና፥ “ጫልኢ አምደ ሂካ እባዶትኮ ቤ!” አመ ሀድሰ፤ ባቲክ አያናና እባዶት ጎሳ ዱባ ሆረ ሉጉደጉረ ኮና ሚራኣ አንጌግሶን ጋፋረ ቤ።<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>እባዶ ዱባና ማመ፤ እስ እስኦሮና፥ “ሂክ ምስክ አጃጃያ? ኦዶናትና ሁናይ ባቲክ አያናልና ጎአጃጅሮ እሶና ብያራን” አመን። <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>የሱሳኮክ አታን ኡሱ ኡልኮክ ጎቦቢ ዱባ ማልሳመ።<verse eid="LUK 4:37"/></para>
  <para style="s1">የሱሳ ካሞጋን ካሀዉአማሮ እባዶ ፋይሰ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8፡14-17</ref>፤ <ref loc="MRK 1:29-34">ማር. 1፡29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>ኤሰኮ አባባተረ የሱሳ አይሁድኮክ ምን ካኤብኮ ቤጉረ ምን ካስሞና ቶስ ታበ። ታስሞና ሶዶ ማር ጉበ ጎሜላን ሀዉኣማ ግቴ፤ ኤሰ ጎጎፋይስሮ የሱሳ ኤባተን። <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>የሱሳና ኤሰ ቶስ ሁስ አመረ ማር ካጉባረ ሀድሰ፤ ማር ካጉባረና ጋፋረ ጎርሰዋ ኬተደ ማርቲሰ።<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>አርት እያ ግራን፥ ካለካለክ ሀዉኣም ካአባናየ እባዶ ዱባ የሱሳ ቶስ ከነን። ኡሱና እሶ መተ መተ ገነቴሳ ጉት ካየረ ፋይሰ። <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>ዱርሳና አደ፥ “አት ኤረ ካዋታ!” አማና እያ ካሞጋን እባዶኮ ቤ። ኡሱ ጎአመን እሶ ሀድሰ፤ ኡሱ ክርስቶሳ ላኖ አዴሰን ማንኮግሬን ማራን ጋራኬሳ ኮና እሶ ጎጎአዬሶንኮ ትረ።<verse eid="LUK 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>ኡል ካኮባራረ ጎራታ የሱሳ ቶ ካለት ባንኤ ሴተ። ጎሳና ኡሱ ዶታ ግረ፤ ኡሱ ታኮግሮ ባንኤ ኤመተን፤ እሶኮና ካለቢረ ጎጎሴኖንኮ ትርን ሄደን። <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>ኡሱ ጎአመን፥ “ካካለ ካታማል አን ሴይጉረ ዎኖናት ካዋኮክ ዎንጋላ ላላብን ዶትሳራ፤ አን ካኮንፋራመራና ሂካ ሀልቻንያ” አመ። <verse eid="LUK 4:43"/><verse number="44" style="v" sid="LUK 4:44"/>ካይሁዳ ማማኒ ካግሮ ምን ካኤብ ዱባ ላላባኖ ሆረዴ።<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">ኡሱኮ ኦአጋልሳታራንኮክ ኡማማኖ</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ. 4፡18-22</ref>፤ <ref loc="MRK 1:16-20">ማር. 1፡16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>ጎሳ የሱሳ ማረአበረ እስእስ ሻሻፋታ ኡሱ ካአጋልስሳረ ሃፉራ ካዋ ማላ፥ ታገንሳረጢ ላቡ ግሪ አሌ ግረ። <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>ኡሱ ጎራታ ዎላቦ ላማ ባጋ ግሪ ታአልተቶ ዴ፤ ኩኑኡብ ኦአባታሬን አደን ዎላቦልኮና ዳጌረን ማራብል አልሳታ ግረን። <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>ዎላቦል ኦሮኮ ታስሞና ታሌተቶ ቶስ ታበረ፥ ባጋኮ ባድ ቶስ አባራንቲ ጎጎፋክስሮ ሆሳተ፤ ኤሰኮና ኡሱ ዎላቦ ጉት ሀማጼረ ጎሳና አጋልስሳኖ ሀጋአበ። <verse eid="LUK 5:3"/><verse number="4" style="v" sid="LUK 5:4"/>አየስ ጉድሰ አባባተረ ስሞናነ፥ “ባድ ቶስ ፋክ አምደ ኩኑኡብ አባይን ማራብጆልክስን ሉጉዳዬነ” አመ። <verse eid="LUK 5:4"/><verse number="5" style="v" sid="LUK 5:5"/>ስሞናና የሱሳነ አባበረ፥ “ካአጋልስሳቶ! ሄመን ዱዶ ዳፉራ ባርነኔ ኮና ላኮአባነኖ፤ አት ጎአንተ ሃፉራካይ አድ ማራብጆልና ሉጉዳሮዋ” አመ። <verse eid="LUK 5:5"/><verse number="6" style="v" sid="LUK 5:6"/>ካኮሉጉዳታሬን ጎራታ ኣሎ ካጂንጂ ካሞጋን ኩኑኡብ አበን፥ ማራብጆልና ፊላሚን ሌተ። <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>ዎላቦ ታካለቲ ታግቴ ኡና ታትሶ ኤሜይደ እሶ ጎጎጋርጋርቶ ማላታይ ኡሜን፤ እሶና ኤሜተረን ዎላቦ ላማ ኩኑኡብ አማጌን፤ ዎላቦና ልችሚን ሌተ። <verse eid="LUK 5:7"/><verse number="8" style="v" sid="LUK 5:8"/>ስሞና ጴጢሮሳና ሂካ ካኮድያረ ጎራታ የሱሳ ሆረ ግልቢሰረ፥ “ጎታ፤ አን ጩባለሳክ እባዶትያ እንኮ ካለቤ” አመ። <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>ሂካና ካኮንአመራ ኡሱና ኡሱነ ዎታ ኦግረን ዱባ ካአቤራን ኩኑኡብኮክ ሞጋኒ ማንኮሳደረን ማራንየ። <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>ኡሱማለና ሳትላል ታስሞና ካሌረ ይስ ካዛብዶሳ፥ ያይቆባና ያንሳና ሳደን። የሱሳና ስሞናነ፥ “አሮአብሳተ! ጎርታ እባዶ እን ቶስ ካኬንቶ ለታ” አመ። <verse eid="LUK 5:10"/><verse number="11" style="v" sid="LUK 5:11"/>እሶና ዎላቦልክሶ ባጋ ቤሰረን ካአመን ዱባና ኢሰረነ ኡሱ ዴበ ሰሴተን።<verse eid="LUK 5:11"/></para>
  <para style="s1">የሱሳ ማሪ ባር ካአባናየ እባዶት ፋይሰ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ. 8፡1-4</ref>፤ <ref loc="MRK 1:40-45">ማር. 1፡40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>የሱሳ ካታማልኮ ቶይ ካኮግሬ፥ ኮ ማሪ ባር ካኮንአማጋንትተቴ እባዶት ኤሰ ካታማይ ግረ፤ ሂክ እባዶት የሱሳ ካኮደያረ ጎራታ በቤድቴሳ ኡል ኦዬጉረ፥ “ጎታ፥ ፈኢታ ጎሌተ እን ሙጭስን ዳንዳታ” አመ ኤባተ። <verse eid="LUK 5:12"/><verse number="13" style="v" sid="LUK 5:13"/>የሱሳና ገነ ድሪርሳተጉረ ማር ካእባዶት አአበጉረ “አን ፈኢ ስሰራ” “ሙጭአም!” አመ። ጎርሰዋ ባር እባዶትኮ ሙጭአንተ። <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/>የሱሳ አደ፥ “ሂካ ማዮና አሮሰግተ፤ አየሱን ጎአመን ሴዴ እስኦታ ቱቃሞን ቱሳ፤ ጎሳን አቶ ጎጎሌሮና ሙጭማኖካ ማራን ሙሴ ጎጎአጃጄሮክ ማለ ጃርሶ ስስ” አመ አጃጄ። <verse eid="LUK 5:14"/><verse number="15" style="v" sid="LUK 5:15"/>ሀሌዎ ኳሬ ጋራኬሳ ታአዬሳማተ ኦዱ ኣሎ ባልአታ ሴተ፤ ኣሎ ካሞጋን እባዶና ኡሱ ካአዬሳሮ ማልና ካአባን ማሮሮክ ሀዉኣምኮ ፋይን ኩኩአማ ግረ። <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>የሱሳ ጎአመን ካሞጋን ጎራታ ካለት ባንኤ ኤባታ ግረ።<verse eid="LUK 5:16"/></para>
  <para style="s1">የሱሳ ናፋለሳክ እባዶት ፋይሰ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ. 9፡1-8</ref>፤ <ref loc="MRK 2:1-12">ማር. 2፡1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>አሪ ቶይ የሱሳ ጎሳ አጋልስሳ ግረ፤ ኤሰና ጋሊላኮና ካይሁዳ ማማን ዱባኮ ኡሱማለና ኢየሩሳለምኮ ካኤመተራ እባዶ ካፋራሳውና ሴራ ካሙሴ ካአጋልስሳራ ሀማጼ ግረ፤ ፋይስና አደ ሁና ካጎታ ኡሱ ዎታ ግረ። <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>ሀሱ ጎራታና እባዶ ናፋለሳት ኮ አልጋይ ስዴን ኣተን ኤመተን። የሱሳ ሆረ ካይን ምን ኦሮ ታብስን ሄደን። <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>ጎሳ ሞጋንኮና ካከይ ምን ኦሮ ታብስን ማንኮዋተን ማራን ሄልንቾ ጉት ኮራቴኔ ሄልንቾ ቡቶ ቤሰረን ካሀዉአማሮ አልጋነ ዎታ ጎሳ ጠኤ ቱኩሊ የሱሳ ሆረ ዳግሰን። <verse eid="LUK 5:19"/><verse number="20" style="v" sid="LUK 5:20"/>የሱሳ አማኖክሶ ዴጉረ፥ “አት እባዶት ጩቦካ ሀሄሶ አማመራ” አመ። <verse eid="LUK 5:20"/><verse number="21" style="v" sid="LUK 5:21"/>ሴራ ኦአጋልስሳራና ካፋራሳው እባዶ፥ ሂክ “ዋ ካኢንጋማራ አዮያ? ዋ ኮ ኳሬ ጩቦ ሀሄሶ አምን ካዳንዳራ አዮያ?” አመን ቆፋ ገጌሳታኖ ሀጋአበን። <verse eid="LUK 5:21"/><verse number="22" style="v" sid="LUK 5:22"/>የሱሳና ቆፋትሶ ማንኮአዴሰረ ማራን ሃ አመ፤ “ሙን ዎዳናትስኒ ሃ ቆፓታን? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>‘ጩቦካ ሀሄሶ አማመራ’ አማኖኮና ‘ክጉዴ ጋል’ አማኖኮ ኤክያ ኤነክ? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>አየሱን ጎአመን ሂካ ኡሱ ካኮንአመራ ኤረ ካእባዶ ኡል ጉት ጩቦና ሀሄሶ አምን ኦዶናት ካአቦ ላኖ ጎጎማላብታኑንያ።” ናፋለሳ ሌ ካግረ እባዶትነ፥ ክጉዴ አልጋታ ስዳዴ ምንካካ ጋል አመ። <verse eid="LUK 5:24"/><verse number="25" style="v" sid="LUK 5:25"/>ኡሱና ጎርሰዋ ኬጉረ እሶ ሆረ አሌ፤ ሁዱረ ታኮግረ አልጋ ስዳተጉረ ዋ ጋላታ ምንኬሳ ጋለ። <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>ኤሰ ካግረ እባዶ ዱባና ማማኖ ሀጋአበ፤ ዋና ጋላታ፥ “ህታር ካሳድስሮ አየስ ዴነ” አማ አብሲ አማጋመ።<verse eid="LUK 5:26"/></para>
  <para style="s1">ኡማማኖ ካዎዩቲ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ. 9፡9-13</ref>፤ <ref loc="MRK 2:13-17">ማር. 2፡13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>ኤሰኮ አባባተረ የሱሳ ኤሰኮ ቤ ሴተ፤ ዎዩ ካአማመረ ኮ ቃራጣ ካኩኩይሳረ ቃራጣ ታኮአታና ባንኤ ካሀማጼሮ ዴጉረ፥ “እንደቤ ሰሴ” አመ። <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>ኡሱና ካመን ዱባና ኢሰ ኬጉረ ኡሱ ዴበ ሰሴተ። <verse eid="LUK 5:28"/><verse number="29" style="v" sid="LUK 5:29"/>ዎዩትና የሱሳን ምንኬሳይ ኣሞ ካአቲ ኤካሳተ፤ ካሞጋን ቃራጣ ካኩኩሳረና ካካለ እባዶ እሶ ዎታ አሞን ሀማጼ ግረ። <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>ካፋራሳው እባዶና ሴራ ካአጋልስሳረ እባዶ የሱሳነ፥ “ቃራጣ ኦኩኩይሳራነና ጩባልዬልነ ዎታ ካኮንአማታና ካኮንጣማታን መዉንያ?” አማ የሱሳኮ ኦአጋልሳታራን ጉት ጉምጉመን። <verse eid="LUK 5:30"/><verse number="31" style="v" sid="LUK 5:31"/>የሱሳና አባበረ እሶነ፥ “ኦሀዉአማራኑን ኳሬ ፋያለሳሉን አኪም ላኮዶትሳሮ፤ <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>አንና ጩባልዬል ጩቦኮ ጉላ ጋልስን ኳሬ ቁሎለ ኡምን ላኮኤሜየሮ” አመ።<verse eid="LUK 5:32"/></para>
  <para style="s1">የሱሳ ጋራ ካአጋቡ ሆሳመ</para>
  <para style="r">(<ref loc="MAT 9:14-18">ማቶ. 9፡14-18</ref>፤ <ref loc="MRK 2:18-24">ማር. 2፡18-24</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>እሶና፥ “ያንሳኮ ኦአጋልሳታረን ካሞጋን ጎራታ አጋቡዬን፥ ኤባታራን፤ እባዶ ካፋራሳውኮ ኦአጋልሳታረና ኡሱማሌ የላታራን፤ ኦታ ጎአመን አርጌቶ አማናን ጣማናን” አመን። <verse eid="LUK 5:33"/><verse number="34" style="v" sid="LUK 5:34"/>የሱሳና፥ አባበረ እሶነ፤ “ካማሻሸ እሶነ ዎታ ግራን ኦኡማሜራን ጎጎአጋቡይራዉን የልን ላኮዳንዳማሮ። <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>አየሱን ጎአመን ካማሻሸ እሶኮ ታኮአታምራ አሪ ኤመይናታ፤ ሀሱ ጎራታ አጋቡይራዋ” አመ። <verse eid="LUK 5:35"/><verse number="36" style="v" sid="LUK 5:36"/>አደና ሃ አመ ማሱሴ ሰገ፤ “ካኡሱብክ ሳርስኮ ኤርበ ፊለረ ካዶአን ሳርሲ ጉት ኤርበ ካካታራ ማዮና ላኮግሮ ሃ ጎየለ ካኡሱብክ ሳርስ ፊላራ፤ ታኡሱብት ኤርበ ካዶአንክ ሳርስነ ዎታ እስ ላኮአታቶ። <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>ካኡሱብክ ካዎይኒ ጣሞና ካዶአንክ ድንቢቶ ሙላተ ካካታራ ማዮና ላኮግሮ፤ ጎሙላተ አድ ካኡሱብክ ካዎይኒ ጣሞኮክ ድንቢቶ ኤባራ፤ ካዎይኒ ጣሞና ኡባታራ፤ ድንቢቶና ላኦ ላኮአቦ። <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>ሃንሱን ካኡሱብክ ካዎይኒ ጣሞ ካኡሱብክ ድንቢቶ ክባማኖ ዶትሳራ፤ <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>ጎርታ፥ ካአዳላተ ካዎይኒ ጣሞ ካኮጣመ ጎራታ፥ ካኡሱብክ ካዶታታራ ማዮና ላግሮ፤ ኣላንቲና፥ ‘ካአዳላተ ካሮራንያ ማንኮአማናን ማራንያ።’ ”<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">ታፎልሲ አርኮክ ጎታ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ. 12፡1-8</ref>፤ <ref loc="MRK 2:23-28">ማር. 2፡23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>አይሁድን ታፎልሲ አሪ የሱሳ እራ ኦሮማረ ሮራ ግረ፤ ኡሱኮ ኦአጋልሳታረና ሻዉዬ ኤብሴን ኣተነ ገነ ሆንቆፌን አማ ግረን። <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>ካፋራሳው እባዶ ኦሮኮ ኮኮ ጎአመን፥ “አይሁድን ታፎልሲ አሪ ፈላሚን ኦዶትሶን ፈሎ ሙን ፈላታን?” አመን። <verse eid="LUK 6:2"/><verse number="3" style="v" sid="LUK 6:3"/>የሱሳና ሃ አመ እሶን አባበ፥ “ዳዉተ ካኮኡኤረ ጎራታ ዎታ ኦግሬነ ዎታ ካየለሮ ዱባ ላኮናባብተቴንያ? <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>ኡሱ ምን ካዋ ታበረ ዋዉን ካለክ ካሌሮ ቱቃሞል ካላሉን ፈኢ ካኮስሳንተቶ ባቦ አታተ አመ፤ ኡሱነ ዎታ ኦግሬኑና ስሰ።” <verse eid="LUK 6:4"/><verse number="5" style="v" sid="LUK 6:5"/>አደና፥ “ኤረ ካእባዶ ታፎልሲ አሪን ጎታያ” አመ።<verse eid="LUK 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>ታካለ አይሁድኮት ታፎልሲ አሪና የሱሳ ካአይሁድ ምን ካኤብ ታበረ አጋልስሳ ግረ፤ ኤሰና ገነ ታመርገ ካኮናፋተተ እባዶት ኮ ግረ። <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>ሴራ ኦአጋልስሳሬና ካፋራሳው እባዶ የሱሳ ሞትን ኣላንቲ ዶታ፥ ታፎልሲ አርትሶይ ኡሱ ጎፋይስናሮና ድን ኦራ ግረን። <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>የሱሳና ቆፋትሶ አዴሰጉረ ገነ ካኮናፋተተ እባዶትነ፥ “ክጉዴ ጠኤ አሊ” አመ፤ እባዶትና ኬ አሌ። <verse eid="LUK 6:8"/><verse number="9" style="v" sid="LUK 6:9"/>ኤሰኮ የሱሳ፥ “አላ አየስ ኮ አን እስን ሆሳሮ፤ ታፎልሲ አሪን ፈኢ ካኮንስሳንተታ ኢዳነ ፈሊንያ ሙ ሜላነ ፈሊንያ? ኔፎ ሃሳኖያ ሙ ባሳኖያ?” አመ። <verse eid="LUK 6:9"/><verse number="10" style="v" sid="LUK 6:10"/>የሱሳ አደ ኡሱ ማራሙረ ካግሮ እባዶ ዱባና ዴጉረ እባዶትነ፥ ገነታ ድሪርሳ አመ፤ እባዶትና ጎጎአማመሮ የለ፤ ገነና ሱረ ፋይተ። <verse eid="LUK 6:10"/><verse number="11" style="v" sid="LUK 6:11"/>እባዶ ጎአመን ኣሎ አማራተ፤ የሱሳ ጉት መ የልን ዶትሳሮ እስ እስኦሮ ራቶ አዬሴን።<verse eid="LUK 6:11"/></para>
  <para style="s1">ቶሞንኮ ላማ ኦፋራሜራንኮክ አሳባማኖ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ. 10፡1-4</ref>፤ <ref loc="MRK 3:13-19">ማር. 3፡13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>ሀሱ አሪልኮ ቶይ የሱሳ ኤባይን ዎዳም ቶስ ቤ፤ ሄመን ዱዶ ዋ ቶስ ኤባታ ባሬ። <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>ባባርስ ኡሱኮ ኦአጋልሳታራን ኡመጉረ እሶኮ ቶሞንኮ ላማ አሳበ፤ እሶና ኦፋራመራን አመ መገ ቤሰ፤ <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>እሶና ጴጢሮሳ አመ ካኡመራ ስሞና አቢኬሳ እንድራሳ፥ ያይቆባ፥ ያንሳ፥ ፍልጶሳ፥ በርተሎሜዎሳ፥ <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>ማቶሳ፥ ቶማሳ፥ ካኢልፎሳ ኤረ ያይቆባ፥ “ካሀኡሳታረ” ካአማመረ ስሞና፥ <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>ካያይቆባ ኤረ ይሁዳና የሱሳ ሮርሰ ካስሰረ ኡል ካአስቆርቱክ ይሁዳ ሌን ግረን።<verse eid="LUK 6:16"/></para>
  <para style="s1">የሱሳ ካሞጋን ጎሳ አጋልስሳኖና ፋይሳኖኮክ ጋራ</para>
  <para style="r">(<ref loc="MAT 4:23-25">ማቶ. 4፡23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>የሱሳ እሶነ ዎታ ራቶ ዎዳምኮ ዳገጉረ ዲዳት ባንኤ አሌ፤ ኡሱኮ ኦፋራመራና ኣሎ ካሞጋን እባዶ ኤሰ ግረ፤ ይሁዳ ማማን ዱባኮና ኢየሩሳለምኮ ኡሱማሌ ጢሮስኮና ካስዶና ላቡግርኮ ካኤመተራ ካሞጋን ጎሳና ኤሰ ግረ። <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>ህኒዕና ካኮንኤመቴረን ኡሱኮ ማልና ካአባናዬን ማር ኦሮክ ሀዉኣምኮ ፋይንየ። ባቲክ አያናይ አቦሳማ ኦግሬና ፋዬን። <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ሁና ኡሱኮ ብያ ዱባና ፋይሳ ማንኮግረ ማራን፥ እባዶ ዱባ ኡሱ ድኒን ዶታታ ግረ።<verse eid="LUK 6:19"/></para>
  <para style="s1">ኦሶማና ጋዳኮክ ኣላንቲል</para>
  <para style="r">(<ref loc="MAT 5:1-12">ማቶ. 5፡1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>የሱሳ ኡሱኮ ኦአጋልሳታራን ቶስ ዲያ ሃ አመ፤</para>
  <para style="q1" vid="LUK 6:20">እስን ህየሳ ኦሶማሳንቴታን</para>
  <para style="q2" vid="LUK 6:20">ዎኖናት ካዋ ካክስንያ፤<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>እስን ግዳ ኦኡኣታን ኦሶማሳንቴታን፤</para>
  <para style="q2" vid="LUK 6:21">ሃሬ ባራርናታን፤</para>
  <para style="q1" vid="LUK 6:21">እስን ግዳ ኦኦታታን ኦስማሳንተታን፤</para>
  <para style="q2" vid="LUK 6:21">ሃሬ ኦሶልናታን!<verse eid="LUK 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22"/>እባዶ ኤረ ካእባዶ ማራን ጎዲደ፥</para>
  <para style="q2" vid="LUK 6:22">እስን ኦሮኮ ጎአሳቤና ጎቱፋተን፥</para>
  <para style="q2" vid="LUK 6:22">ካሜላን መገ ጎስሰና ኦሶማሳንቴታን።<verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>ህትማ ሙራትስን ዳሩሪ ታአቲታ፤ ሀሴ አሪ እስኑን ገጌሎ ሀሌን፤ ቡራቃ፤ ካሆርኮ ኦዶጆላልክሶ ካሄገሮ ጉት ካየለራን ሂካዋየ።<verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>አየሱን ጎአመን እስን ዱሬሳጆል</para>
  <para style="q2" vid="LUK 6:24">ኣኔ እስኑን! ጎጎእና ግዳዋ አታቴታን።<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>እስን ግዳ ኦባራርተታን ኣኔ እስኑን!</para>
  <para style="q2" vid="LUK 6:25">ሃሬ ኡኢናታን።</para>
  <para style="q1" vid="LUK 6:25">እስን ግዳ ኦኦሶላታን ኣኔ እስኑን!</para>
  <para style="q2" vid="LUK 6:25">ሃሬ ጋድናታን፤ ኦይናታን።<verse eid="LUK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26"/>እባዶ ዱባ ኢዳነታትስን ጎአዬሰ ኣኔ እስኑን!</para>
  <para style="q2" vid="LUK 6:26">ካሆሬ ኦዶጆላልክሶ ኦጣራ ሄገሮጆሉን ካየሌረን ሂካዋየ።<verse eid="LUK 6:26"/></para>
  <para style="s1">ዲና ጌላታኖ</para>
  <para style="r">(<ref loc="MAT 5:38-48">ማቶ. 5፡38-48</ref>፤ <ref loc="MAT 7:12">ማቶ. 7፡12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>“አየሱን ጎአመን እስን ኦማላታኑን አን ሃ አማራ፤ ዲናጆልክስን ጌላየን፤ እስን ኦዲዳራዉና ኢዳነ ፈላ፤ <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>እስን ካቃንጋሮና ሶማሳዬን፤ እስን ካምራሮና ኤባየን። <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>ኡይ ኮ ካባሳሮን ካካለ ኡይ አድ ቱስ፤ ጋሸ ኩኮ ካአታሮን ቆሎ አሮትርተ። <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>ካኤባታሮን ዱባን ስስ፤ ኡራዎኦታ ካአታሮን ጎጎአባብሮን አሮሆሳተ። <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>እባዶ ጎጎፈሎ ካዶታታን እስና ኡሱማሌ ፈላ።<verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>“እስን ካጌላታሮ ጎጌላተን መ ካለት ላኦ ሄላይናታን? ‘ጩባለሳጆልና’ ጎአመን እሶ ኦጌላታራን ጌላታራን። <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>እዳነ እስኑን ኦፈላራዉን ኢዳነ ጎፈልቴን መ ካለት ላኦ ሄላይናታን? ጩባለሳጆልና ጎአመን ሂካማሌ ፈላታራን። <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>አማኣ አባብሮዋ አንቴን ካኮሄዳታን እባዶን ጎአምአይሴን መ ካለት ላኦ ሄላይናታን? ጩባለሳጆልና ጎአመን ካአምአይሰራን ግታክ አባባይ አታይን ጩባለሳጆሉና አምአይሳራን። <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>አየሱን ጎአመን ዲናጆልክስን ጌላየነ፤ ኢዳነና ፈላ፤ አባባይ አታይን አብድ ሀየላኖን አምአይሳ፤ ሂካኒና ሙራታትስን ታንጂን ለታ፤ ዱባንኮ ጦቂ ካአመ ይስ ካዋ ልናታን፤ ኡሱ ጋላታ ካልክዉና ካሜላን እባዶ ዱባን ካእዳንክያ። <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>ካዳሩረ ኣቦክስን እስኑን ጎጎነኔኤይሳታሮክ ማለ እስና ኡሱማሌ ኦነኔኤይሳታን ላ።<verse eid="LUK 6:36"/></para>
  <para style="s1">ካካለ ጉት ፍርዳኖ ካዶትሶን ላኖ</para>
  <para style="r">(<ref loc="MAT 7:1-5">ማቶ. 7፡1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>“አሮፍርድቴን እስኑን ላኮፍርዳምሮ፤ አሮቦህቴን፤ ላኮቦሀንታን፤ ሀሄሶ አማ፤ ዋ እስኑን ሀሄሶ አምሮዋ፤ <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>ስሳ ዋ እስኑን ስስሮዋ፤ ካኮኤካሳታን ሁይ አባባይ እስኑን ማንኮኤካሳምናሮ ማራን፥ ሁጭም አኢ ምግሊ ታኡባሮ ካእዳንክ ሁይ ኤካሳም እስኑን ስሳምናራ።”<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>አደና የሱሳ ሂካ ማሱሳ ሃ አመ እሶን ሰገ፤ “እልኦ ካደያኖን ኢልኦ ካንደያኖን አብ ገጌይስን ዳንዳራ? ላማ እስአባቴረን ጉምቢ ኦሮዴን ላኮኢያራንያ? <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>ካአጋልሳታራ ካአጋልስሳሮኮ ላኮሮራሮ፤ አየሱን ጎአመን ማዳር ካአጋልሳተ እባዶ ዱባ ካአጋልስሳሮ ኣን ልናራ።<verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>“አቢካካት እሊ ኦሮ ካግሮ ሁራ መዉን ድያታ? እልታይ ኦሮ ካጌዳባመሮ ጋ ላኮድያቶያ? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>እልታይ ኦሮ ካግሮ ጋ ሀንደያኖን አብካነ ‘አቢኬ፤ ኢልታይ ኦሮ ካግሮ ሁራ ኩን ቤሱ’ ምሲ አምን ዳንዳታ? አት ኢፍሳዳ፤ ሆራርጀ ኢልታይ ኦሮ ካጌዳባመሮ ጋ ቤሳ፤ ኤሰኮ አባባደ አብካት እሊ ኦሮ ካግሮ ሁራ ቤስን ኢድስ ድን ዳንዳታ።<verse eid="LUK 6:42"/></para>
  <para style="s1">ጋና ኢልቴሳና</para>
  <para style="r">(<ref loc="MAT 7:16-20">ማቶ. 7፡16-20</ref>፤ <ref loc="MAT 12:34-35">12፡34-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>“ካእዳንክ ጋ ሌ ግራንቲ ታሜላንት ኢል ካዱባማራ ጋ ላኮግሮ ኡሱማለና ካሜላንክ ጋ ሌ ግራን ታኢዳንት ኢል ካዱባማራ ጋ ላግሮ። <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>ጋ ዱባ ታካታሮ እሊ አዴሳማራ፤ ጋ ካኤኤንኮና በለስ ታአማማታ ኢል ላኮአባባማቶ፤ ኡሱማለና ሞላልኮ ዎይኒ ታአማማታ ኢል ላኮአባባማቶ። <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>ካእዳንክ እባዶ ዎዳናቴሳ ካአማጋመሮ ካእዳን አየስኮ ኢዳነ ቤሳታራ፤ ካሜላን እባዶ ዎዳናቴሳ ካአማጋመሮ ካሜላን አየስኮ ሜላነ ቤሳራ፤ እባዶ ዎዳናቴሳ አማጋመ ካሮረሮ ህኢቴሳይ አዬሳራ።<verse eid="LUK 6:45"/></para>
  <para style="s1">ቃሮክና ጎዋክ ምን ኦማዳራተራን</para>
  <para style="r">(<ref loc="MAT 7:24-27">ማቶ. 7፡24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>“አን ካአማሮ ላኮፈላታን ሀያ ሙን፥ ‘ጎታ፥ ጎታ’ አማታን? <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>እን ቶስ ካኤመታራ ሃፉራኬ ማለረ ፈሎይ ካሀይሳራ ዱባ አዮ ኣን ላሮ አን እስኑን ቱስሮ፤ <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>ምን ማዳራዪን ኣሎ ጉምቢ የለ ካኦሸሮና ኤኤሞ ጉት ኡኩም ካኡኩማተሮ እባዶት ኣን ላራ፤ ዳድ አማጋመ ኤመተጉረ ኡሱ ምን ሻፈ፤ አታተ ማንኮማዳራመረ ማራን አእስና ላኮዳንዴ። <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>ሃፉራ ካኬ ማለረ ፈሎይ ካሀይሶን ጎአመን ምንካኬሳ ኡኩም ካሊ ኤሬ ጉት ካማዳራተሮ እባዶት ኣን ላራ፤ ዳድ አማጋማኖኮ ካከይ ምን ካኮሻፋረ ጎራታ ጎርሰዋ እዬ፤ ኢያኖና ጎሜላን ሌ።”<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">ዎታዳራ ቦሉን ዎይቻ ካሌሮኮክ አማኖ</para>
  <para style="r">(<ref loc="MAT 8:5-13">ማቶ. 8፡5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>የሱሳ ሂካ ዱባ ጎሳ ሆረ አዬሰ ጉድሰረ ቅፍረናሆም ቶስ ታበ። <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>ኤሰና ካሮም ዎታዳራ ቦሉን ዎይቻ ካሌረ ግረ፤ ኡሱ ኣሎ ካጌላታረ ኡሱን ካሀንዳረክ ሀዉኣመረ ጎይን ጋባላመ ግረ። <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>ኡሱና የሱሳኮክ ጋራ ካኮማላረ ጎራታ ኡሱን ካሀንዳረክ ጎጎፋይስሮ ጎጎኤባናዉን ኡል ካአይሁዳት ጃርሶለኮ ፋረ። <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>ሀንዳ ኦፋራሜረና የሱሳ ቶስ ኤመተንጉረን ሃ አመን አታይሰን ኤባተን፤ “ሂካ እባዶትን አት ሂካ ፈልን ዶትሳራ፤ <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>ኣላንቲና ሂክ እባዶት ጎሳካን ጌላታራ፤ ምን ካኤብካን ኖን ካማዳርስሰራና ኡሱያ።” <verse eid="LUK 7:5"/><verse number="6" style="v" sid="LUK 7:6"/>የሱሳ እሶነ ዎታ ሴተ። ኡሱና ምን ቶስ ካኮጋባላማረ ጎራታ፥ ዎታዳራ ቦልኮክ ዎይቻት ኦጌላታረ ፋረረ የሱሳነ ሃ አመ፤ “ጎታ፤ አት ምንኬ ኦርድ ታብን አን ካዶትሳሮ እባዶት ላኮዮ አሮሀርተ፤ <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>ሂካኮ ካከይ ኩ ሆረ ጋባላሚን ዱዶ ካዶትሳሮ ኣን እስኦተ ላኮቶታታሮ፤ ሃፉራ ኮ ካላል አየስ፤ ኢን ካሀንዳረክ ፋይሮዋ። <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>አን መተኬዉን ካጉተ ዎይቻ አባ እንኮ ሄገሌ አደ ኢን ካሃንዳራ ዎታዳራ ግራ፤ ኮኔ አት ‘ሴ’ ጎአምሮ ሴታራ፤ ካካለነና፥ ‘ኮያ’ ጎአምሮ ኤመታራ፤ ኢን ካሃንዳራና፥ ‘ሂካ ፈል’ ጎአምሮ ኢን አጃጃማራ።” <verse eid="LUK 7:8"/><verse number="9" style="v" sid="LUK 7:9"/>የሱሳና ሂካ ካኮማላረ ጎራታ ኡሱ ሳደ፤ ካምባል አመረና ደቤሴታ ካግረ ጎሳነ፥ “አን እስኔ ሃ አማራ፤ ህታ ኣንትት ታንጂንት አማኖ እስራኤሊ ዱዶ አን ላኮሄለሮ” አመ። <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>ሀንዳ ካሴተረ እባዶ ምን ካኮአባባታረ ጎራታ፥ ኡሱ ካሀንዳረክና ካፋዬሮ ዴን።<verse eid="LUK 7:10"/></para>
  <para style="s1">የሱሳ ካጋልታንተት ኤረ ጎይኮ ኬሰ</para>
  <para style="r">(<ref loc="1KI 17:17-24">1 ዎኖ. 17፡17-24</ref>፤ <ref loc="2KI 4:32-37">2 ዎኖ. 4፡32-37</ref>፤ <ref loc="MRK 5:21-24">ማር. 5፡21-24</ref>፥<ref loc="MRK 5:35-43">35-43</ref>፤ <ref loc="JHN 11:1-44">ያን. 11፡1-44</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>ኤሰኮ አባባተረ የሱሳ ታንጂን ሀአዳላኖን፥ ናይን ታአማማቶ ካታማ ቶስ ሴተ፤ ኡሱኮ ኦአጋልሳታራና ካሞጋን ጎሳ ኡሱነ ዎታ ሴተ። <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>ካታማ ቶስ ካኮታባራን ካራ የሱሳ ካኮገያረ ጎራታ፥ እባዶት ኮኮክ ሬስ ስዴንጉሬን ካታማኮ ቤን፤ ካጎየረና ኣየተሳዉን ኮ ካላልየ፤ ኣና ጋልታንተተ፤ ካሞጋን ካካታማ ጎሳና ኤሰነ ዎታ ግረ። <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>ጎታና ኤሰ ካኮደያረ ጎራታ ነኔኤይሳተጉረ፥ “አላማንደ፥ አሮኦተ!” አመ። <verse eid="LUK 7:13"/><verse number="14" style="v" sid="LUK 7:14"/>ጋባላመረ ታኮስዴራን ራሬ ድነ፤ ካስደረ እባዶና ታክ አመ አሌ፤ የሱሳና፥ “አት ዎዳላት፥ አን ኩኔ ክ አማራ” አመ። <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>ካጎየረ እባዶትና ኔፎ አባባተደ ፋዬረ ጦቂ አመ ሀማጼ፤ አዬሳኖ ሀጋአበ። የሱሳና ኣተረ አዉን ስሰ። <verse eid="LUK 7:15"/><verse number="16" style="v" sid="LUK 7:16"/>ዱባና አብሳተሬን ዋ ጋላታ፥ “ካአቲ ካሄገሮ ኖ ኦሮኮ ኬራ”፥ “ዋ ጎሳኬሳ ፋይስን ኤመተራ” አመን። <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>ሂክ የሱሳኮክ አታን ካይሁዳ ኡል ዱባይና ኡሱ ማማኒ ካግሮ ኡል ዱባ አዴሳመ።<verse eid="LUK 7:17"/></para>
  <para style="s1">የሱሳና ካጣማቃሮ ያንሳና</para>
  <para style="r">(<ref loc="MAT 11:2-19">ማቶ. 11፡2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>ያንሳኮ ኦአጋልሳታረን ሂካ ዱባ ያንሳን ሰገን። ኡሱና እሶ ኦሮኮ ላማ ኡመረ፥ <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>“ኤመታራ ካአማንተተ አትተ? ሙ ካካለ ኦራና? አማ” አም ጎጎሆሳናዉን ጎታ ቶስ ፋረ። <verse eid="LUK 7:19"/><verse number="20" style="v" sid="LUK 7:20"/>እባዶጃና የሱሳ ቶስ ሴቴረነ፥ ኤመታራ ካአማንተተ አትተ? ሙ ካካለ ኦራና? አም ኖ ኩ ጎጎሆሳኖን “ካጣማቃራ ያንሳ ኖ ኩ ቶስ ፋረራ” አመን። <verse eid="LUK 7:20"/><verse number="21" style="v" sid="LUK 7:21"/>ጎርሰዋ የሱሳ ካሞጋን እባዶ ሀዉኣምኮ፥ ማር ኦሮክ ሀዉኣምኮና ባቲክ አያናልኮ ፋይሰ፤ ካሞጋን ኢልኦ ካንደያኖን ኢልኦ ደንዴይሰ። <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>ያንሳን ሀንዳ ኦሴተረነ የሱሳ ሃ አመ፤ “ሴንጉዴን ካዴተታና ካማልቴታን ያንሳን ሰጋ፤ ኢልኦ ካንድያኖን ድናራ፤ ኦኤሳራን ቱኩል ሰሴይናራን፤ ማሪ ባር ኦአባና ሙጭምናራን፤ ነቤ ኦማሎና ማልናራን፤ ኦጎየራና ጎይኮ ክናራን፤ ሂየሳሉና ዎንጋላ ላላባምናራ። <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>እዬ አብዳታና ዋት ካሀንዱዱፋኖን እባዶ ዱባ ካሶማሳመያ።” <verse eid="LUK 7:23"/><verse number="24" style="v" sid="LUK 7:24"/>ያንሳን ሀንዳ ኦኤሜተሬን ሴተን ካኮቦዋሬን ጎራታ፥ የሱሳ ጋራ ያንሳኮክ አዬሳኖ ሀጋአበ፤ ሃና አመ፤ ያንሳ ቶስ ጋ ካኮንቤቴተን መ ዲንየ? አምባል ካዎልዎልሳቶ ፊቀያ? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>ሀያ መ ድን ቤተን? ካእዳን ሳርስ ካሳርሳተሮ እባዶያ? ካኢዳሮ ሳርሲ ኦኢሳዳራና ግር ካኤካተ ኦግራን ምን ካዎኖይ ግራንዋ። <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>ሀያ! እስን መ ድን ቤተን? ካሄገሮ ድን ሌዉና? እ አን እስኔ ሃ አማራ፤ እስን ድን ካቤተቴን ካሄገሮኮና ካሮራሮያ። <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>ሃ አማመ ካኮንጻፋመረና ኡሱያ፤ “ ‘ራካና ኩ ሆረ ካኤካስሮ፥ ኤርግቻኬና ኩኮ ጣይስ አን ፋርናራ።’ <verse eid="LUK 7:27"/><verse number="28" style="v" sid="LUK 7:28"/>አን እስኔ ሃ አማራ፤ ሄለልኮ ካኡሙላመሮ ኦሮኮ ያንሳኮ ካሮራራ ላግሮ፤ ዎኖናት ካዋይ ጎአመን ዱባንኮና ካየራታራ ኡሱ ሮራራ።”<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>ቃራጣ ኦኩኩይሳራና ሀሄሶን፥ ሂካ ኦማሌን ዱባ ካያንሳ ጥንቃታ ጣማቃማ ዋ ቁሉክያ አመን አቶቴን። <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>እባዶ ካፋራሳውልና ሴራ ካሙሴ ኦካሳን ጎአመን ታያንሳ ገነ ጣማቃማና ዋት፥ ዋ እሶን ካአቦ ሀልቻ ኔባቴን።<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>የሱሳ አደ፥ “ጎርታ ህታ አላታንኮክ እባዶ አን ሜይ ማሱስራ? መ ኣን ላራን? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>ባንኤ ታግያይ ሀማጼሬን እስ እስሮ እስ ኡኡማታ ሃ ካአማሮ ይሳስ ኣን ላናን፥ ‘ኖ ሱሱሌ እስኑን ኡፉፍነ፥ ላኮዱዱርቴን፤ ቦቾ እስኑን ቤንሰ፥ ላኮኦቴን።’ <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>ኣላንቲና ካጣማቃራ ያንሳ አጋቡይ ካም ሀኣሞና ካዎይኒ ጣሞ ሀንጣሞን ጎኤመተ፥ ‘ባቲክ አያና አባ’ አንቴን። <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>ኤረ ካእባዶ አድ አማና ጣማ ጎኤመተ ‘አሞና ጣሞን ካጋጲጋጳሮ፥ ቃራጣ ኦኩኩይሳራና ጩባለሳል ካጌላታሮ’ አንቴን። <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>ጎርታ ቃሩማኮክ ልክ ላኖ ካአታተሮ እባዶ ዱባ ዶሌ አዴሳንተ አመ።”<verse eid="LUK 7:35"/></para>
  <para style="s1">ሄለልትቲ ቶ የሱሳን ሽቶ ሽግደ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>ኤሴና እባዶ ካፋራሳውኮ ኮኔ ዎታ ባቦ ጎጎአምሮን የሱሳ ኡማተ፥ ኡሱና ፋራሳውትኮክ ምን ቶስ ታበጉረ ባቦ ኣምን ሀማጼ። <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>ኤሰ ካታማይ ታግቴ ቶ ጩባለቲ ሄለልትቲ፥ የሱሳ ፋራሳውትኮክ ምኒ ባቦ ኣምን ሀማጻኖ ካኮማላተ ጎራታ ኮ አልባስጢሮስ ካአማማሮ ኤኤሞኮ ቆራመ ካፈላመሮ ብልቃደ ምግ ታሌተቶ ሽቶ ኣተ ኤመተ፤ <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>ምና ታሃሬነ ሉቃ. ዶሌ አልተደ ኦታ ኢልም ሉቃ. ጉት ኡባ መተክሰይና ሻካራኖ ሀጋአብተ፥ ሉቃኦቴሳና አንጋታ ሽቶ ሽግደ።<verse eid="LUK 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39"/>ካኡማተረ ፋራሳውትና ሂካ ካኮደያረ ጎራታ፥ ሂክ እባዶት ካሄገሮ ሊ ግረዋ ኡሱ ታድንተታ ሄለልትቲ ማዮቶ፥ አደ ማምስት እባዶትቶ አዴስ ግራረ፤ ጩባለቲታ አመ ዎዳናቴሳ ሄደ።<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>የሱሳና፥ “ስሞና፥ አን ኩን ካሰግናሮ አየስ አባ” አመ።</para>
  <para style="p" vid="LUK 7:40">“ኡሱና ካአጋልስሳቶ! ኢን ሰጊ” አመ።<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>የሱሳና ሃ አመ፥ ኮ ካአምአይሳሮኮ ማራጋደ ኦኣማኣቴረን እባዶጃ ላማ ግረን፥ ኮ ከን ቦሌ ጣጋራ፥ ካላምና አደ ጣጋራ ኮንቶም አማኣተረን። <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>አባብ ካስስና ካኮዋታሬን ጎራታ አንዛትሶ ላማ ዱባና ኡሱ ኢሳገ። ጎርታ እሶ ላማ ዱባኮ ካአምአይሰሮ ሮርሳተ ካጌላታራ ኤክያ?<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>ስሞናና፥ “ታሞጋን አንዛ ካኮንሄሰቶ ኣን ላራ” አመ አባበ። የሱሳና፥ “ልክ አባብቴታ” አመ።<verse eid="LUK 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44"/>ሄለልትቲ ቶስ ካምባል አመረ ስሞናነ ሃ አመ፥ “አት ህታ ሄለልትቲ ድያታ? አን ምንካ ጎታበ፥ አት ሉቃኦተዉን በከና ላኮስሰተ፥ ኤሰ ጎአመን ሉቃኦቴ ኢልምትሴይ ኣልሰደ መተካክሰይ ሻካርተ። <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>አት ዱዶ እን አንጋተ ኖጎዳ ላኮኣተቶ፥ ኤሰ ጎአመን አን ጎታበኮ ሀጋአብተዴ ሉቃኦቴ አንጋታና ላኮኣልሰቶ። <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>አት መተካኬይ ዛይቲና ላኮሽግደቶ፤ ኤሰ ጎአመን ሉቃኦተይ ሽቶ ሽግደ። <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>ሃንሱን አን ሃ አማራ፤ ኤሰ ኣሎ እን ጌላተታ ካንጂን ጩቦ ኤሰን ሻጋ ሌራ፤ ጩቦ ክጫርክ ሻጋ ካኮንሌራ ጎአመን አባራንቲ ጌላታራ።”<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>ኤሰኮ የሱሳ ሄለልትቲነ፥ “ጩቦካ ሀሄሶ አማመራ” አመ።<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>ኡሱ ዎታ ባቦ ኣምን ሀማጽተ ታግቴ ማርትና፥ “ሂክ ጩቦ ዱዶ ሀሄሶ ካአማራ ኡሱ አዮያ?” አመን እስ እስኦሮ አዬሴን።<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>የሱሳ ሄለልትቲነ “አማኖካ ኩ ፋይሰራ ኖጎዳ ጋል!” አመ።<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s1">ካዉጣታሮኮት ማሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>ኤሰኮ አባባተረ የሱሳ ዎኖናት ካዋ ካገጌላይስሮ ሃፉራ ላላባ ካታማልነና ማማንጆላልነ ሮረ፥ ቶሞንኮ ላማና ኡሱ ዎታ ግረን። <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ኡሱማሌ ባቲክ አያና ካኮንቤራና ማር ኦሮክ ሀዉኣምኮና ካፋዬራ ኮኮ ሄሌልጆልና ዎታ ግረ፤ እሶና ዱርሳ ቶዶባ ታኮበሬ ኡል ካመግደላኮት ማይራመ፥ <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ካሄሮዶሳ ምኒ ኦዶናት ካአባናየ ታኩዛ ኦር ዮሃና፥ ሶስና፥ አደና ካሞጋን ካካለ ግረ፤ ህኒዕና ኡራዎኦትሶይ የሱሳና ኡሱኮ ኦአጋልሳታረዉና ኦሀንዳሬንየን።<verse eid="LUK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>ካሞጋን ጎሳ ኮሌ ኩኩ አመ ግራንቲ፥ አደና እባዶ ካለካለት ካታማልኮ የሱሳ ቶስ ካኮኩኩአማረ ጎራታ፥ ሂካ ማሱሳ ሃ አማ እሶን ሰገ፤ <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/>“ኮ ኦታተ ካባራረ ዉጣ ዉጣዪን ቤ፤ ዉጣታ ግራንቲ ኮኮ ዉጣ ራድ እዬ፤ ሉኪና ዳዳራመ፤ ክምብርጆልና አመ። <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>ኮኮ ዉጣ ታኤኤሞልት ኤሬ እዬ፤ ጎጎአላቴ ኡንጃነ ግራናማንኮዋተ ማራን አንጋገ። <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>ካካለ ዉጣና አደ ኤኤን ኦሮ እዬ፤ ኤኤን ዎታ ጂናተ ማርግሰ ሃሰ። <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>ካካለ ዉጣና ኤሬ ታኢዳንት ጉት እዬ፤ ካኮአላታረ ጎራታ ካዉጣመሮኮ ቦል አምባና ዱባመ።” ሂካ አመረ ጉድሳ ያየ ጦቂኢሰረ፥ “ታማላቶ ነበ ካአባ ሀማሎ” አመ።<verse eid="LUK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>የሱሳኮ ኦአጋልሳታረን ህታ ማሱሳኮት ፉሬን ኡሱ ሆሳተን። <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>ኡሱና ሃ አመ፤ “ዎኖናት ካዋኮት ሆል ማላባኖ እስኑን ስሳመራ ኦካለቱን ጎአመን ማሱሳይ አን አዬስናራ፤ ህክና፥ ዲያ ግራን ዎዳና ጎጎኮካኖንኮ፥ ማላ ግራን ጎጎሻዶንኮያ።” <verse eid="LUK 8:10"/><verse number="11" style="v" sid="LUK 8:11"/>“ጎርታ ታማሱሳ ፉረንና ህታታ። ዉጣ ካአማመረ ሃፉራ ካዋያ። <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>ራድ ካኢየረና ሃፉራ ኦማላራን፥ አየሱን ጎአመን አማንሬን ጎጎፋይኖንኮ ዱርሳ ኤመተረ ሃፉራ ዎዳናታቴሳኮ ካኮአታሮያን። <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>ኤኤሞልት ኤሬ ካኢየረ ሃፉራ ጎማላን ገጌሎይ ኦአታታራንያን። ሂኒዕ ጎራታ ክጫሩን አማናራን ኳሬ ህዲድ ማንኮዋተ ማራን ካጫፍቲ ጎራታ ባኔ ኦካካታራንያን። <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>ኤኤን ጠኤ ካኢየረና ሃፉራኬሳ ኦማላናንያን፤ ሀዬን ባሬነን ግር ካኡሌኮክ ቆፋ፥ ዱሩማይና ባርሳኖ ኦኢዳነት ገጌሎይ ማርግሳመነ ዱባምን ጎጎዶትሳሮ ኢል ላኮዱባማራን። <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>ኤሬ ታኢዳኒ ጉት ካኢየራ ሃፉራኬሳ ታኢዳንትና ቱኩልት ዎዳና ማለሬን ኦኦራታራን፤ ኦብሳና አታታ ኢል ኦዱባማራንያን።<verse eid="LUK 8:15"/></para>
  <para style="s1">ቦላንሶ ጉት ካግሮ ኮሮንታ</para>
  <para style="r">(<ref loc="MRK 4:21-25">ማር. 4፡21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>“ኮሮንታ ሀንቃይሳተረ ቶሳ ኦሮ ጎርቱን አልጋ ሄገሊ ካካታራ ማዮና ላኮግሮ፥ ሃ ካየላሮኮ ምን ኦርዴ ካታባራ እባዶ ኢፋ ጎጎድያሮ ቦላንሶ ጉት ሶዋታራ። <verse eid="LUK 8:16"/><verse number="17" style="v" sid="LUK 8:17"/>ካሙቶን ካስያመራ፥ ካአዴሳሞን ኢፋ ቶስ ካንቤኖን፥ ካጎላተራ አየስ ላኮግሮ። <verse eid="LUK 8:17"/><verse number="18" style="v" sid="LUK 8:18"/>ጎርታ እስን ማምሲ ማልናታን እስኦራዬን፤ ካኮግሮን አዳማራ፤ ካልክ ዱባኮ አደ ኣንክ ካግሮ ኣን ካላራ ዱዶ አታምናራ።”<verse eid="LUK 8:18"/></para>
  <para style="s1">አዬ ታየሱሳና አቢላልቴሳና</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ. 12፡46-50</ref>፤ <ref loc="MRK 3:31-35">ማር. 3፡31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>ኤሰኮ አባባተረ አዬ ታየሱሳና አቢላልቴሳ የሱሳ ማንኮግሮ ኤመተን፤ እሶና ጎሳ ሞጋንኮ ካከይ ኡሱ ቶንሳ ጋባላሚን ላኮዳንዴረን። <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>ሀሱ ጎራታ፥ “ኣየታና አብላልታ ኩ ድን ዶተረን ሳሬ አሌራን” አመን ኡሱን ሰገን። <verse eid="LUK 8:20"/><verse number="21" style="v" sid="LUK 8:21"/>ኡሱና እሶን አባበረ፥ “ኣየትና አቢላልትና ሃፉራ ካዋ ማለሬን ፈሎይ ኦሀይሳታራያን” አመ።<verse eid="LUK 8:21"/></para>
  <para style="s1">የሱሳ ጋሽማሎ ጫልኢሳኖ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ. 8፡23-27</ref>፤ <ref loc="MRK 4:35-41">ማር. 4፡35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>አሪልኮ አሪ ቶይ የሱሳ ኡሱኮ ኦአጋልሳታራነ ዎታ ዎላቦይ ኮራተረ፥ “በከኮ ጋማ ናቅና” አመ፤ ኤሰኮና ዱዳታኖ ሆረዴን። <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>በከ ኦሮ ዱዳታ ግራንትን የሱሳ ዎላቦ ኦሮ ሁዱረ፤ ኡሱ ጎራታ በከ ጉት ጋሽማሎ ካአቲ ኬ፥ በከና ዎላቦ ቃማኮ ሮሬነ ማንኮታቤነ ማራን ባይኮት ህኢ ገገን። <verse eid="LUK 8:23"/><verse number="24" style="v" sid="LUK 8:24"/>የሱሳኮ ኦአጋልሳታረን ኡሱ ቶስ ጋባላሜረን፥ “ጎታ፥ ጎታ! ኖ ላጉዳነላ!” አማ ሁዱሮኮ ኡሱ ናባድሴን፥ ኡሱና ናባደረ አምባልና፥ በከኮክ ሻላጋማኖ ሀድሰ፤ ኡሱ ጎራታ አምባልና ሻላጋማኖ ኢሰ ጫልኤት ሌተ። <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>ኡሱና ኡሱኮ ኦአጋልሳታናነ፥ “አማኖክስን ኤኮ ሀያ? አመ። እሶና አብሲና ሳዳኖይ፥ ሂክ አምባልና በከና ካኮን አጃጃማራን አፎ አዮያ?” አመን እስ እስኦሮ አዬሴን።<verse eid="LUK 8:25"/></para>
  <para style="s1">ዱርሳ ካአበረ እባዶትኮክ ፋያኖ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ. 8፡28-34</ref>፤ <ref loc="MRK 5:1-20">ማር. 5፡1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>ኤሰኮ አባባተረ ጋሊላኮ ጋማ ካግሮ ካገርገሰኖን ኡል ቶስ ዎላቦይ ናቄን። <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>የሱሳ ዎላቦኮ ዴገረ ባጋ ካኮበያረ ጎራታ፥ ዱርሳ ጉት ካኮግረ ኮ ኤሰ ካታማኮክ እባዶት ኤሰለ፤ ሂክ እባዶት ካሞጋን ጎራታ ሳርስ አንሳርሳኖኒ፥ ምና ሀንታቦን ባንኤ ታህዬል ምን ካየላተረያ። <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>የሱሳ ካኮደያረ ጎራታ ኦካ ኡሱ ሆረ እዬ፤ ታአቲ ያዬ፥ “ዱባንኮ ካንጂንክ ኤረ ካዋ የሱሳ፤ አት ኢነ ዎታ ታሜ ኤሴላ አብታ? እን ጎጎአቦስሶንኮ ኤባታራ” አመ። <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>ሂካ ካኮንአመረ ባቲክ አያናጆል እባዶትኮ ጎጎቤሮ የሱሳ አጃጃ ስሰ ማንኮግረ ማራንያ። ባቲክ አያናጆል አርጌቶ ማንኮከያሮ ማራንቱ እባዶት ሳንሳላታና ማርጮ ታሉኬት ሻም ጎኦራምሮና ካኮሻመሮ ሳንሳላታ ጎጎሳ ካአበረ ባቲክ አያናጆል ጋ ቶስ ኣተ ብያ ግረ። <verse eid="LUK 8:29"/><verse number="30" style="v" sid="LUK 8:30"/>የሱሳና፥ “መገካ አዮያ?” አመ ኡሱ ሆሳተ። ኡሱና ካሞጋን ዱርሳ ታበ ማንኮግረ ማራን፥ “መገክና ለገኦንያ” አመ። <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ዱርሳነና ቦዋ ኦሮ ታባ አም ጎጎአጃጂኖንኮ አታይሰን ኡሱ ኤባተን። <verse eid="LUK 8:31"/><verse number="32" style="v" sid="LUK 8:32"/>ኡሱ ማማኒ ዎዳም ላዩይ ጅግ ታሌታ ታሞጋን ቦዬ ኤሰ ፎፋማ ግቴ። ዱርሳነ ታሞጋን ቦዬ ቶስ ታባ አም ፈኢ ጎጎስስሮ ኤባተን፤ ኡሱና ፈኢ እሶን ስሰ። <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>ዱርሳና እባዶትኮ ቤጉረ ቦዬ ቶስ ታቤን፤ ቦየልና ቦዋ ህኢ ሄገልዴ ኦቶቶላ በከ ኦሮዴ ታበ ልች አመ።<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>ኦፎፌና ካሌሮ አየስ ካኮደያረን ጎራታ፥ ትትዬን ሴተሬን ካታማይና ጋጣሬ አዬሴን። <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>ጎሳ ካሌሮ አየስ ድን ማንኮግሮኮ ቤጉረ የሱሳ ቶስ ኤመተ። ዱርሳል ካኮቤረ እባዶት ሳርስ ሳርሳተረ፥ ዎዳናቴሳ አባባተደ፥ የሱሳ ሉኪ ሄገሊ ካሀማጼሮ ካኮደያረን ጎራታ አብሳተን። <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>ዱርሳ ካአባመረ እባዶት ፋያ ግራንቲ ኦዴራና፥ ምሲ ፋዬሮ ጎሳን ሰገን። <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>ማማን ካገርገሰኖን ኡልኮክ እባዶ ዱባ ታንጂን አብሳተጉረ፥ ኤሰኮ ጎጎሴሮ የሱሳ ኤባተን፤ ኡሱና ዎላቦ ታበረ አባባተ ሴተ። <verse eid="LUK 8:37"/><verse number="38" style="v" sid="LUK 8:38"/>ዱርሳል ካኮቤረ እባዶት የሱሳ ዎታ ሴይን ኤባተ፤ ኡሱ ጎአመን ሃ አመ፤ <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>“ምንካ አባባደ፥ ዋ ኩን ካፈለሮ ካንጂንክ አየስ አየስ።” እባዶትና የሱሳ ኡሱን ካፈለሮ ካአቲ አየስ ካታማ ዱባ ሙተ አዬሳ ሴተ።<verse eid="LUK 8:39"/></para>
  <para style="s1">ታጎተቴ ኡኑትና ታሀዉአንተተ ሄለልትቲ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ. 9፡18-26</ref>፤ <ref loc="MRK 5:21-43">ማር. 5፡21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>ጎሳ ዱባ ኤመቶቴሳ ኦራታ ማንኮግረ ማራን፥ የሱሳ ካኮአባባታረ ጎራታ ገጌሎይ ኡሱ አታቴን። <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>ኡሱ ጎራታ እያኢሮስ ካአማመረ ካአይሁድ ምን ኤብኮክ ዎይቻ ኤመተረ፥ ሉክ ታየሱሳ ጉት ኢየጉረ ምንኬሳ ጎጎሴሮ ኤባተ፤ <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>ሂካ ኤብ ካኮንኤባተረ ጌስ ቶሞንኮ ላማ ታኮሌረ ቶ ኡኑት ታላል ማንኮግቴ ማራንየ፤ ኤሰና ሀዉኣንተደ ጎይ ህኢ ጉት ግቴ። የሱሳ ኤሰራ ሴታ ግራን ጎሳ እስእስ ሻሻፋታ ኣሎ ሀርሳ ግረ።<verse eid="LUK 8:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 8:43"/>ጌስ ቶሞንኮ ላማ ኢግ ኡባታ ታኮግረ ሄለልትቲ ቶ ግቴ፤ ካአብቶ ዱባ ኦዶ ዶብጆሉን ጉሳተደ ፋይስና ካዳንዴረ ማዮና ላኮግረ። <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>ኤሰና ምና ታሃሬነ ጋባላንተደ ሳርስኮት ብርጠ ድንተ፤ ኡባታ ካግረ ኢግና ጎርሰዋ አሌ። <verse eid="LUK 8:44"/><verse number="45" style="v" sid="LUK 8:45"/>የሱሳና፥ “እን ካድነራ አዮያ?” አመ። ዱባና ድናናዋትክሶ ካኮካካታሬን ጎራታ ጴጢሮሳ ጎታ፥ ጎሳ ዱባ ማራሙረ ኩ ሀርሳራ አመ። <verse eid="LUK 8:45"/><verse number="46" style="v" sid="LUK 8:46"/>የሱሳ አደ እባዶት፥ “ኮ እን ድነራ፤ ሁናና እንኮ ብያኖ ካሳ” አመ።<verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>ሄለልትቲና እስ ስያምሳይ ጋልን ዳንዳናዋት ካኮአዴሳተ ጎራታ፥ ሀርኣ ኤመተዴ ኡሱ ሆረ ኢተ፤ መዉን ድንተቶና ምሲ ጎርሰዋ ፋይተቶ ጎሳ ዱባ ሆረ ሰጋተ። <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>ኡሱና፥ “ኡኑቴ፤ አማኖካ ኩ ፋይሰራ፤ ኖጎዳ ጋል” አመ። <verse eid="LUK 8:48"/><verse number="49" style="v" sid="LUK 8:49"/>የሱሳ ጋና አዬሳ ግራንቲ፥ እባዶት ኮ አይሁድኮክ ምን ካኤብ ዎይቻ ካሌረ ካኢያኢሮስ ምንኮ ኤመተረ፥ “ኡኑታታ ጎተታ፤ ሂታኮ ዳንቤባን ካአጋልስሳሮ አሮሀርሰ” አመ።<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>የሱሳና ሂካ ማለረ ኢያኢሮስነ አላማንደ፥ “አሮ አብሳተ፤ አማና ኳሬ ኡኑታታ ፋይናታ” አመ። <verse eid="LUK 8:50"/><verse number="51" style="v" sid="LUK 8:51"/>ምን ካኢያኢሮስ ቶስ ጎታብሮ ጴጢሮሳ፥ ያንሳና ያይቆባኮ ኡሱማሌ ኡኑትኮት ኣና ኦዶና ኳሬ ማዮና ኡሱ ዎታ ጎጎታብሮ ላኮዶተሮ። <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>ሀሱ ጎራታ እባዶ ዱባ ዎ ዎ አማ ኤሰን ኦታ ግረ። የሱሳ አደ፥ “አሮ ኦቴን፤ ሁዱርተታ ኳሬ ላኮጎተቶ” አመ።<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>እባዶና ጎዋኖክሴ ማንኮካሶ ማራን ኡሱን ኦሶለ። <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>ኡሱ ጎአመን ገነትሴ አበረ፥ “ተአት ኡኑ፥ ክ” አመ። <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>ኔፎ ታኡኑትና አባባተ፤ ጎርሰዋ ኬተ አልተ፥ የሱሳና ኤሰ ካአንቶ ኮኮ ጎጎስስራዉን ሰገ። <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>ኦኡሙለራና ሳደን፤ ኡሱ ጎአመን ካሌሮ አየስ ማዮና ጎጎአዬሶንኮ ሰገ።<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">ቶሞንኮ ላማ ኦፋራሜራኮክ ፋራማኖ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ. 10፡5-15</ref>፤ <ref loc="MRK 6:7-13">ማር. 6፡7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>የሱሳ ቶሞንኮ ላማ ኦፋራመራን ራቶ ኡመረ ዱርሳ ዱባ ጎጎቤስናዉን ማር ኦሮክ ሀዉኣምኮና ጎጎፋይስናዉን ሁናና ኦዶናት እሶን ስሰ። <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>አደና ዎኖናት ካዋ ጎጎላላብራዉና ካሀዉአማሮ ጎጎፋይስናዉን እሶ ፋረ፤ <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>ሃና አመ፤ “ራክስኑን ዳማ ጎሌተ፥ ሽለ ጎሌና፥ ባቦና ጎሌ፥ ማራጋደ ጎሌ፥ ካካለ ካኢግልሳታን ሳርስ አባታኖ ላኮዶትሳሮ። <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>ሀሱ ማማንኮ ታበታን ጌግን ሆራርጀ ካኮታብቴታን ካማካዮ ምኒና አዳላየን። <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>ሀሴ ካታማኮክ እባዶና እስን ሀቆጳኖን ሄስረ ካታማትሶ ኢሰን ታኮበያታን፥ ሴርሳኖ እስኑን ጎጎሌሮን ካሉኬ ጎራ ሁርጉፋየንዴን ብያ።” <verse eid="LUK 9:5"/><verse number="6" style="v" sid="LUK 9:6"/>እሶና ኡሱ ማላቤንጉሬን ዎንጋላ ላላባ ባንኤ ዱባ ኩባሌሳጆል ፋይሳ ማማን ማማኒ ሮራ ግረን።<verse eid="LUK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>ካጋሊላ ኡልኮክ ሞት ሄሮዶሳና፥ ኡሱ ጎራታ ካሌሮ አየስ ዱባ ማለረ ካሌሮ አዬሲ ግርድአመ፤ ኣላንቲና እባዶ ኮኮ ካጣማቃራ ያንሳ ጎይኮ ኬራ አማ አዬሳ ግረ። <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>ኦካለና ኤላሳ ጎጎሙተሮ፥ ኦካለ አደነ ኦጣዎ ሄገሮልኮ ኮ ጎይኮ ኬራ አማ አዬሳ ግረን። <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>ሄሮዶሳና፥ “ካጣማቃሮ ያንሳ አን ማርግ ጎስሰረ ጎየራ፤ ሀያ፥ ኡሱ ጋራኬሳ ሃ አዬሳማ ካማላራ ሂክ እባዶት አዮያ?” አመ፥ የሱሳ እሊ ድን ዶታ ግረ።<verse eid="LUK 9:9"/></para>
  <para style="s1">የሱሳ እባዶ ኩማ ከን አምሰ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14፡13-21</ref>፤ <ref loc="MRK 6:30-44">ማር. 6፡30-44</ref>፤ <ref loc="JHN 6:1-14">ያን. 6፡1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>ኦፋራሜረና አባባተን ካኮኤመቴረን ጎራታ ካሌሮ ዱባ ሰገን፥ ኡሱና እሶ ኣተረ ቤተሳይዳ ታአማማቶ ካታማይ ካለት ባንኤ ሴተ። <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>ጎሳና ሂካ አዴሰጉረ ደቤሰሴተን፥ ኡሱና ቆጳተረ ዎኖናት ካዋኮክ ጋራ እሶን ሰጋ ግረ፥ ፋይና ካኮንዶትሳሮና ፋይሰ። <verse eid="LUK 9:11"/><verse number="12" style="v" sid="LUK 9:12"/>ኡል ሄመን ሊን ላ ግራን፥ ቶሞንኮ ላማ ኡሱ ቶስ ጋባላሜረን፥ “ካኮግና ኡል ቃሉላቶክ ማንኮሌ ማራን፥ ጎሳ ኡሱ ጎቦቢ ቃማነ ካግሮ ማማን ቶስ ሴይሬን ባቦ ማንኮኢምናራና ታባሪሳኖ ባንኤ ጎጎዶታራዉን ጋፋር” አመን። <verse eid="LUK 9:12"/><verse number="13" style="v" sid="LUK 9:13"/>የሱሳ አደ፥ “ካአምራን እስንዋ እሶን ስሳ አመ። እሶና፥ ሂካ ጎሳ ዱባን ካሌራ ባቦ ሴይነ ጎኢምነ ኳሬ፥ ኖን ካግራ ባቦ ከንኮና ኩኑኡብ ላማኮ ላኮሮራሮ” አመን። <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>ኩማ ከን ካሌራ ባባር ኤሰ ግረ። የሱሳና ኡሱኮ ኦአጋልሳታራነ፥ “ጎሳ ኮንቶም ኮንቶሚ ቤሳ ሀማጺሳ” አመ።<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>ኡሱኮ ኦአጋልሳታረና ጎጎሰጋመሮ ማለ እባዶ ጎጎሀማጽሮን የሌን። <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>የሱሳና ባቦ ከና ኩኑኡብ ላማና አበረ ዳሩር ቶስ ኤለዴ ዲያ ዋ ጋላቴረ፥ ኤብሰ ኣተረ ጎሳዉን ሆረ ጎጎሮርስራዉን ኡሱኮ ኦአጋልሳታራዉን ስሰ። <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>ዱባና አመን ባራረን፤ ኡሱኮ ኦአጋልሳታራና እሶኮ ታሄሰቶ ሀንባ ዱጉድ ቶሞንኮ ላማ ምግ ኬሴን።<verse eid="LUK 9:17"/></para>
  <para style="s1">ጴጢሮሳ የሱሳ ክርስቶሳ ካፋይሳሮ ላኖ አቶቴ</para>
  <para style="r">(<ref loc="MAT 16:13-19">ማቶ. 16፡13-19</ref>፤ <ref loc="MRK 8:27-29">ማር. 8፡27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>ኤሰኮ አባባተረ የሱሳ ካለ ኤባታ ግረ፤ ኡሱኮ ኦአጋልሳታረና ኡሱ ቶስ ኤመተን፤ ኡሱና፥ “ጎሳ እን አዮያ አማራ?” አመ ሆሳተ። <verse eid="LUK 9:18"/><verse number="19" style="v" sid="LUK 9:19"/>እሶና፥ “ኮኮ ካጣማቃሮ ያንሳ፥ ካካለ ኤላሳ፥ ኩክ አደ ካሆሬ ካሄገሮልኮ ኮ ጎይኮ ኬራ አማራን” አመን። <verse eid="LUK 9:19"/><verse number="20" style="v" sid="LUK 9:20"/>የሱሳና፥ “እስን አዴን እን አዮያ አማታን?” አመ። ጴጢሮሳና፥ “አት ክርስቶሳ ካፋይሳቶ ዋይ ካአሳባንተቶታ” አመ አባበ። <verse eid="LUK 9:20"/><verse number="21" style="v" sid="LUK 9:21"/>የሱሳ ሂካ ማዮና ጎጎአዬሶንኮ አታይሰ ሰገ። <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>አደና፥ “ኤረ ካእባዶ ራኮ ታሞጋን አታይን ዶትሳራ፤ ኡሱማሌ ጃርሶለይ፥ ቱቃሞኮክ ዎይቻልና ሴራ ኦአጋልስሳራን ዶሌ ዲዳምናራ ጎይናራ፥ ታሴድ አርና ጎይኮ ክናራ” አመ።<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>ኤሰኮና ዱባዉን፤ “እን ዴበ ሰሰዪን ካዶታታራ ማዮና ጎግረ እስኦቴሳ ሀካካተ፤ ማስቃሊቴሳ አርጌቶ ስዳይጉረ እን ዴበ ሀሰሴቶ። <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>ሙን ጎአንቴን ኔፎቴሳ ፋይሳይን ካዶታታራ ዱባ ባሳታራ፤ ኔፎቴሳ እን አመረ ካባሳታራ አደ ፋይሳታራ። <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>እባዶ አላም ዱባ ዎረኤ ጎሄላተ ኔፎ አድ ጎባሳተ ጎርቱን ጎሀንቂሳተ ላኦ መታ? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>ማዮና እዬና ሃፉራኬይ ጎሙሌ፥ ኤረ ካእባዶ ካባጃቴሳና ኣቦኬሳት ካባጃ ኡሱማለና ቁሉክ ኤርግቻኮት ካባጃ ካኮኤሜተ ጎራታ ሙልናራ። <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>አን ሩምና አማራ፤ ህታኒ ኦአሌራን ኦሮኮ ዎኖናት ካዋ ሀንዴኖን ካጎኖን እባዶ ግራ” አመ።<verse eid="LUK 9:27"/></para>
  <para style="s1">ምዲ ታየሱሳ ኢግልሳማኖ</para>
  <para style="r">(<ref loc="MAT 17:1-8">ማቶ. 17፡1-8</ref>፤ <ref loc="MRK 9:2-8">ማር. 9፡2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>የሱሳ ሂካ ታኮአየሰረ አሪ ስዴድኮ አባባተረ ጴጢሮሳ፥ ያንሳና ያይቆባ ኣተረ ኤባይን ዎዳም ቶስ ቤ። <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>ኤቢ ጉት ግራን ሆረቴሳ ኢግልሳንተ፤ ሳርስና ሀንቃ ኣን ሀንቃየ ጉማራ ሌ። <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>ጎርሰዋ እባዶጃ ላማ፥ እሶና ሙሴና ኤላሳ ኡሱነ ዎታ አዬሳ ግረን፤ <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>ካባጃ ሙቴረን፥ ኢየሩሳለም ሊን ካግሮ ሂካ አላምኮ ጎይኬሳክ ጋራ አዬሳ ግረን። <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>ጴጢሮሳና ዎታ ኦግሬዉን አደ ሁዱሮ ኢልኦ እስላተደ ሁዱረን ግረን፤ ካኮናባዳሬን ጎራታ ካባጃቴሳ ኡሱነ ዎታ ኦአሌራን እባዶጃ ላማ ዴን። <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>እባዶጃና የሱሳኮ አሳባሜነ ሴታ ግራን፥ ጴጢሮሳና፥ “ጎታኬ፥ ህታኒ ግርነዋ ኖን ካእዳንክየ፥ ሃንሱን ዳሰ ሴድ ማዳርና፤ ቶ ኩዬን፥ ቶ ሙሴን፥ ቶና ኤላሳን ልናታ” አመ፤ ኡሱ ኡሱን ካአዬሳረና ላኮአዴሳረ።<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>ሂካና አዬሳ ግራን ዱማንቻ ኤመተረ እሶ ሆጎግሰ፤ ዱማንቻ ቶስ ካኮታባሬን ጎራታ አብሳተን። <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>ዱማንቻ ኦሮና፥ “አን ካአሳባየራ ኤረክ ሂካያ። ኡሱና ማላ” ታአማታ ያየ ማልሳንተ። <verse eid="LUK 9:35"/><verse number="36" style="v" sid="LUK 9:36"/>ያየና ካኮማልሳንተተ ጎራታ የሱሳ ካለ ቤረ ሙተ፤ ኡሱኮ ኦአጋልሳታረና አየስ ዎዳናታትሶይ አባተን ኳሬ ካዴራን አየስ ኡሱ አልማይ ማዮና ላኮአዬሴራን።<verse eid="LUK 9:36"/></para>
  <para style="s1">የሱሳ ባቲክ አያና ካኮግረ ኡኑ ፋይሰ</para>
  <para style="r">(<ref loc="MAT 17:14-18">ማቶ. 17፡14-18</ref>፤ <ref loc="MRK 9:14-28">ማር. 9፡14-28</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>ታላም አሪ እሶ ዎዳምኮ ካኮዳጋሬን ጎራታ፥ ካሞጋን ጎሳ ኤመተረ የሱሳነ ዎታ ኤሰለ። <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>ሀሱ ጎራታ ጎሳ ኦሮኮ እባዶት ኮ ያየ ጦቂሰረ፥ “ካአጋልስሳቶ፤ እዬን ካግራ ኤረ ኡሱ ካላል ማንኮሌ ማራን ኤረኬ አት ጎጎዴቶ ኤባታራ። <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>ባቲክ አያና ጎኬሮ ደራኣ ኦካራ፤ ሳንባ ጉድሳ ኡለ ቦጫራ፤ ሚራኣ ካኮጌግስሮ ጎራታ ራኮ ታንጅን ኢሳጋራ፤ <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>ኩኮ ኦአጋልሳታራን ባቲክ አያና ኡሱኮ ጎጎቤስራዉን ኤባየ፤ አየሱን ጎአመን ላኮእሶ ዳንዴራን” አመ። <verse eid="LUK 9:40"/><verse number="41" style="v" sid="LUK 9:41"/>የሱሳና፥ “አማኖ ካልት ታዎጫጫንተ አላታን፥ ሀጌ ታ ጌሮን እስኔ ዎታ አን ግርናራ? ሀጌ ታ ጌሮን ኦብስናራ?” ኤሰኮ እባዶትነ “አላ ኤረካ ሂታራ ኬን” አመ። <verse eid="LUK 9:41"/><verse number="42" style="v" sid="LUK 9:42"/>ኡኑ ኤመቶ ጉት ግራንቲ ባቲክ አያናና ኡል ሉጉደረ ኡለ ቦጬ፤ የሱሳ ጎአመን ባቲክ አያናና ሀድሰረ ኡኑ ፋይሰ፤ ኣቦኬሳን አባበ ስሰ። <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>እባዶ ዱባና ሁና ካዋይ ማመ።</para>
  <para style="s1" vid="LUK 9:43">የሱሳ ጎይኬሳክ ጋራ ካላም አዬሰ</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">ማቶ. 17፡22-23</ref>፤ <ref loc="MRK 9:30-32">ማር. 9፡30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">ኡሱ ካፈለሮ ዱባና እባዶ ዱባ ማማ ግራንቲ፥ የሱሳ ኡሱኮ ኦአጋልሳታራነ፥ <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>“ሂካ አን ካሰጋሮ አየስ ዱዶ ጎጎኢሎኖንኮ፤ ኤረ ካእባዶ ሮር ገነ ታእባዶይ ስሳምናራ” አመ። <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>እሶ ጎአመን ሂካ አየስ ላኮአዴሰረን፤ ጎጎሻዶንኮ አየስ ጎላተ ግረ፤ ኡሱ አባብ ሆሳይና አብሳተን።<verse eid="LUK 9:45"/></para>
  <para style="s1">ዱባንኮ ካሮራራ አዮ ሌራ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ. 18፡1-5</ref>፤ <ref loc="MRK 9:33-40">ማር. 9፡33-40</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>እሶ ኦሮኮ አዮ ሮራሮ ኡሱኮ ኦአጋልሳታራን ኦሮ ዶጋማ ኬተ። <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>የሱሳ ዎዳናታትሶክ ያዳ አዴሰረ፥ ይትት አበጉረ እስኦቴሳ ዶሌ ኣልሰ፤ <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>ሃና አመ፥ “ሂካ ይትት መገኬይ ካቆባታራ ማዮና ጎግረ እን ቆጳታራ። እን ካቆጳታራ አደ እን ካፋረሮና ቆጳታራ። እስን ኦሮኮ ካየራታራ ኡሱ ዱባንኮ ሮራራ።” <verse eid="LUK 9:48"/><verse number="49" style="v" sid="LUK 9:49"/>ያንሳና፥ “ጎታኬ፥ እባዶት ኮ መገካይ ዱርሳ ቤሳ ግራንቲ ዴነ፤ ኖኔ ዎታ ሌ ዴበ ማንኮሰሰኖን ማራን ትርን ሄንደ” አመ። <verse eid="LUK 9:49"/><verse number="50" style="v" sid="LUK 9:50"/>የሱሳና አሮትርቴን፥ እስን ዱባ ካዲዶን ኡሱ እስኔ ዎታ ግራ አመ።<verse eid="LUK 9:50"/></para>
  <para style="s1">ካሳማርያ እባዶ የሱሳ ዲዳኖ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>የሱሳ ዳሩር ቶስ ካኮብናረ ጎራታ ካኮጋባላማረ ጎራታ ኢየሩሳለም ቶስ ሴይን ጎሳተ ኬ። <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>ኡሱኮ ጣይሰ ኦሀንዳረን ኤሰራ ፋረ። እሶና ኤካይን ካዶትሳሮ ጣይ ኡሱን ኤካስን ኮ ካሳማርያ ማማን ቶስ ታቤን። <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>ጎሳ አደ የሱሳ ኢየሩሳለም ቶስ ሴታኖ ማንኮአዴሰረ ማራን ኡሱ ላኮቆጳተ። <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>የሱሳኮ ኦአጋልሳታረና ያይቆባና ያንሳና ሂካ ካኮደያረን ጎራታ፥ “ጎታ፥ [ኤላሳ ጎጎአዬሰሮ]<note caller="+" style="f"><char style="fr" closed="false">9፡54 </char><char style="ft" closed="false">ካሆርኮ ማጻፋሊ ላኮግሮ</char></note> ኤለን ዳሩርኮ ዳግደ ጎጎባሶን ኖ ጎጎአጃጂኖን ፈኢ ስስናታ?” አመን። <verse eid="LUK 9:54"/><verse number="55" style="v" sid="LUK 9:55"/>የሱሳ አደ ካምባል አመረ ሀድሰረ “እስን [ምስክ አያናኮታን ላኮካሳን]፥ ኤረ ካእባዶ ካኮንኤመተራ ኔፎ ታእባዶ ፋይሲንያ ኳሬ ባስን ላኮዮ” አመ። <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>ኤሰኮ ኬንጉረነ ማማን ካካለና ሴተን።<verse eid="LUK 9:56"/></para>
  <para style="s1">የሱሳኮ ካአጋልሳታሮ ላኖ ታሙርስሳሮ ሙራ</para>
  <para style="r">(<ref loc="MAT 8:19-22">ማቶ. 8፡19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>ራድ ሴታ ግራን እባዶት ኮ ጋባላመረ፥ “አት ማንኮሰያቶ ዱባ አን ኩ ዴበ ሰሴይናራ” አመ። <verse eid="LUK 9:57"/><verse number="58" style="v" sid="LUK 9:58"/>የሱሳና፥ “ጌዳላል ጉምቢ አባ፥ ክምብርጆልና ምን አባ፥ ኤረ ካእባዶ ጎአመን መተ ካኮታብሳሮ ዱዶ ላኮአቦ” አመ። <verse eid="LUK 9:58"/><verse number="59" style="v" sid="LUK 9:59"/>ካካለ እባዶትነ አደ፥ “እን ዴበ ሰሴ” አመ። እባዶትና፥ “ጎታ፥ ጣይ ሴይረ ኣቦኬ ቃማላሮ” አመ። <verse eid="LUK 9:59"/><verse number="60" style="v" sid="LUK 9:60"/>የሱሳና፥ “ካጎይናራ ካጎየሮ ጎጎቃማላሮ ኢሳጋ፤ አት ጎአመን ሴጉዴ ዎኖናት ካዋ ላላቢ” አመ። <verse eid="LUK 9:60"/><verse number="61" style="v" sid="LUK 9:61"/>ካካለ እባዶት አደ፥ “ጎታ፥ ዴበ ሰሴታን ሰሴይናራ፤ አየሱን ጎአመን አባባይረና ሆራርጀ ምንኬክ እባዶ ኖጎዳ ግራ ጎጎአምሮ ኢን ፈኢ ስስ” አመ። <verse eid="LUK 9:61"/><verse number="62" style="v" sid="LUK 9:62"/>የሱሳ አደ፥ “እራ ኦቲን ማጣ አበረ ሃርዴ ካዎቻራ እባዶ ዎኖናት ካዋዉን ካዶትሳሮ ላኮዮ” አመ።<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">የሱሳ ቶዶባታምኮ ላማ ኡሱኮ ኦአጋልሳታራን ፋረ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>ኤሰኮ አባባተረ ጎታ ካካለ ቶዶባታምኮ ላማ እባዶ አሳበጉረ ሹመ። ማንኮሴታሮ ካታማና ባንኤ ዱባ ኡሱኮ ጎጎሆረሀይናዉን፥ ላማ ላማ የለረ ፋረ፥ <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>ሃና አመ፥ “ካፈላምራ ካም ካሞጋንያ፥ ኦፈላራን አደን ኡጫርያን። ሃንሱን ካምኮክ ጎታ ኦፈላራን ታካም ባንኤ ጎጎፋሮን ኡሱ ኤባየን። <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>ጎርታ ሴዬን፥ እዳድ ኣን ህዬይ ኦሮ እስን ፋርናራ። <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>ኮሮጆ ሽለ፥ ጎርቱን ከፈሮ አሮአባቴን፤ ማዮነና ራድ ኖጎዳ አታ አሮአዳላቴን። <verse eid="LUK 10:4"/><verse number="5" style="v" sid="LUK 10:5"/>ምን ካማካዮና ጎታብተን ጣዴን፥ ኖጎዳ ሂካ ምኑን ሀሌቶ አማ። <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>ኖጎዳ ካጌላታራ እባዶ ሀሴ ጎግረ፥ ኖጎዳታትስን ታብቶዋ። ጎርቱን ኖጎዳታትስን እስኑንዋ አባባይናታ። <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>እስኑን ሆረ ካሮርሰን ዱባ አማና ጣማና ኡሱ ምኒ ሀማጻ፤ ካፈላታራ ዳሞዛ ሄላይን ዶትሳራ። ምን ኮኮ ካካለ ቶስ አሮማራሙርቴን። <verse eid="LUK 10:7"/><verse number="8" style="v" sid="LUK 10:8"/>ማኤት ካታማ ቶስ ጎታብቴና እባዶ እስን ጎቆባተ፥ ካሆረ ሮርሰን አማ። <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>ኤሰ ሀዉኣማ ኦግራን ፋይሳ፥ ‘ዎኖናት ካዋ እስን ቶስ ጋባላመራ’ አማ። <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>አየሱን ጎአመን ካታማ ቶ ቶስ ታባዴነ እስን ጎቆባታናዋተን፥ ራድ ብያዴነ ሃ አማ፤ <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‘ሉቃኦታን ጉት ካግሮ ካታማትስንክ ጎራ ራድ ብነ እስን ሴርን ሁርጉፋይናና፤ አየሱን ጎአመን ዎኖናት ካዋ ጋባላማኖ ሂካኒ አዴሳ።’ <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>ታሙርት አሪ ኤሰ ካታማኮ ሶዶምዉን ሙሮ ፉፉዳቶዋ አማራ።”<verse eid="LUK 10:12"/></para>
  <para style="s1">አማኖ ዋቲ ታዎቃሳንተቶ ካታማ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>“ኣኔ ኩን ኮራዝ! ኣኔ ኩን ቤተሳይዳ! እስኒ ካፈላመረ ባሳ ጢሮስና ስዶና ካፈላመሮ ሊ ግረዋ፥ ህጋኖ ካጋንባል ሳርስ ሳርሳይሬን፥ ቡሉሎ ካካባይሬን ጩቦኮ ጉላ ጋል ግራነዋ። <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>አየሱን ጎአመን ዋ ታኮፍርድሮ አሪ እስንኮ ሮር ጢሮስና ስዶናን ሙሮ እሶን ፉፉዳቶዋ። <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>ተአት ቅፍረናሆም፥ ዳሩር ቶስ ጦቂ ጦቂ አንተ? ቦዋ ኦርድ ኢናታ።<verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>“የሱሳና ኡሱኮ ኦአጋልሳታራነ እስን ካማላራ እን ማላራ። እስን ካቆጳኖን እን ላኮቆጳታሮ፥ እና ካቆባኖን እን ካፋረሮና ላኮቆባታሮ።” <verse eid="LUK 10:16"/><verse number="17" style="v" sid="LUK 10:17"/>ቶዶባታምኮ ላማና ገጌላታ አባባተረን፥ “ጎታ፥ መገካይ ዱርሳ ዱዶ ኖን አጃጃመ” አመን። <verse eid="LUK 10:17"/><verse number="18" style="v" sid="LUK 10:18"/>የሱሳ፥ “ጻላየ ሀንቃ ኣን ዳሩርኮ እያ ግራን አን ዴ። <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>ጎርታ ሀበሳና ጫጫቦ ጎጎዳዳርታዉን፥ ዲናኮክ ሁና ዱባ ጉት ኦዶናት አን እስኑን ስሰራ፤ እስን ካምርራ አየስ ኮና ላኮግሮ። <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>ሀሌዎ ኳሬ ካሜላን አያና ማንኮአጃጃመሮ ማራን አሮገገላተን፤ መገክስን ዳሩሪ ማንኮጻፋመሮ ማራን ኡሱ ገጌላየን” አመ። <verse eid="LUK 10:20"/><verse number="21" style="v" sid="LUK 10:21"/>ሀሱ ጎራታ የሱሳ አያና ቁሉክ ገገላተረ፥ ካዳሩረና ካኡሌ ጎታ፤ ኣቦኬ፤ ሂካ ዱባ ቃሮሌኮና ኦካሳንኮ ስያምሰደ ይሱን ማንኮቱሰ ማራን አን ኩ ጋላታራ፥ እ ኣቦክ፥ ሂካ ፈልን ታኢዳን ፈኢታ ሌተታ። <verse eid="LUK 10:21"/><verse number="22" style="v" sid="LUK 10:22"/>“ካመን ዱባ ጉት ኦዶናት ኣቦኬ ዶለኮ ኢን ስሳመራ። አደና ኤረ አዮዮ ኦዶ ኳሬ ካማላበራ ካካለ ላግሮ። ኦዶ አዮዮና ኤረ ኳሬ፥ ኤረና ኦዶ ቱስን ፈኢ ካኮንስሳሮ ኳሬ ኦዶ ካማላብራ ላግሮ።” <verse eid="LUK 10:22"/><verse number="23" style="v" sid="LUK 10:23"/>ኡሱኮ ኦአጋልሳታራን ቶስ ካምባል አመረ እሶን ካለ ሃ አመ፥ “እስን ካደያታን ኦደያራን ኢልኦ ኦሶማሳመንያን። <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>ካሞጋን ካሄገሮልና ዎኖላል እስን ካደያታን ድን ዶተረን ላኮዴናን። እስን ካማልቴታን ማልን ዶተረን ላኮማለራን” አመ።<verse eid="LUK 10:24"/></para>
  <para style="s1">ካእዳንክ ካሳማራው እባዶት</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>ሂክማ አሪ ቶ፥ ሴራ ካሙሴ ካካሳናየ ኮ የሱሳ ጫፍን ዶተረ፥ “ካአጋልስሳቶ፥” ጅሩ ጅሮማክ ግር ኤልን “መ ፈላ?” አመ። <verse eid="LUK 10:25"/><verse number="26" style="v" sid="LUK 10:26"/>የሱሳና፥ “ሴራይ ካጻፋመራ መያ? ምሲ ናባባታ?” አመ አባበ። <verse eid="LUK 10:26"/><verse number="27" style="v" sid="LUK 10:27"/>እባዶትና አባበረ፥ “ ‘ጎታ ሄዶካ ታአማጋንተ ዎዳናኮ፥ ታአማጋንተ ኔፎ፥ ካአማጋመ ሁናኮና ታአማጋንተ ቆፋኮ ጌላ፥ ኦላታ እስኦታ ማለ ጌላና’ ” አማራ አመ። <verse eid="LUK 10:27"/><verse number="28" style="v" sid="LUK 10:28"/>የሱሳና፥ “ልክ አባብቴታ፥ አትና ኡሱማሌ ፈል፥ ጅሩ ጅሮማክ ግር ግርናታ” አመ። <verse eid="LUK 10:28"/><verse number="29" style="v" sid="LUK 10:29"/>እባዶትና እስኦቴሳ ቁሉክ የላዪን ዶታተረ፥ “አሚና ኦላት አዮታ” አመ። <verse eid="LUK 10:29"/><verse number="30" style="v" sid="LUK 10:30"/>የሱሳና ኡሱን አባበ፥ “እባዶት ኮ ኢየሩሳለምኮ ኢያርኮ ቶስ ዳጋ ግራን ገነ ታሽታይ እዬ። ሳርስና ቃሬን ቦጨን፥ ጎይ ህኢ ጉት ሉጉደን ሴተን። <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>ቱቃሞ ኮ ደራኣ ሀሱ ራንደ መተጋማቶ ሄገልዴ ዳጋ ዴጉረ ፋክ አመ ሮረ። <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>አደና ዎዩት ኮ ኤሰ ባንኤ ጎጎጌይ ዴጉረ ኡሱና ፋክ አመ ሮረ። <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>ኮ ሳማራውት ጎአመን ሉክታሮራሮ ሴታ ግራን እባዶት ታኮግሮ ባንኤ ጌ። ካኮደያረ ጎራታ ነኔኤይሳተ፥ <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>ጋባላመረ ሜጋል ጉት ዛይቲና ካዎይኒ ጣሞ ክበረ ሽየ፤ ታቴሳ ደሜር ጉት ካየጉረ ማርት ካኮባራቶ ምን ጌሰ። ኤሴና ካርካሬ። <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>ታላም አሪ ጣጋራ ላማ ቤሰረ ማርት ካኮባራቶ ምንኮክ ኦዶምኔቱን ስሰጉረ፥ ‘ሂካ እባዶት ሀዳራ ዴና። ሂካኮ ካንጂን አት ካቤሳቶ ማራጋደ አን አባባታ ኩን ሙሮዋ’ አመ።<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>“ጎርታ፥ ሂናኣ ሰድኮ ሽቶሌ ገነ ካኢየሮ እባዶትን ኦላ ካሌረ ኤክ ኣን ላራ?” አመ። <verse eid="LUK 10:36"/><verse number="37" style="v" sid="LUK 10:37"/>ሴራ ካካሳናየና “ካነኔኤይሳተሮዮላ” አመ።</para>
  <para style="p" vid="LUK 10:37">የሱሳና፥ “አትና ሴዴ ኡሱማሌ ፈል” አመ።<verse eid="LUK 10:37"/></para>
  <para style="s1">የሱሳ ካማርታና ካማይራመ ምኒ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>የሱሳና ኡሱኮ ኦአጋልሳታራነ ዎታ ራ ሰሴታ ግራን፥ ማማን ኮ ታበ። ማርታ ታአማንተቴ ቶ ሄለልትቲና ምን ካክሴይ ኡሱ ቆጳተ፤ <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>ኤሰን ማይራመ ታአማተተ አባ ግቴ። ማይራመና ሃፉራ ማላ ታጎታይ ሉኪ ሄገሊ ሀማጽተ ግቴ። <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>ማርታ ጎአመን ፈሎ ጂናኒ ጎራታ ባሳታ ግቴ፥ ኡሱ ቶስ ጋባላንተደ፥ “ጎታ፥ አባት ፈሎ እን ካላሉን ሉጉድደ ጎሀማጽቶ ጫልአንተ ድያታ? እን ጎጎጋርጋርቶ ሰግቶላ” አንተ። <verse eid="LUK 10:40"/><verse number="41" style="v" sid="LUK 10:41"/>ጎታ ጎአመን አባበረ፥ “ማርታ፥ ማርታ፥ አት ካሞጋን አየሱን ጫናቃማታ፥ ጃራንጁራታ። <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>ካዶትሳራ ጎአመን አየስ ኮ ካላልያ፥ ማይራመ ታኢዳን ምና አሳባተታ፤ ህክና ኤሰኮ ላኮአታምሮ” አመ።<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">የሱሳ ካአጋልስሰሮ ኤብ</para>
  <para style="r">(<ref loc="MAT 6:9-13">ማቶ. 6፡9-13</ref>፤ <ref loc="MAT 7:7-11">ማቶ. 7፡7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>አሪ ቶ የሱሳ ባንኤ ቶይ ኤባታ ግረ። ኤብና ጎጎጉድሴ፥ ኡሱኮ ኦአጋልሳታረንኮ ኮ፥ “ጎታ፥ ያንሳ፥ ኡሱኮ ኦአጋልሳታረን ኤብ ጎጎአጋልስስሮን አትና ኤብ ኖ አጋልስስ” አመ።<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>የሱሳና ሃ አመ፥ “እስን ጎአመን ሃ አማ ኤባየን፥</para>
  <para style="q1" vid="LUK 11:2">“ ‘ኣቦካን፥</para>
  <para style="q1" vid="LUK 11:2">ቁሉክ መገካካ ሀካባጃመ፥</para>
  <para style="q1" vid="LUK 11:2">ዎኖናትካ ሀኤመቶ።<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>ካህታርቴ ባቦካን ህታር ኖን ስስ።<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>ባስካካን ሀሄሶ አም ኖና ኖ ካሚረኤሮ ሀሄሶ ጎጎአማኖ፥ አት ባስካን ሀሄሶ አም፥ ጫፍት ኦሮ ኖ አሮታብሰ፥ ካሜላንኮ ኖ ሃስ ኳሬ።’ ”<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>አደና ሃ አመ፥ “እስንኮ ኮ ካጌላታራ ጎግረ፥ ሄመን ጠኤ ኡሱ ቶስ ሴይረ ካገላታቶኬ! ባቦ ብጠ ሴድ ኢን አምአይስ፤ <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>ሳት ኮ ራኮ ኤመተረ ኡሱ ሆረ ካካይራ ባቦ ኮና ኢን ላኮግሮ” አመ ኤባተ ጎአምኔ፥<verse eid="LUK 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7"/>“ምኒ ኦሮ ካግሮና፥ ‘አሮራክሰ! ኡፋና ጩፋመራ፥ ይስክና ኢነ ዎታ ሁዱረራ፥ ጎርታ ኪጉረ ኩን ስስን ላኮዳንዳሮ’ አመ አባባራ? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>ኡሱ ካጌላታሮ ላኖይ ኪጉረ ጎስሳናዋተና ሱረ፥ ኤባተ ማንኮጢበሮ ማራን ካዶትሳሮ ዱባ ስሳራ።<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>“ሃንሱን አን እስኔ ሃ አማራ፥ ኤባየን ስሳምሮዋ፥ ዶታዬን ሄላታንዋ፥ ኡፋና ባባሳየነ ባናምሮዋ። <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>ኣላንቲና ካኤባታራ ዱባ አታታራ፥ ካዶታታራና ሄላታራ፥ ኡፋ ካባባሳታሮና ባናማራ። <verse eid="LUK 11:10"/><verse number="11" style="v" sid="LUK 11:11"/>እስን ኦሮ ኦዶ ሌ ግራን ኤረ ኩኑኡብ ጎኤባተ ሀበሳ ካስሳራ ግሮ? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>ጎርቱን ቡጳ ጎኤባተ ጫጫቦ ስሳራ? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>እስን ኦሜላን ሌተን ግራን ይስክስኑን ካእዳንክ እላቦ ስሳኖ ጎማላብቴን፥ ካዳሩረ ኣቦክስን ሀያ ኦኤባታራዉን አያና ቁሉክኮ ምሲ ሮርስ እስኑን ስሳናዋታራ!” አመ።<verse eid="LUK 11:13"/></para>
  <para style="s1">ጎታ የሱሳና ዱርሳኮክ ዎይቻ</para>
  <para style="r">(<ref loc="MAT 12:22-30">ማቶ. 12፡22-30</ref>፤ <ref loc="MRK 3:20-27">ማር. 3፡20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>አሪ ቶ የሱሳ እባዶትኮ ህኢ ዱድሰ ካአበረ ባቲክ አያና ቤሳ ግረ። ባቲክ አያና ካኮቤ ብያረ ጎራታ ህኢ ካዱደረ እባዶት አዬሰ፥ ጎሳና ማመ። <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>ኮኮ አደ፥ “ዱርሳኮክ ዎይቻ፥ ካሌሮ ብኤልዘቡልኮክ ሁና ዱርሳ ቤሳራ” አመን።<verse eid="LUK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16"/>ኮኮ አደ ጫፍን ዶተረ ዳሩርኮ ኡሱ ማላታ ጎጎቱስሮ ኡሱኮ ዶታ ግረ። <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/>የሱሳ ጎአመን ቆፋትሶ አዴሰረ ሃ አመ፥ “እስ እስኦሮ ካለካለ ካበያራ ዎኖናት ዱባ ባይናራ፥ እስ እስኦሮ ካለካለ ካበያራ ምንኮክ እባዶ ዳርአምናራ። <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>ጻላዬና እስ እስኦሮ ካለካለ ጎቤተ ዎኖናትክሴ ምሲ አታራ? ዱርሳ ዱርሳኮክ ዎይቻ ቤሳራ አንቴን አዬሳታን። <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>ጎርታ አን ዱርሳ ካኮቤሳራ ዱርሳኮክ ዎይቻይ ጎሌ፥ ይስክስን አድ አዮ ቤስናራ? ሃኑን እሶ እስን ጉት ኦፍርዳራን ልናራን። <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>አን ጎአመን ዱርሳ ካኮቤሳራ ሁና ካዋይ ጎሌ፥ ዎኖናት ካዋ እስን ቶስ ኤመታኖ አዴሳ።<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>“ካአቲ እባዶት ሁ ካጀረነ ጎጎዶትሳሮ ሞዋተረ ምንኬሳ ጎኦራተ፥ ኡራዎ ኦቴሳ ኖጎዳ ኦራማራን። <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>አየሱን ጎአመን ካአቲ ኡሱኮ ካሮራራ እባዶት ኤመይረ ባስረ ጎአዎደ አብዳተ ካግረ ሁ ካጀሬነኮክ ሞዋኖ ፉርስሳራ። ኦቦጃመረን ኡራዎ ኣተረ ካካለቱን ሄዴዳራ።<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>“እነታ ካሌኖን እን ዲዳራ፤ ኢነታ ካኩኩይሳኖና ዳርአታራ።<verse eid="LUK 11:23"/></para>
  <para style="s1">ባቲክ አያና እባዶ ቶስ አባባይ ታባኖ</para>
  <para style="r">(<ref loc="MAT 12:43-45">ማቶ. 12፡43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>“ባቲክ አያና እባዶኮ ካኮቤሮ ጎራታ ፎልሲ ዶታታ በከ ካልት ባንኤ ካፋፋራ፤ ሀሄላኖን ጎሄስሮ፥ ካኮቤሮ ምን ቶስ አባባይናራ አማራ። <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>ጎአባባሮና ምን ሻሻካራመ ካኤካተሮ ሄላታራ። <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>ኤሰኮ አባባተ ሴተረ ካካለ ኡሱኮ ኣሎ ካሜላን ዱርሳ ቶዶባ ኣተ ኤመታራ፤ ታበረ ኤሴና ግራራ፤ ሀሱ እባዶትን ታሆራርጄኮ ሮር ካሃረ አየስ ካሜላን ልናራ።”<verse eid="LUK 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>የሱሳ ሂካ አዬሳ ግራንቲ፥ ጎሳ ኦሮኮ ሄለልትቲ ቶ ያየ ጦቂሰደ፥ “ኩ ታስደታ ገዴምና አት ኦኢላተታ ናሳሶ ኦሶማሳመንያን” አንተ።<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>ኡሱ አደ፥ “ኦሶማሳሜን ሃፉራ ካዋ ማለሬን ፈሎ ኦሀይሳራንያን” አመ።<verse eid="LUK 11:28"/></para>
  <para style="s1">ካዮናሳ ማላታ</para>
  <para style="r">(<ref loc="MAT 12:38-42">ማቶ. 12፡38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>ካሞጋን ጎሳ ኩኩማ ካኮሴታረ ጎራታ የሱሳ ሃ አማኖ ሀጋአበ። “ህት አላታን ታሜላንታ፥ ባሳክ ማላታ ዶታታ፥ አየሱን ጎአመን ካዮናሳ ማላታ ኳሬ ካካለ ማላታ ላኮስሳምናሮ። <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>ኣላንቲና ዮናሳ ካነኔዌ እባዶን ማላታ ጎጎሌሮን ኤረ ካእባዶ ህታ አላታኑን ማላታ ልናራ። <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>ኡል ካሄገለት ኦርዎኖ ታዋ ታፍርዳ አሪ ህታ አላታን ዎታ ኪደ ፍርድናታ። ኤሰ ታሶሎሞን ቃሩማ ማልን ኡልኮት ጋቾኮ ኤሜተታ። ሂክማ ሶሎሞንኮ ካሮራራ ህታኒ ግራ። <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>ካነኔዌ እባዶ ፍርዲ ታዋት አሪ ህታ አላታን ዎታ ኪጉረ እሶ ጉት ፍርድናራን። እሶና ካዮናሳ ላላባኖ ማሌረን ጩቦኮ ጉላ ጋሌራን፥ ሂክማ፥ ዮናሳኮ ካሮራራ ህታኒ ግራ።<verse eid="LUK 11:32"/></para>
  <para style="s1">ዳብ ካማሬ</para>
  <para style="r">(<ref loc="MAT 5:15">ማቶ. 5፡15</ref>፤ <ref loc="MAT 6:22-23">6፡22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>“ዳብ ሀንቃይሳተጉረ ጎላታት ባንኤ ጎርቱን ዳቾ ግርቢሳተ ሄገሊ ካካታራ ማዮና ላኮግሮ። ምን ካታባራ እባዶ ኢፋ ጎጎዴሮ ቦላንሶ ጉት ካታራ። <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>ማርካክ ኢፋ እልታታ፥ እልታታ ፋያሌሳ ጎሌተ ማር ዱባ ኢፋ ላራ፥ እልታታ ታሀዉአማቶ ጎሌተ አደ ማርካ ሙጉድ ላራ። <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>ሃንሱን ኩ ኦሮ ካግራ ኢፋ ሙጉድ ጎጎሌኖንኮ ኢስ ኦራ። <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>ጎርታ ማርካ ዱባ ኢፋ ጎሌና ሙጉድ ታሌተታ ታማረ ባንኤ ጎዋታንተ፥ ማር ዱባ ዳብ ዋኣመ ካሀንቃይሳሮ ግታክ ሀንቃራ።”<verse eid="LUK 11:36"/></para>
  <para style="s1">ካፋራሳው እባዶዉና ሴራ ኦአጋልስሳራዉን ኣኔ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23፡1-36</ref>፤ <ref loc="MRK 12:38-40">ማር. 12፡38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>የሱሳ አየስ ጎጎጉድሴ፥ ካፋራሳው እባዶት ኮ ኡሱ ዎታ ባቦ ጎጎአምሮ የሱሳ ኡማተ፥ ኡሱና ዎታ ታበረ ባቦ ኣምን ሀማጼ። <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>ካፋራሳው እባዶትና የሱሳ ባቦ አማኖኮ ሆረነ ሴራክሶክ ማለ ገነ ኣላና ዋት ካኮደያረ ጎራታ ሳደ።<verse eid="LUK 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39"/>ጎታና ሃ አመ፥ ግዳ እስን እባዶ ካፋራሳው ካቡርጩቆና ካሳን ጉት ሙጭሴን አልሳታን፥ ኦሮኦትስን ጎአመን ሳማኖና ሜላነይ ኦአማጋሜንያን። <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>እስን ጎዎሌ ካሳረ ካመጠራ ካኦሮና ላኮመጠሮያ? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>አየሱን ጎአመን ቡርጩቆ ኦሮና ያላኣይ ኦሮ ካግሮ ቤሳዴን ህየሳን ስሳ፥ ኡሱ ጎራታ ዱባና ሙጭ ካአመ ሌራ።<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>“እስን እባዶ ካፋራሳው አድ ኣኔ እስኑን፤ አኑጋኮና ጣሎተኮና ኡሱማሌ አካክልተ ዱባኮና ባርክንተ ቤሳታን። ጎሌና ካሩም ፍርዳና ዋ ጌላታኖ ዲዳታን። አየሱን ጎአመን ኣንክ ሀኢሶን ሂካ ፈልን ዶትሳረ።<verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>“እስን ፋራሳዊል ኣኔ እስኑን አይሁድኮክ ምን ካኤብ ካካባጃ ባርጩማ፥ ግያ ኦሮ ኖጎዳ ኣትን ዶታታን።<verse eid="LUK 11:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44"/>“እባዶ ሀማላቦን ጉት ካኮሰሴታሮ ካጎላተ ቃማል ኣን ማንኮላታን ማራን፥ ኣኔ እስኑን።”<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>ካሙሴ ሴራ ኦካሳንኮ ኮ የሱሳነ፥ “ካአጋልስሳቶ፥ ሃ ጎአየሶ ኖ ኢንጋማኖያ” አመ አባበ።<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>የሱሳና ሃ አመ፤ “እስን ሴራ ኦአጋልስሳታና ኣኔ እስኑን፤ እባዶ ስድን ታዳንዴኖን ታአቲ ስዳነ ስድሳታን፤ እስን መተክስኑን ፈሪና ዱዶ ላኮድናታን።<verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>“ኣቦጆላልክስን ካላጋዴራን ካሄገሮኮክ ቃማል ማንኮኤካሳታን ማራን፥ ኣኔ እስኑን። <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>ጎርታ አብጆላልክስኒዕ ፈሎ ኦአታይሳታን አቶጆልታን። እሶ ካሄገሮ ላጋዴን፥ እስና ቃማልክሶ ኤካሳታን። <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>ሃሱና ቃሩማ ታዋ ሃ አንተ፥ ‘ካሄገሮና ኦፋራመራን እስኑን ፋርናራ፥ እሶና ኮኮ ላጋድናናን፥ ካካለና ሆሮረናን፥’ <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>ሃንሱን ህታ አላታን አላም ታኮመጣመሮኮ ሀጋአበረ ካኡባተሮ፥ ካሄገሮኮክ ኢግ ዱባን ታሆሳምናቶታ። <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>ካኣቤላ ኢግኮ ሀጋአበረ፥ ካጃርሶና ምን ካኤብ ኦሮ ካኡባተሮ ካዛክራሳ ኢግ ታጌሮ ዶታማራ፥ እ አማራ፥ ህት አላታን ሂካኑን ታሆሳማቶታ።<verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>“እስን ካሙሴ ሴራ ኦካሳን ኣኔ እስኑን፥ ካማላባኖ ኡፋ ካኮባናራን ቁልፍ ባሰን ኣተታን፥ እስን መተክስኑን ላኮታብቴታን፥ ኦታብናራና ትርቴታን።”<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>የሱሳ ኤሰኮ ካኮበያረ ጎራታ፥ ሴራ ካሙሴ ኦአጋልስሳሬንና ፋራሳው ጎሜላን ዲዳና ሆስኒ ሆሳታ ጄጅሳኖ ሀጋአበን። <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>ህኢቴሳኮ ካብያሮ ሃፉራ ኡሱ አብን ጋዳ ግረን።<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">ካሴርሳሮና ካአታይሳሮ ሃፉራ</para>
  <para style="r">(<ref loc="MAT 10:26-27">ማቶ. 10፡26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>ሀሱ ጎራታ ኩማ ካሞጋኒ ካቶታምራ ጎሳ እስ እስ ታዳዳራሮ ጌግን ኩኩ አመ ግራን፥ የሱሳ ኡሱኮ ኦአጋልሳታራዉን ሃ አማኖ ሀጋአበ፤ “ፋራሳውልኮት ሜላነኮ እስኦትስን ኦራዬን፤ ህክና ኢፍሳዳናትያ። <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>ካሙቶን ካጎላተራ፥ ካአዴሳሞን ካስያመራ ኮና ላግሮ። <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>ሃንሱን እስን ሙጉድ ካአዬሳታን ዱባ ኢፋ ማልሳምናራ። እልፍኒ ኦሮ ነቤ ማርካ ካአዬሰታን ዲዳብ ሰጋምናራ።<verse eid="LUK 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>“ኦጌላታሮኦተ፥ አን ሃ አማራ፥ ሶ ካላጋዳሮ ኤሰኮ አባባይ አድ ኮና የልን ካዳንዴኖንኮ አሮአብሳቴን። <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>አየሱን ጎአመን እስን አብሳይን ካዶትሳሮ አን ቱስናራ፥ ካኮላጋደ ጎራታ ታባኖን ኤለኒ ሉጉድን ኦዶናት ካአቦ ዋ አብሳዬን። እ፥ ኡሱ አብሳዬን አማራ። <verse eid="LUK 12:5"/><verse number="6" style="v" sid="LUK 12:6"/>ክምብርጆል ከኖ ሳንትሚ ቶይ ላዳዳላማሮላ? ሀሌዎ ኳሬ ኤሰኮ ቶ ዱዶ ዋይ ዶሌ ላኮኢሎታማቶ። <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>መተ ካክስንኮክ ፊጣ ዱባ ካቶታመያ፥ ጎርታ አሮአብሳቴን። ካሞጋን ክምብርጆልኮ እስን ታሮራቶ ላኦ አብታን።<verse eid="LUK 12:7"/></para>
  <para style="s1">ክርስቶሳን አቶ ላኖ</para>
  <para style="r">(<ref loc="MAT 10:32-33">ማቶ. 10፡32-33</ref>፤ <ref loc="MAT 12:32">12፡32</ref>፤ <ref loc="MAT 10:19-20">10፡19-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>“የሱሳና አን እስኔ ሃ አማራ፥ እባዶ ሆረ እን ካአቶታሮ ዱባን ኤረ ካእባዶ አደ ኤርግቻ ካዋ ሆረ ኡሱን አቶትናራ። <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>እባዶ ሆረ እን ካካካታራና ኤርግቻ ካዋ ሆረ ካካምናራ። <verse eid="LUK 12:9"/><verse number="10" style="v" sid="LUK 12:10"/>ኤረ ካእባዶ ጉት ካየራስሮ ሃፉራ ካአዬሳራ ዱባ ሀሄሶ አማማራ፥ አያና ቁሉክ ካሀባራራ አደ ሀሄሶ ላኮአማማሮ።<verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>“እባዶ እስን አብረ አይሁድኮክ ምን ካኤብ ሞት ቶንሳ ኦዶናት ካአቦ ቶስ እስን ካኮጌሰ ጎራታ፥ ምሲ ጎርቱን መ አም አባብናታን አሮያዴን። <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>ሀሱ ጎራታ አያና ቁሉክ እስን አዬስን ካዶትሳሮ አጋልስስናራ።”<verse eid="LUK 12:12"/></para>
  <para style="s1">ዱሬሳኮት ጎዉማ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>ጎሳ ኦሮኮ እባዶት ኮ፥ “ካአጋልስሳቶ፥ አቢክ እዬን ኤላ ጎጎሄዴድሮ ሰጊ” አመ።<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>የሱሳና፥ “አት እባዶት፥ እን እስን ጉት ካፍርዳሮና ኤላ ካሄዴዳሮ ካየለራ አዮያ?” አመ። <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>አደና፥ “ግር ካእባዶ ዱሩማ ጂናን ካኡኩማመሮ ማንኮሌኖ ማራን፥ እስኦራዬን፤ ጋጲጋጳኖ ዱባኮ እስኦራዬን” አመ።<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>ደቤና የሱሳ ሃ አመ ማሱሳይ ሰገ፥ “እራ ካም ኣሎ ካኮንዱባመረ ዱሬሳት ኮ ግረ። <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>ሂክ እባዶትና፥ ካም ታኮኩኩይሳራ ባንኤ ማንኮግኖን ማራን ‘አን ምስ የላ? አመ ዎዳናቴሳ ሄደ።’<verse eid="LUK 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18"/>“ሃና አመ፥ ‘ሂካማሌ የልናራ ካግሮ ጎታራል ባስጉረ ካካለ ካባላኣን ጎታራል ማዳርናራ። ኡሱ ጎታራሊ ካምና ኡራዎኦተ ዱባ ኩኩይሳይናራ። <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>ኔፎቴነ፥ ኔፎቴ፥ ጌስ ካሞጋኑን ታሌቶ ዱሩማ ኩን ኩኩይሰራ፥ ጎርታ ፎልሳ፥ አም፥ ጣም፥ ገጌላ’ ” አምናራ።<verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>“ዋ አደ፥ ‘አት ጎዋ! ኔፎታ ህታሜን አን ኩኮ ኣትን ዶታራ። ጎርታ ኡሱን ካኩኩይሳተታ አዮን ሌራ?’ ” አመ።<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>ሃንሱን የሱሳ፥ “ኡሱን ዱሩማ ካኩኩይሳታራ አየሱን ጎአመን ዋይ ዶሌ ዱረሳ ካሌኖን እባዶትኮት ጋቾ ሂካማሌታ” አመ።<verse eid="LUK 12:21"/></para>
  <para style="s1">አሮያዴን</para>
  <para style="r">(<ref loc="MAT 6:25-33">ማቶ. 6፡25-33</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>ኤሰኮና የሱሳ ኡሱኮ ኦአጋልሳታራነ ሃ አመ፥ ሃንሱን አን እስኔ ሃ አማራ፥ እስን ግርክስኑን መ አምናና፥ ጎርቱን ማርክስኑን መ ሳርሳይናና አም አሮያዴን። <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>ግር ባቦኮ ማርና ሳርስኮ ሮራራ። <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>ቁራጆል ዲያ ላኮዉጣታናን፥ ላኮታጋታራን፥ ታኮኩኩይሳታራን ጎርቱን ጎታራ ላኮአባን፥ ዋ ጎአመን እሶ አምሳራ። እስና አደን ክምብርጆልኮ ኣሎ ላኮሮራታንያ? <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>ጎሌና እስንኮ ያደጉረ ጌስካከሳ ጉት አሪ ቶ አዳይን ካዳንዳራ አዮያ? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>ጎርታ ሂካ ክጫርክ አየስ ዱዶ ፈልን ካዳንዴኖን ጎሌተን አየስ ካካለቱን ሙን ያዳታን? <verse eid="LUK 12:26"/><verse number="27" style="v" sid="LUK 12:27"/>“አላ ዳራራል ምሲ ጂናታራን ዲያ፥ ላኮዳፉራናን፥ ላኮሱቃታራን፥ አየሱን ጎአመን አን እስኔ ሃ አማራ፥ ዎኖ ሶሎሞን ዱዶ ሀሱ ካባጃል ዱባኮ ኮ ኣን ላኮሳርሳተሮ። <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>ጎርታ ዋ ህታር ሙተረ ጌባር ኤለኒ ቶስ ካሻፋሮ ካዲዳ ኤስ ሃ ካሳርስሳሮ ጎሌ፥ እስን አማኖ ኦኮንሀንቃተራ፥ እስን ጎአመን ምሲ ሮርስ ሳርስሳና ዋታራ? <verse eid="LUK 12:28"/><verse number="29" style="v" sid="LUK 12:29"/>ሃንሱን መ አምናና መ ጣምናና አማ ዶታታ ዎዳናትስን አሮያዶ። <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>ሂካ ጎአመን ካአይዛብ ጎሳ ዱባ ዶታታራ። ካዳሩረ ኣቦክስን ሂክ ዱባ እስኑን ካዶትሳሮ ላኖ ካሶዋ። <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>አየሱን ጎአመን ዎኖናት ካዋ ዶታዬን፥ ሂክ ዱባና እስኑን አዳም ስሳምናራ።<verse eid="LUK 12:31"/></para>
  <para style="s1">ኡሊ ጉት ዱሩማ ኩኩይሳታኖ ካዶትሶን ላኖ</para>
  <para style="r">(<ref loc="MAT 6:19-21">ማቶ. 6፡19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>“እስን ጎሳ ኡጫር ኦሌተታን ዎኖናት እስኑን ስስን ኣቦክስንት ታኢዳነ ፈኢታ አሮአብሳቴን። <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>እስኑን ካግሮ ዳዳላዴን ህየሳሉን ስሳ፥ ሄቶ ታኮሄቶን፥ ፊኖ ታኮአሞን ካዶአኖን ሽለ ኦጉዳኖን ኡራዎ ዳሩሪ ኩኩይሳዬን። <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>ዎዳናትስን፥ ኡራዎ ኦትስን ታኮግራን ባንኤ ግራታ።<verse eid="LUK 12:34"/></para>
  <para style="s1">ናባድ ኦራታኖ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>“ጎርታ ሞዋዬዴን ኤካሳየን፤ ዳብክስን ካሀንቃየ ሀሌዎ። <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>ጎታክሶ ምን ካሃስኖኮ ታ አባባሮን ኦኦራታራና ኤመይረ ኡፋ ጎባባሰ ጎርሰዋ ባንን ካኤካሳተሮ እባዶ ኣን ላ። <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>ጎታክሶ ካኮኤሜታሮ ጎራታ ናባደን ግራን ኡሱ ኦሄላራ ኦሀንዳራን እሶ ኦሶማሳመንያን። አን ሩምና አማራ፥ ጎታክሶ ኤካሳተ ሞዋተረ፥ አሞና ሀማጽሳራ፥ ጋባላመና አምሳራ። <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>ሄመን ጠኤና ሌረ ሉካለ ካሆሬ ኦዋ ግራን ኤመይረ ኡሱማሌ ናባደን ኦግራን ኡሱ ኦሄላራ፥ ሀኑኡ ኦሀንዳራን እሶ ኦሶማሳመንያን። <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>ሂካ አዳ. አዴሳ፤ ሄቶ ኤክ ጎራታ ኤሜይናቶ ኦዶምነ አዴስ ግረዋ፥ ምንኬሳ ኦሻማ ግራን ጫልኢ አም ላኮድያረ። <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>እስና ኤካሳየንደን ኦራዬን፤ ኤረ ካእባዶ እስን ካኮሻዶንግታን ጎራታ ኤመይናራ።”<verse eid="LUK 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>ጴጢሮሳና፥ “ጎታ! ሂካ ማሱሳ ካኮንአዬሳታ ኖ ኦላሉንያ ሙ ዱባዉና አዴዴያ?” አመ።<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>ጎታኬሳና ሃ አመ ኡሱን አባበ፥ “ጎርታ ባቦክሶ እሶን ካኮዶትሳሮ ጎራታ ጎጎስስሮ ጎታ ካምነ እባዶ ጉት ካሹመራ ካአብዳመና ቃሮክ ሀዳራ ካአባ አዮያ? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>ጎታ ማንኮሴተሮኮ አባባይ ካኮኤሜሮ ጎራታ ጎጎአጃጃመሮክ ማለ ፈላ ካሙተ ኡሱ ምስክ ካሶማሳመያ! <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>አን ሩምና አማራ፥ ጎታኬሳ ሀሱ ካሀንዳሮ ኦግራን ኡራዎ ዱባ ጉት ኡሱ ሹምናራ። <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>አየሱን ጎአመን ኣንክ ካዳንዳራ፥ ‘ጎታክ ሳሜ. ላኮኤሜይናሮ፥ አዳላይናራ’ አም ጎሄደና ባባርና ሄለልና ኦሀንዳራን ጎቦጨ አደና ጎጎጌላቴ ኣማኖ ጣማኖና ሰታኖ ጎሀጋአበ፥ <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>ሀሱ ካሀንዳሮኮክ ጎታ ታኮሻዳሞን አርና ታኮሄዳኖን ጎራታ ደራኣ ኤመይናራ። ኣሎ ኡሱ ሙርስናራ፥ ህጣቴሳና ዋ ካአማኖን እባዶነ ዎታ የልናራ።<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>“ታጎታ ፈኢ አዴሳ ግራን ካኤካሳኖና ፈኢቴሳና ካፈሎን ሀሱ ካሃንዳራ ኡሱ ጎሜላን ሙርሳምናራ፥ <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>አየሱን ጎአመን ሂካ ካአዴሶና ካሙርስሳሮ ግታክ ካላል ጎየለ ካሃንዳራ ኡሱ አባራንቲ ሙርሳምናራ። ካሞጋን ካስሳመሮኮ ካሞጋን ዶታማራ፥ ታንጂን ሀዳራ ካአታተሮኮ ታንጂን ኦራማታ።<verse eid="LUK 12:48"/></para>
  <para style="s1">ኖጎዳ አንሌኖን ካለካለ ብያኖ</para>
  <para style="r">(<ref loc="MAT 10:34-36">ማቶ. 10፡34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>“አን ካኮንኤሜየራ ኡሊ ጉት ኤለን አብስሲንያ፥ ግዳዋ ጎቤበተ ምስ ምሲ ላኮጌላይናረ! <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>አየሱን ጎአመን አን ካጣማቃምናሮ ካካለ ጥንቃታ ካራኮ አባ፥ ታጉዳሮ ጌግን ምሲ ላኮያደረ? <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>ኡሊ ጉት ኖጎዳ ኬኒን ካኤመየሮ ኣን ላራ? ላኮዮ። አን ካኮንኤሜየራ ካለካለ ቤስንያ። <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>ግዳኮ ሀጋአበረ ምን ኮ ኦሮ እስ እስኦሮ ካለካለክ እባዶ ግርናራ፥ ላማ ሴድ ጉት ሴንዳ ላማ ጉት ኪጉሬን ካለካለ ብናራን። <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>ኦዶና ኤረ ባባርትት ጉት ኤረ ባባርትትና ኦዶኬሳ ጉት ኣና ኤረ ዴለልትቲ ጉት፥ ኤረ ዴለልትትና ኣየትሰ ጉት፥ ሶዶ ኦርኤረትሴ ጉት ኦርኤረና ሶዶትሴ ጉት ኪጉሬን ካለካለ ብናናን።”<verse eid="LUK 12:53"/></para>
  <para style="s1">ጌስጆል አዴሳኖ</para>
  <para style="r">(<ref loc="MAT 16:2-3">ማቶ. 16፡2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>አደና ጎሳነ የሱሳ ሃ አመ፥ “ዱማንቻ ምና ታኢያንኮ ብያ ጎዴታን ጎርሰዋ፥ ‘እዳሞ ኡባይናራ አማታን፥’ ኡሱማለና ላራ። <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>ሎጎዶ ጎኬሮ፥ ‘ኡል ፉርሳራ አማታን፥’ ኡሱማለና ላራ። <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>እስን ኢፍሳዶለ፥ ታዳሩረና ታኡሌ ምዲ አዴሳኖ ካሳንዋ፥ ሀያ ሂካ ካግዳኔ ጌስ አዴሳኖ ምሲ ዋተን? <verse eid="LUK 12:56"/><verse number="57" style="v" sid="LUK 12:57"/>እስን መተክስኒ ልክ ካሌሮ ሙን ፍርዳናዋታን? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>ባራጋራካነታ ዳና ሆረ አልን ጎሴተ ጋና ራድ ግራን ዎጋርን እጻም፥ ጎርቱን ኡሱ ናቴረ ዳና ቶስ ጌስናራ፥ ዳናና ፖልሲን ኩ ስሳራ፥ ፖልስና ምን ካሻኖ ታብስናራ። <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>ሙራ ሙር ታጉድሶ ኤሰኮ ላኮብናቶ አመ።”<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">ጩቦኮ ጉላ ጋላኖኮት ኡምት</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>ኡሱ ጎራታ እባዶ የሱሳ ቶስ ኤመተጉረ፥ ጲላጦሳ ኢግክሶ ጃርሶክሶነ ዎታ ማንኮለደራን ማራን ካጋሊላ እባዶኮክ ጋራ ካአዬሰረ እባዶ ኤሰ ግረ። <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>የሱሳና ሃ አመ እሶን አባበ፥ “ሀያ ሂኒዕ ኦጋሊላ እባዶጃ ሂክ አቦሳ እሶ ካኮንጌገራ ካካለ ካጋሊላ እባዶኮ ሮሬነ ጩባለሳ ማንኮሌን ማራን ኣን ላራ? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>ላኮዮ አን እስኑን ሃ አማራ፥ ጩቦኮ ጉላ ጋላናጎዋተን ዱባና ሂካማሌ ባይናታን። <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>ጎርቱን አደ ኡል ካሰልሆሚ ግምበ ዲጋመረ ካጎየረ እባዶ ቶሞንኮ ስዴድ ኢየሩሳለም ካግሮ እባዶ ዱባንኮ ጩባለሳ ማንኮሌን ማራን ኣን ላራ? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>ላኮዮ፥ አን እስኑን ሃ አማራ፥ ጩቦኮ ጉላ ጋላናጎዋተን ዱባና ሂካማሌ ባይናታን።”<verse eid="LUK 13:5"/></para>
  <para style="s1">እል ካዱባሞን ጋኮት ማሱሳ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>አደና የሱሳ ሃ አማ ሂካ ማሱሳ አዬሰ፥ “እባዶት ኮዉን እራ ካዎይንኮት ባንኤ ካአባራመረ ኮ ካባላስ ጋትት ግረ። ኡሱና ኢል ኡሱኮ ዶታዪን ኤመተረ ኮና ላኮሄላተረ። <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>ካዎይኒ አካክልተ ካፈላራና፥ ‘ሂክማ፥ ኢል ዶታይ ሄላይን ጌስ ሴድ ሂካ ጋ ካባላስ ቶስ አን ኤሜየረ ኢል ላኮሄላየሮ፥ ሃንሱን ጎስ፥ መዉን ኤሬኮ ኡንጃነ አዳ. ጡቃታ?’ አመ። <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/>‘ካፈላረና አደ፤ ጎታ! ማራሙርስ ታ ቆሽሮና ኮሲ ታክብሮ ሂካ ጌስ ካላሉን ኢሳግ። <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>ጌስ ካኤሜታሮ ታጌቶ ጎዱባንተ ካእዳንክያ፤ ጎርቱን ጎስናታ’ ” አመ አባበ።<verse eid="LUK 13:9"/></para>
  <para style="s1">ዙኡሮ ታአባናይተ ሄለልትቲ አሪ ታፎልሲ ፋያኖ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>የሱሳ አይሁድን ታፎልሲ አሪ ኮ አይሁድኮክ ምን ካኤብ አጋልስሳ ግረ። <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>ኤሴና ባቲክ አያናይ ጌስ ቶሞንኮ ስዴድ ዱባ ዙኡሮ ታቤሰተ ሄለልትቲ ቶ ግቴ። ኤሴና ዙኡሮ ቤሳኖኮ ካከይ ዱዶ ጦቂ አምን ላኮዳንዴተቴ። <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>የሱሳና ኤሰ ካኮደያረ ጎራታ ኡመጉረ፥ “አባቴ፥ ሀዉኣምካኮ ፋይተታ” አመ። <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>ገነቴሳ ኤሰ ጉት ካየ፥ ኤሰና ጎርሰዋ ቱኩል አልተ፥ ዋና ጋላቲተ። <verse eid="LUK 13:13"/><verse number="14" style="v" sid="LUK 13:14"/>ካአይሁድ ምን ካኤብኮክ ዎይቻ ጎአመን፥ የሱሳ አይሁድን ታፎስ አሪ ኤሰ ማንኮፋይሰ ማራን አማራተረ ጎሳነ፥ “ፈሎ ፈላይን ታኮዶትሳራ አሪ ሌዎ ግቶዋ። ሃንሱን እሶ አርጆሊ ኤሜየንደን ፋያ ኳሬ ታፎልሲ አሪ ላኮዮ” አመ። <verse eid="LUK 13:14"/><verse number="15" style="v" sid="LUK 13:15"/>ጎታና አባበረ፥ “እስን ኢፍሳዶለ፥ እስን ኦሮኮ እባዶት ኮ ኣር ጎርቱን ደሜር ታፎልሲ አሪ አዉድኮ ፉራተረ በከ ጣምሳይን ላኮዳግሳታሮያ? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>ሀያ፥ ህት ሄለልትቲ ታአብራመ ኤረ ሌተ ግራን ጌስ ቶሞንኮ ስዴድ ዱባ ጻላዬ ሽሻንተ ካኮግቴኮ ሂካ ሻኖኮ ታፎልሲ አሪ ፉራሚን ላኮዶትሳቶያ?” አመ። <verse eid="LUK 13:16"/><verse number="17" style="v" sid="LUK 13:17"/>ሂካ ካኮአዬሳረ ጎራታ ኡሱ ኦዲዳሬን ዱባ ሙሌን፥ ጎሳ ዱባና አደ ኡሱ ኦፈለሮ ኦሳዳምራን ፈሎ ዱባና ገጌላተ።<verse eid="LUK 13:17"/></para>
  <para style="s1">እል ታስናፍጭኮት ማሱሳ</para>
  <para style="r">(<ref loc="MAT 13:31-33">ማቶ. 13፡31-33</ref>፤ <ref loc="MRK 4:30-32">ማር. 4፡30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>ኤሰኮና የሱሳ፤ “ዎኖናት ካዋ መ ኣን ላራ? መነ ዎታ ማሱስራ? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>እባዶት ኮ ገሰረ እራ ኦሮ ታዉጠሮ ኢል ታስናፍጭ ኣን ላታ፤ ጂናተ ጋ ሌተ፤ ጉንተ ካቡባራ ክምብርጆልና ባላልክሰ ጉት ሀማጼ” አመ።<verse eid="LUK 13:19"/></para>
  <para style="s1">ታኢርሾ ማሱሳ</para>
  <para style="r">(<ref loc="MAT 13:13">ማቶ. 13፡13</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>አደና የሱሳ፤ “ዎኖናት ካዋ መነ ዎታ ማሱስራ? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>ሄለልትቲ ቶ ኣተዴ ካም ራቶ ታ ሙላምሮ ጣመ ታንጂነ ዎታ ታለሌደቶ ኢርሾ ኣን ላታ አመ።”<verse eid="LUK 13:21"/></para>
  <para style="s1">ጎጫ ካኡባን</para>
  <para style="r">(<ref loc="MAT 7:13-14">ማቶ. 7፡13-14</ref>፥<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>ኤሰኮ አባባተረ የሱሳ ኢየሩሳለም ሴታ ግራን፥ ኦሮማረ ታኮሮራረ ካታማሊና ማማንጆል አጋልስሰ ሮራ ግረ። <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>እባዶት ኮ ጋባላመረ፥ “ጎታ፤ ኦፋያራን እባዶጃ ኡጫር ኦላልያን?” አመ።</para>
  <para style="p" vid="LUK 13:23">ኡሱና አባበረ ሃ አመ፤ <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>“ጎጫ ካኡባነ ታብን እጻማ፤ አን ሃ አማራ፤ ካሞጋን ታብን ዶታታራ፤ አየሱን ጎአመን እሶን ላኮሌሮ፤ <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>ኦዶምነ ክጉረ ጎጫ ካኮጩፋተ ጎራታ ሳሬ አልዴነ፥ ‘ጎታ፤ ኡፋ ኖን ባንና’ አማ ባባሳታኖ ሀጋአብናታን። ኡሱ ጎአመን፥ ‘እስን አዮስታን ሀገኮ ኤመቴታን’ አን እስን ላኮካሶ! አም እስኑን አባብናራ። <verse eid="LUK 13:25"/><verse number="26" style="v" sid="LUK 13:26"/>እስና፥ ‘ኖ ኩ ዎታ ራቶ አምነና፥ ጣምነና፥ ሶንጎንና ኖ አጋልስሰታ አምናታን።’<verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>“ኡሱና፥ እስን አዮስታን ሀገኮ ኤመቴታን ‘አን እስን ላኮካሶ፥ እስን ኦሜላን ዱባ እንኮ ፋክማ’ አምናራ። <verse eid="LUK 13:27"/><verse number="28" style="v" sid="LUK 13:28"/>አብራመነ፥ ይሳቃነ ያይቆባነ፥ ካሄገሮልነ ዱባ ዎኖናት ካዋ ኦሮ ጎዴተን፥ እስን አድ ሳርድ ሻፋምዴን ጎሄሴን ሀሱ ጎራታ ኦታና ኢልኮ ፎጫኖ እስኑን ሌራ። <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>እባዶ ምና ታብያንኮ፥ ምና ታኢያንኮ፥ ኤለኮና ሄገልኮ ኤሜይጉረ ዎኖናት ካዋይ አሞን ሀማጺናራ። <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>ሃንሱን፥ ካሃረ ሆረ ሀይናራ፥ ካሆሬና፥ ሃር ሀይናራ።”<verse eid="LUK 13:30"/></para>
  <para style="s1">የሱሳ ኢየሩሳለሚን ያደ</para>
  <para style="r">(<ref loc="MAT 23:37-39">ማቶ. 23፡37-39</ref>፤ <ref loc="LUK 19:41">ሉቃ. 19፡41</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>ሀሱ ጎራታ እባዶ ካፋራሳውኮ ኮኮ ኤመተረ፥ “ሄሮዶሳ ኩ ላጋዲን ማንኮዶታሮ ማራን ክጉዴ ሂታኮ ሴ” አመ።<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>የሱሳ አደ እሶነ፥ “ሴየንጉዴነ ሀሱ ቃሩማ ታዳኤር ካአቦ ጌዳላትዉን፥ ሂክማ፥ ‘አን ህታርና ጌባርና ዱርሳ ቤስናራ፥ ኩባሌሳልና ፋይስናራ፥ አሪ ታሴድና ሀልቻኬ ቶስ ጌግናራ’ አማራ አማ ሰጋ አመ። <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>ሀሌዎ ኳሬ ካሄገሮ ኢየሩሳለም ኦሮ ኳሬ ማጌና ጎይን ላኮዶትሳሮ ህታር፥ ጌባርና ጋባሩ ኤሰራ ቶስ ሰሴታን ሆረድናራ።<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>“ኢየሩሳለም፥ ኢየሩሳለም፥ ካሄገሮ ታላጋዳታ፥ ኩ ቶስ ኦፋራመራና ኤኤሞ ታኤጋታ! ሉካለ ጩጩተካክሴ ባላሎኦትሴይ ሄገሊ ጎጎኩኩይሳቶ ማለ አን ይስካካ ኩኩይስን ምያ ጋለ ዶተ፥ እስን አዴነ ላ አንቴን። <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>ሃንሱን፥ ምንክስን ኦና ሌ ሄሰራ። አን ሃ አማራ፥ ‘መገ ካጎታይ ካኤሜይናራ ኡሱ ካሶማሳመያ ሃ ታአንታን አሪ ታጌቶ ሂታኮ ሆረንባን ጎርታ እን ላኮድናታን’ ” አመ።<verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">የሱሳ ፋራሳውት ኮኮክ ምኒ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>አይሁድን ታፎልሲ አሪ ቶይ፥ የሱሳ ባቦ ኣምን ካፋራሳው ዎይቻልኮ ኮ ካሌረ እባዶትኮክ ምን ቶስ ካኮታባረ ጎራታ፥ እባዶ ኡሱ ጉት ማራሙርሳ ግረ። <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>ኤሴና ማርኮክ ዱዱቤል ካአቦሳማረ እባዶት ኮ ኡሱ ሆረ ግረ። <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>የሱሳና፥ ሴራ ኦአጋልስሳራኔና ፋራሳውልነ፥ “አይሁድን ታፎልሲ አሪ ኩባሌሳል ፋይሳኖ ዶትሳራ ሙ ላኮዶትሳሮያ?” አመ እሶ ሆሳተ።<verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>እሶና አደን ጫልኢ አመን። ኡሱና እባዶት አበ ፋይሰረ ጋልሰ። <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>አደና፥ “እስንኮ ኮ ኤረኬሳ ጎርቱን አርኬሳ ታፎልሲ አሪ ጉምቢ ኦሮድ ጎኢየ ሳም ካቤሳኖን አዮያ?” አመ። <verse eid="LUK 14:5"/><verse number="6" style="v" sid="LUK 14:6"/>እሶና ሂካኑን ቶና ታአም አባብራን ዋተን።<verse eid="LUK 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>የሱሳ አሞን ኦኡማመራን ታካባጃ ባንኤ ኦአሳባታራን ዴጉረ፥ ሃ አማ ሂካ ማሱሳ እሶን ሰገ። <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>“እባዶት ኮ ምን ካሃስኖ አሞን ኩ ጎኡመ፥ ታካባጃ ባንኤ አሮሀማጽተ፥ ካባጃይ ኩኮ ካንጂንክ እባዶት ካኡማመሮ ጎሌ፥ <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>እስን ላማ ዱባና ካኡማተረ ኤመይረ፥ ባንኤ ‘ሂካ እባዶትን ጋፋርና’ አምናራ፤ አትና ሙልደ ሁስ ታአንተ ባንኤ ዳግ ሀማጽናታ። <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>አየሱን ጎአመን አት ካኮኡማንተ ጎራታ ሁስ ታአንተ ባንኤ ድያደ ሀማጺ፥ ኩ ካኡማተራ ኤመይረ፥ ‘አን ካጌላታሮኬ፥ ኮይ ህታኒ ጦቂ አም ሀማጽ አምናራ፥’ አትና ሀሱ ጎራታ ራቶ አሞን ካሀማጼሮ እባዶ ዱባ ሆረ ካባጃምናታ። <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>ኣላንቲና እስኦቴሳ ካጦቂ ጦቂኢሳታራ ዱባ ሁስ አምናራ። እስኦቴሳ ሁስ ሁስሳታራ ዱባ ጦቂ አማራ።” <verse eid="LUK 14:11"/><verse number="12" style="v" sid="LUK 14:12"/>የሱሳና ካኡማተሮ እባዶትነ አደ፥ “ክታ ካአር ጎርቱን ክታ ካሄመነ ኣሞ ካኮኤካሳቶ ጎራታ ኦፈልተቶ ጎጎማርትሶንኮና አምአታ ኩን ጎጎአባቦንኮ፥ ኩ ካጌላታሮኮ ጎርቱን አብላልታ ፋልካ ጎርቱን ዱረሳ ኦላታ አሮኡማተ። <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>አየሱን ጎአመን ማርትና ካኮኤካሳተ ጎራታ ህየሳል ኦኤሳራን፥ ናፋለሳና ኢልኦ ኦደያኖን ኡም። <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>አት ሶማሳንቶዋ፥ ሂኒዕ አማኣ አባብን ኦዳንዴኖን ማንኮሌን ማራን፥ ቁሎለኮክ ከያኖይ አምአታ አባባቶዋ” አመ።<verse eid="LUK 14:14"/></para>
  <para style="s1">ማርትና ኦአቲኮክ ማሱሳ</para>
  <para style="r">(<ref loc="MAT 22:1-10">ማቶ. 22፡1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>የሱሳነ ዎታ አሞን ኦሀማጼራን ኦሮኮ ኮ ሂካ ማለረ “ዎኖናት ካዋይ ጋባላመረ ባቦኮ ካአማራ ካሶማሳመያ” አመ።<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>የሱሳ አደ፥ “እባዶት ኮ ኦአቲ ማርትና ኤካሳተረ ካሞጋን እባዶ ኡመ። <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>ካአሞ ጎራታና ካኮገያረ ጎራታ ታኡማንተቶ ማርትጆልነ፥ ‘ሂክማ፥ ካአመን ዱባና ኤካተራ ኮዬን’ አም ጎጎኡምሮን ካሀንዳሮኬሳ ፋረ።<verse eid="LUK 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18"/>“አየሱን ጎአመን ዱባና ታትሶ ታትሶ ኣላንቲ መጣኖ ሀጋአበን፥ ካሆሬ ጋና ግዳ ‘ኤረ ማንኮኢምናየሮ ማራን ሴይረ ድያታኖ ዶትሳራ፥ ማጋኔ፥ ኢን ሻጋ የልና’ አመ።<verse eid="LUK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19"/>“ካካለና፥ ‘አን አራር ካዶ ከን ኢምናየራ፤ እሶ አብ ድናራ ማጋኔ ሻጋ ኢን የልና’ አመ።<verse eid="LUK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20"/>“ካካለና አደ፥ ‘አን ጋና ካማሻሸ ማንኮሌ ማራን ኤመይን ላኮዳንዴሮ አመ።’<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>“ካሀንዳረና አባባተ ኤመተረ ዎይቻኬሳዉን ሰገ። ሀሱ ጎራታ ካምነ ጎታ አማራተረ ካሀንዳረነ፥ ‘ሳምደ ራ ካባላኣኒ ካግሮና ካኡባን ካግሮ ዱባ ቤ፥ ህየሳልና ናፋለሳጆል፥ ኢልኦ ካደያኖና ካኤሳሮ ሂታራ ታብስ’ አመ።<verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>“ካሀንዳረና፥ ‘ጎታኬ፤ አት ካአጃጂተተ ዱባ ጉድሰራ፥ ግዳና አደ ባንኤ ግቶዋ’ አመ።<verse eid="LUK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23"/>“ጎታና ካሀንዳረነ፥ ራ ካጎሳ ቶንሳ ራ ካቃማ ቶስ ቤና፥ ‘ምንክና ጎጎአማጋምሮን ካሄልተ ዱባ ሁና ኬን ጉደ ታብስና። <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>ኣንክ ኡማመ ግራን ካዲደሮ እባዶኮ አሞኬ ህኢ ካአብናራ ኮና ላኮግሮ!’ አመ።”<verse eid="LUK 14:24"/></para>
  <para style="s1">የሱሳ ዴበ ኦሰሰታራን ላኖ ታሙርስሳሮ ሙራ</para>
  <para style="r">(<ref loc="MAT 10:37-38">ማቶ. 10፡37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>ካሞጋን ጎሳ ራቶ ሰሴታ ግራን፥ የሱሳ ካምባል አመረ ሃ አመ። <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>“እን ቶስ ካኤመታራ ዱባ ኣቦኬሳና ኣየቴሳ ኦርቴሳና ይስኬሳ፥ አቢላልቴሳና አባላልቴሳ፥ ግርኬሳ ዱዶ ሀሄሶን እንኮ ሮርሳተ ካጌላታራ፥ ኢንደቤ ካሰሰታሮ ሊን ላኮዳንዳሮ። <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>ማስቃሊቴሳ ስዳይረ እን ዴበ ካሰሰኖን እንኮ ካአጋልሳታሮ ሊን ላኮዳንዳሮ።<verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>“እስን ኦሮኮ እባዶት ኮ ምን ካግንበ ማዳራይን ጎዶታተ፥ ጉድሲን ዳንዳኖና ዳንድዋት ጣየ ኤግታክ ማራጋደ ዶትሳሮ ሀማጺረ ዶክ ካሄዳኖን አዮያ? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>ኡኩም ሉጉዳይጉረ ጉሳዪን ጎዋተ፥ ካዴ ዱባ ኡሱ ቃጭፋታራ። <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>ሃና አማራን፥ ‘ሂክ እባዶት ምን ማዳራዪን አባተጉረ፥ ጉሳዪን አደ ዋተ’ አማራን።<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>“ጎርቱን ዎኖ ኮ ዎኖ ካካለ ዎታ ጀሬን ሻፋይን ካኮኬሮ ጎራታ፥ ኩማ ቶሞን ዎታዳራል ታብስሰረ ካኤሜታሮ ዎኖ ካካለ ኩማ ላማታን ዎታዳራ ዎታ ጀሬን ሻፋይን ዳንዳኖኮክ ሀማጽረ ካማካሮን አዮያ? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>ሻፋይን ካዳንዴኖን ጎሌ፥ ካካለ ዎኖ ጋና ኤባ ግራን፥ ሀንዳ ኦጌጊሳራን ፋረጉረ ዎጋርስ ሆሳታራ። <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>ኡሱማለና፥ እስን ኦሮኮ ማዮና ካኬሳ ካአቦ ዱባ ካኢሶን፥ እንኮ ካአጋልሳታሮ ሊን ላኮዳንዳሮ።”<verse eid="LUK 14:33"/></para>
  <para style="s1">ላኦ ካላይት ኤሰቦ</para>
  <para style="r">(<ref loc="MAT 5:13">ማቶ. 5፡13</ref>፤ <ref loc="MRK 9:50">ማር. 9፡50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>“ኤሰቦ ታኢዳንትታ፥ ኤሰቦ ኦኖሞንጀ ጎዋታንተ አድ ምሲ አባባይ ታኤሰቦ ኦኖሞንጀ ግርን ዳንዳታ? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>ኡሉን ሌረ ማዳባራዉን ላኦ ታስሶን ላኖይ ሳርድ ሻፋምናታ።</para>
  <para style="p" vid="LUK 14:35">“ካማላራ ነበ ካአባ ሀማሎ።”<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">ባየ ካሄላመሮ ኢዳዶኮክ ማሱሳ</para>
  <para style="r">(<ref loc="MAT 18:12-14">ማቶ. 18፡12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>አሪ ቶ ኦሞጋን ቃራጣ ኦኩኩይሳሬና ጩባልዬል ዱባ የሱሳኮ አጋልስስኬሳ ማልን ኡሱ ቶስ ኩኩሜን። <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>እባዶ ካፋራሳውና ሴራ ካሙሴ ኦአጋልስሳራን፥ “ሂክ እባዶት ጩባልዬል ቆጳታራ፥ እሶነታና አማራ” አማ ጉምጉመን። <verse eid="LUK 15:2"/><verse number="3" style="v" sid="LUK 15:3"/>የሱሳና ሃ አማ ሂካ ማሱሳ እሶን ሰገ።<verse eid="LUK 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4"/>“እስን ኦሮኮ ኮዉን እዳድ ቦል ጎግረ ኡሱኮና ኮ ጎባየ፥ ሳጋልታምኮ ሳጋሊ ዲዳ ሉጉድጉረ ካባየሮ ታሄላሮ ዶታዪን ካንቤኖን አዮያ? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>ካኮሄላተ ጎራታና ገጌላታ ሃንኬሳይ ስዳተረ፥ <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>ምንኬሳ ቶስ አባባታራ። ኡሱ ኦጌላታሮና ኦላቴሳ ራቶ ኡመጉረ፥ ‘ካባየሮ ኢዳዶኬ ሄላየራ ኢነ ዎታ ገጌላየን’ አማራ። <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>አን እስኔ ሃ አማራ፥ ሂካማሌ ኖ ጩቦ ላኮአብኖ ቁሎለና ኦአማራን ሳጋልታምኮ ሳጋልኮ ጩቦኮ ካጉላ ጋላሮ ጩባለሳ ኮይ ዳሩሪ ገጌሎ ኦአቲ ልናራን።”<verse eid="LUK 15:7"/></para>
  <para style="s1">ታባተቴ ጣጋራኮት ማሱሳ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>“ደቤና ጣጋራ ቶሞን ታአባናይተ ሄለልትቲ ጣጋራ ቶሞንኮ ቶ ካኮባተ ጎራታ፥ ታ ሄላቶ ዳብ ሀንቃይሳተደ፥ ምን ሻካራተደ፥ ኣሎ ታዶቶን ሄለልትቲ አዮታ? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>ካኮሄላተ ጎራታ ኤሰ ኦጌላታራና ኦላትሰኔ ራቶ ኡማተደ፥ ‘ታባተቴ ጣጋራ አን ሄላየራ ኢነ ዎታ ገጌላየን’ አማታ። <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>አን ሃ አማራ፥ ኡሱማሌ ጩቦኮ ካጉላ ጋላሮ ጩባለሳት ኮይ ኤርግቻ ካዋይ ሆረ ገጌሎ ልናራን” አመ።<verse eid="LUK 15:10"/></para>
  <para style="s1">ባየ ካሄላመሮ ኡኑትኮክ ማሱሳ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>አደና የሱሳ ሃ አመ፥ “እባዶት ኮዉን ይስ ላማ ግረ። <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>እሶኮና ኤረ ክጫር ኣቦኬሳነ፥ ‘ኣቦኬ፥ ዱሩማታኮ ቆባ ኢን ስስ’ አመ። ኣቦኬሳና ዱሩማቴሳኮ ይስኬሳዉን ሄደደ።<verse eid="LUK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13"/>“አሪ ታንጂን ሀአዳላኖን፥ ኤረ ክጫር ቆባኬሳ ዱባ ኩኩይሳተረ ኡል ካኤር ሴተ፥ ኤሴና ጎጎጌላቴ ኡራዎኦቴሳ አዳ. ዳርኣተ። <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>ኡሱና ካአቦ ዱባ ካኮጉሳታረ ጎራታ፥ ኡሱ ኡል ዱባ ካአቲ ኡኢ ሌ፥ ራካታኖ ሀጋአበ። <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>ሃንሱን ሀሱ ኡልኮክ እባዶት ኮ ቶስ ጋባላመ፥ እባዶትና ቦዬ ኡሱ ጎጎፎፍሮ እራ ፋረ። <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>ቦዬል ካአማሮ ድንቀና ኣምን ሀልቻ ግረ፥ አየሱን ጎአመን ሂካ ኡሱን ካስስራ እባዶ ኮና ላኮግረ።<verse eid="LUK 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17"/>“ዎዳና ኡሱን ካኮአባባተ ጎራታ አደ ሃ አመ፥ ‘ኣቦኬዉን ካፈላሮ እባዶ ምያኮ ባቦ ሄሰ ካማዳራማራ? አን አደ ህታኒ ኡኢ ጎይን ጋባላመራ! <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>ኪጉረ ኣቦኬ፥ ቶስ ሴይረ፥ ሃ አምናራ፥ ኣቦኬ፥ ዋይና ኩ ሆረ አን ባሰራ። <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>ጎርታ ኤረካ አማም ኡማምን ላኮዶትሳሮ። ምኒ ሀማጼረን ኦፈላራንኮ ኮ ኣን እን ቶቲና አምናራ።’ <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>ሃንሱና ኬጉረ ኣቦኬሳ ቶስ ሴተ።</para>
  <para style="p" vid="LUK 15:20">“አየሱን ጎአመን ኡሱ ጋና ኤባ ግራን፥ ኣቦኬሳ ኡሱ ዴጉረ ነኔኤይሳተ፥ ኡሱ ቶንሳ ትያ ሴተጉረ ካባላተ አባተ አንጋተ።<verse eid="LUK 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21"/>“ኡኑና፥ ‘ኣቦኬ፥ ዋይና ኩ ሆረ አን ባሰራ፥ ጎርታ ኤረካ አማም ኡማምን ላኮዶትሳሮ አመ።’<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>“ኣቦኬሳና ጎአመን ኡሱን ኦሀንዳሬነ ሃ አመ፥ ‘ሳማ ዱባንኮና ካእዳን ካሌሮ ሳርስ ኬናዴን ኡሱ ሳርስሳ፥ ፈሩን ፍራንታ፥ ሉኩን ከፈሮ ታብሳ። <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>ካቃባን ኩርኩራ ኮር ኬናዴነ ኤናኣ፥ አምና፥ ገጌላና። <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>ሂክ ኡኑክ ጎየራ አመ አን ግረ፥ ግዳ ጎአመን ኔፎ ሄላተራ፥ ባየ ግረ፥ ሄላመራ።’ ኤሰኮ ገገላታኖ ሀጋአበን።<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>“ኡሱ ጎራታ ኤረ ካንጂን እራ ግረ፥ ሀሴኮና አባባተ ምን ቶስ ካኮጋባላማረ ጎራታ፥ ታዱዱሮና ታማዳር ያየ ማለ። <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>ኡሱና ኦሀንዳሬንኮ ኮ ኡመረ መያ ካምስሌራ? አመ ሆሳተ። <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>ካሀንዳረና፥ ‘አቢካ ጋማተራ፥’ ኖጎዳና ፋያሌሳ ሌ ማንኮጋማተሮ ማራን ‘ኣቦካ ኩርኩራክ ኮር ካቃባን ኡሱን ኤነኤራ’ አመ።<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>“ካንጂን አቢኬሳ አማራተረ፥ ምንና ታብን ላኮዶተሮ፥ ኣቦኬሳና ሳር ቤጉረ ኡሱ ምን ጎጎታብሮ ኤባተ። <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>ኡሱ ጎአመን አባበ ኣቦኬሳነ ሃ አመ፥ ‘ሂካ፥ ግታክ ጌስ ድይ ኣን አን ኩን ሀንዳየራ፥ አጃጃካኮ ኮና አደ ላኮሀንቅሰሮ፥ አት ጎአመን አን ካጌላታሮ ዎታ ጎጎገገላሮ ጭባረ ቶ ሱረ ላኮስሰቶ። <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>አየሱን ጎአመን ሂክ ኡኑ ኡራዎኦታ ሻርሙጣልነ ዎታ ዳርኣተ ባሳተጉረ ጎኤመተ፥ ካቃባን ኩርኩራ ኮር ኡሱን ኤኒዕተ።’<verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>“ኣቦኬሳና ኡሱን ሃ አመ፥ ‘ኡኑኬ፥’ አት አርጌቶ ኢነ ዎታ ግታ፥ ካኬ ካሌራ ዱባ ካካያ። <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>ሂክ አቢካካ አደ ጎየራ አመ ግረ፥ ኔፎ ሄላተራ፥ ባየ ግረ ሄላመራ፤ ሃንሱን ኣሎ ገገላይና ዶትሳራ።”<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">ካአብዳሞን ሀዳራ ካአቦኮክ ማሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>የሱሳ ኡሱኮ ኦአጋልሳታራነ ሃ አመ፥ “ዱረሳክ እባዶት ኮ ሀዳራ ካአቦ እባዶት ኮ አባናየ፥ ሂክ ኦዶ ሀዳራ ዱሬሳትኮኒዕ ኡራዎ ዳርአኖኮክ ኦዱ ሂካ ዱሬሳት ጌተ። <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>ሃንሱን ዱሬሳት ኦዶ ሀዳራ ኡምስስጉረ፥ ‘ሂክ አን ካማላራ መያ? ጎርታ አት ኢን ኦዶ ሀዳራ ሊን ማንኮዳንዴኖን ማራን፥ አት ኦባሪሳተ ኡራዎኦት ካኮቶታምናራን ማዝጋባ ኢን ሀጋስስ’ አመ።<verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>“ሀዳራ ካአባናየክና ዎዳናቴሳ ሃ አመ፥ ‘ጎታካክ አን ሀዳራ ማንኮአቦኮ ኢንዳግስናራ አማራ፥ ኦታይን ሁና ላኮአቦ፤ ኤባታኖ አደ እን ሙሊሳራ፥ ሃንሱን ምስ የላ? <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>አን ሀዳራ ማንኮአቦኮ ካኢግልሳመ ጎሌ እባዶ ምንካክሶይ እን ጎጎቆጳሮ አን ካየልናሮ ካሶዋ።’<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>“ሃንሱን ታጎታ አንዛ ካአቦ እባዶ መተ መተ ኡመጉረ፥ ካሆራርጄ እባዶትና ‘ጎታኬት አንዛ ኤግታት አብታ?’ አመ።<verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>“ ‘ኡሱና፥ ዛይቲ ቶሳ ቦል አባ አመ።’ ሀዳራ ካአባናየክና ካዉሊ ዎራቃታካ ሂክማ አታ፥ ሳም ሀማጺደ ‘ቶሳ ኮንቶም አም ጻፍ አመ።’<verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>“ኤሰኮና ካካለኔ፥ ‘አትደ ምያ አብታ?’ አመ። ኡሱና፥ ‘ጉል ኮንቶም ዳርጋማ አባ አመ።’ ሀዳራ ካአባናየክና፥ ‘ታኣማኣየ ዳብዳበታ አህአይ ጉል አፋርታም’ አም ጻፍ አመ።<verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>“ጎታኬሳና አማኖ ካኮንሀንቃተሮ ሀዳራ ካአቦ ቃሩማቴሳዉን ሳድሰ፥ ህክና እባዶ ካዋኮ ሮረን ሂካ አላምኮክ እባዶ ባርሳኖ ኦአላሚ ቃሮሌ ላኖ ቱሳራ። <verse eid="LUK 16:8"/><verse number="9" style="v" sid="LUK 16:9"/>ሃንሱን አን እስኑን ሃ አማራ፥ ሂካ አላምኮክ ማራጋደ ካኮጉዳተ ጎራታ ጅሩ ጅሮማክ ምን አታማኖ ጎጎግሮን፥ ሂካ ማራጋዴ እስን ኦጌላታራን እስኦትስኑን ኤካሳየን።<verse eid="LUK 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10"/>“አየስ ክጫርኪን ካአብዳመ ካሌ ካንጂንክና አብዳማራ፥ አየስ ክጫርክ ካአብዳሞን ካንጂንክና ላኮአብዳማሮ። <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>ጎርታ፥ ሂካ አላምኮት ዱሩማ እስን ጎአማናሞን፥ ታሩም ዱሩማ አዮያ ሀዳራ አም እስኑን ካስስናራ? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>ካካለ እባዶኮት ዱሩማ እስን ኦአማናሞን ጎሌተን፥ ታትስን ታሌተቶ ዱሩማ አዮያ እስኑን ካስስናራ?<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>“ኮይክ ጎታ ላማ ሀንዳይን ካዳንዴራ ማዮና ድይ ላኮግሮ፥ ኮ ዲደጉረ ካካለ ጌላታራ፥ ጎርቱን ኮይ ጋባላማራ፥ ካካለና አደ ቱፋታራ። ካዋና ካማራጋደ ድይ ሊን ላኮዶትሳሮ።”<verse eid="LUK 16:13"/></para>
  <para style="s1">ዎኖናት ካዋዉን ካስሳመሮ አጋልስሳኖ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>ማራጋደ ካጌላታረ እባዶ ካፋራሳው ሂካ ዱባ ማለረ የሱሳን ቃጭፋተ። <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>ኡሱና እሶነ ሃ አመ፥ “እስን እባዶ ሆረ እስኦትስን ቁሎለ ኦየላታንታን፥ ዋ ጎአመን ዎዳናታትስን ካሳ። እባዶ ዶሌ ካካባጃመ፥ ዋይ ሆረ ካቱፋመያ።<verse eid="LUK 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>“ሴራ ካሙሴና ካሄገሮልኮክ ማጻፋና ታ ያንሳ ጌሮ ሰጋማ ግረ። ኤሰኮ አባባተረ አደ ዎኖናት ካዋ ካገጌሎ ላላባምናራ፥ እባዶ ዱባ ኤሰራ ታብን ለላምናራ። <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>አየሱን ጎአመን ሴራኮ ኤጋኖ ኮ ኢያኖኮ ዳሩርና ኡልና ጎሮሬን ኤነ ሌራ።<verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>“ኦርቴሳ ከልክ አመ ቤሰጉረ ታካለ ካአታታራ ዱባ ሻርሙጣራ፥ ኤንተርኮና ታቤተቶ ካአታታራ ሻርሙጣራ።”<verse eid="LUK 16:18"/></para>
  <para style="s1">ዱረሳክ እባዶትና አላዛር</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>አደና የሱሳ ሃ አመ፥ “ሄላ ቡራቡረ አዉኣሎክ ሳርስ ካሳርሳተረ አርጌቶ ባርሳኖ ኦኢዳኒዕና ገጌሎይ ካግረ ዱረሳክ እባዶት ኮ ግረ። <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>ኤሴና፥ ሜጋ ማር ዱባ ካኮኤልተተ አላዛር ካአማማረ ህየሳት ኮ ኡሱ ዱረሳክ እባዶትኮክ ጎጫ ሆረ ከነን ካረን። <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>ዱረሳክ እባዶትኮት ዱጉድኮ ታኢያቶ ኦሮንት ኣምን ሀልቻ ግረ፥ ከሮርና ኤመተጉረ ሜጋታቴሳ ሄለፋታ ግረ።<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>“ሂክ ህየሳት ጎየ፥ ኤርግቻልና አብራመ ቶስ ጌሰን። ዱረሳክ እባዶትና አደ ጎየ ቃማላመ። <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>ቦዋ ኦሮና አቦሳማ ግራን ጦቂ አመረ ኤባ አብራመ ዴ፥ አላዛርና ዶሌ ካአባተሮ ዴ። <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>ኡሱና፥ ‘ኣቦክ አብራመ፥ ነኔኤይሳና፥ አን ሂካ ላጫ ማንኮአቦሳማሮ ማራን፥ አላዛር ፈርቴሳት ብርጠ በከ ድንረ ኤሬብኬ አምባል ጎጎየሎ ማጋኔ ፋር አማ እዬ።’<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>“አብራመና አደ ኡሱነ ሃ አመ፥ ‘ኡኑኬ፥ አት ግርካ ካኡሌቲ ካእዳን ኮኮ ጎጎአታተቶ፥ አላዛርና አደ ካሜላን ኮኮ ካአታተሮ ሻድ፥ ግዳ አደ ኡሱ ህታኒ ጎጌላሮ አት አደ አቦሳ ጉት ግታ። <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>ሂካ ዱባኮ ሂታኮ እስን ቶስ ሮርን ኦዶታታራን ኦዳንዴኖን ላኖ፥ አንትነ ኦግራና አደን ኖ ቶስ ጎጎናቆንኮ፥ ኖየና እስን ጠኤ ላጋ ካአቲ ግራ።’<verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27"/>“ኡሱና ሃ አመ፥ ‘ኣቦኬ አብራመ፥ ጎርታ አላዛር ኣቦኬክ ምን ጎጎፋርቶን አን ኩ ኤባታራ። <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>አቢላል ከኖ ኢን ማንኮግቶ ማራን፥ እሶና ህታ ታአቦሳ ባንኤ ቶስ ጎጎኤመኖንኮ ሴይረ እሶ ሀአዴስሶ።’<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>“አብራመ አደ፥ ‘እሶን ካሙሴና ካሄገሮልኮክ ማጻፋጆል ኤሰ ግራን እሶና ሀማሌን’ አመ።<verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>“ ‘ኡሱና፥ ኣቦክ አብራመ ላኮሃዮ፤’ ኦዶ ኮ ጎይኮ ኪጉረ ሴተዋ ጩቦኮ ጉላ ጋላሬንዋ አመ።<verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>“አብራመና ‘ካሙሴና ካሄገሮኮክ ማጻፋጆል ኦማሎን ጎሌን፥ ኦዶ ኮ ጎይኮ ኪጉረ ጎሴተና ላኮአማናን አመ።’ ”<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">ጩቦ፥ አማኖ፥ ፈሎ</para>
  <para style="r">(<ref loc="MAT 18:6-7">ማቶ. 18፡6-7</ref>፥<ref loc="MAT 18:21-22">21-22</ref>፤ <ref loc="MRK 9:42">ማር. 9፡42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>የሱሳ ኡሱኮ ኦአጋልሳታራነ ሃ አመ፥ “እባዶ ካሀንዱፍስራ ሀኤመኖኒ ላኮሄስናሮ። አየሱን ጎአመን ሀንዱዱፎ ካላሮን ሀሱ እባዶትን ኣኔ። <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>ሂክ እባዶት ሂናኣ ኦትዲጫርኮ ኮ ካሀንዱዱፍሳሮኮ፥ ሪም ካባዳላ ማርግቴሳ ሻምጉረ በከ ኦሮ ባዲ ጎሻፋመ ሆረ ላረ። <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>ሃንሱን እስኦትስን ኦራዬን።</para>
  <para style="p" vid="LUK 17:3">“አቢካ ኩ ጎሚረኤ ሀድስ፥ አን ባሰራ አም ጎጉላ ጋለ ሀሄሶ አምና። <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>አሪ ቶይ ቶዶባ ጋል ኩ ሚርኢጉረ ቶዶባ ጋል ‘አን ኩ ሚረኤራ’ አማ ኩ ቶስ ጎኤመተ ኡሱን ሀሄሶ አም።”<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>ኦፋራመራና ጎታነ፥ “አማኖካን ኖን አድና” አመን።<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>ጎታና፥ “እል ታስናፍጭ ግታክ አማኖ እስኑን ግረዋ፥ ህታ ኦዳ፥ ‘ታጋምጉደ በከ ኦሮ አባራምና’ ጎአንቴን እስኑን አጃጃንቶዋ” አመ።<verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>አደና የሱሳ ሃ አመ፥ “እስን ኦሮኮ እባዶት ኮ እራ ካኦታሮ ጎርቱን እዳድ ካፎፋሮ ሌ ካሀንዳሮ ካአቦ ጎሌ፥ ኡሱ ኢራኮ ካጋማተሮ ካሀንዳሮክነ፥ ‘ሳም ባቦ ቶስ ጋባላም አማታን’? <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>ሂካኮ ሱረ፥ ‘ካሄመነ ክታ ካኬ አን ጎጎአምሮ ኤካስና፥ አን ታ አምሮና ታ ጣምሮ ሞዋጉደ ኢን ሀንዳይ፥ ኤሰኮ አባባይደ አት አምናታ፥ ጣምናታ ላኮአማሮያ’? <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>ጎርታ ሂክ እባዶት፥ ካሀንዳረክ ኡሱን ካአጃጃመሮ ማንኮፈለ አባበ ማራን ኡሱ ጋላታራ? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>ሃንሱን እስና ሂካማሌ ካአጃጃንተታን ዱባ ካኮፈልቴን ጎራታ፥ ‘ኖ ላኦ ካላይኒዕ ኦሀንዳኖና፥ ፈላሚን ካዶትሳሮና ፈልነ ጉድንሰና አማ።’ ”<verse eid="LUK 17:10"/></para>
  <para style="s1">ባር ታማረኮ ካሙጭመሮ እባዶ ቶሞን</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>ኤሰኮ አባባተረ የሱሳ ኢየሩሳለም ቶስ ሴታ ግራን ምና ታሰማርያነና ታጋሊላ ማማንኮክ ሜሳነ ሮረ። <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>ማማን ኮ ቶስ ጎጎታቤ ማሪ ባር ኦአባናየን እባዶጃ ቶሞኖ የሱሳነ ዎታ ኤሰለ፥ እሶና ኤባ አሌረን፤ <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>ታአቲ ያየ፥ “ጎታ የሱሳ፥ ኖን ነኔኤይሳ!” አመን።<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>ኡሱና እሶ ካኮደያረ ጎራታ፥ “ሰዬንዴን እስኦትስን ቱቃሞሉን ቱሳዬን” አመ።</para>
  <para style="p" vid="LUK 17:14">እሶና ኤሰራ ሴቶ ጉት ግራን ሙጭሜን።<verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>እሶኮና ኮ ፋያኖኬሳ ካኮደያታረ ጎራታ ያየ ጦቂ ታአንቴ ዋ ካባጃ አባባተ። <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>ሉክ ታየሱሳ ጉት ሆረ ሆረ ኢየጉረ ጋላቴ፥ ሂክ እባዶትና ሳማራውትየ።<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>የሱሳና ሃ አመ ኡሱ ሆሳተ፤ “ካሙጭመረ እባዶ ላቶሞንየላ? ሀያ፥ ሳጋሎ ሀጌ ሴተ? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>ሂካ ካሳማራው አላጋት ኳሬ አባባተረን ዋ ካጋላታራ ካካለ ላኮግሮ አማኖያ?” <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>እባዶትነና፥ “ኪጉደ ጋል፥ አማኖካ ኩ ፋይሰራ” አመ።<verse eid="LUK 17:19"/></para>
  <para style="s1">ዎኖናት ካዋኮክ ኤመቶ</para>
  <para style="r">(<ref loc="MAT 24:23-28">ማቶ. 24፡23-28</ref>፥<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>ፋራሳውልኮክ እባዶ ዎኖናት ካዋ ጎረ ኤሜይናሮ የሱሳ ካኮሆሳታሬን ጎራታ ሃ አመ እሶን አባበ፥ “ዎኖናት ካዋ ካሙታሮ ራድ ላኮኤሜታሮ። <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>እባዶና፥ ‘ህታኒያ’ ጎርቱን ‘ኣንቲያ’ አምን ላኮዳንዴሮ፥ ሂክማ፥ ዎኖናት ካዋ እስኒ ኦሮ ግራ።”<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>የሱሳ ኡሱኮ ኦአጋልሳታራነ ሃ አመ፥ “ኤረ ካእባዶ ካኮኤመይናሮ አርጆልኮ ቶ ድን ካኮሀልችናታን ጎራታ ኤመይናራ። አድና ላኮድናታን። <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>እባዶ፥ ‘ኣንቲያ’ ጎርቱን ‘ህታኒያ’ አምናራ፥ ደቤና አሮሴቴን። <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>ኣላንቲና ሀንቃ ሀንቃየጉረ ዳሩር ቃማኮ ታ ጣሞ ጌሮ ጎጎሀንቃይሳሮ ማለ፥ ኤረ ካእባዶና ታኮኤመታሮ አሪ ኡሱማሌ ልናታ። <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>አየሱን ጎአመን ሂክ ላናኮ ሆረነ ኤረ ካእባዶ ካንጂን አቦሳማኖና ህታ አላታኒ ቱፋማኖ ግናራ።<verse eid="LUK 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26"/>“ካኖሄ ጌሲ ጎጎሌሮክ ማለ፥ ኤረ ካእባዶ ታኮኤመይናሮ አሪ ኡሱማሌ ልናራ። <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>ኖሄ ማርካፋ ታኮታበሮ አሪ ታጌሮ እባዶ አማና ጣማ፥ ኦር አታታና ኬሳታ ግረ። ኦባሳራን በከ ኤመተንጉረን ዱባና ባሰን።<verse eid="LUK 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28"/>“ካሎጠ ጌስና ኡሱማሌየ፥ እባዶ አማና ጣማ፥ ኢምናታና ዳዳላታ፥ አካክልተ አባራታና ምን ማዳራታ ግረ። <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>ሎጠ ሶዶምኮ ታኮቤረ አሪ ጎአመን ኤሌና ካጉባራ ቦላልና ዳሩርኮ ኡባተረ እሶ ዱባ ጉብተ ባሰ።<verse eid="LUK 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30"/>“ኤረ ካእባዶ ታኮኤሜታሮ አሪና ኡሱማሌ ልናራ። <verse eid="LUK 17:30"/><verse number="31" style="v" sid="LUK 17:31"/>ሀሴ አሪ ምንኬሳት ሄልንቾ ጉት ካግራ እባዶ ማዮና ምንኬሳ ኦሮ ኦግራን ኡራዎ አታይን አሮዳጎ። ኡሱማለና እራ ካግራ እባዶና ሃርዲ አሮአባባኖ። <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>ታሎጠ ኦር ሻዳ። <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>ኔፎቴሳ ሃሳይን ካዶታታራ ዱባ ዋታራ፤ ኔፎቴሳ ሮርሳተ ካስሳታራ ጎአመን ሃሳታራ። <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>ሀሴ ሄመኒ እባዶ ላማ አልጋ ቶይ ሁዱርናራን፥ ኮ አታምናራ፥ ኮ ሄስናራ። <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>ሄለል ላማ ራቶ ርታይናራን፥ ቶ አታምናታ ቶና ሄስናታ።” <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>[እባዶ ላማ እራ ግርናራን፥ ኮ አታምናራ ኮ ሄስናራ።]<verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>እሶና አባበሬን፥ “ጎታ፥ ኦአታማራን ሀገራያ?” አመን።</para>
  <para style="p" vid="LUK 17:37">ኡሱና፥ “ራቃ ማንኮግሮ አላትል ኩኩአማራ አመ።”<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">ጋልታንተትና ካሜላን ዳናኮት ማሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>የሱሳኮ ኦአጋልሳታረን አንሽሻዶን አርጌቶ ኤባታኖ ካዶትሳሮ ላኖ ቱስን የሱሳ ሂካ ማሱሳ እሶን ሰገ። <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>ሃና አመ፥ “ካታማ ቶይ ካግረ ዋ ካአብሳኖና እባዶ ካካባጅኖን ዳና ኮ ግረ። <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>ኤሰ ካታማይ ጋልታንተት ቶ ግቴ። ኤሰ፥ ‘ባራጋራኬነ ዎታ ታአቦ ሃጃ ኢን ጋፋና’ አማ ኡሱ ቶስ ሰሴታ ግቴ።<verse eid="LUK 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4"/>“ዳናና መተካሆሬ ኤሰ ላኮቆጳተረ፥ ዳንበኔ አደ ዎዳናቴሳ ሃ አመ፥ ‘ኮና ዋ አብሳታኖ ጎዋየና፥ እባዶና ጎካባጃናዋየ፥ <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>ህት ጋልታንተት እን ሀማጽ ማንኮትራቶ ማራን ኤሰን ፍርድናራ። ጎርቱን አድ አርጌቶ ሰሴታ እን ህፋችስናታ።’ ”<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>ጎታና፥ “ካሜላን ዳና ታአመሮ ማላ። <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>ዋ አደ ሄመና አሪና ኡሱ ቶስ ኦኢያራዉና ኦአሳባሜራዉን ላኮፍርዳሮያ? አላኮ ሮረ ጫልኢ አማራ? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>አን እስኑን ሃ አማራን፥ ሳመ እሶን ፍርዳራ። አየሱን ጎአመን ኤረ ካእባዶ ካኮኤሜታሮ ጎራታ ኡሊ ጉት አማኖ ካሄሎ ሌዉና?” አመ።<verse eid="LUK 18:8"/></para>
  <para style="s1">ካፋራሳውና ቃራጣ ካኩኩይሳሮኮክ ማሱሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>ደቤና የሱሳ ኖ ቁሉኒዕና አማ እስኦትሶይ ኦዳታራና ካካለ እባዶና ኦቱፋታራዉን፥ ሂካ ማሱሳ ሰገ። <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>“እባዶጃ ላማ ዋ ኤባይን ቁሉክ ምን ካዋ ሴተን፥ ኮ ፋራሳውት ካካለ ቃራጣ ካኩኩይሳሮዬን። <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/>ፋራሳውት ካለ አሌረ እስኦቴሳዉን ሃ አማ ኤባታ ግረ። ‘ካዋየ፥ አን እባዶ ካካለ ዱባ አን ካሳማሮ፥ ካሜላንክ፥ ካሻርሙጣሮ፥ ሀሱኮና ሂካ ቃራጣ ካኩኩይሳሮ ኣን ላና ማንኮዋየ ማራን አን ኩ ጋላታራ፤ <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>ቶዶባ ቶይ ላማ ጋለ አጋቡዋራ፥ ካሄላታሮ ዱባኮ ገነ ቶሞንኮ ባርክንተ ቤሳራ።’<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>“ቃራጣ ካኩኩይሳረ ጎአመን ኤባ አሌጉረ፥ ዳሩር ቶስ ጦቂ አም ድን ዱዶ ላኮዶተሮ፥ አየሱን ጎአመን ጌግዮ ቦቦጫታ፥ ‘ካዋየ፥ እን ጩባለሳ ማር’ አማረ።<verse eid="LUK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14"/>“አን እስኔ ሃ አማራ፥ ፋራሳውትኮ ሮረ ህክና ዋይ ዶሌ ቁሉክ ኣን ሌ ቶታመ ምንኬሳ አባባተ። እስኦቴሳ ካጦቂ ጦቂኢሳታራ ዱባ ሁስ አምናራ፥ እስኦቴሳ ካሁስ ሁስኢሳታራ ጎአመን ጦቂ አምናራ።”<note caller="+" style="f"><char style="fr" closed="false">18፡14 </char><char style="ft" closed="false">ማቶ. 23፡12፤ ሉቃ. 14፡11</char></note><verse eid="LUK 18:14"/></para>
  <para style="s1">የሱሳ ይስ ክጪጫር ሶማሳተ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶ. 19፡13-15</ref>፤ <ref loc="MRK 10:13-16">ማር. 10፡13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>የሱሳ ገነ ጉት ካይ ጎጎሶማሳሮ እባዶ ይስ ኡሱ ቶስ ኬናታረ። ኡሱኮ ኦአጋልሳታረን ሂካ ካኮደያረን ጎራታ ሀድሴን። <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>የሱሳ አደ ይስ እስቶስ ኡመጉረ ሃ አመ፥ “ይስ እን ቶስ ጎጎኤሜሮ ፈኢ ስሳ፥ አሮትርቴን፥ ዎኖናት ካዋ ሂናኣ አኒዕዉንያ። <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>አን ሩምና አማራ፥ ዎኖናት ካዋ ይስ ኣን ካአታኖን ዱባ ዱዶ ላኮታብናሮ።”<verse eid="LUK 18:17"/></para>
  <para style="s1">ዱረሳክ ካአይሁድ ዎይቻቲ</para>
  <para style="r">(<ref loc="MAT 19:16-29">ማቶ. 19፡16-29</ref>፤ <ref loc="MRK 10:17-31">ማር. 10፡17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>አይሁድኮክ ዎይቻልኮ ኮ፥ “ካእዳንክ ካአጋልስሳቶ፥” ጅሩ ጅሮማክ ግር ኤልን አን መ ፈላ? አመ ኡሱ ሆሳተ።<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>የሱሳ አባበረ፥ “መ ማራን አት እን ካእዳንክ አማታ? ዋ ኮ ኳሬ ካእዳንክ ማዮና ላኮግሮ። <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>‘አሮሻርሙጢተ፥ አሮላጋደ፥ አሮሄቴ፥ ጣራይ አሮአቶቲተ፥ ኣቦካና ኣየታ ካባጂ ካአማሮ አጃጃ አት ካሶዋ አመ።’ ”<verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>እባዶትና፥ “ሂካ አጃጃል አን ይሱማኮ ሀጋአበረ ኦራዬራ” አመ።<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>የሱሳ ሂካ ካኮማላረ ጎራታ፥ “ጎርታ ኩን አየስ ኮ ካሄሰራ፥ ካአብቶ ዱባ ዳዳልጉደ ህየሳሉን ስስ፥ ካዳሩረ ማዝጋባ አት ግርቶዋ። ኤሰኮ ኤሜደ እን ዴበ ሰሴ” አመ።<verse eid="LUK 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23"/>እባዶትና ሂካ ካኮማላረ ጎራታ፥ ታንጂን ዱሩማ ኡሱን ማንኮግቴ ማራን ኣሎ ሀዉኢሳተ። <verse eid="LUK 18:23"/><verse number="24" style="v" sid="LUK 18:24"/>የሱሳና እባዶት ዴጉረ ሃ አመ። “ታሞጋን ዱሩማ ካአቦዉን ዎኖናት ካዋ ቶስ ታባኖ ምስክ ዳፉርያ? <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>ዱረሳ ዎኖናት ካዋ ቶስ ታባኖኮ ጋላ ቡቶ ካማርፍ ኦሮማር ጎሮረ ኤነ ሌራ።”<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>ሂካ ካማለ እባዶና፥ “ሀያ፥ አዮያ ፋይን ካዳንዳራ?” አመ።<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>የሱሳና፥ “እባዶ ዶሌ ካዳንዳሞን ዋይ ዶሌ ዳንዳማራ” አመ።<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>ጴጢሮሳና፥ “ሂክማ፥ ኖ ካአብኖ ዱባ ኢንሰነ ኩ ዴበ ሰሴነና አመ።”<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>የሱሳና እሶነ፥ “አን ሩምና አማራ፥” ዎኖናት ካዋዉን አመረ “ምንኬሳ ጎርቱን ኦርቴሳ ጎርቱን አቢላልቴሳ ጎርቱን ኦኡሙለራና ጎርቱን ይስኬሳ ካኢሰ፥ <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>ሂካ ጌሲ ካሞጋን አምባ፥ ካኤሜታሮ ጌሲ ጅሩ ጅሮማኮክ ግር ካአታኖን ማዮና ላኮግሮ።”<verse eid="LUK 18:30"/></para>
  <para style="s1">የሱሳ ጎይኬሳኮክ ጋራ ካላም አዬሳኖ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ. 20፡17-19</ref>፤ <ref loc="MRK 10:32-34">ማር. 10፡32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>የሱሳና ቶሞንኮ ላማ ኡሱኮ ኦአጋልሳታራነ ካለ ኣተ ቤጉረ ሃ አመ፥ “ጎርታ ኖ ኢየሩሳለም ቶስ ብናና፥ ኤረ ካእባዶ ማራን ኦሄገሮል ካጻፋመራ ዱባ ጉዳይናራ። <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>አይዛብን ኡሱ ሮርስ ስስናራን፥ እሶና ቃጭፋይናራን፥ አብ ማዳርናራን፥ ሀንጩፈ ቱፍናራን። <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>ቦጭናራን፥ ኤሰኮና ላጋድናራን፥ ኡሱና ታሴድ አሪ ጎይኮና ክናራ።” <verse eid="LUK 18:33"/><verse number="34" style="v" sid="LUK 18:34"/>ኡሱኮ ኦአጋልሳታራን ጎአመን ሂካ ዱባኮ ኮና እሶ ካአዴሰሬን አየስ ላኮግረ፥ አዬንሳ እሶኮ ስያመ ግረ፥ መ አማኖዮና ላኮአዴሰረን።<verse eid="LUK 18:34"/></para>
  <para style="s1">ኢልኦ ካባየረኮክ ፋያኖ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ. 20፡29-34</ref>፤ <ref loc="MRK 10:46-52">ማር. 10፡46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>የሱሳ ታኢያርኮ ካታማ ቶስ ካኮጋባላማረ ጎራታ፥ ኮ ኢልኦ ካባየረ ራግሪድ ሀማጼረ ኤባታ ግረ።<verse eid="LUK 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 18:36"/>ኢልኦ ካባየረና ጎሳ ኤሰነ ሮራ ግራን ማለጉረ፥ ሂክ መያ? አመ እሶ ሆሳተ።<verse eid="LUK 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37"/>እሶና፥ “ካናዝረት የሱሳያ ህታነ ካሮራራ” አመን ኡሱን ሰገን። <verse eid="LUK 18:37"/><verse number="38" style="v" sid="LUK 18:38"/>ኡሱና፥ “ኤረ ካዳዉተ፥ የሱሳ፥ እን ማር!” አማ እዬ።<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>ሆረሃየ ካሰሰታረ እባዶና፥ ጫልኢ ኡሱ ጎጎአምሮ ሀድሴን፥ ኡሱ ጎአመን፥ “ኤረ ካዳዉቴ፥ እን ማር!” አማ ጂናሰ እዬ።<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>የሱሳና አሌረ እባዶት ኡሱ ቶስ ጎጎኬናዉን አጃጄ። ኡሱ ቶንሳ ካኮጋባላማረ ጎራታ፥ <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>የሱሳና “አን ኩን መ ጎጎየሎ ዶታታ?” አመ ኡሱ ሆሳተ።</para>
  <para style="p" vid="LUK 18:41">ኢልኦ ካባየረክና፥ “ጎታ፥ ድን ዶታታራ” አመ።<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>የሱሳና፥ “ዴና፥ አማኖካ ኩ ፋይሰራ” አመ።<verse eid="LUK 18:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43"/>እባዶትና ጎርሰዋ ድን ዳንዴ። ዋና ካባጃ የሱሳ ዴበ ሰሴተ። ጎሳ ዱባ ሂካ ዴጉረ ዋ ጋላቴ።<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">የሱሳና ቃራጣ ካኩኩይሳረ ዛኮሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>የሱሳ ታኢያርኮ ካታማ ቶስ ታበረ ኤሰነ ሮረ ሴታ ግረ። <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>መገ ዛኮሳ ካአማመረ እባዶ ኮ ኤሰ ግረ፥ ቃራጣ ኦኩኩይሳሬዉን ዎይቻና ዱሬሳናየ። <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>ኡሱና የሱሳ ካአማማረ ኤክዮ ድን ዶታ ግረ፥ አየሱን ጎአመን ጅፉ ታጋባባንት ማንኮሌተ ማራን፥ ጎሳ ሞጋንኮ ካከይ ኡሱ ድን ላኮዳንዴረ። <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>የሱሳ ሀሱ ራኔ ሮራ ማንኮግረ ማራን፥ ኡሱ ድን ሆረ ሀየ ቲየጉረ ኦዳ ቶይ ጉት ኮራተ። <verse eid="LUK 19:4"/><verse number="5" style="v" sid="LUK 19:5"/>የሱሳና ኤሰ ባንኤ ጌጉረ፥ ጦቂ አመረ “ዛኮሳ፥ ህታር አን ምንካይ ሀይን ዶትሳራ ሳም ዳግ” አመ። <verse eid="LUK 19:5"/><verse number="6" style="v" sid="LUK 19:6"/>ኡሱና ሳመ ዳገጉረ የሱሳ ገጌሎይ ቆጳተ ምን ጌሳተ። <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>ኤሰ ካግረ እባዶና ሂካ ዴጉረ፥ “ሂክ እባዶት ምን ካጩባለሳ ቶስ ማርትና ኣምን ታበ!” አማ ዱባና ጉምጉማኖ ሀጋአበ።<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>ዛኮሳ አደ ኬ አሌጉረ ጎታነ “ጎታ፥ አን ታአቦ ዱሩማ ዱባኮ ምና ህየሳዉን ስስናራ። ማዮኮና ጣራይ ካሳመሮ ጎሌ፥ አምባ አፋር የል ኡሱን አባብናራ” አመ። <verse eid="LUK 19:8"/><verse number="9" style="v" sid="LUK 19:9"/>የሱሳና አባበረ፥ “ሂክ እባዶት አደ ታአብራመ ሳኒ ማንኮሌ ማራን፥ ህታር ፋይና ኡሱና ሂካ ምኑን ሌራ። <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>ኣላንቲና ኤረ ካእባዶ ካኮንኤመተራ ካባየሮ ዶትና ፋይሲንያ” አመ።<verse eid="LUK 19:10"/></para>
  <para style="s1">ጣጋራ ቶሞንኮክ ማሱሳ</para>
  <para style="r">(<ref loc="MAT 25:14-30">ማቶ. 25፡14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>ጎሳና ሂካ ማላ ግራን፥ የሱሳ ማሱሳ አዬሳኖ ሆረዴ፥ ኣላንቲና ኢየሩሳለም ቶስ ጋባላማኖና እባዶን ዎኖናት ካዋ ካጋባላመሮ ኣን ሌ ማንኮሙተ ማራንያ። <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>የሱሳና ሃ አመ፥ “ሹም ኮ መገ ካዎኖናት አታይረ አባባይን ኡል ካኤር ሴተ። <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>ኦሀንዳረን ኦሮኮ ቶሞን ኡመረ ጣጋራ ቶሞን እሶን ስሰጉረ፥ ‘አባባይ አን ታኤሜሮ ሂካ ማራጋደ ዳዳላየን’ ” አመ።<verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>“ኡልኬሳክ እባዶ ጎአመን ኡሱ ማንኮዲደ ማራን፥ ‘ሂክ እባዶት ኖ ጉት ጎጎሬድሮ ላኮዶታታኖ’ አመረን ኡሱ ዴበ ኦሀንዳረን ፋረን።<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>“ሀሌዎ ኳሬ ሂክ ሹምት ሬደ ኡልኬሳ አባባተ፥ ኣኒዕ ኦሀንዳሬኒዕ ኡሱ ካስሰሮ ማራጋደ ዳዳሌረን ኤግታክ ዎረኤ ሄላቴራን ማላቢን እሶ ኡምስሰ።<verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>“ኦሀንዳሬንኮ ካሆሬ ጋባላመረ ‘ጎታኬ፥ አት ኢን ታስሰተ ጣጋራኮ ጣጋራ ቶሞን ዎረኤ ሄላምስሰራ’ ” አመ።<verse eid="LUK 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17"/>“ጎታና፥ ‘አት ካአብዳንተ ካሀንዳታክ’ ጎኢዳን ፈልተታ፥ ‘ኮኮ ክጫርኪ ካአብዳንተ ሌተ ማንኮሙተ ማራን፥ ካታማል ቶሞኒ ጉት ኦዶናት ኩን ስሳመራ’ ” አመ።<verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>“ካላምክና ጋባላመጉረ፥ ‘ጎታኬ፥ አት ኢን ታስሰተ ጣጋራኮ ጣጋራ ከን ዎረኤ ሄላምሰታ’ አመ።<verse eid="LUK 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19"/>“ጎታኬሳና ‘ኩን አደ ካታማል ከን ጉት ኦዶናት ስሳመራ’ ” አመ።<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>“ካካለ ካሀንዳረና ጋባላመረ ሃ አመ፥ ‘ጎታኬ፥ ሆጮይ ማማረ ካየ አን ካአዳላይሰራ ማራጋደካ ሂክማ። <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>አት ካካኖን ግቶ ካአታቶ፥ ካዉጣኖን ግቶ ካማጣራቶ፥ ካአንተ ካኢሶን እባዶት ማንኮሌተ ማራን አን ኩ አብሳየራ።’<verse eid="LUK 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22"/>“ጎታና ሃ አመ፥ ‘አት ካሜላን ካሀንዳታ ሃፉራ ካይዋ አን ኩ ፍርድናራ። ካካኖን ግሮ ካአታታሮ ካዉጣኖን ግሮ ካማጣራታሮ ካአመ ካኢሶን እባዶት ላኖኬ ጎአዴሰተ፥ <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>ኤመይረ ማራጋደኬ ዎረኤነ ዎታ ጎጎአታሮን ካፈላታሮ እባዶን ሙን ስስዋተ?’<verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>“ጎታኬሳና፥ ኤሰ ኦአሌራኔ ‘ጣጋራ ኡሱኮ አታደነ ጣጋራ ቶሞን ካአቦን ስሳ አመ።’<verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>“እሶና ‘ጎታ፥ ኡሱ ጣጋራ ቶሞን አባ’ አመን።<verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26"/>“የሱሳ ሃ አመ፥ ‘አን እስኑን ሃ አማራ፥ ካአቦን ዱባ አዳማራ። ካልክኮ ጎአመን ኣንክ ካግራዋ አታምናራ። <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>አየሱን ጎአመ አን እሶ ጉት ጎጎሬዶንኮ ኦዶታቴራን ሀሱ ዲናጆልኬ ሂታራ ኬናዴነ እን ሆረ ኤናኣ አመ።’ ”<verse eid="LUK 19:27"/></para>
  <para style="s1">የሱሳ ካባጃ ታአቲት ኢየሩሳለም ታባኖ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21፡1-11</ref>፤ <ref loc="MRK 11:1-11">ማር. 11፡1-11</ref>፤ <ref loc="JHN 12:12-19">ያን. 12፡12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>የሱሳ ሂካ አዬሰ አባባተረ ኢየሩሳለም ቶስ ብን ሆረሃየ ሰሴታ ግረ። <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>ዛይቲ ካበያራ ጋ ታኮአላታሮ ዎዳሚ ኦግራን፥ ቤተፋገ ቶንሳ ካብታንያ ማማን ቶስ ካኮጋባላማረ ጎራታ፥ ኡሱኮ ኦአጋልሳታረንኮ ላማነ ሃ አመ ፋረ። <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>“እስን ሆረ ካግሮ ማማን ሴዬን፥ ኤሰራና ታባ ግራን ማዮና ሱረ ታኮሀማጺኖን ግሮ ታደሜሬ ዳርሜ ሻንተ ታግቶ ሄልናታን፥ ፉራዴን ሂታራ ኬና። <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>ማዮና ‘ሙን ፉራታን?’ አም እስን ጎሆሳተ ‘ጎታዉን ዶትሳታ አማ።’ ”<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>ኦፋራሜረና ሴቴረነ ኡሱ ጎጎሰጌረክ ማለ ሌ ሄሌን። <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>ካምነ እባዶና ዳርሜ ታደሜር እስን ፉራ ግራንቲ ዴንጉሬን፥ እሶነ “ዳርሜ ሙን ፉራታን?” አመን።<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>እሶና “ጎታዉን ዶትሳታ” አመን።<verse eid="LUK 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35"/>ኤሰኮና ዳርሜ ታደሜር የሱሳ ቶስ ከነን፥ ሳርስ ካክሶ ጉት ያዬንጉረነ የሱሳና ዳርሜይ ጉት ሀማጺሴን። <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>እባዶና ኡሱ ካኮሴታሮ ራድ ሳርስክሶ ያ ግረ።<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>ዛይቲ ካበያራ ጋ ታኮአላታሮ ዎዳምኮ መተጋማቶ ካጌሳሮ ራ ቶስ ካኮጋባላማሬን ጎራታ ቶቶ ኣሎ ኦንጂን ኦሌረን ኡሱኮ ኦአጋልሳታረን ካዴራን ባሳ ዱባ ገጌላታ ያየትሶ ጦቂሴን ሃ አማ ዋ ጋላታኖ ሀጋአበን።<verse eid="LUK 19:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38"/>“መገ ካጎታይ ካኤመታራ ዎኖ ካሶማሳመያ!” “ኖጎዳ ዳሩሪ፥ ካባጃ ጉንተ ዋዉን ሀሌቶ!”<verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>ጎሳ ኦሮ ካግረ ኮኮ እባዶ ካፋራሳው የሱሳነ፥ “ካአጋልስሳቶ፥ ኩኮ ኦአጋልሳታራን ጫልኢ ጎጎአምናዉን ላኮሀድሳቶያ?” አመን።<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>የሱሳና፥ “አን እስኔ ሃ አማራ” “እሶ ጫልኢ ጎአመን ኤኤሞልና ኢይሮዋ” አመ።<verse eid="LUK 19:40"/></para>
  <para style="s1">የሱሳ ታኢየሩሳለም ካታማዉን ኦታኖ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>የሱሳና ኢየሩሳለም ቶስ ካኮጋባላማረ ጎራታ ካታማ ዴጉረ ኦተ። <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>ሃ አመ፥ “ኩን ኖጎዳ ካሌሮ መያ አት ህታር አዴስ ግቴዋ! ግዳ ጎአመን ኢልታኮ ጎላተራ። <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>ዲናጆልካ ኩ ማራሙረ ምና ምና ማራሙርስ ኦት ካይጉረ ታባኖካና ብያኖካ ትር ካኮያድስራ ጎራታ ኤመይናራ። <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>ተ ኩና ኦትታይ ኦሮ ካግሮ ይስካ ኤሬነ ዎታ ለሌድናራን፥ ኤኤሞኮ ካፈላመራ ግምበ ዱባ ዲጋምናራ፥ ዋ ኩ ፋይስን ካኮኤመተሮ ጎራታ አት ላኮአዴሰቶ።”<verse eid="LUK 19:44"/></para>
  <para style="s1">የሱሳ ቁሉክ ምን ካዋይ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶ. 21፡12-17</ref>፤ <ref loc="MRK 11:15-19">ማር. 11፡15-19</ref>፤ <ref loc="JHN 2:13-16">ያን. 2፡13-16</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>ኤሰኮ አባባተረ የሱሳ ቁሉክ ምን ካኤብ ታበረ ኦዳዳላታሬን ኤሰኮ ቤሰ። <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>አደና “ ‘ምን ካክ ቁሉክ ምን ካኤብ ልናራ’ አማመ ማጻፋ ቁሉክ ጻፋመራ እስን ጎአመን ‘ላጋ ካሽታ’ የላቴን” አመ።<verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>የሱሳ አርጌቶ ቁሉክ ምን ካኤብ አጋልስሳ ግረ። ቱቃሞኮክ ዎይቻና ካሙሴ ሴራ ኦአጋልስሳረን፥ ካካለና አይሁድን ሆረሃዬን ኦፈላሬን የሱሳ ላጋዲን ዶታ ግረን። <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>አየሱን ጎአመን ጎሳ ዱባ አጋልስሳኖኬሳይ ቦጃመ ማንኮግረ ማራን ፈልን አማ ካኤሜተረን እሶን ኤካታና ዋተ።<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">የሱሳኮክ ኦዶናት አይሁድዉን ካአዬስስሮ ሌ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ. 21፡23-27</ref>፤ <ref loc="MRK 11:27-33">ማር. 11፡27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>አሪ ቶይ የሱሳ ጎሳ ቁሉክ ምን ካዋይ አጋልስሳና ኦዱ ታኢዳን ላላባ ግራን ቱቃሞልኮክ ዎይቻልና ሴራ ካሙሴ ኦአጋልስሳራና ጃርሶለ ኩኩአመን ኡሱ ቶስ ኤመተን። <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>እሶና፥ “ሂካ አየስ ካኮፈላታ ኤክ ኦዶናትዮ ኖን ሰጊ። ኩን ኦዶናት ካስሰራ ኡሱ አዮያ?” አመን ሆሳተን። <verse eid="LUK 20:2"/><verse number="3" style="v" sid="LUK 20:3"/>የሱሳና፥ “አንና ሆሲን ቶ እስን ሆሳሮ፥ አላ ኢን አባባ። <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>ጥንቃታ ካያንሳ ዋኮያ ሙ እባዶኮያ?” አመ።<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>እሶና ሃ አመረን እስ እስኦሮ ማካረን፤ “ዋኮያ ጎአምኔ፥ ‘ሀያ ያንሳ ካአመሮ ሙን እስን አማናና ዋተን?’ አምናራ። <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>‘እባዶኮያ’ ጎአምኔ ጎሳ ዱባ ያንሳ ካሄገሮ ላኖኬሳ ማንኮአማናታራን ማራን ኤኤሞ ኖ ኤግራንዋ።” <verse eid="LUK 20:6"/><verse number="7" style="v" sid="LUK 20:7"/>ሃንሱን “ኤትኮዮ ኖ ላካንሶ” አመን አባበን። <verse eid="LUK 20:7"/><verse number="8" style="v" sid="LUK 20:8"/>የሱሳና፥ “ጎርታ አንና ሂካ አየስ ኤክ ኦዶናት አን ፈላሮ አን እስኑን ላኮሰግናሮ” አመ።<verse eid="LUK 20:8"/></para>
  <para style="s1">ካዎይኒ አካክልተ ኦታተን ኦባራራንኮክ ማሱሳ</para>
  <para style="r">(<ref loc="LUK 20:9-18">ሉቃ. 20፡9-18</ref>፤ <ref loc="MAT 21:33-46">ማቶ. 21፡33-46</ref>፤ <ref loc="MRK 12:1-12">ማር. 12፡1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>ኤሰኮ አባባተረ የሱሳ ሃ አመ ሂካ ማሱሳ ጎሳዉን ሰጋኖ ሀጋአበ። “እባዶት ኮ አካክልተ ካዎይኒ አባራተ፥ ኦታተን ኦባራረዉን ክራይ ስሰጉረ ኡል ካካለ ሴተጉረ ታንጂን አዳላተ። <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>ካም ታኮኩኩአማሮ ድግኒ፥ ታዎይኒ ኢልኮ ኡሱ ታገያቶ ምና ጎጎፋራዉን ካሀንዳረ ኦታተን ኦባራሬን ቶስ ፋረ፥ ኦታተን ኦባራረን አደን ካሀንዳሮ ቦጨረን ገነ ታላል ጋፋሬን። <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>ደቤና ካካለ ካሀንዳሮ ፋረ፥ ኦታተን ኦባራሬን ኡሱና አደን ቦጨን፥ የራሰነን ገነ ታላል ጋፋሬን። <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>ግዳና አደ ካሴድ ካሀንዳረና ፋረ፥ ኦታተን ኦባራሬን ኡሱና አደን ሜጋይሰን ሳርዴድሴን ሻፌን።<verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>“ካዎይኒ አካክልተኮክ ኦዶና፥ ‘ጎርታ ምስ የላ? አላ አድ ካጌላታሮ ኤረኬ ፋርናራ፥ ዎዳሳ ኡሱ ኦካባጂራን ሌራን’ አመ።<verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>“ኦታተን ኦባራረን ጎአመን ኤረኬሳ ካኮደያነ ጎራታ ‘ሂክ ካኤልናሮያ፥’ ኮዬን ‘ኡሱ ላጋንዳ ህት ርቲና ታታን ሌቶዋ’ አመን ማላቴን። <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>ካዎይኒ አካክልተ ባንኤኮ ሳር ቤሰረን ላጋዴን። የሱሳና።</para>
  <para style="p" vid="LUK 20:15">“ጎርታ አካክልተኮክ ኦዶ ምስ የልናራ? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>ኤመይረ ሀኑኡ ኦታተን ኦባራሬን ላጋድናራ። ካዎይኒ አካክልተኮት ባንኤ ካካለ ኦታተን ካባራሮን ስስናራ።” ጎሳና ሂካ ካኮማላረ ጎራታ፥ “ሂካ ኣንክክ አሮኬኖ” አመን።<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>የሱሳና እሶ ቶስ ዲያ ሃ አመ፥</para>
  <para style="q1" vid="LUK 20:17">“ ‘ሀያ ግምበ ኦማዳራታራን ካቱፋተራን ኤኤሞ</para>
  <para style="q2" vid="LUK 20:17">ፈሎ ኦምኔቱን መተ ሌ አማመ ካጻፋመሮኮት ፉረንና መታ’?<verse eid="LUK 20:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18"/>ሂካ ኤኤሞ ጉት ካኢያራ ዱባ ኤኤብናራ፥ ኤኤሞና ኡሱ ጉት ካኮኢያራ ዱባ ሺአምናራ” አመ።<verse eid="LUK 20:18"/></para>
  <para style="s1">ጊራ ሙራኖ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ. 22፡15-22</ref>፤ <ref loc="MRK 12:13-17">ማር. 12፡13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>ሴራ ካሙሴ ኦአጋስሳሬና ቱቃሞልኮክ ዎይቻልና ሂካ ማሱሳ ካኮንአዬሰረ እሶን ላኖ ማንኮአዴሴን ማራን፥ ኡሱ ጎራታዋ አብን ዶታ ግረን። አየሱን ጎአመን ጎሳ አብሳተን።<verse eid="LUK 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20"/>የሱሳና ካሮም ሞትዉን ሮርስ ስስን ህኢኮ ካብያሮ ሃፉራ ኡሱ አብን ዶታ ግረን። ሃንሱን ካሩም ኣን ሊ ኦጋባላምራን ክምብር ካዬን። <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>ክምብር ሌን ኦሴተረና ሃ አመን ኡሱ ሆሳተን። “ካአጋልስሳቶ፥ አት ልክኪ አየስ ጎጎአዬሳቶና ጎጎአጋልስሳቶ ኡሱማሌ ራ ካዋ ካሩም ጎጎአጋልስሳቶና ማዮና ካኡሉልሶን ላኖ ኖ ካንሶዋ። <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>አሚና ቄሳርዉን ጊራ ሙራኖ ሴራካን ፈኢ ስሳራ ሙ ላኮስሳሮያ?”<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>የሱሳ ጎአመን ሜላነትሶ አዴሰረ ሃ አመ። <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>“አላ ዶልቺ ቶ እዬን ቱሳ፥ ጉት ታግታ ታዮ ምዲና መገ ካዮያ?” እሶና ታቄሳርታ አመን አባበን።<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>የሱሳና፥ “ጎርታ ካቄሳር ቄሳርዉን፥ ካዋና ዋዉን ስሳ” አመ።<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>ሃንሱን ኡሱ ካአዬሰሮ ሃፉራ ጎሳ ሆረ ኡሱ አብን ላኮዳንዴን፥ አባብኬሳ ማሜንጉሬን ጫልኢ አመን።<verse eid="LUK 20:26"/></para>
  <para style="s1">ጎይኮ ክያኖኮት ሆስን</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ. 22፡23-33</ref>፤ <ref loc="MRK 12:18-27">ማር. 12፡18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>ጎይኮ ክያኖ ላግሮ ኦአማራን ሶዶቃውልኮ ኮኮ የሱሳ ቶስ ኤሜተንጉረነ ሆስን ሆሳተን። <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>ሃና አመን፥ “ካአጋልስሳቶ፥” እባዶት ኮ ኦር አታይጉረ ይስ ሀኡሙሎን ጎጎየ፥ አቢ ኤሰ ጋልታተት አታይረ ይስ ኡሙል አቢኬሳዉን ሳኒ ባንኤ ጎጎካይሮ “ሙሴ ኖን ጻፈራ። <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>ሀያ፥ አቢላል ቶዶባ ግቴ። ካሆሬ ኦር አታተጉረ ይስ ሀኡሙሎን ጎየ። <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>ካላምን ኡሱማሌ። <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>ካሴድና አደ አታተ፥ ቶዶባ ዱባ ኡሱማሌ አታተንጉሬነ ይስ ሀኡሙሎን ጎዬን። <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>ሃሬና ሄለልትቲ ጎተ። <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>ጎርታ ቶዶባ ኤሰ ማንኮአታተረ ማራን፥ ታጎይኮ ከያኖ አሪ ኤሰ ኦር ታዮ ልናታ?”<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>የሱሳና አባበረ፥ “ሂካ አላምኮክ እባዶ አታታራን፥ ኬሳራን። <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>ካኤሜታሮ አላምና ጎይኮ ክያኖ ኦኮንዶትሳራ ጎአመን ላኮአታታራን፥ ላኮናኬሳማራን። <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>ኤርግቻ ኣን ማንኮልናራን ማራን ኤሰኮ ዳንቤባን ላኮጎይናራን፥ ጎይኮ ማንኮኬን ማራን ይስ ካዋያን። <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>ሙሴ ጋራ ካሁርሰኮት ታጻፋንተቶ ጅርት ኦሮ ጎታነ፥ ካአብራመ ሄዶ፥ ካይሳቃ ሄዶ፥ ካያይቆባ ሄዶ አማኖ ኦጎየራን ካክናራን ላኖ ቱሳራ። <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>ዱባና ኡሱን አርዶኒዕ ማንኮሌን ማራን፥ ኡሱ አርዶኒዕኮክ ሄዶ ኳሬ ጎይኮክ ሄዶ ላኮዮ።”<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>ኮኮ ሴራ ካሙሴ ኦአጋልስሳሬና “ካአጋልስሳቶ፥ ታኢዳን አዬሰ፥ አመን።” <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>ኤሰኮ አባባተረን ኦዶ ኮና ዱዶ ኡሱ ሆሳይን ላኮዳንዴ።<verse eid="LUK 20:40"/></para>
  <para style="s1">ክርስቶሳ ኤረ ካዮያ?</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ. 22፡41-46</ref>፤ <ref loc="MRK 12:35-37">ማር. 12፡35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>ኤሰኮ አባባተረ የሱሳ ሃ አመ፥ “እባዶ ክርስቶሳ ምሲ ኤረ ካዳዉተያ አማራ? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/>ኣላንቲና ዳዉተ መተኬሳን ማዛሙርኮክ ማጻፋይ ሃ አመራ፥</para>
  <para style="q1" vid="LUK 20:42-43">“ ‘ዋ ጎታኬዉን፥</para>
  <para style="q2" vid="LUK 20:42-43">ዲናካ ሉክታይ አን ታዳዳርስሮ</para>
  <para style="q2" vid="LUK 20:42-43">“መርገቴይ ሀማጺ” ’ አመ።<verse eid="LUK 20:42-43"/></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44"/>ጎርታ ዳዉተ፥ ‘ጎታ’ አም ኡሱ ጎኡምሮ ምሲ ኤረኬሳ ላራ?”<verse eid="LUK 20:44"/></para>
  <para style="s1">የሱሳ ሴራ ካሙሴ ኦአጋልስሳራንኮ ጎሳ ሴርሳኖ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23፡1-36</ref>፤ <ref loc="MRK 12:38-40">ማር. 12፡38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>የሱሳ ጎሳ ዱባ ማላ ግራን ኡሱኮ ኦአጋልሳታራነ ሃ አመ። <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>“ካኤርክ ሳርስ ሳርሳቴረን ማራሙራኖ ኦጌላታራን፥ ታግያ ባንኤ ኖጎዳ ኣትን ኦዶታታራና፥ አይሁድኮክ ምን ካኤብ ካካባጃ ባርጩማ፥ ባንኤ ታአሞይና ታካባጃ ባንኤ፥ ኦዶታታራንኮ እስኦትስን ኦራዬን። <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>እሶና ካጋልታንቴል ምን ኦህዩምሳራንያን። ሙትን አመረን ኤብካክሶ ኤራሳታራን፥ ካሜላን ፍርዳ እሶ ኦራታራ።”<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">ጋልታንተት ካስሰቶ ሙጹዋታ</para>
  <para style="r">(<ref loc="MRK 12:41-44">ማር. 12፡41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>የሱሳ ጦቂ አም ጎዴሮ ዱሬሳጆል ቁሉክ ምን ካዋይ ሙጹዋታ ካኮኩኩይሳራን ሁይ ኦርዴሰን ሙጽዋታክሶ ሉጉዳ ግራን ዴ። <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>አደና ህየት ጋልታንተት ቶ ዶልቺ ላማ ሉጉዳ ዴ። <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>ሃና አመ፥ “አን ሩምና አማራ፥ ዱባንኮና ሮርሰ ህት ህየት ጋልታንተት ስሰታ። <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>ሂኒዕ እባዶጃ ካኮስሴራን ዎረኤክሶኮ ጎሌሮ፥ ኤሰ ጎአመን ካስሰታ ህዩማትሴኮክ ጅልባ ኦአብቶ ባርሳኖ ዱባ ስሰታ።”<verse eid="LUK 21:4"/></para>
  <para style="s1">ጌስ ጉዳታኖኮክ ማላታል</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶ. 24፡1-2</ref>፤ <ref loc="MRK 13:1-2">ማር. 13፡1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>ኡሱኮ ኦአጋልሳታራንኮ ኮኮ ቁሉክ ምን ካዋ ኤኤሞ ካእዳንክና ዋዉን ካስሳመሮ እላቦ ኢዳኖኮክ አዬሳ ግራን፥ <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>የሱሳና ሃ አመ፥ “ሂክ እስን ካደያታን ዱባ ሀዳርኣሞን ኤኤሞ ኤኤሞ ጉት ጎጎካካመሮ ታኮሄሶን አሪ ኤመይናታ።” <verse eid="LUK 21:6"/><verse number="7" style="v" sid="LUK 21:7"/>እሶና፥ “ካአጋልስሳቶ፥” ጎርታ “ሂክ ዱባ ካኮልናራ ጎሬያ? አደና ሂክ ሃ ካኮልናራ ማላታ መያ?” አመን ሆሳተን።<verse eid="LUK 21:7"/></para>
  <para style="s1">ታጎታ ኤሜቶኮ ሆረነ ታግናቶ ራኮና ባቃታኖ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ. 24፡3-14</ref>፤ <ref loc="MRK 13:3-13">ማር. 13፡3-13</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>የሱሳና ሃ አመ አባበ፥ “ጎጎሶሶይኖንኮ እስ ኦትስን ኦራዬን፥ ካሞጋን፥ ‘አን ክርስቶሳያ’ አማ፥ አደና፥ ‘ጎራታ ጋባላመራ’ አማ መገኬይ ኤሜይናራን። እስን ጎአመን እሶ ደቤና አሮሴቴን። <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>ጀሬን ከያኖኮክና ጎሳኮት ኤንገ ጎማልቴን አሮነይቴን። ሂክ ጣይ ሊን ካዶትሳሮያ፥ ጌስኮት ጋቾ አደ ጎርሰዋ ላኮልናቶ።”<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>አደና ሃ አመ፥ ጎሳ ጎሳ ጉት፥ ዎኖ ዎኖ ጉት ክናራ። <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>ካአቲ ኡልኮክ አኣኖ ልናራ፥ ኡኢና ህንጭነ ኡል ዱባ ልናታ። ካአብስስራ ኮኮ ኡሱማለና ዳሩርኮ ካአቲ ማላታ ልናራ። <verse eid="LUK 21:11"/><verse number="12" style="v" sid="LUK 21:12"/>ሂክ ዱባ ላኖኮ ሆረነ እባዶ ጎአመን እስን አብናራን። ሆሮርናራ፥ ፍርዲዉን አይሁድኮክ ምን ካኤብ ቶንሳ ጌስናራን ምን ካሻኖ ታብስናራን። ዎኖላልና ሞትጆል ሆረ ጌስናራን፥ ሂክ ዱባና መገኬኮት ኣላንቲ እስን ግናራ። <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>ህክና መገኬ አቶቲን ታኢዳንት ኢጣ እስኑን ልናታ። <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>ሃንሱን ካሞታምናታን ሞቶን መ አባብት ስንሳ አማ ታሪ ጎጎያዶንኮ ዎዳናይ አባዬን። <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>ዲናክስን እስን አዎዲና እስን ዲድን ካኮዳንደኖን ሃፉራና ቃሩማ አን እስኑን ስስናራ። <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>እስን ኦኡሙለራን፥ አቢላልትስን፥ ፋልክስና ሳትጆልክስን ዱዶ ሀሄሶን እስን ሮርስ ስስናራን። እስንኮና ኮኮ ላጋድናራን፥ <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>እዬን ማንኮአማናታን ማራን እባዶ ዱባ ዶሌ ካድዳንቴን ሌታን። <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>አየሱን ጎአመን መተክስንክ ፊጣ ኮና ላኮባሮ፤ <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>አታይ ኣላኖይ ኔፎታትስን ሃሳይናታን።<verse eid="LUK 21:19"/></para>
  <para style="s1">የሱሳ ኢየሩሳለምኮክ ባኖ ጣየ አዬሳኖ</para>
  <para style="r">(<ref loc="MAT 25:15-21">ማቶ. 25፡15-21</ref>፤ <ref loc="MRK 13:14-19">ማር. 13፡14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>አደና የሱሳ ሃ አመ፥ “ኢየሩሳለም ካጀረነ ዎታዳራል ማራንተ ታአባንተቶ ካኮዴተን ጎራታ፥ ባይካክሰ ጋባላማኖ አዴሳ። <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>ሀሱ ጎራታ ኡል ካይሁዳይ ኦግራን ዱባ ዎዳሚል ቶስ ሀባቃቴን። ካታማይ ኦግራና ኤሰኮ ሀቤን። ቃማነ ኦግራና ካታማ ኦርድ አሮታቦ። <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>ካጻፋመራ ዱባ ጎጎጉዳሮ ሂክ ካሙሮ ጎራታያ። <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>ኡል ጉት ታአቲ ራኮ ልናታ ሂካ ጎሳ ጉት ኤንገ ኤመይናታ። ሃንሱን ሀሱ አልማ ሄለል ካፋቶዉና ካኢልሳሮን ኣኔ እሶን! <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>ሺፋይና ጎይናራን፥ አይዛብ ዱባ ቶስ ቦጃም አታምናራን፥ ኢየሩሳለምና አይዛብ ኦዶናቲ ካኮባርሳራ ጌስ ታ ጉዳሮን አይዛቢ ኦዳዳራሜን ልናራን።<verse eid="LUK 21:24"/></para>
  <para style="s1">ኤረ ካእባዶኮክ ካላም ኤመቶ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶ. 24፡29-31</ref>፤ <ref loc="MRK 13:24-27">ማር. 13፡24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>“አሪ፥ ድግንና ባራጃ ጉት ማላታ ልናራ፥ ታበከና ታጋሽማሎ ያየኮ ካከይ፥ ኡሊ ጉት ካግራ ጎሳ ያድናራ፥ ሻላጋምናራ። <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>ሁና ካዳሩረና ማንኮአኢናሮ ማራን፥ እባዶ አብሲና አላም ጉት መ ካኤሜይናራ አማ ኦራታ ሀሹሩክ አምናራ። <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>ሀሱ ጎራታ ኤረ ካእባዶ ሁናይና ታአቲ ካባጃ ዱማንቻይ ኤመታ ግራን ድናራን። <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>እስና ሂክ አየስ ጉዳታኖ ካኮሀጋአብሮ ጎራታ፥ ፋይናክስን ማንኮጋባላመሮ ማራን፥ ቱኩል ኡማ አላ፥ ጦቂ አማ ኤልዳ ዎቻ” አመ።<verse eid="LUK 21:28"/></para>
  <para style="s1">ጎታኮት ኤመቶ ካቱሳሮ ጋ ካባላስኮክ ማሱሳ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶ. 24፡32-35</ref>፤ <ref loc="MRK 13:28-31">ማር. 13፡28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>አደ የሱሳ ሃ አማ ህታ ማሱሳ ሰገ፥ “ጋ ካባላስና ካካለ ጋጆል ዱባ ዲያ። <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>ባላሎኦትሶ ሁርሳ ግራን ጎዴታን፥ ሀሱ ጎራታ ባጤሳ ጋባላማኖ እስን ካሳንዋ። <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>ኡሱማለና አደ ሂክ አየስ ጉዳታኖ ጎዴተን፥ ዎኖናት ካዋ ጋባላማኖ ማላባ።<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>“አን ሩምና አማራ፤ ሂክ ዱባ ሊ ታሮሮ ህት አላታን ላኮሮርቶ። <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>ዳሩርና ኡልና ሮርናራን፥ ሃፉራካክ ጎአመን ላኮሮሮ።<verse eid="LUK 21:33"/></para>
  <para style="s1">አታይ ኦራታኖ</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>“ጎርታ ሜሳ ካልክ ግር፥ ጣሞኮክ ጂናኒ ባርሳኖኮኒዕ ያዳ ዎዳናትስን ጎጎድላፋኖንኮና ሀሴ አሪ ዎጣማደ አን ደራኣ ጎጎጌኖንኮ እስኦትስን ኦራዬን፤ <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>ሂክ ኡሊ ካግሮ እባዶ ዱባ ጉት ደራኣ ግናራ። <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>ሃንሱን ካኤሜታሮ ዱባኮና እስን ምልቅ ጎጎሄሳኑና ኤረ ካእባዶ ሆረ አልን ጎጎዳንዴታኑን አርጌቶ አታዬን ኤባየን።” <verse eid="LUK 21:36"/><verse number="37" style="v" sid="LUK 21:37"/>የሱሳና አሪ አሪ ቁሉክ ምን ካዋይ አጋልስሳ፥ ሄመን አደ ዛይቲ ካበያራ ጋ ታኮአላታሮ ዎዳሚ ቤ ባራረ። <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>ጎሳ ዱባና የሱሳ ማልን ቡላነ ቁሉክ ምን ካዋ ቶስ ኤመታ ግረ።<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">ጎታ የሱሳ ጉት ካፈላመሮ ዳባ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26፡1-5</ref>፤ <ref loc="MRK 14:1-2">ማር. 14፡1-2</ref>፤ <ref loc="JHN 11:45-53">ያን. 11፡45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>ሀሱ ጎራታ ፋስካ ካአማማረ ካባቦ ባላ ታኮካባጃምራ አሪ ጋባላንተ ግቴ። <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>ካቱቃሞል ዎይቻልና ሴራ ካሙሴ ኦአጋልስሳራን ጎሳ አብሳታ ማንኮግሬን ማራን፥ የሱሳ ታየል ላጋድራን ራ ዶታ ግረን።<verse eid="LUK 22:2"/></para>
  <para style="s1">ይሁዳ የሱሳ ሮርስ ስስን ኤካታኖ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ. 26፡14-16</ref>፤ <ref loc="MRK 14:10-11">ማር. 14፡10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>ቶሞንኮ ላማ ኦፋራመራን ዎታ ካቶታመረ ካአስቆሮቱ ኡልኮክ ይሁዳ ጻላየ ታብተ። <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>ሃንሱን ይሁዳ፥ ካቱቃሞል ዎይቻል ቶንሳ ቁሉክ ምን ካዋ ኦኦራራን ካአጃጃሮክ ቶስ ሴተጉረ የሱሳ ምሲ ሮርስ ስሳናሮ አዬሰ። <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>እሶና ሂካ አዬሲ ገገላተረን ማራጋደ ስስን ኤካተን። <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>ኡሱና ኡሱ አየስ ኤካተ፥ የሱሳ ሮርስ እሶን ስስን ጎሳ ታኮግኖቲ ካኤካሮ ጎራታ ኦራታ ግረ።<verse eid="LUK 22:6"/></para>
  <para style="s1">ካፋስካ ክታ ካሄመነ ኤካሳኖ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ. 26፡17-25</ref>፤ <ref loc="MRK 14:12-21">ማር. 14፡12-21</ref>፤ <ref loc="JHN 13:21-30">ያን. 13፡21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>ኤሰኮ አባባተረ ካፋስካ ኢዳዶ ካኮኤናኣማራ ካባቦ ባላ ጌ። <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>የሱሳና፥ “ካፋስካ ክታ ካሄመነ ኖ ጎጎአምኖ ሰዬንዴነ ኤካሳ” አመ ጣየ ጴጢሮሳና ያንሳና ፋረ። <verse eid="LUK 22:8"/><verse number="9" style="v" sid="LUK 22:9"/>እሶና፥ “ሀጌ ኖ ጎጎኤካንሶን ዶታታ?” አመን ሆሳተን።<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>ኡሱና፥ ሂክማ፥ “እስን ካታማ ቶስ ታባ ግራን ኡላ ታበከ ካስዳተሮ እባዶት ሄልናታን፥ ኡሱ ካኮታባሮ ምን ታጌታኒ ዴበ ሰዬነ። <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>ኦዶምነኔ፥ ‘ካአጋልስሳራ፥ እንኮ ኦአጋልሳታራነ ዎታ ካፋስካ ክታ ካሄመነ አን ታኮአምራ ታማርት ባንኤ ኤትታ? ሃ አማራ’ አማ። <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>ኡሱና ፎቂ ጉት ያንተደ ታኤካተቶ ታባላኣንት ክፍሊ ኡሱ እስኑን ቱስናራ ኤሴና ኢን ኤካሳ” አመ።<verse eid="LUK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13"/>እሶና ሴቴረነ ኡሱማሌ የሱሳ እሶን ጎጎሰጌሮክ ማለ ሌ ሄለሬነ፥ ፋስካና ኤሰ ኤካሰን።<verse eid="LUK 22:13"/></para>
  <para style="s1">ቁሉክ ባቦ ካዋ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶ. 26፡26-30</ref>፤ <ref loc="MRK 14:22-26">ማር. 14፡22-26</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፡23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>ሳትና ካኮጌተተ ጎራታ የሱሳ ኦፋራሜራነ ዎታ ቁሉክ ባቦ ኣምን ሀማጼ። <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>ሃና አመ፥ “አን ራኮ አታታናኮ ሆረነ ሂካ ካፋስካ ቁሉክ ባቦ እስን ዎታ ኣምን ኣሎ ሀልቻ ግረ። <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>አን እስኑን ሃ አማራ፥ ዎኖናት ካዋይ ሂካኮት ፉሬን ታጉዳቶ፥ ሂካ ካፋስካ ቁሉክ ባቦ ካላም አን ላኮኣምናሮ።”<verse eid="LUK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17"/>ጡጋ ኣተ ሶማሳተ አባባተረ ሃ አመ፥ “አህአይ፥ ዱባ ሂካኮ ሄዴዳማ፥ <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>አን እስኑን ሃ አማራ፥ ግዳኮ ሀጋአበረ ዎኖናት ካዋ ታ ኤሜሮን፥ ህታ ታዎይኒ ኢልኮ ካፈላመሮ ጣሞ ላኮጣምናሮ።”<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>ባቦና ኬሰረ ዋ ሶማሳተ፥ ኤካኤብሰ ስሰጉረ፥ “ሂኒዕ እስን ማራን ኦስሳማራን ሶኦቴያን። ሂካ እን ሻዲን የላየነ” አመ። <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>ኡሱማለና ክታ ካሄመነ አመን አባባተረነ ጡጋ ኬሰጉረ ሃ አመ፥ “ህት ጡጋ እስን ማራን ካኡባይናሮ ኢግኬይ ካልናሮ አማቶ ኦኡሱብያን። <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/>አየሱን ጎአመን እን ሮርስ ካስስናሮኮት ገነቴነ ዎታ ያላኣ ኦሮ ግታ። <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>ኤረ ካእባዶ ጣየ ዋ ጎጎሙርተሳመሮክ ማለ ጎይናራ አየሱን ጎአመን ኡሱ ሮርስ ካስስናሮ ሀሱ እባዶትን ኣኔ።”<verse eid="LUK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23"/>እሶና፥ እሶኦሮኮ ሂካ ሃ ካየልናራ አዮዮ እስኦሮ ሆሳታኖ ሀጋአበን።<verse eid="LUK 22:23"/></para>
  <para style="s1">ዱባንኮ ካሮራራ አዮያ</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>አደና እሶ፥ ኖ ኦሮኮ ካንጂንክ አዮያ አማ ኡሱኮ ኦአጋልሳታረን እሲኦሮ ዶጋማ ኬሴን። <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>የሱሳና ሃ አመ፥ “ካአይዛብ ዎኖላል ጎሳክሶ ሁና ባሪስናራን፥ እሶ ጉት ኦዶናት ኦአባን ‘ታኢዳን ኦፈላራን አማም ኡማምናራን።’ <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>እስን ዶሌ አድ ሃ አሮሌኖ። ጎሄሶን እስንኮ ካንጅንክ ካሌራ ክጫር ኣን፥ ሞት ካሌራና ካሀንዳሮ ኣን ሀሌዎ። <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>አየሱን ጎአመን ኢነ ዎታ፥ አሞን ካሀማጼሮኮና አሌ ካአምሳሮኮ ኤክያ ካጂናታራ? አሞን ካሀማጼሮዮላ? አን ጎአመን እስን ኦሮ ካግሮ ካሀንዳሮኮ ኮ አንያ። <verse eid="LUK 22:27"/><verse number="28" style="v" sid="LUK 22:28"/>እስና ራኮቴክ ጎራታ እንኮ ካለ አንቤኖን እዬ ዶሌ ኦአልተቴንታን። <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/>ኣቦክ እን ጎጎሹመሮ አንና አደ ዎኖናትኬይ እስን ሹምናራ። <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/>ህክና ዎኖናትኬይ አሞኬኮ ጎጎአንታኑና ጎጎጣንታኑን አደና ኮርፍንጄ ጉት ሀማጺዴን ቶሞንኮ ላማ ካእስራኤል ጎሳ ጉት ጎጎፍርድታኑንያ።”<verse eid="LUK 22:30"/></para>
  <para style="s1">የሱሳ ጴጢሮሳ ኡሱ ካካካይናሮ ጣየ አዬሰ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ. 26፡31-35</ref>፤ <ref loc="MRK 14:27-31">ማር. 14፡27-31</ref>፤ <ref loc="JHN 13:36-38">ያን. 13፡36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>አደና የሱሳ ሃ አመ፥ “ስሞና! ስሞና! ግዳ፥ ጻላየ እስን ዳርጋማ ኣን ባምጲኢን ዋ ሆሳተ። <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>አን አደ አማኖካ ጎጎባኖንኮ ኩ ማራን አን ዋ ኤባየ፥ አትና ካኮአባባተ ጎራታ አብላልታ አታይሳ።” <verse eid="LUK 22:32"/><verse number="33" style="v" sid="LUK 22:33"/>ስሞና፥ “ጎታኬ፥ አን ኩኔ ዎታ ሻምና፥ ጎይን ኤካሳየራ” አመ። <verse eid="LUK 22:33"/><verse number="34" style="v" sid="LUK 22:34"/>የሱሳና፥ “ጴጢሮሳ፥ ህታር ሉካለ ሀኦይኖን ግራን፥ አን ኡሱ ላኮካሶ አምደ ሴድ ጋል እን ካካይናታ አማራ” አመ። <verse eid="LUK 22:34"/><verse number="35" style="v" sid="LUK 22:35"/>ኤሰኮና የሱሳ፥ ኡሱኮ ኦአጋልሳታራንነ “ኮሮጆ ካሊ፥ ሽለ ካሊ፥ ከፈሮ ካሊ፥ እስን ካኮፋረረ ጎራታ እስኑን ካሀንቃተረ አየስ ግረ?” አመ ሆሳተ። እሶና “ኮና ኖን ላኮሀንቃተሮ” አመን።<verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>የሱሳና ሃ አመ፥ “ግዳ ጎአመን ኮሮጆና፥ ሽለና ካኮንግራ እባዶ ሀአባቶ፥ ሺፋ ካልክና ሳርስኬሳ ዳዳላይረ ሀኢምናቶ። <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>አን እስኑን ሃ አማራ፥ ‘ኦሜላነ ዎታ ቶታመ’ አማመ ካጻፋመረ እዬ ጉዳይን ዶትሳራ፥ እን ማራን ካጻፋመራ ካኮጉዳይናራ ጎራታ አዴሳመ ጌራ።” <verse eid="LUK 22:37"/><verse number="38" style="v" sid="LUK 22:38"/>የሱሳኮ ኦአጋልሳታረን፥ “ጎታ! ሂክማ ሺፋ ላማ ህታኒ ግሮዋ” አመን። ኡሱና “ሌራን” አመ።<verse eid="LUK 22:38"/></para>
  <para style="s1">የሱሳ ዛይቲ ካብያራ ጋ ታኮአላታሮ ዎዳሚ ኤባተ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ. 26፡36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14፡32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>የሱሳ ጎጎካሳናየ ዛይቲ ካበያራ ጋ ታኮአላታሮ ዎዳም ቶስ ሴተ፥ ኡሱኮ ኦአጋልሳታረና ኡሱ ዴበ ሴተን። <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>ኤሰራና ካኮገያነ ጎራታ፥ የሱሳና፥ “እስን ጫፍት ኦሮድ ጎጎታቦንኮ ኤባየን” አመ።<verse eid="LUK 22:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41"/>እሶኮና ኤኤሞ ሻፋመረ ሴተ ካኮኤያሮ ግታክ ፋክ አመረ ግልቢሰ ኤባተ፥ <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>ሃና አመ፥ “ኣቦኬ፥ ፈኢታ ጎሌተ፥ ህታ ታራኮ ጡጋ እንኮ ኣትና። አየሱን ጎአመን ፈኢቴ ሀሌኖን ግራን ፈኢታ ሀሌቶ።” <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>ኤርግቻ ዳሩርኮ ኡሱን ሙተጉረ ኡሱ አታይሰ። <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>ኣሎ ሙዳመረ አታተ ኤባታ ግረ። ፎጎሎ ካአቲ ኢግኮክ ጫጫርቃታኖ ኣን ኡሊ ኡባታ ግረ።<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>ኤብኮና ኬጉረ ኡሱኮ ኦአጋልሳታራን ቶስ ኤመተ፥ እሶና ያዳኮ ካኮኬይ ኦሁዱሬራን ሄለረ ሃ አመ። <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>“ሙን ሁዱርቴታን?” ጫፍት ኦሮድ ጎጎታቦንኮ “ክያዴን ኤባየን አመ።”<verse eid="LUK 22:46"/></para>
  <para style="s1">የሱሳ አባመ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26፡47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14፡43-50</ref>፤ <ref loc="JHN 18:3-11">ያን. 18፡3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>ኡሱና ጋና አዬሳ ግራን፥ ካሞጋን እባዶ ኤመተ። ቶሞንኮ ላማኮ ኮ ይሁዳ ካአማመረ እባዶት ሆረ ሀየ ገጌሳ ግረ፥ አንጋዪና የሱሳ ቶስ ጋባላመ። <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>የሱሳና አደ፥ “ይሁዳ፥ ኤረ ካእባዶ አንጋታኖይ ሮርስ ስስናታ?” አመ።<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>የሱሳ ማራሙረን ኦግረን ኡሱኮ ኦአጋልሳታረን አየስ ታላሮ ዴንጉሬን “ጎታ፥ ሺፋይ ጎንሱ?” አመን። <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>እሶኮና ኮ ካቱቃሞል ዎይቻሉን ካሀንዳሮኮ ባሰጉረ ነበ ታመርገ ጎሰ።<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>የሱሳ አደ፥ “ኢሳ! ሂካ ኣንክክ አየስ አሮፈልቴን አመ።” ታእባዶቲ ነበና ድነጉረ ፋይሰ።<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>ኤሰኮና የሱሳ አብን ኦኤመቴረን ካቱቃሞል ዎይቻል፥ ቁሉክ ምን ካዋ ኦኦራራን ካአጃጃሮነና ጃርሶለነ ሃ አመ። “ሽታ ካአብናሮ እባዶ ኣን፥ ሺፋና ዱላ አብተዴን ኤሜቴን? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>አርጌቶ ቁሉክ ምን ካዋይ እስን ዎታ ታኮግረ እን ላኮአብተቴን። ሂክ ጎአመን ሙጉድ ካኮሬደሮ ጎራታክስንያ።”<verse eid="LUK 22:53"/></para>
  <para style="s1">ጴጢሮሳ የሱሳ ካካተ</para>
  <para style="r">(<ref loc="MAT 26:57-58">ማቶ. 26፡57-58</ref>፥<ref loc="MAT 26:69-75">69-75</ref>፤ <ref loc="MRK 14:53-54">ማር. 14፡53-54</ref>፥<ref loc="MRK 14:66-72">66-72</ref>፤ <ref loc="JHN 18:12-18">ያን. 18፡12-18</ref>፥<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>ኤሰኮ አባባተረን የሱሳ አበን ጌሰን። ቱቃሞን ኦዶናት ካአቦኮክ ምን ቶስ ታብሰን። ጴጢሮሳና ፋክመ ኡሱ ዴበ ሰሴታ ግረ። <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>እባዶ ካቱቃሞል ዎይቻልኮክ አዉድ ኦሮ ኤለን ቤብሰኔን ኮሌን ሀማጼሬን ግራን፥ ጴጢሮሳና እሶ ዎታ ሀማጼ ግረ። <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>ድይት ቶ ጴጢሮሳ ኤለን ዶሌ ካሀማጼሮ ትችሰ ዴተደ “ሂክ እባዶት አደ የሱሳ ዎታ ግረ” አንተ። <verse eid="LUK 22:56"/><verse number="57" style="v" sid="LUK 22:57"/>ጴጢሮሳ አደ፥ “አት ሄለልትቲ፥ አን ኡሱ ላኮካሶ” አመ ካካተ። <verse eid="LUK 22:57"/><verse number="58" style="v" sid="LUK 22:58"/>አባራን ጋጭመረ ካካለ እባዶት ኮ ኡሱ ዴረ፥ “አትና አደ እሶኮ ኮታ” አመ። ጴጢሮሳ ጎአመን፥ “አት እባዶት፥ ላኮአንዮ” አመ።<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>ሳቲ ቶ ግታ ጋጭመረ ካካለ እባዶት ኦግራን፥ “ሂክ እባዶት ካጋሊላ ማንኮሌ ማራን ሄዳታኖ ካሊ የሱሳ ዎታ ግረ” አመ። <verse eid="LUK 22:59"/><verse number="60" style="v" sid="LUK 22:60"/>ጴጢሮሳ አደ፥ “አት እባዶት አት ካአዬሳቶ አየስ አን ላኮካሶ” አመ። ሂካና አዬሰረ ጋና ሀጉድሶን ግራን ሉካለ ኦየ። <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>ጎታ የሱሳ ካምባል አመረ ጴጢሮሳ ዴ፤ ጴጢሮሳና፥ “ህታር ሉካለ ሀኦይኖን ግራን ሴድ ጋል እን ካካይናታ” አመ፥ ጎታ ኡሱን ካአዬሰሮ ሃፉራ ቃል አመ። <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>ጴጢሮሳና ሳር ቤጉረ ዩሩሩ አመ ኦተ።<verse eid="LUK 22:62"/></para>
  <para style="s1">ዎታዳራል የሱሳ ጉት ቃጭፋተ</para>
  <para style="r">(<ref loc="MAT 26:67-68">ማቶ. 26፡67-68</ref>፤ <ref loc="MRK 14:65">ማር. 14፡65</ref>፤ <ref loc="JHN 18:22-23">ያን. 18፡22-23</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>የሱሳ አበን ኦራ ኦግረን እባዶጃ ቃጭፋታና ኡሱ ባሳኖ ሀጋአበን። <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>ኢልኦና ጎልሰሬነ፥ “አላ ካሄገሮ ጎሌተ፥ ኩ ካባሰ አዮያ ኖን ሰጊ?” አማ ኡሱ ሆሳታ ግረን። <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>ኡሱ ሀባራና የራሳ ግረን።<verse eid="LUK 22:65"/></para>
  <para style="s1">የሱሳ ጲላጦሳና ሄሮዶሳ ሆረ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ. 26፡59-66</ref>፤ <ref loc="MRK 14:55-64">ማር. 14፡55-64</ref>፤ <ref loc="JHN 18:19-24">ያን. 18፡19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>ኡል ካኮባሬረ ጎራታ፥ ጃርሳ ካኡሌ፥ ቱቃሞኮክ ዎይቻልና ሴራ ካሙሴ ኦአጋልስሳረን ራቶ ኩኩአመን፥ የሱሳ ታአይሁድ ሾንጎ ቶስ ጌሰን። <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>እሶና፥ “አት ካፋይሳሮ ክርስቶሳታ? አላ ሰግን” አመን። የሱሳና ሃ አመ። “አን እስኑን ጎሰጌና እስን እን ላኮአማናይናታን። <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>እስን ጎሆሳየና ኢን ላኮአባብናታን። <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>አየሱን ጎአመን ሂታኮ ሀጋአበረ ኤረ ካእባዶ ሁና ካዋኮት መርጌ ሀማጽናራ።” <verse eid="LUK 22:69"/><verse number="70" style="v" sid="LUK 22:70"/>ሀሱ ጎራታ ዱባና፥ “ሀያ፥ አት ኤረ ካዋታ?” አመን። የሱሳና፥ “ላኖኬ ሂክማ እስንዋ ሰጋታን” አመ። <verse eid="LUK 22:70"/><verse number="71" style="v" sid="LUK 22:71"/>እሶና፥ “ጎርታ ካካለ አቶናት መ ዶትሳራ? ኖ መተካኑን ህኢቴሳኮ ማልነና!” አመን።<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s1">የሱሳ ጲላጦሳ ቶስ ጌሰን</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27፡1-2</ref>፥<ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር. 15፡1-5</ref>፤ <ref loc="JHN 18:28-38">ያን. 18፡28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>ኤሰ ኩኩአመረ ካግረ እባዶ ዱባ ኬጉረ የሱሳ ጲላጦሳ ቶስ ጌሰን። ሃ አማና ሞቶ ሀጋአበን። <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>“ሂክ እባዶት ጎሳካን ሶሶይሳ፥ ቄሳርዉን ጊራ ጎጎሙራሞንኮ ትራ፥ አደና፥ አን ክርስቶሳ ካፋይሳሮ ዎኖያ አማ ግራን ሄልነና።” <verse eid="LUK 23:2"/><verse number="3" style="v" sid="LUK 23:3"/>ጲላጦሳ፥ “አት ካአይሁድ ዎኖታ?” አመ የሱሳ ሆሳተ። የሱሳና እ “አት ጎጎአማቶያ” አመ። <verse eid="LUK 23:3"/><verse number="4" style="v" sid="LUK 23:4"/>ኤሰኮና ጲላጦሳ ካቱቃሞል ዎይቻልነና ጎሳነ፥ “አን ሂካ እባዶት ጉት ባስ ኮና ላኮሄለሮ” አመ። <verse eid="LUK 23:4"/><verse number="5" style="v" sid="LUK 23:5"/>እሶ አደን፥ ሂክ እባዶት ጋሊላኮ ሀጋአበረ ህታ ታጌሮ ኡል ካይሁዳ ዱባ ሀሄሶን ጎሳ አጋልስሳ ሻላጋራ አመን አታይሰን አዬሴን።<verse eid="LUK 23:5"/></para>
  <para style="s1">የሱሳ ሄሮዶሳ ሆረ ኣላኖ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>ጲላጦሳና ሂካ ካኮማላረ ጎራታ፥ “ሂክ ካጋሊላ እባዶትያ?” አመ ሆሳተ። <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>የሱሳ ካሄረዶሳ ቃላዳኮ ካኤመተሮ ላኖ ጲላጦሳ ካኮአዴሰረ ጎራታ፥ ሄሮዶሳ ሀሱ አልማ ኢየሩሳለም ማንኮግረ ማራን የሱሳ ሄሮዶሳ ቶስ ፋረ። <verse eid="LUK 23:7"/><verse number="8" style="v" sid="LUK 23:8"/>ሄረዶሳና የሱሳ ድን ካሞጋን ጎራታ ዶታ ማንኮግረ ማራን፥ የሱሳ ካኮደያረ ጎራታ ኣሎ ገጌላተ። ጋራኬሳክ አየስ ማለ ማንኮግረ ማራን ኡሱ ባሳ ጎፈለ ድን አብድ የላታ ግረ። <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>ሄሮዶሳ ሆስን ታሞጋን የሱሳ ሆሳተ፥ ኡሱ ጎአመ ቶና ላኮአባበሮ። <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>ቱቃሞኮክ ዎይቻልና ሴራ ካሙሴ ኦአጋልስሳራን ኤሰ አሌረነ አታይሰን ሞታ ግረን። <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>ሄሮዶሳ ዎታዳራልኬሳ ዎታ ኡሱ ቱፊ ቃጭፋተ፥ ካካባጃ ሳርስ ሳርስሰጉረ ጲላጦሳ ቶስ ፋረ። <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>ሄረዶሳና ጲላጦሳ ኤሰሪ ሳትንተ ናቃቴን፥ ጣየ ጎአመን እሶ ኦሮ ቁጠ አባናየን።<verse eid="LUK 23:12"/></para>
  <para style="s1">የሱሳ ካጎይ ፍርዳ ፍርዳመ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶ. 27፡15-26</ref>፤ <ref loc="MRK 15:6-15">ማር. 15፡6-15</ref>፤ <ref loc="JHN 18:39-40">ያን. 18፡39-40</ref>፤ <ref loc="JHN 19:1-16">19፡1-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>ጲላጦሳና ቱቃሞኮክ ዎይቻል፥ ካአይሁድ ሞትጆልና ጎሳና ራቶ ኩኩይሰረ፥ <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>ሃ አመ፥ “ሂክ እባዶት ጎሳ ሜላነዉን ከኬሳራ አንተዴን ኡሱ እን ቶስ ኬንቴተን፥ አንና እስን ሆረ አየስ ቁሌሴረ፥ እስን ካኬንተቴን ሞቶን ባስ ኮና ላኮሄለሮ። <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>አደ ሄሮዶሳ ኡሱማሌ ኮና ሄላኖ ዋት ኖ ቶስ ኡሱ አባበራ። እስን ጎጎድያታኒ ሂክ እባዶት ጎይን ካጌግስሮ ኮና አየስ ላኮፈለሮ። <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>ሃንሱን አን ኡሱ ቦጪረ ፉርናራ።” <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>[ሂካ ኡሱ ካኮንአመረ ካፋስካ ባላይ እባዶት ኮ ሻኖኮ ጎጎፉራምሮ ማንኮዶትሳረ ማራንየ።]<verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>ጎሳና ዱባ ራቶ ሌረ፥ “ሂካ እባዶት ላጋድ! ባርባነ ኖን ፉር!” አማ እዬን። <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>ባርባነና ካታማ ኦሮ ጎሳ ሜላነይ ከኬሳኖይና ኔፎ ላጋዳኖይ ካሽያመረ እባዶትየ።<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>ጲላጦሳና የሱሳ ፉርን ማንኮዶተረ ማራን፥ አደ አባበ ጎሳ አዬስሰ። <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>ጎሳ ጎአመን፥ “ሱይና! ሱይና” አማ እያ ግረ።<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>ጲላጦሳና ሴድ ጋለ፥ “መዉን? ሂክ እባዶት ካፈለራ ባስ መያ? ኡሱ ካላጋስስሮ ባስ ኮና አን ላኮሄለሮ፥ ሃንሱን ቦጪረ ፉርናራ” አመ።<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>እሶ ጎአመን ያየትሶ ጦቂኢሴነ የሱሳ ጎጎሱዋምሮ አታይሰን ኡሱ ኤባተን፥ ኢያክሶና አዎዳተ። <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>ሃንሱን ጲላጦሳ እሶ ካሆሳተራን ፈሎ ጎጎሀይሮን ፍርዴ። <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>ጎሳ ሜላነይ ከኬሳና ኔፎ ላጋዳኖ ሻመ ካግረ፥ ጎጎፉራምሮ ካኤባተናን ኣንክ ባርባነ ፉረ። የሱሳ አደ እሶ ታጌላቴን ጎጎየላራዉን ሮርሰ ስሰ።<verse eid="LUK 23:25"/></para>
  <para style="s1">የሱሳኮክ ሱዋማኖ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ. 27፡32-44</ref>፤ <ref loc="MRK 15:21-32">ማር. 15፡21-32</ref>፤ <ref loc="JHN 19:17-27">ያን. 19፡17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>የሱሳ አበን ጌሳ ግራን፥ ስሞና ካአማመረ ካቀሬና እባዶት ጋጣረኮ ካኤሜታሮ ሄሌንጉሬነ ማስቃሊ ስድሴረን የሱሳ ዴበ ጎጎሴሮ አበን ሁኖመን።<verse eid="LUK 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27"/>ካሞጋን ጎሳና ጌግዮታትሶ ባባሳታ ካኦታረ ሄለልና የሱሳኮ ሃሬ ዴበ ሰሴታ ግረን። <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>የሱሳ አደ እሶ ቶስ ካምባል አመረ ሃ አመ፥ “እስን ካኢየሩሳለም ሄለል እስኦትስኑና ይስክስኑን ኦዬነ ኳሬ እዬን አሮኦቴን። <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>‘ሂክማ ማሴናጆልና ታኡሙሎን ግታ ገዴም፥ ሀኢልሶን ኦግራን ናሳሶ ኦሶማሳመንያን’ እስን ካኮአንታን ጎራታ ኤመይናራ። <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>ሀሱ ጎራታና፥ እሶ ‘ዎዳሚልነ “ኖ ጉት እያ” ጋጋጆሉና “ኖ ጎልሳ አምናራን።” ’<verse eid="LUK 23:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31"/>ጎርታ ጋ ኡንጃነክ ሃ ጎየሌን፥ ካአንጋገ አድ ምስ የልናረን?”<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>ኡሱነ ዎታ ላጋዲን ኦካለ ባስ ኦፈለራን ላማ ኣተን ሴተን። <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>ቀራንዮ ታአማንተቴ ባንኤ ካኮገያረን ጎራታ ሱዬን፥ ባስ ኦፈለራና ኮ ምና ታመርገነ ኮ ምና ታበተነ ሱዬን። <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>የሱሳና፥ “ኣቦኬ! እሶ ካፈላራና ላኮካሳን እሶን ሀሄሶ አምና” አመ። እሶና ሳርስኬሳ ኢጣይ ሄዴዳመን።<verse eid="LUK 23:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35"/>ጎሳና አሌረ ዲያ ግረ። አይሁድኮክ ዎይቻልና፥ “ካካለ እባዶ ፋይሰራ። ዋይ ካአሳባመሮ ክርስቶሳ ጎሌ፥ አላ ኡሱ እስኦቴሳ ሀሃሳቶ” አማ ቃጭፋቴን።<verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>ዎታዳራልና ጋባላመረ ካኦኮኮታሮ ጣሞ ካዎይኒ ስሳና ቃጭፋታ ግረ። <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>“አት ካአይሁድ ዎኖ ጎሌተ፥ እስኦታ ሃሳ አማ ግረን።”<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>መተኬሳኮ ጉንተ ማስቃሊ ጉት፥ “ሂክ ካይሁዳ ዎኖያ” ታአማታ ጹፍ ግቴ።<verse eid="LUK 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>ፈሎ ኦሜላን ፈሌረነ ኦሱዋሜሬንኮ ኮ፥ “አት ላ ካፋይሳሮ ክርስቶሳቶላ? አላ፥ እስኦታና ኖና ሃስ” አማ ሀባራ ግረ።<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>ካላምክና ጎአመን ሃ አመ ኡሱ ሀድሰ፤ “ኖ አማለኮክ ፍርዳ አታታ ግራንቲ፥ አት ዱዶ ዋ ላኮአብሳቶያ? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>ኖ ኦፈልነኖ ፈሎይ ሙሮ ኦአታታኖ ማንኮሌነኖ ማራን፥ ካዶትሳሮ ፍርዳ ጉት ግና። ሂክ እባዶት ጎአመን ኮና ካሜላን አየስ ላኮፈለሮ።”<verse eid="LUK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42"/>አደና፥ “የሱሳ፥ ዎኖናትካይ ካኮኤሜተ ጎራታ እን ሻድና” አመ።<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>የሱሳና፥ “አን ሩምና አማራ፥ ህታር ኢነ ዎታ ጋናቴ ግርናታ!” አመ።<verse eid="LUK 23:43"/></para>
  <para style="s1">ጎይ ካየሱሳ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27፡45-56</ref>፤ <ref loc="MRK 15:33-41">ማር. 15፡33-41</ref>፤ <ref loc="JHN 19:28-30">ያን. 19፡28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>ሀሱ ጎራታና ሳቲ ሌ ካሌሮየ፥ ሳቲ ሳጋሊ ታጌቶ ኡል ዱባይ ጉት ሙጉድ ሌ። <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>አርት ሙጉድ ሌተ፥ ቁሉክ ምን ካዋኮክ ጎጎሎ ፊላመ ላማ ባንኤ ቤ። <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>የሱሳና ያየ ታአቲት እዬ፥ “ኣቦኬ፥ አያናኬ አን ገነታይ ስሳታራ!” አመ። ሃና አመረ ጎየ።<verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>ዎታዳራ ቦሉን ዎይቻና ካሌሮ አየስ ካኮደያረ ጎራታ፥ “ሂክ እባዶት ኦግራን ቁሉክየ” አመረ ዋ ጋላቴ። <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>ሂካና ድን ኤሰ ባንኤ ኩኩመ ካግረ እባዶ ዱባና ካሌሮ አየስ ካኮደያረ ጎራታ ጌግዮትሶ ቦቦጫታ ምን አባባተን። <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>አየሱን ጎአመን የሱሳ ኣሎ ኦካሳናዬን ዱባ ኡሱማሌ ጋሊላኮ ካየረ ዴበ ካሰሰታረ ሄለል ሂካ ዲያ ፋክመ አሌ ግረ።<verse eid="LUK 23:49"/></para>
  <para style="s1">ቃማላማኖ ካየሱሳ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27፡57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15፡42-47</ref>፤ <ref loc="JHN 19:38-42">ያን. 19፡38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>አይሁድኮት ሾንጎ ኡና ካሌረ ዮሴፋ ካአማመረ ካእዳንክና ቁሉክ እባዶት ግረ። <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>ሂክ እባዶት ታሾንጎ ማርካና ኦፈላሬን ፈሎ ዎታ ላኮሌረ። ኡሱና አርማትያስ ታአማንተቴ ታይሁዳ ካታማኮክ እባዶት ጎሌሮ፥ ዎኖናት ካዋኮት ኤመቶ ኦራታ ግረ። <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>ሂክ እባዶትና ጲላጦሳ ቶስ ሴተረ ሬስ ካየሱሳ ኤባተ። <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>ኡሱን ፈኢ ካኮስሳማተ ጎራታና ሬስ ዳግሰረ ታቃማል ጋሼ ኢድሰረ፥ ኤኤሞኮ ቆራመ ፈላመ ካኤካተሮ ዱዶ ማዮና ቃማላሞን ታኮግሮ ባንኤ ቃማለ። <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>አርና ታኮኤካሳታናን አርተ። አይሁድን ታፎሊስ አሪ ሀጋአቢን ላቴ።<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>ጋሊላኮ ካየረ የሱሳ ዎታ ካኤመተረ ሄለልና ዴበ ሰሴታ ታቃማል ባንኤ ዴ። ሬስና ምሲ ቃማሌራን ዴ። <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>ኤሰኮ ምንክሶ አባባተረን ሽቶና ቅባት ሬሱን ኤካሰን፥ ሴራ ጎጎሰጋሮክ ማለ አይሁድን ታፎስ አሪ ፎልሳቴን።<verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">የሱሳኮክ ጎይኮ ክያኖ</para>
  <para style="r">(<ref loc="MAT 28:1-10">ማቶ. 28፡1-10</ref>፤ <ref loc="MRK 16:1-8">ማር. 16፡1-8</ref>፤ <ref loc="JHN 20:1-10">ያን. 20፡1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>አልማኮ ታሆሬ አሪ ሄለል ታኤካሳተራን ሽቶ አበረ ኡል ቡላኦዋ ግራን ቃማል ቶስ ሴተ። <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>ቃማል ጉኮ ካኦቶቶለሮ ኤኤሞ ዴን። <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>ኦሮዴን ካኮታባሬን ጎራታ አደ ጎታ የሱሳኮክ ሬስ ላኮሄሌን። <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>ኡሱ አዬሲ ግርድ አመን ግራን፥ ኣሎ ካሀንቃሮ ሳርስ ኦሳርሳቴራን እባዶጃ ላማ ደራኣ እሶ ዶሌ አሌን። <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>ሄለልጃና አብስኮ ካከይ ሁስ አመን ግራን፥ እባዶጃ ሃ አመን “አርዶክ ካሌሮ ኡሱ ቃማል ኦሮኮ ሙን ዶታታን? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/>ኡሱ ኬራ! ህታኒ ላኮግሮ፥ አደና ጋሊላይ ታኮግረ መ ኡሱ እስኔ አመሮ ሻዳ። <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/>‘ኤረ ካእባዶ ገነ ታጩባለሳይ ሮር ስሳምን፥ ሱዋሚና ታሴድ አሪ ጎይኮ ኪን ዶትሳራ’ አመ ግረ።”<verse eid="LUK 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>ሄለልና ሀሱ ጎራታ ሃፉራ ካየሱሳ ሻደ። <verse eid="LUK 24:8"/><verse number="9" style="v" sid="LUK 24:9"/>ሄለልና ባንኤ ታቃማልኮ አባባተረ ሂካ አየስ ዱባ ቶሞንኮ ኮዉና ካካለ እባዶ ዱባን ሰገን። <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>ሂካ አየስ ኦፋራሜራዉን ኦሰጌራና፥ ካመግደላ ኡልኮት ማይራመ፥ ዮሃና፥ አዬ ታያይቆባ ማይራምኔ እሶነ ዎታ ካካለ ሄለልና ግረ። <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>እሶ ጎአመን ሄለል ካአዬሰረ አየስ ካዳንዶዋራን አን እሶን ማንኮሌ ማራን ላኮአብዳተረን። <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>ጴጢሮሳ ጎአመን ኬጉረ ቃማል ቶስ ቲየ። ኤሰራ ጌጉረና ሁስ አመረ ኦሮድ ጎዎችሮ ጋሸ ታላል ግራኖ ዴ። ካሌሮ አየሱን ማማ ምንኬሳ አባባተ።<verse eid="LUK 24:12"/></para>
  <para style="s1">ራ ካኤማሁስ</para>
  <para style="r">(<ref loc="MRK 16:12-13">ማር. 16፡12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>ኤሰ አሪ የሱሳኮ ኦአጋልሳታረንኮ ላማ፥ ኢየሩሳለምኮ ኩማ ቶሞንኮ ኮ ታላብስ ግታክ ፋክ ካአመ፥ ኤማሁስ ካአማማሮ ማማን ቶስ ሴታ ግረን። <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>እሶና ካሌሮ አየስ ዱባ እስ እስስኦሮ አዬሳ ግረን። <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>አዬሳና ሰሰታን ጉት ግራን የሱሳና እሶ ቶስ ጋባላመረ እሶነታ ሴታኖ ሀጋአበ። <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>አየሱን ጎአመን እሶ ኡሱ ጎጎአዴሶንኮ እልኦ ኦትሶ አባሜን ግረን። <verse eid="LUK 24:16"/><verse number="17" style="v" sid="LUK 24:17"/>የሱሳ፥ “እስን ሰሴታ ግራን፥ ራድ እስ እስኦሮ ሃ ካአዬሳቴን መያ?” አመ።</para>
  <para style="p" vid="LUK 24:17">እሶና ኣሎ ያዳ ኦሮ ታቤን ቶልሜን አሌን። <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>እሶኮና ኮ፥ ቀልዮጳ ካአማመረ፥ “ሂናኣ አርጆሊ ህታኒ ኢየሩሳለም ካሌሮ አየስ ካካሶን፥ አት ኡሉን ማርትታ?” አመ አባበ።<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>የሱሳ፥ “ካሌራ አየስ መያ?” አመ። እሶና ሃ አመን። ዋይና እባዶ ዱባ ሆረ ፈሎይና ሃፉራይ ካአቲ ካሄገሮ ማንኮሌረ ማራን፥</para>
  <para style="p" vid="LUK 24:19">“ህክና ካናዝረት የሱሳ ጉት ካፈላመሮ አዬስያ። <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>ኡሱ ቱቃሞኮክ ዎይቻልና ሞትጆልካን ጎይኮክ ፍርዳን ኡሱ ሮርሰን ስሰን፥ ሱዬን። <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>ኖ አንዴ ካእስራኤል ጎሳዉን ዎዶ ሌሮዋ አምነ አብድ ካየላነኔ ኡሱየ። ካካለኮና አደ፥ ሂክ ሃ ጎሌኮ ህታር አሪ ታሴድታ። <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>አደና ኖ ኦሮኮ ሄለል ኮኮ ኖ ማምሰ፥ እሶና ቡላነ ቃማል ቶስ ሴተሬን። <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>ሬስና ካኮዋታሬን ጎራታ ኤሜተረን ‘የሱሳ ኔፎነ ግራ’ ኦአማራን ኤርግቻል ራጋ ዴነ አማ አባባተን ኤመተን ኖን ሰገን። <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>ኖ ኦሮኮ ኮኮ ቃማል ቶስ ሴተረ፥ ልክ ሄለል ጎጎአመሮ ካሌሮ ዴን። የሱሳ አደ ላኮዴረን።”<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>የሱሳ ሃ አመ፥ “እስን ጎዎሌ እባዶ፥ ዎዳናትስና ካሄገሮል ካአዬሰናን ዱባ አማናታና ዋቲ አዳላተ፥ <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>ክርስቶሳ ሂካ አየስ ህታ ራኮ አታታኖና ካባጃ ቶስ ታባኖ ላኮዶትሳሮያ?” <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>ሙሴኮና ካሄገሮ ዱባኮ ሀጋአበረ ቁሉክ ማጻፋጆል ጋራኬሳ ካጻፋመሮ ቱሳ ፉረ ሰገ።<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ካሴታረን ማማን ካኮጋባላመሬን ጎራታ፥ የሱሳ እስ ካሮርናሮ ኣን ሌ። <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>እሶ አደን፥ “አርት ኢተ ቡይተታ፥ ኡል ሄመን ላራ፥ ሃንሱን ኖኔ ዎታ ህታኒ ባር!” አመረን አታይሰን ኤባተን። ሃንሱን እሶነታ ባርን ታበ።<verse eid="LUK 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30"/>እሶነታ ባቦ ኣምን ካኮሀማጼረ ጎራታ ባቦ ኬሰረ ዋ ጋላቴረ ኤብሰ እሶን ስሰ። <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>ኡሱ ጎራታ እልኦ ኦትሶ ባናመሬን የሱሳ ላኖ አዴሰን፥ ኡሱና እሶኮ ስያመ። <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>እሶና፥ “ኖ ራድ ግራን፥ ኖ አዬስሳ ቁሉክ ማጻፋና ባነ አጋልስሳ፥ ዎዳናታን ጉባታ ላግቴላ?” አመን።<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33"/>ኡሱ ጎራታዋ ኬንጉሬነ ኢየሩሳለም አባባተን ሴተን። ቶሞንኮ ኮ ኡሱኮ ኦአጋልሳታራና ኦካለ እሶነ ዎታ ኮሌን ኩኩሜን ኦግራን ሄሌን። <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>እሶና፥ “ጎታ የሱሳ ኦግራን ኬራ! ስሞናና ሙተራ” አማ ግረን። <verse eid="LUK 24:34"/><verse number="35" style="v" sid="LUK 24:35"/>የሱሳኮ ኦአጋልሳታረን ላማ ራድ ካሌሮ አዬስና የሱሳ ባቦ ኤብሰ ካኮስሳረ ጎራታ ምሲ እሶን አዴሳመሮ ሰገን።<verse eid="LUK 24:35"/></para>
  <para style="s1">የሱሳ ኡሱኮ ኦአጋልሳታራዉን ሙተ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28፡16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16፡14-18</ref>፤ <ref loc="JHN 20:19-23">ያን. 20፡19-23</ref>፤ <ref loc="ACT 1:6-8">ኦፋ. ፈ. 1፡6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>እሶ ሂካ አዬሳ ግራንቲ፥ የሱሳ እሶ ኦሮ አሌረ፥ “ኖጎዳ እስኑን ሀሌቶ” አመ።<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>እሶ አደ ኔንጉሬነ አብሳተን። ጋሪ ካዴራን ኣን እሶን ሌ። <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>የሱሳና ሃ አመ፥ “ሙን ንያታን? ዎዳናትስኒ ሙን ሄዳታን? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>ገነኖኦቴና ሉቃቆኦቴ ዲያ፥ አንዋያ። አዳ. እን ድና ዲያ፥ እን ጉት ጎጎድያታኒ ጋር ሶና ለፋልና ላኮአብቶ።”<verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>ሂካ አመጉረ ገነኖና ሉቃና እሶን ቱሳተ። <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>እሶና ገገሎኮና ማማኖኮ ካከይ ጋና ሀአብዳኖን ግራን፥ “ህታኒ ኮኮ ካአምራን አብታነ?” አመ። <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>እሶና ኤለኒ ካዱባመሮ ኩኑኡብኮ ኡሱን ስሰን። <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>የሱሳና አታተረ እሶ ሆረ አመ።<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>ኡሱና፥ “አን እስነታ ታኮግረ፥ ሴራ ካሙሴይ፥ ካሄገሮልና ማዛሙርኮክ ማጻፋይ እን ማራን ካጻፋመረ ዱባ ጉዳይን ዶትሳራ አመ አን እስኑን ካሰጌረ ሃፉራክ ሂካያ” አመ።<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>ኡሱ ጎራታ ቁሉክ ማጻፋጆሊ ጎጎሻድናዉን ሳሙትሶ ባነ። <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>ሃና አመ፥ “ክርስቶሳ ራኮ አታይናራ። ታሴድ አርና ጎይኮ ክናራ። ሃ አማመ ማጻፋ ቁሉክ ጻፋመራ። <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>ኢየሩሳለምኮ ሀጋአበረ ጎሳ ዱባን ጩቦኮ ጉላ ጋላኖና ጩቦ ሀሄሶ አማማኖ መገኬሳይ ላላባምናራ። <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>እስና ሂካኑን አቶታን። <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>አንና ኣቦክ ታስሰሮ አብድ እስኑን ፋርናራ። እስን አድ ኤለኮ ሁና ታአታታኒ ኢየሩሳለም ግራ።”<verse eid="LUK 24:49"/></para>
  <para style="s1">የሱሳኮክ ዳሩር ብያኖ</para>
  <para style="r">(<ref loc="MRK 16:19-20">ማር. 16፡19-20</ref>፤ <ref loc="ACT 1:9-11">ኦፋ. ፈ. 1፡9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>ኤሰኮ አባባተረ የሱሳ ኡሱኮ ኦአጋልሳታራን ካታማኮ ቤሰረ ብታንያ ታጌሮ ኣተ ቤ። ገነኖኦቴሳና ኬሰረ እሶ ሶማሳተ። <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>እሶ ጋላታ ግራና፥ እሶኮ አሳባመ ዳሩር ቶስ ቤ። <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>እሶና ሳጋደን፥ ገጌሎ ኦአቲትና ኢየሩሳለም ቶስ አባባተን። <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>ዋ ጋላታ አርጌቶ ቁሉክ ምን ካዋይ ግረን።<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
