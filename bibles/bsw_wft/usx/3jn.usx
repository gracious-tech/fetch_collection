<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Bayso New Testament</book>
  <para style="h">3 ያንሳ</para>
  <para style="toc1">ካፋራመሮ ያንሳኮክ ሀንዳ ካሴድ</para>
  <para style="toc2">3 ያንሳ</para>
  <para style="toc3">3 ያን.</para>
  <para style="mt1">ካፋራመሮ ያንሳኮክ ሀንዳ ካሴድ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ካፋራመሮ ያንሳኮክ ሀንዳ ካሴድ ካኮንጻፋመራ፥ “ካፋራመሮ ጃርሳት ያንሳ” ጎሌሮ፥ ካኮንጻፋመራ ጋዮሳ ካአማማረ ምን ካዋዉን ሆረሃየ ካፈላሮንየ፥ ጻፍት ምና ቶነ ካካለ አማኒል ጋዮሳ ማንኮጋርጋረ ማራን ኡሱ ጋላታረ፥ ጋራ ካካለኔ አደ ድዮትረፊሳ ካአማማሮ ምጌክ እባዶትኮ እስኦቴሳ ጎጎኦራሮን ሻድሳራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="3JN 1:1-4">1-4</ref> </char></para>
  <para style="io1">ካጋይዮሳ ጋላታማኖ <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">ድዮትረፊሳ ዎቃሳማኖ <char style="ior"><ref loc="3JN 1:9-10">9-10</ref> </char></para>
  <para style="io1">ካድመጢሮሳ ጋላታማኖ <char style="ior"><ref loc="3JN 1:11-12">11-12</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />ሩምና አን ካጌላታሮ ካጌላመሮ ጋዮሲን።</para>
  <para style="p" vid="3JN 1:1">እን ጃርሳትኮ ካፍራመራ ሀንዳ፥<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />አን ካጌላታሮኬ! ኔፎታ ታኢዳነት ጎጎግርቶክ ማለ ታኢዳን ፋያ ኩ ጎጎግርቶና አየስ ዱባ ኩን ጎጎኤካሮን አን ኤባታራ። <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />ሩምዉን ካአብዳማቶ ላኖካና አት ካሰሳታ ራ ካሩም ላኖ አማኒል ኮኮ ኤመተዴ ጋራካካ ካኮአቶታተ ጎራታ አን ኣሎ ገጌላየራ። <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />ይስካክ ሩሚ ካሰሰታሮ ላኖ ማላኖኮ ኦሮራራን ገጌሎ ኢን ላግራን።<verse eid="3JN 1:4" /></para>
  <para style="s1">ካጋይዮሳ ጋላታማኖ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />ካጌላታሮኬ! ኩን ማርት ጎሌና አደ አማኒሉን ካፈላቶ ኮኮ ዱባ አት ካአብዳንተታ። <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />እሶና አት እሶን ታአብቶ ጌላንጀ ዋ ካአማናሮ እባዶ ሆረ አቶቴራን፥ ራክሶይና ዋ ካኮገገላይሶ ጋራይ ጎጋርጋርተ ታኢዳን ፈላታ። <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />መገ ካክርስቶሳ ማራን ኦቤራን አይዛብኮ ኮና ሀአታኖኒያ። <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />ጎርታ ራቶ ሩሚን ጎጎፈልኖን ሂካ ኣንክክ እባዶ ጋርጋራኖ ዶትሳራ።<verse eid="3JN 1:8" /></para>
  <para style="s1">ካድዮትረፈስ ዎቃሳማኖና ካድመጢሮሳ ጋላታማኖ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />ሂታኮ ሆረነ ምን ካዋቱን ዳብዳቤ አን ጻፈራ፤ አየሱን ጎአመን ምን ካዋይ ሆረሃይ ፈልን ካዶታታራ ድዮትረፊሳ ቆፋቴ ላኮአታተሮ። <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />ሃንሱን አን ጎኤሜየ ኡሱ ካሜላን አየስ መገካን ባስን ካፈላሮ ዱባ ዲዳ ቤስናራ፤ ህክና ላኮሌሮ አመረ አማኒል ላኮቆጳታሮ፤ ቆጳይን ኦዶታታራና ትራራ፤ ምን ካዋኮና እሶ ቤሳራ።<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />ካጌላታሮኬ! ካእዳን ካእዳንክ ሌን ኳሬ ካሜላን ኣን አሮሌተ። ካእዳን ካሌሮ ካፈላራ ዱባ ዋኮያ፤ ካሜላን ካፈላራ አደ ዋ ላኮዴሮ።<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />ድመጢሮሳን፥ እባዶ ዱባ ጋራኬሳ አቶታራ፤ ሩም መተክሴዉን ኡሱን አቶታታ፤ ኖና አንዴ ኡሱን አቶታና፤ እስና አቶናትካን ሩም ላኖ ካሳንዋ።<verse eid="3JN 1:12" /></para>
  <para style="s1">ታጋቾ ኖጎዳ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />አን ኩን ካጻፍናረ ካሞጋን አየስ ግረ፥ ሀሌዎ ኳሬ ቃላምይና ቢርይ ጎጎሌሮ ላኮዶታሮ፤ <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />አን ኤነ ኩ ድን አብድ የላታራ፤ እስደያ አዬስናና።<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />ኖጎዳ ኩን ሀሌቶ፤ ኩ ኦጌላታራን ዱባ ኖጎዳ ፋራማራን፤ አትና ኖ ኦጌላታራዉን መተ መተ ኖጎዳ ፋራምና።<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>