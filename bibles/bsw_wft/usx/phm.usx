<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Bayso New Testament</book>
  <para style="h">ፍልሞና</para>
  <para style="toc1">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ ፍልሞና ቶስ</para>
  <para style="toc2">ፍልሞና</para>
  <para style="toc3">ፍልሞ.</para>
  <para style="mt1">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ</para>
  <para style="mt1">ፍልሞና ቶስ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ፍልሞና ካአዴሳመ አማንየ፥ ካቆላስያስ ምን ካዋኮክ ማጋናልኮ ኮያ አማመ ሄዳማራ። ፍልሞና አናስሞሳ ካአማማሮ ድይት አባናየ፥ ሂክ ድይትና ጎታኬሳኮ ኢሰ ባየ ታኮቤረ ምን ካሻኖ ካግረ ጳዉሎሳነ ዎታ ኤሰሌን፥ ጋራ ካጳዉሎሳነ አናስሞሳ ካክርስትና አማኖ አታተ፥ ጳዉሎሳ ፍልሞና ቶስ ካጻፈረ ሀንዳ ፍልሞና አባባተ ኡሱ ቶስ ኤመቶ ጉት ካግሮ ድይት አናስሞሳ ዎታ ጎጎዎጋሮ ካሻድሳሮየ፥ አዳኖይና ግዳ አናስሞሳ ክርስታና ማንኮሌ ማራን ሂታኮ ሆረንባን ካአማኖ አቢ ኣን ኡሱ ጎጎቆጳሮን ኳሬ ድይ ኣን ኡሱ ጎጎቶትኖንኮ ሰጋራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="PHM 1:1-3">1-3</ref> </char></para>
  <para style="io1">ካጳዉሎሳ ጋላታ ፍልሞናን <char style="ior"><ref loc="PHM 1:4-7">4-7</ref> </char></para>
  <para style="io1">ጳዉሎሳ ጋራ ካአናስሞሳ ካኤባተሮ ካአቲ ኤብ <char style="ior"><ref loc="PHM 1:8-22">8-22</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="PHM 1:23-25">23-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>የሱሳ ክርስቶሳ ማራን ካሽያመሮ ጳዉሎሳኮና አብካን ጢሞቶሳኮ፥ ኣሎ ኖ ካጌላታኖና ኖኔ ዎታ ካፈላሮ ፍልሞናን። <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>አባታን አፍብያን፥ ኖኔ ዎታ ዎታዳራ ካሌሮን አርክጳን ምንካይ ካኩኩማሮ አማኒሉን፥<note caller="+" style="f"><char style="fr" closed="false">1፡2 </char><char style="ft" closed="false">ምንካይ ካኩኩማሮ አማኒሉን፦ ሄእ ታግሪኪ ምንካይ ካግሮ ምንካዋዉን አማራ።</char></note><note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="COL 4:17">ቆላ. 4፡17</ref>።</char></note><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>ዋ ኣቦካንኮና፥ ጎታ የሱሳ ክርስቶሳኮ ስኖና ኖጎዳ እስኑን ሀሌቶ።<verse eid="PHM 1:3"/></para>
  <para style="s1">ታፍልሞና ጌላንጄና አማኖ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>ኩ ኤብኬይ ሻዳ አርጌቶ ሄዶኬ ጋላታራ። <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>ኣላንቲና ጎታ የሱሳን ካአብቶ አማኖና ቁሎለ ዱባን ታአብቶ ጌላንጀ ማለራ። <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ክርስቶሳ ማንኮግኖ ማራን አየስ ካእዳን ዱባ ኣሎ ጎጎአዴሶን፥ አማኖካ ካካለቱን ገጊሳ ጎጎአታቶን ኤባታራ። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>አቢኬ! ቁሎለኮት ዎዳና ማንኮፎልሲሴዉን ጌላንጀታኮ ገጌሎ ኦአቲና ጎጎኢና ሄላየራ።<verse eid="PHM 1:7"/></para>
  <para style="s1">ጳዉሎሳ አናስሞሳ ማራን ዎጋርስ ኤባተ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ሃንሱን ፈልን ካዶትሳሮ አት ጎጎፈልቶን ኩ አጃጅን ክርስቶሳይ ጃቡ ኢን ጎግርተና፥ <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ጎርታ ጃርሳና ግዳ አደ ክርስቶሳ የሱሳን ካሽያመራ አን ጳዉሎሳ ጌላንጄ ኩ ኤባታራ። <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ምን ካሻኖ ግራን ካኡሙለሮ ኤረኬ አናስሞሳ ማራን ኤባታራ።<note caller="-" style="x"><char style="xo" closed="false">1፡10 </char><char style="xt" closed="false"><ref loc="COL 4:9">ቆላ. 4፡9</ref>።</char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>ጣየ ኩን ላኦ ካላይክየ፤ ግዳ አደ ኩና ሌረ እዬን ላኦ ካአቦ ሌራ።<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>ዎዳናቴ ማለ ካሌሮ ኡሱ አባበ ኩ ቶስ ፋረራ። <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ዎንጋላ ማራን አን ታኮሻመሬ ባንኤታይ ሌረ ኢን ጎጎሀንዳይሮን ሃሳይን ዶተረ። <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>አየሱን ጎአመን አት ካፈላቶ ካእዳንክ አየስ ዱባ ጌላንጄ ኳሬ ሁና ጎጎሌኖንኮ ኩኔ ሀማካሮን ኮና ፈልን ላኮዶታሮ።<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>ዎዳሳን አናስሞሳ ጎራታ ክጫሩን ኩኮ ካኮንካለቤራ፥ ኡሱ ቆጳይደ ኤርናዉን ኩ ዶሌ ጎጎአዳላይሶንያ። <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ሂታኮ ሆረንባን አደ ድይ ኣን ሀሌኖን ግራን ድይኮ ካሮራሮ አዉኣሎክ አብያ፤ ኢን ካጌላመያ፥ ሀሌዎ ኳሬ ሶይ ኡሱ ሀንዳኖኬሳ ኩ ማንኮማድናሮ ማራን አያና አደ ክርስቶሳ አቢ ኩን ማንኮሌ ማራን ኩዬን አደ ኣሎ ካጌላመያ።<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ጎርታ እን ሳቲ ኣን ጎቶትተ እን ጎጎቆጳቶ ማለ የላ ኡሱ አታ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>ኡሱ ኩ ካኮሚረራ አየስ ጎግረ ጎርቱን አምአታታ ኡሱ ጉት ጎግቴ እን ጉት ቶቲ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>አን ጳዉሎሳ ሂካ ገነቴይ ጻፈራ፥ ኡሱ ታአቦ አንዛ አን ሙርናራ። አት መተካዉን ካኬ ማንኮሌተዉን ኮና ላኮአዬስናሮ። <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>አቢክ ጎታይ እን ጎጎማድቶን ዶታራ፥ ክርስቶሳ ዎዳናቴ ፎልሲስ።<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>ኢን ካአጃጃማቶ ላኖ አብዳታ፥ አን ካሆሳታሮኮና ሮርስ ካፈልናቶ አዴሰረ ጻፋራ። <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>ሂካኮና ካካለ፥ ኤብክስን አባብ ሄላይረ አን እስን ቶስ ኤመይን አብድ ማንኮየላታሮ ማራን ታኮፎልሳሮ ባንኤ ኢን ኤካሳ።<verse eid="PHM 1:22"/></para>
  <para style="s1">ታጋቾ ኖጎዳ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>እን ዎታ ክርስቶሳ የሱሳ ካሽያመራ ኤጳፍራ ኖጎዳ ፋራማራ።<note caller="-" style="x"><char style="xo" closed="false">1፡23 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆላ. 1፡7</ref>፤ <ref loc="COL 4:12">4፡12</ref>።</char></note> <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ኡሱማለና ኢነ ዎታ ኦፈላራንኮ ማርቆሳ፥ አርስጢሮኮሳ፥ ዴማሳና ሉቃሳና ኖጎዳ ፋራማራን።<note caller="-" style="x"><char style="xo" closed="false">1፡24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ኦፋ. ፈ. 12፡12</ref>፤ <ref loc="ACT 25">25</ref>፤ <ref loc="ACT 13:13">13፡13</ref>፤ <ref loc="ACT 15:37-39">15፡37-39</ref>፤ <ref loc="ACT 19:29">19፡29</ref>፤ <ref loc="ACT 27:2">27፡2</ref>፤ <ref loc="COL 4:10">ቆላ. 4፡10</ref>፥<ref loc="COL 4:14">14</ref>፤ <ref loc="2TI 4:10">2 ጢሞ. 4፡10</ref>፥<ref loc="2TI 4:11">11</ref>።</char></note> <verse eid="PHM 1:24"/><verse number="25" style="v" sid="PHM 1:25"/>ታጎታ የሱሳ ክርስቶሳ ስኖ እስን ዎታ ሀሌቶ።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
