<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Bayso New Testament</book>
  <para style="h">Filmoona</para>
  <para style="toc1">Kafaramero P'awuloosakkoki Handdaa Filmoona Tos</para>
  <para style="toc2">Filmoona</para>
  <para style="toc3">Film.</para>
  <para style="mt1">Kafaramero P'awuloosakkoki Handdaa</para>
  <para style="mt1">Filmoona Tos</para>
  <para style="imt">Tabano</para>
  <para style="ip">Filmoona kaɂaddeesame amaniiye, kak'ollasiyaasi min kawaakokki maganaalkko kooyya amame hedamara. Filmoona Anasmoosa kaɂamamaro diyyiti abanaaye, hikki diyyitina goottakeessakko iise baye takkobeere minkashaano kagire P'awuloosane wota eseleen, gara kap'awuloosane Anasmoosa kakiristtinnaa ammano atate, P'awuloosa Filmoona tos kas'aafere handdaa Filmoona abbaabate usu tos emeeto gutii kagiro diyyiti Anasmoosa wota goggowogarroo kashaadisaroye, adanoyinna gidda Anasmoosa amanii mankkollee maraan hittakko horenbbaan kaɂammano abbi aani usu goggok'op'aroon kuwaarre diyyii aani usu goggotootinonkko segaara.</para>
  <para style="iot">Raattoo Hikki Mas'aafa Kaɂabera</para>
  <para style="io1">Tabano <char style="ior"><ref loc="PHM 1:1-3">1-3</ref> </char></para>
  <para style="io1">Kap'awuloosa galata Filmoonaan <char style="ior"><ref loc="PHM 1:4-7">4-7</ref> </char></para>
  <para style="io1">P'awuloosa gara kaɂanasmoosa kaɂebaatero kaɂatii ebi <char style="ior"><ref loc="PHM 1:8-22">8-22</ref> </char></para>
  <para style="io1">Gudisano <char style="ior"><ref loc="PHM 1:23-25">23-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>Yesuusa Kiristoosa maraan kashaamero P'awuloosakkona abbikkaani T'imotoosakko, aaloo no kageelaatannona noonne wota kafelaro Filmoonaan. <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>Abbattaani Afibiyaan, noonne wota wotaadara kalleeron Arikkip'aan minkkaayi kakukkumaro amaniluun,<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">«Minkkaayi kakukkumaro amaniiluun»: heɂi tagiriikkii «Minkkaayi kagiro min kawaawun» amara.</char></note><note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">K'ol. 4:17</ref>. </char></note><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>Waa Aabbokkaanikkona, Goottaa Yesuusa Kiristoosakko sinonna nogodda isinuun halleeto.<verse eid="PHM 1:3"/></para>
  <para style="s1">Tafilmmona geelanjjeenna ammano</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>Ku ebikkeeyi shaada arggetto Hedokkee galataara. <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>Aalanttina Goottaa Yesuusaan kaɂabtto ammanona k'ulloolee dubbaan taɂabtto geelanjje maalera. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>Kiristoosaa mankkoginno maraan ayees kaɂidan dubba aaloo goggoɂaddeesson, ammanokkaa kakkaleetun geegisaa goggoɂataattoon ebaatara. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>Abbikkee! K'ulloolekotti wodana mankkofolssisseewun geelanjjettaakko geggeloo oɂatiinna goggoɂinna helayera.<verse eid="PHM 1:7"/></para>
  <para style="s1">P'awuloosa Anasmoosa maraan wogarssi ebaate</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>Haanssun felin kadootisaro ati goggofelttoon ku ajajin Kiristoosaayi jabuu iin gogirtena, <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>Goortta jaarsana gidda ade Kiristoosa Yesuusaan kashaamera ani P'awuloosa geelanjjee ku ebaatara. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>Minkashaano giraan kaɂumulero erekkee Anasmoosa maraan ebaatara.<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">K'ol. 4:9</ref>.</char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>T'aye kuun laɂo kallayikkiye; gidda ade kuunna leere iyyeen laɂo kaɂabo leera.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>Wodanattee malee kalleero usu abbaabe ku tos farera. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>Wongala maraan ani takkoshaameree banɂettaayi liire iin goggohanddayiroon haasayiin dootere. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>Ayesuun goɂameen ati kafelatto kaɂidankki ayees dubba geelanjjee kuwaarre hunnaa goggolleenoonkko kunne hamakkarooni koonna felin lakkodootaro.<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>Woddaasan Anasmoosa goorata kic'c'aruun kukko kakkoonkalebeera, usu k'op'ayidde eerinnawun ku dollee goggoɂadallaayissonya. <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>Hittakko horenbbaan ade diyyii aani halleennoni giraan diyyikko karooraro awɂallokki abbiya; iin kageelaameya, halleewo kuwaarre sooyi usu handdaanokkeessa ku mankkomaaddinaro maraan ayyaanaa ade Kiristoosaa abbi kuun mankkollee maraan kuyeen ade aaloo kageelaameya.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>Goortta in saatii aani gotootite in goggok'op'aattoo malee yela usu ata. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>Usu ku kakkomiirɂera ayees gogire goorttun amɂaatatta usu gutii goggitte in gutii tootii. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>Ani P'awuloosa hikka genetteeyi s'aafera, usu taɂabo anza ani murnnara. Ati metekkawun kakkee mankkoleetewun koonna lakkoɂayeesinnaro. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>Abbikki Goottaayi in goggomaaditon dootara, Kiristoosaa wodanattee foolssisi.<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>Iin kaɂajajaamatto laano abddataa, ani kahoosatarokkona roorisi kafelnnatto addeesere s'aafara. <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>Hikkakkona kakkalee, ebikkisin abbaab helayire ani isin tos emeeyin abddi mankkoyelataro maraan takkofoolssaro banɂe iin ekkaasa.<verse eid="PHM 1:22"/></para>
  <para style="s1">Tagachchoo nogodda</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>In wota Kiristoosa Yesuusaa kashaamera Ep'afira nogodda farramara.<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="COL 1:7">K'ol. 1:7</ref>; <ref loc="COL 4:12">4:12</ref>.</char></note> <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>Usumaleenna inne wota ofelaraankko Mark'oosa, Arsit'irokoosa, Deemasana Luk'aasana nogodda farramaraan.<note caller="-" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">Ofa. Fe. 12:12</ref>; <ref loc="ACT 25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="ACT 19:29">19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">K'ol. 4:10</ref>,<ref loc="COL 4:14">14</ref>; <ref loc="2TI 4:10">2 T'im. 4:10</ref>,<ref loc="2TI 4:11">11</ref>. </char></note> <verse eid="PHM 1:24"/><verse number="25" style="v" sid="PHM 1:25"/>Tagootta Yesuusa Kiristoosa sino isin wota halleeto.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
