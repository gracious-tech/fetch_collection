<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Bayso New Testament</book>
  <para style="h">2 ጢሞቶሳ</para>
  <para style="toc1">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ ካላሚ ጢሞቶሳ ቶስ</para>
  <para style="toc2">2 ጢሞቶሳ</para>
  <para style="toc3">2 ጢሞ.</para>
  <para style="mt2">ካፋራመሮ ጳዉሎሳኮክ ሀንዳ ካላሚ</para>
  <para style="mt1">ጢሞቶሳ ቶስ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ጳዉሎሳ ጢሞቶሳን ካጻፈራ ሂክ ካላም ሀንዳ፥ ጳዉሎሳ ኡሱ ኤነ ካጋርጋራሮና ካፈሎ ሳቲ ካሌረ ዎዳላት ጢሞቶሳን ካስሰሮ ጎርሳ ካአበሮያ፥ ጋማካንጂና ካጎርሴረ ኦብሲ ጎጎአታሮንየ፥ ጢሞቶሳ ሃፉራ ካጎርሳና ካአታይሳሮ ካኮሄላተረ ጋራ ካየሱሳ ክርስቶሳ አማናማኖይ ጎጎአቶትሮን፥ ካገጌሎ ሃፉራና ቁሉክ ማጻፋጆልኮክ አጋልስስ ማዳራይ ጎጎአባሮና ማምሲ ራኮና ኔባንጀ ኡሱን ጎጂናተና፥ አጋልስሳኖይና ዎንጋላ ላላባኖኮኒዕ ፈሎይ ጎጎአታሮንየ።</para>
  <para style="ip">ጳዉሎሳ ጢሞቶሳን ካካለኮና ሴርሳኖ ካኮንስሰረ ጎዉማ ካክያሮ አዳክ ጎጋማኖኮ ኡሱ ጎጎፋክአምሮንየ፥ ሂካ ኣንክክ አየስ ኦማላራን ባሳኖ ኳሬ ካካለ ታስሳራ ላኦ ላኮግቶ።</para>
  <para style="ip">ሂካ ዱባ ጢሞቶሳ ሻዲን ካዶትሳረ ካጳዉሎሳ ግርና ባሪሳኖኦቴሳኮክ ሀልቻ ካካለኮና አማኖኬሳ፥ ኦብስቴሳ፥ ጌላንጀቴሳ፥ አታታኖና ሆሮራማኖይ ኡሱ ታጌተቶ ራኮ ማሱሳ የላይ ጎጎግሮንያ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="2TI 1:1-2">1፡1-2</ref> </char></para>
  <para style="io1">ጢሞቶሳን ካስሳመሮ ጎርሳ <char style="ior"><ref loc="2TI 1:3-2:13">1፡3—2፡13</ref> </char></para>
  <para style="io1">ካካካታኖ ጎራታ ካአብዳመ ል ሙታኖ <char style="ior"><ref loc="2TI 2:14-4:5">2፡14—4፡5</ref> </char></para>
  <para style="io1">ኡሱ አልማ ካግረ አዬስኮክ ጋራና ካዶትሳሮ ሴራ <char style="ior"><ref loc="2TI 4:6-18">4፡6-18</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="2TI 4:19-22">4፡19-22</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />የሱሳ ክርስቶሳ ታሄላንተቶ ታግር አብድክ ማለ ፈኢ ታዋይ የሱሳ ክርስቶሳን ካፋራመሮ ጳዉሎሳኮ ካፋራመሮ ሀንዳ።<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />አን ካጌላታሮ ኤረኬ፥ ጢሞቶሳ፤ ስኖ ሻጋና ኖጎዳ ዋ ኦዶኮ፥ ጎታካን የሱሳ ክርስቶሳኮ ኩን ሀሌቶ።<verse eid="2TI 1:2" /></para>
  <para style="s1">ጢሞቶሳን ካስሳመሮ ጎርሳ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />አርጌቶ አሪኔ ሄመኔ ኤቢ ኩ ጎሻድሮ፥ ኦዶላል ካሆሬ ኣቦጆላልካን ጎጎየለናንክ ማለ ቁሉት ሳሙይ ካኮንሀንዳሮ ዋኬ ጋላታራ። <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />አን ኢልምታ ሻዳ ኣሎ ገጌላይን ኩ ድን ሀልቻራ። <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />ኢፍሳዳ ካልክ አማኖ ሻዳራ፤ ሂክ አማኖ አኮታ ሎይድና ኣየታ ኤዉኒቄ ዶሌ ግረ፤ አደ ኩና ግራኖ አዴሰራ። <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />ሃንሱን ገነኖኦቴ ኩ ጉት ካኮካየ ጎራታ አት ካአታተቶ ኩ ኦሮ ካግሮ እላቦ ካዋ ጎጎከኬሶን አን ኩ ሻድሳራ። <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />ዋ ካሁናና ካጌላንጄ፥ እስኦታ ካኮአዎዳቶ አያና ኳሬ ካአብሲ አያና ላኮዮ።<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />ጎርታ፥ ጎታካንኮት አቶቲን አሮሙልተ፤ ኡሱ ማራን ካሽያመሮ እዬ አሮሙልተ፤ አየሱን ጎአመን ሁና ካዋይ ዎንጋላ ማራን ኢነ ዎታ ራኮ አታ። <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />ኡሱ ኖ ኦፈልነኖ ፈሎ ኦኢዳኒ አንሌኖን ግራን ፈኢቴሳኮና ስኖቴሳኮ ካከይ ኡሱ ኖ ፋይሰ፤ ቁሉማዉና ኖ ኡመራ፤ ህት ስኖና ጌስ ካሞጋንኮ ሆረነ የሱሳ ክርስቶሳይ ኖን ስሳንተታ። <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />ጋራ ካዎንጋላነ ኔፎና ጎይ ካላይክ ካግር ኢፋ ቶስ ካቤሰሮ ዶብካን ጎይ ካአዎዳተሮ የሱሳ ክርስቶሳኮክ ጋራነ ህት ስኖ ኖን ሙተታ።<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />አንና ሂካ ዎንጋላ ካገጌሎ ካላላባሮና ካፋራመሮ፥ ካአጋልስሳሮ ሌ ሹማመራ። <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />አን ህታ ራኮ ካኮንአታታራና ሃኑንያ፤ ጎሌና አን ካኮአማነሮ ኡሱ ማንኮካሶ ማራን ላኮሙልናሮ፤ አን ኡሱን ታስሳየሮ ሀዳራና ኤሰ አሪ ታጌቶ ካኦርናሮ ላኖ አን አዴሰራ። <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />እንኮ ካማልተቶ ክርስቶሳ የሱሳ ካግሮ አማኖ ጌላንጄ፥ አጋልስስ ካእዳንክ ማሱሳ የላደ ኦራ። <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />ኖ ኦሮ ካግሮ ቁሉክ አያናኮክ ጋራነ ኩን ታስሳንተቶ ታኢዳንት ሀዳራ ኦራ።<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />ታእስያ አዉራጃይ ኦግራን ዱባ እን ሉጉደን ካኢሰራን ካሶዋ፤ እሶ ኦሮኮ ፈገሉስና ህረሞገነስ ግራን። <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />ጎታ ካኦነስፎር እባዶ ካምኔቱን ኢዳነ ሀየሎ። ኣላንቲና ካሞጋን ጎራታ ጎጎኢሰራን፤ ሻማኖኬይና አን ላኮሙሌሮ። <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />ኡሱማለና ኡል ካሮም ቶስ ካኮኤመዬረ ጎራታ ኣሎ ዶተን እን ሄሌራን። <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />ታጋቾ አሪ ጎታ ሻጋ ሀስሶ፤ ታኤፈሶን ካታማይ ታኮግረ ኤግታክ እዬን ሀንዳየሮ አት ኣሎ ካሳ።<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s1">ክርስቶሳን ካአብዳመ ዎታዳራ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />ጎርታ ኡኑኬ! አት የሱሳ ክርስቶሳ ታግቶ ስኖይ አታ። <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />ካሞጋን አቶ ሆረ እንኮ ካማልተቶ፥ ካካለ አጋልስስን ካዳንደሮ ካአብዳመ እባዶን ሀዳራ ስስ። <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />አትና ካየሱሳ ክርስቶሳ ካእዳንክ ዎታዳራ ኣን ኖኔ ዎታ ራኮ አታ። <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />ዎታዳራ ሌ ካፈላራ እባዶት ካጀረነ ዎይቻ ገጌላይስን እጻማራ ኳሬ ፈሎ ኦካለቲ ጎራታ ላኮባሳታሮ። <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />ኡሱማሌ ትያኖ ለላሚን ካታባራ እባዶት፥ ሴራ ካለላማኖ ኦራዪ ጎለላማናዋተ አዎዳኖኮክ ካላቻ ላኮሄላታሮ። <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />እራ አታተ ኦታተ ካባራረና ፈሎኦቴሳክ ዳፉርኮ ካሄላማሮ ዉጣ ሆራርጀ ሄላይን ዶትሳራ። <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />አን ካአማሮ ዎዳና አባ፤ ጎታ ዱባዉን ሻዳኖ ኩን ስስሮዋ።<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />ጎይኮ ካኬሮ፥ ሳኒ ታዳዉተኮ ካሌሮ የሱሳ ክርስቶሳ ሻድ፤ አን ካላላባራ ዎንጋላክና ሂካዋያ። <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />ሂካ ዎንጋላ ማራና ፈሎ ኦሜላን ካፈለሮ እባዶ ኣን ሳንሳላታ ሻመረ ራኮ አታታ ግራ፤ ሃፉራ ካዋ አደ ላኮሻማሮ። <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />ሃኑን የሱሳ ክርስቶሳ ካግሮ ፋይና ጅሩ ጅሮማት ካባጃ ዎታ እሶና ጎጎሄላራኑን፥ ዋዉን ኦአሳባሜራኑን አመረ ዱባና ኦብሲ አታይናራ። <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />ሃ ካአማራ ሃፉራ ካአብዳመያ፤ ኡሱነ ዎታ ጎጎነ፥ ኡሱነ ዎታ አድ ኔፎ ግርናና።<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />ኦብሲ ጎአታነ፥ ኡሱነ ዎታ አድ ሬድናና።</para>
  <para style="q2" vid="2TI 2:12">ኖ ኡሱ ጎካካነ፥ ኡሱ አድ ኖ ካካይናራ፤<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />ኖ ኦአብዳምነ ሊ ጎሙቶን፥</para>
  <para style="q2" vid="2TI 2:13">ኡሱ እስኦቴሳ ካካዪን ማንኮዳንዴኖን ማራን</para>
  <para style="q2" vid="2TI 2:13">ካአብዳመ ሌ ግራራ።<verse eid="2TI 2:13" /></para>
  <para style="s1">ካኮንአቶታመ አታተ ካፈላሮ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />ሂካ አየስ ሻድስ፤ ህኢኮ ካበያሮ ሃፉራ ኮኮይ ጎጎዶጋሞንኮ ዋይ ሆረ ሴሪና፤ ሂክ ላኦ ካላይክ፥ ኦማላራና ካባሳሮያ። <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />ካሩም ሃፉራ ልክ ካአጋልስሳሮና ፈሎኦቴሳይና ሀሙልኖን ካኮንአቶታመ ካፈላታሮ ሌደ እስኦታ ዋይ ሆረ ስሳይን አታ። <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />አላምኮ ካሌሮ ሄንተፈለክ አየስኮ ፋክም፤ ሂካ አዬሲ ካአባመራ እባዶ ዋኮ ፋክማ ሴታራ። <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />አዬስክሶ ታፋይኖን ሜጋ ኣን ኣማራ፤ እሶ ኦሮኮ ሄመኖስነ ፍልጦሳኔ ግራን፤ <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />ሂክ እባዶ ሩምኮ ፋክመረ፥ “ጎይኮ ክያኖ ሂታኮ ሆረነ ሌራ፤” አማ እባዶ ኮኮክ አማኖ ሶሶይሳራን። <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />ሀሌዎ ኳሬ፥ “ጎታ ካኬሳ ካሌሮ ካሶዋ፤” አደ፥ “መገ ካጎታ ካኡማታራ ዱባ ሜላነኮ ሀፋክመ” ካአማሮ ማታማ ካአባ ካአኢኖን ኡኩም ካዋ አታተ ግራራ።<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />ምን ካንጂንክ ኦሮ ዎርቂኮና ብርኮ ካፈላመ ሁ ካላል አንሌኖን ግራን፥ ጋኮና ኤሬኮና ካፈላመራ ሁና ግራራ፤ ሂካስኮና ኮኮ ካባጃዉን ካካለና ካባጃ ካላይኒዕ ፈሎዉን ሃራ። <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />ጎርታ ማዮና እስኦቴሳ ሂካ ካሰጋመሮ አየስኮ ጎሙጭመ ካካባጃ ሀንዳዉን ካሌሮ፥ ካቁሎየ፥ ጎታኬሳዉን ላኦ ካስሳሮና፥ ፈሎ ኦኢዳነቱና ካኤካተ ሁ ልናራ።<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />ካዎዳሉማ ሀልቻ ካሜላንኮ ፋክም፤ ሙጭ ታአንተ ዎዳና ጎታ ኦኡማታራነ ዎታ ቁሉማ፥ አማኖ፥ ጌላንጄና ኖጎዳ ዶታ። <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />ካማድኖን ፉሬን ካሊክ ዶጋማኖኮ ፋክም፤ ኣላንቲና ሂክ ኤንገ ካኬናሮ ላኖ ካሶዋ። <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />ዋዉን ካሃንዳራ ኢንሰኢንጋምን ላኮዶትሳሮ፤ ሀሱኮ እባዶ ዱባን ካእዳንክ፥ አጋልስስን ካዳንደሮ፥ ካኦብሳሮ ልን ዶትሳራ፤ <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ሩም ማላባኖ ቶስ ጎጎጌራኑን፥ ዋ ጩቦኮ ጉላ ጋላኖ እሶን ካስስናሮ አብድ የላታ ኡሱ ኦኔባታራን ኢዳነ ቱኩል ካኡምሳሮ ላኖ ዶትሳራ። <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />ህክና ሳሙትሶ ቶስ አባባራንዋ፤ ፈኢቴሳ ጉድስን ኦቦጃሜን የለ ካአበሮ ግቴ ካዱርሳኮ ፋላዳይ ሄስራንዋ አማያ።<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s1">ካጉዳታሮ ጌስጆልኮት ሜላነ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />አየሱን ጎአመን ጌሲ ካጉዳታሮ ካጫናቅስራ ጎራታ ኤመታኖ አዴስ። <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />እባዶ እስኦቴሳ ካጌላታሮ ልናራ፥ ማራጋዴ ካዮራሮ፥ እስኦቴሳ ካዳታሮ፥ ኮራሜሳል፥ እባዶ ካሀባራሮ፥ ኦኡሙለራዉን ካአጃጃሞን፥ ጋላታ ካላይኒዕ፥ ቁሉማ ካላይኒዕ፥ <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />ጌላንጀ ካላይኒዕ፥ ዎጋርስ ኦጌላኖን፥ ኦሀማታራን፥ እስካአዎዳኖን፥ ቦግካአቲ፥ ካእዳንክ ካሌ ካጌላኖን፥ <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />ኦካካታራን፥ ኦጀጀራራን፥ አዳ. ኮራይ ኦአማጋሜራን፥ ዋኮ ሮርሳተን ግር ካእዳን ኦጌላታራን ልናራን። <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />ዋ ኦሄዶይሳታራን ኣን ላራን፤ ዋ ሄዶይሳታኖኮክ ሁና አደን ካካቴራን። ሂካስኮ ፋክም። <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />ሂኒዕ እባዶጃ ምንጆላል ሉቄን ታቤን ጩቦ ካንጂን ካኮንግሮና ካሞጋን ሀልቻ ካሜላኒ ኦሮ ታቤን አያና ካሀረሮ ሄለል ኦሶሶይሳራንያን፤ <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />ሂካማሌክ ሄለል አርጌቶ አጋልሳታራን፤ አየሱን ጎአመን ሩም ማላባኖ ቶስ ጌግን ዱዶ ላኮዳንዳሮ። <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />እያነስና እያንበሬስ ሙሴ ጎጎዲደረኒ ህኒዕና ሳሙትሶ ካኮንባተና አማኖኮ ካኢየራ እባዶ አደ ሩም ኔባታራ። <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />ሀሌዎ ኳሬ ታኢያነስና ታኢያነበሬስ ጎዉማ ጎጎሙተቶ፥ ሂካ እባዶኮትና ዱባዉን ሙቶዋ።<verse eid="2TI 3:9" /></para>
  <para style="s1">ጳዉሎሳ ጢሞቶሳን ታስሰሮ ሀዳራ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />አት ጎአመን አጋልስሳኖኬ፥ ግርኬ፥ ሀልቻኬ፥ አማኖኬ፥ ኦብስቴ፥ ጌላንጀቴና፥ አታንኬ ዱባ ካሶዋ፤ <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />ሆሮራማኖኬና ራኮቴይ፥ አንጾክያይ እቆንዮንና፥ ልስጢራይ ኢን ካጌሮ ሆሮራማኖና ኦብስቴ ዱባ ካሶዋ፤ ጎታ ጎአመን ሂካ ዱባኮ እን ሃሰ። <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />ኦግራን የሱሳ ክርስቶሳ ካሩም አያናኮክ ግር ግርን ኦዶታታራን ዱባ ሆሮራማናን። <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />ኦሜላና ኦሶባራን ጎአመን ኡሱን ሽርማና ሽርሳ፥ ሜላነ ጉት ሜላነ አዳ. ሴታራን። <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />አት ጎአመን ካአጋልሳተታ አዮኮዮ ማንኮካሶ ማራን ካአጋልሳተቶና ሩም ካኮአዴሰቶ አታ። <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />ይሱማኮ ሀጋአብተደ፥ የሱሳ ክርስቶሳ አማኖይ ፋይና ካኮሄላማሮ ቃሩማ ኩን ስስን ኦዳንዴራን ቁሉክ ማጻፋል አዴሰታ። <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />ቁሉክ ማጻፋጆል ዱባ ህኢ ታዋኮ ካቤሮ ሃፉራ ካዋያ፤ አጋልስስን፥ ሴርን፥ ቱኩል ኡምስን፥ ካሩም ራድ ጎርሲን ጋርጋራራ። <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ህክና እባዶ ካዋ፥ ፈሎ ኦኢዳን ዱባን ካኤካሳተና ካአቲ ሊ ጎጎሙትሮንያ።<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />ዋይ ሆረና፥ ዎኖናት ካኮኤሜታሮ ጎራታ ካጎየሮና ኔፎ ካግሮ ጉት ፍርድን ካግሮ የሱሳ ክርስቶሳ ሆረ አን ኩን ሀዳራ አማራ። <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />ሃፉራኬሳ ላላቢ፤ ጎራታ ኩን ጎኤካተና ጎኤካታናዋተና ካኤካሳተ ሌን። ኦብስ ታአቲትና አጋልስሳኖይና ቱኩል ኡምስ፤ ሀድሳኖና፥ አታይስ። <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />ኣላንቲና እባዶ ልክ ካሌሮ አጋልስስ ካኮአታኖን ጎራታ ኤመይናራ፤ ሂካኮ ሀልቻክሶዉን እስካአትሮ፥ ነበትሶይ ማልን ካኢዳሮ ካዶታታራን ጎጎሰግራኑን ኦአጋልስሳራን እሶ ማራሙረን ኩኩአማራን። <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />ሩም ማላናኮ ነበትሶ ጩፋታራን፥ ማማ ማልን አባባታራን። <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />አት ጎአመን ካመን ዱባዉን ካእስል ሌን፤ ራኮይ ኦብሲ፤ ኦዱ ታኢዳን ላላባኖኮኒዕ ፈሎ ፈል፤ ሀንዳካ ዱባ ፈል ጉድስ።<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />አን ጃርሶ ሊ ጎይ ሂካ አላምኮ ካለሊ ካኮቤራ ጎራታ ጌራ። <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />አን ሞአባታኖ ካእዳን አባየራ፤ ትያኖና ጉድሰራ፤ አማኖና ኦራዬራ። <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />ጎርታ ቁሉክ ካላቻ ኢን ኤካተራ፤ ሂካና ቁሉክ ካፍርዳሮ ካሌራ ጎታ ሀሴ አሪ እዬን ስስናራ፤ አደ እን ካላሉን አሌኖን ግራን፥ ኤመቶቴሳ ኦሀልቻራን ዱባዉንያ።<verse eid="2TI 4:8" /></para>
  <para style="s1">እስኮት ሃጃል</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />ሳም እን ቶስ ኤመይን ኩን ካዳንዳመ ዱባ ፈል። <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />ዴማስ ሂካ አላም ጌላተረ እን ኢሰረ ኡል ካተሰሎንቄ ቶስ ሴተራ። ቀርቅስ ኡል ካጋላትያ ቶስ፥ ቲቶና ኡል ካድልማጢያ ሰተራን። <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />ኢነ ዎታ ካግራ ሉቃሳ ካላልያ። ማርቆሳ ሀንዳኖኬይ እን ማንኮጋርጋራሮ ማራን ኤመታ ዎታ አት ኮያ። <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />ትክቆሳ ኡል ካኤፈሶን ፋረራ። <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />ኤመታ ግራን ኡል ካጢሮአዳ ካርፑሳ ዶሌ ታሉጉዳየሮ ካባ፥ ካዱባመ ካጋልባ ማጻፋ ካካለኮና ጋልባ ጉት ካጻፋመሮ ማጻፋና አት ኮይ።<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />ካናስ ማርጮ ካቱማራ እስክንድራ ታንጂን ሚራኣ እን ጌግሰ፤ ዋ ፈሎ ኦቴሳክ ማለ ኡሱን ስስሮዋ። <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />ኡሱ ሀንዳካን ኣሎ ማንኮዲደሮ ማራን፥ አትና ኡሱኮ እስኦታ ኦራ።<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />አን ካኮን ሞታመረ አየስ ካሆራርጄ አባብ ስስን ካኮሴየረ ጎራታ ማዮና እን ካጋርጋረ ኮና ላኮግሮ፤ አየሱን ጎአመን ዱባ እን ኢሰን ሴተን። ሂካና እሶን አሮቶትኖ። <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />አየሱን ጎአመን ሀንዳ ምናቴነ አንሀቃኖን አማጋመ ጎጎላላባምሮና አይዛብ ዱባ ጎጎማሎ ጎታ እን ዶሌ አሌረ አታይሰ፤ ህኢ ታሉባንኮና ሃሰ። <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />ጎታ ካሜላን አየስ ዱባኮ እን ሃስናራ፤ ዎኖናት ካዳሩረ ቶስ ኖጎዳ እን ጌግስናራ፤ ኡሱን ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማን ጌሮ ካባጃ ሀሌቶ፤ ሀሚኒዕ።<verse eid="2TI 4:18" /></para>
  <para style="s1">ታጋቾ ኖጎዳ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />ጲርስቂላና አቅላን፥ ካኦነስፎርም ካምነ እባዶን ኖጎዳ ጌግስ። <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />ኤርስጦሳ ኡል ካቆሮንቶሲ ሄሰራ፤ ጢሮፍሞሳና ማንኮሀዉአመ ማራን ኡል ካምልጢኒ ኢሳገራ። <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />ባጠሳኮ ሆረነ ሂታራ ኤመይን ኩን ካዳንዳመ ፈል። ኤዉቡሉስ፥ ጱዴስ፥ ልኖስ፥ ቅላዉድያና አማኒል ዱባ ኩን ኖጎዳ ፋራሜራን።<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />ጎታ ኩኔ ዎታ ሀሌዎ።</para>
  <para style="p" vid="2TI 4:22">ስኖ ታዋ እስን ዎታ ሀሌቶ።<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>