<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Bayso New Testament</book>
  <para style="h">1 ጴጢሮሳ</para>
  <para style="toc1">ካፋራመሮ ጴጢሮሳኮክ ሀንዳ ካሆሬ</para>
  <para style="toc2">1 ጴጢሮሳ</para>
  <para style="toc3">1 ጴጢ.</para>
  <para style="mt1">ካፋራመሮ ጴጢሮሳኮክ ሀንዳ ካሆሬ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ካፋራመሮ ጴጢሮሳኮክ ሀንዳ ካሆሬ ካኮንጻፋመራ ሀንዳ ኦሮ “ዋዉን ካአሳባመሮ ካእዳን ጎሳ” አማሜ ኦኡማማሮና ትጫርት እስያይ ምና ታኤሌነ ካዳራኣመሮ አማኒሉንያ፤ ሀንዳዉን መተት ቆፋ አማኖክሶኮት ኣላንቲ ባቃታኖና ራኮ ጌተ ኦኮንግቴ ኦናባባራን አታይሲና ጎጎእስንያ፤ ጻፍት ሂካ ካኮንየለራ ጎይከሳኮክ፥ ጎይኮ ክያኖከሳኮክና፥ አባባይ ኤሜቶተሳኮት አብድ ካሰሰጋሮ ካየሱሳ ክርስቶሳ ካገጌሎ ሃፉራ ኦናባባራን ሻድሲንያ፥ ካየሱሳ ክርስቶሳ ግር ማሱሳ የል ዲያ ራኮ ኦብሲ አታይን ካዶትሳሮ ላኖ እሶ ሻድሳራ፥ ሂካ ዎታ አበረ ራኮ አማኖክሶኮክ ኢድ ታጫፋቶ ላኖና፥ “የሱሳ ክርስቶሳ ካላም ታኮኤመይናሮ አሪ” ታዶትሳቶ ሙራትሶ ካአታይናራን ላኖ አዴስሳራ።</para>
  <para style="ip">ጻፍት እሶ ራኮ ኦሮ ጎጎኦብስራዉን እሶ ጃጃቤሳናኮና ሮረ ኦናባባራን ክርስቶሳ ዴበ ኦሰሰታራን ግርን ካዶትሳሮ ማለ ጎጎግራዉን እሶ ሻድሳራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="1PE 1:1-2">1፡1-2</ref> </char></para>
  <para style="io1">ሃሳኖ ካዋ ሻዳኖ <char style="ior"><ref loc="1PE 1:3-12">1፡3-12</ref> </char></para>
  <para style="io1">ካቁሉማ ግር ግርን ካስሳመሮ ጎርሳ <char style="ior"><ref loc="1PE 1:13-2:10">1፡13—2፡10</ref> </char></para>
  <para style="io1">ካራኮ ጎራታይ ካአማኒል ኦዶናት <char style="ior"><ref loc="1PE 2:11-4:19">2፡11—4፡19</ref> </char></para>
  <para style="io1">ታአማኒል ኢዳነና ሀንዳኖ <char style="ior"><ref loc="1PE 5:1-11">5፡1-11</ref> </char></para>
  <para style="io1">ጉድሳኖ <char style="ior"><ref loc="1PE 5:12-14">5፡12-14</ref> </char></para>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1"/>የሱሳ ክርስቶሳይ ካፋራመሮ ጴጢሮሳኮ፥</para>
  <para style="p" vid="1PE 1:1">ባቃተን ኤሜተዴን ጰንጢዮሳይ፥ ጋላትያይ፥ ቅጰዶቅያይ፥ እስያይና፥ ብታንያይ ዳርኣንቴን ኦግታን ዋዉን ኦአሳባንቴታን፥ <verse eid="1PE 1:1"/><verse number="2" style="v" sid="1PE 1:2"/>ዋ ኦዶ ጣየ ጎጎአዴሰሮ፥ የሱሳ ክርስቶሳን አጃጃምን ኢግኬሳይ አራጫንቴዴነ አያና ቁሉክ ሙጭንቴን ኦቁሎይተታን፥</para>
  <para style="p" vid="1PE 1:2">ስኖና ኖጎዳ እስኑን ሀሌቶ።<verse eid="1PE 1:2"/></para>
  <para style="s1">አርዶት አብድ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>የሱሳ ክርስቶሳ ጎይኮ ካኬሰሮኮት ኣላንቲ አርዶት ታሌተቶ አብድ ኖን ካስሰራ፥ ካአቲ ሻጋኬሳይ ካኡሱብክ ኡሙላማኖ ይስኬሳ ካየለሮ፥ ጎታካን ካየሱሳ ክርስቶሳ ኦዶ ዋ ሀጋላታመ፤ <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>ኡሱና ታባኖን፥ ታሻሞንና ታኢግልሳሞን ርቲ ዳሩሪ እስኑን ኤካሰራ። <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>እስና ታጋቾ አሪ ካሙትናሮ ፋይና ጋራ ካአማኖነ ሁና ካዋይ ኦራንቴታን። <verse eid="1PE 1:5"/><verse number="6" style="v" sid="1PE 1:6"/>ማምሲና ሱረ ካለካለት ጫፍቲ ጎራታ ክጫሩን እስን ታጢብዶ ጎሌተና ዋይ ገጌላየን። <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>ህት ጫፍቲ እስን ካኮንግናታ ካካባጃ አማኖክስን ሩም አዴስስንያ፤ ካባራ ዎርቂ አደ ኤለኒ ጫፋማራ፤ ዎርቂኮ ካሮረ ካካባጃ አማኖክስን ሂካማሌ ጫፋሚን ዶትሳራ፤ ህክና ካጫፋመ አማኖክስን የሱሳ ክርስቶሳ ካኮኤሜታሮ ጎራታ ጋላታ፥ ካባጃና ሄዶይሳታኖ እስኑን ሄላምስሳራ። <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>የሱሳ ክርስቶሳ ካዴኖን ግታን ጎሌተና ኡሱ ጌላይናታን፤ ሃፉራይ ሰጋሚን ካዳንዳሞን ኦካባጃሜን ገጌሎይ ገገላይናታን። <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>አማኖክስኒ ታኦራታን ኔፎትስኑን ፋይና ሄላይናታን።<verse eid="1PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10"/>እስኑን ታስሳምናቶ ስኖ ማራን ሄገሮ ኦአዬሰራን ካሄገሮል ሂካ ፋይናን ማዳሬን ቆቆራ ግረን። <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>እሶ ኦሮ ካግራ ካክርስቶሳ አያና ክርስቶሳ ጉት ታግናቶ ራኮ አደና ራኮኮና ሃሬ ታኤሜይናቶ ካባጃ ጣየ አዬሳ ካቱሰራ ጎራታ ጎሬና ምሲ ጉዳይናሮ ቆቆራ ግረን። <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>ግዳ ዳሩርኮ ካፋራመሮ አያና ቁሉክ ዎንጋላ ካላላበሮ እባዶን እስኑን ካሰጋመሮ አየስ ካኮአዬሰን ጎራታ እስኑን ኳሬ እስኦትሶዉን ፈላታናዋት እሶን ሙተ። ኤርግቻልና ዱባ አሄሶን ሂካ አየስ ሀልቻራን።<verse eid="1PE 1:12"/></para>
  <para style="s1">ቁሎይ ግራኖ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>ሃንሱን ዎዳናትስን ኤካሳየን፥ እስኦትስን አዎዳዬን፤ የሱሳ ክርስቶሳ ካላም ጎኤመተ እስን ታአታይናታን ስኖ ዱባ ጉት አብድ የላዬን። <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>ካአጃጃማሮ ይስ ጎጎሌተታንክ ማለ ጣይተን ሀአዴሶን ግራን ካኮግቴን ሀልቻ ካሜላን አሮፈልቴን። <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>አየሱን ጎአመን እስን ካኡመራ ኡሱ ቁሉክ ማንኮሌ ማራን እስን ግርክስን ዱባይ ቁሎለ ላ፤ <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>ኣላንቲና “አን ቁሉክያ እስና ቁሎለ ላ” አማመ ጻፋመራ።<verse eid="1PE 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17"/>እባዶን ሀኡሉልሶን ኦዶ ኦዶ ፈሎኦቴሳክ ማለ ካፍርዳሮ ኣቦካን አንቴን ካኡማታን ጎሌተን ሂካ ኡሊ ማርትና ካኮግታን አብሲ ግራ። <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>ካሆሬ ኦዶላልክስንኮ ካኤልቴታን ላኦ ካልክ ግርኮ ባልቹማ ካኮበተታን ካባሮ አዬሲ ብር ጎርቱን ዎርቂ ላናዋት እስን ካሳንዋ፤ <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>አየሱን ጎአመን እስን ባልቹማ ካኮቤተታን ካሙልሶን ፋፋ ካላይክ ካኢዳዶ ኢግ፥ ካካባጃመ ካክርስቶሳ ኢግያ። <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>የሱሳ ጣየ ካኮአዴሳመራ አላም አንመጣሞን ግራን ሆረነ ጎሌሮ ግዳ አደ ካጋቾ ጌሲ እስን ማራን ሙተራ። <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>ጋራኬሳነ፥ ጎይኮ ካኬሳሮና ካባጃ ካስሰሮ ዋይ አብዳታን፤ ሃኑን አማኖክስና አብድትስን ዋ ጉቲያ።<verse eid="1PE 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22"/>ጎርታ ሩሚ አጃጃማኖ ኔፎታትስን ማንኮሙጭሳቴን ማራን፥ አማኒሉን ታኢዳን ጌላንጀ ሀግርቶ፤ እስእስኦሮ ማዳራየን ዎዳናኮ ጌላየን። <verse eid="1PE 1:22"/><verse number="23" style="v" sid="1PE 1:23"/>ካላም ካኮአላተታን ታባቶ ሳኒኮ አንሌኖን ግራን ኔፎነ ግረረ አርዶክ ካሌሮና አታይ ካግርናሮ፥ ሃፉራ ካዋኮክ ጋራነ ታንባኖን ሳኒኮያ። <verse eid="1PE 1:23"/><verse number="24" style="v" sid="1PE 1:24"/>ኣላንቲና ማጻፋ ቁሉክ ጎጎአማሮ፥</para>
  <para style="q1" vid="1PE 1:24">“ሶ ካሳርሳተራ ዱባ ኤስ ኣንያ፤</para>
  <para style="q2" vid="1PE 1:24">ካባጃ ዱባና ታጋዶ ዳራራ ኣንታ፤</para>
  <para style="q2" vid="1PE 1:24">ኤንሳ ቆራራ፤ ዳራራና ኡባታ፥<verse eid="1PE 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25"/>ካጎታ ሃፉራ አደ</para>
  <para style="q2" vid="1PE 1:25">ጅሩ ጅሮማን አታተ ግራራ።”</para>
  <para style="m" vid="1PE 1:25">እስኑን ካላላባመሮ ካገጌሎ ሃፉራ ሂካያ።<verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="s1">አርዶክ ኤኤሞና ቁሉክ ጎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>ጎርታ ሜላነ ዱባ፥ ሶባኖ ዱባ፥ ኢፍሳዳኖ፥ ቃናተ፥ ማምስት ሀም ዱባ ትራ፤ <verse eid="1PE 2:1"/><verse number="2" style="v" sid="1PE 2:2"/>ፋይናክስኒ ጂናይን፥ ግዳ ካአላተሮ ይትት ኣን ኦሙጭመን ኦአያና ኤኖ ሀልቻ። <verse eid="1PE 2:2"/><verse number="3" style="v" sid="1PE 2:3"/>“ጎታ ካእዳንክ ላኖ አዴሰታን፥”<verse eid="1PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4"/>እባዶ ዶሌ ካቱፋመ፥ ዋይ ዶሌ አደ ካአሳባመና ካካባጃመ ካሌሮ አርዶክ ኤኤሞ ቶስ ጋባላማ፤ <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>እስና አድ፥ የሱሳ ክርስቶሳኮክ ጋራነ ዋ ካገጌላይስሮ ካአያና ጃርሶ ጎጎስሳኑን፥ ቁሉክ ቱቃሞል ሊን አርዶክ ኤኤሞል ኣን ካአያና ምን ሊን ማዳራማታን። <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>ማጻፋ ቁሉክ፥ “ሂክማ!</para>
  <para style="q1" vid="1PE 2:6">“ካአሳባመ ካካባጃመና</para>
  <para style="q2" vid="1PE 2:6">ምና አፋሩን መተ ካሌሮ ኤኤሞ ጽዮኒ ካይናራ፤</para>
  <para style="q1" vid="1PE 2:6">ኡሱ ካአማናራ ላኮሙላሮ</para>
  <para style="q2" vid="1PE 2:6">ካአማራ ሃፉራ ጻፋመ ግራ።”<verse eid="1PE 2:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7"/>ጎርታ እስን ኦአማናታኑን ሂክ ኤኤሞ ካካባጃመያ፤ ኦአማኖቱን አደ፥</para>
  <para style="q1" vid="1PE 2:7">“ኦግንባራን ቱፋተሬን ካሻፈራን ኤኤሞ</para>
  <para style="q2" vid="1PE 2:7">ምና አፋሩን መተ ሌ።”<verse eid="1PE 2:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8"/>አደና፥</para>
  <para style="q1" vid="1PE 2:8">“እባዶ ካሀንዱዱፍሳሮና ካሉጉዳሮ ኤኤሞ ሌ፤</para>
  <para style="q2" vid="1PE 2:8">ኦሀንዱዱፋታራና ሃፉራን አጃጃማና ዋትታ፤ ካኮንካመራና ሂካኑንያ።”<verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>እስን አዴን ሙጉድኮ ካሳድስሮ ኢፋ ቶስ እስን ካኡመሮ ኦአቲ ፈሎ ኦዋ ጎጎአዋጅታኑን ታአሳባንተ አላታንታን፤ ካዎኖ ቱቃሞል ቁሉክ ጎሳ ዋ ኡሱን ካዎዩይሳተሮ ጎሳታን። <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>እስን ጣይተን ኡናቴሳ ላኮቴን፤ ግዳ አዴን ጎሳ ካዋታን፤ ጣይተን ሻጋ ላኮሄላቴተን ግዳ አዴን ሻጋ ሄላቴታን።<verse eid="1PE 2:10"/></para>
  <para style="s1">ዋዉን ኦሀንዳራን ኣን ግራኖ</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11"/>ኦጌላታሮኦቴ! ሂካ አላም ማርትና ኡል ካካለክ እባዶ ማንኮሌተን ማራን ኔፎ ባስን ጀሬን ካሻፋታሮ ሀልቻ ካሶየኮ ጎጎፋክአንታዉን ኤባታራ። <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>ማምሲና ሜላነ ኦፈላታን ኣን የልሬን እስን ጎህማቴና ኡሱ ፊርዳን ካኮኤመተ ጎራታ ፈሎኦትስን ኦኢዳን ዲጉረን ዋ ጎጎካባጅራኑን፥ አይዛብ ኦሮ ግር ካእዳን ግራ።<verse eid="1PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13"/>ጎታዉን አማዴነ ኦዶናቲ ኦባሪሳራን ዱባን አጃጃማ፤ ኦዶናት ኦአባን ማንኮሌን ማራን ዎኖን ጎሌና፥ <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>ጎርቱን ፈሎ ኦሜላን ኦፈላራን ሙርስን፥ ፈሎ ኦኢዳን ኦፈላራን ጋላቲን ዎኖ ኦፋረሮ ሞትጆሉን አጃጃማ፤ <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>ኣላንቲና፥ ታኢዳን ፈላኖ ካካሶቱን ላኦ ካላይክ አየስ ጎጎጫልኢሳኑን ፈኢ ታዋታ። <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>ዋዉን ካሀንዳሮ እባዶ ኣን ላዴን ባልቹማ ግራ ኳሬ ባልቹማትስን ሜላነን ሆጎግ አሮየልቴን። <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>እባዶ ዱባዉን ታዶትሳቶ ካባጃ ስሳ፤ አቢላል ጌላየን፤ ዋና አብሳየን፥ ዎኖና ካባጃ።<verse eid="1PE 2:17"/></para>
  <para style="s1">ራኮ ታክርስቶሳኮት ማሱሳ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>እስን ኦሀንዳታን! ጎቶሌትስኑን ካባጃይ አጃጃማ፤ ካኮንአጃጃማታና ካኢዳኑና ፋያንካክ ካላሉን አንሌኖን ግራን ሜላነ ኦፈላራዉኔ ካባጃይ አጃጃማ። <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>ዋ ማራን አመረ ታግፈ ራኮ ካአታታራ እባዶ ጋላታ ሄላታራ። <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>ፈሎ ኦሜላን ፈልጉዴን ጎሙርሳንቴንና ጎኦብስቴን ጋላታ ካሜ አብታን? አየሱን ጎአመን ፈሎ ኦኢዳን ፈልጉዴን ራኮ ጎአታቴና ጎኦብስቴን ሂካኒ ዋይ ዶሌ ጋላታ ሄላይናታን። <verse eid="1PE 2:20"/><verse number="21" style="v" sid="1PE 2:21"/>ካኮንአማንቴታን ሂካኑንያ፤ ኣላንቲና ክርስቶሳ እስን ማራን ራኮ ካኮአታተራ ራኬሳ ጎጎሰሴታኑን ማሱሳ እስኑን ቱስን አመረያ።<verse eid="1PE 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1PE 2:22"/>“ኡሱና ጩቦ ላኮፈለሮ፤</para>
  <para style="q2" vid="1PE 2:22">ህኢቴሳኮና ምጌ ላኮቤተቶ።”<verse eid="1PE 2:22"/></para>
  <para style="m">
    <verse number="23" style="v" sid="1PE 2:23"/>ኡሱ ጎሀባሬና አባብ ላኮስሰሮ፤ ራኮ ኡሱ ጎጌተና ላኮማንዴ፤ አየሱን ጎአመን ሩሚ ካፍርዳሮ ሄዶን እስኦቴሳ ሮርሳተ ስሳተ። <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>ጩቦን ጎይነ ቁሉማ ጎጎግርኖን ኡሱ እሲ ሶኦቴሳይ ጩቦካን ማስቃሊ ጉት ስዳተ፤ ሜጋቴሳይ እስን ፋይቴታን። <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>እስን ካባየረ እዳድ ኣን ዉርቶዋ ግቴን፤ ግዳ አዴን ኔፎታትስን ካፎፋሮና ካኦራሮ ቶስ አባባቴታን።<verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s1">ጋራ ካኦርና ካኤንተሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1"/>ኡሱማለና እስን ኦርጆል! ኤንተርጆልክስኑን አጃጃማ፥ ሂካማሌ ኮኮ ሃፉራ ካዋቱን ካአጃጃሞን ጎግረ ሃፉራ ካዋ ካላይ ግር ካኦርይ ቦጃም አባባሮዋ። <verse eid="1PE 3:1"/><verse number="2" style="v" sid="1PE 3:2"/>ህክና ሊን ካኮዳንዳራ ካቁሉየሮና እባዶ ካካባጃሮ ግርክሶ ጎዴራንያ። <verse eid="1PE 3:2"/><verse number="3" style="v" sid="1PE 3:3"/>ኢድታትስን መተ ሀራታኖይ፥ ዎርቂ ካታኖና፥ ካካባጃመ ሳርስ ሳርሳታኖይ ሳሬ ካሙታሮ ኢሳዱን አሮሌኖ። <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>አየሱን ጎአመን ኢሳድክስን ዋይ ሆረ ኣሎ ታካባጃንተ ላኦ፥ ፋያንካና ካእስል አያና ካአቦ፥ ማጎሬና ካባኖን፥ ካኦሮ ማር ካኢደ ሀሌዎ። <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>ሆርኮስኮ አብድትሶ ዋ ጉት ካካተራ፥ ቁሉክ ሄለል ካኮኢሳዳረ ሂካ ጋራየ፤ ኤንተርጆሉና አጃጃማ ግረ። <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>ኡሱማሌ ሳራና አብራመ “ጎታኬ” አማ አጃጃማ ግቴ፥ እስና ኮና አንአብሳኖን ኢዳነ ጎፈልቴን ይስክሰታን።<verse eid="1PE 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7"/>እስን ኤንተርጆል፥ አዳ. ኤብክስን ጎጎሀንዱዱፋኖንኮ ግርክስን ዱባ ኦርጆልክስን ቆፓ፥ ላፋኒዕ ማንኮሌን ማራን ግርኮኒዕ ሶማና እስኔ ዎታ ማንኮኤልናራን ማራን ካባጃ።<verse eid="1PE 3:7"/></para>
  <para style="s1">እዳነ ፈላኖይ ራኮ አታታኖ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>ጎርታ ዱባና ቆፋ ቶይ እስአታ፤ እስእስ ሻዳ፤ አቢላል ኣን እስእሲጌላየን፤ ካነኔኤይሳታሮና ካአንጅራታሮ ላ። <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>ሜላነ ሜላነ ጎርቱን ሀባር ሀባር አሮአባብቴን፤ ሂካኮት ባንኤ ሶማሳየን፤ ኣላንቲና እስን ካኡማንተታን ሂካ ፈላኖይ ሶማ ሄላይንያ። <verse eid="1PE 3:9"/><verse number="10" style="v" sid="1PE 3:10"/>ማጻፋ ቁሉክ፥</para>
  <para style="q1" vid="1PE 3:10">“ግር ካጌላታራና አሪ ታኢዳን ድን ካዶታታራ፥</para>
  <para style="q2" vid="1PE 3:10">ኤሬብኬሳና አየስ ካሜላን ጎጎአዬሶንኮ፥</para>
  <para style="q2" vid="1PE 3:10">ህኢቴሳ ምጌ ጎጎአዬሶንኮ ሀአልሶ።<verse eid="1PE 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11"/>አየስ ካሜላንኮ ፋክ ሀኣሞ፤ ፈሎ ኦኢዳን ሀፈሎ።</para>
  <para style="q2" vid="1PE 3:11">ኖጎዳና ሀዶታቶ፤ ካኖጎዳ ራዲና ሀሰሴቶ፤<verse eid="1PE 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12"/>ኣላንቲና ኢልኦ ኦዋ ቁሎለ ቶስ ድያራን፥</para>
  <para style="q1" vid="1PE 3:12">ነበቦኦቴሳና ኤብክሶ ማልን ኦባናሜንያን፤</para>
  <para style="q2" vid="1PE 3:12">ታጎታ በቤዲ አደ ፈሎ ኦሜላን ኦፈላራን ጉት ግታ” አማራ።<verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>ፈሎ ኦኢዳን ፈልን ጎአታቴን ሚራኣ እስን ካጌግስራ አዮያ? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/>ፈሎ ኦኢዳን ፈላኖይ ራኮ ጎአታቴና አድ ሶማ ሄላታንዋ፤ ማንዳኖ ካእባዶ አሮአብሳቴን፤ አሮያዴን። <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>ክርስቶሳ ዎዳናትስኒ ካባጃ፤ እስኒ ታግቶ አብድ እስን ካሆሳታሮ ዱባዉን አባብ ስስን አርጌቶ ካኤካሳቴን ላ። <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>አባብክስን ኢዳነይና ካባጃይ ሀሌዎ፤ እስን ካክርስቶሳ ላኖይ ታአብታን ታኢዳን ያዳሊ ጉት ታሜላን ካአዬሳራ እባዶ ካሜላን አዬስኬሳ ጎጎሙልሮን ታኢዳን ሳሙ እስኑን ሀግርቶ። <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>ፈኢ ታዋ ሃ ጎሌተ፥ እስን ካሜላን አየስ ፈላኖይ ራኮ ካአታታንኮ ካእዳን አየስ ፈልጉዴን ራኮ ጎአታቴን ካእዳንክያ። <verse eid="1PE 3:17"/><verse number="18" style="v" sid="1PE 3:18"/>ክርስቶሳ እሲ ኖ ዋ ቶስ ጋባሊን ኡሱ ቁሉክ ሌ ግራን ቁሉማ ካላይኒዕ ኖን ጩቦካንኮት ኣላንቲ ታኮአዳሞት ኮክ ራኮ አታተረ ጎየራ፤ ኡሱ ሶይ ጎየራ፤ አያናይ አደ አርዶክ ሌራ። <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>ሀሱ አያና ሴተጉረ ምን ካሻኖ ካግሮ እባዶን ላላበ። <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>ሂክ ምን ካሻኖ ካግረ አያናጆል ጣየ ካኖሄ ጌሲ ማርካፋ ጎማዳራማረ ዋ ኦብሲ እሶ ኦራ ግራን ላኮአጃጃምኖ ኦአመረንያን። ኡሱ ማርካፋ ኦሮ ታበረ በከኮ ካሄሰረ እባዶ ቶቶይ ስዴድ ካላልየ።<note caller="-" style="x"><char style="xo" closed="false">3፡20 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7:24">መጣ 6፡1—7፡24</ref>።</char></note> <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>ሂኒዕ በከ ግዳ ካጥንቃታ ማሱሳ ሌንጉሬን ፋይሳራን፤ ሂክ ጥንቃታ ታማረ ጦርቀ ኬሳኖ አሌኖን ግራን ሙጭ ታአንተ ሳሙ ታኢዳንኮ ዋ ቶስ ካገያሮ ኤብያ፤ እስን ካፋይስናራና ጎይኮ ክያኖ ካየሱሳ ክርስቶሳኮክ ጋራነያ፤ <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>ኡሱና ዳሩር ቶስ ቤጉረ ዋ ኦዶኮት መርጌይ ግራ፤ ኤርግቻል ኦዶናትና ሁናጆል ኡሱ ሄገሊ ኢምናሜን ባራራን።<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s1">ዋዉን ግራኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>ጎርታ ክርስቶሳ ሶይ ራኮ ማንኮአታተሮ ማራን እስና ሂካ አዬሲ ሙዋየንጉደነ ክያ፤ ኣላንቲና ሶኦቴሳ ራኮ ካአታታራ እባዶ ጩቦ ፈላኖ ኢሰራ። <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>ሂካኮ ካከይ ጎርታ ካሄስናሮ ግር ካኡሌቱን ፈኢ ታዋክ ማለ ኳሬ ፈኢ ታሶየት ላኮግራሮ። <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>አይዛብ ጌላተረ ጎጎየላታሮ ማለ ራራጋታኖ፥ ሀልቻ ካሶየ፥ ሴታኖ፥ ዱዱራኖ፥ አካማሌ ጣማኖ፥ ኦሜላን ፈሎ ኦዱርሳ ካሰሰቴታን ካሮረራ ጌስ ሌራ። <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>ሂካ ኣንክክ ካዳርኣመ ግሪ እሶነ ዎታ ማንኮትያናዋተን ማራን እሶን ማርት ሌረ ሳዳ እሶ ሀባራራን። <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>አየሱን ጎአመን ኔፎነ ኦግራዉና ኦጎየራን ጉት ፍርድን ካኤካሳተሮ ኡሱን አባብ ስስናራን። <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>ካጎየሮና አንሄሶቲ ዎንጋላ ካኮንላላባመራ ህታ ኣላንቲንያ። ሂካማሌ ሶኦትሶይ እባዶ ኣን ፍርዳምናራን፤ አያናክሶይ ጎአመን ዋ ካኮግሮ ግር ማለ ግርናራን።<verse eid="1PE 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7"/>ጎርታ አየስ ዱባኮት ጋቾ ጋባላንተታ፤ አታይ ኤባይን ጎጎዳንዴታኑን ሳሙ እስኑን ሀግርቶ፤ ልክ ግራ። <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>ጌላንጀ ጩቦ ካሞጋን ማንኮጎልሳቶ ማራን ዱባንኮ ሮርሳዴን እስ እስኦሮ ኣሎ ጌላየን። <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>ሀጉንጉምኖን እስእስኦሮ ማርት ኣን እስ ቆጳዬን። <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>ካለካለት ስኖ ታዋኮክ እላቦል አብዳማኖና ኦዶናቲ ባሪሳኖይ እስኑን መተመቴ ካስሳመሮ ካስኖ እላቦሊ ካካለቱን ሀሃንዳዎ። <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>እስንኮ ማዮና ካአዬሳራ ጎግረ፥ ሃፉራ ካዋ ማለ ሀአዬሶ፥ ካሃንዳራ ጎግረና፥ ዋ ካስሳሮ ሁና ሀሃንዳዎ፤ ህክና ዋ የሱሳ ክርስቶሳኮክ ጋራነ ጎጎካባጃምሮንያ፤ ካባጃና ሁናና ኡሱን ጅሩ ጅሮማን ሀሌዎ ሀሚኒዕ።<verse eid="1PE 4:11"/></para>
  <para style="s1">ታራኮ አሪ አታታኖ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>ኦጌላታሮ ኦቴ! ኤለን ኣን ታጫፋቶ ራኮ ኦሮ ጎግቴን ካአዴሳሞን ማርትክ አየስ ካጌሮ ኣን የላይዴን አሮሳዴን፤ <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>ሂካኮ ታክርስቶሳ ካባጃ ካኮሙተ ጎራታ ኣሎ ጎጎገጌላታኑን ራኮቴሳ ካኮአታቴታንኮክ ጅልባይ ገጌላየን። <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>መገ ካክርስቶሳ ማራን ጎሀባራንቴን ካካባጃ አያና ካሌራ አያና ካዋ እስን ጉት ማንኮዳገሮ ማራን ኦሶማሳንቴታን። <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>እስንኮ ማዮና ራኮ ካአታታራ ጎግረ፥ ኔፎ ካላጋዳሮ ጎርቱን ካሄታሮ ጎርቱን ካባሳሮ ጎርቱን አየስ ካእባዶ ጠኤ ካታባሮ ልጉረ ራኮ አሮአታኖ። <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>ዋ ካአማናሮ ላኖይ ራኮ ጎጌተና አደ ሂካ መገ ማራን ዋ ሀጋላቶ ኳሬ አሮሙልኖ።<verse eid="1PE 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17"/>ፍርዳ ምን ካዋኮ ኪረ ካኮሀጋአብናራ ጎራታ ጌራ። ጎርታ ፍርዳ ካኮሀጋአብናራ ኖ ጉት ጎሌ ዎንጋላ ካዋቱን ካአጃጃሞን እባዶኮት ጋቾ ምስ ልናታ? <verse eid="1PE 4:17"/><verse number="18" style="v" sid="1PE 4:18"/>ማጻፋ ቁሉክ፥</para>
  <para style="q1" vid="1PE 4:18">“ቁሉክ እባዶ ፋይን ካዳንዳራ ራኮይ ጎሌ፥</para>
  <para style="q2" vid="1PE 4:18">ዋ ካሄዶይሳኖን እባዶ ምስ ሊን ግራ?” አማራ።<verse eid="1PE 4:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19"/>ሃኑን ፈኢ ታዋ ማለ ራኮ ካአታታራ እባዶ እስኦቴሳ ካመጠሮን ሀዳራ ስሳይረ ካእዳንክ አየስ ፈላናኮ ሃር አሮጋሎ።<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s1">እባዶ ካዋ ባሪስን ካስሳመሮ ሴራ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>ጎርታ እሶነ ዎታ ራቶ ምን ካዋክ ጃርሳ ካሌራ አን፥ ታክርስቶሳ ራኮዉን አቶ ካሌራ ኡሱማለና ሆረንባዉን ሙትን ታግቶ ካባጃ ካአታይናራ፥ እስን ኦሮ ታግቶ ምን ካዋኮት ጃርሶለ ጎርስናራ። <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/>ሀዳራ እስኑን ታስሳንተቶ ማተ ታዋ ኦራ፥ ካፎፋታን ሁና አንሌኖን ግራን ዋ ጎጎዶታሮክ ማለ ፈኢ ሀሌዎ፤ ማራጋዴን ጋጲጋጳኖ አሌኖን ግራን ሀንዳይን ካአብታን ሀልቻ ማለ ሀሌዎ። <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>ኡሱማለና ኦዶናትክስን ሄገሊ ኦግራን ሞይ ባርሳኖ አሌኖን ግራን ማቴዉን ማሱሳ ካእዳን ቱሳ ሀሌዎ። <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>ሂካ ጎፈልቴን ካአዴሳመ ኦዶ ፎፌ ካኮኤሜተ ጎራታ ካባኖን ካካባጃመ ካላቻ አታይናታን።<verse eid="1PE 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5"/>ኡሱማለና እስን ካኢማል! ጃርሶለዉን አጃጃማ፤ ዱባና ኢዳነ ሳርስ አን ሳርሳየንጉዴን ኮ ካካለቱን ሀንዳ፤</para>
  <para style="q1" vid="1PE 5:5">“ዋ ኮራሜሳክ ዲዳራ</para>
  <para style="q2" vid="1PE 5:5">ካእዳንክን አደ ስኖ ስሳራ” አማመ ጻፋመራ።<verse eid="1PE 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 5:6"/>ጎርታ ኡሱ ጎራታኬሳይ ጎጎጦቂስሮን ታአቲ ገነ ታዋኮ ሄገሌ እስኦትስን የራሳዬን። <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>ኡሱና እስኑን ማንኮሻዳሮ ማራን እስን ካጫናቅሳሮ ዱባ ኡሱ ጉት ካየን።<verse eid="1PE 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8"/>ጅልባይ ግራ፥ ናባዳ! ዲናክስን ዱርሳ ካኤኔግሮ ዶታ ካሀርቃሮ ሉባን ኣን ጎቦቢክስኒ ማራሙራራ። <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>አላም ዱባይ ታግታ አቢላልትስን ህታ ኣንትት ራኮ ካአታይናቶ አዴሳደን አማኖ አታዬንዴን ኔባየን። <verse eid="1PE 5:9"/><verse number="10" style="v" sid="1PE 5:10"/>ጎራታ ክጫሩን ራኮ ካኮአታቴን ጎራታ ክርስቶሳይ ጅሩ ጅሮማት ካባጃ ቶስ እስን ካኡማተራ ስኖ ዱባኮክ ሄዶ ኡሱ እሲ እስን ታአታቴታን ራኮኮ ሃስናራ፤ እስክስናራ፤ አታይስናራ፤ ጣቢስናራ። <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>ጅሩ ጅሮማን ሁናና ኡሱን ሀሌዎ! ሀሚኒዕ።<verse eid="1PE 5:11"/></para>
  <para style="s1">ታጋቾ ኖጎዳ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>ዋ ካአማናሮ ካአብዳማሮ አብያ አመ አን ካሄዳሮ ጋራ ካስላሰነ ሂካ ሀንዳ ጋባቢና እስኑን ጻፈራ፤ ካኮንጻፈራና እስን ጎርስና ህት ስኖ ታዋ ታሩም ላኖ እስኑን ሰግን አመረያ፤ ሃንሱን ህታ ስኖ ታዋይ አታዬን አላ።<verse eid="1PE 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13"/>እስን ኣን ካአሳባመራ ባቢሎን ካግራ ምን ካዋ ኖጎዳ እስኑን ፋራማራ፤ ኡሱማለና አማኖ ኤረኬ ካሌራ ማርቆሳ ኖጎዳ እስኑን ፋራማራ። <verse eid="1PE 5:13"/><verse number="14" style="v" sid="1PE 5:14"/>ዋ ካአማናሮ እባዶኮት ጌላንጄ እስእስ አንጋታ ኖጎዳ አታ። ኦክርስቶሳ ኦሌቴታን እስን ዱባን ኖጎዳ እስኑን ሀሌቶ።<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
