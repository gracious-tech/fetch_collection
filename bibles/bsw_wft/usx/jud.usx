<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Bayso New Testament</book>
  <para style="h">ይሁዳ</para>
  <para style="toc1">ሀንዳ ካይሁዳ</para>
  <para style="toc2">ይሁዳ</para>
  <para style="toc3">ይሁ.</para>
  <para style="mt1">ሀንዳ ካይሁዳ</para>
  <para style="imt">ታባኖ</para>
  <para style="ip">ካይሁዳ ሀንዳ ካኮንጻፋመራ አማኒል አሌኖን ግራን አማኒ ኣን ሌንጉረን ካጣራ አጋልስስ ካአጋልስሳሮ እባዶኮ አማኒል ሴርስንያ። ሀንዳ ሮርሳኖይ ካላምክ ጴጥሮሳ አን ሂካ ካጋባባን ሀንዳ ካጻፈራ ካላም ታኮአዳሞት ዋ ጎሳን ኮይክ ካስሰሮ አማኖ አታይ ጎጎአልራዉን ኦናባባራን ኣሎ ሻድሳራ።</para>
  <para style="iot">ራቶ ሂክ ማጻፋ ካአበራ</para>
  <para style="io1">ታባኖ <char style="ior"><ref loc="JUD 1:1-2">1-2</ref> </char></para>
  <para style="io1">ጣራ ኦአጋልስሳራንኮክ አጋልስስ፥ ያዳሊና ኢያኖ <char style="ior"><ref loc="JUD 1:3-16">3-16</ref> </char></para>
  <para style="io1">አማኖ ጎጎኦራናዉን ካስሳመሮ ጎርሳ <char style="ior"><ref loc="JUD 1:17-23">17-23</ref> </char></para>
  <para style="io1">ሶማ <char style="ior"><ref loc="JUD 1:24-25">24-25</ref> </char></para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>የሱሳ ክርስቶሳን ካሀንዳሮና ካያይቆባ አቢ ይሁዳ፥</para>
  <para style="p" vid="JUD 1:1">ዋ ኦዶይ ኦጌላንቴታና የሱሳ ክርስቶሳ ኡማንቴዴን ኦኦራንቴታን ዱባን፥<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13፡55</ref>፤ <ref loc="MRK 6:3">ማር. 6፡3</ref>።</char></note><verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ሻጋ፥ ኖጎዳና ጌላንጀ እስኑን ሀጂናቶ።<verse eid="JUD 1:2"/></para>
  <para style="s1">ጣራ ኦአጋልስሳራንኮት ሙርት</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ኦጌላታሮ ኦቴ፤ ራቶክ ፋይናካንዉን እስኑን ጻፊን ኣሎ ዶታ ግረ፤ ግዳ ጎአመን ካአባባኖን ራድ ዋ ጎሳን ኮክ ካስሰሮ አማኖ አታይ ሞ ጎጎአባታኑን ጎርሲን አን እስኑን ጎጎጻፊሮን ካሄሶን ሌ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ጎራታ ካሞጋንኮ ሆረነ ህታ ሙርቲን ካጻፋመራ ኮኮ እባዶ ሉቄ እስን ቶስ ታበራ፤ እሶና አብስ ታዋ ካላይኒዕ፥ ዋ ሄዶካንት ስኖ ባቲክ አያናይ ኦኢግልሳራና ኡሱ ካላል ዱባንኮ ካንጂንክ፥ ሞትካንና ጎታካን ካሌሮ የሱሳ ክርስቶሳ ኦካካታራንያን።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ሂካ ዱባ ጣይቴነ ኮይክ ካአዴሰታን ጎሌና፥ ጎታ ጎሳኬሳ ካግብጽ ኡልኮ ቤሰረ ጎጎሃሰሮና ኦአማኖን ግራን ሃር አባባተረ አደ ጎጎባሰሮ አን እስን ሻድሲን ዶታራ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ብያ. 12፡51</ref>፤ <ref loc="NUM 14:29-30">ቶቶ 14፡29-30</ref>።</char></note> <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ኡሱማለና ጂንናትሶ ኦራታናዋቲ ካሄሰሮ ኤርግቻል ሻዳ፤ ዋ እሶ ታፍርዳ አሪ ታጌቶ ጅሩ ጅሮማክ ሻኖይና፥ ጢልንጋክ ሙጉዲ ኦሮ አዳላይሰራ። <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ሂካማሌ ሶዶሚና ጋሞራይ፥ አደ ጎቦብክሶይ ካግራ ካታማል ሻርሙጡማን ካጃራሮ ሌ፤ ሴራኮ ሳር ቤረን እስእስኦሮ ሻርሙጡማ ፈለን፤ ሃንሱን እሶ ጅሩ ጅሮማት ኤለኒ ኦሙርሳማራኑን ማሱሳ ሌን።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">መጣ 19፡1-24</ref>።</char></note><verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ኡሱማለና ሂክ እባዶ ህስሎኦትሶ ካሰጋራን ራድ ሰሴታ እስኦትሶ ባቶይሳታራን፤ ኦዶናት ኦአባና ኔባታራን፤ ዳሩሪ ካባጃ ኦአባና ሀባራራን። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ኤርግቻሉን ዎይቻ ካሌራ ምካኤል አደ ሬስ ካሙሴ ማራን ዱርሳነ ዎታ ዶጋማግራን፥ “ጎታ ሀሃድሶ” አመራ ኳሬ ላኮሀባረሮ።<note caller="-" style="x"><char style="xo" closed="false">1፡9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳኔ. 10፡13</ref>፥<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">ዳኔ. 12፡1</ref>፤ <ref loc="REV 12:7">ራጋ 12፡7</ref>፤ <ref loc="DEU 34:6">አዳ. 34፡6</ref>፤ <ref loc="ZEC 3:2">ዛኪ. 3፡2</ref>።</char></note> <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ሂክ እባዶ አደ እሶን ካአዴሳሞን አየስ ዱባ ሀባራራን፤ ሳሙ ካላይክ ግድ ኣን ጎጎመጣመኒ ካካሳን አየስ ባራን።<verse eid="JUD 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JUD 1:11"/>ኣኔ እሶን! ራ ካቃዬል ሰተራን፤ ማራጋዴን ጋጲጋጳ ሽሬና ታባላሚ እዬራን፤ ሜላነ ታቆረይ ባየራን።<note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">መጣ 4፡3-8</ref>፤ <ref loc="NUM 22:1-35">ቶቶ 22፡1-35</ref>፤ <ref loc="NUM 16:1-35">16፡1-35</ref>።</char></note><verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>ሂኒዕ እባዶጃ ካጌላንጄ አሞክስን ጉት ሙላ ኮና ካላይ እስኔ ዎታ ጋባላሜረን ኦአማራን ሳልናጆልያን፤ አደ እስኦትሶ ኦላሉን ኦአማራንያን፤ እሶና አምባሊ ካዎዳማሮ ኢዳሞ ካላይክ ዱማንቻልያን፤ ዉጣ ታኮኩኩአማሮ ድግኒ ኢል ካኮሄላሞን ህዲድኮ ታጋመረ ላማ ጋለ ካአንጋገ ጋ አንያ። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ኦሙልሳራን ፈሎኦትሶይ ሳንባ ኦጉዳራን፥ ጎሜላን ካከያሮ ጋሽማሎ አንያን፤ ጢልንጋክ ሙጉድ ጅሩ ጅሮማን እሶ ካኦራታሮና፥ አዳ. ካካፋፋሮ ባራጃልያን።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>አዳመኮ ሀጋአበረ አላታን ታቶዶብ ካሌራ ሄኖክ አዬሳ “ሂክማ ዋ ቶታም ካሄሌላሞን ቁሉክ ኤርግቻልኬሳነ ዎታ ሌረ ዱባ ጉት ሙርቴስን ኤመይናራ፤<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="GEN 5:18">መጣ 5፡18</ref>፥<ref loc="GEN 5:21-24">21-24</ref>።</char></note> <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>ሀሱ ዋ ካሄዶይሳኖን እባዶ ካፈለሮ ካሜላን አዬስኮት ኣላንቲ ሙርስናራ፥ ዋና ሩምና ሂናኣ ኡሱ ኦሄዶይሳኖን ጩባልዬል ካአዬሰራን ካሜላን አየስ ዱባ እሶ ፍርድናራ” አመራ።<verse eid="JUD 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16"/>ሂክ እባዶ አርጌቶ ኦጉንጉማራና ማምስክ አዬሲና ኦገገላኖንያን፤ ካሜላን ራክሶይ ሀልቻ ኦሰሴታራንያን፤ ህኢትሶ ካኮራ አዬሲ ታአማጋንተታ፥ ላኦትሶ ዶታታ እባዶ ሶሶባራን።<verse eid="JUD 1:16"/></para>
  <para style="s1">ሴርሳኖና ጎርሳ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>አየሱን ጎአመን ኦጌላታሮ ኦቴ፥ ጎታካን የሱሳ ክርስቶሳ ኦፋራሜረን ሂታኮ ሆረነ ካአዬሰራን ሃፉራ ሻዳ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>እሶ “ካጋቾ ጌሲ ፈኢ ታዋኮ ኦፋክመራን እስኦትሶ ሀልቻ ካሜላን ኦሰሴታራን ኦቃጭፋታራን ኤሜይናራን” አመን እስኑን ሰጌረን።<note caller="-" style="x"><char style="xo" closed="false">1፡18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 ጴጢ. 3፡3</ref>።</char></note> <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>እሶ እባዶ እባዶኮ ኦአሳባራን፥ ካሶየ ሀልቻ ኦፈላራን፥ አያና ቁሉክ ካላይኒዕ እባዶያን። <verse eid="JUD 1:19"/><verse number="20" style="v" sid="JUD 1:20"/>ኦጌላታሮ ኦቴ እስን አዳ፥ ካካለኮና ካቁሎየ አማኖክስኒ እስኦትስን ቁሎይሳዪን አታዬን፤ አያና ቁሉክኮክ ሁና ኣሎ ኤባየን። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ጎታካን የሱሳ ክርስቶሳና ሻጋኬሳይ ጅሩ ጅሮማክ ግር ቶስ እስን ጎጎጌግስሮ ኦራታ እስኦትስን ጌላንጀ ታዋይ ኦሮ ኦራዬን።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>ካሄዳታሮ እባዶን ነኔኤይሳዬን፤ <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>እባዶ ኮኮ ኤሌንኮ ቤሳዴን ሃሳ፤ ካካለቱን አብሲ ነኔኤይሳዬን፤ ጎሌና ጩቦ ካባቶየሮ ማርክሶ ካድነ ሳርስ ዱባ ሀሄሶን ዲዳ።<verse eid="JUD 1:23"/></para>
  <para style="s1">ካጋላታ ኤብ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>እስን ጎጎኢኖንኮ የልና ቱፍ ካላይኒዕ የልረ ገጌሎይ ካባጃቴሳ ሆረ እስን አሊስን ካዳንዳሮ፥ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ኡሱ ካላሊ ዶብካን ካሌሮ ሄዶ፥ ጎታካን የሱሳ ክርስቶሳክ ጋራነ ሆርኮስኮ ካየረ፥ ግዳና፥ ጅሩ ጅሮማን ካባጃና ጋሻና፥ ሁናና ኦዶናትና ኡሱን ሀሌዎ! ሀሚኒዕ።<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
