<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">MAKU-BANDAWA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Maku</para>
  <para style="toc1">Kwã Nyimoː laɓe MAKU</para>
  <para style="toc2">Maku</para>
  <para style="toc3">Mk</para>
  <para style="mt2">Kwã Nyimoː laɓe</para>
  <para style="mt1">MAKU</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Nang Maɓesa Nang yi Yohana Wanə Botisima</para>
  <para style="r">)Matu 3.1-12; <ref loc="LUK 3:1-18">Luka 3.1-18</ref>; Yohana1.19-28&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Nang ni kəɓənə abaru anuanua lashi Yesɔ Almasihuː nwi yi Nyimoː. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Ba jwəjwa la dang ngwi dangdoswɔn kwã Ishaya yaː</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;Nyimoː cwa ya, gəmə ngə swon ngwi dangdoswɔn gə gəmbe laso,</para>
  <para style="q2" vid="MRK 1:2">gɔ u bwe məngang yo gu.&gt;&gt;<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />&lt;&lt;Ngwi ngɛ nga cwa yo ɓa nyɛnə la lapɛdo ya,</para>
  <para style="q1" vid="MRK 1:3">&lt;U ma məgang Daa shayonkiː</para>
  <para style="q2" vid="MRK 1:3">ma wa tãtã yona gɔ zhazho yimɓa.&gt;&gt;<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Nankənə Yohana bwa la lapɛdo, ngu nə botisma ngu cwayo anuanua, u fi mɓa sa Nyimoː ɓu tubi ka nəwa Botisma nəǃ Kə Nyimoː yafi gua nang anjɔ gua nə.&gt;&gt; <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Nəngwi ɓa ɓa ɓyagaɓanə ku nga mɓa la byəng kəmi Yahudiya, ɓa yi agang Urshelima, nga mɓa nga wasa Yohana. Gaɓa nga cwa nang anjɔ gaɓa nga tubi kəfi u nəɓa Botisma la dangdi Urdu. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Nangja Yohana ɓa maawa ɓa ndə njoroba, ngu dwə se gashi wa ɓa kwã, nang tang gɔ ka ngã ɓa fɛ̃, <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Yohana nga cwa nəngwi ɓa yo anuanua ya,&lt;&lt;Ngwi ngɛ nga ɓa la zə̃nze mə ngwi nang kwe sa mə ɓa gang ni, angye nang gəmə bala na bemi vĩsɛ tɔ gɔ. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Gəmə nəwa Botisma nə ɓa dibi , ama gɔɓə ɓa Yingu Nyimoː u nəwa Botisma nə.&gt;&gt;<verse eid="MRK 1:8" /></para>
  <para style="s">Botisma ɓa Nang do ma Yesɔ</para>
  <para style="r">)Matiyu 3.13-4.11; <ref loc="LUK 3:21">Luka 3.21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4.1-13</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Janla kə Yesɔ fi mbanə la Nazare la byəng Galili, kə Yohana nəwa Botisma nə la dangdi Urdu <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Kə Yesɔ nga bwanə la yidi ni kə u sang lakwã bwe kə yingu yi Nyimoː nga lashiwa na zho nə. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Kə ghɔ Nyimoː bwa la lankwã ya,&lt;&lt;Ka ku nə nwi mə angye nang ngə shãni, ngə wanua mə wane.&gt;&gt;<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Ɓabe kə Yingu Nyimoː ghɔnə la lapɛdo, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Udənə Yimɓa hakə gwe kaamba, kə shetan nga ma wa. Yesɔ ngə ɓa nang lavi ɓa, ama Maleka ɓa nga nyang gwɔn sɔ.<verse eid="MRK 1:13" /></para>
  <para style="s">Yesɔ kwida Nwi Nangjwa Gɔɓa</para>
  <para style="r">)Matu 4.12-22; <ref loc="LUK 4:14">Luka 4.14</ref>,<ref loc="LUK 4:15">15</ref>; <ref loc="LUK 5:1-11">5.1-11</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Lazinze nang tanə Yohana la fusina ni,Yesɔ gha la Galili ngu cwa yo anuanua abaru yi Nyimoː. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Yesɔ cwa ya,&lt;&lt;Məncwon nə ngɔnǃ Donyang Nyimoː zədo ngɔnǃ U tubi sa nang anjɔ gua, u dyanə ɓayo ade sa abaru anuanuaǃ&gt;&gt; <verse eid="MRK 1:15" /><verse number="16" style="v" sid="MRK 1:16" />Kə nga kwe byəng dangdi lafu yi Galili, kə u sang ngwi gwa ju ɓa mba Siman ɓa nwinyɔ wa Andrawu, ngə ɓa daagaɓa la dangdi agang yonəmani gaɓa ka ngwi gwa ju ɓa. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Kə Yesɔ cwa ɓanə ya, &lt;&lt;Kafĩ mə, gəmə ɓowanə ngwi gwa nəngwi ɓa.&gt;&gt; <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Ɓabe kəɓa vya kã gaɓa ɓa kafi wa.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Kə Yesɔ gha be la twa, kə sang Yakubu ɓa Yohana, nwi zabadi ɓa ngə la lagwa nga ma kã gwa ju gaɓa . <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Ɓabe kə Yesɔ kwida ɓa, kəɓa vya daa gaɓa Zabadi la lagwa ɓa ngwi nə nangnu gaɓa kəɓa kafi wa.<verse eid="MRK 1:20" /></para>
  <para style="s">Ngwi nang ɓanə Yingu Gwe Anjɔ Nəni</para>
  <para style="r">)<ref loc="LUK 4:31-37">Luka 4.31-37</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesɔ ɓa nwi nangjwa gɔɓa mɓa dya yii agang kafarnahu, kəfi lalo yi awinwi yahudawa ɓa Yesɔ gha yido ɓwa nəshi Yahudawa ɓa kəfi fudi na maɓesa nang.<verse eid="MRK 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 1:22" />Nəngwi ɓa wanə sawa ni nang yiswe gwa ɓa sa nang maɓesa nang gɔ, yona u maɓenə na ngwi maɓesa nang yi dang nangzhĩ Musa ɓa la, se u maɓenə na ngwi nang ɓanə njamu nəni.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Ɓabe kə ka ngwi mə ngɛ ɓa yingu gwe anjɔ nə u mɓa la yido ɓwa nəshi Yahudawa ɓa, ngu ɓwonku, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />&lt;&lt;Yesɔ ngwi Nazare, Kanə sɔ nga shã ɓɛ? Ko a mɓa yona kane yonki je ma? Nyi ngɔn ka nwa nə ku, kaku nə Yingu nang mɓanə labe Nyimoː niǃ&gt;&gt;<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Kə Yesɔ bi gwe anjɔ sɔ ya,&lt;&lt;Gadonə, a bwa lasa ngwi niǃ&gt;&gt; <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Kə gwe anjɔ sɔ nga jwa ngwi sɔ, kə ngu ɓwonku wanə, ku bwa lasawa u kwe.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Paca nəngwi ɓa nang yiswe gwa ɓa, hakə nga ɓyədo nə saɓa ya,&lt;&lt; Kanə sɔ ye ma? Kãdo nang maɓesa nang apa wa ye? Ngwi ni ɓa njamu nə ngu na gwe anjɔ ɓa dang, hakə nga nawa gang maǃ&gt;&gt;<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Ɓabe abaru Yesɔ majeku la byəng kəmi Galili.<verse eid="MRK 1:28" /></para>
  <para style="s">Yesɔ Nyɔndi Nəngwiɓa ɓa byagaɓanə</para>
  <para style="r">)<ref loc="MRK 8:14-17">Maku 8.14-17</ref>; <ref loc="LUK 4:38-41">Luka 4.38-41</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Yesɔ ɓa nwi nangjwa gɔɓa Yakubu ɓa Yohana ɓa vya yido ɓwa nəshi kəɓa kwenə layi Bituru ɓa Andrawu. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Nɛ gwa Bituru nga lazhi nga wasaga, ɓa nang dya Yesɔ nə, kəɓa cwa wa yo gɔnə. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Kə Yesɔ gha sɔ layi do nga gɔ, kə u gwa gaɓe wa kə lwe wanə. Kə saga sɔ vya wa, hakə lwe nəɓa nang tang nə.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Ba logwa nə, kəɓa ɓanə ngwi saga ɓa ngwi gwe anjɔ ɓa labe Yesɔ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Paca ngwi yi ɓasɔ ɓa ɓwa nəshi la dangɓwazhi layi sɔ. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yesɔ nyɔndi nəngwi ɓa ɓyagaɓanə, ngwi nangjwə ɓa chocho. kə vya gwe anjɔ na cwayo nla, yonamani gaɓa nyi ko gɔ kã wa ngɔn.<verse eid="MRK 1:34" /></para>
  <para style="s1">Yesɔ Cwayo Nuanua La Galili</para>
  <para style="r">)<ref loc="LUK 4:42-44">Luka 4.42-44</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Ba vulanə ɓa nwifĩ dudanə,Yesɔ lwe bwa vya layi gha yido nang ngwi ngɛ nɛnɛ la yimɓa ni ngu pɛdang. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Ama Siman ɓa ngwi gɔɓa nga zhanə ɓoni kəɓa gha nga kãdo wa. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Kəɓa mewa nəni, kəɓa cwonə ya, &lt;&lt; Paca nəngwi ɓa nga kãdo.&gt;&gt; <verse eid="MRK 1:37" /><verse number="38" style="v" sid="MRK 1:38" />Ama Yesɔ dya ɓanə ya,&lt;&lt;Sɛ je li gha yiiɓani ngənə sibeye ni. kə cwaɓa yo anuanua ma, ka Yo nang mɓamə nəni wa.&gt;&gt; <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Nankəɓənə Yesɔ zhazho paca la Galili ngu cwayo anuanua la yido ɓwa nəshi Yahudawa ɓa, kəfi ngu bwanə gwe anjɔ ɓa.<verse eid="MRK 1:39" /></para>
  <para style="s1">Yesɔ Nyɔndi Ngwi vaswe</para>
  <para style="r">)Matu 8.1-4; <ref loc="LUK 5:12-16">Luka 5.12-16</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Ngwi vaswe mə ngɛ ɓabe Yesɔ, ngwami ngu jua ya,&lt;&lt;Na dyanə ngɔn ni, aɓa na nyɔndi gə.&gt;&gt; <verse eid="MRK 1:40" /><verse number="41" style="v" sid="MRK 1:41" />Yesɔ sang laɓyɔ gɔ, kə tã gaɓe wa kə twanɓe sɔ. kə Yesɔ dyawanə yee, &lt;&lt;Amɛ nang pong ngɔnǃ&gt;&gt; <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Ɓabe kə nangjwə vaswe gɔ kanə. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Kə Yesɔ lawa ɓe ɓa nang da jacwẽ nə kə u nyangwa kwenə ɓe layimɓa, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />&lt;&lt;Yesɔ cwanə ya, anə akilo ɓa cwa ngwi ngɛ nəla. ama a caɓe so sa ngwi nyanang ɓa, ngɔn ni a nyang na nang Musa cwa ni yona tẽtẽ. yona nəngwi ɓa nyi ɓa nyɔndi gu ngɔn.&gt;&gt;<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Ama ngwi sɔ kwe gha ngu cwa nəngwiɓa abaru sɔnə la jeku. Na nangni kə Yesɔ ba nla na dya yingɛ la baba, kə u də la yidonang nəngwiɓa nɛnɛ ni. paca ku ma nəngwiɓa nga mɓa bewa la jeku.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">Yesɔ Nyɔndi Ngwi Swɛ Gwe</para>
  <para style="r">)Matu 9.1-8; <ref loc="LUK 5:17-26">Luka 5.17-26</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />La zinze nwi məncwon latwa, Yesɔ fi kwe la Kafarnahu kə nəngwi ɓa wa abaru u ngə layi. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Nəngwiɓa ɓa ɓyagaɓanə kəɓa ɓwa nəshi, hakə nwifi do nɛnɛ, ko la dang nywi ma.</para>
  <para style="p" vid="MRK 2:2">Yesɔ nga maɓaɓe sa yo anuanua yi Nyimoː. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Kə nəngwiɓa nea kə mɓanə ngwi swɛ gwe labe Yesɔ. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Kəɓa ba nla na dya be Yesɔ, yonəmani nəngwiɓa ɓya wanə, kəɓa bweshi nywi nəɓwɔ layido nang Yesɔ ngə nəni, kəɓa bwa shinywi sɔ, kəɓa sinə ngwi sɔ la zhi nga gɔ labe Yesɔ. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Kə Yesɔ sang yo ade gaɓa, ku cwa ngwi swɛ gwe nə u ya, &lt;&lt;Nwimə a yafa gu nang anjɔ gunə ngɔn.&gt;&gt;<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Ama ngwi maɓesa dang nangzhĩ Musa ngɛɓa də layimɓa, nga chəng yo la sɛgwɔnɓa, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />&lt;&lt;Nga cwa ya, Ka yonə ngwi ni nga cwa yo lɛma? Ngu shəndo sa Nyimoː Ka nwa ɓa nang nyangshi yafa nang anjɔ nə se ka Nyimoː ɓa nsɔ lama?&gt;&gt; <verse eid="MRK 2:7" /><verse number="8" style="v" sid="MRK 2:8" />Babege kə Yesɔ nyi nang nga chəng la sɛgwɔnɓa ni, nankənə ku ɓyəng ɓa ya,&lt;&lt;Ka yonə sɔ ngu chəng yiri nang ɓani la sɛgwowa ma? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Ka anwa jwəla na cwa ngwi swɛgwe ni, &lt;Ba yafa gu nang anjɔ gunə,&gt; ko ɓaya,&lt;Alwe cwe zhisɛ gu a zhazho maǃ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Ngə cwonə u nyi, Nwi nəngwi ɓa njamu yafa nang anjɔ nə la shi sapyang,&gt;&gt;Kə Yesɔ cwa ngwi nangjwə sɔnə, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />&lt;&lt;Gəmə cwonə a lwe, cwe zhisɛ gu, a kwe layi guǃ&gt;&gt;<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Kə ngwi sɔ ku lwe, cwe zhise gɔ, ku kwe. Paca nəngwiɓa nga sang wa, nga gwaɓe dangɓa, nga ɓwɔn Nyimoː nga ya,&lt;&lt; je mɛdi na sang yiri nang ni nlaǃ&gt;&gt;<verse eid="MRK 2:12" /></para>
  <para style="s">Yesɔ Kwida Lawi</para>
  <para style="r">)Matu 9.9-13; <ref loc="LUK 5:27-32">Luka 5.27-32</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Yesɔ fima bwa gha la dangdi yi Galili. nəngwiɓa ɓa ɓyagaɓanə ɓa kwon wa tala, ku ngu maɓaɓe sa nang. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />U mɓa ngu kwe, ku sang Lawi nwi Alfa də la yido mu shede kəmi. Kə Yesɔ yewa ya,&lt;&lt;Akafimə.&gt;&gt;Kə Lawi lwe kafiwa.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Lalo ngɛ, Yesɔ nga tang nang la layi Lawi. Ngwi mu shede kəmi ɓa ɓa ngwi nang anjɔɓa ɓa nga kafiwa ɓa ɓyagaɓanə, nga tang ɓa Yesɔ ɓa nwi nangjwa gɔɓa, nəngwiɓa ɓa ɓyagɔnə la tanteɓa nga kafiwa. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Ngwi maɓesa nangzhĩ Musa ɓa Farisawa ngɛ ɓa, nga sang ngu tang ɓa ngwi nang anjɔ ɓa ɓa ngwi mu shede lidi ɓa, Kə Farisawa ɓa ɓyə nwi nangjwa gɔɓa ya,&lt;&lt;Ka yonəsɔ ngu tang ɓa ngwi ɓa nima?&gt;&gt;<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Sade nang Yesɔ wayo sɔnə, kə ye ɓa ya,&lt;&lt;Ngwi njamu ɓa la kã ngwi nyɔndi la, seka ngwi ɓa nɛnɛ ɓa njamu nəni. Gəmə mɓa yo ngwi ade ɓa la, ama ngwi nang anjɔ.&gt;&gt;<verse eid="MRK 2:17" /></para>
  <para style="s">Dobyə yo lashi nang zhilo</para>
  <para style="r">)Matu 9.14-17; <ref loc="LUK 5:33-39">Luka 5.33-39</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Ka məgang awa nwi nangjwa Yohana wanə Botisma ɓa Farisawa ɓa nga zhilo, kə ngwi ngɛɓa mɓa nga ɓyə Yesɔ yo ya,&lt;&lt;Ka yonə nwi nangjwa Yohana ɓayi Farisawa ɓa nga zhilo, ama nwi nangjwa yiguɓa la zhilo lama?&gt;&gt;<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Kə Yesɔ dya ɓanə ya, &lt;&lt;Nga sha ngwi ɓa mɓa nə yifye ni ɓa fiɓa nywe nəma? Nɛnɛǃ inə nsha nəngwa ngənə ɓaɓa ngɔn ni, kəɓa nə nang sɔ la. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Ama lalo nga mɓa ɛ cwe sha nəngwa avya ɓa, be gə ka zhilo.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />&lt;&lt;Ngwi ngɛ nɛnɛ la zwe nangja a cwon ɓa nywanang apa nə unə nankənə ngɔn ni, nywanang apa sɔ ɛ nya nywanang a cwon sɔ, hakə nang nya sɔ kwe sa anlo ɓa nang ja.<verse eid="MRK 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 2:22" />Kəfi ngwi ngɛ nɛnɛ la ye difashi apa la la badi a cwon la, nanə nankənə ngɔn ni difashi sɔ ɛ ɓwon badi sɔ, ɛ ja badi sɔ ɓa difashi inabi. ɛ difashi inabi, seka badi apaɓa.&gt;&gt;<verse eid="MRK 2:22" /></para>
  <para style="s">Dobyə la lashi lalo Nang wiwi</para>
  <para style="r">)Matu 12.1-8; <ref loc="LUK 6:1-5">Luka 6.1-5</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Lalo Awiwi yi Yahudawaɓa kə Yesɔ ɓa nwi nangjwa gɔɓa mɓa kwe la lase yi nanpang tapu. a ngə la zho kə nwi nangjwa gɔɓa fudi na gba yii nanpang. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Kə Farisawaɓa cwa Yesɔ nə yee, &lt;&lt;A sang, nang nwi nangjwa gu ɓa nga nəni. Ka yonə nga nə nanang dang nangzhĩ Musa ye ɓe nəla la lalo anwiwi ni ma?&gt;&gt;<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Kə Yesɔ dya ɓanə yee,&lt;&lt;Ase umɛdi na cwa kwã nang Dauda nəni sa sade nang nywe ɓa ndau ɓa nga kã nang la tang ni. <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Nankənə kə gɔ dya layi Nyimoː kəfi utang ngwa ɓa nanə sa Nyimoː ni. Nangni nə nang La sapyang nang Abiyata konə nwianye ngwi nyanang. Lasa nangzhĩ Musa se ka ngwi nyanang nso la tang ngwa ni, ama Dauda tang ngwa ni ngɔn kəfi una ngwi gɔ ɓaǃ&gt;&gt;<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Kə Yesɔ yeshi nang cwayo gɔ ya, &lt;&lt;A ma lalo awinwi yo zã nəngwiɓa; ɓa ma nəngwi yo lalo awinwi la.<verse eid="MRK 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 2:28" />Nankənə Nwi Nəngwi ka kɔnə Daa shayonki hakə ma ɓa lalo awinwi.&gt;&gt;<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Yesɔ Nyɔndi Ngwi swe Gaɓe</para>
  <para style="r">)Matu 12.9-14; <ref loc="LUK 6:6-11">Luka 6.6-11</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Sade ngɛ Yesɔ dya la lanywi ɓwa nəshi, kə ngwi mə ngɛ ɓa gaɓe aswɛnswɛ nə ngə la yimɓa. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Ngwi ngɛ nga kã məngang na gwa Yesɔ ɓa ayibe nə sa nang zanla ni;<verse eid="MRK 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 3:3" />Kə Yesɔ cwa ngwi swɛ gaɓe sɔnə, &lt;&lt;A bwa ngə la sibe nwaku.&gt;&gt; <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Kə Yesɔ ɓyəɓa ya, kanə zã la ɓanə lalo awinwi ma? Daa shayonki ya ɓa na gang ma? Ko ɓa ya jə wi ma?&gt;&gt;</para>
  <para style="p" vid="MRK 3:4">Ama ngwi ɓa sɔ gadonə. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Kə Yesɔ sang ɓa la sa lɔgɔ, fi la yimɓa ku sang laɓyɔ gaɓa. ku cwa ngwi swɛ gaɓe nə ya,&lt;&lt; Atã gaɓo.&gt;&gt; kə tã gaɓe wa, kə gaɓe wa nyɔndi ɓabe. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Kə Farisawaɓa sang na nangni, kə ɓa bwa la lanywi agang. Ɓabe kə ɓa wanə ɓa ngwi Hirudu ɓa na nang la jənə Yesɔ ni.<verse eid="MRK 3:6" /></para>
  <para style="s1">Cwi Nəngwiɓa Ngə La Dangdi</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Kə Yesɔ ɓa nwi nangjwa gɔɓa, kə ɓa vya yi sɔ kə gha dangdi lafu Galili, kə nəngwiɓa ɓa ɓya gaɓanə la Galili kəɓa kafĩwa, hakə ɓa ngwi Yahudiya ɓa, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Ba ngwi Urshelima, ɓa ngwi ɓyən Edom, ɓa ngwi ɓyango yi Yodan, ɓa ngwi kəmi Taya ɓa Sidon. Ba ɓyagaɓanə kə mɓa sa Yesɔ yona ɓa wa nang ngu nənəni. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Nəngwi ɓa ɓya atawi kə Yesɔ cwa nwi nangjwa gaɓanə ɓa mɓanə gwa apika, yona nəngwi ɓa gu lashiwa. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />,Ngu nyɔndi nəngwi ɓa ɓyagaɓanə, hakə ɓa ngwi nangjwə ɓa nga mɓa kɛsẽ ɓawa yona atwanɓe sɔ. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Paca sade nang ngwi gwe anjɔ ɓa sɔnə ngɔn ni, kə ɓa gumi la sibewa nga &lt;bwonku nga ya,&lt;&lt;Ka Nwi Nyimoː&gt;&gt;<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Ama Yesɔ cwaɓanə ɓaɓu cwa ngwi ngɛ yo gənə la.<verse eid="MRK 3:12" /></para>
  <para style="s">Yesɔ ntẽ Ngwi Dandoswɔn ɓa jwacwimɓa</para>
  <para style="r">)Matu 10.1-4; <ref loc="LUK 6:12-16">Luka 6.12-16</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Ba ngənə kə Yesɔ jeshi nta, kə kwida ngwi ɓa ngu shan nəni, kə ɓa mɓa bəwa. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Layimɓa ku tẽ nəngwi njwacwimba la tangte ɓa yona ɓa ngə ɓawa. Ngu swonɓa nga cwa yo anua nua yi Nyimoː, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />gaɓa mɛ nang nyangshi bwanə gwe anjɔ.&gt;&gt;<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Ka njwacwimba ɓa nang utẽ nəniː</para>
  <para style="li" vid="MRK 3:16">Siman nang Yesɔ na yaa wa nə Bituru,<verse eid="MRK 3:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="MRK 3:17" />Yakubu nwi Zabadi ɓa nwinyiwa Yohana,</para>
  <para style="li" vid="MRK 3:17">Angye nang Yesɔ na yaa ɓa nə Buwanarji, &lt;&lt;wato nwi nywɔɓa,&gt;&gt;<verse eid="MRK 3:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="MRK 3:18" />Andarawu ɓa,</para>
  <para style="li" vid="MRK 3:18">Filibu ɓa,</para>
  <para style="li" vid="MRK 3:18">Batalomi ɓa,</para>
  <para style="li" vid="MRK 3:18">Matiyu ɓa</para>
  <para style="li" vid="MRK 3:18">Toma ɓa,</para>
  <para style="li" vid="MRK 3:18">Yakubu nwi Halfa,</para>
  <para style="li" vid="MRK 3:18">Taddiyu ɓa</para>
  <para style="li" vid="MRK 3:18">Siman nang shanə kəmi gɔ wanə,<verse eid="MRK 3:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="MRK 3:19" />Yahuda Iskariyoti angye nang janə Yesɔ ni.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesɔ ɓa Kwə Gwe Anjɔ</para>
  <para style="r">)Matu 12.22-32; Luka 11.14-23;</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Kə Yesɔ dyanə layi. Nəngwi fi ma ɓwa nəshi hakə ɓa nwi nangjwa gɔɓa aɓa tang nang la. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Kə nwi nyɔɓa wanə nang ngu nəni, kəɓa gha yona ɓa gwa wa, yonəmani nəngwi nga cwa ya,&lt;&lt;ɛ nandye dyawa ngɔnǃ&gt;&gt;<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Ama ngwi maɓesa nang dang nangzhĩ Musa ɓa mɓa la Urshelima ɓa ya,&lt;&lt;ɛ ka Ba'azabu kwə gwe dya la sawaǃ Ba nang nyangshi gɔ kəfi ngu bwanə gwe anjɔ ɓa.&gt;&gt;<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Kə Yesɔ kwida nəngwiɓa ngu cwaɓa nashoo nə yaː&lt;&lt;Shetan ɛ bwanə Shetan Ma?&gt;&gt; <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />&lt;&lt;Ɛ donyang gaa mba ngɔn, angye nga gbanbang nəswe ni, donyang ni kɛ dəla. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Nankənə layi ma ganə mɓa ngɔn ni kəfi nga gwanə swe ni, layi ni kɛ dəla. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Nə yido nyangshi shetan ganə nə lashi wa ni, kɛ jado la ɛ gugu yika gɔ mba ngɔn. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />&lt;&lt;Ngwi ngɛ nɛnɛ la dyanə layi ngwi njamu ni ngu mu nang gɔɓa se ngu fudi gwa ngwi sɔ dwə wa; nangni ngu bana mu nang gɔɓa la layi.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />&lt;&lt;Ngə cwowa yo ade nə, Nyimoː ɛ yafa nəngwi nang anjɔ ɓa yo doshəng nga nəni. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Ama paca ngwi nang cwanə yo doshəng sa Yingu Nyimoː kɛ yafa gɔnə la hakə ɓente,&gt;&gt; <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yesɔ cwaɓa nangni nə yonəmani nga ya,&lt;&lt;Gɔ ɓa gwe anjɔ nə.<verse eid="MRK 3:30" /></para>
  <para style="s">Nɛ Yesɔ ɓa nwiyɔ ɓa</para>
  <para style="r">)Matu 12.46-50; <ref loc="LUK 8:19-21">Luka 8.19-21</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Kə nɛ Yesɔ ɓa nwiyɔ ɓa kəɓa mɓa, ɓa ngə la ntẽ kəɓa swon ngwi ngɛ kwido. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Nəngwi ɓa də kwon wa tala, kəɓa wanə ya,&lt;&lt; Naa gu ɓa nwi anəngwa nga kãdo la ntẽ.<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Kə Yesɔ dyaɓa nəya,&lt;&lt;Ka waɓa nə naa gə ɓa nwinye məɓa ma?&gt;&gt; <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Kə Yesɔ sang ngwi ɓa dənə kwon wane taãla ni, kə uya, &lt;&lt;Sang naa gə ɓa nwinyəɓa ye! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Ngwi nang ku nə nang Nyimoː nga shanə ni kɔɓə nə nwinyə mə anəngwo, nwinyəmə anəngwa, kɔɓə fi nə naa gə.&gt;&gt;<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Nashoo lashi ngwi zwa Yinang</para>
  <para style="r">)Matu 13.1-9; <ref loc="LUK 8:4-8">Luka 8.4-8</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Lalo ngɛ Yesɔ fudi na maɓesa nang la dangdi lafu yi Galili. Cwi nəngwiɓa ɓa ɓyagaɓa nə kəɓa kwong wa tala, hakə u dya la gwa yidi ku də yimɓa la shidi. Cwi nəngwiɓa ngə dangdi agang la shinjwɔ. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />kə Yesɔ maɓa ɓe sa nang ɓa ɓyagɔnə la shi nashoo, ku yeɓa yaː<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />&lt;&lt;U gə cwo waǃ Sayi ngənə ngwi ngɛ gha lasẽ gɔ yona zwanang. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />U ngə la nang gba yi nang pang la lasɛ, kə yi nang pang ngɛ ɓa gu lashi məngang, kə nwinzhi ɓa mɓa tang paca. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Yi nang pang ngɛ fi ma gu lashi bu ɓa ntanəni, Kəɓa cwi ɓanwe yonəmani bu dosɔ swala. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Kə lo fudi na penəni, ku sweɓa hakə swonɓa, yonəmani ɓa mɛ dodə nə ɓwɔnla. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Donang ngɛ ɓa gumi la lakũ, kə kũ lwe gang kwe shiɓa hakə ɓa nə lashi nla. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Donang ngɛ fi gumi la kəmi ade. Kəɓa cwi hakə ɓa gang, kəɓa nə lashi, ngɛ ɓa nəyi kaanso cwi njwanjwa, ngɛ ɓa kaanca , ngɛ ɓa kaanto .&gt;&gt;<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Kəfi Yesɔ yeshi yo gɔ, &lt;&lt;Wa, nankənə,Ngwi nang bane chwe nəni, u waǃ&gt;&gt;<verse eid="MRK 4:9" /></para>
  <para style="s">Danfĩ Nashoo</para>
  <para style="r">)Matu 13.10-17; Luka 8.9, 10&lt;&lt;</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Sade nang Yesɔ dənə ɓansɔ ni, kə nwi nangjwa gɔɓa jwacwimba ɓa ngwi ɓa nga kafiwa ni kə ɓa jua u cwaɓa danfĩ nashoo ninə. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Kə cwa ɓanə ya, gua gɔ ɓa dyowanə ngɔn na nyi danfĩ doyang Nyimoː, Yesɔ dyaɓanə. Ama ngwi ɓa nɛnɛ la tangtowa ni, nang anwaku se ka nashoo. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Kəɓənə,</para>
  <para style="q1" vid="MRK 4:12">&lt;&lt;Gaɓa Nga sang</para>
  <para style="q2" vid="MRK 4:12">ama ka kɛɓa sang la,</para>
  <para style="q1" vid="MRK 4:12">Nga wa, kəfi gaa wa</para>
  <para style="q2" vid="MRK 4:12">ama ka nyi la.</para>
  <para style="q1" vid="MRK 4:12">Yona ɓa sang ngɔn ni gaɓa la fi laɓa labe Nyimoː,</para>
  <para style="q2" vid="MRK 4:12">kəfi u yafi gaɓa nə.&gt;&gt;&gt;<verse eid="MRK 4:12" /></para>
  <para style="s">Yesɔ Cwa Yo lashi Nashoo Ngwi Zwanang</para>
  <para style="r">)Matu 13.18-23; <ref loc="LUK 8:11-15">Luka 8.11-15</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Kə Yesɔ cwa ɓanə ya, &lt;&lt;Ase nyi nashoo ni lama? Kə bəɓa lu nyinə nwinfi wa ɓama? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Ngwi zwanang ni ka yo Nyimoː ngu zwa. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Ngwi ngɛ ɓa ngəna donang ɓa gunə la məngan ni; na nang nga wanə yo Nyimoː ni,Shetan ɓa kə cweyo sɔ ɓa cwaɓa nəni kwenə. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Ngwi ngɛ ɓa ngəna donang ɓa gunə la shin nta ni, ka kaɓa ngwi nang ɓa wanə yo kəɓa cwenə ɓa do anua nua nəni. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ama ɓa nɛnɛ ɓa bunə, ɓa jado nla. Sade nang laɓyɔ agang lwenə sa yo Nyimoː ni, ɓabe kə ɛ fiɓa zə̃nze. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Ngwi ngɛ ɓa ngəna donang ɓa gunə la la kuni, ka kaɓa ngwi nang wanə yo Nyimoː ni, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />Ama yo nang lasapyang ɓa yo nang me, ɓa nwang nang ngɛɓa, kəɓa dya hakə aɓeyo agang, ama kə nɛnɛ ɓa bwatenə. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Donang angye ba nang ɓa zwaɓa la kəmi ade ni, kaɓa nə ngwi nang ɓa wayo Nyimoː ni, kəɓa cwe, hakə ɓa nə bwatɛ ɓa kəɓenə, hakə ɓa mɛ dangjada ngɛɓa kaanso cwijwajwa, ngɛɓa kaanca, ngɛɓa kaanto .&gt;&gt;<verse eid="MRK 4:20" /></para>
  <para style="s">Nashoo lashi Nang cava</para>
  <para style="r">)<ref loc="LUK 8:16-18">Luka 8.16-18</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Yesɔ fi ma yeɓa ya, ko ngwi ngɛ ɓanə nang cava ngu gũ wa ɓa tasɔ ma? Ko ngu nyang wa lashi tebur ma? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Nang ngɛ nɛnɛ jwanjwa kɛ bwənla ni, angye nang kəɓa caɓenə lani, Nang ngɛ nang ɓa gũnə jwanjwa labwe jang. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Paca ngwi ɓanə yicwe wa gɔnə, uwaǃ&gt;&gt;<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />kəfi gɔ ma cwa ɓanə, &lt;&lt;U wa nəɓwɔ nang uwa niǃ Ba taasɔ nang amanəni, ka kəɓə Nyimoː ɛ monə ɓa kəɓə; hakə ma twoshi. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Paca ngwi nang ɓanang nəni, ɛ twawashi, ngwi nang nɛnɛ ɓa nang ngɛ nəni, ko a pika ma la ɓewa ni ɛ cwecwe.&gt;&gt;<verse eid="MRK 4:25" /></para>
  <para style="s1">Nashoo lashi nanpang nang cwinə ni</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesɔ mafi cwa ya, &lt;&lt;Ka nang donyang Nyimoː ngə nəni ye, ngə na ngwi nang nga gbanə donang la lasẽ ni. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Gɔ ngayinga ɓa duda nə, ku lwe ɓa lonə, kəfi aɓɛku yii nangpang ɓa nga lwe nga gang. Aɓɛku gɔ nyila koɓəɓa nga gang nə ma nla. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Kəmi sɔ nga na bwatɛ; ɓenbe ngu bwanə pya nanpang, kəfi u na lashi kəfi u bwanə yiwa. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Sade nang nanpang sɔ jinə ngɔn ni, kəɓa kwã wa ɓa sang yonəmani sade shangɔ nə ngɔn.<verse eid="MRK 4:29" /></para>
  <para style="s">Nashoo Lashi Musta</para>
  <para style="r">)Matu 13.31,32,34; <ref loc="LUK 13:18">Luka 13.18</ref>,<ref loc="LUK 13:19">19</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesɔ mafi cwa ya, &lt;&lt;Bɛnə kanə li mandi donyang Nyimoː ma?&gt;&gt; Yesɔ ɓyədo. Ko ɓa nashoo awa li cwa li bwanə ma? &gt;&gt; <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />U ngə na yii nyinshang angye nang yiwa ngənə lapika la tangte donang ɓa nga zwanə la lasẽni. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Kə latwa kə gang kəfi ɓe nyəshi agang ɓa zwani. u gang kwe sa nwifi jashi ɓa zwanə la lasẽ u na pa wanə hakə nwizhi ɓa nga səla yinjwə gɔ nga ma nwi gaɓa yimɓa.&gt;&gt; <verse eid="MRK 4:32" /><verse number="33" style="v" sid="MRK 4:33" />Ba nashoo ɓa byagɔnə yesɔ cwa ɓanə yo Nyimoː nə, na nang la nyi nəni. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />U cwaɓa nang ngɛ nəla, seɓa nashoo. Ama sade nang u ngə ɓa nwi nangjwa gɔɓa ni, ngu cwaɓa nang anwaku nə ɓa danfĩ wanə.<verse eid="MRK 4:34" /></para>
  <para style="s">Yesɔ Ngənə gwe Di Agang</para>
  <para style="r">)Matu 8.23-27; <ref loc="LUK 8:22-25">Luka 8.22-25</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Ba logwanə, la lalo sɔ Yesɔ cwa nwi nangjwa gaɓanə,&lt;&lt;Je gang yowa la ɓyango yi di ni.&gt;&gt; <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Kəɓa vya cwi nəngwiɓa ɓa je gwa nang Yesɔ dinə la lawa ni, kəɓa kwe ɓawa. Gwa ngɛ ngə ɓadi bəɓa. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Kə gwe di agang ɓa gwenə lwe nga mɓa, hakə nga lwenə di dangdi lakwã nga gbagwa fi nga dya lagwa hakə gwa fudi na zənɓa nə. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesɔ fi ngayinga la fĩgwa lashiwa lasa nang nyangshi. Kə nwi nangjwa gɔɓa lwewanə, kəɓa ya,&lt;&lt;Ngwi maɓesa nang, je i wuuwu, a chəng yo je lama?&gt;&gt; <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />Kə Yesɔ lwe la yinga, ku ngənə gwe sɔ, kəfi u cwa di dangdi agang nə,&lt;&lt;Ngəmiǃ a gadonə&gt;&gt;Kə gwe ngəmi, kə doga. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Kə Yesɔ cwa nwi nangjwa gɔɓa nə,&lt;&lt; kanə mowa ngu yiiyi nanang ni ma? Haɓeku nɛnɛ ɓa yoade nə ma?&gt;&gt; <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />Kəɓa yiiyi wane, kəɓa cwanə saɓa, &lt;&lt;Ka nwaye ma? Hakə gwe ɓa di dangdi agang ɓama nga wasɔ maǃ&gt;&gt;<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">Nang nyɔndi yi gwe anjɔ sa nəngwi.</para>
  <para style="r">)Matu 8.28-34; <ref loc="LUK 8:26-39">Luka 8.26-39</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesɔ ɓa nwi nangjwa gɔɓa gang gwa kwe gha ɓe ɓyən dangdi yi Garasinawa. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Sade nang Yesɔ bwanə la lagwa ni, ka ngwi nang ɓanə yingu nang anjɔ ni, ko bwa la yido nang nga dinə nəngwi ɓani.ngu gwe anjɔ nə sawa <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />kəfi gɔ ngəla yido di nəngwi ngu nga yimɓa. Kɛ ngwi ngɛ ba dwə wala, ko ɓa che; <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Yonəmani ajado ngɔn nga dwə gaɓe wa ɓa gagwe nwaku ɓa che, ama ngu kwã nang ɓasɔ ku. Hakə ngwi ngɛ nɛnɛ ɓa njamu nə na mɓa bewa. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Duda ɓa lalo ku ngu zha la yidonang nga dinə nəngwiɓa ni, ɓa shi nta ngu lɛlɛ ɓa ghɔnə, ngu jwa sawa ɓa ntaɓa<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Sade nang usang nə Yesɔ ɓa jagɔ nəni, kə ulwe ɓa gwenvɔ nə ɓu twə̃ ntavuwa la sibe Yesɔ. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Kə jaku ɓa ghɔnə ya, &lt;&lt;ka nə yarigu aɓema ma, Yesɔ Nwi Nyimoː agang? Ngə ju ɓa ya Nyimoː nə, ɓa nəma laɓyɔ la.&gt;&gt; <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />U cwa nankəɓənə yonəmani Yesɔ yewa ya, &lt;&lt;A vya ngwi ni, gu yingu anjɔǃ &gt;&gt; <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />Kə Yesɔ ɓyəwa ya, yo ka nwa? Kə yewa ya, &lt;&lt;Yamə ka ɓyawanə, yonəmani je ɓyawanə.&gt;&gt; <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Kə gɔ ju Yesɔ ɓa nyenə gu ɓa biɛ la donila. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />Badi ɓa donang tɔkare andale ɓa ngə nə nga tang nang la lagwe shigwa sɔ. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Kə gwe anjɔ ɓa nga ju Yesɔ ya, &lt;&lt;a nyɛ dya tangte andale ɓani, ki dya saɓa.&gt;&gt; <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Kə Yesɔ namɓə dya ɓanə. Kə yingu nang anjɔ ɓa sɔ kə bwa kə gha dya sa andale ɓasɔ. <verse eid="MRK 5:13" /><verse number="14" style="v" sid="MRK 5:14" />Ba nang sang nangni, ngwi zhã andale ɓasɔ ɓa va kəɓa na abaru layi gaɓa ɓa yii ngɛ ɓa. Kə nəngwi ɓabwa yona sang nang ɓa nga nənə nangni. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Kəɓa ɓanə be Yesɔ ni, kə sang ngwi sɔ ngənə ɓa gwe anjɔ ni, udə ɓa nangja nə lasawa, u ngə la akilo gɔ fi, kə ɓa yiiyi. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Ngwi nang ɓa a nənə nang la zayi ɓa ni, kə nga na abaru nang ɓa nənə nang ɓa ngwi gwe anjɔ sɔ ɓa andale ɓasɔ. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Kə ngwi ɓasɔ fudi na ju Yesɔ u vya kəmi gaɓa.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Na nang Yesɔ nga dyanə lagwa ni, kə ngwi nang nlo ɓanə gwe anjɔ nəni kə jua ya a dya mənə gha bo. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Ama Yesɔ dyawa nəla. Kə cwa wanə ya, &lt;&lt;A gha layi labe nwinyiu ɓa, a cwa ɓa tɔ nang ɓa nang Daa shayonki nunə ni.&gt;&gt;<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Kə ngwi sɔ kwə nəɓe, ku fudi ngu na abaru la byəng yii nə jwa, lasa nang agang ɓa nang Yesɔ nəwa nəni. Paca nəngwi nga gwaɓe dangɓa.<verse eid="MRK 5:20" /></para>
  <para style="s">Nwi Jaru anəngwa ɓa ngwanang twɔnɓesa Yesɔ ni</para>
  <para style="r">)Matu 9.18-26; <ref loc="LUK 8:40-56">Luka 8.40-56</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Sade nang Yesɔ fi gang nə gha nə la ɓyango la lagwa yidi, Kə cwi nəngwi ɓa ɓyagaɓanə kəɓa ɓwanə labewa. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Kə nwianye do ɓwa nəshi lanywi yaawa Jaru, ku mɓa yimɓa, kə u sang nə Yesɔ ni, ku gumi la gagwewa, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />U ngə ɓa nang jugɔnə ya, &lt;&lt;Nwimə apika ngə dang nang jwə nə. Ngə ju ɓa twɔnɓe sɔ yona nyɔndi ku cwido.&gt;&gt;<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Kə Yesɔ gha ɓawa. Nəngwi ɓa ɓyagaɓanə nga kafĩwa hakə nga pĩwa.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Ngwa mə ngɛ latangte cwi nəngwiɓa fa laɓyɔ sapyang jwa cwi mɓa ngu ye jwɔn. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />U fa laɓyɔ wanə labe ngwi nə ngɛ ɓa ɓyagaɓanə hakə ku jə shede gɔ ka ku, ama nte zəzan na gɔ mɛ njamu ni, fi nangjwə gɔ nga twashi. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Kə ngwa sɔ wanə abaru Yesɔ ni, kə u mɓa la ɓe zənzəwa latangte nəngwi ɓa ku twɔnɓe sa nangja gɔ. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Ngu chəng yo la sɛgwɔn wa,&lt;&lt;Ko ka nangja gɔ kə twɔnɓe nəma, gəmə ngə nyɔndi.&gt;&gt; <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Ɓabə kə nang ye jwɔn sɔ ngə ngəmi, ku wa lasawa ɓa nyɔndi gɔ ngɔn. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Ɓabe Yesa wasa nang nyangshi bwa lasawa, kə be yiwa latangte nəngwi ɓa, ku ya, &lt;&lt;ka nwa twɔnɓe sa nangja gəma?&gt;&gt;<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Kə nwi nangjwa gɔɓa cwa wanə ya,&lt;&lt;A sang nəngwi ɓa nga pĩnə swe na nangni, kə nga ɓyədo, &lt;ka nwa twɔnɓe so ma?&gt;&gt;&gt; <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />Ama Yesɔ nga sang do yona u nyi ka nwa nə nangni.<verse eid="MRK 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 5:33" />kə ngwa sɔ nyi nang ɓa nəwa nəni ngɔn, ku mɓa ɓa sayiinə ɓa nang tẽ swe nə, kə ɓu gumi la bewa ku cwa yo ade nəku. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Kə Yesɔ, cwa ngwa sɔ nə,&lt;&lt;Nwimə yo ade gu nyɔndi gu ngɔn, a gha ɓa jwɔ nə, kəfi a nyɔndi ngɔn sa nangjwə gu.&gt;&gt;<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Sayi Yesɔ nga cwanəyo ni, kə ngwi ngɛ ɓa la layi Jaru nga ya, &lt;&lt;ɛ nwuu anəngwa wuu ngɔnǃ Ka yonə la nyang ngwi maɓesa nang fa laɓyɔ ma?&gt;&gt;<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Ama Yesɔ nyang akilo gɔ sanang nga cwa nila, ku cwa nwianye lanywi ɓwa nəshi, &lt;&lt;Ba yiyi la, a dyanə ɓa yo ade. <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Kə Yesɔ vya ngwi ngɛla na kafĩwa, seka Bituru ɓa Yakubu ɓa nwinyəwa Yohana. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Kəɓa dya do layi Jaru, kə Yesɔ sang nəngwi ɓa nga dya nang nga lɛlɛ nga ɓwonku. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Ku dya layi, ku ye ɓa ya, ka yonə ngu lɛlɛ ngu ɓwonku na nangni ma? Ɛ nwianəngwa sɔ wunla, ngu ngayi nga.&gt;&gt; <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Kəɓa vɛwa vɛ doshəng nə. Ama kə bwanə nəngwi ɓa ku la ntẽ, ku cwe dɛ nwisɔ ɓa naa gɔ, ɓa nwi nangjwa gɔɓa nə nca, ku dya lanywi sɔ yido nang nwi sɔ ngənə yimɓa ni. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Ku gwa gaɓe nwi sɔ, ngu cwonə ya, &lt;&lt;Talita Kumi,&gt;&gt;angye ya &lt;&lt;Nwianəngwa atwa, gəmə ngə cwonə alwe.&gt;&gt; <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Ɓabe kə nwi anəngwa sɔ lwe ku fudi na zhazho gɔ. sapyang gɔ jwa cwi mba, nang ni naɓa nang yiswe wanə. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Ama Yesɔ daa jacwẽ ɓa, ɓaɓi cwa ngwi ngɛ nəla. ku cwa ɓanə ya ɓa nawa nang tang u tang.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">A nyi Yesɔ la Nazare</para>
  <para style="r">)Matu 13.53-58; <ref loc="LUK 4:16-30">Luka 4.16-30</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesɔ vya do sɔ kə kwe yi gɔɓa nwi nangjwa gɔɓa kə ka sewa. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />La lalo nang wii yi Yahudawa ɓa na nəni, kə Yesɔ dya fudi na ma ngwi ngɛ ɓa be sa nang la yido pɛdang. nəngwiɓa ɓa ɓyagaɓanə nga wasawa, kəfi sade nang ɓa wanə sɔni kə yii gwa ɓa. &lt;&lt;La je kə ngwi ni mɛ nang ɓani ma?&gt;&gt;Ka mye anwa lɛ ɓa nawa hakə ngu nənang ɓa na nangni ma?Gɔ nəɓəɓa unənə nang yiswe? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Ngwi ni ka kɔɓə nə ngwi ma ɓa shi la ma? Ka kɔɓə nə nwi Maryamu nwinye Yakubu, yusuf ɓa, Yahuda ɓa Siman la ma? Nwiyɔɓa anəngwa ɓa kaɓa ngə ɓe la ye ma?&gt;&gt;Kəɓa nyiwa. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Kəfi Yesɔ ye ɓa ya, &lt;&lt;Ngwi dangdoswɔn la nawa gang lajeku se la yigɔ nwiyɔ ɓa ladowa ɓa ngwi layi gɔɓa.&gt;&gt; <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Yesɔ nə nang yiswe ngɛ nla, se ka gaɓe wa ku nyang lashi nəngwi ɓa la pika kə nyɔndi gaɓa. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Kə Yesɔ yiyi yonəmani nəngwiɓa nɛnɛ ɓa yo ade nə.<verse eid="MRK 6:6" /></para>
  <para style="s">Yesɔ Swon Nwi Nangjwa Gɔɓa Njwacwimba</para>
  <para style="r">)Matu 10.5-15; <ref loc="LUK 9:1-6">Luka 9.1-6</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Kə Yesɔ kwida nwi nangjwa gɔɓa jwacwimba, ku swonɓa mba mba, kəfi unaɓa njamu bwanə gwe anjɔ ɓa. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Yesɔ cwa ɓanə ya, &lt;&lt;Be cwe nang ngɛ yo zho nila, ko nang tang, ko fũ, ko shede la lafu gua, ko shi gwa gaɓenə. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Ama u ja tɔ, ɓabu cwe nangja ngɛ la seka angye ngə soa ni. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Layi nang ku u sinə ngɔn ni, u də layimɓa hakə sade nang lu vyanə yii sɔni. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Paca yido nang ɓa cwowa lani, inə ɓa nyi na wasoa ngɔn ni, inə u lwe ngɔn ni, u gba bu gagwowa yona ngənə shedaku la shiɓa.&gt;&gt;<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Nankənə kəɓa lwə, nga cwa yo anuanua ya, nəngwi ɓa ufi mɓa sa Nyimoː. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Kəɓa bwanə gwe anjɔ ɓa ɓyagaɓanə, kəɓa fã ngwi nangjwə ɓa munə, kəɓa nyɔndi gaɓa.<verse eid="MRK 6:13" /></para>
  <para style="s1">Nang Wuu Yohana wanə Botisma</para>
  <para style="r">)Matu 14.1-12; <ref loc="LUK 9:7-9">Luka 9.7-9</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Kə kwə Hiridu wa abaru, yo yaa Yesɔ majeku, hakə ngwi ngɛ ɓa nga ya, &lt;&lt;Yohana wane botisma kə lwe nə la shije, kəɓə nə ngu mɛ nang nyangshi nə nang yiswe ɓani.&gt;&gt; <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Ama ngwi ngɛ ya, &lt;&lt;a ngwi dangdoswɔn Iliya,&gt;&gt;</para>
  <para style="p" vid="MRK 6:15">ngwi ngɛ ɓa ya, &lt;&lt; A ngwi dangdoswɔn ngɛ cho, lasa ngwi dangdoswɔn anlo ɓa. <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />kə Hiridu wanə yosɔni, ku cwa ya, &lt;&lt;Ka Yohana angye nang kənə lashi wani, kəɓa lwe wanə la shijeǃ&gt;&gt; <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Ka Hiridu ɓa lashi wanə, kə nadang ɓa gwa yohana, kə dwəwa la fusina. Hiridu nə nangni yo Horidiya, gwa nwinyə wa Filibu, angye nang gɔ fye ni. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yonəmani Yohana nga cwa Hiridu nə ya, &lt;&lt;zãla na fye gwa winyulaǃ &gt;&gt; <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Ase gɔ Horidiya nga wa mwanɛ Yohana la sɛgwɔa, hakə shãna jəwa, ama gɔ mɛ məgang la. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Yonəmani Hiridu nga yiyi yohana yonəmani ngu nyi ngɔn gɔ ka ngwi ade, ka ngwi atẽtẽ fi. kəɓənə kə gwaɓesa yohana nəɓwɔ. Ngu wasawa, konte gwɔn wa nga kən sade nang wanəyo gɔ ngɔn ni. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />Yeshiwa Hirodiya mɛ do ngɔn lalo mya Hiridu, sadenang gɔ nanə yinyɔ yo ngwi agang yi gwamnati gɔ ɓa, nwanye soje ɓa, kəfi ngwi nəgang ɓa la Galili <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Kə nwi Hirodiya dya bwanə dang ni, kəfi u nyang ngwizhe wanua ɓa. Nankənə kə Kwə ya &lt;&lt;kanə sɔ nga shã ma? Nəku a junə ngɔn ni, ngu nona.&gt;&gt; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Hakə ɓa nang ghanə, kwə sɔ cwa nwianəngwa sɔnə, &lt;&lt;paca nang junə ngɔn ni ngə nona, ko la gaa donyang gə mba maǃ&gt;&gt; <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Kə nwianəngwa sɔ bwa cwa naa gɔ nə, &lt;&lt;kanə nə ju ma? Naa gɔ cwanə ya, &lt;&lt; lashi yohana wanə botisma,&gt;&gt; <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />Ɓabe kə gɔ va kwe be Kwə ya, &lt;&lt;Ngə shã ɓeɓe anəma lashi yohana wanə botisma la la tasɔǃ&gt;&gt; <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />Ba nang wayo ni, kwə wanə, ama yo nang gha nang gɔ gəmbe gha ni ɓa sidang wa labe ngwi zhe gɔɓa, ngu shãla na nyi wanə la. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Kə gɔ swondo ɓa ngwi sangzhi gɔɓa anaɓa dang ɓa ɓanə lashi yohana. Ngwi sangzhi sɔ gha kə̃ lashi yohana la la fusina <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />kə uɓanə la la tasɔ kəfi naa nwianəngwa sɔ angye ɓanə ɓa nanə naa gɔ ni. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Kə ngwi kafi yohana ɓawanə abaru ni, kəɓa mɓa kəɓa cwe kwon gɔ, kəɓa di.<verse eid="MRK 6:29" /></para>
  <para style="s">Yesɔ Tanə Nəngwi Ba Kaajwa Fi Nto</para>
  <para style="r">)Matu 14.13-21; Luka9.10-17; <ref loc="JHN 6:1-14">Yohana 6.1-14</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Kə ngwi nə nangnu ɓa Yesɔ swon ɓani nəni kəɓa fi ɓa bewa, kəɓa cwa wa nang ɓaku gaɓa nəni ɓanang ɓa manəɓe nəni. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Nəngwi ɓa ɓyagaɓanə nga ghanə nga ɓanə ni, hakə Yesɔ ɓa ngwi dangdoswɔn gɔ ɓa, ɓamɛ baba na tang nang la. Kə u cwa ɓanə, &lt;&lt;mbe je yowa yido nang ngwi ngɛ nɛnɛ ni yido je di ɓanse kəfi yona gua wiso wa.&gt;&gt; <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Kəɓa dya lagwa kəɓa kwe yido nang nəngwi nɛnɛ ni. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Ama ɓa vyanə dosɔni, ngwi ngɛ ɓa ɓyagaɓanə ɓa sang ɓa, kəɓa nyi gaɓa kã nwa ngɔn; kəɓa kwe yii ɓa kəfi va ɓa gəmbe sa yesɔ ɓa nwi nangjwa gɔɓa. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Sadenang Yesɔ se ni ku sang cwi nəngwiɓa ɓyagaɓanə. kə gɔ sang laɓyɔ gaɓa. yonəmani ngə na ngaang nə nɛnɛ ɓa shaɓa ni. kə fudi na maɓaɓe sa nang ngɛ ɓa ɓyagaɓanə. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Lo zədo na gu kə ngwi kafiwa ɓa mɓa sɔ, kəɓa cwawanə ya, &lt;&lt;Yidonə fa nəngwi nɛnɛ, ɓeɓe ni lo zədo na gu ngɔn. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />A ta nəngwi ɓa ɓe kwe ɓa dya ɓe yido yanang ɓa yii apika ɓa kanəsẽ, ɓa ya nang ɓa la tang ni&gt;&gt;<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />&lt;&lt;Ama Yesɔ dya ɓanə ya, gua gɔ u naɓa nang tang.&gt;&gt;Kəɓa cwɔnə ya, &lt;&lt; Gu nga shan je ya nang tang yi shede nang nga wonə ngwi ne nangnu lalo ka nto fi mba, I tang ɓanə ma?&gt;&gt; <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Ngu cwa ɓanə ya &lt;&lt;Nwa na labowa ma? U gha u sang, kəɓa sang ni kəɓa ya, Nwa nə nto ɓa nwinju nə mba.&gt;&gt; <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Kə Yesɔ nyang ngwi kafiwa ɓa nyang nəngwi ɓadə tɔ tɔ la lavi a jwe. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Kə nəngwi ɓa də janəɓe, ngwi ngɛ ɓa kaanto ngwi ngɛɓa kaanmba cwin jwa . <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Kə gɔ cwe nwa nə nto ni ɓa nwinju nə mba, kə lwe nə lashiwa la lankwã, ngu wisi Nyimoː. Kə gɔ gbən nwa ɓa ngu naa ngwi kafiwa ɓa, nga naa nəngwi ɓa. Gɔ fi ganə nəngwi ɓa nwinju mba lasa paca. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Gaɓa ku ɓa tang laɓa je, <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />hakə ɓa ka fi nwa ɓa nwinju, ɓamɛ sinɔ njwa cwi mɓa. ɓa pɛ gɔnə. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Bya nəngwi ɓa tang nə nang ni nyinəwon ɓa kanjwa fĩnto.<verse eid="MRK 6:44" /></para>
  <para style="s">Yesɔ Zhazho Lashi Di</para>
  <para style="r">)Matu 14.22-33; <ref loc="JHN 6:15-21">Yohana 6.15-21</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Ɓabe Yesɔ nyang ngwi ɓa dya lagwa kəɓa ganwa kəfi ɓa gə̃wabe na gha la batsada, gɔ nang ɓe kə ta cwi nəngwi ɓa ɓe kwenə ɓe. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Lazənze nang taɓa nəɓe ni, kə gɔ je gwa nta ngɛ yona pɛdang. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />kə lo ɛ gwanə ni, gwa sɔ ngə tangte di agang. Sayi Yesɔ ngə lashi njwɔ ɓansɔ. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Ku sang ya nwi nangjwa gɔɓa ɓa nga tori ɓa nang byãnə gwa ni, yonəmani gwe nga sha ɓanyenə ɓaɓa, che nca yi duda, kə la sayi ce nca hakə ce ntonji yi nvula, gɔ gha saɓa ngu zhazho la shidi. Gɔ ngu nə yapɛ u kwe saɓa <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Ama ɓa sang wani ngu la shidi ni, kəɓa nə taməle ka gwe, keɓa ja kunə. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Yonəmani gaɓa ku ɓa sang wa, kəɓa yiyi kə ɓabe ngu cwayo ɓaɓa, &lt;&lt;Gua ɓu yiyi laǃ ka kəmə, tato bo yiyi la. <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />kə u dya la gwa ɓaɓa, gwe namɓə ngəmi ngɔn. Kə nwi nangjwa gɔɓa yiyi wanə, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />yonəmani ɓa nyi danfĩ nang tang nang ɓa tang nə nəngwi ɓa ka njwa fi nto ni nla, yonəmani sɛgwɔn ɓa chəng nla.<verse eid="MRK 6:52" /></para>
  <para style="s">Yesɔ Nyɔndi Ngwi Nangjwə La Janisare</para>
  <para style="r">)Matu 14.34-36&lt;&lt;</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Kəɓa gang dangdi agang, kəɓa səla la kəmi Janisare, kəɓa dwə gwa ladang dangdi agang. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Na nang ɓa vya nə gwa sɔ ni, kə nəngwi ɓa chəng ka Yesɔ. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Kə ngə dang gwenvɔ majeku la kəmi sɔ, gaɓa nga ɓanə ngwi nangjwə ɓa lashi nang nga gaɓa nga ghanə yido nang ku ɓa wanə ka Yesɔ ngɔn ni. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Paca yido nang ku Yesɔ ghanə ngɔn ni, yii apika, yii agang, ko yii lavi ɓa, nəngwi ɓa nga cwe ngwi nangjwə gaɓa la dang lomo, nga jua yo ngwi nangjwə ɓa twɔnɓe sawa ko la byəng nangja gɔ ma. paca ngwi nang ɓa twɔnɓe sɔni kəɓa nyɔndi.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Nang Zhĩ Nwanye Ba</para>
  <para style="r">)Matu 15.1-9&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Ngwi Farisawa ɓa ngwi maɓesa dang nangzhĩ Musa ngɛ ɓa la Urshelima kə ɓa ɓa ɓwanə be Yesɔ <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />kə ɓa sang ngwi gagwe Yesɔ ngɛ ɓa nga tang nang ɓa gaɓe ashənshənə, ɓa waa gaɓə ɓa nla sa yo nang zhĩ ɓa.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Yonəmani Farisawa ɓa nwi fi Yahudawa ɓa la tang nang la se ɓa wa gaɓe ɓa tẽtẽ mbe, sa yo nang zhĩ nwanye ɓa. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Inə ɓa fi lomo aɓa ngɔn ni la tang nang la se ɓa wedi mbe. Kəfi nga kafi nangzhĩ ngɛ ɓa ngənə angye gua cwe ni, ɓa nang nyangwɔnsa nang wasa nwinkwi fa dibi, ɓa vye, ɓa chang di ɓa,kəfi gɔ nang nga ɓa.&lt;&lt;<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Kə Farisawa ɓa ngwi maɓesa nangzhĩ Musa ɓa kə ɓa ɓyəng Yesɔ, ka yonə ka vya nwi nangjwa gua ɓa la kafi nang zhĩ nwanye banla ama nga tang nang ɓa gaɓe ashənshə ma?&gt;&gt;<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Kə Yesɔ dya ɓa nə ya, &lt;&lt;Bəɓa zãgɔ kə jwa la lakwã Ishaya lashuwa ngwi dansa ɓa, na nang ɓa njwa njwa ya,</para>
  <para style="q1" vid="MRK 7:6">&lt;&lt; Ngwi ɓa ni fa, Nyimoː cwa ya, ɓa shidang ɓa kə nga nəma nə gang,</para>
  <para style="q2" vid="MRK 7:6">ama segwɔn ɓa nɛnɛ sa mɛ. <verse eid="MRK 7:6" /><verse number="7" style="v" sid="MRK 7:7" />Yinse kə nga jumə nə.</para>
  <para style="q2" vid="MRK 7:7">Yonəmani nga maɓesa nang zhĩ nəngwi ɓa,</para>
  <para style="q2" vid="MRK 7:7">Na yo Nyimoː nəǃ&gt;<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />&lt;&lt;Gua uvya yo nang Nyimoː ya ɓa nə ni, ngu kafi nang zhĩ nəngwi ɓa.&gt;&gt;<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />kə Yesɔ ye ɓa ya, &lt;&lt; ama unyi ɓe vya yo Nyimoː u kafi nang nang maɓenə guaǃ <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />kə Musa ya,&lt; a naa daa gu gang ɓa naa gu,&gt;kəfi, &lt;Inə ngwi ngɛ chwe daa gɔ ko naa gɔ ɓa nzhang ngɔn ni ɛ jəwanjə.&gt; <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ama gua ma nəngwi ɓanə ya inə ngwi ngɛ ɓanang la bali daagaɓa ko sa naa gɔ&lt;, ku ya,&lt; paca nang ɓa u mɛnə la bemə ni gəmbe naa Nyimoː ngɔn.&gt; <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Na nangni ku byiɓa na bali daa gɔ ko naa gaɓa. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Na nangni kə nang maɓenə gua janə yo yi Nyimoː. kəfi nang ngɛ ngənə ɓa ɓyagaɓanə gua u nə. &gt;&gt;<verse eid="MRK 7:13" /></para>
  <para style="s">Nang nga nyang nə nəngwi nang anjɔ</para>
  <para style="r">)Matu 15.10-20&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Na nangni kə Yesɔ kwi cwi nəngwi ɓa sawa ku ya &lt;&lt;Wasamə, gua ku nyi nang. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Nang ngɛ nɛnɛ nga dya nə la la nəngwi la nyanwanə tẽnə lani.&gt;&gt; <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Ngwi ɓa nə yicwe nə ni, u wa.&gt;&gt;<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Sade nang Yesɔ vya nə cwi nəngwi ɓa ni ku dya layi, kə nwi nangjwa gɔɓa ɓyəwa danfĩ nashoo nang ngu manəɓenə ni. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />kə Yesɔ dya ɓa nə ya,&lt;&lt;ase, gua ma u nyinla ma? Unyi nla paca nang dyanə la ladang nəngwi la ntẽ ka kəɓə nga ɓa nə nang anjɔ la, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />yonəmani la sɛgwɔn wa nga dya la, ama la laawa kəfi nankənə nga gha lasawa&gt;&gt;)Lasa yoni kə Yesɔ ya nang tang anwaku zəzan na tang.&lt;&lt; <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />Kəfi Yesɔ mafi ya,&lt;&lt;nang nga bwanə la la nəngwi ni ka kəɓə nga ɓanə nang anjɔ sa nəngwi. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />ku ya la sɛgwɔn nəngwi kə nang cheng anjɔ nga bwanə, na nang janang nə, nang nga ɓa gwa nəngwi ɓa, nang yinang jədo ɓa nang jə nəngwi, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />Nang nga ɓa gwa nəngwi, ɓa sunə, ɓa la a jwənjwə, ɓa dangfun, ɓa nangja nang tafĩ ɓe, doshĩ, ɓa nang ja yaa, ɓa nang shan gang, ɓa nang sese. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />paca nang anjɔ ɓa ni la sɛgwo kə nga bwanə, nga ɓanə nang anjɔ sa nəngwi&gt;&gt;<verse eid="MRK 7:23" /></para>
  <para style="s">Yoade Ngwani</para>
  <para style="r">)Matu 15.21-28&lt;&lt;</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />La yimɓa kə Yesɔ lwe kwenə la ɓyən Taya ɓa Sidon. Ku dya layi mɛ ngɛ, u shanla na ngwi ngɛ nyi. Ama nang jwa gɔ nənla. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />ɓanwe kə ngwa mɛ ngɛ wa abaru gɔ. Ku ɓa ɓu gu la bewa. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Ngwa sɔ u ka Baheleniya ɓa. a mya wa la ɓyən Basurofinikiya, la kəmi Suriya. Kə ju Yesɔ kə bwanə gwe anjɔ lasa nwi wa. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Yesɔ ye ngwa sɔ ya,&lt;&lt;mbe nwi jwɔn ɓa tang laɓa je, zanla na a mu nang tang nwimjwɔn ɓa a naa nwinja ɓa.&gt;&gt; <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />Ama ngwa sɔ dyanə ya,&lt;&lt;Ka yo ade, Daa shayonki, ama ɛ nwinja ɓa nga tang nang nga gunə la shi shĩ nyang nang tang nwinjwɔn ɓaǃ&gt;&gt;<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Kə Yesɔ yewa ya, &lt;&lt;sa yo nang a dyanə ni, a gha yi, gwe anjɔ sɔ bwa ngɔn sa nwindɔ gu.&gt;&gt;<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Kə ngwa sɔ fi gha layi kə mɛ nwi wa nga la shi nang nga, gwe anjɔ sɔ bwa ngɔn lasa wa.<verse eid="MRK 7:30" /></para>
  <para style="s">Yesɔ Pəng Ngwi Bwɔncwe</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Kə Yesɔ bwa la ɓyən Taya, kə bu gwa la Sidon ku gha la Dangdi agang yi Galili. La məngan, ku ɓa la ɓyə yiɓa lenə njwa kaɓanə Dikafoli. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />La dosɔ ka ɓanə ngwi ɓwoncwɛ, nang lu wado nəɓwɔ nla. Kə ɓa jua ya gɔ nyang ɓe sa ngwi sɔ yona u pong wa ta.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Yesɔ gwa ngwi ɓwoncwɛ gha nə dagang yido nang ngwi ngɛ nɛnɛ yimɓa ni, kə nyang yinfya ɓewa la yicewa, ku pyeng wa ntətɛ nə, ku mafi ɓe ɓyəwa ɓa ntetɛ. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Yesɔ lwe nə lashi wa lankwã ku dawi ɓa jagɔ nə, ku ye wa ya,&lt;&lt;Iffataǃ&gt;&gt;ngu ya &lt;&lt;Bweǃ&gt;&gt;<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Ba nang cwa gɔnə kə yicwe ngwi sɔ bwe, nang dwanə ɓyəwa ni vi ngɔn, ku fudi na cwa yo nəɓwɔ. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Yesɔ dajachwẽ ɓa ɓe cwa ngwi ngɛ nə la, ama ngu yeɓa ya ɓe cwa lani, gaɓa nga ghanə abaru sɔ ma jeku. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Nəngwi ɓa ku wani ngə ɓa nang cheng nə, nga ya,&lt;&lt;Sangni, unə nang anwaku nəɓwɔǃ hakə mafi nyang ngwi ɓa nang nlo yicwe ɓa ɓwoni nga wado, ɓa ngwi ɓa nlo dang ɓa lwənəlwə ni nga cwa yo.&gt;&gt;<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yesɔ Tang Ne Nəngwi ɓa Kaajwa fi Nea</para>
  <para style="r">)Matu 15.32-39&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />La lalo sɔ, kə cwi nəngwi ɓwashi nəngwi ɓa fi ma ɓwanə ɓa zan gɔnə. Yonəmani a nɛnɛ ɓa nang la tangni, kə Yesɔ kwi nwi nangjwa gɔɓa ku cwa ɓanə ya, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />&lt;&lt;Ngə sang laɓyɔ ngwi ɓa ni, yonəmani gwe nca nwiza ɓa ngə ɓamə, ɓa nɛnɛ ɓa nang tang nə. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Inə gəmə nyangɓa a kwe yi ɓa nywe nə ngɔn ni, ɛ gaɓa gha gugu la məngang. yona ngwi ngɛ gaɓa mɓa ɓa jagɔnə.<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Nwi nangjwa gɔɓa dyawanə, ya,&lt;&lt;La lavi nima, laje je li mə nang tang kə tangnə ngwi ɓa ni ma?&gt;&gt; <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />Yesɔ ɓyəng ɓa ya, nwa na ku ɓakəɓenə ma?&gt;&gt;Kəɓa ya, &lt;&lt;Ntomba&gt;&gt;<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Ku nyang cwi nəngwi ɓa də kəmi. Ku cwe nwani ntomba, ku pɛdang sa Nyimoː, ku gbenəɓe, ku fudi na ngu naa nwi nangjwa gɔɓa yona la naa nəngwiɓa, kəɓa gaɓanə. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />A ɓa nwinju nə lapika. Ku pɛdang lashi ɓa, ku ya u mafi ganə cwi nəngwiɓa. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Nəngwiɓa tang, hakə laɓaje, hafi ma ntẽ nwifiwa sənɔ ntomba. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Ngwi ɓa tangnə nangni ɓyagaɓa hakə dəbu nea. Kə nyangɓa a kwenə ɓe. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Bang we kə Yesɔ dya lagwa yidi ɓa nwi nangjwa gɔɓa, ku gha la ɓyəng Dalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Farisawa ɓa ɓyədo yo na sang nang yiswe</para>
  <para style="r">)Matu 16.1-4&lt;&lt;</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Ngwi Farisawa ɓa mba fudi na gwanə swe ɓa Yesɔ. Nga shana ma Yesɔ, kəɓa fudi na jua na u caɓa ɓesa nang yiswe agang nang la canəɓe sa gang gɔni. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Sade nang gɔ wanə nangni, ku dawi ɓa zwagɔnə, ku ya,&lt;&lt;Ka yonə gua ngwi sapyang ɓani ngu ka na sang nang yiswe ma? Ngə cwowa yo adenə, nang yiswe ngɛ nene nang nə ca ngwi sapyang ɓani ɓenə ni.&gt;&gt; <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Nankənə ku dya lagwa yidi, ku gang gha la byəng ango.<verse eid="MRK 8:13" /></para>
  <para style="s">Yisti fənang yi Farisawa ɓa yi Hiridu</para>
  <para style="r">)Matu 16.5-12&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Ama nwi nangjwa Yesɔ ɓa gwɔn ɓa jangɔ na ɓanə nwa ɓe kəɓakənə lenə nso kə la bəɓa la lagwa yidi. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Kə Yesɔ da jacwẽ ɓa, u ya, &lt;&lt;U sangni, u nə akilo ɓa yisti funang yi Farisawaɓa ɓa yi Hiridu.&gt;&gt;<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Kə nwi nangjwa ɓa fudi na cwa yo nəsaɓaː&lt;&lt;Ko yonəmani je nɛnɛ ɓa nwanə ku cwa yoni na nangni ma?&gt;&gt; <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />Yesɔ nyi nang gaɓa nga cwa nəni ngɔn, kə Yesɔ ɓyəɓa yee,&lt;&lt;Kanə moa ngu cwayo gua u nɛnɛ ɓa nwanə ma? Aɓeku gua nyi la ma? Sɛgwowa nya wanə ma? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Uɓa zayinə ama lu sang la ma? Uɓa yicwe nə ama lu wayo la ma? Haɓeku u cheng lama? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Sade nang tang nə nəngwi ka nto fi njua fin nto 5,000 ɓa nwanə lenə nto ni, nwifi Sənɔ na kə mu ma?&gt;&gt;</para>
  <para style="p" vid="MRK 8:19">Kəɓa dyanə ya, &lt;&lt;Sənɔ njwacwi mba.&gt;&gt;<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />&lt;&lt;Fi nwa ntomba nang gbenə nəngwi ɓa nə kaanto fin njwa fin nea nima? Sənɔ agang ɓa na ku munə nwifi nang tang penə ma?</para>
  <para style="p" vid="MRK 8:20">Kəɓa dyawanə ya, &lt;&lt; Ntomba.&gt;&gt;<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Kə Yesɔ yeɓa ya, &lt;&lt;Haɓeku u nyi yo ngə cwa ni lama?&gt;&gt;<verse eid="MRK 8:21" /></para>
  <para style="s">Yesɔ Nyɔndi Ngwi Bwonyi la Betsaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Sade nang a ɓanə la Betsaida ni, kəɓa mbanə.anə ngwi ɓwonyi la be Yesɔ ka ju wa ya utwɔnɓe sa ɓwonyi sɔ. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Kə Yesɔ gwa gaɓe ngwi ɓwonyi sɔ kə ghanə la zinze yii. Kə Yesɔ fənə ntətɛ la zayi ngwi sɔ, ku twɔnɓe sa zayi wa, Ku ɓyəwa u ya, &lt;&lt;Aɓa nga sang nang ngɛ ma?&gt;&gt;<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Kə ɓwonyi lwe nə zayi wa lankwã, ku ya, &lt;&lt;Ngə sang nəngwiɓa, ama ngə sang ɓa na shiɓa ɓa nga zhazho nga kwonə.&gt;&gt;<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Kə Yesɔ mafi twɔnɓe sa zayi ngwi sɔ. Kə zayi ngwi sɔ nyɔndi, kə ngu sang nang awaku nəɓwɔ. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yesɔ nyang wa ya u kwe yi, ku yewa ya, &lt;&lt;Ba gwa la yi sɔ la, ko byəng yi sɔ.&gt;&gt;<verse eid="MRK 8:26" /></para>
  <para style="s">Bituru dyanə ɓa Yesɔ konə Almasihuː</para>
  <para style="r">)Matu 16.13-20; <ref loc="LUK 9:18-21">Luka 9.18-21</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesɔ ɓa nwi nangjwa gɔɓa kwenə ɓe ka dya la yi ngɛɓa zədo ɓa kasiriya Filipi. La məngang kə gɔ ɓyəɓa, &lt;&lt; U cwamənə kanə nəngwi ɓa nga cwa ya gəmə ka nwa ma?&gt;&gt;<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Kəɓa dyawanə ya, &lt;&lt;Ngwi ngɛ ya ka kunə Yohana wanə Botisma, ngwi fi ya ka kunə Iliya, ngwi ngɛ fima ya a ka nso la tangte ngwi dandoswɔn ɓa.&gt;&gt;<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Kəfi u ɓyəng ɓa, &lt;&lt;Ama gua ka wa ngu cwe mənə ma?&gt;&gt;</para>
  <para style="p" vid="MRK 8:29">Kə Bituru dyawanə ya, &lt;&lt;Ka kunə Almasihuː.&gt;&gt; <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Kə Yesɔ dajachwẽ ɓa ɓu cwa ngwi ngɛ abaru gənə la.<verse eid="MRK 8:30" /></para>
  <para style="s">Yesɔ cwayo la lashi nang wuu gɔ</para>
  <para style="r">)Matu 16.21-28; <ref loc="LUK 9:22-27">Luka 9.22-27</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />La sade sɔ, Yesɔ fudi na ma nwi nangjwa gɔɓa nəya nwi nəngwi la fa laɓyɔ.yɔ jang laɓe nwinye ɓa, nwanye nyanang ɓa, ɓa ngwi maɓesa dang nangzhĩ Musa ɓa. ɛ nyanwa jəwa, la zinze gwe nca u lwe ɓa wiinə. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Gɔ cwa yoni la ntẽ sa nwi nangjwa gɔɓa, kə Bituru dawa bwanə dagan ku fudi na lawa do.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Ama Yesɔ ɓeyi wa ku sang nwifi nwi nangjwa gɔɓa, ku cwa Bituru nə ya,&lt;&lt;A vya məngang gə, a ka shetanǃ&gt;&gt; Nga cheng gu nang nayi nəngwi nə, ama nayi Nyimoː nə laǃ&gt;&gt;<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Nankənə kə Yesɔ kwi cwi nəngwiɓa ɓa nwi nang nangjwa gɔɓa, ku ye ɓa ya,&lt;&lt;Ngwi nang nga shana kafimə ni, se vya nang awaku ngɔn ni, kə ɓu cwe shi agangan yi gɔ kəfi u kafimə. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Nə ngwi nang nga shanə yonki gɔ ni, ku mela. Ama ngwi nyi yonki gɔ yo gəni, ɓa yo anua nua, ume wiiwa mə. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Kanə zan nɛ nəngwi mə lasapyang fi mə yonki gɔ lani ma? Dənlaǃ <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Nang ngɛ nɛnɛ la naa yona mə yonki gu ni. <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Paca ngwi nang nga wanə sako yo gə ɓa sako nã maɓesa nangə ɓa la lasapyang ni zanə lani, nankənə nwi nəngwi ma ɛ nə sako gɔ sade nang finə mɓanə ɓa yi nə gang yi Daa gə ɓa maleka ade ɓa.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Kəfi cwa ɓanə ya, &lt;&lt;Gəmə cwowa nə ngwi ngɛ ɓa ngənə lanle kɛ wula, sɛ ɓa sang donyang Nyimoː ɓɛ bwa ɓa njamu nə.&gt;&gt;<verse eid="MRK 9:1" /></para>
  <para style="s1">Nang pyɛ swe Yesɔː</para>
  <para style="r">)Matu 17.1-13; <ref loc="LUK 9:28-36">Luka 9.28-36</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Lazinze gwe ntonji Yesɔ cwe Bituru, Yakubu, ɓa Yohana, gha ɓanə lashi nta, a dwandwa yido ɓa ngənə ɓanə saɓa ni. Na nang gaɓa nga sang ni, nang pyɛ ɓala sa Yesɔ, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />nangja gɔ ngəla pyən na vi, nanang ngwi ngɛ bala na wanə la sapyang ni. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Kə nwi nangjwa gɔɓa sang Iliya ɓa Musa nga cwayo ɓa Yesɔ<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Bituru cwa Yesɔ nə ya, &lt;&lt;Ngwi maɓesa nang, zan ngɔn je ngə lang leni, jeli ma mbabĩ nca, nso nə yigu nso yi Musa nso yi Iliya.&gt;&gt; <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Gɔ ɓa nwifi ɓa yi gwa ɓa hakə ɓa nyi nang la cwan nila.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Kə zinblo mə ngə, ɓa dang ɓa kəɓa wa ghɔ la zinblo nga ya, &lt;&lt;Nwini ka Nwimə ashanshan mə, u wasa waǃ&gt;&gt;<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Kə la twa gaɓa sang ngwi ngɛ nla ɓawa; se ka Yesɔ ɓansɔ ɓaɓa.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Kəɓa sənə lasa nta ni,Yesɔ cwaɓanə, ɓa cwa ngwi ngɛ nə nang ɓa sang ni la se Nwi nəngwi lwe la shije nbe.&gt;&gt; <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Gaɓa wayo gɔ, ama kə nga fudi na cwanə saɓa, &lt;&lt;Kanə nə nang lwe sa wi ajədo ni ma?&gt;&gt;<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Kəɓa byə Yesɔ ya, &lt;&lt;Kayonə ngwi maɓesa dang nang zhi Musa ɓa nga ya se ngwi dangdoswɔn Iliya kɔ gəmbe mɓa bə Almasihuː mɓa ma?&gt;&gt;<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yesɔ dya ɓanə ya, &lt;&lt;Yo ade ngwi dangdoswɔn Iliya gɔ fudi na ma nəku nyang gəmbe. Ama kanə kwã yi Nyimoː cwa ya Nwi nəngwi laɓa kəfi se tori kə ɓa nyiwa? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ama ngə cwo wanə, konteku, ya Iliya gəmbe mɓa ngɔn nəngwi ɓa nəwa nang ngu shãnə nanang cwanə ɛ nənang ni sa nang shan gaɓa, na nang kwã yi Nyimoː cwanə yo gɔ ni.&gt;&gt;<verse eid="MRK 9:13" /></para>
  <para style="s1">Yesɔ Nyɔndi nwi ɓane gwenə ni</para>
  <para style="r">)Matu 17.14-21; Luka 9.37-43a&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Kə ɓa mɓanə sa nwifi nwi nangjwa gɔɓa ni, kəɓa sang nyə cwi nəngwi ɓa kwon wa tanə nang ni kəfi ngwi maɓesa dang nangzhĩ yi Musa nga nyasang ɓaɓa.<verse eid="MRK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 9:15" />Sade nang nəngwi ɓa sang nə Yesɔ ni, gaɓa yi gwa ɓa ngɔn kəfi ɓa yawa do.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />&lt;&lt;Ka yonə ngu gwanə swe ma?&gt;&gt; Kə Yesɔ bye ɓa.<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Kə ngwi mə ngɛ la cwi ɓwa nəshi ni dya wanə ya, &lt;&lt;Ngwi maɓesa nang, ka nwi mə ɓanə laso, yonəmani gɔ ɓa gwe anjɔ nə, kəfi kɔ ba cwayo la. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Sade nang gwe sɔ lwewa nə ngɔn ni nga cawa kəmi, nga nyang wa bwanə npe la sidang wa ngu tang nyi wa kəfi sawa nga tã ɓa njamu nə laje gɔ ku. Gəmə ju nwi nangjwa gua biwa cagha ama ɓa banla.&gt;&gt;<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yesɔ dya ɓanə ya,&lt;&lt;Gua ka yiri nəngwi anwa ɓa ma dyanə yoade laniǃ Gəmə ngə də ɓowa lonwa ma? Gəmə ja bəɓa nə dənə ɓowa ma? U mɓanə nwisɔ samə. &gt;&gt; <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Kə ɓanə nwi sɔ labe Yesɔ.</para>
  <para style="p" vid="MRK 9:20">kə gwe anjɔ sang nə Yesɔ ni, ɓabe kə ca nwi sɔ la kəmi kə nyanwa u ɓe u chang kəfi npe nga bwa la ladɔ.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Yesɔ ɓyəng daagɔ ya, &lt;&lt; lonwa kə nangjwə sɔ mewa ma?&gt;&gt;</para>
  <para style="p" vid="MRK 9:21">&lt;&lt; Sayi nang gɔ kanə nwinjwɔn ni,&gt;&gt; gɔ cwa. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />&lt;&lt; Fin ɓa ɓyagɔnə nga chawa la va ɓa la dibi. A sang laɓyɔ je, ngə la dyidya niǃ&gt;&gt;<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yesɔ cwonə ya nə dya, &lt;&lt;Inə gu ɓa lashiu nə dyan niǃ ko nəku la dədə sa ngwi nang ɓanə yoade nəni.&gt;&gt;<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Kə daagɔ lwenə laghɔ lankwã,&lt;&lt; Gəmə mɓa yoade nə ama gang la. Ajimə mə ɓa angɛ&gt;&gt;<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Kə Yesɔ sang nə nəngwi ɓa nga ɓanə bəɓa ni, kə cwanə yo sa gwe anjɔ sɔ ya, &lt;&lt;Gu gwe ɓwon cwe kəfi gu dang,&gt;&gt; ngə no dang a bwa la nwisɔ ɓa dya la wala fĩǃ.&gt;&gt;<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Gwe anjɔ jaku nə, kəfi jwa nwi sɔ wane ngɔn kə bwa, nwi sɔ nga na kwon nə hakə bya nəngwi ɓa nga &lt;&lt;cwa ya gɔ wu ngɔn&gt;&gt;<verse eid="MRK 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 9:27" />Ama Yesɔ gwa gaɓe nwi sɔ lwe nə, kə nwi sɔ lwe nə.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Lazĩze Yesɔ ɓa nsɔ la layi ni, kə nwi nangjwa gɔɓa byəwa jwɔn jwa, kəɓa ya,&lt;&lt;Ka yonə sɔ je banla na bwanə gwe anjɔ sɔ ma?&gt;&gt;<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Yesɔ dya ɓanə ya, &lt;&lt;ɛ yiri gwe anjɔ na nangni kɛ bwa la, se pɛdang ɓa zhilo kə ɓe; lani nang ngɛ nɛnɛ nla .&gt;&gt;<verse eid="MRK 9:29" /></para>
  <para style="s1">Yesɔ cwayo nang wu gɔ</para>
  <para style="r">)Matu 17.22,23; Luka 9.43b-45&lt;&lt;</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yesɔ ɓa ngwi nangjwa gɔɓa vya dosɔ kəɓa kwe la ɓe Galili. Yesɔ shãn la yido nang ngwi ngɛ nyinə yido gɔ ngənə yimɓa ni, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />Yonəmani ngu ma nwi nangjwa gɔɓa ɓe sanangː&lt;&lt;ɛ na nwi nəngwi laɓe nəngwi ɓa ɛ jəwa nəni. Lazĩze gwe nca ngu lwe nə, konteku, gɔ lu ɓa yonki nə.&gt;&gt; <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Ama ɓa nyi nang ngu manəɓenə ni nla, kəfi nga yiyi na ɓyəng wa yo.<verse eid="MRK 9:32" /></para>
  <para style="s1">Ka nwa nə ngwi agang?</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Keɓa dya do kafarnahu ni kə Yesɔ dya layi kə ɓyəng nwi nangjwa gɔɓa ya,&lt;&lt;Lashi nə ngu gwanə swe la məgang ma?&gt;&gt; <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Ama ɓa dya wanə la, yonəmani nga gwanə swe yo ka nwa nə ngwi agang la məngang la tangte saɓa.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />Kə Yesɔ dəmi kə kwida nwi nangjwa jwua cwi mɓa ya, &lt;&lt;Paca ngwi nang nga shãnə ngənə ngwi gəmbe, sɛ ngənə ngwi kasɛ kəfi ngə nə nwinfɔ yi nwaku fi.&gt;&gt;<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Yesɔ cwe nwijwɔn apika nyang wa ngə la shaka gaɓa kə nyang ɓewa kpã wa ngu cwa ɓanə ya, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />Paca ngwi nang cwenə nwijwɔn apika ni na nangni ɓa yaamə nə ngɔn ni, gɔ ka kəmə kə u cwe, ngwi nang cwe mənə ngɔn ni, ka kəmə la, ka ngwi nang swon məni ka kɔ a cwe.&gt;&gt;<verse eid="MRK 9:37" /></para>
  <para style="s1">Ngwi nang ku shinədo ɓe lani, u kayi je</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohana cwa Yesɔ nə ya, &lt;&lt;Ngwi maɓesa nang ngə sang ngwi ngɛ nga bwanə gwe anjɔ ɓa yo nə, kə bi wa yonəmani gɔ nɛnɛ tangte.<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Yesɔ cwa banə ya, &lt;&lt;Bu bi wala,&gt;&gt; Yesɔ cwaɓanə, &lt;&lt; Yonəmani ɛ ngwi ngɛ la nənə nang yiswe ɓa yame ni, kəfi la cwayo anjɔ lashi mə ɓɛɓɛ ni. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Ngwi nang ku la shĩ nə lani kayi je. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Ngə cwowa yoade nə, ngwi nang noa nə dibi afa, ko kwakwĩ nso yonəmani gua kayi Almasihuː ni yo ade cwon wanə lu mɛ dang jada gɔ mə.<verse eid="MRK 9:41" /></para>
  <para style="s">Nang ɓa nga fundan nəngwi la nə nang anjɔ ni</para>
  <para style="r">)Matu 18.6-9; <ref loc="LUK 17:1">Luka 17.1</ref>,<ref loc="LUK 17:2">2</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />Ngə cwowa yonə ngwi nang ku nyang nwi jwɔn nso nang dyanə lasa mə, yo na nyang wa lu ne nang anjɔ ngɔn ni, zã gɔ dwə nta gwane la gua, cha gha la ladi agang. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Nɛ gaɓo nyo nga nəna anjɔ ni, a kənwa caghaǃ Zəzan na dya la yido la kaanlani ɓa gaɓe nso nda la ghanə lava ɓa gaɓo nə mba ni, la va nang la kaanla ni. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />La yimɓa nwi shishi la tang ɓa nəni la wuunla, va gaɓa namɓə kɛ wuunla. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Nɛ gagwo nyo nga nənang anjɔ ni kə̃wa caghaǃ Zəzã na dya ɓa yonki nə yi ɓente ɓa gagwe nə nso, nda la dya la va ɓa gagwe mba ni. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Layimɓa nwi shishi ɓa nga tang ɓa nəni la wunla, vasɔ ma ka ba jəwa nla. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Nɛ zayu nyo nga nənang anjɔ ni, pyãwa caghaǃ zã ngɔn dya donyang Nyimoː ɓa zayi nso, nda la dya nə la va ɓa zayi mba ni. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Layimɓa nwishishi nga tang ɓani la wula, va nang nga zwe ɓani kɛ ba jə ɓa la.<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />ɛ, ma nwaku ɓa va, nanang ma nang nyanang ɓa mye ni.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />&lt;&lt; Mye ka nang azãzã ama inə myɛ ganə ɓa nua gɔ ngɔn ni ɓanə la manə ma? U ɓa mye nə la ɓowa u, də dodə jwa jwa nə soa.&gt;&gt;<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">Yesɔ maɓe sa nang lashi nang gaa yifye</para>
  <para style="r">)Matu 19.1-12; <ref loc="LUK 16:18">Luka 16.18</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesɔ vya dosɔ kə gha ɓyən Yahudiya la ɓyango dangdi Urdu. Kə cwi nəngwi ɓa ɓwa nəshi labe wa kə maɓesa nang.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Kə Farisawa mɓa nga mawa ɓa yo aɓyə nə; &lt;&lt; A cwɛnə zəzã na nəngwi ta gwa wa ɓe ma?&gt;&gt;<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yesɔ dya ɓanə ɓa doɓyə nə yaː &lt;&lt; kanə Musa cwa lashi nang ta nəngwa ɓe ma?&gt;&gt;<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Kə dyawa nə ya,&lt;&lt;Musa nadang nəngwi jwa kwã jə yifye, bi gwa wa kwe.&gt;&gt;<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Ama Yesɔ cwa ɓanə ya,&lt;&lt;Ka yo sɛgwowa kə Musa jwa kwã sɔ. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Ama Nyimoː ma nyinəwon ɓa nyənəgwa ɓenbe ku manjwɔn ɓa.&gt; <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />&lt;ka yonəmani, nəngwi la vya daagɔ ɓa naa gɔ ɓwanə donso ɓa gwa wa.&gt; <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Gaɓa ku mba nang nso. ka nang mba la ama nso. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Nankənə nang Nyimoː ɓwanə ni ngwi ngɛ ɓe gala.&gt;&gt;<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Sadenang ɓa fi ghanə layi ni, kə nwi nangjwa ɓa ɓyəng Yesɔ la shi yo sɔ. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Ngu cwa, &lt;&lt; Gɔ ngwi nang ku tanə gwa wa ɓe ngɔn ni nə ndã lasawa. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Nɛ ngwa sɔ vya wonwa fyenə ngwi ngɛ ngɔn ni nə ndã.&gt;&gt;<verse eid="MRK 10:12" /></para>
  <para style="s1">Yesɔ na nwi jwɔ balka</para>
  <para style="r">)Matu 19.13-15; <ref loc="LUK 18:15-17">Luka 18.15-17</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />gwe nso ngwi ngɛ ɓanə nwijwɔn ɓa labe yesɔ yona nyang ɓa balka nə, ama nwi nangjwa gɔɓa biɓa. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />kə yesɔ sang na nang ni kə jwə sɛgwɔn ɓa nwi nangjwa gɔɓa, kə cwa ɓanə,&lt;&lt;vya nwijwɔn a pika ɓa labe mə, ɓo biɓa la, yonəmani donyang Nyimoː ka yi yiri gaɓa. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Ngə cwo yo ade nə ngwi nang ku cwe nə donyang Nyimoː na nwijwɔn a pika lani kɛ dya la.&gt;&gt; <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Kə u cwe nwijwɔn a pika kə kpã ɓa kə nyang gaɓe lashi ɓa, kə nyang ɓa balkanə.<verse eid="MRK 10:16" /></para>
  <para style="s1">Ngwi Mɛnang</para>
  <para style="r">)Matu 19.16-30; Luku 18.18-30&lt;&lt;</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Kə Yesɔ fudi ɓa zhonə na ghanə Urshelima, kə ngwi mə ngɛ mɓa ɓa gwenvɔ nə, twə tavũ wa la kəmi, kə ɓyəng wa ya,&lt;&lt;Ngwi maɓesa nang ade, kanə nənə nə mɛnə yonki ma?&gt;&gt; <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />&lt;&lt; Ka yonə sɔ la kwi mənə ngwi ade ma?&gt;&gt; Yesɔ ɓyədo. &lt;&lt;ka Nyimoː nso nə ngwi ade. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />A nyi dang nangzhĩ Musa ngɔnː Ba jə nəngwi la. ɓa nə ndã la, ɓa yinang la, ɓanə shedaku yi dansa la,ɓa ɓadang nwinyu la; a naa daagu ɓa naa gu gang.&gt;&gt;&gt; <verse eid="MRK 10:19" /><verse number="20" style="v" sid="MRK 10:20" />&lt;&lt;Ngwi maɓesa nang,&gt;&gt;nang ɓani ku nə ɓa sade ngənə nwi anəgwo ni.&gt;&gt; <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />Yesɔ sang wa ɓa do sang nang shãn nə,&lt;&lt;Cwawanə ya nang nso a nə la,&gt;&gt;Kə Yesɔ cwawanə ya. &lt;&lt;A gha yaaɓa nang mɛ gu ɓanə kənəni ngɔn anaa ngwi laɓyɔ ɓa shede sɔ, a mɛ nang me agang la lankwã nang ni aɓa kase mə.&gt;&gt; <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Kə nwi anəgwo sɔ wanə yosɔni kə sibewa dwə kə jwə sɛgwɔn, yonəmani gɔ ɓa nang me nə wane. <verse eid="MRK 10:22" /><verse number="23" style="v" sid="MRK 10:23" />Yesɔ sang nwi nangjwa gɔɓa kə ya, &lt;&lt;La a jwənjwə ngwi nang me dya la donyang Nyimoː&gt;&gt; <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />Kə nwi nangjwa gɔɓa wanə yoni na nangni kə sayii gwa ɓa. ama Yesɔ mafi cwa,&lt;&lt; nwimə ɓa, la jwə bəɓa na dya donyang Nyimoː <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />La a jwənjwə sa ngwi nang mɛ la dya donyang Nyimoː nte zan na joroba dya jwɛ bata.&gt;&gt; <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />Ngwi kafĩwa ɓa saɓa mafi tə̃ nga ɓyəng nə saɓa, &lt;&lt;To ka wa la cwido ma?&gt;&gt; <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />Yesɔ sang ɓa ya,&gt;&gt;lasa nəngwi la a jwənjwə, ama labe Nyimoː jwə la na nə.&gt;&gt; <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />Bituru cwawanə ya, je vya nang anwaku kafiu ngɔn&gt;&gt; <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />&lt;&lt;Yoade.&gt;&gt;Yesɔ cwaɓa nə&gt;&gt;Ngwi nang ku vya nə layi gɔ, nwinyə wa, naa gɔ, ko daa gɔ ɓa nwi ɓa lasa yo gə ɓa kwã agang, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />lu mɛnang la sapyang ni ɓa ɓyagɔnə, la kwe sa kaanto, yi layi ɓa, ɓa nwinyə, ɓa daa, ɓa nwi, ɓa lasẽ, ama nyang ɓa va ganə namɓə; nang ni lasapyang nga mɓani gɔ mə yonki yi ɓente. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Ama nəngwi ɓa ɓyagaɓanə la gəmbe ni ɛ ngənə ngwi kasɛ, ngwi kasɛ, ɛ ngənə ngwi gəmbe.&gt;&gt;<verse eid="MRK 10:31" /></para>
  <para style="s">Yesɔ ma cwa yo fi nca lashi nang wuu gɔ</para>
  <para style="r">)Matu 20.17-19; <ref loc="LUK 18:31-34">Luka 18.31-34</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Ngə la məgang nga gha la Urshelima, kə Yesɔ ngə be ɓa nwi nangjwa gɔɓa saɓa nga tə̃, ngwi nang ɓa kafĩ ɓani fi nga yiyi. Kə Yesɔ gwa nwi nangjwa gɔɓa jwacwi mba ni la dagɔ, ngu cwaɓa nang ɛ mewa nəni. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />&lt;&lt;Wani&gt;&gt;Yesɔ ya, &lt;&lt;Ngə gha Urshelima,&gt;&gt;ɛ naa nwi nəngwi la laɓe ngwi nyang nang ɓa ɓa ngwi maɓesa nangzhĩ Musa ɓa. Gaɓa ɛ nəwa tita nang wunə, ɛ nawa laɓe ngwi namɓa kanə Yahudawa ɓa lani. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />ɛ nyo wa ɛ shɛwa ɓa tĩtẽ, ɛ gbɔ ɓa ntɛ ɓa jəwa. lazə̃ze gwe nca U, lwe ɓa yonki nə.&gt;&gt;<verse eid="MRK 10:34" /></para>
  <para style="s1">Nang ju yakubu ɓa yohana</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Kə yakubu ɓa yohana, nwi zabadi ɓa, mɓa sa Yesɔ. &lt;&lt;ngwi maɓesa nang,&gt;&gt; ka ya, &lt;&gt; nang ngənə je shã a nɛnə.&gt;&gt; <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />kə ɓyəɓa ya, kanə gua ngu shã na nua nə ma?&gt;&gt; <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Kəɓa dyanə,&lt;&lt;ngə ju lalo a dyanə donyang guni nso je də gaɓe ɓezhi gu, nso fi də gaɓe ɓeshang gu.&gt;&gt; <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />Yesɔ cwaɓanə ya ,&lt;&lt; gua nyi nang ngu juni la . gua bana fa lasa a nwi kwakwĩ yi fa laɓyɔ gəma? <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Kəɓa dyanə ya,&lt;&lt;je li bəɓa&gt;&gt; yesɔ cwa ɓanə ya ,&lt;&lt;Gua lu ba lufa lasa nwi kwakwĩ nang gəmə ngə fani, ɛ nəwa Botisma nə fi ɓa botisma nəmə nəni.<verse eid="MRK 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 10:40" />Ama nɛnɛ ɓa njamu nang nə cwanə kanwa la də ɓezhi gə ko ɓeshang. Ka Nyimoː ma doɓa sɔ ka yo ngwi ɓa nang gɔ tẽnə ni.&gt;&gt; <verse eid="MRK 10:40" /><verse number="41" style="v" sid="MRK 10:41" />Kə nwi nangjwa gɔɓa jwa ɓa wanang Yakubu ɓa Yohana ɓa ɓyədo ni, kəɓa lalo. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Yesɔ kwida ɓa kə yee,&lt;&lt; Gua nyi ngɔn ngwi nəgang la sapyang ɓani Nyimoː kwe sa ngwi gaɓa, nwaye gaɓa taɓa njamu. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ama la tangte kɛ ngə nankənə la. na nankənə ni paca ngwi nang shãna ngənə ngwi agang ni ko ɓe ngwi jagi latangte wa, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />latangte wa ngwi nang ku shãna ɓenə ngwi gəmbe ni ɓe nwinfɔ. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Yonəmani nwi nəngwi mɓa yona nangnu nwinfɔ , ama yona nə nang nu nwinfɔ, na yonki gɔ yona pong nəngwi ɓa ɓya gɔ nə.&gt;&gt;<verse eid="MRK 10:45" /></para>
  <para style="s1">Yesɔ nyɔndi ngwi bwonyi</para>
  <para style="r">)Matu 20.29-34; <ref loc="LUK 18:35-43">Luka 18.35-43</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Kəɓa dyado la jeriko ni. Yesɔ ɓa kafĩ ɓa, nəngwi ɓa ɓyagaɓanə, ɓa ngə la yi agang ni, kə ngwi ɓwonyi məngɛ yawa Batimawu nwi Timawu ngu də la byəng məgang. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />kə wanə Yesɔ banazara, kə fudi nang, &lt;&lt;Yesɔ nwi Dauda a sang laɓyɔ gəǃ&gt;&gt; <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />Nəngwi ɓa ɓyagɔnə biwa,ya gadonə,ama mafi bwonku ɓa nyenə, &lt;&lt;Nwi Dauda asang laɓyɔ gəǃ&gt;&gt; <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />Yesɔ ngə kəmi kə ya, &lt;&lt;kwida.&gt;&gt; ngwi bwonyi sɔ, &lt;&lt; A wanuaǃ a lwe ngu kwido.&gt;&gt; <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Kə cha nangja gha, kə we ɓa gagwe kə mɓa be Yesɔ. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />&lt;&lt;Kanə nga shã na nunə ma?&gt;&gt; Yesɔ byəwa. ngwi bwonyi cwa, &lt;&lt;shãyi, shãna sang do.&gt;&gt; <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />&lt;&lt;A gha,&gt;&gt; Kə yesɔ cwa wanə, &lt;&lt;yo ade gu nyang di gua ngɔn&gt;&gt; Layi mɓa kə menə nang sang doni kə kafĩ Yesɔ kwe.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Nang dya Yesɔ la Urshelima na kwə nə</para>
  <para style="r">)Matu 21.1-11; <ref loc="LUK 19:28-40">Luka 19.28-40</ref>; Yohana12.12-19&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Kə ɓa ghanə kanə yinse ɓa Urshelima ni kə mɓa yii Betafaji kəfi Betani la nta zetu, kə Yesɔ swon nwi nangjwa gɔɓa. <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />Kə cwaɓanə ya,&lt;&lt;U gha la yii pika la sibo wani, ɓa dya gua nə ngu sang nwi wandye dwə, angye nang ngwi ngɛ medi na jɛwa la ni. ngu vĩwa ngu ɓanə. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Nɛ ngwi ngɛ ɓyəng wa ngɔn ni, &lt;ka yonə ngu vĩwa ma?&gt; Kə cwa wanə, Daa shayonki nga shã wa, ngɔn ni la nyangwa lu ɓa nə ɓɛɓɛ.&gt;&gt;<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />kəɓa kwenə, kəfi sang nwi wandye dwə la dang bwazhi layi sɔ la dang məgang. kə nga vĩwa, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />kə ngwi nang ɓa ngənə ɓe yido layi sɔni mɓa ni kəɓa ya, &lt;&lt;Bəɓa ma ka yonə ngu vĩ nwi wandye ni ma?&gt;&gt; <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Kəɓa dya wanə nəɓwɔ nanang Yesɔ cwa ɓa nəni kə nəngwi ɓa vya ɓa kəɓa kwenə ɓa wandye sɔ. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />kəɓa ɓanə wandye sɔ labe Yesɔ kəɓa pya nangja gaɓa ta shi lashi wa, kə Yesɔ je də layimɓa. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />kə nəngwi ɓa ɓa ɓyagaɓanə pyan nangja gaɓa la lashi məngang, kə ngwi ngɛ ɓa kən ja nkwɔjɛ ye la məngang. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Ngwi nang ɓa ngənə sibe ni ɓa ngwi nang ɓa ngənə lazə̃ze ni nga ɓwonku nga ya.</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Nang ɓwɔn Nyimoː&gt;&gt;</para>
  <para style="q2" vid="MRK 11:9">&lt;&lt;Nyimoː nyang balka sa ngwi nga mɓa lasa yaa Daa shayonki niǃ&gt;&gt;<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />&lt;&lt;Nyimoː nyang balka sa donyang nga mɓani yi daaje Kwə Daudaǃ&gt;&gt;</para>
  <para style="q2" vid="MRK 11:10">&lt;&lt; Nang ɓwɔn sa Nyimoː&gt;&gt;<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Kə Yesɔ dyanə Urshelima ni, kə gha lanywi Nyimoː agang kə sang nang anwaku layimɓa. kə lo gunə ni, ku ɓwa kwe Betani ɓa nwi nangjwa gɔɓa.<verse eid="MRK 11:11" /></para>
  <para style="s">Yesɔ Siri Shin nzu</para>
  <para style="r">)Matu 21.18,19&lt;&lt;</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Ngami dokwã lwenə la Betani ni, kə Yesɔ nga wa nywe. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Kə gɔ sang nə shi nzu ni ɓanə jashi nə, kə gha ngu sang ko lu mɛ fagɔ mɛ, ama ughanə yimɓa ni u sang nang ngɛ la sɛ jawa. yonamani ka sade fagɔ la. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Kə cwa shi nzu sɔnə, &lt;&lt; Ngwi ngɛ ɓe tang fagɔ la ɓenteǃ&gt;&gt; nwi nangjwa gɔɓa wa nang cwani ngɔn.<verse eid="MRK 11:14" /></para>
  <para style="s">Yesɔ gha Lanywi Pɛdang Agang</para>
  <para style="r">)Matu 21.12-17; <ref loc="LUK 19:45-48">Luka 19.45-48</ref>; <ref loc="JHN 2:13-22">Yohana 2.13-22</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Ba nang dya gaɓa nə la Urshelima, kə Yesɔ dya lanywi Nyimoː agang kə fudi na bi ngwi yanang ɓa nga yani. Gɔ fyə tebur ngwi pyɛ shede yemi ɓa shi a dəndə yi ngwi ɓa nga yenə zho yiɓa ni. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Fi bi wanku na cwe nang ngɛ ɓana kwe la baba lanywi Nyimoː agang. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Gɔ ma nəngwi ɓa ɓesa nang, &lt;&lt;ɓa jwə jwa la lakwã Nyimoː ya, layi pɛdang la kwinə yido pɛdang nəngwi paca lasapyang&gt;&gt; Ama gua gwa wa kə ɓenə yido ngwi bado ɓa.<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Nwianye ngwi nyanang ɓa ɓa ngwi maɓesa dang nangzhĩ Musa ɓa, wanə ni, kəɓa fudi na kã məngang nang la jənə Yesɔ ni. Gaɓa nga yiiwa yii, yonəmani cwi nəngwi ɓa ku nga kən gwɔn sa nang maɓenə gɔɓa.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Kəɓa logwa nə, Yesɔ ɓa nwi nangjwa gɔɓa kəɓa bwa la yii agang sɔ.<verse eid="MRK 11:19" /></para>
  <para style="s">Nang nyi lasa shĩ nzu</para>
  <para style="r">)Matu 21.20-22&lt;&lt;</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Kəɓa vulanə, kə ɓa nga kwe ni, kəɓa sang shi nzu sɔ swon nang gwanə zĩ wani. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Bituru chəngyo, kə cwayo ɓa Yesɔ, &lt;&lt;ngwi maɓesa nang; nzu nang tsiri gɔni swon ngɔn&gt;&gt;<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yesɔ dya wanə, &lt;&lt; A dyanə ɓa yo ade sa Nyimoː,&gt;&gt; <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />&lt;&lt; Gəmə yo ade ngə cwo wanə, nɛ dyanə ɓa yo ade sa Nyimoː ngɔn ni a bana cwa nta nə,&lt;Lwe gha gu yidi agang,&gt; na chəngyo sɛgwo lani lashi nang cwanə, ama a dyanə ɓa nang a cwa ni la nunənə. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Yonəmani ngə cwo wanəː Sade nang ku a pɛdang ngɔn kə a ju nang ngɛ ngɔn ni, dyanə yoade ame ngɔn , la no na nangku a juni , fi ka yigu. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />kəfi sade anwaku ngənə nga pɛdang ni, ngu yafa nəku ngwi ngɛ nunə ni, yonəmani Daa gua la lankwã ni la yafa ayibe gua nəni.&gt;&gt; <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Ama inə gua lu yanəfi nlani, daa guwa ma la lankwã kɛ yafi gua nang ɓa nənə zan lani.&gt;&gt;<verse eid="MRK 11:26" /></para>
  <para style="s">Dobyə lashi Njamu Yesɔ</para>
  <para style="r">)Matu 21.23-27; <ref loc="LUK 20:1-8">Luka 20.1-8</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Kəɓa fi dya Urshelima, Yesɔ nga kwong lanywi pɛdang agang, kə nwianye nyanang, ɓa ngwi maɓesa dangnang zhĩ Musa ɓa nwianye nəngwi ɓa ɓa ɓe Yesɔ. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Kə cwa wanə ya,&lt;&lt;Ka njamu anwa gu aɓakənə nga nə nang a nənə ni ma? Ka nwa no njamu nənang ni ma?&gt;&gt; <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />Yesɔ dya ɓanə ya, &lt;&lt;Ngə ɓyəng wayoni ngənə u cwamənə ngɔn ni, gəmə ngə cwowanə ko ɓa njamu anwa ngə nənə nang ɓani. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Gua cwa mənə ɓa njamu anwa yohana nənə botisma, ka Nyimoː nawa ko ka nəngwi ma?&gt;&gt;<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Kəɓa fudi na gwanə swe tangte ɓa,&lt;&lt;Kanə la cwa? Inə je dyawanə ngɔn ni, &lt;bwalasa Nyimoː ngɔn ni,&gt; gɔ cwɛnə,&gt;Ka yonə sɔ je dyanə ɓayo ade lasa Yohana lama?&gt; <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ama inə gua cwa ya, &lt;lasa nəngwi ɓa ngɔn ni?&gt;&gt;&gt; )Nga yiyi nang nəngwi ɓa la nəɓa nəni, yonəmani nəngwi ku dyanə ngɔn ya yohana ka ngwi dangdoswɔn&lt;&lt;<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />Kəɓa dya Yesɔ nə kəɓa ya,&lt;&lt;Je nyi la&gt;&gt;</para>
  <para style="p" vid="MRK 11:33">Yesɔ dya ɓane, &lt;&lt;gəmə ma kɛ cwowa nə la ko njamu anwa ngə nə nang ɓani.&gt;&gt;<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Nashoo lashi ngwi ngɔn ni lasɛ fashi ni</para>
  <para style="r">)Matu 21.33-46; <ref loc="LUK 20:9-19">Luka 20.9-19</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Yesɔ cwaɓa yonə ɓa nashoo ː &lt;&lt;Sayi ngənə ngwi mə ngɛ ngan lasɛ fashi, ku kwong wa ɓe tala, ka jwe yona pĩ fashi, kəfi ma yido sang zhĩ. Kə naa ngwi ngan gaɓa kə kwe nə kəmi ngɛ. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />kə sade shã fashi inabi nəni, kə swon nwinfɔ gɔ labe ngwi nang ɓa cwe nə lasẽ sɔnə, a cwe jada gɔ yi fashi inabi sa nang ɓa shã ni. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Ama gaɓa gwa nwinfɔ sɔ,, kəɓa gbɔ, keɓa taɓe gaɓe yinse. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />kəfi shã lasẽ ma swondo ɓa nwinfɔ ngɛ; kəɓa gba wa la lashi wa kəɓa kwawanə swe. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />kəfi shã lasẽ ma swon nwinfɔ ngɛ, kəɓa jəwa; Kəfi gaɓa gba ngɛɓa kəɓa jə ngɛɓa.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />&lt;&lt; Ngwi nang nso ngənə lu swon ni ka nwiwa angye nang ngu shã wanəni. Yeshiwa kuni, kə gɔ swon nwiwa lasa ngwi ɓa cwe lasẽ nga ngan ni, u ya, &lt; Gəmə nyi ngɔn gaɓa la naa nwi mə gang,&gt;gɔ cwa.<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />&lt;&lt;Ama ngwi nganpang ɓasɔ cwanə yo nə saɓa,&lt; Ka nwi nang ɛ tang nə nang wi yi lasẽ sɔni ye. U mbaɓi jəwa, kə nang wi gɔ ɓənə yije.&gt; <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Kəɓa jəwa, kəɓa cwe kwong gɔ cagha la zə̃ze lasẽ sɔ.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Yesɔ ɓyəng ɓa ya, &lt;&lt;Cwa, nankənə, kanə shã lasẽ sɔ lanə ma?&gt;&gt; U mɓa kanə yonki gaɓa ngwi nənang nu ɓani, u naa lasẽ sɔ be ngwi ngɛ ɓa. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Yoade gua cwa yoni ngɔn la lakwã agang yi Nyimoː lama? Yonəmani ɓa jwa ya,</para>
  <para style="q1" vid="MRK 12:10">&lt; Nta nang ngwi manang nyi ni,</para>
  <para style="q2" vid="MRK 12:10">ka kəɓə ngənə nta bwatɛ lasa nang ma.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Nangni nə nang laɓe Daa shayonki;</para>
  <para style="q2" vid="MRK 12:11">Ka yiri nang yiswe anwa</para>
  <para style="q2" vid="MRK 12:11">la zayi ɓa.&gt;&gt;&gt;<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Kə nwianye Yahudawa ɓa kəɓa kã məngang nang la gwa nə Yesɔ ni, yonəmani gaɓa nyi ngɔn gɔ cwa nashoo ni lashiɓa. Ama gaɓa nga yii cwi nəngwi ɓa kəɓa vyawa kə u kwə.<verse eid="MRK 12:12" /></para>
  <para style="s">Doɓyə Lashi Nang Wong Lidi kəmi</para>
  <para style="r">)Matu 22.15-22; <ref loc="LUK 20:20-26">Luka 20.20-26</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Farisawa ngɛ ɓa kəfi ngwi ngənə sa nang ɓwashi yi Hiridu ni ɓa swon ɓa sa Yesɔ yona gwa wa ɓa doɓyə ɓa. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Kəɓa dyanə doni, kəɓa cwawanə ya, &lt;&lt;Ngwi maɓesa nang, je nyi ngɔn gu nga cwayo ade, yari gunla sa nang nəngwi ɓa ngənə ni, ama gu nga cwayo ade sa nang Nyimoː nga shã ni. acwɛ nə, zã la na je sa Nangzhĩ Musa ogɔn shede kəmi sa kɛisa ma? Je ogɔn ma ko ɓe ogɔn la?<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Ama Yesɔ nyinə nang chəng dansa gaɓa ni kəfi gɔ yeɓa ya, &lt;&lt;Ka yonə gua ngu kãmə ɓa yoɓa nə? Gua nəma ce shede nso, kə gəmə sang, &gt;&gt;<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Kəɓa ɓanə nso, kə gɔ ɓyəɓa nə ya, &lt;&lt;Yinjwə nwa yɛma?&gt;&gt;</para>
  <para style="p" vid="MRK 12:16">Kəɓa cwawanə ya, &lt;&lt;kayi Kwə kɛisa.&gt;&gt;<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Kə Yesɔ cwa ɓanə ya, Nankənə, u naa kɛisa nang kanə yi kɛisa ni; gua naa Nyimoː nang kanə yi Nyimoː ni.&gt;&gt; ka nang yiswe gwa ɓa sa Yesɔ.&gt;&gt;<verse eid="MRK 12:17" /></para>
  <para style="s">Dobyə yo Nang lwe sa wii ajədo</para>
  <para style="r">)Matu 22.23-33; <ref loc="LUK 20:27-40">Luka 20.27-40</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />kə ngwi sadukiyawa ngɛ ɓa, angye ɓa cwanə ya nəngwi ɓa kɛ lwenə la sa wi jədo ni, kəɓa mɓa sa Yesɔ kəɓa ya,<verse eid="MRK 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 12:19" />&lt;&lt;Ngwi maɓesa nang,&gt;&gt; &lt;&lt;Musa jwa nang ni lase ya ngə nwinyu fye nəngwa kə gɔ wuu vya gwa wa ama nɛnɛ ɓa nwinə, nwinyə ngwi sɔ la fye gwa wi sɔ jang yona mya nwinyəwa nwinjwɔn ɓanə angye la cwanə ya ka nwiwa ɓani.&gt; <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Sayi ngənə, nwi anəngwon ɓa nə nto mba; nwanyɛ gaɓa wuu kəfi nɛnɛ ɓa nwinə. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Nankənə yi mba fi fye nəngwa, gɔ ma wuu nɛnɛ ɓa nwi nə, yi nca ma wuu nankəɓənə, <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Nankəbənə gaɓa ku wuu gaɓa ku nto mba ni ɓa wuu nɛnɛ ɓa nwinə. Yeshiwa gɔ ngwa sɔ ma wuu. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Ɓeni, sadenang ngwi ɓa wuu ni ɛ lwe nə lalo alwenlwe ni, gɔ ngwa sɔ ka gwa nənyo? Yonəmani gaɓa ku ntomba ɓa fye wa ngɔn.&gt;&gt;<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Kə Yesɔ dya ɓanə ya, &lt;&lt;Gua nɛnɛ ɓa nang nyi nə maǃ Kəfi gua nyi ngɔn kayonə ma?Ka yonang gua nyinə kwã Nyimoː nla ko njamu gɔ. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />sade nang ngwi awuuwuu ɓa la lwe nə ɓa wiini, gaɓa ɛ ngəna maleka ɓanə la lankwã kəfi gaɓa kɛ fye nəngwa ko nənwo nla. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ɓeni yo nang lwe shije ɓa wiinə niː gua meri na cwa la lakwã Musa nang zwə va lavi nla ma? Layimɓa ɓa jwəjwa ya Nyimoː cwa Musa nə, Gəmə ka Nyimoː yi Ibrayi, ba Ishaku, fi bayi Yakubu ma.&gt;&gt; <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Gɔ ka Nyimoː ngwi awuuwuu la, ama ka ngwi wii ɓa, kayi wi ajədo la. Gua nyi nang nlaǃ&gt;&gt;<verse eid="MRK 12:27" /></para>
  <para style="s">Dang nangzhĩ agang</para>
  <para style="r">)Matu 22.34-40; <ref loc="LUK 10:25-28">Luka 10.25-28</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Nso la tangte Ngwi maɓesa dang nangzhĩ Musa ngɛ wanə nang ɓa cwan. Gɔ sang ya Yesɔ naɓa yoɓa zã gɔnə sa Sadukiyawa ɓa, nankə kə ɓa sawa ɓa do ɓyəng nəː &lt;&lt;Ka dang nangzhĩ anwa nə agang ku paca ma?&gt;&gt;<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yesɔ yewa ya, &lt;&lt;Kəɓə yaː &lt;wasa mə, Isrela, Nyimoː Daa shayonki je ka kɔ nso nə Daa shayonki. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />A shã daa shayonki Nyimoː ɓa sɛgwo ku, ba yonki gu, ɓa akilo gu ɓa njamu gu.&gt; <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Yi mba gɔ kəɓə ye; &lt;Shã ngwi dagɔ zhĩ gu na lashiu nə,&gt;Dang nang zhĩ ngɛ kwe nə sa namɓa mba ɓa nanzan nə ni.&gt;&gt;<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />&lt;&lt;Zezan, kə ngwi maɓesa nangzhĩ Musa cwa Yesɔ nə ya, Ngwi maɓesa nangǃ Ka yo ade, na nang a cwa ni, ayenə ya ka Daa shayonki nso kənə Nyimoː kəfi Nyimoː angɛ nɛnɛ sɛ kɔ. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Kəfi gu sɛ la shan Nyimoː ɓa sɛgwo kupaca kəfi ɓa njamu gunə; kəfi la shã ngwi dagɔ zhii gu na lashiu nə. Zəzan na naa gang sa yo ɓa mɓani nda la nanə naang ɓa nang nyanang ɓa la shi yi dodə ni&gt;&gt;<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />kə Yesɔ sang nə dya wanə ɓa nang nyinə ni, kəfi gɔ ma cwawanə ya. &lt;&lt;gu a ngə kayisẽ ɓa donyang Nyimoː.&gt;&gt;</para>
  <para style="p" vid="MRK 12:34">Lazəze nangni fi ngwi ngɛ nɛnɛ ma ɓyəng Yesɔ yoɓa nla.<verse eid="MRK 12:34" /></para>
  <para style="s">Doɓyə lashi Almasihuː</para>
  <para style="r">)Matu 22.41-46; <ref loc="LUK 20:41-44">Luka 20.41-44</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Sade nang Yesɔ nga manəɓe sa nang la lanywi pɛdang agang, kə ɓyədo ya, &lt;&lt;Bəɓa ngwi maɓesa dang nangzhĩ Musa ɓa ya Almasihuː ka nwi Dauda ma? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Dauda ɓa lashi wanə, ɓa njamu Yingu atẽtẽ kə yaː</para>
  <para style="q1" vid="MRK 12:36">&lt; Daa shayonki cwa Daa shayonki gənə ya,</para>
  <para style="q2" vid="MRK 12:36">də lanle la ɓəzhi gə</para>
  <para style="q2" vid="MRK 12:36">hakə nyang ngwi shi gua la gagwo wa mbe.&gt;<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Dauda ɓa lashi kwiwanə&lt;Daa shayonki.&gt;Kə bəɓa Almasihuː la kanə lado yi Dauda ma?&gt;&gt;</para>
  <para style="s" vid="MRK 12:37">Yesɔ lado lashi ngwi maɓesa yi Nangzhĩ Musa ɓa</para>
  <para style="r" vid="MRK 12:37">)Matu 23.1-36; <ref loc="LUK 20:45-47">Luka 20.45-47</ref>&lt;&lt;</para>
  <para style="p" vid="MRK 12:37">Kə cwi nəngwi nga wasa Yesɔ ɓa nuagɔ nə. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />Nanang u maɓanəɓenə ni, gɔ ya, &lt;&lt; U nə akilo yo ngwi maɓesa nang dang nangzhĩ Musa ɓa, ngwi angye ɓa nga shana janə nangja agang nga zhã nəni. nga shana ɓa yaɓa do ɓa gang nə la lomo, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />angye ɓa shana naɓa dodə a zãzã la yido ɓwa nəshi lanywi Nyimoː apika, kəfi doade ɓa zãzã yido yinyɔ zhɔ. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Ka kaɓa nə ngwi tang nang ngwa nang ɓa ogɔn ɓa wuunə ni kəfi nga badang la layi gaɓa, ngɔn ni ɓa pɛdang a dwandwa yona ɓa sang ba. ɛ, gaɓa ɓa tita nə nɛ gang jwə ta yi nwakuǃ &gt;&gt;<verse eid="MRK 12:40" /></para>
  <para style="s">Nang naa yi ngwa nang ogɔn wa wuu nəni</para>
  <para style="r">)<ref loc="LUK 21:1-4">Luka 21.1-4</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesɔ də la lanywi Nyimoː agang la yido nang nga ɓwanə shede la lafu ye shede ni. Gɔ u sang nəngwi ɓa na nang nga yenə shede gaɓa ni. Ngwi mɛnang ɓa nga ye shede ɓa ɓyagɔnə; <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />kə ka ngwa ngɛ nə gwa wi angye nang ɓanə ce shede mba kəɓa ye gɔ ma. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />kə Yesɔ kwi nwi nangjwa gɔɓa, kə cwaɓanə ya, &lt;&lt;Gəmə ngə cwowa yo ade nə, nang ngwa laɓyɔ gwa wi ni yenə la lafu ni kwe sa nwifiɓa ngɔn ku. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Gaɓa ku ɓana nang ɓanə kənə ni, ama gɔɓə lasa laɓyɔ gɔ ngu naa nang ku gɔ ɓanə kənə u tanəgwɔn nə u dəni.&gt;&gt;<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Yesɔ cwayo lashi nang ye lanywi Pɛdang</para>
  <para style="r">)Matu 24.1,2; <ref loc="LUK 21:5">Luka 21.5</ref>,<ref loc="LUK 21:6">6</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Na nang Yesɔ nga bwa nə la lanywi Nyimoː agang ni, kə nso latangte nwi nangjwa gɔɓa cwawa nə ya, &lt;&lt;Ngwi maɓesa nang sang nta agang ɓani ɓa nang ma yi nang yiswe ɓaniǃ&gt;&gt;<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />kə Yesɔ cwanə ya, &lt;&lt;Ngu sang nang ma agang ɓani ku la ma? Kɛ vya nta ngɛ nso lashi nwi nyəwa la; ko anwa gaɓa ku ɛ yɛ yemi.&gt;&gt;<verse eid="MRK 13:2" /></para>
  <para style="s">Saɓabu ɓa nang Tori</para>
  <para style="r">)Matu 24.3-14; <ref loc="LUK 21:7-19">Luka 21.7-19</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Yesɔ də lashi nta shi zetu angye nang jwanə siɓe lanywi agang ni. Kə Bituru ɓa Yohana, ɓa Andrawu kəɓa ɓyəwa jwanjwa kəɓa. <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />&lt;&lt;Acwɛ nə, lonwa ɛ nə nang ɓani ma?&gt;&gt;<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Kə Yesɔ cwa ɓane ya, &lt;&lt;Unə akilo, ɓu dya ngwi ngɛ fundo wa la. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Nəngwi ɓa ɓyagaɓanə, ɛ mɓa ɓa yamə nga cwayo ya gənə ɓa ngə cwayo gə, &lt;nga ya ka kənə,&gt; Hakə ɓa fudang nəngwi ɓa ɓyagaɓanə. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Kəfi gwa wa ɓe kən la sadenang wanə aɓaru gwa atanta zənədo ngɔn la boa ni kəfi u wanə yo gwa ata ɓa ɓa jagɔnə. Se nang ɓani nənang mbe, ama yeshiwa gɔ banla kɛ. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Nəngwi ɓa ɛ, lwe nə nəngwi ɓa, donyang ɛ, lwe nə donyang. Kəmi ɓa ɛ yɛ nga zən lajeku, kəfi ɛ jə nywe. Nang ɓani ka kaɓa nə nang a jwənjwə ɓa la gəmbe nang mɓa na yi ama a gəmbe niwa.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />&lt;&lt;Ngu nyang gwɔn sa lashiuwa. ɛ gwa wa ghanə layi do nə tita fi, ɛ gbɔ wa la yido ɓwa nəshi Yahudawa ɓa. ɛ, ghɔ wanə lasa nwianye ɓa, ɓa kwə ɓa yo yo gə. yonəmani yo gua u cwayo aɓaru anuanua. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Ama mbegə ayenəshiwa ni la mɓani, se cwa nəngwi kupaca yo kwã agang mbe. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Kəfi sadenang ɓa gwa wani nga gha wanə yido nə tita ni, ɓu yiili la sanang lu cwani la; sadenang sayi sɔ mɓa ngɔn ni, u cwa nang ku ɓa noa nəni. Yonəmani kaku nga cwayo ɓasɔ la; yo ɓasɔ ɛ bwala ɓə Yingu atẽtẽ<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />&lt;&lt; Nwinyə ɛ na nwinyɔ ɓa jə, daa ɛ na nwiwa, nwi ɓa ɛ lwe nə daa gaɓa hakə ma jəɓa. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Nwaku ɛ nyuwa yo gə. Ama paca ngwi nang dwənə ngɔn ni hakə gha yeshiwa ngɔn ni gɔ lucwido cwi.<verse eid="MRK 13:13" /></para>
  <para style="s">Laɓyɔ anjɔ</para>
  <para style="r">)Matu 24.15-28; <ref loc="LUK 21:20-24">Luka 21.20-24</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />&lt;&lt; Gua u sang&lt;&lt; Nang anjɔ ɓa ɛ nənə nang ni &gt; ngənə la yido nang gɔ zanla na ngə ni. &gt;&gt; )gua ngwi cwa kwa ɓa nyi&lt;&lt; &lt;&lt; Ngwi nang ɓa ngənə la Yahudiya ni ɓa va gha lashi nta. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Ngwi nang ngənə lashinywi ni ɓu se dya layi la yona cwe nang ngɛ la. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Ngwi nang fi ngənə lase ni ɓu fi cwe nwanang danzhi gɔ la. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Nang jwə bəɓa la sayi ɓani sa nyənəgwa ngwa la ɓa kəfi naɓa ɓanə nwinə la lazẽze ɓa sade niǃ <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Pɛdang ya nang ɓani ɓe nənang sade gwegwon laǃ <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Yonəmani laɓyɔ yi sade sɔ ɓa gaa gɔnə wanə angye ɓa meri nənə la tũ sadenang Nyimoː mang la sapyang hakə ɓeɓe. Kɛfi angɛ nɛnɛ na yiri fi. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Ama nɛ Nyimoː finə finə məncwon sɔ latwa nlani; inə gɔ nənla ni, ko ngwi ngɛ angye nang la cwido ni, ama yo ngwi nang ɓa nte ɓani, konte ku gɔ finə məncwon sɔ ɓa zẽze ngɔn. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Nankə la, inə ngwi nang ku cwowanə, &lt;sang, ka Almasihuː yeǃ &gt; ko,&lt; u sang &gt; ka kɔ lang lo waǃ&gt;ɓu dya la. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Almasihuː ngwi sadang ɓa, ɓa ngwi dangdoswɔn dansa ɓa ɛ ɓwa caɓesa dansa gaɓa. Gaɓa ɛ nə nang yiswe ɓa nang kən gwɔn ɓa yona fũdang ngwi ɓa Nyimoː nte ɓani ni, inə la dədə ni. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Gua nə akiloǃ Gəmə gɔ cwowanə ngɔn nang anwaku mbegə sade sɔ mɓa.<verse eid="MRK 13:23" /></para>
  <para style="s">Nang mɓa nwi nəngwi</para>
  <para style="r">)Matu 24.29-31; <ref loc="LUK 21:25-28">Luka 21.25-28</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />&lt;&lt;Ama la mencwon ɓani, la zinze laɓyɔ ɓani. lo ɛ ɓə yidavũ, fi sɛ kɛ chado la, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />Sɛ ɓa ɛ gumi la lankwã, kə njamu ɓa lankwã ni ɛ zĩdo.<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />&lt;&lt;Nankənə kə Nwi nəngwi ɛ bwanə, ngu mɓa la la nkwa ɓa njamu gɔnə yinə gang zangɔnə. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Gɔ u swon maleka gɔɓa gha la ɓyən nea yi kəmi ɓa tẽ ngwi ɓa Nyimoː cwenə la ɓyən nso yi kəmi lasapyang hakə a yenəshiwa la byəng angɛ.<verse eid="MRK 13:27" /></para>
  <para style="s">Nang Maɓesa nang lasa shi nzu</para>
  <para style="r">)Matu 24.32-35; <ref loc="LUK 21:29-33">Luka 21.29-33</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />&lt;&lt;U maɓesa nang lasa shi nzu. Sadenang pawa fudi na cwi ja ngɔn ni, u nyi ngɔn vang zədo ngɔn. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Lasa nang ɓani, nga nənang ni, ngu nyi ngɔn sade zədo ngɔn, ngə kayĩse ɓa dang nywi. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Ngə cwowa yo ade nə ngwi sapyang ɓani kɛ wu la, se paca nang ɓani nənang mbe. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Lankwã ɓa kəmi kɛ la kəla, ama yo gə kɛ kala ko la pika.<verse eid="MRK 13:31" /></para>
  <para style="s">Ngwi ngɛ nene nyi lalo sɔni</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />&lt;&lt;Ama ngwi ngɛ nɛnɛ nyi lalo sɔni, ko che na nang ɓani la nənang, ko maleka ɓa lankwã ko Nwi wa; sa ka daa gɔ ɓansɔ kə nyi. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Unə akilo, ngu nyang yuwa kəmi ɓu ngayinga la, yonəmani nyi lalo la, koche nanla sadenang nangni la nənang la. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Na ngwi nang ghanə zhe janja, kə cwe layi gɔ na nwinfɔ gɔɓa nyangwɔn nə, kə u naa wanku ɓa nangnu nang la nəni. Nang ni cwa ngwi sang zhi nyang yi nəɓwɔ u sang zhi.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />U nyang yuwa nəɓwɔ nankənə, ngu maɓe soa dənə yonəmani gua nyi lalo nang shãyi gua la mɓa nila. yonəmani ngu mɓa ɓa logwa nə, ko gwando, ko do zedo na kwã ɓa vula nə ko lo cwi nga mɓa. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Sangdo nəɓwɔ, yona inə mɓa moa ngu ngayinga. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Nang cwo nəni, ngə cwa wanku nə, maɓe soa də nəɓwɔǃ&gt;&gt;<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Nga kã məngang na gwa Yesɔ</para>
  <para style="r">)Matu 26.1-5; <ref loc="LUK 22:1">Luka 22.1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Yohana 11.45-53</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Nwinfi gwe mba kənə yinyɔ gangdi ɓa yinyɔ nwa angye nang funang nɛnɛ ni. Nwanye ngwi nyanang ɓa ngwi nyanang ɓa ngwi maɓesa dang nangzhĩ Musa ɓa, kəɓa kãdo məgang yona gwa yesɔ jwanjwa , yona ɓa jə wa. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />&lt;&lt;Ama nga cwa ya, lalo zhɔ sɔla,&gt;&gt; Kəɓa ya,&lt;&lt;Yona nəngwi ɓa lwe nə kuɓwon.&gt;&gt;<verse eid="MRK 14:2" /></para>
  <para style="s">A fa Yesɔ mu Anywinywi nə la Betani</para>
  <para style="r">)Matu 26.6-13; <ref loc="JHN 12:1-8">Yohana 12.1-8</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Sade sɔ Yesɔ ngə Betani la layi ngwi məngɛ nga kwi yɔ Siman ngwi vaswe, ngu tanang, kə ngwa məngɛ, mɓa ɓa nwi bɔ muu anywinywi nə angye manə ɓa nta alaɓasita pɛ ɓa mu anywinywi nə yi shede agang ngɔn kəfi ɓwon kwalba sɔ kə ye Yesɔ nə lashiwa.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Ngwi ngã ɓa ngənə layi sɔni nga jwə sɛgwɔn, nga cwanə saɓa, &lt;&lt;Ka yonə kə nga ja muu sɔ ma? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Nte yaaɓa kəɓə ni lasa shede nang dyanədo che shede kaanto fin nca kə naa ngwi laɓyɔ ɓaǃ&gt;&gt; kəɓa lwe nə ngwa sɔ wane.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />&lt;&lt;Ama Yesɔ cwa ɓanə ya, vyɔ wa mana.&gt;&gt;Ka yonə ngu lwe akilo gɔ ma? Ɛ ngwani nənang ade ngɔn la samə. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Gua lu ngəɓa ngwi laɓyɔ ɓa lo anwaku, ko lonwa ku ngu shãna bali gaɓa ngɔn ni. ama lo wanku ngənə ɓowala. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Gɔ nə nang gɔ lu nəni; ngu fã samə ɓa muu yona maɓesa nang di gə lasibe. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Bɛni, ngə cwowa yo ade nə, yido nang ku la cwanə yo kwa agang la sapyang ni, ɛ, cwa nang ngwa ni nənə yona chəng yo gɔ.<verse eid="MRK 14:9" /></para>
  <para style="s">Yahuda dyanə ɓa nang naa Yesɔ</para>
  <para style="r">)Matu 26.14-16; <ref loc="LUK 22:3-6">Luka 22.3-6</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Kə Yahuda Iskariyoti nso latangte nwi nangjwa ɓa jwa cwi mɓa ni, gha sa kwə ngwi nyanang yona ja Yesɔ labe ɓa. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Kəɓa wayo ni kəɓa wanua ɓa wanə, kəɓa nəwa akawa nə yona nawa shede. Kə Yahuda fudi na kã məgang yona ja wa.<verse eid="MRK 14:11" /></para>
  <para style="s">Yesɔ tang nang yinyɔ gandi ɓa nwi nangjwa gɔɓa</para>
  <para style="r">)Matu 26.17-25; <ref loc="LUK 22:7-14">Luka 22.7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yohana 13.21-30</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />La lo fudi zhɔ yi nwa, nang nɛnɛ ɓa nang fung gɔ ni, lalo nang la danəgu nwi nggang yi zhɔ ni, nwi nangjwa Yesɔ ɓa byəwa ya &lt;&lt;Laje nga shãna je gha maɓesa nang tang zhɔ yi gandi yiguma? <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />Kə Yesɔ swon nwi nangjwa gɔ ɓa mba ɓa yoni nə&gt;&gt;Ngənə gua dya yii agang ngɔn ni, u jwanə ɓa ngwi ngɛ ngu cwe vye diɓi. U kafĩ wa. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Paca layi nang gɔ dyanə la yimɓa ni, cwa shã layi sɔnə,&lt;Ngwi maɓesa nang nga ɓyədo ya lanywi nang ngə tang nang zhɔ gangdi ɓa nwi nangjwa gəɓa ni je ma?&gt; <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Gɔ u chowaɓe sa nywi agang lankwã nang yenəshi nang ma gɔ ɓa nəkuni, layimɓa gua lu maɓesa nang tang je nyang.&gt;&gt;<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Kə nwi nangjwa gɔ ɓa lwe nə, kəɓa dyanə yii agang, kəɓa mɛnə nang ɓasɔ na nanang Yesɔ cwani kəɓa maɓesa nang tang yi zhɔ gangdi.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Sadenang lo gwa ni, Yesɔ mɓa ɓa nwi nangjwa gɔɓa jwa cwin mba kəɓa mɓa layi sɔ. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Nga tang nang ni, kə Yesɔ ya, &lt;&lt;gəmə ngə cwowa yo ade nə, nso latantowa ɛ jamə, angye nang ngə tang nə nang tang ɓɔni.&gt;&gt;<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Kə nwi nangjwa gɔɓa, fudi na chəng yo ka nga ɓyəwa, nwaku nso nso, &lt;&lt;Ko ka kəmə, ka kəmə ma?&gt;&gt;<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />&lt;&lt;Yesɔ dya ɓanə ya, nso latanto wo jwa cwi mba ni.&gt;&gt; Angye nang ngə tang nang lajwe nso ni. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Nwi nəngwi ɛ wuuwu, nanang jwanə la lakwã Nyimoː ɓa ni ya gɔ lu nə ni; ɛ jwə bəɓa sa ngwi nanə Nwi nəngwi niǃ Nte zangɔ ɓa mya wa nlaǃ &gt;&gt;<verse eid="MRK 14:21" /></para>
  <para style="s">Nang tang Daa shayonki</para>
  <para style="r">)Matu 26.26-30; <ref loc="LUK 22:14-20">Luka 22.14-20</ref>; <ref loc="1CO 11:23-25">1 Korintiyawa 11.23-25</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Ngə nga tang nang, kə Yesɔ cwe nwa ngɛ kə wisi Nyimoː nə, kə gbənə ɓe, ngu naa nwi nangjwa gɔɓa, kə u ya &lt;&lt;U cwe nang ni ka naang samə&gt;&gt;<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Kə lazẽze ku cwe nwi kwi yi dibi fashi inabi kə wisi Nyimoː, kə naɓa; gaɓa ku ɓa fa. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Kəfi cwa ɓanə ya, &lt;&lt;Nang ni ka jwɔn samə. jwɔn yi pɛ akawa. ɛ yeni yo nəngwi ɓa ɓyagaɓanə,&gt;&gt; <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />&lt;&lt; Ngə cwowa yo ade nə, gəmə kɛ ma fa dibi fashi inabi la nang gəmə ma ngə fanə la donyang apa yi Nyimoː ni.&gt;&gt;<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Layimɓa kəɓa tanə dyən kəfi ɓa kwenə ɓe sa nta shĩ zetu.<verse eid="MRK 14:26" /></para>
  <para style="s">Bituru ɛ nya sang Yesɔ</para>
  <para style="r">)Matu 26.31-35; <ref loc="LUK 22:31-34">Luka 22.31-34</ref>; <ref loc="JHN 13:36-38">Yohana 13.36-38</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yesɔ cwa ɓanə ya, &lt;&lt;gua ku u va u vya mə, nanang ɓa jwa nə ya, ngə gba ngwi zaa nang kũ, nggang ɓa ɛ vəva. &gt;&gt; <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />ama lazə̃ze gəmə lwe nə ngɔn la shije ni ngə gəmbe soa na gha Galili <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />Kə Bituru cwa wanə ya, &lt;&lt;ko gaɓa ku va gangɔ kɛ vya la. &gt;&gt; <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />Yesɔ cwa Bituru nəya, ngə cwo yo ade nə. nwinza la duda ni, mbegə zɔ ogɔn lɛlɛ fi nca ni, gu a nyasang nang nyi gə fi nca'' <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Ama Bituru mafi cwa ɓa njamu nə, ngu ya, &lt;&lt;ko la jəmə ɓo, kɛ nyasang nang nyi gula ko la pikaǃ&gt;&gt;<verse eid="MRK 14:31" /></para>
  <para style="s">Yesɔ pɛdang la Gasemani</para>
  <para style="r">)Matu 26.36-46; <ref loc="LUK 22:39-46">Luka 22.39-46</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Kəɓa ɓa yi do mə ngɛ la gasemani, kə Yesɔ cwa nwi nangjwa gaɓanə, u, də lang le nga pɛdang'' <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Kə gɔ cwe Bituru ɓa yakubu ɓa yohana ɓawa ɓa ngənə , kə gɔ fudi na yiili wanə hakə sawa swɛnə. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Kə cwa ɓanə ya, &lt;&lt;nang yiswe ngənə sɛgwɔn nəni yapɛ&lt; la jənəjə, u, də lanle ngu sang zhi.&gt;&gt; <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />Kə gɔ gha be la twa, kə gu kəmi, kə pɛdang ngu ya, ntɛ la nənə ni ɓa cwe nə sayi laɓyɔ ninə. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />&lt;&lt;Daa &gt;&gt; gɔ pɛdang, &lt;&lt;Daaǃ Daa gə Ko ka yiri nanwaku laso la nənə. Acwe mə nwi kwi yi laɓyɔ ninə aca gha. ama ka nang gənə ngə shã ni la, seka nang gu nga shã ni &gt;&gt; <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />Kə finə mɓanə labe nwi nangjwa gɔɓa ni ngu mɛ ɓa nga ngayinga. kə ɓyəng Bituru, ya Siman nga ngayinga ma? Ase ka ba sang zhĩ la ko che nso la ma? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />U, sang zhĩ fi u, pɛdang yona bugu la la nang anjɔ. Yingu nga shã ama swe nɛnɛ ɓa njamu nə. <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />Kəfi ma fi u kwe, u pɛdang, u cwa yiri yoɓa sɔ. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Kəfi fi mɓa sa nwi nangjwa gɔɓa kəfi meɓa nga yi nga; gaɓa banla na nyang zayi ɓa bwenbwe. Kəfi gaɓa nyi nang la cwawanə ni nla. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Nangfĩ yi nca gɔ, ngu cwa ɓanə ya, &lt;&lt;Haɓeku gua ngu ngayinga hakə ngu wi ma? Sade nə ngɔn ɛ, na Nwi nəngwi laɓe ngwi anjɔ ɓa ngɔn. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />U lwe, je kwe. sang, ka ngwi nang jamə nəni ye.<verse eid="MRK 14:42" /></para>
  <para style="s">Ba gwa Yesɔ</para>
  <para style="r">)Matu 26.47-56; <ref loc="LUK 22:47-53">Luka 22.47-53</ref>; <ref loc="JHN 18:3-12">Yohana 18.3-12</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yesɔ ngə la la nang cwayo, kə yahuda, nso latangte nwi nangjwa gɔɓa jwa cwi mba, ɓa dyado, ɓa nəngwi ɓanə ɓa ɓyagaɓa nə cwe kafẽ ɓa shi ɓanə kəfi nwianye ngwi nyanang ɓa ngwi maɓesa nangzhĩ Musa ɓa, kəfi nwianye ɓa swon swon ɓa. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Yahuda, ngwi jawa, ngu wanə ɓaɓa ya, &lt;&lt;Ngwi nang gənə kpã nə ngɔn ni, ka ngwi sɔ. u gwa wa kwe nə. u gwa wa nəɓwɔ.&gt;&gt;<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Ba nang mɓa yahuda nə, kə tãmi gha be Yesɔ, ngu ya, &lt;&lt;Ngwi maɓesa nangǃ&gt;&gt; kə gɔ kpã wa. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Kə nəngwi ɓa gwa Yesɔ kəɓa gwa wa ɓa njamu nə. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Kə nso latangte nwi nangjwa Yesɔ ɓa ngənə kɛsẽ ni kə gɔ və kafɛ gɔ, kə u kənə yicwɛ nwi layi nwanye nyanang. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yesɔ cwa ɓanə ya, gua bwanə kafɛ ɓa shiba ngu gwanə na ngwi bado nema? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Lalo a nwaku ngə ɓoa la lanywi Nyimoː agang ngə maɓesa nang, kəfi u gwamə nla, ama yona pɛ kwã agang Nyimoː cwani na ɓe yoade &gt;&gt;. <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Kə layi mɓa nwi nangjwa gɔɓa vya wa, kəɓa va. <verse eid="MRK 14:50" /><verse number="51" style="v" sid="MRK 14:51" />Nwi anəngwo mə ngɛ ja nang ja la, seka kafi Yesɔ, danswe lasɔ kə nəngwi dari na gwa wa nəni, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Kə gɔ va vya kwe vya nang danswe gɔ kə kwe ɓa fi ayinse.<verse eid="MRK 14:52" /></para>
  <para style="s">Yesɔ ngə layinsẽ ngwi ɓwa nəshi shivu ɓa</para>
  <para style="r">)Matu 26.57-68; <ref loc="LUK 22:54">Luka 22.54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Yohana 18.13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Kəɓa ghanə Yesɔ labe nwianye agang ngwi nyanang ɓa nwianye ngwi nyanang ɓa ngwi maɓəsa nangzhĩ Musa ɓa kəɓa ɓwa nəshi la yi do sɔ. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Bituru kafĩ Yesɔ, ama gɔ ngə ɓa jagɔnə, ngu kafĩ ɓa hakə la baba yido layi nwianye ngwi nyanang. Layimɓa gɔ də ɓa ngwi sang zhi ɓa, ngu nywa va. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Nwianye ngwi nyanang ɓa nwianye ngwi ɓwa nəshi ɓa nga kãdo nang ngɛ nang la mɛnə shedaku lashi Yesɔ ni ya nə ayibe yona ɓa jəwa, ama ɓa mɛ la. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Nəngwi ɓa ɓyagaɓanə cwa sheda dansa lashiwa, ama yo gaɓa ngə nso nla. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />Kə ngwi ngɛ ɓa lwe ɓa lankwã kəfi ɓa sadang lashi Yesɔː <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />&lt;&lt;Jɛwa ngwi ni cwa ya, gənə ngə gwenywi nang nəngwi ɓa manə ni.kəfi la gwe, nca ngɔn ni gənə nən ma angye nang ka nəngwi ɓa mamə ni la.&gt;&gt; <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ba kənə ku sheda gaɓa ɓansɔ la. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />Kə nwianye ngwi nyanang ɓa lwe ɓa lankwã la tanteɓa ngu byə Yesɔ ya&lt;&lt;gu anɛnɛ ɓa yonə shi yoɓa nang nga cwanə lashiu ni ma?&gt;&gt; <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Ama Yesɔ gadonə ngu cwayo ngɛ la, nwianye agang mafi byə wa ya, &lt;&lt;ka kunə Almasihuː ma, &lt;wi yi ngwi balka Nyimoː ma?&gt;&gt; <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />Yesɔ dyanə ya, &lt;&lt;ka kəmə.&gt;&gt; kəfi gua lu sang Nwi nəngwi də gaɓe ɓezhi ngwi yi sha gang kəfi ngu mɓa lankwã la la nkwãǃ <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />Kə nwianye agang sɔ nya nangja gɔ, ngu ya, ka yo anwa&lt;&lt;Je li shã shedaku ngɛnla maǃ <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />U, wa doshəng gɔ ngɔn lan. kanə nang chəng gua? <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Ngwi ngɛ ɓa fudi na shɛ Yesɔ ɓa ntite, kəɓa dwə zayi wa, kəfi pwonwa la tancwɛ wa ɓa ɓe, &lt;&lt; a cwa ngwi nang pwonə tãcwo ɓa ɓe niǃ&gt;&gt;gaɓa cwa. Kəfi ngwi sangzhi ɓa cwewa kə ɓa gba wa.<verse eid="MRK 14:65" /></para>
  <para style="s">Bituru nyasang nang nyi Yesɔ</para>
  <para style="r">)Matu 26.69-75; <ref loc="LUK 22:56-62">Luka 22.56-62</ref>; <ref loc="JHN 18:15-18">Yohana 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Bituru ngənə la yido layi sɔ, kə nwianəgwa məngɛ latangte nwi nə nangnu nwianye ngwi nyanang ngu mɓa. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Kə sang nə Bituru nga wa nə va ni. kə sang wa nəɓɔ, ngu cwonə ya &lt;&lt;ɛ guma ngənə ɓa Yesɔ yi Nazare.&gt;&gt; <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />Ama Bituru nyasang ngu ya, gəmə nyi nang nga cwani la. Gəmə nyi la ko lapika,&gt;&gt; gɔ cwa, kə lwe gha dagɔ layi sɔ. layimɓa kə zɔwon lɛlɛ. <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />Kə nwianəgwa nwinfɔ sɔ sang Bituru layimɓa ni ngwi ni ma cwa ngwi ɓa ɓanə nga kwe ni. Gɔ ngə tangte ɓaǃ &gt;&gt; <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Kə Bituru mafi nyasang kə.</para>
  <para style="p" vid="MRK 14:70">Sayi latwa, kə ngwi ɓa nga kweni nga cwa Bituru fikə, lanle guma ngə la nso tangte ɓa, gu ka ngwi Galili ɓa. <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />Kə Bituru fudi na cwa ya gənə ngə ghanang ngɔn ngə cwa yo adeǃ Nte Nyimoː siri gənə ka kənə nə laǃ Gəmə nyi ngwi ngu cwayo gɔni la&gt;&gt; <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />Ɓabe kə zɔ ogɔn lɛlɛ fĩkə, kə Bituru chəngyo nang Yesɔ cwawanə ni; &lt;&lt;Mbe kə zɔ ogɔn lɛlɛ fi mɓa ni, gu a nyasang nang nyi, gə fi nca&gt;&gt; kə gɔ chəng yo ɓa yoni kə bemi u lɛlɛ.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Ghanə Yesɔ Labe Gwaməna Bilatu</para>
  <para style="r">)Matu 27.1,2,11-14; Luka 23.1-5; Yohana</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Ba vula nə nwianye ngwi nyanang ɓa nwianye ɓa ngwi maɓesa nangzhĩ Musa ɓa, paca fi ngwi ɓwa nəshi ɓa kəɓa wanə. Kə dwə Yesɔ, kəɓa kwe wanə layinsẽ Bilatu <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Gwaməna Bilatu byə wa ya, &lt;&lt;ka kunə kwə Yahudiya ɓa ma?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">Yesɔ dya wanə ya, &lt;&lt; nankənə ka a cwa .&gt;&gt; <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />kə nwianye ngwi nyanang nga cwayo anjɔ ɓa shiwa sa nang ɓa ɓyagaɓanə. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />kə Bilatu mafi byəwa yo ya, &lt;&lt;kaɓa cwayo sa namɓa ngə byə nəni la ma? Awa namɓa nga cwanə lashiu niǃ&gt;&gt; <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Ama Yesɔ bwedɔ nla, cwayo ngɛ la, hakə nang sɔ naa Bilatu nang yiswe<verse eid="MRK 15:5" /></para>
  <para style="s">Ba Nə Yesɔ Tita Nang Wuu Nə</para>
  <para style="r">)Matu 27.15-26; <ref loc="LUK 23:13-25">Luka 23.13-25</ref>; Yohaan 18.39-19.16&lt;&lt;</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Gwaməna Bilatu vowi ngɔn nankənə sadə zhɔ , ngu ta ngwi fusina ɓe nso nəngwi ɓa nga juni. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />La sade sɔ ngwi məngɛ yawa Baraba ni ngəla fusina ɓa ngwi jə nəngwi angye jənə nəngwi ɓa sade tagwa. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Sadenang cwi nəngwi ɓa mɓa sa gwaməna Bilatu na byəwa ta nəngwi nso ɓe nanang vowi nga nəni. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />&lt;&lt;Ku byə ɓa gua ngu shãna ta kwə Yahudawa ɓe ma? &gt;&gt; <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Yonəmanə ngu nyi ngɔn ka doshi kə nyang nwanye ngwi nyanang ɓa kəɓa na Yesɔ labe wa. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Ama nwanye ngwi nyanang ɓa lwənə nəngwi ɓa byədo, nankənə,ɓa taa Baraba ɓə. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />kə Bilatu ma cwayo ɓa cwi nəngwi ɓanə, &lt;&lt;Kanə, nankənə nənə ɓa ngwi gua ngu kwinə kwə Yahudawa ɓani ma?&gt;&gt;<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Kə ɓa lwe nə laghɔ ɓa ya, &lt;&lt;Ba gang wa sa shĩǃ &gt;&gt;<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Bilatu byəɓa ya &lt;&lt;Ka yonə sɔ? Ka ayibe anwa gɔnə?&gt;&gt;</para>
  <para style="p" vid="MRK 15:14">Kəɓa lwe nə laghɔ nga ya, &lt;&lt;Ba gang wa sa shĩǃ&gt;&gt;<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />kə Bilatu nga shãna vũnə sɛgwɔn ɓani. kə taa ɓa Baraba nə ɓe. La zinze gbanə Yesɔ ɓa tɛ kə gɔ naɓa Yesɔ gang wa sa shĩ<verse eid="MRK 15:15" /></para>
  <para style="s">Soje ɓa vɛ Yesɔ</para>
  <para style="r">)Matu 27.27-31; <ref loc="JHN 19:2">Yohana 19.2</ref>,<ref loc="JHN 19:3">3</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Kə soje ɓa cwe Yesɔ dyanə la yido nə tita gwaməna kəɓa ɓwanə fi soje ɓa ku. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />kəɓa ja Yesɔ nang ja wanfye nə angye ɓa manə ɓa kuɓa, kəɓa nyang wanə lashi wa. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />kəɓa fudi na yawa do ja yaa, ''yonki gu dwa, kwə Yahudawa ɓa. <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />kəɓa gba wa ɓa shi la lashi wa, nga she wa ɓa titẽ, kəfi nwami nga nawa gang.<verse eid="MRK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 15:20" />kəɓa yeshi nang vɛwani, kəɓa cwinə nangja kũ gɔ sɔ, kə jawa nangja gɔnə. Kəfi bwawanə ntẽ kəɓa gang wa sa shi.<verse eid="MRK 15:20" /></para>
  <para style="s">Ba gang Yesɔ sa shi</para>
  <para style="r">)Matu 27.32-44; <ref loc="LUK 23:26-43">Luka 23.26-43</ref>; <ref loc="JHN 19:17-27">Yohana 19.17-27</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />La məngang kə jwa ngwi mə ngɛ yawa Siman, angye nga ɓanə yi aggang la ɓe yii ɓa, kəfi soje ɓasɔ nyangwa u cwe shiagang yi Yesɔ ɓa njamu nə. )Siman ka ngwi Sirin ka kɔnə dɛ Alezanda ɓa Rufu.&lt;&lt;<verse eid="MRK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 15:22" />Kəɓa ghanə Yesɔ la yido məngɛ nga kwinə golgota.&lt;&lt; Yido kwang kwɔ lashi.&gt;&gt; <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Layimɓa kəɓa nga shana nawa dibi lãnə ɓa ngɛ, ama Yesɔ nyi na fa. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Kəɓa gang wasa shi, kəɓa gaanə nangja swe gɔɓa, kəɓa tanə kwã kəɓa sang kanwa la mɛ ɓeje sa nangja swe gɔ ɓa. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Che nto nea ɓa vulanə sadenang gaɓa gaang wanə sa shi ni. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Lasa sa shi agang wanəni kəɓa jwa nang nangjwa cwɛ zhãng ya, &lt;&lt;kwə Yahudawa ɓa ye.&gt;&gt; <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Ba gaang ngwi yinang ɓa mba ɓawa, nso gaɓe ɓezhi gɔ nso gaɓe ɓeshang gɔ. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Nang ni kəɓə nə nang pɛyo ɓa nga cwanə ya, &lt;&lt; Ba cwawa la tangte ngwi anjɔ ɓa.&gt;&gt; <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Nəngwi ɓa nga kwe nəni kə nga tə̃lashi ɓa nga cwɛ Yesɔ ɓa zhang, nga ya,&lt;&lt;Ahaǃ gu nang ayɛnə nywi kəfi mawanə gwe nca niǃ <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />A se lashi shi a agang gaang ni a pong lashiu. <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />Nankənə fi nwanye ngwi nyanang ɓa ngwi maɓesa nangzhĩ Musa ɓa nga vɛ Yesɔ nga ya, &lt;&lt;Gɔ pong ngwi ngɛ ɓa ama gɔ bana pong lashiwa nlaǃ <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Gɔɓə kanə Almasihuː ni, kwə isrela ɓa, ase ɓeɓe lasa sa shi agang, kəfi je di dyanə ɓa yo ade lasoǃ&gt;&gt;</para>
  <para style="p" vid="MRK 15:32">Ngwi nang yii mɓa gaang ɓanə ɓawani nga cwayo doshəng sa Yesɔ namɓə.<verse eid="MRK 15:32" /></para>
  <para style="s">Nang wuu Yesɔ</para>
  <para style="r">)Matu 27.45-56; <ref loc="LUK 23:44-49">Luka 23.44-49</ref>; <ref loc="JHN 19:28-30">Yohana 19.28-30</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Ba shaka lonə, kə yidavũ dang kəmi ku hakə che nca yi logwa. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Che nca Yesɔ lwe nə laghɔ ɓa nyenə ya, Eloi , lama sabataani? &lt;&lt;Ngu ya Nyimoː gə, Nyimoː gə, ka yonə kə gu a nyimə ma.&gt;&gt; <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />Ngwi nang ngənə layi mɓa ni ɓa wasawa ni kəfi ya, &lt;&lt;wasawa, gɔ ngu kwida Iliya. <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Nso gaɓa va gha ja kã wedi sa dibi fashi inabi, dwə sa shi kə na Yesɔ yona fa, nga ya &lt;&lt; Gua ngəmi be; je sang ngɛnə ngwi dangdoswɔn Iliya la mɓa lu səwanə sa shi.&gt;&gt;<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Kə Yesɔ lwe nə laghɔ ɓa nyenə kə daa wii yeshiwa nankənə. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />Kə nywanang danə yido nyanang la lanywi pɛdang ni kə nya ganə ɓe mba la lankwã ɓanə kəmi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Kən nwanye soje Roma ɓa ngənə layimɓa ni la sibe shi agang sɔ ɓa sang yiri nang wuu Yesɔ wuu ni&lt;&lt;Ngwi ni ka nwi yi Nyimoː adedeǃ&gt;&gt; <verse eid="MRK 15:39" /><verse number="40" style="v" sid="MRK 15:40" />Ngwa ngɛ ɓa ngə ɓa jagɔnə nga sang ni, latangte ɓa, Maryamu yi magadela, ɓa maryamu nɛ Yakubu nwi pika ɓa Yusufu ɓa Solomi. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />La Galili nyinəwa ɓani nga kafĩ Yesɔ nga nəwa nangnu nə. Ngwa ngɛ ɓa, ɓa ɓyagaɓanə kəɓa mɓa bawa la urshelima.<verse eid="MRK 15:41" /></para>
  <para style="s">Nang di Yesɔ</para>
  <para style="r">)Matu 27.57-61; <ref loc="LUK 23:50-56">Luka 23.50-56</ref>; <ref loc="JHN 19:38-42">Yohana 19.38-42</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Ba logwa nə, nga maɓesa ɓa, yonəmani lalo nang nga manəɓesa ɓa, yo lalo awinwi, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Kə ngwi mə ngɛ yawa Yusuf yi Arimatiya u mɓa. Gɔ ka ngwi nga nawanə gang la shivu, angye nang ngu tanəcwɛ nang mɓa yi do nəgang Nyimoː ni. Ka lalo maɓesa yo lalo awinwi, kə nə sɛgwɔn kə u gha sa Bilatu, kə gɔ ju ɓa nawa kwon Yesɔ. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Yi gwa Bilatu u wanə ya, Yesɔ wuu nə ngɔn ni. Kə kwida nwianye soje ɓa ɓyəng ɓa ko yoade Yesɔ wuu ngɔn. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Kə wanə yoni la ladang nwianye soje ni, kə na Yusufu kwon Yesɔ. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yusufu ya nywanang nwavi, kə cwe kwon Yesɔ kə chawa ɓa nywanang wavi, nyang wa la lajwɛ nang ɓa kanə lasa nta ni. Kəfi ɓən nta kə vinə jwɛ sɔ. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Maryamu yi magadala kəfi nɛ Yusufu nga sang, kəɓa sang nə yido nang tanə kwon Yesɔ ni.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Nang Lwe Yesɔ La Shije</para>
  <para style="r">)Matu 28.1-8; <ref loc="LUK 24:1-12">Luka 24.1-12</ref>; <ref loc="JHN 20:1-10">Yohana 20.1-10</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Lalo awinwi yi Yahudawa kwe ni, Maryamu Megadala, ɓa Maryamu nə Yakubu, ɓa fi Solomi kəɓa yaa muu anywi nyui, yona gha fa Yesɔ nə la sawa. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Ba vulanə yi lo məncwon a gəmbe, sayi lo nga cwin ni, kəɓa gha la shije. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Kəɓa ngə la məngang, kə ɓyəng nə saɓa, &lt;&lt;ka nwa la fyə nta la dang shijə ni ma?&gt; )Ka nyən nta agang.&lt;&lt; <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Sadenang ɓa dyanə layimɓa ni, kəɓa ɓa fyə nta sɔ finə ngɔn la shije. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Kəɓa dyanə shije, kəɓa sang nwi anəngwo mə ngɛ də byəng ɓezhi, ɓa nangja wãvi nə lasawa, kəɓa yiiyi. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />&lt;&lt;Bu yiiyi la,&gt;&gt;Gɔ cwa. Gua ngu kãdo Yesɔ yi Nazare, angye ɓa gba nə sa shi ni. Gɔ nɛnɛ la ngɔn le, ɓa lwewa nə ngɔnǃ U sangǃ kayido ɓa tawa ni yee, <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Ama u gha cwa nwi nangjwa gaɓanə, uta Bituru laɓaː &lt; Gɔ u gəmbe lasaɓa na gha Galili ngɔn; layimɓa gua lu sang wa na nang cwowanə ni. &gt;&gt;&gt; <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />Kə gaɓa bwa ɓa gwenvɔ nə la lajwɛ wi, Akilo gaɓa lwə hakə saɓa nga bwadang. Ba cwa ngwi ngɛ nang ngɛ nə nla, yonəmani nga yiyi. <verse eid="MRK 16:8" /><verse number="9" style="v" sid="MRK 16:9" />Kə Yesɔ lwe nə la shijə ɓa nvula nəni lalo yi gəmbe məncwon, ngu fudi na caɓəsɔ sa Maryamu Magadala, wato gwa nang Yesɔ bwa wanə gwe anjɔ nto mba lasawa ni. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Gɔ gha cwa nwi nangjwa gɔɓa nə. Gaɓa nga cheng yo nga lɛlɛ. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Kəfi ɓa wanə ya Yesɔ ɓanə yonki nəni hakə ma gɔ sang wa, gaɓa dyan nla ya ka yo ade nla.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesɔ bwalasa nwi nangjwa gɔɓa mba</para>
  <para style="r">)<ref loc="LUK 24:13-35">Luka 24.13-35</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Lazinze kə Yesɔ pye swe ngu caɓə sɔ sa ngwi ɓa mba latangte nwi nangjwa gɔɓa sade nga ghanə yi apika ni. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Kə ngwi mba ɓani kəɓa fi gha cwa nwinfi ɓanə, ama hakə aɓeku ɓa nyi na ɓa dyanə ɓa abaru sɔ nla.<verse eid="MRK 16:13" /></para>
  <para style="s">Yesɔ bwalasa nwi nangja gɔɓa njua cwin nso</para>
  <para style="r">)Matu 28.16-20; <ref loc="LUK 24:36-49">Luka 24.36-49</ref>; <ref loc="JHN 20:19-23">Yohana 20.19-23</ref>; Acts 1.6-8&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Lazə̃ze Yesɔ canə ɓe sɔ lasa jwa cwi nso ɓani sade nang nga tang nang ni. Kə gɔ lwe ɓanə, Yonəmani gaɓa nɛnɛ ɓa yo adede nə kəfi gaɓa aɓeku aɓa cwɛ nywɔ nə ba nyinə na dyanə ɓa yo ngwi ɓa sang wa nəni.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />Kə cwa ɓanə,&lt;&lt; U gha lajə ku paca la lasapyang kəfi u cwa yo abaru anuanua yi kwã agang sa nəngwi anvi kupaca. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Paca ngwi nang dyanə ɓa yo ade ngɔn ni, kəfi nəwa botisma ngɔn ni, la pong wa pong; ngwi nangku nyi na dyanə ɓa yo ade ngɔn ni ɛ nəwa tita nə. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />A na ngwi dyanə ni njamu yona nənang yiswe ɓa ː gaɓa ɛ bwanə gwe anjɔ ɓa yaa mənə; gaɓa ɛ cwayo ɓa dang ngɛ ɓa chocho. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Inə gaɓa cwe jwua ɓa gaɓe ɓa ngɔn ni, nəɓa fa ngɛ anjɔ ngɔn ni, kɛ nəɓa nang ngɛ nəla. kəfi ɛ nyang gaɓe sa ngwi nangjwə ɓa ɛ nyɔndi.<verse eid="MRK 16:18" /></para>
  <para style="s">ɓa cwe Yesɔ ngɔn la lankwã</para>
  <para style="r">)<ref loc="LUK 24:50-53">Luka 24.50-53</ref>; Acts 1.9-11&lt;&lt;</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Lazinze nang Daa shayonki Yesɔ cwa ɓanə yonə ni, kəɓa cwewa lwenə gha nə lankwã ghɔ də gaɓe a ɓezhi yi Nyimoː. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Kə nwi nangjwa gɔɓa bwa, nga cwayo anuanua lajeku, Daa shayonki nga nə nangnu ɓaɓa, ngu caɓesa yoade gɔ lasa nang yiswe nang cwa nə ɓaɓa ni.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>