<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">MATU - BANDAWA BIBLE TRANSLATION PROJECT</book>
  <para style="h">MATU</para>
  <para style="toc1">MATU</para>
  <para style="toc2">MATU</para>
  <para style="toc3">Matu.</para>
  <para style="mt1">MATU</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Ka yaa lado Yesɔ Almasihuː ɓa ye</para>
  <para style="r">)<ref loc="LUK 3:23-38">Luka 3.23-38</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />A Kwã nang cwa ya ka daa aganggang Yesɔ Almasihuː, ka lado kwə Dauda, angye nang kanə lado Ibrayi ni.<verse eid="MAT 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MAT 1:2" />Ibrayi mya Ishaku,</para>
  <para style="q2" vid="MAT 1:2">Ishaku mya Yakubu,</para>
  <para style="q2" vid="MAT 1:2">Yakubu mya Yahuda ɓa nwi naa gɔ ɓa.<verse eid="MAT 1:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="MAT 1:3" />Yahuda mya Feresa, ɓa Zera, naa gaɓa ka Tamar,</para>
  <para style="q2" vid="MAT 1:3">Feresa mya Hasruna,</para>
  <para style="q2" vid="MAT 1:3">Hasruna mya Aram.<verse eid="MAT 1:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="MAT 1:4" />Aram mya Amminadab,</para>
  <para style="q2" vid="MAT 1:4">Amminadab mya Nashoo,</para>
  <para style="q2" vid="MAT 1:4">Nashoo mya Salmon.<verse eid="MAT 1:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 1:5" />Salmon mya Boaza, nɛ Rahab, Boaza mya Obida nɛ Rut Obida mya Yesse. <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Jesse mya kwə Dauda. Dauda mya Solomo angye nang nlo naa gɔ kanə gwa wii Uriya ni, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Solomo mya Rehobowam, Rehobowam mya Abija, Abija mya Asa. <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa mya Jehoshafat, Jehoshafat mya Yoram, Yoram mya Azariya. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Azariya mya Jotam, Jotam mya Ahaz, Ahaz mya Hezekiya. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekiya mya Manase, Manase mya Ama, Ama mya Josiya. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Josiya mya Jikoniya, ɓa nwinyɔ ɓa sade nang mu ɓanə gha nə la kəmi Babila.<verse eid="MAT 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 1:12" />La zənze nang ɓa mu nə ngwi Isrela gha nə la Babila niː</para>
  <para style="q2" vid="MAT 1:12">kə Jikoniya mya nə Shayatiyel, Shayatiyel mya Zerubabel.<verse eid="MAT 1:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 1:13" />Zerubabel mya Abihudu, Abihudu mya Eliyakim, Eliyakim mya Azuro.<verse eid="MAT 1:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="MAT 1:14" />Azuro mya Zadok, Zadok mya Akimu, Akimu mya Aliyuda. <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Aliyuda mya Eleyaza, Eleyaza mya matana, matana mya Yakubu.<verse eid="MAT 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 1:16" />Yakubu mya Yusufu ogɔn Maryamu nang mya Yesɔ ni. Angye nang ɓa kwi wanə Almasihuː ni.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Paca lado ɓasɔ njwa cwi nea ni bwa lasa Ibrayi gha nə sa Dauda. La lashi Dauda gha nə sade ɓa munə Isrela ɓa ghanə yido jagi la Babila, lado jwa cwi nea, langle fi ghanə sa Nang mya Yesɔ Almasihuː.<verse eid="MAT 1:17" /></para>
  <para style="s1">Nang Mya Yesɔ Almasihuː.</para>
  <para style="r">)<ref loc="LUK 2:1-7">Luka 2.1-7</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ka nang mya yi Yesɔ Almasihuː yaː Yusufu na vuta sa nɛ Yesɔ Maryamu, ama bako gɔ lu fyewa ni, ku mewa ɓa lanə lasa Yingu Nyimoː. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yonəmani Yusufu nwinwon gɔ ka ngwi adede fi shan la na nawa sako lasa nəngwi ɓa. Kə cheng la sɛgwɔn wa shã na tawa ɓe lakənkən.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Ama gɔ ngə la nang chəng ni, kə maleka Daa shayonki ɓa bwasɔ layi dyɔ kə ya, &lt;&lt;Yusufu gwɔgwɔ Dauda, ɓa yiyi la a cwe Maryamu ngənə gwo yonəmani nwi nang ngə lawa ni ka Yingu Nyimoː. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />U mya Nwi, ka nayɔ Yesɔ yonəmani u pong ngwi gɔɓa lasa nang anjɔ gaɓa.&gt;&gt; <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Nang ɓani ku nə nang ni yona pɛ nang Daa shayonki cwanə la dang ngwi dangdoswɔn ɓa ya; <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;Nwi anəngwa nang nyinə nyənənwon lani u cwe la u mya nwi, ɛ nayɔ wa Immanuwel.&gt;&gt; danfĩ yaa Immanuwel Kəɓənə, &lt;&lt; Nyimoː ngənə ɓɛ.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Sade nang Yusufu lwe nə la yinga ni, ku nənang maleka Daa shayonki cwa wanə ni, kə u cwe Maryamu ngə nə gwa wa. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ama u nyi wanə nyəngwa nla, kə lazənze mya nə nwi ni, kəfi Yusufu nayɔ Yesɔ.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Nang mɓa Ngwi Nyi Byəng Ba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />A mya Yesɔ la Betalami la kəmi Yahudiya, la sapyang nang Hiridu kanə kwə ni, kə ngwi nyi byə̃ng ɓa lwe ɓenwe mɓa la Urshelima <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />kə ɓa byədo, &lt;&lt;laje kəɓa mya nə kwə Yahudawa ɓani ma? Je sang byə gɔ la ɓenwe kə mɓa ɓi nawa gang.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Sadə nang kwə Hiridu wanə na nangni kə yii gwa wa, ɓa ngwi Urshelima ɓaku. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Hiridu ɓwanə nwanye ngwi nyanang ɓa, ngwi maɓesa nangzhĩ Musa ɓa kə ɓyə ɓa yido anwa a mya nə Almasihuː ni. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />kəɓa ye waya la Betalami, la kəmi Yahudiya, yonemani nankenə ngwi dangdoswɔn jwanə. <verse eid="MAT 2:5" /><verse number="6" style="v" sid="MAT 2:6" />Ama gu yii Betalami, la byəng Yahudiya,</para>
  <para style="q2" vid="MAT 2:6">ka kunə a pika la kəmi agang yi yahudiya ɓa, yonemani laloo kə mya ngwi nəgang, angye nang ɛ nyang nə gwɔn sa ngwi gəɓa Isrelawa ɓa.&gt;&gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />kə Hiridu kwi ngwi nyi byəng ɓa sɔ kə byə ɓa jwanjwa, yona u nyi nən laloo ɓa sang nə sɛ ni <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />kə swon ɓa la betalami ku ya,&lt;&lt;bang sang nwi sɔ nəɓwɔ, sade nang u mewa ngɔn ni kə gəmə nyi, yonəmani kə gəmə ma gha nawa gang.&gt;&gt; gema nwami jua.<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />kə gaɓa wanə yo kwə cwanə ni, kəɓa kwenə ɓe. Byəng nang ɓa sang nə la ɓenwe ni ngə la sibe ɓa gaɓa nga kafi wa hakə ɓa ngəmi la yido nang nwi sɔ ngənə ni. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />kə ngwi nyi byəng ɓasɔ sang nə byəng ni kəɓa pɛɓa lanuanua nə. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />kəɓa dyanə layi sɔni kəɓa sang nwi sɔ ɓa naa gɔ Maryamu, kəɓa ngwami la sibe wa kəɓa nawa gang. gaɓa mɓanə nang naa yi nta apyənpyən, kəɓa bwe fuu yenang ɓa mu a nyunyu, ɓa Mur,kəɓa nawa.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Ama ɓa laaɓa do la yi dyɔ ya ɓe fi gha labə Hiridu la,<verse eid="MAT 2:12" /></para>
  <para style="s">Yusufu cwe Maryamu ɓa nwi wa va Kwe Masa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />La zinze ngwi nyi byəng ɓani kwenə ni, kə Maleka Daa shayonki cwayo ɓa Yusufu layi dyɔ. Hiridu nga kədo nwi sɔ na jəwa.&lt;&lt;a lwe,&gt;&gt; cwe nwi sɔ ɓa naa gɔ va gha la Masa a ngə layimɓa sɛ cwowa nə kwe mbe.&gt;&gt;<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />kə Yusufu lwe, cwe nwi sɔ ɓa naa gɔ, ɓa duda nə kəɓa kwe nə Masa, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Yido ludenə hakə Hiridu la wuu nəni. Nangni nənang yonemani nang Daa shayonki cwonə la dang ngwi dangdoswɔn ka yoade yaː &lt;&lt; La masa kən kwida Nwi mə.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">Nanjə nwinjwɔn atwa ɓa</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Sadenang Hiridu nyi nə, ngwi ɓani gwa wa ɓenə ngwi sɛsɛ ni, kə sɛgwɔn wa jwə ku laalɔ kə na dang uya ɓajə nwinjwɔn ɓa ku paca la Betalami ɓa nwi ngwi ɓa denə layimɓa, nwinjwɔn sapyang mba cwe ɓanə kəmi, lasa nang nyi gɔ u nyinə labe ngwi nyi byəng ɓani la sade nang byəng sɔ bwanə ni.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />La məngang ni nang ɓa cwanə la dang ngwi dangdoswɔn Irimiya ɓɛ ade ngɔnː<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />Ba wasa ghɔ la Rama,</para>
  <para style="q2" vid="MAT 2:18">nga lɛlɛ ɓa nyenə,</para>
  <para style="q1" vid="MAT 2:18">Rahila nga lɛlɛ yo nwi ɓa</para>
  <para style="q2" vid="MAT 2:18">kə gɔ shan lana ɓa nawa munye,</para>
  <para style="q1" vid="MAT 2:18">yonəmani ɓa nɛnɛ ɓa wiinə.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s1">Nang Fi gaɓa la kəmi Masa.</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />La zinze nang Hiridu wuu nəni, kə maleka Daa shayonki bwa lasa Yusufu layi dyɔ la Masa. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />kəfi u cwa ya,&lt;&lt; A lwe, cwe nwi sɔ ɓa naa gɔ a gha la byəng Isrela, yonəmani ngwi ɓa nga shana cwe nə wii nwi sɔni ɓa wuu ngɔn.&gt;&gt; <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />kə u lwe, cwe nwi sɔ ɓa naa gɔ kəɓa kwe nə byəng Isrela.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Ama sade nang Yusufu wanə Arkilayus pyɛ̃ shi daa gɔ Hiridu ni, ngu nə gang la kəmi Yahudiya, kə u yiyi na dyado la yidosɔ. Ama ɓa cwa yonə la yidyɔ, kə gɔ gangnə la kəmi Galili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />kə gha də la yii məngɛ nga kwi nə Nazare, kəfi nankənə nang cwanə sa ngwi dangdoswɔn ɓe ade ngɔnː&lt;&lt;ɛ kwi wanə ngwi Nazare,&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Yohana wanə Botisma Ma Mengang</para>
  <para style="r">)<ref loc="MRK 1:1-8">Maku 1.1-8</ref>; <ref loc="LUK 3:1-18">Luka 3.1-18</ref>; <ref loc="JHN 1:19-28">Yohana 1.19-28</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />La sade sɔ Yohana wa nə Botisma mɓa ngu cwayo anuanua la lapɛdo Yahudiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />kə cwa ya, &lt;&lt;u tubi, yonəmani donyang lankwã zədo ngɔn.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohana ka kɔnə ngwi nang ngwi dangdoswɔn Ishaya nga cwanə yo lashi wani sade nang cwanə yaː</para>
  <para style="q1" vid="MAT 3:3">Ngwi ngənə nga cwayo la lapɛdo,</para>
  <para style="q1" vid="MAT 3:3">&lt;maɓəsa məngan yo Daa shayonki,</para>
  <para style="q2" vid="MAT 3:3">tã wo məngan nə tãtã yona zha yimɓa.<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />nangja Yohana ɓa ma ɓa ndẽ joroba, ɓa se dwə gashi. nang tang gɔ ka gã ɓa dibi fɛ̃ <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ngwi ɓa nang ɓanə la Urshelima ɓa ngwi Yahudiya ɓa byəng nyi Urdu ɓa. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Nga cwa nang anjɔ gɔɓa, nga nəɓa Botisma nə la dangdi Urdu.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ama Yohana sang nang bya Farisawa ɓa Sadukiyawa nga ɓa yona nəɓa botisma nə kə cwa ɓa nə ya,&lt;&lt; gua jwa fyafya ɓaǃ ka nwa lodo, va sa lɔni nga ɓani ma? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Unə nang la ghabe nə yee gua tubi ngɔn, <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />ɓabu cheng ɓa lashiwa nə yee, &lt;Ibrayi ka daa gua la,&gt; Gəmə ngə cwo wanə, Nyimoː la lwe nə nta ɓani kəfi ɓe lado Ibrayiǃ <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Nyimoː gə̃mɓe nyang dwon gɔ ngɔn la zəshi, shi a nwaku nanə fa ade lani ɛ kə̃wo tami, ngɔn ni ɓa chawo la va. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;Ngə nə botisma ɓa dibi na nang caɓenə ya gua tubi ngɔn, ama ngwi la mɓanə zinze mə ɓeɓe ni ɛ nəwa botisma ɓa Nyingu Nyimoː ɓa va. Gɔ gang tamənta; kəfi gəmə zanla na cwewa tɔ gɔnə ko vĩ se tɔ gɔ. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Nkwasɔ shan nang gɔ, ngə la ɓewa, lu shanə nanpang ni, uyee nanpang ade ɓa la la byee gɔ, ama gɔ u zwe munang ɓa va nang la kanə lani.<verse eid="MAT 3:12" /></para>
  <para style="s1">Anə Yesɔ Botisma nə</para>
  <para style="r">)<ref loc="MRK 1:9-11">Maku 1.9-11</ref>; <ref loc="LUK 3:21">Luka 3.21</ref>,<ref loc="LUK 3:22">22</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Kə yesɔ ɓa la Galili, ngu gha dang di Urdu labe Yohana yona nəwo botisma nə. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ama Yohana shan la na nəwa botisma . Yohana cwa ya&lt;&lt;Gəmə ngə shãna gu a nəmə botisma nə, kəfi aɓa la bemə maǃ&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Ama Yesɔ dya wanə, &lt;&lt;avya nə ngə nankənə ɓeɓeni. la məngang ni kə je li nənang Nyimoː nga shãn nəni.&gt;&gt; kəfi Yohana dyanə.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />La zinze anənə Yesɔ Botisma nəni, kə bwanə la yidi ni, kə lankwã ɓa bwe, kə u sang Yingu Nyimoː nga sa na zho nə nga selashi wa. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />kəfi lagho ngɛ la lankwã ya, &lt;&lt;ka nwi mə ashanshan, angyə gəmə ngə shã nəni, angye gəmə wanua məni.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Nang Ma Yesɔ</para>
  <para style="r">)<ref loc="MRK 1:12">Maku 1.12</ref>,<ref loc="MRK 1:13">13</ref>; <ref loc="LUK 4:1-13">Luka 4.1-13</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Kə Yingu ghanə Yesɔ la lavi yona Shetan mãwa <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />La zinze nang Yesɔ zhĩ lo gwe ka mba, la duda ka mba kə nywe gwa. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Ngwi fundang nəngwi ɓa sɔ yee, &lt;&lt;Na ka nwi Nyimoː ni, a nadang sa nta ɓani a ɓenə nwa.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesɔ cwa wanə yee, &lt;&lt;ɓa jwanjwa la kwã Nyimoː ya, nəngwi la cwido ɓa nang tang la, se yo nang nga ɓwanə la sidang Nyimoː ni.&gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Nankənə kə Shetan cwe Yesɔ ghanə yi agang Urshelima a tẽtẽ, kə ghɔnə shi nywi agang do pẽdang. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />&lt;&lt;Kəfi cwa wanə ya, Inə aka nwi Nyimoː ni,&gt;&gt; taɓe so ɓa gu kəmi, yonemani a jwa la lakwã Nyimoː ya,</para>
  <para style="q1" vid="MAT 4:6">&lt; Nyimoː ɛ nyang maleka gɔ ɓa nyangwo sɔ,</para>
  <para style="q2" vid="MAT 4:6">Gaɓa ɛ cwo ghanə lankwã ɓa gaɓe ɓa,</para>
  <para style="q2" vid="MAT 4:6">gagwo kɛ gba sa nta la.&gt;&gt; <verse eid="MAT 4:6" /><verse number="7" style="v" sid="MAT 4:7" />Yesɔ dya wanə, &lt;&lt;Ama kwã Nyimoː mafi cwa ya, &lt;ɓa ma daa shayonki Nyimoː la.&gt;&gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Kəfi shetan cwe wa ghanə lasa nta a cwonshi kə cɔɓe sa yido nəgang yi lasapyang kupaca ɓa gang gaɓa nə. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Shetan cwa yee, &lt;&lt;Nang ɓani ku Gəmə ngə no,&lt;&lt; inə gu afi nwakəmi a nəma gang ngɔn ni,&gt;&gt; <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Kə Yesɔ dyanə ya,&lt;&lt;kwe vya mə Shetanǃ kwã Nyimoː cwa yee, &lt;Ana gang sa Daa shayonki Nyimoː gu ajagi gɔnə ɓansɔ.<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />kə Shetan vyawo, kə maleka mba keɓa no nangnu nə.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesɔ fudi Na Cwa Yo Nyimoː la Galili )Maku 1.14,15; Luka 4.14,15&lt;&lt;</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Sade nang Yesɔ wanə soje Hiridu tanə Yohana la fusina, kə fi kwe Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Kə vya Nazare, fi gha də la kafarnahu, la ɓe dangdi kəmi Zebulun ɓa kəmi Naftali, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />yona pɛ nang ngwi dangdoswɔn Ishaya cwa nəni, <verse eid="MAT 4:14" /><verse number="15" style="v" sid="MAT 4:15" />kəmi Zebulun ɓa kəmi Naftali, ngə la məgang dangdi a gang, ɓa byəng dangdi Urdu, Galili, ɓa kəmi ngwi nang ɓa kanə Yahudawa ɓa lani.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Ngwi ɓa ngənə la yi davu ni</para>
  <para style="q2" vid="MAT 4:16">ɛ sang do a tẽtẽ agang.</para>
  <para style="q1" vid="MAT 4:16">Lashi ngwi ɓa dənə la kəmi yi davũ yi wii ajədo ni.</para>
  <para style="q2" vid="MAT 4:16">Nyimoː ɛ ɓanə do a tẽtẽ lasa ɓa.<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Sa sade sɔ Yesɔ fudi na cwayo yo anuanua,&lt;&lt; U tubi, yido nəgang Nyimoː zədo ngɔn.<verse eid="MAT 4:17" /></para>
  <para style="s1">Yesɔ kwi ngwi gwa ju ɓa nea )Maku 1.16-20; Luka 5.1-11&lt;&lt;</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Sayi nang Yesɔ nga zhazho la byəng dangdi a gang yi Galili, kə u sang nwina ɓa lenə mba la dangdi agang, kə sang Saminu nang nga kwiwanə Bituru ɓa nwi naa gɔ Andarawu ngə lagwa nga ma kã gaɓa. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesɔ cwa ɓanə yee, &lt;U kafi mə, Gəmə ngə ɓowanə ngwi mɓanə nəngwi ɓa samə. <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ɓabe kəɓa vya kã gaɓa kə kafi Yesɔ.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />kə ngu gha ni, kə sang nwinyə ɓa mba, Yakubu ɓa Yohana nwi Zabadi. Gaɓa ngə la gwa ɓa daa gaɓa nga ma kã gaɓa, Yesɔ kwida ɓa. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Ɓabe kəɓa vya gwa gaɓa ɓa daa gaɓa kəɓa kafi wa.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yesɔ maɓesa nang kəfi nyɔndi Nəngwi ɓa )Luka 6.17-19&lt;&lt;</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesɔ zha la kəmi Galili ku paca, ngu maɓesa nang la yido ɓwa nəshi Yahudawa ɓa, ngu cwayo abaru anuanua Nyimoː lashi yido nəgang Nyimoː kəfi nyɔndi nəngwi ɓa sa nang jwə anwaku. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Kə abaru yo gɔ maje kupaca la kəmi yi Suriya. Nankənə kəɓa mɓanə ngwi wanua saɓa nla nga falaɓyɔ yiri nangjwə ngɛ chocho ni ɓa nang jwə sweː ngwi ɓa ɓanə gwe anjɔ ɓa nəni ɓa ngwi swɛgwe ɓa ku Yesɔ nyɔndi gaɓa kupaca. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Cwi nəngwi ɓa ɓa ɓyagaɓanə kafi wa la Galili, Yiɓa Njwa, Urshelima, Yahudiya, hakə ma byəng dangdi Urdu.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Nang maɓenə yi Yesɔ la shinta</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesɔ sang nə cwi nəngwi ɓani ku gha jenta, layimɓa ku dəkəmi. Nwi nangjwa gɔɓa ɓwanə la bewa, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Ku fudi na maɓa ɓesa nangː<verse eid="MAT 5:2" /></para>
  <para style="s">Do Anuanua ade )Luka 6.20-23&lt;&lt;</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Nyimoː ngə balka sa ngwi ɓa nyinə a saɓa swenə yingu,</para>
  <para style="q2" vid="MAT 5:3">Yonəmani yido nəgang Nyimoː ka yi gaɓa<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Nyimoː nə ngwi ɓa sɛgwɔn ɓa nga jwənə ni balka nə,</para>
  <para style="q2" vid="MAT 5:4">Nyimoː ɛ naɓa munye.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Nyimoː nə balka sa ngwi ɓa nga finə saɓa kəmi ni.</para>
  <para style="q2" vid="MAT 5:5">Gaɓa ɛ mɛ nang lasapyangǃ<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Nyimoː nə balka sa ngwi ɓa nga shana ɓa nə nang adede Nyimoː nga shan ɓa na nənə ni;</para>
  <para style="q2" vid="MAT 5:6">Nyimoː ɛ nəɓa nang nga shani pɛpɛǃ<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Nyimoː nə balka sa ngwi sang laɓyɔ nəngwi ɓa,</para>
  <para style="q2" vid="MAT 5:7">yonəmani gaɓa ma Nyimoː la sang laɓyɔ gaɓa sang.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Nyimoː nə balka sa ngwi sɛgwɔn tẽtẽ ni,</para>
  <para style="q2" vid="MAT 5:8">yonəmani gaɓa la sang Nyimoː sang.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Nyimoː nə balka sa ngwi ɓa nga cwanə yo dodə a jwanjwa,</para>
  <para style="q2" vid="MAT 5:9">ɛ kwi ɓanə nwi Nyimoː ɓa.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Nyimoː nə balka sa ngwi ɓa nga tori gaɓa sa yo adede Nyimoː ni,</para>
  <para style="q2" vid="MAT 5:10">yonəmani yido nəgang Nyimoː ka yi gaɓa.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Nyimoː nə balka soa gua nang nəngwi ɓa nga cwɔwa nə ɓa zhãni, nga tori gua, nga cwa yo dangsa anwaku lashiwa yo nang ngu kafi məni. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />U wanua ɓa sa anuanua nə, yonəmani dangjada gua gang wane la lankwã, na nangni kəɓa tori ngwi dangdoswɔn ɓa gəwo nəbe ni.<verse eid="MAT 5:12" /></para>
  <para style="s">Myɛ ɓa a Tẽtẽ</para>
  <para style="r">)<ref loc="MRK 9:50">Maku 9.50</ref>; <ref loc="LUK 14:34">Luka 14.34</ref>,<ref loc="LUK 14:35">35</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Ka kua nə myɛ lasapyang, ama inə myɛ ganə ɓa nua gɔ ngɔn ni, nəbəɓa la wanə nua ma? U nene ɓa bwatɛ nə, sɛ la yewa gha kə nəngwi ɓa cha ɓa gwe . <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Ka kua nə do a tẽtẽ lasapyang, yii agang nang ɓa manə lashi nta ni la jwaswe nla. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Kɛɓa chava ngɔn ni kəɓa nyang wa la nbwanang la; sɛ la nyang wa shi dodə gɔ, layimɓa kə lu nanə do a tẽtẽ sa ngwi anwaku la layi sɔ. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Nankənə kə lu ngənə do a tẽtẽ sa nəngwi ɓa, yonəmani kəɓa sang azanzan gua ngu nənə kəɓa naa Daa gua gang la lankwã.<verse eid="MAT 5:16" /></para>
  <para style="s">Yesɔ maɓesa yo Nangzhĩ Musa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Bu chəng ya, gəmə mɓa ngəmi yeyo Nangzhĩ Musa ɓa hala nang maɓene yi ngwi dangdoswɔn ɓa la; Gəmə mɓa yona muɓa yehala, ama yona maɓa nyang nə yoade paca. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Ngə cwayo ade nə, lankwã ɓa kəmi la ka, ama ko yo nang ngɛ nso ko byəng ngɛ lapika sa yo nangzhĩ Musa kɛ kwe la, sɛ ɓa pɛ nang anwaku mbe. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Ngwi nanə gang nla lasa dang nangzhĩ angye ngə le pika ni, kəfi ma ngwi ngɛ ɓa sa dang nang zhi ni, ɛ kwi ɓa nə agang la do nyang Nyimoː la lankwã. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ngə cwowa nə,nankənə, gua lu dya yido nəgang Nyimoː inə yoadəde gua tayi ngwi maɓesa nangzhĩ Musa ɓa farisawa ɓa, sa nang Nyimoː nga shanə na nəni.<verse eid="MAT 5:20" /></para>
  <para style="s">Yesɔ Maɓesa Nang sa yo lɔ )Luka 12.57-59&lt;&lt;</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt; Gua wa ngɔn nga cwa daa aganggang je ɓa nə yee, bu jə nəngwi la, &lt;Ngwi nang jə nə ngwi ngɔn ni, ɛ no tita nə.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ama ngə cwo wanə, ngwi nang lanlɔ ɓa nwi nyəwo ngɔn ni, ɛ no tita nə, na ngwi kwi nwi nyəwo nə nayinse, ɛ dya wanə layi do nə tita. Ama na ngwi nang kwi nwi nyəwo ne wasɛsɛ ngɔn ni, &lt;ɛ chawa lava anjɔ.&gt;&gt; <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Nankənə ni, inə ana nang naa sa Nyimoː ni la yido nyanang, layimɓa kə a chəng ko aɓa nang ngɛ tanto aɓa nwinyu, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />A vya nang naa gu la sibe do nyanang. A gha wanə ɓa nwinyu jwanjwan mbege; ka fi mɓa na nang naa gu sa Nyimoː. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />&lt;&lt;a gəmbe Wanə ɓa ngwi leku gu la məngang, nankəbe lani cwo gha nə na ngwi tita, ngwi nə tita cwo gha na ngwi swala, ɛ cwo gha tala fusina. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Ngə cwo yoade nə, mbegə abwa nə se awon shede nang nga ka soni ku paca.<verse eid="MAT 5:26" /></para>
  <para style="s1">Yesɔ Maɓesa yo ndãng</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Ngu wa nga yee,&lt;Bo nga ɓa gwa ngwi ngɛ la. <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ama ngə cwo nə yee, ngwi nang sang nə nyənəgwa hakə chəng yo na ngaɓɔ ngɔn ni u nə ndãng ngɔn. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Nankənə inə zayi aɓezhi gu nga nɔ ayibe ni alwɔ aca gha, zezan a gha ɓa zayi nə nso layi Nyimoː ama ɓa gha ɓa so nəku la va la. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Nə gaɓo yi ɓezhi nga nɔ ayibe ngɔn ni, kə̃ wa ca gha. zezan a gha ɓa gaɓe nə nso layi Nyimoː ama ɓa gha ɓa so nəku la vala.<verse eid="MAT 5:30" /></para>
  <para style="s">Nang maɓenə yo nang gaa Yifye</para>
  <para style="r">)Matu 19.9; Mark 10.11,12; <ref loc="LUK 16:18">Luka 16.18</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt;Ba cwa nankənə ya, inə ngwi nang ku ganə ɓa gwa wa ngɔn ni unawa kwã gayi fye. <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ama ngə cwo wanə ɓeni ya, inə ngwi nang ku tanə gwawo be ngɔn ni, se u gwa ɓa ngwi ngɛ, nankəbə uɓenə gwa wa ɓe ngwi nə ndã. ngwi nang ku fyenə ngwa nang atawa nə ɓe ngɔn ni u nə ndã ngɔn.<verse eid="MAT 5:32" /></para>
  <para style="s1">Yesɔ cwa yo Shi na ngɔn</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt; Kəfi gua u wa ngɔn ɓa cwa nəngwi ɓa nə ɓa ja gɔnə,&lt;Ba bu gbəng nang ngɔn la, ama u nyangwo sa na ngɔn gua sa Daa shayonki <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ama ngə cwo wanə, ɓa bu ghɔ nang la ko la pikaː ko ɓa lankwã, ka dodə yi Nyimoː. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Ko ɓa kəmi, kayi dɔ nyang gagwe yi Nyimoː, ko la Urshelima, yonəmani kəɓə nə yi agang yi kwə agang. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ba ghɔ nang ɓa lashiu nəla, yonə mani ka ba gwaji lashiu aɓenə wanvi ko wanbi la. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Nang gua lu nəni kə ya 'də' ngɔn ko 'dənla', nang kwenə nankənə ngɔn ni bwala be ngwi angjɔ.<verse eid="MAT 5:37" /></para>
  <para style="s">Yesɔ maɓesa nang lashi nəngwi nunang anonə</para>
  <para style="r">)<ref loc="LUK 6:29">Luka 6.29</ref>,<ref loc="LUK 6:30">30</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />&lt;&lt;gua wa nga cwo wanə ya. ngwi nang ku twonɓe sa zayu ngɔn ni, a twonɓe sa yigɔ, kəfi nyii ɓa nyii .&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ama ngə cwo wanə, bo nyi ngwi anjɔ. Inə ngwi ngɛ gba ntancwẽ ɓa be ngɔn ni gwa anso be nawa gba. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Na ngwi nga shana leku gu, yona cwe nang ja gu ni,vyawa nang dang swe gunə. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Inə ngwi ngɛ gwa ɓa njamu nə zhazho ɓa jagonə, mile nso, gha ɓa wa meli mba. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nə ngwi nang ju nang ngɛ ngɔn ni, ana wa; sade nang ngwi kãnə kuu ngɔn ni, ana wa.<verse eid="MAT 5:42" /></para>
  <para style="s">Ashang Ngwi Shĩgu</para>
  <para style="r">)<ref loc="LUK 6:27">Luka 6.27</ref>,<ref loc="LUK 6:28">28</ref>,<ref loc="LUK 6:32-36">32-36</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;U wa ɓa cwa ngɔn ya, &lt;Ashan ngwi dodə gu a shi ngwi shi gu. <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ama ngə cwo wanə, a shãn ngwi shĩ gu, a pɛdang sa ngwi nang ɓa nyang nə va ganə ni. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Yonəmani, kə ɓenə nwi daagu la lankwã ni. Kə nyang lo gɔ nga pe lashi ngwi anjɔ ɓa ngwi ade ɓa. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Na shan ngwi nang nga shanə ni, kanə nə bwatɛ a wa amɛ ma? Ngə na ngwi mu shede lidi lama? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Kəfi inə ka nwinyu wakə nga yaɓa doni, kanə a nə kwe nə sa ngwi ngɛ ɓa ma? Ko ka ngwi ɓa nang nyi nə Nyimoː nla ni la nə nankəbə nə lama? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />U nə nang ade, na nang daa gua la lankwã nga nəni.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Yesɔ maɓesa ya naa Ngwi ɓa nga shan ni</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;U nə akilo bu dya nangnu Nyimoː gua ngə nə yi sang zayi la. yonə mani inə unə nankənə ngɔn ni, gua kume bwatɛ gɔ la sa Nyimoː Daa gua la lankwã ni la. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Nankənə na ngwi ɓa nga shãni, bo bwonku na ngwi sadanɓa nga nənə la la nywi pɛdang ɓa məngang yona nəngwi ɓa bwɔng ɓa. Ka yoade ngə cwonə, a gəmbe a mə lada gaɓa ngɔn. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ama inə ana ngwi laɓyɔ nang ngɔn ɓa dyanə ko ndo ma ngənə ɓɔni ɓe nyila. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Nankənə a naa nang gu jwɔn jwa, daa gu wa ngə sang nang ngu nə jwɔn jwa ni, Nyimoː la ogɔn wo.&gt;&gt;<verse eid="MAT 6:4" /></para>
  <para style="s">Nang maɓesa lashi nang Pɛdang</para>
  <para style="r">)<ref loc="LUK 11:2-4">Luka 11.2-4</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt; Inə pɛdang ngɔn ni, bu ngə na ngwi jwela ɓa ɓanə la, yonemani nga shã nang ngə ɓa lankwã la nga pɛdang la yido ɓwa nəshi Yahudawa ɓa dang məngang, kə nəngwi ɓa sang ɓa. Ngə cwo yoade nə, ɓa gəmbe mə danjada gaɓa ngɔn la lasapyang. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ama inə a pɛdang ni, a dya la nywi gu agũ dang nywi ka pɛdang sa daa gua, ngə nə lankwã ni, daa gua ngə lankwã ni nga wa nang ju gua unua dang jade gua. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />&lt;&lt; Sade nang nga pɛdang ni bo bwonku dwandwa la, na ngwi ɓa nyinə Nyimoː nlani, sa nang cheng gaɓa nga sanya Nyimoː gaɓa ɛ wasa yo aɓyɓya gaɓa. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Bo ngə na kaɓa nə la, yonə mani daa gua nyi nang gua ngu shani ngɔn, mbegən ma ku jua.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />&lt;&lt; Na, nang ni, kə gua lu pɛdangː</para>
  <para style="q1" vid="MAT 6:9">daje la lankwã,</para>
  <para style="q2" vid="MAT 6:9">kwi yo tẽtẽ.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Mbe yido nəgang Nyimoː mɓa,</para>
  <para style="q1" vid="MAT 6:10">na nang shan gu də la lasapyang</para>
  <para style="q2" vid="MAT 6:10">na nang ngənə la lankwã ni.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />A ne nang tang lalo.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />A yafi ayibe jenə,</para>
  <para style="q2" vid="MAT 6:12">na nang jema ngə yafi nə ngwi ngɛ ɓa nang nga nɛnə ayibe nəni.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Ba ghenə sa nang mado la,</para>
  <para style="q2" vid="MAT 6:13">ama bwenə sa nang anjɔ. <verse eid="MAT 6:13" /><verse number="14" style="v" sid="MAT 6:14" />Yonəmani nə gua u yafi nəngwi ɓa ayibe gaɓa ngɔn ni, daa gua la lankwã ma la yafi nə gua. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ama nə gua yafi nəngwi ɓa ayibe gaɓa nla ni, daa gua la lankwã ma kə yafi gua nəla.<verse eid="MAT 6:15" /></para>
  <para style="s1">Maɓesa Nang Zhĩ Loː</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Inə ngu zhĩ lo ngɔn ni,&gt;&gt;Bo dwə sibowa na ngwi jwela ɓanə nga nənə ni la, gaɓa nga dwə sibe ɓa, yona chaɓe saɓa sa nəngwi ɓa ya gənə ɓa ngənə shĩ lo. ngə cwo yoade nə ɓa mə dang jadɛ gaɓa ngɔn. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ama ngu zhĩ lo ni fãmu lashũ wa ɓa sibowa. <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />Yonəmani nəngwi ɓa ɓe nyi gu nga zhĩ lo la. Ama daa gua la lankwã ni sang nang gua ngu nəni ngɔn, fi daa gua, nang sang nə nang awaku ni, u nua dang jada gua.<verse eid="MAT 6:18" /></para>
  <para style="s1">Nang Nyang Nangme la lankwã )Luka 12.33,34&lt;&lt;</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Ba bwa lashiu nangmɛ nə la lasapyang la, yido nang nbwəbwə ɓa la jani, yido nang ngwi nang yiɓa la yi ni. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ama bwa lashiu nangmɛ nə la lankwã, yido nang nbwəbwə kɛ janə lani, yido nang fi ngwi nang nyi kə yinə lani. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Yonəmani yido nang nangmɛ gu ngənə layi mɓa ni, kə sɛgwɔn ngə mba.<verse eid="MAT 6:21" /></para>
  <para style="s">Zayi kəbənə atẽtẽ yi swe )Luka 11.34-36&lt;&lt;</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Zayi ngə na nang chava swe nə, inə zayi ɓa njamu nəni, paca soma pe ɓa doatẽtẽ nə <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ama inə zayi zanla ni swe ku paca ngə la yindavũ. inə doatẽtẽ ngə sɔ ngɔn ni kayi yindavũ ngɔn ni, kəbəɓa nang jwə yindavũ sɔ ngənəǃ<verse eid="MAT 6:23" /></para>
  <para style="s1">Nyang Sɛgwɔn Sa Daa Shayonki )Luka 16.13; 12.22-31&lt;&lt;</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Ngwi ngɛ nene la nə nangnu ɓa nshayi mba nla; ko a shãn nso, a nyi nso, ko nyang sɛgwɔn sa nəngwi nso sheng nso. kə ba nə nang nu Nyimoː ɓa shede la.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />&lt;&lt;Nəkəɓənə kə gəmə cwo wanə bu cheng yo nang gua lu tang nə ɓa nang lu fani ɓa nang jaswe ɓa, yonki kwe sa nang tang lama; kəfi soa kwe sa nang jaswe lama? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />U sang nwizhi ɓa mana, la zwa nang la la shã nang la ɓa nene ɓa byənə ɓa kəbənə ku, daa gua la lankwã nga tang ɓanə kwe sa ɓa. <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ka nwa la tangtowa, lasa nang cheng gɔ, u ba twashi lashua məncwon yonki wa nə ma? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />&lt;&lt;Ka yonə ngu chəng yo nang jaswe ma? U sang mu shĩ ɓa la lavi nga gang ni mana, la nə nangnu ngɛ la, la ja nang ngɛ la. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Ama gəmə ngə cwowa nə Konte Solomo ma ɓa gang gɔnə, ɓa nang maswe gɔnə ku u kwe sa nso gaɓa nla <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Inə Nyimoː la nə vĩ lavi ɓa ma ɓa zan gaɓa nə, nankənə angye ɓa ngənə nwiza ɓa dokwã ni, ɛ zwe ɓa bale gua, yonə kə yoade ngə lapika ma? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />&lt;&lt;Nankənə ni bu cheng yo yaː &lt;Laje kə nang tang je la mɓanə ma? Ko nang faa je ma? Ko nang jaswe je ma?&gt; <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ka nang ni kə nyang ngwi ɓa nyinə Nyimoː nlani nga chəng, ama daa gua la lankwã gəmbe nyi nang ɓa ngu shãni ngɔn ku. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Akã yido nəgang Nyimoː gəmbe kwe sa nə ku, kanə nang Nyimoː nga shan nəni, kəfi gɔ u nuwa nang ɓa ni kupaca.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />Nankənə bu cheng yo dokwã la, yonəmani dokwã ɛ ɓanə nang cheng gɔ. Laɓyɔ nwiza masa nwiza ngɔn.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Bunə ngwi ngɛ Tita Nəla</para>
  <para style="r">)<ref loc="LUK 6:37">Luka 6.37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt;Ɓɔnə ngwi ngɛ tita nə la, yonəmani gua ma la noa tita nə. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Yona ɓa tita nang unənə nəngwi ɓa nəni, nankənə gua ma ɛ nua nə. ɓa tasɔ nang uma nə Nəngwi ɓa nə ni ka kəbe ɛ mowa nə.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt;Ka yonə nga sang yimwe la zayi nwinyu ama nyang gwon sa ntũtũ shi la zayi ni lama? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Bəɓa kə la cwa nwinyu nə,&lt;Avya mə nowa nə yimwe la zayu,&gt;Kəfi gu aɓa ntũtũ shi nə la zayu ma? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Gu ngwi jwelaǃ A gəmbe cwi nə ntũtũ shi zayu mbe ka mə sang do nəɓwɔ ka cwinə yimwe la zayi nwinyu.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Bo na nwinja ɓa nang tẽtẽ ni la; bo cha andale nta apye pyen ade gua nə la. yona cha ɓagwe a bwon, kəfi ɓe bowa le pikapika.&gt;&gt;<verse eid="MAT 7:6" /></para>
  <para style="s1">U Byədo, u kã, u gba</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />U byədo la noa na, u kã lu mɛmɛ. U gba dang nywi la bwo wane bwe. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Ngwi nang ku byənə do ngɔn ni ɛ nawa, ngwi nang ku kã nəni u mɛmɛ; fi la sɔ u gba ɛ bwe wanə bwe.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />&lt;&lt;Ka nwa la tangto wa inə nwi wa byədo nwa ngɔn ni lu nawa nta ma? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Konə u byədo nwinju ngɔn ni, ku nawa jwa ma? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Gua nang, u kanə ngwi ayibe ɓani, u nyi nang ngu nanə nwu wa zanzan ni, kəfi Daa gua la lankwã ɛ noa nang ɓa zanzan ni, sa ngwi ɓa nang nga junə ni. <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />U nə nəngwi ɓa nang ngu shana ɓa nunə ni, gua ma nə ɓa nə, nang ni kəbənə nang cheng yo nangzhĩ Musa ɓa ngwi dangdoswɔn ɓa.<verse eid="MAT 7:12" /></para>
  <para style="s">Dang nywi a pĩpĩ</para>
  <para style="r">)<ref loc="LUK 13:24">Luka 13.24</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Dya dang nywi pĩpĩ, yonemani dang nywi pyapya nga gha la yi yenang, kə nəngwi ɓa ɓyagɔnə gwa layimɓa. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ama dang nywi la ghɔnə yido yonki, kə dang nywi pĩpĩ kəɓə nga gha nə nəngwi ɓa la yido mɛ yonki, ka nəngwi ɓa ɓyala nga gwa layimɓa.<verse eid="MAT 7:14" /></para>
  <para style="s">Shi ɓa Fagɔ</para>
  <para style="r">)<ref loc="LUK 6:43">Luka 6.43</ref>,<ref loc="LUK 6:44">44</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Unə akilo ɓa ngwi dangdoswɔn dansa ɓa, nga mba soa ɓa kwa ngang nə ama kpo ɓa a ka nwinja lavi. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Lasa fagɔ kə la nyi ɓanə, ngə nə nəngwi ɓa la kwã fashi ajinji la sa shi kũ la ko fa nzu lasa shi kuntan ma? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Nankənə shi azanzan nga bwanə fashi azanzan, shi nang zan lani nga bwanə fashi nang zanla ni, <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />shi azanzan kə bwa nə fa shi anjɔ la, shi anjɔ kə bwanə fashi azanzan nla. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Shi nang ku la bwanə fashi azanzan lani, ɛ tewa a cagha la lava. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Nankənə kə lu nyinə ngwi dandoswɔn dansa ɓa nangnu gaɓa nə.<verse eid="MAT 7:20" /></para>
  <para style="s">Gəmə mɛdi nyuwa nla</para>
  <para style="r">)<ref loc="LUK 13:25-27">Luka 13.25-27</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Ka nwaku kə la yee Daa shayonki, daa shayonki, kə la dyanə yido nəgang Nyimoː la lankwã la ama ngwi nang nə nang Daa shan ni. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Sade nang Lalo nə tita ɛ mɓa ni nəngwi ɓa ɓa ɓyagaɓa nə ɛ cwa mənə ya, &lt;Daa shayonki, Daa shayonkiǃ&gt; ɓa yonə je cwayo doswon Nyimoː ɓa, ɓa yonə lama i bi gwe anjɔ ɓa yonə je bwanə gwe anjɔ ɓa kəfi nə nang yiswe ɓa ɓyagɔnə&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Nang ni ngə cwa ɓanə yee, &lt;Gəmə mɛdi na nyiwa nla. vya məngang gə, gua ngwi anjɔ ɓa.&gt;<verse eid="MAT 7:23" /></para>
  <para style="s">Ngwi ma nang ɓa mba</para>
  <para style="r">)<ref loc="LUK 6:47-49">Luka 6.47-49</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Nankənə ngwi nang ku wanə yo geni, u nə nə nangnu ɓa kəbənə ngɔn ni, ngu ngə na ngwi nyi nang nə angye nang manə layi gɔ lashi nta ni. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Kə di sə ni, kə dang di ɓa pɛ, kə gwe lwe ɓa gba layi sɔ, ama layi gu nla, yonəmani ɓa ma yi sɔ lashi nta. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Ama ngwi nang ku wanə yo gə ɓa ngɔn ni, u nyi na nə nangnu ɓa kəbənəni, u ngə na ngwi sese nang manə layi gɔ la yiwi ni. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Di anana ɛ senə kəmi kə dangdi pɛ, kə gwe lwe gha gba layi sɔ kə layi sɔ yɛ, kə gu nə nang gu anjɔ.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="s">Yesɔ ɓa njamu gɔnə</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Sade nang Yesɔ yənə shi nang cwayo ɓani kə cwi nəngwi ɓa yiyi sa nang maɓəsa yo gɔ. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Yonəmani ngu maɓa ɓənə na ngwi maɓesa nang yo nangzhĩ Musa la ama ɓa njamu nə.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesɔ Nyɔndi Ngwi Nang Jwə vaa Swe</para>
  <para style="r">)<ref loc="MRK 1:40-45">Maku 1.40-45</ref>; <ref loc="LUK 5:12-16">Luka 5.12-16</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Sadenang Yesɔ sənə kəmi la shi nta ni, kə cwi nəngwi ɓa kafi wa. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ngwi ngɛ ngənə nga tori ɓa nangjwə vaswe nə mɓa bewa, ku ngwami labe wa ku cwanə ya, &lt;&lt;Daa shayonki, inə dyanə ngɔn ni a ɓesamə a nyang zanzan,&gt;&gt; <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Yesɔ tã gaɓe wa kə twɔnɓe sa ngwi sɔ u ya,&lt;&lt;Gəmə dyanə ngɔn, gɔ ya. &lt;&lt;a nyɔndi &gt;&gt; Ɓabe kə vaswe gɔ kanə. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Kə Yesɔ cwonə ya, &lt;&lt;Awa saməǃ Ba cwa ngwi ngɛ nang monə ni la, ama gha chaɓe so sa ngwi nyanang ɓa, a nə nankənə ngɔn ni nəngwi nə shedaku gu ya so tẽ ngɔn, naa nang nyanang gu na nang Musa cwa nəni.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s">Yesɔ nyɔndi nwinfɔ yi nwanye soje Roma</para>
  <para style="r">)<ref loc="LUK 7:1-10">Luka 7.1-10</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Sade nang Yesɔ dyanə kəmi kafarnahu ni, nwanye soje Roma mɓa bewa, ɓu ju wa yona gɔ bali gɔː <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt; Daa shayonki, nwinfɔ gə nga layi, uba lu zhãzho nla ngu fa laɓyɔ ɓa jwəgɔnə.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesɔ cwonə yee, &lt;&lt;Gəmə ɛ gha ngə nyɔndi gɔ.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Kə nwanye soje Roma dya wanə ya, &lt;&lt;Daa shayonki, gəmə gha nla na gu a mɓa layi gə, ama a nadang ngɔn ni nwinfɔ gə ɛ nyɔndi. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Gəmə ma, ngə la yinjwə njamu ngwi ngɛ ɓa nə nwanye gə, kəfi gəmə ma soje ngɛ ɓa ngəla yinjwə gə, gəmə nadang sa ngwi ngɛ, &lt;ya gha ngɔn niǃ&gt; ku gha; kəfi nadang sa ngwi ngɛ, &lt;Ya a mɓa ngɔn niǃ&gt;ku mɓa; kəfi nadang sa nwinfɔ, &lt;Nə nangni ngɔn niǃ&gt; ku nə.&gt;&gt; <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />sade nang Yesɔ wanə nangni kə nang chəng gwa wa kə cwa ngwi ɓa nga kanə fiwa ni, &lt;&lt;Gəmə ngə cwo wanə gəmə mɛdi na mɛ ngwi ngɛ la Isrela ɓa yoade nə na nangni nla. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Gəmə ngə cwo wanə nəngwi ɓa ɓa ɓyagaɓanə ɛ mɓa byəng ɓenwe ɓa ɓegwɛ, kəɓa dəmi ɓa tang nang ɓa Ibrayi, Ishaku, ɓa Yakubu la yido nəgang Nyimoː yi lankwã. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ama ngwi ɓa nang ngənə la yido nəgang Nyimo niː ɛ chaɓa ntẽ la yindavũ, layimɓa gaɓa ɛ lɛlɛ nga gwa nyi ɓa. <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Kə Yesɔ cwe nwanye soje Roma, &lt;&lt; Gha layi, ka nang a dyanə ɓa kənə ni ɛ nunə.&gt;&gt;</para>
  <para style="p" vid="MAT 8:13">Kə nwinfɔ nwanye sɔ nyɔndi ɓa begə.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesɔ nyɔndi nəngwi ɓa ɓyagaɓanə</para>
  <para style="r">)<ref loc="MRK 1:29-34">Maku 1.29-34</ref>; <ref loc="LUK 4:38-41">Luka 4.38-41</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Kə Yesɔ dya layi Bituru, kə layimɓa ku sang nɛ gwa Bituru nga wasaga. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Ku twɔnɓə sa gaɓe wa kə saga sɔ vya wa, ku lwe fudi na nəwa nangnu nə <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />kə logwanə ni, nəngwi ɓa ɓyagaɓanə nga mɓa nə ngwi ɓa ɓanə gwe anjɔ nə saɓa ni. Yesɔ ɓwanə yingu gwe anjɔ ɓa yo a cwa kəfi nyɔndi paca ngwi nangjwə ɓa. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />U nənang ni, yona pɛ nang ɓa cwanə la dang ngwi dangdoswɔn Ishaya ya, &lt;&lt;Gɔ ɓa lashiwa nə cwe nangjwə je ɓa nangjwə anjɔ je.&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s">Nang kasa Yesɔ juha</para>
  <para style="r">)<ref loc="LUK 9:57-62">Luka 9.57-62</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Sade nang Yesɔ sang nə cwi nəngwi ɓa, kwon wanə tãla ni ku nadang sa nwi nangjwa gɔɓa yona gandi gha la byəng dangdi ngɛ. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />kə ngwi maɓesa nangzhĩ Musa ɓa mɓa bewa. ku cwa ya, Ngwi maɓesa nang&lt;&lt;Gəmə maɓe samə ngɔn na gha ɓo ko laje ku nga ghani.&gt;&gt; <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />kə Yesɔ dya wanə ya,&lt;&lt;Nwinja lavi aɓa jwe gaɓa nə, kəfi nwinzhi aɓa do nga gaɓa nə, ama nwi nəngwi nene ɓa yido nang lu nganə lu winəsɔ ni.&gt;&gt; <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Ngwi ngɛ ngənə la tangte nwi nangjwa gɔɓa, cwa ya, &lt;&lt;Daa shayonki, mbe gəmbe fi gha di daa gə.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Ama Yesɔ dya wane ya, &lt;&lt;kafi mə,&gt;&gt;vya ngwi awuu wuu ɓa di ngwi awuu wuu gaɓa.<verse eid="MAT 8:22" /></para>
  <para style="s">Yesɔ ngənə gwe di agang</para>
  <para style="r">)<ref loc="MRK 4:35-41">Maku 4.35-41</ref>; <ref loc="LUK 8:22-25">Luka 8.22-25</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Kə Yesɔ dyanə la gwa kə nwi nangjwa gɔɓa kafi wa. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Kə ɓabegə gwe di agang lwe la shi di, kəfi gwa sɔ nga zən la yidi. Ama Yesɔ nga ngayinga. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Nwi nangjwa gɔɓa gha sawa kə lwewanə. &lt;&lt;kəɓa cwa ya, Daa shayonki a pong yonki je.&gt;&gt;&lt;&lt;Je zədo ngɔn na wuuǃ <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Kə Yesɔ cwa ɓanə ya, &lt;&lt;Ka yonə gua ngu yiyi ma? Ka yonə kə yoade gua nə lapika ma?&gt;&gt; Kə u lwe nadang sa gwe ɓa di layimɓa gwe ngənə kəmi. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Nwaku sayi gwa wa. &lt;&lt;Kəɓa cwa ya, ka yiri nəngwi anwa ye ma?&gt;&gt; &lt;&lt;Ko ka gwe ɓa di ma nga na gang sawaǃ&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">Yesɔ nyɔndi ngwi gwe anjɔ ɓa mba</para>
  <para style="r">)<ref loc="MRK 5:1-20">Maku 5.1-20</ref>; <ref loc="LUK 8:26-39">Luka 8.26-39</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Sade nang Yesɔ mɓanə la byəng Garasinawa la dangdi angɛ, ku mɛ nyənəngwo ɓa nən mba nga mɓa la yido nang nga dinə wii ni. Nyənəngwo ɓani aɓa gwe anjɔ nə la saɓa kəfi ɓa ɓenə nang yiswe hakə ma ngwi ngɛ kə ba gwa məngang sɔla. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Kə ɓabegə kə fudi na lɛku, &lt;&lt;kanə yarije ɓo, gu nwi Nyimoː ma? Ko mɓa yona nɛ laɓyɔ mbe kə məncwon nə ma? <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Ba janə latwa la yido cwi andale ɓa nga tang nang ni. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Kə gwe anjɔ ɓa ju Yesɔ, &lt;&lt;Inə gu a bwenə ngɔn ni, a vɛ dya la tɔ andale ɓa.&gt;&gt; <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Yesɔ cwa ɓanə ya; &lt;&lt;Gha&gt;&gt;nankenə kəɓa bwa dya la latangte andale ɓa, kə tɔ andale ɓasɔ shɛnə ɓe ku kə dya la dangdi agang kə wuu kupaca la yidi sɔ. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Ngwi zha andale ɓasɔ kə va dya yi sɔ, layimɓa kəɓa cwa yo abaru ɓa nang nənə nang sa ngwi gwe anjɔ ɓani. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />kə ngwi yiɓa sɔ bwa paca mɛ Yesɔ ama ɓa ju wa kwe nə ɓe fi vya ɓa yi gaɓa.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesɔ Nyɔndi Ngwi Swɛgwe.</para>
  <para style="r">)<ref loc="MRK 2:1-12">Maku 2.1-12</ref>; <ref loc="LUK 5:17-26">Luka 5.17-26</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Kə Yesɔ dya la gwa yiidi, ku gang la dangdi agang yi yiigɔ, <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Kə layimɓa ngwi ngɛ ɓanə ngwi swɛgwe la sawa u nga la la zhi. Kə Yesɔ sang yoade gaɓa, ku ye ngwi swɛgwe sɔ,&lt;&lt;so nya, nwi mə, a yafi gu nang anjɔ gu nə ngɔn.&gt;&gt; <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Kə ngwi maɓesa nangzhĩ Musa ngɛ ɓa cwa nə saɓa &lt;&lt;ya ngwi ni nga ja yaa Nyimoː&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Ama Yesɔ nyi nang cheng gaɓa ngɔn, ku ya &lt;&lt;ka yonə ngu cheng nang anjɔ la sɛgwɔn na nang ni ma? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ka awa ta, a ya, &lt;a yafi nang anjɔ gu ngɔn,&gt;Kəfi a ya, &lt;lwe a zhazho ma&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ama ngə shana u nyi nwi nəngwi ɓa njamu nə na yafi nang anjɔ la lasapyang.&gt;&gt;Ku ye ngwi swe gagwe ya,&lt;&lt; lwe cwe zhi gu a kwe yii.&gt;&gt; <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Ngwi sɔ lwe kə kwe yii. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />kə cwi nəngwi ɓa sang na nang ni kəɓa yiyi; kəɓa ɓwɔn Nyimoː, angye nang naa nə nəngwi ɓa njamu ni.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yesɔ kwi Matiyu</para>
  <para style="r">)<ref loc="MRK 2:13-17">Maku 2.13-17</ref>; <ref loc="LUK 5:27-32">Luka 5.27-32</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Kə Yesɔ vya yido sɔ, na nang ngu zhanə zho ni ku sang ngwi mə ngɛ, yaa wa Matiyu, də la yido mu shede lidi, kə Yesɔ cwawa nə,&lt;&lt;Kafi mə&gt;&gt; kə Matiyu lwe kafi wa.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kə Yesɔ nga tang nang la layi Matiyu, ngwi mu shede lidi ɓa ɓa byagaɓanə, fi ɓa ngwi nə nang anjɔ ɓa.&gt;&gt;Mba nga tang nang ɓa ɓɔ ɓa nwi nangjwa gɔɓa. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Kə Farisiyawa ngɛ ɓa sang na nang ni kə ɓa byə nwi nangjwa gɔɓa,&lt;&lt;ka yonə ngwi maɓesa nang gua nga tang ɓa ngwi mu shede lidi ɓa ngwi anjɔ ɓa ma?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Kə Yesɔ wa na nang ni ku ya,&lt;&lt; ngwi njamu ɓa la kã ngwi nyɔndi la, ama ngwi ɓa ɓanə nangjwə nəni. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ama gha nyi nang kwã Nyimoː cwanə yaː&lt;ngə kã nang pon, kã nang nyanang la.&gt; ngə ɓa yo ngwi ade ɓala. ama yo ngwi nə nang anjɔ ɓa.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">Yesɔ Byədo yo Nang zhĩ lo</para>
  <para style="r">)<ref loc="MRK 2:18-22">Maku 2.18-22</ref>; <ref loc="LUK 5:33-39">Luka 5.33-39</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Kəfi ngwi kafi Yohana ngwi nə botisma mɓa sa Yesɔ, nga ɓyədo, &lt;&lt;kanə nənang je ɓa Farisiyawa ɓa ngə zhĩ lo ama nwi nangjwa gua la zhĩ lo la ma?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Kə Yesɔ dya ɓanə,&lt;&lt;Gua u shang ngwizhɛ la yido yinyɔ yifye də tuɓedanwa kə sha nəngwa ngənə ɓawa ma? Yoade nankənə laǃ Ama lalo nga ɓa ɛ cwe ngwi nəngwa ɛ vya ɓa nəni sade sɔ ɛ cwe zhĩ lo. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Ngwi ngɛ nene zwe yindãn nangja a cwon ɓa a nwanang apa, nwanang apa ɛ dang nangja kəfi nang nya gɔ ɛ ja tawi <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Ko ngwi ngɛ nene la yenə di fashi apa la la badi a cwon ni nɛ ɓa ye ngɔn ni badi sɔ ɛ, bwon di fashi sɔ ɛ yemi, badi sɔ ɛ Jija. Se, ɓa ye di fashi apa la la badi apa, kəfi gaɓa ku ɛ də zanzan nəɓwɔ.<verse eid="MAT 9:17" /></para>
  <para style="s1">Nwi anəgwa nwanye ɓa gwa nangtwɔnə ɓesa nangja Yesɔ ni</para>
  <para style="r">)<ref loc="MRK 5:21-43">Maku 5.21-43</ref>; <ref loc="LUK 8:40-56">Luka 8.40-56</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Sayi nang Yesɔ nga cwayo ni, kə nwanye yi Yahudawa ɓa ngu mɓa ngwami la sibewa kə ya, &lt;&lt;nwi anəgwa gə wuu ngɔn; ama mɓa nyang gaɓo lasawa ngɔn ni gɔ lu lwelwe .&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />nankənə Yesɔ lwe gha ɓɔ, ɓa nwi nangjwa gɔɓa.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Kə gwa mə ngɛ ɓa sapyang Jwa cwi mba ngu tori ɓa nang yejwɔn nə mɓa lazinze wa kə twɔnɓe sa dang nangja gɔ. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Kə cwayo ɓa lashi nə, nɛ ko twɔnɓe sa nang ja gɔ ngɔn ni ngə nyɔndi.<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesɔ ɓe yiwa kə sang wa, ku cwa ya, &lt;&lt;nyaswe nwimə anəgwaǃ&lt;&lt;yoade gu nyɔndi gu ngɔn,&gt;&gt;la sade sɔ kə ngwa sɔ nyɔndi ɓabe.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Kə Yesɔ dyanə layi nwanye sɔ, ku sang nga bwonku, nga lɛlɛ, nga tadyəng wii ajədo, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Ku cwa ɓanə ya, &lt;&lt;kwe nə ɓe, ko nwakuǃ nwi anəgwa sɔ wuu la. ama ngayinga.&gt;&gt;Ama ɓa vɛwanə yi doshən. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Lazĩze ɓa bi nəngwi ɓa ngə latẽ ni, kə Yesɔ dya lanywi gwa gaɓe nwi anəgwa sɔ, ku lwe. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Abaru sɔ maje ku la kəmi sɔ.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesɔ Nyɔndi Ngwi Bwonyi ɓa</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesɔ vya dosɔ, kə ngwi ɓwonyi mba kafĩ wa nga kwido ɓa njamu nə &lt;&lt;sang laɓyɔ je gwɔgwɔ Daudaǃ&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Sade nang Yesɔ dyanə layi ni, kə ngwi bwonyi mba ɓasɔ kəfi gɔ ɓyəɓa, Gua dyan gəmə nə nyɔndi gua ma?&lt;&lt; Kə ya nə dyan, Shayi&gt;&gt;.<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Kə ngu twɔnɓe sa zayi ɓa fi ya, ngə sa yoade gua na nang u dyanə ni&gt;&gt;. <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Kə zayi ɓa bwe nə, kə Yesɔ dajacwɛ ɓa, sang, ɓu cwa ngwi ngɛ nangni nəla. <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ama ɓa bwa latẽ ɓa cwa abaru gɔ maje ku la kəmi sɔ.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesɔ nyɔndi ngwi la cwanə dang lani</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Keɓa kwenə ni, kə ngwi mə ngɛ ɓa gwe anjɔ nə lu cwayo la kəɓa ɓa wanə labe Yesɔ. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Kəfi gwe anjɔ sɔ bwanə kwe ni, ngwi sɔ fudi na cwayo, cwi nəngwi ɓa nang yiswe gwa ɓa ku . Kə cwa ya, Ba mɛdi na sang ngwi ngɛ la na nangni la kəmi Isrela.<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ama farisawa cwa ya, &lt;&lt;ɛ ka nwanye gwe anjɔ kə nawa njamu kə ngu bwanə gwe anjɔ ɓa.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">Yesɔ sang laɓyɔ nəngwi ɓa</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Lang le Yesɔ nga kafi yi agang ɓa apika ɓa, ngu maɓesa nang la yido ɓwa nəshi Yahudawa ɓa, ngu cwayo abaru anuanua lashi yido nəgang Nyimoː kəfi ngu nyɔndi nəngwi ɓa lasa yiri nang jwe anwaku aɓanə kə nini. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Kə sang nə cwi nəngwi ɓa ni, ngu sang laɓyɔ gaɓa.Yonəmani nga tori fi ngwi bali gaɓa nene, ngə na ngang nang sha ɓa nene ni. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />kəfi Yesɔ cwa nwi nangjwa gɔ ɓanə ya,&lt;&lt;nang shã nang pang ɓa bya wanə, ama ngwi nə nangnu ɓa bya la. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />U pɛdang sa Daa shayonki yonəmani kɔnə nsha lasɛ, yona nyang ngwi nangnu ɓa la lasɛ sɔ.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yesɔ swɔ Nwi nangjwa gɔɓa Jwacwi Mba</para>
  <para style="r">)<ref loc="MRK 3:13-19">Maku 3.13-19</ref>; <ref loc="LUK 6:12-16">Luka 6.12-16</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Kə Yesɔ kwi nwi nangjwa ɓa nə jwacwi mba labe wa ngu naɓa njamu yona bwanə yingu anjɔ ɓa, kəfi nyɔndi ngwi nangjwə ɓa ngwi sa gaɓa. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Kaya ngwi nə nangnu ɓa nə jwacwi mba yeː Siman angye nang kwi wanə Bituru ni, ɓa nwi naa gɔ Andarawus, ɓa Yakubu nwi Zabadi ɓa nwi naa gɔ Yohana; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Ba Filibu ɓa Batalomi, ɓa Toma, Matiyu ngwi mu shede lidi, ɓa Yakubu nwi Halfa, ɓa Tadiyus; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Siman ngwi shan yigɔ ɓa Yahuda Iskariyoti angye nang nanə Yəsɔ.<verse eid="MAT 10:4" /></para>
  <para style="s">Nangnu a nanə nəngwi jwacwi mba ni</para>
  <para style="r">)<ref loc="MRK 6:7-13">Maku 6.7-13</ref>; <ref loc="LUK 9:1-6">Luka 9.1-6</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Ka ngwi ɓani jwacwi mba Yesɔ swon ɓa nəni ɓa dang nangzhĩː&lt;Bu dya tangte ngwi nang ɓa kanə Yahudawa ɓa lani&lt;&lt;ko dya layi Samariya la. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Nankənə ngɔn ni, gha sa ngwi Isrela ɓa angye ɓa ngənə na ngang nang lanə ni. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Gha, cwayo anuanua nəː&lt;Yido nəgang Nyimoː Zədo ngɔnǃ&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />U nyɔndi ngwi nangjwə ɓa, u lwe nə ngwi awuu wuu ɓa, u ntẽsa ngwi vaswe ɓa, a bwanə yingu gwe anjɔ ɓa. Gua noa yinse u ogɔn nang ngɛ nla, unənankənə ɓe wonwa nang ngɛ la. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Bo cwe nta apyə̃pyə̃g, ko che shede la jəba gua la; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Bo cwe fu zhazho la sa zhoni, ko nangja swe twashi sa angye u jani ko tɔ ɓa ko shi tuɓe. Ngwi nə nangnu zəzan naɓa mɛ nang la bali gaɓa ni.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Yi nang ku lu dya ni, kã ngwi ade , ngu də bɔ kakə sade nang lu lwe ni <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Sadenang u dya layi ɓasɔ ngɔn ni, u yaɓa doya jwɔ də ɓowa. &gt; <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Inə fi layi ɓasɔ cwo ngɔn ni, dodə jwɔ &lt; gua də yimɓa; ama inə ngwi layi ɓasɔ cwowa lani dodə jwɔ gua fi kwe bowa. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Inə ngwi ngɛ yowa do lani, ko wasa yo gua lani, gba bu gagwo ɓa, ne bwa layi sɔni ko yi sɔ. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Ngə cwo yoade nə, Nyimoː ɛ sang laɓyɔ nəngwi Sodom ɓa Gomora ta ngwi yiɓa sɔ lalo titaǃ<verse eid="MAT 10:15" /></para>
  <para style="s">Sayi fa laɓyo nga ɓa</para>
  <para style="r">)<ref loc="MRK 13:9-13">Maku 13.9-13</ref>; <ref loc="LUK 21:12-17">Luka 21.12-17</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Wasaməǃ, ngə swo wa na ngang nə latangte fyabe ɓa. Nankənə ngu ngənə ngwi cwoncwon ɓa na jwa nə, ngənə ngwi a jwanjwa ɓanə na zho nə. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Ngu nə akilo, Ngwi ngɛ ɓa ɛ gwa wa muuwa ghanə be yido nə tita, gaɓa ɛ gbɔ wa ɓa ntɛ la yido ɓwa nəshi Yahudawa ɓa <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Yo gə ɛ ghowa nə labe ngwi nə gang ɓa ɓa kwə ɓa, yonang cwa abaru anuanua saɓa ɓa ngwi nang ɓa kanə Yahudawa ɓa lani <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Ama nɛ ɓa gwa wa ngɔn la yido ɛ nuwa tita ni ɓaɓu yili ɓa nang lu cwani la. Ko bəɓa lu cwanə; sade sɔ mɓa ngɔn ni ɛ noa nang lu cwani. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Yonəmani kaku a cwa yo sɔla, ama yingu yi Nyimoː Daa gua ɛ cwayo sɔ nə tayi gua. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />&lt;&lt;Nəngwi ɓa ɛ noa sa nwinyəɓa yona ɓa jəu, fi daa ɛ naa nwi ɓa namɓa nankənə; nwi ɓa ɛ lwe nə daagan ɓa ɓa naa gaɓa fi a nyang ɓa jəɓa. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Paca nwaku ɛ shĩu wa yonəmani ka yogə̃. Ama ngwi dwənə hakə yenəshiwa ngɔn ni lu cwido cwi. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Nə nga nowa laɓyɔ layi ngɛ ni, va kwe yii ngɛ. Gəmə cwo yoade nə, kɛ yeshi nang kwɔn yii Isrela mbe kə nwi nəngwi ɓanə. <verse eid="MAT 10:23" /><verse number="24" style="v" sid="MAT 10:24" />&lt;&lt;Nwi nangjwa ngɛ kɛ kwe sa ngwi mɔɓesa nang nila , ko nwinfɔ ngɛ la kwe sa nshayi gɔ. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Nwi nang jwa la wanua na ɓena ngwi mɔɓesa nang ni, kəfi nwinfɔ ngə na nshayi gɔnə. Inə ɓa cwa ya nshayi gaɓa ka Ba'azabu, kanə gaɓa ɛ cwa yo ngwi layi ɓa.<verse eid="MAT 10:25" /></para>
  <para style="s">Nwa la yii</para>
  <para style="r">)<ref loc="LUK 12:2-7">Luka 12.2-7</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;Nankəbənə ni ɓaɓu yi nəngwi ɓa la. Yonəmani nang ngɛ nene la gũnə kɛ bwenə lani, nanku jwanəni la ɓuɓwa la baba ɓa nyi. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Nang ngə cwowanə la yidavu ni ngu cwa la baba, nang gua wanə jwanjwa la yicweni u cwa ɓa nyenə nwaku wa la baba. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Bu yi ngwi nang ɓa la jənə swe ni ama kɔ ba jənə yonki nila; Ama yi Nyimoː, ngwi la jənə swe ɓanə yonki la lava ni. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ba yaaɓa nzho ɓa mba lasa shede nso, amaku ko nso gaɓa ngɛ la gunə kəmi ɓa nang nyi Daa gaɓa lani, <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Lasowa gɔni, ko ka ndə̃ji gua ku ɓa cwucwa. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Bu yiyi la; ɛ gang gua kwe sa yi Nzho ngɔn ɓa bya gaɓanəǃ<verse eid="MAT 10:31" /></para>
  <para style="s">Nang dyanə Almasihuː la sibe nəngwi ɓa</para>
  <para style="r">)<ref loc="LUK 12:8">Luka 12.8</ref>,<ref loc="LUK 12:9">9</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Ngwi nang cwanə yo gə la sibe nəngwi ɓa la baba ni, gə̃mə ma ngə nə nankənə ɓawa la sibe Daa gə la lankwã. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ama ngwi nang nyasang gə la sibe nəngwi ɓani, gəmə ma ngə nyasang gɔ la sibe Daa gə la lankwã.<verse eid="MAT 10:33" /></para>
  <para style="s">Mɓa ɓa jwɔnə nla Ama ɓa kafɛ nə</para>
  <para style="r">)<ref loc="LUK 12:51-53">Luka 12.51-53</ref>; <ref loc="LUK 14:26">14.26</ref>,<ref loc="LUK 14:27">27</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt;Baɓu chəng ya gəmə ngə ɓanə jwɔ la kəmi la. Nene, gəmə mɓanə jwɔ nla, ama kafẽ. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Gəmə mɓa yona ɓanə bang tangte nwi anəngwo ɓa daa, nwi anəngwa ɓa naa gɔ fi gwe anəngwa ɛ ngəsa gwewa anəngwa; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Ngwi shĩgu ɛ ngənə ngwi layi gua. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />&lt;&lt; Ngwi nang ku nga shãn nə daa gɔ ɓa naa gɔ kwe nə samə ngɔn ni, gɔ pɛ̃la na ɓe nwinangjwa gə; fi ngwi nang ku nga shãnə nwi anəngwo ko nwi anəngwa kwenə samə ngɔn ni banla naɓe nwinangjwa gə ɓa. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ngwi nang ku cwe nə shi agangan gɔ kəfi kafĩ mə lani manla ngənə nwi nanjwa gəɓa. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Ngwi nang ku nga shãnə yonki gɔni. kɔ mɛla. Ngwi nang ku nanə yonki gɔ yo gəni, ngu məmə.<verse eid="MAT 10:39" /></para>
  <para style="s">Nangnu dang jadɛ ɓa</para>
  <para style="r">)<ref loc="MRK 9:41">Maku 9.41</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Ngwi nang ku cwo wanə ngɔn ni, u cwe mə ngɔn; paca ngwi nang ku cwe mənə ngɔn ni u cwe ngwi swon mə nəni ngɔn. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Ngwi nang ku cwenə ngwi dangdoswɔn Nyimoː yo gɔ ka ngwi dang doswon ngɔn ni, Ngu ganə danjada gɔ. Kəfi ngwi nang cwe nə ngwi ade yonəmani uka ngwi ade ngɔn ni lu mɛ dang jada ngwi ade. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Gua nyi ngɔn ngwi nang ku nanə dibii jwɔ sa nso apika sa ngwi ɓa nga kanəsamə ni yonəmani gɔ ka ngwi kasamə ni, yoade gaɓa lamɛ dang jada gaɓa mɛ.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yohana Wanə Botisma swondo ɓa ngwi kasawa ɓa</para>
  <para style="r">)<ref loc="LUK 7:18-35">Luka 7.18-35</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Sade nang Yesɔ yenəshi nang maɓesa nangni sa nwi nangjwa gɔɓa njwa cwimba ni, kə u lwe vya dosɔ ku kwenə ngu maɓenə ngu cwa yo anuanua la yiɓa zəndo ni.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Sade nang Yohana wanə Botisma ngənə la fusina ni kə wanang ɓa Almasihuː nga nəni, kə swon nwi nangjwa gɔɓa ngɛɓa lasɔ. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />Kəɓa cwɔnə ya a cwɛnə&lt;&lt;Kaku nə ngwi nang nga ɓani, ko nyang zayi sa ngwi ngɛ ma?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesɔ dyaɓanə ya, &lt;&lt; u fi gha cwa Yohana nə nang ngu sang ni kəfi uwaniː <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />ngwi bwon yiɓa nga sando, ngwi gben gweɓa nga zhazho, ngwi nangjwə va swe ɓa nyɔndi ngɔn, ngwi bwon cweɓa nga wayo, nga lwe nə ngwi wuunə ni ɓa winə, nga cwa abaru anuanua sa ngwi laɓyɔ ɓa. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Nyimoː na nwaku balka sa ngwi ɓa nyəmə nənla niǃ&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Sade nang nwi nangjwa Yohana ɓa kwe ni, kə Yesɔ fudi na cwa nəngwi ɓa yonə la lashi Yohana ngu yaː&lt;&lt; Ka nə bwa yona ngu sang la lavi ma? Ubwa yona sang vi a dwandwa dwa ɓa nang gwe nga ba lashi ɓa ni ma? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Kanə gua bwa yo na ɓu sang ma? Ngu sang ngwi janə nang ja apa ma? Kəbela, ngwi ɓa ɓanə nangja apa ɓa ngə la danɓwazhi Kwəǃ <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />U cwamənə, kanə gua ubwa yo na ngu sang ma? U sang Ngwi dandoswon ma? Ka yoade, ama kwe sa ngwi dandoswon ngɔn. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Yohana ka kɔɓə nang a jwanə la lakwã Nyimoː lashi wa yaː</para>
  <para style="q1" vid="MAT 11:10">&lt;Nyimoː ya, gəmə ngə nyang ngwi swondo gə gəmbe laso,</para>
  <para style="q2" vid="MAT 11:10">u mo məngang nə mbe ka ɓa.&gt; <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />&lt;&lt; Sangni ngə cwowa nə la tangte ngwi nang ɓa mya nəni ngwi ngɛ nene kwe sa Yohana ngwi nə Botisma. Ama ngwi nang ngə nə lapika la yi nəgang Nyimoː ni kwe sɔ ngɔn. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Lasade Yohana wanə Botisma nga cwanə yo anuanua ni hakə nwinza ni donyang yi Lankwã nga fa laɓyɔ yi nang lwe nə segwɔn, kəfi ngwi lwe nə segwɔn nəngwi ɓa nga shana cwe donyang Nyimoː ɓa njamu nə. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ngɔn kə sade Yohana ɓa ngwi dandoswon ɓaku kəfi nangzhĩ Musa ɓa cwayo shi donyang Nyimoː ni ngɔn. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Inə lu dyanə lu wa yoɓa gaɓa cwani, Yohana ka kɔɓə nə ngwi nang ɓa cwa yo la lashi wa ya Iliya nga ɓa ni. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Wa, inə gua ngənə ɓa yicwe nəniǃ<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt;Ama kanə nə manə ɓa ngwi sapyang ni ma? Na nwi jwɔn ɓa nə adə la lomɔ ni. ka kwida ndaɓa nga nyayinyɔ gaɓa nga yaː<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;&lt;&lt;i nguwa jwɔnə,</para>
  <para style="q2" vid="MAT 11:17">kunyi na ubwa dang;</para>
  <para style="q1" vid="MAT 11:17">i towa dyən nwi ajədo nə,</para>
  <para style="q2" vid="MAT 11:17">u nyi na lɛlɛ &gt; <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Yohana ɓa ni lu tang nang nla lu fa nla, kə ɓa ya, &lt; Gɔ ɓa gwe anjɔ nə.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Kə nwi Nyimoː ɓani ngu tang ngu fa, kə ɓa ya, &lt;sang ngwini u ka ngwi nənywe ɓa wa di fashi, nda ngwi mu shede lidi ɓa ngwi nə nang anjɔ ɓaǃ Nankənə ku, nga caɓenə sa nang ka ade sa nang u nəni.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">Tita La shĩ Yiɓa dyanə lani</para>
  <para style="r">)<ref loc="LUK 10:13-15">Luka 10.13-15</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Kə ngwi yiɓa nang Yesɔ fudi na nə nang yiswe yimɓani, ama ngwi ɓasɔ tubi nla, kuya Ngə lashiwa gua yiɓasɔ. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt;ɛ jwə bəɓa lasoa, Korasinǃ ɛ jwə bəɓa lasoa namɓə, Basaidaǃ Nte nang yiswe nən la tanto wani, anə la Taya ɓa Sidom ni, kə ɓa tubi ɓa jagɔ nə, kəɓa ja zhã nang ja lasa ɓa ɓajagɔnə kəfi ye vunva saɓa ɓa ja zhanang lasaɓa nga caɓenə ya gaɓa tubi ngɔn sa nang anjɔ gaɓaǃ <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ama ngə cwo nə, lalo tita ɛ sang laɓyɔ ngwi Taya ɓa Sidom kwe soa. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Gua ngwi Kafanahuǃ nga sang yapɛ la cwoncwe la lankwã ma? Chogha la lavaǃ Nangnu nang yiswe ɓa nənə tangtowa ni, ntẽ kəɓə nə Sodom nte ɓa ngənə nwinza ni. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Gu a nyi ya la lo nə tita Nyimoː ɛ sang laɓyɔ Sodom kwesoaǃ&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">Ba samə kə menə wisowa</para>
  <para style="r">)<ref loc="LUK 10:21">Luka 10.21</ref>,<ref loc="LUK 10:22">22</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />La sade sɔ kə Yesɔ ya, &lt;&lt;Daa, Daa Shayonki yi lankwã ɓa kəmiǃ Gəmə wisi gu ngɔn yonəmani gu a caɓesa nangni sa ngwi ɓa nyinang nlani ɓa ngwi mye ɓa kəfi ngwi nyinə nang lani kə caɓenə sa ngwi ɓa ngə na nwijwɔn ɓa ni. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />&lt;&lt; Yoade, Daa, nankənə gu nga shangne na nəni.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt;Daa gə nəma nang ɓani ngɔn ku. Ngwi ngɛ nene nyi nə Nwi wa nla sɛ Daa, fi ngwi ngɛ nene nyi nə Daa se ka Nwi kəfi ngwi ɓa Nwi shana canəɓenə sawa ni.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt;Ngu ɓa samə, gua ngwi nang ɓa nyowa kaani, fi ngu fa laɓyɔ ɓa nang cwe azwanzwa lashiuwa ni, gəmə ngə noa nang wi. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />U cwe nang cwe gə, yonəmani gəmə jwujwa kifi ngə finə samə kəmi sa Yingu kəfi gua lume do awinwi. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Yonəmani nan cwe gəɓa ngə noa ni jwəla, nang cwe ngə noa ni zwa la.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Yahudawa ɓa byədo la lashi lalo awiwi gaɓa</para>
  <para style="r">)<ref loc="MRK 2:23-28">Maku 2.23-28</ref>; <ref loc="LUK 6:1-5">Luka 6.1-5</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Jado la lazinze nang Yesɔ nga zhazho laɓe lasɛ La lalo wiwi Yahudawa ɓa, nwi nangjwa gɔɓa wanə, kə fudi na pya yinangpa nga tang. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Kə Farisawa sang na nangni, kəɓa cwonə yee,&lt;&lt; A sang ngwi maɓesa nang gua nga nə nang dang nangzhĩ Musa bido ɓe nənə lalo wiwi. <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Kə cwaɓa nə yee,&lt;&lt;Ase, cwa kwã nang pondo nəni sade nde zhazho gɔ nga wanə nywe ni ma? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Na nang dyanə yiɓa ni nga pẽdang ni ngu tang nwa nang nte wo nini angye nang zãla nde zhazho gɔ tang nə. seka ngwi nyang nang lanywi ɓa )Pastoca&lt;&lt; <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ko pɛ cwa kwã sɔ la dang nang zhĩ Mosa la. nanang ngwi nyɔng nang ɓa nga vinə dang nang nang zhĩ lalo wiwi la lanywi agang, fi dənə ɓanə ayibe la ma?. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ngə cwo wanə, ka ngwi nang nənə akilo ni ye, <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Ama bowa ɓa nyi nang yika kwã cwani,&lt; nang pong ngə shã, ka nyang nang la,&gt; ɓa ngwi nang sang ngwi nene ɓa ayibe. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />yonə mani nwi nəngwi Daa shayonki hakə ma ɓalalo wiwi.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s">Ngwi swe gaɓe</para>
  <para style="r">)<ref loc="MRK 3:1-6">Maku 3.1-6</ref>; <ref loc="LUK 6:6-11">Luka 6.6-11</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Kə Yesɔ vya dosɔ ni, ku kwenə la Yido ɓwa nəshi Yahudawa ɓa. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Layimɓa ngwi məngɛ ngənə u ka ngwi swe gaɓe. Ngwi ngɛ ɓa ngənə layimɓa nga shana cwaya gɔ ngu nə nang zanə lani, Kəɓa byədo, &lt;&lt;Nangzhĩ Musa dya na ɓa nyɔndi nəngwi lalo awiwi ma?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Kə Yesɔ cwa ɓa nə ya, &lt;&lt;Kanə la nənang ngə ngwi nɛnɛ ɓa ngang nə kə gu la jweɓu la lalo awinwi lama?Kɛ u dya u cwewa bwanə lama? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Kə nwi nəngwi ɓa kwe sa ngang lamaǃ Nankənə, nangzhĩ je yeɛla ya je ɓi pon nəngwi la la lalo awiwi.&gt;&gt; <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Kə cwa ngwi swe ɓeni ya, &lt;&lt;atã gaɓo nə&gt;&gt; kə u ntã ɓewa, kə ɓenə ade,na gaɓe wa anso nə. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ama Farisawa ɓa bwa la nə bəɓa la jəwa nə.<verse eid="MAT 12:14" /></para>
  <para style="s">Ngwi nang Nyimoː cwenə nwinfɔ ni</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Sadenang Yesɔ nyi nə nang ni nga chəng ni, kə u vya yido sɔ; nəngwi ɓa ɓa byagaɓanə kə ɓa kafi wa. kəfi nyɔndi gaɓa ku ɓanə nangjwə ni. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />kəfi daa jacwẽ ɓa ya, be cwa ngwi ngɛ ɓa abaru gɔla. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Gɔ nə nangni yona Nyimoː cwanə lasidang ngwi dandoswon Ishayaː<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt; Ka ngwi nang nyang wani yee,</para>
  <para style="q2" vid="MAT 12:18">ka kɔ ngwi gəmə cweni, angye gəmə ngə shangni, kəfi ɓawa gəmə ngə wanua mə.</para>
  <para style="q1" vid="MAT 12:18">ngə ye yingu atẽtẽ gə la sawa,</para>
  <para style="q2" vid="MAT 12:18">Kəfi gɔ u cwa yo tita gə sa nəngwi ɓa.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />kɛ u nyasang ɓa ngwi ngɛ la ko ɓwonku,</para>
  <para style="q2" vid="MAT 12:19">kɛ wasa ghɔ wa la məngang la.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Gɔ kɛ gbyẽ nang zənədo na gbyẽ ni la, va cado zəndo na wuuni la.</para>
  <para style="q2" vid="MAT 12:20">Gɔ u dari na sang sɛ yoade nə nangnu,</para>
  <para style="q2" vid="MAT 12:20">kəfi lasawa kə nəngwi ɛ tagwɔn nə.&gt;&gt;<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Nəngwi ɓa fi ɛ nyang sɛgwo sa yowa.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s">Yesɔ ɓa kwə gwe anjɔ</para>
  <para style="r">)<ref loc="MRK 3:20-30">Maku 3.20-30</ref>; <ref loc="LUK 11:14-23">Luka 11.14-23</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />kə ngwi ngɛ ɓa ɓanə ngwi bwon yi kəfi kɛ gɔ ba na cwayo la yonəmani u ɓa gwenə. Yesɔ nyɔndi ngwi sɔ. kə gɔ ɓana cwayo kəfi u sangdo. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Nəngwi ɓa ku nang yiswe gwa ɓa sa nang Yesɔ nəni. &lt;&lt;Nwi ni ka nwi Dauda la ma?&gt;&gt; <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Ama Farisawa ɓa wanə na nangni, kəɓaya,&lt;&lt;Gɔ u ɓi gwe anjɔ ɓa Ba'alzabul kwə gwe anjɔ nawa njamu kə u nə nang ni.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yesɔ nyi nang gaɓa nga cheng ni, kə cwa ɓanə yee,&lt;&lt;paca yi agang nang ganə mba ngɔn ni nga shĩnə ɓe. fi yii nang ɓa layi nəngwi ɓa la ganə ni chocho ni nga gbanə saɓa ni ɛ gugu la kəmi. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Inə ngwi ngɛ ɓa nga gbabang ɓa yi do nyang shetan ni, nang ni nga gɔ gəga la pika pika kəfi zedo ngɔn na gu shɛnəǃ <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Gua ya ɓa gəmə ngə bwane gweɓa ɓa yonəmani Ba'alzabul nəma njamu ni, yoade, nankəɓəni, Ka nənyo naa ngwi kasowa njamu la bwaɓa nəni? Nang ngwi kasowa nga nəni nga caɓenə ya yo gua dənlaǃ <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Nankənə la, ka Ɓa'zabal la, ama ka Yingu Nyimoː, angye nəmanə njamu ngə ɓinə gwe ɓani, angye canəɓenə ya donyang yi Nyimoː gəmbe mɓa ngɔn.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt; Kɛ ngwi ngɛ ɓa ba dya layi ngwi ɓanə njamu ni la hakə mu nang gɔ ɓa se gɔ gəmbe dwə ngwi njamu sɔ; ngɔn ni kə uɓa na munang layi gɔ.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt; Ngwi nang ku kanə yigə lani u jenyi ɓamə; ngwi nangku damɓe nə lani nga shɛnə shɛ. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />yonə mani gəmə ngə cwowanəː ɛ, yafi nəngwi anwaku nang anjɔ gɔ ɓa yo do sheng gaɓa cwani; , ama ngwi nang cwa yo dosheng sa yingu atẽtẽ ngɔn ni, kɛ yafi gɔ nə la. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Ngwi angye cwanə yo shi Nwi Nəngwi ngɔn ni la yafa gɔnə ya; ama ngwi nangku cwaə nang ngɛ shi Yingu ngɔn ni kɛ yafa gɔnə la.&gt;&gt;<verse eid="MAT 12:32" /></para>
  <para style="s">Shi ɓa fagɔ ɓa</para>
  <para style="r">)<ref loc="LUK 6:43-45">Luka 6.43-45</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt; Shi azãzã ngu mya nwi azãzã, shi nang zanla ni u mya nwi wa ma zanla, inə aɓa shi anjɔnəni, gu ame fashi anjɔ.ka fa yi shiɓa kə la nyiwa nə. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Gua jwua ɓa unə bəɓa lu cwa nə nang zanzan ni yonə mani gua ka ngwi anjɔ ɓa? Shidang nga cwa nang ngənə la lawa pɛnə ɓa kəni. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Ngwi ade nga bwanə nang la yido nyang nang gɔ, ngwi anjɔ nga bwanə nang anjɔ la yido nyang nang anjɔ gɔ.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />&lt;&lt;Gəmə ngə cwo wanə la lalo nə tita gu a cwayo anjɔ ɓa ku a meri cwa nəni. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Lasa yo gua kə ɛ nuwa tita nə ko pyo taɓe ko a gwu.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">Nga kã məngang nə nangnu nang yiswe ɓa</para>
  <para style="r">)<ref loc="MRK 8:11">Maku 8.11</ref>,<ref loc="MRK 8:12">12</ref>; <ref loc="LUK 11:29-32">Luka 11.29-32</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />kə ngwi ngɛ ɓa la tangte ngwi maɓesa nangzhĩ Musa ɓa Farisawa yewa ya,&lt;&lt;Ngwi maɓesa nang, &gt;&gt; je ngə shana so nə nang yiswe.&gt;&gt; <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Kə u dya ɓanə yee, &lt;&lt;ngwi lasapyang ɓa ni aka ngwi anjɔ ɓa ngwi nang ɓa nyinə Nyimoː lani, ngwi jwə laɓaǃ nga shana sang nang yiswe, ama kɛɓa chaɓa ɓesa nang yiswe sɔ la, seka nang yiswe yi ngwi dandoswo Yonana. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Na nang Yonana nə nə kwe ncha, duda ɓa laloni la la ju agang ni, nankənə nwi nəngwi ɛ nə gwe ncha la kəmi. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />La lalo tita ngwi Nineba ɛ lwe ɓa ngəsa yonəmani gaɓa tubi ngɔn sade ɓa wanə yo anuanua Yonana cwani; Kəfi gəmə ngə cwowa nə ngwi gangnə tanə Yonana ni ngə lanleǃ <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />La lalo tita kwə nwi anəgwa yi Sheba ngu lwe ɓa nwi sapyang ɓani, cha ɓa ɓenə ɓa nə nəɓwɔ nla, yonə mani gɔ lwe ɓa jagɔnə mɓa, yonə mani ngu wa nang maɓesa nang nanyi yi kwə Solomo. ka ngwi kwenə sa Solomo ni ngə ye.&gt;&gt;<verse eid="MAT 12:42" /></para>
  <para style="s">Nang Fi Yingu Anjɔ</para>
  <para style="r">)<ref loc="LUK 11:24-26">Luka 11.24-26</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Nə gwe yingu bwa lasa nəngwi ngɔn ni, ngu zhazho la yido nang dibi nene ni yona mɛ do jwa gɔ, ama inə mɛ nla ni, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Ku cwa lashi wanə ya, gənə ngə fi gha layi gənə&gt;, ku finə ni kəfi gɔ mɛ layisɔ ngə yinse, tẽtẽ, kəfe nəku ngənə nəɓwɔ. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Nankənə kəfi u kwe, mu gwe anjɔ ɓa nto mba, angye nang kwe nə sawa ɓa nang anjɔ ni, ɓa ɓe dya dəla yimɓa. yika dodə ngwi ni ɛ kwe sa a gembe ɓa nanjaɓata, nankənə ngu dənə ɓa ngwi sapyang ɓa ni.<verse eid="MAT 12:45" /></para>
  <para style="s">Naa Mya Yesɔ ɓa Nwinyɔ ɓa</para>
  <para style="r">)<ref loc="MRK 3:31-35">Maku 3.31-35</ref>; <ref loc="LUK 8:19-21">Luka 8.19-21</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Gɔ ngə shi nang cwayo kə ka naa gɔ ɓa nwiyua ɓa ngə la ntẽ ngashana cwayo bɔ. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Kəɓa yewa ya, &lt;&lt;Ka naa gu ɓa nyua ngə la ntẽ shana cwayo bo ye.&gt;&gt; <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Kə cwa ngwi nang cwanə yo nəni, &lt;&lt;Ka wanə naa gə, fi ka waɓa nwiyəməɓa ma?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Kə u cha ɓesa nwi nanjwa gɔ ɓa kə u ya,&lt;&lt; Sangǃ Ka naa gə ye ɓa nwiyəmə ɓa. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Nə ngwi nang nə nang daagə la lankwã nga shani, kaɓa nə nwi daagə ɓa nwi naa gə ɓa.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Nashoo La Lashi Ngwi Zwa Nang</para>
  <para style="r">)<ref loc="MRK 4:1-9">Maku 4.1-9</ref>; <ref loc="LUK 8:4-8">Luka 8.4-8</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Lalo sɔni Yesɔ bwa layi gha dəla dangdi agang yido dənə kə maɓesa nang ni, <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Cwi nəngwi ɓa ɓa byagaɓanə ɓwa nəshi kwon wa tala, hakə gɔ lwe dya lagwa də yimɓa, cwi nəngwi fi ngə dang jang la dangdi agang. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Ku cwa nang ɓa byagɔnə ɓa nashoo ngu ya, ngwi nganpan ngɛ gha lase yona zwa nangpan. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Gɔ ngəla la nang myə yi nangpan ni, kə do nang ngɛ ɓa gu la məngan, kə nwi zhĩ ɓa tɛ tang. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />A ngɛ ɓa fi gu la la nta yido bu nene ni kəɓa cwi ɓa be yonemani kəme sɔ swɛla. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ama kə sadenang lo canə saɓa ni kə ɓa zwe kupaca, yonəmani ntã ɓa nyanla, kə nangpan ɓasɔ swon kupaca. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Angɛ ɓa ye shi shĩ ɓa ɓanə kũ ni, angye ɓa kə kũ lwe gang kwe shi ɓa. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Angɛ ɓa fi gu layi do azãzã, kəɓa mya angɛ ɓa kaan nto angɛ ɓa ka nca, ngɛ ɓa ka nso cwi jwua&gt;&gt; <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Kəfi Yesɔ yeshiwa, &lt;&lt;Wani, nankənə, inə aɓa yicwe neniǃ&gt;&gt;.<verse eid="MAT 13:9" /></para>
  <para style="s">Danfĩ nang cwayo ɓa nashoo</para>
  <para style="r">)<ref loc="MRK 4:10-12">Maku 4.10-12</ref>; <ref loc="LUK 8:9">Luka 8.9</ref>,<ref loc="LUK 8:10">10</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />kə nwi nangjwa yesɔ ɓa mɓa kə byəwa ya , &lt;&lt;ka yonə sɔ nga cwanə nashoo ni ma? <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Yesɔ dya ɓanə ya, &lt;&lt; Nang nyi yi yo yido negang la lankwã ɓa noa ngɔn, ama lasaɓa la. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />yonə mani ngwi nang ɓanə nang nəni ɛ twawashi hakə mawayi wanə; ama ngwi nang nene ɓa nang ngɛ nəni ɛ cwe ɓewo la pika nang ɓanə kəɓə ni. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Nang nə nang ngə cwa ba yoni ɓa nashoo nəni kəye, nga ɓa sangdo, ama kə la sang la, ɓa yicwe nə, ama kə la wadonla Ko ɓa nyi. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />&lt;&lt;lanle dang yo yi dang doswon Ishaya pɛ lashi ɓa ya,</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt;&lt;Ngwi ɓani la wuwa kəfi ɓa wa, ama kɛ nyi la ko la pika;</para>
  <para style="q2" vid="MAT 13:14">Nga sa nang sang, ama kɛ sang la ko la pika.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />yonəmani sɛgwɔn ɓa ngənə asɛsɛ ngɔn,</para>
  <para style="q2" vid="MAT 13:15">kəfi ɓa gũ yicwe ɓa kəfi ɓagũ zayi ɓa .</para>
  <para style="q1" vid="MAT 13:15">Nte zayi ɓa la sangdo,</para>
  <para style="q2" vid="MAT 13:15">yicwe ɓa la wado wa,</para>
  <para style="q1" vid="MAT 13:15">yona nyi ɓa sɛgwɔn ɓa, hakə kəfi ɓa ɓeyi ɓa lasa mə, Nyimoː cwa, &gt;</para>
  <para style="q2" vid="MAT 13:15">kəfi gəmə nyɔndi gaɓa<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />&lt;&lt;Laso wa gɔni, ka yiri balka anwa gua nəǃ Zayiuwa nga sangdo kəfi yicwowa nga wado. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />yo ade ngə cwo wanə, ngwi dang doswon ɓa ngwi adeɓa shãna sang nang gua, ngu sang ni, ama ɓa menla, gaɓa fi wa ama fi menla.&gt;&gt;<verse eid="MAT 13:17" /></para>
  <para style="s">Yesɔ cwa danfĩ yo nashoo yi ngwi zwanang</para>
  <para style="r">)<ref loc="MRK 4:13-20">Maku 4.13-20</ref>; <ref loc="LUK 8:11-15">Luka 8.11-15</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt; Wasamə, nankənə dang nashoo yi ngwi zwanang ngəni ye, <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />ngwi ɓa wa nə yo sa donyang ni ama ɓa nyila ni ɓa ngəna yi nanpang nə angye ɓa yenə la məngang ni. Kə shetan mɓa vya nang zwanə la sɛgwɔn ɓa ni. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Angye ɓa gunə la yido nta ni kaɓa nə ngwi wanəyo Nyimoː kə cwe ɓa nang wanua nə ɓabe gə kəɓa wani. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ama dyanla ɓa zəwa nə jado la , sade nang laɓyɔ Mewa nə sa yosɔ, kəɓa vfaɓesa yo sɔ kəɓa fi zinze layimɓa. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Yinangpan angye nang ɓa zwa ni layi do kũ ni kaɓa ngwi angye nang wanə yo Nyimoː, ama yo nang chəng kəfi nanshan nang mɛ kə kwon wa yo wani tala, hakə dənə nene ɓa bwatɛ ne ni. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Kəfi yi nanpang angye nang zwanə layi do azãzã ni fi ka kaɓa nə ngwi ɓa nang wanəyo Nyimoː ni kəfi nyinang yosɔ nga cwaniː hakə na bwatɛ, ngɛ ɓa kaanto, kəfi ngɛ ɓa kanca ngɛ ɓa fi kanso cwi njwa. &gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">Nashoo yo yi vii</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesɔ ma cwa nashoo ngɛ nə ya, &lt;&lt; Yi nəgang lankwã ngə na nang niː nəngwi zwa nanpang azãzã la lase gɔ. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ama sade nang nwaku nga nə yinga ni, kə ngwi shido ɓa zwa yi vii la lase kəfi kwenə ɓe. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Sadenang yi nanpang gang ni kəfi sayi yi nanpang lwe nə ɛ cwenla ni na nənə yii ni, nankənə kə vii ɓani nga caɓesa saɓa la baba.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />&lt;&lt;nwi layi shãyi ɓasɔ kəɓa mɓa sɔ kəɓa ya,&lt;shayi, jeni, ka donang a zãzã zwa lase gu la ma? Kə bəɓa paca vi cwi layi ɓa ma?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />&lt;&lt; Kə cwa ɓanə ye, &lt;ngwi shi gə ɓa nə nang ni,&gt;</para>
  <para style="p" vid="MAT 13:28">Kə nwi layi ɓasɔ cwonə ya, &lt;nga sha gha və ɓa ma?&gt; <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />&lt;&lt;&lt;Ama gɔ cwaɓanə ya,&lt; &lt;A'a, &gt; yoshinə sade ngu vənə vi ni kəfi gua və ɓa nanpang ade nəɓe. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />vya ɓa ku gang nso hakə sade nang sha ɓani, sade nang shã ɛ cwa ngwi shã nang ɓa gəmbe na və vi ɓa ɓwa nəshi donso dwə ɓa zwe ɓa, kəfi ngɔn ni kə ɓwanə nanpang ade a ye laɓyẽ. &gt;&gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">Nashoo shi yii nanpang yinshɔ</para>
  <para style="r">)<ref loc="MRK 4:30-32">Maku 4.30-32</ref>; <ref loc="LUK 13:18">Luka 13.18</ref>,<ref loc="LUK 13:19">19</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />ye ma cwaɓa nashoo nə ngu ya,&lt;&lt;Yido nəgang Nyimoː la lankwã na yii yinshɔ nə angye nang ngə la nyangshang ni lasa donang ɓa kuni, kə ngwi mə ngə cwe zwa lase gɔ. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />kəɓə nə a nyangshang latangte donang ɓa, ama sadenang gang ni kə bwanə pashi lasɔ nɛgang, hakə ma nwizhi ɓa mayi gaɓa lasa pawa.&gt;&gt; <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" /></para>
  <para style="s" vid="MAT 13:33">Nashoo shi yisti nang fun nwa</para>
  <para style="p" vid="MAT 13:33">Yesɔ mafi cwaɓa nashoo nə ya, yido nəgang Nyimoː la lankwã ngə na nangni, angye nang gwaməngɛ lanə Yisti ɓa kaanang tancã yi muu tapu, hakə ku paca muu tapu sɔ lwe lãnəɓe.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="s">Yesɔ nə nangnu ɓa nashoo</para>
  <para style="r">)<ref loc="MRK 4:33">Maku 4.33</ref>,<ref loc="MRK 4:34">34</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesɔ cwa cwi nəngwi nə paca nang ɓani ɓa nashoo. Nang ngɛ nene lu cwanə se ɓa nashoo. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Nangni yona pɛ nang ɓa ngwi dang doswon cwani ya,</para>
  <para style="q1" vid="MAT 13:35">gəmə ngə cwayo ɓa nashoo,</para>
  <para style="q2" vid="MAT 13:35">sadenang nang ngə cwanyo ɓaɓa ni;</para>
  <para style="q2" vid="MAT 13:35">ngə cwaɓa nang ɓa nyila ni namɓa gəmbe manə lasapyang ni.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">Yesɔ bwa nsalo cwa nashoo yi vi</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Sadenang yesɔ vya cwi nəngwi ɓa ngu dya layi ni, nwi nangjwa gɔɓa ɓa mewa kəɓa ya, &lt;&lt;A cwenə nashoo yi vi lasẽ ni.&gt;&gt; <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />kə u dya ya, &lt;&lt;Ngwi nang zwa donang azanzan kəɓənə Nwi Nəngwi. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />lasẽ kəɓə nə lasapyang; donang azanzan kəɓənə ngwi ɓa kanə yi donyang Nyimoː ni; vi kəɓənə ngwi anjɔ ɓa; <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />kəfi ngwi shi do zwa nə vini kəɓənə shetan. Sade shanang kənə sayi yeshi sapyang ngwi shãnang pan ɓasɔ ka maleka ɓa. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Na nang nga ɓwanə vini nga zwenə lava ni, nankənə ɛ də sade yeshi lasapyang. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Nwi Nəngwi ɛ, swon maleka gɔɓa ɛ ɓwanə ngwi nang ɓa nyang nə nəngwi ɓa nga nənə nang anjɔ ni. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />gaɓa fi ɛ cha ɓa la la va a ganga layimɓa ɛ lɛlɛ nga gwa nyi ɓa. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Nankənə ngwi yi Nyimoː ɓa ɛ pyən na lo nə la layi donyang yi Daa gaɓa. Wani, nankənə, inə gua ɓa yicwe nəni.<verse eid="MAT 13:43" /></para>
  <para style="s">Nashoo lashi Nang me nang Jwanjwa ni</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;Donyang lakwã na nang me na ɓa jwa nə lasẽ ni, ngwi ngɛ mɛ, fi ma jwa. ngu gha kə u yaɓa nang gɔ ku ɓanə kə ni, kə u ya lasẽ sɔ.<verse eid="MAT 13:44" /></para>
  <para style="s">Nashoo sa nang ade ɓa jwani</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Aɓɛku, Kə donyang Nyimoː ngə na nang ni. Ngwi ngɛ ngənə nga ka nang azãzã, <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />kə mɛnə nang azãzã sɔni, kə u gha u yaaɓa nang gɔ ɓanə kəɓə ni kə u yenə dosɔ.<verse eid="MAT 13:46" /></para>
  <para style="s">Nashoo yi kaã gwa ju</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt; Habe ku, donyang Nyimoː ngə na nang ni. Ngwi gwa nwinju ɓa yenə kaã gaɓa la yidi a gang kəfi gwa nwinju ɓa chocho. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />kə pɛni, kəɓa da ɓanə la dang njang dangdi agang kəɓa dəmi ganə ju, kə nte nwinju azãzã. kaye la sinɔ kəɓa ye angye nang ɓa zã lani kə yegha. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Nankənə a də la sayi yeshi lasapyang, maleka ɓa ɛ mɓa kə bwanə ngwi anjɔ ɓa lasa ngwi ade ɓa. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />kəfi ɓa cha ngwi anjɔ ɓa la va a ganga, yido nang la lɛlɛ ɓa nang tang yi nyi ni.<verse eid="MAT 13:50" /></para>
  <para style="s">Nang apa ɓa a cwon</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesɔ ɓyəba.&lt;&lt;Ngu nyi nang ɓani ngɔn ku ma?&gt;&gt; Kəɓa dyanə ya &lt;&lt; Ngɔn, &gt;&gt; <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />kə gɔ cwa ɓanə, nang ni, nankənə ni, paca ngwi maɓesa nangzhĩ Musa, laɓenə, nwi nangjwa donyang lankwã, ngəna shayi nang munə nang apa kəfi a cwon lasa yido ɓwa nang gɔ.<verse eid="MAT 13:52" /></para>
  <para style="s">Ba nyi Yesɔ la Nazare</para>
  <para style="r">)<ref loc="MRK 6:1-6">Maku 6.1-6</ref>; <ref loc="LUK 4:16-30">Luka 4.16-30</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />kə yesɔ yeshi nang cwa yoɓa ni ɓa nashoo ni, kə vya yidosɔ, <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Yesɔ mɓa yii gɔ, Gɔ ngu fudi na maɓaɓe sa ɓa nang la lanywi ɓwa nəshi, kə ngwi ɓa wanə sawa ni yi gwa ɓa.&lt;&lt; Laje ngwi ni mɛ nang nyi ni ma? Kəfi ɓa njamu nə nang ɓani yi nang yiswe ma? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Ka kɔnə nwi ngwi gbashi nywi laya ma? Ka naa gɔ nga kwi nə Maryamu lama? Nwi naa gɔ ɓa yakubu ɓa yusufu, ba siman ɓa yahuda lama? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Nwi naa gɔ ɓa anəngwa ɓa ngə lanle lama? Laje kə u mɛnə nang ɓani ma?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Kəɓa nyiwa.</para>
  <para style="p" vid="MAT 13:57">Yesɔ cwa ɓanə ya, &lt;&lt; Nga naa ngwi dandoswon gang laje ku ama layi gɔ la kəfi la ladowa.&gt;&gt; <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Yonəmani gaɓa nene ɓa yoadəde nə, gɔ nə nang yiswe ɓa ɓyagaɓanə layimɓa.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Nang wuu Yohana wanə Botisma</para>
  <para style="r">)<ref loc="MRK 6:14-29">Maku 6.14-29</ref>; <ref loc="LUK 9:7-9">Luka 9.7-9</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Sade nang Hiridu kane kwə la Betalami ni kə gɔ wa abaru yi Yesɔ. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />kə cwa ngwi nə nang gɔɓa ya, &lt;&lt;ngwi ni ka kɔnə Yohana ngwi nə Botisma, kɔɓə kə lwe ɓa winə la lajweǃ kəɓə nə kə ngu nə nangnu yi nang yiswe.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Ɓeni Hirudu gəmbe gwa Yohana dwə cwe taa la fusina, yonə mani gɔ fye Hirodiya gwa nwinyiwa Philibus. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Yonəmani, Yohana nga cwa Hiridu nəː&lt;&lt;zanla ka fye ngwa winyu ni.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hiridu shan na jə Yohana, ama ngu yii nəngwi ɓa, yonəmani nəngwi ɓa nga cwe Yohana ka ngwi dang doswon. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Sade nang yinywɔ nang mya yi Hiridu ɓa ni, kə nwi Hirudiya anəngwa ɓwadang la yido yinywɔ sɔ lasibe Hiridu kə wanɔwa. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />ku nə wa akawa nə ya, &lt;&lt;gəmə ghanang ngɔn nangku nga shani ngə nonaǃ&gt;&gt; <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Naa gɔ cwanə ya,&lt;&lt;a nema lashi Yohana wanə Botisma la la tasɔ ɓeɓe.&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />kwə Hiridu wanua nla, ama yo akawa sɔ gɔ nənə ni labe ngwi zhɛ ɓa ku na dang ya ɓa gha a ɓanə lashi Yohana ngwi nə Botisma na nang nwisɔ shang ni. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ku nyang gha kə̃ lashi Yohana la lafusina. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />kə ɓanə lashi Yohana la la tasɔ kə cwe nawa, kə nwi nengwa sɔ gha nə gha na naa gɔ. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />ngwi gagwe Yohana ɓa ɓa cwe nkwonsawa gha nə gha di. kəfi ɓa gha cwa Yesɔ nə.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesɔ Tang nə Nəngwi ɓa Ka dəbu nto</para>
  <para style="r">)<ref loc="MRK 6:30-44">Maku 6.30-44</ref>; <ref loc="LUK 9:10-17">Luka 9.10-17</ref>; <ref loc="JHN 6:1-14">Yohana 6.1-14</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Sade nang Yesɔ wanə yo sɔ lashi Yohana ni, kə u vya do sɔ kə jegwa kə kwə nəɓe la do nang ngwi ngɛ nene la yimɓa ni. Kə nəngwi ɓa wanə, kəfi ɓa vya yii gaɓa kə ɓa kasawa ɓa gagwe. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yesɔ bwanə la lagwa ni, Sade nang Yesɔ sang nə cwi nəngwi ɓa ni ku sang laɓyɔ gaɓa, kə nyɔndi ngwi nang jwə gaɓa. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Kə lo gwani kə nwi nangjwa gɔɓa ɓa la sawa, ɓa yee wa ye,&lt;&lt;Lo gəmbe gha ngɔn kəmi, a nyang ngwi ɓa ni kwe nə be yii, yo na gha dya la wii yi ni, kə ɓa kã nang ɓa lashi ɓanə la tang ni.&gt;&gt; <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Yesɔ cwa ɓa nə zanla na ɓakwe nəɓe gua una ɓa nang ngɛ ɓa tang.&gt;&gt; <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />&lt;&lt;Nankəbənə kə ɓa nə nwa nə nto ɓa nwinju nə nə mba.&gt;&gt;kə ɓa cwa yesɔ nə ya.<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />&lt;&lt;Yesɔ ye ɓa ya ɓa ɓanə la bemə&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Yesɔ cwa nəngwi ɓa nə yaɓa də la timi shi vii; Yesɔ cwe kunbang nə nto ni ɓa nwinju mba ni, kə cwe zayi wa lwe nə la lakwã, kə unə Nyimoː nwi sakko nə. Kə gwa kunba nga gbənə ɓe na nwi nangjwa gɔɓa kə ɓa ganə nəngwi ɓa. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Ngwi ɓa niku a tang hakə laɓa je, nwifi wa nwi nangjwa gɔɓa tẽ pɛ tsinɔ njwa cwi mba. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Nəngwi ɓa tang nang niɓa ɓa dəbu nto, ɓa cwa nwi jwɔn nəngwa ɓa nwi jwɔn anəngwo ɓa nla.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesɔ Zhazho La Shi Di</para>
  <para style="r">)<ref loc="MRK 6:45-52">Maku 6.45-52</ref>; <ref loc="JHN 6:15-21">Yohana 6.15-21</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ɓabe gə kə Yesɔ nyang nwi nang jwa gɔɓa kə je gwa kə ganɓa kwe la byəng ango, zinze gɔ kə nyang cwi nəngwi ɓa ɓanə bewa ni kwe. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Zinze nang nyang cwi nəngwi ɓa kwe ni, kə Yesɔ kwe nə ɓe la shintaa ɓa lashi wanə yona pẽdang kə yidavu mɛ wa la yimɓa ɓansɔ. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ama la sayi sɔ gwa nwi njwa gɔɓa ngə ngɔn ɓa jagɔnə la shaka di ɓa danjang, gwedi nga tɔri gaɓa. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Latangte ce nca ɓa ce ntoji ɓa nvulanə Yesɔ kwe nə ɓe la sa nwi nangjwa gɔɓa, ngu zhã la shidi. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Sade nang nwi nangjwa gɔɓa sɔnə la shidi ni, kə sayi gwa ɓa, &lt;&lt;aya ka gwe,&gt;&gt;kə ɓa nyang kunə ɓa yinə. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Ama Yesɔ cwa ɓanə gwasoa nyanya ɓaɓu yiyi laǃ &lt;&lt;ka kəmə.&gt;&gt; <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />&lt;&lt;Daa shayonki nə ka kuni,&gt;&gt;Bituru byə do, a cwa mənə zha la shidi mɓa bo.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />&lt;&lt;Yesɔ cwawa nə yee aɓa.&gt;&gt; kə Bituru bwa la lagwa kə tse la shidi ngu ɓa be Yesɔ. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ama sade nang Bituru sang nə gwe ni, sawa yiyi kə fudi na zədi, kə u jaku,&lt;&lt;Daa shayonki apon mə doni&gt;&gt; <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Ɓabe gə kə Yesɔ ndã gaɓe wa kə gha gwa gaɓe wa.&lt;&lt;Gu ngwi yo ade la pika niǃ Ka yonə a chəng yo ma? <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Kə sade nang ɓa jenə gwa ni, kə gwe sɔ ngə kəmi. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Kə nwi nangjwa gɔɓa ngə nə la lagwa ni kə ɓa na Yesɔ gang ɓa ya,&lt;&lt;Yoade gu aka nwi Nyimoː&gt;&gt;Gaɓa cwa.<verse eid="MAT 14:33" /></para>
  <para style="s">Yesɔ nyɔndi ngwi nangjwə la Janisare</para>
  <para style="r">)<ref loc="MRK 6:53-56">Maku 6.53-56</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Kə ɓa gang di kəfi ɓa mɓa la kəmi Janisare, <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />kə sade nang ngwi timi ɓa sɔ sang Yesɔ ni kə nyi ya Yesɔ ye, Kəɓa swondo sa ngwi nangjwə ɓa ku la ɓe yi gaɓa kəfi ɓa mɓanə be Yesɔ. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Ba jua vya ngwi nang jwə ɓa twɔn ɓe sa dang nang dangswe gɔ, kə nəngwi ɓa twɔn nə ɓesa dang nang danswe gɔni, kə nang jwə gaɓa ka.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Nang maɓenə yi Daagan ɓa</para>
  <para style="r">)<ref loc="MRK 7:1-13">Maku 7.1-13</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ba ngənə kə Farisawa ɓa ngwi maɓesa dang nangzhĩ Musa kəɓa mɓa be yesɔ la Urshelima kəɓa ya. <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt; ka yonə ngwi maɓesa nang gua nga gbeng dang nangzhĩ nwanye ɓa ma? Yonəmani lawa gaɓe ɓa la nga tang nang &gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesɔ dya ɓanə ya, gua gɔ, kayonə lu na gang sa yo Nyimoː nla kə ngu kasa nang maɓenə gua ma? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Nyimoː ya, a na daa gu ɓa naa gu gang,&lt; Inə cwɛ daagu ɓa naa gu ɓa zhang ngɔn ni, zəzan ɓa jəu.&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ama ngu maɓenə ya, inə nəngwi ngɛ banang ngɛ na bali daagɔ ko naa gɔ ɓa kəɓə ngɔn ni, ama ngu ya paca nang lu mɛnə lasa nang mə ni kayi Nyimoː,&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />gaɓa zanla na naa daa gaɓa gang . la yidoni gua na dang nangzhĩ Nyimoː gang nla, kə u kasa nang maɓeni gua. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Gua ngwi fundang lashiu ɓaǃ nua bəɓa sayo Ishaya ngənə sade nang gɔ cwanə yo nang ɛ nənə nang lasowa yo gua niǃ <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />&lt;Ngwi ɓani, Nyimoː cwa ya,</para>
  <para style="q2" vid="MAT 15:8">ɓa la shidang ɓa kə nga nəmanə gang,&lt;</para>
  <para style="q2" vid="MAT 15:8">ama sɛgwɔn ɓa ngə ɓa jagɔ ɓamə.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Nang ju gaɓa nga nəmə ni ka anyise,</para>
  <para style="q2" vid="MAT 15:9">yonəmani gaɓa nga maɓesa nang nəngwi ɓa lashi nangzhĩ gaɓa ni&gt;&gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">Nang ɓa la nyang nəngwi la zãlani</para>
  <para style="r">)<ref loc="MRK 7:14-23">Maku 7.14-23</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yesɔ kwi cwi nəngwi ɓa ngu cwa ɓanə ya,&lt;&lt;u, wa kəfi nyiǃ <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Nang ngɛ nene la dyanə sidang nəngwi nga nyang wa nə nang anjɔ; se nang nga bwanə lasido ni kə nga nyo atɛ̃ nla.&gt;&gt;&gt; <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Kəfi nwi nangjwa gɔɓa mɓa bewa kəfi ya, &lt;&lt;A nyi ngɔn Farisawa ɓa nga jwə sɛgwɔn sa yo nga cwa nəni?&gt;&gt; <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Yesɔ dyanə ɓanə ya, &lt;&lt; paca shi nang ka Daagə la lankwã zwanə lani ɛ vuəɓa yagha,&gt;&gt; <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Baɓu chəng nang ngɛ yo gaɓa laǃ Gaɓa ka nwanye ɓwonyi ɓa sa ngwi ɓwonyi ɓa; inə ngwi ɓwonyi gwa ngwi ɓwonyi shi ngɔn ni gaɓa ku ɛ gu lajwe.&gt;&gt; <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Bituru cwa Yesɔ nə ya, &lt;&lt;Acwɛ dangfi nashoo ninə.&gt;&gt; <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yesɔ cwaɓanə ya,&lt;&lt;gua ma aɓeku unyi lama?. <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Gua nyila nangku dyanə la ladang ni nga gha la ma kəfi ɛ bwa yekəmi lasoa. <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ama nang la bwanə la sidang bwa la sɛgwɔn ma, ka namɓa nga nyowanə sa nəngwi la tẽnə nlani wa. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />yonəmani la sɛgwɔn kə nang chəng anjɔ ɓa nga bwanə angye nga nyowanə na jənədo ni, nang nə dã, kəfi nə yiri na ɓa zanla la na nən ni; na yinang, sadang, kəfi cwe ngwi ngɛ ɓa ɓa zhang <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ka namɓa nga nyowa te lani wa. Ama tang yi nang wagaɓe nla na nang ɓa cwani ya gua nəni, nangni la nyo la ka zanla la.<verse eid="MAT 15:20" /></para>
  <para style="s">Yoade ngwi məngɛ la kəmi Kaana</para>
  <para style="r">)<ref loc="MRK 7:24-30">Maku 7.24-30</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesɔ vya dosɔ kə gha byəng ɓadi ɓa yii agang Taya ɓa Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />kə ngwa Kaana ngɛ dənə kəmi sɔ ni ɓasɔ, &lt;&lt;Gwɔgwɔ Dauda.&gt;&gt; ngu lɛlɛ ɓa nyenə. &lt;&lt;Asang laɓyɔ gəǃ Nwimə anəngwa ɓa gwe anjɔ nə kəfi ngu fa laɓyɔ.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Ama Yesɔ nyina cwa wa yo ngɛ nə nla. kə nwi nangjwa gɔɓa mɓa jua &lt;&lt;A bi wa chahaǃ Gɔ ngu kafi ye ngu bwonku&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Kə Yesɔ dyanə ya, &lt;&lt;Ba swon mə yo ngang Isrela ɓa lang ni.&gt;&gt; <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Lanle kə ngwa sɔ mɓa nwami la gagwe wa. ngu ya, &lt;&lt;Daa shayonki a bali gə&gt;&gt; <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Yesɔ dyang ya, kɛ zanla na cwe nang tang nwi jwɔn ɓa cha nwinja nə la.&gt;&gt; <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />&lt;&lt; Kə cwa, nshayi,&gt;&gt; ama ko nwinja, ma nga tang nang nga gunə lashi shi nshayi ni.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />&lt;&lt;Kə Yesɔ dya wane ya, &lt;&lt;gu aka ngwa nang ɓanə yoade anyanya nəniǃ Kanə nga shanmə na nunə.&gt;&gt;Kəfi la sade sɔ kə nwiwa anəngwa nyɔndi.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesɔ nyɔndi nəngwi ɓa ɓyagɔnə.</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesɔ vya yido sɔ kə fi kwe la ɓe dangdi Galili. Gɔ jenta kə də kəmi. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Cwi Nəngwi ɓa byagaɓanə kəɓa mɓa sɔ, kəɓa mbanə ngwi swe gwe ɓa, ɓa ɓwonyi ɓa, ɓa ɓwon cwe ɓa ngwi ɓa ɓyagaɓanə , kə nyang ɓa la gagwe Yesɔ; kɔfi nyɔndi gaɓa. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Hakə nang yiswe gwa nəngwi ɓa sang nə ngwi bwon cwɛ ni nga cwanəyo ngwi swe gaɓe ɓafi yiga gaɓe ɓa nga nə nangnu. ngwi swe gagwe ɓa nga zhãzho, ɓwonyi fi nga sangdo, kə gaɓa ku nga ɓwɔn Nyimoː Isrela.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesɔ Tang Nə Nəngwi Kaajwa Fin Nea</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />kə yesɔ kwi nwi nangjwa gɔɓa kəfi cwa ɓanə, ya, ngə sang laɓyɔ nəngwi ɓani yonəmani gwen nca ɓa ngə ɓamə fi ɓa nene ɓa nang la tang nəni. ngə shan la na taɓa ɓe kwe ɓa nywe nə, yona ɓe gu la məngang la nga ghanə yi ni. <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Kə nwi nangjwa gɔɓa byə wa ya, &lt;&lt; Laje je limənə nang tang la manə nəngwi ɓa ni ma?&gt;&gt; <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Kə Yesɔ byə ya,&lt;&lt;Nwa na aɓa kəbənə ma? Kəɓa ya, &lt;&lt;Nə nto mba ɓa nwinju la pika &gt;&gt; <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Kə nyang cwi nəngwi ɓa də kəmi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Kə cwe nwa ni nto mba ɓa nwinju. Kə u wisi sa Nyimoː, kə ganə ɓe, ku na nwi nangjwa gɔɓa, nwi nangjwa gɔɓa naa nəngwi ɓa. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Nwaku tang hakə laɓa je. Kə nwi nangjwa gɔɓa mu fi nang vyanə ni pɛ sinɔ nə nto mba. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Nəngwi ɓa angye tang ni ɓa gha nyinəwo ɓa kajwa fi nea ngɔn. la cwa nyənəgwa ɓa nwinjwɔn ɓa la. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Lazinze kə Yesɔ taɓa nəɓe ɓa, kə dya lagwa, kəfi kwe nə kəmi Magada.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Nang Kã Yiswe</para>
  <para style="r">)<ref loc="MRK 8:11-13">Maku 8.11-13</ref>; <ref loc="LUK 12:54-56">Luka 12.54-56</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Loɓəngɛ Farisawa ngɛ ɓa ɓa Sadukiyawa ɓa byə Yesɔ yona mawa, kəɓa jua ngu nəɓa nang yiswe nang la ngənə dansãyo la canəɓenə ya Nyimoː canəɓesɔ ni. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Yesɔ dya ɓanə ya, &lt;&lt; Nə lo gu ngɔn ni, gua u ya, je ɛ mə dokwã ade, yonəmani u sang lankwã ngə ne fe. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Ba vulanə ngɔn ni gua ya, di ɛ nəna, yonəmani lankwã ngə na fye kəfi nə yidavu.&gt;Gua lu cwa nang lankwã ɓani sa sang yi lankwã, ama kuɓa na cwa nang ɓa nga nənang la sayi ni laǃ <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Ngwi lasapyang ɓani ka ngwi anjɔ ɓa a nyi Nyimoː nlaǃ Gua shãna sang nang yiswe laɓe ma? Dənlaǃ Nang yiswe la nowa nəni seka yi Yonana.&gt;&gt;</para>
  <para style="p" vid="MAT 16:4">Nankəbə kə kwenə ɓe vyaɓa.<verse eid="MAT 16:4" /></para>
  <para style="s">Nang funang yi Farisawa ɓa Sadukiyawa ɓa</para>
  <para style="r">)<ref loc="MRK 8:14-21">Maku 8.14-21</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />kə nwi nangjwa gɔɓa gang di kwenə la byəng di ni, gwɔn ɓa ja na cwe nwa . <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />kə yesɔ cwa banə ya, Ngu nə akilo ɓa nang funang yi Farisawa ɓa Sadukiyawa ɓa.&gt;&gt; <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />kə fudi na cwayo nəsa ɓa, &lt;&lt;Gɔ cwayo ni yonəmani gaɓa mɓa ɓa nwa nənla.&gt;&gt; <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Kə yesɔ nyi nang nga cwani ngɔn, kə u byəɓa&lt;&lt;ka yonə ngu ya gua nene ɓa nwa nə ma? Gua ɓa yoadəde nə la pikaǃ <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Haɓe ku gwa wa ja ngɔn sadenang gəmə gbənə nwa nto ni yo nəngwi kaanto fin jwua finto ni ma? Sinɔ na gua pɛ nə ɓa nwa? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Kəfi kane? Sinɔ na gua pɛnə? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Bəɓa gua nyila ya gəmə ngə cwowa yonə yo nwa la? Ngə ya ngu nə akilo sa nang funang yi Farisawa ɓa Sadukiyawa ɓaǃ&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Kə nwi nangjwa gɔɓa nyi ya gɔ u laɓa yo nang funang nga nənə nangnu sa nwa la ama sa nang maɓenə yi dansa Farisawa ɓa Sadukiyawa.<verse eid="MAT 16:12" /></para>
  <para style="s">Bituru Shede Yesɔ Ka Nwi Nyimoː</para>
  <para style="r">)<ref loc="MRK 8:27-30">Maku 8.27-30</ref>; <ref loc="LUK 9:18-21">Luka 9.18-21</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Kə yesɔ mɓa la yi Kasariya Filibi, kə byə nwi nangjwa gɔɓa ya, &lt;&lt; kanə nəngwi ɓa nga cwa ya nə Nwi nəngwi ka kəɓəma?&gt;&gt; <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Kəɓa ya, &lt;&lt;Ngwi ngɛ nga ya, Yohana wanə Botisma, ngwi ngɛ fi Iliya, ngwi ngɛ fi Irimiya, ko fi nso latangte ngwi dang doswon ɓa&gt;&gt; <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />ka nə gua gɔ cwa? &lt;&lt;Ka nwa gua chəng ya gəmə ka nwa?. <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Kə Siman Bituru dya &lt;&lt; kaku nə Almasihuː Nwi Nyimoː ngənə ɓa wi ni.&gt;&gt; <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />&lt;&lt;Zəzan laso Siman nwi Yohana&gt;&gt;Yesɔ dyawa nə&lt;&lt;Yonang yoade ni bwala ɓe nəngwi anvi la, ama ɓa naa lasa Daa gə la lankwã. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Ngə cwonə, Bituru gu aka nta, lasa nta ni kə ngə tasəvi yido ɓwa nəshi ngɛ, ko wii ajədo ma kɛ bana tawiwa la. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ngə no nang bwe dang donyang yi lankwã; nang ku a dwə nə lasapyang, ɛ, dwə la lankwã nang ku a vĩnə ngɔn la lasapyang ni, ɛ vi la lankwã.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Kə Yesɔ nyang nwi nangjwa gɔɓa ɓɛ cwa ngwi ngɛ nə la ya gɔ ka Almasihuː.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesɔ cwayo sa laɓyɔ u fani ɓa nang wuu gɔ</para>
  <para style="r">)Maku 8.31-9.1; <ref loc="LUK 9:22-27">Luka 9.22-27</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Lasade sɔ kə Yesɔ fudi na cwa nwi nangjwa gɔɓa nə la baba, ya gənə sɛnə gha urshelima jang kəfi nə fa laɓyɔ chocho laɓe nwanye ɓa, Nwanye nyanang ɓa, ngwi maɓesa nangzhĩ Musa ɓa. Ngɔn ni fi ɓa jəmə, ama la gwe nca gəmə ngə lwelwe ɓa wiinə.&gt;&gt; <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />kə Bituru dawa dagɔ nso ngu fudi na cwawa yo nə ɓa lɔ.&lt;&lt; Nyimoː bido nə, Daa shayonkiǃ nangni kɛ nənang laso la&gt;&gt; <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Yesɔ ɓeyi wa kə cwa Bituru nə ya, &lt;&lt;Aja kwe lanle la bemə, gu aka nang nga ɓanə nang zanla samə la məngang, yonəmani Nang chəng ɓani bwa labe Nyimoː la, ama sa nang cheng yi nəngwi.&gt;&gt; <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />kə yesɔ cwa nwi nangjwa gɔɓa ne ya,&lt;&lt; ngwi paca nga shãna kafi məni sɛ nyilashi wa, cwe shi agang gu a kafi mə. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />yonəmani paca ngwi nang shãna pong wiwa ni kɔ mɛla, Ama paca ngwi nang ku nanə wiwa yo gəniː, lu məwa mɛ. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />ka bwatɛ a wa nəngwi lamɛ, Na mɛ nang lasapyang paca ni, ama mɛ wiinla ma? Kɛ dəlaǃ Nang ngɛ nene lanaa kə la menə yonki gu. <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Nwi nəngwi zədo ngɔn na mɓa ɓa yi nəgang yi Daagɔ ɓa Maleka gɔ ɓanə, Ngɔn ni kə nawa bwatɛ gɔ sa nangnu gɔ nəni. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />yoade ngə cwowanə ngwi ngɛ ɓa ngənə lanle kɛ wula, hakə sɛ sang nang mɓa Nwi nəngwi be.<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Nang ɓeswe Yesɔ</para>
  <para style="r">)<ref loc="MRK 9:2-13">Maku 9.2-13</ref>; <ref loc="LUK 9:28-36">Luka 9.28-36</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />La zinze gwe ntoji kə Yesɔ cwe Bituru ɓa Yakubu, ɓa nwinyeɓa Yakubu ɓa Yohana ngu gha ɓanə lashi nta, yido gɔ ngə ɓa sɔni, <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Kə nga sang ni, kə nang pyɛ swe mɓa sa Yesɔː sibewa nga pyẽ na lo nə, kə nangja swe gɔɓa ɓənə nə wãvi. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ɓabe kə ngwi dang doswon Musa ɓa ngwi dang doswon Iliya kəɓa bwa sawa, nga cwayo ɓa Yesɔ.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Kə Bituru cway ya, &lt;&lt;Daa shayonki, zã ngɔn je ngə lang le, Ngə nga shani gəmə ngə ma mbabĩ nca lanleǃ nso yigu , nso ngwi dandoswon Musa, nso yi ngwi dandoswon Iliya&gt;&gt; <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Sadenang gɔ u cwanə yo ni kə nkwa ɓa dang ɓa, kəfi laghɔ la lankwã ya, &lt;&lt;Ka Nwi mə ashanshan ye, angye ngə wanua mə ɓawa ni, u wasawaǃ&gt;&gt; <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Kə nwi nangjwa gɔɓa wanə na nangni, kə yii gwa ɓa. hakə ɓa gu kəmi. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ama Yesɔ mba ɓa twɔnɓe saɓa. &lt;&lt; ulwe &gt;&gt; ngu ya, &lt;&lt;ɓu yiyi la&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Kə lwe sang lankwã kəfi ɓa sang ngwi ngɛ nla nso seka Yesɔ. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Kə ɓa sinə la shi nta ni, Yesɔ da jachwe ɓa ɓu cwa ngwi ngɛ nə la gua sang ni. sɛ Nwi nəngwi lwe la shije mbe.&gt;&gt; <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Nwi nangjwa gɔɓa byə Yesɔ ya, &lt;&lt;ka yonə ngwi maɓesa nangzhĩ Musa ya sɛ ngwi dang doswon Iliya gəmbe na mɓa begə ma? <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Kə Yesɔ dya ɓanə,&lt;&lt;Yoade se Iliya ɛ mɓa gəmbe,&lt;&lt; fi manə ɓaku. nyang. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ama ngə cwo wane, Iliya gəmbe ama ngɔn ama ɓa nyiwanla, hakə ma nəwa nang ngɔn shani ngɔn. <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Kə nwi nangjwa gɔɓa nyi ya, gɔ ngu cwayo la lashi Yohana wanə Botisma.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesɔ Nyɔndi nwinjwɔn anəngwo ɓanə gwe anjɔ nəni</para>
  <para style="r">)<ref loc="MRK 9:14-29">Maku 9.14-29</ref>; <ref loc="LUK 9:37-43">Luka 9.37-43</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Kəɓa mɓa nə cwi nəngwi ɓa ni, kə ngwi mə ngɛ mɓa be Yesɔ ngu nwami la gagwewa. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />kəfi u ya &lt;&lt;Daa shayonki sang laɓyɔ nwi məǃ&gt;&gt;Gɔ ɓa gwe anjɔ nə kəfi tɔri gɔ wane hakə nyanwa u gu la va ko diiɓi. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Gəmə ɓa nə be nwi nangjwa gua, ama ɓana nyɔndi gɔla.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Kə Yesɔ dya wanə yee, &lt;&lt;gua ngwi sapyang ɓani, u nene ɓa yoade nə ngwi nyacwɛ ɓa, hakə lonwa ngə dənə ɓowa ma? Hakə lowa ngə dwə nə bowa ma? Gəmə ɓowa ngənə ɓa jagɔ nə la ma?&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Kə Yesɔ bi gwe anjɔ sɔ, kə gwe anjɔ ɓasɔ vya nwi sɔ. ɓabe nwi sɔ nyɔndi.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />kə nwi nangjwa gɔɓa mɓa be Yesɔ kəɓa ɓyəng,wa &lt;&lt; ka yonə je bala na bwanə gwe anjɔ nima?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yesɔ cwa ɓanə ya, &lt;&lt;yonemani gua ɓa yoade nə la pika&gt;&gt; Yesɔ cwa ɓanə&lt;&lt;ngə cwo yoade nə, nɛ aɓa yoade la ghanə ko na yi musta nə ni. gu laba la cwa nta nə lwe lang le, fi u lwe, nang ngɛ nene la chowa ni. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Yesɔ yeɓa ya yiri nangni la bwanla se ka dangpɛ ɓa nang zhi loo.<verse eid="MAT 17:21" /></para>
  <para style="s">Yesɔ cwayo shi nang wuu gɔ</para>
  <para style="r">)<ref loc="MRK 9:30-32">Maku 9.30-32</ref>; <ref loc="LUK 9:43-45">Luka 9.43-45</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Kə nwi nangjwa gɔɓa ɓa ɓwa nəshi la Galili, kə Yesɔ ye ɓa yee,&lt;&lt;ɛ na Nwi Nəngwi laɓe ngwi ɓa <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />angye la jəwa nəni; ama gɔ u lwe ɓa yonki nə.&gt;&gt;</para>
  <para style="p" vid="MAT 17:23">Kə nwi nangjwa gɔɓa də tuɓe dang ɓa.<verse eid="MAT 17:23" /></para>
  <para style="s">Nang Wo Shede Lidi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Kə Yesɔ ɓa nwi nangjwa gɔɓa dyado la kafanahu, ngwi mu shede lidi ɓa yo lanywi agang kəɓa mɛ Bituru kəɓa cwɔnə yee, &lt;&lt; ngwi maɓesa nang gua lu ogɔn shede lidi lanywi agang la ma?&gt;&gt; <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />&lt;&lt; Kə Bituru cwa ɓanə yee, lu wonla mana.&gt;&gt;Kə Bituru fi mɓa yini, kə Yesɔ fudi na cwa wa yonə ya,&lt;&lt;kanə a sang sa yoni ma?. labe wa kwə nga mu shede lidi, lasa nwi ɓa, ko lasa ngwi zhɛɓa ɓa ma?<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Kə Bituru ya,&lt;&lt; laɓe ngwi zhɛ ɓa&gt;&gt;Kə Yesɔ ya, &lt;&lt;Nankənə, ngɔn ni,&gt;&gt; nwi yi kɛɓa ogɔn la. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Ama je shanla na jwə sɛgwɔn ngwi ɓa ni, A gha dangdi a ta ngalu gu. A bwanə a gəmbe a gwa nə ɓa ngalu ni, la ladɔ gu lame yice shede mase na ogɔn ɓa nəni.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Nang Agang La Donyang.</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />La sade sɔ nwi nangjwa gɔɓa mɓa be Yesɔ kəɓa byə wa ya,&lt;&lt;ka nwa nə ngwi agang ku la donyang lankwã ma?&gt;&gt; <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Kə kwida nwijwɔn apika ya mɓa, ngu nyang wa la tangte ɓa. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Kə ya,&lt;&lt;ngə cwo yo ade nə, nɛ gua ngə na nwijwɔn apika la kɛ dya la donyang lankwã la. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Paca ngwi nang finə lashi wa na nwijwɔn apika nə lani. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Paca ngwi nang cwe nə nwijwɔn wa pika na nang yo gəniː gɔ cwe mə ngɔn.<verse eid="MAT 18:5" /></para>
  <para style="s">Nang ma yona nə nang anjɔ</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />&lt;&lt;Ama ngwi nang ku nyang nə nso lasa nwijwɔn ɓani nga dyanə ɓaməni, nə nang anjɔ ngɔn ni, zã gɔ ɓa cwe nta gwanan ɓa dwuwa nə la singuwa kəfi ɓa cawa la yi di agang wuu. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />ɛ jwə bəɓa sa sapyang yo nang la ɓenə məngang nang anjɔ sa nəngwi la ɓani, yiri namɓa nu la nə jang lonwa ku, ama jwə bəɓa sa ngwi nang la ɓa ɓanə niǃ <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />inə gaɓo lagha nə lasa nang anjɔ ni, akənwa tami, zãnə na dya ɓa yonki ɓa gaɓo kənkən, ko gagwe nda la nyang nə gaɓo mba ɓa gagwo mba kəfi cho lava la kaala ni. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Na zayu nga nyo la nənang anjɔ ni, pyã wa cha gha, zã ngɔn na dya la yonki ɓa zayi nə nso nda la dyanə ɓa zayu ku paca kəfi ɓa cho lava.,<verse eid="MAT 18:9" /></para>
  <para style="s">Nashoo yo nang lang yi ngang</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Ngu sang ɓu shəng nso lasa nwi apika ɓani. Maleka gɔɓa lankwã,gəmə ngə cwowanə, gaɓa lowanku nga sang sibe Daagə la lankwã.<verse eid="MAT 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 18:11" />yonə mani nwi nəngwi ɓa yona kãdo ngwi ɓa lanəni.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />&lt;&lt;Kanə sɔ ngu chə̃, na ngwi za ngang nə kaanto, kə nso tangte ɓa lang, kə vya nwifi ɓa ka nea cwi nto nea la la nta ngu gha kã nso lang ni lama? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Sadenang mewa ngɔn ni, ngə cwo yo ade nə, gɔ u wanua kwese ka nea cwi nto nea nang ɓa lang lani. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Nankənə ma , Daagua la lankwã shã gɔla nwijwɔn nso apika la lang ni .<verse eid="MAT 18:14" /></para>
  <para style="s">Sadenang ngwi ngɛ nənə nang anjɔ ngɔn ni</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Inə nwinyu nu ayibe ngɔn ni, gha bewa a cwawa ayibe gɔ nə. Ama anə nangnu ɓawa mba. Inə waso ngɔn ni, gu ame nwinyiu ngɔn fi ɓa ngɔn. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ama inə waso lani, fi gha sɔ ɓa nəngwi ngwi ngɛ nso ko mba ɓo, yona yo ladan shedaku ni kə nang ku cwani də ngɔn. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Kəfi ine nyi na wasowa ngɔn ni, nankənə u cwa la yido ɓwa nəshi ngwi bi ɓa, layimɓa ni uɓewanə na ngwi mu shede lidi nə. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Ngə cwowa nə gua ku pacaː, nang ku nyinə ngɔn la sapyang ni ɛ nyinyi la lankwã, kəfi nang ku gua vinə ngɔn la lasapyang ni ɛ vĩvĩ la lankwã. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Kəfi gəmə ngə cwowa nə, inə nəngwi dyanə ngɔn la kəmi sa nəku u pɛndang yokəɓə ni, la nəwani nə laɓe Daa gə la lankwã. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />yonə mani paca yido nang nəngwi mba ko nca ɓwa nəshi lasa yaamə, gəmə ngə nə latangte ɓa.<verse eid="MAT 18:20" /></para>
  <para style="s1">Nashoo lashi Ngwi Nang la Yafi Lani</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Ba ngənə kə Bituru mɓa be Yesɔ ɓa byədo ya,&lt;&lt;Daa shayonki fina nwinyə mə la nəmə ayibe nə yafi gɔ ma? Fin ntomba&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesɔ cwa wanə ye, &lt;&lt;Fin ntomba la ama ntomba fi kaanca cwi njwa.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />&lt;&lt;Yonəmani yido nəgang yi lankwã ngə na nangni. Sade ngənə kwə ɓə ngɛ nga shana sang nang ɓa gɔ nyang nə laɓe nwi layi gɔ ɓani. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Kə shayi sɔ fudi ni sadenang ɓa mɓanə ngwi nso nang nga ɓyəwa shede ne gang miliya. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Ku ba wonla, kə kwə ya ɓa yaa ɓaɓɔ ɓa gwa wa ɓa nwiwa ɓa nang ɓanang uɓanə kəɓə ni ku ɓaɓu ogɔn mənə.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />&lt;&lt;Kə nwinfɔ sɔ twə ntavũ wa kəmi la sibe wa ngu jua ya,&lt;anə munye ɛ wo nang awaku ogɔn.&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Kə shayi sɔ sang laɓyɔ gɔ, kə tawa ɓe, kə yafi gɔ kũ sɔnə.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Ama nwinfɔ sɔ kwe nəɓe, kə jwanə ɓa nwinfɔ ndɔ nang ngu kafi wa kũ shede la pika kə gwa gua, &lt;womə nang ngə kãfu ni.&gt; <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />kə nda wa nwinfɔ nwami kə jua ya, anəmə munye nə ngə wonwoǃ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Ama gɔ nyi, ku nyang ghɔnə fusina, se lonang ogɔn kũ sɔ ni. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Kə nde nə nang nu gɔɓa sang ni kə wa nua banla. kəɓa gha cwa shayi nang vangi ni.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />&lt;&lt;Kə shayi kwi nwi layi sɔ ya, &lt;Aka nwi layi anjɔ gəmə yafi gu kũ gənə negang ni yonəmani ajumə ngɔn. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ntɛ asang laɓyɔ nda nwi layi na kunə ni, na nang gəmə sang laɓyɔ guni. &gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Kə shayi lalɔ, ku ya ɓa tawa la fusina ghase ogɔn kũ sɔku mbe. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Kəfi Yesɔ yeshiwa, &lt;&lt;Nankə kə Daagə la lankwã ɛ nənə nwaku la tangtowa se a yafi nwinyu nə lasɛgwo.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yesɔ Maɓesa Nang Yo Nang gaa Yifye</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Sade nang Yesɔ yenəshi nang cwa yo ɓani, kə vya Galili, kə u kwe nəɓe la kəmi Yahuda la be dagɔ di Urdu. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Cwi nəngwi ɓa kasawa, kɔ nyɔndi gaɓa layimɓa. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />Farisawa ngɛ ɓa ɓa sawa yona ɓa ma wa.&lt;&lt;kə ɓa ɓyəwa ya nangzhĩ je dyan na nəngwi taa gwa wa ɓe sa nang ku gɔ nəni ma?&gt;&gt; <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />&lt;&lt;Yesɔ byəɓa ya, gua jwa sang lama la lakwã Nyimoː ya lasa fudi Nyimoː maɓa nə nyənənwo ɓa nyənəngwa lama? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />&lt;Kə Nyimoː ya, &lt;Sa yoni kə nyənənwo la vya daagɔ ɓa naa gɔ kəfi ɓwanə ɓa gwa wa, kə mba ni la ɓenso&gt; <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Kə fii ɓa mba la, ama nso. Ngwi ngɛ nene la gaɓa nla, nankənə, nang Nyimoː ɓwanə ni,&gt;&gt;<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />&lt;&lt;Ka Farisawa ɓa ɓyəwa, &lt;&lt; kanə, nankə kə Musa nadang ya, nəngwi la na gwa wa kwã gaa yii fye na kə nyang gwa sɔ kwe ma?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesɔ cwa ɓanə yee, Musa nowa dang uya, utã gwa wa ɓe yonə mani guwa jwə wane na mowaɓenə. Ama yiri nang ni nene sayi ɓa manə lasapyang ni. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ngə cwo wanə, ngwi nang ku taa nə gwa wa ɓe ngɔn ni inə kayo dã lani u nyang wa nə dã ngɔn inə gɔ fe nəngwa ngɛ ngɔn ni.&gt;&gt; <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />nwi nang jwa gɔɓa byə wa ya,&lt;&lt;Nə nang ni ngə nankəbə nə la tangte nyinəwo ɓa nyənəgwa ni, zəzan na ɓe feyi la.&gt;&gt; <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Kə Yesɔ cwa ɓanə ya,&lt;&lt;la ka nwaku kə la dya ni la, ama se ka ngwi Nyimoː naɓa nəni. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Yonə mani nang ɓa ngənə chocho sayo nang nyənənwo kɛ fenə nəngwa niː ngwi ngɛ ɓa, yonəmani ɓa mya na kənə. Ngwi ngɛ ɓa nəngwi nyang ɓa nankə; Kəfi ngwi ngɛ ɓa la feyi nla yo yi nəgang lankwã. Ngwi nang ku la dyanə dya ni cwe nang Nwi jwo apika ɓa Yesɔ<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Kə ɓanə nwi jwɔ ɓa be Yesɔ yona nyang ɓa balka nə kə pɛɓa dang nə.Ama nwi nang jwa gɔɓa nga shan na ngwi ɓa na nwi jwɔn ɓa sɔni. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Yesɔ yee ɓa yee, &lt;&lt;Uvya nwi jwɔn la se mə ɓa bu hadi gaɓa la,yonə mani yii Nyimoː ka yi yiri gaɓa &gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Sade nang Yesɔ nyang nə gaɓe wa lashi ɓa ɓa ni, kə kwe nə la yimɓa.<verse eid="MAT 19:15" /></para>
  <para style="s">Ngwi Nang me</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Kə ngwi bə ngɛ kə lwe mɓa yinse Yesɔ kə bye Yesɔ u yee,&lt;&lt;Ngwi maɓesa nang ka nang ade nəɓa gəmə ngə nə kə mɛ nə wii aɓete ma?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />&lt;&lt;Ka nə nə nang ka bye mə yoni nang ade ɓa,&gt;&gt;Yesɔ bye wa nang be na kəɓə nə,&lt;&lt;Ngwi nso kə ka ngwi ade ni, nə ngə shana dya la do wii ni se aka se yo nangzhĩ Nyimoː.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />&lt;&lt;Ka awa ɓa, ngwi sɔ bye Yesɔ</para>
  <para style="p" vid="MAT 19:18">Yesɔ ye wa yee, &lt;&lt;Ba je nəngwi la, ɓa nə dang la, ɓa yinang la, ɓa cwa yo dang sa la, nə ɓa shede dangsa la, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />ana daagu ɓa naa gu gang. &lt;kə bə shan ngwi dagɔ na lashiu nə.&gt;&gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />&lt;&lt;Ngwi sɔ yee, nang ɓani nə nwaku,&gt;&gt;Ngwi sɔ cwanə yee,&lt;&lt; Ka nə ngɛ fi lang.&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesɔ ye wa yee,&lt;&lt; nə shana ɓenə ngwi ade ni, gha mu nang guwa ku a yaa kə mu shede sɔ na ngwi laɓyo ɓa, ngɛ nə la mɛ dodə mɛ la yi Nyimoː, kə fii ɓa ka se mə&gt;&gt; <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Ba nang wa yiri yo Yesɔ cwa nə ni kə nwi nəngwon kə kwe nə yi ɓa sɛgwo a jwənjwə nə, yonə mani gɔɓe ka ngwi nang me ɓa yennə.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Kə Yesɔ yee nwi nang jwa gɔɓa ye,&lt;&lt;Gəmə ngə cwo yo ade nə, a jwənjwə kə ngwi nang me mɛ dya la lakwã yii Nyimoː. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Fii Yesɔ ma cwa yee, ngə cwo yo ade nə, kɛ jula sa njoroba na dya jwẽyi bata kə nəngwi ɓa dya la do nyangyi Nyimoː.<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Nwi nang jwa wanə nankənə ni, kə sa ɓa yiyi ɓa nyenə, kəɓa byə do yee to, na kəɓə ngə ni, &lt;&lt;ka wa la mɛ do ma?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesɔ kə sang ɓa yee,&lt;&lt;Be nəngwi gɔni ama la be Nyimoː kə jwəla ma.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Kə Bituru cwa Yesɔ nə yee,&lt;&lt;Je vya nəku ka yona ka sɔǃ ka nə yi mɛ ma?&gt;&gt; <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Yesɔ cwa ɓane yee, &lt;&lt;Gəmə ngə cwo wa yo ade nə nang ɓa ku gwa nə nepa ni, sade nang ngwi nəngwi ngɛ də nə la sa shi adə gang gəni, ngwi ka se ɓa kə ɛ də sa shi gang ɓa njwa cwi mba ni, ngə nwi Isire laba njwa cwi mba ni tita nə. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Kə ka nwaku vya nə layi ɓa ko ka nwinyi anəngwon ɓa nwi anəngwa ɓa, ko ka daa ko ka naa ko ka nwiba ko ka lase ɓa, ka yogəni, gɔ u mə nang fin kaanto kwenə sa nəku kəfi lumɛ wii la kaanlani ɓente. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ama ngwi gəmbe ɓa bya gɔnə ɛ ɓe ngwi zinze ɓa ngwi nang ɓa la zinze ni ɛ ɓe ngwi gəmbe ɓa.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Nashoo La Lashi Ngwi Nə Nangnu Lasẽ Inabi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Yido nəgang lankwã na ngwi layi ngɛ bwa ɓa vula nə yona kã ngwi ɓa la nəwa nə nangnu ni la lase gɔ yi fashi inabi <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Kəɓa wanə shede nang wonə ngwi nənang lalo kə swɔn ɓa la lase gɔ.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />&lt;&lt;Sa chelo nto nea kə bwã ni kə sang ngwi ngɛ ɓa də la lomo yinse. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Kə cwa ɓanə ye,&lt; gua ma gha lase gə, hakə won wa nang zanzan ni,&gt; ku gha. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Kə ɓa bwanə ɓa lonəni, fi lasa chelo nə nca, ku cwe ngwi nang nu ɓa. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Habe ku chelo nto kəfi bwa ngu sang ngwi ngɛ ngə la nə nang ngɛ la, kə cwa ɓa nə ya,&lt;ka yonə sɔ gua də yinse la lalo ma?&gt;<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />&lt;&lt; Kə ɓa cwanə ye, &lt;ngwi ngɛ nə nangnu la,&gt;</para>
  <para style="p" vid="MAT 20:7">kə ye ɓa ya, gua ma gha lase gə.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Kə lo gwa ni, a gha lase cwa ngwi doɓe nangnu lase,&lt;a kwi da ngwi nangnu ɓa awon ɓa, a fudi ɓa ngwi a zinze cwe ɓanə gəmbe.&gt; <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Ngwi gha nə chelo nto ni, ko nwaku mɛ nang zãzã la nawa nə sa lo nsɔni. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />To, ngwi nang ɓa fudi na mɓa ni nganə taməle ngɛ nə ɛ ogɔn ɓa kwe sa nwifiɓa, ama gaɓa ma nwaku naa ɓa nang zãzã na ogɔn ɓa sa lalo ni. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Kəɓa muni, kə nga nəyo ɓa lagu sa shayi gaɓa. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />&lt;Ngwi nang ɓa mu ɓa ghanə kasɛ ni, ɓa nə nangnu che nso kə, ama je nang ngə nənang nu lalo ngə nə nangnu la lo aganga, kəɓa ogɔn ɓa ɓa ku nso maǃ.<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />&lt;&lt; U wa, damɓa,&lt; nsha lasɛ dya ɓanə ya, &lt;gəmə bedowa nla. Sang ni, gua wanə ya gəmə ngə wonwa che shede nso la lalo nso. <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />A cwe nang ngənə yigu ni a kwe yi. Ka kəmə kə shang na wonɓa nang ngə shani na nang gəmə wowa ni. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Nene ɓa njamu nə na nə nang shãni ɓa nang kanə yigə nila ma? Ko gua ngu shido yonəmani gəmə naa nang gə gaɓe yinse ma?&gt;&gt;&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />&lt;&lt;Kəfi Yesɔ yeshiwa, &lt;&lt;Nankənə ngwi gəmbe ɓa ɛ yi kasɛ.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">Yesɔ Mafi cwa yo lashi nang wu gɔ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Na nang Yesɔ nga gha la Urshelima, kə cwe nwi nangjwa gɔɓa njwa cwi mba ku cwaɓa yonə jwanjwa, na nang nga gha nəni. <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;Wani,&gt;&gt;gɔ cwaɓanə,&lt;&lt;je ngə gha Urshelima, yimɓa ɛ na nwi nəngwi laɓe nwanye ngwi pɛdang ɓa ngwi maɓesa nangzhĩ Musa ɓa. Gaɓa ɛ nəwa tita hakə ɓa jəwa. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />ngɔn ni nawa sa ngwi nang ɓa kanə Yahudawa ɓa lani,angye ɓa ɛ vɛwa nəni, ɓa gba wa ɓatɛ, kəfi gangwa sa shi; ama la gwe lazinze gɔ lu lwe ɓa wiinə.<verse eid="MAT 20:19" /></para>
  <para style="s">Nang Ju Nɛ Yakubu ɓa Yohana</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Kəfi nɛ nwi Zabadi ɓa mɓa be Yesɔ ɓa nwiwa mba, ku nwami la sibewa ku jua nang ngɛ.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesɔ ɓyəwa ya.&lt;&lt;Kanə sɔ nga shan ma?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Ku dyawa nə ya, &lt;&lt;Anə mə akawa nə ya nwimə ɓa mba ni dəkəmi ɓo, nso la ɓezhi gu, nso la ɓeshang gu, sadenang aɓenə Kwə ngɔn ni&gt;&gt; <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />&lt;&lt;Ama Yesɔ cwa wanə ya gua u nyinang ngu junəni nla,&gt;&gt;Yesɔ daya nwinjwɔn ɓasɔ nə. &lt;&lt;Gua uba lu fəfa sa nwinkwi yi nang tori gə ya gəmə ngə gha fanəni ma?</para>
  <para style="p" vid="MAT 20:22">Kəɓa dyanə &lt;&lt;Gənə ɓa nəbəɓa.&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Kə cwa ɓanə ya,&lt;&lt;lanle lu faa la nwi kwakwi gə, ama gəmə nɛnɛ ɓa məngang na caɓesa ngwi nang la də la ɓezhi gə ko ɓeshang gə la. ka Daa gə lankwã nga ma məngang a kəbe yo ngwi nang ɓa nte nəni.<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />kə nwinfi nwi wa maɓesa nang gɔɓa njwa awanə na nang ni, kə lalo sa nwi nyə ɓa nə mba ni. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Ama Yesɔ kwida ɓa ku ngu ya, &lt;&lt;Gua nyi nang kwe ɓa ngwi nang ɓa kanə Yahudawa ɓa lani kəɓa sa njamu nəngwi gaɓa, ngwi agang gaɓa ma ngə caɓesa ngwi gaɓa sa njamu <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />kə nə nankənə la tangte ɓa, nankənə ni paca ngwi nang shã na ngənə daa la tanto wani se jagi sa nwinfi ɓa. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Fi ngwi nang nga shanə lu ngənə nwanye la tanto wa, se ngənə nwinfɔ gu. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Nankənə fi nwi nəngwi mba yona jagi la, ama yona jagi, fi ku na yonki gɔ yo nang pong nəngwi ɓa ɓa bya gɔnə.&gt;&gt; <verse eid="MAT 20:28" /><verse number="29" style="v" sid="MAT 20:29" />Kə Yesɔ ɓa nwi nangjwa gɔɓa a vya Jeriko, nəngwi ɓa ɓya gɔnə kəɓa kafi wa. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Kə ngwi bwonyi mba ɓa də la məngang. kəɓa wanə Yesɔ ɓa nga kwe nəni, keɓa cwe ghoɓa ka lwe nə ye,&lt;&lt; ngwi agang nwi Dauda a sang laɓyɔ jeǃ&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />ngwi ɓa sɔ laɓa ɓa lɔ ye uga dowani. kə mafi cwe ghɔ ɓa lwe nə ye, &lt;&lt;Ngwi agang, gwɔgwɔ Dauda a sang laɓyɔ je.<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Kə Yesɔ ngə kəmi ya, &lt;&lt;kanə gua shan na nəwa nəma?&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Ba yewa ye,&lt;&lt;Ngwi agang mbe mɛ do sang.&gt;&gt; <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Nankənə kə Yesɔ sang laɓyɔ gaɓa, bəɓa sa zayi ɓa. bəɓa ka fudi na sang do, ka kafi wa.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Nang Dya Yesɔ La Urshelima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Ba nang gaɓa badi la urshelima ni, kə ɓa dyado la batfaji la shi nta Olive, Yesɔ swon nwi nangjwa gɔɓa mba, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />u ye ɓa yee, &lt;&lt;gha layi la sibowa ni, ɓa begə a sang wandye dwə layi yimɓa, ɓa nwi labe wa, vĩ ɓa aɓa nə la bemə, <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />ne ngwi ngɛ cwo wa nang ngɛ ngɔn ni, cwa ɓanə ya Daa shayonki nga shang ɓa, kə gɔ u vfowa kwe.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Nang ni nə nang yona pɛ yonang ngwi dang doswon cwa niː A<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;A cwa nwi nəngwa yi Siyona nə,</para>
  <para style="q2" vid="MAT 21:5">&lt; A sang, kwə gua nga ɓa laso,</para>
  <para style="q1" vid="MAT 21:5">kə ngu finə lashiwa kəmi kəfi u dəshi wandye,</para>
  <para style="q2" vid="MAT 21:5">la shi nwi wandye,<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Nwi nang jwa ɓa gha gha nə nankəbənə na nang Yesɔ cwa ɓa nəni. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />A ɓanə wandye sɔ ɓa nwi wa, kə ɓa ye mə yafi lashi wa, kə Yesɔ je də layimɓa. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Nəngwi ɓa ɓa byagɔnə kə ɓa ye nywanang gaɓa la məngang, kə ngwi ngɛ ɓa gbəng jashi lasa shi ɓa ka ye la məngang. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />ngwi ɓa gənə ɓeni ɓa ngwi ɓa nga kasewa la zinze ni kə ɓa lwe nə ghɔ ɓa nga ya,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Hosana sa nwi Daudaǃ</para>
  <para style="q2" vid="MAT 21:9">balka ngə</para>
  <para style="q1" vid="MAT 21:9">sa ngwi nang nga ɓa nə ɓa ya Daa shayonki nəǃ</para>
  <para style="q2" vid="MAT 21:9">Hosana lasa ngwi kwe nə sa gang ni.<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Ba nang dye Yesɔ nə Urshelima, kə kubwon lwe la yi agang so, kə nga byədo nga yee,&lt;&lt;ngwi so ka wa ma?&gt;&gt; <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Kə ngwi ɓa nga kanə zinze Yesɔ ni kə ɓa yee,&lt;&lt;ɛ, ngwi ni kɔɓə nə ngwi dang doswon Yesɔ la Nazare yi Galili.<verse eid="MAT 21:11" /></para>
  <para style="s">Yesɔ la nywi pẽdang</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Kə Yesɔ dya lanywi pɛdang kə bi ngwi yaɓa nang bwanə, kə fyə teburi yi ngwi pye shede ɓa, ɓa teburi ngwi yaɓa nzho yiɓa yemi. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Yesɔ cwa ɓanə ya, &lt;&lt; Ba jwə jwa la lakwã Nyimoː ya Nyimoː ya, Lanywi pɛdang gə la kwinə lanywi pɛdang,&gt; Ama gua ɓenə yido jwa ngwi yinang ɓaǃ&gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Kə ngwi bwonyi ɓa, ɓa ngwi gbəng gwe ɓa,ɓa sawa la lanywi pɛdang sɔ, kə nyɔndi gaɓa&gt; <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ama sade nang wanye ngwi maɓesa yo nangzhĩ Musa ɓa lalɔ sadenang sang nə nangnu yiswe Yesɔ nga nəni, hakə ɓa nwi jwɔn ku nga bwon ku la lanywi pɛdang nga ya,&lt;&lt;Hosana sa nwi Daudaǃ&gt;&gt; <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Kəɓa ɓyəng Yesɔ ya awa gaɓa nga cwa ni ngɔn ma?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">&lt;&lt; Gəmə wa ngɔn nede,&gt;&gt;Yesɔ dya ɓanə. Gua meri jwa nang ni la lakwã Nyimoː ma? &lt;Gua ma nwijwɔn atwa ɓa nwifye ɓa nang la ɓwɔn nə Nyimoː ni ngɔn nəɓwɔ.&gt;&gt;&gt; <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Yesɔ vyaɓa kə kwenə ɓe la yi agang yi Betani, layimɓa kə nganə. <verse eid="MAT 21:17" /><verse number="18" style="v" sid="MAT 21:18" />la məngang gɔ finə u mɓanə ɓanə yi agang ɓa vulani kə nywe gwa Yesɔ. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Gɔ sang shizwu la ɓyən məngang kə gha yimɓa, ama mə nang ngɛ la sawa sɛ ka jashi ɓa. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Kə nwi nangjwa ɓa sang nang ni kə sayii gwa ɓa.&lt;&lt;kəɓa byədo. Bəɓa kə shi zwu ni swɔn na nang ni ma?&gt;&gt; <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Yesɔ dyaɓa nə ya, &lt;&lt;Gəmə showa na nyi inə gua dyan kəfi u chəng nang ngɛ la, gua ba lu nə nang gəmə nənə sa shi zwu ni nə. Kəfi ka nangni nso la, Ama ba lu cwa nta, &lt;Alwe hakə gu ɓa lashiu nə la yidi.&gt; Kəfi lu nənə. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Inə dyanə ngɔn ni, lu mɛ nang ngu byədo nang pɛdang ni.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s">Dobyə la shi njamu Yesɔ</para>
  <para style="r">)<ref loc="MRK 11:27-33">Maku 11.27-33</ref>; <ref loc="LUK 20:1-8">Luka 20.1-8</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesɔ fi mɓa la lanywi pɛdang; na nang ngu manəɓenə ni, nwanye ngwi nyanang ɓa nwanye ɓa mɓa bewa kə byə wa, &lt;&lt;Ka njamu anwa gu aɓa kəbənə kə nga nənə nang ɓa ni ma? Ka wa nu yiri njamu sɔ ma?&gt;&gt; <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Yesɔ dyaɓanə ya, Gəmə ngə ɓyuwa yo nso, kəfi inə gua cwa mənə ngɔn ni, gəmə ngə cwowa nə ko ka njamu anwa kə ngə nənə nang ɓa ni. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Njamu nə botisma Yohana nga bwa je maː lasa Nyimoː ma ko lasa nəngwi anvĩ ma?&gt;&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Ama inə je cwa ya, &lt;lasa nəngwi anvĩ ngɔn ni,&gt;je yiyi sa nang nəngwi ɛ nənə ni, Yonəmani gaɓa a dyanə ngɔn ya Yohana ka ngwi dangdoswɔn.&gt;&gt; <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Nankənə kəɓa cwa Yesɔ nə, &lt;&lt;Je nyi nla.&gt;&gt; <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />ɓeni kanə gua ngu chəng ma? Ngwi məngɛ ngə nlo angye u mɓa nə nwi ɓanə mba ni. Ku gha sa nwianye a nso kə cwa ya, &lt;Nwimə, gha nə nangnu la lasɛ inabi nwiza.&gt; <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Ku cwa ya, &lt;kənə gha la, ama la zinze gɔ ku pye nang gɔ ku gha. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Kə daagɔ ghasa nwiwa anso kə cwawea nə na nang gɔ cwani,&lt;Nwa ngɔn, &gt; gɔ ya, ama u ghanla. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Ka anwa la tangte nwi ɓa mba ni nə nang daa gaɓa shani?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">&lt;&lt;Ka nwanye,&gt;&gt;gaɓa dyanə,</para>
  <para style="p" vid="MAT 21:31">Kə Yesɔ cwa ɓanə ya, &lt;&lt;Gəmə ngə cwowanəː ngwi shede lidi ɓa kəfi gwa fɔ ɓa ɛ dya la yido nəgang yi Nyimoː ɓẽgə gua.<verse eid="MAT 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 21:32" />Kə Yohana wa nə botisma mɓa nga cwowa ɓesa yido ade gua lu gwa ni, kə gua dyala ɓawa; kə ngwi mu shede lidi ɓa kəfi gwa fɔ ɓa dyanə ɓawa. Konte gua sang nangni ni, gua lazinze pyɛ sɛgwo la na fi ɓa dyanə ɓawa nla. <verse eid="MAT 21:32" /><verse number="33" style="v" sid="MAT 21:33" />&lt;&lt;Wa yo nashoo angɛ,&gt;&gt; Yesɔ ya. &lt;&lt;Nəngwi ngənə ɓanə lasɛ nə angye gɔ gbanə shiɓa yimɓa ni, u kwon tala ɓa gang, u ka jwɛ yona pĩnə fashi ɓa yimɓa ni, kə ma nwi ngwi sang zhi. Kə naa ngwi cwe gaɓa kə vfa layi u kwe zhɛ. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Sadenang sayi sha fashi ɓani, ku swon lasa ngwi ɓa naɓa nə lasɛ ni yona ɓa nawa dang jada gɔ yi fashi ɓa sha ni. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />kɔ Ngwi ɓa naaɓanə lasɛ ni gwa nwinfɔ gɔ la singu ɓa, gba ngwi ngɛ ɓa, jə ngwi ngɛ ɓa, kəfi ɓa ca ngwi ngɛ ɓa ɓa nta. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Kəfi ngwi sɔ swon nwinfɔ ngɛɓa, ange kwenəsa a gəmbe ni, kə ngwi naɓa nə lasɛ ni nəɓasa na nang ɓa nənə ngwi a gəmbe ɓani. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Yeshiwa ku kə ngwi sɔ swondo ɓa nwiwa lasaɓa, &lt;Nedə la naa nwimə gang naa,&gt; gɔ cwa. . <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ama sadenang ngwi lase ɓa sang nə nwiwa ni, kə cwanə saɓa ya , &lt;Ka nwi shalasɛ ye. Uɓa ɓi jəwa ki cwe nang gɔ. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Kə gaɓa gwa wa, cagha la lasɛ, kəfi jəwa. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Ɓeni, sadenang sha lase la ɓani, kanə lu nə nə ngwi ɓa naa ɓanə lase ni?&gt;&gt;Yesɔ ya.<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />&lt;&lt;Gɔ lu jə ngwi anjɔ ɓa ni,&gt;&gt; Gaɓa dyanə, &lt;&lt; kəfi cwe lase sɔ naa ngwi ngɛ ɓa, angye ɓa la nanə jada nanpang sayi sade gɔ u shang ni.&gt;&gt; <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Yesɔ cwa ɓanə ya, gua meri cwa nang kwã Nyimoː cwa nəni lama?</para>
  <para style="q1" vid="MAT 21:42">Nta nang ngwi manang nyi nə ya zanla ni</para>
  <para style="q2" vid="MAT 21:42">kəɓə nə nang adeku tanə kuniǃ</para>
  <para style="q1" vid="MAT 21:42">Nangni ka Daa shayonki nə;</para>
  <para style="q2" vid="MAT 21:42">ka nang yiswe anwa la ngənə <verse eid="MAT 21:42" /><verse number="43" style="v" sid="MAT 21:43" />Nankenə ngə cwonə,&gt;&gt;Yesɔ twashi ya,&lt;&lt;ɛ cwe yido nəgang i Nyimo ɛ cwecwe laɓowa kəfi naa ngwi ɓa angye la ɓanə nanpang ade ɓa.&gt;&gt; <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Ngwi nang ntani gunə shi ngɔn ni lu wuuwu, ngwi nang ku nta ni gu shiwa ngɔn ni ɛ gwa wa na muu nə,&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="MAT 21:45" />kə nwanye ngwi nyanang ɓa Farisiyawa ɓa wanə nashoo ni kəfi nyinə ya gɔ u cwanə yo lashi ɓani, <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Kə gaɓa nga ka məngang nang la gwɔ nəni. Ama nga yiyi yo nəngwi ɓa, angye ɓa ya gɔ kanə ngwi dandoswon.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Nashoo lashi zhɔ yifye</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Fi Yesɔ ma cwa ɓa yo sa nashoo ngu ya, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />Donyang yi Lankwã ngə na nang ni. Sayi ngənə Kə kwə ngɛ ngənə kə nə nwi wa anəngwo zhɔ yifye nə. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Gɔ swɔn Nwinfɔ gɔɓa gha kwida Nəngwi ɓa ɓa zhɔ yifye, ama Nəngwi nang kwida ɓani shanla na mɓa. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />&lt;&lt;Kəfi ma swɔn nwi layi gɔ ngɛ ɓa uya, cwa Nəngwi ɓa nang kwida ɓani ya, &lt;&lt;Gəmə ma yido zhɔ yifye nyang ngɔn ɓeni; gəmə nyang ɓa nə nang tang ngɔn kəfi nang ngə naa ni ngənə ɓemə ɓa jə nwɔ ɓa, kəfi nəku ma nyang ngɔn. U ɓa sa zhɔ yifye&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />&lt;&lt; Ama ngwi ɓa kwinəda ɓa ni nyang akilo gaɓa nla sa yni kəfi kwe gha nga nang nga nəniː nso kwe lasɛ anso gha yido yanang gɔ, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Kə ngwi ngɛ ɓa gwa nwi layi ɓa sɔ, gba ɓa, kəfi jəɓa. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Kə kwə sɔ lalɔ wanɛ; Kə swɔn soje ɓa, angye ɓa jənə ngwi jədo ɓa sɔ kəfi zwe yi gaɓa yemi. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />kɔ kwi nwinfɔ gɔɓa kə cwa ɓanə ya, &lt;Yinyɔ yifye gə ma ngɔn, ama ngwi ɓa kwinə daɓa ni pɛnla na mɓa yimɓa. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Bɛɓɛ ni u gha la yintangte yii u kwida paca ngwi nang u mɛnə ngɔn ni.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />kə nwinfɔ gɔɓa kwe la shi məngang kəfi ɓwa nəngwi nang gaɓa mɛnə ngɔn ni, ade ɓa anjɔ; kə yido zhɔ pɛ ɓa nəngwi ɓanə. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />kə kwə bwa yo na sang ngwi zhe ɓa kəfi usang ngwi ngɛ ja nang ja yi zhɔ yi yifye nla sawa. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />kə kwə ya , ndɔ anə bəɓa dyanə lanle nangja yifye nene so?&gt;Kwə ɓyəng wa. Ama ngwi sɔ cwa nang ngɛ nla . <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Kə kwə cwa nwi layi gaɓanə ya,&lt;U dwewa gaɓe ɓa gagwe, kəfi cawa la yidavu. Layimɓa gɔ lu lɛlɛ kəfi tang nyiwa.&gt;&gt;&gt;. <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />kə Yesɔ yeshiwa, &lt;&lt;Ba kwi nəngwi ɓyanɓya, ama ɓyala kə ɓa tɛ,&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Do ɓyəng shi nang ogɔn shede lid</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Inə yimɓa ni kə Farisawa ɓa fudi na ka məngang nang la gwɔ nəni sa yo cwa gɔɓa . <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />kəɓa swɔn nwi nangjwa gaɓa kəfi ngwi ngɛ ɓa lasa ngwi ngənə ngwi Hiridu ni. &lt;&lt;Ngwi maɓesa nang &gt;&gt; gaɓa ya, &lt;&lt;Je nyi ngɔn gu nga cwa yo ade. Gu nga maɓesa nang ade ɓa Nyimoː nga shan yo nəngwi ɓani, la chəng ko ka nə nəngwi ɓa nga cwa nla, yonəmani gua nyang akilo gu sa gang ngwi ngɛ nla. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Gu acwɛ nə, nankəbə, kanənga chəng? Zəzan na je ogɔn shede lidi sa Kwə Roma ma ko ɓi bi wonla?&gt;&gt; <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Yesɔ, konteku, nyi nang chəng gaɓa anjɔ ngɔn nəni ngɔn, kəfi ye ɓa ya, gua ngwi fundang lashiuwaǃ Ka yonə gua ngu shana gwamə ma? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />U camɓesa yice shede nga ogɔn nə shede lidi niǃ&gt;&gt;Gaɓa ɓanə yice shede ɓasɔ lasawa, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />kə gɔ ɓyəɓa, &lt;&lt;Ka yijwu nwa kəfi yaawa ɓa ye ma?&gt;&gt; <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Ka ya kayi Kwə, gaɓa cwa. Kə Yesɔ cwa ɓanə ya, &lt;&lt;Nankənə&gt;&gt; ngə nankənəni gua ogɔn kwə nang kanə yi Kwə ni, kəfi naa Nyimoː nang kane yi Nyimoː ni. &gt;&gt; <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Kə ɓa wanə na nang ni , kə yi gwa ɓa kə kwe vyawa kəfi ɓa kwenə ɓe.<verse eid="MAT 22:22" /></para>
  <para style="s">Doɓyə shi nang lwe ngwi wuunə ngɔn ni</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />La lalo sɔ kə ngwi Sadukiyawa ngɛɓa mɓasa Yesɔ kəfi nga ya nəngwi ɓa kɛ lwela sa wii ajədo. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Ngwi maɓesa nang , &lt;&lt; Musa ya inə ngwi ngɛ nene ɓa nwini hakə wuu ni, nwinyə wa la cwe gwa wa cwe cwe ngɔn ni kə mya ɓa la cwanə ya ka nwi ngwi wuuni. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ɓeni nwinyə ɓa ngənə nto mba angye denə lanle ni. Kə nwanye gaɓa ku fye nəngwa kəfi wuu nene ɓa nwi nə, kə gɔ vya gwa wa ɓe yi nwinyiwa. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Nankənə nənang sa nwinyiwa a mba, lasa anca, kəfi sa nwifi ɓa ku nto mba ni. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Yeshiwa ku ni, ngwa sɔ wuu. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Ɓeni, la lalo ɛ lwenə sa wii ajədo ni, gɔ ka gwa nənyo? Gaɓa ku ɓa fyewa ngɔn. &gt;&gt; . <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Yesɔ yeɓaya, &lt;&lt;Ka yiri nang nyi anwa gua nene ɓa kəɓə maǃ Yonəmani gua nyi kwã Nyimoː nla ko njamu Nyimoː. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Yona sadenang ngwi awuuwuu ɛ lwenə ɓa yonki ni gaɓa ɛ ngəna malaika ɓani la lankwã kəfi kɛ fyeyi la. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ɓeni, la soa sa nang lwe ɓa wiinəː gua jwanla sa nang Nyimoː cwowa nəni? Gɔ ya, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />Ka kəmə nə Nyimoː yi Ibrayi, Nyimoː yi Ishaku, kəfi Nyimoː yi Yakubu.&gt;Gɔ ka Nyimoː yi ngwi wii ɓa, kayi ngwi awuuwuu la.&gt;&gt; <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Sadenang cwi nəngwi wani, kə yi gwa ɓa ku sa nang maɓene gaɓa.<verse eid="MAT 22:33" /></para>
  <para style="s">Nyə yo agang</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Sadenang Farisawa ɓa wanə gɔ nyang Sadukiyawa ɓa gandonə ni, Kə ɓa mɓa ɓwa nəshi, <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Nso la tangte ɓa, ngwi maɓesa nangzhĩ Musa, U shana gwa wa ɓa doɓyə <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />&lt;&lt;Ngwi maɓesa nang,&gt;&gt; gɔ ɓyədo,Ka yo anwa nə nyə yo la sa yo nangzhĩ Musa? &gt;&gt; <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yesɔ ya, &lt;&lt;&lt; Ashang Nyimoː ɓa sɛgwo nəku, ɓa yonki gu,kəfi ɓa nang chəng gu ku.&gt;. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Nang ni kənə Nyə kəfi nə Azanzan yi Musa. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Kə mba yi nyə yo azanzan ngə na ango nəː &lt; Ashang ngwi dagɔ zhi gu na kunə.&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Kə yo nangzhĩ Musa kupaca kəfi nang maɓenə yi ngwi dandoswon ku tagwɔn sa yoɓani.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Doɓyə lashi Almasihuː</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Kɔ farisawa ɓwa nəshi donso. kɔ yesɔ bye ɓa yo. <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Kanə gua u chəng sa Almasihuː ma? Gɔ ka lado nwa ma?</para>
  <para style="p" vid="MAT 22:42">&lt;&lt;Gɔ ka lado Dauda,&gt;&gt; gaɓa dyanə. <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Kə kanesɔ, nankənə, Yesɔ ɓyədo?, &lt;&lt; Bəɓa kə Yingu lwenə Dauda na kwiwa nə &lt; Daa shayonki? Dauda ya,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />Kə daa shayonki yi Daa shayonki gəː</para>
  <para style="q2" vid="MAT 22:44">Adə lanle la ɓezhi gə</para>
  <para style="q2" vid="MAT 22:44">Hakə sɛ nyang ngwi shi gua la gagwo.&gt; <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />Inə , nankənə, Dauda kwiwa nə&lt; Daa shayonki&gt; Kəɓeɓa Almasihuː laɓe lado Dauda ma?&gt;&gt;<verse eid="MAT 22:45" /></para>
  <para style="pi">
    <verse number="46" style="v" sid="MAT 22:46" />Ngwi ngɛ banla na cwa Yesɔ yo ngɛ, la lalo sɔ ngwi ngɛ banla na ɓyəwa yo ngɛ banla.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Nankənə Yesɔ cwayo ɓa cwi nəngwi ɓa kəfi nwi nangjwa gɔɓa. <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Kə ngwi maɓesa Nangzhĩ Musa kəfi Farisawa ɓa ka kaɓa nə ngwi ɓa naaɓanə gang ya finə yo nangzhĩ Musa ɓa cwani. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Nankənə sɛ la nənang ku kəfi kafi kasa nang ku gaɓa cwonə ya nəni; ɓanəla, konteku, kasa nang nə gaɓa nga nəni, yonəmani ghaɓa la nə nang gaɓa nga manəɓenə lani. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Gaɓa dwə nəngwi ɓa nang cwe la zinze ɓa angye zwanə tanəwi ɓa na cwe ni, aɓeku gaɓa la shanla na cwe nang ngɛ lwenə ɓa yinfyaɓe ɓa nla na cwenə nang cwe ɓanu. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Gaɓa nga nə neku yona nəngwi ɓa samɓa. U sang nang ɓa jwa nə la tubali ɓani ɓa yo Nyimoː nə lasaɓa angye ɓa jwanə la sibe ɓani kəfi la gaɓeɓa, Kəfi nyi bəɓa gang gaɓa ngəniǃ Nyi nangɓə dwa yi nangja gaɓaǃ<verse eid="MAT 23:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="MAT 23:6" />Gaɓa nga shana də yido azanzan la yido yinyɔ ɓa dodə ade la yido ɓwa nəshi Yahudawa ɓa; <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Gaɓa nga shana na la yaɓado la lomo kəfi la kwi ɓa nə,&lt; ngwi maɓesa nang.&gt; <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Gua ɓe kwiwa nə &lt;ngwi maɓesa nang la&gt;Yonemani gua ku ngə nso ku ɓa ngwi maɓesa nang. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Kəfi gua ku ngwi ngɛ lanle la lasapyang nə Daa gua la, yonəmani gua u ɓa Daa nə nso la lankwã. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />bu dyaanə ɓe kwiwa nə nwanye ɓa la, &lt;yonəmani nwanye ka kɔnə Almasihuː. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ngwi agang la tangtowa unə nwinfɔ. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Ngwi nang nga cwenə lashiwa ngɔn ni ɛ fiwa kəmi, kəfi ngwi nang finə lashiwa kəmi ngɔn ni ɛ nawa gang.<verse eid="MAT 23:12" /></para>
  <para style="s">Yesɔ kən yo lashi ngwi fundang lashi ɓa</para>
  <para style="r">)<ref loc="MRK 12:40">Maku 12.40</ref>; <ref loc="LUK 11:39-42">Luka 11.39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20.47</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Bəɓa jwəgɔ laso wa gua, ngwi maɓesa dang nangzhĩ Musa ɓa Farisawaǃ gua ngwi fundang lashi ɓaǃ gua guu danywi sa nəngwi na ɓe dya la yido nəgang Nyimoː yi lankwã la sibe nəngwi ɓa, ama gua ɓa lashiu wanə u dya yimɓa la, kə ngu bi ngwi ngɛ ɓa nga dari na dyanə niǃ <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Jwə bəɓa lasoa, Ngwi maɓesa nang zhĩ Musa ɓa kəfi Farisawa ɓaǃ Ngwi fundang lashiu waǃ Gua gu danywi yi yido nəgang yi Nyimoː lasibe nəngwi ɓa, ama gua ɓa lashiuwa nə ba na dyanla yimɓa, ko gua la vfa ngwi ɓa angye ngu dari na dya niǃ <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Jwə bəɓa lasoa, ngwi maɓesa nangzhĩ Musa kəfi Farisawa ɓaǃ Gua ngwi fundang lashiuwaǃ Gua je gwa ɓa ngu ɓe jeku yona mɛ nəngwi nso la kanənsoa ni; kəfi sadenang gua menə ngɔn ni, gua nyang wa na ɓe ngwi nang la dyanə lava ni na nang gua ngəniǃ. <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />Jwe bəɓa soa, ngwi nyangwɔnsa ngwi ɓwonyi ɓaǃ Ngu maɓenə,&lt;Inə ngwi ngɛ ghanang ɓa lanywi pɛdang ngɔn ni, ɓa gwanla sa nang gɔ cwani; ama inə gɔ ghanang ɓa nta apyənpyəng la lanywi pɛdang ngɔn ni, ɓa gwɔ ngɔn.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ngwi ɓwonyi wasese ɓaǃ Ka anwa zanta ma, nta apyənpyən ko lanywi pɛdang angye nyang nə nta apyənpyəng tẽ ni ma? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Gua fi ma maɓenə, &lt;ine ngwi ngɛ ghanang ɓa yido nyanang ngɔn ni, gɔ ɓa gwɔnla sa nang ghang gɔ; ama inə gɔ ghanang ɓa nang naa lashi yido nyanang ngɔn ni, ɓa gwɔ ngɔn.&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Yu wa ɓwon ɓeɓaǃ Ka anwa zang ta, nang naa ko yido nyanang angye nyangwa tẽ ni ma? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Nankənə ngɔn ni, Sadenang nəngwi ghang nang ngɔn ɓa yido nyanang ni, gɔ u ghanang ɓawa kəfi ɓa nang naa sɔ lashiwa ni; <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />kəfi sadenang gɔ ghanang ɓa lanywi pɛdang ngɔn ni, gɔ ngu ghanang ɓa kəɓə kəfi ɓa Nyimo, angye dənə yimɓa ni; <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Kəfi inə ngwi ngɛ ghanang ɓa lankwã ngɔn ni, gɔ ngu ghanang ɓa yido də Nyimoː kəfi ɓawa ngwi angye dənə shiwa ni.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Jwə bəɓa laso, ngwi maɓesa nangzhĩ Musa kəfi Farisawa ɓaǃ Ngwi fundang lashiuwaǃ Gua naa Nyimoː nang nso sa jwua gua hakə ɓa ko nang la pika ni sa nang gua zwani, na ashita nə, jazhang, ɓwon, kəfi yi, ama gua nyi na nagang sa nang maɓesa nang azanzan yi nangzhĩ Musa; na nə nəngwi ɓa ade nə, kəfi sang yi laɓyɔ kəfi nang adede. Namɓani lunə ɓa, ɓu vfanə sa ngwi ngɛ ɓa la. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Gua ngwi ɓwonyi nyangwɔnsa nang ɓa <verse eid="MAT 23:24" /><verse number="25" style="v" sid="MAT 23:25" />Jwə bəɓa soa, ngwi maɓesa nangzhĩ Musa kəfi Farisawa ɓaǃ Gua ngwi fundang lashiuwa Gua u wala zinze jwe kəfi nkã yi gua, kə u vya laaɓa pɛɓa nyije nə kəfi shang yi lashi. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Gua ɓwonyi Farisawa ɓa uwa la jwe mbe, kəfi zinze wa ma la tetẽ ku. <verse eid="MAT 23:26" /><verse number="27" style="v" sid="MAT 23:27" />&lt;&lt; Jwə bəɓa lasoa, ngwi maɓesa nangzhĩ Musa kəfi Farisawa ɓaǃ Gua ngwi fundang lashiuwãǃ Gua ngəna jwɛ wii ajədo atẽtẽ ɓa, angye ɓa asang nə lantɛ zanzan ni ama la ɓa pɛ ɓa gwuu ɓa kəfi kwon azhãzha ɓa la la ɓa <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />La məngang sɔ ni, la baba gua ngə ya u zəzan sa nəngwi ɓaku, ama la lowa gua pɛ ɓa nang fundang lashiuwa kəfi ngwi nə nang anjɔ ɓa. <verse eid="MAT 23:28" /><verse number="29" style="v" sid="MAT 23:29" />&lt;&lt; Jwə bəɓa laso , ngwi maɓesa nang zhĩ Musa ɓa kəfi Farisawa ɓaǃ Gua ngwi fundang lashiuwa Gua ma jwɛ wii yi ngwi dandoswon ɓa zanzan kəfi nyang yinjwə ɓa yimɓa yi ngwi ade dənə nla ni; <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Gua u cwa ya, &lt; ntɛ je ngə la sayi daagang ja nloni, ntɛ je daɓaɓesa nang ye jwɔn nla. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Nankə gua cwan la baba ya gua ka nwi ngwi ɓa jənə ngwi dandoswon ɓaniǃ <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />U gha nə, nankənə, u yeshi nang daagangua fudi na nəniǃ <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Gua jwa ɓa kəfi nwi jwa ɓaǃ U nəɓəɓa lu chəng ya gua lavowa kə jəuwa mu ye la va ma? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Kəfi gəmə ngə cwowa nə ngə swondo ɓa ngwi dandoswon ɓa kəfi ngwi nyinang ɓa kəfi ngwi maɓesa nang ɓa; gua u jə ngwi ngɛ ɓa, gang ngwi ngɛ ɓa sa shi agang ɓa, kəfi ngwi ngɛ ɓa gua u gba ɓa tɛ la yido ɓwa nəshi kəfi bi ɓa yeha layi ɓa yi ɓa. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Gəmə ngə cwowa nə yo adeː Tɔri nang ku ɛ nənə ngwi ɓa jənə ngwi ade ɓani la gu lashiwa, lasa ngwi ade Abila hakə nang jə yi Zakariya nwi Berikiya, angye gua jənə la tangte lanywi pɛdang ɓa yido nyanang. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Gəmə ngə cwo wanə nankənəː nang falaɓyɔ yi ngwi jədo ɓani ɛ gu sa ngwi məncwon niǃ<verse eid="MAT 23:36" /></para>
  <para style="s">Yesɔ shan Urshelima</para>
  <para style="r">)<ref loc="LUK 13:34">Luka 13.34</ref>,<ref loc="LUK 13:35">35</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />urshelima urshelimaǃ Gu a jə ngwi dandoswon ɓa kəfi ca ngwi swondo Nyimoː ɓa nta angye Nyimoː swon ni soa ni Fin na gəmə ngə shana taɓe guwa gua ngwi gəɓa, na nang zɔ nga ɓwanə nwiwa ɓa la kpanzewa, ama gua dya mənə nla. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Nankə lanywi pɛdang ɛ vyawa nga yinse. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Begɔ ni hakə ɓete, gəmə ngə cwa nə, gua kɔ meti sang mə la hakə sɛ gua ya, &lt;Nyimoː nəwa ɓalka nə ngwi ɓanə ɓa yaa Daa Shayonki.&gt;&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesɔ bwa la lanywi pɛdang Nyimoː ngu gha kə nwi nangjwa gɔɓa sang wakə kwida wa cawa ɓesa nywi agang yi Nyimoː ɓa. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />&lt;&lt; Ku dyanə,&gt;&gt; u cwa yee, guwa sang nang ɓani nəbwɔ. Gəmə cwo nang ɓani nəː ko nta ngɛ nso kɛ vyanə də la shiwa la; ko anwa gaɓa ɛ cawa kəmi.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s">Saɓabu ɓa nang Tori ɓa</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />&lt;&lt;Na nang Yesɔ dənə la shin nta Zetu, Kə nwi nangjwa mɓa labe wa jwanjwa. &lt;&lt;A cwe nə sade anwa kə nang ɓani la nənə,&gt;&gt;Kəɓa byədo,&lt;&lt;ka nə la nənang yona caɓe nə ya ka məncwon nang mɓa gu ɓa yika sapyang sɔ.&gt;&gt; <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Yesɔ dya ɓanə yee, &lt;&lt;Unə akilo, bu vya ngwi ngɛ ɓe fundowa la. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Nəngwi ɓa ɓa ɓyagaɓa nə ɛ mɓa ɓa yaa mənə, ɛ cwa yee, Ka kəmə nə Almasihuǃ hakə ɓa fundang nəngwi ɓa ɓa ɓyagaɓa nə. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Gua uwa kuɓwon yo yi gwa ata ɓa jaala ɓowa kəfi gwa ɓa la do ajanja ɓa; ama gwowaa ɓe kə̃ la. Yiri namɓani la nenang jang, ama yanla yeshiwa banla. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Kəmi ɓa ɛ gbabang nə saɓa; Yido nəgang ɛ lwenə saɓa. Nywɛ kəfi Kəmi ɓa a yɛ laɓeje ku' <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Namɓani ku ɛ ngəna nangjwə nwi ɓe nə. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Kə ɛ gwa wa naa ngwi ɓa la tɔri kəfi ɓa jəu. Nwaku ɛ shiwa yo gə. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Nəngwi ɓa ɓyagaɓa nə ɛ jagwɔn sa yoade la sade sɔ; gaɓa ɛ ja nəswe saɓa kə-fi nyinə saɓa. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Ngɔn ni ngwi dangdoswɔn dansa ɓa ɛ bwa kəfi fundang nəngwi ɓa <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />yiri namɓani ma yo anjɔ la nyang nang shan nəngwi ɓa ɛ jwujwa. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ama ngwi nang gwanəɓe gha yeshiwa ngɔn ni la mə wii mə. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Kəfi yo anuanua yi yido nə gang Nyimoː ɛ cwa ɓeje ku la lasapyang yona ɓe shedaku sa nəngwi ku; kəfi yeshiwa ɛ ɓa. <verse eid="MAT 24:14" /><verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Gua u sang &lt; Nang a jwənjwə ɓa angye Daniyel cwani. ngəla yido atẽtẽ.&gt;&gt; Gua ngwi jwa kwa niː a nyinang nang ni nga cwa ni <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />&lt;&lt; Ngɔn ni ngwi ɓa la Yahudi ni la la je nta. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Ngwi nang ngə nə lashi nywi ni ɓu se kəmi la yona ɓu cwe nang ngɛ nə yigɔ la layi la. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Ngwi nang ku ngənə lasɛ ni ɓu fi ɓa layi yona cwe nandang zhi gɔ la. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />ɛ ngə bəɓa la sayi sɔ sa ngwa ɓa ɓanə lanə kəfi nɛ nwinyfe ɓa. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />U Pɛdang sa Nyimoː ya gua ɓu va ɓu kwela ɓa vang nə ko lalo awinwi. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Yona tɔri yi sade sɔ ɛ jwə ta yiri angye ɓa ku meri nənə nang ni, lasa fudi yi lasapyang hakə nwinza. KA angɛ ngənə ɛ ɓa nankənə. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ama Nyimoː gəmbe gadang lalo ɓasɔ ngɔn; nte gɔnə nakənlani, ngwi kɛ mə bwa ɓa wiinla. Yo ngwi gɔ ɓa cweni, Konteku, Nyimoː ɛ gadang lalo ɓasɔ. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Nankə, inə ngwi cwonə ya, &lt; Asang, Almasihuː ngə lanleǃ &gt; ko &lt;lanlo gɔ ngə yimɓaǃ' ɓa dyanə la. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Yo Almasihuː dansa ɓa kəfi ngwi dangdoswɔn dansa ɓa ɛ bwa; ɛ nə nang yiswe agang ɓa kəfi nankə̃ gwɔn ɓa yona ɓa fundang ngwi ɓa Nyimoː cwe ni ma, nte la dədə ni. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Waniǃ Gəmə cwa namɓani nə mbegə kə nang ngɛ nənang. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Ko, inə nəngwi ɓa ɛ cwowa nə, &lt;Sang, gɔ ngə lapɛdoǃ &gt; ɓa gha yi mɓa la; ko ɓa yoya &lt; Sang, gɔ jwa lanleǃ ɓa dya ɓanəla. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Yo Nwi Nyimoː ɛ mɓa na nang ca va nə angye nga canə laje kuni la lankwã ni la ɓenwe hakə ɓe gwɛ. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Yido nangkũ nang awuuwuu ngə ni kayimɓa gwa ɓa ɛ ɓwanə.<verse eid="MAT 24:28" /></para>
  <para style="ms">Nang mɓa Yesɔ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Ba ɓe la zinze lalo ɓanu, lo ɛ ɓe yidavu, se kɛ tẽ la, ɓyən ɛ bwa la lankwã ɛ gu kəmi, kə njamu ɓa lankwã ni ɛ deɓa yegha layido də gaɓa. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Nankəɓə kə la sang nənang caɓesa yi Nwi nəngwi la bwa la lankwã; kə nəngwi la lasapang ɛ lɛlɛ a jwənjwə nanang ɓa sang Nwi Nəngwi ɓanə la lankwã ɓa njamu nə kəfi nyə gang. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Kə nyə jwɔ agang ɛ lɛ, kəfi gɔ nyang maleka gɔɓa gha la ɓyən nea nyi lasapyang, kəfi gaɓa la ɓwa ngwi ɓa canəɓesa ɓani.la ɓyən nso yi lasapyang ghakə ɓyẽ anso yi lasapyang. <verse eid="MAT 24:31" /><verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;U vya shi nzu mowaɓe sa nang nyi. Sadenang pa ɓa lwene ngɔn nga gbɛnə ja ngɔn ni kəfi fudi na cwi jashi ngɔn ni, gua nyiya van zədo ngɔn.<verse eid="MAT 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 24:33" />Nankəɓenə ngɔn i, sadenang gua sang namɓani ngɔn ni,gua lu nya sade sɔ zədo na fudi. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Gua nyi ngɔn gəmə ngə cwowanə, ngwi lasapyang ɓa ni kɛ wuuku la ngɔn ni kə namɓani ku ɛ nenang . <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Lankwã ɓa lamə la kukwe, ama yo gəɓa kɛ kwela.<verse eid="MAT 24:35" /></para>
  <para style="s">Ngwi ngɛ nyi sade sɔ ko sayi so</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Ngwi ngɛ nso nyi, konteku,sadenang lalo sɔ ko sayi la ɓa ni, ko maleka ɓa ko Nwi; ka Daa nso kə nyi. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Nang ɓa yi Nwi Ne-ngwi ɛ ngəna nang nənang sayi Nuhu ni. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />La sade ɓasɔ ngɔn kə di mudo ni nəngwi ɓa nga tang nga faa, nyənənwo ɓa nyənəngwa nga fye nə swe, ghakə ghanə lalo Nuhu dyanə lagwani. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Aɓeku gaɓa nyinla kanə nga nenang ngɔn kə di mudo ɓa kəfi zwɛɓa kwenə kupaca. Nankənə ɛ nənang sadenang Nwi Nəngwi ɛ mɓani. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Nyənənwon ɓa mba nganpan la lase, ɓa cwe nso ɓa vya nso. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Nyinəngwa ɓa nga gwanang ɓa cwe nso ɓa vya nso. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />&lt;&lt; Nə akilo, nankənə, yonemani gua nyi sayi nang Daa shayonki gua la ɓa.a ni nla <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Inə sha layi nyi sayi nang ngwi yinang la ɓani, gua nyi ngɔn kɛ gu a ngayinga la a dəɓa yifi kə anyangwɔn sa nangua yona ngwi nanyi ɓe gbən danywi layi gu kə yinang la. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Nankəbə gua ma udə ɓa akilo nə, gua nyi sayi nang Nwi Nəngwi la ɓa ni nla.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt;Kanənyo, nankənə, ka nwi layi wa nyinang? Ka ngwi nang sha layi gɔ la nyanwanə shi nang gɔɓa lu nyangnə gwɔn sa nwifi nwi layi ɓa yona gɔ naɓa nang tang gaɓa la sayi nəɓwɔ ni. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />La sang bəɓa sa nwi layi sɔ ngə shayi gɔ ɓa mewa u nə nəɓwɔ sadenang gɔ finə ngɔn niǃ <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Gəmə ngə cwowa yo ade nə, shayi nwinfɔ ni ɛ nyang wa sa nang gɔɓa kupaca. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ama inə &lt;Shayi gɔ ka nwi layi anjɔ, gɔ u cwa lashiwa nə ya shayi gənə kɛ fi ɓabe la, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />kəfi u fudi na gbaa nwinfɔ nwi layi ɓa kə u tang kə u faa ɓa ngwi ji shi ɓa. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Nshayi nwinfɔ ɛ ɓa sade nang nwinfɔ sɔ nyila ya shayi gəne la ɓani ɓa sayi sɔ. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Nshayi gɔ ɛ gba wa kəfi tori gɔ na ngwi fundang saɓa nə. ɛ lɛlɛ kəfi ɓa tang nyiɓa.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Lasade sɔ yi nəgang lankwã ɛ ngə na nang ni. sade ngənə nwanəngwa njua angye ɓa cwenə nang cava gaɓa kə a bwa ɛ jwanə ɓa sha gwanpa. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Nto la tangte ɓa ka ngwi sese ɓa, nto ka ngwi nyinang ɓa. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Wasese ɓa la tangte ɓa cwe nang cava gaɓa ama ɓa cwe mu ngɛ ɓa cho ɓa gwaɓenla. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ama wanəngwa wa nyinang ɓa cwe nang chava gaɓa kəfi ɓa cwe bɔungɛ cho ɓa ye mu la la ɓa. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Kə sha nəngwa jado mɓanla, kə gaɓa fudi na ngayinga. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Gwɔdo gəmbe nə ngɔn sadenang ɓa wanə ye bwa, &lt;sha ngwanpa lanle yeǃ Bwa ɓa jwanə ɓawaǃ &gt; <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Kə nwi anəngwa njua ni ɓani ɓa lwe kə ɓa ma nang cava gaɓa. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Kə wa sese ɓa ni ye nwi anəngwa wa nyinang ɓani ya, &lt; U ne mune la pika, yonəmani muu je kangɔn.&gt; <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Ama nwi anəgwa wa nyinang ɓa ni kə ye, &lt;muu je kɛ masowa ɓɛla. U gha la yido ya muu u yaa yi gua. &gt; <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Kə wasese ɓani kwe ɛ yaa muu gaɓa; kə sade ɓa kwen ni, kə sha ngwa pa dyado. Nto angye ɓa maanə saɓa yo yifye sɔ ni gha ɓawa layido yifye sɔ, kə ɓa gu danywi. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />&lt;&lt; Latwa kə nwifi wanəngwa ɓani mɓa. &lt; Shayi, nshayi a bwe danywi ne. <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />&lt; Ku yeɓaya yoade gəmə nyiuwa nla. &gt;&gt;, <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Kəfi Yesɔ yeshiwa ya,&lt;&lt;Unə akilo, nankənə, yonəmani gua nyi lalo ko sayi nla.<verse eid="MAT 25:13" /></para>
  <para style="s">Nashoo yi Nwilayi ɓa nca</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />La sadesɔ yi nə gang lankwã ɛ ngəna nang ni. Sade ngənə ngwi ɓə ngɛ angye zedo na ghanə zhɛ ni; kə u kwida nwi layi gɔɓa kəfi nyang ɓa nyangwɔnsa nang gɔ ɓa. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Gɔ na nwaku na nang njamu ngəniː lasa nso u naa fuu nto yi shede ce ɓa, lasa ngwi ngɛ una fuu mba yi shede ce, kəfi sa ngwi anso u naa fuu nso yi shede ce. Nankənə kə u kwɛzshɛ. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Nwi layi ɓa naanə fuu nto ni kwe ɓa be kə gha nə firu ɓa yigɔ kə mə fuu ngɛ nto. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />nankəɓənə ngwi naa nə fuu mba ni u mə fuu lɛnə mba. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ama nwinfɔ naa nə fuu nso ni kə u kwe, u ka jwɛ la kəmi, kə jwa ce shede yi shayi gɔ. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />&lt;&lt; Sayi məncwon ɓa nə kə shayi nwinfɔ ɓa sɔ fi mɓani kə nwaku mɓanə nang ɓa naani. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Nwinfɔ nang cwenə fuunto ni ya, nshayi, &lt;Asangǃ a nəma fuu nto kəfi mə nang lashiwa fuu nto, <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />nshayi gɔ yewa ya, gu aka nwinfɔ adede,&gt; Gu a ɓa na nyangwɔn sa nang apika ngɔn, Gəmə ngə nyo sa nang agang. Aɓa ɓa wanua aɓaməǃ &gt; <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />nwinfɔ nang cwenə fuu mba ni ya, nshayi, a nəma fuu mba, kəfi mə fuu mba la shiwa. <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />shayi gɔ yewa, nwinfɔ adede. &lt; gu a nyangwɔn sa nang apika ngɔn, nankənə gəmə ngə yo sa nang agang. Aɓa ɓa wanua aɓamə. <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />kə nwinfɔ nang cwenə fuu nso ni kə u ɓa ɓu ya, shayi gəmə nyu ngɔn gu a ka ngwi a jwənjwə nga sha nang yɔ la yidonang gu a zwa la ni, gu aka ngwi shanang ayinse. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Gəmə ngə yiyi kə nga di fuu gu la kəmi. Asangǃ kanang gu ye. &gt; <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />GU aka nwi layi anjɔ kəfi ngwi jajɔǃ shayi cwawa nə.Gu anyingɔn, gəmə ngə shanang yido gəmə zwãlani kəfi ngə ɓwanə nanpang yido nang gəmə yenə nlani? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Nte, gu aye fuu gəɓa layido bwa fuu ɓa nte ɓani gəmə nə mə nang ngɛ mə shiwa. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Ɓeni, u cwe fuu shede ce sɔ la ɓewa kəfi naa ngwi ɓanə njua nə la ɓewa ni. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Yonəmani sa ngwi nang ɓanə kəbənə ni ɛ twawashi ɓa byagɔnə fi ɓa nawa negang; ama sa ngwi nang nene ɓa nang ngɛ nəni ko ka nang ma kanə yigɔ ni ma ɛ mumu la ɓewa. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Ama sa nwi layi ni nene ɓa bwatɛ ni ucawa la davu; ɛ lɛlɛ kəfi tang gwenyiɓa. &gt;<verse eid="MAT 25:30" /></para>
  <para style="s">Nang yeshi tita</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />sade nang nwi nəngwi ɛ ɓanə na kwənə ɓa maleka ɓa ku paca labewa, gɔ u də lashi yido nəgang yi kwə gɔ, <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />kəfi nəngwi lasapyang ɓa kupaca ɛ ɓwabewa. Ngɔn ni gɔ u gaɓa mba, na nang sha nangkũ nga ganə ngaang ɓa ɓuu ni. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Gɔ u nyang ngwi adede ɓa la ɓezhi kəfi ngwi ngɛ ɓa la ɓeshang. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Nankənə kwə ɛ ye ngwi ɓa la ɓezhi gɔni ya, &lt;U ɓa, gua daagə nowa nə balka nəniǃ U ɓa ɓu cwe yido negang ɓa manə yogua tun lasa ma lasapyang. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Gəmə ngə wa nywe kəfi gu anəma ntang, tsu diɓi kəfi anema faa; ngə ka ngwizhɛ kəfi gu anəma do nga la layi gua, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />gəmə tafĩ ɓe gua nəma nang nə jani, samə nga jwə gua nyangwɔn samə, la la fusina gua kafi mə u yamədo. <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Ngwi ade ɓa ɛ dyawanə ya, &lt;Lonwa, Daa shayonki, je meri so nga wa nywe kə je noo nantang, kəfi lonwa je so nga wansu kə no diɓi ma? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Fi lonwa je so nə ngwizhɛ kə je noo do nga ko a nɛnɛ ba nang jaswe nə kəfi i joh nang janə? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Lonwa je so la eusina kə yaa so? <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Kə kwə ɛ dyowanə ya , &lt;gəmə ngə cwowa nə, sadenang ku gua nənə nangni sa nəngwi nso apika sa ngwi ɓa nga ka nəsamə ni, u nə kəmənə. <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />&lt;&lt;Nankəɓə kə gɔ u ye ngwi ɓa la ɓeshang ni ya, &lt; Kwe lanle atamə donə, gu a ngesa nang ja yi Nyimoː Kwenə ɓe lava yidi maanə shetan nə ɓa maleka gɔɓa ni. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Nywe nga jə mə ama gu anəma tang la, suu nga jə mə gu anəma dibi faa nla;. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ngə ka ngwi zhɛ gu anəma do nga nla layi gua, ta fi mə ɓe gua nəma nangja swe nla; ngə la fusina gua nyangwɔn samə nla <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Nankənə gaɓa ɛ ya, Lonwa, Daa shayonki,je so nga wa nywe kə no nang tang nla ko nga wa suu kə no dibi nla ko nən ngwizhɛ kə no do nga nla ko lonwa aka ngwi nangjwə ko la fusina, kəfi je bali gu nla ma? <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Kə Kwə ɛ dyaɓanə ya, sadenang ku gua nyinə na nə nso nə la tangte apika ɓa nene ɓa nang ngɛ ni , gua nyi na bali gə. <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Ngwi ɓani, nankənə, ɛ yeɓa la yido la tori nang la kaanla ni, ama ngwi ade ɓa gha yido anuanua la kaanlani.<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Nga kã məngang na gwa Yesɔ</para>
  <para style="r">)<ref loc="MRK 14:1">Maku 14.1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">Luka 22.1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Yohana 11.45-53</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Sade nang Yesɔ yenəshi nang mãɓesa nang ɓa ni, gɔ cwa nwi na ngjwa gɔ ɓanə, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt; La gwən mba, kənə yingwɔ lalo nangang, kəfi nwi nəngwi ɛ nawa yona ɓa gba wa sa shĩ. &gt;&gt; <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Nankənə kə nwanye ngwi nangzhĩ ɓa kəfi nwanye ɓa ɛ bwanə la yido də Kayifa, nwanye ngwi nangzhĩ, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />kəfi nə cwon na gwa Yesɔ lakənkən kəfi nyangwa ɓa jəwa. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />&lt;&lt;Gaɓa cwa ya,&gt;&gt;Je kɛ nə lasade yinyɔ la, &lt;&lt;ko nəngwi ɓa ɛ lwenə kuɓwon.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">A fã Yesɔ muunə la Betani</para>
  <para style="r">)<ref loc="MRK 14:3-9">Maku 14.3-9</ref>; <ref loc="JHN 12:1-8">Yohana 12.1-8</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yesɔ ngəla Betani la layi Siman, ngwi nang tori sa nangjwə vaa swe. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Kə sayi nang Yesɔ nga tang nang ni, kə ngwa ngənə mɓa ɓa bo nang pɛnə ɓa muu anywinywi ni shede gɔ gang wane angye gɔ yenə la lashiwa ni. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Kə nwi nangjwa ɓa sang nangni kə ɓa lwenə lɔ. &lt;&lt; Kayonə ɓa janang na nangni ma?&gt;&gt; Gaɓa ɓyədo. <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Muu nywiswe ni nte ɓa cwe a yaa ɓa shede agang nə ngɔn ni kə ɓa cwe shede sɔ ɓa naa ngwi laɓyɔ ɓaǃ&gt;&gt; <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Yesɔ nyinang gaɓa nga cwani ngɔn, kəfi nankə gɔ yeɓa yee, &lt;&lt;Kanə mowa u kanə gwani ni nye? Ka nang azanzan kəfi ade nang gɔ nəni lasamə.<verse eid="MAT 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 26:11" />Gua lonwa ku lu ɓa ngwi laɓyɔ ɓasɔ nə labowa, ama kɔ memə la lonwa ku. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Nang gɔ nəni kə u yenə muu ni la lasamə ni yona mamə nyang yo nang dĩ gə. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Ɓeni, gəmə ngə cwowa nə kolaje ɓa cwanə yo anuanua la lasapyang kuni, nang gɔ nəni lacwucwa yona ɓa chəng yo gɔ. &gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">Yahuda dyanə ngɔn na naa Yesɔ</para>
  <para style="r">)<ref loc="MRK 14:10">Maku 14.10</ref>,<ref loc="MRK 14:11">11</ref>; <ref loc="LUK 22:3-6">Luka 22.3-6</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Nankənə kə nso latangte nwi nangjwa gɔ ɓa, yaawa ka Yahuda Iskaroti, dyala sa nwanye ngwi nangzhĩ <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />kəfi byədo, &lt;&lt;Kanə gua lu nəma ngə gəmə naa Yesɔ ngɔn la soa ni?&gt;&gt;Gaɓa cwa yimɓu kaanso cwin jua yi ce ɓa kəfi ɓa nawa. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />La yimɓa kə Yahuda nga ka məngan nang lu nanə Yesɔ la laɓe ɓani.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesɔ tang nang yi yeshiwa</para>
  <para style="r">)<ref loc="MRK 14:12-21">Maku 14.12-21</ref>; <ref loc="LUK 22:7-13">Luka 22.7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yohana 13.21-30</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />La lalo a gəmbe yi nyinywɔ yi nwa nene ɓa nang mə gɔ ni kə nwi nangjwa ɓa mɓa sa Yesɔ kəfi ɓa ɓyəwa, &lt;&lt; Laje gu nga shang na jee li ma nang tang yi nyinywɔ agang gang yo gu ma? &gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />&lt;&lt; U gha sa ngwi ngɛ la yii agang,&gt;&gt;Gɔ cwa ɓanə ya, &lt;&lt; kəfi u cwawa nə, &lt;Ngwi mãɓesa nang ya, sade gə mɓa ngɔn; nwi nangjwa gəɓa kəfi ɓamə ɛ wanua ɓa la layĩ gu.&gt;&gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Kə nwi nangjwa ɓa nə na nang Yesɔ cwaɓa nə ni kəfi ɓa ma nang tang yi agang gang. <verse eid="MAT 26:19" /><verse number="20" style="v" sid="MAT 26:20" />Sade nang logwa ni kə, Yesɔ kəfi nwi nangjwa gɔɓa njua cwin mɓa də ɓawa yona ɓa tang nang. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />La sade nang tang sɔ kə Yesɔ ya , &lt;&lt; Gəmə ngə cwowa nə, nso la tangtowa ɛ naamə na.&gt;&gt; <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Kə nwi nangjwa gɔ ɓa lwenə lɔ kə ɓa fudi na byəwa ya, nso nso, &lt;&lt;Yoade, Daa shayonki, gu a ya ka kəmə ma? &gt;&gt; <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Yesɔ dya ɓanə, &lt;&lt; ngwi nso ngənə ngə tang nang la lajwen nso ɓawa gɔ u jãmə jã. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Kə nwi nəngwi ɛ wuu na nang kwãɓa cwani ya gɔ u wuu ni, ama ɛ jwə bəɓa lasa ngwi nang la nanə nwi nəngwi niǃ Zəzan na ngwi sɔ ngə ɓa myawa nlaniǃ &gt;&gt; <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Yahuda, ngwi jã nəngwi, cwayo ya. &lt;&lt;Yoade, Ngwi maɓesa nang, gu aya ka kəmə ma?&gt;&gt; Gɔ byədo. &lt;&lt;Yesɔ dyawanə ya gu a cwa ngɔn.&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="s">Nang tang yi logwa Daa shayonki</para>
  <para style="r">)<ref loc="MRK 14:22-26">Maku 14.22-26</ref>; <ref loc="LUK 22:14-20">Luka 22.14-20</ref>; <ref loc="1CO 11:23-25">1 Korintiyawa 11.23-25</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Sade nga tang nang ni, Yesɔ cwe nwa fya, u pɛdang wisi ɓa, kəfi na nwi nangjwa gɔ ɓa. &lt;&lt;Cwe kəfi u tang, &gt;&gt; gɔ ya; &lt;&lt;ka naang samə yee.&gt;&gt; <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Nankənə gɔ nwinkwi, u wisi Nyimoː, kəfi u naɓa. &lt;&lt;u faa nang ni, gua kupaca, &gt;&gt; gɔ cwa ya; <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />&lt;&lt; Ka jwɔn gə yee angye gwɛnə akawa Nyimoː ni, jwɔn gə ye kəmi yo nəngwi aɓyanɓya yo na mə yafi yi nang anjɔ gaɓa. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Gəmə ngə cwowa nə kɛ meri faa dĩni la sɛ lonang gəmə ngə faa nə ɓowa layi nəgang Daagə.&gt;&gt; <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Sadenang ɓa tanə dyən ni kəfi ɓa kwenə la shinta yi Olif.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesɔ cwa ya Bituru ɛ nyinə</para>
  <para style="r">)<ref loc="MRK 14:27-31">Maku 14.27-31</ref>; <ref loc="LUK 22:31-34">Luka 22.31-34</ref>; <ref loc="JHN 13:36-38">Yohana 13.36-38</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Nankənə kə Yesɔ cwaɓanə yee, &lt;&lt;Nwinza laduda ni gua ku paca u vəva kəfi gua u fhamə, yo kwa Nyimoː cwa yee, &lt;Nyimoː ɛ jə ngwi zanang ku, kəfi ngaang yi tɔ nanku ɛ shenəbe.&gt; <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Ama lasinze ɓa lwemənə ngɔn ni ɓa wii nəngɔn ni, gəmə ngə gəmbe hakə la Galili mbe gə gua.&gt;&gt; <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Bituru cwayo kəfi ye Yesɔ ya, &lt;&lt;Gəmə kɛ meri fvo la, konte nwifiwa ɓa la nənə niǃ &gt;&gt; <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Yesɔ cwa Bituru nə ya, &lt;&lt;Gəmə ngə nə ya ɓako zɔ lɛlɛ laduda nwinza ni, gu a cwa fin nca ya gu a nyi mənla. &gt;&gt; <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Bituru yewa ya, &lt;&lt; Gəmə kɛ meri cwa nla, konte gəmə ngə wuu ɓoniǃ&gt;&gt;Kəfi nwifi winangjwã gɔɓa ku cwa nankənə.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesɔ pɛdang la Gatsamani</para>
  <para style="pi">
    <verse number="36" style="v" sid="MAT 26:36" />Nankənə kə Yesɔ ɓa winangjwã gɔ ɓa kwela yido nang nga kwinə Gatsamani ni, kəfi yeɓa ya, &lt;&lt; U də lanle ngɔn ni kə gəmə kwe ngɔn lo nga pɛdang, &gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Gɔ u ghaɓa Bituru ɓa nwi Zaɓadi ɓa mba. Nang a jwənjwə ɓa tori mɓa lasɔ, <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />kəfi u yeɓa ya, &lt;&lt; Kə nang nga jumə nəni la sɛgwɔn məni gang tawi mə hakə nga shana ɓemə ngəmi. U də la ngɔn le kəfi ugwa soa nyang lu sangdo ɓamə.&gt;&gt; <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Gɔ zhã u ghabe latwa, kə u gu kəmi shibewa la kəmi, kəfi u pɛdang, &lt;&lt;Daagə ngə ntẽ la nənə ni, acwe nwikwi yi tori ni laɓe məǃ Ama kanang gəmə ngə shang ni la, ama kanang gu nga shang ni.&gt;&gt; <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Nankənə kə u fi ghasa nwi nanjwa gɔɓa nca kəfi gɔ meɓa nga ngayinga; kəfi gɔ ye Bituru ya, &lt;&lt;Ka nənə nang kə gua nca ni kɔ ɓa damɓe sa sang zhi yi ce nso la ma? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Lu sang zhi yona gua ɓu gu sa nang mala. Kə Nyingu nga shang, ama kə swe nene ɓa njamu nə. <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Aɓeku Yesɔ mafi ghabe ku pɛdang, &lt;&lt;Daa gə, inə nwinkwakwin yi nang tori ni kɛ ɓa cwela sɛ gəmə faa wa mbe, nang gu nga shani dəngɔn.&gt;&gt; <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Gɔ fi mɓa aɓeku ɓu mə nwi nanjwa gɔɓa nga ngayinga; gaɓa banla na nyang zayi ɓa bwenbwe nla. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Haɓeku Yesɔ vfaɓa, kwenə ɓe, kəfi gɔ pɛdang yi nca, u cwa yiri yoɓa nso. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Nankənə kə gɔ fi ɓu mɛ nwi nanjwa gɔɓa kəfi yee, &lt;&lt;Aɓeku gua u nga yinga kəfi u wi? Sangǃ Kə sayi mɓa ngɔn na ɓa yona nwi nəngwi na ɓa nawa sa njamu yi ngwi nang anjɔ ɓa.<verse eid="MAT 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 26:46" />U lwe lankwã, ka ngwi ɛ naamə ni yee. &gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s">Nangwa yi Yesɔ</para>
  <para style="r">)<ref loc="MRK 14:43-50">Maku 14.43-50</ref>; <ref loc="LUK 22:47-53">Luka 22.47-53</ref>; <ref loc="JHN 18:3-12">Yohana 18.3-12</ref>&lt;&lt;</para>
  <para style="pi">
    <verse number="47" style="v" sid="MAT 26:47" />Yesɔ nga cwayo sayi nang Yahuda nso lasa njua cwin mɓa nwi nanjwa, mɓa. Bawa ka nəngwi ɓa ɓyanɓya ɓa kafɛ ɓa kəfi shi ɓa kəfi ɓa swon ɓa laɓe nwanye nyanang yi ngwi nyanang ɓa kəfi nwanye ɓa. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Kə ngwi jã nəngwi sɔ naɓa nang caɓenə ngɔnː &lt;&lt; Kə ngwi nang gəmə kpanwa ngɔn ni ka kɔnə ngwi gua u shani wa. Gwawaǃ &gt;&gt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Yahuda ghasa Yesɔ kəfi ya, &lt;&lt;A jwanjwa də ɓo, Ngwi maɓesa nang, &gt;&gt; kəfi u kpanwa. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Yesɔ dyawa nə ya,&lt;&lt; Anə ɓa be sa nang sɔ, nda məǃ&gt;&gt;Kə ɓa mɓa, gwa Yesɔ, kəfi ɓa gwa wa ɓa nyenə. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Nso sa ngwi angye ɓa ngənə ɓa Yesɔ ni da kafɛ gɔ kəfi jwanə nwinfɔ yi nwanye nyanang, jwa cwɛwa cagha. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />&lt;&lt; Afinə kafɛ gu layi do gɔ, &gt;&gt; Yesɔ cwawa nə. &lt;&lt;Ngwi nangku cwenə kafɛ ngɔn ni la wuu laɓe kafɛ. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Gua nyinla gəmə nə mɓa na kwi Daagə yona ubali gə, kəfi layimɓa gɔ lu swondo samə ɓa maleka ɓa njua cwin mɓa yi soje ɓa?<verse eid="MAT 26:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 26:54" />Ama ngə nankəni, nəɓeba kwaã ɓa laɓenə ade angye ya nangni la nənə nang ni? &gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Nankənə kə Yesɔ cwa cwi nəngwi ɓa nə, &lt;&lt;Gua luɓə ɓa kafɛ kəfi shĩ ɓa yona gwamə nə, yapɛ gəmə nka ngwi ja yo tita ma? Lonwa ku gəmə də ɓowa kəfi ngə maɓesa nang la layi Nyimoː,kəfi gua gwamə nla. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ama namɓa ni ku nənang yona namɓani ɓenə ade nang Ngwi doswon ɓa jwanə la lakwaã ɓa ni.&gt;&gt;Nankənə kə nwi nangjwã gɔɓa ku va kwenə ɓe.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesɔ labe layinse nwanye Yahudawa ɓa</para>
  <para style="r">)<ref loc="MRK 14:53-65">Maku 14.53-65</ref>; <ref loc="LUK 22:54">Luka 22.54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Yohana 18.13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Ngwi ɓa gwanə Yesɔ ni cwewa ghanə layi Kayifa, Nwanye ngwi nyanang ɓa, la yimɓa kə ngwi maɓesa nang ɓa yi nangzhĩ Musa kəfi nwanye ɓa ɓwa nəshi kuni. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Bituru nga kasawa ɓa jagɔnə, ja na yido nə tita yi Nwanye nyanang layigɔ. Gɔ gha layido nə tita kəfi u də ɓa ngwi sang zhi ɓa yona gɔ sang nang la nənə nang ku ni. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Nwanye nyanang ɓa kəfi nəngwi ku la yido ɓwa nəshi nga dari na mə yo dansa lashi Yesɔ yona ɓa menə ɓa jəwa; <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />ama ɓa mə nang ngɛ nla, konte nəngwi ɓa ɓyagaɓa nə mɓa be ɓa yo dansa ɓanə lashiwa. ɛ kani kə nəngwi mba bwa mɓa ngə ɓa laakwã <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />kəfi ya,&lt;&lt;Ngwi ni ya,&lt;Gənə bana yee layi Nyimoː kəmi kəfi gwen nca ngɔn ni nə mãwa lwenə laankwa.&gt;&gt;&gt; <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Kə nwanya ngwi nyanang ye Yesɔ ya,&lt;&lt;Gu gɔ anene ɓa yo nang la cwani lama sa nang ɓa nga cwanə lashiu ni la ma? &gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ama Yesɔ gadonə. Fikə nwanye nangzhĩ cwayo lasawa,&lt;&lt;Ba yaa Nyimoː ɓanə wii nəni gəmə nyang nang ghang ngɔn la ɓoː a cwɛnə ngə ka kunə Almasihuː ni, Nwi yi Nyimoː.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesɔ dyawa nə ya, &lt;&lt;Nankə gu a cwa ngɔn. Ama gəmə ngə cwa nwaku nə la soaː laɓeɓe ni gua lu sang Nwi Nəngwi də laɓe ɓezhi yi Shagang kəfi uɓa la shi nkwã yi laankwãǃ &gt;&gt; <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />lasa yoni kə nwanye nyanang gwa nang sɔ ɓa nyanəɓe kəfi u ya, &lt;&lt;Yo anjɔǃ Je kɛ ka ngwi shedaku ngɛ la ɓegɔǃ Gua wa yo anjɔ gɔɓa ngɔnǃ <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />kanə gu nga chəng ma?&gt;&gt;Gaɓa dyanə ya gɔ unə nang anjɔ ngɔn kəfi lu wuu jang.&gt;&gt; <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Nankənə kəɓa fi ntetɛ lasawa kəfi ɓa gba wa; kəfi ngwi ɓa la fãnə ɓa gaɓe ni <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />ya, &lt;&lt; acwɛ yo doswon nə, Ngwi pondoǃ A nyi ngwi angye gbo nəni ngɔn&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s">Bituru nyi Yesɔ</para>
  <para style="r">)<ref loc="MRK 14:66-72">Maku 14.66-72</ref>; <ref loc="LUK 22:56-62">Luka 22.56-62</ref>; <ref loc="JHN 18:15-18">Yohana 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Bituru dəla yido nə tita sadenang nso yi nwinfɔ nwanye nangnya nə nyənəngwa mɓa lasawa ya,&lt;&lt;Gu, ma, a ngə ɓa Yesɔ yi Galili.&gt;&gt; <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Ama kə gɔ nyi labe ɓa ku paca ni. &lt;&lt; Gəmə nyi nang nga cwanə yo shiwa ni nla,&gt;&gt; gɔ dyaɓanə, <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />kəfi kwenə ɓe la danywi dya yido tita.Nwanəngwa ngɛ nwinfɔ sang wa kəfi cwa nəngwi ɓanə layimɓa, &lt;&lt;Gɔ ngə ɓa Yesɔ yi Nazare. &gt;&gt; <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Aɓeku Bituru nyi yo sɔ kəfi ya, &lt;&lt;Gəmə ghanang ya gəmə nyi ngwi ni nlaǃ &gt;&gt; <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Lazinze latwa ni ngwi ɓa ngənə layimɓa ni mɓa sa Bituru. &lt;&lt; Yoade gu aka nso gaɓa,&gt;&gt;Gaɓa cwa.&lt;&lt;Kanə pɛ ma, yiri yo cwa gu caɓeso ngɔn.&gt;&gt; <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Nankəɓənə kə Bituru ya, &lt;&lt;Gəmə ghanang ngɔn ya gəmə ngə cwayo adeǃ Nte Nyimoː tori gə ngə ne gəmə ngə cwanla niǃ Gəmə nyi ngwini nlaǃ &gt;&gt;</para>
  <para style="pi" vid="MAT 26:74">Layimɓa kə zɔ lɛlɛ, <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />kəfi Bituru chəng yo nang Yesɔ cwawa nəniː &lt;&lt;Mbegə zɔ nwon lɛlɛ ni, gu nyasang gə fin nca ya anyimə nla.&gt;&gt;Gɔ kwe ntɛ kəfi lɛlɛ ɓa minə ɓa nyenə.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Acwe Yesɔ ghanəbe Bilatu )Maku 15.1; Luka 23.1, 2; Yohana 18. 28-32&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ba nvulanə paca nwanye ngwi nyanang ɓa kəfi nwanye ɓa wanə dan sa yiri nang la nənə lashi Yesɔ yona ɓa jəwa. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Gaɓa ɓa dwəwa ɓa ce ɓa, kwewa nə, kəfi nawa laɓe Bilatu, gwamna yi Roma ɓa.<verse eid="MAT 27:2" /></para>
  <para style="s">Nang wuu yi Yahuda.</para>
  <para style="r">)A.M 1.18,19&lt;&lt;</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Sadenang Yahuda, ngwi jãwa, nyinə ya ɓa dyanə ngɔn ɛ jənə Yesɔ ni, gɔ tubi kəfi finə ce kaanso cwin jua lasa nwanye ngwi nyanang ɓa kəfi nwanye ɓa. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />&lt;&lt;Gəmə nə nangjɔ ngɔn sa ja ngwi nənə ayibe lani yona ɓa jəwaǃ &gt;&gt; gɔ u cwa. &lt;&lt;Kanənə yije sa nang nu ma?&gt;&gt;Gaɓa dyawa nə.&lt;&lt;Nang nu kayi guǃ&gt;&gt; <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Yahuda ye che shede sɔ kəmi la lanywi pɛdang kəfi u kwenə ɓe kə u Ghasɔ sa shĩ. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Nwanye ngwi nyanang ɓa cwe ce shede ɓasɔ kəfi ya, &lt;&lt;Ka shede jwɔn yee, kəfi zanla lasa yo nangzhĩ je na finə aye la yido ɓwa nang la lanywi pɛdang. &gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Layimɓa kə gaɓa wanə saɓa ya gaɓa kɛ nə nangnu ɓa shede sɔ ɓa yenə lasə&lt; la yido nga kanə nlɔ nga mãnə vee ɓani nə yido diywi ngwi zhe ɓa. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ka kənə nga kwi yido sɔ ya lasɛ jwɔn hakə nwinza.<verse eid="MAT 27:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="MAT 27:9" />Nankənə kə nang ngwi swondo Irimiya cwa ni ɓenə yoadeː &lt;&lt;Gaɓa cwe yice shede sɔ kaanso cwin jwa, nang ngwi Isrelawa ɓa dyanə ni na wonəshi Yesɔ ni, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />kəfi ɓa nə nangnu ɓa shede sɔ kə ɓa yenə lasɛ yido mã vee na nang Daa shayonki cwamə nəni.<verse eid="MAT 27:10" /></para>
  <para style="s">Bilatu byə Yesɔ yo</para>
  <para style="r">)<ref loc="MRK 15:2-5">Maku 15.2-5</ref>; <ref loc="LUK 23:3-5">Luka 23.3-5</ref>; <ref loc="JHN 18:33-38">Yohana 18.33-38</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesɔ ngə la be gwaməna yi Roma, angye ɓyəng wa yo.&lt;&lt;Ka kunə kwə yi Yahudawa ɓa ma?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">&lt;&lt;Nankənə, na nang a cwa nəni,&gt;&gt; Yesɔ dyawa nə. <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Ama gɔ cwa nang ngɛ nla sa yo cwa anjɔ yi nwanye nyanang kəfi nwanye ɓa. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Kə Bilatu byəwa, &lt;&lt;Gu la wanang ku nga cwanə lashiu ni nla? &gt;&gt;<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Ama Yesɔ cwayo ngɛ nla, ko yo nso sa nang gaɓa nga cwani, kə nang sɔ na gwamənsa sɔ yi agang.<verse eid="MAT 27:14" /></para>
  <para style="s">Ba dyanə ngɔn ya jə Yesɔ )Maku 15. 6-15; Luka . 23, 13-25; Yohana. 18. 39, 19 . 16&lt;&lt;</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ɓeni ka nangnu gwaməna sɔ lasade nyinywɔ ngɔn ni u taɓe fusina nso angye gaɓa caɓenə ngɔn ni . <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />La sayi sɔ ngwi fusina ngənə yãwa ka Baraba , <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Kə sadenang nəngwi ɓa mɓa ɓwa nəshi ni, Bilatu ɓyəɓa, &lt;&lt; Ngwi anwa gua u shamə na taɓe ɓowa? Baraba ma ko Yesɔ nga kwinə ngwi pongdo ni ma? &gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Yona gɔ nyi ngɔn sa yo doshi kə ɓa nã Yesɔ labewa.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Sade Bilatu dənə la shi dodə nə tita ni, gwa wa swondo ɓa yonə lasɔː &lt;&lt; Ba nə nang ngɛ ɓa ngwi ade ni la, yonang gəmə tori wane nwinza la yi nga dwɔ yonəmani yo gɔ.<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ama nwanye ngwi nyanang ɓa nwifi nwanye ɓa ni fundang nəngwi ɓa ya ɓa taɓa ɓenə ɓa Baraba ama ɓa jə Yesɔ. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />&lt;&lt; Ka nwa la tangte ngwi ɓa mɓa ni nə towa nəɓe? &gt;&gt;</para>
  <para style="p" vid="MAT 27:21">Baraba kə ɓa dyanə. <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Kanə nənə ɓa Yesɔ nga kwinə ngwi pongdo ni?&gt;&gt; Bilatu ɓyədo. Gaɓa ku ɓa dyanə ya gba wa sa shĩ&gt;&gt; <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />&lt;&lt; Ka yonə ma?&gt;&gt;Ka nangjɔ anwa gɔ nə ma?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Ama gaɓa ma ɓwɔnku ɓa nyenə ya, &lt;&lt; Gba wa sa shĩǃ &gt;&gt; <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Sadenang Bilatu sang nə ya kɛ gɔ ɓanə la na nənə nang ngɛ ni, ama nyije nga shana lwenə kwuɓwɔn ni, gɔ cwe dibi kə wanə gaɓe wa ɓa la bəɓa ku. &lt;&lt;Gəmə nene ɓa ayibe nə sa jwɔn ngwi ade ni, &gt;&gt; gɔ cwa. &lt;&lt;Ka nangnu guaǃ &gt;&gt; <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Nəngwi ɓa ku dyawanə ya jwɔn gɔ də lasiɛ ɓa nwiɛ ɓa. &gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Nankənə kə ta Baraba ɓe sa shang nəngwi ɓa; zinze u gbanə Yesɔ ɓa tẽ ni, gɔ kə naɓa Yesɔ yona ɓa gba sa shĩ.<verse eid="MAT 27:26" /></para>
  <para style="s">Soje ɓa vɛ Yesɔ</para>
  <para style="r">)<ref loc="MRK 15:16-20">Maku 15.16-20</ref>; <ref loc="JHN 19:2">Yohana 19.2</ref>,<ref loc="JHN 19:3">3</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Kə soje Bilatu ɓa cwe Yesɔ ghanə la yidodə gwaməna, kəfi soje ɓa ɓwa nəshi yimɓa kwɔnwa tala <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Gaɓa cwinə nang sɔ ɓa kəfi ɓa jawa zhanang nə lasɔ. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />kəfi ɓa mã nang beshi yi kwu kə ɓa bewa nə lashiwa. Gaɓa na shi tuɓe la gaɓe wa aɓezhi. &lt;&lt; Gang sa, kwə yi yahudawa ɓaǃ &gt;&gt; gaɓa cwa. <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Gaɓa fi ntətɛ lasawa, kəfi ɓa cwe shĩ tuɓe ɓa laɓewa kə ɓa gba wa nə la lashiwa kə ɓa ma nga ɓa nankənə. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Lasinze ɓa vɛwa nəni kə cwinə nanja ɓa sɔ kəɓa jawa nanja swe yigɔ ɓa. Kə ɓa bwanə kwenə yido la gba wa nə sa shĩ ni.<verse eid="MAT 27:31" /></para>
  <para style="s">Ba gang Yesɔ sa shi</para>
  <para style="r">)<ref loc="MRK 15:21-32">Maku 15.21-32</ref>; <ref loc="LUK 23:26-43">Luka 23.26-43</ref>; <ref loc="JHN 19:17-27">Yohana 19.17-27</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Na nang nga kwe nəɓe ɓawa ni, kə ɓa jwɛ ngwi ɓə ngɛ yawa kənə Siman yi Sirin, kəfi soje ɓa nyanwa ɓa njamu nə ya sɛ gɔ cwe shi la singu Yesɔ ni. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Kə ɓa mɓa yido ngɛ ngənə yawa nga kwin ni kənə Golgota,&lt;&lt; Nga yenə ya yido yi kwɔnkwɔn wuu ɓa &gt;&gt;. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />La yimɓa kə ɓa nawa di fashi ngənə lan nə ni kə jwenjwe; ama lasinze gɔ ɓenə ni, gɔ u fã nla.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Sayi ɓa gba wa nə sa shĩ ni kəfi ɓa ganə nanja swe gɔ ɓa nə saɓa lasinze tanə nta ni. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Kəfi də kəmi, gaɓa nyang yiɓa sawa layimɓa. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />La lashiwa ɓa jwa nang layimɓaː &lt;&lt;Ka Yesɔ ye, Kwə yi Yahudawa ɓa. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Kə ɓa gba ngwi yinang ɓa ngɛ ngənə layimɓa nən mba nso la ɓezhi nso la ɓe shang. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Kə ngwi ɓa nga kwenə la ɓe yimɓa ni nga zən lashi ɓa nga cwɛ Yesɔ ɓa zhang. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />&lt;&lt;Gu aya a yɛ layi Nyimoː ayemi kəfi a mã ma kupaca gwə ncaǃ A pong lashiu ngə gu aka Nwi Nyimoː niǃ &gt;&gt; <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Kə nankənə nwanye nangzhĩ yi Yahudawa ɓa , ngwi maɓesa nang yi nangzhĩ yi Musa ɓa kəfi nwanye ɓa nga vɛwa. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />&lt;&lt;Gɔ u pong ngwi ngɛ ɓa,&gt;&gt;gaɓa yee, &lt;&lt;ama gɔ ɓa na pong lashiwa nlaǃ Ka kɔnə kwə yi Isrelawa la ma? Gɔ sɛ lu mɓa kəmi lasa shĩ ɓa gba wa nəni ɓeni, ngɔn ni je li dyayo gɔ dya. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Gɔ tagwɔnsa Nyimoː kəfi uya gənə nka Nwi Nyimoː. nankənə, je sang inə Nyimoː nga shana pongwa ni ɓeǃ &gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Nankənə ngwi yinang ɓa angye ɓa gba ɓanə sa shi ɓaɓa ni gaɓa ma nga cwɛwa ɓa zhang.<verse eid="MAT 27:44" /></para>
  <para style="s">Nang wuu Yesɔ</para>
  <para style="r">)<ref loc="MRK 15:33-41">Maku 15.33-41</ref>; <ref loc="LUK 23:44-49">Luka 23.44-49</ref>; <ref loc="JHN 19:28-30">Yohana 19.28-30</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />lasa ce yin ntonji hakə nto nea yidavu dang koje ku la kəmi. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Lasa ce yin nto nya kə Yesɔ lɛlɛ ɓa nyenə ya, &lt;&lt;Eli,Eli, Lamasabatani?&gt;&gt;Angye nga ya &lt;&lt; Nyimoː gə , Nyimoː gə, kayonə kə nyimə ma? &gt;&gt; <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Sadenang ngwi ɓa ngənə yimɓa wanə nəni, &lt;&lt;Gɔ u kwida Iliya. &gt;&gt; <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ɓabe gə kə ngwi ngɛ nso la tangte ɓa va gha, kə cwe nang mãnə na nang wedi ni kə u ja la dĩshĩ, Kə u kpang sa shi, kəfi u shana nyanwa fã. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Kə nwifi ɓa ya , u vyawa je sang ko Iliya la mɓa la pong wa pong.&gt;&gt; <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Yesɔ mafi lɛlɛ ɓa nyenə kə u wuu. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Na kənə kə nwanang ɓa dan nə sa nwyui la layi Nyimoː ni gaa shɛnəɓe mɓa la shaka daga lankwã hakə kəmi. Kə kəmi zəng kəfi nta ɓa pwashɛnəɓe. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Kə jwɛ wii ɓa ngɛɓa bwe kə sa ngwi ɓa wuunə nə ngwi Nyimoː ɓani ngɛɓa bwa ɓa ɓyagaɓanə ɓa yonki nə. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Gaɓa vfa yido di gaɓa kə lasinze Yesɔ lweni gaɓa dya la yi agang atẽtẽ kə ɓa caɓesa ɓa sa nəngwi ɓa ɓyagaɓa nəɓa sang ɓa. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Sadenang nwanye soje kəfi angye ɓa nga nyangwɔnsa Yesɔ ni sang nə kəmi zəng ni ɓa namɓa ku nənə nang ni , kə yi gwa ɓa, kəfi u ya, &lt;&lt; Yoade gɔ ka Nwi Nyimoː &gt;&gt; <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Nyənəngwa ɓa ɓyagaɓa nə ngə yimɓa nga sang nang nga nənə nang ni ɓa jagɔ ne. Gaɓa kase Yesɔ la Galili yona ɓa bali gɔ ni sa nə nang ngɛ ɓa. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />La tangte ɓa ka Maryamu Madali, Maryamu ne Yakubu kəfi Jose, kəfi nə nwi Zabadi ɓa.<verse eid="MAT 27:56" /></para>
  <para style="s">Nang di Yesɔ</para>
  <para style="r">)<ref loc="MRK 15:42-47">Maku 15.42-47</ref>; <ref loc="LUK 23:50-56">Luka 23.50-56</ref>; <ref loc="JHN 19:38-42">Yohana 19.38-42</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Na nang lo nga gwani , kə ngwi menang ngənə la Arimatiya, yawa Yusu, angye gɔ ɓa ɓewa kanə nwi nangjwa yi Yesɔ ni. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Gha la be Bilatu, kə kə u byədo kwɔn sa Yesɔ, kəfi Bilatu na dang ya ɓa nawa. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yusu cwe kwɔn sɔ, kə kpan nəɓwɔ ɓa nwanang azanzan, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />kəfi tawa la lajwɛ̃ wi gɔ u mãnə ni lasa nta ni. Kə u gbə nyi nta gunə danwa kəfi u kwenə ɓe. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maryamu Madali ɓa Maryamu angye dənə la yido di danywi ni.<verse eid="MAT 27:61" /></para>
  <para style="s">Ngwi sang do ɓa la yido di danywi</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Kə do ɛ kwani kənə lalo awinwi yi Yahudawa ɓa, kə nwanye nyanang yi Yahudawa ɓa kəfi Farisawa ɓa gha la sa Bilatu. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />&lt;&lt; Nwanye, &gt;&gt; gaɓa ya, &lt;&lt;Je chəng ngɔn sade ngwi sadang ni ngənə ɓa yonki ni gɔ ya, &lt; ɛ lwemənə lasinze gwen nca.&gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Ana dang, nankənə, yo yido digɔ hakə gwen nca ɓa nyangwɔnə, yona nwi nanjwa gɔ ɓa ɓe ba na yi kwɔn gɔ la , kəfi ɓa cwa nəngwi ɓanə ya ɓa lwewanə ngɔn. Dansa aszənze ni ɛ ja ta a gəmbe. &gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />&lt;&lt; U cwe ngwi sang zhi,&gt;&gt; Bilatu cwa ɓa nə;&lt;&lt;U gha u nyangwɔn sa yido diwa ni na nang u shang ni.&gt;&gt;<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Kə gaɓa kwenə ɓe kəfi a gwɛ dang jwɛ danywi gɔ ɓa tayin nta kəfi nyang ngwi sang zhi layimɓa yona sang do sɔ.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Nang lwe Yesɔ</para>
  <para style="r">)<ref loc="MRK 16:1-10">Maku 16.1-10</ref>; <ref loc="LUK 24:1-12">Luka 24.1-12</ref>; <ref loc="JHN 20:1-10">Yohana 20.1-10</ref>&lt;&lt;</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Lasinze lalo a winwi,ɓa shidotẽ nə lalo ladi, Maryamu Madali kəfi Maryamu ango gha ɛ sang lajwɛ di danywi yona ɓa sang. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Nye dozəng yi kəmi ɓa nyenə zəng do, yonang maleka yi Nyimoː mɓa la lankwã kəfi, gha ngə la lajwɛ wi ni, gbə nta finə kə də shiwa. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Siɓewa nga pyən, kəfi nang ja swe gɔ ngə ne nvi na nta di nə. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Kə ngwi sang zhi ɓasɔ yi gwa ɓa kə ɓa ngəna ngwi ɓa wii ɓa kaan ngɔn ni. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Maleka ye ngwaɓasɔ ni, &lt;&lt; ɓu yiyi la, yona gəmə nyi ngɔn gua u kãdo Yesɔ, angye ɓa gba nə sa shi ni. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Gɔ nene lanle; gɔ lwe ngɔn, na nang gɔ cwa ni. U mɓa ɓu sang yido ɓa tanə ni. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />U gha ɓabe kəfi u cwa nwi nangjwa gɔ ɓanəː &lt; Gɔ lwe ngɔn sa wii ajədo, kəfi u gha la Galili ɓeni. Layimɓa gua lu sang wane.&gt;Ɓeni u chəng nang gəmə cwowanə ni. &gt;&gt; <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Nankənə kə ɓa kwenə ɓe ɓa bẽgə, ɓa yinə ama aɓeku saɓa nga nua, kəfi va kwe a cwa nwi nanjwa gɔ ɓa nə. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Babegə kə Yesɔ njwa ɓa. &lt;&lt; Ngə yowa nə, &gt;&gt; gɔ ya. Gaɓa mɓa sɔ, kpang gagwe wa ɓa kəfi ɓa nawa gang. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Ngɔn kə yesɔ yeɓa ye, &lt;&lt; ɓu yiyi la. U gha u cwa nwi yimɓa nə ɓa gha la Galili; layimɓa gaɓa lasang mə. &gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s">Yo nang ngwi sang zhi ɓa mɓanə ni</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Sade ngwa ɓasɔ nga kwe ni, Kə soje ngɛ ɓa nga sang nə yido dinə Yesɔ ni kə ɓa gha la yĩ agang a cwa nwanye nyanang yi Yahudawa ɓa nang ku nənə nang ni. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Sade nang nwanye nyanang yi Yahudawa ɓa ɓwa nəshi ɓa nwanye ɓa kə mã yo nyang, gaɓa naa soje ɓasɔ shede ne gang, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />kəfi ya, &lt;&lt;gua cwa ya nwi nanjwa gɔɓa mɓa yi kwɔn gɔ kwenə sadenang je i nganəyi nga ni. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Kəfi inə gwaməna wã ngɔn ni, je i cwawa yo anuanua nə ya gua nene ɓa ayibe nə, kəfi gua nene ɓa nang ngɛ nə lu chəng ni. &gt;&gt; <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Kə ngwi sang zhi ɓasɔ cwe shede kəfi nə na nang ɓa cwaɓa nə ɓa nəni. Kəfi ka yo nang mãnə doku laje ku tangte Yahudawa ɓa hakə nwinza lalo nang gəmə ngə jwanə nang ni<verse eid="MAT 28:15" /></para>
  <para style="s">Yesɔ bwa jwanə ɓa nwi nangjwa gɔɓa</para>
  <para style="r">)<ref loc="MRK 16:14-18">Maku 16.14-18</ref>; <ref loc="LUK 24:36-49">Luka 24.36-49</ref>; <ref loc="JHN 20:19-23">Yohana 20.19-23</ref>; A.m 1.6-8&lt;&lt;</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Kə nwinanjwa ɓa jwa cwin nso kwenə la shi nta yido Yesɔ cwaɓa nəni ya ɓa ghanə ni. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Sade nang ɓa sɔnəni kə ɓa nawa gang, konte ku ngwi ngɛ gaɓa dyanə nəbwɔ nla. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesɔ ɓa zədo saɓa kəfi ye ɓa ya, &lt;&lt; Gəmə nəma njamu kupaca la lankwã ɓa shi kəmi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Gha, nankənə, sa nəngwi ɓa laje ku kəfi u nyang ɓa ɓe nwinanjwa ɓa ku; nə ɓa botisma lasa yã Daa, kə Nwi, kəfi Yingu Nyimoː, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />kəfi mãɓaɓenə namɓa ku gəmə cwowa nəni. kəfi gəmə ngə ɓowa ku hakə lasapyang la kaanə. &gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>