  <book code="ACT" style="id">EN_DADT mji-x-daoaodai_Dao⋅Ao⋅Dai_ltr Mon Mar 09 2026 11:17:04 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Acts</para>
  <para style="toc1">Stayb Sây Buz Cumh Pâuz</para>
  <para style="toc2">Cumh Pâuz</para>
  <para style="toc3">Act</para>
  <para style="mt">Stayb Sây Buz Cumh Pâuz</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Stăngz nyăngz Tê-ô-phi-latx lex, yaz ja tah yetx zây jenx coong tauv Zâu Yê-su quef coonz ayx nyăngz cumh pâuz cloon nzaox gâyf, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />tauv Nănh tuz ênz staox guungh muf wax noib, Nănh yâuc păngc Zâu Singx-Lingh jaoz lanyf phunz Nănh sên taih wax đomc cumh pâuz munh, <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />tăng Nănh zuc tanyđ zâuđ tayc blătc, Nănh yâuc hinđ setb taih đuungx hâyđ phunz wax đomc munh pâyz tuz coong Nănh năngx jinh săngh, yâuc hinđ taih cloon stiz yămz tuz stâyx săpc noib, yâuc nzônh tauv Zâu Tênb-Huungh nyăngz côkz wax đomc jau phunz stiz. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Cloon stiz yămz wax zanyf, Nănh bux ănz stiz coong năngx gâyf ninyh gâyh Yê-lu-sa-lem, oix zuc yămz wa zu tauv tuz Tênb-toongh Pha nyunc phunz nyăngz, “Six nyâuh numđ yaz coong wax huungđ, <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />coong Yô-hanx nongc womz ayx quaix-gâyf, six blătc nây max sax noib cah đangz, nyâuh oix tuz nongc Zâu Singx-Lingh ayx quaix-gâyf.”<verse eid="ACT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Wâyc nây, stiz tinyh đoih taih stătx, naic Nănh coong: “Zâu lex, Mâyh cayx nâyx zanyf njăpc I-sa-la-ên nyăngz côkz nzof mah?” <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />Six Nănh coong ănz stiz: “Wax noib cloon săngx huđ, six Tênb-toongh Pha cănh âyz Nănh nyăngz lokc jangx tingc taih, max zâyf nyâuh hoopđ zuc pâyz. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Six, tauv Zâu Singx-Lingh nzac taih yămz nyâuh, nyâuh six naih tômx jab, nzof nyâuh six ayx zanyx manyf phunz yaz tăng Yê-lu-sa-lem, ninyh nzêux Yu-đê stâyz phangz, cloon Sa-ma-đi stâyz phangz, yâuc ninyh nzêux nây guungh đi.” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />Coong wax đomc wac tuz, stiz năngx jinh đangh mangc wax zanyf, Nănh songđ tuz ênz muf, yâuc naih ah tungđ vănx taih tăng Nănh stiz songđ max phătc gôh. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />Stiz năngx jinh đangh ngoongv minb mangc Nănh staox guungh muf wax zanyf, six phanv mangc, naih iz lanh munh pha, zuz guyz quav pec stâuđ stiz wa cah sinh. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Yâuc coong: “Nyâuh đomc Ga-li-lê munh lex, Săngh laix nyâuh bix stâuđ lâyc mangc staox guungh ninyh heh? Nâyx tauh Zâu Yê-su tuz ênz staox guungh muf gâyh nyâuh, six năngx nzac taih lauf cayx năngđ nyâuh phătc Nănh staox guungh muf nâyx.”<verse eid="ACT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Tăng wa, stiz songđ tăng hipđ ayx Ca-lan zoongz, nzac lauf tauv Yê-lu-sa-lem, Wax nomz zoongz yămz gâyh Yê-lu-sa-lem, cox yăngh ah nomz tingc congz noib jau. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Stiz lauf tauv tinc wax zanyf, stiz songđ lekb staox cah zâyc wax tab pyau njăngb ninyh, stiz căpx dlonf yămz wa, naih Pi-tê căn Yô-hanx, căn Ya-coopc căn An-đa-lu, Phi-lipx căn Tô-matx, Ba-tô-lô-miu căn Ma-tai, Ya-coopc An-phê-atc nyăngz toonz căn Si-môn Sê-lôt, căn Yu-đa Ya-coopc nyăngz toonz. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Stiz muif lanh nzac jab hoopđ stimz tongh âyx cloo Zâu, cloon ah đomc munh nzif, cloon Ma-li-ya, Zâu Yê-su nyăngz nzif, yâuc căn Nănh wax đomc yâuf.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Yămz wax đomc noib, Pi-tê nyoongz quef stâuđ yămz wax đomc yâuf pez nyăngz mungh tongx (nzoomf yămz wax nomz tinc nyăngz munh, six cox ah pez nhlic săpc lanh), Pi-tê songđ coong:<verse eid="ACT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 1:16" />“Yetx stong, yâuf pez lex, nây six ayx phunz Canyx Stâub nyăngz wac tuz setb taih toix nzuf, Zâu Singx-Lingh nongc Đa-witx huungh nyăngz nzetx tâuc taih nyăngz wac coong tauv Yu-đatc, nănh six ênz munh taih zoz Zâu Yê-su wax tauh. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Wâyc nănh six tuz cloon pănh songc ah peob, yâuc stipx nâyx đomc cumh pâuz phănc nyăngz ah lanh munh.” <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />(Six nănh nongc nănh ayx huđ tuz taih wax đomc nyanh ninyh maif ah tootz njingh, nzof tauv nănh tuih nzac taih, nyâuđ songđ toc clangh yâuc pletx nzuf. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Nâyx đomc dlayc yămz wa Yê-lu-sa-lem nyăngz munh muif lanh pâyz nzuf. Wâyc nây, wax tootz njingh yâuc tuz âyz stiz wax huungđ munh nyăngz wac hipđ ayx “A-cen-đa-ma”, âyz gâyf six “Njingh Samđ”.) <verse eid="ACT 1:19" /><verse number="20" style="v" sid="ACT 1:20" />“Yămz Stingb Nzungz stâub, lauf naih ja tauv nâyx đomc dlayc coong:</para>
  <para style="q1" vid="ACT 1:20">‘Oix zuc phunz nănh wax tootz njingh pênx nib cuungv,</para>
  <para style="q1" vid="ACT 1:20">yâuc max naih mănv yămz wax nomz tinc,’ zef</para>
  <para style="q1" vid="ACT 1:20">‘Oix zuc phunz pitc lanh stipx nănh nyăngz cumh pâuz phănc.’<verse eid="ACT 1:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21" />Wâyc nây, oix zuc lov wax đomc munh naih minb cloon pănh yămz, tăng Zâu Yê-su quef coonz staox nzac yămz pănh mungh tongx, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />tăng Yô-hanx ayx quaix-gâyf wax zanyf, tauv Zâu Yê-su tuz ênz muf gâyh pănh wax noib — wax đomc ah lanh munh six zuc căn pănh ayx zanyx manyf coong tauv Nănh săngh taih nyăngz jau.” <verse eid="ACT 1:22" /><verse number="23" style="v" sid="ACT 1:23" />Stiz sên iz lanh munh, Yô-sepx lauf hipđ ayx Ba-săp-batc, năngx naih ah nomz bux hipđ ayx Yu-sa-tat, cloon Ma-ti-atc. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Stiz cloo Zâu coong: “Zâu lex, Mâyh six pâyz nzuf muif lanh munh nyăngz nyâuđ wax Tauh, joođ phunz buz pâyz yămz nây iz lanh munh mâyh six sên laiv lanh <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />phunz stipx nâyx huungđ cumh pâuz nyăngz phănc, nongc ayx cumh pâuz munh tayv Yu-đatc, senz quanyf nây bix ninyh tauv nănh nyăngz tinc wax tauh.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Stiz songđ pungx tăm mangc wa iz lanh, tăm tuih toix Ma-ti-atc, nănh songđ tuz pâu nzac wa săpc byetx lanh cumh pâuz munh.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Tauv quaix Pên Tê Coot stêtz nyăngz noib, stiz songđ tinyh đoih taih căpx dlonf yămz ah nomz tinc. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Lênh dlih naih stingb buib tăng wa guungh nzac taih cayx năngđ nzaox lub sâyb nâyx, taih yămz pong stiz jinh đangh stâyv wa wax sênz pyau. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Stiz songđ phătc cayx năngđ tâuf byetc nâyx hinđ setb taih, yâuc đanv ninyh, nzac stiz muif lanh. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Stiz songđ muif lanh tuz Zâu Singx-Lingh pong nyâuđ, songđ quef coonz coong pitc huungđ wac, âyz Singx-Lingh phunz stiz coong.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Wax zanyf naih wax đomc Yu-tai munh jinh đangh taih yămz wa Yê-lu-sa-lem, six tăng guungh đi muif nomz côkz taih nyăngz munh, lêpc gongx Zâu Tênb-huungh wax đomc. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Nâyx đomc stingb buib wax zanyf, munh đuungx songđ tinyh đoih taih căpx dlonf yâuc numđ nyâyh ganc, Wâyc stiz tinyh đoih, mănv yâuc cănh numđ wax đomc munh coong mănv nyăngz stâyz phangz wac. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Songx munh tinyh đoih nyâyh ganc yâuc numđ njingc, songđ coong: “Ex, coong wac lâyc đomc munh max zâyf Ga-li-lê munh nzuf haz? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Ayx laix pănh bix numđ stiz muif lanh coong âyz pănh steengb taih nyăngz stâyz phangz munh nyăngz wac heh? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Yămz nây six naih, Pan-tê munh, Mi-đê munh, Ê-lam munh, cloon yămz Mê-sô-bô-ta-mi taih nyăngz munh, tăng Yu-đê, yâuc naih tăng Cap-ba-đô-si, Boon-tat, Ê-si, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />lauf naih tăng Pha-li-ji, Băm-phi-li, I-yipx, cloon yămz Li-bi stâyz phangz stătx Sai-lin, yâuc naih tăng Lô-ma taih nyăngz zeb munh, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />Njinh Yu-tai munh cloon lêpc Yu-tai munh nyăngz gâyf wax đomc, Cê-lit munh, cloon A-la-bi munh, pănh tinyh đoih numđ stiz nongc pănh nyăngz stâyz phangz wac coong tauv Zâu Tênb-Huungh lub nzongf nyăngz cumh pâuz.” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Stiz muif lanh numđ njingc yâuc nyâyh max manyh pec, songđ lanh naic lanh coong: “Nâyx đomc six ayx laix heh?” <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Six naih ah phanx munh yâuc pib jetx coong: “Lâyc đomc munh six zuc tiu camz binz lec!”<verse eid="ACT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Pi-tê songđ nyoongz quef, căn wa săpc byetx lanh cumh pâuz munh, songđ coong ănz songx munh coong:</para>
  <para style="p" vid="ACT 2:14">“Songx yâuf pez Yu-tai munh cloon muif lanh taih yămz nây Yê-lu-sa-lem nyăngz munh lex, nyâuh oix zuc pâyz tuz nâyx đomc jau, yâuc nzaz bah noomh mungv yaz coong nyăngz wac. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Nâyx đomc munh six max zâyf tiu binz cayx năngđ nyâuh nyâyh đêh, wâyc nâyx zanyf six nzăngđ bah đoomz tonx đuh săngx huđ. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Nâyx đomc dlayc six âyz tâuc wac munh Yô-ên tâuc taih nyăngz wac:<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />‘Zâu Tênb-Huungh coong: “Tauv wax đomc stêtb mâyv nyăngz noib,”</para>
  <para style="q1" vid="ACT 2:17">“Yaz six taox yaz nyăngz Singx-Lingh nzac muif lanh munh,</para>
  <para style="q1" vid="ACT 2:17">nyâuh nyăngz munh toonz, munh sab, six tâuc wac,</para>
  <para style="q1" vid="ACT 2:17">nyâuh nyăngz munh gunx munh, six phătc hinđ yangh nyăngz jau,</para>
  <para style="q1" vid="ACT 2:17">nzof nyâuh nyăngz munh côx munh, six tuz bâyx phătc.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Njinh Yaz nyăngz munh toonz pâuz, munh sab pâuz yămz wax đomc noib,</para>
  <para style="q1" vid="ACT 2:18">Yaz six taox Yaz nyăngz Singx-Lingh nzac phunz stiz tâuc wac.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Yaz six ayx phunz cah zâyc guungh naih njingc nzongf nyăngz dlayc,</para>
  <para style="q1" vid="ACT 2:19">nzof cah đi nib six naih njic hoouđ njingc nyăngz dlayc,</para>
  <para style="q1" vid="ACT 2:19">naih tâuf naih samđ cloon tâuf sâub.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Bah noib six nzămc jaz ninyh,</para>
  <para style="q1" vid="ACT 2:20">Nzof lav six pênx samđ,</para>
  <para style="q1" vid="ACT 2:20">Yămz stătx Zâu taih gwăngz eeng nyăngz noib lub.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Tauv wax zanyf tinyh phanv laiv lanh êu Zâu nyăngz bux six tuz njâuv.”’<verse eid="ACT 2:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="ACT 2:22" />I-sa-la-ên munh, nyăngz yâuf pez lex, joođ mungv nâyx đomc wac: Na-sa-leetx munh nyăngz Zâu Yê-su, Nănh six tuz Zâu Tênb-Huungh nongc Nănh yămz nyâuh nyăngz mungh tongx, Zâu Tênb-Huungh bix ayx wax đomc jix caox njingc cloon njic hoouđ lub nzongf nyăngz dlayc, ayx zanyx zanyf phunz Nănh yămz nyâuh cah njaf, năngđ nyâuh cănh pâyz nâyx. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Nănh zuc maic six âyz Zâu Tênb-Huungh bênc săngh quaix đangc nyăngz zux ix, Nyâuh yâuc jaoz Nănh phunz munh huđ munh, tingz ănz săpc đăngc zax tayx tayc, <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />six Zâu Tênb-Huungh ayx phunz Nănh năngx săngh taih, pyăux đutb tayc nyăngz jab, wâyc tayc nyăngz jab max hayh cun tuz Nănh. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Năngđ Đa-witx huungh coong tauv Nănh nâyx, coong:</para>
  <para style="q1" vid="ACT 2:25">‘Yaz phătc Zâu muif dlih yămz yaz nyăngz cah đangc,</para>
  <para style="q1" vid="ACT 2:25">Nănh yămz yaz nyăngz byaoh phanx, phunz yaz max zuc cumh nzav.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Wâyc nây, yaz nyăngz nyâuđ oonz looc nzongf, yaz nyăngz nzetx yâuc numđ nyađ.</para>
  <para style="q1" vid="ACT 2:26">Nzof yaz nyăngz stinb a yâuc tuz naih njih mungc hitb conv.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />Mâyh six max quanyf phunz yaz nyăngz mengc hoonh zuc yămz wa yămz pâu,</para>
  <para style="q1" vid="ACT 2:27">yâuc max phunz Mâyh wax Tauh đăngb zeengh munh zuc yootz.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Mâyh six phunz yaz pâyz tuz săngh mengc nyăngz jau;</para>
  <para style="q1" vid="ACT 2:28">Mâyh yâuc ayx phunz yaz tuz numđ nyađ oonz looc tauv tauh, yămz Mâyh nyăngz cah đangc.’<verse eid="ACT 2:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 2:29" />Yâuf pez lex, yaz senz oix coong năngx manyf tauv pănh nyăngz claof jex Đa-witx huungh ănz nyâuh coong, nănh tayc nzof yâuc zuc plopx, nănh nyăngz stâu lauf năngx jinh naih yămz pănh nây tauv nâyx yenh. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Wâyc nănh six ah tauh tâuc wac munh, yâuc pâyz tuz coong Zâu Tênb-Huungh njăpc nyunc wac cloon nănh, phunz naih ah lanh munh, tăngc nănh wax stuungh munh setb taih, yămz nănh nyăngz huungh tinc, <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />six wâyc phătc nâyx đomc dlayc quaix đangc, nănh songđ coong tauv Zâu Jix-Tuz săngh taih nyăngz jau, coong Nănh max zuc quanyf yămz wa yămz pâu, Nănh nyăngz stinb a yâuc max zuc yootz.<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />Zâu Tênb-Huungh ayx phunz Zâu Yê-su tuz săngh taih, buz muif lanh six ayx zanyx manyf phunz nâyx đomc dlayc. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Wâyc nây, tauv Nănh tuz ênz muf yămz Zâu Tênb-Huungh nyăngz byaoh phanx, yâuc stipx Tăng Tênb-toongh Pha, nyunc phunz nyăngz Zâu Singx-Lingh, Nănh songđ taox nzac taih năngđ nây nâyx, six nâyx zanyf nyâuh tuz phătc yâuc tuz numđ nyăngz dlayc.<verse eid="ACT 2:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 2:34" />Đa-witx six max staox guungh muf, six nănh yâuc coong:</para>
  <para style="q1" vid="ACT 2:34">‘Zâu coong ănz yaz nyăngz Zâu: “Taih stâyv yămz Yaz nyăngz byaoh phanx,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />zu tauv laiv zanyf Yaz phunz Mâyh nyăngz yônz zaz yămz mâyh nyăngz staux đi.”’<verse eid="ACT 2:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 2:36" />Wâyc nây lomc I-sa-la-ên nyăngz munh oix zuc pâyz tuz coong, nyâuh tingz jămz, nâyx tauh Zâu Yê-su, six tuz Zâu Tênb-Huungh oonz Nănh ayx Zâu, yâuc ayx Jix-Tuz wax Tauh.”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Stiz numđ nâyx đomc wac songđ numđ munz stimz, yâuc naic Pi-tê cloon wax đomc cumh pâuz munh, coong: “Yâuf pez lex, buz oix zuc ayx laix heh?” <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />Pi-tê songđ coong ănz stiz: “Nyâuh muif lanh oix zuc nhlimc stoif yâuc tim Zâu Yê-su Jix-Tuz nyăngz manyh ayx quaix-gâyf, nzăngđ tuz quanyf cănh nyăngz stoif, nyâuh nzăngđ hayh tuz stipx Nănh sađ phunz nyăngz Zâu Singx-Lingh. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Wâyc nâyx đomc wac six nyunc phunz nyâuh, cloon nyâuh nyăngz sây stunz, cloon phunz muif lanh yămz côz nyăngz munh, six wax đomc tuz Zâu, six pănh nyăngz Zâu Tênb-Huungh senz sên taih nyăngz munh.” <verse eid="ACT 2:39" /><verse number="40" style="v" sid="ACT 2:40" />Pi-tê yâuc coong đuungx zâux wac timb, quinb stiz coong: “Nyâuh oix zuc cănh tiuv năngx gâyh nâyx stâyv nyâuđ huđ nyăngz munh.” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Năngđ nây, naih munh zen Pi-tê nyăngz wac, stiz songđ ayx quaix-gâyf, yămz wax noib cox naih pôz tinb lanh munh tuz pâu nzac jiux pangx. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Stiz yâuc nongc nyâuđ stipx wax đomc cumh pâuz munh nzaox nyăngz wac, yâuc tinyh đoih tinyh tongb, tinyh songc watz nzu yâuc cloo Zâu.<verse eid="ACT 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Stiz tinyh đoih numđ cumh nzav, yâuc naih đuungx huungđ jix caox njingc cloon njic hoouđ, tuz ayx setb taih tăng wax đomc cumh pâuz munh. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Muif lanh zen nyăngz munh tinyh đoih căpx dlonf yămz ah nomz tinc, nzof naih laiv huungđ yâuc tinyh songc nongc, <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />stiz maic stiz nyăngz jax dlaih, jax toongx, nzâyz nyanh taih patz phunz tinyh đoih nongc, âyz săngh lanh sămv nongc nyăngz jau, <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />muif noib hoopđ stimz ninyh căpx dlonf yămz wa bongc Zâu Tênb-Huungh nyăngz pyau, yâuc yămz stiz nyăngz pyau watz nzu, tinyh songc nhlinc yâuc numđ nyađ, senz nongc nyâuđ ayx, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />tanv Zâu Tênb-Huungh yâuc căn songx munh tinyh đoih ayx gongx, Zâu yâuc muif noib phunz tuz njâuv nyăngz munh yâuc pâu nzac jiux pangx.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Naih ah noib, beengc cloo Zâu nyăngz săngx huđ, Pi-tê cloon Yô-hanx ninyh wa bongc Zâu Tênb-Huungh nyăngz pyau, six pôz săngx huđ. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Naih ah lanh munh, tăng yămz nzif nyăngz nyâuđ njaf steengb taih bix quac, munh zeengz nănh taih, wax tauh munh six muif noib munh tăpx nănh ănz wa, nzac bongc Zâu Tênb-Huungh nyăngz pyau wax tungđ jeengh, six hipđ ayx Jeengh Quai, nongc joođ nyanh tăng wax đomc munh ninyh nzac wa, bongc Zâu Tênb-Huungh nyăngz pyau, <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />phătc Pi-tê cloon Yô-hanx cayx ninyh nzac bongc Zâu Tênb-Huungh nyăngz pyau, nănh songđ joođ stiz nyăngz nyanh. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Six Pi-tê cloon Yô-hanx njinh luh mangc nzac nănh ninyh, yâuc coong: “Phanv mangc buz geh!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Nănh songđ njinh luh mangc stiz, nyâyh coong stiz cayx phunz tix huungđ. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Six, Pi-tê coong: “sămz nyanh, yaz six max naih, six yaz naih nyăngz, yaz sađ phunz mâyh. Tim Zâu Yê-su Jix-Tuz nyăngz bux Na-sa-leetx munh, nyoongz quef yăngh gôh.” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Pi-tê nzauf nănh nyăngz byaoh saz puf tanyđ nănh nyoongz quef, nănh nyăngz staux pên căn staux mâyc stung, songđ toongx sangf tuz njoongh staox taih. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Nănh nzeengc nyoongz quef songđ hayh yăngh, nănh yâuc lêpc stiz ninyh wa bongc Zâu Tênb-Huungh nyăngz pyau, cun đanyz stêub cun ninyh yâuc tanv Zâu Tênb-Huungh. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Songx munh phătc nănh hayh yăngh songđ tinyh đoih tanv Zâu Tênb-Huungh. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Stiz saz coong nănh six njinh leox stâyv wa bongc Zâu Tênb-Huungh nyăngz pyau Jeengh Quai cah sinh joođ nyanh wax tauh, năngđ nâyx stiz songđ numđ nyâyh ganc nzongf yâuc numđ njingc, wâyc nâyx lanh munh nyăngz dlayc setb taih.<verse eid="ACT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Wax zanyf, nănh jinh đangh lêpc nzauf Pi-tê cloon Yô-hanx, songx munh nyâyh ganc songđ tinyh đoih tinyh ênz taih nzoomf wa jeengh cah đangc, yămz wa hipđ ayx Sa-lô-môn njiuh. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Six Pi-tê phătc nâyx songđ coong ănz songx munh coong:</para>
  <para style="p" vid="ACT 3:12">“I-sa-la-ên nyăngz songx munh lex, săngh laix nyâuh bix numđ nâyx đomc dlayc njingc heh? Nyâuh mangc nzac buz ninyh, ayx cayx năngđ six buz păngc cănh nyăngz jab, max six păngc cănh cumh pâuz gongx, ayx phunz nâyx lanh munh hayh yăngh? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Apx-la-ham nyăngz Zâu Tênb-Huungh, I-sakx nyăngz Zâu Tênb-Huungh, cloon Ya-côpx nyăngz Zâu Tênb-Huungh, six pănh nyăngz claof jex nyăngz Zâu Tênb-Huungh, ayx phunz Nănh nyăngz pâuz tuz gwăngz eeng, senz nyâuh zoz jaoz phunz Phi-latx wax Tauh Zâu Yê-su, Phi-latx oix pungx Nănh wax zanyf, nyâuh yâuc yămz Phi-latx nyăngz cah đangc nzêmh max nongc. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Nyâuh nzêmh Đăngb Zeengh yâuc Peengh Stimz wax Tauh, bix joođ êu pungx tayx munh wax tauh phunz nyâuh, <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />nyâuh tayx Săngh Mengc Nyăngz Coonz wax Tauh, six Zâu Tênb-Huungh ayx phunz tăng tayc săngh taih wax Tauh, buz six ayx zanyx manyf phunz nâyx đomc jau. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Nây six wâyc zen yămz Nănh nyăngz manyh, bix nyâuh phătc yâuc pâyz nâyx tauh munh tuz njoongh taih yămz Nănh nyăngz manyh. Yâuc wâyc nongc zen stimz yămz Nănh, bix nâyx tauh munh tuz gongx njoongh taih năngđ nâyx, yămz nyâuh tinyh đoih nyăngz cah đangc. <verse eid="ACT 3:16" /><verse number="17" style="v" sid="ACT 3:17" />Yâuf pez lex, nâyx zanyf yaz pâyz coong nyâuh cloon nyâuh wax đomc ayx côx munh, six wâyc max pâyz luungđ bix ayx năngđ nâyx. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Six Zâu Tênb-Huungh nongc wax đomc muif tauh tâuc wac munh nyăngz nzetx, tâuc taih quaix đangc nyăngz wac, coong tauv Nănh nyăngz Zâu Jix-Tuz six zuc tanyđ zâuđ, Nănh yâuc ayx phunz setb taih toix nzuf năngđ nây nâyx. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Wâyc nây, nyâuh oix zuc nhlimc stoif, bix phunb đangz lauf, phunz nyâuh nyăngz stoif tuz quanyf queengx, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />ayx phunz Zâu tingc taih wax đomc săngb nzêuh nyăngz săngx huđ tauv, Zâu Tênb-Huungh songđ paiđ Nănh tingc săngh wax Tauh taih phunz nyâuh, six Zâu Yê-su Jix-Tuz, <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Nănh six oix zuc muf yămz wa Tênb-toongh, zu tauv beengc săngx huđ, muif huungđ tuz njăpc săngb nyăngz staox taih, senz Zâu Tênb-Huungh tăng lôx noib, nongc Nănh wax đomc đăngb zeengh tâuc wac munh nyăngz nzetx coong quaix taih nyăngz jau. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Năngđ nâyx Mô-sê songđ coong: ‘Zâu, six pănh nyăngz Zâu Tênb-Huungh six phunz ah tauh tâuc wac munh taih phunz nyâuh, tăng nyâuh nyăngz yâuf pez cah njaf, cayx năngđ yaz nâyx. Nyâuh six oix zuc mungv Nănh, yâuc ayx âyz Nănh coong ănz nyâuh nyăngz muif zâux wac. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Six năngđ coong laiv lanh max mungv wax tauh tâuc wac munh nyăngz wac, wax tauh munh six zuc zoz setb Zâu nyăngz pec stingx.’ <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />Muif lanh tâuc wac nyăngz munh tăng Sa-mu-ên ninyh tauv cah đangz stipx nănh wax đomc, phanv stiz goib nzetx coong, stiz six lauf cungb coong tauv nâyx đomc nyăngz noib. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Nyâuh six săngh wax đomc tâuc wac munh nyăngz sây stunz, yâuc săngh nyunc wac nyăngz Zâu Tênb-Huungh njăpc nyunc wac cloon pănh nyăngz claof jex, Apx-la-ham, coong: ‘Tăng mâyh nyăngz ah lanh sây stunz, guungh đi manf stingx munh six tuz pôz.’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Zâu Tênb-Huungh phunz Nănh nyăngz pâuz nzac taih, tah yetx six phunz nyâuh đangc, Nănh paiđ wax Tauh taih nongc sađ pôz phunz nyâuh, six nongc ayx phunz muif lanh munh quanyf stiz ayx huđ nyăngz jau.”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Stiz năngx jinh đangh coong ănz songx munh wax zanyf, wax đomc stayb munh, cloon jămđ bongc Zâu Tênb-Huungh nyăngz pyau wax đomc peengz, cloon Sa-đu-si munh pungb nzac taih, <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />stiz senz numđ nhlenx nzongf, wâyc wa iz lanh munh jinh đangh nzaox songx munh coong tauv Zâu Yê-su tăng tayc săngh taih nyăngz jau. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Stiz songđ toopz zoz wa iz lanh munh muf ănz nzauh, zu tauv nyâyc noib, wâyc wax zanyf guungh nzămc nzof. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Six yămz wa naih munh đuungx numđ wax đomc wac songđ zen, zen nyăngz munh pha cox naih pyaz tinb lanh.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Tauv nyâyc noib, stiz wax đomc ayx côx munh, cloon wax đomc munh côx, cloon wax đomc nzaox gâyf stênx steengb, taih căpx dlonf yămz wa Yê-lu-sa-lem, <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />cloon An-natx stayb munh pyây, cloon Ca-ya-phatx, Yô-hanx, cloon A-lek-san-đê cloon stayb munh pyây nyăngz pyau munh tauv laiv. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Stiz ênz wa iz lanh munh taih yămz wa mungh toongx, yâuc naic coong: “Păngc laiv huungđ lokc jangx, max six tim mănv nyăngz manyh, nyâuh bix ayx nâyx đomc cumh pâuz?” <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />Wax zanyf Pi-tê tuz Zâu Singx-Lingh pong nyâuđ, songđ tauz ănz stiz, coong: “Yetx stong ayx côx cun pec stingx nyăngz munh cloon yetx stong munh côx lex, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />năngđ coong nâyx noib buz zuc stămđ tauv wâyc ayx gongx dlayc phunz ah lanh gumc munh, păngc luungđ nănh bix tuz zany gongx, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />nây six nyâuh tinyh đoih cloon lomc I-sa-la-ên nyăngz munh, lauf tinyh đoih pâyz tauv, coong tim Na-sa-leetx nyăngz Zâu Yê-su Jix-Tuz nyăngz manyh, six nyâuh zoz tingz ănz săpc đăngc zax wax Tauh, Zâu Tênb-Huungh yâuc ayx phunz tăng tayc săngh taih wax Tauh, nây six păngc Nănh bix nâyx tauh munh tuz zanyf gongx stâuđ yămz nyâuh nây cah đangc. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Nănh six ah nomz njăuz zuc nyâuh ayx pyau stangc nyăngz munh nzêmh, yâuc pênx ănz wa pyau joongz, năngx nongc sen quaix wax nomz njăuz. <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />Max naih njâuv pôz nyăngz jau yămz pitc tauh munh, wâyc yămz nây guungh đi, max naih pitc nomz manyh tuz sađ phunz guungh đi munh, phunz pănh năngx hayh păngc wa bix tuz njâuv.”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Phătc Pi-tê cloon Yô-hanx naih nyâuđ pungx stimz coong, yâuc wâyc pâyz coong stiz iz lanh six max tuz hoođ đăngc nyăngz munh, cungb toongh hangh munh, stiz songđ nyâyh ganc, stiz lauf pâyz coong, wa iz lanh munh cah đangc six cloon Zâu Yê-su yămz. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Yâuc wâyc phătc wax lanh munh pha tuz zany gongx, cloon stiz iz lanh stâuđ wa, stiz songđ max naih laiv huungđ jau tauz. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Êu wa iz lanh munh setb huyđ tinc ninyh blătc, stiz songđ tinyh đoih sangv, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />coong: “Pănh cayx ayx laix ănz nâyx đomc munh heh? Wâyc phătc tăng stiz bix nâyx đomc jix caox njingc setb taih năngđ nâyx, Yămz nây Yê-lu-sa-lem nyăngz munh yâuc muif lanh tuz phătc, pănh senz mayv coong ayx laix. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Six wâyc, max phunz nâyx đomc cumh pâuz tuz ayx ninyh quăng, yămz songx munh cah njaf, pănh oix zuc zăpx stiz max tuz nongc wax nomz manyh, nzaox phunz laiv tauh.” <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />Tăng wa, stiz êu wa iz lanh munh taih, songđ setb lanyf zăpx stiz coong, max tuz tim Zâu Yê-su nyăngz manyh coong max six nzaox toix laiv huungđ. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Six Pi-tê cloon Yô-hanx tauz ănz stiz, coong: “Ha nyâuh cănh nyâyh mungv jađ. Yămz Zâu Tênb-Huungh nyăngz cah đangc, six hoopđ zuc mungv nyâuh max six Zâu Tênb-Huungh? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Wâyc buz mayv ayx tuz max coong, buz phătc cloon numđ nyăngz dlayc.” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Tăng wa stiz zef huukb timb, songđ pungx wa iz lanh, wâyc lov max tuz luungđ jau nongc phunz stiz phađ wa iz lanh, yâuc wâyc songx munh, wâyc zuc munh muif lanh phătc wax đomc dlayc setb taih, songđ tanv Zâu Tênb-Huungh. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Nzof wax tauh munh pha, tuz nây jix caox njingc setb taih zany gongx wax tauh, six stâyx săpc đuungx nyăngv.<verse eid="ACT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Tăng wa stiz iz lanh tuz pungx setb taih, songđ ninyh pongh stiz wax đomc zen Zâu nyăngz yâuf pez, yâuc lănv nzuf muif huungđ, coong wax đomc stayb munh cloon wax đomc munh côx coong ănz stiz nyăngz wac. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Mungv tuz, stiz songđ hoopđ stimz setb stingb huungv staox Zâu Tênb-Huungh ninyh cloo Zâu coong: “Zâu lex, Mâyh six zuyx guungh, zuyx nib, zuyx coiđ, cloon muif huungđ yămz wa wax Tauh, <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Mâyh yâuc nongc Zâu Singx-Lingh, coong quaix Mâyh nyăngz pâuz nyăngz nzetx, six buz nyăngz claof jex Đa-witx huungh coong:</para>
  <para style="q1" vid="ACT 4:25">‘Săngh laix manf côkz munh bix numđ nhlenx,</para>
  <para style="q1" vid="ACT 4:25">săngh laix manf stingx munh bix ta max săngh nongc nyăngz zux ix?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Guungh đi muif tauh huungh njăpc nyâuđ,</para>
  <para style="q1" vid="ACT 4:26">ayx quanz lub wax đomc yâuc tinyh đoih songc nyâuđ,</para>
  <para style="q1" vid="ACT 4:26">nzeengz Zâu yâuc nzeengz Mâyh nongc yâuh oonz taih wax Tauh.’<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />Wâyc zuc, njinh Hê-lôtx cloon Boon-ti-atc Phi-latx, cloon wax đomc pitc stingx munh cloon I-sa-la-ên munh, tinyh đoih songc nyâuđ yămz nâyx nomz dlanyh nzeengz Mâyh nyăngz đăngb zeengh pâuz, Mâyh nongc yâuh oonz taih wax Tauh, Zâu Yê-su, <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Nongc ayx muif huungđ Mâyh nyăngz puf tauh cloon Mâyh tingc taih quaix đangc nyăngz zux ix tuz setb taih. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Zâu lex, nâyx zanyf, joođ zah mangc nănh stiz huukb nyăngz wac, yâuc joođ sađ phunz Mâyh nyăngz pâuz hayh naih nyâuđ pungx stimz nzônh Mâyh nyăngz wac <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Mâyh stuungb Mâyh nyăngz puf staox taih, nongc zany gumc, phunz jix caox njingc cloon njic hoouđ nyăngz cumh pâuz tuz ayx setb taih, păngc Mâyh nyăngz đăngb zeengh pâuz nyăngz manyh, six Zâu Yê-su.” <verse eid="ACT 4:30" /><verse number="31" style="v" sid="ACT 4:31" />Stiz cloo Zâu tuz wax zanyf, stiz căpx dlonf wax nomz tinc songđ đănz tongf, stiz songđ muif lanh tuz Zâu Singx-Lingh pong nyâuđ, yâuc naih nyâuđ pungx stimz nzônh Zâu Tênb-Huungh nyăngz wac.<verse eid="ACT 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Wax zanyf, zen nyăngz munh hongđ nzongf tinyh đoih songc ah nomz stimz nyâuđ. Max naih mănv stunx stiz nyăngz luungđ six cănh nyăngz, muif huungđ six săngh tinyh đoih nyăngz nzuf. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Wax đomc cumh pâuz munh naih jab lub nzongf, ayx zanyx manyf coong tauv Zâu Yê-su săngh taih nyăngz jau, yâuc tuz pôz lub nzongf yămz stiz tinyh đoih. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Wâyc nây, yămz stiz cah njaf max naih mănv sămv luungđ, wâyc stiz mănv naih nib tâyc max six naih pyau, maic tuz buc laiv nyanh stiz yâuc nzâyz taih, <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />tăpx ănz wax đomc cumh pâuz munh nyăngz staux sinh, wax đomc nyanh six âyz laiv lanh sămv nongc nyăngz yâuc phunz wax lanh.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Tăng wa Yô-sepx, nănh tuz wax đomc cumh pâuz munh hipđ ayx Ba-na-batc (nâyx nomz bux nyăngz âyz gâyf six coong Oonz Nyâuđ nyăngz Toonz), nănh six ah lanh Lê-wi munh, yămz wa Sai-batc steengb stâyv, <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />maic Nănh nyăngz njingh, songđ nzâyz nyanh taih tăpx ănz wax đomc cumh pâuz munh nyăngz staux sinh.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Six naih ah lanh munh, bux hipđ ayx A-na-ni, cloon nănh nyăngz au Săpc-phi-la, maic stiz nyăngz ah tootz nib, <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />nănh songđ tanb wax đomc ah phănc nyanh nzâyz taih zaub nongc (nănh nyăngz au lauf pâyz), năngx naih wa ah phănc, songđ nzâyz ninyh tăpx ănz wax đomc cumh pâuz munh nyăngz staux sinh. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Six Pi-tê coong: “A-na-ni lex, wâyc săngh laix Sax-tanx bix yămz pong mâyh nyăngz nyâuđ, ayx tuz mâyh puv maoh jaf Zâu Singx-Lingh, bix cănh zaub ah phănc wax đomc maic nib nyăngz nyanh nongc? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Max zeengx maic wax zanyf, wax cuyb nib max zâyf săngh mâyh nyăngz haz? Nzof tauv maic blătc wax đomc nyanh max zâyf lauf săngh mâyh nyăngz haz? Săngh laix mâyh bix nyâyh nâyx đomc dlayc ănz mâyh nyăngz nyâuđ? Nây max zâyf mâyh jaf bamh munh, six jaf Zâu Tênb-Huungh.” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Tăng wa A-na-ni mungv wax đomc wac tuz, nănh songđ siv setc glinyf wa nib, muif lanh numđ nâyx đomc dlayc yâuc numđ cumh nzav nzongf. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Wax đomc munh gunx munh songđ nyoongz quef, pêuz nănh zeengz nzâyz ninyh plopx.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Cox blătc pôz săngx huđ cah njaf, nănh nyăngz au zef nzac taih, max zeengx pâyz ah yac setb taih nyăngz dlayc. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Pi-tê songđ coong ănz wax tauh munh nzif, coong: “Mâyh oix zuc coong phunz yaz pâyz, nyâuh maic wax tootz nib, six tuz buc nâyf nyanh yah?” Wax tauh munh nzif tauz: “Hiđ, tuz buc nâyf lêc.” <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />Six Pi-tê coong ănz nănh: “Săngh laix nyâuh bix tinyh ênz stâyv Zâu nyăngz Singx-Lingh? Phanv mangc, plopx mâyh nyăngz langh wax đomc munh nyăngz staux lauf tauv lâyc jeengh cah đangc nzof, stiz six năngx ênz mâyh ninyh plopx timb.” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Wax tauh munh nzif songđ toongx sangf glinyf nzac Pi-tê wa staux sinh ninyh bix tayc. Wax zanyf, wax đomc munh gunx munh nzac lauf phătc, songđ zeengz nănh nyăngz stayđ ninyh plopx ănz nănh nyăngz langh cah sinh. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Njinh jiux pangx cloon muif lanh mungv numđ nâyx đomc dlayc nyăngz munh lauf tinyh đoih cumh nzav nzongf.<verse eid="ACT 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Wax zanyf, naih đuungx huungđ jix caox njingc cloon njic hoouđ tuz ayx setb taih tăng wax đomc cumh pâuz munh nyăngz pu, yămz songx munh mungh tongx, stiz songđ tinyh đoih hoopđ stimz căpx dlonf yămz wa Sa-lô-môn njiuh. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Six max naih mănv nzađ cloon stiz songc ayx ah peob, six songx munh lauf tinyh đoih tanv stiz. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Wax zanyf, munh yâuc cun taih zen Zâu cun đuungx, naih munh pha cloon munh nzif hongđ nzongf, <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />ayx tuz munh lôx năngx ênz wax đomc săngh gumc nyăngz munh, phâyx sic, phâyx zâuv, taih tăpx ănz wa jau sinh, phunz tauv Pi-tê yăngh pitb, bix nănh nyăngz bah cloiz năngx tuz clăngv zuc stiz tix lanh. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Wax đomc dlanyh yămz stătx wa Yê-lu-sa-lem nyăngz munh, yâuc tinyh đoih ênz wax đomc săngh gumc nyăngz munh, cloon zuc manđ yootz ayx wax đomc munh taih, stiz muif lanh yâuc tuz zany gongx nzuf.<verse eid="ACT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Wax zanyf, stayb munh pyây cloon lêpc nănh wax đomc muif lanh munh (six Sa-đu-si wax huungđ munh) tinyh đoih nyoongz quef yâuc numđ nhlenx nzongf, <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />stiz songđ zoz wax đomc cumh pâuz munh, ênz stiz ninyh ănz wa tômx songx nzauh. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Six tauv đamx munf, naih Zâu nyăngz ah tauh stinz munh taih coib wa nzauh jeengh, ênz stiz setb cungh ngwaic ninyh, yâuc bux coong: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“Ninyh gôh, ninyh stâuđ yămz wa bongc Zâu Tênb-Huungh nyăngz pyau, coong bux songx munh tauv nâyx đomc muif zâux săngh mengc nyăngz wac.” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Tuz numđ năngđ nâyx, tauv guungh gwăngz stiz songđ ninyh yămz wa bongc Zâu Tênb-Huungh nyăngz pyau nzaox munh. Six, stayb munh pyây, cloon lêpc nănh wax đomc munh taih tauv, stiz songđ ênz wax đomc cun dlayc munh, six I-sa-la-ên munh nyăngz songx munh côx tinyh đoih taih căpx dlonf, songđ paiđ peengz ninyh wa nzauh ênz wax đomc cumh pâuz munh taih. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Six wax đomc peengz ninyh tauv tinc yâuc max phătc naih wax đomc cumh pâuz munh yămz wa nzauh, stiz songđ phunb đangz lauf lănv bux, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />coong: “Buz phătc nzauh jeengh omz wa gongb gongx, nzof jămđ nzauh peengz lauf sâuđ wa jeengh cah đangc, six tauv buz coib jeengh, buz yâuc max phătc naih mănv yămz wa cah njaf tiny.” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Wax zanyf, stiz numđ wax đomc wac, songđ njinh cun bongc Zâu Tênb-Huungh nyăngz pyau wax tauh peengz pyây cloon wax đomc stayb munh, songđ tinyh đoih nyâyh ganc tauv stiz numđ lănv wax đomc jau, nyâyh max pâyz ayx laix bix năngđ nâyx. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Tăng wa, naih ah lanh munh, taih tauv bux ănz stiz coong: “Phanv mangc, nyâuh zoz ănz nzauh wax đomc munh, nâyx zanyf jinh đangh stâuđ yămz wa bongc Zâu Tênb-Huungh nyăngz pyau cah njaf, nzaox songx munh!” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Tăng wa, wax tauh peengz pyây ênz cloon wax đomc peengz ninyh zoz stiz ênz lauf, six max ayx huđ ănz, wâyc stiz cumh nzav songx munh, wangb stiz zuc zoz njăuz ôx. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />Tauv ênz wax đomc cumh pâuz munh lauf, phunz stiz yămz wa cun dlayc munh nyăngz cah đangc, tăng wa stayb munh pyây songđ naic stiz, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />coong: “Buz six zăpx nyâuh coong, max phunz nyâuh nongc nâyx nomz manyh nzaox naz nzec, mangc jađ, nyâuh ayx phunz Yê-lu-sa-lem naih pong nyâuh nzaox wax huungđ gâyf, nyâuh six oix ayx phunz wax tauh munh nyăngz samđ njămh quaix buz cah zâyc ninyh mah.” <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />Six Pi-tê cloon wax đomc cumh pâuz munh tauz coong: “Oix zuc mungv Zâu Tênb-Huungh, max zâyf mungv munh. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Pănh claof jex nyăngz Zâu Tênb-Huungh ayx phunz Zâu Yê-su săngh taih, Nănh six nyâuh zoz tingz ănz săpc đăngc zax tayx tayc wax Tauh. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Zâu Tênb-Huungh zanyb Nănh ayx năngx lub quaix, yămz Nănh nyăngz byaoh wax phanx, yâuc ayx Njâuv Zâu, nongc phunz I-sa-la-ên munh nhlimc stoif yâuc tuz quanyf stoif. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Buz six ayx zanyx manyf phunz nâyx đomc dlayc, Zâu Singx-Lingh, six Zâu Tênb-Huungh sađ phunz mungv nănh nyăngz wac wax đomc munh, wax Tauh.”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Six numđ nâyx đomc wac, stiz senz numđ nhlenx nzongf yâuc oix tayx wax đomc cumh pâuz munh. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Six naih ah lanh Pha-li-si munh nyoongz quef yămz wa huyđ cah njaf, bux hipđ ayx Ga-ma-li-ên, ayx nzaox gâyf stênx steengb, yâuc tuz songx munh tinyh đoih zanyb, nănh êu ênz wax đomc cumh pâuz munh setb cungh ngwaic ninyh tix cay. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Nănh songđ coong ănz stiz:</para>
  <para style="p" vid="ACT 5:35">“I-sa-la-ên nyăngz yâuf pez lex, nyâuh oix zuc năngx cayb bôngh nyâuh cayx ayx ănz nâyx đomc munh nyăngz jau. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Wâyc cah đangc, nây lauf naih, Tu-đatc, cănh tanv nănh ayx lub, naih wax đomc munh pha ninyh lêpc nănh cox stâyx pez lanh, six tauv nănh zuc tayx tayc, zuc hox lêpc nănh wax đomc munh tinyh đoih lauf cănh đanv nzuf, yâuc cănh taux wa jac. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Blătc nâyx tauh zef naih ah tauh, Yu-đatc, Ga-li-lê munh, toix staox munh huv wax nzêuh, lauf cănh hox munh lêpc nănh. Wax tauh munh lauf zuc tayc, nzof zuc hox lêpc nănh wax đomc munh lauf tinyh đoih zuc đanv nzuf. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Nâyx zanyf yaz oix coong quinb nyâuh năngđ nâyx: Oix zuc pyenv gâyh nâyx đomc munh năngx côz, phanv dluyh nănh stiz, wâyc zuc năngđ coong nâyx đomc zux ix cloon nâyx đomc jau six tăng bamh munh taih, nănh six cănh zuc paic nzuf, <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />six năngđ coong wax huungđ tăng Zâu Tênb-Huungh taih, nyâuh six mayv ayx tuz hingh nănh stiz, hoođ max hoođ, nyâuh lôx năngx cănh ayx phunz nyâuh căn Zâu Tênb-Huungh tinyh nzeengz.” Tăng wa, stiz songđ mungv nănh. <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />Stiz êu ênz wax đomc cumh pâuz munh taih, bopc tuz, stiz songđ setb lanyf cangđ max phunz nongc Zâu Yê-su nyăngz manyh nzaox, nzof stiz songđ pungx muf.<verse eid="ACT 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41" />Năngđ nâyx, wax đomc cumh pâuz munh phunb đangz muf gâyh đutb wax đomc cun dlayc munh, yâuc numđ nyađ wâyc stiz năngx tuz payh, zuc tanyđ zâuđ wâyc Zâu Yê-su nyăngz manyh. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Stiz muif noib yămz bongc Zâu Tênb-Huungh nyăngz pyau, yâuc yămz ah sênz pyau tauv ah sênz pyau, stiz nzaox yâuc nzônh Cuđ Jenx max setc tiny coong — Zâu Yê-su six Zâu Jix-Tuz.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Yămz wax đomc noib, wâyc zen nyăngz munh cun ayx cun hongđ staox, songđ naih tinyh yônx nyăngz jau setb taih, Yu-tai munh coong Hi-lapc wac wax đomc yâuc yônx coong Hipđ-lu wac nyăngz munh, wâyc stiz wax đomc au qua max tuz stipx yenh muif noib patz nyăngz phănc. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Năngđ nâyx, wa săpc nyâyc lanh cumh pâuz munh songđ ênz wax đomc zen nyăngz munh tinyh đoih taih căpx dlonf, stiz coong: “Buz six max hayh queengx tuz Zâu Tênb-Huungh nyăngz wac, bix ninyh nongc bênc nhlinc hopb. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Six, yâuf pez lex, oix zuc sên yămz nyâuh cah njaf nhlic lanh munh pha taih, naih manyh tauh gongx, yâuc tuz Singx-Lingh pong nyâuđ yâuc naih tongb manyh, phunz buz jaoz nâyx đomc cumh pâuz phunz stiz cun. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Nzof buz six njinh luh jab cloo Zâu yâuc nzônh Zâu nyăngz wac.” <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />Songx munh tinyh đoih songđ numđ wax đomc wac hoopđ nyâuđ nzuf. Tăng wa stiz sên Ê-tên, six ah lanh munh naih zen stimz lub yâuc tuz Zâu Singx-Lingh pong nyâuđ, Phi-lipx, Bô-cô-lat, Ni-ca-nô, Ti-môn, Ban-mê-nat, cloon Ni-cô-lau, ah lanh An-ti-ôkx munh, lêpc Yu-tai munh nyăngz gâyf, <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />stiz ênz wax đomc munh taih stâuđ yămz wax đomc cumh pâuz munh nyăngz cah đangc, cloo Zâu tuz, wax đomc cumh pâuz munh songđ tăpx puf ănz stiz.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Tăng wa Zâu Tênb-Huungh nyăngz gâyf yâuc cun ninyh cun quăng, zen nyăngz munh yămz wa Yê-lu-sa-lem yâuc cun ayx cun hongđ, naih wax đomc stayb munh ah peob hongđ nzongf yâuc taih zen.<verse eid="ACT 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Năngđ nâyx, Ê-tên tuz pôz lub nzongf yâuc naih tômx jab, ayx jix caox njingc cloon njic hoouđ lub nzongf yămz songx munh mungh tongx. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Six naih ah đomc munh nzeengz staox taih, stiz six wax đomc huyđ toongh nyăngz munh, hipđ ayx “Pungx Goib Nyăngz Munh”, cloon wax đomc Sai-lin munh, cloon A-lek-san-đê munh, cloon tăng Si-li-si, cloon Ê-si, taih nyăngz munh, nzeengz cloon Ê-tên. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Six stiz max hayh nzeengz tuz hingh nănh nyăngz tongb manyh cloon Singx-Lingh six nănh păngc bix coong wax Tauh. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Tăng wa, stiz câux ah đomc munh nongc coong: “Buz numđ nănh coong pamf nyăngz wac nzeengz Mô-sê cloon Zâu Tênb-Huungh.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Stiz lungz songx munh cloon wax đomc munh côx cloon wax đomc nzaox gâyf stênx steengb, stiz songđ taih zoz nănh, ênz muf wa Stămđ Stoif Quanz. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Stiz yâuc zoz ah đomc munh taih ayx za zanyx manyf coong: “Lâyc tauh munh hayh coong wac pamf tauv đăngb zeengh tinc cloon gâyf njanh. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Wâyc buz tuz numđ nănh coong, Na-sa-leetx wax tauh Yê-su, six cayx toou nâyx đomc tinc yâuc coi wănc Mô-sê njăpc taih phunz pănh wax đomc gâyf.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Wax zanyf, muif lanh stâyv wa Stămđ Stoif Quanz cah đangc nyăngz munh, njinh luh si mangc nzac Ê-tên ninyh, phătc nănh nyăngz minb cayx năngđ stinz munh nyăngz minb nâyx.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Tăng wa, stayb munh pyây songđ naic coong: “nâyx đomc dlayc lauf senz naih năngđ nâyx yah?” <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />Six Ê-tên songđ coong:</para>
  <para style="p" vid="ACT 7:2">“Yetx stong yâuf pec, cloon songx munh côx lex, joođ mungv yaz: Gwăngz eeng nyăngz Zâu Tênb-Huungh, hinđ setb taih pongh pănh nyăngz claof jex Apx-la-ham, yămz wa Mê-sô-bô-ta-mi, tăng nănh max zeengx ninyh yămz wa Ha-lan; <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Nănh coong ănz Apx-la-ham coong: ‘Oix zuc ninyh gâyh mâyh nyăngz stâyz phangz, cloon mâyh nyăngz jenb pyau munh, mâyh bix ninyh tauv Yaz bux phunz mâyh wax nomz stâyz phangz.’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Tăng wa, Nănh songđ setb Cên-đê munh stâyz phangz, nănh six yămz Ha-lan. Tăng wa, tauv stiz pha tayc blătc, Zâu Tênb-Huungh songđ ênz nănh nzac nâyx nomz stâyz phangz taih, six nâyx zanyf nyâuh njinh đangh yămz nây nyăngz. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Nănh max sađ laiv huungđ, yămz nây stâyz phangz nyăngz phunz Apx-la-ham, hănđ tix cay ah cuyb nib lomc staux pên lauf max tuz. Six Nănh yâuc nyunc sađ phunz nâyx nomz stâyz phangz, săngh nănh nyăngz phănc yâuc phunz cloon nănh nyăngz cah đangz stâyv sây stunz, max cun nănh lôx max zeengx naih sây. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Six Zâu Tênb-Huungh yâuc coong năngđ nâyx coong, mâyh nyăngz sây stunz six zuc ninyh ayx pec stingx yămz pitc nomz stâyz phangz, phunz munh phađ stiz ayx nâuh, yâuc wâyb stiz tuz stâyx pez nyăngv. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Zâu Tênb-Huungh coong: ‘Nzof Yaz six tingc stiz zuc ayx nâuh wax nomz stâyz phangz, tăng wa, stiz six setb ninyh, yâuc canyx bongc Yaz yămz nâyx nomz tinc.’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Zâu Tênb-Huungh lauf sađ ayx quaix catz nyăngz gâyf phunz nănh, wâyc nây, tauv nănh steengb I-sakx tuz yetc noib songđ ayx quaix catz phunz sây, I-sakx lauf ayx nâyx phunz Ya-côpx, nzof Ya-côpx lauf ayx nâyx phunz săpc nyâyc stingx nyăngz claof jex. <verse eid="ACT 7:8" /><verse number="9" style="v" sid="ACT 7:9" />Six wâyc wa săpc lanh claof jex hănđ Yô-sepx, stiz songđ maic nănh quaix wa I-yipx ninyh; six Zâu Tênb-Huungh cloon nănh yămz, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />songđ njâuv nănh pyăux đutb, nănh pongh nyăngz muif huungđ zâuđ nanc, Zâu Tênb-Huungh yâuc sađ pôz, cloon tongb manyh phunz nănh, yămz I-yipx huungh Pha-la-ôn nyăngz cah đangc, wax tauh huungh songđ phunz nănh cun nzuf I-yipx stâyz phangz, njinh cloon huungh nyăngz pyau. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Tăng wa, lomc I-yipx stâyz phangz cloon Ca-na-an stâyz phangz, naih nyâuđ sab lub, zâuđ nanc nzongf, pănh wax đomc claof jex max hayh lov tuz luungđ nhlinc. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Six, tauv numđ coong yămz wa I-yipx naih blauh witx, Ya-côpx songđ êu pănh wax đomc claof jex ninyh tauv wa zetx hâyđ. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Zef tauv tah nyâyc hâyđ, Yô-sepx songđ coong nănh phunz wax đomc tah pâyz nănh, tăng wa Pha-la-ôn nzăngđ tuz pâyz Yô-sepx nyăngz pyau munh. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Yô-sepx songđ êu wax đomc tah muf, ênz Ya-côpx, nănh nyăngz pha, cloon lomc nănh nyăngz pyau munh, cloopb nzuf six jetb săpc ngâuf lanh. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Năngđ nâyx, Ya-côpx nzac wa I-yipx ninyh, nănh songđ quaix stâyv, nzof pănh wax đomc claof jex lauf năngđ ha. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Stiz yâuc tuz ênz ninyh plopx ănz wa Sê-cêm nyăngz stâu, six Apx-la-ham, nongc nyanh pec maif taih tăng Ha-mô nyăngz toonz yămz wa Sê-cêm. <verse eid="ACT 7:16" /><verse number="17" style="v" sid="ACT 7:17" />Nzof tauv beengc săngx huđ Zâu Tênb-Huungh nyunc cloon Apx-la-ham nyăngz wac taih tauv stătx, stiz songđ phutx hongđ staox taih yămz wa I-yipx, <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />ayx tuz tauv naih pitc tauh huungh stipx staox cun wa I-yipx, wax tauh huungh yâuc max pâyz tauv Yô-sepx. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Nâyx tauh huungh songđ hoiđ pănh nâyx huungđ pec stingx, yâuc ayx huđ ănz pănh nyăngz claof jex, ayx phunz stiz wax đomc sây jenz ah yac steengb taih zuc tayx quanyf, max phunz săngh. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Wax zanyf six toix Mô-sê tuz steengb stâyv taih, nănh quai yămz Zâu Tênb-Huungh nyăngz cah đangc. Nănh tuz ênz yămz stiz pha nyăngz pyau tuz pôz lav. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Six tauv nănh zuc quanyf Pha-la-ôn nyăngz sab songđ pongh, yâuc ênz nănh muf yuungf, nongc ayx nănh nyăngz toonz. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Mô-sê tuz hoođ nzuf I-yipx munh nyăngz tongb manyh, nănh yâuc naih bănh sangz, yămz nănh coong nyăngz wac, căn ayx nyăngz jau. <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />Six tauv nănh tuz stâyx săpc nyăngv, nănh nyăngz nyâuđ, songđ numđ oix ninyh tex nănh wax đomc yâuf pez, six I-sa-la-ên nyăngz sây stunz. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Wax zanyf, Mô-sê phătc ah lanh munh zuc ayx đokc ănz, nănh songđ limb zuc ayx đokc ănz wax tauh, bix ninyh bopc clao phunz zuc ayx huđ ănz wax tauh, songđ bopc I-yipx wax tauh munh tayc, <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />nănh yâuc nyâyh coong wax đomc yâuf pez pâyz tuz coong, Zâu Tênb-huungh nongc nănh nyăngz puf taih njâuv phunz stiz, six stiz max pâyz. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Tauv nyâyc noib nănh zef taih phătc stiz cănh poc wa tinyh jâu, nănh songđ quinb êu stiz ayx gongx, coong: ‘Yâuf pez lex, nyâuh six cănh yâuf pez. Săngh laix nyâuh bix năngx lanh hoiđ lanh?’ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />Six ayx huđ ănz nănh nyăngz cah sinh munh wax tauh, songđ taih nyongđ nănh, yâuc coong: ‘Mănv oonz mâyh ayx stămđ stoif quanz nongc taih stămđ buz heh? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Mâyh lauf oix tayx yaz cayx năngđ cumh noib, mâyh tayx wax tauh I-yipx munh nâyx mah?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Mô-sê numđ wax đomc wac nănh songđ tiuv, ninyh yămz wa Mi-đi-an stâyz phangz, yămz wa nănh steengb tuz iz lanh toonz. <verse eid="ACT 7:29" /><verse number="30" style="v" sid="ACT 7:30" />Tauv stâyx săpc nyăngv cah đangz, naih ah tauh stinz munh hinđ setb taih, pongh nănh yămz wa stâyz phangz blănf, Si-nai zoongz, yămz ah đauc tâuf sac wa nzim plungz. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Wax zanyf, Mô-sê phătc ayx nâyx, songđ numđ nyâyh ganc wax đauc tâuf, nănh songđ ninyh tauv stătx năngx cayb mangc, yâuc numđ Zâu nyăngz wac coong: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘Yaz six mâyh nyăngz claof jex nyăngz Zâu Tênb-Huungh, Apx-la-ham nyăngz Zâu Tênb-Huungh, cloon I-sakx, cloon Ya-côpx nyăngz.’ Wax zanyf, Mô-sê songđ nyac cumh nzav max nzađ mangc. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />Zâu songđ coong ănz nănh: ‘Oix zuc tutb mâyh lâyc staux nyăngz stub ayx queengx, wâyc mâyh stâuđ nyăngz tinc six nib đăngb. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Yaz mangc phătc, Yaz nyăngz pec stingx zuc dlauc wâyb yămz wa I-yipx, Yaz numđ stiz yônx mengc nyăngz stingb, Yaz songđ taih nongc njâuv stiz. Nâyx zanyf, quaix nây taih gôh, Yaz paiđ mâyh ninyh wa I-yipx.’ <verse eid="ACT 7:34" /><verse number="35" style="v" sid="ACT 7:35" />Nâyx tauh Mô-sê, six zuc stiz nzêmh yâuc mađ wax tauh, coong: ‘Mănv oonz mâyh ayx cun nyăngz munh cloon stămđ stoif quanz heh?’ — Six nâyx zanyf, Zâu Tênb-Huungh yâuc paiđ nănh ninyh ayx cun nyăngz munh, yâuc nongc njâuv stiz, tăng stinz munh nyăngz puf, hinđ setb taih pongh nănh yămz wa nzim plungz. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Nănh ênz stiz setb taih, six tăng ayx wax đomc jix caox njingc cloon njic hoouđ yămz wa I-yipx stâyz phangz, cloon yămz wa Coiđ-stib, lauf tăng yămz wa stâyz phangz blănf stâyx săpc nyăngv cah njaf. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Wa six Mô-sê coong ănz I-sa-la-ên munh nyăngz toonz sab coong: ‘Tăng nyâuh nyăngz yâuf pez mungh tongx, Zâu Tênb-Huungh six paiđ ah tauh tâuc wac munh taih phunz nyâuh cayx năngđ yaz nâyx.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Nây six yămz songx munh cah njaf wax tauh, yămz wa stâyz phangz blănf cloon stinz munh, six yămz wa Si-nai zoongz coong ănz nănh wax Tauh, yămz pănh wax đomc claof jex, nănh six stipx săngh mengc nyăngz wac bix nzâyz taih phunz pănh, <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />Six pănh nyăngz claof jex max oix mungv nănh nyăngz wac; stiz nyăngz nyâuđ, yâuc cungb nyâyh oix phunb đangz muf wa I-yipx, <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />songđ coong ănz A-lôn: ‘Joođ ayx ah cuyb miuc hanyh phunz buz nongc yenv buz. Wâyc nâyx tauh Mô-sê ênz pănh setb I-yipx stâyz phangz wax tauh, buz max pâyz tuz nănh săngx laix nzof.’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Tăng wa, stiz songđ ayx ah tauh ngoongh wăngh hanyh taih, yămz wax đomc noib, yâuc stuungx stanyb lanyh phunz wax nomz hanyh tongc, yâuc numđ nyađ stiz nyăngz puf ayx taih nyăngz cumh pâuz. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Six, Zâu Tênb-Huungh songđ winb đangz ănz, yâuc dluyh phunz stiz ninyh paix bongc cah zâyc guungh nyăngz tax huungđ stingz, cayx năngđ ja yămz tâuc wac munh nyăngz stâub, coong:</para>
  <para style="q1" vid="ACT 7:42">‘I-sa-la-ên munh lex, nyâuh yămz wa stâyz phangz blănf stâyx săpc nyăngv cah njaf,</para>
  <para style="q1" vid="ACT 7:42">nyâuh naih stungx stanyb lanyh, cloon jax dlaih phunz Yaz max?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Nyâuh zeengz Mô-lek nyăngz miuc hanyh njiuh,</para>
  <para style="q1" vid="ACT 7:43">yâuc zeengz nyâuh nyăngz Lê-phan stingz tau miuc hanyh,</para>
  <para style="q1" vid="ACT 7:43">— Wax đomc miuc hanyh six nyâuh cănh ayx taih nongc paix stiz —</para>
  <para style="q1" vid="ACT 7:43">Yaz six stuyđ nyâuh quaix wa Ba-bi-lôn ninyh.’<verse eid="ACT 7:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="ACT 7:44" />Nyunc wac njiuh nyăngz zanyx manyf cloon pănh nyăngz claof jex yămz wa stâyz phangz blănf, âyz năngđ Zâu coong bux ănz Mô-sê nâyx, zuc ayx wax nomz njiuh âyz năngđ nănh tuz mâyc phătc nyăngz nâyx, <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />wax nomz njiuh, yâuc tuz njâuh phunz stâyv stipx stâyv, pănh wax đomc claof jex yâuc nzâyz lêpc ninyh tauv Yô-su-wa wax nzêuh, yămz stiz ninyh zab pitc stingx munh nyăngz stâyz phangz wax zanyf, Zâu Tênb-Huungh yâuc luiđ ninyh, yămz pănh wax đomc claof jex nyăngz cah đangc, ayx tuz tauv Đa-witx huungh wax nzêuh, <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />nănh six ah lanh munh tuz Zâu Tênb-Huungh numđ nyađ, nănh songđ joođ ah cuyb tinc nongc phunz Ya-côpx nyăngz Zâu Tênb-Huungh. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Tăng wa Sa-lô-môn songđ zâyv ah sênz pyau phunz Zâu. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />Six Yămz Njăngb Quaix Wax Tauh, max yămz munh nyăngz puf ayx taih nyăngz tinc, cayx năngđ tâuc wac munh coong nâyx:<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />‘Zâu coong: Guungh six Yaz stâyv nyăngz tinc, nib six Yaz staux zaiđ nyăngz tinc.</para>
  <para style="q1" vid="ACT 7:49">Nyâuh cayx zâyv pyau ayx laix phunz Yaz heh?</para>
  <para style="q1" vid="ACT 7:49">Laiv tix six phunz Yaz sec hitb conv nyăngz tinc heh?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Max zâyf Yaz nyăngz puf zuyx nâyx đomc muif huungđ taih haz?’<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />Nyâuh clangz stung nhlengc, nyâuđ cloon bah noomh, max zeengx quaix catz nyăngz munh lex! Nyâuh muif dlih nzeengz Zâu Singx-Lingh. Nyâuh nyăngz claof jex năngđ laix, nyâuh lauf năngđ wa nâyx. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Tâuc wac nyăngz munh tauv laiv, max naih laiv lanh coong, nyâuh nyăngz claof jex bix max ayx huđ ănz? Stiz tayx wax đomc tâuc wac munh, coong tauv Peengh Stimz Wax Tauh năngx taih nyăngz jau wax đomc, nzof nyâuh nâyx zanyf yâuc pênx wax đomc munh, plănc minb ănz Nănh yâuc tayx Nănh, <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />yâuc săngh wax đomc munh, tuz stipx tăng wax đomc stinz munh taih nyăngz gâyf, bix max ayx âyz.”<verse eid="ACT 7:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Wax zanyf numđ wax đomc wac tuz, stiz nyăngz nyâuđ songđ numđ nhlenx, yâuc tăpc nyah ănz Ê-tên. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Six Ê-tên tuz Zâu Singx-Lingh pong nyâuđ, songđ njinh luh mangc staox wa guungh ninyh, nănh phătc Zâu Tênb-Huungh nyăngz gwăngz eeng, yâuc phătc Zâu Yê-su stâuđ yămz Zâu Tênb-Huungh nyăngz byaoh phanx. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Nănh coong: “Phanv mangc, yaz phătc guungh coib goib, yâuc phătc Bamh Munh stâuđ yămz Zâu Tênb-Huungh nyăngz byaoh phanx.” <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />Wax zanyf, stiz songđ hamv stingb lub, yâuc zetx stiz nyăngz bah noomh, songđ tinyh đoih ninyh nyauh nănh. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Taib nănh quaix wa dlanyh cungh ngwaic ninyh, stiz songđ zoz njăuz ôx nănh. Wax đomc zanyx manyf munh tăpx stiz cungh ngwaic wax byenđ guyz, ănz ah lanh munh gunx munh nyăngz staux sinh, bux hipđ ayx Sau-lô. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Stiz zoz njăuz ôx Ê-tên wax zanyf nănh cloo Zâu coong: “Zâu Yê-su lex joođ stipx yaz nyăngz mengc hoonh.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Tăng wa, nănh songđ quâyc nzac, yâuc hamv stingb lub coong: “Zâu lex, joođ Mâyh năngx gâyf tingc stiz nâyx đomc stoif.” Coong wax zâux wac tuz, nănh songđ mâyc njoomh.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Wax zanyf, phătc munh tayx Ê-tên Sau-lô lauf numđ nyađ.</para>
  <para style="p" vid="ACT 8:1">Tăng wa, yămz wax noib Jiux Pangx pongh zuc ayx huđ nzongf yămz wa Yê-lu-sa-lem, wax đomc zen Zâu nyăngz munh, songđ tinyh đoih zuc pyăux đanv ninyh yămz nzêux Yu-đê cloon Sa-ma-đi stâyz phangz, cungb năngx naih wax đomc cumh pâuz munh. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Wax đomc lêpc gongx Zâu nyăngz munh songđ plopx Ê-tên, yâuc haoh wâyc nănh đuungx nzongf. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Six Sau-lô yâuc ayx huđ ănz jiux pangx. Nănh nzac săngh sênz pyau ninyh, toopz zoz njinh munh nzif munh pha, ênz stiz ninyh ănz nzauh.<verse eid="ACT 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Năngđ nâyx, wax đomc zuc pyăux đanv ninyh nyăngz munh, songđ ninyh nzêux muif đoif nzônh Cuđ Jenx lănv Zâu nyăngz wac. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Tăng wa, Phi-lipx nzac wa Sa-ma-đi dlanyh ninyh, lănv Zâu Jix-Tuz phunz stiz. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Songx munh yâuc tinyh đoih mungv Phi-lipx nzaox nyăngz wac stiz mungv wax đomc wac yâuc phătc nănh ayx wax đomc jix caox njingc nyăngz dlayc. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Wâyc yămz stiz wa naih đuungx lanh zuc manđ yootz nzac yămz stinb, wax đomc manđ hamv stingb lub songđ setb wax đomc munh ninyh. Nzof đuungx lanh munh quac, cloon puf quac max six staux quac, yâuc tuz zany gongx nzuf. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Wâyc nây, yămz wa dlanyh songđ naih numđ nyađ lub nzongf.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Six naih ah lanh munh pha bux hipđ ayx Si-môn, cah đangc nănh six ayx papz nyăngz munh yămz wa dlanyh, yâuc ayx phunz Sa-ma-đi munh numđ njingc, nănh yâuc cănh tanv nănh six ayx lub nyăngz munh, <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />munh songđ lub jenz tinyh đoih mungv nănh, yâuc coong: “Nâyx tauh munh six Zâu Tênb-Huungh nyăngz tômx jab, six hipđ ayx Tômx Jab wax huungđ.” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Wax zanyf, munh yâuc mungv lêpc nănh, lauh yongb nzof, wâyc nănh ayx wax đomc manđ papz phunz stiz numđ njingc. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Six tauv stiz zen Phi-lipx, wâyc tuz nănh lănv tauv Zâu Tênb-Huungh nyăngz côkz nyăngz Cuđ Jenx, cloon Zâu Yê-su Jix-Tuz nyăngz manyh, stiz songđ ayx quaix-gâyf, njinh munh nzif cloon munh pha. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Nzof Si-môn lauf zen, ayx quaix-gâyf tuz, nănh songđ njinh luh cloon Phi-lipx yămz. Yâuc tuz phătc wax đomc jix caox njingc, cloon njic hoouđ lub nzongf tuz ayx setb taih, nănh senz numđ nyâyh ganc.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Yămz wax đomc noib, Wax đomc cumh pâuz munh, yămz wa Yê-lu-sa-lem numđ coong, yămz wa Sa-ma-đi stâyz phangz munh stipx Zâu Tênb-Huungh nyăngz gâyf, songđ paiđ Pi-tê cloon Yô-hanx ninyh pongh stiz, <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />wa iz lanh cumh pâuz munh ninyh tauv tinc, songđ cloo Zâu phunz stiz, nongc phunz stiz tuz stipx Zâu Singx-Lingh. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Wâyc Zâu Singx-Lingh max zeengx nzac taih yămz stiz laiv lanh, stiz six nzăngđ cungb tim Zâu Yê-su nyăngz manyh ayx quaix-gâyf cuungv. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Năngđ nâyx, wa iz lanh cumh pâuz munh tăpx puf ănz stiz, stiz songđ tuz stipx Zâu Singx-Lingh. <verse eid="ACT 8:17" /><verse number="18" style="v" sid="ACT 8:18" />Wâyc tuz phătc tăng wax đomc cumh pâuz munh tăpx puf ănz, bix tuz Singx-Lingh nzac, Si-môn songđ zoz nyanh pec taih phunz stiz, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />yâuc coong: “Joođ phunz yaz nâyx huungđ lokc jangx, phunz yaz phanv tăpx puf ănz laiv lanh, wax lanh yâuc tuz stipx Zâu Singx-Lingh.” <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />Six Pi-tê coong ănz nănh: “Mâyh nyăngz nyanh pec six cănh căn mâyh zuc mêtc ninyh, wâyc mâyh nyâyh coong, hayh nongc nyanh maif tuz, Zâu Tênb-Huungh sađ phunz nyăngz pôz! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Mâyh six max naih luungđ phănc yămz nâyx đomc tiny, wâyc mâyh nyăngz nyâuđ six max zanyx yămz Zâu Tênb-Huungh nyăngz cah đangc. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Wâyc nây, oix zuc nhlimc mâyh nâyx huungđ okx nyăngz jau bix joođ cloon Zâu, phunz mâyh năngx hayh păngc nây bix tuz quanyf mâyh nyâuđ nyâyh nyăngz stoif. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Wâyc yaz phătc mâyh jinh đangh yămz wa nzămc cah njaf, yâuc zuc stoif nyăngz jab langb stayb.” <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />Si-môn songđ tauz coong: “Joođ nyâuh stăngc cloo ănz Zâu phunz yaz, phunz nyâuh ah yac coong nâyx đomc jau max zuc setb taih phunz yaz.”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Tăng wa stiz ayx zanyx manyf nzônh Zâu nyăngz wac tuz, stiz songđ phunb đangz muf wa Yê-lu-sa-lem, yâuc cun muf cun nzônh Cuđ Jenx phunz Sa-ma-đi munh nyăngz đuungx tiuh njăngv.<verse eid="ACT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Wax zanyf, Zâu nyăngz ah tauh stinz munh taih bux ănz Phi-lipx coong: “Oix zuc nyoongz quef, quaix namh pôngz wax phanx muf, six tăng Yê-lu-sa-lem nzac wa Ga-sa muf wax stinz jau.” (Wax cuyb tinc six max naih munh yămz.) <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Nănh songđ nyoongz quef setb jau ninyh, six phanv mangc, naih ah lanh munh pha, six Ê-ti-ô-bi munh, ayx côkz pâu quanz lub phunz Can-đa-si, Ê-ti-ô-bi huungh nzif, nănh six jinh đangh cun nzuf wax tauh huungh nzif nyăngz nyanh, nănh ninyh wa Yê-lu-sa-lem nongc canyx bongc, <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />toix wax zanyf, nănh jinh đangh stâyv wa maf sex cah zâyc phunz đangz muf, yâuc toc tâuc wac munh I-sa-ya nyăngz stâub. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Singx-Lingh songđ coong ănz Phi-lipx coong: “Oix zuc ninyh năngx tauv stătx wax saz maf sex.” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Tăng wa, Phi-lipx songđ tiuv ninyh, yâuc numđ wax tauh quanz jinh đangh toc tâuc wac munh I-sa-ya nyăngz stâub, nănh songđ naic coong: “Mâyh saz tuz mâyh jinh đangh toc nâyx đomc max?” <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />Wax tauh quanz songđ coong: “Max naih mănv bux phunz yaz, yaz laiv ayx laix saz tuz heh?” Nănh songđ êu Phi-lipx lekb staox ninyh cloon nănh stâyv wa. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Wax zanyf nănh toc wax đomc Canyx Stâub six coong ayx nâyx:</para>
  <para style="q1" vid="ACT 8:32">“Nănh zuc ênz ninyh, cayx năngđ pax jiz yuungh zuc ênz ninyh tayx ayx a,</para>
  <para style="q1" vid="ACT 8:32">yâuc cayx năngđ pax jiz yuungh jenz zuc munh tâyv nănh nyăngz pyâyz yâuc max nyaoc,</para>
  <para style="q1" vid="ACT 8:32">wâyc nây, Nănh max goib nănh nyăngz nzetx.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Yămz Nănh zuc ayx peo nyăngz jau, peengh stimz nyăngz gâyf zuc zoz ninyh.</para>
  <para style="q1" vid="ACT 8:33">Naih mănv tuz coong tauv Nănh nyăngz sây stunz?</para>
  <para style="q1" vid="ACT 8:33">Wâyc Nănh nyăngz mengc zuc zoz gâyh nây nib ninyh nzof.”<verse eid="ACT 8:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 8:34" />Toc tuz, wax tauh quanz lub coong ănz Phi-lipx: “Yaz joođ mâyh bux phunz yaz pâyz, nâyx tauh tâuc wac munh, jinh đangh coong nâyx đomc wac si tauv mănv — cănh coong nănh max six coong tauv pitc lanh heh?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Phi-lipx songđ goib nzetx, quef coonz tăng nâyx đomc Canyx Stâub, lănv Cuđ Jenx coong tauv Zâu Yê-su phunz wax tauh quanz. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Stiz jinh đangh ninyh wa bah đamx jau wax zanyf, stiz ninyh tauv ah cuyb tinc naih womz, wax tauh quanz song naic coong: “Womz yec! Naih tix huungđ cangđ yaz ayx quaix-gâyf max?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />[Phi-lipx songđ coong ănz nănh: “Năngđ coong mâyh nongc nzuf mâyh nyăngz nyâuđ zen, mâyh six tuz njâuv.” Tăng wa wax tauh quanz songđ tauz coong: “Yaz zen coong Zâu Jix-Tuz six Zâu Tênb-Huungh nyăngz toonz.”] <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Wax tauh quanz songđ êu maf sex yămf, Phi-lipx cloon wax tauh quanz, stiz iz lanh songđ nzac wa womz ninyh, Phi-lipx songđ ayx quaix-gâyf phunz wax tauh quanz. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Stiz tăng wa womz setb taih wax zanyf, Zâu nyăngz Singx-Lingh songđ ênz Phi-lipx ninyh, wax tauh quanz lub yâuc taux wa max phătc Phi-lipx gôh, nănh songđ numđ nyađ setb jau muf. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Six Phi-lipx munh yâuc phătc yămz wa A-sô-tat, nănh jămc wax nomz stâyz phangz, nzônh Cuđ Jenx phunz wax đomc muif nomz dlanyh, ayx tuz tauv nănh ninyh tauv wa Si-sa-li-ya.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Six Sau-lô yâuc njinh luh huukb mađ, yâuc oix tayx Zâu nyăngz stayb sây, songđ ninyh pongh stayb munh pyây, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />joođ nănh ayx stâub pungx ninyh phunz wa Đa-mat dlanyh nyăngz muif nomz huyđ toongh, phunz năngđ coong nănh ninyh lov tinyh phanv pongh laiv lanh lêpc Zâu nyăngz munh, njinh munh nzif munh pha, nănh six stayb stiz ênz lauf wa Yê-lu-sa-lem. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />Nănh jinh đangh setb jau ninyh, cayx tauv wa Đa-mat dlanyh wax zanyf, lênh dlih naih gwăngz eeng tăng wa guungh siux nzac nănh ninyh, <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />nănh songđ glinyf wa nib, yâuc numđ naih wac stingb coong ănz nănh coong: “Sau-lô lex, Sau-lô, săngh laix mâyh bix ayx huđ ănz yaz?” <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />Nănh songđ coong: “Zâu lex, Mâyh six mănv heh?” Zâu coong: “Yaz six Yê-su mâyh jinh đangh ayx huđ ănz wax tauh; <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />six mâyh phanv nyoongz quef bix nzac wa dlanyh ninyh gôh, mâyh oix zuc ayx luungđ, six cănh naih munh bux phunz mâyh ayx.” <verse eid="ACT 9:6" /><verse number="7" style="v" sid="ACT 9:7" />Nzof cloon nănh ninyh wax đomc munh, yâuc stâuđ wa max coong tuz wac, stiz numđ wac stingb six max phătc mănv. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sau-lô songđ tăng wa nib nyoongz quef, six nănh goib mâyc nănh yâuc max phătc luungđ tiny. Tăng wa, stiz songđ nzauf nănh nyăngz puf, jinb nănh nzac wa Đa-mat dlanyh ninyh. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Tuz pôz noib nănh max phătc luungđ tiny, nănh yâuc max nhlinc max hopb.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Wax zanyf yămz wa Đa-mat dlanyh naih ah lanh stayb sây hipđ ayx A-na-ni. Phătc hinđ yangh nyăngz jau, Zâu coong ănz nănh, coong: “A-na-ni lex!” Nănh songđ coong: “Zâu lex, yaz yămz nây!” <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />Zâu songđ coong ănz nănh: “Nyoongz quef, bix ninyh tauv wa hipđ ayx jau zac wax stinz jau, lov ah lanh Ta-sat munh hipđ ayx Sau-lô yămz Yu-đa nyăngz pyau, wâyc nănh jinh đangh cloo Zâu, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />Yămz hinđ yangh nyăngz jau, nănh phătc ah lanh munh bux hipđ ayx A-na-ni, nzac taih tăpx puf ănz nănh, phunz nănh nyăngz mâyc tuz phătc jau.” <verse eid="ACT 9:12" /><verse number="13" style="v" sid="ACT 9:13" />Six A-na-ni tauz coong: “Zâu lex, yaz numđ naih munh đuungx coong tauv nâyx tauh munh, nănh six ayx bah laiv săngb huđ ănz Mâyh wax đomc đăngb zeengh munh yămz wa Yê-lu-sa-lem. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Nzof nâyx zanyf, nănh yâuc tuz tăng wax đomc stayb munh pyây jaoz lanyf phunz, nongc ninyh zoz stayb, zen caođ Mâyh nyăngz manyh wax đomc munh.” <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />Six Zâu coong ănz nănh: “Phanv ninyh gôh, wâyc nâyx lanh munh six lauf Yaz sên taih nyăngz munh, nongc nzâyz Yaz nyăngz manyh ninyh nzônh phunz wax đomc pitc stingx munh, njinh cloon wax đomc huungh stix, cloon I-sa-la-ên nyăngz munh; <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />nzof Yaz six phunz nănh pâyz tuz, nănh oix zuc wâyc Yaz nyăngz manyh, bix zuc tanyđ zâuđ đuungx ayx năngđ laix.” <verse eid="ACT 9:16" /><verse number="17" style="v" sid="ACT 9:17" />Tăng wa, A-na-ni songđ setb jau ninyh nzac wax sênz pyau ninyh. Tăpx puf ănz Sau-lô yâuc coong: “Sau-lô lex, Zâu paiđ yaz taih — six Zâu Yê-su, senz mâyh taih nây bix hinđ setb taih pongh mâyh yămz wa bah đamx jau wax Tauh — nongc phunz mâyh hayh tuz mangc phătc yâuc tuz Zâu Singx-Lingh pong nyâuđ.” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Songđ lênh dlih, naih ah huungđ cayx năngđ jix nâyx tăng nănh wa mâyc tuih nzac taih, nănh songđ hayh mangc tuz phătc, nănh nyoongz quef taih, songđ ayx quaix-gâyf; <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Nănh nhlinc hopb songđ tuz huih jab lauf.</para>
  <para style="p" vid="ACT 9:19">Wax zanyf, nănh cloon wa Đa-mat dlanyh wax đomc stayb sây yămz batz noib. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Nănh songđ yămz wax đomc huyđ toongh, nzônh Zâu Yê-su coong, Zâu Yê-su six Zâu Tênb-Huungh nyăngz Toonz. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Munh tinyh đoih mungv songđ numđ nyâyh ganc, yâuc coong: “Lâyc max zâyf ayx huđ ănz zen caođ nâyx nomz manyh wax đomc munh, yămz wa Yê-lu-sa-lem dlanyh wax tauh haz? Nzof nănh max zâyf lauf wâyc wax huungđ cumh pâuz bix taih nây, nongc zoz wax đomc zen nyăngz munh nongc stayb ênz muf phunz wax đomc stayb munh pyây haz?” <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />Six Sau-lô yâuc cun ayx cun njoongh staox, ayx phunz yămz wa Đa-mat dlanyh nyăngz Yu-tai munh numđ nyâyh ganc, wâyc nănh ayx zanyx manyf coong Yê-su six Zâu Jix-Tuz.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Tăng wa, tuz đuungx noib cah đangz, Yu-tai munh songđ tinyh đoih ta zux ix tayx nănh. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Six stiz wax đomc zux ix yâuc tuz bux phunz Sau-lô pâyz. Ayx tuz munh lôx năngx yămz wax đomc dlanyh jeengh, zu quaix noib quaix munf nongc tayx nănh. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Tăng wa, Sau-lô songđ njinh nzămc setb ninyh, nănh wax đomc stayb sây pungx nănh ănz ah nomz zongf cah njaf, pungx nănh quaix wa dlanyh bah stab cungh ngwaic ninyh.<verse eid="ACT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Six ninyh tauv wa Yê-lu-sa-lem, nănh oix cloon stayb sây buz songc yămz, six stiz yâuc tinyh đoih cumh nzav nănh, max zen coong nănh six stayb sây. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Tăng wa, Ba-na-batc songđ ênz nănh ninyh pongh wax đomc cumh pâuz munh, yâuc lănv phunz stiz tauv Sau-lô tuz pâyz Zâu ayx năngđ laix, yămz wa bah đamx jau, cloon Zâu coong ănz nănh wax đomc, yâuc lănv tauv nănh yămz wa Đa-mat dlanyh, bix pungx stimz tim Zâu Yê-su nyăngz manyh nzônh gâyf. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Tăng wa, nănh songđ cloon stiz yămz, yâuc setb ninyh setb lauf yămz wa Yê-lu-sa-lem, pungx stimz tim Zâu nyăngz manyh nzônh gâyf. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Nănh cloon coong Hi-lapc wac wax đomc Yu-tai munh cun coong yâuc cun nzeengz gâyf, six stiz lov jau tayx nănh. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Six wax đomc yâuf pez pâyz tuz nâyx đomc, songđ ênz nănh nzac wa Si-sa-li-ya dlanyh muf, zef stungx nănh ninyh wa Ta-sat.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Năngđ nâyx, lomc Yu-đê stâyz phangz, cloon Ga-li-lê stâyz phangz, cloon Sa-ma-đi stâyz phangz nyăngz jiux pangx tuz naih peengh oonz yămz; wâyc tuz tinyh đoih zanyb Zâu staox taih, yâuc tuz Zâu Singx-Lingh oonz nyâuđ, jiux pangx songđ tuz phutx hongđ staox. <verse eid="ACT 9:31" /><verse number="32" style="v" sid="ACT 9:32" />Tăng wa, Pi-tê songđ ninyh nzêux muif nomz stâyz phangz, yâuc nzac wa Lit-đa dlanyh ninyh, pongh yămz wa wax đomc zen Zâu nyăngz đăngb zeengh munh. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Yămz wa nănh pongh ah lanh munh, bux hipđ ayx Ai-nê-atc, quac phâyx wa zâuv tuz yetc nyăngv, nây six ah lanh munh quac munh. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Pi-tê coong ănz wax tauh munh pha coong: “Ai-nê-atc lex, Zâu Yê-su Jix-Tuz zany gongx phunz mâyh. Nyoongz quef bix nzâyz mâyh nyăngz zâuv muf gôh,” nănh songđ toongx sangf nyoongz quef. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Muif lanh yămz wa Lit-đa, cloon Sa-lôn nyăngz munh, phătc nănh gongx, stiz songđ tinyh đoih taih lêpc Zâu.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Wax zanyf, yămz wa Yăp-pha dlanyh, yămz stayb sây buz, naih ah lanh munh nzif bux hipđ ayx Ta-bi-ta, wax nomz bux, phanv taih, six hipđ ayx Đô-cat. Nănh six ayx đuungx huungđ cumh pâuz gongx, nănh yâuc ayx đuungx huungđ stăngc munh nyăngz cumh pâuz. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Yămz wax đomc noib, nănh săngh gumc, yâuc tayc. Tăng wa, munh songđ đaox nănh nyăngz stayđ, yâuc tăpx nănh ănz wa cah zâyc tab pyau nyăngz bôngh njaf. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Wâyc Lit-đa six yămz stătx wa Yăp-pha dlanyh, Wax đomc stayb sây numđ coong Pi-tê jinh đangh yămz wa, stiz songđ paiđ iz lanh munh ninyh pongh nănh, zăpx coong: “Êu nănh coonx taih buz nây.” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Tăng wa, Pi-tê songđ nyoongz quef cloon stiz muf, muf tauv tinc, stiz songđ ênz nănh staox wa cah zâyc tab pyau ninyh, nzof wax đomc munh nzif qua, yâuc tinyh đoih taih stâuđ nănh wa cah sinh haoh, zef nuz phunz nănh mangc wax đomc guyz lub cloon đuungx huungđ guyz, tăng Đô-cat năngx jinh cloon stiz yămz bix ayx phunz wax đomc. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Pi-tê êu munh tinyh đoih setb cungh ngwaic ninyh nzuf, songđ quâyc nzac cloo Zâu, nzof nănh songđ winb muf wax tauh munh tayc, yâuc coong: “Ta-bi-ta, nyoongz quef gôh.” Tăng wa, Ta-bi-ta songđ goib mâyc, mangc phătc Pi-tê, nănh songđ nyoongz quef. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Pi-tê songđ nongc puf tanyđ nănh nyoongz quef, yâuc êu wax đomc đăngb zeengh munh, cloon wax đomc au qua nzac lauf, phunz stiz mangc wax tauh munh nzif năngx jinh săngh. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Nâyx đomc dlayc tuz lănv ninyh pong nzuf wa Yăp-pha dlanyh, munh đuungx songđ taih zen Zâu. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Blătc wa, Pi-tê năngx yămz wa Yăp-pha dlanyh đuungx noib, cloon ah lanh munh bux hipđ ayx Si-môn, ayx đupx stangc nyăngz munh.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Wax zanyf, yămz wa Si-sa-li-ya dlanyh naih ah lanh munh bux hipđ ayx Cô-nê-li-atc, ayx ah tauh peengz pyây, yămz hipđ ayx I-ta-li wax peob, <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />nănh cloon nănh nyăngz pyau munh tinyh đoih, neetb stimz lêpc gongx Zâu Tênb-Huungh yâuc ayx đuungx huungđ cumh pâuz gongx phunz pec stingx, yâuc njinh leox cloo Zâu Tênb-Huungh max setc tiny. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Bah noib zax cox pôz săngx huđ nâyx, yămz hinđ yangh nyăngz jau, nănh senz phătc đăngb zeengh, Zâu Tênb-Huungh nyăngz ah tauh stinz munh taih pongh nănh, yâuc coong ănz nănh: “Cô-nê-li-atc lex!” <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />Six nănh numđ cumh nzav yâuc njinh luh mangc nzac wax tauh stinz munh ninyh, nănh coong: “Zâu lex, luungđ heh?” Stinz munh coong ănz nănh: “Mâyh cloo Zâu nyăngz wac cloon mâyh setb stimz stăngc munh nyăngz jau, tuz staox ninyh tauv Zâu Tênb-Huungh nyăngz cah đangc, cayx năngđ stanyb lanyh nongc săngx tauv mâyh. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Nâyx zanyf mâyh oix zuc paiđ munh ninyh wa Yăp-pha dlanyh êu Si-môn, yâuc hipđ ayx Pi-tê wax tauh. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Nănh jinh đangh tuz stipx yămz Si-môn nyăngz pyau, ah lanh đupx stangc munh, nănh nyăngz pyau yămz wa coiđ sinh.” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Tauv bux nănh wax tauh stinz munh muf blătc, nănh songđ êu wa pyau nyăngz iz lanh pâuz cloon nănh nyăngz ah lanh stinb sinh peengz lêpc gongx Zâu nyăngz munh taih, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />nănh lănv nzuf wax đomc wac ănz stiz, songđ paiđ stiz ninyh wa Yăp-pha dlanyh.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Tauv nyâyc noib, toix wax đomc munh jinh đangh setb jau ninyh cayx tauv wa dlanyh wax zanyf, cox săpc nyâyc săngx huđ, Pi-tê staox wa pyau tuungx ninyh cloo Zâu. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Wax zanyf nănh yâuc numđ nyâuđ sab oix nhlinc, toix wa pyau munh jinh đangh bênc nhlinc hopb nyăngz săngx huđ, nănh songđ phătc hinđ yangh nyăngz jau, <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />nănh phătc guungh jeengh coib goib, yâuc phătc ah huungđ nzac taih, cayx năngđ ah leepz tungh minb buyx lub nâyx, stayb pyâyz nomz joongz pungx nzac nib taih, <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />yămz wa cah njaf six naih muif huungđ stanyb hauđ pyâyz saz staux tauv laiv, cloon nyoongz nib minc nyăngz tax huungđ, cloon đamx guungh nyăngz nooc. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Yâuc naih wac coong ănz nănh coong: “Pi-tê lex, nyoongz quef, tayx ayx a nhlinc gôh.” <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />Six Pi-tê tauz coong: “Zâu lex, max đêh, wâyc yaz max naih laiv zanyf nhlinc, naih wâyx cloon max đăngb zeengh nyăngz laiv huungđ.” <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />Zef naih wac coong ănz nănh, tah nyâyc hâyđ coong: “Laiv huungđ Zâu Tênb-Huungh ayx tuz dlăngc, mâyh năngx gâyf stunx ayx naih wâyx.” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Nâyx huungđ dlayc setb taih ayx năngđ nâyx tuz pôz hâyđ, wax huungđ songđ lênh dlih tuz sâub staox guungh muf.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Pi-tê năngx jinh đangh nyâyh max tongb nănh ah yac phătc nâyx đomc hinđ yangh nyăngz jau, ănz wa nyâuđ wax zanyf, Six phanv mangc, Cô-nê-li-atc paiđ ninyh wax đomc munh bâyf stâuđ wa jeengh cah đangc, zah naic Si-môn nyăngz pyau nzof. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Stiz hamv naic coong, Si-môn hipđ ayx Pi-tê wax tauh, max zâyf tuz stipx yămz nây haz. <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />Pi-tê năngx jinh poc wa nyâyh nâyx đomc hinđ yangh nyăngz jau, Singx-Lingh songđ coong ănz nănh: “Phanv mangc, naih pôz lanh munh pha taih lov mâyh. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Mâyh phanv nyoongz quef bix lêpc stiz muf gôh, max nongc nyâyh luungđ, wâyc nây six yaz êu stiz taih.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Tăng wa, Pi-tê songđ nzac ninyh pongh wax đomc munh yâuc coong: “Yaz six nyâuh jinh đangh lov wax tauh, wâyc laiv huungđ nyâuh bix taih nây heh?” <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />Stiz songđ coong: “Cô-nê-li-atc peengz pyây êu buz taih, nănh six ah lanh peengh stimz munh yâuc cumh nzav Zâu Tênb-Huungh, pec stingx Yu-tai munh yâuc tinyh đoih zanyb nănh, nănh tuz ah tauh đăngb zeengh nyăngz stinz munh taih bux coong, oix zuc êu mâyh ninyh nănh nyăngz pyau nongc mungv tăng mâyh bux nyăngz wac.” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Năngđ nâyx, Pi-tê songđ stipx stiz nzac pyau muf.</para>
  <para style="p" vid="ACT 10:23">Tauv nyâyc noib nănh songđ nyoongz quef cloon stiz ninyh, yâuc naih batz lanh yâuf pez tăng wa Yăp-pha dlanyh lêpc nănh muf. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Tauv nyâyc noib stiz songđ ninyh tauv Si-sa-li-ya dlanyh. Wax zanyf Cô-nê-li-atc jinh đangh yămz wa zu stiz, nănh êu nănh nyăngz pyau munh cloon nănh quênx wax đomc lah pyeoz toic, tinyh đoih taih căpx dlonf yămz nănh nyăngz pyau. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Pi-tê nzac pyau lauf wax zanyf, Cô-nê-li-atc ah phătc Pi-tê, songđ ninyh paix Pi-tê wa staux sinh. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Six Pi-tê jinb nănh nyoongz quef, yâuc coong: “Joođ nyoongz quef! Yaz six lauf cungb bamh munh lêc.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Nănh cloon Cô-nê-li-atc coong wac nzac muf wax zanyf, yâuc phătc naih munh đuungx căpx dlonf yămz wa. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />Nănh songđ coong ănz stiz: “Nyâuh lauf cănh pâyz coong, ah lanh Yu-tai munh bix ninyh pongh cloon ah lanh pitc stingx munh, ayx năngđ nâyx six longđ gâyf năngđ laix, six yaz, tuz Zâu Tênb-Huungh bux yaz coong, max tuz stunz laiv lanh munh ayx naih wâyx max six max đăngb. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Wâyc nây, nyâuh êu yaz wax zanyf, yaz songđ max nyâyh luungđ bix taih. Six yaz oix pâyz tuz coong wâyc laiv huungđ dlayc nyâuh bix êu yaz taih?” <verse eid="ACT 10:29" /><verse number="30" style="v" sid="ACT 10:30" />Cô-nê-li-atc songđ tauz coong: “Pyâyz noib cah đangc nây, toix nâyx săngx huđ, six pôz săngx huđ yaz jinh đangh yămz yaz nyăngz pyau cloo Zâu, songđ phătc, ah lanh munh zuz guyz quav gwăngz eeng stâuđ yaz cah đangc, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />nănh yâuc coong: ‘Cô-nê-li-atc lex, mâyh cloo Zâu nyăngz wac tuz Zâu Tênb-Huungh mungv, cloon mâyh setb stimz stăngc munh nyăngz jau, yâuc tuz săngx tauv yămz Zâu Tênb-Huungh nyăngz cah đangc. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Năngđ nâyx, mâyh oix zuc paiđ munh ninyh wa Yăp-pha dlanyh êu Si-môn hipđ ayx Pi-tê wax tauh. Nănh jinh đangh tuz stipx yămz Si-môn nyăngz pyau, ah lanh đupx stangc munh, yămz wa coiđ sinh.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Wâyc nây, yaz songđ lênh dlih paiđ munh ninyh êu mâyh, mâyh yâuc taih, senz gongx nzongf gôh. Nzof, nâyx zanyf buz tinyh đoih yămz nây Zâu Tênb-Huungh nyăngz cah đangc, nongc mungv Zâu coong bux mâyh nyăngz yetx stong dlayc.” <verse eid="ACT 10:33" /><verse number="34" style="v" sid="ACT 10:34" />Wax zanyf, Pi-tê songđ coong: “Senz, yaz pâyz tuz coong Zâu Tênb-Huungh six max pyac laiv lanh. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Nzof, yămz manf stingx munh, tinyh phanv laiv lanh cumh nzav Nănh, bix ayx peengh stimz nyăngz jau, six tuz Nănh stipx nyenc wax lanh. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Nây six Nănh pungx phunz I-sa-la-ên munh nyăngz senz gâyf, Nănh phunz peengh oonz nyăngz Cuđ Jenx taih six Zâu Yê-su Jix-Tuz — Nănh six ayx muif huungđ nyăngz Zâu — <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />nyâuh lauf pâyz tuz yămz wa Yu-đê stâyz phangz, setb taih wax đomc dlayc, quef coonz tăng Ga-li-lê stâyz phangz, tăng Yô-hanx êu munh ayx quaix-gâyf blătc, <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />tăng Na-sa-leetx taih wax Tauh Yê-su, tuz Zâu Tênb-Huungh sađ Zâu Singx-Lingh cloon tômx jab phunz Nănh, Nănh yâuc ninyh muif đoif ayx gongx nyăngz cumh pâuz, zef zany gongx yetx stong zuc manđ nzac yămz stinb nyăngz munh, wâyc Zâu Tênb-Huungh cloon Nănh yămz. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Buz six ayx zanyx manyf coong tauv Nănh ayx wax đomc muif huungđ cumh pâuz, yămz lomc Yu-tai munh nyăngz stâyz phangz cloon yămz Yê-lu-sa-lem, senz stiz zoz Nănh tingz ănz săpc đăngc zax tayx tayc wax Tauh. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Tauv wax noib pôz Zâu Tênb-Huungh zef ayx phunz Nănh săngh taih, yâuc năngx ayx phunz Nănh hinđ setb taih, <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />max zâyf phunz muif lanh munh phătc, six cungb phunz wax đomc zanyx manyf nyăngz munh, senz tuz Zâu Tênb-Huungh tăng cah đangc sên taih wax đomc — six buz nâyx đomc, senz cloon Nănh songc nhlinc songc hoopđ nyăngz munh, yămz Nănh tăng tayc săngh taih blătc. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Nănh bux buz êu oix zuc ninyh nzônh gâyf phunz songx munh, yâuc ayx zanyx manyf coong, Nănh six tuz Zâu Tênb-Huungh sên taih, nongc stămđ munh săngh cloon munh tayc wax Tauh. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Six lauf wâyc Nănh, bix wax đomc muif tauh tâuc wac munh, ayx zanyx manyf coong, tinyh phanv laiv lanh nongc nyâuđ zen caođ Nănh, six tuz quanyf stoif yămz Nănh nyăngz manyh.”<verse eid="ACT 10:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Pi-tê năngx jinh coong nâyx đomc wac wax zanyf, Zâu Singx-Lingh songđ nzac taih yămz yetx stong poc wa mungv Pi-tê nzônh gâyf wax đomc munh. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Wax đomc ayx quaix catz zen nyăngz munh — six lêpc Pi-tê ninyh wax đomc munh — tinyh đoih numđ njingc, wâyc phătc Zâu Singx-Lingh lauf tuz sađ taih phunz cloon pitc stingx munh. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Wâyc stiz numđ wax đomc munh coong pitc huungđ wac, yâuc tanv Zâu Tênb-Huungh. Wax zanyf, Pi-tê songđ coong: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“Naih mănv năngx hayh pyenv max nongc womz ayx quaix-gâyf phunz nâyx đomc munh heh, senz tuz stipx Zâu Singx-Lingh cayx năngđ pănh nâyx, wax đomc?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Pi-tê songđ êu stiz ayx quaix-gâyf, yămz Zâu Yê-su Jix-Tuz nyăngz manyh. Tăng wa, stiz songđ joođ êu Pi-tê cloon stiz yămz wa tix noib timb.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Wax zanyf, wax đomc cumh pâuz munh cloon yămz wa Yu-đê stâyz phangz wax đomc yâuf pez numđ coong, pitc stingx munh lauf stipx Zâu Tênb-Huungh nyăngz gâyf. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Tăng wa, Pi-tê muf tauv wa Yê-lu-sa-lem, wax đomc ayx quaix catz nyăngz munh songđ căn Nănh tinyh nzeengz, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />yâuc coong, mâyh bix nzac max ayx quaix catz nyăngz munh nyăngz pyau ninyh cloon nănh stiz songc nhlinc. <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Six Pi-tê songđ năngx cayb ah manc coong ănz stiz coong: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />“Yaz yămz wa Yăp-pha dlanyh jinh đangh cloo Zâu songđ yămz Singx-Lingh, yaz phătc hinđ yangh nyăngz jau, yâuc phătc naih ah huungđ nzac taih, cayx năngđ tungh minb buyx lub nâyx, stayb pyâyz nomz joongz, tăng wa guungh pungx nzac taih, tauv yaz yămz nyăngz tinc, <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />yaz năngx cayb tex mangc, songđ phătc yămz nib minc nyăngz muif huungđ stanyb hauđ cloon muif huungđ jămx staov pyâyz saz staux tauv laiv, cloon muif huungđ jeengz nyoongz, cloon muif huungđ đamx guungh nyăngz nooc. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Yaz yâuc numđ naih wac bux ănz yaz coong: ‘Pi-tê lex, nyoongz quef, bix tayx ayx a nhlinc gôh!’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Six yaz tauz coong: ‘Zâu lex, max đêh, wâyc yaz max naih laiv zanyf nhlinc nzac nzetx naih wâyx, cloon max đăngb nyăngz tax huungđ.’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />Six naih wac tăng wa guungh coong ănz yaz tah nyâyc hâyđ coong: ‘Laiv huungđ Zâu Tênb-Huungh ayx tuz dlăngc, mâyh năngx gâyf stunx ayx naih wâyx.’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Ayx năngđ nâyx setb taih tuz pôz hâyđ, muif huungđ songđ tuz sâub staox guungh muf. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />Phanv mangc, toix wax zanyf naih pôz lanh munh pha stâuđ buz yămz wax sênz pyau nyăngz jeengh cah đangc, tuz tăng Si-sa-li-ya dlanyh paiđ taih nongc pongh yaz. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Wax zanyf, Singx-Lingh songđ bux êu yaz lêpc stiz muf, năngx gâyf nyâyh luungđ. Tăng wa, nây jooz lanh yâuf pez lauf cloon yaz ninyh, buz songđ ninyh nzac wax tauh munh nyăngz pyau. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Tăng wa nănh lănv phunz buz coong, nănh phătc stinz munh taih stâuđ yămz nănh wa pyau, bux coong: ‘Oix zuc paiđ munh ninyh wa Yăp-pha dlanyh êu Si-môn, yâuc hipđ ayx Pi-tê wax tauh taih, <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Nănh six coong muif huungđ bux phunz mâyh, nzof păngc nây mâyh cloon mâyh nyăngz pyau munh — songđ tuz njâuv.’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />Six tauv yaz ah coong wac, Zâu Singx-Lingh songđ nzac taih yămz stiz, lauf cayx năngđ ah yac nzac yămz pănh wa nâyx. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Yaz songđ săngx tauv Zâu coong nyăngz wac, Nănh coong: ‘Yô-hanx nongc womz ayx quaix-gâyf; six nyâuh oix tuz nongc Zâu Singx-Lingh ayx quaix-gâyf.’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Wâyc nây, năngđ coong Zâu Tênb-Huungh lauf sađ phunz stiz tuz songc ah huungđ pôz, cayx năngđ pănh nâyx, wâyc stiz nongc nyâuđ zen Zâu, six Zâu Yê-su Jix-Tuz, năngđ nâyx, yaz six mănv bix năngx hayh cangđ Zâu Tênb-Huungh heh?” <verse eid="ACT 11:17" /><verse number="18" style="v" sid="ACT 11:18" />Wax zanyf, stiz numđ nâyx đomc wac, stiz songđ max tinyh nzeengz, yâuc tanv Zâu Tênb-Huungh, coong: “Ha six, Zâu Tênb-Huungh lauf sađ phunz pitc stingx munh tuz coi nyâuđ nhlimc stoif, phunz stiz tuz săngh mengc.”<verse eid="ACT 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Tăng wa, wax đomc tăng Ê-tên zuc tayx, bix zuc ayx huđ pyăux đanv ninyh nyăngz munh, songc naih pyăux ninyh tauv wa Phi-ni-si stâyz phangz, cloon Sai-batc coiđ njeengh, cloon An-ti-ôkx dlanyh, stiz max nzônh Cuđ Jenx phunz mănv, cungb phunz Yu-tai munh cuungv. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Wax zanyf, yămz wa nyăngz munh naih ah phanx six yămz Sai-batc cloon Sai-lin nyăngz munh, six nâyx đomc munh ninyh tauv wa An-ti-ôkx, stiz songđ nzônh Zâu Yê-su nyăngz Cuđ Jenx phunz Hi-lapc munh. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Zâu nyăngz puf cloon stiz yămz; wâyc nây, naih munh đuungx nzongf zen, yâuc winb đangz lauf lov Zâu. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />Wax zanyf, yămz wa Yê-lu-sa-lem nyăngz jiux pangx munh, numđ lănv nâyx đomc wac, stiz songđ paiđ Ba-na-batc ninyh tauv wa An-ti-ôkx, <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />ninyh tauv tinc, mangc phătc Zâu Tênb-Huungh nyăngz pôz, nănh songđ numđ nyađ, songđ quinb muif lanh êu jab nongc nyâuđ lêpc Zâu năngx tăngđ. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Wâyc nănh six ah lanh munh gongx, yâuc naih Zâu Singx-Lingh pong nyâuđ cloon zen stimz, songđ naih đuungx lanh munh taih zen Zâu. <verse eid="ACT 11:24" /><verse number="25" style="v" sid="ACT 11:25" />Tăng wa, nănh ninyh tauv wa Ta-sat dlanyh lov Sau-lô. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Lov tuz pongh, Ba-na-batc songđ ênz sau-lô ninyh wa An-ti-ôkx. Stiz songđ yămz wa ah nyăngv cah njaf, cloon jiux pangx căpx dlonf yâuc nzaox munh đuungx. Nzof yâuc quef coonz tăng yămz An-ti-ôkx dlanyh, zen Zâu nyăngz munh bix tuz hipđ ayx Jix-Tuz munh.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Yămz wax đomc noib, naih ah đomc tâuc wac munh tăng Yê-lu-sa-lem nzac taih tauv wa An-ti-ôkx. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Stiz wax peob naih ah lanh bux hipđ ayx A-ga-batc, stâuđ quef âyz Singx-Lingh tâuc wac coong, cayx naih ah dlapc nyâuđ sab lub yămz pong nây guungh đi. Nâyx huungđ dlayc senz tuz setb taih toix Ca-lau-đi-atc cun wax nzêuh. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Tăng wa stayb sây buz songđ muif lanh, phanv yămz stiz wa mănv naih buc laiv, yâuc pungx buc wa, stiz tingc săngh goopx nyanh nongc nzâyz ninyh stăngc phunz yămz wa Yu-đê stâyz phangz wax đomc yâuf pez, <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />stiz năngđ nây goopx nyanh tuz, songđ phunz Ba-na-batc cloon Sau-lô nzâyz ninyh, phunz tauv wax đomc jiux pangx nyăngz munh côx.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Wax zanyf, yămz wax dlapc, Hê-lôtx huungh quef coonz ayx đokc hoiđ ah đomc jiux pangx nyăngz munh. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Wax zanyf, nănh nongc nzuc đao tayx Ya-coopc, Yô-hanx nyăngz tah. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Tăng wa, phătc nâyx đomc dlayc hoopđ Yu-tai munh nyăngz nyâuđ, nănh zef ninyh zoz Pi-tê lauf clăngđ (nâyx đomc dlayc setb taih yâuc toix Nzu Max Ănz Piny nyăngz stêtz), <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />nănh zoz Pi-tê clăngđ ănz nzauh, phunz pyâyz peob peengz jămđ leđ nănh, cayx ta zu tauv blătc Pyenv Mengc Stêtz mănc ênz nănh taih tongx songx stămđ. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Năngđ nâyx, Pi-tê hănđ zuc clăngđ ănz wa nzauh, six yâuc naih jiux pangx munh nzac jab huungv staox Zâu Tênb-Huungh ninyh, cloo Zâu phunz nănh. <verse eid="ACT 12:5" /><verse number="6" style="v" sid="ACT 12:6" />Wax zanyf, toix Hê-lôtx cayx ta ênz nănh setb taih stămđ, cah đangc wax munf, Pi-tê jinh đangh phâyx yămz iz lanh peengz mungh tongx congv, zuc iz stinz njab langb stayb, yâuc naih wax đomc jămđ nzauh peengz, yămz wa nzauh jeengh cah đangc jămđ nzauh. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Phanv mangc, naih ah tauh Zâu nyăngz stinz munh taih stâuđ nănh wa cah sinh, gwăngz eeng pong nzuf wax nomz nzauh njaf. Wax zanyf stinz munh beb Pi-tê wa lah tam, êu nănh điub, bux coong: “Coonx nyoongz quef gôh,” nzof wax đomc njab langb, songđ setc gâyh nănh nyăngz puf nzuf. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Wax zanyf, stinz munh coong ănz nănh: “Stayb quav langb bix tapc mâyh nyăngz stub buyx gôh.” Tăng wa, nănh songđ âyz ayx. Stinz munh zef coong ănz nănh: “Zuz mâyh cungh ngwaic byenđ guyz bix lêpc yaz ninyh gôh.” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Nănh lêpc stinz munh setb cungh ngwaic ninyh, six Pi-tê max pâyz coong stinz munh ayx nyăngz cumh pâuz six senz nyăngz, wâyc nănh cungb nyâyh coong nănh phătc hinđ yangh nyăngz jau. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Stiz ninyh pitb wax đomc jămđ nzauh peengz, zetx tab, tauv nyâyc tab, zef ninyh tauv nzac dlanyh wax tauh jab jeengh, jeengh yâuc cănh coib phunz stiz. Setb cungh ngwaic ninyh, stiz yăngh jămc ah stinz jau, stinz munh songđ taux wa gâyh nănh. <verse eid="ACT 12:10" /><verse number="11" style="v" sid="ACT 12:11" />Pi-tê songđ điub taih, yâuc coong: “Nâyx zanyf, yaz songđ senz pâyz coong, Zâu paiđ Nănh nyăngz stinz munh taih, nongc njâuv yaz gâyh đutb Hê-lôtx nyăngz puf đi, cloon Yu-tai munh oix hoiđ yaz wax đomc muif huungđ dlayc.” <verse eid="ACT 12:11" /><verse number="12" style="v" sid="ACT 12:12" />Wax zanyf, nănh pâyz tuz năngđ nâyx, nănh songđ ninyh Yô-hanx hipđ ayx Ma-cô nyăngz nzif, Ma-li-ya nyăngz pyau, yămz wa naih đuungx lanh zen Zâu nyăngz munh jinh đangh căpx dlonf cloo Zâu. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Nănh nzoz wa cungh ngwaic wax tungđ jeengh, naih ah lanh sab pâuz, bux hipđ ayx Lô-đa, taih tauz wac. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Wâyc saz tuz Pi-tê nyăngz wac stingb, yâuc wâyc numđ nyađ, nănh max săngx tauv coib jeengh, zef tiuv muf wa pyau njaf, bux coong: “Pi-tê jinh đangh stâuđ yămz wa jeengh cah đangc.” <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Six stiz coong ănz wax tauh sab coong: “Mâyh max sting lêc stah.” Six nănh njinh luh coong senz naih nef. Tăng wa, stiz coong: “Ha six Pi-tê nyăngz stinz munh lêc.” <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />Six Pi-tê yâuc njinh luh nzoz wa jeengh, tauv stiz ninyh coib jeengh phătc Pi-tê, songđ numđ nyâyh ganc. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Wax zanyf, nănh hangb puf êu stiz gâyf nyaoc, nănh songđ lănv tauv Zâu ênz nănh setb nzauh taih ayx năngđ laix. Nănh yâuc bux stiz coong: “Oix zuc lănv nâyx đomc dlayc phunz Ya-coopc cloon wax đomc yâuf pez.” Nănh songđ setb, quaix pitc nomz tinc ninyh. <verse eid="ACT 12:17" /><verse number="18" style="v" sid="ACT 12:18" />Tăng wa, tauv guungh gwăngz, wax đomc jămđ nzauh peengz songđ naih lunc max jenz, wâyc max pâyz Pi-tê quaix laiv ninyh. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Hê-lôtx songđ êu stiz năngx cayb lov Pi-tê, six lov max pongh, nănh zah naic wax đomc peengz tuz songđ setb lanyf tayx stiz. Nănh yâuc tăng Yu-đê stâyz phangz nzac wa Si-sa-li-ya dlanyh muf, songđ yămz wa.<verse eid="ACT 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Wax zanyf, Hê-lôtx huungh jinh đangh hănđ Tai-lapx munh cloon Sai-đoon munh. Tăng wa, stiz songđ tinyh ênz ninyh pongh Hê-lôtx, stiz hox Ba-la-sa-tat, nănh six Hê-lôtx huungh nyăngz stinb sinh quanz, stiz taih joođ coong hoopđ, wâyc zuc stiz nyăngz stâyz phangz, six păngc tăng Hê-lôtx huungh, stâyz phangz nyăngz nhlinc hopb. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />Tauv beengc stiz cănđ taih nyăngz noib, Hê-lôtx songđ zuz huungh guyz, taih stâyv wa huungh tinc, yămz stiz cah đangc coong wac. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Songx munh songđ hamv stingb lub coong: “Lâyc six ah tauh stinz nyăngz wac max zâyf bamh munh nyăngz wac!” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Songđ lênh dlih naih ah tauh Zâu nyăngz stinz munh bopc nănh, wâyc zuc nănh max stungx gwăngz eeng phunz Zâu Tênb-Huungh, nănh songđ zuc jeengz zâuz, bix siv setc.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Six Zâu Tênb-Huungh nyăngz Cuđ Jenx, yâuc tuz nzônh ninyh cun ayx cun quăng.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Tăng wa, Ba-na-batc cloon Sau-lô lauf tauv Yê-lu-sa-lem, stiz ayx soongb stiz nyăngz cumh pâuz, songđ ênz cloon Yô-hanx hipđ ayx Ma-cô wax tauh ninyh.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Wax zanyf yămz wa An-ti-ôkx nyăngz jiux pangx, naih wax đomc tâuc wac munh, cloon nzaox gâyf nyăngz munh: Naih Ba-na-batc, cloon Si-mê-ôn yâuc hipđ ayx Ni-gê, cloon Lu-si-atc Sai-lin munh; cloon Ma-na-ên, nănh six Hê-lôtx huungh nyăngz yâuf hoonb, cloon Sau-lô. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Wax zanyf, stiz jinh đangh njif nhlinc yâuc canyx bongc Zâu, six Zâu Singx-Lingh songđ coong: “Oix zuc lanyc Ba-na-batc cloon Sau-lô phunz Yaz, wâyc yaz sên stiz taih nongc ayx cumh pâuz.” <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Tăng wa stiz njif nhlinc, cloo Zâu yâuc tăpx puf ănz stiz wa iz lanh, songđ phunz stiz ninyh.<verse eid="ACT 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Wâyc tuz tăng Zâu Singx-Lingh paiđ ninyh, stiz iz lanh songđ ninyh tauv wa Sê-lu-cê, yâuc tăng wa yămz đangđ ninyh tauv wa Sai-batc coiđ njeengh. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Ninyh tauv wa Sa-la-mit dlanyh wax zanyf, stiz yămz wax đomc Yu-tai munh nyăngz huyđ toongh nzaox Zâu Tênb-Huungh nyăngz gâyf. Stiz yâuc tuz Yô-hanx ninyh stăngc stiz. <verse eid="ACT 13:5" /><verse number="6" style="v" sid="ACT 13:6" />Tăng wa, stiz clăngv blătc wax coiđ njeengh yâuc ninyh tauv wa Ba-phôt dlanyh, stiz pongh ah lanh Yu-tai munh, ayx papz munh, yâuc ayx za tâuc wac munh, nănh nyăngz bux hipđ ayx Ba-yê-su, <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />nâyx tauh munh six cloon ayx quanz cun wa coiđ njeengh wax tauh Sê-ji-atc Phau-lô yămz — nănh six ah lanh munh lemđ. Nănh êu Ba-na-batc cloon Sau-lô taih, wâyc nâyx tauh quanz oix mungv Zâu Tênb-Huungh nyăngz gâyf. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Six “nâyx tauh ayx papz munh” Ê-li-mat (nănh nyăngz bux phanv taih six coong nâyx), nzeengz cloon nănh stiz, lov jau tăng max phunz wax tauh quanz zen. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Six Sau-lô yâuc hipđ ayx Phao-lô, tuz Zâu Singx-Lingh pong nyâuđ, songđ njinh luh mangc nzac wax tauh munh ninyh, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />yâuc coong: “Mâyh lâyc tauh naih pong nzuf muif huungđ jaf munh nyăngz jau, cloon muif huungđ njangh okx, manđ nyăngz sây lex, nzeengz cloon peengh stimz nyăngz jau, mâyh cungb oix njinh luh sêu lunc Zâu nyăngz jau zac mah? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Nâyx zanyf, phanv mangc bex, Zâu nyăngz puf nzeengz cloon mâyh, mâyh six zuc mâyc buđ, max phătc bah noib ah dlapc.” Tăng wa, nănh songđ toongx sangf mâyc nzămc meengh max phătc jau, nănh pađ nây pađ wa lov munh jinb nănh. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Wax zanyf, wax tauh quanz phătc nâyx đomc dlayc setb taih, songđ zen, yâuc numđ nyâyh ganc tauv Zâu nyăngz gâyf.<verse eid="ACT 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Phao-lô cloon nănh wax đomc toic, tăng wa Ba-phôt nzac đangđ ninyh, staox wa Bê-ga dlanyh muf Băm-phi-li stâyz phangz. Six Yô-hanx gâyh stiz phunb đangz muf wa Yê-lu-sa-lem. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Six Phao-lô buz tauv setb wa Bê-ga dlanyh, songđ yăngh jau ninyh wa An-ti-ôkx Bi-si-đi stâyz phangz, toix tingc congz noib, stiz songđ nzac huyđ toongh ninyh, stâyv wa. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Munh toc gâyf njanh cloon wax đomc tâuc wac munh nyăngz stâub tuz, wax đomc cun huyđ toongh nyăngz munh êu munh taih pongh Phao-lô buz, yâuc coong: “Yâuf pez lex, năngđ coong naih laiv zâux wac, nongc oonz songx munh nyăngz nyâuđ, joođ nyâuh coong gôh.” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />Phao-lô songđ nyoongz quef, hangb puf ayx njic hoouđ yâuc coong:</para>
  <para style="p" vid="ACT 13:16">“Yetx stong I-sa-la-ên munh, senz cumh nzav Zâu Tênb-Huungh nyăngz munh lex, joođ nyâuh mungv. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />I-sa-la-ên munh nyăngz nâyx tauh Zâu Tênb-Huungh, sên pănh nyăngz claof jex, phunz stiz tuz phutx hongđ taih, yămz wa I-yipx stâyz phangz nyăngz săngx huđ, Nănh nongc tômx jab nyăngz puf, yenv stiz setb wa I-yipx stâyz phangz. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Yămz wa stâyz phangz blănf cox stâyx săpc nyăngv cah njaf, Nănh yâuc ayx nyâuđ đao nênf stiz. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Nănh mêtc nzuf wa Ca-na-an stâyz phangz wax đomc nhlic huungđ munh, yâuc zoz stiz wax đomc stâyz phangz jaoz phunz I-sa-la-ên munh stipx, <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />cox stâyx pez ngâuf săpc nyăngv cah đangz. Nănh songđ njăpc wax đomc cun dlayc munh phunz stiz, ayx tuz tauv tâuc wac munh Sa-mu-ên wax nzêuh. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Tăng wa staox ninyh, pec stingx songđ joođ ah tauh huungh phunz stiz, Zâu Tênb-Huungh songđ njăpc Sau-lô Cit nyăngz toonz, ah lanh yămz Bên-ya-min stingx, cun stiz stâyx săpc nyăngv cah njaf. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Nzof tauv tutb wax tauh munh, Zâu Tênb-Huungh zef njăpc Đa-witx taih ayx huungh cun stiz, yâuc ayx zanyx manyf coong tauv nănh, coong: ‘Yaz lov phătc Jêtc-si nyăngz toonz, Đa-witx, nănh hoopđ Yaz nyăngz nyâuđ, nănh six âyz nzuf Yaz nyăngz zux ix ayx.’ <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />Tăng nâyx tauh huungh nyăngz sây stunz, âyz Zâu Tênb-Huungh nyunc nyăngz wac, Nănh songđ sađ phunz I-sa-la-ên munh, ah tauh Njâuv Zâu, six Zâu Yê-su, <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />tăng Zâu Yê-su max zeengx ayx cumh pâuz, Yô-hanx taih nzônh gâyf quaix đangc, phunz yetx stong I-sa-la-ên munh, coong tauv nhlimc stoif nyăngz jau, yâuc ayx quaix-gâyf. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Wax zanyf, Yô-hanx ayx soongb nănh nyăngz cumh pâuz, nănh yâuc coong: ‘Nyâuh nyâyh yaz six mănv? Yaz max zâyf nyâuh nyâyh wax tauh đêh. Six, phanv mangc, taih đangz yaz wax Tauh, Nănh six ah Tauh yaz lôx max payh tuz stăngc Nănh zay stub buyx langb.’<verse eid="ACT 13:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="ACT 13:26" />Yetx stong yâuf pez lex, Apx-la-ham nyăngz sây stunz, cloon yămz nyâuh nyăngz mungh tongx cumh nzav Zâu Tênb-Huungh nyăngz munh, nâyx huungđ njâuv pôz nyăngz gâyf six tuz sađ taih phunz pănh. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Wâyc yămz wa Yê-lu-sa-lem nyăngz munh, cloon stiz wax đomc ayx côx nyăngz munh, max saz tuz Nănh, stiz songđ tingc Nănh, ayx phunz setb taih toix nzuf, năngđ yămz muif nomz tingc congz noib, bix tuz toc wax đomc tâuc wac munh, tâuc taih nyăngz wac. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Hănđ max lov tuz laiv stinz jau nongc tayx Nănh, stiz yâuc joođ Phi-latx êu phunz Nănh zuc tayx tayc. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Wax zanyf, stiz ayx tuz săngh nzuf, ja coong tauv Nănh wax đomc jau, stiz songđ zoz Nănh setb wa săpc đăngc zax taih, nzâyz ninyh ănz ah nomz stâu. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Six Zâu Tênb-Huungh ayx phunz Nănh tăng tayc săngh taih, <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />tăng Ga-li-lê lêpc Nănh ninyh, tauv wa Yê-lu-sa-lem wax đomc munh, tuz phătc Nănh đuungx noib, wax đomc munh nâyx zanyf yâuc ayx zanyx manyf, coong tauv Nănh phunz songx munh. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Buz six nzônh Cuđ Jenx phunz nyâuh, âyz năngđ tuz nyunc taih phunz pănh nyăngz claof jex nâyx, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />coong Zâu Tênb-Huungh ayx phunz Zâu Yê-su săngh taih, six ayx phunz săngh nzuf wax đomc wac phunz pănh, senz săngh claof jex nyăngz sây stunz wax đomc. Lauf cayx năngđ tuz ja yămz nzungz đăngb tah nyâyc, coong:</para>
  <para style="q1" vid="ACT 13:33">‘Mâyh six Yaz nyăngz Toonz, nâyx yenh Yaz steengb Mâyh taih.’<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Wâyc nây, Nănh ayx phunz Zâu Yê-su tăng tayc săngh taih, yâuc max naih coong năngx zuc yootz nzof, năngđ nây Nănh songđ coong:</para>
  <para style="q1" vid="ACT 13:34">‘Yaz nyunc cloon Đa-witx wax đomc đăngb zeengh pôz, Yaz six sađ phunz nyâuh, six senz nyăngz pôz.’<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Lauf wâyc nâyx, Nănh zef coong yămz pitc đoif nzungz đăngb coong:</para>
  <para style="q1" vid="ACT 13:35">‘Mâyh six max phunz Mâyh wax Tauh đăngb zeengh munh zuc yootz.’<verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />Nzof Đa-witx yămz nănh năngx săngh nyăngz săngx huđ, âyz Zâu Tênb-Huungh nyăngz zux ix ayx tuz, nănh songđ quaix stâyv, yâuc tuz plopx cloon nănh nyăngz claof jex, yâuc yootz. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Six Zâu Tênb-Huungh ayx phunz săngh taih wax Tauh six max yootz.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />Wâyc nây, yâuf pez lex, nyâuh oix zuc pâyz coong, păngc Nănh, bix tuz nzônh tauv nây quanyf stoif nyăngz jau phunz nyâuh, yâuc păngc nây bix tuz gâyh đutb muif huungđ, wâyc zuc pănh max hayh cănh ayx âyz Mô-sê nyăngz gâyf njanh, bix tuz stunx ayx peengh stimz. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Păngc yămz Nănh, bix tinyh phanv laiv lanh zen yâuc tuz stunz ayx peengh stimz. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Năngđ nây, oix zuc năngx cayb bôngh, săngx đanyf yămz tâuc wac munh nyăngz stâub, coong taih wax đomc wac, hayh tuz setb taih toix zuc nyâuh, coong:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />‘Nyâuh đomc hib munh nyăngz munh lex, oix zuc mangc, yâuc numđ cumh nzav, yâuc zuc mêtc ninyh!</para>
  <para style="q1" vid="ACT 13:41">Wâyc yămz nyâuh wax nzêuh, Yaz six ayx ah huungđ cumh pâuz setb taih,</para>
  <para style="q1" vid="ACT 13:41">nâyx huungđ cumh pâuz nyâuh six max zen, hănđ six naih munh lănv bux ănz nyâuh.’”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Tauv stiz iz lanh setb ninyh, songx munh songđ joođ êu stiz nzaox wax đomc wac, yămz cah đangz nomz tingc congz noib phunz stiz timb. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Tăng wa, tauv munh tinyh đoih đanv, naih đuungx lanh Yu-tai munh, cloon lêpc Yu-tai munh nyăngz gâyf wax đomc munh, taih lêpc Phao-lô cloon Ba-na-batc, stiz iz lanh cloon stiz coong wac, yâuc quinb êu stiz nzac jab stâuđ tăngđ yămz Zâu Tênb-Huungh nyăngz pôz.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Tauv tah nyâyc nomz tingc congz noib, lomc wa dlanyh nyăngz munh taih căpx dlonf nongc mungv Zâu nyăngz gâyf. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Six wâyc phătc munh đuungx, wax đomc Yu-tai munh songđ numđ hănđ, yâuc nzeengz Phao-lô coong nyăngz wac, yâuc pib mađ nănh. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Phao-lô cloon Ba-na-batc pungx stimz nzongf, songđ tauz coong: “Wâyc zuc Zâu Tênb-Huungh nyăngz gâyf six oix zuc nzônh phunz nyâuh đangc. Six nyâuh pyenv max stipx nây Cuđ Jenx, yâuc cănh ayx phunz nyâuh max payh tuz stipx stâyv quâyx nyăngz mengc, wâyc nây phanv mangc, buz six ninyh nzônh phunz pitc stingx munh. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Wâyc Zâu coong bux buz năngđ nâyx:</para>
  <para style="q1" vid="ACT 13:47">‘Yaz sên mâyh taih nongc ayx gwăngz phunz pitc stingx munh,</para>
  <para style="q1" vid="ACT 13:47">phunz mâyh săngh wâyc nzâyz njâuv pôz ninyh zomc guungh đi.’”<verse eid="ACT 13:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="ACT 13:48" />Wax đomc pitc stingx munh numđ nâyx đomc wac songđ numđ nyađ, yâuc tanv Zâu nyăngz gâyf, nzof wax đomc tingc săngh tuz stâyv quâyx nyăngz mengc wax đomc munh, yâuc tinyh đoih zen. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />Tăng wa Zâu nyăngz gâyf tuz nzônh pong wax nomz stâyz phangz. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Six Yu-tai munh lungz lêpc gongx Zâu Tênb-Huungh naih minb mâyc njăngb wax đomc munh nzif, cloon wa dlanyh wax đomc ayx coonz munh, taih ayx huđ nzeengz Phao-lô cloon Ba-na-batc, stiz luiđ Phao-lô buz setb stiz nyăngz căpx caix ninyh. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Wax zanyf, Phao-lô buz phătb staux đi nyăngz nib buungb, nongc nzeengz cloon wax đomc munh, stiz iz lanh songđ ninyh wa I-cô-ni-yum dlanyh. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Nzof wax đomc zen Zâu nyăngz munh, songđ numđ nyađ nzongf, yâuc tuz Zâu Singx-Lingh pong nyâuđ.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Yămz wa I-cô-ni-yum dlanyh stiz tinyh đoih nzac Yu-tai munh nyăngz huyđ toongh ninyh nzaox gâyf, yâuc tuz đuungx lanh njinh Yu-tai munh cloon Hi-lapc munh zen. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Six max zen wax đomc Yu-tai munh, songđ taih lungz wax đomc pitc stingx munh nyăngz nyâuđ, phunz stiz ayx huđ nzeengz cloon wax đomc yâuf pez. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Wâyc nây, stiz yămz wa ah dlapc lauh, yâuc pungx stimz nzaox Zâu nyăngz gâyf, Zâu yâuc ayx phunz jix caox njingc cloon njic hoouđ tăng stiz nyăngz puf setb taih, nongc ayx zanyx manyf phunz Nănh njâuv pôz nyăngz gâyf. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Six yămz wa dlanyh cah njaf nyăngz munh songđ naih phunz goib, ah phanx six lêpc Yu-tai munh, nzof ah phanx six lêpc wax đomc cumh pâuz munh. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />Six wax zanyf, wax đomc pitc stingx munh cloon Yu-tai munh cloon stiz wax đomc ayx côx munh tinyh đoih cayx ninyh ayx huđ, yâuc zoz njăuz ôx stiz wa iz lanh, <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />six stiz pâyz nâyx đomc dlayc, songđ tiuv quaix wa Li-ca-ô-ni, cloon Li-sa-ta, cloon Đê-bi, wax đomc dlanyh muf, cloon quib wa wax đomc stâyz phangz, <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />stiz yâuc yămz wa nzônh Cuđ Jenx.<verse eid="ACT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Yămz wa Li-sa-ta dlanyh, naih ah lanh munh quac stâyv wa, nănh iz saz staux quac tăng năngx jinh yămz nzif nyăngz nyâuđ njaf, nănh max naih laiv zanyf hayh yăngh. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Nănh stâyv wa mungv Phao-lô nzaox gâyf, Phao-lô mangc nzac nănh ninyh songđ phătc nănh naih zen stimz nongc zany tuz gongx. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />Phao-lô songđ hamv stingb lub coong: “Mâyh nyoongz quef stâuđ staux năngx zac gôh,” nănh songđ nzeengc nyoongz quef yâuc hayh yăngh. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Six songx munh phătc Phao-lô ayx nyăngz cumh pâuz, stiz songđ nongc stiz nyăngz Li-ca-ô-ni stâyz phangz wac hamv coong: “Wax đomc miuc manđ wav săngh bamh munh nzac taih pongh pănh.” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Stiz hipđ Ba-na-batc ayx “sut manđ,” nzof Phao-lô six hipđ ayx “Hê-mêt manđ,” wâyc Phao-lô six nzaox gâyf munh. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Wax zanyf, Sut manđ nyăngz miuc pyau yămz wa dlanyh cah đangc, Sut manđ nyăngz stayb munh ênz ngoongh wăngh cloon phăngh taih wa dlanyh jeengh, cayx ta căn songx munh congx stanyb lanyh phunz. <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />Six wa iz lanh cumh pâuz munh, Ba-na-batc cloon Phao-lô numđ wax đomc wac songđ zeb stiz nyăngz guyz, stiz nzac wa songx munh hongđ mungh tongx ninyh, hamv lub <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />coong: “Nyâuh săngh laix bix ayx nâyx heh? Buz six lauf munh cayx năngđ nyâuh nâyx lêc, buz jinh đangh nzônh Cuđ Jenx phunz nyâuh, êu nyâuh quanyf nâyx đomc max setb luungđ nyăngz jau, bix lêpc stâyv quâyx săngh nyăngz Zâu Tênb-Huungh, senz zuyx guungh, zuyx nib, zuyx coiđ cloon muif huungđ yămz wa wax Tauh, <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />senz tăng cah đangc pâyz sax stâyv quaix taih, Zâu Tênb-Huungh dluyh phunz muif stingx munh, cănh ninyh âyz stiz nyăngz stimz nyâuđ ayx, <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Hănđ nâyx Nănh yâuc cănh njinh luh ayx zanyx manyf phunz Nănh, năngx sađ pôz phunz nyâuh ayx bungc tăng guungh nzac taih yuungf jeengz zunb, phunz nyâuh tuz naih nhlinc yâuc numđ nyađ.” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Stiz coong tuz nâyx đomc wac, songđ cungb cangđ tuz songx munh max stungx stanyb lanyh phunz stiz.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Six tăng An-ti-ôkx dlanyh cloon I-cô-ni-yum dlanyh taih wax đomc Yu-tai munh, stiz hox songx munh zoz njăuz ôx Phao-lô, stiz taib nănh quaix wa dlanyh cungh ngwaic ninyh, wâyc stăngz coong nănh tayc nzof. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Six wax đomc zen nyăngz munh taih quib nănh, nănh songđ nyoongz quef, nzac wa dlanyh cah njaf muf, tauv nyâyc noib, nănh cloon Ba-na-batc ninyh wa Đê-bi dlanyh. <verse eid="ACT 14:20" /><verse number="21" style="v" sid="ACT 14:21" />Yâuc yămz wa dlanyh nzônh Cuđ Jenx tuz đuungx lanh munh lêpc Zâu, stiz songđ phunb đangz lauf wa Li-sa-ta, zef tauv I-cô-ni-yum, cloon An-ti-ôkx, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />nzac jab oonz nyâuđ phunz wax đomc lêpc Zâu nyăngz munh, bux êu stiz cayb zen Zâu năngx tăngđ, coong: “Pănh six zuc pongh đuungx huungđ zâuđ nanc nzăngđ tuz nzac Zâu Tênb-Huungh nyăngz côkz.” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Tăng wa, stiz oonz jiux pangx nyăngz munh côx phunz stiz, yămz muif nomz jiux pangx, njif nhlinc cloo Zâu tuz, stiz iz lanh songđ jaoz wax đomc munh phunz Zâu, senz stiz nongc nyâuđ zen wax Tauh Zâu. <verse eid="ACT 14:23" /><verse number="24" style="v" sid="ACT 14:24" />Stiz songđ clăngv quaix wa Bi-si-đi stâyz phangz muf tauv Băm-phi-li stâyz phangz. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Stiz yămz wa Bê-ga dlanyh nzaox gâyf tuz, songđ nzac wa Atc-ta-li-ya muf. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Tăng wax nomz tinc, stiz nzac đangđ muf tauv An-ti-ôkx, nây six stiz tuz jaoz phunz Zâu Tênb-Huungh nyăngz pôz, nongc setb ninyh ayx stiz ah yac ayx soongb wax đomc cumh pâuz. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Wax zanyf lauf tauv tinc, stiz songđ êu jiux pangx munh taih căpx dlonf, stiz lănv nzuf Zâu Tênb-Huungh cloon stiz ayx wax đomc cumh pâuz, yâuc coong Zâu Tênb-Huungh coib nyâuđ phunz wax đomc pitc stingx munh zen Zâu. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Tăng wa, stiz cloon wax đomc stayb sây buz yămz ah lapc batz lauh.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Naih ah đomc munh tăng wa Yu-đê taih nzaox wax đomc yâuf pez coong: “Năngđ coong nyâuh max âyz Mô-sê nyăngz gâyf ayx quaix catz, nyâuh six max hayh tuz njâuv.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Tăng wa Phao-lô cloon Ba-na-batc songđ cloon wax đomc munh max tinyh hoođ yâuc naih tinyh zenđ setb taih max jenz, wâyc nây, wax đomc yâuf pez songđ paiđ Phao-lô cloon Ba-na-batc cloon stiz wa ah đomc munh timb, ninyh wa Yê-lu-sa-lem, pongh wax đomc cumh pâuz munh, cloon jiux pangx nyăngz munh côx, wâyc nâyx cuyb tinyh zenđ nyăngz jau. <verse eid="ACT 15:2" /><verse number="3" style="v" sid="ACT 15:3" />Năngđ nâyx, tuz jiux pangx paiđ ninyh wax đomc munh, stiz clăngv quaix wa Phi-ni-si cloon Sa-ma-đi stâyz phangz ninyh, năngx cayb bux phunz wax đomc pitc stingx munh pâyz năngx yox, tauv zen Zâu nyăngz jau, stiz songđ ayx phunz wax đomc yâuf pez muif lanh tuz numđ nyađ nzongf. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Ninyh tauv wa Yê-lu-sa-lem wax zanyf, stiz yâuc tuz wax đomc jiux pangx nyăngz munh stipx, six wax đomc cumh pâuz munh cloon jiux pangx nyăngz munh côx, stiz songđ lănv nzuf Zâu Tênb-Huungh cloon stiz songc ayx wax đomc cumh pâuz nyăngz jau. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Six naih ah đomc Pha-li-si wax huungđ munh zen Zâu, songđ stâuđ quef coong: “Zuc ayx quaix catz phunz wax đomc munh yâuc nzaox êu stiz âyz Mô-sê nyăngz gâyf njanh ayx.” <verse eid="ACT 15:5" /><verse number="6" style="v" sid="ACT 15:6" />Tăng wa, wax đomc cumh pâuz munh cloon jiux pangx nyăngz munh côx, songđ căpx dlonf nongc sangv tauv nâyx đomc jau. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Wax zanyf naih tinyh zenđ đuungx setb taih, Pi-tê songđ stâuđ quef coong ănz stiz:</para>
  <para style="p" vid="ACT 15:7">“Yâuf pez lex, nyâuh lauf tinyh đoih pâyz coong tăng ah yac yămz nyâuh cah njaf, Zâu Tênb-Huungh sên pitc stingx munh taih zen, six wâyc tuz mungv tăng yaz nyăngz nzetx nzônh nyăngz Cuđ Jenx. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Zâu Tênb-Huungh six pâyz nzuf munh nyăngz nyâuđ wax Tauh, yâuc cănh ayx zanyx manyf phunz stiz, songđ sađ Zâu Singx-Lingh phunz stiz, lauf cayx năngđ phunz pănh nâyx; <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Zâu Tênb-Huungh yâuc max stunx pănh cloon stiz six cănh pitc huungđ, yâuc ayx phunz stiz nyăngz nyâuđ păngc zen stimz bix tuz dlăngc. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Năngđ nâyx, săngh laix nâyx zanyf nyâuh bix năngx stâyv Zâu Tênb-Huungh, bix năngx zoz nâyx nomz bănx tanz păngv ănz zen Zâu munh nyăngz clangz, pănh nyăngz claof jex lôx max nzâyz tuz, nzof pănh yâuc cănh max nzâyz tuz quef? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Pănh six zen nzăngđ tuz njâuv wâyc Zâu Yê-su nyăngz pôz, nzof stiz lauf năngđ nâyx.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Wax zanyf, songx munh songđ tinyh đoih stinyb njâuh mungv Ba-na-batc cloon Phao-lô lănv nzuf Zâu Tênb-Huungh nongc stiz ayx wax đomc jix caox njingc cloon njic hoouđ yămz wax đomc pitc stingx munh cah njaf. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Tauv stiz coong tuz, Ya-coopc songđ stipx stiz nyăngz wac tauh, coong:</para>
  <para style="p" vid="ACT 15:13">“Yetx stong yâuf pez lex joođ mungv yaz. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Si-môn lănv zetx hâyđ nănh coong ayx laix heh, Zâu Tênb-Huungh hâuđ lênh wax đomc pitc stingx munh, songđ sên ah đomc taih phunz Nănh nyăngz manyh. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Nâyx đomc six lauf hoopđ cloon tâuc wac munh ja taih nyăngz wac, coong:<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />‘Blătc nâyx đomc dlayc, Yaz six năngx taih,</para>
  <para style="q1" vid="ACT 15:16">Yaz songđ zâyv Đa-witx nyăngz njiuh, six zuc lakb wax nomz njiuh,</para>
  <para style="q1" vid="ACT 15:16">Yaz six zâyv nănh zuc zeb lakb wax đomc, yâuc ayx nănh năngx săngh,<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />phunz năngx yăngc nzac wax đomc munh six tuz lov Zâu,</para>
  <para style="q1" vid="ACT 15:17">njinh cloon wax đomc yetx stong pitc stingx munh, nzof yămz wax đomc pec stingx yâuc tuz Yaz nyăngz manyh sên stiz taih.</para>
  <para style="q1" vid="ACT 15:17">Zâu senz ayx nâyx đomc cumh pâuz wax Tauh coong năngđ nâyx, <verse eid="ACT 15:17" /><verse number="18" style="v" sid="ACT 15:18" />six tăng lôx noib tuz pâyz quaix đangc nyăngz jau.’<verse eid="ACT 15:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ACT 15:19" />Wâyc nây, yaz nyâyh taih năngx gâyf loou phunz wax đomc pitc stingx munh phunb đangz lauf zen Zâu Tênb-Huungh wax đomc nyăngz nyâuđ lunc, <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />six oix zuc ja jenx bux êu stiz njif năngx gâyf nhlinc, congx quaix miuc hanyh naih wâyx nyăngz tax huungđ, cloon pongz lauh nyăngz jau, cloon siv stoc tayc nyăngz stanyb hauđ a, cloon samđ. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Wâyc tăng lôx noib quaix taih, yămz muif nomz dlanyh, lauf tuz naih munh đuungx nzaox Mô-sê nyăngz gâyf njanh, nzof yămz muif nomz tingc congz noib, wax đomc gâyf yâuc tuz toc yămz wa huyđ toongh.”<verse eid="ACT 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Tăng wa, wax đomc cumh pâuz munh cloon jiux pangx nyăngz munh côx, cloon jiux pangx munh, numđ sămv zuc paiđ yămz stiz wa ah đomc munh lêpc Phao-lô cloon Ba-na-batc ninyh tauv wa An-ti-ôkx — stiz sên Yu-đa yâuc hipđ ayx Ba-săp-batc, cloon Si-la, stiz iz lanh six ayx pyây yămz wax đomc yâuf pez — <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />songđ ja jenx jaoz phunz stiz nzâyz ninyh, coong: “Buz, six wax đomc cumh pâuz munh cloon jiux pangx nyăngz munh côx, cloon wax đomc yâuf pez, pungx phunz zen Zâu nyăngz munh yămz nzêux wa An-ti-ôkx stâyz phangz, cloon Si-đi, cloon Si-li-si, senz zen Zâu nyăngz yâuf pez, six pitc stingx munh wax đomc. Buz numđ nyađ nyâuh nzongf! <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />Wâyc buz tuz numđ coong, naih ah phanx munh tăng buz nây ninyh loou nyâuh coong nây coong wa ănz nyâuh, ayx phunz nyâuh nyăngz nyâuđ lunc, wax đomc munh six max zâyf tăng buz paiđ ninyh, <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />wâyc nây, buz songđ tinyh đoih songc ah nomz stimz nyâuđ sên ah đomc munh tayv buz, paiđ stiz lêpc Ba-na-batc cloon Phao-lô ninyh pongh nyâuh, senz pănh stăngz nyăngz wa iz lanh yâuf pez, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />stiz iz lanh six max zâuh cănh nyăngz mengc, wâyc pănh nyăngz Zâu Yê-su Jix-Tuz nyăngz manyh. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Năngđ nâyx, buz songđ paiđ Yu-đa cloon Si-la, stiz six nongc wac căn nyâuh coong nâyx đomc jau. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Wâyc zuc Zâu Singx-Lingh cloon buz, numđ max zâuđ năngx zuc pâu laiv huungđ zâuđ phunz nyâuh, cungb oix zuc âyz nâyx đomc cuungv: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />six oix zuc njif năngx gâyf nhlinc congx quaix miuc hanyh nyăngz tax huungđ, cloon samđ, cloon siv stoc tayc nyăngz stanyb hauđ a, cloon ayx pongz lauh nyăngz jau, nyâuh njif tuz nâyx đomc muif huungđ, nyâuh songđ tuz gongx gôh. Cloo phunz nyâuh hayh tuz zen tăngđ.”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Tăng wa, stiz songđ tuz paiđ ninyh tauv An-ti-ôkx, nzof tauv stiz êu jiux pangx munh taih căpx dlonf wax zanyf, songđ jaoz wax zây jenx phunz. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Stiz toc wax zây jenx tuz, wax đomc zen Zâu nyăngz munh songđ tuz numđ oonz nyâuđ yâuc numđ nyađ. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yu-đa cloon Si-la stiz six lauf tâuc wac munh, songđ coong wac đuungx oonz wax đomc yâuf pez nyăngz nyâuđ, phunz stiz tuz njoongh staox. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Wax zanyf, stiz yămz wa ah dlapc, stiz zef tuz wax đomc yâuf pez stungx stiz muf songđ tuz peengh oonz muf pongh paiđ stiz ninyh wax đomc munh. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />[Six Si-la numđ sămv zuc căn stiz yămz wa, Yu-đa songđ cănh ah lanh setb jau ninyh.] <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Năngx naih Phao-lô cloon Ba-na-batc six lauf yămz wa An-ti-ôkx, nzaox gâyf yâuc coong Zâu nyăngz wac, căn đuungx lanh munh timb.<verse eid="ACT 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Tăng wa, blătc batz noib cah đangz, Phao-lô coong ănz Ba-na-batc: “Pănh senz zef sămv zuc phunb đangz ninyh tayđ wax đomc yâuf pez, six pănh ninyh nzônh Zâu nyăngz wac wax đomc muif nomz dlanyh, mangc jađ stiz six săngh laiv ninyh.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Six Ba-na-batc yâuc oix ênz cloon Yô-hanx hipđ ayx Ma-cô wax tauh, lêpc stiz ninyh. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Six Phao-lô numđ max hoopđ zuc ênz wax tauh munh lêpc ninyh, nănh six tăng yămz wa Băm-phi-li bix gâyh stiz max cloon stiz ayx cumh pâuz. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Stiz songđ naih tinyh zenđ lub nzongf, ayx tuz stiz mănv ninyh mănv jau, Ba-na-batc songđ ênz Ma-cô lêpc nănh nzac đangđ ninyh wa Sai-batc. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Nzof Phao-lô six sên Si-la, tuz wax đomc yâuf pez jaoz stiz phunz Zâu nyăngz pôz, songđ setb jau ninyh. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Tăng wa, stiz ninyh nzêux Si-đi cloon Si-li-si, ayx phunz wax đomc jiux pangx zen tăngđ.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Phao-lô zef nzac wa Đê-bi cloon Li-sa-ta muf, nzof yămz wa yâuc naih ah lanh stayb sây bux hipđ ayx Ti-mô-tai, nănh nyăngz nzif six Yu-tai munh lêpc gongx Zâu, nzof pha six Hi-lapc munh, <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />yămz wa Li-sa-ta cloon I-cô-ni-yum nyăngz yâuf pez yâuc ayx zanyx manyf tanv nănh. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Phao-lô oix ênz Ti-mô-tai lêpc nănh ninyh, songđ stipx nănh, Phao-lô yâuc ayx quaix catz phunz nănh, wâyc yămz wax đomc tinc nyăngz Yu-tai munh stiz tinyh đoih pâyz coong, Ti-mô-tai nyăngz pha six Hi-lapc munh. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Stiz ninyh jau clăngv quaix wax đomc dlanyh, stiz songđ bux êu wax đomc zen Zâu nyăngz munh oix zuc âyz wax đomc cumh pâuz munh cloon jiux pangx nyăngz munh côx yămz wa Yê-lu-sa-lem njăpc taih wax đomc gâyf. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Năngđ nây, wax đomc jiux pangx songđ tuz njoongh taih naih zen stimz tăngđ, muif noib yâuc naih munh pâu nzac đuungx staox.<verse eid="ACT 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Stiz songđ clăngv quaix wa Pha-li-ji cloon Ga-la-ti stâyz phangz muf, wâyc zuc Zâu Singx-Lingh cangđ max phunz stiz yămz wa Ê-si steengv nzônh gâyf. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Tăng wa, stiz ninyh cayx tauv Mi-si stâyz phangz, stiz zef cayx nzac wa Bi-ti-ni stâyz phangz ninyh, six Zâu Yê-su nyăngz Singx-Lingh max phunz stiz ninyh. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Năngđ nây, stiz songđ max ninyh wa Mi-si stâyz phangz, stiz quaix wa Tô-atc muf. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Toix bah nzămc Phao-lô phătc hinđ yangh nyăngz jau: Phătc ah lanh Ma-si-đô-ni munh stâuđ wa, hamv êu nănh, coong: “Joođ quaix nây Ma-si-đô-ni lauf stăngc njâuv buz đôih.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Tăng wa, nănh phătc nâyx cuyb hinđ yangh nyăngz jau tuz, buz songđ lênh dlih lov jau quaix wa Ma-si-đô-ni muf, wâyc pâyz tuz coong Zâu Tênb-Huungh êu buz ninyh nzônh Cuđ Jenx phunz stiz.<verse eid="ACT 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Buz songđ tăng wa Tô-atc nzac đangđ, ninyh zac tauv wa Sa-mô-tat coiđ njeengh, nyâyc noib nzăngđ ninyh tauv wa Nê-a-bô-li, <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />tăng wax nomz tinc, ninyh tauv wa Phi-lipx-poi, nây six ah nomz dlanyh lub yămz wa Ma-si-đô-ni stâyz phangz, yâuc săngh Lô-ma côkz nyăngz ah nomz dlanyh, buz yâuc yămz nâyx nomz dlanyh batz noib. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Tauv tingc congz noib, buz songđ quaix wa dlanyh jeengh cungh ngwaic ninyh, yămz wa wăngx sinh, buz nyâyh coong wa six cloo Zâu nyăngz tinc. Buz songđ stâyv nzac, cloon căpx dlonf yămz wa, wax đomc munh nzif coong wac. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Naih ah lanh munh nzif bux hipđ ayx Li-đi, nănh six maic buyx stib laoh yămz Ti-ya-ti-la dlanyh, yâuc naih nyâuđ cumh nzav Zâu Tênb-Huungh, poc wa mungv, yâuc tuz Zâu coib nyâuđ phunz nănh năngx cayb mungv Phao-lô coong nyăngz wac. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Nănh songđ cloon nănh nyăngz pyau munh ayx quaix-gâyf, nănh yâuc ênz buz coong: “Năngđ coong nyâuh phătc yaz six lêpc gongx Zâu, joođ nyâuh muf yămz yaz nyăngz pyau.” Nănh yâuc njinh luh yac buz. <verse eid="ACT 16:15" /><verse number="16" style="v" sid="ACT 16:16" />Tăng wa, naih ah noib buz jinh đangh ninyh cloo Zâu, naih ah lanh sab pâuz zuc Phi-tôn manđ nzac yămz stinb, nănh six tex mengc phunz munh, yâuc ayx tuz gâyc đuungx nzongf phunz nănh nyăngz zâu, nănh pongh buz. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Yâuc ninyh lêpc Phao-lô cloon buz đangz, nănh hamv coong: “Nâyx đomc munh six yămz Njăngb Quaix wax Tauh Zâu Tênb-Huungh nyăngz pâuz, stiz six taih nzônh njâuv pôz nyăngz jau phunz nyâuh.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Nănh ayx nâyx tuz đuungx noib. Phao-lô numđ siv nhlenx songđ winb muf coong ănz wax tauh manđ coong: “Tim Zâu Yê-su Jix-Tuz nyăngz manyh, yaz zăpx mâyh setb gâyh nâyx tauh sab ninyh.” Manđ songđ toongx wax zanyf setb.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Six wax tauh sab nyăngz zâu phătc nănh stiz ayx steengb âyx nyăngz jau zomc, songđ ninyh toopz zoz Phao-lô cloon Si-la, ênz stiz iz lanh ninyh wa tômx songx zamf quanz pâu nyăngz tinc. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Ênz stiz iz lanh ninyh pongh wax đomc ayx côx munh, stiz songđ coong: “Nâyx đomc munh six taih sêu lunc pănh nyăngz dlanyh, stiz six Yu-tai munh, <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />nănh stiz nzaox wax đomc gâyf, pănh six max săngh stipx yâuc max săngh âyz ayx, wâyc pănh six Lô-ma munh.” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />Munh đuungx songđ pukb staox taih tămx stiz wa iz lanh, wax đomc quanz êu zeb stiz nyăngz guyz, yâuc setb lanyf êu nongc pya stătb stiz. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Tăng wa, stiz bopc tuz đuungx đitb, stiz songđ ênz wa iz lanh muf ănz nzauh, zăpx êu jămđ nzauh quanz cayb leđ stiz năngx gongx, <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />wax tauh jămđ nzauh quanz, songđ stipx lanyf clăngđ stiz ănz cah njaf wax nomz nzauh, yâuc zoz ja yunb taih ja stiz nyăngz staux. <verse eid="ACT 16:24" /><verse number="25" style="v" sid="ACT 16:25" />Six tauv đamx munf, Phao-lô cloon Si-la cloo Zâu yâuc ayx nzungz tanv Zâu Tênb-Huungh, nzof wax đomc nzauh munh yâuc mungv stiz. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Wax zanyf, lênh dlih naih nib tongf njoongh nzongf, ayx tuz wax đomc nzauh tay zuc stuyđ nzuf, nzof muif nomz nzauh jeengh songđ lênh dlih coib goib, nzof stayb muif lanh nzauh munh wax đomc njab langb yâuc lunc nzuf. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Tauv wax tauh jămđ nzauh quanz điub taih, phătc wax đomc nzauh jeengh coib wa nzuf, songđ cănh luutz nănh nyăngz nzuc đao taih, cayx đa cănh tayx nănh, wâyc nănh nyâyh coong wax đomc nzauh munh tiuv nzuf. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Six Phao-lô hamv stingb lub coong: “Năngx gâyf cănh hoiđ mâyh, wâyc buz tinyh đoih năngx jinh yămz nây nzuf.” <verse eid="ACT 16:28" /><verse number="29" style="v" sid="ACT 16:29" />Tăng wa, nănh songđ êu zoz toongz taih, coonx tiuv nzac wa cah njaf ninyh, wâyc nănh cumh nzav, songđ puc nzac Phao-lô cloon Si-la nyăngz cah đangc ninyh, <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />nănh ênz Phao-lô buz setb taih, songđ naic coong: “Yâuf pez lex, yaz oix zuc ayx laix nzăngđ hayh tuz njâuv heh?” <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />Stiz songđ coong: “Oix zuc zen caođ Zâu Yê-su — mâyh cloon mâyh nyăngz pyau munh songđ tuz njâuv.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Tăng wa, stiz songđ lănv Zâu nyăngz gâyf phunz nănh cloon nănh nyăngz pyau njaf munh muif lanh. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Wax munf toix wax nomz săngx huđ nănh ênz Phao-lô buz lêpc nănh muf, nănh songđ đaox stiz wax đomc zuc munz nyăngz tinc — nănh songđ lênh dlih cloon nănh nyăngz muif lanh pyau munh ayx quaix-gâyf. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Nănh yâuc ênz stiz muf nănh nyăngz pyau bênc năngv phunz stiz nhlinc, nănh songđ cloon nănh nyăngz pyau munh numđ nyađ nzongf, wâyc tuz zen Zâu Tênb-Huungh.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Tăng wa, tauv nyâyc đoomz, wax đomc quanz paiđ ah đomc peengz taih bux coong: “Pungx phunz wax đomc munh muf gôh.” <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Wax tauh jămđ nzauh quanz songđ bux wax đomc wac ănz Phao-lô, coong: “Wax đomc quanz paiđ munh taih bux coong, nyâuh tuz pungx nzof gôh. Năngx nâyx nâyx zanyf, nyâuh bix muf gôh, cloo phunz nyâuh iz lanh setb jau muf tuz peengh oonz.” <verse eid="ACT 16:36" /><verse number="37" style="v" sid="ACT 16:37" />Six Phao-lô coong ănz stiz: “Buz six săngh Lô-ma côkz nyăngz pec stingx nyăngz munh, max zeengx stămđ tuz yox, stiz bix toongx songx bopc buz, zef zoz buz ănz nzauh, nzof nâyx zanyf stiz bix cayx stinyb njâuh pungx buz naz? Cănh mayv tuz! Stiz six oix zuc cănh taih nây, ênz buz setb ninyh.” <verse eid="ACT 16:37" /><verse number="38" style="v" sid="ACT 16:38" />Tăng wa, wax đomc peengz songđ muf coong nâyx đomc wac ănz wax đomc quanz, wax đomc quanz numđ coong wa iz lanh six Lô-ma côkz nyăngz pec stingx, nănh stiz songđ numđ cumh nzav nzongf. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Wax đomc quanz songđ ninyh tauv wa joođ stiz, yâuc ênz setb ninyh, wax đomc quanz joođ êu Phao-lô buz setb gâyh stiz nyăngz dlanyh ninyh. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Tăng wa, stiz setb nzauh taih, stiz songđ ninyh Li-đi nyăngz pyau. Tauv pongh wax đomc yâuf pez, stiz oonz wax đomc yâuf pez nyăngz nyâuđ tuz, songđ setb jau ninyh.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Phao-lô cloon Si-la clăngv quaix wa Am-phi-bu-li cloon A-bo-lô-ni dlanyh muf, stiz muf tauv Tê-sa-lô-ni-ca dlanyh yămz wa naih ah nomz Yu-tai munh nyăngz huyđ toongh. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Phao-lô lauf ayx năngx njinh leox nâyx, nzac huyđ toongh ninyh cloon stiz yămz wa pôz nomz tingc congz noib cah njaf, nănh zoz Canyx Stâub taih pob manyf coong bux stiz, <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />tauv pob manyf tuz yox, coong Zâu Jix-Tuz six zuc tanyđ zâuđ yâuc năngx tăng tayc săngh taih, songđ coong: “Yaz nzônh phunz nyâuh nâyx Tauh Zâu Yê-su, six Zâu Jix-Tuz.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Yămz stiz wa naih ah phanx songđ mungv lêpc Phao-lô cloon Si-la, cloon đuungx lanh canyx bongc Zâu Tênb-Huungh wax đomc Hi-lapc munh, yâuc cloon đuungx lanh naih minb mâyc njăngb nyăngz munh nzif. <verse eid="ACT 17:4" /><verse number="5" style="v" sid="ACT 17:5" />Six wâyc wax đomc Yu-tai munh numđ hănđ, songđ ninyh ênz yămz wa môngf sangc wax đomc ayx huđ nyăngz munh, stiz lungz wax đomc songx munh hongđ taih căpx dlonf, stiz ayx phunz wax nomz dlanyh lunc nzuf. Songđ pungb nzac Ya-sônx nyăngz pyau ninyh, lov Phao-lô cloon Si-la nongc ênz taih yămz songx munh nyăngz cah đangc. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Six lov stiz wa iz lanh max pongh, stiz songđ ênz Ya-sônx cloon wax đomc yâuf pez ninyh yămz wa dlanyh wax đomc ayx côx munh nyăngz cah đangc, hamv coong: “Mangc nâyx đomc sêu lunc nây guungh đi nyăngz munh, stiz lauf jinh đangh naih minb yămz nây, <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />six Ya-sônx cloon nâyx đomc yetx stong munh stipx wax đomc munh. Stiz jinh đangh nzeengz cloon Sê-sa nyăngz lanyf, wâyc stiz coong naih pitc tauh huungh, hipđ ayx Yê-su.” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Stiz songđ ayx phunz songx munh hongđ cloon yămz wa dlanyh wax đomc ayx côx munh lunc nzuf, wâyc numđ wax đomc wac. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Wax đomc quanz êu Ya-sônx cloon wax đomc munh ănz nyanh tuz, songđ pungx phunz stiz muf.<verse eid="ACT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Tăng wa wax đomc yâuf pez songđ lênh dlih njinh nzămc ênz Phao-lô cloon Si-la ninyh wa Bê-lô-a dlanyh, ninyh tauv tinc Phao-lô cloon Sa-la songđ nzac Yu-tai munh nyăngz huyđ toongh ninyh. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Yămz nây nyăngz munh yâuc năngx goib âyx têx wa Tê-sa-lô-ni-ca munh, stiz pungx nyâuđ mungv Cuđ Jenx nyăngz gâyf, yâuc muif noib zah Canyx Stâub mangc jađ wax đomc gâyf six senz toix max toix. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Năngđ nây, yămz stiz wa songđ naih munh đuungx zen, njinh cloon ah đomc naih minb mâyc njăngb nyăngz Hi-lapc munh nzif, cloon đuungx lanh munh pha. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Six tauv yămz wa Tê-sa-lô-ni-ca wax đomc Yu-tai munh pâyz coong Phao-lô jinh đangh nzônh Zâu Tênb-Huungh nyăngz gâyf yămz wa Bê-lô-a dlanyh, stiz zef ninyh tauv wa lungz, ayx wax đomc songx munh lunc nzuf. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Tăng wa wax đomc yâuf pez songđ lênh dlih ênz Phao-lô nzac wa coiđ wax phanx muf, six Si-la cloon Ti-mô-tai stiz iz lanh lauf năngx jinh yămz wa tinc. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Stungx Phao-lô wax đomc munh ênz nănh ninyh tauv wa A-tên dlanyh, stipx tuz Phao-lô ja wac pungx phunz Si-la cloon Ti-mô-tai coong êu stiz iz lanh coonx ninyh pongh nănh năngx căn, stiz songđ phunb đangz muf.<verse eid="ACT 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Wax zanyf yămz wa Ê-tên, Phao-lô jinh đangh zu stiz iz lanh nyăngz săngx huđ, phătc wax nomz dlanyh naih miuc hanyh pong nzuf nănh songđ numđ nyâuđ njaf munz nzuf. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Nănh songđ yămz wa huyđ toongh cloon Yu-tai munh, yâuc cloon canyx bongc Zâu Tênb-Huungh wax đomc munh, cloon nănh muif noib tuz pongh yămz wa caiz sangc njaf wax đomc munh nzeengz gâyf. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Six naih ah đomc cungb tâuh nyađ wax huungđ munh cloon wăn stimz wax huungđ munh lauf cloon nănh nzeengz gâyf. Naih ah phanx yâuc coong: “Lâyc tauh munh nzetx đuungx nâyx oix coong luungđ heh?” Naih ah phanx zef coong: “Naih dlih nănh six taih lănv tauv wax đomc pitc nomz côkz munh nyăngz manđ lêc,” six nănh yâuc jinh đangh nzônh Cuđ Jenx coong tauv Zâu Yê-su cloon săngh taih nyăngz jau. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Stiz songđ nzauf nănh yămz wa, ênz ninyh yămz wa A-lê-ô-ba-gatc Stămđ zăngc quanz, yâuc coong: “Buz oix pâyz tuz mâyh jinh đangh nzaox nâyx huungđ săngb gâyf, six luungđ? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Wâyc mâyh jinh đangh coong nâyx đomc jau buz numđ njingc nzongf. Wâyc nây buz oix pâyz tuz nâyx đomc jau six naih luungđ âyz gâyf.” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />(Wax zanyf, lomc wa A-tên dlanyh nyăngz munh, cloon yămz wa nyăngz pec stingx, tinyh đoih max oix luungđ cungb oix lănv câu yâuc oix mungv munh lănv săngb câu njingc wax đomc.)<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Tăng wa Phao-lô songđ stâuđ yămz wa A-lê-ô-ba-gatc nyăngz Stămđ zăngc quanz mungh tongx, yâuc coong:</para>
  <para style="p" vid="ACT 17:22">“Yetx stong A-tên nyăngz munh lex, yaz phătc nyâuh senz naih stimz bongc muif huungđ gâyf dloih nzuf. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Wâyc yaz taih yâuc zah phătc nyâuh canyx bongc nyăngz tax huungđ, yaz yâuc phătc naih ah nomz congx tinc naih ja đăngc ănz wa, coong: ‘Bongc Max Pâyz Nyăngz Huungh.’ Năngđ nây, nyâuh bongc bix max pâyz wax tauh huungh, six yaz jinh đangh nzônh bux phunz nyâuh nây gôh. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Zâu Tênb-Huungh six zuyx guungh zuyx nib cloon zuyx muif huungđ taih yămz wa wax Tauh, six guungh nib nyăngz Zâu, Nănh max yămz munh puf ayx taih nyăngz miuc pyau cah njaf. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Nănh yâuc max nongc tauv bamh munh nyăngz puf stăngc Nănh ayx toix laiv huungđ, wâyc Nănh six sađ phunz muif huungđ naih mengc săngh yâuc naih siv tongb cloon muif huungđ timb wax Tauh. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Nzof yâuc tăng ah lanh munh Nănh bix ayx săngh manf stingx munh yămz pong nây nib minc, yâuc cănđ săngx huđ phunz munh săngh cloon stiz yămz nyăngz căpx caix tinc, <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />nongc phunz lov Zâu Tênb-Huungh, yâuc nyâyh coong tuz mungc stiz hayh lov tuz pongh Nănh yâuc phătc Nănh, max cun Nănh manyf senz yămz gâyh pănh muif lanh max côz. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Yâuc tăng Nănh pănh bix tuz săngh, yâuc naih yămz nây, lauf cayx năngđ nyâuh wax đomc nzungz stayb nyăngz munh naih ah phanx coong: ‘Pănh six lauf Nănh nyăngz sây stunz.’ <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />Năngđ nây, wâyc pănh six Zâu Tênb-Huungh nyăngz sây stunz, pănh max hoopđ zuc nyâyh coong Zâu Tênb-Huungh lauf cayx năngđ cay bamh munh cănh âyz pyây lâyđ nyâyh bix nongc sămz, nongc nyanh, yâuc nongc njăuz ayx taih wax đomc hanyh tongc. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Wâyc nây, tăng cah đangc max zeengx pâyz quaix taih wax đomc Zâu Tênb-Huungh quanyf nzuf, nzof nâyx zanyf Nănh êu muif lanh munh yămz muif nomz tinc, oix zuc coi nyâuđ nhlimc stoif, <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />wâyc Zâu Tênb-Huungh tingc săngh tauv naih ah noib, Nănh six peengh stimz nyăngz stămđ guungh đi muif lanh munh, tăng Nănh njăpc taih wax Tauh Munh, Zâu Tênb-Huungh yâuc ayx phunz wax tauh Munh tăng tayc săngh taih, nongc ayx senz nyăngz zanyx manyf phunz guungh đi munh.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Wax zanyf stiz numđ coong tauv munh tayc săngh taih nyăngz jau, naih ah phanx munh songđ jetx nănh, six naih ah phanx yâuc coong: “Buz oix mungv mâyh coong nâyx đomc jau ah hâyđ timb.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Tăng wa, Phao-lô songđ ninyh gâyh stiz. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Six naih ah phanx munh lêpc nănh yâuc zen Zâu, yămz wax đomc naih ah lanh six hipđ ayx Đi-ô-ni-si-atc, A-lê-ô-ba-gatc nyăngz ah lanh stămđ zăngc munh, cloon ah lanh munh nzif hipđ ayx Đa-ma-lit, cloon đuungx lanh munh timb.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Blătc wax đomc dlayc, Phao-lô songđ tăng A-tên setb jau ninyh tauv Cô-lin-tô dlanyh. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Yămz wa nănh pongh ah lanh Yu-tai munh, bux hipđ ayx A-qui-la, steengb yămz Boon-tat stâyz phangz, cloon nănh nyăngz au Bitc-sin-la tăng I-ta-li côkz ah yac pyăux taih, wâyc Ca-lau-đi-atc huungh setb lanyf êu yetx stong Yu-tai munh zuc setb wa Lô-ma dlanyh, Phao-lô songđ cloon stiz yămz, <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />yâuc wâyc songc ah huungđ cumh pâuz stangc, Phao-lô songđ cloon stiz yămz wa songc ayx cumh pâuz, wâyc stiz six gonh đupx njiuh stangc nyăngz munh. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Wax zanyf, yămz muif nomz tingc congz noib, Phao-lô yâuc yămz wa huyđ toongh nzaox gâyf, nănh quinb nzaox njinh Yu-tai munh cloon Hi-lapc munh. <verse eid="ACT 18:4" /><verse number="5" style="v" sid="ACT 18:5" />Six tauv tuz Si-la cloon Ti-mô-tai tăng Ma-si-đô-ni dlanyh taih tauv, Phao-lô songđ tuz pungx stimz nzônh gâyf, ayx zanyx manyf phunz Yu-tai munh coong tauv Zâu Yê-su six Zâu Jix-Tuz. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Six wax đomc Yu-tai munh nzeengz nănh yâuc mađ nănh, nănh songđ boongf guyz, yâuc coong ănz stiz: “Nyâuh nyăngz samđ six cănh njămh ănz nyâuh nyăngz pyây! Nzof yaz yâuc max naih stoif! Tăng nây staox ninyh, yaz six ninyh lov wax đomc pitc stingx munh.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Tauv setb wax nomz tinc, nănh ninyh nzac ah lanh canyx bongc Zâu Tênb-Huungh munh nyăngz pyau, bux hipđ ayx Ti-ti-atc Yu-sa-tat, nâyx lanh munh nyăngz pyau six yămz wa huyđ toongh cah sinh. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Six Ca-lit-batc cun huyđ toongh nyăngz munh, yâuc cloon nănh nyăngz pyau munh muif lanh zen Zâu, nzof naih đuungx lanh Cô-lin-tô munh numđ Phao-lô nzônh gâyf songđ zen yâuc ayx quaix-gâyf. <verse eid="ACT 18:8" /><verse number="9" style="v" sid="ACT 18:9" />Wax zanyf, toix bah nzămc Zâu coong ănz Phao-lô yămz hinđ yangh nyăngz jau, coong: “Năngx gâyf cumh nzav oix zuc nzac jab coong, năngx gâyf stinyb njâuh. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />Wâyc Yaz cloon mâyh yămz yâuc max naih mănv hayh ayx luungđ hoiđ mâyh, wâyc yămz nâyx nomz dlanyh naih đuungx lanh munh six săngh Yaz nyăngz.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Tăng wa, Phao-lô songđ yămz wa ah nyăngv căn joz lav, nzaox Zâu Tênb-Huungh nyăngz gâyf phunz stiz.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Six Gan-li-ôn ayx quanz pyây cun A-ca-ya steengv wax zanyf, Yu-tai munh songđ hoopđ nyâuđ taih nzeengz cloon Phao-lô, yâuc ênz nănh ninyh wa stămđ zăngc tinc, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />yâuc coong: “Nâyx tauh munh taih lungz songx munh bongc Zâu Tênb-Huungh max toix gâyf.” <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />Six Phao-lô nzăngđ cayx đa goib nzetx coong wac wax zanyf, Gan-li-ôn songđ coong ănz Yu-tai munh coong: “Nyâuh đomc Yu-tai munh lex, năngđ coong nây six senz naih ayx pamf tauv quanz pâu gâyf max six pamf ayx okx nyăngz jau, năngđ ha têx, yaz six năngx pungx stimz mungv nyâuh, <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />six năngđ coong nây six cungb tinyh zenđ nyăngz jau, nzeengz manyh bux, yâuc nzeengz nyâuh cănh nyăngz gâyf têx nyâuh bix cănh bênc gôh. Yaz max oix stămđ tauv nâyx đomc jau.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Nănh songđ luiđ stiz setb wa stămđ zăngc tinc ninyh. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Tăng wa, stiz songđ toopz Sô-sa-tê-nêt cun huyđ toongh nyăngz munh, stiz tinyh đoih bopc nănh yămz wa stămđ zăngc tinc nyăngz cah đangc, six Gan-li-ôn yâuc ayx max pâyz zâyx ănz nâyx đomc dlayc.<verse eid="ACT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Nzof Phao-lô lauf năngx jinh yămz wa đuungx noib timb, nzăngđ cloon wax đomc yâuf pez tinyh gâyh, nănh cloon Bitc-sin-la, căn A-qui-la yămz đangđ nzac wa Si-li stâyz phangz muf, nănh songđ yămz wa Cên-cê-li tâyv pyây đongz wâyc nănh naih nyunc wac. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Tăng wa, stiz zef nzac Ê-phê-sô muf, Phao-lô songđ phunz stiz iz lanh yămz wa, nzof nănh six nzac huyđ toongh ninyh cloon Yu-tai munh nzeengz gâyf. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Stiz songđ êu nănh yămz wa tix cay ah dlapc timb, six nănh max nyenc yămz. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Nănh songđ coong tinyh gâyh wac ănz stiz, coong: “Năngđ coong Zâu Tênb-Huungh oix, yaz six năngx phunb đangz lauf pongh nyâuh timb,” nănh songđ nzac đangđ ninyh gâyh wa Ê-phê-sô.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />Nzof tauv nănh setb wa Si-sa-li-ya coiđ sinh, nănh songđ staox wax Yê-lu-sa-lem ninyh tayđ jiux pangx tuz, nănh songđ muf wa An-ti-ôkx dlanyh. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Yămz wa tuz ah dlapc, nănh songđ setb jau ninyh, stunb quaix Ga-la-ti stâyz phangz cloon Pha-li-ji stâyz phangz ninyh, ayx phunz wax đomc zen nyăngz munh yetx stong tuz njoongh staox.<verse eid="ACT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Wax zanyf, naih ah lanh Yu-tai munh, bux hipđ ayx A-bô-lô, yămz A-lêk-san-đê-li dlanyh steengb stâyv, yoiz hayh coong wac nyăngz munh, nzac taih tauv Ê-phê-sô dlanyh, nănh six ah lanh munh manyh pec Canyx Stâub. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Nănh tuz hoođ pâyz Zâu nyăngz gâyf, wâyc nănh nyâuđ njaf gwăngz, songđ nzaox yâuc pob manyf toix nzuf coong tauv Zâu Yê-su wax đomc jau, wax zanyf nănh six nzăngđ pâyz Yô-hanx ayx nyăngz quaix-gâyf cuungv. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Nănh yâuc pungx stimz nyăngz yămz wa huyđ toongh nzaox gâyf, six tauv mungv nănh tuz, Bitc-sin-la cloon A-qui-la songđ ênz nănh muf yâuc năngx cayb bux Zâu Tênb-Huungh nyăngz gâyf phunz nănh pâyz năngx nzuf. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Six A-bô-lô oix ninyh wa A-ca-ya stâyz phangz, wax đomc yâuf pez songđ oonz nyâuđ, yâuc ja jenx pungx phunz wax đomc stayb sây êu cayb stipx nănh năngx gongx, nănh ninyh tauv wa tinc, songđ stăngc tuz păngc Zâu nyăngz pôz bix zen wax đomc munh đuungx nzongf. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Nănh toongx songx caix cloon wax đomc Yu-tai munh njoongh nzongf, zoz Canyx Stâub taih yâuc pob coong Zâu Yê-su six Zâu Jix-Tuz.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Wax zanyf, A-bô-lô yămz wa Cô-lin-tô nyăngz săngx huđ, Phao-lô stunb njaf cănv wax đomc stâyz phangz tuz, nănh songđ nzac wa Ê-phê-sô muf yâuc pongh ah đomc zen nyăngz munh. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Nănh songđ naic stiz coong: “Tăng nyâuh zen nyâuh tuz stipx Zâu Singx-Lingh max zeengx heh?” Six stiz tauz nănh, coong: “Max, njinh buz lôx max zeengx tuz numđ coong tauv naih Zâu Singx-Lingh.” <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />Phao-lô zef naic: “Ha nyâuh tuz ayx luungđ gâyf nzof heh?” Stiz tauz coong: “Yô-hanx ayx nyăngz quaix-gâyf.” <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />Tăng wa Phao-lô songđ coong: “Yô-hanx ayx quaix-gâyf coong tauv nhlimc stoif nyăngz jau, yâuc nzaox phunz songx munh coong naih ah Tauh taih đangz nănh stiz six oix zuc zen wax Tauh, nây six zen Zâu Yê-su.” <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />Stiz numđ nâyx đomc tuz, stiz songđ tim Zâu Yê-su nyăngz manyh stipx quaix-gâyf. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Phao-lô tăpx puf ănz stiz Zâu Singx-Lingh songđ nzac yămz stiz, stiz songđ hayh coong pitc huungđ nyăngz wac yâuc hayh tâuc wac. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Wax zanyf, stiz yămz wa cox naih săpc nyâyc lanh munh pha.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Phao-lô songđ nzac huyđ toongz ninyh, nănh pungx stimz nzaox gâyf tuz pôz lav cah njaf, pob manyf yâuc coong tauv Zâu Tênb-Huungh nyăngz côkz. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Six naih ah phanx munh yâuc nyâuđ nhlengc max zen, yâuc yămz songx munh nyăngz cah đangc coong đokc ănz Zâu nyăngz gâyf, Phao-lô songđ njeengx wax đomc stayb sây, gâyh goib nănh stiz, yâuc muif noib yămz wa Ti-lan-nat nyăngz hoođ đăngc pyau nzaox gâyf phunz stiz. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Nănh ayx năngđ nâyx tuz iz nyăngv cah njaf, ayx tuz muif lanh munh yămz wa Ê-si stâyz phangz tauv laiv yâuc tuz numđ Zâu nyăngz gâyf, njinh Yu-tai munh cloon Hi-lapc munh. <verse eid="ACT 19:10" /><verse number="11" style="v" sid="ACT 19:11" />Zâu Tênb-Huungh yâuc nongc tăng Phao-lô nyăngz puf ayx wax đomc Jix caox njingc nyăngz njic hoouđ njingc nzongf, <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />ayx tuz zoz wax đomc tungh minb buyx cloon guyz clatc tauv nănh nyăngz stinb a yâuc nzâyz ninyh ănz wax đomc săngh gumc munh, stiz nyăngz gumc songđ tuz gongx, manđ yootz yâuc zuc setb nzuf. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Wax zanyf, naih ah đomc luiđ manđ nyăngz Yu-tai munh yâuh ninyh yâuc jab tim Zâu Yê-su nyăngz manyh luiđ wax đomc munh naih manđ yootz yămz stinb, coong: “Yaz tim Phao-lô nzônh wax Tau Yê-su nyăngz manyh zăpx mâyh.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />(Wax zanyf, ayx nâyx đomc cumh pâuz nyăngz munh, six ah lanh Yu-tai munh nyăngz stayb munh pyây Sê-wa nyăngz nhlic lanh toonz.) <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Six, manđ yootz tauz ănz stiz, coong: “Yê-su yaz pâyz, Phao-lô yaz lauf pâyz, năngx naih nyâuh six mănv heh?” <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />Tăng wa, zuc manđ yootz nzac yămz stinb wax tauh munh, đanyz taih nyauh stiz, yâuc jâu stiz muif lanh, ayx tuz guyz quav byaif nzuf căng căng yâuc zuc munz, tiuv pletx wax sênz pyau. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Wax zanyf, yămz wa Ê-phê-sô dlanyh nyăngz muif lanh munh, njinh Yu-tai munh cloon Hi-lapc munh. Tinyh đoih numđ tauv nâyx đomc dlayc stiz yâuc tinyh đoih numđ cumh nzav nzongf, songđ zanyb Zâu Yê-su nyăngz manyh. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Naih đuungx lanh zen nyăngz munh songđ taih, nhlimc yâuc coong tauv stiz ayx nyăngz jau. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Wax đomc ayx manđ ayx papz nyăngz munh đuungx lanh, zoz stiz wax đomc papz stâub taih toongx songx yămz munh nyăngz cah đangc pu nzuf. Munh stunx wax đomc stâub nyăngz nyanh zax cox naih pyaz panc leepz lôx stinh. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Wâyc nây, păngc tômx jab, Zâu nyăngz gâyf songđ tuz nzônh quăng ninyh yâuc njoongh staox.<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Ah yac ayx tuz wax đomc cumh pâuz soongb, Phao-lô songđ âyz Singx-Lingh tingc săngh, cayx clăngv quaix Ma-si-đô-ni cloon A-ca-ya stâyz phangz muf, mănc muf wa Yê-lu-sa-lem, yâuc coong: “Tauv yaz muf tauv wa tinc tuz, yaz zef năngx zuc ninyh tayđ wa Lô-ma dlanyh timb.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Tăng wa, nănh songđ paiđ iz lanh munh ninyh nongc stăngc nănh, six Ti-mô-tai cloon Ê-lat-tat, ninyh wa Ma-si-đô-ni đangc, nănh yâuc năngx jinh yămz wa Ê-si ah dlapc timb.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Yămz wax đomc noib, naih wac lunc setb taih lub nzongf wâyc nây Cuđ Jenx. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Wâyc naih ah lanh ta nyanh stangc, hipđ ayx Đê-mêt-li-atc njinh leox nongc nyanh pec ayx An-tê-mit manđ nzif nyăngz miuc hanyh, nâyx đomc steengb âyx yâuc tuz nyanh gâyc đuungx nzongf nongc phunz wax đomc stangc, <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />wax tauh munh ênz wax đomc songc ayx nâyx huungđ cumh pâuz stangc nyăngz munh taih căpx dlonf, yâuc coong: “Yetx stong yâuf pez lex, nyâuh pâyz coong pănh tuz puv quâyx six păngc ayx nâyx đomc steengb âyx nyăngz cumh pâuz. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Nyâuh lauf tuz phătc yâuc tuz numđ coong max zâyf cungb yămz Ê-phê-sô cuungv, six yâuc yămz nzêux pong Ê-si stâyz phangz nâyx tauh Phao-lô, nănh ninyh hox tuz songx munh đuungx nzongf plănc nyâuđ, wâyc zuc nănh coong tăng munh nyăngz puf ayx taih nyăngz six max Zâyf đăngb zeengh Zâu ax tinyh. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Nzof nâyx đomc jau max zâyf cungb ayx phunz pănh nyăngz steengb âyx jau zuc setc, yâuc njinh cloon saix nzongf nyăngz An-tê-mit manđ nzif miuc hanyh zuc mangc stam. Nzof nâyx tauh manđ nzif tuz nyăngz gwăngz eeng yămz pong Ê-si stâyz phangz, njinh cloon guungh đi munh canyx bongc wax đomc, senz cayx zuc jac ninyh.” <verse eid="ACT 19:27" /><verse number="28" style="v" sid="ACT 19:28" />Wax zanyf, mungv nâyx đomc wac tuz, stiz songđ numđ nhlenx, hamv nguutz nguutz têx, coong: “Ê-phê-sô munh nyăngz An-tê-mit manđ nzif, senz saix nzongf!” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Lomc wax nomz dlanyh songđ lunc nzuf, songx munh tinyh ênz taih yămz stiz nzoomf wax nomz tinc, toopz Gai-atc cloon A-lit-ta-cat, Ma-si-đô-ni munh, cloon Phao-lô songc ayx cumh pâuz nyăngz munh. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Six Phao-lô oix setb minb taih yămz songx munh nyăngz cah đangc, six wax đomc zen nyăngz munh max phunz nănh taih. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Nzof naih ah đomc ayx côx munh yămz wa Ê-si stâyz phangz, cloon nănh tinyh quênx nyăngz toic, yâuc pungx wac taih phunz nănh, bux êu nănh năngx gâyf ninyh nzac stiz nzoomf wax nomz tinc. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Tăng wa, stiz wax peob munh cănh hamv coong lanh zâux, lanh zâux, max tinyh năngđ tinyh, wâyc stiz tinyh đoih lunc nzuf, naih ah phanx lôx max pâyz wâyc săngh laix stiz bix yămz wa. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Wax zanyf, yămz wax peob munh naih ah đomc munh êu A-lek-san-đê coong, Yu-tai munh songđ nyongđ nănh staox wa cah đangc ninyh, A-lek-san-đê songđ zaub puf, oix stăngc stiz coong phunz songx munh. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Six tauv songx munh pâyz coong nănh six Yu-tai munh, stiz zef hamv ah dlapc năngx lub têx ayx tuz iz săngx huđ cah njaf, coong: “Ê-phê-sô munh nyăngz An-tê-mit manđ nzif senz lub nzongf.” <verse eid="ACT 19:34" /><verse number="35" style="v" sid="ACT 19:35" />Six, tauv naih ah tauh quanz yămz wa dlanyh taih ayx phunz songx munh hongđ max nyaoc, songđ coong:</para>
  <para style="p" vid="ACT 19:35">“Yetx stong Ê-phê-sô nyăngz songx munh lex, naih mănv bix max pâyz coong, Ê-phê-sô dlanyh nyăngz munh six canyx bongc lub nzongf nyăngz An-tê-mit manđ nzif miuc hanyh heh, nzof nây miuc hanyh six tăng guungh tuih nzac taih? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Năngđ nây, nâyx đomc dlayc six cănh mayv nyenc tuz, six nyâuh oix zuc ah manc đangc yâuc năngx gâyf zeengx coonx ayx luungđ. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Wâyc nyâuh ênz nâyx đomc munh taih, stiz max zâyf ayx stac nimc miuc hanyh nyăngz tax huungđ, yâuc max zâyf wax đomc munh pib mađ pănh nyăngz manđ nzif miuc hanyh. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Wâyc nây, năngđ coong Đê-mêt-li-atc cloon nănh wax đomc steengb âyx stangc nyăngz munh naih luungđ oix cooux mănv, six zu tauv wa coib dlayc noib, naih cloon wax đomc cun steengv nyăngz quanz pyây; nzof mănc phunz stiz lanh cooux lanh. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Nzof năngđ, coong nyâuh naih laiv huungđ jau oix coong timb, six cănh tuz yămz wa huyđ tinc âyz gâyf pob phunz. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Wâyc zuc, hoođ max hoođ pănh lôx năngx zuc cooux tauv nâyx noib setb taih nâyx đomc lunc laoc nyăngz dlayc, wâyc max naih luungđ stâuv tiny, wâyc nây, pănh senz hayh max naih jau nongc cai tauv nâyx đomc wac nginyz nginyz têx nyăngz jau.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Coong nâyx đomc wac tuz, nănh songđ êu nzoomf wa nyăngz songx munh đanv nzuf.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Tauv blătc nzuf wax đomc dlayc, Phao-lô êu wax đomc stayb sây taih, quinb bux stiz tuz, yâuc coong tinyh gâyh wac, nănh songđ setb jau ninyh wa Ma-si-đô-ni stâyz phangz. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Tăng wa, nănh ninyh clăngv quaix wax đomc stâyz phangz muf, oonz nyâuđ phunz wax đomc zen nyăngz munh yâuc nzaox gâyf đuungx, nănh songđ quaix wa Hi-lapc muf. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Yămz wa tuz pôz lav, Tauv nănh cayx nzac đangđ ninyh wa Si-li, yâuc pâyz tuz Yu-tai munh ta zux ix cayx hoiđ nănh, nănh songđ zef phunb đangz quaix Ma-si-đô-ni muf. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Wax zanyf, cloon nănh ninyh nyăngz munh six naih Bê-lô-a dlanyh nyăngz munh; Bi-lat nyăngz toonz Sô-ba-tê, cloon yămz Tê-sa-lô-ni-ca dlanyh wax tauh; A-lit-ta-cat cloon Sê-cun-đatc; cloon Gai-atc Đê-bi dlanyh nyăngz munh, cloon Ti-mô-tai; cloon Ti-ci-gatc cloon Tô-phi-mat, Ê-si munh. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Nâyx đomc munh ninyh đangc yămz wa Tô-atc zu buz. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Nzof buz, six tauv blătc Nzu Max Ănz Piny nyăngz Stêtz wax đomc noib, nzăngđ tăng wa Phi-lipx-poi dlanyh nzac đangđ ninyh, tuz pyaz noib cah đangz, buz nzăngđ ninyh pongh stiz yămz wa Tô-atc dlanyh, buz yâuc yămz wa nhlic noib cah njaf.<verse eid="ACT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Wax zanyf, six tingc congz noib nyăngz tah yetx noib, buz căpx dlonf watz nzu nhlinc, Phao-lô cloon wax đomc zen nyăngz munh coong wac. Wâyc nănh cayx nyâyc noib setb jau ninyh, nănh songđ njinh luh nzaox gâyf tuz tauv đamx munf. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Wax zanyf, naih toongz đuungx, yămz cah zâyc tab nyăngz bôngh, six buz jinh đangh căpx dlonf yămz wax nomz tinc. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Naih ah lanh munh gunx munh, bux hipđ ayx Yu-ti-gatc, stâyv wa bah tang jeengh, songđ mâyc njoomh, Phao-lô yâuc jinh đangh nzaox gâyf lauh timb, wâyc mâyc njoomh đôz nănh songđ tăng cah zâyc wax tab pôz tuih nzac taih, tauv ninyh njăpc quef yâuc phătc tayc. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Six Phao-lô nzac ninyh cah đong quaix wax tauh toonz cah zâyc ninyh jom nănh, yâuc coong: “Năngx gâyf wangb, wâyc nănh năngx jinh naih mengc yămz nănh lêc.” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Tăng wa, zef staox ninyh, watz nzu nhlinc tuz, zef lănv wac ayx tuz tauv guungh gwăngz, năngđ nâyx, nănh bix taux wa setb jau ninyh. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Nzof, wax tauh toonz yâuc năngx jinh săngh, munh ênz muf songđ tuz numđ oonz nyâuđ nzongf.<verse eid="ACT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Tăng wa, buz songđ nzac đangđ ninyh đangc, quaix wa Atc-sôt dlanyh muf, wâyc buz six cănđ yămz wa stipx Phao-lô nzac đangđ, wâyc Phao-lô tingc săngh năngđ nâyx, nănh six cayx cănh yăngh quaix jau gaib muf wa. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Tauv nănh cloon buz tinyh pongh wa Atc-sôt dlanyh, buz stipx nănh nzac đangđ tuz, songđ quaix wa Mi-ti-lê-ni dlanyh muf. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Zef tăng wa yămz đangđ ninyh, tauv nyâyc noib buz nzăngđ muf beengc wa Ci-ôtc coiđ njeengh, zef nyâyc noib timb, buz nzăngđ tauv wa Sa-mot dlanyh, zef năngx ah noib timb buz nzăngđ muf tauv Mi-lê-tat dlanyh. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Wâyc Phao-lô tingc săngh yămz đangđ clăngv pitb wa Ê-phê-sô, phunz nănh max zuc nzuf săngx huđ yămz wa Ê-si, wâyc năngđ coong nănh hayh muf tuz saic, nănh six oix coonx muf tauv wa Yê-lu-sa-lem năngx saic Pên Tê Coot Stêtz.<verse eid="ACT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Nănh songđ tăng wa Mi-lê-tat dlanyh paiđ munh ninyh wa Ê-phê-sô, bux êu wax đomc jiux pangx nyăngz munh côx taih. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Tauv stiz taih pongh nănh, nănh songđ coong ănz stiz, coong: “Tăng ah yac yaz staux japc nzac Ê-si stâyz phangz wax noib, yaz cloon nyâuh yămz nyăngz săngx huđ six ayx năngđ laix, nyâuh lauf pâyz yox. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Yaz nongc nzuf nyâuđ ayx Zâu cumh pâuz, yâuc nhlimc ayx jenz, mâyc womz tuih yâuc pongh zuc sax huungđ zâuđ nanc, wâyc zuc wax đomc Yu-tai munh ta zux ix hoiđ yaz, <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />max naih yăngc laiv huungđ săngh nongc nyăngz tauv laiv, bix yaz max nzaox phunz nyâuh, yaz yămz songx munh hongđ mungh tongx nzaox, yâuc yămz săngh sênz pyau nzaox nyâuh. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Yaz ayx zanyx manyf phunz njinh Yu-tai munh cloon Hi-lapc munh coong tauv oix zuc coi nyâuđ nhlimc stoif lauf lov Zâu Tênb-Huungh, yâuc coong tauv oix zuc zen caođ Zâu, six pănh nyăngz Zâu Yê-su. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />Nâyx zanyf, yaz jinh đangh huungv ninyh wa Yê-lu-sa-lem, wâyc tuz Singx-Lingh yac yaz, yâuc max pâyz tuz yămz wa yaz six zuc pongh laiv huungđ, <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />six wâyc tuz Zâu Singx-Lingh ayx zanyx manyf bux ănz yaz yămz muif nomz dlanyh, coong, naih jab langb cloon zâuđ nanc nyăngz jau jinh đangh zu yaz. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Six, yaz max stunx yaz cănh nyăngz mengc ayx saix, tinyh phanv ayx năngx soongb nzuf yaz stipx taih tăng Zâu Yê-su phunz yaz nyăngz cumh pâuz, nongc ninyh ayx zanyx manyf phunz nây Cuđ Jenx, senz Zâu Tênb-Huungh nyăngz pôz. <verse eid="ACT 20:24" /><verse number="25" style="v" sid="ACT 20:25" />Nâyx zanyf, Yaz pâyz coong nyâuh muif lanh, senz yaz taih nzônh Tênb-toongh Côkz phunz nyăngz munh, six max hayh năngx tuz phătc yaz nyăngz minb. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Wâyc nây, nâyx noib yaz yămz nyâuh nyăngz cah đangc ayx zanyx manyf coong, yaz max naih stoif yămz nyâuh nyăngz samđ. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Wâyc Zâu Tênb-Huungh nyăngz zux ix tauv laiv, max naih laiv huungđ coong yaz bix max coong ănz nyâuh. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Oix zuc cun cănh yâuc jămđ cloon wax đomc jenz peob, wâyc tuz Zâu Singx-Lingh oonz nyâuh ayx jămđ Zâu Tênb-Huungh nyăngz jiux pangx nyăngz munh, nây jiux pangx six Nănh cănh nongc Nănh nyăngz samđ maif taih. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Yaz pâyz coong tauv yaz ninyh blătc, six naih okx nyăngz jab clô nzac nyâuh cah njaf taih, yâuc max nyangc wax đomc jenz peob. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Nzof yămz nyâuh cah njaf six naih ah phanx munh setb taih coong max săngh nyăngz jau, yâuc ênz đuungx lanh stayb sây căn stiz ninyh longđ. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Wâyc nây, oix zuc năngx cayb bôngh, oix zuc săngx coong, pôz nyăngv staox taih nây, yaz noib munf quinb nyâuh muif lanh max setc tiny naih cloon mâyc womz tuih. <verse eid="ACT 20:31" /><verse number="32" style="v" sid="ACT 20:32" />Nâyx zanyf, yaz stungx nyâuh phunz Zâu Tênb-Huungh cloon Nănh sađ pôz nyăngz gâyf, senz hayh zâyv tuz nyâuh wax huungđ gâyf, yâuc sađ phunz nyâuh tuz naih phănc, six senz muif lanh tuz stav đăngb nyăngz munh. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Yaz yâuc max mauh nyanh pec, max six sămz, cloon mănv nyăngz guyz quav. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Nyâuh lauf cănh pâyz coong yaz nyăngz puf cănh ayx cumh pâuz nongc yuungf yaz, năngx cloon lêpc yaz yămz wax đomc munh. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Yaz hinđ manyf phunz nyâuh pâyz coong, yămz muif huungđ cumh pâuz six oix zuc nzac jab ayx năngđ nâyx, nongc stăngc cloon wax đomc max tuz jab nyăngz munh, yâuc oix zuc săngx tauv Zâu Yê-su coong nyăngz wac, Nănh coong: ‘Phunz ninyh six năngx tuz pôz têx, tuz stipx lauf.’”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Phao-lô coong wax đomc wac tuz, songđ quâyc nzac, cloon stiz tinyh đoih cloo Zâu. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Wax zanyf, stiz songđ tinyh đoih haoh lub nzongf, ninyh jom Phao-lô nyăngz clangz, yâuc tomz nănh, <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />wâyc stiz năngx numđ munz stimz quaix six nănh coong, stiz songđ cayx max tuz phătc nănh nyăngz minb gôh naz, wax zâux wac. Tăng wa, stiz stuungx nănh nzac wa đangđ ninyh.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Wax zanyf, buz cloon stiz tinyh gâyh tuz, songđ nzac đangc ninyh, buz ninyh zac tauv wa Côtc dlanyh, nzof nyâyc noib nzăngđ tauv Lô-đê dlanyh, zef tăng wa ninyh tauv Ba-ta-la dlanyh. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Tauv lov tuz ah saz đangc ninyh wa Phi-ni-si stâyz phangz, buz songđ nzac wax saz đangđ ninyh. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Wax zanyf, mangc phătc Sai-batc coiđ njeengh, songđ pyenv quaix wa coiđ njeengh nyăngz staix phanx muf, buz yămz đangđ muf tauv Si-li stâyz phangz, nzac Tai-lapx dlanyh ninyh zapz wa, wâyc đangđ zuc yămz wa pungx huv. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Buz songđ lov tuz pongh wax đomc stayb sây, yâuc yămz wa nhlic noib, nzof stiz yâuc tuz Singx-Lingh phunz pâyz, songđ njinh luh bux Phao-lô coong năngx gâyf ninyh tauv wa Yê-lu-sa-lem. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Six, tauv blătc wax đomc noib, buz songđ zef setb jau ninyh, wax đomc stayb sây songđ tinyh đoih cloon au sây stungx buz ninyh blătc dlanyh cungh ngwaic, yâuc tinyh đoih quâyc nzac yămz wa coiđ sinh cloo Zâu, <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />buz songđ coong tinyh gâyh wac tuz, bix nzac đangđ ninyh, nzof stiz yâuc phunb đangz muf stiz nyăngz tinc, <verse eid="ACT 21:6" /><verse number="7" style="v" sid="ACT 21:7" />six buz ninyh đangđ nyăngz jau zomc, songđ tăng Tai-lapx nzac wa Tô-lê-mi muf, cloon wax đomc yâuf pez coong tinyh pongh wac tuz yâuc cloon stiz yămz wa ah noib. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Tauv nyâyc noib buz songđ setb jau ninyh, tauv wa Si-sa-li-ya dlanyh, ninyh nzac Phi-lipx nyăngz pyau, ah lanh nzônh Cuđ Jenx nyăngz munh, yâuc yămz wa nhlic lanh nyăngz ah lanh ayx coonz munh, buz cloon nănh yămz wa. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Wax zanyf nănh naih pyâyz lanh sab đăngb hayh tâuc wac. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Buz yămz wa tuz đuungx noib, naih ah lanh tâuc wac munh bux hipđ ayx, A-ga-batc, tăng Yu-đê stâyz phangz taih. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Nănh taih pongh buz zoz Phao-lô nyăngz quav langb, taih stayb nănh nyăngz puf staux, yâuc coong: “Zâu Singx-Lingh coong ayx năngđ nâyx: ‘Yămz wa Yê-lu-sa-lem nyăngz Yu-tai munh six stayb nâyx lanh munh pha, senz nâyx stinz quav langb nyăngz zâu, stiz yâuc jaoz nănh phunz pitc stingx munh nyăngz puf.’” <verse eid="ACT 21:11" /><verse number="12" style="v" sid="ACT 21:12" />Tauv buz numđ wax đomc wac songđ njinh buz cloon yămz wa nyăngz munh joođ êu Phao-lô gâyf ninyh wa Yê-lu-sa-lem. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Phao-lô songđ tauz coong: “Nyâuh ayx luungđ bix haoh ayx phunz yaz nyăngz nyâuđ munz nâyx heh? Wâyc yaz tingc săngh max zâyf cungb nyunc zuc stayb cuungv, yâuc năngx nyunc zuc tayc wâyc Zâu Yê-su nyăngz manyh yămz Yê-lu-sa-lem.” <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Wax zanyf, quinb nănh max mungv, buz songđ max quinb gôh, yâuc coong: “Cloo phunz Zâu nyăngz zux ix tuz ayx săngh.”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Blătc wax đomc noib, buz songđ bênc tungh zăngc, bix ninyh wa Yê-lu-sa-lem. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Naih ah đomc stayb sây tăng wa Si-sa-li-ya lauf cloon buz ninyh, songđ ênz buz ninyh Ma-na-sanx nyăngz pyau, nănh six yămz Sai-batc taih, ayx stayb sây năngx đangc quaix, nzof yămz wa buz yâuc tuz nănh stipx.<verse eid="ACT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Wax zanyf, buz ninyh tauv wa Yê-lu-sa-lem, wax đomc yâuf pez numđ nyađ stipx buz. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Tauv nyâyc noib, Phao-lô cloon buz ninyh pongh Ya-coopc, nzof wax đomc Jiux pangx nyăngz munh côx yâuc tinyh đoih naih minb yămz wa. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Cloon stiz coong tinyh pongh wac tuz, Phao-lô songđ lănv săngh huungđ săngh huungđ têx coong Zâu Tênb-Huungh nongc tăng nănh nyăngz cumh pâuz, bix yămz wax đomc pitc stingx munh mungh tongx ayx nyăngz muif huungđ. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Wax zanyf, mungv nâyx đomc wac tuz, stiz songđ tanv Zâu Tênb-Huungh, yâuc coong ănz Phao-lô: “Yâuf pez lex, mâyh lauf cănh phătc, Naih pâyz sax panc lanh Yu-tai munh taih zen, stiz yâuc tinyh đoih naih joomz nyâuđ tauv gâyf njanh. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Six, stiz numđ munh lănv tauv mâyh coong, mâyh nzaox phunz Yu-tai munh yămz pitc stingx munh mungh tongx wax đomc êu quanyf Mô-sê nyăngz gâyf, êu stiz năngx gâyf ayx quaix catz phunz stiz nyăngz sây, yâuc năngx gâyf ayx âyz wax đomc gâyf naz. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Nâyx bix, laiv ayx laix heh? Naih dlih stiz bâyf numđ coong mâyh taih tauv nzof. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Wâyc nây, oix zuc ayx năngđ nâyx, âyz buz bux mâyh nyăngz wac. Nâyx zanyf cloon buz yămz nây naih pyâyz lanh munh, stiz njinh đangh naih nyunc wac. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Oix zuc ênz nâyx đomc munh lêpc ninyh bix cloon stiz ayx stav wâyx, yâuc setb nyanh cloon stiz, phunz stiz tuz tâyv pyây, munh songđ hayh pâyz tuz coong stiz numđ coong tauv mâyh wax đomc wac six max senz naih, yâuc phătc mâyh lauf cănh ayx âyz gâyf njanh yămz. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Năngx naih zen Zâu wax đomc pitc stingx munh, buz yâuc pungx jenx ninyh zăpx êu stiz zuc njif năngx gâyf nhlinc congx miuc hanyh nyăngz tax huungđ, samđ, stanyb hauđ siv stoc tayc, cloon pongz lauh nyăngz jau.” <verse eid="ACT 21:25" /><verse number="26" style="v" sid="ACT 21:26" />Tăng wa tauv nyâyc noib, Phao-lô songđ ênz wax đomc munh lêpc ninyh, cloon stiz ayx stav wâyx tuz, Phao-lô songđ nzac Bongc Zâu Tênb-Huungh nyăngz pyau ninyh, bux tauv stiz stav wâyx wax đomc noib six tauv laiv zanyf nzăngđ pong, stunx tauv laiv zanyf stiz stuungx tax huungđ phunz stiz wa muif lanh.<verse eid="ACT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Six tauv cayx pong wa nhlic noib, naih ah đomc Yu-tai munh tăng Ê-si stâyz phangz taih, phătc Phao-lô yămz wa bongc Zâu Tênb-Huungh nyăngz pyau, songđ lungz njinh songx munh hongđ taih toopz zoz Phao-lô, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />hamv coong: “Tinyh đoih I-sa-la-ên nyăngz munh lex, joođ stăngc đôih! Nâyx tauh munh six ninyh muif đoif nzaox tinyh đoih nzeengz cloon pec stingx, nzeengz gâyf njanh cloon nâyx nomz tinc. Nzof nănh yâuc năngx ênz Hi-lapc munh nzac bongc Zâu Tênb-Huungh nyăngz pyau ninyh, ayx wâyx nây đăngb zeengh nyăngz tinc.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Wâyc cah đangc, stiz phătc Tô-phi-mat, Ê-phê-sô munh, cloon Phao-lô yămz wa dlanyh, stiz songđ nyâyh coong Phao-lô ênz cloon wax tauh munh nzac bongc Zâu Tênb-Huungh nyăngz pyau. <verse eid="ACT 21:29" /><verse number="30" style="v" sid="ACT 21:30" />Lomc wa dlanyh munh lunc nzuf, naih ah peob songx munh hongđ taih zoz Phao-lô, stiz ênz nănh setb wa bongc Zâu Tênb-Huungh nyăngz pyau cungh ngwaic ninyh, songđ lênh dlih omz jeengh. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Stiz jinh đangh lov jau tayx nănh wax zanyf, nâyx đomc wac songđ lănv ninyh tauv wax tauh tômx peengz pyây numđ coong lomc Yê-lu-sa-lem dlanyh jinh đangh lunc nzuf, <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />nănh songđ lênh dlih ênz peengz cloon wax đomc peengz pyây, coonx tiuv nzac wa songx munh hongđ ninyh. Tăng wa munh phătc wax tauh peengz pyây cloon wax đomc peengz, stiz songđ sec max bopc Phao-lô. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Tăng wa, wax tauh peengz pyây songđ ninyh tauv stătx zoz Phao-lô, setb lanyf êu nongc iz stinz njab langb stayb nănh, songđ naic jađ nănh six mănv, yâuc naic jađ nănh ayx laiv luungđ dlayc. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Six yămz songx munh hongđ cah njaf, ah lanh cănh hamv coong ah huungđ, ah lanh cănh hamv coong ah huungđ max tinyh năngđ, nzof wax tauh peengz pyây songđ max hayh zah tuz setb laiv huungđ six senz, wâyc munh lunc nginyz nginyz têx, songđ setb lanyf êu ênz Phao-lô muf wa peengz tinc. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Six Phao-lô ah taih tauv wa cac đany wax zanyf, peengz songđ zuc zeengz nănh ninyh wâyc zuc songx munh okx nzongf. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Yâuc naih ah peob munh hongđ nzongf njinh luh lêpc đangz, hamv coong: “Tayx nănh gôh!”<verse eid="ACT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Tauv cayx zuc ênz nzac wa peengz tinc ninyh, Phao-lô songđ naic wax tauh tômx peengz pyây coong: “Yaz tuz coong tix cay wac ănz mâyh max?” Wax tauh tômx peengz pyây songđ coong: “Mâyh cayb hayh coong Hi-lapc wac yah? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Ha nâyx mâyh six cayb max zâyf wax tauh I-yipx munh, cah đangc nây nyăngz noib taih sêu lunc yâuc ênz cloon pyâyz tinb lanh tayx munh nyăngz munh, ninyh wa stâyz phangz blănf wax tauh munh haz?” <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />Phao-lô songđ coong: “Yaz six Yu-tai munh, yămz Ta-sat dlanyh, Si-li-si stâyz phangz, ah lanh pec stingx yămz naih manyh yangh lub nyăngz dlanyh. Wâyc nây yaz joođ mâyh phunz yaz coong cay wac ănz songx munh.” <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />Tăng wa, wax tauh tômx peengz pyây songđ nyenc phunz, Phao-lô songđ stâuđ wa cac cah zâyc peengh, zaub puf ănz songx munh. Tauv numđ stinyb njâuh, nănh songđ nongc Hipc-lu wac coong:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“Yetx stong yâuf pez cloon munh côx lex, joođ mungv yaz nâyx zanyf coong cay yaz nyăngz jau lâuc ănz nyâuh.”<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />Wax zanyf, numđ nănh nongc Hipc-lu wac coong ănz stiz, stiz zef năngx stinyb njâuh têx timb. Phao-lô songđ coong:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />“Yaz six Yu-tai munh steengb stâyv yămz Ta-sat dlanyh, Si-li-si stâyz phangz, six tuz yămz nâyx nomz dlanyh lub taih, tuz Tăng Ga-ma-li-ên stênx steengb nzaox âyz pănh claof jex wax đomc gâyf njanh nyăngz jau, yaz yâuc joomz nyâuđ Zâu Tênb-Huungh nzongf, lauf cayx năngđ nyâuh nâyx noib yămz nây nyăngz muif lanh nâyx, <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />yaz yâuc tuz ayx huđ ănz lêpc nâyx huungđ gâyf wax đomc tuz tauv tayc, ninyh zoz njinh munh pha cloon munh nzif stayb ênz lauf ănz nzauh, <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />coong tauv nâyx đomc, six naih stayb munh pyây cloon wax đomc songx munh côx ayx zanyx manyf phunz yaz, stiz six wax đomc munh pungx stâub phunz yaz nzâyz ninyh phunz wa Đa-mat dlanyh wax đomc yâuf pez, yaz six cayx ninyh wa nongc zoz stayb yămz wa nyăngz munh ênz lauf Yê-lu-sa-lem, nongc phađ stiz. <verse eid="ACT 22:5" /><verse number="6" style="v" sid="ACT 22:6" />Wax zanyf, yaz njinh đangh setb jau ninyh cayx tauv Đa-mat dlanyh, cox đamx noib, lênh dlih, naih gwăngz lub nzongf tăng guungh nzac taih siux yaz nzêux nzuf. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Yaz songđ glinyf nzac nib ninyh yâuc numđ naih stingb coong ănz yaz, coong: ‘Sau-lô lex, Sau-lô, Săngh laix mâyh bix ayx huđ ănz Yaz?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Yaz songđ tauz coong: ‘Zâu lex, Mâyh six mănv heh?’ Nănh songđ coong ănz yaz: ‘Yaz six Yê-su Na-sa-leetx munh, six mâyh jinh đangh ayx huđ ănz wax Tauh.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Wax zanyf, wax đomc cloon yaz yămz wa nyăngz munh mangc phătc wax cuyb gwăngz, six stiz max numđ coong wac ănz yaz wax Tauh nyăngz stingb. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Nzof yaz songđ coong: ‘Zâu lex yaz oix zuc ayx laix heh?’ Tăng wa, Zâu coong ănz yaz: ‘Nyoongz quef, bix nzac wa Đa-mat dlanyh ninyh, yămz wa mâyh oix zuc ayx laiv luungđ cănh naih munh bux phunz mâyh nzuf.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Wâyc tăng wax cuyb gwăngz eeng yaz songđ max phătc jau, zuc păngc cloon yaz yămz wax đomc munh nzauf puf jinb yaz nzac wa Đa-mat dlanyh ninyh. <verse eid="ACT 22:11" /><verse number="12" style="v" sid="ACT 22:12" />Wax zanyf, naih ah lanh munh hipđ ayx A-na-ni, senz joomz nyâuđ lêpc gongx gâyf njanh, tuz yămz wa nyăngz Yu-tai munh muif lanh ayx zanyx manyf gongx phunz, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />nănh taih pongh yaz, stâuđ yaz nyăngz cah sinh yâuc coong: ‘Tah Sau-lô lex, phătc jau gôh.’ Toongx wax nomz săngx huđ, yaz songđ mangc phătc nănh. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Tăng wa, nănh songđ coong: ‘Pănh claof jex nyăngz Zâu Tênb-Huungh sên mâyh taih nongc phunz pâyz Nănh nyăngz zux ix, yâuc tuz phătc Peengh Stimz Wax Tauh, yâuc tuz numđ tăng Nănh nzetx coong nyăngz wac, <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />wâyc mâyh six yămz muif lanh munh nyăngz cah đangc ayx zanyx manyf phunz Nănh, coong tauv mâyh tuz phătc cloon tuz numđ wax đomc. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Nâyx zanyf, mâyh bix năngx ngaih luungđ heh? Nyoongz quef, tim Zâu nyăngz manyh ayx quaix-gâyf, phunz mâyh tuz dlăngc stoif gôh.’ <verse eid="ACT 22:16" /><verse number="17" style="v" sid="ACT 22:17" />Tăng wa, yaz phunb đangz lauf Yê-lu-sa-lem, yămz bongc Zâu Tênb-Huungh nyăngz pyau jinh đangh cloo Zâu wax zanyf, songđ phătc hinđ yangh nyăngz jau. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Yaz phătc Zâu Yê-su coong ănz yaz, coong: ‘Oix zuc coonx lênh dlih setb nây Yê-lu-sa-lem, wâyc stiz six max mungv mâyh ayx zanyx manyf phunz Yaz nyăngz wac.’ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Yaz songđ coong: ‘Zâu lex, stiz cănh pâyz coong yaz yămz săngh nomz huyđ toongh zoz wax đomc zen Mâyh nyăngz munh bopc yâuc ănz nzauh. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Yămz Ê-tên nyăngz samđ zuc setb wâyc ayx zanyx manyf phunz Zâu wax zanyf, yaz lauf stâuđ wa cah sinh numđ hoođ, yâuc nzauf cungh ngwaic guyz phunz tayx nănh wax đomc munh.’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Zâu songđ coong ănz yaz coong: ‘Oix zuc ninyh, wâyc Yaz paiđ mâyh ninyh tauv yămz côz wax đomc pitc stingx munh.’”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Wax zanyf, songx munh mungv Phao-lô coong tauv nâyx zâux wac, stiz songđ hamv coong: “Oix zuc mêtc lâyc loif munh gâyh nây nib minc, max hoopđ zuc phunz nănh săngh.” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Stiz songđ hamv stingb lub, zay cungh ngwaic yămc guyz quanyf, yâuc yamc nib buungb staox guungh ninyh, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />wax tauh tômx peengz pyây songđ setb lanyf êu ênz Phao-lô nzac wa peengz tinc muf, êu zoz pya stătb zah naic nănh mangc jađ wâyc laiv huungđ, songx munh bix hamv nzeengz cloon nănh ayx tuz nâyx. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Six tauv stiz nongc langb stayb nănh cayx đa nongc pya stătb, Phao-lô songđ coong ănz stâuđ wa wax tauh peengz pyây, coong: “Ha nyâuh cayb naih gâyf tuz nongc pya bopc ah lanh Lô-ma munh hănđ max zeengx zah tuz setb stoif yah?” <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />Wax zanyf, wax tauh peengz pyây numđ wax đomc wac, songđ ninyh pongh wax tauh tômx peengz pyây, yâuc coong: “Mâyh cayx ayx luungđ heh? Nâyx tauh munh six Lô-ma nyăngz pec stingx nef.” <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />Wax tauh tômx peengz pyây, songđ ninyh coong ănz Phao-lô: “Oix zuc phunz yaz pâyz mâyh zâyf Lô-ma nyăngz pec stingx max?” Nănh songđ tauz: “Zâyf.” <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />Wax zanyf tômx peengz pyây songđ coong: “Yaz zuc zoz nyanh đuungx maif nzăngđ tuz săngh wax huungđ pec stingx.” Six Phao-lô coong: “Yaz six tăng steengb taih bix tuz săngh nzof.” <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />Tăng wa cayx stămđ nănh wax đomc munh songđ toiv gâyh nănh nzuf, năngx naih wax tauh tômx peengz pyây yâuc cumh nzav, wâyc pâyz coong nănh zoz stayb nâyx tauh Phao-lô six Lô-ma nyăngz pec stingx.<verse eid="ACT 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Tauv nyâyc noib, tômx peengz pyây oix pâyz tuz coong, săngh laix Phao-lô bix zuc Yu-tai munh cooux, songđ êu zay Phao-lô, songđ setb lanyf êu wax đomc stayb munh cloon yetx stong stămđ zăngc quanz taih căpx dlonf. Songđ ênz Phao-lô taih, phunz nănh stâuđ yămz stiz wa mungh tongx.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Phao-lô si mangc staox wax đomc stămđ zăngc quanz ninyh, yâuc coong: “Yâuf pez lex, yaz săngh yămz Zâu Tênb-Huungh nyăngz cah đangc, yâuc ayx stimz nyâuđ đăngb zeengh tuz tauv nâyx yenh.” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Six stayb munh pyây A-na-ni setb lanyf êu stâuđ stătx Phao-lô wax đomc munh beb Phao-lô nyăngz nzetx. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Tăng wa, Phao-lô songđ coong ănz nănh: “Mâyh lâyc tungđ leetc cungh ngwaic pec nyăngz gongc lex, Zâu Tênb-Huungh cayx bopc mâyh gôh! Mâyh stâyv lâyc âyz gâyf njanh stămđ yaz, bix năngx setb lanyf bopc yaz ayx longđ cloon gâyf njanh naz?” <verse eid="ACT 23:3" /><verse number="4" style="v" sid="ACT 23:4" />Six stâuđ wa cah sinh wax đomc munh yâuc coong: “Mâyh năngx mađ Zâu Tênb-Huungh nyăngz stayb munh pyây naz?” <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />Phao-lô coong: “Yâuf pez lex, Yaz max pâyz coong nănh six stayb munh pyây. Wâyc naih ja coong: ‘Mâyh năngx gâyf coong đokc ănz ayx côx cun pec stingx nyăngz munh.’”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Phao-lô pâyz coong yămz wa naih ah phanx six Sa-đu-si munh, nzof naih ah phanx six Pha-li-si munh, nănh songđ yămz wa stămđ zăngc quanz cah đangc hamv stingb lub coong: “Yâuf pez lex, Yaz six Pha-li-si munh, ayx Pha-li-si munh nyăngz sây; Nâyx zanyf yaz zuc stămđ six wâyc pănh nyăngz njih mungc cloon munh tayx săngh taih nyăngz jau.” <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />Wax zanyf nănh coong ayx nâyx, Pha-li-si munh cloon Sa-đu-si munh songđ naih tinyh zenđ setb taih, wax peob songx munh songđ phunz goib taih. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Wâyc Sa-đu-si munh coong munh tayc max hayh săngh taih, yâuc max naih stinz munh max six manđ, six Pha-li-si munh yâuc zen coong njinh wa iz huungđ six naih nzuf. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Tăng wa, songđ tinyh nzeengz hamv stingb lub setb taih, naih ah đomc nzaox gâyf stênx steengb Pha-li-si wax huungđ munh, nyoongz quef nzeengz coong: “Buz max phătc nâyx lanh munh naih laiv huungđ stoif huđ nhlenz. Ha săngx đanyf, naih tix tauh manđ max six stinz munh coong ănz nănh …” <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />Wax cuyb tinyh zenđ nyăngz dlayc songđ cun ayx cun nzongf, wax tauh tômx peengz pyây songđ wangb Phao-lô zuc stiz zeb ayx săngh tuyđ, songđ setb lanyf êu peengz ninyh zab Phao-lô tăng stiz wax peob munh, yâuc ênz nănh muf wa peengz tinc.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Six tauv nyâyc munf Zâu taih yămz nănh nyăngz cah sinh, yâuc coong: “Oix zuc pungx nyâuđ bex, wâyc mâyh yămz Yê-lu-sa-lem ayx zanyx manyf phunz Yaz năngđ laix, mâyh lauf oix zuc Yămz wa Lô-ma ayx zanyx manyf năngđ wa nâyx.”<verse eid="ACT 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Tauv guungh gwăngz naih ah đomc Yu-tai munh tinyh đoih ta zux ix yâuc cănh nyunc coong, max nhlinc max hopb ayx tuz tauv laiv zanyf stiz tayx tuz Phao-lô. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Wax zanyf, cox naih stâyx săpc đuungx lanh munh ta nâyx huungđ zux ix, <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />stiz songđ ninyh pongh wax đomc stayb munh cloon wax đomc munh côx, yâuc coong: “Buz bâyf tinyh cloon njăpc nyunc wac ănz cănh nyăngz stinb coong max nhlinc luungđ ayx tuz tauv laiv zanyf buz tayx tuz Phao-lô. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Wâyc nây, nâyx zanyf joođ nyâuh cloon wax stămđ zăngc quanz setb minb pongh wax tauh tômx peengz pyây, ayx cayx năngđ cay oix năngx cayb zah stămđ Phao-lô nyăngz dlayc năngx yox timb, phunz nănh ênz Phao-lô lauf phunz nyâuh. Nzof buz six zu nănh lauf max zeengx tauv tinc bix tayx nănh.” <verse eid="ACT 23:15" /><verse number="16" style="v" sid="ACT 23:16" />Six Phao-lô ô nyăngz toonz, tuz numđ coong nâyx đomc munh zu jau, nănh songđ nzac wa peengz tinc ninyh, bux nâyx đomc wac ănz Phao-lô. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Tăng wa, Phao-lô songđ êu ah lanh peengz pyây taih, yâuc coong: “Joođ ênz nâyx tauh munh ninyh pongh tômx peengz pyây, wâyc nâyx tauh munh naih wac oix coong ănz nănh.” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Wax tauh peengz pyây songđ ênz nănh ninyh pongh wax tauh tômx peengz pyây yâuc coong: “Phao-lô nzauh munh êu yaz ênz nâyx tauh munh taih pongh mâyh, wâyc naih wac oix coong ănz mâyh.” <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />Wax tauh tômx peengz pyây songđ nzauf nănh nyăngz puf ênz ninyh lanyc, songđ naic coong: “Mâyh naih luungđ wac oix bux ănz yaz heh?” <verse eid="ACT 23:19" /><verse number="20" style="v" sid="ACT 23:20" />Nănh songđ coong: “wax đomc Yu-tai munh hoopđ nyâuđ, cayx taih joođ mâyh êu tauv sangx đoomz bix ênz Phao-lô ninyh phunz stămđ zăngc quanz, ayx cayx năngđ cay cayx zah naic Phao-lô năngx yox. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Wâyc nây, joođ mâyh năngx gâyf zen stiz, wâyc stiz naih stâyx săpc đuungx lanh munh jinh đangh meem wa zu nănh, wax đomc munh stiz cănh nyunc coong max nhlinc max hopb ayx tuz tauv laiv zanyf tayx tuz Phao-lô. Nâyx zanyf stiz six jinh đangh bênc săngh wa, zu mâyh nyenc nyăngz wac cuungv.” <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />Tăng wa, tômx peengz pyây songđ phunz nănh muf, yâuc zăpx nănh coong: “Năngx gâyf phunz mănv pâyz coong mâyh bux nâyx đomc wac ănz yaz bex.” <verse eid="ACT 23:22" /><verse number="23" style="v" sid="ACT 23:23" />Tômx peengz pyây songđ êu iz lanh peengz pyây taih, bux coong: “Ninyh bênc iz pez lanh yăngh jau peengz, cloon jetb săpc lanh zâyh maf peengz, cloon iz pez lanh nzauf wic peengz, ayx tuz nâyx munf đuh săngx huđ peengz bix tuz setb jau ninyh Si-sa-li-ya dlanyh, <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />bênc cloon stanyb hauđ phunz Phao-lô nongc zâyh, phunz wax peob peengz hayh tuz peengh oonz ninyh tauv Phê-lik quanz pyây wa,” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />nănh yâuc ja ah zây jenx phunz wax tauh quanz coong:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“Saix nyăngz Phê-lik quanz lex, yaz Ca-lau-đi-atc Li-sêt; Joođ đeh mâyh. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Nâyx tauh munh zuc Yu-tai munh zoz yâuc cayx caiđ zuc stiz tayx, yaz songđ cloon peengz ninyh tuz saic njâuv nănh, wâyc pâyz coong nănh six Lô-ma nyăngz pec stingx. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Yâuc wâyc oix pâyz tuz săngh laix stiz bix cooux nănh, Yaz nzăngđ ênz nănh ninyh phunz stiz nyăngz stămđ zăngc quanz, <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />nzof yaz phătc nănh zuc cooux six cungb coong tauv stiz cănh nyăngz gâyf cuungv, yâuc max phătc naih cooux laiv huungđ stoif hoopđ zuc tayc max six yămz nzauh. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Yaz yâuc tuz pâyz coong munh ta zux ix hoiđ nănh, yaz songđ coonx ênz nănh taih phunz mâyh, yâuc bux phunz cooux nănh wax đomc munh coong oix zuc ninyh yămz mâyh nyăngz cah đangc cooux nănh.”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Tăng wa, wax đomc peengz âyz jaoz phunz stiz nyăngz lanyf songđ ênz Phao-lô njinh nzămc ninyh tauv An-ti-ba-ti. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Tauv nyâyc noib, wax đomc yăngh jau peengz songđ phunb đangz muf wa peengz tinc, phunz wax đomc zâyh maf peengz cloon Phao-lô ninyh timb, <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />nâyx peob peengz, ninyh tauv wa Si-sa-li-ya dlanyh songđ jaoz jenx phunz wa tauh quanz pyây, yâuc jaoz Phao-lô phunz nănh. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Toc jenx tuz nănh songđ naic Phao-lô coong steengb stâyv yămz laiv nomz stâyz phangz, yâuc pâyz tuz coong steengb stâyv yămz Si-li-si stâyz phangz, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />wax tauh quanz pyây coong: “Tauv cooux mâyh wax đomc munh taih tauv yaz six âyz gâyf bix stămđ mâyh,” yâuc paiđ êu peengz jămđ nănh yămz Hê-lôtx nyăngz huungh tinc.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Wax zanyf, pyaz noib cah đangz, stayb munh pyây A-na-ni, cloon ah đomc munh côx, cloon pob gâyf munh hipđ ayx Tê-tu-lat, ninyh tauv stiz six ninyh yămz quanz pyây nyăngz cah đangc nongc cooux Phao-lô. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Êu tuz Phao-lô taih, Tê-tu-lat songđ quef coonz cooux Phao-lô, coong: “Quanz lub lex, wâyc tuz tăng mâyh bix tuz taix peengh yămz, yâuc wâyc mâyh six nyâuđ njaf nyâyh tuz quăng, nâyx huungđ pec stingx naih đuungx huungđ max săngh mâyh yâuc zany tuz săngh, <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />saix nyăngz Phê-lik quanz lex, păngc mâyh bix yămz manf dlayc yâuc tuz peengh oonz yămz, buz senz numđ hâuđ tauv nâyx đomc muif huungđ jau. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Six max oix taih zenv mâyh nyăngz săngx huđ đao, yaz joođ mâyh pungx nyâuđ mungv buz coong cay tix zâux wac. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Wâyc phătc nâyx lanh munh six cayx năngđ staiz gumc, nănh yâuc sêu phunz yămz pong nây guungh đi nyăngz Yu-tai munh lunc nzuf, yâuc ayx pyây yămz Na-sa-leetx wax peob munh, <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />nănh yâuc cah đanyc ayx wâyx bongc Zâu Tênb-Huungh nyăngz pyau, buz nzăngđ zoz nănh, — [nzof buz yâuc oix âyz buz nyăngz gâyf stămđ. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Six wax tauh tômx peengz pyây Li-sêt taih nongc lanyf tăng buz nyăngz puf tauh zab nănh, <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />yâuc setb lanyf êu cooux nănh wax đomc munh oix zuc taih yămz mâyh nyăngz cah đangc] — yămz nâyx đomc muif huungđ dlayc, mâyh lauf cănh hayh zah naic tăng nănh, bix tuz setb buz cooux nănh nyăngz stoif.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Nzof, Yu-tai munh yâuc tinyh đoih coong, nâyx đomc dlayc six senz naih.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Tăng wa, wax tauh quanz pyây songđ hiđ phunz Phao-lô coong Phao-lô songđ coong: “Wâyc pâyz tuz mâyh ayx quanz pob wekc phunz nâyx huungđ pec stingx tuz đuungx nyăngv, yaz songđ numđ nyađ cănh coong tauv yaz nyăngz jau, <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />wâyc mâyh cănh pâyz tuz coong tăng yaz muf wa Yê-lu-sa-lem nongc canyx bongc six max zeengx blătc săpc nyâyc noib, <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />stiz yâuc max phătc yaz căn mănv yămz wa bongc Zâu Tênb-Huungh nyăngz pyau tinyh panx, yâuc max lungz ayx phunz songx munh lunc, yămz wax đomc huyđ toongh max six yămz môngf sangc, <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />yămz stiz nâyx zanyf cooux yaz wax đomc stoif, stiz yâuc max hayh zoz luungđ nongc ayx zanyx manyf phunz mâyh. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Six yaz nyenc cloon mâyh nâyx huungđ, coong âyz năngđ stiz hipđ ayx za gâyf wax huungđ, yaz yâuc bongc wax đomc claof jex nyăngz Zâu Tênb-Huungh, zen âyz gâyf njanh ja taih nyăngz jau cloon wax đomc tâuc wac munh nyăngz stâub ja taih nyăngz wac, <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />naih njih mungc yămz Zâu Tênb-Huungh cayx năngđ stiz lauf jinh đangh naih nâyx, six zen coong peengh stimz munh cloon munh huđ munh six năngx tuz săngh taih. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Yâuc wâyc nâyx, yaz nzăngđ nzac jab ayx laix tuz ah nomz stimz max naih tinc nzêmh yămz Zâu Tênb-Huungh nyăngz cah đangc cloon munh nyăngz cah đangc. <verse eid="ACT 24:16" /><verse number="17" style="v" sid="ACT 24:17" />Nzof, tuz batz nyăngv nây yaz ninyh côz, yaz nzăngđ phunb đangz lauf, nzâyz nyanh lauf stăngc phunz cănh nyăngz côkz pâu, cloon congx nyăngz tax huungđ, <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />yâuc toix wax zanyf stiz pongh yaz ayx stav wâyx yămz wa bongc Zâu Tênb-Huungh nyăngz pyau, max cloon munh hongđ, yâuc max naih tinyh nzeengz nyăngz jau. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Six tăng Ê-si taih wax đomc Yu-tai munh, wax đomc munh six hoopđ zuc taih yămz mâyh nyăngz cah đangc bix cooux yaz, năngđ coong stiz naih tix huungđ nongc cooux. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Max six nâyx đomc yămz nây nyăngz munh six zuc coong stiz lov tuz phătc yaz ayx longđ laiv huungđ, yămz yaz stâuđ wa Yu-tai munh nyăngz stămđ zăngc quanz cah đangc wax zanyf, <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />năngđ naih six lauf cungb stâuđ stiz wa mungh tongx wax zanyf, yaz bix hamv coong ah zâux wac ayx nâyx, coong: ‘Yaz nâyx noib zuc stămđ yămz nyâuh nyăngz cah đangc six wâyc munh tayc săngh taih nyăngz jau.’”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Tăng wa Phê-lik pâyz tuz yox wax huungđ Gâyf, songđ sec đangc max stămđ iz leepb, yâuc coong: “Laiv zanyf wax tauh tômx peengz pyây Li-sêt taih tauv nây, yaz mănc stămđ nyâuh nâyx đomc dlayc,” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />yâuc setb lanyf êu peengz pyây jămđ Phao-lô, yâuc coong oix zuc phunz nănh tuz pungx stimz, năngx gâyf cangđ nănh nyăngz munh taih lif nănh wax đomc.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Blătc batz noib cah đangz, Phê-lik, cloon nănh nyăngz au Đu-sin-la, six ah lanh Yu-tai munh nzif, taih, songđ êu Phao-lô taih yâuc mungv nănh lănv tauv zen Zâu Yê-su Jix-Tuz nyăngz jau. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Six tauv Phao-lô lănv tauv peengh stimz nyăngz jau cloon wăn stimz nyăngz jau, cloon đangz noib zuc tingc stoif nyăngz jau, Phê-lik songđ numđ cumh nzav, yâuc coong: “Nâyx zanyf bix muf gôh, laiv zanyf hênh, yaz mănc êu mâyh taih.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Wax zanyf, yâuc wâyc nyâyh mungc oix tuz Phao-lô đăpx tix cay nyanh phunz nănh, wâyc nây wax tauh quanz pyây, songđ njinh luh êu Phao-lô taih cloon coong wac max setc tiny. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />Six tauv tuz iz nyăngv, naih munh taih tayv Phê-lik six Bo-si-atc Phê-sa-tat, yâuc wâyc oix tuz Yu-tai munh nyăngz nyâuđ, Phê-lik songđ njinh luh clăngđ Phao-lô.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Phê-sa-tat taih tauv nănh nyăngz steengv tuz pôz noib cah đangz, nănh tăng Si-sa-li-ya ninyh wa Yê-lu-sa-lem. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Tăng wa, wax đomc stayb munh pyây cloon Yu-tai munh nyăngz pyây tauv laiv taih yămz nănh nyăngz cah đangc cooux Phao-lô, stiz yâuc joođ nănh, <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />stiz joođ ah stinz jau nongc nzeengz cloon Phao-lô, coong êu wax tauh quanz pyây phunz Phao-lô muf wa Yê-lu-sa-lem, wâyc stiz ta zux ix toon wa bah đamx jau tayx nănh. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Phê-sa-tat tauz coong Phao-lô jinh đangh zuc clăngđ ănz wa Si-sa-li-ya, nzof nănh songđ cayx phunb đangz muf căn gôh. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Nănh zef coong: “Wâyc nây, yămz nyâuh cah njaf wax đomc ayx côx munh, tauv lêpc muf wa, năngđ coong nâyx tauh munh naih longđ laiv huungđ stoif, stiz mănc cooux nănh.”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Phê-sa-tat cloon stiz yămz max blătc yetc noib max six săpc noib nănh songđ muf wa Si-sa-li-ya. Tauv nyâyc noib, nănh ninyh stâyv wa stămđ stoif tinc, yâuc êu ênz Phao-lô taih. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Phao-lô ah yac taih tauv wax zanyf, tăng Yê-lu-sa-lem taih wax đomc Yu-tai munh songđ ninyh sêmz nănh nzuf, coong đuungx huungđ stoif niđ nzongf plongz nănh, six stiz yâuc max naih luungđ ayx zanyx manyf, <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Phao-lô songđ cănh pyenv coong: “Yaz max longđ laiv huungđ stoif nzeengz cloon Yu-tai munh nyăngz gâyf njanh, yâuc max nzeengz cloon bongc Zâu Tênb-Huungh nyăngz pyau yâuc max nzeengz cloon Sê-sa.” <verse eid="ACT 25:8" /><verse number="9" style="v" sid="ACT 25:9" />Six wâyc oix tuz Yu-tai munh nyăngz nyâuđ, Phê-sa-tat songđ naic Phao-lô coong: “Mâyh oix muf yămz wa Yê-lu-sa-lem, nongc stămđ tauv nâyx đomc jau yămz yaz nyăngz cah đangc max?” <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />Six Phao-lô coong: “Yaz six zuc ninyh yămz Sê-sa nyăngz stămđ stoif tinc cah đangc, yaz six sămv zuc yămz wa nongc stămđ. Yaz max ayx laiv huungđ longđ cloon Yu-tai munh, cayx năngđ mâyh lauf pâyz yox nâyx. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Yaz năngđ coong longđ stoif max six ayx tix huungđ hoopđ zuc tayc, yaz six max pyenv tayc. Six năngđ coong yămz stiz cooux yaz wax đomc jau bix max naih, yâuc max naih mănv hayh jaoz yaz phunz stiz. Yaz joođ ninyh tauv Sê-sa.” <verse eid="ACT 25:11" /><verse number="12" style="v" sid="ACT 25:12" />Tăng wa, Phê-sa-tat cloon wax đomc stămđ zăngc quanz sangv tuz, songđ coong: “Mâyh joođ ninyh tauv Sê-sa. Mâyh six tuz ninyh tauv Sê-sa!”<verse eid="ACT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Blătc batz noib, A-gi-ba huungh cloon Bê-nit nzac taih tauv Si-sa-li-ya dlanyh, nongc ninyh pongh Phê-sa-tat. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Stiz yămz wa đuungx noib nyăngz săngx huđ, Phê-sa-tat songđ lănv Phao-lô nyăngz jau phunz wax tauh huungh, coong: “Naih ah lanh munh pha, six nzauh munh tăng Phê-lik njâuh ănz nây, <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />nâyx tauh munh, yaz yămz wa Yê-lu-sa-lem wax zanyf, wax đomc stayb munh cloon Yu-tai munh wax đomc munh côx taih cooux nănh, yâuc êu yaz tingc stămđ nănh. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Yaz tauz ănz stiz coong Lô-ma nyăngz gâyf six max tuz jaoz laiv lanh munh năngđ coong zuc cooux nyăngz munh bix năngx jinh caix cloon ninyh cooux nyăngz munh, nzof yâuc năngx tuz congv cănh pyenv tauv zuc cooux wax đomc jau. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Stiz songđ tinyh ênz taih nây, yaz songđ max ngaih tauv nyâyc noib ninyh stâyv yămz stămđ stoif tinc, êu ênz wax tauh munh taih, <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />wax đomc cooux nănh nyăngz munh, tauv êu stâuđ quef taih coong, stiz yâuc max naih cooux tauv laiv huungđ okx nyăngz stoif năngđ yaz nyâyh nâyx. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Nzof stiz yâuc cungb cloon nănh nzeengz tauv stiz nyăngz gâyf cuungv, yâuc coong tauv wax tauh Yê-su tayc bix Phao-lô yâuc njinh luh coong six năngx jinh săngh. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Yămz nâyx đomc tinyh zenđ nyăngz jau, wâyc max pâyz tuz senz, yaz songđ naic wax tauh munh coong oix ninyh tauv wa Yê-lu-sa-lem nongc yămz wa stămđ tauv nâyx đomc jau max. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Six Phao-lô yâuc joođ êu phunz nănh tuz ninyh yămz huungh nyăngz cah đangc nongc stămđ, yaz songđ setb lanyf êu jămđ nănh tuz tauv laiv zanyf yaz ênz nănh ninyh phunz tauv Sê-sa.” <verse eid="ACT 25:21" /><verse number="22" style="v" sid="ACT 25:22" />A-gi-ba songđ coong ănz Phê-sa-tat: “Yaz lauf oix tuz mungv nâyx tauh munh.” Nănh songđ tauz: “Tauv sangx đoomz huungh cănh tuz mungv nănh.”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Tăng wa, tauv nyâyc noib, A-gi-ba cloon Bê-nit zoongz dloih nzuf taih nzac wa stămđ stoif tinc, cloon wax đomc quanz lub cloon yămz wa dlanyh wax đomc ayx côx munh tauv laiv, tăng wa Phê-sa-tat songđ setb lanyf êu ênz Phao-lô taih. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Phê-sa-tat coong: “A-gi-ba huungh cloon muif lanh naih minb cloon buz yămz nây nyăngz munh lex, nyâuh jinh đangh tuz phătc nâyx lanh munh, nănh six naih ah peob Yu-tai munh hongđ nzongf njinh yămz wa Yê-lu-sa-lem cloon yămz nây nyăngz munh tinyh đoih joođ yaz, hamv coong năngx gâyf phunz nănh săngh gôh. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Six yaz pâyz tuz coong nănh max ayx laiv huungđ hoopđ zuc tayc. Nzof wâyc nănh cănh joođ ninyh tauv Sê-sa huungh, yaz songđ tingc săngh ênz nănh ninyh, <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />yaz yâuc max naih luungđ senz nyăngz nongc coong tauv nâyx tauh munh nyăngz jau phunz Sê-sa huungh. Wâyc nây, yaz ênz nănh taih yămz nyâuh nyăngz cah đangc, nzof năngx nongc sen quaix six yămz A-gi-ba huungh nyăngz cah đangc, nongc phunz blătc nâyx noib zah naic nyăngz jau, yaz bix hayh tuz tix huungđ nongc phunz yaz coong. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Wâyc zuc yaz năngđ coong, ênz ah lanh stoif munh ninyh bix max naih cay luungđ nongc cooux nzeengz cloon nănh, six senz numđ max săngh.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Wax zanyf, A-gi-ba huungh coong ănz Phao-lô: “Mâyh tuz cănh coong mâyh nyăngz dlayc.” Tăng wa, Phao-lô songđ stuungb puf, yâuc pyenv coong:<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“A-gi-ba huungh lex, yaz zuc Yu-tai munh cooux nâyx đomc jau, yaz numđ nyađ wâyc nâyx noib tuz cănh yămz huungh nyăngz cah đangc nongc pyenv yaz nyăngz jau, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />wâyc zuc huungh lauf cănh pâyz tuz nzuf Yu-tai munh nyăngz gâyf cloon stiz tinyh nzeengz nyăngz jau. Wâyc nây yaz joođ huungh pungx stimz mungv yaz. <verse eid="ACT 26:3" /><verse number="4" style="v" sid="ACT 26:4" />Nzof, muif lanh Yu-tai munh lauf pâyz tuz yaz tăng năngx jenz săngh nyăngz jau, quef coonz tăng yămz Yê-lu-sa-lem staox taih yămz buz nâyx huungđ pec stingx mungh tongx, <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />wâyc pâyz yaz jauh nzof, năngđ coong stiz oix ayx zanyx manyf, six ayx coong yămz buz nyăngz gâyf yaz six săngh âyz Pha-li-si wax huungđ munh, senz năngx neetb quaix wax huungđ munh. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Nâyx zanyf, yaz stâuđ yămz nây zuc stămđ six wâyc naih njih mungc yămz Zâu Tênb-Huungh njăpc cloon buz wax đomc claof jex nyăngz nyunc wac, <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />nây nyunc nyăngz wac buz săpc nyâyc stingx munh senz joomz nyâuđ nzongf, jinh đangh sâub sâuđ zu tuz stipx, songđ noib munf bongc Zâu Tênb-Huungh. Huungh lex, six wâyc nâyx huungđ njih mungc, yaz bix zuc Yu-tai munh cooux. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Năngđ coong Zâu Tênb-Huungh ayx phunz munh tayc săngh taih, săngh laix nyâuh bix max zen tuz wax đomc jau? <verse eid="ACT 26:8" /><verse number="9" style="v" sid="ACT 26:9" />Senz nâyx, yaz lauf cănh numđ sămv zuc ayx đuungx huungđ jau nongc nzeengz cloon Yê-su Na-sa-leetx nyăngz manyh, <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />nâyx đomc cumh pâuz yaz senz ayx yămz wa Yê-lu-sa-lem, yaz lôx zef năngx zoz đuungx lanh đăngb zeengh munh clăngđ ănz nzauh wâyc tuz stipx tăng wax đomc stayb munh pyây nyăngz lanyf, nzof phătc stiz zuc tayx tayc wax zanyf, yaz yâuc numđ hoođ nyâuđ. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Yâuc njinh leox nzac muif nomz huyđ toongh ninyh phađ stiz, yaz yâuc yac ayx tuz stiz zuc coong pamf, yâuc wâyc hănđ stiz nzuf zomc, yaz zef năngx ninyh tauv pitc nomz côkz wax đomc dlanyh ayx huđ ănz stiz, <verse eid="ACT 26:11" /><verse number="12" style="v" sid="ACT 26:12" />nzof yămz ayx huđ wax đomc jau, tauv jinh đangh setb jau ninyh wa Đa-mat dlanyh, yâuc tuz tăng wax đomc stayb munh pyây jaoz lokc jangx cloon lanyf phunz, <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />six huungh lex, đamx noib wax zanyf, yămz bah đamx jau, yaz phătc gwăngz tăng guungh nzac, gwăngz eeng năngx nzongf têx bah noib, siux yaz nzêux nzuf cloon jinh đangh lêpc yaz ninyh wax đomc munh. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Buz songđ tinyh đoih glinyf nzac nib ninyh, yaz numđ naih stingb nongc Hipđ-lu wac coong ănz yaz: ‘Sau-lô lex, Sau-lô, săngh laix mâyh bix ayx huđ ănz Yaz? Mâyh tib nzac tonz njayc six cănh zuc zâuđ.’ <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />Yaz songđ naic coong: ‘Zâu lex, Mâyh six mănv heh?’ Zâu songđ coong: ‘Yaz six Yê-su senz mâyh ayx huđ ănz wax Tauh. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Six mâyh oix zuc nyoongz quef stâuđ mâyh nyăngz staux năngx zac, six wâyc nâyx huungđ Yaz bix hinđ taih pongh mâyh, nongc tingc săngh phunz mâyh ayx cumh pâuz yâuc ayx zanyx manyf coong tauv mâyh phătc tăng Yaz wax đomc jau, cloon Yaz hinđ phunz mâyh nyăngz jau, <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />yaz cănh njâuv mâyh gâyh đutb nâyx huungđ pec stingx cloon pitc stingx munh, yămz Yaz paiđ mâyh ninyh nyăngz tinc, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />nongc coib stiz nyăngz mâyc, yâuc tăng nzămc nyăngz tinc winb đangz lauf yămz gwăngz nyăngz tinc, yâuc tuz gâyh đutb Sax-tanx nyăngz jab lauf lov Zâu Tênb-Huungh, phunz stiz tuz quanyf stoif, yâuc tuz cloon zen yămz Yaz wax đomc đăngb zeengh munh songc phănc.’ <verse eid="ACT 26:18" /><verse number="19" style="v" sid="ACT 26:19" />Wâyc nây, A-gi-ba huungh lex, yaz max aox nhlengc ănz tăng guungh taih nâyx đomc hinđ yangh nyăngz jau, <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />nzof, yaz yâuc nzônh bux phunz yămz wa Đa-mat nyăngz munh, zef cloon yămz Yê-lu-sa-lem, cloon nzêux Yu-đê stâyz phangz, yâuc phunz cloon pitc stingx munh, coong oix zuc nhlimc stoif bix phunb đangz lauf lov Zâu Tênb-Huungh, yâuc ayx năngx hoopđ payh cloon coi nyâuđ nhlimc stoif nyăngz jau. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Yâuc wâyc nâyx đomc cumh pâuz, Yu-tai munh bix zoz yaz wa bongc Zâu Tênb-Huungh nyăngz pyau, yâuc lov jau tayx yaz. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Năngđ nây, tuz tăng Zâu Tênb-Huungh nyăngz jab stăngc omz tuz tauv nâyx noib, yaz yâuc năngx săngh, ayx zanyx manyf phunz munh sây cloon munh lub, max coong luungđ tinyh cungb coong njinh wax đomc tâuc wac munh cloon Mô-sê coong quaix đangc, coong cayx setb taih wax đomc jau — <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />coong Zâu Jix-Tuz six zuc tanyđ zâuđ, yâuc wâyc Nănh six tăng munh tayc săngh tah nyăngz zetx lanh, năngđ nây Nănh six coong gwăngz nyăngz jau phunz njinh buz nâyx huungđ pec stingx, cloon pitc stingx munh.”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Wax zanyf, Phao-lô jinh đangh nongc nâyx đomc jau coong pyenv, Phê-sa-tat songđ hamv stingb lub coong: “Mâyh vutx nzof gôh, Phao-lô lex! Mâyh hoođ đuungx huungđ jau quax ayx phunz mâyh max sting nzof.” <verse eid="ACT 26:24" /><verse number="25" style="v" sid="ACT 26:25" />Six Phao-lô coong: “Yaz max vutx đêh, saix nyăngz Phê-sa-tat lex, yaz six jinh đangh coong senz nyăngz wac yâuc sting đăngb zeengh. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Wâyc huungh pâyz tuz nâyx đomc dlayc nzuf — yaz songđ pungx stimz coong ănz nănh — wâyc yaz zen coong nâyx đomc dlayc max naih laiv huungđ pinyx tuz huungh, wâyc nâyx đomc dlayc six max zâyf coong jif cah pinyx bix ayx. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />A-gi-ba huungh lex, mâyh zen wax đomc tâuc wac munh max? Yaz pâyz coong huungh zen.” <verse eid="ACT 26:27" /><verse number="28" style="v" sid="ACT 26:28" />Six A-gi-ba coong ănz Phao-lô: “Mâyh cayx hox yaz ayx Jix-Tuz munh ah dlapc max?” <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />Six Phao-lô tauz: “Yaz joođ Zâu Tênb-Huungh năngđ max căn six manc, max zâyf cungb huungh cuungv, yâuc năngx cloon nâyx noib mungv yaz nyăngz muif lanh munh, tuz songc ah huungđ cayx năngđ yaz naih nâyx, cungb quanyf nâyx đomc njab langb cuungv.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Tăng wa wax tauh huungh nyoongz quef, cloon wax đomc quanz pyây, cloon Bê-nit cloon căn stiz wax đomc stâyv wa nyăngz munh, <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />tauv stiz đanv muf, yâuc lanh coong ănz lanh, coong: “Nâyx tauh munh max naih ayx laiv huungđ hoopđ zuc tayc max six zuc yămz nzauh nhlenz.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />A-qui-la songđ coong ănz Phê-sa-tat, coong: “Năngđ pungx nâyx tauh munh lôx tuz, năngđ coong nănh max joođ ninyh tauv Sê-sa.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Tauv tingc săngh phunz buz quaix coiđ nyăngz jau ninyh wa I-ta-li côkz, stiz songđ jaoz Phao-lô cloon ah đomc nzauh munh phunz ah lanh peengz pyây, bux hipđ ayx Yu-lit, săngh Au-gatc-tatc huungh wax peob peengz. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Buz nzac ah saz đangđ ninyh tăng Atc-la-mitv-ti-yum, jămc lêpc Ê-si nyăngz coiđ sinh wax đomc tinc ninyh, tăng wa buz songđ tuz setb ninyh, naih ah lanh Tê-sa-lô-ni-ca dlanyh nyăngz munh, bux hipđ ayx A-lit-ta-cat, yămz Ma-si-đô-ni stâyz phangz, cloon buz songc ninyh. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Nzof nyâyc noib, buz ninyh zapz wa Sai-đoon, Yu-lit, hâuđ lênh Phao-lô, songđ phunz nănh ninyh tayđ wax đomc yâuf pez phunz stiz nzăngđ hayh lif nănh. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Tăng wax nomz tinc, buz yămz đangđ setb ninyh, yăpx lêpc Sai-batc coiđ njeengh cah sinh ninyh, wâyc nzaox jinh đangh sâyb phunb đangz. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Nzof tauv ninyh tuz blătc Si-li-si cloon Băm-phi-li nyăngz coiđ sinh, buz ninyh zapz ănz wa Mi-la, yămz Li-si stâyz phangz. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Yămz wa, wax tauh peengz pyây lov tuz ah saz đangđ tăng A-lêk-san-đê-li ninyh wa I-ta-li, nănh songđ ênz buz nzac wax saz đangđ ninyh. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />Tăng wa, đangđ ninyh manc nzongf, ninyh tuz đuungx noib nzăngđ tuz beengc wa Ci-ni-đatc dlanyh, wâyc nzaox nzongf yongb, buz max hayh ninyh tuz tauv wa wăngx nzetx, buz songđ phunz đangđ lauf yăpx lêpc wa Cê-lit coiđ njeengh cah sinh, yămz Sa-mô-nê toix nganc. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Nzof buz njih luh lêpc wax đoomz coiđ njeengh cah sinh ninyh zâuđ nzongf, tauv ah cuyb tinc hipđ ayx Wăngx nzetx Quai, nâyx cuyb tinc yămz stătx wa La-sê dlanyh.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Six wâyc ninyh nzuf săngx huđ đuungx nzongf, nzof ninyh nâyx cuyb đangđ jau senz cumh nzav nzongf, yâuc wâyc blătc njif nhlinc nyăngz săngx huđ, Phao-lô songđ bux stiz, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />coong: “Yâuf pez lex, yaz nyâyh mungv pănh clăngv nâyx hâyđ coiđ jau senz caux pongh dlauc huđ, yâuc zuc stâyb đuungx huungđ, max zâyf cungb cănh nây đangđ nyăngz tungh zăngc cuungv, lôx năngx njinh cloon pănh nyăngz mengc timb.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Six wax tauh peengz pyây zen laix đangđ munh cloon đangđ zâu năngx nzongf têx Phao-lô coong nyăngz wac. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Wâyc zapz wax nomz wăngx nzetx yâuc max hoođ yămz wa toix guungh song, wâyc nây, naih đuungx lanh songđ cănđ tăng nây setb ninyh, năngđ coong hayh tuz, stiz six muf zapz ănz wa Phi-nik, six Cê-lit coiđ njeengh nyăngz wăngx nzetx, huungv staox namh pôngz cloon păkx pôngz wax phanx muf, nongc yămz wa năngx blătc guungh song. <verse eid="ACT 27:12" /><verse number="13" style="v" sid="ACT 27:13" />Wax zanyf, naih namh pôngz nzaox stâyb cay sâub sâub, songđ nyâyh coong tuz ninyh gôh, six tauz sâub đangđ zamf tuz, stiz phunz đangđ ninyh yăpx lêpc wa Cê-lit coiđ njeengh cah sinh ninyh. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Six cah đangz max lauh, naih ah tâuc nzaox lub hipđ ayx Ê-đa-qui-lôn, tăng coiđ njeengh sâyb nzac taih. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Đangđ songđ zuc sâyb ninyh wâyc max hayh nzeengz tuz wax tâuc nzaox nzof, buz songđ dluyh phunz nănh tuib ninyh. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Six cun tuib lêpc nzaox ninyh tauv ah nomz coiđ njeengh jenz hipđ ayx Cau-đa, zâuđ nzongf buz nzăngđ ayx tuz wax saz đangđ yămf, <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />tauv tăkc staox, stiz songđ zoz tax huungđ taih tinyh stăngc, nzapc đangđ stinb năngx tăngđ. Yâuc wâyc cungb wangb ninyh jeengv zuc wa Si-tit njăuz staiz minc, stiz songđ pungx đangđ đatz nzac yâuc dluyh phunz nzaox tuib ninyh. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Tauv nyâyc noib, buz lauf zuc nzaox lub sâyb nzongf, stiz songđ zoz huv quanyf queengx phunz đangđ sâub. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Tauv wax noib pôz, buz cănh nongc puf zoz wa đangđ wax đomc tungh zăngc quanyf nzac womz ninyh. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Wax zanyf, bah noib yâuc max phătc naih, stingz tau yâuc max phătc setb tuz đuungx noib, nzaox lub yâuc njinh luh sâyb buz, buz songđ max mungc coong bix năngx hayh tuz njâuv. <verse eid="ACT 27:20" /><verse number="21" style="v" sid="ACT 27:21" />Wâyc lauh nzof max nhlinc luungđ, Phao-lô songđ stâuđ yămz stiz mungh tongx, yâuc coong:</para>
  <para style="p" vid="ACT 27:21">“Yâuf pez lex, năngđ coong mungv yaz max setb wa Cê-lit coiđ njeengh, six lauf max zuc pongh cumh nzav cloon zuc stâyb nâyx đomc năngđ nâyx. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Six nâyx zanyf, yaz quinb nyâuh oix zuc pungx stimz bex, wâyc nyâuh six max naih mănv tayc tinyh, cungb stâyb nâyx saz đangđ cuungv lêc. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Wâyc nâyx munf, Zâu Tênb-Huungh nyăngz ah tauh stinz munh, senz yaz canyx bongc yâuc bokc dlic wax Tauh, stâuđ yămz yaz cah sinh, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />yâuc coong: ‘Phao-lô lex, năngx gâyf cumh nzav. Mâyh six năngx zuc ninyh pongh tauv Sê-sa, wâyc nây Zâu Tênb-Huungh nyăngz hâuđ lênh, six sađ phunz mâyh cloon mâyh ninyh đangđ nâyx đomc munh.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Wâyc nây, yâuf pez lex, oix zuc pungx nyâuđ! Wâyc yaz zen Zâu Tênb-Huungh, coong muif huungđ six năngđ nâyx setb taih, âyz năngđ tuz bux phunz yaz nâyx. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Six pănh bâyf zuc ninyh jeengv yămz tix nomz coiđ njeengh.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Tauv tuz săpc stâyx munf wax munf, buz năngx jinh đangh yâuh wa Mi-đi-tê-lê-nên coiđ minc, tauv cox đamx munf, wax đomc laix đangđ munh songđ stăngz six stiz ninyh tauv stătx tix cuyb nib gaib. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Songđ pungx tungh zangđ mangc, stiz songđ phătc đôz nhlic săpc yoomh, six ninyh tuz ah stêtz năngx côz têx timb, stiz zef pungx tungh zangđ mangc phătc năngx naih săpc ngâuf yoomh. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Yâuc cungb wangb buz hayh ninyh clămb zuc tix nomz womz đi njăuz, songđ pungx pyâyz nomz đangđ zamf tăng wa đangđ tây nzac, stiz yâuc oix nongc tauv guungh gwăngz. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Six tauv lêpc đangđ nyăngz munh lov jau tiuv gâyh wax saz đangđ, songđ pungx đangđ jenz nzac coiđ ninyh, jaf ayx cayx năngđ cay cayx pungx đangđ pyây nyăngz zamf nâyx, <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Phao-lô coong ănz wax tauh peengz pyây cloon wax đomc peengz, coong: “Năngđ coong nâyx đomc munh max yămz nây đangđ nyâuh six max hayh tuz njâuv.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Tăng wa peengz catz setc đangđ jenz nyăngz langb songđ phunz nănh tuib ninyh. <verse eid="ACT 27:32" /><verse number="33" style="v" sid="ACT 27:33" />Wax zanyf, six cayx tauv guungh gwăngz Phao-lô songđ quinb êu tinyh đoih nhlinc tix cay tix huungđ, yâuc coong: “Nâyx noib six tuz săpc stâyx noib nây nzof, nyâuh lauf njinh luh zu, tanyđ nyâuđ sab max nhlinc luungđ. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Năngđ nây, yaz quinb nyâuh oix zuc nhlinc tix cay tix huungđ, wâyc nây six nyâuh sămv zuc tuz njâuv. Wâyc nyâuh max naih mănv zuc stâyb ah stinz pyây đongz tiny.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Tăng wa, coong ayx năngđ nâyx tuz, Phao-lô songđ zoz nzu setb taih, yămz songx munh nyăngz cah đangc sâuf hâuđ Zâu Tênb-Huungh tuz, nănh songđ watz taih nhlinc. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Songx munh tuz numđ oonz nyâuđ, stiz songđ nhlinc. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Wax zanyf, buz tinyh đoih yămz wa đangđ six iz pez jetb săpc guc lanh munh. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Tăng wa, tuz nhlinc pêu nzuf, stiz songđ zoz blauh witx quanyf nzac coiđ ninyh, ayx phunz đangđ năngx sâub. <verse eid="ACT 27:38" /><verse number="39" style="v" sid="ACT 27:39" />Tauv guungh gwăngz, stiz max saz wax cuyb tinc, six stiz phătc ah nomz quăngc naih njauz staiz putb, stiz songđ sangv mangc jađ hayh laix đangđ nzac wax cuyb tinc ninyh tuz max. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Stiz catz pang tungh ngauz langb, pungx ănz nzac coiđ ninyh. Songđ zay đangđ byetc nyăngz langb yâuc njăpc đangđ pyây nyăngz đatz quef, ninyh jămc nzaox, stiz tanyđ đangc si zac ninyh wa coiđ sinh. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Six ninyh clămb zuc iz nomz womz tinyh căpx nyăngz tinc đangđ songđ jeengv wa, wâyc đangđ pyây jeengv yămz wa nhlengc găngz, max tongf tuz tiny, nzof đangđ tây yâuc zuc womz boomf njoongh zongv lunc nzuf. <verse eid="ACT 27:41" /><verse number="42" style="v" sid="ACT 27:42" />Wax zanyf, peengz songđ tingc săngh cayx đa tayx nzuf wax đomc nzauh munh, wâyc cungb wangb naih tix lanh hayh jâuh tuz pletx bix tiuv. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Six wâyc wax tauh peengz pyây oix njâuv Phao-lô songđ cangđ nănh stiz, nănh yâuc setb lanyf êu laiv lanh hayh jâuh bix đanyz setb đangc taih jâuh staox wa coiđ sinh ninyh, <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />nzof năngx yăngc wax đomc, ah phanx six nzauf wax đomc njăngx peen, ah phanx yâuc nzauf đangđ nyăngz ah huungđ, nzof năngđ nâyx, buz songđ tinyh đoih tuz staox wăngx sinh taih gongx nzuf.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Tauv tuz gongx nzuf nzof, wax zanyf buz nzăngc pâyz tuz coong nâyx nomz coiđ njeengh bux hipđ ayx moon-ta. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Nzof, yămz wa nyăngz munh stipx buz gongx nzongf, wâyc naih ah tâuc bungc nzac taih yâuc song, stiz songđ cuyx tâuf stipx buz tinyh đoih. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Six Phao-lô ston tuz ah ploc stangh songđ quanyf ănz nzac tâuf ninyh, yâuc naih ah tauh nangz meengz, tăng wa tinc joomz lunb setb taih, jeo nănh nyăngz puf sen đangz. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Wax zanyf, yămz wa stâyz phangz nyăngz munh phătc wax tauh nangz jeo nănh nyăngz puf, stiz lanh coong ănz lanh: “Lâyc tauh munh six bâyf tayx munh nyăngz munh, nănh hănđ tuz njâuv tăng womz setb taih, six peengh stimz gâyf max phunz săngh.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Six, Phao-lô quanyf wax tauh nangz meengz nzac tâuf ninyh, nănh yâuc max naih săngh laix tiny. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Nzof, wax đomc munh six nyâyh coong ah zanyf nănh six bâyf omx pauv têx max six toongx sangf glinyf tayc. Six stiz seetx mangc ah dlapc lauh yâuc max phătc nănh săngh laix, stiz zef plănc taih coong, nănh six ah tauh stinz.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Wax zanyf, yămz quib wa cah sinh wax đomc nib six ayx pyây cun wax nomz coiđ njeengh wax tauh munh nyăngz, bux hipđ ayx Bupc-li-atc, nănh yâuc nongc nyâuđ stipx buz gongx nzongf, tuz pôz noib. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Wax zanyf, Bupc-li-atc nyăngz pha jinh đangh phâyx wa zâuv wâyc săngh bah song gumc cloon nyâuđ munz stib, Phao-lô songđ ninyh tex nănh yâuc cloo Zâu phunz, tăpx puf ănz nănh, yâuc zany gongx phunz nănh. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Tăng wa, nâyx huungđ dlayc setb taih, yămz wa coiđ njeengh wax đomc săngh gumc nyăngz munh songđ taih lov Phao-lô yâuc tuz zany gongx nzuf, <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />stiz yâuc nongc buz saix nzongf, nzof tauv buz nzac đangđ ninyh wax zanyf, stiz yâuc nzâyz buz sămv nongc nyăngz đuungx huungđ taih cungb stungx phunz buz.<verse eid="ACT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Blătc pôz lav cah đangz, buz songđ nzac ah saz đangđ ninyh naih stuc Đi-ôt-cu-li nyăngz hanyh, tăng A-lêk-san-đê-li taih yămz wa coiđ njeengh quaix guungh song. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Tauv tuz muf zapz wa Sai-la-ciu, buz songđ yămz wa pôz noib. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Tăng wa nzac đangđ ninyh, buz ninyh tauv Lê-yi-um dlanyh, tah nyâyc noib naih nzaox tăng namh pôngz sâyb, cah đangz ah noib timb buz songđ ninyh tauv Bu-ti-ô-li dlanyh, <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />yămz wa buz pongh ah đomc yâuf pez, stiz yac êu buz cloon stiz yămz wa nhlic noib, năngđ nâyx, buz songđ ninyh tauv Lô-ma. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Tăng wa, wax đomc yâuf pez numđ coong tauv buz, songđ taih yămz wa Ap-bi-atc caiz, cloon pôz nomz quanx pongh buz, phătc stiz Phao-lô songđ numđ oonz nyâuđ, yâuc sâuf hâuđ Zâu Tênb-Huungh.<verse eid="ACT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Tauv buz nzac Lô-ma dlanyh ninyh, Phao-lô songđ tuz cănh lanyc yămz cloon ah tauh peengz jămđ nănh.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Pôz noib cah đangz, nănh êu wax đomc Yu-tai munh wax đomc songx munh côx tinyh đoih taih. Tauv stiz taih, nănh songđ coong ănz stiz: “Songx yâuf pez lex, yaz hănđ max ayx luungđ nzeengz cloon pec stingx max six pănh claof jex nyăngz gâyf, yaz lôx năngx zuc zoz tăng wa Yê-lu-sa-lem ênz taih cayx năngđ stoif munh, yămz Lô-ma munh nyăngz puf đi, <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />nzof stiz cănh zah naic yaz tuz, lôx cayx đa pungx yaz, wâyc yaz max naih laiv huungđ stoif hoopđ zuc tayc. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Six wâyc Yu-tai munh max nyenc, yaz songđ zuc joođ taih tauv Sê-sa — nzof yaz yâuc max zâyf oix cooux cănh nyăngz pec stingx. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Wâyc năngđ nây, yaz songđ êu nyâuh taih tinyh pongh nongc coong wac. Yâuc wâyc I-sa-la-ên munh nyăngz njih mungc, yaz bix zuc njab langb stayb nây.” <verse eid="ACT 28:20" /><verse number="21" style="v" sid="ACT 28:21" />Six stiz coong ănz nănh: “Buz max zeengx tuz stipx laiv zây jenx coong tauv mâyh tăng wa Yu-đê stâyz phangz, yâuc max naih laiv lanh yâuf pez taih bux max six coong tauv mâyh laiv huungđ huđ dlayc. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Six buz numđ hoopđ zuc mungv tăng mâyh, jađ mâyh nyâyh ayx laix, wâyc coong tauv nâyx huungđ gâyf, buz six pâyz coong, zuc munh nzeengz pong muif đoif nzuf.”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Tăng wa, stiz songđ cănđ noib phunz nănh, yâuc naih munh đuungx nzongf taih pongh nănh yămz nănh nyăngz tinc, tăng guungh gwăngz tauv guungh nzămc, nănh coong bux stiz, yâuc ayx zanyx manyf coong tauv Zâu Tênb-Huungh nyăngz côkz, yâuc zoz Mô-sê nyăngz gâyf njanh cloon wax đomc tâuc wac munh nyăngz stâub taih quinb bux stiz coong tauv Zâu Yê-su. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Naih ah phanx songđ zen nănh coong wax đomc, six naih ah phanx yâuc max zen. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Stiz songđ max tinyh zuc, bix tiuv muf, Phao-lô songđ coong nâyx zâux wac, coong: “Zâu Singx-Lingh nongc tâuc wac munh I-sa-ya coong nyăngz wac ănz nyâuh nyăngz claof jex, senz toix nzongf, <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />coong: ‘Oix zuc ninyh tauv nâyx đomc pec stingx yâuc coong:</para>
  <para style="q1" vid="ACT 28:26">“Nyâuh mungv, six hănđ mungv, nyâuh yâuc max saz,</para>
  <para style="q1" vid="ACT 28:26">nzof nyâuh mangc, six hănđ mangc, nyâuh yâuc max phătc.”<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Wâyc nâyx đomc pec stingx nyăngz nyâuđ nhlengc,</para>
  <para style="q1" vid="ACT 28:27">stiz ayx bah noomh max numđ,</para>
  <para style="q1" vid="ACT 28:27">yâuc nzipx stiz nyăngz mâyc,</para>
  <para style="q1" vid="ACT 28:27">sangx tauv tix zanyf, stiz nyăngz mâyc hayh mangc tuz phătc,</para>
  <para style="q1" vid="ACT 28:27">bah noomh yâuc mungv tuz numđ, nyâuđ yâuc hayh manyh pec,</para>
  <para style="q1" vid="ACT 28:27">stiz bix phunb đangz lauf,</para>
  <para style="q1" vid="ACT 28:27">Yaz songđ zany gongx phunz stiz.’<verse eid="ACT 28:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ACT 28:28" />Wâyc nây, nyâuh six oix zuc pâyz coong, nây Zâu Tênb-Huungh nyăngz njâuv pôz six tuz ninyh nzônh phunz pitc stingx munh, nzof wax đomc munh six mungv lêpc.” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />[Tauv nănh coong tuz wax đomc wac, wax đomc Yu-tai munh songđ muf yâuc naih tinyh zenđ lub nzongf yămz stiz.]<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Wax zanyf, Phao-lô yămz nănh tingc yămz wax sênz pyau tuz iz nyăngv cah njaf, yâuc stipx taih lov nănh wax đomc munh, <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />songđ lănv nzônh coong tauv Zâu Tênb-Huungh nyăngz côkz, yâuc tuz pungx stimz nzaox tauv Zâu Yê-su Jix-Tuz nyăngz jau, yâuc max naih mănv cangđ.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>