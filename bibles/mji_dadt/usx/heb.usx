<usx version="3.0">
  <book code="HEB" style="id">EN_DADT mji-x-daoaodai_Dao⋅Ao⋅Dai_ltr Sun Jul 12 2026 21:58:51 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Hebrews</para>
  <para style="toc1">Hipđ-lu Jenx</para>
  <para style="toc2">Hipđ-lu</para>
  <para style="toc3">Heb</para>
  <para style="mt">Hipđ-lu</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Lôx noib, Zâu Tênb-Huungh nongc wax đomc tâuc wac munh coong ănz pănh wax đomc claof jex đuungx hâyđ, yămz đuungx huungđ zux ix, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />six tauv nâyx đomc stêtb mâyv nyăngz noib, Zâu Tênb-Huungh songđ nongc Nănh nyăngz Toonz coong ănz pănh, senz Nănh njăpc taih nongc cun muif huungđ wax Tauh, yâuc wâyc wax Tauh Toonz, Nănh bix zuyx bamh canz taih; <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />nâyx tauh toonz six hinđ manyf Zâu Tênb-Huungh nyăngz gwăngz eeng cloon Nănh clăkx clunh nyăngz hanyh jangx, yâuc nongc Nănh naih lanyf nyăngz wac pâuh muif huungđ, nzof tauv ayx soongb stav stoif nyăngz cumh pâuz, wax Tauh Toonz songđ tuz stâyv yămz lub quaix wax Tauh nyăngz byaoh phanx yămz njăngb quaix nyăngz tinc; <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />wâyc tuz zanyb saix blătc wax đomc stinz munh sax phănc, Nănh yâuc tuz naih manyh năngx lub têx wax đomc stinz munh sax phănc. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Wâyc Zâu Tênb-Huungh naih laiv zanyf coong ănz wax đomc stinz munh laiv tauh coong:</para>
  <para style="q1" vid="HEB 1:5">“Mâyh six Yaz nyăngz Toonz.</para>
  <para style="q1" vid="HEB 1:5">Nâyx noib Yaz steengb Mâyh taih”?</para>
  <para style="m" vid="HEB 1:5">Yâuc coong:</para>
  <para style="q1" vid="HEB 1:5">“Yaz six săngh Mâyh nyăngz Pha,</para>
  <para style="q1" vid="HEB 1:5">nzof Mâyh six săngh Yaz nyăngz Toonz”?<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />Six, Nănh ênz Toonz Coonz nzac bamh canz taih wax zanyf, Nănh coong: “Yetx stong Zâu Tênb-Huungh nyăngz stinz munh six oix zuc canyx bongc wax tauh Toonz.” <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />Năngx naih wax đomc stinz munh, Nănh six coong:</para>
  <para style="q1" vid="HEB 1:7">“Zâu Tênb-Huungh ayx phunz Nănh wax đomc stinz munh pênx nzaox,</para>
  <para style="q1" vid="HEB 1:7">nzof Nănh wax đomc pâuz six pênx tâuf byetc.”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Six coong tauv wax tauh Toonz, yâuc coong:</para>
  <para style="q1" vid="HEB 1:8">“Zâu Tênb-Huungh lex, Mâyh nyăngz huungh tinc stâyv quâyx yămz tauv banc stâyv banc đaic,</para>
  <para style="q1" vid="HEB 1:8">Mâyh nyăngz côkz lanyf six peengh stimz nyăngz lanyf.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Mâyh numđ nyađ peengh stimz nyăngz jau yâuc hănđ okx nyăngz jau.</para>
  <para style="q1" vid="HEB 1:9">Wâyc nây, Zâu Tênb-Huungh, six Mâyh nyăngz Zâu Tênb-Huungh, zoz yâuh numđ nyađ njămh</para>
  <para style="q1" vid="HEB 1:9">phunz mâyh, ayx phunz Mâyh năngx lub quaix Mâyh wax đomc lah pyeoz toic.”<verse eid="HEB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 1:10" />Yâuc naih coong “Zâu lex, ah yac quef coonz, Mâyh njăpc nib nyăngz coonz tay,</para>
  <para style="q1" vid="HEB 1:10">nzof wax đomc guungh lauf Mâyh nyăngz puf ayx taih nyăngz cumh pâuz.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Guungh nib six quaiz nzuf, six Zâu stâyv quâyx yămz,</para>
  <para style="q1" vid="HEB 1:11">yetx stong guungh nib six lôx ninyh cayx năngđ ah byenđ guyz nâyx,<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Mâyh six glonc stiz, cayx năngđ ah byenđ guyz lub nâyx,</para>
  <para style="q1" vid="HEB 1:12">guungh nib six coi wănc năngđ ah byenđ guyz,</para>
  <para style="q1" vid="HEB 1:12">six Mâyh yâuc stâyv quâyx yămz,</para>
  <para style="q1" vid="HEB 1:12">nzof Mâyh nyăngz nyăngv tauh six max hayh zomc.”<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Zâu Tênb-Huungh naih laiv zanyf coong ănz laiv tauh stinz munh, coong:</para>
  <para style="q1" vid="HEB 1:13">“Oix zuc stâyv yaz nyăngz byaoh phanx</para>
  <para style="q1" vid="HEB 1:13">ayx tuz tauv laiv zanyf Yaz ayx phunz Mâyh nyăngz yônz zaz yămz Mâyh nyăngz staux đi”?<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Wax đomc stinz munh max zâyf yetx stong six bokc dlic Zâu Tênb-Huungh nyăngz stinz, tuz paiđ taih nongc stăngc wax đomc tuz njâuv nyăngz munh haz?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Wâyc nây, pănh oix zuc cayb jămđ năngx gongx pănh tuz numđ quaix nyăngz wac, săngx đanyf pănh hayh ninyh gâyh stiz. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Wâyc năngđ coong wax đomc stinz munh coong nyăngz wac six senz nyăngz, nzof ayx longđ nyăngz jau cloon max mungv wac nyăngz jau yâuc cănh zuc tingc stoif nzof, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />năngđ nâyx pănh laiv ayx laix hayh tiuv tuz đutb, năngđ coong pănh zef năngx mangc stam nây njâuv pôz lub năngđ nâyx? Nzof nâyx cuyb njâuv pôz yâuc năngx tuz Zâu nzônh bux quaix đangc, songđ tuz ayx zanyx manyf phunz pănh tăng wax đomc tuz numđ quaix nyăngz munh; <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />wâyc Zâu Tênb-Huungh lauf cloon stiz songc ayx zanyx manyf nongc wax đomc njih hoouđ, cloon jix caox njingc nyăngz dlayc, naih đuungx huungđ jix caox njingc max tinyh năngđ, cloon Zâu Singx-Lingh sađ phunz nyăngz jau âyz Nănh nyăngz zux ix.<verse eid="HEB 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Wâyc zuc pănh jinh đangh coong tauv wax jaz guungh đi, six cah đangz phanx cayx taih wax jaz guungh đi, Zâu Tênb-Huungh six max zâyf nongc phunz buc wax đomc stinz munh. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Nzof yâuc, naih munh ayx zanyx manyf yămz pitc đoif, coong:</para>
  <para style="q1" vid="HEB 2:6">“Bamh munh six luungđ, bix tuz Mâyh săngx tauv,</para>
  <para style="q1" vid="HEB 2:6">zef coong bamh munh six mănv, Mâyh bix năngx tex jămđ heh?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Mâyh ayx phunz Nănh yămz năngx hav tix cay wax đomc stinz munh;</para>
  <para style="q1" vid="HEB 2:7">Mâyh đongx tany phunz Nănh yâuc zanyb saix yămz gwăngz eeng cah njaf.<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />Mâyh phunz muif huungđ yămz Nănh nyăngz staux đi.”</para>
  <para style="p" vid="HEB 2:8">Nzof ayx phunz muif huungđ zuc buc Zâu Yê-su wax zanyf, Zâu Tênb-Huungh yâuc max ayx phunz laiv huungđ bix max zuc buc Nănh. Six nâyx zanyf pănh lauf max zeengx phătc muif huungđ buc Nănh, <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />six pănh phătc nâyx tauh Zâu Yê-su, Nănh tuz oonz ayx năngx hav tix cay wax đomc stinz munh ah dlapc max lauh, wâyc Nănh zuc tanyđ zâuđ zuc tayc, songđ tuz đongx gwăngz eeng nyăngz tany yâuc tuz zanyb saix, nây six wâyc Zâu Tênb-Huungh nyăngz pôz, Zâu Yê-su bix zuc tayc tayv phunz tinyh đoih. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Wâyc muif huungđ six huungv staox Nănh ninyh yâuc wâyc Nănh bix naih muif huungđ, wâyc oix ênz đuungx lanh sây lauf tuz gwăngz eeng, songđ ayx phunz Nănh săngh tuz njâuv nyăngz coonz tay phunz wax đomc sây, păngc zuc tanyđ zâuđ bix tuz clăkx clunh nzuf. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Wâyc zuc, njinh ayx phunz đăngb zeengh wax Tauh cloon tuz ayx đăngb zeengh wax đomc munh six tăng ah Tauh Pha taih nzuf, wâyc nây, Nănh songđ max numđ nyayz hipđ wax đomc munh ayx yâuf pez, <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Nănh coong:</para>
  <para style="q1" vid="HEB 2:12">“Yaz six nzônh Zâu nyăngz manyh phunz Yaz nyăngz yâuf pez;</para>
  <para style="q1" vid="HEB 2:12">Yaz yâuc yămz songx munh mungh tongx ayx nzungz tanv Mâyh.”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Zef coong:</para>
  <para style="q1" vid="HEB 2:13">“Yaz six zen caođ Zâu Tênb-Huungh.”</para>
  <para style="m" vid="HEB 2:13">Nzof zef coong:</para>
  <para style="q1" vid="HEB 2:13">“Phanv mangc, yaz cloon Zâu Tênb-Huungh sađ phunz yaz wax đomc toonz sab.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Năngđ nây, wâyc wax đomc toonz sab naih a naih samđ, wâyc nây Zâu Yê-su lauf naih a naih samđ năngđ stiz nâyx, păngc Nănh tayc ninyh Nănh bix hayh mêtc nzuf naih lanyf phunz munh zuc tayc wax tauh, six manđ nyăngz huungh, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />yâuc hayh pungx goib phunz wax đomc munh, senz cungb săngh bix numđ cumh nzav tayc wax đomc, six zuc yac ayx nâuh wax đomc. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Wâyc zuc senz nyăngz, six max zâyf Nănh stăngc wax đomc stinz munh, six Nănh stăngc Apx-la-ham nyăngz sây stunz, <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />năngđ nây, yămz manf dlayc Nănh songđ zuc ayx cayx năngđ Nănh nyăngz yâuf pez nâyx, phunz Nănh nzăngđ hayh tuz săngh stayb munh pyây, naih nyâuđ hâuđ lênh yâuc neetb stimz ayx Zâu Tênb-Huungh nyăngz cumh pâuz, nongc stav Nănh nyăngz pec stingx nyăngz stoif. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Nănh zuc tanyđ quaix stâyv nyâuđ, phunz Nănh hayh stăngc pongh zuc stâyv nyâuđ wax đomc munh, wâyc Nănh cănh tuz pongh quaix wax đomc nzuf.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Wâyc nâyx, đăngb zeengh nyăngz yâuf pez lex, six senz tuz tăng guungh sên taih nyăngz munh, oix zuc năngx cayb nyâyh tauv tuz Paiđ Taih Wax Tauh, cloon săngh Stayb Munh Pyây six pănh nhlimc nyăngz wac, six Zâu Yê-su, <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Nănh six neetb stimz cloon njăpc Nănh taih wax Tauh, lauf cayx năngđ Mô-sê neetb stimz cloon Zâu Tênb-Huungh nyăngz pyau njaf munh nâyx. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Wâyc nâyx Tauh Zâu Yê-su tuz stunx coong, payh tuz stipx gwăngz eeng năngx lub têx Mô-sê, lauf cayx năngđ zâyv pyau nyăngz munh tuz zanyb saix năngx nzongf têx wax sênz pyau. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Wâyc muif sênz pyau six lauf tuz tăng ah lanh munh zâyv taih, nzof Zâu Tênb-Huungh six zuyx muif huungđ taih wax Tauh. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Mô-sê yâuc neetb stimz cayx năngđ ah lanh pâuz yămz Zâu Tênb-Huungh nyăngz pyau, nongc ayx zanyx manyf coong tauv cah đangz phanx tuz lănv nzônh nyăngz dlayc; <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Zâu Jix-Tuz, six neetb stimz cayx năngđ ah lanh Toonz cun Zâu Tênb-Huungh nyăngz pyau njaf munh (nzof Zâu nyăngz pyau njaf munh six pănh, tinyh phanv pănh nzac jab nzauf năngx tăngđ pănh nyăngz zen stimz cloon pănh naih nyăngz njih mungc ayx tuz tauv stêtb mâyv). <verse eid="HEB 3:6" /><verse number="7" style="v" sid="HEB 3:7" />Wâyc nây, cayx năngđ Zâu Singx-Lingh coong:</para>
  <para style="q1" vid="HEB 3:7">“Năngđ coong, nâyx noib nyâuh numđ Nănh nyăngz wac,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />six năngx gâyf ayx nyâuh nyăngz nyâuđ nhlengc,</para>
  <para style="q1" vid="HEB 3:8">cayx năngđ sêu lunc wax zanyf nâyx,</para>
  <para style="q1" vid="HEB 3:8">six zuc stâyv yămz wa stâyz phangz blănf nyăngz săngx huđ<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />yămz wa nyâuh wax đomc claof jex phătc Yaz ayx nyăngz cumh pâuz,</para>
  <para style="q1" vid="HEB 3:9">stiz bix năngx stâyv Yaz,<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />ayx tuz stâyx săpc nyăngv cah njaf. Wâyc nây, Yaz songđ numđ nhlenx wax nzêuh munh,</para>
  <para style="q1" vid="HEB 3:10">Yaz nzăngđ coong: ‘Stiz six zuc njinh luh ayx phunz stiz nyăngz nyâuđ nhlengc,</para>
  <para style="q1" vid="HEB 3:10">stiz yâuc max hayh pâyz tuz Yaz nyăngz jau.’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Yaz siv nhlenx nyăngz săngx huđ Yaz songđ nyunc wac, coong:</para>
  <para style="q1" vid="HEB 3:11">‘… Stiz six max tuz nzac Yaz nyăngz hitb conv tinc!’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Yâuf pez lex, oix zuc năngx cayb bôngh, săngx đanyf yămz nyâuh cah njaf hayh naih tix lanh nyâuđ huđ max zen, bix ninyh gâyh stâyv quâyx săngh nyăngz Zâu Tênb-Huungh côz. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Six, oix zuc muif noib lanh oonz lanh nyăngz nyâuđ, tinyh phanv năngx tuz hipđ ayx “nâyx yenh noib,” phunz yămz nyâuh cah njaf max naih laiv lanh zuc stoif jaf ayx phunz nyâuđ nhlengc. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Wâyc pănh six pênx tuz cloon Zâu Jix-Tuz songc phănc nyăngz munh, tinyh phanv pănh nzauf pănh ah yac nyăngz zen stimz năngx tăngđ ayx tuz tauv stêtb mâyv, <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />cayx năngđ naih ja coong:</para>
  <para style="q1" vid="HEB 3:15">“Năngđ coong, nâyx yenh nyâuh numđ Nănh nyăngz wac,</para>
  <para style="q1" vid="HEB 3:15">six năngx gâyf ayx nyâuh nyăngz nyâuđ nhlengc,</para>
  <para style="q1" vid="HEB 3:15">cayx năngđ sêu lunc wax zanyf nâyx.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Laiv đomc munh six mungv Nănh nyăngz wac bix zef năngx nyâuđ nhlengc heh? Ha max zâyf wax đomc tuz Mô-sê ênz setb I-yipx stâyz phangz wax đomc munh haz? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Nzof Zâu Tênb-Huungh nhlenx cloon laiv đomc munh tuz stâyx săpc nyăngv cah njaf heh? Ha max zâyf nhlenx wax đomc longđ stoif nyăngz munh, bix stiz nyăngz stayđ songđ zuc glinyf yămz wa stâyz phangz blănf wax đomc haz? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Nzof Nănh nyunc wac cloon laiv đomc munh coong, stiz six max tuz nzac Nănh nyăngz hitb conv tinc nâyx heh, ha max zâyf cloon wax đomc max mungv wac nyăngz munh haz? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Pănh phătc stiz max hayh tuz nzac six wâyc stiz nyăngz nyâuđ max zen.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Wâyc nây, pănh hoopđ zuc pâyz cumh nzav, săngx đanyf năngx jinh naih nyunc wac tuz nzac Nănh nyăngz hitb conv tinc nyăngz săngx huđ, nyâuh bix zef naih tix lanh zuc seetb blătc. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Wâyc Cuđ Jenx lauf tuz nzônh phunz pănh, cayx năngđ wax đomc munh nâyx. Six, stiz numđ nyăngz wac yâuc max hayh stăngc tuz stiz laiv huungđ, wâyc stiz tuz numđ six yâuc max nongc zen stimz bix stipx. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Năngx naih pănh six wax đomc zen nyăngz munh, songđ tuz nzac hitb conv tinc, âyz năngđ Nănh coong nâyx, coong:</para>
  <para style="q1" vid="HEB 4:3">“Cayx năngđ Yaz siv nhlenx bix nyunc nyăngz wac nâyx,</para>
  <para style="q1" vid="HEB 4:3">‘… stiz six stâyv quâyx max tuz nzac Yaz nyăngz hitb conv tinc!’”</para>
  <para style="m" vid="HEB 4:3">max cun Nănh nyăngz cumh pâuz bâyf tuz ayx soongb nzuf nzof, tăng ah yac zuyx guungh zuyx nib wax zanyf. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Wâyc naih lauh đoif Nănh yâuc coong tauv tah jetb wax noib, coong:</para>
  <para style="q1" vid="HEB 4:4">“Tah jetb wax noib Zâu Tênb-Huungh sec Nănh nyăngz muif huungđ cumh pâuz.”<verse eid="HEB 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="HEB 4:5" />Nzof năngx naih pitc đoif yâuc coong:</para>
  <para style="q1" vid="HEB 4:5">“… Stiz six stâyv quâyx max hayh tuz nzac Yaz nyăngz hitb conv tinc.”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Năngđ nây, nyunc nyăngz wac lauf năngx jinh naih nongc njâuh phunz ah phanx munh hayh tuz nzac wax nomz hitb conv tinc, wâyc cah đangc tuz numđ Cuđ Jenx wax đomc munh max tuz nzac wâyc stiz max mungv wac, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Zâu Tênb-Huungh songđ tingc ah noib taih, hipđ ayx “Nâyx yenh noib,” Nănh coong quaix Đa-witx taih quaix đangz lauh yongb nzof, cayx năngđ tuz coong yămz wa cah zâyc nyăngz wac nâyx, coong:</para>
  <para style="q1" vid="HEB 4:7">“Nâyx yenh noib, năngđ coong nyâuh numđ Nănh nyăngz wac,</para>
  <para style="q1" vid="HEB 4:7">six năngx gâyf ayx nyâuh nyăngz nyâuđ nhlengc.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Wâyc năngđ coong Yô-su-wa phunz pec stingx tuz hitb conv têx, yămz nây cah đangz phanx Nănh yâuc max zâuđ năngx coong tauv pitc noib nzof gôh. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Wâyc nây, lauf năngx naih ah nomz hitb conv tingc congz noib nongc phunz Zâu Tênb-Huungh nyăngz pec stingx. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Wâyc laiv lanh tuz nzac Zâu Tênb-Huungh nyăngz hitb conv tinc, wax lanh munh lauf sec nănh nyăngz cumh pâuz, cayx năngđ Zâu Tênb-Huungh sec Nănh nyăngz cumh pâuz nâyx. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Năngđ nây, pănh oix zuc joomz nyâuđ nzac wax nomz hitb conv tinc, phunz max naih mănv zuc tuih cayx năngđ wax đomc max mungv wac nyăngz munh nâyx. <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />Wâyc Zâu Tênb-Huungh nyăngz wac six săngh, naih jab, yâuc năngx njayc quaix wax đomc iz minb njayc nyăngz nzuc đao, nzopb tauv mengc cloon hoonh tinyh căpx nyăngz tinc, njinh stung tinyh căpx cloon stung laub, yâuc hayh stămđ tuz wax đomc pyây lâyc nyâyh nyăngz jau cloon stimz nyâuđ oix nyăngz jau. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Max naih laiv huungđ hayh pinyx tuz Zâu Tênb-Huungh. Nzof, muif huungđ six zuc hinđ manyf setb taih yămz Nănh nyăngz cah đangc, Nănh six pănh zuc coong nzuf muif huungđ phunz wax Tauh.<verse eid="HEB 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Năngđ nây, wâyc năngx jinh naih ah tauh stayb munh pyây lub quaix blătc nzuf wax đomc muif tab guungh, six Zâu Yê-su Zâu Tênb-Huungh nyăngz Toonz, pănh songđ oix zuc nzauf năngx tăngđ pănh nhlimc nyăngz wac. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Wâyc pănh six max zâyf naih ah tauh stayb munh pyây, max hayh pâyz tuz pănh đoonh nyăngz jau, six plănc taih Nănh zuc pongh muif huungđ stâyv nyâuđ quaix nzuf cayx năngđ pănh nâyx, six Nănh max longđ laiv huungđ stoif. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Năngđ nây, pănh oix zuc pungx stimz ninyh yămz stătx sađ pôz nyăngz huungh tinc, phunz hayh tuz hâuđ lênh yâuc tuz pôz yămz toix pănh sămv zuc stăngc nyăngz săngx huđ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Wâyc zuc muif lanh stayb munh pyây, six tuz sên tăng songx munh setb taih, wâyc nongc tayv songx munh ayx cumh pâuz phunz Zâu Tênb-Huungh, yâuc nongc stungx jax dlaih cloon stanyb lanyh stav stoif; <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Nănh lauf naih đoonh nyăngz jau, wâyc nây Nănh songđ hayh hâuđ lênh tauv wax đomc munh oongx cloon ninyh longđ jau nyăngz munh. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Yâuc wâyc nâyx, nănh songđ zuc nzâyz stanyb lanyh ninyh congx nongc tayv cănh nyăngz stoif, cloon songx munh nyăngz stoif. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Max naih mănv cănh hayh stipx tuz nâyx huungđ cumh pâuz, wâyc cungb Zâu Tênb-Huungh cănh sên taih cuungv, lauf cayx năngđ A-lôn nâyx. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Lauf tinyh năngđ, Zâu Jix-Tuz lauf max cănh njăpc Nănh ayx stayb munh pyây. Six tăng coong ănz Nănh wax Tauh coong:</para>
  <para style="q1" vid="HEB 5:5">“Mâyh six Yaz nyăngz Toonz;</para>
  <para style="q1" vid="HEB 5:5">nâyx noib Yaz steengb Mâyh taih.”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Nzof yămz pitc đoif Nănh zef naih coong:</para>
  <para style="q1" vid="HEB 5:6">“Mâyh six ayx stayb munh tauv banc stâyv banc đaic,</para>
  <para style="q1" vid="HEB 5:6">âyz năngđ Mên-ci-sê-đek wax phănc nâyx.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Zâu Jix-Tuz năngx jinh yămz wa stinb a nyăngz săngx huđ, Nănh songđ cloo Zâu hamv stingb lub haoh mâyc womz tuih yâuc joođ naih lanyf hayh njâuv tuz phunz Nănh max zâuđ zuc tayc wax Tauh, yâuc wâyc Nănh stimz nyâuđ gongx, songđ tuz tauz wac. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Max cun Nănh six ayx Toonz, Nănh yâuc hoođ mungv wac yămz Nănh zuc tanyđ zâuđ nyăngz jau. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Tauv Nănh ayx tuz clăkx clunh nzuf, songđ săngh tuz njâuv nyăngz coonz tay tauv banc stâyv banc đaic phunz yetx stong mungv Nănh nyăngz wac wax đomc munh, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />yâuc tuz Zâu Tênb-Huungh njăpc taih ayx stayb munh pyây âyz năngđ Mên-ci-sê-đek wax phănc nâyx, <verse eid="HEB 5:10" /><verse number="11" style="v" sid="HEB 5:11" />coong tauv nâyx huungđ jau têx, pănh naih đuungx huungđ nongc coong nzongf, yâuc pob manyf zâuđ, wâyc zuc nyâuh max zeengx hayh mungv tuz manyh pec. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Gâyf hoođ tauv nâyx zanyf nyâuh lôx săngh stênx steengb nzof gôh, six nâyx zanyf yâuc năngx jinh sămv zuc munh zoz Zâu Tênb-Huungh wax đomc gâyf njăng taih nzaox phunz nyâuh, nyâuh năngx jinh sămv zuc hopb nu max zeengx nhlinc tuz năngv! <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Wâyc zuc laiv lanh cungb hopb nu cuungv, six max zeengx pâyz tuz peengh stimz nyăngz gâyf, wâyc nănh six năngx jinh ayx munh sây jenz. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Nzof năngv six nongc phunz munh lub nhlinc, six senz vaic zah hoođ yâuc hayh pâyz tuz laiv huungđ six gongx laiv huungđ six huđ wax đomc munh.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Wâyc nây, pănh six oix zuc quanyf Zâu Jix-Tuz nyăngz zetx toongv gâyf ănz cah đangz, bix ninyh ayx tuz tauv săngh munh lub munh, gâyf zef năngx njăpc laif coonz tay, coong tauv nhlimc stoif gâyh đutb wax đomc tayc nyăngz cumh pâuz, bix zen caođ Zâu Tênb-Huungh, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />nzaox tauv ayx quaix-gâyf nyăngz jau, cloon tăpx puf nyăngz jau cloon munh tayc năngx săngh taih nyăngz jau, cloon stâyv quâyx zuc tingc stoif nyăngz jau. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Năngđ coong Zâu Tênb-Huungh phunz, pănh six ayx wax đomc jau. <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />Wâyc nây six max hayh tuz — yămz wax đomc tuz siux gwăngz quaix, yâuc tuz stipx quaix Zâu Tênb-Huungh nyăngz pôz, yâuc tuz sađ Zâu Singx-Lingh phunz nyăngz munh <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />yâuc tuz zangđ pâyz coong Zâu Tênb-Huungh nyăngz wac six gongx cloon cah đangz phanx nyăngz tômx jab <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />bix zef năngx setb Zâu têx — six max hayh ayx tuz phunz stiz zef năngx nhlimc stoif phunb đangz, wâyc stiz zoz Zâu Tênb-Huungh nyăngz Toonz tingz ănz săpc đăngc zax phunz stiz ah hâyđ timb, yâuc toongx songx ayx phunz Nănh zuc nyayz. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Wâyc zuc ah tootz nib, bix tuz bungc lub nzac nănh ninyh đâub đoonz max setc tiny yâuc setb jeengz zongx gongx phunz songx jămđ nyăngz munh têx, wax tootz nib six tuz Zâu Tênb-Huungh sađ pôz phunz, <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />six năngđ coong setb nzim setb mađ huđ têx, wax tootz nib six max săngh nongc, yâuc zuc zaux, nzof tauv stêtb mâyv nănh six zuc tâuf pu.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Six stăngz nzongf nyăngz yâuf pez lex, max cun buz coong năngđ nâyx, buz yâuc jinh đangh zu mungc tăng nyâuh wax đomc năngx gongx quaix nyăngz jau, six phunz hayh tuz njâuv wax đomc. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Wâyc Zâu Tênb-Huungh six max zâyf coong max peengh stimz bix nyâuđ cob nyâuh nyăngz cumh pâuz, cloon nyâuh wâyc nănh nyăngz manyh bix ayx wax đomc stăngz nyăngz jau, cloon bokc dlic wax đomc đăngb zeengh munh nyăngz jau, nzof nâyx zanyf nyâuh lauf năngx jinh bokc dlic stiz. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Six buz numđ oix nongc nyâuh muif lanh tuz joomz nyâuđ năngđ nâyx, phunz nyâuh hayh tuz naih clăkx clunh nyăngz njih mungc tauv tauh tauv mâyv, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />yaz max oix nongc nyâuh pênx munh lâyc munh, six oix nongc nyâuh âyz wax đomc munh naih zen stimz nyăngz gao cloon ayx nyâuđ đao zu bix tuz stipx nyunc nyăngz wac wax đomc.<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Wâyc Zâu Tênb-Huungh cloon Apx-la-ham nyunc wac wax zanyf, wâyc Nănh max hayh nuz mănv năngx lub têx nongc nyunc wac, songđ cănh nuz Nănh nongc nyunc wac, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />coong: “Yaz six senb senz sađ pôz phunz mâyh đuungx, yâuc ayx phunz mâyh nyăngz sây stunz phutx hongđ staox.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Wâyc nây, Apx-la-ham songđ ayx nyâuđ đao zu, nzof nzăngđ tuz stipx wax đomc nyunc nyăngz wac. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Wâyc bamh munh nyunc wac six hayh nuz tix lanh năngx lub têx stiz nongc nyunc wac, nzof phanv stiz naih laiv huungđ tinyh panx nyăngz jau, stiz six nongc wac nyunc nzof nzăngđ sec, <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />lauf tinyh năngđ, Zâu Tênb-Huungh wâyc oix hinđ manyf phunz tuz stipx nyunc nyăngz wac wax đomc munh, hayh pâyz tuz tauv Nănh nyăngz zux ix six max coi wănc, Nănh songđ lauf nongc wac taih nyunc <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />wâyc zuc wa iz huungđ six max coi wănc, nzof yămz wa iz huungđ Zâu Tênb-Huungh six max coong jaf, pănh six wax đomc tiuv ninyh tauv tungh meem tinc nyăngz munh, yâuc tuz naih oonz nyâuđ nzongf, nzauf sen yămz pănh cah đangc nyăngz njih mungc; <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />pănh nzauf sen nây njih mungc six cayx năngđ ah cuyb mengc hoonh nyăngz tungh tingz nâyx, yâuc wăn yâuc tăngđ, bix japc nzac wa tăng jeengh buyx cah njaf ninyh, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />wax nomz đăngb tinc six Zâu Yê-su japc nzac ninyh, ayx cayx năngđ ah Tauh ninyh đangc tayv phunz pănh nâyx, yâuc tuz săngh stayb munh pyây tauv banc stâyv banc đaic, âyz năngđ Mên-ci-sê-đek wax phănc.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Wâyc nâyx tauh Mên-ci-sê-đek, six Sa-lem nyăngz huungh, yâuc ayx Yămz Njăngb Quaix wax Tauh Zâu Tênb-Huungh nyăngz stayb munh, nănh ninyh pongh Apx-la-ham, toix Apx-la-ham ninyh bopc tuz hingh wax đomc huungh stix bix jinh đangh phunb đangz lauf wax zanyf, nănh songđ poou wac phunz Apx-la-ham, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />nzof Apx-la-ham yâuc lanyc săpc phănc nyăngz ah phănc tăng bopc tuz hingh wax đomc muif huungđ jax toongx phunz wax tauh huungh; Mên-ci-sê-đek âyz gâyf six “peengh stimz nyăngz huungh,” yâuc lauf ayx Sa-lem nyăngz huungh, âyx gâyf six “peengh oonz nyăngz huungh,” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />nănh max naih nzif, max naih pha, max naih stu stongz, max naih steengb stâyv noib, yâuc max naih quaix stâyv noib, six cayx năngđ Zâu Tênb-Huungh nyăngz Toonz nâyx, Mên-ci-sê-đek six njinh luh ayx stayb munh tauv banc stâyv banc đaic.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Six phanv nyâyh mangc jađ wax tauh huungh saix ayx năngđ laix, bix claof jex Apx-la-ham năngx stungx săpc phănc nyăngz ah phănc phunz, tăng bopc tuz hingh wax đomc gongx quaix nyăngz jax toongx. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Nzof wax đomc Lê-wi munh nyăngz sây stunz, tuz stipx ayx stayb munh nyăngz cumh pâuz wax zanyf, âyz gâyf njanh six naih gâyf nongc zoz săpc phănc nyăngz ah phănc tăng songx munh, âyz gâyf six tăng cănh nyăngz yâuf pez, wâyc stiz six lauf tăng Apx-la-ham taih. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Six, nâyx tauh huungh max cloon Lê-wi munh songc stingx, bix lauf stipx Apx-la-ham nyăngz săpc phănc ah phănc, yâuc poou wac phunz naih nyunc wac nyăngz munh. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Nzof, yămz hav nyăngz munh tuz poou wac tăng yămz njăngb nyăngz munh six max hayh aox tuz. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Nzof yămz nây, six wax đomc hayh tayc nyăngz munh tuz stipx săpc phănc nyăngz ah phănc, six yămz wa, wax tauh huungh yâuc tuz stunx coong six năngx jinh săngh. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Lauf hayh coong ah zâux ayx năngđ nâyx coong, Lê-wi munh, tuz sâub wax đomc săpc phănc nyăngz ah phănc, yâuc lauf wâyc Apx-la-ham bix setb săpc phănc nyăngz ah phănc, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />wâyc Mên-ci-sê-đek pongh Apx-la-ham wax zanyf Lê-wi lauf năngx jinh yămz claof jex nyăngz nyâuđ njaf.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Wâyc, năngđ coong clăkx clunh nyăngz jau six păngc wax đomc Lê-wi nyăngz stayb munh cumh pâuz (yâuc wâyc nây, songx munh bix tuz sađ gâyf njanh phunz), ha săngh laix bix zef năngx sămv zuc njăpc pitc tauh stayb munh âyz Mên-ci-sê-đek wax phănc, bix yâuc max tuz stunx âyz A-lôn wax phănc heh? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Wâyc stayb munh nyăngz cumh pâuz zuc coi wănc, six gâyf njanh lauf zuc naih coi wănc. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Nzof Nănh, six nâyx đomc wac jinh đangh coong tauv wax Tauh, six cănh pitc stingx munh, nzof yămz wax stingx munh yâuc max zeengx naih mănv tuz ayx cumh pâuz yămz wa congx tinc. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Wâyc pâyz tuz yox coong pănh nyăngz Zâu six tăng Yu-đa stingx setb taih, nzof yămz wax stingx munh, Mô-sê yâuc max coong tauv ayx stayb munh nyăngz cumh pâuz ax tiny. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Nzof nây zef năngx yox têx timb năngđ coong naih pitc tauh stayb munh tuz njăpc taih cayx năngđ Mên-ci-sê-đek nâyx, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Nănh tuz săngh stayb munh max zâyf âyz bamh munh nyăngz gâyf njanh tingc taih, six âyz săngh mengc max hayh tayc nyăngz tômx jab. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Wâyc naih zanyx manyf nyăngz wac coong tauv Nănh coong:</para>
  <para style="q1" vid="HEB 7:17">“Mâyh six ayx stayb munh tauv banc stâyv banc đaic cayx năngđ Mên-ci-sê-đek wax phănc nâyx.”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Wâyc nây, cah đangc wax đomc lanyf wâyc max naih jab yâuc max setb laiv huungđ songđ zuc quanyf <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(wâyc gâyf njanh max hayh ayx phunz laiv huungđ tuz clăkx clunh), nzof yâuc wâyc naih gongx quaix nyăngz njih mungc, phunz pănh păngc wa bix tuz ninyh yămz stătx Zâu Tênb-Huungh. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />Nzof nâyx đomc yâuc max zâyf coong max naih nyunc nyăngz wac, — max cun wax đomc pitc đomc munh hănđ max naih nyunc nyăngz wac yâuc tuz ayx stayb munh, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />six Zâu Yê-su tuz njăpc taih naih cloon nyunc nyăngz wac, tuz Zâu Tênb-Huungh coong ănz Nănh coong:</para>
  <para style="q1" vid="HEB 7:21">“Zâu nyunc nyăngz six max coi wănc:</para>
  <para style="q1" vid="HEB 7:21">‘Mâyh six ayx stayb munh tauv banc stâyv banc đaic.’” —<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />wâyc nây, Zâu Yê-su six săngh baox đamz munh phunz ah cuyb năngx gongx nyăngz nhlengc wac. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />Max cun, wax đomc ayx stayb munh nyăngz munh six đuungx nzongf, yâuc wâyc hayh zuc tayc songđ max hayh tuz stâyv quâyx ayx stayb munh, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />wâyc Zâu Yê-su six stâyv quâyx yămz, Nănh stâyv quâyx ayx stayb munh max hayh coi wănc, <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Yâuc wâyc nâyx, Nănh bix hayh njâuv tuz yetx stong păngc Nănh bix ninyh yămz stătx Zâu Tênb-Huungh wax đomc munh, wâyc Nănh six stâyv quâyx săngh nongc joođ tayv phunz stiz. <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />Wâyc senz sămv zuc ah tauh stayb munh năngđ nâyx phunz pănh: đăngb zeengh, max naih stoif, max naih wâyx, tuz lanyc gâyh wax đomc naih stoif nyăngz munh, yâuc tuz ênz muf năngx njăngb quaix wax đomc muif tab guungh; <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Nănh six max năngđ wax đomc stayb munh bix năngx sămv zuc muif noib stungx stanyb lanyh, tah yetx six tayv phunz cănh nyăngz stoif, cah đangz zef tayv phunz songx munh nyăngz stoif, wâyc Nănh jau đai ayx tuz soongb nzuf wax đomc cumh pâuz, yămz Nănh stungx cănh nyăngz stinb wax zanyf ah hâyđ six caux nzuf. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Wâyc gâyf njanh six njăpc wax đomc munh đoonh munh taih ayx stayb munh pyây, nzof nyunc nyăngz wac six taih đangz gâyf njanh, songđ njăpc Toonz taih, Nănh six ayx tuz clăkx clunh tauv banc stâyv banc đaic.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Pănh jinh đangh coong tauv nâyx đomc jau nongc sen quaix six: Pănh naih ah tauh stayb munh pyây năngđ nâyx, yămz cah zâyc muif tab guungh stâyv yămz Lub Quaix Wax Tauh nyăngz byaoh phanx, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />ah lanh đăngb zeengh tinc nyăngz pâuz cloon senz nyăngz njiuh tamf six tăng Zâu njăpc taih, max zâyf tăng bamh munh njăpc taih. <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />Wâyc muif tauh stayb munh pyây tuz njăpc taih six nongc stungx wax đomc jax dlaih cloon wax đomc stanyb lanyh, wâyc nây, nâyx Tauh lauf sămv zuc naih tix huungđ nongc phunz Nănh hayh stungx. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Wâyc nây, năngđ coong Nănh năngx jinh yămz nây bamh canz, Nănh six max zâyf stayb munh, wâyc yămz nây bamh canz naih wax đomc stayb munh nongc stungx tax huungđ âyz gâyf njanh nzof; <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />wax đomc munh canyx bongc six canyx bongc âyz cah zâyc guungh nyăngz gao, cayx năngđ Mô-sê cayx ayx njiuh tamf wax zanyf yâuc tuz zăpc bux, wâyc Zâu Tênb-Huungh coong: “Oix zuc năngx cayb, mâyh oix zuc ayx muif huungđ âyz năngđ tuz hinđ phunz mâyh yămz wa zoongz wax đomc nâyx.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Six nâyx zanyf Nănh tuz stipx ah cuyb cumh pâuz năngx saix quaix, Nănh yâuc ayx mungh tongx Munh yămz nây năngx gongx quaix nyăngz nhlengc wac, nây nhlengc wac six tuz njăpc taih tăng wax đomc năngx gongx quaix nyăngz nyunc wac. <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />Wâyc năngđ coong tah yetx hâyđ nyăngz nhlengc wac bix tuz clăkx clunh nzuf, six max naih jau nongc njăpc tah nyâyc hâyđ nyăngz nhlengc wac. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Wâyc Zâu Tênb-Huungh coong mađ songx munh wax zanyf, Nănh coong:</para>
  <para style="q1" vid="HEB 8:8">“Phanv mangc, wax đomc noib six taih tauv, Zâu coong:</para>
  <para style="q1" vid="HEB 8:8">Yaz six cloon I-sa-la-ên munh căn Yu-đa nyăngz munh</para>
  <para style="q2" vid="HEB 8:8">njăpc ah cuyb săngb nhlengc wac;<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />max năngđ Yaz cloon stiz wax đomc claof jex</para>
  <para style="q2" vid="HEB 8:9">njăpc nyăngz nhlengc wac,</para>
  <para style="q1" vid="HEB 8:9">yămz Yaz nzauf stiz nyăngz puf</para>
  <para style="q2" vid="HEB 8:9">ênz stiz setb I-yipx stâyz phangz nyăngz noib,</para>
  <para style="q1" vid="HEB 8:9">wâyc stiz max âyz Yaz nyăngz nhlengc wac ayx,</para>
  <para style="q2" vid="HEB 8:9">Yaz songđ quanyf nănh stiz,</para>
  <para style="q1" vid="HEB 8:9">Zâu coong.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Wâyc nây six</para>
  <para style="q2" vid="HEB 8:10">Yaz cloon I-sa-la-ên munh njăpc nyăngz nhlengc wac,</para>
  <para style="q1" vid="HEB 8:10">blătc wax đomc noib,</para>
  <para style="q2" vid="HEB 8:10">Zâu coong,</para>
  <para style="q1" vid="HEB 8:10">Yaz six zoz gâyf njanh ănz stiz nyăngz pyây lâyc,</para>
  <para style="q1" vid="HEB 8:10">Yaz yâuc ja gâyf njanh ănz stiz nyăngz stimz nyâuđ,</para>
  <para style="q1" vid="HEB 8:10">Yaz six ayx stiz nyăngz Zâu Tênb-Huungh,</para>
  <para style="q1" vid="HEB 8:10">nzof stiz six ayx Yaz nyăngz pec stingx.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Stiz six max zâuđ năngx zuc nzaox stiz nyăngz njăngv sangc munh</para>
  <para style="q1" vid="HEB 8:11">max six stiz nyăngz săngh lanh yâuf pez coong: ‘Oix zuc pâyz Zâu,’</para>
  <para style="q1" vid="HEB 8:11">wâyc tăng ayx năngx jenz quaix nyăngz munh tauv ayx năngx lub quaix nyăngz munh,</para>
  <para style="q1" vid="HEB 8:11">stiz tinyh đoih six cănh pâyz tuz Yaz.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Wâyc Yaz six quanyf stiz ayx wax đomc huđ nyăngz jau,</para>
  <para style="q1" vid="HEB 8:12">yâuc max săngx tauv stiz ayx nyăngz stoif gôh.”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Wâyc tuz hipđ ayx “săngb”, Nănh songđ ayx phunz zetx cuyb nyăngz nhlengc wac pênx lôx nyăngz, nzof laiv huungđ tuz hipđ ayx lôx nyăngz six max săngb nzof yâuc zuc jac ninyh nzuf.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Tah yetx hâyđ nyunc nyăngz nhlengc wac lauf naih ayx gâyf paix nyăngz gâyf, cloon ah cuyb đăngb zeengh tinc yămz nây nib, <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />wâyc ah nomz njiuh tamf tuz ayx taih, zetx hoongv, six naih toongz jax cloon đah mâyf, cloon congx nyăngz nzu, wax cuyb tinc six tuz hipđ ayx “Đăngb Zeengh Tinc”, <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />nzof nzac wa buyx cah đangz muf tah nyâyc wax hoongv six njiuh tamf, wax cuyb tinc six tuz hipđ ayx “Đăngb Zeengh Quaix Nyăngz Tinc”, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />naih ah nomz sămz đah mâyf nongc pu huungb, cloon wax nomz nyunc nhlengc wac nyăngz hoomh nongc sămz pêuz nzêux nzuf, yămz wa cah njaf six naih ah nomz sămz eengz ănz ma-na, cloon A-lôn nyăngz pya byac săngh phăngh, cloon wax đomc nyunc nhlengc wac nyăngz njauz peen, <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />wa hoomh cah zâyc, six wax đomc zê-lu-bim gwăngz eeng coomx nzuf hoomh gaix, six nâyx zanyf yâuc mayv coong tuz wax đomc săngh huungđ yox nzuf. <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />Nzof tauv wax đomc muif huungđ tuz năngđ nâyx ayx săngh wax zanyf, wax đomc stayb munh six njinh leox nzac tah yetx wax hoongv njiuh tamf ninyh, ayx stiz stayb munh nyăngz cumh pâuz; <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />six yămz tah nyâyc wax hoongv six cungb stayb munh pyây nzăngđ tuz nzac cuungv, ah nyăngv nzac ah hâyđ, yâuc max naih laiv hâyđ coong max zuc nzâyz samđ nongc phunz nănh stungx tayv nănh nyăngz stoif cloon songx munh nyăngz stoif. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Zâu Singx-Lingh păngc wax đomc dlayc bix hinđ manyf coong, tinyh phanv laiv zanyf tah yetx wax nomz njiuh tamf năngx jinh naih têx, six nzac đăngb zeengh quaix nyăngz tinc wax stinz jau lauf max zeengx tuz hinđ setb taih, <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />nzof wax đomc yâuc nongc pây tauv nâyx yenh stâyv, âyz năngđ wa, njinh jax dlaih cloon stanyb lanyh tuz stungx nyăngz, six max hayh ayx phunz canyx bongc nyăngz munh naih clăkx clunh nyăngz stimz nyâuđ, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />wax đomc six cungb stinb a njăpc taih nyăngz gâyf, năngđ nhlinc, hopb, cloon wax đomc đaox dlăngc nyăngz stêtz, six tuz njăpc taih nongc zu tauv săngx huđ tuz coi wănc.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Six Zâu Jix-Tuz taih ayx ah tauh stayb munh pyây phunz muif huungđ gongx nyăngz jau tuz tauv tauh, yămz năngx lub quaix yâuc năngx gongx quaix nyăngz njiuh tamf, max zâyf tăng bamh munh nyăngz puf ayx taih, yâuc max zâyf săngh nâyx nomz zuyx taih nyăngz nib minc nyăngz, <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Yâuc max zâyf nongc yuungh congz cloon ngoongh wăngh jenz nyăngz samđ, six nongc Nănh cănh nyăngz samđ, Nănh nzac năngx đăngb zeengh quaix nyăngz tinc ninyh ah hâyđ đokc bix caux nzuf, yâuc tuz stâyv quâyx nongc stav stoif. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Wâyc năngđ coong yuungh congz cloon ngoongh wăngh câu nyăngz samđ, cloon plauf ngoongh wăngh janx nyăngz saiđ ănz wax đomc naih wâyx nyăngz munh bix năngx hayh tuz stav đăngb, yămz stav stiz nyăngz stinb a, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />năngđ nâyx, Zâu Jix Tuz nyăngz samđ, Nănh six păngc stâyv quâyx yămz nyăngz Singx-Lingh bix stungx cănh nyăngz stinb nongc ayx stanyb lanyh, max naih paz max naih tinc nzêmh phunz Zâu Tênb-Huungh, six nongc stav nyâuh nyăngz stimz nyâuđ ayx tuz tauv laiv zanyf gâyh đutb wax đomc tayc nyăngz cumh pâuz jau, bix nongc bokc dlic stâyv quâyx săngh nyăngz Zâu Tênb-Huungh! <verse eid="HEB 9:14" /><verse number="15" style="v" sid="HEB 9:15" />Wâyc nây, Nănh six ayx Mungh Tongx Munh yămz nây săngb nhlengc wac, Nănh zuc tayc nongc suc ayx longđ yămz lôx nhlengc wac wax đomc stoif, phunz laiv lanh tuz êu taih six hayh tuz stipx nyunc phunz wax đomc stâyv quâyx nyăngz phănc. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Wâyc yămz laiv tix naih njăpc jaoz jax toongx nyăngz tanz, yămz wa six oix zuc zu tauv njăpc jaoz jax toongx nyăngz tanz wax tauh munh quaix stâyv. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Wâyc cungb wax tauh munh tayc blătc wax cuyb tanz nzăngđ tuz nongc sen, wâyc nây năngđ coong njăpc tanz wax tauh munh năngx jinh săngh wax cuyb tanz six max zeengx tuz nongc sen. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Nzof, hănđ njinh tah yetx cuyb nhlengc wac lauf zuc nongc samđ njăpc taih. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Wâyc Mô-sê coong muif tiuh gâyf njanh nyăngz lanyf phunz yetx stong songx munh wax zanyf, nănh zoz ngoongh wăngh jenz cloon yuungh congz samđ, cloon womz cloon stâyz buungb stib, cloon baih hâng njăngx quah, plauf ănz njinh wax glonc stâub cloon yetx stong songx munh, <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />yâuc coong: “Nây six njăpc nhlengc wac nyăngz samđ tăng Zâu Tênb-Huungh zăpx phunz nyâuh.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Yâuc lauf tinyh năngđ, nănh zoz samđ plauf ănz wa njiuh tamf cloon muif huungđ nongc ayx stayb munh cumh pâuz wax đomc tungh zăngc tauv laiv. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Âyz năngđ gâyf njanh, muif huungđ six tuz nongc samđ stav nzuf, nzof năngđ max naih samđ njâuc setb six max hayh tuz quanyf stoif.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Wâyc nây, yămz wa, six cungb jangx pây wa cah zâyc guungh senz nyăngz nyăngz tax huungđ cuungv bix năngx tuz stav đăngb tăng nâyx đomc stanyb lanyh, six yămz nây, senz yămz wa cah zâyc guungh nyăngz tax huungđ lauf zuc nongc năngx gongx quaix nyăngz stanyb lanyh stav đăngb, <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />wâyc Zâu Jix-Tuz six max zâyf nzac tăng bamh munh nyăngz puf ayx taih nyăngz đăngb zeengh tinc — six cungb jangx pây wa senz nyăngz wax đomc — yâuc senz tuz nzac wa tênb-toongh cah njaf ninyh, nongc phunz nâyx zanyf yămz Zâu Tênb-Huungh nyăngz cah đangc wâyc phunz pănh, <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />yâuc max zâyf coong nongc stungx Nănh đuungx hâyđ, cayx năngđ wax đomc stayb munh pyây zuc muif nyăngv nzac wa đăngb zeengh tinc cah njaf ninyh stungx samđ yâuc max zâyf stiz nyăngz; <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />wâyc năngđ coong max zâyf nâyx têx, Nănh six sămv zuc tanyđ zâuđ đuungx hâyđ tăng ah yac zuyx guungh zuyx nib wax zanyf. Six nâyx zanyf, yămz nây stâyz phangz đany, Nănh bix tuz hinđ setb taih ah hâyđ đokc, stungx Nănh nongc ayx stanyb lanyh, wâyc tayv stoif. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Âyz năngđ tingc taih, bamh munh six zuc tayc ah hâyđ, nzof quaix đangz yâuc zuc stămđ stoif, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />lauf tinyh năngđ, Zâu Jix-Tuz cănh stungx Nănh ah hâyđ đokc nongc tayv đuungx lanh munh nyăngz stoif, Nănh zef năngx taih tah nyâyc hâyđ timb max zâyf wâyc nongc tayv stoif nzof, six nongc sađ njâuv pôz phunz wax đomc sâub sâuđ zu Nănh nyăngz munh.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Wâyc gâyf njanh — six cungb ayx cayx taih wax đomc gongx nyăngz bah cloiz cuungv, max zâyf wax đomc senz nyăngz hanyh jangx — stiz muif nyăngv nzâyz wax đomc stanyb lanyh ninyh congx yâuc max hayh ayx phunz ninyh yămz stătx Zâu Tênb-Huungh wax đomc munh tuz clăkx clunh. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Năngđ coong tuz têx, six wax đomc canyx bongc nyăngz munh tuz stav đăngb ah hâyđ six caux nzuf, stiz max numđ năngx naih stoif nzof, ha nâyx max zâyf max zâuđ năngx zuc stungx stanyb lanyh nzof haz? <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Six, wax đomc stanyb lanyh, yâuc cungb ayx phunz stiz săngx tauv muif nyăngv nyăngz stoif. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Wâyc ngoongh wăngh câu cloon yuungh congz nyăngz samđ six max hayh stav tuz stoif đangđ. <verse eid="HEB 10:4" /><verse number="5" style="v" sid="HEB 10:5" />Wâyc nây, Zâu Jix-Tuz nzac bamh canz taih wax zanyf, Nănh songđ coong:</para>
  <para style="q1" vid="HEB 10:5">“Zâu max oix</para>
  <para style="q2" vid="HEB 10:5">stanyb lanyh cloon jax dlaih,</para>
  <para style="q2" vid="HEB 10:5">six Mâyh bênc săngh ah nomz stinb a phunz Yaz;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Mâyh yâuc max oix wax đomc</para>
  <para style="q2" vid="HEB 10:6">pu congx nyăngz tax huungđ cloon stav stoif nyăngz tax huungđ.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Yaz songđ coong: ‘Zâu Tênb-Huungh lex, mangc Yaz taih —</para>
  <para style="q2" vid="HEB 10:7">âyz năngđ tuz ja coong tauv yaz yămz wax đomc stâub nyăngz wac —</para>
  <para style="q1" vid="HEB 10:7">nongc ayx âyz Mâyh nyăngz zux ix.’”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />Năngđ Nănh coong yămz wa cah zâyc nâyx coong: “Zâu Max oix wax đomc stanyb lanyh cloon jax dlaih, cloon wax đomc pu congx nyăngz tax huungđ, cloon stav stoif nyăngz tax huungđ. Nănh yâuc max oix wax đomc tax huungđ” (wâyc stiz cungb âyz gâyf njanh stungx), <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Nănh zef coong: “Phanv mangc, Yaz taih nongc ayx âyz Mâyh nyăngz zux ix.” Nănh sâub nzuf lôx nyăngz wax đomc tauv laiv, nongc njăpc săngb nyăngz taih. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Păngc yămz wax cuyb zux ix, pănh bix tuz stav đăngb, wâyc Zâu Yê-su Jix-Tuz stungx Nănh nyăngz stinb nongc ayx stanyb lanyh ah hâyđ đokc bix caux nzuf. <verse eid="HEB 10:10" /><verse number="11" style="v" sid="HEB 10:11" />Muif tauh stayb munh six muif noib stâuđ wa ayx stayb munh nyăngz cumh pâuz, yâuc njinh leox stungx stanyb lanyh max setc tiny, six wax đomc stanyb lanyh yâuc max naih laiv zanyf hayh stav tuz stoif đangđ. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Six Nănh wâyc stoif bix stungx stanyb lanyh ah hâyđ đokc yâuc tuz tauv stâyv quâyx, songđ tuz stâyv yămz Zâu Tênb-Huungh nyăngz byaoh phanx, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />zu ayx tuz tauv laiv zanyf Nănh wax đomc yônz zaz zuc tăpx ănz Nănh nyăngz staux đi. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Wâyc păngc ah cuyb stanyb lanyh, Nănh bix ayx phunz wax đomc tuz stav đăngb nyăngz munh tuz clăkx clunh tauv stâyv quâyx. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Nzof Zâu Singx-Lingh lauf ayx zanyx manyf phunz pănh, yâuc coong:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Nây six Yaz cloon stiz njăpc nyăngz nhlengc wac</para>
  <para style="q2" vid="HEB 10:16">blătc wax đomc noib, Zâu coong,</para>
  <para style="q1" vid="HEB 10:16">Yaz six zoz Yaz nyăngz gâyf ănz stiz nyăngz stimz nyâuđ cah njaf,</para>
  <para style="q2" vid="HEB 10:16">Yaz yâuc ja ănz stiz nyăngz pyây lâyđ.”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Zef coong:</para>
  <para style="q1" vid="HEB 10:17">“Yaz six max săngx tauv stiz ayx nyăngz stoif</para>
  <para style="q2" vid="HEB 10:17">cloon stiz ayx huđ wax đomc.”<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Wâyc zuc yămz laiv tix tuz quanyf wax đomc ayx longđ nyăngz stoif, yămz wa six max zâuđ năngx zuc stungx stanyb lanyh nongc stav stoif.<verse eid="HEB 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Wâyc nây, yâuf pez lex, păngc Zâu Yê-su nyăngz samđ pănh bix hayh tuz pungx stimz nzac wax đomc đăngb zeengh nyăngz tinc, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Nănh coib phunz pănh ah stinz săngh nyăngz săngb jau clăngv quaix wax tungđ buyx ninyh, nây six cănh Nănh nyăngz stinb, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />yâuc ayx ah tauh stayb munh năngx lub quaix cun yămz Zâu Tênb-Huungh nyăngz pyau, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />wâyc nây pănh oix zuc neetb stimz zen năngx tingc, nongc samđ stav đăngb huđ nyăngz stimz nyâuđ, yâuc nongc womz đăngb đaox dlăngc nyăngz stinb a, bix ninyh yămz stătx Zâu Tênb-Huungh. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Pănh oix zuc nzauf năngx tăngđ pănh nhlimc nyăngz njih mungc năngx gâyf plungh plănb, wâyc nyunc wac wax Tauh six neetb stimz. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Pănh oix zuc lanh jămđ lanh phunz hayh naih nyâuđ lanh stăngz lanh yâuc ayx gongx nyăngz jau, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Năngx gâyf queengx pănh căpx dlonf nyăngz jau cayx năngđ naih ah phanx munh queengx quênx nâyx, plănc taih six oix zuc lanh oonz lanh nyăngz nyâuđ, nyâuh phătc zâu nyăngz noib taih tauv stătx ayx năngđ laix, yâuc oix zuc căpx dlonf năngx yongb năngđ wa nâyx.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Wâyc năngđ coong pănh tuz pâyz nzuf senz gâyf bix lauf năngx cah đanyc ninyh ayx longđ stoif, six max naih stanyb lanyh nongc stav tuz stoif nzof gôh, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Six cungb zuc zu tauv senz cumh nzav nzongf nyăngz zuc stămđ stoif, bix nongc hongđ nzongf nyăngz tâuf pu, six tuz bênc săngh nongc pu Zâu nyăngz yônz zaz wax đomc tâuf. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Tinyh phanv laiv lanh ayx longđ Mô-sê nyăngz gâyf njanh, bix naih iz pôz lanh munh ayx zanyx manyf, six tayc max tuz hâuđ lênh. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Nyâuh nyâyh mungv jađ, laiv lanh munh zaiđ Zâu Tênb-Huungh nyăngz Toonz, yâuc stunx njăpc nhlengc wac nyăngz samđ nongc ayx naih wâyx — six păngc wax cuyb samđ, nănh bix tuz stav đăngb — yâuc mangc stam Singx-Lingh nyăngz pôz, wax tauh munh six payh tuz zuc tingc stoif niđ ayx năngđ laix? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Wâyc pănh pâyz tuz coong nâyx đomc wac wax Tauh, coong: “Clao yônz six yămz Yaz; Yaz six senz clao.” Zef coong: “Zâu six stămđ Nănh nyăngz pec stingx.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Năngđ nây, zuc tuih nzac stâyv quâyx săngh wax Tauh Zâu Tênb-Huungh nyăngz puf six senz cumh nzav nzongf!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Oix zuc săngx tauv cah đangc noib, six nyâuh ah yac tuz siux gwăngz wax đomc noib, nyâuh yâuc zuc tanyđ zâuđ lub nzongf, zuc pongh đuungx huungđ zâuđ nanc, <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />ah zanyf yâuc zuc tanyđ munh toongx songx pib mađ, yâuc zuc ayx huđ ănz, ah zanyf yâuc zuc cloon wax đomc pongh zuc ayx huđ năngđ nâyx nyăngz munh songc tanyđ zâuđ. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Nyâuh yâuc hâuđ lênh wax đomc yămz nzauh nyăngz munh, yâuc numđ nyađ tanyđ munh zab nyâuh nyăngz jax toongx, wâyc pâyz tuz coong nyâuh naih năngx gongx quaix nyăngz jax toongx yâuc stâyv quâyx yămz. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Wâyc nây nyâuh năngx gâyf quanyf nyâuh zen tingc nyăngz jau, nây six senz hayh tuz stipx lub nzongf nyăngz sâuđ nyâyc. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Nyâuh six oix zuc nongc nyâuđ tanyđ, phunz tauv ayx tuz âyz Zâu Tênb-Huungh nyăngz zux ix, nyâuh songđ hayh tuz stipx nyunc phunz nyăngz phănc.<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />“Wâyc max naih lauh,</para>
  <para style="q1" vid="HEB 10:37">năngx taih wax Tauh six taih, Nănh yâuc max ngaih.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Yaz nyăngz peengh stimz munh six păngc zen stimz bix săngh;</para>
  <para style="q1" vid="HEB 10:38">six năngđ coong laiv lanh winb đangz, Yaz nyăngz mengc hoonh six max numđ nyađ nănh.”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Nzof pănh six max zâyf winb đangz ninyh nongc zuc mêtc nyăngz munh, plănc taih pănh six oix zuc yămz zen stimz phunz mengc hoonh hayh tuz njâuv.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Zen stimz six senz zen tingc yămz pănh sâub sâuđ zu wax đomc, nây six ayx zanyx manyf phunz pănh mangc max phătc tuz wax đomc. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Wâyc zen stimz, bix lôx noib wax đomc munh tuz săngh gongx nyăngz zanyx manyf. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />Yâuc wâyc zen stimz pănh bix pâyz tuz coong nâyx nomz guungh nib tuz ayx săngh six păngc Zâu Tênb-Huungh coong nyăngz wac — phunz mangc phătc nyăngz muif huungđ six max zâyf tăng tuz mangc phătc nyăngz ayx taih. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />Wâyc zen stimz A-bên bix stungx stanyb lanyh phunz Zâu Tênb-Huungh năngx gongx quaix Ca-in nyăngz, păngc nây nănh bix tuz stunx ayx peengh stimz, nzof Zâu Tênb-Huungh yâuc stipx nănh congx nyăngz tax huungđ nongc ayx zanyx manyf, yâuc wâyc zen stimz A-bên bix lauf năngx jinh coong wac max cun nănh tayc. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Wâyc zen stimz Ê-nokx bix tuz ênz muf, max zâuđ zuc tayc, nzof “munh yâuc lov nănh max phătc, wâyc Zâu Tênb-Huungh ênz nănh muf.” Nănh max zeengx tuz ênz muf wax zanyf, yâuc tuz stunx coong nănh ayx hoopđ Zâu Tênb-Huungh nyăngz nyâuđ. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Wâyc nây, max naih zen stimz six max hayh ayx tuz hoopđ Zâu Tênb-Huungh nyăngz nyâuđ, wâyc laiv lanh taih lov Zâu Tênb-Huungh six oix zuc zen coong Nănh six senz naih, nzof Nănh six sađ sâuđ nyâyc phunz taih lov Nănh wax đomc munh. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Wâyc zen stimz, Nô-ya tuz Zâu bux tauv max zeengx tuz phătc nyăngz jau wax zanyf, songđ cumh nzav, bix ayx ah saz đangđ lub nongc njâuv nănh nyăngz pyau munh, wâyc nây nănh songđ tingc bamh canz, yâuc tuz pênx ah lanh peengh stimz munh păngc yămz zen stimz. <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />Wâyc zen stimz, Apx-la-ham tuz Zâu êu songđ mungv wac bix ninyh tauv nănh tuz stipx nyăngz nib tâyc wax nomz tinc, nănh setb ninyh yâuc max pâyz tuz nănh jinh đangh ninyh laiv. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Wâyc zen stimz nănh bix ninyh yămz wa nyunc phunz nyăngz nib tâyc ayx cayx năngđ pitc stingx munh, yâuc cungb yămz đupx njiuh nzof I-sakx cloon Ya-côpx, yâuc tuz cloon nănh stipx ah cuyb nyunc nyăngz wac, <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />wâyc nănh sâub sâuđ zu ah nomz dlanyh naih coonz tay, tăng Zâu Tênb-Huungh cănh ayx stăngc yâuc ta zux ix zâyv taih nyăngz dlanyh. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />Wâyc zen stimz max cun Sa-la hănđ côx tuz blătc toongv lauf năngx hayh tuz naih sây, wâyc nănh pâyz tuz nyunc wac wax Tauh six senz neetb stimz. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Wâyc nây, lauf tăng ah lanh munh — max cun hănđ tayc nzof — six wax đomc sây stunz lauf tuz steengb taih đuungx hongđ cayx năngđ wa guungh wax đomc stingz tau, yâuc cayx năngđ coiđ sinh nyăngz njăuz staiz max hayh stauđ tuz tongf. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />Yămz zen stimz nyăngz jau, wax đomc muif lanh munh yâuc tayc nzof six max zeengx tuz stipx wax đomc nyunc nyăngz wac, cungb tuz mangc phătc tăng côz yâuc numđ nyađ stipx, songđ cănh stunx coong stiz six pitc nomz stâyz phangz taih nyăngz munh, yâuc ayx quaix jau nyăngz munh yămz nây nib minc. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Nzof wax đomc coong nâyx đomc wac năngđ nâyx nyăngz munh, six tuz hinđ manyf coong stiz six jinh đangh lov senz stiz nyăngz stâyz phangz. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Năngđ coong stiz săngx tauv stiz tăng wa setb ninyh nyăngz stâyz phangz, stiz six năngx hayh tuz naih săngx huđ nongc phunb đangz muf. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Six nâyx zanyf stiz oix nongc ah nomz tinc năngx gongx quaix, nây six yămz wa cah zâyc guungh nyăngz stâyz phangz. Năngđ nây Zâu Tênb-Huungh songđ max numđ nyayz nănh stiz, yâuc coong Nănh six ayx stiz nyăngz Zâu Tênb-Huungh, wâyc Nănh bênc săngh ah nomz dlanyh phunz stiz. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />Wâyc zen stimz, Apx-la-ham songđ stungx I-sakx yămz nănh zuc stâyv nyăngz săngx huđ, max cun nănh tuz stipx nyunc nyăngz wac blătc, nănh cungb ah lanh đokc toonz nănh yâuc nzâyz ninyh stungx, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />nzof yămz wax tauh toonz, yâuc tuz naih wac coong: “Tăng I-sakx, mâyh nyăngz sây stunz six tuz nongc mâyh nyăngz bux êu,” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />wâyc pâyz coong Zâu Tênb-Huungh hayh ayx phunz munh tăng tayc săngh taih, nzof nănh yâuc tuz stipx nănh nyăngz toonz lauf, pây năngđ tăng tayc nyăngz tinc. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />Yâuc wâyc zen stimz I-sakx bix poou wac phunz Ya-côpx cloon Ê-sau coong tauv wax đomc cayx setb taih nyăngz dlayc. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />Wâyc zen stimz, Ya-côpx cayx quaix stâyv wax zanyf songđ poou wac phunz Yô-sepx nyăngz toonz săngh lanh săngh lanh têx, nănh songđ quâyc nzac bix cumf yămz nănh nyăngz pya pyac đanyf canyx bongc. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Wâyc zen stimz, Yô-sepx tauv nănh cayx quaix stâyv songđ coong tauv I-sa-la-ên munh setb ninyh nyăngz jau, yâuc zăpx stiz tauv nănh nyăngz stung. <verse eid="HEB 11:22" /><verse number="23" style="v" sid="HEB 11:23" />Wâyc zen stimz, Mô-sê steengb stâyv taih, songđ tuz nănh nyăngz nzif pha ênz ninyh pinyx tuz pôz lav cah njaf, wâyc stiz phătc tauh sây quai, stiz yâuc max cumh nzav huungh nyăngz lanyf. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />Wâyc zen stimz, tauv lub taih, Mô-sê max songđ nyenc phunz hipđ ayx Pha-la-ôn huungh sab nyăngz toonz. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Nănh yâuc noođ cloon Zâu nyăngz pec stingx songc tanyđ zâuđ, bix max noođ stipx tuz nyađ cay ah dlapc yămz stoif nyăngz jau. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Nănh pâyz tuz coong zuc tanyđ nyayz yămz Zâu Jix-Tuz six puv quâyx yâuc năngx saix quaix yămz wa I-yipx wax đomc jax dlaih, wâyc nănh cungb sâub sâuđ zu mungc tuz stipx nănh nyăngz sâuđ nyâyc. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Wâyc zen stimz nănh songđ tiuv I-yipx max cumh nzav huungh nyăngz siv totc, nănh yâuc nzac jab tanyđ ayx cayx năngđ cayx nănh phătc mangc max phătc wax Tauh. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Wâyc zen stimz, nănh songđ ayx Pyenv Mengc Stêtz cloon hâuh samđ, phunz ninyh mêtc wax đomc sây coonz wax tauh max hoiđ tauv I-sa-la-ên munh. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Wâyc zen stimz, songx munh songđ clăngv quaix Coiđ Stib cayx năngđ yăngh quaix nib gaib, nzof I-yipx munh coonx ninyh clăngv songđ zuc naz nzuf. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Wâyc zen stimz, Yê-li-cô wax đomc dlanyh tongc songđ lakb, wâyc nănh zuc ninyh quib tuz nhlic noib. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Wâyc zen stimz, maic stinb wax tauh munh nzif La-hapx songđ max zuc tayc cloon wax đomc max zen nyăngz munh, wâyc nănh nongc nyâuđ stipx wax đomc tungh seetx munh. <verse eid="HEB 11:31" /><verse number="32" style="v" sid="HEB 11:32" />Yaz zef năngx zuc coong luungđ timb heh? Wâyc săngx huđ max caux nongc phunz yaz coong tauv Gi-đê-ôn, Ba-lak, Sam-sôn, Yep-ta, Đa-witx, cloon Sa-mu-ên cloon wax đomc tâuc wac munh, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Stiz six wax đomc păngc zen stimz bix hingh tuz manf côkz, ayx peengh stimz nyăngz jau, yâuc tuz stipx nyunc nyăngz wac, pongz njanh zongh nyăngz nzetx, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />bopc tayc tâuf lâuh nyăngz jab, pyăux đutb nzuc đao minb, tuz hingh staiz gumc, tuz njoongh yămz panx peengz nyăngz jau, ayx phunz wax đomc pitc nomz côkz nyăngz peengz zuc puc stauc. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Naih đuungx lanh munh nzif tuz stipx stiz nyăngz pyau munh lauf six tayc bix tuz săngh taih wax đomc, six naih đuungx lanh munh zuc wâyb, yâuc max mungc coong oix nongc tuz pungx, phunz stiz hayh tuz stipx năngx gongx quaix yămz săngh taih nyăngz jau; <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />nzof naih ah phanx yâuc pongh zuc stâyv nyâuđ, zuc munh coong pib yâuc zuc pya stătb, yâuc năngx zuc njab langb stayb zef zuc yămz nzauh. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Stiz zuc zoz njăuz ôx, zuc tungh đoouf đoouf ayx iz phanx, stiz zuc tanyđ stâyv nyâuđ, zuc nzuc đao tayx tayc, stiz zuz pax jiz yuungh đupx, cloon yuungh đupx quaix sâuz quaix gwênc, zuc zâuđ max naih luungđ, zuc munh wâyb, zuc munh ayx đokc; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />(bamh canz max payh tuz phunz stiz yămz), zuc ninyh yămz wa stâyz phangz blănf, yămz zoongz zâyc, yămz wax đomc njăuz ngamh, cloon nib cotb. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />Stiz tuz naih zanyx manyf gongx wâyc stiz nyăngz zen stimz, six nâyx đomc munh yâuc max zeengx tuz stipx nyunc phunz stiz nyăngz wac, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />wâyc Zâu Tênb-Huungh bênc săngh năngx gongx quaix nyăngz jau taih phunz pănh, phunz năngđ max naih pănh, stiz six max hayh tuz clăkx clunh.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Năngđ nây, nâyx zanyf pănh jinh đangh naih đuungx lanh zanyx manyf munh nyăngz ah tungđ vănx lub nzongf yămz quib nzêux pănh, pănh six oix zuc quanyf nzuf tăng njanh pănh nyăngz muif huungđ quenđ nyâuđ cloon stoif nyăngz jau, bix nzac jab huungv ninyh pănh wa cah đangc phanx bix tinyh tâu tiuv, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />mangc tingc Zâu Yê-su, senz Ayx Coonz yâuc Ayx Stêtb Mâyv yămz zen stimz Wax Tauh, Nănh wâyc tăpx ănz Nănh wa cah đangc wax phanx nyăngz numđ nyađ bix tanyđ yămz săpc đăngc zax, mangc stam zuc coong pib nyăngz jau, nzof Nănh yâuc tuz stâyv yămz Zâu Tênb-Huungh byaoh phanx nyăngz huungh tinc. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Wâyc nây, oix zuc săngx tauv wâyc wax đomc stoif munh bix zuc tanyđ ayx huđ năngđ nâyx wax Tauh, phunz nyâuh nyăngz nyâuđ nzăngđ max conv đoonh, yâuc max tuih nyâuđ.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />Nyâuh lôx max zeengx tămx zax nzeengz cloon stoif nyăngz jau ayx tuz tauv setb samđ, <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />bix bâyf nyâuđ cob nzuf zăpx bux nyâuh wax đomc wac nzof, six zăpx nyâuh cayx năngđ sây nâyx wax đomc wac, coong:</para>
  <para style="q1" vid="HEB 12:5">“Yaz nyăngz sây lex, năngx gâyf mangc stam Zâu mađ nzaox nyăngz jau,</para>
  <para style="q1" vid="HEB 12:5">zuc Nănh coong mađ nyăngz săngx huđ yâuc năngx gâyf tuih nyâuh;<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Wâyc Zâu stăngz laiv lanh Nănh six bopc nzaox,</para>
  <para style="q1" vid="HEB 12:6">nzof Nănh stipx laiv lanh nongc ayx sây, Nănh six nongc pya stătb.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Nyâuh six jinh đangh tanyđ zuc bopc nzaox nyăngz jau; nây six Zâu Tênb-Huungh jinh đangh ayx ănz nyâuh cayx năngđ sây nâyx. Wâyc naih laiv lanh sây bix max zuc pha bopc nzaox heh? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Six năngđ coong nyâuh max zuc tanyđ bopc nzaox nyăngz jau, six wax đomc muif lanh ayx sây nyăngz munh tinyh đoih zuc tanyđ nyăngz jau, năngđ nâyx têx nyâuh six cungb wax đomc jau tauh sây cuungv, max zâyf wax đomc senz sây. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Nzof pănh naih yămz nây stinb a nyăngz pha bopc nzaox pănh, pănh lôx năngx zuc puc nzof, năngđ nâyx yămz mengc hoonh nyăngz Pha, pănh max zâyf hoopđ zuc puc năngx nzongf têx, nongc phunz pănh tuz săngh haz? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Max cun nây stinb a nyăngz pha bopc nzaox pănh tix cay ah dlapc, six âyz stiz numđ săngh nyăngz jau, nzof mengc hoonh nyăngz Pha bopc nzaox six nongc phunz pănh tuz gongx, wâyc nongc phunz tuz songc Nănh nyăngz đăngb zeengh phănc. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Wâyc wax đomc bopc nzaox nyăngz săngx huđ six max naih laiv huungđ numđ nyađ ah tiny, six cungb munz cuungv, six tauv blătc quaix đangz, nzăngđ hayh naih peengh oonz yămz peengh stimz nyăngz cumh pâuz jau, phunz wax đomc tuz hoođ leenz tăng nănh nyăngz munh. <verse eid="HEB 12:11" /><verse number="12" style="v" sid="HEB 12:12" />Wâyc nây, oix zuc stuungb nyâuh đoonh nyăngz puf staox cloon đoonh nyăngz staux nyâyf zoongz, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />yâuc oix zuc ayx năngx zac nyâuh staux yăngh nyăngz jau, phunz staux quac nyăngz munh nzăngc max zuc ninyh longđ jau, six yâuc tuz zany gongx.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Oix zuc cloon tinyh đoih lov peengh oonz cloon đăngb zeengh nyăngz jau, năngđ max naih nâyx đomc jau six max naih mănv tuz phătc Zâu, <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Oix zuc bôngh săngx đanyf naih tix lanh pungx đutb Zâu Tênb-Huungh nyăngz pôz, bix hayh naih tix stinz đuungh imz bêux setb taih sêu lunc, yâuc hayh naih munh đuungx zuc naih wâyx stauc nănh, <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />năngx gâyf naih mănv ayx pongz lauh, yâuc mangc stam cayx năngđ Ê-sau, nănh wâyc ah tonx năngv bix maic nănh ayx toonz coonz nyăngz phănc. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Nzof nyâuh yâuc pâyz tuz coong blătc quaix đangz, nănh oix tuz stiz pha poou wac phunz, six nănh zuc quanyf, wâyc nănh max naih săngx huđ nongc nhlimc stoif, max cun nănh hănđ lov ayx tuz mâyc womz tuih.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Wâyc nyâuh six max zâyf ninyh tauv stătx ah nomz zoongz zâyc bix năngx hayh lumz tuz tauv, naih tâuf sac hongđ, naih nzămc meengh măkc, plâub plâub, cloon nzaox lub, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />naih cloon blungh blex stingb buib, yâuc naih cloon wax đomc wac stingb cumh nzav nzongf, ayx tuz laiv lanh mungv yâuc joođ êu năngx gâyf coong ănz stiz gôh. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Wâyc stiz max tanyđ tuz coong zăpx wax đomc wac: “Nzof năngđ coong laiv tauh jămx staov taih stătx nâyx nomz zoongz nănh yâuc zuc zoz njăuz ôx.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Wax huungđ tuz hinđ setb taih senz cumh nzav nzongf ayx tuz Mô-sê lôx năngx coong: “Yaz cumh nzav tuz stinb sinx nzuf.” <verse eid="HEB 12:21" /><verse number="22" style="v" sid="HEB 12:22" />Six, nyâuh yâuc tuz ninyh tauv stătx Si-ôn zoongz cloon stâyv quâyx săngh wax tauh Zâu Tênb-Huungh nyăngz dlanyh, six wa guungh nyăngz Yê-lu-sa-lem, cloon sax tinb sax panc tauh stinz munh căpx dlonf, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />cloon wax đomc sây coonz nyăngz jiux pangx six tuz ja bux yămz wax đomc muif tab guungh, cloon Zâu Tênb-Huungh six ayx muif lanh munh nyăngz Stămđ Stoif Quanz Wax Tauh, cloon tuz clăkx clunh wax đomc peengh stimz munh nyăngz mengc hoonh, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />cloon Zâu Yê-su, ayx Mungh Tongx Munh yămz nây săngb nhlengc wac Wax Tauh, yâuc cloon plauf nyăngz samđ, wax cuyb samđ six tuz coong năngx gongx têx A-bên nyăngz samđ. <verse eid="HEB 12:24" /><verse number="25" style="v" sid="HEB 12:25" />Oix zuc bôngh, săngx đanyf nyâuh pyenv jinh đangh coong nzaox wax Tauh. Wâyc năngđ coong wax đomc pyenv yămz nây nib minc coong bux stiz wax đomc munh bix max hayh pyăux tuz đutb nzof, pănh six zef năngx neetb têx timb, năngđ coong pănh winb đangz ănz tăng guungh taih wax Tauh, <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />yămz wax nzêuh Nănh nyăngz stingb lôx năngx ayx tuz nib đănz tongf, nzof nâyx zanyf Nănh yâuc năngx nyunc coong: “Ah hâyđ timb Yaz six năngx ayx max zâyf cungb nib đănz tongf cuungv, yâuc năngx njinh cloon guungh đănz tongf timb.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Nzof nâyx zâux coong “Ah hâyđ timb” six jinh đangh si tauv wax đomc hayh đănz tongf nyăngz muif huungđ six zuc zoz setb nzuf, six tuz zuyx taih wax đomc muif huungđ, nongc phunz max zuc đănz tongf wax đomc six năngx jinh yămz. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Wâyc nây, pănh oix zuc naih nyâuđ sâuf hâuđ, wâyc pănh tuz stipx ah nomz côkz max hayh đănz tongf, yămz wa pănh yâuc hayh tuz âyz Zâu Tênb-Huungh nyăngz zux ix bix canyx bongc, nongc nyâuđ zanyf yâuc cumh nzav, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />wâyc pănh nyăngz Zâu Tênb-Huungh six tâuf byetc nongc pu mêtc.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Nyâuh oix zuc stâyv quâyx naih lanh stăngz lanh. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Năngx gâyf quanyf stipx zeb nyăngz jau, naih munh ayx nâyx đomc jau, bix stipx wax đomc stinz munh yâuc max pâyz. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Oix zuc săngx tauv zuc yămz nzauh wax đomc munh, ayx cayx năngđ cloon stiz songđ zuc njab langb stayb, yâuc săngx tauv zuc ayx huđ ănz wax đomc munh, ayx cayx năngđ nyâuh lauf cloon stiz songc ah nomz stinb nâyx. <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />Yămz nyâuh cah njaf oix zuc zanyb zoongz pyau nyăngz jau, yămz zâuv bôngh njaf six oix zuc max naih wâyx, wâyc Zâu Tênb-Huungh six stămđ wax đomc ayx pongz lauh nyăngz munh cloon wax đomc văngf munh nyăngz munh. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Nyâuh ayx nhlinc ayx yămz six năngx gâyf mauh nyanh, oix zuc pong nyâuđ nyâuh naih nyăngz tax huungđ, wâyc Zâu Tênb-Huungh cănh coong: “Yaz six max naih laiv zanyf gâyh mâyh, nzof Yaz yâuc max naih laiv zanyf quanyf mâyh,” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />năngđ nây, pănh six tuz pungx stimz coong:</para>
  <para style="q1" vid="HEB 13:6">“Zâu six stăngc yaz wax Tauh yaz songđ max cumh nzav.</para>
  <para style="q1" vid="HEB 13:6">Munh cayx ayx laix ănz yaz?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Oix zuc săngx tauv yenv ênz nyâuh wax đomc munh, six nzaox Zâu Tênb-Huungh nyăngz gâyf phunz nyâuh wax đomc, oix zuc mangc stiz yămz stâyv sangc ayx nyăngz jau six năngđ laix, yâuc oix zuc ayx âyz stiz nyăngz zen stimz. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Zâu Yê-su Jix-Tuz cumh noib nâyx noib ninyh tauv banc stâyv banc đaic lauf max coi wănc. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Năngx gâyf phunz wax đomc gâyf njingc taih njaf nyâuh. Wâyc gongx nyăngz stimz nyâuđ six tuz clăkx clunh păngc yămz Zâu nyăngz pôz, max zâyf păngc wax đomc nhlinc hopb, laiv lanh păngc wax đomc jau six max hayh tuz luungđ gongx. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Pănh naih ah nomz congx tinc, yămz nây congx tinc, wax đomc ayx cumh pâuz yămz wa njiuh tamf nyăngz munh six max tuz naih gâyf nhlinc. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Wâyc stav stoif nyăngz samđ, six tăng stanyb hauđ setb taih, tuz stayb munh pyây nzâyz nzac wax đomc đăngb zeengh nyăngz tinc muf, nzof stiz nyăngz stayđ six zuc nzâyz ninyh pu ănz wa njiuh cungh ngwaic. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Wâyc nây Zâu Yê-su lauf zuc yămz wa dlanyh jeengh cungh ngwaic tanyđ zâuđ, phunz Nănh hayh nongc Nănh cănh nyăngz samđ stav đăngb songx munh. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Wâyc nây, pănh sămv zuc ninyh cloon Nănh yămz wa njiuh cungh ngwaic, cloon Nănh tanyđ nyayz. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Wâyc yămz nây pănh six max naih laiv nomz dlanyh stâyv quâyx yămz, nzof pănh six jinh đangh lov ah nomz cayx taih nyăngz dlanyh. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Păngc Nănh pănh bix bix tuz nongc tanv nyăngz wac ayx stanyb lanyh stungx phunz Zâu Tênb-Huungh yămz manf dlayc, nây six nongc nzetx nhlimc Nănh nyăngz manyh nyăngz cumh pâuz. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Yâuc năngx gâyf nyâuđ cob ayx gongx nyăngz cumh pâuz cloon setb stimz stăngc munh nyăngz jau, wâyc nâyx đomc năngđ nâyx six stanyb lanyh hoopđ Zâu Tênb-Huungh nyăngz nyâuđ. <verse eid="HEB 13:16" /><verse number="17" style="v" sid="HEB 13:17" />Oix zuc mungv yâuc buc yenv ênz nyâuh wax đomc munh, wâyc stiz sting điub jămđ nyâuh nyăngz mengc hoonh, cayx năngđ bâyf zuc ninyh coong manyf setb taih nâyx, phunz stiz hayh naih nyâuđ numđ nyađ ayx wax đomc cumh pâuz yâuc max yônx luungđ, wâyc nâyx đomc six max stăngc phunz nyâuđ tuz gongx.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Oix zuc cloo Zâu phunz buz, wâyc buz pâyz tuz coong buz naih gongx nyăngz stimz nyâuđ, songđ numđ oix yămz manf dlayc hayh ayx tuz clăkx clunh. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Six yaz yâuc oix quinb nyâuh ayx năngđ nâyx năngx nzongf têx timb, phunz yaz tuz pungx muf pongh nyâuh năngx căn.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Peengh oonz nyăngz Zâu Tênb-Huungh, Nănh njăpc Lub Quaix Wax Tauh Jămđ Pax Jiz Yuungh Nyăngz Zâu taih, six pănh nyăngz Zâu Yê-su, tăng tayc săngh taih păngc njăpc nhlengc wac nyăngz stâyv quâyx samđ, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />cloo Nănh bênc nyâuh taih nongc phunz muif huungđ gongx nyăngz jau, nongc ayx âyz Nănh nyăngz zux ix, phunz pănh hayh ayx hoopđ nyăngz jau yămz Nănh nyăngz cah đangc, păngc Zâu Yê-su Jix-Tuz, senz tuz naih gwăngz eeng tauv banc stâyv banc đaic wax Tauh. A-meen.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Yâuf pez lex, yaz quinb nyâuh oix zuc numđ nyađ stipx nây quinb nyăngz wac, wâyc yaz cungb ja cay tix zâux wac phunz nyâuh lêc. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Nyâuh pâyz coong pănh nyăngz yâuf pez Ti-mô-tai tuz pungx goib nzof, năngđ coong nănh taih nây căn yaz six tuz cloon nănh ninyh pongh nyâuh.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Joođ đeh tauv yetx stong yenv ênz nyâuh wax đomc munh cloon yetx stong đăngb zeengh nyăngz munh. Tăng I-ta-li wax đomc đăngb zeengh nyăngz munh lauf đeh tauv nyâuh.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Cloo Zâu nyăngz pôz cloon nyâuh tinyh đoih yămz.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>