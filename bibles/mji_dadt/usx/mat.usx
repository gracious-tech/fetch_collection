  <book code="MAT" style="id">EN_DADT mji-x-daoaodai_Dao⋅Ao⋅Dai_ltr Mon Sep 22 2025 11:58:02 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Ma-tai Cuđ Jenx</para>
  <para style="toc2">Ma-tai</para>
  <para style="toc3">Mat</para>
  <para style="mt">Ma-tai</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Zâu Yê-su Jix-Tuz nyăngz stu stongz, Đa-witx nyăngz sây stunz, cloon Apx-la-ham sây stunz: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Apx-la-ham steengb I-sakx, I-sakx steengb Ya-côpx, Ya-côpx steengb Yu-đa cloon nănh nyăngz yâuf pez, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yu-đa cloon nănh nyăngz au Ta-ma steengb Bê-lêtx cloon Zê-la, Bê-lêtx steengb Hêtx-lôn, Hêtx-lôn steengb Lam, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Lam steengb A-mi-na-đapx. A-mi-na-đapx steengb Na-soon. Na-soon stengb Sanx-môn. <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Sanx-môn cloon nănh nyăngz au La-hapx steengb Bô-atc, Bô-atc cloon nănh nyăngz au Lu-tê steengb Ô-bêtc, Ô-bêtc steengb Jêtc-si, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Jêtc-si steengb Đa-witx huungh, Đa-witx cloon U-đi nyăngz au steengb Sa-lô-môn.<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sa-lô-môn steengb Lê-hô-bô-am, Lê-hô-bô-am steengb A-bi-ya, A-bi-ya steengb A-sa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />A-sa steengb Yê-hô-sa-phatx, Yê-hô-sa-phatx steengb Yô-lam, Yô-lam steengb Utc-si-ya. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Utc-si-ya steengb Yô-tam, Yô-tam steengb A-hatx, A-hatx steengb Hê-sê-ci-ya, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hê-sê-ci-ya steengb Ma-natb-se, Ma-natb-se steengb A-môn, A-môn steengb Yô-si-ya, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yô-si-ya steengb Yê-cô-ni-ya cloon nănh nyăngz yâuf pez, toix stiz zuc luiđ pyăux ninyh Ba-bi-lôn.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Zuc pyăux ninyh Ba-bi-lôn blătc, Yê-cô-ni-ya steengb Sê-an-ti-ên, Sê-an-ti-ên steengb Sê-lup-ba-bên, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Sê-lup-ba-bên steengb A-bi-yut, A-bi-yut steengb Ê-li-ya-cim, Ê-li-ya-cim steengb A-sô, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />A-sô steengb Sa-đok, Sa-đok steengb A-cim, A-cim steengb Ê-li-ut, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Ê-li-ut steengb Ê-lê-a-sa, Ê-lê-a-sa steengb Mat-tan, Mat-tan steengb Ya-côpx, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Ya-côpx steengb Yô-sepx, Ma-li-ya nyăngz langh. Tăng Ma-li-ya, Zâu Yê-su, tuz hipđ ayx Zâu Jix-Tuz wax tauh tuz steengb taih. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Năngđ nây, muif stâyv, stâyv stipx stâyv staox taih, tăng Apx-la-ham tauv Đa-witx six săpc stâyx stâyv, Tăng Đa-witx tauv zuc luiđ pyăux ninyh Ba-bi-lôn six săpc stâyx stâyv, zef Tăng zuc luiđ pyăux ninyh Ba-bi-lôn tauv Zâu Jix-Tuz six săpc stâyx stâyv.<verse eid="MAT 1:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Zâu Yê-su Jix-Tuz steengb stâyv nyăngz jau lâuc six năngđ nây nâyx, Zâu Yê-su nyăngz nzif, Ma-li-ya, cloon Yô-sepx nyunc tinyh zoz, six stiz max zeengx tinyh cloon phâyx tiny, năngđ naz Ma-li-ya zef max cungb stinb six tăng Zâu Singx-Lingh taih. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yô-sepx, Ma-li-ya nyăngz langh, six munh gongx munh, wâyc max oix toongx songx lutb Ma-li-ya nyăngz minb mâyc, nănh songđ cayx đa nimx nimx ninyh queengx max nongc Ma-li-ya. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Six nănh jinh đangh nyâyh nâyx đomc jau, six phanv mangc, naih Zâu nyăngz stinz munh hinđ setb taih pongh nănh yămz ah tauh bâyx, bux nănh coong: “Đa-witx nyăngz sây stunz Yô-sepx lex, mâyh năngx gâyf nzêmh bix max nongc Ma-li-ya ayx au, wâyc nănh naih wax tauh sây six tăng Zâu Singx-Lingh taih. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Nănh six steengb tuz ah lanh toonz, mâyh six zuc oonz wax lanh sây bux hipđ ayx Yê-su, wâyc wax tauh sây six njâuv nănh nyăngz pec stingx gâyh đutb stiz nyăngz stoif.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Nâyx đomc dlayc setb taih six tuz toix nzuf cah đangc Zâu nongc tâuc wac munh coong nyăngz wac, coong:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />“Phanv mangc, naih ah lanh munh sab đăngb, nănh six naih stinb steengb tuz ah lanh toonz. Munh oix oonz wax lanh toonz nyăngz manyh bux hipđ ayx I-ma-nu-ên” — âyz gâyf six coong “Zâu Tênb-Huungh cloon pănh yămz.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Tauv điub taih, Yô-sepx ayx âyz năngb năngđ Zâu nyăngz stinz munh bux nyăngz wac, songđ zoz Ma-li-ya lauf nongc ayx nănh nyăngz au. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Six nănh max cloon Ma-li-ya songc tinc phâyx, tuz tauv Ma-li-ya steengb ah lanh toonz. Nănh songđ oonz wax lanh sây bux hipđ ayx Yê-su.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Zâu Yê-su steengb stâyv yămz Bêtx-le-hem môngf Yu-đê stâyz phangz wax nzêuh toix Hê-lôtx ayx huungh blătc quaix đangz, phanv mangc, naih wax đomc tongb manyh stênx stengb tăng tongz phanx taih tauv Yê-lu-sa-lem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />naic coong: “Steengb stâyv taih ayx Yu-tai munh nyăngz Huungh wax Tauh yămz laiv? Wâyc buz phătc Nănh nyăngz stingz tau yămz tongz pôngz setb songđ taih nongc canyx bongc Nănh.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Six numđ nâyx đomc wac blătc, Hê-lôtx huungh songđ numđ nyâuđ max gwanb tiny, njinh Yê-lu-sa-lem dlanyh nyăngz munh lauf năngđ nănh. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Hê-lôtx huungh songđ êu Yu-tai munh wax đomc muif lanh stayb munh pyây cloon nzaox gâyf stênx steengb, taih zah naic stiz coong: “Njâuv Zâu six yămz laiv steengb heh?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Stiz tauz Hê-lôtx coong: “Yămz Bêtx-le-hem Yu-đê stâyz phangz, wâyc tâuc wac munh ja năngđ nây nâyx,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Bêtx-le-hem môngf, Yu-đa stâyz phangz lex!</para>
  <para style="q1" vid="MAT 2:6">Mâyh max cănh năngx jenz têx yămz Yu-đa stâyz phangz nyăngz ayx côx lub cah đi wax đomc,</para>
  <para style="q1" vid="MAT 2:6">wâyc tăng mâyh oix naih ah Tauh huungh setb taih cun jămđ ênz,</para>
  <para style="q1" vid="MAT 2:6">yaz nyăngz pec stingx, I-sa-la-ên munh wax Tauh.’”<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Tăng wa, Hê-lôtx pinyx êu wax đomc tongb manyh stênx steengb taih naic nănh stiz, wax nomz stingz tau six tăng laiv zanyf setb. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Naic tuz, Hê-lôtx songđ êu stiz ninyh Bêtx-le-hem, zăpx stiz coong: “Tauv nyâuh ninyh, nyâuh bix năngx cayb zah lov wax tauh munh sây, tauv nyâuh lov phătc, bix lauf bux yaz, phunz yaz lauf hayh ninyh canyx bongc Nănh.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Mungv huungh stix coong tuz, stiz songđ setb jau ninyh, phanv mangc, cah đangc phătc yămz tongz pôngz setb wax nomz stingz tau ninyh đangc stiz, ninyh tauv munh sây yămz wax nomz tinc cah zâyc songđ yămf wa. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Phătc wax nomz stingz tau, stiz songđ senz numđ nyađ nzongf. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Tauv stiz nzac pyau cah njaf ninyh, phătc wax tauh sây jenz cloon Ma-li-ya, Nănh nyăngz nzif. Stiz songđ quâyc nzac paix canyx bongc Nănh, stiz zoz stiz nzâyz taih nyăngz jax dlaih pungx hođ phunz Nănh: wax đomc jax dlaih six, sămz, cloon, nyux hâng, cloon ah huungđ stungz đangz. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Six wâyc stiz tuz Zâu bux yămz ah tauh bâyx êu năngx gâyf phunb đangz muf Hê-lôtx wa, Nănh stiz songđ quaix pitc stinz jau muf stiz nyăngz stâyz phangz.<verse eid="MAT 2:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Tauv stiz muf blătc, phanv mangc, naih ah lanh Zâu nyăngz stinz munh hinđ setb taih pongh Yô-sepx quaix ah tauh bâyx, coong: “Tauv điub taih, bix ênz sây cloon sây nyăngz nzif pyăux ninyh I-yipx stâyz phangz, phanv yămz wa zu tauv laiv zanyf yaz bux mâyh, wâyc Hê-lôtx cayx lov nâyx tauh sây nongc tayx.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Tauv điub taih, Yô-sepx songđ ênz wax tauh sây cloon sây nyăngz nzif njinh nzămc pyăux ninyh wa I-yipx, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />nănh stiz yămz wa zu tauv Hê-lôtx tayc, năngđ nây setb taih wâyc phunz toix nzuf Zâu nongc tâuc wac munh coong nyăngz wac, nănh coong: “Yaz êu Yaz nyăngz sây tăng I-yipx setb taih.”<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Wax zanyf, Hê-lôtx phătc nănh zuc wax đomc tongb manyh stênx steengb jaf, nănh songđ numđ nhlenx nzongf, nănh setb lanyf ninyh, tayx nzuf wax đomc munh sây toonz jenz tăng iz nyăngv nzac loic yămz Bêtx-le-hem cah njaf cloon yămz nzêux nzuf wax tungđ stâyz phangz wax đomc, âyz tăng nănh naic wax đomc tongb manyh stênx steengb nyăngz noib lav stunx taih. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Năngđ nây six toix nzuf wax tauh tâuc wac munh Yê-lê-mi coong nyăngz wac, nănh coong:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Numđ naih stingb yămz wa La-ma dlanyh,</para>
  <para style="q1" vid="MAT 2:18">cun yônx meengc cun haoh stingb nămx njauh,</para>
  <para style="q1" vid="MAT 2:18">La-sên haoh phunz nănh nyăngz sây,</para>
  <para style="q1" vid="MAT 2:18">nănh yâuc max nongc mănv stăngc nănh zay stauh, wâyc nănh nyăngz sây max naih nzof.”<verse eid="MAT 2:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Six, tauv Hê-lôtx tayc blătc, phanv mangc, naih ah lanh Zâu nyăngz stinz munh hinđ taih pongh Yô-sepx quaix ah tauh bâyx yămz I-yipx, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />bux coong: “Tauv điub taih, bix ênz sây cloon sây nyăngz nzif muf I-sa-la-ên stâyz phangz, wâyc oix tayx nâyx tauh sây nyăngz meengc wax đomc munh tayc nzof.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Điub taih wax zanyf, Yô-sepx ênz sây cloon sây nyăngz nzif, muf nzac wa I-sa-la-ên stâyz phangz. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Six, numđ coong An-cê-la-atx ayx huungh cun Yu-đê stâyz phangz tayv nănh nyăngz pha, Hê-lôtx, Yô-sepx cumh nzav max nzađ ninyh tauv wa. Six wâyc tuz wax tauh bâyx bux quaix phunz nănh, nănh songđ muf nzac Ga-li-lê stâyz phangz, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />six ninyh tauv wa, nănh yămz ah nomz dlanyh hipđ ayx Na-sa-leetx, phunz tuz toix nzuf tâuc wac munh coong nyăngz wac, coong Mâyh six tuz munh hipđ ayx Na-sa-leetx munh.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Yămz wax đomc noib, Yô-hanx Quaix-gâyf, ninyh wa stâyz phangz blănf nzônh gâyf yămz Yu-đê stâyz phangz, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />coong: “Oix zuc nhlimc stoif, wâyc Tênb-toongh côkz taih tauv stătx.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Nây six tâuc wac munh I-sa-ya coong tauv wax tauh, nănh coong:</para>
  <para style="q1" vid="MAT 3:3">“Naih munh yămz wa stâyz phangz blănf hamv stingb lub coong:</para>
  <para style="q1" vid="MAT 3:3">‘Oix zuc bênc săngh Zâu nyăngz jau,</para>
  <para style="q1" vid="MAT 3:3">Nănh nyăngz jau oix zuc ayx năngx yenh.’”<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Nâyx tauh Yô-hanx zuz nyăngz guyz quav six nongc maf loh pyâyz ayx taih, nongc đupx ayx quav langb stayb clai, nănh nyăngz nhlinc hopb six jeengz đekx cloon jêmh nyăngz mâyf toongh. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Wax zanyf Yê-lu-sa-lem dlanyh nyăngz songx munh, cloon yămz nzêux Yu-đê stâyz phangz yămz stătx Njoh-đen wăngx wax đomc, tinyh đoih ninyh Yô-hanx wa, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />stiz nhlimc stoif wax zanyf, stiz tuz Yô-hanx ayx quaix-gâyf yămz wa Njoh-đen wăngx. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Tauv mangc phătc đuungx lanh Pha-li-si munh cloon Sa-đu-si munh taih wâyc stiz oix tuz ayx quaix-gâyf, Yô-hanx coong ănz stiz: “Nyâuh lâyc đomc nangz meengz nyăngz sây stunz lex! Mănv bux nyâuh tiuv đutb cayx zuc tingc stoif nyăngz jau heh? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Wâyc nây, oix zuc ayx năngx hoopđ payh tuz coong nyâuh senz coi nyâuđ nhlimc stoif. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Nyâuh yâuc năngx gâyf nyâyh ayx nzetx lub bix lanh coong ănz lanh: ‘Pănh naih claof jex Apx-la-ham.’ Yaz coong ănz nyâuh năngđ nây nâyx, Zâu Tênb-Huungh hayh ayx phunz nâyx đomc njăuz, phutx săngh Apx-la-ham nyăngz sây stunz. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Nâyx zanyf pâu bâyf pob wa njăngx đuungh nzof. Wâyc nây, muif zâyz njăngx năngđ coong laiv zâyz max săngh pyâu gongx six zuc coix nzac bix quanyf ănz tâuf. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Yaz nongc womz ayx quaix-gâyf phunz nyâuh, coong tauv nhlimc stoif nyăngz jau. Six taih đangz yaz wax Tauh năngx naih jab naih lanyf têx yaz, yaz cloon wax Tauh yaz six ah lanh lôx max payh tuz ninyv Nănh nyăngz stub. Nănh six nongc Zâu Singx-Lingh cloon tâuf ayx quaix-gâyf phunz nyâuh; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Nănh nyăngz puf nzauf săngb, Nănh six nyumv dlăngc Nănh bopc nyăngz blauh, zoz zub ănz nzac Nănh nyăngz njămf ninyh. Six buib cloon bah gao, Nănh nongc stâyv quâyx max hayh tayc nyăngz tâuf pu.”<verse eid="MAT 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Wax zanyf, Zâu Yê-su tăng Ga-li-lê ninyh wa Njoh-đen wăngx, Yô-hanx wa, oix tuz Yô-hanx ayx quaix-gâyf phunz. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Six Yô-hanx njinh luh cangđ Nănh, coong: “Yaz nzăngđ hoopđ zuc tuz Mâyh ayx quaix-gâyf phunz, Mâyh zef năngx taih êu yaz heh?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Six Zâu Yê-su tauz nănh coong: “Nâyx zanyf, phanv ayx nâyx gôh, pănh oix zuc ayx muif huungđ peengh stimz nyăngz jau năngx clăkx clunh nzuf.” Tăng wa Nănh phunz Yô-hanx ayx. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Wax zanyf, ayx quaix-gâyf, Zâu Yê-su tăng womz ah setb taih wax zanyf, phanv mangc, muif tab guungh jeengh coib goib phunz Nănh, Nănh mangc phătc Zâu Tênb-huungh nyăngz Singx-Lingh nzac taih cayx năngđ nooc bah côz nâyx, taih bopb Nănh, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />phanv mangc, naih stingb yămz wa guungh coong: “Nây six Yaz stăngz nyăngz Toonz. Yaz senz numđ nyađ nâyx tauh Sây.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Blătc wa, Singx-Lingh ênz Zâu Yê-su ninyh wa stâyz phangz blănf, zuc manđ huungh stâyv. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Nănh njif nhlinc stâyx săpc noib stâyx săpc munf, blătc, Nănh nyâuđ sab. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Manđ huungh taih stătx coong ănz Nănh, coong: “Năngđ coong mâyh six Zâu Tênb-Huungh nyăngz Toonz, bix setb lanyf êu nâyx đomc njăuz pênx nzu taih geh.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Six Zâu Yê-su tauz, coong: “Naih wac ja coong: ‘Tauh munh săngh six max zâyf cungb păngc nzu cuungv, six păngc tăng Zâu Tênb-Huungh nyăngz nzetx coong setb nyăngz muif zâux wac.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Manđ huungh zef ênz Nănh ninyh đăngb zeengh dlanyh, phunz Nănh stâuđ bongc Zâu Tênb-Huungh nyăngz pyau cah zâyc njăngb quaix nyăngz tinc, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />zef coong ănz Nănh: “Năngđ coong Mâyh six Zâu Tênb-Huungh nyăngz Toonz bix cănh đanyz nzac mangc geh, wâyc naih wac ja coong: ‘Nănh six setb lanyf êu Nănh wax đomc stinz munh jămđ mâyh,’ six: ‘Stiz nyăngz puf cănh tanyđ mâyh, săngx đanyf mâyh nyăngz staux hayh tib zuc njauz pyây.’”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Zâu Yê-su tauz nănh coong: “Six pitc đoif lauf naih ja coong: ‘Mâyh năngx gâyf stâyv Zâu, six mâyh nyăngz Zâu Tênb-Huungh.’” <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Ah hâyđ timb, manđ huungh ênz Zâu Yê-su staox ah nomz zoongz njăngb nzongf ninyh, phunz Nănh mangc guungh đi muif nomz côkz, cloon wax đomc côkz nyăngz gwăngz eeng. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Yâuc coong ănz Nănh: “Năngđ coong Mâyh quâyc nzac paix yaz, yaz songđ phunz nâyx đomc muif huungđ Mâyh.” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Wax zanyf, Zâu Yê-su coong ănz nănh; “Sax-tanx lex, tiuv lâyc gôh! Wâyc naih wac ja coong: ‘Mâyh oix zuc paix Zâu, mâyh nyăngz Zâu Tênb-Huungh, cungb oix zuc bokc dlic Nănh ah tauh cuungv.’” <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Tăng wa manđ huungh songđ gâyh Nănh, phanv mangc, wax đomc stinz munh songđ taih bokc dlic Nănh.<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Wax zanyf, Zâu Yê-su numđ coong Yô-hanx zuc zoz ănz nzauh, Nănh songđ muf Ga-li-lê stâyz phangz. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Nănh max yămz Na-sa-leetx, Nănh muf yămz Ca-bê-na-um dlanyh stătx wa coiđ stinh, yămz Sê-bu-lun stâyz phangz cloon Nap-ta-li stâyz phangz nyăngz căpx caix, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />wâyc phunz toix nzuf tâuc wac munh I-sa-ya coong nyăngz wac, nănh coong:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Sê-bu-lun nib cloon Nap-ta-li nib, ninyh coiđ wax stinz jau,</para>
  <para style="q1" vid="MAT 4:15">wax nganđ phanx Njoh-đen wăngx,</para>
  <para style="q1" vid="MAT 4:15">Ga-li-lê stâyz phangz pitc nomz côkz nyăngz pec stingx —<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />yămz nzămc cah njaf nyăngz pec stingx,</para>
  <para style="q1" vid="MAT 4:16">tuz mangc phătc gwăngz lub,</para>
  <para style="q1" vid="MAT 4:16">cloon yămz tayc nyăngz bah cloiz glomx wax đomc tinc nyăngz munh,</para>
  <para style="q1" vid="MAT 4:16">yâuc tuz naih gwăngz siux nzac nănh stiz.”<verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Tăng wa zanyx, Zâu Yê-su quef coonz nzônh gâyf, Nănh coong: “Oix zuc nhlimc stoif, wâyc Tênb-toongh côkz taih tauv stătx gôh.” <verse eid="MAT 4:17" /><verse number="18" style="v" sid="MAT 4:18" />Wax zanyf, Nănh jinh đangh yăngh jau quaix Ga-li-lê coiđ sinh ninyh, Nănh phătc iz lanh yâuf pez, Si-môn hipđ ayx Pi-tê wax tauh cloon nănh nyăngz yâuf An-đa-lu, jinh đangh poc wa pungx leđ nzac coiđ, wâyc stiz six ayx byauf nyăngz munh. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Zâu Yê-su êu nănh stiz: “Taih lêpc yaz gôh, yaz oix nzaox nyâuh pênx ayx leđ zoz munh.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Stiz songđ, lênh dlih quanyf stiz nyăngz leđ, bix ninyh lêpc Zâu Yê-su. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Tăng wa staox ninyh tix cay timb, Nănh zef phătc iz lanh yâuf pez, Ya-coopc cloon nănh nyăngz yâuf Yô-hanx Sê-bê-đi nyăngz toonz, jinh đangh cloon stiz nyăngz pha Sê-bê-đi, yămz wa đangđ va stiz nyăngz leđ Zâu Yê-su songđ êu stiz, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />stiz songđ lênh dlih quanyf stiz nyăngz pha cloon đangđ, bix ninyh lêpc Zâu Yê-su.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Zâu Yê-su ninyh nzêux Ga-li-lê stâyz phangz, yămz wax đomc songx munh nyăngz huyđ toongh nzaox munh, yâuc nzônh Tênb-toongh Côkz nyăngz Cuđ Jenx, yâuc zany gongx muif huungđ gumc cloon jif cah munz nyăngz gumc yămz songx munh cah njaf. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Nănh nyăngz manyh tauh, songđ lănv ninyh pong nzuf Si-đi stâyz phangz, munh songđ tinyh đoih ênz wax đomc săngh gumc nyăngz munh taih phunz Nănh, naih săngh đuungx huungđ gumc munz max tinyh năngđ, ah phanx zuc manđ yămz stinb, ah phanx vutx, ah phanx yâuc quac, Zâu Yê-su zany phunz stiz gongx nzuf. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Wax đomc songx munh hongđ nzongf ninyh lêpc Zâu Yê-su six tăng Ga-li-lê stâyz phangz, cloon Tôt-bu-li stâyz phangz, cloon Yê-lu-sa-lem dlanyh, cloon Yu-đê stâyz phangz, cloon Njoh-đen wăngx toix nganc wax đomc.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Wax zanyf, phătc naih songx munh hongđ, Zâu Yê-su songđ staox wax zâyđ zoongz ninyh, Nănh stâyv nzac, Nănh wax đomc stayb sây buz lauf taih cloon Nănh yămz wa. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Nănh songđ goib nzetx nzaox nănh stiz coong:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Munh stimz nyâuđ numđ sămv Zâu wax đomc, naih oonz looc gôh,</para>
  <para style="q2" vid="MAT 5:3">wâyc Tênb-toongh côkz six săngh stiz nyăngz.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Munh munz stimz haoh wax đomc naih oonz looc gôh,</para>
  <para style="q2" vid="MAT 5:4">wâyc stiz six tuz oonz nyâuđ.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Wax đomc munh nyâuđ dlênc, naih oonz looc gôh,</para>
  <para style="q2" vid="MAT 5:5">wâyc stiz six tuz stipx nib.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Ngooc oix lov peengh stimz nyăngz jau wax đomc munh, naih oonz looc gôh,</para>
  <para style="q2" vid="MAT 5:6">wâyc nănh stiz oix tuz pong stimz pong âyx.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Hayh hâuđ lênh munh wax đomc, naih oonz looc gôh,</para>
  <para style="q2" vid="MAT 5:7">wâyc stiz lauf tuz hâuđ lênh.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Naih đăngb zeengh stimz wax đomc munh, naih oonz looc gôh,</para>
  <para style="q2" vid="MAT 5:8">wâyc stiz oix tuz phătc Zâu Tênb-Huungh.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Quinb iz phangz hoopđ taih wax đomc munh, naih oonz looc gôh,</para>
  <para style="q2" vid="MAT 5:9">wâyc stiz oix tuz hipđ ayx Zâu Tênb-Huungh nyăngz toonz sab.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Wâyc ayx peengh stimz bix zuc ayx huđ wax đomc munh, naih oonz looc gôh,</para>
  <para style="q2" vid="MAT 5:10">wâyc Tênb-toongh côkz six stiz nyăngz.<verse eid="MAT 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 5:11" />Nyâuh wâyc yaz bix zuc munh phătc stanc, zuc ayx huđ ayx đokc, cloon zuc munh coong muif huungđ huđ toopz ănz nyâuh, nyâuh songđ naih oonz looc gôh.<verse eid="MAT 5:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 5:12" />Oix zuc gwanb looc yâuc numđ nyađ, wâyc nyâuh naih stâuđ nyâyc lub nzongf yămz wa Tênb-toongh, wâyc cah đangc wax đomc tâuc wac munh, lauf zuc munh ayx huđ cayx năngđ nyâuh nâyx.<verse eid="MAT 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Nyâuh six ayx nib nyăngz đau, năngđ coong đau zuc stam ninyh bix zoz luungđ ayx phunz nănh đaih taih heh? Cungb hayh ninyh lokx quanyf queengx phunz munh zaiđ cuungv, wâyc max hayh nongc ayx luungđ nzof. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Nyâuh six ayx gwăngz yămz nây bamh canz. Ah nomz steengv yămz wa zoongz đany six max hayh pinyx tuz vâyv. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Yâuc max naih mănv pu toongz sac bix tăpx ănz wa tongđ njaf, six cungb tăpx wa toongz jax nongc siux gwăngz pyau njaf munh. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Lauf tinyh năngđ, nyâuh oix zuc ayx gwăngz siux phunz munh tinyh đoih, ayx laix tuz phunz munh phătc nyâuh ayx gongx nyăngz jau, bix tanv nyâuh nyăngz Tênb-toongh Pha.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Nyâuh năngx gâyf nyâyh coong, yaz taih quanyf gâyf njanh cloon tâuc wac munh nyăngz wac. Yaz taih six max zâyf quanyf, six wâyc ayx phunz clăkx clunh nzuf. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Yaz coong senz bux nyâuh, nâyx nomz guungh nib max zeengx quaix ninyh, six gâyf njanh nyăngz ah nokx ah wec đăngc lauf max quaix ninyh, zu tauv muif huungđ clăkx clunh nzuf. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Wâyc nây, năngđ coong laiv lanh quanyf wax đomc ah tiuh jenz quaix nyăngz gâyf, bix zef nzaox munh ayx max âyz yămz wa Tênb-toongh côkz nănh six ayx năngx jenz têx. Six laiv lanh ayx âyz bix zef nzaox êu munh ayx âyz, yămz Tênb-toongh côkz nănh six tuz ayx năngx lub têx. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Yaz coong bux nyâuh năngđ coong nyâuh ayx gongx nyăngz jau, bix max blătc wax đomc nzaox gâyf stênx steengb cloon Pha-li-si munh, nyâuh six max hayh tuz nzac Tênb-toongh côkz.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Nyâuh tuz numđ ayx nâyx, lôx noib munh nzaox coong: ‘Max tuz tayx munh,’ năngđ coong ‘Laiv lanh tayx munh six zuc tingc stoif.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Six yaz bux nyâuh tinyh phanv laiv lanh nhlenx nănh nyăngz yâuf pez six zuc tingc stoif. Laiv lanh mađ nănh nyăngz yâuf pez coong: ‘Munh oongx!’ Six zuc ênz ninyh stămđ stoif. Laiv lanh mađ munh coong: ‘Tauh munh vutx!’ six zuc quanyf ănz wa tâuf coiđ. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Wâyc nây, năngđ coong nyâuh jinh đangh nzâyz nyâuh nyăngz tax huungđ ninyh congx phunz Zâu Tênb-Huungh, yămz wa bix săngx tauv mâyh nyăngz yâuf pez naih ayx laiv huungđ max hoođ mâyh, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />oix zuc tăpx mâyh nyăngz tax huungđ ănz wa coongx tinc cah đangc, bix phunb đangz muf cloon mâyh nyăngz nyăngz yâuf pez ayx gongx đangc, nzof mănc zoz mâyh nyăngz tax huungđ taih congx. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Munh ênz nyâuh ninyh wa dlayc tinc cooux nyâuh, ninyh tauv bah đamx jau oix zuc coonx căn wax tauh munh ayx gongx, năngđ max têx nănh six jaoz mâyh phunz stămđ stoif quanz, stămđ stoif quanz jaoz phunz huungh peengz, mâyh songđ zuc yămz nzauh gôh. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Yaz coong senz bux nyâuh, nyâuh six max tuz setb wa nzauh, zu tauv laiv zanyf nyâuh clao soongb nzuf byăng wax nomz tongh stinh zaix.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Nyâuh tuz numđ, munh nzaox nâyx đomc wac coong: ‘Max tuz ninyh văngf munh.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Six yaz coong bux nyâuh, tinyh phanv laiv lanh mangc munh nzif bix yămz nyâuđ numđ oix wax tauh munh nzif, wax tauh bâyf yămz nyâuđ cloon nănh longđ stoif nzof gôh. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Năngđ coong nyâuh nyăngz byaoh nomz mâyc ayx phunz nyâuh longđ stoif, oix zuc ngwâyz nănh quanyf năngx gâyh nyâuh, nyâuh nyăngz ah phănc stinb sangc huđ ninyh six năngx gongx têx, wâyc phunz nyâuh max zuc njinh stinb quanyf ănz wa tâuf coiđ. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Năngđ coong nyâuh nyăngz byaoh saz puf ayx phunz nyâuh longđ stoif, oix zuc zăm quanyf năngx gâyh nyâuh, nyâuh nyăngz ah phănc stinb sangc huđ ninyh six năngx gongx têx, wâyc phunz nyâuh max zuc njinh stinb ninyh nzac tâuf coiđ. <verse eid="MAT 5:30" /><verse number="31" style="v" sid="MAT 5:31" />Nyâuh numđ munh nzaox coong: ‘Laiv lanh munh queengx nănh nyăngz au, nănh six zuc ayx ah zây stâub queengx phunz au.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Six yaz coong bux nyâuh tinyh phanv laiv lanh queengx nănh nyăngz au, bix max zâyf wâyc nănh nyăngz au ninyh văngf munh, nănh six ayx phunz wax tauh au pênx pongz lauh nyăngz munh, laiv lanh zoz zuc queengx wax tauh au nongc, six ayx pongz lauh nyăngz stoif.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Nyâuh numđ lôx noib munh nzaox nâyx đomc wac coong: ‘Năngx gâyf puv maoh nyunc wac, mâyh yămz Zâu cah đangc nyunc nyăngz wac oix zuc ayx âyz.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Six yaz coong bux nyâuh năngx gâyf nyunc laiv huungđ wac tiny, năngx gâyf nuz guungh nyunc wac, wâyc guungh six Zâu Tênb-Huungh nyăngz tinc; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />yâuc năngx gâyf nuz nib nyunc wac, wâyc nib six Nănh zaiđ nyăngz tinc; yâuc năngx gâyf nuz Yê-lu-sa-lem dlanyh nyunc wac, wâyc wa six huungh stix lub nyăngz dlanyh. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Năngx gâyf nuz nyâuh nyăngz pyây nyunc wac, wâyc nyâuh max hayh cănh ayx phunz, nyâuh nyăngz ah stinz pyây đongz jaz max six pec. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Nyâuh six oix zuc coong ayx nâyx ‘Naih, six coong naih,’ ‘Max naih, six coong max naih.’ Năngx staix coong đuungx nây, six tăng manđ huungh taih.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Nyâuh tuz numđ munh, nzaox coong ayx nâyx: ‘Mâyc clao mâyc, nyah clao nyah.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Six, yaz coong bux nyâuh, năngx gâyf, tămx munh huđ munh. Năngđ coong, laiv lanh beb nyâuh byaoh phanx minb, bix winb cloon staix wax phanx minb phunz nănh. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Năngđ naih munh ninyh dlayc tinc oix cooux nyâuh nongc nyâuh cah njaf wax byenđ guyz, bix phunz nănh zoz cloon cungh ngwaic wax byenđ guyz. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Năngđ coong naih munh phađ nyâuh ninyh ah gâyf jau, nyâuh bix cloon nănh ninyh iz gâyf. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Munh joođ nyâuh nyăngz luungđ, oix zuc phunz, munh taih ca nyâuh nyăngz luungđ six năngx gâyf winb minb ănz.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Nyâuh tuz numđ munh nzaox coong, ayx nâyx: ‘Oix zuc stăngz pănh nyăngz yâuf pez, bix hănđ pănh nyăngz yônz zaz.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Six yaz coong bux nyâuh, oix zuc stăngz nyâuh nyăngz yônz zaz, yâuc cloo Zâu phunz ayx đokc ănz nyâuh wax đomc, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />phunz nyâuh tuz săngh Zâu Tênb-Huungh nyăngz toonz sab yămz wa Tênb-toongh. Wâyc Nănh ayx phunz Nănh nyăngz bah noib setb taih siux munh gongx cloon munh huđ, Nănh lauf ayx bungc phunz munh peengh cloon munh max peengh. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Năngđ coong nyâuh cungb stăngz, wax đomc munh stăngz nyâuh, nyâuh hayh tuz luungđ stâuđ nyâyc heh? Hănđ wax đomc sâub sôiv munh six lauf ayx năngđ nâyx lec max zâyf haz? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Năngđ coong nyâuh cungb stipx nyâuh nyăngz yâuf pez cuungv, nyâuh ayx tuz luungđ blătc munh heh? Wax đomc max zen nyăngz munh, six lauf ayx nâyx lec max zâyf haz? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Năngđ nây, nyâuh oix zuc ayx năngx clăkx clunh nzuf, cayx năngđ nyâuh nyăngz Tênb-toongh Pha nâyx six clăkx clunh.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Oix zuc bôngh, nyâuh ayx gongx nyăngz jau năngx gâyf yămz munh cah đangc ayx wâyc oix phunz munh phătc, năngđ cungb ayx nâyx têx, nyâuh yămz Tênb-toongh Pha nyăngz cah đangc nyâuh six max tuz laiv huungđ stâuđ nyâyc gôh. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Wâyc nây, nyâuh setb stimz phunz laiv huungđ stăngc munh wax zanyf, năngx gâyf hơx hơx hax hax têx phunz munh phătc, cayx năngđ wax đomc pâyc zac nyâuđ yootz nyăngz munh, yămz wax đomc huyđ toongh yâuc yămz caiz sangc ayx, wâyc oix tuz munh tanv, yaz coong senz bux nyâuh stiz nyăngz stâuđ nyâyc stiz tuz nzuf nzof gôh. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Six nyâuh setb stimz phunz laiv huungđ stăngc munh wax zanyf, năngx gâyf phunz nyâuh nyăngz staix puf pâyz nyâuh nyăngz byaoh puf ayx luungđ, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Năngđ nây nyâuh setb stimz stăngc munh oix zuc pinyx ayx, nyâuh nyăngz Tênb-toongh Pha phătc nyâuh pinyx ayx nyăngz jau, songđ phunz stâuđ nyâyc nyâuh gôh.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Nyâuh cloo zâu nyăngz săngx huđ, năngx gâyf ayx năngđ pâyc zac nyâuđ yootz nyăngz munh, stiz cungb oix stâuđ yămz wax đomc huyđ toongh yâuc yămz wax đomc jau zav cloo zâu, wâyc oix tuz munh phătc, yaz coong senz bux nyâuh, stiz nyăngz stâuđ nyâyc stiz tuz nzuf nzof gôh. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Six nyâuh laiv zanyf cloo zâu, oix zuc nzac nyâuh nyăngz bôngh cah njaf ninyh, omz bôngh nyăngz jeengh, yămz wa vâyv nyăngz tinc cloon nyâuh nyăngz Tênb-toongh Pha coong wac, nyâuh nyăngz Tênb-toongh Pha, phătc nyâuh yămz vâyv nyăngz tinc, songđ sađ stâuđ nyâyc phunz nyâuh. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Cloo zâu wax zany, năngx gâyf đămh quaix ninyh quaix lauf, cayx năngđ max zen wax đomc munh nâyx, wâyc stiz nyâyh coong stiz coong wac đuungx, six tuz Zâu mungv. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Wâyc nây nyâuh năngx gâyf ayx năngđ stiz, wâyc tăng nyâuh max zeengx joođ Nănh, nyâuh nyăngz Tênb-toongh Pha pâyz coong nyâuh sămv luungđ nzof gôh. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Nyâuh oix zuc cloo ayx nâyx:</para>
  <para style="q1" vid="MAT 6:9">‘Buz nyăngz Tênb-toongh pha lex,</para>
  <para style="q2" vid="MAT 6:9">joođ phunz munh zanyb mâyh nyăngz đăngb zeengh bux.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Joođ phunz Mâyh nyăngz côkz taih tauv,</para>
  <para style="q2" vid="MAT 6:10">joođ phunz Mâyh nyăngz zux ix tuz setb taih</para>
  <para style="q2" vid="MAT 6:10">yămz nây bamh canz cayx năngđ yămz wa Tênb-toongh nâyx.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Joođ sađ phunz buz naih caux nâyx noib nyăngz nhlinc hopb;<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />joođ quanyf buz ayx longđ nyăngz stoif,</para>
  <para style="q2" vid="MAT 6:12">cayx năngđ buz lauf quanyf ayx longđ buz wax đomc munh nyăngz stoif nâyx;<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />joođ năngx gâyf phunz buz pongh stâyv nyâuđ nyăngz jau,</para>
  <para style="q2" vid="MAT 6:13">six njâuv buz gâyh đutb njangh okx nyăngz munh.’<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Năngđ coong nyâuh quanyf phunz ayx peo ănz nyâuh wax đomc munh, nyâuh nyăngz Tênb-toongh Pha lauf quanyf phunz nyâuh. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Six năngđ coong nyâuh max quanyf phunz munh, nyâuh nyăngz Tênb-toongh Pha lauf max quanyf nyâuh ayx longđ wax đomc.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Nyâuh laiv zanyf njif nhlinc, năngx gâyf ayx minb âuz âuz năngđ wax đomc pâyc zac nyâuđ yootz nyăngz munh, stiz nyootz minb âuz âuz wâyc oix nongc munh pâyz coong stiz njif nhlinc. Yaz coong senz bux nyâuh, stiz nyăngz stâuđ nyâyc stiz tuz caux nzuf nzof gôh. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Six nyâuh laiv zanyf njif nhlinc, oix zuc zoz yâuh hâuh ănz nyâuh nyăngz pyây, yâuc đaox nyâuh nyăngz minb, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ayx laix tuz phunz munh max saz coong nyâuh njif nhlinc, six nyâuh pinyx ayx phunz nyâuh nyăngz Tênb-toongh Pha; nyâuh nyăngz Tênb-toongh Pha phătc nyâuh pinyx ayx nyăngz, songđ sađ stâuđ nyâyc phunz nyâuh.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Nyâuh năngx gâyf sâub jax toongx ănz nây bamh canz, nây six hayh zuc jeengz, yâuc hayh setb setb đingv quaiz nzuf, stac munh yâuc hayh taih nimc. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Nyâuh oix zuc sâub jax toongx ănz wa cah zâyc guungh, yămz wa max hayh zuc jeengz, yâuc max hayh setb đingv quaiz, stac munh yâuc max hayh taih nimc. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Wâyc nyâuh nyăngz jax toongx yămz laiv, nyâuh nyăngz nyâuđ six lauf yămz wa gôh. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Mâyc six stinb nyăngz toongz. Wâyc nây, năngđ coong nyâuh nyăngz mâyc gongx, six njinh nyâuh nyăngz stinb sangc lauf tuz gwăngz nzuf. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Six năngđ coong nyâuh nyăngz mâyc huđ, six njinh nyâuh nyăngz stinb sangc naih nzămc pong nzuf, wâyc nây năngđ coong nyâuh nyăngz gwăngz nzămc ninyh, six wax cuyb nzămc senz lub nzongf gôh! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Max naih mănv hayh ayx iz tauh zâu nyăngz pâuz, wâyc nănh six hayh hănđ nâyx tauh bix stăngz wax tauh, yâuc hayh nongc nâyx tauh saix, bix phătc wax tauh stanc. Nyâuh max hayh ayx Zâu Tênb-Huungh nyăngz pâuz, yâuc ayx nyanh nyăngz pâuz. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />Wâyc nây, yaz coong ănz nyâuh, năngx gâyf stauh phunz nyâuh nyăngz yangh stâyv, nyâuh nhlinc max six nyâuh hopb wax đomc, yâuc năngx gâyf wâyc nyâuh nyăngz stinb bix stauh guyz quav zuz, săngh meengc max zâyf năngx saix têx nhlinc hopb haz, stinb a max zâyf năngx saix têx guyz quav zuz haz? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Oix zuc mangc đayv lâyc đamx yâuh nyăngz nooc; stiz max songx, yâuc max sâub zaub ănz njămf, six nyâuh nyăngz Tênb-toongh Pha yuungf stiz. Nyâuh max zâyf năngx saix têx wax đomc nooc haz? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Six, nyâuh phătc naih tix lanh munh nyâyh stauh bix hayh pâu tuz nănh nyăngz nyăngv tauh năngx đao tix cay max? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Nyâuh săngh laix bix năngx stauh tauv guyz quav heh? Phanv mangc lâyc jêmh sangc nyăngz tungh goonf phăngh, stiz săngh ayx năngđ laix. Stiz max ayx zâuđ yâuc max peengz njaub. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Six yaz coong bux nyâuh njinh Sa-lô-môn huungh, nănh hănđ puv quâyx năngđ laix nănh zoongz zuz nyăngz jau, yâuc max năngđ wax đomc ah nyau phăngh. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Năngđ coong Zâu Tênb-Huungh zoongz lâyc jêmh sangc nyăngz mađ quai, mađ six nâyx noib săngh sangx đoomz caođ quanyf ănz tâuf, Zâu Tênb-Huungh max zâyf oix ayx năngx đuungx têx phunz nyâuh haz? Nyâuh zen stimz tuz haiđ nâyx heh! <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Wâyc nây nyâuh năngx gâyf numđ stauh bix coong: ‘Pănh cayx nhlinc luungđ, hopb luungđ heh?’ Max six coong ‘pănh cayx zuz luungđ heh?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Wâyc max zen nyăngz munh six cungb lov nâyx đomc tax huungđ; six nyâuh nyăngz Tênb-toongh Pha pâyz coong nyâuh sămv nâyx đomc tax huungđ. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Tah yetx six oix zuc lov Tênb-toongh côkz nyăngz phănc, cloon Zâu Tênb-Huungh peengh stimz nyăngz gâyf đangc, wax đomc muif huungđ cănh tuz pâu phunz nyâuh. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Wâyc nây, nyâuh max nongc stauh tauv sangx đoomz, wâyc sangx đoomz cănh stauh sangx đoomz nyăngz dlayc. Ah noib cănh naih ah noib nyăngz dlayc caux stauh.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Nyâuh năngx gâyf tingc munh nyăngz stoif, nyâuh nzăngđ max zuc tingc stoif. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Wâyc yămz nyâuh tingc munh nyăngz stoif ayx laix, nyâuh lauf zuc tingc năngđ wa nâyx, wâyc nyâuh gaob buc laiv phunz munh, six lauf tuz gaob buc wa lauf phunz nyâuh. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Săngh laix mâyh phătc mâyh nyăngz yâuf pez nyăngz mâyc cah njaf naih njămc stăm, bix max phătc mâyh nyăngz mâyc cah njaf naih ah cănv njăngx heh? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Mâyh laiv ayx laix hayh bux mâyh nyăngz yâuf pez coong: ‘Phunz yaz stăngc mâyh zoz mâyc njămc bex,’ bix mâyh nyăngz mâyc cah njaf jinh đangh naih ah cănv njăngx heh? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Pâyc zac nyâuđ yootz nyăngz munh lex, oix zuc zoz mâyh nyăngz mâyc wax cănv njăngx đangc, nzăngđ hayh phătc jau zoz mâyh yâuf pez nyăngz mâyc nzămc ayx queengx. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Nyâuh năngx gâyf phunz đăngb zeengh nyăngz tax huungđ phunz clô, yâuc năngx gâyf quanyf poou zâuz ănz tungf. Tungf cungb hayh zaiđ njenđ ănz wa staux đi cuungv, yâuc winb đangz lauf zeb tăpc nyâuh.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Oix zuc joođ, nyâuh nzăngđ tuz sađ phunz, oix zuc lov, nyâuh nzăngđ tuz phătc. Oix zuc nzoz jeengh, jeengh nzăngđ goib phunz nyâuh. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Wâyc tinyh phanv laiv lanh joođ six tuz; laiv lanh lov six phătc; laiv lanh nzoz jeengh, jeengh six goib. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Nyâuh naih tix lanh munh, nănh nyăngz sây naic nzu — nănh bix ninyh zoz njăuz phunz sây max six? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Max six tauh sây naic byauf, nănh bix ninyh phunz nangz sây heh? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Wâyc nây, năngđ coong nyâuh six, munh huđ, lôx năngx pâyz tuz phunz muif huungđ gongx nyâuh nyăngz sây, nyâuh nyăngz Pha yămz wa cah zâyc Tênb-toongh six lauf oix sađ phunz muif huungđ gongx nyăngz, phunz joođ Nănh wax đomc munh? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Năngđ nây, yămz muif huungđ dlayc, năngđ coong nyâuh oix nongc munh ayx laiv huungđ phunz nyâuh, nyâuh oix zuc ayx wax huungđ phunz munh, wâyc nây six gâyf njanh cloon tâuc wac munh nyăngz wac.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Oix zuc ninyh nzac jeengh găpc. Wâyc jeengh quăng jau lub six ninyh tauv zuc mêtc, yâuc naih munh đuungx yăngh nzac quaix wax tungđ jeengh. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Six jeengh găpc cloon jau jenz six ninyh tuz meengc săngh, naih munh stoc lov phătc wax stinz jau.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Oix zuc bôngh tauv za tâuc wac munh, six pâyb bah jiz yuungh đupx taih lov nyâuh wax đomc, six stiz nyăngz nyâuđ njaf six cayx năngđ njab clô cungb oix zeb tăpc. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Nyâuh mangc stiz nyăngz pyâu songđ pâyz tuz stiz gôh, max naih mănv ninyh wa nzim plungz zoz tungh cuđ pyâu, max six ninyh wa njăngx nzim zoz bănx tauh pyâu? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Lauf tinyh năngđ, wax đomc njăngx gongx six săngh pyâu gongx, njăngx huđ six săngh pyâu huđ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Njăngx gongx max hayh săngh pyâu huđ, njăngx huđ max hayh săngh pyâu gongx. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Laiv zâyz njăngx max săngh pyâu gongx six zuc coix quanyf ănz tâuf. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Wâyc nây, nyâuh mangc tăng stiz nyăngz pyâu nyâuh six hayh saz tuz stiz gôh. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />Max zâyf muif lanh êu yaz coong: ‘Zâu lex, Zâu lex’, bix tuz nzac Tênb-toongh côkz, six cungb ayx âyz yaz nyăngz Pha nyăngz zux ix yămz wa cah zâyc Tênb-toongh wax đomc munh cuungv. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Tauv wax noib naih munh đuungx six coong ănz yaz: ‘Zâu lex, Zâu lex, buz max zâyf nongc Mâyh nyăngz bux tâuc wac, nongc Mâyh nyăngz bux luiđ manđ yâuc nongc Mâyh nyăngz bux ayx đuungx huungđ jix caox njingc haz?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Wax zanyf yaz six coong ănz stiz: ‘Yaz max pâyz nyâuh! Ayx huđ nyăngz munh lex, tiuv gâyh yaz gôh!’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Wâyc nây, muif lanh munh, tinyh phanv laiv lanh mungv yaz nâyx đomc wac bix âyz ayx, six pây năngđ ah lanh tongb manyh nyăngz munh, ayx nănh nyăngz pyau ănz njăuz pyây peengh cah zâyc. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Bungc lub nzac, womz lub cuutb, nzaox lub sâyb nzac wax sênz pyau, yâuc max lakb wâyc ayx ănz njăuz pyây cah zâyc. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Six laiv lanh mungv yaz nâyx đomc wac bix max âyz ayx, six pây năngđ ah lanh munh oongx munh, ayx nănh nyăngz pyau ănz wa njăuz staiz minc. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Naih bungc lub nzac, womz lub cuutb, nzaox lub sâyb nzac pyau, wax sênz pyau songđ lakb quaiz đuungx nzongf.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Six, Zâu Yê-su nzaox nâyx đomc wac tuz, songx munh songđ numđ njingc Nănh nzaox nyăngz wac, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />wâyc Nănh nzaox nyăngz wac six cayx năngđ naih lokc jangx, yâuc max năngđ stiz wax đomc nzaox gâyf stênx steengb.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Wax zanyf, Zâu Yê-su tăng wa zoongz nzac lauf, naih songx munh đuungx hongđ nzongf ninyh lêpc Nănh. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Mangc, naih ah lanh munh săngh maoh pongz gumc staox taih, paix Zâu Yê-su nyăngz cah đangc, yâuc coong: “Zâu lex, năngđ coong Mâyh oix, Mâyh six naih jab hayh ayx tuz yaz dlăngc.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Tăng wa Zâu Yê-su stuungb puf laoz nănh coong; “Yaz oix lêc, dlăngc gôh.” Toongx sangf, wax tauh zuc maoh pongz munh tuz dlăngc. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Zâu Yê-su coong ănz nănh: “Zuc năngx cayb bôngh, mâyh gâyf coong ănz mănv, six oix zuc muf, coong cănh nyăngz stinb ănz stayb munh, bix nzâyz stanyb lanyh ninyh coongx âyz Mô-sê nzaox nyăngz, ayx ah cuyb zanyx manyf phunz stiz.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Wax zanyf, Zâu Yê-su nzac wa Ca-bê-na-um dlanyh cah njaf muf, naih ah lanh peengz pyây taih pongh Nănh, joođ Nănh <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />coong: “Zâu lex, yaz nyăngz pâuz săngh gumc quac phâyx wa pyau, tanyđ munz zâuđ nzongf.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Zâu Yê-su coong ănz nănh: “Yaz cănh ninyh, zanyf phunz nănh năngx gongx.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Peengz pyây tauz coong: “Zâu lex, yaz six max payh tuz stipx Mâyh muf nzac yaz nyăngz pyau, six joođ Mâyh tinyh phanv coong ah zâux wac, yaz nyăngz pâuz cănh tuz zany gongx. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Wâyc yaz lauf yămz munh nyăngz lanyf cah đi, yâuc naih wax đomc peengz yămz yaz cah đi. Yaz coong ănz nâyx lanh: ‘Ninyh gôh,’ nănh songđ ninyh, coong ănz pitc lanh coong: ‘Taih gôh,’ nănh yâuc taih, coong ănz yaz nyăngz pâuz coong: ‘Ayx nâyx huungđ gôh,’ nănh yâuc ayx.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Six numđ nănh coong ayx nâyx, Zâu Yê-su songđ numđ nyâyh ganc yâuc coong ănz lêpc Nănh wax đomc munh: “Yaz coong senz, bux nyâuh, Yaz max zeengx phătc tăng laiv lanh munh yămz I-sa-la-ên naih zen stimz lub tuz nâyx. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Six yaz coong ănz nyâuh, naih munh đuungx six tăng tongz pôngz cloon stâyz pôngz taih, tuz cloon Apx-la-ham, cloon I-sakx, cloon Ya-côpx, yămz wa Tênb-toongh côkz songc hinh nhlinc năngv. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Six Tênb-toongh côkz nyăngz munh wax đomc zuc quanyf ănz wa cungh ngwaic nzămc nyăngz tinc, yămz wa six naih pungx stingb haoh tăpc nyah tanyđ.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Tăng wa Zâu Yê-su coong ănz wax tauh peengz pyây: “Phanv muf gôh! Âyz mâyh zen nyăngz, six tuz năngđ nâyx phunz mâyh gôh.” Wax tauh pâuz songđ toongx wax nomz săngx huđ tuz zany gongx.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Zâu Yê-su ninyh nzac Pi-tê nyăngz pyau, phătc Pi-tê nyăngz nzif ti săngh bah song gumc phâyx wa zâuv. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Nănh lumz gumc munh nyăngz puf, bah song gumc songđ gongx, nănh songđ nyoongz quef ayx cumh pâuz bokc dlic Zâu Yê-su. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Wax zanyf, tauv cayx nzămc, munh ênz wax đomc zuc manđ yămz stinb nyăngz munh đuungx taih phunz Nănh, Nănh nongc ah zâux đokc wac luiđ wax đomc manđ setb nzuf, yâuc zany phunz wax đomc săngh gumc munh gongx nzuf, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />wâyc phunz setb taih toix nzuf tâuc wac munh I-sa-ya tâuc taih nyăngz wac, coong: “Nănh đamz nzuf pănh nyăngz staiz nanc yâuc tanyđ pănh nyăngz muif huungđ gumc.”<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Wax zanyf, phătc naih munh đuungx yămz quib Nănh nzêux nzuf, Nănh songđ êu clăngv staox wax nganđ muf. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Tăng wa naih ah lanh nzaox gâyf stênx steengb, taih stătx Nănh, coong: “Stênx steengb lex, Mâyh hănđ ninyh laiv yaz lauf lêpc Mâyh.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Zâu Yê-su coong ănz nănh coong: “Njab clô naih ngamh, nooc yâuc naih njauf, six Bamh Munh max naih tinc nongc coongv pyây phâyx.” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Tăng wa naih ah lanh stayb sây zef taih coong ănz Nănh: “Zâu lex, joođ phunz yaz phunb đangz muf plopx yaz nyăngz pha đangc.” <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Six Zâu Yê-su coong ănz nănh: “Phanv lêpc yaz gôh, phunz stiz munh tayc cănh plopx stiz nyăngz munh tayc.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Tauv Nănh nzac đangđ ninyh, Nănh wax đomc stayb sây lauf lêpc Nănh ninyh. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Phanv mangc, naih ah tâuc nzaox lub nzongf yămz wa coiđ, ayx tuz womz boomf phatb nzac đangđ. Six Nănh jinh đangh phâyx mâyc njoomh. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Stayb sây buz taih stătx êu Nănh điub, coong: “Zâu lex, joođ Mâyh stăngc njâuv buz nef; pănh cayx tayc gôh!” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Zâu Yê-su coong ănz stiz: “Săngh laix nyâuh bix cumh nzav heh, nyâuh zen stimz tuz haiđ nâyx heh?” Tăng wa Nănh nyoongz quef, mađ nzaox cloon coiđ, songđ stinyb njâuh staox taih. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Stayb sây buz songđ nyâyh ganc, yâuc coong: “Lâyc tauh munh six mănv, ayx tuz nzaox cloon coiđ lauf năngx mungv Nănh?”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Wax zanyf Zâu Yê-su clăngv ninyh tauv wax nganđ leepb wăngx sinh, Ca-đa-la stâyz phangz, naih iz lanh munh zuc manđ yămz stinb, tăng wa stâu đungc setb taih pongh Zâu Yê-su, stiz đokc nzongf ayx tuz max naih mănv nzađ yăngh pitb quaix wax stinz jau. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Phanv mangc, stiz hamv lub, coong: “Zâu Tênb-Huungh nyăngz Toonz lex, buz naih luungđ quenđ tauv Mâyh heh? Max zeengx tauv săngx huđ Mâyh cayx taih nây wâyb buz quaix đangc mah?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Wax zanyf, naih ah peob tungf hongđ nzongf jinh đangh yămz wa lov nhlinc, gâyh stiz max côz. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Tăng wa, wax đomc manđ songđ joođ Zâu Yê-su, coong: “Mâyh năngđ luiđ buz setb, joođ phunz buz ninyh nzac wax peob tungf.” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Zâu Yê-su êu wax đomc manđ, coong: “Setb taih gôh!” Wax đomc manđ songđ setb, bix ninyh nzac wax peob tungf; six phanv mangc, săngh peob tungf songđ tiuv vuh nzac ngoom ninyh tuih coiđ, sêmh womz đi tayc nzuf. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Wax zanyf, wax đomc jămđ tungf munh tiuv muf, wa dlanyh, stiz lănv nâyx đomc dlayc, cloon wa iz lanh munh zuc manđ yămz stinb nyăngz jau setb taih nyăngz dlayc. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Phanv mangc, lomc dlanyh nyăngz munh tinyh đoih ninyh lov Zâu Yê-su mangc. Tauv phătc Nănh, stiz jab joođ êu Nănh tiuv quaix pitc đoif ninyh năngx blătc stiz nyăngz căpx caix.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Wax zanyf Zâu Yê-su nzac đangđ ninyh, clăngv coiđ muf tauv Nănh nyăngz dlanyh. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Phanv mangc, munh ênz ah lanh munh quac phâyx wa sic taih phunz Nănh. Zâu Yê-su phătc stiz nyăngz zen stimz, Nănh coong ănz wax tauh munh quac: “Sây lex, pungx stimz bex. Mâyh nyăngz stoif tuz quanyf nzof gôh.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Six phanv mangc, naih ah đomc nzaox gâyf stênx steengb lanh coong ănz lanh coong: “Lâyc tauh munh coong pamf Zâu.” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Six wâyc pâyz tuz stiz nyăngz nyâuđ nyâyh, Zâu Yê-su songđ coong ănz stiz: “Nyâuh nyâyh huđ ănz lâyc nyâuđ nongc ayx luungđ heh? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Coong: ‘Mâyh nyăngz stoif tuz quanyf nzof gôh,’ max six coong: ‘Nyoongz quef bix yăngh muf’ laiv zâux six coong năngx hâyđ têx heh? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Six, phunz nyâuh pâyz tuz coong Bamh Munh, yămz nây bamh canz naih lokc jangx quanyf tuz stoif …” Wax zanyf Nănh coong ănz wax tauh munh quac: “Nyoongz quef, glonc mâyh nyăngz sic, bix muf pyau gôh.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Wax tauh munh songđ nyoongz quef, muf nănh nyăngz pyau. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Phătc nâyx đomc dlayc, songx munh numđ cumh nzav songđ tanv Zâu Tênb-Huungh, wâyc Nănh sađ phunz munh naih nâyx đomc lokc jangx. <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />Tăng wa staox ninyh, Zâu Yê-su phătc ah lanh munh hipđ ayx Ma-tai stâyv wa sâub sôiv zamf, Nănh êu Ma-tai coong: “Lêpc yaz gôh.” Nănh songđ nyoongz quef, ninyh lêpc Zâu Yê-su.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Zâu yê-su yămz Ma-tai nyăngz pyau nhlinc năngv wax zanyf, phanv mangc, naih đuungx lanh sâub sôiv munh cloon naih stoif nyăngz munh taih, cloon Zâu Yê-su căn Nănh wax đomc stayb sây, songc stâyv hinh nhlinc năngv. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Phătc ayx nâyx, wax đomc Pha-li-si munh coong ănz Zâu Yê-su wax đomc stayb sây coong: “Săngh laix bix nyâuh nyăngz stayb pha, căn wax đomc sâub sôiv munh cloon naih stoif nyăngz munh songc nhlinc heh?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Six numđ stiz naic ayx nâyx, Zâu Yê-su coong: “Munh zoongx munh max sămv zuc lov mađ stangc munh, six cungb săngh gumc munh cuungv. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Six tauv nyâuh muf, oix zuc hođ nâyx zâux wac năngx pâyz jađ coong ayx laix: ‘Yaz oix munh naih nyâuđ hâuđ lênh munh, max zâyf oix munh nzâyz stanyb lanyh taih coongx.’ Wâyc yaz taih max zâyf taih êu munh gongx munh, yaz six taih êu naih stoif nyăngz munh.”<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Wax zanyf, Yô-hanx wax đomc stayb sây taih stătx Zâu Yê-su, naic coong: “Wâyc săngh laix buz cloon Pha-li-si munh zuc njif nhlinc, Mâyh nyăngz stayb sây buz yâuc max njif nhlinc heh?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Zâu Yê-su coong ănz stiz: “Ha săngb langh năngx jinh cloon zef munh yămz ayx coonx hinh nyăngz săngx huđ, stiz laiv hayh stauh heh? Six tauv beengc noib săngb langh zuc ênz ninyh gâyh stiz blătc, tauv wax zanyf stiz nzăngđ njif nhlinc. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Yâuc, max naih mănv nongc ah cuyb săngb buyx max zeengx byanb taih va ănz lôx guyz, wâyc wax nomz tungh va six nyootz byaif gâyh wax byenđ guyz, wax cuyb tinc zef byaif pâu năngx huđ têx. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Yâuc max naih mănv taox săngb tiu ănz lôx đupx tic, six năngđ coong ayx năngđ nâyx, six đupx tic hayh byaif, tiu yâuc setb nzuf, đupx tic yâuc quaiz. Năngđ naz, săngb tiu munh six taox ănz săngb đupx tic, iz huungđ yâuc tuz gongx.”<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Zâu Yê-su jinh đangh coong nâyx đomc wac ănz nănh stiz, phanv mangc, naih ah lanh huyđ toongh nyăngz ayx côx munh taih, quâyc nzac Zâu Yê-su nyăngz cah đangc ninyh, coong: “Yaz nyăngz sab ah yac tayc, six joođ Mâyh ninyh, tăpx puf ănz nănh, nănh nzăngđ tuz săngh.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Zâu Yê-su songđ nyoongz quef, căn Nănh wax đomc stayb sây lêpc wax tauh munh muf. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Phanv mangc, naih ah lanh munh nzif săngh đuv guyz max gaib nyăngz gumc tuz săpc nyâyc nyăngv, nănh quaix Zâu Yê-su cah đangz taih, lumz Zâu Yê-su nyăngz guyz saz, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />wâyc nănh cănh nyâyh coong: “Yaz năngđ phanv ninyh lumz tauv Nănh nyăngz guyz, yaz six bâyf tuz gumc gongx.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Six Zâu Yê-su winb đangz lauf phătc wax tauh munh nzif, Nănh songđ coong: “Sây lex, pungx stimz bex; mâyh nyăngz zen stimz, cănh zany phunz mâyh tuz gongx.” Toongx wax nomz săngx huđ wax tauh munh nzif tuz gumc gongx. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Tăng wa Zâu Yê-su ninyh tauv, wax tauh ayx côx cun huyđ toongh munh nyăngz pyau, yâuc phătc wax đomc pyom blungh blex munh cloon munh đuungx nginyz nginyz têx, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Nănh coong: “Tiuv lâyc gôh, wâyc nâyx tauh sab six max tayc nef, nănh six mâyc njoomh lec.” Munh songđ jetx Nănh. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Tăng wa, wax đomc songx munh zuc luiđ tiuv blătc nzuf wax zanyf, Nănh songđ nzac muf, nzauf wax tauh sab nyăngz puf, wax tauh sab songđ cănh nyoongz quef. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Nâyx đomc dlayc lănv nzêux pong nzuf wax nomz stâyz phangz.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Zâu Yê-su tăng wa setb ninyh, naih iz lanh mâyc buđ munh taih lêpc Nănh đangz hamv lub coong: “Đa-witx huungh nyăngz sây stunz lex, joođ hâuđ lênh buz nef!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Wax zanyf, nzac pyau muf blătc, wa iz lanh mâyc buđ munh taih tauv stătx Zâu Yê-su, Nănh naic stiz coong: “Nyâuh lauf zen coong yaz hayh ayx tuz nyâuh nyăngz mâyc gongx yah?” Stiz tauz coong: “Tuz lêc, Zâu lex.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Tăng wa, Nănh lumz stiz nyăngz mâyc, coong: “Âyz nyâuh nyăngz zen stimz, six tuz gongx phunz nyâuh gôh.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Stiz nyăngz mâyc mangc tuz phătc, Zâu Yê-su bux stiz, coong: “Nyâuh năngx cayb bôngh, nyâuh năngx gâyf phunz mănv pâyz.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Six tauv setb ninyh, stiz lănv nâyx đomc dlayc pong nzuf wax nomz stâyz phangz.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Wax zanyf, stiz setb taih, phanv mangc, naih munh ênz ah lanh munh zuc manđ yămz stinb yâuc mayv coong wac taih phunz Nănh. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Nănh luiđ manđ setb wax zanyf, wax tauh munh songđ hayh coong wac, songx munh songđ numđ nyâyh ganc, yâuc coong: “Yămz nây I-sa-la-ên, senz max zeengx tuz phătc quaix nâyx đomc dlayc gôh!” <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Six wax đomc Pha-li-si munh coong: “Lâyc tauh munh luiđ manđ six nongc manđ huungh nyăngz lanyf.”<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Zâu Yê-su ninyh nzêux nzuf muif nomz dlanyh cloon muif tiuh njăngv, yămz songx munh nyăngz wax đomc huyđ toongh nzaox gâyf, yâuc nzônh Tênb-toongh côkz nyăngz Cuđ Jenx, yâuc zany gongx muif huungđ gumc, cloon jif cah munz wax đomc. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Wax zanyf, phătc naih songx munh đuungx, Nănh songđ numđ hâuđ lênh phunz stiz, wâyc nănh stiz zuc sêu lunc laoc, cayx năngđ bah jiz yuungh max naih zâu jămđ. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Tăng wa, Nănh coong ănz Nănh nyăngz stayb sây: “Jeengz zunb đuungx, six cumh pâuz munh stoc. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Wâyc nây, oix zuc joođ jeengz zunb nyăngz Zâu, ayx tuz phunz Nănh paiđ cumh pâuz munh taih sâub Nănh nyăngz jeengz zunb.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Nănh êu Nănh nyăngz săpc nyâyc lanh stayb sây taih, Nănh jaoz lokc jangx phunz stiz hayh luiđ manđ yootz, luiđ manđ setb yâuc hayh zany gongx muif huungđ gumc cloon muif huungđ munz. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Săpc nyâyc lanh stayb sây nyăngz bux six năngđ nây: Tah yetx, Si-môn (yâuc hipđ ayx Pi-tê) cloon nănh nyăngz yâuf, An-đa-lu; Ya-coopc, cloon nănh nyăngz yâuf, Yô-hanx Sê-bê-đi nyăngz toonz; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Phi-lipx cloon Ba-tô-lô-miu; Tô-matx cloon Ma-tai, sâub sôiv wax tauh; Ya-coopc six An-phê-atc nyăngz toonz, cloon Tat-đê-atc; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Si-môn Sê-lôt, cloon Yu-đatc I-sa-ca-li-ôtx, maic Zâu Yê-su wax tauh.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Zâu Yê-su paiđ nâyx đomc săpc nyâyc lanh munh ninyh, zăpx bux nănh stiz coong: “Năngx gâyf ninyh quaix pitc stingx munh nyăngz stâyz phangz, yâuc năngx gâyf ninyh nzac Sa-ma-đi munh nyăngz dlanyh. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Six oix zuc ninyh lov I-sa-la-ên nyăngz bah jiz yuungh ninyh gaih wax đomc. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Nyâuh yăngh jau ninyh, wax zanyf, nyâuh oix zuc nzônh coong: ‘Tênb-toongh Côkz taih tauv stătx gôh.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Oix zuc zany gongx munh nyăngz gumc, yâuc êu munh tayc săngh taih, yâuc zany maoh pongz munh nyăngz gumc, yâuc luiđ manđ setb. Nyâuh cungb tuz nyăngz, six lauf oix zuc cungb phunz. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Năngx gâyf nzâyz, sămz, max six nyanh pec, max six tongh stinh, ănz nyanh tic nyax ănz nyâuh nyăngz clai, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />max nongc bênc luungđ nongc nzâyz ninyh, iz yămc guyz, max six stub, max six pya byac, wâyc cumh pâuz munh hoopđ zuc tuz nănh nhlinc yămz nyăngz phănc. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Nyâuh ninyh nzac laiv nomz dlanyh max six nzac laiv nomz njăngv, oix zuc zah mungv jađ yămz wa naih mănv payh tuz stipx nyâuh, oix zuc yămz stiz nyăngz pyau năngx tauv laiv zanyf nyâuh setb wax nomz tinc ninyh. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Nzac wa pyau ninyh, wax zanyf, oix zuc joođ peengh oonz phunz wax sênz pyau. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Năngđ coong wax sênz pyau payh tuz têx, nyâuh nyăngz peengh oonz six yămz wa, six năngđ coong max payh tuz têx, nyâuh nyăngz peengh oonz six lêpc nyâuh phunb đangz. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Laiv lanh max stipx nyâuh, yâuc max mungv nyâuh nyăngz wac, six tauv nyâuh setb blătc wax sênz pyau max six setb blătc wax nomz dlanyh, oix zuc phătb nyâuh nyăngz staux đi nib buungb. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Yaz coong senz, bux nyâuh, Tauv tingc stoif wax noib, Sô-đôm cloon Gô-mô-la dlanyh, six zuc tingc stoif năngx sâub têx, wax nomz dlanyh.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Mangc, Yaz paiđ nyâuh setb ninyh, cayx năngđ bah jiz yuungh yămz jab clô đungc cah njaf, wâyc nây oix zuc lemđ cayx năngđ nangz, yâuc dlênc cayx năngđ nooc bah côz nâyx. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Six oix zuc bôngh munh, wâyc stiz six oix zoz nyâuh jaoz phunz stămđ stoif quanz, stiz yâuc oix yămz wa stămđ stoif tinc nongc pya stătb nyâuh; <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />wâyc Yaz nyâuh six zuc ênz ninyh tauv peengz pyây cloon huungh stix nyăngz cah đangc, nongc ayx zanyx manyf phunz nănh stiz cloon pitc nomz côkz nyăngz pec stingx. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Nyâuh zuc ênz ninyh wax zanyf, năngx gâyf numđ stauh cayx coong ayx laix, max six cayx coong luungđ, six tauv wax zanyf, nyâuh sămv zuc coong nyăngz, cănh tuz sađ phunz nyâuh. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Wâyc max zâyf nyâuh cănh coong, six nyâuh nyăngz Pha nyăngz Singx-Lingh yămz nyâuh coong setb taih. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Max zâyf cungb nâyx, tah six zoz yâuf jaoz phunz munh tayx, pha yâuc zoz sây jaoz phunz munh tayx, sây yâuc cănh cloon nzif pha tinyh tămx tinyh nzeengz yâuc ayx phunz stiz zuc tayc. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Wâyc yaz nyăngz manyh, nyâuh six zuc munh tinyh đoih hănđ nyâuh, six laiv lanh tanyđ tuz tauv tauh tauv mâyv, wax lanh nzăngđ tuz njâuv. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Six nyâuh zuc munh ayx huđ yămz nâyx nomz dlanyh, six oix zuc tiuv ninyh pitc nomz dlanyh, yaz coong senz bux nyâuh, nyâuh ninyh max zeengx nzêux I-sa-la-ên nyăngz muif nomz dlanyh Bamh Munh songđ taih tauv gôh.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Stayb sây six max blătc tuz stayb pha, ayx nâuh munh yâuc max blătc tuz nănh nyăngz zâu. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Stayb sây tinyh phanv hayh tuz năngđ nănh nyăngz stayb pha, nâuh phanv tuz năngđ nănh nyăngz zâu, six caux gôh. Năngđ coong munh hipđ pyau zâu ayx Bê-ên-sê-bun, six nănh nyăngz pyau munh lauf zuc đamz manyh năngx huđ têx! <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Wâyc nây, nyâuh năngx gâyf cumh nzav munh, wâyc max naih laiv huungđ pinyx bix max zuc zoz setb taih, yâuc max naih huungđ pinyx vâyv tuz munh max pâyz. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Yaz yămz nzămc bux nyâuh laiv huungđ, oix zuc yămz gwăngz coong setb taih, nyâuh numđ coong wac sapb ănz bah noomh coonz, oix zuc yămz pyau tuungx hamv coong setb taih. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Năngx gâyf cumh nzav wax đomc munh hayh tayx nyâuh nyăngz stinb, bix max hayh tayx nyâuh nyăngz meengc hoonh. Six oix zuc cumh nzav hayh njinh stinb njinh hoonh mêtc ănz wa tâuf coiđ wax Tauh. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Iz saz nooc câyc maic max zâyf cungb tuz ah nomz tongh stinh haz? Six năngđ coong max zâyf nyâuh nyăngz Pha nyăngz zux ix, six max naih laiv saz zuc tuih nib. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Njinh nyâuh nyăngz pyây đongz, yâuc tuz stauđ nzuf nzof gôh. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Wâyc nây năngx gâyf cumh nzav; nyâuh six năngx saix têx đuungx saz nooc câyc. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Wâyc nây, muif lanh, tinyh phanv laiv lanh toongx songx nhlimc yaz, yaz lauf yămz yaz nyăngz Tênb-toongh Pha nyăngz cah đangc nhlimc wax tauh. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Six tinyh phanv laiv lanh max toongx songx nhlimc yaz, six yaz yămz Tênb-toongh Pha nyăngz cah đangc, yaz lauf max nhlimc wax tauh.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Năngx gâyf nyâyh coong yaz nzâyz peengh oonz taih nây bamh canz. Yaz max zâyf nzâyz peengh oonz taih, yaz six nzâyz nzuc đao taih. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Wâyc yaz taih six ayx phunz toonz cloon pha max tinyh hođ, nzif cloon sab max tinyh hođ, bongf cloon bôf max tinyh hođ; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />mănv lauf naih cănh nyăngz wax đomc pyau munh ayx yônz zaz. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Laiv lanh stăngz pha max six nzif năngx đuungx têx yaz, six max payh cloon yaz; laiv lanh stăngz sây toonz sab năngx đuungx têx yaz, six lauf max payh cloon yaz. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Laiv lanh max cănh đamz nănh nyăngz săpc đăngc zax bix lêpc yaz ninyh, six max payh cloon yaz. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Laiv lanh jâuz cănh nyăngz meengc six zuc stâyb meengc, laiv lanh wâyc yaz zuc quanyf cănh nyăngz meengc six tuz meengc lauf.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Laiv lanh stipx nyâuh six lauf stipx yaz, laiv lanh stipx yaz six lauf stipx paiđ yaz taih wax Tauh. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Laiv lanh stipx ah lanh tâuc wac munh wâyc nănh ayx tâuc wac munh, six tuz stipx stâuđ nyâyc cayx năngđ tâuc wac munh, laiv lanh stipx ah lanh peengh stimz munh wâyc nănh six peengh stimz munh, six lauf tuz stipx stâuđ nyâyc cayx năngđ peengh stimz munh. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Laiv lanh phunz ah zan womz nămx phunz nâyx đomc ah lanh jenz quaix nyăngz munh hopb, wâyc nănh ayx yaz nyăngz stayb sây, yaz coong senz bux nyâuh, hănđ ayx laix nănh yâuc max stâyb nănh nyăngz stâuđ nyâyc.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Zâu Yê-su nzaox wax đomc phunz Nănh nyăngz săpc nyâyc lanh stayb sây tuz, Nănh tiuv wax cuyb tinc nzaox songx munh yâuc nzônh gâyf yămz wax đomc songx munh nyăngz dlanyh. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Wax zanyf, Yô-hanx, yămz wa nzauh numđ lănv tauv Zâu Jix-Tuz ayx nyăngz jau, nănh songđ paiđ nănh wax đomc stayb sây ninyh, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />naic Zâu Yê-su coong: “Mâyh six oix zuc taih wax Tauh, max six buz zef năngx zuc zu pitc Tauh heh?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Zâu Yê-su tauz nănh stiz coong: “Nyâuh muf bix lănv phunz Yô-hanx nyâuh tuz phătc cloon tuz numđ nâyx đomc. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Munh mâyc buđ yâuc tuz mangc phătc, munh staux quac yâuc hayh yăngh, zuc maoh munh yâuc tuz dlăngc, munh bah noomh đuungz yâuc tuz numđ, munh tayc yâuc tuz săngh taih, munh zâuđ yâuc tuz numđ nzônh Cuđ Jenx. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Laiv lanh max nzêmh yaz six naih oonz looc gôh.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Wax zanyf, nănh stiz muf blătc, Zâu Yê-su songđ coong tauv Yô-hanx ănz songx munh: “Nyâuh ninyh wa stâyz phangz blănf lov luungđ mangc heh — mangc lauđ tic queeng zuc nzaox sâyb mah? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Năngđ max zâyf six nyâuh setb ninyh mangc luungđ — mangc ah lanh munh zuz nhlêuf guyz quav mah? Năngđ naz, munh zuz nhlêuf guyz quav six yămz wa huungh tinc. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Năngđ max zâyf naz, six nyâuh ninyh mangc luungđ — mangc ah lanh tâuc wac munh lec zâyf max? Yaz coong ănz nyâuh, senz zâyf gôh, lôx zef năngx blătc ah lanh tâuc wac munh timb. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Nây six wâyc nănh bix tuz ja coong:</para>
  <para style="q1" vid="MAT 11:10">‘Mangc geh, Yaz paiđ Yaz nyăngz tâuc jenx munh ninyh đangc mâyh, nănh six ninyh bênc săngh jau phunz mâyh.’<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Yaz coong senz bux nyâuh, yămz munh nzif steengb taih nyăngz munh, max naih laiv lanh năngx lub têx Yô-hanx Quaix-gâyf wax tauh, six yămz Tênb-toongh côkz năngx jenz têx wax tauh, lôx năngx têx Yô-hanx. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Six tăng Yô-hanx Quaix-gâyf taih tauv nâyx zanyf, Tênb-toongh nyăngz côkz zuc dlauc huđ, yâuc zuc ayx huđ nyăngz munh âyz jab oix zab nongc. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Wâyc muif lanh tâuc wac munh cloon gâyf njanh stâub coong quaix đangc tauv Yô-hanx; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />six năngđ coong nyâuh pâyz tuz, nănh six I-sa-ya, oix zuc taih wax tauh. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Mănv naih bah noomh nongc mungv, oix zuc mungv. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Six yaz cayx pây nâyx yenh munh ănz luungđ heh? Stiz six cayx năngđ ah peob munh sây, stâyv wa caiz sangc cah njaf, lanh êu lan, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />coong: ‘Buz pyom blungh blex phunz nyâuh, six nyâuh yâuc max tiuh loongc. Buz yônx meengc, six nyâuh yâuc max haoh.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Wâyc Yô-hanx taih, max nhlinc yâuc max hopb, six stiz coong: ‘Nănh zuc manđ nzac yămz stinb.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Bamh Munh taih, nhlinc cloon hopb, stiz yâuc coong: ‘Mangc lâyc tauh munh geh, ah lanh munh mauh nhlinc, mauh hopb, cloon sâub sôiv munh căn stoif nyăngz munh ayx toic!’ Six naih tongb manyh max naih, six mangc wax đomc cumh pâuz ayx setb taih.”<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Tăng wa, Nănh mađ zaux wax đomc dlanyh wâyc wax đomc dlanyh Nănh yămz wa ayx đuungx huungđ jix caox njingc, munh yâuc max nhlimc stoif. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Nănh coong: “Cô-la-sin lex, mâyh zuc zâuđ gôh! Bêtx-sai-đa lex, mâyh zuc zâuđ gôh! Wâyc yămz nyâuh cah njaf ayx wax đomc jix caox njingc setb taih, năngđ coong yămz Tai-lapx cloon Sa-đôn môngf ayx, stiz lôx zuz đôc buyx nyootb stâyv wa saiđ đuiz minc nhlimc stoif lauh nzof gôh. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Wâyc nây, Yaz coong bux nyâuh, tauv tingc stoif wax noib, Tai-lapx cloon Sai-đôn six zuc tingc năngx sâub têx nyâuh. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Năngx naih mâyh, Ca-bê-na-um, ah nomz dlanyh njăngb staox guungh ninyh? Mâyh six zuc nzac tauv yămz pâu. Wâyc yămz mâyh cah njaf ayx wax đomc jix caox njingc, năngđ coong yămz wa Sô-đôm ayx têx, wax nomz dlanyh lôx năngx yămz tauv nâyx yenh. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Wâyc nâyx, Yaz coong bux nyâuh, tauv tingc stoif wax noib, Sô-đôm six zuc tingc năngx sâub têx nyâuh.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Wax zanyf, Zâu Yê-su songđ coong: “Pha, guungh nib nyăngz Zâu lex, Yaz tanv Pha, wâyc Pha pinyx nâyx đomc max phunz tongb manyh nyăngz munh cloon munh lemđ pâyz, six yâuc phunz wax đomc munh sây jenz pâyz. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Six, Pha lex, wâyc ayx nâyx six hoopđ Pha nyăngz nyâuđ. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Muif huungđ Pha jaoz phunz yaz nzuf; blătc nzuf Pha max naih mănv pâyz Sây, yâuc max naih mănv pâyz Pha blătc nzuf Sây oix phunz pâyz wax đomc munh. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Nyâuh laiv lanh numđ zâuđ nzâyz niđ, bix taih lov yaz, yaz six phunz nyâuh tuz hitb conv. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Oix zuc nzâyz yaz nyăngz bănx tanz ănz nyâuh, yâuc hođ âyz yaz, wâyc yaz naih nyâuđ dlênc yâuc nyangc tuz, nyâuh nyăngz meengc hoonh six cănh tuz hitb conv. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Wâyc yaz nyăngz bănx tanz nzâyz hâyđ yaz nyăngz đamx yâuc sâub pinyv.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Wax zany, six toix tingc congz noib, Zâu Yê-su pitb quaix wa njingh blauh ninyh, Nănh nyăngz stayb sây buz nyâuđ sab stiz songđ mătx wax đomc blauh taih nhlinc. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Six phătc nâyx đomc dlayc Pha-li-si munh coong ănz Nănh: “Mangc geh, Mâyh nyăngz stayb sây ayx nâyx đomc six max cuib ayx yămz tingc congz noib.” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Năngđ naz, Zâu Yê-su tauz stiz coong: “nyâuh max zeengx toc quaix Đa-witx huungh cloon lêpc nănh wax đomc munh nyâuđ sab wax zanyf bix ayx nyăngz haz? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Ayx laix Đa-witx bix nzac bongc Zâu Tênb-Huungh nyăngz pyau yâuc zoz congx quaix wax đomc nzu nhlinc, wax đomc nzu Đa-witx cloon lêpc nănh wax đomc munh six max cuib nhlinc, cungb phunz wax đomc stayb munh cuungv? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Nyâuh max toc quaix yămz gâyf njanh sâub coong yămz Tingc Congz noib, wax đomc stayb munh yămz bongc Zâu Tênb-Huungh nyăngz pyau, hănđ ayx longđ tingc congz noib stiz lauf max naih stoif haz? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Six yaz coong bux nyâuh yămz nây naih ah Lanh năngx lub têx bongc Zâu Tênb-Huungh nyăngz pyau. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Năngđ coong nyâuh pâyz nâyx zâux wac six coong ayx laix têx: ‘Yaz oix munh naih nyâuđ hâuđ lênh munh, max zâyf oix munh nzâyz stanyb lanyh taih congx,’ nyâuh six max tingc max ayx longđ nyăngz munh. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Wâyc Bamh Munh six ayx tingc congz noib nyăngz Zâu.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Nănh ninyh gâyh wax cuyb tinc, Nănh nzac stiz wa huyđ toongh pyau ninyh. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Phanv mangc, yămz wa naih ah lanh munh ah saz puf quac, stiz naic Zâu Yê-su coong: “Tingc congz noib cuyb zany gumc max?” phunz stiz nzăngđ hayh naih jau cooux Nănh. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Six Zâu Yê-su coong ănz stiz: “Naih tix lanh munh yămz nyâuh cah njaf, năngđ coong nănh naih ah tauh bah jiz yuungh, bix năngđ coong wax tauh bah jiz yuungh tuih nzac cotb toix tingc congz noib, nyâuh max zâyf zoz tăkc setb taih haz? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Năngđ nây munh six năngx saix têx bah jiz yuungh pâyz sax phănc! Wâyc nây, naih ja coong oix zuc ayx gongx yămz tingc congz noib.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Tăng wa, Nănh êu wax tauh munh quac coong: “stuungb mâyh nyăngz puf staox taih gôh.” Nănh stuungb puf staox taih yâuc tuz gongx, cayx năngđ wax saz gongx nâyx. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Six tauv setb taih Pha-li-si munh songđ ta zux ix nzeengz Zâu Yê-su lov jau ayx laix stiz nzăngđ hayh tayx tuz Nănh.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Six Zâu Yê-su pâyz năngđ nâyx, Nănh songđ tiuv gâyh wax cuyb tinc. Naih munh đuungx lêpc Nănh ninyh, Nănh yâuc zany gongx phunz stiz nzuf. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Nănh yâuc bux stiz êu năngx gâyf phunz Nănh setb nzăngc, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />ayx phunz toix nzuf tâuc wac munh I-sa-ya tâuc taih nyăngz wac, coong:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Mangc geh, Yaz nyăngz pâuz, Yaz sên taih wax Tauh;</para>
  <para style="q1" vid="MAT 12:18">Yaz senz stăngz wax Tauh, Nănh senz hoopđ Yaz nyăngz stimz nyâuđ nzuf.</para>
  <para style="q1" vid="MAT 12:18">Yaz six phunz Yaz nyăngz Singx-Lingh yămz Nănh,</para>
  <para style="q1" vid="MAT 12:18">Nănh six oix coong tauv peengh stimz nyăngz jau phunz cungh ngwaic côkz wax đomc pec stingx.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Nănh six max taux munh, yâuc max hamv mađ;</para>
  <para style="q1" vid="MAT 12:19">yâuc max naih mănv numđ Nănh nyăngz stingb yămz wa caiz sangc.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Phătc njăngx cayx setc Nănh six max au nau,</para>
  <para style="q1" vid="MAT 12:20">phătc toongz tâuf cayx tayc Nănh yâuc max tayx tayc,</para>
  <para style="q1" vid="MAT 12:20">tuz tauv laiv zanyf Nănh ayx peengh stimz nyăngz jau năngx clăkx clunh nzuf,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />cungh ngwaic côkz nyăngz pec stingx, yâuc naih njic mungc yămz Nănh nyăngz manyh.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Tăng wa, naih munh ênz ah lanh munh, mâyc buđ, yâuc zuc manđ yămz stinb wax hayh coong wac taih phunz Nănh, Nănh songđ zany gongx phunz wax lanh munh, ayx tuz wax lanh munh hayh coong wac yâuc tuz phătc jau. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Songx munh nyâyh ganc songđ coong: “Tauh munh six Đa-witx nyăngz Sây Stunz max six loz?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Six wax đomc Pha-li-si munh, numđ nâyx đomc dlayc, songđ coong: “Nănh six max hayh luiđ manđ năngđ coong Nănh max nongc Bê-ên-sê-bun, manđ huungh nyăngz lanyf.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Six wâyc pâyz stiz nyăngz nyâuđ nyâyh, Nănh songđ coong ănz stiz: “Ah nomz côkz bix cănh phunz goib taih tinyh nzeengz six lunc paic nzuf, ah nomz dlanyh max six pyau năngđ phunz goib taih cănh tinyh nzeengz, six max hayh yămz tuz wăn. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Năngđ coong Sax-tanx cănh luiđ Sax-tanx, cănh phunz goib taih tinyh nzeengz, năngđ nâyx, nănh nyăngz côkz laiv hayh yămz tuz wăn heh? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Năngđ coong yaz nongc Bê-ên-sê-bun nyăngz lanyf luiđ manđ, nyâuh nyăngz sây nongc luungđ lanyf luiđ manđ heh? Wâyc nâyx đomc dlayc, stiz six cănh plănc lauf cooux nyâuh gôh. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Six năngđ coong yaz nongc Zâu Tênb-Huungh nyăngz Singx-Lingh luiđ manđ, six Zâu Tênb-Huungh nyăngz côkz taih tauz nyâuh gôh. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Ayx laix naih mănv hayh nzac munh njoongh munh nyăngz pyau ninyh, nimc zoz nănh nyăngz tungh zăngc, năngđ coong max stayb wax tauh munh njoongh đangc heh? Oix zuc stayb nănh đangc, nzof mănc nimc zoz nănh nyăngz tungh zăngc. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Mănv max cloon yaz yămz six tămx yaz, laiv lanh max cloon yaz căpx dlonf, six đanv ninyh. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Wâyc nâyx đomc dlayc, yaz coong ănz nyâuh, muif huungđ stoif cloon coong pamf Zâu six tuz quanyf phunz munh, six coong pamf tauv Singx-Lingh six max tuz quanyf. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Năngđ coong laiv lanh coong wac peo Bamh Munh, wax tauh six tuz quanyf stoif. Six laiv lanh coong peo tauv Zâu Singx-Lingh wax tauh six max tuz quanyf stoif, yămz nâyx stâyv max six cah đangz stâyv lauf max tuz quanyf. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />Wax zâyz njăngx gongx six pyâu lauf gongx, wax zâyz njăngx huđ six pyâu lauf huđ, wâyc mangc wax đomc pyâu six pâyz tuz wax zâyz njăngx. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Nangz meengz nyăngz sây stunz lex, tăng wa phăn huđ, nyâuh laiv hayh coong tuz wac gongx heh? Wâyc nyâuđ naih pong laiv huungđ, nzetx nzăngđ coong setb taih. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Munh gongx, six tăng nănh nyăngz nyâuđ njaf naih gongx pong nzuf, coong setb taih yâuc gongx, munh huđ, six tăng nyâuđ njaf naih huđ pong nzuf, coong setb taih yâuc huđ. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Six yaz coong bux nyâuh, muif lanh munh coong nyăngz muif zâux max săngh nyăngz wac, tauv tingc stoif wax noib six zuc zoz setb taih stămđ nzuf. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Wâyc tăng nyâuh coong nyăngz wac, nyâuh bix tuz stunx ayx peengh stimz munh, yâuc tăng nyâuh coong nyăngz wac, nyâuh bix zuc tingc stoif.”<verse eid="MAT 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Wax zanyf, naih ah đomc nzaox gâyf stênx steengb cloon Pha-li-si munh naic Nănh coong: “Stênx steengb lex, buz oix mangc Mâyh ayx ah cuyb njic hoouđ.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Six Nănh tauz stiz, coong: “Nâyx stâyv nyâuđ huđ cuyx quaiz nyăngz munh oix mangc ah cuyb njic hoouđ, six max naih laiv cuyb njic hoouđ ayx phunz nănh stiz, blătc nzuf tâuc wac munh Yô-na nyăngz njic hoouđ. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Wâyc Yô-na yămz byauf lub nyăngz nyâuđ njaf pôz noib cloon pôz munf ayx laix, six Bamh Munh lauf yămz nib đi pôz noib cloon pôz munf năngđ wa nâyx. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Tauv tingc stoif wax noib, Ni-na-we munh six stâuđ quef taih cooux nâyx nzêuh munh. Wâyc Yô-na ninyh quinb wax zanyf stiz coi nyâuđ nhlimc stoif, six phanv mangc, yămz nây naih ah Lanh năngx lub têx Yô-na. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Tauv tingc stoif wax noib, namh pôngz wax tauh huungh nzif six stâuđ quef taih cooux nâyx nzêuh munh, wâyc nănh tăng guungh coonz wax đomc tinc taih mungv Sa-lô-môn nyăngz tongb manyh, six mangc geh, yămz nây naih ah Lanh năngx lub têx Sa-lô-môn. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Manđ yootz setb gâyh ah lanh munh wax zanyf, nănh quaix stâyz phangz gâu ninyh, lov tinc sec six lov max tuz. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Wax zanyf, nănh coong: ‘Yaz six phunb đangz muf pyau, yaz tăng wa setb taih nyăngz pyau.’ Muf tauv wa, nănh phătc pyau njaf max naih luungđ tiny, nzâux tuz dlăngc wayh yâuc dlauf gongx gongx ănz wa. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Tăng wa nănh zef ninyh ênz nhlic tauh manđ zef năngx huđ têx nănh, taih nzac wax sênz pyau ninyh tinyh đoih yămz wa, tăng wa wax lanh munh six zef năngx huđ têx cah đangc. Nâyx nzêuh munh huđ munh six lauf năngđ nây nâyx.”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Wax zanyf Zâu Yê-su năngx jinh coong ănz songx munh, phanv mangc, Nănh nyăngz nzif cloon Nănh wax đomc yâuf stâuđ wa cungh ngwaic, lov jau oix cloon Nănh coong wac. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Wax zanyf, naih ah lanh munh bux Nănh coong: “Phanv mangc Mâyh nyăngz nzif cloon Mâyh wax đomc yâuf taih stâuđ wa cungh ngwaic, lov jau oix cloon Mâyh coong wac.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Six Nănh tauz, wax tauh munh coong: “Mănv six yaz nyăngz nzif mănv six yaz nyăngz yâuf heh?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Tăng wa Nănh stuungb puf nuz Nănh wax đomc stayb sây, Nănh coong: “Phanv mangc, yaz nyăngz nzif cloon yaz nyăngz yâuf nhlex! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Wâyc laiv lanh munh ayx âyz yaz nyăngz cah zâyc Tênb-toongh Pha nyăngz zux ix, wax lanh six yaz nyăngz yâuf, cloon yaz nyăngz muc, cloon yaz nyăngz nzif.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Lauf wax noib, Zâu Yê-su setb pyau ninyh, Nănh ninyh stâyv wa coiđ sinh. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Songx munh hongđ nzongf yămz quib Nănh nzêux nzuf. Ayx tuz Nănh japc nzac ah saz đangđ ninyh, Nănh stâyv wa, six songx munh tinyh đoih stâuđ wa coiđ sinh. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Nănh nongc wac pây nzaox đuungx huungđ phunz stiz, coong: “Naih ah lanh munh setb ninyh hav nhlimb. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Hav nhlimb wax zanyf, naih ah phanx nhlimb tuih zuc jau, nooc songđ taih nhlinc wax đomc nhlimb nzuf. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Naih ah phanx tuih nzac njauz poz, wax đomc tinc max naih nib phănx đuungx, nhlimb songđ lênh dlih bêux, six wâyc max naih nib phănx đôz. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Tauv bah noib setb taih, zuc njah toc phaib songđ njeengh caođ nzuf wâyc max naih đuungh đôz. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Naih ah phanx tuih nzac nzim plungz ninyh, nzim lub taih songđ zuc plongz nzuf. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Naih ah phanx tuih nzac nib gongx, songđ săngh blaz nyauh, lauh comđ tuz ah pez, lauh comđ tuz guc săpc, lauh comđ tuz stamx săpc. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Mănv naih bah noomh, oix zuc mungv.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Tăng wa, wax đomc stayb sây buz taih stătx, songđ naic Nănh, coong: “Wâyc săngh laix mâyh bix nongc wax đomc wac pây coong ănz songx munh heh?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Six Nănh songđ tauz, stayb sây buz coong: “Yămz Tênb-toongh côkz Wax đomc pinyx nyăngz six tuz sađ phunz nyâuh pâyz, six năngx naih wax đomc munh six max tuz sađ phunz. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Wâyc laiv lanh naih, six tuz pâu phunz nănh nyăngz phănc, nănh six tuz naih yăngc. Six laiv lanh max naih, njinh nănh naih nyăngz six zuc zoz ninyh. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Six wâyc năngđ nâyx, Yaz nzăngđ nongc wac pây coong ănz stiz; wâyc stiz hănđ mangc, yâuc mangc max phătc; hănđ nzaz bah noomh mungv, stiz yâuc max saz tuz. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Wâyc stiz bix I-sa-ya tâuc taih nyăngz wac setb taih toix nzuf, coong:</para>
  <para style="q1" vid="MAT 13:14">‘Nyâuh mungv, six hănđ nzaz bah noomh mungv, yâuc mungv max saz;</para>
  <para style="q1" vid="MAT 13:14">nyâuh mangc, six hănđ mangc, yâuc mangc max phătc.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Wâyc nâyx đomc pec stingx nyăngz nyâuđ nhlengc nzongf;</para>
  <para style="q1" vid="MAT 13:15">stiz nyăngz bah noomh max oix mungv,</para>
  <para style="q1" vid="MAT 13:15">yâuc nzipx stiz nyăngz mâyc max mangc,</para>
  <para style="q1" vid="MAT 13:15">săngx đanyf stiz nyăngz mâyc hayh mangc tuz phătc,</para>
  <para style="q1" vid="MAT 13:15">bah noomh hayh mungv tuz numđ,</para>
  <para style="q1" vid="MAT 13:15">nyâuđ yâuc hayh manyh pec,</para>
  <para style="q1" vid="MAT 13:15">bix cănh coi nyâuđ lauf,</para>
  <para style="q1" vid="MAT 13:15">Yaz yâuc zany stiz tuz gongx.’<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Six nyâuh senz naih oonz looc gôh, wâyc nyâuh nyăngz mâyc mangc tuz phătc, cloon nyâuh nyăngz bah noomh, yâuc mungv tuz numđ. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Yaz coong senz bux nyâuh, naih đuungx lanh tâuc wac munh cloon peengh stimz nyăngz munh nyâyh mungc oix tuz phătc nyâuh phătc nâyx đomc, six stiz max tuz phătc, oix numđ nyâuh numđ nâyx đomc yâuc max tuz numđ. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Năngđ nây, nyâuh mungv jađ munh hav nhlimb nyăngz wac pây six luungđ. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Munh mungv Tênb-toongh côkz nyăngz Cuđ Jenx bix max saz, six manđ taih zoz yămz stiz nyăngz nyâuđ wax đomc Cuđ Jenx ninyh nzuf. Nây six nhlimb tuih zuc jau wax đomc. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Wax đomc nhlimb hav nzac njauz poz, six wax đomc munh numđ Cuđ Jenx yâuc coonx numđ nyađ stipx Cuđ Jenx; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />six wax tauh munh max naih đuungh, songđ zen max lauh; tauv wâyc Cuđ Jenx pongh zuc zâuđ max six pongh zuc ayx huđ, wax tauh munh songđ setb taih. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Hav tuih zuc nzim plungz wax đomc nhlimb, six wax đomc munh numđ Cuđ Jenx, yâuc cungb nyâyh nây stâyv sangc, nyâyh oix tuz puv quâyx songđ ayx phunz Cuđ Jenx max hayh săngh tuz pyâu. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Six tuih nzac nib gongx wax đomc nhlimb, six munh numđ Cuđ Jenx yâuc saz, wax đomc munh songđ săngh pyâu, ayx tuz lauh nomz tuz ah pez, lauh nomz tuz guc săpc, lauh nomz tuz stamx săpc.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Zâu Yê-su zef coong pitc tauh wac pây phunz stiz coong: “Tênb-toongh côkz six pây cayx năngđ ah lanh munh ninyh hav nhlimb gongx ănz nănh nyăngz njingh. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Six tauv munh phâyx mâyc njoomh, nănh nyăngz yônz zaz taih hav mađ huđ zanb nzac wa blauh witx ninyh songđ tiuv. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Tauv blauh lub taih setb blauh wax zanyf, songđ phătc mađ huđ lauf naih zanb wa. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Wax zanyf, njingh zâu wax đomc pâuz songđ taih naic wax tau zâu coong: ‘Zâu lex, mâyh max zâyf hav nhlimb gongx ănz mâyh wa njingh haz? Ha, wax đomc mađ huđ six tăng laiv taih heh?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Njăngx zâu coong ănz stiz: ‘Nâyx đomc six yônz zaz ayx lêc.’ Wax đomc pâuz munh zef naic njăngx zâu coong: ‘Ha, mâyh oix buz ninyh wa peengz mađ năngx nzuf max?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Six njăngx zâu tauz coong: ‘Max nongc đêh, săngx đanyf nyâuh peengz mađ huđ, bix hayh peengz zuc căn blauh. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Phanv dluyh stiz tinyh zanb lub taih, zu tauv sâub zunb nyăngz săngx huđ tauv, tauv beengc săngx huđ sâub, yaz cănh êu wax đomc cumh pâuz munh: Quănf wax đomc mađ huđ đangc stayb ayx săngh ploc nongc nzâyz ninyh pu, mănc sâub blauh nzâyz lauf ănz yaz nyăngz njămf.’”<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Zâu Yê-su zef coong ah tauh wac pây phunz stiz, coong: “Tênb-toongh côkz six lauf pây cayx năngđ ah nomz njayz jaix nhlimb, naih ah lanh munh zoz ninyh songx ănz nănh nyăngz njingh; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />wax nomz nhlimb six năngx jenz têx muif huungđ nhlimb, six tauv bêux lub taih, nănh năngx lub têx muif huungđ njayz yămz wa lauđ winb cah njaf, yâuc pênx ah zâyz njăngx, ayx tuz nooc taih ayx nzauf ănz nănh nyăngz quah.” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Zâu Yê-su coong pitc tauh wac pây phunz stiz timb coong: “Tênb-toongh côkz six cayx năngđ piny nâyx, naih ah lanh munh nzif zoz taih lou ănz pôz tongđ văn ayx tuz tauv wax đomc văn phutx nzuf.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Zâu Yê-su nongc wac pây coong wax đomc ănz songx munh, Nănh max coong laiv huungđ ănz stiz bix max nongc wac pây, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />ayx phunz tâuc wac munh coong taih nyăngz wac toix nzuf, coong:</para>
  <para style="q1" vid="MAT 13:35">“Yaz six goib nzetx nongc wac pây coong.</para>
  <para style="q1" vid="MAT 13:35">Yaz six coong tăng njăpc guungh njăpc nib wax đomc pinyx nyăngz setb taih.”<verse eid="MAT 13:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Tăng wa, wax đomc songx munh muf blătc, Nănh songđ nzac pyau muf, Nănh wax đomc stayb sây songđ taih stătx Nănh, naic coong: “Joođ pob manyf phunz buz, mađ huđ yămz wa njingh nyăngz wac pây.” <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Wax zanyf, Zâu Yê-su tauz, coong: “Hav nhlimb gongx wax tauh six Bamh Munh, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />njingh tâyc six nây bamh canz, wax đomc nhlimb gongx — six Tênb-toongh côkz nyăngz pec stingx, six wax đomc mađ huđ six njangh okx wax tauh nyăngz pec stingx, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />yônz zaz, hav wax đomc mađ huđ wax tauh, six manđ. Sâub zunb nyăngz săngx huđ, six tauv stêtb mâyv nyăngz noib, quănf blauh wax đomc cumh pâuz munh, six wax đomc stinz munh. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Năngđ nây, mađ huđ zuc quănf nzâyz taih pu ănz tâuf năngđ laix, six tauv stêtb mâyv nyăngz noib, six lauf năngđ wa nâyx. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Bamh Munh six paiđ Nănh nyăngz stinz munh ninyh, sâub dlonf wax đomc ayx huđ nyăngz munh cloon wax đomc max zen nyăngz munh, zoz setb Nănh nyăngz côkz nzuf. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Yâuc nzâyz wax đomc munh ninyh quanyf ănz wa tâuf coiđ, yămz wa naih pungx stingb haoh yâuc tăpc nyah tanyđ. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Tauv wax zanyf, wax đomc peengh stimz nyăngz munh six gwăngz eeng cayx năngđ bah noib nâyx, yămz stiz nyăngz Tênb-toongh Pha nyăngz côkz. Laiv lanh naih bah noomh, oix zuc mungv.” <verse eid="MAT 13:43" /><verse number="44" style="v" sid="MAT 13:44" />“Tênb-toongh côkz six cayx năngđ ah cuyb poou zâuz plopx ănz wa njingh tâyc nâyx, naih ah lanh munh ninyh lov pongh nănh zef năngx pinyx ănz wa. Nănh numđ nyađ nzuf, nănh coonx phunb đangz muf, maic nzuf nănh naih nyăngz muif huungđ jax toongx songđ ninyh maif wax tootz njingh. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />Năngx naih timb, Tênb-toongh côkz six lauf cayx năngđ ah lanh, steengb âyx munh ninyh lov saix nyăngz poou zâuz nâyx. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Tăng wa, tauv nănh lov tuz pongh ah nomz poou zâuz senz saix nzongf, songđ phunb đangz muf, nănh maic nzuf nănh naih nyăngz muif huungđ jax toongx bix ninyh maif wax nomz poou zâuz.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Zef, Tênb-toongh côkz six cayx năngđ ah phunb leđ nâyx pungx nzac coiđ ninyh sâub yâuc tuz muif huungđ byauf, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />tauv byauf pong leđ, ayx byauf munh songđ đănx staox wa wăngx sinh taih, stâyv wa, sên byauf gongx ănz nzac longx maoh ninyh, năngx naih wax đomc max săngh nongc, stiz zoz quanyf queengx. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Tauv stêtb mâyv muif huungđ six lauf năngđ nâyx: Wax đomc stinz munh six ninyh, zoz wax đomc ayx huđ nyăngz munh cloon wax đomc peengh stimz nyăngz munh phunz goib, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />stinz munh songđ quanyf wax đomc munh huđ nzac wa tâuf coiđ ninyh, yămz wa naih pungx stingb haoh yâuc tăpc nyah tanyđ. <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />Nyâuh saz nzuf nâyx đomc max?” Stiz tauz Nănh coong: “Saz lêc.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Wax zanyf, Zâu Yê-su coong ănz stiz: “Six wâyc năngđ nâyx, muif lanh nzaox gâyf stênx steengb tuz hoođ pâyz tauv Tênb-toongh côkz six cayx năngđ ah lanh pyau zâu, nănh zoz lôx nyăngz tungh zăngc cloon săngb nyăngz tungh zăngc tăng nănh nyăngz zaub tungh zăngc tinc setb taih.” <verse eid="MAT 13:52" /><verse number="53" style="v" sid="MAT 13:53" />Wax zanyf, Zâu Yê-su coong wax đomc wac pây tuz, Nănh songđ ninyh gâyh wax cuyb tinc.<verse eid="MAT 13:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Muf tauv Nănh cănh nyăngz njăngv, Nănh yămz wa huyđ toongh nzaox songx munh, ayx tuz songx munh nyâyh ganc yâuc coong: “Đomc tongb manyh cloon nănh ayx đomc jix caox njingc six tăng laiv taih heh? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Nănh max zâyf njăngx stangc nyăngz toonz haz? Nănh nyăngz nzif max zâyf hipđ ayx Ma-li-ya, cloon nănh wax đomc yâuf six Ya-coopc, Yô-sepx, Si-môn, cloon Yu-đa haz? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Max zây nănh wax đomc muc cloon pănh poc nây hah? Ha, nănh tuz nâyx đomc six tăng laiv taih heh?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Stiz songđ wâyc Nănh bix zuc longđ. Six Zâu Yê-su coong ănz stiz: “Tâuc wac munh six max zuc munh phătc stanc, setb blătc nănh cănh nyăngz njăngv njaf munh cloon nănh nyăngz pyau njaf munh.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Yămz wa Nănh max ayx jix caox njingc đuungx wâyc stiz nyăngz nyâuđ max zen.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Toix wax zanyf, Hê-lôtx huungh numđ coong tauv Zâu Yê-su nyăngz jau. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Hê-lôtx coong ănz nănh wax đomc pâuz: “Lâyc six Yô-hanx Quaix-gâyf. Nănh zef tuz tăng tayc săngh taih, wâyc nây, nâyx tauh munh nzăngđ hayh ayx tuz nâyx đomc jix caox njingc nyăngz dlayc.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Wâyc Hê-lôtx, zoz Yô-hanx, stayb nănh clăngđ ănz nzauh, wâyc nănh nyăngz yâuf, Phi-lipx nyăngz au, Hê-lô-đêtc. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Wâyc zuc Yô-hanx coong ănz Hê-lôtx huungh coong: “Mâyh, six max naih gâyf nongc Hê-lô-đêtc ayx au.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Nănh songđ numđ oix tayx Yô-hanx, six nănh yâuc cumh nzav songx pec stingx, wâyc stiz zanyf Yô-hanx six ah tauh tâuc wac munh. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Six tauv beengc Hê-lôtx nyăngz siny nyâtc wax tonx năngv, Hê-lô-đêtc nyăngz sab yămz wa hinh cah đangc tiuh loongc yâuc ayx phunz Hê-lôtx numđ hoođ nyâuđ, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Wâyc nây, Hê-lôtx nyunc ah zâux wac phunz wax lanh sab êu nănh oix nongc luungđ bix naic nănh six sađ phunz. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Wax zanyf, tuz stiz nzif bux nănh quaix đangc, nănh coong: “Joođ nâyx zanyf phunz yaz, Yô-hanx Quaix-gâyf nyăngz pyây taih tăpx nây hinh cah zâyc.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Nănh numđ stauh nzongf, six wâyc nănh nyunc nyăngz wac naih wax đomc quanz stâyv wa hinh, nănh songđ setb lanyf sađ phunz âyz wax tauh sab. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Hê-lôtx paiđ munh ninyh, wa nzauh cumv Yô-hanx nyăngz pyây. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Nzâyz Yô-hanx nyăngz pyây taih tăpx ănz wa hinh cah zâyc songđ jaoz phunz wax lanh sab, wax lanh sab songđ nzâyz ninyh phunz stiz nzif. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Tăng wa, Yô-hanx nyăngz wax đomc stayb sây taih zoz nănh nyăngz stayđ nzâyz ninyh plopx tuz. Stiz songđ ninyh, bux ănz Zâu Yê-su.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Wax zanyf, Zâu Yê-su numđ nâyx đomc dlayc, songđ lauf nzac ah saz đangđ ninyh staox wax đomc max naih munh nyăngz tinc ninyh ah lanh yămz lanyc. Songx munh pâyz, songđ tăng muif nomz dlanyh nyăngz munh tinyh đoih yăngh jau ninyh lêpc Nănh. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Tauv Nănh setb đangđ taih, Nănh phătc ah peob munh hongđ nzongf, songđ numđ hâuđ lênh wax đomc songx munh, Nănh yâuc zany gongx wax đomc săngh gumc nyăngz munh. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Wax zanyf, tauv cayx nzămc, wax đomc stayb sây taih coong ănz Nănh, coong: “Yămz nây six tinc lanyc, nâyx zanyf yâuc cayx nzămc nzof. Joođ mâyh êu songx munh muf nzac wax đomc njăngv, stiz nzăngđ hayh maif tix huungđ nongc nhlinc.” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Six Zâu Yê-su coong ănz stiz: “Stiz max zâuđ muf đêh. Nyâuh cănh zuc phunz stiz nhlinc.” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Wax zanyf, stiz tauz Zâu Yê-su, coong: “Yămz nây buz max naih luungđ cungb naih pyaz nomz nzu cloon iz tauh byauf.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Tăng wa nănh êu coong: “Nzâyz wax đomc taih nây phunz yaz.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Nănh êu songx munh stâyv nzac wa mađ cah zâyc ninyh, songđ nzauf pyaz nomz nzu cloon iz tauh byauf, zaub minb staox guungh ninyh, Nănh sâuf hâuđ tuz, songđ watz taih, jaoz nzu căn byauf phunz Nănh wax đomc stayb sây, wax đomc stayb sây songđ nzâyz ninyh patz phunz songx munh. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Songx munh tinyh đoih tuz nhlinc pêu nzuf. Stiz sâub wax đomc nzu yăngc — tuz săpc nyâyc đanz pong. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Wax zanyf, nhlinc nyăngz munh six cox pyaz tinb lanh munh pha, munh nzif cloon munh sây lôx max stunx.<verse eid="MAT 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Nănh songđ coonx yac wax đomc stayb sây buz nzac đangđ ninyh clăngv staox wax nganđ muf đangc Nănh, wax zanyf Nănh êu songx munh phunb đangz muf. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Êu songx munh muf blătc, Nănh staox wa zoongz ninyh cănh lanyc cloo zâu. Tauv nzămc, Nănh ah lanh yămz wa. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Năngx naih wax saz đangđ ninyh tauv wa coiđ stimz songđ zuc womz boomf phatb đangđ wâyc nzaox sâyb phunb đangz. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Wax zanyf, cox pôz săngx huđ tauv joz săngx huđ njâu, Zâu Yê-su yăngh quaix womz minc, ninyh stayb sây buz wa. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Six phătc Zâu Yê-su yăngh womz minc taih, stayb sây buz songđ nyac, yâuc coong: “Lâyc six zuungb,” tăng wa stiz numđ cumh nzav songđ hamv ngatz ngatz têx. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Six Zâu Yê-su coonx bux ănz stiz coong: “Pungx nyâuđ bex! Six yaz lêc. Năngx gâyf cumh nzav!” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Wax zanyf, Pi-tê tauz Zâu Yê-su coong: “Zâu lex, năngđ coong mâyh, joođ phunz yaz yăngh womz minc ninyh mâyh wa.” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Tăng wa Zâu Yê-su coong: “Taih gôh.” Pi-tê songđ setb đangđ taih yăngh womz minc ninyh Zâu Yê-su wa. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Six tauv phătc nzaox nzongf yongb, nănh songđ cumh nzav, yâuc toongx sangf sêmh nzac, nănh coonx hamv êu, coong: “Zâu lex, joođ njâuv yaz!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Toongx wax zanyf, Zâu Yê-su stuungb puf toopz zoz Pi-tê yâuc coong nănh: “Wâyc săngh laix mâyh bix cumh nzav, mâyh zen stimz haiđ tuz nâyx heh?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Wax zanyf stiz japc nzac đangđ ninyh tuz, nzaox songđ tingc nzac. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Yămz wa đangđ nyăngz munh songđ paix bongc Nănh, coong: “Mâyh senz zâyf, Zâu Tênb-Huungh nyăngz toonz gôh.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Stiz clăngv tauv wax nganđ leepb coiđ sinh, songđ zapz ănz wa Gên-nê-sa-lêtx. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Tauv munh saz coong Zâu yê-su, yămz wa nyăngz munh songđ paiđ munh muf bux nzêux yămz stătx wax đomc iz pôz nganc, munh songđ ênz muif lanh săngh gumc munh taih phunz Nănh. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Stiz joođ Nănh phanv phunz stiz tuz lumz tauv Nănh nyăngz guyz saz, tăng wa tinyh phanv laiv lanh lumz tauv yâuc tuz gumc gongx.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Tăng wa, wax đomc Pha-li-si munh cloon nzaox gâyf stênx steengb tăng Yê-lu-sa-lem taih pongh Zâu Yê-su, yâuc coong: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Săngh laix mâyh wax đomc stayb sây bix ayx longđ wax đomc munh côx nyăngz gâyf? Wâyc stiz max đaox puf bix nhlinc nzu.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Six Zâu Yê-su tauz ănz stiz coong: “Săngh laix nyâuh bix wâyc cănh nyăngz munh côx gâyf bix ayx longđ Zâu Tênb-Huungh nyăngz gâyf? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Wâyc Zâu Tênb-Huungh paiđ nâyx đomc gâyf taih, coong: ‘Oix zuc hâuđ lênh mâyh nyăngz nzif pha,’ zef coong ‘laiv lanh mađ zaux nzif max six pha bix tayx wax tauh năngx tayc.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Six nyâuh yâuc coong: ‘Laiv lanh coong ănz nănh nzif max six pha coong: “Phanv yaz naih laiv huungđ hayh stăngc tuz nzif pha, yaz nongc stungx phunz Zâu Tênb-Huungh nzof gôh,”’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />wax tauh munh six max zâuđ hâuđ lênh nănh nyăngz nzif pha. Năngđ nây, nyâuh six quanyf Zâu Tênb-Huungh nyăngz gâyf wâyc nyâuh cănh nyăngz munh côx gâyf. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Pâyc zac nyâuđ yootz nyăngz munh lex! I-sa-ya tâuc taih nyăngz wac senz toix nyâuh nzuf gôh, nănh coong:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Nâyx đomc pec stingx nongc nzetx zanyb Yaz,</para>
  <para style="q1" vid="MAT 15:8">six stiz nyăngz nyâuđ gâyh Yaz côz nzongf.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Nănh stiz canyx bongc Yaz six max setb laiv huungđ,</para>
  <para style="q1" vid="MAT 15:9">wâyc stiz cungb nzaox munh cănh njăpc taih wax đomc gâyf.’”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />Tăng wa Nănh êu songx munh taih, Nănh coong ănz stiz: “Oix zuc mungv yâuc saz: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Max naih laiv huungđ nzac nzetx ninyh bix hayh ayx wâyx ah lanh munh, six laiv huungđ tăng nzetx setb taih, wax huungđ nzăngđ hayh wâyx wax lanh munh.” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Tăng wa, stayb sây buz taih stătx, coong ănz Nănh: “Stayb pha pâyz coong wax đomc Pha-li-si munh numđ nâyx đomc wac blătc stiz numđ peo max?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Six Zâu Yê-su tauz, coong: “Laiv zâyz njăngx bix yaz nyăngz Tênb-toongh Pha max songx six zuc peengz njinh coonz quanyf. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Dluyh stiz gôh! Stiz six yenv jau nyăngz mâyc buđ munh. Bix năngđ coong mâyc buđ munh cănh yenv mâyc buđ munh, six njinh iz lanh zuc tuih nzac cotb nzuf.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Wax zanyf, Pi-tê tauz ănz Zâu Yê-su coong: “Joođ pob manyf wax đomc wac pây phunz buz.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Six Zâu Yê-su coong: “Ayx tuz tauv nâyx zanyf nyâuh bix lauf max saz naz? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Nyâuh max pâyz tuz coong muif huungđ nhlinc nzac nzetx six nzac nyâuđ muf zef ninyh wa đay gof setb ayx queengx haz? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Six laiv huungđ setb nzetx taih six tăng stimz nyâuđ nyâyh setb, wax đomc yâuc hayh ayx phunz wâyx munh. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Wâyc tăng stimz nyâuđ nyâyh wax đomc huđ dlayc setb, tayx munh, văngf munh, ayx pongz lauh, ayx stac, ayx za zanyx manyf cloon coong wax đomc wac pamf. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Nâyx đomc six hayh ayx wâyx munh, six max đaox puf bix nhlinc six max hayh ayx phunz wâyx munh.”<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Tăng wa Nănh ninyh gâyh wax cuyb tinc, Nănh nzac wa Tai-lapx cloon Sai-đôn tâyc muf. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Phanv mangc, naih ah lanh Ca-na-an munh nzif, tăng wax đomc tinc staox taih hamv êu, coong “Zâu lex, Đa-witx nyăngz sây stunz, joođ hâuđ lênh yaz! Yaz nyăngz sab zuc manđ nzac yămz stinb zâuđ nzongf.” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Six Nănh max tauz wax lanh munh nzif Zâux tiny. Wax đomc stayb sây taih stătx Nănh, joođ Nănh coong: “Joođ stayb pha êu wax lanh munh nzif muf gôh, wâyc nănh njinh luh hamv lêpc pănh cah đangz.” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Six Nănh tauz, coong: “Năngđ coong max zâyf wâyc I-sa-la-ên nyăngz pax jiz yuungh ninyh gaih wax đomc, yaz six max tuz paiđ taih.” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Six wax lanh munh nzif, taih quâyc nzac Zâu Yê-su nyăngz cah đangc ninyh, yâuc coong: “Zâu lex, joođ stăngc njâuv yaz.” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Wax zanyf, Zâu Yê-su zef tauz, coong: “Zoz sây nyăngz nzu taih phunz clô jenz nhlinc six max hoođ.” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Six wax lanh munh nzif coong: “Zâu lex, toix gôh, six wâyc wax đomc clô jenz lauf tuz nhlinc tăng stiz nyăngz zâu đah mâyf wax đomc nzu pâyv tuih.” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Wax zanyf, Zâu Yê-su tauz coong ănz wax lanh munh nzif coong: “Ô lex, mâyh nyăngz zen stimz lub nzongf. Âyz mâyh oix nyăngz six tuz ayx săngh phunz mâyh gôh.” Nănh nyăngz sab songđ toongx wax nomz săngx huđ tuz zany gongx.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Ninyh gâyh wax cuyb tinc Zâu Yê-su ninyh tauv Ga-li-lê coiđ sinh, zef staox ah nomz zoongz ninyh, Nănh songđ stâyv wa. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Yâuc naih, wax đomc songx munh đuungx lêpc Nănh staox ninyh, naih munh staux quac, munh mâyc buđ, munh puf staux quac, munh oongx mayv coong wac, cloon đuungx lanh gumc munh. Munh ênz wax đomc munh ninyh tăpx ănz Zâu Yê-su nyăngz staux sinh Nănh yâuc zany gongx phunz stiz, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />ayx tuz munh tinyh đoih nyâyh ganc wâyc phătc munh oongx mayv coong wac yâuc hayh coong wac, munh puf staux quac yâuc tuz gongx, munh staux quac yâuc hayh yăngh cloon mâyc buđ munh yâuc mangc tuz phătc, Tăng wa stiz songđ tanv I-sa-la-ên nyăngz Zâu Tênb-Huungh.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Wax zany, Zâu Yê-su êu Nănh wax đomc stayb sây taih bux coong: “Yaz numđ hâuđ lênh nâyx đomc songx munh, wâyc stiz cloon yaz yămz tuz pôz noib nzof yâuc max naih luungđ nongc nhlinc. Yaz max oix phunz stiz nyâuđ sab phunb đangz, săngx đanyf stiz muf hayh yămh wa bah đamx jau.” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Wax đomc stayb sây coong ănz Nănh: “Yămz nây stâyz phangz blănf bix tăng laiv lov tuz nzu đuungx nâyx taih phunz buz nongc bây peob songx munh hongđ tuz nâyx nhlinc pêu heh?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Zâu Yê-su coong ănz stiz: “Nyâuh naih sax nomz nzu heh?” Stiz tauz: “Nhlic nomz nzu, cloon cay tix tauh byauf jenz.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Tăng wa songđ bux êu songx munh stâyv wa nib minc, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Zâu Yê-su nzauf nhlic nomz nzu cloon wax đomc byauf, sâuf hâuđ tuz, Nănh watz taih jaoz phunz wax đomc stayb sây, tăng wa wax đomc stayb sây nzâyz ninyh patz phunz songx munh. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Songx munh tinyh đoih nhlinc tuz pêu nzuf. Stiz sâub wax đomc nzu yăngc tuz nhlic đanz pong. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Wax zanyf, wax đomc munh nhlinc six pyâyz tinb lanh munh pha, max stunx munh nzif cloon munh sây. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Êu songx munh muf blătc, Nănh nzac đangđ ninyh, muf tauv Ma-ga-đan stâyz phangz.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Wax đomc Pha-li-si cloon Sa-đu-si munh, taih tauv stătx — nongc stâyv Nănh — yâuc joođ Nănh ayx ah cuyb njic hoouđ tăng guungh taih phunz stiz. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Six Zâu Yê-su, tauz coong ănz stiz: [“Tauv cayx nzămc, nyâuh coong: ‘Guungh stib nâyx, guungh đangđ gôh.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Bah đoomz tonx yâuc coong: ‘Guungh stib âuz âuz, six cayx naih bungc nzaox.’ Nyâuh manyf hayh stămđ tuz pâyz guungh nyăngz stêtz, Six yâuc max saz tuz nâyx yenh noib nyăngz dlayc setb.”] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />“Nâyx stâyv nyâuđ huđ cux quaiz nyăngz munh oix mangc ah cuyb njic hoouđ, six max tuz sađ laiv cuyb njic hoouđ phunz, blătc nzuf Yô-na nyăngz njic hoouđ.” Tăng wa Nănh songđ setb ninyh queengx stiz ănz wa.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Six wax đomc stayb sây yâuc nyâuđ cob max nzâyz nzu ninyh, ninyh tauv wax nganđ leepb coiđ stinh. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Wax zanyf, Zâu Yê-su coong ănz stiz: “Oix zuc năngx cayb bôngh wax đomc Pha-li-si cloon Sa-đu-si munh nyăngz piny.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Six, stiz yâuc njinh luh tinyh zenđ coong: “Lâyc six wâyc pănh max nzâyz nzu.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Six pâyz nâyx đomc dlayc, Zâu Yê-su songđ coong: “Nyâuh đomc zen stimz sâub nyăngz munh lex, săngh laix nyâuh bix poc lâyc tinyh zenđ coong tăng nyâuh max naih nzu heh? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Nyâuh lauf max zeengx nyâyh tuz tongb yâuc max săngx tauv pyaz nomz nzuf phunz pyaz tinb lanh munh nhlinc tuz nyâuh zef năngx sâub tuz sax đanz haz? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Max six nhlic nomz nzu phunz pyâyz tinb lanh munh nhlinc tuz, nyâuh bix sâub tuz sax đanz haz? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Ayx săngh laix nyâuh bix max pâyz tuz coong yaz max zâyf coong tauv nzu ănz nyâuh? Six oix zuc bôngh wax đomc Pha-li-si cloon Sa-đu-si munh nyăngz piny.” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Tăng wa stiz songđ pâyz tuz coong Zâu Yê-su max zâyf êu stiz bôngh tauv nzu nyăngz piny, six coong tauv wax đomc Pha-li-si cloon Sa-đu-si munh nyăngz gâyf.<verse eid="MAT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Wax zanyf, stiz ninyh tauv Si-sa-li-ya Phi-lipx-poi dlanyh nib tâyc, Zâu Yê-su naic Nănh wax đomc stayb sây, coong: “Munh coong Bamh Munh six mănv heh?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Tăng wa stiz tauz coong: “Naih ah phanx six coong Yô-hanx Quaix-gâyf; năngx naih ah phanx yâuc coong six Ê-li-ya; ah phanx timb yâuc coong Yê-lê-mi max six ah lanh wax đomc tâuc wac munh.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Nănh naic stiz coong: “Ha nyâuh coong yaz six mănv heh?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Six Si-môn Pi-tê songđ tauz coong: “Stayb pha six Zâu Jix-Tuz, săngh wax tauh Zâu Tênb-Huungh nyăngz toonz.” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Wax zanyf, Zâu Yê-su tauz ănz nănh: “Si-môn Yô-na nyăngz toonz lex, mâyh naih oonz looc gôh, wâyc max zâyf naih a naih samđ nyăngz munh bux phunz mâyh, six Yaz nyăngz cah zâyc Tênb-toongh Pha lêc. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Six yaz lauf coong ănz mâyh coong mâyh six Pi-tê, yămz nâyx nomz njăuz cah zâyc, yaz six njăpc yaz nyăngz jiux pangx, wax đomc yămz pâu jeengh nyăngz jab six max hingh tuz nănh stiz. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Yaz jaoz wax đomc Tênb-toongh côkz nyăngz ja zâyh phunz mâyh, tinyh phanv laiv huungđ mâyh stayb yămz nây bamh canz six lauf tuz stayb yămz wa cah zâyc Tênb-toongh, tinyh phanv laiv huungđ mâyh pungx yămz nây bamh canz six lauf tuz pungx yămz wa cah zâyc Tênb-toongh.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Tăng wa, Nănh zăpx wax đomc stayb sây max phunz stiz coong ănz mănv coong Nănh six Zâu Jix-Tuz.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Tăng wa staox ninyh, Zâu Yê-su Jix-Tuz quef coonz phunz Nănh wax đomc stayb sây pâyz coong Nănh six zuc ninyh tauv Yê-lu-sa-lem, yâuc zuc tanyđ đuungx huungđ zâuđ tăng wax đomc munh côx, cloon wax đomc stayb munh, cloon wax đomc nzaox gâyf stênx steengb, yâuc zuc tayx tayc tauv wax noib pôz zef năngx tuz săngh taih. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Six Pi-tê tăkc Zâu Yê-su quaix ah leepb ninyh, songđ coong Nănh: “Zâu lex, Zâu Tênb-Huungh cănh nyangc phunz mâyh. Wax đomc dlayc six max zâuđ setb taih phunz mâyh.” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Six Zâu Yê-su winb lauf coong ănz Pi-tê: “Sax-tanx lex, oix zuc tiuv quaix yaz cah đangz ninyh gôh! Mâyh six ah nomz njauz ayx phunz yaz zuc tib, wâyc mâyh max nyâyh tauv Zâu Tênb-Huungh nyăngz zux ix, cungb nyâyh bamh munh nyăngz zux ix cuungv.” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Tăng wa, Zâu Yê-su coong ănz nănh wax đomc stayb sây: “Năngđ coong laiv lanh oix lêpc yaz đangz ninyh, wax lanh six zuc quanyf cănh nyăngz stinb, yâuc đamz cănh nyăngz săpc đăngc zax bix lêpc yaz ninyh. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Wâyc tinyh phanv laiv lanh oix zâuh cănh nyăngz meengc six zuc stâyb meengc, six laiv lanh munh wâyc yaz bix quanyf nănh nyăngz meengc six tuz meengc săngh. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Wâyc năngđ coong ah lanh munh tuz nzuf bamh canz, six zuc stâyb nănh nyăngz meengc bix tuz laiv luungđ gongx heh? Wax lanh munh six cayx nzâyz laiv luungđ taih wănc tuz nănh nyăngz meengc lauf heh? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Wâyc Bamh Munh six yămz Nănh nyăngz Pha nyăngz gwăngz eeng cloon Nănh wax đomc stinz munh nzac taih. Tauv wax zanyf, Nănh six âyz mănv ayx mănv nyăngz dlayc clao phunz. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Yaz coong senz bux nyâuh naih ah phanx munh năngx jinh đangh stâuđ nây, naih ah phanx six max zeengx tayc tuz tauv laiv zanyf stiz phătc Bamh Munh yămz Nănh nyăngz côkz taih.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Joz noib cah đangz, Zâu Yê-su ênz Pi-tê cloon Nănh nyăngz yâuf Ya-coopc cloon Yô-hanx, Nănh lanyc ênz stiz lêpc staox ninyh tauv ah nomz zoongz njăngb. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Zâu Yê-su nyăngz stinb sangc pyênv wav toongx stiz nyăngz cah đangc, Nănh nyăngz minb yâuc gwăngz cayx năngđ bah noib, Nănh nyăngz guyz yâuc pec nzomz staox taih năngđ gwăngz eeng. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Six phanv mangc, Mô-sê cloon Ê-li-ya hinđ setb taih yămz stiz cah đangc cloon Zâu Yê-su coong wac. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Wax zanyf, Pi-tê songđ coong ănz Zâu Yê-su: “Zâu lex pănh yămz nây senz gongx nzongf. Năngđ coong stayb pha oix, yaz six ayx pôz sênz njiuh ănz nây — ah sênz phunz stayb pha, ah sênz phunz Mô-sê, cloon ah sênz phunz Ê-li-ya.” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Nănh năngx jinh coong wac wax zanyf, six phanv mangc, naih ah tungđ vănx pec taih sêmz stiz, phanv mungv, naih ah zâux wac yămz wa vănx, coong: “Nây six Yaz stăngz nyăngz Toonz, Yaz senz numđ nyađ nâyx tauh sây. Oix zuc mungv Nănh bex.” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Numđ wax zanyf, wax đomc stayb sây songđ glinyf buc wa yâuc cumh nzav nzongf. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Tăng wa Zâu Yê-su songđ taih stătx lumz stiz, yâuc coong: “Nyoongz quef gôh, năngx gâyf cumh nzav.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Six tauv stiz cany pyây mangc wax zanyf, stiz max phătc naih mănv cungb naih Zâu Yê-su ah lanh.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Stiz tăng wa zoongz nzac lauf wax zanyf, Zâu Yê-su setb lanyf zăpx stiz, coong: “Năngx gâyf lănv nyâuh phătc nyăngz ănz mănv zu tauv laiv zanyf Bamh Munh tăng tayc ninyh tuz săngh taih blătc.” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Wax đomc stayb sây naic Nănh, coong: “Ha săngh laix wax đomc nzaox gâyf stênx steengb, coong six Ê-li-ya oix zuc taih đangc heh?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Wax zanyf, Zâu Yê-su tauz, coong: “Manyf senz Ê-li-ya zuc taih đangc bênc săngh muif huungđ. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Six yaz bux ănz nyâuh coong Ê-li-ya taih nzof gôh, six stiz max saz tuz nănh. Plănc taih, stiz âyz stimz ayx muif huungđ huđ ănz nănh. Lauf tinyh năngđ, Bamh Munh six cayx zuc tanyđ zâuđ tăng stiz.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Wax zanyf, wax đomc stayb sây songđ pâyz coong Zâu Yê-su coong tauv Yô-hanx Quaix-gâyf ănz stiz.<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Lauf tauv songx munh wa wax zanyf, naih ah lanh munh pha taih tauv stătx Zâu Yê-su, quâyc nzac Nănh nyăngz cah đangc ninyh <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />yâuc coong: “Zâu lex, joođ hâuđ lênh yaz nyăngz toonz, wâyc nănh săngh tungf nyâyf gumc niđ nzongf, nănh hayh glinyf nzac tâuf ninyh, yâuc hayh glinyf nzac womz. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Yaz ênz nănh taih phunz Mâyh nyăngz stayb sây buz, six stiz max hayh zany gongx phunz nănh.” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Wax zanyf, Zâu Yê-su tauz coong: “Nâyx stâyv max zen yâuc cux quaiz nyăngz munh lex, yaz cayx căn nyâuh yămz tuz tauv laiv zanyf? Cayx nyangc nyâuh tuz tauv laiv zanyf heh? Ênz wax lanh sây taih nây phunz yaz.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Zâu Yê-su mađ manđ, manđ songđ setb gâyh wax lanh toonz jenz, nănh yâuc toongx wax nomz săngx huđ tuz zany gongx.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Tăng wa, stayb sây buz cănh lanyc taih cloon Zâu yê-su, naic coong: “Wâyc săngh laix buz bix max luiđ tuz manđ setb heh?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Tăng wa Nănh coong ănz stiz: “Wâyc nyâuh nyăngz zen stimz sâub yongb. Yaz coong senz bux nyâuh, năngđ coong nyâuh naih zen stimz lomc ah nomz njayz jaix nhlimb, nyâuh six setb lanyf êu nâyx nomz zoongz: ‘Oix zuc stuyđ nâyx cuyb tinc quaix wa ninyh,’ nănh six stuyđ ninyh, yâuc max naih laiv huungđ coong nyâuh bix mayv ayx.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Six nâyx huungđ manđ năngđ coong max zâyf njif nhlinc cloo Zâu six max hayh luiđ tuz setb.]<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Wax zany, stiz jinh đangh căpx dlonf yămz Ga-li-lê, Zâu Yê-su coong ănz stiz: “Bamh Munh cayx zuc zoz jaoz phunz munh nyăngz puf, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />stiz six tayx Nănh tayc, six tauv wax noib pôz Nănh zef năngx tuz săngh taih.” Wax đomc stayb sây buz songđ taux wa numđ stauh.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Wax zanyf, stiz ninyh tauv Ca-bê-na-um dlanyh, Yămz bongc Zâu Tênb-Huungh nyăngz pyau wax đomc sâub sôiv munh taih naic Pi-tê, coong: “Mâyh nyăngz stayb pha max setb sôiv nyanh ănz bongc Zâu Tênb-Huungh nyăngz pyau haz?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Pi-tê coong: “Setb lêc.” Tauv nzac pyau njaf ninyh, Zâu Yê-su naic ănz nănh quaix đangc, coong: “Si-môn lex, mâyh nyâyh ayx laix heh? Nây bamh canz nyăngz huungh tăng mănv zoz sôiv nyanh? Tăng stiz nyăngz sây max six tăng cungh ngwaic munh heh?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Nănh tauz: “Tăng cungh ngwaic munh”, Zâu Yê-su coong ănz nănh: “Năngđ nâyx sây six max zuc setb. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Six pănh max oix ayx phunz stiz longđ, mâyh bix ninyh wa coiđ, ănz tiux tekb tuz zetx tauh byauf. Mâyh bix watz byauf nzetx taih, cănh phătc ah leepz nyanh pec. Zoz tuz wax leepz nyanh, bix nzâyz ninyh setb phunz stiz caux yaz cloon mâyh nyăngz phănc.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Toongx wax zanyf, wax đomc stayb sây buz taih stătx zâu Yê-su, naic coong: “Tauv yămz Tênb-toongh côkz six mănv năngx lub têx heh?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Tăng wa Zâu Yê-su êu ah lanh munh sây taih, Nănh phunz wax tauh sây yămz stiz mungh tongx <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />yâuc coong: “Yaz coong senz bux nyâuh, năngđ coong nyâuh max coi wănc cayx năngđ ah lanh munh sây, nyâuh six senz max tuz ninyh nzac Tênb-toongh côkz. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Wâyc nây, tinyh phanv laiv lanh nhlimc cănh ayx jenz cayx năngđ nâyx lanh munh sây, yămz wa Tênb-toongh côkz wax lanh six năngx lub têx. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Năngđ coong laiv lanh tim yaz nyăngz manyh stipx ah lanh munh sây năngđ nâyx lanh nâyx, wax lanh six stipx yaz. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Six laiv lanh ayx phunz nâyx đomc ah lanh munh sây jenz longđ, six zen yaz wax đomc, wax lanh munh six jic tuz điux ah nomz njăuz mac lub ănz nănh nyăngz clangz, yâuc pungx sêmh nzac coiđ stimz ninyh.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Bamh canz zuc zâuđ gôh wâyc naih wax đomc ayx phunz pamf stoif nyăngz jau! Wâyc zuc ayx phunz pamf stoif nyăngz jau stong oix naih, six, laiv lanh coib jau ayx phunz munh pamf stoif senz zuc zâuđ gôh! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Max six, năngđ coong nyâuh nyăngz puf max six staux ayx phunz nyâuh pamf stoif, oix zuc zăm nănh quanyf queengx gâyh nyâuh. Nyâuh puf gutc max six staux gutc bix tuz nzac stâyv quâyx săngh nyăngz tinc six năngx gongx têx naih iz saz puf max six iz saz staux bix zuc quanyf ănz wa tâuf coiđ banc stâyv banc đaic. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Năngđ coong nyâuh nyăngz mâyc ayx phunz nyâuh pamf stoif, bix ngwâyz nănh quanyf queengx năngx gâyh nyâuh. Nyâuh cungb naih ah nomz mâyc bix tuz nzac stâyv quâyx săngh nyăngz tinc six năngx gongx têx, naih iz nomz mâyc bix zuc quanyf nzac tâuf coiđ. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />Nyâuh oix zuc năngx cayb bôngh, năngx gâyf mangc stam laiv lanh nâyx đomc munh sây jenz. Yaz coong bux ănz nyâuh, stiz nyăngz wax đomc stinz munh yămz cah zâyc guungh muif dlih phătc yaz nyăngz Pha yămz wa cah zâyc Tênb-toongh. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Wâyc Bamh Munh taih six nongc njâuv ninyh gaih nyăngz munh.] <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Nyâuh nyâyh mungv jađ? Năngđ coong ah lanh munh naih ah pez tauh pax jiz yuungh, bix ah tauh ninyh gaih, nănh six max zâyf ănz zu săpc zu tauh ănz wa zoongz, bix setb ninyh lov wax tauh pax jiz yuungh ninyh gaih haz? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Năngđ coong wax lanh munh lov tuz pongh wax tauh ninyh gaih, yaz coong senz, bux nyâuh, wax lanh munh six nyađ wax tauh ninyh gaih năngx nzongf têx wa zu săpc zu tauh max ninyh gaih. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Lauf tinyh năngđ, nyâuh nyăngz cah zâyc Tênb-toongh Pha nyăngz âyx lauf max oix nongc laiv lanh nâyx đomc munh sây jenz zuc gaih ninyh.<verse eid="MAT 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Zef, năngđ coong nyâuh nyăngz yâuf pez ô stayx naih tix lanh ayx longđ ănz nyâuh, oix zuc cănh ninyh cloon nănh coong bux ănz nănh cuungv. Năngđ coong nănh mungv nyâuh, nyâuh six năngx tuz nyâuh nyăngz yâuf pez lauf. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Six năngđ coong nănh max mungv nyâuh, bix ênz ah lanh max six iz lanh ninyh timb, wâyc tăng iz max six pôz lanh munh nyăngz nzetx ayx zanyx manyf wac six năngx toix têx. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Six năngđ coong wax lanh munh lauf aox max mungv stiz, bix taih coong phunz jiux pangx, năngđ coong wax lanh munh lauf max mungv jiux pangx, nyâuh bix stunx wax lanh munh, nănh six năngđ max zen nyăngz munh cloon sâub sôiv munh. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Yaz coong senz, bux nyâuh, max cun nyâuh stayb laiv huungđ yămz nây bamh canz, wax huungđ six lauf zuc stayb yămz wa cah zâyc guungh; zef năngđ coong nyâuh pungx max cun laiv huungđ yămz nây bamh canz, six wax huungđ lauf tuz pungx yămz wa cah zâyc guungh. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Ah hâyđ timb, yaz coong senz bux nyâuh coong năngđ coong yămz nyâuh naih iz lanh munh hoopđ stimz tongh âyx yămz nây bamh canz max cun stiz joođ laiv huungđ, wax huungđ six tuz yaz nyăngz cah zâyc Tênb-toongh Pha ayx săngh phunz stiz. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Wâyc laiv nomz tinc naih iz max six pôz lanh munh tim yaz nyăngz bux căpx dlonf, yaz six yămz stiz wa mungh tongx.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Tăng wa, Pi-tê taih tauv stătx, naic Zâu Yê-su: “Zâu lex, yaz năngđ naih ah lanh yâuf pez ayx longđ ănz yaz, yaz six quanyf phunz nănh sax hâyđ heh? Tauv nhlic hâyđ tuz max?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Zâu Yê-su coong ănz nănh: “Yaz max zâyf coong ănz mâyh tauv nhlic hâyđ cuungv, six jetb săpc nyăngz nhlic hâyđ. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Wâyc năngđ nâyx, Tênb-toongh côkz six lauf pây cayx năngđ ah tauh huungh nâyx, nănh songđ oix ayx năngx soongb nănh nyăngz zaix tanz cloon nănh wax đomc pâuz. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Wax zanyf, huungh ah yac stunx zaix tanz, munh ênz ah lanh sămv huungh săpc tinb panc zaix taih phunz huungh. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Six wax lanh munh max naih luungđ nongc clao, huungh songđ êu nănh zuc maic au sây cloon nănh naih nyăngz muif huungđ jax toongx, nongc clao zaix. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Naz wax lanh pâuz songđ glinyf wa nib. Quâyc nzac huungh nyăngz cah đangc ninyh, coong: ‘Zâu lex, joođ mâyh nyangc phunz yaz, yaz cănh clao mâyh năngx soongb nzuf.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Tăng wa, wax tauh pâuz nyăngz zâu numđ hâuđ lênh, songđ quanyf zaix phunz nănh yâuc pungx nănh muf. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Six tauv setb cungh ngwaic ninyh, wax tauh pâuz pongh ah lanh cloon nănh ayx pâu wax đomc munh, wax lanh munh sămv nănh ah pez panc nyanh, nănh toopz wax lanh munh taih, neeng clangz, yâuc coong: ‘Mâyh sămv yaz zaix bix clao zef gôh.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Tăng wa, waz lanh munh songđ quâyc nzac, jab joođ nănh, coong: ‘joođ mâyh nyangc phunz yaz, yaz cănh clao phunz mâyh.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Six nănh max mungv. Nănh zef năngx zoz wax lanh munh, ênz ninyh ănz nzauh, zu tauv laiv zanyf nănh clao zaix soongb nzuf. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Six, phătc nâyx đomc dlayc setb taih, wax đomc lêpc nănh ayx pâuz nyăngz munh numđ munz stimz. Songđ ninyh lănv wax đomc muif huungđ dlayc setb taih bux ănz stiz nyăngz zâu. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Tăng wa, wax lanh pâuz nyăngz zâu êu wax lanh pâuz taih, coong ănz nănh: ‘Mâyh okx nzongf nyăngz pâuz lex, yaz quanyf nzuf zaix phunz mâyh wâyc mâyh jab joođ yaz. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Mâyh max zâyf lauf hoopđ zuc hâuđ lênh ayx naz phunz mâyh nyăngz pâuz toic, cayx năngđ yaz hâuđ lênh mâyh nâyx haz?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Nănh nyăngz zâu numđ nhlenx nzongf, songđ jaoz nănh phunz cun nzauh munh tuz tauv laiv zanyf nănh clao zaix soongb nzuf. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Yaz nyăngz Tênb-toongh Pha six lauf ayx năngđ nâyx ănz nyâuh, năngđ coong nyâuh laiv lanh max naih stimz nyâuđ quanyf stoif phunz nyâuh nyăngz yâuf pez.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Zâu Yê-su coong wax đomc wac soongb, Nănh ninyh gâyh Ga-li-lê yâuc ninyh tauv Yu-đê stâyz phangz yămz wax nganđ leepb Njoh-đen wăngx. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Wax đomc songx munh đuungx lêpc Nănh Nănh yâuc yămz wa zany gumc phunz stiz.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Naih ah đomc Pha-li-si munh taih stătx Zâu Yê-su, yâuc zangđ naic Nănh coong: “Max cun wâyc laiv huungđ phunz ah lanh munh pha queengx nănh nyăngz au hoopđ max hoopđ heh?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Six Zâu Yê-su tauz, coong: “Nyâuh max zeengx toc quaix, Zâu Tênb-Huungh tăng quef coonz zuyx guungh zuyx nib yâuc zuyx tah yetx toix munh, ah lanh munh toonz cloon ah lanh munh sab, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />yâuc coong: ‘Wâyc năngđ nây, munh toonz six zuc gâyh nzif pha bix cloon nănh nyăngz au songc tinc yămz, stiz iz lanh six săngh ah nomz stinb’ nâyx haz? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Năngđ nâyx, stiz six max năngx zâyf iz, six cungb ah nomz stinb cuungv. Wâyc nây, laiv huungđ Zâu Tênb-Huungh căpx taih, bamh munh six max tuz zeb gâyh.” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Stiz coong ănz Nănh: “Ha, săngh laix Mô-sê bix coong zuc ja ah zây gâyh stayb sâub mănc queengx au heh?” <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Nănh tauz stiz coong: “Six wâyc nyâuh nyăngz nyâuđ nhlengc Mô-sê nzăngđ phunz nyâuh queengx au, six tăng quef coonz, nâyx đomc jau six max zâyf năngđ nâyx. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Six yaz coong bux ănz nyâuh coong blătc pongz lauh nyăngz stoif, laiv lanh munh queengx nănh nyăngz au bix ninyh zoz pitc lanh six longđ văngf munh nyăngz stoif; laiv lanh zoz zuc queengx wax lanh au six lauf longđ văngf munh nyăngz stoif.” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Wax đomc stayb sây coong ănz Zâu Yê-su: “Năngđ coong munh pha zoz au bix ayx năngđ nâyx, bâyf nođ max zoongz pyau lêc.” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Six Nănh tauz ănz stiz: “Max zâyf muif lanh hayh âyz tuz nâyx đomc wac, six cungb wax đomc munh tuz sađ phunz nzăngđ âyz tuz. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Wâyc naih ah phanx munh max zoongz pyau, six wax đomc munh tăng yămz nzif nyăngz nyâuđ njaf steengb taih bix cănh nâyx; naih ah phanx munh max zoongz pyau wâyc zuc munh imz; yâuc naih ah phanx munh wâyc Tênb-toongh côkz bix cănh max zoongz pyau. Laiv lanh hayh âyz tuz nâyx đomc wac wax lanh oix zuc âyz gôh.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Tăng wa, munh ênz wax đomc munh sây jenz taih phunz Nănh oix Nănh tăpx puf ănz stiz cloo zâu, six stayb sây buz coong mađ stiz. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Six, Zâu Yê-su coong: “Oix zuc phunz munh sây jenz taih lov yaz, yâuc năngx gâyf cangđ stiz, wâyc Tênb-toongh côkz six săngh wax đomc munh năngđ nâyx đomc munh sây nâyx nyăngz.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Tăng wa Nănh tăpx puf ănz stiz tuz, songđ setb jau ninyh.<verse eid="MAT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Six phanv mangc, naih ah lanh munh taih stătx Nănh, yâuc coong: “Stênx steengb lex, yaz zuc ayx laiv huungđ cumh pâuz gongx nzăngđ tuz stâyv quâyx nyăngz meengc heh?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Nănh songđ tauz wax lanh munh: “Săngh laix mâyh bix naic yaz tauv cumh pâuz gongx? Cungb naih ah Tauh gongx cuungv, Năngđ coong mâyh oix tuz stâyv quâyx nyăngz meengc, six zuc âyz wax đomc gâyf njanh ayx.” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Wax lanh munh naic Zâu Yê-su coong: “Laiv đomc gâyf njanh heh?” Zâu Yê-su coong: “Năngx gâyf tayx munh, năngx gâyf longđ pongz lauh stoif, năngx gâyf ayx stac, năngx gâyf ayx za zanyx manyf, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Oix zuc hâuđ lênh nzif pha, yâuc stăngz mâyh nyăngz cah sinh munh năngđ cănh nyăngz stinb nâyx.” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Wax lanh munh gunx tauz Nănh coong: “Yaz âyz nzuf wax đomc nzof gôh. Yaz năngx sămv luungđ timb heh?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Six Zâu Yê-su coong ănz nănh: “Năngđ coong mâyh oix tuz clăkx clunh, oix zuc muf maic mâyh naih nyăngz jax toongx bix ninyh stăngc phunz munh zâuđ munh, mâyh six naih jax dlaih yămz wa Tênb-toongh; bix taih lêpc yaz gôh!” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Six numđ wax đomc wac blătc, wax lanh munh gunx munh songđ numđ stauh bix muf, wâyc nănh naih jax toongx đuungx nzongf.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Wax zanyf, Zâu Yê-su coong ănz Nănh wax đomc stayb sây: “Yaz coong senz, bux nyâuh: Puv quâyx munh nzac Tênb-toongh côkz six zâuđ nzongf. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Yaz yâuc oix coong bux nyâuh, phunz maf loh plunx quaix stimb bluyc six năngx hâyđ têx pây puv quâyx munh nzac Zâu Tênb-Huungh nyăngz côkz.” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Wax zanyf, numđ nâyx đomc wac, wax đomc stayb sây numđ nyâyh ganc, songđ coong: “Ha nâyx bix naih mănv hayh tuz njâuv heh?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Mangc stiz, Zâu Yê-su songđ coong ănz stiz: “Bamh munh six max hayh ayx tuz nâyx đomc, six muif huungđ Zâu Tênb-Huungh hayh ayx tuz.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Wax zanyf, Pi-tê tauz Zâu Yê-su naic coong: “Stayb pha, mangc jađ, buz quanyf nzuf muif huungđ bix lêpc stayb pha. Năngđ nâyx buz six tuz luungđ heh?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Tăng wa Zâu Yê-su coong ănz stiz: “Yaz coong senz, bux nyâuh coong, nyâuh lêpc yaz nyăngz munh, tauv wănc săngb nzêuh, six Bamh Munh taih stâyv yămz Nănh nyăngz gwăngz eeng tinc wax zanyf, nyâuh lauf tuz stâyv yămz săpc nyâyc nomz tinc nongc stămđ săpc nyâyc stingx I-sa-la-ên munh. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Muif lanh munh, tinyh phanv laiv lanh quanyf pyau, quanyf Yâuf pez, ô stayx, nzif, pha, au, sây max six njăngx njingh wâyc yaz nyăngz manyh, six tuz stipx clăpb ah pez phănc yâuc tuz stâyv quâyx nyăngz meengc. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Six naih đuungx lanh ayx lub six zuc ayx jenz, zef wax đomc ayx jenz six tuz ayx lub.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Wâyc Tênb-toongh côkz six pây năngđ ah lanh nib zâu, Bah đoomz tonx njâu nănh setb ninyh lov munh taih nongc câux ayx nănh nyăngz tungh cuđ lauđ winb. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Wax zanyf, căn wax đomc munh coong soongb ah noib coong six buc laiv nyanh, nănh songđ êu stiz ninyh nănh nyăngz tungh cuđ lauđ winb. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Six zef tauv cox đuh săngx huđ, nib zâu setb ninyh phătc ah đomc munh stâuđ wa caiz sangc max naih luungđ ayx. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Nănh coong ănz stiz: ‘Nyâuh lauf oix zuc ninyh yaz wa tungh cuđ lauđ winb ayx cumh pâuz, hoopđ zuc phunz buc laiv zax yaz six cănh phunz nyâuh.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Tăng wa stiz songđ ninyh. Zef tauv cox săpc nyâyc săngx huđ cloon cayx nzămc pôz săngx huđ, nănh setb ninyh lauf tinyh năngđ lov munh ayx nâyx. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Tăng wa, tauv cayx nzămc pyaz săngx huđ, nănh zef setb ninyh phătc naih ah đomc munh jinh đangh stâuđ wa, nănh coong ănz stiz: ‘Săngh laix nyâuh bix hênh stâuđ yămz nây quaix noib heh?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Stiz tauz ănz nănh: ‘Wâyc max naih mănv câux buz.’ Nănh coong ănz stiz: ‘Nyâuh bix ninyh yaz nyăngz tungh cuđ lauđ winb.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Tauv nzămc, tungh cuđ lauđ winb zâu êu nănh nyăngz cun cumh pâuz munh: ‘Ninyh êu wax đomc congz munh taih bix phunz congz nyanh stiz, stiz songđ tăng wax đomc ninyh đangz phunz tauv wax đomc ninyh đangc.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Tăng pyaz săngx huđ câux wax đomc muif lanh staox taih zoz tuz ah noib nyăngz congz nyanh. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Tauv wax đomc taih ayx congz đangc, staox taih, nyâyh coong stiz bâyf tuz nyanh năngx đuungx têx, six stiz muif lanh lauf cungb tuz ah noib nyăngz congz nyanh. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Six tauv zoz nyanh, stiz yônx wax lanh nib zâu, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />coong: ‘Wax đomc munh taih đangz cungb ayx ah săngx huđ cumh pâuz, zâu bix phunz stiz cloon buz tuz tinyh buc, buz ayx zâuđ quaix noib yâuc zuc njah toc phaib.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Six nib zâu tauz ănz stiz ah lanh: ‘Lah pyeoz lex, yaz max zâyf ayx huđ ănz nyâuh. Ha max zâyf yaz cloon nyâuh coong soongb ah noib nyăngz congz nyanh nzof haz? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Oix zuc stipx mâyh nyăngz phănc bix muf gôh. Six yaz oix phunz nâyx đomc munh taih đangz lauf cayx năngđ phunz nyâuh nâyx. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Yaz bix max tuz dluyh stimz nongc yaz nyăngz nyanh mah? Max six mâyh nyăngz mâyc phătc yaz ayx gongx nyăngz jau bix numđ mangc max tuz heh?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Lauf tinyh năngđ, munh taih đangz six tuz yămz đangc, nzof munh taih đangc six zuc yămz đangz.”<verse eid="MAT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Jinh đangh ninyh Yê-lu-sa-lem dlanyh, Zâu Yê-su lanyc ênz săpc nyâyc lanh stayb sây lêpc Nănh, ninyh tauv bah đamx jau, Nănh coong ănz stiz: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Mangc jađ pănh jinh đangh huungv ninyh Yê-lu-sa-lem, Bamh Munh six zuc jaoz phunz wax đomc stayb munh cloon nzaox gâyf stênx steengb, tăng wa stiz songđ tingc tayx Nănh <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Yâuc jaoz Nănh phunz pitc stingx munh nongc pib mađ, yâuc bopc Nănh, yâuc tingz Nănh ănz wa săpc đăngc zax. Six tauv wax noib pôz, Nănh six săngh taih.”<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Wax zanyf, Sê-bê-đi iz lanh toonz nyăngz nzif ênz nănh wax đomc sây taih pongh Zâu Yê-su, paix Nănh yâuc joođ Nănh ah huungđ. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Tăng wa Nănh naic wax tauh munh nzif: “Mâyh oix nongc luungđ heh?” Tauh munh nzif tauz ănz Nănh: “Joođ phunz yaz nây iz lanh toonz, ah lanh stâyv yămz mâyh byaoh phanx, ah lanh stâyv yămz Mâyh staix phanx, yămz Mâyh nyăngz côkz.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Six Zâu Yê-su tauz coong: “Nyâuh pôz lanh max pâyz tuz nyâuh joođ luungđ. Nyâuh iz yâuf pez hayh hopb tuz yaz cayx hopb nyăngz zan max?” Stiz tauz ănz Nănh: “Buz hopb tuz lêc.” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Nănh coong ănz stiz: “Nyâuh six zuc hopb yaz nyăngz zan, six stâyv yămz yaz nyăngz byaoh phanx max six staix phanx six max zâyf yaz cănh hayh phunz, six yaz nyăngz Pha cănh bênc săngh phunz.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Mungv numđ nâyx đomc wac, wa săpc lanh stayb sây numđ nhlenx wa iz lanh yâuf pez. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Six Zâu Yê-su êu stiz taih songđ coong: “Nyâuh pâyz coong wax đomc bamh canz nyăngz huungh six njic nyenh mănh buc stiz, nzof wax đomc ayx quanz lub six nongc lanyf zâyc nyenh mănh. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Nyâuh six max năngđ nâyx. Six plănc taih, năngđ coong laiv lanh oix tuz ayx lub yămz nyâuh cah njaf, wax lanh six zuc ayx nyâuh nyăngz nâuh, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />zef laiv lanh oix tuz ayx pyây yămz nyâuh cah njaf, six zuc ayx nyâuh nyăngz pâuz, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />njinh Bamh Munh lauf max zâyf taih nongc tuz munh bokc dlic, six nongc bokc dlic munh, Yâuc sađ Nănh meengc nongc suc tayv phunz munh đuungx.”<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Stiz tăng Yê-li-cô dlanyh setb ninyh wax zanyf, naih ah peob songx munh hongđ ninyh lêpc Nănh. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Phanv mangc, naih iz lanh mâyc buđ munh jinh đangh stâyv yămz wa jau sinh. Numđ coong Zâu Yê-su ninyh pitb wa, stiz songđ hamv, coong: “Zâu lex, Đa-witx huungh nyăngz sây stunz, joođ hâuđ lênh buz.” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Six songx munh mađ stiz coong, năngx gâyf nyaoc, six stiz zef hamv năngx lub têx, coong: “Zâu lex, Đa-witx huungh nyăngz sây stunz, joođ hâuđ lênh buz.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Zâu yê-su yămf wa songđ êu stiz taih yâuc naic coong: “Nyâuh oix nongc yaz ayx luungđ phunz nyâuh heh?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Stiz songđ coong ănz Nănh: “Zâu lex, joođ phunz buz nyăngz mâyc tuz phătc jau.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Wax zanyf, Zâu Yê-su numđ hâuđ lênh stiz, songđ lumz stiz nyăngz mâyc. Tongx sangf, stiz tuz phătc jau yâuc lêpc Nănh ninyh.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Ninyh stătx Yê-lu-sa-lem dlanyh wax zanyf, ninyh tauv Bêtc-pha-yi, huungv ninyh Ca-lan zoongz wax zanyf Zâu Yê-su paiđ iz lanh stayb sây, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />bux stiz: “Oix zuc nzac nyâuh lâyc cah đangc tiuh njăngv ninyh, nyâuh cănh phătc ah tauh maf li nyâyf pang ănz wa, cloon ah tauh maf li jenz yămz wa. Oix zuc zay langb, ênz taih phunz yaz. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Năngđ coong naih munh naic nyâuh, nyâuh bix coong: ‘Zâu sămv zuc nongc stiz,’ wax tau munh cănh phunz stiz ninyh.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Wâyc nây, nâyx đomc dlayc setb taih six nongc phunz toix nzuf tâuc wac munh coong quaix nyăngz wac, coong:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Oix zuc bux Si-ôn nyăngz munh sab coong:</para>
  <para style="q1" vid="MAT 21:5">‘Phanv mangc, nyâuh nyăngz Huungh taih tauv nyâuh wa,</para>
  <para style="q1" vid="MAT 21:5">dlênb dlênc zâyh maf li taih,</para>
  <para style="q1" vid="MAT 21:5">— six zâyh yămz ah tauh, maf li nyâyf nyăngz jenz.’”<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Wax zanyf stayb sây buz ninyh yâuc ayx âyz năngđ Zâu Yê-su bux stiz nyăngz wac, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />songđ ênz maf li nyâyf cloon maf li jenz lauf, yâuc pâyb stiz nyăngz guyz đao ănz maf li cah tănf, songđ phunz Zâu Yê-su zâyh wa cah zâyc. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Wax zanyf, naih đuungx lanh songx munh pâub stiz nyăngz guyz đao ănz wa jau, naih ah phanx yâuc pătb wax đomc njăngx quah pâub ănz wa jau. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Tăng wa, wax đomc songx munh ninyh đangc Nănh cloon lêpc đangz wax đomc hamv lub, coong:</para>
  <para style="q1" vid="MAT 21:9">“Hô-sa-na Đa-witx huungh nyăngz sây stunz!</para>
  <para style="q1" vid="MAT 21:9">Tanv yămz Zâu nyăngz bux taih wax Tauh!</para>
  <para style="q1" vid="MAT 21:9">Hô-sa-na yămz njăngb quaix nyăngz tinc!”<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Tauv Nănh nzac wa Yê-lu-sa-lem dlanyh ninyh, lomc ah nomz dlanyh lunc nginyz nginyz têx, coong: “Lâyc six mănv heh?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Tăng wa songx munh tauz: “Nây six tâuc wac munh Yê-su yămz Na-sa-leetx, Ga-li-lê stâyz phangz.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Zâu Yê-su ninyh nzac bongc Zâu Tênb-Huungh nyăngz pyau, tăng wa Nănh luiđ nzuf wax đomc munh maif maic yămz wa pyau njaf, yâuc njăpc sađ wax đomc munh wănc nyanh nyăngz đah mâyf cloon wax đomc maic nooc bah côz munh nyăngz tăngx. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Nănh coong ănz stiz: “Naih wac ja coong: ‘Yaz nyăngz pyau six six tuz hipđ ayx cloo Zâu nyăngz pyau,’ six nyâuh yâuc ayx phunz nănh pênx stac jomh.” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Six wax đomc munh mâyc buđ cloon munh quac taih stătx Nănh yămz bongc Zâu Tênb-Huungh nyăngz pyau, Nănh yâuc zany gongx phunz stiz. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Six wax đomc stayb munh cloon wax đomc nzaox gâyf stênx steengb, phătc Nănh ayx wax đomc jix caox njingc nyăngz dlayc, yâuc numđ wax đomc munh sây yămz wa bongc Zâu Tênb-Huungh nyăngz pyau hamv lub coong: “Hô-sa-na Đa-witx huungh nyăngz sây stunz,” stiz songđ numđ nhlenx. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Stiz coong ănz Nănh: “Mâyh numđ stiz coong luungđ max?” Six Zâu Yê-su tauz stiz: “Numđ! Nyâuh max zeengx toc quaix coong: ‘Zâu Bênc săngh tăng munh sây jenz cloon năngx jinh hopb nu nyăngz munh sây nyăngz nzetx nongc tanv,’ naz haz?” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Nănh tiuv gâyh stiz, songđ setb dlanyh taih ninyh tauv Bê-ta-ni njăngv songđ phâyx wa ah munf.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Tauv guungh gwăngz, jinh đangh nzac wa dlanyh muf wax zanyf, Nănh songđ nyâuđ sab. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Phătc ah zâyz bănx tauh njăngx yămz wa jau sinh, Nănh ninyh tauv wax zâyz njăngx lov max phătc naih luungđ cungb naih noomh cuungv. Nănh songđ coong ănz wax zâyz njăngx: “Tăng nây staox ninyh mâyh max tuz săngh pyâu gôh,” wax zâyz bănx tauh njăngx, songđ toongx sangf caođ. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Phătc năngđ nâyx, wax đomc stayb sây songđ nyâyh ganc, yâuc coong: “Ayx săngh laiv ninyh zâyz bănx tauh njăngx bix toongx sangf caođ?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Tăng wa, Zâu Yê-su songđ tauz yâuc coong ănz stiz: “Yaz coong senz bux nyâuh, năngđ coong nyâuh naih zen stimz yâuc max plungh plănb, nyâuh six hayh ayx tuz, max zâyf cungb năngđ nâyx zâyz bănx tauh njăngx, hănđ six nyâuh êu nomz zoongz zâyc coong: ‘oix zuc pâuh taih bix quanyf ănz wa coiđ,’ yâuc tuz ayx săngh. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Muif huungđ yămz nyâuh cloo Zâu joođ nyăngz max cun laiv huungđ, năngđ coong zen tingc nyâuh six tuz stipx.”<verse eid="MAT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Tauv Nănh nzac bongc Zâu Tênb-Huungh nyăngz pyau ninyh, wax đomc stayb munh cloon wax đomc songx munh côx taih pongh Nănh yămz Nănh nzaox songx munh wax zanyf, stiz naic coong: “Tăng laiv huungđ lokc jangx mâyh bix ayx nâyx đomc dlayc, mănv phunz mâyh nâyx đomc lokc jangx?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Six Zâu Yê-su tauz ănz stiz: “Yaz lauf oix naic nyâuh ah zâux, năngđ coong nyâuh hayh tauz yaz, yaz mănc bux phunz nyâuh pâyz yaz nongc luungđ lokc jangx ayx nâyx đomc dlayc. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yô-hanx ayx quaix-gâyf — six tăng laiv taih? Tăng guungh max six tăng bamh munh?” Tăng wa stiz lanh bux lanh coong: “Pănh năngđ coong: ‘Tăng guungh,’ nănh six coong ănz pănh: ‘Ha wâyc săngx laix nyâuh bix max zen nănh?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Zef pănh năngđ coong: ‘Tăng bamh munh,’ six pănh aox songx munh, wâyc muif lanh munh coong Yô-hanx six ah tauh tâuc wac munh.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Wâyc nây stiz coong tauz ănz Zâu Yê-su: “Buz max pâyz.” Zâu Yê-su zef coong ănz stiz: “Yaz lauf max coong phunz nyâuh pâyz yaz nongc luungđ lokc jangx ayx nâyx đomc dlayc. <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />Nyâuh nyâyh mungv jađ? Naih ah lanh munh naih iz lanh toonz, nănh songđ ninyh bux wax lanh toonz coonz, coong: ‘Toonz lex, nâyx noib mâyh zuc ninyh wa tungh cuđ lauđ winb ayx cumh pâuz bex.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Six nănh tauz coong: ‘Yaz max oix ninyh,’ six blătc cah đangz nănh wănc stimz yâuc ninyh. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Nănh zef ninyh êu wax lanh toonz đany, coong ayx năngđ wa nâyx. Tăng wa wax lanh toonz tauz, coong: ‘Ih, pha,’ six nănh max ninyh. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Wa iz lanh toonz mănv ayx âyz stiz pha nyăngz âyx heh?” Stiz tauz: “Tah yetx lanh.” Zâu Yê-su coong ănz stiz: “Yaz coong senz bux nyâuh coong, wax đomc sâub sôiv munh cloon maic phăngh munh sab, six tuz ninyh nzac Zâu Tênb-Huungh nyăngz côkz đangc nyâuh. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Wâyc Yô-hanx taih yămz nyâuh nây ayx peengh stimz nyăngz jau, nyâuh yâuc max zen nănh. Six wax đomc sâub sôiv munh cloon maic phăngh munh sab yâuc zen nănh. Six nyâuh hănđ mangc phătc nănh, lauf max nhlimc stoif zen nănh.<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Oix zuc mungv pitc tauh wac pây. Naih ah lanh nib Zâu, songx tungh cuđ lauđ winb, wâyh quib nzêux wax nomz lauđ winb, witz lung nongc ngatc ayx tiu ănz wa cah njaf, zâyv ah nomz stapx jămđ songđ phunz wax đomc songx tungh cuđ nyăngz munh tingc jămđ wax nomz lauđ winb, nănh songđ setb jau ninyh côz. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Tauv wax zanyf, cayx tauv sâub zunb nyăngz săngx huđ, nănh paiđ nănh nyăngz pâuz ninyh pongh wax đomc songx tungh cuđ nyăngz munh nongc zoz nănh nyăngz ah phănc nyanh gâyc. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Six songx tungh cuđ nyăngz munh toopz zâu wax đomc pâuz taih, bopc nâyx lanh, zef tayx wax lanh, yâuc zoz njăuz ôx wax lanh. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Zâu zef paiđ pitc đomc pâuz taih timb, năngx đuungx têx cah đangc peob, six stiz lauf ayx tinyh năngđ ănz wax đomc pâuz. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Tauv nzuf byăng wax lanh, zâu paiđ nănh cănh nyăngz toonz taih pongh stiz, nyâyh coong: ‘Stiz six nyangc yaz nyăngz toonz.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Six wax đomc songx tungh cuđ nyăngz munh, phătc wax lanh toonz, songđ lanh bux ănz lanh: ‘Nây six stipx nib zâu wax tauh. Taih gôh, pănh tayx nănh nongc nănh nyăngz nib tâyc.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Tauv toopz wax lanh toonz taih, stiz quanyf nănh ănz wa tungh cuđ lauđ winb cungh ngwaic yâuc tayx tayc. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Năngđ nâyx, tauv tungh cuđ lauđ winb zâu taih nănh six ayx laix ănz wax đomc songx tungh cuđ nyăngz munh heh?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Stiz tauz ănz Nănh: “Nănh six mêtc wax đomc munh huđ munh ninyh nzuf, songđ phunz pitc peo songx tungh cuđ nyăngz munh tingc jămđ nănh nyăngz lauđ winb, wax đomc munh six setb ah phănc nyanh gâyc yămz stiz sâub nyăngz zunb phunz zâu.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Zâu Yê-su coong ănz stiz: “Nyâuh lauf max zeengx toc quaix canyx sâub coong:</para>
  <para style="q1" vid="MAT 21:42">‘Ayx pyau stangc munh nzêmh wax nomz njăuz pyây,</para>
  <para style="q1" vid="MAT 21:42">yâuc tuz nongc ănz wa pyau joongz năngx nongc sen têx.</para>
  <para style="q1" vid="MAT 21:42">Nây six tăng Zâu taih nyăngz cumh pâuz,</para>
  <para style="q1" vid="MAT 21:42">yâuc ah huungđ njingc nzongf yămz pănh mâyc mangc?’<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Wâyc năngđ nâyx yaz coong ănz nyâuh coong Zâu Tênb-Huungh nyăngz côkz six zuc zoz gâyh nyâuh, yâuc tuz sađ phunz wax đomc munh ayx gâyc phunz wax nomz côkz wax đomc. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Mănv glinyf nzac nâyx nomz njăuz ninyh six zuc beengb nzuf, zef nâyx nomz njăuz tuih bopb zuc laiv lanh munh wax lanh six zuc đăpx yungc nzuf.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Mungv Nănh wax đomc wac pây, wax đomc stayb munh cloon wax đomc Pha-li-si munh pâyz coong Nănh coong tauv stiz. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Stiz songđ lov jau zoz Nănh, six stiz cumh nzav songx munh, wâyc songx munh nongc Nănh ayx ah tauh tâuc wac munh.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Zef ah hâyđ timb, Zâu Yê-su nongc wac pây tauz ănz stiz, coong: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Tênb-toongh côkz six lauf pây năngđ ah tauh huungh, six huungh bênc ah phangz coonx hinh phunz nănh nyăngz toonz. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Huungh êu nănh wax đomc pâuz ninyh bux tuz êu nyăngz zeb munh taih nzac coonx hinh, six stiz max oix taih. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Huungh zef êu pitc đomc pâuz ninyh, coong: ‘Oix zuc coong bux ănz zeb munh tuz êu wax đomc: “Mangc jađ, yaz bênc săngh yaz nyăngz hinh. Wax đomc ngoongh wăngh cloon yaz nyăngz stanyb hauđ cunc ayx a soongb nzuf, muif huungđ bênc săngh gôh. Oix zuc taih nzac hinh.”’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Six stiz ayx max pâyz zâyx tiny, nâyx lanh ninyh nănh nyăngz njingh wax lanh yâuc ninyh ayx nănh nyăngz steengb âyx. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Yăngc nzac wax đomc, yâuc zoz huungh wax đomc pâuz nzâyz taih mađ yâuc tayx tayc. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Tăng wa, huungh songđ siv nhlenx, songđ paiđ nănh nyăngz peengz ninyh, nănh mêtc wax đomc tayx munh nyăngz munh yâuc pu stiz nyăngz dlanyh. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Blătc wa huungh coong ănz nănh nyăngz pâuz: ‘Coonx hinh manyf tuz bênc săngh, six tuz êu taih wax đomc yâuc max payh taih. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Năngđ nây, nyâuh bix ninyh yămz wax đomc jau zav, năngđ coong nyâuh phătc sax lanh munh, bix êu stiz taih nzac coonx hinh.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Wax đomc pâuz, ninyh yămz wax đomc jau zav, stiz phătc sax lanh munh stiz êu taih nzuf, njinh huđ lauf naih gongx lauf naih, tăng wa hinh songđ naih zeb munh pong nzuf. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Six tauv nzac ninyh mangc zeb munh stâyv hinh nhlinc wax zanyf, huungh phătc ah lanh munh max zuz ninyh coonx hinh nyăngz guyz quav. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Huungh coong wax lanh munh: ‘Lah pyeoz lex, săngh laix mâyh taih nây bix max zuz ninyh coonx hinh nyăngz guyz quav heh?’ Six wax lanh munh mayv tauz. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Tăng wa, huungh êu wax đomc pâuz coong: ‘Oix zuc stayb nâyx lanh munh nyăngz puf staux bix quanyf nănh ănz wa cungh ngwaic nzămc nyăngz tinc, yămz wa naih pungx stingb haoh cloon tăpc nyah tanyđ.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Wâyc munh đuungx tuz êu, six munh stoc tuz sên.”<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Wax zanyf, wax đomc Pha-li-si munh songđ setb ninyh tinyh sangv stuv jau ayx laix stiv phunz Zâu Yê-su coong longđ. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Stiz paiđ stiz wax đomc stayb sây, cloon Hê-lôtx nyăngz wax peob munh ninyh, pongh Zâu Yê-su, naic coong: “Stênx steengb lex, buz pâyz coong mâyh six nyâuđ zac nyăngz munh yâuc nzaox Zâu Tênb-Huungh nyăngz jau toix senz gâyf nzuf, yămz mâyh yâuc max nyangc toix laiv lanh, wâyc mâyh max cungb mangc yămz munh nyăngz cungh ngwaic. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Năngđ nây, joođ bux buz mâyh nyâyh năngđ laix heh? Tuz setb sôiv nyanh phunz Sê-sa max?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Six wâyc pâyz tuz stiz nyăngz nyâuđ huđ, Zâu Yê-su coong: “Pâyc zac nyâuđ yootz nyăngz munh lex săngh laix nyâuh bix zangđ yaz? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Phunz yaz mangc ah nomz setb sôiv nyanh geh.” Stiz nzâyz ah nomz nyanh taih phunz Nănh. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Nănh coong ănz stiz: “Nây hanyh cloon manyh six mănv nyăngz heh?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Stiz tauz: “Sê-sa nyăngz.” Wax zanyf, Zâu Yê-su songđ coong ănz stiz: “Năngđ nây, laiv huungđ Sê-sa nyăngz oix zuc toiv phunz Sê-sa zef laiv huungđ Zâu Tênb-Huungh nyăngz yâuc phunz Zâu Tênb-Huungh.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Mungv numđ nâyx đomc wac, stiz numđ nyâyh ganc, stiz songđ tiuv, queengx Nănh ănz wa.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Lauf wax noib, naih ah đomc Sa-đu-si munh taih stătx Zâu Yê-su, wâyc stiz njinh leox coong munh tayc max hayh săngh taih, stiz songđ taih naic Nănh, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />coong: “Stênx steengb lex, Mô-sê coong: ‘Năngđ coong naih tix lanh munh tayc bix max zeengx naih sây, nănh nyăngz yâuf six zuc zoz tah nyăngz au nongc yâuc steengb sây phunz nănh nyăngz tah.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Six yămz buz nây naih nhlic lanh yâuf pez, zetx lanh zoongz pyau blătc, yâuc tayc. Queengx nănh nyăngz au phunz nănh nyăngz yâuf, max zeengx naih sây. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Tah nyâyc lanh zef tauv tah stamz lanh, zef ninyh tauv tah jetb lanh, lauf tinyh năngđ. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Tăng wa blătc quaix đangz, tauh munh nzif zef tayc. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Năngđ nâyx, tauv săngh taih, tauh munh nzif six mănv nyăngz au heh yămz stiz wa nhlic lanh yâuf pez? Wâyc stiz muif lanh tuz zoz nănh quaix nzuf.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Six Zâu Yê-su tauz ănz stiz coong: “Nyâuh longđ nzuf nzof gôh, wâyc max pâyz Canyx Stâub cloon Zâu Tênb-Huungh nyăngz jab. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Wâyc tauv săngh taih, munh six max zoz au max zoz langh, stiz six cayx năngđ wax đomc stinz munh yămz wa cah zâyc guungh nâyx. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Coong tauv munh tayc săngh taih, nyâuh max zeengx toc quaix Zâu Tênb-Huungh nyăngz wac coong: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Yaz six Apx-la-ham nyăngz Zâu Tênb-Huungh, I-sakx nyăngz Zâu Tênb-Huungh cloon Ya-côpx nyăngz Zâu Tênb-Huungh’? Zâu Tênb-Huungh six max zâyf munh tayc nyăngz, six munh săngh nyăngz.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Numđ nâyx đomc wac, songx munh songđ numđ nyâyh ganc tauv Nănh nzaox nyăngz jau.<verse eid="MAT 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Năngx naih wax đomc Pha-li-si munh numđ coong Zâu Yê-su ayx phunz Sa-đu-si munh mayv tauz, songđ tinyh ênz taih căpx dlonf. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Yămz stiz wax peob naih ah lanh, nzaox gâyf munh, taih zangđ naic Zâu Yê-su — <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Stênx steengb lex, yămz gâyf njanh six laiv tiuh năngx lub têx heh?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Nănh songđ tauz wax lanh munh coong: “‘Oix zuc nongc nzuf mâyh nyăngz nyâuđ, nongc nzuf mâyh nyăngz stimz, nongc nzuf mâyh nyăngz zux ix, stăngz Zâu, mâyh nyăngz Zâu Tênb-Huungh.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Nâyx tiuh six năngx lub têx, yâuc năngx nongc sen têx. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Zef tah nyâyc tiuh lauf năngđ nâyx — ‘Oix zuc stăngz mâyh nyăngz cah sinh munh năngđ mâyh cănh nyăngz stinb.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Muif tiuh gâyf njanh cloon wax đomc tâuc taih nyăngz wac six cloopb yămz nây iz tiuh nzuf.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Wax zanyf, wax đomc Pha-li-si munh tinyh đoih căpx dlonf, Zâu Yê-su naic stiz, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />coong: “Nyâuh nyâyh Zâu Jix-Tuz six năngđ laix heh? Nănh six mănv nyăngz sây stunz?” Stiz tauz Nănh: “Đa-witx huungh nyăngz.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Nănh coong ănz stiz: “Ha ayx laix bix Đa-witx, yămz Singx-Lingh, yâuc hipđ Nănh ayx Zâu, coong:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Zâu coong bux yaz nyăngz Zâu:</para>
  <para style="q1" vid="MAT 22:44">“Taih stâyv yămz Yaz nyăngz byaoh phanx,</para>
  <para style="q1" vid="MAT 22:44">zu tauv laiv zanyf Yaz phunz mâyh nyăngz yônz zaz yămz mâyh nyăngz staux đi”’?<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Ha năngđ coong Đa-witx hipđ Nănh ayx ‘Zâu,’ ayx laix Nănh zef năngx ayx Đa-witx nyăngz sây stunz?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Max naih mănv hayh tauz Nănh zâux tiny, tăng wax noib staox ninyh, yâuc max naih mănv năngx nzađ naic Nănh.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Tăng wa Zâu Yê-su coong ănz songx munh cloon Nănh wax đomc stayb sây, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />coong: “Wax đomc nzaox gâyf stênx steengb cloon wax đomc Pha-li-si munh six stâyv yămz Mô-sê nyăngz tăngx. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Wâyc nây, năngđ coong stiz nzaox nyâuh laiv huungđ, oix zuc âyz ayx năngx nzuf. Six năngx gâyf âyz stiz nyăngz gao ayx, wâyc stiz coong six stiz max ayx. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Stiz nzapc wax đomc đamx niđ nzâyz zâuđ, pâuh ănz munh nyăngz bah tauh, six stiz cănh max nongc ah saz bah đoz stăngc pâuh tauv. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Stiz ayx nyăngz muif huungđ cumh pâuz six wâyc oix phunz munh phătc. Stiz ayx hapđ năngx lub nongc ănz stiz nyăngz canyx gâyf yâuc ayx stiz nyăngz guyz leepz năngx đao. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Stiz nzac hinh yâuc cungb oix stâyv wa tinc saix, cloon wax đomc huyđ toongh saix quaix nyăngz tinc, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />cloon yămz caiz sangc yâuc oix nongc munh đeh, yâuc oix nongc munh hipđ stiz ayx ‘La-bi.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Six nyâuh năngx gâyf phunz munh hipđ nyâuh ayx ‘La-bi’, wâyc nyâuh cungb naih ah lanh stayb pha, nzof nyâuh muif lanh six ayx yâuf pez. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Nyâuh yâuc năngx gâyf hipđ yămz nây bamh canz laiv lanh munh ayx ‘Pha’ wâyc nyâuh cungb naih ah tauh Tênb-toongh pha. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Yâuc năngx gâyf phunz munh hipđ nyâuh ayx ‘zâu,’ wâyc nyâuh cungb naih ah tauh zâu — six Zâu Jix-Tuz. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Six laiv lanh năngx lub têx yămz nyâuh cah njaf six ayx nyâuh nyăngz pâuz <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Zef laiv lanh cănh zanyb nănh lub six zuc sămc nzac; laiv lanh cănh nhlimc ayx jenz six tuz zanyb lub.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Six nyâuh zuc zâuđ gôh, nzaox gâyf stênx steengb cloon Pha-li-si munh, pâyc zac nyâuđ yootz nyăngz munh lex! Wâyc nyâuh omz Tênb-toongh côkz nyăngz jeengh yămz munh cah đangc. Nyâuh cănh max nzac ninyh, six laiv lanh oix nzac ninyh nyâuh yâuc max phunz nzac. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[Nyâuh zuc zâuđ gôh, nzaox gâyf stênx steengb cloon Pha-li-si munh, pâyc zac nyâuđ yootz nyăngz munh lex! Wâyc nyâuh jeetb au qua nyăngz jax toongx nhlinc, yâuc cah đanyc cloo Zâu đao.] Wâyc nâyx đomc dlayc, nyâuh six zuc tingc stoif năngx niđ têx. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Nyâuh zuc zâuđ gôh, nzaox gâyf stênx steengb cloon Pha-li-si munh, pâyc zac nyâuđ yootz nyăngz munh lex! Nyâuh jămc womz jămc jêmh ninyh lov munh taih zen, six tauv lov tuz ah lanh munh taih, nyâuh ayx phunz nănh pênx tâuf coiđ nyăngz munh năngx neetb têx nyâuh.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Nyâuh zuc zâuđ gôh, nyâuh đomc yenv jau nyăngz mâyc buđ munh, wâyc nyâuh coong: ‘Laiv lanh nuz bongc Zâu Tênb-Huungh nyăngz pyau nyunc wac six max wangb. Six laiv lanh nuz bongc Zâu Tênb-Huungh nyăngz pyau nyăngz sămz nyunc wac six zuc âyz ayx.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Nyâuh đomc munh oongx yâuc mâyc buđ lex! Sămz cloon bongc Zâu Tênb-Huungh nyăngz pyau ayx tuz sămz đăngb, laiv huungđ six năngx nongc sen têx heh? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Zef năngx coong: ‘Laiv lanh nuz congx tinc nyunc wac six max wangb. Six laiv lanh nuz congx tinc cah zâyc wax đomc tax huungđ nyunc wac six zuc âyz ayx.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Nyâuh đomc munh oongx yâuc mâyc buđ munh lex! Congx nyăngz tax huungđ cloon coongx tinc ayx phunz tax huungđ đăngb, laiv huungđ năngx nongc sen têx heh? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Năngđ nây, laiv lanh nuz congx tinc nyunc wac six lauf nuz cloon muif huungđ yămz wa congx tinc cah zâyc. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Laiv lanh nuz bongc Zâu Tênb-Huungh nyăngz pyau nyunc wac six nuz bongc Zâu Tênb-Huungh nyăngz pyau cloon nuz yămz wa pyau cah njaf wax Tauh nyunc wac. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Zef laiv lanh nuz guungh nyunc wac six nuz Zâu Tênb-Huungh nyăngz tinc cloon stâyv wa tinc cah zâyc wax Tauh.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Nyâuh zuc zâuđ gôh, nzaox gâyf stênx steengb cloon Pha-li-si munh, pâyc zac nyâuđ yootz nyăngz munh lex! Nyâuh setb săpc phănc ah phănc mađ đunz, cloon yênz stiz căn njayz oongx, six nyâuh quanyf nongc sen quaix nyăngz gâyf njanh — six ayx peengh stimz nyăngz jau, cloon ayx nyâuđ zanyx căn hâuđ lênh munh nyăngz jau. Nâyx đomc six nyâuh oix zuc ayx, yâuc năngx gâyf quanyf cloon wax đomc cumh pâuz. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Nyâuh yenv jau nyăngz mâyc buđ munh lex, nyâuh sên săngh nomz jengz jenz setb, six săngh tauh maf loh yâuc naz clunh!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Nyâuh zuc zâuđ gôh, nzaox gâyf stênx steengb cloon Pha-li-si munh, pâyc zac nyâuđ yootz nyăngz munh lex! Wâyc nyâuh cungb đaox cungh ngwaic wăn căn banh, six cah njaf ănz pong nzuf jab taih nyăngz tax huungđ cloon nyâuđ mauh. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Nyâuh mâyc buđ nyăngz Pha-li-si munh lex! Nongc sen quaix, six oix zuc đaox cah njaf wăn căn banh, phunz njinh cloon cungh ngwaic dlăngc wayh.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Nyâuh zuc zâuđ gôh, nzaox gâyf stênx steengb cloon Pha-li-si munh, pâyc zac nyâuđ yootz nyăngz munh lex! Wâyc nyâuh six cayx năngđ wax đomc munh tayc stâu nâyx leetc cungh ngwaic pec, cungb phătc cungh ngwaic quai cuungv, six cah njaf yâuc naih munh tayc stung cloon muif huungđ cah lôh matc. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Lauf tinyh năngđ, munh mangc nyâuh cungh ngwaic manyf cayx năngđ peengh stimz munh, six nyâuh cah njaf pyenb huđ nzuf cloon naih stoif pong nzuf.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Nyâuh zuc zâuđ gôh, nzaox gâyf stênx steengb cloon Pha-li-si munh, pâyc zac nyâuđ yootz nyăngz munh lex! Wâyc nyâuh zâyv tâuc wac munh nyăngz stâu yâuc lif zany peengh stimz munh nyăngz stâu. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Nyâuh coong: ‘Năngđ coong buz yămz buz nyăngz claof jex buz wax nzêuh, buz six max ninyh tac stiz ayx phunz wax đomc tâuc wac munh nyăngz samđ setb.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Wâyc nây, nyâuh cănh ayx zanyx manyf coong nyâuh six ayx wax đomc tayx tâuc wac munh nyăngz sây stunz, <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />nyâuh yâuc oix zuc stipx nyâuh claof jex nyăngz stoif ayx năngx pong stâuv! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Nyâuh đomc nangz meengz nyăngz sây stunz lex, nyâuh cayx tiuv ayx laix tuz gâyh đutb max zuc tingc yămz tâuf coiđ heh? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Wâyc năngđ nâyx, phanv mangc, yaz paiđ wax đomc tâuc wac munh, tongb manyh munh cloon nzaox gâyf munh taih pongh nyâuh. Stiz wax đomc, nyâuh six tayx tayc yâuc tingz jămz, lauf tăng stiz wax đomc, nyâuh bopc yămz nyâuh nyăngz huyđ toongh yâuc luiđ tăng nâyx nomz dlanyh tauv wax nomz dlanyh. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Ayx tuz phunz wax đomc peengh stimz nyăngz stămđ njămh nzac nib ninyh tauv laiv quaix tauv nyâuh năngx nzuf, tăng A-bên nyăngz samđ, peengh stimz munh, ninyh tauv Sê-ca-li-ya nyăngz samđ, Bê-li-ci-ya nyăngz toonz, yămz đăngb tinc cloon congx tinc mungh tongx zuc nyâuh tayx tayc wax tauh. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Yaz coong senz, bux nyâuh, wax đomc dlayc six naih setb taih yămz nâyx nzêuh munh.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Yê-lu-sa-lem lex, Yê-lu-sa-lem, mâyh tayx tayc wax đomc tâuc wac munh yâuc zoz njăuz ôx tuz paiđ taih phunz nyâuh nyăngz munh! Pâyz sax hâyđ yaz oix dlonf mâyh nyăngz munh lauf, cayx năngđ zayz nyâyf clukx nănh nyăngz jenz yămz đatz đi, six nyâuh max nyenc! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Phanv mangc, nyâuh nyăngz pyau six zuc queengx cuungv nzuf phunz nyâuh. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Nây, yaz coong ănz nyâuh, tăng nâyx zanyf nyâuh six max phătc yaz tuz tauv laiv zanyf nyâuh coong: ‘Tanv yămz Zâu nyăngz bux taih wax Tauh!’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Setb bongc Zâu Tênb-Huungh nyăngz pyau ninyh, Zâu Yê-su yăngh jau ninyh wax zanyf. Nănh wax đomc stayb sây taih stătx yâuc nuz phunz Nănh mangc wax đomc bongc Zâu Tênb-Huungh nyăngz pyau. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Six Nănh coong ănz stiz: “Nyâuh phătc lâyc đomc max? Yaz coong senz bux nyâuh, yămz nâyx six max naih laiv nomz njăuz tinyh clăpb lâyc bix max zuc bopc lakb.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Wax zanyf, Nănh jinh đangh stâyv wa Ca-lan zoongz, wax đomc stayb sây cănh lanyc taih naic Nănh: “Joođ bux phunz buz pâyz wax đomc dlayc six laiv zanyf setb taih, naih laiv huungđ njic hoouđ phunz pâyz coong Zâu cayx taih cloon stêtb mâyv nyăngz noib?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Zâu Yê-su tauz ănz stiz coong: “Oix zuc năngx cayb bôngh năngx gâyf phunz mănv ênz nyâuh ninyh longđ. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Wâyc naih đuungx lanh six đamz yaz nyăngz manyh taih, coong: ‘Yaz six Zâu Jix-Tuz,’ yâuc ayx phunz đuungx lanh munh ninyh longđ. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Tauv wa zanyf, nyâuh six tuz numđ tauv panx peengz yâuc numđ lănv panx peengz nyăngz jau. Nyâuh oix zuc năngx cayb bôngh, năngx gâyf nyâuđ lunc, wâyc nâyx đomc dlayc six oix zuc setb taih, yâuc max zeengx zâyf tauv stêtb mâyv. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Wâyc nâyx stingx six cloon wax stingx tinyh bopc, nâyx nomz côkz yâuc cloon wax nomz côkz bopc zax, yâuc naih nyâuđ sab cloon nib tongf yămz đuungx đoif. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Năngđ naz nâyx đomc muif huungđ dlayc six quef coonz nyăngz zâuđ nanc. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Tauv wax zanyf, munh six ayx huđ ănz nyâuh yâuc tayx nyâuh tayc, wâyc yaz nyăngz manyh nyâuh six zuc manf stingx munh hănđ. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Naih đuungx lanh six zuc ninyh longđ, lanh plănc minb ănz lanh yâuc lanh hănđ lanh. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Naih za tâuc wac munh đuungx six setb taih, yâuc ayx phunz đuungx lanh munh ninyh longđ. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Wâyc naih stoif nyăngz jau phutx staox taih, đuungx lanh munh tinyh stăngz nyăngz jau songđ nămx nzac. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Six laiv lanh tanyđ tuz tauv tauh tauv mâyv, wax lanh nzăngđ tuz njâuv. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Nây Tênb-toongh côkz nyăngz Cuđ Jenx six tuz lănv nzônh pong nây guungh đi nongc ayx zanyx manyf phunz manf stingx pâyz, tăng wa songđ tauv stêtb mâyv gôh.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Wâyc nây, tauv nyâuh phătc ayx phunz muif huungđ huđ nyăngz dlayc setb taih wax tauh, yămz wa đăngb zeengh tinc, âyz tâuc wac munh Đa-ni-ên coong tauv nyăngz jau” (mănv toc oix zuc saz), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“tauv wax zanyf, laiv lanh yămz wa Yu-đê stâyz phangz oix zuc tiuv staox jêmh ninyh, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />laiv lanh yămz wa pyau tuungx, năngx gâyf nzac taih nongc zoz laiv huungđ setb pyau ninyh, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />zef laiv lanh yămz wa njăngx năngx gâyf lauf pyau zoz cănh nyăngz guyz lub. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Yămz wax đomc noib, munh nzif naih stinb cloon năngx jinh phunz sây hopb nu wax đomc senz zuc zâuđ gôh! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Six oix zuc cloo Zâu phunz nyâuh tiuv nanc nyăngz noib lav năngx gâyf setb taih toix guungh song, max six toix tingc congz noib. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Wâyc tauv wax zanyf six naih zâuđ nanc lub nzongf, tăng zuyx guungh zuyx nib staox taih tauv nâyx zanyf, max zeengx naih quaix ayx năngđ nâyx setb taih, blătc wa yâuc max naih gôh. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Năngđ coong max tob wax đomc noib stoc nzac six max naih laiv lanh tuz meengc setb. Six wâyc tuz sên taih nyăngz munh, wax đomc noib six tuz tob nzac. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Tauv wax zanyf, năngđ coong naih munh bux ănz nyâuh, coong: ‘mangc geh, Zâu Jix-Tuz yămz nây!’ max six ‘Yămz wa!’ nyâuh six năngx gâyf zen. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Wâyc naih wax đomc za Njâuv Zâu cloon wax đomc za tâuc wac munh setb taih ayx jix caox njingc cloon njic hoouđ lub nongc jaf munh, năngđ hayh jaf tuz six njinh jaf cloon tuz sên taih nyăngz munh. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Phanv mangc, yaz bux phunz nyâuh quaix đangc nzof bex. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Wâyc nây, năngđ coong munh coong ănz nyâuh: ‘Phanv mangc, Nănh yămz wa stâyz phangz blănf,’ nyâuh six năngx gâyf ninyh wa. Max six ‘Phanv mangc, Nănh yămz wa pyau njaf,’ nyâuh six năngx gâyf zen. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Wâyc bungh bitc tâuf tăng tongz pôngz nzăpc ninyh tauv staiz pôngz năngđ laix, six Bamh Munh nzac taih wax zanyf lauf năngđ wa nâyx. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Tinyh phanv laiv tix naih munh tayc, nooc ưngx af songđ nzoomf yămz wa gôh.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Six tauv wax đomc zâuđ nanc nyăngz noib lav ah quaix, bah noib six nzămc jaz ninyh, lav yâuc max siux gwăngz, wax đomc stingz tau six tăng guungh tuih nzac taih, Yămz guungh naih jab nyăngz muif huungđ yâuc zuc đănz tongf. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Tauv wax zanyf, Bamh Munh nyăngz njic hoouđ six setb yămz wa cah zâyc guungh, guungh đi manf stingx munh yămz nây nib minc six yônx meengc haoh. Stiz six tuz phătc Bamh Munh yămz wa vănx nzac taih naih jab yâuc naih gwăngz eeng lub nzongf. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Nănh six paiđ Nănh nyăngz stinz munh pyom blungh blex stingb buib nhlangđ, stiz six sâub dlonf Nănh sên taih nyăngz munh yămz pyâyz phangz, tăng nâyx phangz guungh coonz ninyh tauv wax phangz guungh coonz.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Oix zuc hoođ ah tauh wac pây tăng bănx tauh njăngx. Laiv zanyf phătc quah setb tunb goib noomh, nyâuh songđ pâyz coong cayx tauv zunb dlih. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Lauf năngđ wa nâyx, laiv zanyf nyâuh phătc nâyx đomc dlayc, nyâuh songđ pâyz coong Nănh taih tauv stătx, yămz wa jeengh cah đangđ. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Yaz coong senz bux nyâuh coong, nâyx nzêuh munh six max quaix ninyh tuz tauv laiv zanyf wax đomc muif huungđ dlayc setb taih. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Guungh nib six quaix ninyh nzuf, six yaz nyăngz wac stâyv quâyx max quaix. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Năngx naih wax noib cloon wax săngx huđ six max naih laiv lanh pâyz, njinh wax đomc stinz munh yămz wa Tênb-toongh cloon Toonz lauf max pâyz, cungb Pha pâyz cuungv. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Wâyc Nô-ya wax nzêuh ayx năngđ laix, six tauv Bamh Munh taih lauf năngđ wa nâyx. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Wâyc yămz womz max zeengx yămx guungh đi wax zanyf, munh nhlinc hopb, maic sab zoz bongf tuz tauv Nô-ya nzac đangđ ninyh wax noib, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Stiz yâuc max pâyz luungđ ayx tuz tauv womz yămx taih cuutb stiz ninyh nzuf — tauv Bamh Munh taih six lauf năngđ wa nâyx. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Tauv wax zanyf, iz lanh munh pha yămz wa njăngx — ah lanh tuz ênz muf, ah lanh zuc queengx ănz wa. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Iz lanh munh nzif yămz wa quinz njăuz mac — ah lanh tuz ênz muf, ah lanh zuc queengx ănz wa. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Wâyc nây, oix zuc bôngh stimz wâyc nyâuh max pâyz tuz toix laiv noib nyâuh nyăngz Zâu taih. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Nyâuh oix zuc pâyz ayx nâyx coong, năngđ coong pyau zâu pâyz tuz laiv săngx huđ stac munh taih, nănh six bôngh stimz yâuc max phunz stac munh nzac nănh nyăngz pyau. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Wâyc năngđ nâyx, nyâuh six oix zuc bênc săngh zu, wâyc yămz nyâuh nyâyh max tauv nyăngz săngx huđ Bamh Munh six taih.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Wâyc nây, laiv lanh six nyâuđ zanyx naih tongb manyh nyăngz pâuz bix tuz zâu paiđ phunz nănh jămđ zâu nyăngz pyau munh nongc âyz săngx huđ bênc nhlinc hopb phunz stiz? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Năngđ coong nănh nyăngz zâu phunb đangz lauf, phătc wax tauh pâuz ayx âyz năngđ nâyx, six wax tauh pâuz senz naih oonz looc gôh. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Yaz coong senz bux nyâuh coong zâu six jaoz phunz nănh cun nzuf zâu naih nyăngz muif huungđ. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Six năngđ coong wax tauh pâuz bix huđ yâuc cănh yămz nyâuđ nyâyh coong: ‘Yaz nyăngz zâu bâyf max zeengx lauf căn,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />yâuc bopc cloon nănh ayx pâuz wax đomc toic, zef cloon wax đomc tiu binz munh songc nhlinc songc hopb, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />wax tauh pâuz nyăngz zâu six lauf toix nănh max bôngh nyăngz noib cloon nănh max bôngh nyăngz săngx huđ. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Zâu six zoz nănh bopc niđ nzongf yâuc tingc phunz nănh cloon pâyc zac nyâuđ yootz nyăngz munh songc yămz; yămz wa six naih pungx stingb haoh yâuc tăpc nyah tanyđ.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Năngđ nâyx, Tênb-toongh Côkz six pây cayx năngđ săpc lanh munh sab đăngb, stiz mănv nzauf mănv toongz setb ninyh stipx săngb langh. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Six yămz stiz wax peob naih pyaz lanh oongx, cloon pyaz lanh leemđ. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Six wa pyaz lanh oongx, nzauf stiz nyăngz toongz ninyh, yâuc max nzâyz cloon yâuh ninyh. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Năngx naih wax đomc leemđ six zoz yâuh ănz wa eengz nzâyz lêpc toongz ninyh. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Wax zanyf, wâyc săngb langh max taih căn, stiz songđ muif lanh oix mâyc njoomh yâuc taux wa mâyc njoomh nzuf. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Six tauv đamx munf, naih stingb hamv coong: ‘Săngb langh wex! Oix zuc setb ninyh tauv wa tinc stipx.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Wax zanyf wax đomc munh sab đăngb tuz êu điub taih nzuf yâuc bênc stiz nyăngz toongz. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Wax zanyf, wax đomc munh oongx coong ănz wax đomc munh leemđ: ‘Joođ tanb tix cay nyâuh nyăngz yâuh phunz buz, wâyc buz nyăngz toongz cayx tayc gôh.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Six wax đomc munh leemđ tauz, coong: ‘Naih dlih bâyf max caux tuz buz cloon nyâuh tinyh đoih nongc. Nyâuh wănh, ninyh lov wax đomc maic yâuh nyăngz munh nongc maif phunz nyâuh.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Six, stiz ninyh maif yâuh wax zanyf, săngb langh taih tauv, wax đomc bênc săngh tuz cloon săngb langh ninyh nzac coonx hinh, yâuc omz jeengh blătc. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Tăng wa, wax đomc munh sab oongx zef lauf tauv, êu coong: ‘Zâu lex, Zâu lex, joođ coib jeengh phunz buz.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Six zâu tauz coong: ‘Yaz coong senz bux nyâuh, yaz max pâyz nyâuh.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Wâyc nây oix zuc bôngh stimz, wâyc nyâuh max pâyz wax noib cloon wax săngx huđ.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Wâyc zuc cayx năngđ ah lanh munh cayx setb jau ninyh côz, nănh songđ êu nănh nyăngz pâuz taih yâuc jaoz nănh nyăngz jax toongx phunz stiz. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Nănh phunz nâyx lanh pyaz panc, wax lanh iz panc, ah lanh timb ah panc — phunz âyz stiz cănh nyăngz jab, tăng wa nănh songđ setb jau ninyh stâyz phangz côz. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Tauv nănh ninyh blătc, tuz pyaz panc wax tauh songđ nzâyz wax đomc nyanh ninyh ayx steengb âyx yâuc tuz gâyc pyaz panc pâu. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Lauf tinyh năngđ, tuz iz panc wax tauh lauf ninyh ayx gâyc tuz iz panc timb pâu. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Six tuz ah panc wax tauh songđ, nzâyz ninyh witz cotb plopx zâu nyăngz nyanh. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Tăng wa blătc quaix đangz lauh, wax đomc pâuz nyăngz zâu lauf songđ stunx mangc wax đomc pâuz nyăngz stâub tanz. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Tuz stipx pyaz panc wax tauh nzâyz cloon pyaz panc timb, staox taih stătx, yâuc coong: ‘Zâu lex, mâyh phunz yaz pyaz panc. Six mangc nhlex, yaz ayx tuz gâyc pyaz panc pâu.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Nănh nyăngz zâu songđ coong ănz nănh: ‘Gongx gôh, mâyh six ah lanh pâuz gongx yâuc nyâuđ zanyx! Mâyh ayx nyâuđ zanyx yămz nâyx đomc cumh pâuz jenz. Yaz six jaoz phunz mâyh cun cumh pâuz lub. Nzac taih cloon mâyh nyăngz zâu songc numđ nyađ gôh.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Tuz iz panc wax tauh zef staox taih stătx lauf coong: ‘Zâu lex mâyh phunz yaz iz panc, six mangc nhlex, yaz zef ayx tuz gâyc iz panc pâu.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Nănh nyăngz zâu coong ănz nănh: ‘Gongx gôh, mâyh six ah tauh pâuz gongx yâuc nyâuđ zanyx! Mâyh ayx nyâuđ zanyx yămz cumh pâuz jenz. Yaz six phunz mâyh cun cumh pâuz lub. Nzac taih cloon mâyh nyăngz zâu songc numđ nyađ gôh.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Năngx naih wax tauh tuz stipx ah panc, lauf staox taih, yâuc coong: ‘Zâu lex, yaz pâyz tuz mâyh, coong mâyh six ah lanh munh stekx luungđ yongb, mâyh sâub yămz mâyh max songx nyăngz tinc, yâuc quănf yămz mâyh max hav nyăngz tinc. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Wâyc numđ cumh nzav, yaz nzăngđ nzâyz zâu nyăngz nyanh ninyh plopx ănz wa nib đi. Mangc nhlex, mâyh cănh nongc mâyh nyăngz phănc.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Six nănh nyăngz zâu tauz ănz nănh coong: ‘Mâyh lâyc tauh pâuz huđ yâuc nhlengc! Mâyh pâyz tuz coong yaz sâub yămz yaz max songx nyăngz tinc, yâuc quănf yămz yaz max hav nyăngz tinc. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Năngđ nây, mâyh six hoopđ zuc nzâyz yaz nyăngz nyanh ninyh ănz nyanh njămf, tauv yaz lauf, six njinh tuz yaz nyăngz nyanh coonz căn nyanh gâyc. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Năngđ nâyx, oix zuc zoz nănh nyanh taih yâuc nzâyz ninyh phunz naih săpc panc wax tauh. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Wâyc laiv lanh jinh đangh naih six tuz sađ muif huungđ phunz — ayx tuz naih yăngc. Six wax đomc max naih, six njinh nănh naih nyăngz yâuc zuc zoz setb ninyh. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Yâuc oix zuc zoz nâyx tauh huđ nyăngz pâuz quanyf nzac wa cungh ngwaic nzămc nyăngz tinc ninyh, yămz wa six naih pungx stingb haoh tăpc nyah tanyđ.’<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Six tauv Bamh Munh yămz Nănh nyăngz gwăngz eeng cloon Nănh wax đomc muif lanh stinz munh nzac taih, tauv wax zanyf, Nănh six stâyv yămz Nănh nyăngz gwăngz eeng tinc. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Guungh đi manf stingx munh six taih căpx dlonf yămz Nănh nyăngz cah đangc, Nănh six njeengx stiz phunz goib taih, cayx năngđ jămđ yuungh nyăngz munh phunz goib yuungh cloon pax jiz yuungh nâyx. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Nănh six phunz pax jiz yuungh yămz Nănh nyăngz byaoh phanx yuungh yămz staix phanx. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Tăng wa, Huungh six coong ănz yămz Nănh nyăngz byaoh phanx wax đomc munh: ‘Nyâuh đomc tuz Yaz nyăngz Pha sađ pôz nyăngz munh, staox taih gôh, taih stipx tăng zuyx guungh zuyx nib tuz bênc săngh phunz nyâuh nyăngz côkz. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Wâyc Yaz nyâuđ sab, nyâuh yâuc phunz Yaz nhlinc; Yaz nyâuđ gatb, nyâuh yâuc phunz Yaz hopb; Yaz six munh njingc nyâuh yâuc stipx Yaz nzac pyau; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Yaz max naih zuc, nyâuh yâuc phunz Yaz zuz; Yaz săngh gumc, nyâuh yâuc jămđ Yaz; Yaz yămz wa nzauh, nyâuh yâuc ninyh tex Yaz.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Tauv wax zanyf, wax đomc peengh stimz munh songđ tauz Nănh, coong: ‘Zâu lex, laiv zanyf, buz phătc Mâyh nyâuđ sab bix phunz nhlinc, max six nyâuđ gatb bix phunz hopb heh? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Nzof buz laiv zanyf phătc Mâyh ayx munh njingc bix stipx nzac pyau, max six phătc max naih zuz bix phunz zuz heh? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Zef laiv zanyf buz phătc Mâyh săngh gumc max six yămz wa nzauh bix ninyh tex Mâyh heh?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Huungh songđ tauz ănz stiz coong: ‘Yaz coong senz bux nyâuh, wâyc nyâuh ayx nâyx đomc muif huungđ phunz ah lanh jenz stăm quaix nyăngz munh yămz Yaz nâyx đomc yâuf pez ô stayx cah njaf, nyâuh six ayx phunz Yaz gôh.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Tăng wa huungh zef coong ănz yămz staix phanx wax đomc: ‘Tiuv gâyh Yaz gôh, nyâuh zuc zaux nyăngz munh lex, ninyh yămz wa stâyv quâyx nyăngz tâuf bênc săngh phunz manđ huungh cloon wax đomc manđ peengz nyăngz tinc. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Wâyc Yaz nyâuđ sab nyâuh yâuc max phunz Yaz nhlinc; Yaz nyâuđ gatb nyâuh yâuc max phunz Yaz hopb; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Yaz six munh njingc nyâuh yâuc max stipx Yaz; max naih zuz nyâuh yâuc max phunz Yaz zuz; săngh gumc cloon yămz wa nzauh nyâuh yâuc max jămđ yaz.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Tauv wax zanyf stiz six lauf tauz, coong: ‘Zâu lex, buz laiv zanyf phătc Mâyh nyâuđ sab, max nyâuđ gatb, max six ayx munh njingc, max six max naih zuz, max six săngh gumc, max six yămz wa nzauh bix max stăngc Mâyh heh?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Tăng wa Huungh zef tauz ănz stiz, coong: ‘Yaz coong senz bux nyâuh, wâyc nyâuh max ayx nâyx đomc cumh pâuz phunz ah lanh jenz stăm quaix nyăngz munh yămz nâyx đomc munh nyâuh six max ayx phunz Yaz gôh.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Wax đomc munh six nzac wa stâyv quâyx zuc tingc stoif, nzof wax đomc peengh stimz munh six muf wa stâyv quâyx tuz săngh meengc.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Wax zanyf Zâu Yê-su coong wax đomc muif huungđ wac tuz, Nănh songđ coong ănz Nănh wax đomc stayb sây: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Nyâuh pâyz coong iz noib timb six tauv Pyenv Meengc stêtz, Bamh Munh six zuc jaoz phunz munh tingz ănz săpc đăngc zax.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Wax zanyf, wax đomc stayb munh cloon wax đomc songx munh côx căpx dlonf yămz stayb munh pyây, bux hipđ ayx Ca-ya-phatx nyăngz tinc peengh. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Stiz tinyh đoih sangv jađ stiz ayx laix hayh naih jau zoz tuz Zâu Yê-su nongc tayx Nănh tayc. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Six stiz coong: “max hoopđ zuc ayx toix nây stêtz, wâyc phunz max naih lunc laoc yămz songx munh setb taih.”<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Wax zanyf Zâu Yê-su yămz wa Bê-ta-ni njăngv, Si-môn nyăngz pyau, zuc maoh pongz wax tauh, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />naih ah lanh munh nzif nzâyz ah nomz zâuz eengz ănz ah huungđ yâuh đangz saix nzongf taih stătx Nănh, yâuc taox ănz Nănh nyăngz pyây, Nănh jinh đangh stâyv wa nhlinc năngv. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Six stayb sây buz phătc songđ numđ nhlenx, yâuc coong: “Gănv nzâyz taih ayx huđ tuz nâyx heh? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Wâyc nâyx cuyb yâuh six hayh maic tuz nyanh đuungx, nongc stăngc phunz munh zâuđ munh.” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Six pâyz nâyx đomc dlayc Zâu Yê-su songđ coong stiz: “Săngx laix nyâuh bix coong nâyx tauh munh nzif heh? Nănh six ayx ah huungđ cumh pâuz gongx phunz yaz. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Wâyc nyâuh six njinh leox naih munh zâuđ cloon nyâuh yămz, six nyâuh max zâyf njinh leox naih yaz. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Wâyc nâyx tauh munh nzif taox nâyx cuyb yâuh ănz yaz nyăngz stinb, nănh ayx nâyx nongc bênc săngh plopx yaz. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Yaz coong senz, bux nyâuh, phanv nây Cuđ Jenx nzônh ninyh nzêux tauv laiv tix guungh đi, nâyx tauh munh nzif ayx nyăngz cumh pâuz six lauf tuz lănv nongc săngx tauv nănh.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Wax zanyf, naih ah lanh yămz wa săpc nyâyc lan stayb sây, bux hipđ ayx Yu-đatc I-sa-ca-li-ôtx, songđ ninyh pongh wax đomc stayb munh, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />naic coong: “Nyâuh phunz tuz buc laiv yaz heh, yaz cănh jaoz nănh phunz nyâuh?” Stiz songđ nzăngv stamx săpc leepz nyanh pec phunz nănh. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Tăng wa staox ninyh, nănh songđ lov săngx huđ congv nongc jaoz Zâu Yê-su.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Wax zanyf, tauv Nzu Max Ănz Piny nyăngz stêtz nyăngz tah yetx noib, wax đomc stayb sây taih stătx Zâu Yê-su, coong: “Stayb pha oix buz bênc Pyenv Meengc stêtz ănz laiv phunz mâyh nhlinc heh?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Nănh songđ coong: “Oix zuc nzac lâyc dlanyh ninyh pongh ah lanh munh yâuc coong bux ănz nănh: ‘Stayb pha coong: “Yaz nyăngz săngx huđ six max naih lauh; yaz cayx yămz mâyh nyăngz pyau cloon yaz nyăngz stayb sây ayx Pyenv Meengc stêtz.”’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Wax đomc stayb sây songđ âyz Zâu Yê-su bux stiz nyăngz wac ayx, yâuc ninyh bênc Pyenv Meengc stêtz.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Wax zanyf tauv nzămc, Nănh căn wax đomc săpc nyâyc lanh stayb sây stâyv wa nhlinc năngv. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Stiz jinh đangh nhlinc wax zanyf, Nănh coong: “Yaz coong senz bux nyâuh coong nyâuh naih ah lanh six maic yaz.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Wâyc stiz numđ stauh songđ săngh lanh săngh lanh têx naic Nănh: “Zâu lex, max zâyf yaz stah?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Six Nănh tauz stiz coong: “Laiv lanh blănf cloon yaz tinyh songc nhleepz ah banh, wax lanh six maic yaz. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Bamh Munh six zuc setb ninyh, âyz ja coong tauv Nănh nâyx, six laix lanh maic Bamh Munh wax tauh senz zuc zâuđ gôh! Năngđ coong wax lanh munh wănh gâyf steengb stâyv six năngx gongx têx phunz nănh.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Six Yu-đatc, maic Nănh wax tauh, tauz coong: “Stayb pha lex, zâyf yaz max?” Zâu Yê-su tauz nănh: “Năngđ mâyh cănh coong gôh.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Wax zanyf stiz jinh đangh nhlinc năngv, Zâu Yê-su zoz nzu taih sâuf hâuđ tuz songđ watz taih. Jaoz phunz wax đomc stayb sây, Nănh coong: “Stipx nzâyz ninyh nhlinc gôh. Nây six yaz nyăngz stinb a.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Zef zoz zan taih sâuf hâuđ tuz, Nănh jaoz phunz stiz, yâuc coong: “Muif lanh oix zuc hopb nâyx nomz zan. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Wâyc nây six yaz njăpc nhlengc wac nyăngz samđ njâuc setb taih phunz munh đuungx tuz quanyf stoif. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Six yaz coong bux nyâuh tăng nâyx zanyf, yaz six max hopb nây tungh cuđ womz tuz tauv wax noib, yaz cloon nyâuh songc hopb săngb tungh cuđ womz yămz yaz nyăngz Pha nyăngz côkz.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ayx nzungz tuz, stiz songđ ninyh wa Ca-lan zoongz. <verse eid="MAT 26:30" /><verse number="31" style="v" sid="MAT 26:31" />Wax zanyf Zâu Yê-su coong ănz stiz: “Nâyx munf nyâuh muif lanh six pyenv max nhlimc yaz, wâyc naih wac ja coong:</para>
  <para style="q1" vid="MAT 26:31">‘Yaz six bopc jămđ pax jiz yuungh nyăngz munh</para>
  <para style="q1" vid="MAT 26:31">pax jiz yuungh peo songđ lunc nzuf.’<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Six tauv yaz tuz săngh taih, yaz six ninyh wa Ga-li-lê đangc nyâuh.” <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Six Pi-tê tauz Zâu Yê-su, coong: “Hănđ muif lanh pyenv mâyh nzuf, yaz lauf max pyenv.” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Zâu Yê-su coong ănz nănh coong: “Yaz coong senz bux mâyh coong, yămz nâyx munf, zayz max zeengx ayx caix, mâyh six pyenv yaz pôz hâyđ.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Pi-tê zef coong ănz Nănh: “Yaz hănđ zuc căn mâyh tayc yaz lauf max pyenv mâyh.” Nzof wax đomc muif lanh stayb sây lauf coong ayx nâyx.<verse eid="MAT 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Tăng wa, Zâu Yê-su cloon stiz ninyh tauv ah cuyb tinc hipđ ayx Gêt-sê-ma-ni, Nănh songđ coong ănz wax đomc stayb sây: “Oix zuc stâyv yămz nây zu yaz ninyh wax đangđ cloo Zâu.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Nănh ênz Pi-tê cloon Sê-bê-đi nyăngz iz lanh toonz lêpc ninyh, Nănh songđ numđ stauh zâuđ nzongf. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Wax zanyf Nănh coong ănz stiz: “Yaz nyăngz stimz nyâuđ stauh tuz tauv tayc, oix zuc sting điub cloon yaz yămz nây.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Nănh staox ninyh tix cay timb songđ quâyc buc wa, cloo Zâu yâuc coong: “Yaz nyăngz Pha lex, năngđ coong hayh joođ zaub nâyx nomz zan gâyh yaz. Six max zâyf âyz yaz nyăngz âyx, six âyz Pha nyăngz âyx.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Nănh lauf stayb sây buz wa yâuc phătc stiz poc wa mâyc njoomh, Nănh songđ coong ănz Pi-tê: “Nyâuh bix max căn yaz, sting tuz cay ah săngx huđ hah? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Oix zuc bôngh stimz cloo Zâu phunz nyâuh max tuih nzac stâyv nyâuđ nyăngz jau. Stimz nyâuđ manyf njoongh six stinb a đoonh.” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Nănh zef setb ninyh tah nyâyc hâyđ timb, Nănh cloo Zâu coong: “Yaz nyăngz Pha lex, năngđ coong nâyx đomc dlayc max tuz quaix ninyh, yaz six zuc hopb nâyx nomz zan, yâuc joođ Pha nyăngz âyx tuz ayx săngh.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Nănh zef lauf tah nyâyc hâyđ timb, phătc stiz jinh đangh mâyc njoomh, stiz nyăngz mâyc niđ tâyh. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Ah hâyđ timb Nănh zef queengx stiz ănz wa Nănh setb ninyh cloo Zâu tah stamz hâyđ, lauf coong wax đomc wac năngđ wa nâyx timb. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Tăng wa Nănh lauf stayb sây buz wa yâuc coong ănz stiz: “Nyâuh năngx jinh mâyc njoomh hitb conv yah? Mangc geh, tauv săngx huđ gôh, Bamh Munh six zuc jaoz phunz wax đomc naih stoif nyăngz munh. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Zuc nyoongz quef, pănh ninyh gôh. Mangc yec, maic yaz wax tauh taih tauv nzof.”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Wax zanyf, Zâu Yê-su năngx jinh coong wac, phanv mangc, Yu-đatc, six ah lanh yămz wa săpc nyâyc lanh stayb sây, taih, yâuc cloon ah peob munh hongđ nzongf lêpc nănh taih nzauf nzuc đao cloon njăngx cănv, tăng wax đomc stayb munh cloon songx munh côx paiđ taih. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Wax zanyf, maic Nănh wax tauh ayx ah cuyb njic hoouđ phunz stiz pâyz, nănh coong: “Yaz tomz laiv lanh six wax lanh gôh, nyâuh oix zuc zoz nănh.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Yu-đatc songđ taih stătx Zâu Yê-su, yâuc coong: “La-bi lex!” songđ tomz Nănh. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Six Zâu Yê-su coong ănz nănh: “Yu-đatc lex, wâyc nâyx huungđ cumh pâuz mâyh bix taih nây.” Tăng wa stiz songđ taih stătx nongc puf toopz zoz Zâu Yê-su. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Six phanv mangc, naih ah lanh lêpc Zâu Yê-su ninyh wax đomc, songđ zaub puf taih, luutz nănh nyăngz nzuc đao yâuc ninyh jâu stayb munh pyây nyăngz ah tauh pâuz yâuc catz wax tauh pâuz nyăngz bah noomh setc. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Wax zanyf, Zâu Yê-su êu wax lanh munh: “Oix zuc zaub mâyh nyăngz nzuc đao ănz nănh nyăngz tinc, wâyc laiv lanh nzauf nzuc đao six zuc nzuc đao tayx tayc. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Max six mâyh nyâyh coong yaz bix max hayh toongx nâyx zanyf joođ yaz nyăngz Pha, êu Nănh paiđ phunz yaz blătc săpc nyâyc peob stinz munh peengz taih mah? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Năngđ ayx nâyx bix laiv hayh phunz canyx stâub coong nyăngz wac tuz setb taih heh, wâyc nâyx đomc dlayc six zuc setb taih ayx nâyx?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Toongx wax zanyf, Zâu Yê-su coong ănz wax peo munh: “Nyâuh nzâyz nzuc đao cloon njăngx cănv taih zoz yaz cayx năngđ ninyh zoz stac munh? Muif noib, yaz stâyv yămz bongc Zâu Tênb-Huungh nyăngz pyau nzaox gâyf nyâuh yâuc max zoz yaz. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Six nâyx đomc muif huungđ dlayc setb taih nongc phunz toix nzuf wax đomc tâuc wac munh ja nyăngz wac.” Wax zanyf, wax đomc stayb sây tinyh đoih tiuv nzuf, queengx Nănh ănz wa.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Tăng wa, ninyh zoz Zâu Yê-su wax đomc ênz Nănh lauf phunz stayb munh pyây Ca-ya-phatx wa, wax cuyb tinc six wax đomc nzaox gâyf stênx steengb cloon wax đomc munh côx căpx dlonf yămz wa. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Six Pi-tê yămz côz côz lêpc Nănh ninyh tauv stayb munh pyây nyăngz tinc peengh yâuc nzac cah njaf ninyh, nănh cloon wax đomc zu jeengh peengz tinyh đoih stâyv wa mangc jađ ayx laix. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Wax zanyf, wax đomc stayb munh cloon ayx côx munh tinyh đoih lov za zanyx manyf munh nongc cooux Zâu Yê-su, ayx laix tuz phunz stiz hayh tingc tayx Nănh. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Six stiz max lov tuz laiv luungđ zanyx manyf, manyf naih đuungx lanh ayx za zanyx manyf. Tăng wa, zef naih iz lanh staox taih, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />yâuc coong: “Lâyc tauh munh coong: ‘Yaz hayh zeb bongc Zâu Tênb-Huungh nyăngz pyau pôz noib cah njaf yâuc ayx tuz săngh.’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Wax tauh stayb munh pyây, songđ nyoongz quef coong ănz Nănh: “Mâyh max coong luungđ hah? Lâyc đomc munh yămz lâyc ayx luungđ zanyx manyf cooux mâyh nâyx heh?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Six Zâu Yê-su max nyaoc. Stayb munh pyây coong ănz Nănh: “Yaz nuz săngh nyăngz Zâu Tênb-Huungh zăpx mâyh, mâyh oix zuc coong phunz buz pâyz, mâyh six zâyf Zâu Jix-Tuz, Zâu Tênb-Huungh nyăngz Toonz, max zâyf?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Zâu Yê-su coong ănz nănh: “Six mâyh cănh coong ayx nâyx. Năngđ nây, yaz coong phunz nyâuh pâyz, tăng nâyx zanyf, nyâuh six tuz phătc Bamh Munh stâyv yămz naih jab wax Tau nyăngz byaoh phanx, yâuc hinđ setb tăng cah zâyc vănx nzac taih.” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Tăng wa, wax tauh stayb munh pyây zeb nănh nyăngz guyz, yâuc coong: “Nănh coong pamf! Pănh laiv năngx zâuđ nongc zanyx manyf munh nzof heh? Mangc geh, nâyx zanyf nyâuh tuz numđ nâyx đomc coong pamf wac nzof. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Nyâuh nyâyh jađ ayx laix?” Stiz tauz coong: “Nănh senz hoopđ zuc tayc.” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Tăng wa, stiz nzuv nzanh ănz Nănh nyăngz minb, bopc Nănh, yâuc beb Nănh nyăngz minb, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />yâuc coong: “Zâu Jix-Tuz lex, tâuc wac phunz buz mungv jađ, toix laiv lanh bopc mâyh geh?”<verse eid="MAT 26:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Wax zanyf, Pi-tê jinh đangh stâyv wa cungh ngwaic peengh, songđ naih ah lanh sab pâuz taih stătx nănh, yâuc coong: “Mâyh six Ga-li-lê munh cloon Yê-su songc yămz.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Six nănh yămz munh tinyh đoih nyăngz cah đangc pyenv coong: “Yaz max pâyz tuz mâyh coong luungđ.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Zef setb ninyh tauv jeengh, pitc lanh pâuz sab phătc nănh yâuc coong ănz wax đomc munh yămz wa, coong: “Lâyc tauh six Na-sa-leetx munh, lauf cloon Yê-su songc yămz.” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Nănh zef pyenv yâuc nyunc coong: “Yaz max pâyz wax tauh munh!” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Ah zanyf têx, wax đomc munh stâuđ wa, staox taih stătx zef coong ănz Pi-tê, coong: “Mâyh senz cloon wax peo munh songc yămz lêc, mungv mâyh coong nyăngz wac six saz tuz mâyh nzec.” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Wax zanyf, nănh songđ zaux, yâuc nyunc coong: “Yaz senz max pâyz wax tauh munh,” songđ toongx sangf, zayz ayx caix. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Pi-tê songđ săngx tauv Zâu Yê-su coong wax đomc wac, coong: “Zayz max zeengx ayx caix, mâyh six pyenv yaz pôz hâyđ.” Tăng wa nănh songđ tiuv ninyh wa cungh ngwaic haoh, nănh numđ munz stimz nzongf.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Wax zanyf, toix bah đoomz tonx njâu, wax đomc muif lanh stayb munh cloon wax đomc songx munh côx tinyh songc sangv ta zux ix tămx Zâu Yê-su nongc tayx Nănh tayc. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Stiz stayb Zâu Yê-su yâuc ênz ninyh jaoz phunz quanz pyây Phi-latx.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Tăng wa, Yu-đatc maic Zâu Yê-su wax tauh, phătc Zâu Yê-su zuc tingc, songđ cănh numđ nhlenx nănh, yâuc nzâyz wa stamx săpc leepz nyanh pec ninyh toiv phunz wax đomc stayb munh cloon wax đomc munh côx, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />yâuc coong: “Yaz pamf stoif wâyc yaz maic max naih stoif nyăngz samđ.” Six stiz coong: “Max quenđ tauv buz? Mâyh cănh đamz toongz.” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Nănh quanyf wax đomc nyanh pec ănz wa bongc Zâu Tênb-Huungh nyăngz pyau, songđ setb ninyh, ninyh gâyh côz songđ điux clangz tayc. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Wax zanyf, wax đomc stayb munh zoz wax đomc nyanh pec taih, yâuc coong: “Phunz nâyx đomc nyanh pec yămz nây bongc Zâu Tênb-Huungh nyăngz pyau nyanh hoomh six max hoopđ wâyc nây six maif samđ nyăngz zax.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Tăng wa stiz sangv tuz, songđ nzâyz wax đomc nyanh pec ninyh maif ayx nib stangc munh nyăngz ah tootz njingh njâuh nongc plopx wax đomc zeb munh njingc. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Năngđ nâyx, wax tootz njingh songđ hipđ ayx “njingh samđ” tuz tauv nâyx yenh. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Nâyx đomc, six tuz setb taih toix nzuf tăng tâuc wac munh Yê-lê-mi tâuc taih nyăngz wac, nănh coong: “Stiz nongc stamx săpc leepz nyanh pec, six tuz tingc taih wax tauh munh nyăngz zax, wax tauh six tăng I-sa-la-ên munh stunx taih nyăngz zax, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />stiz yâuc nongc wax cuyb nyanh pec ninyh maif nib stangc munh nyăngz ah tootz njingh, âyz năngđ Zâu bux yaz.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Wax zanyf, Zâu Yê-su stâuđ yămz quanz pyây nyăngz cah đangc, wax tauh quanz songđ stămđ Nănh, coong: “Mâyh zâyf Yu-tai munh nyăngz huungh max?” Zâu Yê-su coong ănz nănh: “Mâyh jinh đangh coong geh.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Nănh zuc wax đomc stayb munh cloon wax đomc munh côx cooux, six Nănh max tauz zâux tiny. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Tăng wa Phi-latx coong ănz Nănh: “Mâyh max numđ stiz jinh đangh cooux mâyh nâyx đomc nyăngz zanyx manyf wac hah?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Nănh yâuc max tauz wax tauh quanz tiny, hănđ ah zâux yâuc max tauz, ayx tuz wax tauh quanz pyây numđ njingc nzongf. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Wax zanyf, tauv stêtz, six toix quanz pyây nyunc pungx ah tauh stoif munh phunz songx munh âyz stiz cănh sên taih. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Six, toongx wax zanyf, stiz lauf clăngđ ah tauh stoif munh naih manyh yangh hipđ ayx Ba-la-batc. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Năngđ nâyx tauv songx munh căpx dlonf wa, Phi-latx naic stiz: “Nyâuh oix nongc yaz pungx mănv phunz nyâuh heh? Ba-la-batc, max six Yê-su, hipđ ayx Zâu Jix-Tuz wax tauh?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Wâyc nănh pâyz tuz coong stiz jaoz Zâu Yê-su phunz nănh six wâyc numđ hănđ. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Wax zanyf, nănh jinh đangh stâyv wa tinc stămđ stoif, nănh nyăngz au pungx wac taih ănz nănh, coong: “Tuz mungc max naih luungđ dlayc setb phunz mâyh căn wax tauh peengh stimz munh. Wâyc nâyx noib, yaz wâyc nâyx tauh munh bix bâyx cumh nzav nzongf.” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Six wax đomc stayb munh cloon wax đomc munh côx lungz wax đomc songx munh êu stiz joođ pungx Ba-la-batc bix tayx Zâu Yê-su. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Wax tauh quanz pyây songđ naic stiz coong: “Nây iz lanh nyâuh oix nongc yaz pungx mănv phunz nyâuh heh?” Stiz songđ coong: “Ba-la-batc.” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Phi-latx naic stiz: “Ha, yaz six zuc ayx laix ănz Yê-su hipđ ayx Zâu Jix-Tuz wax tauh heh?” Stiz tinyh đoih hamv coong: “Nănh six zuc tingz ănz wa săpc đăngc zax.” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Six Phi-latx coong: “Nănh ayx longđ laiv huungđ huđ heh?” Stiz zef hamv năngx lub têx, coong: “Zuc tingz jămz nănh ănz săpc đăngc zax.” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Tăng wa Phi-latx numđ nănh max hayh stăngc tuz luungđ, six plănc taih, songx munh cun hamv cun lub, nănh zoz womz taih, toongx songx munh đaox nănh nyăngz puf, yâuc coong: “Nâyx tauh munh nyăngz samđ six max quaix tauv yaz, nyâuh cănh đamz toongz.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Songx munh muif lanh songđ tauz coong: “Nănh nyăngz samđ six yămz buz cloon buz nyăngz sây stunz.” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Tăng wa, Phi-latx pungx Ba-la-batc phunz stiz, yâuc êu bopc Zâu Yê-su tuz, songđ phunz ênz Nănh ninyh nongc tingc ănz săpc đăngc zax.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Wax zanyf, tăng stiz ênz Zâu Yê-su nzac quanz pyây nyăngz peengh ninyh, quanz pyây wax đomc peengz tinyh đoih taih nzoomf Nănh wa cah đangc nzuf. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Stiz zay Nănh nyăngz guyz, yâuc pâyb ah byenđ guyz stib ănz Nănh. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Stiz yâuc nongc nzim sitx tuz ah nomz moouc, đongx ănz Nănh nyăngz pyây, yâuc phunz Nănh nyăngz byaoh puf, nzauf ah stinz lauđ tic queeng, songđ quâyc nzac paix Nănh wa cah đangc yâuc cah đanyc nhlef Nănh, coong: “Paix Yu-tai munh nyăngz Huungh!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Yâuc cakb nzanh nzuv ănz Nănh, stiz zoz lauđ tic queeng bopc Nănh nyăngz pyây. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Stiz pib nhlef Nănh tuz, songđ zay wax byenđ guyz đao queengx yâuc zoz Nănh nyăngz guyz zuz phunz Nănh, tăng wa songđ ênz Nănh ninyh nongc tingz jămz ănz săpc đăngc zax.<verse eid="MAT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Stiz setb ninyh wax zanyf, phătc ah lanh Sai-lin munh, bux hipđ ayx Si-môn, stiz songđ phađ nănh đamz Zâu Yê-su nyăngz săpc đăngc zax. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Stiz ninyh tauv ah cuyb tinc hipđ ayx Gô-gô-ta, wax cuyb tinc âyz gâyf six “pyây goongđ tinc,” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />stiz zoz tiu zanb ănz tam imz phunz Nănh hopb. Nănh đopx mungv, yâuc max hopb. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Wax zanyf, stiz tingz Zâu Yê-su ănz săpc đăngc zax tuz, stiz zoz Nănh wax byenđ guyz taih tinyh phunz songđ tinyh tâu nyupx tăm, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />stiz stâyv yămz wa jămđ Nănh. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Nănh nyăngz pyây cah zâyc, stiz ănz ah nomz bangz ja cooux Nănh nyăngz stoif jau, coong: “Nây six Yê-su, Yu-tai munh nyăngz Huungh.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Wax zanyf naih iz lanh stac munh cloon Nănh zuc tingz jămz, ah lanh yămz byaoh phanx, ah lanh yămz staix phanx. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Wax đomc munh pitb wa pib mađ Nănh, yâuc bănx stiz nyăngz pyây <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />yâuc coong: “Mâyh lâyc tauh Zeb bongc Zâu Tênb-Huungh nyăngz pyau pôz noib Cah njaf yâuc ayx tuz săngh, bix cănh njâuv mâyh geh! Năngđ coong mâyh six Zâu Tênb-Huungh nyăngz Toonz, bix cănh nzac lâyc săpc đăngc zax taih gôh!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Lauf tinyh năngđ, wax đomc stayb munh, cloon wax đomc nzaox gâyf stênx steengb, cloon wax đomc munh côx, lauf pib mađ Nănh, yâuc coong: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Nănh hayh njâuv tuz munh; bix max cănh hayh njâuv tuz nănh. Nănh năngđ coong zâyf I-sa-la-ên munh nyăngz Huungh. Nâyx zanyf bix nzac lâyc săpc đăngc zax taih. Pănh six zen nănh. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Nănh zen Zâu Tênb-Huungh; nâyx zanyf năngđ coong Zâu Tênb-Huungh oix cănh taih njâuv nănh. Wâyc nănh coong: ‘Yaz six Zâu Tênb-Huungh nyăngz Toonz.’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Nzof, cănh wa iz lanh stac munh, cloon Nănh zuc tingz jămz, yămz wa stiz lauf pib Nănh.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Wax zanyf, tăng săpc nyâyc săngx huđ lomc wax nomz stâyz phangz naih guungh nib nzămc tuz tauv cayx nzămc pôz săngx huđ. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Tăng wa tauv cox pôz săngx huđ, Zâu Yê-su hamv stingb lub, coong: “Ê-li, Ê-li, la-ma sa-bak-ta-ni?” âyz gâyf six coong “Yaz nyăngz Zâu Tênb-Huungh lex, yaz nyăngz Zâu Tênb-Huungh, săngh laix Mâyh bix quanyf yaz?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Six wax đomc munh stâuđ wa, numđ songđ coong: “Nănh êu Ê-li-ya.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Naih ah lanh yămz stiz wax peob, songđ coonx tiuv ninyh zoz zeengb stotb taih yoomf tiu stuib womz, tipb ănz wa lauđ tic pya đany, yăngf ninyh phunz Nănh hopb. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Six năngx naih wax đomc yâuc coong: “Phanv dluyh nănh gôh. Pănh mangc jađ Ê-li-ya six taih njâuv nănh max.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Tăng wa, Nănh hamv ah stingb lub timb, Nănh songđ siv setc. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Six phanv mangc, yămz bongc Zâu Tênb-Huungh nyăngz pyau cah njaf wax leepz buyx songđ tăng cah zâyc byaif đotc cah đi ayx iz phanx, nib yâuc tongf, njăuz pyây lub yâuc beengb. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Đuungx nomz stâu toc taih yâuc naih đuungx lanh peengh stimz munh tayc tuz săngh taih. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Tăng stâu săngh taih wax đomc, tauv Zâu Yê-su săngh taih blătc, stiz nzac wa đăngb zeengh dlanyh ninyh yâuc hinđ phunz đuungx lanh munh phătc. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Tăng wa, phătc wax đomc nib tongf cloon wax đomc dlayc setb taih, peengz pyây cloon wax đomc peengz căn nănh yămz wa jămđ Zâu Yê-su wax đomc, songđ cumh nzav nzongf, yâuc coong: “Lâyc tauh munh, senz zâyf Zâu Tênb-Huungh nyăngz Toonz gôh.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Yâuc năngx naih đuungx lanh munh nzif yămz wa, côz côz mangc, wax đomc six tăng yămz Ga-li-lê bix ninyh lêpc Zâu Yê-su yâuc bokc dlic Nănh wax đomc. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Yămz stiz wax peo naih Mak-đa-la nyăngz Ma-li-ya, Ya-coopc cloon Yô-sepx nyăngz nzif Ma-li-ya, cloon Sê-bê-đi iz lanh toonz nyăngz nzif.<verse eid="MAT 27:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Wax zanyf, tauv cayx nzămc, naih ah lanh puv quâyx munh tăng A-li-ma-tê taih bux hipđ ayx Yô-sepx, nănh six lauf ah lanh lêpc Zâu Yê-su ayx stayb sây. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Nănh ninyh pongh Phi-latx, joođ Zâu Yê-su nyăngz stayđ. Wax zanyf, Phi-latx songđ setb lanyf êu jaoz phunz nănh. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Zoz stayđ tuz, Yô-sepx nongc ah cuyb đôc buyx săngb sênh pêuz wax nomz stayđ, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />songđ nzâyz stayđ ninyh ănz nănh wax nomz săngb stâu ngamh nănh stuc wa njăuz ayx taih. Nănh cluiz ah nomz njăuz pyây taih zetx wa stâu jeengh cah nzetx, songđ muf. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Wax zanyf, Mak-đa-la wax tauh Ma-li-ya, cloon pitc tauh Ma-li-ya yămz wa, stâyv wa stâu toix nganc.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Tauv nyâyc noib, six blătc bênc cumh pâuz wax noib, wax đomc stayb munh cloon wax đomc Pha-li-si munh taih căpx dlonf yămz Phi-latx nyăngz cah đangc, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />yâuc coong: “Quanz lex, buz săngx tauv nănh năngx jinh săngh wax zanyf, wax tauh puv maoh munh coong: ‘Pôz noib cah đangz yaz six tuz săngh taih.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Wâyc nây, joođ setb lanyf jămđ wax nomz stâu tuz tauv wax noib pôz. Săngx đanyf, nănh wax đomc stayb sây taih nimc nănh nyăngz stayđ ninyh, zef coong ănz songx munh coong: ‘Nănh tuz tăng tayc săngh taih,’ tauv wax zanyf wax đomc puv maoh nyăngz jau zef năngx lub têx cah đangc timb.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Tăng wa, Phi-latx coong ănz stiz: “Nyâuh naih peengz jămđ lêc. Ninyh gôh, âyz nyâuh pâyz nyăngz bix jămđ năngx gongx.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Tăng wa stiz ninyh, tăpb yenx ănz wa stâu jeengh êu wax đomc peengz jămđ, leđ wax nomz stâu năngx gongx.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Wax zanyf, blătc tingc congz noib, six gâyf paix nyăngz tah yetx noib bah đoomz tonx njâu, Mak-đa-la nyăngz Ma-li-ya cloon pitc tauh Ma-li-ya ninyh tex stâu. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Six phanv mangc, naih nib tongf niđ nzongf setb taih, Wâyc naih Zâu nyăngz stinz munh tăng guungh nzac taih tauv, clinyx wax nomz njăuz pyây yâuc stâyv wa cah zâyc. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Wax zanyf, stinz munh nyăngz hanyh jangx six cayx năngđ bungh bitc tâuf, nănh nyăngz guyz pec cayx năngđ toongb. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Nzof, wâyc wax tauh stinz munh nyăngz đănz tongf, wax đomc peengz songđ glinyf wa cayx năngđ munh tayc nâyx. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Six stinz munh coong ănz wax đomc munh nzif: “Nyâuh năngx gâyf cumh nzav, wâyc yaz pâyz coong nyâuh lov Yê-su, zuc tingz jămz wax Tauh. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Nănh max yămz nây đêh, Nănh tuz săngh taih nzof gôh, cayx năngđ Nănh coong nâyx. Staox taih geh, mangc tăpx Nănh ănz nyăngz tinc. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Mangc tuz bix phunb đangz muf, lănv bux phunz Nănh nyăngz stayb sây coong: ‘Nănh tuz tăng tayc săngh taih nzof. Phanv mangc, Nănh ninyh Ga-li-lê đangc nyâuh. Yămz wa nyâuh six tuz phătc Nănh.’ Mungv bex, yaz bux phunz nyâuh pâyz đangc nzof.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Stiz songđ coonx setb stâu taih yâuc cumh nzav yâuc numđ nyađ nzongf, coonx muf bux ănz Nănh wax đomc stayb sây. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Six phanv mangc, Zâu Yê-su taih pongh stiz, yâuc coong: “Peengh oonz gôh bex!” Stiz songđ taih stătx, jom Nănh nyăngz staux yâuc paix Nănh. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Tăng wa, Zâu Yê-su coong ănz stiz: “Năngx gâyf cumh nzav. Oix zuc ninyh, bux ănz yaz nyăngz yâuf pez êu stiz ninyh Ga-li-lê, yămz wa, stiz six phătc yaz.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Wax zanyf, stiz jinh đangh setb jau muf, Phanv mangc, wax đomc jămđ stâu peengz, nzac wa dlanyh muf, lănv nâyx đomc setb taih nyăngz dlayc ănz wax đomc stayb munh. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Wax đomc stayb munh songđ cloon wax đomc munh côx, căpx dlonf sangv soongb, songđ phunz nyanh đuungx phunz wax đomc peengz, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />yâuc zăpx coong: “Oix zuc lănv coong: ‘Tauv đamx munf buz jinh đangh mâyc njoomh nănh nyăngz stayb sây bix taih nimc nănh nyăngz stayđ.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Nzof năngđ coong nâyx đomc wac ninyh bux tauv quanz pyây pâyz, buz cănh căn nănh coong phunz nyâuh max zuc naih luungđ wac.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Tăng wa, peengz stipx nyanh, songđ ayx âyz stiz zăpx wax đomc wac. Nâyx đomc wac yâuc tuz lănv quăng ninyh yămz Yu-tai munh, ayx tuz tauv nâyx yenh.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Wax zanyf săpc byetx lanh stayb sây ninyh tauv Ga-li-lê, ninyh tauv Zâu Yê-su bux phunz stiz wax nomz zoongz. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Tauv phătc Nănh stiz songđ canyx bongc Nănh, six naih ah phanx yâuc max zen. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Zâu Yê-su taih stătx căn stiz coong wac, yâuc coong: “Yămz guungh yămz nib nyăngz muif huungđ lokc jangx yâuc tuz jaoz phunz yaz nzuf. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Wâyc nây, nyâuh oix zuc ninyh bux manf stingx munh zen, yâuc tim Pha, tim Toonz, cloon Zâu Singx-Lingh nyăngz manyh ayx quaix-gâyf phunz stiz; <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />yâuc nzaox stiz ayx âyz yaz bux phunz nyâuh nyăngz muif huungđ. Mungv bex, yaz six cloon nyâuh yămz tuz tauv stêtb mâyv.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>