  <book code="1TI" style="id">EN_DADT mji-x-daoaodai_Dao⋅Ao⋅Dai_ltr Thu May 21 2026 15:07:18 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">Tah Yetx Ti-mô-tai Jenx</para>
  <para style="toc2">1 Ti-mô-tai</para>
  <para style="toc3">1Ti</para>
  <para style="mt">1 Ti-mô-tai</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Yaz, Phao-lô, âyz pănh nyăngz Njâuv Zâu, six Zâu Tênb-Huungh, cloon pănh naih njih mungc nyăngz Zâu Yê-su Jix-Tuz nyăngz lanyf, ayx Zâu Yê-su Jix-Tuz nyăngz cumh pâuz munh,<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />pungx phunz Ti-mô-tai, senz yaz nyăngz toonz yămz zen stimz cah njaf:</para>
  <para style="p" vid="1TI 1:2">Joođ Zâu Tênb-Huungh, six Pha cloon pănh nyăngz Zâu Yê-su Jix-Tuz, hâuđ lênh, sađ pôz, sađ peengh oonz phunz mâyh.<verse eid="1TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Cayx năngđ yaz setb jau ninyh Ma-si-đô-ni wax zanyf, bix êu mâyh zuc yămz wa Ê-phê-sô nongc phunz mâyh zăpx bux wax đomc munh năngx gâyf nzaox pitc huungđ gâyf, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />yâuc năngx gâyf mungv tauv wax đomc max naih luungđ âyz gâyf nyăngz câu cloon wax đomc stu stongz max hayh zomc, wax đomc six cungb hayh ayx phunz munh tinyh nzeengz cuungv, max hayh stăngc tuz phunz Zâu Tênb-Huungh nyăngz cumh pâuz lub staox, six tuz ayx săngh yămz zen stimz nyăngz cumh pâuz. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Yaz zăpx nâyx đomc wac six yămz stăngz nyăngz jau cloon đăngb zeengh nyăngz stimz nyâuđ, cloon stimz nyâuđ gongx cloon senz zen nyăngz jau, <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />six naih ah phanx munh, quanyf nâyx đomc jau, bix ninyh nzeengz wax đomc max setb luungđ nyăngz jau, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />oix ayx stênx steengb nzaox gâyf, six yâuc max manyh pec stiz coong nyăngz wac cloon stiz zen tingc nyăngz jau.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Six pănh pâyz tuz coong, gâyf njanh six gongx, năngđ coong munh hayh nongc gâyf njanh tuz toix jau, <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />wâyc pâyz tuz coong, gâyf njanh six max zâyf njăpc taih nongc phunz peengh stimz nyăngz munh, six nongc phunz pamf gâyf nyăngz munh cloon max mungv wac nyăngz munh, max zen gongx Zâu nyăngz munh cloon pamf stoif nyăngz munh, max zen nyăngz munh, cloon coong pib nyăngz munh, tayx nzif, tayx pha nyăngz munh, cloon tayx munh nyăngz munh, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />ayx pongz lauh nyăngz munh, munh toonz nongc munh toonz munh nzif nongc munh nzif nyăngz munh, nimc munh maic nyăngz munh, puv maoh nyăngz munh, ayx za zanyx manyf nyăngz munh, cloon yetx stong nzeengz cloon senz gâyf nyăngz munh tauv laiv, <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />nây six âyz Zâu Tênb-Huungh gwăngz eeng nyăngz Cuđ Jenx gâyf, nzof yaz yâuc tuz jaoz phunz nongc nzônh nâyx huungđ gâyf.<verse eid="1TI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Yaz sâuf hâuđ pănh nyăngz Zâu, six Zâu Yê-su Jix-Tuz, senz sađ jab phunz yaz wax Tauh, wâyc Nănh zah phătc yaz six săngh zen mungc, songđ oonz yaz nongc ayx cumh pâuz, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />max cun cah đangc yaz six ah tauh coong pamf Zâu nyăngz munh, ayx huđ yâuc ayx đokc ănz, six yaz yâuc tuz Zâu hâuđ lênh wâyc yaz max zeengx pâyz luungđ, yămz yaz max zen bix ayx wax đomc. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Six, pănh nyăngz Zâu senz naih pôz lub nzongf cloon zen stimz cloon stăngz nyăngz jau yămz Zâu Yê-su Jix-Tuz.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Nâyx zâux wac six senz nyăngz yâuc hoopđ zuc stipx năngx nzuf, nây six: “Zâu Yê-su Jix-Tuz nzac bamh canz taih nongc njâuv stoif munh” — nzof yămz wax đomc stoif munh tauv laiv, yaz six ayx pyây. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Yaz tuz hâuđ lênh, six wâyc năngđ nâyx, nây six nongc phunz Zâu Yê-su Jix-Tuz hayh tuz hinđ manyf nzuf Nănh nyăngz stimz đao yămz yaz cah njaf, ah lanh naih stoif lub quaix nyăngz munh, nongc ayx ah huungđ zanyx manyf phunz wax đomc zen caođ Nănh nyăngz munh hayh tuz naih stâyv quâyx nyăngz mengc. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Cloo stâyv quâyx yămz nyăngz Huungh, senz mangc max phătc nyăngz ah tauh Zâu Tênb-Huungh tuz zanyb saix yâuc tuz gwăngz eeng, tauv banc stâyv banc đaic. A-meen.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Yaz nyăngz toonz, Ti-mô-tai lex, yaz zăpx bux mâyh nâyx đomc wac, âyz năngđ cah đangc naih tâuc wac coong tauv mâyh wax đomc wac nâyx, phunz păngc wax đomc wac, mâyh bix hayh bopc tuz gongx nyăngz zax, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />cayb nzauf zen stimz cloon stimz nyâuđ gongx năngx tăngđ, naih ah phanx munh quanyf nâyx đomc jau, stiz nyăngz zen stimz songđ zuc sêmh nzac, <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />yămz wax đomc munh six naih Hi-mê-nê-atc cloon A-lek-san-đê, yaz yâuc jaoz stiz phunz Sax-tanx nzof gôh, wâyc phunz stiz hayh tuz nzaox nzăngđ max coong pamf Zâu.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Wâyc nây, tah yetx yaz zăpx mâyh coong, oix zuc cloo Zâu joođ, yâuc cloo Zâu sâuf hâuđ tayv phunz munh tinyh đoih, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />phunz wax đomc huungh stix cloon yetx stong ayx quanz nyăngz munh tauv laiv, phunz pănh yămz nây stâyv sangc hayh tuz banyh banyh yămz, yâuc tuz gwanb stimz lêpc gongx Zâu yâuc tuz yămz gongx. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Nâyx six gongx nyăngz yâuc hoopđ pănh nyăngz Njâuv Zâu, six Zâu Tênb-Huungh, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />Nănh oix nongc muif lanh munh tuz njâuv yâuc pâyz tuz senz gâyf. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Wâyc cungb naih ah tauh Zâu Tênb-Huungh cuungv yâuc cungb naih ah Tauh yămz Zâu Tênb-Huungh cloon bamh munh mungh tongx — six Zâu Yê-su Jix-Tuz, ah tauh bamh munh, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />Nănh nyunc sađ cănh nyăngz mengc nongc ayx zax stinh suc muif lanh munh, cayx năngđ zanyx manyf wac taih toix săngx huđ nâyx, <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />yâuc wâyc nâyx huungđ zanyx manyf wac, yaz bix tuz njăpc taih ayx nzônh gâyf munh cloon cumh pâuz munh — yaz coong senz yămz Zâu Jix-Tuz, yaz max coong jaf — yaz ayx stênx steengb phunz wax đomc pitc stingx munh zen yâuc pâyz senz gâyf.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Năngđ nây, yaz oix nongc yămz muif nomz tinc nyăngz munh pha tinyh đoih stuungb đăngb zeengh nyăngz puf staox guungh ninyh cloo Zâu, năngx gâyf siv totc yâuc năngx gâyf tinyh panx, <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />lauf tinyh năngđ, yaz oix nongc wax đomc munh nzif, zoongz zuz năngx toix jau, ayx stimz nyâuđ dlênc, yâuc hayh cun tuz cănh, nongc zoongz cănh nyăngz stinb, max zâyf coong binf pyây đongz max six zoongz sămz, zoongz zâuz, max six guyz quav saix, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />yâuc ayx muif huungđ cumh pâuz gongx nzăngđ payh tuz hipđ ayx cumh nzav Zâu Tênb-Huungh nyăngz munh nzif.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Munh nzif oix zuc stingb njâuh mungv munh nzaox gâyf, oix zuc buc năngx nzuf. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Nzof, yaz max phunz munh nzif nzaox max six nzauf lanyf cun munh pha, six oix zuc stingb njâuh. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Wâyc A-đam tuz zuyx taih đangc, nzof nzăngđ tauv Ha-wa, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />yâuc max zâyf A-đam zuc jaf, six munh nzif zuc jaf, bix zuc longđ stoif. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Six năngđ coong munh nzif njinh luh zen gongx, stăngz munh, yâuc đăngb zeengh, nyâyh gongx nyăngz jau, yâuc păngc steengb sây stiz six tuz njâuv.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Nâyx zâux wac six senz nyăngz: “Năngđ coong laiv lanh oix ayx jiux pangx nyăngz munh côx, wax lanh munh oix ayx nyăngz cumh pâuz six gongx nzongf.” <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Năngđ nây, ayx jiux pangx nyăngz munh côx six oix zuc max naih tinc nzêmh, cungb nongc ah lanh au cuungv, pâyz bôngh stimz, hayh cun tuz cănh, wăn stimz, naih nyâuđ stipx zeb, hayh nzaox tuz munh, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />max blaz tiu, max sêu lunc, six zuc dlênc, yâuc gongx, yâuc max mauh nyanh, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />hayh cun tuz gongx cănh nyăngz pyau munh, hayh nzaox sây mungv wac yâuc pâyz gâyf clăkx clunh nzuf, <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(wâyc năngđ coong laiv lanh munh max hayh cun nănh nyăngz pyau munh, nănh ayx laix hayh jămđ tuz Zâu Tênb-Huungh nyăngz Jiux Pangx?), <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />ah yac săngđ zen nyăngz munh max hoopđ zuc ayx jiux pangx nyăngz munh côx, wangb nănh hayh ayx lub bix zuc tingc stoif cayx năngđ manđ nâyx. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Ayx jiux pangx nyăngz munh côx yâuc zuc naih jiux pangx cungh ngwaic nyăngz munh ayx gongx nyăngz zanyx manyf, nănh nzăngđ max zuc munh hib yâuc max zuc manđ nyăngz ploz lopb.<verse eid="1TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Lauf tinyh năngđ, wax đomc pangx pôx munh oix zuc wăn stimz, max tuz coong iz zâux wac, max tuz blaz tiu, max mauh tax huungđ, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />oix zuc nongc đăngb zeengh nyăngz stimz nyâuđ jămđ gongx nây plongx yangh nyăngz zen stimz. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Nzof yâuc, oix zuc stâyv stiz mangc đangc, phătc max naih tinc nzêmh, nzof mănc phunz stiz ayx cumh pâuz.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />Wax đomc au lauf tinyh năngđ, oix zuc wăn stimz, max tuz coong wac huđ, hayh cun tuz cănh, yămz manf dlayc yâuc ayx nyâuđ zanyx.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />Wax đomc pangx pôx munh oix zuc cungb nongc ah lanh au cuungv, hayh cun tuz gongx cănh nyăngz sây cloon pyau njaf munh. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Wâyc wax đomc ayx cumh pâuz gongx nyăngz munh, six tuz naih manyh tauh gongx, yâuc tuz pungx zen stimz yămz Zâu Yê-su Jix-Tuz.<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Yaz ja tix cay nâyx đomc wac phunz mâyh, senz numđ oix tuz ninyh pongh mâyh năngx căn, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />six năngđ coong yaz max tuz ninyh căn, mâyh yâuc hayh pâyz tuz oix zuc ayx năngđ laix yămz Zâu Tênb-Huungh nyăngz pyau, senz stâyv quâyx săngh wax Tauh Zâu Tênb-Huungh nyăngz Jiux Pangx, six senz gâyf nyăngz njâuh cloon coonz tay. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Nâyx đomc hinđ yangh yămz zen gongx nyăngz jau senz lub nzongf:</para>
  <para style="q" vid="1TI 3:16">“Senz tuz hinđ setb taih săngh tauh bamh munh wax Tauh,</para>
  <para style="q" vid="1TI 3:16">tuz Singx-Lingh stunx ayx peengh stimz,</para>
  <para style="q" vid="1TI 3:16">yâuc tuz stinz munh mangc phătc,</para>
  <para style="q" vid="1TI 3:16">tuz nzônh yămz manf stingx munh mungh tongx,</para>
  <para style="q" vid="1TI 3:16">tuz guungh đi munh zen mungc,</para>
  <para style="q" vid="1TI 3:16">tuz ênz muf yămz gwăngz eeng cah njaf.”<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Singx-Lingh manyb manyf nyăngz coong, tauv stêtb mâyv nyăngz noib lav, six naih munh đuungx quanyf stiz nyăngz zen stimz, ninyh mungv manđ jaf yâuc lêpc manđ nyăngz gâyf, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />tăng wax đomc pâyc zac nyâuđ yootz nyăngz munh, stiz nyăngz stimz nyâuđ zuc bi ninyh nzuf, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />stiz cangđ max phunz munh zoongz pyau, yâuc êu njif wax đomc nhlinc hopb, senz Zâu Tênb-Huungh zuyx taih nongc phunz naih nyâuđ zen yâuc pâyz tuz senz gâyf wax đomc munh nongc nyâuđ sâuf hâuđ bix stipx. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Wâyc Zâu Tênb-Huungh zuyx taih nyăngz muif huungđ six gongx nzuf, max naih laiv huungđ săngh quanyf ax tinyh, phanv nongc nyâuđ sâuf hâuđ bix stipx six tuz, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />wâyc nhlinc hopb six tuz stav đăngb zeengh taih, păngc yămz Zâu Tênb-Huungh nyăngz wac cloon cloo Zâu nyăngz wac.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Mâyh coong manyf nâyx đomc wac phunz yâuf pez, mâyh six săngh Zâu Yê-su Jix-Tuz ah lanh gongx nyăngz pâuz, tuz zen stimz nyăngz wac yuungf cloon mâyh lêpc nyăngz gâyf gongx. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Yâuc oix zuc pyenv goib munh bôf zongđ taih wax đomc max naih luungđ stuyh nyăngz câu. Six, oix zuc hoođ leenz cănh nyăngz stinb phunz hayh lêpc gongx Zâu, <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />wâyc zuc “hoođ leenz nây stinb a six tuz gongx max lauh, six hoođ lenz phunz hayh lêpc gongx Zâu six tuz gongx yămz muif huungđ, wâyc naih nyunc nyăngz wac phunz nâyx stâyv cloon cah đangz stâyv.” <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Nâyx đomc wac six senz săngh zen mungc yâuc săngh stipx năngx nzuf, <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />wâyc pănh ayx cumh pâuz zâuđ yâuc nzeengz zax phunz nâyx huungđ jau, wâyc pănh naih njih mungc yămz stâyv quâyx săngh nyăngz Zâu Tênb-Huungh, Nănh six manf munh nyăngz njâuv Zâu, tah yetx six phunz zen nyăngz munh.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Oix zuc zăpx bux yâuc nzaox nâyx đomc jau. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Năngx gâyf phunz munh mangc stam wâyc mâyh nyăngv gunx, six oix zuc ayx gao gongx phunz zen nyăngz munh, yămz coong nyăngz wac, cloon ayx nyăngz jau, yămz stăngz nyăngz jau, yămz zen stimz, yămz đăngb zeengh nyăngz jau. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Oix zuc vaic toc stâub, quinb bux, yâuc nzaox ayx tuz tauv yaz ninyh. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Năngx gâyf quanyf yămz mâyh cah njaf nyăngz pôz, senz mâyh tuz sađ phunz tăng tâuc taih nyăngz wac, cloon wax đomc jiux pangx nyăngz munh côx tăpx puf ănz mâyh wax huungđ pôz.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Oix zuc nzac jab hoođ wax đomc jau, phunz munh phătc mâyh naih cun pâyz cun yongb staox. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Mâyh oix zuc năngx cayb leđ cănh nyăngz stinb cloon mâyh nzaox nyăngz wac. Oix zuc nzuf stimz ayx wax đomc cumh pâuz, wâyc ayx năngđ nâyx mâyh six njâuv tuz cănh nyăngz stinb cloon mungv mâyh wax đomc munh.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Năngx gâyf coong wac niđ ănz nyăngv njăngb wax đomc munh claof, six oix zuc quinb stiz cayx năngđ pha nâyx, nzof wax đomc munh gunx six cayx năngđ yâuf pez nâyx, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />wax đomc nyăngv njăngb nyăngz munh bôf six cayx năngđ nzif nâyx, wax đomc munh gunx six cayx năngđ ô stayx nâyx, oix zuc ayx năngx đăngb zeengh clăkx clunh nzuf.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Oix zuc zanyb saix wax đomc au qua — six senb senz săngh au qua wax đomc munh. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Six năngđ coong laiv tauh au qua naih sây max six stunz, tah yetx six stiz wax đomc sây stunz zuc pâyz hâuđ lênh cănh nyăngz pyau munh, yâuc naih nyâuđ clao nzif pha nyăngz pôz, wâyc ayx nâyx six hoopđ Zâu Tênb-Huungh nyăngz nyâuđ. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Six, senb senz au qua nyăngz munh yâuc cungb cănh ah lanh đokc yămz wax đomc, songđ păngc caođ Zâu Tênb-Huungh yâuc noib munf nzac jab cloo Zâu yâuc joođ. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Six năngx naih wax đomc cungb tâuh nyađ nyăngz au qua, six hănđ săngh lauf cayx năngđ tayc. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Yâuc oix zuc zăpx nâyx đomc lanyf phunz stiz, nongc phunz stiz max naih tinc nzêmh. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Năngđ coong laiv lanh max stăngc cănh nyăngz jenb pyau munh, nongc sen six cănh nyăngz pyau njaf munh, wax tauh munh six pyenv zen stimz, nănh yâuc năngx huđ têx max zen nyăngz munh.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Ah lanh au qua nyăngz munh oix zuc beengc guc săpc nyăngv cah zâyc, yâuc cungb nongc ah lanh langh cuungv nzăngđ tuz staox bux ănz au qua tanz, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />yâuc zah mangc jađ nănh naih ayx gongx nyăngz cumh pâuz max: nănh hayh yuungf nzaox sây max, nănh hayh stipx zeb njingc max, nănh naih đaox staux phunz wax đomc đăngb zeengh munh max, nănh naih stăngc zâuđ nanc nyăngz munh max, nănh naih nzuf stimz nzuf nyâuđ ayx muif huungđ gongx nyăngz cumh pâuz max.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Six oix zuc pyenv năngx jinh gunx wax đomc au qua, wâyc tauv stiz oix ayx pongz lauh nyăngz jau stiz songđ gâyh goib Zâu Jix-Tuz, yâuc oix ninyh zoz langh, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />songđ zuc tingc stoif wâyc stiz quanyf cah đangc stiz nyunc quaix nyăngz wac. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Nzof, stiz yâuc cungb yămz quênx, ninyh nzac nâyx sênz pyau tauv wax sênz pyau, stiz yâuc max zâyf cungb cungb yămz cuungv, zef năngx coong nây coong wa, yâuc cungb oix lănv munh nyăngz jau, yâuc coong stiz max hoopđ zuc coong nyăngz wac. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Wâyc nây, yaz oix nongc năngx jinh gunx wax đomc au qua, ninyh zoz langh, steengb sây, jămđ cănh nyăngz pyau, phunz coong nzeengz wax đomc munh max naih jau coong pib. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Wâyc naih ah phanx gunx nyăngz au qua winb đangz ninyh lêpc Sax-tanx nzof.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Năngđ coong laiv lanh zen Zâu nyăngz munh naih au qua yămz wa pyau, six oix zuc stăngc stiz, nzăngđ max zâuđ wâyb tauv Jiux Pangx, nongc phunz Jiux Pangx hayh stăngc wax đomc senb senz au qua nyăngz munh.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Hayh cun jămđ Jiux Pangx wax đomc munh côx six hoopđ zuc zanyb năngx saix têx, tah yetx six nzônh zâu nyăngz gâyf yâuc nzaox munh wax đomc. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Wâyc Canyx Stâub coong: “Ngoongh wăngh nyuih blauh nyăngz săngx huđ, mâyh năngx gâyf pongz ngoongh nyăngz nzetx,” nzof “Ayx cumh pâuz nyăngz munh six hoopđ zuc tuz nănh nyăngz congz stinh.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Năngx gâyf stipx cooux nzeengz cloon jiux pangx nyăngz munh côx laiv zây stâub, năngđ coong max naih tauv iz max six pôz lanh zanyx manyf munh. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Ayx longđ nyăngz munh oix zuc toongx songx coong mađ, nongc phunz wax đomc năngx yăngc nzac nyăngz munh hayh pâyz tuz cumh nzav. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Yaz yămz Zâu Tênb-Huungh cloon Zâu Yê-su Jix-Tuz, cloon tuz sên taih wax đomc stinz munh nyăngz cah đangc, zăpx mâyh coong, mâyh zuc âyz nâyx đomc lanyf ayx, yâuc năngx gâyf coonx limb mănv, hănđ ayx laiv huungđ lauf năngx gâyf pyac mănv.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />Năngx gâyf coonx tăpx puf ănz mănv, yâuc năngx gâyf ninyh cloon munh đamz stiz nyăngz stoif. Oix zuc leđ cănh nyăngz stinb năngx đăngb zeengh.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Mâyh năngx gâyf cungb hopb womz cuungv, oix zuc nongc tix cay tiu wâyc mâyh nyăngz stib, cloon mâyh hayh pongh zuc yămz zâuđ.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Wâyc zuc naih ah phanx munh nyăngz stoif six tuz hinđ manyf setb taih, yâuc zuc stămđ stoif, six naih ah phanx stoif yâuc zuc stămđ blătc nzăngđ tuz hinđ manyf setb taih. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Lauf tinyh năngđ, naih ah phanx gongx nyăngz cumh pâuz six hinđ manyf setb taih, nzof naih ah phanx yâuc max tuz hinđ manyf, six yâuc max hayh tuz njinh luh pinyx vâyv.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Yetx stong ayx nâuh nyăngz munh tauv laiv, oix zuc nongc nyâuđ zanyb saix cănh nyăngz zâu, phunz Zâu Tênb-Huungh nyăngz manyh cloon nzaox nyăngz gâyf max zuc coong jămb. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Nzof, laiv lanh nâuh naih zâu six zen Zâu nyăngz munh, six năngx gâyf păngc coong stiz six yâuf pez bix mangc stam, six oix zuc bokc dlic năngx nzongf têx timb, wâyc stiz six stăngz nyăngz zen Zâu munh yâuc songc ayx Zâu cumh pâuz nyăngz munh. Mâyh oix zuc nzaox yâuc quinb bux nâyx đomc jau.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Năngđ coong naih munh nzaox pitc huungđ gâyf bix yâuc max stipx gongx nyăngz wac, six senz pănh nyăngz Zâu Yê-su Jix-Tuz nyăngz wac, cloon nzaox tauv lêpc gongx Zâu nyăngz jau têx, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />wax tauh six ayx lub nyăngz munh, max pâyz luungđ tiny, yâuc cungb oix ngwâyz naic yâuc tinyh panx, tinyh nzeengz stămđ wax đomc wac, songđ taux wa naih tinyh hănđ, tinyh nzeengz, hib nzêmh, lanh nyâyh huđ ănz lanh, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />naih tinyh zenđ, yămz wax đomc nyâuđ huđ nyăngz munh yâuc max naih senz gâyf, stiz nyâyh coong lêpc gongx Zâu six hayh tuz puv quâyx.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Six naih pong nyâuđ nyăngz jau cloon lêpc gongx Zâu nyăngz jau, nzăngđ senz nyăngz puv quâyx lub. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Wâyc pănh max nzâyz luungđ nzac bamh canz taih, wâyc nây pănh lauf max hayh nzâyz tuz luungđ muf. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Tinyh phanv naih năngv nhlinc, naih guyz quav zuz, pănh six oix zuc pong nyâuđ yămz nâyx đomc jau. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Six wax đomc oix tuz puv quâyx nyăngz munh, songđ tuih stauc stâyv nyâuđ nyăngz jau yâuc zuc ploz lopb, cloon đuungx huungđ stimz nyâuđ oix oongx nzongf nyăngz jau, six senz phunz munh stimz yuc nzac wax đomc max săngh luungđ nyăngz jau yâuc zuz mêtc. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Wâyc mauh nyanh nyăngz jau six muif huungđ okx nyăngz coonz tay, naih munh wâyc oix nongc nyanh bix zuc jaf ninyh gâyh zen stimz, yâuc hoiđ phunz stiz zuc pongh đuungx huungđ zâuđ nanc.<verse eid="1TI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Six sây lex, mâyh six Zâu Tênb-Huungh nyăngz munh, oix zuc pyenv goib wax đomc jau, bix lov peengh stimz nyăngz jau, lêpc gongx Zâu nyăngz jau, zen stimz, stăngz munh nyăngz jau, stimz đao, dlênc. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Oix zuc wâyc zen stimz bix bopc gongx nyăngz zax, oix zuc nzauf stâyv quâyx nyăngz mengc năngx sen, senz êu mâyh taih nyăngz jau, nzof mâyh yâuc ayx gongx nyăngz zanyx manyf nhlimc yămz đuungx lanh zanyx manyf munh nyăngz cah đangc. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Yaz yămz Zâu Tênb-Huungh nyăngz cah đangc, senz ayx phunz muif huungđ tuz săngh wax Tauh, yâuc yămz Zâu Yê-su Jix-Tuz nyăngz cah đangc, senz yămz Boon-ti-atc Phi-latx nyăngz cah đangc ayx zanyx manyf gongx wax Tauh, zăpx mâyh, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />coong mâyh oix zuc âyz nâyx đomc lanyf ayx năngx clăkx clunh nzuf, phunz max naih tinc nzêmh, ayx tuz tauv pănh nyăngz Zâu, six Zâu Yê-su Jix-Tuz hinđ setb taih wax noib, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />Nănh six, Yămz Njăngb Quaix Wax Tauh Zâu Tênb-Huungh, senz payh tuz munh tanv, yâuc ah tauh đokc, ayx manf huungh nyăngz Huungh cloon manf zâu nyăngz Zâu, ayx phunz hinđ setb taih toix Nănh nyăngz săngx huđ wax Tauh, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />cungb Nănh ah tauh max hayh tayc, stâyv yămz wa gwăngz eeng nyăngz tinc max naih mănv hayh ninyh stătx tuz, max zeengx naih mănv phătc quaix Nănh, yâuc max naih mănv hayh phătc tuz, cloo phunz Nănh tuz munh zanyb cloon tômx jab tauv banc stâyv banc đaic. A-meen.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Oix zuc zăpx bux puv quâyx munh yămz nây stâyv sangc năngx gâyf ayx lub, yâuc năngx gâyf păngc yămz max hayh caođ tuz wăn nyăngz jax toongx, oix zuc păngc yămz Zâu Tênb-Huungh, senz sađ muif huungđ dloih nzuf phunz pănh numđ nyađ stipx wax Tauh, <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />yâuc zăpx êu stiz ayx gongx nyăngz jau, ayx muif huungđ gongx nyăngz cumh pâuz, ayx nyâuđ quăng stăngc munh, yâuc bênc săngh nyâuđ nongc tanb phunz munh, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />zaub njâuh phunz cănh nyăngz stinb ah huungđ gongx nyăngz coonz tay tăngđ, phunz tauv cah đangz phanx nyăngz noib, stiz nzăngđ hayh tuz naih senz nyăngz săngh mengc.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ti-mô-tai lex, mâyh oix zuc cayb leđ tuz jaoz phunz mâyh nyăngz jau, pyenv goib bamh munh wax đomc max naih luungđ stuyh nyăngz wac, cloon tinyh zenđ nyăngz jau ja ayx cayx năngđ six bănh sangz nâyx wax đomc, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />naih ah phanx munh, wâyc coong ayx nâyx, songđ ninyh gâyh goib zen stimz.</para>
  <para style="p" vid="1TI 6:21">Cloo Zâu nyăngz pôz cloon nyâuh yămz.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>