  <book code="PHM" style="id">EN_DADT mji-x-daoaodai_Dao⋅Ao⋅Dai_ltr Thu Apr 09 2026 08:29:38 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Philemon</para>
  <para style="toc1">Phi-lê-môn Jenx</para>
  <para style="toc2">Phi-lê-môn</para>
  <para style="toc3">Phm</para>
  <para style="mt">Phi-lê-môn</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Yaz, Phao-lô, ayx Zâu Yê-su Jix-Tuz nyăngz nzauh munh, cloon yâuf pez Ti-mô-tai, pungx phunz Phi-lê-môn, senz buz stăngz nyăngz munh yâuc cloon buz songc ayx cumh pâuz; <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />yâuc phunz cloon buz nyăngz ô stayx Apc-phê; yâuc phunz cloon An-cip-batc, six cloon buz bopc zax nyăngz munh; yâuc phunz cloon yămz nănh nyăngz pyau căpx dlonf nyăngz jiux pangx. <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />Joođ Zâu Tênb-Huungh, six pănh nyăngz Pha cloon pănh nyăngz Zâu Yê-su Jix-Tuz, sađ pôz sađ peengh oonz phunz nyâuh.<verse eid="PHM 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Yaz muif dlih sâuf hâuđ yaz nyăngz Zâu Tênb-Huungh, yămz yaz săngx tauv mâyh bix cloo Zâu nyăngz săngx huđ, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />wâyc tuz numđ lănv tauv mâyh nyăngz stăngz, cloon mâyh nyăngz zen stimz yămz Zâu Yê-su, yâuc stăngz cloon wax đomc đăngb zeengh munh, <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />ayx tuz mâyh nyăngz zen stimz tuz lănv săngh ah cuyb zanyx manyf, phunz munh pâyz tuz coong, nây six wâyc Zâu Jix-Tuz bix muif huungđ cumh pâuz gongx tuz ayx yămz pănh cah njaf. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Yâuf pez lex, yaz senz numđ nyađ yâuc numđ oonz nyâuđ nzongf, wâyc mâyh nyăngz stăngz, yâuc păngc mâyh bix muif lanh cumh pâuz munh nyăngz nyâuđ tuz naih jab staox.<verse eid="PHM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Wâyc nây, yămz Zâu Jix-Tuz cah njaf, yaz numđ oix setb lanyf bux phunz mâyh hoopđ zuc ayx nyăngz jau, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />six wâyc mâyh nyăngz stăngz, yaz joođ six năngx gongx têx — yaz six Phao-lô, côx nzof, six nâyx zanyf lauf wâyc Zâu Yê-su Jix-Tuz bix zuc yămz nzauh — <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />yaz wâyc yaz nyăngz toonz, six yaz zuc njab langb stayb bix steengb tuz wax tauh Ô-nê-si-mat, bix joođ mâyh. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Cah đangc, nănh max hayh stăngc tuz mâyh laiv huungđ, six nâyx zanyf yâuc hayh stăngc tuz njinh mâyh, cloon yaz, <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />yaz paiđ nănh muf pongh mâyh — nâyx tauh munh — nănh six yaz nyăngz stimz nyâuđ. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Yaz oix nzauf nănh cloon yaz yămz, phunz nănh hayh tayv mâyh stăngc yaz ayx cumh pâuz, yămz yaz wâyc Cuđ Jenx bix zuc njab langb stayb nyăngz săngx huđ. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />Six, yaz max oix ayx laiv huungđ bix mâyh max zeengx nyenc, phunz mâyh ayx gongx nyăngz cumh pâuz max zâyf cayx năngđ zuc yac ayx, six wâyc cănh nyunc ayx. <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />Naih dlih six lauf wâyc nâyx, Ô-nê-si-mat bix gâyh mâyh ah dlapc, nongc phunz mâyh hayh tuz stipx nănh stâyv quâyx, <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />max zâyf stunx cayx năngđ ah lanh nâuh nzof, six năngx saix têx ah lanh nâuh timb — six ah lanh stăngz nyăngz yâuf pez, yaz senz stăngz nănh, six mâyh lauf zuc stăngz nănh năngx đuungx têx timb, njinh yămz stâyv sangc max six yămz Zâu. <verse eid="PHM 1:16" /><verse number="17" style="v" sid="PHM 1:17" />Wâyc nây, năngđ coong mâyh stunx yaz cayx năngđ songc ayx cumh pâuz nyăngz munh, joođ stipx nănh cayx năngđ stipx yaz nâyx. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Nzof năngđ coong nănh ayx zuc mâyh stâyb laiv huungđ, max six sămv mâyh toix laiv huungđ zaix, six phanv stunx wax huungđ phunz yaz. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Yaz, Phao-lô, cănh nongc yaz nyăngz puf ja nâyx đomc wac: yaz six cănh clao phunz — nzof cănh mâyh nyăngz stinb sămv cloon yaz wax đomc yâuc max coong tauv! <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Senz, yâuf pez lex, tuz mungc yaz tuz stipx tăng mâyh nâyx huungđ numđ nyađ yămz Zâu; joođ mâyh ayx phunz yaz nyăngz nyâuđ tuz naih jab yămz Zâu Jix-Tuz.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Yaz ja phunz mâyh wâyc yaz zen coong, mâyh six mungv wac, nzof yaz pâyz coong mâyh lôx ayx năngx blătc yaz coong nâyx đomc timb. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Nzof, yâuc joođ bênc ah cuyb tinc phunz yaz, wâyc yaz mungc coong păngc nyâuh tinyh đoih cloo Zâu nyăngz wac, yaz six tuz pungx muf pongh nyâuh.<verse eid="PHM 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Ê-ba-pha, wâyc Zâu Yê-su Jix-Tuz bix cloon yaz songc yămz nzauh nyăngz munh, lauf săngx tauv mâyh. <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />Ma-cô, A-lit-ta-cat, Đê-mat, cloon Lu-ca, songc cloon yaz ayx cumh pâuz nyăngz munh, lauf săngx tauv mâyh.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Joođ pănh nyăngz Zâu Yê-su Jix-Tuz nyăngz pôz cloon nyâuh nyăngz stimz nyâuđ yămz. A-meen!<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>