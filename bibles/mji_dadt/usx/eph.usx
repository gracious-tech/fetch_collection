  <book code="EPH" style="id">EN_DADT mji-x-daoaodai_Dao⋅Ao⋅Dai_ltr VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:37:43 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0 Mon Apr 27 2026 15:41:22 GMT+0700 (Indochina Time) tc</para>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Ephesians</para>
  <para style="toc1">Ê-phê-sô Jenx</para>
  <para style="toc2">Ê-phê-sô</para>
  <para style="toc3">Eph</para>
  <para style="mt">Ê-phê-sô</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Yaz, Phao-lô, âyz Zâu Tênb-Huungh nyăngz zux ix ayx Zâu Yê-su Jix-Tuz nyăngz cumh pâuz munh, pungx phunz yămz wa Ê-phê-sô wax đomc đăngb zeengh munh, senz nzuf stimz nzuf nyâuđ yămz Zâu Yê-su Jix-Tuz wax đomc zen nyăngz munh. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Joođ pănh nyăngz Zâu Tênb-Huungh six Pha cloon Zâu Yê-su Jix-Tuz nyăngz pôz cloon peengh oonz yămz nyâuh cah njaf.<verse eid="EPH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Senz payh tuz tanv nyăngz Zâu Tênb-Huungh six pănh nyăngz Zâu Yê-su Jix-Tuz nyăngz Pha, senz sađ yămz wa cah zâyc guungh nyăngz Singx-Lingh cloon muif huungđ pôz phunz pănh yămz Zâu Yê-su Jix-Tuz cah njaf wax Tauh, <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />senz tăng max zeengx zuyx guungh zuyx nib wax zanyf, Zâu Tênb-Huungh bix sên pănh taih yămz Zâu Jix-Tuz, phunz pănh tuz đăngb zeengh yâuc max naih tinc nzêmh yămz Nănh nyăngz cah đangc, yămz stăngz nyăngz jau <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Nănh bix tingc săngh phunz pănh tuz pênx Nănh nyăngz sây hoonb yămz Zâu Yê-su Jix-Tuz, âyz Nănh numđ nyađ nyăngz zux ix, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />nongc tanv Nănh gwăngz eeng nyăngz pôz, senz Nănh goib âyx yâuc cungb stungx phunz pănh yămz Nănh stăngz nyăngz Toonz, <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />nzof yămz wax tauh Toonz, pănh bix tuz suc lauf păngc yămz Nănh nyăngz samđ, tuz quanyf stoif yămz Nănh puv quâyx nyăngz pôz, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />nây pôz six Nănh sađ phunz pănh yâuc max naih pong stâub yămz muif huungđ tongb manyh cloon bănh sangz nyăngz jau, <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />ayx phunz pănh hayh pâyz tuz Zâu Tênb-Huungh đôz nzongf nyăngz zux ix, senz Nănh numđ nyađ nyăngz zux ix, nzof Nănh yâuc tingc săngh nâyx huungđ zux ix quaix đangc yămz Zâu Jix-Tuz, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />phunz tauv beengc Nănh tingc taih nyăngz săngx huđ, songđ dlonf muif huungđ taih yămz Zâu Jix-Tuz, njinh yămz cah zâyc guungh nyăngz muif huungđ cloon yămz cah đi nib nyăngz muif huungđ, six yămz Nănh nzuf, <verse eid="EPH 1:10" /><verse number="11" style="v" sid="EPH 1:11" />senz yămz pănh tuz cloon songc stipx phănc wax Tauh, wâyc tuz tingc taih quaix đangc âyz ayx phunz muif huungđ tuz setb taih âyz năngđ Nănh bênc taih nyăngz zux ix wax Tauh, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />nongc phunz pănh, senz naih njih mungc yămz Zâu Jix-Tuz nyăngz munh, hayh tuz tanv Nănh nyăngz gwăngz eeng. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Yâuc yămz Nănh, nyâuh bix tuz numđ tauv senz gâyf nyăngz gâyf, senz phunz nyâuh hayh tuz njâuv nyăngz Cuđ Jenx, nzof nyâuh yâuc zen Nănh, songđ tuz sađ Singx-Lingh phunz cayx năngđ tăpb yenx nâyx, âyz Nănh nyunc nyăngz wac, <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />nzof nâyx tauh Singx-Lingh six nongc ayx ah cuyb tingc stinh phunz pănh, zu tauv laiv zanyf Nănh suc nzuf Nănh nyăngz munh lauf, nongc tanv Nănh nyăngz gwăngz eeng.<verse eid="EPH 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Wâyc nây, tăng yaz numđ coong tauv nyâuh nyăngz zen stimz yămz Zâu Yê-su, cloon nyâuh nyăngz stăngz phunz tauv wax đomc muif lanh đăngb zeengh munh, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />yaz songđ wâyc nyâuh sâuf hâuđ max setc tiny, yâuc đamv tauv nyâuh yămz yaz cloo Zâu nyăngz jau, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />phunz pănh nyăngz Zâu Yê-su Jix-Tuz nyăngz Zâu Tênb-Huungh, six gwăngz eeng nyăngz Pha, sađ Singx-Lingh nyăngz tongb manyh yâuc hinđ manyf phunz nyâuh hayh pâyz tuz Nănh, <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />ayx phunz nyâuh nyăngz nyâuđ njaf gwăngz, phunz nyâuh hayh pâyz tuz naih njih mungc yămz Nănh sên nyâuh taih nyăngz jau six ayx laix, cloon wax đomc đăngb zeengh munh tuz puv quâyx gwăngz eeng nyăngz phănc yămz Nănh six năngđ laix, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />Nănh lub nzongf nyăngz tômx jab max naih laiv huungđ hayh pây tuz yămz pănh six năngđ laix, senz naih nyâuđ zen nyăngz munh, âyz năngđ Nănh lokc jangx nyăngz tômx jab, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />Nănh bix ayx phunz Zâu Jix-Tuz tăng tayc săngh taih, yâuc phunz Zâu Jix-Tuz stâyv Nănh nyăngz byaoh phanx yămz wa cah zâyc guungh, <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />blătc nzuf muif huungđ jab, tômx lanyf, tômx jab, cloon ayx zâu, cloon muif huungđ naih manyh bux tauv laiv, max zâyf cungb yămz nâyx stâyv cuungv yâuc năngx cloon cah đangz stâyv timb. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Nănh ayx phunz muif huungđ buc yămz Zâu Jix-Tuz nyăngz staux đi, yâuc phunz Zâu Jix-Tuz ayx jiux pangx nyăngz pyây, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />nzof jiux pangx six ayx Zâu Jix-Tuz nyăngz stinb, naih dloih nzuf yămz ayx phunz muif huungđ tuz clăkx clunh nzuf yămz manf dlayc wax Tauh.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Nzof nyâuh six săngh tayc yămz nyâuh ayx longđ nyăngz stoif, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />senz cah đangc, nyâuh ayx âyz nây bamh canz nyăngz jau wax đomc, lêpc naih lanyf cun yămz lâyc đamx yâuh nyăngz manđ, senz nâyx zanyf jinh đangh yămz wax đomc max zen nyăngz munh cah njaf ayx cumh pâuz nyăngz manđ, <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />cah đangc pănh muif lanh lauf cayx năngđ stiz nâyx, săngh âyz stinb a oix nyăngz jau, ayx âyz pănh nyăngz stinb a cloon stimz nyâuđ oix nyăngz jau. Âyz năngđ nâyx, pănh six lauf săngh zuc tingc stoif nyăngz toonz sab cayx năngđ muif lanh munh nâyx. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Six Zâu Tênb-Huungh, senz naih nyâuđ hâuđ lênh munh wax Tauh, wâyc Nănh nyăngz stăngz lub nzongf Nănh songđ stăngz pănh, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />wâyc nây, yămz pănh jinh đangh zuc tayc yămz pănh ayx longđ nyăngz stoif, Nănh yâuc ayx phunz pănh tuz cloon Zâu Jix-Tuz songc mengc săngh — nây six păngc Zâu nyăngz pôz nyâuh bix tuz njâuv — <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Nănh ayx phunz pănh cloon Zâu Yê-su Jix-Tuz songc săngh taih, yâuc phunz cloon Nănh songc stâyv yămz wa cah zâyc guungh nyăngz tinc, <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />nongc phunz tauv cah đangz wax nzêuh guungh đi, Nănh hayh tuz hinđ manyf Nănh puv quâyx lub nzongf nyăngz pôz setb taih, wâyc Nănh ayx gongx ănz pănh yămz Zâu Yê-su Jix-Tuz wax đomc. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Wâyc păngc Zâu nyăngz pôz, nyâuh bix tuz njâuv păngc yămz zen stimz, nâyx six max zâyf tăng nyâuh taih, nây six tăng Zâu Tênb-Huungh sađ phunz, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />yâuc max zâyf tăng ayx nyăngz cumh pâuz, phunz max naih mănv hayh ayx nzetx lub. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Wâyc zuc pănh six Nănh ayx taih nyăngz tungh zăngc, tuz zuyx taih yămz Zâu Yê-su Jix-Tuz cah njaf, nongc ayx muif huungđ gongx nyăngz cumh pâuz, âyz Zâu Tênb-Huungh bênc taih quaix đangc nongc phunz pănh ayx nyăngz cumh pâuz.<verse eid="EPH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Wâyc nây, oix zuc săngx coong, cah đangc nyâuh six pitc stingx munh yămz nây stinb a, zuc hipđ ayx “max quaix catz nyăngz munh” tăng wax đomc tuz hipđ ayx “quaix catz nyăngz munh” yămz nây stinb a, tăng munh nyăngz puf ayx taih, <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />wâyc zuc wax zanyf, nyâuh six cloon Zâu Jix-Tuz tinyh gâyh, wâyc max zâyf I-sa-la-ên munh, yămz nyunc nyăngz nhlengc wac yâuc săngh zeb njingc nyăngz munh, wâyc nây songđ max naih njih mungc, nzof yămz nây bamh canz yâuc max naih Zâu Tênb-Huungh. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Six, yămz Zâu Yê-su Jix-Tuz cah njaf, nyâuh six cah đangc zuc gâyh côz wax đomc munh, bix nâyx zanyf yâuc tuz taih yămz stătx păngc yămz Zâu Jix-Tuz nyăngz samđ. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Wâyc Nănh six ayx jau phunz pănh hoopđ taih, Nănh ayx phunz iz leepb hoopđ taih songc ah tiuh nyâuđ, yâuc toou lunc nzez pănh wax tungđ gongc, six tinyh nzeengz nyăngz jau đanv nzuf yămz Nănh nyăngz stinb a, <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />yâuc quanyf nzuf gâyf njanh tingc taih wax đomc lanyf, Nănh songđ hayh ayx phunz iz leepb hoopđ taih pênx ah lanh săngb nyăngz munh yămz Nănh cah njaf, njăpc peengh oonz nyăngz jau, <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />nzof Nănh yâuc ayx phunz iz leepb cloon Zâu Tênb-Huungh hoopđ taih songc ah nomz stinb păngc yămz săpc đăngc zax, wâyc Nănh mêtc nzuf phutx săngh yônz zaz wax đomc jau. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Nănh taih wax zanyf, Nănh nzônh peengh oonz nyăngz jau phunz nyâuh, six yămz côz nyăngz munh, nzof yâuc nzônh peengh oonz nyăngz jau phunz yămz stătx nyăngz munh, <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />yâuc păngc Nănh, iz leepb bix hayh tuz ninyh tauv stătx Tênb-toongh Pha păngc yămz ah tauh Singx-Lingh. <verse eid="EPH 2:18" /><verse number="19" style="v" sid="EPH 2:19" />Wâyc nây, nyâuh max zâyf năngx ayx zeb njingc max six pitc stingx munh nzof gôh. Nyâuh six cloon wax đomc đăngb zeengh munh songc ah nomz côkz, yâuc săngh Zâu Tênb-Huungh nyăngz pyau njaf munh, <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />wâyc nyâuh tuz zâyv yămz wax đomc cumh pâuz munh cloon wax đomc tâuc wac munh nyăngz tay cah zâyc, nzof Zâu Yê-su Jix-Tuz six cănh ayx pyau joongz nyăngz njauz, <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />yâuc yămz Nănh, lomc săngh sênz pyau songđ tuz zâyv staox taih, yâuc lăpx săngh ah sênz bongc Zâu Tênb-Huungh nyăngz đăngb zeengh pyau yămz Zâu cah njaf, <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />yâuc lauf yămz Nănh, nyâuh bix tuz tinyh songc zâyv staox taih, săngh Singx-Lingh nyăngz tinc phunz Zâu Tênb-Huungh yămz.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Wâyc nây, yaz, Phao-lô, wâyc Zâu Yê-su Jix-Tuz yâuc wâyc nyâuh pitc stingx munh bix zuc yămz nzauh — <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />naih dlih nyâuh lauf tuz numđ tauv Zâu Tênb-Huungh jaoz Nănh nyăngz pôz phunz yaz cun, yâuc wâyc nyâuh nâyx huungđ pôz bix tuz jaoz phunz yaz, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />âyz năngđ yaz tuz hinđ phunz pâyz yămz hinđ yangh nyăngz jau, cayx năngđ yaz ja yămz wa cah zâyc wax đomc pinyx vâyv nyăngz jau nâyx, <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />toc tauv wax đomc jau, nyâuh six cănh pâyz tuz yaz pyac nyâuđ yămz Zâu Jix-Tuz pinyx vâyv nyăngz jau, <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />senz max zeengx tuz hinđ setb taih phunz bamh munh pâyz yămz cah đangc wax jaz guungh đi, six tauv nâyx zanyf, păngc Singx-Lingh, wax đomc jau bix tuz hinđ phunz wax đomc đăngb zeengh cumh pâuz munh cloon Nănh wax đomc tâuc wac munh — <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />nây six coong tauv: wax đomc pitc stingx munh senz tuz cloon pănh songc stipx phănc nyăngz munh, six songc yămz ah nomz stinb nyăngz phănc wax đomc, yâuc tuz songc stipx nyunc phunz nyăngz phănc yămz Zâu Yê-su Jix-Tuz nyăngz Cuđ Jenx, <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />yaz tuz ayx Cuđ Jenx nyăngz pâuz six wâyc Zâu Tênb-Huungh sađ nyăngz pôz, nây pôz six Nănh nyăngz tômx jab tuz sađ phunz yaz. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Wax huungđ pôz tuz sađ phunz yaz — ah lanh munh năngx jenz quaix yămz wax đomc đăngb zeengh munh tauv laiv — nongc nzônh Zâu Jix-Tuz max hayh zah tuz tongf nyăngz puv quâyx jau phunz wax đomc pitc stingx munh, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />yâuc nongc phunz tinyh đoih tuz pâyz tauv ayx laix six cun pinyx vâyv nyăngz jau, senz tuz pinyx vâyv pâyz sax stâyv quaix taih yămz Zâu Tênb-Huungh, senz zuyx muif huungđ wax Tauh, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />wâyc nây nâyx zanyf, păngc yămz jiux pangx, bix Zâu Tênb-Huungh nyăngz muif huungđ tongb manyh nyăngz jau tuz hinđ phunz wax đomc ayx pyây cun nyăngz munh cloon naih lanyf yămz wa cah zâyc guungh wax đomc, <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />âyz Nănh stâyv quâyx nyăngz zux ix yâuc tuz ayx săngh yămz pănh nyăngz Zâu Yê-su Jix-Tuz, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />yâuc yămz Nănh, pănh bix tuz pungx stimz ninyh yămz stătx Zâu Tênb-Huungh yâuc max numđ cumh nzav wâyc zen caođ Nănh. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Wâyc nây, yaz joođ nyâuh năngx gâyf nămx nyâuđ, yămz yaz wâyc nyâuh bix pongh nyăngz zâuđ nanc, nzof wax đomc zâuđ nanc six nyâuh nyăngz gwăngz eeng.<verse eid="EPH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Wâyc nâyx đomc jau, yaz quâyc yămz Tênb-toongh Pha nyăngz cah đangc, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />yâuc păngc Nănh bix yămz cah zâyc guungh nyăngz muif huungđ cloon cah đi nib tuz oonz bux, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />joođ Nănh âyz Nănh puv quâyx nyăngz gwăngz eeng, nongc Nănh Singx-Lingh nyăngz jab ayx phunz nyâuh tuz njoongh staox yămz nyâuh nyăngz nyâuđ, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />phunz Zâu Jix-Tuz păngc nyâuh nyăngz zen stimz bix yămz nyâuh nyăngz nyâuđ cah njaf, phunz hayh tuz nzac đuungh yâuc stâuđ tăngđ yămz stăngz nyăngz jau, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />phunz nyâuh cloon wax đomc muif lanh đăngb zeengh munh, hayh pâyz tuz tongb ayx laix six quăng, đao, njăngb, đôz, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />yâuc hayh pâyz tuz Zâu Jix-Tuz nyăngz stăngz, senz max naih mănv hayh pâyz tuz tauv nyăngz jau, phunz nyâuh hayh tuz taox pong nzuf Zâu Tênb-Huungh clăkx clunh nyăngz muif huungđ jau.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Joođ huungv staox hayh ayx tuz blătc nzuf muif huungđ pănh joođ max six nyâyh nyăngz jau wax Tauh ninyh, senz jinh đangh yămz pănh cah njaf ayx cumh pâuz wax huungđ tômx jab, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />cloo phunz Nănh tuz gwăngz eeng yămz jiux pangx, yâuc yămz Zâu Yê-su Jix-Tuz ninyh tauv panc stâyv panc đaic. A-meen.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Năngđ nây, yaz six ah lanh nzauh munh yămz Zâu, joođ nyâuh oix zuc yămz năngx payh cloon nyâuh tuz êu taih nyăngz jau, <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />oix zuc yămz manf dlayc nhlimc cănh ayx jenz, yâuc ayx nyâuđ dlênc, ayx nyâuđ đao, lanh nyangc lanh yămz stăngz cah njaf, <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />nzac jab leđ phunz naih Singx-Lingh hoopđ stimz tongh âyx nyăngz jau. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Cungb naih ah nomz stinb cloon ah tauh Singx-Lingh cuungv, lauf cayx năngđ nyâuh tuz sên taih songc ah huungđ njih mungc yămz nyâuh tuz sên taih nyăngz jau, <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />cungb ah tauh Zâu, ah huungđ zen stimz, ayx ah huungđ quaix-gâyf, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />cungb naih ah tauh Zâu Tênb-Huungh, six tinyh đoih nyăngz pha, senz yămz năngx njăngb quaix muif lanh wax Tauh, yămz muif lanh mungh tongx, yâuc yămz muif lanh cah njaf. <verse eid="EPH 4:6" /><verse number="7" style="v" sid="EPH 4:7" />Six pănh muif lanh tuz sađ phunz nyăngz pôz six cănh âyz Zâu Jix-Tuz sađ phunz nyăngz jau. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Wâyc nây, naih wac ja coong:</para>
  <para style="q" vid="EPH 4:8">“Nănh staox njăngb nyăngz tinc ninyh,</para>
  <para style="q" vid="EPH 4:8">ênz cloon sax panc tauh nzauh munh,</para>
  <para style="q" vid="EPH 4:8">yâuc sađ muif huungđ pôz phunz bamh munh.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Nzof coong, “Nănh staox njăngb” âyz gâyf six ayx laix, ha max zâyf Nănh lauf nzac taih nây nib hav nyăngz tinc haz? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Nzac taih wax Tauh six lauf staox ninyh yămz năngx njăngb quaix muif tab guungh wax Tauh, phunz Nănh hayh ayx tuz muif huungđ clăkx clunh nzuf. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Nănh oonz ah phanx ayx cumh pâuz munh, ah phanx ayx tâuc wac munh, ah phanx ayx nzônh Cuđ Jenx nyăngz munh, ah phanx ayx stênx steengb cloon nzaox gâyf stênx steengb, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />nongc bênc phunz wax đomc đăngb zeengh munh naih cumh pâuz ayx clăkx clunh nzuf, nongc zâyv Zâu Jix-Tuz nyăngz stinb, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />ayx tuz tauv laiv zanyf pănh tinyh đoih naih hoopđ stimz tongh âyx yămz zen stimz, yâuc pâyz Zâu Tênb-Huungh nyăngz Toonz, săngh munh lub munh, yâuc tuz clăkx clunh cayx năngđ Zâu Jix-Tuz, <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />phunz pănh max zâyf cayx năngđ munh sây, zuc munh hox yâuc ênz ninyh lêpc munh cănh stuv taih nyăngz jau, nongc cux quaiz nyăngz zux ix puv maoh jaf munh wax đomc. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Six oix pănh nongc stăngz nyăngz jau coong senz gâyf setb taih, pănh nzăngđ hayh lub taih yămz muif stinz jau huungv staox Nănh ninyh, senz ayx pyây wax Tauh, six Zâu Jix-Tuz, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />yâuc tăng Nănh bix lomc stinb sangc tuz căpx taih tinyh blaz păngc muif nomz taux, âyz mănv cănh naih mănv nyăngz phănc cumh pâuz ayx, nongc phunz stinb tuz lub staox taih yâuc cănh hayh zâyv staox yămz stăngz cah njaf.<verse eid="EPH 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Năngđ nây, yaz coong nâyx đomc jau quinb nyâuh yămz Zâu nyăngz manyh, gâyf năngx yămz ayx cayx năngđ max zen nyăngz munh gôh, stiz cungb âyz cănh nyăngz pyây lâyđ nyâyh ayx max săngh nyăngz jau. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Wâyc stiz nyăngz pyây lâyđ nzămc meengh, gâyh Zâu Tênb-Huungh nyăngz săngh mengc côz, wâyc stiz oongx nzongf yâuc nyâuđ nhlengc. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Stiz yâuc max pâyz luungđ, songđ cungb nyâyh nyađ, bix âyz stimz ninyh ayx longđ muif huungđ naih wâyx nyăngz jau max pâyz tuz ngăngc. <verse eid="EPH 4:19" /><verse number="20" style="v" sid="EPH 4:20" />Six nyâuh tuz hoođ pâyz Zâu Jix-Tuz six max năngđ nâyx, <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />wâyc nyâuh six tuz numđ lănv quaix Nănh yâuc tuz hoođ pâyz Nănh, cayx năngđ Zâu Yê-su nzaox nyăngz senz gâyf nâyx, <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />coong oix zuc quanyf nzuf cah đangc nyâuh ayx nyăngz jau, senz nyâuh nyăngz lôx mengc zuc huđ ninyh wâyc zuc jaf âyz cănh nyăngz nyâuđ ayx wax đomc, <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />yâuc oix zuc păngc Singx-Lingh bix coi nyâuh nyâyh nyăngz jau pênx săngb nyăngz taih, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />yâuc oix zuc pênx săngb nyăngz munh, senz tuz zuyx taih âyz năngđ Zâu Tênb-Huungh nyăngz munh — yămz peengh stimz nyăngz jau cloon đăngb zeengh yămz senz gâyf nyăngz jau.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Năngđ nây, muif lanh munh oix zuc quanyf coong puv maoh nyăngz jau, oix zuc coong senz nyăngz wac ănz pănh nyăngz cah sinh munh, wâyc pănh tinyh đoih six songc ah nomz stinb. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Năngđ coong nyâuh siv nhlenx six năngx gâyf ayx longđ stoif. Năngx gâyf phunz nyâuh siv nhlenx tauv bah noib mutc zâyc, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />yâuc năngx gâyf ayx phunz manđ naih congv nzac. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Ayx stac nimc nyăngz munh gâyf năngx ayx stac nimc gôh. Nănh six oix zuc nongc cănh nyăngz puf ayx gongx nyăngz cumh pâuz, phunz naih luungđ tungh zăngc, bix tanb phunz cloon munh zâuđ munh, six năngx gongx têx. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Năngx gâyf phunz laiv zâux wac zokb tăng nyâuh nyăngz nzetx setb taih, six oix zuc coong wax đomc wac gongx hayh stăngc tuz pongh zuc zâuđ nanc wax đomc munh, phunz wax đomc wac hayh stăngc tuz phunz mungv nyăngz munh, <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />yâuc năngx gâyf ayx phunz Zâu Tênb-Huungh nyăngz Singx-Lingh stauh, păngc Nănh nyâuh bix tuz tăpb yenx zu tauv tuz njâuv wax noib. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Nyâuh oix zuc quanyf nzuf muif huungđ imz byatc, siv lub, siv nhlenx, tinyh panx, coong peo munh, cloon muif huungđ okx nyăngz jau. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Nzof, nyâuh six oix zuc lanh ayx gongx ănz lanh, lanh hâuđ lênh lanh, lanh quanyf stoif phunz lanh cayx năngđ Zâu Tênb-Huungh quanyf stoif phunz nyâuh yămz Zâu Jix-Tuz nâyx.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Wâyc nây, nyâuh oix zuc ayx âyz Zâu Tênb-Huungh, năngđ Nănh stăngz nzongf nyăngz toonz sab nâyx, <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />oix zuc lanh stăngz lanh cayx năngđ Zâu Jix-Tuz stăngz pănh bix sađ Nănh cănh nyăngz mengc tayc wâyc pănh, ayx ah cuyb stanyb lanyh naih siv đangz stungx phunz Zâu Tênb-Huungh.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Six pongz lauh nyăngz jau, cloon muif huungđ max đăngb zeengh nyăngz jau max six mauh tax huungđ njinh năngx gâyf coong tauv yămz nyâuh cah njaf, năngđ nây nzăngđ payh tuz cloon wax đomc đăngb zeengh munh, <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />yâuc năngx gâyf coong bah camx bah caiz nyăngz wac, max naih luungđ stuyh nyăngz wac, max six năngx jetx wac — nâyx đomc six max hoopđ zuc coong — six plănc taih oix zuc sâuf hâuđ Zâu. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Nyâuh oix zuc pâyz tingc coong, ayx pongz lauh nyăngz munh tauv laiv, ayx max đăngb zeengh nyăngz jau, max six mauh tax huungđ — six senz paix miuc hanyh nyăngz munh — yetx stong six max naih phănc yămz Zâu Jix-Tuz cloon Zâu Tênb-Huungh nyăngz côkz. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Năngx gâyf phunz mănv ayx nzetx blangc coong puv maoh jaf nyâuh, six wâyc nâyx đomc dlayc, Zâu Tênb-Huungh nzăngđ tingc max mungv Nănh nyăngz wac wax đomc munh nyăngz stoif. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Năngđ nây, nyâuh năngx gâyf cloon stiz songc laiv huungđ phănc, <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />wâyc cah đangc nyâuh six năngx jinh yămz nzămc, six nâyx zanyf nyâuh săngh gwăngz yămz Zâu cah njaf. Oix zuc yămz ayx cayx năngđ gwăngz nyăngz toonz sab nâyx <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />(wâyc tăng gwăngz setb taih nyăngz muif huungđ six gongx nzuf, peengh stimz, yâuc senz nyăngz), <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />oix zuc năngx cayb zah mangc jađ laiv huungđ six hoopđ Zâu nyăngz nyâuđ. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Năngx gâyf songc phănc cloon nzămc nyăngz jau ayx wax đomc max săngh luungđ nyăngz cumh pâuz, oix zuc coong manyf wax đomc jau setb taih six năngx gongx têx, <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />wâyc cungb đamv tauv stiz pinyx ayx nyăngz jau lôx năngx numđ nyayz nzof. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Muif huungđ tuz gwăngz siux tauv six tuz phătc manyf setb taih, tinyh phanv laiv huungđ tuz phătc manyf setb taih six săngh gwăngz nzuf. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Wâyc nây, naih wac coong:</para>
  <para style="q" vid="EPH 5:14">“Phâyx mâyc njoomh nyăngz munh lex, oix zuc điub gôh,</para>
  <para style="q" vid="EPH 5:14">oix zuc tăng wax đomc munh tayc nyoongz quef taih,</para>
  <para style="q" vid="EPH 5:14">Zâu Jix-Tuz songđ siux gwăngz mâyh.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Năngđ nây, nyâuh yămz nây stâyv sangc six oix zuc năngx cayb bôngh — năngx gâyf ayx cayx năngđ munh oongx munh, six oix zuc ayx cayx năngđ tongb manyh nyăngz munh, <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />naih săngx huđ congv oix zuc ayx năngx hoopđ, wâyc nâyx yenh noib six huđ nzongf. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Wâyc nây, năngx gâyf ayx cayx năngđ munh oongx munh, yâuc oix zuc pâyz tuz laiv huungđ six Zâu nyăngz zux ix. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Năngx gâyf tiu binz, wâyc tiu six ayx phunz munh huđ ninyh. Six plănc taih, oix zuc tuz Singx-Lingh pong nyâuđ, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />oix zuc nongc nzungz đăngb, cloon tanv Zâu nyăngz nzungz, cloon Singx-Lingh nyăngz nzungz bix lanh ayx tauz lanh, yâuc nongc nzuf nyâuđ ayx nzungz tanv Zâu, <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />yămz manf dlayc, oix zuc muif dlih tim pănh nyăngz Zâu Yê-su Jix-Tuz nyăngz bux sâuf hâuđ Zâu Tênb-Huungh, six Pha, <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />oix zuc cumh nzav Zâu Jix-Tuz bix lanh buc lanh —<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Ayx au nyăngz munh lex, oix zuc buc nyâuh nyăngz langh cayx năngđ buc Zâu nâyx. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Wâyc langh six ayx au nyăngz pyây, lauf năngđ Zâu Jix-Tuz six ayx jiux pangx nyăngz pyây nâyx — nzof Nănh six ayx jiux pangx nyăngz Njâuv Zâu. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Jiux pangx buc Zâu Jix-Tuz ayx năngđ laix yămz manf dlayc au lauf zuc buc cănh nyăngz langh năngđ wa nâyx. <verse eid="EPH 5:24" /><verse number="25" style="v" sid="EPH 5:25" />Ayx langh nyăngz munh lex, oix zuc stăngz cănh nyăngz au, cayx năngđ Zâu Jix-Tuz stăngz jiux pangx yâuc sađ cănh nyăngz mengc tayc wâyc jiux pangx nâyx, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />phunz Nănh nongc womz đaox yâuc nongc Nănh nyăngz gâyf stav ayx phunz jiux pangx đăngb zeengh taih, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />nongc phunz Nănh hinđ manyf Nănh gwăngz eeng nyăngz jiux pangx, max naih wâyx yâuc max jăpc nyăuv, max naih laiv huungđ năngđ nâyx, six ayx phunz jiux pangx tuz đăngb zeengh yâuc max naih tinc nzêmh. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Lauf tinyh năngđ, langh oix zuc stăngz cănh nyăngz au cayx năngđ cănh nyăngz stinb nâyx. Laiv lanh stăngz cănh nyăngz au six stăngz cănh nyăngz stinb. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Wâyc max naih mănv hănđ cănh nyăngz stinb ax tiny, stong yuungf gongx yâuc lif nănh, lauf cayx năngđ Zâu Jix-Tuz cloon jiux pangx nâyx, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />wâyc pănh six ayx Nănh nyăngz stinb sangc nyăngz muif huungđ phănc. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“Wâyc nây, munh toonz six zuc gâyh nzif pha cloon nănh nyăngz au căpx taih, iz lanh six săngh ah nomz stinb.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Nâyx huungđ pinyx vâyv nyăngz jau six senz lub nzongf — yaz six jinh đangh coong tauv Zâu Jix-Tuz cloon jiux pangx. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Six, nyâuh lauf zuc năngđ nâyx — muif lanh munh — langh six oix zuc stăngz cănh nyăngz au cayx năngđ cănh nyăngz stinb nâyx, nzof au six lauf oix zuc buc cănh nyăngz langh.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Ayx sây nyăngz munh six oix zuc mungv nzif pha nyăngz wac yămz Zâu cah njaf, wâyc nây six ayx hoopđ nyăngz jau. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“Oix zuc hâuđ lênh mâyh nyăngz nzif pha” (nây six tah yetx tiuh lanyf naih cloon nyunc nyăngz wac), <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“phunz mâyh tuz gongx nyăngz pôz yâuc săngh tuz nyăngv tauh đao yămz nây nib minc.” <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />Ayx pha nyăngz munh, năngx gâyf nhlef ayx phunz cănh nyăngz sây siv nhlenx. Plănc taih, six oix zuc nongc Zâu nyăngz wac quinb nzaox yâuc yenv phunz stiz.<verse eid="EPH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Ayx pâuz nyăngz munh, oix zuc buc nyâuh nây stâyv sangc nyăngz zâu nongc nyâuđ zanyb yâuc cumh nzav stinb sinx bix ayx nyâuđ zanyx, cayx năngđ ayx phunz Zâu nâyx, <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />max zâyf cungb toongx zâu mangc nyăngz săngx huđ bix ayx phunz zâu numđ nyađ cuungv, six oix zuc ayx cayx năngđ cay Zâu Jix-Tuz nyăngz pâuz nâyx, nongc nzuf nyâuđ ayx âyz Zâu Tênb-Huungh nyăngz zux ix, <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />nongc nzuf nyâuđ buc, cayx năngđ ayx phunz Zâu nâyx bix max zâyf ayx phunz munh, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />wâyc pâyz tuz coong muif lanh munh, hănđ ayx nâuh max six max ayx nâuh, tinyh phanv ayx laiv huungđ gongx nyăngz cumh pâuz, nănh six tuz stipx gongx nyăngz phănc tăng Zâu.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Nzof, ayx zâu nyăngz munh lauf oix zuc ayx gongx ănz nyâuh nyăngz pâuz năngđ nâyx, năngx gâyf huukb mađ, wâyc pâyz tuz coong nyâuh cloon stiz songc ah tauh Zâu yămz wa cah zâyc guungh, nzof Nănh six max naih pyac toix laiv lanh.<verse eid="EPH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Nzof, nyâuh yâuc oix zuc ayx năngx njoongh taih yămz Zâu cah njaf, păngc Nănh nyăngz tômx jab. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Oix zuc zoongz Zâu Tênb-Huungh bopc zax nyăngz tungh zăngc, phunz nyâuh hayh stâuđ tuz tăngđ, nzeengz cloon manđ cuyx quaiz nyăngz zux ix. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Wâyc pănh bopc zax nyăngz jau six max zâyf nzeengz cloon samđ cloon stinb a, six nzeengz cloon ayx zâu cun wax đomc, nzeengz cloon naih lanyf naih jab wax đomc, nzeengz cloon cun nây bamh canz nzămc nyăngz tinc wax đomc, nzeengz cloon yămz lâyc đamx guungh wax đomc manđ yootz. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Wâyc nây, oix zuc zoongz Zâu Tênb-Huungh bopc zax nyăngz tungh zăngc năngx dloih nzuf, phunz tauv njanh okx nyăngz noib nyâuh nzăngđ hayh nzeengz tuz hingh, tauv ayx soongb nzuf muif huungđ yâuc tuz stâuđ tăngđ. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Năngđ nây, oix zuc stâuđ năngx tăngđ, nongc senz gâyf ayx quav langb stayb nyâuh nyăngz clai, nongc peengh stimz nyăngz jau ayx njab guyz zuz, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />bênc săngh nzônh peengh oonz nyăngz Cuđ Jenx nongc ayx stub tapc ănz staux, <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />yămz manf dlayc oix zuc nongc zen stimz ayx tăng payh nzauf, păngc nây nyâuh nzăngđ hayh bopc tuz hingh okx munh nyăngz stoongz đanyf naih tâuf wax đomc. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Oix zuc nongc njâuv pôz ayx njab moouc đongx yâuc nzauf Singx-Lingh nyăngz nzuc đao, nây six Zâu Tênb-Huungh nyăngz wac, <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />oix zuc muif dlih păngc Singx-Lingh cloo Zâu, yămz muif huungđ cloo Zâu nyăngz jau yâuc joođ phunz hayh tuz sting điub taih yâuc nzac jab cloo Zâu phunz wax đomc đăngb zeengh nyăngz munh tauv laiv, <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />yâuc cloo Zâu phunz yaz, phunz Zâu nyăngz gâyf hayh tuz sađ phunz yaz, phunz yaz hayh goib nzetx yâuc tuz pungx stimz coong manyf nây Cuđ Jenx pinyx vâyv nyăngz jau <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />(yâuc wâyc nây Cuđ Jenx yaz bix săngh tâuc jenx munh yămz nây njab langb stayb nyăngz jau), phunz yămz nâyx đomc jau, yaz yâuc hayh tuz pungx stimz nzônh gâyf âyz năngđ yaz hoopđ zuc coong nâyx.<verse eid="EPH 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Six phunz nyâuh hayh pâyz tuz tauv yaz nyăngz jau, yaz jinh đangh ayx luungđ, naih Ti-ci-gatc, stăngz nyăngz yâuf pez yâuc neetb stimz yămz Zâu, six cănh bux phunz nyâuh pâyz nzuf muif huungđ, <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />nănh six yaz paiđ ninyh nongc pongh nyâuh wâyc nâyx đomc jau, phunz nyâuh hayh pâyz tuz tauv buz nyăngz jau six năngđ laix, phunz nyâuh hayh tuz oonz nyâuđ.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Cloo Zâu Tênb-Huungh, six Pha, cloon Zâu Yê-su Jix-Tuz sađ peengh oonz, cloon stăngz nyăngz jau cloon zen stimz phunz nyâuh. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Cloo Zâu nyăngz pôz cloon nyâuh muif lanh yămz, senz stăngz pănh nyăngz Zâu Yê-su Jix-Tuz tauv tauh tauv mâyv wax đomc munh.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>