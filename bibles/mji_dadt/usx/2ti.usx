  <book code="2TI" style="id">EN_DADT mji-x-daoaodai_Dao⋅Ao⋅Dai_ltr Thu May 21 2026 15:07:26 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">Tah Nyâyc Ti-mô-tai Jenx</para>
  <para style="toc2">2 Ti-mô-tai</para>
  <para style="toc3">2Ti</para>
  <para style="mt">2 Ti-mô-tai</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Yaz, Phao-lô, âyz Zâu Tênb-Huungh nyăngz zux ix ayx Zâu Yê-su Jix-Tuz nyăngz cumh pâuz munh, âyz năngđ nyunc nyăngz wac coong tauv săngh mengc nyăngz jau yămz Zâu Yê-su Jix-Tuz,<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />pungx phunz Ti-mô-tai, six yaz stăngz nzongf nyăngz toonz:</para>
  <para style="p" vid="2TI 1:2">Cloo Zâu Tênb-Huungh, six Pha cloon pănh nyăngz Zâu, six Zâu Yê-su Jix-Tuz hâuđ lênh, sađ pôz, sađ peengh oonz phunz mâyh.<verse eid="2TI 1:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Yaz sâuf hâuđ Zâu Tênb-Huungh, senz yaz nongc đăngb zeengh nyăngz stimz nyâuđ, bix stipx tăng wax đomc claof jex nyăngz puf tauh ayx cumh pâuz bokc dlic wax Tauh, yâuc noib munf săngx tauv mâyh max setc tiny yămz yaz cloo Zâu nyăngz săngx huđ, <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />yaz săngx tauv mâyh nyăngz mâyc womz, senz numđ oix tuz pongh mâyh nzongf, phunz yaz tuz numđ nyađ, <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />yâuc săngx tauv mâyh neetb zen stimz Zâu, cayx năngđ cah đangc yămz mâyh nyăngz côx ti, Lô-itx wax huungđ zen stimz nâyx, cloon yămz mâyh nyăngz nzif, Yu-nit wa nâyx, yaz zen coong wax huungđ zen stimz lauf jinh đangh yămz mâyh cah njaf.<verse eid="2TI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />Wâyc nâyx, yaz bux mâyh oix zuc ayx phunz Zâu Tênb-Huungh nyăngz pôz phutx hongđ staox, senz tăng yaz tăpx puf ănz mâyh bix tuz stipx wax huungđ pôz. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Wâyc Zâu Tênb-Huungh six max zâyf sađ phunz pănh naih cumh nzav nyăngz stimz nyâuđ, six phunz njoongh nyăngz stimz nyâuđ, naih nyâuđ stăngz munh yâuc hayh cun tuz cănh. <verse eid="2TI 1:7" /><verse number="8" style="v" sid="2TI 1:8" />Wâyc nây, mâyh ayx zanyx manyf phunz pănh nyăngz Zâu six năngx gâyf numđ nyayz, yâuc năngx gâyf numđ nyayz, yaz wâyc Nănh bix zuc yămz nzauh nyăngz jau, oix zuc wâyc Cuđ Jenx bix songc tanyđ zâuđ, păngc yămz Zâu Tênb-Huungh nyăngz tômx jab, <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />nây six Zâu cănh njâuv pănh yâuc êu pănh taih yămz đăngb zeengh nyăngz jau, max zâyf âyz pănh ayx nyăngz cumh pâuz, six âyz Nănh cănh tingc taih nyăngz zux ix yămz pôz cah njaf, senz tăng cah đangc sax stâyv sax đaic tuz sađ phunz pănh yămz Zâu Yê-su Jix-Tuz cah njaf, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />bix nâyx zanyf nzăngđ tuz hinđ manyf setb taih, wâyc pănh nyăngz Njâuv Zâu hinđ setb taih, six Zâu Yê-su Jix-Tuz, Nănh bopc paic tayc nyăngz jab, yâuc hinđ manyf săngh mengc cloon max hayh tayc nyăngz jau yămz nây Cuđ Jenx, <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />yâuc wâyc nây Cuđ Jenx yaz bix tuz sên taih nongc ayx nzônh gâyf munh, ayx cumh pâuz munh, yâuc ayx stênx steengb, <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />nzof yâuc wâyc nây yaz bix zuc tanyđ nâyx đomc zâuđ. Six yaz max numđ nyayz, wâyc yaz pâyz tuz yaz zen wax Tauh six mănv, nzof yaz yâuc zen coong Nănh six hayh jămđ tuz yaz stungx phunz wax đomc ayx tuz tauv wax noib.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />Mâyh oix zuc nongc nyâuđ zen yâuc stăngz munh yămz Zâu Yê-su Jix-Tuz cah njaf, bix nzauf sen mâyh numđ tăng yaz nzaox mâyh nâyx đomc gongx nyăngz jau. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Oix zuc păngc Zâu Singx-Lingh bix jămđ tuz jaoz phunz wax đomc gongx nyăngz jau, six săngh yămz pănh cah njaf wa Tauh.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Mâyh yâuc pâyz, coong yămz wa Ê-si nyăngz munh yetx stong quanyf yaz nzuf, yămz wax đomc naih cloon Phi-jê-lat cloon Hê-mô-gê-nêt.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />Joođ Zâu hâuđ lênh Ô-nê-si-phô-lat wax sênz pyau munh, wâyc nănh njinh leox oonz yaz nyăngz nyâuđ, yaz zuc njab langb stayb nănh yâuc max numđ nyayz, <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />nzof, nănh ah yađ taih tauv Lô-ma dlanyh wax zanyf, yâuc coonx taih zah lov yaz, songđ lov tuz pongh. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Cloo Zâu sađ pôz phunz nănh tauv wax noib hayh tuz tăng Zâu hâuđ lênh. Nzof mâyh yâuc cănh pâyz tuz yox coong, yămz wa Ê-phê-sô nănh ayx cumh pâuz đuungx năngđ laix.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Năngđ nây, sây lex, mâyh oix zuc caođ Zâu Yê-su Jix-Tuz nyăngz pôz bix ayx phunz mâyh njoongh taih. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Mâyh yămz đuungx lanh zanyx manyf munh mungh tongx bix mungv tăng yaz wax đomc wac, oix zuc jaoz phunz neetb zen stimz, nzof stiz yâuc hayh nzaox tuz pitc lanh munh wax đomc. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />Oix zuc cloon yaz songc tanyđ zâuđ, năngđ Zâu Yê-su Jix-Tuz nyăngz ah lanh peengz yoiz nâyx. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Ayx peengz nyăngz munh, six max naih mănv năngx phunz nây stâyv sangc nyăngz jau taih quenđ nyâuđ, cungb nyâyh ayx laix nzăngđ tuz hoopđ sên nănh taih wax tauh munh. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Lauf tinyh năngđ, tinyh tâu tiuv nyăngz munh, năngđ coong max âyz jămc gâyf ayx têx, six max hayh tuz stipx hingh nyăngz tany. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Njayh njingh nyăngz munh ayx zâuđ tah yetx six zuc tuz stipx jeengz zunb. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Oix zuc cayb nyâyh mungv yaz coong nyăngz wac, wâyc Zâu six cănh sađ phunz mâyh hayh pâyz tuz muif huungđ.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Oix zuc săngx coong Zâu Yê-su Jix-Tuz six Đa-witx huungh nyăngz sây stunz, tuz ayx tăng tayc săngh taih, âyz năngđ yaz nzônh nyăngz Cuđ Jenx nâyx, <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />yâuc wâyc nây Cuđ Jenx, yaz bix zuc tanyđ zâuđ ayx tuz zuc njab langb stayb cayx năngđ ah tauh stoif munh, six Zâu Tênb-Huungh nyăngz wac yâuc max zuc stayb. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Wâyc nây, yaz nyunc tanyđ muif huungđ wâyc wax đomc tuz sên taih nyăngz munh, phunz stiz lauf hayh tuz njâuv yămz Zâu Yê-su Jix-Tuz, cloon stâyv quâyx nyăngz gwăngz eeng.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />Nâyx zâux wac six senz nyăngz:</para>
  <para style="q" vid="2TI 2:11">“Năngđ coong pănh cloon Nănh tayc, pănh six lauf cloon Nănh săngh.<verse eid="2TI 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12" />Nzof năngđ coong pănh tanyđ tuz hingh, pănh six lauf tuz cloon Nănh cun.</para>
  <para style="q" vid="2TI 2:12">Năngđ coong pănh pyenv Nănh, Nănh six lauf pyenv pănh.<verse eid="2TI 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13" />Năngđ coong pănh nyâuđ max zanyx, Nănh six lauf nyâuđ zanyx,</para>
  <para style="q" vid="2TI 2:13">wâyc Nănh six max hayh cănh pyenv Nănh.”<verse eid="2TI 2:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="2TI 2:14" />Oix zuc bux nâyx đomc jau phunz wax đomc zen Zâu nyăngz munh, yâuc yămz Zâu Tênb-Huungh nyăngz cah đangc zăpx stiz năngx gâyf nzeengz nây nzeengz wa, wâyc max hayh stăngc tuz luungđ, cungb hayh hoiđ zuc mungv nyăngz munh cuungv. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Mâyh oix zuc jab ayx năngx tuz hoopđ Zâu Tênb-Huungh nyăngz nyâuđ, năngđ ah lanh ayx cumh pâuz nyăngz munh max naih tinc nzêmh nâyx, yâuc nzaox năngx toix senz gâyf nyăngz wac. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Yâuc, oix zuc pyenv goib max săngh luungđ wax đomc wac stanc, wâyc wax đomc wac six cungb hayh ayx phunz munh max lêpc gongx Zâu cuungv, <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />stiz coong nyăngz wac six cayx năngđ phutx a yootz nâyx, yămz wax đomc six naih Hi-mê-nê-atc cloon Phi-lê-tat <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />stiz ninyh longđ cloon senz gâyf, yâuc coong six munh săngh taih nyăngz jau taih blătc nzof gôh, stiz songđ ayx phunz ah phanx munh nyăngz zen stimz lunc. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />Six, Zâu Tênb-Huungh jăpc taih nyăngz coonz tay six tăngđ nzongf, wâyc naih wac cayx năngđ tăpb yenx nâyx coong: “Zâu pâyz tuz laiv lanh six Nănh nyăngz munh” yâuc coong “Tinyh phanv laiv lanh êu Zâu nyăngz manyh six oix zuc pyenv goib huđ nyăngz jau.”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Yămz ah sênz pyau lub, nyăngz tungh zăngc max zâyf cungb nongc sămz nongc nyanh pec ayx cuungv, yâuc năngx nongc njăngx nongc nib nhlâuh ayx, ah phanx six nongc phunz cumh pâuz saix, ah phanx six nongc phunz cumh pâuz stanc. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Wâyc nây, năngđ coong laiv lanh cănh stav nănh năngx gâyh wax đomc naih wâyx nyăngz jau, wax lanh six săngh ah cuyb tungh zăngc saix, phunz nănh nyăngz Zâu, yâuc tuz lanyc setb taih nongc njâuh phunz muif huungđ cumh pâuz gongx.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Oix zuc pyenv goib munh gunx munh oix wax đomc pongz lauh nyăngz jau, bix lov peengh stimz nyăngz jau, zen stimz, cloon stăngz munh nyăngz jau, yâuc cloon nongc đăngb zeengh nyăngz stimz nyâuđ caođ Zâu wax đomc munh hoopđ stimz yămz. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />Yâuc oix zuc pyenv goib wax đomc oongx nyăngz tinyh nzeengz wac, max naih luungđ stuyh, wâyc pâyz tuz coong cungb hayh ayx phunz munh tinyh panx cuungv. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Zâu nyăngz pâuz six max hoopđ zuc tinyh panx, yâuc oix zuc ayx gongx ănz muif lanh munh, hayh nzaox munh, yâuc naih nyâuđ tanyđ tuz, <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />yâuc ayx nyâuđ dlênc quinb bux nzeengz cloon pănh wax đomc munh, săngx đanyf Zâu Tênb-Huungh năngx sađ phunz stiz tuz coi nyâuđ nhlimc stoif yâuc pâyz tuz senz gâyf, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />nzof stiz năngx hayh tuz điub taih pyăux đutb manđ nyăngz ploz, wâyc stiz zuc manđ ênz ninyh yac ayx âyz nănh nyăngz zux ix.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Six mâyh oix zuc pâyz nâyx đomc coong, tauv stêtb mâyv nyăngz noib lav, six naih zâuđ nanc. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Wâyc munh six cungb tâuh cănh tuz gongx, stăngz nyanh, ayx nzetx lub, ayx lub, coong pamf, max mungv nzif pha, max pâyz gâyf, max đăngb zeengh, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />max nyâyh tauv mănv, max naih hoopđ stimz tongh âyx, cungb hayh coong wac huđ, max cun tuz cănh, cungb oix bopc munh, max numđ nyađ gongx nyăngz jau, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />plănc minb ănz munh, siv săpx, zanyf cănh ayx lub, cungb oix nyađ năngx nzongf têx stăngz Zâu Tênb-Huungh, <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />cungh ngwaic mangc cayx năngđ cay zen gongx, six yâuc max nhlimc stiz zen wax huungđ nyăngz tômx jab, mâyh oix zuc pyenv goib wax đomc munh năngđ nâyx.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />Wax đomc munh naih ah phanx nimx nzac munh nyăngz pyau ninyh, hox wax đomc nyâuđ oongx nyăngz munh nzif, naih stoif pong nzuf, zuc hox ayx bah laiv săngb pongz lauh nyăngz jau, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />lauf njinh luh hoođ six max naih laiv zanyf hayh pâyz tuz senz gâyf. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />Cah đangđ Yan-net cloon Yam-bê, nzeengz cloon Mô-sê ayx năngđ laix têx, nâyx đomc munh lauf nzeengz cloon senz gâyf năngđ wa nâyx, nâyx đomc munh nyâyh nyăngz jau six max săngh nongc, stiz six cungb ja ayx zen Zâu nyăngz munh cuungv. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />Six stiz max hayh ninyh tuz côz, wâyc stiz ayx wax đomc oongx nyăngz jau six tuz hinđ manyf setb taih, yămz munh tinyh đoih nyăngz cah đangc, lauf cayx năngđ wa iz lanh munh nyăngz nâyx, zuc hinđ manyf wax đomc oongx nyăngz jau setb taih.<verse eid="2TI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Six mâyh yâuc âyz yaz nzaox nyăngz wac ayx, săngh ayx năngđ laix, săngh nongc ayx luungđ, naih zen stimz, naih nyâuđ tanyđ tuz, naih nyâuđ stăngz munh, yaz tanyđ tuz nyăngz jau, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />yămz yaz zuc ayx huđ, zuc pongh zâuđ nanc yămz wa An-ti-ôkx, cloon I-cô-ni-yum, cloon Li-sa-ta dlanyh, yaz zuc tanyđ wax đomc zuc ayx huđ nyăngz jau. Nzof Zâu yâuc njâuv yaz tuz gâyh đutb wax đomc zâuđ nanc nzuf. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Wâyc zuc, tinyh phanv laiv lanh oix lêpc gongx Zâu Yê-su Jix-Tuz six zuc ayx huđ. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />Năngx naih wax đomc munh huđ munh cloon puv maoh nyăngz munh, six cungb cun ayx cun huđ ninyh, ninyh jaf munh yâuc zuc munh jaf stiz. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />Six, mâyh oix zuc stâuđ năngx tăngđ yămz mâyh tuz hoođ quaix nyăngz jau yâuc năngx cayb zen, wâyc pâyz tuz coong mâyh six hoođ wax đomc tăng mănv, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />nzof tăng năngx jenz, mâyh yâuc tuz hoođ pâyz coong Canyx Stâub six hayh ayx phunz mâyh naih tongb manyh, yâuc hayh tuz njâuv păngc zen yămz Zâu Yê-su Jix-Tuz.<verse eid="2TI 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 3:16" />Lomc zây Canyx Stâub six Zâu Tênb-Huungh hab siv ănz, hayh nongc nzaox tuz munh, coong mađ munh, zany munh, yâuc nzaox munh ayx peengh stimz nyăngz jau, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />phunz Zâu Tênb-Huungh nyăngz munh hayh tuz clăkx clunh nzuf, tuz bênc săngh nongc ayx muif huungđ gongx nyăngz cumh pâuz.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Yaz yămz Zâu Tênb-Huungh cloon Zâu Yê-su Jix-Tuz nyăngz cah đangc, senz stămđ munh săngh cloon munh tayc wax Tauh, yămz Nănh hinđ setb taih nyăngz jau cloon Nănh nyăngz côkz, zăpx mâyh coong: <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />Oix zuc nzônh Zâu nyăngz gâyf; oix zuc bênc săngh nzônh, max cun naih congv max six max naih congv; oix zuc coong nzaox, mađ nzaox, quinb bux, nongc nzuf nyâuđ nênf nyangc bix zăpx nzaox. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Wâyc tauv six naih ah nzêuh munh max oix mungv gongx nyăngz gâyf. Nzof, stiz six lov wax đomc stênx steengb taih nzaox hoođ stiz cănh nyăngz stimz nyâuđ, yâuc hoođ bah noomh, <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />stiz yâuc zetx bah noomh max mungv senz gâyf, songđ ninyh mungv wax đomc max naih luungđ stuyh nyăngz jau. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Six yămz manf dlayc mâyh oix zuc sting điub taih. Oix zuc tanyđ zâuđ. Oix zuc ayx nzônh Cuđ Jenx munh nyăngz cumh pâuz. Oix zuc ayx mâyh nyăngz cumh pâuz năngx clăkx clunh nzuf.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Năngx naih yaz six jinh đangh zuc taox nzac cayx năngđ congx nyăngz tax huungđ nâyx, yaz quaix stâyv nyăngz săngx huđ yâuc tauv stătx gôh. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Yaz bopc tuz soongb gongx nyăngz zax; yămz tinyh tâu tiuv nyăngz jau yaz yâuc tiuv tuz toongz tauh; yâuc nzauf tăngđ yaz nyăngz zen stimz. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Nâyx zanyf, peengh stimz nyăngz tany tuz bênc săngh njâuh phunz yaz, wax nomz tany six Zâu, senz peengh stimz nyăngz Stămđ Stoif wax Tauh, tauv wax noib six sađ sâuđ nyâyc phunz yaz, yâuc max zâyf cungb njâuh phunz yaz cuungv, six lauf năngx phunz cloon yetx stong numđ nyađ tauv Nănh taih nyăngz jau wax đomc munh.<verse eid="2TI 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Oix zuc coonx taih pongh yaz năngx căn, <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />wâyc Đê-mat stăngz nây bamh canz nyăngz jau, songđ quanyf yaz, bix ninyh wa Tê-sa-lô-ni-ca dlanyh. Nzof Cê-lê-sên yâuc ninyh Ga-la-ti stâyz phangz, Ti-tatc zef ninyh Đa-ma-ti stâyz phangz nzof. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Cungb năngx naih Lu-ca cloon yaz yămz nây cuungv. Mâyh bix ênz cloon Ma-cô lêpc mâyh taih, wâyc nănh hayh stăngc tuz yaz ayx cumh pâuz. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Yaz paiđ Ti-ci-gatc ninyh wa Ê-phê-sô nzof. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Tauv taih, mâyh bix nzâyz cloon yaz nyăngz guyz gomf, six yaz ănz Can-batc nyăngz pyau wax byenđ guyz yămz wa Tô-atc dlanyh, yâuc nzâyz cloon wax đomc stâub, nongc sen quaix six wax đomc đupx stâub glonc.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Ayx tongh stangc wax tauh A-lek-san-đê ayx hoiđ yaz đuungx nzongf. Âyz nănh ayx nyăngz dlayc Zâu six cănh clao phunz nănh, <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />mâyh lauf oix zuc năngx cayb bôngh wax tauh munh, wâyc nănh nzeengz cloon pănh nzaox nyăngz gâyf nzongf.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Yămz yaz cănh coong pyenv tah yetx hâyđ wax zanyf, max naih mănv cloon yaz yămz tiny, tinyh đoih quanyf yaz nzuf. Cloo phunz wax cuyb stoif max njămh zuc stiz. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Six Zâu stâuđ yămz yaz cah sinh pâu jab phunz yaz, phunz yaz hayh nzônh Cuđ Jenx tuz clunh nzuf, nzof yetx stong pitc stingx munh yâuc hayh tuz numđ. Yaz yâuc tuz njâuv gâyh đutb njanh zongh nyăngz nzetx. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Zâu six cănh njâuv yaz gâyh đutb nzuf muif huungđ okx nyăngz jau, yâuc ênz yaz nzac Nănh nyăngz Tênb-toongh côkz, cloo phunz Nănh tuz gwăngz eeng tauv banc stâyv banc đaic, A-meen.<verse eid="2TI 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Oix zuc đeh tauv Bitc-sin-la cloon A-qui-la, cloon Ô-nê-si-phô-lat nyăngz pyau munh. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Ê-lat-tat năngx yămz wa Cô-lin-tô dlanyh, six wâyc Tô-phi-mat săngh gumc yaz songđ phunz nănh yămz wa Mi-lê-tat dlanyh. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Oix zuc coonx taih năngx saic guungh song. Yu-bu-lat, cloon Bu-đen, Li-nat, Ca-lau-đia cloon yetx stong yâuf pez tinyh đoih đeh tauv mâyh.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Joođ Zâu cloon mâyh nyăngz stimz nyâuđ yămz. Cloo Zâu nyăngz pôz cloon nyâuh yămz.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>