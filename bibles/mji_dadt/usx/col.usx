  <book code="COL" style="id">EN_DADT mji-x-daoaodai_Dao⋅Ao⋅Dai_ltr Fri May 22 2026 15:37:15 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Colossians</para>
  <para style="toc1">Cô-lô-si Jenx</para>
  <para style="toc2">Cô-lô-si</para>
  <para style="toc3">Col</para>
  <para style="mt">Cô-lô-si</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Yaz, Phao-lô, âyz Zâu Tênb-Huungh nyăngz zux ix, ayx Zâu Yê-su Jix-Tuz nyăngz cumh pâuz munh, cloon pănh nyăngz yâuf pez, Ti-mô-tai, <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />pungx phunz lêpc gongx Zâu Jix-Tuz wax đomc đăngb zeengh nyăngz yâuf pez, yămz wa Cô-lô-si dlanyh. Joođ Tênb-toongh Pha, six Zâu Tênb-Huungh cloon pănh nyăngz Zâu, six Zâu Yê-su Jix-Tuz, sađ pôz sađ peengh oonz phunz nyâuh.<verse eid="COL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Buz muif dlih cloo Zâu phunz nyâuh nyăngz săngx huđ, buz sâuf hâuđ Zâu Tênb-Huungh, six pănh nyăngz Zâu Yê-su Jix-Tuz nyăngz Pha, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />wâyc buz tuz numđ coong tauv nyâuh nyăngz zen stimz yămz Zâu Yê-su Jix-Tuz, nzof yâuc numđ coong nyâuh naih nyâuđ stăngz cloon zen Zâu nyăngz muif lanh đăngb zeengh munh, <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />wâyc tuz naih njih mungc yămz wa cah zâyc guungh njâuh phunz nyâuh, senz tăng cah đangc nyâuh tuz numđ yămz senz gâyf nyăngz Cuđ Jenx, wax huungđ njih mungc, <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />nây Cuđ Jenx six jinh đangh hinđ yămz nyâuh mungh tongx, yâuc jinh đangh tuz phutx ninyh yămz pong nây guungh đi, lauf cayx năngđ yămz nyâuh nâyx, tăng ah yac nyâuh tuz numđ, yâuc senz tuz hoođ pâyz tauv Zâu Tênb-Huungh nyăngz pôz wax noib, <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />cayx năngđ tăng Ê-ba-pha nzaox phunz nyâuh pâyz nâyx, nănh six buz stăngz nyăngz ah lanh cumh pâuz toic, nănh yâuc nzuf stimz nzuf nyâuđ ayx Zâu Jix-Tuz nyăngz cumh pâuz, tayv buz, <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />nănh yâuc bux phunz buz pâyz coong nyâuh naih lanh stăngz lanh yămz Zâu Singx-Lingh cah njaf.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Wâyc nây, tăng buz tuz numđ nâyx đomc wac wax noib, buz cloo Zâu phunz nyâuh max setc tiny, yâuc joođ phunz nyâuh hayh pâyz tuz nzuf Zâu Tênb-Huungh nyăngz zux ix, yâuc naih muif huungđ tongb manyh hayh pâyz tuz Singx-Lingh nyăngz jau, <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />phunz nyâuh hayh yămz tuz payh cloon Zâu, yămz manf dlayc yâuc hoopđ nzuf nănh nyăngz nyâuđ, ayx tuz muif huungđ cumh pâuz gongx, yâuc cun ayx cun pâyz Zâu Tênb-Huungh. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />Yâuc tuz naih jab njoongh staox âyz Nănh gwăngz eeng nyăngz jab, phunz nyâuh hayh naih nyâuđ numđ nyađ tanyđ tuz muif huungđ dlayc, <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />oix zuc sâuf hâuđ Tênb-toongh Pha, senz phunz nyâuh tuz cloon wax đomc đăngb zeengh munh songc stipx gwăngz eeng nyăngz phănc wax Tauh. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Nănh njâuv pănh tuz gâyh đutb nzămc nyăngz jab, yâuc ênz pănh nzac Nănh stăngz nyăngz Toonz nyăngz côkz, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />yămz nâyx tauh Toonz, pănh tuz suc lauf, yâuc tuz quanyf stoif. <verse eid="COL 1:14" /><verse number="15" style="v" sid="COL 1:15" />Nănh six mangc max phătc nyăngz Zâu Tênb-Huungh nyăngz hanyh jangx, yâuc steengb năngx đangc quaix zuyx taih nyăngz muif huungđ wax Tauh. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Wâyc yămz Nănh, bix muif huungđ yămz cah zâyc guungh cloon cah đi nib, mangc phătc cloon mangc max phătc nyăngz, yâuc tuz zuyx taih nzuf. Max cun ayx huungh, max six ayx zâu, naih lanyf, max six naih jab, muif huungđ six wâyc Nănh, yâuc păngc Nănh bix tuz zuyx taih. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Nănh naih năngx đangc quaix muif huungđ, nzof muif huungđ yâuc păngc Nănh bix naih yetx nyâyc. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Nănh six ayx stinb nyăngz pyây, six jiux pangx nyăngz pyây. Nănh six ayx tah yetx, steengb năngx đangc quaix wax đomc tayc nyăngz munh tauv laiv, wâyc zuc Nănh six yămz manf dlayc ayx tah yetx wax Tauh. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Wâyc Zâu Tênb-Huungh numđ nyađ phunz muif huungđ tuz clăkx clunh yămz Nănh cah njaf, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />yâuc păngc Nănh bix muif huungđ tuz cloon Zâu Tênb-Huungh hoopđ taih, max cun yămz nib nyăngz tax huungđ, max six yămz guungh nyăngz tax huungđ, yâuc păngc Nănh yămz wa săpc đăngc zax nyăngz samđ, bix tuz cloon Nănh hoopđ taih nzuf. <verse eid="COL 1:20" /><verse number="21" style="v" sid="COL 1:21" />Cah đangc nyâuh six gâyh Zâu Tênb-Huungh côz, yămz nyâuh nyâyh cloon ayx huđ nyăngz jau, six căn Nănh săngh yônz zaz, <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />six nâyx zanyf, nyâuh tuz păngc Nănh nyăngz stinb a zuc tayc bix tuz cloon Zâu Tênb-Huungh hoopđ taih, yâuc phunz nyâuh tuz yămz Nănh nyăngz cah đangc, săngh đăngb zeengh nyăngz munh, max naih wâyx, yâuc max naih tinc nzêmh, <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />phanv nyâuh njinh luh nongc zen stimz, yâuc nzac đuungh năngx đôz, jab stâuđ năngx tăngđ, yâuc năngx gâyf ninyh gâyh nyâuh tuz numđ nây Cuđ Jenx nyăngz njih mungc, senz tuz nzônh ninyh pong nây guungh đi nyăngz Cuđ Jenx, yâuc wâyc nây Cuđ Jenx, bix yaz Phao-lô tuz ayx cumh pâuz nyăngz munh.<verse eid="COL 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Nâyx zanyf yaz numđ nyađ, wâyc nyâuh yaz bix zuc tanyđ zâuđ nyăngz jau, yâuc nongc yaz nyăngz stinb a tanyđ năngx nzuf, Zâu Jix-Tuz wâyc Nănh nyăngz stinb, six senz jiux pangx, bix tanyđ max zeengx tauv wax đomc zâuđ nanc nyăngz jau, <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />wâyc nây, yaz săngh jiux pangx nyăngz cumh pâuz munh, âyz năngđ Zâu Tênb-Huungh paiđ phunz yaz ayx nyăngz, wâyc nongc nzônh Nănh nyăngz gâyf phunz nyâuh năngx clăkx clunh nzuf. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />Senz tăng cah đangc pinyx nyăngz quaix taih stâyv stipx stâyv wax đomc, nâyx zanyf wax đomc pinyx nyăngz jau yâuc tuz hinđ setb taih, phunz Nănh nyăngz đăngb zeengh munh, <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />wâyc Zâu Tênb-Huungh oix hinđ manyf phunz wax đomc pitc stingx munh pâyz tuz tauv, nây puv quâyx gwăngz eeng nyăngz jau six năngđ laix, wax huungđ six Zâu Jix-Tuz yămz nyâuh cah njaf, senz naih njih mungc nyăngz gwăngz eeng. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />Nănh six buz nzônh wax Tauh, buz nongc nzuf tongb manyh nzaox nyâuh muif lanh yâuc quinb nyâuh muif lanh, ayx phunz nyâuh muif lanh hayh tuz clăkx clunh yămz Zâu Jix-Tuz. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Six wâyc năngđ nâyx yaz nzăngđ zuc ayx zâuđ, păngc Nănh phunz nyăngz jab bix nzeengz jax, six yămz yaz cah njaf hinđ manyf setb taih wax huungđ tômx jab.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Yaz oix nongc nyâuh pâyz yaz wâyc nyâuh bix nzeengz jax lub ayx năngđ laix, yâuc wâyc yămz wa Lau-đi-sê wax đomc zen nyăngz munh, cloon max zeengx phătc quaix yaz nyăngz minb wax đomc munh, <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />phunz stiz tuz numđ oonz nyâuđ, yâuc naih hoopđ stimz tongh âyx lanh stăngz lanh, yâuc hayh nyâyh tuz muif huungđ tongb nzuf, yâuc manyh pec tuz yox tauv Zâu Tênb-Huungh wax đomc vâyv nyăngz jau, six Zâu Jix-Tuz, <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />yămz Nănh cah njaf six naih nzuf muif huungđ tongb manyh nyăngz jau cloon hayh manyh pec nyăngz jau. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Yaz coong nâyx đomc jau wâyc max phunz mănv hayh ayx nzetx blangc taih jaf nyâuh. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Max cun yaz nyăngz stinb a max cloon nyâuh yămz, six yaz nyăngz stimz nyâuđ lauf cloon nyâuh yămz, phătc nyâuh tuz yămz gongx, yâuc naih zen stimz tăngđ yămz Zâu Jix-Tuz, yaz songđ numđ nyađ.<verse eid="COL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Wâyc nây, tăng nyâuh ah stipx Zâu Yê-su Jix-Tuz ayx Zâu, six oix zuc yăngh yămz Nănh cah njaf, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />oix zuc nzac đuungh yâuc zâyv yămz Nănh cah njaf, yâuc oix zuc nongc zen stimz năngx tăngđ, cayx năngđ nyâuh tuz numđ nzaox nâyx, yâuc oix zuc jab sâuf hâuđ năngx yongb.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Oix zuc năngx cayb bôngh, sangx đanyf hayh naih tix lanh munh yac nyâuh ayx âyz bamh munh cănh njăpc taih max naih luungđ stuyh nyăngz gâyf, âyz nây bamh canz nyăngz jau, bix max âyz Zâu Jix-Tuz. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Wâyc Zâu Tênb-Huungh nyăngz muif huungđ stimz stingx, naih dloih nzuf yămz Zâu Jix-Tuz nyăngz stinb, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />nzof nyâuh yămz Zâu Jix-Tuz cah njaf six tuz naih muif huungđ dloih, wâyc Nănh six ayx pyây yămz naih jab naih lanyf wax đomc tauv laiv, <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />yămz Nănh cah njaf, nyâuh yâuc tuz ayx quaix catz nyăngz gâyf, six max zâyf tăng munh nyăngz puf ayx, six tăng Zâu Jix-Tuz ayx quaix catz phunz, nongc mêtc nzuf stinb a oix nyăngz jau, <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />wâyc nyâuh ayx quaix-gâyf nyăngz jau, yâuc tuz cloon Zâu Jix-Tuz songc plopx, nzof yămz Nănh cah njaf nyâuh yâuc tuz săngh taih, wâyc nyâuh zen păngc Zâu Tênb-Huungh nyăngz jab, senz ayx phunz Zâu Jix-Tuz tăng tayc săngh taih wax Tauh. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Nyâuh max zeengx ayx quaix catz nây stinb a nyăngz săngx huđ, yâuc wâyc ayx stoif bix zuc tayc, Zâu Tênb-Huungh yâuc ayx phunz nyâuh tuz cloon Zâu Jix-Tuz songc mengc săngh, wâyc quanyf nzuf pănh nyăngz yetx stong stoif, <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />Nănh stotb nzuf staox pănh nyăngz stoif nongc cooux pănh wax zây stâub tanz, senz nzeengz cloon pănh wax đomc jau, Nănh yâuc stăngc pănh zoz quanyf tingz ănz wa săpc đăngc zax. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Nănh tutb nzuf naih lanyh naih jab cun dlayc wax đomc, Nănh nongc săpc đăngc zax nyăngz jab bopc hingh stiz, yâuc ayx phunz stiz toongx songx zuc nyayz.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Wâyc nây, năngx gâyf phunz mănv tingc nyâuh nhlinc max six hopb nyăngz jau, max six quaix stêtz nyăngz noib, săngb lav nyăngz noib, max six tingc congz noib, <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />nâyx đomc six cungb cayx taih wax đomc nyăngz bah cloiz cuungv, nzof senz săngh hanyh nyăngz six yămz Zâu Jix-Tuz. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Năngx gâyf phunz mănv ayx phunz nyâuh zuc stâyb sâuđ nyâyc, wâyc stiz jaf ayx cayx năngđ cay nhlimc ayx jenz, yâuc ninyh paix stinz munh, păngc stiz cănh mangc phătc nyăngz jau, yâuc cănh âyz stiz nyăngz stimz nyâuđ nyâyh ayx nzetx lub nyăngz jau, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />yâuc max cloon Pyây tinyh taux, senz tăng Pyây bix lomc stinb sangc ah jaz taux ah jaz păngc sanz tinyh taux staox taih; wax nomz stinb songđ hayh lub njoongh staox tăng Zâu Tênb-Huungh.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Năngđ coong nyâuh cloon Zâu Jix-Tuz tayc, tuz gâyh đutb nây bamh canz stâyv sangc nyăngz jau, ha săngh laix bix zef năngx phunz nây bamh canz nyăngz jau taih stayb nyâuh, cayx năngđ cay lauf năngx jinh săngh yămz nây bamh canz nâyx: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />“Năngx gâyf lumz, năngx gâyf đopx, năngx gâyf clatc!” <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />Six coong tauv wax đomc jau tinyh phanv ayx âyz bix hayh zuc mêtc wax đomc, wax đomc gâyf yâuc cănh bamh munh njăpc taih nyăngz gâyf? <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Max cun six laiv huungđ cumh pâuz jau, hănđ six mangc cayx năngđ naih tongb manyh six yâuc cungb cănh njăpc taih nongc canyx bongc, yâuc naih stâuv nzongf six cungb ayx hoiđ cănh nyăngz stinb, yâuc max naih laiv huungđ zux ix hayh nzeengz tuz hingh stinb a oix nyăngz jau.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Wâyc nây, năngđ coong nyâuh tuz ayx phunz cloon Zâu Jix-Tuz săngh taih, six oix zuc lov yămz cah zâyc guungh nyăngz dlayc, six Zâu Jix-Tuz stâyv yămz Zâu Tênb-Huungh byaoh phanx nyăngz tinc. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Oix zuc nyâyh tauv yămz wa cah zâyc guungh nyăngz dlayc, max zâyf yămz nây bamh canz nyăngz dlayc. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Wâyc nyâuh tayc nzof, nyâuh nyăngz săngh mengc tuz cloon Zâu Jix-Tuz pinyx yămz Zâu Tênb-Huungh cah njaf. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Tauv Zâu Jix-Tuz, six senz nyâuh nyăngz săngh mengc, hinđ setb taih wax zanyf, nyâuh six lauf tuz cloon Nănh songc yămz gwăngz eeng hinđ setb taih.<verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Wâyc nây, oix zuc ayx tayc yămz nây bamh canz nyăngz jau — six pongz lauh nyăngz jau, naih wâyx nyăngz jau, stimz oix nyăngz jau, oix ayx huđ nyăngz jau, cloon mauh tax huungđ, mauh tax huungđ six congx miuc hanyh, <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />six wâyc nâyx đomc dlayc Zâu Tênb-Huungh nzăngc taih tingc stoif, <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />cah đangc nyâuh six lauf naih ayx nâyx đomc dlayc, senz nyâuh năngx jinh zuc nâyx đomc dlayc cun nyăngz săngx huđ. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />Six nâyx zanyf nyâuh oix zuc quanyf nzuf nâyx đomc muif huungđ dlayc — năngx gâyf numđ nhlenx, năngx gâyf siv lub, năngx gâyf ayx okx, năngx gâyf mađ munh, yâuc năngx gâyf coong laiv huungđ bah camx bah caiz nyăngz wac setb nyâuh nyăngz nzetx. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Năngx gâyf coong puv maoh lanh jaf lanh, wâyc pănh quanyf nzuf lôx munh cloon wax đomc lôx stimz nyăngz jau nzof, <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />nâyx zanyf yâuc săngh săngb nyăngz munh, six senz tuz wănc ayx săngb nyăngz munh taih hayh pâyz tuz muif huungđ, cayx năngđ zuyx pănh taih wax Tauh nyăngz hanyh jangx nâyx, <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />yămz nây six max naih lanyc Hi-lapc munh cloon Yu-tai munh, quaix catz nyăngz munh cloon max quaix catz nyăngz munh, max tuz đăngc nyăngz munh cloon Si-te munh, ayx nâuh nyăngz munh cloon max ayx nâuh nyăngz munh, năngđ nây Zâu Jix-Tuz six muif huungđ, yâuc yămz muif huungđ.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />Nyâuh six tuz Zâu Tênb-Huungh sên taih nyăngz munh, senz Nănh stăngz nyăngz đăngb zeengh munh, oix zuc naih nyâuđ hâuđ lênh munh, ayx gongx, yâuc nyangc munh, ayx nyâuđ dlênc, ayx nyâuđ đao, <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />lanh nênf lanh yâuc lanh quanyf phunz lanh, năngđ coong naih tix lanh cloon pitc lanh tinyh zenđ, yâuc oix zuc lanh quanyf phunz lanh, cayx năngđ Zâu quanyf phunz nyâuh nâyx. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Six yămz manf dlayc yâuc oix zuc lanh stăngz lanh, nây six hayh ayx tuz clăkx clunh nzuf nyăngz jau. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />Oix zuc phunz Zâu Jix-Tuz nyăngz peengh oonz cun nyâuh nyăngz nyâuđ, wâyc nyâuh six tuz tăng nâyx huungđ peengh oonz sên taih săngh ah nomz stinb, yâuc oix zuc naih nyâuđ hâuđ tauv. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Oix zuc zoz Zâu Jix-Tuz nyăngz wac ănz nyâuh nyăngz nyâuđ pong nzuf, yâuc nongc nzuf muif huungđ tongb manyh nyăngz jau lanh nzaox lanh, lanh quinb lanh, nongc wax đomc đăngb nzungz, cloon tanv Zâu nyăngz nzungz, cloon Singx-Lingh phunz munh ayx taih nyăngz nzungz, nongc nzuf nyâuđ sâuf hâuđ ayx nzungz tanv Zâu Tênb-Huungh. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Nyâuh ayx nyăngz muif huungđ jau, max cun coong wac max six ayx nyăngz dlayc, oix zuc ayx muif huungđ yămz Zâu nyăngz manyh, six Zâu Yê-su, yâuc păngc Nănh bix sâuf hâuđ Zâu Tênb-Huungh, senz Tênb-toongh Pha.<verse eid="COL 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Ayx au nyăngz munh, oix zuc buc cănh nyăngz langh, wâyc nây six ayx hoopđ yămz Zâu. <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />Ayx langh nyăngz munh oix zuc stăngz cănh nyăngz au, yâuc năngx gâyf ayx đokc ănz au. <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />Ayx sây nyăngz munh, yămz manf dlayc oix zuc mungv nzif pha nyăngz wac, wâyc nây six ayx hoopđ Zâu nyăngz nyâuđ. <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" />Ayx pha nyăngz munh, năngx gâyf nhlef cănh nyăngz sây nhlenx, stiz nzăngđ max tuih nyâuđ. <verse eid="COL 3:21" /><verse number="22" style="v" sid="COL 3:22" />Ayx nâuh nyăngz munh, yămz manf dlayc oix zuc mungv cănh nyăngz zâu, max zây cungb toongx zâu nyăngz minb ayx, wâyc phunz stiz numđ nyađ cuungv, six oix zuc senz nongc nzuf nyâuđ ayx, wâyc cumh nzav Zâu. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Max cun nyâuh ayx laiv huungđ, oix zuc nongc nzuf stimz nyâuđ ayx cayx năngđ ayx phunz Zâu nâyx, bix max zâyf ayx phunz munh, <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />wâyc pâyz tuz coong nyâuh six tuz stipx sâuđ nyâyc nyăngz phănc tăng Zâu. Wâyc nyâuh six jinh đangh ayx Zâu nyăngz pâuz, six senz Zâu Jix-Tuz. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Wâyc zuc laiv lanh ayx max peengh stimz nyăngz jau, six lauf tuz stipx nănh ayx wax đomc max peengh stimz nyăngz jau winb lauf phunz nănh, yâuc max naih pyac toix laiv lanh.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Ayx zâu nyăngz munh oix zuc ayx nyâuđ zanyx yâuc ayx nyâuđ peengh ănz nyâuh nyăngz nâuh, wâyc pâyz coong pănh tinyh đoih songc ah tauh Zâu yămz wa guungh.<verse eid="COL 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Oix zuc muif dlih vaic canyz nyâuđ cloo Zâu, yâuc sâuf hâuđ yămz nâyx đomc jau. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />Yâuc oix zuc tinyh đoih cloo Zâu phunz buz, phunz Zâu Tênb-Huungh coib jau phunz buz hayh nzaox gâyf, nongc pob manyf Zâu Jix-Tuz wax đomc pinyx vâyv nyăngz jau, six lauf wâyc nâyx đomc pinyx vâyv nyăngz jau yaz nzăngđ zuc jab langb stayb, <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />ayx phunz yaz hayh pob manyf wax đomc pinyx vâyv nyăngz jau năngx yox, năngđ yaz hoopđ zuc coong nâyx. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />Năngđ coong naih săngx huđ congv, oix zuc nongc tongb manyh cloon max zen nyăngz munh yămz. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Nyâuh coong nyăngz wac six oix zuc hayh stăngc tuz munh, yâuc zămđ đau ănz, nâyx đomc six nyâuh sămv zuc naih nongc hayh tauz cloon muif lanh munh.<verse eid="COL 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Pănh stăngz nyăngz yâuf pez Ti-ci-gatc, cănh coong nzuf yaz nyăngz yetx stong dlayc phunz nyâuh pâyz, nănh six neetb stimz, cloon buz songc ayx Zâu nyăngz cumh pâuz, <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />nănh six yaz paiđ ninyh nongc pongh nyâuh, wâyc phunz nyâuh hayh pâyz tuz buz yămz nây six năngđ laix, yâuc phunz nănh oonz nyâuh nyăngz nyâuđ, <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />lêpc ninyh wax tauh stăngz nyăngz yâuf pez six Ô-nê-si-mat, neetb stimz nyăngz munh, nănh six yămz nyâuh wa nyăngz munh, stiz six cănh coong phunz nyâuh pâyz yămz nây nyăngz muif huungđ dlayc.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />Cloon yaz songc yămz nzauh wax tauh A-lit-ta-cat, lauf săngx tauv nyâuh, cloon Ma-cô, ayx yâuf Ba-na-batc, yâuf pez sây (nyâuh tuz numđ yaz coong tauv nănh phunz nyâuh; năngđ coong nănh ninyh tauv nyâuh wa, six oix zuc stipx nănh), <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />nzof Yê-su yâuc hipđ ayx Yu-sa-tat wax tauh. Lauf săngx tauv nyâuh, ayx quaix catz nyăngz munh, cungb stiz cloon yaz songc ayx Zâu Tênb-Huungh nyăngz côkz nyăngz cumh pâuz cuungv, stiz ayx phunz yaz tuz numđ oonz nyâuđ nzongf. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />Ê-ba-pha lauf săngx tauv nyâuh, nănh six yămz nyâuh wa nyăngz munh, ayx Zâu Yê-su Jix-Tuz nyăngz pâuz, nănh muif dlih wâyc nyâuh cloo Zâu max setc tinyh, phunz nyâuh hayh tuz zen tăngđ, yâuc pênx munh lub munh, yâuc hayh zen tingc yămz Zâu Tênb-Huungh nyăngz muif huungđ zux ix. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Yaz ayx zanyx manyf phunz nănh coong, nănh wâyc nyâuh bix ayx cumh pâuz zâuđ nzongf, lauf cayx năngđ wâyc yămz wa Lau-đi-sê cloon wa Hi-ê-la-bô-li wax đomc zen Zâu nyăngz munh nâyx. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Pănh stăngz nyăngz yâuf pez Lu-ca mađ stangc munh, cloon Đê-mat lauf săngx tauv nyâuh. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />Joođ bux yămz wa Lau-đi-sê nyăngz yâuf pez, cloon Nim-pha, cloon yămz wax tauh ô nyăngz pyau căpx dlonf wax đomc jix pangx munh coong, yaz săngx tauv stiz. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />Nyâuh toc nâyx zây jenx phunz yămz nyâuh wa nyăngz munh mungv tuz, bix zef pungx ninyh phunz yămz wa Lau-đi-sê nyăngz jiux pangx munh toc, nzof nyâuh lauf oix zuc toc tăng wa Lau-đi-sê pungx taih nyăngz jenx timb. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />Joođ bux ănz An-cip-batc, coong: “Oix zuc năngx cayb ayx mâyh tuz stipx taih tăng Zâu nyăngz cumh pâuz, phunz mâyh hayh ayx nây cumh pâuz tuz clăkx clunh nzuf.”<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />Yaz, Phao-lô cănh nongc puf ja nâyx đomc wac — yaz săngx tauv nyâuh. Oix zuc săngx tauv yaz zuc jab langb stayb nyăngz jau, cloo Zâu sađ pôz phunz nyâuh.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>