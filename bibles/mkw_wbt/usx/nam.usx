<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Munukutuba Bible</book>
  <para style="h">Nawume</para>
  <para style="toc3">Naw</para>
  <para style="toc2">Nawume</para>
  <para style="toc1">Dibuku ya Nawume</para>
  <para style="mt2">Dibuku ya</para>
  <para style="mt1">NAWUME</para>
  <para style="imt">NKOTOLO</para>
  <para style="ip">Dibuku ya <char style="w">mumbikudi</char> Nawume ke na kuzonzila na bambikululu yina me tadila kubwa ya mbanza Ninive. <char style="w">Mumbikudi</char> Nawume ke na kulakisa kumwangana yayi mutindu mfundusu ya Nzambi samu na mbanza yayi ya lunangu, ya mivondi mpe ya muvusu. Ninive kele kidimbu ya lutumu ya kimuntu yina Nzambi ke ndimaka ve. Na ntangu ya Nawume, bantu ya Asili kwizaka mwangisa kimfumu ya Isayeli, mpe bawu nwanisaka kimfumu ya Yuda. Dibuku yayi sonamaka na manima ya kubwa ya mbanza Tebese na maboko ya bantu ya Asili na bamvula bankama sambanu na makumi sambanu na tatu (663), ntete bantu ya Babilone kumwangisa mbanza Ninive na bamvula bankama sambanu na kumi na zole (612), ntete mbutukulu Yesu Klisto.</para>
  <para style="ib" />
  <para style="iot">Dibuku yayi kele ya kukabuka mutindu yayi:</para>
  <para style="io">- Masiika na Yave (<char style="xt"><ref loc="NAM 1:1-8">Naw 1.1-8</ref></char>).</para>
  <para style="io">- Yave fundisaka Ninive mpe kuulaka Yuda (<char style="xt"><ref loc="NAM 1:9-2:3">Naw 1.9–2.3</ref></char>).</para>
  <para style="io">- Lufundusu ya Ninive (<char style="xt"><ref loc="NAM 2:4-3:19">Naw 2.4–3.19</ref></char>).</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Bambikululu samu na Ninive. Dibuku ya lumoni ya Nawume, muntu ya bwala Elekose.<verse eid="NAM 1:1" /></para>
  <para style="s1">Yave: Nzambi ya lulendo mpe ya mbote</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />Yave kele Nzambi ya kimbanda mpe yina ke vutulaka yimbi.</para>
  <para style="q1" vid="NAM 1:2">Yave ke vutulaka yimbi</para>
  <para style="q1" vid="NAM 1:2">mpe nkele ya yandi ke ya kusakana ve.</para>
  <para style="q1" vid="NAM 1:2">Yave ke vutulaka yimbi na bambeni ya yandi,</para>
  <para style="q1" vid="NAM 1:2">mpe yandi ke dasukilaka bawu.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />Yave ke dasukaka mbangu ve,</para>
  <para style="q1" vid="NAM 1:3">lulendo ya yandi kele nene,</para>
  <para style="q1" vid="NAM 1:3">kasi Yave ke bikaka ve na kupesa kitumbu na muntu yina me sala yimbi.</para>
  <para style="q1" vid="NAM 1:3">Yandi ke tambulaka na kati,</para>
  <para style="q1" vid="NAM 1:3">ya kimbongila mpe kitembo ya ngolo.</para>
  <para style="q1" vid="NAM 1:3">Matuti kele fundu-fundu yina makulu ya yandi ke nangunaka.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />Yandi ke ngalaka mubu, yandi ke yumisaka yawu,</para>
  <para style="q1" vid="NAM 1:4">yandi ke yumisaka banzadi nyonso.</para>
  <para style="q1" vid="NAM 1:4">Matiti ya kizunga Basane mpe ya mongo Kaamele ke na yuma.</para>
  <para style="q1" vid="NAM 1:4">Bifulu ya yinsi ya Libane ke na kubeba.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Myongo ya nene ke na kuningana na mantwala ya yandi</para>
  <para style="q1" vid="NAM 1:5">mpe myongo ya fyoti ke na kumwangana.</para>
  <para style="q1" vid="NAM 1:5">Na mantwala ya yandi, ntoto na bima nyonso</para>
  <para style="q1" vid="NAM 1:5">yina ke zingaka na yawu me kumaka kidi-kidi.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Nani lenda vibidila</para>
  <para style="q1" vid="NAM 1:6">na mantwala ya nkele ya Yave?</para>
  <para style="q1" vid="NAM 1:6">Nani lenda zinga mantwala ya tiya ya nkele ya yandi?</para>
  <para style="q1" vid="NAM 1:6">Nkele ya yandi ke yalumukaka bisika nyonso mutindu tiya.</para>
  <para style="q1" vid="NAM 1:6">Matadi ke mwanganaka ntadisi ya yandi.<verse eid="NAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />Yave kele mbote,</para>
  <para style="q1" vid="NAM 1:7">yandi kele kiswamunu na ntangu ya mpasi,</para>
  <para style="q1" vid="NAM 1:7">yandi ke bakaka bunkete ya bayina ke bumbamaka na sika ya yandi,<verse eid="NAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8" />ata ti mupepe ya bampasi ke na kufula.</para>
  <para style="q1" vid="NAM 1:8">Yandi ke kufwaka bambeni ya yandi,</para>
  <para style="q1" vid="NAM 1:8">yandi ke landaka bawu</para>
  <para style="q1" vid="NAM 1:8">tii na kati ya kitombe ya lufwa.<verse eid="NAM 1:8" /></para>
  <para style="s1">Mambu ya Yave samu na Ninive mpe Yuda</para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Samu na yinki beno ke na mabanza ya yimbi na Yave?</para>
  <para style="q1" vid="NAM 1:9">Ni yandi ke manisa na kufwa bambeni nyonso ya beno,</para>
  <para style="q1" vid="NAM 1:9">mpe bawu ke kwamisa dyaka beno ve.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />Ata ti bawu me kuma mutindu</para>
  <para style="q1" vid="NAM 1:10">bansende yina kele ya kukangama yawu na yawu kisika mosi,</para>
  <para style="q1" vid="NAM 1:10">mpe mutindu bantu me kunwa malafu,</para>
  <para style="q1" vid="NAM 1:10">bawu ke nyenga mutindu matiti ya kuyuma.<verse eid="NAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />Nge Ninive, ni na sika ya nge me basika muntu yina ke na mabanza ya yimbi na Yave.<verse eid="NAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="NAM 1:12" />Yave ke na kutuba na bantu ya Yuda:</para>
  <para style="q1" vid="NAM 1:12">«Ata ti bambeni ya beno kele mingi</para>
  <para style="q1" vid="NAM 1:12">mpe ba ke na ngolo, bawu nyonso ke kufwa mpe ata muntu ke bikana.</para>
  <para style="q1" vid="NAM 1:12">Mu talisaka beno mpasi mpe nsoni,</para>
  <para style="q1" vid="NAM 1:12">kasi mu ke sala dyaka beno mutindu yina ve.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Ntangu yayi, mu ke kuula beno na maboko ya bambeni</para>
  <para style="q1" vid="NAM 1:13">mpe mu ke zenga basinga yina ba kangaka beno.»<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />Samu na nge Ninive, Yave me baka lukanu yayi:</para>
  <para style="q1" vid="NAM 1:14">Nge ke kuzwa dyaka ve bana yina ke</para>
  <para style="q1" vid="NAM 1:14">vwanda na nkumbu ya nge.</para>
  <para style="q1" vid="NAM 1:14">Na kati ya bayinzo ya banzambi ya nge,</para>
  <para style="q1" vid="NAM 1:14">mu ke katula biteki yina ba yidikaka na yinti to na kisengo.</para>
  <para style="q1" vid="NAM 1:14">Mu ke kubika ndyamu ya nge,</para>
  <para style="q1" vid="NAM 1:14">samu ti, na meso ya munu,</para>
  <para style="q1" vid="NAM 1:14">nge ke dyaka dema ve.<verse eid="NAM 1:14" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />Bantu ya Yuda, beno tala na zulu ya myongo,</para>
  <para style="q1" vid="NAM 2:1">muntu yina ke na kunata nsangu ya mbote,</para>
  <para style="q1" vid="NAM 2:1">nsangu ya kizunu.</para>
  <para style="q1" vid="NAM 2:1">Beno sala <char style="w">mikembo</char> ya beno.</para>
  <para style="q1" vid="NAM 2:1">Beno nata na sika ya Nzambi,</para>
  <para style="q1" vid="NAM 2:1">bima nyonso yina beno bakaka lukanu ya kupesa yandi,</para>
  <para style="q1" vid="NAM 2:1">samu ti, muntu ya yimbi yina vwandaka talisa beno mpasi</para>
  <para style="q1" vid="NAM 2:1">kele dyaka ve na lulendo.<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />Ba ke na kwiza samu na kunwanisa nge Ninive.</para>
  <para style="q1" vid="NAM 2:2">Beno keba bibaka ya mbanza.</para>
  <para style="q1" vid="NAM 2:2">Beno kengidila banzila,</para>
  <para style="q1" vid="NAM 2:2">beno vwanda na kibakala,</para>
  <para style="q1" vid="NAM 2:2">mpe beno kubama samu na mvita.<verse eid="NAM 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />Samu ti, Yave ke vutula buzitu ya bana Yakobi,</para>
  <para style="q1" vid="NAM 2:3">mutindu mosi mpe ya bantu ya Isayeli,</para>
  <para style="q1" vid="NAM 2:3">samu na bilanga ya bawu ya vinu,</para>
  <para style="q1" vid="NAM 2:3">yina bambeni mwangisaka mpe bebisaka.<verse eid="NAM 2:3" /></para>
  <para style="s1">Kumwangana ya Ninive</para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Binwani ya bambeni kele na binwanunu ya kisengo ya mbwaki</para>
  <para style="q1" vid="NAM 2:4">mpe me lwata binkuti ya mbwaki.</para>
  <para style="q1" vid="NAM 2:4">Ntangu bawu ke kubamaka na kunwana,</para>
  <para style="q1" vid="NAM 2:4">bisengo ya bapusu-pusu ya bawu ya mvita ke lemaka mutindu tiya</para>
  <para style="q1" vid="NAM 2:4">mpe bawu ke ningisaka madyonga ya bawu.<verse eid="NAM 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Bapusu-pusu ya mvita ke basikaka bisika mingi mpe na babala-bala,</para>
  <para style="q1" vid="NAM 2:5">samu na kunwana.</para>
  <para style="q1" vid="NAM 2:5">Yawu kele mutindu milaka ya tiya</para>
  <para style="q1" vid="NAM 2:5">mpe yawu ke na mbangu mutindu lusyemo.<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />Ntinu ya Ninive ke bokilaka binwani yina ke na kibakala,</para>
  <para style="q1" vid="NAM 2:6">kasi bawu ke kwendaka kubwa na nzila.</para>
  <para style="q1" vid="NAM 2:6">Na nswalu nyonso, bawu ke belamaka pene-pene ya bibaka ya lukengolo samu na kubumbama.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />Myelo yina ke talaka na banzadi</para>
  <para style="q1" vid="NAM 2:7">fungukaka na ngolo nyonso,</para>
  <para style="q1" vid="NAM 2:7">yinzo ya kintinu kubwaka.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />Ba bakaka kiteki yina vwandaka mutindu nzambi ya bawu ya kento,</para>
  <para style="q1" vid="NAM 2:8">mpe ba nataka yawu.</para>
  <para style="q1" vid="NAM 2:8">Bisadi ya bakento yina vwandaka bongisa kiteki yango,</para>
  <para style="q1" vid="NAM 2:8">vwandaka dila mutindu mabembe, maboko na zulu ya yintu.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />Katuka ntama, mbanza Ninive vwandaka mutindu kizinga ya maza, kasi ntangu yayi, maza ya yawu ke na kubasika.</para>
  <para style="q1" vid="NAM 2:9">«Beno telama, beno telama»,</para>
  <para style="q1" vid="NAM 2:9">kasi ata muntu vwandaka tala na manima.<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />Ba botola palata na wolo,</para>
  <para style="q1" vid="NAM 2:10">samu ti mbanza yayi ke na bimvwama</para>
  <para style="q1" vid="NAM 2:10">mpe bima ya ntalu ya mutindu na mutindu yina ke manisaka ve.<verse eid="NAM 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Ba me botola, ba me bebisa,</para>
  <para style="q1" vid="NAM 2:11">mpe me mwangisa bima nyonso.</para>
  <para style="q1" vid="NAM 2:11">Bantu nyonso ke dyaka ve na kibakala,</para>
  <para style="q1" vid="NAM 2:11">makulu ya bawu me lemba.</para>
  <para style="q1" vid="NAM 2:11">Bawu nyonso ke na kutekita,</para>
  <para style="q1" vid="NAM 2:11">bizizi ya bawu me kuma ya kyadi.<verse eid="NAM 2:11" /></para>
  <para style="s1">Ninive kele mutindu nkosi yina ba me nunga</para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />Wapi mutindu me kuma kisika</para>
  <para style="q1" vid="NAM 2:12">yina vwandaka ya bankosi?</para>
  <para style="q1" vid="NAM 2:12">Ni kisika yina bana ya bankosi vwandaka kudya.</para>
  <para style="q1" vid="NAM 2:12">Ntangu nkosi vwandaka kwenda na mbingu,</para>
  <para style="q1" vid="NAM 2:12">ata kima vwandaka talisa bana ya bankosi boma.<verse eid="NAM 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />Nkosi ya mbakala vwandaka kufwa</para>
  <para style="q1" vid="NAM 2:13">mpe kupasula bibulu,</para>
  <para style="q1" vid="NAM 2:13">samu na bankosi ya nkento mpe bana ya yandi.</para>
  <para style="q1" vid="NAM 2:13">Misuni ya bibulu yina yandi vwandaka kufwa,</para>
  <para style="q1" vid="NAM 2:13">yandi vwandaka fulusa yawu,</para>
  <para style="q1" vid="NAM 2:13">na kati ya mabulu yina bawu ke bumbamaka.<verse eid="NAM 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 2:14" />Yave, Nzambi ya lulendo ke na kutuba: «Nge Ninive mu ke pesa nge kitumbu,</para>
  <para style="q1" vid="NAM 2:14">bapusu-pusu ya nge ya mvita ke nyenga,</para>
  <para style="q1" vid="NAM 2:14">bana ya nge ya bankosi ke kufwa na mvita,</para>
  <para style="q1" vid="NAM 2:14">mu ke baka bima nyonso yina beno botolaka,</para>
  <para style="q1" vid="NAM 2:14">mpe ba ke kuwa dyaka ve bandinga ya bantumwa<note caller="+" style="f"><char style="fr" closed="false">2.14 </char><char style="fq" closed="false">Bantumwa, </char><char style="ft" closed="false">ya zola kutuba: bantu yina ba ke fidisaka to bimwangisi nsangu.</char></note> ya nge.»<verse eid="NAM 2:14" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s1">Ninive me fuluka na bamvumbi</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />Kyadi samu na mbanza yina ke kufwaka bantu,</para>
  <para style="q1" vid="NAM 3:1">mbanza ya kufuluka na luvunu mpe na mavanga ya yimbi.</para>
  <para style="q1" vid="NAM 3:1">Yawu ke bikaka ve na kubotola bima ya ngana.<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Ba ke na kuwa: Makelele ya bikoti,</para>
  <para style="q1" vid="NAM 3:2">makelele ya makalu yina ke na kututana,</para>
  <para style="q1" vid="NAM 3:2">makelele ya bampunda yina ke na kwendaka dumuka,</para>
  <para style="q1" vid="NAM 3:2">mpe makelele ya bapusu-pusu ya mvita yina ke na kudenda.<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Bayina ke nataka bampunda ya mvita ke na kuluta,</para>
  <para style="q1" vid="NAM 3:3">meno ya bambele ya bawu ke na kubasisa milaka ya tiya,</para>
  <para style="q1" vid="NAM 3:3">madyonga ya bawu ke na kulezima,</para>
  <para style="q1" vid="NAM 3:3">bamvumbi ke ya kutentasana,</para>
  <para style="q1" vid="NAM 3:3">yawu kele mingi mpe lutangu ya yawu ke ya kuzabakana ve.</para>
  <para style="q1" vid="NAM 3:3">Bantu ke na kulenda dyaka ve,</para>
  <para style="q1" vid="NAM 3:3">na kutambula na babala-bala samu na bamvumbi.<verse eid="NAM 3:3" /></para>
  <para style="s1">Ninive kumaka mbanza ya nsoni</para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />Samu na kindumba ya yandi ya kulutila,</para>
  <para style="q1" vid="NAM 3:4">Ninive kento ya kindumba vwandaka benda makanda,</para>
  <para style="q1" vid="NAM 3:4">samu na kitoko ya yandi ya kulutila mpe samu na kindoki ya yandi,</para>
  <para style="q1" vid="NAM 3:4">yandi vwandaka benda makanda.</para>
  <para style="q1" vid="NAM 3:4">Yandi vwandaka tekisa bayinsi na kindumba ya yandi mpe makanda na kindoki yandi.<verse eid="NAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />Ni yawu yina, mu ke semba nge,</para>
  <para style="q1" vid="NAM 3:5">mu ke nanguna dizwela ya nge tii na kizizi ya nge.</para>
  <para style="q1" vid="NAM 3:5">Mu ke lakisa kipene ya nge na bantu ya bayinsi</para>
  <para style="q1" vid="NAM 3:5">mpe mu ke sala ti bimfumu nyonso kutala nsoni ya nge.</para>
  <para style="q1" vid="NAM 3:5">Ni Yave, Nzambi ya lulendo me tuba yawu.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />Mu ke katula kitoko ya nge,</para>
  <para style="q1" vid="NAM 3:6">mu ke talisa nge nsoni</para>
  <para style="q1" vid="NAM 3:6">mpe mu ke sala ti nge vwanda kifwani.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Na yina, konso muntu yina ke tala nge,</para>
  <para style="q1" vid="NAM 3:7">ke kwenda kima na kulooka mutindu yayi:</para>
  <para style="q1" vid="NAM 3:7">«Ninive me mwangana! Nani ke tadila yawu kyadi?»</para>
  <para style="q1" vid="NAM 3:7">Wapi kisika mu ke kuzwa muntu yina ke kindisa nge?<verse eid="NAM 3:7" /></para>
  <para style="s1">Ninive ke kuzwa kitumbu ya mutindu mosi na Tebese</para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />Ninive, nge ke na kubanza ti nge me lutila mbanza Tebese mfunu?</para>
  <para style="q1" vid="NAM 3:8">Mbanza Tebese vwandaka ya kutungama na kati-kati ya maza ya nzadi ya Nile,</para>
  <para style="q1" vid="NAM 3:8">maza zungaka yawu mpe ni yawu vwandaka sala lukengolo ya mbanza.<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Yinsi ya Nubi mpe Ngipiti,</para>
  <para style="q1" vid="NAM 3:9">vwandaka bisika,</para>
  <para style="q1" vid="NAM 3:9">yina katukaka ngolo ya nge ya ntangu nyonso.</para>
  <para style="q1" vid="NAM 3:9">Bantu ya Pute mpe ya Libi kele bayina vwandaka sadisa nge.<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />Kasi yandi mpe,</para>
  <para style="q1" vid="NAM 3:10">ba katulaka bantu ya Tebese na kunata bawu na yinsi ya nzenza.</para>
  <para style="q1" vid="NAM 3:10">Na ntangu ya bawu mpe,</para>
  <para style="q1" vid="NAM 3:10">ba kufwaka bana ya bawu na magambu nyonso.</para>
  <para style="q1" vid="NAM 3:10">Ba kangaka bakalaka ya bawu,</para>
  <para style="q1" vid="NAM 3:10">na basinga ya bisengo,</para>
  <para style="q1" vid="NAM 3:10">mpe ba bulaka dzeke,</para>
  <para style="q1" vid="NAM 3:10">samu na kukabula <char style="w">bakuluntu</char> ya bawu.<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />Ninive, nge mpe ke kuma,</para>
  <para style="q1" vid="NAM 3:11">mutindu muntu me kola na bampasi</para>
  <para style="q1" vid="NAM 3:11">yawu ke dyamisa nge.</para>
  <para style="q1" vid="NAM 3:11">Na ntangu ya nge mpe,</para>
  <para style="q1" vid="NAM 3:11">nge ke sosa kiswamunu,</para>
  <para style="q1" vid="NAM 3:11">samu na kubumbama mbeni ya nge.<verse eid="NAM 3:11" /></para>
  <para style="s1">Ninive ke kubwa</para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Bibaka ya nge nyonso ya ngolo yina nge tungaka samu na lukengolo ya nge</para>
  <para style="q1" vid="NAM 3:12">kele mutindu bayinti ya <char style="w">fike</char> ya kufuluka na bambuma ya ntete.</para>
  <para style="q1" vid="NAM 3:12">Kana ba ningisa yawu,</para>
  <para style="q1" vid="NAM 3:12">bambuma ke kubwa na kati ya yinwa,</para>
  <para style="q1" vid="NAM 3:12">ya muntu yina zola kudya yawu.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />Bantu yina me bikana na nge kele kaka mutindu bakento na bakento.</para>
  <para style="q1" vid="NAM 3:13">Myelo ya yinsi ya nge me funguka yawu mosi</para>
  <para style="q1" vid="NAM 3:13">na mantwala ya bambeni ya nge</para>
  <para style="q1" vid="NAM 3:13">samu ti, tiya me nyengisa bikangulu ya nge.<verse eid="NAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Bantu ya Ninive, beno teka maza,</para>
  <para style="q1" vid="NAM 3:14">samu ti beno kufwa ve na mpwila ya maza,</para>
  <para style="q1" vid="NAM 3:14">ntangu bambeni ke kwiza zunga beno</para>
  <para style="q1" vid="NAM 3:14">beno yidika dyaka bibaka yina ke kebaka beno,</para>
  <para style="q1" vid="NAM 3:14">beno kota na poto-poto,</para>
  <para style="q1" vid="NAM 3:14">beno dyata ntoto ya kulamba samu na kuyidika bibiliki.<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Kasi ata ti beno sala mutindu yina, beno ke kufwa na tiya,</para>
  <para style="q1" vid="NAM 3:15">na mvita mbele ke kufwa beno.</para>
  <para style="q1" vid="NAM 3:15">Beno ke kuma mutindu makasa yina makonko me kudya.</para>
  <para style="q1" vid="NAM 3:15">Beno kuma mingi mutindu makonko ya fyoti.</para>
  <para style="q1" vid="NAM 3:15">Beno kuma mingi mutindu nkonga ya makonko ya nene.<verse eid="NAM 3:15" /></para>
  <para style="s1">Mbanza Ninive me zimbana</para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Nge me sala ti bantu ya nge ya mumbungu,</para>
  <para style="q1" vid="NAM 3:16">kuma mingi kulutila bambwetete ya <char style="w">mazulu</char>.</para>
  <para style="q1" vid="NAM 3:16">Bawu me kuma mutindu makonko yina ke na kudumukaka.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Bayina ke kebaka yinsi ya beno,</para>
  <para style="q1" vid="NAM 3:17">bawu ke kuma mingi mutindu makonko,</para>
  <para style="q1" vid="NAM 3:17">mpe bantwadisi ya beno ke kuma mingi mutindu nkonga ya makonko</para>
  <para style="q1" vid="NAM 3:17">yina ke bumbamaka na kati ya bayinti na ntangu ya madidi</para>
  <para style="q1" vid="NAM 3:17">kana ntangu me basika, bawu me zimbana,</para>
  <para style="q1" vid="NAM 3:17">kasi wapi kisika bawu me kwenda, wapi bawu?<verse eid="NAM 3:17" /></para>
  <para style="s1">Ntinu ya mbanza Asili me suka yimbi</para>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />Nge ntinu ya Asili,</para>
  <para style="q1" vid="NAM 3:18">bantwadisi ya nge nyonso me lala yimeni pongi,</para>
  <para style="q1" vid="NAM 3:18">bamfumu ya bambulu-mbulu ya nge ke na kusala dyaka kima ve,</para>
  <para style="q1" vid="NAM 3:18">bantu ya nge kele ya mwangana na zulu ya myongo</para>
  <para style="q1" vid="NAM 3:18">mpe ata muntu ke yonzika bawu.<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Bampasi ya nge ke na lusalusu ve,</para>
  <para style="q1" vid="NAM 3:19">bamputa ya nge ke beluka ve,</para>
  <para style="q1" vid="NAM 3:19">bayina nyonso ke na kuwa nsangu ya bampasi yina me kumina nge,</para>
  <para style="q1" vid="NAM 3:19">ke na kubula maboko na kilengi.</para>
  <para style="q1" vid="NAM 3:19">Ya tsyelika, nani nge talisaka ve mpasi?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>